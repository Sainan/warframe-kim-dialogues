digraph {
	460 [label="KayaRank3Convo2 begins.",color=orange];
		460 -> 461;
	461 [label="Ты реально зациклена на «путешествиях во времени». Нет, серьёзно, прям помешана.",shape=box,color=red];
		461 -> 462;
	462 [label="Работаю над этим. Почти готово.",shape=box,color=blue];
		462 -> 463;
	463 [label="Но когда ты разберёшься с путешествиями во времени, появится проблема посерьёзнее. Этернализм. ",shape=box,color=red];
		463 -> 464;
	464 [label="Эм... что?",shape=box,color=blue];
		464 -> 465;
		464 -> 466;
	465 [label="Давай посмотрим, достаточно ли ты умна, чтобы это понять. Из-за этернализма существует версия этого разговора, которая не заканчивается прямо здесь. [Конец.]",shape=box,color=red];
		465 -> 467;
	466 [label="Надеюсь, ты не занята, потому что вот ради чего я здесь на самом деле.",shape=box,color=red];
		466 -> 468;
	467 [label="Update boolean KayaEternalismTest",color=orange];
		467 -> 469;
	468 [label="Я не занята, пожалуйста, объясни. Это может быть невероятно важно для последних теоретических штрихов в манипуляции временем.",shape=box,color=blue];
		468 -> 470;
	469 [label="+20 Chemistry",color=orange];
		469 -> 471;
	470 [label="Всё это случилось не потому, что какой-то учёный вывел формулу.",shape=box,color=red];
		470 -> 472;
	471 [label="Chat ends. Next chat will be KayaRank3Convo3.",color=orange];
	472 [label="Хотя, наверное, так всё и началось.",shape=box,color=red];
		472 -> 473;
	473 [label="Но всё, что происходит сейчас? Это уже нечто большее. Это потому, что Альбрехт куда-то отправился, разбудил что-то… и оно последовало за ним обратно. Бездна.",shape=box,color=red];
		473 -> 474;
		473 -> 475;
	474 [label="Бездна жива и в то же время нет. Она существует, но и не существует. Она парадокс, и в то же время — причина и следствие всего, что случилось с каждым из нас.",shape=box,color=red];
		474 -> 476;
	475 [label="Для неё нет «периодической таблицы» или формулы.",shape=box,color=red];
		475 -> 477;
	476 [label="Привет, Мир.",shape=box,color=blue];
		476 -> 478;
		476 -> 479;
	477 [label="Наука может это объяснить. Это управляет всем.",shape=box,color=blue];
		477 -> 480;
	478 [label="«Прощай, Альбрехт»",shape=box,color=red];
		478 -> 481;
	479 [label="Что?",shape=box,color=red];
		479 -> 482;
	480 [label="Check boolean KayaVoidTest",color=orange];
		480 -> 484 [label=true,color=green];
		480 -> 483 [label=false,color=brown];
	481 [label="+5 Chemistry",color=orange];
		481 -> 485;
	482 [label="Это было первым сообщением, опубликованным в интернете. Первая запись. Автор интернета запостил её, чтобы доказать, что это «сработало».",shape=box,color=blue];
		482 -> 486;
	484 [label="Я же говорила, будь осторожнее с Бездной. Вот почему.",shape=box,color=red];
		484 -> 488;
	483 [label="Что, если нет?",shape=box,color=red];
		483 -> 487;
	485 [label="Ха! Если бы, боже мой. Но ты вообще знаешь, что такое «Привет, Мир»?",shape=box,color=blue];
		485 -> 482;
	486 [label="И с этого момента начался хаос. Люди буквально ПОТЕРЯЛИ РАССУДОК. Наука. Банки. Технологии. Развлечения.",shape=box,color=blue];
		486 -> 489;
	488 [label="Некоторые вещи не подчиняются законам.",shape=box,color=red];
		488 -> 491;
	487 [label="А если бы всё, что ты считала незыблемым правилом..",shape=box,color=red];
		487 -> 490;
	489 [label="И через миллиарды выборов, причин и следствий, это привело к тому, что я однажды зашёла в сеть, и... ",shape=box,color=blue];
		489 -> 492;
	491 [label="Некоторые вещи не поддаются объяснению.",shape=box,color=red];
		491 -> 493;
	490 [label="Это случилось только потому, что что-то там, снаружи, захотело этого.",shape=box,color=red];
		490 -> 493;
	492 [label="И это был конец Новы. Или, скорее, Кайи. Её будущего, её карьеры, её друзей, всего. Из-за одной ошибки. ",shape=box,color=blue];
		492 -> 494;
	493 [label="То есть ты хочешь сказать, что недостающая часть моих экспериментов, тестов, исследований и гипотез — это «магия».",shape=box,color=blue];
		493 -> 495;
		493 -> 496;
	494 [label="Думаю, мне проще довериться Бездне, чем людям.",shape=box,color=blue];
		494 -> 497;
		494 -> 498;
		494 -> 499;
	495 [label="Не магия. Просто… Бездна. Бездна. Энергия откуда-то извне.",shape=box,color=red];
		495 -> 500;
	496 [label="Ты видела, что я могу? ",shape=box,color=red];
		496 -> 501;
	497 [label="Не [Конец].",shape=box,color=red];
		497 -> 502;
	498 [label="Мрачно, Нова.",shape=box,color=red];
		498 -> 503;
	499 [label="Я тоже ей доверяла.",shape=box,color=red];
		499 -> 503;
	500 [label="Я могу с этим работать.",shape=box,color=blue];
		500 -> 504;
		500 -> 505;
	501 [label="Видела. Наблюдала. Записала. Изучила. Переизучила. Угу. Всё это можно объяснить. Оно имеет основу. «Магия», может быть.",shape=box,color=blue];
		501 -> 506;
	502 [label="+20 Chemistry",color=orange];
		502 -> 507;
	503 [label="Кажется, ты ещё не до конца это поняла. ",shape=box,color=blue];
		503 -> 508;
	504 [label="Если рискнёшь, это может стоить тебе всего.",shape=box,color=red];
		504 -> 503;
	505 [label="Ты можешь «с этим работать»?",shape=box,color=red];
		505 -> 503;
	506 [label="Я могу с этим работать.",shape=box,color=blue];
		506 -> 504;
		506 -> 505;
	507 [label="Chat ends. Next chat will be KayaRank3Convo3.",color=orange];
	508 [label="Но я выбираюсь из 1999-го.",shape=box,color=blue];
		508 -> 509;
	509 [label="Мне реально всё равно, что со мной будет, пока я пытаюсь туда попасть.",shape=box,color=blue];
		509 -> 510;
	510 [label="Это единственное, о чём я думаю.",shape=box,color=blue];
		510 -> 511;
	511 [label="И для меня это хорошо. ",shape=box,color=blue];
		511 -> 512;
	512 [label="+20 Chemistry",color=orange];
		512 -> 513;
	513 [label="Chat ends. Next chat will be KayaRank3Convo3.",color=orange];
}