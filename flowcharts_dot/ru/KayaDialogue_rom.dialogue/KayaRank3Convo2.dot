digraph {
	"KayaRank3Convo2 begins." [color=orange];
		"KayaRank3Convo2 begins." -> j1480416670;
	j1480416670 [label="Ты реально зациклена на «путешествиях во времени». Нет, серьёзно, прям помешана.",shape=box,color=red];
		j1480416670 -> j3618177571;
	j3618177571 [label="Работаю над этим. Почти готово.",shape=box,color=blue];
		j3618177571 -> j182452776;
	j182452776 [label="Но когда ты разберёшься с путешествиями во времени, появится проблема посерьёзнее. Этернализм. ",shape=box,color=red];
		j182452776 -> j1967694598;
	j1967694598 [label="Эм... что?",shape=box,color=blue];
		j1967694598 -> j1503057009;
		j1967694598 -> j1806596675;
	j1503057009 [label="Давай посмотрим, достаточно ли ты умна, чтобы это понять. Из-за этернализма существует версия этого разговора, которая не заканчивается прямо здесь. [Конец.]",shape=box,color=red];
		j1503057009 -> j3655577789;
	j1806596675 [label="Надеюсь, ты не занята, потому что вот ради чего я здесь на самом деле.",shape=box,color=red];
		j1806596675 -> j1178389678;
	j3655577789 [label="Boolean KayaEternalismTest is now true.",color=orange];
		j3655577789 -> j2156753723;
	j1178389678 [label="Я не занята, пожалуйста, объясни. Это может быть невероятно важно для последних теоретических штрихов в манипуляции временем.",shape=box,color=blue];
		j1178389678 -> j2380608847;
	j2156753723 [label="+20 Chemistry",color=orange];
		j2156753723 -> "Chat ends. Next chat will be KayaRank3Convo3.";
	j2380608847 [label="Всё это случилось не потому, что какой-то учёный вывел формулу.",shape=box,color=red];
		j2380608847 -> j21416402;
	"Chat ends. Next chat will be KayaRank3Convo3." [color=orange];
	j21416402 [label="Хотя, наверное, так всё и началось.",shape=box,color=red];
		j21416402 -> j2177803837;
	j2177803837 [label="Но всё, что происходит сейчас? Это уже нечто большее. Это потому, что Альбрехт куда-то отправился, разбудил что-то… и оно последовало за ним обратно. Бездна.",shape=box,color=red];
		j2177803837 -> j3544388820;
		j2177803837 -> j94329532;
	j3544388820 [label="Бездна жива и в то же время нет. Она существует, но и не существует. Она парадокс, и в то же время — причина и следствие всего, что случилось с каждым из нас.",shape=box,color=red];
		j3544388820 -> j1745460133;
	j94329532 [label="Для неё нет «периодической таблицы» или формулы.",shape=box,color=red];
		j94329532 -> j127657967;
	j1745460133 [label="Привет, Мир.",shape=box,color=blue];
		j1745460133 -> j3534933717;
		j1745460133 -> j3241504573;
	j127657967 [label="Наука может это объяснить. Это управляет всем.",shape=box,color=blue];
		j127657967 -> j3668359530;
	j3534933717 [label="«Прощай, Альбрехт»",shape=box,color=red];
		j3534933717 -> j2870840423;
	j3241504573 [label="Что?",shape=box,color=red];
		j3241504573 -> j308443567;
	j3668359530 [label="Check boolean KayaVoidTest",color=orange];
		j3668359530 -> j3300041649 [label=true,color=green];
		j3668359530 -> j565700163 [label=false,color=brown];
	j2870840423 [label="+5 Chemistry",color=orange];
		j2870840423 -> j449041575;
	j308443567 [label="Это было первым сообщением, опубликованным в интернете. Первая запись. Автор интернета запостил её, чтобы доказать, что это «сработало».",shape=box,color=blue];
		j308443567 -> j3300601800;
	j3300041649 [label="Я же говорила, будь осторожнее с Бездной. Вот почему.",shape=box,color=red];
		j3300041649 -> j1676062943;
	j565700163 [label="Что, если нет?",shape=box,color=red];
		j565700163 -> j3865967623;
	j449041575 [label="Ха! Если бы, боже мой. Но ты вообще знаешь, что такое «Привет, Мир»?",shape=box,color=blue];
		j449041575 -> j308443567;
	j3300601800 [label="И с этого момента начался хаос. Люди буквально ПОТЕРЯЛИ РАССУДОК. Наука. Банки. Технологии. Развлечения.",shape=box,color=blue];
		j3300601800 -> j2142146111;
	j1676062943 [label="Некоторые вещи не подчиняются законам.",shape=box,color=red];
		j1676062943 -> j1135002383;
	j3865967623 [label="А если бы всё, что ты считала незыблемым правилом..",shape=box,color=red];
		j3865967623 -> j316780672;
	j2142146111 [label="И через миллиарды выборов, причин и следствий, это привело к тому, что я однажды зашёла в сеть, и... ",shape=box,color=blue];
		j2142146111 -> j4030543113;
	j1135002383 [label="Некоторые вещи не поддаются объяснению.",shape=box,color=red];
		j1135002383 -> j29173208;
	j316780672 [label="Это случилось только потому, что что-то там, снаружи, захотело этого.",shape=box,color=red];
		j316780672 -> j29173208;
	j4030543113 [label="И это был конец Новы. Или, скорее, Кайи. Её будущего, её карьеры, её друзей, всего. Из-за одной ошибки. ",shape=box,color=blue];
		j4030543113 -> j39702800;
	j29173208 [label="То есть ты хочешь сказать, что недостающая часть моих экспериментов, тестов, исследований и гипотез — это «магия».",shape=box,color=blue];
		j29173208 -> j1971683885;
		j29173208 -> j2179551741;
	j39702800 [label="Думаю, мне проще довериться Бездне, чем людям.",shape=box,color=blue];
		j39702800 -> j307384730;
		j39702800 -> j2751743325;
		j39702800 -> j1084520107;
	j1971683885 [label="Не магия. Просто… Бездна. Бездна. Энергия откуда-то извне.",shape=box,color=red];
		j1971683885 -> j2774972500;
	j2179551741 [label="Ты видела, что я могу? ",shape=box,color=red];
		j2179551741 -> j3065217364;
	j307384730 [label="Не [Конец].",shape=box,color=red];
		j307384730 -> j2156753723;
	j2751743325 [label="Мрачно, Нова.",shape=box,color=red];
		j2751743325 -> j4167599846;
	j1084520107 [label="Я тоже ей доверяла.",shape=box,color=red];
		j1084520107 -> j4167599846;
	j2774972500 [label="Я могу с этим работать.",shape=box,color=blue];
		j2774972500 -> j245139932;
		j2774972500 -> j241277097;
	j3065217364 [label="Видела. Наблюдала. Записала. Изучила. Переизучила. Угу. Всё это можно объяснить. Оно имеет основу. «Магия», может быть.",shape=box,color=blue];
		j3065217364 -> j2774972500;
	j4167599846 [label="Кажется, ты ещё не до конца это поняла. ",shape=box,color=blue];
		j4167599846 -> j1926597457;
	j245139932 [label="Если рискнёшь, это может стоить тебе всего.",shape=box,color=red];
		j245139932 -> j4167599846;
	j241277097 [label="Ты можешь «с этим работать»?",shape=box,color=red];
		j241277097 -> j4167599846;
	j1926597457 [label="Но я выбираюсь из 1999-го.",shape=box,color=blue];
		j1926597457 -> j3992753229;
	j3992753229 [label="Мне реально всё равно, что со мной будет, пока я пытаюсь туда попасть.",shape=box,color=blue];
		j3992753229 -> j3591242006;
	j3591242006 [label="Это единственное, о чём я думаю.",shape=box,color=blue];
		j3591242006 -> j981716500;
	j981716500 [label="И для меня это хорошо. ",shape=box,color=blue];
		j981716500 -> j2156753723;
}