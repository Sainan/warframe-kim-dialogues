digraph {
	"KayaRank2Convo2 begins." [color=orange];
		"KayaRank2Convo2 begins." -> j579614986;
	j579614986 [label="Привет. Можешь кое-что подтвердить? ",shape=box,color=blue];
		j579614986 -> j4150835848;
	j4150835848 [label="Ключ к твоим способностям перемещения во времени – это какая-то смесь Техноцита и Бездны, в определённой пропорции?",shape=box,color=blue];
		j4150835848 -> j676345175;
		j4150835848 -> j1626985516;
	j676345175 [label="Смесь? Мы тут что, торт печём?",shape=box,color=red];
		j676345175 -> j1444240182;
	j1626985516 [label="То есть учёба у тебя идёт хорошо, да?",shape=box,color=red];
		j1626985516 -> j3240468384;
	j1444240182 [label="Никогда не пробовала, но зуб даю, что вышло бы шикарно.",shape=box,color=blue];
		j1444240182 -> j3503338957;
		j1444240182 -> j511900213;
	j3240468384 [label="Супер хорошо. Я уже практически у цели. Практически.",shape=box,color=blue];
		j3240468384 -> j1417994728;
		j3240468384 -> j3665496292;
	j3503338957 [label="Откуда ты это знаешь?",shape=box,color=red];
		j3503338957 -> j278469869;
	j511900213 [label="Скромная, Нова.",shape=box,color=red];
		j511900213 -> j278469869;
	j1417994728 [label="Как ты можешь быть уверена?",shape=box,color=red];
		j1417994728 -> j1809998625;
	j3665496292 [label="Должно быть, ты была отличным студентом.",shape=box,color=red];
		j3665496292 -> j4213803948;
	j278469869 [label="Мне необязательно быть скромной. У меня был самый высокий балл за всю историю школы, а в первый год в универе я поставила академический рекорд за последние 100 лет.",shape=box,color=blue];
		j278469869 -> j3076652171;
		j278469869 -> j986347458;
	j1809998625 [label="Ты слышала про «Ночную Нору»?",shape=box,color=blue];
		j1809998625 -> j423389439;
		j1809998625 -> j1949126487;
	j4213803948 [label="У меня был самый высокий балл за всю историю школы, а в первый год в универе я поставила академический рекорд за последние 100 лет.",shape=box,color=blue];
		j4213803948 -> j152831446;
	j3076652171 [label="Но это всё равно не значит, что ты могла бы испечь торт. Разве что занималась выпечкой?",shape=box,color=red];
		j3076652171 -> j2600851574;
	j986347458 [label="Но не настолько умна, чтобы не принимать сыворотку Энтрати, да?",shape=box,color=red];
		j986347458 -> j3954625865;
	j423389439 [label="Думаю, да, но она определённо слышала обо мне.",shape=box,color=red];
		j423389439 -> j2007706937;
	j1949126487 [label="Вау, да. Она из моего времени",shape=box,color=red];
		j1949126487 -> j2007706937;
	j152831446 [label="Я была не просто отличным студентом. Универы сами пытались меня к себе переманить. Мой первый год мог быть идеальным...",shape=box,color=blue];
		j152831446 -> j749033939;
		j152831446 -> j1184600656;
	j2600851574 [label="Boolean KayaCake is now true.",color=orange];
		j2600851574 -> j1620850195;
	j3954625865 [label="ХАХА, кто бы говорил? Если это не «Любимчик Энтрати». Да, я слышала, что про тебя болтают",shape=box,color=blue];
		j3954625865 -> j3228328835;
		j3954625865 -> j2306993313;
	j2007706937 [label="Мгмм, конечно. Ну а я смогла создать формулу временного перехвата, которая улавливала звуковые волны! ",shape=box,color=blue];
		j2007706937 -> j1703118966;
	j749033939 [label="Если бы не… Всё это?",shape=box,color=red];
		j749033939 -> j2980967545;
	j1184600656 [label="Если бы не… Энтрати?",shape=box,color=red];
		j1184600656 -> j2980967545;
	j1620850195 [label="О. Мой. Бог. Ты серьёзно думаешь, что я не смогу испечь торт?",shape=box,color=blue];
		j1620850195 -> j3620865141;
	j3228328835 [label="Ты просто выдумываешь это, чтобы выплеснуть злость. Зачем?",shape=box,color=red];
		j3228328835 -> j257596763;
	j2306993313 [label="Ты пытаешься задеть мои чувства?",shape=box,color=red];
		j2306993313 -> j257596763;
	j1703118966 [label="Так вот, я тут иногда подслушиваю. Думаю, мы бы поладили.",shape=box,color=blue];
		j1703118966 -> j2622503692;
	j2980967545 [label="Если бы не этот тупой идиотский интернет. ",shape=box,color=blue];
		j2980967545 -> j1850814960;
		j2980967545 -> j2791769010;
	j3620865141 [label="Отличное отвлечение. Сиди смирно.",shape=box,color=blue];
		j3620865141 -> j2906669224;
	j257596763 [label="Популярность — это не всё, знаешь ли. А что, если все просто ждут твоего провала? Когда ты на вершине, однажды все захотят тебя свалить. ",shape=box,color=blue];
		j257596763 -> j2664114170;
		j257596763 -> j2071596641;
	j2622503692 [label="Так что, во-первых, я могу собрать свои теории и, может быть, попытаться перехватить некую форму материи. Безжизненную, для безопасности.",shape=box,color=blue];
		j2622503692 -> j3707744614;
	j1850814960 [label="Интернет однажды умрёт, не переживай.",shape=box,color=red];
		j1850814960 -> j1408631116;
	j2791769010 [label="Так у тебя были проблемы в университете из-за… интернета.",shape=box,color=red];
		j2791769010 -> j986834097;
	j2906669224 [label="+20 Chemistry",color=orange];
		j2906669224 -> "Chat ends. Next chat will be KayaRank2Convo3.";
	j2664114170 [label="Это тебе не школа. ",shape=box,color=red];
		j2664114170 -> j89705692;
	j2071596641 [label="Мы тут не такие, Нова, у нас реальные проблемы.",shape=box,color=red];
		j2071596641 -> j89705692;
	j3707744614 [label="В каком-то смысле ты оставил мне собственную червоточину, с которой можно поработать, так что, думаю, ты мой напарник по учёбе. Частичный зачёт.",shape=box,color=blue];
		j3707744614 -> j1672858914;
		j3707744614 -> j1798506960;
	j1408631116 [label="Может, это я его убью!",shape=box,color=blue];
		j1408631116 -> j2815353829;
	j986834097 [label="Я буквально только что это сказала.",shape=box,color=blue];
		j986834097 -> j1766641052;
	"Chat ends. Next chat will be KayaRank2Convo3." [color=orange];
	j89705692 [label="Доверять людям — значит получать раны. Доверять людям в интернете? Это разрушит твою жизнь. ",shape=box,color=blue];
		j89705692 -> j2906669224;
	j1672858914 [label="«Отлично» нам обоим!",shape=box,color=red];
		j1672858914 -> j2733152299;
	j1798506960 [label="Мне было приятно помочь тебе.",shape=box,color=red];
		j1798506960 -> j172418226;
	j2815353829 [label="Оооо мой бог, это я?",shape=box,color=blue];
		j2815353829 -> j388097468;
		j2815353829 -> j1773537101;
	j1766641052 [label="Я быстро введу тебя в курс дела, раз уж у тебя есть оправдание не разбираться в местных порядках.",shape=box,color=blue];
		j1766641052 -> j1297564478;
	j2733152299 [label="Но ты уверена, что это не просто оставленное включённым мною радио?",shape=box,color=red];
		j2733152299 -> j846182486;
	j172418226 [label="Даже если я едва успеваю следить за тем, что происходит.",shape=box,color=red];
		j172418226 -> j2929822667;
	j388097468 [label="Сожалею, но я правда не знаю. ",shape=box,color=red];
		j388097468 -> j1829560267;
	j1773537101 [label="О да, конечно. Все знают, что Нова — мастер выключать интернет. Именно поэтому я здесь — остановить тебя.",shape=box,color=red];
		j1773537101 -> j2310890555;
	j1297564478 [label="Но люди ЛГУТ в интернете. Они могут прикидываться твоими друзьями, а потом БЫСТРО распространять слухи. ",shape=box,color=blue];
		j1297564478 -> j2271757193;
	j846182486 [label="100% Уверена. ",shape=box,color=blue];
		j846182486 -> j2906669224;
	j2929822667 [label="Продолжай следить.",shape=box,color=blue];
		j2929822667 -> j2906669224;
	j1829560267 [label="Отстой. Ну и ладно.",shape=box,color=blue];
		j1829560267 -> "Chat ends. Next chat will be KayaRank2Convo3.";
	j2310890555 [label="ХА. Конечно.",shape=box,color=blue];
		j2310890555 -> j3368280770;
	j2271757193 [label="И когда это случится, забудь о нормальной жизни. О друзьях. О чём угодно. ",shape=box,color=blue];
		j2271757193 -> j3813358383;
	j3368280770 [label="+20 Chemistry",color=orange];
		j3368280770 -> j898222971;
	j3813358383 [label="Ну и что, тебе всё равно не понять. Просто отстань. ",shape=box,color=blue];
		j3813358383 -> j4127763564;
		j3813358383 -> j1653692773;
	j898222971 [label="Меня ничто не остановит, если я на ЧТО-ТО решилась.",shape=box,color=blue];
		j898222971 -> "Chat ends. Next chat will be KayaRank2Convo3.";
	j4127763564 [label="Как пожелаешь. В одиночестве.",shape=box,color=red];
		j4127763564 -> j1345406051;
	j1653692773 [label="Мне трудно понять, расстрою ли я тебя. Мне жаль, что с тобой случилось что-то плохое, но...",shape=box,color=red];
		j1653692773 -> j2260661441;
	j1345406051 [label="K.",shape=box,color=blue];
		j1345406051 -> "Chat ends. Next chat will be KayaRank2Convo3.";
	j2260661441 [label="Мне просто нужно время. Ладно. Пока.",shape=box,color=blue];
		j2260661441 -> "Chat ends. Next chat will be KayaRank2Convo3.";
}