		j3919099667 -> j1588515747 [label=true,color=green];
		j3919099667 -> j206472661 [label=false,color=brown];
	j206472661 [label="Я, может, вообще отсюда не выберусь. Я уже смирилась с этим.",shape=box,color=blue];
		j206472661 -> j2334490270;
	j1588515747 [label="Ну, для начала, теперь зови меня Кайя.",shape=box,color=blue];
		j1588515747 -> j2103263957;
	j2334490270 [label="Я учусь принимать себя такой, какая я есть, и не позволять сожалениям определять меня.",shape=box,color=blue];
		j2334490270 -> j4004721019;
	j2103263957 [label="Потому что если кто-то это читает, то КАЙЯ ВЕЛАСКО всё поняла.",shape=box,color=blue];
		j2103263957 -> j1847320228;
	j4004721019 [label="И если бы я выбралась, это было бы даже жестоко. Слишком опасно, чтобы кто-то пошёл за мной.",shape=box,color=blue];
		j4004721019 -> j1894756915;
	j1847320228 [label="Если будешь искать моё имя, найди две вещи: я РАЗГАДАЛА ЭТО, и я ВЫБРАЛАСЬ из 1999.",shape=box,color=blue];
		j1847320228 -> j2519095975;
	j1894756915 [label="Так что давай делать, что можем! В 1999.",shape=box,color=blue];
		j1894756915 -> j896592232;
		j1894756915 -> j3831132653;
	j2519095975 [label="И какая бы фотка со мной тебе ни попалась, та версия меня оставила вас всех позади. ПОКААА!",shape=box,color=blue];
		j2519095975 -> j854693892;
	j896592232 [label="1999 повезло, что у него есть Кайя Веласко",shape=box,color=red];
		j896592232 -> j1491866842;
	j3831132653 [label="Всё может случиться, но я рада, что мы не одни в этом.",shape=box,color=red];
		j3831132653 -> j1491866842;
	j854693892 [label="Кайя? Да ну. Докажи.",shape=box,color=red];
		j854693892 -> j1269119171;
	j1269119171 [label="Окей. Найди меня в Larunda. Я буду ждать, глядя на звёзды.",shape=box,color=blue];
		j1269119171 -> j1699379038;
