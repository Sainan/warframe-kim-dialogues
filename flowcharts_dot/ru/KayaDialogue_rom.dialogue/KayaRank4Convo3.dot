digraph {
	"KayaRank4Convo3 begins." [color=orange];
		"KayaRank4Convo3 begins." -> j646100073;
	j646100073 [label="Я доверяю тебе.",shape=box,color=blue];
		j646100073 -> j3993620234;
	j3993620234 [label="Но это не значит, что я останусь тут без запасного выхода.",shape=box,color=blue];
		j3993620234 -> j2061046231;
		j3993620234 -> j2233860302;
		j3993620234 -> j1709289528;
	j2061046231 [label="Рада, что теперь мы доверяем друг другу. [Конец.]",shape=box,color=red];
		j2061046231 -> j465934596;
	j2233860302 [label="Насколько ты близка к своему \"побегу\"?",shape=box,color=red];
		j2233860302 -> j1838023119;
	j1709289528 [label="Что тебя убедило?",shape=box,color=red];
		j1709289528 -> j127814067;
	j465934596 [label="+20 Chemistry",color=orange];
		j465934596 -> "Chat ends. Next chat will be KayaRank4Convo4.";
	j1838023119 [label="Эээ, спроси завтра, а?",shape=box,color=blue];
		j1838023119 -> j3427891525;
	j127814067 [label="Я знаю, что мы уже давнооо не в школе. ",shape=box,color=blue];
		j127814067 -> j1195391988;
	"Chat ends. Next chat will be KayaRank4Convo4." [color=orange];
	j3427891525 [label="Может, очень близко. Может, я на пороге чего-то реального.",shape=box,color=blue];
		j3427891525 -> j286935852;
		j3427891525 -> j1714191435;
	j1195391988 [label="Но даже не нужно быть гением, чтобы понять – тебе реально не всё равно. И мы все тебя уважаем.",shape=box,color=blue];
		j1195391988 -> j3676575476;
	j286935852 [label="Ты близка к тому, чтобы сбежать из 1999-го?",shape=box,color=red];
		j286935852 -> j46254844;
	j1714191435 [label="Какая сейчас главная зацепка?",shape=box,color=red];
		j1714191435 -> j280534318;
	j3676575476 [label="Даже Артур. Во-первых, огромный краш на него, о боже.",shape=box,color=blue];
		j3676575476 -> j1211137507;
	j46254844 [label="Ага! Конечно, есть несколько \"но\". Самый точный и безопасный путь – вернуться ровно в тот момент, откуда ты пришёл. Там есть что-то вроде \"Отпечатка Бездны\".",shape=box,color=blue];
		j46254844 -> j2589872769;
		j46254844 -> j210141841;
		j46254844 -> j2069117216;
	j280534318 [label="Ты, естественно.",shape=box,color=blue];
		j280534318 -> j1115335865;
		j280534318 -> j627094106;
	j1211137507 [label="Check boolean ArthurDating",color=orange];
		j1211137507 -> j2042216371 [label=true,color=green];
		j1211137507 -> j1539484169 [label=false,color=brown];
		j1211137507 -> j3864440867 [label=false,color=brown];
	j2589872769 [label="Ты всё ещё уверена в этом?",shape=box,color=red];
		j2589872769 -> j578385526;
	j210141841 [label="Моё время, знаешь ли, не намного лучше, но хотя бы я там, чтобы помочь.",shape=box,color=red];
		j210141841 -> j583034401;
	j2069117216 [label="Хмм, а Бездна на самом деле довольно серьёзно относится к пальцам.",shape=box,color=red];
		j2069117216 -> j3766752124;
	j1115335865 [label="Я, наверное, особенная.",shape=box,color=red];
		j1115335865 -> j46254844;
	j627094106 [label="Я?",shape=box,color=red];
		j627094106 -> j46254844;
	j2042216371 [label="Ты же знаешь, что он занят, да?",shape=box,color=red];
		j2042216371 -> j1112646223;
	j1539484169 [label="Окей, замолвлю словечко.",shape=box,color=red];
		j1539484169 -> j3472288699;
	j3864440867 [label="Фу.",shape=box,color=red];
		j3864440867 -> j940548809;
	j578385526 [label="Так уверенно. Это вызов. Что бы ни случилось – пусть случится, да? Это держит меня в тонусе, фокусирует... ",shape=box,color=blue];
		j578385526 -> j2229708716;
	j583034401 [label="Точно! Сжечь корабли! Не оглядываться!",shape=box,color=blue];
		j583034401 -> j465934596;
	j3766752124 [label="А?",shape=box,color=blue];
		j3766752124 -> j2137861499;
	j1112646223 [label="Пффф, ну да, ВЕЗЁТ ЖЕ! Ну ладно",shape=box,color=blue];
		j1112646223 -> j2042520007;
	j3472288699 [label="ПФФФ НЕТ, пожалуйста, не надо, я же сказала тебе это с УВЕРЕННОСТЬЮ! В любом случае...",shape=box,color=blue];
		j3472288699 -> j2042520007;
	j940548809 [label="Эм, ты с ума сошёл? Не отвратительно. В ЛЮБОМ СЛУЧАЕ!",shape=box,color=blue];
		j940548809 -> j2042520007;
	j2229708716 [label="Тут нет минусов. Либо я разберусь, либо нет. Увидимся тут, или увидимся там. Так ведь? Увидимся!",shape=box,color=blue];
		j2229708716 -> j465934596;
	j2137861499 [label="Всё это, всё, что сделал Энтрати. Его погоня за Бездной, за её сущностью... за всем этим.",shape=box,color=red];
		j2137861499 -> j2165977443;
	j2042520007 [label="Но в каком-то смысле это как школа, где все тебя любят.",shape=box,color=blue];
		j2042520007 -> j982057420;
	j2165977443 [label="И всё сводится к одному пальцу. Пальцу.",shape=box,color=red];
		j2165977443 -> j1574565452;
	j982057420 [label="И это говорит о чём-то большем, чем просто популярность.",shape=box,color=blue];
		j982057420 -> j216735616;
	j1574565452 [label="Ты увлеклась пивом Артура? Почему раньше не сказала?",shape=box,color=blue];
		j1574565452 -> j3158645025;
		j1574565452 -> j3027843398;
		j1574565452 -> j1141858016;
	j216735616 [label="Мы все, если честно, немного того. ",shape=box,color=blue];
		j216735616 -> j1960386251;
		j216735616 -> j2720314090;
		j216735616 -> j3156497955;
	j3158645025 [label="Бездна. В учебниках про неё толку ноль.",shape=box,color=red];
		j3158645025 -> j154293689;
	j3027843398 [label="Пивка бы сейчас – может, хоть что-то стало бы понятнее.",shape=box,color=red];
		j3027843398 -> j154293689;
	j1141858016 [label="Это не то, что просто упоминают. Это конец и начало.",shape=box,color=red];
		j1141858016 -> j154293689;
	j1960386251 [label="Закрутилась и вляпалась! Добро пожаловать в команду. [Конец.]",shape=box,color=red];
		j1960386251 -> j465934596;
	j2720314090 [label="Кого, по-твоему, больше всего перекосило?",shape=box,color=red];
		j2720314090 -> j1809818272;
	j3156497955 [label="Это комплимент?",shape=box,color=red];
		j3156497955 -> j2838772933;
	j154293689 [label="Но что ты имеешь в виду под \"палец\"?",shape=box,color=blue];
		j154293689 -> j2427214982;
		j154293689 -> j2478181029;
	j1809818272 [label="Омг... сплетни? После всего, что я только что сказала? ",shape=box,color=blue];
		j1809818272 -> j3488874102;
	j2838772933 [label="Ага, стопроцентно. Ведь тут вообще никто ни с кем не соревнуется.",shape=box,color=blue];
		j2838772933 -> j768804025;
	j2427214982 [label="У Альбрехта есть его палец.",shape=box,color=red];
		j2427214982 -> j1113967999;
	j2478181029 [label="Есть палец... от него. В моё время. В нашем мире, думаю.",shape=box,color=red];
		j2478181029 -> j1113967999;
	j3488874102 [label="(Но, очевидно, Артур, потому что я с ним говорила, и, похоже, ты реально вскрыл ему мозг.)",shape=box,color=blue];
		j3488874102 -> j841394381;
	j768804025 [label="Это просто… самая странная штука. Мы превращаемся в монстров, но при этом никогда не были такими человечными.",shape=box,color=blue];
		j768804025 -> j406650990;
	j1113967999 [label="Окей, значит, материя сохраняется, спасибо!",shape=box,color=blue];
		j1113967999 -> j223451804;
	j841394381 [label="Что, кстати, подтвердило мою гипотезу о твоей телесной связи с 1999.",shape=box,color=blue];
		j841394381 -> j4126049110;
	j406650990 [label="Теперь я наконец-то могу быть собой.",shape=box,color=blue];
		j406650990 -> j971172065;
	j223451804 [label="Это всё?",shape=box,color=red];
		j223451804 -> j284083714;
	j4126049110 [label="Что, собственно, актуально, потому что… А! Тест завершён. Поговорим позже.",shape=box,color=blue];
		j4126049110 -> j465934596;
	j971172065 [label="Я больше не боюсь.",shape=box,color=blue];
		j971172065 -> j1742445679;
	j284083714 [label="Не \"что это\"? А почему у него есть палец?",shape=box,color=red];
		j284083714 -> j3201715185;
	j1742445679 [label="Ну, спасибо?",shape=box,color=blue];
		j1742445679 -> j465934596;
	j3201715185 [label="Ты с этим разберёшься. Сохранение состояний материи куда интереснее. Спасибо!",shape=box,color=blue];
		j3201715185 -> j465934596;
}