digraph {
	601 [label="KayaRank4Convo3 begins.",color=orange];
		601 -> 602;
	602 [label="Я доверяю тебе.",shape=box,color=blue];
		602 -> 603;
	603 [label="Но это не значит, что я останусь тут без запасного выхода.",shape=box,color=blue];
		603 -> 604;
		603 -> 605;
		603 -> 606;
	604 [label="Рада, что теперь мы доверяем друг другу. [Конец.]",shape=box,color=red];
		604 -> 607;
	605 [label="Насколько ты близка к своему \"побегу\"?",shape=box,color=red];
