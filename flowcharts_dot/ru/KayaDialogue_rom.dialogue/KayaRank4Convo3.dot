		606 -> 609;
	607 [label="+20 Chemistry",color=orange];
		607 -> 610;
	608 [label="Эээ, спроси завтра, а?",shape=box,color=blue];
		608 -> 611;
	609 [label="Я знаю, что мы уже давнооо не в школе. ",shape=box,color=blue];
		609 -> 612;
	610 [label="Chat ends. Next chat will be KayaRank4Convo4.",color=orange];
	611 [label="Может, очень близко. Может, я на пороге чего-то реального.",shape=box,color=blue];
		611 -> 613;
		611 -> 614;
	612 [label="Но даже не нужно быть гением, чтобы понять – тебе реально не всё равно. И мы все тебя уважаем.",shape=box,color=blue];
		612 -> 615;
	613 [label="Ты близка к тому, чтобы сбежать из 1999-го?",shape=box,color=red];
		613 -> 616;
	614 [label="Какая сейчас главная зацепка?",shape=box,color=red];
		614 -> 617;
	615 [label="Даже Артур. Во-первых, огромный краш на него, о боже.",shape=box,color=blue];
		615 -> 618;
	616 [label="Ага! Конечно, есть несколько \"но\". Самый точный и безопасный путь – вернуться ровно в тот момент, откуда ты пришёл. Там есть что-то вроде \"Отпечатка Бездны\".",shape=box,color=blue];
		616 -> 619;
		616 -> 620;
		616 -> 621;
	617 [label="Ты, естественно.",shape=box,color=blue];
		617 -> 622;
		617 -> 623;
	618 [label="Check boolean ArthurDating",color=orange];
		618 -> 626 [label=true,color=green];
		618 -> 625 [label=false,color=brown];
		618 -> 624 [label=false,color=brown];
	619 [label="Ты всё ещё уверена в этом?",shape=box,color=red];
		619 -> 627;
	620 [label="Моё время, знаешь ли, не намного лучше, но хотя бы я там, чтобы помочь.",shape=box,color=red];
		620 -> 628;
	621 [label="Хмм, а Бездна на самом деле довольно серьёзно относится к пальцам.",shape=box,color=red];
		621 -> 629;
	622 [label="Я, наверное, особенная.",shape=box,color=red];
		622 -> 630;
	623 [label="Я?",shape=box,color=red];
		623 -> 630;
	626 [label="Ты же знаешь, что он занят, да?",shape=box,color=red];
		626 -> 633;
	625 [label="Окей, замолвлю словечко.",shape=box,color=red];
		625 -> 632;
	624 [label="Фу.",shape=box,color=red];
		624 -> 631;
	627 [label="Так уверенно. Это вызов. Что бы ни случилось – пусть случится, да? Это держит меня в тонусе, фокусирует... ",shape=box,color=blue];
		627 -> 634;
	628 [label="Точно! Сжечь корабли! Не оглядываться!",shape=box,color=blue];
		628 -> 635;
	629 [label="А?",shape=box,color=blue];
		629 -> 636;
	630 [label="Ага! Конечно, есть несколько \"но\". Самый точный и безопасный путь – вернуться ровно в тот момент, откуда ты пришёл. Там есть что-то вроде \"Отпечатка Бездны\".",shape=box,color=blue];
		630 -> 619;
		630 -> 620;
		630 -> 621;
	633 [label="Пффф, ну да, ВЕЗЁТ ЖЕ! Ну ладно",shape=box,color=blue];
		633 -> 637;
	632 [label="ПФФФ НЕТ, пожалуйста, не надо, я же сказала тебе это с УВЕРЕННОСТЬЮ! В любом случае...",shape=box,color=blue];
		632 -> 637;
	631 [label="Эм, ты с ума сошёл? Не отвратительно. В ЛЮБОМ СЛУЧАЕ!",shape=box,color=blue];
		631 -> 637;
	634 [label="Тут нет минусов. Либо я разберусь, либо нет. Увидимся тут, или увидимся там. Так ведь? Увидимся!",shape=box,color=blue];
		634 -> 638;
	635 [label="+20 Chemistry",color=orange];
		635 -> 639;
	636 [label="Всё это, всё, что сделал Энтрати. Его погоня за Бездной, за её сущностью... за всем этим.",shape=box,color=red];
		636 -> 640;
	637 [label="Но в каком-то смысле это как школа, где все тебя любят.",shape=box,color=blue];
		637 -> 641;
	638 [label="+20 Chemistry",color=orange];
		638 -> 642;
	639 [label="Chat ends. Next chat will be KayaRank4Convo4.",color=orange];
	640 [label="И всё сводится к одному пальцу. Пальцу.",shape=box,color=red];
		640 -> 643;
	641 [label="И это говорит о чём-то большем, чем просто популярность.",shape=box,color=blue];
		641 -> 644;
	642 [label="Chat ends. Next chat will be KayaRank4Convo4.",color=orange];
	643 [label="Ты увлеклась пивом Артура? Почему раньше не сказала?",shape=box,color=blue];
		643 -> 645;
		643 -> 646;
		643 -> 647;
	644 [label="Мы все, если честно, немного того. ",shape=box,color=blue];
		644 -> 648;
		644 -> 649;
		644 -> 650;
	645 [label="Бездна. В учебниках про неё толку ноль.",shape=box,color=red];
		645 -> 651;
	646 [label="Пивка бы сейчас – может, хоть что-то стало бы понятнее.",shape=box,color=red];
		646 -> 651;
	647 [label="Это не то, что просто упоминают. Это конец и начало.",shape=box,color=red];
		647 -> 651;
	648 [label="Закрутилась и вляпалась! Добро пожаловать в команду. [Конец.]",shape=box,color=red];
		648 -> 652;
	649 [label="Кого, по-твоему, больше всего перекосило?",shape=box,color=red];
		649 -> 653;
	650 [label="Это комплимент?",shape=box,color=red];
		650 -> 654;
	651 [label="Но что ты имеешь в виду под \"палец\"?",shape=box,color=blue];
		651 -> 655;
		651 -> 656;
	652 [label="+20 Chemistry",color=orange];
		652 -> 657;
	653 [label="Омг... сплетни? После всего, что я только что сказала? ",shape=box,color=blue];
		653 -> 658;
	654 [label="Ага, стопроцентно. Ведь тут вообще никто ни с кем не соревнуется.",shape=box,color=blue];
		654 -> 659;
	655 [label="У Альбрехта есть его палец.",shape=box,color=red];
		655 -> 660;
	656 [label="Есть палец... от него. В моё время. В нашем мире, думаю.",shape=box,color=red];
		656 -> 660;
	657 [label="Chat ends. Next chat will be KayaRank4Convo4.",color=orange];
	658 [label="(Но, очевидно, Артур, потому что я с ним говорила, и, похоже, ты реально вскрыл ему мозг.)",shape=box,color=blue];
		658 -> 661;
	659 [label="Это просто… самая странная штука. Мы превращаемся в монстров, но при этом никогда не были такими человечными.",shape=box,color=blue];
		659 -> 662;
	660 [label="Окей, значит, материя сохраняется, спасибо!",shape=box,color=blue];
		660 -> 663;
	661 [label="Что, кстати, подтвердило мою гипотезу о твоей телесной связи с 1999.",shape=box,color=blue];
		661 -> 664;
	662 [label="Теперь я наконец-то могу быть собой.",shape=box,color=blue];
		662 -> 665;
	663 [label="Это всё?",shape=box,color=red];
		663 -> 666;
	664 [label="Что, собственно, актуально, потому что… А! Тест завершён. Поговорим позже.",shape=box,color=blue];
		664 -> 667;
	665 [label="Я больше не боюсь.",shape=box,color=blue];
		665 -> 668;
	666 [label="Не \"что это\"? А почему у него есть палец?",shape=box,color=red];
		666 -> 669;
	667 [label="+20 Chemistry",color=orange];
		667 -> 670;
	668 [label="Ну, спасибо?",shape=box,color=blue];
		668 -> 671;
	669 [label="Ты с этим разберёшься. Сохранение состояний материи куда интереснее. Спасибо!",shape=box,color=blue];
