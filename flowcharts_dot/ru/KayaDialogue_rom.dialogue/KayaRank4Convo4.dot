digraph {
	graph [fontname="Roboto Condensed"];
	node [fontname="Roboto Condensed"];
	edge [fontname="Roboto Condensed"];

	"KayaRank4Convo4 begins." [color=orange];
		"KayaRank4Convo4 begins." -> j2059420620;
	j2059420620 [label="Кажется, у меня есть кое-что, что тебе поможет.",shape=box,color=red];
		j2059420620 -> j690819559;
	j690819559 [label="Есть одно место, которое я знаю. Ну, вообще-то, откуда я родом. Дувири.",shape=box,color=red];
		j690819559 -> j3634859972;
	j3634859972 [label="И оно до сих пор там, даже без меня. В Бездне.",shape=box,color=red];
		j3634859972 -> j501408565;
	j501408565 [label="А система, где тот другой ребёнок, я там бывала.",shape=box,color=red];
		j501408565 -> j343692720;
	j343692720 [label="Мгмм, твои шаги и правда ключ к тому, чтобы я \"шла безопасно за тобой, знаешь ли\".",shape=box,color=blue];
		j343692720 -> j2461794405;
	j2461794405 [label="Boolean KayaFutureWin1 is now true.",color=orange];
		j2461794405 -> j3701561281;
	j3701561281 [label="Это как огромная светящаяся вывеска выход в Бездну, когда частицы притягиваются к своей следующей форме.",shape=box,color=blue];
		j3701561281 -> j1855749424;
	j1855749424 [label="Извиняюсь, эээ, так, но что такое \"Дувири\"? Состояние материи? ",shape=box,color=blue];
		j1855749424 -> j3980658271;
		j1855749424 -> j2682451536;
	j3980658271 [label="Это место, которое я создала в Бездне.",shape=box,color=red];
		j3980658271 -> j3804045154;
	j2682451536 [label="Во многом это мой настоящий дом. Там я... выросла.",shape=box,color=red];
		j2682451536 -> j834635351;
	j3804045154 [label="Место, наполненное воплощениями концепций, эмоций.",shape=box,color=red];
		j3804045154 -> j419836301;
	j834635351 [label="Оно в Бездне.",shape=box,color=red];
		j834635351 -> j2331056091;
	j419836301 [label="По сути, это \"учебник\", оживший в реальности.",shape=box,color=red];
		j419836301 -> j157347807;
	j2331056091 [label="Правда, в последнее время у нас гостей немного.",shape=box,color=red];
		j2331056091 -> j2273676859;
	j157347807 [label="Хаха! Омг. Ладно, поняла, и оно полностью в Бездне?",shape=box,color=blue];
		j157347807 -> j2698984174;
	j2273676859 [label="Раскатайте красную дорожку, вдруг я зайду.",shape=box,color=blue];
		j2273676859 -> j3433957377;
		j2273676859 -> j3412229280;
		j2273676859 -> j887823976;
	j2698984174 [label="Да, но оно всё равно крепко привязано к Зариману.",shape=box,color=red];
		j2698984174 -> j846474678;
	j3433957377 [label="Я нечасто туда возвращаюсь...",shape=box,color=red];
		j3433957377 -> j1690372324;
	j3412229280 [label="Ты правда думаешь, что пойдешь туда?",shape=box,color=red];
		j3412229280 -> j2840733017;
	j887823976 [label="Принято, космопроходец! [Конец.]",shape=box,color=red];
		j887823976 -> j392027042;
	j846474678 [label="Как огромная металлическая Луна.",shape=box,color=red];
		j846474678 -> j3421788151;
	j1690372324 [label="Оно вообще ещё там? Как ты можешь быть уверена?",shape=box,color=blue];
		j1690372324 -> j2930037663;
	j2840733017 [label="Нужно учитывать все возможные исходы.",shape=box,color=blue];
		j2840733017 -> j2549058976;
		j2840733017 -> j1932366969;
	j392027042 [label="+20 Chemistry",color=orange];
		j392027042 -> "Chat ends. Next chat will be KayaRank5Convo1.";
	j3421788151 [label="Есть ли там солнце?",shape=box,color=blue];
		j3421788151 -> j2432640410;
		j3421788151 -> j2879996049;
	j2930037663 [label="Думаю, да? Если бы оно исчезло, я бы заметила, даже если меня там нет.",shape=box,color=red];
		j2930037663 -> j1980257469;
	j2549058976 [label="А что будет, если ты потеряешься где-то, когда-то?",shape=box,color=red];
		j2549058976 -> j2196158796;
	j1932366969 [label="Я не против обсудить всё это, но ты правда думаешь, что найдёшь выход из 1999?",shape=box,color=red];
		j1932366969 -> j385194905;
	"Chat ends. Next chat will be KayaRank5Convo1." [color=orange];
	j2432640410 [label="Достаточно сильно об этом подумай и, может быть?",shape=box,color=red];
		j2432640410 -> j340631979;
	j2879996049 [label="Я просто выразилась поэтично, никакого солнца нет.",shape=box,color=red];
		j2879996049 -> j2932467863;
	j1980257469 [label="Ты бы стала? Есть направление в науке, которое считает, что само наблюдение за Дувири может быть ключом к его существованию.",shape=box,color=blue];
		j1980257469 -> j2103692829;
		j1980257469 -> j483219884;
	j2196158796 [label="ХЗ, скажи что-нибудь хорошее на моих поминках, если вдруг больше не увидимся.",shape=box,color=blue];
		j2196158796 -> j2885272005;
	j385194905 [label="Ага, и дай знать, если сможешь помочь! ",shape=box,color=blue];
		j385194905 -> j392027042;
	j340631979 [label="Ха, ха.",shape=box,color=blue];
		j340631979 -> j2293854723;
	j2932467863 [label="Какие-нибудь небесные объекты?",shape=box,color=blue];
		j2932467863 -> j59944057;
		j2932467863 -> j1260517618;
	j2103692829 [label="Не уверена, что наука может это объяснить. \"Это\" — причина всего этого.",shape=box,color=red];
		j2103692829 -> j2109675261;
	j483219884 [label="Звучит больше как философия.",shape=box,color=red];
		j483219884 -> j1006699385;
	j2885272005 [label="О, и передай Артуру, что он милый, но только если я прям реально исчезну. ",shape=box,color=blue];
		j2885272005 -> j1487584150;
	j2293854723 [label="Постараюсь.",shape=box,color=blue];
		j2293854723 -> j392027042;
	j59944057 [label="Не знаю ни о чём таком.",shape=box,color=red];
		j59944057 -> j927967560;
	j1260517618 [label="Неа.",shape=box,color=red];
		j1260517618 -> j927967560;
	j2109675261 [label="Думаешь, можно ли объяснить «Это»?",shape=box,color=blue];
		j2109675261 -> j4169619366;
		j2109675261 -> j1914606267;
	j1006699385 [label="Не самая высокая оценка, не напоминай, угх.",shape=box,color=blue];
		j1006699385 -> j2525162902;
	j1487584150 [label="Check boolean ArthurDating",color=orange];
		j1487584150 -> j3781239600 [label=true,color=green];
		j1487584150 -> j3236356337 [label=false,color=brown];
		j1487584150 -> j360847691 [label=false,color=brown];
	j927967560 [label="Всё во вселенной определяется в отношении к небесным телам. Как странно, эта Бездна.",shape=box,color=blue];
		j927967560 -> j780100003;
		j927967560 -> j3531278616;
	j4169619366 [label="Не уверена, что хочу этого.",shape=box,color=red];
		j4169619366 -> j31584203;
	j1914606267 [label="Если бы \"это\" было возможно, мы бы кучу проблем решили.",shape=box,color=red];
		j1914606267 -> j31584203;
	j2525162902 [label="Тебе сложно с философией?",shape=box,color=red];
		j2525162902 -> j3524657148;
	j3781239600 [label="Несмотря на обстоятельства... если до этого дойдёт, я так и сделаю. ",shape=box,color=red];
		j3781239600 -> j3362650048;
	j3236356337 [label="Принято. ",shape=box,color=red];
		j3236356337 -> j3362650048;
	j360847691 [label="Надеюсь, до этого не дойдёт.",shape=box,color=red];
		j360847691 -> j4092306500;
	j780100003 [label="Это и есть \"Бездна\". Это ничто, пока оно не станет чем-то.",shape=box,color=red];
		j780100003 -> j327527787;
	j3531278616 [label="Когда найдём Альбрехта, нам, наверное, придётся отнести его обратно туда или что-то в этом духе. У меня пока нет плана.",shape=box,color=red];
		j3531278616 -> j327527787;
	j31584203 [label="Ну, ради тебя, думаю, было бы забавно разгадать твою научную загадку. Надеюсь, ты найдёшь ответы.",shape=box,color=blue];
		j31584203 -> j4103502361;
		j31584203 -> j3149524868;
	j3524657148 [label="Наверное? Хотя не то чтобы прям \"сложно\". Какая разница, кто и почему, давай просто делать крутые штуки.",shape=box,color=blue];
		j3524657148 -> j3147110616;
		j3524657148 -> j3361095438;
	j3362650048 [label="Спаааасибооо!",shape=box,color=blue];
		j3362650048 -> j392027042;
	j4092306500 [label="Мда.",shape=box,color=blue];
		j4092306500 -> j3362650048;
	j327527787 [label="Нууу, вроде связано, но не моя область. Увидимся, если увидимся!",shape=box,color=blue];
		j327527787 -> j392027042;
	j4103502361 [label="Не уверена, что мне понравятся ответы, Нова.",shape=box,color=red];
		j4103502361 -> j392027042;
	j3149524868 [label="Мне тоже, когда-нибудь.",shape=box,color=red];
		j3149524868 -> j392027042;
	j3147110616 [label="Допустим, но ты же делишь эту планету с другими, наши решения влияют на окружающих, нравится нам это или нет.",shape=box,color=red];
		j3147110616 -> j1236506287;
	j3361095438 [label="Может, так же думал Энтрати, когда впервые пошёл в Бездну. И вот где мы теперь.",shape=box,color=red];
		j3361095438 -> j80145838;
	j1236506287 [label="Мда.",shape=box,color=blue];
		j1236506287 -> j1573517030;
	j80145838 [label="Мда.",shape=box,color=blue];
		j80145838 -> j392027042;
	j1573517030 [label="Ладно. Ты права. ",shape=box,color=blue];
		j1573517030 -> j392027042;
