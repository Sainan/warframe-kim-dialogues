		103 -> 109 [label=false,color=brown];
	104 [label="Ты меня не знаешь. Или подожди, это твоя реплика?",shape=box,color=red];
		104 -> 111;
	105 [label="Могу пообещать, что узнаю.",shape=box,color=red];
		105 -> 112;
	106 [label="Chat ends. Next chat will be KayaRank2Convo1.",color=orange];
	108 [label="+5 Chemistry",color=orange];
		108 -> 101;
	107 [label="Так он за своим компом или где-то ещё.",shape=box,color=blue];
		107 -> 113;
	110 [label="Ну, мы стараемся использовать по максимуму то, что у нас есть. Ты говорила с Амиром насчёт своих вопросов?",shape=box,color=red];
		110 -> 116;
	109 [label="Check boolean KayaLettieHeal",color=orange];
		109 -> 115 [label=true,color=green];
		109 -> 114 [label=false,color=brown];
	111 [label="Да, я тебя не знаю. Я знаю только, что ты можешь. Вот почему мы говорим. Серьёзно.",shape=box,color=blue];
		111 -> 117;
	112 [label="Обещание от незнакомца в интернете? Да ну. Ха. Просто скажи мне то, что я хочу знать.",shape=box,color=blue];
		112 -> 118;
	113 [label="И я прихожу, а он реально пугается. Он вообще НЕ ожидал, что кто-то появится.",shape=box,color=blue];
		113 -> 119;
		113 -> 120;
	116 [label="Говорила. Мы сошлись в некоторых основах, но он, похоже, не заинтересована в создании чёткой и воспроизводимой теоремы путешествий во времени. ",shape=box,color=blue];
		116 -> 123;
	115 [label="Мы и так стараемся использовать по максимуму то, что у нас есть. Ты говорила с Лэтти? Мне кажется, вы бы нашли общий язык.",shape=box,color=red];
		115 -> 122;
	114 [label="Ну да, я просто имела в виду, что было бы проще, если бы ты могла получить доступ к большему количеству инструментов из моего времени..",shape=box,color=red];
		114 -> 121;
	117 [label="Ладно, давай серьёзно.",shape=box,color=red];
		117 -> 124;
		117 -> 125;
	118 [label="С тобой что-то случилось?",shape=box,color=red];
		118 -> 126;
	119 [label="Вау, впечатляет.",shape=box,color=red];
		119 -> 127;
	120 [label="Вау, ты сейчас реально хвастаешься?",shape=box,color=red];
		120 -> 127;
	123 [label="Вообще, он убедил меня, что я ошибалась в своих первоначальных гипотезах, так что это помогло, но он напомнил мне, что, может, я просто могу заплатить, чтобы получить ответ. Или хотя бы заплатить за разговор с кем-то ещё из будущего, если ты мне не поможешь.",shape=box,color=blue];
		123 -> 130;
		123 -> 131;
	122 [label="Мы действительно ладим. Она напоминает мне одну учительницу — абсолютно без злобы, видела во мне нечто большее, чем просто оболочку.",shape=box,color=blue];
		122 -> 129;
	121 [label="Это предложение? Что я могу получить? Любая помощь пригодится.",shape=box,color=blue];
		121 -> 128;
	124 [label="Ты хочешь путешествовать во времени, но куда? Зачем?",shape=box,color=red];
		124 -> 132;
	125 [label="Ты вообще вокруг смотрела?",shape=box,color=red];
		125 -> 133;
	126 [label="С нами всеми что-то случилось. Просто дай знать, если найдёшь способ мне помочь. ",shape=box,color=blue];
		126 -> 134;
	127 [label="Угх, зачем я тебе это снова рассказываю?",shape=box,color=blue];
		127 -> 135;
	130 [label="За 10 хёлларов расскажу, как ты умрёшь.",shape=box,color=red];
		130 -> 139;
	131 [label="Любой, кто пытается тебе это продать, врёт. Я попробую помочь, правда попробую. Бесплатно.",shape=box,color=red];
		131 -> 140;
	129 [label="Она вообще, ну, реально супер расслабленная. Умная тоже. Хотя… она сказала мне, что тебе можно доверять, так что… посмотрим.",shape=box,color=blue];
		129 -> 137;
		129 -> 138;
	128 [label="Ладно, посмотрю, что смогу найти для тебя, если хочешь разобраться по-своему.",shape=box,color=red];
		128 -> 136;
	132 [label="Ты вообще можешь ЧТО-НИБУДЬ выяснить? Угх.",shape=box,color=blue];
		132 -> 141;
	133 [label="Ага, могу. Я всё видела. Это чудесное наступление нового тысячелетия. Приглашения на столько вечеринок, потому что всем там нужна была «та самая девчонка».",shape=box,color=blue];
		133 -> 142;
	134 [label="+20 Chemistry",color=orange];
		134 -> 143;
	135 [label="Просто скажи, мне нужно копить или что-то в этом роде?",shape=box,color=blue];
		135 -> 144;
		135 -> 145;
	139 [label="Угх. Извращенка.",shape=box,color=blue];
		139 -> 149;
	140 [label="Посмотрим, не правда ли.",shape=box,color=blue];
		140 -> 150;
	137 [label="Я не для того здесь, чтобы предавать тебя или что-то такое, и я не учебник по путешествиям во времени",shape=box,color=red];
		137 -> 147;
	138 [label="Обещаю, мне можно доверять, не понимаю, почему ты так враждебно настроена.",shape=box,color=red];
		138 -> 148;
	136 [label="Да. Так и сделаю.",shape=box,color=blue];
		136 -> 146;
	141 [label="Кто вообще захочет тут оставаться? Типа..",shape=box,color=blue];
		141 -> 151;
	142 [label="Оно никогда не закончится. Смотри вперёд. Найди меня, когда сможешь помочь.",shape=box,color=blue];
		142 -> 152;
	143 [label="Chat ends. Next chat will be KayaRank2Convo1.",color=orange];
	144 [label="Кайя, мне кажется, ты слишком зациклился на этом. А что, если не получится разобраться?",shape=box,color=red];
