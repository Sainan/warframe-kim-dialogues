digraph {
	graph [fontname="Roboto Condensed"];
	node [fontname="Roboto Condensed"];
	edge [fontname="Roboto Condensed"];

	"KayaRank1Convo3 begins." [color=orange];
		"KayaRank1Convo3 begins." -> j3452439968;
	j3452439968 [label="Путешествие во времени - это дорого? Стоимость, связанная с природными ресурсами? Или оно было превращено в товар в вашем времени таким образом, что имеет отношение к чему-либо здесь?",shape=box,color=blue];
		j3452439968 -> j413597076;
		j3452439968 -> j2213170192;
	j413597076 [label="Зачем? Надеешься накопить пару хёлларов и подкупить меня?",shape=box,color=red];
		j413597076 -> j489200976;
	j2213170192 [label="Не все расходы измеряются в хёлларах. И, кстати, привет. ",shape=box,color=red];
		j2213170192 -> j2435251835;
	j489200976 [label="С Энтрати это сработало.",shape=box,color=blue];
		j489200976 -> j1782434583;
		j489200976 -> j713093002;
	j2435251835 [label="Привет. То есть я не могу просто заплатить кому-то и научиться этому?",shape=box,color=blue];
		j2435251835 -> j420665698;
		j2435251835 -> j1597259824;
		j2435251835 -> j3244588243;
	j1782434583 [label="Что, прости?",shape=box,color=red];
		j1782434583 -> j1310704431;
	j713093002 [label="Что?",shape=box,color=red];
		j713093002 -> j1310704431;
	j420665698 [label="Ты ведь знаешь, что твоя «Нова» не имеет никакого отношения к путешествиям во времени, верно?",shape=box,color=red];
		j420665698 -> j2717518381;
	j1597259824 [label="Слушай, кажется, тебя волнует только одно — путешествия во времени. Почему?",shape=box,color=red];
		j1597259824 -> j2687864788;
	j3244588243 [label="Нельзя. [Конец].",shape=box,color=red];
		j3244588243 -> j3994434447;
	j1310704431 [label="Check boolean KayaSetFound",color=orange];
		j1310704431 -> j3950572928 [label=true,color=green];
		j1310704431 -> j1659244593 [label=false,color=brown];
	j2717518381 [label="Неважно, что может или не может Нова.",shape=box,color=blue];
		j2717518381 -> j2647674648;
	j2687864788 [label="Ты бы не поняла.",shape=box,color=blue];
		j2687864788 -> j1662597714;
		j2687864788 -> j3396903950;
	j3994434447 [label="+20 Chemistry",color=orange];
		j3994434447 -> "Chat ends. Next chat will be KayaRank2Convo1.";
	j3950572928 [label="Да блин, я же уже говорила. Я его нашла.",shape=box,color=blue];
		j3950572928 -> j634541586;
	j1659244593 [label="А вот это поймёшь.",shape=box,color=blue];
		j1659244593 -> j405584180;
	j2647674648 [label="Check boolean KayaAmirTravel",color=orange];
		j2647674648 -> j3582530199 [label=true,color=green];
		j2647674648 -> j368315635 [label=false,color=brown];
	j1662597714 [label="Ты меня не знаешь. Или подожди, это твоя реплика?",shape=box,color=red];
		j1662597714 -> j3041579900;
	j3396903950 [label="Могу пообещать, что узнаю.",shape=box,color=red];
		j3396903950 -> j1402393902;
	"Chat ends. Next chat will be KayaRank2Convo1." [color=orange];
	j634541586 [label="+5 Chemistry",color=orange];
		j634541586 -> j1659244593;
	j405584180 [label="Так он за своим компом или где-то ещё.",shape=box,color=blue];
		j405584180 -> j4216619718;
	j3582530199 [label="Ну, мы стараемся использовать по максимуму то, что у нас есть. Ты говорила с Амиром насчёт своих вопросов?",shape=box,color=red];
		j3582530199 -> j885580749;
	j368315635 [label="Check boolean KayaLettieHeal",color=orange];
		j368315635 -> j2070371035 [label=true,color=green];
		j368315635 -> j3757914977 [label=false,color=brown];
	j3041579900 [label="Да, я тебя не знаю. Я знаю только, что ты можешь. Вот почему мы говорим. Серьёзно.",shape=box,color=blue];
		j3041579900 -> j991351576;
	j1402393902 [label="Обещание от незнакомца в интернете? Да ну. Ха. Просто скажи мне то, что я хочу знать.",shape=box,color=blue];
		j1402393902 -> j2254379909;
	j4216619718 [label="И я прихожу, а он реально пугается. Он вообще НЕ ожидал, что кто-то появится.",shape=box,color=blue];
		j4216619718 -> j1715393299;
		j4216619718 -> j1376705238;
	j885580749 [label="Говорила. Мы сошлись в некоторых основах, но он, похоже, не заинтересована в создании чёткой и воспроизводимой теоремы путешествий во времени. ",shape=box,color=blue];
		j885580749 -> j3367841645;
	j2070371035 [label="Мы и так стараемся использовать по максимуму то, что у нас есть. Ты говорила с Лэтти? Мне кажется, вы бы нашли общий язык.",shape=box,color=red];
		j2070371035 -> j2366383915;
	j3757914977 [label="Ну да, я просто имела в виду, что было бы проще, если бы ты могла получить доступ к большему количеству инструментов из моего времени..",shape=box,color=red];
		j3757914977 -> j2074703007;
	j991351576 [label="Ладно, давай серьёзно.",shape=box,color=red];
		j991351576 -> j3253178312;
		j991351576 -> j316640643;
	j2254379909 [label="С тобой что-то случилось?",shape=box,color=red];
		j2254379909 -> j2774972032;
	j1715393299 [label="Вау, впечатляет.",shape=box,color=red];
		j1715393299 -> j4161670423;
	j1376705238 [label="Вау, ты сейчас реально хвастаешься?",shape=box,color=red];
		j1376705238 -> j4161670423;
	j3367841645 [label="Вообще, он убедил меня, что я ошибалась в своих первоначальных гипотезах, так что это помогло, но он напомнил мне, что, может, я просто могу заплатить, чтобы получить ответ. Или хотя бы заплатить за разговор с кем-то ещё из будущего, если ты мне не поможешь.",shape=box,color=blue];
		j3367841645 -> j2557399435;
		j3367841645 -> j4263488843;
	j2366383915 [label="Мы действительно ладим. Она напоминает мне одну учительницу — абсолютно без злобы, видела во мне нечто большее, чем просто оболочку.",shape=box,color=blue];
		j2366383915 -> j2923736862;
	j2074703007 [label="Это предложение? Что я могу получить? Любая помощь пригодится.",shape=box,color=blue];
		j2074703007 -> j2519447311;
	j3253178312 [label="Ты хочешь путешествовать во времени, но куда? Зачем?",shape=box,color=red];
		j3253178312 -> j1932845309;
	j316640643 [label="Ты вообще вокруг смотрела?",shape=box,color=red];
		j316640643 -> j2705063485;
	j2774972032 [label="С нами всеми что-то случилось. Просто дай знать, если найдёшь способ мне помочь. ",shape=box,color=blue];
		j2774972032 -> j3994434447;
	j4161670423 [label="Угх, зачем я тебе это снова рассказываю?",shape=box,color=blue];
		j4161670423 -> j1427007978;
	j2557399435 [label="За 10 хёлларов расскажу, как ты умрёшь.",shape=box,color=red];
		j2557399435 -> j2477400919;
	j4263488843 [label="Любой, кто пытается тебе это продать, врёт. Я попробую помочь, правда попробую. Бесплатно.",shape=box,color=red];
		j4263488843 -> j1603676593;
	j2923736862 [label="Она вообще, ну, реально супер расслабленная. Умная тоже. Хотя… она сказала мне, что тебе можно доверять, так что… посмотрим.",shape=box,color=blue];
		j2923736862 -> j3122508737;
		j2923736862 -> j1070961063;
	j2519447311 [label="Ладно, посмотрю, что смогу найти для тебя, если хочешь разобраться по-своему.",shape=box,color=red];
		j2519447311 -> j3595006718;
	j1932845309 [label="Ты вообще можешь ЧТО-НИБУДЬ выяснить? Угх.",shape=box,color=blue];
		j1932845309 -> j1696570484;
	j2705063485 [label="Ага, могу. Я всё видела. Это чудесное наступление нового тысячелетия. Приглашения на столько вечеринок, потому что всем там нужна была «та самая девчонка».",shape=box,color=blue];
		j2705063485 -> j3582817539;
	j1427007978 [label="Просто скажи, мне нужно копить или что-то в этом роде?",shape=box,color=blue];
		j1427007978 -> j4287039594;
		j1427007978 -> j3969676608;
	j2477400919 [label="Угх. Извращенка.",shape=box,color=blue];
		j2477400919 -> j3994434447;
	j1603676593 [label="Посмотрим, не правда ли.",shape=box,color=blue];
		j1603676593 -> j3994434447;
	j3122508737 [label="Я не для того здесь, чтобы предавать тебя или что-то такое, и я не учебник по путешествиям во времени",shape=box,color=red];
		j3122508737 -> j3144352997;
	j1070961063 [label="Обещаю, мне можно доверять, не понимаю, почему ты так враждебно настроена.",shape=box,color=red];
		j1070961063 -> j522503828;
	j3595006718 [label="Да. Так и сделаю.",shape=box,color=blue];
		j3595006718 -> j3994434447;
	j1696570484 [label="Кто вообще захочет тут оставаться? Типа..",shape=box,color=blue];
		j1696570484 -> j3315540236;
	j3582817539 [label="Оно никогда не закончится. Смотри вперёд. Найди меня, когда сможешь помочь.",shape=box,color=blue];
		j3582817539 -> j3994434447;
	j4287039594 [label="Кайя, мне кажется, ты слишком зациклился на этом. А что, если не получится разобраться?",shape=box,color=red];
		j4287039594 -> j3734804082;
	j3969676608 [label="Без понятия. Я избрааааанная, Кайя. ",shape=box,color=red];
		j3969676608 -> j2522242516;
	j3144352997 [label="Угх. Ок",shape=box,color=blue];
		j3144352997 -> j3994434447;
	j522503828 [label="У меня есть причины",shape=box,color=blue];
		j522503828 -> j3994434447;
	j3315540236 [label="Разберусь, я знаю, что смогу, так что, да. Пока.",shape=box,color=blue];
		j3315540236 -> j3994434447;
	j3734804082 [label="Я смогу.",shape=box,color=blue];
		j3734804082 -> j3994434447;
	j2522242516 [label="Ага, абсолютный избранный ПРИДУРОК",shape=box,color=blue];
		j2522242516 -> j3994434447;
}