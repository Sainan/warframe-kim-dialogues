digraph {
	86 [label="KayaRank1Convo3 begins.",color=orange];
		86 -> 87;
	87 [label="Путешествие во времени - это дорого? Стоимость, связанная с природными ресурсами? Или оно было превращено в товар в вашем времени таким образом, что имеет отношение к чему-либо здесь?",shape=box,color=blue];
		87 -> 88;
		87 -> 89;
	88 [label="Зачем? Надеешься накопить пару хёлларов и подкупить меня?",shape=box,color=red];
		88 -> 90;
	89 [label="Не все расходы измеряются в хёлларах. И, кстати, привет. ",shape=box,color=red];
		89 -> 91;
	90 [label="С Энтрати это сработало.",shape=box,color=blue];
		90 -> 92;
		90 -> 93;
	91 [label="Привет. То есть я не могу просто заплатить кому-то и научиться этому?",shape=box,color=blue];
		91 -> 94;
		91 -> 95;
		91 -> 96;
	92 [label="Что, прости?",shape=box,color=red];
		92 -> 97;
	93 [label="Что?",shape=box,color=red];
		93 -> 97;
	94 [label="Ты ведь знаешь, что твоя «Нова» не имеет никакого отношения к путешествиям во времени, верно?",shape=box,color=red];
		94 -> 98;
	95 [label="Слушай, кажется, тебя волнует только одно — путешествия во времени. Почему?",shape=box,color=red];
		95 -> 99;
	96 [label="Нельзя. [Конец].",shape=box,color=red];
		96 -> 100;
	97 [label="Check boolean KayaSetFound",color=orange];
		97 -> 102 [label=true,color=green];
		97 -> 101 [label=false,color=brown];
	98 [label="Неважно, что может или не может Нова.",shape=box,color=blue];
		98 -> 103;
	99 [label="Ты бы не поняла.",shape=box,color=blue];
		99 -> 104;
		99 -> 105;
	100 [label="+20 Chemistry",color=orange];
		100 -> 106;
	102 [label="Да блин, я же уже говорила. Я его нашла.",shape=box,color=blue];
		102 -> 108;
