digraph {
	"KayaRank1Convo1 begins." [color=orange];
		"KayaRank1Convo1 begins." -> j646719031;
	j646719031 [label="Привет. Все могут путешествовать во времени, или только ты?",shape=box,color=blue];
		j646719031 -> j3850930572;
		j646719031 -> j53369347;
	j3850930572 [label="И тебе добрый день. Слушай, малыш, всё не так просто.",shape=box,color=red];
		j3850930572 -> j1833358151;
	j53369347 [label="Эй? Кайя? Как твой день.",shape=box,color=red];
		j53369347 -> j3099152864;
	j1833358151 [label="Я не малыш. Мне 19.",shape=box,color=blue];
		j1833358151 -> j2729197532;
		j1833358151 -> j3528542975;
	j3099152864 [label="Ладно. ",shape=box,color=blue];
		j3099152864 -> j3822085204;
	j2729197532 [label="Ну да, самый младший в этой новой группе, я бы сказала. Но всё равно, малыш.",shape=box,color=red];
		j2729197532 -> j2097546690;
	j3528542975 [label="Ага-ага, только не торопись с этой темой про путешествия во времени. Это… сложно.",shape=box,color=red];
		j3528542975 -> j1609323471;
	j3822085204 [label="Так. Только ты? Есть ещё кто-то? В будущем этому учат в школах?",shape=box,color=blue];
		j3822085204 -> j795728886;
	j2097546690 [label="Уф. Самый младший, конечно, но, очевидно, и самый настойчивый в поисках ответов. Постарайся не отставать. Ладно: путешествия во времени. Как и кто?",shape=box,color=blue];
		j2097546690 -> j518042448;
	j1609323471 [label="Уф. Как сложно? Формулы? Химические и атомные элементы? Я разберусь, просто направь меня в нужную сторону.",shape=box,color=blue];
		j1609323471 -> j3236958594;
		j1609323471 -> j4014621576;
	j795728886 [label="Скажем, что только я. Так проще.",shape=box,color=red];
		j795728886 -> j46705474;
	j518042448 [label="И почему именно ты? У тебя есть план? ",shape=box,color=blue];
		j518042448 -> j236190062;
	j3236958594 [label="Я не знаю, что тебе сказать. Это не только область науки. А если и так, то это наука, которую знает Энтрати.",shape=box,color=red];
		j3236958594 -> j1915673145;
	j4014621576 [label="Вот тебе направление: Стоп [Конец.]",shape=box,color=red];
		j4014621576 -> j2938341431;
	j46705474 [label="А что насчёт обучения в школах? Если и было, я этого не изучала. Но, может, и было? ",shape=box,color=red];
		j46705474 -> j3408091890;
	j236190062 [label="А если нет, что ты можешь посоветовать, чтобы я смог найти хоть какие-то научные источники по твоим способностям?",shape=box,color=blue];
		j236190062 -> j3445982468;
	j1915673145 [label="Уф, этот мерзавец. Я знала, что нужно было задать ему больше вопросов. Ладно. Если это всё-таки наука, значит, я смогу её воспроизвести. А раз ты можешь приходить и уходить, я смогу это выяснить. Пока.",shape=box,color=blue];
		j1915673145 -> j2938341431;
	j2938341431 [label="+20 Chemistry",color=orange];
		j2938341431 -> "Initiate conversation HexKayaConvo1 in /Lotus/Types/Gameplay/1999Wf/Dialogue/HexDialogue_rom.dialogue";
	j3408091890 [label="А что, хочешь домашку? Путешествия во времени, вероятно, слишком сложны для тебя пока что...",shape=box,color=red];
		j3408091890 -> j3523547754;
	j3445982468 [label="Столько вопросов, малыш. Не хочу тебя расстраивать, но: я не знаю. Только у Энтрати есть ответы.",shape=box,color=red];
		j3445982468 -> j285977890;
	"Initiate conversation HexKayaConvo1 in /Lotus/Types/Gameplay/1999Wf/Dialogue/HexDialogue_rom.dialogue" [label="Initiate conversation HexKayaConvo1 in /Lotus/Types/Gameplay/1999Wf/Dialogue/HexDialogue_rom.dialogue",color=orange];
		"Initiate conversation HexKayaConvo1 in /Lotus/Types/Gameplay/1999Wf/Dialogue/HexDialogue_rom.dialogue" -> "Chat ends. Next chat will be KayaRank1Convo2.";
	j3523547754 [label="Уф, серьёзно?",shape=box,color=blue];
		j3523547754 -> j1725224625;
	j285977890 [label="Boolean KayaSetKid is now true.",color=orange];
		j285977890 -> j1219546166;
	"Chat ends. Next chat will be KayaRank1Convo2." [color=orange];
	j1725224625 [label="Кто-нибудь из Гекс разобрался в этом? У них есть какая-то информация? ",shape=box,color=blue];
		j1725224625 -> j3061141602;
		j1725224625 -> j2092137896;
	j1219546166 [label="K.",shape=box,color=blue];
		j1219546166 -> j2938341431;
	j3061141602 [label="Может, Амир? Он, наверняка, играет в игры с сюжетами про путешествия во времени...",shape=box,color=red];
		j3061141602 -> j555168735;
	j2092137896 [label="Не думаю, малыш. Но если хочешь узнать что-то действительно полезное, попроси Лэтти провести тебе экспресс-курс по исцелению.",shape=box,color=red];
		j2092137896 -> j1650820834;
	j555168735 [label="Boolean KayaAmirTravel is now true.",color=orange];
		j555168735 -> j740757678;
	j1650820834 [label="Boolean KayaLettieHeal is now true.",color=orange];
		j1650820834 -> j854750875;
	j740757678 [label="Игры? Мне нужны ответы, направление, хоть что-то. Я разберусь. Если вспомнишь что-нибудь полезное, найди меня.",shape=box,color=blue];
		j740757678 -> j2938341431;
	j854750875 [label="Не в моём стиле. Как угодно.",shape=box,color=blue];
		j854750875 -> j2938341431;
}