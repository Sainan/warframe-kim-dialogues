digraph {
	0 [label="KayaRank1Convo1 begins.",color=orange];
		0 -> 1;
	1 [label="Привет. Все могут путешествовать во времени, или только ты?",shape=box,color=blue];
		1 -> 2;
		1 -> 3;
	2 [label="И тебе добрый день. Слушай, малыш, всё не так просто.",shape=box,color=red];
		2 -> 4;
	3 [label="Эй? Кайя? Как твой день.",shape=box,color=red];
		3 -> 5;
	4 [label="Я не малыш. Мне 19.",shape=box,color=blue];
		4 -> 6;
		4 -> 7;
	5 [label="Ладно. ",shape=box,color=blue];
		5 -> 8;
	6 [label="Ну да, самый младший в этой новой группе, я бы сказала. Но всё равно, малыш.",shape=box,color=red];
		6 -> 9;
	7 [label="Ага-ага, только не торопись с этой темой про путешествия во времени. Это… сложно.",shape=box,color=red];
		7 -> 10;
	8 [label="Так. Только ты? Есть ещё кто-то? В будущем этому учат в школах?",shape=box,color=blue];
		8 -> 11;
	9 [label="Уф. Самый младший, конечно, но, очевидно, и самый настойчивый в поисках ответов. Постарайся не отставать. Ладно: путешествия во времени. Как и кто?",shape=box,color=blue];
		9 -> 12;
	10 [label="Уф. Как сложно? Формулы? Химические и атомные элементы? Я разберусь, просто направь меня в нужную сторону.",shape=box,color=blue];
		10 -> 13;
		10 -> 14;
	11 [label="Скажем, что только я. Так проще.",shape=box,color=red];
		11 -> 15;
	12 [label="И почему именно ты? У тебя есть план? ",shape=box,color=blue];
		12 -> 16;
	13 [label="Я не знаю, что тебе сказать. Это не только область науки. А если и так, то это наука, которую знает Энтрати.",shape=box,color=red];
		13 -> 17;
	14 [label="Вот тебе направление: Стоп [Конец.]",shape=box,color=red];
		14 -> 1022;
	15 [label="А что насчёт обучения в школах? Если и было, я этого не изучала. Но, может, и было? ",shape=box,color=red];
		15 -> 18;
	16 [label="А если нет, что ты можешь посоветовать, чтобы я смог найти хоть какие-то научные источники по твоим способностям?",shape=box,color=blue];
		16 -> 19;
	17 [label="Уф, этот мерзавец. Я знала, что нужно было задать ему больше вопросов. Ладно. Если это всё-таки наука, значит, я смогу её воспроизвести. А раз ты можешь приходить и уходить, я смогу это выяснить. Пока.",shape=box,color=blue];
		17 -> 20;
	1022 [label="+20 Chemistry",color=orange];
		1022 -> 1018;
	18 [label="А что, хочешь домашку? Путешествия во времени, вероятно, слишком сложны для тебя пока что...",shape=box,color=red];
		18 -> 21;
	19 [label="Столько вопросов, малыш. Не хочу тебя расстраивать, но: я не знаю. Только у Энтрати есть ответы.",shape=box,color=red];
		19 -> 22;
	20 [label="+20 Chemistry",color=orange];
		20 -> 1015;
	1018 [label="{\"Id\":1018,\"Incoming\":[1022],\"Outgoing\":[1023],\"GraphPos\":[3236,718],\"CompletionType\":2,\"OtherDialogueInfos\":[{\"Dialogue\":\"/Lotus/Types/Gameplay/1999Wf/Dialogue/HexDialogue_rom.dialogue\",\"Tag\":\"HexKayaConvo1\",\"Value\":0}]}",color=orange];
		1018 -> 1023;
	21 [label="Уф, серьёзно?",shape=box,color=blue];
		21 -> 24;
	22 [label="Update boolean KayaSetKid",color=orange];
		22 -> 25;
	1015 [label="{\"Id\":1015,\"Incoming\":[20],\"Outgoing\":[23],\"GraphPos\":[3252,817],\"CompletionType\":2,\"OtherDialogueInfos\":[{\"Dialogue\":\"/Lotus/Types/Gameplay/1999Wf/Dialogue/HexDialogue_rom.dialogue\",\"Tag\":\"HexKayaConvo1\",\"Value\":0}]}",color=orange];
		1015 -> 23;
	1023 [label="Chat ends. Next chat will be KayaRank1Convo2.",color=orange];
	24 [label="Кто-нибудь из Гекс разобрался в этом? У них есть какая-то информация? ",shape=box,color=blue];
		24 -> 26;
		24 -> 27;
	25 [label="K.",shape=box,color=blue];
		25 -> 28;
	23 [label="Chat ends. Next chat will be KayaRank1Convo2.",color=orange];
	26 [label="Может, Амир? Он, наверняка, играет в игры с сюжетами про путешествия во времени...",shape=box,color=red];
		26 -> 29;
	27 [label="Не думаю, малыш. Но если хочешь узнать что-то действительно полезное, попроси Лэтти провести тебе экспресс-курс по исцелению.",shape=box,color=red];
		27 -> 30;
	28 [label="+20 Chemistry",color=orange];
		28 -> 996;
	29 [label="Update boolean KayaAmirTravel",color=orange];
		29 -> 32;
	30 [label="Update boolean KayaLettieHeal",color=orange];
		30 -> 33;
	996 [label="{\"Id\":996,\"Incoming\":[28],\"Outgoing\":[31],\"GraphPos\":[4241,541],\"CompletionType\":2,\"OtherDialogueInfos\":[{\"Dialogue\":\"/Lotus/Types/Gameplay/1999Wf/Dialogue/HexDialogue_rom.dialogue\",\"Tag\":\"HexKayaConvo1\",\"Value\":0}]}",color=orange];
		996 -> 31;
	32 [label="Игры? Мне нужны ответы, направление, хоть что-то. Я разберусь. Если вспомнишь что-нибудь полезное, найди меня.",shape=box,color=blue];
		32 -> 34;
	33 [label="Не в моём стиле. Как угодно.",shape=box,color=blue];
		33 -> 35;
	31 [label="Chat ends. Next chat will be KayaRank1Convo2.",color=orange];
	34 [label="+20 Chemistry",color=orange];
		34 -> 998;
	35 [label="+20 Chemistry",color=orange];
		35 -> 997;
	998 [label="{\"Id\":998,\"Incoming\":[34],\"Outgoing\":[36],\"GraphPos\":[5087,255],\"CompletionType\":2,\"OtherDialogueInfos\":[{\"Dialogue\":\"/Lotus/Types/Gameplay/1999Wf/Dialogue/HexDialogue_rom.dialogue\",\"Tag\":\"HexKayaConvo1\",\"Value\":0}]}",color=orange];
		998 -> 36;
	997 [label="{\"Id\":997,\"Incoming\":[35],\"Outgoing\":[37],\"GraphPos\":[4970,380],\"CompletionType\":2,\"OtherDialogueInfos\":[{\"Dialogue\":\"/Lotus/Types/Gameplay/1999Wf/Dialogue/HexDialogue_rom.dialogue\",\"Tag\":\"HexKayaConvo1\",\"Value\":0}]}",color=orange];
		997 -> 37;
	36 [label="Chat ends. Next chat will be KayaRank1Convo2.",color=orange];
	37 [label="Chat ends. Next chat will be KayaRank1Convo2.",color=orange];
}