digraph {
	"KayaRank1Convo1 begins." [color=orange];
		"KayaRank1Convo1 begins." -> j646719031;
	j646719031 [label="Привет. Все могут путешествовать во времени, или только ты?",shape=box,color=blue];
		j646719031 -> j3850930572;
		j646719031 -> j53369347;
	j3850930572 [label="И тебе добрый день. Слушай, малыш, всё не так просто.",shape=box,color=red];
		j3850930572 -> j1833358151;
	j53369347 [label="Эй? Кайя? Как твой день.",shape=box,color=red];
		j53369347 -> j3099152864;
	j1833358151 [label="Я не малыш. Мне 19.",shape=box,color=blue];
		j1833358151 -> j3968626722;
		j1833358151 -> j3528542975;
	j3099152864 [label="Ладно. ",shape=box,color=blue];
		j3099152864 -> j3822085204;
	j3968626722 [label="Ну да, самый младший в этой новой группе, я бы сказала. Но всё равно, малыш.",shape=box,color=red];
		j3968626722 -> j2867338973;
	j3528542975 [label="Ага-ага, только не торопись с этой темой про путешествия во времени. Это… сложно.",shape=box,color=red];
		j3528542975 -> j1609323471;
	j3822085204 [label="Так. Только ты? Есть ещё кто-то? В будущем этому учат в школах?",shape=box,color=blue];
		j3822085204 -> j795728886;
	j2867338973 [label="Уф. Самый младший, конечно, но, очевидно, и самый настойчивый в поисках ответов. Постарайся не отставать. Ладно: путешествия во времени. Как и кто?",shape=box,color=blue];
		j2867338973 -> j2405048795;
	j1609323471 [label="Уф. Как сложно? Формулы? Химические и атомные элементы? Я разберусь, просто направь меня в нужную сторону.",shape=box,color=blue];
		j1609323471 -> j2536708681;
		j1609323471 -> j3739183360;
	j795728886 [label="Скажем, что только я. Так проще.",shape=box,color=red];
		j795728886 -> j46705474;
	j2405048795 [label="И почему именно ты? У тебя есть план? ",shape=box,color=blue];
		j2405048795 -> j4131873329;
	j2536708681 [label="Я не знаю, что тебе сказать. Это не только область науки. А если и так, то это наука, которую знает Энтрати.",shape=box,color=red];
		j2536708681 -> j3667801319;
	j3739183360 [label="Вот тебе направление: Стоп [Конец.]",shape=box,color=red];
	j46705474 [label="А что насчёт обучения в школах? Если и было, я этого не изучала. Но, может, и было? ",shape=box,color=red];
		j46705474 -> j3408091890;
	j4131873329 [label="А если нет, что ты можешь посоветовать, чтобы я смог найти хоть какие-то научные источники по твоим способностям?",shape=box,color=blue];
		j4131873329 -> j286621899;
	j3667801319 [label="Уф, этот мерзавец. Я знала, что нужно было задать ему больше вопросов. Ладно. Если это всё-таки наука, значит, я смогу её воспроизвести. А раз ты можешь приходить и уходить, я смогу это выяснить. Пока.",shape=box,color=blue];
		j3667801319 -> j2547432773;
	j3408091890 [label="А что, хочешь домашку? Путешествия во времени, вероятно, слишком сложны для тебя пока что...",shape=box,color=red];
		j3408091890 -> j3523547754;
	j286621899 [label="Столько вопросов, малыш. Не хочу тебя расстраивать, но: я не знаю. Только у Энтрати есть ответы.",shape=box,color=red];
		j286621899 -> j2507192691;
	j2547432773 [label="+20 Chemistry",color=orange];
		j2547432773 -> "Initiate conversation HexKayaConvo1 in HexDialogue_rom.dialogue";
	j3523547754 [label="Уф, серьёзно?",shape=box,color=blue];
		j3523547754 -> j1725224625;
	j2507192691 [label="Boolean KayaSetKid is now true.",color=orange];
		j2507192691 -> j216897697;
	"Initiate conversation HexKayaConvo1 in HexDialogue_rom.dialogue" [label="Queue conversation HexKayaConvo1 in HexDialogue_rom.dialogue",color=orange];
		"Initiate conversation HexKayaConvo1 in HexDialogue_rom.dialogue" -> "Chat ends. Next chat will be KayaRank1Convo2.";
	j1725224625 [label="Кто-нибудь из Гекс разобрался в этом? У них есть какая-то информация? ",shape=box,color=blue];
		j1725224625 -> j4184749137;
		j1725224625 -> j2675226949;
	j216897697 [label="K.",shape=box,color=blue];
		j216897697 -> j2547432773;
	"Chat ends. Next chat will be KayaRank1Convo2." [color=orange];
	j4184749137 [label="Может, Амир? Он, наверняка, играет в игры с сюжетами про путешествия во времени...",shape=box,color=red];
		j4184749137 -> j1375740836;
	j2675226949 [label="Не думаю, малыш. Но если хочешь узнать что-то действительно полезное, попроси Лэтти провести тебе экспресс-курс по исцелению.",shape=box,color=red];
		j2675226949 -> j3509528200;
	j1375740836 [label="Boolean KayaAmirTravel is now true.",color=orange];
		j1375740836 -> j2362697425;
	j3509528200 [label="Boolean KayaLettieHeal is now true.",color=orange];
		j3509528200 -> j2287499783;
	j2362697425 [label="Игры? Мне нужны ответы, направление, хоть что-то. Я разберусь. Если вспомнишь что-нибудь полезное, найди меня.",shape=box,color=blue];
		j2362697425 -> j2547432773;
	j2287499783 [label="Не в моём стиле. Как угодно.",shape=box,color=blue];
		j2287499783 -> j2547432773;
}