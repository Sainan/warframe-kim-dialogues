digraph {
	graph [fontname="Roboto Condensed"];
	node [fontname="Roboto Condensed"];
	edge [fontname="Roboto Condensed"];

	"KayaRank5Convo1 begins." [color=orange];
		"KayaRank5Convo1 begins." -> j585552340;
	j585552340 [label="Я постоянно нахожу эти фиолетовые штуки, но они исчезают через день.",shape=box,color=blue];
		j585552340 -> j2801551713;
	j2801551713 [label="И мне кажется, тут что-то связано с их распадом.",shape=box,color=blue];
		j2801551713 -> j889262272;
	j889262272 [label="Потому что материя не просто превращается в другой изотоп.",shape=box,color=blue];
		j889262272 -> j66840047;
	j66840047 [label="Она реально исчезает ОТСЮДА.",shape=box,color=blue];
		j66840047 -> j918655132;
		j66840047 -> j1403915050;
	j918655132 [label="Ты про Криотик?",shape=box,color=red];
		j918655132 -> j3717849628;
	j1403915050 [label="Ты про Кристаллы Аргона? ",shape=box,color=red];
		j1403915050 -> j1725212184;
	j3717849628 [label="Ммм, нет, не про них.",shape=box,color=blue];
		j3717849628 -> j1403915050;
		j3717849628 -> j2744815625;
	j1725212184 [label="Точно, это они!",shape=box,color=blue];
		j1725212184 -> j2625401164;
	j2744815625 [label="Ты про элемент питания Орокин?",shape=box,color=red];
		j2744815625 -> j4219654662;
	j2625401164 [label="У тебя получается их сохранять там, откуда ты?",shape=box,color=blue];
		j2625401164 -> j3355852871;
		j2625401164 -> j1781113704;
	j4219654662 [label="Ммм, нет, точно не это.",shape=box,color=blue];
		j4219654662 -> j4280576567;
		j4219654662 -> j1736385088;
	j3355852871 [label="Они всегда исчезают, как только выносишь их из Бездны.",shape=box,color=red];
		j3355852871 -> j333908327;
	j1781113704 [label="Ни разу, я всегда думала, что они просто распадаются. ",shape=box,color=red];
		j1781113704 -> j333908327;
	j4280576567 [label="Ты про Рубедо?",shape=box,color=red];
		j4280576567 -> j1063495164;
	j1736385088 [label="Ты про Кристаллы Аргона?",shape=box,color=red];
		j1736385088 -> j1725212184;
	j333908327 [label="Вот в этом-то и дело — в Бездне они инертны.",shape=box,color=blue];
		j333908327 -> j4103912913;
	j1063495164 [label="Не думаю, если мы не разберёмся, я могу так и не найти решение.",shape=box,color=blue];
		j1063495164 -> j1591275011;
		j1063495164 -> j1736385088;
	j4103912913 [label="Как только они выходят из Бездны, они всегда в неё возвращаются. Они не распадаются в новую материю.",shape=box,color=blue];
		j4103912913 -> j1076514712;
	j1591275011 [label="Ты про Наноспоры?",shape=box,color=red];
		j1591275011 -> j3571597812;
	j1076514712 [label="Они просто возвращаются в Бездну. Бездна пронизывает всё, она их затягивает.",shape=box,color=blue];
		j1076514712 -> j221969447;
	j3571597812 [label="Ой, нет, последний образец пропал. Я… тьфу. Мне надо идти.",shape=box,color=blue];
		j3571597812 -> j2410102169;
	j221969447 [label="Boolean KayaFutureWin2 is now true.",color=orange];
		j221969447 -> j209890478;
		j221969447 -> j1114835600;
	j2410102169 [label="Кажется, это выше моих сил.",shape=box,color=blue];
		j2410102169 -> j4123196853;
	j209890478 [label="Это вытащит тебя из 1999? Планируешь спрятаться в Бездне? Не лучшая идея.",shape=box,color=red];
		j209890478 -> j3212899326;
	j1114835600 [label="Это часть твоего плана?",shape=box,color=red];
		j1114835600 -> j1911900717;
	j4123196853 [label="+20 Chemistry",color=orange];
		j4123196853 -> "Chat ends. Next chat will be KayaRank5Convo2.";
	j3212899326 [label="Дело скорее в состояниях материи и в том, что Бездна не \"линейна\" в привычном смысле, а значит, я могу использовать её как трамплин, чтобы следовать за ТОБОЙ.",shape=box,color=blue];
		j3212899326 -> j3379264892;
	j1911900717 [label="Очень-очень-очень! Это значит, что материя связана между БЕЗДНОЙ и ЭТИМ МЕСТОМ. Атомы, материя — они стабильны в обоих пространствах. ",shape=box,color=blue];
		j1911900717 -> j3824843594;
	"Chat ends. Next chat will be KayaRank5Convo2." [color=orange];
	j3379264892 [label="Погоди, следовать за мной? ",shape=box,color=red];
		j3379264892 -> j718567478;
	j3824843594 [label="Бездна не \"линейна\" в нашем понимании, так что я могу использовать её как трамплин, чтобы буквально следовать за ТОБОЙ.",shape=box,color=blue];
		j3824843594 -> j3379264892;
	j718567478 [label="Да, сколько бы тестов и вычислений я ни проводила, мне не хватает \"маяка\", так сказать. Прыжок с трамплина должен куда-то приземлиться, а если ты уже возвращался хотя бы раз, этого хватит для калибровки. ",shape=box,color=blue];
		j718567478 -> j319372712;
		j718567478 -> j3838332007;
	j319372712 [label="Надеюсь, ты умеешь делать сальто! Один маяк, сейчас будет. ",shape=box,color=red];
		j319372712 -> j4117232765;
	j3838332007 [label="Эм… мне как-то не по себе от этого. А если ты застрянешь или потеряешься?! ",shape=box,color=red];
		j3838332007 -> j860999565;
	j4117232765 [label="Пока ещё рано. Семь раз отмерь, один раз отрежь. Ладно... в этом случае, тысячу раз. ",shape=box,color=blue];
		j4117232765 -> j3629380756;
		j4117232765 -> j1933853404;
	j860999565 [label="Не застряну. ",shape=box,color=blue];
		j860999565 -> j1278569775;
	j3629380756 [label="Справедливо, наука требует уверенности.",shape=box,color=red];
		j3629380756 -> j1266607115;
	j1933853404 [label="Вперёд! Осторожность — для слабых, давай! ",shape=box,color=red];
		j1933853404 -> j1449519641;
	j1278569775 [label="Возможно.",shape=box,color=red];
		j1278569775 -> j812867707;
	j1266607115 [label="Я вижу, ты уже схватываешь.",shape=box,color=blue];
		j1266607115 -> j1218186985;
		j1266607115 -> j1019932987;
	j1449519641 [label="Ааа, нет-нет, я не готова! Нельзя торопить этот процесс!",shape=box,color=blue];
		j1449519641 -> j1079296265;
	j812867707 [label="Нет.",shape=box,color=blue];
		j812867707 -> j3230332479;
		j812867707 -> j1868928686;
	j1218186985 [label="Мечтай! ",shape=box,color=red];
		j1218186985 -> j4123196853;
	j1019932987 [label="О, конечно, супер-учитель. Правда, всё, что я видела, это как ты учишь Минерву новым алко-играм.",shape=box,color=red];
		j1019932987 -> j2550096185;
	j1079296265 [label="Ладно, вижу, ты хотя бы понимаешь, насколько это опасно. Молодец.",shape=box,color=red];
		j1079296265 -> j678205684;
	j3230332479 [label="Эх...",shape=box,color=red];
		j3230332479 -> j3900202072;
	j1868928686 [label="Но… возможно.",shape=box,color=red];
		j1868928686 -> j3900202072;
	j2550096185 [label="Минерва с похмелья опаснее, чем путешествия во времени. БЕГИ!",shape=box,color=blue];
		j2550096185 -> j4123196853;
	j678205684 [label="Минерва с похмелья опаснее. БЕГИ!",shape=box,color=blue];
		j678205684 -> j4123196853;
	j3900202072 [label="Ты бы меня отыскала.",shape=box,color=blue];
		j3900202072 -> j3093090676;
	j3093090676 [label="Не взваливай это на меня...",shape=box,color=red];
		j3093090676 -> j466142250;
	j466142250 [label="Назад пути нет!",shape=box,color=blue];
		j466142250 -> j4123196853;
}