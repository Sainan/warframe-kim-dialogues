digraph {
	"KayaRank2Convo3 begins." [color=orange];
		"KayaRank2Convo3 begins." -> j1417184904;
	j1417184904 [label="Ты можешь объяснить механику «Протеи»? Я нарыла кое-какие детали её чертежей, нужно подтверждение.",shape=box,color=blue];
		j1417184904 -> j2876837402;
		j1417184904 -> j960119438;
		j1417184904 -> j1086645574;
	j2876837402 [label="Нет, не могу. [Конец].",shape=box,color=red];
		j2876837402 -> j2189522063;
	j960119438 [label="Объяснить её механику? Могу попробовать.",shape=box,color=red];
		j960119438 -> j485555609;
		j960119438 -> j1929033232;
	j1086645574 [label="Протея? Она сложная.",shape=box,color=red];
		j1086645574 -> j2615289274;
	j2189522063 [label="+20 Chemistry",color=orange];
