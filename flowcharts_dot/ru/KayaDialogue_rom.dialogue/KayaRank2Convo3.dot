	j485555609 [label="Бросить.",shape=box,color=red];
		j485555609 -> j438530022;
	j1929033232 [label="Думаю, ты хочешь узнать про Временной Якорь?",shape=box,color=red];
		j1929033232 -> j1067448165;
	j2615289274 [label="И не только про её способности, но и про то, откуда она.",shape=box,color=red];
		j2615289274 -> j964542209;
		j2615289274 -> j1929033232;
	"Chat ends. Next chat will be KayaRank3Convo1." [color=orange];
	j438530022 [label="Бросить?",shape=box,color=blue];
		j438530022 -> j1144822900;
		j438530022 -> j3168353363;
	j1067448165 [label="+5 Chemistry",color=orange];
		j1067448165 -> j3806541906;
	j964542209 [label="Кем бы она ни была раньше, сейчас она — тот, кто служил Парвосу Грэнуму.",shape=box,color=red];
		j964542209 -> j3120727901;
	j1144822900 [label="Бросай, и бросай ещё.",shape=box,color=red];
		j1144822900 -> j4052684808;
	j3168353363 [label="Ты спросил.",shape=box,color=red];
		j3168353363 -> j3825906670;
	j3806541906 [label="Ага.",shape=box,color=blue];
		j3806541906 -> j1221491272;
	j3120727901 [label="Да-да, большой злодей с кучей денег и мозгов. Как всегда.",shape=box,color=blue];
		j3120727901 -> j3439345834;
		j3120727901 -> j613022071;
		j3120727901 -> j873827453;
	j4052684808 [label="Угх. Пока? Пока.",shape=box,color=blue];
		j4052684808 -> j2189522063;
	j3825906670 [label="Я спрашивала, ожидая ответов о её временной связи, по крайней мере, судя по тому, что я вижу...",shape=box,color=blue];
		j3825906670 -> j1221491272;
	j1221491272 [label="Да. Потому что путешествия во времени или хотя бы видимость мастерства во временных вещах.",shape=box,color=red];
		j1221491272 -> j2051114642;
	j3439345834 [label="Ты знаешь этот тип?",shape=box,color=red];
		j3439345834 -> j311396799;
	j613022071 [label="Он не такой уж плохой, но ты довольно точно его описала.",shape=box,color=red];
		j613022071 -> j2493177491;
	j873827453 [label="Он за многое в ответе. Слишком многое, чтобы перечислять, но Протея – одна из них.",shape=box,color=red];
		j873827453 -> j1391153180;
	j2051114642 [label="Ага.",shape=box,color=blue];
		j2051114642 -> j1349946907;
		j2051114642 -> j4277771081;
	j311396799 [label="Ага.",shape=box,color=blue];
		j311396799 -> j753301080;
	j2493177491 [label="Как угодно",shape=box,color=blue];
		j2493177491 -> j1391153180;
	j1391153180 [label="Значит, с НИМ мне и надо говорить?",shape=box,color=blue];
		j1391153180 -> j1393068544;
		j1391153180 -> j1341639406;
	j1349946907 [label="Потому что, по какой-то причине, вся Нова сводится к тому, чтобы спрашивать единственного знакомого путешественника во времени о путешествиях во времени.",shape=box,color=red];
		j1349946907 -> j868737326;
	j4277771081 [label="Потому что ты действительно не сдашься? Не то чтобы я хотела, чтобы ты сдался, но я реально не знаю, как тебе помочь.",shape=box,color=red];
		j4277771081 -> j1532188554;
	j753301080 [label="Декан моего универа был таким же. Если я КОГДА-НИБУДЬ снова его встречу..",shape=box,color=blue];
		j753301080 -> j901813919;
	j1393068544 [label="Если хочешь стать подопытным образцом на всю оставшуюся жизнь – конечно.",shape=box,color=red];
		j1393068544 -> j2160975279;
	j1341639406 [label="Я не думаю, что свести вас – хорошая идея, даже если бы это было возможно.",shape=box,color=red];
		j1341639406 -> j2242742443;
	j868737326 [label="+5 Chemistry",color=orange];
		j868737326 -> j642941857;
	j1532188554 [label="Протея, детали. Типа, есть ли её версия меня? Ну знаешь, такой недоделанный фрик?",shape=box,color=blue];
		j1532188554 -> j1497159829;
		j1532188554 -> j2080727316;
	j901813919 [label="Я думала, он примет мою сторону, но... ",shape=box,color=blue];
		j901813919 -> j2115922928;
		j901813919 -> j1409039013;
	j2160975279 [label="И продаст первому, кто предложит больше.",shape=box,color=red];
		j2160975279 -> j974749793;
	j2242742443 [label="Давай попробуем придерживаться того, что тебе реально может помочь.",shape=box,color=red];
		j2242742443 -> j3963527289;
	j642941857 [label="Ага.",shape=box,color=blue];
		j642941857 -> j131526897;
	j1497159829 [label="Недоделанный фрик, который решит проблему путешествий во времени. Давай уж по-честному, ты заслуживаешь похвалы.",shape=box,color=red];
		j1497159829 -> j1029367930;
	j2080727316 [label="Протея – Варфрейм, которого мы знаем.",shape=box,color=red];
		j2080727316 -> j3689098962;
	j2115922928 [label="Что с тобой случилось в универе?",shape=box,color=red];
		j2115922928 -> j254525944;
	j1409039013 [label="Чью сторону принять?",shape=box,color=red];
		j1409039013 -> j254525944;
	j974749793 [label="Он умный человек, но не хороший. Не думаю, что он был бы союзником.",shape=box,color=red];
		j974749793 -> j1755918950;
	j3963527289 [label="Временные... вещи.",shape=box,color=red];
		j3963527289 -> j1349946907;
	j131526897 [label="Я ТАК рада, что ты понимаешь.",shape=box,color=blue];
		j131526897 -> j806235371;
		j131526897 -> j2300003066;
	j1029367930 [label="+5 Chemistry",color=orange];
		j1029367930 -> j968851980;
	j3689098962 [label="Жаль её.",shape=box,color=blue];
		j3689098962 -> j3281314042;
	j254525944 [label="Угх, давай просто оставим это как «Нова против Интернета».",shape=box,color=blue];
		j254525944 -> j1463883453;
	j1755918950 [label="Думаю.",shape=box,color=blue];
		j1755918950 -> j3391526586;
	j806235371 [label="А если у меня будут вопросы про 1999?",shape=box,color=red];
		j806235371 -> j4146716895;
	j2300003066 [label="Мне вообще когда-нибудь будет позволено задавать тебе вопросы?",shape=box,color=red];
		j2300003066 -> j4146716895;
	j968851980 [label="Правда твоя.",shape=box,color=blue];
		j968851980 -> j3281314042;
	j3281314042 [label="Но",shape=box,color=blue];
		j3281314042 -> j4146716895;
	j1463883453 [label="Тупая тупая Нова.",shape=box,color=blue];
		j1463883453 -> j1230858641;
	j3391526586 [label="Хм. Ну, допустим, у Протеи самое продвинутое понимание временного осознания среди всех этих созданий",shape=box,color=blue];
		j3391526586 -> j2590294974;
	j4146716895 [label="Ладно, вот как всё будет работать, и без вариантов.",shape=box,color=blue];
		j4146716895 -> j717204527;
	j1230858641 [label="Оценки ничего не значат, если преподы просто не пускают тебя на занятия.",shape=box,color=blue];
		j1230858641 -> j1151590054;
		j1230858641 -> j772171190;
	j2590294974 [label="Это понимание базируется на теории, науке, врождённой способности или... хм. ",shape=box,color=blue];
		j2590294974 -> j464801207;
	j717204527 [label="Я собираюсь путешествовать во времени, как и ты. ",shape=box,color=blue];
		j717204527 -> j558044025;
	j1151590054 [label="Сейчас всё уже по-другому.",shape=box,color=red];
		j1151590054 -> j3330680084;
	j772171190 [label="Если ты когда-нибудь захочешь поговорить об этом...",shape=box,color=red];
		j772171190 -> j3330680084;
	j464801207 [label="Ну хм. На самом деле. Да, давай предположим, что Бездна тут как-то замешана.",shape=box,color=blue];
		j464801207 -> j3715529675;
		j464801207 -> j4278609502;
	j558044025 [label="Я отправлюсь туда, откуда ТЫ пришла.",shape=box,color=blue];
		j558044025 -> j3047866299;
	j3330680084 [label="Я знааааю, я знаааю...",shape=box,color=blue];
		j3330680084 -> j1649459311;
	j3715529675 [label="Бездну нельзя просто «решить».",shape=box,color=red];
		j3715529675 -> j2740768363;
	j4278609502 [label="Бездна связана... со всем.",shape=box,color=red];
		j4278609502 -> j149588467;
	j3047866299 [label="А потом я узнаю – если ты меня кинешь или если тебе реально можно доверять, я узнаю, что ждёт меня впереди.",shape=box,color=blue];
		j3047866299 -> j1459386405;
	j1649459311 [label="Знаешь что? Как только я разберусь с этой штукой под названием «путешествия во времени», расскажу тебе больше. Мне нечего будет терять.",shape=box,color=blue];
		j1649459311 -> j2189522063;
	j2740768363 [label="Но возможно, это как раз то, что я смогу ИСПОЛЬЗОВАТЬ! Ха! Время кое-что проверить. ",shape=box,color=blue];
		j2740768363 -> j45216850;
	j149588467 [label="И возможно, это станет началом ещё одного теста. УВИДИМСЯ! ",shape=box,color=blue];
		j149588467 -> j45216850;
	j1459386405 [label="Ну, обратно к книжкам! Что-то про Протею… хм.",shape=box,color=blue];
		j1459386405 -> j2189522063;
	j45216850 [label="Эй, осторожнее!",shape=box,color=red];
		j45216850 -> j4088838641;
	j4088838641 [label="Boolean KayaVoidTest is now true.",color=orange];
		j4088838641 -> j2189522063;
