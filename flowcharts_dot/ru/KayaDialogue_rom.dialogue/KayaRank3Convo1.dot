	439 [label="И для кого-то из великого и вдохновляющего будущего ты как-то не уловила суть. Карты Jinymon! Я! Ты можешь в это поверить? ",shape=box,color=blue];
		439 -> 442;
		439 -> 443;
	440 [label="Думаю, по-своему, я говорю, что, наверное, могу довериться тебе и сказать, что коллекционирую карты Jinymon. Они вроде как для лузеров.",shape=box,color=blue];
