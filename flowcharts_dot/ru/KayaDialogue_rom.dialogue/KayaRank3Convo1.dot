	"KayaRank3Convo1 begins." [color=orange];
		"KayaRank3Convo1 begins." -> j997412203;
	j997412203 [label="Я только что поняла, кого ты мне напоминаешь. ",shape=box,color=blue];
		j997412203 -> j1027183180;
	j1027183180 [label="Студент, с которым меня свели в первый год универа.",shape=box,color=blue];
		j1027183180 -> j2561229719;
	j2561229719 [label="Check boolean KayaCake",color=orange];
		j2561229719 -> j986426118 [label=true,color=green];
		j2561229719 -> j3287061758 [label=false,color=brown];
		j2561229719 -> j2045017086 [label=false,color=brown];
	j986426118 [label="Ой-ой. В хорошем смысле?",shape=box,color=red];
		j986426118 -> j663845566;
	j3287061758 [label="Невероятно привлекательного и гениального студента?",shape=box,color=red];
		j3287061758 -> j2177290654;
	j2045017086 [label="Готовлюсь к тому, что это вызовет драку...",shape=box,color=red];
		j2045017086 -> j674262735;
	j663845566 [label="Вообще-то да. ",shape=box,color=blue];
		j663845566 -> j2040112718;
	j2177290654 [label="Фу. Придётся тебя разочаровать, но я не флиртую. Никогда.",shape=box,color=blue];
		j2177290654 -> j626445832;
	j674262735 [label="О, нет-нет-нет, пожалуйста. Это счастливое воспоминание.",shape=box,color=blue];
		j674262735 -> j2484255211;
		j674262735 -> j2631320069;
	j2040112718 [label="Я испёкла торт, чтобы доказать, что ты не права.",shape=box,color=blue];
		j2040112718 -> j3044217962;
	j626445832 [label="ОСОБЕННО в интернете.",shape=box,color=blue];
		j626445832 -> j3661477223;
		j626445832 -> j286623792;
	j2484255211 [label="Как скажешь.",shape=box,color=red];
		j2484255211 -> j69629211;
	j2631320069 [label="У тебя, похоже, не так уж и много таких.",shape=box,color=red];
		j2631320069 -> j475403821;
	j3044217962 [label="И это заставило меня вспомнить, что единственный раз, когда кто-то пёк для меня торт, это был один застенчивый одногруппник.",shape=box,color=blue];
		j3044217962 -> j3024057145;
	j3661477223 [label="А что, если бы я захотела?",shape=box,color=red];
		j3661477223 -> j3746632718;
	j286623792 [label="Ой-ой, мой косяк. Мой косяк. ",shape=box,color=red];
		j286623792 -> j1912110825;
	j69629211 [label="Вообще, это про мой день рождения, но дело не во мне. ",shape=box,color=blue];
		j69629211 -> j2364783068;
	j475403821 [label="Ладно, поделюсь одной историей! ",shape=box,color=blue];
		j475403821 -> j69629211;
	j3024057145 [label="Которые каким-то образом узнали, что у меня день рождения, хотя меня с ними никогда не видели.",shape=box,color=blue];
		j3024057145 -> j3335723605;
	j3746632718 [label="Но точно не со мной.",shape=box,color=blue];
		j3746632718 -> j2013445877;
	j1912110825 [label="Не пытайся снова.",shape=box,color=blue];
		j1912110825 -> j1934099406;
	j2364783068 [label="Ну, типа, наверное, немного. Надо сказать, что я определённо была тем человеком, с кем все хотели тусить.",shape=box,color=blue];
		j2364783068 -> j2530421319;
	j3335723605 [label="И он принёс мне ванильный торт с ванильной глазурью, и этот торт был, клянусь, трёхслойным.",shape=box,color=blue];
		j3335723605 -> j4005630204;
	j2013445877 [label="+5 Chemistry",color=orange];
		j2013445877 -> "Chat ends. Next chat will be KayaRank3Convo2.";
	j1934099406 [label="Обещаю, что не буду.",shape=box,color=red];
		j1934099406 -> j3734968236;
	j2530421319 [label="Хорошие оценки. Даже больше чем хорошие. И капитан команды поддержки. Получить приглашение на мой день рождения было прям событием.",shape=box,color=blue];
		j2530421319 -> j2545556757;
	j4005630204 [label="Так вот, я увидела, как он с этим тортом ходит, и так боялась, что класс увидит, как мне его дарят. Мы же в РАЗНЫХ компаниях тусили.",shape=box,color=blue];
		j4005630204 -> j3325986549;
	"Chat ends. Next chat will be KayaRank3Convo2." [color=orange];
	j3734968236 [label="Boolean KayaFlirtPromise is now true.",color=orange];
		j3734968236 -> j2752047005;
	j2545556757 [label="Короче, этот студент испёк мне торт на день рождения, но сказал не делиться ни с кем и подождать, пока я не приду домой, чтобы его съесть. ",shape=box,color=blue];
		j2545556757 -> j3682639219;
	j3325986549 [label="У меня были хорошие оценки. Даже больше чем хорошие. И я была капитаном команды поддержки. Попасть на мой день рождения — это было что-то.",shape=box,color=blue];
		j3325986549 -> j2545556757;
	j2752047005 [label="Ладно.",shape=box,color=blue];
		j2752047005 -> j2545556757;
	j3682639219 [label="И, честно говоря, меня это немного напрягло, как и ты поначалу. Но потом я разрезала торт, и мой кухонный нож наткнулся за что-то твёрдое.",shape=box,color=blue];
		j3682639219 -> j156511259;
	j156511259 [label="Отстой, да? Просто мега-отстой. Но потом я посмотрела, и оказалось, что это пластиковый контейнер, который он спрятал под тортом, а в нём запечатанные наборы карт Jinymon. Мои самые любимые вещи.",shape=box,color=blue];
		j156511259 -> j4105681586;
	j4105681586 [label="Но я бы никогда в жизни не показалась с ним в школе. Очевидно, этот застенчивый одногруппник понял, какая я на самом деле, и передал мне настоящий подарок, сделав вид, что просто хочет привлечь внимание большим тортом или что-то такое, фиг знает.",shape=box,color=blue];
		j4105681586 -> j1231459965;
		j4105681586 -> j2988934985;
		j4105681586 -> j2236775863;
	j1231459965 [label="Я не собираюсь печь тебе торт.",shape=box,color=red];
		j1231459965 -> j3035251458;
	j2988934985 [label="Для того, кто типа вундеркинд, ты реально долго доходишь до сути...",shape=box,color=red];
		j2988934985 -> j4085768851;
	j2236775863 [label="И чем это, по-твоему, похоже на меня?",shape=box,color=red];
		j2236775863 -> j3806113006;
	j3035251458 [label="+20 Chemistry",color=orange];
		j3035251458 -> j165381043;
	j4085768851 [label="И для кого-то из великого и вдохновляющего будущего ты как-то не уловила суть. Карты Jinymon! Я! Ты можешь в это поверить? ",shape=box,color=blue];
		j4085768851 -> j3259853664;
		j4085768851 -> j2629956284;
	j3806113006 [label="Думаю, по-своему, я говорю, что, наверное, могу довериться тебе и сказать, что коллекционирую карты Jinymon. Они вроде как для лузеров.",shape=box,color=blue];
		j3806113006 -> j951733597;
	j165381043 [label="Хааахаха!",shape=box,color=blue];
		j165381043 -> j3342516121;
	j3259853664 [label="Вообще, я без понятия, что это!",shape=box,color=red];
		j3259853664 -> j3450354368;
	j2629956284 [label="Они типа редкие коллекционные штуки?",shape=box,color=red];
		j2629956284 -> j3450354368;
	j951733597 [label="Ну, по крайней мере, я так думала. Но настоящие лузеры были все остальные. ",shape=box,color=blue];
		j951733597 -> j2356051282;
		j951733597 -> j1737986492;
		j951733597 -> j1421202366;
	j3342516121 [label="Наверное, это всё равно было бы отстойно.",shape=box,color=blue];
		j3342516121 -> j421225982;
		j3342516121 -> j864892860;
	j3450354368 [label="Это типа детская карточная игра с монстрами и ну... как бы для лузеров, особенно в универе.",shape=box,color=blue];
		j3450354368 -> j951733597;
	j2356051282 [label="Может, когда-нибудь покажешь мне свои карты Jinymon?",shape=box,color=red];
		j2356051282 -> j1479974389;
	j1737986492 [label="Вау, мы закончили целый разговор, не говоря ТОЛЬКО о путешествиях во времени! ",shape=box,color=red];
		j1737986492 -> j2695172804;
	j1421202366 [label="Ты что, раскрываешься передо мной? Освежает!",shape=box,color=red];
		j1421202366 -> j347996673;
	j421225982 [label="Ты, наверное, права.",shape=box,color=red];
		j421225982 -> j528387574;
	j864892860 [label="Я могла бы это выяснить.",shape=box,color=red];
		j864892860 -> j528387574;
	j1479974389 [label="Может быть.",shape=box,color=blue];
		j1479974389 -> j1895387827;
	j2695172804 [label="Та-да!",shape=box,color=blue];
		j2695172804 -> j1895387827;
	j347996673 [label="Не привыкай. Может быть. Угх, фиг знает. ",shape=box,color=blue];
		j347996673 -> j1895387827;
	j528387574 [label="Дааа, дааа! ",shape=box,color=blue];
		j528387574 -> j3411901064;
	j1895387827 [label="+20 Chemistry",color=orange];
		j1895387827 -> "Chat ends. Next chat will be KayaRank3Convo2.";
	j3411901064 [label="Думаю, по-своему, я говорю, что, наверное, могу довериться тебе и сказать, что коллекционирую карты Jinymon. Они вроде как для лузеров.",shape=box,color=blue];
		j3411901064 -> j3910286274;
	j3910286274 [label="Ну, по крайней мере, я так думала. Но настоящие лузеры были все остальные. ",shape=box,color=blue];
		j3910286274 -> j1421202366;
		j3910286274 -> j1737986492;
