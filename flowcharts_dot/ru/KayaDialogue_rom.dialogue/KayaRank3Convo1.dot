		426 -> 430;
	432 [label="У меня были хорошие оценки. Даже больше чем хорошие. И я была капитаном команды поддержки. Попасть на мой день рождения — это было что-то.",shape=box,color=blue];
		432 -> 426;
	431 [label="Ладно.",shape=box,color=blue];
		431 -> 426;
	430 [label="И, честно говоря, меня это немного напрягло, как и ты поначалу. Но потом я разрезала торт, и мой кухонный нож наткнулся за что-то твёрдое.",shape=box,color=blue];
		430 -> 433;
	433 [label="Отстой, да? Просто мега-отстой. Но потом я посмотрела, и оказалось, что это пластиковый контейнер, который он спрятал под тортом, а в нём запечатанные наборы карт Jinymon. Мои самые любимые вещи.",shape=box,color=blue];
		433 -> 434;
	434 [label="Но я бы никогда в жизни не показалась с ним в школе. Очевидно, этот застенчивый одногруппник понял, какая я на самом деле, и передал мне настоящий подарок, сделав вид, что просто хочет привлечь внимание большим тортом или что-то такое, фиг знает.",shape=box,color=blue];
		434 -> 435;
