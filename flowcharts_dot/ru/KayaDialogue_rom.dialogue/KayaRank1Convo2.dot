	56 [label="Тебе легче, когда ты называешь меня ребёнком? Ты вообще понимаешь?",shape=box,color=blue];
		56 -> 62;
	57 [label="Ты ничего обо мне не знаешь.",shape=box,color=blue];
		57 -> 63;
