		76 -> 78;
	77 [label="Chat ends. Next chat will be KayaRank1Convo3.",color=orange];
	78 [label="Я знала, что он из будущего. Он знал, что я знаю. Он дал мне выбор, и, ну, не важно. Теперь я нашла тебя. ",shape=box,color=blue];
		78 -> 79;
