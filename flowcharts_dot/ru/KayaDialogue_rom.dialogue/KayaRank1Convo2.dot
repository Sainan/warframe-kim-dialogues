digraph {
	38 [label="KayaRank1Convo2 begins.",color=orange];
		38 -> 39;
	39 [label="Привет. Почему настройка Энтрати для межвременного перехода, похоже, включает активное подключение к сети Кинемантик?",shape=box,color=blue];
		39 -> 40;
	40 [label="Или, наверное, привет. Для путешествий во времени нужен интернет?",shape=box,color=blue];
		40 -> 41;
		40 -> 42;
	41 [label="Сразу к делу, да. Ладно. Нет, «интернет» в моё время толком не добрался, так что он не обязателен. Хотя, может, и нужен. ",shape=box,color=red];
		41 -> 43;
	42 [label="И тебе привет, Кайя. ",shape=box,color=red];
		42 -> 44;
	43 [label="То есть тебе не нужно подключение к интернету, чтобы свободно перемещаться? А Энтрати была нужна?",shape=box,color=blue];
		43 -> 45;
	44 [label="Уф. Интернет? Я могу понять, как, учитывая свойства сети..",shape=box,color=blue];
		44 -> 45;
	45 [label="Я правда не знаю ничего наверняка. Я знаю только, что была определённая последовательность, у Энтрати был план, и он включал меня, здесь, сейчас. Мне нужно было попасть сюда, чтобы встретить всех вас.",shape=box,color=red];
		45 -> 46;
	46 [label="Хорошо, но почему в некоторых его записях указано, что подключение к интернету — это обязательное условие?",shape=box,color=blue];
		46 -> 47;
		46 -> 48;
		46 -> 49;
	47 [label="Я спрошу его в следующий раз, когда увижу.",shape=box,color=red];
		47 -> 50;
	48 [label="У тебя есть его записи?",shape=box,color=red];
		48 -> 51;
	49 [label="Это проблема? Разве такому ребёнку, как ты, не понравился бы интернет? ",shape=box,color=red];
		49 -> 52;
	50 [label="?",shape=box,color=blue];
		50 -> 53;
		50 -> 54;
	51 [label="Не буквально. Просто то, что я увидела, когда нашла его. Не думаю, что он ожидал, что его найдут.",shape=box,color=blue];
		51 -> 55;
	52 [label="Check boolean KayaSetKid",color=orange];
		52 -> 56 [label=true,color=green];
		52 -> 57 [label=false,color=brown];
	53 [label="Прости, это была шутка… В будущем они тоже есть.",shape=box,color=red];
