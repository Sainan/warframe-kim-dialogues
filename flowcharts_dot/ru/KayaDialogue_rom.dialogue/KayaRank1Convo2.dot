digraph {
	"KayaRank1Convo2 begins." [color=orange];
		"KayaRank1Convo2 begins." -> j877807371;
	j877807371 [label="Привет. Почему настройка Энтрати для межвременного перехода, похоже, включает активное подключение к сети Кинемантик?",shape=box,color=blue];
		j877807371 -> j1490882634;
	j1490882634 [label="Или, наверное, привет. Для путешествий во времени нужен интернет?",shape=box,color=blue];
		j1490882634 -> j1466160845;
		j1490882634 -> j3623421577;
	j1466160845 [label="Сразу к делу, да. Ладно. Нет, «интернет» в моё время толком не добрался, так что он не обязателен. Хотя, может, и нужен. ",shape=box,color=red];
		j1466160845 -> j3944518220;
	j3623421577 [label="И тебе привет, Кайя. ",shape=box,color=red];
		j3623421577 -> j289271275;
	j3944518220 [label="То есть тебе не нужно подключение к интернету, чтобы свободно перемещаться? А Энтрати была нужна?",shape=box,color=blue];
		j3944518220 -> j2230028902;
	j289271275 [label="Уф. Интернет? Я могу понять, как, учитывая свойства сети..",shape=box,color=blue];
		j289271275 -> j2230028902;
	j2230028902 [label="Я правда не знаю ничего наверняка. Я знаю только, что была определённая последовательность, у Энтрати был план, и он включал меня, здесь, сейчас. Мне нужно было попасть сюда, чтобы встретить всех вас.",shape=box,color=red];
		j2230028902 -> j2560740048;
	j2560740048 [label="Хорошо, но почему в некоторых его записях указано, что подключение к интернету — это обязательное условие?",shape=box,color=blue];
		j2560740048 -> j1127069338;
		j2560740048 -> j1114157888;
		j2560740048 -> j2493684462;
	j1127069338 [label="Я спрошу его в следующий раз, когда увижу.",shape=box,color=red];
		j1127069338 -> j3135231552;
	j1114157888 [label="У тебя есть его записи?",shape=box,color=red];
		j1114157888 -> j3388129431;
	j2493684462 [label="Это проблема? Разве такому ребёнку, как ты, не понравился бы интернет? ",shape=box,color=red];
		j2493684462 -> j2322558332;
	j3135231552 [label="?",shape=box,color=blue];
		j3135231552 -> j1131684825;
		j3135231552 -> j1037886637;
	j3388129431 [label="Не буквально. Просто то, что я увидела, когда нашла его. Не думаю, что он ожидал, что его найдут.",shape=box,color=blue];
		j3388129431 -> j448789439;
	j2322558332 [label="Check boolean KayaSetKid",color=orange];
		j2322558332 -> j3228664125 [label=true,color=green];
		j2322558332 -> j1835398231 [label=false,color=brown];
	j1131684825 [label="Прости, это была шутка… В будущем они тоже есть.",shape=box,color=red];
		j1131684825 -> j774562010;
	j1037886637 [label="Шутка. Расслабься.",shape=box,color=red];
		j1037886637 -> j2413307469;
	j448789439 [label="Boolean KayaSetFound is now true.",color=orange];
		j448789439 -> j4014779658;
		j448789439 -> j2094301310;
	j3228664125 [label="Тебе легче, когда ты называешь меня ребёнком? Ты вообще понимаешь?",shape=box,color=blue];
		j3228664125 -> j306044613;
	j1835398231 [label="Ты ничего обо мне не знаешь.",shape=box,color=blue];
		j1835398231 -> j1557784581;
	j774562010 [label="Ладно.",shape=box,color=blue];
		j774562010 -> j1789638116;
	j2413307469 [label="Нет.",shape=box,color=blue];
		j2413307469 -> j1557784581;
	j4014779658 [label="ТЫ? Ты нашла Энтрати, когда никто другой не смог?",shape=box,color=red];
		j4014779658 -> j130232558;
	j2094301310 [label="Ты нашла его? Как?",shape=box,color=red];
		j2094301310 -> j130232558;
	j306044613 [label="Мне пришлось быстро повзрослеть. Люди в этом чёртовом интернете постарались, чтобы я это сделала.",shape=box,color=blue];
		j306044613 -> j1557784581;
	j1557784581 [label="+20 Chemistry",color=orange];
		j1557784581 -> "Chat ends. Next chat will be KayaRank1Convo3.";
	j1789638116 [label="+20 Chemistry",color=orange];
		j1789638116 -> j995034931;
	j130232558 [label="Я хотела получить ответы.",shape=box,color=blue];
		j130232558 -> j648421277;
	"Chat ends. Next chat will be KayaRank1Convo3." [color=orange];
	j995034931 [label="И ты точно уверена, что в твоём будущем нет интернета? Совсем уверена?",shape=box,color=blue];
		j995034931 -> j885789388;
	j648421277 [label="+20 Chemistry",color=orange];
		j648421277 -> j3801750367;
	j885789388 [label="На самом деле, забудь, что я что-то сказала. Я узнаю сама, когда доберусь туда.",shape=box,color=blue];
		j885789388 -> j1557784581;
	j3801750367 [label="Всё в этом дерьмовом мире менялось слишком быстро. Особенно в тёмных уголках интернета, где обсуждали этого Доктора.",shape=box,color=blue];
		j3801750367 -> j2110999220;
	j2110999220 [label="Я нашла его, застала врасплох. И, о боже. Дедуля Доктор был совсем не рад, но я сразу перешла к делу.",shape=box,color=blue];
		j2110999220 -> j2996148112;
	j2996148112 [label="Я знала, что он из будущего. Он знал, что я знаю. Он дал мне выбор, и, ну, не важно. Теперь я нашла тебя. ",shape=box,color=blue];
		j2996148112 -> j170368527;
	j170368527 [label="И, в каком-то смысле, я тоже даю тебе выбор. Помоги мне или пожалеешь.",shape=box,color=blue];
		j170368527 -> j1159052193;
		j170368527 -> j4092903877;
	j1159052193 [label="Очаровательно. Знаешь, я тебе не враг.",shape=box,color=red];
		j1159052193 -> j1779798265;
	j4092903877 [label="Ты всем своим новым друзьям угрожаешь?",shape=box,color=red];
		j4092903877 -> j2117550083;
	j1779798265 [label="Пока нет. Люди меняются. Посмотрим.",shape=box,color=blue];
		j1779798265 -> j1557784581;
	j2117550083 [label="Просто защищаюсь. ",shape=box,color=blue];
		j2117550083 -> j1557784581;
}