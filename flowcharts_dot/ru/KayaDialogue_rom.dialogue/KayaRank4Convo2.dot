	581 [label="Может, расскажу. У нас ведь куча времени.",shape=box,color=red];
		581 -> 587;
	582 [label="Это обещание. Ты не одна в этом мире. Мы все просто рискуем, полагаясь друг на друга.",shape=box,color=red];
		582 -> 588;
	583 [label="Это не ложь. Просто поверь. [Конец.]",shape=box,color=red];
