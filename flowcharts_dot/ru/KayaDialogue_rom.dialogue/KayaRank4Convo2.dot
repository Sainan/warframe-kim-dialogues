	j3523146951 [label="...",shape=box,color=blue];
		j3523146951 -> j2574982641;
	j2574982641 [label="Никто из нас никогда бы тебя не осудил.",shape=box,color=red];
		j2574982641 -> j994083961;
	j994083961 [label="То, что с тобой случилось, это полное нарушение личных границ.",shape=box,color=red];
		j994083961 -> j3359275084;
	j3359275084 [label="Кто-то предал твоё доверие и попытался унизить тебя.",shape=box,color=red];
		j3359275084 -> j131287274;
	j131287274 [label="Ты была уязвима, и тебя предали.",shape=box,color=red];
		j131287274 -> j1557800323;
	j1557800323 [label="Твой мир ушёл из-под ног. ",shape=box,color=red];
		j1557800323 -> j3351781716;
	j3351781716 [label="Люди смотрели на тебя иначе.",shape=box,color=red];
		j3351781716 -> j1108507721;
	j1108507721 [label="Теперь понимаешь, почему мне нужно уйти?",shape=box,color=blue];
		j1108507721 -> j2880037234;
	j2880037234 [label="Будто такого раньше НИ С КЕМ не случалось.",shape=box,color=blue];
		j2880037234 -> j3876517328;
	j3876517328 [label="Это попало в заголовки. Люди издевались надо мной за то, что я притворяюсь жертвой, хотя это был мой выбор — отправить то фото.",shape=box,color=blue];
		j3876517328 -> j1160918520;
	j1160918520 [label="Ты даже не можешь вбить моё имя в студенческую базу данных, чтобы никто не подумал о том самом \"ЛРУ\" — \"Любимчик Распутного Учителя\".",shape=box,color=blue];
		j1160918520 -> j1966564301;
	j1966564301 [label="И вы, ребята, тоже найдёте это фото, и никто из вас больше не посмотрит на меня по-прежнему. Всё уважение... исчезнет. Навсегда",shape=box,color=blue];
		j1966564301 -> j2679972885;
	j2679972885 [label="Я должна уйти, должна двигаться вперёд, к тому времени и месту, где я была достаточно умной, чтобы всё это оставить позади.",shape=box,color=blue];
		j2679972885 -> j256474391;
		j2679972885 -> j3367707987;
		j2679972885 -> j1198471236;
	j256474391 [label="Больше мне нечего сказать. Мы все совершали то, о чём жалеем. ",shape=box,color=red];
		j256474391 -> j2753153214;
	j3367707987 [label="Если уж на то пошло... теперь я уважаю тебя ещё больше.",shape=box,color=red];
		j3367707987 -> j2945253428;
	j1198471236 [label="Никогда не будет момента, когда кто-то из нас осудит тебя за это.",shape=box,color=red];
		j1198471236 -> j3051414897;
	j2753153214 [label="Может, однажды ты расскажешь мне о своём самом большом сожалении...",shape=box,color=blue];
		j2753153214 -> j3474714002;
		j2753153214 -> j1875868588;
	j2945253428 [label="Не лги мне, Ч*** возьми.",shape=box,color=blue];
		j2945253428 -> j326641413;
		j2945253428 -> j641675845;
	j3051414897 [label="Check boolean KayaEternalismTest",color=orange];
		j3051414897 -> j2035536382 [label=true,color=green];
		j3051414897 -> j2072611246 [label=false,color=brown];
	j3474714002 [label="Может, расскажу. У нас ведь куча времени.",shape=box,color=red];
		j3474714002 -> j636956295;
	j1875868588 [label="Это обещание. Ты не одна в этом мире. Мы все просто рискуем, полагаясь друг на друга.",shape=box,color=red];
		j1875868588 -> j3706483799;
	j326641413 [label="Это не ложь. Просто поверь. [Конец.]",shape=box,color=red];
		j326641413 -> j636956295;
	j641675845 [label="Слушай сюда.",shape=box,color=red];
		j641675845 -> j3051414897;
	j2035536382 [label="Ты явно разобралась в Этернализме, может, даже лучше, чем я.",shape=box,color=red];
		j2035536382 -> j3798189098;
	j2072611246 [label="Check boolean KayaAttitude",color=orange];
		j2072611246 -> j315686160 [label=true,color=green];
		j2072611246 -> j3828491864 [label=false,color=brown];
	j636956295 [label="+20 Chemistry",color=orange];
		j636956295 -> "Chat ends. Next chat will be KayaRank4Convo3.";
	j3706483799 [label="Boolean KayaPromiseRegret is now true.",color=orange];
		j3706483799 -> j636956295;
	j3798189098 [label="Что, само по себе, уже о многом говорит.",shape=box,color=red];
		j3798189098 -> j2072611246;
	j315686160 [label="Всё это отношение, которое ты мне показывала? Ну, хотя бы логично. Ты боялась и злилась. Я ведь была просто очередным незнакомцем из интернета.",shape=box,color=red];
		j315686160 -> j3828491864;
	j3828491864 [label="Я никогда не стану отговаривать тебя от ухода из 1999-го. ",shape=box,color=red];
		j3828491864 -> j242228037;
	"Chat ends. Next chat will be KayaRank4Convo3." [color=orange];
	j242228037 [label="Я уверена, что выход есть. И если для тебя важнее всего выбраться – куда угодно, куда угодно – это имеет смысл.",shape=box,color=red];
		j242228037 -> j3371966512;
	j3371966512 [label="Помощь всегда рядом. Я, может, и не лучший путешественник во времени, но слушать умею. Так что не стесняйся.",shape=box,color=red];
		j3371966512 -> j636956295;
