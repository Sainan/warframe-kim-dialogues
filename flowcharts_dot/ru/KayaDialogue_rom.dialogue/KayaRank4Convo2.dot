		570 -> 571;
	571 [label="Это попало в заголовки. Люди издевались надо мной за то, что я притворяюсь жертвой, хотя это был мой выбор — отправить то фото.",shape=box,color=blue];
		571 -> 572;
	572 [label="Ты даже не можешь вбить моё имя в студенческую базу данных, чтобы никто не подумал о том самом \"ЛРУ\" — \"Любимчик Распутного Учителя\".",shape=box,color=blue];
		572 -> 573;
	573 [label="И вы, ребята, тоже найдёте это фото, и никто из вас больше не посмотрит на меня по-прежнему. Всё уважение... исчезнет. Навсегда",shape=box,color=blue];
		573 -> 574;
	574 [label="Я должна уйти, должна двигаться вперёд, к тому времени и месту, где я была достаточно умной, чтобы всё это оставить позади.",shape=box,color=blue];
		574 -> 575;
		574 -> 576;
		574 -> 577;
	575 [label="Больше мне нечего сказать. Мы все совершали то, о чём жалеем. ",shape=box,color=red];
