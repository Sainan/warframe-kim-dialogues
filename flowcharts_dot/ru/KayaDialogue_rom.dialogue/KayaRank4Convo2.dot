	576 [label="Если уж на то пошло... теперь я уважаю тебя ещё больше.",shape=box,color=red];
		576 -> 579;
	577 [label="Никогда не будет момента, когда кто-то из нас осудит тебя за это.",shape=box,color=red];
		577 -> 580;
	578 [label="Может, однажды ты расскажешь мне о своём самом большом сожалении...",shape=box,color=blue];
		578 -> 581;
