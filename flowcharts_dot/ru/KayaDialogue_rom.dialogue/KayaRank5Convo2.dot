digraph {
	"KayaRank5Convo2 begins." [color=orange];
		"KayaRank5Convo2 begins." -> j1922406487;
	j1922406487 [label="А что если в этот раз я спрошу *тебя* про путешествия во времени?",shape=box,color=red];
		j1922406487 -> j843121319;
	j843121319 [label="Неа. Давай лучше поговорим о чём-то другом. Ок?",shape=box,color=blue];
		j843121319 -> j3602582192;
	j3602582192 [label="Check boolean KayaPromiseRegret",color=orange];
		j3602582192 -> j4020738275 [label=true,color=green];
		j3602582192 -> j3070667434 [label=false,color=brown];
		j3602582192 -> j1628126769 [label=false,color=brown];
	j4020738275 [label="Типа о самом большом сожалении?",shape=box,color=red];
		j4020738275 -> j1818383199;
	j3070667434 [label="Например? Твой выбор.",shape=box,color=red];
		j3070667434 -> j2746382863;
	j1628126769 [label="Как насчёт... Калимоса?",shape=box,color=red];
		j1628126769 -> j3913788377;
	j1818383199 [label="Ну, окей, рассказывай. Что там? ",shape=box,color=blue];
		j1818383199 -> j1238528963;
		j1818383199 -> j498278825;
		j1818383199 -> j3079332436;
	j2746382863 [label="Эммм, наверное... мой первый питомец? ",shape=box,color=blue];
		j2746382863 -> j2224957453;
	j3913788377 [label=" Да-да, с ней всё ок, но я больше по собакам. Росла с одной. Хотела бы снова её увидеть.",shape=box,color=blue];
		j3913788377 -> j966188079;
		j3913788377 -> j369100091;
		j3913788377 -> j54924619;
	j1238528963 [label="Не требовать большего от Альбрехта.",shape=box,color=red];
		j1238528963 -> j2653944204;
	j498278825 [label="Не остановив Балласа раньше.",shape=box,color=red];
		j498278825 -> j4123177740;
	j3079332436 [label="Опустить руки.",shape=box,color=red];
		j3079332436 -> j251516067;
	j2224957453 [label="Хотя это обычно те самые хакерские вопросы из интернета, так что ухх никому не говори.",shape=box,color=blue];
		j2224957453 -> j2789268639;
	j966188079 [label="Сочувствую. Лучше закончить здесь. [Конец.]",shape=box,color=red];
		j966188079 -> j3219460250;
	j369100091 [label="Сожалею, расскажи мне о нём.",shape=box,color=red];
		j369100091 -> j900302905;
	j54924619 [label="Я тоже теряла питомца. Как его звали?",shape=box,color=red];
		j54924619 -> j900302905;
	j2653944204 [label="Будто бы я просто позволила ему исчезнуть.",shape=box,color=red];
		j2653944204 -> j3560252067;
	j4123177740 [label="Не знаю, что я могла сделать иначе.",shape=box,color=red];
		j4123177740 -> j1224174445;
	j251516067 [label="Не важно, как это выглядит для других. Был момент, когда я ненавидела себя больше всех.",shape=box,color=red];
		j251516067 -> j3486394244;
	j2789268639 [label="Его звали Зило. Думаю, ты бы назвала его Кубрау.",shape=box,color=blue];
		j2789268639 -> j359706482;
	j3219460250 [label="+20 Chemistry",color=orange];
		j3219460250 -> "Chat ends. Next chat will be KayaRank5Convo3.";
	j900302905 [label="Вообще-то нечестно. Энтрати просто путешествует во времени с этой своей стрёмной кошкой?",shape=box,color=blue];
		j900302905 -> j4020165533;
	j3560252067 [label="Я знаю, он думает, что чему-то меня учит, но этот ублюдок даже не понимает, через что он меня провёл.",shape=box,color=red];
		j3560252067 -> j1115577464;
	j1224174445 [label="Но я знаю, что если бы была хотя бы на минуту быстрее, кто-то бы меньше мучился.",shape=box,color=red];
		j1224174445 -> j1641268046;
	j3486394244 [label="Я даже УМЕРЕТЬ не могла. А я мечтала об этом. ",shape=box,color=red];
		j3486394244 -> j1544921483;
	j359706482 [label="ОГРОМНЫЙ, как самая большая собака, какую можно представить. Могу поспорить, что мог бы перекусить господина Волкова пополам.",shape=box,color=blue];
		j359706482 -> j450754191;
		j359706482 -> j479271499;
	"Chat ends. Next chat will be KayaRank5Convo3." [color=orange];
	j4020165533 [label="Если бы Зило был со мной… это путешествие было бы куда проще.",shape=box,color=blue];
		j4020165533 -> j2085818566;
	j1115577464 [label="И не ТОЛЬКО я. Все мы. И Лоид, и Гомайтру... просто тошнит. Не знаю, смогу ли сдержаться, если увижу его.",shape=box,color=red];
		j1115577464 -> j1544921483;
	j1641268046 [label="Баллас это всё, чего я боюсь. Худшее, что может быть в жизни. ",shape=box,color=red];
		j1641268046 -> j1544921483;
	j1544921483 [label="Если так выразиться.. наверное, иногда жизнь и люди просто отстой, да?",shape=box,color=blue];
		j1544921483 -> j3439326462;
	j450754191 [label="У нас, откуда я родом, всё ещё есть огромные Кубрау! ",shape=box,color=red];
		j450754191 -> j3121244472;
	j479271499 [label="Эээ, не знаю, мистер Волков довольно крепкий.",shape=box,color=red];
		j479271499 -> j4287303600;
	j2085818566 [label="Зило был первым, кто видел, как я плачу, прикинь. ",shape=box,color=blue];
		j2085818566 -> j356343642;
	j3439326462 [label="Но порой это просто офигенно.",shape=box,color=blue];
		j3439326462 -> j3896800984;
	j3121244472 [label="О боже... ещё один повод ДОБРАТЬСЯ ТУДА. Офигеть!",shape=box,color=blue];
		j3121244472 -> j3045557796;
	j4287303600 [label="Вообще-то, может, ты права... но в любом случае, огромный страшный Зило. Но он яростно защищал меня.",shape=box,color=blue];
		j4287303600 -> j2085818566;
	j356343642 [label="Мне было где-то пять лет, и сколько себя помню, я отказывалась плакать.",shape=box,color=blue];
		j356343642 -> j3259979782;
	j3896800984 [label="Мы не должны зацикливаться на своих ошибках. Чувствую, ты помогла мне двинуться дальше.",shape=box,color=blue];
		j3896800984 -> j3567298871;
	j3045557796 [label="Мой Зило защищал меня любой ценой. ",shape=box,color=blue];
		j3045557796 -> j2085818566;
	j3259979782 [label="А потом я вернулась домой после первого дня в школе и Зило уже ждал меня там.",shape=box,color=blue];
		j3259979782 -> j3653253850;
	j3567298871 [label="Но я бы ничего не изменила. ",shape=box,color=blue];
		j3567298871 -> j1590372647;
	j3653253850 [label="И он просто последовал за мной в комнату и встал у двери, пока я рыдала.",shape=box,color=blue];
		j3653253850 -> j484271318;
		j3653253850 -> j4048920241;
	j1590372647 [label="Потому что, ну, мне это даже нравится. Нова? Да это вообще самый крутой расклад.",shape=box,color=blue];
		j1590372647 -> j2967856742;
	j484271318 [label="Что так расстроило тебя?",shape=box,color=red];
		j484271318 -> j710811737;
	j4048920241 [label="Как ты это запомнила?",shape=box,color=red];
		j4048920241 -> j1474457139;
	j2967856742 [label="Ты бы ничего не изменила?",shape=box,color=red];
		j2967856742 -> j1827766727;
	j710811737 [label="Кто-то назвал меня толстой.",shape=box,color=blue];
		j710811737 -> j3954261763;
	j1474457139 [label="Да как тут забудешь?!",shape=box,color=blue];
		j1474457139 -> j710811737;
	j1827766727 [label="Ни черта. И надеюсь, ты тоже бы не стала.",shape=box,color=blue];
		j1827766727 -> j3219460250;
	j3954261763 [label="Ну знаешь, то, из-за чего детей травили, когда я росла.",shape=box,color=blue];
		j3954261763 -> j3746345645;
		j3954261763 -> j1183333048;
	j3746345645 [label="Дети могут быть такими жестокими.",shape=box,color=red];
		j3746345645 -> j2078298862;
	j1183333048 [label="Разве популярность так важна?",shape=box,color=red];
		j1183333048 -> j2452600162;
	j2078298862 [label="Все жестоки.",shape=box,color=blue];
		j2078298862 -> j2034799675;
	j2452600162 [label="Была... пока всё это не случилось. Кажется, теперь я лучше, чем раньше, будто стала собой по-настоящему.",shape=box,color=blue];
		j2452600162 -> j853694920;
	j2034799675 [label="Все хотят быть крутыми.",shape=box,color=blue];
		j2034799675 -> j2810366272;
	j853694920 [label="Больше не важно, что обо мне думают. Просто.. наконец жить для себя.",shape=box,color=blue];
		j853694920 -> j3219460250;
	j2810366272 [label="Но теперь я поняла, куда круче просто не париться о популярности. Вот что делает тебя крутой.",shape=box,color=blue];
		j2810366272 -> j766064531;
	j766064531 [label="Чувствую, что стала лучше после всего этого дерьма, будто я наконец стала собой.",shape=box,color=blue];
		j766064531 -> j853694920;
}