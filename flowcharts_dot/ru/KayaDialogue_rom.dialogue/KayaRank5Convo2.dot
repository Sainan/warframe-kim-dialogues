	836 [label="+20 Chemistry",color=orange];
		836 -> 842;
	837 [label="Вообще-то нечестно. Энтрати просто путешествует во времени с этой своей стрёмной кошкой?",shape=box,color=blue];
		837 -> 843;
	844 [label="Я знаю, он думает, что чему-то меня учит, но этот ублюдок даже не понимает, через что он меня провёл.",shape=box,color=red];
		844 -> 849;
	845 [label="Но я знаю, что если бы была хотя бы на минуту быстрее, кто-то бы меньше мучился.",shape=box,color=red];
