		856 -> 860;
	857 [label="Вообще-то, может, ты права... но в любом случае, огромный страшный Зило. Но он яростно защищал меня.",shape=box,color=blue];
		857 -> 848;
	854 [label="Мне было где-то пять лет, и сколько себя помню, я отказывалась плакать.",shape=box,color=blue];
		854 -> 858;
	859 [label="Мы не должны зацикливаться на своих ошибках. Чувствую, ты помогла мне двинуться дальше.",shape=box,color=blue];
		859 -> 862;
	860 [label="Мой Зило защищал меня любой ценой. ",shape=box,color=blue];
		860 -> 848;
	858 [label="А потом я вернулась домой после первого дня в школе и Зило уже ждал меня там.",shape=box,color=blue];
