	842 [label="Chat ends. Next chat will be KayaRank5Convo3.",color=orange];
	843 [label="Если бы Зило был со мной… это путешествие было бы куда проще.",shape=box,color=blue];
		843 -> 848;
	849 [label="И не ТОЛЬКО я. Все мы. И Лоид, и Гомайтру... просто тошнит. Не знаю, смогу ли сдержаться, если увижу его.",shape=box,color=red];
