digraph {
	169 [label="KayaRank2Convo1 begins.",color=orange];
		169 -> 170;
	170 [label="Эй, Кайя!",shape=box,color=red];
		170 -> 171;
	171 [label="Нова, в сети я Нова.",shape=box,color=blue];
		171 -> 172;
		171 -> 173;
	172 [label="Ок, тогда Нова. ",shape=box,color=red];
		172 -> 174;
	173 [label="Поняла. С каких пор?",shape=box,color=red];
		173 -> 175;
	174 [label="Ладно, спасибо, просто не называй меня Кайя в интернете. Лично – пожалуйста, но здесь: НОВА. Ок?",shape=box,color=blue];
		174 -> 176;
		174 -> 177;
	175 [label="Эм, это вообще важно? Это интернет, не хочу использовать своё настоящее имя.",shape=box,color=blue];
		175 -> 178;
		175 -> 179;
	176 [label="Ок, но могу спросить почему?",shape=box,color=red];
		176 -> 180;
	177 [label="Принято. Нова. Нова. Хорошо. Я хотел спросить: могу что-то сделать, чтобы тебе здесь было комфортнее?",shape=box,color=red];
		177 -> 181;
	178 [label="Ага, не хотелось бы, чтобы кто-то заметил, как часто ты спрашиваешь меня о путешествиях во времени.",shape=box,color=red];
		178 -> 182;
	179 [label="О? По-моему, Амир тут всё надёжно закрыл, если я ничего не упускаю?",shape=box,color=red];
		179 -> 183;
	180 [label="Ты вообще спрашивала кого-нибудь ещё, есть ли у них любимые ники? Просто смирись уже. ",shape=box,color=blue];
		180 -> 177;
	181 [label="Знаю, никто из нас особо не хотел \"быть здесь\" в этом импровизированном доме, но мы стараемся.",shape=box,color=red];
		181 -> 184;
	182 [label="Ты серьёзно? Интернет опасен. Реально.",shape=box,color=blue];
		182 -> 185;
		182 -> 186;
	183 [label="Для меня это важно. Я не хочу, чтобы Кайю когда-либо снова нашли в сети.",shape=box,color=blue];
		183 -> 187;
		183 -> 188;
	184 [label="Хмм. Эмм. Хмм. Комфортнее. Никто обо мне слухи не распускает?",shape=box,color=blue];
		184 -> 189;
		184 -> 190;
	185 [label="Что-то случилось?",shape=box,color=red];
		185 -> 191;
	186 [label="И ты думаешь, путешествия во времени не опасны?",shape=box,color=red];
		186 -> 192;
	187 [label="Клянусь, тайм-копы тебя не схватят.",shape=box,color=red];
		187 -> 193;
	188 [label="Ты опять вляпался во что-то?",shape=box,color=red];
		188 -> 194;
	189 [label="Ну, Аои говорила...",shape=box,color=red];
		189 -> 195;
	190 [label="Ни слова. Только радость, что ты здесь.",shape=box,color=red];
		190 -> 196;
	191 [label="Check boolean KayaSetKid",color=orange];
		191 -> 198 [label=true,color=green];
		191 -> 197 [label=false,color=brown];
	192 [label="Check boolean KayaSetKid",color=orange];
		192 -> 200 [label=true,color=green];
		192 -> 199 [label=false,color=brown];
	193 [label="Угх. Не смешно. ",shape=box,color=blue];
		193 -> 201;
	194 [label="Я совершила ГЛУПУЮ ошибку. Однажды. ",shape=box,color=blue];
		194 -> 202;
	195 [label="Даже не шути об этом, серьёзно.",shape=box,color=blue];
		195 -> 203;
	196 [label="Артур и Элеанор точно видят в тебе младшую сестру, которая умнее их обоих.",shape=box,color=red];
		196 -> 204;
	198 [label="Это ты говоришь, что я как ребёнок, а если бы со мной что-то случилось?",shape=box,color=blue];
		198 -> 206;
	197 [label="Ничего, что я могу изменить сейчас.",shape=box,color=blue];
		197 -> 205;
	200 [label="Слушай, я знаю, что ты думаешь, будто я просто ребёнок.",shape=box,color=blue];
		200 -> 208;
	199 [label="Ладно. Ты права.",shape=box,color=blue];
		199 -> 207;
	201 [label="+20 Chemistry",color=orange];
		201 -> 209;
	202 [label="И я не ошибаюсь.",shape=box,color=blue];
		202 -> 210;
	203 [label="Это даже не смешно. Если собрать таких, как мы, в одной комнате, все ждут, что мы будем рвать друг другу глотки.",shape=box,color=blue];
		203 -> 211;
	204 [label="Амир и Куинси просто помешаны на твоём червоточине, и, клянусь, когда ты не смотришь, они через неё прыгают.",shape=box,color=red];
		204 -> 212;
	206 [label="Тогда, надеюсь, ты видишь, что люди вокруг тебя – это команда, и мы помогаем друг другу.",shape=box,color=red];
		206 -> 214;
	205 [label="Так ты из-за этого хочешь разобраться с путешествиями во времени? Чтобы что-то доказать?",shape=box,color=red];
		205 -> 213;
	208 [label="Но ",shape=box,color=blue];
		208 -> 194;
	207 [label="Скорее всего, да. И поэтому я должна знать, как это делать правильно. Ошибок быть не должно.",shape=box,color=blue];
		207 -> 194;
	209 [label="Chat ends. Next chat will be KayaRank2Convo2.",color=orange];
	210 [label="Так что дай мне ещё пару дней, может, пару недель, и я во всём разберусь, а потом – прощай, 1999-й.",shape=box,color=blue];
		210 -> 215;
	211 [label="Зависть. Сравнения. Фу. Я покончила с этой частью своей жизни. Не пытайся настроить меня против других девушек. ",shape=box,color=blue];
		211 -> 216;
	212 [label="Аои и Лэтти никак не решат, быть твоими лучшими подругами или твоей матерью.",shape=box,color=red];
		212 -> 217;
	214 [label="Ммм. ",shape=box,color=blue];
		214 -> 219;
	213 [label="Может быть.",shape=box,color=blue];
		213 -> 218;
	215 [label="Можешь не сомневаться.",shape=box,color=blue];
		215 -> 220;
	216 [label="+20 Chemistry",color=orange];
		216 -> 221;
	217 [label="А я, конечно же, рада, что хоть кто-то хочет понять, какого чёрта я здесь оказалась.",shape=box,color=red];
		217 -> 222;
	219 [label="Ты права. Ты не то чтобы непопулярна.",shape=box,color=blue];
		219 -> 226;
	218 [label="А тебе-то вообще какое дело?",shape=box,color=blue];
		218 -> 223;
		218 -> 224;
		218 -> 225;
	220 [label="+20 Chemistry",color=orange];
		220 -> 227;
	221 [label="Chat ends. Next chat will be KayaRank2Convo2.",color=orange];
	222 [label="Вы, ребята, правда… типа, любите меня?",shape=box,color=blue];
		222 -> 228;
		222 -> 229;
	226 [label="И, похоже, все тебе доверяют. Или, по крайней мере, говорят, что доверяют.",shape=box,color=blue];
		226 -> 225;
		226 -> 224;
		226 -> 223;
	223 [label="Доверять людям и работать вместе – вот что делает нас нами. ",shape=box,color=red];
		223 -> 230;
	224 [label="Заботиться о друзьях – это сила. Это причина терпеть всю эту хрень.",shape=box,color=red];
		224 -> 230;
	225 [label="У каждого свои проблемы. И одному с ними справляться тяжело.",shape=box,color=red];
		225 -> 230;
	227 [label="Chat ends. Next chat will be KayaRank2Convo2.",color=orange];
	228 [label="Мы просто ждём, пока ты сам почувствуешь себя с нами комфортно.",shape=box,color=red];
		228 -> 231;
	229 [label="А как мы можем не доверять? ",shape=box,color=red];
		229 -> 231;
	230 [label="ХАХА, звучит как какой-то слоган сестринства.",shape=box,color=blue];
		230 -> 232;
		230 -> 233;
	231 [label="Я… ясно.",shape=box,color=blue];
		231 -> 234;
	232 [label="Что вообще такое «сестринство»?",shape=box,color=red];
		232 -> 235;
	233 [label="Сестринство? Это ещё что.",shape=box,color=red];
		233 -> 235;
	234 [label="+20 Chemistry",color=orange];
		234 -> 236;
	235 [label="ХАХА, серьёзно? Если в будущем их нет, то мне точно туда надо. Офигеть.",shape=box,color=blue];
		235 -> 237;
	236 [label="Chat ends. Next chat will be KayaRank2Convo2.",color=orange];
	237 [label="Не догоняю...",shape=box,color=red];
		237 -> 238;
	238 [label="В универе кучка девчонок называет себя «сёстрами» и думают, что это что-то значит. Типа «клуб», наверное. ",shape=box,color=blue];
		238 -> 239;
	239 [label="О, может, как «Сёстры Парвоса»?",shape=box,color=red];
		239 -> 240;
	240 [label="Звучит отстойно. Фу. Надеюсь, это не настоящее сестринство.",shape=box,color=blue];
		240 -> 241;
