digraph {
	"KayaRank2Convo1 begins." [color=orange];
		"KayaRank2Convo1 begins." -> j3933423907;
	j3933423907 [label="Эй, Кайя!",shape=box,color=red];
		j3933423907 -> j1367691717;
	j1367691717 [label="Нова, в сети я Нова.",shape=box,color=blue];
		j1367691717 -> j1173868952;
		j1367691717 -> j1081254210;
	j1173868952 [label="Ок, тогда Нова. ",shape=box,color=red];
		j1173868952 -> j876414801;
	j1081254210 [label="Поняла. С каких пор?",shape=box,color=red];
		j1081254210 -> j532523309;
	j876414801 [label="Ладно, спасибо, просто не называй меня Кайя в интернете. Лично – пожалуйста, но здесь: НОВА. Ок?",shape=box,color=blue];
		j876414801 -> j3903077977;
		j876414801 -> j2048787584;
	j532523309 [label="Эм, это вообще важно? Это интернет, не хочу использовать своё настоящее имя.",shape=box,color=blue];
		j532523309 -> j767359741;
		j532523309 -> j184846322;
	j3903077977 [label="Ок, но могу спросить почему?",shape=box,color=red];
		j3903077977 -> j3099036400;
	j2048787584 [label="Принято. Нова. Нова. Хорошо. Я хотел спросить: могу что-то сделать, чтобы тебе здесь было комфортнее?",shape=box,color=red];
		j2048787584 -> j3786054774;
	j767359741 [label="Ага, не хотелось бы, чтобы кто-то заметил, как часто ты спрашиваешь меня о путешествиях во времени.",shape=box,color=red];
		j767359741 -> j176334959;
	j184846322 [label="О? По-моему, Амир тут всё надёжно закрыл, если я ничего не упускаю?",shape=box,color=red];
		j184846322 -> j3964689908;
	j3099036400 [label="Ты вообще спрашивала кого-нибудь ещё, есть ли у них любимые ники? Просто смирись уже. ",shape=box,color=blue];
		j3099036400 -> j2048787584;
	j3786054774 [label="Знаю, никто из нас особо не хотел \"быть здесь\" в этом импровизированном доме, но мы стараемся.",shape=box,color=red];
		j3786054774 -> j3347319457;
	j176334959 [label="Ты серьёзно? Интернет опасен. Реально.",shape=box,color=blue];
		j176334959 -> j4203866422;
		j176334959 -> j1038685744;
	j3964689908 [label="Для меня это важно. Я не хочу, чтобы Кайю когда-либо снова нашли в сети.",shape=box,color=blue];
		j3964689908 -> j1241786208;
		j3964689908 -> j2243663695;
	j3347319457 [label="Хмм. Эмм. Хмм. Комфортнее. Никто обо мне слухи не распускает?",shape=box,color=blue];
		j3347319457 -> j1634000378;
		j3347319457 -> j1592937076;
	j4203866422 [label="Что-то случилось?",shape=box,color=red];
		j4203866422 -> j960515419;
	j1038685744 [label="И ты думаешь, путешествия во времени не опасны?",shape=box,color=red];
		j1038685744 -> j4294415938;
	j1241786208 [label="Клянусь, тайм-копы тебя не схватят.",shape=box,color=red];
		j1241786208 -> j105412111;
	j2243663695 [label="Ты опять вляпался во что-то?",shape=box,color=red];
		j2243663695 -> j2630149188;
	j1634000378 [label="Ну, Аои говорила...",shape=box,color=red];
		j1634000378 -> j3757958504;
	j1592937076 [label="Ни слова. Только радость, что ты здесь.",shape=box,color=red];
		j1592937076 -> j1626621345;
	j960515419 [label="Check boolean KayaSetKid",color=orange];
		j960515419 -> j1443657511 [label=true,color=green];
		j960515419 -> j1394650680 [label=false,color=brown];
	j4294415938 [label="Check boolean KayaSetKid",color=orange];
		j4294415938 -> j1649992040 [label=true,color=green];
		j4294415938 -> j4223130013 [label=false,color=brown];
	j105412111 [label="Угх. Не смешно. ",shape=box,color=blue];
		j105412111 -> j2292283515;
	j2630149188 [label="Я совершила ГЛУПУЮ ошибку. Однажды. ",shape=box,color=blue];
		j2630149188 -> j423454023;
	j3757958504 [label="Даже не шути об этом, серьёзно.",shape=box,color=blue];
		j3757958504 -> j3219608325;
	j1626621345 [label="Артур и Элеанор точно видят в тебе младшую сестру, которая умнее их обоих.",shape=box,color=red];
		j1626621345 -> j9478935;
	j1443657511 [label="Это ты говоришь, что я как ребёнок, а если бы со мной что-то случилось?",shape=box,color=blue];
		j1443657511 -> j2658655884;
	j1394650680 [label="Ничего, что я могу изменить сейчас.",shape=box,color=blue];
		j1394650680 -> j820711622;
	j1649992040 [label="Слушай, я знаю, что ты думаешь, будто я просто ребёнок.",shape=box,color=blue];
		j1649992040 -> j1475956550;
	j4223130013 [label="Ладно. Ты права.",shape=box,color=blue];
		j4223130013 -> j2936066303;
	j2292283515 [label="+20 Chemistry",color=orange];
		j2292283515 -> "Chat ends. Next chat will be KayaRank2Convo2.";
	j423454023 [label="И я не ошибаюсь.",shape=box,color=blue];
		j423454023 -> j2612839416;
	j3219608325 [label="Это даже не смешно. Если собрать таких, как мы, в одной комнате, все ждут, что мы будем рвать друг другу глотки.",shape=box,color=blue];
		j3219608325 -> j3712357922;
	j9478935 [label="Амир и Куинси просто помешаны на твоём червоточине, и, клянусь, когда ты не смотришь, они через неё прыгают.",shape=box,color=red];
		j9478935 -> j3878357456;
	j2658655884 [label="Тогда, надеюсь, ты видишь, что люди вокруг тебя – это команда, и мы помогаем друг другу.",shape=box,color=red];
		j2658655884 -> j2215827947;
	j820711622 [label="Так ты из-за этого хочешь разобраться с путешествиями во времени? Чтобы что-то доказать?",shape=box,color=red];
		j820711622 -> j2817231750;
	j1475956550 [label="Но ",shape=box,color=blue];
		j1475956550 -> j2630149188;
	j2936066303 [label="Скорее всего, да. И поэтому я должна знать, как это делать правильно. Ошибок быть не должно.",shape=box,color=blue];
		j2936066303 -> j2630149188;
	"Chat ends. Next chat will be KayaRank2Convo2." [color=orange];
	j2612839416 [label="Так что дай мне ещё пару дней, может, пару недель, и я во всём разберусь, а потом – прощай, 1999-й.",shape=box,color=blue];
		j2612839416 -> j3755547486;
	j3712357922 [label="Зависть. Сравнения. Фу. Я покончила с этой частью своей жизни. Не пытайся настроить меня против других девушек. ",shape=box,color=blue];
		j3712357922 -> j2292283515;
	j3878357456 [label="Аои и Лэтти никак не решат, быть твоими лучшими подругами или твоей матерью.",shape=box,color=red];
		j3878357456 -> j1290510194;
	j2215827947 [label="Ммм. ",shape=box,color=blue];
		j2215827947 -> j1436043728;
	j2817231750 [label="Может быть.",shape=box,color=blue];
		j2817231750 -> j2869916796;
	j3755547486 [label="Можешь не сомневаться.",shape=box,color=blue];
		j3755547486 -> j2292283515;
	j1290510194 [label="А я, конечно же, рада, что хоть кто-то хочет понять, какого чёрта я здесь оказалась.",shape=box,color=red];
		j1290510194 -> j214040922;
	j1436043728 [label="Ты права. Ты не то чтобы непопулярна.",shape=box,color=blue];
		j1436043728 -> j1213565396;
	j2869916796 [label="А тебе-то вообще какое дело?",shape=box,color=blue];
		j2869916796 -> j2452092440;
		j2869916796 -> j1521373790;
		j2869916796 -> j1241069747;
	j214040922 [label="Вы, ребята, правда… типа, любите меня?",shape=box,color=blue];
		j214040922 -> j1079862851;
		j214040922 -> j921201037;
	j1213565396 [label="И, похоже, все тебе доверяют. Или, по крайней мере, говорят, что доверяют.",shape=box,color=blue];
		j1213565396 -> j1241069747;
		j1213565396 -> j1521373790;
		j1213565396 -> j2452092440;
	j2452092440 [label="Доверять людям и работать вместе – вот что делает нас нами. ",shape=box,color=red];
		j2452092440 -> j2471954210;
	j1521373790 [label="Заботиться о друзьях – это сила. Это причина терпеть всю эту хрень.",shape=box,color=red];
		j1521373790 -> j2471954210;
	j1241069747 [label="У каждого свои проблемы. И одному с ними справляться тяжело.",shape=box,color=red];
		j1241069747 -> j2471954210;
	j1079862851 [label="Мы просто ждём, пока ты сам почувствуешь себя с нами комфортно.",shape=box,color=red];
		j1079862851 -> j4008106982;
	j921201037 [label="А как мы можем не доверять? ",shape=box,color=red];
		j921201037 -> j4008106982;
	j2471954210 [label="ХАХА, звучит как какой-то слоган сестринства.",shape=box,color=blue];
		j2471954210 -> j2486810578;
		j2471954210 -> j2505489625;
	j4008106982 [label="Я… ясно.",shape=box,color=blue];
		j4008106982 -> j2292283515;
	j2486810578 [label="Что вообще такое «сестринство»?",shape=box,color=red];
		j2486810578 -> j1095294146;
	j2505489625 [label="Сестринство? Это ещё что.",shape=box,color=red];
		j2505489625 -> j1095294146;
	j1095294146 [label="ХАХА, серьёзно? Если в будущем их нет, то мне точно туда надо. Офигеть.",shape=box,color=blue];
		j1095294146 -> j1859615726;
	j1859615726 [label="Не догоняю...",shape=box,color=red];
		j1859615726 -> j3234947886;
	j3234947886 [label="В универе кучка девчонок называет себя «сёстрами» и думают, что это что-то значит. Типа «клуб», наверное. ",shape=box,color=blue];
		j3234947886 -> j425503270;
	j425503270 [label="О, может, как «Сёстры Парвоса»?",shape=box,color=red];
		j425503270 -> j1248318913;
	j1248318913 [label="Звучит отстойно. Фу. Надеюсь, это не настоящее сестринство.",shape=box,color=blue];
		j1248318913 -> j588631753;
	j588631753 [label="Ну, они пытаются меня убить. Часто.",shape=box,color=red];
		j588631753 -> j896679038;
	j896679038 [label="Чувствуется, будто мой тоже пытался меня убить...",shape=box,color=blue];
		j896679038 -> j2292283515;
}