digraph {
	"KayaRank4Convo1 begins." [color=orange];
		"KayaRank4Convo1 begins." -> j3493034301;
	j3493034301 [label="Ты хочешь знать, каково это? Интернет появляется, обещает нам так много всего.",shape=box,color=blue];
		j3493034301 -> j2739329724;
	j2739329724 [label="А потом ты это я. Тебе исполняется 18. Ты заходишь в сеть. Ты начинаешь общаться с новыми друзьями ОТОВСЮДУ!",shape=box,color=blue];
		j2739329724 -> j1212186908;
	j1212186908 [label="И, будучи так называемой \"умной девочкой\", ты совершаешь самую тупую ошибку в интернете. ",shape=box,color=blue];
		j1212186908 -> j1970219729;
	j1970219729 [label="Ты доверяешь человеку по ту сторону экрана. ",shape=box,color=blue];
		j1970219729 -> j1662124810;
	j1662124810 [label="Ты смотришь на все эти новые технологии и забываешь, что люди остаются людьми. ",shape=box,color=blue];
		j1662124810 -> j1132983763;
	j1132983763 [label="Так что ты отправляешь откровенное фото, от которого даже Луа покраснела бы. Думаешь, у тебя есть связь с кем-то, кого встретила онлайн. Думаешь, можешь доверять своему интернет-парню. ",shape=box,color=blue];
		j1132983763 -> j2286594524;
	j2286594524 [label="А на следующий день это фото повсюду. Весь кампус его видел. Разослали. Отправили твоим ПРОФЕССОРАМ. Весь ИНТЕРНЕТ. Страны, о существовании которых я даже не знала.",shape=box,color=blue];
		j2286594524 -> j1988758925;
	j1988758925 [label="Я могла быть самым умным человеком на этой планете, но люди запомнили бы меня только по этому фото.",shape=box,color=blue];
		j1988758925 -> j2572490869;
	j2572490869 [label="Так что когда я говорю, что собираюсь выбраться отсюда, я не шучу. Я знаю, что это фото НИЧЕГО не значит, мир двинулся дальше, люди получили свои развлечения.",shape=box,color=blue];
		j2572490869 -> j2622217506;
	j2622217506 [label="Но для меня это разрушило мою жизнь. Я хочу жить в будущем без интернета. Я хочу доказать, что могу двинуться дальше. Возвращение в прошлое доказывает ИХ правоту, что я не могу двигаться дальше из этого.",shape=box,color=blue];
		j2622217506 -> j1930276397;
	j1930276397 [label="Так что просто подожди. Ты увидишь меня там, откуда ты пришла. ",shape=box,color=blue];
		j1930276397 -> j2114381235;
	j2114381235 [label="И тогда мы сможем вместе посмотреть на этот мир и посмеяться над тем, что мои ошибки меня не уничтожили. Они просто сделали меня умнее. Достаточно умной, чтобы уйти.",shape=box,color=blue];
		j2114381235 -> j3258508148;
	j3258508148 [label="+20 Chemistry",color=orange];
		j3258508148 -> "Chat ends. Next chat will be KayaRank4Convo2.";
	"Chat ends. Next chat will be KayaRank4Convo2." [color=orange];
}