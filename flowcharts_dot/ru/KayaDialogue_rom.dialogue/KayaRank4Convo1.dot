digraph {
	541 [label="KayaRank4Convo1 begins.",color=orange];
		541 -> 542;
	542 [label="Ты хочешь знать, каково это? Интернет появляется, обещает нам так много всего.",shape=box,color=blue];
		542 -> 543;
	543 [label="А потом ты это я. Тебе исполняется 18. Ты заходишь в сеть. Ты начинаешь общаться с новыми друзьями ОТОВСЮДУ!",shape=box,color=blue];
		543 -> 544;
	544 [label="И, будучи так называемой \"умной девочкой\", ты совершаешь самую тупую ошибку в интернете. ",shape=box,color=blue];
		544 -> 545;
	545 [label="Ты доверяешь человеку по ту сторону экрана. ",shape=box,color=blue];
		545 -> 546;
	546 [label="Ты смотришь на все эти новые технологии и забываешь, что люди остаются людьми. ",shape=box,color=blue];
		546 -> 547;
	547 [label="Так что ты отправляешь откровенное фото, от которого даже Луа покраснела бы. Думаешь, у тебя есть связь с кем-то, кого встретила онлайн. Думаешь, можешь доверять своему интернет-парню. ",shape=box,color=blue];
		547 -> 548;
	548 [label="А на следующий день это фото повсюду. Весь кампус его видел. Разослали. Отправили твоим ПРОФЕССОРАМ. Весь ИНТЕРНЕТ. Страны, о существовании которых я даже не знала.",shape=box,color=blue];
		548 -> 549;
	549 [label="Я могла быть самым умным человеком на этой планете, но люди запомнили бы меня только по этому фото.",shape=box,color=blue];
		549 -> 550;
	550 [label="Так что когда я говорю, что собираюсь выбраться отсюда, я не шучу. Я знаю, что это фото НИЧЕГО не значит, мир двинулся дальше, люди получили свои развлечения.",shape=box,color=blue];
		550 -> 551;
	551 [label="Но для меня это разрушило мою жизнь. Я хочу жить в будущем без интернета. Я хочу доказать, что могу двинуться дальше. Возвращение в прошлое доказывает ИХ правоту, что я не могу двигаться дальше из этого.",shape=box,color=blue];
		551 -> 552;
	552 [label="Так что просто подожди. Ты увидишь меня там, откуда ты пришла. ",shape=box,color=blue];
		552 -> 553;
	553 [label="И тогда мы сможем вместе посмотреть на этот мир и посмеяться над тем, что мои ошибки меня не уничтожили. Они просто сделали меня умнее. Достаточно умной, чтобы уйти.",shape=box,color=blue];
		553 -> 554;
	554 [label="+20 Chemistry",color=orange];
		554 -> 555;
	555 [label="Chat ends. Next chat will be KayaRank4Convo2.",color=orange];
}