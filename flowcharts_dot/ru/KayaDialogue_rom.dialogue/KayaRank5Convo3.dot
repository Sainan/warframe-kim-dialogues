digraph {
	"KayaRank5Convo3 begins." [color=orange];
		"KayaRank5Convo3 begins." -> j3657258775;
	j3657258775 [label="Оооой, привет, могу ли я представить тебе экспресс-курс по JINYMON КАРТАМ?",shape=box,color=blue];
		j3657258775 -> j1273437051;
	j1273437051 [label="Амир, конечно, в восторге ему наконец-то есть с кем играть (и проигрывать).",shape=box,color=blue];
		j1273437051 -> j2125777597;
	j2125777597 [label="Но нам обоим показалось забавным втянуть тебя в Jinymon. ",shape=box,color=blue];
		j2125777597 -> j996565133;
		j2125777597 -> j898209373;
		j2125777597 -> j3741057736;
	j996565133 [label="Вы играйте, а я занята. [Конец.]",shape=box,color=red];
		j996565133 -> j145506587;
	j898209373 [label="У меня есть пару хёлларов, жгущих карман. С чего начнём?",shape=box,color=red];
		j898209373 -> j2972018551;
	j3741057736 [label="Напомни... о чём мы говорили?",shape=box,color=red];
		j3741057736 -> j2845433167;
	j145506587 [label="+20 Chemistry",color=orange];
		j145506587 -> "Chat ends. Next chat will be KayaRank5Convo4.";
	j2972018551 [label="Оооокей, да! Так, сначала. Давай сосредоточимся на тебе. Ты больше Дракон, Орёл или Пантера?",shape=box,color=blue];
		j2972018551 -> j3133350044;
		j2972018551 -> j1474820257;
		j2972018551 -> j1150972085;
	j2845433167 [label="Это же САМЫЙ популярный сериал, игра и коллекционка 1999-го!",shape=box,color=blue];
		j2845433167 -> j3323688485;
	"Chat ends. Next chat will be KayaRank5Convo4." [color=orange];
	j3133350044 [label="Пантера.",shape=box,color=red];
		j3133350044 -> j482375313;
	j1474820257 [label="Орёл.",shape=box,color=red];
		j1474820257 -> j3023682594;
	j1150972085 [label="Дракон.",shape=box,color=red];
		j1150972085 -> j2456758125;
	j3323688485 [label="Ну, типа, супер-крутые персонажи и существа...",shape=box,color=blue];
		j3323688485 -> j2324798764;
	j482375313 [label="Тогда тебе ОДНОЗНАЧНО стоит начать игру с Tailala",shape=box,color=blue];
		j482375313 -> j2382910501;
	j3023682594 [label="Тогда тебе ТОЧНО стоит начать игру с Plumebert",shape=box,color=blue];
		j3023682594 -> j3111035254;
	j2456758125 [label="Тогда тебе ВЕРОЯТНО стоит выбрать Frogobogo.",shape=box,color=blue];
		j2456758125 -> j1685542421;
	j2324798764 [label="Но не суть. Давай начнём с тебя. Ты больше похожа на Дракона, Орла или Пантеру?",shape=box,color=blue];
		j2324798764 -> j3133350044;
		j2324798764 -> j1474820257;
		j2324798764 -> j1150972085;
	j2382910501 [label="Это, конечно, самый крутой вариант, но да, не из лёгких, старт слабенький.",shape=box,color=blue];
		j2382910501 -> j1788938769;
	j3111035254 [label="Это чуть сложнее, но реально круто. ",shape=box,color=blue];
		j3111035254 -> j2714938823;
	j1685542421 [label="Отличный выбор для новичков. ",shape=box,color=blue];
		j1685542421 -> j1200737716;
	j1788938769 [label="Но к финалу? У тебя будет самая шикарная и величественная Пантера.",shape=box,color=blue];
		j1788938769 -> j1423289614;
	j2714938823 [label="А Плюмберт такой милаха, потому что его можно кормить Игристыми Виноградинками, и он будет прокачиваться быстрее остальных.",shape=box,color=blue];
		j2714938823 -> j468143366;
	j1200737716 [label="Ну да, в начале у тебя будет буквально самая милая лягушка в мире, но если победишь достаточно раз..",shape=box,color=blue];
		j1200737716 -> j1413868877;
	j1423289614 [label="Прямо стильный выбор.",shape=box,color=blue];
		j1423289614 -> j4122863887;
	j468143366 [label="Который открывает целую систему сельского хозяйства.",shape=box,color=blue];
		j468143366 -> j4122863887;
	j1413868877 [label="Ты можешь прокачать Frogobogo до ДРАКОНА.",shape=box,color=blue];
		j1413868877 -> j4122863887;
	j4122863887 [label="Что это вообще за игра...",shape=box,color=red];
		j4122863887 -> j996745998;
	j996745998 [label="Ну, короче, ты собираешь Jinymons, они сражаются за тебя, а ты исследуешь мир.",shape=box,color=blue];
		j996745998 -> j2073704002;
	j2073704002 [label="Но это в видеоигре. В карточной версии ты сама сражаешься, но уже против реальных людей.",shape=box,color=blue];
		j2073704002 -> j536986704;
	j536986704 [label="Но суть одна и та же. Jinymon Jinymon Jinymon. ",shape=box,color=blue];
		j536986704 -> j3003564253;
	j3003564253 [label="Ну что, готова сыграть первую партию?",shape=box,color=blue];
		j3003564253 -> j2012981151;
		j3003564253 -> j1678878217;
		j3003564253 -> j2241353212;
		j3003564253 -> j883752705;
	j2012981151 [label="Ни за что. [Конец.]",shape=box,color=red];
		j2012981151 -> j145506587;
	j1678878217 [label="Ладно, а почему нет? Новичкам же везёт.",shape=box,color=red];
		j1678878217 -> j2518773999;
	j2241353212 [label="Ты просто хочешь лёгкую победу. Ни за что.",shape=box,color=red];
		j2241353212 -> j2710141446;
	j883752705 [label="Нет, теперь я ещё больше запуталась. Ты ничего не объяснила! ",shape=box,color=red];
		j883752705 -> j2710141446;
	j2518773999 [label="Ну класс... всего-то нужно отвалить 10 000 хёлларов за стартовый пак...",shape=box,color=blue];
		j2518773999 -> j1077399981;
		j2518773999 -> j1424673779;
	j2710141446 [label="Да ну брось... Я поддамся. Даже Амиру разрешу тебе помочь! ",shape=box,color=blue];
		j2710141446 -> j2335821607;
	j1077399981 [label="Как скажешь...",shape=box,color=red];
		j1077399981 -> j2284580340;
	j1424673779 [label="Что за! У меня нет таких денег.",shape=box,color=red];
		j1424673779 -> j2284580340;
	j2335821607 [label="А если выиграешь, отдам тебе запечатанный набор Jinymon!",shape=box,color=blue];
		j2335821607 -> j1526273284;
		j2335821607 -> j3572687336;
		j2335821607 -> j1512227650;
	j2284580340 [label="Никаких проблем, просто введи здесь свои банковские данные....",shape=box,color=blue];
		j2284580340 -> j380365919;
		j2284580340 -> j1770869636;
	j1526273284 [label="Ладно, только если Амир поможет.",shape=box,color=red];
		j1526273284 -> j2518773999;
	j3572687336 [label="Давай отложим на потом?",shape=box,color=red];
		j3572687336 -> j2986002257;
	j1512227650 [label="Фигушки! ",shape=box,color=red];
		j1512227650 -> j2986002257;
	j380365919 [label="Я на это не куплюсь!",shape=box,color=red];
		j380365919 -> j4266922328;
	j1770869636 [label="Ладно, 4…1",shape=box,color=red];
		j1770869636 -> j3597048865;
	j2986002257 [label="Лаааднооо.",shape=box,color=blue];
		j2986002257 -> j145506587;
	j4266922328 [label="Поздравляю, ты прошла тест безопасности K.O.L. ",shape=box,color=blue];
		j4266922328 -> j2244008183;
	j3597048865 [label="ЧЁРТ, НЕТ! Это был тест, НЕЛЬЗЯ вводить банковские данные в сервисах K.O.L! ",shape=box,color=blue];
		j3597048865 -> j3819986537;
	j2244008183 [label="О боже, Амир был так уверен, что ты купишься.",shape=box,color=blue];
		j2244008183 -> j381536537;
	j3819986537 [label="Тьфу, черт возьми! Теперь я должна Амиру игру. Он сказал, что ты поведёшься на это.",shape=box,color=blue];
		j3819986537 -> j145506587;
	j381536537 [label="Но да, сыграем потом.",shape=box,color=blue];
		j381536537 -> j145506587;
}