	3007 [label="Я думаю, это было бы очень весело и стало бы хорошим объединяющим стимулом для всех нас.",shape=box,color=red];
		3007 -> 3010;
	3008 [label="Он чувствует себя лишним — не военным, ботаником, как бы на обочине. Для него многое бы значило, если бы мы все сели и сыграли с ним в одну из его игр.",shape=box,color=red];
