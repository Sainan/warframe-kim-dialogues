		3609 -> 3612 [label=true,color=green];
		3609 -> 3613 [label=false,color=brown];
		3609 -> 3611 [label=false,color=brown];
	3641 [label="Check boolean ArthurPolyamorySuccess",color=orange];
		3641 -> 3609 [label=true,color=green];
		3641 -> 3610 [label=false,color=brown];
	3612 [label="Chat ends.",color=orange];
	3613 [label="Артур, можно на несколько слов? [Спросить согласие нескольких партнёров.]",shape=box,color=red];
		3613 -> 3615;
	3611 [label="[Конец.]",shape=box,color=red];
		3611 -> 3614;
	3610 [label="Chat ends.",color=orange];
	3615 [label="Всегда. Что стряслось?",shape=box,color=blue];
		3615 -> 3617;
	3614 [label="Update boolean ArthurConsentComplete",color=orange];
		3614 -> 3616;
	3617 [label="Да ничего особенного! Я просто хотел поговорить с тобой о ситуации, которая, надеюсь, не поставит тебя в неловкое положение.",shape=box,color=red];
		3617 -> 3618;
	3616 [label="Chat ends.",color=orange];
	3618 [label="Я не хочу ставить тебя в ситуацию, в которой ты будешь чувствовать себя плохо. Я знаю, мы это раньше не обсуждали. Так что если ты скажешь нет, это нормально. И я хочу, чтобы ты это знала.",shape=box,color=red];
		3618 -> 3619;
	3619 [label="То, что есть между нами, важно для меня. Очень важно. И оно настоящее. Я не хочу, чтобы были какие-то сомнения.",shape=box,color=red];
		3619 -> 3620;
	3620 [label="Ага. Понимаю, к чему ты клонишь. У тебя есть чувства к кому-то другому?",shape=box,color=blue];
		3620 -> 3621;
		3620 -> 3622;
	3621 [label="Да. И понимаю, что это может быть непросто, но к тебе я не чувствую меньше.",shape=box,color=red];
		3621 -> 3623;
	3622 [label="Понимаю. Но, если задуматься, кажется, что на этом всё стоит закончить. [Расставание.]",shape=box,color=red];
		3622 -> 3624;
	3623 [label="Дорогая, неужели ты правда думаешь, что я столько лет прослужил военным и не видел всех видов отношений, которые только могут быть?",shape=box,color=blue];
		3623 -> 3625;
	3624 [label="Если ты правда этого хочешь, что ж...",shape=box,color=blue];
		3624 -> 3626;
	3625 [label="Когда проводишь большую часть своей жизни на грани смерти, начинаешь ценить, что в жизни важно, а что нет.",shape=box,color=blue];
		3625 -> 3627;
	3626 [label="Update boolean IsDating",color=orange];
		3626 -> 3628;
	3627 [label="И перестаёшь бояться штрихов в песке. Я понимаю.",shape=box,color=blue];
		3627 -> 3629;
	3628 [label="Update boolean ArthurDating",color=orange];
		3628 -> 3630;
	3629 [label="Знаешь в чём факт? В твоей важности для меня. И если кто-то важен для тебя ещё, то они будут важны и для меня.",shape=box,color=blue];
		3629 -> 3631;
	3630 [label="Chat ends.",color=orange];
	3631 [label="Только. Не. Не Гекс. Хорошо? Не думаю, что переживу, если бы твоя новая пассия была «из семьи», так сказать.",shape=box,color=blue];
		3631 -> 3632;
	3632 [label="От этой мысли мне будут сниться кошмары.",shape=box,color=blue];
		3632 -> 3634;
		3632 -> 3633;
	3634 [label="Ха-ха. Я обещаю.",shape=box,color=red];
		3634 -> 3636;
	3633 [label="Если это уместно добавить, то я действительно думаю, что вы бы понравились друг другу.",shape=box,color=red];
		3633 -> 3635;
	3636 [label="Спасибо. И я надеюсь познакомиться. По… своим соображениям.",shape=box,color=blue];
		3636 -> 3637;
	3635 [label="И я надеюсь познакомиться. По… своим соображениям.",shape=box,color=blue];
		3635 -> 3637;
	3637 [label="+20 Chemistry",color=orange];
		3637 -> 3638;
	3638 [label="Береги себя там, ладно, любовь моя.",shape=box,color=blue];
		3638 -> 3639;
	3639 [label="Update boolean ArthurConsentComplete",color=orange];
		3639 -> 3640;
	3640 [label="Chat ends.",color=orange];
}