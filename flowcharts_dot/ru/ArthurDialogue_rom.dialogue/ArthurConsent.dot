	"Chat ends." [color=orange];
	j1569221931 [label="Check boolean ArthurConsentComplete",color=orange];
		j1569221931 -> "Chat ends." [label=true,color=green];
		j1569221931 -> j1879645505 [label=false,color=brown];
		j1569221931 -> j2318151778 [label=false,color=brown];
	j972778441 [label="Check boolean ArthurPolyamorySuccess",color=orange];
		j972778441 -> j1569221931 [label=true,color=green];
		j972778441 -> "Chat ends." [label=false,color=brown];
	j1879645505 [label="Артур, можно на несколько слов? [Спросить согласие нескольких партнёров.]",shape=box,color=red];
		j1879645505 -> j3700800264;
	j2318151778 [label="[Конец.]",shape=box,color=red];
		j2318151778 -> j3652224286;
	j3700800264 [label="Всегда. Что стряслось?",shape=box,color=blue];
		j3700800264 -> j2986692668;
	j3652224286 [label="Boolean ArthurConsentComplete is now true.",color=orange];
		j3652224286 -> "Chat ends.";
	j2986692668 [label="Да ничего особенного! Я просто хотел поговорить с тобой о ситуации, которая, надеюсь, не поставит тебя в неловкое положение.",shape=box,color=red];
		j2986692668 -> j1676130570;
	j1676130570 [label="Я не хочу ставить тебя в ситуацию, в которой ты будешь чувствовать себя плохо. Я знаю, мы это раньше не обсуждали. Так что если ты скажешь нет, это нормально. И я хочу, чтобы ты это знала.",shape=box,color=red];
		j1676130570 -> j1209754141;
	j1209754141 [label="То, что есть между нами, важно для меня. Очень важно. И оно настоящее. Я не хочу, чтобы были какие-то сомнения.",shape=box,color=red];
		j1209754141 -> j1708276555;
	j1708276555 [label="Ах. Я понимаю, к чему всё идёт. У тебя... тоже есть чувства к кому-то другому, я так понимаю?",shape=box,color=blue];
		j1708276555 -> j141012720;
		j1708276555 -> j550688294;
	j141012720 [label="Да. И понимаю, что это может быть непросто, но к тебе я не чувствую меньше.",shape=box,color=red];
		j141012720 -> j1850294522;
	j550688294 [label="Понимаю. Но, если задуматься, кажется, что на этом всё стоит закончить. [Расставание.]",shape=box,color=red];
		j550688294 -> j2378451702;
	j1850294522 [label="Дорогая, неужели ты правда думаешь, что я столько лет прослужил военным и не видел всех видов отношений, которые только могут быть?",shape=box,color=blue];
		j1850294522 -> j2806189989;
	j2378451702 [label="Если ты правда этого хочешь, что ж...",shape=box,color=blue];
		j2378451702 -> j3701883258;
	j2806189989 [label="Когда проводишь большую часть своей жизни на грани смерти, начинаешь ценить, что в жизни важно, а что нет.",shape=box,color=blue];
		j2806189989 -> j1881000285;
	j3701883258 [label="Boolean IsDating is now false.",color=orange];
		j3701883258 -> j913620630;
	j1881000285 [label="Я не знаю, чем это всё закончится. Но ты — важная часть моей жизни и рискну попробовать.",shape=box,color=blue];
		j1881000285 -> j3635861767;
	j913620630 [label="Boolean ArthurDating is now false.",color=orange];
		j913620630 -> "Chat ends.";
	j3635861767 [label="Я переживаю за тебя. И если тебе кто-то небезразличен, то я буду переживать и за того человека тоже.",shape=box,color=blue];
		j3635861767 -> j1246247181;
	j1246247181 [label="Только. Не. Не здесь... Не внутри торгового центра. Понятно?",shape=box,color=blue];
		j1246247181 -> j64334895;
	j64334895 [label="И без того всё достаточно запутано.",shape=box,color=blue];
		j64334895 -> j986200106;
		j64334895 -> j2769753956;
	j986200106 [label="Ха-ха. Я обещаю.",shape=box,color=red];
		j986200106 -> j215394242;
	j2769753956 [label="Если это уместно добавить, то я действительно думаю, что вы бы понравились друг другу.",shape=box,color=red];
		j2769753956 -> j334197079;
	j215394242 [label="Спасибо. И я надеюсь познакомиться. По… своим соображениям.",shape=box,color=blue];
		j215394242 -> j2868786483;
	j334197079 [label="И я надеюсь познакомиться. По… своим соображениям.",shape=box,color=blue];
		j334197079 -> j2868786483;
	j2868786483 [label="+20 Chemistry",color=orange];
		j2868786483 -> j2452419260;
	j2452419260 [label="Береги себя там, ладно, любовь моя.",shape=box,color=blue];
		j2452419260 -> j3652224286;
}