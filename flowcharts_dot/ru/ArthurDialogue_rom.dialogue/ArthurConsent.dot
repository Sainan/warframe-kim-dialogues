		j1518184391 -> j1569221931 [label=true,color=green];
		j1518184391 -> j972778441 [label=false,color=brown];
	"Chat ends." [color=orange];
	j1569221931 [label="Check boolean ArthurConsentComplete",color=orange];
		j1569221931 -> "Chat ends." [label=true,color=green];
		j1569221931 -> j331838224 [label=false,color=brown];
		j1569221931 -> j2318151778 [label=false,color=brown];
	j972778441 [label="Check boolean ArthurPolyamorySuccess",color=orange];
		j972778441 -> j1569221931 [label=true,color=green];
		j972778441 -> "Chat ends." [label=false,color=brown];
	j331838224 [label="Артур, можно на несколько слов? [Спросить согласие нескольких партнёров.]",shape=box,color=red];
		j331838224 -> j3475450636;
	j2318151778 [label="[Конец.]",shape=box,color=red];
		j2318151778 -> j3652224286;
	j3475450636 [label="Всегда. Что стряслось?",shape=box,color=blue];
		j3475450636 -> j1848493060;
	j3652224286 [label="Boolean ArthurConsentComplete is now true.",color=orange];
		j3652224286 -> "Chat ends.";
	j1848493060 [label="Да ничего особенного! Я просто хотел поговорить с тобой о ситуации, которая, надеюсь, не поставит тебя в неловкое положение.",shape=box,color=red];
		j1848493060 -> j1908834936;
	j1908834936 [label="Я не хочу ставить тебя в ситуацию, в которой ты будешь чувствовать себя плохо. Я знаю, мы это раньше не обсуждали. Так что если ты скажешь нет, это нормально. И я хочу, чтобы ты это знала.",shape=box,color=red];
		j1908834936 -> j4178613825;
	j4178613825 [label="То, что есть между нами, важно для меня. Очень важно. И оно настоящее. Я не хочу, чтобы были какие-то сомнения.",shape=box,color=red];
		j4178613825 -> j2503299524;
	j2503299524 [label="Ага. Понимаю, к чему ты клонишь. У тебя есть чувства к кому-то другому?",shape=box,color=blue];
		j2503299524 -> j3679944083;
		j2503299524 -> j550688294;
	j3679944083 [label="Да. И понимаю, что это может быть непросто, но к тебе я не чувствую меньше.",shape=box,color=red];
		j3679944083 -> j1994674950;
	j550688294 [label="Понимаю. Но, если задуматься, кажется, что на этом всё стоит закончить. [Расставание.]",shape=box,color=red];
		j550688294 -> j2378451702;
	j1994674950 [label="Дорогая, неужели ты правда думаешь, что я столько лет прослужил военным и не видел всех видов отношений, которые только могут быть?",shape=box,color=blue];
		j1994674950 -> j1696600911;
	j2378451702 [label="Если ты правда этого хочешь, что ж...",shape=box,color=blue];
		j2378451702 -> j3701883258;
	j1696600911 [label="Когда проводишь большую часть своей жизни на грани смерти, начинаешь ценить, что в жизни важно, а что нет.",shape=box,color=blue];
		j1696600911 -> j2914953962;
	j3701883258 [label="Boolean IsDating is now false.",color=orange];
		j3701883258 -> j913620630;
	j2914953962 [label="И перестаёшь бояться штрихов в песке. Я понимаю.",shape=box,color=blue];
		j2914953962 -> j3021874214;
	j913620630 [label="Boolean ArthurDating is now false.",color=orange];
		j913620630 -> "Chat ends.";
	j3021874214 [label="Знаешь в чём факт? В твоей важности для меня. И если кто-то важен для тебя ещё, то они будут важны и для меня.",shape=box,color=blue];
		j3021874214 -> j2284159280;
	j2284159280 [label="Только. Не. Не Гекс. Хорошо? Не думаю, что переживу, если бы твоя новая пассия была «из семьи», так сказать.",shape=box,color=blue];
		j2284159280 -> j1093802351;
	j1093802351 [label="От этой мысли мне будут сниться кошмары.",shape=box,color=blue];
		j1093802351 -> j986200106;
		j1093802351 -> j2769753956;
	j986200106 [label="Ха-ха. Я обещаю.",shape=box,color=red];
		j986200106 -> j215394242;
	j2769753956 [label="Если это уместно добавить, то я действительно думаю, что вы бы понравились друг другу.",shape=box,color=red];
		j2769753956 -> j334197079;
	j215394242 [label="Спасибо. И я надеюсь познакомиться. По… своим соображениям.",shape=box,color=blue];
		j215394242 -> j2868786483;
	j334197079 [label="И я надеюсь познакомиться. По… своим соображениям.",shape=box,color=blue];
		j334197079 -> j2868786483;
	j2868786483 [label="+20 Chemistry",color=orange];
		j2868786483 -> j2452419260;
	j2452419260 [label="Береги себя там, ладно, любовь моя.",shape=box,color=blue];
		j2452419260 -> j3652224286;
}