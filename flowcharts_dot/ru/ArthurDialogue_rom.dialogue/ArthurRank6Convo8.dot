		j2791873418 -> j3136308736;
	j3136308736 [label="Водяной вообще не врубается, как работает Перенос. ",shape=box,color=blue];
		j3136308736 -> j3721524364;
	j3721524364 [label="Ты для него как Кент Кларк и Мегаблок, он никогда не видел двух твоих варфреймов в одном месте.",shape=box,color=blue];
		j3721524364 -> j1169536750;
