		j1169536750 -> j1254855977;
		j1169536750 -> j1616924002;
	j1254855977 [label="То, чего он не знает, *может* причинить ему боль, верно? <RETRO_EMOJI_COOLARMSUP>",shape=box,color=red];
		j1254855977 -> j2006589733;
	j1616924002 [label="ЛОЛ!! Я даже не думал об этом.",shape=box,color=red];
