digraph {
	graph [fontname="Roboto Condensed"];
	node [fontname="Roboto Condensed"];
	edge [fontname="Roboto Condensed"];

	"ArthurRank6Convo4 begins." [color=orange];
		"ArthurRank6Convo4 begins." -> j3612501926;
	j3612501926 [label="Странный вопрос. А в космосе игрушки есть вообще?",shape=box,color=blue];
		j3612501926 -> j1438647514;
		j3612501926 -> j815511707;
	j1438647514 [label="Типа, детские? Ну да, конечно.",shape=box,color=red];
		j1438647514 -> j3312504604;
	j815511707 [label="Какие именно... игрушки?",shape=box,color=red];
		j815511707 -> j3540165906;
	j3312504604 [label="Хех. Серьёзно?",shape=box,color=blue];
		j3312504604 -> j2245415869;
	j3540165906 [label="ОХ, СОЛ. Да не это я имел в виду, и ты это прекрасно знаешь!",shape=box,color=blue];
		j3540165906 -> j1050505982;
	j2245415869 [label="Сложно, знаешь ли, представить себе, что там через хреналион лет в будущем,",shape=box,color=blue];
		j2245415869 -> j1457453010;
	j1050505982 [label="Я про обычные игрушки. Куклы. Солдатики. Всякое такое.",shape=box,color=blue];
		j1050505982 -> j1697438969;
		j1050505982 -> j4014312697;
	j1457453010 [label="Дети всё так же сидят, разыгрывают сцены с фигурками, играют в «бандитов» или «спасти принцессу».",shape=box,color=blue];
		j1457453010 -> j2890650379;
		j1457453010 -> j2882363804;
		j1457453010 -> j1009808776;
	j1697438969 [label="Да подкалываю я тебя. :P",shape=box,color=red];
		j1697438969 -> j2894936082;
	j4014312697 [label="Нет, не было. [Конец.]",shape=box,color=red];
		j4014312697 -> "Chat ends.";
	j2890650379 [label="С чего вдруг такая тема?",shape=box,color=red];
		j2890650379 -> j1975334087;
	j2882363804 [label="Ты с чем рос, во что играл?",shape=box,color=red];
		j2882363804 -> j4186908146;
	j1009808776 [label="Названия разные, а суть та же. Были у меня игрушки.",shape=box,color=red];
		j1009808776 -> j720494720;
	j2894936082 [label="Ага, конечно были. ",shape=box,color=red];
		j2894936082 -> j3312504604;
	"Chat ends." [color=orange];
	j1975334087 [label="Я просто смотрел, как Амир режется в свои автоматы. ",shape=box,color=blue];
		j1975334087 -> j316523179;
	j4186908146 [label="Знаешь, прикольно так осознать, что несмотря на все эти культурные заморочки, дети всё равно просто… садятся и играют.",shape=box,color=blue];
		j4186908146 -> j3635723211;
	j720494720 [label="Во что, например?",shape=box,color=blue];
		j720494720 -> j3899938324;
		j720494720 -> j2729998277;
	j316523179 [label="И вот думаю - сколько бы я отдал, чтобы снова так радоваться, как в детстве.",shape=box,color=blue];
		j316523179 -> j1764654665;
	j3635723211 [label="У меня была экшн-фигурка. Экшн Ангус. Солдат. Неудивительно, ага.",shape=box,color=blue];
		j3635723211 -> j3341537917;
	j3899938324 [label="Были у меня всякие фигурки, мягкие игрушки, кубики. Стандартный набор. ",shape=box,color=red];
		j3899938324 -> j4186908146;
	j2729998277 [label="У меня была вот эта — думаю, ее можно назвать фигуркой — маленький Дакс. Я её по книжке назвал, Доминус Тракс.",shape=box,color=red];
		j2729998277 -> j3216636660;
	j1764654665 [label="Я никогда не гнал на Аои, Амира или даже Кайю за то, что они находят веселье в \"детских\" вещах. Меня это не парит.",shape=box,color=blue];
		j1764654665 -> j2752757779;
	j3341537917 [label="Однажды во время празднования солнцестояния группа старших мальчишек украла его у меня вместе с кучей других моих игрушек и, ну...",shape=box,color=blue];
		j3341537917 -> j1529577735;
	j3216636660 [label="Ох, ну всё, Я должен был знать. Мне так жаль, что я поднял эту тему.",shape=box,color=blue];
		j3216636660 -> j3681342826;
		j3216636660 -> j3598221891;
	j2752757779 [label="Иногда мне кажется, что та часть меня, что могла вот так радоваться, сдохла давно.",shape=box,color=blue];
		j2752757779 -> j506596725;
	j1529577735 [label="Это долгая история. Короче? Я был \"слишком взрослый\", сказали они, чтобы играть с куклами. Это был последний раз, когда я играл с игрушками.",shape=box,color=blue];
		j1529577735 -> j523097820;
	j3681342826 [label="Не лучшая тема, если честно.",shape=box,color=red];
		j3681342826 -> j2490223638;
	j3598221891 [label="Нормально. Ты ж не виноват.",shape=box,color=red];
		j3598221891 -> j1313353450;
	j506596725 [label="Немного грустно, не правда ли? Мы говорим детям любить что-то, а потом «хватит, ты ж взрослый».",shape=box,color=blue];
		j506596725 -> j1307540301;
		j506596725 -> j3240645618;
	j523097820 [label="На днях я наблюдал, как Амир играет в одну из своих игр. Видно, как сильно он к этому привязан. Сколько радости. И я немного завидовал, что у меня в жизни нет ничего подобного.",shape=box,color=blue];
		j523097820 -> j506596725;
	j2490223638 [label="Теперь чувствую себя полным болваном.",shape=box,color=blue];
		j2490223638 -> "Chat ends.";
	j1313353450 [label="У нас были обычные игрушки, которые вы, наверное, ожидаете увидеть. Кубики, мягкие игрушки, фигурки, куклы.",shape=box,color=red];
		j1313353450 -> j3790922126;
	j1307540301 [label="Не знаю. Всем нам когда-то приходится взрослеть. Не спрячешься за фантазией. Я усвоил это на собственном горьком опыте.",shape=box,color=red];
		j1307540301 -> j909679603;
	j3240645618 [label="Я думаю, что жизнь может быть уродливой, больной и короткой. И мы должны наполнить её как можно большим количеством веселья, смеха и любви.",shape=box,color=red];
		j3240645618 -> j4058961371;
	j3790922126 [label="Ну у меня всё ещё веселее, благодаря всей этой... теме с Бездной.",shape=box,color=red];
		j3790922126 -> j4186908146;
	j909679603 [label="Ты прав. Проблема не в игрушках, а когда они становятся заменой реальности. Я не про это.",shape=box,color=blue];
		j909679603 -> j761319571;
	j4058961371 [label="Ты прав. И я надеюсь, что мы будем помнить это, когда будем двигаться дальше вместе... в том, в чём мы находимся.",shape=box,color=blue];
		j4058961371 -> j761319571;
	j761319571 [label="Недавно застал Элеонору, Велимира, Аои и Амира, играющими в прятки с Флер и Лиззи. (Куинси сказал, что ему нельзя играть, потому что этот ублюдок жульничает и использует свой прицел, чтобы видеть сквозь стены.)",shape=box,color=blue];
		j761319571 -> j3800410113;
	j3800410113 [label="Они все смотрели на меня, беспокоясь, что я расстроюсь. Я застал их за бездельем, когда они должны были заниматься чем-то полезным.",shape=box,color=blue];
		j3800410113 -> j1950184734;
	j1950184734 [label="Я был больше расстроен, что меня не пригласили. Хех. Но пришлось включить «взрослого» и притвориться, что я расстроен, что посты остались без людей и т. д.",shape=box,color=blue];
		j1950184734 -> j1477205810;
	j1477205810 [label="Но у Амира есть свои игры. У Аои есть On-lyne. Даже у Кайи есть её наклейки и ее Jinymon, хоть жизнь её и заставила повзрослеть слишком рано.",shape=box,color=blue];
		j1477205810 -> j3301634371;
		j1477205810 -> j3552000496;
	j3301634371 [label="Ты к чему ведёшь?",shape=box,color=red];
		j3301634371 -> j252518233;
	j3552000496 [label="Думаю, ты мог бы это вернуть, если попытаешься. Радость от игр и игрушек, я имею в виду.",shape=box,color=red];
		j3552000496 -> j1416824816;
	j252518233 [label="Честно? Даже не знаю. Просто чувствую, будто чего-то давно не хватает, что исчезло из моей жизни очень давно.",shape=box,color=blue];
		j252518233 -> j2498305957;
	j1416824816 [label="Уже слышу смех в ответ. Но, наверно, именно он меня и сдерживает, не так ли? Стыд.",shape=box,color=blue];
		j1416824816 -> j4185314985;
	j2498305957 [label="Не знаю, можно ли это вернуть. Даже если перебороть стыд. Но кто знает. Может, если дать себе время.",shape=box,color=blue];
		j2498305957 -> "Chat ends.";
	j4185314985 [label="Не уверен, что получится. Даже если пробиться сквозь стыд. Но кто знает. С достаточным количеством циклов, возможно, всё возможно.",shape=box,color=blue];
		j4185314985 -> "Chat ends.";
}