digraph {
	3433 [label="ArthurRank6Convo4 begins.",color=orange];
		3433 -> 3434;
	3434 [label="Странный вопрос. А в космосе игрушки есть вообще?",shape=box,color=blue];
		3434 -> 3435;
		3434 -> 3436;
	3435 [label="Типа, детские? Ну да, конечно.",shape=box,color=red];
		3435 -> 3437;
	3436 [label="Какие именно... игрушки?",shape=box,color=red];
		3436 -> 3438;
	3437 [label="Хех. Серьёзно?",shape=box,color=blue];
		3437 -> 3439;
	3438 [label="ОХ, СОЛ. Да не это я имел в виду, и ты это прекрасно знаешь!",shape=box,color=blue];
		3438 -> 3440;
	3439 [label="Сложно, знаешь ли, представить себе, что там через хреналион лет в будущем,",shape=box,color=blue];
		3439 -> 3441;
	3440 [label="Я про обычные игрушки. Куклы. Солдатики. Всякое такое.",shape=box,color=blue];
		3440 -> 3442;
		3440 -> 3448;
	3441 [label="Дети всё так же сидят, разыгрывают сцены с фигурками, играют в «бандитов» или «спасти принцессу».",shape=box,color=blue];
		3441 -> 3444;
		3441 -> 3445;
		3441 -> 3446;
	3442 [label="Да подкалываю я тебя. :P",shape=box,color=red];
		3442 -> 3447;
	3448 [label="Нет, не было. [Конец.]",shape=box,color=red];
		3448 -> 3452;
	3444 [label="С чего вдруг такая тема?",shape=box,color=red];
		3444 -> 3449;
	3445 [label="Ты с чем рос, во что играл?",shape=box,color=red];
		3445 -> 3450;
	3446 [label="Названия разные, а суть та же. Были у меня игрушки.",shape=box,color=red];
		3446 -> 3451;
	3447 [label="Ага, конечно были. ",shape=box,color=red];
		3447 -> 3437;
	3452 [label="Chat ends.",color=orange];
	3449 [label="Я просто смотрел, как Амир режется в свои автоматы. ",shape=box,color=blue];
		3449 -> 3453;
	3450 [label="Знаешь, прикольно так осознать, что несмотря на все эти культурные заморочки, дети всё равно просто… садятся и играют.",shape=box,color=blue];
		3450 -> 3454;
	3451 [label="Во что, например?",shape=box,color=blue];
		3451 -> 3455;
		3451 -> 3456;
	3453 [label="И вот думаю - сколько бы я отдал, чтобы снова так радоваться, как в детстве.",shape=box,color=blue];
		3453 -> 3457;
	3454 [label="У меня была экшн-фигурка. Экшн Ангус. Солдат. Неудивительно, ага.",shape=box,color=blue];
		3454 -> 3458;
	3455 [label="Были у меня всякие фигурки, мягкие игрушки, кубики. Стандартный набор. ",shape=box,color=red];
		3455 -> 3450;
	3456 [label="У меня была вот эта — думаю, ее можно назвать фигуркой — маленький Дакс. Я её по книжке назвал, Доминус Тракс.",shape=box,color=red];
		3456 -> 3459;
	3457 [label="Я никогда не гнал на Аои, Амира или даже Кайю за то, что они находят веселье в \"детских\" вещах. Меня это не парит.",shape=box,color=blue];
		3457 -> 3460;
	3458 [label="Однажды во время празднования солнцестояния группа старших мальчишек украла его у меня вместе с кучей других моих игрушек и, ну...",shape=box,color=blue];
		3458 -> 3461;
	3459 [label="Ох, ну всё, Я должен был знать. Мне так жаль, что я поднял эту тему.",shape=box,color=blue];
		3459 -> 3462;
		3459 -> 3463;
	3460 [label="Иногда мне кажется, что та часть меня, что могла вот так радоваться, сдохла давно.",shape=box,color=blue];
		3460 -> 3464;
	3461 [label="Это долгая история. Короче? Я был \"слишком взрослый\", сказали они, чтобы играть с куклами. Это был последний раз, когда я играл с игрушками.",shape=box,color=blue];
		3461 -> 3465;
	3462 [label="Не лучшая тема, если честно.",shape=box,color=red];
		3462 -> 3466;
	3463 [label="Нормально. Ты ж не виноват.",shape=box,color=red];
		3463 -> 3467;
	3464 [label="Немного грустно, не правда ли? Мы говорим детям любить что-то, а потом «хватит, ты ж взрослый».",shape=box,color=blue];
		3464 -> 3468;
		3464 -> 3469;
	3465 [label="На днях я наблюдал, как Амир играет в одну из своих игр. Видно, как сильно он к этому привязан. Сколько радости. И я немного завидовал, что у меня в жизни нет ничего подобного.",shape=box,color=blue];
		3465 -> 3464;
	3466 [label="Теперь чувствую себя полным болваном.",shape=box,color=blue];
		3466 -> 3470;
	3467 [label="У нас были обычные игрушки, которые вы, наверное, ожидаете увидеть. Кубики, мягкие игрушки, фигурки, куклы.",shape=box,color=red];
		3467 -> 3471;
	3468 [label="Не знаю. Всем нам когда-то приходится взрослеть. Не спрячешься за фантазией. Я усвоил это на собственном горьком опыте.",shape=box,color=red];
		3468 -> 3472;
	3469 [label="Я думаю, что жизнь может быть уродливой, больной и короткой. И мы должны наполнить её как можно большим количеством веселья, смеха и любви.",shape=box,color=red];
		3469 -> 3473;
	3470 [label="Chat ends.",color=orange];
	3471 [label="Ну у меня всё ещё веселее, благодаря всей этой... теме с Бездной.",shape=box,color=red];
		3471 -> 3450;
	3472 [label="Ты прав. Проблема не в игрушках, а когда они становятся заменой реальности. Я не про это.",shape=box,color=blue];
		3472 -> 3474;
	3473 [label="Ты прав. И я надеюсь, что мы будем помнить это, когда будем двигаться дальше вместе... в том, в чём мы находимся.",shape=box,color=blue];
		3473 -> 3474;
	3474 [label="Недавно застал Элеонору, Велимира, Аои и Амира, играющими в прятки с Флер и Лиззи. (Куинси сказал, что ему нельзя играть, потому что этот ублюдок жульничает и использует свой прицел, чтобы видеть сквозь стены.)",shape=box,color=blue];
		3474 -> 3475;
	3475 [label="Они все смотрели на меня, беспокоясь, что я расстроюсь. Я застал их за бездельем, когда они должны были заниматься чем-то полезным.",shape=box,color=blue];
		3475 -> 3476;
	3476 [label="Я был больше расстроен, что меня не пригласили. Хех. Но пришлось включить «взрослого» и притвориться, что я расстроен, что посты остались без людей и т. д.",shape=box,color=blue];
		3476 -> 3477;
	3477 [label="Но у Амира есть свои игры. У Аои есть On-lyne. Даже у Кайи есть её наклейки и ее Jinymon, хоть жизнь её и заставила повзрослеть слишком рано.",shape=box,color=blue];
		3477 -> 3478;
		3477 -> 3479;
	3478 [label="Ты к чему ведёшь?",shape=box,color=red];
		3478 -> 3480;
	3479 [label="Думаю, ты мог бы это вернуть, если попытаешься. Радость от игр и игрушек, я имею в виду.",shape=box,color=red];
		3479 -> 3481;
	3480 [label="Честно? Даже не знаю. Просто чувствую, будто чего-то давно не хватает, что исчезло из моей жизни очень давно.",shape=box,color=blue];
		3480 -> 3482;
	3481 [label="Уже слышу смех в ответ. Но, наверно, именно он меня и сдерживает, не так ли? Стыд.",shape=box,color=blue];
		3481 -> 3483;
	3482 [label="Не знаю, можно ли это вернуть. Даже если перебороть стыд. Но кто знает. Может, если дать себе время.",shape=box,color=blue];
		3482 -> 3484;
	3483 [label="Не уверен, что получится. Даже если пробиться сквозь стыд. Но кто знает. С достаточным количеством циклов, возможно, всё возможно.",shape=box,color=blue];
		3483 -> 3485;
	3484 [label="Chat ends.",color=orange];
	3485 [label="Chat ends.",color=orange];
}