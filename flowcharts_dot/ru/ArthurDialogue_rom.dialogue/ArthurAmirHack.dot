	2928 [label="br00dsw0rd: Слушай, мы же говорили всего час назад о...",shape=box,color=blue];
		2928 -> 2936;
	2934 [label="br00dsw0rd: С каждым повторением это становится всё менее интересно...",shape=box,color=blue];
		2934 -> 2936;
	2935 [label="br00dsw0rd: Какая ещё команда...",shape=box,color=blue];
		2935 -> 2936;
	2936 [label="br00dsw0rd: Что происходит? Ты ведёшь себя странно.",shape=box,color=blue];
		2936 -> 2937;
		2936 -> 2938;
	2937 [label="... Ничего не происходит.",shape=box,color=red];
		2937 -> 2939;
	2938 [label="Амиру опять скучно. Посмотри на свой ник.",shape=box,color=red];
		2938 -> 2941;
	2939 [label="br00dsw0rd: Я тебе не верю, я...",shape=box,color=blue];
		2939 -> 2940;
	2941 [label="br00dsw0rd: «BROODSWORD»... Какой ещё «размышляющий меч»?!",shape=box,color=blue];
