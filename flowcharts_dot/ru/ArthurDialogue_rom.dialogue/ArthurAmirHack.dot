		2942 -> 2943;
		2942 -> 2944;
		2942 -> 2945;
	2943 [label=":| Дружище. Твой ник говорит об обратном.",shape=box,color=red];
		2943 -> 2946;
	2944 [label="Именно это ты и делаешь.",shape=box,color=red];
		2944 -> 2947;
