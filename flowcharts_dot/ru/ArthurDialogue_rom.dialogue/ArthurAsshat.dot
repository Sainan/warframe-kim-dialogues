		j3266249160 -> j1392785148;
	j3203027517 [label="Я— подожди. Прости. Нет. Всё было сказано всерьёз. Продолжай.",shape=box,color=red];
		j3203027517 -> j3266249160;
	j513427682 [label="У меня какое-то больное  чувство юмора.",shape=box,color=red];
