	j2533691464 [label="Boolean ArthurNoDate is now true.",color=orange];
		j2533691464 -> "Chat ends.";
	j642122048 [label="Я всю жизнь прожил одной ногой в могиле. Я всегда был все равно что мёртв.",shape=box,color=blue];
		j642122048 -> j1811370297;
	j1811370297 [label="И это никогда не было столь правдой, как сейчас. Посмотри на меня. Я серьёзно, *посмотри на меня*!",shape=box,color=blue];
		j1811370297 -> j1250604828;
	j1250604828 [label="Я уже даже не *человек*.",shape=box,color=blue];
		j1250604828 -> j1355753907;
	j1355753907 [label="Так... у нас была возможность узнать друг друга. Мы немного сблизились, да? Ты... заставляешь меня смеяться.",shape=box,color=blue];
		j1355753907 -> j774539793;
	j774539793 [label="Ты заставляешь меня улыбаться чаще, чем за последние годы.",shape=box,color=blue];
		j774539793 -> j737273633;
	j737273633 [label="Но как ты можешь хотеть быть с кем-то… вроде меня?",shape=box,color=blue];
