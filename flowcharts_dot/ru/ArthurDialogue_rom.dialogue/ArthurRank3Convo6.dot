digraph {
	1188 [label="ArthurRank3Convo6 begins.",color=orange];
		1188 -> 1189;
	1189 [label="Давай поиграем в игру «Факты-заложники».",shape=box,color=blue];
		1189 -> 1190;
		1189 -> 1191;
	1190 [label="ХА-ха что?",shape=box,color=red];
		1190 -> 1192;
	1191 [label="Прошлое странное.",shape=box,color=red];
		1191 -> 1192;
	1192 [label="Хех. Так вот. Это игра, в которую я играл в армии.",shape=box,color=blue];
		1192 -> 1193;
	1193 [label="Ты расскажешь мне неловкий факт о себе, а я расскажу тебе неловкий факт о себе.",shape=box,color=blue];
		1193 -> 1194;
	1194 [label="Мы держим факты друг друга в заложниках.",shape=box,color=blue];
		1194 -> 1195;
	1195 [label="Факты-заложники. Это «упражнение на доверие». Я даже начну первым.",shape=box,color=blue];
		1195 -> 1196;
		1195 -> 1197;
		1195 -> 1198;
	1196 [label="Обычно, я думаю, что нужно пройти на курс завязывания верёвок… но ладно.",shape=box,color=red];
		1196 -> 1202;
	1197 [label="Конечно. Почему бы и нет.",shape=box,color=red];
		1197 -> 1202;
	1198 [label="Нет, я не хочу играть.",shape=box,color=red];
		1198 -> 1199;
	1202 [label="Вот мой: у меня есть плюшевый мишка по имени Себастьян.",shape=box,color=blue];
		1202 -> 1203;
	1199 [label="Как тебе будет угодно.",shape=box,color=blue];
		1199 -> 1200;
	1203 [label="Теперь, прежде чем у тебя в голове возникнет мысль, что я сплю с ним ночью, скажу сразу: я этого не делаю.",shape=box,color=blue];
		1203 -> 1204;
	1200 [label="Chat ends.",color=orange];
	1204 [label="Я нашёл его много лет назад во время выполнения задания в разбомбленном жилом квартале.",shape=box,color=blue];
		1204 -> 1205;
	1205 [label="Я держу его на полке. А когда мне больше не с кем поговорить...",shape=box,color=blue];
		1205 -> 1206;
	1206 [label="Я с ним разговариваю. Старый ворчун. Не даёт мне сойти с ума.",shape=box,color=blue];
		1206 -> 1201;
		1206 -> 1207;
		1206 -> 1208;
	1201 [label="Я на полу от смеха.",shape=box,color=red];
		1201 -> 1214;
	1207 [label="Это... болезненно мило.",shape=box,color=red];
		1207 -> 1211;
	1208 [label="Могу ли я когда-нибудь обнять Себастьяна?",shape=box,color=red];
		1208 -> 1210;
	1214 [label="Ага-ага.",shape=box,color=blue];
		1214 -> 1213;
	1211 [label="Мне кажется, что-то немножко умерло у меня внутри.",shape=box,color=red];
		1211 -> 1212;
	1210 [label="+20 Chemistry",color=orange];
		1210 -> 1209;
	1213 [label="Я наверное описаюсь, я так сильно смеюсь, лол",shape=box,color=red];
		1213 -> 1215;
	1212 [label="Ты полон сюрпризов, Артур.",shape=box,color=red];
		1212 -> 1217;
	1209 [label="Почему бы и нет.",shape=box,color=blue];
		1209 -> 1218;
	1215 [label="Да, я понял.",shape=box,color=blue];
		1215 -> 1218;
	1217 [label="+20 Chemistry",color=orange];
		1217 -> 1216;
	1218 [label="Твоя очередь.",shape=box,color=blue];
		1218 -> 1219;
		1218 -> 1220;
		1218 -> 1221;
		1218 -> 1222;
	1216 [label="Хех.",shape=box,color=blue];
		1216 -> 1218;
	1219 [label="В Дувири мне приходилось постоянно вызывать спальню своего детства, потому что мне хотелось где-нибудь спрятаться.",shape=box,color=red];
		1219 -> 1227;
	1220 [label="Однажды, когда Лодун обезглавил меня, моя голова отлетела с такой силой, что застряла на дереве!",shape=box,color=red];
		1220 -> 1226;
	1221 [label="Мне потребовалось шестьсот восемьдесят семь кругов, чтобы научиться правильно ездить на кайте.",shape=box,color=red];
		1221 -> 1225;
	1222 [label="Нет, я пас. Но спасибо, что рассказал мне о Себастьяне.",shape=box,color=red];
		1222 -> 1223;
	1227 [label="Я не смогу сказать сколько раз была вызвана спальня к тому времени, как пришла идея, как оттуда выбраться.",shape=box,color=red];
		1227 -> 1228;
	1226 [label="Ты знаешь, как долго голова остаётся живой после того, как её отрубили? Потому что *Я ЗНАЮ*. ХА-ХА!",shape=box,color=red];
		1226 -> 1228;
	1225 [label="Я веду счёт всем своим сломанным костям. Думаю, у меня до сих пор где-то есть этот список.",shape=box,color=red];
		1225 -> 1228;
	1223 [label="Я должен был догадаться.",shape=box,color=blue];
		1223 -> 1224;
	1228 [label="О Сол... Мне кажется, ты не понимаешь правила игры.",shape=box,color=blue];
		1228 -> 1229;
	1224 [label="Chat ends.",color=orange];
	1229 [label="Но, э-э, спасибо за попытку.",shape=box,color=blue];
		1229 -> 978;
	978 [label="Chat ends.",color=orange];
