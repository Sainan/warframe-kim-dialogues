	j2533691464 [label="Boolean ArthurNoDate is now true.",color=orange];
		j2533691464 -> "Chat ends.";
	j2470476464 [label="Ну что ж. Сейчас уже нет смысла переживать из-за этого. Я… должен признать, ты не выходишь у меня из головы. Если хочешь попробовать снова, я готов дать этому шанс.",shape=box,color=blue];
