		j3496880591 -> j2110959590;
	j2577036357 [label="…Кто-нибудь когда-нибудь говорил тебе, что у тебя *не все дома*?",shape=box,color=blue];
		j2577036357 -> j2533691464;
	j3685777949 [label="Иногда я просто не знаю, как с тобой говорить.",shape=box,color=blue];
		j3685777949 -> j2470476464;
	j2110959590 [label="Ну что ж. Рад, что все это уладили. Начнём?",shape=box,color=blue];
