digraph {
	"ArthurRank6Convo3 begins." [color=orange];
		"ArthurRank6Convo3 begins." -> j2932425517;
	j2932425517 [label="На днях я поймал себя на разговоре с гитарой.",shape=box,color=blue];
		j2932425517 -> j1585056226;
		j2932425517 -> j887623310;
	j1585056226 [label="Я, если честно, не в восторге.",shape=box,color=red];
		j1585056226 -> j423439561;
	j887623310 [label="Лиззи? И как прошло?",shape=box,color=red];
		j887623310 -> j402328318;
	j423439561 [label="Честно? Она мне даже нравится. Если смириться со... странностью этого?",shape=box,color=blue];
		j423439561 -> j3929644964;
	j402328318 [label="Лучше, чем я ожидал. Она мне правда нравится.",shape=box,color=blue];
		j402328318 -> j3929644964;
	j3929644964 [label="К тому же,",shape=box,color=blue];
		j3929644964 -> j3034655821;
	j3034655821 [label="Похоже, она с Элеонорой всё время хихикают над шутками, которых больше никто не слышит.",shape=box,color=blue];
		j3034655821 -> j3801573765;
	j3801573765 [label="Я решил, что стоит уже представиться как следует.",shape=box,color=blue];
		j3801573765 -> j2773176714;
	j2773176714 [label="У неё много полезных наблюдений. А Флэр просто душка. Если честно, вся та компания в баре, как глоток свежего воздуха. ",shape=box,color=blue];
		j2773176714 -> j329351775;
	j329351775 [label="Ну, в переносном смысле.",shape=box,color=blue];
		j329351775 -> j2880866179;
		j329351775 -> j178914961;
		j329351775 -> j1071626698;
	j2880866179 [label="Уже устал от Гекса?",shape=box,color=red];
		j2880866179 -> j1640634876;
	j178914961 [label="Какие выводы она сделала?",shape=box,color=red];
		j178914961 -> j2568827923;
	j1071626698 [label="Рад, что у тебя появляются друзья. хаха ",shape=box,color=red];
		j1071626698 -> j2694482843;
	j1640634876 [label="Что? Нет! Конечно, нет.",shape=box,color=blue];
		j1640634876 -> j3553297233;
	j2568827923 [label="Любопытные. Вроде того, сколько раз год уже успел повториться.",shape=box,color=blue];
		j2568827923 -> j1970982612;
	j2694482843 [label="Наверное, просто приятно общаться с кем-то, с кем не прошёл через весь этот ад.",shape=box,color=blue];
		j2694482843 -> j2157116202;
	j3553297233 [label="Гекс это моя семья. Моя команда. Ты же знаешь.",shape=box,color=blue];
		j3553297233 -> j2694482843;
	j1970982612 [label="Сколько раз я мог забыть или не забыть прошедшие годы. Как она живет... вне времени? А как мы увы, нет.",shape=box,color=blue];
		j1970982612 -> j3397300665;
	j2157116202 [label="Я не знаю, звучит ли это вообще логично. Я их знаю, я им верю, просто мы с ними ещё не прошли через всё пекло и обратно.",shape=box,color=blue];
		j2157116202 -> j880531872;
	j3397300665 [label="И прежде чем ты что-нибудь скажешь, нет. Я не хочу знать. У меня нет права знать.",shape=box,color=blue];
		j3397300665 -> j3523920137;
	j880531872 [label="Так что порой легче просто молча посидеть и выпить с ними.",shape=box,color=blue];
		j880531872 -> j2385881495;
		j880531872 -> j714448167;
		j880531872 -> j3848529131;
	j3523920137 [label="Я думаю, я просто хочу сказать - хочешь ты это сделать или нет? всё нормально. Я не буду тебя за это осуждать.",shape=box,color=blue];
		j3523920137 -> j3778099812;
	j2385881495 [label="Мне такой вариант, если честно, никогда не выпадал.",shape=box,color=red];
		j2385881495 -> j2584978817;
	j714448167 [label="Ага. Понимаю.",shape=box,color=red];
		j714448167 -> j3622736183;
	j3848529131 [label="Помогает ещё и то, что некоторые из них постарше и с военным опытом.",shape=box,color=red];
		j3848529131 -> j2994482712;
	j3778099812 [label="Эта ситуация, в которой мы сейчас? Это не нормально. Мы не для такого созданы - я про людей.",shape=box,color=blue];
		j3778099812 -> j1905757084;
	j2584978817 [label="Я полагаю нет.",shape=box,color=blue];
		j2584978817 -> j1019874264;
	j3622736183 [label="Здесь нет столько... тяжести. Столько прошлого. Амир бы назвал это «багажом».",shape=box,color=blue];
		j3622736183 -> j1019874264;
	j2994482712 [label="Сол. Да уж. Сначала я не был уверен, что и думать о либертарианцах. Но теперь? Очень рад, что они здесь.",shape=box,color=blue];
		j2994482712 -> j1019874264;
	j1905757084 [label="Нет инструкции, как поступать в таких ситуациях. Что бы тобой не было бы выбрано, я уверен, у тебя будут на это веские причины.",shape=box,color=blue];
		j1905757084 -> j2674809731;
	j1019874264 [label="Но всё это заставило меня задуматься.",shape=box,color=blue];
		j1019874264 -> j276164060;
		j1019874264 -> j1659235479;
	j2674809731 [label="Check boolean ArthurDating",color=orange];
		j2674809731 -> j2563695929 [label=true,color=green];
		j2674809731 -> j808495140 [label=false,color=brown];
	j276164060 [label="Ух ох.",shape=box,color=red];
		j276164060 -> j2410323911;
	j1659235479 [label="О чём?",shape=box,color=red];
		j1659235479 -> j1353846057;
	j2563695929 [label="Я люблю тебя. И даже если я забуду это? Даже если ты выберешь другой путь? Это нормально.",shape=box,color=blue];
		j2563695929 -> j135112753;
	j808495140 [label="Я доверяю тебе свою жизнь. И ничто этого не изменит. Даже если я забуду об этом на некоторое время.",shape=box,color=blue];
		j808495140 -> j1897842598;
	j2410323911 [label="Хех. Выслушай меня. Речь сейчас о тебе.",shape=box,color=blue];
		j2410323911 -> j3453402359;
	j1353846057 [label="Ты. ",shape=box,color=blue];
		j1353846057 -> j3453402359;
	j135112753 [label="До твоего прихода я не думаю, что смог бы это принять. Мне было бы слишком страшно потерять тебя. Потерять всё это.",shape=box,color=blue];
		j135112753 -> j2150737722;
	j1897842598 [label="До твоего прихода я не думаю, что смог бы это принять. Мне было бы слишком страшно потерять часть самого себя.",shape=box,color=blue];
		j1897842598 -> j2150737722;
	j3453402359 [label="И вся эта... временная петля. И это заставляет меня задуматься обо всех тех 1999-х, которые я, возможно, не помню.",shape=box,color=blue];
		j3453402359 -> j595594439;
		j3453402359 -> j1573278741;
		j3453402359 -> j2548961214;
	j2150737722 [label="Я бы вцепился в это, как отчаявшийся человек в спасательный плот посреди моря. Но, может, я уже был в этой петле достаточно раз, или... может, всё дело в тебе. Я не знаю.",shape=box,color=blue];
		j2150737722 -> j519396822;
	j595594439 [label="Всё, что тебе наговорила гитара, то пустой звук, клянусь.",shape=box,color=red];
		j595594439 -> j2095480204;
	j1573278741 [label="У меня проблемы?",shape=box,color=red];
		j1573278741 -> j2095480204;
	j2548961214 [label="Я... не думаю, что нам стоит в это лезть, Артур.",shape=box,color=red];
		j2548961214 -> j2095480204;
	j519396822 [label="Счастье, которое я чувствую сейчас с тобой - это спокойствие - важнее для меня прямо сейчас, чем уверенность, что это будет навсегда.",shape=box,color=blue];
		j519396822 -> j190417819;
	j2095480204 [label="Подожди секунду, ладно? Ты же знаешь, я печатаю медленнее тебя.",shape=box,color=blue];
		j2095480204 -> j1592423099;
	j190417819 [label="Если есть что-то, чему ты учишься в жизни, будучи солдатом, так это тому, что всё мимолетно.",shape=box,color=blue];
		j190417819 -> j2888143882;
	j1592423099 [label="Я вот к чему веду:",shape=box,color=blue];
		j1592423099 -> j4194132711;
	j2888143882 [label="Одну секунду здесь, в следующую уже нет. Я, наверно, просто смирился с этим. Окончательно.",shape=box,color=blue];
		j2888143882 -> j2447118873;
	j4194132711 [label="Заставил ли ты меня или остальных членов Гекса забыть наши прошлые взаимодействия? Да норм.",shape=box,color=blue];
		j4194132711 -> j2348854438;
	j2447118873 [label="Так что, наше время вместе закончится, если ты ударишь кулаком по полу, и я все забуду?",shape=box,color=blue];
		j2447118873 -> j3567777484;
	j2348854438 [label="Я не буду держать на тебя зла.",shape=box,color=blue];
		j2348854438 -> j3778099812;
	j3567777484 [label="Или если Безразличие в какой-то момент поймает тебя врасплох?",shape=box,color=blue];
		j3567777484 -> j1738935564;
	j1738935564 [label="Я буду наслаждаться этим моментом, который у меня есть. Здесь и сейчас. Потому что это то, что у меня есть.",shape=box,color=blue];
		j1738935564 -> j2572791509;
	j2572791509 [label="И в этом я могу быть уверен.",shape=box,color=blue];
		j2572791509 -> j3768707812;
		j2572791509 -> j972287871;
		j2572791509 -> j3748032567;
	j3768707812 [label="Ничего личного. В основном потому, что я постоянно лажаю, пытаясь замутить с твоей сестрой. :P",shape=box,color=red];
		j3768707812 -> j841537332;
	j972287871 [label="Спасибо, Артур… это значит для меня больше, хоть я и не могу это выразить.",shape=box,color=red];
		j972287871 -> j1509503732;
	j3748032567 [label="Иногда мне хотелось бы обладать такой же хладнокровностью, иногда. <3",shape=box,color=red];
		j3748032567 -> j564380618;
	j841537332 [label="Ха-ха. Ну, у тебя же есть суперспособность, которая позволяет тебе вытаскивать ногу из своей же трахеи, куда ты её так эффектно засунул, не так ли?",shape=box,color=blue];
		j841537332 -> j2259959452;
	j1509503732 [label="Время от времени я пытаюсь вытащить палку из задницы на достаточно долгий срок, чтобы сказать что-то дельное.",shape=box,color=blue];
		j1509503732 -> j4294785844;
	j564380618 [label="Да это просто потому, что у меня нет другого выбора, кроме как держать лицо. Такая уж у нас, британцев, доля. ",shape=box,color=blue];
		j564380618 -> j1939113639;
	j2259959452 [label="Остальным остаётся только научиться общаться. Но это вопрос.",shape=box,color=blue];
		j2259959452 -> j4024285427;
	j4294785844 [label="Пожалуй, пора выпить. Пойдем?",shape=box,color=blue];
		j4294785844 -> j1903766589;
		j4294785844 -> j841274019;
	j1939113639 [label="Как гласит старая мудрость. «Сохраняйте спокойствие и продолжайте двигаться вперёд».",shape=box,color=blue];
		j1939113639 -> j4294785844;
	j4024285427 [label="Снижает ли она свои стандарты с каждой перезагрузкой?",shape=box,color=blue];
		j4024285427 -> "Chat ends.";
	j1903766589 [label="Потом как-нибудь.",shape=box,color=red];
		j1903766589 -> j156587793;
	j841274019 [label="Встретимся там. :)",shape=box,color=red];
		j841274019 -> "Chat ends.";
	"Chat ends." [color=orange];
	j156587793 [label="Как хочешь.",shape=box,color=blue];
		j156587793 -> "Chat ends.";
}