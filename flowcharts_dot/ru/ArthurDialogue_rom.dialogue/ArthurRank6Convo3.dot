	3372 [label="Какие выводы она сделала?",shape=box,color=red];
		3372 -> 3375;
	3373 [label="Рад, что у тебя появляются друзья. хаха ",shape=box,color=red];
		3373 -> 3376;
	3374 [label="Что? Нет! Конечно, нет.",shape=box,color=blue];
		3374 -> 3377;
	3375 [label="Любопытные. Вроде того, сколько раз год уже успел повториться.",shape=box,color=blue];
		3375 -> 3378;
	3376 [label="Наверное, просто приятно общаться с кем-то, с кем не прошёл через весь этот ад.",shape=box,color=blue];
		3376 -> 3379;
	3377 [label="Гекс это моя семья. Моя команда. Ты же знаешь.",shape=box,color=blue];
		3377 -> 3376;
	3378 [label="Сколько раз я мог забыть или не забыть прошедшие годы. Как она живет... вне времени? А как мы увы, нет.",shape=box,color=blue];
		3378 -> 3380;
	3379 [label="Я не знаю, звучит ли это вообще логично. Я их знаю, я им верю, просто мы с ними ещё не прошли через всё пекло и обратно.",shape=box,color=blue];
		3379 -> 3381;
	3380 [label="И прежде чем ты что-нибудь скажешь, нет. Я не хочу знать. У меня нет права знать.",shape=box,color=blue];
		3380 -> 3382;
	3381 [label="Так что порой легче просто молча посидеть и выпить с ними.",shape=box,color=blue];
		3381 -> 3383;
		3381 -> 3384;
		3381 -> 3385;
	3382 [label="Я думаю, я просто хочу сказать - хочешь ты это сделать или нет? всё нормально. Я не буду тебя за это осуждать.",shape=box,color=blue];
		3382 -> 3386;
	3383 [label="Мне такой вариант, если честно, никогда не выпадал.",shape=box,color=red];
		3383 -> 3387;
	3384 [label="Ага. Понимаю.",shape=box,color=red];
		3384 -> 3388;
	3385 [label="Помогает ещё и то, что некоторые из них постарше и с военным опытом.",shape=box,color=red];
		3385 -> 3389;
	3386 [label="Эта ситуация, в которой мы сейчас? Это не нормально. Мы не для такого созданы - я про людей.",shape=box,color=blue];
		3386 -> 3390;
	3387 [label="Я полагаю нет.",shape=box,color=blue];
		3387 -> 3391;
	3388 [label="Здесь нет столько... тяжести. Столько прошлого. Амир бы назвал это «багажом».",shape=box,color=blue];
		3388 -> 3391;
	3389 [label="Сол. Да уж. Сначала я не был уверен, что и думать о либертарианцах. Но теперь? Очень рад, что они здесь.",shape=box,color=blue];
		3389 -> 3391;
	3390 [label="Нет инструкции, как поступать в таких ситуациях. Что бы тобой не было бы выбрано, я уверен, у тебя будут на это веские причины.",shape=box,color=blue];
		3390 -> 3392;
	3391 [label="Но всё это заставило меня задуматься.",shape=box,color=blue];
		3391 -> 3393;
