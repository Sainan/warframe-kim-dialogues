		3392 -> 3396 [label=true,color=green];
		3392 -> 3395 [label=false,color=brown];
	3393 [label="Ух ох.",shape=box,color=red];
		3393 -> 3397;
	3394 [label="О чём?",shape=box,color=red];
		3394 -> 3398;
	3396 [label="Я люблю тебя. И даже если я забуду это? Даже если ты выберешь другой путь? Это нормально.",shape=box,color=blue];
		3396 -> 3400;
	3395 [label="Я доверяю тебе свою жизнь. И ничто этого не изменит. Даже если я забуду об этом на некоторое время.",shape=box,color=blue];
		3395 -> 3399;
	3397 [label="Хех. Выслушай меня. Речь сейчас о тебе.",shape=box,color=blue];
		3397 -> 3401;
	3398 [label="Ты. ",shape=box,color=blue];
		3398 -> 3401;
	3400 [label="До твоего прихода я не думаю, что смог бы это принять. Мне было бы слишком страшно потерять тебя. Потерять всё это.",shape=box,color=blue];
		3400 -> 3402;
	3399 [label="До твоего прихода я не думаю, что смог бы это принять. Мне было бы слишком страшно потерять часть самого себя.",shape=box,color=blue];
		3399 -> 3402;
	3401 [label="И вся эта... временная петля. И это заставляет меня задуматься обо всех тех 1999-х, которые я, возможно, не помню.",shape=box,color=blue];
		3401 -> 3403;
		3401 -> 3404;
		3401 -> 3405;
	3402 [label="Я бы вцепился в это, как отчаявшийся человек в спасательный плот посреди моря. Но, может, я уже был в этой петле достаточно раз, или... может, всё дело в тебе. Я не знаю.",shape=box,color=blue];
		3402 -> 3406;
	3403 [label="Всё, что тебе наговорила гитара, то пустой звук, клянусь.",shape=box,color=red];
		3403 -> 3407;
	3404 [label="У меня проблемы?",shape=box,color=red];
		3404 -> 3407;
	3405 [label="Я... не думаю, что нам стоит в это лезть, Артур.",shape=box,color=red];
		3405 -> 3407;
	3406 [label="Счастье, которое я чувствую сейчас с тобой - это спокойствие - важнее для меня прямо сейчас, чем уверенность, что это будет навсегда.",shape=box,color=blue];
		3406 -> 3408;
	3407 [label="Подожди секунду, ладно? Ты же знаешь, я печатаю медленнее тебя.",shape=box,color=blue];
		3407 -> 3409;
	3408 [label="Если есть что-то, чему ты учишься в жизни, будучи солдатом, так это тому, что всё мимолетно.",shape=box,color=blue];
		3408 -> 3410;
	3409 [label="Я вот к чему веду:",shape=box,color=blue];
		3409 -> 3411;
	3410 [label="Одну секунду здесь, в следующую уже нет. Я, наверно, просто смирился с этим. Окончательно.",shape=box,color=blue];
		3410 -> 3412;
	3411 [label="Заставил ли ты меня или остальных членов Гекса забыть наши прошлые взаимодействия? Да норм.",shape=box,color=blue];
		3411 -> 3413;
	3412 [label="Так что, наше время вместе закончится, если ты ударишь кулаком по полу, и я все забуду?",shape=box,color=blue];
		3412 -> 3414;
	3413 [label="Я не буду держать на тебя зла.",shape=box,color=blue];
		3413 -> 3386;
