		3366 -> 3367;
	3367 [label="Похоже, она с Элеонорой всё время хихикают над шутками, которых больше никто не слышит.",shape=box,color=blue];
		3367 -> 3368;
	3368 [label="Я решил, что стоит уже представиться как следует.",shape=box,color=blue];
		3368 -> 3369;
	3369 [label="У неё много полезных наблюдений. А Флэр просто душка. Если честно, вся та компания в баре, как глоток свежего воздуха. ",shape=box,color=blue];
		3369 -> 3370;
