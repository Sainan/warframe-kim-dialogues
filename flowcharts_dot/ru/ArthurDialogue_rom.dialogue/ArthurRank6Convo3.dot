		3414 -> 3415;
	3415 [label="Я буду наслаждаться этим моментом, который у меня есть. Здесь и сейчас. Потому что это то, что у меня есть.",shape=box,color=blue];
		3415 -> 3416;
	3416 [label="И в этом я могу быть уверен.",shape=box,color=blue];
		3416 -> 3417;
		3416 -> 3418;
		3416 -> 3419;
	3417 [label="Ничего личного. В основном потому, что я постоянно лажаю, пытаясь замутить с твоей сестрой. :P",shape=box,color=red];
		3417 -> 3420;
	3418 [label="Спасибо, Артур… это значит для меня больше, хоть я и не могу это выразить.",shape=box,color=red];
		3418 -> 3421;
	3419 [label="Иногда мне хотелось бы обладать такой же хладнокровностью, иногда. <3",shape=box,color=red];
		3419 -> 3422;
	3420 [label="Ха-ха. Ну, у тебя же есть суперспособность, которая позволяет тебе вытаскивать ногу из своей же трахеи, куда ты её так эффектно засунул, не так ли?",shape=box,color=blue];
		3420 -> 3423;
	3421 [label="Время от времени я пытаюсь вытащить палку из задницы на достаточно долгий срок, чтобы сказать что-то дельное.",shape=box,color=blue];
		3421 -> 3424;
	3422 [label="Да это просто потому, что у меня нет другого выбора, кроме как держать лицо. Такая уж у нас, британцев, доля. ",shape=box,color=blue];
		3422 -> 3425;
