		j3129190836 -> j4085636815 [label=false,color=brown];
	j3135424685 [label="Потому что в тех историях говорилось: «Приходи поиграть со мной. Здесь безопасно. Давай отправимся навстречу приключениям!»",shape=box,color=red];
		j3135424685 -> j1838713711;
