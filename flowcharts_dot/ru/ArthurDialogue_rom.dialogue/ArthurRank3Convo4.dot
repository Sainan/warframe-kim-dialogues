		j4085636815 -> j2910309348;
	j1838713711 [label="Бездна создала из моих воспоминаний королевство из песка, и моё детство прошло в играх с друзьями, словно сошедших со страниц сказок.",shape=box,color=red];
		j1838713711 -> j4177443171;
