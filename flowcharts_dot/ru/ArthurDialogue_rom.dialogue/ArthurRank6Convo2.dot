	3264 [label="Твибисы?",shape=box,color=blue];
		3264 -> 3265;
	3265 [label="Ладно. Вернёмся к теме. Иногда у меня появляется это чувство — что у Энтрати для нас всех есть какая-то большая цель.",shape=box,color=blue];
		3265 -> 3266;
