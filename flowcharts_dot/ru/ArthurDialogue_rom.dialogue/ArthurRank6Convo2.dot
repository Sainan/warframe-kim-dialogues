		j388802533 -> j3358049551;
	j35198095 [label="+5 Chemistry",color=orange];
		j35198095 -> j2241417885;
	j1632317016 [label="Когда тебя заставляют страдать и приносить жертвы, и никто толком не говорит, зачем. И ради чего.",shape=box,color=blue];
		j1632317016 -> j668244063;
