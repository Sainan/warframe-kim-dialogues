digraph {
	"ArthurRank6Convo2 begins." [color=orange];
		"ArthurRank6Convo2 begins." -> j2824231105;
	j2824231105 [label="Я тут задумался. Как думаешь, сколько нас ещё может быть?",shape=box,color=blue];
		j2824231105 -> j3996467922;
		j2824231105 -> j1249544398;
	j3996467922 [label="Ты имеешь ввиду здесь, в 1999, или в более широком смысле?",shape=box,color=red];
		j3996467922 -> j634084536;
	j1249544398 [label="\"Нас\" — это кого?",shape=box,color=red];
		j1249544398 -> j1048900205;
	j634084536 [label="И тех, и других, наверное. Здесь, сейчас, в прошлом - в будущем.",shape=box,color=blue];
		j634084536 -> j2037107838;
	j1048900205 [label="Протофреймы. Здесь, где угодно. Или *когда* угодно, пожалуй.",shape=box,color=blue];
		j1048900205 -> j2037107838;
	j2037107838 [label="Энтрати создал нас с целью. С несколькими. Очевидно, всё не ограничилось лишь шестью из нас. ",shape=box,color=blue];
		j2037107838 -> j346572552;
		j2037107838 -> j1716637198;
	j346572552 [label="Сначала я думал, что он делал для меня \"запасные\" варфреймы, если мой не пройдёт через Гельминта. Теперь я в этом не уверен.",shape=box,color=red];
		j346572552 -> j1333730728;
	j1716637198 [label="Хотел бы я знать, что он замышлял. Или каковы были его настоящие мотивы, когда он создавал ещё протофреймы.",shape=box,color=red];
		j1716637198 -> j3868029011;
	j1333730728 [label="Это имело смысл, когда нас было всего шестеро.",shape=box,color=blue];
		j1333730728 -> j3868029011;
	j3868029011 [label="Ты правда веришь, что его настоящая цель это остановить Безразличие?",shape=box,color=blue];
		j3868029011 -> j1445922916;
	j1445922916 [label="Можем ли мы *действительно* ему доверять?",shape=box,color=blue];
		j1445922916 -> j437742630;
		j1445922916 -> j3207578616;
		j1445922916 -> j878737832;
	j437742630 [label="Не знаю, если честно. Я бы не стал ему доверять даже на расстоянии броска. А без варфрейма я бросаю так себе.",shape=box,color=red];
		j437742630 -> j2873836152;
	j3207578616 [label="Нет. Мы не можем доверять его мотивам больше, чем его методам.",shape=box,color=red];
		j3207578616 -> j167664871;
		j3207578616 -> j3192632429;
	j878737832 [label="Да. Я тоже не всегда одобряю его методы. Но да. Он хочет остановить ту штуку.",shape=box,color=red];
		j878737832 -> j3192632429;
		j878737832 -> j167664871;
	j2873836152 [label="+5 Chemistry",color=orange];
		j2873836152 -> j2285111329;
	j167664871 [label="Он пытается загнать джинна обратно в пресловутую бутылку, если это вообще возможно. И выходит грязновато.",shape=box,color=red];
		j167664871 -> j2278011894;
	j3192632429 [label="Но у нас ведь нет выбора, правда? Всё, что мы с мелким можем — это идти за ним и разгребать последствия. ",shape=box,color=red];
		j3192632429 -> j3789287566;
		j3192632429 -> j1419822855;
	j2285111329 [label="Хех.",shape=box,color=blue];
		j2285111329 -> j167664871;
		j2285111329 -> j3192632429;
	j2278011894 [label="А мы, типа, школьные завхозы, оттираем полы после него. Прелестно.",shape=box,color=blue];
		j2278011894 -> j3789287566;
		j2278011894 -> j1419822855;
	j3789287566 [label="Теперь, когда у Кайи появился собственный взгляд на путешествия во времени, мне будет проще мотаться туда-сюда.",shape=box,color=red];
		j3789287566 -> j1736924489;
	j1419822855 [label="Но я остаюсь здесь. Так что теперь всё на мелком.",shape=box,color=red];
		j1419822855 -> j161265069;
	j1736924489 [label="Этот мелкий иногда реально заноза, но я всё равно это ценю.",shape=box,color=blue];
		j1736924489 -> j308390729;
	j161265069 [label="Check boolean ArthurDating",color=orange];
		j161265069 -> j2896169379 [label=true,color=green];
		j161265069 -> j727892011 [label=false,color=brown];
	j308390729 [label="Приятно знать, что когда ты уходишь в магазин... ты, может, и вернёшься... :/",shape=box,color=blue];
		j308390729 -> j2613732724;
	j2896169379 [label="Эх. Поглядим. Я тебя уже достаточно хорошо знаю, родной. И знаю, что ты не умеешь вовремя опустить голову.",shape=box,color=blue];
		j2896169379 -> j3005563355;
	j727892011 [label="Эх. Поглядим. Я тебя уже достаточно хорошо знаю, Скиталец. И знаю, что ты не умеешь вовремя опустить голову.",shape=box,color=blue];
		j727892011 -> j3001492256;
	j2613732724 [label="Check boolean ArthurDating",color=orange];
		j2613732724 -> j1988147013 [label=true,color=green];
		j2613732724 -> j792148956 [label=false,color=brown];
		j2613732724 -> j1960999992 [label=false,color=brown];
	j3005563355 [label="Одна из причин, по которой я тебя так обожаю. ;)",shape=box,color=blue];
		j3005563355 -> j1960999992;
	j3001492256 [label="Одна из причин, по которой я терплю твоё общество. ;)",shape=box,color=blue];
		j3001492256 -> j792148956;
	j1988147013 [label="Я ей многим обязан, она дала мне некое подобие душевного спокойствия :)",shape=box,color=blue];
		j1988147013 -> j792148956;
		j1988147013 -> j1960999992;
	j792148956 [label="Смайлик! :D",shape=box,color=red];
		j792148956 -> j191690161;
	j1960999992 [label="Не начинай тут сопли разводить. ",shape=box,color=red];
		j1960999992 -> j3166497223;
	j191690161 [label="Да-да. Только не привыкай. Всё ещё странно себя чувствую.",shape=box,color=blue];
		j191690161 -> j2913058640;
	j3166497223 [label="Мм, ты же меня знаешь. Хрустящий снаружи, мягкий внутри. Как залежавшиеся пирожные, от которых фанатеют Амир с Велимиром.",shape=box,color=blue];
		j3166497223 -> j4193949733;
	j2913058640 [label="Ого, приятно слышать.",shape=box,color=red];
		j2913058640 -> j276527466;
	j4193949733 [label="Твибисы?",shape=box,color=blue];
		j4193949733 -> j276527466;
	j276527466 [label="Ладно. Вернёмся к теме. Иногда у меня появляется это чувство — что у Энтрати для нас всех есть какая-то большая цель.",shape=box,color=blue];
		j276527466 -> j1009857241;
		j276527466 -> j3754236193;
		j276527466 -> j3847801362;
	j1009857241 [label="Почему ты так думаешь?",shape=box,color=red];
		j1009857241 -> j1346469329;
	j3754236193 [label="Может, ты прав.",shape=box,color=red];
		j3754236193 -> j4052220135;
	j3847801362 [label="Или это просто надежда?",shape=box,color=red];
		j3847801362 -> j3247587029;
	j1346469329 [label="Судя по тому, сколько сил он вложил в наше создание? И тот факт, что нас больше шести...",shape=box,color=blue];
		j1346469329 -> j1268958872;
	j4052220135 [label="Как думаешь, что это? И чего он ждёт?",shape=box,color=blue];
		j4052220135 -> j3943803722;
		j4052220135 -> j2045141122;
	j3247587029 [label="Ты о чём?",shape=box,color=blue];
		j3247587029 -> j2179468469;
		j3247587029 -> j938756465;
	j1268958872 [label="Такие оружия не создают просто так. Только если точно знаешь, что их придётся применить, дружище.",shape=box,color=blue];
		j1268958872 -> j4157035242;
	j3943803722 [label="<RETRO_EMOJI_SHRUG>",shape=box,color=red];
		j3943803722 -> j4087258887;
	j2045141122 [label="Хотел бы я знать и то, и другое.",shape=box,color=red];
		j2045141122 -> j4087258887;
	j2179468469 [label="Иногда тяжело осознавать, что ты больше не \"важен\".",shape=box,color=red];
		j2179468469 -> j603564579;
	j938756465 [label="Я просто говорю, что... может, ты не хочешь чувствовать себя покинутым им.",shape=box,color=red];
		j938756465 -> j1651403585;
	j4157035242 [label="Разве что ты уверен, что будет война.",shape=box,color=blue];
		j4157035242 -> j1956862548;
		j4157035242 -> j3963396095;
		j4157035242 -> j1098465053;
	j4087258887 [label="Может, ему нужна армия? Может, он ищет \"ту самую вещь\", что сможет победить Безразличие. Может, много чего.",shape=box,color=red];
		j4087258887 -> j3962119342;
	j603564579 [label="Ага...",shape=box,color=blue];
		j603564579 -> "Chat ends.";
	j1651403585 [label="Хочется верить, что всё, ради чего он был здесь, всё, что он сделал с тобой, до сих пор имеет значение. Всё ещё важно. Что это не провал.",shape=box,color=red];
		j1651403585 -> j3269949651;
		j1651403585 -> j3928993093;
	j1956862548 [label="Тогда всё, что нам остаётся — быть готовыми, если это произойдёт.",shape=box,color=red];
		j1956862548 -> j3461228038;
	j3963396095 [label="Возможно. Но похоже, Энтрати и правда из тех, кто любит запасные планы. ",shape=box,color=red];
		j3963396095 -> j3664172192;
	j1098465053 [label="Не знаю. Минерва с Велимиром как-то рассказывали мне про... \"Холодную войну\"? Там, говорят, понастроили кучу безумного оружия — и так его и не использовали.",shape=box,color=red];
		j1098465053 -> j1481485599;
	j3962119342 [label="Не могу отделаться от мысли, что мы просто пули в ружье. Нас используют. Израсходуют. А потом выбросят.",shape=box,color=blue];
		j3962119342 -> j1873783440;
		j3962119342 -> j2662048251;
	"Chat ends." [color=orange];
	j3269949651 [label="И чтобы было ясно, ты всё ещё важен.",shape=box,color=red];
		j3269949651 -> j573138246;
		j3269949651 -> j1094916102;
		j3269949651 -> j1937702131;
	j3928993093 [label="Чтобы было совсем ясно, ты всё ещё важен для *меня*. ",shape=box,color=red];
		j3928993093 -> j573138246;
		j3928993093 -> j1094916102;
		j3928993093 -> j1937702131;
	j3461228038 [label="+5 Chemistry",color=orange];
		j3461228038 -> j655399336;
	j3664172192 [label="Может быть.",shape=box,color=blue];
		j3664172192 -> j3309592233;
	j1481485599 [label="Справедливое замечание. Но это между странами, с дипломатией. Движущиеся части.",shape=box,color=blue];
		j1481485599 -> j897260476;
	j1873783440 [label="Хотел бы я тебе всё рассказать. Но я сделаю всё, что смогу, чтобы этого не случилось.",shape=box,color=red];
		j1873783440 -> j3983553186;
	j2662048251 [label="Ты правда думаешь, что твоя история уже закончилась?",shape=box,color=red];
		j2662048251 -> j2648429028;
	j573138246 [label="Но думать, что твоя история обрывается здесь, без шанса повлиять на финал? Это отстой.",shape=box,color=red];
		j573138246 -> j4147246915;
	j1094916102 [label="Может, больно думать, что где-то там тебя заменил какой-то Артур 2.0.",shape=box,color=red];
		j1094916102 -> j3824622834;
	j1937702131 [label="А может, тебе просто хочется, чтобы твои жертвы всё ещё имели значение в более космическом смысле?",shape=box,color=red];
		j1937702131 -> j2917022821;
	j655399336 [label="Соглашусь.",shape=box,color=blue];
		j655399336 -> j2724245065;
	j3309592233 [label="Часть меня надеется, что где-то нас ещё больше. Но если они и правда сюда придут? Придётся строить ТЦ побольше.",shape=box,color=blue];
		j3309592233 -> "Chat ends.";
	j897260476 [label="Это между буквальным богом и человеком, который считает себя богом.",shape=box,color=blue];
		j897260476 -> j1780083177;
	j3983553186 [label="Я знаю, что ты справишься. И мы встретим этот день вместе, я в этом уверен.",shape=box,color=blue];
		j3983553186 -> j2397353713;
	j2648429028 [label="Нет. Такие оружия не создают просто так. Только если точно знаешь, что их придётся применить, дружище.",shape=box,color=blue];
		j2648429028 -> j3215191760;
		j2648429028 -> j3963396095;
		j2648429028 -> j1956862548;
	j4147246915 [label="Может, в этом и есть смысл. Если Безразличие причина того, что я такой? И должен был пройти через это?",shape=box,color=blue];
		j4147246915 -> j1147579901;
	j3824622834 [label="Дружище, я был готов уйти на покой, пока меня не втянули в этот бред. Едва ли.",shape=box,color=blue];
		j3824622834 -> j3017783337;
	j2917022821 [label="Может быть. А может и нет. Но сколько в жизни бесполезных жертвоприношений? Большинство.",shape=box,color=blue];
		j2917022821 -> j2728600492;
	j2724245065 [label="И надеяться, что если сюда придут такие же, как мы? Нам не понадобится более крупный торговый центр.",shape=box,color=blue];
		j2724245065 -> "Chat ends.";
	j1780083177 [label="Я ставлю на неизбежную катастрофу. Не думаю, что их эго допустило бы иное.",shape=box,color=blue];
		j1780083177 -> j97337655;
		j1780083177 -> j1708155557;
	j2397353713 [label="+5 Chemistry",color=orange];
		j2397353713 -> j1648722223;
	j3215191760 [label="Не знаю. Минерва с Велимиром как-то рассказывали мне про... \"Холодную войну\"? Там, говорят, понастроили кучу безумного оружия — и так его и не использовали.",shape=box,color=red];
		j3215191760 -> j388802533;
	j1147579901 [label="Я хочу быть там, чтобы принять участие в его уничтожении.",shape=box,color=blue];
		j1147579901 -> j35198095;
	j3017783337 [label="Я до сих пор поражаюсь твоей способности иногда полностью отдаваться этому.",shape=box,color=blue];
		j3017783337 -> "Chat ends.";
	j2728600492 [label="Может, я просто оплакиваю саму мысль о целой армии таких, как мы, созданных сумасшедшим, который и сам не понимает зачем. И ради чего.",shape=box,color=blue];
		j2728600492 -> j1632317016;
	j97337655 [label="Может, ты прав.",shape=box,color=red];
		j97337655 -> j2741647412;
	j1708155557 [label="Очень надеюсь, что нет.",shape=box,color=red];
		j1708155557 -> j1947983447;
