	3261 [label="Да-да. Только не привыкай. Всё ещё странно себя чувствую.",shape=box,color=blue];
		3261 -> 3263;
	3262 [label="Мм, ты же меня знаешь. Хрустящий снаружи, мягкий внутри. Как залежавшиеся пирожные, от которых фанатеют Амир с Велимиром.",shape=box,color=blue];
		3262 -> 3264;
