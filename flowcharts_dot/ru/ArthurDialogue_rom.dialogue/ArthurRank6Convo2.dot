		3253 -> 3255;
	3603 [label="Эх. Поглядим. Я тебя уже достаточно хорошо знаю, родной. И знаю, что ты не умеешь вовремя опустить голову.",shape=box,color=blue];
		3603 -> 3257;
	3252 [label="Эх. Поглядим. Я тебя уже достаточно хорошо знаю, Скиталец. И знаю, что ты не умеешь вовремя опустить голову.",shape=box,color=blue];
