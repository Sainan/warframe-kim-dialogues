digraph {
	3229 [label="ArthurRank6Convo2 begins.",color=orange];
		3229 -> 3230;
	3230 [label="Я тут задумался. Как думаешь, сколько нас ещё может быть?",shape=box,color=blue];
		3230 -> 3231;
		3230 -> 3232;
	3231 [label="Ты имеешь ввиду здесь, в 1999, или в более широком смысле?",shape=box,color=red];
		3231 -> 3233;
	3232 [label="\"Нас\" — это кого?",shape=box,color=red];
		3232 -> 3234;
	3233 [label="И тех, и других, наверное. Здесь, сейчас, в прошлом - в будущем.",shape=box,color=blue];
		3233 -> 3235;
	3234 [label="Протофреймы. Здесь, где угодно. Или *когда* угодно, пожалуй.",shape=box,color=blue];
		3234 -> 3235;
	3235 [label="Энтрати создал нас с целью. С несколькими. Очевидно, всё не ограничилось лишь шестью из нас. ",shape=box,color=blue];
		3235 -> 3236;
		3235 -> 3237;
	3236 [label="Сначала я думал, что он делал для меня \"запасные\" варфреймы, если мой не пройдёт через Гельминта. Теперь я в этом не уверен.",shape=box,color=red];
		3236 -> 3238;
	3237 [label="Хотел бы я знать, что он замышлял. Или каковы были его настоящие мотивы, когда он создавал ещё протофреймы.",shape=box,color=red];
		3237 -> 3239;
	3238 [label="Это имело смысл, когда нас было всего шестеро.",shape=box,color=blue];
		3238 -> 3239;
	3239 [label="Ты правда веришь, что его настоящая цель это остановить Безразличие?",shape=box,color=blue];
		3239 -> 3240;
	3240 [label="Можем ли мы *действительно* ему доверять?",shape=box,color=blue];
		3240 -> 3241;
		3240 -> 3242;
		3240 -> 3243;
	3241 [label="Не знаю, если честно. Я бы не стал ему доверять даже на расстоянии броска. А без варфрейма я бросаю так себе.",shape=box,color=red];
		3241 -> 3244;
	3242 [label="Нет. Мы не можем доверять его мотивам больше, чем его методам.",shape=box,color=red];
		3242 -> 3245;
		3242 -> 3246;
	3243 [label="Да. Я тоже не всегда одобряю его методы. Но да. Он хочет остановить ту штуку.",shape=box,color=red];
		3243 -> 3246;
		3243 -> 3245;
	3244 [label="+5 Chemistry",color=orange];
		3244 -> 3247;
	3245 [label="Он пытается загнать джинна обратно в пресловутую бутылку, если это вообще возможно. И выходит грязновато.",shape=box,color=red];
		3245 -> 3248;
	3246 [label="Но у нас ведь нет выбора, правда? Всё, что мы с мелким можем — это идти за ним и разгребать последствия. ",shape=box,color=red];
		3246 -> 3249;
		3246 -> 3250;
	3247 [label="Хех.",shape=box,color=blue];
		3247 -> 3245;
		3247 -> 3246;
