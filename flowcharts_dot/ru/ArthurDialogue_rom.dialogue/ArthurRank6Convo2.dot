		j187167601 -> "Chat ends.";
	j3286506124 [label="Спасибо, Скиталец.",shape=box,color=blue];
		j3286506124 -> "Chat ends.";
	j3358049551 [label="Это между буквальным богом и человеком, который считает себя богом.",shape=box,color=blue];
		j3358049551 -> j195436409;
	j2241417885 [label="Я не хочу оказаться какой-то сноской в учебниках истории. Я хочу засунуть свою скану прямо в его задницу.",shape=box,color=blue];
		j2241417885 -> j2094391718;
		j2241417885 -> j2598375437;
