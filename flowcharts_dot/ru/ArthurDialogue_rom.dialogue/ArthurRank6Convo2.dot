		3277 -> 3282;
		3277 -> 3283;
	3278 [label="Может, ему нужна армия? Может, он ищет \"ту самую вещь\", что сможет победить Безразличие. Может, много чего.",shape=box,color=red];
		3278 -> 3284;
	3279 [label="Ага...",shape=box,color=blue];
		3279 -> 3285;
	3280 [label="Хочется верить, что всё, ради чего он был здесь, всё, что он сделал с тобой, до сих пор имеет значение. Всё ещё важно. Что это не провал.",shape=box,color=red];
		3280 -> 3286;
