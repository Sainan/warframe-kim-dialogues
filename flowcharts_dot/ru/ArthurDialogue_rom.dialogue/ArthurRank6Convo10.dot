	3574 [label="Я принял глупое решение обыграть Амира в «Крутом курсе Олли».",shape=box,color=blue];
		3574 -> 3576;
	3575 [label="Собираемся с Куинси на разведку. Его идея, не моя.",shape=box,color=blue];
		3575 -> 3577;
	3576 [label="И теперь меня дико бесит, что он всё время бьёт мой рекорд.",shape=box,color=blue];
		3576 -> 3578;
	3577 [label="У нас с ним странные отношения. Мы почти не разговариваем.",shape=box,color=blue];
		3577 -> 3579;
	3578 [label="... за последние два дня я провёл двадцать шесть часов, играя в эту игру.",shape=box,color=blue];
		3578 -> 3580;
	3579 [label="Но мы оба знаем, что если бы дело дошло до этого, мы бы умерли друг за друга.",shape=box,color=blue];
		3579 -> 3581;
