	j3777028987 [label="Привет, Артур. Как дела?",shape=box,color=red];
		j3777028987 -> j3579708840;
	j2799551773 [label="Чем занят сегодня?",shape=box,color=red];
		j2799551773 -> j3695297120;
	j3579708840 [label="Я принял глупое решение обыграть Амира в «Крутом курсе Олли».",shape=box,color=blue];
		j3579708840 -> j1876344724;
	j3695297120 [label="Собираемся с Куинси на разведку. Его идея, не моя.",shape=box,color=blue];
		j3695297120 -> j1140870929;
	j1876344724 [label="И теперь меня дико бесит, что он всё время бьёт мой рекорд.",shape=box,color=blue];
		j1876344724 -> j2558644723;
	j1140870929 [label="У нас с ним странные отношения. Мы почти не разговариваем.",shape=box,color=blue];
		j1140870929 -> j573432684;
	j2558644723 [label="... за последние два дня я провёл двадцать шесть часов, играя в эту игру.",shape=box,color=blue];
		j2558644723 -> j723707081;
	j573432684 [label="Но мы оба знаем, что если бы дело дошло до этого, мы бы умерли друг за друга.",shape=box,color=blue];
		j573432684 -> j663484682;
	j723707081 [label="Если я снова подойду к этой чертовой штуке, зови Лэтти усыпить меня.",shape=box,color=blue];
		j723707081 -> "Chat ends.";
	j663484682 [label="Наверно, вот это и есть семья, «не так ли?»",shape=box,color=blue];
		j663484682 -> "Chat ends.";
	"Chat ends." [color=orange];
}