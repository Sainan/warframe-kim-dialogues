digraph {
	3555 [label="ArthurRank6Convo9 begins.",color=orange];
		3555 -> 3556;
	3556 [label="Я не знаю насчёт этих… Заражённых пушек, которые собирает Элеонора.",shape=box,color=blue];
		3556 -> 3557;
		3556 -> 3558;
	3557 [label="Почему?",shape=box,color=red];
		3557 -> 3559;
	3558 [label="По крайней мере, они не болтают.",shape=box,color=red];
		3558 -> 3560;
	3559 [label="Кроме того, что, походу, она может с ними разговаривать?",shape=box,color=blue];
		3559 -> 3561;
	3560 [label="Для *нас*. Я не совсем уверен, что они не разговаривают с *ней*.",shape=box,color=blue];
		3560 -> 3561;
	3561 [label="Я знаю, что они разговаривают с гитарой. О чем я действительно не хочу думать больше, чем нужно.",shape=box,color=blue];
		3561 -> 3562;
	3562 [label="Но стоит ли нам беспокоиться об их... распространении? Их реально становится больше.",shape=box,color=blue];
		3562 -> 3563;
	3563 [label="Чего я не понимаю. И не хочу слишком много думать о том, откуда берутся их боеприпасы. Или из чего они сделаны.",shape=box,color=blue];
		3563 -> 3564;
		3563 -> 3565;
	3564 [label="Хотя бы эти Заражённые на нашей стороне?",shape=box,color=red];
		3564 -> 3566;
	3565 [label="Может, тебе просто стоит остаться с обычным оружием.",shape=box,color=red];
		3565 -> 3567;
	3566 [label="Конечно. *Пока что*.",shape=box,color=blue];
		3566 -> 3568;
	3567 [label="Думаю, да.",shape=box,color=blue];
		3567 -> 3568;
	3568 [label="По крайней мере, если мой пистолет проделает дыру в моей ноге, я буду знать, это по моей вине.",shape=box,color=blue];
		3568 -> 3569;
	3569 [label="А не потому, что мой пистолет решил пересмотреть свою лояльность или решил перекусить среди ночи.",shape=box,color=blue];
		3569 -> 3570;
	3570 [label="Chat ends.",color=orange];
}