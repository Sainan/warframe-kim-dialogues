digraph {
	"ArthurRank6Convo9 begins." [color=orange];
		"ArthurRank6Convo9 begins." -> j3555399899;
	j3555399899 [label="Я не знаю насчёт этих… Заражённых пушек, которые собирает Элеонора.",shape=box,color=blue];
		j3555399899 -> j3404860207;
		j3555399899 -> j1974639135;
	j3404860207 [label="Почему?",shape=box,color=red];
		j3404860207 -> j2002596642;
	j1974639135 [label="По крайней мере, они не болтают.",shape=box,color=red];
		j1974639135 -> j3226808797;
	j2002596642 [label="Кроме того, что, походу, она может с ними разговаривать?",shape=box,color=blue];
		j2002596642 -> j1712591653;
	j3226808797 [label="Для *нас*. Я не совсем уверен, что они не разговаривают с *ней*.",shape=box,color=blue];
		j3226808797 -> j1712591653;
	j1712591653 [label="Я знаю, что они разговаривают с гитарой. О чем я действительно не хочу думать больше, чем нужно.",shape=box,color=blue];
		j1712591653 -> j4223767763;
	j4223767763 [label="Но стоит ли нам беспокоиться об их... распространении? Их реально становится больше.",shape=box,color=blue];
		j4223767763 -> j3763828402;
	j3763828402 [label="Чего я не понимаю. И не хочу слишком много думать о том, откуда берутся их боеприпасы. Или из чего они сделаны.",shape=box,color=blue];
		j3763828402 -> j2071149131;
		j3763828402 -> j2516171860;
	j2071149131 [label="Хотя бы эти Заражённые на нашей стороне?",shape=box,color=red];
		j2071149131 -> j1473500124;
	j2516171860 [label="Может, тебе просто стоит остаться с обычным оружием.",shape=box,color=red];
		j2516171860 -> j1225983852;
	j1473500124 [label="Конечно. *Пока что*.",shape=box,color=blue];
		j1473500124 -> j3512658500;
	j1225983852 [label="Думаю, да.",shape=box,color=blue];
		j1225983852 -> j3512658500;
	j3512658500 [label="По крайней мере, если мой пистолет проделает дыру в моей ноге, я буду знать, это по моей вине.",shape=box,color=blue];
		j3512658500 -> j3396571712;
	j3396571712 [label="А не потому, что мой пистолет решил пересмотреть свою лояльность или решил перекусить среди ночи.",shape=box,color=blue];
		j3396571712 -> "Chat ends.";
	"Chat ends." [color=orange];
}