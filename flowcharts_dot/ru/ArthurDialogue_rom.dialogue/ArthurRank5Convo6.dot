	2560 [label="Ты помогаешь мне заживить старую рану, находясь рядом.",shape=box,color=blue];
		2560 -> 2561;
	2537 [label="Да, как только он достиг совершеннолетия, он ушёл служить Его Величеству. Я сгорал от нетерпения, ожидая, когда смогу сделать то же самое. Но когда настал мой черёд, всё оказалось иначе...",shape=box,color=blue];
