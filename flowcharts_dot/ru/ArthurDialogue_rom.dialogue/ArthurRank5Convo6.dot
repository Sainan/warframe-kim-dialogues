		2563 -> 2564;
	2539 [label="Она никогда не доверяла власти. А после того, что случилось с нами? Она уже не смогла бы доверять ей вовсе.",shape=box,color=blue];
		2539 -> 2775;
		2539 -> 2776;
	2547 [label="Да, это так.",shape=box,color=blue];
		2547 -> 2548;
	2549 [label="Кристофер использовал свои связи. Устроил так, чтобы я оказался в том же полку, что и он. «Багровый дозор», 3-й батальон.",shape=box,color=blue];
		2549 -> 2550;
