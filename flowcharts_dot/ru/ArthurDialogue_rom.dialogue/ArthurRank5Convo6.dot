		2548 -> 2549;
	2550 [label="Но за неделю до того, как я туда отправился… произошёл инцидент. Придорожная бомба.",shape=box,color=blue];
		2550 -> 2551;
	2565 [label="У меня… никогда не было кого-то, за кого стоило бы сражаться. По крайней мере, до недавнего времени. Вот почему меня называют «скиталец».",shape=box,color=red];
		2565 -> 2567;
	2566 [label="У меня закончилось воображаемое пиво. Теперь мне нужно настоящее.",shape=box,color=red];
		2566 -> 2568;
	2551 [label="И как много хороших мужчин и женщин... как много хороших солдат...",shape=box,color=blue];
		2551 -> 2552;
	2567 [label="Не могу сказать, кому из нас пришлось хуже. Обоим. Или никому из нас.",shape=box,color=blue];
		2567 -> 2569;
	2568 [label="Но ведь тебе пришлось не намного лучше, чем мне, не так ли?",shape=box,color=blue];
		2568 -> 2569;
	2552 [label="Он стал просто ещё одной цифрой в чьем-то списке.",shape=box,color=blue];
		2552 -> 2553;
	2569 [label="Порождения войны, просто разными путями. Мы оба многое потеряли в своей жизни.",shape=box,color=blue];
		2569 -> 2570;
	2553 [label="Но я всё ещё был наивным дураком. И, как последний идиот, слишком рьяно бросился подхватить знамя, которое он оставил...",shape=box,color=blue];
