		2536 -> 2537;
	2543 [label="Слушай, Скиталец… Эта часть — не моя история, её должна рассказать Элеонора. Но скажу одно: когда Кристофер отправился на войну…",shape=box,color=blue];
		2543 -> 2544;
	2561 [label="Но иногда и старый призрак бывает желанным гостем.",shape=box,color=blue];
