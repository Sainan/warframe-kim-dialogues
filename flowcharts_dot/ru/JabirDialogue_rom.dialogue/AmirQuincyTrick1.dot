	3497 [label="Роботы.",shape=box,color=red];
		3497 -> 3499;
	3498 [label="Так... Куинси разыгрывает тебя, а я — отвлекающий манёвр.",shape=box,color=red];
		3498 -> 3500;
	3499 [label="РОБОТЫРОБОТЫРОБОТЫРОБОТЫРОБОТЫРОБОТЫРОБОТЫРОБОТЫРОБОТЫРОБОТЫРОБОТЫРОБОТЫ",shape=box,color=blue];
		3499 -> 3501;
	3500 [label="ха?!? шутка? ну... какая шутка?..",shape=box,color=blue];
		3500 -> 3502;
		3500 -> 3503;
	3501 [label="::кашель:: то есть... даааааааа??? а что с этими роботами, о которых ты говориииишь?",shape=box,color=blue];
		3501 -> 3504;
		3501 -> 3505;
	3502 [label="Он заполняет твою комнату упаковочным пенопластом.",shape=box,color=red];
		3502 -> 3506;
	3503 [label="Честно? Думаю, так он показывает, что заботится.",shape=box,color=red];
		3503 -> 3507;
	3504 [label="Я тебе рассказывал про гигантских пауко-роботов на Венере?",shape=box,color=red];
		3504 -> 3508;
	3505 [label="Так, я тебе рассказывал про гончих-роботов?",shape=box,color=red];
		3505 -> 3509;
	3506 [label="ааааааааа! никто никогда не заботился обо мне настолько, чтобы заполнить мою комнату упаковочным пенопластом!!!",shape=box,color=blue];
		3506 -> 3510;
	3507 [label="... ааааааааааа... это так миило!!! никто никогда не любил меня настолько, чтобы разыграть меня!!!",shape=box,color=blue];
		3507 -> 3510;
	3508 [label="Я, ПО-МОЕМУ, ВИДЕЛ ЭТОТ ФИЛЬМ",shape=box,color=blue];
		3508 -> 3511;
	3509 [label="у тебя. есть. РОБОТЫ. СОБАКИ?!",shape=box,color=blue];
		3509 -> 3512;
	3510 [label="ну... я не покажу виду, что ты сказал мне, что он делает. я просто посижу тут и притворюсь, что супер занят кодингом своей игры, хаха",shape=box,color=blue];
		3510 -> 3524;
	3511 [label="но это был не научно-фантастический фильм, это был вестерн. и да, в целом он был довольно паршивый, но, если честно, мне понравилось?",shape=box,color=blue];
		3511 -> 3513;
	3512 [label="я вдруг понял, что у меня появилась новая миссия в жизни. мне нужна робот-собака. её нужно назвать фидо. или лом. или чип. ЧИП!! ЧИП ЛУЧШЕЕ ИМЯ ДЛЯ РОБОТА-СОБАКИ",shape=box,color=blue];
		3512 -> 3514;
	3524 [label="+20 Chemistry",color=orange];
		3524 -> 3526;
	3513 [label="то есть, фильм знал, кем хотел *быть*. он не воспринимал себя слишком серьёзно, знаешь? ничего так не бесит, как фильм про ковбоев с гигантским стимпанк-пауком, который пытается притвориться высоким искусством, хаха",shape=box,color=blue];
		3513 -> 3515;
	3514 [label="И Я БУДУ ЧЁРТ СРАЖАТЬСЯ С ТОБОЙ, ЕСЛИ ТЫ СКАЖЕШЬ ИНАЧЕ",shape=box,color=blue];
		3514 -> 3516;
	3526 [label="хаха, но я надеюсь, что он понимает, конечно... что. ЭТО! означает... ВОЙНУ!!!",shape=box,color=blue];
		3526 -> 3592;
	3515 [label="не то чтобы этот фильм это делал, кстати говоря. вот именно, что нет. но в нём определённо был гигантский робот-паук. хотя, уверен, те, о которых ты говоришь, гораздо более высокотехнологичные",shape=box,color=blue];
		3515 -> 3517;
	3516 [label="понял, \"чип\", хаха, робот-собака, потому что в компьютерах есть чипы, как... компьютерный чип, понял? ... в твою эпоху в компьютерах вообще ещё есть чипы?",shape=box,color=blue];
		3516 -> 3518;
	3592 [label="{\"Id\":3592,\"Incoming\":[3526],\"Outgoing\":[3525],\"GraphPos\":[-11528,45678],\"CompletionType\":2,\"OtherDialogueInfos\":[{\"Dialogue\":\"/Lotus/Types/Gameplay/1999Wf/Dialogue/QuincyDialogue_rom.dialogue\",\"Tag\":\"QuincyAmirTrick2\",\"Value\":0}]}",color=orange];
		3592 -> 3525;
	3517 [label="прости. ты что-то говорил?",shape=box,color=blue];
