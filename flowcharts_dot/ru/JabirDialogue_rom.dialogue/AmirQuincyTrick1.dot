	"Chat ends." [color=orange];
	j2896809014 [label="Роботы.",shape=box,color=red];
		j2896809014 -> j3175671111;
	j253790103 [label="Так... Куинси разыгрывает тебя, а я — отвлекающий манёвр.",shape=box,color=red];
		j253790103 -> j3625479808;
	j3175671111 [label="РОБОТЫРОБОТЫРОБОТЫРОБОТЫРОБОТЫРОБОТЫРОБОТЫРОБОТЫРОБОТЫРОБОТЫРОБОТЫРОБОТЫ",shape=box,color=blue];
		j3175671111 -> j4260074852;
	j3625479808 [label="ха?!? шутка? ну... какая шутка?..",shape=box,color=blue];
		j3625479808 -> j2697351156;
		j3625479808 -> j2361245457;
	j4260074852 [label="::кашель:: то есть... даааааааа??? а что с этими роботами, о которых ты говориииишь?",shape=box,color=blue];
		j4260074852 -> j1686624858;
		j4260074852 -> j2993685153;
	j2697351156 [label="Он заполняет твою комнату упаковочным пенопластом.",shape=box,color=red];
		j2697351156 -> j3621185457;
	j2361245457 [label="Честно? Думаю, так он показывает, что заботится.",shape=box,color=red];
		j2361245457 -> j2724082995;
	j1686624858 [label="Я тебе рассказывал про гигантских пауко-роботов на Венере?",shape=box,color=red];
		j1686624858 -> j2644134285;
	j2993685153 [label="Так, я тебе рассказывал про гончих-роботов?",shape=box,color=red];
		j2993685153 -> j1544584442;
	j3621185457 [label="ааааааааа! никто никогда не заботился обо мне настолько, чтобы заполнить мою комнату упаковочным пенопластом!!!",shape=box,color=blue];
		j3621185457 -> j2922317950;
	j2724082995 [label="... ааааааааааа... это так миило!!! никто никогда не любил меня настолько, чтобы разыграть меня!!!",shape=box,color=blue];
		j2724082995 -> j2922317950;
	j2644134285 [label="Я, ПО-МОЕМУ, ВИДЕЛ ЭТОТ ФИЛЬМ",shape=box,color=blue];
		j2644134285 -> j1145783442;
	j1544584442 [label="у тебя. есть. РОБОТЫ. СОБАКИ?!",shape=box,color=blue];
		j1544584442 -> j3496230173;
	j2922317950 [label="ну... я не покажу виду, что ты сказал мне, что он делает. я просто посижу тут и притворюсь, что супер занят кодингом своей игры, хаха",shape=box,color=blue];
		j2922317950 -> j4044563151;
	j1145783442 [label="но это был не научно-фантастический фильм, это был вестерн. и да, в целом он был довольно паршивый, но, если честно, мне понравилось?",shape=box,color=blue];
		j1145783442 -> j3070419314;
	j3496230173 [label="я вдруг понял, что у меня появилась новая миссия в жизни. мне нужна робот-собака. её нужно назвать фидо. или лом. или чип. ЧИП!! ЧИП ЛУЧШЕЕ ИМЯ ДЛЯ РОБОТА-СОБАКИ",shape=box,color=blue];
		j3496230173 -> j3513867163;
	j4044563151 [label="+20 Chemistry",color=orange];
		j4044563151 -> j1366871239;
	j3070419314 [label="то есть, фильм знал, кем хотел *быть*. он не воспринимал себя слишком серьёзно, знаешь? ничего так не бесит, как фильм про ковбоев с гигантским стимпанк-пауком, который пытается притвориться высоким искусством, хаха",shape=box,color=blue];
		j3070419314 -> j3008359644;
	j3513867163 [label="И Я БУДУ ЧЁРТ СРАЖАТЬСЯ С ТОБОЙ, ЕСЛИ ТЫ СКАЖЕШЬ ИНАЧЕ",shape=box,color=blue];
		j3513867163 -> j434695828;
	j1366871239 [label="хаха, но я надеюсь, что он понимает, конечно... что. ЭТО! означает... ВОЙНУ!!!",shape=box,color=blue];
		j1366871239 -> "Initiate conversation QuincyAmirTrick2 in /Lotus/Types/Gameplay/1999Wf/Dialogue/QuincyDialogue_rom.dialogue";
	j3008359644 [label="не то чтобы этот фильм это делал, кстати говоря. вот именно, что нет. но в нём определённо был гигантский робот-паук. хотя, уверен, те, о которых ты говоришь, гораздо более высокотехнологичные",shape=box,color=blue];
		j3008359644 -> j1014296665;
	j434695828 [label="понял, \"чип\", хаха, робот-собака, потому что в компьютерах есть чипы, как... компьютерный чип, понял? ... в твою эпоху в компьютерах вообще ещё есть чипы?",shape=box,color=blue];
		j434695828 -> j2986271254;
	"Initiate conversation QuincyAmirTrick2 in /Lotus/Types/Gameplay/1999Wf/Dialogue/QuincyDialogue_rom.dialogue" [label="Initiate conversation QuincyAmirTrick2 in /Lotus/Types/Gameplay/1999Wf/Dialogue/QuincyDialogue_rom.dialogue",color=orange];
		"Initiate conversation QuincyAmirTrick2 in /Lotus/Types/Gameplay/1999Wf/Dialogue/QuincyDialogue_rom.dialogue" -> "Chat ends.";
	j1014296665 [label="прости. ты что-то говорил?",shape=box,color=blue];
		j1014296665 -> j2352405499;
	j2986271254 [label="или они все основаны на каких-то органических и протомясных-Бездноватых-волшебствах-",shape=box,color=blue];
		j2986271254 -> j2352405499;
	j2352405499 [label="стой",shape=box,color=blue];
		j2352405499 -> j2222021810;
	j2222021810 [label="ты слышишь звук пылесоса?..",shape=box,color=blue];
		j2222021810 -> j233030429;
	j233030429 [label="+20 Chemistry",color=orange];
