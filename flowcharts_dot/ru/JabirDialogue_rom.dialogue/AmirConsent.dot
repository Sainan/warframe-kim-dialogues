		j1740572955 -> j2483020106;
	j3316821453 [label="Boolean AmirConsentComplete is now true.",color=orange];
		j3316821453 -> "Chat ends.";
	j2483020106 [label="Я хочу поговорить с тобой об одном деле и хочу убедиться, что ты ок с этим, пока все не зашло слишком далеко.",shape=box,color=red];
		j2483020106 -> j880210922;
	j880210922 [label="Знаю, мы это раньше не обсуждали. Мне важно, чтобы ты не чувствовал, что я тебе вру или каким-либо образом нечестен.",shape=box,color=red];
		j880210922 -> j809503515;
	j809503515 [label="ээээээммммчтопроисходитчтослучилосьтыкогорзамочилктоумёрилиподождиэточтотоещёстраннеедолжнобытьещёстраннееТЫЧТОВСТРЕЧАЕШЬСГИТАРОЙОООМГ",shape=box,color=blue];
		j809503515 -> j1961816880;
		j809503515 -> j1522769437;
	j1961816880 [label="Я знаю, это может показаться странным, но это не значит, что я чувствую к тебе меньше.",shape=box,color=red];
		j1961816880 -> j1600003380;
	j1522769437 [label="Ну, по крайней мере не с гитарой...? Послушай, я знаю, это может показаться странным, но это не значит, что я тебе меньше сочувствую.",shape=box,color=red];
		j1522769437 -> j3401525794;
	j1600003380 [label="сорянмозгвсёещёзастрялнатомествозможногороманасгитаройщасщасперезагружусь",shape=box,color=blue];
		j1600003380 -> j2989147600;
	j3401525794 [label="+5 Chemistry",color=orange];
		j3401525794 -> j1600003380;
	j2989147600 [label="АааааИИИИИИИИ вернулись. сорян чё ты пытался мне сказать?",shape=box,color=blue];
		j2989147600 -> j2662267990;
	j2662267990 [label="у тебя... есть кто-то ещё где-то? или... когда-то? это... не кто-то из гекс... верно? ....... ааауууууффф это было бы тааак странно",shape=box,color=blue];
		j2662267990 -> j938034537;
	j938034537 [label="это как если бы ты встречался с моей кузиной лейлой фуууфуууфуууфуууфуууфуууфуууфууу",shape=box,color=blue];
		j938034537 -> j3756916911;
		j938034537 -> j910162988;
	j3756916911 [label="Нет, это не один из Гекс. И не гитара. И не твоя кузина. ",shape=box,color=red];
		j3756916911 -> j402955850;
	j910162988 [label="Я не знал, что у тебя есть кузина.",shape=box,color=red];
		j910162988 -> j3516927925;
	j402955850 [label="ОК ТО ЕСТЬ КАК ЭТО У ТЕБЯ ЕСТЬ ЕЩЁ ОТНОШЕНИЯ?!?!?!",shape=box,color=blue];
		j402955850 -> j2678945533;
	j3516927925 [label="да я типа не особо про семью рассказываю МЫ ТАК ДОФИГА ДРУГОГО ОБСУЖДАЕМ КАК ТО ЧТО У ТЕБЯ ЕСТЬ ЕЩЁ ОТНОШЕНИЯ?!?!?!",shape=box,color=blue];
		j3516927925 -> j2678945533;
	j2678945533 [label="Я пойму, если тебе это некомфортно. И хочу, чтобы ты понимал, это не значит, что ТЫ значишь для меня меньше.",shape=box,color=red];
		j2678945533 -> j3173594983;
	j3173594983 [label="Этот человек не отсюда, и я даже не знаю, смогу ли я тебя познакомить, но... это важный для меня человек. И ты тоже.",shape=box,color=red];
		j3173594983 -> j578363169;
	j578363169 [label="Я знаю, это может быть трудным для восприятия, и если ты не ок с этим, я полностью приму это. Я просто не хочу, чтобы ты думал, что я тебе вру или что-то скрываю.",shape=box,color=red];
		j578363169 -> j781876809;
	j781876809 [label="фффффффффффффффффффффффффффффффффффффффффннннннннннннннннннннннннннннннннммммммммммммммммммммммммммммккккккккккккккккккккккккккк",shape=box,color=blue];
		j781876809 -> j2655895489;
	j2655895489 [label="(это звук того как меня коротит кстати)",shape=box,color=blue];
		j2655895489 -> j3879564513;
	j3879564513 [label="Ты для меня очень много значишь. Очень-очень много. И я не хочу тебя потерять. Не знаю. Хорошо. Да. Я в порядке. В общем. Я тебе доверяю. Если кто-то важен тебе, то этот человек важен и для меня. Так что… ладно.",shape=box,color=blue];
		j3879564513 -> j3772962731;
	j3772962731 [label="это очень стра-а-а-нно НО ПОЧЕМУ ЖЕ ТЕБЕ ВСЕ РАЗВЛЕЧЕНИЯ ДОСТАЮТСЯ А Я ЗАСТРЯЛ ТУУУУТ?!!?!",shape=box,color=blue];
		j3772962731 -> j475738493;
	j475738493 [label="+20 Chemistry",color=orange];
		j475738493 -> j4251431947;
	j4251431947 [label="чууууууууууууууууууууууууууууушь",shape=box,color=blue];
		j4251431947 -> j3086425361;
	j3086425361 [label="Evaluate expressions",color=orange];
		j3086425361 -> j1565308320 [label="AmirCephalon4",color=purple];
