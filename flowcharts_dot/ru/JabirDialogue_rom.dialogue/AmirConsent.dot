		j3086425361 -> j1565308320 [label="AmirDungeonEscaped",color=purple];
		j3086425361 -> j1652029940 [label="false",color=purple];
	j1565308320 [label="но если серьёзно? я... правда тебе доверяю. ты так важен для меня и я рад что ты сказал мне правду. если бы ты врал об этом это было бы совсем по-другому, понимаешь?",shape=box,color=blue];
		j1565308320 -> j3856281741;
	j1652029940 [label="но если серьёзно? я... ок посмотрим, что из этого выйдет. я тебе доверяю. я рад что ты сказал мне правду. если бы ты врал об этом это было бы вообще по-другому, понимаешь?",shape=box,color=blue];
		j1652029940 -> j3856281741;
	j3856281741 [label="так что спасибо. и... да, я ок с этим. пока всех это устраивает.",shape=box,color=blue];
