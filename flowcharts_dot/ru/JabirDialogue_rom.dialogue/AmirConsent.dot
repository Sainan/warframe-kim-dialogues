		4527 -> 4528;
	4526 [label="да я типа не особо про семью рассказываю МЫ ТАК ДОФИГА ДРУГОГО ОБСУЖДАЕМ КАК ТО ЧТО У ТЕБЯ ЕСТЬ ЕЩЁ ОТНОШЕНИЯ?!?!?!",shape=box,color=blue];
		4526 -> 4528;
	4528 [label="Я пойму, если тебе это некомфортно. И хочу, чтобы ты понимал это не значит, что ТЫ значишь для меня меньше.",shape=box,color=red];
		4528 -> 4529;
	4529 [label="Этот человек не отсюда, и я даже не знаю, смогу ли я тебя познакомить, но... это важный для меня человек. И ты тоже.",shape=box,color=red];
		4529 -> 4530;
