		j1740572955 -> j2483020106;
	j3316821453 [label="Boolean AmirConsentComplete is now true.",color=orange];
		j3316821453 -> "Chat ends.";
	j2483020106 [label="Я хочу поговорить с тобой об одном деле и хочу убедиться, что ты ок с этим, пока все не зашло слишком далеко.",shape=box,color=red];
		j2483020106 -> j880210922;
	j880210922 [label="Знаю, мы это раньше не обсуждали. Мне важно, чтобы ты не чувствовал, что я тебе вру или каким-либо образом нечестен.",shape=box,color=red];
		j880210922 -> j809503515;
	j809503515 [label="ээээээммммчтопроисходитчтослучилосьтыкогорзамочилктоумёрилиподождиэточтотоещёстраннеедолжнобытьещёстраннееТЫЧТОВСТРЕЧАЕШЬСГИТАРОЙОООМГ",shape=box,color=blue];
		j809503515 -> j1961816880;
		j809503515 -> j1522769437;
	j1961816880 [label="Я знаю, это может показаться странным, но это не значит, что я чувствую к тебе меньше.",shape=box,color=red];
		j1961816880 -> j1600003380;
	j1522769437 [label="Ну, по крайней мере не с гитарой...? Послушай, я знаю, это может показаться странным, но это не значит, что я тебе меньше сочувствую.",shape=box,color=red];
		j1522769437 -> j3401525794;
	j1600003380 [label="сорянмозгвсёещёзастрялнатомествозможногороманасгитаройщасщасперезагружусь",shape=box,color=blue];
		j1600003380 -> j2989147600;
	j3401525794 [label="+5 Chemistry",color=orange];
		j3401525794 -> j1600003380;
	j2989147600 [label="АааааИИИИИИИИ вернулись. сорян чё ты пытался мне сказать?",shape=box,color=blue];
		j2989147600 -> j2662267990;
	j2662267990 [label="у тебя... есть кто-то ещё где-то? или... когда-то? это... не кто-то из гекс... верно? ....... ааауууууффф это было бы тааак странно",shape=box,color=blue];
		j2662267990 -> j938034537;
	j938034537 [label="это как если бы ты встречался с моей кузиной лейлой фуууфуууфуууфуууфуууфуууфуууфууу",shape=box,color=blue];
		j938034537 -> j364691237;
		j938034537 -> j212288044;
	j364691237 [label="Нет, это не один из Гекс. И не гитара. И не твоя кузина. ",shape=box,color=red];
		j364691237 -> j4119281282;
	j212288044 [label="Я не знал, что у тебя есть кузина.",shape=box,color=red];
		j212288044 -> j538445284;
	j4119281282 [label="ОК ТО ЕСТЬ КАК ЭТО У ТЕБЯ ЕСТЬ ЕЩЁ ОТНОШЕНИЯ?!?!?!",shape=box,color=blue];
		j4119281282 -> j3062268339;
	j538445284 [label="да я типа не особо про семью рассказываю МЫ ТАК ДОФИГА ДРУГОГО ОБСУЖДАЕМ КАК ТО ЧТО У ТЕБЯ ЕСТЬ ЕЩЁ ОТНОШЕНИЯ?!?!?!",shape=box,color=blue];
		j538445284 -> j3062268339;
	j3062268339 [label="Я пойму, если тебе это некомфортно. И хочу, чтобы ты понимал это не значит, что ТЫ значишь для меня меньше.",shape=box,color=red];
		j3062268339 -> j3114109678;
	j3114109678 [label="Этот человек не отсюда, и я даже не знаю, смогу ли я тебя познакомить, но... это важный для меня человек. И ты тоже.",shape=box,color=red];
		j3114109678 -> j751210339;
	j751210339 [label="Я знаю, это может быть трудным для восприятия и если ты не ок с этим я полностью приму это. Я просто не хотел, чтобы ты думал, что я тебе вру или что-то скрываю.",shape=box,color=red];
		j751210339 -> j3637420944;
	j3637420944 [label="фффффффффффффффффффффффффффффффффффффффффннннннннннннннннннннннннннннннннммммммммммммммммммммммммммммккккккккккккккккккккккккккк",shape=box,color=blue];
		j3637420944 -> j2050836653;
	j2050836653 [label="(это звук того как меня коротит кстати)",shape=box,color=blue];
		j2050836653 -> j4274380577;
	j4274380577 [label="ты много значишь для меня. прям сильно много. и я не хочу это потерять. и если этот человек так важен тебе то... он важен и мне тоже.",shape=box,color=blue];
		j4274380577 -> j1384917968;
	j1384917968 [label="наверно я просто ревную что я не могу познакомиться ха-ха почему тебе достаётся всё веселье? глупо застрять в 1999",shape=box,color=blue];
