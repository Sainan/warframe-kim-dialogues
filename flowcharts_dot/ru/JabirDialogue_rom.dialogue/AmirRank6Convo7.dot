	j871537142 [label="ты вернешься, я это знаю.",shape=box,color=blue];
		j871537142 -> "Chat ends.";
	j517584919 [label="«В момент когда ты поворачиваешь ключ, который тебе дала стая удивительно дружелюбных огромных крыс, ты молишься, чтобы позади двери было более безопасно, чем подземелье находящееся за тобой».",shape=box,color=blue];
		j517584919 -> j3108419865;
	"Chat ends. Next chat will be AmirRank6Convo3." [color=orange];
	"Chat ends. Next chat will be AmirRank6Convo2." [color=orange];
	j3108419865 [label="«Ты оказываешься перед большим служебным лифтом. Так это не простое подземелье?»",shape=box,color=blue];
		j3108419865 -> j2263653056;
		j3108419865 -> j1800967150;
	j2263653056 [label="Возвращаюсь в подземелье.",shape=box,color=red];
		j2263653056 -> j3137522350;
	j1800967150 [label="Поднимаюсь на лифте.",shape=box,color=red];
		j1800967150 -> j1978154803;
	j3137522350 [label="«Ты оборачиваешься и смотришь на подземелье, думая про себя: \"Возвращаться туда это глупая идея\"».",shape=box,color=blue];
		j3137522350 -> j2026112067;
	j1978154803 [label="«Ты поднимаешься в лифте. Сквозь его открытую клетку лифта ты видишь, как каменные стены подземелья заменяются все более совершенными технологиями. Ты все еще спрашиваешь себя: \"Где, чёрт возьми, я нахожусь?\"»",shape=box,color=blue];
		j1978154803 -> j1772406567;
	j2026112067 [label="хаха... хорошо, я поднимусь на этом лифте.",shape=box,color=red];
		j2026112067 -> j1978154803;
	j1772406567 [label="«Лифт ведёт в коридор, заполненный гудящими машинами и гигантскими трубами. Это что-то вроде лаборатории?»",shape=box,color=blue];
		j1772406567 -> j192045631;
	j192045631 [label="Из комнаты в конце коридора ты слышишь, как человек кричит от боли.",shape=box,color=blue];
		j192045631 -> j260874422;
		j192045631 -> j2932867771;
	j260874422 [label="Не обращая внимания на крики, ищу выход.",shape=box,color=red];
		j260874422 -> j216514400;
	j2932867771 [label="Иду к плачущему человеку.",shape=box,color=red];
		j2932867771 -> j3128671852;
	j216514400 [label="«Ты обыскиваешь коридор в поисках чего-нибудь полезных, но крики становятся невозможно игнорировать. Что-то заставляет тебя подойти к этому человеку и помочь ему».",shape=box,color=blue];
		j216514400 -> j3128671852;
	j3128671852 [label="«Ты идешь по коридору, следуя за источником криков агонии. Ты входишь в большой механический зал, здесь ты видишь человека. Не такой уж непривлекательный человек, привязанный к машине. Из его пальцев вырываются электрические разряды, приводящие в действие гигантскую турбину».",shape=box,color=blue];
		j3128671852 -> j2613407523;
		j3128671852 -> j3951726888;
	j2613407523 [label="Спрашиваю: «чё как?»",shape=box,color=red];
		j2613407523 -> j4194460705;
	j3951726888 [label="Осматриваю человека.",shape=box,color=red];
		j3951726888 -> j4194460705;
	j4194460705 [label="«Человек привязан к поднятой платформе с разведенными в стороны руками. К кончикам его пальцев прикреплены щупы, которые сплетаются в толстый кабель, соединенный с гигантской турбиной. Из его рук вырываются электрические дуги».",shape=box,color=blue];
		j4194460705 -> j2780786265;
	j2780786265 [label="Между криками и электрическими разрядами человеку удается сказать: «ОСТАНОВИ... ЭТИ... ТУРБИНЫ!!»",shape=box,color=blue];
		j2780786265 -> j670017041;
	j670017041 [label="Осматриваю комнату.",shape=box,color=red];
		j670017041 -> j2972465376;
	j2972465376 [label="«Ты оглядываешься по сторонам в поисках чего-нибудь полезного. Ты видишь верстак с инструментами. Гвоздодер. Гигантские кусачки. Панель управления».",shape=box,color=blue];
		j2972465376 -> j1571667540;
