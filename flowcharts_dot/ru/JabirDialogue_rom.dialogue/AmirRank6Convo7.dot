		j970257374 -> j1571667540;
	j110009618 [label="«Сняв свои круглые очки, мужчина долго смотрит на своего спасителя».",shape=box,color=blue];
		j110009618 -> j862922844;
	j879023643 [label="«Его взгляд пронзителен».",shape=box,color=blue];
		j879023643 -> j2801922896;
	j3401115339 [label="Круглые очки, как его зовут?",shape=box,color=red];
		j3401115339 -> j3611589430;
	j862922844 [label="эм я имею в виду",shape=box,color=blue];
		j862922844 -> j3970329226;
	j2801922896 [label="«Ты замечаешь его сильные руки, мощные предплечья и жилистые ноги. \"Предназначен для скорости\", - думаешь ты, поднимая брови».",shape=box,color=blue];
		j2801922896 -> j2950864636;
	j3611589430 [label="«\"Зовут Забир\", - отвечает он с уверенностью».",shape=box,color=blue];
		j3611589430 -> j509197855;
	j3970329226 [label="«Снимая свои круглые очки, человек долго всматривается в того, кто пытался его спасти».",shape=box,color=blue];
		j3970329226 -> j3499241272;
	j2950864636 [label="Успокойся там, дружище. Как зовут этого красавца?",shape=box,color=red];
		j2950864636 -> j3611589430;
	j509197855 [label="Звучит знакомо. Что они с тобой делали?",shape=box,color=red];
		j509197855 -> j3199098405;
	j3199098405 [label="«\"Собирают мою энергию. Я очень электрический, но ты, наверное, уже заметил это раньше\", - говорит Забир».",shape=box,color=blue];
		j3199098405 -> j711175485;
	j711175485 [label="Ладно, Забир, как мы собираемся спасти Лотос.",shape=box,color=red];
		j711175485 -> j3647213205;
	j3647213205 [label="Забир в шоке. \"Спасти Лотос? Это она привела меня сюда! Мы должны покинуть этот астероид!\"",shape=box,color=blue];
