		j572503223 -> j2457137162 [label=false,color=brown];
	j1650850696 [label="«Человек с облегчением падает вниз. Вытащи меня отсюда».",shape=box,color=blue];
		j1650850696 -> j1631964732;
	j1169092086 [label="КХЕМ",shape=box,color=blue];
		j1169092086 -> j4039737793;
	j463158207 [label="«Кусачки быстро перерезают кабели, прикрепленные к человеку. С его свободными руками он может снять оставшиеся оковы».",shape=box,color=blue];
		j463158207 -> j1468173952;
	j445929560 [label="«Ты кладешь лезвие кусачек на электрические провода и сразу же сожалеешь об этом. Ток проходит через кусачки и проникает в твоё тело, отшвыривая тебя назад».",shape=box,color=blue];
		j445929560 -> j1528861110;
	j3161131370 [label="«В прошлый раз это сработало не очень хорошо».",shape=box,color=blue];
		j3161131370 -> j1007668333;
		j3161131370 -> j2318701956;
	j2457137162 [label="«Когда ты разбиваешь панель управления, пойманный в ловушку человек, кажется, кричит на тебя. Судя по всему, он совсем не в восторге от твоих действий».",shape=box,color=blue];
		j2457137162 -> j1502386489;
	j1631964732 [label="Boolean TurbineStopped is now true.",color=orange];
		j1631964732 -> j3246353505;
	j4039737793 [label="::ПРОЧИЩАЕТ ГОРЛО::",shape=box,color=blue];
		j4039737793 -> j2077152499;
	j1468173952 [label="«Сняв его круглые солнцезащитные очки, человек долго смотрит на своего спасителя».",shape=box,color=blue];
		j1468173952 -> j3499241272;
	j1528861110 [label="«Ты просыпаешься на полу. Этот человек всё ещё страдает, и теперь твои волосы стоят дыбом на голове».",shape=box,color=blue];
		j1528861110 -> j970257374;
