		j1502386489 -> j1007668333;
		j1502386489 -> j2318701956;
	j2077152499 [label="«Чудесным образом, по какой-то неведомой причине, турбина ВЗРЫВАЕТСЯ под натиском чистой силы этого человека!»",shape=box,color=blue];
