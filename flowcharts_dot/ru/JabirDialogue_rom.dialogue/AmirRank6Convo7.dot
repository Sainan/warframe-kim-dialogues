	4268 [label="«Ты оказываешься перед большим служебным лифтом. Так это не простое подземелье?»",shape=box,color=blue];
		4268 -> 4269;
		4268 -> 4270;
	4269 [label="Возвращаюсь в подземелье.",shape=box,color=red];
		4269 -> 4271;
	4270 [label="Поднимаюсь на лифте.",shape=box,color=red];
		4270 -> 4272;
	4271 [label="«Ты оборачиваешься и смотришь на подземелье, думая про себя: \"Возвращаться туда это глупая идея\"».",shape=box,color=blue];
		4271 -> 4273;
	4272 [label="«Ты поднимаешься в лифте. Сквозь его открытую клетку лифта ты видишь, как каменные стены подземелья заменяются все более совершенными технологиями. Ты все еще спрашиваешь себя: \"Где, чёрт возьми, я нахожусь?\"»",shape=box,color=blue];
		4272 -> 4274;
	4273 [label="хаха... хорошо, я поднимусь на этом лифте.",shape=box,color=red];
		4273 -> 4272;
	4274 [label="«Лифт ведёт в коридор, заполненный гудящими машинами и гигантскими трубами. Это что-то вроде лаборатории?»",shape=box,color=blue];
		4274 -> 4275;
	4275 [label="Из комнаты в конце коридора ты слышишь, как человек кричит от боли.",shape=box,color=blue];
		4275 -> 4276;
		4275 -> 4277;
	4276 [label="Не обращая внимания на крики, ищу выход.",shape=box,color=red];
		4276 -> 4278;
	4277 [label="Иду к плачущему человеку.",shape=box,color=red];
		4277 -> 4279;
	4278 [label="«Ты обыскиваешь коридор в поисках чего-нибудь полезных, но крики становятся невозможно игнорировать. Что-то заставляет тебя подойти к этому человеку и помочь ему».",shape=box,color=blue];
		4278 -> 4279;
	4279 [label="«Ты идешь по коридору, следуя за источником криков агонии. Ты входишь в большой механический зал, здесь ты видишь человека. Не такой уж непривлекательный человек, привязанный к машине. Из его пальцев вырываются электрические разряды, приводящие в действие гигантскую турбину».",shape=box,color=blue];
		4279 -> 4280;
		4279 -> 4281;
	4280 [label="Спрашиваю: «чё как?»",shape=box,color=red];
		4280 -> 4282;
	4281 [label="Осматриваю человека.",shape=box,color=red];
		4281 -> 4282;
	4282 [label="«Человек привязан к поднятой платформе с разведенными в стороны руками. К кончикам его пальцев прикреплены щупы, которые сплетаются в толстый кабель, соединенный с гигантской турбиной. Из его рук вырываются электрические дуги».",shape=box,color=blue];
		4282 -> 4283;
	4283 [label="Между криками и электрическими разрядами человеку удается сказать: «ОСТАНОВИ... ЭТИ... ТУРБИНЫ!!»",shape=box,color=blue];
		4283 -> 4284;
