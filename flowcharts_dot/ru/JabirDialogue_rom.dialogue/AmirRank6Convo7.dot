		j2318701956 -> j163163030;
	j1007668333 [label="Продолжаю осматриваться вокруг",shape=box,color=red];
		j1007668333 -> j1571667540;
	j3446891916 [label="либо это уже пытка, либо ты РЕЕАААААААЛЬНО с этим лажаешь",shape=box,color=blue];
		j3446891916 -> j3833252063;
	j262188928 [label="«Ты, вероятно, не хочешь связываться с этим снова».",shape=box,color=blue];
		j262188928 -> j2674643439;
		j262188928 -> j4167552703;
	j3560013016 [label="«Ты пытаешься использовать панель управления, но она заблокирована протоколом безопасности, который даже ты не можешь взломать. Ты понимаешь, что тебе придется делать это вручную».",shape=box,color=blue];
		j3560013016 -> j2674643439;
		j3560013016 -> j4167552703;
	j3246353505 [label="Перерезаю провода.",shape=box,color=red];
		j3246353505 -> j995680227;
	j1110728012 [label="Boolean ControlPanel is now true.",color=orange];
		j1110728012 -> j572503223;
	j163163030 [label="«Изо всех сил ты запускаешь гвоздодёр в турбину. Массивный грохот зубчатых колес и скрипучих поршней наполняет зал. Затем турбина резко замедляется».",shape=box,color=blue];
		j163163030 -> j1650850696;
	j3833252063 [label="таааааак давай-ка сразу перескочим вперёд",shape=box,color=blue];
		j3833252063 -> j1169092086;
