		j3136528501 -> j3560013016 [label=false,color=brown];
	j349048438 [label="«Кусачки выглядят по‑индустриальному мощно и, похоже, они могут резать практически все».",shape=box,color=blue];
		j349048438 -> j3246353505;
	j3633047880 [label="Использую гвоздодёр, чтобы разбить панель управления.",shape=box,color=red];
		j3633047880 -> j1110728012;
