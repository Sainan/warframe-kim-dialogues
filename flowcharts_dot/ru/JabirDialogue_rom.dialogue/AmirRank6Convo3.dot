		j4072325139 -> j3670113740;
	j2310258132 [label="«В этот момент пол становится скользким из-за того, сколько раз на него наплевал охранник, что дальше некуда. Выбери другой вариант».",shape=box,color=blue];
		j2310258132 -> j438101630;
	j3501614334 [label="«Охранник не впечатлён, он харкает и плюет в твою камеру, а потом разворачивается, чтобы вернуться к своему стулу. Спустя несколько минут храп снова раздается по подземелью».",shape=box,color=blue];
		j3501614334 -> j3890794212;
