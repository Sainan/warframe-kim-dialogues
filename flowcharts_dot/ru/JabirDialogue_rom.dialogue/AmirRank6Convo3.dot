		j1217499126 -> j3818582419;
	j2363728314 [label="«Ты смотришь на блеск металла. \"Неплохо, - думаешь ты, - это нанесет удар так же хорошо, как и всё, чем я наносил удары раньше\", и ты поднимаешь его».",shape=box,color=blue];
