		j4169125516 -> j2407683480;
	j3343847991 [label="«Охраннику это не нравится. Он выдергивает ключи с пояса, отпирает дверь камеры и врывается внутрь. Инстинктивно ты тянешься к оружию, но его там нет, потому что ты находишься в камере, и, конечно же, они конфисковали у тебя твоё оружие».",shape=box,color=blue];
