		4442 -> 4445;
	4439 [label="Chat ends.",color=orange];
	4440 [label="«Ты кричишь: \"Забир, хватай его!\" указывая на охранника трапа».",shape=box,color=blue];
		4440 -> 4443;
	4444 [label="«Забир бросается на охранника и бьет его электрическим разрядом. Он падает замертво».",shape=box,color=blue];
		4444 -> 4447;
	4445 [label="«Ты пробираешься к пульту управления и пытаешься использовать консоль, стараясь при этом оставаться незамеченным. Тебе удается заставить двери отсека открыться».",shape=box,color=blue];
		4445 -> 4448;
	4443 [label="«Вопреки здравому смыслу, Забир смело бросается вперед. Даже он недостаточно быстр, чтобы остаться незамеченным. Охранники открывают огонь, и Забир трагически погибает».",shape=box,color=blue];
		4443 -> 4446;
