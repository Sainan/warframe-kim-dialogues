		4424 -> 4428;
	4422 [label="Отправить Забира атаковать охрану трапа.",shape=box,color=red];
		4422 -> 4426;
	4427 [label="«Забир берёт свисток и дует. Ты ничего не слышишь, кроме дыхания. Ты сидишь и ждёшь, но ничего не происходит. Ни одной крысы. Забир пожимает плечами».",shape=box,color=blue];
		4427 -> 4432;
	4425 [label="«Добираешься до панели управления, но внимательный охранник замечает это. Ты пытаешься поднять руки, чтобы сдаться, но они всё равно стреляют в тебя, потому что Гринир, подлая тварь».",shape=box,color=blue];
		4425 -> 4429;
		4425 -> 4430;
	4428 [label="«Ты бежишь к кораблю, но охранник возле трапа замечает тебя и открывает огонь. Твой день и жизнь заканчиваются мучительно».",shape=box,color=blue];
		4428 -> 4429;
		4428 -> 4433;
	4426 [label="о, конечно, когда есть опасность, ты сразу посылаешь амира",shape=box,color=blue];
		4426 -> 4431;
	4432 [label="«Затем ты слышишь это, хруст. Как будто кто-то жуёт. Внезапно крысы вырываются из вентиляционных отверстий по всему ангару. Гринир охранники визжат, как школьники, и открывают огонь. Пули летят повсюду».",shape=box,color=blue];
		4432 -> 4437;
	4429 [label="Мне нужен перерыв. [Конец.]",shape=box,color=red];
		4429 -> 4434;
