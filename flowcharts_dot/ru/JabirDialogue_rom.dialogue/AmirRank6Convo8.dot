		4453 -> 4458;
	4459 [label="«Ты смотришь на Забира и говоришь: \"Я надеюсь, ты умеешь управлять этой штукой\", а Забир отвечает: \"Я нет, но ты умеешь\"».",shape=box,color=blue];
