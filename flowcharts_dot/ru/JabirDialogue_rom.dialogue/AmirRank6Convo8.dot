	j2495712560 [label="+5 Chemistry",color=orange];
		j2495712560 -> j3314597948;
	j1731033001 [label="+5 Chemistry",color=orange];
		j1731033001 -> j2993851137;
	j3314597948 [label="ох... всё готово",shape=box,color=blue];
		j3314597948 -> j3540107798;
	j2993851137 [label="не осуждаю, он и правда чертовски хорош собой",shape=box,color=blue];
		j2993851137 -> j3540107798;
	j3540107798 [label="ну, поехали",shape=box,color=blue];
		j3540107798 -> j779480554;
	j779480554 [label="«Ты стоишь посреди электрической лаборатории с теперь свободным Забиром. Он смотрит на тебя: \"нечего терять время, следуй за мной\"».",shape=box,color=blue];
		j779480554 -> j2156998068;
	j2156998068 [label="«Он ведет тебя через коридор за коридором. Он знает этот астероид как свои пять пальцев, каждого охранника и их перемещения».",shape=box,color=blue];
		j2156998068 -> j3184617014;
		j2156998068 -> j3354985817;
		j2156998068 -> j1752473868;
	j3184617014 [label="Спросить Забира о крысах.",shape=box,color=red];
		j3184617014 -> j2881859019;
	j3354985817 [label="Он тоже заключенный?",shape=box,color=red];
		j3354985817 -> j2799734206;
	j1752473868 [label="Куда меня ведёт Забир?",shape=box,color=red];
		j1752473868 -> j1130194031;
	j2881859019 [label="«Забир в шоке. \"Крысам удалось тебя найти? Это потрясающе. Это сработало. Смотри\". Забир держит в руках замысловато тисненый золотой свисток. \"Крысиная королева дала мне его. Мы должны её найти\"».",shape=box,color=blue];
		j2881859019 -> j1050843326;
	j2799734206 [label="«Если спросить Забира, как он сюда попал, он скажет: «'Не до этого, нам нужно сосредоточиться на том, чтобы выбраться отсюда».",shape=box,color=blue];
		j2799734206 -> j3184617014;
		j2799734206 -> j1752473868;
	j1130194031 [label="«Забир оглядывается: «Отправляем тебя в ангар. Угоняем корабль и валим подальше. Ищем Королеву Крыс».",shape=box,color=blue];
		j1130194031 -> j1050843326;
	j1050843326 [label="КОРОЛЕВУ КРЫС?",shape=box,color=red];
		j1050843326 -> j3982367511;
	j3982367511 [label="«Она дала мне этот свисток. Крысы его слушают. Она мой друг. Она не всегда добрая, но она заботится».",shape=box,color=blue];
		j3982367511 -> j3514828715;
		j3982367511 -> j3722788227;
	j3514828715 [label="Ты случайно показывал это Лэтти?",shape=box,color=red];
		j3514828715 -> j335746359;
	j3722788227 [label="Уж больно знакомо звучит.",shape=box,color=red];
		j3722788227 -> j805783502;
	j335746359 [label="я свою жизнь ценю, чтобы вот так рисковать",shape=box,color=blue];
		j335746359 -> j412899353;
	j805783502 [label="любое сходство с реальными людьми чистое совпадение",shape=box,color=blue];
		j805783502 -> j412899353;
	j412899353 [label="«С помощью Забира вы петляете по коридорам астероида. Он ловко уходит от охраны и камер наблюдения».",shape=box,color=blue];
		j412899353 -> j3178865527;
	j3178865527 [label="«Наконец, вы доходите до массивной двери. Забир подаёт сигнал пригнуться. Вы оба крадётесь в ангар корабля».",shape=box,color=blue];
		j3178865527 -> j119062878;
	j119062878 [label="«Ты прячешься в тени колонны. Рядом слышны голоса стражников Гринир».",shape=box,color=blue];
		j119062878 -> j3052917272;
	j3052917272 [label="«Что будешь делать?»",shape=box,color=blue];
		j3052917272 -> j3484357578;
		j3052917272 -> j1967885861;
	j3484357578 [label="Атаковать охрану.",shape=box,color=red];
		j3484357578 -> j853520139;
	j1967885861 [label="Осмотреться.",shape=box,color=red];
		j1967885861 -> j2535639054;
	j853520139 [label="«Без капли самосохранения или предусмотрительности вы выбегаете на открытое пространство. Группа охранников с другой стороны начинает стрелять. Вы бросаетесь навстречу потоку пуль, которые мгновенно убивают. Забир качает головой, глядя на ваш бессмысленный акт упрямой храбрости».",shape=box,color=blue];
		j853520139 -> j3277007541;
	j2535639054 [label="«Выглядываешь из-за угла и осматриваешь обстановку».",shape=box,color=blue];
		j2535639054 -> j2589607244;
	j3277007541 [label="хочешь попробовать снова и не словить моментальную смерть на этот раз?",shape=box,color=blue];
		j3277007541 -> j3350757681;
		j3277007541 -> j1252204873;
	j2589607244 [label="«В центре ангара стоит Рэйлджек. Трап, ведущий на Рэйлджек, заблокирован охранником. С одной стороны ангара дюжина Гринир заняты шумной игрой в кости. В нескольких метрах перед тобой находится пульт управления».",shape=box,color=blue];
		j2589607244 -> j4281453179;
	j3350757681 [label="А то ж.",shape=box,color=red];
		j3350757681 -> j1853058148;
	j1252204873 [label="На сегодня хватит. [Конец.]",shape=box,color=red];
		j1252204873 -> "Chat ends.";
	j4281453179 [label="«\"Чтобы выбраться, нам сначала нужно открыть ворота ангара\", — шепчет Забир».",shape=box,color=blue];
		j4281453179 -> j2579591873;
	j1853058148 [label="«Что теперь сделаешь?»",shape=box,color=blue];
		j1853058148 -> j2921782312;
		j1853058148 -> j1967885861;
	j2579591873 [label="«Забир смотрит на тебя. \"Есть какие-нибудь гениальные идеи?\"»",shape=box,color=blue];
		j2579591873 -> j774369477;
		j2579591873 -> j2579591873;
	j2921782312 [label="... Осмотреться ещё раз?",shape=box,color=red];
		j2921782312 -> j2535639054;
