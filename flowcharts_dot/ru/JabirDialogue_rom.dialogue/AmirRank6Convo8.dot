	4380 [label="ох... всё готово",shape=box,color=blue];
		4380 -> 4382;
	4381 [label="не осуждаю, он и правда чертовски хорош собой",shape=box,color=blue];
		4381 -> 4382;
	4382 [label="ну, поехали",shape=box,color=blue];
		4382 -> 4383;
	4383 [label="«Ты стоишь посреди электрической лаборатории с теперь свободным Забиром. Он смотрит на тебя: \"нечего терять время, следуй за мной\"».",shape=box,color=blue];
		4383 -> 4384;
	4384 [label="«Он ведет тебя через коридор за коридором. Он знает этот астероид как свои пять пальцев, каждого охранника и их перемещения».",shape=box,color=blue];
		4384 -> 4385;
		4384 -> 4386;
		4384 -> 4387;
	4385 [label="Спросить Забира о крысах.",shape=box,color=red];
		4385 -> 4388;
	4386 [label="Он тоже заключенный?",shape=box,color=red];
		4386 -> 4389;
	4387 [label="Куда меня ведёт Забир?",shape=box,color=red];
		4387 -> 4390;
	4388 [label="«Забир в шоке. \"Крысам удалось тебя найти? Это потрясающе. Это сработало. Смотри\". Забир держит в руках замысловато тисненый золотой свисток. \"Крысиная королева дала мне его. Мы должны её найти\"».",shape=box,color=blue];
		4388 -> 4391;
	4389 [label="«Если спросить Забира, как он сюда попал, он скажет: «'Не до этого, нам нужно сосредоточиться на том, чтобы выбраться отсюда».",shape=box,color=blue];
		4389 -> 4385;
		4389 -> 4387;
	4390 [label="«Забир оглядывается: «Отправляем тебя в ангар. Угоняем корабль и валим подальше. Ищем Королеву Крыс».",shape=box,color=blue];
		4390 -> 4391;
	4391 [label="КОРОЛЕВУ КРЫС?",shape=box,color=red];
		4391 -> 4392;
	4392 [label="«Она дала мне этот свисток. Крысы его слушают. Она мой друг. Она не всегда добрая, но она заботится».",shape=box,color=blue];
		4392 -> 4393;
		4392 -> 4394;
	4393 [label="Ты случайно показывал это Лэтти?",shape=box,color=red];
		4393 -> 4395;
	4394 [label="Уж больно знакомо звучит.",shape=box,color=red];
		4394 -> 4396;
	4395 [label="я свою жизнь ценю, чтобы вот так рисковать",shape=box,color=blue];
		4395 -> 4397;
	4396 [label="любое сходство с реальными людьми чистое совпадение",shape=box,color=blue];
		4396 -> 4397;
	4397 [label="«С помощью Забира вы петляете по коридорам астероида. Он ловко уходит от охраны и камер наблюдения».",shape=box,color=blue];
		4397 -> 4398;
	4398 [label="«Наконец, вы доходите до массивной двери. Забир подаёт сигнал пригнуться. Вы оба крадётесь в ангар корабля».",shape=box,color=blue];
		4398 -> 4399;
	4399 [label="«Ты прячешься в тени колонны. Рядом слышны голоса стражников Гринир».",shape=box,color=blue];
		4399 -> 4400;
	4400 [label="«Что будешь делать?»",shape=box,color=blue];
		4400 -> 4401;
		4400 -> 4402;
	4401 [label="Атаковать охрану.",shape=box,color=red];
		4401 -> 4403;
	4402 [label="Осмотреться.",shape=box,color=red];
		4402 -> 4404;
	4403 [label="«Без капли самосохранения или предусмотрительности вы выбегаете на открытое пространство. Группа охранников с другой стороны начинает стрелять. Вы бросаетесь навстречу потоку пуль, которые мгновенно убивают. Забир качает головой, глядя на ваш бессмысленный акт упрямой храбрости».",shape=box,color=blue];
		4403 -> 4405;
	4404 [label="«Выглядываешь из-за угла и осматриваешь обстановку».",shape=box,color=blue];
		4404 -> 4406;
	4405 [label="хочешь попробовать снова и не словить моментальную смерть на этот раз?",shape=box,color=blue];
		4405 -> 4407;
		4405 -> 4408;
	4406 [label="«В центре ангара стоит Рэйлджек. Трап, ведущий на Рэйлджек, заблокирован охранником. С одной стороны ангара дюжина Гринир заняты шумной игрой в кости. В нескольких метрах перед тобой находится пульт управления».",shape=box,color=blue];
		4406 -> 4409;
	4407 [label="А то ж.",shape=box,color=red];
		4407 -> 4410;
	4408 [label="На сегодня хватит. [Конец.]",shape=box,color=red];
		4408 -> 4411;
	4409 [label="«\"Чтобы выбраться, нам сначала нужно открыть ворота ангара\", — шепчет Забир».",shape=box,color=blue];
		4409 -> 4412;
	4410 [label="«Что теперь сделаешь?»",shape=box,color=blue];
		4410 -> 4413;
		4410 -> 4402;
