		j2662935952 -> j2597142891 [label=false,color=brown];
		j2662935952 -> j3901758909 [label=false,color=brown];
	j3901758909 [label="Дунуть в этот крысосвисток.",shape=box,color=red];
		j3901758909 -> j862601527;
	j4006528998 [label="Использовать панель управления.",shape=box,color=red];
		j4006528998 -> j3472085473;
	j2597142891 [label="Рвануть к Рэйлджеку.",shape=box,color=red];
		j2597142891 -> j3156055178;
	j3178512246 [label="Отправить Забира атаковать охрану трапа.",shape=box,color=red];
		j3178512246 -> j3085788778;
	j862601527 [label="«Забир берёт свисток и дует. Ты ничего не слышишь, кроме дыхания. Ты сидишь и ждёшь, но ничего не происходит. Ни одной крысы. Забир пожимает плечами».",shape=box,color=blue];
		j862601527 -> j3858974995;
	j3472085473 [label="«Добираешься до панели управления, но внимательный охранник замечает это. Ты пытаешься поднять руки, чтобы сдаться, но они всё равно стреляют в тебя, потому что Гринир, подлая тварь».",shape=box,color=blue];
		j3472085473 -> j1780776792;
		j3472085473 -> j952112927;
	j3156055178 [label="«Ты бежишь к кораблю, но охранник возле трапа замечает тебя и открывает огонь. Твой день и жизнь заканчиваются мучительно».",shape=box,color=blue];
		j3156055178 -> j1780776792;
		j3156055178 -> j3374661193;
	j3085788778 [label="о, конечно, когда есть опасность, ты сразу посылаешь амира",shape=box,color=blue];
		j3085788778 -> j2235132735;
	j3858974995 [label="«Затем ты слышишь это, хруст. Как будто кто-то жуёт. Внезапно крысы вырываются из вентиляционных отверстий по всему ангару. Гринир охранники визжат, как школьники, и открывают огонь. Пули летят повсюду».",shape=box,color=blue];
		j3858974995 -> j2880305818;
	j1780776792 [label="Мне нужен перерыв. [Конец.]",shape=box,color=red];
		j1780776792 -> j1163452778;
	j952112927 [label="Ещё раз.",shape=box,color=red];
		j952112927 -> j318932394;
	j3374661193 [label="Ещё раз!",shape=box,color=red];
		j3374661193 -> j1595881847;
	j2235132735 [label="я про забира",shape=box,color=blue];
		j2235132735 -> j1797717147;
	j2880305818 [label="«Крысы отвлекли охрану. Что теперь?»",shape=box,color=blue];
		j2880305818 -> j1204604063;
		j2880305818 -> j61780051;
	j1163452778 [label="ты вернёшься",shape=box,color=blue];
		j1163452778 -> "Chat ends.";
	j318932394 [label="Boolean OneMoreTime is now true.",color=orange];
		j318932394 -> j774369477;
	j1595881847 [label="Boolean Again is now true.",color=orange];
		j1595881847 -> j774369477;
	j1797717147 [label="ладно",shape=box,color=blue];
		j1797717147 -> j2338740928;
	j1204604063 [label="Пусть Забир шибанёт электрическим разрядом охранника трапа!",shape=box,color=red];
		j1204604063 -> j4176138088;
	j61780051 [label="Открываю двери через панель управления.",shape=box,color=red];
		j61780051 -> j2580381511;
	j2338740928 [label="«Ты кричишь: \"Забир, хватай его!\" указывая на охранника трапа».",shape=box,color=blue];
		j2338740928 -> j3291363910;
	j4176138088 [label="«Забир бросается на охранника и бьет его электрическим разрядом. Он падает замертво».",shape=box,color=blue];
		j4176138088 -> j3028613594;
	j2580381511 [label="«Ты пробираешься к пульту управления и пытаешься использовать консоль, стараясь при этом оставаться незамеченным. Тебе удается заставить двери отсека открыться».",shape=box,color=blue];
		j2580381511 -> j2160467471;
	j3291363910 [label="«Вопреки здравому смыслу, Забир смело бросается вперед. Даже он недостаточно быстр, чтобы остаться незамеченным. Охранники открывают огонь, и Забир трагически погибает».",shape=box,color=blue];
		j3291363910 -> j563742597;
	j3028613594 [label="Boolean RampGuardZapped is now true.",color=orange];
		j3028613594 -> j1915017362;
	j2160467471 [label="«Охранники, отвлеченные крысами, даже не замечают их».",shape=box,color=blue];
		j2160467471 -> j256735146;
	j563742597 [label="игра окончена дружище",shape=box,color=blue];
		j563742597 -> j3911030622;
	j1915017362 [label="Check boolean HangarDoorsOpen",color=orange];
		j1915017362 -> j3548977214 [label=true,color=green];
		j1915017362 -> j3782205883 [label=false,color=brown];
	j256735146 [label="Boolean HangarDoorsOpen is now true.",color=orange];
		j256735146 -> j1087431613;
	j3911030622 [label="ещё разок? сохранить забира в живых на этот раз?",shape=box,color=blue];
		j3911030622 -> j1538950034;
		j3911030622 -> j3347673881;
	j3548977214 [label="«Ты пользуешься своим шансом и бежишь к Рэйлджеку».",shape=box,color=blue];
		j3548977214 -> j74588429;
	j3782205883 [label="«Забир машет рукой, чтобы ты открыл двери ангара».",shape=box,color=blue];
		j3782205883 -> j61780051;
	j1087431613 [label="Check boolean RampGuardZapped",color=orange];
		j1087431613 -> j3548977214 [label=true,color=green];
		j1087431613 -> j3809538205 [label=false,color=brown];
	j1538950034 [label="Я обещаю, что на этот раз не убью тебя.",shape=box,color=red];
		j1538950034 -> j769413847;
	j3347673881 [label="Я думаю, мы можем остановиться здесь. [Конец.]",shape=box,color=red];
		j3347673881 -> j1033263990;
	j74588429 [label="«Ты смотришь на Забира и говоришь: \"Я надеюсь, ты умеешь управлять этой штукой\", а Забир отвечает: \"Я нет, но ты умеешь\"».",shape=box,color=blue];
		j74588429 -> j2244754400;
	j3809538205 [label="«Забир обращает внимание на охранника трапа».",shape=box,color=blue];
		j3809538205 -> j1204604063;
	j769413847 [label="Boolean KeepZabirAlive is now true.",color=orange];
		j769413847 -> j774369477;
	j1033263990 [label="ты убиваешь меня",shape=box,color=blue];
		j1033263990 -> "Chat ends.";
	j2244754400 [label="«Ты запускаешь корабль, и как раз в тот момент, когда ты готовишься нажать кнопку, чтобы поднять трап и закрыть дверь, Забир говорит: \"Подожди! Мы не можем просто их оставить\"».",shape=box,color=blue];
		j2244754400 -> j2241321101;
		j2244754400 -> j52149417;
	j2241321101 [label="Ты прав, нам нужно их спасти.",shape=box,color=red];
		j2241321101 -> j2071788612;
	j52149417 [label="Пожалуйста, не надо. Нам действительно следует их оставить.",shape=box,color=red];
		j52149417 -> j2957875126;
	j2071788612 [label="«Забир поднимает свисток и дует».",shape=box,color=blue];
		j2071788612 -> j2468711468;
	j2957875126 [label="«\"ОТКЛОЕНО!\", - сказал Забир».",shape=box,color=blue];
		j2957875126 -> j2071788612;
	j2468711468 [label="\"Через несколько секунд десятки крыс хлынули на корабль. Забир смотрит на тебя и кричит: \"ВЗЛЕТАЙ!\"»",shape=box,color=blue];
		j2468711468 -> j450026934;
	j450026934 [label="«Корабль взлетает. Гринир открывают огонь, но их пули отскакивают от мощного Рэйлджек, когда он выходит из ангара».",shape=box,color=blue];
		j450026934 -> j721942313;
	j721942313 [label="«Пока крысы суетятся на мостике, ты смотришь на просторы космоса, и затем уверенно говоришь: \"РЭЙЛДРАЙВ, ЗАДЕЙСТВОВАТЬ\". Рэйлджек вспыхнув исчезает вдалеке».",shape=box,color=blue];
		j721942313 -> j4218923030;
	j4218923030 [label="«КОНЕЦ».",shape=box,color=blue];
		j4218923030 -> j2885478823;
	j2885478823 [label="Ух ты.",shape=box,color=red];
		j2885478823 -> j2437140355;
	j2437140355 [label="итак, что ты думаешь о конце? было это слишком безумно?",shape=box,color=blue];
		j2437140355 -> j3381748410;
		j2437140355 -> j3852053155;
	j3381748410 [label="Я потерял дар речи.",shape=box,color=red];
		j3381748410 -> j3832910825;
	j3852053155 [label="Да, и мне это понравилось.",shape=box,color=red];
		j3852053155 -> j1578893835;
