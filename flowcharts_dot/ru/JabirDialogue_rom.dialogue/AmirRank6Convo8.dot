		4466 -> 4465;
	4467 [label="\"Через несколько секунд десятки крыс хлынули на корабль. Забир смотрит на тебя и кричит: \"ВЗЛЕТАЙ!\"»",shape=box,color=blue];
		4467 -> 4468;
	4468 [label="«Корабль взлетает. Гринир открывают огонь, но их пули отскакивают от мощного Рэйлджек, когда он выходит из ангара».",shape=box,color=blue];
		4468 -> 4469;
	4469 [label="«Пока крысы суетятся на мостике, ты смотришь на просторы космоса, и затем уверенно говоришь: \"РЭЙЛДРАЙВ, ЗАДЕЙСТВОВАТЬ\". Рэйлджек вспыхнув исчезает вдалеке».",shape=box,color=blue];
