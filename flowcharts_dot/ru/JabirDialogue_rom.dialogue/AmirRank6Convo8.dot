		4458 -> 4461;
	4462 [label="«Ты запускаешь корабль, и как раз в тот момент, когда ты готовишься нажать кнопку, чтобы поднять трап и закрыть дверь, Забир говорит: \"Подожди! Мы не можем просто их оставить\"».",shape=box,color=blue];
