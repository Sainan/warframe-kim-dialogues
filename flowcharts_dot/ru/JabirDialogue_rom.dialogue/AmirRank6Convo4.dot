		j344992171 -> j580202628;
	j3347738689 [label="Не говорите мне, что это крысы.",shape=box,color=red];
		j3347738689 -> j1857627955;
	j580202628 [label="Это крысы, не так ли?",shape=box,color=red];
		j580202628 -> j1857627955;
	j1857627955 [label="это ГРЁБАННЫЕ КРЫСЫ!!",shape=box,color=blue];
		j1857627955 -> j87082036;
	j87082036 [label="я имею в виду...",shape=box,color=blue];
		j87082036 -> j3952653160;
	j3952653160 [label="«Писк усиливается, за ним следует стук когтей по камню. Внезапно твой факел отбрасывает тень. Крыса размером с кошку... нет... собаку бросается на тебя».",shape=box,color=blue];
		j3952653160 -> j649340794;
	j649340794 [label="«Но она не одна, они приходят отовсюду».",shape=box,color=blue];
		j649340794 -> j138343081;
		j649340794 -> j1777140279;
		j649340794 -> j1464073526;
	j138343081 [label="Надрать крысиную задницу.",shape=box,color=red];
		j138343081 -> j1133401278;
	j1777140279 [label="Размахиваю своим факелом в их сторону.",shape=box,color=red];
		j1777140279 -> j1133401278;
	j1464073526 [label="Ты показывал эту часть Лэтти?",shape=box,color=red];
		j1464073526 -> j1388512085;
	j1133401278 [label="«Крысы окружают тебя. Ты выпрямляешься, готов к бою, но они не нападают. Вместо этого самая большая из них склоняет перед тобой шею. Ты замечаешь, что на крысе ожерелье. Серебряная цепочка соскальзывает и падает на пол. Крыса будто говорит: „это для тебя“».",shape=box,color=blue];
		j1133401278 -> j1899205738;
		j1133401278 -> j3848291465;
	j1388512085 [label="нет, и я даже не собираюсь этого делать",shape=box,color=blue];
		j1388512085 -> j1454153595;
	j1899205738 [label="Возьму ожерелье.",shape=box,color=red];
		j1899205738 -> j1191619582;
	j3848291465 [label="Спрошу крыса, кто дал ему ожерелье?",shape=box,color=red];
		j3848291465 -> j1717951603;
	j1454153595 [label="крысы нападают на тебя, каков твой план?",shape=box,color=blue];
		j1454153595 -> j138343081;
		j1454153595 -> j1777140279;
	j1191619582 [label="«Ты берешь ожерелье. На его цепочке висит ключ».",shape=box,color=blue];
		j1191619582 -> j3753434560;
	j1717951603 [label="«Крыс не разговаривает. В конце концов, это просто крыса».",shape=box,color=blue];
		j1717951603 -> j3753434560;
	j3753434560 [label="«Крысы поворачиваются и убегают прочь. Тот, кто дал им этот ключ, знал, что ты здесь. Есть только один кто обладает такой силой... Лотос». ",shape=box,color=blue];
		j3753434560 -> j3433034762;
	j3433034762 [label="Ключ? Он открывает дверь?",shape=box,color=red];
		j3433034762 -> j1422419901;
	j1422419901 [label="«Ты вставляешь ключ в дверь, он работает. Ты болезненно щуришься, в то время как яркий свет, исходящий с другой стороны, освещает тебя. Ты не веришь своим глазам...»",shape=box,color=blue];
		j1422419901 -> j2713733710;
	j2713733710 [label="и...",shape=box,color=blue];
