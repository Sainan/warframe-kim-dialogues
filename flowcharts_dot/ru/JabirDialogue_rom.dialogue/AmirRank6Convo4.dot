	4125 [label="ладно",shape=box,color=blue];
		4125 -> 4129;
	4126 [label="«Ты обыскиваешь тело охранника, но более не находишь ничего ценного. Ты думаешь о том, чтобы съесть заплесневелое печенье, пока не почувствовал его запах и быстро передумываешь».",shape=box,color=blue];
