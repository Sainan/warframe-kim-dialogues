		j821815412 -> j854545 [label="false",color=purple];
	"Chat ends." [color=orange];
	j1368461209 [label="Ты спрашиваешь меня это после того, как рассказала мне ту историю про Балласа и Маргулис, и это не про него?",shape=box,color=red];
		j1368461209 -> j562589148;
	j996264649 [label="После того, что Альбрехт сделал с тобой, и всей этой истории про \"можно ли простить орокин\", и дело не в нём?",shape=box,color=red];
		j996264649 -> j562589148;
	j2677022947 [label="Хорошо, я подыграю. Верю ли я в то, что «каждый заслуживает любви»? Очевидно, это вопрос морали и ценностей.",shape=box,color=red];
		j2677022947 -> j4237630440;
	j3070854383 [label="Орокин, который сказал мне, что никогда не знал любви, вдруг задаёт мне этот вопрос, и это не про него?",shape=box,color=red];
		j3070854383 -> j562589148;
	j1244710087 [label="Орокин, который служил Исполнителю как её наложник, а затем замышлял её предать, задаёт мне этот вопрос, и это не про него?",shape=box,color=red];
		j1244710087 -> j562589148;
	j854545 [label="Ты правда ожидаешь, что я поверю, что это просто философский вопрос?",shape=box,color=red];
		j854545 -> j562589148;
	j562589148 [label="Я не хочу застревать в деталях. Это тянет всё вниз в мелочи. «Видите ли, этот сделал то, а тот сделал это, что отменяет это», и вот мы все на скамье в нашем маленьком испытании.",shape=box,color=blue];
		j562589148 -> j3602967167;
		j562589148 -> j3555484085;
	j4237630440 [label="+5 Chemistry",color=orange];
		j4237630440 -> j1454130536;
	j3602967167 [label="Либо говори прямо, либо не говори вовсе. Если ты не собираешься сказать мне, о ком это на самом деле, я не стану тратить время на разговор с тобой.",shape=box,color=red];
		j3602967167 -> j1430791740;
	j3555484085 [label="Хорошо. Мы сыграем в твою маленькую, образно говоря, игру.",shape=box,color=red];
		j3555484085 -> j552124817;
	j1454130536 [label="Спасибо! Исключение имён из этого маленького испытания делает его гораздо более приемлемым. Иначе застрянешь в деталях, и мы никуда не продвинемся.",shape=box,color=blue];
		j1454130536 -> j99700483;
	j1430791740 [label="И ты тоже не будешь тратить время на меня — всё просто.",shape=box,color=blue];
		j1430791740 -> j155006797;
	j552124817 [label="Прекрасно. Вопрос таков, как я его сформулировал. Заслуживает ли каждый быть любимым?",shape=box,color=blue];
		j552124817 -> j376886337;
	j99700483 [label="И да, именно так. Никто не сомневается, заслуживает ли праведный герой любить и быть любимым. Это никогда не ставится под сомнение в наших великих сказаниях, не так ли?",shape=box,color=blue];
		j99700483 -> j1531627923;
	j155006797 [label="Boolean RoatheNoDate is now true.",color=orange];
		j155006797 -> "Chat ends.";
	j376886337 [label="Никто не сомневается, заслуживает ли праведный герой любить и быть любимым. Это никогда не ставится под сомнение в наших великих сказаниях, не так ли?",shape=box,color=blue];
		j376886337 -> j1531627923;
	j1531627923 [label="Только подлец. Злодей. Монстр. Морально разорённый разрушитель миров.",shape=box,color=blue];
		j1531627923 -> j849151917;
		j1531627923 -> j1773210229;
	j849151917 [label="[Позволь ему продолжить.]",shape=box,color=red];
		j849151917 -> j2490422692;
	j1773210229 [label="Дьявол?",shape=box,color=red];
		j1773210229 -> j1992103601;
	j2490422692 [label="Add 1 to Thermostat counter",color=orange];
		j2490422692 -> j936365052;
	j1992103601 [label="Подыграй, Узурпатор.",shape=box,color=blue];
		j1992103601 -> j1817221348;
	j936365052 [label="Я предлагаю следующее утверждение: единственное, что делает этих существ морально изгнанными, — это то, что у них есть другие, которые могут их морально изгнать.",shape=box,color=blue];
		j936365052 -> j1341694060;
	j1817221348 [label="Add -1 to Thermostat counter",color=orange];
		j1817221348 -> j647713495;
		j1817221348 -> j1892154009;
	j1341694060 [label="Если бы человек совершал «злые дела» в отрыве от реальности, как отдельный человек, без окружающих, которые могли бы его осудить, то некому было бы признать его злом, не так ли?",shape=box,color=blue];
		j1341694060 -> j3215842279;
	j647713495 [label="Я имею в виду...",shape=box,color=red];
		j647713495 -> j2853671896;
	j1892154009 [label="Извини.",shape=box,color=red];
		j1892154009 -> j2853671896;
	j3215842279 [label="Если ублюдок сжигает лес и вокруг никого нет, чтобы услышать, издаст ли он звук? Единственная мера, по которой мы можем судить о «Добрых» и «Злых» поступках, это поступки других.",shape=box,color=blue];
		j3215842279 -> j832629494;
		j3215842279 -> j1660827104;
		j3215842279 -> j353844893;
	j2853671896 [label="Но да, раз ты настоял на этом, Дьявол! Вершина всех зол!",shape=box,color=blue];
		j2853671896 -> j936365052;
	j832629494 [label="Должны существовать поступки, которые сами по себе являются злом.",shape=box,color=red];
		j832629494 -> j3292006385;
	j1660827104 [label="Ты говоришь, что одному человеку нужен другой, чтобы быть «злым»?",shape=box,color=red];
		j1660827104 -> j3362296891;
	j353844893 [label="Не знаю, согласен ли я с этим.",shape=box,color=red];
		j353844893 -> j3292006385;
	j3292006385 [label="Все самые ужасающие поступки, которые может совершить человек, требуют наличия хотя бы ещё одного человека. В одиночестве, в вакууме, человек не способен ни на что, что можно было бы осудить. Уничтожить необитаемую планету? Ах, какое горе.",shape=box,color=blue];
		j3292006385 -> j11727660;
	j3362296891 [label="Да. Подумай об этом. Все самые ужасающие поступки, которые может совершить человек, требуют наличия хотя бы ещё одного человека. В одиночестве, в вакууме, человек не способен ни на что, что можно было бы осудить. Уничтожить необитаемую планету? Ах, какое горе.",shape=box,color=blue];
		j3362296891 -> j11727660;
	j11727660 [label="И если бы не общество, которое могло бы указать им пальцем и сказать: «Вам не следовало совершать этот ужасный поступок», как бы мы вообще поняли, насколько ужасен был этот поступок? Мы бы не поняли.",shape=box,color=blue];
		j11727660 -> j3041365378;
	j3041365378 [label="Как я уже сказал, это всего лишь мерило, используемое обществом для оценки ваших действий по сравнению с действиями других.",shape=box,color=blue];
		j3041365378 -> j3569568171;
		j3041365378 -> j3222186666;
	j3569568171 [label="Допустим, ты прав. Допустим, ты меня убедил, и добро и зло — всего лишь... социальные конструкты. Что тогда?",shape=box,color=red];
		j3569568171 -> j3433830980;
	j3222186666 [label="Я считаю, что поступки могут быть как хорошими, так и плохими вне социального контекста. Иначе почему так много поступков были бы похожи в совершенно разных обществах?",shape=box,color=red];
		j3222186666 -> j597069442;
	j3433830980 [label="Add -1 to Thermostat counter",color=orange];
		j3433830980 -> j190294099;
	j597069442 [label="Add 1 to Thermostat counter",color=orange];
		j597069442 -> j2179541653;
		j597069442 -> j855418290;
	j190294099 [label="+5 Chemistry",color=orange];
		j190294099 -> j1613909010;
	j2179541653 [label="Но ради аргумента, продолжим. ",shape=box,color=red];
		j2179541653 -> j190294099;
	j855418290 [label="Наверное, лучше остановиться здесь. Не думаю, что из этого что-то выйдет. [Конец.]",shape=box,color=red];
		j855418290 -> j3077143581;
	j1613909010 [label="Очень хорошо. Если мы можем сказать, что «зло» — это не состояние, а социальный конструкт, то мы можем согласиться с тем, что все истории о великом злодействе, в свою очередь, являются социальными конструктами. Байками.",shape=box,color=blue];
		j1613909010 -> j1390991102;
	j3077143581 [label="Как скажешь.",shape=box,color=blue];
		j3077143581 -> "Chat ends.";
	j1390991102 [label="Почему же во всех великих байках те, кто совершает величайшие злодеяния, остаются гнить в одиночестве?",shape=box,color=blue];
		j1390991102 -> j3406797267;
		j1390991102 -> j1479767409;
		j1390991102 -> j3536902583;
		j1390991102 -> j2501244464;
	j3406797267 [label="Потому что они не способны любить?",shape=box,color=red];
		j3406797267 -> j1801077029;
	j1479767409 [label="Потому что в их сердцах нет места для любви?",shape=box,color=red];
		j1479767409 -> j963889504;
	j3536902583 [label="Потому что они не заслуживают любви?",shape=box,color=red];
		j3536902583 -> j1198860557;
	j2501244464 [label="Потому что мы пытаемся преподать урок?",shape=box,color=red];
		j2501244464 -> j406141389;
	j1801077029 [label="Иногда, да, их изображают неким \nнечеловеческим злом, неспособным на любовь. Но почему? Я бы предположил, что все великие сказания существуют для того, чтобы преподать урок, не так ли?",shape=box,color=blue];
		j1801077029 -> j3467309189;
	j963889504 [label="Иногда, да, их показывают настолько поглощёнными своим Великим Злом, что они не снисходят до таких, так называемых, «мелочных вещей». Но почему? Все великие сказания существуют затем, чтобы преподать урок, не так ли?",shape=box,color=blue];
		j963889504 -> j3467309189;
	j1198860557 [label="Мм, теперь ты просто повторяешь мои слова, Узурпатор. Мы уже решили, что «заслуживать» — это относительное понятие. Подумай. Все великие сказания существуют для того, чтобы преподать урок, не так ли?",shape=box,color=blue];
		j1198860557 -> j3467309189;
	j406141389 [label="+5 Chemistry",color=orange];
		j406141389 -> j3495309;
	j3467309189 [label="А если бы мы показали Великое Зло, живущее мирно, счастливо, прекрасно — в любви… ну… каков же был бы тогда урок?",shape=box,color=blue];
		j3467309189 -> j2249956020;
		j3467309189 -> j1321612343;
		j3467309189 -> j294992121;
	j3495309 [label="Такова была бы моя теория, да! Все великие сказания существуют для того, чтобы преподать урок, не так ли?",shape=box,color=blue];
		j3495309 -> j3467309189;
	j2249956020 [label="Трудно смириться с тем, что кто-то «злой» и при этом способен любить.",shape=box,color=red];
		j2249956020 -> j362925635;
	j1321612343 [label="А может быть, их «злые дела» все ещё можно искупить любовью?",shape=box,color=red];
		j1321612343 -> j3811307403;
	j294992121 [label="То есть те, кто совершает «злые поступки», всё ещё могут представлять ценность для кого-то другого в этом мире и, следовательно, не являются «чистым злом»?",shape=box,color=red];
		j294992121 -> j1150640668;
	j362925635 [label="Check boolean RoatheMargulis1",color=orange];
		j362925635 -> j4017093412 [label=true,color=green];
		j362925635 -> j1031101646 [label=false,color=brown];
	j3811307403 [label="Add 1 to Thermostat counter",color=orange];
		j3811307403 -> j2895226070;
	j1150640668 [label="Add -1 to Thermostat counter",color=orange];
		j1150640668 -> j717648439;
	j4017093412 [label="+5 Chemistry",color=orange];
		j4017093412 -> j966999822;
	j1031101646 [label="+5 Chemistry",color=orange];
		j1031101646 -> j979442153;
	j2895226070 [label="Ты звучишь как фанатики. «Искупление». Но ты стучишься в дверь истины. Потому что ты подразумеваешь, что оба не могут существовать одновременно в нашем мире, и это верно, не так ли? Любовь и зло не могут сосуществовать в обществе.",shape=box,color=blue];
		j2895226070 -> j603738447;
	j717648439 [label="Ты близок, но ещё не совсем. Да, но подумай глубже. Что бы значило, если бы человека, способного на злые деяния, всё же любил другой? Как бы это повлияло на общество?",shape=box,color=blue];
		j717648439 -> j603738447;
	j966999822 [label="Именно! Эти две вещи не хотят сосуществовать в наших умах, не так ли? Когда я рассказывал тебе историю про Балласа и Маргулис, было трудно принять, что их любовь друг к другу когда‑то была настоящей, не так ли?",shape=box,color=blue];
		j966999822 -> j2076027824;
	j979442153 [label="Именно! Эти две вещи не хотят сосуществовать в наших умах, не так ли? Если бы я сказал тебе, что Баллас и Маргулис когда‑то были глубоко влюблены друг в друга, прежде чем всё пошло наперекосяк, ты бы поверил мне?",shape=box,color=blue];
		j979442153 -> j2076027824;
	j603738447 [label="Check boolean RoatheMargulis1",color=orange];
		j603738447 -> j3250655469 [label=true,color=green];
		j603738447 -> j2096829748 [label=false,color=brown];
	j2076027824 [label="Не вдаваясь в детали и не отходя слишком далеко от моего собственного правила держать разговор исключительно философским — они являются общей точкой отсчёта для нас обоих.",shape=box,color=blue];
		j2076027824 -> j3710626578;
	j3250655469 [label="Когда я рассказывал тебе историю про Балласа и Маргулис, было трудно принять, что их любовь друг к другу когда‑то была настоящей, не так ли?",shape=box,color=blue];
		j3250655469 -> j2076027824;
	j2096829748 [label="Если бы я сказал тебе, что Баллас и Маргулис когда‑то были глубоко влюблены друг в друга, прежде чем всё пошло наперекосяк, ты бы поверил мне?",shape=box,color=blue];
		j2096829748 -> j2076027824;
	j3710626578 [label="Не вызывает сомнений, что Баллас был способен на одни из самых чистых форм жестокости, какие когда-либо знало человечество. И всё же он знал любовь. Взаимную любовь. ",shape=box,color=blue];
		j3710626578 -> j809595370;
	j809595370 [label="Это факт, хотя ты, возможно, захочешь это отрицать, Баллас и Маргулис глубоко любили друг друга. Всё просто ужасно пошло наперекосяк.",shape=box,color=blue];
		j809595370 -> j928617722;
	j928617722 [label="Boolean RoatheMargulis1 is now true.",color=orange];
		j928617722 -> j4292924100;
	j4292924100 [label="Но мы должны очистить эту историю от их любви. Мы должны сказать, что её не существовало. Мы должны сказать, что она была нереальной, что это была выдумка. Почему?",shape=box,color=blue];
		j4292924100 -> j1352989293;
		j4292924100 -> j433756508;
		j4292924100 -> j3807827992;
	j1352989293 [label="Я не знаю.",shape=box,color=red];
		j1352989293 -> j2073603637;
	j433756508 [label="Потому что любовь — это высшее человеческое чувство, и если мы позволяем себе думать, что кого-то можно любить, это делает его более человечным.",shape=box,color=red];
		j433756508 -> j1811855384;
	j3807827992 [label="Потому что злу нужно посмотреть в зеркало и поработать над собой, чтобы измениться. Его нужно наказать. А любить и быть любимым — это высшая награда.",shape=box,color=red];
		j3807827992 -> j1595744434;
	j2073603637 [label="И вся эта работа оказалась напрасной. Жаль.",shape=box,color=blue];
		j2073603637 -> "Chat ends.";
	j1811855384 [label="Add -2 to Thermostat counter",color=orange];
		j1811855384 -> j271532110;
	j1595744434 [label="Add 2 to Thermostat counter",color=orange];
		j1595744434 -> j163686884;
