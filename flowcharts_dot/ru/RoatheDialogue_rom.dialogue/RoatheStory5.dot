	"Chat ends." [color=orange];
	j3789050628 [label="VM: INVENTION",shape=box,color=blue];
		j3789050628 -> j1157285321;
	j1157285321 [label="Транскрипт: Теперь я помню, что достижения военной Архимедеи сначала представлялись как развлечения. ",shape=box,color=blue];
		j1157285321 -> j161058609;
	j161058609 [label="Like debauched roués watching criminals put to death in an arena-circus.",shape=box,color=blue];
		j161058609 -> j2337985698;
	j2337985698 [label="Мы думали, что придумываем новые и захватывающие способы уничтожить значительно слабого врага.",shape=box,color=blue];
		j2337985698 -> j2769633727;
	j2769633727 [label="Как же мы льстили сами себе. На самом деле мы изо всех сил изобретали что‑то новое, осознавая, что наши противники, способные к непрерывным изменениям, нас превосходят.",shape=box,color=blue];
		j2769633727 -> j4171081147;
	j4171081147 [label="They tore through us like swarming children devouring their bloated mother.",shape=box,color=blue];
		j4171081147 -> j3787838065;
	j3787838065 [label="Desiccated, crushed between the pages of time, we had simply been out-evolved.",shape=box,color=blue];
		j3787838065 -> j921430358;
	j921430358 [label="Add 1 to HellStory counter",color=orange];
		j921430358 -> "Chat ends.";
}