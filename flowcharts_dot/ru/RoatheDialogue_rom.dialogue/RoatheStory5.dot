	j3954526738 [label="ГС: ИЗОБРЕТЕНИЕ",shape=box,color=blue];
		j3954526738 -> j3690533366;
	j3690533366 [label="Транскрипт: Теперь я помню, что достижения военной Архимедеи сначала представлялись как развлечения. ",shape=box,color=blue];
		j3690533366 -> j3262389029;
	j3262389029 [label="Словно развращенные зеваки, наблюдающие за казнью преступников на аренах цирков.",shape=box,color=blue];
		j3262389029 -> j3016692783;
	j3016692783 [label="Мы думали, что придумываем новые и захватывающие способы уничтожить значительно слабого врага.",shape=box,color=blue];
		j3016692783 -> j8535073;
	j8535073 [label="Как же мы льстили сами себе. На самом деле мы изо всех сил изобретали что‑то новое, осознавая, что наши противники, способные к непрерывным изменениям, нас превосходят.",shape=box,color=blue];
		j8535073 -> j1065562831;
	j1065562831 [label="Они рвали нас, как рой детей, пожирающих свою раздувшуюся мать.",shape=box,color=blue];
		j1065562831 -> j1693556130;
	j1693556130 [label="Высушенные, раздавленные между страницами времени, мы просто оказались превзойдены эволюцией.",shape=box,color=blue];
		j1693556130 -> j921430358;
	j921430358 [label="Add 1 to HellStory counter",color=orange];
		j921430358 -> "Chat ends.";
}