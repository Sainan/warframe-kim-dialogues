digraph {
	"RoatheRank3Convo5 begins." [color=orange];
		"RoatheRank3Convo5 begins." -> j1345902616;
	j1345902616 [label="Альбрехт с самого начала был проблемой. Он и весь этот бизнес с Бездной. Думаю, ему дали Джеривейну в надежде, что семья как-то его успокоит.",shape=box,color=blue];
		j1345902616 -> j1942340615;
	j1942340615 [label="Но, по-моему, это только всё усугубило. Как только у него появились дети, он стал воспринимать их как дополнительную пару рук. Сообщников в своих безумных экспериментах.",shape=box,color=blue];
		j1942340615 -> j2033177535;
	j2033177535 [label="Расходный материал. Как и всё в его жизни.",shape=box,color=blue];
		j2033177535 -> j3271118042;
		j2033177535 -> j3279703417;
		j2033177535 -> j1310452999;
	j3271118042 [label="Джеривейн?",shape=box,color=red];
		j3271118042 -> j4104724708;
	j3279703417 [label="Он воспринимает людей не просто как расходный материал.",shape=box,color=red];
		j3279703417 -> j882400036;
	j1310452999 [label="[Конец.]",shape=box,color=red];
		j1310452999 -> "Chat ends.";
	j4104724708 [label="Имя, которое, возможно, затерялось в летописях времени…Жена Альбрехта Энтрати, Узурпатор. Мать его детей.",shape=box,color=blue];
		j4104724708 -> j4103666644;
	j882400036 [label="Хорошо, я признаю, что он убьёт кого угодно и что угодно в своей жизни с хладнокровием любого Исполнителя. Но он не станет делать это без причины.",shape=box,color=blue];
		j882400036 -> j41314749;
	"Chat ends." [color=orange];
	j4103666644 [label="Check boolean LoidFamilyComplete",color=orange];
		j4103666644 -> j2246393526 [label=true,color=green];
		j4103666644 -> j933152447 [label=false,color=brown];
	j41314749 [label="Знаешь, теперь, когда я об этом размышляю, именно его бесстрастная натура делала его столь опасным в наше время. Он был способен пожертвовать чем угодно ради достижения своих целей. Абсолютно всем.",shape=box,color=blue];
		j41314749 -> j1794946522;
		j41314749 -> j2608434048;
	j2246393526 [label="Но вот так, скорее всего, ты снова пытаешься меня обмануть, поскольку весьма вероятно, что ты уже знал эту информацию, раз дворецкий снова с ними на связи.",shape=box,color=blue];
		j2246393526 -> j771635318;
	j933152447 [label="Те, кто блаженно восседают, не подозревая о нашем существовании, в этом гниющем Святилище. Которое я до сих пор считаю совершенно бесценным.",shape=box,color=blue];
		j933152447 -> j41314749;
	j1794946522 [label="Я полагал, что Орокин не станут возражать против того, чтобы пожертвовать тем, что им дорого. Вы же все казались крайне беспощадными друг к другу.",shape=box,color=red];
		j1794946522 -> j101447813;
	j2608434048 [label="А ты как думаешь?",shape=box,color=red];
		j2608434048 -> j3800943773;
	j771635318 [label="Но я не собираюсь вступать с тобой в ещё один спор по этому поводу. У меня нет настроения.",shape=box,color=blue];
		j771635318 -> j41314749;
	j101447813 [label="Ты слишком охотно делаешь выводы о том, о чём совершенно ничего не знаешь, Скиталец.",shape=box,color=blue];
		j101447813 -> j1821399190;
	j3800943773 [label="+10 Chemistry",color=orange];
		j3800943773 -> j2606575180;
	j1821399190 [label="Или у тебя кожа с синим оттенком, который я пропустил? Ты был Орокин? Если да, прошу принять мои глубочайшие и самые искренние извинения! ",shape=box,color=blue];
		j1821399190 -> j4073182167;
		j1821399190 -> j391017971;
	j2606575180 [label="Можно считать распространённым заблуждением, что всё, чем занимались мы, Орокин, это предательства и убийства друг друга. Да, подобного хватало, не поймите меня неправильно. Мы были почти бессмертны, и мало чем ещё могли заняться.",shape=box,color=blue];
		j2606575180 -> j493489673;
	j4073182167 [label="Прости. Я не хотел тебя обидеть. Честно говоря, я сам мало что помню об обществе Орокин, я был в стороне, наблюдал за ними.",shape=box,color=red];
		j4073182167 -> j114405206;
	j391017971 [label="Прости, если мои воспоминания об обществе Орокин оказались не лучшими. В основном это были записанные приказы, что лаяли на меня из динамиков. Это было ещё до того, как я застрял в Бездне...",shape=box,color=red];
		j391017971 -> j2285348752;
	j493489673 [label="Но мы также были глубоко страстным народом. Никто не создавал искусства так, как создавали его Орокин. Никто не писал музыку, не ставил театральные постановки и не писал стихи, как мы.",shape=box,color=blue];
		j493489673 -> j2230964924;
	j114405206 [label="Извинения приняты. На этот раз. Мне и так приходится терпеть подобное неуважение от всех вокруг. Как бы ты ни был интересен, я не чужая подушка для иголок. У меня есть способы провести своё время поинтересней.",shape=box,color=blue];
		j114405206 -> j3390361542;
	j2285348752 [label="Boolean RoatheInsulted is now true.",color=orange];
		j2285348752 -> j2918158600;
	j2230964924 [label="И никто не любил так сильно, как мы, когда наши сердца отдавались другому.",shape=box,color=blue];
		j2230964924 -> j2241900052;
	j3390361542 [label="На чём я остановился? Ах да. Наш бесстрастный Энтрати.",shape=box,color=blue];
		j3390361542 -> j2606575180;
	j2918158600 [label="Предупреждение. Мне и так приходится терпеть подобное неуважение от всех вокруг. Как бы ты ни был интересен, я не чужая подушка для иголок. У меня есть способы провести своё время поинтересней.",shape=box,color=blue];
		j2918158600 -> j3390361542;
	j2241900052 [label="Всем, кроме Альбрехта. Всё, что он делал, каждый, с кем он взаимодействовал, казалось, он воспринимал через кусочек своего любимого синтстекла.",shape=box,color=blue];
		j2241900052 -> j1071450917;
	j1071450917 [label="Отстранённо. Безразлично. Неинтересно. Без влияния. Даже когда Джеривейн умерла, и ему пришлось самому растить свою маленькую дочку.",shape=box,color=blue];
		j1071450917 -> j1969269467;
	j1969269467 [label="Check boolean LoidFamilyComplete",color=orange];
		j1969269467 -> j305014889 [label=true,color=green];
		j1969269467 -> j587483188 [label=false,color=brown];
	j305014889 [label="Тот, кто, по праву, вероятно, был предназначен добиться куда большего, чем он когда-либо сделал. Если только она не оказалась заражённой и приросшей к месту. Какая пустая трата.",shape=box,color=blue];
		j305014889 -> j2660495267;
		j305014889 -> j210115734;
	j587483188 [label="Тот, кто, по праву, вероятно, был предназначен добиться куда большего, чем он когда-либо сделал. Не терпится увидеть, во что она и остальные рода Энтрати превратились. Во всей их… Заражённой славе.",shape=box,color=blue];
		j587483188 -> j1837902856;
		j587483188 -> j2489437852;
	j2660495267 [label="Я рад, что нам удалось убедить Лойда подняться наверх.",shape=box,color=red];
		j2660495267 -> j275368266;
	j210115734 [label="Я знаю, ты не помнишь, почему мы это сделали, но хорошо, что нам удалось поднять Лойда наверх.",shape=box,color=red];
		j210115734 -> j4238193987;
	j1837902856 [label="Я все еще сомневаюсь, что это лучшая идея...",shape=box,color=red];
		j1837902856 -> j1002740923;
	j2489437852 [label="Если мы всё же уговорим Лойда подняться наверх, что ты собираешься делать потом?",shape=box,color=red];
		j2489437852 -> j836869529;
	j275368266 [label="Так ты говоришь. А я, между тем, стою там как дурак, охраняю их, слушаю, как они обсуждают это воссоединение так, будто я помню, как оно произошло. Ты хоть представляешь, насколько это неловко?!",shape=box,color=blue];
		j275368266 -> j2975127034;
	j4238193987 [label="Ты вообще понимаешь, насколько это неловко — стоять там и притворяться, что я помню их воссоединение?! Когда я хоть убей не могу его вспомнить?!",shape=box,color=blue];
		j4238193987 -> j2975127034;
	j1002740923 [label="Хм, скорее всего, нет. Мне интересно, у тебя случайно нет адреса Альбрехта для пересылки почты?",shape=box,color=blue];
		j1002740923 -> j4103618404;
	j836869529 [label="Я ещё не решил. Возможно, начну отрубать им конечности и консервировать в жидкости. У тебя случайно нет адреса Альбрехта для пересылки?",shape=box,color=blue];
		j836869529 -> j2705167723;
	j2975127034 [label="Это как стоять на приёме, когда к тебе подходит кто-то, кто явно тебя знает, а у тебя нет ни малейшего воспоминания об этом человеке, но ты вынужден продолжать разговор так, будто ты его знаешь!",shape=box,color=blue];
		j2975127034 -> j262806575;
	j4103618404 [label="Нет, зачем тебе?",shape=box,color=red];
		j4103618404 -> j4058346693;
	j2705167723 [label="What?!",shape=box,color=red];
		j2705167723 -> j862471504;
	j262806575 [label="Ты хоть немного понимаешь, в какой ад ты меня загнал?! Вообще?! Стоять там вот так – настоящее мучение, и всё из-за тебя! ",shape=box,color=blue];
		j262806575 -> j2008708440;
	j4058346693 [label="Я думал, что как только поднимусь наверх, начну отрубать конечности его семье и отправлять их ему в банках, по одной за раз.",shape=box,color=blue];
		j4058346693 -> j2705167723;
	j862471504 [label="+10 Chemistry",color=orange];
		j862471504 -> j3335736803;
	j2008708440 [label="Ба, хватит об этом. Мне нужно выпить.",shape=box,color=blue];
		j2008708440 -> j1933300832;
	j3335736803 [label="Успокойся! Неужели здесь никто не понимает шуток?",shape=box,color=blue];
		j3335736803 -> j1924690255;
	j1933300832 [label="+10 Chemistry",color=orange];
		j1933300832 -> "Chat ends.";
	j1924690255 [label="Кто бы вообще отправлял их за меня, в любом случае?",shape=box,color=blue];
		j1924690255 -> "Chat ends.";
}