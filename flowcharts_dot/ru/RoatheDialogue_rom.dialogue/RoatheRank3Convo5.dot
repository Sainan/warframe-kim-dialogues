digraph {
	1995 [label="RoatheRank3Convo5 begins.",color=orange];
		1995 -> 1996;
	1996 [label="Альбрехт с самого начала был проблемой. Он и весь этот бизнес с Бездной. Думаю, ему дали Джеривейну в надежде, что семья как-то его успокоит.",shape=box,color=blue];
		1996 -> 1997;
	1997 [label="Но, по-моему, это только всё усугубило. Как только у него появились дети, он стал воспринимать их как дополнительную пару рук. Сообщников в своих безумных экспериментах.",shape=box,color=blue];
		1997 -> 1998;
	1998 [label="Расходный материал. Как и всё в его жизни.",shape=box,color=blue];
		1998 -> 2001;
		1998 -> 2000;
		1998 -> 1999;
	2001 [label="Джеривейн?",shape=box,color=red];
		2001 -> 2004;
	2000 [label="Он воспринимает людей не просто как расходный материал.",shape=box,color=red];
		2000 -> 2003;
	1999 [label="[Конец.]",shape=box,color=red];
		1999 -> 2002;
	2004 [label="Имя, которое, возможно, затерялось в летописях времени…Жена Альбрехта Энтрати, Узурпатор. Мать его детей.",shape=box,color=blue];
		2004 -> 2006;
	2003 [label="Хорошо, я признаю, что он убьёт кого угодно и что угодно в своей жизни с хладнокровием любого Исполнителя. Но он не станет делать это без причины.",shape=box,color=blue];
		2003 -> 2005;
	2002 [label="Chat ends.",color=orange];
	2006 [label="Check boolean LoidFamilyComplete",color=orange];
		2006 -> 2009 [label=true,color=green];
		2006 -> 2010 [label=false,color=brown];
	2005 [label="Знаешь, теперь, когда я об этом размышляю, именно его бесстрастная натура делала его столь опасным в наше время. Он был способен пожертвовать чем угодно ради достижения своих целей. Абсолютно всем.",shape=box,color=blue];
		2005 -> 2007;
		2005 -> 2008;
	2009 [label="Но вот так, скорее всего, ты снова пытаешься меня обмануть, поскольку весьма вероятно, что ты уже знал эту информацию, раз дворецкий снова с ними на связи.",shape=box,color=blue];
		2009 -> 2013;
	2010 [label="Те, кто блаженно восседают, не подозревая о нашем существовании, в этом гниющем Святилище. Которое я до сих пор считаю совершенно бесценным.",shape=box,color=blue];
		2010 -> 2005;
	2007 [label="Я полагал, что Орокин не станут возражать против того, чтобы пожертвовать тем, что им дорого. Вы же все казались крайне беспощадными друг к другу.",shape=box,color=red];
		2007 -> 2011;
	2008 [label="А ты как думаешь?",shape=box,color=red];
		2008 -> 2012;
	2013 [label="Но я не собираюсь вступать с тобой в ещё один спор по этому поводу. У меня нет настроения.",shape=box,color=blue];
		2013 -> 2005;
	2011 [label="Ты слишком охотно делаешь выводы о том, о чём совершенно ничего не знаешь, Скиталец.",shape=box,color=blue];
		2011 -> 2014;
	2012 [label="+10 Chemistry",color=orange];
		2012 -> 2015;
	2014 [label="Или у тебя кожа с синим оттенком, который я пропустил? Ты был Орокин? Если да, прошу принять мои глубочайшие и самые искренние извинения! ",shape=box,color=blue];
		2014 -> 2016;
		2014 -> 2017;
	2015 [label="Можно считать распространённым заблуждением, что всё, чем занимались мы, Орокин, это предательства и убийства друг друга. Да, подобного хватало, не поймите меня неправильно. Мы были почти бессмертны, и мало чем ещё могли заняться.",shape=box,color=blue];
		2015 -> 2018;
	2016 [label="Прости. Я не хотел тебя обидеть. Честно говоря, я сам мало что помню об обществе Орокин, я был в стороне, наблюдал за ними.",shape=box,color=red];
		2016 -> 2019;
	2017 [label="Прости, если мои воспоминания об обществе Орокин оказались не лучшими. В основном это были записанные приказы, что лаяли на меня из динамиков. Это было ещё до того, как я застрял в Бездне...",shape=box,color=red];
		2017 -> 2020;
	2018 [label="Но мы также были глубоко страстным народом. Никто не создавал искусства так, как создавали его Орокин. Никто не писал музыку, не ставил театральные постановки и не писал стихи, как мы.",shape=box,color=blue];
		2018 -> 2021;
	2019 [label="Извинения приняты. На этот раз. Мне и так приходится терпеть подобное неуважение от всех вокруг. Как бы ты ни был интересен, я не чужая подушка для иголок. У меня есть способы провести своё время поинтересней.",shape=box,color=blue];
		2019 -> 2022;
	2020 [label="Update boolean RoatheInsulted",color=orange];
		2020 -> 2023;
	2021 [label="И никто не любил так сильно, как мы, когда наши сердца отдавались другому.",shape=box,color=blue];
		2021 -> 2024;
	2022 [label="На чём я остановился? Ах да. Наш бесстрастный Энтрати.",shape=box,color=blue];
		2022 -> 2015;
	2023 [label="Предупреждение. Мне и так приходится терпеть подобное неуважение от всех вокруг. Как бы ты ни был интересен, я не чужая подушка для иголок. У меня есть способы провести своё время поинтересней.",shape=box,color=blue];
		2023 -> 2022;
	2024 [label="Всем, кроме Альбрехта. Всё, что он делал, каждый, с кем он взаимодействовал, казалось, он воспринимал через кусочек своего любимого синтстекла.",shape=box,color=blue];
		2024 -> 2025;
	2025 [label="Отстранённо. Безразлично. Неинтересно. Без влияния. Даже когда Джеривейн умерла, и ему пришлось самому растить свою маленькую дочку.",shape=box,color=blue];
		2025 -> 2026;
	2026 [label="Check boolean LoidFamilyComplete",color=orange];
		2026 -> 2028 [label=true,color=green];
		2026 -> 2027 [label=false,color=brown];
	2028 [label="Тот, кто, по праву, вероятно, был предназначен добиться куда большего, чем он когда-либо сделал. Если только она не оказалась заражённой и приросшей к месту. Какая пустая трата.",shape=box,color=blue];
		2028 -> 2031;
		2028 -> 2032;
	2027 [label="Тот, кто, по праву, вероятно, был предназначен добиться куда большего, чем он когда-либо сделал. Не терпится увидеть, во что она и остальные рода Энтрати превратились. Во всей их… Заражённой славе.",shape=box,color=blue];
		2027 -> 2029;
		2027 -> 2030;
	2031 [label="Я рад, что нам удалось убедить Лойда подняться наверх.",shape=box,color=red];
		2031 -> 2035;
	2032 [label="Я знаю, ты не помнишь, почему мы это сделали, но хорошо, что нам удалось поднять Лойда наверх.",shape=box,color=red];
		2032 -> 2036;
	2029 [label="Я все еще сомневаюсь, что это лучшая идея...",shape=box,color=red];
		2029 -> 2033;
	2030 [label="Если мы всё же уговорим Лойда подняться наверх, что ты собираешься делать потом?",shape=box,color=red];
		2030 -> 2034;
	2035 [label="Так ты говоришь. А я, между тем, стою там как дурак, охраняю их, слушаю, как они обсуждают это воссоединение так, будто я помню, как оно произошло. Ты хоть представляешь, насколько это неловко?!",shape=box,color=blue];
		2035 -> 2039;
	2036 [label="Ты вообще понимаешь, насколько это неловко — стоять там и притворяться, что я помню их воссоединение?! Когда я хоть убей не могу его вспомнить?!",shape=box,color=blue];
		2036 -> 2039;
	2033 [label="Хм, скорее всего, нет. Мне интересно, у тебя случайно нет адреса Альбрехта для пересылки почты?",shape=box,color=blue];
		2033 -> 2037;
	2034 [label="Я ещё не решил. Возможно, начну отрубать им конечности и консервировать в жидкости. У тебя случайно нет адреса Альбрехта для пересылки?",shape=box,color=blue];
		2034 -> 2038;
	2039 [label="Это как стоять на приёме, когда к тебе подходит кто-то, кто явно тебя знает, а у тебя нет ни малейшего воспоминания об этом человеке, но ты вынужден продолжать разговор так, будто ты его знаешь!",shape=box,color=blue];
		2039 -> 2042;
	2037 [label="Нет, зачем тебе?",shape=box,color=red];
		2037 -> 2040;
	2038 [label="What?!",shape=box,color=red];
		2038 -> 2041;
	2042 [label="Ты хоть немного понимаешь, в какой ад ты меня загнал?! Вообще?! Стоять там вот так – настоящее мучение, и всё из-за тебя! ",shape=box,color=blue];
		2042 -> 2044;
	2040 [label="Я думал, что как только поднимусь наверх, начну отрубать конечности его семье и отправлять их ему в банках, по одной за раз.",shape=box,color=blue];
		2040 -> 5776;
	2041 [label="+10 Chemistry",color=orange];
		2041 -> 2043;
	2044 [label="Ба, хватит об этом. Мне нужно выпить.",shape=box,color=blue];
		2044 -> 2046;
	5776 [label="What?!",shape=box,color=red];
		5776 -> 2041;
	2043 [label="Успокойся! Неужели здесь никто не понимает шуток?",shape=box,color=blue];
		2043 -> 2045;
	2046 [label="+10 Chemistry",color=orange];
		2046 -> 2048;
	2045 [label="Кто бы вообще отправлял их за меня, в любом случае?",shape=box,color=blue];
		2045 -> 2047;
	2048 [label="Chat ends.",color=orange];
	2047 [label="Chat ends.",color=orange];
}