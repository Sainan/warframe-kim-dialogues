digraph {
	graph [fontname="Roboto Condensed"];
	node [fontname="Roboto Condensed"];
	edge [fontname="Roboto Condensed"];

	"RoatheRank3Convo6 begins." [color=orange];
		"RoatheRank3Convo6 begins." -> j2327550162;
		"RoatheRank3Convo6 begins." -> j1649999190;
		"RoatheRank3Convo6 begins." -> j1310452999;
	j2327550162 [label="Почему ты проводишь так много времени с Кавией, Роут?",shape=box,color=red];
		j2327550162 -> j718639233;
	j1649999190 [label="Держись подальше от Кавии, Роут. Это меня нервирует.",shape=box,color=red];
		j1649999190 -> j2046967938;
	j1310452999 [label="[Конец.]",shape=box,color=red];
		j1310452999 -> "Chat ends.";
	j718639233 [label="Хм? Что ж… я считаю их одними из самых безнадёжно несчастных и жалких созданий, которых мне доводилось встречать во всей Бездной проклятой Изначальной Системе. ",shape=box,color=blue];
		j718639233 -> j2808598182;
	j2046967938 [label="Чтобы свести к минимуму недопонимание в этой ситуации, я воздержусь от своей обычной многословности и просто скажу следующее: ",shape=box,color=blue];
		j2046967938 -> j3865447782;
	"Chat ends." [color=orange];
	j2808598182 [label="Подопытные животные. Подопытные животные, Альбрехт! Ты бросал животных в чёртову Бездну, а когда они вылезали оттуда, лепеча на выдуманном тобой детском языке, ты приказал своему дворецкому их усыпить?!",shape=box,color=blue];
		j2808598182 -> j3107024120;
	j3865447782 [label="Нет.",shape=box,color=blue];
		j3865447782 -> "Chat ends.";
	j3107024120 [label="Вечно перекладывает свою грязную работу на других. Но я отвлёкся. Ты спрашиваешь, почему я сижу и разговариваю с ними. Особенно с птицей. Всё очень просто. Но я хочу, чтобы ты догадался сам. Хочу увидеть, сможешь ли ты это понять.",shape=box,color=blue];
		j3107024120 -> j731338476;
		j3107024120 -> j2354287231;
		j3107024120 -> j991831314;
		j3107024120 -> j2165318843;
		j3107024120 -> j3398066121;
	j731338476 [label="Он не знает, кто ты.",shape=box,color=red];
		j731338476 -> j549515903;
	j2354287231 [label="Птичка 3 любит всех.",shape=box,color=red];
		j2354287231 -> j2213163157;
	j991831314 [label="Тебе нравится окружать себя людьми, которые помогают тебе чувствовать себя умным.",shape=box,color=red];
		j991831314 -> j1824954581;
	j2165318843 [label="Он внимательно наблюдает за окружающими его людьми.",shape=box,color=red];
		j2165318843 -> j692408874;
	j3398066121 [label="Потому что им легко манипулировать.",shape=box,color=red];
		j3398066121 -> j1824954581;
	j549515903 [label="Да. В некотором смысле именно так. Он не знает, кто я. Он ничего не знает о «Дьяволе Тау». И ему… более того, всё равно.",shape=box,color=blue];
		j549515903 -> j4211592944;
	j2213163157 [label="Да, он такой. Он довольно очарователен в своей наивной невинности. Но ты хочешь сказать, чуть более мягко и косвенно, что никто другой не сможет меня полюбить, да?",shape=box,color=blue];
		j2213163157 -> j4119738654;
	j1824954581 [label="Хотелось бы, чтобы ты понимал, насколько ты заблуждаешься. Как далеко от цели летит твоя стрела... но ты не одинок в своём мнении обо мне.",shape=box,color=blue];
		j1824954581 -> j3139969595;
	j692408874 [label="Да, действительно. И его наблюдения довольно полезны, но это ничего такого, чего бы я не смог понять сам всего за несколько мгновений.",shape=box,color=blue];
		j692408874 -> j1666523557;
	j4211592944 [label="+10 Chemistry",color=orange];
		j4211592944 -> j3024778875;
	j4119738654 [label="Так значит, мне придётся полагаться на идиотскую птичку в качестве компании? Но ты достаточно близок к правде, так что, полагаю, я поставлю тебе… проходной балл.",shape=box,color=blue];
		j4119738654 -> j3024778875;
	j3139969595 [label="Отнюдь не один.",shape=box,color=blue];
		j3139969595 -> j3705997063;
	j1666523557 [label="Говоря немного мягче и окольным образом, ты хочешь сказать, что, по твоему мнению, я использую большую говорящую птицу в своих целях? Так ли это?",shape=box,color=blue];
		j1666523557 -> j164697596;
	j3024778875 [label="Для него я не Роут. Я не Орокин. Я не преступник. И не предатель. И не трус. Я могу просто быть... собой.",shape=box,color=blue];
		j3024778875 -> j1126756143;
	j3705997063 [label="Boolean RoatheAlone1 is now true.",color=orange];
		j3705997063 -> j4081414586;
	j164697596 [label="Нет. Но ты не одинок в своём мнении обо мне. Совсем не одинок.",shape=box,color=blue];
		j164697596 -> j3705997063;
	j1126756143 [label="Не думаю, что смогу описать тебе, какое это простое и редкое облегчение...",shape=box,color=blue];
		j1126756143 -> j53233369;
		j1126756143 -> j4115959625;
		j1126756143 -> j1909435084;
	j4081414586 [label="+5 Chemistry",color=orange];
		j4081414586 -> "Chat ends.";
	j53233369 [label="Ты можешь всё отпустить, знаешь ли. Ты можешь измениться. Даже здесь, даже сейчас.",shape=box,color=red];
		j53233369 -> j2235477754;
	j4115959625 [label="Должно быть, это ужасное бремя. Соответствовать ожиданиям, связанным с твоей репутацией, где бы ты ни был, даже здесь.",shape=box,color=red];
		j4115959625 -> j2991868519;
	j1909435084 [label="Ты намекаешь, что всё остальное — это некая маска, которую ты надеваешь?",shape=box,color=red];
		j1909435084 -> j3709741896;
	j2235477754 [label="Add 2 to Thermostat counter",color=orange];
		j2235477754 -> j2507518622;
	j2991868519 [label="Add -1 to Thermostat counter",color=orange];
		j2991868519 -> j3752074643;
	j3709741896 [label="Если бы всё было так просто, и всё это было бы лишь великолепным фасадом, который я мог бы сменить, словно на маскараде! Нет, Узурпатор. Вот кто я, до каждой гнилой кости.",shape=box,color=blue];
		j3709741896 -> j3876637680;
	j2507518622 [label="Было бы всё так просто, Узурпатор. Ты заставляешь это звучать так заманчиво. Могу ли я? Возможно… Возможно, ещё не слишком поздно даже для такого печального, трагичного дьявола, как я.",shape=box,color=blue];
		j2507518622 -> j3580997114;
	j3752074643 [label="+10 Chemistry",color=orange];
		j3752074643 -> j2352410741;
	j3876637680 [label="Но это не значит, что я не наслаждаюсь возможностью на час отложить всё бремя и просто побеседовать с тем, кто не ведает обо всех ужасных преступлениях, что я совершил за свою жизнь.",shape=box,color=blue];
		j3876637680 -> j172570375;
	j3580997114 [label="+10 Chemistry",color=orange];
		j3580997114 -> j119043432;
	j2352410741 [label="Это изматывает, Узурпатор. И если бы я мог отбросить эту персону, словно какой-то маскарадный образ, и никогда больше к ней не возвращаться. Но это то, кто я есть, до каждой гнилой кости.",shape=box,color=blue];
		j2352410741 -> j3876637680;
	j172570375 [label="Boolean RoatheBirdThree is now true.",color=orange];
		j172570375 -> j1090596967;
		j172570375 -> j3452684771;
	j119043432 [label="Это всего лишь великолепная маска, которую я ношу? Или это глубоко засело во мне, в самой гнилой кости? Пока не знаю. Могу лишь сказать, что я всё ещё наслаждаюсь возможностью выложить всё на часок, когда есть такая возможность.",shape=box,color=blue];
		j119043432 -> j4289555376;
	j1090596967 [label="Извините, если это покажется грубым, но... похоже, ты прожил одинокую жизнь.",shape=box,color=red];
		j1090596967 -> j2902082429;
	j3452684771 [label="Ты ведь не привык иметь много друзей, не так ли?",shape=box,color=red];
		j3452684771 -> j2539663690;
	j4289555376 [label="Я снимаю эту ношу и сижу рядом с тем, кто не ведает о моих ужасных преступлениях, разговариваю с огромной, очаровательно бестолковой птицей и обретаю… покой. Впервые за долгое время.",shape=box,color=blue];
		j4289555376 -> j749583889;
	j2902082429 [label="Evaluate expressions",color=orange];
		j2902082429 -> j1865622485 [label="RoatheUnloved1, RoatheKnowsReset2",color=purple];
		j2902082429 -> j3994646235 [label="RoatheKnowsReset2",color=purple];
		j2902082429 -> j763989415 [label="RoatheUnloved1",color=purple];
		j2902082429 -> j2665204154 [label="false",color=purple];
	j2539663690 [label="Check boolean RoatheKnowsReset2",color=orange];
		j2539663690 -> j1304905329 [label=true,color=green];
		j2539663690 -> j693088447 [label=false,color=brown];
	j749583889 [label="Может, в твоих словах действительно есть надежда. А может, я просто обманываю себя. И это лишь минутная передышка.",shape=box,color=blue];
		j749583889 -> j172570375;
	j1865622485 [label="Да, так и было. Или, по крайней мере, той частью, что я ещё могу вспомнить. Или это ты забрал у меня, Узурпатор? То, что мы были любовниками, что я признался тебе в любви, а ты не чувствовал того же?",shape=box,color=blue];
		j1865622485 -> j958230154;
	j3994646235 [label="Признаю, так и было. По крайней мере, насколько я могу вспомнить. Удивит ли тебя то, что я ни разу в жизни не был влюблён? По‑настоящему, взаимно. Впрочем, возможно, это тебя и не шокирует. Мы, вероятно, уже проходили через всё это раньше.",shape=box,color=blue];
		j3994646235 -> j1032195001;
	j763989415 [label="Так и было. Долгой и одинокой. Но это всё моя вина, Узурпатор. Я здесь не для того, чтобы вызывать у тебя сочувствие или жалость.",shape=box,color=blue];
		j763989415 -> j456112125;
	j2665204154 [label="Признаюсь, так оно и было. По крайней мере, насколько я помню. Тебя удивит, что я ни разу не был влюблён? Но это всё моя вина, Узурпатор. Я здесь не для того, чтобы вызывать твоё сочувствие или жалость.",shape=box,color=blue];
		j2665204154 -> j1535872089;
	j1304905329 [label="Кто знает? Может, у меня были друзья, но я просто не могу их вспомнить, потому что мы с тобой дружили, пока ты не положил этому конец, а?",shape=box,color=blue];
		j1304905329 -> j4043119171;
	j693088447 [label="Кто знает? Возможно, у меня были друзья, но я просто не могу их вспомнить, потому что Энтрати покопался у меня в голове и стер воспоминания о них.",shape=box,color=blue];
		j693088447 -> j4043119171;
	j958230154 [label="Или наоборот? Ты безумно влюбился в самого Дьявола, но его сердце осталось к тебе равнодушным. В отчаянии ты сделал единственное, что мог: разорвал его разум в клочья!",shape=box,color=blue];
		j958230154 -> j3361283050;
	j1032195001 [label="Boolean RoatheUnloved1 is now true.",color=orange];
		j1032195001 -> j857497583;
	j456112125 [label="Boolean RoatheAlone1 is now true.",color=orange];
		j456112125 -> j833259267;
	j1535872089 [label="Boolean RoatheUnloved1 is now true.",color=orange];
		j1535872089 -> j456112125;
	j4043119171 [label="Вот уж много пользы это мне принесло.",shape=box,color=blue];
		j4043119171 -> "Chat ends.";
	j3361283050 [label="Evaluate expressions",color=orange];
		j3361283050 -> j1626929988 [label="RoatheDatingDeal",color=purple];
		j3361283050 -> j2094571787 [label="RoatheMarieDatingDeal",color=purple];
		j3361283050 -> j2094571787 [label="RoatheLyonDatingDeal",color=purple];
		j3361283050 -> j3967353105 [label="RoatheSerumDeal",color=purple];
		j3361283050 -> j3967353105 [label="RoatheFamilyDeal",color=purple];
