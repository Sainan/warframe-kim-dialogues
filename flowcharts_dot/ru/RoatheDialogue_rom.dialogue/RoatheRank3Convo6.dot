		j3361283050 -> j3967353105 [label="RoatheMarieEntratiDealNo",color=purple];
		j3361283050 -> j3967353105 [label="RoatheLyonConfessionDealNo",color=purple];
		j3361283050 -> j765366939 [label="false",color=purple];
	j857497583 [label="Интересно, это ли ты забрал у меня, Узурпатор? То, что мы были любовниками, что я признался тебе в любви, а ты не чувствовал того же?",shape=box,color=blue];
		j857497583 -> j958230154;
	j833259267 [label="Какое бы дурное мнение ты обо мне ни составил, я его заслуживаю. И ты, конечно же, не одинок в своём мнении. Совсем не одинок.",shape=box,color=blue];
		j833259267 -> "Chat ends.";
	j1626929988 [label="Трагично, да… Мне почти хочется узнать подробности, но кажется, что это всё равно что заглянуть в конец книги раньше времени.",shape=box,color=blue];
		j1626929988 -> j2465885718;
	j2094571787 [label="Но кого я обманываю?! Мы оба знаем, зачем ты это сделал, не так ли? И точно не из‑за любви ко мне. А из‑за любви к другому. Я просто впадаю в поэтические бредни.",shape=box,color=blue];
		j2094571787 -> j2465885718;
	j3967353105 [label="Но кого я обманываю?! Мы оба знаем, зачем ты это сделал, не так ли? И уж точно не из‑за любви ко мне. Да и вовсе не из‑за любви. Я просто впадаю в поэтические бредни.",shape=box,color=blue];
		j3967353105 -> j2465885718;
	j765366939 [label="Ба. Но какой смысл сидеть и разглагольствовать?",shape=box,color=blue];
		j765366939 -> j2465885718;
	j2465885718 [label="Я здесь не для того, чтобы вызывать у тебя сочувствие или жалость. Всё это — дело моих рук. Каким бы ни было дурное мнение, которое ты обо мне составил, — я его заслуживаю. И ты, конечно, не одинок в своём мнении. ",shape=box,color=blue];
		j2465885718 -> j1338444884;
