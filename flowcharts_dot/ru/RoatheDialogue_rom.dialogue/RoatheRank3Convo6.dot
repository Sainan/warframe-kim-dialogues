digraph {
	2049 [label="RoatheRank3Convo6 begins.",color=orange];
		2049 -> 2052;
		2049 -> 2050;
		2049 -> 2051;
	2052 [label="Почему ты проводишь так много времени с Кавией, Роут?",shape=box,color=red];
		2052 -> 2055;
	2050 [label="Держись подальше от Кавии, Роут. Это меня нервирует.",shape=box,color=red];
		2050 -> 2053;
	2051 [label="[Конец.]",shape=box,color=red];
		2051 -> 2054;
	2055 [label="Хм? Что ж… я считаю их одними из самых безнадёжно несчастных и жалких созданий, которых мне доводилось встречать во всей Бездной проклятой Изначальной Системе. ",shape=box,color=blue];
		2055 -> 2057;
	2053 [label="Чтобы свести к минимуму недопонимание в этой ситуации, я воздержусь от своей обычной многословности и просто скажу следующее: ",shape=box,color=blue];
		2053 -> 2056;
	2054 [label="Chat ends.",color=orange];
	2057 [label="Подопытные животные. Подопытные животные, Альбрехт! Ты бросал животных в чёртову Бездну, а когда они вылезали оттуда, лепеча на выдуманном тобой детском языке, ты приказал своему дворецкому их усыпить?!",shape=box,color=blue];
		2057 -> 2059;
	2056 [label="Нет.",shape=box,color=blue];
		2056 -> 2058;
	2059 [label="Вечно перекладывает свою грязную работу на других. Но я отвлёкся. Ты спрашиваешь, почему я сижу и разговариваю с ними. Особенно с птицей. Всё очень просто. Но я хочу, чтобы ты догадался сам. Хочу увидеть, сможешь ли ты это понять.",shape=box,color=blue];
		2059 -> 2060;
		2059 -> 2061;
		2059 -> 2062;
		2059 -> 2063;
		2059 -> 2064;
	2058 [label="Chat ends.",color=orange];
	2060 [label="Он не знает, кто ты.",shape=box,color=red];
		2060 -> 2065;
	2061 [label="Птичка 3 любит всех.",shape=box,color=red];
		2061 -> 2066;
	2062 [label="Тебе нравится окружать себя людьми, которые помогают тебе чувствовать себя умным.",shape=box,color=red];
		2062 -> 2067;
	2063 [label="Он внимательно наблюдает за окружающими его людьми.",shape=box,color=red];
		2063 -> 2068;
	2064 [label="Потому что им легко манипулировать.",shape=box,color=red];
		2064 -> 2069;
	2065 [label="Да. В некотором смысле именно так. Он не знает, кто я. Он ничего не знает о «Дьяволе Тау». И ему… более того, всё равно.",shape=box,color=blue];
		2065 -> 2070;
	2066 [label="Да, он такой. Он довольно очарователен в своей наивной невинности. Но ты хочешь сказать, чуть более мягко и косвенно, что никто другой не сможет меня полюбить, да?",shape=box,color=blue];
		2066 -> 2071;
	2067 [label="Хотелось бы, чтобы ты понимал, насколько ты заблуждаешься. Как далеко от цели летит твоя стрела... но ты не одинок в своём мнении обо мне.",shape=box,color=blue];
		2067 -> 2072;
	2068 [label="Да, действительно. И его наблюдения довольно полезны, но это ничего такого, чего бы я не смог понять сам всего за несколько мгновений.",shape=box,color=blue];
		2068 -> 2073;
	2069 [label="Хотелось бы, чтобы ты понимал, насколько ты заблуждаешься. Как далеко от цели летит твоя стрела... но ты не одинок в своём мнении обо мне.",shape=box,color=blue];
		2069 -> 2074;
	2070 [label="+10 Chemistry",color=orange];
		2070 -> 2075;
	2071 [label="Так значит, мне придётся полагаться на идиотскую птичку в качестве компании? Но ты достаточно близок к правде, так что, полагаю, я поставлю тебе… проходной балл.",shape=box,color=blue];
		2071 -> 2075;
	2072 [label="Отнюдь не один.",shape=box,color=blue];
		2072 -> 2076;
	2073 [label="Говоря немного мягче и окольным образом, ты хочешь сказать, что, по твоему мнению, я использую большую говорящую птицу в своих целях? Так ли это?",shape=box,color=blue];
		2073 -> 2077;
	2074 [label="Отнюдь не один.",shape=box,color=blue];
		2074 -> 2078;
	2075 [label="Для него я не Роут. Я не Орокин. Я не преступник. И не предатель. И не трус. Я могу просто быть... собой.",shape=box,color=blue];
		2075 -> 2079;
	2076 [label="Update boolean RoatheAlone1",color=orange];
		2076 -> 2080;
	2077 [label="Нет. Но ты не одинок в своём мнении обо мне. Совсем не одинок.",shape=box,color=blue];
		2077 -> 2078;
	2078 [label="Update boolean RoatheAlone1",color=orange];
		2078 -> 2081;
	2079 [label="Не думаю, что смогу описать тебе, какое это простое и редкое облегчение...",shape=box,color=blue];
		2079 -> 2082;
		2079 -> 2083;
		2079 -> 2084;
	2080 [label="+5 Chemistry",color=orange];
		2080 -> 2085;
	2081 [label="+5 Chemistry",color=orange];
		2081 -> 2086;
	2082 [label="Ты можешь всё отпустить, знаешь ли. Ты можешь измениться. Даже здесь, даже сейчас.",shape=box,color=red];
		2082 -> 2087;
	2083 [label="Должно быть, это ужасное бремя. Соответствовать ожиданиям, связанным с твоей репутацией, где бы ты ни был, даже здесь.",shape=box,color=red];
		2083 -> 2088;
	2084 [label="Ты намекаешь, что всё остальное — это некая маска, которую ты надеваешь?",shape=box,color=red];
		2084 -> 2089;
	2085 [label="Chat ends.",color=orange];
	2086 [label="Chat ends.",color=orange];
	2087 [label="Add 2 to Thermostat",color=orange];
		2087 -> 2090;
	2088 [label="Add -1 to Thermostat",color=orange];
		2088 -> 2091;
	2089 [label="Если бы всё было так просто, и всё это было бы лишь великолепным фасадом, который я мог бы сменить, словно на маскараде! Нет, Узурпатор. Вот кто я, до каждой гнилой кости.",shape=box,color=blue];
		2089 -> 2092;
	2090 [label="Было бы всё так просто, Узурпатор. Ты заставляешь это звучать так заманчиво. Могу ли я? Возможно… Возможно, ещё не слишком поздно даже для такого печального, трагичного дьявола, как я.",shape=box,color=blue];
		2090 -> 2093;
	2091 [label="+10 Chemistry",color=orange];
		2091 -> 2094;
	2092 [label="Но это не значит, что я не наслаждаюсь возможностью на час отложить всё бремя и просто побеседовать с тем, кто не ведает обо всех ужасных преступлениях, что я совершил за свою жизнь.",shape=box,color=blue];
		2092 -> 2095;
	2093 [label="+10 Chemistry",color=orange];
		2093 -> 2096;
	2094 [label="Это изматывает, Узурпатор. И если бы я мог отбросить эту персону, словно какой-то маскарадный образ, и никогда больше к ней не возвращаться. Но это то, кто я есть, до каждой гнилой кости.",shape=box,color=blue];
		2094 -> 2092;
	2095 [label="Update boolean RoatheBirdThree",color=orange];
		2095 -> 2097;
		2095 -> 2098;
	2096 [label="Это всего лишь великолепная маска, которую я ношу? Или это глубоко засело во мне, в самой гнилой кости? Пока не знаю. Могу лишь сказать, что я всё ещё наслаждаюсь возможностью выложить всё на часок, когда есть такая возможность.",shape=box,color=blue];
		2096 -> 2099;
	2097 [label="Извините, если это покажется грубым, но... похоже, ты прожил одинокую жизнь.",shape=box,color=red];
		2097 -> 2100;
	2098 [label="Ты ведь не привык иметь много друзей, не так ли?",shape=box,color=red];
		2098 -> 2101;
	2099 [label="Я снимаю эту ношу и сижу рядом с тем, кто не ведает о моих ужасных преступлениях, разговариваю с огромной, очаровательно бестолковой птицей и обретаю… покой. Впервые за долгое время.",shape=box,color=blue];
		2099 -> 2102;
	2100 [label="Evaluate expressions",color=orange];
		2100 -> 2106 [label="RoatheUnloved1, RoatheKnowsReset2",color=purple];
		2100 -> 2105 [label="RoatheKnowsReset2",color=purple];
