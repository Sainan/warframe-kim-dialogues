		2118 -> 2123 [label="RoatheLyonDatingDealNo",color=purple];
		2118 -> 2122 [label="RoatheSerumDealNo",color=purple];
		2118 -> 2122 [label="RoatheFamilyDealNo",color=purple];
		2118 -> 2122 [label="RoatheMarieEntratiDealNo",color=purple];
		2118 -> 2122 [label="RoatheLyonConfessionDealNo",color=purple];
		2118 -> 2121 [label="false",color=purple];
	2117 [label="Интересно, это ли ты забрал у меня, Узурпатор? То, что мы были любовниками, что я признался тебе в любви, а ты не чувствовал того же?",shape=box,color=blue];
		2117 -> 2113;
	2116 [label="Какое бы дурное мнение ты обо мне ни составил, я его заслуживаю. И ты, конечно же, не одинок в своём мнении. Совсем не одинок.",shape=box,color=blue];
		2116 -> 2120;
	2115 [label="Update boolean RoatheAlone1",color=orange];
		2115 -> 2116;
	2119 [label="Chat ends.",color=orange];
	2124 [label="Трагично, да… Мне почти хочется узнать подробности, но кажется, что это всё равно что заглянуть в конец книги раньше времени.",shape=box,color=blue];
		2124 -> 2125;
	2123 [label="Но кого я обманываю?! Мы оба знаем, зачем ты это сделал, не так ли? И точно не из‑за любви ко мне. А из‑за любви к другому. Я просто впадаю в поэтические бредни.",shape=box,color=blue];
		2123 -> 2125;
	2122 [label="Но кого я обманываю?! Мы оба знаем, зачем ты это сделал, не так ли? И уж точно не из‑за любви ко мне. Да и вовсе не из‑за любви. Я просто впадаю в поэтические бредни.",shape=box,color=blue];
		2122 -> 2125;
	2121 [label="Ба. Но какой смысл сидеть и разглагольствовать?",shape=box,color=blue];
		2121 -> 2125;
	2120 [label="Chat ends.",color=orange];
	2125 [label="Я здесь не для того, чтобы вызывать у тебя сочувствие или жалость. Всё это — дело моих рук. Каким бы ни было дурное мнение, которое ты обо мне составил, — я его заслуживаю. И ты, конечно, не одинок в своём мнении. ",shape=box,color=blue];
		2125 -> 2126;
