		2100 -> 2103 [label="false",color=purple];
	2101 [label="Check boolean RoatheKnowsReset2",color=orange];
		2101 -> 2108 [label=true,color=green];
		2101 -> 2107 [label=false,color=brown];
	2102 [label="Может, в твоих словах действительно есть надежда. А может, я просто обманываю себя. И это лишь минутная передышка.",shape=box,color=blue];
		2102 -> 2109;
	2106 [label="Да, так и было. Или, по крайней мере, той частью, что я ещё могу вспомнить. Или это ты забрал у меня, Узурпатор? То, что мы были любовниками, что я признался тебе в любви, а ты не чувствовал того же?",shape=box,color=blue];
		2106 -> 2113;
	2105 [label="Признаю, так и было. По крайней мере, насколько я могу вспомнить. Удивит ли тебя то, что я ни разу в жизни не был влюблён? По‑настоящему, взаимно. Впрочем, возможно, это тебя и не шокирует. Мы, вероятно, уже проходили через всё это раньше.",shape=box,color=blue];
		2105 -> 2112;
	2104 [label="Так и было. Долгой и одинокой. Но это всё моя вина, Узурпатор. Я здесь не для того, чтобы вызывать у тебя сочувствие или жалость.",shape=box,color=blue];
		2104 -> 2111;
	2103 [label="Признаюсь, так оно и было. По крайней мере, насколько я помню. Тебя удивит, что я ни разу не был влюблён? Но это всё моя вина, Узурпатор. Я здесь не для того, чтобы вызывать твоё сочувствие или жалость.",shape=box,color=blue];
		2103 -> 2110;
	2108 [label="Кто знает? Может, у меня были друзья, но я просто не могу их вспомнить, потому что мы с тобой дружили, пока ты не положил этому конец, а?",shape=box,color=blue];
		2108 -> 2114;
	2107 [label="Кто знает? Возможно, у меня были друзья, но я просто не могу их вспомнить, потому что Энтрати покопался у меня в голове и стер воспоминания о них.",shape=box,color=blue];
		2107 -> 2114;
	2109 [label="Update boolean RoatheBirdThree",color=orange];
		2109 -> 2097;
		2109 -> 2098;
	2113 [label="Или наоборот? Ты безумно влюбился в самого Дьявола, но его сердце осталось к тебе равнодушным. В отчаянии ты сделал единственное, что мог: разорвал его разум в клочья!",shape=box,color=blue];
		2113 -> 2118;
	2112 [label="Update boolean RoatheUnloved1",color=orange];
		2112 -> 2117;
	2111 [label="Update boolean RoatheAlone1",color=orange];
		2111 -> 2116;
	2110 [label="Update boolean RoatheUnloved1",color=orange];
		2110 -> 2115;
	2114 [label="Вот уж много пользы это мне принесло.",shape=box,color=blue];
		2114 -> 2119;
	2118 [label="Evaluate expressions",color=orange];
		2118 -> 2124 [label="RoatheDatingDeal",color=purple];
		2118 -> 2123 [label="RoatheMarieDatingDeal",color=purple];
