	j3996924358 [label="Ну, я не знаю подробностей точно. Лишь то, что меня вызвали прекратить истерическую перепалку между Мари и Тагфер. ",shape=box,color=blue];
		j3996924358 -> j1933851518;
	j1933851518 [label="Птица Три была в полном отчаянии и так и не рассказала мне, о чем шла речь, а Лойд ничего не видел. Лишь Фибоначчи сообщил, что это «как-то связано с Энтрати».",shape=box,color=blue];
