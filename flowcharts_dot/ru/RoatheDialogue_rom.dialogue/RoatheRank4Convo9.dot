		j3588114823 -> j3709661370;
	j3709661370 [label="Ты же знаешь, какой она бывает подхалимкой по отношению к «le Cardinal». Неудивительно, что это в итоге дошло до кульминации с Тагфер.",shape=box,color=blue];
