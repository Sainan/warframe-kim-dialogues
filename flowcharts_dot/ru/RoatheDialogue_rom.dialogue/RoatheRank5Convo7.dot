	j3570305486 [label="Нет. Скорее всего потому, что он боится того, что принёс бы с собой. Хотя для этого уже слишком поздно.",shape=box,color=blue];
		j3570305486 -> j2997377135;
	j1138974112 [label="В некотором смысле, да. Видишь ли, я буду защищать сердце Бездны. И, что важнее всего, я буду защищать семью Альбрехта.",shape=box,color=blue];
		j1138974112 -> j3026604194;
	j656013476 [label="Семье потребуется защита Я должен стоять на страже. Я не могу этого сделать, когда заперт в подвале.",shape=box,color=blue];
		j656013476 -> j780094961;
	j49918241 [label="Именно он уничтожил мои воспоминания и позаботился о том, чтобы мне не к кому было обратиться, кроме тебя, чтобы их восстановить.",shape=box,color=blue];
		j49918241 -> j2578459868;
	j1094776969 [label="Семье потребуется защита. И все они, если так можно выразиться, слегка «приросли к месту», верно?",shape=box,color=blue];
		j1094776969 -> j2179998195;
