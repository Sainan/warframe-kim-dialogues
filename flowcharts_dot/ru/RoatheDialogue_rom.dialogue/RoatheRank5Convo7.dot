	j1361290037 [label="Boolean RoatheFamilyDelay is now true.",color=orange];
		j1361290037 -> j532386966;
	j3844450181 [label="Впрочем, ты вероятно, знаешь это не хуже меня.",shape=box,color=blue];
		j3844450181 -> j3764111538;
		j3844450181 -> j2415662366;
