	"Chat ends." [color=orange];
	j2685499930 [label="Я всё обдумываю всю эту ситуацию с дворецким и семьёй наверху. Она совершенно неприемлема.",shape=box,color=blue];
		j2685499930 -> j2626437209;
	j1721006842 [label="Я размышляю обо всём этом деле с дворецким и семьёй Альбрехта наверху. И о том, как сильно жду момента, когда смогу их «воссоединить».",shape=box,color=blue];
		j1721006842 -> j2880248661;
	j2902832523 [label="Я размышляю обо всём этом деле с дворецким и семьёй Альбрехта наверху. И о том, как сильно жду момента, когда смогу их воссоединить.",shape=box,color=blue];
		j2902832523 -> j2880248661;
	j2626437209 [label="Check boolean RoatheRedeemed",color=orange];
		j2626437209 -> j1574615164 [label=true,color=green];
		j2626437209 -> j3260219826 [label=false,color=brown];
	j2880248661 [label="Boolean RoatheFamilyDelay is now true.",color=orange];
		j2880248661 -> j2033967052;
	j1574615164 [label="Если от меня предполагается хоть какая-то польза, если я нужен хоть кому-нибудь, я не могу оставаться запертым здесь в секрете.",shape=box,color=blue];
		j1574615164 -> j3814426152;
	j3260219826 [label="Я не в силах продолжать оставаться запертым здесь втайне. Если мне суждено влиять на этот мир, я должен иметь возможность действовать открыто.",shape=box,color=blue];
		j3260219826 -> j3814426152;
	j2033967052 [label="Evaluate expressions",color=orange];
		j2033967052 -> j3983064270 [label="MarieFamilyFail, LyonFamilyFail",color=purple];
		j2033967052 -> j737050384 [label="MarieFamilyFail",color=purple];
		j2033967052 -> j974229941 [label="LyonFamilyFail",color=purple];
		j2033967052 -> j145113707 [label="MarieFamilySuccess, LyonFamilySuccess",color=purple];
		j2033967052 -> j2107246675 [label="MarieFamilySuccess",color=purple];
		j2033967052 -> j2011668011 [label="LyonFamilySuccess",color=purple];
	j3814426152 [label="К тому же у семьи Альбрехта, вероятно, есть ресурсы и доступ к вещам, которые мне понадобятся. Ты понимаешь, к чему я клоню?",shape=box,color=blue];
		j3814426152 -> j4153901532;
		j3814426152 -> j3424262007;
		j3814426152 -> j1310452999;
	j3983064270 [label="Хотя боюсь, это уже мало что изменит, учитывая, как тебе удалось всё так безнадёжно запороть с обоими фанатиками.",shape=box,color=blue];
		j3983064270 -> j2972212486;
		j3983064270 -> j483290286;
		j3983064270 -> j1310452999;
	j737050384 [label="Хотя боюсь, это уже мало что изменит, учитывая, как тебе удалось всё так безнадёжно запороть с Мари.",shape=box,color=blue];
		j737050384 -> j1709447934;
		j737050384 -> j2972212486;
		j737050384 -> j1310452999;
	j974229941 [label="Хотя боюсь, это уже мало что изменит, учитывая, как тебе удалось всё так безнадёжно запороть с Лионом.",shape=box,color=blue];
		j974229941 -> j3024009946;
		j974229941 -> j2972212486;
		j974229941 -> j1310452999;
	j145113707 [label="Фанатики тоже горят желанием, пусть и по причинам совсем иным, чем мои. Хорошая работа тебе удалось их убедить.",shape=box,color=blue];
		j145113707 -> j4163019339;
		j145113707 -> j150497678;
		j145113707 -> j1310452999;
		j145113707 -> j3578046396;
	j2107246675 [label="Мари тоже настроена решительно, хотя мотив у неё другой, не как у меня. Теперь ждём, получится ли у тебя склонить Лиона на свою сторону. И попробуй на этот раз всё не испортить, если сможешь.",shape=box,color=blue];
		j2107246675 -> j4163019339;
		j2107246675 -> j150497678;
		j2107246675 -> j1310452999;
		j2107246675 -> j3578046396;
	j2011668011 [label="Лион тоже настроен решительно, хотя мотив у него другой. Теперь ждём, получится ли у тебя склонить Мари. И попробуй на этот раз всё не испортить.",shape=box,color=blue];
		j2011668011 -> j4163019339;
		j2011668011 -> j150497678;
		j2011668011 -> j1310452999;
		j2011668011 -> j3578046396;
	j4153901532 [label="Я думаю, так правильнее если вы все будете оставаться здесь, в секрете. Извини.",shape=box,color=red];
		j4153901532 -> j3094713610;
	j3424262007 [label="Ладно. Хорошо. Давай попробуем поднять Лойда наверх по этим ступеням.",shape=box,color=red];
		j3424262007 -> j4140680399;
	j1310452999 [label="[Конец.]",shape=box,color=red];
		j1310452999 -> "Chat ends.";
	j2972212486 [label="Спасибо за воодушевляющую поддержку.",shape=box,color=red];
		j2972212486 -> j685521185;
	j483290286 [label="Есть ли что-то, что ты мог бы сделать, чтобы помочь мне в этом?",shape=box,color=red];
		j483290286 -> j2445781741;
	j1709447934 [label="Есть ли что-то, что ты мог бы сделать, чтобы помочь мне в этом?",shape=box,color=red];
		j1709447934 -> j902105680;
	j3024009946 [label="Есть ли что-то, что ты мог бы сделать, чтобы помочь мне в этом?",shape=box,color=red];
		j3024009946 -> j4172716417;
	j4163019339 [label="Мне любопытно, как Альбрехт отреагирует, когда он вернётся.",shape=box,color=red];
		j4163019339 -> j4181129844;
	j150497678 [label="Мне любопытно, как семья Энтрати отреагирует.",shape=box,color=red];
		j150497678 -> j13223407;
	j3578046396 [label="Какие такие «причины» у тебя есть, чтобы желать увидеть воссоединение Лойда и семьи Энтрати?",shape=box,color=red];
		j3578046396 -> j1903094986;
	j3094713610 [label="Check boolean RoatheDating",color=orange];
		j3094713610 -> j2835577787 [label=true,color=green];
		j3094713610 -> j280653183 [label=false,color=brown];
	j4140680399 [label="Check boolean RoatheDating",color=orange];
		j4140680399 -> j1369085275 [label=true,color=green];
		j4140680399 -> j716209377 [label=false,color=brown];
	j685521185 [label="Ты же меня знаешь. Вечно источник вдохновляющей мотивации. Но ты знаешь, если вдруг падёшь духом, ты всегда можешь... как там говорится?",shape=box,color=blue];
		j685521185 -> j3192979376;
	j2445781741 [label="Я думаю, в этом вопросе я могу быть полезен, да. И, я полагаю, это вполне отвечает моим интересам вдохновить их дать тебе второй шанс и позволить убедить помочь.",shape=box,color=blue];
		j2445781741 -> j2334845464;
	j902105680 [label="Я думаю, в этом вопросе я могу быть полезен, да. И, я полагаю, это вполне отвечает моим интересам вдохновить её дать тебе второй шанс и позволить убедить помочь.",shape=box,color=blue];
		j902105680 -> j3543689917;
	j4172716417 [label="Я думаю, в этом вопросе я могу быть полезен, да. И, я полагаю, это вполне отвечает моим интересам вдохновить его дать тебе второй шанс и позволить убедить помочь.",shape=box,color=blue];
		j4172716417 -> j3512811488;
	j4181129844 [label="«Когда?» Ха! Сомневаюсь, что этот ублюдок когда-нибудь ещё переступит порог этого места.",shape=box,color=blue];
		j4181129844 -> j2315857562;
	j13223407 [label="Надеюсь, ждать нам придётся недолго, чтобы всё узнать. Меня куда больше интересует, как они отреагируют на мою настойчивость в том, чтобы они приняли мою защиту.",shape=box,color=blue];
		j13223407 -> j416102711;
	j1903094986 [label="Прежде всего, мне надоело преть тут, в этом двойнике склепа, как если бы я был зверем за ограждением зоопарка.",shape=box,color=blue];
		j1903094986 -> j3483885894;
	j2835577787 [label="Теперь я понимаю, что это было ошибкой. Ты тратишь огромное количество времени впустую. Как же замечательно, что ты можешь повторять по собственной воле.",shape=box,color=blue];
		j2835577787 -> j4066168985;
	j280653183 [label="Ты тратишь огромное количество времени впустую. Как же замечательно, что ты можешь повторять по собственной воле.",shape=box,color=blue];
		j280653183 -> j4066168985;
	j1369085275 [label="+5 Chemistry",color=orange];
		j1369085275 -> j2805174145;
	j716209377 [label="+5 Chemistry",color=orange];
		j716209377 -> j2620910420;
	j3192979376 [label="\"Начнём сначала?\"",shape=box,color=blue];
		j3192979376 -> "Chat ends.";
	j2334845464 [label="Мне надоело преть тут, в этом двойнике склепа, как если бы я был зверем за ограждением зоопарка, который с каждым днём становится всё менее забавным.",shape=box,color=blue];
		j2334845464 -> j206326299;
	j3543689917 [label="Мне надоело преть тут, в этом двойнике склепа, как если бы я был зверем за ограждением зоопарка, который с каждым днём становится всё менее забавным.",shape=box,color=blue];
		j3543689917 -> j202311622;
	j3512811488 [label="Мне надоело преть тут, в этом двойнике склепа, как если бы я был зверем за ограждением зоопарка, который с каждым днём становится всё менее забавным.",shape=box,color=blue];
		j3512811488 -> j1197007072;
	j2315857562 [label="Check boolean RoatheDating",color=orange];
		j2315857562 -> j1737732786 [label=true,color=green];
		j2315857562 -> j2676385238 [label=false,color=brown];
	j416102711 [label="Эйлерия вовсе не простушка. Она сразу увидит мои мотивы. Я сомневаюсь, что она примет это без доли тревоги.",shape=box,color=blue];
		j416102711 -> j2587781979;
		j416102711 -> j3843540228;
	j3483885894 [label="Evaluate expressions",color=orange];
		j3483885894 -> j1649060166 [label="RoatheRedeemed",color=purple];
		j3483885894 -> j1491294869 [label="RoatheVillain",color=purple];
		j3483885894 -> "Chat ends." [label="false",color=purple];
	j4066168985 [label="Теперь это твой единственный выход, если ты когда-нибудь захочешь изменить своё решение.",shape=box,color=blue];
		j4066168985 -> j2260315096;
	j2805174145 [label="Рад видеть, что мне удаётся умерить твою безрассудную упрямость, сокровище Скиталец.",shape=box,color=blue];
		j2805174145 -> j2570983772;
	j2620910420 [label="Упрямое существо не так уж и непреклонно, как кажется. Наконец-то!",shape=box,color=blue];
		j2620910420 -> j2570983772;
	j206326299 [label="Но и с теми двумя я могу давить лишь до определённого предела. Пойми, мои возможности ограничены. Расчистить путь и выполнить работу это две разные вещи.",shape=box,color=blue];
		j206326299 -> j3275216993;
	j202311622 [label="Но и с Мари я могу давить лишь до определённого предела. Пойми, мои возможности ограничены. Расчистить путь и выполнить работу это две разные вещи.",shape=box,color=blue];
		j202311622 -> "Initiate conversation MarieRoatheRepair in /Lotus/Types/Gameplay/1999Wf/Dialogue/MarieDialogue_rom.dialogue";
	j1197007072 [label="Но и с Лионом я могу давить лишь до определённого предела. Пойми, мои возможности ограничены. Расчистить путь и выполнить работу это две разные вещи.",shape=box,color=blue];
		j1197007072 -> "Initiate conversation LyonRoatheRepair in /Lotus/Types/Gameplay/1999Wf/Dialogue/LyonDialogue_rom.dialogue";
	j1737732786 [label="Нет, Скиталец дорогуша. Думаю, Альбрехт покинул это место и свою семью раз и навсегда. Сомневаюсь, что он когда-нибудь ещё увидит свою дочь.",shape=box,color=blue];
		j1737732786 -> j3976805308;
	j2676385238 [label="Нет, Скиталец. Думаю, Альбрехт покинул это место и свою семью раз и навсегда. Сомневаюсь, что он когда-нибудь ещё увидит свою дочь.",shape=box,color=blue];
		j2676385238 -> j3976805308;
	j2587781979 [label="А каковы вообще твои мотивы? Ты ни разу этого не озвучил.",shape=box,color=red];
		j2587781979 -> j418918050;
	j3843540228 [label="Ты бы стал её винить за то, что она тебе не доверяет?",shape=box,color=red];
		j3843540228 -> j2892252874;
	j1649060166 [label="Во вторых, мне это видится своего рода искуплением защитить Деймос и семью Энтрати от того, что может произойти, когда придет время выплачивать долги Альбрехта.",shape=box,color=blue];
		j1649060166 -> j471379525;
	j1491294869 [label="Во вторых, что может быть лучшим способом отомстить Альбрехту? Да, я принял сыворотку добровольно, но именно он швырнул меня в прошлое.",shape=box,color=blue];
		j1491294869 -> j2995819535;
	j2260315096 [label="Boolean RoatheNoDate is now true.",color=orange];
		j2260315096 -> j4179029227;
	j2570983772 [label="Boolean RoatheFamilyFail is now false.",color=orange];
		j2570983772 -> j1361290037;
	j3275216993 [label="Нам придётся разбираться с этим по одному. Начнём с того из двоих, кто мыслит более логично. Со священника.",shape=box,color=blue];
		j3275216993 -> "Initiate conversation LyonRoatheRepair in /Lotus/Types/Gameplay/1999Wf/Dialogue/LyonDialogue_rom.dialogue";
	"Initiate conversation MarieRoatheRepair in /Lotus/Types/Gameplay/1999Wf/Dialogue/MarieDialogue_rom.dialogue" [label="Initiate conversation MarieRoatheRepair in /Lotus/Types/Gameplay/1999Wf/Dialogue/MarieDialogue_rom.dialogue",color=orange];
