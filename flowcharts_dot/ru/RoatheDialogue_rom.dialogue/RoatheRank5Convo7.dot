	j418918050 [label="Прежде всего, мне надоело преть тут, в этом двойнике склепа, как если бы я был зверем за ограждением зоопарка.",shape=box,color=blue];
		j418918050 -> j3194259996;
	j2892252874 [label="Конечно, нет! Она бы меня насквозь раскусила. И я бы не стал скрывать то, что было бы так очевидно для такой умной женщины, как она.",shape=box,color=blue];
		j2892252874 -> j2432971734;
	j471379525 [label="Семье потребуется защита Я должен стоять на страже. Я не могу этого сделать, когда заперт в подвале.",shape=box,color=blue];
		j471379525 -> j2819739679;
	j2995819535 [label="Именно он уничтожил мои воспоминания и позаботился о том, чтобы мне не к кому было обратиться, кроме тебя, чтобы их восстановить.",shape=box,color=blue];
		j2995819535 -> j455666498;
