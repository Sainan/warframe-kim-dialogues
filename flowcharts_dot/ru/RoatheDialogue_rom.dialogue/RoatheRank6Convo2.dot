		j3857720484 -> j3001317999 [label="false",color=purple];
	j3001317999 [label="Ненавижу звучать до ужаса поверхностно и грубо, но... давно ли зеркало удостаивалось внимания?",shape=box,color=red];
		j3001317999 -> j2983358653;
	j2563353456 [label="Роут. Ты можешь мне не верить, но я… я люблю тебя.",shape=box,color=red];
		j2563353456 -> j2149383994;
	j3708645635 [label="Ты можешь мне не верить, но я забочусь о тебе.",shape=box,color=red];
		j3708645635 -> j341447471;
	j2983358653 [label="+10 Chemistry",color=orange];
		j2983358653 -> j289910353;
	j2149383994 [label="Прошу прощения?",shape=box,color=blue];
		j2149383994 -> j879096588;
	j341447471 [label="Уверенность есть, что в сказанном присутствует хотя бы какая-то искренность. Или же, по меньшей мере, что собственный самообман тебе просто неведом.",shape=box,color=blue];
		j341447471 -> j4025729658;
	j289910353 [label="Честность — прекрасная вещь, дорогой Скиталец. Думаешь, я стал бы стыдить тебя за то, что ты получаешь удовольствие? Вряд ли.",shape=box,color=blue];
		j289910353 -> j3862350767;
	j879096588 [label="Нет. Ты же, конечно, шутишь?",shape=box,color=blue];
		j879096588 -> j683162557;
	j4025729658 [label="Я считаю, величайшим достижением Империи Орокин было её умение заставлять тех, кто жил внутри неё, верить в собственные заблуждения.",shape=box,color=blue];
		j4025729658 -> j3531236364;
	j3862350767 [label="Так выпьем же за отношения, приносящие взаимное удовлетворение.",shape=box,color=blue];
		j3862350767 -> j3921499284;
	j683162557 [label="Но зачем идти на такую договоренность, если только не...?",shape=box,color=blue];
		j683162557 -> j2149980527;
		j683162557 -> j735891813;
	j3531236364 [label="В самом деле, возможно, именно это и является настоящей связующей тканью человеческого рода: наше мастерское умение смотреть в зеркало и обманывать самих себя.",shape=box,color=blue];
		j3531236364 -> j4210365202;
	j3921499284 [label="Boolean RoatheUnloved4 is now true.",color=orange];
		j3921499284 -> j2965571546;
	j2149980527 [label="В прошлый раз всё пошло не так. Повторять такой риск было невозможно.",shape=box,color=red];
		j2149980527 -> j955454257;
	j735891813 [label="Сделка была нужна, потому что важно было сделать всё как следует. ",shape=box,color=red];
		j735891813 -> j955454257;
	j4210365202 [label="И все это ради того, чтобы избежать ужасного стыда от признания того, что нам нужно измениться.",shape=box,color=blue];
