		j3608179607 -> j2717586591;
	j1605475025 [label="Но меня искренне забавляет сам факт того, что было принято решение заключить со мной сделку ради моей благосклонности. И вот мы где. Однако было бы неверно с моей стороны не поинтересоваться, остаётся ли это тем, что ты всё ещё желаешь продолжить?",shape=box,color=blue];
