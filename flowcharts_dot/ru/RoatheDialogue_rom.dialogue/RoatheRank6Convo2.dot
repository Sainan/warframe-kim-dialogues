		j2131534758 -> j691398144;
	j892563043 [label="+10 Chemistry",color=orange];
		j892563043 -> j113114518;
	j2461451023 [label="Каким же удивительно странным созданием ты являешься. Восхитительным, но странным, сокровище Скиталец.",shape=box,color=blue];
		j2461451023 -> j3619738556;
	j691398144 [label="Единственное, что опаснее дьявола... это дьявол, у которого есть друзья, обязанные ему, вроде тебя. А теперь, если позволишь, мне пора отправиться докучать одной парящей «Сестре Сола».",shape=box,color=blue];
		j691398144 -> "Initiate conversation MarieRoatheRepair in /Lotus/Types/Gameplay/1999Wf/Dialogue/MarieDialogue_rom.dialogue";
	j113114518 [label="Единственное, что опаснее дьявола… это дьявол, у которого есть друзья, обязанные ему, вроде тебя. А теперь, если позволишь, мне пора отправиться докучать одному безумному священнику.",shape=box,color=blue];
		j113114518 -> "Initiate conversation LyonRoatheRepair in /Lotus/Types/Gameplay/1999Wf/Dialogue/LyonDialogue_rom.dialogue";
	j3619738556 [label="И всё же должен быть задан вопрос. Зачем заключать такую возмутительную сделку? Так велико любопытство отведать плоти Орокин после стольких столетий?",shape=box,color=blue];
		j3619738556 -> j3857720484;
