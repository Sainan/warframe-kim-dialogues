		j1504155967 -> j3167557136;
	j1696188698 [label="Считай, что выполнено. Будет сделано всё возможное, чтобы ускорить развитие событий между вами. Но дальше всё зависит от того, удастся ли закрепить результат. Нельзя сопровождать за руку на всём пути.",shape=box,color=blue];
