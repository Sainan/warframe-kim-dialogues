		j2960909028 -> j3411212919;
	j1155622083 [label="Но и с теми двумя я могу давить лишь до определённого предела. Пойми, я способен сделать не так уж много. Расчистить путь и выполнить работу это две разные вещи.",shape=box,color=blue];
