	j1652939132 [label="Мне нужна помощь...",shape=box,color=red];
		j1652939132 -> j2341512515;
	j2540938220 [label="Согласно договору прощение входит в мои обязанности, но о сохранности лица на черепе там не упомянуто. Поэтому рекомендую впредь подбирать выражения внимательнее.",shape=box,color=blue];
		j2540938220 -> j2897849522;
	j1859770504 [label="Согласно договору прощение входит в мои обязательства, так что не вполне понятно, зачем извиняться вообще, тем не менее это ценится.",shape=box,color=blue];
		j1859770504 -> j3043603058;
