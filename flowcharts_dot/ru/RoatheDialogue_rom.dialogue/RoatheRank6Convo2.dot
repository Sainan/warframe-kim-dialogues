		j631673681 -> "Chat ends.";
	j2991042401 [label="Душа была отдана дьяволу потому что... он, сам того не зная, уже держал в руках твоё разбитое сердце.",shape=box,color=blue];
		j2991042401 -> j977241190;
	j2293894387 [label="Не то чтобы я что-то знал по этой теме.",shape=box,color=blue];
		j2293894387 -> j4081414586;
	j3138696920 [label="Как тебе хорошо известно, я в этом вопросе немалый эксперт.",shape=box,color=blue];
		j3138696920 -> j4081414586;
	j977241190 [label="Скиталец... мой бедный, милый Скиталец...",shape=box,color=blue];
		j977241190 -> j387520610;
	j4081414586 [label="+5 Chemistry",color=orange];
		j4081414586 -> "Chat ends.";
	j387520610 [label="Прости меня. Пожалуйста, прости меня. Я не знал.",shape=box,color=blue];
		j387520610 -> j1929814769;
	j1929814769 [label="Нужно также понимать, что до этого момента моя любовь была ценностью, которую никто не стремился заполучить. По крайней мере, в каком-то значимом смысле.",shape=box,color=blue];
		j1929814769 -> j291667126;
	j291667126 [label="Так что, видимо, у тебе готовность продать свою душу за один кусок хлама. Представляешь моё недоумение. Как же я был сбит с толку.",shape=box,color=blue];
		j291667126 -> j2923957939;
	j2923957939 [label="Теперь? Теперь, когда я знаю правду? Скиталец, мой Скиталец... я не мог бы быть более рад, что это произошло именно так.",shape=box,color=blue];
		j2923957939 -> j2907313479;
