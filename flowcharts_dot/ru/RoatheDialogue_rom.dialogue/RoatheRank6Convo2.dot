		j2323237445 -> j4232330619;
	j1414275084 [label="У тебя есть удовлетворение тем, как всё осталось между вами? Или хочешь, чтобы я подтолкнул её к ещё одному разговору с тобой?",shape=box,color=blue];
		j1414275084 -> j575005072;
	j627373950 [label="У тебя есть удовлетворение тем, как всё осталось между вами? Или хочешь, чтобы я подтолкнул его к ещё одному разговору с тобой?",shape=box,color=blue];
		j627373950 -> j1779744107;
	j675704504 [label="Что, как было верно предугадано, оказалось необходимым. Учитывая, какой воинственно раздражающей занозой в моей заднице всё это время все оборачивалось.",shape=box,color=blue];
		j675704504 -> j2739182294;
		j675704504 -> j3249397200;
		j675704504 -> j88907694;
	j106935458 [label="И, как и ожидалось, всё пришло в тупик из-за выбранной добычи, Марии. Верно? Но это не важно. Дьявол прибыл исполнить условия нашего договора.",shape=box,color=blue];
		j106935458 -> j2334349249;
		j106935458 -> j1211327672;
		j106935458 -> j2006113375;
	j2311220213 [label="И, как и было предвидено, ситуация сама свернулась в угол из-за выбранной добычи, Лиона. (Хотя я искренне не понимаю, как это вообще получилось.) Не важно. Дьявол здесь, чтобы выполнить наш контракт.",shape=box,color=blue];
		j2311220213 -> j2717886317;
		j2311220213 -> j3874172628;
		j2311220213 -> j113585243;
