	j113585243 [label="[Конец.]",shape=box,color=red];
		j113585243 -> j4238361143;
	j1848016585 [label="Похоже, ты всё целиком провалил, не так ли? Мой ох мой, это довольно смехотворно. Что ж, ты сможешь рассчитывать на моё сотрудничество, каким бы сдержанным оно ни было.",shape=box,color=blue];
		j1848016585 -> j2960909028;
	j2786126179 [label="Как тебе удалось всё запороть сразу с ними обоими?! Ладно. Я полагаю, ныть об этом сейчас уже нет смысла.",shape=box,color=blue];
		j2786126179 -> j1155622083;
	j3832850553 [label="Тебе удалось всё запороть и со мной, и с Мари. Великолепно. Что ж, ты сможешь рассчитывать на моё сотрудничество, каким бы сдержанным оно ни было.",shape=box,color=blue];
		j3832850553 -> j831462516;
	j3549425793 [label="Тебе удалось всё запороть и со мной, и с Лионом. Великолепно. Что ж, ты сможешь рассчитывать на моё сотрудничество, каким бы сдержанным оно ни было.",shape=box,color=blue];
		j3549425793 -> j2214408162;
	j4140470283 [label="Видимо, я остаюсь единственным, кто ещё упирается? Что ж, ты сможешь рассчитывать на моё сотрудничество, каким бы сдержанным оно ни было. Ты сможешь рассчитывать на моё сотрудничество, каким бы сдержанным оно ни было.",shape=box,color=blue];
		j4140470283 -> j1778381609;
