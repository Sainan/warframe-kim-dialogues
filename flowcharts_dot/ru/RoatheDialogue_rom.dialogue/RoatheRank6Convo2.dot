	j3772129007 [label="Но с Лионом я могу давить лишь до определённого предела в этом деле. Расчистить путь и выполнить работу это две разные вещи.",shape=box,color=blue];
		j3772129007 -> j2341512515;
	j3241487394 [label="Считайте, что дело сделано.",shape=box,color=blue];
