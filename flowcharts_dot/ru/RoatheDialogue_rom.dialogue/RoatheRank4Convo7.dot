		j4174795012 -> j2553718359 [label="x <= 21",color=purple];
		j4174795012 -> j2553718359 [label="false",color=purple];
	j4105833781 [label="Узурпатор. Мне кажется, мы уже почти на месте. Ещё несколько дней, и осколки моего разума почти сложатся воедино. Мы почти достигнем той точки, где, как мне кажется, «в прошлый раз остановились». Странно об этом размышлять.",shape=box,color=blue];
		j4105833781 -> j4152463938;
	j2553718359 [label="Evaluate expressions on HellKeyPlayed counter",color=orange];
		j2553718359 -> j3821076670 [label="x >= 21",color=purple];
		j2553718359 -> j3564447969 [label="x >= 17",color=purple];
		j2553718359 -> j1289086638 [label="x >= 1",color=purple];
		j2553718359 -> j341218460 [label="false",color=purple];
	j4152463938 [label="Evaluate expressions on Promise counter",color=orange];
		j4152463938 -> j3800111283 [label="x >= 1",color=purple];
		j4152463938 -> j1347174187 [label="x <= 1",color=purple];
		j4152463938 -> j1347174187 [label="false",color=purple];
	j3821076670 [label="Check boolean DrifterRoathe",color=orange];
		j3821076670 -> j2257616049 [label=true,color=green];
		j3821076670 -> j1039155539 [label=false,color=brown];
	j3564447969 [label="Узурпатор, с удовлетворением сообщаю, что твоя работа в Тёмном Рефрактории завершена, и ты можешь прекратить раскапывать мои воспоминания.",shape=box,color=blue];
		j3564447969 -> j1092674156;
	j1289086638 [label="Узурпатор, хотя в Тёмном Рефрактории ещё остаётся кое‑какая работа по восстановлению моих воспоминаний, я с радостью могу заявить, что, по‑моему, с этим всем кровавым делом покончено.",shape=box,color=blue];
		j1289086638 -> j67128662;
	j341218460 [label="Узурпатор, при всей честности, начало работ в «Тёмном Рефрактории» было... далеко не образцовым, однако я с удовлетворением сообщаю, что, по моему мнению, с этим чёртовым делом покончено.",shape=box,color=blue];
		j341218460 -> j270760407;
	j3800111283 [label="Пусть может казаться, что за произошедшее тебе причитаются и благодарности, и извинения за просьбу стереть мои воспоминания и начать всё заново, я считаю, что будем «квиты» за всю боль, пережитую мной в результате.",shape=box,color=blue];
		j3800111283 -> j3875836595;
		j3800111283 -> j1182624483;
	j1347174187 [label="Это ощущается таким пустым, вся эта беготня по кругу. Наверное, лишь ты можешь это понять. Что ж… давай доведём дело до конца, хорошо?",shape=box,color=blue];
		j1347174187 -> j3875836595;
		j1347174187 -> j1048683999;
	j2257616049 [label="Узурпатор, у меня к тебе непростая просьба. Такая, которую мне совсем не доставляет удовольствия озвучивать. Я знаю, что по меньшей мере ты испытываешь ко мне влечение, и мне хотелось бы верить, что в твоём сердце есть уголок, который успел ко мне потеплеть...",shape=box,color=blue];
		j2257616049 -> j2456319691;
		j2257616049 -> j4271044324;
		j2257616049 -> j1222702801;
	j1039155539 [label="Узурпатор, у меня к тебе непростая просьба. Такая, которую мне совсем не доставляет удовольствия озвучивать. Но сначала я спрошу... стали ли мы друзьями? Есть ли в твоём сердце место, где ко мне питаются тёплые чувства?",shape=box,color=blue];
		j1039155539 -> j4210801315;
		j1039155539 -> j2658707484;
		j1039155539 -> j2847631849;
	j1092674156 [label="Мы можем прекратить это занятие, слоняться у меня в голове и подвергать всех нас этой вымышленной неудаче, верно? (Даже если священнику подобное, признаться, доставляет удовольствие.)",shape=box,color=blue];
		j1092674156 -> j392164101;
	j67128662 [label="Мы можем перестать слоняться у меня в голове и подвергать всех нас этой вымышленной неудаче, верно? (Даже если священнику подобное, признаться, доставляет удовольствие.)",shape=box,color=blue];
		j67128662 -> j392164101;
	j270760407 [label="Теперь можешь обо всём этом забыть. Несомненно, день можно посвятить куда более полезным занятиям, чем это вымышленное самобичевание, не так ли? (Даже если священнику это нравится.)",shape=box,color=blue];
		j270760407 -> j3077456970;
	j3875836595 [label="Мы справимся с этим. ",shape=box,color=red];
		j3875836595 -> j2177517941;
	j1182624483 [label="Я было сделано только потому, что ты попросил меня, Роут. Ты предупредил меня, что рассердишься. ",shape=box,color=red];
		j1182624483 -> j3506420162;
	j1048683999 [label="Мы почти у цели, как ты и сказал.",shape=box,color=red];
		j1048683999 -> j904095573;
	j2456319691 [label="Ты мне дорог, Роут. Должно ли так быть или нет, вопрос спорный.",shape=box,color=red];
		j2456319691 -> j4069494830;
	j4271044324 [label="Узнав тебя получше, мнение обо всём этом изменилось. Терпеть тебя не могу.",shape=box,color=red];
		j4271044324 -> j2534598401;
	j1222702801 [label="Ты мне по настоящему дорог, Роут. И это искренне. Не знаю, стоит ли, но... кажется, я влюбляюсь в тебя.",shape=box,color=red];
		j1222702801 -> j1335073729;
	j4210801315 [label="Это... немного больше, чем просто это. [Признается в своих чувствах.]",shape=box,color=red];
		j4210801315 -> j978235680;
	j2658707484 [label="Мне хотелось бы думать, что мы друзья. По крайней мере, с моей точки зрения.",shape=box,color=red];
		j2658707484 -> j4107210856;
	j2847631849 [label="Честно говоря, Роут? Я тебя терпеть не могу.",shape=box,color=red];
		j2847631849 -> j4285977220;
	j392164101 [label="Более того, на этом хотелось бы решительно настоять.",shape=box,color=blue];
		j392164101 -> j3703058924;
	j3077456970 [label="Evaluate expressions",color=orange];
		j3077456970 -> j1921885515 [label="RoatheDeal",color=purple];
		j3077456970 -> j1456840837 [label="RoatheDeal",color=purple];
		j3077456970 -> j999942961 [label="RoatheNoDeal",color=purple];
		j3077456970 -> j1921885515 [label="RoatheNoDeal",color=purple];
		j3077456970 -> j1921885515 [label="false",color=purple];
	j2177517941 [label="А если нет, полагаю, у тебя и на это найдётся решение, хм? Что ж, завтра будет новый день, и, возможно, он покажется таким же, как вчера.",shape=box,color=blue];
		j2177517941 -> j298080266;
	j3506420162 [label="Да. Полагаю, я бы так и сделал. И, наверное, я был прав. Что ж, завтра будет новый день, и, возможно, он окажется точь-в-точь как вчера.",shape=box,color=blue];
		j3506420162 -> j298080266;
	j904095573 [label="Да. Это чувство непреодолимого ужаса не покидает меня. Что ж. Завтра будет новый день, и, возможно, он будет похож на вчерашний.",shape=box,color=blue];
		j904095573 -> j298080266;
	j4069494830 [label="Тогда то, о чём я попрошу тебя, я делаю это от чистого сердца, Узурпатор. И пойми, я прошу об этом, прекрасно осознавая, что это значит для нас обоих.",shape=box,color=blue];
		j4069494830 -> j1393844433;
	j2534598401 [label="Boolean RoatheUnlovedDrifter is now true.",color=orange];
		j2534598401 -> j1086873951;
