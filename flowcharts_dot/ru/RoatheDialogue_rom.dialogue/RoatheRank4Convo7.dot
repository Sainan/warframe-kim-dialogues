		j1307123600 -> j1501793125;
		j1307123600 -> j1280049254;
		j1307123600 -> j279201234;
	j3067507292 [label="Ты думаешь, мне есть до этого дело?! Эти два фанатика ничего бы не поняли. Как глупые рыбки в аквариуме (не в обиду Фибоначчи), они бы продолжали пребывать в блаженном неведении.",shape=box,color=blue];
		j3067507292 -> j1764837443;
	j1764837443 [label="Меня ждёт нечто ужасное, Узурпатор. Какое-то ужасное осознание на вершине этого холма. Я чувствую, как оно сгущается, словно грозовые тучи, в моём сознании. Я вижу его болезненно-жёлтое свечение на горизонте.",shape=box,color=blue];
		j1764837443 -> j1684202831;
	j926307016 [label="Эти слова я никогда не произносил...",shape=box,color=blue];
		j926307016 -> j3264250945;
	j1836539095 [label="Пожалуйста.",shape=box,color=blue];
		j1836539095 -> j3107615079;
		j1836539095 -> j1793534659;
	j406647281 [label="Я просто считаю, что мы зашли достаточно далеко, и дальше идти не нужно! Можешь остановиться здесь, считать, что на сегодня всё, и оставить меня в покое.",shape=box,color=blue];
