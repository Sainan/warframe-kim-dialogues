		j999942961 -> j304282006;
	j298080266 [label="+10 Chemistry",color=orange];
		j298080266 -> "Chat ends. Next chat will be RoatheRank4Convo9.";
	j1393844433 [label="Мне нужно, чтобы ты воспользовался своими дарами над моим протофреймовым разумом и стер из него все наши взаимодействия, пока не стало слишком поздно.",shape=box,color=blue];
		j1393844433 -> j2852908293;
	j1086873951 [label="Boolean DrifterRoathe is now false.",color=orange];
		j1086873951 -> j928885826;
	j3866398987 [label="Я -",shape=box,color=blue];
		j3866398987 -> j1644319819;
	j69321662 [label="Увлекательно... Хотя мне и не хотелось бы в этот момент вдаваться в подробности, и я заранее приношу извинения за резкость следующего вопроса, он ужасно бестактен и груб, всё же он имеет глубокое значение для того, о чём я собираюсь тебя попросить.",shape=box,color=blue];
		j69321662 -> j2630900952;
	j1523707763 [label="И веришь ты этому или нет, я стал думать о тебе точно так же. Я искренне начал получать удовольствие от наших разговоров.",shape=box,color=blue];
		j1523707763 -> j2632259311;
	j1358303892 [label="Фантастически! Какие чудесные новости. Это лишь упростит для тебя выполнение моей просьбы! ",shape=box,color=blue];
		j1358303892 -> j414219265;
