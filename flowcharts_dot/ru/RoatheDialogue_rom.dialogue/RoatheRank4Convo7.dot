	"Chat ends. Next chat will be RoatheRank4Convo9." [color=orange];
	j2852908293 [label="Пожалуйста.",shape=box,color=blue];
		j2852908293 -> j2015850500;
		j2852908293 -> j47055115;
	j928885826 [label="Великолепно! Какая замечательная новость. Это сделает мою просьбу куда легче для тебя выполнить! ",shape=box,color=blue];
		j928885826 -> j414219265;
	j1644319819 [label="Мой дорогой Узурпатор... Я ошеломлён, не знаю, что сказать.",shape=box,color=blue];
		j1644319819 -> j123966222;
	j2630900952 [label="Твоя… увлечённость мной — это мимолётный интерес, минутная прихоть, физическое влечение или, быть может, та самая любовь весенней юности? Или…? ",shape=box,color=blue];
		j2630900952 -> j1098787846;
		j2630900952 -> j2456319691;
	j2632259311 [label="Я бы сказал, что буду по ним скучать, но они не прекратятся, по крайней мере, если ты выполнишь мою просьбу.",shape=box,color=blue];
		j2632259311 -> j414219265;
	j414219265 [label="Мне нужно, чтобы ты использовал свои дары против моего протофреймового разума и очистил его от всей этой чепухи. Пока не поздно. Прежде чем ты отступишь, я знаю, что у тебя есть этот дар. Просто ударь по полу, столу или чему угодно, что тебе нужно сделать.",shape=box,color=blue];
		j414219265 -> j1118050044;
	j2752397606 [label="Я совершенно уверен, что тебе больше не понадобится моя помощь в этом вопросе.",shape=box,color=blue];
		j2752397606 -> j1902705965;
	j4057505324 [label="Ничего! Совершенно ничего. Я доволен тем, что мы нашли. Эти археологические раскопки дали свои результаты, и я решил, что потратил достаточно твоего времени.",shape=box,color=blue];
		j4057505324 -> j2259187677;
	j1644469553 [label="Вовсе нет! Ни в малейшей степени. Я просто считаю, что мы зашли достаточно далеко, и дальше идти не нужно! Можешь остановиться здесь, считать, что на сегодня всё, и оставить меня в покое.",shape=box,color=blue];
		j1644469553 -> j252831127;
		j1644469553 -> j1029681909;
		j1644469553 -> j1313715501;
	j1452209296 [label="У меня такое чувство, что ты говоришь неправду.",shape=box,color=red];
		j1452209296 -> j4263746792;
	j4133790972 [label="Роут? Что случилось? Расскажи мне, пожалуйста.",shape=box,color=red];
		j4133790972 -> j1307123600;
	j2015850500 [label="Я не могу сделать это с тобой, не причинив вреда Лиону и Мари. Вы все в одной связке.",shape=box,color=red];
		j2015850500 -> j3067507292;
	j47055115 [label="Что?! Почему?",shape=box,color=red];
		j47055115 -> j1764837443;
	j123966222 [label="+10 Chemistry",color=orange];
		j123966222 -> j926307016;
	j1098787846 [label="Ты мне по настоящему дорог, Роут. И это искренне. Не знаю, стоит ли, но... кажется, я влюбляюсь в тебя.",shape=box,color=red];
		j1098787846 -> j3866398987;
	j1118050044 [label="Очисти мой разум. Не будем продолжать.",shape=box,color=blue];
		j1118050044 -> j1836539095;
	j1902705965 [label="Уверен, тебе не нужно постоянно вытаскивать из моего сознания воспоминания, чтобы заставить дворецкого подняться наверх! Все будет хорошо.",shape=box,color=blue];
		j1902705965 -> j406647281;
	j2259187677 [label="Я просто считаю, что мы зашли достаточно далеко. Можете остановиться здесь, считать, что на сегодня всё, и оставить меня в покое.",shape=box,color=blue];
		j2259187677 -> j252831127;
		j2259187677 -> j1029681909;
		j2259187677 -> j1313715501;
	j252831127 [label="У меня такое чувство, что ты говоришь неправду.",shape=box,color=red];
		j252831127 -> j3444921688;
	j1029681909 [label="Роут? Что случилось? Расскажи мне, пожалуйста.",shape=box,color=red];
		j1029681909 -> j1078110979;
	j1313715501 [label="А что, если мне просто нравится спускаться туда и убивать тебя снова и снова?",shape=box,color=red];
		j1313715501 -> j2258298266;
	j4263746792 [label="Что создает у тебя такое впечатление?",shape=box,color=blue];
