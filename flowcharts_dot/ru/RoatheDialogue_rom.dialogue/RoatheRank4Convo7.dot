		j1078110979 -> j994837223;
		j1078110979 -> j734998509;
		j1078110979 -> j2184933079;
	j2258298266 [label="Тогда почему бы не обменять поединки с моим воображаемым телом на поединки с настоящим? Уверен, мы могли бы найти место, где можно было бы сразиться в реальной жизни, если ты предпочтёшь именно это.",shape=box,color=blue];
		j2258298266 -> j105771080;
		j2258298266 -> j1249119586;
	j1226833057 [label="То, что ты совершенно неожиданно изменил свою позицию по этому вопросу?",shape=box,color=red];
