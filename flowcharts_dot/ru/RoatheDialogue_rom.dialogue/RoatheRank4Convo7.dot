		j2944100811 -> j1644469553;
	j1216994248 [label="Ничего! Совершенно ничего. Я доволен тем, что мы нашли. Эти археологические раскопки дали свои результаты, и я решил, что потратил достаточно твоего времени.",shape=box,color=blue];
		j1216994248 -> j1452209296;
		j1216994248 -> j4133790972;
