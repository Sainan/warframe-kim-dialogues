	2160 [label="Схемы, тонкие, как туман, образовывали нежное кружево под полупрозрачным покрытием. ",shape=box,color=blue];
		2160 -> 5693;
	5693 [label="So vast she was that she barely cleared the edges of the Solar Rail.",shape=box,color=blue];
		5693 -> 2167;
