	j1645528967 [label="ГС: ГОРДЫНЯ",shape=box,color=blue];
		j1645528967 -> j3949902233;
	j3949902233 [label="Транскрипт: Мы не ожидали проиграть. ",shape=box,color=blue];
		j3949902233 -> j3926271228;
	j3926271228 [label="После первого экспедиционного удара Владеющих Разумом мы подготовили карательный ответ.",shape=box,color=blue];
		j3926271228 -> j1820838486;
	j1820838486 [label="Чародейка Гилдергласс поднялась из тумана Цереры на смертоносных крыльях — галлеон, нагруженный дронами и мирмидонами в серебряных доспехах.",shape=box,color=blue];
		j1820838486 -> j3040835964;
	j3040835964 [label="Схемы, тонкие, как туман, образовывали нежное кружево под полупрозрачным покрытием. ",shape=box,color=blue];
		j3040835964 -> j2496588952;
	j2496588952 [label="Она была столь громадна, что едва проходила между краями Солнечного Монорельса.",shape=box,color=blue];
		j2496588952 -> j3185236602;
	j3185236602 [label="Владеющие Разумом позаботились о том, чтобы мы увидели результат. Они пели, и наша техника дала сбой. Наши воины изо всех сил пытались сражаться и задыхались внутри своих сияющих костюмов.",shape=box,color=blue];
		j3185236602 -> j3052554133;
	j3052554133 [label="Команда Златостеклянной чародейки заживо сгорела, когда она, лишённая двигателей, лебединым прыжком ушла сквозь небеса Тау, став сложным и дорогостоящим фейерверком.",shape=box,color=blue];
		j3052554133 -> j921430358;
	j921430358 [label="Add 1 to HellStory counter",color=orange];
		j921430358 -> "Chat ends.";
}