	j1291709809 [label="VM: HUBRIS",shape=box,color=blue];
		j1291709809 -> j3374525257;
	j3374525257 [label="Транскрипт: Мы не ожидали проиграть. ",shape=box,color=blue];
		j3374525257 -> j3899057441;
	j3899057441 [label="After the Sentients' first expeditionary strike, we had prepared a punitive counterblast.",shape=box,color=blue];
		j3899057441 -> j3838957332;
	j3838957332 [label="Чародейка Гилдергласс поднялась из тумана Цереры на смертоносных крыльях — галлеон, нагруженный дронами и мирмидонами в серебряных доспехах.",shape=box,color=blue];
		j3838957332 -> j949409652;
	j949409652 [label="Схемы, тонкие, как туман, образовывали нежное кружево под полупрозрачным покрытием. ",shape=box,color=blue];
		j949409652 -> j2695329724;
	j2695329724 [label="So vast she was that she barely cleared the edges of the Solar Rail.",shape=box,color=blue];
		j2695329724 -> j3689498144;
	j3689498144 [label="Владеющие Разумом позаботились о том, чтобы мы увидели результат. Они пели, и наша техника дала сбой. Наши воины изо всех сил пытались сражаться и задыхались внутри своих сияющих костюмов.",shape=box,color=blue];
		j3689498144 -> j2317121331;
	j2317121331 [label="The crew of the Gilderglass Enchantress roasted alive as she swan-dived engineless through the skies of Tau, a complex and costly firework.",shape=box,color=blue];
		j2317121331 -> j921430358;
	j921430358 [label="Add 1 to HellStory counter",color=orange];
		j921430358 -> "Chat ends.";
}