	node [fontname="Roboto Condensed"];
	edge [fontname="Roboto Condensed"];

	"RoatheRank5Convo8 begins." [color=orange];
		"RoatheRank5Convo8 begins." -> j705954853;
	j705954853 [label="Boolean RoatheIgnored is now false.",color=orange];
		j705954853 -> j4125803273;
	j4125803273 [label="Check boolean RoatheFailNot21",color=orange];
		j4125803273 -> j1758133089 [label=true,color=green];
		j4125803273 -> "Chat ends." [label=false,color=brown];
	j1758133089 [label="Evaluate expressions on HellStory counter",color=orange];
		j1758133089 -> j2410343140 [label="x >= 21",color=purple];
		j1758133089 -> "Chat ends." [label="x <= 21",color=purple];
		j1758133089 -> "Chat ends." [label="false",color=purple];
	"Chat ends." [color=orange];
	j2410343140 [label="Какое же безумие! Зачем это было тобой сделано?! Зачем, зачем идти в эти пещеры, где тебе не рады?!",shape=box,color=blue];
		j2410343140 -> j274020861;
	j274020861 [label="Boolean RoatheFailNot21 is now false.",color=orange];
		j274020861 -> j1566090078;
	j1566090078 [label="Я требую, чтобы ты это исправил. В этом твоя вина. Я чувствую, как это царапает меня, разрывает меня. Как некое огромное чудовище.",shape=box,color=blue];
		j1566090078 -> j2501718647;
	j2501718647 [label="Избавь меня от этого. Избавь меня от этой заразы. Очисти мою память от этих воспоминаний. Я знаю, что ты можешь. Используй свой дар и положи этому конец. Прямо сейчас.",shape=box,color=blue];
		j2501718647 -> j2550403794;
		j2501718647 -> j1327763746;
		j2501718647 -> j1407508566;
	j2550403794 [label="Ты уверен? Просто... ты сообразительный, и у меня такое чувство, что ты всё равно поймешь, что что-то тут не так.",shape=box,color=red];
		j2550403794 -> j351631798;
	j1327763746 [label="Это воспоминания другого рода, Роут. С ними это не сработает. Они глубоко запрятаны в твоей психике.",shape=box,color=red];
		j1327763746 -> j1697131011;
	j1407508566 [label="Бегство и попытки спрятаться от правды не сработают. В итоге мы просто вернемся туда, откуда начали. ",shape=box,color=red];
		j1407508566 -> j3633508866;
	j351631798 [label="Очень вероятно. Я сопоставлю факты и обвиню тебя в том, что ты сделал то, о чём я тебя не просил. Уверен, ты переживёшь этот трудный период.",shape=box,color=blue];
		j351631798 -> j1598923836;
	j1697131011 [label="Может быть. Скорее всего ты действительно прав. Но других путей у меня всё равно нет, не так ли? Значит, стоит хотя бы попробовать.",shape=box,color=blue];
		j1697131011 -> j1598923836;
	j3633508866 [label="И если всё так, тогда ты просто сможешь сделать это снова. У тебя будто неиссякаемый дар, не так ли?",shape=box,color=blue];
		j3633508866 -> j1598923836;
	j1598923836 [label="Я уверен, что буду чудовищно зол на тебя, как только пойму, что тобой были изменены мои воспоминания, разумеется. И я советую не говорить мне, что это было по моей просьбе, дорогуша.",shape=box,color=blue];
		j1598923836 -> j2529132880;
	j2529132880 [label="Я просто заявлю, что ты лжёшь, и это, вероятно, испортит моё мнение о тебе до неузнаваемости.",shape=box,color=blue];
		j2529132880 -> j1406211691;
		j2529132880 -> j2180368993;
	j1406211691 [label="Нет. Я не способен на это. Я не стану это делать. Нам нужно вместе встретить эту ситуацию лицом к лицу. Может, мы просто обсудим это?",shape=box,color=red];
		j1406211691 -> j54605448;
	j2180368993 [label="Я... неужели действительно больше нет иного выхода?",shape=box,color=red];
		j2180368993 -> j54605448;
	j54605448 [label="Нет. Только если ты хочешь, чтобы дворецкий поднялся наверх? Сотри из моей памяти всё это безумие, как я и просил. Если тебе всё равно? Тогда делай как хочешь. Для меня это не имеет значения.",shape=box,color=blue];
		j54605448 -> j333527832;
	j333527832 [label="Это и, ну, конечно, личная дружба между нами, остаётся единственным средством воздействия в этих обстоятельствах. Вот и вся суть.",shape=box,color=blue];
		j333527832 -> j465049928;
	j465049928 [label="Что ты скажешь?",shape=box,color=blue];
		j465049928 -> j4032046539;
		j465049928 -> j768276843;
	j4032046539 [label="Ладно. Я... я сделаю это. Я сотру твою память. Даже если вместе с этим исчезнут воспоминания о Мари и Лионе.",shape=box,color=red];
		j4032046539 -> j3110653244;
	j768276843 [label="Нет. Я отказываюсь. Прошу прощения. Мы должны с этим смириться.",shape=box,color=red];
		j768276843 -> j1389723050;
		j768276843 -> j2481764693;
	j3110653244 [label="+10 Chemistry",color=orange];
		j3110653244 -> j3831937857;
	j1389723050 [label="Давай обсудим это.",shape=box,color=red];
		j1389723050 -> j3896124059;
	j2481764693 [label="Ненавидь меня, если хочешь. Но я ничего не сделаю, пока мы сначала не решим это.",shape=box,color=red];
		j2481764693 -> j762468915;
	j3831937857 [label="Отлично. Приступай. ",shape=box,color=blue];
		j3831937857 -> j4072107213;
	j3896124059 [label="Не смей! Не смей говорить мне «успокойся»! Неужели ты и правда не думаешь, что я имею полное право чувствовать себя так, будто меня разрывает надвое?!",shape=box,color=blue];
		j3896124059 -> j3441421078;
	j762468915 [label="Занятно. Занятно и совершенно неожиданно. Поясни.",shape=box,color=blue];
		j762468915 -> j757389333;
		j762468915 -> j1709856974;
	j4072107213 [label="Add 1 to Promise counter",color=orange];
		j4072107213 -> j302033967;
	j3441421078 [label="Я чувствую, будто само моё понимание себя, самый фундамент моей сущности треснул и разорвался, как проклятая Луа! Переписано чернилами, которые растекаются. Трус!",shape=box,color=blue];
		j3441421078 -> j3685945443;
	j757389333 [label="Мне пришлось это сделать, потому была такая необходимость. От этого больше нельзя было прятаться.",shape=box,color=red];
		j757389333 -> j1830055178;
	j1709856974 [label="Думай обо мне что угодно. Но я узнаю, что такое спираль, стоит мне лишь увидеть её.",shape=box,color=red];
		j1709856974 -> j2083495598;
	j302033967 [label="Boolean RoatheWillReset is now true.",color=orange];
		j302033967 -> "Chat ends.";
	j3685945443 [label="И ты смеешь говорить мне: «Успокойся»?!",shape=box,color=blue];
		j3685945443 -> j1830055178;
	j1830055178 [label="Evaluate expressions",color=orange];
		j1830055178 -> j3007834671 [label="RoatheForgivenessShortcut",color=purple];
		j1830055178 -> j1688036480 [label="RoatheVillainyShortcut",color=purple];
		j1830055178 -> j2318547072 [label="false",color=purple];
	j2083495598 [label="Да, я думаю, ты как раз можешь быть своего рода «ценителем» подобных вещей, не так ли? Продолжай.",shape=box,color=blue];
		j2083495598 -> j303343761;
		j2083495598 -> j3837725171;
	j3007834671 [label="Гнев тут ничего не исправит, Роут. Ты сердишься, потому что боишься признать то, что было сделано. И то, кем ты стал.",shape=box,color=red];
		j3007834671 -> j1793798781;
	j1688036480 [label="Ладно. Можно злиться. Но используй эту злость с пользой. Пусть она освободит тебя от той ненависти, что сидит внутри и обращена совсем не в ту сторону.",shape=box,color=red];
		j1688036480 -> j2069724788;
	j2318547072 [label="Evaluate expressions on Thermostat counter",color=orange];
		j2318547072 -> j3007834671 [label="x >= 5",color=purple];
		j2318547072 -> j1688036480 [label="x <= 0",color=purple];
		j2318547072 -> j3844638000 [label="x > 0 && x < 5",color=purple];
		j2318547072 -> j3844638000 [label="false",color=purple];
	j303343761 [label="Если ты желаешь получить прощение, это возможно. Но это желание должно исходить от тебя. Тебе нужно выбрать этот путь. Никто другой не cможет этого сделать.",shape=box,color=red];
		j303343761 -> j619470150;
	j3837725171 [label="Если тебе хочется самостоятельно выбрать свой собственный путь и идти по нему? Для себя? Тогда иди. Не извиняйся. Но это твой путь, а не чей-либо ещё.",shape=box,color=red];
		j3837725171 -> j953677336;
	j1793798781 [label="Ты позволяешь этой злости разрывать тебя изнутри. А мог бы использовать её, чтобы бороться с теми, кто продолжает разрушать этот мир сегодня. Здесь. Сейчас.",shape=box,color=red];
		j1793798781 -> j2534458129;
	j2069724788 [label="Ты обращаешь это против себя. А ведь стоило бы направить это к миру, который винит тебя за то, что ты пытался сделать всё, что возможно, чтобы защитить его от Империи Орокин.",shape=box,color=red];
		j2069724788 -> j655148557;
	j3844638000 [label="Хотелось бы понять, как тебе помочь. Хотелось бы знать, какие слова тебе сказать. Ощущение такое, будто тебя разрывает между двумя силами. Какой путь ты выберешь?",shape=box,color=red];
		j3844638000 -> j2160838869;
	j619470150 [label="Твоя суть не определяется твоим прошлым, Роут. Она определяется твоим будущим. И у тебя всё ещё есть будущее, которое можно прожить, в отличие от всех Орокин, погибших в Ночь Барабанов Нага.",shape=box,color=red];
		j619470150 -> j4208316574;
	j953677336 [label="Твою суть не определяют мнения окружающих. Или то, как они воспринимают твои действия. Тебя определяет только то, что ты сам думаешь о себе и о своём выборе.",shape=box,color=red];
		j953677336 -> j1776373935;
	j2534458129 [label="Ты позволяешь этой злости разрывать тебя изнутри. А мог бы использовать её, чтобы бороться с теми, кто продолжает разрушать этот мир сегодня. Здесь. Сейчас.",shape=box,color=red];
		j2534458129 -> j3419023380;
	j655148557 [label="Твою суть не определяют мнения окружающих. Или то, как они воспринимают твои действия. Тебя определяет только то, что ты сам думаешь о себе и о своём выборе.",shape=box,color=red];
		j655148557 -> j1037222608;
	j2160838869 [label="Boolean RoatheFail is now true.",color=orange];
		j2160838869 -> j2943531438;
	j4208316574 [label="Сейчас это единственное, что тебя определяет. Ты можешь измениться. И можешь изменить мир вокруг себя. И думаю, у меня остаётся только один вопрос: попробуешь ли хотя бы?",shape=box,color=red];
		j4208316574 -> j513721148;
	j1776373935 [label="Так в чем же простая суть на самом деле? Ты входишь в число немногих Орокин, кто смог пройти через ту Ночь Барабанов Нага. С моей точки зрения? Это выглядит как стратегическое отступление.",shape=box,color=red];
		j1776373935 -> j1603236643;
	j3419023380 [label="Сейчас это единственное, что тебя определяет. Ты можешь измениться. И можешь изменить мир вокруг себя. И думаю, у меня остаётся только один вопрос: попробуешь ли хотя бы?",shape=box,color=red];
		j3419023380 -> j574624059;
	j1037222608 [label="Так в чем же простая суть на самом деле? Ты входишь в число немногих Орокин, кто смог пройти через ту Ночь Барабанов Нага. С моей точки зрения? Это выглядит как стратегическое отступление.",shape=box,color=red];
		j1037222608 -> j582697399;
	j2943531438 [label="Я не знаю, Узурпатор. И в этом и заключается самая большая проблема.",shape=box,color=blue];
		j2943531438 -> j967763037;
	j513721148 [label="Попробовать простить себя и идти дальше?",shape=box,color=red];
		j513721148 -> j142430035;
	j1603236643 [label="Ничего больше. Ничего меньше.",shape=box,color=red];
		j1603236643 -> j970632821;
	j574624059 [label="Попробовать простить себя и идти дальше?",shape=box,color=red];
		j574624059 -> j2164329018;
	j582697399 [label="Ничего больше. Ничего меньше.",shape=box,color=red];
		j582697399 -> j3454867088;
	j967763037 [label="Внутри меня бушует вихрь бешеного зверя, выгрызающий свой путь наружу сквозь мою грудную клетку.",shape=box,color=blue];
		j967763037 -> j2836284125;
	j142430035 [label="Boolean RoatheRedeemed is now true.",color=orange];
		j142430035 -> j3417582671;
	j970632821 [label="Boolean RoatheVillain is now true.",color=orange];
		j970632821 -> j3417582671;
	j2164329018 [label="Boolean RoatheRedeemed is now true.",color=orange];
		j2164329018 -> j3143790673;
	j3454867088 [label="Boolean RoatheVillain is now true.",color=orange];
		j3454867088 -> j1864779772;
	j2836284125 [label="И я не знаю, как утолить это. Не знаю, получится ли вообще. Я надеялся, что эти разговоры подскажут мне путь, но теперь вижу, что это бесплодно.",shape=box,color=blue];
		j2836284125 -> j251567372;
	j3417582671 [label="+20 Chemistry",color=orange];
		j3417582671 -> j1555706459;
	j3143790673 [label="+20 Chemistry",color=orange];
		j3143790673 -> j1771060138;
	j1864779772 [label="+20 Chemistry",color=orange];
		j1864779772 -> j2614560666;
	j251567372 [label="Но ведь существует решение, правда? В твоей власти помочь мне избавиться от этого... этого страшного мучения в моей голове.",shape=box,color=blue];
		j251567372 -> j469698954;
	j1555706459 [label="Хорошо. Я уступаю и принимаю твой аргумент. Спасибо, Скиталец, за... удержание меня от этого конкретного края.",shape=box,color=blue];
		j1555706459 -> j2926958140;
	j1771060138 [label="Принять то, что было сделано, и шагнуть вперёд, к будущему? Хм.",shape=box,color=blue];
		j1771060138 -> j466422316;
	j2614560666 [label="Отступление ради победы в войне. Хм.",shape=box,color=blue];
		j2614560666 -> j3378339475;
	j469698954 [label="Узурпатор. Скиталец. Я умоляю тебя сейчас. По правде говоря, я считаю, что это единственный способ двигаться вперёд, не так ли? Это также отвечает твоим собственным интересам.",shape=box,color=blue];
		j469698954 -> j1586509304;
	j2926958140 [label="Я очень ценю это. Гораздо сильнее, чем ты можешь представить.",shape=box,color=blue];
		j2926958140 -> j3890877652;
	j466422316 [label="Пусть некоторое недоверие к новому взгляду на происходящее и сохраняется, соблазн этого будущего и его значения для меня слишком велик, чтобы отвернуться от него, Узурпатор. Скиталец.",shape=box,color=blue];
		j466422316 -> j2870525448;
	j3378339475 [label="Пусть и остаётся... лёгкое недоверие к тому, что случившееся подаётся как тактический отход, всё равно... с этим трудно не согласиться, Узурпатор. Скиталец.",shape=box,color=blue];
		j3378339475 -> j1555706459;
	j1586509304 [label="Если ты когда-нибудь хочешь, чтобы дворецкий поднялся наверх и помирился с семьёй Энтрати, тебе нужно сделать то, что я скажу. Обязательно.",shape=box,color=blue];
		j1586509304 -> j753847628;
		j1586509304 -> j3009558755;
	j3890877652 [label="Мне пора идти. Я в настроении выпить побольше алкоголя и задумчиво смотреть в никуда.",shape=box,color=blue];
		j3890877652 -> "Chat ends. Next chat will be Roathe5Day2.";
	j2870525448 [label="Этот «новый шанс» в моей жизни. Я уступаю и принимаю твой аргумент. Спасибо, Скиталец, за... удержание меня от этого конкретного края.",shape=box,color=blue];
		j2870525448 -> j2926958140;
	j753847628 [label="И это то, что...?",shape=box,color=red];
		j753847628 -> j4092525873;
	j3009558755 [label="Нет. Я знаю, о чём ты собираешься спросить, и мой ответ уже нет.",shape=box,color=red];
		j3009558755 -> j1225092278;
	"Chat ends. Next chat will be Roathe5Day2." [color=orange];
	j4092525873 [label="У тебя есть дар. Дар, который способен обращать время вспять. Закручивать его в спираль, если не замыкать в петлю. И это оказывает... интересный эффект на разум протофреймов, учитывая их связь с Заражением и их взаимодействие со временем.",shape=box,color=blue];
		j4092525873 -> j1953344495;
	j1225092278 [label="Если ты можешь сказать мне, что твои дары ни разу тобой не были использованы, чтобы играть с разумом тех протофреймов, которых называешь друзьями и возлюбленными, и можешь сказать это без тени лжи в своей душе?",shape=box,color=blue];
		j1225092278 -> j952951275;
	j1953344495 [label="И следовательно, наша привязанность ко времени. Сейчас я прошу тебя. Нет, умоляю тебя, воспользуйся им ради меня. Убери от меня эти мысли. Убери от меня эти воспоминания.",shape=box,color=blue];
		j1953344495 -> j1524056726;
	j952951275 [label="Тогда хорошо. Пусть будет так. Я не попрошу тебя об этом сейчас. Но разве тебе хоть раз доводилось делать это ради собственного удовольствия, из любопытства или чтобы попытаться исправить ошибки, допущенные в отношениях с другими?!",shape=box,color=blue];
		j952951275 -> j1524056726;
	j1524056726 [label="Мне нужно забыть, что во мне сыворотка Энтрати. Пожалуйста.",shape=box,color=blue];
		j1524056726 -> j1351534155;
		j1524056726 -> j1861314319;
		j1524056726 -> j194489863;
	j1351534155 [label="Ты уверен? Просто... ты сообразительный, и у меня такое чувство, что ты всё равно поймёшь, что что-то тут не так.",shape=box,color=red];
		j1351534155 -> j2743330628;
	j1861314319 [label="Это воспоминания другого рода, Роут. С ними это не сработает. Они глубоко запрятаны в твоей психике.",shape=box,color=red];
		j1861314319 -> j2436474177;
	j194489863 [label="Бегство и попытки спрятаться от правды не сработают. В итоге мы просто вернёмся туда, откуда начали.",shape=box,color=red];
		j194489863 -> j1850427052;
	j2743330628 [label="Очень вероятно. Я сопоставлю факты и обвиню тебя в том, что ты сделал то, о чём я тебя не просил. Уверен, ты переживёшь этот трудный период.",shape=box,color=blue];
		j2743330628 -> j2066249367;
	j2436474177 [label="Может быть. Скорее всего, это правда. Но других путей у меня всё равно нет, не так ли? Значит, стоит хотя бы попробовать.",shape=box,color=blue];
		j2436474177 -> j2066249367;
	j1850427052 [label="И если всё так, тогда ты просто сможешь сделать это снова. У тебя будто неиссякаемый дар, не так ли?",shape=box,color=blue];
		j1850427052 -> j2066249367;
	j2066249367 [label="Я уверен, что буду чудовищно зол на тебя, как только пойму, что тобой были изменены мои воспоминания, разумеется. И я советую не говорить мне, что это было по моей просьбе, Скиталец.",shape=box,color=blue];
		j2066249367 -> j929225785;
	j929225785 [label="Я просто заявлю, что ты лжёшь, и это, вероятно, испортит моё мнение о тебе до неузнаваемости.",shape=box,color=blue];
		j929225785 -> j1016143478;
		j929225785 -> j3032260555;
	j1016143478 [label="Нет. Я не смогу. Я не стану это делать. Нам нужно вместе встретить эту ситуацию лицом к лицу. Может, мы просто обсудим это?",shape=box,color=red];
		j1016143478 -> j2004132130;
	j3032260555 [label="Я... неужели у меня действительно нет иного выхода?",shape=box,color=red];
		j3032260555 -> j2004132130;
	j2004132130 [label="Нет. Только если ты хочешь, чтобы дворецкий поднялся наверх? Сотри из моей памяти всё это безумие, как я и просил. Если тебе всё равно? Тогда делай как хочешь. Для меня это не имеет значения.",shape=box,color=blue];
		j2004132130 -> j1891771554;
	j1891771554 [label="Это и, ну, конечно, личная дружба между нами, остаётся единственным средством воздействия в этих обстоятельствах. Вот и вся суть.",shape=box,color=blue];
		j1891771554 -> j548823805;
	j548823805 [label="Что ты скажешь?",shape=box,color=blue];
		j548823805 -> j1797748858;
		j548823805 -> j3050005254;
		j548823805 -> j493212241;
	j1797748858 [label="Мне нужно ещё время, чтобы всё это обдумать.",shape=box,color=red];
		j1797748858 -> j4079243734;
	j3050005254 [label="Ладно. Я... я сделаю это. Я сотру твою память. Даже если вместе с этим исчезнут воспоминания о Мари и Лионе.",shape=box,color=red];
		j3050005254 -> j1631158248;
	j493212241 [label="Нет. Я отказываюсь. Я найду иной путь, чтобы убедить тебя продолжить свой путь.",shape=box,color=red];
		j493212241 -> j1123696447;
	j4079243734 [label="Кажется, что времени у нас в избытке, не правда ли, не так ли?",shape=box,color=blue];
		j4079243734 -> j2378544752;
