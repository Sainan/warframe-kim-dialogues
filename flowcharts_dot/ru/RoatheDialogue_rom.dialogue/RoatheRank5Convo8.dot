digraph {
	"RoatheRank5Convo8 begins." [color=orange];
		"RoatheRank5Convo8 begins." -> j4125803273;
	j4125803273 [label="Check boolean RoatheFailNot21",color=orange];
		j4125803273 -> j1758133089 [label=true,color=green];
		j4125803273 -> "Chat ends." [label=false,color=brown];
	j1758133089 [label="Evaluate expressions on HellStory counter",color=orange];
		j1758133089 -> j3747322246 [label="x >= 21",color=purple];
		j1758133089 -> "Chat ends." [label="x <= 21",color=purple];
		j1758133089 -> "Chat ends." [label="false",color=purple];
	"Chat ends." [color=orange];
	j3747322246 [label="Какое же безумие! Зачем это было тобой сделано?! Зачем, зачем идти в эти пещеры, где тебе не рады?!",shape=box,color=blue];
		j3747322246 -> j1566090078;
	j1566090078 [label="Я требую, чтобы ты это исправил. В этом твоя вина. Я чувствую, как это царапает меня, разрывает меня. Как некое огромное чудовище.",shape=box,color=blue];
		j1566090078 -> j2501718647;
	j2501718647 [label="Избавь меня от этого. Избавь меня от этой заразы. Очисти мою память от этих воспоминаний. Я знаю, что ты можешь. Используй свой дар и положи этому конец. Прямо сейчас.",shape=box,color=blue];
		j2501718647 -> j2550403794;
		j2501718647 -> j1327763746;
		j2501718647 -> j1407508566;
	j2550403794 [label="Ты уверен? Просто... ты сообразительный, и у меня такое чувство, что ты всё равно поймешь, что что-то тут не так.",shape=box,color=red];
		j2550403794 -> j351631798;
	j1327763746 [label="Это воспоминания другого рода, Роут. С ними это не сработает. Они глубоко запрятаны в твоей психике.",shape=box,color=red];
		j1327763746 -> j1697131011;
	j1407508566 [label="Бегство и попытки спрятаться от правды не сработают. В итоге мы просто вернемся туда, откуда начали. ",shape=box,color=red];
		j1407508566 -> j3633508866;
	j351631798 [label="Очень вероятно. Я сопоставлю факты и обвиню тебя в том, что ты сделал то, о чём я тебя не просил. Уверен, ты переживёшь этот трудный период.",shape=box,color=blue];
		j351631798 -> j1598923836;
	j1697131011 [label="Может быть. Скорее всего ты действительно прав. Но других путей у меня всё равно нет, не так ли? Значит, стоит хотя бы попробовать.",shape=box,color=blue];
		j1697131011 -> j1598923836;
	j3633508866 [label="И если всё так, тогда ты просто сможешь сделать это снова. У тебя будто неиссякаемый дар, не так ли?",shape=box,color=blue];
		j3633508866 -> j1598923836;
	j1598923836 [label="Я уверен, что буду чудовищно зол на тебя, как только пойму, что тобой были изменены мои воспоминания, разумеется. И я советую не говорить мне, что это было по моей просьбе, дорогуша.",shape=box,color=blue];
		j1598923836 -> j2529132880;
	j2529132880 [label="Я просто заявлю, что ты лжёшь, и это, вероятно, испортит моё мнение о тебе до неузнаваемости.",shape=box,color=blue];
		j2529132880 -> j1406211691;
		j2529132880 -> j2180368993;
	j1406211691 [label="Нет. Я не способен на это. Я не стану это делать. Нам нужно вместе встретить эту ситуацию лицом к лицу. Может, мы просто обсудим это?",shape=box,color=red];
		j1406211691 -> j54605448;
	j2180368993 [label="Я... неужели действительно больше нет иного выхода?",shape=box,color=red];
		j2180368993 -> j54605448;
	j54605448 [label="Нет. Только если ты хочешь, чтобы дворецкий поднялся наверх? Сотри из моей памяти всё это безумие, как я и просил. Если тебе всё равно? Тогда делай как хочешь. Для меня это не имеет значения.",shape=box,color=blue];
		j54605448 -> j333527832;
	j333527832 [label="Это и, ну, конечно, личная дружба между нами, остаётся единственным средством воздействия в этих обстоятельствах. Вот и вся суть.",shape=box,color=blue];
		j333527832 -> j465049928;
	j465049928 [label="Что ты скажешь?",shape=box,color=blue];
		j465049928 -> j4032046539;
		j465049928 -> j390831430;
	j4032046539 [label="Ладно. Я... я сделаю это. Я сотру твою память. Даже если вместе с этим исчезнут воспоминания о Мари и Лионе.",shape=box,color=red];
		j4032046539 -> j3110653244;
	j390831430 [label="Нет. Я отказываюсь. Я найду иной путь, чтобы убедить тебя продолжить свой путь.",shape=box,color=red];
		j390831430 -> j467753549;
	j3110653244 [label="+10 Chemistry",color=orange];
		j3110653244 -> j3831937857;
	j467753549 [label="От всей души желаю тебе удачи.",shape=box,color=blue];
		j467753549 -> "Initiate conversation LyonRoatheFail in /Lotus/Types/Gameplay/1999Wf/Dialogue/LyonDialogue_rom.dialogue";
	j3831937857 [label="Отлично. Приступай. ",shape=box,color=blue];
		j3831937857 -> j4072107213;
	"Initiate conversation LyonRoatheFail in /Lotus/Types/Gameplay/1999Wf/Dialogue/LyonDialogue_rom.dialogue" [label="Initiate conversation LyonRoatheFail in /Lotus/Types/Gameplay/1999Wf/Dialogue/LyonDialogue_rom.dialogue",color=orange];
		"Initiate conversation LyonRoatheFail in /Lotus/Types/Gameplay/1999Wf/Dialogue/LyonDialogue_rom.dialogue" -> "Chat ends.";
	j4072107213 [label="Add 1 to Promise counter",color=orange];
		j4072107213 -> j302033967;
	j302033967 [label="Boolean RoatheWillReset is now true.",color=orange];
		j302033967 -> "Chat ends.";
}