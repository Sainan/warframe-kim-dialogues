	"Chat ends." [color=orange];
	j300493669 [label="ГС: ДИПЛОМАТИЯ",shape=box,color=blue];
		j300493669 -> j1688120636;
	j1688120636 [label="Транскрипт: Среди Семерых Исполнителей Баллас возомнил себя первым среди равных. ",shape=box,color=blue];
		j1688120636 -> j1518020407;
	j1518020407 [label="Вечный дипломат, медоточивый увещеватель, он примирял обиды и распри остальных.",shape=box,color=blue];
		j1518020407 -> j3869185401;
	j3869185401 [label="К моей безмерной радости, я обнаружил, что теперь он — роза, зажатая между двумя зарослями шипов. ",shape=box,color=blue];
		j3869185401 -> j886466582;
	j886466582 [label="Фракция милитаристов во главе с Ниток тянула в одну сторону. Пацифисты под началом Скарна тянули в другую.",shape=box,color=blue];
		j886466582 -> j2668259519;
	j2668259519 [label="Баллас был вынужден принять решение и навлечь на себя яростную вражду тех кадров, на чью сторону он не вставал.",shape=box,color=blue];
		j2668259519 -> j2566772786;
	j2566772786 [label="По причинам, которые я не могу предположить, он выбрал мир; счет был четыре к трем, и поэтому кровожадные Владеющие Разумом существа внезапно стали союзниками и друзьями.",shape=box,color=blue];
		j2566772786 -> j1901496797;
	j1901496797 [label="Так или иначе, он образумится», пообещала Ниток, в тот самый момент, когда меня отправили искать недовольных среди гарнизонных Даксов.",shape=box,color=blue];
		j1901496797 -> j921430358;
	j921430358 [label="Add 1 to HellStory counter",color=orange];
		j921430358 -> "Chat ends.";
}