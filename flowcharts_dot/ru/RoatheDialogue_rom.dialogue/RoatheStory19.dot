	"Chat ends." [color=orange];
	j1003356275 [label="VM: DIPLOMACY",shape=box,color=blue];
		j1003356275 -> j2659783958;
	j2659783958 [label="Transcript: Among the Seven Executors, Ballas had styled himself first among equals. ",shape=box,color=blue];
		j2659783958 -> j3191284214;
	j3191284214 [label="Ever the diplomat, ever the honey-voiced persuader, he resolved the grudges and disputes of the others.",shape=box,color=blue];
		j3191284214 -> j532959777;
	j532959777 [label="К моей безмерной радости, я обнаружил, что теперь он — роза, зажатая между двумя зарослями шипов. ",shape=box,color=blue];
		j532959777 -> j3013737053;
	j3013737053 [label="The warmonger faction, headed by Nitokh, pulled one way. The pacifists, under Scarne, pulled another.",shape=box,color=blue];
		j3013737053 -> j2668259519;
	j2668259519 [label="Баллас был вынужден принять решение и навлечь на себя яростную вражду тех кадров, на чью сторону он не вставал.",shape=box,color=blue];
		j2668259519 -> j2566772786;
	j2566772786 [label="По причинам, которые я не могу предположить, он выбрал мир; счет был четыре к трем, и поэтому кровожадные Владеющие Разумом существа внезапно стали союзниками и друзьями.",shape=box,color=blue];
		j2566772786 -> j1901496797;
	j1901496797 [label="Так или иначе, он образумится», пообещала Ниток, в тот самый момент, когда меня отправили искать недовольных среди гарнизонных Даксов.",shape=box,color=blue];
		j1901496797 -> j921430358;
	j921430358 [label="Add 1 to HellStory counter",color=orange];
		j921430358 -> "Chat ends.";
}