	"Chat ends." [color=orange];
	j2468659495 [label="ГС: СТАНДАРТ",shape=box,color=blue];
		j2468659495 -> j2148877350;
	j2148877350 [label="Транскрипт: Ничто так лаконично не передает помпезность, с которой мы, существа, описываем кровавую бойню войны, как знаменосцы.",shape=box,color=blue];
		j2148877350 -> j2647774562;
	j2647774562 [label="Тех, кого необходимо защищать любой ценой — и за кем следует идти беспрекословно.",shape=box,color=blue];
		j2647774562 -> j2236740081;
	j2236740081 [label="И тех, кого допускается принуждать угрозами, я должен добавить, к выполнению приказов, которые не выполнил бы ни один здравомыслящий солдат, лишь бы избежать ещё более ужасающей судьбы. ",shape=box,color=blue];
		j2236740081 -> j2571986474;
	j2571986474 [label="Хотя это и смешно.",shape=box,color=blue];
		j2571986474 -> j489592310;
	j489592310 [label="Но именно к ним всегда притягивался мой взгляд среди прочих, хотя их покореженные тела ничем не отличались от остальных. ",shape=box,color=blue];
		j489592310 -> j3100710495;
	j3100710495 [label="Они по-прежнему несли своё знамя, сияющее золотом Орокин и усеянное расплывшимися багровыми следами.",shape=box,color=blue];
		j3100710495 -> j3305546543;
	j3305546543 [label="Прежде чем уйти, я всегда следил за тем, чтобы он гордо стоял на поле.",shape=box,color=blue];
		j3305546543 -> j921430358;
	j921430358 [label="Add 1 to HellStory counter",color=orange];
		j921430358 -> "Chat ends.";
}