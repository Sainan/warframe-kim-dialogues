	"Chat ends." [color=orange];
	j1114089646 [label="VM: STANDARD",shape=box,color=blue];
		j1114089646 -> j197921467;
	j197921467 [label="Транскрипт: Ничто так лаконично не передает помпезность, с которой мы, существа, описываем кровавую бойню войны, как знаменосцы.",shape=box,color=blue];
		j197921467 -> j3179726499;
	j3179726499 [label="Those who must be protected at all costs - and followed without question.",shape=box,color=blue];
		j3179726499 -> j2286410893;
	j2286410893 [label="And who may be threatened, I might add, to follow orders that no sane soldier would ever complete, lest they somehow come to suffer some more terrible fate. ",shape=box,color=blue];
		j2286410893 -> j2804753792;
	j2804753792 [label="Хотя это и смешно.",shape=box,color=blue];
		j2804753792 -> j4089066547;
	j4089066547 [label="It was always their forms my eye was drawn to amongst the rest, though their mangled bodies were no different from any other. ",shape=box,color=blue];
		j4089066547 -> j3100710495;
	j3100710495 [label="Они по-прежнему несли своё знамя, сияющее золотом Орокин и усеянное расплывшимися багровыми следами.",shape=box,color=blue];
		j3100710495 -> j3305546543;
	j3305546543 [label="Прежде чем уйти, я всегда следил за тем, чтобы он гордо стоял на поле.",shape=box,color=blue];
		j3305546543 -> j921430358;
	j921430358 [label="Add 1 to HellStory counter",color=orange];
		j921430358 -> "Chat ends.";
}