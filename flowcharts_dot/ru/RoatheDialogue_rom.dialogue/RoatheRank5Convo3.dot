		j1200124590 -> j704781500;
	j1841502862 [label="[Confess feelings.] Well, it wasn't because I don't have feelings for you, I just didn't know how to bring it up...",shape=box,color=red];
		j1841502862 -> j2316133914;
	j112447693 [label="I wasn't sure how you would all feel about the topic.",shape=box,color=red];
		j112447693 -> j1889999388;
	j520936404 [label="It's not outdated. It's how I live my life. I'm dedicated to my romantic partner already.",shape=box,color=red];
		j520936404 -> j108121049;
	j2581281991 [label="None of you are alluring to me, Roathe. No offense.",shape=box,color=red];
		j2581281991 -> j2736674169;
	j299540511 [label="Drifter... my poor, sweet, Drifter...",shape=box,color=blue];
		j299540511 -> j1255731109;
	j2885632389 [label="I. I'm without words.",shape=box,color=red];
		j2885632389 -> j2930244981;
	j2694980822 [label="Are you okay?",shape=box,color=red];
		j2694980822 -> j2930244981;
	j893416533 [label="Yes. I realize that now. You signed your soul away to the devil himself because... he unknowingly already held your broken heart.",shape=box,color=blue];
