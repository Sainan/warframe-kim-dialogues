		j1382004532 -> j440422433;
	j271921967 [label="Boolean RoatheLoved is now true.",color=orange];
		j271921967 -> j2146370007;
	j873380180 [label="You have accidentally caused a rift in time that is collapsing as we speak and we are all utterly doomed and only have seconds to live before we are all sent screaming into eternity as we are agonizingly ripped apart as our very beings are stretched to incomprehensible lengths down to the subatomic particles?",shape=box,color=blue];
		j873380180 -> j105834947;
		j873380180 -> j3766674571;
	j3363648954 [label="I made the deal because I was desperate to get this right. ",shape=box,color=red];
		j3363648954 -> j3552822097;
	j2043879826 [label="Прости, но моё… моё решение изменилось. Я на самом деле тебя не люблю.",shape=box,color=red];
		j2043879826 -> j2942419856;
	j2619726819 [label="I screwed it up last time. I couldn't run that risk again.",shape=box,color=red];
		j2619726819 -> j3552822097;
	j3659166123 [label="А разве нет?",shape=box,color=red];
		j3659166123 -> j3461711515;
	j1127356627 [label="Твои намёки, что я чувствую что-то к тебе, не настоящее. Это самое далекое от правды.",shape=box,color=red];
		j1127356627 -> j1074248814;
	j2731704616 [label="Но меня искренне забавляет сам факт того, что было принято решение заключить со мной сделку ради моей благосклонности. И вот мы где. Однако было бы неверно с моей стороны не поинтересоваться, остаётся ли это тем, что ты всё ещё желаешь продолжить?",shape=box,color=blue];
		j2731704616 -> j4259630107;
		j2731704616 -> j1518454949;
	j4259630107 [label="Нет. Не важно.",shape=box,color=red];
		j4259630107 -> j2350565929;
	j1518454949 [label="Да. [Свидание с Роутом.]",shape=box,color=red];
		j1518454949 -> j1228771050;
	j219915015 [label="Сначала ярости моей не было предела. Почему? Зачем очищать мой разум от наших разговоров? И затем признаваться мне в любви?",shape=box,color=blue];
		j219915015 -> j2106069135;
	j2029137146 [label="Альбрехт и его тщедушный маленький дворецкий сочли нужным взвалить на плечи коллекцию сломанных игрушек. Очень привлекательных сломанных игрушек.",shape=box,color=blue];
		j2029137146 -> j2916442159;
	j287932156 [label="Настоящее сочувствие?",shape=box,color=blue];
		j287932156 -> j3143391415;
	j1359795720 [label="Осознаешь ли ты, какая сила в тебе заключена, да? И насколько ценным могло бы быть твоё присутствие в моём распоряжении?",shape=box,color=blue];
		j1359795720 -> j969224207;
