	j2736674169 [label="+5 Chemistry",color=orange];
		j2736674169 -> j439091835;
	j1255731109 [label="Forgive me. Please, forgive me. I did not know.",shape=box,color=blue];
		j1255731109 -> j2842063972;
	j2930244981 [label="I have been left down here in this replica crypt with these two zealots for a little too long, I fear.",shape=box,color=blue];
		j2930244981 -> j1482801008;
	j2795879511 [label="It baffled me at first, when you bargained with me at the start. Why? Why would you cut such a dangerously open-ended deal for such a strange request?",shape=box,color=blue];
