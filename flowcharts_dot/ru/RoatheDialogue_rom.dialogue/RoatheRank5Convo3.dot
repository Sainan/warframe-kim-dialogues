	j2522522536 [label="Отнюдь. Я бы искренне аплодировал, окажись мы рядом, милый Скиталец. Ситуация была обыграна наилучшим образом.",shape=box,color=blue];
		j2522522536 -> j3881532264;
	j1594415646 [label="Ах, да? И хочешь намекнуть, что испытываешь к ней что-то настоящее? Подлинное сострадание? Прошу, не смеши меня.",shape=box,color=blue];
