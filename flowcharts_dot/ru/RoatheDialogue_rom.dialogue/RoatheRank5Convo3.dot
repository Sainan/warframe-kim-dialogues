		j2606238980 -> j765562332;
	j1082141798 [label="Твоя часть контракта всё ещё остаётся невыполненной для меня, независимо от того, желаешь ли ты, чтобы была выполнена твоя сторона соглашения.",shape=box,color=blue];
		j1082141798 -> j1190846790;
	j3854734109 [label="Что ж, мне жаль сообщать, что, хотя я и не против «делиться», фанатики… скорее всего, этого делать не будут. Я рекомендую разобраться со своей текущей ситуацией, прежде чем продолжать обсуждать нашу.",shape=box,color=blue];
