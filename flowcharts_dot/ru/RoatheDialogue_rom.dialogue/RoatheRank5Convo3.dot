	j4013169628 [label="Нет. Ты же, конечно, шутишь?",shape=box,color=blue];
		j4013169628 -> j271921967;
	j1435908438 [label="То есть случайно был создан разрыв во времени, который рушится, пока мы говорим, и мы все обречены и у нас осталось всего несколько секунд, прежде чем мы все с криками полетим в вечность. Нас будут мучительно разрывать на части, а само наше бытие будет растягиваться до непостижимых размеров, вплоть до субатомных частиц?",shape=box,color=blue];
		j1435908438 -> j105834947;
		j1435908438 -> j3766674571;
	j2549062537 [label="Сделка была нужна, потому что важно было сделать всё как следует. ",shape=box,color=red];
		j2549062537 -> j3388113236;
	j3093472605 [label="Прости, но моё… моё решение изменилось. Я на самом деле тебя не люблю.",shape=box,color=red];
		j3093472605 -> j269381436;
	j1684187833 [label="В прошлый раз всё пошло не так. Повторять такой риск оказалось невозможно.",shape=box,color=red];
		j1684187833 -> j3388113236;
	j3659166123 [label="А разве нет?",shape=box,color=red];
		j3659166123 -> j3461711515;
	j2996807326 [label="Твои намёки, что я чувствую что-то к тебе, не настоящее. Это самое далекое от правды.",shape=box,color=red];
		j2996807326 -> j3164609549;
	j2731704616 [label="Но меня искренне забавляет сам факт того, что было принято решение заключить со мной сделку ради моей благосклонности. И вот мы где. Однако было бы неверно с моей стороны не поинтересоваться, остаётся ли это тем, что ты всё ещё желаешь продолжить?",shape=box,color=blue];
		j2731704616 -> j3723582114;
