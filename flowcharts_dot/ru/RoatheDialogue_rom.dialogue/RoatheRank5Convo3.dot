	j2476897730 [label="Боюсь, меня оставили здесь в этой копии склепа с этими двумя фанатиками чуть дольше, чем следовало.",shape=box,color=blue];
		j2476897730 -> j3608031627;
	j351397865 [label="Сначала это меня озадачило, тогда когда тебе захотелось начать торговаться со мной по началу. Зачем? Зачем заключать настолько опасно расплывчатую сделку ради такой странной просьбы?",shape=box,color=blue];
