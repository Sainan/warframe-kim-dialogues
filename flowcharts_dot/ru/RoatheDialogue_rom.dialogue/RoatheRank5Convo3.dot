		j2134760772 -> j1492113065;
	j3964535250 [label="Boolean RoatheLoved is now true.",color=orange];
		j3964535250 -> j2943059476;
	j1182878198 [label="In fact, perhaps that is the true connective tissue of the human race: our masterful ability to look in the mirror and deceive ourselves.",shape=box,color=blue];
		j1182878198 -> j4004125570;
	j1732139027 [label="Oh, Drifter darling. When I said \"the three of us\" I meant that in a more general sense.",shape=box,color=blue];
