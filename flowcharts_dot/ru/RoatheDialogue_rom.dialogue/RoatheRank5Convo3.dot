		j2083999738 -> j2928779280;
	j1754548150 [label="Получается, в бак Фибоначчи по ошибке попало вяжущее?",shape=box,color=blue];
		j1754548150 -> j2625852461;
	j2320153974 [label="В ожидании следующего сигнала от Альбрехта.",shape=box,color=blue];
		j2320153974 -> j1144406450;
	j1217425437 [label="В самом деле, дело дошло до того, что была заключена сделка со мной, лишь бы обеспечить невозможность провала в попытке добиться моей привязанности.",shape=box,color=blue];
		j1217425437 -> j629655385;
	j533932933 [label="В ожидании следующего сигнала от Альбрехта.",shape=box,color=blue];
		j533932933 -> j2871319503;
	j1573456261 [label="И, как и ожидалось, всё пришло в тупик из-за выбранной добычи, Марии. Верно, Узурпатор? Но это не важно. Дьявол прибыл исполнить условия нашего договора.",shape=box,color=blue];
		j1573456261 -> j876934645;
		j1573456261 -> j1843428624;
		j1573456261 -> j2006113375;
	j2233997976 [label="И, как и было предвидено, ситуация сама свернулась в угол из-за выбранной добычи, Лиона. (Хотя я искренне не понимаю, как это вообще получилось.) Не важно. Дьявол здесь, чтобы выполнить наш контракт.",shape=box,color=blue];
		j2233997976 -> j1413101023;
		j2233997976 -> j1631065233;
		j2233997976 -> j113585243;
