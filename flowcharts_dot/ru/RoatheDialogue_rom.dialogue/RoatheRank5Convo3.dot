		j1748103238 -> j776748929;
	j359983472 [label="Хорошо, что ты не держишь зла против меня.",shape=box,color=red];
		j359983472 -> j1346097124;
	j1746951788 [label="Это... не просто одиночество, Роут. Мне действительно не всё равно.",shape=box,color=red];
		j1746951788 -> j1514607981;
	j3127462159 [label="Ненавижу звучать до ужаса поверхностно и грубо, но... давно ли зеркало удостаивалось внимания?",shape=box,color=red];
		j3127462159 -> j1334437512;
	j4144257197 [label="Роут. Ты можешь мне не верить, но я… я люблю тебя.",shape=box,color=red];
		j4144257197 -> j2117528274;
	j3659447195 [label="Ты можешь мне не верить, но я забочусь о тебе.",shape=box,color=red];
		j3659447195 -> j882641717;
	j1382004532 [label="Или - ах! Ты из тех старомодных язычников, которые верят в «моногамию»? Какая прелесть!",shape=box,color=blue];
		j1382004532 -> j1841502862;
