		j1505679325 -> j3636608890;
	j2038640650 [label="Кто угодно, чей взгляд на жизнь не так настойчив, мог бы увидеть твоё… предприимчивое поведение в куда менее благоприятном свете.",shape=box,color=blue];
		j2038640650 -> j3359682016;
		j2038640650 -> j3597060189;
	j1387600296 [label="Ты исполняешь его поручения, чиня разбитые семьи и пустые сердца повсюду, куда бы не было движение. И поневоле приходит мысль, что плату ты принимаешь плотью. Моей плотью, если точнее.",shape=box,color=blue];
		j1387600296 -> j3769059250;
	j3981578656 [label="Выполняются его веления, соединяются расколотые семьи и пустые сердца на каждом шагу. Но при этом забирается частичка себе, не так ли? Из моей плоти.",shape=box,color=blue];
