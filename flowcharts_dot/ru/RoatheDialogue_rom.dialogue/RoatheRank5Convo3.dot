		j2316133914 -> j1732139027 [label=true,color=green];
		j2316133914 -> j2955026100 [label=false,color=brown];
	j1889999388 [label="Well, I for one would not mind in the slightest, as you can very likely tell by this conversation. I doubt the zealots would either.",shape=box,color=blue];
