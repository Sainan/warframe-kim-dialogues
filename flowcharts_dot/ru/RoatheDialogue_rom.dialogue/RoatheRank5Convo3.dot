		j882641717 -> j480020771;
	j1841502862 [label="[Confess feelings.] Well, it wasn't because I don't have feelings for you, I just didn't know how to bring it up...",shape=box,color=red];
		j1841502862 -> j2316133914;
	j1247410374 [label="I wasn't sure how you would all feel about the topic.",shape=box,color=red];
