		j128860923 -> "Chat ends.";
	j4092864822 [label="For together, what we are capable of boggles the mind, doesn't it, Drifter darling?",shape=box,color=blue];
		j4092864822 -> "Chat ends.";
	j1569671304 [label="The future awaits us.",shape=box,color=blue];
		j1569671304 -> "Chat ends.";
