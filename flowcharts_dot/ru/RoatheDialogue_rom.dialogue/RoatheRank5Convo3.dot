		j297157736 -> j415075565;
	j3609598506 [label="Я надеюсь, что во мне и в моей любви к тебе нет ни тени сомнения.",shape=box,color=red];
		j3609598506 -> j569011462;
	j3356642857 [label="Прости, но моё… моё решение изменилось. Я на самом деле тебя не люблю.",shape=box,color=red];
		j3356642857 -> j1915722732;
