		j1444325783 -> j4085217955 [label="false",color=purple];
		j1444325783 -> j593243899 [label="false",color=purple];
	j3960482131 [label="Единственное, что опаснее дьявола... это дьявол, у которого есть друзья обязанные ему, вроде тебя. А теперь, если позволишь, мне пора отправиться докучать одной парящей «Сестре Сола».",shape=box,color=blue];
		j3960482131 -> "Initiate conversation MarieRoatheRepair in /Lotus/Types/Gameplay/1999Wf/Dialogue/MarieDialogue_rom.dialogue";
	j1016518537 [label="Единственное, что опаснее дьявола... это дьявол, у которого есть друзья обязанные ему, вроде тебя. А теперь, если позволишь, мне пора отправиться докучать одного безумного священника.",shape=box,color=blue];
		j1016518537 -> "Initiate conversation LyonRoatheRepair in /Lotus/Types/Gameplay/1999Wf/Dialogue/LyonDialogue_rom.dialogue";
	j1781789748 [label="Ха! Хорошо сыграно.",shape=box,color=blue];
		j1781789748 -> "Chat ends.";
	j1668514111 [label="С тобой просто слишком забавно, чтобы всерьез тебя злить. Мне же нужно как то развлекать себя, в конце концов.",shape=box,color=blue];
		j1668514111 -> "Chat ends.";
	j1492113065 [label="Boolean RoatheFailUnloved is now true.",color=orange];
		j1492113065 -> j2965571546;
	j1843474608 [label="Скиталец... мой бедный, милый Скиталец...",shape=box,color=blue];
		j1843474608 -> j748427235;
	j1805983944 [label="И все это ради того, чтобы избежать ужасного стыда от признания того, что нам нужно измениться.",shape=box,color=blue];
		j1805983944 -> j1463085237;
	j2670821879 [label="Я не имел в виду конкретно себя.",shape=box,color=blue];
		j2670821879 -> j2481441043;
	j546622150 [label="Это немного неожиданно.",shape=box,color=blue];
		j546622150 -> j50448278;
	j1877257804 [label="+5 Chemistry",color=orange];
		j1877257804 -> j547987814;
	j4113854097 [label="Я уж точно не тот, кто будет сидеть здесь и осуждать тебя за это.",shape=box,color=blue];
		j4113854097 -> "Chat ends.";
	j4088960052 [label="Нужно также понимать, что до этого момента моя любовь была ценностью, которую никто не стремился заполучить. По крайней мере, в каком-то значимом смысле.",shape=box,color=blue];
		j4088960052 -> j701710566;
	j366704943 [label="То что... ты для меня очень многое значишь. И я хотел бы узнать, заинтересует ли тебя это... ну... Я даже не знаю, как бы это описали Орокин.",shape=box,color=red];
		j366704943 -> j1700051361;
	j3282945039 [label="Честно говоря, неважно. После всего, вообще вылетело из головы.",shape=box,color=red];
		j3282945039 -> j2647858188;
	j3582919970 [label="Так что, видимо, у тебе готовность продать свою душу за один кусок хлама. Представляешь моё недоумение.",shape=box,color=blue];
		j3582919970 -> j2729057434;
	j1541915187 [label="Хорошо, что ты не держишь зла против меня.",shape=box,color=red];
		j1541915187 -> j4292940706;
	j3321854309 [label="Это... не просто одиночество, Роут. Мне действительно не всё равно.",shape=box,color=red];
		j3321854309 -> j3164609549;
	j3940284038 [label="Если ты пытаешься расторгнуть договор, чтобы тебе не нужно было исполнять свою часть договора, не беспокойся. Это не сработает.",shape=box,color=blue];
