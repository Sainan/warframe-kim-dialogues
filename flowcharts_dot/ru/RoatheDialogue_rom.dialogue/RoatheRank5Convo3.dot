	j1746951788 [label="Это... не просто одиночество, Роут. Мне действительно не всё равно.",shape=box,color=red];
		j1746951788 -> j1514607981;
	j3917719530 [label="Ненавижу звучать до ужаса поверхностно и грубо, но... давно ли зеркало удостаивалось внимания?",shape=box,color=red];
		j3917719530 -> j1760504301;
	j919899789 [label="Роут. Ты можешь мне не верить, но я… я люблю тебя.",shape=box,color=red];
