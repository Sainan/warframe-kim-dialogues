		j3128116509 -> j1805983944;
	j3965071229 [label="Ох, Скиталец, сокровище. Когда я сказал «мы трое», я имел в виду более общий смысл.",shape=box,color=blue];
		j3965071229 -> j2670821879;
	j2534622525 [label="Хм?",shape=box,color=blue];
		j2534622525 -> j2501575959;
	j2966111808 [label="Что касается твоих прежних обязательств? Честность и согласие - это ключ ко всему в жизни, Узурпатор, и ты это знаешь. ",shape=box,color=blue];
		j2966111808 -> j1877257804;
	j4273673947 [label="Ах, не принимай моё веселье за насмешку. Наслаждайся жизнью так, как тебе нравится, мой дорогой Узурпатор. Таков мой девиз.",shape=box,color=blue];
		j4273673947 -> j4113854097;
	j4271155501 [label="Ха! Ничего не поделаешь. Наслаждайся жизнью так, как тебе нравится, мой дорогой Узурпатор. Таков мой девиз.",shape=box,color=blue];
		j4271155501 -> j4113854097;
	j4088960052 [label="Нужно также понимать, что до этого момента моя любовь была ценностью, которую никто не стремился заполучить. По крайней мере, в каком-то значимом смысле.",shape=box,color=blue];
