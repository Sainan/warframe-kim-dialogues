	j2966111808 [label="Что касается твоих прежних обязательств? Честность и согласие - это ключ ко всему в жизни, Узурпатор, и ты это знаешь. ",shape=box,color=blue];
		j2966111808 -> j1877257804;
	j4273673947 [label="Ах, не принимай моё веселье за насмешку. Наслаждайся жизнью так, как тебе нравится, мой дорогой Узурпатор. Таков мой девиз.",shape=box,color=blue];
		j4273673947 -> j4113854097;
	j4271155501 [label="Ха! Ничего не поделаешь. Наслаждайся жизнью так, как тебе нравится, мой дорогой Узурпатор. Таков мой девиз.",shape=box,color=blue];
		j4271155501 -> j4113854097;
	j441861951 [label="Прости меня. Пожалуйста, прости меня. Я не знал.",shape=box,color=blue];
		j441861951 -> j4088960052;
	j3608031627 [label="Я сдаюсь. Что тебе хотелось бы мне сказать, Скиталец?",shape=box,color=blue];
		j3608031627 -> j366704943;
		j3608031627 -> j3282945039;
	j3502614770 [label="Нужно также понимать, что до этого момента моя любовь была ценностью, которую никто не стремился заполучить. По крайней мере, в каком-то значимом смысле.",shape=box,color=blue];
		j3502614770 -> j3582919970;
	j2178578633 [label="Что же остаётся одинокому Скитальцу?",shape=box,color=blue];
		j2178578633 -> j1541915187;
		j2178578633 -> j3321854309;
	j765562332 [label="Пожалуйста, не смеши меня.",shape=box,color=blue];
		j765562332 -> j3940284038;
	j1190846790 [label="И дьявол неизбежно приходит за своим.",shape=box,color=blue];
		j1190846790 -> "Chat ends.";
	j2438628202 [label="Поверь, никто не разочарован больше меня.",shape=box,color=blue];
		j2438628202 -> "Chat ends.";
	j2216506392 [label="Boolean IsDating is now true.",color=orange];
		j2216506392 -> j2110417582;
	j3086948681 [label="Однако я не мог бы быть более рад, что тобой было сделано это.",shape=box,color=blue];
		j3086948681 -> j1023657257;
	j2197472764 [label="Конечно же нет! Все эти столетия в одиночестве. Ни друзей. Ни спутников. Ты наслаждаешься жизнью!",shape=box,color=blue];
		j2197472764 -> j278402819;
	j1444325783 [label="Evaluate expressions",color=orange];
		j1444325783 -> j593243899 [label="RoatheUnloved3",color=purple];
