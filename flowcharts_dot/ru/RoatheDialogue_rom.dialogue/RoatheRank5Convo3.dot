	j366704943 [label="То что... ты для меня очень многое значишь. И я хотел бы узнать, заинтересует ли тебя это... ну... Я даже не знаю, как бы это описали Орокин.",shape=box,color=red];
		j366704943 -> j1700051361;
	j1074219687 [label="Честно говоря, неважно. После всего, вообще вылетело из головы.",shape=box,color=red];
		j1074219687 -> j2615344210;
	j3582919970 [label="Так что, видимо, у тебе готовность продать свою душу за один кусок хлама. Представляешь моё недоумение.",shape=box,color=blue];
		j3582919970 -> j2729057434;
	j1541915187 [label="Хорошо, что ты не держишь зла против меня.",shape=box,color=red];
		j1541915187 -> j4292940706;
	j336864385 [label="Это... не просто одиночество, Роут. Мне действительно не всё равно.",shape=box,color=red];
		j336864385 -> j1074248814;
	j3940284038 [label="Если ты пытаешься расторгнуть договор, чтобы тебе не нужно было исполнять свою часть договора, не беспокойся. Это не сработает.",shape=box,color=blue];
		j3940284038 -> j3575527127;
