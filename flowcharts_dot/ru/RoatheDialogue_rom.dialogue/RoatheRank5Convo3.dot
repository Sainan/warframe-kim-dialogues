	j2399902010 [label="Ah.",shape=box,color=blue];
		j2399902010 -> j4284000502;
	j4290106063 [label="Hardly! I would applaud you if we were sitting in the same room, Drifter dear. You have simply made the best of your situation.",shape=box,color=blue];
		j4290106063 -> j2284965616;
