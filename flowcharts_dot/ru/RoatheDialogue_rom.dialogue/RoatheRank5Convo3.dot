	j4284000502 [label="Of course.",shape=box,color=blue];
		j4284000502 -> j849612082;
	j2284965616 [label="Albrecht and his scrawny little butler saw fit to saddle you with a collection of broken toys. Very attractive broken toys.",shape=box,color=blue];
