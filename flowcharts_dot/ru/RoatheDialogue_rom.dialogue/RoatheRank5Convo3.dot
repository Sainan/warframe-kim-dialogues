	j2942419856 [label="Ah.",shape=box,color=blue];
		j2942419856 -> j3777146090;
	j3461711515 [label="Отнюдь. Я бы искренне аплодировал, окажись мы рядом, милый Скиталец. Ситуация была обыграна наилучшим образом.",shape=box,color=blue];
		j3461711515 -> j2398050315;
