	"Chat ends." [color=orange];
	j1770677710 [label="ОРОКИН",shape=box,color=blue];
		j1770677710 -> j3114434480;
	j3114434480 [label="Транскрипт: Долгое время у Империи Орокин не было врагов. Её армия существовала лишь для того, чтобы преследовать мелкие обиды, дом против дома, Исполнитель против Исполнителя.",shape=box,color=blue];
		j3114434480 -> j3435177037;
	j3435177037 [label="Когда Владеющие Разумом напали, мы познали единство, в котором нам долго отказывали. Даксы обнажили свои мечи против чего-то иного, нежели наглый крестьянин или вороватый торговец.",shape=box,color=blue];
		j3435177037 -> j1459714510;
	j1459714510 [label="Императоры, бессмертные номинальные правители Империи, чья власть была возложена на Исполнителей, пробудились на своих пыльных золотых тронах.",shape=box,color=blue];
		j1459714510 -> j822909402;
	j822909402 [label="War, magnificent war! At last, the Empire meant something. Defined by an extinction more imminent than the Sun’s eventual death, we drank deep of the nectar of life.",shape=box,color=blue];
		j822909402 -> j921430358;
	j921430358 [label="Add 1 to HellStory counter",color=orange];
		j921430358 -> "Chat ends.";
}