	"Chat ends." [color=orange];
	j2335787451 [label="ГС: ОРОКИН",shape=box,color=blue];
		j2335787451 -> j2122810746;
	j2122810746 [label="Транскрипт: Долгое время у Империи Орокин не было врагов. Её армия существовала лишь для того, чтобы преследовать мелкие обиды, дом против дома, Исполнитель против Исполнителя.",shape=box,color=blue];
		j2122810746 -> j4072429201;
	j4072429201 [label="Когда Владеющие Разумом напали, мы познали единство, в котором нам долго отказывали. Даксы обнажили свои мечи против чего-то иного, нежели наглый крестьянин или вороватый торговец.",shape=box,color=blue];
		j4072429201 -> j1260008054;
	j1260008054 [label="Императоры, бессмертные номинальные правители Империи, чья власть была возложена на Исполнителей, пробудились на своих пыльных золотых тронах.",shape=box,color=blue];
		j1260008054 -> j4046112916;
	j4046112916 [label="Война, великолепная война! Наконец Империя обрела смысл. Очерченные вымиранием, более близким, чем неизбежная смерть Солнца, мы жадно пили нектар жизни.",shape=box,color=blue];
		j4046112916 -> j921430358;
	j921430358 [label="Add 1 to HellStory counter",color=orange];
		j921430358 -> "Chat ends.";
}