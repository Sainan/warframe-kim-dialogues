	2150 [label="Транскрипт: Долгое время у Империи Орокин не было врагов. Её армия существовала лишь для того, чтобы преследовать мелкие обиды, дом против дома, Исполнитель против Исполнителя.",shape=box,color=blue];
		2150 -> 2153;
	2153 [label="Когда Владеющие Разумом напали, мы познали единство, в котором нам долго отказывали. Даксы обнажили свои мечи против чего-то иного, нежели наглый крестьянин или вороватый торговец.",shape=box,color=blue];
		2153 -> 2154;
	2154 [label="Императоры, бессмертные номинальные правители Империи, чья власть была возложена на Исполнителей, пробудились на своих пыльных золотых тронах.",shape=box,color=blue];
		2154 -> 5683;
	5683 [label="War, magnificent war! At last, the Empire meant something. Defined by an extinction more imminent than the Sun’s eventual death, we drank deep of the nectar of life.",shape=box,color=blue];
		5683 -> 2152;
