digraph {
	graph [fontname="Roboto Condensed"];
	node [fontname="Roboto Condensed"];
	edge [fontname="Roboto Condensed"];

	"RoatheRank4Convo5 begins." [color=orange];
		"RoatheRank4Convo5 begins." -> j794599897;
	j794599897 [label="Насколько хорошо ты помнишь свои дни в Империи, Узурпатор? Помнишь, в лучшем случае, обрывочные сведения. Не то чтобы я был вправе судить.",shape=box,color=blue];
		j794599897 -> j2298487628;
		j794599897 -> j3335616312;
		j794599897 -> j1571579609;
		j794599897 -> j1310452999;
	j2298487628 [label="Достаточно, чтобы понять, что вы все заслужили сгореть заживо.",shape=box,color=red];
		j2298487628 -> j1047910140;
	j3335616312 [label="Отрывки и куски. Почему?",shape=box,color=red];
		j3335616312 -> j430132625;
	j1571579609 [label="Я был совсем маленьким, когда нас посадили на «Зариман». А после этого… ну, вот так.",shape=box,color=red];
		j1571579609 -> j430132625;
	j1310452999 [label="[Конец.]",shape=box,color=red];
		j1310452999 -> "Chat ends.";
	j1047910140 [label="Это справедливо. Однако ты упускаешь целые пласты нашей истории и культурных записей. Я знаю, что после падения нас почти не любили, но...",shape=box,color=blue];
		j1047910140 -> j2201538004;
	j430132625 [label="Хм. Мне просто кажется странным, что сохранилось так мало полных записей о нашем обществе и культуре. Я понимаю, что после падения к нам относились сдержанно, но...",shape=box,color=blue];
		j430132625 -> j577535099;
	"Chat ends." [color=orange];
	j2201538004 [label="Даже ни слова о том, что случилось с Криолеумами?",shape=box,color=blue];
		j2201538004 -> j1223978050;
		j2201538004 -> j3034326991;
	j577535099 [label="Даже ни слова о том, что случилось с Криолеумами?",shape=box,color=blue];
		j577535099 -> j1378133176;
		j577535099 -> j927376650;
	j1223978050 [label="Неужели это обернётся какой-то ужасной формой пыток со стороны Орокин?",shape=box,color=red];
		j1223978050 -> j1135136815;
	j3034326991 [label="Мне кажется, это слово запомнилось бы мне, услышь я его раньше.",shape=box,color=red];
		j3034326991 -> j1907470623;
	j1378133176 [label="Крио… что?",shape=box,color=red];
		j1378133176 -> j3217444783;
	j927376650 [label="Мне кажется, я бы запомнил это слово, если бы услышал его раньше.",shape=box,color=red];
		j927376650 -> j3217444783;
	j1135136815 [label="Шокирует? Нет. Возможно, это потому, что я провёл последние… слишком многие годы, запертый в склепе с этими двумя фанатиками, но меня поражает, что за тысячелетия не сохранилось ни одной записи о том, как Орокин обращались со своими мёртвыми.",shape=box,color=blue];
		j1135136815 -> j2200992773;
		j1135136815 -> j3112887540;
	j1907470623 [label="Возможно, это потому, что я провёл последние… слишком многие годы, запертый в склепе с этими двумя фанатиками, но меня поражает, что за тысячелетия не сохранилось ни одной записи о том, как Орокин обращались со своими мёртвыми.",shape=box,color=blue];
		j1907470623 -> j1613411834;
		j1907470623 -> j4141036211;
	j3217444783 [label="Возможно, это потому, что я провёл последние… слишком многие годы, запертый в склепе с этими двумя фанатиками, но меня поражает, что за тысячелетия не сохранилось ни одной записи о том, как Орокин обращались со своими мёртвыми.",shape=box,color=blue];
		j3217444783 -> j260639964;
		j3217444783 -> j2366844749;
	j2200992773 [label="Я не думал, что ты умер. Ты просто украл новые тела в театре «Юван».",shape=box,color=red];
		j2200992773 -> j947438560;
	j3112887540 [label="Я думал, вы похищали людей, чтобы решить эту проблему. Всё, что вы сделали — лишь высмеяли саму смерть.",shape=box,color=red];
		j3112887540 -> j1160592167;
	j1613411834 [label="Я не думал, что ты умер. Ты просто украл новые тела в театре «Юван».",shape=box,color=red];
		j1613411834 -> j947438560;
	j4141036211 [label="Продолжай.",shape=box,color=red];
		j4141036211 -> j1618449796;
	j260639964 [label="Я не думал, что ты умер. Ты просто украл новые тела в театре «Юван».",shape=box,color=red];
		j260639964 -> j1245144925;
	j2366844749 [label="Продолжай.",shape=box,color=red];
		j2366844749 -> j1850093945;
	j947438560 [label="Да, но как насчёт всех остальных, кто был «близок», но «не совсем достаточно важен»? Архимедиан. Или Орокин низшего ранга? Всегда существовали уровни внутри уровней. Даже если потолки были стеклянными, они существовали. Поверь мне.",shape=box,color=blue];
		j947438560 -> j914943370;
	j1160592167 [label="Действительно, мы делали это. На каждом возможном шаге. Но не всех пощадили, не так ли? А как насчёт тех, кто был «близок», но «не достаточно важен»? Архимедиан? Орокин низшего ранга?",shape=box,color=blue];
		j1160592167 -> j1484988493;
	j1618449796 [label="Вспомни всех тех, кто был «близок», но «не совсем достаточно важен». Архимедиан. Орокин низшего ранга. Всегда существовали уровни внутри уровней. Даже если потолки были стеклянными, они существовали. Поверь мне.",shape=box,color=blue];
		j1618449796 -> j914943370;
	j1245144925 [label="Да, но как насчёт всех остальных, кто был «близок», но «не совсем достаточно важен»? Архимедиан. Или Орокин низшего ранга? Всегда существовали уровни внутри уровней. Даже если потолки были стеклянными, они существовали. Поверь мне.",shape=box,color=blue];
		j1245144925 -> j3963490493;
	j1850093945 [label="Вспомни всех тех, кто был «близок», но «не совсем достаточно важен». Архимедиан. Орокин низшего ранга. Всегда существовали уровни внутри уровней. Даже если потолки были стеклянными, они существовали. Поверь мне.",shape=box,color=blue];
		j1850093945 -> j3963490493;
	j914943370 [label="Не всем так везло, чтобы им даровали новое тело каждый раз, когда их старая форма выгорала дотла. Но я уверен, тебе кажется отвратительной практика Театра Юван, не так ли?",shape=box,color=blue];
		j914943370 -> j2297888032;
		j914943370 -> j2346426263;
	j1484988493 [label="Не всем так везло, чтобы им даровали новое тело каждый раз, когда их старая форма выгорала дотла. Очевидно, тебе кажется отвратительной практика Театра Юван.",shape=box,color=blue];
		j1484988493 -> j3846926644;
		j1484988493 -> j2346426263;
	j3963490493 [label="Не всем так везло, чтобы им даровали новое тело каждый раз, когда их старая форма выгорала дотла. Но я уверен, тебе кажется отвратительной практика Театра Юван, не так ли?",shape=box,color=blue];
		j3963490493 -> j477668389;
		j3963490493 -> j3067292736;
	j2297888032 [label="Я недостаточно хорошо знаком с этой практикой, чтобы выносить суждение.",shape=box,color=red];
		j2297888032 -> j410414705;
	j2346426263 [label="Да, я так думаю. Мне отвратительно то, что вы все сделали. Всё, что написано о Театре Юван, говорит о том, что вы похищали детей и стирали их сознание.",shape=box,color=red];
		j2346426263 -> j2031314532;
	j3846926644 [label="Как я мог не делать этого? Вы похищали детей из их домов и стирали им память, чтобы заменить её своей собственной!",shape=box,color=red];
		j3846926644 -> j178668746;
	j477668389 [label="Я недостаточно хорошо знаком с этой практикой, чтобы выносить суждение.",shape=box,color=red];
		j477668389 -> j409038403;
	j3067292736 [label="Да, я так думаю. Мне отвратительно то, что вы все сделали. Всё, что написано о Театре Юван, говорит о том, что вы похищали детей и стирали их сознание.",shape=box,color=red];
		j3067292736 -> j883982680;
	j410414705 [label="+5 Chemistry",color=orange];
		j410414705 -> j3807284091;
	j2031314532 [label="Всё, что написано о Театре Юван, говорит…» Где всё это зафиксировано? И, что важнее, кто написал всё это?",shape=box,color=blue];
		j2031314532 -> j3364164518;
	j178668746 [label="И откуда ты всё это знаешь? Ты сам был свидетелем Театра Юван?",shape=box,color=blue];
		j178668746 -> j893606166;
		j178668746 -> j197145575;
		j178668746 -> j216380266;
	j409038403 [label="+5 Chemistry",color=orange];
		j409038403 -> j3807284091;
	j883982680 [label="И всё же ты только что сказал, что остались лишь осколки нашей истории и культурных записей. А где всё это зафиксировано? И, что важнее, кто написал всё это?",shape=box,color=blue];
		j883982680 -> j3364164518;
	j3807284091 [label="Воздерживаешься от суждений, пока не соберёшь всю информацию? Боже мой, Узурпатор! Ты звучишь разумно! Какая редкость!",shape=box,color=blue];
		j3807284091 -> j2224698980;
	j3364164518 [label="Это истории, рассказанные теми, кто явно заинтересован в том, чтобы представить каждый аспект Орокин в как можно более катастрофическом и зловещем свете.",shape=box,color=blue];
		j3364164518 -> j4278296508;
	j893606166 [label="Нет.",shape=box,color=red];
		j893606166 -> j3970214510;
	j197145575 [label="Да.",shape=box,color=red];
		j197145575 -> j2026409289;
	j216380266 [label="Неважно, сделал я это или нет, отчеты говорят сами за себя.",shape=box,color=red];
		j216380266 -> j3277211008;
	j2224698980 [label="Позволь мне тогда сместить для тебя ракурс истории, если позволишь. Подумай, откуда происходят те сведения о Театре Юван, которые тебе, возможно, довелось слышать.",shape=box,color=blue];
		j2224698980 -> j3364164518;
	j4278296508 [label="Те, кто разрушает все опорные структуры самого общества Изначальной Системы и повергает его в полный хаос, должны дать вескую причину тем, кто зависит от этого общества.",shape=box,color=blue];
		j4278296508 -> j3377868175;
	j3970214510 [label="Значит, ты полагаешься на вторичные источники. Подумай, где эти сведения записаны. И, что важнее, подумай, кто их написал.",shape=box,color=blue];
		j3970214510 -> j3364164518;
	j2026409289 [label="Ха! Лжец. ",shape=box,color=blue];
		j2026409289 -> j339244125;
	j3277211008 [label="Так ли это? Подумай, где эти сведения записаны. И, что важнее, подумай, кто написал все эти записи.",shape=box,color=blue];
		j3277211008 -> j3364164518;
	j3377868175 [label="Представьте себе жизнь обычного человека на реле, Узурпатор. Человека, далёкого от испытаний и невзгод Тэнно. Человека, которому было наплевать на Великую войну.",shape=box,color=blue];
		j3377868175 -> j1129636180;
	j339244125 [label="Ты полагаешься на вторичные источники. Подумай, где эти сведения записаны. И, что важнее, подумай, кто их написал.",shape=box,color=blue];
		j339244125 -> j3364164518;
	j1129636180 [label="Когда Орокин пали, их жизни превратились в сущий ад в образовавшемся вакууме власти. Приходилось придумывать объяснения. Нужно было делать и сжигать образы. Нас нужно было сделать чудовищами во тьме.",shape=box,color=blue];
		j1129636180 -> j2055495838;
		j1129636180 -> j3105430137;
	j2055495838 [label="Ты хочешь сказать, что не похищал детей для Театра Юван против их воли?",shape=box,color=red];
		j2055495838 -> j4164959493;
	j3105430137 [label="Так что же на самом деле произошло в театре «Юван»?",shape=box,color=red];
		j3105430137 -> j2129841000;
	j4164959493 [label="Нет, это совершенно верно.",shape=box,color=blue];
		j4164959493 -> j1955066135;
	j2129841000 [label="+5 Chemistry",color=orange];
		j2129841000 -> j1909514532;
	j1955066135 [label="Я лишь хочу, чтобы ты задумался о своих источниках, вот и всё.",shape=box,color=blue];
		j1955066135 -> j638529460;
	j1909514532 [label="Сказать, что мы не брали жертв против их воли, было бы неверно. Мы брали. Но это не вся правда. Эти вещи редко бывают такими простыми и никогда не бывают черно-белыми.",shape=box,color=blue];
		j1909514532 -> j3918760677;
	j638529460 [label="Потому что это не вся правда. Эти вещи редко бывают такими простыми и никогда не бывают черно-белыми. Мир сер, Узурпатор. Границы провести не так уж легко. ",shape=box,color=blue];
		j638529460 -> j2568413270;
	j3918760677 [label="Мир сер, Узурпатор. Границы провести не так уж легко.",shape=box,color=blue];
		j3918760677 -> j2568413270;
	j2568413270 [label="Эта практика началась не таким уж постыдным образом. Поначалу это считалось высшей честью. Отдать себя ради того, чтобы Империя продолжала существовать нерушимой. Непоколебимой. Чтобы работа могла продолжаться.",shape=box,color=blue];
		j2568413270 -> j965422141;
	j965422141 [label="И дело началось не с молодежи. Началось с тех, у кого просто было больше лет, которые можно было посвятить этому делу. Но затем те, кто предлагал себя, становились... все моложе и моложе. Преданность — это сильный наркотик.",shape=box,color=blue];
		j965422141 -> j389931312;
	j389931312 [label="Я видел нечто подобное среди тех, кто записывался на войну. Они лгали о своем возрасте в документах, чтобы «бороться за правое дело». Они и не подозревали, что создают опасный прецедент для тех, кто невольно придет на войну после них.",shape=box,color=blue];
		j389931312 -> j3636467592;
	j3636467592 [label="В какой-то момент какой-то Исполнитель понял, что это можно использовать в качестве... карательной меры. Что определённые города или... целые планеты можно держать под контролем, если использовать угрозу театра Юван. Если сбор жертв будет осуществляться особенно жёстким способом.",shape=box,color=blue];
		j3636467592 -> j431921673;
		j3636467592 -> j1499645567;
	j431921673 [label="И что ты думаешь об этом?",shape=box,color=red];
		j431921673 -> j3410349069;
	j1499645567 [label="Ты когда-нибудь приносил себя в жертву против своей воли?",shape=box,color=red];
		j1499645567 -> j2474018813;
	j3410349069 [label="+5 Chemistry",color=orange];
		j3410349069 -> j4161596208;
	j2474018813 [label="Я не буду тебе лгать. Я лгал. И можешь считать меня чудовищем за это сколько угодно. Но когда всё ваше общество построено на многовековой нормализации чего-либо, очень трудно отвернуться от этого.",shape=box,color=blue];
		j2474018813 -> j1951125691;
	j4161596208 [label="Хм. С одной стороны, я сам много раз бывал в театре. Было бы верхом лицемерия осуждать его. Когда всё ваше общество построено на многовековой нормализации чего-либо, очень трудно отвернуться от этого.",shape=box,color=blue];
		j4161596208 -> j52400939;
	j1951125691 [label="Даже когда оглядываешься назад или в момент прозрения, всё становится предельно ясно. ",shape=box,color=blue];
		j1951125691 -> j4220699281;
	j52400939 [label="С другой стороны, в вакууме или при ретроспективе ужас этого деяния становится вполне очевидным.",shape=box,color=blue];
		j52400939 -> j4220699281;
	j4220699281 [label="+5 Chemistry",color=orange];
		j4220699281 -> j1847541881;
	j1847541881 [label="Никто не должен жить вечно, Узурпатор. И театр — тому доказательство.",shape=box,color=blue];
		j1847541881 -> "Chat ends.";
}