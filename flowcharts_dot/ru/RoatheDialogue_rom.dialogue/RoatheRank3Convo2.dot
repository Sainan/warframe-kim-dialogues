		1635 -> 1649 [label=false,color=brown];
	1636 [label="Мм. Мудро. Хотя это и вызывает вопрос: уж не привлёк ли я твоё внимание, Скиталец? Если ты думаешь, что меня волнует то, что ты увлечён кем‑то другим, то это не так.",shape=box,color=blue];
