	1545 [label="Check boolean RoatheKnowsReset2",color=orange];
		1545 -> 1554 [label=true,color=green];
		1545 -> 1553 [label=false,color=brown];
	1548 [label="Когда-то я считал нас партнёрами. В политике, в интригах, в постели...",shape=box,color=blue];
		1548 -> 1557;
	1546 [label="Деловые партнеры?",shape=box,color=red];
		1546 -> 1555;
	1547 [label="Партнеры, как?",shape=box,color=red];
		1547 -> 1556;
	1549 [label="Вряд ли. Но одну вещь тебе нужно понимать об Орокин: мы всегда строили козни друг против друга. ",shape=box,color=blue];
		1549 -> 1550;
	1550 [label="Я знал, что Ниток без колебаний убьёт меня в любой момент, если это хоть немного могло бы помочь ей в достижении её целей.",shape=box,color=blue];
		1550 -> 1558;
	1551 [label="Думаю, ей нравился этот вызов, Узурпатор. Чувство опасности. Восторг от осознания, что она спит с тем, кто желает её смерти.",shape=box,color=blue];
		1551 -> 1559;
	1552 [label="Мне хотелось бы притвориться, что мы были первыми Орокин, оказавшимися в такой ситуации, но это даже не было чем-то редким.",shape=box,color=blue];
		1552 -> 1559;
	1554 [label="Точно! Как будто ты уже слышал это раньше. Но это неудивительно. Она довольно регулярно поддразнивала меня этим.",shape=box,color=blue];
		1554 -> 1543;
		1554 -> 1544;
	1553 [label="Точно! Но это не такой уж неожиданный поворот. Она тоже это предвидела и регулярно поддразнивала меня этим.",shape=box,color=blue];
		1553 -> 1543;
		1553 -> 1544;
	1557 [label="Я, разумеется, не считал нас равными. Она была Исполнителем. Великая Ниток. Но я считал себя Первым среди её меньших.",shape=box,color=blue];
		1557 -> 1561;
	1555 [label="Ты прелесть. Да, в каком-то смысле мы были деловыми партнёрами. Но мы были партнёрами и во многих других, более важных отношениях.",shape=box,color=blue];
		1555 -> 1556;
	1556 [label="На войне. В политике. В интригах. В постели.",shape=box,color=blue];
		1556 -> 1560;
	1558 [label="И всё же она знала, что я точу ножи у неё за спиной и с нетерпением жду момента, когда сниму её голову с плеч.",shape=box,color=blue];
		1558 -> 1562;
	1559 [label="Чем дольше я живу, тем больше понимаю, что, возможно, мы не были видом, созданным для бессмертия.",shape=box,color=blue];
		1559 -> 1563;
	1561 [label="Какой же я был дурак...",shape=box,color=blue];
		1561 -> 1565;
		1561 -> 1566;
		1561 -> 1567;
		1561 -> 1568;
		1561 -> 1569;
	1560 [label="Но мне интересно, не ошибаюсь ли я. Может быть, «партнёр» — слишком сильное слово для того, кем мы были на самом деле. ",shape=box,color=blue];
		1560 -> 1564;
	1562 [label="Можно сказать, что у нас были... сложные отношения.",shape=box,color=blue];
		1562 -> 1569;
		1562 -> 1568;
		1562 -> 1567;
		1562 -> 1565;
		1562 -> 1566;
	1563 [label="Но да. Можно сказать, что у нас с Ниток были... сложные отношения.",shape=box,color=blue];
		1563 -> 1569;
		1563 -> 1568;
		1563 -> 1567;
		1563 -> 1565;
		1563 -> 1566;
	1565 [label="Она тебе была небезразлична?",shape=box,color=red];
		1565 -> 1570;
	1566 [label="Ты любил ее?",shape=box,color=red];
		1566 -> 1571;
	1567 [label="Ты ей доверял?",shape=box,color=red];
		1567 -> 1572;
	1568 [label="Не жалей о том, что сделал. Ты сделал свой выбор. Пути назад нет. Только вперёд.",shape=box,color=red];
		1568 -> 1573;
	1569 [label="Единственное, что мы можем сделать, чтобы искупить содеянное, это смотреть вперёд ясными глазами.",shape=box,color=red];
		1569 -> 1574;
	1564 [label="Она была Великой Ниток. Исполнителем.",shape=box,color=blue];
		1564 -> 1561;
	1570 [label="Бездна, нет! Если бы она однажды днём, напившись, вышла из шлюза, это решило бы большую часть моих проклятых проблем.",shape=box,color=blue];
		1570 -> 1575;
	1571 [label="+5 Chemistry",color=orange];
		1571 -> 1576;
	1572 [label="Бездна, нет! Никогда не доверяй Орокин, Скиталец. Включая меня. Особенно меня! Люби нас, ненавидь нас, обожай нас, презирай нас — но никогда, никогда не доверяй нам.",shape=box,color=blue];
		1572 -> 1577;
	1573 [label="Add -1 to Thermostat",color=orange];
		1573 -> 1578;
	1574 [label="Add 1 to Thermostat",color=orange];
		1574 -> 1579;
	1575 [label="Я абсолютно, совершенно её презирал и больше всего на свете обожал бы медленно, тщательно, аккуратно снимать её голубую кожу с тела голыми руками.",shape=box,color=blue];
		1575 -> 1580;
		1575 -> 1581;
	1576 [label="Какой дерзкий вопрос! Кажется, я тебя обожаю за этот вопрос. Знаешь, кажется, я её действительно любил, совсем чуть-чуть. Честно говоря, я даже не задумывался об этом до этого момента.",shape=box,color=blue];
		1576 -> 1582;
	1577 [label="Мы склонны к приступам беспокойства.",shape=box,color=blue];
		1577 -> 1583;
		1577 -> 1584;
	1578 [label="+10 Chemistry",color=orange];
		1578 -> 1585;
	1579 [label="+10 Chemistry",color=orange];
		1579 -> 1586;
	1580 [label="Это было... ярко.",shape=box,color=red];
		1580 -> 1587;
	1581 [label="И все же ты спал с ней?",shape=box,color=red];
		1581 -> 1588;
	1582 [label="Да, думаю, я был немного в неё влюблён. Какое любопытное осознание...",shape=box,color=blue];
		1582 -> 1589;
	1583 [label="Принято.",shape=box,color=red];
		1583 -> 1590;
	1584 [label="Это не будет проблемой.",shape=box,color=red];
		1584 -> 1591;
	1585 [label="Возможно, это верно. Жить прошлым опасно, ведь мы нагружаем себя лишь сожалением и стыдом, и ничем больше. ",shape=box,color=blue];
		1585 -> 1592;
	1586 [label="Возможно, это верно. Жить прошлым опасно, ведь мы нагружаем себя лишь сожалением и стыдом, и ничем больше. ",shape=box,color=blue];
		1586 -> 1593;
	1587 [label="Только эта мысль позволяла мне вытерпеть многие из моих... обязательных вечеров в её постели. Прошу прощения.",shape=box,color=blue];
		1587 -> 1594;
		1587 -> 1595;
	1588 [label="То, что ты считаешь эти две вещи взаимоисключающими, просто очаровательно. Надеюсь, у тебя когда-нибудь будет возможность провести вечер с такой “знакомой”, это довольно волшебно.",shape=box,color=blue];
		1588 -> 1596;
	1589 [label="Пойми, её также застилала глубочайшая, самая невыносимая ненависть. Я презирал её на одном дыхании, и ничто не доставляло бы мне большего удовольствия, чем медленно, осторожно, нежно снять голыми руками её синюю кожу.",shape=box,color=blue];
		1589 -> 1597;
		1589 -> 1598;
	1590 [label="Evaluate expressions",color=orange];
		1590 -> 1601 [label="RoatheDatingDeal",color=purple];
		1590 -> 1600 [label="RoatheMarieDatingDeal",color=purple];
		1590 -> 1599 [label="RoatheLyonDatingDeal",color=purple];
		1590 -> 1602 [label="DrifterRoathe",color=purple];
		1590 -> 1604 [label="DrifterMarie",color=purple];
		1590 -> 1603 [label="DrifterLyon",color=purple];
		1590 -> 1605 [label="false",color=purple];
	1591 [label="Мм, да. У меня такое чувство, что я не совсем покоряю тебя своим «дьявольским обаянием», не так ли?",shape=box,color=blue];
		1591 -> 1606;
		1591 -> 1607;
	1592 [label="Какой смысл переживать наши прошлые поступки, наши прошлые неудачи и сожаления? Мы не можем их изменить, даже с этим даром путешествия во времени попытка “переделать” уже свершившееся ведёт лишь к безумию.",shape=box,color=blue];
		1592 -> 1608;
	1593 [label="Но мы также не можем забывать о злодеяниях наших прошлых “я”, ибо рискуем превратиться лишь в безумцев и деспотов, агрессивных существ, которые не видят своей вины, а видят только чужую.",shape=box,color=blue];
		1593 -> 1609;
	1594 [label="У тебя такие мысли обо всех своих любовниках? Или только о ней?",shape=box,color=red];
		1594 -> 1610;
	1595 [label="Не нужно извинений. Я просто до сих пор в шоке от того, как сильно ты ненавидел свой народ.",shape=box,color=red];
		1595 -> 1611;
	1596 [label="Я лишь рекомендую тебе не превращать такие отношения в постоянную связь. Это становится крайне нездоровым для обеих сторон. Обычно заканчивается убийством, одного или обоих.",shape=box,color=blue];
		1596 -> 1594;
		1596 -> 1612;
		1596 -> 1613;
	1597 [label="Как могут обе эти вещи быть истинными одновременно?",shape=box,color=red];
		1597 -> 1614;
	1598 [label="Это было… наглядно.",shape=box,color=red];
		1598 -> 1615;
	1601 [label="Я просто подумал, что должен дать тебе честное предупреждение, раз уж у нас есть наше маленькое… “соглашение”.",shape=box,color=blue];
		1601 -> 1618;
	1600 [label="Мм, хотя с тобой такой проблемы никогда не будет, правда? Твой взгляд направлен гораздо ближе к дому, на Мари в нашем маленьком “соглашении.”",shape=box,color=blue];
		1600 -> 1617;
	1599 [label="Мм, хотя с тобой такой проблемы никогда не будет, правда? Твой взгляд направлен куда более близко к дому, на того безумного жреца, не так ли?",shape=box,color=blue];
		1599 -> 1616;
	1602 [label="I simply thought I should give you the fair warning, seeing as you have made your... interests known.",shape=box,color=blue];
		1602 -> 1618;
	1604 [label="Mm, although, it will never be a problem with you, will it? You have your eye set far closer to home with Marie, don't you?",shape=box,color=blue];
		1604 -> 1617;
	1603 [label="Мм, хотя с тобой такой проблемы никогда не будет, правда? Твой взгляд направлен куда более близко к дому, на того безумного жреца, не так ли?",shape=box,color=blue];
		1603 -> 1616;
	1605 [label="+5 Chemistry",color=orange];
		1605 -> 1619;
	1606 [label="Нет. Извини. Ты не в моём вкусе.",shape=box,color=red];
		1606 -> 1620;
	1607 [label="Ты - да. Я просто не доверяю тебе.",shape=box,color=red];
		1607 -> 1621;
	1608 [label="Нет. Я есть то, что я есть. Я тот, кто я есть. Я иду по выбранному пути и уже не желаю извиняться за себя. Я не изменю себя ради мнений других.",shape=box,color=blue];
		1608 -> 1622;
	1609 [label="Эту черту я видел у многих из самых низших Исполнителей и Императоров – слепую веру лишь в свою собственную безупречность и безгрешность. Я презирал их за это и поклялся никогда не разделять подобного эгоистичного высокомерия.",shape=box,color=blue];
		1609 -> 1622;
	1610 [label="Я по-настоящему имел дело лишь с партнёрами в физическом смысле, Скиталец. Эмоциональных у меня никогда не было. Во всяком случае, взаимных.",shape=box,color=blue];
		1610 -> 1623;
		1610 -> 1624;
	1611 [label="+5 Chemistry",color=orange];
