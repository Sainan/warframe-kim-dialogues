	1656 [label="Это не твое дело.",shape=box,color=red];
		1656 -> 1675;
	1657 [label="Разве это не грустно? Знаю. Нет, я никогда не был. Никогда взаимно.",shape=box,color=blue];
		1657 -> 1658;
	1658 [label="Бывало ли, что чувства были односторонними? О, разумеется. Но ведь это не роман, правда? Это трагедия.",shape=box,color=blue];
		1658 -> 1676;
	1659 [label="Бюрократия.",shape=box,color=blue];
		1659 -> 1677;
	1660 [label="Такое существование легко превращается в одиночество, которое поглощает тебя целиком. Например, у меня были лишь мимолётные связи, исключительно физические, Скиталец. Эмоциональных отношений у меня никогда не было. Во всяком случае, ни одна из них не была взаимной.",shape=box,color=blue];
		1660 -> 1628;
	1661 [label="Ты никогда не был влюблён?",shape=box,color=red];
