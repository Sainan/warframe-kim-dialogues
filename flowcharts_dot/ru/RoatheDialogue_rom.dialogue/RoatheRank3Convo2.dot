	1612 [label="Я приму это к сведению.",shape=box,color=red];
		1612 -> 1626;
	1613 [label="Я этого не планировал, но спасибо за совет.",shape=box,color=red];
		1613 -> 1627;
	1614 [label="То, что ты никогда не сталкивался с подобным, делает тебя невероятно счастливчиком, Узурпатор. Не советую тебе попадать в такую ситуацию: обычно это заканчивается убийством одного из вас или обоих.",shape=box,color=blue];
		1614 -> 1628;
