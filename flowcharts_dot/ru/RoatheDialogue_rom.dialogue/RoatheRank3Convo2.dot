	1618 [label="+5 Chemistry",color=orange];
		1618 -> 1634;
	1617 [label="Она действительно красива, не могу сказать, что виню тебя. Хотя, думаю, я бы не выдержал её лицемерной набожности.",shape=box,color=blue];
		1617 -> 1633;
	1616 [label="Он довольно красив. Но у него такой вид, будто если цветок завянет, он готов объявить всему конец и спрыгнуть с ближайшей башни.",shape=box,color=blue];
		1616 -> 1633;
