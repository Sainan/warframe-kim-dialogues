	1640 [label="Мне объяснить тебе это по буквам? Очень хорошо. Я никогда не был влюблён.",shape=box,color=blue];
		1640 -> 1658;
	1641 [label="Несмотря на все наши достижения, несмотря на всю работу, которую мы проделали, чтобы спасти человечество, мы так и не решили величайшую проблему, терзавшую наши сердца. Величайший недостаток, который разъедал наши души, как раковая опухоль.",shape=box,color=blue];
		1641 -> 1659;
	1642 [label="Смотри, чтобы так и было. Похоже, ты стараешься жить достойной жизнью, Скиталец. Быть “хорошим” человеком. Я бы не хотел видеть, как ты закончишь, как Орокин. Нас определяли наши излишества.",shape=box,color=blue];
		1642 -> 1660;
	1643 [label="Весьма признателен. Похоже, ты стараешься жить достойной жизнью, Скиталец. Быть “хорошим” человеком. Я бы не хотел видеть, как ты закончишь, как Орокин. Нас определяли наши излишества.",shape=box,color=blue];
		1643 -> 1660;
	1644 [label="Я по-настоящему имел дело лишь с партнёрами в физическом смысле, Скиталец. Эмоциональных у меня никогда не было. Во всяком случае, взаимных.",shape=box,color=blue];
		1644 -> 1661;
		1644 -> 1662;
	1645 [label="Жалко, правда? Несмотря на все достижения Вселенной, мы до сих пор не можем понять, как организовать себя, не тратя часы жизни, собираясь за столом и переговариваясь.",shape=box,color=blue];
		1645 -> 1641;
	1648 [label="А теперь, когда мы знаем, на кого ты направил свой лук, это даёт нам к чему стремиться, не так ли?",shape=box,color=blue];
		1648 -> 1665;
		1648 -> 1666;
	1646 [label="Я не думаю, что я бы доверил это тебе.",shape=box,color=red];
		1646 -> 1663;
	1647 [label="Серьёзно? Ты бы... помог?",shape=box,color=red];
		1647 -> 1664;
	1650 [label="Похоже, у тебя все-таки есть склонность к «протофреймам».",shape=box,color=blue];
		1650 -> 1669;
		1650 -> 1670;
	1649 [label="Или у тебя нет склонности к “протофреймам”?",shape=box,color=blue];
		1649 -> 1667;
		1649 -> 1668;
	1651 [label="И прежде чем ты начнёшь печатать яростный ответ и гневно осуждать меня за то, что я якобы поощряю твою неверность, дай мне минуту, чтобы объяснить.",shape=box,color=blue];
		1651 -> 1671;
