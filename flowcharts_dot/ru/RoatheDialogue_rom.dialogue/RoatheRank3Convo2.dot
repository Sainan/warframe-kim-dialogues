		j3823599253 -> j1717840052;
	j1427280512 [label="Как приятно знать, что здравый вкус и чувство стиля всё же не покинули эту систему.",shape=box,color=blue];
		j1427280512 -> j464527921;
	j4266888058 [label="Horrors.",shape=box,color=blue];
		j4266888058 -> j2442346802;
