		j1484530705 -> j3409003522;
	j338640657 [label="Просто прихоть, значит? Ах, что значит быть живым. Наслаждайся этим, пока можешь, говорю я.",shape=box,color=blue];
		j338640657 -> j2719832070;
	j2719832070 [label="Следуй за своим сердцем, Скиталец. Если я о чём-то и жалею за все свои годы, так это о том, что никогда не делился этим ни с кем.",shape=box,color=blue];
