digraph {
	"RoatheRank3Convo2 begins." [color=orange];
		"RoatheRank3Convo2 begins." -> j2106881376;
		"RoatheRank3Convo2 begins." -> j1310452999;
	j2106881376 [label="Как ты собирался свергнуть Исполнителей?",shape=box,color=red];
		j2106881376 -> j3720655375;
	j1310452999 [label="[Конец.]",shape=box,color=red];
		j1310452999 -> "Chat ends.";
	j3720655375 [label="Check boolean RoatheKnowsReset2",color=orange];
		j3720655375 -> j1949695694 [label=true,color=green];
		j3720655375 -> j2143402777 [label=false,color=brown];
	"Chat ends." [color=orange];
	j1949695694 [label="Зачем ты меня об этом спрашиваешь? Что ты пытаешься узнать, Скиталец? Ты же точно не о местонахождении боеприпасов спрашиваешь.",shape=box,color=blue];
		j1949695694 -> j628141074;
	j2143402777 [label="Зачем спрашиваешь? Планируешь вернуться в прошлое и побить рекорд себя в молодости? Нужен совет, как свергнуть тоталитарное правительство? Ищешь местонахождение зарытых боеприпасов, способных взорвать целые планеты?",shape=box,color=blue];
		j2143402777 -> j3773859288;
	j628141074 [label="С чего бы мне тебе доверять? Почему я тебе доверял?!",shape=box,color=blue];
		j628141074 -> j2310817378;
	j3773859288 [label="Или это всего лишь праздная болтовня с твоей стороны?",shape=box,color=blue];
		j3773859288 -> j882316056;
		j3773859288 -> j3280152808;
		j3773859288 -> j306545891;
	j2310817378 [label="Check boolean RoatheResetForgiven",color=orange];
		j2310817378 -> j3261295162 [label=true,color=green];
		j2310817378 -> j1685828022 [label=false,color=brown];
	j882316056 [label="Мне действительно любопытно, жалеешь ли ты хоть о чём‑то. Вернулся бы ты назад и изменил бы что‑нибудь из того, что задумал.",shape=box,color=red];
		j882316056 -> j2437284279;
	j3280152808 [label="Меня завораживает мысль о том, каково это, пытаться разработать такой план. Должно быть, это был бы шедевр.",shape=box,color=red];
		j3280152808 -> j1204715702;
	j306545891 [label="Честно говоря, было бы полезно узнать, не спрятал ли ты где‑нибудь какое‑нибудь из тех видов оружия, которые до сих пор можно найти.",shape=box,color=red];
		j306545891 -> j2133570021;
	j3261295162 [label="Я простил тебя за то, что ты сделал. Хотел бы я только вспомнить, почему... почему! Почему именно ты, из всех людей?!",shape=box,color=blue];
		j3261295162 -> j1862095312;
		j3261295162 -> j568474823;
	j1685828022 [label="Почему! Почему именно ты, из всех людей?!",shape=box,color=blue];
		j1685828022 -> j568474823;
		j1685828022 -> j1058895570;
	j2437284279 [label="Add 1 to Thermostat counter",color=orange];
		j2437284279 -> j1063667144;
	j1204715702 [label="Add -1 to Thermostat counter",color=orange];
		j1204715702 -> j3268596444;
	j2133570021 [label="+5 Chemistry",color=orange];
		j2133570021 -> j2680323853;
	j1862095312 [label="Я знаю. И мне всё ещё очень жаль.",shape=box,color=red];
		j1862095312 -> j3928029964;
	j568474823 [label="Я пытаюсь помочь тебе прийти к пониманию причины.",shape=box,color=red];
		j568474823 -> j412376061;
	j1058895570 [label="Мне всё ещё жаль, что я разрушил твоё доверие, Роут. Поверь или нет, я вовсе не хотел этого.",shape=box,color=red];
		j1058895570 -> j1843640690;
	j1063667144 [label="Я сожалею только о том, что это так и не осуществилось. Жалею о потраченном времени.",shape=box,color=blue];
		j1063667144 -> j3967629872;
	j3268596444 [label="И это был шедевр, Узурпатор.",shape=box,color=blue];
		j3268596444 -> j3967629872;
	j2680323853 [label="Практично. Но многие места, где я «спрятал» свои запасы, вероятно,… исчезли за многие-многие годы.",shape=box,color=blue];
		j2680323853 -> j1395441656;
	j3928029964 [label="Да, да. Полагаю, нам стоит продолжить этот глупый разговор, где мы вновь и вновь перетираем то, о чём уже говорили.",shape=box,color=blue];
		j3928029964 -> j1831559539;
	j412376061 [label="+5 Chemistry",color=orange];
		j412376061 -> j2663538199;
	j1843640690 [label="Да, ты, вероятно, считал, что твоим поступкам не будет последствий. Но как бы там ни было, давай продолжим этот нелепый разговор, где мы снова и снова перелистываем свои прошлые версии, и просто двинемся дальше.",shape=box,color=blue];
		j1843640690 -> j1831559539;
	j3967629872 [label="+5 Chemistry",color=orange];
		j3967629872 -> j1004226692;
	j1395441656 [label="И многие из этих точек были тайной даже для меня самого. План был невероятно замысловат. Слои на слоях, на слоях.",shape=box,color=blue];
		j1395441656 -> j4103031483;
	j1831559539 [label="О чём ты спрашивал? Ах да. Как я собирался свергнуть Исполнителей? ",shape=box,color=blue];
		j1831559539 -> j4120804303;
	j2663538199 [label="Повторяя одни и те же бессмысленные разговоры о том, почему я хотел убить людей, которые уже давно мертвы и обращены в прах? По крайней мере, это прагматичный подход.",shape=box,color=blue];
		j2663538199 -> j1831559539;
	j1004226692 [label="План был невероятно замысловат. Слои на слоях, на слоях, на слоях. Убийцы, которым было поручено убить убийц других убийц, если первый убийца провалится.",shape=box,color=blue];
		j1004226692 -> j356910517;
	j4103031483 [label="Убийцы, которым надлежало убить убийц других убийц, если первый убийца провалится.",shape=box,color=blue];
		j4103031483 -> j356910517;
	j4120804303 [label="Зачем тебе это?",shape=box,color=blue];
		j4120804303 -> j882316056;
		j4120804303 -> j3280152808;
		j4120804303 -> j306545891;
	j356910517 [label="Бомбы заложены в нескольких зданиях, целых кораблях и целой луне, заминированной с помощью украденной взрывчатки. Солнечная железная дорога готова сойти с орбиты.",shape=box,color=blue];
		j356910517 -> j2341996459;
	j2341996459 [label="И всё это было подстроено так, чтобы выглядеть как «Катастрофа Владеющих Разумом», когда придёт время. Мы с Ниток объявим в Империи чрезвычайное положение, как только с Исполнителями и Императорами... разберёмся.",shape=box,color=blue];
		j2341996459 -> j1742364006;
	j1742364006 [label="Boolean RoatheTraitor2 is now true.",color=orange];
		j1742364006 -> j285070892;
	j285070892 [label="Check boolean RoatheExecutor1",color=orange];
		j285070892 -> j3174892281 [label=true,color=green];
		j285070892 -> j2043230999 [label=true,color=green];
		j285070892 -> j277378593 [label=true,color=green];
		j285070892 -> j3174892281 [label=false,color=brown];
		j285070892 -> j2043230999 [label=false,color=brown];
	j3174892281 [label="А что, если твой план не сработает?",shape=box,color=red];
		j3174892281 -> j3677959993;
	j2043230999 [label="И что собираешься делать дальше?",shape=box,color=red];
		j2043230999 -> j351990739;
	j277378593 [label="Что вы планировали делать с Нитоком?",shape=box,color=red];
		j277378593 -> j1932713100;
	j3677959993 [label="Это был один из многих тысяч возможных исходов, на которые у меня был план. ",shape=box,color=blue];
		j3677959993 -> j970325783;
	j351990739 [label="У того, что мы задумали, было тысяча возможных исходов. И для каждой задействованной переменной создавался свой возможный вариант развития событий. ",shape=box,color=blue];
		j351990739 -> j4042166381;
	j1932713100 [label="Check boolean RoatheKnowsReset2",color=orange];
		j1932713100 -> j37154547 [label=true,color=green];
		j1932713100 -> j832163378 [label=false,color=brown];
	j970325783 [label="Если бы мы потерпели сокрушительную неудачу, я бы просто съел кончик «Лекса» и на этом закончил бы.",shape=box,color=blue];
		j970325783 -> j3561517439;
	j4042166381 [label="И для каждого из них я уже наметил результат. И для каждого из них я знал, что собираюсь сделать. Многие были схожи в общих чертах, но различались в деталях.",shape=box,color=blue];
		j4042166381 -> j430402353;
	j37154547 [label="Что я говорил тебе об этом раньше? Потому что, признаюсь, я пока не доверяю тебе настолько, чтобы сказать прямо.",shape=box,color=blue];
		j37154547 -> j2521471947;
		j37154547 -> j3618104530;
	j832163378 [label="Это был сложный вопрос, потребовавший... больших переговоров между нами.",shape=box,color=blue];
		j832163378 -> j457478280;
		j832163378 -> j3657402320;
	j3561517439 [label="Нет смысла плакать из-за пролитой Кувы и всего такого.",shape=box,color=blue];
		j3561517439 -> j605619945;
		j3561517439 -> j2214364355;
	j430402353 [label="Если бы мы потерпели сокрушительную неудачу, я бы просто съел кончик «Лекса» и на этом закончил бы.",shape=box,color=blue];
		j430402353 -> j1971835798;
	j2521471947 [label="Ты рассказал мне все.",shape=box,color=red];
		j2521471947 -> j2690352694;
	j3618104530 [label="Тогда я не буду заставлять тебя рассказывать мне больше, чем ты хочешь.",shape=box,color=red];
		j3618104530 -> j72862414;
	j457478280 [label="В этом предложении заложено очень многое.",shape=box,color=red];
		j457478280 -> j1626836581;
	j3657402320 [label="Какие переговоры?",shape=box,color=red];
		j3657402320 -> j1935566769;
	j605619945 [label="Я бы, честно говоря, просто сбежал.",shape=box,color=red];
		j605619945 -> j3209015042;
	j2214364355 [label="Ты бы просто принял смерть?",shape=box,color=red];
		j2214364355 -> j1854159369;
	j1971835798 [label="Если бы успех был посредственным, что было наиболее вероятно, потребовалась бы очистка, чтобы гарантировать, что все свободные нити будут «разобраны». Конечно же, я был одной из этих нитей. И у меня были меры, чтобы гарантировать, что в краткосрочной перспективе я всё ещё буду достаточно ценным, чтобы меня не убрали вместе с остальными.",shape=box,color=blue];
		j1971835798 -> j2158463307;
	j2690352694 [label="Значит, нет смысла повторяться сейчас, верно? На самом деле, в этом разговоре почти нет смысла вовсе. Хорошего тебе дня.",shape=box,color=blue];
		j2690352694 -> "Chat ends.";
	j72862414 [label="+5 Chemistry",color=orange];
		j72862414 -> j1090940256;
	j1626836581 [label="+5 Chemistry",color=orange];
		j1626836581 -> j3133689937;
	j1935566769 [label="Всевозможные.",shape=box,color=blue];
		j1935566769 -> j1861383400;
	j3209015042 [label="А бежать‑то куда, мой Узурпатор? Не у всех из нас есть карманные измерения, куда можно скрыться когда мы в паники.",shape=box,color=blue];
		j3209015042 -> j924183789;
	j1854159369 [label="У меня ведь не было другого выбора, правда? Некуда было идти, негде было спрятаться.",shape=box,color=blue];
		j1854159369 -> j924183789;
	j2158463307 [label="Если бы ситуация оказалась оглушительным успехом, я бы перешёл ко второй фазе плана.",shape=box,color=blue];
		j2158463307 -> j1917807472;
		j2158463307 -> j3224692207;
	j1090940256 [label="Хорошо. Я скажу, что это был сложный вопрос, потребовавший... серьёзных переговоров между нами.",shape=box,color=blue];
		j1090940256 -> j457478280;
		j1090940256 -> j3657402320;
	j3133689937 [label="Centuries beneath the sands.",shape=box,color=blue];
		j3133689937 -> j1861383400;
	j1861383400 [label="Boolean RoatheExecutor2 is now true.",color=orange];
		j1861383400 -> j1717274806;
	j924183789 [label="Ниток ясно дала понять, что если мы потерпим неудачу, то я стану публичной жертвой.",shape=box,color=blue];
		j924183789 -> j4123315043;
		j924183789 -> j1062516127;
	j1917807472 [label="Что за вторая фаза?",shape=box,color=red];
		j1917807472 -> j880148447;
	j3224692207 [label="Убить Ниток?",shape=box,color=red];
		j3224692207 -> j596495675;
	j1717274806 [label="Evaluate expressions on HellStory counter",color=orange];
		j1717274806 -> j1813768946 [label="x >= 7",color=purple];
		j1717274806 -> j847299537 [label="x < 7",color=purple];
		j1717274806 -> j847299537 [label="false",color=purple];
	j4123315043 [label="И тебя это устроило?",shape=box,color=red];
		j4123315043 -> j3328486534;
	j1062516127 [label="Не слишком хорошая идея, угрожать тебе, если она рассчитывала на твою преданность.",shape=box,color=red];
		j1062516127 -> j1781181318;
	j880148447 [label="Убить Нитока, конечно же. Ничего удивительного. Она и сама знала, что это, скорее всего, произойдёт, и постоянно поддразнивала меня этим.",shape=box,color=blue];
		j880148447 -> j635650959;
		j880148447 -> j881621879;
	j596495675 [label="+5 Chemistry",color=orange];
		j596495675 -> j1275536292;
	j1813768946 [label="Понимаешь, я был одной из ее многочисленных игрушек.",shape=box,color=blue];
		j1813768946 -> j949070236;
	j847299537 [label="Я был одним из её многочисленных партнёров, понимаешь.",shape=box,color=blue];
		j847299537 -> j2757379205;
		j847299537 -> j1734449841;
	j3328486534 [label="+5 Chemistry",color=orange];
		j3328486534 -> j3666608331;
	j1781181318 [label="Одну вещь тебе нужно понимать об Орокин: мы всегда строили козни друг против друга. ",shape=box,color=blue];
		j1781181318 -> j1094682495;
	j635650959 [label="И ее это устраивало?",shape=box,color=red];
		j635650959 -> j1126221708;
	j881621879 [label="Вы оба просто поняли, что собираетесь убить друг друга?",shape=box,color=red];
		j881621879 -> j4222052734;
	j1275536292 [label="Check boolean RoatheKnowsReset2",color=orange];
		j1275536292 -> j1172638622 [label=true,color=green];
		j1275536292 -> j1430422711 [label=false,color=brown];
	j949070236 [label="Когда-то я считал нас партнёрами. В политике, в интригах, в постели...",shape=box,color=blue];
		j949070236 -> j306158751;
	j2757379205 [label="Деловые партнеры?",shape=box,color=red];
		j2757379205 -> j3508062426;
	j1734449841 [label="Партнеры, как?",shape=box,color=red];
		j1734449841 -> j2165072590;
	j3666608331 [label="Вряд ли. Но одну вещь тебе нужно понимать об Орокин: мы всегда строили козни друг против друга. ",shape=box,color=blue];
		j3666608331 -> j1094682495;
	j1094682495 [label="Я знал, что Ниток без колебаний убьёт меня в любой момент, если это хоть немного могло бы помочь ей в достижении её целей.",shape=box,color=blue];
		j1094682495 -> j780178907;
	j1126221708 [label="Думаю, ей нравился этот вызов, Узурпатор. Чувство опасности. Восторг от осознания, что она спит с тем, кто желает её смерти.",shape=box,color=blue];
		j1126221708 -> j313083211;
	j4222052734 [label="Мне хотелось бы притвориться, что мы были первыми Орокин, оказавшимися в такой ситуации, но это даже не было чем-то редким.",shape=box,color=blue];
		j4222052734 -> j313083211;
	j1172638622 [label="Точно! Как будто ты уже слышал это раньше. Но это неудивительно. Она довольно регулярно поддразнивала меня этим.",shape=box,color=blue];
		j1172638622 -> j635650959;
		j1172638622 -> j881621879;
	j1430422711 [label="Точно! Но это не такой уж неожиданный поворот. Она тоже это предвидела и регулярно поддразнивала меня этим.",shape=box,color=blue];
		j1430422711 -> j635650959;
		j1430422711 -> j881621879;
	j306158751 [label="Я, разумеется, не считал нас равными. Она была Исполнителем. Великая Ниток. Но я считал себя Первым среди её меньших.",shape=box,color=blue];
		j306158751 -> j2553478613;
	j3508062426 [label="Ты прелесть. Да, в каком-то смысле мы были деловыми партнёрами. Но мы были партнёрами и во многих других, более важных отношениях.",shape=box,color=blue];
		j3508062426 -> j2165072590;
	j2165072590 [label="На войне. В политике. В интригах. В постели.",shape=box,color=blue];
		j2165072590 -> j233229074;
	j780178907 [label="И всё же она знала, что я точу ножи у неё за спиной и с нетерпением жду момента, когда сниму её голову с плеч.",shape=box,color=blue];
		j780178907 -> j3352609601;
	j313083211 [label="Чем дольше я живу, тем больше понимаю, что, возможно, мы не были видом, созданным для бессмертия.",shape=box,color=blue];
		j313083211 -> j3386089286;
	j2553478613 [label="Какой же я был дурак...",shape=box,color=blue];
		j2553478613 -> j2147748787;
		j2553478613 -> j3301346665;
		j2553478613 -> j3724380814;
		j2553478613 -> j4068870670;
		j2553478613 -> j1092532274;
	j233229074 [label="Но мне интересно, не ошибаюсь ли я. Может быть, «партнёр» — слишком сильное слово для того, кем мы были на самом деле. ",shape=box,color=blue];
		j233229074 -> j2555936253;
	j3352609601 [label="Можно сказать, что у нас были... сложные отношения.",shape=box,color=blue];
		j3352609601 -> j1092532274;
		j3352609601 -> j4068870670;
		j3352609601 -> j3724380814;
		j3352609601 -> j2147748787;
		j3352609601 -> j3301346665;
	j3386089286 [label="Но да. Можно сказать, что у нас с Ниток были... сложные отношения.",shape=box,color=blue];
		j3386089286 -> j1092532274;
		j3386089286 -> j4068870670;
		j3386089286 -> j3724380814;
		j3386089286 -> j2147748787;
		j3386089286 -> j3301346665;
	j2147748787 [label="Она тебе была небезразлична?",shape=box,color=red];
		j2147748787 -> j2870809326;
	j3301346665 [label="Ты любил ее?",shape=box,color=red];
		j3301346665 -> j34871610;
	j3724380814 [label="Ты ей доверял?",shape=box,color=red];
		j3724380814 -> j1424407762;
	j4068870670 [label="Не жалей о том, что сделал. Ты сделал свой выбор. Пути назад нет. Только вперёд.",shape=box,color=red];
		j4068870670 -> j2124802392;
	j1092532274 [label="Единственное, что мы можем сделать, чтобы искупить содеянное, это смотреть вперёд ясными глазами.",shape=box,color=red];
		j1092532274 -> j970477588;
	j2555936253 [label="Она была Великой Ниток. Исполнителем.",shape=box,color=blue];
		j2555936253 -> j2553478613;
	j2870809326 [label="Бездна, нет! Если бы она однажды днём, напившись, вышла из шлюза, это решило бы большую часть моих проклятых проблем.",shape=box,color=blue];
		j2870809326 -> j763459069;
	j34871610 [label="+5 Chemistry",color=orange];
		j34871610 -> j1850153748;
	j1424407762 [label="Бездна, нет! Никогда не доверяй Орокин, Скиталец. Включая меня. Особенно меня! Люби нас, ненавидь нас, обожай нас, презирай нас — но никогда, никогда не доверяй нам.",shape=box,color=blue];
		j1424407762 -> j2389340545;
	j2124802392 [label="Add -1 to Thermostat counter",color=orange];
		j2124802392 -> j1940787768;
	j970477588 [label="Add 1 to Thermostat counter",color=orange];
		j970477588 -> j1640181466;
	j763459069 [label="Я абсолютно, совершенно её презирал и больше всего на свете обожал бы медленно, тщательно, аккуратно снимать её голубую кожу с тела голыми руками.",shape=box,color=blue];
		j763459069 -> j743107984;
		j763459069 -> j2464867680;
	j1850153748 [label="Какой дерзкий вопрос! Кажется, я тебя обожаю за этот вопрос. Знаешь, кажется, я её действительно любил, совсем чуть-чуть. Честно говоря, я даже не задумывался об этом до этого момента.",shape=box,color=blue];
		j1850153748 -> j3792938430;
	j2389340545 [label="Мы склонны к приступам беспокойства.",shape=box,color=blue];
		j2389340545 -> j4241935922;
		j2389340545 -> j2137942547;
	j1940787768 [label="+10 Chemistry",color=orange];
		j1940787768 -> j2968953575;
	j1640181466 [label="+10 Chemistry",color=orange];
		j1640181466 -> j4216347303;
	j743107984 [label="Это было... ярко.",shape=box,color=red];
		j743107984 -> j732664533;
	j2464867680 [label="И все же ты спал с ней?",shape=box,color=red];
		j2464867680 -> j4266490214;
	j3792938430 [label="Да, думаю, я был немного в неё влюблён. Какое любопытное осознание...",shape=box,color=blue];
		j3792938430 -> j994460048;
	j4241935922 [label="Принято.",shape=box,color=red];
		j4241935922 -> j3607220764;
	j2137942547 [label="Это не будет проблемой.",shape=box,color=red];
		j2137942547 -> j2627474597;
	j2968953575 [label="Возможно, это верно. Жить прошлым опасно, ведь мы нагружаем себя лишь сожалением и стыдом, и ничем больше. ",shape=box,color=blue];
		j2968953575 -> j65319094;
	j4216347303 [label="Возможно, это верно. Жить прошлым опасно, ведь мы нагружаем себя лишь сожалением и стыдом, и ничем больше. ",shape=box,color=blue];
		j4216347303 -> j3293862200;
	j732664533 [label="Только эта мысль позволяла мне вытерпеть многие из моих... обязательных вечеров в её постели. Прошу прощения.",shape=box,color=blue];
		j732664533 -> j775101609;
		j732664533 -> j2479902614;
	j4266490214 [label="То, что ты считаешь эти две вещи взаимоисключающими, просто очаровательно. Надеюсь, у тебя когда-нибудь будет возможность провести вечер с такой “знакомой”, это довольно волшебно.",shape=box,color=blue];
		j4266490214 -> j1033417297;
	j994460048 [label="Пойми, её также застилала глубочайшая, самая невыносимая ненависть. Я презирал её на одном дыхании, и ничто не доставляло бы мне большего удовольствия, чем медленно, осторожно, нежно снять голыми руками её синюю кожу.",shape=box,color=blue];
		j994460048 -> j1996459292;
		j994460048 -> j647196559;
	j3607220764 [label="Evaluate expressions",color=orange];
		j3607220764 -> j733221184 [label="RoatheDatingDeal",color=purple];
		j3607220764 -> j3996420542 [label="RoatheMarieDatingDeal",color=purple];
		j3607220764 -> j488140005 [label="RoatheLyonDatingDeal",color=purple];
		j3607220764 -> j3030233433 [label="DrifterRoathe",color=purple];
		j3607220764 -> j2439234746 [label="DrifterMarie",color=purple];
		j3607220764 -> j488140005 [label="DrifterLyon",color=purple];
		j3607220764 -> j1228929042 [label="false",color=purple];
	j2627474597 [label="Мм, да. У меня такое чувство, что я не совсем покоряю тебя своим «дьявольским обаянием», не так ли?",shape=box,color=blue];
		j2627474597 -> j950878211;
		j2627474597 -> j558941797;
	j65319094 [label="Какой смысл переживать наши прошлые поступки, наши прошлые неудачи и сожаления? Мы не можем их изменить, даже с этим даром путешествия во времени попытка “переделать” уже свершившееся ведёт лишь к безумию.",shape=box,color=blue];
		j65319094 -> j908349899;
	j3293862200 [label="Но мы также не можем забывать о злодеяниях наших прошлых “я”, ибо рискуем превратиться лишь в безумцев и деспотов, агрессивных существ, которые не видят своей вины, а видят только чужую.",shape=box,color=blue];
		j3293862200 -> j3816545987;
	j775101609 [label="У тебя такие мысли обо всех своих любовниках? Или только о ней?",shape=box,color=red];
		j775101609 -> j3841557421;
	j2479902614 [label="Не нужно извинений. Я просто до сих пор в шоке от того, как сильно ты ненавидел свой народ.",shape=box,color=red];
		j2479902614 -> j1127012328;
	j1033417297 [label="Я лишь рекомендую тебе не превращать такие отношения в постоянную связь. Это становится крайне нездоровым для обеих сторон. Обычно заканчивается убийством, одного или обоих.",shape=box,color=blue];
		j1033417297 -> j775101609;
		j1033417297 -> j793458116;
		j1033417297 -> j4135740871;
	j1996459292 [label="Как могут обе эти вещи быть истинными одновременно?",shape=box,color=red];
		j1996459292 -> j2444911331;
	j647196559 [label="Это было… наглядно.",shape=box,color=red];
		j647196559 -> j216072738;
	j733221184 [label="Я просто подумал, что должен дать тебе честное предупреждение, раз уж у нас есть наше маленькое… “соглашение”.",shape=box,color=blue];
		j733221184 -> j1518281785;
	j3996420542 [label="Мм, хотя с тобой такой проблемы никогда не будет, правда? Твой взгляд направлен гораздо ближе к дому, на Мари в нашем маленьком “соглашении.”",shape=box,color=blue];
		j3996420542 -> j1420472104;
	j488140005 [label="Мм, хотя с тобой такой проблемы никогда не будет, правда? Твой взгляд направлен куда более близко к дому, на того безумного жреца, не так ли?",shape=box,color=blue];
		j488140005 -> j4026677146;
	j3030233433 [label="I simply thought I should give you the fair warning, seeing as you have made your... interests known.",shape=box,color=blue];
		j3030233433 -> j1518281785;
	j2439234746 [label="Mm, although, it will never be a problem with you, will it? You have your eye set far closer to home with Marie, don't you?",shape=box,color=blue];
		j2439234746 -> j1420472104;
	j1228929042 [label="+5 Chemistry",color=orange];
		j1228929042 -> j2908434521;
	j950878211 [label="Нет. Извини. Ты не в моём вкусе.",shape=box,color=red];
		j950878211 -> j266116846;
	j558941797 [label="Ты - да. Я просто не доверяю тебе.",shape=box,color=red];
		j558941797 -> j4137689758;
	j908349899 [label="Нет. Я есть то, что я есть. Я тот, кто я есть. Я иду по выбранному пути и уже не желаю извиняться за себя. Я не изменю себя ради мнений других.",shape=box,color=blue];
		j908349899 -> j3338285197;
	j3816545987 [label="Эту черту я видел у многих из самых низших Исполнителей и Императоров – слепую веру лишь в свою собственную безупречность и безгрешность. Я презирал их за это и поклялся никогда не разделять подобного эгоистичного высокомерия.",shape=box,color=blue];
		j3816545987 -> j3338285197;
	j3841557421 [label="Я по-настоящему имел дело лишь с партнёрами в физическом смысле, Скиталец. Эмоциональных у меня никогда не было. Во всяком случае, взаимных.",shape=box,color=blue];
		j3841557421 -> j2297065797;
		j3841557421 -> j3169674001;
	j1127012328 [label="+5 Chemistry",color=orange];
		j1127012328 -> j4037255728;
	j793458116 [label="Я приму это к сведению.",shape=box,color=red];
		j793458116 -> j3592262197;
	j4135740871 [label="Я этого не планировал, но спасибо за совет.",shape=box,color=red];
		j4135740871 -> j2563390901;
	j2444911331 [label="То, что ты никогда не сталкивался с подобным, делает тебя невероятно счастливчиком, Узурпатор. Не советую тебе попадать в такую ситуацию: обычно это заканчивается убийством одного из вас или обоих.",shape=box,color=blue];
		j2444911331 -> j3499027914;
		j2444911331 -> j4135740871;
		j2444911331 -> j793458116;
	j216072738 [label="Воображение этого в моём уме было единственным, что позволяло мне выдерживать многие долгие встречи. Прошу прощения.",shape=box,color=blue];
		j216072738 -> j3499027914;
		j216072738 -> j2479902614;
		j216072738 -> j2792480548;
	j1518281785 [label="+5 Chemistry",color=orange];
		j1518281785 -> j2730783239;
	j1420472104 [label="Она действительно красива, не могу сказать, что виню тебя. Хотя, думаю, я бы не выдержал её лицемерной набожности.",shape=box,color=blue];
		j1420472104 -> j1981765870;
	j4026677146 [label="Он довольно красив. Но у него такой вид, будто если цветок завянет, он готов объявить всему конец и спрыгнуть с ближайшей башни.",shape=box,color=blue];
		j4026677146 -> j1981765870;
	j2908434521 [label="Мне интересно, кто из нас привлёк твоё внимание, если вообще привлек.",shape=box,color=blue];
		j2908434521 -> j2681580443;
	j266116846 [label="Твоя потеря, но у тебя же есть из чего выбирать, не так ли? Уверен, ты найдёшь кого-нибудь, с кем... можно развлечься.",shape=box,color=blue];
		j266116846 -> j2681580443;
	j4137689758 [label="Check boolean IsDating",color=orange];
		j4137689758 -> j1926877909 [label=true,color=green];
		j4137689758 -> j359352964 [label=false,color=brown];
	j3338285197 [label="Спасибо, что напомнил.",shape=box,color=blue];
		j3338285197 -> "Chat ends.";
	j2297065797 [label="Ты никогда не был влюблён?",shape=box,color=red];
		j2297065797 -> j4291206685;
	j3169674001 [label="Что ты имеешь в виду?",shape=box,color=red];
		j3169674001 -> j1853580681;
	j4037255728 [label="Я не ненавидел их всех. Только некоторых. Тех, кто был у власти. И именно поэтому это в конце концов было так обречено.",shape=box,color=blue];
		j4037255728 -> j448974430;
	j3592262197 [label="+5 Chemistry",color=orange];
		j3592262197 -> j903504968;
	j2563390901 [label="+5 Chemistry",color=orange];
		j2563390901 -> j3907492928;
	j3499027914 [label="У тебя такие мысли обо всех своих любовниках? Или только о ней?",shape=box,color=red];
		j3499027914 -> j3084851962;
	j2792480548 [label="Я никогда не думал о собраниях Совета Орокин, пока не подумал об этом прямо сейчас.",shape=box,color=red];
		j2792480548 -> j4174809302;
	j2730783239 [label="Как приятно знать, что здравый вкус и чувство стиля всё же не покинули эту систему.",shape=box,color=blue];
		j2730783239 -> j3726060196;
	j1981765870 [label="Но! Как хочешь. Дай знать, если смогу чем-то помочь. Мне очень интересно наблюдать, как ты и этот фанатик ввязываетесь во всевозможные ненужные эмоциональные интриги.",shape=box,color=blue];
		j1981765870 -> j4075937700;
		j1981765870 -> j732059870;
	j2681580443 [label="Check boolean IsDating",color=orange];
		j2681580443 -> j1174223252 [label=true,color=green];
		j2681580443 -> j2585320125 [label=false,color=brown];
	j1926877909 [label="Мм. Мудро. Хотя это и вызывает вопрос: уж не привлёк ли я твоё внимание, Скиталец? Если ты думаешь, что меня волнует то, что ты увлечён кем‑то другим, то это не так.",shape=box,color=blue];
		j1926877909 -> j350844587;
	j359352964 [label="Мм. Мудро. Хотя это и наводит на вопрос, я случайно не привлек твоего внимания, Скиталец?",shape=box,color=blue];
		j359352964 -> j2082281318;
		j359352964 -> j4146255973;
		j359352964 -> j4289169364;
		j359352964 -> j1847749489;
		j359352964 -> j3841212968;
	j4291206685 [label="+5 Chemistry",color=orange];
		j4291206685 -> j4065019128;
	j1853580681 [label="Мне объяснить тебе это по буквам? Очень хорошо. Я никогда не был влюблён.",shape=box,color=blue];
		j1853580681 -> j3598014679;
	j448974430 [label="Несмотря на все наши достижения, несмотря на всю работу, которую мы проделали, чтобы спасти человечество, мы так и не решили величайшую проблему, терзавшую наши сердца. Величайший недостаток, который разъедал наши души, как раковая опухоль.",shape=box,color=blue];
		j448974430 -> j1388720289;
	j903504968 [label="Смотри, чтобы так и было. Похоже, ты стараешься жить достойной жизнью, Скиталец. Быть “хорошим” человеком. Я бы не хотел видеть, как ты закончишь, как Орокин. Нас определяли наши излишества.",shape=box,color=blue];
		j903504968 -> j373028856;
	j3907492928 [label="Весьма признателен. Похоже, ты стараешься жить достойной жизнью, Скиталец. Быть “хорошим” человеком. Я бы не хотел видеть, как ты закончишь, как Орокин. Нас определяли наши излишества.",shape=box,color=blue];
		j3907492928 -> j373028856;
	j3084851962 [label="Я по-настоящему имел дело лишь с партнёрами в физическом смысле, Скиталец. Эмоциональных у меня никогда не было. Во всяком случае, взаимных.",shape=box,color=blue];
		j3084851962 -> j2297065797;
		j3084851962 -> j674442560;
	j4174809302 [label="Жалко, правда? Несмотря на все достижения Вселенной, мы до сих пор не можем понять, как организовать себя, не тратя часы жизни, собираясь за столом и переговариваясь.",shape=box,color=blue];
		j4174809302 -> j448974430;
	j3726060196 [label="А теперь, когда мы знаем, на кого ты направил свой лук, это даёт нам к чему стремиться, не так ли?",shape=box,color=blue];
		j3726060196 -> j571454998;
		j3726060196 -> j159097401;
	j4075937700 [label="Я не думаю, что я бы доверил это тебе.",shape=box,color=red];
		j4075937700 -> j564214420;
	j732059870 [label="Серьёзно? Ты бы... помог?",shape=box,color=red];
		j732059870 -> j283425561;
	j1174223252 [label="Похоже, у тебя все-таки есть склонность к «протофреймам».",shape=box,color=blue];
		j1174223252 -> j2294218848;
		j1174223252 -> j3427607553;
	j2585320125 [label="Или у тебя нет склонности к “протофреймам”?",shape=box,color=blue];
		j2585320125 -> j171893194;
		j2585320125 -> j1404682153;
	j350844587 [label="И прежде чем ты начнёшь печатать яростный ответ и гневно осуждать меня за то, что я якобы поощряю твою неверность, дай мне минуту, чтобы объяснить.",shape=box,color=blue];
		j350844587 -> j1227234397;
	j2082281318 [label="Это Лион.",shape=box,color=red];
		j2082281318 -> j1578402145;
	j4146255973 [label="Это Мари.",shape=box,color=red];
		j4146255973 -> j690351591;
	j4289169364 [label="[Признаться в чувствах.] ...Да..",shape=box,color=red];
		j4289169364 -> j1557604774;
	j1847749489 [label="Нет.",shape=box,color=red];
		j1847749489 -> j2179852534;
	j3841212968 [label="Это не твое дело.",shape=box,color=red];
		j3841212968 -> j1475693835;
	j4065019128 [label="Разве это не грустно? Знаю. Нет, я никогда не был. Никогда взаимно.",shape=box,color=blue];
		j4065019128 -> j3598014679;
	j3598014679 [label="Бывало ли, что чувства были односторонними? О, разумеется. Но ведь это не роман, правда? Это трагедия.",shape=box,color=blue];
		j3598014679 -> j3128750885;
	j1388720289 [label="Бюрократия.",shape=box,color=blue];
		j1388720289 -> j841808373;
	j373028856 [label="Такое существование легко превращается в одиночество, которое поглощает тебя целиком. Например, у меня были лишь мимолётные связи, исключительно физические, Скиталец. Эмоциональных отношений у меня никогда не было. Во всяком случае, ни одна из них не была взаимной.",shape=box,color=blue];
		j373028856 -> j3499027914;
	j674442560 [label="Ты о чём?",shape=box,color=red];
		j674442560 -> j1853580681;
	j571454998 [label="Кажется, ты не удивлен.",shape=box,color=red];
		j571454998 -> j669043279;
	j159097401 [label="Я не был уверен, как ты отреагируешь.",shape=box,color=red];
		j159097401 -> j669043279;
	j564214420 [label="Наверное, мудро. Обыденно, но мудро.",shape=box,color=blue];
		j564214420 -> j995315302;
	j283425561 [label="Разумеется! В лучшем случае ты отвлечёшь одного из них от их, казалось бы, неистребимой цели - преследовать меня.",shape=box,color=blue];
		j283425561 -> j578438325;
	j2294218848 [label="Но я уже с кем-то встречаюсь. Разве это не проблема для тебя? Или для Мари и Лиона?",shape=box,color=red];
		j2294218848 -> j3829593454;
	j3427607553 [label="Я уже в отношениях.",shape=box,color=red];
		j3427607553 -> j138377828;
	j171893194 [label="I do. Just none of you are \"it.\"",shape=box,color=red];
		j171893194 -> j3776344711;
	j1404682153 [label="Да. Моё сердце уже принадлежит кому-то, но такие вещи требуют времени.",shape=box,color=red];
		j1404682153 -> j676775172;
	j1227234397 [label="Когда живёшь так долго, как мы, начинаешь понимать, что некоторые сердца способны испытывать привязанность сразу к нескольким.",shape=box,color=blue];
		j1227234397 -> j2983548996;
	j1578402145 [label="Boolean DrifterLyon is now true.",color=orange];
		j1578402145 -> j912106491;
	j690351591 [label="Boolean DrifterMarie is now true.",color=orange];
		j690351591 -> j1131348317;
	j1557604774 [label="Boolean DrifterRoathe is now true.",color=orange];
		j1557604774 -> j3451836564;
	j2179852534 [label="How you wound me.",shape=box,color=blue];
		j2179852534 -> j1274574569;
	j1475693835 [label="Boolean DrifterUnknown is now true.",color=orange];
		j1475693835 -> j939301724;
	j3128750885 [label="Считаешь меня теперь дьяволом? Моя репутация в этом далёком будущем только улучшилась, мой Узурпатор.",shape=box,color=blue];
		j3128750885 -> j1394294945;
	j841808373 [label="Ничто в мире так не тормозит величие человека, как слепое следование системам и бумажной волоките любой ценой.",shape=box,color=blue];
		j841808373 -> j1069544156;
	j669043279 [label="Думаешь, ты первый, кто когда‑либо хотел “станцевать с дьяволом Тау”? Вряд ли. Просто ещё предстоит выяснить, насколько искренен твой интерес, или он исчезнет после пары ночей, когда ты лишь удовлетворишь своё желание.",shape=box,color=blue];
		j669043279 -> j159601995;
	j995315302 [label="Полагаю, мне придётся просто сидеть и смотреть, как всё разваливается само собой. Или же, если ты добьёшься успеха, кто-то из них слишком отвлечётся от своей, казалось бы, неразрешимой проблемы - преследовать меня.",shape=box,color=blue];
		j995315302 -> j264585201;
	j578438325 [label="В худшем, всё закончится ужасно, и у меня будет несколько часов бесплатного развлечения. ",shape=box,color=blue];
		j578438325 -> j264585201;
	j3829593454 [label="Ты можешь удивиться. Мы, Орокин, славились многочисленными партнёрами, да, но это было связано исключительно с физической близостью.",shape=box,color=blue];
		j3829593454 -> j1626306074;
	j138377828 [label="Ты их любишь? И это взаимно?",shape=box,color=blue];
		j138377828 -> j2259297609;
		j138377828 -> j3966979386;
		j138377828 -> j1228495541;
		j138377828 -> j2055536421;
	j3776344711 [label="Как же ты ранишь меня.",shape=box,color=blue];
		j3776344711 -> j589544672;
	j676775172 [label="О? И кто из нас тебе приглянулся? Или это кто‑то другой, из какого‑то другого “когда”?",shape=box,color=blue];
		j676775172 -> j1735325573;
		j676775172 -> j2082281318;
		j676775172 -> j4146255973;
		j676775172 -> j1784468193;
	j2983548996 [label="It is just simply another way of being, for those who experience life in such a fashion.",shape=box,color=blue];
		j2983548996 -> j4041164;
	j912106491 [label="Что? Почему?! Ты действительно себя так не уважаешь? Или у тебя есть склонность коллекционировать всякую грустную, жалкую ерунду?",shape=box,color=blue];
		j912106491 -> j595954354;
	j1131348317 [label="Почему я не удивлен? С этой штукой… всё время болтающейся у тебя перед глазами, это неудивительно. Чудо, что кто‑то здесь вообще что‑то успевает сделать.",shape=box,color=blue];
		j1131348317 -> j2305096643;
	j3451836564 [label="+5 Chemistry",color=orange];
		j3451836564 -> j4072597262;
	j1274574569 [label="The pain.",shape=box,color=blue];
		j1274574569 -> j2405102427;
	j939301724 [label="Ладно. Но это не «нет» и не «да», поэтому я оставлю этот пункт не отмеченным и не зачёркнутым, а обведённым.",shape=box,color=blue];
		j939301724 -> j1660715477;
	j1394294945 [label="Осмысли это, и возможно, поймёшь, почему мало кто желал задерживаться рядом со мной.",shape=box,color=blue];
		j1394294945 -> j779926630;
	j1069544156 [label="Ба. Но мы слишком отошли от темы. Обсудим это в другой раз. Мне пора идти.",shape=box,color=blue];
		j1069544156 -> j4081414586;
	j159601995 [label="Это мост, который мы будем переходить, когда дойдём до него.",shape=box,color=blue];
		j159601995 -> j3746752883;
	j264585201 [label="+5 Chemistry",color=orange];
		j264585201 -> j3475948667;
	j1626306074 [label="Когда живёшь так долго, как мы, начинаешь понимать, что некоторые сердца способны испытывать привязанность сразу к нескольким.",shape=box,color=blue];
		j1626306074 -> j1484530705;
	j2259297609 [label="Нет.",shape=box,color=red];
		j2259297609 -> j338640657;
	j3966979386 [label="Не знаю. Может быть.",shape=box,color=red];
		j3966979386 -> j2719832070;
	j1228495541 [label="Да. И я надеюсь, что так оно и есть.",shape=box,color=red];
		j1228495541 -> j3756262233;
	j2055536421 [label="Это не твое дело.",shape=box,color=red];
		j2055536421 -> j1258343140;
	j589544672 [label="Боль.",shape=box,color=blue];
		j589544672 -> j214279893;
	j1735325573 [label="Это кто-то, кого ты не знаешь.",shape=box,color=red];
		j1735325573 -> j1944695634;
	j1784468193 [label="Это не твое дело.",shape=box,color=red];
		j1784468193 -> j2069406555;
	j4041164 [label="Я всего лишь говорю, что если бы твоё сердце смогло испытывать чувства сразу к нескольким людям, я бы не стал осуждать тебя за это, вот и всё.",shape=box,color=blue];
		j4041164 -> j3427124397;
	j595954354 [label="Он, пожалуй, довольно красив. Но у него такой вид, будто если цветок завянет, он готов объявить всему конец и спрыгнуть с ближайшей башни.",shape=box,color=blue];
		j595954354 -> j1717840052;
	j2305096643 [label="Что ж, желаю тебе удачи. Я не выносил её самоправедность и нескончаемую набожность. С другой стороны, она видит во мне лишь отступника.",shape=box,color=blue];
		j2305096643 -> j3823599253;
	j4072597262 [label="Mm, isn't this just utterly delicious...?",shape=box,color=blue];
