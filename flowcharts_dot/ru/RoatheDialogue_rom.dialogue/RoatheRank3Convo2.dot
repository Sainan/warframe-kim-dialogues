	1683 [label="Как же ты ранишь меня.",shape=box,color=blue];
		1683 -> 1698;
	1684 [label="О? И кто из нас тебе приглянулся? Или это кто‑то другой, из какого‑то другого “когда”?",shape=box,color=blue];
		1684 -> 1699;
		1684 -> 1700;
