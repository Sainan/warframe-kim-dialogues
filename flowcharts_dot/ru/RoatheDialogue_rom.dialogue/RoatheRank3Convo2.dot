		1500 -> 1502 [label=false,color=brown];
	1501 [label="А что, если твой план не сработает?",shape=box,color=red];
		1501 -> 1504;
	1502 [label="И что собираешься делать дальше?",shape=box,color=red];
		1502 -> 1505;
	1503 [label="Что вы планировали делать с Нитоком?",shape=box,color=red];
		1503 -> 1506;
	1504 [label="Это был один из многих тысяч возможных исходов, на которые у меня был план. ",shape=box,color=blue];
		1504 -> 1507;
	1505 [label="У того, что мы задумали, было тысяча возможных исходов. И для каждой задействованной переменной создавался свой возможный вариант развития событий. ",shape=box,color=blue];
		1505 -> 1508;
	1506 [label="Check boolean RoatheKnowsReset2",color=orange];
		1506 -> 1510 [label=true,color=green];
		1506 -> 1509 [label=false,color=brown];
	1507 [label="Если бы мы потерпели сокрушительную неудачу, я бы просто съел кончик «Лекса» и на этом закончил бы.",shape=box,color=blue];
		1507 -> 1511;
	1508 [label="И для каждого из них я уже наметил результат. И для каждого из них я знал, что собираюсь сделать. Многие были схожи в общих чертах, но различались в деталях.",shape=box,color=blue];
		1508 -> 1512;
	1510 [label="Что я говорил тебе об этом раньше? Потому что, признаюсь, я пока не доверяю тебе настолько, чтобы сказать прямо.",shape=box,color=blue];
		1510 -> 1515;
		1510 -> 1516;
	1509 [label="Это был сложный вопрос, потребовавший... больших переговоров между нами.",shape=box,color=blue];
		1509 -> 1513;
		1509 -> 1514;
	1511 [label="Нет смысла плакать из-за пролитой Кувы и всего такого.",shape=box,color=blue];
		1511 -> 1517;
		1511 -> 1518;
	1512 [label="Если бы мы потерпели сокрушительную неудачу, я бы просто съел кончик «Лекса» и на этом закончил бы.",shape=box,color=blue];
		1512 -> 1519;
	1515 [label="Ты рассказал мне все.",shape=box,color=red];
		1515 -> 1522;
	1516 [label="Тогда я не буду заставлять тебя рассказывать мне больше, чем ты хочешь.",shape=box,color=red];
		1516 -> 1523;
	1513 [label="В этом предложении заложено очень многое.",shape=box,color=red];
		1513 -> 1520;
	1514 [label="Какие переговоры?",shape=box,color=red];
		1514 -> 1521;
	1517 [label="Я бы, честно говоря, просто сбежал.",shape=box,color=red];
		1517 -> 1524;
	1518 [label="Ты бы просто принял смерть?",shape=box,color=red];
		1518 -> 1525;
	1519 [label="Если бы успех был посредственным, что было наиболее вероятно, потребовалась бы очистка, чтобы гарантировать, что все свободные нити будут «разобраны». Конечно же, я был одной из этих нитей. И у меня были меры, чтобы гарантировать, что в краткосрочной перспективе я всё ещё буду достаточно ценным, чтобы меня не убрали вместе с остальными.",shape=box,color=blue];
		1519 -> 1526;
	1522 [label="Значит, нет смысла повторяться сейчас, верно? На самом деле, в этом разговоре почти нет смысла вовсе. Хорошего тебе дня.",shape=box,color=blue];
		1522 -> 1529;
	1523 [label="+5 Chemistry",color=orange];
		1523 -> 1530;
	1520 [label="+5 Chemistry",color=orange];
		1520 -> 1527;
	1521 [label="Всевозможные.",shape=box,color=blue];
		1521 -> 1528;
	1524 [label="А бежать‑то куда, мой Узурпатор? Не у всех из нас есть карманные измерения, куда можно скрыться когда мы в паники.",shape=box,color=blue];
		1524 -> 1531;
	1525 [label="У меня ведь не было другого выбора, правда? Некуда было идти, негде было спрятаться.",shape=box,color=blue];
		1525 -> 1531;
	1526 [label="Если бы ситуация оказалась оглушительным успехом, я бы перешёл ко второй фазе плана.",shape=box,color=blue];
		1526 -> 1532;
		1526 -> 1533;
	1529 [label="Chat ends.",color=orange];
	1530 [label="Хорошо. Я скажу, что это был сложный вопрос, потребовавший... серьёзных переговоров между нами.",shape=box,color=blue];
		1530 -> 1513;
		1530 -> 1514;
	1527 [label="Centuries beneath the sands.",shape=box,color=blue];
		1527 -> 1528;
	1528 [label="Update boolean RoatheExecutor2",color=orange];
		1528 -> 1534;
	1531 [label="Ниток ясно дала понять, что если мы потерпим неудачу, то я стану публичной жертвой.",shape=box,color=blue];
		1531 -> 1535;
		1531 -> 1536;
	1532 [label="Что за вторая фаза?",shape=box,color=red];
