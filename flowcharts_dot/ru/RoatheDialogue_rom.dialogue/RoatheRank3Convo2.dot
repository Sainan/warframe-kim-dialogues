		j3427124397 -> j1316439026;
	j1717840052 [label="Но! Как хочешь. Дай знать, если смогу чем-то помочь. Мне очень интересно наблюдать, как ты и этот фанатик ввязываетесь во всевозможные ненужные эмоциональные интриги.",shape=box,color=blue];
		j1717840052 -> j4075937700;
