		1632 -> 1645;
	1634 [label="Как приятно знать, что здравый вкус и чувство стиля всё же не покинули эту систему.",shape=box,color=blue];
		1634 -> 1648;
	1633 [label="Но! Как хочешь. Дай знать, если смогу чем-то помочь. Мне очень интересно наблюдать, как ты и этот фанатик ввязываетесь во всевозможные ненужные эмоциональные интриги.",shape=box,color=blue];
