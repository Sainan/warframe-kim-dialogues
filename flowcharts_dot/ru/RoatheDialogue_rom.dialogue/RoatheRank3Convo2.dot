		1679 -> 1695;
	1682 [label="Думаешь, ты первый, кто когда‑либо хотел “станцевать с дьяволом Тау”? Вряд ли. Просто ещё предстоит выяснить, насколько искренен твой интерес, или он исчезнет после пары ночей, когда ты лишь удовлетворишь своё желание.",shape=box,color=blue];
		1682 -> 1697;
	1680 [label="Полагаю, мне придётся просто сидеть и смотреть, как всё разваливается само собой. Или же, если ты добьёшься успеха, кто-то из них слишком отвлечётся от своей, казалось бы, неразрешимой проблемы - преследовать меня.",shape=box,color=blue];
		1680 -> 1696;
	1681 [label="В худшем, всё закончится ужасно, и у меня будет несколько часов бесплатного развлечения. ",shape=box,color=blue];
		1681 -> 1696;
	1685 [label="Ты можешь удивиться. Мы, Орокин, славились многочисленными партнёрами, да, но это было связано исключительно с физической близостью.",shape=box,color=blue];
		1685 -> 1704;
