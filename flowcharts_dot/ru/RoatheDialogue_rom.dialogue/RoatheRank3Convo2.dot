		1467 -> 1468 [label=true,color=green];
		1467 -> 1469 [label=false,color=brown];
	1466 [label="Chat ends.",color=orange];
	1468 [label="Зачем ты меня об этом спрашиваешь? Что ты пытаешься узнать, Скиталец? Ты же точно не о местонахождении боеприпасов спрашиваешь.",shape=box,color=blue];
		1468 -> 1470;
	1469 [label="Зачем спрашиваешь? Планируешь вернуться в прошлое и побить рекорд себя в молодости? Нужен совет, как свергнуть тоталитарное правительство? Ищешь местонахождение зарытых боеприпасов, способных взорвать целые планеты?",shape=box,color=blue];
		1469 -> 1471;
	1470 [label="С чего бы мне тебе доверять? Почему я тебе доверял?!",shape=box,color=blue];
		1470 -> 1472;
	1471 [label="Или это всего лишь праздная болтовня с твоей стороны?",shape=box,color=blue];
		1471 -> 1473;
		1471 -> 1474;
		1471 -> 1475;
	1472 [label="Check boolean RoatheResetForgiven",color=orange];
		1472 -> 1477 [label=true,color=green];
		1472 -> 1476 [label=false,color=brown];
	1473 [label="Мне действительно любопытно, жалеешь ли ты хоть о чём‑то. Вернулся бы ты назад и изменил бы что‑нибудь из того, что задумал.",shape=box,color=red];
		1473 -> 1478;
	1474 [label="Меня завораживает мысль о том, каково это, пытаться разработать такой план. Должно быть, это был бы шедевр.",shape=box,color=red];
		1474 -> 1479;
	1475 [label="Честно говоря, было бы полезно узнать, не спрятал ли ты где‑нибудь какое‑нибудь из тех видов оружия, которые до сих пор можно найти.",shape=box,color=red];
		1475 -> 1480;
	1477 [label="Я простил тебя за то, что ты сделал. Хотел бы я только вспомнить, почему... почему! Почему именно ты, из всех людей?!",shape=box,color=blue];
		1477 -> 1483;
		1477 -> 1481;
	1476 [label="Почему! Почему именно ты, из всех людей?!",shape=box,color=blue];
		1476 -> 1481;
		1476 -> 1482;
	1478 [label="Add 1 to Thermostat",color=orange];
		1478 -> 1484;
	1479 [label="Add -1 to Thermostat",color=orange];
		1479 -> 1485;
	1480 [label="+5 Chemistry",color=orange];
		1480 -> 1486;
	1483 [label="Я знаю. И мне всё ещё очень жаль.",shape=box,color=red];
		1483 -> 1489;
	1481 [label="Я пытаюсь помочь тебе прийти к пониманию причины.",shape=box,color=red];
		1481 -> 1487;
	1482 [label="Мне всё ещё жаль, что я разрушил твоё доверие, Роут. Поверь или нет, я вовсе не хотел этого.",shape=box,color=red];
		1482 -> 1488;
	1484 [label="Я сожалею только о том, что это так и не осуществилось. Жалею о потраченном времени.",shape=box,color=blue];
		1484 -> 1490;
	1485 [label="И это был шедевр, Узурпатор.",shape=box,color=blue];
		1485 -> 1490;
	1486 [label="Практично. Но многие места, где я «спрятал» свои запасы, вероятно,… исчезли за многие-многие годы.",shape=box,color=blue];
		1486 -> 1491;
	1489 [label="Да, да. Полагаю, нам стоит продолжить этот глупый разговор, где мы вновь и вновь перетираем то, о чём уже говорили.",shape=box,color=blue];
		1489 -> 1493;
	1487 [label="+5 Chemistry",color=orange];
		1487 -> 1492;
	1488 [label="Да, ты, вероятно, считал, что твоим поступкам не будет последствий. Но как бы там ни было, давай продолжим этот нелепый разговор, где мы снова и снова перелистываем свои прошлые версии, и просто двинемся дальше.",shape=box,color=blue];
		1488 -> 1493;
	1490 [label="+5 Chemistry",color=orange];
		1490 -> 1494;
	1491 [label="И многие из этих точек были тайной даже для меня самого. План был невероятно замысловат. Слои на слоях, на слоях.",shape=box,color=blue];
		1491 -> 1495;
	1493 [label="О чём ты спрашивал? Ах да. Как я собирался свергнуть Исполнителей? ",shape=box,color=blue];
		1493 -> 1496;
	1492 [label="Повторяя одни и те же бессмысленные разговоры о том, почему я хотел убить людей, которые уже давно мертвы и обращены в прах? По крайней мере, это прагматичный подход.",shape=box,color=blue];
		1492 -> 1493;
	1494 [label="План был невероятно замысловат. Слои на слоях, на слоях, на слоях. Убийцы, которым было поручено убить убийц других убийц, если первый убийца провалится.",shape=box,color=blue];
		1494 -> 1497;
	1495 [label="Убийцы, которым надлежало убить убийц других убийц, если первый убийца провалится.",shape=box,color=blue];
		1495 -> 1497;
	1496 [label="Зачем тебе это?",shape=box,color=blue];
		1496 -> 1473;
		1496 -> 1474;
		1496 -> 1475;
	1497 [label="Бомбы заложены в нескольких зданиях, целых кораблях и целой луне, заминированной с помощью украденной взрывчатки. Солнечная железная дорога готова сойти с орбиты.",shape=box,color=blue];
		1497 -> 1498;
	1498 [label="И всё это было подстроено так, чтобы выглядеть как «Катастрофа Владеющих Разумом», когда придёт время. Мы с Ниток объявим в Империи чрезвычайное положение, как только с Исполнителями и Императорами... разберёмся.",shape=box,color=blue];
		1498 -> 1499;
	1499 [label="Update boolean RoatheTraitor2",color=orange];
		1499 -> 1500;
