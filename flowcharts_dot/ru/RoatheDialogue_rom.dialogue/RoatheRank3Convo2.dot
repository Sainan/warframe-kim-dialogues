		1535 -> 1541;
	1536 [label="Не слишком хорошая идея, угрожать тебе, если она рассчитывала на твою преданность.",shape=box,color=red];
		1536 -> 1542;
	1537 [label="Убить Нитока, конечно же. Ничего удивительного. Она и сама знала, что это, скорее всего, произойдёт, и постоянно поддразнивала меня этим.",shape=box,color=blue];
		1537 -> 1543;
		1537 -> 1544;
	1538 [label="+5 Chemistry",color=orange];
		1538 -> 1545;
	1540 [label="Понимаешь, я был одной из ее многочисленных игрушек.",shape=box,color=blue];
		1540 -> 1548;
	1539 [label="Я был одним из её многочисленных партнёров, понимаешь.",shape=box,color=blue];
		1539 -> 1546;
		1539 -> 1547;
	1541 [label="+5 Chemistry",color=orange];
		1541 -> 1549;
	1542 [label="Одну вещь тебе нужно понимать об Орокин: мы всегда строили козни друг против друга. ",shape=box,color=blue];
		1542 -> 1550;
	1543 [label="И ее это устраивало?",shape=box,color=red];
		1543 -> 1551;
	1544 [label="Вы оба просто поняли, что собираетесь убить друг друга?",shape=box,color=red];
