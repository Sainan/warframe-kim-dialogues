		1687 -> 1709;
	1688 [label="Что? Почему?! Ты действительно себя так не уважаешь? Или у тебя есть склонность коллекционировать всякую грустную, жалкую ерунду?",shape=box,color=blue];
		1688 -> 1710;
	1689 [label="Почему я не удивлен? С этой штукой… всё время болтающейся у тебя перед глазами, это неудивительно. Чудо, что кто‑то здесь вообще что‑то успевает сделать.",shape=box,color=blue];
