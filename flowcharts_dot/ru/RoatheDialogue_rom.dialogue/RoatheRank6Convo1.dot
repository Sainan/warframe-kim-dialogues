		j842129377 -> "Chat ends." [label="false",color=purple];
	j3724432843 [label="Не так давно ты говорил о своей любви ко мне. Нужно спросить... это всё ещё правда? Я хочу дать тебе возможность изменить своё мнение.",shape=box,color=blue];
		j3724432843 -> j1012366947;
	j1384575995 [label="Не так давно ты говорил о своей любви ко мне. Нужно спросить... это всё ещё правда? Я хочу дать тебе возможность изменить своё мнение.",shape=box,color=blue];
		j1384575995 -> j181983634;
	j3628146122 [label="[Признаться в любви.] Мне нужно кое-что сказать, прежде чем ты зайдешь слишком далеко.",shape=box,color=red];
		j3628146122 -> j2126808341;
	j2818116341 [label="Всегда пожалуйста, Роут. Вот почему я рядом с тобой.",shape=box,color=red];
		j2818116341 -> j1994856873;
	j2633803501 [label="[Признаться в любви.] Мне нужно кое-что сказать, прежде чем ты зайдешь слишком далеко.",shape=box,color=red];
		j2633803501 -> j2774710204;
	j825900173 [label="Но если твои угрозы мне по душе?",shape=box,color=red];
		j825900173 -> j3225628886;
	j1557972708 [label="Всегда пожалуйста, Роут. Для этого и нужны друзья.",shape=box,color=red];
		j1557972708 -> j2622652445;
	j2388689943 [label="Спасибо за что?",shape=box,color=red];
		j2388689943 -> j1807569119;
	j4123557652 [label="Благодарность за что?",shape=box,color=red];
		j4123557652 -> j2026489344;
	j4240578722 [label="Но если твои угрозы мне по душе?",shape=box,color=red];
		j4240578722 -> j900463548;
	j2530200983 [label="Всё же я был бы виновен в упущении, если бы не отметил, что до того как мы продвинемся слишком далеко в вопросе дворецкого, я не сказал прямо, что мне действительно есть в чём признаться.",shape=box,color=blue];
		j2530200983 -> j3127248563;
	j121581477 [label="Всё же я был бы виновен в упущении, если бы не отметил, что до того как мы продвинемся слишком далеко в вопросе дворецкого, я не сказал прямо, что мне действительно есть в чём признаться.",shape=box,color=blue];
		j121581477 -> j3131229549;
	j2582369719 [label="Всё же я был бы виновен в упущении, если бы не поблагодарил тебя и за возвращение моих воспоминаний, и за помощь в том, чтобы примириться с ними, сокровище.",shape=box,color=blue];
		j2582369719 -> j423653827;
		j2582369719 -> j719693026;
	j598655468 [label="Хотя если ты ожидаешь благодарности и за помощь в возвращении моих воспоминаний и их примирении, считай, что я буквально переполнен похвалами в твой адрес за эту поддержку, сокровище.",shape=box,color=blue];
		j598655468 -> j2553172773;
		j598655468 -> j423653827;
	j715303754 [label="Всё же я был бы виновен в упущении, если бы не поблагодарил тебя и за возвращение моих воспоминаний, и за помощь в том, чтобы примириться с ними.",shape=box,color=blue];
		j715303754 -> j642354201;
		j715303754 -> j2165695393;
	j3291163340 [label="Хотя если ты ожидаешь благодарности и за помощь в возвращении моих воспоминаний и их примирении, считай, что я буквально переполнен похвалами в твой адрес за эту поддержку.",shape=box,color=blue];
		j3291163340 -> j1362599137;
		j3291163340 -> j989852120;
	j1012366947 [label="Особенно прежде чем я пойду и выставлю себя полным посмешищем. Хотя, признаться, худшие мои стороны тебе уже доводилось наблюдать совсем недавно.",shape=box,color=blue];
		j1012366947 -> j3137545109;
		j1012366947 -> j982766899;
	j181983634 [label="Особенно с учётом того, что именно твоё убеждение меня принять своё прошлое и не обращать внимания на всё, что говорят обо мне другие.",shape=box,color=blue];
		j181983634 -> j3137545109;
		j181983634 -> j4260781745;
	j2126808341 [label="Неожиданно именно я ощущаю давящее предчувствие. Ты умеешь застать врасплох и поменять роли, дорогуша. Что случилось?",shape=box,color=blue];
		j2126808341 -> j2438716422;
		j2126808341 -> j217018000;
	j1994856873 [label="Рядом со мной. Да. Компаньоны. Такая мысль для меня непривычна.",shape=box,color=blue];
		j1994856873 -> j3050527175;
	j2774710204 [label="Неожиданно именно я ощущаю давящее предчувствие. Осторожно, дорогуша. Ты заходишь слишком далеко в опасной игре. Что такое?",shape=box,color=blue];
		j2774710204 -> j2579852168;
		j2774710204 -> j894434103;
	j3225628886 [label="И мне доставляет удовольствие всё это устраивать! Именно поэтому мы так хорошо ладим. И если вкратце, именно это я здесь и хотел сказать.",shape=box,color=blue];
		j3225628886 -> j2125096957;
	j2622652445 [label="Друзья. Да. Наверное, так нас теперь и стоит назвать, не так ли? Какая странная мысль.",shape=box,color=blue];
		j2622652445 -> j209407683;
	j1807569119 [label="Разумеется, в помощи с возвращением моих воспоминаний и в том, чтобы примириться с ними. А в чём же ещё? Не похоже на то, что проявлялось твоё усердье в складывание моего белья.",shape=box,color=blue];
		j1807569119 -> j2478547317;
	j2026489344 [label="Неужели мне правда нужно произносить это вслух? Хорошо. Но не рассчитывай на щедрые похвалы. Окружающие и так осыпают тебя похвалами. Тебе ни к чему получать ещё и от меня.",shape=box,color=blue];
		j2026489344 -> j3479605009;
	j900463548 [label="И мне доставляет удовольствие всё это устраивать! Именно поэтому мы так хорошо ладим. И если вкратце, именно это я здесь и хотел сказать.",shape=box,color=blue];
		j900463548 -> j3479605009;
	j3127248563 [label="Не так давно ты говорил о своей любви ко мне. Нужно спросить... это всё ещё правда? Я хочу дать тебе возможность изменить своё мнение.",shape=box,color=blue];
		j3127248563 -> j1814937272;
