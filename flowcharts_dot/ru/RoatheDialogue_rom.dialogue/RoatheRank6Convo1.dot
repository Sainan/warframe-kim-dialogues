		j2553172773 -> j3544509713;
	j642354201 [label="Что дальше будет с Лойдом?",shape=box,color=red];
		j642354201 -> j1043503875;
	j2165695393 [label="Всегда пожалуйста, Роут. Для этого и нужны друзья.",shape=box,color=red];
		j2165695393 -> j2533927468;
	j1362599137 [label="Что дальше будет с Лойдом?",shape=box,color=red];
		j1362599137 -> j1285520530;
	j989852120 [label="Всегда пожалуйста, Роут. Для этого и нужны друзья.",shape=box,color=red];
		j989852120 -> j471603816;
	j3137545109 [label="Я... прошу прощения. Ты прав. Мне это не нужно. ",shape=box,color=red];
		j3137545109 -> j1826828257;
	j982766899 [label="Я люблю всё, чем ты являешься. Люблю то, кем ты можешь стать. Люблю то, кем ты выбираешь быть. То, кем ты был. Всё, на что ты способен. Я люблю тебя, Роут.",shape=box,color=red];
		j982766899 -> j398715603;
	j4260781745 [label="Я люблю тебя не вопреки тому, кто ты есть, Роут. Я люблю тебя именно за то, кто ты есть. Целиком. За всё хорошее и за всё зло, на которое ты способен.",shape=box,color=red];
		j4260781745 -> j1207979692;
	j2438716422 [label="Не важно. Вылетело из головы.",shape=box,color=red];
		j2438716422 -> j3727593976;
	j217018000 [label="Ты можешь мне не верить, но я... я люблю тебя.",shape=box,color=red];
		j217018000 -> j274928988;
	j3050527175 [label="Этот Дьявол не привык к тому, чтобы у него были «компаньоны».",shape=box,color=blue];
		j3050527175 -> j1206096373;
	j2579852168 [label="Не важно. Вылетело из головы.",shape=box,color=red];
		j2579852168 -> j1641048467;
	j894434103 [label="Ты можешь мне не верить, но я... я люблю тебя.",shape=box,color=red];
		j894434103 -> j3067084796;
	j2125096957 [label="Полагаю, можно считать, что благодарностей за твою помощь в восстановлении моих воспоминаний и в примирении с ними более чем достаточно, а теперь давай двигаться дальше.",shape=box,color=blue];
		j2125096957 -> j2245285884;
	j209407683 [label="Этот Дьявол к подобному не привык.",shape=box,color=blue];
		j209407683 -> j98121027;
		j209407683 -> j2091706614;
	j2478547317 [label="Не ищи похвалы без нужды, Скиталец. Это тебе не к лицу.",shape=box,color=blue];
		j2478547317 -> j3183685411;
	j3479605009 [label="Полагаю, можно считать, что благодарностей за твою помощь в восстановлении моих воспоминаний и в примирении с ними более чем достаточно, а теперь давай двигаться дальше.",shape=box,color=blue];
		j3479605009 -> j1730863800;
		j3479605009 -> j1451566835;
	j1814937272 [label="Особенно прежде чем я пойду и выставлю себя полным посмешищем. Хотя, признаться, худшие мои стороны тебе уже доводилось наблюдать совсем недавно.",shape=box,color=blue];
		j1814937272 -> j4188635540;
		j1814937272 -> j1635479654;
	j1978626024 [label="Особенно с учётом того, что именно твоё убеждение меня принять своё прошлое и не обращать внимания на всё, что говорят обо мне другие.",shape=box,color=blue];
		j1978626024 -> j4188635540;
		j1978626024 -> j2771042807;
	j1455344667 [label="Да, вероятно, твоя правда, не стоит тянуть с любезностями. К следующему. Работы у нас ещё много.",shape=box,color=blue];
		j1455344667 -> j2505586159;
	j2840310479 [label="Неожиданно именно я ощущаю давящее предчувствие. Ты умеешь застать врасплох и поменять роли, дорогуша. Что случилось?",shape=box,color=blue];
		j2840310479 -> j950333867;
	j3544509713 [label="Неожиданно именно я ощущаю давящее предчувствие. Ты умеешь застать врасплох и поменять роли, дорогуша. Что случилось?",shape=box,color=blue];
		j3544509713 -> j4134900867;
	j1043503875 [label="Да, вероятно, твоя правда, не стоит тянуть с любезностями. К следующему. Работы у нас ещё много.",shape=box,color=blue];
		j1043503875 -> j1329014237;
	j2533927468 [label="Друзья. Да. Наверное, так нас теперь и стоит назвать, не так ли? Какая странная мысль. Я признаю, подобное для меня непривычно.",shape=box,color=blue];
		j2533927468 -> j260476940;
	j1285520530 [label="Твоя правда, не стоит задерживаться на любезностях. К следующему. Работы у нас ещё много.",shape=box,color=blue];
		j1285520530 -> j1329014237;
	j471603816 [label="Назваться другом Дьявола значит быть опасным созданием. Но всё же я с радостью назвался бы твоим другом.",shape=box,color=blue];
		j471603816 -> j260476940;
	j1826828257 [label="Я не стану притворяться, будто это не ранит меня особенно глубоко. Похоже, падение с большей высоты и правда причиняет больше боли.",shape=box,color=blue];
		j1826828257 -> j1917042989;
	j398715603 [label="Я не знаю, что сказать. На этот раз я действительно без слов.",shape=box,color=blue];
		j398715603 -> j3552693258;
	j1207979692 [label="Я в изумлении... потрясён. И у меня нет слов.",shape=box,color=blue];
		j1207979692 -> j3552693258;
	j3727593976 [label="Иногда ты, клянусь, бываешь хуже, чем Птичка Три.",shape=box,color=blue];
		j3727593976 -> "Chat ends.";
	j274928988 [label="Я люблю всё, чем ты являешься. Люблю то, кем ты можешь стать. Люблю то, кем ты выбираешь быть. То, кем ты был. Всё, на что ты способен. Я люблю тебя, Роут.",shape=box,color=red];
		j274928988 -> j513766349;
	j1206096373 [label="Но что я сделаю с тем, кто я есть? И с тем, на какие перемены я способен? Это новая дорога, по которой предстоит идти. И за это мне есть кого благодарить, тебя.",shape=box,color=blue];
		j1206096373 -> "Chat ends.";
	j1641048467 [label="Иногда ты хуже, чем Птичка Три, клянусь.",shape=box,color=blue];
		j1641048467 -> "Chat ends.";
	j3067084796 [label="Ты, должно быть, шутишь. Дорогуша, ты под чем-то? Я был убеждён тобой принять моё прошлое и не обращать внимания на всё, что говорят обо мне другие, а теперь ты заявляешь, что любишь меня?",shape=box,color=blue];
		j3067084796 -> j1641484232;
	j2245285884 [label="Только представь, что мы могли бы сделать вместе, ты и я...",shape=box,color=blue];
		j2245285884 -> j2210073289;
	j98121027 [label="Что у тебя дальше?",shape=box,color=red];
		j98121027 -> j2096412;
	j2091706614 [label="Как ты считаешь, ты и дальше будешь называть себя так?",shape=box,color=red];
		j2091706614 -> j822135488;
