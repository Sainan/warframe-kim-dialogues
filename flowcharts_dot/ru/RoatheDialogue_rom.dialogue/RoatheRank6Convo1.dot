		j2844911425 -> "Chat ends." [label="false",color=purple];
	j2170359068 [label="Ха! Что ж, признаю, это ужасно зловещее заявление. Но беспокоиться о грядущем дне следует тощему дворецкому, а не тебе.",shape=box,color=blue];
		j2170359068 -> j308363092;
	j2333024384 [label="Ха! Что ж, признаю, это ужасно зловещее заявление. Но беспокоиться о грядущем дне следует тощему дворецкому, а не тебе.",shape=box,color=blue];
		j2333024384 -> j842129377;
	j1488449545 [label="Ха! Что ж, признаю, это ужасно зловещее заявление. Но нет, опасного предзнаменования здесь, увы, нет. Зато мне есть в чём признаться.",shape=box,color=blue];
		j1488449545 -> j3724432843;
	j4017948064 [label="Ха! Что ж, признаю, это ужасно зловещее заявление. Нет, к сожалению, сегодня мы обходимся без каких либо угроз. Однако мне есть в чём признаться.",shape=box,color=blue];
		j4017948064 -> j1384575995;
	j1735259618 [label="Ха! Что ж, признаю, это ужасно зловещее заявление. Но нет, опасного предзнаменования здесь, увы, нет. Простое признание в том, что я непозволительно запоздал с благодарностью за всю твою помощь, дорогуша.",shape=box,color=blue];
		j1735259618 -> j3628146122;
		j1735259618 -> j2818116341;
	j3279577358 [label="Ха! Что ж, признаю, это ужасно зловещее заявление. Нет, к сожалению, сегодня мы обходимся без каких либо угроз. Это не более чем признание моей признательности за всю оказанную тобой помощь, дорогуша.",shape=box,color=blue];
		j3279577358 -> j2633803501;
		j3279577358 -> j825900173;
	j3469487722 [label="Ха! Что ж, признаю, это ужасно зловещее заявление. Но нет, опасного предзнаменования здесь, увы, нет. Простое признание в том, что я непозволительно запоздал с благодарностью.",shape=box,color=blue];
