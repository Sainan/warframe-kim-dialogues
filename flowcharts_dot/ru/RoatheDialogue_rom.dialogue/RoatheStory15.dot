	"Chat ends." [color=orange];
	j1810223569 [label="VM: LIES",shape=box,color=blue];
		j1810223569 -> j4068881361;
	j4068881361 [label="Стенограмма: Я без труда владел многими видами нашего оружия, но особенно преуспел в использовании одного: лжи.",shape=box,color=blue];
		j4068881361 -> j2338092387;
	j2338092387 [label="I brandished it most often against my own troops. I whipped them to the bone with lies of duty and discipline.",shape=box,color=blue];
		j2338092387 -> j3528689543;
	j3528689543 [label="I smothered them with the lie that the war could be won. I pierced them with the lie of my favour, my most esteemed regard for them.",shape=box,color=blue];
		j3528689543 -> j3444374972;
	j3444374972 [label="Наедине с собой, вдали от всех, я обратил это оружие против себя. О, как же я истекал кровью.",shape=box,color=blue];
		j3444374972 -> j1648694156;
	j1648694156 [label="Add 1 to HellStory counter",color=orange];
		j1648694156 -> "Chat ends. Next chat will be RoatheStory16.";
	"Chat ends. Next chat will be RoatheStory16." [color=orange];
