		j2640902163 -> j2191065863;
	j2191065863 [label="Стенограмма: Я без труда владел многими видами нашего оружия, но особенно преуспел в использовании одного: лжи.",shape=box,color=blue];
		j2191065863 -> j4271967766;
	j4271967766 [label="Чаще всего я использовал его против собственных войск. Я избивал их до полусмерти ложью о долге и дисциплине.",shape=box,color=blue];
		j4271967766 -> j3067835165;
	j3067835165 [label="Я душил их ложью о том, что эту войну можно выиграть. Я пронзал их ложью о своём благоволении, о моём якобы высочайшем к ним уважении.",shape=box,color=blue];
		j3067835165 -> j3444374972;
	j3444374972 [label="Наедине с собой, вдали от всех, я обратил это оружие против себя. О, как же я истекал кровью.",shape=box,color=blue];
