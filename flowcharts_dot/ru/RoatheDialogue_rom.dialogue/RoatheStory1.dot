	"Chat ends." [color=orange];
	j3251601836 [label="ГС: НИТОК",shape=box,color=blue];
		j3251601836 -> j947236548;
	j947236548 [label="Транскрипт: Её безумие было соблазнительным, потому что оно было явным.",shape=box,color=blue];
		j947236548 -> j3362959081;
	j3362959081 [label="Рядом с ней всегда знаешь, где стоишь - прямо на краю великой пропасти.",shape=box,color=blue];
		j3362959081 -> j1027024763;
	j1027024763 [label="«Давай, прыгай», — словно говорили мне её глаза, сияющие радостью какой-то грандиозной космической шутки.",shape=box,color=blue];
		j1027024763 -> j2207276388;
	j2207276388 [label="Через её безумные видения я мог вырваться из долгого, мрачного застоя существования Орокин.",shape=box,color=blue];
		j2207276388 -> j312983323;
	j312983323 [label="Все наши чувства притупились столетия назад. И всё же она была по-своему свежа.",shape=box,color=blue];
		j312983323 -> j2017130335;
	j2017130335 [label="Вечная. Безграничная в своём голоде. Однажды вечером она призвала меня к своей купели. Я шагал по смешавшимся лужам ароматной воды и крови и встал по стойке смирно, как и полагалось.",shape=box,color=blue];
		j2017130335 -> j500048418;
	j500048418 [label="«Мне скучно, Роут. Давай перебьём всех остальных Орокин и захватим власть».",shape=box,color=blue];
		j500048418 -> j921430358;
	j921430358 [label="Add 1 to HellStory counter",color=orange];
		j921430358 -> "Chat ends.";
}