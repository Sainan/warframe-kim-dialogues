	"Chat ends." [color=orange];
	j2608097333 [label="VM: NITOKH",shape=box,color=blue];
		j2608097333 -> j1604334031;
	j1604334031 [label="Транскрипт: Её безумие было соблазнительным, потому что оно было явным.",shape=box,color=blue];
		j1604334031 -> j3756802309;
	j3756802309 [label="One always knew where one stood with her - right on the precipice of the great abyss.",shape=box,color=blue];
		j3756802309 -> j3230278603;
	j3230278603 [label="Leap in, her eyes said to me, gleaming with the joy of some colossal cosmic joke.",shape=box,color=blue];
		j3230278603 -> j2540451133;
	j2540451133 [label="Through her demented visions I could escape the long, bleak stagnation of Orokin existence.",shape=box,color=blue];
		j2540451133 -> j297463976;
	j297463976 [label="Все наши чувства притупились столетия назад. И всё же она была по-своему свежа.",shape=box,color=blue];
		j297463976 -> j2877515326;
	j2877515326 [label="Eternal. Limitless in her hunger. She summoned me to her bath one evening. I strode across the mingling puddles of perfumed water and blood and stood dutifully to attention.",shape=box,color=blue];
		j2877515326 -> j2498489100;
	j2498489100 [label="“I’m bored, Roathe. Let’s kill all the other Orokin and take over.”",shape=box,color=blue];
		j2498489100 -> j921430358;
	j921430358 [label="Add 1 to HellStory counter",color=orange];
		j921430358 -> "Chat ends.";
}