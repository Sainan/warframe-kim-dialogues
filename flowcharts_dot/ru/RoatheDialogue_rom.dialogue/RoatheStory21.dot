	"Chat ends." [color=orange];
	j3743540271 [label="VM: OBLIVION",shape=box,color=blue];
		j3743540271 -> j1766149420;
	j1766149420 [label="Стенограмма: Трус.",shape=box,color=blue];
		j1766149420 -> j1765360149;
	j1765360149 [label="That is what they called me, isn’t it? I’ve read the history books scattered about this dusty hall. A lie. They did not know the truth. That I was ripped away from my time before I could complete my work.",shape=box,color=blue];
		j1765360149 -> j3194430160;
	j3194430160 [label="Coward.",shape=box,color=blue];
		j3194430160 -> j365401078;
	j365401078 [label="I remember now. He approached me, in the Golden Halls. He wore a face I did not know. But that is not so very unusual for our kind. I knew his voice. I knew the way he moved.",shape=box,color=blue];
		j365401078 -> j2071347767;
	j2071347767 [label="Coward!",shape=box,color=blue];
		j2071347767 -> j3086105712;
	j3086105712 [label="He asked me a single question. Did I truly believe that I could ever be forgiven for burning it all to ash?",shape=box,color=blue];
		j3086105712 -> j4217737121;
	j4217737121 [label="COWARD!",shape=box,color=blue];
		j4217737121 -> j1267013829;
	j1267013829 [label="В его бледной протянутой руке был… шприц. Сверкающий свободой… c новым шансом… c новой жизнью.",shape=box,color=blue];
		j1267013829 -> j4196107402;
	j4196107402 [label="Я забрал его.",shape=box,color=blue];
		j4196107402 -> j2066040554;
	j2066040554 [label="COWARD!",shape=box,color=blue];
		j2066040554 -> j921430358;
	j921430358 [label="Add 1 to HellStory counter",color=orange];
		j921430358 -> "Chat ends.";
}