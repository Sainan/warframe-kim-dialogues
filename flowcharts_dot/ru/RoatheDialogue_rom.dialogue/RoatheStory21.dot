	"Chat ends." [color=orange];
	j1059110949 [label="ГС: ЗАБВЕНИЕ",shape=box,color=blue];
		j1059110949 -> j2473570315;
	j2473570315 [label="Стенограмма: Трус.",shape=box,color=blue];
		j2473570315 -> j706905910;
	j706905910 [label="Так они меня называли, не так ли? Я читал книги по истории, разбросанные по этому пыльному залу. Ложь. Они не знали правды. Что меня вырвали из моего времени, прежде чем я смог завершить свою работу.",shape=box,color=blue];
		j706905910 -> j2663798796;
	j2663798796 [label="Трус.",shape=box,color=blue];
		j2663798796 -> j3881316031;
	j3881316031 [label="Я помню теперь. Он подошел ко мне в Золотых Залах. На нем было лицо, которого я не знал. Но для нашего рода это не такая уж редкость. Я узнал его голос. Узнал его движение.",shape=box,color=blue];
		j3881316031 -> j821037317;
	j821037317 [label="Трус!",shape=box,color=blue];
		j821037317 -> j2362849922;
	j2362849922 [label="Он задал мне один вопрос. Верю ли я на самом деле, что могу когда-либо получить прощение за то, что обратил все в пепел?",shape=box,color=blue];
		j2362849922 -> j2448394399;
	j2448394399 [label="ТРУС!",shape=box,color=blue];
		j2448394399 -> j1991827118;
	j1991827118 [label="В его бледной протянутой руке был… шприц. Сверкающий свободой… c новым шансом… c новой жизнью.",shape=box,color=blue];
		j1991827118 -> j95690896;
	j95690896 [label="Я забрал его.",shape=box,color=blue];
		j95690896 -> j2753014004;
	j2753014004 [label="ТРУС!",shape=box,color=blue];
		j2753014004 -> j921430358;
	j921430358 [label="Add 1 to HellStory counter",color=orange];
		j921430358 -> "Chat ends.";
}