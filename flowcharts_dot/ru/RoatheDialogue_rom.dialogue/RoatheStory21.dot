	"Chat ends." [color=orange];
	j3505482033 [label="VM: OBLIVION",shape=box,color=blue];
		j3505482033 -> j3802298520;
	j3802298520 [label="Стенограмма: Трус.",shape=box,color=blue];
		j3802298520 -> j1839152577;
	j1839152577 [label="That is what they called me, isn’t it? I’ve read the history books scattered about this dusty hall. A lie. They did not know the truth. That I was ripped away from my time before I could complete my work.",shape=box,color=blue];
		j1839152577 -> j3981061164;
	j3981061164 [label="Coward.",shape=box,color=blue];
		j3981061164 -> j421154533;
	j421154533 [label="I remember now. He approached me, in the Golden Halls. He wore a face I did not know. But that is not so very unusual for our kind. I knew his voice. I knew the way he moved.",shape=box,color=blue];
		j421154533 -> j3710593231;
	j3710593231 [label="Coward!",shape=box,color=blue];
		j3710593231 -> j241811256;
	j241811256 [label="He asked me a single question. Did I truly believe that I could ever be forgiven for burning it all to ash?",shape=box,color=blue];
		j241811256 -> j5003414;
	j5003414 [label="COWARD!",shape=box,color=blue];
		j5003414 -> j458148612;
	j458148612 [label="В его бледной протянутой руке был… шприц. Сверкающий свободой… c новым шансом… c новой жизнью.",shape=box,color=blue];
		j458148612 -> j2905153774;
	j2905153774 [label="I took it.",shape=box,color=blue];
		j2905153774 -> j2066040554;
	j2066040554 [label="COWARD!",shape=box,color=blue];
		j2066040554 -> j921430358;
	j921430358 [label="Add 1 to HellStory counter",color=orange];
		j921430358 -> "Chat ends.";
}