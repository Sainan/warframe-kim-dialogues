		j1172864870 -> j1549404221 [label="LyonRell3",color=purple];
		j1172864870 -> j3429976673 [label="LyonConfession2",color=purple];
		j1172864870 -> j3090953234 [label="false",color=purple];
	j2813753334 [label="Evaluate expressions",color=orange];
		j2813753334 -> j334468032 [label="RoatheVillain",color=purple];
		j2813753334 -> j824666546 [label="RoatheRedeemed",color=purple];
		j2813753334 -> j984772883 [label="false",color=purple];
	j2519899032 [label="И что же я думаю о Мари? Если не считать попыток уговорить разрешить ей провести с нами ночь другую, Скиталец, сокровище? (Шучу. Всего лишь шучу.)",shape=box,color=blue];
		j2519899032 -> j1971035261;
	j3572512814 [label="И что же я думаю о Мари? Если не считать попыток уговорить позволить мне присоединиться на ночь или две? (Я шучу. Я шучу.)",shape=box,color=blue];
		j3572512814 -> j1087693353;
	j662608774 [label="И каким же образом тебе удалось убедить её изменить мнение о чистоте Альбрехта? Ну и «чудотворец» же ты. Пожалуй, стоило бы поклоняться не Сол и Луа, а тебе.",shape=box,color=blue];
		j662608774 -> j2948594209;
	j3417046596 [label="Я никогда не знал, что она до сих пор живет с ежедневной болью. Она скрывает это так, словно боли вовсе нет. Об этом не было сказано ни слова, пока она не рассказала тебе. С твоей помощью между нами преодолена некая пропасть.",shape=box,color=blue];
		j3417046596 -> j2665142002;
	j2251926088 [label="До недавнего времени я не знал о её воспитании. Она никогда не рассказывала мне свою историю, пока не рассказала её тебе. Тебе в какой-то мере удалось преодолеть пропасть между нами.",shape=box,color=blue];
		j2251926088 -> j17867736;
	j606405632 [label="Всё как обычно. Каждый миг бодрствования уходит на попытки не содрать собственное лицо когтями из отчаянного желания заглушить её.",shape=box,color=blue];
		j606405632 -> "Chat ends.";
	j3258006826 [label="Теперь мне лучше, когда у меня есть кто-то, на ком я могу выместить своё разочарование. Но, если говорить серьёзно, напряженность в наших отношениях значительно спала.",shape=box,color=blue];
		j3258006826 -> j2907659273;
	j4168878709 [label="В конце концов, это не у меня тут «налаживаются отношения» с Лионом, так ведь? Ха! Извини за этот кошмарный каламбур. Ничего не могу с собой поделать, уж слишком легко было поддаться.",shape=box,color=blue];
		j4168878709 -> j3685926439;
	j3559339173 [label="Лучше, чем выходит у тебя с ним. Как вообще удалось всё так испортить с ним? Ему всего-то и нужно было, чтобы его просто выслушали. ",shape=box,color=blue];
		j3559339173 -> j3109156170;
	j1549404221 [label="Отношения между нами стали гораздо спокойнее, особенно с тех пор как стало возможным открыто говорить о том, что причиняло ему боль.",shape=box,color=blue];
		j1549404221 -> j1440039522;
	j3429976673 [label="Отношения между нами стали гораздо спокойнее, особенно с тех пор как стало возможным открыто говорить о том, что причиняло ему боль.",shape=box,color=blue];
		j3429976673 -> j3952668938;
	j3090953234 [label="Всё как обычно. Каждый миг бодрствования уходит на попытки не содрать собственное лицо когтями из отчаянного желания заглушить его.",shape=box,color=blue];
		j3090953234 -> "Chat ends.";
	j334468032 [label="Постепенно воспринимать это становится чуть легче. Вероятно, потому что со временем интерес и настойчивость сходят на нет.",shape=box,color=blue];
		j334468032 -> j3733983239;
	j824666546 [label="Признаю, постепенно становится чуть терпимее. Думаю, мои недавние откровения имеют к этому некоторое отношение.",shape=box,color=blue];
		j824666546 -> j1542485056;
	j984772883 [label="Я всё чаще ловлю себя на мысли, что хотя сейчас, будучи протофреймом, я больше не могу использовать Тёмный Рефракторий для восстановления воспоминаний...",shape=box,color=blue];
		j984772883 -> j4136761075;
	j1971035261 [label="Любопытно, замечает ли она, что-то, что раньше было настоящим раздражением, теперь стало беззлобной шуткой?",shape=box,color=blue];
		j1971035261 -> j416064562;
	j1087693353 [label="Признаюсь, я ни в малейшей степени тебя не виню. И дело не только в её красоте. Зрение пока не подводит. В ней оказалось гораздо больше сострадания, чем можно было предположить, учитывая прожитые годы.",shape=box,color=blue];
		j1087693353 -> j1971035261;
	j2948594209 [label="Пфф. Подобный язык когда-то и породил Империю Орокин. Эта ошибка никогда не должна повторяться в этой системе.",shape=box,color=blue];
		j2948594209 -> j1971035261;
	j2665142002 [label="Признаю, что я вхожу в число тех самых глупцов, о которых она упоминает, тех, кто не в состоянии представить себе подобную жизнь изо дня в день.",shape=box,color=blue];
		j2665142002 -> j1639954056;
	j17867736 [label="Подумать только, её семья выбросила её на улицу. Её. Мари. Ту самую Мари. Ту, в которой было больше сострадания, чем можно себе представить?!",shape=box,color=blue];
		j17867736 -> j4125388156;
	j2907659273 [label="Стало известно о моём… секрете. О том, что принятие сыворотки было добровольным.",shape=box,color=blue];
		j2907659273 -> j3960728044;
		j2907659273 -> j99124058;
	j3685926439 [label="Я отдаю должное за то, что нашлось мужество иметь дело с этим несчастным безумцем. Ему необходимо общество. И сострадание.",shape=box,color=blue];
		j3685926439 -> j3013382779;
	j3109156170 [label="И всё же ты отгородился от него. Стыдно.",shape=box,color=blue];
		j3109156170 -> "Chat ends.";
	j1440039522 [label="Он говорил со мной о ребенке Тэнно, которого раньше слышал. И о том, что теперь больше не слышит его.",shape=box,color=blue];
		j1440039522 -> j812243329;
	j3952668938 [label="О случившемся с ним мне было известно удивительно немного. И только после разговора с тобой он оказался готов открыть это и мне. ",shape=box,color=blue];
		j3952668938 -> j526681152;
	j3733983239 [label="Я поддразниваю. Однако постепенно появляется неожиданная симпатия, даже при твердом решении оградить себя от оценки и осуждения жизненного выбора.",shape=box,color=blue];
		j3733983239 -> j3096846806;
		j3733983239 -> j2135783274;
	j1542485056 [label="Предполагалось, что раскаяние будет встречено издёвками, криками «ну вот, теперь стало ясно» или «мы предупреждали». Но ничего подобного не произошло. Эта тема едва была затронута.",shape=box,color=blue];
		j1542485056 -> j4122011033;
	j4136761075 [label="…если только это еще не мешает мне раствориться в этом с головой.",shape=box,color=blue];
		j4136761075 -> "Chat ends.";
	j416064562 [label="Хочется верить. Поддразнивать её оказывается удивительно забавно. Смотреть, как вспыхивает гнев и звучит родная речь, теперь одно из самых любимых занятий.",shape=box,color=blue];
		j416064562 -> j2711982580;
	j1639954056 [label="Как возможно удерживать подобное спокойствие? Не говоря уже о сострадании? Пожалуй, в таких обстоятельствах разум не выдержал бы и у меня, как не выдержал у того священника.",shape=box,color=blue];
		j1639954056 -> j1971035261;
	j4125388156 [label="Невозможно передать, насколько велик соблазн использовать Гельминта для путешествия назад во времени и расправы со всей её семьей. Не спеша. Хотя она, скорее всего, возразила бы. ",shape=box,color=blue];
		j4125388156 -> j4043909372;
	j3960728044 [label="Об этом не было сказано.",shape=box,color=red];
		j3960728044 -> j1006804376;
	j99124058 [label="Как об этом стало известно?",shape=box,color=red];
		j99124058 -> j638047257;
	j3013382779 [label="Но если говорить всерьёз, напряжение между нами заметно ослабло.",shape=box,color=blue];
		j3013382779 -> j2907659273;
	j812243329 [label="И всё же, полагаю, этот голос будет преследовать его в бодрствующих кошмарах. Бедняге всегда придётся сомневаться, где проходит грань между реальностью и вымыслом.",shape=box,color=blue];
		j812243329 -> j3925933062;
	j526681152 [label="Я не в силах описать желание воспользоваться Гельминтом, чтобы вернуться во времени и убить его родителей. Медленно. Но есть опасение, что он был бы против.",shape=box,color=blue];
		j526681152 -> j436016544;
	j3096846806 [label="Как ни крути, вам троим всё равно приходится быть вместе. Энтрати так распорядился. Поэтому остается лишь сделать из этого наилучшее.",shape=box,color=red];
		j3096846806 -> j3520538005;
	j2135783274 [label="Хорошо, что это так. Судя по всему, отношение не является безразличным.",shape=box,color=red];
		j2135783274 -> j1360211970;
	j4122011033 [label="Хорошо, что до этого не дошло. Мне совсем не нужно, чтобы меня вели за нос, словно щенка, испортившего ковер. В голове и так хватает поводов для раздумий.",shape=box,color=blue];
		j4122011033 -> j3096846806;
		j4122011033 -> j2135783274;
	j2711982580 [label="Ещё один фактор, повлиявший на улучшение отношений? Стало известно о секрете. Истина в том, что принятие сыворотки было осознанным выбором.",shape=box,color=blue];
		j2711982580 -> j2385254183;
		j2711982580 -> j509005653;
	j4043909372 [label="Месть, вероятно, не одобряется Солом и так далее, и тому подобное. ",shape=box,color=blue];
		j4043909372 -> j1971035261;
	j1006804376 [label="Подобного утверждения не звучало, сокровище Скиталец. Об этом было сообщено.",shape=box,color=blue];
		j1006804376 -> j1806500125;
	j638047257 [label="Эта информация была передана, сокровище Скиталец.",shape=box,color=blue];
		j638047257 -> j1806500125;
	j3925933062 [label="Ещё одна причина, по которой между нами стало лучше?",shape=box,color=blue];
		j3925933062 -> j2907659273;
	j436016544 [label="Месть, вероятно, не одобряется Луа и так далее, и тому подобное. ",shape=box,color=blue];
		j436016544 -> j477982471;
	j3520538005 [label="Совершенно верно. Делать врагов из тех, с кем приходится жить, занятие бессмысленное. Именно поэтому тогда, в Голе, и продолжалось воровство этих пирожных.",shape=box,color=blue];
		j3520538005 -> j1322884537;
	j1360211970 [label="Да, вопреки всем попыткам. И это трудно осмыслить. Но, как ни странно, мы все равно оказались здесь.",shape=box,color=blue];
		j1360211970 -> j638764191;
	j2385254183 [label="Как об этом стало известно?",shape=box,color=red];
		j2385254183 -> j3070618315;
	j509005653 [label="Об этом не было сказано.",shape=box,color=red];
		j509005653 -> j718962072;
	j1806500125 [label="Evaluate expressions",color=orange];
		j1806500125 -> j1165695237 [label="RoatheRedeemed",color=purple];
		j1806500125 -> j4239243173 [label="RoatheVillain",color=purple];
		j1806500125 -> j443409084 [label="false",color=purple];
	j477982471 [label="Но существует и ещё одна причина улучшения отношений между нами?",shape=box,color=blue];
		j477982471 -> j2907659273;
	j1322884537 [label="Хм. Может быть, получится повторить этот рецепт и тут. В любом случае будет предпринята попытка поддерживать спокойствие. Ну. По большей части.",shape=box,color=blue];
		j1322884537 -> j379883453;
	j638764191 [label="+10 Chemistry",color=orange];
		j638764191 -> j1917038551;
	j3070618315 [label="Эта информация была передана, сокровище Скиталец.",shape=box,color=blue];
		j3070618315 -> j4131114853;
	j718962072 [label="Подобного утверждения не звучало, сокровище Скиталец. Об этом было сообщено.",shape=box,color=blue];
		j718962072 -> j4131114853;
	j1165695237 [label="Это ещё один повод для искупления. Правда рано или поздно вышла бы наружу в любом случае. Лучше, чтобы её услышали из моих собственных уст.",shape=box,color=blue];
		j1165695237 -> j639396759;
		j1165695237 -> j298509505;
	j4239243173 [label="Мне нечего стыдиться. Скрывать это казалось бессмысленным. Истина так или иначе стала бы известна довольно скоро. Лучше, чтобы её услышали из моих собственных уст.",shape=box,color=blue];
		j4239243173 -> j639396759;
		j4239243173 -> j298509505;
	j443409084 [label="Правда рано или поздно вышла бы наружу в любом случае. Лучше, чтобы её услышали из моих собственных уст.",shape=box,color=blue];
		j443409084 -> j639396759;
		j443409084 -> j298509505;
	j379883453 [label="+10 Chemistry",color=orange];
		j379883453 -> j1569621990;
	j1917038551 [label="Я сделаю всё возможное, чтобы не испортить тебе всё, хм? Ну. Во всяком случае не без возможности все починить. Нельзя же делать дни слишком скучными, а то недолго и свихнуться, как тот священник.",shape=box,color=blue];
		j1917038551 -> "Chat ends.";
	j4131114853 [label="Evaluate expressions",color=orange];
		j4131114853 -> j458479546 [label="RoatheRedeemed",color=purple];
		j4131114853 -> j1120073860 [label="RoatheVillain",color=purple];
		j4131114853 -> j1626904625 [label="false",color=purple];
	j639396759 [label="Из-за этого что-нибудь изменилось?",shape=box,color=red];
		j639396759 -> j13871310;
	j298509505 [label="Как отреагировал Лион?",shape=box,color=red];
		j298509505 -> j539023233;
	j1569621990 [label="Нельзя делать твои дни слишком скучными, а то недолго и сойти с ума, как тот священник.",shape=box,color=blue];
		j1569621990 -> "Chat ends.";
	j458479546 [label="Это ещё один повод для искупления. Правда рано или поздно вышла бы наружу в любом случае. Лучше, чтобы её услышали из моих собственных уст.",shape=box,color=blue];
		j458479546 -> j129860326;
		j458479546 -> j2604977333;
	j1120073860 [label="Мне нечего стыдиться. Скрывать это казалось бессмысленным. Истина так или иначе стала бы известна довольно скоро. Лучше, чтобы её услышали из моих собственных уст.",shape=box,color=blue];
		j1120073860 -> j129860326;
		j1120073860 -> j2604977333;
	j1626904625 [label="Правда рано или поздно вышла бы наружу в любом случае. Лучше, чтобы её услышали из моих собственных уст.",shape=box,color=blue];
		j1626904625 -> j129860326;
		j1626904625 -> j2604977333;
	j13871310 [label="Предполагалось, что мой стыд встретят издёвками, выкриками вроде «наконец-то дьявол повержен». Но ничего подобного не произошло. Эта тема едва была затронута.",shape=box,color=blue];
		j13871310 -> j1638442385;
	j539023233 [label="Совсем не так, как ожидалось. Когда спустя несколько вечеров я тихо читал в одиночестве, он сам подошел ко мне несколько ночей спустя.",shape=box,color=blue];
		j539023233 -> j2978378867;
	j129860326 [label="Из-за этого что-нибудь изменилось?",shape=box,color=red];
		j129860326 -> j4128016558;
	j2604977333 [label="Как отреагировала Мари?",shape=box,color=red];
		j2604977333 -> j2292775065;
	j1638442385 [label="В особенности Лион. Я думаю, ему хорошо знакома трудность встречи с прошлым и с теми решениями, что были приняты. Смотри: повязка на глазу, если позволишь эту игру слов.",shape=box,color=blue];
		j1638442385 -> j32725969;
	j2978378867 [label="Он присел рядом и поделился тем, что после сыворотки Энтрати его вера постоянно подвергалась сомнению. Как сами эти вопросы казались постыдными. Что решение принять сыворотку со временем стало предметом сожаления.",shape=box,color=blue];
		j2978378867 -> j1169590808;
	j4128016558 [label="Предполагалось, что мой стыд встретят издёвками, выкриками вроде «наконец-то дьявол повержен». Но ничего подобного не произошло. Эта тема едва была затронута.",shape=box,color=blue];
		j4128016558 -> j3234479019;
	j2292775065 [label="Это было не тем, чего можно было ожидать. Она ничего не сказала. Вместо этого просто... обняла меня. ",shape=box,color=blue];
		j2292775065 -> j598317519;
	j32725969 [label="Check boolean LyonConfession2",color=orange];
