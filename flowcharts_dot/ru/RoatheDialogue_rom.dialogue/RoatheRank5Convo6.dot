		j965189032 -> j2201674798;
	j2241347242 [label="Конечно, я обнял её в ответ. Я Орокин, но я не монстр.",shape=box,color=blue];
		j2241347242 -> j3608534123;
	j541772229 [label="Этот священник. Если уж мне суждено завершить на одной ноте, то пусть это будет так; его стойкость бесконечна, как само время. ",shape=box,color=blue];
		j541772229 -> j1884474448;
	j2542348850 [label="Он почти ничего об этом не упомянул. За что я ему очень благодарен. Я ожидал насмешек и издевательств. «Наконец-то дьявол повержен». Но ничего подобного не произошло. Эта тема едва была затронута.",shape=box,color=blue];
		j2542348850 -> j1638442385;
