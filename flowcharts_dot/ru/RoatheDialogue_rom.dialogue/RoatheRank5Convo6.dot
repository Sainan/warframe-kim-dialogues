	j937766030 [label="Если откровенно, каково твоё мнение о Мари?",shape=box,color=red];
		j937766030 -> j342253044;
	j3782541336 [label="Как складываются отношения между тобой и Лионом?",shape=box,color=red];
		j3782541336 -> j1172864870;
