		j286847889 -> j2975868399;
	j2055941481 [label="+5 Chemistry",color=orange];
		j2055941481 -> j582937463;
	j3008152820 [label="Я пожал ему руку. И поблагодарил как друга. Я Орокин, но я не монстр.",shape=box,color=blue];
		j3008152820 -> j833699157;
	j2584834535 [label="Когда я рассказал ей правду, которую мы узнали, она ничего не ответила. Вместо этого она просто... обняла меня.",shape=box,color=blue];
		j2584834535 -> j1093047434;
	j370324624 [label="Особенно после всего, что она узнала об Энтрати. Она понимает, что люди куда сложнее, чем простое чёрное и белое.",shape=box,color=red];
		j370324624 -> j380018972;
	j3076046095 [label="Мне просто искренне приятно, что между вами вообще возникла хоть какая-то форма дружбы. Даже если это всего лишь перемирие.",shape=box,color=red];
		j3076046095 -> j99602922;
	j3024097353 [label="Единственный раз за всю мою жалкую жизнь я принял простое утешение без лишних смыслов, каким оно было.",shape=box,color=blue];
		j3024097353 -> j3700644674;
	j3700644674 [label="Это был простой способ дать мне понять, что, возможно, для неё это значило куда меньше, чем для меня. И что ей жаль всей боли, через которую я заставил себя пройти из-за этого.",shape=box,color=blue];
		j3700644674 -> j3793703148;
		j3700644674 -> j441366922;
