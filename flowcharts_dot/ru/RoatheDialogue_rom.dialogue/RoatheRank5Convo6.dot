	j2152246590 [label="Прежний Роут воспользовался бы случаем и извлек бы её почки из тела. Но я обнаружил, что я больше не испытываю такого порыва. ",shape=box,color=blue];
		j2152246590 -> j3024097353;
	j2529934868 [label="На это потребовалась вся сила воли, чтобы не вырвать у неё почки из тела. Но намерение было простое, лишь предложить мне тихое утешение.",shape=box,color=blue];
