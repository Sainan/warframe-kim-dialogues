	j1610692841 [label="Я думаю, в конце концов это окажется чем-то большим. Даже если я презираю сам этот факт. В конце концов, я ничего не могу поделать с тем, что оказался в ловушке вместе с ними.",shape=box,color=blue];
		j1610692841 -> j1853749948;
	j2201674798 [label="Он присел рядом и поделился тем, что после сыворотки Энтрати его вера постоянно подвергалась сомнению. Как сами эти вопросы казались постыдными. Что решение принять сыворотку со временем стало предметом сожаления.",shape=box,color=blue];
