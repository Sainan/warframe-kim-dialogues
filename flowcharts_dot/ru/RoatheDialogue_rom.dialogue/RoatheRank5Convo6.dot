		j598317519 -> j566829475 [label="false",color=purple];
	j718144755 [label="Я думаю, ему тоже знакомо, каково это быть порождением своего общества и обстоятельств. Возможно, к твоему прошлому у него куда больше сочувствия, чем может тебе казаться.",shape=box,color=red];
