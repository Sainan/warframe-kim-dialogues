		j441366922 -> j2241347242;
	j2975868399 [label="Я боюсь, скорее всего, твоя правда. Судьба обошлась жестоко, выпала тяжкая доля, и он сделал всё возможное, чтобы противостоять ей.",shape=box,color=blue];
		j2975868399 -> j541772229;
	j582937463 [label="Я думаю, в конце концов это окажется чем-то большим. Даже если я презираю сам этот факт. В конце концов, я ничего не могу поделать с тем, что оказался в ловушке вместе с ними.",shape=box,color=blue];
