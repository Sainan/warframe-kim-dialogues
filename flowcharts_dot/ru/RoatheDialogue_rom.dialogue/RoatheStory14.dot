	"Chat ends." [color=orange];
	j1204276898 [label="VM: ADAPTATION",shape=box,color=blue];
		j1204276898 -> j1750410270;
	j1750410270 [label="Стенограмма: Многие Владеющие Разумом эволюционировали между столкновениями, так что мы никогда не могли быть уверены, что встретим одного и того же врага дважды. Но другие сохраняли неизменную форму, словно давно достигли своего предела.",shape=box,color=blue];
		j1750410270 -> j1710103427;
	j1710103427 [label="Perfected killers, they brought the same cold horror that a shark does.",shape=box,color=blue];
		j1710103427 -> j3435423611;
	j3435423611 [label="Это было безумием. Как можно выстраивать стратегию против поведения Владеющих Разумом кораблей‑крабов, если стоило лишь отточить тактику, как их тут же сменяли корабли‑черви?",shape=box,color=blue];
		j3435423611 -> j1752336139;
	j1752336139 [label="Сколько времени пройдёт, прежде чем эти корабли‑черви заменят новой тварью?",shape=box,color=blue];
		j1752336139 -> j198894524;
	j198894524 [label="All we could do was go backward. Progress had been fatal. Old traditions, time-hallowed paths of honor and discipline, were owed their due.",shape=box,color=blue];
		j198894524 -> j921430358;
	j921430358 [label="Add 1 to HellStory counter",color=orange];
		j921430358 -> "Chat ends.";
}