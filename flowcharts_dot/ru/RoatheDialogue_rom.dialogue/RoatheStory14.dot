	j2974807109 [label="ГС: АДАПТАЦИЯ",shape=box,color=blue];
		j2974807109 -> j1720170392;
	j1720170392 [label="Стенограмма: Многие Владеющие Разумом эволюционировали между столкновениями, так что мы никогда не могли быть уверены, что встретим одного и того же врага дважды. Но другие сохраняли неизменную форму, словно давно достигли своего предела.",shape=box,color=blue];
		j1720170392 -> j2780824781;
	j2780824781 [label="Идеальные убийцы, они несли тот же холодный страх, что и хищная акула.",shape=box,color=blue];
		j2780824781 -> j336775272;
	j336775272 [label="Это было безумием. Как можно выстраивать стратегию против поведения Владеющих Разумом кораблей‑крабов, если стоило лишь отточить тактику, как их тут же сменяли корабли‑черви?",shape=box,color=blue];
		j336775272 -> j3027565620;
	j3027565620 [label="Сколько времени пройдёт, прежде чем эти корабли‑черви заменят новой тварью?",shape=box,color=blue];
		j3027565620 -> j972015088;
	j972015088 [label="Всё, что оставалось, — это отступать. Прогресс оказался губительным. Старые традиции, проверенные временем пути чести и дисциплины, заслуживали уважения.",shape=box,color=blue];
		j972015088 -> j921430358;
	j921430358 [label="Add 1 to HellStory counter",color=orange];
		j921430358 -> "Chat ends.";
}