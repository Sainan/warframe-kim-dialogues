	j570917420 [label="Предательство.",shape=box,color=blue];
		j570917420 -> j4185119820;
	j4258022287 [label="Почему?",shape=box,color=blue];
		j4258022287 -> j186962677;
	j2415788418 [label="Не сегодня. Не завтра.",shape=box,color=blue];
		j2415788418 -> j2099822849;
	j3388867139 [label="Я знаю, что он сказал этим двоим фанатикам, если это вообще стоило выслушивать. «Уриэль, еретик из Ксеты, изгнанник, отвечай — можно ли когда-нибудь простить Орокин?»",shape=box,color=blue];
		j3388867139 -> j2853849915;
	j3938701468 [label="Гельминт. Как он вырос здесь, я не знаю, поскольку он должен был быть здесь уже до нашего прибытия. Он увял и умер в процессе — я подозревал, что другого можно использовать для обратного пути.",shape=box,color=blue];
		j3938701468 -> j2818601248;
	j1737923269 [label="Я не знаю подробностей, поскольку эти воспоминания, как и многие другие, стёрты из моей памяти из-за той трансформации, которую он мне навязал.",shape=box,color=blue];
