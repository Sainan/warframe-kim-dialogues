digraph {
	graph [fontname="Roboto Condensed"];
	node [fontname="Roboto Condensed"];
	edge [fontname="Roboto Condensed"];

	"RoatheRank1Convo3 begins." [color=orange];
		"RoatheRank1Convo3 begins." -> j3810565955;
		"RoatheRank1Convo3 begins." -> j1310452999;
	j3810565955 [label="Можно спросить – как тебе удалось сюда вернуться? Из...  какого времени?",shape=box,color=red];
		j3810565955 -> j1782054338;
	j1310452999 [label="[Конец.]",shape=box,color=red];
		j1310452999 -> "Chat ends.";
	j1782054338 [label="Evaluate expressions on HellStory counter",color=orange];
		j1782054338 -> j3295909887 [label="x >= 21",color=purple];
		j1782054338 -> j2972419758 [label="x < 21",color=purple];
		j1782054338 -> j2972419758 [label="false",color=purple];
	"Chat ends." [color=orange];
	j3295909887 [label="Почему же я подозреваю, что тебе прекрасно известен ответ на этот вопрос, мой узурпатор? Какие игры ты играешь, расспрашивая о таких пустяках, если уже знаешь все мои мысли?",shape=box,color=blue];
		j3295909887 -> j4011668186;
	j2972419758 [label="Да, можешь спросить! Это даст мне возможность вволю восхвалить собственный гений — и заодно пожаловаться на Альбрехта, чья поразительная способность быть одновременно бездумно стремительным и в то же время величайшим трусом просто не поддаётся объяснению!",shape=box,color=blue];
		j2972419758 -> j4070589250;
	j4011668186 [label="Check boolean RoatheKnowsReset",color=orange];
		j4011668186 -> j816203370 [label=true,color=green];
		j4011668186 -> j509229098 [label=false,color=brown];
	j4070589250 [label="Evaluate expressions on HellKeyPlayed counter",color=orange];
		j4070589250 -> j2860303626 [label="x >= 1",color=purple];
		j4070589250 -> j3747095490 [label="x <= 0",color=purple];
		j4070589250 -> j3747095490 [label="false",color=purple];
	j816203370 [label="В тебе столько же подлости, сколько и в Альбрехте, который лез в сознание окружающих, считая их своими игрушками! Так расскажи мне. Зачем спрашивать, если ответы у тебя уже есть, а?",shape=box,color=blue];
		j816203370 -> j3822716580;
		j816203370 -> j774657864;
	j509229098 [label="Скажи мне. Я правильно понимаю, что ты уже знаешь ответ на этот вопрос? Ты уже знаешь, что я вернулся сюда с фанатиками, и, в точности, откуда мы пришли. И, скорее всего, гораздо больше, не правда ли?",shape=box,color=blue];
		j509229098 -> j1240398734;
		j509229098 -> j2637556709;
	j2860303626 [label="Полагаю, Альбрехт не поместил тебя туда по собственной воле.",shape=box,color=red];
		j2860303626 -> j659820353;
	j3747095490 [label="Ах, значит, тебя насильно отправили в прошлое.",shape=box,color=red];
		j3747095490 -> j659820353;
	j3822716580 [label="Я пытаюсь помочь тебе пройти этот процесс, и в прошлый раз всё провалилось. Пытаюсь снова. «Сверху вниз», так сказать.",shape=box,color=red];
		j3822716580 -> j2432070854;
	j774657864 [label="Я даже не знаю, как это объяснить. У меня никогда не было желания иметь дар стирать ваши воспоминания и стараюсь совладать с ним, как могу.",shape=box,color=red];
		j774657864 -> j3043016993;
	j1240398734 [label="Нет, не так.",shape=box,color=red];
		j1240398734 -> j193134505;
	j2637556709 [label="Я… признаю, что да.",shape=box,color=red];
		j2637556709 -> j612551331;
	j659820353 [label="Нет. Совсем нет. Позволь мне объяснить кое-что об Орокин: мы любили играть друг с другом — вернее, любили это делать раньше. Игры были самые разные. Политические, психологические, чувственные. Не имело значения.",shape=box,color=blue];
		j659820353 -> j3183168013;
	j2432070854 [label="+5 Chemistry",color=orange];
		j2432070854 -> j727197915;
	j3043016993 [label="Ты весьма неумело справляешься с этим. Какие цели ты преследуешь, которых тебе ещё не удавалось ранее достичь?",shape=box,color=blue];
		j3043016993 -> j4269406562;
	j193134505 [label="Ха! И теперь я знаю, ты не только вор памяти, но ещё и брехло, Узурпатор.",shape=box,color=blue];
		j193134505 -> "Chat ends.";
	j612551331 [label="Boolean RoatheKnowsReset is now true.",color=orange];
		j612551331 -> j2759196180;
	j3183168013 [label="Благодаря Куве и театру Юван мы стали бессмертными, в теории и по сути. Можешь ли ты представить, насколько это изнуждает?",shape=box,color=blue];
		j3183168013 -> j1318113440;
		j3183168013 -> j682731586;
	j727197915 [label="Boolean RoatheResetScrewedUp is now true.",color=orange];
		j727197915 -> j2943805078;
	j4269406562 [label="Check boolean LoidFamilyComplete",color=orange];
		j4269406562 -> j3827412065 [label=true,color=green];
		j4269406562 -> j369511160 [label=true,color=green];
		j4269406562 -> j3179562013 [label=false,color=brown];
		j4269406562 -> j3827412065 [label=false,color=brown];
		j4269406562 -> j369511160 [label=false,color=brown];
	j2759196180 [label="Тогда зачем приходить с вопросами, на которые ты и так знаешь ответ?",shape=box,color=blue];
		j2759196180 -> j3822716580;
		j2759196180 -> j774657864;
	j1318113440 [label="Поверь, у меня есть кое-какой опыт в этом деле.",shape=box,color=red];
		j1318113440 -> j3600420014;
	j682731586 [label="Я, в сущности, могу. Но, пожалуйста, продолжай.",shape=box,color=red];
		j682731586 -> j1610445094;
	j2943805078 [label="А вот это я нахожу интересным… у тебя «всё провалилось» со мной или с Лионом или Мари?",shape=box,color=blue];
		j2943805078 -> j3635749869;
		j2943805078 -> j4134252354;
		j2943805078 -> j2638707781;
	j3827412065 [label="Ну, видишь ли, вся эта... история про то, зачем была принята сыворотка, и мои... слова прозвучавшие не к месту и не ко времени.",shape=box,color=red];
		j3827412065 -> j292357936;
	j369511160 [label="Я... хочу завоевать сердце одного из вас, и у меня... действительно... ничего не получилось...",shape=box,color=red];
		j369511160 -> j3979395315;
	j3179562013 [label="Я пытаюсь уговорить тебя и остальных помочь мне воссоединить Лойда с семьёй наверху, и… у меня тогда не получилось....",shape=box,color=red];
		j3179562013 -> j2846804994;
	j3600420014 [label="Судя по всему, у тебя появился опыт бесконечного умирания. И, что удивительно, даже это не уберегло тебя от очерствения в конце концов.",shape=box,color=blue];
		j3600420014 -> j1610445094;
	j1610445094 [label="Суть была в том, что я привык, даже очень привык, к интригам и уловкам, которыми мы, Орокин, развлекали друг друга. Это просто способ скоротать время.",shape=box,color=blue];
		j1610445094 -> j1350824412;
	j3635749869 [label="С Лионом...",shape=box,color=red];
		j3635749869 -> j2859852133;
	j4134252354 [label="С Мари...",shape=box,color=red];
		j4134252354 -> j3755860200;
	j2638707781 [label="С тобой...",shape=box,color=red];
		j2638707781 -> j1542695227;
	j292357936 [label="+5 Chemistry",color=orange];
		j292357936 -> j3033927670;
	j3979395315 [label="+5 Chemistry",color=orange];
		j3979395315 -> j3619290845;
	j2846804994 [label="Хм, вижу. У нас было соглашение, и тебе по какой-то причине не удалось выполнить свою часть, так что твоя награда ускользнула.",shape=box,color=blue];
		j2846804994 -> j3269036961;
	j1350824412 [label="Но есть границы, которые мы не переступаем. Действия, на которые мы не пойдём. Я мог бы подробно остановиться на этом, но не стану. Просто скажу, что Альбрехт перешёл все линии.",shape=box,color=blue];
		j1350824412 -> j1675926389;
	j2859852133 [label="Правда? Ты полагаешь достаточно просто кормить и поить его раз в день и посмотреть, поможет ли это? Что ж, хорошо…",shape=box,color=blue];
		j2859852133 -> j988236033;
	j3755860200 [label="И у тебя не получилось уговорить этот маленький комочек невинности пойти за тобой? Я… надеюсь, ты не собираешься делать карьеру переговорщика, моя Вечная Сущность.",shape=box,color=blue];
		j3755860200 -> j58001676;
	j1542695227 [label="+5 Chemistry",color=orange];
		j1542695227 -> j3114961535;
	j3033927670 [label="Хм.",shape=box,color=blue];
		j3033927670 -> j2909116792;
	j3619290845 [label="Ха, это великолепно! Ты действительно владеешь моим вниманием, теперь… кто из нас? Хм? Поведай… не стесняйся. Возможно, мы сможем заключить… соглашение.",shape=box,color=blue];
		j3619290845 -> j94415591;
		j3619290845 -> j2463209926;
		j3619290845 -> j3266921342;
	j3269036961 [label="Я сижу здесь, и два момента сразу бросаются в глаза, как только моё подозрение подтверждается.",shape=box,color=blue];
		j3269036961 -> j758331374;
	j1675926389 [label="Он бросил меня там, в каком-то ужасно древнем году, в каком-то захолустном бородавчатом месте в заднице Изначальной системы! Ты знаешь, что в забытом Бездной «Cathédrale» ещё даже электричества не было?! Электричества!",shape=box,color=blue];
		j1675926389 -> j3148573007;
	j988236033 [label="Что в нём доставило тебе столько хлопот? Может быть, мы сможем договориться?",shape=box,color=blue];
		j988236033 -> j1302134513;
	j58001676 [label="Но скажи мне, что в ней тебя так огорчило? Может быть, мы сможем договориться?",shape=box,color=blue];
		j58001676 -> j256724246;
	j3114961535 [label="Ха! Это великолепно! Ты действительно владеешь моим вниманием, теперь… каким же образом? Хм? Поведай… не стесняйся. Возможно, мы сможем заключить… соглашение.",shape=box,color=blue];
		j3114961535 -> j2004525054;
	j2909116792 [label="Я сижу здесь, и два момента сразу бросаются в глаза, как только моё подозрение подтверждается.",shape=box,color=blue];
		j2909116792 -> j2461250220;
	j94415591 [label="Лион...",shape=box,color=red];
		j94415591 -> j1297560953;
	j2463209926 [label="Мари...",shape=box,color=red];
		j2463209926 -> j1749108849;
	j3266921342 [label="Ты…",shape=box,color=red];
		j3266921342 -> j2090064913;
	j758331374 [label="Мне интересно… Сколько сражений я бы вычеркнул из истории и переделал, если бы обладал такой силой?",shape=box,color=blue];
		j758331374 -> j4233800210;
	j3148573007 [label="Ты хоть представляешь, как сложно было воссоздать Гельминта без электричества?",shape=box,color=blue];
		j3148573007 -> j4077026856;
		j3148573007 -> j1588897203;
