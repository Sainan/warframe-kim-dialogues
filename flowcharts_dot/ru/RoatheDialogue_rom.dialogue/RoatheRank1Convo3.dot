	j556197864 [label="Boolean RoatheXata1 is now true.",color=orange];
		j556197864 -> j2714565615;
	j668798837 [label="Скажем, я не начал этот процесс в том же году, когда ушёл, да? Что ж, теперь мы здесь. Альбрехт, несмотря на все усилия, не смог бросить меня в этой адской бездне.",shape=box,color=blue];
		j668798837 -> j2126877722;
	j1456403421 [label="Моё тело разрывалось на части и пересобиралось. Силой. Я не выбирал этого. Не знаю, было ли так же с остальными.",shape=box,color=blue];
