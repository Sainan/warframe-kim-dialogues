		j3216967296 -> j1421286853;
	j2830942171 [label="За. Тобой. Должок.",shape=box,color=blue];
		j2830942171 -> j1724099886;
	j1520211204 [label="Предательство.",shape=box,color=blue];
		j1520211204 -> j1822604259;
	j32712117 [label="Предательство.",shape=box,color=blue];
		j32712117 -> j4213393176;
	j4258022287 [label="Почему?",shape=box,color=blue];
		j4258022287 -> j186962677;
	j2415788418 [label="Не сегодня. Не завтра.",shape=box,color=blue];
		j2415788418 -> j2099822849;
	j335399858 [label="Я знаю, что он сказал этим двоим фанатикам, если это вообще стоило выслушивать. «Уриэль, еретик из Ксеты, изгнанник, отвечай — можно ли когда-нибудь простить Орокин?»",shape=box,color=blue];
		j335399858 -> j2853849915;
	j4114940610 [label="Гельминт. Как он вырос здесь, я не знаю, поскольку он должен был быть здесь уже до нашего прибытия. Он увял и умер в процессе — я подозревал, что другого можно использовать для обратного пути.",shape=box,color=blue];
		j4114940610 -> j2818601248;
	j3895212417 [label="Я не знаю подробностей, поскольку эти воспоминания, как и многие другие, стёрты из моей памяти из-за той трансформации, которую он мне навязал.",shape=box,color=blue];
		j3895212417 -> j1352533573;
