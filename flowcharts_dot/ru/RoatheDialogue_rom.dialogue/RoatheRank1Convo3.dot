		j684380928 -> j3859675261;
	j2290461553 [label="И, что важнее всего, я гарантирую, что ты добьёшься своей цели — воссоединить дворецкого Альбрехта с семьёй, чего бы это ни стоило, на этот раз.",shape=box,color=blue];
		j2290461553 -> j3234307622;
