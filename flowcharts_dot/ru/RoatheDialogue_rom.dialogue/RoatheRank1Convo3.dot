		341 -> 350;
	342 [label="Я оказался прав. Хотя процесс создания оказался… изнурительным и кропотливым, мягко говоря! Я использовал образцы собственной крови, чтобы воссоздать Гельминта, методом проб и ошибок, будь их прокляты!",shape=box,color=blue];
		342 -> 351;
	343 [label="Но у меня всплывают отрывки воспоминаний. Осколки золотого коридора. Голос, который я узнавал, но не лицо. Это был Альбрехт, но не тот, которого я знал.",shape=box,color=blue];
		343 -> 352;
