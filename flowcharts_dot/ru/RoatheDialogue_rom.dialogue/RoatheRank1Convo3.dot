digraph {
	graph [fontname="Roboto Condensed"];
	node [fontname="Roboto Condensed"];
	edge [fontname="Roboto Condensed"];

	"RoatheRank1Convo3 begins." [color=orange];
		"RoatheRank1Convo3 begins." -> j3810565955;
		"RoatheRank1Convo3 begins." -> j1310452999;
	j3810565955 [label="Можно спросить – как тебе удалось сюда вернуться? Из...  какого времени?",shape=box,color=red];
		j3810565955 -> j1782054338;
	j1310452999 [label="[Конец.]",shape=box,color=red];
		j1310452999 -> "Chat ends.";
	j1782054338 [label="Evaluate expressions on HellStory counter",color=orange];
		j1782054338 -> j2542168239 [label="x >= 21",color=purple];
		j1782054338 -> j2972419758 [label="x < 21",color=purple];
		j1782054338 -> j2972419758 [label="false",color=purple];
	"Chat ends." [color=orange];
	j2542168239 [label="Почему же я подозреваю, что тебе прекрасно известен ответ на этот вопрос, мой узурпатор? Какие игры ты играешь, расспрашивая о таких пустяках, если уже знаешь все мои мысли?",shape=box,color=blue];
		j2542168239 -> j4011668186;
	j2972419758 [label="Да, можешь спросить! Это даст мне возможность вволю восхвалить собственный гений — и заодно пожаловаться на Альбрехта, чья поразительная способность быть одновременно бездумно стремительным и в то же время величайшим трусом просто не поддаётся объяснению!",shape=box,color=blue];
		j2972419758 -> j4070589250;
	j4011668186 [label="Check boolean RoatheKnowsReset",color=orange];
		j4011668186 -> j2762659622 [label=true,color=green];
		j4011668186 -> j606130807 [label=false,color=brown];
	j4070589250 [label="Evaluate expressions on HellKeyPlayed counter",color=orange];
		j4070589250 -> j2756396449 [label="x >= 1",color=purple];
		j4070589250 -> j1447427225 [label="x <= 0",color=purple];
		j4070589250 -> j1447427225 [label="false",color=purple];
	j2762659622 [label="В тебе столько же подлости, сколько и в Альбрехте, который лез в сознание окружающих, считая их своими игрушками! Так расскажи мне. Зачем спрашивать, если ответы у тебя уже есть, а?",shape=box,color=blue];
		j2762659622 -> j1858497620;
		j2762659622 -> j3554080797;
	j606130807 [label="Скажи мне. Я правильно понимаю, что ты уже знаешь ответ на этот вопрос? Ты уже знаешь, что я вернулся сюда с фанатиками, и, в точности, откуда мы пришли. И, скорее всего, гораздо больше, не правда ли?",shape=box,color=blue];
		j606130807 -> j1240398734;
		j606130807 -> j1996843466;
	j2756396449 [label="Полагаю, Альбрехт не поместил тебя туда по собственной воле.",shape=box,color=red];
		j2756396449 -> j4234740312;
	j1447427225 [label="Ах, значит, тебя насильно отправили в прошлое.",shape=box,color=red];
		j1447427225 -> j4234740312;
	j1858497620 [label="Я пытаюсь помочь тебе пройти этот процесс, и в прошлый раз всё провалилось. Пытаюсь снова. «Сверху вниз», так сказать.",shape=box,color=red];
		j1858497620 -> j4207417801;
	j3554080797 [label="Я даже не знаю, как это объяснить. У меня никогда не было желания иметь дар стирать ваши воспоминания и стараюсь совладать с ним, как могу.",shape=box,color=red];
		j3554080797 -> j602664886;
	j1240398734 [label="Нет, не так.",shape=box,color=red];
		j1240398734 -> j193134505;
	j1996843466 [label="Я… признаю, что да.",shape=box,color=red];
		j1996843466 -> j2808341184;
	j4234740312 [label="Нет. Совсем нет. Позволь мне объяснить кое-что об Орокин: мы любили играть друг с другом — вернее, любили это делать раньше. Игры были самые разные. Политические, психологические, чувственные. Не имело значения.",shape=box,color=blue];
		j4234740312 -> j1196827350;
	j4207417801 [label="+5 Chemistry",color=orange];
		j4207417801 -> j2099570120;
	j602664886 [label="Ты весьма неумело справляешься с этим. Какие цели ты преследуешь, которых тебе ещё не удавалось ранее достичь?",shape=box,color=blue];
		j602664886 -> j4269406562;
	j193134505 [label="Ха! И теперь я знаю, ты не только вор памяти, но ещё и брехло, Узурпатор.",shape=box,color=blue];
		j193134505 -> "Chat ends.";
	j2808341184 [label="Boolean RoatheKnowsReset is now true.",color=orange];
		j2808341184 -> j3823180856;
	j1196827350 [label="Благодаря Куве и театру Юван мы стали бессмертными, в теории и по сути. Можешь ли ты представить, насколько это изнуждает?",shape=box,color=blue];
		j1196827350 -> j1570899130;
		j1196827350 -> j2201111358;
	j2099570120 [label="Boolean RoatheResetScrewedUp is now true.",color=orange];
		j2099570120 -> j1412852529;
	j4269406562 [label="Check boolean LoidFamilyComplete",color=orange];
		j4269406562 -> j1436546849 [label=true,color=green];
		j4269406562 -> j253410067 [label=true,color=green];
		j4269406562 -> j1650834799 [label=false,color=brown];
		j4269406562 -> j1436546849 [label=false,color=brown];
		j4269406562 -> j253410067 [label=false,color=brown];
	j3823180856 [label="Тогда зачем приходить с вопросами, на которые ты и так знаешь ответ?",shape=box,color=blue];
		j3823180856 -> j1858497620;
		j3823180856 -> j3554080797;
	j1570899130 [label="Поверь, у меня есть кое-какой опыт в этом деле.",shape=box,color=red];
		j1570899130 -> j220732113;
	j2201111358 [label="Я, в сущности, могу. Но, пожалуйста, продолжай.",shape=box,color=red];
		j2201111358 -> j1685290962;
	j1412852529 [label="А вот это я нахожу интересным… у тебя «всё провалилось» со мной или с Лионом или Мари?",shape=box,color=blue];
		j1412852529 -> j3978710977;
		j1412852529 -> j3821264375;
		j1412852529 -> j297301313;
	j1436546849 [label="Ну, видишь ли, вся эта... история про то, зачем была принята сыворотка, и мои... слова прозвучавшие не к месту и не ко времени.",shape=box,color=red];
		j1436546849 -> j2323109544;
	j253410067 [label="Я... хочу завоевать сердце одного из вас, и у меня... действительно... ничего не получилось...",shape=box,color=red];
		j253410067 -> j2115959034;
	j1650834799 [label="Я пытаюсь уговорить тебя и остальных помочь мне воссоединить Лойда с семьёй наверху, и… у меня тогда не получилось....",shape=box,color=red];
		j1650834799 -> j2188791990;
	j220732113 [label="Судя по всему, у тебя появился опыт бесконечного умирания. И, что удивительно, даже это не уберегло тебя от очерствения в конце концов.",shape=box,color=blue];
		j220732113 -> j1685290962;
	j1685290962 [label="Суть была в том, что я привык, даже очень привык, к интригам и уловкам, которыми мы, Орокин, развлекали друг друга. Это просто способ скоротать время.",shape=box,color=blue];
		j1685290962 -> j2287071217;
	j3978710977 [label="С Лионом...",shape=box,color=red];
		j3978710977 -> j5943971;
	j3821264375 [label="С Мари...",shape=box,color=red];
		j3821264375 -> j3769295269;
	j297301313 [label="С тобой...",shape=box,color=red];
		j297301313 -> j3546864941;
	j2323109544 [label="+5 Chemistry",color=orange];
		j2323109544 -> j3769887960;
	j2115959034 [label="+5 Chemistry",color=orange];
		j2115959034 -> j1775869297;
	j2188791990 [label="Хм, вижу. У нас было соглашение, и тебе по какой-то причине не удалось выполнить свою часть, так что твоя награда ускользнула.",shape=box,color=blue];
		j2188791990 -> j1389049390;
	j2287071217 [label="Но есть границы, которые мы не переступаем. Действия, на которые мы не пойдём. Я мог бы подробно остановиться на этом, но не стану. Просто скажу, что Альбрехт перешёл все линии.",shape=box,color=blue];
		j2287071217 -> j1810719076;
	j5943971 [label="Правда? Ты полагаешь достаточно просто кормить и поить его раз в день и посмотреть, поможет ли это? Что ж, хорошо…",shape=box,color=blue];
		j5943971 -> j988236033;
	j3769295269 [label="И у тебя не получилось уговорить этот маленький комочек невинности пойти за тобой? Я… надеюсь, ты не собираешься делать карьеру переговорщика, моя Вечная Сущность.",shape=box,color=blue];
		j3769295269 -> j58001676;
	j3546864941 [label="+5 Chemistry",color=orange];
		j3546864941 -> j3367881483;
	j3769887960 [label="Хм.",shape=box,color=blue];
		j3769887960 -> j1327739464;
	j1775869297 [label="Ха, это великолепно! Ты действительно владеешь моим вниманием, теперь… кто из нас? Хм? Поведай… не стесняйся. Возможно, мы сможем заключить… соглашение.",shape=box,color=blue];
		j1775869297 -> j1411424838;
		j1775869297 -> j2799268879;
		j1775869297 -> j3568305125;
	j1389049390 [label="Я сижу здесь, и два момента сразу бросаются в глаза, как только моё подозрение подтверждается.",shape=box,color=blue];
		j1389049390 -> j3782619423;
	j1810719076 [label="Он бросил меня там, в каком-то ужасно древнем году, в каком-то захолустном бородавчатом месте в заднице Изначальной системы! Ты знаешь, что в забытом Бездной «Cathédrale» ещё даже электричества не было?! Электричества!",shape=box,color=blue];
		j1810719076 -> j1171839370;
	j988236033 [label="Что в нём доставило тебе столько хлопот? Может быть, мы сможем договориться?",shape=box,color=blue];
		j988236033 -> j1302134513;
	j58001676 [label="Но скажи мне, что в ней тебя так огорчило? Может быть, мы сможем договориться?",shape=box,color=blue];
		j58001676 -> j256724246;
	j3367881483 [label="Ха! Это великолепно! Ты действительно владеешь моим вниманием, теперь… каким же образом? Хм? Поведай… не стесняйся. Возможно, мы сможем заключить… соглашение.",shape=box,color=blue];
		j3367881483 -> j2004525054;
	j1327739464 [label="Я сижу здесь, и два момента сразу бросаются в глаза, как только моё подозрение подтверждается.",shape=box,color=blue];
		j1327739464 -> j2897407700;
	j1411424838 [label="Лион...",shape=box,color=red];
		j1411424838 -> j1033680513;
	j2799268879 [label="Мари...",shape=box,color=red];
		j2799268879 -> j1768342027;
	j3568305125 [label="Ты…",shape=box,color=red];
		j3568305125 -> j1395539301;
	j3782619423 [label="Мне интересно… Сколько сражений я бы вычеркнул из истории и переделал, если бы обладал такой силой?",shape=box,color=blue];
		j3782619423 -> j2465807864;
	j1171839370 [label="Ты хоть представляешь, как сложно было воссоздать Гельминта без электричества?",shape=box,color=blue];
		j1171839370 -> j3818269289;
		j1171839370 -> j1844645343;
