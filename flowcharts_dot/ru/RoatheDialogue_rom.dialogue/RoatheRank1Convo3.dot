digraph {
	186 [label="RoatheRank1Convo3 begins.",color=orange];
		186 -> 188;
		186 -> 187;
	188 [label="Можно спросить – как тебе удалось сюда вернуться? Из...  какого времени?",shape=box,color=red];
		188 -> 190;
	187 [label="[Конец.]",shape=box,color=red];
		187 -> 189;
	190 [label="Evaluate expressions on HellStory",color=orange];
		190 -> 191 [label="x >= 21",color=purple];
		190 -> 192 [label="x < 21",color=purple];
		190 -> 192 [label="false",color=purple];
	189 [label="Chat ends.",color=orange];
	191 [label="Почему же я подозреваю, что тебе прекрасно известен ответ на этот вопрос, мой узурпатор? Какие игры ты играешь, расспрашивая о таких пустяках, если уже знаешь все мои мысли?",shape=box,color=blue];
		191 -> 193;
	192 [label="Да, можешь спросить! Это даст мне возможность вволю восхвалить собственный гений — и заодно пожаловаться на Альбрехта, чья поразительная способность быть одновременно бездумно стремительным и в то же время величайшим трусом просто не поддаётся объяснению!",shape=box,color=blue];
		192 -> 194;
	193 [label="Check boolean RoatheKnowsReset",color=orange];
		193 -> 196 [label=true,color=green];
		193 -> 195 [label=false,color=brown];
	194 [label="Evaluate expressions on HellKeyPlayed",color=orange];
		194 -> 197 [label="x >= 1",color=purple];
		194 -> 198 [label="x <= 0",color=purple];
		194 -> 198 [label="false",color=purple];
	196 [label="В тебе столько же подлости, сколько и в Альбрехте, который лез в сознание окружающих, считая их своими игрушками! Так расскажи мне. Зачем спрашивать, если ответы у тебя уже есть, а?",shape=box,color=blue];
		196 -> 201;
		196 -> 202;
	195 [label="Скажи мне. Я правильно понимаю, что ты уже знаешь ответ на этот вопрос? Ты уже знаешь, что я вернулся сюда с фанатиками, и, в точности, откуда мы пришли. И, скорее всего, гораздо больше, не правда ли?",shape=box,color=blue];
		195 -> 199;
		195 -> 200;
	197 [label="Полагаю, Альбрехт не поместил тебя туда по собственной воле.",shape=box,color=red];
		197 -> 203;
	198 [label="Ах, значит, тебя насильно отправили в прошлое.",shape=box,color=red];
		198 -> 203;
	201 [label="Я пытаюсь помочь тебе пройти этот процесс, и в прошлый раз всё провалилось. Пытаюсь снова. «Сверху вниз», так сказать.",shape=box,color=red];
		201 -> 206;
	202 [label="Я даже не знаю, как это объяснить. У меня никогда не было желания иметь дар стирать ваши воспоминания и стараюсь совладать с ним, как могу.",shape=box,color=red];
		202 -> 207;
	199 [label="Нет, не так.",shape=box,color=red];
		199 -> 204;
	200 [label="Я… признаю, что да.",shape=box,color=red];
		200 -> 205;
	203 [label="Нет. Совсем нет. Позволь мне объяснить кое-что об Орокин: мы любили играть друг с другом — вернее, любили это делать раньше. Игры были самые разные. Политические, психологические, чувственные. Не имело значения.",shape=box,color=blue];
		203 -> 208;
	206 [label="+5 Chemistry",color=orange];
		206 -> 211;
	207 [label="Ты весьма неумело справляешься с этим. Какие цели ты преследуешь, которых тебе ещё не удавалось ранее достичь?",shape=box,color=blue];
		207 -> 212;
	204 [label="Ха! И теперь я знаю, ты не только вор памяти, но ещё и брехло, Узурпатор.",shape=box,color=blue];
		204 -> 209;
	205 [label="Update boolean RoatheKnowsReset",color=orange];
		205 -> 210;
	208 [label="Благодаря Куве и театру Юван мы стали бессмертными, в теории и по сути. Можешь ли ты представить, насколько это изнуждает?",shape=box,color=blue];
		208 -> 213;
		208 -> 214;
	211 [label="Update boolean RoatheResetScrewedUp",color=orange];
		211 -> 215;
	212 [label="Check boolean LoidFamilyComplete",color=orange];
		212 -> 217 [label=true,color=green];
		212 -> 218 [label=true,color=green];
		212 -> 216 [label=false,color=brown];
		212 -> 217 [label=false,color=brown];
		212 -> 218 [label=false,color=brown];
	209 [label="Chat ends.",color=orange];
	210 [label="Тогда зачем приходить с вопросами, на которые ты и так знаешь ответ?",shape=box,color=blue];
		210 -> 201;
		210 -> 202;
	213 [label="Поверь, у меня есть кое-какой опыт в этом деле.",shape=box,color=red];
		213 -> 219;
	214 [label="Я, в сущности, могу. Но, пожалуйста, продолжай.",shape=box,color=red];
		214 -> 220;
	215 [label="А вот это я нахожу интересным… у тебя «всё провалилось» со мной или с Лионом или Мари?",shape=box,color=blue];
		215 -> 221;
		215 -> 222;
		215 -> 223;
	217 [label="Ну, видишь ли, вся эта... история про то, зачем была принята сыворотка, и мои... слова прозвучавшие не к месту и не ко времени.",shape=box,color=red];
		217 -> 225;
	218 [label="Я... хочу завоевать сердце одного из вас, и у меня... действительно... ничего не получилось...",shape=box,color=red];
		218 -> 226;
	216 [label="Я пытаюсь уговорить тебя и остальных помочь мне воссоединить Лойда с семьёй наверху, и… у меня тогда не получилось....",shape=box,color=red];
		216 -> 224;
	219 [label="Судя по всему, у тебя появился опыт бесконечного умирания. И, что удивительно, даже это не уберегло тебя от очерствения в конце концов.",shape=box,color=blue];
		219 -> 220;
	220 [label="Суть была в том, что я привык, даже очень привык, к интригам и уловкам, которыми мы, Орокин, развлекали друг друга. Это просто способ скоротать время.",shape=box,color=blue];
		220 -> 227;
	221 [label="С Лионом...",shape=box,color=red];
		221 -> 228;
	222 [label="С Мари...",shape=box,color=red];
		222 -> 229;
	223 [label="С тобой...",shape=box,color=red];
		223 -> 230;
	225 [label="+5 Chemistry",color=orange];
		225 -> 232;
	226 [label="+5 Chemistry",color=orange];
		226 -> 233;
	224 [label="Хм, вижу. У нас было соглашение, и тебе по какой-то причине не удалось выполнить свою часть, так что твоя награда ускользнула.",shape=box,color=blue];
		224 -> 231;
	227 [label="Но есть границы, которые мы не переступаем. Действия, на которые мы не пойдём. Я мог бы подробно остановиться на этом, но не стану. Просто скажу, что Альбрехт перешёл все линии.",shape=box,color=blue];
		227 -> 234;
	228 [label="Правда? Ты полагаешь достаточно просто кормить и поить его раз в день и посмотреть, поможет ли это? Что ж, хорошо…",shape=box,color=blue];
		228 -> 235;
	229 [label="И у тебя не получилось уговорить этот маленький комочек невинности пойти за тобой? Я… надеюсь, ты не собираешься делать карьеру переговорщика, моя Вечная Сущность.",shape=box,color=blue];
		229 -> 236;
	230 [label="+5 Chemistry",color=orange];
		230 -> 237;
	232 [label="Хм.",shape=box,color=blue];
		232 -> 239;
	233 [label="Ха, это великолепно! Ты действительно владеешь моим вниманием, теперь… кто из нас? Хм? Поведай… не стесняйся. Возможно, мы сможем заключить… соглашение.",shape=box,color=blue];
		233 -> 240;
		233 -> 241;
		233 -> 242;
	231 [label="Я сижу здесь, и два момента сразу бросаются в глаза, как только моё подозрение подтверждается.",shape=box,color=blue];
		231 -> 238;
	234 [label="Он бросил меня там, в каком-то ужасно древнем году, в каком-то захолустном бородавчатом месте в заднице Изначальной системы! Ты знаешь, что в забытом Бездной «Cathédrale» ещё даже электричества не было?! Электричества!",shape=box,color=blue];
		234 -> 243;
	235 [label="Что в нём доставило тебе столько хлопот? Может быть, мы сможем договориться?",shape=box,color=blue];
		235 -> 244;
	236 [label="Но скажи мне, что в ней тебя так огорчило? Может быть, мы сможем договориться?",shape=box,color=blue];
		236 -> 245;
	237 [label="Ха! Это великолепно! Ты действительно владеешь моим вниманием, теперь… каким же образом? Хм? Поведай… не стесняйся. Возможно, мы сможем заключить… соглашение.",shape=box,color=blue];
		237 -> 246;
	239 [label="Я сижу здесь, и два момента сразу бросаются в глаза, как только моё подозрение подтверждается.",shape=box,color=blue];
		239 -> 248;
	240 [label="Лион...",shape=box,color=red];
		240 -> 249;
	241 [label="Мари...",shape=box,color=red];
		241 -> 250;
	242 [label="Ты…",shape=box,color=red];
		242 -> 251;
	238 [label="Мне интересно… Сколько сражений я бы вычеркнул из истории и переделал, если бы обладал такой силой?",shape=box,color=blue];
		238 -> 247;
	243 [label="Ты хоть представляешь, как сложно было воссоздать Гельминта без электричества?",shape=box,color=blue];
		243 -> 252;
		243 -> 253;
