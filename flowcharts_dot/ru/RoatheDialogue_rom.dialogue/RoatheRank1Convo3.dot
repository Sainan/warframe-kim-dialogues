		j2648397529 -> j828660333;
	j3954274962 [label="Договорились?",shape=box,color=blue];
		j3954274962 -> j3395721570;
		j3954274962 -> j3848189488;
	j926412353 [label="Он, убегающий от своей семьи, от своей любви, от битвы, которую он начал со своим фальшивым богом! Я не тот проклятый трус среди нас!",shape=box,color=blue];
		j926412353 -> j556197864;
	j1135234255 [label="Boolean RoatheHelminth1 is now true.",color=orange];
		j1135234255 -> j668798837;
	j1389322837 [label="Обжигающая, палящая боль. Не похожая ни на что, что я когда-либо испытывал прежде. Моё прежнее тело лишилось руки и ноги в результате взрыва на войне, Скиталец. Меня покрывали ожоги, от которых я не смог бы оправиться, если бы не Кува. Я познал агонию.",shape=box,color=blue];
		j1389322837 -> j801606268;
