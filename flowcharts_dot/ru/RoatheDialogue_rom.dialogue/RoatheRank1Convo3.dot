	j2714565615 [label="+20 Chemistry",color=orange];
		j2714565615 -> j876532250;
	j2126877722 [label="Однако я удивлён, что его здесь нет. Я был уверен, что он спрячется именно здесь – с любовницей или с семьёй.",shape=box,color=blue];
