	j3343634331 [label="Ммм… нет, при более внимательном рассмотрении, Узурпатор — думаю, это не гнев я испытываю, узнав, мои воспоминания о наших прежних беседах стёрты тобой, чтобы начать их заново.",shape=box,color=blue];
