	j1116681704 [label="Обжигающая, палящая боль. Не похожая ни на что, что я когда-либо испытывал прежде. Ное прежнее тело лишилось руки и ноги в результате взрыва на войне, Скиталец. Меня покрывали ожоги, от которых я не смог бы оправиться, если бы не Кува. Я познал муки.",shape=box,color=blue];
