		j4056291514 -> j3015336983;
	j1388517747 [label="Я… не потерплю неудачу? Мы с тобой во всем разберёмся? Во что бы то ни стало?",shape=box,color=red];
		j1388517747 -> j440707935;
	j3789456752 [label="Нет. Нет, ни в коем случае!",shape=box,color=red];
		j3789456752 -> j949671740;
	j554432596 [label="И, что важнее всего, я гарантирую, что ты добьёшься своей цели – воссоединиться с твоим дорогим отцом Лионом Аллардом, когда придёт время.",shape=box,color=blue];
		j554432596 -> j2515020888;
	j1763445485 [label="И, что важнее всего, я гарантирую, что ты добьёшься своей цели — воссоединиться с «маленькой Мари», когда придёт время.",shape=box,color=blue];
