		j2004525054 -> j3179562013 [label=false,color=brown];
		j2004525054 -> j369725991 [label=false,color=brown];
	j2461250220 [label="Мне интересно… Сколько сражений я бы вычеркнул из истории и переделал, если бы обладал такой силой?",shape=box,color=blue];
		j2461250220 -> j2601919018;
	j1297560953 [label="Boolean DrifterLyon is now true.",color=orange];
		j1297560953 -> j3328985350;
	j1749108849 [label="Boolean DrifterMarie is now true.",color=orange];
		j1749108849 -> j871525227;
	j2090064913 [label="Boolean DrifterRoathe is now true.",color=orange];
		j2090064913 -> j677431250;
	j4233800210 [label="Скольких душ я бы покорил, имея твои дарования в своём распоряжении?",shape=box,color=blue];
		j4233800210 -> j1040797929;
	j4077026856 [label="Итак… Погоди. Я запутался. Как и когда Энтрати превратил тебя в протофрейм?",shape=box,color=red];
		j4077026856 -> j2571193076;
	j1588897203 [label="Ты. Погоди. Ты сделал что?!",shape=box,color=red];
		j1588897203 -> j1343523405;
	j3157447863 [label="У Лиона… слишком много дел, с которыми нужно разобраться. И я не знаю, как пробиться сквозь всё это.",shape=box,color=red];
		j3157447863 -> j2419575502;
	j1781156877 [label="У меня к нему чувства…",shape=box,color=red];
		j1781156877 -> j1297560953;
	j3712021994 [label="Она не хочет видеть Энтрати таким, какой он есть. Все попытки донести до неё правду остаются безуспешными.",shape=box,color=red];
		j3712021994 -> j706179040;
	j1435907117 [label="Я испытываю к ней чувства…",shape=box,color=red];
		j1435907117 -> j1749108849;
	j2828180479 [label="Ну, понимаешь, у тебя есть целая история о том, зачем ты принял сыворотку, а мне… как-то удалось всё испортить…",shape=box,color=red];
		j2828180479 -> j292357936;
	j369725991 [label="[Признаться в чувствах.] Это… это действительно неловко, но я…",shape=box,color=red];
		j369725991 -> j2090064913;
	j2601919018 [label="Скольких душ я бы покорил, имея твои дарования в своём распоряжении?",shape=box,color=blue];
		j2601919018 -> j4091929026;
	j3328985350 [label="+5 Chemistry",color=orange];
		j3328985350 -> j3671434833;
	j871525227 [label="+5 Chemistry",color=orange];
		j871525227 -> j762215229;
	j677431250 [label="+5 Chemistry",color=orange];
		j677431250 -> j4010058137;
	j1040797929 [label="Во-вторых, меня охватывает немедленный гнев и ярость от осознания того, что с моим разумом дважды поиграли в недавней истории. Но есть и другое чувство, которое побеждает этот гнев. Чувство, которое я пока не совсем понимаю.",shape=box,color=blue];
		j1040797929 -> j245737651;
	j2571193076 [label="Я не знаю подробностей, поскольку эти воспоминания, как и многие другие, стёрты из моей памяти из-за той трансформации, которую он мне навязал.",shape=box,color=blue];
		j2571193076 -> j1456654827;
	j1343523405 [label="Да! Именно! С образцами моей собственной крови, ни больше ни меньше! Я начал не в том же году, когда мы вышли, уж поверь! Клянусь Бездной, я сдеру с него плоть этими своими новыми когтями, как только увижу его глупую, самодовольную рожу…",shape=box,color=blue];
		j1343523405 -> j700179164;
	j2419575502 [label="Я бы посоветовал простое терпение, но… не мне учить тебя пользоваться зубилом, когда у тебя под рукой лазер.",shape=box,color=blue];
		j2419575502 -> j110390236;
	j706179040 [label="+5 Chemistry",color=orange];
		j706179040 -> j1892432044;
	j4091929026 [label="Во-вторых, меня охватывает немедленный гнев и ярость от осознания того, что с моим разумом дважды поиграли в недавней истории. Но есть и другое чувство, которое побеждает этот гнев. Чувство, которое я пока не совсем понимаю.",shape=box,color=blue];
		j4091929026 -> j29347989;
	j3671434833 [label="Во-первых: я впечатлён! Ты отнимаешь у нас все воспоминания, чтобы ещё раз попытаться завоевать его любовь?!",shape=box,color=blue];
		j3671434833 -> j1399459353;
	j762215229 [label="Во-первых: я впечатлён! Ты отнимаешь у нас все воспоминания, чтобы ещё раз попытаться завоевать её любовь?!",shape=box,color=blue];
		j762215229 -> j1908635876;
	j4010058137 [label="О, это просто волшебно! Ты уничтожаешь все наши воспоминания, пытаясь ещё раз завоевать моё расположение?!",shape=box,color=blue];
		j4010058137 -> j3776214280;
	j245737651 [label="Предательство.",shape=box,color=blue];
		j245737651 -> j3214826503;
	j1456654827 [label="Но у меня всплывают отрывки воспоминаний. Осколки золотого коридора. Голос, который я узнавал, но не лицо. Это был Альбрехт, но не тот, которого я знал.",shape=box,color=blue];
		j1456654827 -> j1964587683;
	j700179164 [label="Позволь мне успокоиться.",shape=box,color=blue];
		j700179164 -> j1264083790;
	j110390236 [label="Я сижу здесь, и два момента сразу бросаются в глаза, как только моё подозрение подтверждается.",shape=box,color=blue];
		j110390236 -> j4243009350;
	j1892432044 [label="Хм, вижу. Благородное начинание, если честно. Которое я сам неоднократно пытался осуществить. И столь же часто терпел неудачу.",shape=box,color=blue];
		j1892432044 -> j784122958;
	j29347989 [label="Предательство.",shape=box,color=blue];
		j29347989 -> j3323231142;
	j1399459353 [label="Как же это в духе Орокин!",shape=box,color=blue];
		j1399459353 -> j1089288667;
	j1908635876 [label="Как же это в духе Орокин!",shape=box,color=blue];
		j1908635876 -> j1392318295;
	j3776214280 [label="Как же это в духе Орокин!",shape=box,color=blue];
		j3776214280 -> j1185800504;
	j3214826503 [label="Почему?",shape=box,color=blue];
		j3214826503 -> j3040313123;
	j1964587683 [label="Обжигающая, палящая боль. Не похожая ни на что, что я когда-либо испытывал прежде. Моё прежнее тело лишилось руки и ноги в результате взрыва на войне, Скиталец. Меня покрывали ожоги, от которых я не смог бы оправиться, если бы не Кува. Я познал агонию.",shape=box,color=blue];
		j1964587683 -> j2949734827;
	j1264083790 [label="Благодарю. Можно начинать.",shape=box,color=blue];
		j1264083790 -> j2543333043;
	j4243009350 [label="Мне интересно… Сколько сражений я бы вычеркнул из истории и переделал, если бы обладал такой силой?",shape=box,color=blue];
		j4243009350 -> j696869130;
	j784122958 [label="Я сижу здесь, и два момента сразу бросаются в глаза, как только моё подозрение подтверждается.",shape=box,color=blue];
		j784122958 -> j2022252225;
	j3323231142 [label="Почему?",shape=box,color=blue];
		j3323231142 -> j1101670471;
	j1089288667 [label="Второе: твоя неуклюжесть просто поразительна! Я почти уверен, что если бы ты просто кормил и поил Священника раз в день, он бы одарил тебя безграничной любовью и обожанием.",shape=box,color=blue];
		j1089288667 -> j3635045670;
	j1392318295 [label="Второе: у тебя не возникла идея, например, прихрамывать перед ней? Притворяться, что плохое здоровье? Строить глазки? Или просто сказать, что она хорошо выглядит? Кажется, она не так уж и труднодоступна.",shape=box,color=blue];
		j1392318295 -> j4198929023;
	j1185800504 [label="Я сижу здесь, и два момента сразу бросаются в глаза, как только моё подозрение подтверждается.",shape=box,color=blue];
		j1185800504 -> j3043337747;
	j3040313123 [label="Но это разговор на другой день. У меня есть предложение для тебя, и я уверен, оно вызовет у тебя гораздо больший интерес.",shape=box,color=blue];
		j3040313123 -> j3280689756;
	j2949734827 [label="Моё тело разрывалось на части и пересобиралось. Силой. Я не выбирал этого. Не знаю, было ли так же с остальными.",shape=box,color=blue];
		j2949734827 -> j3514726215;
	j2543333043 [label="Я восстанавливал структуру Гельминта, используя образцы собственной крови, методом проб и ошибок. Задача была не из лёгких, учитывая отсутствие доступа к оборудованию Орокин. Да и вообще к какому-либо оборудованию, кроме того, что я смог украсть у…",shape=box,color=blue];
		j2543333043 -> j3025449356;
	j696869130 [label="Скольких душ я бы покорил, имея твои дарования в своём распоряжении?",shape=box,color=blue];
		j696869130 -> j1953736829;
	j2022252225 [label="Мне интересно… Сколько сражений я бы вычеркнул из истории и переделал, если бы обладал такой силой?",shape=box,color=blue];
		j2022252225 -> j3786770936;
	j1101670471 [label="Но это разговор на другой день. У меня есть предложение для тебя, и я уверен, оно вызовет у тебя гораздо больший интерес.",shape=box,color=blue];
		j1101670471 -> j2696765160;
	j3635045670 [label="Не пойми меня неправильно! Я весьма впечатлён твоей хитроумностью.",shape=box,color=blue];
		j3635045670 -> j329268804;
	j4198929023 [label="Третье: я сижу здесь и внезапно ощущаю, как меня захлёстывают эпизоды осознания, подтверждающие мои подозрения.",shape=box,color=blue];
		j4198929023 -> j3658050139;
	j3043337747 [label="Мне интересно… Сколько сражений я бы вычеркнул из истории и переделал, если бы обладал такой силой?",shape=box,color=blue];
		j3043337747 -> j684380928;
	j3280689756 [label="Я прикинусь, что ничего не знаю, перед фанатиками ради тебя…",shape=box,color=blue];
		j3280689756 -> j2290461553;
	j3514726215 [label="Я помню холодные ступени под собой, когда меня на них бросили. То были Соборные ступени, теперь я знаю это, как рассказали мне Лион и Мари, вспоминая события.",shape=box,color=blue];
		j3514726215 -> j15855171;
	j3025449356 [label="Не буду оказывать им одолжение, называя их «зачаточными» больницами. Альбрехт использовал гельминта, чтобы перенести нас в прошлое. Как он там разросся, я не знаю, ведь он должен был уже быть там, чтобы мы могли прибыть. Он засох и умер в процессе — я подозревал, что для обратного путешествия можно использовать другого.",shape=box,color=blue];
		j3025449356 -> j2779440410;
	j1953736829 [label="Во-вторых, меня охватывает немедленный гнев и ярость от осознания того, что с моим разумом дважды поиграли в недавней истории. Но есть и другое чувство, которое побеждает этот гнев. Чувство, которое я пока не совсем понимаю.",shape=box,color=blue];
		j1953736829 -> j799760220;
	j3786770936 [label="Скольких душ я бы покорил, имея твои дарования в своём распоряжении?",shape=box,color=blue];
