		j256724246 -> j2456569510 [label=false,color=brown];
	j2004525054 [label="Check boolean LoidFamilyComplete",color=orange];
		j2004525054 -> j1821911227 [label=true,color=green];
		j2004525054 -> j700781656 [label=true,color=green];
		j2004525054 -> j1821911227 [label=false,color=brown];
		j2004525054 -> j1650834799 [label=false,color=brown];
		j2004525054 -> j700781656 [label=false,color=brown];
	j2897407700 [label="Мне интересно… Сколько сражений я бы вычеркнул из истории и переделал, если бы обладал такой силой?",shape=box,color=blue];
		j2897407700 -> j3004738942;
	j1033680513 [label="Boolean DrifterLyon is now true.",color=orange];
		j1033680513 -> j2343441767;
	j1768342027 [label="Boolean DrifterMarie is now true.",color=orange];
		j1768342027 -> j809467656;
	j1395539301 [label="Boolean DrifterRoathe is now true.",color=orange];
		j1395539301 -> j321092964;
	j2465807864 [label="Скольких душ я бы покорил, имея твои дарования в своём распоряжении?",shape=box,color=blue];
		j2465807864 -> j2340371706;
	j3818269289 [label="Итак… Погоди. Я запутался. Как и когда Энтрати превратил тебя в протофрейм?",shape=box,color=red];
		j3818269289 -> j1518639988;
	j1844645343 [label="Ты. Погоди. Ты сделал что?!",shape=box,color=red];
		j1844645343 -> j2980257403;
	j147534978 [label="У Лиона… слишком много дел, с которыми нужно разобраться. И я не знаю, как пробиться сквозь всё это.",shape=box,color=red];
		j147534978 -> j1251605165;
	j75948743 [label="У меня к нему чувства…",shape=box,color=red];
		j75948743 -> j1033680513;
	j612507136 [label="Она не хочет видеть Энтрати таким, какой он есть. Все попытки донести до неё правду остаются безуспешными.",shape=box,color=red];
		j612507136 -> j74966738;
	j2456569510 [label="Я испытываю к ней чувства…",shape=box,color=red];
		j2456569510 -> j1768342027;
	j1821911227 [label="Ну, понимаешь, у тебя есть целая история о том, зачем ты принял сыворотку, а мне… как-то удалось всё испортить…",shape=box,color=red];
		j1821911227 -> j2323109544;
	j700781656 [label="[Признаться в чувствах.] Это… это действительно неловко, но я…",shape=box,color=red];
		j700781656 -> j1395539301;
	j3004738942 [label="Скольких душ я бы покорил, имея твои дарования в своём распоряжении?",shape=box,color=blue];
		j3004738942 -> j3439605161;
	j2343441767 [label="+5 Chemistry",color=orange];
		j2343441767 -> j3995408716;
	j809467656 [label="+5 Chemistry",color=orange];
		j809467656 -> j826340822;
	j321092964 [label="+5 Chemistry",color=orange];
		j321092964 -> j396380675;
	j2340371706 [label="Во-вторых, меня охватывает немедленный гнев и ярость от осознания того, что с моим разумом дважды поиграли в недавней истории. Но есть и другое чувство, которое побеждает этот гнев. Чувство, которое я пока не совсем понимаю.",shape=box,color=blue];
		j2340371706 -> j4025175485;
	j1518639988 [label="Я не знаю подробностей, поскольку эти воспоминания, как и многие другие, стёрты из моей памяти из-за той трансформации, которую он мне навязал.",shape=box,color=blue];
		j1518639988 -> j475478684;
	j2980257403 [label="Да! Именно! С образцами моей собственной крови, ни больше ни меньше! Я начал не в том же году, когда мы вышли, уж поверь! Клянусь Бездной, я сдеру с него плоть этими своими новыми когтями, как только увижу его глупую, самодовольную рожу…",shape=box,color=blue];
		j2980257403 -> j3933995813;
	j1251605165 [label="Я бы посоветовал простое терпение, но… не мне учить тебя пользоваться зубилом, когда у тебя под рукой лазер.",shape=box,color=blue];
		j1251605165 -> j2364008381;
	j74966738 [label="+5 Chemistry",color=orange];
		j74966738 -> j2451050900;
	j3439605161 [label="Во-вторых, меня охватывает немедленный гнев и ярость от осознания того, что с моим разумом дважды поиграли в недавней истории. Но есть и другое чувство, которое побеждает этот гнев. Чувство, которое я пока не совсем понимаю.",shape=box,color=blue];
		j3439605161 -> j2438225315;
	j3995408716 [label="Во-первых: я впечатлён! Ты отнимаешь у нас все воспоминания, чтобы ещё раз попытаться завоевать его любовь?!",shape=box,color=blue];
		j3995408716 -> j597503362;
	j826340822 [label="Во-первых: я впечатлён! Ты отнимаешь у нас все воспоминания, чтобы ещё раз попытаться завоевать её любовь?!",shape=box,color=blue];
		j826340822 -> j735378984;
	j396380675 [label="О, это просто волшебно! Ты уничтожаешь все наши воспоминания, пытаясь ещё раз завоевать моё расположение?!",shape=box,color=blue];
		j396380675 -> j1664862;
	j4025175485 [label="Предательство.",shape=box,color=blue];
		j4025175485 -> j3222954134;
	j475478684 [label="Но у меня всплывают отрывки воспоминаний. Осколки золотого коридора. Голос, который я узнавал, но не лицо. Это был Альбрехт, но не тот, которого я знал.",shape=box,color=blue];
		j475478684 -> j1287655874;
	j3933995813 [label="Позволь мне успокоиться.",shape=box,color=blue];
		j3933995813 -> j2020431246;
	j2364008381 [label="Я сижу здесь, и два момента сразу бросаются в глаза, как только моё подозрение подтверждается.",shape=box,color=blue];
		j2364008381 -> j743075459;
	j2451050900 [label="Хм, вижу. Благородное начинание, если честно. Которое я сам неоднократно пытался осуществить. И столь же часто терпел неудачу.",shape=box,color=blue];
		j2451050900 -> j569264187;
	j2438225315 [label="Предательство.",shape=box,color=blue];
		j2438225315 -> j1865256812;
	j597503362 [label="Как же это в духе Орокин!",shape=box,color=blue];
		j597503362 -> j1570476175;
	j735378984 [label="Как же это в духе Орокин!",shape=box,color=blue];
		j735378984 -> j421151845;
	j1664862 [label="Как же это в духе Орокин!",shape=box,color=blue];
		j1664862 -> j2945779780;
	j3222954134 [label="Почему?",shape=box,color=blue];
		j3222954134 -> j1001274915;
	j1287655874 [label="Обжигающая, палящая боль. Не похожая ни на что, что я когда-либо испытывал прежде. Моё прежнее тело лишилось руки и ноги в результате взрыва на войне, Скиталец. Меня покрывали ожоги, от которых я не смог бы оправиться, если бы не Кува. Я познал агонию.",shape=box,color=blue];
		j1287655874 -> j3873598588;
	j2020431246 [label="Благодарю. Можно начинать.",shape=box,color=blue];
		j2020431246 -> j294484645;
	j743075459 [label="Мне интересно… Сколько сражений я бы вычеркнул из истории и переделал, если бы обладал такой силой?",shape=box,color=blue];
		j743075459 -> j3656333606;
	j569264187 [label="Я сижу здесь, и два момента сразу бросаются в глаза, как только моё подозрение подтверждается.",shape=box,color=blue];
		j569264187 -> j2183500322;
	j1865256812 [label="Почему?",shape=box,color=blue];
		j1865256812 -> j1695827674;
	j1570476175 [label="Второе: твоя неуклюжесть просто поразительна! Я почти уверен, что если бы ты просто кормил и поил Священника раз в день, он бы одарил тебя безграничной любовью и обожанием.",shape=box,color=blue];
		j1570476175 -> j2293537096;
	j421151845 [label="Второе: у тебя не возникла идея, например, прихрамывать перед ней? Притворяться, что плохое здоровье? Строить глазки? Или просто сказать, что она хорошо выглядит? Кажется, она не так уж и труднодоступна.",shape=box,color=blue];
		j421151845 -> j2172336418;
	j2945779780 [label="Я сижу здесь, и два момента сразу бросаются в глаза, как только моё подозрение подтверждается.",shape=box,color=blue];
		j2945779780 -> j3867099877;
	j1001274915 [label="Но это разговор на другой день. У меня есть предложение для тебя, и я уверен, оно вызовет у тебя гораздо больший интерес.",shape=box,color=blue];
		j1001274915 -> j3490188758;
	j3873598588 [label="Моё тело разрывалось на части и пересобиралось. Силой. Я не выбирал этого. Не знаю, было ли так же с остальными.",shape=box,color=blue];
		j3873598588 -> j2624230401;
	j294484645 [label="Я восстанавливал структуру Гельминта, используя образцы собственной крови, методом проб и ошибок. Задача была не из лёгких, учитывая отсутствие доступа к оборудованию Орокин. Да и вообще к какому-либо оборудованию, кроме того, что я смог украсть у…",shape=box,color=blue];
		j294484645 -> j132874789;
	j3656333606 [label="Скольких душ я бы покорил, имея твои дарования в своём распоряжении?",shape=box,color=blue];
		j3656333606 -> j1953736829;
	j2183500322 [label="Мне интересно… Сколько сражений я бы вычеркнул из истории и переделал, если бы обладал такой силой?",shape=box,color=blue];
		j2183500322 -> j3062079130;
	j1695827674 [label="Но это разговор на другой день. У меня есть предложение для тебя, и я уверен, оно вызовет у тебя гораздо больший интерес.",shape=box,color=blue];
		j1695827674 -> j1374556999;
	j2293537096 [label="Не пойми меня неправильно! Я весьма впечатлён твоей хитроумностью.",shape=box,color=blue];
		j2293537096 -> j993755705;
	j2172336418 [label="Третье: я сижу здесь и внезапно ощущаю, как меня захлёстывают эпизоды осознания, подтверждающие мои подозрения.",shape=box,color=blue];
		j2172336418 -> j3527879334;
	j3867099877 [label="Мне интересно… Сколько сражений я бы вычеркнул из истории и переделал, если бы обладал такой силой?",shape=box,color=blue];
		j3867099877 -> j133821425;
	j3490188758 [label="Я прикинусь, что ничего не знаю, перед фанатиками ради тебя…",shape=box,color=blue];
		j3490188758 -> j2287328287;
	j2624230401 [label="Я помню холодные ступени под собой, когда меня на них бросили. То были Соборные ступени, теперь я знаю это, как рассказали мне Лион и Мари, вспоминая события.",shape=box,color=blue];
		j2624230401 -> j2084562863;
	j132874789 [label="Не буду оказывать им одолжение, называя их «зачаточными» больницами. Альбрехт использовал гельминта, чтобы перенести нас в прошлое. Как он там разросся, я не знаю, ведь он должен был уже быть там, чтобы мы могли прибыть. Он засох и умер в процессе — я подозревал, что для обратного путешествия можно использовать другого.",shape=box,color=blue];
		j132874789 -> j2779440410;
	j1953736829 [label="Во-вторых, меня охватывает немедленный гнев и ярость от осознания того, что с моим разумом дважды поиграли в недавней истории. Но есть и другое чувство, которое побеждает этот гнев. Чувство, которое я пока не совсем понимаю.",shape=box,color=blue];
		j1953736829 -> j799760220;
	j3062079130 [label="Скольких душ я бы покорил, имея твои дарования в своём распоряжении?",shape=box,color=blue];
		j3062079130 -> j1220204608;
	j1374556999 [label="Я прикинусь, что ничего не знаю, перед фанатиками ради тебя...",shape=box,color=blue];
		j1374556999 -> j3439658532;
	j993755705 [label="Честно говоря, я не думаю, что могу тебя осуждать. Сколько сражений я бы вычеркнул из истории и переделал, если бы обладал такой силой?",shape=box,color=blue];
		j993755705 -> j3022279936;
	j3527879334 [label="Мне интересно… Сколько сражений я бы вычеркнул из истории и переделал, если бы обладал такой силой?",shape=box,color=blue];
		j3527879334 -> j1167537317;
	j133821425 [label="Скольких душ я бы покорил, имея твои дарования в своём распоряжении?",shape=box,color=blue];
		j133821425 -> j3859675261;
	j2287328287 [label="И, что важнее всего, я гарантирую, что ты добьёшься своей цели — воссоединить дворецкого Альбрехта с семьёй, чего бы это ни стоило, на этот раз.",shape=box,color=blue];
		j2287328287 -> j3234307622;
	j2084562863 [label="Альбрехт перенёс меня в их время и в их нелепый Собор, а затем предал их «заботе».",shape=box,color=blue];
		j2084562863 -> j4099779516;
	j2779440410 [label="Я оказался прав. Хотя процесс создания оказался… кропотливым и утомительным.",shape=box,color=blue];
