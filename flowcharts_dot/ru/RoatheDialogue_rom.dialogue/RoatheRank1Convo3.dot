	j2099822849 [label="Но ты будешь в долгу у дьявола.",shape=box,color=blue];
		j2099822849 -> j3954274962;
	j2853849915 [label="Если бы я в тот момент осознавал, что он это сказал, я бы рассмеялся ему в лицо. А именно, не я здесь явно ищу прощения, не так ли?",shape=box,color=blue];
		j2853849915 -> j926412353;
	j2818601248 [label="Я оказался прав. Хотя процесс создания оказался… изнурительным и кропотливым, мягко говоря! Я использовал образцы собственной крови, чтобы воссоздать Гельминта, методом проб и ошибок, будь их прокляты!",shape=box,color=blue];
		j2818601248 -> j1135234255;
	j967644129 [label="Но у меня всплывают отрывки воспоминаний. Осколки золотого коридора. Голос, который я узнавал, но не лицо. Это был Альбрехт, но не тот, которого я знал.",shape=box,color=blue];
		j967644129 -> j1389322837;
	j103328203 [label="И, что важнее всего, я гарантирую, что ты добьёшься своей цели – помочь Лиону пережить его боль, чего бы это ни стоило, на этот раз.",shape=box,color=blue];
