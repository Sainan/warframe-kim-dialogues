	248 [label="Мне интересно… Сколько сражений я бы вычеркнул из истории и переделал, если бы обладал такой силой?",shape=box,color=blue];
		248 -> 263;
	249 [label="Update boolean DrifterLyon",color=orange];
		249 -> 264;
	250 [label="Update boolean DrifterMarie",color=orange];
		250 -> 265;
	251 [label="Update boolean DrifterRoathe",color=orange];
		251 -> 266;
	247 [label="Скольких душ я бы покорил, имея твои дарования в своём распоряжении?",shape=box,color=blue];
		247 -> 262;
	252 [label="Итак… Погоди. Я запутался. Как и когда Энтрати превратил тебя в протофрейм?",shape=box,color=red];
		252 -> 267;
	253 [label="Ты. Погоди. Ты сделал что?!",shape=box,color=red];
		253 -> 268;
	254 [label="У Лиона… слишком много дел, с которыми нужно разобраться. И я не знаю, как пробиться сквозь всё это.",shape=box,color=red];
		254 -> 269;
	256 [label="У меня к нему чувства…",shape=box,color=red];
		256 -> 249;
	255 [label="Я пытаюсь уговорить тебя и остальных помочь мне воссоединить Лойда с семьёй наверху, и… у меня тогда не получилось....",shape=box,color=red];
		255 -> 224;
	257 [label="Она не хочет видеть Энтрати таким, какой он есть. Все попытки донести до неё правду остаются безуспешными.",shape=box,color=red];
		257 -> 270;
	259 [label="Я испытываю к ней чувства…",shape=box,color=red];
		259 -> 250;
	258 [label="Я пытаюсь уговорить тебя и остальных помочь мне воссоединить Лойда с семьёй наверху, и… у меня тогда не получилось....",shape=box,color=red];
		258 -> 224;
	260 [label="Ну, понимаешь, у тебя есть целая история о том, зачем ты принял сыворотку, а мне… как-то удалось всё испортить…",shape=box,color=red];
		260 -> 225;
	261 [label="[Признаться в чувствах.] Это… это действительно неловко, но я…",shape=box,color=red];
		261 -> 251;
	263 [label="Скольких душ я бы покорил, имея твои дарования в своём распоряжении?",shape=box,color=blue];
		263 -> 5737;
	264 [label="+5 Chemistry",color=orange];
		264 -> 272;
	265 [label="+5 Chemistry",color=orange];
		265 -> 273;
	266 [label="+5 Chemistry",color=orange];
		266 -> 274;
	262 [label="Во-вторых, меня охватывает немедленный гнев и ярость от осознания того, что с моим разумом дважды поиграли в недавней истории. Но есть и другое чувство, которое побеждает этот гнев. Чувство, которое я пока не совсем понимаю.",shape=box,color=blue];
		262 -> 271;
	267 [label="Я не знаю подробностей, поскольку эти воспоминания, как и многие другие, стёрты из моей памяти из-за той трансформации, которую он мне навязал.",shape=box,color=blue];
		267 -> 275;
	268 [label="Да! Именно! С образцами моей собственной крови, ни больше ни меньше! Я начал не в том же году, когда мы вышли, уж поверь! Клянусь Бездной, я сдеру с него плоть этими своими новыми когтями, как только увижу его глупую, самодовольную рожу…",shape=box,color=blue];
		268 -> 276;
	269 [label="Я бы посоветовал простое терпение, но… далёк я от мысли советовать тебе пользоваться зубилом, когда есть лазер.",shape=box,color=blue];
		269 -> 277;
	270 [label="+5 Chemistry",color=orange];
		270 -> 278;
	5737 [label="Second, I am struck by the immediate fury and anger at knowing that my mind has been trifled with not once but twice in recent history. But there is another emotion that comes to defeat the anger. One I do not quite yet understand.",shape=box,color=blue];
		5737 -> 5740;
	272 [label="Во-первых: я впечатлён! Ты отнимаешь у нас все воспоминания, чтобы ещё раз попытаться завоевать его любовь?!",shape=box,color=blue];
		272 -> 280;
	273 [label="Во-первых: я впечатлён! Ты отнимаешь у нас все воспоминания, чтобы ещё раз попытаться завоевать её любовь?!",shape=box,color=blue];
		273 -> 281;
	274 [label="О, это просто волшебно! Ты уничтожаешь все наши воспоминания, пытаясь ещё раз завоевать моё расположение?!",shape=box,color=blue];
		274 -> 282;
	271 [label="Предательство.",shape=box,color=blue];
		271 -> 279;
	275 [label="Но у меня всплывают отрывки воспоминаний. Осколки золотого коридора. Голос, который я узнавал, но не лицо. Это был Альбрехт, но не тот, которого я знал.",shape=box,color=blue];
		275 -> 283;
	276 [label="Позволь мне успокоиться.",shape=box,color=blue];
		276 -> 284;
	277 [label="Я сижу здесь, и два момента сразу бросаются в глаза, как только моё подозрение подтверждается.",shape=box,color=blue];
		277 -> 285;
	278 [label="Хм, вижу. Благородное начинание, если честно. Которое я сам неоднократно пытался осуществить. И столь же часто терпел неудачу.",shape=box,color=blue];
		278 -> 286;
	5740 [label="Betrayal.",shape=box,color=blue];
		5740 -> 5741;
	280 [label="Как же это в духе Орокин!",shape=box,color=blue];
		280 -> 288;
	281 [label="Как же это в духе Орокин!",shape=box,color=blue];
		281 -> 289;
	282 [label="Как же это в духе Орокин!",shape=box,color=blue];
		282 -> 290;
	279 [label="Почему?",shape=box,color=blue];
		279 -> 287;
	283 [label="Обжигающая, палящая боль. Не похожая ни на что, что я когда-либо испытывал прежде. Моё прежнее тело лишилось руки и ноги в результате взрыва на войне, Скиталец. Меня покрывали ожоги, от которых я не смог бы оправиться, если бы не Кува. Я познал агонию.",shape=box,color=blue];
		283 -> 291;
	284 [label="Благодарю. Можно начинать.",shape=box,color=blue];
		284 -> 292;
	285 [label="Мне интересно… Сколько сражений я бы вычеркнул из истории и переделал, если бы обладал такой силой?",shape=box,color=blue];
		285 -> 293;
	286 [label="Я сижу здесь, и два момента сразу бросаются в глаза, как только моё подозрение подтверждается.",shape=box,color=blue];
		286 -> 294;
	5741 [label="Why?",shape=box,color=blue];
		5741 -> 5742;
	288 [label="Второе: твоя неуклюжесть просто поразительна! Я почти уверен, что если бы ты просто кормил и поил Священника раз в день, он бы одарил тебя безграничной любовью и обожанием.",shape=box,color=blue];
		288 -> 296;
	289 [label="Второе: у тебя не возникла идея, например, прихрамывать перед ней? Притворяться, что плохое здоровье? Строить глазки? Или просто сказать, что она хорошо выглядит? Кажется, она не так уж и труднодоступна.",shape=box,color=blue];
		289 -> 297;
	290 [label="Я сижу здесь, и два момента сразу бросаются в глаза, как только моё подозрение подтверждается.",shape=box,color=blue];
		290 -> 298;
	287 [label="Но это разговор на другой день. У меня есть предложение для тебя, и я уверен, оно вызовет у тебя гораздо больший интерес.",shape=box,color=blue];
		287 -> 295;
	291 [label="Моё тело разрывалось на части и пересобиралось. Силой. Я не выбирал этого. Не знаю, было ли так же с остальными.",shape=box,color=blue];
		291 -> 299;
	292 [label="Я восстанавливал структуру Гельминта, используя образцы собственной крови, методом проб и ошибок. Задача была не из лёгких, учитывая отсутствие доступа к оборудованию Орокин. Да и вообще к какому-либо оборудованию, кроме того, что я смог украсть у…",shape=box,color=blue];
		292 -> 300;
	293 [label="Скольких душ я бы покорил, имея твои дарования в своём распоряжении?",shape=box,color=blue];
		293 -> 301;
	294 [label="Мне интересно… Сколько сражений я бы вычеркнул из истории и переделал, если бы обладал такой силой?",shape=box,color=blue];
		294 -> 302;
	5742 [label="But that is a conversation for another day. For I have a proposal for you. One I believe you will be far more interested in.",shape=box,color=blue];
		5742 -> 5739;
	296 [label="Не пойми меня неправильно! Я весьма впечатлён твоей хитроумностью.",shape=box,color=blue];
		296 -> 304;
	297 [label="Третье: я сижу здесь и внезапно ощущаю, как меня захлёстывают эпизоды осознания, подтверждающие мои подозрения.",shape=box,color=blue];
		297 -> 305;
	298 [label="Мне интересно… Сколько сражений я бы вычеркнул из истории и переделал, если бы обладал такой силой?",shape=box,color=blue];
		298 -> 306;
	295 [label="Я прикинусь, что ничего не знаю, перед фанатиками ради тебя…",shape=box,color=blue];
		295 -> 303;
	299 [label="Я помню холодные ступени под собой, когда меня на них бросили. То были Соборные ступени, теперь я знаю это, как рассказали мне Лион и Мари, вспоминая события.",shape=box,color=blue];
		299 -> 307;
	300 [label="I will not do them the favor of calling them \"rudimentary\" hospitals. Albrecht had used a Helminth to transport us to the past. How it had grown in the past I do not know, as it had to have been there already for us to arrive. It withered and died in the process - I suspected another could be used for a return trip.",shape=box,color=blue];
		300 -> 308;
	301 [label="Во-вторых, меня охватывает немедленный гнев и ярость от осознания того, что с моим разумом дважды поиграли в недавней истории. Но есть и другое чувство, которое побеждает этот гнев. Чувство, которое я пока не совсем понимаю.",shape=box,color=blue];
		301 -> 309;
	302 [label="Скольких душ я бы покорил, имея твои дарования в своём распоряжении?",shape=box,color=blue];
