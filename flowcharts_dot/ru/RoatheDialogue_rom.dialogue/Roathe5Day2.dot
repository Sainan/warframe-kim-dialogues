	j3756287296 [label="Типично.",shape=box,color=red];
		j3756287296 -> j2708237628;
	j696392352 [label="Погоди. Что?!",shape=box,color=red];
		j696392352 -> j3313446191;
	j917333643 [label="Тобой была обещана мне помощь, если я помогу тебе восстановить память. И моя часть была выполнена. Таков был наш уговор!",shape=box,color=red];
		j917333643 -> j3376785069;
	j397571730 [label="Подожди. Почему ты мне не помогаешь?",shape=box,color=red];
		j397571730 -> j3376785069;
	j3489791483 [label="Ничего.",shape=box,color=blue];
		j3489791483 -> "Chat ends.";
	j712218402 [label="Я уверен, что буду чудовищно зол на тебя, как только пойму, что тобой были изменены мои воспоминания, разумеется. И я советую не говорить мне, что это было по моей просьбе, дорогуша.",shape=box,color=blue];
		j712218402 -> j561582545;
