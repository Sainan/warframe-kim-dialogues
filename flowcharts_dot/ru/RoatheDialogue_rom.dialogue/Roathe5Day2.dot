	j3219193090 [label="Boolean IsDating is now false.",color=orange];
		j3219193090 -> j577177352;
	j2708237628 [label="Не расстраивайся так только потому, что теперь ты понимаешь, что тебя переиграли. Я предложил тебе условия контракта, даже не изложив свою точку зрения. Или это прошло мимо тебя?",shape=box,color=blue];
		j2708237628 -> j3406907585;
	j3313446191 [label="Я предложил тебе условия контракта, даже не изложив свою точку зрения. Или это прошло мимо тебя?",shape=box,color=blue];
		j3313446191 -> j3406907585;
	j3376785069 [label="«Мне нужен кто-то, кто поможет мне записывать мои воспоминания и согласовывать их. Что-то вроде временного помощника.»",shape=box,color=blue];
		j3376785069 -> j2458313448;
	j561582545 [label="Я просто заявлю, что ты лжёшь, и это, вероятно, испортит моё мнение о тебе до неузнаваемости.",shape=box,color=blue];
		j561582545 -> j3985673461;
		j561582545 -> j3201746288;
	j544361067 [label="Каждый раз, когда мы говорим, я не могу не задаваться вопросом, знакомы ли тебе берега, по которым мы ступаем, или они для тебя чужие. Повторяю ли я себя или всё ещё несу в себе нечто новое.",shape=box,color=blue];
		j544361067 -> j748371221;
	j3483803898 [label="Условия контракта с твоей стороны были соблюдены. Мы подошли к предпоследней стадии, и теперь предстоит разобрать детали того, каким образом будет выстроена наша схема атаки.",shape=box,color=blue];
		j3483803898 -> j4150695716;
	j577177352 [label="Boolean RoatheDating is now false.",color=orange];
		j577177352 -> j2718119847;
	j3406907585 [label="Я лишь сказал, что ты получишь от этого соглашения. Я ни разу не говорил, что именно тебе придется сделать или зачем, чтобы это получить. А от тебя последовало слепое согласие.",shape=box,color=blue];
		j3406907585 -> j490970187;
	j2458313448 [label="Хотя первый критерий был выполнен, а именно «запись моих воспоминаний», но с полным провалом тобой не была выполнена «помощь в их примирении».",shape=box,color=blue];
		j2458313448 -> j1209670449;
	j3985673461 [label="Нет. Я не способен на это. Я не стану это делать. Нам нужно вместе встретить эту ситуацию лицом к лицу. Может, мы просто обсудим это?",shape=box,color=red];
		j3985673461 -> j2683683069;
	j3201746288 [label="Я... неужели действительно больше нет иного выхода?",shape=box,color=red];
		j3201746288 -> j2683683069;
	j748371221 [label="В любом случае, я бы не хотел об этом знать. Я ненавижу, когда я слишком предсказуем. В любом случае, твоя помощь оказалась решающей для вопроса, крайне важного для меня самого. ",shape=box,color=blue];
		j748371221 -> j923432791;
	j4150695716 [label="Эта битва должна вестись на трех фронтах. Все должно действовать согласованно, чтобы эта война была выиграна.",shape=box,color=blue];
		j4150695716 -> j3359311065;
		j4150695716 -> j84888033;
	j2718119847 [label="Что ж, что бы тебе ни хотелось от меня, сейчас ты этого не получишь. Тебе лучше покончить с этим и очистить мою память от этого нашего позора, «сокровище Скиталец».",shape=box,color=blue];
		j2718119847 -> j3732202509;
	j490970187 [label="Полагаю, это то, что в старину называли «пустым чеком». И он был подписан вполне добровольно.",shape=box,color=blue];
		j490970187 -> j1414284106;
		j490970187 -> j1271946955;
	j1209670449 [label="Я бы вряд ли сказал, что они помирились, так же?",shape=box,color=blue];
		j1209670449 -> j1492915621;
	j2683683069 [label="Нет. Если ты хочешь, чтобы дворецкий поднялся наверх? Сотри из моей памяти всё это безумие, как я и просил. Если тебе всё равно? Тогда делай как хочешь. Для меня это не имеет значения.",shape=box,color=blue];
		j2683683069 -> j2679298356;
	j923432791 [label="Я спал прошлой ночью лучше, чем за многие годы. Я бы сказал «дольше, чем могу вспомнить», но это была бы шутка крайне дурного вкуса.",shape=box,color=blue];
		j923432791 -> j1667133062;
	j3359311065 [label="Что, прости?",shape=box,color=red];
		j3359311065 -> j402779149;
	j84888033 [label="Мы говорим о Лойде?",shape=box,color=red];
		j84888033 -> j2638501927;
	j3732202509 [label="Для тебя это будет единственным шагом вперед, если именно этого ты ищешь. Если тебе нет дела, то и мне нет дела. Поступай по как хочешь.",shape=box,color=blue];
		j3732202509 -> j2100574820;
	j1414284106 [label="Есть ли хоть малейший шанс, что я смогу переубедить тебя?",shape=box,color=red];
		j1414284106 -> j1463039195;
	j1271946955 [label="Как мне из этого выбраться?",shape=box,color=red];
		j1271946955 -> j45819103;
	j1492915621 [label="Твоя часть соглашения тобой выполнена не была, следовательно, и моя выполнена не будет.",shape=box,color=blue];
		j1492915621 -> j1414284106;
		j1492915621 -> j196311977;
	j2679298356 [label="Это и, ну, конечно, наше личное дружеское отношение — единственный рычаг, который у меня есть в этой ситуации. Всё действительно так просто.",shape=box,color=blue];
		j2679298356 -> j427811603;
	j1667133062 [label="И в свою очередь я теперь помогу тебе. Этот дворецкий. Ты все ещё хочешь вернуть его к семье Альбрехта наверху?",shape=box,color=blue];
		j1667133062 -> j744968765;
	j402779149 [label="Дворецкий. Его возвращение к семье Альбрехта. Ты всё ещё хочешь этого, верно?",shape=box,color=blue];
		j402779149 -> j1949841813;
	j2638501927 [label="Да. Постарайся не отставать. Я полагаю, ты всё ещё хочешь вернуть его к семье Альбрехта наверху, да?",shape=box,color=blue];
		j2638501927 -> j1949841813;
	j1463039195 [label="Нет. И у меня больше нет ни малейшего желания помогать тебе в подобном.",shape=box,color=blue];
		j1463039195 -> "Initiate conversation LyonRoatheFail in /Lotus/Types/Gameplay/1999Wf/Dialogue/LyonDialogue_rom.dialogue";
	j45819103 [label="Тем же самым образом, каким это произошло с самого начала.",shape=box,color=blue];
		j45819103 -> j136786926;
	j196311977 [label="Как мне из этого выбраться?",shape=box,color=red];
		j196311977 -> j434957283;
	j427811603 [label="Что ты скажешь?",shape=box,color=blue];
		j427811603 -> j4032046539;
		j427811603 -> j390831430;
