	j2100574820 [label="И не пытайся подсылать ко мне ревнителей веры, чтобы они канючили у меня под боком, вымаливая тебе милость. Ничего у них не выйдет.",shape=box,color=blue];
		j2100574820 -> "Chat ends.";
	j2292931540 [label="Это воспоминания другого рода, Роут. С ними это не сработает. Они глубоко запрятаны в твоей психике.",shape=box,color=red];
		j2292931540 -> j1988636974;
	j4108029105 [label="Бегство и попытки спрятаться от правды не сработают. В итоге мы просто вернемся туда, откуда начали. ",shape=box,color=red];
		j4108029105 -> j1651430426;
	j905429861 [label="Ты уверен? Просто... ты сообразительный, и у меня такое чувство, что ты всё равно поймешь, что что-то тут не так.",shape=box,color=red];
