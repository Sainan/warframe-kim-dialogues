		j567952179 -> j2989953447;
	j3442821702 [label="Можешь также попрощаться с нашим другим соглашением.",shape=box,color=blue];
		j3442821702 -> j3756287296;
		j3442821702 -> j696392352;
	j528059427 [label="Мне даже было любопытно посмотреть, как он будет трястись от ужаса, ползая вверх по тем ступеням в стыде.",shape=box,color=blue];
		j528059427 -> j917333643;
		j528059427 -> j397571730;
	j2445327249 [label="Но что тебе до этого?",shape=box,color=blue];
		j2445327249 -> j3489791483;
	j1988636974 [label="Может быть. Скорее всего ты действительно прав. Но других путей у меня всё равно нет, не так ли? Значит, стоит хотя бы попробовать.",shape=box,color=blue];
		j1988636974 -> j712218402;
	j1651430426 [label="И если всё так, тогда ты просто сможешь сделать это снова. У тебя будто неиссякаемый дар, не так ли?",shape=box,color=blue];
		j1651430426 -> j712218402;
	j697910692 [label="Очень вероятно. Я сопоставлю факты и обвиню тебя в том, что ты сделал то, о чём я тебя не просил. Уверен, ты переживёшь этот трудный период.",shape=box,color=blue];
		j697910692 -> j712218402;
	j4041561274 [label="Мм, да, ну что ж. Я знаю, как сильно тебе нравится этот мой «острый хвостик». ",shape=box,color=blue];
		j4041561274 -> j2665556245;
	j3382741515 [label="Я просто хотел выразить свою благодарность. Не буду на этом задерживаться.",shape=box,color=blue];
		j3382741515 -> j4081414586;
	j1762190448 [label="Теперь, когда мы с этим покончили, я полагаю, нам есть что ещё обсудить, не так ли?",shape=box,color=blue];
		j1762190448 -> j1466456391;
	j1311246052 [label="Check boolean RoatheDating",color=orange];
		j1311246052 -> j3219193090 [label=true,color=green];
		j1311246052 -> j1384616734 [label=false,color=brown];
