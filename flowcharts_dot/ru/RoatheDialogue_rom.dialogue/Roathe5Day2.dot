		j915087833 -> j92161912;
	j2957584214 [label="Прекрасно. И не стоит думать, что прежняя договорённость забыта. Было дано обещание разобраться с этим беспорядком, и так оно и будет. Как и было предсказано, помощь понадобилась.",shape=box,color=blue];
