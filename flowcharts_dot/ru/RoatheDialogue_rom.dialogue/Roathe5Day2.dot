	j4072107213 [label="Add 1 to Promise counter",color=orange];
		j4072107213 -> j302033967;
	j915087833 [label="Не остаётся ничего, кроме как взмахнуть руками и уйти, иначе от раздражения можно вырвать себе все волосы.",shape=box,color=blue];
		j915087833 -> j92161912;
	j2957584214 [label="Прекрасно. И не стоит думать, что прежняя договорённость забыта. Было дано обещание разобраться с этим беспорядком, и так оно и будет. Как и было предсказано, помощь понадобилась.",shape=box,color=blue];
		j2957584214 -> j2047351097;
	j1028374098 [label="Хорошая работа с привлечением поддержки фанатиков. Мари и Лион будут бесценны, как бы ни не хотелось это признавать.",shape=box,color=blue];
		j1028374098 -> j1931379847;
	j2724845416 [label="Он отчаянно упрям, и без скоординированной атаки не обойтись. Рекомендуется действовать осторожно и сделать всё возможное, чтобы в нужный момент заручиться поддержкой обоих фанатиков. ",shape=box,color=blue];
		j2724845416 -> j1801542139;
