		j2304643196 -> j3385732763 [label="RoatheFailStall",color=purple];
		j2304643196 -> j2283197743 [label="false",color=purple];
	j2791821249 [label="And here we are, twiddling our thumbs. Either you truly have nothing better to do, Usurper, or you have all that you want from me. Which is it?",shape=box,color=blue];
		j2791821249 -> j134617919;
		j2791821249 -> j2168037976;
		j2791821249 -> j1326913798;
	j617454213 [label="Evaluate expressions on HellStory counter",color=orange];
		j617454213 -> j3401265586 [label="x >= 21",color=purple];
		j617454213 -> "Chat ends." [label="x <= 21",color=purple];
		j617454213 -> "Chat ends." [label="false",color=purple];
	j2338384480 [label="A new day dawns, and I find myself planning for the future for the first time in... a long time. Thinking on how I could reshape this world around me. On how I could wield what I know. What I am. How I could make better use of it.",shape=box,color=blue];
		j2338384480 -> j3984658869;
	j4205868229 [label="A new day dawns, and I find myself planning for the future for the first time in... a long time. Thinking on what this means for me, for what I want, for how I wish to reshape my environment to suit me.",shape=box,color=blue];
		j4205868229 -> j2558396776;
	j1521830949 [label="May I ask precisely what it is you are waiting for? I sit here with my recollection of events still perfectly intact. You gave me your word that you would clear them from my mind.",shape=box,color=blue];
		j1521830949 -> j3556672345;
		j1521830949 -> j1942198326;
		j1521830949 -> j2332710454;
	j3385732763 [label="Have you made up your mind yet? I am a patient devil, but I have my limits. Will you wipe my mind clean of these memories, or do you wish to let me linger on?",shape=box,color=blue];
		j3385732763 -> j684607746;
		j3385732763 -> j703203293;
	j2283197743 [label="Here we are, and here we shall remain. In this Purgatory. I hope you enjoy it here, as I do not think we shall ever go a step farther.",shape=box,color=blue];
		j2283197743 -> j2171950327;
	j134617919 [label="What do you mean?",shape=box,color=red];
		j134617919 -> j3992815676;
	j2168037976 [label="A little from column A, a little from column B?",shape=box,color=red];
		j2168037976 -> j2417391013;
	j1326913798 [label="None of this is about you, Roathe. It never has been.",shape=box,color=red];
		j1326913798 -> j2141906348;
	j3401265586 [label="You fool! What have you done?! Why, why go and delve into caverns where you are not welcome?!",shape=box,color=blue];
		j3401265586 -> j4285424905;
	"Chat ends." [color=orange];
	j3984658869 [label="Check boolean RoatheDating",color=orange];
		j3984658869 -> j3974734044 [label=true,color=green];
		j3984658869 -> j1415211089 [label=false,color=brown];
	j2558396776 [label="Check boolean RoatheDating",color=orange];
		j2558396776 -> j3838177785 [label=true,color=green];
		j2558396776 -> j87369137 [label=false,color=brown];
	j3556672345 [label="I know. But these things take time, and we need to wait.",shape=box,color=red];
		j3556672345 -> j325588956;
	j1942198326 [label="I changed my mind. I'm sorry.",shape=box,color=red];
		j1942198326 -> j1226837478;
	j2332710454 [label="I will. I'm getting there. I promise.",shape=box,color=red];
		j2332710454 -> j279253026;
	j684607746 [label="No. I can't do this. I'm sorry. I can't do this to you.",shape=box,color=red];
		j684607746 -> j1991436428;
	j703203293 [label="Fine. I give in. I'll do what you want.",shape=box,color=red];
		j703203293 -> j2921449333;
	j2171950327 [label="Check boolean LoidFamilyComplete",color=orange];
		j2171950327 -> j310929033 [label=true,color=green];
		j2171950327 -> j122138272 [label=false,color=brown];
	j3992815676 [label="Whatever you seek from me, you shall not have it now. You might as well be done with it and wipe my memory clean of this travesty of ours.",shape=box,color=blue];
		j3992815676 -> j1478268251;
	j2417391013 [label="Well, whatever you seek from me, you shall not have it now. You might as well be done with it and wipe my memory clean of this travesty of ours.",shape=box,color=blue];
		j2417391013 -> j1478268251;
	j2141906348 [label="That is quite clear, you needn't worry.",shape=box,color=blue];
		j2141906348 -> "Chat ends.";
	j4285424905 [label="I demand you fix this. This is your fault. I can feel it, clawing at me, tearing at me. Like some great beast.",shape=box,color=blue];
		j4285424905 -> j1868770690;
	j3974734044 [label="It would be poor form to not acknowledge that this is due to your help, darling. Thank you.",shape=box,color=blue];
		j3974734044 -> j823125180;
		j3974734044 -> j2833478379;
	j1415211089 [label="It would be poor form to not acknowledge that this is due to your help, Usurper. Thank you.",shape=box,color=blue];
		j1415211089 -> j693488537;
		j1415211089 -> j3561873533;
	j3838177785 [label="It would be poor form to not acknowledge that this is due largely to your help, darling.",shape=box,color=blue];
		j3838177785 -> j741140548;
		j3838177785 -> j240549449;
	j87369137 [label="It would be poor form to not acknowledge that this is due largely to your help, Usurper.",shape=box,color=blue];
		j87369137 -> j384744226;
		j87369137 -> j2000954999;
	j325588956 [label="Mm. Very well. I am a patient devil, but the waters of that well can be exhausted over time, trust me.",shape=box,color=blue];
		j325588956 -> "Chat ends.";
	j1226837478 [label="I see. As simple as that, is it?",shape=box,color=blue];
		j1226837478 -> j431793363;
	j279253026 [label="Mm. See that you do. I am a patient devil, but the waters of that well can be exhausted over time, trust me.",shape=box,color=blue];
		j279253026 -> "Chat ends.";
	j1991436428 [label="Even if it means we are trapped forever in this impasse? You poor, sad Usurper... very well. Purgatory is an improvement over Hell for a devil, is it not?",shape=box,color=blue];
		j1991436428 -> j3531477191;
	j2921449333 [label="Good. Get to it. I tire of living with this knowledge in my skull.",shape=box,color=blue];
		j2921449333 -> j378811769;
	j310929033 [label="Though, what does it matter to you? You have all that you wish to cut from my empty corpse. My ribs are bare and bleached.",shape=box,color=blue];
		j310929033 -> j1776100240;
	j122138272 [label="Tragic, isn't it? Knowing that the dregs of Entrati's family will never know that the butler moulders down here, wringing his hands in grief? All alone?",shape=box,color=blue];
		j122138272 -> j1776100240;
	j1478268251 [label="It will be the only way forward for you, if that is what you seek. If you care not, then I care not. Do what you will.",shape=box,color=blue];
		j1478268251 -> j1063490160;
	j1868770690 [label="Rid me of this. Rid me of this plague. Clear my mind of these memories. I know you can. Use this gift that you have and end it all. Now.",shape=box,color=blue];
		j1868770690 -> j2117701808;
		j1868770690 -> j1088756539;
		j1868770690 -> j717799577;
	j823125180 [label="I couldn't leave you chasing that pointy tail of yours forever.",shape=box,color=red];
		j823125180 -> j220025886;
	j2833478379 [label="You're welcome.",shape=box,color=red];
		j2833478379 -> j2665556245;
	j693488537 [label="I couldn't leave you chasing that pointy tail of yours forever. It was going to get sad.",shape=box,color=red];
		j693488537 -> j140282531;
	j3561873533 [label="You're welcome.",shape=box,color=red];
		j3561873533 -> j578416406;
	j741140548 [label="Largely? If it weren't for me, you'd still be stuck chasing that pointy tail of yours, Roathe.",shape=box,color=red];
		j741140548 -> j14367642;
	j240549449 [label="You're welcome.",shape=box,color=red];
		j240549449 -> j837377030;
