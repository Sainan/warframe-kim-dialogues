		j3389899019 -> j2957584214 [label=true,color=green];
		j3389899019 -> j2526759011 [label=false,color=brown];
	j2189089232 [label="Превосходно. Поддержка будет обеспечена в нужный момент. Но процесс окажется долгим. Дворецкий отчаянно упрям, и без слаженного наступления здесь не справиться.",shape=box,color=blue];
		j2189089232 -> j1028374098;
	j3866975555 [label="Великолепно. Поддержка будет предоставлена, когда это станет необходимо, однако стоит учесть одно. Понадобится, чтобы оба фанатика действовали в согласии с усилиями, чтобы убедить дворецкого подняться по этим ступеням.",shape=box,color=blue];
		j3866975555 -> j2724845416;
	j2414420943 [label="Великолепно. Поддержка будет предоставлена, когда это станет необходимо, однако стоит учесть одно. Понадобится, чтобы оба фанатика действовали в согласии с усилиями, чтобы убедить дворецкого подняться по этим ступеням.",shape=box,color=blue];
		j2414420943 -> j38825242;
	j984880483 [label="Великолепно. Поддержка будет предоставлена, когда это станет необходимо, однако стоит учесть одно. Понадобится, чтобы оба фанатика действовали в согласии с усилиями, чтобы убедить дворецкого подняться по этим ступеням.",shape=box,color=blue];
		j984880483 -> j2456900362;
	j2526759011 [label="Прекрасно. Будет сделано всё возможное, чтобы убрать этот беспорядок. Но стоит понимать, что возможности ограничены. Расчищать путь и выполнять работу это две разные вещи.",shape=box,color=blue];
		j2526759011 -> "Initiate conversation LyonRoatheRepair in /Lotus/Types/Gameplay/1999Wf/Dialogue/LyonDialogue_rom.dialogue";
	j1797805827 [label="Великолепно. Поддержка будет предоставлена, когда это станет необходимо, однако стоит учесть одно. Понадобится, чтобы оба фанатика действовали в согласии с усилиями, чтобы убедить дворецкого подняться по этим ступеням.",shape=box,color=blue];
