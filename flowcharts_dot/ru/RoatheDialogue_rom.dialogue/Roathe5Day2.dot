		j3445462174 -> "Initiate conversation LyonRoatheFail in /Lotus/Types/Gameplay/1999Wf/Dialogue/LyonDialogue_rom.dialogue";
	j3110653244 [label="+10 Chemistry",color=orange];
		j3110653244 -> j3831937857;
	j467753549 [label="От всей души желаю тебе удачи.",shape=box,color=blue];
		j467753549 -> "Initiate conversation LyonRoatheFail in /Lotus/Types/Gameplay/1999Wf/Dialogue/LyonDialogue_rom.dialogue";
	j1773271505 [label="Тобою было сделано так много, проделан такой путь, и теперь вдруг решаешь, что...",shape=box,color=blue];
		j1773271505 -> j1947150923;
	j3279363264 [label="Как, во имя Бездны, вообще удалось испортить всё сразу с ними обоими?!",shape=box,color=blue];
