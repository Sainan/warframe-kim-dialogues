	j2189089232 [label="Превосходно. Поддержка будет обеспечена в нужный момент. Но процесс окажется долгим. Дворецкий отчаянно упрям, и без слаженного наступления здесь не справиться.",shape=box,color=blue];
		j2189089232 -> j1028374098;
	j3866975555 [label="Великолепно. Поддержка будет предоставлена, когда это станет необходимо, однако стоит учесть одно. Понадобится, чтобы оба фанатика действовали в согласии с усилиями, чтобы убедить дворецкого подняться по этим ступеням.",shape=box,color=blue];
