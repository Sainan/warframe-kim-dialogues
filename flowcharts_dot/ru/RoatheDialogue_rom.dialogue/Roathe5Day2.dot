	j136786926 [label="Или, возможно, нужна новая методика. Я не здесь для того, чтобы помогать тебе в таких делах.",shape=box,color=blue];
		j136786926 -> "Initiate conversation LyonRoatheFail in /Lotus/Types/Gameplay/1999Wf/Dialogue/LyonDialogue_rom.dialogue";
	j434957283 [label="Думаю, ты знаешь как. Но если память тебе изменила, позволь напомнить тебе... как там звучала эта фраза?",shape=box,color=blue];
		j434957283 -> j3445462174;
	j4032046539 [label="Ладно. Я... я сделаю это. Я сотру твою память. Даже если вместе с этим исчезнут воспоминания о Мари и Лионе.",shape=box,color=red];
		j4032046539 -> j3110653244;
	j390831430 [label="Нет. Я отказываюсь. Я найду иной путь, чтобы убедить тебя продолжить свой путь.",shape=box,color=red];
		j390831430 -> j467753549;
	j678122280 [label="Нет, всё нормально. Для меня это не имеет большого значения.",shape=box,color=red];
		j678122280 -> j1773271505;
	j392197989 [label="Жаль, но Мари и Лион точно не будут в этом участвовать.",shape=box,color=red];
		j392197989 -> j3279363264;
	j1988712045 [label="Не знаю, согласится ли на это Мари.",shape=box,color=red];
		j1988712045 -> j2303292631;
	j788703230 [label="Не знаю, согласится ли на это Лион.",shape=box,color=red];
		j788703230 -> j2303292631;
	j2578322904 [label="Да. Я хочу этого.",shape=box,color=red];
		j2578322904 -> j3002674689;
	j252998806 [label="Не верю, что Мари или Лион поддержат такую идею.",shape=box,color=red];
		j252998806 -> j3969939723;
	j2579748136 [label="Не знаю, согласится ли на это Мари.",shape=box,color=red];
		j2579748136 -> j1161885628;
	j498137311 [label="Не знаю, согласится ли на это Лион.",shape=box,color=red];
