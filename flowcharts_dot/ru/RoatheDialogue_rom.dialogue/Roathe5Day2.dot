		j434957283 -> j3445462174;
	j4032046539 [label="Ладно. Я... я сделаю это. Я сотру твою память. Даже если вместе с этим исчезнут воспоминания о Мари и Лионе.",shape=box,color=red];
		j4032046539 -> j3110653244;
