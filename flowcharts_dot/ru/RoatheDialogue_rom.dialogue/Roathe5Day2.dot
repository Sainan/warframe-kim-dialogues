		j2304643196 -> j4294736027 [label="false",color=purple];
	j65042321 [label="И вот мы сидим, сложа руки. Либо тебе действительно нечем заняться, Узурпатор, либо тобой было получено от меня всё, что тебе хотелось. Что из этого верно?",shape=box,color=blue];
		j65042321 -> j3729765813;
		j65042321 -> j1030263744;
		j65042321 -> j4017562814;
	j617454213 [label="Evaluate expressions on HellStory counter",color=orange];
		j617454213 -> j45219765 [label="x >= 21",color=purple];
		j617454213 -> "Chat ends." [label="x <= 21",color=purple];
		j617454213 -> "Chat ends." [label="false",color=purple];
	j429310369 [label="Наступает новый день, и впервые за... очень долгое время я ловлю себя на том, что начинаю планировать будущее. Думаю о том, что это значит для меня, чего я хочу, как мне изменить своё окружение так, чтобы оно соответствовало мне. Размышляю о том, как можно изменить окружающий меня мир. Как применить то, что мне известно. То, чем я являюсь. Как извлечь из этого больше пользы.",shape=box,color=blue];
		j429310369 -> j3984658869;
	j616471653 [label="Наступает новый день, и впервые за... очень долгое время я ловлю себя на том, что начинаю планировать будущее. Думаю о том, что это значит для меня, чего я хочу, как мне изменить своё окружение так, чтобы оно соответствовало мне.",shape=box,color=blue];
		j616471653 -> j2558396776;
	j1918086281 [label="Могу ли я спросить, чего именно ты ждешь? Я сижу здесь, и мои воспоминания о произошедшем по-прежнему совершенно ясны. Тобой было дано слово, что ты очистишь мою память от них.",shape=box,color=blue];
		j1918086281 -> j2389228488;
		j1918086281 -> j2155036798;
		j1918086281 -> j1627858562;
	j2371439673 [label="Решение уже принято? Я умею ждать, как и подобает дьяволу, но всему есть границы. Ты очистишь мой разум от этих воспоминаний, или хочешь, чтобы я и дальше задерживался здесь?",shape=box,color=blue];
		j2371439673 -> j3182137513;
		j2371439673 -> j3519414891;
	j4294736027 [label="Вот мы и здесь, и здесь же мы останемся. В этом Чистилище. Я надеюсь, что тебе здесь по душе, потому что я не думаю, что мы когда-нибудь сделаем хоть шаг дальше.",shape=box,color=blue];
		j4294736027 -> j2171950327;
	j3729765813 [label="Что ты имеешь в виду?",shape=box,color=red];
		j3729765813 -> j2811593300;
	j1030263744 [label="Немного из столбца А, немного из столбца Б?",shape=box,color=red];
		j1030263744 -> j1384616734;
	j4017562814 [label="Всё это не имеет к тебе никакого отношения, Роут. Никогда не имело.",shape=box,color=red];
		j4017562814 -> j358311382;
	j45219765 [label="Какое же безумие! Зачем это было тобой сделано?! Зачем, зачем идти в эти пещеры, где тебе не рады?!",shape=box,color=blue];
		j45219765 -> j1739392625;
	"Chat ends." [color=orange];
	j3984658869 [label="Check boolean RoatheDating",color=orange];
		j3984658869 -> j1707030813 [label=true,color=green];
		j3984658869 -> j4088647970 [label=false,color=brown];
