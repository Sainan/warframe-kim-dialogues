	j567952179 [label="Boolean RoatheWillReset is now true.",color=orange];
		j567952179 -> j2989953447;
	j3583555670 [label="You can also say farewell to our other contract.",shape=box,color=blue];
		j3583555670 -> j2555690150;
		j3583555670 -> j3586966234;
	j3678452504 [label="I was rather looking forward to watching him shake in terror as he crawled up those stairs in shame.",shape=box,color=blue];
		j3678452504 -> j1641034512;
		j3678452504 -> j1667380365;
	j1859217847 [label="But what does it matter to you?",shape=box,color=blue];
		j1859217847 -> j4142729549;
	j3608727997 [label="That may be. You are very likely right. But I do not have any other options to try, now do I? It is worth the attempt.",shape=box,color=blue];
		j3608727997 -> j1352697846;
	j239267210 [label="And if that is the case, then you can simply do the deed again. It is like you have an inexhaustible gift, isn't it?",shape=box,color=blue];
		j239267210 -> j1352697846;
	j3470693998 [label="Very likely. I will put two and two together and blame you for doing something I did not ask you to do. I am sure you will weather the storm.",shape=box,color=blue];
		j3470693998 -> j1352697846;
	j2774110276 [label="Mm, yes, well. I know how much you enjoy this \"pointy tail\"  of mine. ",shape=box,color=blue];
		j2774110276 -> j2665556245;
	j4120864970 [label="I simply wished to express my gratitude. Not linger on it.",shape=box,color=blue];
		j4120864970 -> j4081414586;
	j4215254519 [label="Now that we have that done, I believe we have something else to discuss, do we not?",shape=box,color=blue];
		j4215254519 -> j1466456391;
	j1311246052 [label="Check boolean RoatheDating",color=orange];
		j1311246052 -> j1853401555 [label=true,color=green];
		j1311246052 -> j2417391013 [label=false,color=brown];
	j2989953447 [label="Boolean RoatheFailStall is now false.",color=orange];
		j2989953447 -> "Chat ends.";
	j2555690150 [label="Typical.",shape=box,color=red];
		j2555690150 -> j1613865946;
	j3586966234 [label="Wait. Why?!",shape=box,color=red];
		j3586966234 -> j168600879;
	j1641034512 [label="You said you'd help if I helped you recovered your memories. And I did. That was our contract!",shape=box,color=red];
		j1641034512 -> j874842218;
	j1667380365 [label="Wait. Why won't you help me?",shape=box,color=red];
		j1667380365 -> j874842218;
	j4142729549 [label="Naught.",shape=box,color=blue];
		j4142729549 -> "Chat ends.";
	j1352697846 [label="I am certain I will be hideously angry at you once I realize you have altered my memories, of course. And I recommend not telling me it was by my request, darling.",shape=box,color=blue];
		j1352697846 -> j2233209589;
	j4081414586 [label="+5 Chemistry",color=orange];
		j4081414586 -> "Chat ends.";
	j1466456391 [label="Check boolean RoatheKnowsReset2",color=orange];
		j1466456391 -> j3058105942 [label=true,color=green];
		j1466456391 -> j1238002096 [label=false,color=brown];
	j1853401555 [label="Boolean IsDating is now false.",color=orange];
		j1853401555 -> j2302720709;
	j1613865946 [label="Don't be so bitter, just because you realize now that you have been outplayed. I offered you the terms of the contract without ever spelling out my end of things. Or did you fail to notice?",shape=box,color=blue];
		j1613865946 -> j1703196075;
	j168600879 [label="I offered you the terms of the contract without ever spelling out my end of things. Or did you fail to notice?",shape=box,color=blue];
		j168600879 -> j1703196075;
	j874842218 [label="\"I am in need of someone to help me record my memories and assist me in reconciling them. A temporary assistant of sorts.\"",shape=box,color=blue];
		j874842218 -> j3679445998;
	j2233209589 [label="I will simply claim you are lying, and it will likely damage my opinion of you beyond repair.",shape=box,color=blue];
		j2233209589 -> j3971392255;
		j2233209589 -> j1296988595;
	j3058105942 [label="Each time we speak I cannot help but wonder if the shores we tread are familiar or foreign to you. If I am merely repeating myself, or if I hold some new surprise.",shape=box,color=blue];
		j3058105942 -> j677388715;
	j1238002096 [label="You upheld your end of our contract. We have now come to the penultimate point where we must arrange the particulars of how we will lay out our method of attack.",shape=box,color=blue];
		j1238002096 -> j2216158498;
	j2302720709 [label="Boolean RoatheDating is now false.",color=orange];
		j2302720709 -> j2553799106;
	j1703196075 [label="I simply said what you would have out of the arrangement. I never said what you had to do, or why, to get them. And you blindly agreed.",shape=box,color=blue];
		j1703196075 -> j337280456;
	j3679445998 [label="While you met the first criteria, \"recording my memories,\" you failed spectacularly at the latter, \"assist me in reconciling them.\"",shape=box,color=blue];
		j3679445998 -> j624933318;
	j3971392255 [label="No. I can't do this. I won't do this. We have to face down this situation together. Can't we just talk about this?",shape=box,color=red];
		j3971392255 -> j4280899041;
	j1296988595 [label="I... there's really no other way?",shape=box,color=red];
		j1296988595 -> j4280899041;
	j677388715 [label="Either way, I rather you not tell me. I hate when I am too overtly predictable. Regardless, you have helped me resolve a matter keenly important to my own self. ",shape=box,color=blue];
		j677388715 -> j2486388606;
	j2216158498 [label="This battle must be waged on three fronts. All must work in concert for this war to be won.",shape=box,color=blue];
		j2216158498 -> j985782477;
		j2216158498 -> j4002654295;
	j2553799106 [label="Well, whatever you seek from me, you shall not have it now. You might as well be done with it and wipe my memory clean of this travesty of ours, \"Drifter darling.\"",shape=box,color=blue];
		j2553799106 -> j1636362832;
	j337280456 [label="This is what is called a \"blank cheque\" in olden terms I believe? And you signed it quite willingly.",shape=box,color=blue];
		j337280456 -> j4138167829;
		j337280456 -> j3786792666;
	j624933318 [label="I would hardly say they are reconciled, would you?",shape=box,color=blue];
		j624933318 -> j1887575000;
	j4280899041 [label="No. If you want the butler to go upstairs? You wipe my mind of all of this nonsense as I have asked. If you do not care? Then do as you wish. It matters not to me.",shape=box,color=blue];
		j4280899041 -> j2092497863;
	j2486388606 [label="I slept better last night than I have in so very long. I would say \"longer than I can remember,\" but that would be a joke in very poor taste.",shape=box,color=blue];
		j2486388606 -> j1667133062;
	j985782477 [label="Pardon me?",shape=box,color=red];
		j985782477 -> j402779149;
	j4002654295 [label="Are we talking about Loid?",shape=box,color=red];
		j4002654295 -> j2638501927;
	j1636362832 [label="It will be the only way forward for you, if that is what you seek. If you care not, then I care not. Do what you will.",shape=box,color=blue];
		j1636362832 -> j2100574820;
	j4138167829 [label="Is there any way I could change your mind?",shape=box,color=red];
		j4138167829 -> j614519319;
	j3786792666 [label="How do I get out of this?",shape=box,color=red];
		j3786792666 -> j3409579212;
	j1887575000 [label="You did not meet your end of the bargain, so I shall not meet mine.",shape=box,color=blue];
		j1887575000 -> j1414284106;
		j1887575000 -> j196311977;
	j2092497863 [label="That, and, well, of course, our personal friendship is the only leverage I own in this situation. It is that simple.",shape=box,color=blue];
		j2092497863 -> j601506214;
	j1667133062 [label="И в свою очередь я теперь помогу тебе. Этот дворецкий. Ты все ещё хочешь вернуть его к семье Альбрехта наверху?",shape=box,color=blue];
		j1667133062 -> j744968765;
	j402779149 [label="Дворецкий. Его возвращение к семье Альбрехта. Ты всё ещё хочешь этого, верно?",shape=box,color=blue];
		j402779149 -> j1949841813;
	j2638501927 [label="Да. Постарайся не отставать. Я полагаю, ты всё ещё хочешь вернуть его к семье Альбрехта наверху, да?",shape=box,color=blue];
		j2638501927 -> j1949841813;
	j2100574820 [label="И не пытайся подсылать ко мне ревнителей веры, чтобы они канючили у меня под боком, вымаливая тебе милость. Ничего у них не выйдет.",shape=box,color=blue];
		j2100574820 -> "Chat ends.";
	j614519319 [label="No. And I am no longer in the mood to assist you in such matters.",shape=box,color=blue];
		j614519319 -> "Initiate conversation LyonRoatheFail in /Lotus/Types/Gameplay/1999Wf/Dialogue/LyonDialogue_rom.dialogue";
	j3409579212 [label="The same way you found yourself mired in it in the first place.",shape=box,color=blue];
		j3409579212 -> j136786926;
	j1414284106 [label="Есть ли хоть малейший шанс, что я смогу переубедить тебя?",shape=box,color=red];
		j1414284106 -> j1463039195;
	j196311977 [label="Как мне из этого выбраться?",shape=box,color=red];
		j196311977 -> j434957283;
	j601506214 [label="What say you?",shape=box,color=blue];
		j601506214 -> j4032046539;
		j601506214 -> j390831430;
