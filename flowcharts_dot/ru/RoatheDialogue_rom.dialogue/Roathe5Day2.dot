		j1776100240 -> j1859217847 [label="false",color=purple];
	j1063490160 [label="And do not concern yourself with bothering the zealots to whine in my ear hoping to convince me to show you mercy. It will not work.",shape=box,color=blue];
		j1063490160 -> "Chat ends.";
	j2117701808 [label="Those are a different kind of memory, Roathe. It won't work on them. They are buried deeper in your psyche.",shape=box,color=red];
		j2117701808 -> j3608727997;
	j1088756539 [label="Running and hiding from the truth won't work. We'll just wind up right back where we started. ",shape=box,color=red];
		j1088756539 -> j239267210;
	j717799577 [label="Are you sure? But... you're smart, I get the feeling you'll figure something is up.",shape=box,color=red];
