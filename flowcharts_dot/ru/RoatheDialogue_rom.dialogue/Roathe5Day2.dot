		j2558396776 -> j2060725966 [label=true,color=green];
		j2558396776 -> j2319024813 [label=false,color=brown];
	j2389228488 [label="Я знаю. Но такие вещи требуют времени, и нам нужно подождать.",shape=box,color=red];
		j2389228488 -> j573629230;
	j2155036798 [label="Моё мнение изменилось. Прости.",shape=box,color=red];
		j2155036798 -> j3886818801;
	j1627858562 [label="Я сделаю это. Я постепенно к этому прихожу. Я обещаю.",shape=box,color=red];
		j1627858562 -> j2066521258;
	j3182137513 [label="Нет. Я не могу этого сделать. Прости. Я не могу так поступить с тобой.",shape=box,color=red];
		j3182137513 -> j1170271718;
	j3519414891 [label="Ладно. Я уступаю. Я сделаю, как ты просишь.",shape=box,color=red];
		j3519414891 -> j4213975214;
	j2171950327 [label="Check boolean LoidFamilyComplete",color=orange];
		j2171950327 -> j1778191761 [label=true,color=green];
		j2171950327 -> j2912201802 [label=false,color=brown];
	j2811593300 [label="Что бы тебе не хотелось от меня, сейчас ты этого не получишь. Тебе лучше покончить с этим и очистить мою память от этого нашего позора.",shape=box,color=blue];
		j2811593300 -> j3701697314;
	j1384616734 [label="Что ж, что бы тебе не хотелось от меня, сейчас ты этого не получишь. Тебе лучше покончить с этим и очистить мою память от этого нашего позора.",shape=box,color=blue];
		j1384616734 -> j3701697314;
	j358311382 [label="Всё совершенно ясно, вам не о чем беспокоиться.",shape=box,color=blue];
		j358311382 -> "Chat ends.";
	j1739392625 [label="Я требую, чтобы ты это исправил. В этом твоя вина. Я чувствую, как это царапает меня, разрывает меня. Как некое огромное чудовище.",shape=box,color=blue];
		j1739392625 -> j553351880;
	j1707030813 [label="Было бы дурным тоном не признать, что это во многом благодаря твоей помощи, дорогуша. Спасибо.",shape=box,color=blue];
		j1707030813 -> j3503048643;
		j1707030813 -> j3208451928;
	j4088647970 [label="Было бы дурным тоном не признать, что это во многом благодаря твоей помощи, Узурпатор. Спасибо.",shape=box,color=blue];
		j4088647970 -> j190661055;
		j4088647970 -> j3068762800;
	j2060725966 [label="Было бы дурным тоном не признать, что это во многом благодаря тебе, дорогуша.",shape=box,color=blue];
		j2060725966 -> j1554432548;
		j2060725966 -> j3715361559;
	j2319024813 [label="Было бы дурным тоном не признать, что это во многом благодаря тебе, Узурпатор.",shape=box,color=blue];
		j2319024813 -> j2919307453;
		j2319024813 -> j1149515239;
	j573629230 [label="Мм. Хорошо. Я терпеливый дьявол, но воды этого колодца со временем могут иссякнуть, поверь мне.",shape=box,color=blue];
		j573629230 -> "Chat ends.";
	j3886818801 [label="Понимаю. Все так просто, да?",shape=box,color=blue];
		j3886818801 -> j431793363;
	j2066521258 [label="Мм. Проследи, чтобы так и было. Я терпеливый дьявол, но воды этого колодца со временем могут иссякнуть, поверь мне.",shape=box,color=blue];
		j2066521258 -> "Chat ends.";
	j1170271718 [label="Даже если это означает, что мы навечно застрянем в этом тупике? Бедный, печальный Узурпатор... что ж. Чистилище для дьявола все же лучше Ада, не так ли?",shape=box,color=blue];
		j1170271718 -> j3096921965;
	j4213975214 [label="Хорошо. Переходи к делу. Я устал жить с этим знанием в голове.",shape=box,color=blue];
		j4213975214 -> j378811769;
	j1778191761 [label="Впрочем, разве тебе есть до этого дело? У тебя есть всё, что ты желаешь вырезать из моего пустого трупа. Мои рёбра уже обнажены и высушены.",shape=box,color=blue];
		j1778191761 -> j1776100240;
	j2912201802 [label="Трагично, не правда ли? Осознавать, что отбросы семейства Энтрати никогда не узнают, что их дворецкий гниет здесь внизу, ломая руки от горя. В полном одиночестве?",shape=box,color=blue];
		j2912201802 -> j1776100240;
	j3701697314 [label="Для тебя это будет единственным шагом вперёд, если именно этого ты ищешь. Если тебе нет дела, то и мне нет дела. Поступай как хочешь.",shape=box,color=blue];
		j3701697314 -> j2100574820;
	j553351880 [label="Избавь меня от этого. Избавь меня от этой заразы. Очисти мою память от этих воспоминаний. Я знаю, что ты можешь. Используй свой дар и положи этому конец. Прямо сейчас.",shape=box,color=blue];
		j553351880 -> j2292931540;
		j553351880 -> j4108029105;
		j553351880 -> j905429861;
	j3503048643 [label="Я не мог оставить тебя гоняться за своим острым хвостом вечно.",shape=box,color=red];
		j3503048643 -> j1258124653;
	j3208451928 [label="Пожалуйста.",shape=box,color=red];
		j3208451928 -> j2665556245;
	j190661055 [label="Я не мог оставить тебя гоняться за своим острым хвостом вечно. Это было бы уже грустно.",shape=box,color=red];
		j190661055 -> j1955480572;
	j3068762800 [label="Пожалуйста.",shape=box,color=red];
		j3068762800 -> j578416406;
	j1554432548 [label="Во многом? Если бы не я, ты до сих пор бегал бы по кругу, гоняясь за своим острым хвостом, Роут.",shape=box,color=red];
