		779 -> 792;
	780 [label="+15 Chemistry",color=orange];
		780 -> 793;
	773 [label="Теперь, когда мы это уладили и разобрались, как продвигается твоя работа с нашим маленьким плавающим подхалимом? Полагаю, священник всё ещё не разговаривает с тобой.",shape=box,color=blue];
		773 -> 643;
