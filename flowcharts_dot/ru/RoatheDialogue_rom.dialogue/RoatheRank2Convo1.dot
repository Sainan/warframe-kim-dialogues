	j961755303 [label="Ха! Я составлю тебе список! Он исчерпывающий и в то же время неточный, постоянно переходящий от непостижимого зла к, казалось бы, неуловимой коррупции!",shape=box,color=blue];
		j961755303 -> j3142907957;
	j3875874349 [label="Boolean RoatheKnowsReset2 is now true.",color=orange];
		j3875874349 -> j1300020591;
	j336577929 [label="Сейчас тобой движет злость. Кажется, что всё сложилось из-за трусливого решения, но у тебя нет воспоминаний о том, что вывело тебя к этой точке.",shape=box,color=red];
		j336577929 -> j3605430618;
	j3323589626 [label="Когда-то между нами были истории, но сейчас этого нет. О чём нам говорить теперь? У тебя больше нет такой возможности.",shape=box,color=red];
		j3323589626 -> j2202659743;
	j2011715312 [label="+10 Chemistry",color=orange];
		j2011715312 -> j3821877375;
	j3541021041 [label="Пожалуйста, перестань мне лгать.",shape=box,color=red];
		j3541021041 -> j231660385;
	j2992788273 [label="Ты точно не хочешь, чтобы я захватил немного выпечки? Говорят, тебе это нравится.",shape=box,color=red];
		j2992788273 -> j3433568192;
	j3349345641 [label="Это может быть непросто. Есть ли у Лиона ещё какие-нибудь просьбы, которым можно... помочь исполниться?",shape=box,color=red];
		j3349345641 -> j1595073705;
	j937073896 [label="Ты не знаешь, каково это, когда эти фанатики висят над плечом днём и ночью, орут и читают наставления о том, что нужно покаяться.",shape=box,color=blue];
		j937073896 -> j964067984;
		j937073896 -> j2675460258;
		j937073896 -> j2053122881;
		j937073896 -> j3978096712;
	j1999059708 [label="Я знаю, что мы на пределе. Я чувствую, как мой собственный разум сопротивляется мне. Ты делаешь всё возможное, чтобы помочь мне вернуть мои воспоминания. И за это я благодарю. ",shape=box,color=blue];
		j1999059708 -> j1724348223;
	j4274701985 [label="Мы лишь начинаем раскрывать крошечные обрывки того, что было заперто от меня. Не знаю, что Альбрехт поведал им о моих преступлениях, Скиталец. ",shape=box,color=blue];
		j4274701985 -> j1987410156;
	j1229789417 [label="Мы лишь начали царапать поверхность того, что было заперто от меня. Не знаю, что Альбрехт сообщил им о моих преступлениях, Скиталец.",shape=box,color=blue];
		j1229789417 -> j1987410156;
	j2787130980 [label="Я не знаю, что Альбрехт рассказал им о моих преступлениях, ведь они скрыты даже от меня. Истина сокрыта в моих воспоминаниях, Скиталец.",shape=box,color=blue];
		j2787130980 -> j1987410156;
	j1300020591 [label="Не так давно я доверил тебе страшную правду. Теперь не могу вспомнить зачем.",shape=box,color=blue];
		j1300020591 -> j2608880134;
	j3605430618 [label="Я знаю, что где-то под поверхностью, внутри пылает настоящий пожар. И я знаю, что нам нужно достичь определённой точки, прежде чем мы сможем всё обсудить.",shape=box,color=red];
		j3605430618 -> j3755212321;
	j2202659743 [label="И почему ты мне доверяешь? Всё, что ты обо мне знаешь, это то, что... твои воспоминания подверглись моей манипуляции.",shape=box,color=red];
		j2202659743 -> j2000862956;
	j231660385 [label="Ну, если ты не собираешься быть занудой, Скиталец, то зачем мне тратить на тебя время? У меня уже есть фанатики, и, похоже, мне придётся с ними общаться.",shape=box,color=blue];
		j231660385 -> j3866645924;
	j3433568192 [label="Ах, значит, она тебе рассказала. Ну конечно рассказала. И вообще, это едва ли моя вина! Эти чёртовы лакомства были единственным хорошим в этой проклятой дыре глухомани.",shape=box,color=blue];
		j3433568192 -> j2934473736;
		j3433568192 -> j2735238937;
	j1595073705 [label="+5 Chemistry",color=orange];
		j1595073705 -> j547829739;
	j1724348223 [label="Мне нужно знать, что у меня отняли, Скиталец. Мне нужно понять, что Альбрехт украл у меня, когда навязал мне эту сыворотку.",shape=box,color=blue];
		j1724348223 -> j935571966;
		j1724348223 -> j91390250;
	j1987410156 [label=" Мне нужно понять, что Альбрехт украл у меня, когда навязал мне эту сыворотку. Мне нужно узнать, что заперто у меня в голове, Скиталец. Конечно, когда тебе будет не в тягость, разумеется...",shape=box,color=blue];
		j1987410156 -> j932226156;
		j1987410156 -> j2116087152;
	j2608880134 [label="Вы оба единственные души, к которым у меня вообще могло появиться доверие... и теперь я не понимаю, что придало мне смелости.",shape=box,color=blue];
		j2608880134 -> j490851007;
	j3755212321 [label="И с чего бы мне злиться, Скиталец?",shape=box,color=blue];
		j3755212321 -> j1826670723;
		j3755212321 -> j3486992539;
		j3755212321 -> j1999395568;
	j2000862956 [label="«Подправил мою память». Будто я какая-нибудь скульптура Аятан, с которой решили пошутить. То, что произошло, было гораздо больше, чем «подправление». Это была полная очистка памяти.",shape=box,color=blue];
		j2000862956 -> j2054570980;
		j2000862956 -> j1233204225;
	j2934473736 [label="Так это правда. Ты всерьёз думаешь отправиться в Gaule воровать шоколад? При этом выглядя...?",shape=box,color=red];
		j2934473736 -> j2692813851;
	j2735238937 [label="Как именно вы их получили?",shape=box,color=red];
		j2735238937 -> j3847306433;
	j547829739 [label="Ха! Вот это по мне. Проклятые шоколадки были единственным хорошим в той проклятой дыре глухомани.",shape=box,color=blue];
		j547829739 -> j3036298557;
	j935571966 [label="Я обещаю.",shape=box,color=red];
		j935571966 -> j1115458774;
	j91390250 [label="Мы справимся. Но на это нужно время.",shape=box,color=red];
		j91390250 -> j1626227427;
	j932226156 [label="Я справлюсь.",shape=box,color=red];
		j932226156 -> j2354472094;
	j2116087152 [label="Я стараюсь. Но ты не облегчаешь задачу.",shape=box,color=red];
		j2116087152 -> j1627082735;
	j490851007 [label="Осознай, кем ты являешься для меня на самом деле.",shape=box,color=blue];
		j490851007 -> j3821877375;
	j1826670723 [label="Говорилось, что никакой злости из-за стирания памяти у тебя нет, но я понимаю, что это лишь слова. Потому что… такое уже бывало.",shape=box,color=red];
		j1826670723 -> j2233694931;
	j3486992539 [label="Потому что ты ненавидишь себя за то, что сыворотка была принята добровольно. Ты ненавидишь себя, и это приводит тебя в ярость, потому что ты - это всё, что у тебя осталось.",shape=box,color=red];
		j3486992539 -> j3370823034;
	j1999395568 [label="Утверждалось, что злости за утрату воспоминаний нет, но непонятно, как вообще можно не быть в ярости после такого.",shape=box,color=red];
		j1999395568 -> j3370823034;
	j2054570980 [label="Ничего по-настоящему ценного утрачено не было, лишь наши разговоры.",shape=box,color=red];
		j2054570980 -> j3336285057;
	j1233204225 [label="Но не всего, только наших разговоров здесь. У тебя осталось всё остальное, даже то, что мы восстановили в «Спуске».",shape=box,color=red];
		j1233204225 -> j3336285057;
	j2692813851 [label="Да, с голубой кожей, хвостом, заражённой плотью и всем остальным. Поразительно, на что способны плащ, шляпа и маска.",shape=box,color=blue];
		j2692813851 -> j1701496247;
	j3847306433 [label="Это оказалось проще простого. К тому же, будучи «протофреймом» и боевым представителем элиты Орокин, можно без труда умыкнуть несколько сладостей на рынке, не привлекая внимания стражи.",shape=box,color=blue];
		j3847306433 -> j1709019606;
	j3036298557 [label="Прежде чем ты спросишь, лучше пусть эту историю расскажет Мари, иначе фанатики снова начнут на меня орать и нести бред.",shape=box,color=blue];
		j3036298557 -> j976334956;
	j1115458774 [label="Обещания дьяволу... опасная вещь.",shape=box,color=blue];
		j1115458774 -> j3866645924;
	j1626227427 [label="И терпение у меня тоже есть, ещё какое.",shape=box,color=blue];
		j1626227427 -> j3866645924;
	j2354472094 [label="Убедись, что сделаешь это.",shape=box,color=blue];
		j2354472094 -> j3866645924;
	j1627082735 [label="Конечно, нет! Что в этом веселого?",shape=box,color=blue];
		j1627082735 -> j3866645924;
	j2233694931 [label="Как это чудесно и очаровательно! И удивления никакого! И какое мне дело, правда это или нет?! И кроме того -",shape=box,color=blue];
		j2233694931 -> j3370823034;
	j3370823034 [label="Неправильно! Ошибочно, захватывающе, божественно неправильно! Не говори со мной так, будто знаешь все тонкости ярости, которые, я думаю, ты даже не можешь постичь.",shape=box,color=blue];
		j3370823034 -> j1978770609;
	j3336285057 [label="Не смей говорить мне, что ценно в моём сознании, а что нет, Скиталец. Это не чья-то собственность, чтобы на неё можно было предъявлять права.",shape=box,color=blue];
		j3336285057 -> j1978770609;
	j1701496247 [label="Люди быстро отмахиваются от тех, кого не хотят видеть. К тому же, будучи «протофреймом» и боевым представителем элиты Орокин, можно без труда умыкнуть несколько сладостей на рынке, не привлекая внимания стражи.",shape=box,color=blue];
		j1701496247 -> j4202875018;
	j1709019606 [label="Да, с голубой кожей, хвостом, заражённой плотью и всем остальным. Поразительно, на что способны плащ, шляпа и маска.",shape=box,color=blue];
		j1709019606 -> j4202875018;
	j976334956 [label="Они кричат и вопят на меня о грехе и о том, что мне нужно достаточно раскаяться, не добавляя к этому ещё и «очередную ложь о своей версии истории».",shape=box,color=blue];
		j976334956 -> j964067984;
		j976334956 -> j2675460258;
		j976334956 -> j2053122881;
		j976334956 -> j3978096712;
	j4202875018 [label="Boolean RoatheMariePastry1 is now true.",color=orange];
		j4202875018 -> j1961182602;
		j4202875018 -> j3441929696;
	j1961182602 [label="И всё же этого оказывалось достаточно для Мари и Лиона?",shape=box,color=red];
		j1961182602 -> j676354731;
	j3441929696 [label="То есть в итоге пирожные просто оказались у тебя.",shape=box,color=red];
		j3441929696 -> j3388952333;
	j676354731 [label="Ах. Ожидалось, что я возьму себе достаточно, а их оставлю ни с чем? Просто потому, что мне не нравится их общество, и я хочу от них избавиться?",shape=box,color=blue];
		j676354731 -> j2978038831;
	j3388952333 [label="Всё на этой планете вскоре должно было принадлежать Империи Орокин. В любом случае, она принадлежала мне по праву.",shape=box,color=blue];
		j3388952333 -> j3622004267;
	j2978038831 [label="Полагаешь, что моя неприязнь к ним каким-то образом обязывает меня проявлять жестокость. Дьявол, и, следовательно, склонность к жестокости, такова логика, которую ты проводишь.",shape=box,color=blue];
		j2978038831 -> j1779984823;
	j3622004267 [label="К тому же, у меня не было денег. Что мне ещё оставалось делать?",shape=box,color=blue];
		j3622004267 -> j192218544;
	j1779984823 [label="Как же это разочаровывает. Такие поверхностные поступки свойственны исключительно примитивным и школьным хулиганам. ",shape=box,color=blue];
		j1779984823 -> j2722066584;
	j192218544 [label="И я знаю, что ты пробираешься сквозь корабли и берёшь всё, что тебе нужно или хочется, — не надо смотреть на меня так невинно, Узурпатор.",shape=box,color=blue];
		j192218544 -> j3452615761;
		j192218544 -> j3957956266;
	j2722066584 [label="Ненавижу их. И всё же мне приходится с ними сосуществовать. Не хочу, чтобы они лишились этого дурацкого пирожного. Это всего лишь пирожное. Зачем так без нужды усугублять ситуацию?",shape=box,color=blue];
		j2722066584 -> j936480359;
		j2722066584 -> j2832123791;
		j2722066584 -> j212172902;
	j3452615761 [label="Забудь. ",shape=box,color=red];
		j3452615761 -> j3222388507;
	j3957956266 [label="Я думаю, это справедливо.",shape=box,color=red];
		j3957956266 -> j4269573207;
	j936480359 [label="Или попробуй проявлять доброжелательность к ним просто так.",shape=box,color=red];
		j936480359 -> j2345861909;
	j2832123791 [label="Итак, чтобы уточнить - доброе отношение возникло из-за ненависти к ним.",shape=box,color=red];
		j2832123791 -> j114926266;
	j212172902 [label="Никогда об этом не приходилось думать в таком ключе.",shape=box,color=red];
		j212172902 -> j125912279;
	j3222388507 [label="Прекрасно. Ещё один, кто не способен признать чужую правоту. Как будто мало было фанатиков, которые кричали на меня круглосуточно, умоляя покаяться.",shape=box,color=blue];
		j3222388507 -> j964067984;
		j3222388507 -> j2675460258;
		j3222388507 -> j2053122881;
		j3222388507 -> j3978096712;
	j4269573207 [label="+5 Chemistry",color=orange];
		j4269573207 -> j3600930719;
	j2345861909 [label="Да, попробуй сам послушать их бесконечное жужжание, когда они день и ночь бормочут проклятия и требуют покаяния.",shape=box,color=blue];
		j2345861909 -> j964067984;
		j2345861909 -> j2675460258;
		j2345861909 -> j2053122881;
		j2345861909 -> j3978096712;
	j114926266 [label="Именно. Что тут такого сложного для понимания? И да, я вижу твой сарказм, Узурпатор. Но не волнуйся, меня это забавляет.",shape=box,color=blue];
		j114926266 -> j1492450831;
	j125912279 [label="+5 Chemistry",color=orange];
		j125912279 -> j305255282;
	j3600930719 [label="Благодарю. Наконец-то кто-то способен признать очевидное. Если бы те два фанатика могли сделать то же самое, им бы не удалось часами орать, требуя покаяния.",shape=box,color=blue];
		j3600930719 -> j964067984;
		j3600930719 -> j2675460258;
		j3600930719 -> j2053122881;
		j3600930719 -> j3978096712;
	j1492450831 [label="Это по крайней мере лучше, чем бесконечные, мерзкие проповеди фанатиков - которые постоянно ругаются и требуют покаяния.",shape=box,color=blue];
		j1492450831 -> j964067984;
		j1492450831 -> j2675460258;
		j1492450831 -> j2053122881;
		j1492450831 -> j3978096712;
	j305255282 [label="Не за что. Как же приятно общаться с кем-то, кто способен менять точку зрения. Если бы те два фанатика могли сделать то же самое, они бы не вопили на меня круглые сутки, умоляя покаяться.",shape=box,color=blue];
		j305255282 -> j964067984;
		j305255282 -> j2675460258;
		j305255282 -> j2053122881;
		j305255282 -> j3978096712;
}