		736 -> 751;
	737 [label="И, что важнее всего, я гарантирую, что ты добьёшься своей цели — воссоединить дворецкого Альбрехта с семьёй, чего бы это ни стоило, на этот раз.",shape=box,color=blue];
		737 -> 752;
	739 [label="Ах да, конечно. Он смертельно был обижен в тот самый момент, как только был пересечён порог тобой сюда. У меня просто не хватало духу сказать тебе об этом.",shape=box,color=blue];
		739 -> 754;
		739 -> 755;
		739 -> 756;
	740 [label="Именно. Я не уверен, то ли один из этих примитивных кайтов пнул её в детстве по голове, то ли ей действительно так отчаянно не хватало отцовской фигуры, я не знаю.",shape=box,color=blue];
		740 -> 757;
	741 [label="Вроде как отец, может быть. Или что-то святое. Понятия не имею, то ли один из тех примитивных кайтов их эпохи в детстве двинул её по голове, то ли она остро нуждалась в наставниках, я не знаю.",shape=box,color=blue];
		741 -> 757;
	742 [label="Смысл в том, что они с огромным рвением разъясняют мне, подробно и долго, какой я ужасный и что мне следует каяться и извиняться за все, что я когда-либо сделал.",shape=box,color=blue];
