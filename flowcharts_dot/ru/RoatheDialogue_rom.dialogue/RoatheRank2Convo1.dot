	edge [fontname="Roboto Condensed"];

	"RoatheRank2Convo1 begins." [color=orange];
		"RoatheRank2Convo1 begins." -> j3424890487;
	j3424890487 [label="Check boolean LoidFamilyComplete",color=orange];
		j3424890487 -> j3869625108 [label=true,color=green];
		j3424890487 -> j216863090 [label=false,color=brown];
	j3869625108 [label="Evaluate expressions",color=orange];
		j3869625108 -> j3440953336 [label="RoatheDatingDeal",color=purple];
		j3869625108 -> j230708705 [label="RoatheMarieDatingDeal",color=purple];
		j3869625108 -> j230708705 [label="RoatheLyonDatingDeal",color=purple];
		j3869625108 -> j3440953336 [label="RoatheSerumDeal",color=purple];
		j3869625108 -> j3440953336 [label="RoatheFamilyDeal",color=purple];
		j3869625108 -> j230708705 [label="RoatheMarieEntratiDeal",color=purple];
		j3869625108 -> j230708705 [label="RoatheLyonConfessionDeal",color=purple];
		j3869625108 -> j579662302 [label="RoatheDatingDealNo",color=purple];
		j3869625108 -> j3323164246 [label="RoatheMarieDatingDealNo",color=purple];
		j3869625108 -> j1865975392 [label="RoatheLyonDatingDealNo",color=purple];
		j3869625108 -> j3783049933 [label="RoatheSerumDealNo",color=purple];
		j3869625108 -> j1933323896 [label="RoatheFamilyDealNo",color=purple];
		j3869625108 -> j4228364639 [label="RoatheMarieEntratiDealNo",color=purple];
		j3869625108 -> j544553156 [label="RoatheLyonConfessionDealNo",color=purple];
		j3869625108 -> j1065783799 [label="false",color=purple];
	j216863090 [label="Evaluate expressions",color=orange];
		j216863090 -> j2694130358 [label="RoatheKnowsReset",color=purple];
		j216863090 -> j2694130358 [label="RoatheDeal",color=purple];
		j216863090 -> j2694130358 [label="RoatheNoDeal",color=purple];
		j216863090 -> j2694130358 [label="false",color=purple];
	j3440953336 [label="Меня так ужасно увлекает то, что ты замышляешь вместе со мной... устроить мой собственный путь. Дьявол, так сказать, действует собственной плотью.",shape=box,color=blue];
		j3440953336 -> j722437109;
	j230708705 [label="Как продвигаются дела у тебя, узурпатор? Я усердно использую ниточки и рычаги в твою пользу, хотя моё влияние, возможно, пока не заметно и не ощущается.",shape=box,color=blue];
		j230708705 -> j722437109;
	j579662302 [label="Скажи, что у тебя изменилось мнение насчёт моего предложения. Раньше я мог бы стать барьером сопротивления твоим... романтическим устремлениям? Теперь я буду послушен, как снежный барс. Хм. Если только ты этого не хочешь. Решать тебе.",shape=box,color=blue];
		j579662302 -> j134238288;
	j3323164246 [label="Сообщите мне своё решение насчёт моего предложения. Я могу решить эту проблему с Мари. Обеспечить тебе лёгкое достижение ваших романтических целей с ней.",shape=box,color=blue];
		j3323164246 -> j134238288;
	j1865975392 [label="Сообщите мне своё решение насчёт моего предложения. Я могу решить эту проблему с Лионом. Обеспечить тебе лёгкое достижение ваших романтических целей с ним.",shape=box,color=blue];
		j1865975392 -> j134238288;
	j3783049933 [label="Скажи своё решение насчёт моего предложения. Где я, возможно, и раньше проявил сопротивление, когда речь шла о моём... приёме сыворотки? Я буду послушен, как снежный барс.",shape=box,color=blue];
		j3783049933 -> j134238288;
	j1933323896 [label="Скажи мне своё решение насчёт моего предложения. Где я мог бы стать барьером сопротивления, воссоединив дворецкого с семьёй? Я буду послушен, как снежный терриск.",shape=box,color=blue];
		j1933323896 -> j134238288;
	j4228364639 [label="Сообщи мне своё решение насчёт моего предложения — я могу решить эту проблему с Мари. Увидишь, что тебе будет легко общаться с ней.",shape=box,color=blue];
		j4228364639 -> j134238288;
	j544553156 [label="Сообщи мне своё решение насчёт моего предложения — я могу решить эту проблему с Лионом. Увидишь, что тебе будет легко общаться с ним.",shape=box,color=blue];
		j544553156 -> j134238288;
	j1065783799 [label="Не могу отделаться от мысли, что ты не просто так вмешиваешься в наши разговоры, Узурпатор. И, возможно, я смогу тебе чем-то помочь.",shape=box,color=blue];
		j1065783799 -> j4225120331;
	j2694130358 [label="Evaluate expressions on HellStory counter",color=orange];
		j2694130358 -> j3869625108 [label="x >= 21",color=purple];
		j2694130358 -> j2075111951 [label="x < 21",color=purple];
		j2694130358 -> j2075111951 [label="false",color=purple];
	j722437109 [label="С моей точки зрения, это странное испытание — действовать, имея в распоряжении лишь часть своих воспоминаний, и при этом знать, что ты держишь в руках другую половину колоды.",shape=box,color=blue];
		j722437109 -> j3106071241;
	j134238288 [label="Но всё это... хождение вокруг да около, чем ты занимаешься? Это просто пустая трата времени. Так что давай. Скажи слово. И твоя проблема будет решена.",shape=box,color=blue];
		j134238288 -> j4061286774;
		j134238288 -> j960171669;
	j4225120331 [label="Скажи мне, чего ты хочешь, и давай договоримся. Вся это... суета — пустая трата времени.",shape=box,color=blue];
		j4225120331 -> j2953660143;
	j2075111951 [label="Evaluate expressions",color=orange];
		j2075111951 -> j649002774 [label="RoatheDeal",color=purple];
		j2075111951 -> j3316737884 [label="RoatheNoDeal",color=purple];
		j2075111951 -> j3316737884 [label="false",color=purple];
	j3106071241 [label="Так что я просто продолжу, за неимением лучшего. «Кстати, как там наш маленький плавучий подхалим? Полагаю, священник всё ещё с тобой не разговаривает». Ба. Какой фарс.",shape=box,color=blue];
		j3106071241 -> j2817797203;
		j3106071241 -> j173277137;
		j3106071241 -> j2380767995;
	j4061286774 [label="Нет. Извини. Я не договариваюсь с Орокин. Ни тогда, ни сейчас, никогда.",shape=box,color=red];
		j4061286774 -> j4023061892;
	j960171669 [label="Очень надеюсь, ты не заставишь меня пожалеть об этом, Роут. Хорошо. Я соглашаюсь. Мне нужна твоя помощь.",shape=box,color=red];
		j960171669 -> j1876832257;
	j2953660143 [label="Check boolean LoidFamilyComplete",color=orange];
		j2953660143 -> j2339481384 [label=true,color=green];
		j2953660143 -> j1259258929 [label=true,color=green];
		j2953660143 -> j4042224564 [label=true,color=green];
		j2953660143 -> j2670099013 [label=true,color=green];
		j2953660143 -> j2339481384 [label=false,color=brown];
		j2953660143 -> j1259258929 [label=false,color=brown];
		j2953660143 -> j4042224564 [label=false,color=brown];
		j2953660143 -> j2670099013 [label=false,color=brown];
		j2953660143 -> j2002730532 [label=false,color=brown];
	j649002774 [label="Как продвигается твоя работа с нашим маленьким плавающим подхалимом? Полагаю, священник всё ещё не разговаривает с тобой.",shape=box,color=blue];
		j649002774 -> j1777990800;
		j649002774 -> j2152961326;
		j649002774 -> j213029716;
	j3316737884 [label="Скажи, что ты думаешь насчёт моего предложения? Это твой последний шанс, Узурпатор. Я терпеливый дьявол, но не люблю, когда меня оставляют придерживать двери, как дурака.",shape=box,color=blue];
		j3316737884 -> j2850239219;
		j3316737884 -> j173272416;
	j2817797203 [label="Пока что у меня с Мари всё в порядке.",shape=box,color=red];
		j2817797203 -> j121114747;
	j173277137 [label="Нет, но он изменит своё мнение.",shape=box,color=red];
		j173277137 -> j882486350;
	j2380767995 [label="Кажется, они тебе не особо нравятся. Что так?",shape=box,color=red];
		j2380767995 -> j348231061;
	j4023061892 [label="Как пожелаешь. Предупреждаю, это был твой последний шанс. Теперь ты в свободном плавании",shape=box,color=blue];
		j4023061892 -> j4178742938;
	j1876832257 [label="Evaluate expressions",color=orange];
		j1876832257 -> j3455387506 [label="RoatheDatingDealNo",color=purple];
		j1876832257 -> j2441643812 [label="RoatheMarieDatingDealNo",color=purple];
		j1876832257 -> j2406319411 [label="RoatheLyonDatingDealNo",color=purple];
		j1876832257 -> j1603643499 [label="RoatheSerumDealNo",color=purple];
		j1876832257 -> j3832197172 [label="RoatheFamilyDealNo",color=purple];
		j1876832257 -> j1996978809 [label="RoatheMarieEntratiDealNo",color=purple];
		j1876832257 -> j1440686891 [label="RoatheLyonConfessionDealNo",color=purple];
		j1876832257 -> j811288006 [label="false",color=purple];
	j2339481384 [label="У Лиона… слишком много дел, с которыми нужно разобраться. И я не знаю, как пробиться сквозь всё это.",shape=box,color=red];
		j2339481384 -> j1737282712;
	j1259258929 [label="Мари не хочет видеть Энтрати таким, какой он есть. Все попытки донести до неё правду остаются безуспешными.",shape=box,color=red];
		j1259258929 -> j3942591950;
	j4042224564 [label="Ну, понимаешь, у тебя есть целая история о том, почему ты принял сыворотку, а мне лишь удалось говорить не то и не ко времени.",shape=box,color=red];
		j4042224564 -> j2372543002;
	j2670099013 [label="Немного неловко признавать, но… симпатия есть к одному из вас троих.",shape=box,color=red];
		j2670099013 -> j1850111238;
		j2670099013 -> j3457472505;
		j2670099013 -> j2037190202;
	j2002730532 [label="Пытались убедить всех помочь вернуть Лойда к семье наверху и... но ничего не вышло...",shape=box,color=red];
		j2002730532 -> j2030582425;
	j1777990800 [label="Нет, Лион... не из тех, кто много говорит.",shape=box,color=red];
		j1777990800 -> j3631388950;
	j2152961326 [label="С Мари отношения складываются неплохо. Интересно, почему её называют подхалимкой?",shape=box,color=red];
		j2152961326 -> j2451427853;
	j213029716 [label="Кажется, они тебе не очень нравятся. Почему?",shape=box,color=red];
		j213029716 -> j371270277;
	j2850239219 [label="Нет. Прости. Сделок с Орокин не заключают. Ни тогда, ни сейчас, ни когда-либо.",shape=box,color=red];
		j2850239219 -> j528822198;
	j173272416 [label="Остаётся лишь надеяться, что об этом не придётся пожалеть. Что ж… принято.",shape=box,color=red];
		j173272416 -> j3983546222;
	j121114747 [label="«Пока что». Интригует. Всё словно движется по кругу — придворные, повторяющие шаги одного и того же танца? Снова и снова, обречённые повторяться?",shape=box,color=blue];
		j121114747 -> j847586400;
		j121114747 -> j3666374239;
	j882486350 [label="Думаю, было бы известно, не так ли? Любопытно, что всё настолько предсказуемо. Приятно осознавать, что даже такой сломанный, как он, временами всё ещё способен быть надёжным.",shape=box,color=blue];
		j882486350 -> j934089966;
	j348231061 [label="Разве ты не знаешь? Мм. Может быть, тебя до этого момента не было. Или, может быть, у тебя не было в мыслях задавать этот вопрос ни в первый, ни в тысячный раз за время этого маленького фарса.",shape=box,color=blue];
		j348231061 -> j934089966;
	j4178742938 [label="Ой. И ещё кое-что, пока я не забыл?",shape=box,color=blue];
		j4178742938 -> j685867738;
	j3455387506 [label="Ты действительно продаёшь свою душу дьяволу, да ещё и дважды… договорившись, чтобы я взял тебя в свою постель? Или ты жаждешь получить моё сердце, Узурпатор? Ммм. Посмотрим, но потом.",shape=box,color=blue];
		j3455387506 -> j1037845791;
	j2441643812 [label="Когда придёт время, я позабочусь о том, чтобы у тебя была возможность завоевать нашу маленькую подхалимку, Узурпатор. Считай, что этот вопрос решён.",shape=box,color=blue];
		j2441643812 -> j1037845791;
	j2406319411 [label="Когда придёт время, я позабочусь о том, чтобы у тебя была возможность завоевать бедного сломленного священника, Узурпатор. Считай, что этот вопрос решён.",shape=box,color=blue];
		j2406319411 -> j4243527171;
	j1603643499 [label="Когда придёт время, я буду помнить об этом. Если у нас снова возникнут разногласия по поводу моих воспоминаний, мы не будем повторять ваши предыдущие ошибки.",shape=box,color=blue];
		j1603643499 -> j828752989;
	j3832197172 [label="Когда придёт время, я позабочусь, чтобы этот маленький дворецкий поднялся по ступеням. Считай, что дело сделано.",shape=box,color=blue];
		j3832197172 -> j1037845791;
	j1996978809 [label="Считай, что твоя проблема с Мари и её льстивым обожанием Энтрати решена. Когда придёт время, я этим займусь.",shape=box,color=blue];
		j1996978809 -> j3478402717;
	j1440686891 [label="Считай, что твоя проблема с Лионом и его ужасами решена, Узурпатор. Когда придёт время, я этим займусь.",shape=box,color=blue];
		j1440686891 -> j1167057240;
	j811288006 [label="Я... кажется забыл, что именно было тебе нужно. Всё благодаря твоему вмешательству в мои воспоминания. Итак, что это было?",shape=box,color=blue];
		j811288006 -> j2953660143;
	j1737282712 [label="Я бы посоветовал простое терпение, но… не мне учить тебя пользоваться зубилом, когда у тебя под рукой лазер.",shape=box,color=blue];
		j1737282712 -> j2713252839;
	j3942591950 [label="Хм. Понимаю. Благородное начинание, если честно. Я сам пытался сделать это бесчисленное множество раз. И столько же раз проваливался.",shape=box,color=blue];
		j3942591950 -> j1443469959;
	j2372543002 [label="Хм.",shape=box,color=blue];
		j2372543002 -> j3015695920;
	j1850111238 [label="Лион.",shape=box,color=red];
		j1850111238 -> j4142187517;
	j3457472505 [label="... Ты.",shape=box,color=red];
		j3457472505 -> j3401743205;
	j2037190202 [label="Мари.",shape=box,color=red];
		j2037190202 -> j1127309643;
	j2030582425 [label="Хм. Понимаю. У нас была договоренность, но из-за твоего несоблюдения своей части сделки, твоё вознаграждение исчезло.",shape=box,color=blue];
		j2030582425 -> j3005346422;
	j3631388950 [label="Когда он говорит, его речь обычно можно отнести к двум категориям - либо ужасно бессмысленные, либо ужасно сумасшедшие.",shape=box,color=blue];
		j3631388950 -> j5699004;
	j2451427853 [label="Хм? Тебе удалось избежать этого? Я страшно тебе завидую. Но скоро тебя всё равно накроет взрывной волной, поэтому лучше предупредить тебя.",shape=box,color=blue];
		j2451427853 -> j3464602212;
	j371270277 [label="Мой бедный Скиталец. Разве ты забыл, как строго мы, Орокин, отвергали всякое почитание божеств? Единственное, чему мы поклонялись, это себе.",shape=box,color=blue];
		j371270277 -> j3956911662;
	j528822198 [label="Как пожелаешь. Предупреждаю, твоё решение не останется без последствий.",shape=box,color=blue];
		j528822198 -> j355822027;
	j3983546222 [label="Веди себя хорошо и помоги мне отправить Лойда подняться наверх и помириться с семьёй. И я помогу тебе разобраться с твоими воспоминаниями.",shape=box,color=red];
		j3983546222 -> j4210694066;
	j847586400 [label="Это не значит, что тебе не хватает инициативы. Это просто означает, что для некоторых вещей может потребоваться несколько попыток.",shape=box,color=red];
		j847586400 -> j2316556891;
	j3666374239 [label="Надеюсь, это тебя не расстроит.",shape=box,color=red];
		j3666374239 -> j3707203840;
	j934089966 [label="Неужели мы все обречены повторяться, словно придворные, повторяющие движения танца?",shape=box,color=blue];
		j934089966 -> j847586400;
		j934089966 -> j3666374239;
	j685867738 [label="Не так давно я доверил тебе страшную правду. Теперь не могу вспомнить зачем.",shape=box,color=blue];
		j685867738 -> j1074117661;
	j1037845791 [label="Boolean RoatheFamilyDealNo is now false.",color=orange];
		j1037845791 -> j319941903;
	j4243527171 [label="Boolean RoatheLyonDatingDealNo is now false.",color=orange];
		j4243527171 -> j2505219600;
	j828752989 [label="Boolean RoatheSerumDealNo is now false.",color=orange];
		j828752989 -> j2547555330;
	j3478402717 [label="Boolean RoatheMarieEntratiDealNo is now false.",color=orange];
		j3478402717 -> j1250445566;
	j1167057240 [label="Boolean RoatheLyonConfessionDealNo is now false.",color=orange];
		j1167057240 -> j1802251991;
	j2713252839 [label="Кажется, я начинаю понимать, почему наша память была стёрта. Видя все свои неудачные попытки и усилия... почему бы не попробовать всё сначала?",shape=box,color=blue];
		j2713252839 -> j984185794;
	j1443469959 [label="Видя в отчаянии, что ты больше не можешь убедить её в простой истине вещей, тебе нужно прибегнуть к тому, что было - используя этот твой... дар.",shape=box,color=blue];
		j1443469959 -> j1235991965;
	j3015695920 [label="Мне не нравится, что ты засоряешь мне мозги, чтобы исправить свои ошибки, Скиталец. Однако, если ты пытаешься сделать это ради меня... полагаю, наверное, это приемлемо.",shape=box,color=blue];
		j3015695920 -> j2370231031;
	j4142187517 [label="Boolean DrifterLyon is now true.",color=orange];
		j4142187517 -> j660949094;
	j3401743205 [label="Boolean DrifterRoathe is now true.",color=orange];
		j3401743205 -> j2473500034;
	j1127309643 [label="Boolean DrifterMarie is now true.",color=orange];
		j1127309643 -> j2042700029;
	j3005346422 [label="Итак, зная, что вы больше не можете достичь того, что раньше было в ваших силах, вы прибегаете к тому было - используя этот... свой дар.",shape=box,color=blue];
		j3005346422 -> j3937751915;
	j5699004 [label="Всегда как подбрасывание монетки, никогда не знаешь, какой стороной выпадет, и я так и не могу решить, какая мне нравится больше.",shape=box,color=blue];
		j5699004 -> j1132675936;
	j3464602212 [label="Эта женщина неиссякаема в своей непоколебимой и навязчивой преданности Альбрехту. Я бы сказал, дворецкому стоило бы насторожиться, но, честно говоря, я искренне уверен, что это чистая преданность. И это говорю я.",shape=box,color=blue];
		j3464602212 -> j557981660;
	j3956911662 [label="Эти двое фанатиков и двух минут не могут прожить без своего «Сола» да и «Луа», или без того, чтобы не попытаться освятить ночной горшок.",shape=box,color=blue];
		j3956911662 -> j3937601473;
