		700 -> 716;
	699 [label="Update boolean RoatheMarieEntratiDeal",color=orange];
		699 -> 716;
	698 [label="Update boolean RoatheLyonConfessionDeal",color=orange];
		698 -> 716;
	701 [label="Как же это в духе Орокин.",shape=box,color=blue];
		701 -> 5762;
	702 [label="Как же это в духе Орокин.",shape=box,color=blue];
		702 -> 717;
	703 [label="Как же это в духе Орокин.",shape=box,color=blue];
		703 -> 718;
	704 [label="+5 Chemistry",color=orange];
		704 -> 719;
	705 [label="+5 Chemistry",color=orange];
		705 -> 720;
	706 [label="+5 Chemistry",color=orange];
		706 -> 721;
	707 [label="Как же это в духе Орокин.",shape=box,color=blue];
		707 -> 722;
	710 [label="Забавно, правда? Но я все равно предпочитаю его сестре. По крайней мере, с ним можно поговорить разумно.",shape=box,color=blue];
		710 -> 724;
		710 -> 725;
	711 [label="Она просто до одурения насквозь пропитана своим святошеством.",shape=box,color=blue];
		711 -> 726;
		711 -> 727;
	712 [label="Which I will have you know, they still used in that damn cathedral! Actual -",shape=box,color=blue];
		712 -> 728;
	708 [label="Но, процитировать эту маленькую парящую подхалимку? C'est la vie. Кстати, как у неё дела? Полагаю, священнослужительница с тобой до сих пор не разговаривает.",shape=box,color=blue];
		708 -> 643;
		708 -> 642;
