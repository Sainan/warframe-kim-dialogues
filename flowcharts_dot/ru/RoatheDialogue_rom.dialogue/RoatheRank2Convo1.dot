	793 [label="Ха! Я составлю тебе список! Он исчерпывающий и в то же время неточный, постоянно переходящий от непостижимого зла к, казалось бы, неуловимой коррупции!",shape=box,color=blue];
		793 -> 792;
	794 [label="Update boolean RoatheKnowsReset2",color=orange];
		794 -> 806;
	795 [label="Сейчас тобой движет злость. Кажется, что всё сложилось из-за трусливого решения, но у тебя нет воспоминаний о том, что вывело тебя к этой точке.",shape=box,color=red];
		795 -> 807;
	796 [label="Когда-то между нами были истории, но сейчас этого нет. О чём нам говорить теперь? У тебя больше нет такой возможности.",shape=box,color=red];
		796 -> 808;
