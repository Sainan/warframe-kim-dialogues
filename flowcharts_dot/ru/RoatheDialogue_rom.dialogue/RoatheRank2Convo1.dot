		j3947376658 -> j1978770609;
	j2333903182 [label="И, что важнее всего, я гарантирую, что ты добьёшься своей цели – помочь Лиону пережить его боль, чего бы это ни стоило, на этот раз.",shape=box,color=blue];
		j2333903182 -> j62135162;
	j2281269044 [label="И, что важнее всего, я гарантирую, что ты добьёшься своей цели — убедишь Мари увидеть правду об Энтрати, чего бы это ни стоило, на этот раз.",shape=box,color=blue];
		j2281269044 -> j224465245;
	j3840243406 [label="И, что важнее всего, я гарантирую, что ты добьёшься своей цели избавить меня от этого чувства вины и этих воспоминаний, чего бы это ни стоило, на этот раз.",shape=box,color=blue];
