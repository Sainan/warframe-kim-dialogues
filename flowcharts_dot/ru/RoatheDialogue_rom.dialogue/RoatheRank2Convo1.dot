	719 [label="Во-первых: я впечатлён! Ты отнимаешь у нас все воспоминания, чтобы ещё раз попытаться завоевать его любовь?!",shape=box,color=blue];
		719 -> 734;
	720 [label="О, это просто волшебно! Так что мы лишены воспоминаний, чтобы у тебя была возможность ещё раз завоевать моё расположение?!",shape=box,color=blue];
		720 -> 735;
	721 [label="Во-первых: я впечатлён! Так мы лишены воспоминаний, чтобы у тебя была возможность ещё раз завоевать её расположение?!",shape=box,color=blue];
		721 -> 736;
	722 [label="Я прикинусь, что ничего не знаю, перед фанатиками ради тебя.",shape=box,color=blue];
		722 -> 737;
	724 [label="Ты не в курсе, он не в обиде на меня из-за чего-то?",shape=box,color=red];
