		607 -> 618 [label="RoatheDeal",color=purple];
		607 -> 618 [label="RoatheNoDeal",color=purple];
		607 -> 618 [label="false",color=purple];
	609 [label="Меня так ужасно увлекает то, что ты замышляешь вместе со мной... устроить мой собственный путь. Дьявол, так сказать, действует собственной плотью.",shape=box,color=blue];
		609 -> 619;
	608 [label="Как продвигаются дела у тебя, узурпатор? Я усердно использую ниточки и рычаги в твою пользу, хотя моё влияние, возможно, пока не заметно и не ощущается.",shape=box,color=blue];
		608 -> 619;
	610 [label="Скажи, что у тебя изменилось мнение насчёт моего предложения. Раньше я мог бы стать барьером сопротивления твоим... романтическим устремлениям? Теперь я буду послушен, как снежный барс. Хм. Если только ты этого не хочешь. Решать тебе.",shape=box,color=blue];
		610 -> 620;
	611 [label="Сообщите мне своё решение насчёт моего предложения. Я могу решить эту проблему с Мари. Обеспечить тебе лёгкое достижение ваших романтических целей с ней.",shape=box,color=blue];
		611 -> 620;
	612 [label="Сообщите мне своё решение насчёт моего предложения. Я могу решить эту проблему с Лионом. Обеспечить тебе лёгкое достижение ваших романтических целей с ним.",shape=box,color=blue];
		612 -> 620;
	613 [label="Скажи своё решение насчёт моего предложения. Где я, возможно, и раньше проявил сопротивление, когда речь шла о моём... приёме сыворотки? Я буду послушен, как снежный барс.",shape=box,color=blue];
		613 -> 620;
	614 [label="Скажи мне своё решение насчёт моего предложения. Где я мог бы стать барьером сопротивления, воссоединив дворецкого с семьёй? Я буду послушен, как снежный терриск.",shape=box,color=blue];
		614 -> 620;
	615 [label="Сообщи мне своё решение насчёт моего предложения — я могу решить эту проблему с Мари. Увидишь, что тебе будет легко общаться с ней.",shape=box,color=blue];
		615 -> 620;
	616 [label="Сообщи мне своё решение насчёт моего предложения — я могу решить эту проблему с Лионом. Увидишь, что тебе будет легко общаться с ним.",shape=box,color=blue];
		616 -> 620;
	617 [label="Не могу отделаться от мысли, что ты не просто так вмешиваешься в наши разговоры, Узурпатор. И, возможно, я смогу тебе чем-то помочь.",shape=box,color=blue];
		617 -> 621;
	618 [label="Evaluate expressions on HellStory",color=orange];
		618 -> 606 [label="x >= 21",color=purple];
		618 -> 622 [label="x < 21",color=purple];
		618 -> 622 [label="false",color=purple];
	619 [label="С моей точки зрения, это странное испытание — действовать, имея в распоряжении лишь часть своих воспоминаний, и при этом знать, что ты держишь в руках другую половину колоды.",shape=box,color=blue];
		619 -> 623;
	620 [label="Но всё это... хождение вокруг да около, чем ты занимаешься? Это просто пустая трата времени. Так что давай. Скажи слово. И твоя проблема будет решена.",shape=box,color=blue];
		620 -> 624;
		620 -> 625;
	621 [label="Скажи мне, чего ты хочешь, и давай договоримся. Вся это... суета — пустая трата времени.",shape=box,color=blue];
		621 -> 626;
	622 [label="Evaluate expressions",color=orange];
		622 -> 628 [label="RoatheDeal",color=purple];
		622 -> 627 [label="RoatheNoDeal",color=purple];
		622 -> 627 [label="false",color=purple];
	623 [label="Так что я просто продолжу, за неимением лучшего. «Кстати, как там наш маленький плавучий подхалим? Полагаю, священник всё ещё с тобой не разговаривает». Ба. Какой фарс.",shape=box,color=blue];
		623 -> 629;
		623 -> 630;
		623 -> 631;
	624 [label="Нет. Извини. Я не договариваюсь с Орокин. Ни тогда, ни сейчас, никогда.",shape=box,color=red];
		624 -> 632;
	625 [label="Очень надеюсь, ты не заставишь меня пожалеть об этом, Роут. Хорошо. Я соглашаюсь. Мне нужна твоя помощь.",shape=box,color=red];
		625 -> 633;
	626 [label="Check boolean LoidFamilyComplete",color=orange];
		626 -> 634 [label=true,color=green];
		626 -> 635 [label=true,color=green];
		626 -> 636 [label=true,color=green];
		626 -> 637 [label=true,color=green];
		626 -> 634 [label=false,color=brown];
		626 -> 635 [label=false,color=brown];
		626 -> 636 [label=false,color=brown];
		626 -> 637 [label=false,color=brown];
		626 -> 638 [label=false,color=brown];
	628 [label="Как продвигается твоя работа с нашим маленьким плавающим подхалимом? Полагаю, священник всё ещё не разговаривает с тобой.",shape=box,color=blue];
		628 -> 641;
		628 -> 642;
		628 -> 643;
	627 [label="Скажи, что ты думаешь насчёт моего предложения? Это твой последний шанс, Узурпатор. Я терпеливый дьявол, но не люблю, когда меня оставляют придерживать двери, как дурака.",shape=box,color=blue];
		627 -> 639;
		627 -> 640;
	629 [label="Пока что у меня с Мари всё в порядке.",shape=box,color=red];
		629 -> 644;
	630 [label="Нет, но он изменит своё мнение.",shape=box,color=red];
		630 -> 645;
	631 [label="Кажется, они тебе не особо нравятся. Что так?",shape=box,color=red];
		631 -> 646;
	632 [label="Как пожелаешь. Предупреждаю, это был твой последний шанс. Теперь ты в свободном плавании",shape=box,color=blue];
		632 -> 647;
	633 [label="Evaluate expressions",color=orange];
		633 -> 649 [label="RoatheDatingDealNo",color=purple];
		633 -> 650 [label="RoatheMarieDatingDealNo",color=purple];
		633 -> 651 [label="RoatheLyonDatingDealNo",color=purple];
		633 -> 652 [label="RoatheSerumDealNo",color=purple];
		633 -> 655 [label="RoatheFamilyDealNo",color=purple];
		633 -> 654 [label="RoatheMarieEntratiDealNo",color=purple];
		633 -> 653 [label="RoatheLyonConfessionDealNo",color=purple];
		633 -> 648 [label="false",color=purple];
	634 [label="У Лиона… слишком много дел, с которыми нужно разобраться. И я не знаю, как пробиться сквозь всё это.",shape=box,color=red];
		634 -> 656;
	635 [label="Мари не хочет видеть Энтрати таким, какой он есть. Все попытки донести до неё правду остаются безуспешными.",shape=box,color=red];
		635 -> 657;
	636 [label="Ну, понимаешь, у тебя есть целая история о том, почему ты принял сыворотку, а мне лишь удалось говорить не то и не ко времени.",shape=box,color=red];
		636 -> 658;
	637 [label="Немного неловко признавать, но… симпатия есть к одному из вас троих.",shape=box,color=red];
		637 -> 659;
		637 -> 660;
		637 -> 661;
	638 [label="Пытались убедить всех помочь вернуть Лойда к семье наверху и... но ничего не вышло...",shape=box,color=red];
		638 -> 662;
	641 [label="Нет, Лион... не из тех, кто много говорит.",shape=box,color=red];
		641 -> 665;
	642 [label="С Мари отношения складываются неплохо. Интересно, почему её называют подхалимкой?",shape=box,color=red];
		642 -> 666;
	643 [label="Кажется, они тебе не очень нравятся. Почему?",shape=box,color=red];
		643 -> 667;
	639 [label="Нет. Прости. Сделок с Орокин не заключают. Ни тогда, ни сейчас, ни когда-либо.",shape=box,color=red];
		639 -> 663;
	640 [label="Остаётся лишь надеяться, что об этом не придётся пожалеть. Что ж… принято.",shape=box,color=red];
		640 -> 664;
	644 [label="«Пока что». Интригует. Всё словно движется по кругу — придворные, повторяющие шаги одного и того же танца? Снова и снова, обречённые повторяться?",shape=box,color=blue];
		644 -> 668;
		644 -> 669;
	645 [label="Думаю, было бы известно, не так ли? Любопытно, что всё настолько предсказуемо. Приятно осознавать, что даже такой сломанный, как он, временами всё ещё способен быть надёжным.",shape=box,color=blue];
		645 -> 670;
	646 [label="Разве ты не знаешь? Мм. Может быть, тебя до этого момента не было. Или, может быть, у тебя не было в мыслях задавать этот вопрос ни в первый, ни в тысячный раз за время этого маленького фарса.",shape=box,color=blue];
		646 -> 670;
	647 [label="Ой. И ещё кое-что, пока я не забыл?",shape=box,color=blue];
		647 -> 671;
	649 [label="Ты действительно продаёшь свою душу дьяволу, да ещё и дважды… договорившись, чтобы я взял тебя в свою постель? Или ты жаждешь получить моё сердце, Узурпатор? Ммм. Посмотрим, но потом.",shape=box,color=blue];
		649 -> 672;
	650 [label="Когда придёт время, я позабочусь о том, чтобы у тебя была возможность завоевать нашу маленькую подхалимку, Узурпатор. Считай, что этот вопрос решён.",shape=box,color=blue];
		650 -> 673;
	651 [label="Когда придёт время, я позабочусь о том, чтобы у тебя была возможность завоевать бедного сломленного священника, Узурпатор. Считай, что этот вопрос решён.",shape=box,color=blue];
		651 -> 674;
	652 [label="Когда придёт время, я буду помнить об этом. Если у нас снова возникнут разногласия по поводу моих воспоминаний, мы не будем повторять ваши предыдущие ошибки.",shape=box,color=blue];
		652 -> 675;
	655 [label="Когда придёт время, я позабочусь, чтобы этот маленький дворецкий поднялся по ступеням. Считай, что дело сделано.",shape=box,color=blue];
		655 -> 678;
	654 [label="Считай, что твоя проблема с Мари и её льстивым обожанием Энтрати решена. Когда придёт время, я этим займусь.",shape=box,color=blue];
		654 -> 677;
	653 [label="Считай, что твоя проблема с Лионом и его ужасами решена, Узурпатор. Когда придёт время, я этим займусь.",shape=box,color=blue];
		653 -> 676;
	648 [label="Я... кажется забыл, что именно было тебе нужно. Всё благодаря твоему вмешательству в мои воспоминания. Итак, что это было?",shape=box,color=blue];
		648 -> 626;
	656 [label="Я бы посоветовал простое терпение, но… не мне учить тебя пользоваться зубилом, когда у тебя под рукой лазер.",shape=box,color=blue];
		656 -> 679;
	657 [label="Хм. Понимаю. Благородное начинание, если честно. Я сам пытался сделать это бесчисленное множество раз. И столько же раз проваливался.",shape=box,color=blue];
		657 -> 680;
	658 [label="Хм.",shape=box,color=blue];
		658 -> 681;
	659 [label="Лион.",shape=box,color=red];
		659 -> 682;
	660 [label="... Ты.",shape=box,color=red];
		660 -> 683;
	661 [label="Мари.",shape=box,color=red];
		661 -> 684;
	662 [label="Хм. Понимаю. У нас была договоренность, но из-за твоего несоблюдения своей части сделки, твоё вознаграждение исчезло.",shape=box,color=blue];
		662 -> 685;
	665 [label="Когда он говорит, его речь обычно можно отнести к двум категориям - либо ужасно бессмысленные, либо ужасно сумасшедшие.",shape=box,color=blue];
		665 -> 688;
	666 [label="Хм? Тебе удалось избежать этого? Я страшно тебе завидую. Но скоро тебя всё равно накроет взрывной волной, поэтому лучше предупредить тебя.",shape=box,color=blue];
		666 -> 689;
	667 [label="Мой бедный Скиталец. Разве ты забыл, как строго мы, Орокин, отвергали всякое почитание божеств? Единственное, чему мы поклонялись, это себе.",shape=box,color=blue];
		667 -> 690;
	663 [label="Как пожелаешь. Предупреждаю, твоё решение не останется без последствий.",shape=box,color=blue];
		663 -> 686;
	664 [label="Веди себя хорошо и помоги мне отправить Лойда подняться наверх и помириться с семьёй. И я помогу тебе разобраться с твоими воспоминаниями.",shape=box,color=red];
		664 -> 687;
	668 [label="Это не значит, что тебе не хватает инициативы. Это просто означает, что для некоторых вещей может потребоваться несколько попыток.",shape=box,color=red];
		668 -> 691;
	669 [label="Надеюсь, это тебя не расстроит.",shape=box,color=red];
		669 -> 692;
	670 [label="Неужели мы все обречены повторяться, словно придворные, повторяющие движения танца?",shape=box,color=blue];
		670 -> 668;
		670 -> 669;
	671 [label="Не так давно я доверил тебе страшную правду. Теперь не могу вспомнить зачем.",shape=box,color=blue];
		671 -> 693;
	672 [label="Update boolean RoatheFamilyDealNo",color=orange];
		672 -> 694;
	673 [label="Update boolean RoatheFamilyDealNo",color=orange];
		673 -> 695;
	674 [label="Update boolean RoatheLyonDatingDealNo",color=orange];
		674 -> 696;
	675 [label="Update boolean RoatheSerumDealNo",color=orange];
		675 -> 697;
	678 [label="Update boolean RoatheFamilyDealNo",color=orange];
		678 -> 700;
	677 [label="Update boolean RoatheMarieEntratiDealNo",color=orange];
		677 -> 699;
	676 [label="Update boolean RoatheLyonConfessionDealNo",color=orange];
		676 -> 698;
	679 [label="Кажется, я начинаю понимать, почему наша память была стёрта. Видя все свои неудачные попытки и усилия... почему бы не попробовать всё сначала?",shape=box,color=blue];
		679 -> 701;
	680 [label="Видя в отчаянии, что ты больше не можешь убедить её в простой истине вещей, тебе нужно прибегнуть к тому, что было - используя этот твой... дар.",shape=box,color=blue];
		680 -> 702;
	681 [label="Мне не нравится, что ты засоряешь мне мозги, чтобы исправить свои ошибки, Скиталец. Однако, если ты пытаешься сделать это ради меня... полагаю, наверное, это приемлемо.",shape=box,color=blue];
		681 -> 703;
	682 [label="Update boolean DrifterLyon",color=orange];
		682 -> 704;
	683 [label="Update boolean DrifterRoathe",color=orange];
		683 -> 705;
	684 [label="Update boolean DrifterMarie",color=orange];
		684 -> 706;
	685 [label="Итак, зная, что вы больше не можете достичь того, что раньше было в ваших силах, вы прибегаете к тому было - используя этот... свой дар.",shape=box,color=blue];
		685 -> 707;
	688 [label="Всегда как подбрасывание монетки, никогда не знаешь, какой стороной выпадет, и я так и не могу решить, какая мне нравится больше.",shape=box,color=blue];
		688 -> 710;
	689 [label="Эта женщина неиссякаема в своей непоколебимой и навязчивой преданности Альбрехту. Я бы сказал, дворецкому стоило бы насторожиться, но, честно говоря, я искренне уверен, что это чистая преданность. И это говорю я.",shape=box,color=blue];
		689 -> 711;
	690 [label="Эти двое фанатиков и двух минут не могут прожить без своего «Сола» да и «Луа», или без того, чтобы не попытаться освятить ночной горшок.",shape=box,color=blue];
		690 -> 712;
	686 [label="Update boolean RoatheFamilyFail",color=orange];
		686 -> 708;
	687 [label="+5 Chemistry",color=orange];
		687 -> 709;
	691 [label="Меня забавляет твой оптимизм. Герои. Вот вы все такие, честное слово. Мешки с мясом и костями, раздутые и управляемые исключительно оптимизмом и надеждой. От этого зубы сводит.",shape=box,color=blue];
		691 -> 713;
	692 [label="Нет, ты меня неправильно понимаешь. В некотором смысле это даже успокаивает. Это означает, что, даже если разобрать нас на составляющие, мы все равно остаемся прежними. Мы не можем измениться.",shape=box,color=blue];
		692 -> 714;
	693 [label="Вы оба единственные души, которым я, возможно, когда-либо надеялся доверять... и теперь я не могу вспомнить, почему я осмелился.",shape=box,color=blue];
		693 -> 715;
	694 [label="Update boolean RoatheFamilyDeal",color=orange];
		694 -> 716;
	695 [label="Update boolean RoatheFamilyDeal",color=orange];
		695 -> 716;
