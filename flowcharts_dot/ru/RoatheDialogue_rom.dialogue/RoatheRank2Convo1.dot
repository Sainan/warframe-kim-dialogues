		766 -> 782;
	767 [label="Chat ends.",color=orange];
	768 [label="Вы оба единственные души, которым я, возможно, когда-либо надеялся доверять... и теперь я не могу вспомнить, почему я осмелился.",shape=box,color=blue];
		768 -> 784;
	769 [label="Но запомни мои слова, Скиталец: Ты. Останешься. У меня. В долгу.",shape=box,color=blue];
		769 -> 785;
	770 [label="И, что важнее всего, я гарантирую, что ты добьёшься своей цели – воссоединиться с твоим дорогим отцом Лионом Аллардом, когда придёт время.",shape=box,color=blue];
		770 -> 786;
	771 [label="И, что важнее всего, я гарантирую, что ты добьёшься своей цели — объединить нас, когда придёт время... и я с нетерпением этого жду.",shape=box,color=blue];
		771 -> 787;
	772 [label="И, что важнее всего, я гарантирую, что ты добьёшься своей цели воссоединиться с «маленькой Мари», когда придёт время.",shape=box,color=blue];
		772 -> 788;
	774 [label="Нет, с чего бы мне? До меня дошли слухи, что Лиону нравится тот странный шоколад, который был в его эпоху. Говорят, он успокаивает его видения.",shape=box,color=blue];
		774 -> 789;
	775 [label="Шоколадом. Ты подкупаешь его, принося ему шоколад, Узурпатор. Я слышал, что это успокаивает его видения.",shape=box,color=blue];
		775 -> 789;
	776 [label="Я слышал, что в его время было обычным дарить священнослужителям коробку шоколада. Кроме того, я слышал, что шоколад успокаивает его видения.",shape=box,color=blue];
		776 -> 789;
	777 [label="Задумайся вот над чем - если она может уставиться правде в самую морду и всё равно отрицать её вместе с Альбрехтом, то она легко проделает то же самое и с куда более опасными штуками.",shape=box,color=blue];
		777 -> 790;
	778 [label="+15 Chemistry",color=orange];
		778 -> 791;
