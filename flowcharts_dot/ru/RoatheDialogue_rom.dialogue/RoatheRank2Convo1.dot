	5763 [label="And, more importantly - I will ensure that you will succeed in your goal of seeing Lyon through his pain, no matter what, this time around.",shape=box,color=blue];
		5763 -> 5764;
	732 [label="И, что важнее всего, я гарантирую, что ты добьёшься своей цели — убедишь Мари увидеть правду об Энтрати, чего бы это ни стоило, на этот раз.",shape=box,color=blue];
		732 -> 747;
	733 [label="И, что важнее всего, я гарантирую, что ты добьёшься своей цели избавить меня от этого чувства вины и этих воспоминаний, чего бы это ни стоило, на этот раз.",shape=box,color=blue];
		733 -> 748;
	734 [label="Как же это в духе Орокин.",shape=box,color=blue];
