		j2793194243 -> j1857307659;
	j2213839066 [label="Ах да, конечно. Он смертельно был обижен в тот самый момент, как только был пересечён порог тобой сюда. У меня просто не хватало духу сказать тебе об этом.",shape=box,color=blue];
