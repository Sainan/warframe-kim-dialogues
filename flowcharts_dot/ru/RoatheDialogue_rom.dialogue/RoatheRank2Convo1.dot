		800 -> 812;
	799 [label="Это может быть непросто. Есть ли у Лиона ещё какие-нибудь просьбы, которым можно... помочь исполниться?",shape=box,color=red];
		799 -> 811;
	801 [label="Ты не знаешь, каково это, когда эти фанатики висят над плечом днём и ночью, орут и читают наставления о том, что нужно покаяться.",shape=box,color=blue];
		801 -> 758;
		801 -> 759;
		801 -> 760;
		801 -> 761;
	802 [label="Я знаю, что мы на пределе. Я чувствую, как мой собственный разум сопротивляется мне. Ты делаешь всё возможное, чтобы помочь мне вернуть мои воспоминания. И за это я благодарю. ",shape=box,color=blue];
		802 -> 813;
	803 [label="Мы лишь начинаем раскрывать крошечные обрывки того, что было заперто от меня. Не знаю, что Альбрехт поведал им о моих преступлениях, Скиталец. ",shape=box,color=blue];
		803 -> 814;
	804 [label="Мы лишь начали царапать поверхность того, что было заперто от меня. Не знаю, что Альбрехт сообщил им о моих преступлениях, Скиталец.",shape=box,color=blue];
		804 -> 814;
	805 [label="Я не знаю, что Альбрехт рассказал им о моих преступлениях, ведь они скрыты даже от меня. Истина сокрыта в моих воспоминаниях, Скиталец.",shape=box,color=blue];
		805 -> 814;
	806 [label="Не так давно я доверил тебе страшную правду. Теперь не могу вспомнить зачем.",shape=box,color=blue];
		806 -> 815;
	807 [label="Я знаю, что где-то под поверхностью, внутри пылает настоящий пожар. И я знаю, что нам нужно достичь определённой точки, прежде чем мы сможем всё обсудить.",shape=box,color=red];
		807 -> 816;
	808 [label="И почему ты мне доверяешь? Всё, что ты обо мне знаешь, это то, что... твои воспоминания подверглись моей манипуляции.",shape=box,color=red];
		808 -> 817;
	809 [label="Update boolean RoatheKnowsReset2",color=orange];
		809 -> 818;
	810 [label="Ну, если ты не собираешься быть занудой, Скиталец, то зачем мне тратить на тебя время? У меня уже есть фанатики, и, похоже, мне придётся с ними общаться.",shape=box,color=blue];
		810 -> 819;
	812 [label="Ах, значит, она тебе рассказала. Ну конечно рассказала. И вообще, это едва ли моя вина! Эти чёртовы лакомства были единственным хорошим в этой проклятой дыре глухомани.",shape=box,color=blue];
		812 -> 821;
		812 -> 822;
	811 [label="+5 Chemistry",color=orange];
		811 -> 820;
	813 [label="Мне нужно знать, что у меня отняли, Скиталец. Мне нужно понять, что Альбрехт украл у меня, когда навязал мне эту сыворотку.",shape=box,color=blue];
		813 -> 823;
		813 -> 824;
	814 [label=" Мне нужно понять, что Альбрехт украл у меня, когда навязал мне эту сыворотку. Мне нужно узнать, что заперто у меня в голове, Скиталец. Конечно, когда тебе будет не в тягость, разумеется...",shape=box,color=blue];
		814 -> 825;
		814 -> 826;
	815 [label="Вы оба единственные души, к которым у меня вообще могло появиться доверие... и теперь я не понимаю, что придало мне смелости.",shape=box,color=blue];
		815 -> 827;
	816 [label="И с чего бы мне злиться, Скиталец?",shape=box,color=blue];
		816 -> 828;
		816 -> 829;
		816 -> 830;
	817 [label="«Подправил мою память». Будто я какая-нибудь скульптура Аятан, с которой решили пошутить. То, что произошло, было гораздо больше, чем «подправление». Это была полная очистка памяти.",shape=box,color=blue];
