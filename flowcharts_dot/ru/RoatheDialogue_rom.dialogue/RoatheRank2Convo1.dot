	j2316556891 [label="Меня забавляет твой оптимизм. Герои. Вот вы все такие, честное слово. Мешки с мясом и костями, раздутые и управляемые исключительно оптимизмом и надеждой. От этого зубы сводит.",shape=box,color=blue];
		j2316556891 -> j3541932656;
	j3707203840 [label="Нет, ты меня неправильно понимаешь. В некотором смысле это даже успокаивает. Это означает, что, даже если разобрать нас на составляющие, мы все равно остаемся прежними. Мы не можем измениться.",shape=box,color=blue];
		j3707203840 -> j2631304166;
