		j3937601473 -> j102312879;
	j762038114 [label="Но, процитировать эту маленькую парящую подхалимку? C'est la vie. Кстати, как у неё дела? Полагаю, священнослужительница с тобой до сих пор не разговаривает.",shape=box,color=blue];
