	"Chat ends." [color=orange];
	j3638581447 [label="Вы оба единственные души, которым я, возможно, когда-либо надеялся доверять... и теперь я не могу вспомнить, почему я осмелился.",shape=box,color=blue];
		j3638581447 -> j1408546186;
	j903583671 [label="Но запомни мои слова, Скиталец: Ты. Останешься. У меня. В долгу.",shape=box,color=blue];
		j903583671 -> j2468352921;
	j856271239 [label="И, что важнее всего, я гарантирую, что ты добьёшься своей цели – воссоединиться с твоим дорогим отцом Лионом Аллардом, когда придёт время.",shape=box,color=blue];
		j856271239 -> j2112439823;
	j2940585795 [label="И, что важнее всего, я гарантирую, что ты добьёшься своей цели — объединить нас, когда придёт время... и я с нетерпением этого жду.",shape=box,color=blue];
		j2940585795 -> j849826408;
	j3067394402 [label="И, что важнее всего, я гарантирую, что ты добьёшься своей цели воссоединиться с «маленькой Мари», когда придёт время.",shape=box,color=blue];
		j3067394402 -> j3355928968;
	j1473972572 [label="Нет, с чего бы мне? До меня дошли слухи, что Лиону нравится тот странный шоколад, который был в его эпоху. Говорят, он успокаивает его видения.",shape=box,color=blue];
		j1473972572 -> j3200144113;
	j3185864135 [label="Шоколадом. Ты подкупаешь его, принося ему шоколад, Узурпатор. Я слышал, что это успокаивает его видения.",shape=box,color=blue];
		j3185864135 -> j3200144113;
	j4104141310 [label="Я слышал, что в его время было обычным дарить священнослужителям коробку шоколада. Кроме того, я слышал, что шоколад успокаивает его видения.",shape=box,color=blue];
		j4104141310 -> j3200144113;
	j3497033458 [label="Задумайся вот над чем - если она может уставиться правде в самую морду и всё равно отрицать её вместе с Альбрехтом, то она легко проделает то же самое и с куда более опасными штуками.",shape=box,color=blue];
		j3497033458 -> j3779037975;
	j3818456806 [label="+15 Chemistry",color=orange];
		j3818456806 -> j9723046;
	j2284540455 [label="И с какой стати они вообще должны хоть что-то в этом понимать? Нет, мой Узурпатор.",shape=box,color=blue];
		j2284540455 -> j3142907957;
	j2519027287 [label="+15 Chemistry",color=orange];
		j2519027287 -> j961755303;
	j4089518897 [label="Теперь, когда мы это уладили и разобрались, как продвигается твоя работа с нашим маленьким плавающим подхалимом? Полагаю, священник всё ещё не разговаривает с тобой.",shape=box,color=blue];
		j4089518897 -> j213029716;
