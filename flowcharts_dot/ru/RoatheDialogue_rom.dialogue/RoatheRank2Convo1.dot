	819 [label="Update boolean RoatheRank2Convo1Complete",color=orange];
		819 -> 834;
	821 [label="Так это правда. Ты всерьёз думаешь отправиться в Gaule воровать шоколад? При этом выглядя...?",shape=box,color=red];
		821 -> 836;
	822 [label="Как именно вы их получили?",shape=box,color=red];
		822 -> 837;
	820 [label="Ха! Вот это по мне. Проклятые шоколадки были единственным хорошим в той проклятой дыре глухомани.",shape=box,color=blue];
		820 -> 835;
	823 [label="Я обещаю.",shape=box,color=red];
