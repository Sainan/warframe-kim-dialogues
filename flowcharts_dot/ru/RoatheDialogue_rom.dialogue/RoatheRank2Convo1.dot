		j2213839066 -> j261653034;
	j412219672 [label="Именно. Я не уверен, то ли один из этих примитивных кайтов пнул её в детстве по голове, то ли ей действительно так отчаянно не хватало отцовской фигуры, я не знаю.",shape=box,color=blue];
		j412219672 -> j3699054396;
	j1823331877 [label="Вроде как отец, может быть. Или что-то святое. Понятия не имею, то ли один из тех примитивных кайтов их эпохи в детстве двинул её по голове, то ли она остро нуждалась в наставниках, я не знаю.",shape=box,color=blue];
		j1823331877 -> j3699054396;
