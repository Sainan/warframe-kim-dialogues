	825 [label="Я справлюсь.",shape=box,color=red];
		825 -> 840;
	826 [label="Я стараюсь. Но ты не облегчаешь задачу.",shape=box,color=red];
		826 -> 841;
	827 [label="Осознай, кем ты являешься для меня на самом деле.",shape=box,color=blue];
		827 -> 842;
	828 [label="Говорилось, что никакой злости из-за стирания памяти у тебя нет, но я понимаю, что это лишь слова. Потому что… такое уже бывало.",shape=box,color=red];
		828 -> 843;
	829 [label="Потому что ты ненавидишь себя за то, что сыворотка была принята добровольно. Ты ненавидишь себя, и это приводит тебя в ярость, потому что ты - это всё, что у тебя осталось.",shape=box,color=red];
		829 -> 844;
	830 [label="Утверждалось, что злости за утрату воспоминаний нет, но непонятно, как вообще можно не быть в ярости после такого.",shape=box,color=red];
		830 -> 844;
	831 [label="Ничего по-настоящему ценного утрачено не было, лишь наши разговоры.",shape=box,color=red];
		831 -> 845;
	832 [label="Но не всего, только наших разговоров здесь. У тебя осталось всё остальное, даже то, что мы восстановили в «Спуске».",shape=box,color=red];
		832 -> 845;
	833 [label="Chat ends.",color=orange];
	834 [label="Chat ends.",color=orange];
	836 [label="Да, с голубой кожей, хвостом, заражённой плотью и всем остальным. Поразительно, на что способны плащ, шляпа и маска.",shape=box,color=blue];
		836 -> 847;
	837 [label="Это оказалось проще простого. К тому же, будучи «протофреймом» и боевым представителем элиты Орокин, можно без труда умыкнуть несколько сладостей на рынке, не привлекая внимания стражи.",shape=box,color=blue];
		837 -> 848;
	835 [label="Прежде чем ты спросишь, лучше пусть эту историю расскажет Мари, иначе фанатики снова начнут на меня орать и нести бред.",shape=box,color=blue];
		835 -> 846;
	838 [label="Обещания дьяволу... опасная вещь.",shape=box,color=blue];
		838 -> 849;
	839 [label="И терпение у меня тоже есть, ещё какое.",shape=box,color=blue];
		839 -> 849;
	840 [label="Убедись, что сделаешь это.",shape=box,color=blue];
		840 -> 850;
	841 [label="Конечно, нет! Что в этом веселого?",shape=box,color=blue];
		841 -> 850;
	842 [label="Update boolean RoatheKnowsReset2",color=orange];
		842 -> 851;
	843 [label="Как это чудесно и очаровательно! И удивления никакого! И какое мне дело, правда это или нет?! И кроме того -",shape=box,color=blue];
		843 -> 844;
	844 [label="Неправильно! Ошибочно, захватывающе, божественно неправильно! Не говори со мной так, будто знаешь все тонкости ярости, которые, я думаю, ты даже не можешь постичь.",shape=box,color=blue];
		844 -> 746;
	845 [label="Не смей говорить мне, что ценно в моём сознании, а что нет, Скиталец. Это не чья-то собственность, чтобы на неё можно было предъявлять права.",shape=box,color=blue];
		845 -> 746;
	847 [label="Люди быстро отмахиваются от тех, кого не хотят видеть. К тому же, будучи «протофреймом» и боевым представителем элиты Орокин, можно без труда умыкнуть несколько сладостей на рынке, не привлекая внимания стражи.",shape=box,color=blue];
		847 -> 852;
	848 [label="Да, с голубой кожей, хвостом, заражённой плотью и всем остальным. Поразительно, на что способны плащ, шляпа и маска.",shape=box,color=blue];
		848 -> 852;
	846 [label="Они кричат и вопят на меня о грехе и о том, что мне нужно достаточно раскаяться, не добавляя к этому ещё и «очередную ложь о своей версии истории».",shape=box,color=blue];
		846 -> 758;
		846 -> 759;
		846 -> 760;
		846 -> 761;
	849 [label="Update boolean RoatheRank2Convo1Complete",color=orange];
		849 -> 853;
	850 [label="Update boolean RoatheRank2Convo1Complete",color=orange];
		850 -> 854;
	851 [label="Update boolean RoatheRank2Convo1Complete",color=orange];
		851 -> 855;
	852 [label="Update boolean RoatheMariePastry1",color=orange];
		852 -> 856;
		852 -> 857;
	853 [label="Chat ends.",color=orange];
	854 [label="Chat ends.",color=orange];
	855 [label="Chat ends.",color=orange];
	856 [label="И всё же этого оказывалось достаточно для Мари и Лиона?",shape=box,color=red];
		856 -> 858;
	857 [label="То есть в итоге пирожные просто оказались у тебя.",shape=box,color=red];
		857 -> 859;
	858 [label="Ах. Ожидалось, что я возьму себе достаточно, а их оставлю ни с чем? Просто потому, что мне не нравится их общество, и я хочу от них избавиться?",shape=box,color=blue];
		858 -> 860;
	859 [label="Всё на этой планете вскоре должно было принадлежать Империи Орокин. В любом случае, она принадлежала мне по праву.",shape=box,color=blue];
		859 -> 861;
	860 [label="Полагаешь, что моя неприязнь к ним каким-то образом обязывает меня проявлять жестокость. Дьявол, и, следовательно, склонность к жестокости, такова логика, которую ты проводишь.",shape=box,color=blue];
		860 -> 862;
	861 [label="К тому же, у меня не было денег. Что мне ещё оставалось делать?",shape=box,color=blue];
		861 -> 863;
	862 [label="Как же это разочаровывает. Такие поверхностные поступки свойственны исключительно примитивным и школьным хулиганам. ",shape=box,color=blue];
		862 -> 864;
	863 [label="И я знаю, что ты пробираешься сквозь корабли и берёшь всё, что тебе нужно или хочется, — не надо смотреть на меня так невинно, Узурпатор.",shape=box,color=blue];
		863 -> 865;
		863 -> 866;
	864 [label="Ненавижу их. И всё же мне приходится с ними сосуществовать. Не хочу, чтобы они лишились этого дурацкого пирожного. Это всего лишь пирожное. Зачем так без нужды усугублять ситуацию?",shape=box,color=blue];
		864 -> 867;
		864 -> 868;
		864 -> 869;
	865 [label="Забудь. ",shape=box,color=red];
		865 -> 870;
	866 [label="Я думаю, это справедливо.",shape=box,color=red];
		866 -> 871;
	867 [label="Или попробуй проявлять доброжелательность к ним просто так.",shape=box,color=red];
		867 -> 872;
	868 [label="Итак, чтобы уточнить - доброе отношение возникло из-за ненависти к ним.",shape=box,color=red];
		868 -> 873;
	869 [label="Никогда об этом не приходилось думать в таком ключе.",shape=box,color=red];
		869 -> 874;
	870 [label="Прекрасно. Ещё один, кто не способен признать чужую правоту. Как будто мало было фанатиков, которые кричали на меня круглосуточно, умоляя покаяться.",shape=box,color=blue];
		870 -> 758;
		870 -> 759;
		870 -> 760;
		870 -> 761;
	871 [label="+5 Chemistry",color=orange];
		871 -> 875;
	872 [label="Да, попробуй сам послушать их бесконечное жужжание, когда они день и ночь бормочут проклятия и требуют покаяния.",shape=box,color=blue];
		872 -> 758;
		872 -> 759;
		872 -> 760;
		872 -> 761;
	873 [label="Именно. Что тут такого сложного для понимания? И да, я вижу твой сарказм, Узурпатор. Но не волнуйся, меня это забавляет.",shape=box,color=blue];
		873 -> 876;
	874 [label="+5 Chemistry",color=orange];
		874 -> 877;
	875 [label="Благодарю. Наконец-то кто-то способен признать очевидное. Если бы те два фанатика могли сделать то же самое, им бы не удалось часами орать, требуя покаяния.",shape=box,color=blue];
		875 -> 758;
		875 -> 759;
		875 -> 760;
		875 -> 761;
	876 [label="Это по крайней мере лучше, чем бесконечные, мерзкие проповеди фанатиков - которые постоянно ругаются и требуют покаяния.",shape=box,color=blue];
		876 -> 758;
		876 -> 759;
		876 -> 760;
		876 -> 761;
	877 [label="Не за что. Как же приятно общаться с кем-то, кто способен менять точку зрения. Если бы те два фанатика могли сделать то же самое, они бы не вопили на меня круглые сутки, умоляя покаяться.",shape=box,color=blue];
		877 -> 758;
		877 -> 759;
		877 -> 760;
		877 -> 761;
}