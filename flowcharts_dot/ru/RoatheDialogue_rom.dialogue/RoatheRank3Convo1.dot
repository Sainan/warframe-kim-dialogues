digraph {
	"RoatheRank3Convo1 begins." [color=orange];
		"RoatheRank3Convo1 begins." -> j1128718241;
	j1128718241 [label="Удалось ли тебе наконец поговорить с нашим дорогим Лионом? Или он все ещё морочит тебе голову? Честно, тебе, возможно, лучше держаться на расстоянии.",shape=box,color=blue];
		j1128718241 -> j3468721947;
		j1128718241 -> j251892302;
		j1128718241 -> j1310452999;
	j3468721947 [label="Ты с ним плохо ладишь?",shape=box,color=red];
		j3468721947 -> j2562785836;
	j251892302 [label="Если бы отношение к Мари и Лиону было немного мягче, возможно, и они отвечали бы тебе тем же.",shape=box,color=red];
		j251892302 -> j2355591431;
	j1310452999 [label="[Конец.]",shape=box,color=red];
		j1310452999 -> "Chat ends.";
	j2562785836 [label="Ладить с ним было бы проще, прояви он хоть малейшее стремление понять, с кем имеет дело и откуда мой путь. Я остаюсь тем, кем являюсь И так было веками. Я не собираюсь меняться только потому, что меня сейчас об этом просят.",shape=box,color=blue];
		j2562785836 -> j3060654953;
	j2355591431 [label="А как насчёт их доброжелательности ко мне, Узурпатор? Я остаюсь тем, кем являюсь. И так было веками. Я не собираюсь меняться только потому, сейчас они этого требуют.",shape=box,color=blue];
		j2355591431 -> j3060654953;
	"Chat ends." [color=orange];
	j3060654953 [label="Evaluate expressions on HellStory counter",color=orange];
		j3060654953 -> j4149315975 [label="x >= 21",color=purple];
		j3060654953 -> j3113959199 [label="x < 21",color=purple];
		j3060654953 -> j3113959199 [label="false",color=purple];
	j4149315975 [label="Да, возможно, решение принять сыворотку было моим, но терпеть бесконечные оскорбления от этих двух неблагодарных существ, точно не входили в условия.  ",shape=box,color=blue];
		j4149315975 -> j3144475956;
	j3113959199 [label="Это вина Альбрехта, что сделал меня таким! Это его вина, что я застрял здесь с ними, а не моя! Я не имею никакого отношения к этой ужасной сделке!",shape=box,color=blue];
		j3113959199 -> j3144475956;
	j3144475956 [label="Пусть они идут жаловаться своему драгоценному «кардиналу», а не мне.",shape=box,color=blue];
		j3144475956 -> j1155583224;
		j3144475956 -> j1499601260;
		j3144475956 -> j205411976;
	j1155583224 [label="Они имеют благие намерения, даже если делают это не лучшим образом.",shape=box,color=red];
		j1155583224 -> j1434326974;
	j1499601260 [label="Ты правда не чувствуешь, что тебе есть за что просить прощения?",shape=box,color=red];
		j1499601260 -> j1995601805;
	j205411976 [label="Они просто пытаются тебе помочь.",shape=box,color=red];
		j205411976 -> j2073307759;
	j1434326974 [label="Add -1 to Thermostat counter",color=orange];
		j1434326974 -> j1819979920;
	j1995601805 [label="Add 1 to Thermostat counter",color=orange];
		j1995601805 -> j3488276860;
	j2073307759 [label="«Помощь». Да. «Помощь». Прости, но их стиль этой самой «помощи» я нахожу глубоко «бесполезным».",shape=box,color=blue];
		j2073307759 -> j3666450801;
	j1819979920 [label="Да, в этом и заключается вся трагедия. Они искренне верят, что пытаются делать «добро».",shape=box,color=blue];
		j1819979920 -> j1435287724;
	j3488276860 [label="Прощение от кого? От тебя? От них? Дворецким? Альбрехтом? Или «богами»?",shape=box,color=blue];
		j3488276860 -> j1775352227;
		j3488276860 -> j3672447182;
		j3488276860 -> j693593856;
	j3666450801 [label="На самом деле, было бы куда «полезнее», если бы они заменили моё вино на едкое вяжущее средство, Узурпатор.",shape=box,color=blue];
		j3666450801 -> j2569138268;
	j1435287724 [label="А ты что об этом думаешь? Ты веришь, что мне нужно «великое искупление»? «Божественное прощение»?",shape=box,color=blue];
		j1435287724 -> j937239071;
	j1775352227 [label="Ты забываешь об одном важном моменте в этом списке.",shape=box,color=red];
		j1775352227 -> j1833452099;
	j3672447182 [label="Ты Орокин. Ужасы были неотъемлемой частью и войны и просто по природе своей системы. Тебе есть что искупать.",shape=box,color=red];
		j3672447182 -> j3506973939;
	j693593856 [label="Ты хотя бы признаёшь, что тобою были совершены страшные поступки?",shape=box,color=red];
		j693593856 -> j3003407202;
	j2569138268 [label="Это хотя бы было бы эффективнее.",shape=box,color=blue];
		j2569138268 -> j533336798;
	j937239071 [label="Evaluate expressions",color=orange];
		j937239071 -> j1545969124 [label="RoatheTraitor2",color=purple];
		j937239071 -> j2791153523 [label="RoatheTraitor2",color=purple];
		j937239071 -> j1054045061 [label="RoatheTraitor2",color=purple];
		j937239071 -> j1119189052 [label="RoatheTraitor2",color=purple];
		j937239071 -> j1545969124 [label="RoatheTraitor1",color=purple];
		j937239071 -> j2791153523 [label="RoatheTraitor1",color=purple];
		j937239071 -> j1054045061 [label="RoatheTraitor1",color=purple];
		j937239071 -> j1119189052 [label="RoatheTraitor1",color=purple];
		j937239071 -> j1545969124 [label="RoatheExecutor2",color=purple];
		j937239071 -> j2791153523 [label="RoatheExecutor2",color=purple];
		j937239071 -> j1054045061 [label="RoatheExecutor2",color=purple];
		j937239071 -> j1119189052 [label="RoatheExecutor2",color=purple];
		j937239071 -> j1545969124 [label="false",color=purple];
		j937239071 -> j2791153523 [label="false",color=purple];
		j937239071 -> j1054045061 [label="false",color=purple];
	j1833452099 [label="Пожалуйста, скажи. ",shape=box,color=blue];
		j1833452099 -> j444479973;
		j1833452099 -> j2043545472;
		j1833452099 -> j66469302;
	j3506973939 [label="Я не буду извиняться за общество Орокин, его создание не моих рук дело. Я всего лишь его житель. И если, по-твоему, виноваты все, кто просто оказался рождённым в такой системе, то ты одним махом запишешь в преступники миллиарды. А как насчёт остального?",shape=box,color=blue];
		j3506973939 -> j2788327803;
	j3003407202 [label="И что, если это так? Я не могу сейчас их изменить. Какой смысл испытывать чувство вины?",shape=box,color=blue];
		j3003407202 -> j1353426822;
		j3003407202 -> j1290689213;
	j533336798 [label="Хотя из них двоих я все равно предпочитаю священника. Он прислушивается к голосу разума. Возможно, он просто осознаёт, что Безразличие не настоящий бог.",shape=box,color=blue];
		j533336798 -> j4229751179;
	j1545969124 [label="Я думаю, стоит задуматься о наших поступках, которые причинили вред людям, и попытаться понять, как это исправить. Но я совсем не верю, что эти двое справляются с этим должным образом.",shape=box,color=red];
		j1545969124 -> j3849594100;
	j2791153523 [label="В конце концов, я не верю, что нужно прощать кого-либо, кроме себя. Если ты не против своих поступков? Пусть будет так.",shape=box,color=red];
		j2791153523 -> j1460924183;
	j1054045061 [label="Ты происходишь из общества, где многое из поведения Орокин было просто... нормальным. Ожидаемым. Для тебя это не было чем-то «неправильным». Я не говорю, что это оправдывает их, просто это было понятным.",shape=box,color=red];
		j1054045061 -> j2363455260;
	j1119189052 [label="У тебя был замысел свергнуть Орокин. Их испорченность была очевидна, и шаги к исправлению положения предпринимались сознательно.",shape=box,color=red];
		j1119189052 -> j685147065;
	j444479973 [label="Ты сам.",shape=box,color=red];
		j444479973 -> j959970570;
	j2043545472 [label="Твой собственный народ, свержение которого входило в твои планы.",shape=box,color=red];
		j2043545472 -> j3588044936;
	j66469302 [label="Владеющие Разумом, чья гибель произошла по твоей вине.",shape=box,color=red];
		j66469302 -> j2788327803;
	j2788327803 [label="Это была война. А на войне, по определению, ты убиваешь как можно больше врагов. Ты оплакиваешь Гринир или «Корпус», которых убиваешь?",shape=box,color=blue];
		j2788327803 -> j2052350962;
		j2788327803 -> j3131767866;
		j2788327803 -> j3039481951;
	j1353426822 [label="Прощение других важно.",shape=box,color=red];
		j1353426822 -> j578506347;
	j1290689213 [label="Ты можешь изменить своё будущее поведение.",shape=box,color=red];
		j1290689213 -> j684227076;
	j4229751179 [label="На самом деле, я, возможно, ещё смогу убедить его увидеть всю его религию насквозь - представь себе. Человек, который видит причудливые и кровавые галлюцинации, но при этом способен воспринимать логику и разум. Какая редкость.",shape=box,color=blue];
		j4229751179 -> j3251942444;
		j4229751179 -> j348688821;
	j3849594100 [label="Хм. Понимаю. Для тебя проблема не в действии, а в методе. Тогда я снимаю своё прежнее одобрение и заменяю его возмущением.",shape=box,color=blue];
		j3849594100 -> "Chat ends.";
	j1460924183 [label="Boolean RoatheVillainSelf is now true.",color=orange];
		j1460924183 -> j1274172877;
	j2363455260 [label="Boolean RoatheVillainOrokin is now true.",color=orange];
		j2363455260 -> j1274172877;
	j685147065 [label="Так что, думаю, даже если бы у тебя появилось желание что-то переделать по своему образу и подобию, необходимость подобного шага всё равно была бы очевидна.",shape=box,color=red];
		j685147065 -> j1974563575;
		j685147065 -> j2966162415;
	j959970570 [label="Check boolean RoatheKnowsReset2",color=orange];
		j959970570 -> j3362529679 [label=true,color=green];
		j959970570 -> j3911874856 [label=false,color=brown];
	j3588044936 [label="Ни разу не было такого, чтобы чувство вины лишило меня сна из-за замысла против собственного народа, Узурпатор. Поверь мне.",shape=box,color=blue];
		j3588044936 -> j2676204232;
	j2052350962 [label="Нет. Но с Владеющими Разумом дела обстоят иначе.",shape=box,color=red];
		j2052350962 -> j1744094279;
	j3131767866 [label="Да. Я вижу.",shape=box,color=red];
		j3131767866 -> j3704668335;
	j3039481951 [label="Что я думаю о жизнях, которые мне приходится отнимать, это моё личное дело. Мы говорим о тебе.",shape=box,color=red];
		j3039481951 -> j181574098;
	j578506347 [label="Зачем? Чтобы меня оставили в покое? Чтобы не стать какой-нибудь… мерзостью? Изгоем общества? ",shape=box,color=blue];
		j578506347 -> j1687732811;
	j684227076 [label="Конечно, учиться на своих ошибках очень важно. Но вовсе не обязательно испытывать «вину», чтобы понять «провал».",shape=box,color=blue];
		j684227076 -> j2135142592;
	j3251942444 [label="Кажется, у Лиона и так достаточно собственных проблем, тебе не кажется?",shape=box,color=red];
		j3251942444 -> j1127316308;
	j348688821 [label="Прости… ты делаешь что?",shape=box,color=red];
		j348688821 -> j1464933589;
	j1274172877 [label="Твой контекст отличался от нашего. И то, что мы считаем жестоким и ужасным, для тебя с детства было частью обычного устройства мира.",shape=box,color=red];
		j1274172877 -> j3139645103;
	j1974563575 [label="Это никоим образом не оправдывает всего, что было сделано – трагедии остаются трагедиями, а ужасы остаются ужасами. Но попытка была предпринята.",shape=box,color=red];
		j1974563575 -> j273612680;
	j2966162415 [label="С моей точки зрения, ты был на войне и пытался выжить в обществе социопатов, одновременно планируя всё перевернуть. И за это они назвали тебя дьяволом. Не думаю, что это справедливо.",shape=box,color=red];
		j2966162415 -> j2223420501;
	j3362529679 [label="За сам факт бегства.",shape=box,color=red];
		j3362529679 -> j2340587127;
	j3911874856 [label="За сам факт неудачи.",shape=box,color=red];
		j3911874856 -> j2340587127;
	j2676204232 [label="Я не буду извиняться за Империю Орокин: я не был её создателем, лишь обитателем. Но и брать на себя вину за то, что планировал разрушить её вокруг себя, я не стану. Мы заслужили то, что получили, и даже хуже.",shape=box,color=blue];
		j2676204232 -> j2712979643;
	j1744094279 [label="Каждая ситуация - это «своя собственная ситуация», Узурпатор. Контекст всегда имеет значение. А ты просто смотришь на «Старую войну» сквозь призму ретроспективной ясности.",shape=box,color=blue];
		j1744094279 -> j3515043913;
	j3704668335 [label="Тогда мне остаётся лишь глубоко пожалеть тебя, Узурпатор. Советую тебе либо смириться с тем, что тебе предназначено делать, либо уйти из этой жизни и заняться земледелием.",shape=box,color=blue];
		j3704668335 -> j287387635;
	j181574098 [label="Ммм. Обожаю, когда ты так чётко показываешь, что я тебя зацепил, это так восхитительно. У тебя плохо получается уходить от темы.",shape=box,color=blue];
		j181574098 -> j3668364516;
	j1687732811 [label="Взгляни на меня, Узурпатор. Посмотри, кто я есть. Орокин, отторгнутый собственной империей.",shape=box,color=blue];
		j1687732811 -> j2493745986;
	j2135142592 [label="И в чём, в конце концов, смысл прощения? У кого я должен просить прощения? У других? Чтобы не быть изгнанным?",shape=box,color=blue];
		j2135142592 -> j1687732811;
	j1127316308 [label="И именно в этом я пытался ему помочь! Я лишь стараюсь поддержать его в его сомнениях относительно Безразличия и того, что сказал ему Энтрати.",shape=box,color=blue];
		j1127316308 -> j3167695897;
	j1464933589 [label="Абсолютно ничего плохого, что бы тебе ни сказал этот надоедливый летающий комар. Я лишь стараюсь помочь ему разобраться в его сомнениях относительно Безразличия и того, что ему сказал Энтрати.",shape=box,color=blue];
		j1464933589 -> j3167695897;
	j3139645103 [label="+10 Chemistry",color=orange];
		j3139645103 -> j1963003503;
	j273612680 [label="Boolean RoatheVillainOrokin is now true.",color=orange];
		j273612680 -> j3139645103;
	j2223420501 [label="Boolean RoatheVillainShortcut is now true.",color=orange];
		j2223420501 -> j372862483;
	j2340587127 [label="Boolean RoatheForgivenessShortcut is now true.",color=orange];
		j2340587127 -> j1933300832;
	j2712979643 [label="Если есть что-то, за что я чувствую вину, так это за то, что в конечном итоге всё это сожгли Тэнно, а не я.",shape=box,color=blue];
		j2712979643 -> j533316691;
	j3515043913 [label="Если ты собираешься судить все действия людей прошлого, имея всю информацию будущего, ты неизбежно будешь в постоянном смятении.",shape=box,color=blue];
		j3515043913 -> j1589499704;
	j287387635 [label="Хотя было бы обидно. Наблюдать за твоей работой - одно удовольствие. Не слишком эффективно, зато невероятно эффектно.",shape=box,color=blue];
		j287387635 -> j907602512;
	j3668364516 [label="Хотя, полагаю, провести столетия в одиночестве, имея для разговора только придуманных созданий собственного воображения, неизбежно ограничивает возможности отточить свои социальные навыки.",shape=box,color=blue];
		j3668364516 -> j1292435854;
	j2493745986 [label="В своё время меня называли «Дьяволом Тау». А теперь я уже «дьявол» для всех, кто меня встречает.",shape=box,color=blue];
		j2493745986 -> j4129520079;
	j3167695897 [label="Энтрати сказал ему, что его «видения» порождены не Луа, а Безразличием, и это вызывает у него своего рода «кризис веры».",shape=box,color=blue];
		j3167695897 -> j1713553295;
	j1963003503 [label="Как приятно знать, что концепция тонкости и нюансов всё ещё жива. Да, ты совершенно прав. Я - дитя иной эпохи, иного времени, иного общества.",shape=box,color=blue];
		j1963003503 -> j2610178054;
	j372862483 [label="+20 Chemistry",color=orange];
		j372862483 -> j8452356;
	j1933300832 [label="+10 Chemistry",color=orange];
		j1933300832 -> "Chat ends.";
	j533316691 [label="Boolean RoatheForgivenessNoGuilt is now true.",color=orange];
		j533316691 -> j1933300832;
	j1589499704 [label="Прими то, что произошло в прошлом, и иди дальше.",shape=box,color=blue];
		j1589499704 -> j1193494668;
	j907602512 [label="По крайней мере, ты умеешь делать поле битвы «веселым». ",shape=box,color=blue];
		j907602512 -> j1193494668;
	j1292435854 [label="Иди спаррингуй с Жрецом, вам обоим стоит подтянуть навыки. ",shape=box,color=blue];
		j1292435854 -> j4081414586;
	j4129520079 [label="Альбрехт посчитал нужным закрепить это прозвище навсегда. ",shape=box,color=blue];
		j4129520079 -> j1193494668;
	j1713553295 [label="Я же пытаюсь убедить его, что это не так и никакой «бог» их не посылал, поскольку богов не существует. Он просто нездоров.",shape=box,color=blue];
		j1713553295 -> j1641151224;
		j1713553295 -> j1719521738;
	j2610178054 [label="Однако я мог признать жестокость и безобразия своего народа такими, какие они есть. Были падения, до которых многие из моих опускались, и которые даже я не мог вынести.",shape=box,color=blue];
		j2610178054 -> j3223600975;
	j8452356 [label="Знал ведь, что не зря ты мне нравишься, Узурпатор. Наконец-то! Кто-то, кто способен меня оценить! Всего-то понадобилось... Пара веков?!",shape=box,color=blue];
		j8452356 -> j527908111;
	j1193494668 [label="Вот мой совет тебе: убей любую вину в своём сердце, как это сделал я. Вонзи клинок ей в грудь, пока она не умрёт.",shape=box,color=blue];
		j1193494668 -> j695662702;
	j4081414586 [label="+5 Chemistry",color=orange];
		j4081414586 -> "Chat ends.";
	j1641151224 [label="Нужна ли Лиону твоя помощь?",shape=box,color=red];
		j1641151224 -> j3068310134;
	j1719521738 [label="Ты правда считаешь, что от этого ему станет лучше?",shape=box,color=red];
		j1719521738 -> j2520396503;
	j3223600975 [label="Но такие вопросы… сложны. И я ценю, что ты это видишь. Блин. Дворецкий смотрит на меня. Пора прервать этот разговор. Мы ещё поговорим.",shape=box,color=blue];
		j3223600975 -> "Chat ends.";
	j527908111 [label="Блин. Дворецкий смотрит на меня. Пожалуй, пора закончить этот разговор. Мы ещё поговорим.",shape=box,color=blue];
		j527908111 -> "Chat ends.";
	j695662702 [label="Вина - это предатель, который приходит ночью и отбирает всё, что тебе дорого. Она не приносит ничего, кроме вреда.",shape=box,color=blue];
		j695662702 -> j533316691;
	j3068310134 [label="Он не отказался слушать. Он не просил меня прекратить разговор. Я бы прекратил, если бы он попросил.",shape=box,color=blue];
		j3068310134 -> j948611714;
	j2520396503 [label="Разве религиозно настроенным следует манипулировать им только потому, что у них есть такая возможность? Указывать на его галлюцинации и называть их «видениями», вместо того чтобы помочь?",shape=box,color=blue];
		j2520396503 -> j4085176292;
	j948611714 [label="Меня раздражает видеть, как те, кто рядом с Лионом, используют и манипулируют им, даже не осознавая этого. Всё это во имя «религии» и «веры».",shape=box,color=blue];
		j948611714 -> j4085176292;
	j4085176292 [label="Я читал отчёты о том, что произошло. Этот… «Красная Вуаль» мог бы попытаться извлечь того Тэнно из его Харроу за все эти века. Но они не сделали этого. Они позволили ему увянуть и умереть.",shape=box,color=blue];
		j4085176292 -> j2070782822;
	j2070782822 [label="Зачем? Во имя защиты от какого-то… теоретического «Бога Бездны».",shape=box,color=blue];
		j2070782822 -> j3863285164;
		j2070782822 -> j3513041534;
	j3863285164 [label="Ты думаешь, жертва Рэлла была напрасной?",shape=box,color=red];
		j3863285164 -> j498647867;
	j3513041534 [label="Рэлл был единственным, кто сдерживал это существо все эти годы.",shape=box,color=red];
		j3513041534 -> j368532743;
	j498647867 [label="Нет. Он действительно защищал от чего-то. Но кто знает, насколько он усугубил ситуацию? Кто может знать, сколько собственного страха и боли он питал в нём все эти века?",shape=box,color=blue];
		j498647867 -> j285015118;
	j368532743 [label="Или единственным, кто всё это время его питал.",shape=box,color=blue];
		j368532743 -> j285015118;
	j285015118 [label="Концептуальное воплощение может проявиться лишь из того, что ему дано для созидания. А Бездна может творить только из той ткани, что ей вручена.",shape=box,color=blue];
		j285015118 -> j3516165664;
	j3516165664 [label="Интересно, сколько же один этот Тэнно вложил в само его существование? Он был настоящим пиршеством Агонии, Боли, Предательства, Печали… Одиночества...",shape=box,color=blue];
		j3516165664 -> j3626538383;
	j3626538383 [label="И той онемелой пустоты, что приходит после тысяч лет, проведённых в одиночестве, обращаясь в Ничто.
Что может следовать за этим, если не Безразличие?",shape=box,color=blue];
		j3626538383 -> j4208718472;
		j3626538383 -> j2370642556;
	j4208718472 [label="Возможно, то, что ты говоришь, правда. Просто… я не знаю, так ли это. И не знаю, что это не так.",shape=box,color=red];
		j4208718472 -> j947121359;
	j2370642556 [label="Оно было могущественным ещё до того, как добралось до Рэлла. Он бы не пожертвовал собой без веской причины.",shape=box,color=red];
		j2370642556 -> j142522989;
	j947121359 [label="+10 Chemistry",color=orange];
		j947121359 -> j3861668455;
	j142522989 [label="Как и детские кошмары. Для шестилетнего ребёнка они, самые могущественные создания во вселенной. Но для взрослого, не более чем пушинка, застрявшая в вентиляции и случайно попавшая в свет.",shape=box,color=blue];
		j142522989 -> j4166326284;
	j3861668455 [label="Я не думаю, что мог бы просить о большем, кроме как о том, чтобы ты просто признал, что не знаешь наверняка, с чем мы на самом деле имеем дело.",shape=box,color=blue];
		j3861668455 -> j912601378;
	j4166326284 [label="Мы создаем горы из пылинок просто потому, что нам нужна причина быть несчастными и разрушать себя.",shape=box,color=blue];
		j4166326284 -> j1278564546;
	j912601378 [label="Это великолепное начало. И восхитительное качество для любого человека, простая способность сказать… «Я не знаю».",shape=box,color=blue];
		j912601378 -> j2705897882;
	j1278564546 [label="Человечество в двух словах.",shape=box,color=blue];
		j1278564546 -> j3208040028;
	j2705897882 [label="Если бы мы, Орокин, могли проявлять это время от времени, возможно, мы бы выжили.",shape=box,color=blue];
		j2705897882 -> j3208040028;
	j3208040028 [label="Boolean RoatheMITW3 is now true.",color=orange];
		j3208040028 -> j1933300832;
}