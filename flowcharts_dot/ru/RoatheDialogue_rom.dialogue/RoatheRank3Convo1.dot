digraph {
	1333 [label="RoatheRank3Convo1 begins.",color=orange];
		1333 -> 1334;
	1334 [label="Удалось ли тебе наконец поговорить с нашим дорогим Лионом? Или он все ещё морочит тебе голову? Честно, тебе, возможно, лучше держаться на расстоянии.",shape=box,color=blue];
		1334 -> 1337;
		1334 -> 1336;
		1334 -> 1335;
	1337 [label="Ты с ним плохо ладишь?",shape=box,color=red];
		1337 -> 1340;
	1336 [label="Если бы отношение к Мари и Лиону было немного мягче, возможно, и они отвечали бы тебе тем же.",shape=box,color=red];
		1336 -> 1339;
	1335 [label="[Конец.]",shape=box,color=red];
		1335 -> 1338;
	1340 [label="Ладить с ним было бы проще, прояви он хоть малейшее стремление понять, с кем имеет дело и откуда мой путь. Я остаюсь тем, кем являюсь И так было веками. Я не собираюсь меняться только потому, что меня сейчас об этом просят.",shape=box,color=blue];
		1340 -> 1341;
	1339 [label="А как насчёт их доброжелательности ко мне, Узурпатор? Я остаюсь тем, кем являюсь. И так было веками. Я не собираюсь меняться только потому, сейчас они этого требуют.",shape=box,color=blue];
		1339 -> 1341;
	1338 [label="Chat ends.",color=orange];
	1341 [label="Evaluate expressions on HellStory",color=orange];
		1341 -> 1343 [label="x >= 21",color=purple];
		1341 -> 1342 [label="x < 21",color=purple];
		1341 -> 1342 [label="false",color=purple];
	1343 [label="Да, возможно, решение принять сыворотку было моим, но терпеть бесконечные оскорбления от этих двух неблагодарных существ, точно не входили в условия.  ",shape=box,color=blue];
		1343 -> 1344;
	1342 [label="Это вина Альбрехта, что сделал меня таким! Это его вина, что я застрял здесь с ними, а не моя! Я не имею никакого отношения к этой ужасной сделке!",shape=box,color=blue];
		1342 -> 1344;
	1344 [label="Пусть они идут жаловаться своему драгоценному «кардиналу», а не мне.",shape=box,color=blue];
		1344 -> 1345;
		1344 -> 1346;
		1344 -> 1347;
	1345 [label="Они имеют благие намерения, даже если делают это не лучшим образом.",shape=box,color=red];
		1345 -> 1348;
	1346 [label="Ты правда не чувствуешь, что тебе есть за что просить прощения?",shape=box,color=red];
		1346 -> 1349;
	1347 [label="Они просто пытаются тебе помочь.",shape=box,color=red];
		1347 -> 1350;
	1348 [label="Add -1 to Thermostat",color=orange];
		1348 -> 1351;
	1349 [label="Add 1 to Thermostat",color=orange];
		1349 -> 1352;
	1350 [label="«Помощь». Да. «Помощь». Прости, но их стиль этой самой «помощи» я нахожу глубоко «бесполезным».",shape=box,color=blue];
		1350 -> 1353;
	1351 [label="Да, в этом и заключается вся трагедия. Они искренне верят, что пытаются делать «добро».",shape=box,color=blue];
		1351 -> 1354;
	1352 [label="Прощение от кого? От тебя? От них? Дворецким? Альбрехтом? Или «богами»?",shape=box,color=blue];
		1352 -> 1355;
		1352 -> 1356;
		1352 -> 1357;
	1353 [label="На самом деле, было бы куда «полезнее», если бы они заменили моё вино на едкое вяжущее средство, Узурпатор.",shape=box,color=blue];
		1353 -> 1358;
	1354 [label="А ты что об этом думаешь? Ты веришь, что мне нужно «великое искупление»? «Божественное прощение»?",shape=box,color=blue];
		1354 -> 1359;
	1355 [label="Ты забываешь об одном важном моменте в этом списке.",shape=box,color=red];
		1355 -> 1360;
	1356 [label="Ты Орокин. Ужасы были неотъемлемой частью и войны и просто по природе своей системы. Тебе есть что искупать.",shape=box,color=red];
		1356 -> 1361;
	1357 [label="Ты хотя бы признаёшь, что тобою были совершены страшные поступки?",shape=box,color=red];
		1357 -> 1362;
	1358 [label="Это хотя бы было бы эффективнее.",shape=box,color=blue];
		1358 -> 1363;
	1359 [label="Evaluate expressions",color=orange];
		1359 -> 1364 [label="RoatheTraitor2",color=purple];
		1359 -> 1365 [label="RoatheTraitor2",color=purple];
		1359 -> 1366 [label="RoatheTraitor2",color=purple];
		1359 -> 1367 [label="RoatheTraitor2",color=purple];
		1359 -> 1364 [label="RoatheTraitor1",color=purple];
		1359 -> 1365 [label="RoatheTraitor1",color=purple];
		1359 -> 1366 [label="RoatheTraitor1",color=purple];
		1359 -> 1367 [label="RoatheTraitor1",color=purple];
		1359 -> 1364 [label="RoatheExecutor2",color=purple];
		1359 -> 1365 [label="RoatheExecutor2",color=purple];
		1359 -> 1366 [label="RoatheExecutor2",color=purple];
		1359 -> 1367 [label="RoatheExecutor2",color=purple];
		1359 -> 1364 [label="false",color=purple];
		1359 -> 1365 [label="false",color=purple];
		1359 -> 1366 [label="false",color=purple];
	1360 [label="Пожалуйста, скажи. ",shape=box,color=blue];
		1360 -> 1368;
		1360 -> 1369;
		1360 -> 1370;
	1361 [label="Я не буду извиняться за общество Орокин, его создание не моих рук дело. Я всего лишь его житель. И если, по-твоему, виноваты все, кто просто оказался рождённым в такой системе, то ты одним махом запишешь в преступники миллиарды. А как насчёт остального?",shape=box,color=blue];
		1361 -> 1371;
	1362 [label="И что, если это так? Я не могу сейчас их изменить. Какой смысл испытывать чувство вины?",shape=box,color=blue];
		1362 -> 1372;
		1362 -> 1373;
	1363 [label="Хотя из них двоих я все равно предпочитаю священника. Он прислушивается к голосу разума. Возможно, он просто осознаёт, что Безразличие не настоящий бог.",shape=box,color=blue];
		1363 -> 1374;
	1364 [label="Я думаю, стоит задуматься о наших поступках, которые причинили вред людям, и попытаться понять, как это исправить. Но я совсем не верю, что эти двое справляются с этим должным образом.",shape=box,color=red];
		1364 -> 1375;
	1365 [label="В конце концов, я не верю, что нужно прощать кого-либо, кроме себя. Если ты не против своих поступков? Пусть будет так.",shape=box,color=red];
		1365 -> 1376;
	1366 [label="Ты происходишь из общества, где многое из поведения Орокин было просто... нормальным. Ожидаемым. Для тебя это не было чем-то «неправильным». Я не говорю, что это оправдывает их, просто это было понятным.",shape=box,color=red];
		1366 -> 1377;
	1367 [label="У тебя был замысел свергнуть Орокин. Их испорченность была очевидна, и шаги к исправлению положения предпринимались сознательно.",shape=box,color=red];
		1367 -> 1378;
	1368 [label="Ты сам.",shape=box,color=red];
		1368 -> 1379;
	1369 [label="Твой собственный народ, свержение которого входило в твои планы.",shape=box,color=red];
		1369 -> 1380;
	1370 [label="Владеющие Разумом, чья гибель произошла по твоей вине.",shape=box,color=red];
		1370 -> 1371;
	1371 [label="Это была война. А на войне, по определению, ты убиваешь как можно больше врагов. Ты оплакиваешь Гринир или «Корпус», которых убиваешь?",shape=box,color=blue];
		1371 -> 1381;
		1371 -> 1382;
		1371 -> 1383;
	1372 [label="Прощение других важно.",shape=box,color=red];
		1372 -> 1384;
	1373 [label="Ты можешь изменить своё будущее поведение.",shape=box,color=red];
		1373 -> 1385;
	1374 [label="На самом деле, я, возможно, ещё смогу убедить его увидеть всю его религию насквозь - представь себе. Человек, который видит причудливые и кровавые галлюцинации, но при этом способен воспринимать логику и разум. Какая редкость.",shape=box,color=blue];
		1374 -> 1386;
		1374 -> 1387;
	1375 [label="Хм. Понимаю. Для тебя проблема не в действии, а в методе. Тогда я снимаю своё прежнее одобрение и заменяю его возмущением.",shape=box,color=blue];
		1375 -> 1388;
	1376 [label="Update boolean RoatheVillainSelf",color=orange];
		1376 -> 1389;
	1377 [label="Update boolean RoatheVillainOrokin",color=orange];
		1377 -> 1389;
	1378 [label="Так что, думаю, даже если бы у тебя появилось желание что-то переделать по своему образу и подобию, необходимость подобного шага всё равно была бы очевидна.",shape=box,color=red];
		1378 -> 1390;
		1378 -> 1391;
	1379 [label="Check boolean RoatheKnowsReset2",color=orange];
		1379 -> 1392 [label=true,color=green];
		1379 -> 1393 [label=false,color=brown];
	1380 [label="Ни разу не было такого, чтобы чувство вины лишило меня сна из-за замысла против собственного народа, Узурпатор. Поверь мне.",shape=box,color=blue];
		1380 -> 1394;
	1381 [label="Нет. Но с Владеющими Разумом дела обстоят иначе.",shape=box,color=red];
		1381 -> 1395;
	1382 [label="Да. Я вижу.",shape=box,color=red];
		1382 -> 1396;
	1383 [label="Что я думаю о жизнях, которые мне приходится отнимать, это моё личное дело. Мы говорим о тебе.",shape=box,color=red];
		1383 -> 1397;
	1384 [label="Зачем? Чтобы меня оставили в покое? Чтобы не стать какой-нибудь… мерзостью? Изгоем общества? ",shape=box,color=blue];
		1384 -> 1398;
	1385 [label="Конечно, учиться на своих ошибках очень важно. Но вовсе не обязательно испытывать «вину», чтобы понять «провал».",shape=box,color=blue];
		1385 -> 1399;
	1386 [label="Кажется, у Лиона и так достаточно собственных проблем, тебе не кажется?",shape=box,color=red];
		1386 -> 1400;
	1387 [label="Прости… ты делаешь что?",shape=box,color=red];
		1387 -> 1401;
	1388 [label="Chat ends.",color=orange];
	1389 [label="Твой контекст отличался от нашего. И то, что мы считаем жестоким и ужасным, для тебя с детства было частью обычного устройства мира.",shape=box,color=red];
		1389 -> 1402;
	1390 [label="Это никоим образом не оправдывает всего, что было сделано – трагедии остаются трагедиями, а ужасы остаются ужасами. Но попытка была предпринята.",shape=box,color=red];
		1390 -> 1403;
	1391 [label="С моей точки зрения, ты был на войне и пытался выжить в обществе социопатов, одновременно планируя всё перевернуть. И за это они назвали тебя дьяволом. Не думаю, что это справедливо.",shape=box,color=red];
		1391 -> 1404;
	1392 [label="За сам факт бегства.",shape=box,color=red];
		1392 -> 1405;
	1393 [label="За сам факт неудачи.",shape=box,color=red];
		1393 -> 1405;
	1394 [label="Я не буду извиняться за Империю Орокин: я не был её создателем, лишь обитателем. Но и брать на себя вину за то, что планировал разрушить её вокруг себя, я не стану. Мы заслужили то, что получили, и даже хуже.",shape=box,color=blue];
		1394 -> 1406;
	1395 [label="Каждая ситуация - это «своя собственная ситуация», Узурпатор. Контекст всегда имеет значение. А ты просто смотришь на «Старую войну» сквозь призму ретроспективной ясности.",shape=box,color=blue];
		1395 -> 1407;
	1396 [label="Тогда мне остаётся лишь глубоко пожалеть тебя, Узурпатор. Советую тебе либо смириться с тем, что тебе предназначено делать, либо уйти из этой жизни и заняться земледелием.",shape=box,color=blue];
		1396 -> 1408;
	1397 [label="Ммм. Обожаю, когда ты так чётко показываешь, что я тебя зацепил, это так восхитительно. У тебя плохо получается уходить от темы.",shape=box,color=blue];
		1397 -> 1409;
	1398 [label="Взгляни на меня, Узурпатор. Посмотри, кто я есть. Орокин, отторгнутый собственной империей.",shape=box,color=blue];
		1398 -> 1410;
	1399 [label="И в чём, в конце концов, смысл прощения? У кого я должен просить прощения? У других? Чтобы не быть изгнанным?",shape=box,color=blue];
		1399 -> 1398;
	1400 [label="И именно в этом я пытался ему помочь! Я лишь стараюсь поддержать его в его сомнениях относительно Безразличия и того, что сказал ему Энтрати.",shape=box,color=blue];
		1400 -> 1411;
	1401 [label="Абсолютно ничего плохого, что бы тебе ни сказал этот надоедливый летающий комар. Я лишь стараюсь помочь ему разобраться в его сомнениях относительно Безразличия и того, что ему сказал Энтрати.",shape=box,color=blue];
		1401 -> 1411;
	1402 [label="+10 Chemistry",color=orange];
		1402 -> 1412;
	1403 [label="Update boolean RoatheVillainOrokin",color=orange];
		1403 -> 1402;
	1404 [label="Update boolean RoatheVillainShortcut",color=orange];
		1404 -> 1413;
	1405 [label="Update boolean RoatheForgivenessShortcut",color=orange];
		1405 -> 1414;
	1406 [label="Если есть что-то, за что я чувствую вину, так это за то, что в конечном итоге всё это сожгли Тэнно, а не я.",shape=box,color=blue];
		1406 -> 1415;
	1407 [label="Если ты собираешься судить все действия людей прошлого, имея всю информацию будущего, ты неизбежно будешь в постоянном смятении.",shape=box,color=blue];
		1407 -> 1416;
	1408 [label="Хотя было бы обидно. Наблюдать за твоей работой - одно удовольствие. Не слишком эффективно, зато невероятно эффектно.",shape=box,color=blue];
		1408 -> 1417;
	1409 [label="Хотя, полагаю, провести столетия в одиночестве, имея для разговора только придуманных созданий собственного воображения, неизбежно ограничивает возможности отточить свои социальные навыки.",shape=box,color=blue];
		1409 -> 1418;
	1410 [label="В своё время меня называли «Дьяволом Тау». А теперь я уже «дьявол» для всех, кто меня встречает.",shape=box,color=blue];
		1410 -> 1419;
	1411 [label="Энтрати сказал ему, что его «видения» порождены не Луа, а Безразличием, и это вызывает у него своего рода «кризис веры».",shape=box,color=blue];
		1411 -> 1420;
	1412 [label="Как приятно знать, что концепция тонкости и нюансов всё ещё жива. Да, ты совершенно прав. Я - дитя иной эпохи, иного времени, иного общества.",shape=box,color=blue];
		1412 -> 1421;
	1413 [label="+20 Chemistry",color=orange];
		1413 -> 1422;
	1414 [label="+10 Chemistry",color=orange];
		1414 -> 1423;
	1415 [label="Update boolean RoatheForgivenessNoGuilt",color=orange];
		1415 -> 1424;
	1416 [label="Прими то, что произошло в прошлом, и иди дальше.",shape=box,color=blue];
		1416 -> 1425;
	1417 [label="По крайней мере, ты умеешь делать поле битвы «веселым». ",shape=box,color=blue];
		1417 -> 1425;
	1418 [label="Иди спаррингуй с Жрецом, вам обоим стоит подтянуть навыки. ",shape=box,color=blue];
		1418 -> 1426;
	1419 [label="Альбрехт посчитал нужным закрепить это прозвище навсегда. ",shape=box,color=blue];
		1419 -> 1425;
	1420 [label="Я же пытаюсь убедить его, что это не так и никакой «бог» их не посылал, поскольку богов не существует. Он просто нездоров.",shape=box,color=blue];
		1420 -> 1427;
		1420 -> 1428;
	1421 [label="Однако я мог признать жестокость и безобразия своего народа такими, какие они есть. Были падения, до которых многие из моих опускались, и которые даже я не мог вынести.",shape=box,color=blue];
		1421 -> 1429;
	1422 [label="Знал ведь, что не зря ты мне нравишься, Узурпатор. Наконец-то! Кто-то, кто способен меня оценить! Всего-то понадобилось... Пара веков?!",shape=box,color=blue];
		1422 -> 1430;
	1423 [label="Chat ends.",color=orange];
	1424 [label="+10 Chemistry",color=orange];
		1424 -> 1431;
	1425 [label="Вот мой совет тебе: убей любую вину в своём сердце, как это сделал я. Вонзи клинок ей в грудь, пока она не умрёт.",shape=box,color=blue];
		1425 -> 1432;
	1426 [label="+5 Chemistry",color=orange];
		1426 -> 1433;
	1427 [label="Нужна ли Лиону твоя помощь?",shape=box,color=red];
		1427 -> 1434;
	1428 [label="Ты правда считаешь, что от этого ему станет лучше?",shape=box,color=red];
		1428 -> 1435;
	1429 [label="Но такие вопросы… сложны. И я ценю, что ты это видишь. Блин. Дворецкий смотрит на меня. Пора прервать этот разговор. Мы ещё поговорим.",shape=box,color=blue];
		1429 -> 1436;
	1430 [label="Блин. Дворецкий смотрит на меня. Пожалуй, пора закончить этот разговор. Мы ещё поговорим.",shape=box,color=blue];
		1430 -> 1437;
	1431 [label="Chat ends.",color=orange];
	1432 [label="Вина - это предатель, который приходит ночью и отбирает всё, что тебе дорого. Она не приносит ничего, кроме вреда.",shape=box,color=blue];
		1432 -> 1438;
	1433 [label="Chat ends.",color=orange];
	1434 [label="Он не отказался слушать. Он не просил меня прекратить разговор. Я бы прекратил, если бы он попросил.",shape=box,color=blue];
		1434 -> 1439;
	1435 [label="Разве религиозно настроенным следует манипулировать им только потому, что у них есть такая возможность? Указывать на его галлюцинации и называть их «видениями», вместо того чтобы помочь?",shape=box,color=blue];
		1435 -> 1440;
	1436 [label="Chat ends.",color=orange];
	1437 [label="Chat ends.",color=orange];
	1438 [label="Update boolean RoatheForgivenessNoGuilt",color=orange];
		1438 -> 1441;
	1439 [label="It angers me to see those around Lyon use and manipulate him, whether or not they even realize they are doing it. All in the name of \"religion\" and \"belief.\"",shape=box,color=blue];
		1439 -> 1440;
	1440 [label="Я читал отчёты о том, что произошло. Этот… «Красная Вуаль» мог бы попытаться извлечь того Тэнно из его Харроу за все эти века. Но они не сделали этого. Они позволили ему увянуть и умереть.",shape=box,color=blue];
		1440 -> 1442;
	1441 [label="+10 Chemistry",color=orange];
		1441 -> 1443;
	1442 [label="Зачем? Во имя защиты от какого-то… теоретического «Бога Бездны».",shape=box,color=blue];
		1442 -> 1444;
		1442 -> 1445;
	1443 [label="Chat ends.",color=orange];
	1444 [label="Ты думаешь, жертва Рэлла была напрасной?",shape=box,color=red];
		1444 -> 1446;
	1445 [label="Рэлл был единственным, кто сдерживал это существо все эти годы.",shape=box,color=red];
		1445 -> 1447;
	1446 [label="Нет. Он действительно защищал от чего-то. Но кто знает, насколько он усугубил ситуацию? Кто может знать, сколько собственного страха и боли он питал в нём все эти века?",shape=box,color=blue];
		1446 -> 1448;
	1447 [label="Или единственным, кто всё это время его питал.",shape=box,color=blue];
		1447 -> 1448;
	1448 [label="Концептуальное воплощение может проявиться лишь из того, что ему дано для созидания. А Бездна может творить только из той ткани, что ей вручена.",shape=box,color=blue];
		1448 -> 1449;
	1449 [label="Интересно, сколько же один этот Тэнно вложил в само его существование? Он был настоящим пиршеством Агонии, Боли, Предательства, Печали… Одиночества...",shape=box,color=blue];
		1449 -> 1450;
	1450 [label="И той онемелой пустоты, что приходит после тысяч лет, проведённых в одиночестве, обращаясь в Ничто.
Что может следовать за этим, если не Безразличие?",shape=box,color=blue];
		1450 -> 1451;
		1450 -> 1452;
	1451 [label="Возможно, то, что ты говоришь, правда. Просто… я не знаю, так ли это. И не знаю, что это не так.",shape=box,color=red];
		1451 -> 1453;
	1452 [label="Оно было могущественным ещё до того, как добралось до Рэлла. Он бы не пожертвовал собой без веской причины.",shape=box,color=red];
		1452 -> 1454;
	1453 [label="+10 Chemistry",color=orange];
		1453 -> 1455;
	1454 [label="Как и детские кошмары. Для шестилетнего ребёнка они, самые могущественные создания во вселенной. Но для взрослого, не более чем пушинка, застрявшая в вентиляции и случайно попавшая в свет.",shape=box,color=blue];
		1454 -> 1456;
	1455 [label="Я не думаю, что мог бы просить о большем, кроме как о том, чтобы ты просто признал, что не знаешь наверняка, с чем мы на самом деле имеем дело.",shape=box,color=blue];
		1455 -> 1457;
	1456 [label="Мы создаем горы из пылинок просто потому, что нам нужна причина быть несчастными и разрушать себя.",shape=box,color=blue];
		1456 -> 1458;
	1457 [label="Это великолепное начало. И восхитительное качество для любого человека, простая способность сказать… «Я не знаю».",shape=box,color=blue];
		1457 -> 1459;
	1458 [label="Человечество в двух словах.",shape=box,color=blue];
		1458 -> 1460;
	1459 [label="Если бы мы, Орокин, могли проявлять это время от времени, возможно, мы бы выжили.",shape=box,color=blue];
		1459 -> 1460;
	1460 [label="Update boolean RoatheMITW3",color=orange];
		1460 -> 1461;
	1461 [label="+10 Chemistry",color=orange];
		1461 -> 1462;
	1462 [label="Chat ends.",color=orange];
