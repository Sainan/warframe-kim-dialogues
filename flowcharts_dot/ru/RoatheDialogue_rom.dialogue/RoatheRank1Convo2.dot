digraph {
	135 [label="RoatheRank1Convo2 begins.",color=orange];
		135 -> 136;
	136 [label="Ты ведь понимаешь, что твоё так называемое «Безразличие» — не настоящий «бог», не так ли?",shape=box,color=blue];
		136 -> 139;
		136 -> 138;
		136 -> 137;
	139 [label="Он достаточно близко к нему.",shape=box,color=red];
		139 -> 142;
	138 [label="И что заставляет тебя так думать?",shape=box,color=red];
		138 -> 141;
	137 [label="[Конец.]",shape=box,color=red];
		137 -> 140;
	142 [label="Все, с кем я разговариваю в этом сумасшедшем доме, совершенно убеждены, что этот «Человек в стене» — некий буквальный и смехотворный бог. Настоящий бог. Даже эти двое фанатиков, кажется, поддерживают эту мысль!",shape=box,color=blue];
		142 -> 144;
		142 -> 145;
		142 -> 146;
	141 [label="Что ж, отбросив суровую реальность, что любая вера в бога или богов происходит от глупцов, цепляющихся за: во-первых, мучительную потребность прижаться к плюшевой игрушке, когда сталкиваешься с жестоким ужасом конечности своей души, достигнув смерти,",shape=box,color=blue];
		141 -> 143;
	140 [label="Chat ends.",color=orange];
	144 [label="Ты не думаешь, что он настоящий?",shape=box,color=red];
		144 -> 148;
	145 [label="И если ты не считаешь его богом, кем же ты его считаешь?",shape=box,color=red];
		145 -> 149;
	146 [label="А ты сам?",shape=box,color=red];
		146 -> 150;
	143 [label="Во-вторых, тревогу, возникающую, когда осознаешь, что нет никакой высшей силы, предначертывающей нашу жизнь, и, следовательно, мы сами несём ответственность за свои поступки, а значит, и за все, что из этого вытекает.",shape=box,color=blue];
		143 -> 147;
	148 [label="Now, did I say those words? Do not be so quick to put words into my mouth, Oh Transient Usurper. I did not deny that the Indifference was \"real.\" I denied that it was a God.",shape=box,color=blue];
		148 -> 152;
		148 -> 153;
	149 [label="Я могу разоблачить это ложное божество для тебя двумя простыми словами, которые вам следует знать и понимать вполне отчётливо.",shape=box,color=blue];
		149 -> 154;
	150 [label="Абсолютно нет! Во-первых, никакого бога или богов не существует, эта идея абсурдна. Во-вторых, полагать, что Альбрехт выпустил бога Бездны? Ещё более смешно!",shape=box,color=blue];
		150 -> 155;
	147 [label="В третьих — за праведный гнев, сопутствующий тревоге и ужасу, когда все это приводит к осознанию того, что для Дьяволов не уготовано никакого «Ада», а для Ангелов — никакого «Рая».",shape=box,color=blue];
		147 -> 151;
	152 [label="Эта штука сильнее всего, с чем мне когда-либо приходилось сталкиваться.",shape=box,color=red];
		152 -> 156;
	153 [label="И что же это по-твоему тогда?",shape=box,color=red];
		153 -> 149;
	154 [label="Концептуальное воплощение.",shape=box,color=blue];
		154 -> 157;
		154 -> 158;
		154 -> 159;
	155 [label="В Бездне нет ничего. Именно поэтому она и называется Бездной!",shape=box,color=blue];
		155 -> 160;
		155 -> 161;
	151 [label="Я исхожу из того, что тобой не движет слепая ярость, ужас или тревога. Принимая это во внимание, я перехожу ко второму аргументу, который хотел бы представить тебе в доказательство несостоятельности божественности «Безразличия».",shape=box,color=blue];
		151 -> 154;
	156 [label="И когда я это оспаривал? Похоже, вы все умудрились втянуть себя в весьма истеричную и совершенно ненужную передрягу.",shape=box,color=blue];
		156 -> 162;
		156 -> 163;
	157 [label="Бездна и наше взаимодействие с ней опасно и могущественно — поверь мне, я знаю. Но у неё есть пределы. Ты действительно думаешь, что она способна породить нечто подобное? Создать целые языки, пальцы, способные приводить в движение корабли, прыгающие сквозь Бездну?",shape=box,color=red];
		157 -> 164;
	158 [label="В это... очень хочется поверить, что это только монстр под нашей кроватью, Роут. Но после встречи с этим лицом к лицу, я не знаю, как что-то подобное может быть создано нашим сознанием.",shape=box,color=red];
		158 -> 165;
	159 [label="Концептуальное Воплощение не может сделать то, на что способен Человек в Стене. Хотя Энтрати, возможно, обнаружил эту вещь — и несёт ответственность за её перенесение сюда — но я не верю, что он первоисточник.",shape=box,color=red];
		159 -> 166;
	160 [label="Нет. Я мне знакомо то, что порождает Бездна… Ангелы. Пение. Призраки.",shape=box,color=red];
		160 -> 167;
	161 [label="Я…",shape=box,color=red];
		161 -> 167;
	162 [label="Что ты говоришь?",shape=box,color=red];
		162 -> 168;
	163 [label="Постой. С какой стати мы виноваты в этом? Виноват Альбрехт, он выпустил это на волю.",shape=box,color=red];
		163 -> 169;
	164 [label="Человечество, безусловно, ничто иное, как неистощимый источник изобретательности в создании новых форм страданий, не так ли? Тебе приходилось, я уверен, стать свидетелем жестокостей, о которой невозможно было даже помыслить во времена наших благочестивых фанатиков.",shape=box,color=blue];
		164 -> 170;
	165 [label="Ах, ты так близко к истине и в то же время так поспешно отвергаешь её. Тебе кажется соблазнительной мысль, что это порождение твоего разума, ведь так было бы легче отмахнуться, будь это так? Нет, я думаю, куда опаснее столкнуться с творением собственных рук, нежели с богом.",shape=box,color=blue];
		165 -> 171;
	166 [label="Хотя я ценю твоё смирение, осмелюсь утверждать, что ты недооцениваешь безграничные возможности человеческого творчества — особенно в том, как оно способно изобретать новые формы страдания. Разве ткань этого мира, где ты живёшь, соткана не тобой?",shape=box,color=blue];
		166 -> 172;
	167 [label="Единственное, что приходит из Бездны, — это то, что мы сами туда помещаем… и то, что возвращается обратно. Она изменяет материю и энергию, но не способна их сотворить.",shape=box,color=blue];
		167 -> 173;
	168 [label="Вот что я хочу сказать: возможно, именно Альбрехт первым увидел собственную гордыню, отражённую в лице ухмыляющегося бога разрушения, да.",shape=box,color=blue];
		168 -> 174;
	169 [label="Возможно, именно Альбрехт первым увидел собственную гордыню, отражённую в лице ухмыляющегося бога разрушения.
",shape=box,color=blue];
		169 -> 174;
	170 [label="+15 Chemistry",color=orange];
		170 -> 175;
	171 [label="Внешнего врага можно понять. Им можно манипулировать. Его можно победить. А возможно, даже договориться, если дойдёт до этого. У него есть слабости, которые можно использовать. Но враг внутренний? Созданный нами самими? Он гораздо коварнее.",shape=box,color=blue];
		171 -> 176;
	172 [label="Тебе тоже приходилось стать свидетелем множества жестокостей, о которых, уверен, никто и не мог помыслить во времена наших ревностных фанатиков.",shape=box,color=blue];
		172 -> 177;
	173 [label="Подумай, Скиталец. Эти так называемые «Ангелы Бездны», о которых ты говоришь. Эти призраки. Созданы ли они из тех, кто уже затерялся в Бездне?",shape=box,color=blue];
		173 -> 178;
	174 [label="Но вы все в равной степени виноваты в том, что так долго катите этот грязный ком вниз по склону, позволяя ему увеличиваться с каждым собранным по пути куском нечистот!",shape=box,color=blue];
		174 -> 179;
	175 [label="Как вид, мы поистине удивительны в нашей способности подпитывать свои страхи новыми способами саморазрушения.",shape=box,color=blue];
		175 -> 180;
	176 [label="+20 Chemistry",color=orange];
		176 -> 181;
	177 [label="+10 Chemistry",color=orange];
		177 -> 175;
	178 [label="Это были лишь отголоски энергии, извергаемые подобно тому, как это делает пёстрый кутак, чтобы накормить своё потомство.",shape=box,color=blue];
		178 -> 179;
	179 [label="Позволь мне сделать обсуждение проще. Я могу разоблачить это ложное божество для тебя двумя простыми словами, которые вам следует знать и понимать вполне отчётливо.",shape=box,color=blue];
		179 -> 154;
	180 [label="Ммм. Боюсь, мне пора. Я оставлю тебя на время поразмыслить над моими словами.",shape=box,color=blue];
		180 -> 182;
		180 -> 183;
	181 [label="Потому что тогда придётся сражаться со своими собственными демонами. А человечество… такие войны никогда не выигрывает, правда?",shape=box,color=blue];
		181 -> 180;
	182 [label="Я сделаю это. Спасибо.",shape=box,color=red];
		182 -> 184;
	183 [label="Подумай над моими словами, возможно, тебе захочется поверить им, когда столкнёшься с анти-богом.",shape=box,color=red];
		183 -> 184;
	184 [label="Update boolean RoatheMITW1",color=orange];
		184 -> 185;
	185 [label="Chat ends.",color=orange];
}