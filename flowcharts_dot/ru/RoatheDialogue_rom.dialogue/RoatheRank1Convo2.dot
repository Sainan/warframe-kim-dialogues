digraph {
	"RoatheRank1Convo2 begins." [color=orange];
		"RoatheRank1Convo2 begins." -> j3655580186;
	j3655580186 [label="Ты ведь понимаешь, что твоё так называемое «Безразличие» — не настоящий «бог», не так ли?",shape=box,color=blue];
		j3655580186 -> j3305880689;
		j3655580186 -> j1840310508;
		j3655580186 -> j1310452999;
	j3305880689 [label="Он достаточно близко к нему.",shape=box,color=red];
		j3305880689 -> j66205486;
	j1840310508 [label="И что заставляет тебя так думать?",shape=box,color=red];
		j1840310508 -> j1156737426;
	j1310452999 [label="[Конец.]",shape=box,color=red];
		j1310452999 -> "Chat ends.";
	j66205486 [label="Все, с кем я разговариваю в этом сумасшедшем доме, совершенно убеждены, что этот «Человек в стене» — некий буквальный и смехотворный бог. Настоящий бог. Даже эти двое фанатиков, кажется, поддерживают эту мысль!",shape=box,color=blue];
		j66205486 -> j426518559;
		j66205486 -> j39964422;
		j66205486 -> j3138270482;
	j1156737426 [label="Что ж, отбросив суровую реальность, что любая вера в бога или богов происходит от глупцов, цепляющихся за: во-первых, мучительную потребность прижаться к плюшевой игрушке, когда сталкиваешься с жестоким ужасом конечности своей души, достигнув смерти,",shape=box,color=blue];
		j1156737426 -> j3948311168;
	"Chat ends." [color=orange];
	j426518559 [label="Ты не думаешь, что он настоящий?",shape=box,color=red];
		j426518559 -> j718979541;
	j39964422 [label="И если ты не считаешь его богом, кем же ты его считаешь?",shape=box,color=red];
		j39964422 -> j3638144359;
	j3138270482 [label="А ты сам?",shape=box,color=red];
		j3138270482 -> j3305001278;
	j3948311168 [label="Во-вторых, тревогу, возникающую, когда осознаешь, что нет никакой высшей силы, предначертывающей нашу жизнь, и, следовательно, мы сами несём ответственность за свои поступки, а значит, и за все, что из этого вытекает.",shape=box,color=blue];
		j3948311168 -> j3255962289;
	j718979541 [label="Итак, были ли эти слова действительно моими? Не торопись вкладывать фразы в мои уста, Кратковременный Узурпатор. Отрицания «реальности» Безразличия с моей стороны не было. Отклонено было лишь притязание на божественность.",shape=box,color=blue];
		j718979541 -> j4086014148;
		j718979541 -> j3716964506;
	j3638144359 [label="Я могу разоблачить это ложное божество для тебя двумя простыми словами, которые вам следует знать и понимать вполне отчётливо.",shape=box,color=blue];
		j3638144359 -> j2254055008;
	j3305001278 [label="Абсолютно нет! Во-первых, никакого бога или богов не существует, эта идея абсурдна. Во-вторых, полагать, что Альбрехт выпустил бога Бездны? Ещё более смешно!",shape=box,color=blue];
		j3305001278 -> j1134307973;
	j3255962289 [label="В третьих — за праведный гнев, сопутствующий тревоге и ужасу, когда все это приводит к осознанию того, что для Дьяволов не уготовано никакого «Ада», а для Ангелов — никакого «Рая».",shape=box,color=blue];
		j3255962289 -> j765897313;
	j4086014148 [label="Эта штука сильнее всего, с чем мне когда-либо приходилось сталкиваться.",shape=box,color=red];
		j4086014148 -> j1710912993;
	j3716964506 [label="И что же это по-твоему тогда?",shape=box,color=red];
		j3716964506 -> j3638144359;
	j2254055008 [label="Концептуальное воплощение.",shape=box,color=blue];
		j2254055008 -> j1430277109;
		j2254055008 -> j2664462558;
		j2254055008 -> j2981112696;
	j1134307973 [label="В Бездне нет ничего. Именно поэтому она и называется Бездной!",shape=box,color=blue];
		j1134307973 -> j2235868435;
		j1134307973 -> j1599793684;
	j765897313 [label="Я исхожу из того, что тобой не движет слепая ярость, ужас или тревога. Принимая это во внимание, я перехожу ко второму аргументу, который хотел бы представить тебе в доказательство несостоятельности божественности «Безразличия».",shape=box,color=blue];
		j765897313 -> j2254055008;
	j1710912993 [label="И когда я это оспаривал? Похоже, вы все умудрились втянуть себя в весьма истеричную и совершенно ненужную передрягу.",shape=box,color=blue];
		j1710912993 -> j179269007;
		j1710912993 -> j235070127;
	j1430277109 [label="Бездна и наше взаимодействие с ней опасно и могущественно — поверь мне, я знаю. Но у неё есть пределы. Ты действительно думаешь, что она способна породить нечто подобное? Создать целые языки, пальцы, способные приводить в движение корабли, прыгающие сквозь Бездну?",shape=box,color=red];
		j1430277109 -> j2714117118;
	j2664462558 [label="В это... очень хочется поверить, что это только монстр под нашей кроватью, Роут. Но после встречи с этим лицом к лицу, я не знаю, как что-то подобное может быть создано нашим сознанием.",shape=box,color=red];
		j2664462558 -> j3043997197;
	j2981112696 [label="Концептуальное Воплощение не может сделать то, на что способен Человек в Стене. Хотя Энтрати, возможно, обнаружил эту вещь — и несёт ответственность за её перенесение сюда — но я не верю, что он первоисточник.",shape=box,color=red];
		j2981112696 -> j2580057770;
	j2235868435 [label="Нет. Я мне знакомо то, что порождает Бездна… Ангелы. Пение. Призраки.",shape=box,color=red];
		j2235868435 -> j1505693830;
	j1599793684 [label="Я…",shape=box,color=red];
		j1599793684 -> j1505693830;
	j179269007 [label="Что ты говоришь?",shape=box,color=red];
		j179269007 -> j61703119;
	j235070127 [label="Постой. С какой стати мы виноваты в этом? Виноват Альбрехт, он выпустил это на волю.",shape=box,color=red];
		j235070127 -> j2887831918;
	j2714117118 [label="Человечество, безусловно, ничто иное, как неистощимый источник изобретательности в создании новых форм страданий, не так ли? Тебе приходилось, я уверен, стать свидетелем жестокостей, о которой невозможно было даже помыслить во времена наших благочестивых фанатиков.",shape=box,color=blue];
		j2714117118 -> j1819063545;
	j3043997197 [label="Ах, ты так близко к истине и в то же время так поспешно отвергаешь её. Тебе кажется соблазнительной мысль, что это порождение твоего разума, ведь так было бы легче отмахнуться, будь это так? Нет, я думаю, куда опаснее столкнуться с творением собственных рук, нежели с богом.",shape=box,color=blue];
		j3043997197 -> j1857525554;
	j2580057770 [label="Хотя я ценю твоё смирение, осмелюсь утверждать, что ты недооцениваешь безграничные возможности человеческого творчества — особенно в том, как оно способно изобретать новые формы страдания. Разве ткань этого мира, где ты живёшь, соткана не тобой?",shape=box,color=blue];
		j2580057770 -> j4282703792;
	j1505693830 [label="Единственное, что приходит из Бездны, — это то, что мы сами туда помещаем… и то, что возвращается обратно. Она изменяет материю и энергию, но не способна их сотворить.",shape=box,color=blue];
		j1505693830 -> j3773979874;
	j61703119 [label="Вот что я хочу сказать: возможно, именно Альбрехт первым увидел собственную гордыню, отражённую в лице ухмыляющегося бога разрушения, да.",shape=box,color=blue];
		j61703119 -> j3649936406;
	j2887831918 [label="Возможно, именно Альбрехт первым увидел собственную гордыню, отражённую в лице ухмыляющегося бога разрушения.\n",shape=box,color=blue];
		j2887831918 -> j3649936406;
	j1819063545 [label="+15 Chemistry",color=orange];
		j1819063545 -> j1454313753;
	j1857525554 [label="Внешнего врага можно понять. Им можно манипулировать. Его можно победить. А возможно, даже договориться, если дойдёт до этого. У него есть слабости, которые можно использовать. Но враг внутренний? Созданный нами самими? Он гораздо коварнее.",shape=box,color=blue];
		j1857525554 -> j2060638233;
	j4282703792 [label="Тебе тоже приходилось стать свидетелем множества жестокостей, о которых, уверен, никто и не мог помыслить во времена наших ревностных фанатиков.",shape=box,color=blue];
		j4282703792 -> j1430632920;
	j3773979874 [label="Подумай, Скиталец. Эти так называемые «Ангелы Бездны», о которых ты говоришь. Эти призраки. Созданы ли они из тех, кто уже затерялся в Бездне?",shape=box,color=blue];
		j3773979874 -> j2161394631;
	j3649936406 [label="Но вы все в равной степени виноваты в том, что так долго катите этот грязный ком вниз по склону, позволяя ему увеличиваться с каждым собранным по пути куском нечистот!",shape=box,color=blue];
		j3649936406 -> j670761382;
	j1454313753 [label="Как вид, мы поистине удивительны в нашей способности подпитывать свои страхи новыми способами саморазрушения.",shape=box,color=blue];
		j1454313753 -> j1234373623;
	j2060638233 [label="+20 Chemistry",color=orange];
		j2060638233 -> j188232002;
	j1430632920 [label="+10 Chemistry",color=orange];
		j1430632920 -> j1454313753;
	j2161394631 [label="Это были лишь отголоски энергии, извергаемые подобно тому, как это делает пёстрый кутак, чтобы накормить своё потомство.",shape=box,color=blue];
		j2161394631 -> j670761382;
	j670761382 [label="Позволь мне сделать обсуждение проще. Я могу разоблачить это ложное божество для тебя двумя простыми словами, которые вам следует знать и понимать вполне отчётливо.",shape=box,color=blue];
		j670761382 -> j2254055008;
	j1234373623 [label="Ммм. Боюсь, мне пора. Я оставлю тебя на время поразмыслить над моими словами.",shape=box,color=blue];
		j1234373623 -> j2478006412;
		j1234373623 -> j1048103224;
	j188232002 [label="Потому что тогда придётся сражаться со своими собственными демонами. А человечество… такие войны никогда не выигрывает, правда?",shape=box,color=blue];
		j188232002 -> j1234373623;
	j2478006412 [label="Я сделаю это. Спасибо.",shape=box,color=red];
		j2478006412 -> j3819439049;
	j1048103224 [label="Подумай над моими словами, возможно, тебе захочется поверить им, когда столкнёшься с анти-богом.",shape=box,color=red];
		j1048103224 -> j3819439049;
	j3819439049 [label="Boolean RoatheMITW1 is now true.",color=orange];
		j3819439049 -> "Chat ends.";
}