	j286695063 [label="ГС: ПОДКЛЮЧЕНИЕ",shape=box,color=blue];
		j286695063 -> j203765193;
	j203765193 [label="Транскрипт: Когда Владеющие Разумом завершили Солнечный Монорельс к Тау, никакой торжественной церемонии не было. Он просто начал работать.",shape=box,color=blue];
		j203765193 -> j2825668753;
	j2825668753 [label="Церемония, конечно, была поспешно устроена, ведь ни один настоящий Орокин не может просто так высморкаться без какого‑нибудь пафоса и торжеств.",shape=box,color=blue];
		j2825668753 -> j358073843;
	j358073843 [label="Большой шум подняли вокруг Первого транспортника, чтобы совершить Переход.",shape=box,color=blue];
		j358073843 -> j1380409406;
	j1380409406 [label="Это был величественный крейсер исполнителя Тормиса, и в выборе Тормиса в качестве экспедиционного корабля можно было усмотреть коллективный упрек исполнителю Тувулу за чудовищную аварию «Зариман Десять-Ноль». ",shape=box,color=blue];
		j1380409406 -> j113324274;
	j113324274 [label="Тормис отправился прочь и вернулся Тормис назад, неся дивные, усыпанные самоцветами воспоминания о новой Системе и новых мирах для заселения. ",shape=box,color=blue];
		j113324274 -> j3702749589;
	j3702749589 [label="В течение нескольких дней флотилия кораблей колонистов уже вышла в путь, жаждущая ступить на нетронутый берег.",shape=box,color=blue];
		j3702749589 -> j3936686034;
	j3936686034 [label="Последовавшая атака Владеющих Разумом несколько испортила настроение.",shape=box,color=blue];
		j3936686034 -> j921430358;
	j921430358 [label="Add 1 to HellStory counter",color=orange];
		j921430358 -> "Chat ends.";
}