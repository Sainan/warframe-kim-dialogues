		2144 -> 2147;
	2147 [label="Это был величественный крейсер исполнителя Тормиса, и в выборе Тормиса в качестве экспедиционного корабля можно было усмотреть коллективный упрек исполнителю Тувулу за чудовищную аварию «Зариман Десять-Ноль». ",shape=box,color=blue];
		2147 -> 2137;
