	"Chat ends." [color=orange];
	j3267566697 [label="VM: CONNECTION",shape=box,color=blue];
		j3267566697 -> j2114478801;
	j2114478801 [label="Транскрипт: Когда Владеющие Разумом завершили Солнечный Монорельс к Тау, никакой торжественной церемонии не было. Он просто начал работать.",shape=box,color=blue];
		j2114478801 -> j1890662936;
	j1890662936 [label="Церемония, конечно, была поспешно устроена, ведь ни один настоящий Орокин не может просто так высморкаться без какого‑нибудь пафоса и торжеств.",shape=box,color=blue];
		j1890662936 -> j2294549198;
	j2294549198 [label="Большой шум подняли вокруг Первого транспортника, чтобы совершить Переход.",shape=box,color=blue];
		j2294549198 -> j1719574045;
	j1719574045 [label="Это был величественный крейсер исполнителя Тормиса, и в выборе Тормиса в качестве экспедиционного корабля можно было усмотреть коллективный упрек исполнителю Тувулу за чудовищную аварию «Зариман Десять-Ноль». ",shape=box,color=blue];
		j1719574045 -> j2253890478;
	j2253890478 [label="Out Tormis went and back Tormis came, carrying wondrous bejewelled memories of a new System and new worlds to settle. ",shape=box,color=blue];
		j2253890478 -> j1548880887;
	j1548880887 [label="Within days a flotilla of colonist ships had departed, eager to set foot on the virgin shore.",shape=box,color=blue];
		j1548880887 -> j3936686034;
	j3936686034 [label="Последовавшая атака Владеющих Разумом несколько испортила настроение.",shape=box,color=blue];
		j3936686034 -> j921430358;
	j921430358 [label="Add 1 to HellStory counter",color=orange];
		j921430358 -> "Chat ends.";
}