	2286 [label="Transcript: At first, the Warframes seemed more of an artistic statement than a legitimate weapon.",shape=box,color=blue];
		2286 -> 2285;
	2285 [label="The war was all but lost; the Sentients were unvanquishable; let us, then, create these strange and surreal warriors and arm them with weapons of ancient pedigree.",shape=box,color=blue];
		2285 -> 2282;
	2282 [label="At least our defeat shall be beautiful. Memorable.",shape=box,color=blue];
		2282 -> 2283;
	2283 [label="But against all expectations, they prevailed. Soon stories of outrageously improbable heroism filtered back from the Front.",shape=box,color=blue];
		2283 -> 5715;
	5715 [label="Warframes had appeared from the sky, angel-like, liberating captives and devastating Sentient strongholds. Even alone they were miracles; in groups, they were gods.",shape=box,color=blue];
		5715 -> 5716;
	5716 [label="Little wonder, then, that they were seen as mere propaganda.",shape=box,color=blue];
		5716 -> 2281;
