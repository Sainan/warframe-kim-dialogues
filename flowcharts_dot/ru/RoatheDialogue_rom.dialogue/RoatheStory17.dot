	j378095897 [label="ГС: ВАРФРЕЙМЫ",shape=box,color=blue];
		j378095897 -> j1547380250;
	j1547380250 [label="Стенограмма: Поначалу Варфреймы казались скорее художественным произведением, чем полноценным оружием.",shape=box,color=blue];
		j1547380250 -> j2419353907;
	j2419353907 [label="Война была практически проиграна; Владеющие Разумом были непобедимы; так давайте же создадим этих странных и сюрреалистических воинов и вооружим их оружием древнего происхождения.",shape=box,color=blue];
		j2419353907 -> j3169673459;
	j3169673459 [label="По крайней мере, наше поражение будет прекрасным. Запоминающимся.",shape=box,color=blue];
		j3169673459 -> j403369261;
	j403369261 [label="Но вопреки всем ожиданиям, они одержали победу. Вскоре с фронта дошли рассказы о невероятно героическом поступке.",shape=box,color=blue];
		j403369261 -> j17909145;
	j17909145 [label="Варфреймы явились с небес, подобно ангелам, освобождая пленников и уничтожая цитадели Владеющих Разумом. Даже в одиночку они были чудом; вместе они становились богами.",shape=box,color=blue];
		j17909145 -> j867130819;
	j867130819 [label="Неудивительно, что их долго считали всего лишь пропагандой.",shape=box,color=blue];
		j867130819 -> j921430358;
	j921430358 [label="Add 1 to HellStory counter",color=orange];
		j921430358 -> "Chat ends.";
}