	"Chat ends." [color=orange];
	j1141808135 [label="VM: WARFRAMES",shape=box,color=blue];
		j1141808135 -> j4150620446;
	j4150620446 [label="Стенограмма: Поначалу Варфреймы казались скорее художественным произведением, чем полноценным оружием.",shape=box,color=blue];
		j4150620446 -> j472291452;
	j472291452 [label="Война была практически проиграна; Владеющие Разумом были непобедимы; так давайте же создадим этих странных и сюрреалистических воинов и вооружим их оружием древнего происхождения.",shape=box,color=blue];
		j472291452 -> j3149224808;
	j3149224808 [label="По крайней мере, наше поражение будет прекрасным. Запоминающимся.",shape=box,color=blue];
		j3149224808 -> j1939792358;
	j1939792358 [label="Но вопреки всем ожиданиям, они одержали победу. Вскоре с фронта дошли рассказы о невероятно героическом поступке.",shape=box,color=blue];
		j1939792358 -> j2490988023;
	j2490988023 [label="Warframes had appeared from the sky, angel-like, liberating captives and devastating Sentient strongholds. Even alone they were miracles; in groups, they were gods.",shape=box,color=blue];
		j2490988023 -> j2673834172;
	j2673834172 [label="Little wonder, then, that they were seen as mere propaganda.",shape=box,color=blue];
		j2673834172 -> j921430358;
	j921430358 [label="Add 1 to HellStory counter",color=orange];
		j921430358 -> "Chat ends.";
}