digraph {
	"RoatheRank4Convo3 begins." [color=orange];
		"RoatheRank4Convo3 begins." -> j2589463386;
	j2589463386 [label="Один вопрос тебе, Узурпатор: если бы всё свелось к этому, как считаешь, удалось бы тебе победить своего Тэнно-двойника в смертельном бою?",shape=box,color=blue];
		j2589463386 -> j1309005119;
		j2589463386 -> j2239234787;
		j2589463386 -> j1310452999;
	j1309005119 [label="Что? Почему...?",shape=box,color=red];
		j1309005119 -> j182889344;
	j2239234787 [label="Я не собираюсь вести этот разговор.",shape=box,color=red];
		j2239234787 -> j3111599137;
	j1310452999 [label="[Конец.]",shape=box,color=red];
		j1310452999 -> "Chat ends.";
	j182889344 [label="Потому что, не уверен, заметил ли ты, но «Лотос» — не просто Владеющая Разумом (к слову, именно она ответственна за то, что Луа оказалась в Бездне), так она ещё и явно потеряла контроль над своими схемами.",shape=box,color=blue];
		j182889344 -> j1586654645;
		j182889344 -> j542694727;
		j182889344 -> j1479270045;
		j182889344 -> j2402749063;
		j182889344 -> j2128571050;
	j3111599137 [label="Я вовсе не пытаюсь быть грубым. Я говорю абсолютно серьёзно, ты это понимаешь. Это чисто прагматичный разговор. ",shape=box,color=blue];
		j3111599137 -> j182889344;
	"Chat ends." [color=orange];
	j1586654645 [label="С ней всё в порядке. Ты не знаешь, о чём говоришь.",shape=box,color=red];
		j1586654645 -> j3182405968;
	j542694727 [label="Потеряла контроль над своими схемами? Что ты имеешь в виду?",shape=box,color=red];
		j542694727 -> j2772550437;
	j1479270045 [label="Нет. Я не собираюсь это обсуждать. Лотос спасла мне жизнь. Она бесчисленное количество раз спасала жизни Тэнно. Мы ей обязаны всем.",shape=box,color=red];
		j1479270045 -> j3479399515;
	j2402749063 [label="Заткнись, Роут, я этого делать не буду. [Конец.]",shape=box,color=red];
		j2402749063 -> j382628642;
	j2128571050 [label="Я знаю, я тоже переживаю. Но она сделала для нас так много, и я не могу отвернуться от неё. Мне стоит поддержать её.",shape=box,color=red];
		j2128571050 -> j993325430;
	j3182405968 [label="Разве не так? Обрати внимание! Оглянитесь вокруг! Сколько месяцев она провела, стоя на краю обрыва с устаревшим пейджером в руках, напевая себе под нос? Уставившись в Бездну?",shape=box,color=blue];
		j3182405968 -> j296536792;
	j2772550437 [label="Сколько месяцев она провела, стоя на краю обрыва с устаревшим пейджером в руках, напевая себе под нос? Уставившись в Бездну?",shape=box,color=blue];
		j2772550437 -> j296536792;
	j3479399515 [label="Я не испытываю к ней неприязни. Я понимаю, каково это. Ты многим ей обязан. Я не говорю тебе убивать её, я говорю, чтобы ты перестал позволять ей влиять на окружающих тебя людей.",shape=box,color=blue];
		j3479399515 -> j2772550437;
	j382628642 [label="Как пожелаешь. Но когда всё это рухнет вокруг тебя? Не приползай ко мне за помощью.",shape=box,color=blue];
		j382628642 -> "Chat ends.";
	j993325430 [label="+5 Chemistry",color=orange];
		j993325430 -> j3194538670;
	j296536792 [label="А теперь она просто… нависла? В темноте? Засылает твоё детское «я» всё глубже и глубже в свои воспоминания, зачем? Только ради пути домой, потому что Альбрехт щёлкнул пальцами и прошептал волшебное слово?",shape=box,color=blue];
		j296536792 -> j644126548;
	j3194538670 [label="Я не испытываю к ней неприязни. Я понимаю, каково это. Ты многим ей обязан. Я не говорю тебе убивать её, я говорю, чтобы ты перестал позволять ей влиять на окружающих тебя людей.",shape=box,color=blue];
		j3194538670 -> j208729625;
	j644126548 [label="Разве тебе не кажется это подозрительным? Разве тебе не кажется это опасным? Это ловушка. Ею манипулируют. Либо Альбрехт, либо это так называемое «Безразличие». Она сломана как программа. Её принципы дают сбой.",shape=box,color=blue];
		j644126548 -> j3115995179;
	j208729625 [label="Когда она стояла там, на краю обрыва, держа в руках устаревший пейджер, напевая себе под нос? Глядя в Бездну? Тебе не приходило в голову, что она может прыгнуть?",shape=box,color=blue];
		j208729625 -> j296536792;
	j3115995179 [label="Я не думаю, что она желает тебе зла. Я думаю, что её просто используют. Но когда придёт время, тебе, возможно, придётся защитить себя. Или, возможно, придётся их остановить.",shape=box,color=blue];
		j3115995179 -> j1803540135;
	j1803540135 [label="И хотя, надеюсь, тебе понятно, что стоит избежать второго раунда, когда Лотос станет проблемой, её дикая детская армия этого не поймёт. Поэтому я спрошу ещё раз:",shape=box,color=blue];
		j1803540135 -> j2697438096;
	j2697438096 [label="Как ты думаешь, кто победит, если наступит тот ужасный день и тебе придётся сражаться со всеми своими силами? Ты и всё, что у тебя есть, против всех Тэнно и Лотос?",shape=box,color=blue];
		j2697438096 -> j3990797782;
		j2697438096 -> j2788438958;
		j2697438096 -> j2207281024;
	j3990797782 [label="Это абсурдно. Нет.",shape=box,color=red];
		j3990797782 -> j737871335;
	j2788438958 [label="Там, ну… не знаю, сотня их. А я один, Роут.",shape=box,color=red];
		j2788438958 -> j2960081320;
	j2207281024 [label="Я даже не знаю, с чего начать.",shape=box,color=red];
		j2207281024 -> j4231450610;
	j737871335 [label="Считай это глупой игрой, если хочешь! Теоретическая игра, в которую играют дети. ",shape=box,color=blue];
		j737871335 -> j2699732412;
		j737871335 -> j2989700609;
	j2960081320 [label="+5 Chemistry",color=orange];
		j2960081320 -> j1449483856;
	j4231450610 [label="Тогда очень кстати, что ты говоришь с «Дьяволом Тау». Не зря меня называют стратегом. Давай начнём с самого верха: с чисел. В этой области ты ужасно уступаешь ",shape=box,color=blue];
		j4231450610 -> j4181059854;
	j2699732412 [label="Это не игра.",shape=box,color=red];
		j2699732412 -> j2653727479;
	j2989700609 [label="В последний раз? Нет. [Конец.]",shape=box,color=red];
		j2989700609 -> "Chat ends.";
	j1449483856 [label="Прекрасно. Мы установили самое первое правило при расстановке поля боя: числа. Очевидно, что ты ужасно уступаешь чисто по количеству.",shape=box,color=blue];
		j1449483856 -> j4181059854;
	j4181059854 [label="Check boolean IsDating",color=orange];
		j4181059854 -> j3216393430 [label=true,color=green];
		j4181059854 -> j3030189249 [label=false,color=brown];
	j2653727479 [label="Ты прав. Это не игра. И однажды всё может свестись к жизни или смерти. Ты против своей маленькой… миниатюрной версии. И их стаи диких товарищей.",shape=box,color=blue];
		j2653727479 -> j3918388716;
	j3216393430 [label="Однако, если слухи о твоих «личных делах» и возлюбленной среди протофреймов в других линиях времени можно… использовать, возможно, эти ресурсы как-то удастся призвать. Гельминтов придётся специально исследовать и разводить для этой цели...",shape=box,color=blue];
		j3216393430 -> j3990217741;
	j3030189249 [label="Я слышал о твоих взаимодействиях с другими протофреймами в других линиях времени. Возможно, эти ресурсы как‑то удастся призвать. Гельминтов придётся специально исследовать и разводить для этой цели...",shape=box,color=blue];
		j3030189249 -> j3990217741;
	j3918388716 [label="Дикие компаньоны, которые, между прочим, уже доказали свою жестокость, непокорность и известны тем, что жестоко изгоняют своих же за слишком большое отклонение от их собственного понимания нормы.",shape=box,color=blue];
		j3918388716 -> j2853135887;
		j3918388716 -> j1205920267;
		j3918388716 -> j3194747261;
	j3990217741 [label="Я даже не знаю, возможно ли это, но это дало нам проход сюда, так что я не вижу причин, почему бы и нет...",shape=box,color=blue];
		j3990217741 -> j2382355264;
		j3990217741 -> j3822374006;
		j3990217741 -> j3398202062;
	j2853135887 [label="Ты сейчас утверждаешь, что Тэнно — зло?",shape=box,color=red];
		j2853135887 -> j1559939803;
	j1205920267 [label="Что ты этим хочешь сказать?",shape=box,color=red];
		j1205920267 -> j3474804069;
	j3194747261 [label="Нет. Я закончил. [Конец.]",shape=box,color=red];
		j3194747261 -> j2456626960;
	j2382355264 [label="Роут? Иди к черту.",shape=box,color=red];
		j2382355264 -> j2504072596;
	j3822374006 [label="Я не собираюсь втягивать их в эту неразбериху.",shape=box,color=red];
		j3822374006 -> j979720012;
	j3398202062 [label="Меня тревожит, сколько мыслей ты вложил в это.",shape=box,color=red];
		j3398202062 -> j359346600;
	j1559939803 [label="Нет, не зло. Я не верю в «зло», Узурпатор. Я никогда не верил и никогда не буду верить. Я верю, что Тэнно — это чудесные и прекрасные люди, как и все остальные. Просто люди. И более того? Они — дети.",shape=box,color=blue];
		j1559939803 -> j1651398197;
	j3474804069 [label="Что может настать время, какой‑нибудь ужасный день, когда тебе придётся сделать немыслимое.",shape=box,color=blue];
		j3474804069 -> j1338434711;
	j2456626960 [label="Убегай от разговора, если хочешь, но ты знаешь, что каждое слово — правда. Ты просто не хочешь это принять.",shape=box,color=blue];
		j2456626960 -> "Chat ends.";
	j2504072596 [label="+5 Chemistry",color=orange];
		j2504072596 -> j3766227756;
	j979720012 [label="Ах! Значит, ты признаёшь, что есть беспорядок. Уже прогресс. Могу ли я хотя бы изложить свои доводы?",shape=box,color=blue];
		j979720012 -> j3084636590;
		j979720012 -> j2500674399;
	j359346600 [label="И меня тревожит, насколько ты явно этого не сделал. Могу ли я хотя бы изложить свои доводы?",shape=box,color=blue];
		j359346600 -> j3084636590;
		j359346600 -> j2500674399;
	j1651398197 [label="Дети, которым поручено сталкиваться с ужасами и совершать злодеяния, подобные тем, что я видел, ломают взрослых закалённых воинов Орокин, чей возраст насчитывает сотни лет.",shape=box,color=blue];
		j1651398197 -> j540207390;
	j1338434711 [label="Тэнно — удивительные и прекрасные люди, как и все остальные. Просто люди. И более того? Они — дети.",shape=box,color=blue];
		j1338434711 -> j1651398197;
	j3766227756 [label="Я уже там, Узурпатор. Я уже там.",shape=box,color=blue];
		j3766227756 -> j155006797;
	j3084636590 [label="Хорошо. Конечно. Давай. Я послушаю.",shape=box,color=red];
		j3084636590 -> j811930854;
	j2500674399 [label="Нет. С меня хватит.",shape=box,color=red];
		j2500674399 -> j1039401638;
	j540207390 [label="Я видел, как Дакс — золотые, элитные Дакс! — роняли свои священные позолоченные мечи и бежали с поля боя, в которое Тэнно вступали со своими Варфреймами.",shape=box,color=blue];
		j540207390 -> j896695049;
	j155006797 [label="Boolean RoatheNoDate is now true.",color=orange];
		j155006797 -> "Chat ends.";
	j811930854 [label="+5 Chemistry",color=orange];
		j811930854 -> j3127419310;
	j1039401638 [label="Как и я.",shape=box,color=blue];
		j1039401638 -> "Chat ends.";
	j896695049 [label="Их кажущаяся защитной оболочка из зараженных существ оберегала их тела, но не разум. Они не виноваты в том, какими стали.",shape=box,color=blue];
		j896695049 -> j462825735;
	j3127419310 [label="Спасибо. Что может настать время, какой‑нибудь ужасный день, когда тебе придётся сделать немыслимое.",shape=box,color=blue];
		j3127419310 -> j1338434711;
	j462825735 [label="Страдающие Бездной… вынужденные убивать или быть свидетелями смерти собственных родителей… подвергаемые войне… с украденными воспоминаниями… потерянные в криосне на века...",shape=box,color=blue];
		j462825735 -> j2217053878;
	j2217053878 [label="То, что они не совсем безумные, — уже чудо, Узурпатор. Я не говорю, что это обязательно пойдёт наперекосяк. Я лишь говорю, что это возможно. И что у тебя должен быть план на случай, если тот день наступит.",shape=box,color=blue];
		j2217053878 -> j2523809424;
	j2523809424 [label="Нет ничего плохого в том, чтобы быть готовым к худшему. А вот если этого не делать, это принесет огромный вред.",shape=box,color=blue];
		j2523809424 -> j1857491221;
		j2523809424 -> j1724934420;
		j2523809424 -> j2532479042;
		j2523809424 -> j2916618215;
	j1857491221 [label="Я... буду следить за ситуацией. Хорошо? Но я не собираюсь действовать за чужой спиной.",shape=box,color=red];
		j1857491221 -> j1578566472;
	j1724934420 [label="Мне ужасно не нравится, что я в этом вопросе отчасти с тобой согласен.",shape=box,color=red];
		j1724934420 -> j956563632;
	j2532479042 [label="Ты понимаешь, что мои страдания были так же мучительны, как и страдания Тэнно, верно?",shape=box,color=red];
		j2532479042 -> j2026197346;
	j2916618215 [label="Я не предаю их доверия.",shape=box,color=red];
		j2916618215 -> j162253386;
	j1578566472 [label="+5 Chemistry",color=orange];
		j1578566472 -> j1759625370;
	j956563632 [label="+5 Chemistry",color=orange];
		j956563632 -> j663248095;
	j2026197346 [label="И кто скажет, что я не веду такие же разговоры с ними, а?",shape=box,color=blue];
		j2026197346 -> j1514641353;
	j162253386 [label="И я вовсе не предлагал тебе поступать иначе.",shape=box,color=blue];
		j162253386 -> j346357367;
	j1759625370 [label="Конечно! Это всё, о чём мог просить дьявол, спасибо.",shape=box,color=blue];
		j1759625370 -> j346357367;
	j663248095 [label="Мм. Это всего лишь ощущение, как рассудок возвращается в твой мозг после всех этих лет. Ты привыкнешь.",shape=box,color=blue];
		j663248095 -> j321621700;
	j1514641353 [label="Спи спокойно, Узурпатор. ",shape=box,color=blue];
		j1514641353 -> j321621700;
	j346357367 [label="Add 1 to Thermostat counter",color=orange];
		j346357367 -> "Chat ends.";
	j321621700 [label="Add -1 to Thermostat counter",color=orange];
		j321621700 -> "Chat ends.";
}