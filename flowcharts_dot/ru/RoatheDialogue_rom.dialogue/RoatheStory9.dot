	"Chat ends." [color=orange];
	j1782336800 [label="ГС: КОМАНДИРЫ",shape=box,color=blue];
		j1782336800 -> j2401591460;
	j2401591460 [label="Транскрипт: Теперь я их вспоминаю. Группы смеющейся молодёжи Орокин.",shape=box,color=blue];
		j2401591460 -> j2668003965;
	j2668003965 [label="Знать, облаченная в еще нетронутые одежды власти.",shape=box,color=blue];
		j2668003965 -> j1838149994;
	j1838149994 [label="Друзья детства, оказавшиеся во главе легионов Даксов и Гринир, ячеек нуль-материи, самовоспроизводящихся карцинаторов, примитивных биодронов клинковых пауков и целые канистры дешевого пушечного мяса.",shape=box,color=blue];
		j1838149994 -> j3459515702;
	j3459515702 [label="Золотые мальчики и девочки с голодными дьяволами по своему зову.",shape=box,color=blue];
		j3459515702 -> j4235637958;
	j4235637958 [label="Их высокомерие, словно жгучий пот, просачивается в мой разум. Они пили и пели, хвастаясь грядущими временами.",shape=box,color=blue];
		j4235637958 -> j1436428053;
	j1436428053 [label="Они сделали бы себе имя. Возвысили бы свои семьи в чести и почёте.",shape=box,color=blue];
		j1436428053 -> j155133412;
	j155133412 [label="Многие из них погибли. Их тела так и не вернули.",shape=box,color=blue];
		j155133412 -> j2627646791;
	j2627646791 [label="Чтобы помешать врагу завладеть нашими секретами, они были подвергнутые воздействию Кувы для сжижения их до смерти.",shape=box,color=blue];
		j2627646791 -> j915351490;
	j915351490 [label="Надежда целого поколения превратилась в масляное пятно, раздавленное ботинками Гринир.",shape=box,color=blue];
		j915351490 -> j921430358;
	j921430358 [label="Add 1 to HellStory counter",color=orange];
		j921430358 -> "Chat ends.";
}