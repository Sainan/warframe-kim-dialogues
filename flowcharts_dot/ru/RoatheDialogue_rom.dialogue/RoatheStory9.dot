	"Chat ends." [color=orange];
	j3652602159 [label="VM: COMMANDERS",shape=box,color=blue];
		j3652602159 -> j3226120966;
	j3226120966 [label="Транскрипт: Теперь я их вспоминаю. Группы смеющейся молодёжи Орокин.",shape=box,color=blue];
		j3226120966 -> j1211568127;
	j1211568127 [label="Знать, облаченная в еще нетронутые одежды власти.",shape=box,color=blue];
		j1211568127 -> j4142466707;
	j4142466707 [label="Друзья детства, оказавшиеся во главе легионов Даксов и Гринир, ячеек нуль-материи, самовоспроизводящихся карцинаторов, примитивных биодронов клинковых пауков и целые канистры дешевого пушечного мяса.",shape=box,color=blue];
		j4142466707 -> j3163518500;
	j3163518500 [label="Золотые мальчики и девочки с голодными дьяволами по своему зову.",shape=box,color=blue];
		j3163518500 -> j3517631771;
	j3517631771 [label="Их высокомерие, словно жгучий пот, просачивается в мой разум. Они пили и пели, хвастаясь грядущими временами.",shape=box,color=blue];
		j3517631771 -> j1979332782;
	j1979332782 [label="They would make names for themselves. Raise their families high in honor.",shape=box,color=blue];
		j1979332782 -> j837584989;
	j837584989 [label="So many of them fell. Not even their bodies were returned.",shape=box,color=blue];
		j837584989 -> j3620218553;
	j3620218553 [label="To prevent the enemy from gleaning our secrets, they were Kuva-jolted to liquefy upon death.",shape=box,color=blue];
		j3620218553 -> j4009808197;
	j4009808197 [label="The hope of a generation turned to an oily puddle, sloshed through by Grineer boots.",shape=box,color=blue];
		j4009808197 -> j921430358;
	j921430358 [label="Add 1 to HellStory counter",color=orange];
		j921430358 -> "Chat ends.";
}