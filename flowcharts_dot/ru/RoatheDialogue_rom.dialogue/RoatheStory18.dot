	"Chat ends." [color=orange];
	j186804336 [label="ГС: ИЗМЕНА",shape=box,color=blue];
		j186804336 -> j1401366288;
	j1401366288 [label="Стенограмма: «Мир?»",shape=box,color=blue];
		j1401366288 -> j3903574413;
	j3903574413 [label="Её голос был как скрежет битого стекла у меня в ушах.",shape=box,color=blue];
		j3903574413 -> j1140840848;
	j1140840848 [label="Исполнительница Ниток была недовольна. Она ожидала славного нарастания, битвы за битвой, завершающейся кульминационным экстазом гибели Орокин.",shape=box,color=blue];
		j1140840848 -> j923799051;
	j923799051 [label="После чего она вышла бы из укрытия и… ну, дальше уже только догадки. Возможно, она рассчитывала быть приглашенной в доверие Владеющих Разумом.",shape=box,color=blue];
		j923799051 -> j563519319;
	j563519319 [label="Или, возможно, она думала, что они оставят выжженные, загрязненные останки Изначальной Системы и предоставят ей возможность создать свое собственное новое королевство.",shape=box,color=blue];
		j563519319 -> j2201092179;
	j2201092179 [label="Тем не менее, мир был бы недопустим. Поэтому мы принялись за его подрыв.",shape=box,color=blue];
		j2201092179 -> j921430358;
	j921430358 [label="Add 1 to HellStory counter",color=orange];
		j921430358 -> "Chat ends.";
}