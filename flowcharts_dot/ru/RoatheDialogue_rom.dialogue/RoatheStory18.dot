	j1353019659 [label="VM: TREASON",shape=box,color=blue];
		j1353019659 -> j2427886208;
	j2427886208 [label="Стенограмма: «Мир?»",shape=box,color=blue];
		j2427886208 -> j3782954278;
	j3782954278 [label="Her voice was broken glass grinding in my ears.",shape=box,color=blue];
		j3782954278 -> j1322868471;
	j1322868471 [label="Executor Nitokh was displeased. She had expected a glorious escalation, battle after battle, ending in the climactic ecstasy of the Orokin’s demise.",shape=box,color=blue];
		j1322868471 -> j999771954;
	j999771954 [label="After which she would emerge from hiding and… well, there I am left to speculate. Perhaps she expected to be invited into the Sentients’ confidence.",shape=box,color=blue];
		j999771954 -> j563519319;
	j563519319 [label="Или, возможно, она думала, что они оставят выжженные, загрязненные останки Изначальной Системы и предоставят ей возможность создать свое собственное новое королевство.",shape=box,color=blue];
		j563519319 -> j2201092179;
	j2201092179 [label="Тем не менее, мир был бы недопустим. Поэтому мы принялись за его подрыв.",shape=box,color=blue];
		j2201092179 -> j921430358;
	j921430358 [label="Add 1 to HellStory counter",color=orange];
		j921430358 -> "Chat ends.";
}