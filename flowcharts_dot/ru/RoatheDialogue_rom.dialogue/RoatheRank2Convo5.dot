digraph {
	1224 [label="RoatheRank2Convo5 begins.",color=orange];
		1224 -> 1225;
	1225 [label="Check boolean RoatheRank2Convo1Complete",color=orange];
		1225 -> 1226 [label=true,color=green];
		1225 -> 1227 [label=false,color=brown];
	1226 [label="Check boolean RoatheKnowsReset2",color=orange];
		1226 -> 1229 [label=true,color=green];
		1226 -> 1228 [label=false,color=brown];
	1227 [label="Chat ends.",color=orange];
	1229 [label="Что Роут из прошлого рассказал тебе о своих отношениях с Исполнителем Ниток? Я пытаюсь понять: что прежний я доверил тебе такую личную информацию... чтобы ты полностью стер её из моей памяти?",shape=box,color=blue];
		1229 -> 1232;
	1228 [label="Evaluate expressions on HellStory",color=orange];
		1228 -> 1231 [label="x >= 1",color=purple];
		1228 -> 1230 [label="x <= 1",color=purple];
		1228 -> 1230 [label="false",color=purple];
	1232 [label="Мне ужасно больно от этого. Что я мог бы рассказать тебе всё, абсолютно всё - раскрыть тебе всё, до самой глубины моей души, а потом всё это оказалось бы стёртым. Как будто я для тебя не более чем игрушка.",shape=box,color=blue];
		1232 -> 1234;
	1231 [label="Вы уже слышали мои упоминания об Исполнителе Ниток. И о моих... отношениях с ней. Вы должны попытаться понять, что Империя Орокин не была сплошным злом.",shape=box,color=blue];
		1231 -> 1233;
	1230 [label="Chat ends.",color=orange];
	1234 [label="Я полагаю, это вполне справедливо. Мы, Орокин, сами так обращались с человечеством, не так ли? Юванский театр? Выставляя напоказ прекрасную плоть и выбирать наши новые тела по своему вкусу, мучить друг друга играми ради нездорового развлечения, по нашему желанию...",shape=box,color=blue];
		1234 -> 1236;
	1233 [label="Сердце рвётся от мысли, что в памяти остались лишь опустошённость и разврат. Да, всё это имело место, и я не ставлю это под сомнение. ",shape=box,color=blue];
		1233 -> 1235;
	1236 [label="Я ненавижу это. Я так это ненавижу.",shape=box,color=blue];
		1236 -> 1239;
		1236 -> 1240;
		1236 -> 1238;
	1235 [label="И всё же было место красоте. Радости. Любви. Научному и художественному величию. Посмотри, чего удалось достичь! ",shape=box,color=blue];
		1235 -> 1237;
	1239 [label="Даже если у меня не было намерения причинять тебе такую боль, и я сожалею, что это произошло, если это научило тебя, каково это быть на другой стороне Империи Орокин, это ценный урок.",shape=box,color=red];
		1239 -> 1245;
	1240 [label="Никогда не возникало желания причинить тебе подобную боль. Тебе не нужно извиняться за то, как работает общество Орокин - оно ведь было создано не тобой. Твоей целью было спасение.",shape=box,color=red];
		1240 -> 1246;
	1238 [label="[Конец.]",shape=box,color=red];
		1238 -> 1244;
	1237 [label="Поэтому, когда Ниток позвала меня к себе и сказала, что хочет убить всех Орокин? Решение последовало мгновенно. Потребность была очевидной. Убрать отравлённую голову змеи и заменить её более мягкой системой. Более мягким центром власти.",shape=box,color=blue];
		1237 -> 1241;
		1237 -> 1242;
		1237 -> 1243;
	1245 [label="Add 3 to Thermostat",color=orange];
		1245 -> 1250;
	1246 [label="Add -3 to Thermostat",color=orange];
		1246 -> 1251;
	1244 [label="Chat ends.",color=orange];
	1241 [label="У тебя было намерение заменить Императоров и Исполнителей собой, не так ли.",shape=box,color=red];
		1241 -> 1247;
	1242 [label="И кто должен был стать этим правителем?",shape=box,color=red];
		1242 -> 1248;
	1243 [label="[Конец.]",shape=box,color=red];
		1243 -> 1249;
	1250 [label="Империя Орокин была не только воплощением зла. У меня разрывается сердце от того, что в памяти остаются лишь опустошённость и разврат. Да, это существовало, я не оспариваю этого.",shape=box,color=blue];
		1250 -> 1253;
	1251 [label="Если бы только остальные могли смотреть на это так же. Если бы только Ниток могла это увидеть. ",shape=box,color=blue];
		1251 -> 1254;
	1247 [label="Разумеется, да!",shape=box,color=blue];
		1247 -> 1252;
	1248 [label="Я, конечно.",shape=box,color=blue];
		1248 -> 1252;
	1249 [label="Chat ends.",color=orange];
	1253 [label="И всё же было место красоте. Радости. Любви. Научным и художественным достижениям. Взгляни, чего нам удалось добиться! ",shape=box,color=blue];
		1253 -> 1256;
	1254 [label="Империя Орокин была не только воплощением зла. У меня разрывается сердце от того, что в памяти остаются лишь опустошённость и разврат. Да, это существовало, я не оспариваю этого.",shape=box,color=blue];
		1254 -> 1253;
	1252 [label="Замысел был прост: добиться отстранения всех Исполнителей и Императоров от власти и занять их место в качестве временного исполнителя до введения новой системы.",shape=box,color=blue];
		1252 -> 1255;
	1256 [label="Поэтому, когда Ниток позвала меня к себе и сказала, что хочет убить всех Орокин? Решение последовало мгновенно. Потребность была очевидной. Убрать отравлённую голову змеи и заменить её более мягкой системой. Более мягким центром власти.",shape=box,color=blue];
		1256 -> 1260;
		1256 -> 1261;
	1255 [label="Я не знаю, сколько времени это займет, но это было бы лучше, чем то, что последовало за Великой Войны, не так ли?",shape=box,color=blue];
		1255 -> 1257;
		1255 -> 1258;
		1255 -> 1259;
	1260 [label="У тебя было намерение заменить Императоров и Исполнителей собой, не так ли.",shape=box,color=red];
		1260 -> 1265;
	1261 [label="И кто должен был стать этим правителем?",shape=box,color=red];
		1261 -> 1266;
	1257 [label="Великой Войны?",shape=box,color=red];
		1257 -> 1262;
	1258 [label="Попробуй взглянуть на это честно, допускаешь ли ты возможность того, что когда-нибудь власть была бы оставлена?",shape=box,color=red];
		1258 -> 1263;
	1259 [label="Я не думаю, что отказ от власти когда-либо вошёл бы в число твоих решений, Роут.",shape=box,color=red];
		1259 -> 1264;
	1265 [label="Но да, конечно! И не делай вид, будто слышишь об этом впервые, мне прекрасно известно, что всё было иначе. ",shape=box,color=blue];
		1265 -> 1270;
	1266 [label="Я, конечно. И не делай вид, будто слышишь об этом впервые, мне прекрасно известно, что всё было иначе.",shape=box,color=blue];
		1266 -> 1270;
	1262 [label="Теперь ты называешь это «Старой Войной». Для меня она едва ли «Старая», насколько я помню, она произошла всего несколько лет назад.",shape=box,color=blue];
		1262 -> 1267;
	1263 [label="Хм. Я не знаю. На самом деле это уже не имеет значения, не так ли? Но тогда уверенность в этом казалась абсолютной.",shape=box,color=blue];
		1263 -> 1268;
	1264 [label="+5 Chemistry",color=orange];
		1264 -> 1269;
	1270 [label="Замысел был прост: добиться отстранения всех Исполнителей и Императоров от власти и занять их место в качестве временного исполнителя до введения новой системы.",shape=box,color=blue];
		1270 -> 1274;
	1267 [label="Путешествия во времени это забавно.",shape=box,color=blue];
		1267 -> 1271;
	1268 [label="Всё было направлено на то, чтобы вернуться сюда, чтобы наконец понять, что... мой народ мёртв. Меня бы казнили вместе с ними.",shape=box,color=blue];
		1268 -> 1272;
	1269 [label="Тихо, ты.",shape=box,color=blue];
		1269 -> 1273;
	1274 [label="Я не знаю, сколько времени это займет, но это было бы лучше, чем то, что последовало за Великой Войны, не так ли?",shape=box,color=blue];
		1274 -> 1258;
		1274 -> 1259;
		1274 -> 1257;
	1271 [label="Всего за несколько лет, по моим ощущениям, в «реальности» прошли тысячи лет - там, где Империя пала, а весь мой народ погиб. ",shape=box,color=blue];
		1271 -> 5775;
	1272 [label="Тэнно убили бы меня вместе со всеми остальными в ночь барабанов Нага. Скорее всего, смерть настигла бы меня, в попытке спасти жизнь Ниток.",shape=box,color=blue];
		1272 -> 1275;
	1273 [label="В то время уверенность в этом казалась абсолютной. Но теперь это уже не имеет большого значения, не так ли?",shape=box,color=blue];
		1273 -> 1268;
	5775 [label="I have come to realize that it does not matter if I would have surrendered power or not, though in the time I was convinced I would.",shape=box,color=blue];
		5775 -> 1272;
	1275 [label="Интересно, во что она превратилась? В архивах даже не упоминается её имя... все ужасы, совершённые от её имени, все смерти, все трагедии... и только я ещё храню знание обо всём этом.",shape=box,color=blue];
		1275 -> 1276;
	1276 [label="Ну. Это и не говоря уже обо всём, что может быть раскрыто в голове Тэнно через Тёмный Рефракторий. Но на самом деле это не моя проблема.",shape=box,color=blue];
		1276 -> 1277;
		1276 -> 1278;
		1276 -> 1279;
	1277 [label="Кажется, этот ребёнок тебя немного напугал.",shape=box,color=red];
		1277 -> 1280;
	1278 [label="Что произошло между тобой и Ниток?",shape=box,color=red];
		1278 -> 1281;
	1279 [label="Значит, намерение предать Орокин у тебя действительно было?",shape=box,color=red];
		1279 -> 1282;
	1280 [label="Мне довелось видеть, как группа маленьких детей, пораженных Бездной, дистанционно управляла зараженными военными машинами, которые когда-то были солдатами, а теперь превратились в гротескные, красивые и смертоносные произведения искусства, уничтожая целые батальоны солдат. ",shape=box,color=blue];
		1280 -> 1283;
	1281 [label="Весь.",shape=box,color=blue];
		1281 -> 1284;
	1282 [label="Да. Мы оба это предвидели. Хотя я верю, что Ниток планировала предать меня, и ответный шаг в ту же сторону был вполне ожидаемым. Ты же знаешь, как это бывает у Орокин.",shape=box,color=blue];
		1282 -> 1285;
	1283 [label="Мне стало известно, что они разрушили мою Империю. Империя, которая доминировала во всей Изначальной Системе. И которая собиралась подавить восстание на Тау.",shape=box,color=blue];
		1283 -> 1286;
	1284 [label="Всё произошло между Ниток и мной.",shape=box,color=blue];
		1284 -> 1287;
	1285 [label="Все друг против друга строили заговоры. Обычный будний день, по сути.",shape=box,color=blue];
		1285 -> 1288;
	1286 [label="И они сделали это за одну ночь.",shape=box,color=blue];
		1286 -> 1289;
	1287 [label="Всё и даже больше.",shape=box,color=blue];
		1287 -> 1290;
	1288 [label="Предательства между Орокин были обычным явлением. Но предать всю Империю? Подобный акт предательства заслуживал казни не только нефритовым светом, но и программой Цефалона.",shape=box,color=blue];
		1288 -> 1291;
	1289 [label="А разве это не вызвало бы у тебя страх?!",shape=box,color=blue];
		1289 -> 1292;
	1290 [label="И это всё, что я хочу сказать по этому поводу на данный момент.",shape=box,color=blue];
		1290 -> 1293;
	1291 [label="Update boolean RoatheTraitor1",color=orange];
		1291 -> 1294;
		1291 -> 1295;
	1292 [label="Я не могу выразить словами, чем мы рисковали, пытаясь убить Исполнителей, не говоря уже обо всех Орокин, Узурпаторов.",shape=box,color=blue];
		1292 -> 1288;
	1293 [label="Update boolean RoatheExecutor1",color=orange];
		1293 -> 1292;
	1294 [label="Какой из них был худшим?",shape=box,color=red];
		1294 -> 1296;
	1295 [label="Значит, такая уловка была ненормальной?",shape=box,color=red];
		1295 -> 1297;
	1296 [label="Программа «Цефалон» от Нихила, безусловно, лучшая. Творениями Стеклодува...",shape=box,color=blue];
		1296 -> 1298;
	1297 [label="Существование Империи Орокин балансировало на лезвии кинжала, Узурпатора. Она постоянно находилась на грани уничтожения. Только одно поддерживало её в живых:",shape=box,color=blue];
		1297 -> 1299;
	1298 [label="Нефритовый свет быстро настигает тех, у кого нет ни доспехов, ни щитов. Это милосердная смерть.",shape=box,color=blue];
		1298 -> 1300;
	1299 [label="Социальные нормы.",shape=box,color=blue];
		1299 -> 1301;
	1300 [label="Превращение в Цефалона, когда субъект согласен, может пройти мягко, почти без разрушений. Однако... если это карательная мера?",shape=box,color=blue];
		1300 -> 1302;
	1301 [label="Никто просто не мог восстать и чтобы убить Орокин! Этого просто немыслимо, Скиталец! Немыслимо! Абсолютно нелепо!",shape=box,color=blue];
		1301 -> 1303;
	1302 [label="Воспоминания священны для Орокин, Скиталец. В итоге мы и есть наши память. Наши тела временны. Наши лица, наши голоса, наша кровь всё изменчиво. Всё может быть изменено как мода.",shape=box,color=blue];
		1302 -> 1304;
	1303 [label="Что, в конце концов, сделало это до смешного лёгким. Надеюсь, твой двойник Тэнно это усвоил. ",shape=box,color=blue];
		1303 -> 1305;
		1303 -> 1306;
	1304 [label="Check boolean RoatheKnowsReset2",color=orange];
		1304 -> 1307 [label=true,color=green];
		1304 -> 1305 [label=false,color=brown];
		1304 -> 1306 [label=false,color=brown];
	1305 [label="Но ты явно зашёл недостаточно далеко, чтобы предпринять попытку.",shape=box,color=red];
		1305 -> 1308;
	1306 [label="Что случилось с твоим планом?",shape=box,color=red];
		1306 -> 1309;
	1307 [label="Вероятно, именно поэтому меня так глубоко и сильно раздражает то, что ты вмешиваешься в их дела. ",shape=box,color=blue];
		1307 -> 1305;
		1307 -> 1306;
	1308 [label="Evaluate expressions on HellStory",color=orange];
		1308 -> 1310 [label="x >= 21",color=purple];
		1308 -> 1311 [label="x < 21",color=purple];
		1308 -> 1311 [label="false",color=purple];
	1309 [label="Evaluate expressions on HellStory",color=orange];
		1309 -> 1312 [label="x >= 21",color=purple];
		1309 -> 5777 [label="x < 21",color=purple];
		1309 -> 5777 [label="false",color=purple];
	1310 [label="Ты совершенно верно говоришь! Альбрехт столкнулся со мной в этом коридоре ещё до того, как мы с Ниток успели расставить ловушку для Исполнителей.",shape=box,color=blue];
		1310 -> 1313;
	1311 [label="Нет, явно нет. Альбрехт насильно превратил меня в эту... штуку до того, как мы с Ниток успели расставить ловушку для Исполнителей.",shape=box,color=blue];
		1311 -> 1314;
	1312 [label="Ты прекрасно знаешь, что случилось с нашим планом, не так ли?! Альбрехт столкнулся со мной в этом коридоре ещё до того, как мы с Ниток успели расставить ловушку для Исполнителей.",shape=box,color=blue];
		1312 -> 1315;
	5777 [label="I was forcibly turned into this... thing by Albrecht before Nitokh and I had time to spring our trap for the Executors.",shape=box,color=blue];
		5777 -> 1314;
	1313 [label="И он предложил мне сыворотку Протофрейма. И... ну... мы оба знаем, что случилось потом.",shape=box,color=blue];
		1313 -> 1316;
	1314 [label="На мгновение я вспоминаю, что стою в большом позолоченном коридоре, а в следующее мгновение я кричу от боли в затерянной дыре в «Gaule».",shape=box,color=blue];
		1314 -> 1317;
	1315 [label="Он предложил мне сыворотку протофрейма, и мы оба знаем, что произошло дальше!",shape=box,color=blue];
		1315 -> 1316;
	1316 [label="Повод по которому я всё ещё. В ярости. Из-за. Себя. Почему?! Почему это оказалось у тебя на слуху?! Откуда ты это знаешь?! ",shape=box,color=blue];
		1316 -> 1318;
	1317 [label="Ниток, должно быть, отказалась от своего плана, как только я исчез. Скорее всего, она просто повесила весь заговор на меня, удобного козла отпущения.",shape=box,color=blue];
		1317 -> 1319;
	1318 [label="Ладно! Нет. Неважно. Я ухожу сейчас же, прежде чем я сломаю этот чёртов компьютер в приступе ярости.",shape=box,color=blue];
		1318 -> 1320;
	1319 [label="Это объясняет все эти записи, которые я нахожу в архивах, где меня считают тем, кто «дрогнул». Конечно - в их глазах это выглядит как банальное бегство. Пффф.",shape=box,color=blue];
		1319 -> 1321;
	1320 [label="+10 Chemistry",color=orange];
		1320 -> 1322;
	1321 [label="+10 Chemistry",color=orange];
		1321 -> 1323;
	1322 [label="Chat ends.",color=orange];
	1323 [label="Приятно осознавать, что моя роль в этом плане оказалась настолько значимой, что от него пришлось полностью отказаться, как только я ушёл.",shape=box,color=blue];
		1323 -> 1324;
		1323 -> 1325;
	1324 [label="Не вполне ясно, что именно это следует извлечь из всего этого.",shape=box,color=red];
		1324 -> 1326;
	1325 [label="Приятно ощущать собственную полезность.",shape=box,color=red];
		1325 -> 1327;
	1326 [label="Add 1 to Thermostat",color=orange];
		1326 -> 1328;
	1327 [label="+5 Chemistry",color=orange];
		1327 -> 1329;
	1328 [label="Найди свою ценность там где угодно, Скиталец, и позволь мне найти свою.",shape=box,color=blue];
		1328 -> 1330;
	1329 [label="Add -1 to Thermostat",color=orange];
		1329 -> 1331;
	1330 [label="Chat ends.",color=orange];
	1331 [label="Видишь? Ты понимаешь.",shape=box,color=blue];
		1331 -> 1332;
	1332 [label="Chat ends.",color=orange];
}