digraph {
	graph [fontname="Roboto Condensed"];
	node [fontname="Roboto Condensed"];
	edge [fontname="Roboto Condensed"];

	"RoatheRank2Convo5 begins." [color=orange];
		"RoatheRank2Convo5 begins." -> j2554321341;
	j2554321341 [label="Check boolean RoatheRank2Convo1Complete",color=orange];
		j2554321341 -> j364889355 [label=true,color=green];
		j2554321341 -> "Chat ends." [label=false,color=brown];
	j364889355 [label="Check boolean RoatheKnowsReset2",color=orange];
		j364889355 -> j3433526181 [label=true,color=green];
		j364889355 -> j1918363296 [label=false,color=brown];
	"Chat ends." [color=orange];
	j3433526181 [label="Что Роут из прошлого рассказал тебе о своих отношениях с Исполнителем Ниток? Я пытаюсь понять: что прежний я доверил тебе такую личную информацию... чтобы ты полностью стер её из моей памяти?",shape=box,color=blue];
		j3433526181 -> j1279476740;
	j1918363296 [label="Evaluate expressions on HellStory counter",color=orange];
		j1918363296 -> j1632633707 [label="x >= 1",color=purple];
		j1918363296 -> "Chat ends." [label="x <= 1",color=purple];
		j1918363296 -> "Chat ends." [label="false",color=purple];
	j1279476740 [label="Мне ужасно больно от этого. Что я мог бы рассказать тебе всё, абсолютно всё - раскрыть тебе всё, до самой глубины моей души, а потом всё это оказалось бы стёртым. Как будто я для тебя не более чем игрушка.",shape=box,color=blue];
		j1279476740 -> j3266689863;
	j1632633707 [label="Вы уже слышали мои упоминания об Исполнителе Ниток. И о моих... отношениях с ней. Вы должны попытаться понять, что Империя Орокин не была сплошным злом.",shape=box,color=blue];
		j1632633707 -> j3054301506;
	j3266689863 [label="Я полагаю, это вполне справедливо. Мы, Орокин, сами так обращались с человечеством, не так ли? Юванский театр? Выставляя напоказ прекрасную плоть и выбирать наши новые тела по своему вкусу, мучить друг друга играми ради нездорового развлечения, по нашему желанию...",shape=box,color=blue];
		j3266689863 -> j3797605490;
	j3054301506 [label="Сердце рвётся от мысли, что в памяти остались лишь опустошённость и разврат. Да, всё это имело место, и я не ставлю это под сомнение. ",shape=box,color=blue];
		j3054301506 -> j697985809;
	j3797605490 [label="Я ненавижу это. Я так это ненавижу.",shape=box,color=blue];
		j3797605490 -> j2566287738;
		j3797605490 -> j2902137335;
		j3797605490 -> j1310452999;
	j697985809 [label="И всё же было место красоте. Радости. Любви. Научному и художественному величию. Посмотри, чего удалось достичь! ",shape=box,color=blue];
		j697985809 -> j3875921875;
	j2566287738 [label="Даже если у меня не было намерения причинять тебе такую боль, и я сожалею, что это произошло, если это научило тебя, каково это быть на другой стороне Империи Орокин, это ценный урок.",shape=box,color=red];
		j2566287738 -> j3060373816;
	j2902137335 [label="Никогда не возникало желания причинить тебе подобную боль. Тебе не нужно извиняться за то, как работает общество Орокин - оно ведь было создано не тобой. Твоей целью было спасение.",shape=box,color=red];
		j2902137335 -> j2564792922;
	j1310452999 [label="[Конец.]",shape=box,color=red];
		j1310452999 -> "Chat ends.";
	j3875921875 [label="Поэтому, когда Ниток позвала меня к себе и сказала, что хочет убить всех Орокин? Решение последовало мгновенно. Потребность была очевидной. Убрать отравлённую голову змеи и заменить её более мягкой системой. Более мягким центром власти.",shape=box,color=blue];
		j3875921875 -> j3572916313;
		j3875921875 -> j1677569667;
		j3875921875 -> j1310452999;
	j3060373816 [label="Add 3 to Thermostat counter",color=orange];
		j3060373816 -> j4174167474;
	j2564792922 [label="Add -3 to Thermostat counter",color=orange];
		j2564792922 -> j3918925139;
	j3572916313 [label="У тебя было намерение заменить Императоров и Исполнителей собой, не так ли.",shape=box,color=red];
		j3572916313 -> j3696843752;
	j1677569667 [label="И кто должен был стать этим правителем?",shape=box,color=red];
		j1677569667 -> j1735158557;
	j4174167474 [label="Империя Орокин была не только воплощением зла. У меня разрывается сердце от того, что в памяти остаются лишь опустошённость и разврат. Да, это существовало, я не оспариваю этого.",shape=box,color=blue];
		j4174167474 -> j277278698;
	j3918925139 [label="Если бы только остальные могли смотреть на это так же. Если бы только Ниток могла это увидеть. ",shape=box,color=blue];
		j3918925139 -> j4174167474;
	j3696843752 [label="Разумеется, да!",shape=box,color=blue];
		j3696843752 -> j4233109352;
	j1735158557 [label="Я, конечно.",shape=box,color=blue];
		j1735158557 -> j4233109352;
	j277278698 [label="И всё же было место красоте. Радости. Любви. Научным и художественным достижениям. Взгляни, чего нам удалось добиться! ",shape=box,color=blue];
		j277278698 -> j1825033631;
	j4233109352 [label="Замысел был прост: добиться отстранения всех Исполнителей и Императоров от власти и занять их место в качестве временного исполнителя до введения новой системы.",shape=box,color=blue];
		j4233109352 -> j3107937952;
	j1825033631 [label="Поэтому, когда Ниток позвала меня к себе и сказала, что хочет убить всех Орокин? Решение последовало мгновенно. Потребность была очевидной. Убрать отравлённую голову змеи и заменить её более мягкой системой. Более мягким центром власти.",shape=box,color=blue];
		j1825033631 -> j2760573411;
		j1825033631 -> j3779355938;
	j3107937952 [label="Я не знаю, сколько времени это займет, но это было бы лучше, чем то, что последовало за Великой Войны, не так ли?",shape=box,color=blue];
		j3107937952 -> j4081736814;
		j3107937952 -> j1451422252;
		j3107937952 -> j4093010002;
	j2760573411 [label="У тебя было намерение заменить Императоров и Исполнителей собой, не так ли.",shape=box,color=red];
		j2760573411 -> j3402707565;
	j3779355938 [label="И кто должен был стать этим правителем?",shape=box,color=red];
		j3779355938 -> j2098915117;
	j4081736814 [label="Великой Войны?",shape=box,color=red];
		j4081736814 -> j1811469818;
	j1451422252 [label="Попробуй взглянуть на это честно, допускаешь ли ты возможность того, что когда-нибудь власть была бы оставлена?",shape=box,color=red];
		j1451422252 -> j2141052324;
	j4093010002 [label="Я не думаю, что отказ от власти когда-либо вошёл бы в число твоих решений, Роут.",shape=box,color=red];
		j4093010002 -> j3639513222;
	j3402707565 [label="Но да, конечно! И не делай вид, будто слышишь об этом впервые, мне прекрасно известно, что всё было иначе. ",shape=box,color=blue];
		j3402707565 -> j1684495337;
	j2098915117 [label="Я, конечно. И не делай вид, будто слышишь об этом впервые, мне прекрасно известно, что всё было иначе.",shape=box,color=blue];
		j2098915117 -> j1684495337;
	j1811469818 [label="Теперь ты называешь это «Старой Войной». Для меня она едва ли «Старая», насколько я помню, она произошла всего несколько лет назад.",shape=box,color=blue];
		j1811469818 -> j2006146831;
	j2141052324 [label="Хм. Я не знаю. На самом деле это уже не имеет значения, не так ли? Но тогда уверенность в этом казалась абсолютной.",shape=box,color=blue];
		j2141052324 -> j1583248340;
	j3639513222 [label="+5 Chemistry",color=orange];
		j3639513222 -> j607755266;
	j1684495337 [label="Замысел был прост: добиться отстранения всех Исполнителей и Императоров от власти и занять их место в качестве временного исполнителя до введения новой системы.",shape=box,color=blue];
		j1684495337 -> j927383258;
	j2006146831 [label="Путешествия во времени это забавно.",shape=box,color=blue];
		j2006146831 -> j497043055;
	j1583248340 [label="Всё было направлено на то, чтобы вернуться сюда, чтобы наконец понять, что… мой народ мёртв. Меня бы казнили вместе с ними.",shape=box,color=blue];
		j1583248340 -> j1370340770;
	j607755266 [label="Тихо, ты.",shape=box,color=blue];
		j607755266 -> j1561930017;
	j927383258 [label="Я не знаю, сколько времени это займет, но это было бы лучше, чем то, что последовало за Великой Войны, не так ли?",shape=box,color=blue];
		j927383258 -> j1451422252;
		j927383258 -> j4093010002;
		j927383258 -> j4081736814;
	j497043055 [label="Всего за несколько лет, по моим ощущениям, в «реальности» прошли тысячи лет - там, где Империя пала, а весь мой народ погиб. ",shape=box,color=blue];
		j497043055 -> j1239643324;
	j1370340770 [label="Тэнно убили бы меня вместе со всеми остальными в ночь барабанов Нага. Скорее всего, смерть настигла бы меня, в попытке спасти жизнь Ниток.",shape=box,color=blue];
		j1370340770 -> j948616496;
	j1561930017 [label="В то время уверенность в этом казалась абсолютной. Но теперь это уже не имеет большого значения, не так ли?",shape=box,color=blue];
		j1561930017 -> j1583248340;
	j1239643324 [label="Я пришел к выводу, что не имеет значения, отказался бы я от власти или нет, хотя в то время я был убеждён, что отказался бы.",shape=box,color=blue];
		j1239643324 -> j1370340770;
	j948616496 [label="Интересно, во что она превратилась? В архивах даже не упоминается её имя... все ужасы, совершённые от её имени, все смерти, все трагедии... и только я ещё храню знание обо всём этом.",shape=box,color=blue];
		j948616496 -> j925098580;
	j925098580 [label="Ну. Это и не говоря уже обо всём, что может быть раскрыто в голове Тэнно через Тёмный Рефракторий. Но на самом деле это не моя проблема.",shape=box,color=blue];
		j925098580 -> j1723605643;
		j925098580 -> j1004278591;
		j925098580 -> j507449506;
	j1723605643 [label="Кажется, этот ребёнок тебя немного напугал.",shape=box,color=red];
		j1723605643 -> j2129343650;
	j1004278591 [label="Что произошло между тобой и Ниток?",shape=box,color=red];
		j1004278591 -> j2863367843;
	j507449506 [label="Значит, намерение предать Орокин у тебя действительно было?",shape=box,color=red];
		j507449506 -> j3029062760;
	j2129343650 [label="Мне довелось видеть, как группа маленьких детей, пораженных Бездной, дистанционно управляла зараженными военными машинами, которые когда-то были солдатами, а теперь превратились в гротескные, красивые и смертоносные произведения искусства, уничтожая целые батальоны солдат. ",shape=box,color=blue];
		j2129343650 -> j710770113;
	j2863367843 [label="Весь.",shape=box,color=blue];
		j2863367843 -> j2369913254;
	j3029062760 [label="Да. Мы оба это предвидели. Хотя я верю, что Ниток планировала предать меня, и ответный шаг в ту же сторону был вполне ожидаемым. Ты же знаешь, как это бывает у Орокин.",shape=box,color=blue];
		j3029062760 -> j1305214829;
	j710770113 [label="Мне стало известно, что они разрушили мою Империю. Империю, которая доминировала во всей Изначальной системе. И которая собиралась подавить восстание на Тау.",shape=box,color=blue];
		j710770113 -> j3446124454;
	j2369913254 [label="Всё произошло между Ниток и мной.",shape=box,color=blue];
		j2369913254 -> j3684758894;
	j1305214829 [label="Все друг против друга строили заговоры. Обычный будний день, по сути.",shape=box,color=blue];
		j1305214829 -> j1341408110;
	j3446124454 [label="И они сделали это за одну ночь.",shape=box,color=blue];
		j3446124454 -> j941070924;
	j3684758894 [label="Всё и даже больше.",shape=box,color=blue];
		j3684758894 -> j315876307;
	j1341408110 [label="Предательства между Орокин были обычным явлением. Но предать всю Империю? Подобный акт предательства заслуживал казни не только нефритовым светом, но и программой Цефалона.",shape=box,color=blue];
		j1341408110 -> j1500183088;
	j941070924 [label="А разве это не вызвало бы у тебя страх?!",shape=box,color=blue];
		j941070924 -> j410857286;
	j315876307 [label="И это всё, что я хочу сказать по этому поводу на данный момент.",shape=box,color=blue];
		j315876307 -> j535481335;
	j1500183088 [label="Boolean RoatheTraitor1 is now true.",color=orange];
		j1500183088 -> j2870017199;
		j1500183088 -> j2867203785;
	j410857286 [label="Я не могу выразить словами, чем мы рисковали, пытаясь убить Исполнителей, не говоря уже обо всех Орокин, Узурпаторов.",shape=box,color=blue];
		j410857286 -> j1341408110;
	j535481335 [label="Boolean RoatheExecutor1 is now true.",color=orange];
		j535481335 -> j410857286;
	j2870017199 [label="Какой из них был худшим?",shape=box,color=red];
		j2870017199 -> j2047335075;
	j2867203785 [label="Значит, такая уловка была ненормальной?",shape=box,color=red];
		j2867203785 -> j221907464;
	j2047335075 [label="Программа «Цефалон» от Нихила, безусловно, лучшая. Творениями Стеклодува...",shape=box,color=blue];
		j2047335075 -> j3943315673;
	j221907464 [label="Существование Империи Орокин балансировало на лезвии кинжала, Узурпатора. Она постоянно находилась на грани уничтожения. Только одно поддерживало её в живых:",shape=box,color=blue];
		j221907464 -> j2353443071;
	j3943315673 [label="Нефритовый свет быстро настигает тех, у кого нет ни доспехов, ни щитов. Это милосердная смерть.",shape=box,color=blue];
		j3943315673 -> j3363086066;
	j2353443071 [label="Социальные нормы.",shape=box,color=blue];
		j2353443071 -> j2329384261;
	j3363086066 [label="Превращение в Цефалона, когда субъект согласен, может пройти мягко, почти без разрушений. Однако... если это карательная мера?",shape=box,color=blue];
		j3363086066 -> j2916882126;
	j2329384261 [label="Никто просто не мог восстать и чтобы убить Орокин! Этого просто немыслимо, Скиталец! Немыслимо! Абсолютно нелепо!",shape=box,color=blue];
		j2329384261 -> j4205329155;
	j2916882126 [label="Воспоминания священны для Орокин, Скиталец. В итоге мы и есть наши память. Наши тела временны. Наши лица, наши голоса, наша кровь всё изменчиво. Всё может быть изменено как мода.",shape=box,color=blue];
		j2916882126 -> j4186474857;
	j4205329155 [label="Что, в конце концов, сделало это до смешного лёгким. Надеюсь, твой двойник Тэнно это усвоил. ",shape=box,color=blue];
		j4205329155 -> j2356039884;
		j4205329155 -> j1013206679;
	j4186474857 [label="Check boolean RoatheKnowsReset2",color=orange];
		j4186474857 -> j147401669 [label=true,color=green];
		j4186474857 -> j2356039884 [label=false,color=brown];
		j4186474857 -> j1013206679 [label=false,color=brown];
	j2356039884 [label="Но ты явно зашёл недостаточно далеко, чтобы предпринять попытку.",shape=box,color=red];
		j2356039884 -> j2745098065;
	j1013206679 [label="Что случилось с твоим планом?",shape=box,color=red];
		j1013206679 -> j652053828;
	j147401669 [label="Вероятно, именно поэтому меня так глубоко и сильно раздражает то, что ты вмешиваешься в их дела. ",shape=box,color=blue];
		j147401669 -> j2356039884;
		j147401669 -> j1013206679;
	j2745098065 [label="Evaluate expressions on HellStory counter",color=orange];
		j2745098065 -> j4200742693 [label="x >= 21",color=purple];
		j2745098065 -> j220007028 [label="x < 21",color=purple];
		j2745098065 -> j220007028 [label="false",color=purple];
	j652053828 [label="Evaluate expressions on HellStory counter",color=orange];
		j652053828 -> j926194998 [label="x >= 21",color=purple];
		j652053828 -> j1454775677 [label="x < 21",color=purple];
		j652053828 -> j1454775677 [label="false",color=purple];
	j4200742693 [label="Ты совершенно верно говоришь! Альбрехт столкнулся со мной в этом коридоре ещё до того, как мы с Ниток успели расставить ловушку для Исполнителей.",shape=box,color=blue];
		j4200742693 -> j4063823242;
	j220007028 [label="Нет, явно нет. Альбрехт насильно превратил меня в эту... штуку до того, как мы с Ниток успели расставить ловушку для Исполнителей.",shape=box,color=blue];
		j220007028 -> j1813442432;
	j926194998 [label="Ты прекрасно знаешь, что случилось с нашим планом, не так ли?! Альбрехт столкнулся со мной в этом коридоре ещё до того, как мы с Ниток успели расставить ловушку для Исполнителей.",shape=box,color=blue];
		j926194998 -> j2782897997;
	j1454775677 [label="Альбрехт насильно превратил меня в эту... штуку до того, как мы с Ниток успели расставить ловушку для Исполнителей.",shape=box,color=blue];
		j1454775677 -> j1813442432;
	j4063823242 [label="И он предложил мне сыворотку Протофрейма. И... ну... мы оба знаем, что случилось потом.",shape=box,color=blue];
		j4063823242 -> j3691049287;
	j1813442432 [label="На мгновение я вспоминаю, что стою в большом позолоченном коридоре, а в следующее мгновение я кричу от боли в затерянной дыре в «Gaule».",shape=box,color=blue];
		j1813442432 -> j3196782639;
	j2782897997 [label="Он предложил мне сыворотку протофрейма, и мы оба знаем, что произошло дальше!",shape=box,color=blue];
		j2782897997 -> j3691049287;
	j3691049287 [label="Повод по которому я всё ещё. В ярости. Из-за. Себя. Почему?! Почему это оказалось у тебя на слуху?! Откуда ты это знаешь?! ",shape=box,color=blue];
		j3691049287 -> j672737298;
	j3196782639 [label="Ниток, должно быть, отказалась от своего плана, как только я исчез. Скорее всего, она просто повесила весь заговор на меня, удобного козла отпущения.",shape=box,color=blue];
		j3196782639 -> j440450152;
