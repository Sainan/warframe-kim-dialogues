	1984 [label="Chat ends.",color=orange];
	1985 [label="Chat ends.",color=orange];
	1986 [label="Чем больше ты рассказываешь мне о своих безумных теориях, тем больше убеждаешь меня в том, что я прав. Вы все создали соломенного человечка из собственного безумия, а эта штука просто питается вашими же неуверенностями.",shape=box,color=blue];
		1986 -> 1989;
