digraph {
	graph [fontname="Roboto Condensed"];
	node [fontname="Roboto Condensed"];
	edge [fontname="Roboto Condensed"];

	"RoatheRank3Convo4 begins." [color=orange];
		"RoatheRank3Convo4 begins." -> j1148047475;
	j1148047475 [label="Не мог бы ты ответить мне на один вопрос, Узурпатор? Он беспокоит меня уже давно.",shape=box,color=blue];
		j1148047475 -> j2922470495;
		j1148047475 -> j3027491631;
		j1148047475 -> j1310452999;
	j2922470495 [label="Спрашивай. ",shape=box,color=red];
		j2922470495 -> j543203851;
	j3027491631 [label="Что может тебя беспокоить?",shape=box,color=red];
		j3027491631 -> j1585101039;
	j1310452999 [label="[Конец.]",shape=box,color=red];
		j1310452999 -> "Chat ends.";
	j543203851 [label="Зачем ты все это делаешь?",shape=box,color=blue];
		j543203851 -> j3524964328;
	j1585101039 [label="Я мог бы перечислить весь список, но, боюсь, мы задержимся здесь на весь день. Нет, мои вопросы в этой связи касаются одной конкретной темы. По крайней мере, сегодня.",shape=box,color=blue];
		j1585101039 -> j543203851;
	"Chat ends." [color=orange];
	j3524964328 [label="Check boolean RoatheKnowsReset2",color=orange];
		j3524964328 -> j2252867729 [label=true,color=green];
		j3524964328 -> j2768280751 [label=false,color=brown];
	j2252867729 [label="И я говорю не о том, что ты вмешивался в мои воспоминания. Я имею в виду «всё это» в более широком смысле.",shape=box,color=blue];
		j2252867729 -> j2768280751;
	j2768280751 [label="Check boolean LoidFamilyComplete",color=orange];
		j2768280751 -> j3833183279 [label=true,color=green];
		j2768280751 -> j800102424 [label=false,color=brown];
	j3833183279 [label="Похоже, ты решил бегать по этой вселенной за Альбрехтом с ведром для швабры. Посмотри, как ты работаешь с его дворецким. ",shape=box,color=blue];
		j3833183279 -> j2476974658;
	j800102424 [label="Похоже, ты решил бегать по этой вселенной за Альбрехтом с ведром для швабры.",shape=box,color=blue];
		j800102424 -> j2476974658;
	j2476974658 [label="Check boolean IsDating",color=orange];
		j2476974658 -> j765370526 [label=true,color=green];
		j2476974658 -> j1059743014 [label=false,color=brown];
	j765370526 [label="Похоже, у тебя действительно есть собственные желания, которые ты стремишься удовлетворить, и я это только одобряю. Совсем не осуждаю. Просто меня удивляет, что тот, кто настолько… восхитительно и ярко дерзок во всём остальном, может проявлять такую покорность. ",shape=box,color=blue];
		j765370526 -> j2671196841;
		j765370526 -> j1322483780;
		j765370526 -> j2349536007;
	j1059743014 [label="Мне просто кажется странным, что такая… дикость и необузданность может сочетаться с покорностью.",shape=box,color=blue];
		j1059743014 -> j2671196841;
		j1059743014 -> j1322483780;
		j1059743014 -> j2349536007;
	j2671196841 [label="Если дать Безразличию разрушить Изначальную Систему - или что-то ещё - пользы от этого не будет никому.",shape=box,color=red];
		j2671196841 -> j3605019055;
	j1322483780 [label="Я не подчиняюсь Энтрати.",shape=box,color=red];
		j1322483780 -> j3996343389;
	j2349536007 [label="У меня есть свои собственные причины. И я намерен оставить их при себе.",shape=box,color=red];
		j2349536007 -> j75692555;
	j3605019055 [label="Ах, понимаю. Ты просто оказываешь временную услугу, пока не разберутся с этим самым “Безразличием”. А что планируешь делать потом?",shape=box,color=blue];
		j3605019055 -> j719564609;
		j3605019055 -> j1157176056;
		j3605019055 -> j1993169365;
		j3605019055 -> j3406303317;
		j3605019055 -> j4045332229;
	j3996343389 [label="Правда? А со стороны выглядит иначе. Он щёлкает пальцами, и ты уже по стойке смирно, сидишь у его ног, как дрессированный кубрау. Он даже шепчет имя «Тау», и вы все пытаетесь вспомнить все возможные детали места, которое потеряли.",shape=box,color=blue];
		j3996343389 -> j709609805;
		j3996343389 -> j3530235003;
	j75692555 [label="Такой загадочный, такой непостижимый! И столько чепухи. Не хочешь просто признать, что пляшешь под его дудку? Что ж, как хочешь.",shape=box,color=blue];
		j75692555 -> j4202302448;
	j719564609 [label="Зачем ты к этому придираешься? Что ты на самом деле пытаешься выяснить у меня?",shape=box,color=red];
		j719564609 -> j1473937676;
	j1157176056 [label="Честно говоря, я особо не думал о том, что будет дальше.",shape=box,color=red];
		j1157176056 -> j3197045165;
	j1993169365 [label="Я хочу, чтобы он сполна ответил за хаос, что устроил. Ему есть что искупить. ",shape=box,color=red];
		j1993169365 -> j4276696663;
	j3406303317 [label="Ты имеешь в виду, если я выживу?",shape=box,color=red];
		j3406303317 -> j1485418660;
	j4045332229 [label="Пойду туда, где буду нужен, как всегда. Проблемы обычно сами меня находят.",shape=box,color=red];
		j4045332229 -> j3972679478;
	j709609805 [label="Зачем ты так стараешься меня разозлить?",shape=box,color=red];
		j709609805 -> j2724702408;
	j3530235003 [label="Я просто делаю то, что должен, чтобы помочь людям выбраться из тех жалких ситуаций, в которых они оказались.",shape=box,color=red];
		j3530235003 -> j1078259953;
	j4202302448 [label="Потому что со стороны выглядит так, будто он щёлкает пальцами, и ты уже по стойке смирно, сидишь у его ног, как дрессированный кубрау. Он даже шепчет имя «Тау», и вы все пытаетесь вспомнить все возможные детали места, которое потеряли.",shape=box,color=blue];
		j4202302448 -> j709609805;
		j4202302448 -> j3530235003;
	j1473937676 [label="+5 Chemistry",color=orange];
		j1473937676 -> j2336125649;
	j3197045165 [label="А! Так ты признаёшься, что ты идиот! Как приятно. Обожаю, когда дураки открыто демонстрируют свою глупость — это значительно облегчает мне задачу манипулировать ими.",shape=box,color=blue];
		j3197045165 -> j4284733472;
	j4276696663 [label="Ах! Так ты жаждешь той самой низменной, первородной мести! Прекрасно. Яростного зверя, что готов обглодать кости своих обидчиков.",shape=box,color=blue];
		j4276696663 -> j1899993983;
	j1485418660 [label="+5 Chemistry",color=orange];
		j1485418660 -> j3639248607;
	j3972679478 [label="Ага, ясно. Безразличие, выданное за благородство. Ты ведь сам не знаешь, где твоё место и где тебе стоило бы остаться, поэтому скрываешься за этой маской «праведного самопожертвования» и выполняешь чужую волю?",shape=box,color=blue];
		j3972679478 -> j4028618523;
	j2724702408 [label="Потому что я не понимаю, с чего вдруг ты, существо из, насколько видно, другой версии реальности, решаешь метаться по времени и пространству и заниматься «терапией».",shape=box,color=blue];
		j2724702408 -> j626385616;
	j1078259953 [label="Да, вот об этом и речь! Почему ты так упорно бродишь по времени и пространству, «играя в терапевта»? Ты, существо, которое, насколько я могу понять, пришло из совершенно другой версии реальности.",shape=box,color=blue];
		j1078259953 -> j626385616;
	j2336125649 [label="Проницательно. Что ж, хорошо, я перейду к сути более прямо. Я пытался вывести тебя из себя, чтобы посмотреть, вызовет ли это более честный ответ.",shape=box,color=blue];
		j2336125649 -> j2397700947;
	j4284733472 [label="Ты как кубрау, наконец поймавший кайт. Ты не знаешь, что делать, когда вцепился ему в ногу зубами.",shape=box,color=blue];
		j4284733472 -> j3530235003;
		j4284733472 -> j709609805;
	j1899993983 [label="Одна из самых простых и древних человеческих мотиваций. И, следовательно, одна из самых лёгких для понимания.",shape=box,color=blue];
		j1899993983 -> j3530235003;
	j3639248607 [label="Никогда официально не был солдатом, но в твоём тоне я слышу усталость самого закалённого в боях.",shape=box,color=blue];
		j3639248607 -> j1706617615;
	j4028618523 [label="Как это трагично.",shape=box,color=blue];
		j4028618523 -> j653044825;
		j4028618523 -> j1865660936;
	j626385616 [label="На твоём месте я бы уже снова отправился в Дувири, выискивая новые прорехи в ткани Бездны! Представь, какие возможности! Представь миры, готовые к захвату!",shape=box,color=blue];
		j626385616 -> j795494208;
		j626385616 -> j1281850346;
	j2397700947 [label="Но, полагаю, придётся довольствоваться тем, что есть.",shape=box,color=blue];
		j2397700947 -> j1134277649;
	j1706617615 [label="Хорошо. От одного к другому, из уважения, я перейду к сути того, что хочу спросить более прямо. Я пытался вывести тебя из себя, чтобы посмотреть, вызовет ли это более честный ответ.",shape=box,color=blue];
		j1706617615 -> j1134277649;
	j653044825 [label="У меня есть место, которому я принадлежу.",shape=box,color=red];
		j653044825 -> j2847276258;
	j1865660936 [label="Ты не понимаешь, о чём говоришь.",shape=box,color=red];
		j1865660936 -> j679672068;
	j795494208 [label="Ты ничем не отличаешься от Альбрехта. Он шастает по времени и создаёт все эти проблемы. А ты хочешь вытворять такое же с целыми измерениями?!",shape=box,color=red];
		j795494208 -> j2247352384;
	j1281850346 [label="В этом-то и проблема, Орокин. Ты считаешь, что целые миры принадлежат тебе и ты можешь распоряжаться ими по своему усмотрению. ",shape=box,color=red];
		j1281850346 -> j2534353381;
	j1134277649 [label="+5 Chemistry",color=orange];
		j1134277649 -> j3449656079;
	j2847276258 [label="Ну же, расскажи! Это твоя Хёллвания? Или, может, Дувири? Или, может быть, твой разбившийся орбитальный корабль на остатках Земли?",shape=box,color=blue];
		j2847276258 -> j3530235003;
		j2847276258 -> j709609805;
	j679672068 [label="Тогда расскажи мне всё о своём доме! Это твоя Хёллвания? Или, может, Дувири? Или, может быть, твой разбившийся орбитальный корабль на остатках Земли?",shape=box,color=blue];
		j679672068 -> j3530235003;
		j679672068 -> j709609805;
	j2247352384 [label="И почему бы и нет? Мы же высшие творения, не так ли? Альбрехт делает, что ему вздумается, и тебе ведь несложно затем ходить и прибирать за ним! С чего это я не должен иметь право поступать так же? Что делает его поиски \"оправданными\", а мои — нет?",shape=box,color=blue];
		j2247352384 -> j2920441635;
	j2534353381 [label="И почему бы и нет? Мы же высшие создания, не так ли? Альбрехт делает всё, что ему вздумается — носится по времени, заражает массы какой-то болезнью, которую едва понимает, — и всё это во имя \"победы над так называемым богом.\"",shape=box,color=blue];
		j2534353381 -> j2920441635;
	j3449656079 [label="Я не понимаю, с чего вдруг ты, существо из, насколько видно, другой версии реальности, решаешь метаться по времени и пространству и заниматься «терапией».",shape=box,color=blue];
		j3449656079 -> j3956801596;
	j2920441635 [label="Но взгляни на себя! ",shape=box,color=blue];
		j2920441635 -> j965779903;
	j3956801596 [label="Check boolean IsDating",color=orange];
		j3956801596 -> j2974464835 [label=true,color=green];
		j3956801596 -> j1317788843 [label=false,color=brown];
	j965779903 [label="Check boolean IsDating",color=orange];
		j965779903 -> j4220309446 [label=true,color=green];
		j965779903 -> j1562802656 [label=false,color=brown];
	j2974464835 [label="Ты, кто обладает силами, о существовании которых я никогда не слышал, зацикливаешь само время. Создаёшь карманные измерения. И при этом находишься здесь… и налаживаешь отношения других. (И при этом заводишь собственные.)",shape=box,color=blue];
		j2974464835 -> j1500579824;
	j1317788843 [label="Ты, кто обладает силами, о существовании которых я никогда не слышал, зацикливаешь само время. Создаёшь карманные измерения. И при этом находишься здесь… и налаживаешь отношения.",shape=box,color=blue];
		j1317788843 -> j1500579824;
	j4220309446 [label="Ты, кто обладает силами, о существовании которых я никогда не слышал, зацикливаешь само время. Создаёшь карманные измерения. И при этом находишься здесь… и налаживаешь отношения других. (И при этом заводишь собственные.)",shape=box,color=blue];
		j4220309446 -> j723089;
	j1562802656 [label="Ты, кто обладает силами, о существовании которых я никогда не слышал, зацикливаешь само время. Создаёшь карманные измерения. И при этом находишься здесь… и налаживаешь отношения.",shape=box,color=blue];
		j1562802656 -> j723089;
	j1500579824 [label="Я просто в шоке. Не могу понять. Почему? Почему, когда по всем правилам ты мог бы править какой-нибудь вселенной?",shape=box,color=blue];
		j1500579824 -> j3833192536;
		j1500579824 -> j3304728109;
		j1500579824 -> j2406087427;
	j723089 [label="Я просто в шоке. Не могу понять. Почему? Почему, когда по всем правилам ты мог бы править какой-нибудь вселенной?",shape=box,color=blue];
		j723089 -> j524047804;
		j723089 -> j1887239476;
		j723089 -> j860406458;
	j3833192536 [label="Мне нравится то, что я делаю. Я помогаю людям так, как хочу.",shape=box,color=red];
		j3833192536 -> j3960296136;
	j3304728109 [label="Не уверен, что ты сможешь это осознать, но попробуй: я не хочу править вселенной.",shape=box,color=red];
		j3304728109 -> j2733788826;
	j2406087427 [label="Это сделало бы меня ничем не лучше Альбрехта. Или Орокин. Носясь и переделывая мир по своему образу. Меня это не интересует.",shape=box,color=red];
		j2406087427 -> j2733788826;
	j524047804 [label="Мне нравится то, что я делаю. Я помогаю людям так, как хочу.",shape=box,color=red];
		j524047804 -> j3960296136;
	j1887239476 [label="Не уверен, что ты сможешь это осознать, но попробуй: я не хочу править вселенной.",shape=box,color=red];
		j1887239476 -> j1639126469;
	j860406458 [label="Это сделало бы меня ничем не лучше Альбрехта. Или Орокин. Носясь и переделывая мир по своему образу. Меня это не интересует.",shape=box,color=red];
		j860406458 -> j1639126469;
	j3960296136 [label="Но почему? Вот этого я не понимаю.",shape=box,color=blue];
		j3960296136 -> j1990388149;
	j2733788826 [label="Так ты предпочёл бы быть… чем? Маленьким?",shape=box,color=blue];
		j2733788826 -> j2552806088;
		j2733788826 -> j2199766645;
	j1639126469 [label="Так ты предпочёл бы быть… чем? Маленьким?",shape=box,color=blue];
		j1639126469 -> j2199766645;
		j1639126469 -> j2552806088;
	j1990388149 [label="Check boolean RoatheUnloved1",color=orange];
		j1990388149 -> j356980047 [label=true,color=green];
		j1990388149 -> j3463838757 [label=true,color=green];
		j1990388149 -> j1976013288 [label=true,color=green];
		j1990388149 -> j356980047 [label=false,color=brown];
		j1990388149 -> j3463838757 [label=false,color=brown];
		j1990388149 -> j2434135721 [label=false,color=brown];
	j2552806088 [label="Если ты считаешь, что то, что я делаю, мало, — пожалуйста, это твоё мнение. Но то, что я сделал, переписало историю.",shape=box,color=red];
		j2552806088 -> j1222707235;
	j2199766645 [label="Не маленьким. Невидимым. Пусть все суетятся и привлекают внимание. Я останусь в тени.",shape=box,color=red];
		j2199766645 -> j1108186986;
	j356980047 [label="Потому что, поддерживая людей в трудные моменты, мы в конечном счёте справимся с этой ситуацией.",shape=box,color=red];
		j356980047 -> j322614978;
	j3463838757 [label="Потому что я делаю то, что нужно. Ни больше, ни меньше.",shape=box,color=red];
		j3463838757 -> j4068294265;
	j1976013288 [label="Ты сказал, что никогда не знал, каково это — быть любимым. Не думаю, что ты поймёшь, насколько это может изменить мир вокруг тебя.",shape=box,color=red];
		j1976013288 -> j643812978;
	j2434135721 [label="Ты когда-нибудь был влюблён, Роут? Или заботился о ком-то так сильно, что был готов сжечь за него всю вселенную?",shape=box,color=red];
		j2434135721 -> j2478457835;
	j1222707235 [label="Вот именно в этом и суть! Давайте тогда перепишем историю! А не будем сидеть тут и уговаривать всех взяться за руки и петь песни!",shape=box,color=blue];
		j1222707235 -> j3344336237;
		j1222707235 -> j3419067984;
		j1222707235 -> j4091219239;
	j1108186986 [label="Ах, понимаю, ты предпочитаешь быть тихим убийцей в тени, так? Наносить удар, когда от тебя меньше всего ждут? Нет. Не думаю. По‑моему, ты просто топчешься на месте.",shape=box,color=blue];
		j1108186986 -> j1719197954;
	j322614978 [label="Ммм. Бегать по поручениям для чужаков, пока они не начнут боготворить тебя, как какого‑то местного героя? Или убеждать всех держаться за руки и петь песенки? Простите, пока я пойду блевану в бак Фибоначчи.",shape=box,color=blue];
		j322614978 -> j3927681391;
		j322614978 -> j1014821534;
	j4068294265 [label="А то, что ты «делаешь», похоже, заключается в том, чтобы уговаривать всех держаться за руки и петь песни в перерывах между невероятными демонстрациями насилия. Насилие имеет смысл. Остальное вызывает тошноту. ",shape=box,color=blue];
		j4068294265 -> j3927681391;
		j4068294265 -> j1014821534;
	j643812978 [label="А если ты и дальше будешь твердить, что мы спасём вселенную от этого «Безразличия», взявшись за руки и распевая песни, то прости меня, пока я пойду блевану в бак Фибоначчи.",shape=box,color=blue];
		j643812978 -> j3084236697;
