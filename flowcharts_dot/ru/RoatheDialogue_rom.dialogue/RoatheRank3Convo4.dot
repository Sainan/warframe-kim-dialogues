	1950 [label="Check boolean RoatheUnloved1",color=orange];
		1950 -> 1953 [label=true,color=green];
		1950 -> 1954 [label=true,color=green];
		1950 -> 1956 [label=true,color=green];
		1950 -> 1953 [label=false,color=brown];
		1950 -> 1954 [label=false,color=brown];
		1950 -> 1955 [label=false,color=brown];
	1951 [label="Если ты считаешь, что то, что я делаю, мало, — пожалуйста, это твоё мнение. Но то, что я сделал, переписало историю.",shape=box,color=red];
		1951 -> 1957;
	1952 [label="Не маленьким. Невидимым. Пусть все суетятся и привлекают внимание. Я останусь в тени.",shape=box,color=red];
		1952 -> 1958;
	1953 [label="Потому что, поддерживая людей в трудные моменты, мы в конечном счёте справимся с этой ситуацией.",shape=box,color=red];
		1953 -> 1959;
	1954 [label="Потому что я делаю то, что нужно. Ни больше, ни меньше.",shape=box,color=red];
		1954 -> 1960;
	1956 [label="Ты сказал, что никогда не знал, каково это — быть любимым. Не думаю, что ты поймёшь, насколько это может изменить мир вокруг тебя.",shape=box,color=red];
		1956 -> 1962;
	1955 [label="Ты когда-нибудь был влюблён, Роут? Или заботился о ком-то так сильно, что был готов сжечь за него всю вселенную?",shape=box,color=red];
		1955 -> 1961;
	1957 [label="Вот именно в этом и суть! Давайте тогда перепишем историю! А не будем сидеть тут и уговаривать всех взяться за руки и петь песни!",shape=box,color=blue];
		1957 -> 1963;
		1957 -> 1964;
		1957 -> 1965;
	1958 [label="Ах, понимаю, ты предпочитаешь быть тихим убийцей в тени, так? Наносить удар, когда от тебя меньше всего ждут? Нет. Не думаю. По‑моему, ты просто топчешься на месте.",shape=box,color=blue];
		1958 -> 1966;
	1959 [label="Ммм. Бегать по поручениям для чужаков, пока они не начнут боготворить тебя, как какого‑то местного героя? Или убеждать всех держаться за руки и петь песенки? Простите, пока я пойду блевану в бак Фибоначчи.",shape=box,color=blue];
		1959 -> 1967;
		1959 -> 1968;
	1960 [label="А то, что ты «делаешь», похоже, заключается в том, чтобы уговаривать всех держаться за руки и петь песни в перерывах между невероятными демонстрациями насилия. Насилие имеет смысл. Остальное вызывает тошноту. ",shape=box,color=blue];
		1960 -> 1967;
		1960 -> 1968;
	1962 [label="А если ты и дальше будешь твердить, что мы спасём вселенную от этого «Безразличия», взявшись за руки и распевая песни, то прости меня, пока я пойду блевану в бак Фибоначчи.",shape=box,color=blue];
		1962 -> 1970;
		1962 -> 1967;
		1962 -> 1968;
	1961 [label="Update boolean RoatheUnloved1",color=orange];
		1961 -> 1969;
	1963 [label="Будь терпелив. Сначала нам нужно разобраться с Безразличием.",shape=box,color=red];
		1963 -> 1971;
	1964 [label="Может быть, когда всё это наконец уляжется. Но сейчас, нет.",shape=box,color=red];
		1964 -> 1972;
	1965 [label="И ты правда думаешь, что я выбрал тебя для этого? Не смеши меня.",shape=box,color=red];
		1965 -> 1973;
	1966 [label="Ты не знаешь, что делаешь и зачем, ты просто делаешь то, что тебе говорят. Ещё один самовлюблённый приспешник самовлюблённого Орокин. Позор.",shape=box,color=blue];
		1966 -> 1974;
	1967 [label="Я просто говорю, что похоже, тебя реально бесит сама мысль о том, что люди могут перестать страдать. И, похоже, ты воспринимаешь это очень лично.",shape=box,color=red];
		1967 -> 1975;
	1968 [label="Суть, которую я пытался донести, была проста, если «Безразличие» питается отсутствием эмоций, то их наличие может стать ключом к его поражению.",shape=box,color=red];
		1968 -> 1976;
	1970 [label="Ты думаешь, что никто не способен полюбить тебя? Или что ты сам не способен почувствовать любовь к кому‑то? Или ты считаешь, что это просто ещё не случилось?",shape=box,color=red];
		1970 -> 1977;
	1969 [label="Нет, не был. И если вы собираетесь настаивать, что мы спасём вселенную от этого «равнодушия», держась за руки и распевая песни, простите меня, пока я блюю в сосуде Фибоначчи.",shape=box,color=blue];
		1969 -> 1970;
		1969 -> 1967;
		1969 -> 1968;
	1971 [label="+5 Chemistry",color=orange];
		1971 -> 1972;
	1972 [label="Ладно. Ладно! Я подожду, как ты и сказал. Играй в эти... глупые игры.",shape=box,color=blue];
		1972 -> 1978;
	1973 [label="Update boolean RoatheInsulted",color=orange];
		1973 -> 1979;
	1974 [label="Chat ends.",color=orange];
	1975 [label="Потому что несчастье любит компанию? Возможно. Или потому, что я просто в замешательстве от того, что ты бегаешь туда‑сюда, впустую тратя время, когда у нас есть настоящая работа.",shape=box,color=blue];
		1975 -> 1980;
	1976 [label="Ещё одно доказательство того, что эта штука, вымысел вашего воображения! Какой настоящий бог или «анти-бог» вообще может быть побеждён «добротой человеческих эмоций»?! Ха! ",shape=box,color=blue];
		1976 -> 1981;
	1977 [label="Update boolean RoatheUnloved2",color=orange];
		1977 -> 1982;
	1978 [label="Полагаю, нам ещё есть над чем работать, как ты и говоришь. Я просто не могу представить, что в таких... детских вещах есть смысл. Но, с другой стороны, вот я сижу на этом конце света, а у тебя есть ключи от вселенной.",shape=box,color=blue];
		1978 -> 1983;
	1979 [label="Справедливо. Почему бы тебе вообще выбирать кого‑то настолько отвратительного, как Дьявол Тау?",shape=box,color=blue];
		1979 -> 1984;
	1980 [label="Но теперь я убеждён, что ты не знаешь, что делаешь и зачем, ты просто делаешь то, что тебе говорят. Ещё один самовлюблённый приспешник самовлюблённого Орокин. Позор.",shape=box,color=blue];
		1980 -> 1985;
