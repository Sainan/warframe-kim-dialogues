digraph {
	1875 [label="RoatheRank3Convo4 begins.",color=orange];
		1875 -> 1876;
	1876 [label="Не мог бы ты ответить мне на один вопрос, Узурпатор? Он беспокоит меня уже давно.",shape=box,color=blue];
		1876 -> 1879;
		1876 -> 1878;
		1876 -> 1877;
	1879 [label="Спрашивай. ",shape=box,color=red];
		1879 -> 1882;
	1878 [label="Что может тебя беспокоить?",shape=box,color=red];
		1878 -> 1881;
	1877 [label="[Конец.]",shape=box,color=red];
		1877 -> 1880;
	1882 [label="Зачем ты все это делаешь?",shape=box,color=blue];
		1882 -> 1883;
	1881 [label="Я мог бы перечислить весь список, но, боюсь, мы задержимся здесь на весь день. Нет, мои вопросы в этой связи касаются одной конкретной темы. По крайней мере, сегодня.",shape=box,color=blue];
		1881 -> 1882;
	1880 [label="Chat ends.",color=orange];
	1883 [label="Check boolean RoatheKnowsReset2",color=orange];
		1883 -> 1885 [label=true,color=green];
		1883 -> 1884 [label=false,color=brown];
	1885 [label="И я говорю не о том, что ты вмешивался в мои воспоминания. Я имею в виду «всё это» в более широком смысле.",shape=box,color=blue];
		1885 -> 1888;
	1884 [label="Check boolean LoidFamilyComplete",color=orange];
		1884 -> 1886 [label=true,color=green];
		1884 -> 1887 [label=false,color=brown];
	1888 [label="Check boolean LoidFamilyComplete",color=orange];
		1888 -> 1886 [label=true,color=green];
		1888 -> 1887 [label=false,color=brown];
	1886 [label="Похоже, ты решил бегать по этой вселенной за Альбрехтом с ведром для швабры. Посмотри, как ты работаешь с его дворецким. ",shape=box,color=blue];
		1886 -> 1889;
	1887 [label="Похоже, ты решил бегать по этой вселенной за Альбрехтом с ведром для швабры.",shape=box,color=blue];
		1887 -> 1889;
	1889 [label="Check boolean IsDating",color=orange];
		1889 -> 1891 [label=true,color=green];
		1889 -> 1890 [label=false,color=brown];
	1891 [label="Похоже, у тебя действительно есть собственные желания, которые ты стремишься удовлетворить, и я это только одобряю. Совсем не осуждаю. Просто меня удивляет, что тот, кто настолько… восхитительно и ярко дерзок во всём остальном, может проявлять такую покорность. ",shape=box,color=blue];
		1891 -> 1892;
		1891 -> 1893;
		1891 -> 1894;
	1890 [label="Мне просто кажется странным, что кто-то настолько... удивительно и дико неадекватный может быть настолько послушным. ",shape=box,color=blue];
		1890 -> 1892;
		1890 -> 1893;
		1890 -> 1894;
	1892 [label="Если дать Безразличию разрушить Изначальную Систему - или что-то ещё - пользы от этого не будет никому.",shape=box,color=red];
		1892 -> 1895;
	1893 [label="Я не подчиняюсь Энтрати.",shape=box,color=red];
		1893 -> 1896;
	1894 [label="У меня есть свои собственные причины. И я намерен оставить их при себе.",shape=box,color=red];
		1894 -> 1897;
	1895 [label="Ах, понимаю. Ты просто оказываешь временную услугу, пока не разберутся с этим самым “Безразличием”. А что планируешь делать потом?",shape=box,color=blue];
		1895 -> 1898;
		1895 -> 1899;
		1895 -> 1900;
		1895 -> 1901;
		1895 -> 1902;
	1896 [label="Правда? А со стороны выглядит иначе. Он щёлкает пальцами, и ты уже по стойке смирно, сидишь у его ног, как дрессированный кубрау. Он даже шепчет имя «Тау», и вы все пытаетесь вспомнить все возможные детали места, которое потеряли.",shape=box,color=blue];
		1896 -> 1903;
		1896 -> 1904;
	1897 [label="Такой загадочный, такой непостижимый! И столько чепухи. Не хочешь просто признать, что пляшешь под его дудку? Что ж, как хочешь.",shape=box,color=blue];
		1897 -> 1905;
	1898 [label="Зачем ты к этому придираешься? Что ты на самом деле пытаешься выяснить у меня?",shape=box,color=red];
		1898 -> 1906;
	1899 [label="Честно говоря, я особо не думал о том, что будет дальше.",shape=box,color=red];
		1899 -> 1907;
	1900 [label="Я хочу, чтобы он сполна ответил за хаос, что устроил. Ему есть что искупить. ",shape=box,color=red];
		1900 -> 1908;
	1901 [label="Ты имеешь в виду, если я выживу?",shape=box,color=red];
		1901 -> 1909;
	1902 [label="Пойду туда, где буду нужен, как всегда. Проблемы обычно сами меня находят.",shape=box,color=red];
		1902 -> 1910;
	1903 [label="Зачем ты так стараешься меня разозлить?",shape=box,color=red];
		1903 -> 1911;
	1904 [label="Я просто делаю то, что должен, чтобы помочь людям выбраться из тех жалких ситуаций, в которых они оказались.",shape=box,color=red];
		1904 -> 1912;
	1905 [label="Потому что со стороны выглядит так, будто он щёлкает пальцами, и ты уже по стойке смирно, сидишь у его ног, как дрессированный кубрау. Он даже шепчет имя «Тау», и вы все пытаетесь вспомнить все возможные детали места, которое потеряли.",shape=box,color=blue];
		1905 -> 1903;
		1905 -> 1904;
	1906 [label="+5 Chemistry",color=orange];
		1906 -> 1913;
	1907 [label="А! Так ты признаёшься, что ты идиот! Как приятно. Обожаю, когда дураки открыто демонстрируют свою глупость — это значительно облегчает мне задачу манипулировать ими.",shape=box,color=blue];
		1907 -> 1914;
	1908 [label="Ах! Так ты жаждешь той самой низменной, первородной мести! Прекрасно. Яростного зверя, что готов обглодать кости своих обидчиков.",shape=box,color=blue];
		1908 -> 1915;
	1909 [label="+5 Chemistry",color=orange];
		1909 -> 1916;
	1910 [label="Ага, ясно. Безразличие, выданное за благородство. Ты ведь сам не знаешь, где твоё место и где тебе стоило бы остаться, поэтому скрываешься за этой маской «праведного самопожертвования» и выполняешь чужую волю?",shape=box,color=blue];
		1910 -> 1917;
	1911 [label="Потому что я не понимаю, с чего вдруг ты, существо из, насколько видно, другой версии реальности, решил метаться по времени и пространству и заниматься «терапией».",shape=box,color=blue];
		1911 -> 1918;
	1912 [label="Да, вот об этом и речь! Почему ты так упорно бродишь по времени и пространству, “играя в терапевта”? Ты, существо, которое, насколько я могу понять, пришло из совершенно другой версии реальности, ",shape=box,color=blue];
		1912 -> 1918;
	1913 [label="Проницательно. Что ж, хорошо, я перейду к сути более прямо. Я пытался вывести тебя из себя, чтобы посмотреть, вызовет ли это более честный ответ.",shape=box,color=blue];
		1913 -> 1919;
	1914 [label="Ты как кубрау, наконец поймавший кайт. Ты не знаешь, что делать, когда вцепился ему в ногу зубами.",shape=box,color=blue];
		1914 -> 1904;
		1914 -> 1903;
	1915 [label="Одна из самых простых и древних человеческих мотиваций. И, следовательно, одна из самых лёгких для понимания.",shape=box,color=blue];
		1915 -> 1904;
	1916 [label="Никогда официально не был солдатом, но в твоём тоне я слышу усталость самого закалённого в боях.",shape=box,color=blue];
		1916 -> 1920;
	1917 [label="Как это трагично.",shape=box,color=blue];
		1917 -> 1921;
		1917 -> 1922;
	1918 [label="На твоём месте я бы уже снова отправился в Дувири, выискивая новые прорехи в ткани Бездны! Представь, какие возможности! Представь миры, готовые к захвату!",shape=box,color=blue];
		1918 -> 1923;
		1918 -> 1924;
	1919 [label="Но, полагаю, придётся довольствоваться тем, что есть.",shape=box,color=blue];
		1919 -> 1925;
	1920 [label="Хорошо. От одного к другому, из уважения, я перейду к сути того, что хочу спросить более прямо. Я пытался вывести тебя из себя, чтобы посмотреть, вызовет ли это более честный ответ.",shape=box,color=blue];
		1920 -> 1925;
	1921 [label="У меня есть место, которому я принадлежу.",shape=box,color=red];
		1921 -> 1926;
	1922 [label="Ты не понимаешь, о чём говоришь.",shape=box,color=red];
		1922 -> 1927;
	1923 [label="Ты ничем не отличаешься от Альбрехта. Он шастает по времени и создаёт все эти проблемы. А ты хочешь вытворять такое же с целыми измерениями?!",shape=box,color=red];
		1923 -> 1928;
	1924 [label="В этом-то и проблема, Орокин. Ты считаешь, что целые миры принадлежат тебе и ты можешь распоряжаться ими по своему усмотрению. ",shape=box,color=red];
		1924 -> 1929;
	1925 [label="+5 Chemistry",color=orange];
		1925 -> 1930;
	1926 [label="Ну же, расскажи! Это твоя Хёллвания? Или, может, Дувири? Или, может быть, твой разбившийся орбитальный корабль на остатках Земли?",shape=box,color=blue];
		1926 -> 1904;
		1926 -> 1903;
	1927 [label="Тогда расскажи мне всё о своём доме! Это твоя Хёллвания? Или, может, Дувири? Или, может быть, твой разбившийся орбитальный корабль на остатках Земли?",shape=box,color=blue];
		1927 -> 1904;
		1927 -> 1903;
	1928 [label="И почему бы и нет? Мы же высшие творения, не так ли? Альбрехт делает, что ему вздумается, и тебе ведь несложно затем ходить и прибирать за ним! С чего это я не должен иметь право поступать так же? Что делает его поиски \"оправданными\", а мои — нет?",shape=box,color=blue];
		1928 -> 1931;
	1929 [label="И почему бы и нет? Мы же высшие создания, не так ли? Альбрехт делает всё, что ему вздумается — носится по времени, заражает массы какой-то болезнью, которую едва понимает, — и всё это во имя \"победы над так называемым богом.\"",shape=box,color=blue];
		1929 -> 1931;
	1930 [label="Я не понимаю, с чего вдруг ты, существо из, насколько видно, другой версии реальности, решил метаться по времени и пространству и заниматься «терапией».",shape=box,color=blue];
		1930 -> 1932;
	1931 [label="Но взгляни на себя! ",shape=box,color=blue];
		1931 -> 1933;
	1932 [label="Check boolean IsDating",color=orange];
		1932 -> 1935 [label=true,color=green];
		1932 -> 1934 [label=false,color=brown];
	1933 [label="Check boolean IsDating",color=orange];
		1933 -> 1937 [label=true,color=green];
		1933 -> 1936 [label=false,color=brown];
	1935 [label="Ты, обладающий силами, о существовании которых я никогда не слышал ни у одного иного существа. Зацикливаешь само время. Создаёшь карманные измерения. И при этом находишься здесь… налаживаешь отношения. (И при этом собираешь себе парочку собственных.)",shape=box,color=blue];
		1935 -> 1938;
	1934 [label="Ты, обладающий силами, о существовании которых я никогда не слышал ни у одного иного существа. Зацикливаешь само время. Создаёшь карманные измерения. И при этом находишься здесь… налаживаешь отношения.",shape=box,color=blue];
		1934 -> 1938;
	1937 [label="Ты, обладающий силами, о существовании которых я никогда не слышал ни у одного иного существа. Зацикливаешь само время. Создаёшь карманные измерения. И при этом находишься здесь… налаживаешь отношения. (И при этом собираешь себе парочку собственных.)",shape=box,color=blue];
		1937 -> 1939;
	1936 [label="Ты, обладающий силами, о существовании которых я никогда не слышал ни у одного иного существа. Зацикливаешь само время. Создаёшь карманные измерения. И при этом находишься здесь… налаживаешь отношения.",shape=box,color=blue];
		1936 -> 1939;
	1938 [label="Я просто в шоке. Не могу понять. Почему? Почему, когда по всем правилам ты мог бы править какой-нибудь вселенной?",shape=box,color=blue];
		1938 -> 1940;
		1938 -> 1941;
		1938 -> 1942;
	1939 [label="Я просто в шоке. Не могу понять. Почему? Почему, когда по всем правилам ты мог бы править какой-нибудь вселенной?",shape=box,color=blue];
		1939 -> 1943;
		1939 -> 1944;
		1939 -> 1945;
	1940 [label="Я доволен тем, что делаю. Я помогаю людям так, как хочу.",shape=box,color=red];
		1940 -> 1946;
	1941 [label="Не уверен, что ты сможешь это осознать, но попробуй: я не хочу править вселенной.",shape=box,color=red];
		1941 -> 1947;
	1942 [label="Это сделало бы меня ничем не лучше Альбрехта. Или Орокин. Носясь и переделывая мир по своему образу. Меня это не интересует.",shape=box,color=red];
		1942 -> 1947;
	1943 [label="Я доволен тем, что делаю. Я помогаю людям так, как хочу.",shape=box,color=red];
		1943 -> 1948;
	1944 [label="Не уверен, что ты сможешь это осознать, но попробуй: я не хочу править вселенной.",shape=box,color=red];
		1944 -> 1949;
	1945 [label="Это сделало бы меня ничем не лучше Альбрехта. Или Орокин. Носясь и переделывая мир по своему образу. Меня это не интересует.",shape=box,color=red];
		1945 -> 1949;
	1946 [label="Но почему? Вот этого я не понимаю.",shape=box,color=blue];
		1946 -> 1950;
	1947 [label="Так ты предпочёл бы быть… чем? Маленьким?",shape=box,color=blue];
		1947 -> 1951;
		1947 -> 1952;
	1948 [label="Но почему? Вот этого я не понимаю.",shape=box,color=blue];
		1948 -> 1950;
	1949 [label="Так ты предпочёл бы быть… чем? Маленьким?",shape=box,color=blue];
