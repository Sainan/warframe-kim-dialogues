		j643812978 -> j1014821534;
	j2478457835 [label="Boolean RoatheUnloved1 is now true.",color=orange];
		j2478457835 -> j1436996290;
	j3344336237 [label="Будь терпелив. Сначала нам нужно разобраться с Безразличием.",shape=box,color=red];
		j3344336237 -> j3090423634;
	j3419067984 [label="Может быть, когда всё это наконец уляжется. Но сейчас, нет.",shape=box,color=red];
		j3419067984 -> j4276002736;
	j4091219239 [label="И ты правда думаешь, что я выбрал тебя для этого? Не смеши меня.",shape=box,color=red];
		j4091219239 -> j3781455550;
	j1719197954 [label="Ты не знаешь, что делаешь и зачем, ты просто делаешь то, что тебе говорят. Ещё один самовлюблённый приспешник самовлюблённого Орокин. Позор.",shape=box,color=blue];
		j1719197954 -> "Chat ends.";
	j3927681391 [label="Я просто говорю, что похоже, тебя реально бесит сама мысль о том, что люди могут перестать страдать. И, похоже, ты воспринимаешь это очень лично.",shape=box,color=red];
		j3927681391 -> j3988514334;
	j1014821534 [label="Суть, которую я пытался донести, была проста, если «Безразличие» питается отсутствием эмоций, то их наличие может стать ключом к его поражению.",shape=box,color=red];
		j1014821534 -> j2264176162;
	j3084236697 [label="Ты думаешь, что никто не способен полюбить тебя? Или что ты сам не способен почувствовать любовь к кому‑то? Или ты считаешь, что это просто ещё не случилось?",shape=box,color=red];
		j3084236697 -> j746193279;
	j1436996290 [label="Нет, не был. И если вы собираетесь настаивать, что мы спасём вселенную от этого «равнодушия», держась за руки и распевая песни, простите меня, пока я блюю в сосуде Фибоначчи.",shape=box,color=blue];
		j1436996290 -> j3084236697;
		j1436996290 -> j3927681391;
		j1436996290 -> j1014821534;
	j3090423634 [label="+5 Chemistry",color=orange];
		j3090423634 -> j4276002736;
	j4276002736 [label="Ладно. Ладно! Я подожду, как ты и сказал. Играй в эти... глупые игры.",shape=box,color=blue];
		j4276002736 -> j483957320;
	j3781455550 [label="Boolean RoatheInsulted is now true.",color=orange];
		j3781455550 -> j3858288229;
	j3988514334 [label="Потому что несчастье любит компанию? Возможно. Или потому, что я просто в замешательстве от того, что ты бегаешь туда‑сюда, впустую тратя время, когда у нас есть настоящая работа.",shape=box,color=blue];
		j3988514334 -> j3885963092;
	j2264176162 [label="Ещё одно доказательство того, что эта штука, вымысел вашего воображения! Какой настоящий бог или «анти-бог» вообще может быть побеждён «добротой человеческих эмоций»?! Ха! ",shape=box,color=blue];
		j2264176162 -> j2514344226;
	j746193279 [label="Boolean RoatheUnloved2 is now true.",color=orange];
		j746193279 -> j871064493;
	j483957320 [label="Полагаю, нам ещё есть над чем работать, как ты и говоришь. Я просто не могу представить, что в таких... детских вещах есть смысл. Но, с другой стороны, вот я сижу на этом конце света, а у тебя есть ключи от вселенной.",shape=box,color=blue];
		j483957320 -> j1872272355;
	j3858288229 [label="Справедливо. Почему бы тебе вообще выбирать кого‑то настолько отвратительного, как Дьявол Тау?",shape=box,color=blue];
		j3858288229 -> "Chat ends.";
	j3885963092 [label="Но теперь я убеждён, что ты не знаешь, что делаешь и зачем, ты просто делаешь то, что тебе говорят. Ещё один самовлюблённый приспешник самовлюблённого Орокин. Позор.",shape=box,color=blue];
		j3885963092 -> "Chat ends.";
	j2514344226 [label="+5 Chemistry",color=orange];
		j2514344226 -> j1882019568;
	j871064493 [label="Прекрати говорить о вещах, в которых ты совершенно ничего не понимаешь, Скиталец.",shape=box,color=blue];
		j871064493 -> j367054140;
	j1872272355 [label="А пока я просто вернусь к тому, чтобы раздражать эту парящую мясную муху. ",shape=box,color=blue];
		j1872272355 -> j607205169;
	j1882019568 [label="Чем больше ты рассказываешь мне о своих безумных теориях, тем больше убеждаешь меня в том, что я прав. Вы все создали соломенного человечка из собственного безумия, а эта штука просто питается вашими же неуверенностями.",shape=box,color=blue];
		j1882019568 -> j331503683;
	j367054140 [label="+20 Chemistry",color=orange];
		j367054140 -> "Chat ends.";
	j607205169 [label="+5 Chemistry",color=orange];
		j607205169 -> j4170500936;
	j331503683 [label="Если бы вы все просто закрыли глаза на достаточно долгое время и игнорировали это, я гарантирую, что это прошло бы само собой.",shape=box,color=blue];
		j331503683 -> j224997397;
