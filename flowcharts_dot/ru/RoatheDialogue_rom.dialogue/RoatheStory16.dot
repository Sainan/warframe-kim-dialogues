	"Chat ends." [color=orange];
	j3345797855 [label="ГС: ЖЕРТВА",shape=box,color=blue];
		j3345797855 -> j1499586093;
	j1499586093 [label="Стенограмма: Трейвон. Я видел, как ты швырнул свой Рэйлджек прямо в пасть Прагасы. Отвлечённая, жадно пожиравшая тебя и твоих людей, она так и не заметила, как мой собственный корабль уносился прочь.",shape=box,color=blue];
		j1499586093 -> j2058367987;
	j2058367987 [label="Ты отдал свою жизнь за своего вышестоящего офицера. Я воспринял твою самоотверженность, словно пощёчину.",shape=box,color=blue];
		j2058367987 -> j4159373758;
	j4159373758 [label="Марина. Ты отдала мне своё тело. Там, в той траншее, мы пили Куву. Мои руки дрожали, горло было рассечено и сочилось, но я проглотил достаточно капель, чтобы она сработала.",shape=box,color=blue];
		j4159373758 -> j1614391992;
	j1614391992 [label="Я помню твой последний жест прощания. Угасание. Потом я моргнул и открыл глаза, когда-то принадлежавшие тебе, и увидел мой собственный выпотрошенный труп, безжизненно лежащее в грязи.",shape=box,color=blue];
		j1614391992 -> j3824975073;
	j3824975073 [label="Ростиг. Что-то пошло не так в процессе клонирования, говорили они. Что ещё могло заставить Гринира оставаться у своей турели, горя живьём? Даже крыса понимает инстинкт самосохранения!",shape=box,color=blue];
		j3824975073 -> j1148683820;
	j1148683820 [label="Нет. Ваш «дефект» поставил вас выше них.",shape=box,color=blue];
		j1148683820 -> j921430358;
	j921430358 [label="Add 1 to HellStory counter",color=orange];
		j921430358 -> "Chat ends.";
}