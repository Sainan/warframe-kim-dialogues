	"Chat ends." [color=orange];
	j2522156056 [label="VM: SACRIFICE",shape=box,color=blue];
		j2522156056 -> j3142210953;
	j3142210953 [label="Стенограмма: Трейвон. Я видел, как ты швырнул свой Рэйлджек прямо в пасть Прагасы. Отвлечённая, жадно пожиравшая тебя и твоих людей, она так и не заметила, как мой собственный корабль уносился прочь.",shape=box,color=blue];
		j3142210953 -> j1675612349;
	j1675612349 [label="You laid down your life for your superior officer. I felt your selflessness like a slap in the face.",shape=box,color=blue];
		j1675612349 -> j3128607985;
	j3128607985 [label="Maryna. You gave me your body. Together, in that trench, we drank Kuva. My hands shook and my gashed throat leaked, but I kept enough drops down for it to take.",shape=box,color=blue];
		j3128607985 -> j2590487634;
	j2590487634 [label="I remember your last salute. The fading. Then I blinked open the eyes that had been yours, and saw my gutted corpse dead in the mud.",shape=box,color=blue];
		j2590487634 -> j3824975073;
	j3824975073 [label="Ростиг. Что-то пошло не так в процессе клонирования, говорили они. Что ещё могло заставить Гринира оставаться у своей турели, горя живьём? Даже крыса понимает инстинкт самосохранения!",shape=box,color=blue];
		j3824975073 -> j1148683820;
	j1148683820 [label="Нет. Ваш «дефект» поставил вас выше них.",shape=box,color=blue];
		j1148683820 -> j921430358;
	j921430358 [label="Add 1 to HellStory counter",color=orange];
		j921430358 -> "Chat ends.";
}