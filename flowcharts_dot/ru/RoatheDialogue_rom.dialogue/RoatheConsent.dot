	"Chat ends." [color=orange];
	j511900548 [label="Check boolean RoatheConsentComplete",color=orange];
		j511900548 -> "Chat ends." [label=true,color=green];
		j511900548 -> j2676156161 [label=false,color=brown];
		j511900548 -> j3176100251 [label=false,color=brown];
	j4082858284 [label="Check boolean RoathePolyamorySuccess",color=orange];
		j4082858284 -> j511900548 [label=true,color=green];
		j4082858284 -> "Chat ends." [label=false,color=brown];
	j2676156161 [label="Эй, Роут? У тебя есть минутка? [Спросить согласие нескольких партнёров.]",shape=box,color=red];
		j2676156161 -> j3281554028;
	j3176100251 [label="[Конец.]",shape=box,color=red];
		j3176100251 -> j604242687;
	j3281554028 [label="Хм? В чем дело, сокровище?",shape=box,color=blue];
		j3281554028 -> j637800093;
	j604242687 [label="Boolean RoatheConsentComplete is now true.",color=orange];
		j604242687 -> "Chat ends.";
	j637800093 [label="Я хочу поговорить с тобой кое о чём и сначала убедиться, что ты в порядке.",shape=box,color=red];
		j637800093 -> j2184396201;
	j2184396201 [label="Я не хочу, чтобы у тебя была мысль, что я лгу или как-то нечестно обращаюсь.",shape=box,color=red];
		j2184396201 -> j1189340044;
	j1189340044 [label="Продолжай. Звучит так, будто это будет весьма недурно.",shape=box,color=blue];
		j1189340044 -> j1042660240;
	j1042660240 [label="Я не хочу ставить тебя в ситуацию, в которой ты будешь чувствовать себя плохо. Так что если ты скажешь нет, это нормально. Мне важно, чтобы это было ясно.",shape=box,color=red];
		j1042660240 -> j2474669584;
	j2474669584 [label="То, что есть между нами, важно для меня. Очень важно. И оно настоящее. Я не хочу, чтобы были какие-то сомнения.",shape=box,color=red];
		j2474669584 -> j1357926072;
	j1357926072 [label="Погоди. Во имя Бездны, ты что, пытаешься уклониться от новости о том, что у тебя появился ещё один партнёр?",shape=box,color=blue];
		j1357926072 -> j663387248;
	j663387248 [label="За какого же дурака ты меня принимаешь? Я и так знаю, дорогой Скиталец!",shape=box,color=blue];
		j663387248 -> j2675424240;
		j663387248 -> j1735982000;
	j2675424240 [label="Я так понимаю, ты не возражаешь?",shape=box,color=red];
		j2675424240 -> j136988917;
	j1735982000 [label="Ты... знаешь?",shape=box,color=red];
		j1735982000 -> j3738909827;
	j136988917 [label="Если бы ты только мог слышать, как я сейчас смеюсь в Санктуме. Скиталец, дорогуша. Сокровище Скиталец. Я — Орокин. Разумеется, меня это не волнует.",shape=box,color=blue];
		j136988917 -> j429916300;
	j3738909827 [label="Если бы ты только мог слышать, как я сейчас смеюсь в Санктуме. Скиталец, дорогуша. Сокровище Скиталец.",shape=box,color=blue];
		j3738909827 -> j604707613;
	j429916300 [label="Думай что хочешь о моём обществе и о нашей склонности наслаждаться компанией других так, как тебе может казаться пренебрежительным и унизительным, но мы также понимали, что значит любить.",shape=box,color=blue];
		j429916300 -> j3168134362;
	j604707613 [label="Я понял это в тот же миг, как всё произошло. У меня есть свои методы. И нет, меня это ни капли не волнует.Я — Орокин.",shape=box,color=blue];
		j604707613 -> j429916300;
	j3168134362 [label="Никто не постигал любовь так, как Орокин. И мы знали, что в сердце может быть место больше чем для одного. ",shape=box,color=blue];
		j3168134362 -> j1977538175;
	j1977538175 [label="Я всего лишь огорчён тем, что фанатики, скорее всего, слишком ограничены, чтобы присоединиться к веселью.",shape=box,color=blue];
		j1977538175 -> j911056765;
	j911056765 [label="Пф. Хотя, если подумать, так даже лучше. Можешь представить, к какому абсурду это бы привело?",shape=box,color=blue];
		j911056765 -> j4222894575;
	j4222894575 [label="Boolean RoatheConsentComplete is now true.",color=orange];
		j4222894575 -> j1320370521;
	j1320370521 [label="Что ж, как бы там ни было. Если они делают тебя счастливым, наслаждайся ими. Но знай, что когда ты со мной?",shape=box,color=blue];
		j1320370521 -> j590819048;
	j590819048 [label="+5 Chemistry",color=orange];
		j590819048 -> j1782236693;
	j1782236693 [label="Ты принадлежишь мне и только мне.",shape=box,color=blue];
		j1782236693 -> "Chat ends.";
}