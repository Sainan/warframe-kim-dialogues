digraph {
	graph [fontname="Roboto Condensed"];
	node [fontname="Roboto Condensed"];
	edge [fontname="Roboto Condensed"];

	"RoatheRank2Convo4 begins." [color=orange];
		"RoatheRank2Convo4 begins." -> j1115193858;
	j1115193858 [label="Check boolean RoatheRank2Convo1Complete",color=orange];
		j1115193858 -> j1437250236 [label=true,color=green];
		j1115193858 -> "Chat ends." [label=false,color=brown];
	j1437250236 [label="Check boolean RoatheKnowsReset2",color=orange];
		j1437250236 -> j488639618 [label=true,color=green];
		j1437250236 -> j1692949551 [label=false,color=brown];
	"Chat ends." [color=orange];
	j488639618 [label="Хм. Расскажи. Удалось ли мне убедить тебя в прошлый раз, что твоё «Безразличие» это всего лишь сборище детских игрушек, или ты всё ещё держишься за идею, что это некое «ужасное непознаваемое существо из Бездны».",shape=box,color=blue];
		j488639618 -> j3278488862;
	j1692949551 [label="Check boolean RoatheMITW1",color=orange];
		j1692949551 -> j2535007514 [label=true,color=green];
		j1692949551 -> j2268505769 [label=false,color=brown];
	j3278488862 [label="Если я что-то и презираю в этом мире, так это бег по кругу за собственным хвостом. И это выражение раньше было куда более фигуральным, чем сейчас, как я только выяснилось.",shape=box,color=blue];
		j3278488862 -> j3969923531;
		j3278488862 -> j1399104455;
		j3278488862 -> j1387373832;
	j2535007514 [label="Итак, прежде чем мы продолжим, хочу уточнить, правильно ли я это понимаю. Вы считаете, что Безразличие это некое Ужасное Непознаваемое Существо из Бездны, просачивающееся в нашу реальность из-за ошибок Альбрехта?",shape=box,color=blue];
		j2535007514 -> j1417411145;
	j2268505769 [label="Все, с кем я разговариваю в этом сумасшедшем доме, совершенно убеждены, что этот «Человек в стене» — некий буквальный и смехотворный бог. Настоящий бог. Даже эти двое фанатиков, кажется, поддерживают эту мысль!",shape=box,color=blue];
		j2268505769 -> j1851393183;
		j2268505769 -> j1852381881;
		j2268505769 -> j2205079405;
	j3969923531 [label="Нет. Увы, нет. Извини. ",shape=box,color=red];
		j3969923531 -> j4202122101;
	j1399104455 [label="На самом деле, да.",shape=box,color=red];
		j1399104455 -> j1398707857;
	j1387373832 [label="Мы так и не определились ни на одной из сторон.",shape=box,color=red];
		j1387373832 -> j2892212828;
	j1417411145 [label="Позвольте мне сформулировать свой вопрос таким образом, прежде чем мы снова начнём бег по кругу за собственным хвостом. Это… метафора, которая, как я понимаю, раньше была гораздо более распространённой, чем сейчас, но не будем об этом.",shape=box,color=blue];
		j1417411145 -> j277968707;
	j1851393183 [label="Ты не думаешь, что он настоящий?",shape=box,color=red];
		j1851393183 -> j2754836522;
	j1852381881 [label="И если ты не считаешь его богом, кем же ты его считаешь?",shape=box,color=red];
		j1852381881 -> j4274783342;
	j2205079405 [label="А ты нет?",shape=box,color=red];
		j2205079405 -> j1554235207;
	j4202122101 [label="Boolean RoatheMITWSkip is now true.",color=orange];
		j4202122101 -> j16565051;
	j1398707857 [label="Boolean RoatheMITWSkip is now true.",color=orange];
		j1398707857 -> j1059385031;
	j2892212828 [label="Ага! Значит, мне ещё есть над чем работать.",shape=box,color=blue];
		j2892212828 -> j3490167384;
	j277968707 [label="Верите ли, что сущность, называемая Безразличием, существовала до того, как Альбрехт с ней столкнулся? Или веришь, что она возникла, впервые взаимодействуя с Бездной?",shape=box,color=blue];
		j277968707 -> j2056265138;
		j277968707 -> j1157798476;
		j277968707 -> j3436791805;
		j277968707 -> j4190903947;
	j2754836522 [label="Итак, были ли эти слова действительно моими? Не торопись вкладывать фразы в мои уста, Кратковременный Узурпатор. Отрицания «реальности» Безразличия с моей стороны не было. Отклонено было лишь притязание на божественность.",shape=box,color=blue];
		j2754836522 -> j2520480548;
		j2754836522 -> j321092039;
	j4274783342 [label="Я могу разоблачить это ложное божество для тебя двумя простыми словами, которые вам следует знать и понимать вполне отчётливо.",shape=box,color=blue];
		j4274783342 -> j1258446267;
	j1554235207 [label="Абсолютно нет! Во-первых, никакого бога или богов не существует, эта идея абсурдна. Во-вторых, полагать, что Альбрехт выпустил бога Бездны? Ещё более смешно!",shape=box,color=blue];
		j1554235207 -> j3271688167;
	j16565051 [label="Boolean RoatheMITW5Real is now true.",color=orange];
		j16565051 -> j3880504672;
	j1059385031 [label="Boolean RoatheMITW5Fake is now true.",color=orange];
		j1059385031 -> j520197897;
	j3490167384 [label="Boolean RoatheMITW1 is now true.",color=orange];
		j3490167384 -> j3708734015;
	j2056265138 [label="Я не знаю. И не думаю, что ты можешь.",shape=box,color=red];
		j2056265138 -> j823323261;
	j1157798476 [label="Думаю, это была сущность, существовавшая ещё до того, как Энтрати с ней взаимодействовал. Он просто придал ей форму посредством Концептуального Воплощения.",shape=box,color=red];
		j1157798476 -> j4118350767;
	j3436791805 [label="Честно… я не знаю.",shape=box,color=red];
		j3436791805 -> j1551360874;
	j4190903947 [label="Ты и правда считаешь, что Энтрати создал злобного бога Бездны из ниоткуда?",shape=box,color=red];
		j4190903947 -> j3049799926;
	j2520480548 [label="Эта штука сильнее всего, с чем мне когда-либо приходилось сталкиваться.",shape=box,color=red];
		j2520480548 -> j1376931025;
	j321092039 [label="И что же это по-твоему тогда?",shape=box,color=red];
		j321092039 -> j4274783342;
	j1258446267 [label="Концептуальное воплощение.",shape=box,color=blue];
		j1258446267 -> j1562693468;
		j1258446267 -> j2558611256;
		j1258446267 -> j2684090371;
	j3271688167 [label="В Бездне нет ничего. Именно поэтому она и называется Бездной!",shape=box,color=blue];
		j3271688167 -> j4136858846;
		j3271688167 -> j308747392;
	j3880504672 [label="+10 Chemistry",color=orange];
		j3880504672 -> j1340856818;
	j520197897 [label="+20 Chemistry",color=orange];
		j520197897 -> j156617870;
	j3708734015 [label="Но прежде чем мы продолжим, хочу уточнить, верно ли я это понимаю. Вы считаете, что Безразличие это некая Ужасное Непознаваемое Существо из Бездны, просачивающаяся в нашу реальность из-за ошибок Альбрехта?",shape=box,color=blue];
		j3708734015 -> j1417411145;
	j823323261 [label="Да! Могу! Происходящее настолько очевидно, и до нелепости смешно, что ты уже начинаешь верить, будто в окно скребётся какой-то огромный зверь, хотя это всего лишь ветка дерева на ветру.",shape=box,color=blue];
		j823323261 -> j1966205869;
	j4118350767 [label="Только не ты. У меня были такие большие надежды. Происходящее настолько очевидно, и до нелепости смешно, что ты уже начинаешь верить, будто в окно скребётся какой-то огромный зверь, хотя это всего лишь ветка дерева на ветру.",shape=box,color=blue];
		j4118350767 -> j1966205869;
	j1551360874 [label="Происходящее настолько очевидно, и до нелепости смешно, что ты уже начинаешь верить, будто в окно скребётся какой-то огромный зверь, хотя это всего лишь ветка дерева на ветру.",shape=box,color=blue];
		j1551360874 -> j1966205869;
	j3049799926 [label="Да! Конечно! Происходящее настолько очевидно, и до нелепости смешно, что ты уже начинаешь верить, будто в окно скребётся какой-то огромный зверь, хотя это всего лишь ветка дерева на ветру.",shape=box,color=blue];
		j3049799926 -> j1966205869;
	j1376931025 [label="И когда я это оспаривал? Похоже, вы все умудрились втянуть себя в весьма истеричную и совершенно ненужную передрягу.",shape=box,color=blue];
		j1376931025 -> j2149871771;
		j1376931025 -> j1076868529;
	j1562693468 [label="Бездна и наше взаимодействие с ней опасно и могущественно — поверь мне, я знаю. Но у неё есть пределы. Ты действительно думаешь, что она способна породить нечто подобное? Создать целые языки, пальцы, способные приводить в движение корабли, прыгающие сквозь Бездну?",shape=box,color=red];
		j1562693468 -> j394099410;
	j2558611256 [label="В это... очень хочется поверить, что это только монстр под нашей кроватью, Роут. Но после встречи с этим лицом к лицу, я не знаю, как что-то подобное может быть создано нашим сознанием.",shape=box,color=red];
		j2558611256 -> j1480983316;
	j2684090371 [label="Концептуальное Воплощение не может сделать то, на что способен Человек в Стене. Хотя Энтрати, возможно, обнаружил эту вещь — и несёт ответственность за её перенесение сюда — но я не верю, что он первоисточник.",shape=box,color=red];
		j2684090371 -> j196098941;
	j4136858846 [label="Я…",shape=box,color=red];
		j4136858846 -> j930435103;
	j308747392 [label="Нет. Мне знакомо то, что порождает Бездна… Ангелы. Пение. Призраки.",shape=box,color=red];
		j308747392 -> j930435103;
	j1340856818 [label="Хотя твоя непреклонность вызывает разочарование, твоя откровенность по-своему чрезвычайно освежает. И приятно осознавать, что время на тебя больше не расходуется. Другие варианты для развлечений найдутся сами.",shape=box,color=blue];
		j1340856818 -> j3430866203;
	j156617870 [label="Замечательно. Я рад, что моё прежнее «я» оказалось таким убедительным. И я надеюсь, что ты не лжёшь мне, пытаясь «заставить меня замолчать». Но у меня нет выбора, кроме как поверить тебе.",shape=box,color=blue];
		j156617870 -> j3600302681;
	j1966205869 [label="Только теперь, под влиянием Бездны, вы все вселили в неё столько страха и силы, что, как по замкнутому кругу, это кристаллизовалось в эту... Вещь. Этот Человек в стене.",shape=box,color=blue];
		j1966205869 -> j681907240;
	j2149871771 [label="Ты к чему это ведёшь?",shape=box,color=red];
		j2149871771 -> j146515136;
	j1076868529 [label="Постой. С какой стати мы виноваты в этом? Виноват Альбрехт, он выпустил это на волю.",shape=box,color=red];
		j1076868529 -> j4252550224;
	j394099410 [label="Человечество, безусловно, ничто иное, как неистощимый источник изобретательности в создании новых форм страданий, не так ли? Тебе, несомненно, выпадала возможность стать свидетелем жестокостей, о которых невозможно было даже помыслить во времена наших благочестивых фанатиков.",shape=box,color=blue];
		j394099410 -> j1528104862;
	j1480983316 [label="Ах, ты так близко к истине и в то же время так поспешно отвергаешь её. Тебе кажется соблазнительной мысль, что это порождение твоего разума, ведь так было бы легче отмахнуться, будь это так? Нет, я думаю, куда опаснее столкнуться с творением собственных рук, нежели с богом.",shape=box,color=blue];
		j1480983316 -> j1182408328;
	j196098941 [label="Хотя я ценю твоё смирение, осмелюсь утверждать, что ты недооцениваешь безграничные возможности человеческого творчества — особенно в том, как оно способно изобретать новые формы страдания. Разве ткань этого мира, где ты живёшь, соткана не тобой?",shape=box,color=blue];
		j196098941 -> j2682462414;
	j930435103 [label="Единственное, что приходит из Бездны, — это то, что мы сами туда помещаем… и то, что возвращается обратно. Она изменяет материю и энергию, но не способна их сотворить.",shape=box,color=blue];
		j930435103 -> j847274724;
	j3430866203 [label="Я, со своей стороны, считаю удачей то, что удалось избежать второго раунда блужданий и круговых дебатов о тонкостях Концептуального Воплощения.",shape=box,color=blue];
		j3430866203 -> j554065493;
	j3600302681 [label="В любом случае, я уверен, что мы найдём другие способы развлечься, помимо того, чтобы блуждать в бессвязных и затянутых дебатах о тонкостях концептуального воплощения.",shape=box,color=blue];
		j3600302681 -> j3117075867;
	j681907240 [label="Альбрехт, возможно, и затеял эту чушь, но вы все несёте ответственность за то, что разжигали огонь, пока он не превратился в ад. Безразличия никогда не существовало. Пока оно внезапно не появилось. ",shape=box,color=blue];
		j681907240 -> j3695231297;
	j146515136 [label="Вот что я хочу сказать: возможно, именно Альбрехт первым увидел собственную гордыню, отражённую в лице ухмыляющегося бога разрушения, да.",shape=box,color=blue];
		j146515136 -> j3109781194;
	j4252550224 [label="Возможно, именно Альбрехт первым увидел собственную гордыню, отражённую в лице ухмыляющегося бога разрушения.\n",shape=box,color=blue];
		j4252550224 -> j3109781194;
	j1528104862 [label="+5 Chemistry",color=orange];
		j1528104862 -> j2558109739;
	j1182408328 [label="Внешнего врага можно понять. Им можно манипулировать. Его можно победить. А возможно, даже договориться, если дойдёт до этого. У него есть слабости, которые можно использовать. Но враг внутренний? Созданный нами самими? Он гораздо коварнее.",shape=box,color=blue];
		j1182408328 -> j4216842070;
	j2682462414 [label="Тебе тоже приходилось стать свидетелем множества жестокостей, о которых, никто и не мог помыслить во времена наших ревностных фанатиков. ",shape=box,color=blue];
		j2682462414 -> j1528104862;
	j847274724 [label="Подумай, Скиталец. Эти так называемые «Ангелы Бездны», о которых ты говоришь. Эти призраки. Созданы ли они из тех, кто уже затерялся в Бездне?",shape=box,color=blue];
		j847274724 -> j1933597297;
	j554065493 [label="Хотя это и означает больше времени для проповедей фанатиков... фу. Выбор, выбор, выбор...",shape=box,color=blue];
		j554065493 -> "Chat ends.";
	j3117075867 [label="Лично я благодарен за то, что меня избавили от второго раунда.",shape=box,color=blue];
		j3117075867 -> j554065493;
	j3695231297 [label="И во всём этом виноват именно ты.",shape=box,color=blue];
		j3695231297 -> j4042962652;
		j3695231297 -> j478301279;
		j3695231297 -> j3747672496;
	j3109781194 [label="Но вы все в равной степени виноваты в том, что так долго катите этот грязный ком вниз по склону, позволяя ему увеличиваться с каждым собранным по пути куском нечистот!",shape=box,color=blue];
		j3109781194 -> j233018718;
	j2558109739 [label="Как вид, мы поистине удивительны в нашей способности подпитывать свои страхи новыми способами саморазрушения.",shape=box,color=blue];
		j2558109739 -> j2345067426;
	j4216842070 [label="+5 Chemistry",color=orange];
		j4216842070 -> j2238285392;
	j1933597297 [label="Это были лишь отголоски энергии, извергаемые подобно тому, как это делает пёстрый кутак, чтобы накормить своё потомство.",shape=box,color=blue];
		j1933597297 -> j233018718;
	j4042962652 [label="Мы не можем создавать такие вещи, Роут, это уже обсуждалось. Концептуальное воплощение имеет свои пределы.",shape=box,color=red];
		j4042962652 -> j200251152;
	j478301279 [label="Не вините нас. Мы не виноваты в том, что натворило это существо.",shape=box,color=red];
		j478301279 -> j3812019545;
	j3747672496 [label="Объясни мне, как это вообще должно работать. Большинство вещей, созданных посредством Концептуального Воплощения из Бездны, не могут покинуть её - по крайней мере, надолго.",shape=box,color=red];
		j3747672496 -> j4268024634;
	j233018718 [label="Позволь мне сделать обсуждение проще. Я могу разоблачить это ложное божество для тебя двумя простыми словами, которые вам следует знать и понимать вполне отчётливо.",shape=box,color=blue];
		j233018718 -> j1258446267;
	j2345067426 [label="Boolean RoatheMITW1 is now true.",color=orange];
		j2345067426 -> j1417411145;
	j2238285392 [label="Потому что тогда придётся сражаться со своими собственными демонами. А человечество… такие войны никогда не выигрывает, правда?",shape=box,color=blue];
		j2238285392 -> j2345067426;
	j200251152 [label="Сказал тот, кто в одиночку создал целое альтернативное измерение? Прошу тебя, Скиталец... используй своё воображение, как это случалось в давние времена.",shape=box,color=blue];
		j200251152 -> j4268024634;
	j3812019545 [label="Я вовсе не упрекаю тебя! Эта штука уже была в разработке задолго до твоего появления. Альбрехт об этом позаботился.",shape=box,color=blue];
		j3812019545 -> j2506355173;
	j4268024634 [label="Концептуальное Воплощение работает следующим образом - при взаимодействии с Бездной, или в непосредственной близости от неё, сильные эмоции и мысли могут проявляться физически. Мы оба это знаем.",shape=box,color=blue];
		j4268024634 -> j4201465175;
		j4268024634 -> j2246353350;
		j4268024634 -> j532869660;
	j2506355173 [label="Он увидел своё отражение и познал истинный страх. Так вспыхнула первая искра, ставшая огнём, что теперь грозит всё уничтожить. Ты же просто подливаешь в него масла.",shape=box,color=blue];
		j2506355173 -> j4268024634;
	j4201465175 [label="Верно. Как и Дувири, он связан с этим миром через Зариман. ",shape=box,color=red];
		j4201465175 -> j2284148776;
	j2246353350 [label="Как и Зариман, и Неукротимые, и Ангелы Бездны. Пустота повсюду на этом корабле.",shape=box,color=red];
		j2246353350 -> j2284148776;
	j532869660 [label="Да. И что?",shape=box,color=red];
		j532869660 -> j1581208462;
	j2284148776 [label="Именно. Там, где уходит Бездна, туда может последовать Концептуальное Воплощение. И только там.",shape=box,color=blue];
		j2284148776 -> j4288036879;
		j2284148776 -> j1203085525;
	j1581208462 [label="Там, где уходит Бездна, туда может последовать Концептуальное Воплощение. И только там.",shape=box,color=blue];
		j1581208462 -> j4288036879;
		j1581208462 -> j1203085525;
	j4288036879 [label="Но это было до 1999. Это преследовало Альбрехта повсюду. И меня тоже.",shape=box,color=red];
		j4288036879 -> j865463919;
	j1203085525 [label="Погоди...",shape=box,color=red];
		j1203085525 -> j3732592799;
	j865463919 [label="Проклятые пальцы. Мы взяли эти проклятые пальцы в отчаянной и безумной попытке добраться до Тау, и мы, Орокин, нашли способ их воссоздать, не так ли?",shape=box,color=blue];
		j865463919 -> j2227022391;
	j3732592799 [label="Да. Теперь ты понимаешь. Проклятые пальцы. Мы взяли эти проклятые пальцы в отчаянной и безумной попытке добраться до Тау, и мы, Орокин, нашли способ их воссоздать, не так ли?",shape=box,color=blue];
		j3732592799 -> j2227022391;
	j2227022391 [label="Частички Бездны повсюду, куда ни пойди... Сеть ходов и туннелей, позволяющая этой штуке появляться, где ей вздумается. А что ещё хуже?",shape=box,color=blue];
		j2227022391 -> j4156419237;
	j4156419237 [label="Тэнно. И ты. Все вы, затронутые Бездной. И всех вас преследует эта тварь, потому что, куда бы вы ни пошли, она может последовать за вами.",shape=box,color=blue];
		j4156419237 -> j931591981;
	j931591981 [label="И, скорее всего, любого, кто хоть немного взаимодействовал с ней. Самого Энтрати. Его дворецкого. Кавию. Меня, фанатиков, из-за того, что они рядом к этому Святилищу. Список бесконечен.",shape=box,color=blue];
		j931591981 -> j2237195644;
		j931591981 -> j2561822083;
	j2237195644 [label="То есть ты предполагаешь, что любой с достаточным воздействием Бездны, или любой, кто является «батареей», становится ещё одним окном, через которое может наблюдать Человек в Стене?",shape=box,color=red];
		j2237195644 -> j1982290663;
	j2561822083 [label="Но как, интересно, как оно проникло в Русалку?",shape=box,color=red];
		j2561822083 -> j2853904887;
	j1982290663 [label="Точно так. ",shape=box,color=blue];
		j1982290663 -> j1411059736;
	j2853904887 [label="Кто?",shape=box,color=blue];
		j2853904887 -> j4038804247;
		j2853904887 -> j289165726;
	j1411059736 [label="Это и объясняет, отсутствие собственного облика. Существо способно являться в образах тех, кого терзает, и лишь тем, кто становится целью этих мучений.",shape=box,color=blue];
		j1411059736 -> j2445941545;
	j4038804247 [label="Майор Нэси Русалка. В 1999 она командовала вооружёнными силами известными как «Скальдра» в 1999 в Хёльвании.",shape=box,color=red];
		j4038804247 -> j838971185;
	j289165726 [label="Короче говоря, мне ни при каких обстоятельствах не следует позволять вам двоим встречаться.",shape=box,color=red];
		j289165726 -> j4024962878;
	j2445941545 [label="На самом деле, архитектурный облик возникает лишь в те моменты, когда предпринимается отчаянная попытка предстать чем-то Большим и Иным. Когда совершается отчаянная попытка вызвать ощущение Грандиозности и Божественности.",shape=box,color=blue];
		j2445941545 -> j729053389;
		j2445941545 -> j2333274519;
	j838971185 [label="Она была – или остаётся – одержима Безразличием. Оно завладевает её разумом, манипулирует им, как марионеткой. Или же она сама впустила его. Мы не знаем. Мы также не знаем, вернула ли она себе контроль.",shape=box,color=red];
		j838971185 -> j2329697254;
	j4024962878 [label="Это вовсе не смешно, Узурпатор. Но как она связана с нашим... Безразличием, если говорить точнее?",shape=box,color=blue];
		j4024962878 -> j838971185;
	j729053389 [label="Значит, ты полагаешь, что принимается облик каждого, с кем происходит контакт... поскольку собственного лица не существует?",shape=box,color=red];
		j729053389 -> j385185086;
	j2333274519 [label="Я считаю, что Человек в Стене предпочитает носить наши лица, поскольку не может постичь, каково это быть человеком. Любая иная форма становится слишком «большой».",shape=box,color=red];
		j2333274519 -> j1163263918;
	j2329697254 [label="Она кажется восхитительно замечательным человеком. Настоящее удовольствие. Но давайте двигаться дальше. Ты хочешь сказать, что Безразличие управляет ею? И всё это началось во время твоего маленького путешествия в прошлое?",shape=box,color=blue];
		j2329697254 -> j3221235932;
	j385185086 [label="Нет, глупость. Здесь есть лишь подражание своему истоку. Это не цельная сущность - это всего лишь игрушка, слепленная из обломков чужого ужаса, страха и боли, которые были вложены. ",shape=box,color=blue];
		j385185086 -> j1101687422;
	j1163263918 [label="Нет, глупость. Здесь лишь отражение того, что послужило изначальным источником. Это не цельная сущность - это всего лишь игрушка, слепленная из обломков чужого ужаса, страха и боли, которые были вложены.",shape=box,color=blue];
		j1163263918 -> j1101687422;
	j3221235932 [label="Что ж, если то, что мы знаем о Бездне, верно, значит, случилось одно из двух: либо она по собственной глупости в 1999 оказалась в каком-то проявлении Бездны (что я считаю крайне маловероятным, но не невозможным), либо...",shape=box,color=blue];
		j3221235932 -> j661469447;
	j1101687422 [label="Эх. Вижу, сегодня я не добьюсь никакого прогресса. Ничего страшного, ты глубоко увяз в этой пропаганде, которой тебя пичкают. Боюсь, Альбрехт весьма убедительный лидер культа.",shape=box,color=blue];
		j1101687422 -> j3547555350;
	j661469447 [label="Наш дорогой Альбрехт снова лез не в своё дело.",shape=box,color=blue];
		j661469447 -> j2023644937;
		j661469447 -> j1041467330;
		j661469447 -> j2472362356;
	j3547555350 [label="+10 Chemistry",color=orange];
		j3547555350 -> j2951117258;
	j2023644937 [label="Ты намекаешь на то, что Альбрехт специально сделал Нэси марионеткой Безразличия?",shape=box,color=red];
		j2023644937 -> j800750758;
	j1041467330 [label="Мы не знаем, правда ли всё это. Это всего лишь домыслы. Всё это могло быть чистой ложью.",shape=box,color=red];
		j1041467330 -> j2341173407;
	j2472362356 [label="Если в 1999 году сознательно был пробит проход в Бездну и позволил ей проникнуть... это объяснило бы, почему варфреймы действовали там с самого начала... то же самое для твоего времени - без сердца Деймоса, конечно.",shape=box,color=red];
		j2472362356 -> j844000565;
	j2951117258 [label="Boolean RoatheMITW2 is now true.",color=orange];
		j2951117258 -> j2867183580;
	j800750758 [label="Я просто сижу здесь и гадаю на кофейной гуще не хуже остальных, Узурпатор. Какое уж мне дело намекать, будто Альбрехт намеренно проделал дыру в Бездне в Хёльвании и впустил Безразличие, чтобы дать ему собственное воплощение...",shape=box,color=blue];
		j800750758 -> j2976073259;
	j2341173407 [label="Естественно! Я просто сижу здесь и гадаю на кофейной гуще не хуже остальных, Узурпатор. Какое уж мне дело намекать, будто Альбрехт намеренно проделал дыру в Бездне в Хёльвании и впустил Безразличие, чтобы дать ему собственное воплощение...",shape=box,color=blue];
		j2341173407 -> j2976073259;
	j844000565 [label="Видишь? Никогда не доверяй учёным. Ради эксперимента они готовы на что угодно. Но в конце концов я тоже просто гадаю по осадку, Узурпатор. Всё это просто гипотезы.",shape=box,color=blue];
		j844000565 -> j3895305090;
	j2867183580 [label="Надеюсь, это хотя бы дало вам пищу для размышлений. А сейчас мне нужно идти.",shape=box,color=blue];
		j2867183580 -> "Chat ends.";
	j2976073259 [label="Мне просто кажется, как тактику и человеку, привыкшему к разработке стратегии войны...",shape=box,color=blue];
		j2976073259 -> j4129218463;
	j3895305090 [label="Я далек от мысли, что Альбрехт намеренно проделал дыру в Бездне в Хёльвании и впустил Безразличие, ради собственного аватара! Мне просто кажется, как тактику и человеку, привыкшему к разработке военных стратегий...",shape=box,color=blue];
		j3895305090 -> j4129218463;
	j4129218463 [label="Что первым шагом к победе над безликим противником, способным находиться где угодно, кем угодно и когда угодно? Является сведение возможных вариантов к минимуму...",shape=box,color=blue];
		j4129218463 -> j651279737;
	j651279737 [label="+20 Chemistry",color=orange];
		j651279737 -> j1587816389;
	j1587816389 [label="И убедиться, чтобы эти варианты были реализованы.",shape=box,color=blue];
		j1587816389 -> j3718859798;
	j3718859798 [label="Boolean RoatheMITW2Neci is now true.",color=orange];
		j3718859798 -> j2608812960;
	j2608812960 [label="Прекрасная пища для размышлений. Но! А пока мне пора.",shape=box,color=blue];
		j2608812960 -> "Chat ends.";
}