digraph {
	1095 [label="RoatheRank2Convo4 begins.",color=orange];
		1095 -> 1096;
	1096 [label="Check boolean RoatheRank2Convo1Complete",color=orange];
		1096 -> 1097 [label=true,color=green];
		1096 -> 1098 [label=false,color=brown];
	1097 [label="Check boolean RoatheKnowsReset2",color=orange];
		1097 -> 1099 [label=true,color=green];
		1097 -> 1100 [label=false,color=brown];
	1098 [label="Chat ends.",color=orange];
	1099 [label="Хм. Расскажи. Удалось ли мне убедить тебя в прошлый раз, что твоё «Безразличие» это всего лишь сборище детских игрушек, или ты всё ещё держишься за идею, что это некое «ужасное непознаваемое существо из Бездны».",shape=box,color=blue];
		1099 -> 1101;
	1100 [label="Check boolean RoatheMITW1",color=orange];
		1100 -> 1102 [label=true,color=green];
		1100 -> 1103 [label=false,color=brown];
	1101 [label="Если я что-то и презираю в этом мире, так это бег по кругу за собственным хвостом. И это выражение раньше было куда более фигуральным, чем сейчас, как я только выяснилось.",shape=box,color=blue];
		1101 -> 1104;
		1101 -> 1105;
		1101 -> 1106;
	1102 [label="Итак, прежде чем мы продолжим, хочу уточнить, правильно ли я это понимаю. Вы считаете, что Безразличие это некое Ужасное Непознаваемое Существо из Бездны, просачивающееся в нашу реальность из-за ошибок Альбрехта?",shape=box,color=blue];
		1102 -> 1107;
	1103 [label="Все, с кем я разговариваю в этом сумасшедшем доме, совершенно убеждены, что этот «Человек в стене» — некий буквальный и смехотворный бог. Настоящий бог. Даже эти двое фанатиков, кажется, поддерживают эту мысль!",shape=box,color=blue];
		1103 -> 1108;
		1103 -> 1109;
		1103 -> 1110;
	1104 [label="Нет. Увы, нет. Извини. ",shape=box,color=red];
		1104 -> 1111;
	1105 [label="На самом деле, да.",shape=box,color=red];
		1105 -> 1112;
	1106 [label="Мы так и не определились ни на одной из сторон.",shape=box,color=red];
		1106 -> 1113;
	1107 [label="Позвольте мне сформулировать свой вопрос таким образом, прежде чем мы снова начнём бег по кругу за собственным хвостом. Это… метафора, которая, как я понимаю, раньше была гораздо более распространённой, чем сейчас, но не будем об этом.",shape=box,color=blue];
		1107 -> 1114;
	1108 [label="Ты не думаешь, что он настоящий?",shape=box,color=red];
		1108 -> 1115;
	1109 [label="И если ты не считаешь его богом, кем же ты его считаешь?",shape=box,color=red];
		1109 -> 1116;
	1110 [label="А ты нет?",shape=box,color=red];
		1110 -> 1117;
	1111 [label="Update boolean RoatheMITWSkip",color=orange];
		1111 -> 1118;
	1112 [label="Update boolean RoatheMITWSkip",color=orange];
		1112 -> 1119;
	1113 [label="Ага! Значит, мне ещё есть над чем работать.",shape=box,color=blue];
		1113 -> 1120;
	1114 [label="Верите ли, что сущность, называемая Безразличием, существовала до того, как Альбрехт с ней столкнулся? Или веришь, что она возникла, впервые взаимодействуя с Бездной?",shape=box,color=blue];
		1114 -> 1121;
		1114 -> 1122;
		1114 -> 1123;
		1114 -> 1124;
	1115 [label="Итак, были ли эти слова действительно моими? Не торопись вкладывать фразы в мои уста, Кратковременный Узурпатор. Отрицания «реальности» Безразличия с моей стороны не было. Отклонено было лишь притязание на божественность.",shape=box,color=blue];
		1115 -> 1125;
		1115 -> 1126;
	1116 [label="Я могу разоблачить это ложное божество для тебя двумя простыми словами, которые вам следует знать и понимать вполне отчётливо.",shape=box,color=blue];
		1116 -> 1127;
	1117 [label="Абсолютно нет! Во-первых, никакого бога или богов не существует, эта идея абсурдна. Во-вторых, полагать, что Альбрехт выпустил бога Бездны? Ещё более смешно!",shape=box,color=blue];
		1117 -> 1128;
	1118 [label="Update boolean RoatheMITW5Real",color=orange];
		1118 -> 1129;
	1119 [label="Update boolean RoatheMITW5Fake",color=orange];
		1119 -> 1130;
	1120 [label="Update boolean RoatheMITW1",color=orange];
		1120 -> 1131;
	1121 [label="Я не знаю. И не думаю, что ты можешь.",shape=box,color=red];
		1121 -> 1132;
	1122 [label="Думаю, это была сущность, существовавшая ещё до того, как Энтрати с ней взаимодействовал. Он просто придал ей форму посредством Концептуального Воплощения.",shape=box,color=red];
		1122 -> 1133;
	1123 [label="Честно… я не знаю.",shape=box,color=red];
		1123 -> 1134;
	1124 [label="Ты и правда считаешь, что Энтрати создал злобного бога Бездны из ниоткуда?",shape=box,color=red];
		1124 -> 1135;
	1125 [label="Эта штука сильнее всего, с чем мне когда-либо приходилось сталкиваться.",shape=box,color=red];
		1125 -> 1136;
	1126 [label="И что же это по-твоему тогда?",shape=box,color=red];
		1126 -> 1116;
	1127 [label="Концептуальное воплощение.",shape=box,color=blue];
		1127 -> 1137;
		1127 -> 1138;
		1127 -> 1139;
	1128 [label="В Бездне нет ничего. Именно поэтому она и называется Бездной!",shape=box,color=blue];
		1128 -> 1140;
		1128 -> 1141;
	1129 [label="+10 Chemistry",color=orange];
		1129 -> 1142;
	1130 [label="+20 Chemistry",color=orange];
		1130 -> 5772;
	1131 [label="Но прежде чем мы продолжим, хочу уточнить, верно ли я это понимаю. Вы считаете, что Безразличие это некая Ужасное Непознаваемое Существо из Бездны, просачивающаяся в нашу реальность из-за ошибок Альбрехта?",shape=box,color=blue];
		1131 -> 1107;
	1132 [label="Да! Могу! Происходящее настолько очевидно, и до нелепости смешно, что ты уже начинаешь верить, будто в окно скребётся какой-то огромный зверь, хотя это всего лишь ветка дерева на ветру.",shape=box,color=blue];
		1132 -> 1143;
	1133 [label="Только не ты. У меня были такие большие надежды. Происходящее настолько очевидно, и до нелепости смешно, что ты уже начинаешь верить, будто в окно скребётся какой-то огромный зверь, хотя это всего лишь ветка дерева на ветру.",shape=box,color=blue];
		1133 -> 1143;
	1134 [label="Происходящее настолько очевидно, и до нелепости смешно, что ты уже начинаешь верить, будто в окно скребётся какой-то огромный зверь, хотя это всего лишь ветка дерева на ветру.",shape=box,color=blue];
		1134 -> 1143;
	1135 [label="Да! Конечно! Происходящее настолько очевидно, и до нелепости смешно, что ты уже начинаешь верить, будто в окно скребётся какой-то огромный зверь, хотя это всего лишь ветка дерева на ветру.",shape=box,color=blue];
		1135 -> 1143;
	1136 [label="И когда я это оспаривал? Похоже, вы все умудрились втянуть себя в весьма истеричную и совершенно ненужную передрягу.",shape=box,color=blue];
		1136 -> 1144;
		1136 -> 1145;
	1137 [label="Бездна и наше взаимодействие с ней опасно и могущественно — поверь мне, я знаю. Но у неё есть пределы. Ты действительно думаешь, что она способна породить нечто подобное? Создать целые языки, пальцы, способные приводить в движение корабли, прыгающие сквозь Бездну?",shape=box,color=red];
		1137 -> 1146;
	1138 [label="В это... очень хочется поверить, что это только монстр под нашей кроватью, Роут. Но после встречи с этим лицом к лицу, я не знаю, как что-то подобное может быть создано нашим сознанием.",shape=box,color=red];
		1138 -> 1147;
	1139 [label="Концептуальное Воплощение не может сделать то, на что способен Человек в Стене. Хотя Энтрати, возможно, обнаружил эту вещь — и несёт ответственность за её перенесение сюда — но я не верю, что он первоисточник.",shape=box,color=red];
		1139 -> 1148;
	1140 [label="Я…",shape=box,color=red];
		1140 -> 1149;
	1141 [label="Нет. Мне знакомо то, что порождает Бездна… Ангелы. Пение. Призраки.",shape=box,color=red];
		1141 -> 1149;
	1142 [label="Хотя твоя непреклонность вызывает разочарование, твоя откровенность по-своему чрезвычайно освежает. И приятно осознавать, что время на тебя больше не расходуется. Другие варианты для развлечений найдутся сами.",shape=box,color=blue];
		1142 -> 1150;
	5772 [label="Fantastic. I am glad my former self was so wonderfully convincing. And I am hopeful you are being honest and not lying to me in an attempt to \"shut me up.\" But, I have no choice but to believe you.",shape=box,color=blue];
		5772 -> 5773;
	1143 [label="Только теперь, под влиянием Бездны, вы все вселили в неё столько страха и силы, что, как по замкнутому кругу, это кристаллизовалось в эту... Вещь. Этот Человек в стене.",shape=box,color=blue];
		1143 -> 1151;
	1144 [label="Ты к чему это ведёшь?",shape=box,color=red];
		1144 -> 1152;
	1145 [label="Постой. С какой стати мы виноваты в этом? Виноват Альбрехт, он выпустил это на волю.",shape=box,color=red];
		1145 -> 1153;
	1146 [label="Человечество, безусловно, ничто иное, как неистощимый источник изобретательности в создании новых форм страданий, не так ли? Тебе, несомненно, выпадала возможность стать свидетелем жестокостей, о которых невозможно было даже помыслить во времена наших благочестивых фанатиков.",shape=box,color=blue];
		1146 -> 1154;
	1147 [label="Ах, ты так близко к истине и в то же время так поспешно отвергаешь её. Тебе кажется соблазнительной мысль, что это порождение твоего разума, ведь так было бы легче отмахнуться, будь это так? Нет, я думаю, куда опаснее столкнуться с творением собственных рук, нежели с богом.",shape=box,color=blue];
		1147 -> 1155;
	1148 [label="Хотя я ценю твоё смирение, осмелюсь утверждать, что ты недооцениваешь безграничные возможности человеческого творчества — особенно в том, как оно способно изобретать новые формы страдания. Разве ткань этого мира, где ты живёшь, соткана не тобой?",shape=box,color=blue];
		1148 -> 1156;
	1149 [label="Единственное, что приходит из Бездны, — это то, что мы сами туда помещаем… и то, что возвращается обратно. Она изменяет материю и энергию, но не способна их сотворить.",shape=box,color=blue];
		1149 -> 1157;
	1150 [label="Я, со своей стороны, считаю удачей то, что удалось избежать второго раунда блужданий и круговых дебатов о тонкостях Концептуального Воплощения.",shape=box,color=blue];
		1150 -> 1158;
	5773 [label="Either way, I am certain we will find other ways to amuse ourselves than to be lost in wandering and circular debates about the finer points of Conceptual Embodiment.",shape=box,color=blue];
		5773 -> 5774;
	1151 [label="Альбрехт, возможно, и затеял эту чушь, но вы все несёте ответственность за то, что разжигали огонь, пока он не превратился в ад. Безразличия никогда не существовало. Пока оно внезапно не появилось. ",shape=box,color=blue];
		1151 -> 1159;
	1152 [label="Вот что я хочу сказать: возможно, именно Альбрехт первым увидел собственную гордыню, отражённую в лице ухмыляющегося бога разрушения, да.",shape=box,color=blue];
		1152 -> 1160;
	1153 [label="Возможно, именно Альбрехт первым увидел собственную гордыню, отражённую в лице ухмыляющегося бога разрушения.
",shape=box,color=blue];
		1153 -> 1160;
	1154 [label="+5 Chemistry",color=orange];
		1154 -> 1161;
	1155 [label="Внешнего врага можно понять. Им можно манипулировать. Его можно победить. А возможно, даже договориться, если дойдёт до этого. У него есть слабости, которые можно использовать. Но враг внутренний? Созданный нами самими? Он гораздо коварнее.",shape=box,color=blue];
		1155 -> 1162;
	1156 [label="Тебе тоже приходилось стать свидетелем множества жестокостей, о которых, никто и не мог помыслить во времена наших ревностных фанатиков. ",shape=box,color=blue];
		1156 -> 1163;
	1157 [label="Подумай, Скиталец. Эти так называемые «Ангелы Бездны», о которых ты говоришь. Эти призраки. Созданы ли они из тех, кто уже затерялся в Бездне?",shape=box,color=blue];
		1157 -> 1164;
	1158 [label="Хотя это и означает больше времени для проповедей фанатиков... фу. Выбор, выбор, выбор...",shape=box,color=blue];
		1158 -> 1165;
	5774 [label="I, for one, am grateful to be spared a second round.",shape=box,color=blue];
		5774 -> 1158;
	1159 [label="И во всём этом виноват именно ты.",shape=box,color=blue];
		1159 -> 1166;
		1159 -> 1167;
		1159 -> 1168;
	1160 [label="Но вы все в равной степени виноваты в том, что так долго катите этот грязный ком вниз по склону, позволяя ему увеличиваться с каждым собранным по пути куском нечистот!",shape=box,color=blue];
		1160 -> 1169;
	1161 [label="Как вид, мы поистине удивительны в нашей способности подпитывать свои страхи новыми способами саморазрушения.",shape=box,color=blue];
		1161 -> 1170;
	1162 [label="+5 Chemistry",color=orange];
		1162 -> 1171;
	1163 [label="+5 Chemistry",color=orange];
		1163 -> 1161;
	1164 [label="Это были лишь отголоски энергии, извергаемые подобно тому, как это делает пёстрый кутак, чтобы накормить своё потомство.",shape=box,color=blue];
		1164 -> 1169;
	1165 [label="Chat ends.",color=orange];
	1166 [label="Мы не можем создавать такие вещи, Роут, это уже обсуждалось. Концептуальное воплощение имеет свои пределы.",shape=box,color=red];
		1166 -> 1172;
	1167 [label="Не вините нас. Мы не виноваты в том, что натворило это существо.",shape=box,color=red];
		1167 -> 1173;
	1168 [label="Объясни мне, как это вообще должно работать. Большинство вещей, созданных посредством Концептуального Воплощения из Бездны, не могут покинуть её - по крайней мере, надолго.",shape=box,color=red];
		1168 -> 1174;
	1169 [label="Позволь мне сделать обсуждение проще. Я могу разоблачить это ложное божество для тебя двумя простыми словами, которые вам следует знать и понимать вполне отчётливо.",shape=box,color=blue];
		1169 -> 1127;
	1170 [label="Update boolean RoatheMITW1",color=orange];
		1170 -> 1107;
	1171 [label="Потому что тогда придётся сражаться со своими собственными демонами. А человечество… такие войны никогда не выигрывает, правда?",shape=box,color=blue];
		1171 -> 1170;
	1172 [label="Сказал тот, кто в одиночку создал целое альтернативное измерение? Прошу тебя, Скиталец... используй своё воображение, как это случалось в давние времена.",shape=box,color=blue];
		1172 -> 1174;
	1173 [label="Я вовсе не упрекаю тебя! Эта штука уже была в разработке задолго до твоего появления. Альбрехт об этом позаботился.",shape=box,color=blue];
		1173 -> 1175;
	1174 [label="Концептуальное Воплощение работает следующим образом - при взаимодействии с Бездной, или в непосредственной близости от неё, сильные эмоции и мысли могут проявляться физически. Мы оба это знаем.",shape=box,color=blue];
		1174 -> 1176;
		1174 -> 1177;
		1174 -> 1178;
	1175 [label="Он увидел своё отражение и познал истинный страх. Так вспыхнула первая искра, ставшая огнём, что теперь грозит всё уничтожить. Ты же просто подливаешь в него масла.",shape=box,color=blue];
		1175 -> 1174;
	1176 [label="Верно. Как и Дувири, он связан с этим миром через Зариман. ",shape=box,color=red];
		1176 -> 1179;
	1177 [label="Как и Зариман, и Неукротимые, и Ангелы Бездны. Пустота повсюду на этом корабле.",shape=box,color=red];
		1177 -> 1179;
	1178 [label="Да. И что?",shape=box,color=red];
		1178 -> 1180;
	1179 [label="Именно. Там, где уходит Бездна, туда может последовать Концептуальное Воплощение. И только там.",shape=box,color=blue];
		1179 -> 1181;
		1179 -> 1182;
	1180 [label="Там, где уходит Бездна, туда может последовать Концептуальное Воплощение. И только там.",shape=box,color=blue];
		1180 -> 1181;
		1180 -> 1182;
	1181 [label="Но это было до 1999. Это преследовало Альбрехта повсюду. И меня тоже.",shape=box,color=red];
		1181 -> 1183;
	1182 [label="Погоди...",shape=box,color=red];
		1182 -> 1184;
	1183 [label="Проклятые пальцы. Мы взяли эти проклятые пальцы в отчаянной и безумной попытке добраться до Тау, и мы, Орокин, нашли способ их воссоздать, не так ли?",shape=box,color=blue];
		1183 -> 1185;
	1184 [label="Да. Теперь ты понимаешь. Проклятые пальцы. Мы взяли эти проклятые пальцы в отчаянной и безумной попытке добраться до Тау, и мы, Орокин, нашли способ их воссоздать, не так ли?",shape=box,color=blue];
		1184 -> 1185;
	1185 [label="Частички Бездны повсюду, куда ни пойди... Сеть ходов и туннелей, позволяющая этой штуке появляться, где ей вздумается. А что ещё хуже?",shape=box,color=blue];
		1185 -> 1186;
	1186 [label="Тэнно. И ты. Все вы, затронутые Бездной. И всех вас преследует эта тварь, потому что, куда бы вы ни пошли, она может последовать за вами.",shape=box,color=blue];
		1186 -> 1187;
	1187 [label="И, скорее всего, любого, кто хоть немного взаимодействовал с ней. Самого Энтрати. Его дворецкого. Кавию. Меня, фанатиков, из-за того, что они рядом к этому Святилищу. Список бесконечен.",shape=box,color=blue];
		1187 -> 1188;
		1187 -> 1189;
	1188 [label="То есть ты предполагаешь, что любой с достаточным воздействием Бездны, или любой, кто является «батареей», становится ещё одним окном, через которое может наблюдать Человек в Стене?",shape=box,color=red];
		1188 -> 1190;
	1189 [label="Но как, интересно, как оно проникло в Русалку?",shape=box,color=red];
		1189 -> 1191;
	1190 [label="Точно так. ",shape=box,color=blue];
		1190 -> 1192;
	1191 [label="Кто?",shape=box,color=blue];
		1191 -> 1193;
		1191 -> 1194;
	1192 [label="Это и объясняет, отсутствие собственного облика. Существо способно являться в образах тех, кого терзает, и лишь тем, кто становится целью этих мучений.",shape=box,color=blue];
		1192 -> 1195;
	1193 [label="Майор Нэси Русалка. В 1999 она командовала вооружёнными силами известными как «Скальдра» в 1999 в Хёльвании.",shape=box,color=red];
		1193 -> 1196;
	1194 [label="Короче говоря, мне ни при каких обстоятельствах не следует позволять вам двоим встречаться.",shape=box,color=red];
		1194 -> 1197;
	1195 [label="На самом деле, архитектурный облик возникает лишь в те моменты, когда предпринимается отчаянная попытка предстать чем-то Большим и Иным. Когда совершается отчаянная попытка вызвать ощущение Грандиозности и Божественности.",shape=box,color=blue];
		1195 -> 1198;
		1195 -> 1199;
	1196 [label="Она была – или остаётся – одержима Безразличием. Оно завладевает её разумом, манипулирует им, как марионеткой. Или же она сама впустила его. Мы не знаем. Мы также не знаем, вернула ли она себе контроль.",shape=box,color=red];
		1196 -> 1200;
	1197 [label="Это вовсе не смешно, Узурпатор. Но как она связана с нашим... Безразличием, если говорить точнее?",shape=box,color=blue];
		1197 -> 1196;
	1198 [label="Значит, ты полагаешь, что принимается облик каждого, с кем происходит контакт... поскольку собственного лица не существует?",shape=box,color=red];
		1198 -> 1201;
	1199 [label="Я считаю, что Человек в Стене предпочитает носить наши лица, поскольку не может постичь, каково это быть человеком. Любая иная форма становится слишком «большой».",shape=box,color=red];
		1199 -> 1202;
	1200 [label="Она кажется восхитительно замечательным человеком. Настоящее удовольствие. Но давайте двигаться дальше. Ты хочешь сказать, что Безразличие управляет ею? И всё это началось во время твоего маленького путешествия в прошлое?",shape=box,color=blue];
		1200 -> 1203;
	1201 [label="Нет, глупость. Здесь есть лишь подражание своему истоку. Это не цельная сущность - это всего лишь игрушка, слепленная из обломков чужого ужаса, страха и боли, которые были вложены. ",shape=box,color=blue];
		1201 -> 1204;
	1202 [label="Нет, глупость. Здесь лишь отражение того, что послужило изначальным источником. Это не цельная сущность - это всего лишь игрушка, слепленная из обломков чужого ужаса, страха и боли, которые были вложены.",shape=box,color=blue];
		1202 -> 1204;
	1203 [label="Что ж, если то, что мы знаем о Бездне, верно, значит, случилось одно из двух: либо она по собственной глупости в 1999 оказалась в каком-то проявлении Бездны (что я считаю крайне маловероятным, но не невозможным), либо...",shape=box,color=blue];
		1203 -> 1205;
	1204 [label="Эх. Вижу, сегодня я не добьюсь никакого прогресса. Ничего страшного, ты глубоко увяз в этой пропаганде, которой тебя пичкают. Боюсь, Альбрехт весьма убедительный лидер культа.",shape=box,color=blue];
		1204 -> 1206;
	1205 [label="Наш дорогой Альбрехт снова лез не в своё дело.",shape=box,color=blue];
		1205 -> 1207;
		1205 -> 1208;
		1205 -> 1209;
	1206 [label="+10 Chemistry",color=orange];
		1206 -> 1210;
	1207 [label="Ты намекаешь на то, что Альбрехт специально сделал Нэси марионеткой Безразличия?",shape=box,color=red];
		1207 -> 1211;
	1208 [label="Мы не знаем, правда ли всё это. Это всего лишь домыслы. Всё это могло быть чистой ложью.",shape=box,color=red];
		1208 -> 1212;
	1209 [label="Если в 1999 году сознательно был пробит проход в Бездну и позволил ей проникнуть... это объяснило бы, почему варфреймы действовали там с самого начала... то же самое для твоего времени - без сердца Деймоса, конечно.",shape=box,color=red];
		1209 -> 1213;
	1210 [label="Update boolean RoatheMITW2",color=orange];
		1210 -> 1214;
	1211 [label="Я просто сижу здесь и гадаю на кофейной гуще не хуже остальных, Узурпатор. Какое уж мне дело намекать, будто Альбрехт намеренно проделал дыру в Бездне в Хёльвании и впустил Безразличие, чтобы дать ему собственное воплощение...",shape=box,color=blue];
		1211 -> 1215;
	1212 [label="Естественно! Я просто сижу здесь и гадаю на кофейной гуще не хуже остальных, Узурпатор. Какое уж мне дело намекать, будто Альбрехт намеренно проделал дыру в Бездне в Хёльвании и впустил Безразличие, чтобы дать ему собственное воплощение...",shape=box,color=blue];
		1212 -> 1215;
	1213 [label="Видишь? Никогда не доверяй учёным. Ради эксперимента они готовы на что угодно. Но в конце концов я тоже просто гадаю по осадку, Узурпатор. Всё это просто гипотезы.",shape=box,color=blue];
		1213 -> 1216;
	1214 [label="Надеюсь, это хотя бы дало вам пищу для размышлений. А сейчас мне нужно идти.",shape=box,color=blue];
		1214 -> 1217;
	1215 [label="Мне просто кажется, как тактику и человеку, привыкшему к разработке стратегии войны...",shape=box,color=blue];
		1215 -> 1218;
	1216 [label="Я далек от мысли, что Альбрехт намеренно проделал дыру в Бездне в Хёльвании и впустил Безразличие, ради собственного аватара! Мне просто кажется, как тактику и человеку, привыкшему к разработке военных стратегий...",shape=box,color=blue];
		1216 -> 1218;
	1217 [label="Chat ends.",color=orange];
	1218 [label="Что первым шагом к победе над безликим противником, способным находиться где угодно, кем угодно и когда угодно? Является сведение возможных вариантов к минимуму...",shape=box,color=blue];
		1218 -> 1219;
	1219 [label="+20 Chemistry",color=orange];
		1219 -> 1220;
	1220 [label="И убедиться, чтобы эти варианты были реализованы.",shape=box,color=blue];
		1220 -> 1221;
	1221 [label="Update boolean RoatheMITW2Neci",color=orange];
		1221 -> 1222;
	1222 [label="Прекрасная пища для размышлений. Но! А пока мне пора.",shape=box,color=blue];
		1222 -> 1223;
	1223 [label="Chat ends.",color=orange];
}