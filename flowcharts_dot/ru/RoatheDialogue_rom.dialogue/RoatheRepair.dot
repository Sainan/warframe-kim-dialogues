digraph {
	graph [fontname="Roboto Condensed"];
	node [fontname="Roboto Condensed"];
	edge [fontname="Roboto Condensed"];

	"RoatheRepair begins." [color=orange];
		"RoatheRepair begins." -> j2688688654;
	j2688688654 [label="Evaluate expressions",color=orange];
		j2688688654 -> j672031668 [label="LyonRoatheFailFix & MarieRoatheFailFix",color=purple];
		j2688688654 -> "Chat ends." [label="false",color=purple];
	j672031668 [label="Хватит! Довольно. Я сдаюсь! Отзови своих фанатиков. Они хуже бешеных кубродонов! Проклятые твари преследуют меня повсюду. Я даже поспать нормально не могу!",shape=box,color=blue];
		j672031668 -> j618258441;
	"Chat ends." [color=orange];
	j618258441 [label="Что?! Чего ты от меня хочешь?!",shape=box,color=blue];
		j618258441 -> j213199188;
		j618258441 -> j1293341343;
		j618258441 -> j1475785816;
	j213199188 [label="Ещё один шанс поговорить с тобой о том, что ты принял сыворотку. Роут, пришло время перестать бежать. ",shape=box,color=red];
		j213199188 -> j1979205857;
	j1293341343 [label="Роут. Принятие сыворотки не делает тебя трусом. Оно делает тебя единственным Орокин, оставшийся на ногах. Прими это.",shape=box,color=red];
		j1293341343 -> j1420398166;
	j1475785816 [label="Роут. Принятие сыворотки не делает тебя трусом. Она дала тебе ещё один шанс на жизнь. На то, чтобы действительно что-то изменить.",shape=box,color=red];
		j1475785816 -> j62611055;
	j1979205857 [label="Evaluate expressions on Thermostat counter",color=orange];
		j1979205857 -> j958309372 [label="x >= 5",color=purple];
		j1979205857 -> j2495526896 [label="x <= 0",color=purple];
		j1979205857 -> j1642846470 [label="x > 0 && x < 5",color=purple];
		j1979205857 -> j1642846470 [label="false",color=purple];
	j1420398166 [label="Add -5 to Thermostat counter",color=orange];
		j1420398166 -> j1979205857;
	j62611055 [label="Add 5 to Thermostat counter",color=orange];
		j62611055 -> j1979205857;
	j958309372 [label="Ты позволяешь этой злости разрывать тебя изнутри. А мог бы использовать её, чтобы бороться с теми, кто продолжает разрушать этот мир сегодня. Здесь. Сейчас.",shape=box,color=red];
		j958309372 -> j1044141635;
	j2495526896 [label="Ты обращаешь это против себя. А ведь стоило бы направить это к миру, который винит тебя за то, что ты пытался сделать всё, что возможно, чтобы защитить его от Империи Орокин.",shape=box,color=red];
		j2495526896 -> j3266273730;
	j1642846470 [label="Так вот зачем ты убедил их донимать меня днём и ночью? Ради этого? Последняя отчаянная попытка заставить меня выслушать твой жалкий довод?",shape=box,color=blue];
		j1642846470 -> j483131705;
	j1044141635 [label="Твоя суть не определяется твоим прошлым, Роут. Она определяется твоим будущим. И у тебя всё ещё есть будущее, которое можно прожить, в отличие от всех Орокин, погибших в Ночь Барабанов Нага.",shape=box,color=red];
		j1044141635 -> j552602665;
	j3266273730 [label="Твою суть не определяют мнения окружающих. Или то, как они воспринимают твои действия. Тебя определяет только то, что ты сам думаешь о себе и о своём выборе.",shape=box,color=red];
		j3266273730 -> j4287188397;
	j483131705 [label="Нет.",shape=box,color=blue];
		j483131705 -> j1824990755;
	j552602665 [label="Сейчас это единственное, что тебя определяет. Ты можешь измениться. И можешь изменить мир вокруг себя. И думаю, у меня остаётся только один вопрос: попробуешь ли хотя бы?",shape=box,color=red];
		j552602665 -> j2963946732;
	j4287188397 [label="Так в чем же простая суть на самом деле? Ты входишь в число немногих Орокин, кто смог пройти через ту Ночь Барабанов Нага. С моей точки зрения? Это выглядит как стратегическое отступление.",shape=box,color=red];
		j4287188397 -> j772563980;
	j1824990755 [label="Твои неудачи жалки. И не один раз, а уже дважды.",shape=box,color=blue];
		j1824990755 -> j3951559817;
	j2963946732 [label="Попробовать простить себя и идти дальше?",shape=box,color=red];
		j2963946732 -> j2931158933;
	j772563980 [label="Ничего больше. Ничего меньше.",shape=box,color=red];
		j772563980 -> j273489916;
	j3951559817 [label="Я бы не советовал тебе баллотироваться на государственную должность.",shape=box,color=blue];
		j3951559817 -> "Chat ends.";
	j2931158933 [label="Boolean RoatheRedeemed is now true.",color=orange];
		j2931158933 -> j2890925782;
	j273489916 [label="Boolean RoatheVillain is now true.",color=orange];
		j273489916 -> j583522739;
	j2890925782 [label="+20 Chemistry",color=orange];
		j2890925782 -> j4148952479;
	j583522739 [label="+20 Chemistry",color=orange];
		j583522739 -> j4000971169;
	j4148952479 [label="Принять то, что было сделано, и шагнуть вперёд, к будущему? Хм.",shape=box,color=blue];
		j4148952479 -> j2650892307;
	j4000971169 [label="Отступление ради победы в войне. Хм. ",shape=box,color=blue];
		j4000971169 -> j902731457;
	j2650892307 [label="Пусть некоторое недоверие к новому взгляду на происходящее и сохраняется, соблазн этого будущего и его значения для меня слишком велик, чтобы отвернуться от него, Скиталец, дорогуша.",shape=box,color=blue];
		j2650892307 -> j1661880368;
	j902731457 [label="Пусть и остаётся... легкое недоверие к тому, что случившееся подаётся как тактический отход, всё равно... с этим трудно не согласиться, Скиталец дорогуша.",shape=box,color=blue];
		j902731457 -> j1730403472;
	j1661880368 [label="Этот «новый шанс» в моей жизни. Хорошо. Я уступаю и принимаю твой довод. Даже если слишком поздно, он всё равно оказался... действенным.",shape=box,color=blue];
		j1661880368 -> j559981152;
	j1730403472 [label="Хорошо. Я уступаю и принимаю твой довод. Даже если слишком поздно, он всё равно оказался... действенным.",shape=box,color=blue];
		j1730403472 -> j559981152;
	j559981152 [label="Я очень ценю это. Гораздо сильнее, чем ты можешь представить.",shape=box,color=blue];
		j559981152 -> j757561088;
	j757561088 [label="Boolean RoatheFail is now false.",color=orange];
		j757561088 -> j2141078128;
	j2141078128 [label="Boolean RoatheFamilyFail is now false.",color=orange];
		j2141078128 -> j313480356;
	j313480356 [label="Boolean RoatheFailStall is now false.",color=orange];
		j313480356 -> j3136897973;
	j3136897973 [label="Check boolean LoidFamilyComplete",color=orange];
		j3136897973 -> "Chat ends." [label=true,color=green];
		j3136897973 -> j3009513094 [label=false,color=brown];
	j3009513094 [label="Теперь, я полагаю, мы можем перейти к следующей битве этой войны, да? Дворецкий.",shape=box,color=blue];
		j3009513094 -> j4232819114;
	j4232819114 [label="Я, со своей стороны, ждать не могу.",shape=box,color=blue];
		j4232819114 -> j1288719760;
	j1288719760 [label="Boolean RoatheFamilyDelay is now true.",color=orange];
		j1288719760 -> "Chat ends.";
}