	"Chat ends." [color=orange];
	j3062015149 [label="VM: SUBMISSION",shape=box,color=blue];
		j3062015149 -> j830555115;
	j830555115 [label="Стенограмма: Я понимал с самого начала - и на поле боя, и в опочивальне - что путь к победе лежит через кажущуюся покорность.",shape=box,color=blue];
		j830555115 -> j3642719657;
	j3642719657 [label="Where the enemy finds you yielding, there you can be sure he will push; and so you may easily trip him.",shape=box,color=blue];
		j3642719657 -> j99592257;
	j99592257 [label="“Lackey,” they called me. “Lapdog.” Nitokh thought herself in control. How subtly I guided her. ",shape=box,color=blue];
		j99592257 -> j1330242467;
	j1330242467 [label="Роут, чьи руки запачканы кровью. Роут, чудовище, разжиревшее на трупах своих людей. Транжира жизней.",shape=box,color=blue];
		j1330242467 -> j2994521197;
	j2994521197 [label="Будто я сражался ради самой битвы. Нет. Империя Орокин должна пасть.",shape=box,color=blue];
		j2994521197 -> j644485416;
	j644485416 [label="For that to happen, the war must continue. Only defeat, absolute and irrevocable, would topple those seven golden gargoyles.",shape=box,color=blue];
		j644485416 -> j3718019997;
	j3718019997 [label="Даже Ниток не знала моего истинного сердца. Она думала, что я стремлюсь править рядом с ней",shape=box,color=blue];
		j3718019997 -> j921430358;
	j921430358 [label="Add 1 to HellStory counter",color=orange];
		j921430358 -> "Chat ends.";
}