	"Chat ends." [color=orange];
	j710418983 [label="ГС: ПОДЧИНЕНИЕ",shape=box,color=blue];
		j710418983 -> j3440507888;
	j3440507888 [label="Стенограмма: Я понимал с самого начала - и на поле боя, и в опочивальне - что путь к победе лежит через кажущуюся покорность.",shape=box,color=blue];
		j3440507888 -> j83615290;
	j83615290 [label="Там, где враг видит твою уступчивость, там он непременно станет давить, и тогда его легко можно опрокинуть.",shape=box,color=blue];
		j83615290 -> j2688338671;
	j2688338671 [label="«Прислужник», называли они меня. «Прихвостень». Ниток думала, что держит меня под контролем. Как незаметно я вел её. ",shape=box,color=blue];
		j2688338671 -> j3454016040;
	j3454016040 [label="Роут, чьи руки запачканы кровью. Роут, чудовище, разжиревшее на трупах своих людей. Транжира жизней.",shape=box,color=blue];
		j3454016040 -> j3068503491;
	j3068503491 [label="Будто я сражался ради самой битвы. Нет. Империя Орокин должна пасть.",shape=box,color=blue];
		j3068503491 -> j1937947612;
	j1937947612 [label="А для этого война должна продолжаться. Только поражение, полное и необратимое, способно было сбросить тех семерых золотых горгулий.",shape=box,color=blue];
		j1937947612 -> j3718019997;
	j3718019997 [label="Даже Ниток не знала моего истинного сердца. Она думала, что я стремлюсь править рядом с ней",shape=box,color=blue];
		j3718019997 -> j921430358;
	j921430358 [label="Add 1 to HellStory counter",color=orange];
		j921430358 -> "Chat ends.";
}