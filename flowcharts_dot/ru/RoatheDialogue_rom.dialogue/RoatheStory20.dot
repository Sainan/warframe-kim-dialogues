	"RoatheStory20 begins." [color=orange];
		"RoatheStory20 begins." -> j1043267640;
	j1043267640 [label="Check /Lotus/Scripts/1999/DialogueScriptNodes.lua:StoryConditions(dialogueType=/Lotus/Types/Gameplay/1999Wf/Dialogue/RoatheDialogue_rom.dialogue, rank=4, count=14, storyCount=20)",color=orange];
		j1043267640 -> j1035281352 [label=true,color=green];
		j1043267640 -> "Chat ends." [label=false,color=brown];
	j1035281352 [label="Evaluate expressions on HellKeyPlayed counter",color=orange];
		j1035281352 -> j3230281171 [label="x >= 20",color=purple];
		j1035281352 -> "Chat ends." [label="false",color=purple];
	"Chat ends." [color=orange];
	j3230281171 [label="ГС: ПОДЧИНЕНИЕ",shape=box,color=blue];
		j3230281171 -> j1443545055;
	j1443545055 [label="Стенограмма: Я понимал с самого начала - и на поле боя, и в опочивальне - что путь к победе лежит через кажущуюся покорность.",shape=box,color=blue];
		j1443545055 -> j2128965265;
	j2128965265 [label="Там, где враг видит твою уступчивость, там он непременно станет давить, и тогда его легко можно опрокинуть.",shape=box,color=blue];
		j2128965265 -> j2173896531;
	j2173896531 [label="«Прислужник», называли они меня. «Прихвостень». Ниток думала, что держит меня под контролем. Как незаметно я вел её. ",shape=box,color=blue];
		j2173896531 -> j3319613898;
	j3319613898 [label="Роут, чьи руки запачканы кровью. Роут, чудовище, разжиревшее на трупах своих людей. Транжира жизней.",shape=box,color=blue];
		j3319613898 -> j423511862;
	j423511862 [label="Будто я сражался ради самой битвы. Нет. Империя Орокин должна пасть.",shape=box,color=blue];
		j423511862 -> j2679591760;
	j2679591760 [label="А для этого война должна продолжаться. Только поражение, полное и необратимое, способно было сбросить тех семерых золотых горгулий.",shape=box,color=blue];
		j2679591760 -> j2827675591;
	j2827675591 [label="Даже Ниток не знала моего истинного сердца. Она думала, что я стремлюсь править рядом с ней.",shape=box,color=blue];
		j2827675591 -> j921430358;
	j921430358 [label="Add 1 to HellStory counter",color=orange];
		j921430358 -> "Chat ends.";
}