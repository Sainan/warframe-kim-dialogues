digraph {
	3120 [label="RoatheRank4Convo8 begins.",color=orange];
		3120 -> 3121;
		3120 -> 3122;
	3121 [label="Как прошло твоё детство, Роут?",shape=box,color=red];
		3121 -> 3123;
	3122 [label="[Конец.]",shape=box,color=red];
		3122 -> 3124;
	3123 [label="Хм? Любопытный вопрос. Что значит, «каким» оно было? Если честно, я почти не помню. А звезды и статуи, в которых были заключены те воспоминания, наверное, давно рассыпались в прах или уже превращены в эндо, как я предполагаю.",shape=box,color=blue];
		3123 -> 3125;
	3124 [label="Chat ends.",color=orange];
	3125 [label="Боюсь, я могу вспомнить лишь самые краткие образы, поскольку это было так давно. Многое из того, что я видел, мне кажется, я вообразил, словно во сне, или словно я приписываю образы событиям, о которых читал в исторической книге.",shape=box,color=blue];
		3125 -> 3126;
	3126 [label="Так что всё, что я могу вспомнить, вероятно, крайне ненадежно, это я признаю. Но почему ты задаешь этот вопрос?",shape=box,color=blue];
		3126 -> 3127;
		3126 -> 3128;
		3126 -> 3129;
	3127 [label="Даже если эти истории ложны, вы всё равно рассказываете их себе о годах своего становления. Их всё равно стоит знать.",shape=box,color=red];
		3127 -> 3130;
	3128 [label="Мне просто любопытно, каково было расти среди знати Орокин.",shape=box,color=red];
		3128 -> 3131;
	3129 [label="Я пытаюсь понять, что «тебя» сформировало. Как ты стал таким, кем являешься сейчас.",shape=box,color=red];
		3129 -> 3132;
	3130 [label="+5 Chemistry",color=orange];
		3130 -> 3133;
	3131 [label="В юном возрасте меня отправили туда, что фанатики назвали бы «школой пансионном», как и всех молодых Орокин, предназначенных для величия. Там меня проверяли и обучали склонностям и способностям.",shape=box,color=blue];
		3131 -> 3134;
		3131 -> 3135;
	3132 [label="+5 Chemistry",color=orange];
		3132 -> 3136;
	3133 [label="Согласен, ложь, которую мы рассказываем себе, часто важнее истины. Прекрасное наблюдение, Узурпатор.",shape=box,color=blue];
		3133 -> 3137;
	3134 [label="Твои родители просто отправили тебя туда? И на сколько?",shape=box,color=red];
		3134 -> 3138;
	3135 [label="И как там было?",shape=box,color=red];
		3135 -> 3139;
	3136 [label="Пытаешься понять, где именно я «ошибся», да? Вижу! Как забавно. Не думаю, что ты найдешь в моём детстве что-то, что даст тебе ответы, которые ты ищешь.",shape=box,color=blue];
		3136 -> 3140;
	3137 [label="Add -1 to Thermostat",color=orange];
		3137 -> 3131;
	3138 [label="Всю мою юность целиком. Не думаю, что я когда-либо снова видел тех двоих, кто меня породил. Разве что на церемонии, когда меня объявили первым в рейтинге класса?",shape=box,color=blue];
		3138 -> 3141;
	3139 [label="Я думаю, мнение об этом сильно различалось бы в зависимости от того, с кем ты говоришь. Когда я впервые прибыл туда, побои от старших мальчиков были стремительными, а уроки зверски эффективными.",shape=box,color=blue];
		3139 -> 3142;
	3140 [label="Add 1 to Thermostat",color=orange];
		3140 -> 3131;
	3141 [label="Я полагаю, это был первый случай, когда они посчитали уместным заявить на меня права. Я не особенно об этом думаю.",shape=box,color=blue];
		3141 -> 3143;
	3142 [label="Но я, во всём, быстро учусь. И я понял, что если хочу преуспеть в этом конкретном направлении Архимедии, мне лучше применять творческие методы, чтобы не оказаться среди отбросов.",shape=box,color=blue];
		3142 -> 3144;
		3142 -> 3145;
	3143 [label="Я не слишком много помню о своих родителях. Хотя некоторые Орокин охотно воспитывали собственное потомство, мои нет. Они были более чем рады избавиться от меня и продолжить свои жизни.",shape=box,color=blue];
		3143 -> 3146;
		3143 -> 3147;
	3144 [label="Архимедианцы позволяли это допускать?",shape=box,color=red];
		3144 -> 3148;
	3145 [label="Это... ужасно.",shape=box,color=red];
		3145 -> 3149;
	3146 [label="Похоже, это нисколько не помешало тебе в жизни.",shape=box,color=red];
		3146 -> 3150;
	3147 [label="Мне жаль. Это выглядит каким-то печальным способом существования.",shape=box,color=red];
		3147 -> 3150;
	3148 [label="Мой бедный Узурпатор, это сам директор явился с бутылкой Кувы и привел одного из мальчиков прислужника, когда в тот вечер с одним из новых посвящённых зашло слишком далеко.",shape=box,color=blue];
		3148 -> 3151;
	3149 [label="Традиция это мощный инструмент, Узурпатор. Мощный и опасный инструмент, который можно использовать, чтобы удерживать многих здравомыслящих людей в безумных способах мышления.",shape=box,color=blue];
		3149 -> 3152;
	3150 [label="Совсем наоборот. Из-за отсутствия семейных привязанностей у меня было больше времени, чтобы посвящать его милитаристским стратегиям, которые моим сверстникам казались архаичными и устаревшими. ",shape=box,color=blue];
		3150 -> 3153;
	3151 [label="Традиция это мощный инструмент. Мощный и опасный инструмент, который можно использовать, чтобы удерживать многих здравомыслящих людей в безумных способах мышления.",shape=box,color=blue];
		3151 -> 3154;
		3151 -> 3155;
	3152 [label="Это сам директор явился с бутылкой Кувы и привел одного из мальчиков прислужника, когда в тот вечер с одним из новых посвящённых зашло слишком далеко.",shape=box,color=blue];
		3152 -> 3154;
		3152 -> 3155;
	3153 [label="Они и представить не могли, насколько это пригодится мне в будущем.",shape=box,color=blue];
		3153 -> 3156;
		3153 -> 3157;
	3154 [label="А что насчёт твоих родителей?",shape=box,color=red];
		3154 -> 3143;
	3155 [label="У тебя были там друзья?",shape=box,color=red];
		3155 -> 3158;
	3156 [label="Как думаешь, оно того стоило?",shape=box,color=red];
		3156 -> 3159;
	3157 [label="Всё же складывается впечатление, что жизнь у тебя вышла довольно одинокой, однако ж.",shape=box,color=red];
		3157 -> 3160;
	3158 [label="Нет. Я всегда держался особняком. Я усвоил, что внушать страх просто и удобно, но сам страх похож на тонкий кружевной лед, который тает при малейшем прикосновении света.",shape=box,color=blue];
		3158 -> 3161;
	3159 [label="Мои сверстники и представить не могли, насколько эти занятия помогут мне в будущем. Но если ты спрашиваешь, вышло ли это мне в плюс или в минус?",shape=box,color=blue];
		3159 -> 3162;
	3160 [label="Да. Было. Но таков уж порядок вещей, когда живешь жизнью дьявола, не так ли? Даже тогда, когда для одних я был безвластным запасным, почти содержанцем, для других же кровавым полководцем и неистовствующим монстром.",shape=box,color=blue];
		3160 -> 3163;
	3161 [label="Монстров нужно держать во тьме. И если я хотел сохранить вокруг себя ауру опасности, мне приходилось оставаться одному.",shape=box,color=blue];
		3161 -> 3146;
		3161 -> 3147;
	3162 [label="Хм. Я не знаю.",shape=box,color=blue];
		3162 -> 3164;
		3162 -> 3165;
	3163 [label="Я никогда не был желанным ни среди тех, кто выше меня по положению, ни среди тех, кто ниже. И ровни у меня не было вовсе.",shape=box,color=blue];
		3163 -> 3166;
	3164 [label="У тебя есть ещё один шанс исправить то, что ты сделал. У них его нет. ",shape=box,color=red];
		3164 -> 3167;
	3165 [label="Ну, они мертвы, а ты нет. Так что, полагаю, да, вышло.",shape=box,color=red];
		3165 -> 3168;
	3166 [label="Update boolean RoatheUnloved2",color=orange];
		3166 -> 3169;
		3166 -> 3170;
	3167 [label="Add 1 to Thermostat",color=orange];
		3167 -> 3171;
	3168 [label="Add -1 to Thermostat",color=orange];
		3168 -> 3171;
	3169 [label="У тебя есть ещё один шанс исправить то, что ты сделал. У них его нет.",shape=box,color=red];
		3169 -> 3172;
	3170 [label="Ну, по крайней мере у тебя ещё есть будущее, в котором ты можешь решить, как хочешь жить. У них его нет.",shape=box,color=red];
		3170 -> 3173;
	3171 [label="+5 Chemistry",color=orange];
		3171 -> 3174;
	3172 [label="Add 1 to Thermostat",color=orange];
		3172 -> 3171;
	3173 [label="Add -1 to Thermostat",color=orange];
