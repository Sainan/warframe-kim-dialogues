digraph {
	3120 [label="RoatheRank4Convo8 begins.",color=orange];
		3120 -> 3121;
		3120 -> 3122;
	3121 [label="What was your childhood like, Roathe?",shape=box,color=red];
		3121 -> 3123;
	3122 [label="[Конец.]",shape=box,color=red];
		3122 -> 3124;
	3123 [label="Hm? An interesting question. What was it \"like?\" I honestly do not recall much of it. And the stars and sculptures that contained those memories have likely long since turned to dust or rendered to Endo by now, I assume.",shape=box,color=blue];
		3123 -> 3125;
	3124 [label="Chat ends.",color=orange];
	3125 [label="I fear I can only recall the briefest images of it, as it was so very long ago. Much of it I wonder if I did not imagine it as if in a dream, or as though I am assigning imagery to the events I have read in a history book.",shape=box,color=blue];
		3125 -> 3126;
	3126 [label="Ergo, what I can recall is likely to be terribly unreliable, I admit. Why do you ask?",shape=box,color=blue];
		3126 -> 3127;
		3126 -> 3128;
		3126 -> 3129;
	3127 [label="Even if the stories are false, they're still what you tell yourself about your formative years. They're still worth knowing.",shape=box,color=red];
		3127 -> 3130;
	3128 [label="I'm curious what it was like growing up as Orokin nobility.",shape=box,color=red];
		3128 -> 3131;
	3129 [label="I'm wondering what made \"you.\" How you turned out like this.",shape=box,color=red];
		3129 -> 3132;
	3130 [label="+5 Chemistry",color=orange];
		3130 -> 3133;
	3131 [label="I was bundled off to what the zealots would call a \"boarding school\" at a young age, like all Orokin youth destined for greatness. There I was tested and trained for proclivities and aptitudes.",shape=box,color=blue];
		3131 -> 3134;
		3131 -> 3135;
	3132 [label="+5 Chemistry",color=orange];
		3132 -> 3136;
	3133 [label="I agree, the lies we tell ourselves are often more important than the truth. A wonderful insight, Usurper.",shape=box,color=blue];
		3133 -> 3137;
	3134 [label="Your parents just shipped you off? For how long?",shape=box,color=red];
		3134 -> 3138;
	3135 [label="What was it like there?",shape=box,color=red];
		3135 -> 3139;
	3136 [label="Attempting to discern where precisely I went \"wrong\" are you? I see! How amusing. I do not know as you will find much in my childhood to give you the answers you seek.",shape=box,color=blue];
		3136 -> 3140;
	3137 [label="Add -1 to Thermostat",color=orange];
		3137 -> 3131;
	3138 [label="My entire young life. I do not think I ever saw the two who spawned me ever again. Perhaps at the ceremony when I as announced as top of ranking class?",shape=box,color=blue];
		3138 -> 3141;
	3139 [label="I think the opinion would differ wildly depending on to whom you were speaking. When I first arrived, the beatings I received from the older boys were swift and the lessons were brutally efficient.",shape=box,color=blue];
		3139 -> 3142;
	3140 [label="Add 1 to Thermostat",color=orange];
		3140 -> 3131;
	3141 [label="I believe that was the first time they ever saw fit to lay claim to me. I do not pay it much mind.",shape=box,color=blue];
		3141 -> 3143;
	3142 [label="But I am, in all things, a quick study. And I learned that if I wished to excel in that particular avenue of Archimedea, I best apply creative techniques lest I be caught up with the dregs.",shape=box,color=blue];
		3142 -> 3144;
		3142 -> 3145;
	3143 [label="I do not remember much of my parents. While some Orokin were keen to raise their own spawn, mine were not. They were eager enough to be rid of me and to move on with their own lives.",shape=box,color=blue];
		3143 -> 3146;
		3143 -> 3147;
	3144 [label="The Archimedeans let this happen?",shape=box,color=red];
		3144 -> 3148;
	3145 [label="That's... horrible.",shape=box,color=red];
		3145 -> 3149;
	3146 [label="It didn't seem to hold you back any in life.",shape=box,color=red];
		3146 -> 3150;
	3147 [label="I'm sorry. That seems a sad way to be.",shape=box,color=red];
		3147 -> 3150;
	3148 [label="My poor Usurper, it was the Headmaster himself who brought a bottle of Kuva and one of the servant boys when things went too far with one of the new initiates one evening.",shape=box,color=blue];
		3148 -> 3151;
	3149 [label="Tradition is a powerful tool, Usurper. A powerful and dangerous tool that can be used to keep many a sane man locked into insane ways of thinking.",shape=box,color=blue];
		3149 -> 3152;
	3150 [label="Quite the opposite. Because of my lack of familial attachments, I had more time to dedicate to the militaristic strategies that seemed archaic and antiquated to my peers. ",shape=box,color=blue];
		3150 -> 3153;
	3151 [label="Tradition is a powerful tool. A powerful and dangerous tool that can be used to keep many a sane man locked into insane ways of thinking.",shape=box,color=blue];
		3151 -> 3154;
		3151 -> 3155;
	3152 [label="It was the Headmaster himself who brought a bottle of Kuva and one of the servant boys when things went too far with one of the new initiates one evening.",shape=box,color=blue];
		3152 -> 3154;
		3152 -> 3155;
	3153 [label="Little did they know how much that would come to my aid in the future.",shape=box,color=blue];
		3153 -> 3156;
		3153 -> 3157;
	3154 [label="What about your parents?",shape=box,color=red];
		3154 -> 3143;
	3155 [label="Did you have any friends there?",shape=box,color=red];
		3155 -> 3158;
	3156 [label="Was it worth it, do you think?",shape=box,color=red];
		3156 -> 3159;
	3157 [label="It does seem like you lived a lonely life, however.",shape=box,color=red];
		3157 -> 3160;
	3158 [label="No. I kept to myself. I learned that fear is an easy thing to create and wield in others, but it is a delicate lacy ice that is melted with any exposure to light.",shape=box,color=blue];
		3158 -> 3161;
	3159 [label="Little did my peers know how much the studies would do to aid me in the future. But if you are asking as to a net win or loss?",shape=box,color=blue];
		3159 -> 3162;
	3160 [label="Yes. I have. But such is the way of things when you live the life of a devil, is it not? Even then, I was seen as either the powerless second-hand and the concubine or the bloody warlord and the rampaging monster.",shape=box,color=blue];
		3160 -> 3163;
	3161 [label="Monsters must be kept in the dark. And if I was to maintain an aura of danger around me, then I would have to stay alone.",shape=box,color=blue];
		3161 -> 3146;
		3161 -> 3147;
	3162 [label="Hm. I do not know.",shape=box,color=blue];
		3162 -> 3164;
		3162 -> 3165;
	3163 [label="I was never welcome amongst those above my station or those below. And I had no peers to speak of.",shape=box,color=blue];
		3163 -> 3166;
	3164 [label="You have another chance to make up for what you've done. They don't. ",shape=box,color=red];
		3164 -> 3167;
	3165 [label="Well, they're dead and you're not. So I suppose yes, it did.",shape=box,color=red];
		3165 -> 3168;
	3166 [label="Update boolean RoatheUnloved2",color=orange];
		3166 -> 3169;
		3166 -> 3170;
	3167 [label="Add 1 to Thermostat",color=orange];
		3167 -> 3171;
	3168 [label="Add -1 to Thermostat",color=orange];
		3168 -> 3171;
	3169 [label="You have another chance to make up for what you've done. They don't.",shape=box,color=red];
		3169 -> 3172;
	3170 [label="Well, at least you have the rest of your future to decide how you want to live it. They don't.",shape=box,color=red];
		3170 -> 3173;
	3171 [label="+5 Chemistry",color=orange];
		3171 -> 3174;
	3172 [label="Add 1 to Thermostat",color=orange];
		3172 -> 3171;
	3173 [label="Add -1 to Thermostat",color=orange];
		3173 -> 3171;
	3174 [label="I suppose we shall see. Won't we?",shape=box,color=blue];
		3174 -> 3175;
	3175 [label="Chat ends.",color=orange];
}