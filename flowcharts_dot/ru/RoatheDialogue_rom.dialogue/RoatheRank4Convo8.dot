digraph {
	graph [fontname="Roboto Condensed"];
	node [fontname="Roboto Condensed"];
	edge [fontname="Roboto Condensed"];

	"RoatheRank4Convo8 begins." [color=orange];
		"RoatheRank4Convo8 begins." -> j6494478;
		"RoatheRank4Convo8 begins." -> j1310452999;
	j6494478 [label="Как прошло твоё детство, Роут?",shape=box,color=red];
		j6494478 -> j3083693758;
	j1310452999 [label="[Конец.]",shape=box,color=red];
		j1310452999 -> "Chat ends.";
	j3083693758 [label="Хм? Любопытный вопрос. Что значит, «каким» оно было? Если честно, я почти не помню. А звезды и статуи, в которых были заключены те воспоминания, наверное, давно рассыпались в прах или уже превращены в эндо, как я предполагаю.",shape=box,color=blue];
		j3083693758 -> j2172514044;
	"Chat ends." [color=orange];
	j2172514044 [label="Боюсь, я могу вспомнить лишь самые краткие образы, поскольку это было так давно. Многое из того, что я видел, мне кажется, я вообразил, словно во сне, или словно я приписываю образы событиям, о которых читал в исторической книге.",shape=box,color=blue];
		j2172514044 -> j1657692929;
	j1657692929 [label="Так что всё, что я могу вспомнить, вероятно, крайне ненадежно, это я признаю. Но почему ты задаешь этот вопрос?",shape=box,color=blue];
		j1657692929 -> j268388352;
		j1657692929 -> j3225768963;
		j1657692929 -> j770192989;
	j268388352 [label="Даже если эти истории ложны, вы всё равно рассказываете их себе о годах своего становления. Их всё равно стоит знать.",shape=box,color=red];
		j268388352 -> j2006456491;
	j3225768963 [label="Мне просто любопытно, каково было расти среди знати Орокин.",shape=box,color=red];
		j3225768963 -> j4071426725;
	j770192989 [label="Я пытаюсь понять, что «тебя» сформировало. Как ты стал таким, кем являешься сейчас.",shape=box,color=red];
		j770192989 -> j2357072232;
	j2006456491 [label="+5 Chemistry",color=orange];
		j2006456491 -> j1341535980;
	j4071426725 [label="В юном возрасте меня отправили туда, что фанатики назвали бы «школой пансионном», как и всех молодых Орокин, предназначенных для величия. Там меня проверяли и обучали склонностям и способностям.",shape=box,color=blue];
		j4071426725 -> j3337415799;
		j4071426725 -> j1829103018;
	j2357072232 [label="+5 Chemistry",color=orange];
		j2357072232 -> j1303192349;
	j1341535980 [label="Согласен, ложь, которую мы рассказываем себе, часто важнее истины. Прекрасное наблюдение, Узурпатор.",shape=box,color=blue];
		j1341535980 -> j2827152809;
	j3337415799 [label="Твои родители просто отправили тебя туда? И на сколько?",shape=box,color=red];
		j3337415799 -> j3354868904;
	j1829103018 [label="И как там было?",shape=box,color=red];
		j1829103018 -> j1182985710;
	j1303192349 [label="Пытаешься понять, где именно я «ошибся», да? Вижу! Как забавно. Не думаю, что ты найдешь в моём детстве что-то, что даст тебе ответы, которые ты ищешь.",shape=box,color=blue];
		j1303192349 -> j2998884618;
	j2827152809 [label="Add -1 to Thermostat counter",color=orange];
		j2827152809 -> j4071426725;
	j3354868904 [label="Всю мою юность целиком. Не думаю, что я когда-либо снова видел тех двоих, кто меня породил. Разве что на церемонии, когда меня объявили первым в рейтинге класса?",shape=box,color=blue];
		j3354868904 -> j1473196975;
	j1182985710 [label="Я думаю, мнение об этом сильно различалось бы в зависимости от того, с кем ты говоришь. Когда я впервые прибыл туда, побои от старших мальчиков были стремительными, а уроки зверски эффективными.",shape=box,color=blue];
		j1182985710 -> j3297719618;
	j2998884618 [label="Add 1 to Thermostat counter",color=orange];
		j2998884618 -> j4071426725;
	j1473196975 [label="Я полагаю, это был первый случай, когда они посчитали уместным заявить на меня права. Я не особенно об этом думаю.",shape=box,color=blue];
		j1473196975 -> j3710327076;
	j3297719618 [label="Но я, во всём, быстро учусь. И я понял, что если хочу преуспеть в этом конкретном направлении Архимедии, мне лучше применять творческие методы, чтобы не оказаться среди отбросов.",shape=box,color=blue];
		j3297719618 -> j1351974400;
		j3297719618 -> j3715007248;
	j3710327076 [label="Я не слишком много помню о своих родителях. Хотя некоторые Орокин охотно воспитывали собственное потомство, мои нет. Они были более чем рады избавиться от меня и продолжить свои жизни.",shape=box,color=blue];
		j3710327076 -> j2958642248;
		j3710327076 -> j3430526626;
	j1351974400 [label="Архимедианцы позволяли это допускать?",shape=box,color=red];
		j1351974400 -> j2901444240;
	j3715007248 [label="Это... ужасно.",shape=box,color=red];
		j3715007248 -> j3975077077;
	j2958642248 [label="Похоже, это нисколько не помешало тебе в жизни.",shape=box,color=red];
		j2958642248 -> j1619187481;
	j3430526626 [label="Мне жаль. Это выглядит каким-то печальным способом существования.",shape=box,color=red];
		j3430526626 -> j1619187481;
	j2901444240 [label="Мой бедный Узурпатор, это сам директор явился с бутылкой Кувы и привел одного из мальчиков прислужника, когда в тот вечер с одним из новых посвящённых зашло слишком далеко.",shape=box,color=blue];
		j2901444240 -> j4286550126;
	j3975077077 [label="Традиция это мощный инструмент, Узурпатор. Мощный и опасный инструмент, который можно использовать, чтобы удерживать многих здравомыслящих людей в безумных способах мышления.",shape=box,color=blue];
		j3975077077 -> j2644043545;
	j1619187481 [label="Совсем наоборот. Из-за отсутствия семейных привязанностей у меня было больше времени, чтобы посвящать его милитаристским стратегиям, которые моим сверстникам казались архаичными и устаревшими. ",shape=box,color=blue];
		j1619187481 -> j3505395804;
	j4286550126 [label="Традиция это мощный инструмент. Мощный и опасный инструмент, который можно использовать, чтобы удерживать многих здравомыслящих людей в безумных способах мышления.",shape=box,color=blue];
		j4286550126 -> j2800534746;
		j4286550126 -> j3934646104;
	j2644043545 [label="Это сам директор явился с бутылкой Кувы и привел одного из мальчиков прислужника, когда в тот вечер с одним из новых посвящённых зашло слишком далеко.",shape=box,color=blue];
		j2644043545 -> j2800534746;
		j2644043545 -> j3934646104;
	j3505395804 [label="Они и представить не могли, насколько это пригодится мне в будущем.",shape=box,color=blue];
		j3505395804 -> j986077882;
		j3505395804 -> j3994495303;
	j2800534746 [label="А что насчёт твоих родителей?",shape=box,color=red];
		j2800534746 -> j3710327076;
	j3934646104 [label="У тебя были там друзья?",shape=box,color=red];
		j3934646104 -> j2534768535;
	j986077882 [label="Как думаешь, оно того стоило?",shape=box,color=red];
		j986077882 -> j627308507;
	j3994495303 [label="Всё же складывается впечатление, что жизнь у тебя вышла довольно одинокой, однако ж.",shape=box,color=red];
		j3994495303 -> j321520763;
	j2534768535 [label="Нет. Я всегда держался особняком. Я усвоил, что внушать страх просто и удобно, но сам страх похож на тонкий кружевной лед, который тает при малейшем прикосновении света.",shape=box,color=blue];
		j2534768535 -> j1709802625;
	j627308507 [label="Мои сверстники и представить не могли, насколько эти занятия помогут мне в будущем. Но если ты спрашиваешь, вышло ли это мне в плюс или в минус?",shape=box,color=blue];
		j627308507 -> j3561173656;
	j321520763 [label="Да. Было. Но таков уж порядок вещей, когда живешь жизнью дьявола, не так ли? Даже тогда, когда для одних я был безвластным запасным, почти содержанцем, для других же кровавым полководцем и неистовствующим монстром.",shape=box,color=blue];
		j321520763 -> j2851459324;
	j1709802625 [label="Монстров нужно держать во тьме. И если я хотел сохранить вокруг себя ауру опасности, мне приходилось оставаться одному.",shape=box,color=blue];
		j1709802625 -> j2958642248;
		j1709802625 -> j3430526626;
	j3561173656 [label="Хм. Я не знаю.",shape=box,color=blue];
		j3561173656 -> j1630589740;
		j3561173656 -> j2902314865;
	j2851459324 [label="Я никогда не был желанным ни среди тех, кто выше меня по положению, ни среди тех, кто ниже. И ровни у меня не было вовсе.",shape=box,color=blue];
		j2851459324 -> j299591844;
	j1630589740 [label="У тебя есть ещё один шанс исправить то, что ты сделал. У них его нет. ",shape=box,color=red];
		j1630589740 -> j3478626635;
	j2902314865 [label="Ну, они мертвы, а ты нет. Так что, полагаю, да, вышло.",shape=box,color=red];
		j2902314865 -> j3405722963;
	j299591844 [label="Boolean RoatheUnloved2 is now true.",color=orange];
		j299591844 -> j2641528694;
		j299591844 -> j678575005;
	j3478626635 [label="Add 1 to Thermostat counter",color=orange];
		j3478626635 -> j2527222828;
	j3405722963 [label="Add -1 to Thermostat counter",color=orange];
		j3405722963 -> j2527222828;
	j2641528694 [label="У тебя есть ещё один шанс исправить то, что ты сделал. У них его нет.",shape=box,color=red];
		j2641528694 -> j3478626635;
	j678575005 [label="Ну, по крайней мере у тебя ещё есть будущее, в котором ты можешь решить, как хочешь жить. У них его нет.",shape=box,color=red];
		j678575005 -> j3405722963;
	j2527222828 [label="+5 Chemistry",color=orange];
		j2527222828 -> j1144080132;
	j1144080132 [label="Что ж, думаю, мы ещё узнаем. Не так ли?",shape=box,color=blue];
		j1144080132 -> "Chat ends.";
}