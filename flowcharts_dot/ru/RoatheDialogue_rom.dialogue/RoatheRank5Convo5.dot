	"Chat ends." [color=orange];
	j3060448194 [label="Были ли у тебя дополнительные мысли по поводу моего аргумента о твоём «Безразличии»?",shape=box,color=blue];
		j3060448194 -> j330706913;
		j3060448194 -> j539464385;
		j3060448194 -> j100382058;
		j3060448194 -> j1331186560;
	j330706913 [label="Да. Мне кажется, то, что Энтрати выпустил из Бездны, было бесформенным богом, пребывавшее в эфире задолго до того, как мы появились.",shape=box,color=red];
		j330706913 -> j3616742302;
	j539464385 [label="Да. И я думаю, что ты несёшь полную чушь.",shape=box,color=red];
		j539464385 -> j4099310853;
	j100382058 [label="Да. Похоже, это верно. Не думаю, что нечто подобное существовало до взаимодействия с Энтрати. Он стремился найти божество... и Бездна выдала нечто, что лишь изображает его.",shape=box,color=red];
		j100382058 -> j835516038;
	j1331186560 [label="Да. Думаю, ответ где-то между. Раньше это, возможно, не обладало природой божества, но теперь обладает. Похоже, появление произошло в тот момент, когда Энтрати раскрыл Бездну.",shape=box,color=red];
		j1331186560 -> j2337478823;
	j3616742302 [label="Просто невозможно понять, чем мы являемся. ",shape=box,color=red];
		j3616742302 -> j1311916327;
	j4099310853 [label="Check boolean RoatheDating",color=orange];
		j4099310853 -> j3183595588 [label=true,color=green];
		j4099310853 -> j3363070009 [label=false,color=brown];
	j835516038 [label="И с тех пор мы питаем страхом.",shape=box,color=red];
		j835516038 -> j573239974;
	j2337478823 [label="Так же как Рэлл теперь одновременно существует и не существует, Безразличие никогда не было богом, но теперь словно всегда им являлось.",shape=box,color=red];
		j2337478823 -> j2583379715;
	j1311916327 [label="Могу ли я убедить тебя ещё раз рассмотреть мою позицию? Или отношение к теме уже окончательно сформировано?",shape=box,color=blue];
		j1311916327 -> j2941894388;
		j1311916327 -> j198810393;
	j3183595588 [label="Не предполагалось, что у тебя может быть такая хрупкая чувствительность, Скиталец. Но, как выразились бы фанатики: «c'est la vie».",shape=box,color=blue];
		j3183595588 -> j650387292;
	j3363070009 [label="Как сказали бы фанатики: «c'est la vie».",shape=box,color=blue];
		j3363070009 -> "Chat ends.";
	j573239974 [label="Boolean DrifterMITWNotGod is now true.",color=orange];
		j573239974 -> j986753691;
	j2583379715 [label="Трудно переносить сторонников Этернализма. У них это служит оправданием абсолютно всему. Стоит Архимедиан решить, что понимание достигнуто, и дальше процесс становится неконтролируемым.",shape=box,color=blue];
		j2583379715 -> j300864346;
	j2941894388 [label="Можно попробовать.",shape=box,color=red];
		j2941894388 -> j3999032193;
	j198810393 [label="Нет смысла.",shape=box,color=red];
		j198810393 -> j3363070009;
	j650387292 [label="Boolean RoatheNoDate is now true.",color=orange];
		j650387292 -> j776748929;
	j986753691 [label="+5 Chemistry",color=orange];
		j986753691 -> j4095028167;
	j300864346 [label="«Растение не осталось без полива, оно лишь переживает другую параллельную ветвь Этернализма.»",shape=box,color=blue];
		j300864346 -> j2871227025;
	j3999032193 [label="Хотя сегодня ты не звучишь особенно философски, я всё же попробую.",shape=box,color=blue];
		j3999032193 -> j1550169957;
	j776748929 [label="Boolean RoatheDating is now false.",color=orange];
		j776748929 -> j178902881;
	j4095028167 [label="Великолепно! Наконец-то есть прогресс. Трубите в трубы, звоните в колокола, кто-то наконец-то начал мыслить здраво!",shape=box,color=blue];
		j4095028167 -> j4290145;
	j2871227025 [label="Это заставляет меня кричать. Можно ли хоть однажды проявить решительность в этих ничтожных жизнях?!",shape=box,color=blue];
		j2871227025 -> j1705603848;
		j2871227025 -> j3609589561;
	j1550169957 [label="Не то чтобы у меня было занятие получше для моего времени.",shape=box,color=blue];
		j1550169957 -> j65063503;
	j178902881 [label="Boolean IsDating is now false.",color=orange];
		j178902881 -> "Chat ends.";
	j4290145 [label="Check boolean RoatheDating",color=orange];
		j4290145 -> j3954565014 [label=true,color=green];
		j4290145 -> j932299432 [label=false,color=brown];
	j1705603848 [label="Раньше божественной сущности не наблюдалось, теперь же она есть.",shape=box,color=red];
		j1705603848 -> j700420222;
	j3609589561 [label="Неважно.",shape=box,color=red];
		j3609589561 -> j1760665808;
	j65063503 [label="Предлагаю начать с основ. Как бы можно было определить понятие «бог»?",shape=box,color=blue];
		j65063503 -> j1231514987;
		j65063503 -> j203679527;
		j65063503 -> j2909936279;
	j3954565014 [label="Хотя сомнений в том, шаг будет сделан, у меня и не было, дорогой Скиталец. Разборчивый вкус уже был продемонстрирован.",shape=box,color=blue];
		j3954565014 -> j629465391;
	j932299432 [label="Хотя сомнений в том, что решение придёт к этому, у меня не было, Скиталец. Умение убеждать у меня весьма развито. ",shape=box,color=blue];
		j932299432 -> j629465391;
	j700420222 [label="Понятно. Из Бездны Альбрехт сформировал некое «божество». И теперь у нас на свободе «бог». Прелесть какая.",shape=box,color=blue];
		j700420222 -> j2639316910;
		j700420222 -> j832410218;
	j1760665808 [label="Именно.",shape=box,color=blue];
		j1760665808 -> "Chat ends.";
	j1231514987 [label="Высшее существо. То, что обладает полной и неоспоримой властью или силой. ",shape=box,color=red];
		j1231514987 -> j1742975837;
	j203679527 [label="Сверхчеловеческая сущность или создание, обладающее властью над определённым аспектом творения или человеческой судьбы.",shape=box,color=red];
		j203679527 -> j170183661;
	j2909936279 [label="Трудно сказать. Можешь начать.",shape=box,color=red];
		j2909936279 -> j2043424528;
	j629465391 [label="Теперь бы только найти способ убедить всех остальных лунатиков в этом приюте...",shape=box,color=blue];
		j629465391 -> j2597247643;
		j629465391 -> j4000735236;
	j2639316910 [label="Да, всё так.",shape=box,color=red];
		j2639316910 -> j265817981;
	j832410218 [label="Да, но кажется, мы застряли на том, как каждый из нас определяет понятие «бог».",shape=box,color=red];
		j832410218 -> j1190710505;
	j1742975837 [label="И выходит, по твоему, Безразличие можно отнести к разряду подобных высших сущностей?",shape=box,color=blue];
		j1742975837 -> j1626332283;
		j1742975837 -> j2186025963;
	j170183661 [label="И это твоё Безразличие считается высшей сущностью или созданием? И оно обладает властью над аспектом... Безразличия. Равнодушия?",shape=box,color=blue];
		j170183661 -> j2186025963;
		j170183661 -> j1626332283;
	j2043424528 [label="Ну и кто теперь трус? Очень хорошо. Позволь упростить ситуацию и перейти сразу к сути:",shape=box,color=blue];
		j2043424528 -> j80786278;
	j2597247643 [label="Чего я не понимаю, так это того, какую пользу это нам даёт?",shape=box,color=red];
		j2597247643 -> j3494019696;
	j4000735236 [label="Зачем вообще утруждаться?",shape=box,color=red];
		j4000735236 -> j808080305;
	j265817981 [label="Тогда позволь упростить ситуацию и перейти прямо к сути: веришь ли ты, что «бог» может умереть?",shape=box,color=blue];
		j265817981 -> j3158630897;
	j1190710505 [label="Разумное замечание. Как бы следовало понимать слово «бог»?",shape=box,color=blue];
		j1190710505 -> j1832165979;
		j1190710505 -> j3154797612;
		j1190710505 -> j411549331;
	j1626332283 [label="Не могу сказать.",shape=box,color=red];
		j1626332283 -> j233270360;
	j2186025963 [label="Yes. I believe so.",shape=box,color=red];
		j2186025963 -> j3323216182;
	j80786278 [label="Do you believe a \"god\" can die?",shape=box,color=blue];
		j80786278 -> j500710544;
		j80786278 -> j123565785;
		j80786278 -> j1218786666;
		j80786278 -> j3474789502;
		j80786278 -> j3326493426;
	j3494019696 [label="What good does it do us? All the good in the world! Of course, you are the one who has always fought alone. You have never been subjected to the tactics of an army.",shape=box,color=blue];
		j3494019696 -> j1309980706;
	j808080305 [label="Why bother? You poor thing. Of course, you are the one who has always fought alone. You have never been subjected to the tactics of an army.",shape=box,color=blue];
		j808080305 -> j1309980706;
	j3158630897 [label="Can a \"god,\" by any means, cease to exist?",shape=box,color=blue];
		j3158630897 -> j80786278;
	j1832165979 [label="I'm not sure. You go first.",shape=box,color=red];
		j1832165979 -> j3015513157;
	j3154797612 [label="A superhuman entity or creature that has power over a particular aspect of creation or human fortune.",shape=box,color=red];
		j3154797612 -> j4046008236;
	j411549331 [label="An entity that is beyond our comprehension. A creature that exists in a dimension outside ours, and, therefore, does not exist \"like us.\"",shape=box,color=red];
		j411549331 -> j1036783084;
	j233270360 [label="Enough of this going about in circles. Allow me to simply cut to the chase:",shape=box,color=blue];
		j233270360 -> j80786278;
	j3323216182 [label="Check boolean RoatheDating",color=orange];
		j3323216182 -> j2156091272 [label=true,color=green];
		j3323216182 -> j2488802443 [label=false,color=brown];
	j500710544 [label="My hope is to send him back to where he came from.",shape=box,color=red];
		j500710544 -> j1739547524;
	j123565785 [label="I don't know. And I don't think anyone can know.",shape=box,color=red];
		j123565785 -> j1371107730;
	j1218786666 [label="No. I don't think so. Persistence of matter, and all that.",shape=box,color=red];
		j1218786666 -> j2580463961;
	j3474789502 [label="Yes, I think so. Otherwise, we'd be overrun, wouldn't we?",shape=box,color=red];
		j3474789502 -> j1277893366;
	j3326493426 [label="I sincerely hope so.",shape=box,color=red];
		j3326493426 -> j2251111682;
	j1309980706 [label="Knowing thy enemy is key. Now, I have a question for you. Do you believe this creature can be killed?",shape=box,color=blue];
		j1309980706 -> j3376704601;
		j1309980706 -> j1411243414;
		j1309980706 -> j205737416;
	j3015513157 [label="Now who is a coward? Very well. Allow me to simplify matters and cut right to the chase:",shape=box,color=blue];
		j3015513157 -> j3158630897;
	j4046008236 [label="And this Indifference of yours is a supreme entity or creature? And is wields power over an aspect of... Indifference. Of uncaring?",shape=box,color=blue];
		j4046008236 -> j2127443513;
		j4046008236 -> j2752602915;
	j1036783084 [label="Aaah, I see. Now there's the rub. Yes, our definitions did not match. Insomuch as this \"Indifference\" is an entity as you describe it? Yes. We are agreed.",shape=box,color=blue];
		j1036783084 -> j2105694069;
	j2156091272 [label="Disappointing. I would have thought you more clever than that. But allow me to ask you this and cut to the chase:",shape=box,color=blue];
		j2156091272 -> j80786278;
	j2488802443 [label="Disappointing. But allow me to ask you this and cut to the chase:",shape=box,color=blue];
		j2488802443 -> j80786278;
	j1739547524 [label="Peacemongers. Why must there always be a peacemonger.",shape=box,color=blue];
		j1739547524 -> j3335747066;
	j1371107730 [label="Therefore, you imply in your modest ignorance, that we are all groping about in the darkness.",shape=box,color=blue];
		j1371107730 -> j2883446565;
	j2580463961 [label="Oh, grand. You think \"gods\" cannot die!",shape=box,color=blue];
		j2580463961 -> j3335747066;
	j1277893366 [label="And your logic is... that gods can die because... \"gods\" are like pobbers?",shape=box,color=blue];
		j1277893366 -> j208922016;
	j2251111682 [label="Well, yes, that is obvious, but stick with me, Drifter. I need you to focus.",shape=box,color=blue];
		j2251111682 -> j208922016;
	j3376704601 [label="No clue, honestly.",shape=box,color=red];
		j3376704601 -> j1947412635;
	j1411243414 [label="Everything can be killed. Even the Indifference. Somehow.",shape=box,color=red];
		j1411243414 -> j1886478789;
	j205737416 [label="We might not be able to kill it, but that doesn't mean we can't stop it.",shape=box,color=red];
		j205737416 -> j3366655510;
	j2127443513 [label="Yes. I believe so.",shape=box,color=red];
		j2127443513 -> j225198368;
	j2752602915 [label="I don't know.",shape=box,color=red];
		j2752602915 -> j225198368;
	j2105694069 [label="We simply had a mismatch of shorthand terminology. How amusing.",shape=box,color=blue];
		j2105694069 -> j3376300901;
	j3335747066 [label="There are only two choices before you.  Either you believe this thing can die, and it is therefore not a \"god,\"",shape=box,color=blue];
		j3335747066 -> j2100011938;
	j2883446565 [label="If none of us can know if a \"god\" can die, and this Indifference is one of them, then why do we bother to fight it at all?",shape=box,color=blue];
		j2883446565 -> j3335747066;
	j208922016 [label="Void on high I think I am dealing with an idiot.",shape=box,color=blue];
		j208922016 -> j3335747066;
	j1947412635 [label="Boolean DrifterMITWKillMaybe is now true.",color=orange];
		j1947412635 -> j2324999473;
	j1886478789 [label="Boolean DrifterMITWKill is now true.",color=orange];
		j1886478789 -> j1660760924;
	j3366655510 [label="Boolean DrifterMITWStop is now true.",color=orange];
		j3366655510 -> j2603854956;
	j225198368 [label="Enough of this going about in circles. Allow me to simply cut to the chase: Can a \"god\", by any means, cease to exist?",shape=box,color=blue];
		j225198368 -> j80786278;
	j3376300901 [label="I suppose \"dreadful eldritch horror from beyond our comprehension\" is far too many syllables to banter about, to be fair. Allow me to cut to the chase, then:",shape=box,color=blue];
		j3376300901 -> j80786278;
	j2100011938 [label="Or you believe it cannot be defeated, and it does not matter what you want to call it, for we are merely waiting to for it to consume us all.",shape=box,color=blue];
		j2100011938 -> j2068122483;
	j2324999473 [label="I think I am going to slit my throat with my own tail.",shape=box,color=blue];
		j2324999473 -> j3880301946;
	j1660760924 [label="\"Somehow.\"",shape=box,color=blue];
		j1660760924 -> j2414525117;
	j2603854956 [label="+5 Chemistry",color=orange];
		j2603854956 -> j2042257443;
	j2068122483 [label="I have wielded all my best arguments on you, and I have begun to fear they are all for naught. So I shall simply ask you one last time, and I shall pray that sanity shall prevail.",shape=box,color=blue];
		j2068122483 -> j4050875503;
	j3880301946 [label="No wonder the butler always looks so exhausted. He is always dealing with you.",shape=box,color=blue];
		j3880301946 -> "Chat ends.";
	j2414525117 [label="I do hope you are as good at concocting solutions \"on the fly\" as the others say you are.",shape=box,color=blue];
		j2414525117 -> j1209491111;
	j2042257443 [label="Hm. Because stuffing its fingers in a jar and then replicating them has gone so well.",shape=box,color=blue];
		j2042257443 -> j693551018;
	j4050875503 [label="And I beg you to remember all that I have said to you.",shape=box,color=blue];
		j4050875503 -> j2970612246;
