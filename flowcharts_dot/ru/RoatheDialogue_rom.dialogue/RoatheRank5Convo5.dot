		j4224182894 -> "Chat ends." [label="false",color=purple];
	"Chat ends." [color=orange];
	j3060448194 [label="Были ли у тебя дополнительные мысли по поводу моего аргумента о твоём «Безразличии»?",shape=box,color=blue];
		j3060448194 -> j330706913;
		j3060448194 -> j539464385;
		j3060448194 -> j100382058;
		j3060448194 -> j2220064801;
	j330706913 [label="Да. Мне кажется, то, что Энтрати выпустил из Бездны, было бесформенным богом, пребывавшее в эфире задолго до того, как мы появились.",shape=box,color=red];
		j330706913 -> j3616742302;
	j539464385 [label="Да. И я думаю, что ты несёшь полную чушь.",shape=box,color=red];
		j539464385 -> j4099310853;
	j100382058 [label="Да. Похоже, это верно. Не думаю, что нечто подобное существовало до взаимодействия с Энтрати. Он стремился найти божество... и Бездна выдала нечто, что лишь изображает его.",shape=box,color=red];
		j100382058 -> j835516038;
	j2220064801 [label="Да. Думаю, ответ где-то между. Раньше это, возможно, не обладало природой божества, но теперь обладает. Похоже, появление произошло в тот момент, когда Энтрати раскрыл Бездну.",shape=box,color=red];
		j2220064801 -> j3982622989;
	j3616742302 [label="Просто невозможно понять, чем мы являемся. ",shape=box,color=red];
		j3616742302 -> j1311916327;
	j4099310853 [label="Check boolean RoatheDating",color=orange];
		j4099310853 -> j3183595588 [label=true,color=green];
		j4099310853 -> j3363070009 [label=false,color=brown];
	j835516038 [label="И с тех пор мы питаем страхом.",shape=box,color=red];
		j835516038 -> j573239974;
	j3982622989 [label="Так же как Рэлл теперь одновременно существует и не существует, Безразличие никогда не было богом, но теперь словно всегда им являлось.",shape=box,color=red];
		j3982622989 -> j1309090209;
	j1311916327 [label="Могу ли я убедить тебя ещё раз рассмотреть мою позицию? Или отношение к теме уже окончательно сформировано?",shape=box,color=blue];
		j1311916327 -> j2941894388;
		j1311916327 -> j198810393;
	j3183595588 [label="Не предполагалось, что у тебя может быть такая хрупкая чувствительность, Скиталец. Но, как выразились бы фанатики: «c'est la vie».",shape=box,color=blue];
		j3183595588 -> j650387292;
	j3363070009 [label="Как сказали бы фанатики: «c'est la vie».",shape=box,color=blue];
		j3363070009 -> "Chat ends.";
	j573239974 [label="Boolean DrifterMITWNotGod is now true.",color=orange];
		j573239974 -> j986753691;
	j1309090209 [label="Трудно переносить сторонников Этернализма. У них это служит оправданием абсолютно всему. Стоит Архимедиан решить, что понимание достигнуто, и дальше процесс становится неконтролируемым.",shape=box,color=blue];
		j1309090209 -> j300864346;
	j2941894388 [label="Можно попробовать.",shape=box,color=red];
		j2941894388 -> j3999032193;
	j198810393 [label="Нет смысла.",shape=box,color=red];
		j198810393 -> j3363070009;
	j650387292 [label="Boolean RoatheNoDate is now true.",color=orange];
		j650387292 -> j776748929;
	j986753691 [label="+5 Chemistry",color=orange];
		j986753691 -> j4095028167;
	j300864346 [label="«Растение не осталось без полива, оно лишь переживает другую параллельную ветвь Этернализма.»",shape=box,color=blue];
		j300864346 -> j2871227025;
	j3999032193 [label="Хотя сегодня ты не звучишь особенно философски, я всё же попробую.",shape=box,color=blue];
		j3999032193 -> j1550169957;
	j776748929 [label="Boolean RoatheDating is now false.",color=orange];
		j776748929 -> j178902881;
	j4095028167 [label="Великолепно! Наконец-то есть прогресс. Трубите в трубы, звоните в колокола, кто-то наконец-то начал мыслить здраво!",shape=box,color=blue];
		j4095028167 -> j4290145;
	j2871227025 [label="Это заставляет меня кричать. Можно ли хоть однажды проявить решительность в этих ничтожных жизнях?!",shape=box,color=blue];
		j2871227025 -> j1705603848;
		j2871227025 -> j3609589561;
	j1550169957 [label="Не то чтобы у меня было занятие получше для моего времени.",shape=box,color=blue];
		j1550169957 -> j65063503;
	j178902881 [label="Boolean IsDating is now false.",color=orange];
		j178902881 -> "Chat ends.";
	j4290145 [label="Check boolean RoatheDating",color=orange];
		j4290145 -> j2083961172 [label=true,color=green];
		j4290145 -> j932299432 [label=false,color=brown];
	j1705603848 [label="Раньше божественной сущности не наблюдалось, теперь же она есть.",shape=box,color=red];
		j1705603848 -> j700420222;
	j3609589561 [label="Неважно.",shape=box,color=red];
		j3609589561 -> j1760665808;
	j65063503 [label="Предлагаю начать с основ. Как бы можно было определить понятие «бог»?",shape=box,color=blue];
		j65063503 -> j1231514987;
		j65063503 -> j203679527;
		j65063503 -> j2151027676;
	j2083961172 [label="Хотя сомнений в том, шаг будет сделан, у меня и не было, сокровище Скиталец. Разборчивый вкус уже был продемонстрирован.",shape=box,color=blue];
		j2083961172 -> j629465391;
	j932299432 [label="Хотя сомнений в том, что решение придёт к этому, у меня не было, Скиталец. Умение убеждать у меня весьма развито. ",shape=box,color=blue];
		j932299432 -> j629465391;
	j700420222 [label="Понятно. Из Бездны Альбрехт сформировал некое «божество». И теперь у нас на свободе «бог». Прелесть какая.",shape=box,color=blue];
		j700420222 -> j318331640;
		j700420222 -> j832410218;
	j1760665808 [label="Именно.",shape=box,color=blue];
		j1760665808 -> "Chat ends.";
	j1231514987 [label="Высшее существо. То, что обладает полной и неоспоримой властью или силой. ",shape=box,color=red];
		j1231514987 -> j1742975837;
	j203679527 [label="Сверхчеловеческая сущность или создание, обладающее властью над определённым аспектом творения или человеческой судьбы.",shape=box,color=red];
		j203679527 -> j170183661;
	j2151027676 [label="Трудно сказать. Можешь начать.",shape=box,color=red];
		j2151027676 -> j1568265888;
	j629465391 [label="Теперь бы только найти способ убедить всех остальных лунатиков в этом приюте...",shape=box,color=blue];
		j629465391 -> j1508278538;
		j629465391 -> j880700268;
	j318331640 [label="Да, всё так.",shape=box,color=red];
		j318331640 -> j1909553116;
	j832410218 [label="Да, но кажется, мы застряли на том, как каждый из нас определяет понятие «бог».",shape=box,color=red];
		j832410218 -> j1190710505;
	j1742975837 [label="И выходит, по твоему, Безразличие можно отнести к разряду подобных высших сущностей?",shape=box,color=blue];
		j1742975837 -> j765536930;
		j1742975837 -> j2767667781;
	j170183661 [label="И это твоё Безразличие считается высшей сущностью или созданием? И оно обладает властью над аспектом... Безразличия. Равнодушия?",shape=box,color=blue];
		j170183661 -> j2767667781;
		j170183661 -> j765536930;
	j1568265888 [label="Ну и кто теперь трус? Очень хорошо. Позволь упростить ситуацию и перейти сразу к сути:",shape=box,color=blue];
		j1568265888 -> j383514545;
	j1508278538 [label="Чего я не понимаю, так это того, какую пользу это нам даёт?",shape=box,color=red];
		j1508278538 -> j2813164462;
	j880700268 [label="Зачем вообще утруждаться?",shape=box,color=red];
		j880700268 -> j649437713;
	j1909553116 [label="Тогда позволь упростить ситуацию и перейти прямо к сути: веришь ли ты, что «бог» может умереть?",shape=box,color=blue];
		j1909553116 -> j1103214219;
	j1190710505 [label="Разумное замечание. Как бы следовало понимать слово «бог»?",shape=box,color=blue];
		j1190710505 -> j627075909;
		j1190710505 -> j2546498834;
		j1190710505 -> j3669689017;
	j765536930 [label="Не могу сказать.",shape=box,color=red];
		j765536930 -> j1686099928;
	j2767667781 [label="Да. Думаю, что так.",shape=box,color=red];
		j2767667781 -> j3323216182;
	j383514545 [label="Ты считаешь, что «бог» может умереть?",shape=box,color=blue];
		j383514545 -> j2175053148;
		j383514545 -> j921036404;
		j383514545 -> j4019061474;
		j383514545 -> j33198286;
		j383514545 -> j2993900222;
	j2813164462 [label="Какую же пользу это нам даёт? Всю возможную в мире пользу! Понятно, что ты всегда был тем, кто действует один. Тебе ещё не доводилось ощутить на себе приёмы настоящего войска.",shape=box,color=blue];
		j2813164462 -> j936629017;
	j649437713 [label="Зачем утруждаться? Бедное создание. Всегда приходилось сражаться в одиночку и не было опыта противостоять армейской тактике.",shape=box,color=blue];
		j649437713 -> j936629017;
	j1103214219 [label="Может ли «бог» каким-либо образом перестать существовать?",shape=box,color=blue];
		j1103214219 -> j383514545;
	j627075909 [label="Трудно сказать. Можешь начать.",shape=box,color=red];
		j627075909 -> j730334605;
	j2546498834 [label="Сверхчеловеческая сущность или создание, обладающее властью над определённым аспектом творения или человеческой судьбы.",shape=box,color=red];
		j2546498834 -> j99235066;
	j3669689017 [label="Сущность, которая находится за пределами нашего понимания. Создание, существующее в измерении вне нашего и потому не существующее «как мы».",shape=box,color=red];
		j3669689017 -> j1312447070;
	j1686099928 [label="Хватит ходить вокруг да около. Позволь просто перейти к сути:",shape=box,color=blue];
		j1686099928 -> j383514545;
	j3323216182 [label="Check boolean RoatheDating",color=orange];
		j3323216182 -> j529299566 [label=true,color=green];
		j3323216182 -> j611134168 [label=false,color=brown];
	j2175053148 [label="Надежда состоит в том, чтобы отправить его обратно туда, откуда он пришёл.",shape=box,color=red];
		j2175053148 -> j1682290119;
	j921036404 [label="Не знаю. И не считаю, что кто-то способен это знать.",shape=box,color=red];
		j921036404 -> j118963552;
	j4019061474 [label="Нет. Полагаю, что нет. Материя ведь сохраняется и всё прочее.",shape=box,color=red];
		j4019061474 -> j1910735704;
	j33198286 [label="Да, думаю, что так. Иначе нас бы уже заполонили, не так ли?",shape=box,color=red];
		j33198286 -> j2755421338;
	j2993900222 [label="Искренне на это надеюсь.",shape=box,color=red];
		j2993900222 -> j2643224833;
	j936629017 [label="Знание врага имеет решающее значение. Теперь у меня есть вопрос к тебе. Ты считаешь, что это создание можно убить?",shape=box,color=blue];
		j936629017 -> j5519309;
		j936629017 -> j3072886847;
		j936629017 -> j3690959494;
	j730334605 [label="Ну и кто теперь трус? Очень хорошо. Позволь упростить ситуацию и перейти сразу к сути:",shape=box,color=blue];
		j730334605 -> j1103214219;
	j99235066 [label="И это твоё Безразличие считается высшей сущностью или созданием? И оно обладает властью над аспектом... Безразличия. Равнодушия?",shape=box,color=blue];
		j99235066 -> j1715760648;
		j99235066 -> j3470041120;
	j1312447070 [label="Аха-ха, понимаю. Вот в чём затруднение. Да, наши определения не совпадали. Насколько это «Безразличие» действительно является сущностью в том смысле, как ты её описываешь? Да. Здесь мы согласны.",shape=box,color=blue];
		j1312447070 -> j1401306085;
	j529299566 [label="Жаль. Ожидалось больше ясности. Тогда позволь спросить следующее и перейти прямо к главному:",shape=box,color=blue];
		j529299566 -> j383514545;
	j611134168 [label="Разочаровывающе. Но позволь задать вот что и перейти сразу к сути:",shape=box,color=blue];
		j611134168 -> j383514545;
	j1682290119 [label="Миротворцы. Почему всегда должен найтись какой-нибудь миротворец.",shape=box,color=blue];
		j1682290119 -> j1660946693;
	j118963552 [label="Следовательно, ты своим скромным неведением подразумеваешь, что мы все наощупь блуждаем во тьме.",shape=box,color=blue];
		j118963552 -> j2181706660;
	j1910735704 [label="О, прекрасно. Ты считаешь, что «боги» не могут умереть!",shape=box,color=blue];
		j1910735704 -> j1660946693;
	j2755421338 [label="И твоя логика такова... что боги могут умереть, потому что... «боги» похожи на побберов?",shape=box,color=blue];
		j2755421338 -> j2709942698;
	j2643224833 [label="Ну да, это очевидно, но прошу, Скиталец, держись темы. Мне нужно твоё внимание.",shape=box,color=blue];
		j2643224833 -> j2709942698;
	j5519309 [label="Если честно, совершенно не знаю.",shape=box,color=red];
		j5519309 -> j4019278176;
	j3072886847 [label="Убить можно всё. Даже Безразличие. Каким-то образом.",shape=box,color=red];
		j3072886847 -> j2953761697;
	j3690959494 [label="Возможно, мы не можем убить Безразличие, но это не значит, что мы не можем остановить его.",shape=box,color=red];
		j3690959494 -> j2971753211;
	j1715760648 [label="Да. Думаю, что так.",shape=box,color=red];
		j1715760648 -> j571311569;
	j3470041120 [label="Я не знаю.",shape=box,color=red];
		j3470041120 -> j571311569;
	j1401306085 [label="У нас просто вышло несоответствие в сокращённой терминологии. Забавно.",shape=box,color=blue];
		j1401306085 -> j4185962287;
	j1660946693 [label="У тебя всего два возможных вывода. Либо считать, что это существо способно умереть, а значит, не является «богом»,",shape=box,color=blue];
		j1660946693 -> j638874352;
	j2181706660 [label="Если нам не дано знать, может ли «бог» погибнуть, и Безразличие относится к таким сущностям, то зачем мы вообще продолжаем бороться?",shape=box,color=blue];
		j2181706660 -> j1660946693;
	j2709942698 [label="Бездна знает, похоже, приходится иметь дело с полным несмышлёнышем.",shape=box,color=blue];
		j2709942698 -> j1660946693;
	j4019278176 [label="Boolean DrifterMITWKillMaybe is now true.",color=orange];
		j4019278176 -> j1955982111;
	j2953761697 [label="Boolean DrifterMITWKill is now true.",color=orange];
		j2953761697 -> j1662104538;
	j2971753211 [label="Boolean DrifterMITWStop is now true.",color=orange];
		j2971753211 -> j3817322699;
	j571311569 [label="Довольно кружить на одном месте. Позволь сразу сказать главное: способен ли «бог» при любых обстоятельствах прекратить своё существование?",shape=box,color=blue];
		j571311569 -> j383514545;
	j4185962287 [label="Видимо, «зловещный ужас вне нашего понимания» звучит чересчур многословно для спора. Поэтому позволь сразу перейти к главному:",shape=box,color=blue];
		j4185962287 -> j383514545;
	j638874352 [label="Или же ты считаешь, что просто невозможно противостоять, и тогда название не играет роли, потому что остаётся только ждать момента, когда мы все будем поглощены.",shape=box,color=blue];
		j638874352 -> j507016864;
	j1955982111 [label="Кажется, я сейчас перережу себе горло собственным хвостом.",shape=box,color=blue];
		j1955982111 -> j2157142178;
	j1662104538 [label="«Каким-то образом».",shape=box,color=blue];
		j1662104538 -> j3423810842;
	j3817322699 [label="+5 Chemistry",color=orange];
		j3817322699 -> j3862470255;
	j507016864 [label="Все мои основные доводы были приведены и начинаю сомневаться в их пользе. Поэтому я просто задам этот вопрос ещё раз и надеюсь, что здравый смысл всё же возобладает.",shape=box,color=blue];
		j507016864 -> j2597685479;
	j2157142178 [label="Неудивительно, что дворецкий всё время выглядит уставшим. Ему ведь регулярно приходится разбираться с тобой.",shape=box,color=blue];
		j2157142178 -> "Chat ends.";
	j3423810842 [label="Надеюсь, умение находить решения «на ходу» у тебя действительно такое же, как о тебе говорят.",shape=box,color=blue];
		j3423810842 -> j2339198422;
	j3862470255 [label="Хм. Потому что запихивание пальцев в банку и их последующее воспроизведение прошло так хорошо.",shape=box,color=blue];
		j3862470255 -> j99811492;
	j2597685479 [label="И прошу помнить всё, что было сказано.",shape=box,color=blue];
		j2597685479 -> j1925655660;
	j2339198422 [label="В противном случае получается, что мы все полагаемся на некую долю «веры».",shape=box,color=blue];
		j2339198422 -> j4081414586;
	j99811492 [label="Но может быть, это вовсе неплохой вариант.",shape=box,color=blue];
		j99811492 -> j2339198422;
	j1925655660 [label="Является ли Безразличие «богом»?",shape=box,color=blue];
		j1925655660 -> j857705727;
		j1925655660 -> j2900461237;
		j1925655660 -> j2752905045;
		j1925655660 -> j1122087823;
	j4081414586 [label="+5 Chemistry",color=orange];
		j4081414586 -> "Chat ends.";
	j857705727 [label="Безразличие является богом и всегда им было.",shape=box,color=red];
		j857705727 -> j686639944;
