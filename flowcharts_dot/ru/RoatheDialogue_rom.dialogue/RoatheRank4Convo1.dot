	j3652665456 [label="Boolean RoatheTraitor1 is now true.",color=orange];
		j3652665456 -> j3046849143;
		j3652665456 -> j1310452999;
	j2493716820 [label="Ты постоянно называешь меня \"узурпатором\". Это что, оскорбление?",shape=box,color=red];
		j2493716820 -> j1590339450;
	j3724589672 [label="Boolean RoatheUsurper is now true.",color=orange];
		j3724589672 -> j1575251165;
	j3162806553 [label="Я просто хочу сказать, что это звучит довольно лицемерно с твоей стороны, когда ты сам виноват в том же самом.",shape=box,color=red];
		j3162806553 -> j3582839173;
	j3616574037 [label="Я просто пытаюсь понять, почему ты продолжаешь использовать это в качестве заголовка в отношении меня.",shape=box,color=red];
		j3616574037 -> j4219522092;
	j1590339450 [label="Ха! Вряд ли! У тебя большое терпение, если думаешь, что я уже несколько дней так спокойно оскорбляю тебя в лицо. ",shape=box,color=blue];
		j1590339450 -> j2389195802;
	j1575251165 [label="Ну, вот что ты такое, да? Тэнно отняли Изначальную систему у Орокин. А ты, словно птенец кукушки в чужом гнезде, влезаешь в этот мир из своего.",shape=box,color=blue];
		j1575251165 -> j2374737882;
	j3582839173 [label="Ха! Оскорбление? У тебя большое терпение, если думаешь, что я уже несколько дней так спокойно высмеиваю тебя в лицо.",shape=box,color=blue];
		j3582839173 -> j1583718725;
	j4219522092 [label="+5 Chemistry",color=orange];
		j4219522092 -> j581083888;
	j2389195802 [label="Check boolean RoatheKnowsReset2",color=orange];
		j2389195802 -> j1575166802 [label=true,color=green];
		j2389195802 -> j1529040710 [label=false,color=brown];
	j2374737882 [label="И это делает тебя, как минимум по двум причинам, узурпатором в моих глазах. (И, возможно, по третьей, если верить тому, что рассказал мне дворецкий о Дувири, но это спор на другой раз.)",shape=box,color=blue];
		j2374737882 -> j4013219527;
		j2374737882 -> j2200348529;
	j1583718725 [label="Check boolean RoatheKnowsReset2",color=orange];
		j1583718725 -> j1531272474 [label=true,color=green];
		j1583718725 -> j4203792127 [label=false,color=brown];
	j581083888 [label="Потому что это именно титул. Почетное звание. Вы достигли того, к чему я стремился. ",shape=box,color=blue];
		j581083888 -> j3751724258;
	j1575166802 [label="Особенно когда так очевидно, что в этой ситуации, которая отнюдь не является односторонней, у тебя столько власти, не так ли?",shape=box,color=blue];
		j1575166802 -> j3709072999;
	j1529040710 [label="Особенно когда я знаю, что ты можешь просто воспользоваться своими дарованными Бездной силами, чтобы пройти сквозь стену и всадить мне несколько пуль в затылок в любое время, когда пожелаешь.",shape=box,color=blue];
		j1529040710 -> j3709072999;
	j4013219527 [label="Значит... ты меня оскорбляешь.",shape=box,color=red];
		j4013219527 -> j3582839173;
	j2200348529 [label="Ладно. Так зачем же продолжать использовать это в качестве заголовка?",shape=box,color=red];
		j2200348529 -> j4219522092;
	j1531272474 [label="Особенно когда так очевидно, что в этой ситуации, которая отнюдь не является односторонней, у тебя столько власти, не так ли?",shape=box,color=blue];
		j1531272474 -> j3697961938;
	j4203792127 [label="Особенно когда я знаю, что ты можешь просто воспользоваться своими дарованными Бездной силами, чтобы пройти сквозь стену и всадить мне несколько пуль в затылок в любое время, когда пожелаешь.",shape=box,color=blue];
		j4203792127 -> j3697961938;
	j3751724258 [label="Название — всего лишь выражение моего лёгкого восхищения. Даже если оно и звучит несколько саркастично, что вполне соответствует моим желаниям, да, я это признаю.",shape=box,color=blue];
		j3751724258 -> j2664973520;
		j3751724258 -> j1362434817;
		j3751724258 -> j3153484895;
		j3751724258 -> j3223403050;
	j3709072999 [label="Я не в настроении наживать себе врагов, Узурпатор. Нет. Это не оскорбление. Просто из-за твоей собственной невнимательности ты не осознал, насколько моя история совпадает с твоей.",shape=box,color=blue];
		j3709072999 -> j2826023585;
	j3697961938 [label="У меня нет настроения наживать из тебя врагов, Узурпатор. Нет. Скорее, это почетное звание. Ты сделал то, к чему я стремился. И ничего больше.",shape=box,color=blue];
		j3697961938 -> j3751724258;
	j2664973520 [label="Все ли Орокин такие же, как ты?",shape=box,color=red];
		j2664973520 -> j2606841424;
	j1362434817 [label="Если я вежливо попрошу тебя называть меня как-нибудь по-другому, ты согласишься?",shape=box,color=red];
		j1362434817 -> j3844927561;
	j3153484895 [label="Я с этим смирюсь.",shape=box,color=red];
		j3153484895 -> j939983510;
	j3223403050 [label="Перестань называть меня Узурпатором.",shape=box,color=red];
		j3223403050 -> j3083928027;
	j2826023585 [label="Я был полон решимости свергнуть Орокин, как и ваш двойник-Тэнно и им подобные. Меня просто вытеснили из временной линии, прежде чем у меня появился шанс.",shape=box,color=blue];
		j2826023585 -> j1432133320;
	j2606841424 [label="+10 Chemistry",color=orange];
		j2606841424 -> j1755830817;
	j3844927561 [label="+5 Chemistry",color=orange];
		j3844927561 -> j1733589253;
	j939983510 [label="+5 Chemistry",color=orange];
		j939983510 -> j1885419793;
	j3083928027 [label="М-м...",shape=box,color=blue];
		j3083928027 -> j2465997859;
	j1432133320 [label="Boolean RoatheTraitor1 is now true.",color=orange];
		j1432133320 -> j3751724258;
	j1755830817 [label="Ха! Я почти слышал вздох из Санктума. Неужели они все такие же, как я? Нет. Они были намного хуже меня. И, боюсь, гораздо более раздражающими.",shape=box,color=blue];
		j1755830817 -> j3978655206;
	j1733589253 [label="Хм… нет. Но я ценю демонстрацию надлежащего этикета. Ты должен заслужить свои титулы от меня, Узурпатор. Ты же это знаешь.",shape=box,color=blue];
		j1733589253 -> j3978655206;
	j1885419793 [label="Хорошо. В любом случае у тебя не было выбора. ",shape=box,color=blue];
		j1885419793 -> j3978655206;
	j2465997859 [label="Нет.",shape=box,color=blue];
		j2465997859 -> j3978655206;
	j3978655206 [label="+5 Chemistry",color=orange];
		j3978655206 -> j217994096;
	j217994096 [label="Правда, с тобой это становится слишком уж забавно.",shape=box,color=blue];
		j217994096 -> "Chat ends.";
}