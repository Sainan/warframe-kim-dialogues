digraph {
	1781 [label="RoatheRank3Convo3 begins.",color=orange];
		1781 -> 1782;
	1782 [label="Evaluate expressions on HellStory",color=orange];
		1782 -> 1786 [label="x >= 21",color=purple];
		1782 -> 1785 [label="x >= 13",color=purple];
		1782 -> 1784 [label="x < 13 && x > 1",color=purple];
		1782 -> 1783 [label="x == 0",color=purple];
		1782 -> 1783 [label="false",color=purple];
	1786 [label="Это терзает меня день и ночь. Постоянное, гнетущее осознание того, что я не только доверил тебе все свои самые сокровенные тайны, но ты предал это доверие и отнял у меня всё, и теперь я не могу вспомнить, почему...",shape=box,color=blue];
		1786 -> 1793;
	1785 [label="Мы неплохо продвигаемся в переворачивании этих камней в моём разуме. Альбрехт неплохо надо мной поработал, когда ввёл ту сыворотку.",shape=box,color=blue];
		1785 -> 1791;
		1785 -> 1792;
		1785 -> 1790;
	1784 [label="Твой прогресс в помощи мне восстанавливать мои воспоминания замедлился. Если ты ожидаешь выполнить свою часть сделки, я ожидаю, что ты продолжишь работу в «Спуске».",shape=box,color=blue];
		1784 -> 1789;
		1784 -> 1787;
		1784 -> 1788;
		1784 -> 1790;
	1783 [label="Тебе ещё предстоит добиться прогресса в раскрытии моих воспоминаний в «Спуске». Если ты хочешь, чтобы я выполнил свою часть сделки, тебе следует постараться выполнить свою.",shape=box,color=blue];
		1783 -> 1787;
		1783 -> 1788;
		1783 -> 1789;
		1783 -> 1790;
	1793 [label="Check boolean RoatheResetForgiven",color=orange];
		1793 -> 1801 [label=true,color=green];
		1793 -> 1800 [label=false,color=brown];
	1791 [label="Они не кажутся приятными. ",shape=box,color=red];
		1791 -> 1798;
	1792 [label="Они не кажутся приятными. Ты уверен, что нам стоит продолжать?",shape=box,color=red];
		1792 -> 1799;
	1790 [label="[Конец.]",shape=box,color=red];
		1790 -> 1797;
	1789 [label="Честно говоря, у меня с этим были сложности… Я всё время погибаю, как бы ни старался.",shape=box,color=red];
		1789 -> 1796;
	1787 [label="Я не принимаю приказы, Роут.",shape=box,color=red];
		1787 -> 1794;
	1788 [label="У меня не было времени. Я займусь этим.",shape=box,color=red];
		1788 -> 1795;
	1801 [label="Мало того, что я уже простил тебя за то, что ты забрал у меня эти воспоминания...",shape=box,color=blue];
		1801 -> 1807;
	1800 [label="Мало того, что я начинаю прощать тебя за то, что ты лишил меня этих воспоминаний...",shape=box,color=blue];
		1800 -> 1807;
	1798 [label="Нет, не кажутся. А чего ты ожидал от “Дьявола Тау”? Воспоминаний о солнечном дне в парке, когда лежишь на одеяле и ешь виноград с тарелки?",shape=box,color=blue];
		1798 -> 1805;
	1799 [label="Я не узнаю, что он у меня забрал, пока не верну всё обратно. Конечно, мы должны продолжать! Эти воспоминания, мои, Скиталец. Они составляют то, кто я есть, кем я был. Это сама суть моего существа.",shape=box,color=blue];
		1799 -> 1806;
	1797 [label="Chat ends.",color=orange];
	1796 [label="Update boolean RoatheStrugglebus",color=orange];
		1796 -> 1804;
	1794 [label="Нет, не принимаешь. И мне всё равно, чем ты занимаешься в течение дня. Я просто говорю, что если ты хочешь, чтобы этот тощий дворецкий поднялся по этой лестнице, тебе нужно выполнить свою работу.",shape=box,color=blue];
		1794 -> 1802;
	1795 [label="Смотри, чтобы так и было. Мне без разницы, чем ты занимаешься весь день. Я лишь говорю, что если хочешь, чтобы тот тощий маленький дворецкий поднялся по этим ступеням, у тебя есть работа, которую нужно выполнить.",shape=box,color=blue];
		1795 -> 1803;
	1807 [label="Я начинаю ловить себя на том, что хочу снова тебе доверять. Снова! Прекрасно понимая, что ты сделал. Понимая, что ты можешь предать меня снова!",shape=box,color=blue];
		1807 -> 1815;
	1805 [label="Мой бедный Узурпатор, боюсь, что всё, что мы найдём, зарытое в глубинах моего разума, будет лишь кровью, жестокостью и провалом.",shape=box,color=blue];
		1805 -> 1811;
		1805 -> 1812;
	1806 [label="Судя по тому, что я услышал от других о твоём времени в Дувири, ты ведь тоже был похоже поражён, не так ли?",shape=box,color=blue];
		1806 -> 1813;
		1806 -> 1814;
	1804 [label="Я слышу только рассказы о том, как ты победил Нармера. Как победил орды солдат Гринир. Как отражал волну за волной Шёпота на каждом шагу. И всё же мне удалось сбить тебя с толку?",shape=box,color=blue];
		1804 -> 1810;
	1802 [label="Если тебе всё равно? Тогда и мне тоже. У меня есть свои дела.",shape=box,color=blue];
		1802 -> 1808;
	1803 [label="Если тебе всё равно? Тогда и мне тоже. У меня есть свои дела.",shape=box,color=blue];
		1803 -> 1809;
	1815 [label="Но вот я сижу в склепе, поднимаюсь с того стула и думаю: “Интересно, Скиталец рядом? И хочет ли он поговорить?”.",shape=box,color=blue];
		1815 -> 1822;
	1811 [label="Ты управляешь этим кораблём. Если хочешь продолжать вести его прямо в чёрную дыру, полный вперёд.",shape=box,color=red];
		1811 -> 1818;
	1812 [label="Ты уверен, что хочешь продолжать?",shape=box,color=red];
		1812 -> 1819;
	1813 [label="Мы очень разные люди, Роут.",shape=box,color=red];
		1813 -> 1820;
	1814 [label="Да, поражён. Память и апатия. Я всё ещё не могу вспомнить… целые куски времени там.",shape=box,color=red];
		1814 -> 1821;
	1810 [label="+20 Chemistry",color=orange];
		1810 -> 1817;
	1808 [label="Chat ends.",color=orange];
	1809 [label="+10 Chemistry",color=orange];
		1809 -> 1816;
	1822 [label="Насколько это жалко? Насколько низко я пал? Я?! Орокин?! Роут! Дьявол Тау! Так беспокойно, так истощён интеллектом, так отчаянно нуждаюсь в любой стимуляции, что я здесь, разговариваю с тобой!",shape=box,color=blue];
		1822 -> 1831;
		1822 -> 1830;
		1822 -> 1829;
		1822 -> 1828;
	1818 [label="+10 Chemistry",color=orange];
		1818 -> 1824;
	1819 [label="Я не узнаю, что он у меня забрал, пока не верну всё обратно. Конечно, мы должны продолжать! Эти воспоминания, мои, Скиталец. Они составляют то, кто я есть, кем я был. Это сама суть моего существа.",shape=box,color=blue];
		1819 -> 1825;
		1819 -> 1826;
	1820 [label="Возможно, но я имел в виду совсем не это. Ты избегаешь признания этого. Хорошо. Если бы теоретически ты потерял память, стал бы ты пытаться её восстановить, если бы мог?",shape=box,color=blue];
		1820 -> 1825;
		1820 -> 1826;
	1821 [label="Если бы у тебя была возможность вернуть утраченные воспоминания, ты бы это сделал?",shape=box,color=blue];
		1821 -> 1827;
		1821 -> 1825;
		1821 -> 1826;
	1817 [label="Если предположить, что ты не лжёшь мне? Должен признать, это довольно лестно. Очаровательно. Чрезвычайно печально. Но лестно.",shape=box,color=blue];
		1817 -> 1823;
	1816 [label="Chat ends.",color=orange];
	1831 [label="Я с нетерпением жду наших разговоров, независимо от того, ждёшь ли их ты.",shape=box,color=red];
		1831 -> 1838;
	1830 [label="Я постараюсь не принимать это на свой счет.",shape=box,color=red];
		1830 -> 1837;
	1829 [label="Или… тебе просто нравится говорить со мной?",shape=box,color=red];
		1829 -> 1836;
	1828 [label="[Конец.]",shape=box,color=red];
		1828 -> 1835;
	1824 [label="Хорошо сказано, Скиталец. Я не осознаю масштаба того, что у меня отняли, пока не верну всё обратно. Эти воспоминания составляют то, кем я являюсь, кем я был. Они – сама суть моего существования.",shape=box,color=blue];
		1824 -> 1827;
		1824 -> 1825;
		1824 -> 1826;
	1825 [label="Я считаю, лучше знать, чем не знать, но… мы должны быть к этому готовы.",shape=box,color=red];
		1825 -> 1832;
	1826 [label="Иногда мне кажется, что некоторые вещи лучше оставлять погребёнными по какой-то причине.",shape=box,color=red];
		1826 -> 1833;
	1827 [label="It's yours. It's time for us to go get it. How bad could it be? You're an Orokin, you've done worse things, certainly.",shape=box,color=red];
		1827 -> 1834;
	1823 [label="Chat ends.",color=orange];
	1838 [label="Тогда я ужасно рад, что не превратился в пускающего слюни идиота, когда ты ковырялась у меня в черепе вилкой.",shape=box,color=blue];
		1838 -> 1842;
	1837 [label="Может, тебе и стоит это сделать. Ведь это ты ковырялся в моём черепе вилкой.",shape=box,color=blue];
		1837 -> 1842;
	1836 [label="Возможно, и мне бы понравилось, если бы я не знал, что ты ковырялся у меня в черепе вилкой.",shape=box,color=blue];
		1836 -> 1842;
	1835 [label="Chat ends.",color=orange];
	1832 [label="Готовы, как именно? Неужели ты веришь, что я рухну, как карточный домик, когда узнаю ужасную правду о каком-то чудовищном военном преступлении?",shape=box,color=blue];
		1832 -> 1839;
	1833 [label="Разве мы тогда не обречены повторять свои прежние ошибки? Никогда не учась, никогда не развиваясь, вечно живя в блаженном неведении о своём прошлом «я»?",shape=box,color=blue];
		1833 -> 1840;
	1834 [label="+10 Chemistry",color=orange];
		1834 -> 1841;
	1842 [label="Check boolean RoatheResetForgiven",color=orange];
		1842 -> 1846 [label=true,color=green];
		1842 -> 1847 [label=false,color=brown];
	1839 [label="Поверь, я могу представить себе всё, что угодно из того, что я мог сотворить с Владеющими Разумом, Орокин или любой их комбинацией, и мало что способно меня шокировать или ужаснуть.",shape=box,color=blue];
		1839 -> 1843;
	1840 [label="Хм. Я понимаю, что, возможно, я только что выступил против собственного аргумента большинства людей.",shape=box,color=blue];
		1840 -> 1844;
	1841 [label="Hear, hear! I will hardly collapse like some feeble house of cards once I learn the terrible truth of some grotesque war crime.",shape=box,color=blue];
		1841 -> 1845;
	1846 [label="Я сказал, что простил тебя. И я стараюсь сдержать обещание. Просто слова иногда не делают вещи реальностью. Теоретически, прощать кого-то – это хорошо, но иногда эмоциям трудно следовать за фактами.",shape=box,color=blue];
		1846 -> 1851;
		1846 -> 1852;
	1847 [label="Честно говоря, всё это ужасно раздражает. Я хочу разговаривать с тобой. Но я также хочу придушить тебя за то, что ты осквернил мою голову.",shape=box,color=blue];
		1847 -> 1853;
		1847 -> 1854;
	1843 [label="Add 1 to Thermostat",color=orange];
		1843 -> 1848;
	1844 [label="Add -1 to Thermostat",color=orange];
		1844 -> 1849;
	1845 [label="Add -2 to Thermostat",color=orange];
		1845 -> 1850;
	1851 [label="Я понимаю. Это трудно принять: ты вроде бы хочешь, но не можешь.",shape=box,color=red];
		1851 -> 1857;
	1852 [label="Так ты... не прощаешь меня?",shape=box,color=red];
		1852 -> 1857;
	1853 [label="Тебе просто придется смириться с тем, что произошло, и двигаться дальше, Роут.",shape=box,color=red];
		1853 -> 1858;
	1854 [label="Ты думаешь, что сможешь меня когда-нибудь простить?",shape=box,color=red];
		1854 -> 1859;
	1848 [label="Я помню достаточно, чтобы знать, что я мог бы просить «прощения» у алтаря Светил в течение следующих двух тысяч лет, но оно никогда не будет получено. ",shape=box,color=blue];
		1848 -> 1855;
	1849 [label="Я бы предпочёл узнать все факты сам и уже затем оценить ситуацию.",shape=box,color=blue];
		1849 -> 1855;
	1850 [label="Я могу представить себе всё, что угодно из того, что я мог сотворить с Владеющими Разумом, Орокин или любой их комбинацией, и мало что способно меня шокировать или ужаснуть.",shape=box,color=blue];
		1850 -> 1856;
	1857 [label="Я стараюсь изо всех сил, Узурпатор. Ведь в тебе есть что-то, что приковало моё внимание. Ты очарователен. А это редкость в моём мире.",shape=box,color=blue];
		1857 -> 1862;
	1858 [label="Ммхм.",shape=box,color=blue];
		1858 -> 1863;
	1859 [label="Update boolean RoatheResetForgiven",color=orange];
		1859 -> 1857;
	1855 [label="Нет, то, что ждёт меня в глубине души, меня не пугает. Я лишь хочу вернуть то, что у меня несправедливо отняли.",shape=box,color=blue];
		1855 -> 1860;
	1856 [label="Нет, то, что ждёт меня в глубине души, меня не пугает. Я лишь хочу вернуть то, что у меня несправедливо отняли.",shape=box,color=blue];
		1856 -> 1861;
	1862 [label="Так что будь терпеливей, если можешь, пока я пытаюсь все это примирить.",shape=box,color=blue];
		1862 -> 1866;
		1862 -> 1867;
	1863 [label="Chat ends.",color=orange];
	1860 [label="+10 Chemistry",color=orange];
		1860 -> 1864;
	1861 [label="Как ты и сказал. Пора нам вернуть то, что принадлежит мне.",shape=box,color=blue];
		1861 -> 1865;
	1866 [label="Хорошо.",shape=box,color=red];
		1866 -> 1869;
	1867 [label="Это я должен просить тебя о терпении, Роут. А не наоборот.",shape=box,color=red];
		1867 -> 1870;
	1864 [label="Но, тем не менее, я ценю твою заботу.",shape=box,color=blue];
		1864 -> 1868;
	1865 [label="Chat ends.",color=orange];
	1869 [label="Как мило с твоей стороны.",shape=box,color=blue];
		1869 -> 1871;
	1870 [label="+20 Chemistry",color=orange];
		1870 -> 1872;
	1868 [label="Chat ends.",color=orange];
	1871 [label="+5 Chemistry",color=orange];
		1871 -> 1873;
	1872 [label="Ценю это признание.",shape=box,color=blue];
		1872 -> 1874;
