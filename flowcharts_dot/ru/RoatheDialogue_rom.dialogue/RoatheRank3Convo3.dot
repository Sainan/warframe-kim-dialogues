	node [fontname="Roboto Condensed"];
	edge [fontname="Roboto Condensed"];

	"RoatheRank3Convo3 begins." [color=orange];
		"RoatheRank3Convo3 begins." -> j3791167673;
	j3791167673 [label="Evaluate expressions on HellStory counter",color=orange];
		j3791167673 -> j3144494462 [label="x >= 21",color=purple];
		j3791167673 -> j4143274746 [label="x >= 13",color=purple];
		j3791167673 -> j2848737980 [label="x < 13 && x > 1",color=purple];
		j3791167673 -> j883291958 [label="x == 0",color=purple];
		j3791167673 -> j883291958 [label="false",color=purple];
	j3144494462 [label="Это терзает меня день и ночь. Постоянное, гнетущее осознание того, что я не только доверил тебе все свои самые сокровенные тайны, но ты предал это доверие и отнял у меня всё, и теперь я не могу вспомнить, почему...",shape=box,color=blue];
		j3144494462 -> j1787026705;
	j4143274746 [label="Мы неплохо продвигаемся в переворачивании этих камней в моём разуме. Альбрехт неплохо надо мной поработал, когда ввёл ту сыворотку.",shape=box,color=blue];
		j4143274746 -> j4009443709;
		j4143274746 -> j1084546433;
		j4143274746 -> j1310452999;
	j2848737980 [label="Твой прогресс в помощи мне восстанавливать мои воспоминания замедлился. Если ты ожидаешь выполнить свою часть сделки, я ожидаю, что ты продолжишь работу в «Спуске».",shape=box,color=blue];
		j2848737980 -> j1387353134;
		j2848737980 -> j2391606398;
		j2848737980 -> j597602786;
		j2848737980 -> j1310452999;
	j883291958 [label="Тебе ещё предстоит добиться прогресса в раскрытии моих воспоминаний в «Спуске». Если ты хочешь, чтобы я выполнил свою часть сделки, тебе следует постараться выполнить свою.",shape=box,color=blue];
		j883291958 -> j2391606398;
		j883291958 -> j597602786;
		j883291958 -> j1387353134;
		j883291958 -> j1310452999;
	j1787026705 [label="Check boolean RoatheResetForgiven",color=orange];
		j1787026705 -> j223505397 [label=true,color=green];
		j1787026705 -> j900564540 [label=false,color=brown];
	j4009443709 [label="Они не кажутся приятными. ",shape=box,color=red];
		j4009443709 -> j417161568;
	j1084546433 [label="Они не кажутся приятными. Ты уверен, что нам стоит продолжать?",shape=box,color=red];
		j1084546433 -> j2389892734;
	j1310452999 [label="[Конец.]",shape=box,color=red];
		j1310452999 -> "Chat ends.";
	j1387353134 [label="Честно говоря, у меня с этим были сложности… Я всё время погибаю, как бы ни старался.",shape=box,color=red];
		j1387353134 -> j3347591359;
	j2391606398 [label="Я не принимаю приказы, Роут.",shape=box,color=red];
		j2391606398 -> j762686640;
	j597602786 [label="У меня не было времени. Я займусь этим.",shape=box,color=red];
		j597602786 -> j2144707161;
	j223505397 [label="Мало того, что я уже простил тебя за то, что ты забрал у меня эти воспоминания...",shape=box,color=blue];
		j223505397 -> j1580394287;
	j900564540 [label="Мало того, что я начинаю прощать тебя за то, что ты лишил меня этих воспоминаний...",shape=box,color=blue];
		j900564540 -> j1580394287;
	j417161568 [label="Нет, не кажутся. А чего ты ожидал от “Дьявола Тау”? Воспоминаний о солнечном дне в парке, когда лежишь на одеяле и ешь виноград с тарелки?",shape=box,color=blue];
		j417161568 -> j4251077125;
	j2389892734 [label="Я не узнаю, что он у меня забрал, пока не верну всё обратно. Конечно, мы должны продолжать! Эти воспоминания, мои, Скиталец. Они составляют то, кто я есть, кем я был. Это сама суть моего существа.",shape=box,color=blue];
		j2389892734 -> j97466496;
	"Chat ends." [color=orange];
	j3347591359 [label="Boolean RoatheStrugglebus is now true.",color=orange];
		j3347591359 -> j3120016567;
	j762686640 [label="Нет, не принимаешь. И мне всё равно, чем ты занимаешься в течение дня. Я просто говорю, что если ты хочешь, чтобы этот тощий дворецкий поднялся по этой лестнице, тебе нужно выполнить свою работу.",shape=box,color=blue];
		j762686640 -> j2753012455;
	j2144707161 [label="Смотри, чтобы так и было. Мне без разницы, чем ты занимаешься весь день. Я лишь говорю, что если хочешь, чтобы тот тощий маленький дворецкий поднялся по этим ступеням, у тебя есть работа, которую нужно выполнить.",shape=box,color=blue];
		j2144707161 -> j1783191314;
	j1580394287 [label="Я начинаю ловить себя на том, что хочу снова тебе доверять. Снова! Прекрасно понимая, что ты сделал. Понимая, что ты можешь предать меня снова!",shape=box,color=blue];
		j1580394287 -> j4251262005;
	j4251077125 [label="Мой бедный Узурпатор, боюсь, что всё, что мы найдём, зарытое в глубинах моего разума, будет лишь кровью, жестокостью и провалом.",shape=box,color=blue];
		j4251077125 -> j3948491785;
		j4251077125 -> j1838037172;
	j97466496 [label="Судя по тому, что я услышал от других о твоём времени в Дувири, ты ведь тоже был похоже поражён, не так ли?",shape=box,color=blue];
		j97466496 -> j178030837;
		j97466496 -> j172430989;
	j3120016567 [label="Я слышу только рассказы о том, как ты победил Нармера. Как победил орды солдат Гринир. Как отражал волну за волной Шёпота на каждом шагу. И всё же мне удалось сбить тебя с толку?",shape=box,color=blue];
		j3120016567 -> j2789505293;
	j2753012455 [label="Если тебе всё равно? Тогда и мне тоже. У меня есть свои дела.",shape=box,color=blue];
		j2753012455 -> "Chat ends.";
	j1783191314 [label="Если тебе всё равно? Тогда и мне тоже. У меня есть свои дела.",shape=box,color=blue];
		j1783191314 -> j1933300832;
	j4251262005 [label="Но вот я сижу в склепе, поднимаюсь с того стула и думаю: “Интересно, Скиталец рядом? И хочет ли он поговорить?”.",shape=box,color=blue];
		j4251262005 -> j3399884228;
	j3948491785 [label="Ты управляешь этим кораблём. Если хочешь продолжать вести его прямо в чёрную дыру, полный вперёд.",shape=box,color=red];
		j3948491785 -> j3612571697;
	j1838037172 [label="Ты уверен, что хочешь продолжать?",shape=box,color=red];
		j1838037172 -> j1972182883;
	j178030837 [label="Мы очень разные люди, Роут.",shape=box,color=red];
		j178030837 -> j3223422203;
	j172430989 [label="Да, поражён. Память и апатия. Я всё ещё не могу вспомнить… целые куски времени там.",shape=box,color=red];
		j172430989 -> j366508832;
	j2789505293 [label="+20 Chemistry",color=orange];
		j2789505293 -> j3747023965;
	j1933300832 [label="+10 Chemistry",color=orange];
		j1933300832 -> "Chat ends.";
	j3399884228 [label="Насколько это жалко? Насколько низко я пал? Я?! Орокин?! Роут! Дьявол Тау! Так беспокойно, так истощён интеллектом, так отчаянно нуждаюсь в любой стимуляции, что я здесь, разговариваю с тобой!",shape=box,color=blue];
		j3399884228 -> j189801880;
		j3399884228 -> j622316542;
		j3399884228 -> j4124179302;
		j3399884228 -> j1310452999;
	j3612571697 [label="+10 Chemistry",color=orange];
		j3612571697 -> j3898491795;
	j1972182883 [label="Я не узнаю, что он у меня забрал, пока не верну всё обратно. Конечно, мы должны продолжать! Эти воспоминания, мои, Скиталец. Они составляют то, кто я есть, кем я был. Это сама суть моего существа.",shape=box,color=blue];
		j1972182883 -> j3411053103;
		j1972182883 -> j1229084964;
	j3223422203 [label="Возможно, но я имел в виду совсем не это. Ты избегаешь признания этого. Хорошо. Если бы теоретически ты потерял память, стал бы ты пытаться её восстановить, если бы мог?",shape=box,color=blue];
		j3223422203 -> j3411053103;
		j3223422203 -> j1229084964;
	j366508832 [label="Если бы у тебя была возможность вернуть утраченные воспоминания, ты бы это сделал?",shape=box,color=blue];
		j366508832 -> j3411053103;
		j366508832 -> j1229084964;
		j366508832 -> j856404748;
	j3747023965 [label="Если предположить, что ты не лжёшь мне… Должен признать, это довольно лестно. Очаровательно. Чрезвычайно печально. Но лестно.",shape=box,color=blue];
		j3747023965 -> "Chat ends.";
	j189801880 [label="Я с нетерпением жду наших разговоров, независимо от того, ждёшь ли их ты.",shape=box,color=red];
		j189801880 -> j2036043158;
	j622316542 [label="Я постараюсь не принимать это на свой счет.",shape=box,color=red];
		j622316542 -> j3340628270;
	j4124179302 [label="Или… тебе просто нравится говорить со мной?",shape=box,color=red];
		j4124179302 -> j3899092539;
	j3898491795 [label="Хорошо сказано, Скиталец. Я не осознаю масштаба того, что у меня отняли, пока не верну всё обратно. Эти воспоминания составляют то, кем я являюсь, кем я был. Они — сама суть моего существования.",shape=box,color=blue];
		j3898491795 -> j3411053103;
		j3898491795 -> j1229084964;
		j3898491795 -> j4196912290;
	j3411053103 [label="Я считаю, лучше знать, чем не знать, но… мы должны быть к этому готовы.",shape=box,color=red];
		j3411053103 -> j783644792;
	j1229084964 [label="Иногда мне кажется, что некоторые вещи лучше оставлять погребёнными по какой-то причине.",shape=box,color=red];
		j1229084964 -> j4026349972;
	j856404748 [label="Это правда. Пора нам забрать это. Что может произойти страшное? Ты же Орокин, ты, конечно, совершал нечто и пострашнее.",shape=box,color=red];
		j856404748 -> j4166868378;
	j2036043158 [label="Тогда я ужасно рад, что не превратился в пускающего слюни идиота, когда ты ковырялась у меня в черепе вилкой.",shape=box,color=blue];
		j2036043158 -> j3284677091;
	j3340628270 [label="Может, тебе и стоит это сделать. Ведь это ты ковырялся в моём черепе вилкой.",shape=box,color=blue];
		j3340628270 -> j3284677091;
	j3899092539 [label="Возможно, и мне бы понравилось, если бы я не знал, что ты ковырялся у меня в черепе вилкой.",shape=box,color=blue];
		j3899092539 -> j3284677091;
	j4196912290 [label="Это теперь твоё, забирай. Насколько всё плохо? Ты же Орокин, ты, конечно, делали вещи и похуже.",shape=box,color=red];
		j4196912290 -> j4166868378;
	j783644792 [label="Готовы, как именно? Неужели ты веришь, что я рухну, как карточный домик, когда узнаю ужасную правду о каком-то чудовищном военном преступлении?",shape=box,color=blue];
		j783644792 -> j4272662423;
	j4026349972 [label="Разве мы тогда не обречены повторять свои прежние ошибки? Никогда не учась, никогда не развиваясь, вечно живя в блаженном неведении о своём прошлом «я»?",shape=box,color=blue];
		j4026349972 -> j604574120;
	j4166868378 [label="+10 Chemistry",color=orange];
		j4166868378 -> j2054962617;
	j3284677091 [label="Check boolean RoatheResetForgiven",color=orange];
		j3284677091 -> j1905291755 [label=true,color=green];
		j3284677091 -> j997992464 [label=false,color=brown];
	j4272662423 [label="Поверь, я могу представить себе всё, что угодно из того, что я мог сотворить с Владеющими Разумом, Орокин или любой их комбинацией, и мало что способно меня шокировать или ужаснуть.",shape=box,color=blue];
		j4272662423 -> j1893007875;
	j604574120 [label="Хм. Я понимаю, что, возможно, я только что выступил против собственного аргумента большинства людей.",shape=box,color=blue];
		j604574120 -> j2417326966;
	j2054962617 [label="Вот, вот! Я вряд ли рухну, как карточный домик, когда узнаю ужасную правду о каком-нибудь чудовищном военном преступлении.",shape=box,color=blue];
		j2054962617 -> j2713627099;
	j1905291755 [label="Я сказал, что простил тебя. И я стараюсь сдержать обещание. Просто слова иногда не делают вещи реальностью. Теоретически, прощать кого-то – это хорошо, но иногда эмоциям трудно следовать за фактами.",shape=box,color=blue];
		j1905291755 -> j3247349701;
		j1905291755 -> j1872875481;
	j997992464 [label="Честно говоря, всё это ужасно раздражает. Я хочу разговаривать с тобой. Но я также хочу придушить тебя за то, что ты осквернил мою голову.",shape=box,color=blue];
		j997992464 -> j2624522104;
		j997992464 -> j2829356912;
	j1893007875 [label="Add 1 to Thermostat counter",color=orange];
		j1893007875 -> j292149914;
	j2417326966 [label="Add -1 to Thermostat counter",color=orange];
		j2417326966 -> j158669914;
	j2713627099 [label="Add -2 to Thermostat counter",color=orange];
		j2713627099 -> j2304622381;
	j3247349701 [label="Я понимаю. Это трудно принять: ты вроде бы хочешь, но не можешь.",shape=box,color=red];
		j3247349701 -> j270537622;
	j1872875481 [label="Так ты... не прощаешь меня?",shape=box,color=red];
		j1872875481 -> j270537622;
	j2624522104 [label="Тебе просто придется смириться с тем, что произошло, и двигаться дальше, Роут.",shape=box,color=red];
		j2624522104 -> j4209307677;
	j2829356912 [label="Ты думаешь, что сможешь меня когда-нибудь простить?",shape=box,color=red];
		j2829356912 -> j1482384608;
	j292149914 [label="Я помню достаточно, чтобы знать, что я мог бы просить «прощения» у алтаря Светил в течение следующих двух тысяч лет, но оно никогда не будет получено. ",shape=box,color=blue];
		j292149914 -> j2713234592;
	j158669914 [label="Я бы предпочёл узнать все факты сам и уже затем оценить ситуацию.",shape=box,color=blue];
		j158669914 -> j2713234592;
	j2304622381 [label="Я могу представить себе всё, что угодно из того, что я мог сотворить с Владеющими Разумом, Орокин или любой их комбинацией, и мало что способно меня шокировать или ужаснуть.",shape=box,color=blue];
		j2304622381 -> j2291832379;
	j270537622 [label="Я стараюсь изо всех сил, Узурпатор. Ведь в тебе есть что-то, что приковало моё внимание. Ты очарователен. А это редкость в моём мире.",shape=box,color=blue];
		j270537622 -> j117456938;
	j4209307677 [label="Ммхм.",shape=box,color=blue];
		j4209307677 -> "Chat ends.";
	j1482384608 [label="Boolean RoatheResetForgiven is now true.",color=orange];
		j1482384608 -> j270537622;
	j2713234592 [label="Нет, то, что ждёт меня в глубине души, меня не пугает. Я лишь хочу вернуть то, что у меня несправедливо отняли.",shape=box,color=blue];
		j2713234592 -> j300017634;
	j2291832379 [label="Нет, то, что ждёт меня в глубине души, меня не пугает. Я лишь хочу вернуть то, что у меня несправедливо отняли.",shape=box,color=blue];
		j2291832379 -> j4213226414;
	j117456938 [label="Так что будь терпеливей, если можешь, пока я пытаюсь все это примирить.",shape=box,color=blue];
		j117456938 -> j3167282848;
		j117456938 -> j3499490404;
	j300017634 [label="+10 Chemistry",color=orange];
		j300017634 -> j808648540;
	j4213226414 [label="Как ты и сказал. Пора нам вернуть то, что принадлежит мне.",shape=box,color=blue];
		j4213226414 -> "Chat ends.";
	j3167282848 [label="Хорошо.",shape=box,color=red];
		j3167282848 -> j286927612;
	j3499490404 [label="Это я должен просить тебя о терпении, Роут. А не наоборот.",shape=box,color=red];
		j3499490404 -> j611382168;
	j808648540 [label="Но, тем не менее, я ценю твою заботу.",shape=box,color=blue];
