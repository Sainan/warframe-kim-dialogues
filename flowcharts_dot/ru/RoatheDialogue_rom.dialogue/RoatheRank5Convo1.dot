	j794767224 [label="I do not know, Drifter darling. And therein lies the greatest problem.",shape=box,color=blue];
		j794767224 -> j2924674344;
	j3932915958 [label="You are not defined by the opinions of those around you. Or what they think of your actions. You are defined only by what you believe of yourself and your choices.",shape=box,color=red];
		j3932915958 -> j27627681;
	j1876703275 [label="You are not defined by your past, Roathe. You are defined by your future. And you still have a future to spend, unlike all the Orokin who died at the Night of the Naga Drums.",shape=box,color=red];
		j1876703275 -> j34068070;
	j2785008753 [label="СНОВА.",shape=box,color=blue];
		j2785008753 -> j4162653135;
	j1372565892 [label="I know what it's like to always try to escape something you feel like you can never be free of. To try to run from something that will always follow you, no matter how far you go.",shape=box,color=red];
		j1372565892 -> j1376784581;
	j825736825 [label="How much of your life have you spent hiding from the real you, Roathe? How much of your life have you spent hiding behind a mask, this facade?",shape=box,color=red];
		j825736825 -> j349461569;
	j2892203771 [label="Evaluate expressions on Thermostat counter",color=orange];
