	j609504670 [label="Твоя суть не определяется твоим прошлым, Роут. Она определяется твоим будущим. И у тебя всё ещё есть будущее, которое можно прожить, в отличие от всех Орокин, погибших в Ночь Барабанов Нага.",shape=box,color=red];
		j609504670 -> j952757230;
	j2591147733 [label="Твою суть не определяет мнения окружающих. Или от того, как они воспринимают твои действия. Тебя определяет только то, что ты сам думаешь о себе и о своем выборе.",shape=box,color=red];
		j2591147733 -> j721099049;
	j1463084206 [label="Поверь. мне.",shape=box,color=red];
		j1463084206 -> j10342517;
	j1454779630 [label="Все эти игры. Танцевать на чужих нитях. Делать то, что от тебя ожидают. Когда это ожидается. Как это ожидается. Вести чужие войны. Вот что тебя разрывает на части.",shape=box,color=red];
		j1454779630 -> j3776409532;
	j3669815785 [label="Я знаю. В этом нет ничего справедливого. Но и в самой жизни нет ничего справедливого, верно? Ты к этому привык. И привык делать так, чтобы всё работало дальше.",shape=box,color=red];
		j3669815785 -> j1454779630;
	j2612775138 [label="Хотелось бы понимать, как тебе помочь. Хотелось бы знать, какие слова здесь сказать. Ощущение такое, будто тебя разрывает между двумя направлениями. Какой путь ты хочешь выбрать?",shape=box,color=red];
		j2612775138 -> j1291985431;
	j3207511405 [label="И я не знаю, как утолить это. Не знаю, получится ли вообще. Я надеялся, что эти разговоры подскажут мне путь, но теперь вижу, что это бесплодно.",shape=box,color=blue];
		j3207511405 -> j29747678;
