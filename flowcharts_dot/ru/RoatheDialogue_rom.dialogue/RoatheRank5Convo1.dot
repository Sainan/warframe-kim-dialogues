		j3473404184 -> j3331892200;
	j385125939 [label="Я чувствую, будто само моё понимание себя, самый фундамент моей сущности треснул и разорвался, как проклятая Луа! Переписано чернилами, которые растекаются. Трус!",shape=box,color=blue];
		j385125939 -> j1641219051;
	j3092029883 [label="И это моё собственное определение себя недавно было полностью переписано. Оно запечатлелось в моей душе чернилами, которые не смываются.",shape=box,color=blue];
		j3092029883 -> j2870324077;
	j3863196918 [label="Ты можешь ненавидеть меня сколько угодно, Роут. Но то, что было сделано мной, то сделано, потому что это и должно было случиться. Ты больше не мог скрываться от этого.",shape=box,color=red];
		j3863196918 -> j2577536411;
	j1179365138 [label="Думай обо мне что угодно. Но я узнаю, что такое спираль, стоит мне лишь увидеть её.",shape=box,color=red];
