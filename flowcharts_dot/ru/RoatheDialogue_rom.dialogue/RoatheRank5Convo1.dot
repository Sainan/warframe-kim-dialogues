		j1331321830 -> j8223591;
		j1331321830 -> j3286815030;
	j1229107054 [label="Мы пролили слишком много крови. Мы убили слишком многих. Мы отняли слишком много жизней. Мы совершили слишком много зла. И всё, что мне остаётся, это делать все возможное, чтобы хоть чем-то возместить хотя бы малую часть содеянного.",shape=box,color=blue];
