	"Chat ends." [color=orange];
	j2963928323 [label="И теперь я помню, душенька Скиталец. Я помню, как отчаянно умолял тебя освободиться от них. И как тобой дана была клятва, что сделаешь это. И она была сдержана.",shape=box,color=blue];
		j2963928323 -> j4224747657;
	j96354619 [label="И теперь я помню, душенька Скиталец. Теперь я помню, о чём просил и в чём тобой мне было отказано. Я просил очистить моё сознание от этих мыслей, и твой ответ был нет. И всё же вот мы здесь. Разве нет?",shape=box,color=blue];
		j96354619 -> j1804806297;
	j1901191185 [label="И теперь я помню. Я помню, как отчаянно умолял тебя освободиться от них. И как тобой дана была клятва, что сделаешь это. И она была сдержана. ",shape=box,color=blue];
		j1901191185 -> j2936887649;
	j835444936 [label="И теперь я помню. Теперь я помню, о чём просил и в чём тобой мне было отказано. Я просил очистить моё сознание от этих мыслей, и твой ответ был нет. И всё же вот мы здесь. Разве нет?",shape=box,color=blue];
		j835444936 -> j3230044047;
	j2116617866 [label="Check boolean RoatheLoved",color=orange];
		j2116617866 -> j1515379396 [label=true,color=green];
		j2116617866 -> j1017138701 [label=false,color=brown];
	j3920616854 [label="Check boolean RoatheLoved",color=orange];
		j3920616854 -> j1515379396 [label=true,color=green];
		j3920616854 -> j2972712690 [label=false,color=brown];
	j2504104859 [label="Тобой было дано мне слово. Твоё слово! А теперь я вижу, что в тебе нет ничего, кроме как лжи!",shape=box,color=blue];
		j2504104859 -> j1512168784;
		j2504104859 -> j1335716702;
	j280731256 [label="Мне следовало догадаться. Я должен был понимать, что доверять тебе нельзя, порождение Бездны! Тебе было известно, что подстерегало меня там?! Тебе каким-то образом была известна истина тогда, когда и я сам не знал?!",shape=box,color=blue];
		j280731256 -> j1160229056;
		j280731256 -> j1683062953;
	j4224747657 [label="И вот мы снова здесь, там же, откуда начали. Вновь идём по трупам собственного прошлого. Ничуть не лучше, чем мы были прежде.",shape=box,color=blue];
		j4224747657 -> j3045491072;
	j1804806297 [label="По причинам, совершенно несвязанным с моими мольбами, как видно! И всё же я помню ту боль выбора, когда решился принять эту сыворотку.",shape=box,color=blue];
		j1804806297 -> j3045491072;
	j2936887649 [label="И вот мы снова здесь, там же, откуда начали. Вновь идём по трупам собственного прошлого. Ничуть не лучше, чем мы были прежде.",shape=box,color=blue];
		j2936887649 -> j3010294393;
	j3230044047 [label="По причинам, совершенно несвязанным с моими мольбами, как видно! И всё же я помню ту боль выбора, когда решился принять эту сыворотку.",shape=box,color=blue];
		j3230044047 -> j3010294393;
	j1515379396 [label="Тобой однажды были сказаны мне слова, в чью реальность я даже не мог верить. Скажи их ещё раз. Скажи, что это было правдой. Прошу. Мне нужно это сейчас. Сильнее, чем когда-либо.",shape=box,color=blue];
		j1515379396 -> j1792394598;
		j1515379396 -> j1568717190;
	j1017138701 [label="Тобой было дано мне слово. Твоё слово! И так сладко всё это приправлялось тёплыми словами. А теперь я вижу, что в тебе нет ничего, кроме как лжи!",shape=box,color=blue];
		j1017138701 -> j366376912;
		j1017138701 -> j2708643756;
	j2972712690 [label="Тебе было известно? Было известно? И тобой был найден путь ко мне, с нашёптыванием тёплых слов, надеясь смягчить удар, который последует?",shape=box,color=blue];
		j2972712690 -> j3581235845;
		j2972712690 -> j2913570204;
	j1512168784 [label="Подожди-ка секунду.",shape=box,color=red];
		j1512168784 -> j1529108167;
	j1335716702 [label="Роут, подожди.",shape=box,color=red];
		j1335716702 -> j1529108167;
	j1160229056 [label="Подожди-ка секунду.",shape=box,color=red];
		j1160229056 -> j3766466146;
	j1683062953 [label="Роут, подожди.",shape=box,color=red];
		j1683062953 -> j3766466146;
	j3045491072 [label="Как же это потешно. До нелепости смешно. Я не могу победить. Мне просто не победить!",shape=box,color=blue];
		j3045491072 -> j3480210413;
	j3010294393 [label="Как же это потешно. До нелепости смешно. Я не могу победить. Мне просто не победить!",shape=box,color=blue];
		j3010294393 -> j1036252404;
	j1792394598 [label="Я... не могу. Прости.",shape=box,color=red];
		j1792394598 -> j2764384339;
	j1568717190 [label="Роут, я люблю тебя.",shape=box,color=red];
		j1568717190 -> j3767762169;
	j366376912 [label="Подожди-ка секунду.",shape=box,color=red];
		j366376912 -> j3690122577;
	j2708643756 [label="Роут, подожди.",shape=box,color=red];
		j2708643756 -> j3690122577;
	j3581235845 [label="Подожди-ка секунду.",shape=box,color=red];
		j3581235845 -> j2335804031;
	j2913570204 [label="Роут, подожди.",shape=box,color=red];
		j2913570204 -> j2335804031;
	j1529108167 [label="Я говорил тебе прекратить своё вторжение в моё сознание, пока не стало слишком поздно. Я говорил остановиться, и всё же... и всё же!",shape=box,color=blue];
		j1529108167 -> j3883909656;
	j3766466146 [label="Тобой было скрыто это от меня только затем, чтобы открыть всё сейчас? Для тебя это было какой-то больной игрой? Подпитывая ту тварь, что пряталась внутри меня, зная, что ко мне придёт?!",shape=box,color=blue];
		j3766466146 -> j429368907;
	j3480210413 [label="Что теперь, сокровище? Что теперь..? Я чувствую, что на грани отчаяния. По крайней мере, раньше меня прикрывало моё унижение!",shape=box,color=blue];
		j3480210413 -> j4137192368;
	j1036252404 [label="Что теперь, Узурпатор? Что теперь..? Я чувствую, что на грани отчаяния. По крайней мере, раньше меня прикрывало моё унижение!",shape=box,color=blue];
		j1036252404 -> j2607992268;
	j2764384339 [label="Я понимаю. Поверь, куда сильнее, чем ты. Я понимаю.",shape=box,color=blue];
		j2764384339 -> j3256111279;
	j3767762169 [label="Я по-настоящему люблю тебя. В любой твоей форме. В любом твоём выборе. Я люблю тебя.",shape=box,color=red];
		j3767762169 -> j579838046;
	j3690122577 [label="Я говорил тебе прекратить своё вторжение в моё сознание, пока не стало слишком поздно. Я говорил остановиться, и всё же... и всё же!",shape=box,color=blue];
		j3690122577 -> j387982681;
	j2335804031 [label="Тобой было скрыто это от меня только затем, чтобы открыть всё сейчас? Для тебя это было какой-то больной игрой? Подпитывая ту тварь, что пряталась внутри меня, зная, что ко мне придёт?!",shape=box,color=blue];
		j2335804031 -> j4163987191;
	j3883909656 [label="Посмотри, к чему всё пришло по твоей вине!",shape=box,color=blue];
		j3883909656 -> j2294019831;
	j429368907 [label="Посмотри, к чему всё пришло по твоей вине!",shape=box,color=blue];
		j429368907 -> j3386704253;
	j4137192368 [label="Ах, я знаю... вот оно. Снова раскручивать эту спираль. Отмотать время вспять. «Начать заново», как ты говоришь, так ведь? Покончить с моей агонией. Запустить всё заново.",shape=box,color=blue];
		j4137192368 -> j1188175033;
		j4137192368 -> j344047835;
		j4137192368 -> j3124542511;
	j2607992268 [label="Ах, я знаю... вот оно. Снова раскручивать эту спираль. Отмотать время вспять. «Начать заново», как ты говоришь, так ведь? Покончить с моей агонией. Запустить всё заново.",shape=box,color=blue];
		j2607992268 -> j3938362366;
		j2607992268 -> j1220079364;
