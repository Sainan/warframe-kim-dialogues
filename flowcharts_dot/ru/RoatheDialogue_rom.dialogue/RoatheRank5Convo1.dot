	j3591399166 [label="Ладно. Я... я сделаю это. Я сотру твою память снова. Даже если вместе с этим исчезнут воспоминания о Мари и Лионе.",shape=box,color=red];
		j3591399166 -> j2297348315;
	j286446775 [label="Я сижу здесь, выброшенный на берег времени, и каждый раз, когда прилив приходит и уходит, ты смываешь всё больше меня. Забирая всё больше и больше того, что я могу предложить...",shape=box,color=blue];
