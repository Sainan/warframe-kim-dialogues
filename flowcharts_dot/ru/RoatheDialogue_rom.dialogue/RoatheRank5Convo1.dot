		j1586357816 -> j2740261035;
	j4226986024 [label="Тогда хорошо. Пусть будет так. Я не попрошу тебя об этом сейчас. Но разве тебе хоть раз доводилось делать это ради собственного удовольствия, из любопытства или чтобы попытаться исправить ошибки, допущенные в отношениях с другими?!",shape=box,color=blue];
