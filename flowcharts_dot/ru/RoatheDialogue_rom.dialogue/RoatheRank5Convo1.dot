	j1101574909 [label="You're letting that anger tear you up inside. You could be using it to help you fight the people who are still destroying this world today. Here. Now.",shape=box,color=red];
		j1101574909 -> j1227076323;
	j4181303452 [label="You're pointing it at yourself. You should be pointing it at the world that is blaming you for doing the best you could to save it from the Orokin Empire.",shape=box,color=red];
