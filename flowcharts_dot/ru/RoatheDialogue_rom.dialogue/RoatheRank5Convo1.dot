	j1247521463 [label="А вообще... я хочу быть таким человеком?",shape=box,color=blue];
		j1247521463 -> j863020305;
	j738122970 [label="Может быть. Скорее всего, ты действительно прав. Но других путей у меня всё равно нет, не так ли? Значит, стоит хотя бы попробовать. По крайней мере, твои слова об утраченной любви исчезнут из моей памяти.",shape=box,color=blue];
		j738122970 -> j1781862811;
	j1944364033 [label="И если всё так, тогда ты просто сможешь сделать это снова. У тебя будто неиссякаемый дар, не так ли?",shape=box,color=blue];
		j1944364033 -> j1781862811;
