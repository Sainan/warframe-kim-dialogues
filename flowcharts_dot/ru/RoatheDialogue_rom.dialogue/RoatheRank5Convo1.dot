	j195665177 [label="Я не знаю, Узурпатор. И в этом и заключается самая большая проблема.",shape=box,color=blue];
		j195665177 -> j98305664;
	j3444877091 [label="Твою суть не определяет мнения окружающих. Или от того, как они воспринимают твои действия. Тебя определяет только то, что ты сам думаешь о себе и о своем выборе.",shape=box,color=red];
		j3444877091 -> j2907149580;
	j3650480600 [label="Твоя суть не определяется твоим прошлым, Роут. Она определяется твоим будущим. И у тебя всё ещё есть будущее, которое можно прожить, в отличие от всех Орокин, погибших в Ночь Барабанов Нага.",shape=box,color=red];
		j3650480600 -> j1975336654;
	j86834419 [label="Когда все воспоминания исчезнут, когда все воспоминания нахлынут обратно, когда всё сгорит и вернётся ко мне...",shape=box,color=blue];
		j86834419 -> j1801850718;
	j4019179961 [label="Когда все воспоминания исчезнут, когда все воспоминания нахлынут обратно, когда всё сгорит и вернётся ко мне...",shape=box,color=blue];
		j4019179961 -> j1383619967;
	j3362154485 [label="I have to forget taking the serum from Entrati. Couple that with the sting of your revoked words of love? I have much pain that I would like to forget... Please.",shape=box,color=blue];
		j3362154485 -> j4221569924;
		j3362154485 -> j1629759968;
		j3362154485 -> j3842593225;
	j3201458561 [label="We have spilt too much blood. We have killed too many. We have stolen too many lives. We have done too much wrong. And it is all I can do to do what I can to make up for what little I can.",shape=box,color=blue];
