	j4213988709 [label="Ты не помнишь?!",shape=box,color=blue];
		j4213988709 -> j4212787;
	j3403849071 [label="Прости?!",shape=box,color=blue];
		j3403849071 -> j2418623719;
	j3132972928 [label="Тогда, возможно, твоя права. Возможно, это действительно не изменит мою сущность. Возможно, эта часть меня никогда не будет изменена. Ни теперь, ни когда-либо потом.",shape=box,color=blue];
