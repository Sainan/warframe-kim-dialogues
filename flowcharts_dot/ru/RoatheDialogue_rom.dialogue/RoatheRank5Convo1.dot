	j3433295879 [label="Всё это безумие, с того момента, как исчезли мои воспоминания, я чувствовал это... царапание. Это разрывание моей груди, моей кожи, будто некий огромный зверь яростно пытается вырваться наружу изнутри меня.",shape=box,color=blue];
