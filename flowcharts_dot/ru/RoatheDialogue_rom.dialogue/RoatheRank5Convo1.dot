		j1275693330 -> j752636401;
	j628714161 [label="И следовательно, наша привязанность ко времени. Сейчас я прошу тебя. Нет, умоляю тебя, воспользуйся им ради меня. Убери от меня эти мысли. Убери от меня эти воспоминания.",shape=box,color=blue];
		j628714161 -> j3751753748;
	j719105915 [label="Тогда хорошо. Пусть будет так. Я не попрошу тебя об этом сейчас. Но разве тебе хоть раз доводилось делать это ради собственного удовольствия, из любопытства или чтобы попытаться исправить ошибки, допущенные в отношениях с другими?!",shape=box,color=blue];
		j719105915 -> j3751753748;
	j2870525448 [label="Этот «новый шанс» в моей жизни. Я уступаю и принимаю твой аргумент. Спасибо, Скиталец, за... удержание меня от этого конкретного края.",shape=box,color=blue];
		j2870525448 -> j2926958140;
	j2579267217 [label="Ты уверен? Просто... ты сообразительный, и у меня такое чувство, что ты всё равно поймешь, что что-то тут не так.",shape=box,color=red];
		j2579267217 -> j2632247539;
	j1630455372 [label="Это воспоминания другого рода, Роут. С ними это не сработает. Они глубоко запрятаны в твоей психике.",shape=box,color=red];
