		j1875618480 -> j458107237;
	j1206867733 [label="Да, я думаю, ты как раз можешь быть своего рода «ценителем» подобных вещей, не так ли? Продолжай.",shape=box,color=blue];
		j1206867733 -> j3029209102;
		j1206867733 -> j2704412245;
	j3060187297 [label="Под воспоминаниями, под оболочкой Орокин, под этой... синей кожей и Заражением, под Уриэлем и этой маской вице-регента Великого Карнуса Роута, которую я ношу...",shape=box,color=blue];
		j3060187297 -> j1706975653;
	j2823160451 [label="Под воспоминаниями, под оболочкой Орокин, под этой... синей кожей и Заражением, под Уриэлем и этой маской вице-регента Великого Карнуса Роута, которую я ношу...",shape=box,color=blue];
		j2823160451 -> j1403214328;
	j665203437 [label="У тебя есть дар. Дар, который способен обращать время вспять. Закручивать его в спираль, если не замыкать в петлю. И это оказывает… интересный эффект на разум протофреймов, учитывая их связь с Заражением и их взаимодействие со временем.",shape=box,color=blue];
		j665203437 -> j2772188778;
	j4068363059 [label="Если ты можешь сказать мне, что твои дары ни разу тобой не были использованы, чтобы играть с разумом тех gротофреймов, которых называешь друзьями и возлюбленными, и можешь сказать это без тени лжи в своей душе?",shape=box,color=blue];
		j4068363059 -> j4010808125;
	j3191291808 [label="Я последний из Орокин. Я коронован среди них, пока кто-нибудь не встанет, чтобы бросить мне вызов. И я буду капитаном во всех собственных делах до того дня, пока моя жизнь не оборвется.",shape=box,color=blue];
		j3191291808 -> j2548815980;
	j3453408039 [label="Я последний из Орокин. Я коронован среди них, пока кто-нибудь не встанет, чтобы бросить мне вызов. И я буду капитаном во всех собственных делах до того дня, пока моя жизнь не оборвется.",shape=box,color=blue];
		j3453408039 -> j4206437651;
	j1964334375 [label="Ты не помнишь?!",shape=box,color=blue];
		j1964334375 -> j3854124807;
