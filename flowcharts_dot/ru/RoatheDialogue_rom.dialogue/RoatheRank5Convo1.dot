	j1564283062 [label="Boolean RoatheFail is now true.",color=orange];
		j1564283062 -> j830896574;
	j2623028973 [label="Но ведь существует решение, правда? В твоей власти помочь мне избавиться от этого... этого страшного мучения в моей голове.",shape=box,color=blue];
		j2623028973 -> j4036929522;
	j1603236643 [label="Ничего больше. Ничего меньше.",shape=box,color=red];
		j1603236643 -> j970632821;
	j513721148 [label="Попробовать простить себя и идти дальше?",shape=box,color=red];
		j513721148 -> j142430035;
	j2541831425 [label="А вообще... я хочу быть таким человеком?",shape=box,color=blue];
		j2541831425 -> j2275555152;
	j1247521463 [label="А вообще... я хочу быть таким человеком?",shape=box,color=blue];
		j1247521463 -> j863020305;
	j738122970 [label="Может быть. Скорее всего, ты действительно прав. Но других путей у меня всё равно нет, не так ли? Значит, стоит хотя бы попробовать. По крайней мере, твои слова об утраченной любви исчезнут из моей памяти.",shape=box,color=blue];
		j738122970 -> j1781862811;
	j1944364033 [label="И если всё так, тогда ты просто сможешь сделать это снова. У тебя будто неиссякаемый дар, не так ли?",shape=box,color=blue];
		j1944364033 -> j1781862811;
	j296288792 [label="Очень вероятно. Я сопоставлю факты и обвиню тебя в том, что ты сделал то, о чём я тебя не просил. Уверен, ты переживёшь этот трудный период.",shape=box,color=blue];
