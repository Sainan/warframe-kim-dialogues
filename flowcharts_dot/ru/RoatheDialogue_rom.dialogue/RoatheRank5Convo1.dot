	j2128603066 [label="Сначала я решил, что это Уриэль. Почему бы и нет? Ещё один разум, ещё одна разбитая, сломленная, покинутая душа. Осуждённая за поступки, которые она не выбирала совершать.",shape=box,color=blue];
