		j383575508 -> j1564283062;
	j1206867733 [label="Да, я думаю, ты как раз можешь быть своего рода «ценителем» подобных вещей, не так ли? Продолжай.",shape=box,color=blue];
		j1206867733 -> j3098693764;
		j1206867733 -> j1258103696;
	j3060187297 [label="Под воспоминаниями, под оболочкой Орокин, под этой... синей кожей и Заражением, под Уриэлем и этой маской вице-регента Великого Карнуса Роута, которую я ношу...",shape=box,color=blue];
		j3060187297 -> j1706975653;
	j2823160451 [label="Под воспоминаниями, под оболочкой Орокин, под этой... синей кожей и Заражением, под Уриэлем и этой маской вице-регента Великого Карнуса Роута, которую я ношу...",shape=box,color=blue];
		j2823160451 -> j1403214328;
	j3100178478 [label="У тебя есть дар. Дар, который способен обращать время вспять. Закручивать его в спираль, если не замыкать в петлю. И это оказывает... интересный эффект на разум протофреймов, учитывая их связь с Заражением и их взаимодействие со временем. ",shape=box,color=blue];
		j3100178478 -> j2772188778;
	j4068363059 [label="Если ты можешь сказать мне, что твои дары ни разу тобой не были использованы, чтобы играть с разумом тех gротофреймов, которых называешь друзьями и возлюбленными, и можешь сказать это без тени лжи в своей душе?",shape=box,color=blue];
		j4068363059 -> j4010808125;
	j2267901413 [label="Я последний из Орокин. Я коронован среди них, пока кто-нибудь не встанет, чтобы бросить мне вызов. И я буду капитаном во всех собственных делах до того дня, пока моя жизнь не оборвется.",shape=box,color=blue];
		j2267901413 -> j2371825712;
	j313455525 [label="Я последний из Орокин. Я коронован среди них, пока кто-нибудь не встанет, чтобы бросить мне вызов. И я буду капитаном во всех собственных делах до того дня, пока моя жизнь не оборвется.",shape=box,color=blue];
		j313455525 -> j3965925139;
