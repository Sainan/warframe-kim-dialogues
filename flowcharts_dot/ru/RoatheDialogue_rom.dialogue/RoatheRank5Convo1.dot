	j2703695820 [label="Поверь. мне.",shape=box,color=red];
		j2703695820 -> j453680659;
	j1839279410 [label="Все эти игры. Танцевать на чужих нитях. Делать то, что от тебя ожидают. Когда это ожидается. Как это ожидается. Вести чужие войны. Вот что тебя разрывает на части.",shape=box,color=red];
		j1839279410 -> j158120446;
	j2573146661 [label="Я знаю. В этом нет ничего справедливого. Но и в самой жизни нет ничего справедливого, верно? Ты к этому привык. И привык делать так, чтобы всё работало дальше.",shape=box,color=red];
		j2573146661 -> j1839279410;
	j493305585 [label="Хотелось бы понимать, как тебе помочь. Хотелось бы знать, какие слова здесь сказать. Ощущение такое, будто тебя разрывает между двумя направлениями. Какой путь ты хочешь выбрать?",shape=box,color=red];
