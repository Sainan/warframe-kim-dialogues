		j3473404184 -> j3331892200;
	j385125939 [label="Я чувствую, будто само моё понимание себя, самый фундамент моей сущности треснул и разорвался, как проклятая Луа! Переписано чернилами, которые растекаются. Трус!",shape=box,color=blue];
