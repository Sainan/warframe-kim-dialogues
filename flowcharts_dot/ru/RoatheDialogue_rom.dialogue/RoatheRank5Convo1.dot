		j1446501109 -> j1363872309;
	j1206867733 [label="Да, я думаю, ты как раз можешь быть своего рода «ценителем» подобных вещей, не так ли? Продолжай.",shape=box,color=blue];
		j1206867733 -> j3661986121;
		j1206867733 -> j2021284627;
	j290186388 [label="Под воспоминаниями, под оболочкой Орокин, под этой... синей кожей и Заражением, под Уриэлем и этой маской вице-регента Великого Карнуса Роута, которую я ношу...",shape=box,color=blue];
		j290186388 -> j2752801013;
	j3913294261 [label="Под воспоминаниями, под оболочкой Орокин, под этой... синей кожей и Заражением, под Уриэлем и этой маской вице-регента Великого Карнуса Роута, которую я ношу...",shape=box,color=blue];
		j3913294261 -> j2261545233;
	j3281888905 [label="У тебя есть дар. Дар, который способен обращать время вспять. Закручивать его в спираль, если не замыкать в петлю. И это оказывает... интересный эффект на разум протофреймов, учитывая их связь с Заражением и их взаимодействие со временем. ",shape=box,color=blue];
		j3281888905 -> j1381730675;
	j3951853488 [label="Если ты можешь сказать мне, что твои дары ни разу тобой не были использованы, чтобы играть с разумом тех gротофреймов, которых называешь друзьями и возлюбленными, и можешь сказать это без тени лжи в своей душе?",shape=box,color=blue];
		j3951853488 -> j3676898561;
	j3019794768 [label="Я последний из Орокин. Я коронован среди них, пока кто-нибудь не встанет, чтобы бросить мне вызов. И я буду капитаном во всех собственных делах до того дня, пока моя жизнь не оборвется.",shape=box,color=blue];
		j3019794768 -> j1471948358;
	j3572022386 [label="Я последний из Орокин. Я коронован среди них, пока кто-нибудь не встанет, чтобы бросить мне вызов. И я буду капитаном во всех собственных делах до того дня, пока моя жизнь не оборвется.",shape=box,color=blue];
		j3572022386 -> j492592491;
