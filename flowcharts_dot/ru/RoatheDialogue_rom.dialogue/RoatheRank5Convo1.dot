		j1641219051 -> j3318357834;
	j2870324077 [label="Тогда, возможно, твоя права. Возможно, это действительно не изменит мою сущность. Возможно, эта часть меня никогда не будет изменена. Ни теперь, ни когда-либо потом.",shape=box,color=blue];
		j2870324077 -> j2872112458;
	j3302402167 [label="И вот мы снова возвращаемся к предсказуемому и неинтересному.",shape=box,color=blue];
		j3302402167 -> j1291985431;
	j271484031 [label="Да, я думаю, ты как раз можешь быть своего рода «ценителем» подобных вещей, не так ли? Продолжай.",shape=box,color=blue];
		j271484031 -> j2557300475;
		j271484031 -> j1478970107;
	j4212787 [label="У меня есть для тебя два слова, которые ты, возможно, не забудешь, ведь я слышал, что они тебе весьма знакомы!",shape=box,color=blue];
		j4212787 -> j2948467979;
	j2418623719 [label="Тогда позволь мне упростить это для тебя!",shape=box,color=blue];
		j2418623719 -> j4212787;
	j4247963022 [label="Неужели именно от этого я хотела избавиться каждый раз, когда мне так хотелось впиться этими когтями в собственную кожу и содрать её?! ",shape=box,color=blue];
