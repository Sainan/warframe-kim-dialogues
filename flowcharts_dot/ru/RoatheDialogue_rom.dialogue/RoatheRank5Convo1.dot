		j3582808035 -> j2080872116;
	j2879213776 [label="Так в чем же простая суть на самом деле? Ты входишь в число немногих Орокин, кто смог пройти через ту Ночь Барабанов Нага. С моей точки зрения? Это выглядит как стратегическое отступление.",shape=box,color=red];
		j2879213776 -> j4035714945;
