		j1934009866 -> j1145974490 [label="false",color=purple];
	j2103212604 [label="Оклеветанные, искаженно понятые, преданные анафеме. Низвергнутые с небес и оставленные гнить. Родственные души, воистину!",shape=box,color=blue];
		j2103212604 -> j1588455492;
	j2076677272 [label="Я знаю, что это не первый раз, когда мы сталкиваемся с этим. Я помню, что уже был здесь однажды. И знаю, что это может быть не последний раз. Я постоянно прошу тебя остановиться и начать всё сначала, и для меня это очень важно.",shape=box,color=blue];
		j2076677272 -> j730011962;
	j3030215336 [label="Я знаю, что это не первый раз, когда мы сталкиваемся с этим. Я помню, что уже был здесь однажды. И знаю, что это может быть не последний раз. Я постоянно прошу тебя остановиться и начать всё сначала, и для меня это очень важно.",shape=box,color=blue];
		j3030215336 -> j3635584024;
	j3251606808 [label="Я знаю, что это не первый раз, когда мы сталкиваемся с этим. Я помню, что уже был здесь однажды. И знаю, что это может быть не последний раз. Я постоянно прошу тебя остановиться и начать всё сначала, и для меня это очень важно.",shape=box,color=blue];
		j3251606808 -> j1700661395;
	j1624962795 [label="Я должен отдать тебе должное, Узурпатор, за выполнение моей просьбы, за остановленное тобой продвижение дальше в Тёмный Рефракторий и за мои воспоминания в Спуске. Несмотря на то, что между нами не было никакого обещания.",shape=box,color=blue];
		j1624962795 -> j1283863795;
	j1405443148 [label="Сокровище, я должен отдать тебе должное за сдержанное тобой слово, за остановленное тобой продвижение дальше в Спуск и Тёмный Рефракторий и за то, что мои последние воспоминания не были возвращены. Это невероятно много значит для меня.",shape=box,color=blue];
		j1405443148 -> j1200203913;
	j1228198799 [label="Сокровище, я должен отдать тебе должное за выполнение моей просьбы, за остановленное тобой продвижение дальше в Тёмный Рефракторий и за мои воспоминания в Спуске. Это невероятно много значит для меня.",shape=box,color=blue];
		j1228198799 -> j1200203913;
	j3918144539 [label="Я должен отдать тебе должное, Узурпатор, за сдержанное тобой слово, за остановленное тобой продвижение дальше в Спуск и Тёмный Рефракторий и за то, что мои последние воспоминания не были возвращены.",shape=box,color=blue];
		j3918144539 -> j1908672366;
	j1145974490 [label="Я должен отдать тебе должное, Узурпатор, за выполнение моей просьбы, за остановленное тобой продвижение дальше в Тёмный Рефракторий и за мои воспоминания в Спуске. Несмотря на то, что между нами не было никакого обещания.",shape=box,color=blue];
		j1145974490 -> j1908672366;
	j1588455492 [label="Когда пришли рекруты, внутри меня переплелись три энергии, и тогда появление четвертой уже не показалось столь удивительным. Это чудовищное нечто стремилось, которое жаждало разорвать меня на части, словно кору миров, чтобы прорваться наружу.",shape=box,color=blue];
		j1588455492 -> j1608356667;
	j730011962 [label="I remember your promise to me. And that I have found such a place in your heart that you keep me in such a purgatorial state? Thank you, my pet. Thank you.",shape=box,color=blue];
		j730011962 -> j1200203913;
	j3635584024 [label="То, что я занял такое место в твоём сердце, что ты удерживаешь меня в таком чистилищном состоянии? Спасибо тебе, мой питомец. Спасибо.",shape=box,color=blue];
		j3635584024 -> j1200203913;
	j1700661395 [label="Я помню твое обещание, данное мне. И то, что между нами возникла такая дружба, что ты удерживаешь меня в таком чистилищном состоянии? Спасибо тебе, мой друг.",shape=box,color=blue];
		j1700661395 -> j1908672366;
	j1283863795 [label="И то, что между нами возникла такая дружба, что ты удерживаешь меня в таком чистилищном состоянии? Спасибо тебе, мой друг.",shape=box,color=blue];
		j1283863795 -> j1908672366;
	j1200203913 [label="Хотя я все ещё чувствую, как оно грызет меня на задворках моего разума, это похоже на кубрау, лающего на конце поводка. С этим можно справиться. Можно приручить.",shape=box,color=blue];
		j1200203913 -> j2388011047;
	j1908672366 [label="Хотя я все ещё чувствую, как оно грызет меня на задворках моего разума, это похоже на кубрау, лающего на конце поводка. С этим можно справиться. Можно приручить.",shape=box,color=blue];
		j1908672366 -> j2880659317;
	j1608356667 [label="А что ещё?",shape=box,color=blue];
		j1608356667 -> j2148856201;
