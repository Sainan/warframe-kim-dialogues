	j2752801013 [label="Кто я есть?...",shape=box,color=blue];
		j2752801013 -> j86834419;
	j2261545233 [label="Кто я есть?..",shape=box,color=blue];
		j2261545233 -> j4019179961;
	j1381730675 [label="И следовательно, наша привязанность ко времени. Сейчас я прошу тебя. Нет, умоляю тебя, воспользуйся им ради меня. Уберите от меня эти мысли. Уберите от меня эти воспоминания.",shape=box,color=blue];
		j1381730675 -> j3362154485;
	j3676898561 [label="Тогда хорошо. Пусть будет так. Я не попрошу тебя об этом сейчас. Но разве тебе хоть раз доводилось делать это ради собственного удовольствия, из любопытства или чтобы попытаться исправить ошибки, допущенные в отношениях с другими?!",shape=box,color=blue];
		j3676898561 -> j3362154485;
	j1471948358 [label="Это моё решение посвятить оставшиеся дни тому, чтобы выбирать путь исправления всех тех заблуждений, которые мои несчастные народы сочли возможным навесить на эту систему с самого начала времен. ",shape=box,color=blue];
		j1471948358 -> j3201458561;
	j492592491 [label="Мои схемы и замыслы о власти принадлежат целиком и полностью  мне. А ты, мой дорогой нежный Скиталец, занимаешь в них главное место... если только захочешь.",shape=box,color=blue];
		j492592491 -> j3741719279;
	j3854124807 [label="У меня есть для тебя два слова, которые ты, возможно, не забудешь, ведь я слышал, что они тебе весьма знакомы!",shape=box,color=blue];
		j3854124807 -> j2993304146;
	j3136206491 [label="Что ж! Позволь мне тогда дать тебе вернуться к твоим делам! Прошу прощения за беспокойство!",shape=box,color=blue];
		j3136206491 -> j3854124807;
	j3318357834 [label="Evaluate expressions",color=orange];
