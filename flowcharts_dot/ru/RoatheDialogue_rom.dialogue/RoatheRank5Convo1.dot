	j3136081032 [label="Прости, но мне чрезвычайно трудно в это поверить. Нас определяют моменты нашей жизни. Мы всего лишь цепочка воспоминаний, ведущих нас к следующему. Поэтому воспоминания были - были - столь священны для Орокин.",shape=box,color=blue];
