	j3098693764 [label="Если тебе хочется самостоятельно выбрать свой собственный путь и идти по нему? Для себя? Тогда иди. Не извиняйся. Но это твой путь, а не чей-либо ещё.",shape=box,color=red];
		j3098693764 -> j489296328;
	j1258103696 [label="Если ты желаешь получить прощение, это возможно. Но это желание должно исходить от тебя. Тебе нужно выбрать этот путь. Никто другой не может этого сделать.",shape=box,color=red];
