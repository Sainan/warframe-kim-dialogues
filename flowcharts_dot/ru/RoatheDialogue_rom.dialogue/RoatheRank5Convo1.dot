		j2926958140 -> j3890877652;
	j1923501006 [label="Впереди дорога, чистая от скверны моего прошлого. Она так заманчива, сокровище. Но она кажется... неправильной, почему-то. Отпустить все это после стольких лет.",shape=box,color=blue];
