		j2557582585 -> j1985427770;
	j161881535 [label="Все эти игры. Танцевать на чужих нитях. Делать то, что от тебя ожидают. Когда это ожидается. Как это ожидается. Вести чужие войны. Вот что тебя разрывает на части.",shape=box,color=red];
		j161881535 -> j2615260937;
