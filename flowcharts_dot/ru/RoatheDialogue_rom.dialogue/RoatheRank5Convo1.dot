	j1715821598 [label="Твоя суть не определяется твоим прошлым, Роут. Она определяется твоим будущим. И у тебя всё ещё есть будущее, которое можно прожить, в отличие от всех Орокин, погибших в Ночь Барабанов Нага.",shape=box,color=red];
		j1715821598 -> j704487685;
	j2335555428 [label="Твою суть не определяет мнения окружающих. Или от того, как они воспринимают твои действия. Тебя определяет только то, что ты сам думаешь о себе и о своем выборе.",shape=box,color=red];
		j2335555428 -> j1846511369;
	j3140312711 [label="Поверь. мне.",shape=box,color=red];
		j3140312711 -> j2831193943;
	j231920675 [label="Все эти игры. Танцевать на чужих нитях. Делать то, что от тебя ожидают. Когда это ожидается. Как это ожидается. Вести чужие войны. Вот что тебя разрывает на части.",shape=box,color=red];
		j231920675 -> j517073536;
	j2928187559 [label="Я знаю. В этом нет ничего справедливого. Но и в самой жизни нет ничего справедливого, верно? Ты к этому привык. И привык делать так, чтобы всё работало дальше.",shape=box,color=red];
		j2928187559 -> j231920675;
	j2612775138 [label="Хотелось бы понимать, как тебе помочь. Хотелось бы знать, какие слова здесь сказать. Ощущение такое, будто тебя разрывает между двумя направлениями. Какой путь ты хочешь выбрать?",shape=box,color=red];
		j2612775138 -> j1291985431;
	j3207511405 [label="И я не знаю, как утолить это. Не знаю, получится ли вообще. Я надеялся, что эти разговоры подскажут мне путь, но теперь вижу, что это бесплодно.",shape=box,color=blue];
