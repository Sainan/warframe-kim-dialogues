	j2293409947 [label="У тебя есть дар. Дар, который способен обращать время вспять. Закручивать его в спираль, если не замыкать в петлю. И это оказывает… интересный эффект на разум протофреймов, учитывая их связь с Заражением и их взаимодействие со временем.",shape=box,color=blue];
		j2293409947 -> j737934630;
	j1322203758 [label="Если ты можешь сказать мне, что твои дары ни разу тобой не были использованы, чтобы играть с разумом тех протофреймов, которых называешь друзьями и возлюбленными, и можешь сказать это без тени лжи в своей душе?",shape=box,color=blue];
