		j3095386117 -> j2043301822;
	j3946401885 [label="The road ahead, clear of the corruption of my past. It is a tempting one, darling. It feels... wrong, somehow. To let it all go, after so long.",shape=box,color=blue];
		j3946401885 -> j821354923;
	j3073930583 [label="The road ahead, clear of the obstructions of my past. It is a tempting one, darling. It feels... wrong, somehow. To give up the anger after so long.",shape=box,color=blue];
		j3073930583 -> j2205907099;
	j545649358 [label="Но у нас была сделка, не так ли? Что когда наступит этот момент, я помогу тебе пройти через это. И вот мы здесь.",shape=box,color=blue];
		j545649358 -> j252210226;
	j1150685536 [label="И если бы я мог сделать это сам, как ты думаешь, стал бы я сидеть здесь и тратить на тебя своё время?! Причём дважды?!",shape=box,color=blue];
		j1150685536 -> j4080848114;
	j2669346118 [label="The road ahead, clear of the corruption of my past. It is a tempting one, Drifter dear. It feels... wrong, somehow. To let it all go, after so long.",shape=box,color=blue];
		j2669346118 -> j821354923;
	j810109972 [label="The road ahead, clear of the obstructions of my past. It is a tempting one, Usurper. Drifter. It feels... wrong, somehow. To give up the anger after so long.",shape=box,color=blue];
		j810109972 -> j2205907099;
	j2286631851 [label="But we had a deal, did we not? That when this moment came to pass, I would see you through this. And here we are.",shape=box,color=blue];
		j2286631851 -> j2443132101;
	j2881683445 [label="And if I could do so on my own, do you think I would be sitting here wasting my time with you?! Twice over, no less?!",shape=box,color=blue];
		j2881683445 -> j1972896002;
	j2048527298 [label="No. If you want the butler to go upstairs? You wipe my mind of all of this nonsense as I have asked. If you do not care? Then do as you wish. It matters not to me.",shape=box,color=blue];
		j2048527298 -> j336527563;
	j2000432521 [label="+20 Chemistry",color=orange];
		j2000432521 -> j193933965;
	j3748276711 [label="+20 Chemistry",color=orange];
		j3748276711 -> j1645733146;
	j3147970404 [label="Boolean RoatheRedeemed is now true.",color=orange];
		j3147970404 -> j3707263668;
	j3707263668 [label="+20 Chemistry",color=orange];
		j3707263668 -> j3207066960;
	j2319479887 [label="И это то, что...? ",shape=box,color=red];
		j2319479887 -> j3347935277;
	j2816173177 [label="Нет. Я знаю, о чём ты собираешься спросить, и мой ответ уже нет.",shape=box,color=red];
		j2816173177 -> j1582748281;
	j2592420589 [label="I appreciate it. More than you might know.",shape=box,color=blue];
		j2592420589 -> j2043301822;
	j1804112412 [label="Very well. I concede and accept your argument. Thank you, Drifter, for... talking me off this particular ledge.",shape=box,color=blue];
		j1804112412 -> j2592420589;
	j485553077 [label="Forgive myself for what I have done? And move forward into the future? Hm.",shape=box,color=blue];
		j485553077 -> j1373770695;
	j933046038 [label="A retreat to win the war. Hm. ",shape=box,color=blue];
		j933046038 -> j3637177219;
	j1795266611 [label="You have a gift. A gift that can undo time. Spiral it, if not loop it. And this has... an interesting effect upon the minds of Protoframes, by its attachment to the Infestation and its  attachment to time. ",shape=box,color=blue];
		j1795266611 -> j1826048370;
	j542308968 [label="Если ты можешь сказать мне, что твои дары ни разу тобой не были использованы, чтобы играть с разумом тех протофреймов, которых называешь друзьями и возлюбленными, и можешь сказать это без тени лжи в своей душе?",shape=box,color=blue];
		j542308968 -> j844120165;
	j2043301822 [label="I must go. I am in the mood to drink a great deal of alcohol and stare off broodingly into the middle distance.",shape=box,color=blue];
		j2043301822 -> "Chat ends. Next chat will be Roathe5Day2.";
	j821354923 [label="I think it will be a mask I wear for a very long time. Even if I do not hold it in my heart. But... you make a great deal of sense.",shape=box,color=blue];
		j821354923 -> j2424437507;
	j2205907099 [label="But to become that which I knew I could always be, free of what restrained me? Yes. Yes, in this, I could find great joy.",shape=box,color=blue];
		j2205907099 -> j1770756081;
	j252210226 [label="So I will allow you another chance to convince me. In fact, I will allow you to choose which path we take. My end of the bargain is complete. Simply remember, you owe the devil a debt. And I will collect.",shape=box,color=blue];
		j252210226 -> j1137026383;
	j4080848114 [label="At least twice! That I know of! Who knows how many times we have beat around this particular bush. ",shape=box,color=blue];
		j4080848114 -> j356981954;
	j2443132101 [label="So I will allow you another chance to convince me. In fact, I will allow you to choose which path we take. My end of the bargain is complete. Simply remember, you owe the devil a debt. And I will collect.",shape=box,color=blue];
		j2443132101 -> j3799982455;
	j1972896002 [label="At least twice! That I know of! Who knows how many times we have beat around this particular bush. ",shape=box,color=blue];
		j1972896002 -> j703350284;
	j336527563 [label="That, and, well, of course, our personal friendship is the only leverage I own in this situation. It is that simple.",shape=box,color=blue];
		j336527563 -> j502993093;
	j193933965 [label="Forgive myself for what I have done? And move forward into the future? Hm.",shape=box,color=blue];
		j193933965 -> j2291195927;
	j1645733146 [label="A retreat to win the war. Hm. ",shape=box,color=blue];
		j1645733146 -> j3623899415;
	j3207066960 [label="Very well. I concede and accept your argument. Thank you, darling, for... talking me off this particular ledge.",shape=box,color=blue];
		j3207066960 -> j2592420589;
	j3347935277 [label="У тебя есть дар. Дар, который способен обращать время вспять. Закручивать его в спираль, если не замыкать в петлю. И это оказывает... интересный эффект на разум протофреймов, учитывая их связь с Заражением и их взаимодействие со временем. ",shape=box,color=blue];
		j3347935277 -> j1586357816;
	j1582748281 [label="Если ты можешь сказать мне, что твои дары ни разу тобой не были использованы, чтобы играть с разумом тех gротофреймов, которых называешь друзьями и возлюбленными, и можешь сказать это без тени лжи в своей душе?",shape=box,color=blue];
		j1582748281 -> j4226986024;
	j1373770695 [label="While I am slightly dubious of your reframing of the situation, I am... too tempted by this new future an what it might mean for me to resist it, Usurper. Drifter.",shape=box,color=blue];
		j1373770695 -> j3098068334;
	j3637177219 [label="While I am... slightly dubious of your reframing of your events as a tactical retreat, I admit I am... in favor of it, all the same, Usurper. Drifter.",shape=box,color=blue];
		j3637177219 -> j1804112412;
	j1826048370 [label="And our attachment, therefore, to time. I ask you now. No, I beseech you, to wield it now on my behalf. Take these thoughts away from me. Take these memories away from me.",shape=box,color=blue];
		j1826048370 -> j1065936201;
	j844120165 [label="Then very well. So be it. I will not ask this of you now. But if you have never once done it for your own amusement, curiosity, or to seek to undue errors you have made in the dealings with others?!",shape=box,color=blue];
		j844120165 -> j1065936201;
