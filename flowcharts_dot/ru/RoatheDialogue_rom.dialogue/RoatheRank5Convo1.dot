	j2229718788 [label="Fine. Be angry. But use that anger for something worthwhile. Use it to shake loose all this hatred you have in you that you're pointing in the wrong direction.",shape=box,color=red];
		j2229718788 -> j4181303452;
	j3055752542 [label="I just wish I knew how to help you. I wish I knew what to say. It feels like you're torn in two directions. Which way do you want to go?",shape=box,color=red];
		j3055752542 -> j1363872309;
	j98305664 [label="Within me is a malestrom of a rabid beast, eating away at my ribcage from the inside out.",shape=box,color=blue];
		j98305664 -> j2551725596;
	j2907149580 [label="And the simple fact of the matter is? You are one of the very few Orokin we know that survived the Night of the Naga drums. From my point of view? It was a strategic retreat.",shape=box,color=red];
		j2907149580 -> j3400973831;
