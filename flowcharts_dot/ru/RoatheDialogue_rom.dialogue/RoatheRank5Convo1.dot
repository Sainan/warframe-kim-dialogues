	j3029209102 [label="Если тебе хочется самостоятельно выбрать свой собственный путь и идти по нему? Для себя? Тогда иди. Не извиняйся. Но это твой путь, а не чей-либо ещё.",shape=box,color=red];
		j3029209102 -> j4072720897;
	j2704412245 [label="Если ты желаешь получить прощение, это возможно. Но это желание должно исходить от тебя. Тебе нужно выбрать этот путь. Никто другой не может этого сделать.",shape=box,color=red];
		j2704412245 -> j503800918;
	j1706975653 [label="Кто я есть?...",shape=box,color=blue];
		j1706975653 -> j784524713;
	j1403214328 [label="Кто я есть?..",shape=box,color=blue];
		j1403214328 -> j3229485341;
	j2772188778 [label="И следовательно, наша привязанность ко времени. Сейчас я прошу тебя. Нет, умоляю тебя, воспользуйся им ради меня. Уберите от меня эти мысли. Уберите от меня эти воспоминания.",shape=box,color=blue];
		j2772188778 -> j1331321830;
	j4010808125 [label="Тогда хорошо. Пусть будет так. Я не попрошу тебя об этом сейчас. Но разве тебе хоть раз доводилось делать это ради собственного удовольствия, из любопытства или чтобы попытаться исправить ошибки, допущенные в отношениях с другими?!",shape=box,color=blue];
		j4010808125 -> j1331321830;
	j2548815980 [label="Это моё решение посвятить оставшиеся дни тому, чтобы выбирать путь исправления всех тех заблуждений, которые мои несчастные народы сочли возможным навесить на эту систему с самого начала времён. ",shape=box,color=blue];
		j2548815980 -> j1229107054;
	j4206437651 [label="Мои схемы и замыслы о власти принадлежат целиком и полностью мне. А ты, мой дорогой нежный Скиталец, займёшь в них главное место… если только ты этого хочешь.",shape=box,color=blue];
		j4206437651 -> j3916833526;
	j3854124807 [label="У меня есть для тебя два слова, которые ты, возможно, не забудешь, ведь я слышал, что они тебе весьма знакомы!",shape=box,color=blue];
		j3854124807 -> j2993304146;
	j3136206491 [label="Что ж! Позволь мне тогда дать тебе вернуться к твоим делам! Прошу прощения за беспокойство!",shape=box,color=blue];
		j3136206491 -> j3854124807;
