	j1282953586 [label="Похоже, эта маска останется со мной надолго. Даже если она не станет частью сердца. И всё же… в сказанном есть немалая доля истины.",shape=box,color=blue];
		j1282953586 -> j3741707501;
	j134601831 [label="Но обратиться в то, чем всегда существовала возможность стать, освобожденным от оков? Да. Да, в этом ощущается источник глубокой радости.",shape=box,color=blue];
		j134601831 -> j3476028359;
	j3168851832 [label="Поэтому будет дана еще одна возможность убедить меня. Более того, выбор пути остается за тобой. Моя часть соглашения уже выполнена. Остается лишь помнить, что долг перед дьяволом существует. И он подлежит взысканию.",shape=box,color=blue];
		j3168851832 -> j1137026383;
	j2042489613 [label="По меньшей мере два раза! Во всяком случае, насколько это известно! Кто знает, сколько раз мы уже ходили вокруг да около. ",shape=box,color=blue];
		j2042489613 -> j1559043648;
	j287307160 [label="Поэтому будет дана еще одна возможность убедить меня. Более того, выбор пути остается за тобой. Моя часть соглашения уже выполнена. Остается лишь помнить, что долг перед дьяволом существует. И он подлежит взысканию.",shape=box,color=blue];
		j287307160 -> j3799982455;
	j273917455 [label="По меньшей мере два раза! Во всяком случае, насколько это известно! Кто знает, сколько раз мы уже ходили вокруг да около. ",shape=box,color=blue];
		j273917455 -> j1043652816;
	j1308672740 [label="Это и, ну, конечно, личная дружба между нами, остаётся единственным средством воздействия в этих обстоятельствах. Вот и вся суть.",shape=box,color=blue];
		j1308672740 -> j1866211455;
	j4267030811 [label="Принять то, что было сделано, и шагнуть вперед, к будущему? Хм.",shape=box,color=blue];
		j4267030811 -> j2792556728;
	j161156645 [label="Отступление ради победы в войне. Хм. ",shape=box,color=blue];
		j161156645 -> j1275693330;
	j752636401 [label="Хорошо. Я уступаю и принимаю твой аргумент. Спасибо, сокровище, за... удержание меня от этого конкретного края.",shape=box,color=blue];
		j752636401 -> j2926958140;
	j449777727 [label="У тебя есть дар. Дар, который способен обращать время вспять. Закручивать его в спираль, если не замыкать в петлю. И это оказывает… интересный эффект на разум протофреймов, учитывая их связь с Заражением и их взаимодействие со временем.",shape=box,color=blue];
		j449777727 -> j628714161;
	j824307256 [label="Если ты можешь сказать мне, что твои дары ни разу тобой не были использованы, чтобы играть с разумом тех gротофреймов, которых называешь друзьями и возлюбленными, и можешь сказать это без тени лжи в своей душе?",shape=box,color=blue];
		j824307256 -> j719105915;
	j466422316 [label="Пусть некоторое недоверие к новому взгляду на происходящее и сохраняется, соблазн этого будущего и его значения для меня слишком велик, чтобы отвернуться от него, Узурпатор. Скиталец.",shape=box,color=blue];
		j466422316 -> j2870525448;
	j2556335251 [label="Пусть и остаётся... легкое недоверие к тому, что случившееся подаётся как тактический отход, всё равно... с этим трудно не согласиться, Узурпатор. Скиталец.",shape=box,color=blue];
		j2556335251 -> j1555706459;
