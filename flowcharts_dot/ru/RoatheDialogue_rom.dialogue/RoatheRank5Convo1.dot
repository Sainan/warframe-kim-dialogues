	j37297977 [label="Ты позволяешь этой злости разрывать тебя изнутри. А мог бы использовать её, чтобы бороться с теми, кто продолжает разрушать этот мир сегодня. Здесь. Сейчас.",shape=box,color=red];
		j37297977 -> j2665210350;
	j4191124753 [label="Ты обращаешь это против себя. А ведь стоило бы направить это к миру, который винит тебя за то, что ты пытался сделать всё, что возможно, чтобы защитить его от Империи Орокин.",shape=box,color=red];
		j4191124753 -> j2604441252;
	j229156384 [label="Хотелось бы понимать, как тебе помочь. Хотелось бы знать, какие слова здесь сказать. Ощущение такое, будто тебя разрывает между двумя направлениями. Какой путь ты хочешь выбрать?",shape=box,color=red];
		j229156384 -> j1564283062;
	j2080872116 [label="И я не знаю, как утолить это. Не знаю, получится ли вообще. Я надеялся, что эти разговоры подскажут мне путь, но теперь вижу, что это бесплодно.",shape=box,color=blue];
		j2080872116 -> j2623028973;
	j1776373935 [label="Так в чем же простая суть на самом деле? Ты входишь в число немногих Орокин, кто смог пройти через ту Ночь Барабанов Нага. С моей точки зрения? Это выглядит как стратегическое отступление.",shape=box,color=red];
		j1776373935 -> j1603236643;
	j4129041438 [label="Сейчас это единственное, что тебя определяет. Ты можешь измениться. И можешь изменить мир вокруг себя. И думаю, у меня остаётся только один вопрос: попробуешь ли хотя бы?",shape=box,color=red];
		j4129041438 -> j513721148;
	j2856911574 [label="Кто остался?",shape=box,color=blue];
		j2856911574 -> j2541831425;
	j3580975398 [label="Кто остался?",shape=box,color=blue];
		j3580975398 -> j1247521463;
	j835694110 [label="Воспоминание о сыворотке устроено иначе, Роут. Она на них не подействует. Она глубоко запрятана в твоей психике. Но всё остальное... это я могу забрать.",shape=box,color=red];
		j835694110 -> j738122970;
	j8223591 [label="Бегство и попытки спрятаться от правды не сработают. В итоге мы просто вернемся туда, откуда начали. ",shape=box,color=red];
		j8223591 -> j1944364033;
	j3286815030 [label="Ты уверен? Просто... ты сообразительный, и у меня такое чувство, что ты всё равно поймешь, что что-то тут не так.",shape=box,color=red];
		j3286815030 -> j296288792;
	j1462332972 [label="И если ты, мой дорогой, милый, любимый Скиталец, найдёшь в своём сердце силы помочь мне в таких делах... я буду тебе очень признателен.",shape=box,color=blue];
		j1462332972 -> j3208162813;
