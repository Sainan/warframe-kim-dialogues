		j2785008753 -> j4162653135;
	j2195234702 [label="Я знаю, каково это постоянно пытаться сбежать от того, от чего, кажется, невозможно освободиться. Пытаться уйти от того, что будет преследовать всегда, как бы далеко ты ни зашёл.",shape=box,color=red];
