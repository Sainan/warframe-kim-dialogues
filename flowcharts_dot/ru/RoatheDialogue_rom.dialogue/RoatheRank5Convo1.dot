		j3582808035 -> j2080872116;
	j4072720897 [label="Твою суть не определяет мнения окружающих. Или от того, как они воспринимают твои действия. Тебя определяет только то, что ты сам думаешь о себе и о своем выборе.",shape=box,color=red];
		j4072720897 -> j1776373935;
	j503800918 [label="Твоя суть не определяется твоим прошлым, Роут. Она определяется твоим будущим. И у тебя всё ещё есть будущее, которое можно прожить, в отличие от всех Орокин, погибших в Ночь Барабанов Нага.",shape=box,color=red];
		j503800918 -> j4129041438;
	j784524713 [label="Когда все воспоминания исчезнут, когда все воспоминания нахлынут обратно, когда всё сгорит и вернётся ко мне...",shape=box,color=blue];
		j784524713 -> j2856911574;
	j3229485341 [label="Когда все воспоминания исчезнут, когда все воспоминания нахлынут обратно, когда всё сгорит и вернётся ко мне...",shape=box,color=blue];
		j3229485341 -> j3580975398;
	j1331321830 [label="Мне нужно забыть о том, как я взял сыворотку у Энтрати. В сочетании с тем уколом от твоих отозванных слов о любви получается слишком много боли, которую хотелось бы забыть... Пожалуйста.",shape=box,color=blue];
