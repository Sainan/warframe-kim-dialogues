	j2957296529 [label="И это моё собственное определение себя недавно было полностью переписано. Оно запечатлелось в моей душе чернилами, которые не смываются.",shape=box,color=blue];
		j2957296529 -> j3132972928;
	j2804241091 [label="Я чувствую, будто само моё понимание себя, самый фундамент моей сущности треснул и разорвался, как проклятая Луа! Переписано чернилами, которые растекаются. Трус!",shape=box,color=blue];
		j2804241091 -> j3335437640;
	j1715660113 [label="Ты можешь ненавидеть меня сколько угодно, Роут. Но то, что было сделано мной, то сделано, потому что это и должно было случиться. Ты больше не мог скрываться от этого.",shape=box,color=red];
		j1715660113 -> j1446501109;
