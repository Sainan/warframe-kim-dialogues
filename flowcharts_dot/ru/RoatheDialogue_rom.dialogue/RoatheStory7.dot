	j2923971840 [label="ГС: ПОРУЧЕНИЕ",shape=box,color=blue];
		j2923971840 -> j2270095011;
	j2270095011 [label="Транскрипт: Среди Семерых обо мне — как мне сказали — считали, что я игрушка и наложник Нитока.",shape=box,color=blue];
		j2270095011 -> j1598642106;
	j1598642106 [label="В первые дни войны меня по ее настоянию назначили вице-регентом Великого Карнуса Роута, посчитав это шуткой.",shape=box,color=blue];
		j1598642106 -> j2500889914;
	j2500889914 [label="Как быстро их смех сменился торжественными аплодисментами, когда я раз за разом приносил вести об очередной победе.",shape=box,color=blue];
		j2500889914 -> j4006947366;
	j4006947366 [label="Кровь лучших из лучших покрывала меня, словно медали. Втайне я накапливал оружие для Ниток.",shape=box,color=blue];
		j4006947366 -> j561530073;
	j561530073 [label="Это было нетрудно. Я был слишком величественной фигурой, чтобы меня заподозрили",shape=box,color=blue];
		j561530073 -> j921430358;
	j921430358 [label="Add 1 to HellStory counter",color=orange];
