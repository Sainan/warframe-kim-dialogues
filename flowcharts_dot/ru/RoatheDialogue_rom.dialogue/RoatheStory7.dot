	j3015201747 [label="VM: COMMISSION",shape=box,color=blue];
		j3015201747 -> j2804821136;
	j2804821136 [label="Транскрипт: Среди Семерых обо мне — как мне сказали — считали, что я игрушка и наложник Нитока.",shape=box,color=blue];
		j2804821136 -> j2057289704;
	j2057289704 [label="In the early days of the War they appointed me Vice Regent Grand Carnus at her goading, thinking it a jest.",shape=box,color=blue];
		j2057289704 -> j3948707629;
	j3948707629 [label="How quickly their laughter turned to solemn applause as I brought home the news of one victory after another.",shape=box,color=blue];
		j3948707629 -> j3658754735;
	j3658754735 [label="The blood of better men dappled me like medals. In secret I amassed weapons for Nitokh.",shape=box,color=blue];
		j3658754735 -> j561530073;
	j561530073 [label="Это было нетрудно. Я был слишком величественной фигурой, чтобы меня заподозрили",shape=box,color=blue];
		j561530073 -> j921430358;
	j921430358 [label="Add 1 to HellStory counter",color=orange];
		j921430358 -> "Chat ends.";
}