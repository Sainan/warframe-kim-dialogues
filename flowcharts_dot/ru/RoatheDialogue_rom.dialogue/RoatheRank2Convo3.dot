digraph {
	1042 [label="RoatheRank2Convo3 begins.",color=orange];
		1042 -> 1043;
	1043 [label="Check boolean RoatheRank2Convo1Complete",color=orange];
		1043 -> 1044 [label=true,color=green];
		1043 -> 1045 [label=false,color=brown];
	1044 [label="Check boolean RoatheKnowsReset2",color=orange];
		1044 -> 1046 [label=true,color=green];
		1044 -> 1047 [label=false,color=brown];
	1045 [label="Chat ends.",color=orange];
	1046 [label="Я знаю, что это, возможно, звучало для тебя и раньше, но сегодня стало ясно, что мне всё равно - у меня нет терпения.",shape=box,color=blue];
		1046 -> 1047;
	1047 [label="Я думаю, что причиной падения Империи Орокин стало слишком много слоёв стекла.",shape=box,color=blue];
		1047 -> 1048;
		1047 -> 1049;
		1047 -> 1050;
	1048 [label="Как так?",shape=box,color=red];
		1048 -> 1051;
	1049 [label="Слишком обезличенно?",shape=box,color=red];
		1049 -> 1052;
	1050 [label="[Конец.]",shape=box,color=red];
		1050 -> 1053;
	1051 [label="Представьте себе общество, основанное на осознании того, что ты, по сути, всегда в безопасности. Защищён. Даже от ужасного призрака смерти.",shape=box,color=blue];
		1051 -> 1054;
	1052 [label="+5 Chemistry",color=orange];
		1052 -> 1055;
	1053 [label="Chat ends.",color=orange];
	1054 [label="Где ничто не может причинить тебе вред.",shape=box,color=blue];
		1054 -> 1056;
	1055 [label="Именно. Слишком оторваны от опасности и реальности происходящего.",shape=box,color=blue];
		1055 -> 1051;
	1056 [label="Это приводит к своему рода скуке, которая начинает изобретать собственную опасность, Узурпатор. Политика. Придворные интриги. Внезапно мы стали мастерски придумывать изощрённые способы подвергать себя опасности, поскольку мы заменили старые.",shape=box,color=blue];
		1056 -> 1057;
		1056 -> 1058;
	1057 [label="Что привело к этому?",shape=box,color=red];
		1057 -> 1059;
	1058 [label="Что хуже? Быть обстрелянным или быть вынужденным быть начеку?",shape=box,color=red];
		1058 -> 1060;
	1059 [label="В моём... вынужденном пребывании в «Gaule» было очень мало интересных или приятных моментов. Еда была одним из них. А вторыми... были штормы.",shape=box,color=blue];
		1059 -> 1061;
	1060 [label="Ха! Боюсь, у меня нет чётких предпочтений, поскольку я прекрасно разбираюсь в обоих видах искусства. А что ближе тебе?",shape=box,color=blue];
		1060 -> 1062;
		1060 -> 1063;
	1061 [label="Штормы, подобных которым мне не доводилось встречать за все годы пребывания в Орокин. Они сотрясали землю, заставляли дрожать стёкла в деревянных рамах. Их было слышно даже в пыльной крипте, где нас держали.",shape=box,color=blue];
		1061 -> 1064;
	1062 [label="Мне нравится знать, кто мои враги, просто и понятно. Пусть они набросятся на меня с оружием в руках.",shape=box,color=red];
		1062 -> 1065;
	1063 [label="В меня стреляют. Я предпочитаю иметь возможность действовать по своим правилам, чтобы выполнить работу. Время у меня есть.",shape=box,color=red];
		1063 -> 1066;
	1064 [label="Когда они проносились по городу, не доводилось подниматься на колокольню, чтобы подобраться как можно ближе. Мне хотелось почувствовать электричество в воздухе - хлещущий дождь на коже.",shape=box,color=blue];
		1064 -> 1067;
		1064 -> 1068;
		1064 -> 1069;
	1065 [label="Add 1 to Thermostat",color=orange];
		1065 -> 1070;
	1066 [label="Add -1 to Thermostat",color=orange];
		1066 -> 1071;
	1067 [label="Разве это было не слишком опасно?",shape=box,color=red];
		1067 -> 1072;
	1068 [label="Это звучит восхитительно.",shape=box,color=red];
		1068 -> 1073;
	1069 [label="Как Мари и Лион отнеслись к твоим тайным побегам?",shape=box,color=red];
		1069 -> 1074;
	1070 [label="Понимаю твою точку зрения и признаю, что в этом есть определённая простота, которой можно наслаждаться. Сложно спутать врага с чем-то другим, когда оружие направлено прямо тебе в лицо.",shape=box,color=blue];
		1070 -> 1075;
	1071 [label="Мм, сладко, правда? Тщательно продуманный план, мастерски спланированный, воплощается в жизнь? Наблюдать, как всё складывается в единое целое... очень увлекательно.",shape=box,color=blue];
		1071 -> 1075;
	1072 [label="Именно в этом и заключалась суть всего начинания! Не могу описать, каково это, ощущать такую первозданную мощь. Нет, это было нечто большее; это была настоящая сила. Когда взгляд падал на эти клубящиеся, тёмные облака, сверкающие яростными молниями, становилось ясно, что мои предки так отчаянно пытались обуздать.",shape=box,color=blue];
		1072 -> 1076;
	1073 [label="+5 Chemistry",color=orange];
		1073 -> 1077;
	1074 [label="Ты пишешь эти слова так, будто эти слова имели для меня хоть какое-то значение. Они не следовали за мной, если ты об этом. Священнику, я уверен, было бы всё равно, если бы молния сожгла меня на месте. А что касается Мари? Она, вероятно, была слишком занята поклонением своим ложным идолам. Сол или Альбрехт, как хочешь.",shape=box,color=blue];
		1074 -> 1078;
	1075 [label="+5 Chemistry",color=orange];
		1075 -> 1079;
	1076 [label="Более того, было ясно, что моё присутствие там тоже может меня убить, и что рядом не будет Кувы, способной меня оживить. Более того, священная Кува не подействует на моё искажённое и изломанное тело. ",shape=box,color=blue];
		1076 -> 1080;
	1077 [label="Ещё как! Не могу описать, каково это, ощущать такую первозданную мощь. Нет, это было нечто большее; это была настоящая сила. Когда взгляд встретил клубящиеся, тёмные облака, сверкающие яростными молниями, стало очевидно, что мои предки так отчаянно пытались обуздать.",shape=box,color=blue];
		1077 -> 1076;
	1078 [label="Но ощутить такую первозданную мощь? Нет, это было нечто большее; это была настоящая сила. Когда взгляд встретил эти клубящиеся, тёмные облака, сверкающие яростными молниями, стало очевидно, что мои предки так отчаянно пытались обуздать.",shape=box,color=blue];
		1078 -> 1076;
	1079 [label="Однако я считаю, что, как и во всём в жизни, ключ к успеху, умеренность и сочетание того и другого. Пресытившись одним, ты рискуешь отказаться от другого.",shape=box,color=blue];
		1079 -> 1081;
	1080 [label="Меня это напугало. И впервые за… века, наверное, Скиталец, внутри возник страх. Настоящий страх.",shape=box,color=blue];
		1080 -> 1082;
		1080 -> 1083;
	1081 [label="Боюсь, именно так мы создаём таких существ, как Баллас и Ниток. Манипулятор и Кровавая Королева. Бах.",shape=box,color=blue];
		1081 -> 1084;
	1082 [label="Ты боишься умереть?",shape=box,color=red];
		1082 -> 1085;
	1083 [label="Что именно было сделано?",shape=box,color=red];
		1083 -> 1086;
	1084 [label="Но я здесь, чтобы говорить о штормах.",shape=box,color=blue];
		1084 -> 1059;
	1085 [label="Да, похоже на то! Довольно остро, стоит признать. И это было для меня открытием в тот момент. Я не боюсь того, что ждёт меня после смерти, Скиталец. Я просто пока не хочу, чтобы моя жизнь закончилась. Она ещё не прожита до конца.",shape=box,color=blue];
		1085 -> 1087;
	1086 [label="Мне довелось взобраться на каменную балясину рядом с корявой горгульей, раскинуть руки в стороны и... рассмеяться. Рассмеяться навстречу шторму.",shape=box,color=blue];
		1086 -> 1088;
	1087 [label="Уже само по себе это было откровением. Мне довелось взобраться на каменную балясину рядом с корявой горгульей, раскинуть руки в стороны и… рассмеяться. Рассмеяться шторму навстречу.",shape=box,color=blue];
		1087 -> 1089;
	1088 [label="Потому что внезапно пришло понимание, я не боюсь того, что будет после смерти, Скиталец. Я просто пока не хочу, чтобы моя жизнь закончилась. Она ещё не прожита до конца.",shape=box,color=blue];
		1088 -> 1089;
	1089 [label="Несмотря ни на что. Несмотря на опустошение Тау. Несмотря на разрушение Империи Орокин, в неизбежности которого сомнений уже не оставалось. Несмотря уродство моего тела, ставшего... этим безобразием. Несмотря на то, что меня швырнули, в прошлое и бросили на произвол судьбы.",shape=box,color=blue];
		1089 -> 1090;
	1090 [label="Я знал, что найду способ вернуться сюда. В это время. В это место. Туда, где Альбрехт оставил всё своё самое дорогое.",shape=box,color=blue];
		1090 -> 1091;
	1091 [label="+5 Chemistry",color=orange];
		1091 -> 1092;
	1092 [label="Потому что моя жизнь ещё не прожита до конца. Но, клянусь Бездной, я сделаю так, чтобы он закончил свою.",shape=box,color=blue];
		1092 -> 1093;
	1093 [label="Update boolean RoatheEntrati1",color=orange];
		1093 -> 1094;
	1094 [label="Chat ends.",color=orange];
}