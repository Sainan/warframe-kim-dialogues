digraph {
	"RoatheRank2Convo3 begins." [color=orange];
		"RoatheRank2Convo3 begins." -> j4208251187;
	j4208251187 [label="Check boolean RoatheRank2Convo1Complete",color=orange];
		j4208251187 -> j3438455715 [label=true,color=green];
		j4208251187 -> "Chat ends." [label=false,color=brown];
	j3438455715 [label="Check boolean RoatheKnowsReset2",color=orange];
		j3438455715 -> j2283795142 [label=true,color=green];
		j3438455715 -> j3173450942 [label=false,color=brown];
	"Chat ends." [color=orange];
	j2283795142 [label="Я знаю, что это, возможно, звучало для тебя и раньше, но сегодня стало ясно, что мне всё равно - у меня нет терпения.",shape=box,color=blue];
		j2283795142 -> j3173450942;
	j3173450942 [label="Я думаю, что причиной падения Империи Орокин стало слишком много слоёв стекла.",shape=box,color=blue];
		j3173450942 -> j4146193138;
		j3173450942 -> j1411966234;
		j3173450942 -> j1310452999;
	j4146193138 [label="Как так?",shape=box,color=red];
		j4146193138 -> j2232980481;
	j1411966234 [label="Слишком обезличенно?",shape=box,color=red];
		j1411966234 -> j4083740511;
	j1310452999 [label="[Конец.]",shape=box,color=red];
		j1310452999 -> "Chat ends.";
	j2232980481 [label="Представьте себе общество, основанное на осознании того, что ты, по сути, всегда в безопасности. Защищён. Даже от ужасного призрака смерти.",shape=box,color=blue];
		j2232980481 -> j710061206;
	j4083740511 [label="+5 Chemistry",color=orange];
		j4083740511 -> j359940038;
	j710061206 [label="Где ничто не может причинить тебе вред.",shape=box,color=blue];
		j710061206 -> j18414681;
	j359940038 [label="Именно. Слишком оторваны от опасности и реальности происходящего.",shape=box,color=blue];
		j359940038 -> j2232980481;
	j18414681 [label="Это приводит к своему рода скуке, которая начинает изобретать собственную опасность, Узурпатор. Политика. Придворные интриги. Внезапно мы стали мастерски придумывать изощрённые способы подвергать себя опасности, поскольку мы заменили старые.",shape=box,color=blue];
		j18414681 -> j810088647;
		j18414681 -> j1274968064;
	j810088647 [label="Что привело к этому?",shape=box,color=red];
		j810088647 -> j551158495;
	j1274968064 [label="Что хуже? Быть обстрелянным или быть вынужденным быть начеку?",shape=box,color=red];
		j1274968064 -> j545767492;
	j551158495 [label="В моём... вынужденном пребывании в «Gaule» было очень мало интересных или приятных моментов. Еда была одним из них. А вторыми... были штормы.",shape=box,color=blue];
		j551158495 -> j1761633528;
	j545767492 [label="Ха! Боюсь, у меня нет чётких предпочтений, поскольку я прекрасно разбираюсь в обоих видах искусства. А что ближе тебе?",shape=box,color=blue];
		j545767492 -> j948255727;
		j545767492 -> j595017618;
	j1761633528 [label="Штормы, подобных которым мне не доводилось встречать за все годы пребывания в Орокин. Они сотрясали землю, заставляли дрожать стёкла в деревянных рамах. Их было слышно даже в пыльной крипте, где нас держали.",shape=box,color=blue];
		j1761633528 -> j4206363712;
	j948255727 [label="Мне нравится знать, кто мои враги, просто и понятно. Пусть они набросятся на меня с оружием в руках.",shape=box,color=red];
		j948255727 -> j2196335246;
	j595017618 [label="В меня стреляют. Я предпочитаю иметь возможность действовать по своим правилам, чтобы выполнить работу. Время у меня есть.",shape=box,color=red];
		j595017618 -> j3823404443;
	j4206363712 [label="Когда они проносились по городу, не доводилось подниматься на колокольню, чтобы подобраться как можно ближе. Мне хотелось почувствовать электричество в воздухе - хлещущий дождь на коже.",shape=box,color=blue];
		j4206363712 -> j3049291198;
		j4206363712 -> j1990503565;
		j4206363712 -> j2047690101;
	j2196335246 [label="Add 1 to Thermostat counter",color=orange];
		j2196335246 -> j1269931717;
	j3823404443 [label="Add -1 to Thermostat counter",color=orange];
		j3823404443 -> j1368054754;
	j3049291198 [label="Разве это было не слишком опасно?",shape=box,color=red];
		j3049291198 -> j3616211833;
	j1990503565 [label="Это звучит восхитительно.",shape=box,color=red];
		j1990503565 -> j1873114710;
	j2047690101 [label="Как Мари и Лион отнеслись к твоим тайным побегам?",shape=box,color=red];
		j2047690101 -> j4004295889;
	j1269931717 [label="Понимаю твою точку зрения и признаю, что в этом есть определённая простота, которой можно наслаждаться. Сложно спутать врага с чем-то другим, когда оружие направлено прямо тебе в лицо.",shape=box,color=blue];
		j1269931717 -> j1646683609;
	j1368054754 [label="Мм, сладко, правда? Тщательно продуманный план, мастерски спланированный, воплощается в жизнь? Наблюдать, как всё складывается в единое целое... очень увлекательно.",shape=box,color=blue];
		j1368054754 -> j1646683609;
	j3616211833 [label="Именно в этом и заключалась суть всего начинания! Не могу описать, каково это, ощущать такую первозданную мощь. Нет, это было нечто большее; это была настоящая сила. Когда взгляд падал на эти клубящиеся, тёмные облака, сверкающие яростными молниями, становилось ясно, что мои предки так отчаянно пытались обуздать.",shape=box,color=blue];
		j3616211833 -> j783576861;
	j1873114710 [label="+5 Chemistry",color=orange];
		j1873114710 -> j3149547376;
	j4004295889 [label="Ты пишешь эти слова так, будто эти слова имели для меня хоть какое-то значение. Они не следовали за мной, если ты об этом. Священнику, я уверен, было бы всё равно, если бы молния сожгла меня на месте. А что касается Мари? Она, вероятно, была слишком занята поклонением своим ложным идолам. Сол или Альбрехт, как хочешь.",shape=box,color=blue];
		j4004295889 -> j2487448984;
	j1646683609 [label="+5 Chemistry",color=orange];
		j1646683609 -> j219713619;
	j783576861 [label="Более того, было ясно, что моё присутствие там тоже может меня убить, и что рядом не будет Кувы, способной меня оживить. Более того, священная Кува не подействует на моё искажённое и изломанное тело. ",shape=box,color=blue];
		j783576861 -> j2845421431;
	j3149547376 [label="Ещё как! Не могу описать, каково это, ощущать такую первозданную мощь. Нет, это было нечто большее; это была настоящая сила. Когда взгляд встретил клубящиеся, тёмные облака, сверкающие яростными молниями, стало очевидно, что мои предки так отчаянно пытались обуздать.",shape=box,color=blue];
		j3149547376 -> j783576861;
	j2487448984 [label="Но ощутить такую первозданную мощь? Нет, это было нечто большее; это была настоящая сила. Когда взгляд встретил эти клубящиеся, тёмные облака, сверкающие яростными молниями, стало очевидно, что мои предки так отчаянно пытались обуздать.",shape=box,color=blue];
		j2487448984 -> j783576861;
	j219713619 [label="Однако я считаю, что, как и во всём в жизни, ключ к успеху, умеренность и сочетание того и другого. Пресытившись одним, ты рискуешь отказаться от другого.",shape=box,color=blue];
		j219713619 -> j2955030613;
	j2845421431 [label="Меня это напугало. И впервые за… века, наверное, Скиталец, внутри возник страх. Настоящий страх.",shape=box,color=blue];
		j2845421431 -> j59377451;
		j2845421431 -> j4015397249;
	j2955030613 [label="Боюсь, именно так мы создаём таких существ, как Баллас и Ниток. Манипулятор и Кровавая Королева. Бах.",shape=box,color=blue];
		j2955030613 -> j260275587;
	j59377451 [label="Ты боишься умереть?",shape=box,color=red];
		j59377451 -> j1302263414;
	j4015397249 [label="Что именно было сделано?",shape=box,color=red];
		j4015397249 -> j2915452133;
	j260275587 [label="Но я здесь, чтобы говорить о штормах.",shape=box,color=blue];
		j260275587 -> j551158495;
	j1302263414 [label="Да, похоже на то! Довольно остро, стоит признать. И это было для меня открытием в тот момент. Я не боюсь того, что ждёт меня после смерти, Скиталец. Я просто пока не хочу, чтобы моя жизнь закончилась. Она ещё не прожита до конца.",shape=box,color=blue];
		j1302263414 -> j2329768449;
	j2915452133 [label="Мне довелось взобраться на каменную балясину рядом с корявой горгульей, раскинуть руки в стороны и... рассмеяться. Рассмеяться навстречу шторму.",shape=box,color=blue];
		j2915452133 -> j991620210;
	j2329768449 [label="Уже само по себе это было откровением. Мне довелось взобраться на каменную балясину рядом с корявой горгульей, раскинуть руки в стороны и… рассмеяться. Рассмеяться шторму навстречу.",shape=box,color=blue];
		j2329768449 -> j2066050456;
	j991620210 [label="Потому что внезапно пришло понимание, я не боюсь того, что будет после смерти, Скиталец. Я просто пока не хочу, чтобы моя жизнь закончилась. Она ещё не прожита до конца.",shape=box,color=blue];
		j991620210 -> j2066050456;
	j2066050456 [label="Несмотря ни на что. Несмотря на опустошение Тау. Несмотря на разрушение Империи Орокин, в неизбежности которого сомнений уже не оставалось. Несмотря уродство моего тела, ставшего... этим безобразием. Несмотря на то, что меня швырнули, в прошлое и бросили на произвол судьбы.",shape=box,color=blue];
		j2066050456 -> j2184272016;
	j2184272016 [label="Я знал, что найду способ вернуться сюда. В это время. В это место. Туда, где Альбрехт оставил всё своё самое дорогое.",shape=box,color=blue];
		j2184272016 -> j1958402947;
	j1958402947 [label="+5 Chemistry",color=orange];
		j1958402947 -> j1783947479;
	j1783947479 [label="Потому что моя жизнь ещё не прожита до конца. Но, клянусь Бездной, я сделаю так, чтобы он закончил свою.",shape=box,color=blue];
		j1783947479 -> j3359792563;
	j3359792563 [label="Boolean RoatheEntrati1 is now true.",color=orange];
		j3359792563 -> "Chat ends.";
}