	"Chat ends." [color=orange];
	j428076267 [label="ГС: ОГОНЬ",shape=box,color=blue];
		j428076267 -> j1198159256;
	j1198159256 [label="Стенограмма: Чудовищность и излишества в прошлом служили нам верой и правдой. От меня ожидали, что я буду применять их в качестве военной тактики.",shape=box,color=blue];
		j1198159256 -> j3821872722;
	j3821872722 [label="Как же мы усмирили Заражение во времена наших предков? Конечно же, разорвав сердце атома, словно бутон розы!",shape=box,color=blue];
		j3821872722 -> j4132477562;
	j4132477562 [label="Все Семь повелели мне, как единому целому, превратиться в Дьявола с трезубцем, полным боеголовок, и в сеятеля с мешком, наполненным безудержным излучением.",shape=box,color=blue];
		j4132477562 -> j2477266673;
	j2477266673 [label="В тот день мы поняли, что Владеющие Разумом способны не только сводить на нет наши технологии, но и захватывать их под свой контроль.",shape=box,color=blue];
		j2477266673 -> j1947873865;
	j1947873865 [label="Стая злобных крошечных дронов нивелировщиков, которых мы отправили вперёд, весело вернулась к нам, всё ещё нагруженная бомбами, похрюкивая на неизвестных слогах и взрываясь прямо в чреве тех самых материнских кораблей, что их и выпустили.",shape=box,color=blue];
		j1947873865 -> j921430358;
	j921430358 [label="Add 1 to HellStory counter",color=orange];
		j921430358 -> "Chat ends.";
}