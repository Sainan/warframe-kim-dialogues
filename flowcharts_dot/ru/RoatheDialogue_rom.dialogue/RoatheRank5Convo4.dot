		j2692715112 -> j4173009787;
	j1261894279 [label="Boolean RoatheResetDealComplete is now true.",color=orange];
		j1261894279 -> j383688141;
	j2487728037 [label="Мы заключили сделку, Скиталец. Тебя устраивает то, на чем ты остановился с Мари и её мнением об Альбрехте? По мне так эта маленькая парящая подхалимка всё так же непоколебима.",shape=box,color=blue];
		j2487728037 -> j2264716046;
	j310759115 [label="Мы заключили сделку, Скиталец. Ты доволен тем, на чём остановился с Лионом? По мне так этот бедняга выглядит таким же расстроенным, как и всегда.",shape=box,color=blue];
		j310759115 -> j2099623384;
	j2324125239 [label="Как ты думаешь, что стало с Ниток?",shape=box,color=red];
		j2324125239 -> j2454174086;
	j1310452999 [label="[Конец.]",shape=box,color=red];
		j1310452999 -> "Chat ends.";
	j4173009787 [label="У нас была договорённость, Скиталец. И хотя тебе, по всей видимости, не потребовалась моя помощь с Мари, важно помнить, что дьявол всегда забирает своё.",shape=box,color=blue];
		j4173009787 -> j1141012592;
	j383688141 [label="У нас была договорённость, Скиталец. И хотя тебе, по всей видимости, не потребовалась моя помощь с Лионом, важно помнить, что дьявол всегда забирает своё.",shape=box,color=blue];
		j383688141 -> j1141012592;
	j2264716046 [label="Boolean RoatheResetDealComplete is now true.",color=orange];
		j2264716046 -> j837175264;
		j2264716046 -> j3987334296;
	j2099623384 [label="Boolean RoatheResetDealComplete is now true.",color=orange];
		j2099623384 -> j2478613730;
		j2099623384 -> j693751819;
	j2454174086 [label="Какой поразительный вопрос. Подобные мысли возникали у меня не раз после превращения в эту заражённую амальгаму.",shape=box,color=blue];
		j2454174086 -> j3852195898;
	j1141012592 [label="Я приду за тем, что мне положено, независимо от того, понадобилось ли тебе использовать свою часть контракта.",shape=box,color=blue];
		j1141012592 -> j859035553;
		j1141012592 -> j3563602395;
	j837175264 [label="Мне не удалось сдвинуть её с места...",shape=box,color=red];
		j837175264 -> j543614156;
	j3987334296 [label="Можно оставить всё как есть. Мне не нужна твоя помощь.",shape=box,color=red];
		j3987334296 -> j107274385;
	j2478613730 [label="Нет, я чувствую, что подвёл его.",shape=box,color=red];
		j2478613730 -> j2685339619;
	j693751819 [label="Можно оставить всё как есть. Мне не нужна твоя помощь.",shape=box,color=red];
		j693751819 -> j2180707592;
	j3852195898 [label="Но теперь, когда мои воспоминания полностью вернулись, я ловлю себя на том, что думаю о ней всё чаще.",shape=box,color=blue];
		j3852195898 -> j2023454265;
	j859035553 [label="И что это такое, в точности? От тебя так и не прозвучало, чего ожидается от этого.",shape=box,color=red];
		j859035553 -> j2596303275;
	j3563602395 [label="Думаю, ты блефуешь. Мне кажется, у тебя даже нет плана насчёт того, чего именно ты хочешь. ",shape=box,color=red];
		j3563602395 -> j1994148615;
	j543614156 [label="Тогда я решу эту проблему за тебя, и довольно скоро приду за тем, что мне положено.",shape=box,color=blue];
		j543614156 -> j1230248859;
		j543614156 -> j1025104569;
	j107274385 [label="Можешь и воспользоваться этим. Я всё равно приду за тем, что мне положено, вне зависимости от того, воспользуешься ли ты своей частью контракта.",shape=box,color=blue];
		j107274385 -> j1025104569;
		j107274385 -> j1230248859;
	j2685339619 [label="Тогда я решу эту проблему за тебя, и довольно скоро приду за тем, что мне положено.",shape=box,color=blue];
		j2685339619 -> j2523910595;
		j2685339619 -> j3433495382;
	j2180707592 [label="Можешь и воспользоваться этим. Я всё равно приду за тем, что мне положено, вне зависимости от того, воспользуешься ли ты своей частью контракта.",shape=box,color=blue];
		j2180707592 -> j2523910595;
		j2180707592 -> j3433495382;
	j2023454265 [label="Важно понять, насколько сложными и даже разрушительными были отношения с этим человеком. Трудно точно передать степень привязанности. И столь же трудно описать силу отторжения. ",shape=box,color=blue];
		j2023454265 -> j1116960282;
	j2596303275 [label="Осознаешь ли ты, какая сила в тебе заключена, да? И насколько ценным могло бы быть твоё присутствие в моём распоряжении?",shape=box,color=blue];
		j2596303275 -> j2051934682;
	j1994148615 [label="Здесь значение имеет вовсе не «что», а «кто», Узурпатор.",shape=box,color=blue];
		j1994148615 -> j2596303275;
	j1230248859 [label="Думаю, ты блефуешь. Мне кажется, у тебя даже нет плана насчёт того, чего именно ты хочешь. ",shape=box,color=red];
		j1230248859 -> j3200194340;
	j1025104569 [label="И что это такое, в точности? От тебя так и не прозвучало, чего ожидается от этого.",shape=box,color=red];
		j1025104569 -> j1835934539;
	j2523910595 [label="И что это такое, в точности? От тебя так и не прозвучало, чего ожидается от этого.",shape=box,color=red];
		j2523910595 -> j251065257;
	j3433495382 [label="Думаю, ты блефуешь. Мне кажется, у тебя даже нет плана насчёт того, чего именно ты хочешь. ",shape=box,color=red];
		j3433495382 -> j553456759;
	j1116960282 [label="Что ещё более важно, она заставила меня презирать каждую частичку себя, вплоть до самой сути. И всё же без неё не было бы самого факта моего существования. Не было бы того, кем я являюсь сейчас.",shape=box,color=blue];
		j1116960282 -> j3118531709;
	j2051934682 [label="Полагаю, это то, что в старину называли «пустым чеком». И он был подписан вполне добровольно.",shape=box,color=blue];
		j2051934682 -> j626178445;
	j3200194340 [label="Здесь значение имеет вовсе не «что», а «кто», Узурпатор.",shape=box,color=blue];
		j3200194340 -> j1835934539;
	j1835934539 [label="Осознаешь ли ты, какая сила в тебе заключена, да? И насколько ценным могло бы быть твоё присутствие в моём распоряжении?",shape=box,color=blue];
		j1835934539 -> j2625588435;
	j251065257 [label="Осознаешь ли ты, какая сила в тебе заключена, да? И насколько ценным могло бы быть твоё присутствие в моём распоряжении?",shape=box,color=blue];
		j251065257 -> j1781220970;
	j553456759 [label="Здесь значение имеет вовсе не «что», а «кто», Узурпатор.",shape=box,color=blue];
		j553456759 -> j251065257;
	j3118531709 [label="Она создала меня. Она же разрушила меня. ",shape=box,color=blue];
		j3118531709 -> j2748055641;
	j626178445 [label="+5 Chemistry",color=orange];
		j626178445 -> j1633894841;
	j2625588435 [label="Полагаю, это то, что в старину называли «пустым чеком». И он был подписан вполне добровольно. Так что скажешь? Нужна тебе моя помощь с Мари или нет?",shape=box,color=blue];
		j2625588435 -> j974462006;
		j2625588435 -> j3459777001;
	j1781220970 [label="Полагаю, это то, что в старину называли «пустым чеком». И он был подписан вполне добровольно. Так что скажешь? Нужна тебе моя помощь с Лионом или нет?",shape=box,color=blue];
		j1781220970 -> j2396339149;
		j1781220970 -> j2129458481;
	j2748055641 [label="Я любил её. Я хотел её смерти.",shape=box,color=blue];
		j2748055641 -> j1396949035;
	j1633894841 [label="Есть только одна вещь опаснее дьявола... это дьявол с такими друзьями, как ты, у которых есть долги к уплате.",shape=box,color=blue];
		j1633894841 -> "Chat ends.";
	j974462006 [label="Да, хорошо...",shape=box,color=red];
		j974462006 -> j3434199821;
	j3459777001 [label="Нет. Оставь всё как есть.",shape=box,color=red];
		j3459777001 -> j290700711;
	j2396339149 [label="Да, хорошо...",shape=box,color=red];
		j2396339149 -> j3394201628;
	j2129458481 [label="Нет. Оставь всё как есть.",shape=box,color=red];
		j2129458481 -> j1549882053;
