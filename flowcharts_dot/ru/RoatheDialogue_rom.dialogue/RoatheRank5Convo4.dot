		j3394201628 -> j1131805251;
	j1549882053 [label="Boolean RoatheLyonConfessionDeal is now false.",color=orange];
		j1549882053 -> j3821121742;
	j2738869171 [label="Check boolean RoatheDating",color=orange];
		j2738869171 -> j2777013780 [label=true,color=green];
		j2738869171 -> j2907088354 [label=false,color=brown];
	j861371518 [label="Boolean RoatheMarieEntratiDeal is now false.",color=orange];
		j861371518 -> j111569788;
	j3821121742 [label="Как пожелаешь. Только помни, что единственное, что опаснее дьявола... это дьявол с такими друзьями, как ты, у которых есть долги к уплате.",shape=box,color=blue];
		j3821121742 -> "Chat ends.";
	j1131805251 [label="Boolean RoatheLyonConfessionDeal is now false.",color=orange];
		j1131805251 -> j4133417489;
	j2777013780 [label="Надеюсь, это не вызовет у тебя чувства ревности. Такой цели нет. Я просто пытаюсь объяснить, сколько вреда она мне причинила.",shape=box,color=blue];
		j2777013780 -> j411206940;
	j2907088354 [label="Без неё я бы не стал тем, кем являюсь. Всё, что мне известно, было получено от неё. Она взяла сырую глину и придала ей форму.",shape=box,color=blue];
		j2907088354 -> j167816109;
		j2907088354 -> j4189477553;
		j2907088354 -> j3224908528;
	j111569788 [label="+5 Chemistry",color=orange];
		j111569788 -> j1693277325;
	j4133417489 [label="+5 Chemistry",color=orange];
		j4133417489 -> j1425529623;
	j411206940 [label="И при этом, в то же самое мгновение, сколько я ей обязан. Без неё я бы не стал тем, кем являюсь. Всё, что мне известно, было получено от неё. Она взяла сырую глину и придала ей форму.",shape=box,color=blue];
		j411206940 -> j167816109;
		j411206940 -> j1810002809;
		j411206940 -> j3514117086;
	j167816109 [label="Понимаю. Когда-то у меня тоже были похожие отношения.",shape=box,color=red];
		j167816109 -> j617733029;
	j4189477553 [label="Похоже, ты действительно не совсем оправился от своих чувств к ней.",shape=box,color=red];
		j4189477553 -> j554909576;
	j3224908528 [label="Ты думаешь, она всё ещё жива? Или считаешь, что она умерла?",shape=box,color=red];
		j3224908528 -> j591778209;
	j1693277325 [label="Считай, что вопрос решён. Только помни, что единственное, что опаснее дьявола... это дьявол с такими друзьями, как ты, у которых есть долги к уплате.",shape=box,color=blue];
		j1693277325 -> "Initiate conversation MarieRoatheRepair in /Lotus/Types/Gameplay/1999Wf/Dialogue/MarieDialogue_rom.dialogue";
	j1425529623 [label="Считай, что вопрос решён. Только помни, что единственное, что опаснее дьявола... это дьявол с такими друзьями, как ты, у которых есть долги к уплате.",shape=box,color=blue];
		j1425529623 -> "Initiate conversation LyonRoatheRepair in /Lotus/Types/Gameplay/1999Wf/Dialogue/LyonDialogue_rom.dialogue";
	j1810002809 [label="Понимаю. Всё в порядке.",shape=box,color=red];
		j1810002809 -> j1449784165;
	j3514117086 [label="Мне бы хотелось, чтобы ты не говорил о ней.",shape=box,color=red];
		j3514117086 -> j2779257872;
	j617733029 [label="+5 Chemistry",color=orange];
		j617733029 -> j1102814639;
	j554909576 [label="Это не совсем точно. Я уже нет. Я больше не люблю её. Мне больше не важно, умрёт ли она мучительной смертью от моих рук. Но при этом меня непреодолимо тянет узнать, как закончилась её история.",shape=box,color=blue];
		j554909576 -> j3850628083;
	j591778209 [label="Трудно поверить, что кто-то с таким вкусом к крови и смерти мог оставаться столь тихим все эти столетия.",shape=box,color=blue];
		j591778209 -> j1086823240;
	"Initiate conversation MarieRoatheRepair in /Lotus/Types/Gameplay/1999Wf/Dialogue/MarieDialogue_rom.dialogue" [label="Initiate conversation MarieRoatheRepair in /Lotus/Types/Gameplay/1999Wf/Dialogue/MarieDialogue_rom.dialogue",color=orange];
		"Initiate conversation MarieRoatheRepair in /Lotus/Types/Gameplay/1999Wf/Dialogue/MarieDialogue_rom.dialogue" -> "Chat ends.";
	"Initiate conversation LyonRoatheRepair in /Lotus/Types/Gameplay/1999Wf/Dialogue/LyonDialogue_rom.dialogue" [label="Initiate conversation LyonRoatheRepair in /Lotus/Types/Gameplay/1999Wf/Dialogue/LyonDialogue_rom.dialogue",color=orange];
		"Initiate conversation LyonRoatheRepair in /Lotus/Types/Gameplay/1999Wf/Dialogue/LyonDialogue_rom.dialogue" -> "Chat ends.";
	j1449784165 [label="Именно из-за прошлого мне любопытно узнать, что с ней стало. Просто потому что я хочу знать, как закончилась её история. Если она вообще закончилась.",shape=box,color=blue];
		j1449784165 -> j3850628083;
	j2779257872 [label="Прошу прощения, но упоминание исходило от тебя. Ты, Скиталец, и впрямь умеешь удивлять своей непредсказуемостью.",shape=box,color=blue];
		j2779257872 -> "Chat ends.";
	j1102814639 [label="Тогда ты можешь понять, почему мне интересно узнать, что с ней стало. Просто потому что я хочу знать, чем закончилась её история. Если она вообще закончилась.",shape=box,color=blue];
		j1102814639 -> j3850628083;
	j3850628083 [label="Трудно избавиться от тех, кто сыграл важную роль в твоей собственной истории. Как бы ядовиты они ни были.",shape=box,color=blue];
		j3850628083 -> j591778209;
	j1086823240 [label="Если она всё ещё жива, то это она не по своей воле устроила засаду.",shape=box,color=blue];
		j1086823240 -> j2947891975;
	j2947891975 [label="Однако, скажу вот что. Если она всё ещё жива?",shape=box,color=blue];
		j2947891975 -> j1417843935;
	j1417843935 [label="+5 Chemistry",color=orange];
		j1417843935 -> j667461308;
	j667461308 [label="Ты можешь обнаружить себя в молитвах о возвращении Балласа.",shape=box,color=blue];
		j667461308 -> "Chat ends.";
}