	j381523561 [label="У тебя есть средства. У тебя есть сила. Ты достаточно громко высказывал своё недовольство своей ситуацией.",shape=box,color=red];
		j381523561 -> j8933047;
	j1996004577 [label="Я просто не понимаю, почему «Дьявол Тау» доволен тем, что сидит в склепе и бездельничает. Даже с учетом нашей сделки.",shape=box,color=red];
		j1996004577 -> j2206556128;
	j625217791 [label="Ты — Орокин. Ты явно ненавидишь всех вокруг. Что тебя останавливает?",shape=box,color=red];
		j625217791 -> j2281242995;
	j969162488 [label="Я просто не понимаю, почему «Дьявол Тау» доволен тем, что сидит в склепе и бездельничает. Особенно учитывая, что у нас нет никакой договоренности.",shape=box,color=red];
		j969162488 -> j3657429577;
	j8933047 [label="+5 Chemistry",color=orange];
		j8933047 -> j722848769;
	j2206556128 [label="Check boolean RoatheKnowsReset2",color=orange];
		j2206556128 -> j2554297528 [label=true,color=green];
		j2206556128 -> j1831703830 [label=false,color=brown];
	j2281242995 [label="Прошу простить, я возьму минуту, чтобы собрать мысли, прежде чем начать этот разговор, полностью движимый яростью и злобой.",shape=box,color=blue];
		j2281242995 -> j1107992280;
	j3657429577 [label="Check boolean RoatheKnowsReset2",color=orange];
		j3657429577 -> j2554297528 [label=true,color=green];
		j3657429577 -> j1931635317 [label=false,color=brown];
	j722848769 [label="И меня радует, что ты признаёшь, мне достаточно одного желания, чтобы превратить это место в бойню.",shape=box,color=blue];
		j722848769 -> j514200861;
	j2554297528 [label="Потому что остаётся загадка, почему я доверял тебе настолько, чтобы рассказать так многое, лишь затем, чтобы ты предал это доверие, Узурпатор.",shape=box,color=blue];
		j2554297528 -> j3251042373;
	j1831703830 [label="Работа ещё не завершена, Узурпатор. Я ведь не смогу получить твою помощь в восстановлении всех своих воспоминаний, если начну убивать всех вокруг, верно?",shape=box,color=blue];
		j1831703830 -> j627997103;
	j1107992280 [label="Я очень стараюсь не доказывать сразу твою правоту.",shape=box,color=blue];
		j1107992280 -> j918032615;
	j1931635317 [label="Возможно, я надеюсь, что ты поумнеешь и передумаешь. А шансы на это резко падают, если я перебью всех вокруг, не так ли?",shape=box,color=blue];
		j1931635317 -> j627997103;
	j514200861 [label="Но ведь это ничего не даст, не так ли? Если чему-то и можно научиться на войне, так это тому, что убийство в конечном итоге приносит до ужаса мало пользы.",shape=box,color=blue];
		j514200861 -> j4239960095;
	j3251042373 [label="А вероятность этого резко снижается, если я перебью всех вокруг, не так ли? Если чему-то и можно научиться на войне, так это тому, что убийство в конечном итоге приносит до ужаса мало пользы.",shape=box,color=blue];
		j3251042373 -> j2537909023;
	j627997103 [label="Кроме того, это ничего не даст, не так ли? Если чему-то и можно научиться на войне, так это тому, что убийство в конечном итоге приносит до ужаса мало пользы.",shape=box,color=blue];
		j627997103 -> j2537909023;
	j918032615 [label="Я сочувствую твоей ненависти к Орокин. Поверь мне. Большинство Орокин презирали Орокин. Я прекрасно осознаю наши преступления. Все те мерзости, что мы совершили. ",shape=box,color=blue];
		j918032615 -> j1493198051;
	j4239960095 [label="Как бы ни было приятно время от времени испытывать желание посвятить этому немного времени.",shape=box,color=blue];
		j4239960095 -> j900044542;
		j4239960095 -> j2770448205;
		j4239960095 -> j2795714017;
	j2537909023 [label="Как бы ни было приятно время от времени испытывать желание посвятить этому немного времени.",shape=box,color=blue];
		j2537909023 -> j2795714017;
		j2537909023 -> j2770448205;
		j2537909023 -> j900044542;
	j1493198051 [label="Одного лишь Театра Юван было бы достаточно, чтобы сжечь наше общество до основания. Но ты одним махом осуждаешь весь народ, частью которого, позволь напомнить, был и ты сам, мой Узурпатор!",shape=box,color=blue];
		j1493198051 -> j3806081375;
	j900044542 [label="Итак, единственная причина, по которой ты позволил всем жить, это то, что убивать их было бы бессмысленно?",shape=box,color=red];
		j900044542 -> j3236546215;
	j2770448205 [label="Есть какая‑то другая причина, по которой ты позволяешь всем жить?",shape=box,color=red];
		j2770448205 -> j1558027697;
	j2795714017 [label="Даже Мария и Лион?",shape=box,color=red];
		j2795714017 -> j3833334656;
	j3806081375 [label="Ты ничего не знаешь о тех добрых душах, что трудились и умирали внутри этих золотых стен. О сагах, написанных о жизнях, что были утрачены временем.",shape=box,color=blue];
		j3806081375 -> j2083012653;
	j3236546215 [label="Убить их было бы бессмысленно. Разве не так? Ты пытаешься убедить меня в обратном? Узурпатор, я впечатлён — никогда бы не подумал, что ты такой коварный монстр!",shape=box,color=blue];
		j3236546215 -> j3467540567;
		j3236546215 -> j3903933041;
	j1558027697 [label="Если уж ты собираешься намекать, Узурпатор, то лучше скажи прямо.",shape=box,color=blue];
		j1558027697 -> j3467540567;
		j1558027697 -> j3903933041;
	j3833334656 [label="Я почти уверен, что если бы ты спустился в склеп и обнаружил два кровавых пятна на том месте, где раньше стояли фанатики, я бы получил за это хорошую взбучку, не так ли?",shape=box,color=blue];
		j3833334656 -> j739012595;
	j2083012653 [label="Реки слёз, пролитых за трагедии, которые навсегда останутся безымянными, просто потому что они тебе неизвестны.",shape=box,color=blue];
		j2083012653 -> j1337324218;
	j3467540567 [label="Вполне нормально признаться, что тебе нравится компания. Люди способны на большее, чем просто выполнять утилитарные функции.",shape=box,color=red];
		j3467540567 -> j796436421;
	j3903933041 [label="Вполне нормально признать, что мы боремся с одиночеством, даже если это раздражает тебя.",shape=box,color=red];
		j3903933041 -> j134072315;
	j739012595 [label="От тебя, или от дворецкого, или от Тэнно, или от ужасной «Матери» Тэнно. Фу. Вот эта. Она меня тревожит. Тема для другого раза.",shape=box,color=blue];
		j739012595 -> j3903933041;
		j739012595 -> j3467540567;
	j1337324218 [label="Я слышу, как твой двойник плачет, произнося имя Адиc. ",shape=box,color=blue];
		j1337324218 -> j2160647437;
	j796436421 [label="Add 1 to Thermostat counter",color=orange];
		j796436421 -> j3607629830;
	j134072315 [label="Add -1 to Thermostat counter",color=orange];
		j134072315 -> j36104292;
	j2160647437 [label="Адис был одним из миллионов.",shape=box,color=blue];
		j2160647437 -> j556973647;
	j3607629830 [label="Evaluate expressions",color=orange];
		j3607629830 -> j3186914559 [label="RoatheUnloved2",color=purple];
		j3607629830 -> j3186914559 [label="RoatheUnloved1",color=purple];
		j3607629830 -> j3186914559 [label="RoatheAlone1",color=purple];
