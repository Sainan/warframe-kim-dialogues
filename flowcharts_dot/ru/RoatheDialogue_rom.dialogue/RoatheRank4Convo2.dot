		j3607629830 -> j94129585 [label="false",color=purple];
	j36104292 [label="Evaluate expressions",color=orange];
		j36104292 -> j2558330435 [label="RoatheUnloved2",color=purple];
		j36104292 -> j2558330435 [label="RoatheUnloved1",color=purple];
		j36104292 -> j2558330435 [label="RoatheAlone1",color=purple];
		j36104292 -> j2558330435 [label="RoatheBirdThree",color=purple];
		j36104292 -> j2059224835 [label="false",color=purple];
	j556973647 [label="Их имена уникальны для тебя.",shape=box,color=blue];
		j556973647 -> j113180132;
	j3186914559 [label="Не испытывай удачу, Узурпатор. «Приятно» - это слишком сильное слово. Скорее, ты прирастаешь ко мне. Как плесень.",shape=box,color=blue];
		j3186914559 -> j1328807703;
	j94129585 [label="«Радость?» Это вот оно? Я и не подозревал, что я такой мазохист. Хм. Или это просто ощущение, как моё тело разлагается, и чувство, что вы все «прирастаете ко мне»?",shape=box,color=blue];
		j94129585 -> j1616913578;
	j2558330435 [label="В какой-то степени приятно иметь кого‑то, с кем можно поговорить. Даже если вы, как ты и сказал, порой раздражающие.",shape=box,color=blue];
		j2558330435 -> j2245793010;
	j2059224835 [label="Одиночество? Пф. Единственное, что вы удерживаете вдали, — это остатки рассудка, которые пытаются вернуться в мою жизнь. Если ты пытаешься намекнуть, что вы все «прирастаете ко мне», знаешь, что ещё делает то же самое?",shape=box,color=blue];
		j2059224835 -> j691934051;
	j113180132 [label="Но не для звёзд.",shape=box,color=blue];
		j113180132 -> j599633565;
	j1328807703 [label="+5 Chemistry",color=orange];
		j1328807703 -> j689414758;
	j1616913578 [label="Как плесень.",shape=box,color=blue];
		j1616913578 -> j689414758;
	j2245793010 [label="+5 Chemistry",color=orange];
		j2245793010 -> j1723377674;
	j691934051 [label="Плесень.",shape=box,color=blue];
		j691934051 -> j689414758;
	j599633565 [label="Окрашивай мой род в багряный, сколько пожелаешь. Плавь золото Орокин и называй нас монстрами. Мы заслужили каждую каплю яда, которую ты можешь на нас излить.",shape=box,color=blue];
		j599633565 -> j1104982137;
	j689414758 [label="Boolean RoatheAlone2 is now true.",color=orange];
		j689414758 -> j1654361623;
	j1723377674 [label="Признаю, ты… прирастаешь ко мне. Как плесень.",shape=box,color=blue];
		j1723377674 -> j689414758;
	j1104982137 [label="Но не смей ни на секунду верить, что это всё, на что мы были способны.",shape=box,color=blue];
		j1104982137 -> j2171692143;
	j1654361623 [label="Check boolean LoidFamilyComplete",color=orange];
		j1654361623 -> j1933300832 [label=true,color=green];
		j1654361623 -> j4185080770 [label=false,color=brown];
	j2171692143 [label="Если ты хочешь истребить всех Орокин? Поднимись по лестнице. У тебя есть несколько выживших образцов, которые не смогут избежать твоего гнева. Начни с «Бабушки».",shape=box,color=blue];
		j2171692143 -> j830646014;
	j1933300832 [label="+10 Chemistry",color=orange];
		j1933300832 -> "Chat ends.";
	j4185080770 [label="Есть ещё одна причина, по которой я не устроил безумный, кровожадный, чудовищный разгул, Узурпатор.",shape=box,color=blue];
		j4185080770 -> j2448476622;
	j830646014 [label="Она, в конце концов, видела больше всего из нашего рода.",shape=box,color=blue];
		j830646014 -> j155006797;
	j2448476622 [label="Мне ещё предстоит увидеть развязку небольшой драмы между нашим дорогим дворецким и отчуждённой семьёй Альбрехта, живущей наверху.",shape=box,color=blue];
		j2448476622 -> j1024247415;
	j155006797 [label="Boolean RoatheNoDate is now true.",color=orange];
		j155006797 -> "Chat ends.";
	j1024247415 [label="Не забывай, у меня есть личный интерес во всём этом, вне зависимости от того, есть у нас договорённость или нет. Я собираюсь сделать так, чтобы когда Альбрехт впервые ступит обратно в этот Санктум, первым лицом, которое он увидит, будет?",shape=box,color=blue];
		j1024247415 -> j1461618597;
	j1461618597 [label="Это будет моё.",shape=box,color=blue];
		j1461618597 -> j3568045348;
	j3568045348 [label="Я просто ещё не могу решить, будут ли вокруг меня лежать тела его близких к тому моменту, когда он это сделает.",shape=box,color=blue];
		j3568045348 -> j1770081121;
	j1770081121 [label="Решения, решения...",shape=box,color=blue];
		j1770081121 -> j1933300832;
}