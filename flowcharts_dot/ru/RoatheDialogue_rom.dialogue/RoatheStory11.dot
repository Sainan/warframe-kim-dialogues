	j3474596315 [label="VM: DIVISION",shape=box,color=blue];
		j3474596315 -> j329945826;
	j329945826 [label="Стенограмма: После первого вторжения Владеющих Разумом в Систему и катастрофического ответа Орокин воцарилась странная тишина.",shape=box,color=blue];
		j329945826 -> j968104561;
	j968104561 [label="Мы не получали известий от наших людей, застрявших на Тау, и не имели способа узнать, блокируются ли их сигналы или они были полностью уничтожены.",shape=box,color=blue];
		j968104561 -> j914380969;
	j914380969 [label="Ко мне обратились за советом. Как от стратега, от меня ожидали понимания врага.",shape=box,color=blue];
		j914380969 -> j915154329;
	j915154329 [label="Владеющие Разумом могли в любой момент уничтожить терминал Солнечного Монорельса над Тау, и всё же Монорельс всё ещё функционировал.",shape=box,color=blue];
		j915154329 -> j3961779914;
	j3961779914 [label="Why? What did they gain from leaving the gate open?",shape=box,color=blue];
		j3961779914 -> j3273990187;
	j3273990187 [label="Were they united in their aggression, or did some yet hope for peaceful coexistence?",shape=box,color=blue];
		j3273990187 -> j921430358;
	j921430358 [label="Add 1 to HellStory counter",color=orange];
		j921430358 -> "Chat ends.";
}