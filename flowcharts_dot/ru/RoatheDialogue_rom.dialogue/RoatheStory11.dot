		j476961537 -> j518236405;
	j518236405 [label="Стенограмма: После первого вторжения Владеющих Разумом в Систему и катастрофического ответа Орокин воцарилась странная тишина.",shape=box,color=blue];
		j518236405 -> j3369423975;
	j3369423975 [label="Мы не получали известий от наших людей, застрявших на Тау, и не имели способа узнать, блокируются ли их сигналы или они были полностью уничтожены.",shape=box,color=blue];
		j3369423975 -> j2896194610;
	j2896194610 [label="Ко мне обратились за советом. Как от стратега, от меня ожидали понимания врага.",shape=box,color=blue];
		j2896194610 -> j1181415088;
	j1181415088 [label="Владеющие Разумом могли в любой момент уничтожить терминал Солнечного Монорельса над Тау, и всё же Монорельс всё ещё функционировал.",shape=box,color=blue];
		j1181415088 -> j1453170016;
	j1453170016 [label="Почему? Какую выгоду они получили, оставив ворота открытыми?",shape=box,color=blue];
		j1453170016 -> j2939965992;
	j2939965992 [label="Были ли они едины в своей агрессии или кто-то из них всё ещё надеялся на мирное сосуществование?",shape=box,color=blue];
		j2939965992 -> j921430358;
	j921430358 [label="Add 1 to HellStory counter",color=orange];
		j921430358 -> "Chat ends.";
