	j3346838820 [label="ГС: НАКАЗАНИЕ",shape=box,color=blue];
		j3346838820 -> j1729691738;
	j1729691738 [label="Транскрипт: Именно Скарне, вспыльчивый, остроумный и язвительный, первым предложил этот план ещё до войны. «Мы должны покинуть гнездо, ведь гнездо в огне».",shape=box,color=blue];
		j1729691738 -> j2237656604;
	j2237656604 [label="Из‑за чрезмерной эксплуатации и безрассудных экспериментов мы испортили Систему так, что надежды на её восстановление больше не было.",shape=box,color=blue];
		j2237656604 -> j2745953593;
	j2745953593 [label="Расширение к новым горизонтам теперь было нашим единственным выходом. ",shape=box,color=blue];
		j2745953593 -> j4043995209;
	j4043995209 [label="Это он также стал инициатором трусливых башен в Бездне.",shape=box,color=blue];
		j4043995209 -> j2228561190;
	j2228561190 [label="Страх перед возвращением Владеющих Разумом был в нём настолько силён, что он мог представить себе только отступление к островам Бездны.",shape=box,color=blue];
		j2228561190 -> j3997659941;
	j3997659941 [label="Как скромно мы оценивали храбрость Владеющих Разумом.",shape=box,color=blue];
		j3997659941 -> j3211111918;
	j3211111918 [label="Они добровольно терпели обжигающий огонь Бездны исключительно ради возможности наказать нас.",shape=box,color=blue];
		j3211111918 -> j921430358;
	j921430358 [label="Add 1 to HellStory counter",color=orange];
		j921430358 -> "Chat ends.";
