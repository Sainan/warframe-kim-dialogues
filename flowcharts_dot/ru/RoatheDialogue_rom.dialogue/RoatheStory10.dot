	j2223048122 [label="VM: PUNISHMENT",shape=box,color=blue];
		j2223048122 -> j29536834;
	j29536834 [label="Транскрипт: Именно Скарне, вспыльчивый, остроумный и язвительный, первым предложил этот план ещё до войны. «Мы должны покинуть гнездо, ведь гнездо в огне».",shape=box,color=blue];
		j29536834 -> j3216377151;
	j3216377151 [label="Из‑за чрезмерной эксплуатации и безрассудных экспериментов мы испортили Систему так, что надежды на её восстановление больше не было.",shape=box,color=blue];
		j3216377151 -> j1193118258;
	j1193118258 [label="Расширение к новым горизонтам теперь было нашим единственным выходом. ",shape=box,color=blue];
		j1193118258 -> j3609749093;
	j3609749093 [label="He, too, inaugurated the cowardly Towers in the Void.",shape=box,color=blue];
		j3609749093 -> j1100827851;
	j1100827851 [label="Страх перед возвращением Владеющих Разумом был в нём настолько силён, что он мог представить себе только отступление к островам Бездны.",shape=box,color=blue];
		j1100827851 -> j1078327309;
	j1078327309 [label="How little credit we gave the Sentients for courage.",shape=box,color=blue];
		j1078327309 -> j1060071859;
	j1060071859 [label="They willingly endured the Void’s scalding fire purely for the chance to punish us.",shape=box,color=blue];
		j1060071859 -> j921430358;
	j921430358 [label="Add 1 to HellStory counter",color=orange];
		j921430358 -> "Chat ends.";
}