	906 [label="Evaluate expressions on HellStory",color=orange];
		906 -> 919 [label="x >= 21",color=purple];
		906 -> 918 [label="x < 21",color=purple];
		906 -> 918 [label="false",color=purple];
	907 [label="Мм, да. Впрочем, тебе, вероятно, не приходилось иметь дело с другим протофреймом, чьи воспоминания... раздроблены, так же как мои. В этом смысле я даже испытываю лёгкое сочувствие.",shape=box,color=blue];
		907 -> 920;
	908 [label="Ааа, понятно... привык делать это без каких-либо последствий. Впрочем, тебе, вероятно, не приходилось иметь дело с другим протофреймом, чьи воспоминания... раздроблены, так же как мои.",shape=box,color=blue];
		908 -> 920;
	909 [label="А, так ты всё-таки из Империи Орокин. Как прекрасно.",shape=box,color=blue];
		909 -> 920;
