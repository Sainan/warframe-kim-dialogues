		j2342122517 -> j1705495358 [label="RoatheLyonDatingDealNo",color=purple];
		j2342122517 -> j2604345010 [label="RoatheSerumDealNo",color=purple];
		j2342122517 -> j2604345010 [label="RoatheFamilyDealNo",color=purple];
		j2342122517 -> j2604345010 [label="RoatheMarieEntratiDealNo",color=purple];
		j2342122517 -> j2604345010 [label="RoatheLyonConfessionDealNo",color=purple];
	j3125876870 [label="Ты в курсе, когда-то они были влюблены.",shape=box,color=blue];
		j3125876870 -> j3017636112;
		j3125876870 -> j3047593017;
		j3125876870 -> j1310452999;
	j1705495358 [label="Вмешиваться в наши умы... всё ради похоти? Любви? Что это? Как бы это назвать? Полагаю, я просто задаюсь вопросом, стоило ли оно того. Или, полагаю, ты ещё не знаешь, ведь дивиденды ещё не выплачены.",shape=box,color=blue];
		j1705495358 -> j1890008015;
	j2604345010 [label="Вмешиваться в наши умы... ради чего? Выполнять какой-то... невидимый список дел? Или всё это во имя победы над вашим же заколдованным так называемым «богом»?",shape=box,color=blue];
		j2604345010 -> j2242836707;
	j3017636112 [label="Кто?",shape=box,color=red];
		j3017636112 -> j3404055631;
	j3047593017 [label="Мне очень трудно в это поверить.",shape=box,color=red];
		j3047593017 -> j1214276498;
	j1310452999 [label="[Конец.]",shape=box,color=red];
		j1310452999 -> "Chat ends.";
	j1890008015 [label="Полагаю, в этом даже есть странная романтика, хотя и немного... антиутопично, идти на такие меры, чтобы завоевать сердце возлюбленного.",shape=box,color=blue];
		j1890008015 -> j3469747902;
	j2242836707 [label="Или всё ещё хуже, и тебе было просто любопытно, что произойдёт? И ты просто сидишь и отрываешь ноги насекомым? Мы разобрались с тем, «что» стоит за действиями. Теперь я хочу понять, «зачем».",shape=box,color=blue];
		j2242836707 -> j3362610447;
	j3404055631 [label="Баллас и Маргулис.",shape=box,color=blue];
		j3404055631 -> j2571179236;
	j1214276498 [label="Это правда! Я прямо слышу, как ты насмехаешься из Святилища. Но Баллас и Маргулис были очень влюблены друг в друга.",shape=box,color=blue];
		j1214276498 -> j2020169979;
	j3469747902 [label="Или всё ещё хуже, и тебе было просто любопытно, что произойдёт? И ты просто сидишь и отрываешь ноги насекомым? Мы разобрались с тем, «что» стоит за действиями. Теперь я хочу понять, «зачем».",shape=box,color=blue];
		j3469747902 -> j2868117985;
	j3362610447 [label="Check boolean RoatheResetScrewedUp",color=orange];
		j3362610447 -> j3141025331 [label=true,color=green];
		j3362610447 -> j1690690492 [label=false,color=brown];
		j3362610447 -> j43766931 [label=false,color=brown];
		j3362610447 -> j813993903 [label=false,color=brown];
		j3362610447 -> j2754923763 [label=false,color=brown];
	j2571179236 [label="Я прямо слышу, как ты насмехаешься из Святилища. Но это правда.",shape=box,color=blue];
		j2571179236 -> j2020169979;
	j2020169979 [label="Я боюсь, что ты познакомился с Балласом только спустя долгое время после того, как всё пошло.... ужасно плохо.",shape=box,color=blue];
		j2020169979 -> j529277130;
		j2020169979 -> j2281233217;
	j2868117985 [label="Check boolean RoatheResetScrewedUp",color=orange];
		j2868117985 -> j1211027791 [label=true,color=green];
		j2868117985 -> j967307914 [label=false,color=brown];
		j2868117985 -> j842499304 [label=false,color=brown];
		j2868117985 -> j944847356 [label=false,color=brown];
		j2868117985 -> j3473157289 [label=false,color=brown];
	j3141025331 [label="Раньше тобой упоминалось, что всё «пошло наперекосяк», или каким-то образом отношения с фанатиками стали настолько переплетенными, что их уже было трудно распутать. И выходить, как и правда считалось тобой, что это был самый лучший вариант из всех, что у тебя оставались?",shape=box,color=blue];
		j3141025331 -> j813993903;
		j3141025331 -> j2635806246;
		j3141025331 -> j43766931;
		j3141025331 -> j1690690492;
	j1690690492 [label="У меня не было другого выхода.",shape=box,color=red];
		j1690690492 -> j3772047713;
	j43766931 [label="Да. Просто не ожидалось, что ты окажешься… в таком состоянии, с наполовину утраченной памятью. Прости.",shape=box,color=red];
		j43766931 -> j2173998323;
	j813993903 [label="Если быть до конца честным, Роут? Мне... никогда не думалось, что это действительно важно, что я смогу это сделать.",shape=box,color=red];
		j813993903 -> j3422425878;
	j2754923763 [label="Мне было любопытно посмотреть, что же произойдёт.",shape=box,color=red];
		j2754923763 -> j402619467;
	j529277130 [label="Что же произошло, что всё так резко изменилось?",shape=box,color=red];
		j529277130 -> j1520501426;
	j2281233217 [label="Люди не так уж сильно меняются. В глубине всегда сохранялось то, что позволило таким поступкам случиться.",shape=box,color=red];
		j2281233217 -> j2799059019;
	j1211027791 [label="Раньше тобой упоминалось, что всё «пошло наперекосяк» между нами, или каким-то образом отношения с фанатиками стали настолько переплетенными, что их уже было трудно распутать. И выходить, как и правда считалось тобой, что это был самый лучший вариант из всех, что у тебя оставались?",shape=box,color=blue];
		j1211027791 -> j967307914;
		j1211027791 -> j508804562;
		j1211027791 -> j944847356;
		j1211027791 -> j3473157289;
	j967307914 [label="Не было понятно, что ещё делать. У меня не было другого выхода.",shape=box,color=red];
		j967307914 -> j1646847578;
	j842499304 [label="Мне было любопытно посмотреть, что же произойдёт.",shape=box,color=red];
		j842499304 -> j2471463834;
	j944847356 [label="Если быть до конца честным, Роут? Мне... никогда не думалось, что это действительно важно, что я смогу это сделать.",shape=box,color=red];
		j944847356 -> j411516384;
	j3473157289 [label="Да. Я не думал, что ты... окажешься в таком состоянии, с наполовину стёртой памятью. Извини.",shape=box,color=red];
		j3473157289 -> j3741456787;
	j2635806246 [label="Мне было любопытно посмотреть, к чему всё приведёт.",shape=box,color=red];
		j2635806246 -> j686688612;
	j3772047713 [label="Evaluate expressions on HellStory counter",color=orange];
		j3772047713 -> j2900004876 [label="x >= 21",color=purple];
		j3772047713 -> j3956421570 [label="x < 21",color=purple];
		j3772047713 -> j3956421570 [label="false",color=purple];
	j2173998323 [label="Мм, да. Впрочем, тебе, вероятно, не приходилось иметь дело с другим протофреймом, чьи воспоминания... раздроблены, так же как мои. В этом смысле я даже испытываю лёгкое сочувствие.",shape=box,color=blue];
		j2173998323 -> j2757642549;
	j3422425878 [label="Ааа, понятно... привык делать это без каких-либо последствий. Впрочем, тебе, вероятно, не приходилось иметь дело с другим протофреймом, чьи воспоминания... раздроблены, так же как мои.",shape=box,color=blue];
		j3422425878 -> j2757642549;
	j402619467 [label="А, так ты всё-таки из Империи Орокин. Как прекрасно.",shape=box,color=blue];
		j402619467 -> j2757642549;
	j1520501426 [label="Add 1 to Thermostat counter",color=orange];
		j1520501426 -> j872609217;
	j2799059019 [label="Add -1 to Thermostat counter",color=orange];
		j2799059019 -> j892587608;
	j508804562 [label="Мне было любопытно посмотреть, что же произойдёт.",shape=box,color=red];
		j508804562 -> j2813157590;
	j1646847578 [label="Evaluate expressions on HellStory counter",color=orange];
		j1646847578 -> j476018984 [label="x >= 21",color=purple];
		j1646847578 -> j3998825212 [label="x < 21",color=purple];
		j1646847578 -> j3998825212 [label="false",color=purple];
	j2471463834 [label="Ах, так ты всё же дитя Империи Орокин. Как чудесно. Трудно поверить, что всё это было совершено во имя «любви».",shape=box,color=blue];
		j2471463834 -> j233634182;
	j411516384 [label="Ааа, понятно… привычка действовать без последствий. Скорее всего, не было случая столкнуться с другим протофреймом, у которого воспоминания… расколоты так же, как у меня. В этом отношении даже можно сказать, что во мне есть крупица сочувствия. И всё это во имя «любви».",shape=box,color=blue];
		j411516384 -> j1764367448;
	j3741456787 [label="Мм, да. Впрочем, тебе, вероятно, не приходилось иметь дело с другим протофреймом, чьи воспоминания... раздроблены, так же как мои. В этом смысле я даже испытываю лёгкое сочувствие. И всё это во имя «любви».",shape=box,color=blue];
		j3741456787 -> j1764367448;
	j686688612 [label="И теперь я начинаю понимать, каким образом всё у тебя так «провалилось», Узурпатор.",shape=box,color=blue];
		j686688612 -> j2757642549;
	j2900004876 [label="+5 Chemistry",color=orange];
		j2900004876 -> j1260858789;
	j3956421570 [label="+5 Chemistry",color=orange];
		j3956421570 -> j2671759582;
	j2757642549 [label="Я бы осудил тебя за то, что ты сделал ради того, чтобы получить желаемое, но меня поражает, что Орокин известны тем, что творили вещи и похуже, если не более изобретательно.",shape=box,color=blue];
		j2757642549 -> j93540629;
	j872609217 [label="Конечно, всё это стало возможным благодаря тебе. Вернее, детям. Тэнно. Иногда мне кажется, что происходящее было неизбежным. Или что всё можно было направить по другому пути.",shape=box,color=blue];
		j872609217 -> j2452833110;
	j892587608 [label="Возможно, в этом есть доля истины. Или, может быть, мы все, в конце концов, всего лишь необработанные драгоценности. У каждого свои изъяны, свои особенности: прожилки тут, пятна там.",shape=box,color=blue];
		j892587608 -> j3752742218;
	j2813157590 [label="И теперь становится ясно, каким образом у тебя всё так пошло «наперекосяк», Узурпатор. С трудом верится, что всё это было сделано во имя «любви».",shape=box,color=blue];
		j2813157590 -> j233634182;
	j476018984 [label="+5 Chemistry",color=orange];
		j476018984 -> j2828102568;
	j3998825212 [label="+5 Chemistry",color=orange];
		j3998825212 -> j4091607003;
	j233634182 [label="Хотя, я полагаю, у Орокин всегда был странный способ выражения своих эмоций.",shape=box,color=blue];
		j233634182 -> j93540629;
	j1764367448 [label="Можно было бы осудить тебя за то, что было совершено во имя так называемой «любви», но меня поражает, что Орокин известны тем, что творили вещи и похуже, если не более изобретательно.",shape=box,color=blue];
		j1764367448 -> j93540629;
	j1260858789 [label="Можно было бы посоветовать просто посидеть со своими ошибками и принять поражение как есть, но тогда это выглядело бы чистым лицемерием, верно?",shape=box,color=blue];
		j1260858789 -> j4218586650;
	j2671759582 [label="Можно было бы предложить просто спокойно побыть со своими ошибками и принять поражение таким, какое оно есть. Но у меня нет данного Бездной дара крутить карманы времени и стирать чужие воспоминания.",shape=box,color=blue];
		j2671759582 -> j361417046;
	j93540629 [label="Был ли у нас когда-либо разговор об истории Балласа и Маргулис? Я рассчитываю на твою честность, поскольку иначе я не смогу узнать правду.",shape=box,color=blue];
		j93540629 -> j426192615;
	j2452833110 [label="Мне нравится верить, что в итоге мы все просто необработанные камни. У каждого свои изъяны, свои особенности: прожилки тут, пятна там.",shape=box,color=blue];
		j2452833110 -> j3752742218;
	j3752742218 [label="И нас могут огранить так, чтобы мы сияли в изящных украшениях... или выточить в клинки… или просто разбить в порошок.",shape=box,color=blue];
		j3752742218 -> j2660936510;
	j2828102568 [label="Можно было бы посоветовать просто посидеть со своими ошибками и принять поражение как есть, но тогда это выглядело бы чистым лицемерием, верно?",shape=box,color=blue];
		j2828102568 -> j2664025854;
	j4091607003 [label="Можно было бы предложить просто спокойно побыть со своими ошибками и принять поражение таким, какое оно есть. Но у меня нет данного Бездной дара крутить карманы времени и стирать чужие воспоминания.",shape=box,color=blue];
		j4091607003 -> j1124218867;
	j4218586650 [label="И кто сможет утверждать, что не воспользовался бы даром Бездны, позволяющим крутить карманы времени и стирать чужие воспоминания?",shape=box,color=blue];
		j4218586650 -> j361417046;
	j361417046 [label="Как… вообще это всё работает, если по-честному?",shape=box,color=blue];
		j361417046 -> j556662861;
		j361417046 -> j2942681658;
		j361417046 -> j1310452999;
	j426192615 [label="И поверь, как же я это ненавижу.",shape=box,color=blue];
		j426192615 -> j3585472511;
		j426192615 -> j1144318865;
		j426192615 -> j2651474192;
		j426192615 -> j1379181833;
	j2660936510 [label="Возможно, это наивная вера, и мы все действительно неизменны. Вы же знаете это лучше меня, по крайней мере, так говорят.",shape=box,color=blue];
		j2660936510 -> j192423572;
	j2664025854 [label="И кто сможет утверждать, что не воспользовался бы даром Бездны, позволяющим крутить карманы времени и стирать чужие воспоминания?",shape=box,color=blue];
		j2664025854 -> j1124218867;
	j1124218867 [label="Как… вообще это всё работает, если по-честному?",shape=box,color=blue];
		j1124218867 -> j1601569211;
		j1124218867 -> j2867714663;
		j1124218867 -> j1310452999;
	j556662861 [label="Сейчас ты находишься в состоянии Заражённого. И твоя связь идёт от тех же заражённых штаммов, что применялись для производства всех партий сыворотки Протофрейма.",shape=box,color=red];
		j556662861 -> j4058153294;
	j2942681658 [label="Одна говорящая гитара у меня в долгу.",shape=box,color=red];
		j2942681658 -> j643968098;
	j3585472511 [label="Уже доводилось это слышать.",shape=box,color=red];
		j3585472511 -> j2012029190;
	j1144318865 [label="Уже приходилось это слышать, но всё же продолжай.",shape=box,color=red];
		j1144318865 -> j1288984628;
	j2651474192 [label="Прежде об этом не приходилось слышать.",shape=box,color=red];
		j2651474192 -> j539433558;
	j1379181833 [label="История эта до сих пор не была известна, которая... в этом, собственно, одна из причин, по которой мы здесь. Ранее, похоже, многое оказалось упущено.",shape=box,color=red];
		j1379181833 -> j436972201;
	j192423572 [label="Но из-за тебя я всё рассказываю не по порядку. Позволь начать как следует.",shape=box,color=blue];
		j192423572 -> j3224846723;
	j1601569211 [label="Сейчас ты находишься в состоянии Заражённого. И твоя связь идёт от тех же заражённых штаммов, что применялись для производства всех партий сыворотки Протофрейма.",shape=box,color=red];
		j1601569211 -> j17407219;
	j2867714663 [label="Одна говорящая гитара у меня в долгу.",shape=box,color=red];
		j2867714663 -> j2032003400;
	j4058153294 [label="Насколько мне известно - и она, скажем так, не самый надёжный источник, так что не воспринимай это как истину в последней инстанции - штаммы Заражения для каждой партии протофреймов можно было влиять по отдельности.",shape=box,color=red];
		j4058153294 -> j4188571848;
	j643968098 [label="Я… ясно.",shape=box,color=blue];
		j643968098 -> j3125125774;
	j2012029190 [label="+10 Chemistry",color=orange];
		j2012029190 -> j776782422;
	j1288984628 [label="Либо ты пытаешься льстить моему самолюбию, за что я, кстати, тебя уважаю, либо у тебя просто чрезвычайно скучный день. Что я почти понимаю, тоже пройдя бесчисленные жизненные циклы.",shape=box,color=blue];
		j1288984628 -> j3202933224;
	j539433558 [label="Увлекательно. Либо ты лжёшь, либо у меня ещё остались неперевёрнутые тобой камни. Возможно, поэтому ты снова здесь и перечитываешь уже вспаханное поле.",shape=box,color=blue];
		j539433558 -> j430775809;
	j436972201 [label="Ммм, мало-помалу ты почти убеждаешь меня простить тебя за весь этот беспорядок, который возник из-за твоих действий.",shape=box,color=blue];
		j436972201 -> j692583592;
	j3224846723 [label="Задолго до запуска Зариман Десять-Ноль, ещё до того, как Тэнно вообще появились на горизонте, Архимедиан Маргулис и Баллас познакомились на открытии нового купольного сада.",shape=box,color=blue];
		j3224846723 -> j2899329915;
	j17407219 [label="Насколько мне известно - и она, скажем так, не самый надёжный источник, так что не воспринимай это как истину в последней инстанции - штаммы Заражения для каждой партии протофреймов можно было влиять по отдельности.",shape=box,color=red];
		j17407219 -> j260265151;
	j2032003400 [label="Я… ясно.",shape=box,color=blue];
		j2032003400 -> j2157968145;
	j4188571848 [label="Поскольку каждый из них живёт в своём собственном «континууме» или времени. Все штаммы заражения связаны, но они как бы живут в… узлах. Всё очень сложно.",shape=box,color=red];
		j4188571848 -> j3220962035;
	j3125125774 [label="Вселенная определенно стала куда страннее с тех пор, как я её покинул...",shape=box,color=blue];
		j3125125774 -> j4209371731;
		j3125125774 -> j947922979;
	j776782422 [label="Тогда я не буду утомлять вас новым пересказом этой саги и предоставлю тебе возможность найти себе другие развлечения на оставшуюся часть дня.",shape=box,color=blue];
		j776782422 -> j2888030837;
	j3202933224 [label="Разве не бывало такого, что меня делали предметом твоего веселья.",shape=box,color=blue];
		j3202933224 -> j430775809;
	j430775809 [label="Но? Как бы то ни было... ",shape=box,color=blue];
		j430775809 -> j3191429565;
	j692583592 [label="Boolean RoatheResetForgiven is now true.",color=orange];
		j692583592 -> j430775809;
	j2899329915 [label="Баллас присутствовал там ради церемонии - мы, конечно, любим пышность и торжественность - и Маргулис отчаянно пыталась остаться незамеченной.",shape=box,color=blue];
		j2899329915 -> j1188200816;
	j260265151 [label="Поскольку каждый из них живёт в своём собственном «континууме» или времени. Все штаммы заражения связаны, но они как бы живут в… узлах. Всё очень сложно.",shape=box,color=red];
		j260265151 -> j3887961502;
	j2157968145 [label="Вселенная определенно стала куда страннее с тех пор, как мне довелось её покинуть...",shape=box,color=blue];
		j2157968145 -> j1775008456;
		j2157968145 -> j1324531650;
	j3220962035 [label="Так как я могу зацикливать время, я могу зацикливать «партии» Заражения ограниченным образом.",shape=box,color=red];
		j3220962035 -> j2612872828;
	j4209371731 [label="Ты понятия не имеешь.",shape=box,color=red];
		j4209371731 -> j3176283474;
	j947922979 [label="Она, пожалуй, возьмёт верх. Впрочем... неважно.",shape=box,color=red];
		j947922979 -> j3176283474;
	j2888030837 [label="Boolean RoatheMargulis1 is now true.",color=orange];
		j2888030837 -> "Chat ends.";
	j3191429565 [label="Баллас и Маргулис.",shape=box,color=blue];
		j3191429565 -> j3224846723;
	j1188200816 [label="Пойми, мой Узурпатор, у Балласа не было ни единой причины связываться с ней. Если только его влечение не было искренним.",shape=box,color=blue];
		j1188200816 -> j623512555;
	j3887961502 [label="Так как я могу зацикливать время, я могу зацикливать «партии» Заражения ограниченным образом.",shape=box,color=red];
		j3887961502 -> j3867526792;
	j1775008456 [label="Ты понятия не имеешь.",shape=box,color=red];
		j1775008456 -> j3047944410;
	j1324531650 [label="Она, пожалуй, возьмёт верх. Впрочем... неважно.",shape=box,color=red];
		j1324531650 -> j3047944410;
	j2612872828 [label="А «она» это кто?",shape=box,color=blue];
		j2612872828 -> j30112508;
		j2612872828 -> j130279487;
	j3176283474 [label="Можно было бы осудить тебя за то, что было совершено ради получения желаемого, но меня поражает, что Орокин известны тем, что творили вещи и похуже, если не более изобретательно.",shape=box,color=blue];
		j3176283474 -> j93540629;
	j623512555 [label="Дело было не только в желании, потому что он мог получить кого угодно – и он делал это довольно часто. Если бы он хотел её, он мог бы просто заполучить её и покончить с этим раз и навсегда.",shape=box,color=blue];
		j623512555 -> j3595558078;
	j3867526792 [label="И кто же эта «она»?",shape=box,color=blue];
		j3867526792 -> j123631212;
		j3867526792 -> j2066193870;
	j3047944410 [label="Как бы то ни было. Всё ради какой-то «любви»?",shape=box,color=blue];
		j3047944410 -> j1764367448;
	j30112508 [label="Лиззи. Она бы тебя обожала.",shape=box,color=red];
		j30112508 -> j643968098;
	j130279487 [label="Говорящая гитара.",shape=box,color=red];
		j130279487 -> j643968098;
	j3595558078 [label="Он был Исполнителем. Одним из самых могущественных из Семерых. Он мог бы позвать её в свою спальню, и она бы явилась туда, не раздумывая.",shape=box,color=blue];
		j3595558078 -> j1827005989;
	j123631212 [label="Лиззи. Она бы тебя обожала.",shape=box,color=red];
		j123631212 -> j2032003400;
	j2066193870 [label="Говорящая гитара.",shape=box,color=red];
		j2066193870 -> j2032003400;
	j1827005989 [label="Но он этого не поступил. Баллас взглянул на неё в тот вечер, и... он был поражён, Скиталец. Абсолютно и совершенно вне себя.",shape=box,color=blue];
		j1827005989 -> j3559713149;
	j3559713149 [label="Я никогда не видел ничего подобного. Казалось, в комнате вообще никого не было, кроме Маргулис. Он даже... как-то стеснялся заговорить с ней. Он! Баллас!",shape=box,color=blue];
		j3559713149 -> j2620334964;
		j3559713149 -> j3989315933;
	j2620334964 [label="Серьёзно?",shape=box,color=red];
		j2620334964 -> j223876984;
	j3989315933 [label="Ты это выдумываешь.",shape=box,color=red];
		j3989315933 -> j1533641766;
	j223876984 [label="Клянусь всем, что осталось от моей чести! И какой смысл мне лгать? Какое мне дело до твоего мнения о подлинности их отношений?",shape=box,color=blue];
		j223876984 -> j1013673589;
	j1533641766 [label="Клянусь остатками своей чести, что это не так! И какой смысл мне лгать? Какое мне дело до твоего мнения о подлинности их отношений?",shape=box,color=blue];
		j1533641766 -> j1013673589;
	j1013673589 [label="Меня просто огорчает, что вы все так быстро упрощаете то, что на самом деле гораздо сложнее, чем вам хотелось бы.",shape=box,color=blue];
		j1013673589 -> j2276804836;
	j2276804836 [label="Они были влюблены друг в друга, хотите вы в это верить или нет. Баллас нарушил все классовые правила и традиции, чтобы выбрать своей возлюбленной — и единственной спутницей жизни - Архимедиан. ",shape=box,color=blue];
		j2276804836 -> j3312053437;
	j3312053437 [label="Только настоящая любовь могла свести мужчину с ума, как это случилось с ним, когда все пошло совсем не так...",shape=box,color=blue];
		j3312053437 -> j1354692339;
		j3312053437 -> j1581606493;
	j1354692339 [label="Почему ты так считаешь? Не он ли был виновен в её смерти?",shape=box,color=red];
		j1354692339 -> j2290763991;
	j1581606493 [label="Именно Баллас приказал её казнить.",shape=box,color=red];
		j1581606493 -> j2290763991;
	j2290763991 [label="Во-первых, предположим, что всё, что тебе известно, верно, и он действовал исключительно по собственной воле. Предположим, что за кулисами не было никаких политических манёвров, шантажа или чего-либо ещё, что могло бы его к этому подтолкнуть.",shape=box,color=blue];
		j2290763991 -> j834711637;
	j834711637 [label="Даже если бы это было так, и Баллас, не имея на это никакого влияния, потребовал её казни, учти, что было уже слишком поздно. Предательство, которое он почувствовал, уже раскололо его надвое.",shape=box,color=blue];
		j834711637 -> j1067845665;
	j1067845665 [label="Его сердце и разум уже были разбиты.",shape=box,color=blue];
		j1067845665 -> j1763837981;
		j1067845665 -> j3475333989;
	j1763837981 [label="Я не собираюсь жалеть его, если ты на это намекаешь.",shape=box,color=red];
		j1763837981 -> j1831159789;
	j3475333989 [label="Из-за Тэнно? Или из-за того, что они с ней сделали?",shape=box,color=red];
		j3475333989 -> j432243926;
	j1831159789 [label="Я не прошу тебя ни о чем подобном! Баллас заслуживает только одного, чтобы мы помочились на его могилу — если у него действительно есть могила.",shape=box,color=blue];
		j1831159789 -> j380703644;
	j432243926 [label="В каком-то смысле, и то, и другое. И в каком-то смысле, ни то, ни другое. В тот день, когда он потребовал её казни, он был доведён до безумия. На самом деле, я не удивлюсь, если какая-то его часть точно не вспомнит о совершенном поступке.",shape=box,color=blue];
		j432243926 -> j1733079317;
	j380703644 [label="Я лишь утверждаю, что в тот день, когда он приказал казнить её, он был безумцем. Я бы не удивился, если бы какая-то часть его сознания не помнила полностью, как он это сделал, даже спустя какое-то время.",shape=box,color=blue];
		j380703644 -> j1733079317;
	j1733079317 [label="Баллас любил Маргулис. Всем своим существом, полностью, беззаветно преданный ей. Он бы пожертвовал всем ради неё. Душой, телом, Империей Орокин. Всем, что только можно вообразить.",shape=box,color=blue];
		j1733079317 -> j639740967;
	j639740967 [label="Не существовало цены, которая показалась бы ему слишком высокой. Никакая мораль не стоила бы жертв. Если бы вы вручили ему новорожденного младенца и сказали, что Маргулис желает разбить ему голову о скалы, ребёнок был бы мёртв ещё до того, как ты договорил бы фразу.",shape=box,color=blue];
		j639740967 -> j763800720;
	j763800720 [label="Он бы сжег Изначальную Систему дотла и отстроил бы её по её образу и подобию, Узурпатор... в этом и заключается трагедия.",shape=box,color=blue];
		j763800720 -> j3242985985;
	j3242985985 [label="Маргулис? Ах, Маргулис. Милая, милая, дорогая Маргулис... у неё ещё была совесть.",shape=box,color=blue];
		j3242985985 -> j2015464111;
	j2015464111 [label="И когда она увидела бедных Тэнно, бедных, измученных Бездной детей... ",shape=box,color=blue];
		j2015464111 -> j818978991;
	j818978991 [label="Что-то в её жизни было важнее Балласа. В её жизни было что-то, ради чего она была готова пожертвовать всем... и это был не он.",shape=box,color=blue];
		j818978991 -> j812509673;
	j812509673 [label="Это была не её любовь к нему.",shape=box,color=blue];
		j812509673 -> j3454207769;
	j3454207769 [label="И он знал это, мой дорогой Скиталец. Он знал это с того самого момента, как она обратила внимание. И это стало ещё очевиднее, когда её «безумные животные» сделали их последними, кого она когда-либо видела. По крайней мере, так ходили слухи среди нас, Орокин.",shape=box,color=blue];
		j3454207769 -> j3646567063;
	j3646567063 [label="Можешь представить себе радость среди Орокин? Видеть, Когда увидели, как обезумевшие отродья Балласа, измученные Бездной Архимедиан, выжигают ей глаза?",shape=box,color=blue];
		j3646567063 -> j631753989;
	j631753989 [label="Но я думаю, всё случилось раньше, в тот самый момент, когда Маргулис боролась за спасение Тэнно, сердце Балласа разбилось на тысячу осколков и больше не восстановилось.",shape=box,color=blue];
		j631753989 -> j1877151906;
	j1877151906 [label="Потому что он понял, что в её сердце его место занял кто-то другой.",shape=box,color=blue];
		j1877151906 -> j2328933416;
	j2328933416 [label="Наверное, именно поэтому мне было его жаль. Но что было дальше? История любви на века... и как она закончилась такой чудовищной трагедией. ",shape=box,color=blue];
		j2328933416 -> j3556747703;
	j3556747703 [label="Жаль, что ты не видел, как они улыбались друг другу...",shape=box,color=blue];
		j3556747703 -> j4225646216;
		j3556747703 -> j664627006;
	j4225646216 [label="Можешь сколько угодно романтизировать, что у них было, но это не оправдывает то, кем он был. Баллас не может быть прощён за всё, что натворил.",shape=box,color=red];
		j4225646216 -> j2749755507;
	j664627006 [label="Я ценю, что их любовь была настоящей. Что он тогда был... сложным. И что Маргулис всё это время не была просто игрушкой.",shape=box,color=red];
		j664627006 -> j788233019;
	j2749755507 [label="Add 1 to Thermostat counter",color=orange];
		j2749755507 -> j2365338588;
	j788233019 [label="Add -1 to Thermostat counter",color=orange];
		j788233019 -> j3926171593;
	j2365338588 [label="+10 Chemistry",color=orange];
		j2365338588 -> j1393311801;
	j3926171593 [label="+10 Chemistry",color=orange];
		j3926171593 -> j3406455326;
	j1393311801 [label="И я не пытался ставить знак равенства между ними, Узурпатор. В обсуждении затрагивалась лишь мысль, что человек может быть любим, но при этом способен на ужасные вещи. Ну что ж... У нас, остальных, развращённых глупцов, шансов ещё меньше...",shape=box,color=blue];
		j1393311801 -> j3840484566;
	j3406455326 [label="В самом деле. Иногда меня утешает мысль о том, что если даже этот повелитель разврата нашёл себе пару, то и у нас остальных ещё есть шанс, да? Хаха!",shape=box,color=blue];
		j3406455326 -> j3840484566;
	j3840484566 [label="Boolean RoatheMargulis1 is now true.",color=orange];
		j3840484566 -> j3766745050;
	j3766745050 [label="Но и так уже ушло достаточно твоего времени на сегодня. А теперь иди. ",shape=box,color=blue];
		j3766745050 -> "Chat ends.";
}