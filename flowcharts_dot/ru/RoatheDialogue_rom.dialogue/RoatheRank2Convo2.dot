		903 -> 914 [label=false,color=brown];
		903 -> 915 [label=false,color=brown];
	902 [label="Раньше тобой упоминалось, что всё «пошло наперекосяк», или каким-то образом отношения с фанатиками стали настолько переплетенными, что их уже было трудно распутать. И выходить, как и правда считалось тобой, что это был самый лучший вариант из всех, что у тебя оставались?",shape=box,color=blue];
		902 -> 900;
		902 -> 910;
		902 -> 899;
		902 -> 898;
	898 [label="У меня не было другого выхода.",shape=box,color=red];
		898 -> 906;
	899 [label="Да. Просто не ожидалось, что ты окажешься… в таком состоянии, с наполовину утраченной памятью. Прости.",shape=box,color=red];
		899 -> 907;
	900 [label="Если быть до конца честным, Роут? Мне... никогда не думалось, что это действительно важно, что я смогу это сделать.",shape=box,color=red];
		900 -> 908;
	901 [label="Мне было любопытно посмотреть, что же произойдёт.",shape=box,color=red];
		901 -> 909;
	904 [label="Что же произошло, что всё так резко изменилось?",shape=box,color=red];
		904 -> 916;
	905 [label="Люди не так уж сильно меняются. В глубине всегда сохранялось то, что позволило таким поступкам случиться.",shape=box,color=red];
		905 -> 917;
	913 [label="Раньше тобой упоминалось, что всё «пошло наперекосяк» между нами, или каким-то образом отношения с фанатиками стали настолько переплетенными, что их уже было трудно распутать. И выходить, как и правда считалось тобой, что это был самый лучший вариант из всех, что у тебя оставались?",shape=box,color=blue];
		913 -> 911;
		913 -> 924;
		913 -> 914;
		913 -> 915;
	911 [label="Не было понятно, что ещё делать. У меня не было другого выхода.",shape=box,color=red];
		911 -> 922;
	912 [label="Мне было любопытно посмотреть, что же произойдёт.",shape=box,color=red];
