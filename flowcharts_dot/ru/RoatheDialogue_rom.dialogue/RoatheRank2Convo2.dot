		916 -> 927;
	917 [label="Add -1 to Thermostat",color=orange];
		917 -> 928;
	924 [label="Мне было любопытно посмотреть, что же произойдёт.",shape=box,color=red];
		924 -> 935;
	922 [label="Evaluate expressions on HellStory",color=orange];
		922 -> 933 [label="x >= 21",color=purple];
		922 -> 932 [label="x < 21",color=purple];
		922 -> 932 [label="false",color=purple];
	923 [label="Ах, так ты всё же дитя Империи Орокин. Как чудесно. Трудно поверить, что всё это было совершено во имя «любви».",shape=box,color=blue];
		923 -> 934;
	925 [label="Ааа, понятно… привычка действовать без последствий. Скорее всего, не было случая столкнуться с другим протофреймом, у которого воспоминания… расколоты так же, как у меня. В этом отношении даже можно сказать, что во мне есть крупица сочувствия. И всё это во имя «любви».",shape=box,color=blue];
		925 -> 936;
	926 [label="Мм, да. Впрочем, тебе, вероятно, не приходилось иметь дело с другим протофреймом, чьи воспоминания... раздроблены, так же как мои. В этом смысле я даже испытываю лёгкое сочувствие. И всё это во имя «любви».",shape=box,color=blue];
		926 -> 936;
	921 [label="И теперь я начинаю понимать, каким образом всё у тебя так «провалилось», Узурпатор.",shape=box,color=blue];
		921 -> 920;
	919 [label="+5 Chemistry",color=orange];
		919 -> 930;
	918 [label="+5 Chemistry",color=orange];
		918 -> 929;
	920 [label="Я бы осудил тебя за то, что ты сделал ради того, чтобы получить желаемое, но меня поражает, что Орокин известны тем, что творили вещи и похуже, если не более изобретательно.",shape=box,color=blue];
		920 -> 931;
	927 [label="Конечно, всё это стало возможным благодаря тебе. Вернее, детям. Тэнно. Иногда мне кажется, что происходящее было неизбежным. Или что всё можно было направить по другому пути.",shape=box,color=blue];
		927 -> 937;
	928 [label="Возможно, в этом есть доля истины. Или, может быть, мы все, в конце концов, всего лишь необработанные драгоценности. У каждого свои изъяны, свои особенности: прожилки тут, пятна там.",shape=box,color=blue];
		928 -> 938;
	935 [label="И теперь становится ясно, каким образом у тебя всё так пошло «наперекосяк», Узурпатор. С трудом верится, что всё это было сделано во имя «любви».",shape=box,color=blue];
		935 -> 934;
	933 [label="+5 Chemistry",color=orange];
		933 -> 943;
	932 [label="+5 Chemistry",color=orange];
		932 -> 942;
	934 [label="Хотя, я полагаю, у Орокин всегда был странный способ выражения своих эмоций.",shape=box,color=blue];
		934 -> 931;
	936 [label="Можно было бы осудить тебя за то, что было совершено во имя так называемой «любви», но меня поражает, что Орокин известны тем, что творили вещи и похуже, если не более изобретательно.",shape=box,color=blue];
		936 -> 931;
	930 [label="Можно было бы посоветовать просто посидеть со своими ошибками и принять поражение как есть, но тогда это выглядело бы чистым лицемерием, верно?",shape=box,color=blue];
		930 -> 940;
	929 [label="Я бы посоветовал спокойно побыть со своими ошибками и принять поражение таким, какое оно есть. Но у меня нет данного Бездной дара крутить карманы времени и стирать чужие воспоминания.",shape=box,color=blue];
		929 -> 939;
	931 [label="Был ли у нас когда-либо разговор об истории Балласа и Маргулис? Я рассчитываю на твою честность, поскольку иначе я не смогу узнать правду.",shape=box,color=blue];
		931 -> 941;
	937 [label="Мне нравится верить, что в итоге мы все просто необработанные камни. У каждого свои изъяны, свои особенности: прожилки тут, пятна там.",shape=box,color=blue];
		937 -> 938;
	938 [label="И нас могут огранить так, чтобы мы сияли в изящных украшениях... или выточить в клинки… или просто разбить в порошок.",shape=box,color=blue];
		938 -> 944;
	943 [label="Можно было бы посоветовать просто посидеть со своими ошибками и принять поражение как есть, но тогда это выглядело бы чистым лицемерием, верно?",shape=box,color=blue];
		943 -> 953;
	942 [label="Можно было бы предложить просто спокойно побыть со своими ошибками и принять поражение таким, какое оно есть. Но у меня нет данного Бездной дара крутить карманы времени и стирать чужие воспоминания.",shape=box,color=blue];
		942 -> 952;
	940 [label="И кто сможет утверждать, что не воспользовался бы даром Бездны, позволяющим крутить карманы времени и стирать чужие воспоминания?",shape=box,color=blue];
		940 -> 939;
	939 [label="Как… вообще это всё работает, если по-честному?",shape=box,color=blue];
		939 -> 946;
		939 -> 947;
		939 -> 945;
	941 [label="И поверь, как же я это ненавижу.",shape=box,color=blue];
		941 -> 948;
		941 -> 949;
		941 -> 950;
		941 -> 951;
	944 [label="Возможно, это наивная вера, и мы все действительно неизменны. Вы же знаете это лучше меня, по крайней мере, так говорят.",shape=box,color=blue];
		944 -> 954;
	953 [label="И кто сможет утверждать, что не воспользовался бы даром Бездны, позволяющим крутить карманы времени и стирать чужие воспоминания?",shape=box,color=blue];
		953 -> 952;
	952 [label="Как… вообще это всё работает, если по-честному?",shape=box,color=blue];
		952 -> 963;
		952 -> 964;
		952 -> 962;
	946 [label="Сейчас ты находишься в состоянии Заражённого. И твоя связь идёт от тех же заражённых штаммов, что применялись для производства всех партий сыворотки Протофрейма.",shape=box,color=red];
		946 -> 956;
	947 [label="Одна говорящая гитара у меня в долгу.",shape=box,color=red];
		947 -> 957;
	945 [label="[Конец.]",shape=box,color=red];
		945 -> 955;
	948 [label="Уже доводилось это слышать.",shape=box,color=red];
		948 -> 958;
	949 [label="Уже приходилось это слышать, но всё же продолжай.",shape=box,color=red];
		949 -> 959;
	950 [label="Прежде об этом не приходилось слышать.",shape=box,color=red];
		950 -> 960;
	951 [label="История эта до сих пор не была известна, которая... в этом, собственно, одна из причин, по которой мы здесь. Ранее, похоже, многое оказалось упущено.",shape=box,color=red];
		951 -> 961;
	954 [label="Но из-за тебя я всё рассказываю не по порядку. Позволь начать как следует.",shape=box,color=blue];
		954 -> 965;
	963 [label="Сейчас ты находишься в состоянии Заражённого. И твоя связь идёт от тех же заражённых штаммов, что применялись для производства всех партий сыворотки Протофрейма.",shape=box,color=red];
		963 -> 973;
	964 [label="Одна говорящая гитара у меня в долгу.",shape=box,color=red];
		964 -> 974;
	962 [label="[Конец.]",shape=box,color=red];
		962 -> 972;
	956 [label="Насколько мне известно - и она, скажем так, не самый надёжный источник, так что не воспринимай это как истину в последней инстанции - штаммы Заражения для каждой партии протофреймов можно было влиять по отдельности.",shape=box,color=red];
		956 -> 966;
	957 [label="Я… ясно.",shape=box,color=blue];
		957 -> 967;
	955 [label="Chat ends.",color=orange];
	958 [label="+10 Chemistry",color=orange];
		958 -> 968;
	959 [label="Либо ты пытаешься льстить моему самолюбию, за что я, кстати, тебя уважаю, либо у тебя просто чрезвычайно скучный день. Что я почти понимаю, тоже пройдя бесчисленные жизненные циклы.",shape=box,color=blue];
		959 -> 969;
	960 [label="Увлекательно. Либо ты лжёшь, либо у меня ещё остались неперевёрнутые тобой камни. Возможно, поэтому ты снова здесь и перечитываешь уже вспаханное поле.",shape=box,color=blue];
		960 -> 970;
	961 [label="Ммм, мало-помалу ты почти убеждаешь меня простить тебя за весь этот беспорядок, который возник из-за твоих действий.",shape=box,color=blue];
		961 -> 971;
	965 [label="Задолго до запуска Зариман Десять-Ноль, ещё до того, как Тэнно вообще появились на горизонте, Архимедиан Маргулис и Баллас познакомились на открытии нового купольного сада.",shape=box,color=blue];
		965 -> 975;
	973 [label="Насколько мне известно - и она, скажем так, не самый надёжный источник, так что не воспринимай это как истину в последней инстанции - штаммы Заражения для каждой партии протофреймов можно было влиять по отдельности.",shape=box,color=red];
		973 -> 981;
	974 [label="Я… ясно.",shape=box,color=blue];
		974 -> 982;
	972 [label="Chat ends.",color=orange];
	966 [label="Поскольку каждый из них живёт в своём собственном «континууме» или времени. Все штаммы заражения связаны, но они как бы живут в… узлах. Всё очень сложно.",shape=box,color=red];
		966 -> 976;
	967 [label="Вселенная определенно стала куда страннее с тех пор, как я её покинул...",shape=box,color=blue];
		967 -> 977;
		967 -> 978;
	968 [label="Тогда я не буду утомлять вас новым пересказом этой саги и предоставлю тебе возможность найти себе другие развлечения на оставшуюся часть дня.",shape=box,color=blue];
		968 -> 979;
	969 [label="Разве не бывало такого, что меня делали предметом твоего веселья.",shape=box,color=blue];
		969 -> 970;
	970 [label="Но? Как бы то ни было... ",shape=box,color=blue];
		970 -> 980;
	971 [label="Update boolean RoatheResetForgiven",color=orange];
		971 -> 970;
	975 [label="Баллас присутствовал там ради церемонии - мы, конечно, любим пышность и торжественность - и Маргулис отчаянно пыталась остаться незамеченной.",shape=box,color=blue];
		975 -> 983;
	981 [label="Поскольку каждый из них живёт в своём собственном «континууме» или времени. Все штаммы заражения связаны, но они как бы живут в… узлах. Всё очень сложно.",shape=box,color=red];
		981 -> 987;
	982 [label="Вселенная определенно стала куда страннее с тех пор, как мне довелось её покинуть...",shape=box,color=blue];
		982 -> 988;
		982 -> 989;
	976 [label="Так как я могу зацикливать время, я могу зацикливать «партии» Заражения ограниченным образом.",shape=box,color=red];
		976 -> 984;
	977 [label="Ты понятия не имеешь.",shape=box,color=red];
		977 -> 985;
	978 [label="Она, пожалуй, возьмёт верх. Впрочем... неважно.",shape=box,color=red];
		978 -> 985;
	979 [label="Update boolean RoatheMargulis1",color=orange];
		979 -> 986;
	980 [label="Баллас и Маргулис.",shape=box,color=blue];
		980 -> 965;
	983 [label="Пойми, мой Узурпатор, у Балласа не было ни единой причины связываться с ней. Если только его влечение не было искренним.",shape=box,color=blue];
		983 -> 990;
	987 [label="Так как я могу зацикливать время, я могу зацикливать «партии» Заражения ограниченным образом.",shape=box,color=red];
		987 -> 993;
	988 [label="Ты понятия не имеешь.",shape=box,color=red];
		988 -> 994;
	989 [label="Она, пожалуй, возьмёт верх. Впрочем... неважно.",shape=box,color=red];
		989 -> 994;
	984 [label="А «она» это кто?",shape=box,color=blue];
		984 -> 991;
		984 -> 992;
	985 [label="Можно было бы осудить тебя за то, что было совершено ради получения желаемого, но меня поражает, что Орокин известны тем, что творили вещи и похуже, если не более изобретательно.",shape=box,color=blue];
		985 -> 931;
	986 [label="Chat ends.",color=orange];
	990 [label="Дело было не только в желании, потому что он мог получить кого угодно – и он делал это довольно часто. Если бы он хотел её, он мог бы просто заполучить её и покончить с этим раз и навсегда.",shape=box,color=blue];
		990 -> 995;
	993 [label="И кто же эта «она»?",shape=box,color=blue];
		993 -> 996;
		993 -> 997;
	994 [label="Как бы то ни было. Всё ради какой-то «любви»?",shape=box,color=blue];
		994 -> 998;
	991 [label="Лиззи. Она бы тебя обожала.",shape=box,color=red];
		991 -> 957;
	992 [label="Говорящая гитара.",shape=box,color=red];
		992 -> 957;
	995 [label="Он был Исполнителем. Одним из самых могущественных из Семерых. Он мог бы позвать её в свою спальню, и она бы явилась туда, не раздумывая.",shape=box,color=blue];
		995 -> 999;
	996 [label="Лиззи. Она бы тебя обожала.",shape=box,color=red];
		996 -> 974;
	997 [label="Говорящая гитара.",shape=box,color=red];
		997 -> 974;
	998 [label="Можно было бы осудить тебя за то, что было совершено во имя так называемой «любви», но меня поражает, что Орокин известны тем, что творили вещи и похуже, если не более изобретательно.",shape=box,color=blue];
		998 -> 931;
	999 [label="Но он этого не поступил. Баллас взглянул на неё в тот вечер, и... он был поражён, Скиталец. Абсолютно и совершенно вне себя.",shape=box,color=blue];
		999 -> 1000;
	1000 [label="Я никогда не видел ничего подобного. Казалось, в комнате вообще никого не было, кроме Маргулис. Он даже... как-то стеснялся заговорить с ней. Он! Баллас!",shape=box,color=blue];
		1000 -> 1001;
		1000 -> 1002;
	1001 [label="Серьёзно?",shape=box,color=red];
		1001 -> 1003;
	1002 [label="Ты это выдумываешь.",shape=box,color=red];
		1002 -> 1004;
	1003 [label="Клянусь всем, что осталось от моей чести! И какой смысл мне лгать? Какое мне дело до твоего мнения о подлинности их отношений?",shape=box,color=blue];
		1003 -> 1005;
	1004 [label="Клянусь остатками своей чести, что это не так! И какой смысл мне лгать? Какое мне дело до твоего мнения о подлинности их отношений?",shape=box,color=blue];
		1004 -> 1005;
	1005 [label="Меня просто огорчает, что вы все так быстро упрощаете то, что на самом деле гораздо сложнее, чем вам хотелось бы.",shape=box,color=blue];
		1005 -> 1006;
	1006 [label="Они были влюблены друг в друга, хотите вы в это верить или нет. Баллас нарушил все классовые правила и традиции, чтобы выбрать своей возлюбленной — и единственной спутницей жизни - Архимедиан. ",shape=box,color=blue];
		1006 -> 1007;
	1007 [label="Только настоящая любовь могла свести мужчину с ума, как это случилось с ним, когда все пошло совсем не так...",shape=box,color=blue];
		1007 -> 1008;
		1007 -> 1009;
	1008 [label="Почему ты так считаешь? Не он ли был виновен в её смерти?",shape=box,color=red];
		1008 -> 1010;
	1009 [label="Именно Баллас приказал её казнить.",shape=box,color=red];
		1009 -> 1010;
	1010 [label="Во-первых, предположим, что всё, что тебе известно, верно, и он действовал исключительно по собственной воле. Предположим, что за кулисами не было никаких политических манёвров, шантажа или чего-либо ещё, что могло бы его к этому подтолкнуть.",shape=box,color=blue];
		1010 -> 1011;
	1011 [label="Даже если бы это было так, и Баллас, не имея на это никакого влияния, потребовал её казни, учти, что было уже слишком поздно. Предательство, которое он почувствовал, уже раскололо его надвое.",shape=box,color=blue];
		1011 -> 1012;
	1012 [label="Его сердце и разум уже были разбиты.",shape=box,color=blue];
		1012 -> 1013;
		1012 -> 1014;
	1013 [label="Я не собираюсь жалеть его, если ты на это намекаешь.",shape=box,color=red];
		1013 -> 1015;
	1014 [label="Из-за Тэнно? Или из-за того, что они с ней сделали?",shape=box,color=red];
		1014 -> 1016;
	1015 [label="Я не прошу тебя ни о чем подобном! Баллас заслуживает только одного, чтобы мы помочились на его могилу – если у него действительно есть могила.",shape=box,color=blue];
		1015 -> 1017;
	1016 [label="В каком-то смысле, и то, и другое. И в каком-то смысле, ни то, ни другое. В тот день, когда он потребовал её казни, он был доведён до безумия. На самом деле, я не удивлюсь, если какая-то его часть точно не вспомнит о совершенном поступке.",shape=box,color=blue];
		1016 -> 1018;
	1017 [label="Я лишь утверждаю, что в тот день, когда он приказал казнить её, он был безумцем. Я бы не удивился, если бы какая-то часть его сознания не помнила полностью, как он это сделал, даже спустя какое-то время.",shape=box,color=blue];
		1017 -> 1018;
	1018 [label="Баллас любил Маргулис. Всем своим существом, полностью, беззаветно преданный ей. Он бы пожертвовал всем ради неё. Душой, телом, Империей Орокин. Всем, что только можно вообразить.",shape=box,color=blue];
		1018 -> 1019;
	1019 [label="Не существовало цены, которая показалась бы ему слишком высокой. Никакая мораль не стоила бы жертв. Если бы вы вручили ему новорожденного младенца и сказали, что Маргулис желает разбить ему голову о скалы, ребёнок был бы мёртв ещё до того, как ты договорил бы фразу.",shape=box,color=blue];
		1019 -> 1020;
	1020 [label="Он бы сжег Изначальную Систему дотла и отстроил бы её по её образу и подобию, Узурпатор... в этом и заключается трагедия.",shape=box,color=blue];
		1020 -> 1021;
	1021 [label="Маргулис? Ах, Маргулис. Милая, милая, дорогая Маргулис... у неё ещё была совесть.",shape=box,color=blue];
		1021 -> 1022;
	1022 [label="И когда она увидела бедных Тэнно, бедных, измученных Бездной детей... ",shape=box,color=blue];
		1022 -> 1023;
	1023 [label="Что-то в её жизни было важнее Балласа. В её жизни было что-то, ради чего она была готова пожертвовать всем... и это был не он.",shape=box,color=blue];
		1023 -> 1024;
	1024 [label="Это была не её любовь к нему.",shape=box,color=blue];
		1024 -> 1025;
	1025 [label="И он знал это, мой дорогой Скиталец. Он знал это с того самого момента, как она обратила внимание. И это стало ещё очевиднее, когда её «безумные животные» сделали их последними, кого она когда-либо видела. По крайней мере, так ходили слухи среди нас, Орокин.",shape=box,color=blue];
		1025 -> 1026;
	1026 [label="Можешь представить себе радость среди Орокин? Видеть, Когда увидели, как обезумевшие отродья Балласа, измученные Бездной Архимедиан, выжигают ей глаза?",shape=box,color=blue];
		1026 -> 1027;
	1027 [label="Но я думаю, всё случилось раньше, в тот самый момент, когда Маргулис боролась за спасение Тэнно, сердце Балласа разбилось на тысячу осколков и больше не восстановилось.",shape=box,color=blue];
		1027 -> 1028;
	1028 [label="Потому что он понял, что в её сердце его место занял кто-то другой.",shape=box,color=blue];
		1028 -> 1029;
	1029 [label="Наверное, именно поэтому мне было его жаль. Но что было дальше? История любви на века... и как она закончилась такой чудовищной трагедией. ",shape=box,color=blue];
		1029 -> 1030;
	1030 [label="Жаль, что ты не видел, как они улыбались друг другу...",shape=box,color=blue];
		1030 -> 1031;
		1030 -> 1032;
	1031 [label="Можешь сколько угодно романтизировать, что у них было, но это не оправдывает то, кем он был. Баллас не может быть прощён за всё, что натворил.",shape=box,color=red];
		1031 -> 1033;
	1032 [label="Я ценю, что их любовь была настоящей. Что он тогда был... сложным. И что Маргулис всё это время не была просто игрушкой.",shape=box,color=red];
		1032 -> 1034;
	1033 [label="Add 1 to Thermostat",color=orange];
		1033 -> 1035;
	1034 [label="Add -1 to Thermostat",color=orange];
		1034 -> 1036;
	1035 [label="+10 Chemistry",color=orange];
		1035 -> 1037;
	1036 [label="+10 Chemistry",color=orange];
		1036 -> 1038;
	1037 [label="И я не пытался ставить знак равенства между ними, Узурпатор. В обсуждении затрагивалась лишь мысль, что человек может быть любим, но при этом способен на ужасные вещи. Ну что ж... У нас, остальных, развращённых глупцов, шансов ещё меньше...",shape=box,color=blue];
		1037 -> 1039;
	1038 [label="В самом деле. Иногда меня утешает мысль о том, что если даже этот повелитель разврата нашёл себе пару, то и у нас остальных ещё есть шанс, да? Хаха!",shape=box,color=blue];
		1038 -> 1039;
	1039 [label="Update boolean RoatheMargulis1",color=orange];
		1039 -> 1040;
	1040 [label="Но и так уже ушло достаточно твоего времени на сегодня. А теперь иди. ",shape=box,color=blue];
		1040 -> 1041;
	1041 [label="Chat ends.",color=orange];
}