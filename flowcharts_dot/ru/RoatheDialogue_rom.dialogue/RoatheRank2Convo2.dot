	883 [label="Ты в курсе, когда-то они были влюблены.",shape=box,color=blue];
		883 -> 888;
		883 -> 887;
		883 -> 886;
	885 [label="Вмешиваться в наши умы... всё ради похоти? Любви? Что это? Как бы это назвать? Полагаю, я просто задаюсь вопросом, стоило ли оно того. Или, полагаю, ты ещё не знаешь, ведь дивиденды ещё не выплачены.",shape=box,color=blue];
		885 -> 890;
	884 [label="Вмешиваться в наши умы... ради чего? Выполнять какой-то... невидимый список дел? Или всё это во имя победы над вашим же заколдованным так называемым «богом»?",shape=box,color=blue];
		884 -> 889;
	888 [label="Кто?",shape=box,color=red];
		888 -> 893;
	887 [label="Мне очень трудно в это поверить.",shape=box,color=red];
		887 -> 892;
	886 [label="[Конец.]",shape=box,color=red];
		886 -> 891;
	890 [label="Полагаю, в этом даже есть странная романтика, хотя и немного... антиутопично, идти на такие меры, чтобы завоевать сердце возлюбленного.",shape=box,color=blue];
		890 -> 895;
	889 [label="Или всё ещё хуже, и тебе было просто любопытно, что произойдёт? И ты просто сидишь и отрываешь ноги насекомым? Мы разобрались с тем, «что» стоит за действиями. Теперь я хочу понять, «зачем».",shape=box,color=blue];
		889 -> 894;
	893 [label="Баллас и Маргулис.",shape=box,color=blue];
		893 -> 897;
	892 [label="Это правда! Я прямо слышу, как ты насмехаешься из Святилища. Но Баллас и Маргулис были очень влюблены друг в друга.",shape=box,color=blue];
		892 -> 896;
	891 [label="Chat ends.",color=orange];
	895 [label="Или всё ещё хуже, и тебе было просто любопытно, что произойдёт? И ты просто сидишь и отрываешь ноги насекомым? Мы разобрались с тем, «что» стоит за действиями. Теперь я хочу понять, «зачем».",shape=box,color=blue];
