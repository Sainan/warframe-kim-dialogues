	2180 [label="Транскрипт: Мы не думали о Владеющих Разумом как о «них», скорее как о «нем». ",shape=box,color=blue];
		2180 -> 5691;
	5691 [label="We faced legions hurled at us with no more regard for their individual lives than corpuscles have.",shape=box,color=blue];
		5691 -> 2178;
	2178 [label="Они были клетками в теле разрастающейся, зловещей массы.",shape=box,color=blue];
		2178 -> 5690;
	5690 [label="We were, I think, too conditioned by our experiences with the Infestation - a hive-mind of quite a different order.",shape=box,color=blue];
		5690 -> 2179;
	2179 [label="С Владеющими Разумом был дан мандат на эволюцию, и их единственной моделью для конечного результата этой эволюции были мы.",shape=box,color=blue];
		2179 -> 5687;
	5687 [label="They were returning to the Origin System not just to obliterate the Orokin, but to replace them and ultimately… perfect them.",shape=box,color=blue];
