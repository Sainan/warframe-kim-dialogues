	j1230188671 [label="VM: SENTIENCE",shape=box,color=blue];
		j1230188671 -> j1612515653;
	j1612515653 [label="Транскрипт: Мы не думали о Владеющих Разумом как о «них», скорее как о «нем». ",shape=box,color=blue];
		j1612515653 -> j2510109600;
	j2510109600 [label="We faced legions hurled at us with no more regard for their individual lives than corpuscles have.",shape=box,color=blue];
		j2510109600 -> j3593828950;
	j3593828950 [label="Они были клетками в теле разрастающейся, зловещей массы.",shape=box,color=blue];
		j3593828950 -> j1724713935;
	j1724713935 [label="We were, I think, too conditioned by our experiences with the Infestation - a hive-mind of quite a different order.",shape=box,color=blue];
		j1724713935 -> j377228344;
	j377228344 [label="С Владеющими Разумом был дан мандат на эволюцию, и их единственной моделью для конечного результата этой эволюции были мы.",shape=box,color=blue];
		j377228344 -> j400150128;
	j400150128 [label="They were returning to the Origin System not just to obliterate the Orokin, but to replace them and ultimately… perfect them.",shape=box,color=blue];
		j400150128 -> j921430358;
	j921430358 [label="Add 1 to HellStory counter",color=orange];
		j921430358 -> "Chat ends.";
}