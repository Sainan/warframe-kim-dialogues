	"Chat ends." [color=orange];
	j1581533745 [label="ГС: РАЗУМНОСТЬ",shape=box,color=blue];
		j1581533745 -> j3559758894;
	j3559758894 [label="Транскрипт: Мы не думали о Владеющих Разумом как о «них», скорее как о «нем». ",shape=box,color=blue];
		j3559758894 -> j713357157;
	j713357157 [label="Мы сталкивались с легионами, швыряемыми в бой без малейшей заботы об их индивидуальных жизнях, чем о жизнях частиц.",shape=box,color=blue];
		j713357157 -> j90967749;
	j90967749 [label="Они были клетками в теле разрастающейся, зловещей массы.",shape=box,color=blue];
		j90967749 -> j2440196064;
	j2440196064 [label="Думаю, нас слишком сформировал опыт столкновений с Заражением — мы словно коллективный разум совершенно иного порядка.",shape=box,color=blue];
		j2440196064 -> j911804153;
	j911804153 [label="С Владеющими Разумом был дан мандат на эволюцию, и их единственной моделью для конечного результата этой эволюции были мы.",shape=box,color=blue];
		j911804153 -> j4014079928;
	j4014079928 [label="Они возвращались в Изначальную Систему не только ради истребления Орокин, но чтобы занять их место и в итоге... усовершенствовать их.",shape=box,color=blue];
		j4014079928 -> j921430358;
	j921430358 [label="Add 1 to HellStory counter",color=orange];
		j921430358 -> "Chat ends.";
}