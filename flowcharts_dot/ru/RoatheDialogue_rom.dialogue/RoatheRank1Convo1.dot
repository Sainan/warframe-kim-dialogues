digraph {
	"RoatheRank1Convo1 begins." [color=orange];
		"RoatheRank1Convo1 begins." -> j3998890108;
	j3998890108 [label="Evaluate expressions on HellStory counter",color=orange];
		j3998890108 -> j2065350279 [label="x >= 21",color=purple];
		j3998890108 -> j601968829 [label="x >= 6",color=purple];
		j3998890108 -> j2777406173 [label="x < 6",color=purple];
		j3998890108 -> j2777406173 [label="false",color=purple];
	j2065350279 [label="Я должен похвалить тебя за твою дерзость! А где уверенность, что ты не замаскированный Орокин? Может быть, ты прячешь свою небесно-голубую кожу, чтобы не привлекать внимания остальных?!",shape=box,color=blue];
		j2065350279 -> j2240191472;
		j2065350279 -> j362802597;
		j2065350279 -> j4003049020;
	j601968829 [label="Boolean RoatheResetEdgeCase is now true.",color=orange];
		j601968829 -> j2777406173;
	j2777406173 [label="Аномалия, рождённая Бездной. «Скиталец». Узурпатор. Наконец-то мы наконец-то говорим. Пойдём. У Дьявола есть предложение...",shape=box,color=blue];
		j2777406173 -> j986531043;
		j2777406173 -> j2243473832;
		j2777406173 -> j4110412987;
		j2777406173 -> j3822353266;
	j2240191472 [label="Здравствуй, Роут.",shape=box,color=red];
		j2240191472 -> j1159225722;
	j362802597 [label="В чём именно ты меня обвиняешь?",shape=box,color=red];
		j362802597 -> j2769716576;
	j4003049020 [label="Прошу прощения?",shape=box,color=red];
		j4003049020 -> j2769716576;
	j986531043 [label="Узурпатор?",shape=box,color=red];
		j986531043 -> j687492139;
	j2243473832 [label="Что… за сделка?",shape=box,color=red];
		j2243473832 -> j3344002220;
	j4110412987 [label="Какое же предложение мог бы выдвинуть мне «Дьявол Тау»?",shape=box,color=red];
		j4110412987 -> j272384815;
	j3822353266 [label="Здравствуй, Роут.",shape=box,color=red];
		j3822353266 -> j1976551150;
	j1159225722 [label="Ах, хорошо! Ты действительно знаешь моё имя! Я был уверен, что ты каким-то образом упустил его из виду, раз был так занят тем, что безжалостно убивал меня снова и снова!",shape=box,color=blue];
		j1159225722 -> j731663062;
	j2769716576 [label="Неужели тебе больше нечем заняться?! Или игра в «Прикрепи рог к Язнаку» раз за разом — это и есть лучшее времяпрепровождение?!",shape=box,color=blue];
		j2769716576 -> j731663062;
	j687492139 [label="Boolean RoatheUsurper is now true.",color=orange];
		j687492139 -> j772119965;
	j3344002220 [label="Ммм, не стоит ни беспокоиться, ни слишком радоваться. Пока. Это всего лишь деловая договорённость между двумя людьми, которым обоим это может принести значительную выгоду.",shape=box,color=blue];
		j3344002220 -> j1976551150;
	j272384815 [label="+5 Chemistry",color=orange];
		j272384815 -> j482331380;
	j1976551150 [label="Итак. Внимательно слушай. Эти два фанатика до крайности утомительно и скрупулёзно повторяют свои упрёки в мой адрес. Я жду от тебя поведения, возвышающегося над подобной примитивностью.",shape=box,color=blue];
		j1976551150 -> j2789161612;
		j1976551150 -> j3792609414;
	j731663062 [label="Мне крайне трудно поверить, что всё это — вся несправедливость, которую я претерпел от твоих рук, всё это обнажение моей души — было вызвано не чистой злобой по твоему велению!",shape=box,color=blue];
		j731663062 -> j3730915522;
		j731663062 -> j3423399495;
		j731663062 -> j3485150068;
	j772119965 [label="+5 Chemistry",color=orange];
		j772119965 -> j3601408597;
	j482331380 [label="Вижу, моя репутация заранее обо мне говорит. Хорошо. Это сэкономит нам время.",shape=box,color=blue];
		j482331380 -> j1320862920;
	j2789161612 [label="Я не подчиняюсь твоим приказам.",shape=box,color=red];
		j2789161612 -> j4026548805;
	j3792609414 [label="Попробую что-нибудь придумать.",shape=box,color=red];
		j3792609414 -> j1138169362;
	j3730915522 [label="Это не казалось приоритетом?",shape=box,color=red];
		j3730915522 -> j1122769696;
	j3423399495 [label="Я… просто у меня не дошли руки сделать это раньше.",shape=box,color=red];
		j3423399495 -> j3198153789;
	j3485150068 [label="Ты не помнишь… но мы уже проходили через это.",shape=box,color=red];
		j3485150068 -> j3671906171;
	j3601408597 [label="Ах, вот что ты такое, да? Тэнно отняли Изначальную систему у Орокин. А ты, словно птенец кукушки в чужом гнезде, влезаешь в этот мир из своего.",shape=box,color=blue];
		j3601408597 -> j862445897;
	j1320862920 [label="И нет никаких оснований для беспокойства или волнения… пока. Это всего лишь деловая договорённость между двумя людьми, которым обоим это может принести значительную выгоду.",shape=box,color=blue];
		j1320862920 -> j1976551150;
	j4026548805 [label="Evaluate expressions on HellKeyPlayed counter",color=orange];
		j4026548805 -> j4089233898 [label="x >= 21",color=purple];
		j4026548805 -> j271325316 [label="x >= 1",color=purple];
		j4026548805 -> j417756086 [label="x <= 0",color=purple];
		j4026548805 -> j417756086 [label="false",color=purple];
	j1138169362 [label="Постарайся, чтобы так и было.",shape=box,color=blue];
		j1138169362 -> j3982579628;
	j1122769696 [label="Не было похоже, что...",shape=box,color=blue];
		j1122769696 -> j334369535;
	j3198153789 [label="Ох, прости, что доставил тебе неудобства, не знал, что все твои танцы уже заняты!",shape=box,color=blue];
		j3198153789 -> j1128979708;
	j3671906171 [label="+5 Chemistry",color=orange];
		j3671906171 -> j4170677707;
	j862445897 [label="И это делает тебя, как минимум по двум причинам, узурпатором в моих глазах. (И, возможно, по третьей, если верить тому, что рассказал мне дворецкий о Дувири, но это спор на другой раз.)",shape=box,color=blue];
		j862445897 -> j1976551150;
	j4089233898 [label="Тебе удалось это неоднократно и весьма болезненно продемонстрировать, спасибо.",shape=box,color=blue];
		j4089233898 -> j3982579628;
	j271325316 [label="Тебе удалось дать это понять вполне ясно.",shape=box,color=blue];
		j271325316 -> j3982579628;
	j417756086 [label="Посмотрим.",shape=box,color=blue];
		j417756086 -> j3982579628;
	j3982579628 [label="Итак, условие простое, мой обаятельно скользкий и эфемерный новый «друг».",shape=box,color=blue];
		j3982579628 -> j1071362491;
	j334369535 [label="Это не казалось приоритетом?!",shape=box,color=blue];
		j334369535 -> j241029584;
	j1128979708 [label="Право же. Я в шоке. Твои манеры просто отвратительны, Скиталец.",shape=box,color=blue];
		j1128979708 -> j704718989;
	j4170677707 [label="Пардон? И как же я мог забыть, что ты шаришься в моей голове, словно в чаше с Малиумом во время пира Наберуса!",shape=box,color=blue];
		j4170677707 -> j1516885882;
		j4170677707 -> j1697195405;
	j1071362491 [label="Evaluate expressions on HellKeyPlayed counter",color=orange];
		j1071362491 -> j65285536 [label="x >= 21",color=purple];
		j1071362491 -> j2751644353 [label="x >= 1",color=purple];
		j1071362491 -> j3308372877 [label="x <= 0",color=purple];
		j1071362491 -> j3308372877 [label="false",color=purple];
	j241029584 [label="Ты всегда копаешься в чужих воспоминаниях и разрушаешь их, не утруждая себя тем, чтобы узнать людей сначала?!",shape=box,color=blue];
		j241029584 -> j2787443193;
	j704718989 [label="Но полагаю, с этим ничего нельзя поделать. Ты знаешь правду. Я предстал перед тобой во всей своей отвратительной трусости.",shape=box,color=blue];
		j704718989 -> j359233779;
	j1516885882 [label="Короче говоря, похоже, что Заражение распространяется и на протофреймовые сыворотки…",shape=box,color=red];
		j1516885882 -> j635972311;
	j1697195405 [label="A. В общем. Как сказать. У меня есть способность зацикливать время.",shape=box,color=red];
		j1697195405 -> j635972311;
	j65285536 [label="Поскольку ты уже копошишься у меня в голове, словно пьяный разбойник в лавке стекольщика, мне нужна твоя помощь в попытке понять, что всё это значит.",shape=box,color=blue];
		j65285536 -> j1388723454;
	j2751644353 [label="Ты и эти двое фанатиков уже вовсю хозяйничают у меня в голове, словно пьяный воришка в лавке стекольщика. Мне понадобится твоя помощь, чтобы разобраться, что всё это значит.",shape=box,color=blue];
		j2751644353 -> j1388723454;
	j3308372877 [label="Когда Альбрехт воткнул шприц мне в шею и превратил меня в нечто, чем я стал, он сделал ещё кое-что. Игры между Орокин — это одно. А это… это совсем другое.",shape=box,color=blue];
		j3308372877 -> j30098761;
	j2787443193 [label="Твои манеры просто ужасны!",shape=box,color=blue];
		j2787443193 -> j704718989;
	j359233779 [label="Я полагаю, ты здесь лишь для того, чтобы насмехаться надо мной? Прошу тебя, понасмехайся вдоволь прямо сейчас, чтобы мы могли спокойно продолжить.",shape=box,color=blue];
		j359233779 -> j1562935521;
	j635972311 [label="И мне казалось, что это сработало на протофреймах в 1999 году из-за зацикливания самого года, но это не так.",shape=box,color=red];
		j635972311 -> j3189143099;
	j1388723454 [label="Мне нужна не только твоя помощь в возвращении памяти, плюс, ко всему прочему, я, кажется, лишился способности самостоятельно отличить правду от лжи!",shape=box,color=blue];
		j1388723454 -> j2858022799;
		j1388723454 -> j38397580;
	j30098761 [label="Он украл у меня большую часть воспоминаний. Я вижу этого маленького… тебя, бегающего со своим травмированными маленькими друзьями-Тэнно. Я вижу, что Лотос помогает этому восстановиться.",shape=box,color=blue];
		j30098761 -> j1109958149;
		j30098761 -> j2952909619;
	j1562935521 [label="Я бы предпочёл не иметь дела с этим существом, путающимся под ногами, словно декоративно выведенный какой-то модницей тявкающий кубрау.",shape=box,color=blue];
		j1562935521 -> j651079107;
		j1562935521 -> j1885061200;
	j3189143099 [label="Мне кажется, это… скорее связано с самим Заражением. Говорящая гитара вроде как кое-что об этом намекнула. Гельминт помог тебе добраться сюда, не так ли?",shape=box,color=red];
		j3189143099 -> j1567709138;
	j2858022799 [label="То есть ты хочешь сказать, что тебе… просто нужно с кем-то поговорить?",shape=box,color=red];
		j2858022799 -> j1363312458;
	j38397580 [label="Я с удовольствием помогу, если смогу, просто не знаю, как именно.",shape=box,color=red];
		j38397580 -> j2706315665;
	j1109958149 [label="Итак, почему бы тебе не отправиться в Тёмный Рефракторий в одиночку?",shape=box,color=red];
		j1109958149 -> j2427971275;
	j2952909619 [label="Ребёнок — не «Это».",shape=box,color=red];
		j2952909619 -> j887069931;
	j651079107 [label="Ты убежал. Многие бегут. Речь идёт о том, чтобы рационализировать то, что произошло.",shape=box,color=red];
		j651079107 -> j3384398563;
	j1885061200 [label="Я не стану над тобой насмехаться. Ты принял решение продолжить сражаться.",shape=box,color=red];
		j1885061200 -> j4074100514;
	j1567709138 [label="Твоя тревожность выдаёт твою неуверенность в этом разговоре, Скиталец. Особенно когда речь заходит о содержимом моей черепной коробки.",shape=box,color=blue];
		j1567709138 -> j2694062847;
	j1363312458 [label="О, пожалуйста, не своди это к тому, что мне нужно просто полежать на кушетке и поболтать о своих чувствах.",shape=box,color=blue];
		j1363312458 -> j2706315665;
	j2706315665 [label="Мне нужен человек, чтобы управлять машиной по моей воле, ибо сам я в данный момент не в силах этого сделать.",shape=box,color=blue];
		j2706315665 -> j3961224306;
	j2427971275 [label="I would do the deed myself, believe me - but I cannot! The blasted protoframe serum Albrecht poisoned me with removed any ability I have of operating the damnable contraption on my own!",shape=box,color=blue];
		j2427971275 -> j3284289479;
	j887069931 [label="Уверяю тебя, «Это» — весьма точное определение.",shape=box,color=blue];
		j887069931 -> j3827142187;
	j3384398563 [label="Add 1 to Thermostat counter",color=orange];
		j3384398563 -> j1580577868;
	j4074100514 [label="Add -1 to Thermostat counter",color=orange];
		j4074100514 -> j1911897577;
	j2694062847 [label="Это так, я прибыл сюда через Гельминта. Которого сконструировал и вырастил собственноручно, благодарю. Так значит, ты хочешь сказать, что мои воспоминания стёрты?! О чем, о наших беседах?!",shape=box,color=blue];
		j2694062847 -> j1350662491;
	j3961224306 [label="I am also in need of someone to help me record my memories and assist me in reconciling them. A temporary assistant of sorts.",shape=box,color=blue];
		j3961224306 -> j1724449141;
	j3284289479 [label="Кроме того, мне нужна не только твоя помощь в возвращении памяти: плюс, ко всему прочему, я, кажется, лишился способности самостоятельно отличить правду от лжи!",shape=box,color=blue];
		j3284289479 -> j2858022799;
		j3284289479 -> j38397580;
	j3827142187 [label="And I would do the deed myself, believe me - but I cannot! The blasted protoframe serum Albrecht poisoned me with removed any ability I have of operating the damnable contraption on my own!",shape=box,color=blue];
		j3827142187 -> j3284289479;
	j1580577868 [label="Великолепно. Ещё одна жужжащая мошка, чтобы летать вокруг моих ушей и увещевать меня о необходимости самоанализа и покаяния?",shape=box,color=blue];
		j1580577868 -> j3996089562;
	j1911897577 [label="+5 Chemistry",color=orange];
		j1911897577 -> j2663491131;
	j1350662491 [label="Потому что у меня, безусловно, остались самые «тёплые» воспоминания о превращении меня в фарш тобой, ради собственного кровавого развлечения. Какой в этом вообще смысл?",shape=box,color=blue];
		j1350662491 -> j3838072832;
		j1350662491 -> j3474270351;
	j1724449141 [label="И взамен я даю тебе торжественное обещание, что буду сидеть здесь… спокойно. Никому не причиню вреда, заверяю тебя… вполне способен вести себя прилично. Не причиню вреда фанатикам. Или дворецкому. Или зверям Альбрехта, искажённым Бездной.",shape=box,color=blue];
		j1724449141 -> j1245816585;
	j3996089562 [label="Мне повезло.",shape=box,color=blue];
		j3996089562 -> j3059318115;
	j2663491131 [label="Сейчас мои занятия кажутся мне «гниением в склепе в компании пары бестолковых фанатиков и раздачей безделушек травмированным войной детям».",shape=box,color=blue];
		j2663491131 -> j3897034131;
	j3838072832 [label="Я не знаю, и, признаться, не собираюсь и дальше терпеть твои оскорбления, Роут. Я не собираю всех вместе только ради того, чтобы выслушивать от тебя упрёки.",shape=box,color=red];
		j3838072832 -> j3426384632;
	j3474270351 [label="Насколько я понимаю, наши беседы не затрагивают глубинную память. Это скорее поверхностные воспоминания. То, что мы обнаружили в твоём прошлом, скорее относится к твоим основным воспоминаниям, полагаю.",shape=box,color=red];
		j3474270351 -> j1845050482;
	j1245816585 [label="And more importantly, I will do no harm to Albrecht's twisted family that sits about like so much mutated flora above us - unwitting to our very presence.",shape=box,color=blue];
		j1245816585 -> j336327534;
		j1245816585 -> j792936764;
		j1245816585 -> j2788686988;
	j3059318115 [label="Я собираюсь заниматься своими делами, Скиталец, но факт остаётся фактом — ты слишком много знаешь о моем прошлом и о том, что я совершил. И нам придётся просто… существовать в этом состоянии.",shape=box,color=blue];
		j3059318115 -> j2559357191;
	j3897034131 [label="Но я думаю, что сейчас так и называется.",shape=box,color=blue];
		j3897034131 -> j3059318115;
	j3426384632 [label="Yes. I could hazard a guess as to why you have summoned your Void-gifts to wipe our minds of recent events. How perfectly predictable.",shape=box,color=blue];
		j3426384632 -> j3856478886;
	j1845050482 [label="Восхитительно. Просто чудесно. Я в руках фрика, что может стереть мою память по прихоти! Как мило.",shape=box,color=blue];
		j1845050482 -> j3856478886;
	j336327534 [label="Разве мы не заключили сделку? А теперь ты мне угрожаешь?",shape=box,color=red];
		j336327534 -> j567787468;
	j792936764 [label="Роут, прошу, остановись и выслушай меня хотя бы секунду.",shape=box,color=red];
		j792936764 -> j3555734475;
	j2788686988 [label="Что мне нужно сделать?",shape=box,color=red];
		j2788686988 -> j263282988;
	j2559357191 [label="Постарайся не доставлять мне излишних неудобств, и я обещаю отплатить тебе тем же.",shape=box,color=blue];
		j2559357191 -> j823133189;
		j2559357191 -> j477923920;
	j3856478886 [label="Что ж. Если то, что ты говоришь, правда — а эта история достаточно безумна, чтобы быть реальностью — я постараюсь не упрекать тебя в том, что ты знаешь эту глубокую и ужасную правду о мне.",shape=box,color=blue];
		j3856478886 -> j1410896248;
	j567787468 [label="Неужели ты не внимательно слушаешь? Право же, понимание прочитанного в наши дни… Я не угрожал тебе, Узурпатор. И никому другому тоже.",shape=box,color=blue];
		j567787468 -> j1164074906;
	j3555734475 [label="Должно быть, это будет великолепно. Пожалуйста, начинай, весь мир – твой театр.",shape=box,color=blue];
		j3555734475 -> j2094977199;
		j3555734475 -> j111418023;
		j3555734475 -> j242036573;
	j263282988 [label="Неужели ты не внимательно слушаешь? Право же, умение понимать сказанное в наши дни… Я пытаюсь заключить с тобой сделку, Узурпатор. Мне трудно поверить, что ты не можешь уследить за ходом моих мыслей.",shape=box,color=blue];
		j263282988 -> j626008521;
	j823133189 [label="Нет.",shape=box,color=red];
		j823133189 -> j952724910;
	j477923920 [label="Мне кажется, это справедливо.",shape=box,color=red];
		j477923920 -> j1110473985;
	j1410896248 [label="Хотя я хотел бы тебя попросить, если можно, высказать все насмешки, что у тебя есть, мне в лицо, чтобы мы могли двигаться дальше.",shape=box,color=blue];
		j1410896248 -> j1562935521;
	j1164074906 [label="Я лишь констатировал, что если мы дойдём до точки, когда я не смогу достичь своих целей, у меня может не остаться причин сидеть тихо.",shape=box,color=blue];
		j1164074906 -> j626008521;
	j2094977199 [label="Я — причина смерти Балласа. Не заставляй меня перекраивать свои планы.",shape=box,color=red];
		j2094977199 -> j3489988421;
	j111418023 [label="Если ты нуждаешься в моей помощи, это не лучший способ её попросить.",shape=box,color=red];
		j111418023 -> j3982059635;
	j242036573 [label="Я знаю, мы с тобой не так уж и долго знакомы — если честно. Но я здесь, чтобы помочь тебе.",shape=box,color=red];
		j242036573 -> j2947758567;
	j626008521 [label="Если моё предложение тебе не понравится, позволишь ли ты мне его улучшить?",shape=box,color=blue];
		j626008521 -> j2110939429;
	j952724910 [label="+5 Chemistry",color=orange];
		j952724910 -> j2992360392;
	j1110473985 [label="+15 Chemistry",color=orange];
		j1110473985 -> j2472555651;
	j3489988421 [label="+5 Chemistry",color=orange];
		j3489988421 -> j3548815699;
	j3982059635 [label="А если тебе нужно и моё мнение, то я предлагаю — как уже говорил — прийти к соглашению.",shape=box,color=blue];
		j3982059635 -> j626008521;
	j2947758567 [label="И что? Ах. Понимаю. Ты возражаешь против моего тона, не так ли? Прошу прощения, я не знал, что ты так легко раздражаешься.",shape=box,color=blue];
		j2947758567 -> j626008521;
	j2110939429 [label="Мне стало известно о множестве дел на Деймосе, где моя помощь могла бы оказаться не просто полезной, но, осмелюсь сказать, решающей.",shape=box,color=blue];
		j2110939429 -> j353330134;
	j2992360392 [label="Ха! Должен признать, честность твоя вызывает уважение, по крайней мере.",shape=box,color=blue];
		j2992360392 -> j1225607410;
	j2472555651 [label="Прекрасно. Хорошо знать, что с тобой хотя бы… приятно иметь дело.",shape=box,color=blue];
		j2472555651 -> j1225607410;
	j3548815699 [label="Если бы у тебя была возможность слышать как я тут смеюсь! Спасибо тебе, Скиталец, за то, что не был занудой!",shape=box,color=blue];
		j3548815699 -> j1582740869;
	j353330134 [label="Включая, но не ограничиваясь этим, примирение разбитого сердца старого дворецкого и его отчужденной семьи, обитающей наверху.",shape=box,color=blue];
		j353330134 -> j1399956679;
