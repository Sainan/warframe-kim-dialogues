		j1582740869 -> j745336908;
	j1399956679 [label="Семья, которая, как я уже говорил, даже не подозревает, что мы вообще здесь находимся. И не имеет ни малейшего представления о том, что Альбрехт всё ещё жив, я прав?",shape=box,color=blue];
