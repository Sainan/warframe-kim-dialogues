	j2001445475 [label="И то, что тебе не удалось убедить того скорбящего слугу? Обещаю… я смогу.",shape=box,color=blue];
		j2001445475 -> j2589118510;
	j2589118510 [label="And so we finally come to my proposal: help me sort out the matter of my missing memories, and get to the \"bottom\" of it all - no pun intended.",shape=box,color=blue];
