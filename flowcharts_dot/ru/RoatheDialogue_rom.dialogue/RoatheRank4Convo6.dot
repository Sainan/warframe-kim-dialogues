digraph {
	"RoatheRank4Convo6 begins." [color=orange];
		"RoatheRank4Convo6 begins." -> j4159245049;
	j4159245049 [label="Какой твой любимый способ убивать, Узурпатор?",shape=box,color=blue];
		j4159245049 -> j2506657478;
		j4159245049 -> j668900014;
		j4159245049 -> j1310452999;
	j2506657478 [label="Прошу прощения?",shape=box,color=red];
		j2506657478 -> j2608935808;
	j668900014 [label="Ты спрашиваешь, чтобы узнать?",shape=box,color=red];
		j668900014 -> j955395339;
	j1310452999 [label="[Конец.]",shape=box,color=red];
		j1310452999 -> "Chat ends.";
	j2608935808 [label="В последнее время меня посещают философские размышления, и мне просто любопытно.",shape=box,color=blue];
		j2608935808 -> j896457025;
	j955395339 [label="Ха! Вряд ли. Хотя… общение с тобой было бы довольно забавным. Нет, в последнее время я больше погрузился в философствование, и мне просто интересно.",shape=box,color=blue];
		j955395339 -> j896457025;
	"Chat ends." [color=orange];
	j896457025 [label="Что касается численности, я полагаю, мы с тобой, вероятно, примерно равны. А насчёт смертоносности… мм… Я бы не стал делать ставку, да и особого интереса в условном состязании мечей у меня нет.",shape=box,color=blue];
		j896457025 -> j1223209868;
	j1223209868 [label="Убийца против убийцы. Что тебе больше по вкусу? Предпочитаешь что-то близкое и личное? Тишь и скрытность или хаос поля боя?",shape=box,color=blue];
		j1223209868 -> j1224801274;
		j1223209868 -> j4110116338;
		j1223209868 -> j1244622687;
		j1223209868 -> j2353527697;
	j1224801274 [label="Я предпочитаю хаос. Взрывы. Выстрелы. Громкие звуки. Чем больше, тем веселее.",shape=box,color=red];
		j1224801274 -> j2937349673;
	j4110116338 [label="Скрытность. Я предпочитаю устранять врага ещё до того, как он узнает о моём присутствии. Если бы мог, сделал бы это там, где он спит.",shape=box,color=red];
		j4110116338 -> j676977641;
	j1244622687 [label="Я ненавижу драться. Жаль, что мне приходится это делать.",shape=box,color=red];
		j1244622687 -> j3475232083;
	j2353527697 [label="Это отвратительный разговор.",shape=box,color=red];
		j2353527697 -> j1081307251;
	j2937349673 [label="Boolean RoatheSoldier is now true.",color=orange];
		j2937349673 -> j2080975323;
	j676977641 [label="Boolean RoatheAssassin is now true.",color=orange];
		j676977641 -> j1296727779;
	j3475232083 [label="О, мой бедный, бедный Узурпатор, если бы ты только слышал мой смех...",shape=box,color=blue];
		j3475232083 -> j3532273667;
	j1081307251 [label="Тогда прочь.",shape=box,color=blue];
		j1081307251 -> "Chat ends.";
	j2080975323 [label="Бывалому солдату, как я, это неудивительно. Особенно зная твою историю. Столько крови тянется за тобой, куда бы ты ни пошёл. Сначала Дувири, потом “Нармер”, теперь эта Хёльвания. И вот, новое дело.",shape=box,color=blue];
		j2080975323 -> j1676008329;
	j1296727779 [label="Ах, убийца среди нас! Такой полезный и такой недооценённый. Я всегда сравнивал убийц с талантливыми дворецкими.",shape=box,color=blue];
		j1296727779 -> j1945603012;
	j3532273667 [label="Ты жалкое, нищее создание. Ради твоего же блага надеюсь, что ты мне лжёшь.",shape=box,color=blue];
		j3532273667 -> j2343021508;
	j1676008329 [label="Кто знает, что ещё, или что ты забыл за это время. Смерть — твоё искусство, и ты рисуешь миры с её помощью.",shape=box,color=blue];
		j1676008329 -> j3937007993;
	j1945603012 [label="Когда они выполняют свою работу исключительно хорошо, это всегда остаётся незамеченным.",shape=box,color=blue];
		j1945603012 -> j156745760;
	j2343021508 [label="+20 Chemistry",color=orange];
		j2343021508 -> j928671687;
	j3937007993 [label="Итак! Как же твоя любимая кисть? Давай разберёмся.",shape=box,color=blue];
		j3937007993 -> j1871130766;
		j3937007993 -> j761031111;
		j3937007993 -> j2758414585;
		j3937007993 -> j1060613689;
	j156745760 [label="Итак. Кинжал? Яд? Лук?",shape=box,color=blue];
		j156745760 -> j3280886971;
		j156745760 -> j896769684;
		j156745760 -> j531002414;
		j156745760 -> j2702769328;
		j156745760 -> j4056056663;
	j928671687 [label="Иначе это, пожалуй, самая печальная вещь, что я слышал за все свои годы.",shape=box,color=blue];
		j928671687 -> j2927459171;
	j1871130766 [label="Я, честно говоря, обойдусь всем, что под руку попадётся. Люблю импровизировать.",shape=box,color=red];
		j1871130766 -> j1571614505;
	j761031111 [label="Лук. Грациозный и смертельный.",shape=box,color=red];
		j761031111 -> j3526026190;
	j2758414585 [label="Клинок. Мне нравится подходить вплотную.",shape=box,color=red];
		j2758414585 -> j1341679109;
	j1060613689 [label="Винтовки и огнестрел. Громкие, но своё дело делают.",shape=box,color=red];
		j1060613689 -> j3056928896;
	j3280886971 [label="Я, честно говоря, обойдусь всем, что под руку попадётся. Люблю импровизировать.",shape=box,color=red];
		j3280886971 -> j1124249576;
	j896769684 [label="Лук. Грациозный и бесшумный.",shape=box,color=red];
		j896769684 -> j950571038;
	j531002414 [label="Снайперская винтовка. Один выстрел? Один труп.",shape=box,color=red];
		j531002414 -> j383602470;
	j2702769328 [label="Яд. Я исчезаю раньше, чем они вообще понимают, что уже мертвы.",shape=box,color=red];
		j2702769328 -> j1055327344;
	j4056056663 [label="Кинжал. Мне нравится его… интимность.",shape=box,color=red];
		j4056056663 -> j1027131929;
	j2927459171 [label="Boolean RoatheWeaponNone is now true.",color=orange];
		j2927459171 -> "Chat ends.";
	j1571614505 [label="Вот сижу и представляю, как ты носишься по полю боя с медицинской лавкой, прорываясь сквозь солдат, размахивая шиной, примотанной к согнутой металлической трубе.",shape=box,color=blue];
		j1571614505 -> j2650534474;
	j3526026190 [label="Владеть луком в разгар битвы требует решимости и такой ясности мысли, какую немногие могут обрести. И, разумеется, твёрдых рук.",shape=box,color=blue];
		j3526026190 -> j143043681;
	j1341679109 [label="Мм, осторожно. Не волнуйся слишком сильно, Узурпатор. Как бы я хотел увидеть, как ты танцуешь на поле боя, с оружием в руках и в брызгах крови, словно лепестки распустившегося цветка...",shape=box,color=blue];
		j1341679109 -> j3992782568;
	j3056928896 [label="Они стали рабочей лошадкой любой войны с самого момента своего появления, и не без причины, Узурпатор. Однако трудно отрицать, что, достигнув своей цели, они безукоризненно выполняют свою задачу.",shape=box,color=blue];
		j3056928896 -> j1303932571;
	j1124249576 [label="Вот сижу и представляю, как ты устраняешь кого‑то столовым прибором или ножкой стула. Как ты гасишь чью‑то жизнь с помощью занавесочной подхватки.",shape=box,color=blue];
		j1124249576 -> j1438671316;
	j950571038 [label="Охотничий способ. Несложный, но элегантный в своей простоте. Иногда самые простые и старые методы оказываются по своей сути самыми эффективными.",shape=box,color=blue];
		j950571038 -> j4124182272;
	j383602470 [label="Немного безлично и стерильно на мой вкус, но я не могу судить об эффективности. В спокойствии этого есть своя прелесть.",shape=box,color=blue];
		j383602470 -> j3498639464;
	j1055327344 [label="Зловещий аптекарь, да? Варит настойки и разливает их из флаконов в стаканы ничего не подозревающих людей? Или подмешивает яд в ножи и пули, так что малейший скользящий удар на поле боя становится смертельным?",shape=box,color=blue];
		j1055327344 -> j3923751621;
	j1027131929 [label="Мм, осторожно. Не волнуй меня слишком сильно, Узурпатор. Как же интригует эта картина: однажды ночью я проснусь, а ты будешь прятаться в тени, с кинжалом наготове, готовым нанести удар...",shape=box,color=blue];
		j1027131929 -> j228104629;
	j2650534474 [label="+10 Chemistry",color=orange];
		j2650534474 -> j2797930581;
	j143043681 [label="Тишина всего этого заслуживает восхищения. Вложить стрелу на тетиву, натянуть её, предвкушение выстрела… а затем сладкая, сладкая смерть, когда она находит свою цель?",shape=box,color=blue];
		j143043681 -> j506886626;
	j3992782568 [label="Я понимаю желание личного участия. Наблюдать, как конечности твоей жертвы падают, когда ты отнимаешь их жизнь. Видеть, как их безжизненные тела оседают перед тобой. Знать, что это сделал именно ты, и никто другой.",shape=box,color=blue];
		j3992782568 -> j1460517399;
	j1303932571 [label="Грязные, шумные, возмутительно дорогие. Но такие, такие хорошие в убийстве.",shape=box,color=blue];
		j1303932571 -> j2796388331;
	j1438671316 [label="+10 Chemistry",color=orange];
		j1438671316 -> j2267663487;
	j4124182272 [label="Тишина всего этого заслуживает восхищения. Вложить стрелу на тетиву, натянуть её, предвкушение выстрела… а затем сладкая, сладкая смерть, когда она находит свою цель?",shape=box,color=blue];
		j4124182272 -> j2049552823;
	j3498639464 [label="В кажущемся непрекращающемся грохоте поля боя снайпер должен найти своё дыхание, словно прилив и отлив океана.\nВдох, выдох, и чья‑то жизнь оборвана.",shape=box,color=blue];
		j3498639464 -> j2817474006;
	j3923751621 [label="Я видел, как целые батальоны превращались в слизь из‑за одного единственного пореза на руке одного солдата. Токсин, который распространяется из крови в лёгкие, а затем в лёгкие другого, способен уничтожать целые страны.",shape=box,color=blue];
		j3923751621 -> j4209034612;
	j228104629 [label="Я понимаю стремление к личному участию. Взглянуть другому в глаза и наблюдать, как они становятся стеклянными и тусклыми,\nкак свет угасает, а тепло уходит из его тела.",shape=box,color=blue];
		j228104629 -> j677665985;
	j2797930581 [label="Я… не могу решить, делает ли это тебя более или менее ужасающим, Узурпатор. Думаю, остановлюсь на «более». Так или иначе, это кажется мне забавным и по‑своему впечатляющим.",shape=box,color=blue];
		j2797930581 -> j777855750;
	j506886626 [label="+10 Chemistry",color=orange];
		j506886626 -> j2600607584;
	j1460517399 [label="+10 Chemistry",color=orange];
		j1460517399 -> j1876483110;
	j2796388331 [label="+10 Chemistry",color=orange];
		j2796388331 -> j3046187575;
	j2267663487 [label="Я… не могу решить, делает ли это тебя более или менее ужасающим, Узурпатор. Думаю, остановлюсь на «более». Так или иначе, это кажется мне забавным и по‑своему впечатляющим.",shape=box,color=blue];
		j2267663487 -> j777855750;
	j2049552823 [label="+10 Chemistry",color=orange];
		j2049552823 -> j3155517826;
	j2817474006 [label="+10 Chemistry",color=orange];
		j2817474006 -> j3809403780;
	j4209034612 [label="+10 Chemistry",color=orange];
		j4209034612 -> j1612278768;
	j677665985 [label="+10 Chemistry",color=orange];
		j677665985 -> j3527516406;
	j777855750 [label="Boolean RoatheWeaponImprov is now true.",color=orange];
		j777855750 -> j3053396778;
		j777855750 -> j2520735452;
		j777855750 -> j704493779;
	j2600607584 [label="Прекрасно.",shape=box,color=blue];
		j2600607584 -> j2888608214;
	j1876483110 [label="Какой прекрасный момент.",shape=box,color=blue];
		j1876483110 -> j918012326;
	j3046187575 [label="В этом есть определённая красота.",shape=box,color=blue];
		j3046187575 -> j4290874667;
	j3155517826 [label="Прекрасно.",shape=box,color=blue];
		j3155517826 -> j2888608214;
	j3809403780 [label="В этом есть своя красота.",shape=box,color=blue];
		j3809403780 -> j4290874667;
	j1612278768 [label="Смерть в таких масштабах? В ней есть своя красота.",shape=box,color=blue];
		j1612278768 -> j3609398078;
	j3527516406 [label="Какой прекрасный момент.",shape=box,color=blue];
		j3527516406 -> j918012326;
	j3053396778 [label="Ты преподносишь это так, будто это какой-то... вид искусства.",shape=box,color=red];
		j3053396778 -> j3794318842;
	j2520735452 [label="Мне не нравится убивать людей, Роут. ",shape=box,color=red];
		j2520735452 -> j3283502306;
	j704493779 [label="А какая твоя любимая?",shape=box,color=red];
		j704493779 -> j58667218;
	j2888608214 [label="Boolean RoatheWeaponBow is now true.",color=orange];
		j2888608214 -> j3053396778;
		j2888608214 -> j2520735452;
		j2888608214 -> j704493779;
	j918012326 [label="Boolean RoatheWeaponDagger is now true.",color=orange];
		j918012326 -> j3053396778;
		j918012326 -> j2520735452;
		j918012326 -> j704493779;
	j4290874667 [label="Boolean RoatheWeaponSniper is now true.",color=orange];
		j4290874667 -> j3053396778;
		j4290874667 -> j2520735452;
		j4290874667 -> j704493779;
	j3609398078 [label="Boolean RoatheWeaponPoison is now true.",color=orange];
		j3609398078 -> j3053396778;
		j3609398078 -> j2520735452;
		j3609398078 -> j704493779;
	j3794318842 [label="Потому что так оно и есть. И ты это знаешь. На самом деле, половина твоего существования буквально основана на концепции убийства как искусства!",shape=box,color=blue];
		j3794318842 -> j4235374113;
	j3283502306 [label="О? Правда? Давай на мгновение это обдумаем.",shape=box,color=blue];
		j3283502306 -> j1644535723;
	j58667218 [label="В последнее время ситуация изменилась. И это меня ужасно беспокоит.",shape=box,color=blue];
		j58667218 -> j2377033948;
		j58667218 -> j4002666574;
	j4235374113 [label="Я вижу эти «школы», которыми владеют Тэнно, и которые вы заимствуете через посредников. Не говоря уже об учениях Дакса. Как они бесконечно и нудно твердили в чате, сколько бы раз мы им ни говорили, что это закрытый канал.",shape=box,color=blue];
		j4235374113 -> j2195713083;
	j1644535723 [label="Скажи мне кое-что, и ответь, пожалуйста, честно. Потому что ложь в данный момент вредит нам обоим, но особенно тебе:",shape=box,color=blue];
		j1644535723 -> j3333948661;
	j2377033948 [label="Изменилась, как?",shape=box,color=red];
		j2377033948 -> j3863117196;
	j4002666574 [label="Из-за Уриэль?",shape=box,color=red];
		j4002666574 -> j3859764024;
	j2195713083 [label="Если я больше ни разу не услышу, как один из них твердит: «Я — клинок» и «Я существую, чтобы наносить удар», — умру счастливым, Узурпатор.",shape=box,color=blue];
		j2195713083 -> j597473546;
	j3333948661 [label="Ты когда-нибудь хотел экипировать себя оружием или варфреймом, которые бы соответствовали твоим личным предпочтениям? Возможно, с уникальной покраской или внешним видом, который лучше всего отвечает твоему настроению?",shape=box,color=blue];
		j3333948661 -> j2995083219;
		j3333948661 -> j1944996921;
		j3333948661 -> j1098722835;
	j3863117196 [label="Я предпочитал меч как оружие. Элегантное. Быстрое. Я мог передвигаться по полю и рубить врагов на расстоянии вытянутой руки. Багровый на посеребренном клинке, сверкающий в сиянии синей звезды.",shape=box,color=blue];
		j3863117196 -> j1351995975;
	j3859764024 [label="Полагаю, что да. Или, возможно, из-за отсутствия воспоминаний. Не знаю, какие ещё могут быть причины.",shape=box,color=blue];
		j3859764024 -> j3863117196;
	j597473546 [label="Человечество всегда считало «убийство» грехом, а «убивать» — искусством. Тебе никогда не приходило в голову, что это странно? Владеть клинком и сразить врага в бою — значит восприниматься как почти трансцендентное существо.",shape=box,color=blue];
		j597473546 -> j679454190;
	j2995083219 [label=" У меня есть... а какое это имеет отношение к делу?",shape=box,color=red];
		j2995083219 -> j3916120605;
	j1944996921 [label="Нет. Никогда.",shape=box,color=red];
		j1944996921 -> j3109703876;
	j1098722835 [label="Я не буду играть в эту игру. [Конец.]",shape=box,color=red];
		j1098722835 -> j1893051900;
	j1351995975 [label="Теперь же? Теперь я хочу чувствовать кровь на своих зубах. Чувствовать, как она хлещет под моими когтями. Хочу вонзать пальцы глубоко в плоть и кость и разрывать всё на части.",shape=box,color=blue];
		j1351995975 -> j3099966652;
	j679454190 [label="Убить человека заточенным куском металла в переулке — значит быть трусом и дегенератом. ",shape=box,color=blue];
		j679454190 -> j1589523038;
	j3916120605 [label="Благодарю за откровенность. Теперь я не стану спорить, что тебе, весьма вероятно, не по душе хладнокровное убийство, и избиение невинной жизни не доставляет тебе удовольствия (хотя, возможно, доставляет, и прежнее утверждение, ложь, и как же восхитительно было бы это раскрыть, однако не ради этого мы здесь).",shape=box,color=blue];
		j3916120605 -> j274989854;
	j3109703876 [label="Прошу тебя хорошенько задуматься. Я видел, как твои друзья Тэнно носятся здесь разодетыми, будто разноцветные кошмары из цирка‑арены. Словно дикое животное упало в ёмкость с краской художника. ",shape=box,color=blue];
		j3109703876 -> j1248752064;
	j1893051900 [label="Прекрасно.",shape=box,color=blue];
		j1893051900 -> "Chat ends.";
	j3099966652 [label="Я хочу пить глубоко этот ихор, разрывая сухожилия и чувствуя, как тело подо мной превращается в кровавые осколки. Разламывать его, словно спелый плод, пока сочится костный мозг.",shape=box,color=blue];
		j3099966652 -> j1862392748;
		j3099966652 -> j1102376826;
	j1589523038 [label="В чём разница? «Честь?» Кто решает, что почётно, а что нет? Проигравший? Победитель? Или это просто наличие достаточного количества традиций, которые объявляют, что достойно, а что нет?",shape=box,color=blue];
		j1589523038 -> j2054762805;
		j1589523038 -> j822819601;
		j1589523038 -> j1543848284;
	j274989854 [label="Однако, если предположить что это не так и что ты убиваешь просто потому, что «должен», как ты сказал. Тогда почему, скажи на милость, ты тратишь время на то, чтобы придавать своим орудиям смерти личный, особенный вид?",shape=box,color=blue];
		j274989854 -> j2523847658;
	j1248752064 [label="Ты никогда не чувствовал побуждения сделать то же самое? Ни разу? Клянусь, я не буду думать о тебе хуже, если ты в этом признаешься.",shape=box,color=blue];
		j1248752064 -> j1441398800;
		j1248752064 -> j3722629510;
	j1862392748 [label="Роут?",shape=box,color=red];
		j1862392748 -> j2986102041;
	j1102376826 [label="И это... для тебя ненормально?",shape=box,color=red];
		j1102376826 -> j3939840839;
	j2054762805 [label="Вижу, к чему ты ведёшь. Грань размыта. ",shape=box,color=red];
		j2054762805 -> j3182451276;
	j822819601 [label="Одно требует практики и самоотдачи. Другое — это просто... жестокость.",shape=box,color=red];
		j822819601 -> j2617795897;
	j1543848284 [label="Я не собираюсь вести этот разговор. [Конец.]",shape=box,color=red];
		j1543848284 -> j150314708;
	j2523847658 [label="Зачем беспокоиться о том, как ты будешь выглядеть в глазах других на поле смерти? Уж точно не для того, чтобы опознать твой труп. Тебя нигде не спутаешь. Нет, потому что, если уж ты решил стать убийцей, мой дорогой Узурпатор, я уверен, ты хочешь сделать это со вкусом.",shape=box,color=blue];
		j2523847658 -> j829201060;
	j1441398800 [label="Нет.",shape=box,color=red];
		j1441398800 -> j1893051900;
	j3722629510 [label="Хорошо. Чувствовал. Почему?",shape=box,color=red];
		j3722629510 -> j3916120605;
	j2986102041 [label="Да, я в курсе! Я прекрасно это осознаю. Но, заметь, я ничего из этого делать не собираюсь. И уж тем более не собираюсь сжигать всё это место дотла, хотя мне очень хочется это сделать.",shape=box,color=blue];
		j2986102041 -> j3901861013;
	j3939840839 [label="Нет! Нет, это не так! И для меня ненормально пускать слюни при мысли о том, чтобы сжечь всё это место дотла!",shape=box,color=blue];
		j3939840839 -> j3901861013;
	j3182451276 [label="Все подобные границы проводятся произвольно. И чем скорее мы все это осознаем, тем быстрее сможем прийти к согласию о том, какие битвы действительно стоит важны, а какие нет.",shape=box,color=blue];
		j3182451276 -> j2033673070;
	j2617795897 [label="Хорошо, доведём эту линию рассуждений до конца. Значит, убийство, при достаточной практике, становится почётным? То есть ты хочешь сказать, что если я, подобно Даксу, облеку своё убийство в достаточное количество пышности и церемоний, оно станет искусством?",shape=box,color=blue];
		j2617795897 -> j4121199251;
	j150314708 [label="Очень хорошо.",shape=box,color=blue];
		j150314708 -> "Chat ends.";
	j829201060 [label="А что это такое, если не наслаждение самим деянием, позволь спросить?",shape=box,color=blue];
		j829201060 -> j1276633139;
	j3901861013 [label="Во всём должен быть виноват Уриэль. Признаю, у меня и раньше бывали склонности к подобным разрушительным и кровожадным мыслям, но они и близко не были столь катастрофическими.",shape=box,color=blue];
		j3901861013 -> j1269720395;
	j2033673070 [label="Решать, было ли убийство совершено с честью, всё равно что пытаться определить, что хуже: смерть в огне или смерть в воде. Оба способа смерти ужасны.",shape=box,color=blue];
		j2033673070 -> j1487185124;
	j4121199251 [label="Теперь мы балансируем на грани между ритуалом и религией.",shape=box,color=blue];
		j4121199251 -> j189634384;
	j1276633139 [label="Не пойми меня неправильно! Я не сужу тебя. Ты просто стараешься извлечь лучшее из своего положения. Смерть сделала тебя своим партнёром по танцу в этом великом маскараде жизни, и у тебя нет силы не откликнуться на её зов.",shape=box,color=blue];
		j1276633139 -> j3551213033;
	j1269720395 [label="И уж точно не столь… апокалиптическими.",shape=box,color=blue];
		j1269720395 -> "Chat ends.";
	j1487185124 [label="А раз все дороги всё равно ведут к могиле, то какой смысл придираться к мелочам? У нас есть куда более важные проблемы, которые нужно решать.",shape=box,color=blue];
		j1487185124 -> "Chat ends.";
	j189634384 [label="По крайней мере, в простой и лёгкой смерти от ножа в спину есть честность. В ней нет ничего благочестивого. Ничего показного или избыточного. Всё кончено.",shape=box,color=blue];
		j189634384 -> j776450628;
	j3551213033 [label="Если бы оружие было сложено, сколько ещё погибших лежало бы рядом с тобой, интересно знать? Нет, так почему бы не испытывать хоть немного гордости за своё дело? Немного удовольствия от всего этого искусства? Какова альтернатива, я тебя спрашиваю? Безумие? Забвение?",shape=box,color=blue];
		j3551213033 -> j1635619304;
	j776450628 [label="Разве в этом нет искусства?",shape=box,color=blue];
		j776450628 -> "Chat ends.";
	j1635619304 [label="Слишком много раз мне доводилось видеть тех, кто выбирал этот путь и встречал в конце петлю. Нет. Я говорю: твори, что пожелаешь, Узурпатор. Ибо жизнь уже с избытком сотворила с тобой всё, что ей было угодно.",shape=box,color=blue];
		j1635619304 -> "Chat ends.";
}