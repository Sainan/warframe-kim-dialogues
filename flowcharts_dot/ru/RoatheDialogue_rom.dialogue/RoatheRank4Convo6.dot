digraph {
	2743 [label="RoatheRank4Convo6 begins.",color=orange];
		2743 -> 2744;
	2744 [label="Which is your favorite way to kill, Usurper?",shape=box,color=blue];
		2744 -> 2746;
		2744 -> 2747;
		2744 -> 2745;
	2746 [label="Excuse me?",shape=box,color=red];
		2746 -> 2749;
	2747 [label="Are you asking to find out?",shape=box,color=red];
		2747 -> 2750;
	2745 [label="[End.]",shape=box,color=red];
		2745 -> 2748;
	2749 [label="I find myself waxing philosophical as of late and I am simply curious.",shape=box,color=blue];
		2749 -> 2751;
	2750 [label="Ha! Hardly. Although... going a few rounds with you would be quite fun. No, I find myself waxing philosophical as of late and I am simply curious.",shape=box,color=blue];
		2750 -> 2751;
	2748 [label="Chat ends.",color=orange];
	2751 [label="For numbers, you and I are likely matched I figure. Lethality, mm... I would not want to place a wager, nor am I particularly interested in a proverbial sword-measuring contest.",shape=box,color=blue];
		2751 -> 2752;
	2752 [label="Killer to killer. Which do you prefer? Do you prefer something up close and personal? Do you prefer stealth, or the chaos of the battlefield?",shape=box,color=blue];
		2752 -> 2753;
		2752 -> 2754;
		2752 -> 2755;
		2752 -> 2756;
	2753 [label="I prefer chaos. Explosions. Gunfire. Loud noises. The more the merrier.",shape=box,color=red];
		2753 -> 2757;
	2754 [label="Stealth. I prefer to take out my foe before they even know I'm there. I'd do it where they slept if I could.",shape=box,color=red];
		2754 -> 2758;
	2755 [label="I hate fighting. I wish I never had to do it.",shape=box,color=red];
		2755 -> 2759;
	2756 [label="This is a sick conversation.",shape=box,color=red];
		2756 -> 2760;
	2757 [label="Update boolean RoatheSoldier",color=orange];
		2757 -> 2761;
	2758 [label="Update boolean RoatheAssassin",color=orange];
		2758 -> 2762;
	2759 [label="Oh my poor, poor Usurper, if you could have only just heard me laugh...",shape=box,color=blue];
		2759 -> 2763;
	2760 [label="Then, shoo.",shape=box,color=blue];
		2760 -> 2764;
	2761 [label="A battle-worn soldier like myself. I am unsurprised, given what I know of your record. So much blood follows you wherever you go. First Duviri, then \"Narmer,\" this Höllvania. Now this business.",shape=box,color=blue];
		2761 -> 2765;
	2762 [label="Ah, an assassin amongst us! So very useful yet so very unappreciated. I have always likened assassins to talented butlers.",shape=box,color=blue];
		2762 -> 2766;
	2763 [label="You miserable, destitute creature. I hope for your sake you are lying to me.",shape=box,color=blue];
		2763 -> 2767;
	2764 [label="Chat ends.",color=orange];
	2765 [label="Who knows what else, or since, or what you have forgotten in the meanwhile. Death is your art and you paint the worlds in it.",shape=box,color=blue];
		2765 -> 2768;
	2766 [label="When they do their jobs exceptionally well, they always go unnoticed.",shape=box,color=blue];
		2766 -> 2769;
	2767 [label="+20 Chemistry",color=orange];
		2767 -> 2770;
	2768 [label="So! What is your favorite brush? Let us dig in.",shape=box,color=blue];
		2768 -> 2771;
		2768 -> 2772;
		2768 -> 2773;
		2768 -> 2774;
	2769 [label="So. Dagger? Poison? Bow?",shape=box,color=blue];
		2769 -> 2775;
		2769 -> 2776;
		2769 -> 2777;
		2769 -> 2778;
		2769 -> 2779;
	2770 [label="Otherwise that may be the saddest thing I have ever heard in all my years.",shape=box,color=blue];
		2770 -> 2780;
	2771 [label="I'll make due with whatever I can, honestly. I like to improvise.",shape=box,color=red];
		2771 -> 2781;
	2772 [label="A bow. Graceful and deadly.",shape=box,color=red];
		2772 -> 2782;
	2773 [label="A blade. I like to get up close.",shape=box,color=red];
		2773 -> 2783;
	2774 [label="Rifles and guns. Loud, but they get the job done.",shape=box,color=red];
		2774 -> 2784;
	2775 [label="I'll make due with whatever I can, honestly. I like to improvise.",shape=box,color=red];
		2775 -> 2785;
	2776 [label="Bow. Graceful and silent.",shape=box,color=red];
		2776 -> 2786;
	2777 [label="Sniper rifle. One shot? One kill.",shape=box,color=red];
		2777 -> 2787;
	2778 [label="Poison. I'm gone before they even know they're dead.",shape=box,color=red];
		2778 -> 2788;
	2779 [label="Dagger. I like the intimacy of it.",shape=box,color=red];
		2779 -> 2789;
	2780 [label="Update boolean RoatheWeaponNone",color=orange];
		2780 -> 2790;
	2781 [label="I am sitting here picturing you rampaging through the battlefield with a medic's bench. Tearing through soldiers with tire strapped to a bent piece of pipe.",shape=box,color=blue];
		2781 -> 2791;
	2782 [label="To wield a bow in the heat of battle takes resolve a clarity of mind like few can muster. And, of course, steady hands.",shape=box,color=blue];
		2782 -> 2792;
	2783 [label="Mm, careful. Do not get me too excited, Usurper. How I would love to see you dancing through the battlefield, weapons in hand, sprays of blood like the petals of a flower blooming wide...",shape=box,color=blue];
		2783 -> 2793;
	2784 [label="They have been the workhorse of any war since the moment they were invented for a reason, Usurper. It is, however, difficult to deny that when they reach their intended target, they complete their objective.",shape=box,color=blue];
		2784 -> 2794;
	2785 [label="I am sitting here picturing you assassinating someone with a piece of cutlery or a chair leg. Snuffing out someone's life with the tieback of a curtain.",shape=box,color=blue];
		2785 -> 2795;
	2786 [label="The hunter's way. Unadvanced but elegant in its simplicity. Sometimes the easiest and oldest methods are at their hearts the most effective.",shape=box,color=blue];
		2786 -> 2796;
	2787 [label="A little impersonal and clinical for my tastes, but I cannot judge it for its efficiency. There is something to be said for the calm.",shape=box,color=blue];
		2787 -> 2797;
	2788 [label="The sinister apothecary, hm? Brewing tinctures and tipping vials into the glasses of the unsuspecting? Or lacing one's knives and bullets with venom so that the slightest glancing blow on the field becomes a fatal one?",shape=box,color=blue];
		2788 -> 2798;
	2789 [label="Mm, careful. Do not get me too excited, Usurper. How intriguing, the image of waking up one night with you lurking in the shadows, a dagger poised, ready to strike...",shape=box,color=blue];
		2789 -> 2799;
	2790 [label="Chat ends.",color=orange];
	2791 [label="+10 Chemistry",color=orange];
		2791 -> 2800;
	2792 [label="The silence of it all is to be appreciated. The nocking of an arrow, drawing it taut, the anticipation of release... then sweet, sweet death when it finds its mark?",shape=box,color=blue];
		2792 -> 2801;
	2793 [label="I appreciate the desire for the personal touch. To watch as the limbs of your victim fall away as you end their lives. To see their lifeless forms crumple before you. To know that was you who did it, and no one else.",shape=box,color=blue];
		2793 -> 2802;
	2794 [label="Messy, noisy, extravagantly expensive. But so very, very good at killing.",shape=box,color=blue];
		2794 -> 2803;
	2795 [label="+10 Chemistry",color=orange];
		2795 -> 2804;
	2796 [label="The silence of it all is to be appreciated. The nocking of an arrow, drawing it taut, the anticipation of release... then sweet, sweet death when it finds its mark?",shape=box,color=blue];
		2796 -> 2805;
	2797 [label="In the seeming implacable clamor of the field of war, the sniper must find their breath like the tide of the ocean. Breath in, breath out, and take a life.",shape=box,color=blue];
		2797 -> 2806;
	2798 [label="I have seen whole battalions rendered to sludge from a single cut on a single soldier's arm. A toxin that spread from the blood to the lungs to the lungs of another can destroy countries.",shape=box,color=blue];
		2798 -> 2807;
	2799 [label="I appreciate the desire for the personal touch. To stare into  the eyes of another and watch them go glassy and dim as the light fades and the warmth flees their body.",shape=box,color=blue];
		2799 -> 2808;
	2800 [label="I... cannot decide if this makes you more or less terrifying, Usurper. I think I will settle on more. Either way, I find it amusing and striking in its own right.",shape=box,color=blue];
		2800 -> 2809;
	2801 [label="+10 Chemistry",color=orange];
		2801 -> 2810;
	2802 [label="+10 Chemistry",color=orange];
		2802 -> 2811;
	2803 [label="+10 Chemistry",color=orange];
		2803 -> 2812;
	2804 [label="I... cannot decide if this makes you more or less terrifying, Usurper. I think I will settle on more. Either way, I find it amusing and striking in its own right.",shape=box,color=blue];
		2804 -> 2813;
	2805 [label="+10 Chemistry",color=orange];
		2805 -> 2814;
	2806 [label="+10 Chemistry",color=orange];
		2806 -> 2815;
	2807 [label="+10 Chemistry",color=orange];
		2807 -> 2816;
	2808 [label="+10 Chemistry",color=orange];
		2808 -> 2817;
	2809 [label="Update boolean RoatheWeaponImprov",color=orange];
		2809 -> 2818;
		2809 -> 2819;
		2809 -> 2820;
	2810 [label="Beautiful.",shape=box,color=blue];
		2810 -> 2821;
	2811 [label="What a beautiful moment.",shape=box,color=blue];
		2811 -> 2822;
	2812 [label="There is a certain kind of beauty in it.",shape=box,color=blue];
		2812 -> 2823;
	2813 [label="Update boolean RoatheWeaponImprov",color=orange];
		2813 -> 2818;
		2813 -> 2819;
		2813 -> 2820;
	2814 [label="Beautiful.",shape=box,color=blue];
		2814 -> 2824;
	2815 [label="There is beauty in it.",shape=box,color=blue];
		2815 -> 2825;
	2816 [label="Death at such a scale? There is beauty in it.",shape=box,color=blue];
		2816 -> 2826;
	2817 [label="What a beautiful moment.",shape=box,color=blue];
		2817 -> 2827;
	2818 [label="You're making this sound like it's some kind of... artform.",shape=box,color=red];
		2818 -> 2828;
	2819 [label="I don't like having to kill people, Roathe. ",shape=box,color=red];
		2819 -> 2829;
	2820 [label="And what's your favorite?",shape=box,color=red];
		2820 -> 2830;
	2821 [label="Update boolean RoatheWeaponBow",color=orange];
		2821 -> 2818;
		2821 -> 2819;
		2821 -> 2820;
	2822 [label="Update boolean RoatheWeaponDagger",color=orange];
		2822 -> 2818;
		2822 -> 2819;
		2822 -> 2820;
	2823 [label="Update boolean RoatheWeaponSniper",color=orange];
		2823 -> 2818;
		2823 -> 2819;
		2823 -> 2820;
	2824 [label="Update boolean RoatheWeaponBow",color=orange];
		2824 -> 2818;
		2824 -> 2819;
		2824 -> 2820;
	2825 [label="Update boolean RoatheWeaponSniper",color=orange];
		2825 -> 2818;
		2825 -> 2819;
		2825 -> 2820;
	2826 [label="Update boolean RoatheWeaponPoison",color=orange];
		2826 -> 2818;
		2826 -> 2819;
		2826 -> 2820;
	2827 [label="Update boolean RoatheWeaponDagger",color=orange];
		2827 -> 2818;
		2827 -> 2819;
		2827 -> 2820;
	2828 [label="Because it is. And you know it. In fact, half of your existence is quite literally based on the concept of killing as an artform!",shape=box,color=blue];
		2828 -> 2831;
	2829 [label="Oh? Really? Let us take a moment to examine that.",shape=box,color=blue];
		2829 -> 2832;
	2830 [label="It has changed, recently. And that bothers me to no end.",shape=box,color=blue];
		2830 -> 2833;
		2830 -> 2834;
	2831 [label="I see these \"schools\" the Tenno wield, and that you borrow by proxy. Let alone the teachings of the Dax. How they would drone on and on endlessly on comms, no matter how many times we told them it was a restricted channel.",shape=box,color=blue];
		2831 -> 2835;
	2832 [label="Tell me something, and please answer me honestly. Because lying in this moment does both of us a disservice but particularly yourself:",shape=box,color=blue];
		2832 -> 2836;
	2833 [label="Changed, how?",shape=box,color=red];
		2833 -> 2837;
	2834 [label="Because of Uriel?",shape=box,color=red];
		2834 -> 2838;
	2835 [label="If I never hear one of them tell me that \"I am a blade\" and that \"I exist to strike\" again, I will die happy, Usurper.",shape=box,color=blue];
		2835 -> 2839;
	2836 [label="Have you ever sought to outfit yourself with a weapon or a Warframe that is customized to your own personal tastes? Perhaps with painted uniquely, or a look that you find suits your mood better?",shape=box,color=blue];
		2836 -> 2840;
		2836 -> 2842;
		2836 -> 2841;
	2837 [label="I used to favor the sword as a weapon. Elegant. Fast. I could move through the field and cut through my foes at arm's reach. Crimson upon a silvered blade, flashing in the glow of a blue star.",shape=box,color=blue];
		2837 -> 2843;
	2838 [label="I assume so. Or perhaps because of my missing memories. I do not know what other reasons could be to blame.",shape=box,color=blue];
		2838 -> 2837;
	2839 [label="Humanity has always looked at \"murder\" as a sin, but \"killing\" as an art. Have you never thought of that as odd? To wield a blade and fell an enemy in combat is to be seen as a nigh transcendent being.",shape=box,color=blue];
		2839 -> 2844;
	2840 [label=" I have... what does that have to do with anything?",shape=box,color=red];
		2840 -> 2845;
	2842 [label="No. Never.",shape=box,color=red];
		2842 -> 2847;
	2841 [label="I'm not playing this game. [End.]",shape=box,color=red];
		2841 -> 2846;
	2843 [label="But now? Now I wish to taste the blood on my teeth. Feel it gush underneath my claws. I wish to sink my fingers deep into flesh and bone and rip it to pieces.",shape=box,color=blue];
		2843 -> 2848;
	2844 [label="To kill a man with a sharpened piece of metal in an alley is to be a coward and a degenerate. ",shape=box,color=blue];
		2844 -> 2849;
	2845 [label="I appreciate your honesty. Now, I will not argue that you very likely do not enjoy murder in cold blood, and the slaughter of an innocent life is not something you take delight in (although perhaps you do and your previous statement was a lie, and how delectable would that be to reveal, however that is not what we are here to discuss).",shape=box,color=blue];
		2845 -> 2850;
	2847 [label="I will ask you take a long hard moment to think. I have seen your Tenno friends rampaging around this place befitted like multi-colored arena-circus nightmares. Like a feral animal had fallen into an artist's pigment pots. ",shape=box,color=blue];
		2847 -> 2852;
	2846 [label="Very well.",shape=box,color=blue];
		2846 -> 2851;
	2848 [label="I want to drink deep the ichor as I snap sinew and feel the body rend beneath me into nothing more than sanguineous shrapnel. Peel it apart like sweet fruit as the marrow flows.",shape=box,color=blue];
		2848 -> 2853;
		2848 -> 2854;
	2849 [label="What is the difference? \"Honor?\" Who decides what is honorable and what is not? The loser? Or the winner? Or is it simply the existence of enough tradition that declares what is honorable and what is not?",shape=box,color=blue];
		2849 -> 2857;
		2849 -> 2855;
		2849 -> 2856;
	2850 [label="Assuming however that is not the case, and you are simply killing because \"you have to\" as you said, then why, pray tell, would you spend time outfitting your weapons of death in a personalized fashion?",shape=box,color=blue];
		2850 -> 2858;
	2852 [label="You have never felt compelled to do the same? Not once? I swear to you that I will not think less of you for admitting so.",shape=box,color=blue];
		2852 -> 2859;
		2852 -> 2860;
	2851 [label="Chat ends.",color=orange];
	2853 [label="Roathe?",shape=box,color=red];
		2853 -> 2861;
	2854 [label="And that's... not normal for you?",shape=box,color=red];
		2854 -> 2862;
	2857 [label="I see your point. The line is blurry. ",shape=box,color=red];
		2857 -> 2865;
	2855 [label="One requires practice and dedication. The other is just... brutality.",shape=box,color=red];
		2855 -> 2863;
	2856 [label="I'm not having this conversation. [End.]",shape=box,color=red];
		2856 -> 2864;
	2858 [label="Why care for how you might appear to others on the field of death? Certainly not so that others might identify your corpse. There is no mistaking you anywhere. No, because if you must be a killer, my dear Usurper, I wager you wish to do it in style.",shape=box,color=blue];
		2858 -> 2866;
	2859 [label="No.",shape=box,color=red];
		2859 -> 2846;
	2860 [label="Fine. I have. Why?",shape=box,color=red];
		2860 -> 2845;
	2861 [label="Yes, I am aware! I am aware. I am not going to do any of these things, mind you. Neither am I going to burn this whole place down around me, which I salivate to do.",shape=box,color=blue];
		2861 -> 2867;
	2862 [label="No! No it is not! Nor is it normal for me to salivate at the idea of burning this whole place to the ground around me!",shape=box,color=blue];
		2862 -> 2867;
	2865 [label="All such lines are arbitrarily drawn. And the sooner we all come to understand that, the faster we can come to agreement on which battles are the important ones to fight and which ones are not.",shape=box,color=blue];
		2865 -> 2870;
	2863 [label="Very well, let us follow that line of reasoning to its end. Killing with enough practice makes it honorable? So, you are saying, if I am like the Dax, and I simply couch my murder in enough pomp and circumstance, it makes it Art?",shape=box,color=blue];
		2863 -> 2868;
	2864 [label="Very well.",shape=box,color=blue];
		2864 -> 2869;
	2866 [label="And what is that, if not enjoyment of the deed, I ask?",shape=box,color=blue];
		2866 -> 2871;
	2867 [label="Uriel must be to blame. While I admit I had leanings of such destructive and bloodthirsty thoughts before, they were not nearly so catastrophic.",shape=box,color=blue];
		2867 -> 2872;
	2870 [label="Deciding if a killing was done honorably is like trying to decide which is worse, death by fire or death by drowning. Both are miserable ways to die.",shape=box,color=blue];
		2870 -> 2874;
	2868 [label="Now we are toeing the line into ritual and religion.",shape=box,color=blue];
		2868 -> 2873;
	2869 [label="Chat ends.",color=orange];
	2871 [label="Do not get me wrong! I am not judging you. You are making the best of your situation! Death has made you her dance partner in this great charade of life, and you are helpless but to heed her call.",shape=box,color=blue];
		2871 -> 2875;
	2872 [label="And certainly not so... apocalyptic.",shape=box,color=blue];
		2872 -> 2876;
	2874 [label="And all roads lead to the grave, so what is the point in nitpicking? We have far more important problems to solve.",shape=box,color=blue];
		2874 -> 2878;
	2873 [label="At least there is honesty in the simple, easy death of a knife in the back. There is nothing pious about it. Nothing ostentatious or overburdened. It is done.",shape=box,color=blue];
		2873 -> 2877;
	2875 [label="Would you have laid down your weapons, how many more would be dead beside you, I wonder? No, why not take a little pride in your work? A little pleasure in the art of it all? What is the alternative, I ask you? Madness? Oblivion?",shape=box,color=blue];
		2875 -> 2879;
	2876 [label="Chat ends.",color=orange];
	2878 [label="Chat ends.",color=orange];
	2877 [label="Is there not art in that?",shape=box,color=blue];
		2877 -> 2880;
	2879 [label="I have seen too many go that way and found the end of a noose waiting for them. No. I say, do what thou wilt, Usurper. For life has certainty done what it wilt unto you.",shape=box,color=blue];
		2879 -> 2881;
	2880 [label="Chat ends.",color=orange];
	2881 [label="Chat ends.",color=orange];
}