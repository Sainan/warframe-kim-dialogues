digraph {
	472 [label="RoatheRank1Convo4 begins.",color=orange];
		472 -> 473;
	473 [label="Check boolean LoidFamilyComplete",color=orange];
		473 -> 474 [label=true,color=green];
		473 -> 475 [label=false,color=brown];
	474 [label="Почти трагично, во что превратились Эйлерия и Петрос. Мы никогда не были друзьями, разумеется. Но они всё же были Орокин. А теперь нас осталось очень мало. Хотя, пожалуй, мне стоит быть осторожнее в словах – кто знает, во что я могу деградировать со временем.",shape=box,color=blue];
		474 -> 476;
	475 [label="Мне кажется совершенно нелепым, что Эйлерия и Петрос абсолютно не догадываются, что мы здесь внизу. Словно крысы, шныряющие у них под ногами. Как вам и детям удавалось так долго хранить это в тайне?",shape=box,color=blue];
		475 -> 477;
	476 [label="Больше всего меня не удивляет, что выжила «Бабушка». (Представляете, дать такое прекрасное имя, как Дагас!)",shape=box,color=blue];
		476 -> 478;
		476 -> 479;
	477 [label="Evaluate expressions on HellStory",color=orange];
		477 -> 481 [label="x >= 21",color=purple];
		477 -> 480 [label="x < 21",color=purple];
		477 -> 480 [label="false",color=purple];
	478 [label="Петрос?",shape=box,color=red];
		478 -> 482;
	479 [label="Что ты думаешь о детях?",shape=box,color=red];
		479 -> 483;
	481 [label="Честно говоря, я гораздо больше удивлён тем, что «Бабушка» не смогла этого понять. Представляешь, отказаться от такого хорошего имени, как Дагас! Я думал, у неё больше ума.",shape=box,color=blue];
		481 -> 486;
	480 [label="Честно говоря, меня куда больше удивляет, что Бабушка не смогла догадаться. Представляшь, отказаться от такого прекрасного имени, как Дагас! Я думал, у неё больше сообразительности.",shape=box,color=blue];
		480 -> 484;
		480 -> 485;
	482 [label="Хм? Ах. Некралойд сообщил мне, что ты или дитя носились тут, помогая ему придумывать себе вымышленные имена, позабыв настоящие. Ты знаешь его как «Вилкор».",shape=box,color=blue];
		482 -> 487;
	483 [label="Мальчик капризный, раздражительный и самовлюблённый. Идеальный Орокин. «Кейли», как она теперь предпочитает, чтобы её называли, я нахожу удивительно умной и почти заслуживающей того, чтобы терпеть её присутствие.",shape=box,color=blue];
		483 -> 488;
	486 [label="Это нелепо. Я знаю, мы уже всё это проходили. И мы об этом уже говорили. Что по-прежнему вызывает у меня глубокую тревогу.",shape=box,color=blue];
		486 -> 491;
	484 [label="У них свои... заботы, на которых надо сосредоточиться.",shape=box,color=red];
		484 -> 489;
	485 [label="Петрос?",shape=box,color=red];
		485 -> 490;
	487 [label="Но я знал его как Петроса Вортена, гордого изобретателя флота Некрамехов. Странно думать о том, сколько времени прошло для него и как мало – по сравнению с этим – для меня.",shape=box,color=blue];
		487 -> 488;
	488 [label="Но как ты можешь этого не знать? Ты что, издеваешься надо мной, Узурпатор? Неужели мы просто возвращаемся к старым спорам, так сказать?",shape=box,color=blue];
		488 -> 492;
	491 [label="Evaluate expressions",color=orange];
		491 -> 498 [label="RoatheDatingDeal",color=purple];
		491 -> 498 [label="RoatheMarieDatingDeal",color=purple];
		491 -> 498 [label="RoatheLyonDatingDeal",color=purple];
		491 -> 498 [label="RoatheSerumDeal",color=purple];
		491 -> 497 [label="RoatheFamilyDeal",color=purple];
		491 -> 498 [label="RoatheMarieEntratiDeal",color=purple];
		491 -> 498 [label="RoatheLyonConfessionDeal",color=purple];
		491 -> 499 [label="false",color=purple];
	489 [label="Check /Lotus/Scripts/1999/DialogueScriptNodes.lua:IsSyndicateRank",color=orange];
		489 -> 494 [label=true,color=green];
		489 -> 493 [label=false,color=brown];
	490 [label="Check /Lotus/Scripts/1999/DialogueScriptNodes.lua:IsSyndicateRank",color=orange];
		490 -> 496 [label=true,color=green];
		490 -> 495 [label=false,color=brown];
	492 [label="Update boolean RoatheKnowsReset",color=orange];
		492 -> 500;
		492 -> 501;
		492 -> 502;
	498 [label="Я здесь, и готов погрузиться в сумрачные и пространные рассуждения об обществе Орокин, полагая, что это может быть хоть немного интересно тебе. Но потом я вспоминаю, что не ради этого ты здесь, не так ли, Скиталец? У тебя есть другая игра…",shape=box,color=blue];
		498 -> 506;
	497 [label="Я здесь, готов погрузиться в сумрачные и пространные размышления об обществе Орокин, полагая, что это может быть тебе хоть немного интересно. Но потом я вспоминаю: тебе, вероятно, уже всё это приходилось слышать, не так ли?",shape=box,color=blue];
		497 -> 505;
	499 [label="Тебе было бы приятнее, чтобы я просто притворился, что ничего не замечаю? Или… есть ли у тебя какая-то конкретная цель, к которой ты стремишься, затевая всё это? Я совершенно не понимаю, чего надеешься добиться этой жестокой игрой.",shape=box,color=blue];
		499 -> 507;
	494 [label="Да, я слышал это от некралойда. Хотя, кажется, их стало меньше с тех пор, как ты или ребёнок покончили с этой проблемой. По крайней мере, они больше не разрывают себя на части – в буквальном смысле.",shape=box,color=blue];
		494 -> 504;
	493 [label="Да, я слышал это от некралойда. Похоже, они по-прежнему полны решимости разорвать себя на части.",shape=box,color=blue];
		493 -> 503;
	496 [label="Хм? Ах. Некралойд сообщил мне, что ты или дитя носились тут, помогая ему придумывать себе вымышленные имена, позабыв настоящие. Ты знаешь его как «Вилкор». А я знал его как Петроса Вортена. Гордого изобретателя Флота Некрамехов.",shape=box,color=blue];
		496 -> 504;
	495 [label="Хм? Ах. Я знал его как Петроса Вортена. Гордый изобретатель Флота Некрамехов. Но некралойд сообщил мне, что они забыли свои имена. Возможно, тебе он известен как «Отец».",shape=box,color=blue];
		495 -> 503;
	500 [label="Нет, мне этого не приходилось слышать раньше. Пожалуйста, продолжай.",shape=box,color=red];
		500 -> 508;
	501 [label="Я говорю с тобой, Роут, потому что хочу с тобой говорить.",shape=box,color=red];
		501 -> 509;
	502 [label="Я это уже слышал, да. Но, пожалуйста, расскажи мне ещё раз.",shape=box,color=red];
		502 -> 510;
	506 [label="Update boolean RoatheKnowsReset",color=orange];
		506 -> 500;
		506 -> 501;
		506 -> 502;
	505 [label="Update boolean RoatheKnowsReset",color=orange];
		505 -> 500;
		505 -> 501;
		505 -> 502;
	507 [label="Update boolean RoatheKnowsReset",color=orange];
		507 -> 515;
	504 [label="Evaluate expressions",color=orange];
		504 -> 514 [label="RoatheDeal",color=purple];
		504 -> 513 [label="RoatheNoDeal",color=purple];
		504 -> 513 [label="false",color=purple];
	503 [label="Evaluate expressions",color=orange];
		503 -> 512 [label="RoatheDeal",color=purple];
		503 -> 511 [label="RoatheNoDeal",color=purple];
		503 -> 511 [label="false",color=purple];
	508 [label="+5 Chemistry",color=orange];
		508 -> 516;
	509 [label="Check boolean DrifterRoathe",color=orange];
		509 -> 517 [label=true,color=green];
		509 -> 518 [label=false,color=brown];
	510 [label="Итак, ты признаёшь, что тратишь моё время. Превосходно! Я не дряхлый старик, пересказывающий единственную известную ему историю, потому что других он и не помнит.",shape=box,color=blue];
		510 -> 519;
	515 [label="Я здесь, готов погрузиться в сумрачные и пространные размышления об обществе Орокин, полагая, что это может быть тебе хоть немного интересно. Но потом я вспоминаю: тебе, вероятно, уже всё это приходилось слышать, не так ли?",shape=box,color=blue];
		515 -> 500;
		515 -> 501;
		515 -> 502;
	514 [label="Это хорошо, ведь без тебя и ребёнка мы бы вряд ли продвинулись дальше. Боюсь, что иначе слуга был бы обречён, едва мы отправили бы его по этой лестнице.",shape=box,color=blue];
		514 -> 522;
	513 [label="Кстати, у тебя было время пересмотреть моё предложение? Я сижу здесь тихо, в обмен на помощь в примирении дворецкого и тех заброшенных, заражённых Орокин, что наверху?",shape=box,color=blue];
		513 -> 520;
		513 -> 521;
	512 [label="И тебе, возможно, стоит сначала поработать над решением этой проблемы, прежде чем мы попытаемся отправить дворецкого наверх. Иначе он превратится в фарш.",shape=box,color=blue];
		512 -> 522;
	511 [label="Кстати, у тебя было время пересмотреть моё предложение? Я сижу здесь тихо, в обмен на помощь в примирении дворецкого и тех заброшенных, заражённых Орокин, что наверху? Примирение семьи было бы первым шагом, но…",shape=box,color=blue];
		511 -> 520;
		511 -> 521;
	516 [label="Ты просишь Орокин заговорить. Ты не знаешь, что творишь. Если не проявить осторожности, застрянешь здесь на час.",shape=box,color=blue];
		516 -> 523;
	517 [label="+5 Chemistry",color=orange];
		517 -> 524;
	518 [label="О, и позволь поинтересоваться, почему же это?",shape=box,color=blue];
		518 -> 528;
		518 -> 527;
		518 -> 525;
		518 -> 526;
	519 [label="Причина, по которой я не могу вспомнить этот разговор, заключена в твоём проклятом зеркале!",shape=box,color=blue];
		519 -> 529;
	522 [label="Тебе надо понимать вот что: несмотря на всю отстранённость, дворецкий и семья Энтрати все ещё потомки Орокин. Они родились и выросли в этом обществе, со всеми его… многочисленными недостатками.",shape=box,color=blue];
		522 -> 532;
	520 [label="Нет, я не собираюсь менять своего решения, Роут. Это не так уж и важно.",shape=box,color=red];
		520 -> 530;
	521 [label="Да. Я... соглашаюсь.",shape=box,color=red];
		521 -> 531;
	523 [label="Хотя, полагаю, у тебя не было особого случая пообщаться с Орокин, не так ли, Скиталец? Этот ребёнок жил совсем другой жизнью.",shape=box,color=blue];
		523 -> 533;
	524 [label="Мгм. Именно так. И мы оба знаем, почему, не так ли? Но тебе придётся набраться терпения.",shape=box,color=blue];
		524 -> 534;
	528 [label="[Признаться в чувствах.] Думаю, ты знаешь.",shape=box,color=red];
		528 -> 538;
	527 [label="Ты вызываешь у меня интерес.",shape=box,color=red];
		527 -> 537;
	525 [label="У меня нечасто случалось общаться с Орокин. Когда... когда я с ними не сражался. Ты поразителен.",shape=box,color=red];
		525 -> 535;
	526 [label="Неважно. [Завершить]",shape=box,color=red];
		526 -> 536;
	529 [label="Chat ends.",color=orange];
	532 [label="И несмотря на все тяжкие грехи, порядок и иерархия никогда не подвергались сомнению. Ни в армии, ни в общественной структуре. Архимедиан повиновались Орокин. Орокин повиновались Исполнителям. Исполнители – Императорам… по крайней мере, формально.",shape=box,color=blue];
		532 -> 541;
	530 [label="Делай, как знаешь. Дверь не будет открыта долго.",shape=box,color=blue];
		530 -> 539;
	531 [label="Update boolean RoatheNoDeal",color=orange];
		531 -> 540;
	533 [label="Судя по слухам, ты отклонился от курса в момент трагедии Заримана 10-0.",shape=box,color=blue];
		533 -> 542;
		533 -> 543;
		533 -> 544;
	534 [label="Между тем, если ты желаешь послушать, я буду рад исполнить твою просьбу. Просто предупреждаю: ты попросил заговорить одного из Орокин.",shape=box,color=blue];
		534 -> 545;
	538 [label="+5 Chemistry",color=orange];
		538 -> 549;
	537 [label="+5 Chemistry",color=orange];
		537 -> 548;
	535 [label="Знай своего врага, не так ли? Или, может быть, просто любопытство — сидеть за столом с невозможностью? ",shape=box,color=blue];
		535 -> 546;
	536 [label="Извивайся сколько угодно, рыбка. Ты здесь по своей воле.",shape=box,color=blue];
		536 -> 547;
	541 [label="И даже если ты не веришь, что каким-то образом, даже спустя столько времени, традиции могут вдохновить Лойда прислушаться ко мне? Подумай о том, что я могу быть... невероятно убедительным. В конце концов, я был правой рукой худшего из Исполнителей.",shape=box,color=blue];
		541 -> 551;
		541 -> 552;
		541 -> 553;
	539 [label="Chat ends.",color=orange];
	540 [label="Update boolean RoatheDeal",color=orange];
		540 -> 550;
	542 [label="Нет, до Заримана я почти не имел дела с Орокин, а после… думаю, ты уже слышал суть истории.",shape=box,color=red];
		542 -> 554;
	543 [label="Я достаточно имел дела с Орокин, чтобы не доверять им даже на секунду.",shape=box,color=red];
		543 -> 555;
	544 [label="Боюсь, к людям твоего склада у меня нет больше никакой любви, как у ребёнка.",shape=box,color=red];
		544 -> 555;
	545 [label="Ты не знаешь, что творишь. Если не проявить осторожности, застрянешь здесь на час.",shape=box,color=blue];
		545 -> 523;
	549 [label="Ммм, да. А я уж думал, ты окажешь мне честь и покажешьэто письменно. Ну что ж...",shape=box,color=blue];
		549 -> 557;
	548 [label="А ты? Хм. Посмотрим, как долго я смогу удерживать эту рыбу на копье.",shape=box,color=blue];
		548 -> 534;
	546 [label="+5 Chemistry",color=orange];
		546 -> 556;
	547 [label="Chat ends.",color=orange];
	551 [label="Худшим из исполнителей был Баллас.",shape=box,color=red];
		551 -> 559;
	552 [label="Кому ты служил?",shape=box,color=red];
		552 -> 560;
	553 [label="How so?",shape=box,color=red];
		553 -> 561;
	550 [label="+5 Chemistry",color=orange];
		550 -> 558;
	554 [label="Действительно. Ах, Баллас. Возможно, тебя  удивит, но он был не самым худшим из них.",shape=box,color=blue];
		554 -> 562;
		554 -> 563;
	555 [label="И я не подозреваю, что виню тебя. Я думал, их можно спасти. Переплавить, так сказать, переплавить, переплавить, как золото.",shape=box,color=blue];
		555 -> 564;
	557 [label="В другой раз, возможно. А ты, Узурпатор, должен научиться ценить эти моменты.",shape=box,color=blue];
		557 -> 566;
	556 [label="Уважаемый. Даже мудрый. Если бы у меня была возможность взять интервью и, возможно, даже подружиться с Владеющими Разумом? Я бы сделал то же самое. ",shape=box,color=blue];
		556 -> 565;
	559 [label="Я уважаю твоё мнение и не осуждаю тебя за него. Баллас был кретином, но он был лидером среди развратников, и я не буду с тобой спорить по этому поводу.",shape=box,color=blue];
		559 -> 567;
	560 [label="Evaluate expressions on HellStory",color=orange];
		560 -> 569 [label="x >= 1",color=purple];
		560 -> 568 [label="x <= 1",color=purple];
		560 -> 568 [label="false",color=purple];
	561 [label="Я знаю, что у тебя были личные счёты с Балласом, и я не виню тебя за то, что ты, вероятно, считаешь его худшим из всех, кого могли предложить Семь Золотых Лордов. И он был чемпионом среди развратников, в этом я не буду с вами спорить.",shape=box,color=blue];
		561 -> 570;
	558 [label="Замечательно! Рад, к тебе пришло понимание. Теперь мы можем наконец-то добиться прогресса.",shape=box,color=blue];
		558 -> 522;
	562 [label="Серьёзно?",shape=box,color=red];
		562 -> 571;
	563 [label="Тебе будет трудно заставить меня поверить в это.",shape=box,color=red];
		563 -> 571;
	564 [label="Что ж. Спасите Исполнителей. Дело было безнадёжным. Возможно, тебя удивит, но Баллас был не самым плохим из них.",shape=box,color=blue];
		564 -> 563;
		564 -> 562;
	566 [label="Update boolean DrifterRoathe",color=orange];
		566 -> 534;
	565 [label="Это даёт психологическое преимущество, если тебе когда-либо придётся встретить одного из них – или даже бывшего союзника – на поле боя.",shape=box,color=blue];
		565 -> 572;
	567 [label="И на самом деле я не был свидетелем ужасов этой истории с «Нармером», о которой узнал от дворецкого и которую выудил из записей этой машины, POM-2.",shape=box,color=blue];
		567 -> 573;
	569 [label="Ты знаешь, как я упоминал о ней. И, что важнее, тебе намекали на наши планы. Но это история для другого раза. Исполнитель Ниток. Точнее, Верховный Регент Исполнитель Ниток, командующий всеми нашими вооружёнными силами и самый жестокий и смертоносный из Семи Золотых Властелинов.",shape=box,color=blue];
		569 -> 574;
	568 [label="Исполнитель Ниток. Точнее, Верховный Регент Исполнитель Ниток. Командующий всеми военными силами Империи Орокин. И самый жестокий и смертоносный из Семи Золотых Властелинов.",shape=box,color=blue];
		568 -> 574;
	570 [label="Вполне возможно, что он опередил старых Исполнителей в этом… деле с «Нармером», о котором я слышал от дворецкого и читал в этом POM-2.",shape=box,color=blue];
		570 -> 573;
	571 [label="Я не утверждаю, что он был святым. Я лишь говорю, что даже самые отъявленные дьяволы уступали ему в злодействе. Разница едва уловима, Узурпатор.",shape=box,color=blue];
		571 -> 575;
	572 [label="Что ж, если ты желаешь послушать, я буду рад исполнить твою просьбу. Но предупреждаю сразу: ты попросил заговорить Орокин.",shape=box,color=blue];
		572 -> 545;
	573 [label="Впрочем, полагаю, что это впечатление вызвано твоей личной близостью к Балласу и крайне ограниченным общением с остальными шестью Золотыми Властелинами.",shape=box,color=blue];
		573 -> 574;
	574 [label="Золотая семёрка. Пф. Знаешь ли ты, Скиталец, что самое лучшее в золоте? Его можно бесконечно переплавлять и перековывать во что-то более совершенное.",shape=box,color=blue];
		574 -> 576;
	575 [label="Был ли Баллас самым худшим? Для тебя, возможно. И, возможно, его преступления в эту эпоху превзошли злодеяния старых Исполнителей.",shape=box,color=blue];
		575 -> 577;
	576 [label="Я верил — и во многом верю до сих пор, — что Орокин можно было спасти. Что мы могли бы повернуть Империю к лучшему. Но Исполнители? Нет. Их нужно было остановить. Они были всем худшим, на что способно человечество, и даже хуже.",shape=box,color=blue];
		576 -> 578;
	577 [label="Но если ты посмотришь на озера багряного цвета и поля сломленных, исковерканных тел, словно на множество выброшенных детских игрушек…",shape=box,color=blue];
		577 -> 579;
	578 [label="И это говорю я, Узурпатор. Так позвольте же мне, самому Дьяволу Тау, заверить тебя – как ценителю, – Баллас был не самым худшим из них.",shape=box,color=blue];
		578 -> 580;
	579 [label="Если бы ты видел ту чистую разруху, которую Ниток мог обрушить, даже не успев толком подумать…",shape=box,color=blue];
		579 -> 581;
	580 [label="Check boolean RoatheUsurper",color=orange];
		580 -> 583 [label=true,color=green];
		580 -> 584 [label=true,color=green];
		580 -> 582 [label=false,color=brown];
		580 -> 583 [label=false,color=brown];
		580 -> 584 [label=false,color=brown];
	581 [label="Однако такие ужасы трудно ощутить, не став их свидетелем. Такую трагедию нельзя понять, оперируя цифрами. Я мог бы долго рассказывать о том, что видел, но для тебя это останутся лишь истории.",shape=box,color=blue];
		581 -> 585;
	583 [label="Тебе будет трудно заставить меня поверить в это.",shape=box,color=red];
		583 -> 587;
	584 [label="Серьёзно?",shape=box,color=red];
		584 -> 587;
	582 [label="Почему ты всё время называешь меня Узурпатором?",shape=box,color=red];
		582 -> 586;
	585 [label="Для тебя Баллас всегда будет гораздо более ощутимым и ужасающим злодеем. И это неудивительно.",shape=box,color=blue];
		585 -> 588;
	587 [label="Но если ты посмотришь на озера багряного цвета и поля сломленных, исковерканных тел, словно на множество выброшенных детских игрушек…",shape=box,color=blue];
		587 -> 579;
	586 [label="Ах, вот что ты такое, да? Тэнно отняли Изначальную систему у Орокин. А ты, словно птенец кукушки в чужом гнезде, влезаешь в этот мир из своего.",shape=box,color=blue];
		586 -> 589;
	588 [label="Но в нем есть многое, чего ты не знаешь. О том кретине уже сказано слишком много. И, боюсь, ещё больше предстоит сказать.",shape=box,color=blue];
		588 -> 590;
		588 -> 591;
	589 [label="И это делает тебя, как минимум по двум причинам, узурпатором в моих глазах. (И, возможно, по третьей, если верить тому, что рассказал мне дворецкий о Дувири, но это спор на другой раз.)",shape=box,color=blue];
		589 -> 592;
	590 [label="Во что, например?",shape=box,color=red];
		590 -> 593;
	591 [label="Мне неинтересно слушать о жизни Балласа.",shape=box,color=red];
		591 -> 594;
	592 [label="Не отвлекай меня, Узурпатор. Понимаю, тебе может быть трудно поверить, но если бы тебе пришлось увидеть озера багряные и поля изогнутых, исковерканных трупов, словно брошенные детские игрушки…",shape=box,color=blue];
		592 -> 595;
	593 [label="Update boolean RoatheBallas1",color=orange];
		593 -> 596;
	594 [label="Мм, да. Ну, думаю, вместо этого тебе придётся просто выслушивать истории из моей жизни. Забавно.",shape=box,color=blue];
		594 -> 597;
	595 [label="Update boolean RoatheUsurper",color=orange];
		595 -> 579;
	596 [label="Это… очень долгая история. У меня сейчас нет на неё времени. Дворецкий маячит на горизонте. А я терпеть не могу, когда меня настигают.",shape=box,color=blue];
		596 -> 598;
	597 [label="+5 Chemistry",color=orange];
		597 -> 599;
	598 [label="Ужасно грубо.",shape=box,color=blue];
		598 -> 600;
	599 [label="Скоро мы снова поговорим.",shape=box,color=blue];
		599 -> 601;
	600 [label="+15 Chemistry",color=orange];
		600 -> 602;
	601 [label="Chat ends.",color=orange];
	602 [label="Скоро мы снова поговорим.",shape=box,color=blue];
		602 -> 603;
	603 [label="Chat ends.",color=orange];
}