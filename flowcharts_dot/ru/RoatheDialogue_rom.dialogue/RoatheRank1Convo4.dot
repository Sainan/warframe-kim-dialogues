digraph {
	"RoatheRank1Convo4 begins." [color=orange];
		"RoatheRank1Convo4 begins." -> j86368880;
	j86368880 [label="Check boolean LoidFamilyComplete",color=orange];
		j86368880 -> j499439739 [label=true,color=green];
		j86368880 -> j496065385 [label=false,color=brown];
	j499439739 [label="Почти трагично, во что превратились Эйлерия и Петрос. Мы никогда не были друзьями, разумеется. Но они всё же были Орокин. А теперь нас осталось очень мало. Хотя, пожалуй, мне стоит быть осторожнее в словах – кто знает, во что я могу деградировать со временем.",shape=box,color=blue];
		j499439739 -> j517474851;
	j496065385 [label="Мне кажется совершенно нелепым, что Эйлерия и Петрос абсолютно не догадываются, что мы здесь внизу. Словно крысы, шныряющие у них под ногами. Как вам и детям удавалось так долго хранить это в тайне?",shape=box,color=blue];
		j496065385 -> j348115237;
	j517474851 [label="Больше всего меня не удивляет, что выжила «Бабушка». (Представляете, дать такое прекрасное имя, как Дагас!)",shape=box,color=blue];
		j517474851 -> j4286621779;
		j517474851 -> j4245165223;
	j348115237 [label="Evaluate expressions on HellStory counter",color=orange];
		j348115237 -> j517976782 [label="x >= 21",color=purple];
		j348115237 -> j2184210344 [label="x < 21",color=purple];
		j348115237 -> j2184210344 [label="false",color=purple];
	j4286621779 [label="Петрос?",shape=box,color=red];
		j4286621779 -> j2581268152;
	j4245165223 [label="Что ты думаешь о детях?",shape=box,color=red];
		j4245165223 -> j2429044129;
	j517976782 [label="Честно говоря, я гораздо больше удивлён тем, что «Бабушка» не смогла этого понять. Представляешь, отказаться от такого хорошего имени, как Дагас! Я думал, у неё больше ума.",shape=box,color=blue];
		j517976782 -> j1112771655;
	j2184210344 [label="Честно говоря, меня куда больше удивляет, что Бабушка не смогла догадаться. Представляшь, отказаться от такого прекрасного имени, как Дагас! Я думал, у неё больше сообразительности.",shape=box,color=blue];
		j2184210344 -> j2607562282;
		j2184210344 -> j4053059598;
	j2581268152 [label="Хм? Ах. Некралойд сообщил мне, что ты или дитя носились тут, помогая ему придумывать себе вымышленные имена, позабыв настоящие. Ты знаешь его как «Вилкор».",shape=box,color=blue];
		j2581268152 -> j2926926423;
	j2429044129 [label="Мальчик капризный, раздражительный и самовлюблённый. Идеальный Орокин. «Кейли», как она теперь предпочитает, чтобы её называли, я нахожу удивительно умной и почти заслуживающей того, чтобы терпеть её присутствие.",shape=box,color=blue];
		j2429044129 -> j892064006;
	j1112771655 [label="Это нелепо. Я знаю, мы уже всё это проходили. И мы об этом уже говорили. Что по-прежнему вызывает у меня глубокую тревогу.",shape=box,color=blue];
		j1112771655 -> j2782860910;
	j2607562282 [label="У них свои... заботы, на которых надо сосредоточиться.",shape=box,color=red];
		j2607562282 -> j3658285805;
	j4053059598 [label="Петрос?",shape=box,color=red];
		j4053059598 -> j922668640;
	j2926926423 [label="Но я знал его как Петроса Вортена, гордого изобретателя флота Некрамехов. Странно думать о том, сколько времени прошло для него и как мало – по сравнению с этим – для меня.",shape=box,color=blue];
		j2926926423 -> j892064006;
	j892064006 [label="Но как ты можешь этого не знать? Ты что, издеваешься надо мной, Узурпатор? Неужели мы просто возвращаемся к старым спорам, так сказать?",shape=box,color=blue];
		j892064006 -> j139011919;
	j2782860910 [label="Evaluate expressions",color=orange];
		j2782860910 -> j4079497849 [label="RoatheDatingDeal",color=purple];
		j2782860910 -> j4079497849 [label="RoatheMarieDatingDeal",color=purple];
		j2782860910 -> j4079497849 [label="RoatheLyonDatingDeal",color=purple];
		j2782860910 -> j4079497849 [label="RoatheSerumDeal",color=purple];
		j2782860910 -> j1837065297 [label="RoatheFamilyDeal",color=purple];
		j2782860910 -> j4079497849 [label="RoatheMarieEntratiDeal",color=purple];
		j2782860910 -> j4079497849 [label="RoatheLyonConfessionDeal",color=purple];
		j2782860910 -> j1117502524 [label="false",color=purple];
	j3658285805 [label="Check /Lotus/Scripts/1999/DialogueScriptNodes.lua:IsSyndicateRank",color=orange];
		j3658285805 -> j3012805151 [label=true,color=green];
		j3658285805 -> j2955973731 [label=false,color=brown];
	j922668640 [label="Check /Lotus/Scripts/1999/DialogueScriptNodes.lua:IsSyndicateRank",color=orange];
		j922668640 -> j2225075810 [label=true,color=green];
		j922668640 -> j4023550101 [label=false,color=brown];
	j139011919 [label="Boolean RoatheKnowsReset is now true.",color=orange];
		j139011919 -> j3037445792;
		j139011919 -> j1274281585;
		j139011919 -> j635938576;
	j4079497849 [label="Я здесь, и готов погрузиться в сумрачные и пространные рассуждения об обществе Орокин, полагая, что это может быть хоть немного интересно тебе. Но потом я вспоминаю, что не ради этого ты здесь, не так ли, Скиталец? У тебя есть другая игра…",shape=box,color=blue];
		j4079497849 -> j139011919;
	j1837065297 [label="Я здесь, готов погрузиться в сумрачные и пространные размышления об обществе Орокин, полагая, что это может быть тебе хоть немного интересно. Но потом я вспоминаю: тебе, вероятно, уже всё это приходилось слышать, не так ли?",shape=box,color=blue];
		j1837065297 -> j139011919;
	j1117502524 [label="Тебе было бы приятнее, чтобы я просто притворился, что ничего не замечаю? Или… есть ли у тебя какая-то конкретная цель, к которой ты стремишься, затевая всё это? Я совершенно не понимаю, чего надеешься добиться этой жестокой игрой.",shape=box,color=blue];
		j1117502524 -> j2779600969;
	j3012805151 [label="Да, я слышал это от некралойда. Хотя, кажется, их стало меньше с тех пор, как ты или ребёнок покончили с этой проблемой. По крайней мере, они больше не разрывают себя на части – в буквальном смысле.",shape=box,color=blue];
		j3012805151 -> j3572873736;
	j2955973731 [label="Да, я слышал это от некралойда. Похоже, они по-прежнему полны решимости разорвать себя на части.",shape=box,color=blue];
		j2955973731 -> j3930011928;
	j2225075810 [label="Хм? Ах. Некралойд сообщил мне, что ты или дитя носились тут, помогая ему придумывать себе вымышленные имена, позабыв настоящие. Ты знаешь его как «Вилкор». А я знал его как Петроса Вортена. Гордого изобретателя Флота Некрамехов.",shape=box,color=blue];
		j2225075810 -> j3572873736;
	j4023550101 [label="Хм? Ах. Я знал его как Петроса Вортена. Гордый изобретатель Флота Некрамехов. Но некралойд сообщил мне, что они забыли свои имена. Возможно, тебе он известен как «Отец».",shape=box,color=blue];
		j4023550101 -> j3930011928;
	j3037445792 [label="Нет, мне этого не приходилось слышать раньше. Пожалуйста, продолжай.",shape=box,color=red];
		j3037445792 -> j1550919945;
	j1274281585 [label="Я говорю с тобой, Роут, потому что хочу с тобой говорить.",shape=box,color=red];
		j1274281585 -> j862518501;
	j635938576 [label="Я это уже слышал, да. Но, пожалуйста, расскажи мне ещё раз.",shape=box,color=red];
		j635938576 -> j3174558357;
	j2779600969 [label="Boolean RoatheKnowsReset is now true.",color=orange];
		j2779600969 -> j156855749;
	j3572873736 [label="Evaluate expressions",color=orange];
		j3572873736 -> j1912546521 [label="RoatheDeal",color=purple];
		j3572873736 -> j1945193658 [label="RoatheNoDeal",color=purple];
		j3572873736 -> j1945193658 [label="false",color=purple];
	j3930011928 [label="Evaluate expressions",color=orange];
		j3930011928 -> j2153515693 [label="RoatheDeal",color=purple];
		j3930011928 -> j1540728602 [label="RoatheNoDeal",color=purple];
		j3930011928 -> j1540728602 [label="false",color=purple];
	j1550919945 [label="+5 Chemistry",color=orange];
		j1550919945 -> j2134406470;
	j862518501 [label="Check boolean DrifterRoathe",color=orange];
		j862518501 -> j2473022015 [label=true,color=green];
		j862518501 -> j1774379011 [label=false,color=brown];
	j3174558357 [label="Итак, ты признаёшь, что тратишь моё время. Превосходно! Я не дряхлый старик, пересказывающий единственную известную ему историю, потому что других он и не помнит.",shape=box,color=blue];
		j3174558357 -> j1690916405;
	j156855749 [label="Я здесь, готов погрузиться в сумрачные и пространные размышления об обществе Орокин, полагая, что это может быть тебе хоть немного интересно. Но потом я вспоминаю: тебе, вероятно, уже всё это приходилось слышать, не так ли?",shape=box,color=blue];
		j156855749 -> j3037445792;
		j156855749 -> j1274281585;
		j156855749 -> j635938576;
	j1912546521 [label="Это хорошо, ведь без тебя и ребёнка мы бы вряд ли продвинулись дальше. Боюсь, что иначе слуга был бы обречён, едва мы отправили бы его по этой лестнице.",shape=box,color=blue];
		j1912546521 -> j4005998559;
	j1945193658 [label="Кстати, у тебя было время пересмотреть моё предложение? Я сижу здесь тихо, в обмен на помощь в примирении дворецкого и тех заброшенных, заражённых Орокин, что наверху?",shape=box,color=blue];
		j1945193658 -> j674666791;
		j1945193658 -> j355070104;
	j2153515693 [label="И тебе, возможно, стоит сначала поработать над решением этой проблемы, прежде чем мы попытаемся отправить дворецкого наверх. Иначе он превратится в фарш.",shape=box,color=blue];
		j2153515693 -> j4005998559;
	j1540728602 [label="Кстати, у тебя было время пересмотреть моё предложение? Я сижу здесь тихо, в обмен на помощь в примирении дворецкого и тех заброшенных, заражённых Орокин, что наверху? Примирение семьи было бы первым шагом, но…",shape=box,color=blue];
		j1540728602 -> j674666791;
		j1540728602 -> j355070104;
	j2134406470 [label="Ты просишь Орокин заговорить. Ты не знаешь, что творишь. Если не проявить осторожности, застрянешь здесь на час.",shape=box,color=blue];
		j2134406470 -> j3025344673;
	j2473022015 [label="+5 Chemistry",color=orange];
		j2473022015 -> j2705176111;
	j1774379011 [label="О, и позволь поинтересоваться, почему же это?",shape=box,color=blue];
		j1774379011 -> j1737077213;
		j1774379011 -> j3414244290;
		j1774379011 -> j2265720353;
		j1774379011 -> j28145723;
	j1690916405 [label="Причина, по которой я не могу вспомнить этот разговор, заключена в твоём проклятом зеркале!",shape=box,color=blue];
		j1690916405 -> "Chat ends.";
	j4005998559 [label="Тебе надо понимать вот что: несмотря на всю отстранённость, дворецкий и семья Энтрати все ещё потомки Орокин. Они родились и выросли в этом обществе, со всеми его… многочисленными недостатками.",shape=box,color=blue];
		j4005998559 -> j1641179187;
	j674666791 [label="Нет, я не собираюсь менять своего решения, Роут. Это не так уж и важно.",shape=box,color=red];
		j674666791 -> j952029904;
	j355070104 [label="Да. Я... соглашаюсь.",shape=box,color=red];
		j355070104 -> j186436675;
	j3025344673 [label="Хотя, полагаю, у тебя не было особого случая пообщаться с Орокин, не так ли, Скиталец? Этот ребёнок жил совсем другой жизнью.",shape=box,color=blue];
		j3025344673 -> j397504876;
	j2705176111 [label="Мгм. Именно так. И мы оба знаем, почему, не так ли? Но тебе придётся набраться терпения.",shape=box,color=blue];
		j2705176111 -> j20004960;
	j1737077213 [label="[Признаться в чувствах.] Думаю, ты знаешь.",shape=box,color=red];
		j1737077213 -> j96754429;
	j3414244290 [label="Ты вызываешь у меня интерес.",shape=box,color=red];
		j3414244290 -> j171028057;
	j2265720353 [label="У меня нечасто случалось общаться с Орокин. Когда... когда я с ними не сражался. Ты поразителен.",shape=box,color=red];
		j2265720353 -> j589760093;
	j28145723 [label="Неважно. [Завершить]",shape=box,color=red];
		j28145723 -> j3255082196;
	"Chat ends." [color=orange];
	j1641179187 [label="И несмотря на все тяжкие грехи, порядок и иерархия никогда не подвергались сомнению. Ни в армии, ни в общественной структуре. Архимедиан повиновались Орокин. Орокин повиновались Исполнителям. Исполнители – Императорам… по крайней мере, формально.",shape=box,color=blue];
		j1641179187 -> j962847078;
	j952029904 [label="Делай, как знаешь. Дверь не будет открыта долго.",shape=box,color=blue];
		j952029904 -> "Chat ends.";
	j186436675 [label="Boolean RoatheNoDeal is now false.",color=orange];
		j186436675 -> j3641416950;
	j397504876 [label="Судя по слухам, ты отклонился от курса в момент трагедии Заримана 10-0.",shape=box,color=blue];
		j397504876 -> j3236021087;
		j397504876 -> j586428927;
		j397504876 -> j414472754;
	j20004960 [label="Между тем, если ты желаешь послушать, я буду рад исполнить твою просьбу. Просто предупреждаю: ты попросил заговорить одного из Орокин.",shape=box,color=blue];
		j20004960 -> j1476126044;
	j96754429 [label="+5 Chemistry",color=orange];
		j96754429 -> j2208884607;
	j171028057 [label="+5 Chemistry",color=orange];
		j171028057 -> j1145177837;
	j589760093 [label="Знай своего врага, не так ли? Или, может быть, просто любопытство — сидеть за столом с невозможностью? ",shape=box,color=blue];
		j589760093 -> j1855192392;
	j3255082196 [label="Извивайся сколько угодно, рыбка. Ты здесь по своей воле.",shape=box,color=blue];
		j3255082196 -> "Chat ends.";
	j962847078 [label="И даже если ты не веришь, что каким-то образом, даже спустя столько времени, традиции могут вдохновить Лойда прислушаться ко мне? Подумай о том, что я могу быть... невероятно убедительным. В конце концов, я был правой рукой худшего из Исполнителей.",shape=box,color=blue];
		j962847078 -> j4180459840;
		j962847078 -> j382241360;
		j962847078 -> j2591035899;
	j3641416950 [label="Boolean RoatheDeal is now true.",color=orange];
		j3641416950 -> j722691256;
	j3236021087 [label="Нет, до Заримана я почти не имел дела с Орокин, а после… думаю, ты уже слышал суть истории.",shape=box,color=red];
		j3236021087 -> j3275666645;
	j586428927 [label="Я достаточно имел дела с Орокин, чтобы не доверять им даже на секунду.",shape=box,color=red];
		j586428927 -> j1330377252;
	j414472754 [label="Боюсь, к людям твоего склада у меня нет больше никакой любви, как у ребёнка.",shape=box,color=red];
		j414472754 -> j1330377252;
	j1476126044 [label="Ты не знаешь, что творишь. Если не проявить осторожности, застрянешь здесь на час.",shape=box,color=blue];
		j1476126044 -> j3025344673;
	j2208884607 [label="Ммм, да. А я уж думал, ты окажешь мне честь и покажешьэто письменно. Ну что ж...",shape=box,color=blue];
		j2208884607 -> j722506559;
	j1145177837 [label="А ты? Хм. Посмотрим, как долго я смогу удерживать эту рыбу на копье.",shape=box,color=blue];
		j1145177837 -> j20004960;
	j1855192392 [label="+5 Chemistry",color=orange];
		j1855192392 -> j2198787254;
	j4180459840 [label="Худшим из исполнителей был Баллас.",shape=box,color=red];
		j4180459840 -> j1080660277;
	j382241360 [label="Кому ты служил?",shape=box,color=red];
		j382241360 -> j3317686772;
	j2591035899 [label="Как так?",shape=box,color=red];
		j2591035899 -> j3721389560;
	j722691256 [label="+5 Chemistry",color=orange];
		j722691256 -> j2251957745;
	j3275666645 [label="Действительно. Ах, Баллас. Возможно, тебя  удивит, но он был не самым худшим из них.",shape=box,color=blue];
		j3275666645 -> j101051620;
		j3275666645 -> j421187405;
	j1330377252 [label="И я не подозреваю, что виню тебя. Я думал, их можно спасти. Переплавить, так сказать, переплавить, переплавить, как золото.",shape=box,color=blue];
		j1330377252 -> j778920371;
	j722506559 [label="В другой раз, возможно. А ты, Узурпатор, должен научиться ценить эти моменты.",shape=box,color=blue];
		j722506559 -> j2983615598;
	j2198787254 [label="Уважаемый. Даже мудрый. Если бы у меня была возможность взять интервью и, возможно, даже подружиться с Владеющими Разумом? Я бы сделал то же самое. ",shape=box,color=blue];
		j2198787254 -> j3972322624;
	j1080660277 [label="Я уважаю твоё мнение и не осуждаю тебя за него. Баллас был кретином, но он был лидером среди развратников, и я не буду с тобой спорить по этому поводу.",shape=box,color=blue];
		j1080660277 -> j4136832943;
	j3317686772 [label="Evaluate expressions on HellStory counter",color=orange];
		j3317686772 -> j3418380193 [label="x >= 1",color=purple];
		j3317686772 -> j1252490496 [label="x <= 1",color=purple];
		j3317686772 -> j1252490496 [label="false",color=purple];
	j3721389560 [label="Я знаю, что у тебя были личные счёты с Балласом, и я не виню тебя за то, что ты, вероятно, считаешь его худшим из всех, кого могли предложить Семь Золотых Лордов. И он был чемпионом среди развратников, в этом я не буду с вами спорить.",shape=box,color=blue];
		j3721389560 -> j1683292509;
	j2251957745 [label="Замечательно! Рад, к тебе пришло понимание. Теперь мы можем наконец-то добиться прогресса.",shape=box,color=blue];
		j2251957745 -> j4005998559;
	j101051620 [label="Серьёзно?",shape=box,color=red];
		j101051620 -> j920321748;
	j421187405 [label="Тебе будет трудно заставить меня поверить в это.",shape=box,color=red];
		j421187405 -> j920321748;
	j778920371 [label="Что ж. Спасите Исполнителей. Дело было безнадёжным. Возможно, тебя удивит, но Баллас был не самым плохим из них.",shape=box,color=blue];
		j778920371 -> j421187405;
		j778920371 -> j101051620;
	j2983615598 [label="Boolean DrifterRoathe is now true.",color=orange];
		j2983615598 -> j20004960;
	j3972322624 [label="Это даёт психологическое преимущество, если тебе когда-либо придётся встретить одного из них – или даже бывшего союзника – на поле боя.",shape=box,color=blue];
		j3972322624 -> j3712020641;
	j4136832943 [label="И на самом деле я не был свидетелем ужасов этой истории с «Нармером», о которой узнал от дворецкого и которую выудил из записей этой машины, POM-2.",shape=box,color=blue];
		j4136832943 -> j1673847977;
	j3418380193 [label="Ты знаешь, как я упоминал о ней. И, что важнее, тебе намекали на наши планы. Но это история для другого раза. Исполнитель Ниток. Точнее, Верховный Регент Исполнитель Ниток, командующий всеми нашими вооружёнными силами и самый жестокий и смертоносный из Семи Золотых Властелинов.",shape=box,color=blue];
		j3418380193 -> j1812010687;
	j1252490496 [label="Исполнитель Ниток. Точнее, Верховный Регент Исполнитель Ниток. Командующий всеми военными силами Империи Орокин. И самый жестокий и смертоносный из Семи Золотых Властелинов.",shape=box,color=blue];
		j1252490496 -> j1812010687;
	j1683292509 [label="Вполне возможно, что он опередил старых Исполнителей в этом… деле с «Нармером», о котором я слышал от дворецкого и читал в этом POM-2.",shape=box,color=blue];
		j1683292509 -> j1673847977;
	j920321748 [label="Я не утверждаю, что он был святым. Я лишь говорю, что даже самые отъявленные дьяволы уступали ему в злодействе. Разница едва уловима, Узурпатор.",shape=box,color=blue];
		j920321748 -> j2803161869;
	j3712020641 [label="Что ж, если ты желаешь послушать, я буду рад исполнить твою просьбу. Но предупреждаю сразу: ты попросил заговорить Орокин.",shape=box,color=blue];
		j3712020641 -> j1476126044;
	j1673847977 [label="Впрочем, полагаю, что это впечатление вызвано твоей личной близостью к Балласу и крайне ограниченным общением с остальными шестью Золотыми Властелинами.",shape=box,color=blue];
		j1673847977 -> j1812010687;
	j1812010687 [label="Золотая семёрка. Пф. Знаешь ли ты, Скиталец, что самое лучшее в золоте? Его можно бесконечно переплавлять и перековывать во что-то более совершенное.",shape=box,color=blue];
		j1812010687 -> j905494110;
	j2803161869 [label="Был ли Баллас самым худшим? Для тебя, возможно. И, возможно, его преступления в эту эпоху превзошли злодеяния старых Исполнителей.",shape=box,color=blue];
		j2803161869 -> j277809080;
	j905494110 [label="Я верил — и во многом верю до сих пор, — что Орокин можно было спасти. Что мы могли бы повернуть Империю к лучшему. Но Исполнители? Нет. Их нужно было остановить. Они были всем худшим, на что способно человечество, и даже хуже.",shape=box,color=blue];
		j905494110 -> j1944567002;
	j277809080 [label="Но если ты посмотришь на озера багряного цвета и поля сломленных, исковерканных тел, словно на множество выброшенных детских игрушек…",shape=box,color=blue];
		j277809080 -> j2126753484;
	j1944567002 [label="И это говорю я, Узурпатор. Так позвольте же мне, самому Дьяволу Тау, заверить тебя – как ценителю, – Баллас был не самым худшим из них.",shape=box,color=blue];
		j1944567002 -> j581353866;
	j2126753484 [label="Если бы ты видел ту чистую разруху, которую Ниток мог обрушить, даже не успев толком подумать…",shape=box,color=blue];
		j2126753484 -> j1331203093;
	j581353866 [label="Check boolean RoatheUsurper",color=orange];
		j581353866 -> j887252858 [label=true,color=green];
		j581353866 -> j2960628087 [label=true,color=green];
		j581353866 -> j1122494997 [label=false,color=brown];
		j581353866 -> j887252858 [label=false,color=brown];
		j581353866 -> j2960628087 [label=false,color=brown];
	j1331203093 [label="Однако такие ужасы трудно ощутить, не став их свидетелем. Такую трагедию нельзя понять, оперируя цифрами. Я мог бы долго рассказывать о том, что видел, но для тебя это останутся лишь истории.",shape=box,color=blue];
		j1331203093 -> j3238712617;
	j887252858 [label="Тебе будет трудно заставить меня поверить в это.",shape=box,color=red];
		j887252858 -> j277809080;
	j2960628087 [label="Серьёзно?",shape=box,color=red];
		j2960628087 -> j277809080;
	j1122494997 [label="Почему ты всё время называешь меня Узурпатором?",shape=box,color=red];
		j1122494997 -> j2065319694;
	j3238712617 [label="Для тебя Баллас всегда будет гораздо более ощутимым и ужасающим злодеем. И это неудивительно.",shape=box,color=blue];
		j3238712617 -> j1476108111;
	j2065319694 [label="Ах, вот что ты такое, да? Тэнно отняли Изначальную систему у Орокин. А ты, словно птенец кукушки в чужом гнезде, влезаешь в этот мир из своего.",shape=box,color=blue];
		j2065319694 -> j2214797449;
	j1476108111 [label="Но в нем есть многое, чего ты не знаешь. О том кретине уже сказано слишком много. И, боюсь, ещё больше предстоит сказать.",shape=box,color=blue];
		j1476108111 -> j1992378038;
		j1476108111 -> j2202843299;
	j2214797449 [label="И это делает тебя, как минимум по двум причинам, узурпатором в моих глазах. (И, возможно, по третьей, если верить тому, что рассказал мне дворецкий о Дувири, но это спор на другой раз.)",shape=box,color=blue];
		j2214797449 -> j3583592618;
	j1992378038 [label="Во что, например?",shape=box,color=red];
		j1992378038 -> j2562949549;
	j2202843299 [label="Мне неинтересно слушать о жизни Балласа.",shape=box,color=red];
		j2202843299 -> j1379951543;
	j3583592618 [label="Не отвлекай меня, Узурпатор. Понимаю, тебе может быть трудно поверить, но если бы тебе пришлось увидеть озера багряные и поля изогнутых, исковерканных трупов, словно брошенные детские игрушки…",shape=box,color=blue];
		j3583592618 -> j2768689554;
	j2562949549 [label="Boolean RoatheBallas1 is now true.",color=orange];
		j2562949549 -> j1534922574;
	j1379951543 [label="Мм, да. Ну, думаю, вместо этого тебе придётся просто выслушивать истории из моей жизни. Забавно.",shape=box,color=blue];
		j1379951543 -> j473086625;
	j2768689554 [label="Boolean RoatheUsurper is now true.",color=orange];
		j2768689554 -> j2126753484;
	j1534922574 [label="Это… очень долгая история. У меня сейчас нет на неё времени. Дворецкий маячит на горизонте. А я терпеть не могу, когда меня настигают.",shape=box,color=blue];
		j1534922574 -> j1648951696;
	j473086625 [label="+5 Chemistry",color=orange];
		j473086625 -> j209531309;
	j1648951696 [label="Ужасно грубо.",shape=box,color=blue];
		j1648951696 -> j1349076011;
	j209531309 [label="Скоро мы снова поговорим.",shape=box,color=blue];
		j209531309 -> "Chat ends.";
	j1349076011 [label="+15 Chemistry",color=orange];
		j1349076011 -> j209531309;
}