digraph {
	1458 [label="EleanorMonster begins.",color=orange];
		1458 -> 1459;
	1459 [label="Скиталец. Твои слова вчера... О том, как оставить монстра в живых. Ты правда так считаешь? Я должна знать.",shape=box,color=blue];
		1459 -> 1460;
		1459 -> 1461;
		1459 -> 1462;
	1460 [label="Конечно, я говорю что думаю.",shape=box,color=red];
		1460 -> 1464;
	1461 [label="Честно? У меня было время поразмыслить. И нет. Мне придётся остановить тебя, если ты станешь монстром.",shape=box,color=red];
		1461 -> 1465;
	1462 [label="[Игнорировать]",shape=box,color=red];
		1462 -> 1463;
	1464 [label="Не то чтобы я не была чрезвычайно благодарна и, честно говоря, немного шокирована, но... почему? ПОЧЕМУ ты позволяешь мне жить? Когда все остальные здесь с радостью пустили бы пулю мне в голову?",shape=box,color=blue];
		1464 -> 1466;
		1464 -> 1467;
	1465 [label="Спасибо. Ты для меня во многом загадка, но теперь я знаю, что ты можешь пустить пулю мне в голову, а такие вещи важны на рабочем месте.",shape=box,color=blue];
		1465 -> 1468;
	1463 [label="Chat ends.",color=orange];
	1466 [label="Грань между «героем» и «монстром» гораздо размытее, чем большинство готово признать. Я сражаюсь против Гринир и Корпуса, но приходилось сражаться и бок о бок с ними.",shape=box,color=red];
		1466 -> 1473;
	1467 [label="Потому что я считаю тебя одной из самых яростно умных, удивительно саркастичных людей, которых мне пришлось повидать. Мне кажется, даже Техрот не смог бы отнять у тебя это.",shape=box,color=red];
		1467 -> 1472;
	1468 [label="Иииии я только что почувствовала, как Техрот в моих клетках тревожно задрожал.",shape=box,color=blue];
		1468 -> 1469;
	1473 [label="Я не верю в слова «Добро» и «Зло». Есть только люди. Почему ты имеешь меньшее право на существование, чем я? У меня может и нет языка, поражённого Техротом, но природа меня так же изуродовала, как и тебя.",shape=box,color=red];
		1473 -> 1474;
	1472 [label="Как... прекрасно наивно. И чудесно мило, в трагическом смысле.",shape=box,color=blue];
		1472 -> 1475;
	1469 [label="Думаю, теперь он будет вести себя немного лучше. Ничто так не наводит страх на паразита, как угроза его хозяину, верно?",shape=box,color=blue];
		1469 -> 1470;
	1474 [label="Но вот ты здесь, сражаешься со Скальдрой и Техротом, пытаешься найти способ остановить Безразличие. Очевидно, ты веришь, что где-то всё же должна быть проведена грань.",shape=box,color=blue];
		1474 -> 1476;
		1474 -> 1477;
	1475 [label="То, что ты веришь, будто я выйду с другой стороны этой ситуации в роли какой-то королевы улья, сохранив свою сущность, каким-то странным голосом заражения, с которым ты сумеешь подружиться или, возможно, даже будешь восхищаться.",shape=box,color=blue];
		1475 -> 1479;
	1470 [label="Update boolean EleanorNoDate",color=orange];
		1470 -> 1471;
	1476 [label="Безразличие было выпущено на свободу Энтрати. Человеком. Виной тому была человеческая гордыня.",shape=box,color=red];
		1476 -> 1483;
	1477 [label="Защищать людей от смерти — это не то же самое, что верить, что что-то должно быть уничтожено или не имеет права на существование.",shape=box,color=red];
		1477 -> 1478;
	1479 [label="Я бы пожурила тебя за то, что мир не устроен как в книге сказок, но... Я вспомнила, кто ты и откуда ты родом.",shape=box,color=blue];
		1479 -> 1480;
	1471 [label="Chat ends.",color=orange];
	1483 [label="Но Техрот — это не Безразличие. Что из этого? Что из более биологической, земной угрозы?",shape=box,color=blue];
		1483 -> 1485;
		1483 -> 1486;
	1478 [label="Защищать стадо овец от волков — это не то же самое, что выходить и убивать всех волков за то, что они «злые».",shape=box,color=red];
		1478 -> 1484;
	1480 [label="Так что, полагаю, мне не стоит удивляться.",shape=box,color=blue];
		1480 -> 1481;
	1485 [label="Мы на самом деле не знаем, откуда появился Техрот. Он мог быть создан человеком. А может произошло и от чего-то совершенно другого.",shape=box,color=red];
		1485 -> 1488;
	1486 [label="Простой факт состоит в том, что ты не хочешь быть мною убитой. Поэтому я и не хочу этого делать. Я бы тебя отпустил.",shape=box,color=red];
		1486 -> 1489;
	1484 [label="А что, если от Элеоноры ничего не осталось? Что, если ты не увидишь ничего, кроме шипящего, рычащего, плюющегося зверя?",shape=box,color=blue];
		1484 -> 1487;
		1484 -> 1486;
	1481 [label="В любом случае, я думаю, я благодарна, что ты меня не убьёшь. По крайней мере.",shape=box,color=blue];
		1481 -> 1482;
	1488 [label="А если Техрот окажется ещё одним человеком, выпущенным на свободу, как ваш Человек в Стене? Что тогда? Вы выследите меня и убьёте?",shape=box,color=blue];
		1488 -> 1491;
		1488 -> 1492;
	1489 [label="Хотя я благодарна, что ты проявляешь готовность исполнить желание чудовищной леди, я, пожалуй, надеялась на что-то более... обдуманное.",shape=box,color=blue];
		1489 -> 1498;
	1487 [label="Откуда у меня появится уверенность, что в Элеоноре ничего не осталось? Ты говоришь о том, как Техрот думает. Как он с тобой разговаривает. Это явно разумное существо.",shape=box,color=red];
		1487 -> 1490;
	1482 [label="Chat ends.",color=orange];
	1491 [label="Нет, я не смогу.",shape=box,color=red];
		1491 -> 1500;
	1492 [label="Да. Если Техрот действительно неестественный? Тогда... он должен уйти.",shape=box,color=red];
		1492 -> 1501;
	1498 [label="+5 Chemistry",color=orange];
		1498 -> 1493;
	1490 [label="Кажется, это коллективный разум. Возможно, Элеонора всё ещё была бы там, не в одном месте, а в миллиарде. Кто я, чтобы утверждать, что это «неправильно»?",shape=box,color=red];
		1490 -> 1494;
	1500 [label="Ты противоречишь себе. Если ты хочешь остановить одно техногенное отклонение, почему бы не остановить другое?",shape=box,color=blue];
		1500 -> 1506;
		1500 -> 1507;
	1501 [label="Спасибо. Ты для меня во многом загадка, но теперь я знаю, что ты можешь пустить пулю мне в голову, а такие вещи важны на рабочем месте.",shape=box,color=blue];
		1501 -> 1502;
	1493 [label="В любом случае, я думаю, я благодарна, что ты меня не убьёшь. По крайней мере.",shape=box,color=blue];
		1493 -> 1499;
	1494 [label="И вот, когда мне казалось, что я уже не могу обожать тебя сильнее, я снова сижу здесь, утирая слёзы от счастья.",shape=box,color=blue];
		1494 -> 1496;
	1506 [label="Потому что у меня есть чувства к тебе. [Признаться в чувствах]",shape=box,color=red];
		1506 -> 1508;
	1507 [label="Потому что ты слишком много значишь для меня как подруга.",shape=box,color=red];
		1507 -> 1509;
	1502 [label="Иииии я только что почувствовала, как Техрот в моих клетках тревожно задрожал.",shape=box,color=blue];
		1502 -> 1503;
	1499 [label="Chat ends.",color=orange];
	1496 [label="+20 Chemistry",color=orange];
		1496 -> 1495;
	1508 [label="Спрашивать меня, могу ли я убить тебя, просто *жестоко*, Элеонора. Когда сама мысль о том, что ты мертва или тебе больно, просто...",shape=box,color=red];
		1508 -> 1510;
	1509 [label="Спрашивать меня, убью ли я тебя, просто *жестоко*, Элеонора. Ты моя подруга. Ты для меня как семья.",shape=box,color=red];
		1509 -> 1511;
	1503 [label="Думаю, теперь он будет вести себя немного лучше. Ничто так не наводит страх на паразита, как угроза его хозяину, верно?",shape=box,color=blue];
		1503 -> 1504;
	1495 [label="Мне нужно идти, но спасибо, спасибо, СПАСИБО.",shape=box,color=blue];
		1495 -> 1497;
	1510 [label="Факт в том, что? Нет. Я не смогу. Потому что надежда, что ты будешь существовать где-то там, в какой-то форме, где угодно, была бы для меня достаточной.",shape=box,color=red];
		1510 -> 1512;
	1511 [label="Факт в том, что? Нет. Я не смогу. Потому что надежда, что ты будешь существовать где-то там, в какой-то форме, где угодно, была бы для меня достаточной.",shape=box,color=red];
		1511 -> 1513;
	1504 [label="Update boolean EleanorNoDate",color=orange];
		1504 -> 1505;
	1497 [label="Chat ends.",color=orange];
	1512 [label="Извини. Я не могу этого сделать. Мне нужно идти.",shape=box,color=red];
		1512 -> 1514;
	1513 [label="Извини. Я не могу этого сделать. Мне нужно идти.",shape=box,color=red];
		1513 -> 1518;
	1505 [label="Chat ends.",color=orange];
	1514 [label="Update boolean EleanorConfession",color=orange];
		1514 -> 1516;
	1518 [label="+20 Chemistry",color=orange];
		1518 -> 1520;
	1516 [label="+20 Chemistry",color=orange];
		1516 -> 1515;
	1520 [label="Ох, Элеонора, на этот раз ты вляпалась...",shape=box,color=blue];
		1520 -> 1519;
	1515 [label="Ой... ой, что я натворила...",shape=box,color=blue];
		1515 -> 1517;
	1519 [label="Chat ends.",color=orange];
	1517 [label="Chat ends.",color=orange];
}