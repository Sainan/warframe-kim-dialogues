		2043 -> 2046 [label=false,color=brown];
		2043 -> 2047 [label=false,color=brown];
	2042 [label="Chat ends.",color=orange];
	2045 [label="Привет, Элеонора? Помнишь ту настольную игру, которую собирает Амир? «Предания и Просторы»?",shape=box,color=red];
		2045 -> 2044;
	2046 [label="Привет, Элеонора? Вы с Амиром дружите, да?",shape=box,color=red];
		2046 -> 2048;
	2047 [label="Ты же любишь настольные игры, да?",shape=box,color=red];
		2047 -> 2049;
	2044 [label="Да. Та, которую ты считаешь пустой тратой времени и соглашаешься играть только из жалости к нему, это та же, не правда ли?",shape=box,color=blue];
		2044 -> 2050;
		2044 -> 2052;
		2044 -> 2053;
	2048 [label="Он очаровательный маленький чертёнок. Почему ты спрашиваешь?",shape=box,color=blue];
		2048 -> 2055;
		2048 -> 2056;
	2049 [label="Наверное, равно как и любой другой человек. Почему ты спрашиваешь?",shape=box,color=blue];
		2049 -> 2055;
		2049 -> 2056;
	2050 [label="Ой. Ладно. Ты все ещё злишься. Принято.",shape=box,color=red];
		2050 -> 2051;
	2052 [label="Тогда мне казалось, что ты «слишком крута для этого», и мне хотелось казаться тоже. Теперь я лучше знаю.",shape=box,color=red];
		2052 -> 2054;
	2053 [label="Да, я… ​​просто хочу извиниться за это, я… не это имею в виду. Меня волновало, что ты скажешь нет.",shape=box,color=red];
		2053 -> 2062;
	2055 [label="Амир пытается собрать команду, чтобы сыграть в «Предания и Просторы». Я имею намерение помочь.",shape=box,color=red];
		2055 -> 2057;
	2056 [label="Амир действительно хочет сыграть в «Предания и Просторы», со всеми. Ты в деле?",shape=box,color=red];
		2056 -> 2057;
	2051 [label="Chat ends.",color=orange];
	2054 [label="Кто из нас больше не «слишком крут» для игры? Ты или я?",shape=box,color=blue];
		2054 -> 2058;
		2054 -> 2059;
		2054 -> 2060;
	2062 [label="Мы все через это проходили в какой-то момент своей жизни... пытаемся надеть маску, чтобы произвести впечатление, и падаем лицом вниз, потому что не видим, куда идём. А ты, едва познакомившись, спрашиваешь. Ладно. Прощаю.",shape=box,color=blue];
		2062 -> 2067;
	2057 [label="Ах. Поняла. Ты избранный посланник, посланный от Громобойного Короля, чтобы завербовать благородную Элеонору. Несомненно, меня ждут всяческие авантюры. Fol de rol и так далее.",shape=box,color=blue];
		2057 -> 2063;
		2057 -> 2064;
	2058 [label="Ты. Я все ещё думаю, что это тупая игра, но какая разница.",shape=box,color=red];
		2058 -> 2061;
	2059 [label="Я. Определённо я. Ты все ещё слишком крута для игры. Но я — зануда, или так говорит Куинси.",shape=box,color=red];
		2059 -> 2062;
	2060 [label="...Оба?",shape=box,color=red];
		2060 -> 2062;
	2067 [label="Если честно, поиграть с глупым голосом и немного поактёрствовать пару часов звучит идеально. Записывайте меня.",shape=box,color=blue];
		2067 -> 2068;
	2063 [label="Если честно, я думаю, что это будет весело. И, кажется, для него это важно.",shape=box,color=red];
		2063 -> 2067;
	2064 [label="Да, я думаю, это будет полнейшей тратой времени, но я стараюсь быть милой.",shape=box,color=red];
		2064 -> 2065;
	2061 [label="Chat ends.",color=orange];
	2068 [label="О! Я бы хотела быть волшебником. Или, может быть, бардом. Или и тем, и другим? Можно БЫТЬ обоими?",shape=box,color=blue];
		2068 -> 2069;
	2065 [label="Я окажу тебе услугу и НЕ передам эти слова ему. Совет: обращайся с ним с большим уважением, когда я рядом.",shape=box,color=blue];
		2065 -> 2066;
	2069 [label="Или я могла бы быть болотной ведьмой! Если, конечно, мне разрешат носить тесный корсаж. Матушка Мосситица съест твои кости, маленький человечек.",shape=box,color=blue];
		2069 -> 2077;
	2066 [label="Chat ends.",color=orange];
