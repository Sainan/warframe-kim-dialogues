digraph {
	460 [label="EleanorRank2Convo3 begins.",color=orange];
		460 -> 461;
	461 [label="Хорошо, мы знакомы уже какое-то время, и ты из будущего, и я думаю, что могу доверять тебе, чтобы быть честной со мной в этом, так что я должна задать самый важный вопрос.",shape=box,color=blue];
		461 -> 462;
	462 [label="Мы одни? Или мы наконец-то вышли на контакт с кем-то другим?",shape=box,color=blue];
		462 -> 463;
		462 -> 464;
		462 -> 465;
	463 [label="Ты имеешь в виду инопланетную жизнь? Пока нет, но, может быть, однажды.",shape=box,color=red];
		463 -> 466;
	464 [label="К сожалению, ближе всего мы приблизились к Безразличию.",shape=box,color=red];
		464 -> 467;
	465 [label="Да, мы одни. Только люди и то, что создано людьми.",shape=box,color=red];
		465 -> 468;
	466 [label="Чёрт возьми.",shape=box,color=blue];
		466 -> 469;
	467 [label="Что ТАКОЕ «Безразличие»? Я видела его образы в твоём сознании, но не могу понять. Оно заставляет меня хотеть убежать и спрятаться где-то далеко за очень толстыми стенами.",shape=box,color=blue];
		467 -> 470;
		467 -> 471;
	468 [label="Самый мрачный из возможных ответов.",shape=box,color=blue];
		468 -> 472;
	469 [label="Я действительно надеялась, что там есть что-то, с чем мы могли бы поговорить. Что-то с действительно внешним взглядом на наш вид.",shape=box,color=blue];
		469 -> 473;
	470 [label="Мы до сих пор не уверены, что это. Или чего оно ХОЧЕТ. Мы даже не знаем, является ли оно древней сущностью, как считает Красная Вуаль, или Альбрехт как-то привёл его в существование.",shape=box,color=red];
		470 -> 474;
	471 [label="Это то, что забрало Майора Русалку.",shape=box,color=red];
		471 -> 475;
	472 [label="Я не уверена почему. Интеллект есть интеллект, в конце концов. Не должно иметь значения, открыли мы его или создали.",shape=box,color=blue];
		472 -> 540;
	473 [label="Говорить с ним и… другие вещи, конечно.",shape=box,color=blue];
		473 -> 477;
		473 -> 476;
	474 [label="Если я скажу тебе, что это то, что вселилось в Майора Русалку, это поможет?",shape=box,color=red];
		474 -> 475;
	475 [label="Ох.",shape=box,color=blue];
		475 -> 543;
	540 [label="Думаю, я просто хотела уверенности, что Вселенная не сложила все яйца в одну корзину. Потому что если люди — это всё, что есть, то ситуация фиговая.",shape=box,color=blue];
		540 -> 541;
	477 [label="Ищешь друга-монстра с щупальцами?",shape=box,color=red];
		477 -> 494;
	476 [label="Подожди. Что именно ты понимаешь под взаимодействием?",shape=box,color=red];
		476 -> 479;
	543 [label="О, нет.",shape=box,color=blue];
		543 -> 544;
	541 [label="Ну, что ж.",shape=box,color=blue];
		541 -> 542;
	494 [label="+5 Chemistry",color=orange];
		494 -> 478;
	479 [label="Что-то вроде общения, полагаю. Не обязательно что-то физическое. Я просто хочу соприкоснуться разумом с чем-то, что не только не человеческое, но даже не земное.",shape=box,color=blue];
		479 -> 481;
	544 [label="О, ЧЁРТ.",shape=box,color=blue];
		544 -> 545;
	542 [label="Chat ends.",color=orange];
	478 [label="Прошу прощения. Я не «монстр с щупальцами». Я монстр, у которого ЕСТЬ ЩУПАЛЬЦЕ. Одно. Пока что.",shape=box,color=blue];
		478 -> 480;
	481 [label="Я однажды пыталась соприкоснуться разумом с одной из крыс Лэтти, просто, чтобы посмотреть, что произойдёт.",shape=box,color=blue];
		481 -> 483;
		481 -> 484;
	545 [label="ЭТО? Это то же самое, что твоё «Безразличие»?",shape=box,color=blue];
		545 -> 546;
	480 [label="Если бы я только хотела поговорить с существами с щупальцами, я бы зашла в Зоологический сад принцессы Люсины и подружилась с осьминогом.",shape=box,color=blue];
		480 -> 482;
	483 [label="Бедное создание не пострадало?",shape=box,color=red];
		483 -> 485;
	484 [label="Хорошо, я должна спросить, как это прошло.",shape=box,color=red];
		484 -> 485;
	546 [label="Я коснулась его. Я коснулась этой вещи краешком своего разума и заблокировала память.",shape=box,color=blue];
		546 -> 547;
	482 [label="... и теперь я жалею, что не сделала этого. Осьминоги очень умны. Мы, вероятно, уже сочиняли бы стихи вместе. Интересно, где сейчас этот осьминог?",shape=box,color=blue];
		482 -> 486;
	485 [label="Для него это были ужасные три секунды.",shape=box,color=blue];
		485 -> 491;
	547 [label="Я даже не помню, когда это случилось. Она читала одну из своих речей по громкоговорителю, и я подумала: «Я никогда не исследовала её разум, интересно, что там внутри, вероятно, кожа и иглы», и я прикоснулся к её разуму и…",shape=box,color=blue];
		547 -> 548;
	486 [label="Кто-то, вероятно, съел его. Обычно это происходит с животными в зоопарке в карантинных городах, когда запасы заканчиваются.",shape=box,color=blue];
		486 -> 487;
	491 [label="Бедное создание. Я не подумала, что для НЕГО может означать соприкосновение с МОИМ разумом, понимаешь? Представь ребёнка, потерявшегося в бесконечном универмаге, который орёт во всё горло, зовя мать, снова и снова. Всё было огромным, непостижимым, и имело ЗВУКИ и ФОРМЫ вместо ЗАПАХОВ.",shape=box,color=blue];
		491 -> 492;
	548 [label="чёрт-чёрт-чёрт",shape=box,color=blue];
		548 -> 549;
	487 [label="А всё, что не съели, теперь, вероятно, заражено Техротом.",shape=box,color=blue];
		487 -> 488;
	492 [label="Я разорвала связь так быстро, как смогла. Он немного покружился с головокружением час или около того, а потом всё прошло. Сомневаюсь, что он вообще помнит, что с ним случилось.",shape=box,color=blue];
		492 -> 497;
		492 -> 496;
	549 [label="Я пока не могу об этом говорить. Прости.",shape=box,color=blue];
		549 -> 550;
	488 [label="… именно так это было во «сне», да? Только это вообще не сон. Это произошло. Или произойдёт. Или произойдёт какая-то версия этого. Что-то случается в этом зоопарке.",shape=box,color=blue];
		488 -> 489;
	497 [label="А с твоей стороны? Каково это было — быть крысой?",shape=box,color=red];
		497 -> 500;
	496 [label="Это всего лишь крыса, да ладно.",shape=box,color=red];
		496 -> 498;
	550 [label="+20 Chemistry",color=orange];
		550 -> 551;
	489 [label="Я постараюсь запомнить всё, что смогу.",shape=box,color=blue];
		489 -> 490;
	500 [label="Не знаю, был ли у тебя когда-нибудь такой спад, когда всё, чего ты хочешь, — это лежать в постели, дышать и просто существовать, не делая больше ничего. Это было очень похоже.",shape=box,color=blue];
		500 -> 501;
	498 [label="Не дай Лэтти услышать, как ты это говоришь. Если, конечно, тебе нравятся твои органы на их местах.",shape=box,color=blue];
		498 -> 499;
	551 [label="Update boolean EleanorIndifference",color=orange];
		551 -> 552;
	490 [label="Не пытайся остановить меня.",shape=box,color=blue];
		490 -> 493;
	501 [label="Очень просто. Базовые потребности удовлетворяются простыми способами.",shape=box,color=blue];
		501 -> 502;
	499 [label="Chat ends.",color=orange];
	552 [label="Chat ends.",color=orange];
	493 [label="Update boolean EleanorRemembers",color=orange];
		493 -> 495;
	502 [label="Детская невинность ничто по сравнению с сознанием крысы.",shape=box,color=blue];
		502 -> 503;
		502 -> 504;
	495 [label="Chat ends.",color=orange];
	503 [label="Звучит приятно, судя по тому, как ты это описываешь.",shape=box,color=red];
		503 -> 505;
	504 [label="Ты завидуешь крысе?",shape=box,color=red];
		504 -> 506;
	505 [label="О, это так и было. Я уверена, у крысы есть свои тёмные стороны, вроде необходимости съесть своего мёртвого брата, чтобы хищники не учуяли его. Но тот мимолётный момент простоты был почти как религиозное озарение.",shape=box,color=blue];
		505 -> 507;
	506 [label="В некотором роде.",shape=box,color=blue];
		506 -> 509;
	507 [label="Думаю, быть крысой — это чем-то похоже на быть монахом. Жить за счёт объедков, скромно продвигаться по миру, не владеть ни машиной, ни домом.",shape=box,color=blue];
		507 -> 508;
	509 [label="Просто мне кажется, что в этом есть что-то героическое — быть маленьким, простым и почти ни в чём не нуждаться.",shape=box,color=blue];
		509 -> 510;
	508 [label="Религиозное озарение?",shape=box,color=red];
		508 -> 509;
	510 [label="Я долго думала о том, чтобы стать монахиней, веришь или нет.",shape=box,color=blue];
		510 -> 511;
	511 [label="Update boolean EleanorNun1",color=orange];
		511 -> 512;
		511 -> 513;
	512 [label="Ты должна объяснить, что это такое, Элеонора.",shape=box,color=red];
		512 -> 514;
	513 [label="Монахиня?",shape=box,color=red];
		513 -> 515;
	514 [label="Да, верно. Кажется, там, откуда ты, их нет.",shape=box,color=blue];
		514 -> 516;
	515 [label="Верно. Возможно, там, откуда ты, их действительно нет.",shape=box,color=blue];
		515 -> 516;
	516 [label="Что-то вроде посвящённой Луне. Выбритая голова, белые или чёрные одежды в зависимости от Аспекта, очень строгая жизнь. От тебя ожидается сосредоточенность на святых вещах в ущерб всему остальному. Ежедневная молитва и медитация. Простая диета.",shape=box,color=blue];
		516 -> 517;
		516 -> 518;
		516 -> 519;
		516 -> 520;
	517 [label="Звучит ужасно.",shape=box,color=red];
		517 -> 521;
	518 [label="Звучит потрясающе.",shape=box,color=red];
		518 -> 522;
	519 [label="Звучит как вызов.",shape=box,color=red];
		519 -> 523;
	520 [label="Звучит… так, будто это не для меня.",shape=box,color=red];
		520 -> 526;
	521 [label="С виду да. Единственная разница между монастырской жизнью и тюрьмой в том, что ты делаешь это добровольно.",shape=box,color=blue];
		521 -> 527;
	522 [label="Это кажется потрясающим большинству молодых послушников, пока они действительно не попробуют монастырскую жизнь. Думаю, процент ухода составляет около восьмидесяти.",shape=box,color=blue];
		522 -> 527;
	523 [label="О, нет. Вначале, да, нужно избавиться от всего, чему общество научило тебя нуждаться. Эта фаза, вероятно, самая сложная.",shape=box,color=blue];
		523 -> 528;
	526 [label="+10 Chemistry",color=orange];
		526 -> 524;
	527 [label="Оказалось, это не для меня. Я слишком люблю жить в этом мире.",shape=box,color=blue];
		527 -> 525;
	528 [label="Но когда ты уже устроишься, какой вызов останется? Искушение? Ты его никогда не увидишь. Смысл в том, чтобы отрезать себя от всего, что может отвлечь тебя от святого.",shape=box,color=blue];
		528 -> 527;
	524 [label="Это оказалось не подходящим и для меня. Оказалось, я слишком люблю жить в этом мире.",shape=box,color=blue];
		524 -> 525;
	525 [label="Но Сол… это как будто существует альтернативная версия меня, которая сидит где-то на вершине горы, окружённая облаками благовоний, перебирая бусы из чёрного агата и лунного камня, и смотрит на меня с откровенным сожалением.",shape=box,color=blue];
		525 -> 529;
	529 [label="Я знаю, что это просто фантазия. Такая же фантазия, как эти рыцари в доспехах из сказок Артура.",shape=box,color=blue];
		529 -> 530;
		529 -> 531;
	530 [label="Мы все фантазируем о том, что однажды у нас всё будет под контролем.",shape=box,color=red];
		530 -> 532;
	531 [label="Я разговариваю с альтернативной версией себя всё время. Мы даже ели вместе. Это не так безумно, как тебе кажется.",shape=box,color=red];
		531 -> 533;
	532 [label="Спасибо. Почему-то это невероятно утешительно слышать.",shape=box,color=blue];
		532 -> 534;
	533 [label="Да. Я всё время забываю, что то, через что тебе пришлось пройти, — это чистое безумие по любым нормальным стандартам.",shape=box,color=blue];
		533 -> 534;
	534 [label="Знаешь… я никогда раньше этого не делала, но думаю, попробую дотянуться до неё, вдруг она существует. Да. Может быть, я смогу связаться с «Сестрой Элеонорой» телепатически.",shape=box,color=blue];
		534 -> 535;
	535 [label="Что самое худшее, что может случиться?",shape=box,color=blue];
		535 -> 538;
	538 [label="+10 Chemistry",color=orange];
		538 -> 536;
	536 [label="Может, я услышу слова наставления от другой себя. Представь это. О Луа, я прямо сейчас взволнована.",shape=box,color=blue];
		536 -> 537;
	537 [label="Update boolean EleanorSister",color=orange];
		537 -> 539;
	539 [label="Chat ends.",color=orange];
}