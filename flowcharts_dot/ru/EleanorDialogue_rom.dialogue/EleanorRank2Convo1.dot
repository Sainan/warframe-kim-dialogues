digraph {
	286 [label="EleanorRank2Convo1 begins.",color=orange];
		286 -> 287;
		286 -> 288;
		286 -> 289;
	287 [label="Ты так больна, как, по-видимому, думает Лэтти?",shape=box,color=red];
		287 -> 290;
	288 [label="Как у тебя дела с личным заражением?",shape=box,color=red];
		288 -> 292;
	289 [label="Что происходит между тобой и Лэтти?",shape=box,color=red];
		289 -> 294;
	290 [label="Давай проясним. Лэтти не думает, что я больна. Лэтти думает, что я демон.",shape=box,color=blue];
		290 -> 291;
	292 [label="В этом нет ничего неприятного, чего нельзя сказать о большинстве случаев заражения паразитами.",shape=box,color=blue];
		292 -> 293;
	294 [label="Ты знаешь, как она меня называет?",shape=box,color=blue];
		294 -> 295;
		294 -> 296;
	291 [label="Интересно, каково это — иметь столь романтический взгляд на мир. Казалось бы, медик должен заниматься измеримыми фактами. Десять кубиков этого, идентификация микробов того.",shape=box,color=blue];
		291 -> 303;
		291 -> 304;
	293 [label="Я чувствую Техноциты, плавающие в моей крови. Если я закрою глаза, я могу видеть искорки, как сказочную пыль.",shape=box,color=blue];
		293 -> 299;
	295 [label="Честно говоря, нет.",shape=box,color=red];
		295 -> 298;
	296 [label="«La Bruja Metiche». Назойливая ведьма.",shape=box,color=red];
		296 -> 297;
	303 [label="Очень научно с твоей стороны. Я думала, ты веришь в более духовные вещи?",shape=box,color=red];
		303 -> 308;
	304 [label="Звучит так, будто ты считаешь, что часть о «потере человечности» преувеличена.",shape=box,color=red];
		304 -> 309;
	299 [label="Она желает мне добра. Ты можешь это понять?",shape=box,color=blue];
		299 -> 302;
	298 [label="«La Bruja Metiche». Назойливая ведьма. Думаю, она могла бы придумать что-то похуже, учитывая её словарный запас и склонность к творческим ругательствам.",shape=box,color=blue];
		298 -> 300;
	297 [label="Ага. Она сидит там, ухмыляется с её флаконами и зельями, бутылками крови и кусочками кожи, армией облезлых фамильяров, шныряющих повсюду, и имеет наглость называть ВЕДЬМОЙ меня.",shape=box,color=blue];
		297 -> 305;
		297 -> 306;
		297 -> 307;
	308 [label="Ну, да. Живя так, как мы, как можно не верить в духовный мир?",shape=box,color=blue];
		308 -> 313;
	309 [label="Я всё ещё Элеонора Найтингейл. Для меня это важнее, чем быть «человечной».",shape=box,color=blue];
		309 -> 314;
	302 [label="Всё, что оно делает, оно делает из искреннего желания исправить меня и сделать лучше. Если я быстрая, смертоносная и трудная для убийства, я буду хорошим носителем. Поэтому оно выполняет свою часть нашего симбиотического соглашения, давая мне кожу акулы и клыки волка, вместе с языком, как кожаный кнут.",shape=box,color=blue];
		302 -> 303;
		302 -> 304;
	300 [label="Я слышала, как она говорила Куинси сделать кое-что довольно изобретательное с игровыми конструкциями и частями его тела, и я честно некоторое время хихикала, представляя это.",shape=box,color=blue];
		300 -> 301;
	305 [label="Я понимаю, вы не нравитесь друг другу.",shape=box,color=red];
		305 -> 310;
	306 [label="Это всегда было так между вами?",shape=box,color=red];
		306 -> 311;
	307 [label="Она считает, что ты потеряешь контроль.",shape=box,color=red];
		307 -> 312;
	313 [label="Check boolean EleanorVoidLove",color=orange];
		313 -> 327 [label=true,color=green];
		313 -> 328 [label=false,color=brown];
	314 [label="Я видел, на что способны люди. Мы не являемся чем-то особенным. Судя по тому, что я видел в твоей голове, со временем нам станет ещё хуже.",shape=box,color=blue];
		314 -> 320;
	301 [label="Она сидит там, ухмыляется с её флаконами и зельями, бутылками крови и кусочками кожи, армией облезлых фамильяров, шныряющих повсюду, и имеет наглость называть ВЕДЬМОЙ меня.",shape=box,color=blue];
		301 -> 305;
		301 -> 306;
		301 -> 307;
	310 [label="Не пойми меня неправильно. Я БЫ обмочилась на неё, если бы она горела.",shape=box,color=blue];
		310 -> 315;
	311 [label="Думаю, ты можешь догадаться, каков будет ответ.",shape=box,color=blue];
		311 -> 318;
	312 [label="Я знаю. Иногда у меня тоже так бывает. Мне снится повторяющийся кошмар, где я разрываю ей горло, а она в этот момент стреляет мне в сердце.",shape=box,color=blue];
		312 -> 317;
	327 [label="Бездна — это убедительное доказательство того, что духовное так же реально, как и материальное. Всё, что ваши люди сделали, кроме как назвали это по-другому, — это разработали надёжный способ туда попасть и вернуться обратно.",shape=box,color=blue];
		327 -> 328;
	328 [label="Слушай. То, что я признаю существование демонических сил, не значит, что я согласна, чтобы меня записали в их ряды.",shape=box,color=blue];
		328 -> 335;
	320 [label="Check boolean EleanorEntrati",color=orange];
		320 -> 324 [label=true,color=green];
		320 -> 325 [label=true,color=green];
		320 -> 326 [label=true,color=green];
		320 -> 325 [label=false,color=brown];
		320 -> 326 [label=false,color=brown];
	315 [label="Но я бы не торопилась с этим.",shape=box,color=blue];
		315 -> 316;
	318 [label="Chat ends.",color=orange];
	317 [label="Но бояться чего-то — не значит, что это реально. До сих пор я не устроила НИ ОДНОЙ кровавой бойни. НИ ОДНОЙ.",shape=box,color=blue];
		317 -> 319;
	335 [label="То, что происходит в моей системе, — это результат весьма обыденных атомов и молекул, танцующих вместе неожиданными и удивительными способами. Любое духовное значение этому придам Я. А не Лэтти.",shape=box,color=blue];
		335 -> 336;
		335 -> 337;
		335 -> 338;
	324 [label="Ты хочешь просто сдаться? Ты звучишь как Сын.",shape=box,color=red];
		324 -> 329;
	325 [label="Если бы ты следовала его замыслу, ты бы вообще это поняла?",shape=box,color=red];
		325 -> 330;
	326 [label="По крайней мере, человеческий геном естественен.",shape=box,color=red];
		326 -> 331;
	316 [label="Chat ends.",color=orange];
	319 [label="Амир причинил больше чертовых травм, чем я.",shape=box,color=blue];
		319 -> 321;
	336 [label="Я понимаю, вы друг друга недолюбливаете.",shape=box,color=red];
		336 -> 339;
	337 [label="Так всегда было между вами?",shape=box,color=red];
		337 -> 341;
	338 [label="Она думает, ты потеряешь контроль.",shape=box,color=red];
		338 -> 349;
	329 [label="Я такого не говорила.",shape=box,color=blue];
		329 -> 332;
	330 [label="В отличие от следования замыслу хитроумной двойной спирали нуклеотидов? Ты знаешь, то, чем люди занимались с тех пор, как встали на две ноги?",shape=box,color=blue];
		330 -> 333;
	331 [label="Всякие типы вроде Виктора Водяного — и что это за псевдоним такой, чтобы выбирать для себя — оправдывают свои устаревшие взгляды, утверждая, что они «естественны». Биологический фундаментализм. Человек как отражение Божественного и всё такое.",shape=box,color=blue];
		331 -> 334;
	321 [label="Но Амир милый и немного простоватый, не так ли? У Амира нет зубов, способных разгрызть консервную банку. Поэтому никто не видит в Амире бомбу с часовым механизмом.",shape=box,color=blue];
		321 -> 322;
	339 [label="Не пойми меня неправильно. Я БЫ обмочилась на неё, если бы она горела.",shape=box,color=blue];
		339 -> 343;
	341 [label="Думаю, ты можешь догадаться, каков будет ответ.",shape=box,color=blue];
		341 -> 340;
	349 [label="+10 Chemistry",color=orange];
		349 -> 342;
	332 [label="Некоторые люди считают человечество священным. Такие, как Виктор. Я для него — высшее кощунство. Заражённая, бесстыжая и женщина.",shape=box,color=blue];
		332 -> 351;
		332 -> 354;
	333 [label="«Я не подчиняюсь микроскопическому тирану! Я человек. Я особенный! Найти пару. Размножиться. Защитить территорию. Уфф.»",shape=box,color=blue];
		333 -> 351;
		333 -> 354;
	334 [label="Но мы стали неестественными с того самого момента, как начали бить камни друг о друга. Язык — это вирус, дружище. Быть человеком — это чистый лист, на котором мы можем писать, а не первобытный Эдем, из которого нас изгнали.",shape=box,color=blue];
		334 -> 351;
		334 -> 354;
	322 [label="Ну, кроме Куинси.",shape=box,color=blue];
		322 -> 323;
	343 [label="Но я бы не стала торопиться с этим.",shape=box,color=blue];
		343 -> 344;
	340 [label="Chat ends.",color=orange];
	342 [label="Я знаю. Иногда у меня тоже так бывает. Мне снится повторяющийся кошмар, где я разрываю ей горло, а она в этот момент стреляет мне в сердце.",shape=box,color=blue];
		342 -> 345;
	351 [label="Техрот мог бы захватить твой разум, и ты бы даже этого не поняла.",shape=box,color=red];
		351 -> 352;
	354 [label="Я видела, как он поглощал целые ЛУНЫ, Элеонора!",shape=box,color=red];
		354 -> 355;
	323 [label="Chat ends.",color=orange];
	344 [label="Chat ends.",color=orange];
	345 [label="Но бояться чего-то — не значит, что это реально. До сих пор я не устроила НИ ОДНОЙ кровавой бойни. НИ ОДНОЙ.",shape=box,color=blue];
		345 -> 346;
	352 [label="Я имею в виду... да. Ты права. Есть паразиты, которые так делают.",shape=box,color=blue];
		352 -> 353;
	355 [label="И что такого чудесного в непоглощённой луне? Почему версия с Заражением хуже?",shape=box,color=blue];
		355 -> 356;
	346 [label="Амир причинил больше чертовых травм, чем я.",shape=box,color=blue];
		346 -> 347;
	353 [label="Но что, если это не паразит? Что, если это симбиоз?",shape=box,color=blue];
		353 -> 359;
		353 -> 360;
	356 [label="О нет! Кусок безразличной космической породы, который мог бы ещё несколько тысячелетий дрейфовать без цели, вдруг становится живым и интересным! Какая катастрофа!",shape=box,color=blue];
		356 -> 357;
	347 [label="Но Амир милый и немного простоватый, не так ли? У Амира нет зубов, способных разгрызть консервную банку. Поэтому никто не видит в Амире бомбу с часовым механизмом.",shape=box,color=blue];
		347 -> 348;
	359 [label="Ты не знаешь, о чём говоришь. Когда кто-то теряется в Заражении, он ПОТЕРЯН. Полностью неузнаваем.",shape=box,color=red];
		359 -> 361;
	360 [label="Я понимаю, тебе нужно попытаться принять то, чем ты стала. Ты сталкиваешься с невозможной задачей.",shape=box,color=red];
		360 -> 362;
	357 [label="Это точно такая же чушь, что несут последователи Виктора. Сентиментальная привязанность к тому, чем что-то БЫЛО раньше.",shape=box,color=blue];
		357 -> 358;
	348 [label="Ну, кроме Куинси.",shape=box,color=blue];
		348 -> 350;
	361 [label="Я не знаю, пытаешься ли ты меня спровоцировать, но мне приходилось сражаться за свою жизнь против этих созданий. Иногда ты можешь различить части, которые раньше были человеческими. Головы и ноги, просто торчащие из массы.",shape=box,color=red];
		361 -> 363;
	362 [label="Или ненавидь то, чем ты стала, или прими это. И что-то мне подсказывает, что ты давно научилась переставать ненавидеть себя.",shape=box,color=red];
		362 -> 364;
	358 [label="Как будто быть первобытным — это то же самое, что быть совершенным.",shape=box,color=blue];
		358 -> 359;
		358 -> 360;
	350 [label="Chat ends.",color=orange];
	363 [label="Это не симбиоз. Ему ПЛЕВАТЬ, чего ты хочешь. Он здесь не для того, чтобы помочь. Это агрессивный рак жизни, который хочет только превратить всё остальное в самого себя.",shape=box,color=red];
		363 -> 365;
	364 [label="Но эти демоны в твоей крови НЕ твои друзья. Всё, что ты можешь сделать, — это держать их на коротком поводке, Элеонора. Поверь мне.",shape=box,color=red];
		364 -> 366;
	365 [label="Напомни мне, из чего снова сделаны ваши варфреймы?",shape=box,color=blue];
		365 -> 369;
	366 [label="Ты думаешь, я не знаю?",shape=box,color=blue];
		366 -> 367;
	369 [label="Заражённые люди.",shape=box,color=red];
		369 -> 370;
	367 [label="Ты вообще представляешь, чего стоит сдерживать ярость? Ты знаешь, какая цена этой внешней невозмутимости?",shape=box,color=blue];
		367 -> 368;
	370 [label="Но их Заражение было сформировано и контролировалось, не так ли?",shape=box,color=blue];
		370 -> 371;
	368 [label="Если ты видишь, как я медитирую, я не общаюсь с великим космическим капустным духом. Я остужаю чёртов реактор.",shape=box,color=blue];
		368 -> 372;
	371 [label="Прямо как Заражение, которое сейчас во мне.",shape=box,color=blue];
		371 -> 373;
	372 [label="Есть СТОЛЬКО вещей, которые я могла бы сделать, но НЕ ДЕЛАЮ. Места, куда я мог бы это отнести... вещи... о которых ты даже не знаешь.",shape=box,color=blue];
		372 -> 374;
	373 [label="Это значит, что кто-то, где-то набрался смелости перестать считать Заражение безмозглым монстром и начал смотреть на то, чем оно могло бы стать.",shape=box,color=blue];
		373 -> 376;
		373 -> 377;
	374 [label="Я могла бы проникнуть в их СНЫ. И они даже не поняли бы, что я там была.",shape=box,color=blue];
		374 -> 380;
	376 [label="О, ты НЕ только что описала Баллас как «имеющих смелость».",shape=box,color=red];
		376 -> 385;
	377 [label="Так… ты думаешь, ты становишься больше собой, а не меньше?",shape=box,color=red];
		377 -> 382;
	380 [label="+20 Chemistry",color=orange];
		380 -> 375;
	385 [label="+10 Chemistry",color=orange];
		385 -> 378;
	382 [label="+20 Chemistry",color=orange];
		382 -> 379;
	375 [label="Ну, это был интересный, хоть и немного грубоватый обмен мнениями. Я прекрасно провела время. Давай повторим.",shape=box,color=blue];
		375 -> 381;
	378 [label="Знаешь, ты начинаешь слишком эмоционально реагировать. Нам стоит закончить этот разговор в другой раз.",shape=box,color=blue];
		378 -> 384;
	379 [label="В прошлый раз, когда меня накрыло биохимическим молотом, который оставил меня растянутой на диване на полдня, а люди шептались за моей спиной, что я превращаюсь в монстра, это называлось \"пубертат\".",shape=box,color=blue];
		379 -> 383;
	381 [label="Chat ends.",color=orange];
	384 [label="Chat ends.",color=orange];
	383 [label="Chat ends.",color=orange];
}