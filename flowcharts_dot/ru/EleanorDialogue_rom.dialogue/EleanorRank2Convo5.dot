digraph {
	673 [label="EleanorRank2Convo5 begins.",color=orange];
		673 -> 674;
	674 [label="Привет, Элеонора...",shape=box,color=red];
		674 -> 675;
	675 [label="Да? Что у тебя на уме?",shape=box,color=blue];
		675 -> 683;
		675 -> 676;
	683 [label="Ты была «журналисткой», да? Что это вообще такое?",shape=box,color=red];
		683 -> 684;
	676 [label="Да ничего особенного. [Завершить]",shape=box,color=red];
		676 -> 677;
	684 [label="Тот, кто превращает чужие травмы в деньги.",shape=box,color=blue];
		684 -> 685;
	677 [label="Я.",shape=box,color=blue];
		677 -> 678;
	685 [label="Понял. У нас их называют «Корпус».",shape=box,color=red];
		685 -> 686;
	678 [label="...",shape=box,color=blue];
		678 -> 679;
	686 [label="Check boolean EleanorOrigin",color=orange];
		686 -> 687 [label=true,color=green];
		686 -> 688 [label=false,color=brown];
	679 [label="Ты...",shape=box,color=blue];
		679 -> 680;
	687 [label="О, Боже. Прости. Это была шутка.",shape=box,color=blue];
		687 -> 688;
	688 [label="Позволь мне попробовать ещё раз.",shape=box,color=blue];
		688 -> 689;
	680 [label="Не я это начала...",shape=box,color=blue];
		680 -> 681;
	689 [label="Журналист — это тот, кто охотится за интересными вещами, происходящими в мире, и рассказывает о них другим людям, либо через статьи, либо через вещание. Обычно и то, и другое.",shape=box,color=blue];
		689 -> 690;
	681 [label="Загадочное создание...",shape=box,color=blue];
		681 -> 682;
	690 [label="Рассказчик, полагаю. Но не тот, кто что-то придумывает.",shape=box,color=blue];
		690 -> 691;
		690 -> 692;
	682 [label="Chat ends.",color=orange];
	691 [label="Так что делает историю «интересной»?",shape=box,color=red];
		691 -> 693;
	692 [label="То есть ты рассказываешь только правду? Как ты выбираешь, какую правду рассказывать?",shape=box,color=red];
		692 -> 693;
	693 [label="Большую часть времени людям интересно читать о плохих вещах, происходящих в мире. Если идёт кровь, то это в топе, как говорится.",shape=box,color=blue];
		693 -> 694;
	694 [label="Не могу представить, чтобы в твоё время было иначе.",shape=box,color=blue];
		694 -> 695;
	695 [label="Я пыталась изменить мир своей работой. Да, я зарабатывала этим деньги, но я хотела сделать что-то хорошее в мире.",shape=box,color=blue];
		695 -> 696;
	696 [label="Check boolean EleanorHatesHeroes",color=orange];
		696 -> 697 [label=true,color=green];
		696 -> 698 [label=false,color=brown];
	697 [label="Тогда я была моложе, конечно. Ничто так не излечивает от желания «сделать добро в мире», как некоторое время, проведённое в этом мире.",shape=box,color=blue];
		697 -> 699;
	698 [label="Вот куда это меня привело. Буквально. Я вообще приехала сюда, в Хёльванию, из-за этой истории.",shape=box,color=blue];
		698 -> 700;
	699 [label="Прости. Увлеклась. Мне нужно выговориться. Ты в состоянии слушать, как я ворчу о своей любимой ненависти?",shape=box,color=blue];
		699 -> 701;
		699 -> 702;
	700 [label="Мне казалось, ты здесь из-за Артура.",shape=box,color=red];
		700 -> 705;
	701 [label="Конечно, почему бы и нет.",shape=box,color=red];
		701 -> 704;
	702 [label="Если честно, нет. [Завершить]",shape=box,color=red];
		702 -> 703;
	705 [label="О, он был здесь первым. Но он сделал ошибку, рассказав мне, что здесь происходит, и я не смогла это проигнорировать. Так что я звоню своему старому другу Дэнни Макилвою и переплачиваю за поддельную визу и паспорт. Потому что они мне нужны срочно.",shape=box,color=blue];
		705 -> 706;
	704 [label="Ладно. Только не говори, что я не предупреждала. У меня есть теория, которую я называю «Вирус Героя».",shape=box,color=blue];
		704 -> 707;
	703 [label="Chat ends.",color=orange];
	706 [label="Тебе нужно понять: они закрывали Хёльванию, но не могли сделать это сразу. Это может быть город-государство за стенами, существующее со времён Лучезарного Хана, но стены, которые они построили, чтобы сдержать её, теперь старые, и власти не успевали установить баррикады и контрольно-пропускные пункты.",shape=box,color=blue];
		706 -> 708;
	707 [label="Просто представь на мгновение, что вирус может передаваться через истории. Как и любой вирус, он хочет захватить хозяина и распространиться дальше.",shape=box,color=blue];
		707 -> 709;
	708 [label="Люди ломали голову, как выбраться отсюда. Так что никто особо не обратил внимания на одну глупую британскую девушку, которая пыталась войти.",shape=box,color=blue];
		708 -> 710;
	709 [label="Вирус Героя заставляет тебя видеть мир, как если бы он был историей. Он убеждает тебя, что Добро — это всегда про ЛИЧНОСТИ, делающие УДИВИТЕЛЬНЫЕ ВЕЩИ",shape=box,color=blue];
		709 -> 711;
	710 [label="Ты хочешь узнать худшую часть?",shape=box,color=blue];
		710 -> 712;
		710 -> 713;
	711 [label="Естественно, ты хочешь быть одним из этих людей",shape=box,color=blue];
		711 -> 720;
	712 [label="Расскажи мне худшую часть.",shape=box,color=red];
		712 -> 717;
	713 [label="Это будет мерзко?",shape=box,color=red];
		713 -> 714;
	720 [label="Неважно, насколько это может быть тяжело",shape=box,color=blue];
		720 -> 721;
	717 [label="Ладно. Вот худшая часть.",shape=box,color=blue];
		717 -> 718;
	714 [label="О, и вдруг мы стали брезгливыми?",shape=box,color=blue];
		714 -> 715;
	721 [label="Потому что Герой должен принимать сложные решения. Герой должен стойко переносить боль.",shape=box,color=blue];
		721 -> 722;
	718 [label="Я расследовала вспышку того, что называлось синдромом Тестудо. Тестудо — потому что это значит черепаха, и люди, у которых он проявлялся, обнаруживали на своей коже плотные пятна как ранний признак. То же самое, что в конечном итоге превращается в броню у нас, счастливчиков.",shape=box,color=blue];
		718 -> 719;
	715 [label="Извини, что расстроила твои  тонкие чувства. Забудь тогда.",shape=box,color=blue];
		715 -> 716;
	722 [label="Это всё такая циничная чушь. Вирус Героя существует, чтобы продавать игрушки, рекламировать фильмы и заставлять маленьких мальчиков и девочек вырастать готовым пушечным мясом",shape=box,color=blue];
		722 -> 723;
	719 [label="Синдром Тестудо был устойчивым к лечению заболеванием, которое, казалось, было уникально для Хёльвании, имело загадочную и зловещую связь с компьютерами и возникло внезапно. И у тех, кто задавал слишком много вопросов, была тенденция заканчивать в качестве засоров в Хёльванских канализационных трубах.",shape=box,color=blue];
		719 -> 724;
	716 [label="Chat ends.",color=orange];
	723 [label="Они не снимают фильмы про Избранного, чьё героическое предназначение — подтирать задницы старикам в доме престарелых",shape=box,color=blue];
		723 -> 725;
	724 [label="Спустя часы после моего проникновения в Хёльванию я уже пробиралась через канализацию и успокаивала Артура, у которого был самый большой эмоциональный срыв, который я когда-либо видела.",shape=box,color=blue];
		724 -> 726;
	725 [label="Я почти закончила, не отвлекайся",shape=box,color=blue];
		725 -> 727;
	726 [label="Тот мальчик. Можно подумать, что я последовала за ним сюда только, чтобы его разозлить.",shape=box,color=blue];
		726 -> 728;
		726 -> 729;
		726 -> 730;
	727 [label="Вирус Героя обманывает тебя, заставляя думать, что ты можешь сделать больше всего добра, если на тебя направлен свет прожекторов. Он задаёт невозможный, извращённый пример",shape=box,color=blue];
		727 -> 733;
	728 [label="Похоже, ты не воспринимала ситуацию всерьёз.",shape=box,color=red];
		728 -> 735;
	729 [label="Признай, ты это сделала.",shape=box,color=red];
		729 -> 736;
	730 [label="Нет, но это *было* приятным бонусом, не так ли?",shape=box,color=red];
		730 -> 737;
	733 [label="+15 Chemistry",color=orange];
		733 -> 731;
	735 [label="Чёрт побери, я всерьёз это восприняла.",shape=box,color=blue];
		735 -> 738;
	736 [label="Конечно, восприняла. Но у меня также была благородная цель.",shape=box,color=blue];
		736 -> 739;
	737 [label="Именно. Но у меня также была благородная цель.",shape=box,color=blue];
		737 -> 739;
	731 [label="Артур думает, что теряет меня из-за Техрота. Но правда в том, что я потеряла его из-за Вируса Героя ещё давно.",shape=box,color=blue];
		731 -> 732;
	738 [label="Люди пытались убить меня. Простите за моё чувство юмора по этому поводу.",shape=box,color=blue];
		738 -> 740;
	739 [label="Это «благородно». Ради Сол. Я действительно заслужила всё, что со мной случилось, не так ли?",shape=box,color=blue];
		739 -> 741;
		739 -> 742;
	732 [label="Update boolean EleanorHeroVirus",color=orange];
		732 -> 734;
	740 [label="Возможно, ты просто слишком долго была одна, но в команде вроде этой подшучивание друг над другом помогает сохранить рассудок.",shape=box,color=blue];
		740 -> 745;
	741 [label="Ты рассказывала мне о самой худшей части.",shape=box,color=red];
		741 -> 743;
	742 [label="Похоже, ты просто выполняла свою работу. Что было дальше?",shape=box,color=red];
		742 -> 744;
	734 [label="Chat ends.",color=orange];
	745 [label="Признаюсь, иногда это задевает за живое, особенно когда Лэтти впадает в один из своих депрессивных спадов и ей нужен кто-то, чтобы ненавидеть",shape=box,color=blue];
		745 -> 746;
	743 [label="Верно, верно.",shape=box,color=blue];
		743 -> 744;
	744 [label="Итак, я в канализации, и что-то с кучей ЭЛТ-мониторов вместо головы проходит мимо, шатаясь. Едва я закончила возиться с этим, как обнаружила гнездо.",shape=box,color=blue];
		744 -> 749;
	746 [label="Но, пожалуйста, ради нас всех, чуть-чуть расслабься.",shape=box,color=blue];
		746 -> 747;
	749 [label="Наросты. Частично органика, частично технологии, частично чья-то белая горячка. Свет в таких цветах, которые люди видят только после вдыхания слишком большого количества растворителей. Это отвратительно, и я не могу отвести глаз.",shape=box,color=blue];
		749 -> 750;
	747 [label="Даже Артур иногда открывает пиво и закидывает ноги на стол.",shape=box,color=blue];
		747 -> 748;
	750 [label="Джекпот, думаю я.",shape=box,color=blue];
		750 -> 751;
		750 -> 752;
	748 [label="Chat ends.",color=orange];
	751 [label="О, нет...",shape=box,color=red];
		751 -> 754;
	752 [label="Скажи, что ты там не осталась.",shape=box,color=red];
		752 -> 753;
	754 [label="Я сделала дюжину зернистых фотографий на свой слип-телефон Kinematic 2300A и отправила их Артуру.",shape=box,color=blue];
		754 -> 755;
	753 [label="Конечно, осталась.",shape=box,color=blue];
		753 -> 754;
	755 [label="И сказала: «Думаю, я нашла, откуда идёт этот Техрот.»",shape=box,color=blue];
		755 -> 756;
	756 [label="На следующий день я опубликовала статью. «Техрот под улицами Хёльвании»",shape=box,color=blue];
		756 -> 757;
		756 -> 758;
	757 [label="Ты дала ему имя.",shape=box,color=red];
		757 -> 759;
	758 [label="Так вот откуда это взялось.",shape=box,color=red];
		758 -> 759;
	759 [label="Та-да! Я дала ему имя.",shape=box,color=blue];
		759 -> 760;
	760 [label="Вот она, худшая часть.",shape=box,color=blue];
		760 -> 761;
	761 [label="Никто теперь не называет это «синдромом Тестудо». Никто не называет это Техноцитом. Все просто говорят Техрот.",shape=box,color=blue];
		761 -> 762;
	762 [label="Я назвала вещь, которая съела этот город и пожирает меня изнутри, начиная с костей.",shape=box,color=blue];
		762 -> 763;
	763 [label="Update boolean EleanorHollTold",color=orange];
		763 -> 764;
		763 -> 765;
	764 [label="Играешь в глупые игры — получаешь глупые призы, так?",shape=box,color=red];
		764 -> 766;
	765 [label="Что в этом такого плохого? Название подходит.",shape=box,color=red];
		765 -> 778;
	766 [label="Прости. Почему-то я думала, ты поймёшь. Или хотя бы посочувствуешь.",shape=box,color=blue];
		766 -> 767;
	778 [label="+20 Chemistry",color=orange];
		778 -> 773;
	767 [label="Хотя в твоих словах есть правда. Это всё действительно глупая игра, не так ли",shape=box,color=blue];
		767 -> 768;
	773 [label="Никто не говорит о моей работе на министра Джереми Конистона и фальшивой помощи голодающим, или о скандале с удобрениями Ласло, или о чём-то подобном. Это почти не вызвало ажиотажа.",shape=box,color=blue];
		773 -> 774;
	768 [label="Мы просто кучка разлагающихся клоунов, застрявших на карусели, которая никогда не останавливается",shape=box,color=blue];
		768 -> 769;
	774 [label="А теперь я придумываю термин, который используют всё, и никто даже не знает, что я его придумала.",shape=box,color=blue];
		774 -> 775;
	769 [label="Подходите, подходите, посмотрите на удивительную женщину-горгону, единственную в своём роде, не подпускайте вашего ребёнка слишком близко, мадам, её сегодня не кормили",shape=box,color=blue];
		769 -> 771;
	775 [label="«Техрот»",shape=box,color=blue];
		775 -> 776;
	771 [label="+10 Chemistry",color=orange];
		771 -> 770;
	776 [label="Пусть напишут это слово на моём чёртовом надгробии.",shape=box,color=blue];
		776 -> 777;
	770 [label="Поговорим в другой раз. Нужно выпить.",shape=box,color=blue];
		770 -> 772;
	777 [label="Если у меня оно вообще будет.",shape=box,color=blue];
		777 -> 779;
	772 [label="Chat ends.",color=orange];
	779 [label="Chat ends.",color=orange];
}