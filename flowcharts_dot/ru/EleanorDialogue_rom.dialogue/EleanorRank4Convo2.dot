digraph {
	1521 [label="EleanorRank4Convo2 begins.",color=orange];
		1521 -> 1522;
	1522 [label="О Скиталец! О бродяга времени и пространства! Как желанно твоё присутствие на этом моем маленьком экране!",shape=box,color=blue];
		1522 -> 1523;
		1522 -> 1524;
	1523 [label="Привет, Элеонора.",shape=box,color=red];
		1523 -> 1526;
	1524 [label="Сейчас вернусь, Калимос снова играет со шнурами и может их оборв [Завершить]",shape=box,color=red];
		1524 -> 1525;
	1526 [label="Привет.",shape=box,color=blue];
		1526 -> 1527;
	1525 [label="Chat ends.",color=orange];
	1527 [label="Угадай, что.",shape=box,color=blue];
		1527 -> 1528;
		1527 -> 1529;
	1528 [label="У тебя есть вопрос о том, какова жизнь в будущем?",shape=box,color=red];
		1528 -> 1530;
	1529 [label="У тебя вырос хвост.",shape=box,color=red];
		1529 -> 1531;
	1530 [label="Тьфу. Я такая чертовски предсказуемая.",shape=box,color=blue];
		1530 -> 1533;
	1531 [label="... тебе бы это понравилось, не правда ли?",shape=box,color=blue];
		1531 -> 1532;
	1533 [label="Да, так и есть. Ещё один. Но это действительно большой вопрос, так что потерпи, ладно?",shape=box,color=blue];
		1533 -> 1534;
	1532 [label="Увы, нет. Мой зад не улучшился от добавления хвоста. Его нельзя улучшить, потому что он и так идеален.",shape=box,color=blue];
		1532 -> 1535;
	1534 [label="Я сделаю всё возможное.",shape=box,color=red];
		1534 -> 1536;
	1535 [label="Однако у меня есть к тебе вопрос.",shape=box,color=blue];
		1535 -> 1537;
	1536 [label="Хорошо. Отлично. Итак.",shape=box,color=blue];
		1536 -> 1537;
	1537 [label="Как устроены отношения в ваше время? Ну, это всё то же самое — «два или больше взрослых сходятся с разной степенью официальности»? Или есть всякие правила о том, кто с кем может быть?",shape=box,color=blue];
		1537 -> 1538;
		1537 -> 1539;
		1537 -> 1540;
	1538 [label="Это не то, что было предметом моего изучения когда-либо.",shape=box,color=red];
		1538 -> 1541;
	1539 [label="Это зависит от культуры.",shape=box,color=red];
		1539 -> 1542;
	1540 [label="… почему ты об этом спрашиваешь?",shape=box,color=red];
		1540 -> 1543;
	1541 [label="Боже мой.",shape=box,color=blue];
		1541 -> 1547;
	1542 [label="Правильно. Конечно.",shape=box,color=blue];
		1542 -> 1548;
	1543 [label="Check boolean EleanorEntrati",color=orange];
		1543 -> 1544 [label=true,color=green];
		1543 -> 1545 [label=false,color=brown];
	1547 [label="Я знала, что Дувири был изолирован, но я понятия не имела, что он был НАСТОЛЬКО изолирован.",shape=box,color=blue];
		1547 -> 1552;
	1548 [label="Позволь мне попробовать другой подход.",shape=box,color=blue];
		1548 -> 1550;
	1544 [label="Те двое на Деймосе, Отец и Мать. Они супружеская пара. Да, они гигантские заражённые бывшие орокинские кто-знает-что, но они очень явно и болезненно ЖЕНАТЫ, точно так же, как мои мама и папа.",shape=box,color=blue];
		1544 -> 1546;
	1545 [label="Из обрывков, которые я уловила из твоих мыслей, я всё ещё вижу стандартные пары людей. Людей, которые очень явно и болезненно ЖЕНАТЫ точно так же, как мои мама и папа.",shape=box,color=blue];
		1545 -> 1546;
	1552 [label="+15 Chemistry",color=orange];
		1552 -> 1549;
	1550 [label="Посмотрим...",shape=box,color=blue];
		1550 -> 1554;
	1546 [label="Так это было стандартом для Орокин?",shape=box,color=blue];
		1546 -> 1551;
	1549 [label="Мне искренне жаль, если я тебя расстроила своим вопросом.",shape=box,color=blue];
		1549 -> 1553;
	1554 [label="Хорошо. А там, откуда ты, было бы нормально, если бы человек состоял в отношениях, скажем, с Цефалоном?",shape=box,color=blue];
		1554 -> 1555;
		1554 -> 1556;
	1551 [label="Орокин обожали правила и табу. Они любили иерархию. Отношения не могли пересекать социальные границы. Например, Дакс не мог быть с орокинским аристократом.",shape=box,color=red];
		1551 -> 1554;
	1553 [label="Chat ends.",color=orange];
	1555 [label="Можно попытаться притащить Ордиса сюда во времени, если ты хочешь попытаться выяснить...",shape=box,color=red];
		1555 -> 1557;
	1556 [label="… Я о таком не знаю, как и то, будет ли это работать.",shape=box,color=red];
		1556 -> 1560;
	1557 [label="Я пытаюсь задать ТЕОРЕТИЧЕСКИЙ вопрос!",shape=box,color=blue];
		1557 -> 1558;
	1560 [label="Черт. Дай-ка я попробую ещё раз.",shape=box,color=blue];
		1560 -> 1561;
	1558 [label="Я не горю желанием тереться об твоего стеклянного приятеля, каким бы очаровательным он ни был.",shape=box,color=blue];
		1558 -> 1559;
	1561 [label="Хорошо, представим кого-то из твоего времени — женщину, опасную и сильную. Например, как Майор Русалка, только без демонического вселения.",shape=box,color=blue];
		1561 -> 1562;
		1561 -> 1563;
	1559 [label="Я пытаюсь, но не могу, спросить тебя о ДИСБАЛАНСЕ СИЛЫ",shape=box,color=blue];
		1559 -> 1561;
	1562 [label="Снайпер Гринир?",shape=box,color=red];
		1562 -> 1564;
	1563 [label="Дакс?",shape=box,color=red];
		1563 -> 1565;
	1564 [label="Ладно. Допустим, есть снайперша Гринир, и она влюбляется в человека. И это взаимно. Несчастные влюблённые. Отчаянно трагично. Могут ли они быть вместе?",shape=box,color=blue];
		1564 -> 1566;
		1564 -> 1567;
		1564 -> 1568;
		1564 -> 1569;
	1565 [label="Ладно. Допустим, есть солдатка Дакс, и она влюбляется в человека. И это взаимно. Несчастные влюблённые. Отчаянно трагично. Могут ли они быть вместе?",shape=box,color=blue];
		1565 -> 1566;
		1565 -> 1567;
		1565 -> 1568;
		1565 -> 1569;
	1566 [label="Если бы они оба этого хотели, то, конечно.",shape=box,color=red];
		1566 -> 1570;
	1567 [label="Почему нет?",shape=box,color=red];
		1567 -> 1570;
	1568 [label="Хотелось бы мне посмотреть, как кто-нибудь попытается их остановить.",shape=box,color=red];
		1568 -> 1570;
	1569 [label="Да, но это будет сложно.",shape=box,color=red];
		1569 -> 1576;
	1570 [label="Я тут сама себя запутываю.",shape=box,color=blue];
		1570 -> 1572;
	1576 [label="+5 Chemistry",color=orange];
		1576 -> 1571;
	1572 [label="Это нормально у вас, когда люди заводят отношения с партнёрами, которые гораздо сильнее и опаснее их самих? Как в «Гамбли и носках дракона», где эльфийский принц в итоге женится на гиганте?",shape=box,color=blue];
		1572 -> 1574;
	1571 [label="Спасибо.",shape=box,color=blue];
		1571 -> 1573;
	1574 [label="…ты ведь не понимаешь, о чем я говорю, да?",shape=box,color=blue];
		1574 -> 1578;
		1574 -> 1579;
	1573 [label="Вопрос: могут ли два человека с совершенно разным телосложением и уровнем смертоносности быть в отношениях? Ответ: да.",shape=box,color=blue];
		1573 -> 1575;
	1578 [label="На самом деле, я думаю, что так и есть.",shape=box,color=red];
		1578 -> 1582;
	1579 [label="На самом деле нет.",shape=box,color=red];
		1579 -> 1580;
	1575 [label="Это всё, что мне надо было знать.",shape=box,color=blue];
		1575 -> 1577;
	1582 [label="Я не хочу портить тебе день. Извини.",shape=box,color=blue];
		1582 -> 1583;
	1580 [label="Мне лучше остановиться. Я рискую выставить себя полной идиоткой.",shape=box,color=blue];
		1580 -> 1581;
	1577 [label="Chat ends.",color=orange];
	1583 [label="Могу ли я позволить себе жалеть себя?",shape=box,color=blue];
		1583 -> 1584;
		1583 -> 1585;
	1581 [label="Chat ends.",color=orange];
	1584 [label="Выкладывай всё.",shape=box,color=red];
		1584 -> 1587;
	1585 [label="Мне некогда, извини. [Завершить]",shape=box,color=red];
		1585 -> 1586;
	1587 [label="Я НЕ говорю, что моя жизнь бессмысленна, если мне не с кем её разделить.",shape=box,color=blue];
		1587 -> 1588;
	1586 [label="Chat ends.",color=orange];
	1588 [label="Меня НЕ определяет то, кого я выбираю любить",shape=box,color=blue];
		1588 -> 1589;
	1589 [label="Я самодостаточна",shape=box,color=blue];
		1589 -> 1590;
	1590 [label="НО КАК Я ВООБЩЕ МОГУ ДАЖЕ ПОДУМАТЬ О ВОЗМОЖНОСТИ ОТНОШЕНИЙ, ЕСЛИ Я БУКВАЛЬНО МОГУ СЛУЧАЙНО УБИТЬ ЧЕЛОВЕКА, ЕСЛИ СЛИШКОМ УВЛЕКУСЬ?!",shape=box,color=blue];
		1590 -> 1591;
	1591 [label="Добро пожаловать в мир Элеоноры и её похотливой дилеммой богомола.",shape=box,color=blue];
		1591 -> 1592;
	1592 [label="Если я когда-нибудь найду этого ублюдка из Энтрати, я превращу его яйца в серьги. Если у него вообще есть яйца.",shape=box,color=blue];
		1592 -> 1593;
		1592 -> 1594;
	1593 [label="В Гексе всегда можно встречаться с кем-то другим.",shape=box,color=red];
		1593 -> 1595;
	1594 [label="Подожди. Ты одинока, потому что боишься причинить кому-то боль?",shape=box,color=red];
		1594 -> 1596;
	1595 [label="О СОЛ",shape=box,color=blue];
		1595 -> 1597;
	1596 [label="Да.",shape=box,color=blue];
		1596 -> 1601;
	1597 [label="Я БУКВАЛЬНО КУСАЮ СЕБЯ ЗА ЯЗЫК, ЧТОБЫ НЕ РАСХОХОТАТЬСЯ!",shape=box,color=blue];
		1597 -> 1598;
	1601 [label="Ты знаешь, кто я, лучше, чем я сама, мне кажется. Я - протофрейм. Я частично трансформированная боевая машина, и с каждым днём это ощущается всё меньше как «частично».",shape=box,color=blue];
		1601 -> 1602;
	1598 [label="Единственная из этой четвёрки, кого я вообще могла бы РАССМОТРЕТЬ для отношений, — это Аои, и то это сложно из-за Артура.",shape=box,color=blue];
		1598 -> 1599;
	1602 [label="Кто бы ни создал бедную «Никс», он проектировал убийцу. Теперь это я. Эффективная. Смертоносная. Такая же уютная, как противопехотная мина.",shape=box,color=blue];
		1602 -> 1603;
	1599 [label="Благослови тебя за такое предложение, но нет, даже через миллион лет.",shape=box,color=blue];
		1599 -> 1600;
	1603 [label="Всё это здорово для работы, но на офисной вечеринке кто поцелует ходячую смертельную ловушку под омелой?",shape=box,color=blue];
		1603 -> 1604;
		1603 -> 1606;
	1600 [label="Chat ends.",color=orange];
	1604 [label="Этот случайный вред, о котором ты беспокоишься. Это когда-нибудь происходило? Ты когда-нибудь причиняла боль тому, с кем была?",shape=box,color=red];
		1604 -> 1605;
	1606 [label="Ну, по крайней мере, хорошая новость в том, что если произойдёт несчастный случай, в Хёльвании после сброса никто не остаётся мёртвым...",shape=box,color=red];
		1606 -> 1607;
	1605 [label="Нет, этого не произошло, потому что я, черт возьми, этого не допустила. Понятно?",shape=box,color=blue];
		1605 -> 1608;
	1607 [label="...",shape=box,color=blue];
		1607 -> 1609;
	1608 [label="Нет партнёров, нет жертв. Не стоит рисковать.",shape=box,color=blue];
		1608 -> 1610;
	1609 [label="Я об этом не подумала.",shape=box,color=blue];
		1609 -> 1611;
	1610 [label="Я бы предпочла быть одинокой, чем погрязнуть в чувстве вины, спасибо.",shape=box,color=blue];
		1610 -> 1612;
	1611 [label="Однако наши воспоминания сохраняются.",shape=box,color=blue];
		1611 -> 1613;
	1612 [label="Так ты была одинока после уколов Энтрати?",shape=box,color=red];
		1612 -> 1618;
	1613 [label="Я не думаю, что кто-то захочет состоять в отношениях с тем, кто однажды откусил ему голову, даже если потом всё станет лучше.",shape=box,color=blue];
		1613 -> 1614;
	1618 [label="+20 Chemistry",color=orange];
		1618 -> 1615;
	1614 [label="Луа плачет. Мне сейчас нужно выпить.",shape=box,color=blue];
		1614 -> 1620;
	1615 [label="Правильно. Я готова пойти на такой компромисс.",shape=box,color=blue];
		1615 -> 1616;
	1620 [label="Chat ends.",color=orange];
	1616 [label="Извини. Не могу сказать уверенно, что обсуждать это было хорошей идеей.",shape=box,color=blue];
		1616 -> 1617;
	1617 [label="Думаю, мне нужно побыть немного одной.",shape=box,color=blue];
		1617 -> 1619;
	1619 [label="Chat ends.",color=orange];
}