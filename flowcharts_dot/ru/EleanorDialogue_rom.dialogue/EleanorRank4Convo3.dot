digraph {
	1621 [label="EleanorRank4Convo3 begins.",color=orange];
		1621 -> 1622;
	1622 [label="Кажется, у меня получилось. Я прорвалась. Установила контакт.",shape=box,color=blue];
		1622 -> 1623;
	1623 [label="Ты там? Пожалуйста, будь там.",shape=box,color=blue];
		1623 -> 1624;
	1624 [label="Мне что, придётся делать это телепатически? О Боже. Пожалуйста, не сейчас.",shape=box,color=blue];
		1624 -> 1625;
		1624 -> 1626;
	1625 [label="Элеонора, помедленнее. Что происходит?",shape=box,color=red];
		1625 -> 1628;
	1626 [label="[Игнорировать]",shape=box,color=red];
		1626 -> 1627;
	1628 [label="Check boolean EleanorSister",color=orange];
		1628 -> 1640 [label=true,color=green];
		1628 -> 1629 [label=false,color=brown];
	1627 [label="Chat ends.",color=orange];
	1640 [label="Другая я. Та, что стала монахиней. Я пыталась с ней связаться.",shape=box,color=blue];
		1640 -> 1641;
	1629 [label="С тех пор как ты здесь, меня не переставал мучить один вопрос. Вопрос, на который, я думаю, я только что ответила. И, о Сол, я не знаю, что я наделала.",shape=box,color=blue];
		1629 -> 1630;
	1641 [label="Я только что это сделала.",shape=box,color=blue];
		1641 -> 1642;
	1630 [label="Начни с самого начала. Я не понимаю, о чём ты. Какой вопрос?",shape=box,color=red];
		1630 -> 1631;
	1642 [label="Конечно, это никогда не сработало бы, пока я оставалась в этом мире. Я уже являюсь «тем я» этого мира. Мне нужно было пройти через ревущий белый свет. Чёрную звёздную фугу. Перекрёсток костей-пиявок. Так можно попасть на другие стороны. В «может быть» и «могло бы быть».",shape=box,color=blue];
		1642 -> 1643;
	1631 [label="Ты! Вот этот чёртов вопрос. Ты существуешь не один раз, а дважды.",shape=box,color=blue];
		1631 -> 1632;
	1643 [label="Бездна! Я видела Бездну!",shape=box,color=blue];
		1643 -> 1644;
		1643 -> 1645;
	1632 [label="И если ты можешь существовать в другом мире, как другая версия себя, почему не могу я?",shape=box,color=blue];
		1632 -> 1633;
	1644 [label="Ты уверена... что не залезла в особый тайник Лэтти?",shape=box,color=red];
		1644 -> 1646;
	1645 [label="Это не должно быть возможным, Элеонора. Никто не попадает в Бездну, пока Альбрехт Энтрати не сделает этого. Это далеко в будущем от того места, где мы сейчас.",shape=box,color=red];
		1645 -> 1647;
	1633 [label="Где-то там, в ныне открытых огромных возможных вселенных, существует та версия меня, о которой я всегда задумывалась, не должна ли я стать ею.",shape=box,color=blue];
		1633 -> 1634;
	1646 [label="Скиталец, дорогуша, я восхищаюсь твоей способностью использовать юмор как способ справляться с трудностями, но прямо сейчас я совершенно серьёзна.",shape=box,color=blue];
		1646 -> 1648;
	1647 [label="Я вошла туда умом, а не телом. Вот в чём разница.",shape=box,color=blue];
		1647 -> 1650;
	1634 [label="Та, которая отвернулась от мира, чтобы стать монахиней.",shape=box,color=blue];
		1634 -> 1635;
	1648 [label="Я сделала то, что намеревалась сделать.",shape=box,color=blue];
		1648 -> 1649;
	1650 [label="Ой, голова болит, ой, ой, ой",shape=box,color=blue];
		1650 -> 1651;
	1635 [label="Где-то на вершине горы сидела апостольница Луа, вокруг неё клубились облака благовоний.",shape=box,color=blue];
		1635 -> 1636;
	1649 [label="Я не только увидела Бездну, я вошла в неё.",shape=box,color=blue];
		1649 -> 1650;
	1651 [label="Check boolean EleanorIndifference2",color=orange];
		1651 -> 1652 [label=true,color=green];
		1651 -> 1654 [label=true,color=green];
		1651 -> 1653 [label=false,color=brown];
		1651 -> 1654 [label=false,color=brown];
	1636 [label="Я пытаюсь связаться с ней. Пытаюсь дотянуться до неё сквозь Бездну.",shape=box,color=blue];
		1636 -> 1637;
	1652 [label="Если ты действительно вошла в Бездну, я не могу передать, какой опасности ты подвергала себя. Ты знаешь, что там творится, и всё равно просто бросилась в это?",shape=box,color=red];
		1652 -> 1655;
	1654 [label="Ты с ума сошла?!",shape=box,color=red];
		1654 -> 1657;
	1653 [label="Что ты видела? Что случилось?",shape=box,color=red];
		1653 -> 1656;
	1637 [label="Update boolean EleanorSister",color=orange];
		1637 -> 1638;
		1637 -> 1639;
	1655 [label="Так я и попала в Бездну в первый раз. Через ту память. Ужас был как дым, и сквозь дым была ВОРОТА. Если бы я не так испугалась, я бы увидела их ясно с самого начала.",shape=box,color=blue];
		1655 -> 1662;
	1657 [label="Ни капельки.",shape=box,color=blue];
		1657 -> 1659;
	1656 [label="Есть чувство, для которого нет слова. Ты смотришь на мир и просто ЗНАЕШЬ, что вся эта обычность — здания, машины, люди, работа, рутина — это только тонкая корка над бездонным ужасом. И если люди когда-нибудь поймут это, они начнут кричать и никогда не остановятся.",shape=box,color=blue];
		1656 -> 1658;
	1638 [label="О, нет.",shape=box,color=red];
		1638 -> 1641;
	1639 [label="И?..",shape=box,color=red];
		1639 -> 1641;
	1662 [label="Это было ошибкой. Безразличие забрала Русалку. Чёрт возьми, оно едва не забрала Альбрехта. Оно может легко забрать и тебя.",shape=box,color=red];
		1662 -> 1663;
	1659 [label="Просто послушай. Пожалуйста. И постарайся понять.",shape=box,color=blue];
		1659 -> 1664;
		1659 -> 1665;
	1658 [label="Я провалилась через эту корку.",shape=box,color=blue];
		1658 -> 1660;
	1663 [label="Оно пыталось. Я чувствовала это. Я знала, что оно проявляет любопытство, тянется ко мне.",shape=box,color=blue];
		1663 -> 1664;
		1663 -> 1665;
	1664 [label="Так, из бесконечного множества возможных миров, ты случайно оказалась в правильном?",shape=box,color=red];
		1664 -> 1666;
	1665 [label="Элеонора, Безразличие может принимать любой облик, какой захочет. Оно выглядело как Альбрехт, когда он впервые столкнулся с ним.",shape=box,color=red];
		1665 -> 1667;
	1660 [label="Это не было пустотой. С пустотой я бы справилась. Это продолжалось бесконечно, но это не был просто холодный космос. Там что-то было вместе со мной.",shape=box,color=blue];
		1660 -> 1661;
	1666 [label="Это нормально, что ты хочешь убедиться. Я знаю, это звучит безумно. Просто выслушай меня, ладно?",shape=box,color=blue];
		1666 -> 1668;
	1667 [label="Я думаю, оно почувствовало, чего ты хочешь, и приняло ту форму, которую ты надеялась увидеть.",shape=box,color=red];
		1667 -> 1668;
	1661 [label="Update boolean EleanorIndifference2",color=orange];
		1661 -> 1662;
	1668 [label="Я заключу с тобой сделку.",shape=box,color=blue];
		1668 -> 1669;
	1669 [label="Сначала дай мне закончить рассказ о том, что произошло.",shape=box,color=blue];
		1669 -> 1670;
	1670 [label="Когда я закончу, ты сможешь сама решить, было ли это Безразличие, играющее со мной, или нет. Обещаю, я приму твоё мнение всерьёз.",shape=box,color=blue];
		1670 -> 1671;
	1671 [label="По рукам?",shape=box,color=blue];
		1671 -> 1672;
		1671 -> 1673;
	1672 [label="По рукам.",shape=box,color=red];
		1672 -> 1682;
	1673 [label="Не могу поверить, что ты это сделала. Больше никогда так не поступай, Элеонора! Я НЕ МОГУ ПОТЕРЯТЬ ТЕБЯ ИЗ-ЗА ЭТОГО СОЗДАНИЯ!",shape=box,color=red];
		1673 -> 1674;
	1682 [label="Итак, как я и говорила, я нашла его.",shape=box,color=blue];
		1682 -> 1683;
	1674 [label="Прошу прощения?",shape=box,color=blue];
		1674 -> 1675;
	1683 [label="Я чувствовала, как Безразличие наблюдает. Чувствовала, как оно скривило лицо, словно одна из высохших пустынных мумий, и потянулось ко мне. Я протянула руку к нему, и оно вытянуло меня.",shape=box,color=blue];
		1683 -> 1684;
	1675 [label="Не знаю, что сказать. Я немного обеспокоена, потому что ты звучишь так расстроенно, но я не осознавала, что тебе так не всё равно.",shape=box,color=blue];
		1675 -> 1676;
	1684 [label="Она сидела в позе Лотоса в каком-то открытом святилище рядом с ямой, полной тлеющих углей. Была ночь. Луна тускло светила, едва пробиваясь сквозь плывущие облака.",shape=box,color=blue];
		1684 -> 1685;
	1676 [label="Я в порядке. Пожалуйста, не беспокойся обо мне.",shape=box,color=blue];
		1676 -> 1678;
	1685 [label="Она приложила палец к губам.",shape=box,color=blue];
		1685 -> 1686;
	1678 [label="+5 Chemistry",color=orange];
		1678 -> 1677;
	1686 [label="На секунду я почувствовала, как эта гигантская рука все ещё нащупывает меня. Затем она отпрянула, словно на один из её пальцев опустилась гильотина.",shape=box,color=blue];
		1686 -> 1687;
	1677 [label="Я ничего не могу обещать, но постараюсь больше тебя не пугать.",shape=box,color=blue];
		1677 -> 1679;
		1677 -> 1680;
	1687 [label="Трава шептала. Сверчки пели. Мы были одни.",shape=box,color=blue];
		1687 -> 1689;
	1679 [label="Хорошо... просто... Расскажи мне, что случилось.",shape=box,color=red];
		1679 -> 1682;
	1680 [label="Я не хочу в этом участвовать. [Завершить]",shape=box,color=red];
		1680 -> 1681;
	1689 [label="Все это звучит ужасно знакомо. А потом?",shape=box,color=red];
		1689 -> 1688;
	1681 [label="Chat ends.",color=orange];
	1688 [label="Мы сидели напротив друг друга у костра. Она не говорила, но позволила мне заглянуть в её разум, мягко и по-сестрински.",shape=box,color=blue];
		1688 -> 1690;
	1690 [label="Она была такой счастливой, абсолютно умиротворённой. Женщина на своём месте. Загрубевшие ступни, ясные глаза. Вдыхая огонь и впитывая свет луны.",shape=box,color=blue];
		1690 -> 1691;
		1690 -> 1692;
	1691 [label="То есть ты почувствовала, что это был бы правильный выбор для тебя?",shape=box,color=red];
		1691 -> 1693;
	1692 [label="Возникало ли у тебя искушение остаться?",shape=box,color=red];
		1692 -> 1693;
	1693 [label="Нет! Как раз наоборот!",shape=box,color=blue];
		1693 -> 1694;
	1694 [label="Мне не нужно было идти этим путём, потому что она уже прошла его. Разве ты не понимаешь? Я свободна теперь. Мне больше не нужно задаваться вопросом «а что, если», потому что уже есть сестра Элеонора. Она за меня. Я понятно объясняю?",shape=box,color=blue];
		1694 -> 1695;
	1695 [label="Вроде бы? Всё, что я хочу знать, — это помогло?",shape=box,color=red];
		1695 -> 1696;
	1696 [label="О да. Я никогда не была так уверена в том, что делать дальше.",shape=box,color=blue];
		1696 -> 1698;
	1698 [label="+15 Chemistry",color=orange];
		1698 -> 1697;
	1697 [label="Я собираюсь прожить жизнь, которую она мне дала, и прожить её на полную катушку.",shape=box,color=blue];
		1697 -> 1699;
	1699 [label="Chat ends.",color=orange];
}