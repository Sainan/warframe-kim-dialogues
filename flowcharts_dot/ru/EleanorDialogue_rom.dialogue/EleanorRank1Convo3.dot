	156 [label="Я чувствую себя загнанной в угол. Это что, интервью?",shape=box,color=red];
		156 -> 159;
	157 [label="Что она для меня “значит”?",shape=box,color=red];
		157 -> 160;
	158 [label="Никто на самом деле не знает, что такое Бездна. Это измерение, это энергетическое поле, это короткий путь через пространство, это убежище, где прятались Орокин…",shape=box,color=red];
		158 -> 161;
	159 [label="Извини. Привычка.",shape=box,color=blue];
		159 -> 162;
	160 [label="Да.",shape=box,color=blue];
		160 -> 163;
	161 [label="Хотя это всё действительно увлекательно, звучит слишком технически. Мне было интереснее, что она значит для тебя. Ты же, ну, живёшь и дышишь ей. Буквально.",shape=box,color=blue];
		161 -> 164;
		161 -> 165;
		161 -> 166;
	162 [label="Прости. Я больше не журналист, и ты — не история. Мне просто действительно интересно.",shape=box,color=blue];
		162 -> 164;
		162 -> 165;
		162 -> 166;
	163 [label="Сделай это личным.",shape=box,color=blue];
		163 -> 164;
		163 -> 165;
		163 -> 166;
	164 [label="Бездна даёт мне возможность творить невозможное. Проецировать энергетические лучи, становиться нематериальной, всё такое. В моём мире это то, что позволяет варфреймам делать то, что они делают.",shape=box,color=red];
		164 -> 201;
	165 [label="Бездна свела моих родителей с ума.",shape=box,color=red];
		165 -> 167;
	166 [label="Бездна была моим домом, я не знаю, как долго. Она подстраивалась под меня. Или мои действия её подстраивали, так или иначе. До сих пор неясно, что именно произошло.",shape=box,color=red];
		166 -> 169;
	201 [label="Подожди. Подожди.",shape=box,color=blue];
		201 -> 202;
	167 [label="Прости. Теперь я чувствую себя мерзавкой за свои вопросы.",shape=box,color=blue];
		167 -> 168;
	169 [label="Оох. Теперь я вся внимание.",shape=box,color=blue];
		169 -> 170;
	202 [label="Ты хочешь сказать, что Бездна — это двигатель чудес?",shape=box,color=blue];
		202 -> 203;
	168 [label="Они поправились?",shape=box,color=blue];
		168 -> 171;
	170 [label="Check boolean EleanorDuviri",color=orange];
		170 -> 172 [label=true,color=green];
		170 -> 174 [label=false,color=brown];
	203 [label="И я уже связана с ней?",shape=box,color=blue];
		203 -> 205;
	171 [label="У них не было шанса.",shape=box,color=red];
		171 -> 176;
	172 [label="Под формой ты имеешь в виду... Дувири? Башни, острова и летающих лошадей?",shape=box,color=blue];
		172 -> 178;
	174 [label="Какую форму она приняла?",shape=box,color=blue];
		174 -> 179;
	205 [label="Что ты имеешь в виду под \"связана\"?",shape=box,color=red];
		205 -> 204;
	176 [label="О, Сол. Это ужасно.",shape=box,color=blue];
		176 -> 177;
	178 [label="Да. Буквально детская сказка, воплощённая в жизнь.",shape=box,color=red];
		178 -> 182;
	179 [label="Была одна книга, которую я обожала. «Сказки Дувири». Истории о волшебном королевстве, которые на самом деле были про эмоции и уроки, которые они могут преподать.",shape=box,color=red];
		179 -> 180;
	204 [label="Я имею в виду, что я варфрейм. Или Протофрейм. Я как они.",shape=box,color=blue];
		204 -> 206;
	177 [label="Может, ты предпочтёшь не говорить об этом сейчас?",shape=box,color=blue];
		177 -> 175;
		177 -> 173;
	182 [label="И это было реально? Не казалось сном?",shape=box,color=blue];
		182 -> 189;
	180 [label="Бездна оживила её, и я смогла там жить. А потом она стала тюрьмой. Но это уже другая история.",shape=box,color=red];
		180 -> 181;
	206 [label="И теперь я могу делать такие вещи, как контроль разума. Или плавить лица.",shape=box,color=blue];
		206 -> 207;
	175 [label="Я в порядке.",shape=box,color=red];
		175 -> 186;
	173 [label="Да, я бы предпочла не говорить об этом. [Завершить]",shape=box,color=red];
		173 -> 183;
	189 [label="Нет, Элеонор, быть убитой каждое утро совсем не казалось сном. Я чувствовала каждую секунду.",shape=box,color=red];
		189 -> 190;
	181 [label="Update boolean EleanorDuviri",color=orange];
		181 -> 182;
	207 [label="И откуда такая сила взялась во МНЕ? Из Бездны?",shape=box,color=blue];
		207 -> 208;
	186 [label="Разлучать родителей с детьми. Настраивать одного против другого. Это не кажется мне случайностью.",shape=box,color=blue];
		186 -> 187;
	183 [label="В другой раз, значит.",shape=box,color=blue];
