		210 -> 211;
	191 [label="Да. В Бездне что-то есть. Это я точно знаю. Безразличие, Глаз без век, «Человек в стене». Когда я говорю, что Бездна сделала это, я имею в виду, что ОН это сделал.",shape=box,color=red];
		191 -> 193;
	197 [label="Слова, воплощённые в жизнь. Конкретная реальность, вызванная из ничего.",shape=box,color=blue];
		197 -> 215;
	211 [label="Сердце Деймоса поддерживает всю Изначальную Систему в ореоле энергии Бездны. Что-то вроде фона радиации. Всё, что использует энергию Бездны, зависит от Сердца.",shape=box,color=red];
		211 -> 212;
	193 [label="То есть они не одно и то же?",shape=box,color=blue];
