	2037 [label="У нас есть время, и никто из нас никуда не уйдёт, не так ли?",shape=box,color=blue];
		2037 -> 2039;
	2032 [label="Мне придётся отнестись к этому с должным вниманием. Чёрт возьми.",shape=box,color=blue];
