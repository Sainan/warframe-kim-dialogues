digraph {
	1953 [label="EleanorRank4Convo7 begins.",color=orange];
		1953 -> 1954;
	1954 [label="Я хотела тебя кое о чём спросить, но не уверена, как ты это воспримешь, так что, если я перегибаю палку, просто скажи.",shape=box,color=blue];
		1954 -> 1955;
	1955 [label="Окей.",shape=box,color=red];
		1955 -> 1956;
	1956 [label="Какими были твои родители?",shape=box,color=blue];
		1956 -> 1957;
		1956 -> 1958;
		1956 -> 1959;
		1956 -> 1960;
		1956 -> 1962;
	1957 [label="Это было так давно, что я едва могу вспомнить.",shape=box,color=red];
		1957 -> 1963;
	1958 [label="Добрые. Они старались обращаться со мной правильно.",shape=box,color=red];
		1958 -> 1965;
	1959 [label="Строгие. Они были главными и напоминали мне об этом.",shape=box,color=red];
		1959 -> 1967;
	1960 [label="Безнадёжные. С таким же успехом меня могли воспитать дикие кубрау.",shape=box,color=red];
		1960 -> 1972;
	1962 [label="Я... не могу про это говорить. Извини. [Завершить]",shape=box,color=red];
		1962 -> 1978;
	1963 [label="Извини. Я по глупости предположила, что раз твои воспоминания о Заримане столь ярки, ты сможешь вспомнить и своих родителей.",shape=box,color=blue];
		1963 -> 1964;
	1965 [label="Я рада и это заметно. Если ты не против того, что я так говорю.",shape=box,color=blue];
		1965 -> 1966;
	1967 [label="Я не думала, что у тебя было мягкое воспитание. Я полагаю, что колонистам нужно быть жёсткими.",shape=box,color=blue];
		1967 -> 1970;
	1972 [label="Ох, боже мой. Ну, как бы там ни было, это сделало из тебя чертовски порядочного человека.",shape=box,color=blue];
		1972 -> 1973;
	1978 [label="Нет, извини. Я не имела права спрашивать.",shape=box,color=blue];
		1978 -> 1979;
	1964 [label="Я забыла, сколько жизней ты прожил.",shape=box,color=blue];
		1964 -> 1968;
	1966 [label="В тебе горит тёплый огонёк доброты, и мне было интересно, кто помог его разжечь.",shape=box,color=blue];
		1966 -> 1969;
	1970 [label="Учитывая, что у власти находятся Орокин, удивительно, что кто-то оказался порядочным.",shape=box,color=blue];
		1970 -> 1971;
	1973 [label="Мне бы только хотелось, чтобы тебе было легче.",shape=box,color=blue];
		1973 -> 1974;
	1979 [label="Chat ends.",color=orange];
	1968 [label="Update boolean DrifterParentsUnknown",color=orange];
		1968 -> 1980;
	1969 [label="Update boolean DrifterParentsKind",color=orange];
		1969 -> 1980;
	1971 [label="Update boolean DrifterParentsStrict",color=orange];
		1971 -> 1980;
	1974 [label="Update boolean DrifterParentsUseless",color=orange];
		1974 -> 1980;
	1980 [label="Почему ты спрашиваешь?",shape=box,color=red];
		1980 -> 1981;
	1981 [label="Я думала о своих родителях. Я часто так делаю, на самом деле. Сижу на заднице и думаю, что бы подумали мама и папа о том, как сложилась судьба их детей.",shape=box,color=blue];
		1981 -> 1982;
		1981 -> 1983;
	1982 [label="Какими они были?",shape=box,color=red];
		1982 -> 1984;
	1983 [label="Какими они были родителями?",shape=box,color=red];
		1983 -> 1985;
	1984 [label="Как люди они были совершенно несовместимы, а это значит, что их отношения были такими, что первые несколько лет пылали ярко и горячо, а затем превращались в чёрную дыру, которая всё засасывала.",shape=box,color=blue];
		1984 -> 1986;
	1985 [label="Несовместимые — одним словом. Папа хотел, чтобы мы были самостоятельными, поэтому устраивал ситуации, чтобы это было необходимо. Оставлял нас в лесу с одним перочинным ножом — что-то в этом духе. А мама всегда приходила на помощь. Это было чёрт-те что.",shape=box,color=blue];
		1985 -> 1987;
	1986 [label="Папа — бывший военный. Весёлый, с морщинками вокруг глаз, говорит как диктор новостей, но внутри так сломан, что, если бы его поднять и потрясти, он бы звенел, как мешок с гравием. Его удивительно легко расстроить. Я иногда бросала слова, которые мне казались безобидными, а потом слышала, как он плачет в ванной.",shape=box,color=blue];
		1986 -> 1988;
	1987 [label="Мы с Артуром быстро научились стравливать их друг с другом. Ты же знаешь, какие они, дети.",shape=box,color=blue];
		1987 -> 1989;
	1988 [label="У маминой семьи было много денег, что означало, что у неё были хорошие связи. Она не пошла по пути вечеринок, вина, наркотиков и недельных загулов в квартирах Людстона. Это больше про тётю Дженис. Мама — это цветы, глиняные ёжики, книжки и всё, чтобы было миленько.",shape=box,color=blue];
		1988 -> 1990;
	1989 [label="Родители всегда стремятся компенсировать то, что, по их мнению, их собственные родители сделали неправильно, не так ли?",shape=box,color=blue];
		1989 -> 1990;
	1990 [label="Половина того, что ты говоришь, могло бы быть языком Бездны, но, кажется, я понимаю.",shape=box,color=red];
		1990 -> 1991;
	1991 [label="Ну, теперь они в разводе. Они ждали, пока мы выйдем из подросткового возраста, чтобы сделать это, из «соображений». Это было мило, не думаешь? Заставить нас жить в кровавом поле битвы дома, потому что детям нужна стабильность или что-то в этом роде.",shape=box,color=blue];
		1991 -> 1992;
	1992 [label="Вы все ещё на связи?",shape=box,color=red];
		1992 -> 1993;
	1993 [label="Иногда. Раньше мы возвращались домой на Солнцестояние. Теперь я скучаю. Украшение звёздного дерева, коронация Солнца, маленькие дети ходят от двери к двери, одетые как Три Аспекта Луа, запекание птицы… это сентиментально, но я искренне люблю это.",shape=box,color=blue];
		1993 -> 1994;
	1994 [label="У мамы и папы всегда был мирный договор на Солнцестояние, и они всегда его соблюдали. В удачный год им удавалось не нападать друг на друга до Третьего Дня, даже когда сливовый бренди лился рекой.",shape=box,color=blue];
		1994 -> 1995;
	1995 [label="Если ты ощущаешь, как тебя накрыла волна тоски по дому, то это была я. Извини.",shape=box,color=blue];
		1995 -> 1996;
	1996 [label="Я стараюсь держать сильные эмоции при себе, но иногда они просто закипают, как молоко в кастрюле, и всем достаётся. А потом идёт старый добрый KIM — круг извинений.",shape=box,color=blue];
		1996 -> 1997;
	1997 [label="Зачем поднимать эту тему сейчас?",shape=box,color=red];
		1997 -> 1998;
	1998 [label="Мне просто интересно, что они о тебе скажут. Если мы когда-нибудь выберемся отсюда, я бы хотела заскочить на ужин в честь Солнцестояния со своим другом, путешествующим во времени.",shape=box,color=blue];
		1998 -> 1999;
	1999 [label="Я думаю, тебе бы понравилось. Вы с папой и Артуром могли бы сидеть у огня и обмениваться военными историями, а мама могла бы осторожно спрашивать есть ли у тебя уже кто-то.",shape=box,color=blue];
		1999 -> 2000;
		1999 -> 2001;
		1999 -> 2002;
		1999 -> 2003;
	2000 [label="Думаю, они бы пришли от меня в ужас.",shape=box,color=red];
		2000 -> 2016;
	2001 [label="Ради тебя я буду вести себя как можно лучше.",shape=box,color=red];
		2001 -> 2017;
	2002 [label="Честно говоря, это звучит весело.",shape=box,color=red];
		2002 -> 2018;
	2003 [label="Свободна? Подожди, а я приду домой как партнёр?",shape=box,color=red];
		2003 -> 2007;
	2016 [label="+15 Chemistry",color=orange];
		2016 -> 2004;
	2017 [label="+15 Chemistry",color=orange];
		2017 -> 2005;
	2018 [label="+15 Chemistry",color=orange];
		2018 -> 2006;
	2007 [label="Эм.",shape=box,color=blue];
		2007 -> 2011;
	2004 [label="ХА! Это только заставляет меня хотеть сделать это ещё больше.",shape=box,color=blue];
		2004 -> 2008;
	2005 [label="Это так мило с твоей стороны!",shape=box,color=blue];
		2005 -> 2009;
	2006 [label="О, боги, давай сделаем это. Если у нас когда-нибудь появится шанс, мы сделаем это реальностью.",shape=box,color=blue];
		2006 -> 2010;
	2011 [label="«Вот так поворот», — сказала она, обмахиваясь веером.",shape=box,color=blue];
		2011 -> 2015;
	2008 [label="Я прямо вижу, как папа вежливо спрашивает: «Так это всегда была смерть через пронзание, или они пытались как-то разнообразить?»",shape=box,color=blue];
		2008 -> 2012;
	2009 [label="... Мне стоит отпустить эту мечту, прежде чем пытаться её воплотить. Мы здесь, это сейчас, и война всё ещё идёт.",shape=box,color=blue];
		2009 -> 2013;
	2010 [label="Спасибо.",shape=box,color=blue];
		2010 -> 2014;
	2015 [label="А ты этого ХОЧЕШЬ?",shape=box,color=blue];
		2015 -> 2022;
		2015 -> 2023;
		2015 -> 2024;
	2012 [label="Я буду мечтать об этом. Спасибо.",shape=box,color=blue];
		2012 -> 2019;
	2013 [label="Спасибо за прекрасную мечту.",shape=box,color=blue];
		2013 -> 2020;
	2014 [label="Теперь мне нужно вставать с постели по утрам ради ещё одной вещи.",shape=box,color=blue];
		2014 -> 2021;
	2022 [label="Честно говоря? Да.",shape=box,color=red];
		2022 -> 2033;
	2023 [label="Нет. Я просто не совсем понимаю, что ты себе представляешь.",shape=box,color=red];
		2023 -> 2027;
	2024 [label="Эм… могу ли я ответить тебе по этому поводу?",shape=box,color=red];
		2024 -> 2038;
	2019 [label="Chat ends.",color=orange];
	2020 [label="Chat ends.",color=orange];
	2021 [label="Chat ends.",color=orange];
	2033 [label="+20 Chemistry",color=orange];
		2033 -> 2025;
	2027 [label="Ясно.",shape=box,color=blue];
		2027 -> 2028;
	2038 [label="+5 Chemistry",color=orange];
		2038 -> 2029;
	2025 [label="Ты совершенно невыносимый человек.",shape=box,color=blue];
		2025 -> 2026;
	2028 [label="Извини.",shape=box,color=blue];
		2028 -> 2035;
	2029 [label="Да.",shape=box,color=blue];
		2029 -> 2030;
	2026 [label="Я пытаюсь завести совершенно невинный разговор о родителях, без каких-либо скрытых мотивов, а теперь ты просто сбиваешь меня с ног.",shape=box,color=blue];
		2026 -> 2031;
	2035 [label="Моя ошибка.",shape=box,color=blue];
		2035 -> 2036;
