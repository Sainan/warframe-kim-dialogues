		j3117372942 -> j1870250618;
	j1870250618 [label="Я что, похожа на минное поле?",shape=box,color=blue];
		j1870250618 -> j3157320232;
	j3157320232 [label="Потому что Кайя говорит, что я такая. И у меня был один из тех «о, дерьмо» моментов, когда, оглядываясь на все разговоры, которые ты провела с кем-то, ты вдруг видишь себя в новом свете.",shape=box,color=blue];
		j3157320232 -> j1119440999;
		j3157320232 -> j3270986005;
		j3157320232 -> j1915551179;
	j1119440999 [label="Нет, ты не минное поле.",shape=box,color=red];
		j1119440999 -> j3201584925;
	j3270986005 [label="Кажется, я понимаю, что она имела в виду, да. Прости, но она права.",shape=box,color=red];
		j3270986005 -> j1629420869;
	j1915551179 [label="Подожди, Кайя это сказала?",shape=box,color=red];
		j1915551179 -> j3998086043;
	j3201584925 [label="+5 Chemistry",color=orange];
		j3201584925 -> j1084328920;
	j1629420869 [label="ох.",shape=box,color=blue];
		j1629420869 -> j3328784975;
		j1629420869 -> j4270797037;
	j3998086043 [label="Да. Она просто сболтнула это в середине нашего разговора. «Ты крутая, но ты — минное поле. Я никогда не знаю, как ты на что-то отреагируешь.»",shape=box,color=blue];
		j3998086043 -> j1119440999;
		j3998086043 -> j3270986005;
	j1084328920 [label="Рада это слышать. Спасибо.",shape=box,color=blue];
		j1084328920 -> j1528046506;
	j3328784975 [label="Я рада, что Кайя тебя предупредила. Я говорила здесь вещи, которые считала безобидными, а ты реагируешь так, будто я поджигала твои волосы.",shape=box,color=red];
		j3328784975 -> j2812668274;
		j3328784975 -> j3418783679;
	j4270797037 [label="Твои реакции иногда бывают действительно экстремальными. Они непропорциональны тому, о чём тебе рассказывают.",shape=box,color=red];
		j4270797037 -> j3418783679;
		j4270797037 -> j2812668274;
	j1528046506 [label="Подростки, да?",shape=box,color=blue];
		j1528046506 -> "Chat ends.";
	j2812668274 [label="Это как будто ты сразу переходишь к худшей из возможных интерпретаций того, что я могла иметь в виду.",shape=box,color=red];
		j2812668274 -> j1149153716;
	j3418783679 [label="Иногда ты просто полностью уходишь от разговора, и у меня даже нет шанса объясниться.",shape=box,color=red];
		j3418783679 -> j1149153716;
	j1149153716 [label="Что ж.",shape=box,color=blue];
		j1149153716 -> j1438235532;
	j1438235532 [label="Прямо сейчас мне хочется выйти из системы и больше никогда не использовать KIM.",shape=box,color=blue];
		j1438235532 -> j3249546818;
		j1438235532 -> j2627759627;
	j3249546818 [label="Может быть, тебе стоит подумать над тем, что ты только что сказала?",shape=box,color=red];
		j3249546818 -> j1331364824;
	j2627759627 [label="Вот так. Бум. Минное поле.",shape=box,color=red];
		j2627759627 -> j3711247587;
		j2627759627 -> j1331364824;
	j1331364824 [label="Разве ты не видишь этого?",shape=box,color=red];
		j1331364824 -> j1005607986;
	j3711247587 [label="Я думаю, тебе нужно время, чтобы обдумать это. [Завершить.]",shape=box,color=red];
		j3711247587 -> "Chat ends.";
	j1005607986 [label="Ладно. Ладно. Выслушай меня.",shape=box,color=blue];
		j1005607986 -> j3082029798;
