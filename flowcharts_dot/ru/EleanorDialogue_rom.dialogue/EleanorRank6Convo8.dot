	"EleanorRank6Convo8 begins." [color=orange];
		"EleanorRank6Convo8 begins." -> j4268666741;
	j4268666741 [label="У тебя есть минутка? Я немного расстроена по поводу кое-чего, и мне не помешало бы дружеское плечо. Или, может быть, небольшое замечание. Я пока не уверена.",shape=box,color=blue];
