		3222 -> 3225;
		3222 -> 3226;
	3223 [label="Да. Она просто сболтнула это в середине нашего разговора. «Ты крутая, но ты — минное поле. Я никогда не знаю, как ты на что-то отреагируешь.»",shape=box,color=blue];
		3223 -> 3218;
