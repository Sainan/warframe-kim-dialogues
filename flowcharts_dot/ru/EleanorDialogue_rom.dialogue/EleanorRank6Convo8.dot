		3216 -> 3217;
	3217 [label="Потому что Кайя говорит, что я такая. И у меня был один из тех «о, дерьмо» моментов, когда, оглядываясь на все разговоры, которые ты провела с кем-то, ты вдруг видишь себя в новом свете.",shape=box,color=blue];
		3217 -> 3218;
