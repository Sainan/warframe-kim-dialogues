	3224 [label="Рада это слышать. Спасибо.",shape=box,color=blue];
		3224 -> 3227;
	3225 [label="Я рада, что Кайя тебя предупредила. Я говорила здесь вещи, которые считала безобидными, а ты реагируешь так, будто я поджигала твои волосы.",shape=box,color=red];
		3225 -> 3228;
		3225 -> 3229;
	3226 [label="Твои реакции иногда бывают действительно экстремальными. Они непропорциональны тому, о чём тебе рассказывают.",shape=box,color=red];
		3226 -> 3229;
