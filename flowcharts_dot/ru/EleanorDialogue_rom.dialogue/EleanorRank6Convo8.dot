	j1294831200 [label="Поэтому имей это в виду:",shape=box,color=blue];
		j1294831200 -> j73146849;
	j73146849 [label="Я телепатка. Никогда не хотела ей быть. Но это так. Я читаю мысли.",shape=box,color=blue];
		j73146849 -> j1041324667;
	j1041324667 [label="Если мы говорим лично, у меня есть все возможные подсказки о том, что ты чувствуешь",shape=box,color=blue];
		j1041324667 -> j1783874820;
	j1783874820 [label="выражение, язык тела, и эй, иногда даже МЫСЛИ, потому что, как я уже сказала, ТЕЛЕПАТКА",shape=box,color=blue];
		j1783874820 -> j705232924;
	j705232924 [label="но здесь, на KIM, мне приходится угадывать, и у меня нет подсказок",shape=box,color=blue];
		j705232924 -> j822697937;
	j822697937 [label="и да, иногда я действую инстинктивно.",shape=box,color=blue];
