		j2871303644 -> j2175847177;
	j2175847177 [label="(глубокий вдох, сядь прямо, соберись, Элеонора)",shape=box,color=blue];
		j2175847177 -> j1688623939;
	j1688623939 [label="Я постараюсь изо всех сил не быть минным полем в будущем.",shape=box,color=blue];
