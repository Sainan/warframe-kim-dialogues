digraph {
	2175 [label="EleanorRank5Convo2 begins.",color=orange];
		2175 -> 2176;
	2176 [label="Точно. Я спокойна и готова, как никогда.",shape=box,color=blue];
		2176 -> 2177;
	2177 [label="Могу ли я поговорить с тобой о Кристофере?",shape=box,color=blue];
		2177 -> 2178;
	2178 [label="Check boolean EleanorChristopher1",color=orange];
		2178 -> 2184 [label=true,color=green];
		2178 -> 2180 [label=true,color=green];
		2178 -> 2185 [label=true,color=green];
		2178 -> 2179 [label=false,color=brown];
		2178 -> 2185 [label=false,color=brown];
	2184 [label="Я слушаю.",shape=box,color=red];
		2184 -> 2186;
	2180 [label="Почему мне нужно знать о нём?",shape=box,color=red];
		2180 -> 2187;
	2185 [label="[Игнорировать]",shape=box,color=red];
		2185 -> 2181;
	2179 [label="Кто такой Кристофер?",shape=box,color=red];
		2179 -> 2182;
	2186 [label="Спасибо.",shape=box,color=blue];
		2186 -> 2188;
	2187 [label="Потому что он тот, кого я потеряла. Тот, кто был мне очень дорог.",shape=box,color=blue];
		2187 -> 2188;
	2181 [label="Chat ends.",color=orange];
	2182 [label="Лучший друг Артура. Мы были помолвлены. Я думала, что влюблена в него.",shape=box,color=blue];
		2182 -> 2183;
	2188 [label="Check boolean EleanorDating",color=orange];
		2188 -> 2189 [label=true,color=green];
		2188 -> 2190 [label=false,color=brown];
	2183 [label="Update boolean EleanorChristopher1",color=orange];
		2183 -> 2184;
		2183 -> 2180;
	2189 [label="Поскольку мы с тобой теперь стали намного ближе (во многих приятных отношениях), нужно знать наверняка, с кем ты вступаешь в отношения.",shape=box,color=blue];
		2189 -> 2191;
	2190 [label="Пожалуйста, поправь меня, если я ошибаюсь, но в последнее время я чувствую, что мы с тобой больше, чем просто товарищи по команде.",shape=box,color=blue];
		2190 -> 2193;
	2191 [label="Я видела, что происходит в твоей голове, но ты не знаешь, что происходит в моей.",shape=box,color=blue];
		2191 -> 2192;
	2193 [label="Check boolean EleanorConfession",color=orange];
		2193 -> 2194 [label=true,color=green];
		2193 -> 2195 [label=false,color=brown];
	2192 [label="Так что, пожалуйста, соберись с духом и прояви терпение.",shape=box,color=blue];
		2192 -> 2197;
	2194 [label="Ты ясно дала мне понять, что ты чувствуешь, и я это ценю.",shape=box,color=blue];
		2194 -> 2196;
	2195 [label="Мы определённо друзья. Может, даже больше. Но мы все ещё неуверенно ходим вокруг друг друга и ждём, когда другой сделает первый шаг.",shape=box,color=blue];
		2195 -> 2196;
	2197 [label="Я хочу рассказать тебе о Кристофере, потому что считаю, что ты заслуживаешь этого.",shape=box,color=blue];
		2197 -> 2198;
		2197 -> 2199;
	2196 [label="Ты мне очень нравишься. Я тебе доверяю. У тебя было много возможностей обращаться со мной как с уродом, как это делает Лэтти, и ты этого не делаешь. Не думай, что я не заметила.",shape=box,color=blue];
		2196 -> 2197;
	2198 [label="Давай.",shape=box,color=red];
		2198 -> 2202;
	2199 [label="Мне некогда сейчас, извини. [Завершить]",shape=box,color=red];
		2199 -> 2200;
	2202 [label="Он был старше Артура и меня на несколько лет. Я не помню времени, когда его не было рядом. Наши родители дружили, поэтому он всегда был дома.",shape=box,color=blue];
		2202 -> 2203;
	2200 [label="Есть время, чтобы прекратить разговор с другом. Это было не оно.",shape=box,color=blue];
		2200 -> 2201;
	2203 [label="Он играл в солдатиков с Артуром на трухлявых участках леса за поместьем. Кристофер был командиром, Артур — верным лейтенантом. Если они когда-нибудь разрешали мне играть, я должна была быть медсестрой. Ожидаемо.",shape=box,color=blue];
		2203 -> 2204;
	2201 [label="Chat ends.",color=orange];
	2204 [label="Хотела бы я, чтобы папа посмотрел на Артура, бросающегося на очередную гранату из шишек, отважно погибающего, спасая своего командира, и подумал: «Хм, моему мальчику начинает слишком нравиться эта армейская забава, может, мне стоит сказать ему, что получать пули не так уж и весело, как он думает».",shape=box,color=blue];
		2204 -> 2205;
		2204 -> 2206;
		2204 -> 2207;
	2205 [label="Думаешь, Артур послушал бы тебя, если бы он это сделал?",shape=box,color=red];
		2205 -> 2210;
	2206 [label="Я думаю, что всё прошло хорошо, если учесть все обстоятельства.",shape=box,color=red];
		2206 -> 2209;
	2207 [label="Но если бы Артур послушал, мы бы никогда не встретились. :)",shape=box,color=red];
		2207 -> 2208;
	2210 [label="Наверное, нет. Он бы просто увидел, что папа его проверяет.",shape=box,color=blue];
		2210 -> 2216;
	2209 [label="В некотором смысле, да.",shape=box,color=blue];
		2209 -> 2211;
	2208 [label="Да, то, что наши пути пересеклись, было редким благословением в моей жизни.",shape=box,color=blue];
		2208 -> 2212;
	2216 [label="В общем, лето за летом пролетали. Мы становились подростками. Всё было очень неловко, воняло, и гормоны шалили. Были вечеринки и экзамены. Кристофер уехал в колледж. Собака умерла, завели новую. Вставь монтаж здесь.",shape=box,color=blue];
		2216 -> 2217;
	2211 [label="Но я хотела рассказать тебе о тяжёлой утрате.",shape=box,color=blue];
		2211 -> 2215;
	2212 [label="Но позволь мне пожалеть, что это далось мне такой ценой.",shape=box,color=blue];
		2212 -> 2213;
	2217 [label="И вдруг однажды я зашла на кухню, увидела перед собой потрясающего молодого человека в форме и второй раз в жизни подумала: «Фууууу».",shape=box,color=blue];
		2217 -> 2218;
		2217 -> 2219;
	2215 [label="На самом деле не время искать положительные моменты.",shape=box,color=blue];
		2215 -> 2216;
	2213 [label="Особенно, если учесть, насколько глубоки мои раны.",shape=box,color=blue];
		2213 -> 2214;
	2218 [label="Извини, что это был за звук? Мне не понятно. :P",shape=box,color=red];
		2218 -> 2220;
	2219 [label="Кто был первым?",shape=box,color=red];
		2219 -> 2222;
	2214 [label="Chat ends.",color=orange];
	2220 [label="«Фуууу»?",shape=box,color=blue];
		2220 -> 2221;
	2222 [label="Мэнди Джеллико. Моя влюблённость. Она бросила школу, покрасила волосы, сделала пирсинг, тусовалась по городу в кожанке, курила сигареты и смотрела на всех как на полных идиотов, если кто-то подходил слишком близко. Я смотрела на неё, и чувствовала, как мои кости тают.",shape=box,color=blue];
		2222 -> 2223;
	2221 [label="Это традиционное британское выражение восхищения. Его следует произносить с низким рычанием, надутыми щеками.",shape=box,color=blue];
		2221 -> 2223;
	2223 [label="В любом случае. НЕ ВАЖНО.",shape=box,color=blue];
		2223 -> 2224;
	2224 [label="Итак, ты и Кристофер…",shape=box,color=red];
		2224 -> 2225;
	2225 [label="Да. Он был добрым. Красивым. Сильным. И легко выводимым на эмоции, что было большим плюсом. Но вот только он был одержим идеей поступить в армию.",shape=box,color=blue];
		2225 -> 2226;
	2226 [label="Мы не сходились во мнении по этому поводу. Для него это было призванием. Он был уверен, что будет там, помогая тем, кто в этом нуждается, и изменяя мир. Он поверил в этот весь мужской геройский образ, как и Артур.",shape=box,color=blue];
		2226 -> 2227;
	2227 [label="Check boolean EleanorHeroVirus",color=orange];
		2227 -> 2228 [label=true,color=green];
		2227 -> 2229 [label=true,color=green];
		2227 -> 2230 [label=true,color=green];
		2227 -> 2229 [label=false,color=brown];
		2227 -> 2230 [label=false,color=brown];
	2228 [label="Я знаю, как сильно ты ненавидишь тему героев. Вот почему?",shape=box,color=red];
		2228 -> 2231;
	2229 [label="Он был прав. Люди, готовые бороться за лучший мир, — единственное, что имеет значение.",shape=box,color=red];
		2229 -> 2233;
	2230 [label="Это привлекательная идея. Люди хотят помогать. Легко воспользоваться этим.",shape=box,color=red];
		2230 -> 2236;
	2231 [label="Да. Я ненавижу, что оно сделало с Кристофером, что оно до сих пор делает с Артуром, что оно делает с такими, как они.",shape=box,color=blue];
		2231 -> 2232;
	2233 [label="Ты можешь бороться за лучший мир не веря в чушь о героях!",shape=box,color=blue];
		2233 -> 2234;
	2236 [label="«Зачем тебе идти и убивать людей ради Принца, которому на тебя наплевать?» — я бы сказала ему. Он был бы обижен, потому что это не должно было быть связано с Службой Его Величества. Для него всё сводилось к тому, чтобы устранять вождей, которые накапливали продовольствие и заставляли своих политических заключённых работать в шахтах Рубедо, пока они не умирали от истощения.",shape=box,color=blue];
		2236 -> 2237;
	2232 [label="У меня нет ничего против морали. Боги знают, что у меня есть своя собственная. Но вся эта героическая повествовательная линия — вредная чушь.",shape=box,color=blue];
		2232 -> 2237;
	2234 [label="Суть Вируса Героя в том, что это вирус. ЕМУ НЕ ВАЖЕН ХОЗЯИН. Он убеждает тебя, что смерть ради идеи — это благородно и достойно, а не трагическая, кровавая трата.",shape=box,color=blue];
		2234 -> 2235;
	2237 [label="Я была уверена, что смогу отговорить Кристофера от службы в армии. Если не разговорами, то поцелуями.",shape=box,color=blue];
		2237 -> 2238;
		2237 -> 2239;
		2237 -> 2240;
		2237 -> 2241;
	2235 [label="Chat ends.",color=orange];
	2238 [label="Это как-то высокомерно с твоей стороны.",shape=box,color=red];
		2238 -> 2242;
	2239 [label="Я готовлюсь к «но».",shape=box,color=red];
		2239 -> 2244;
	2240 [label="Похоже, он уже принял решение.",shape=box,color=red];
		2240 -> 2247;
	2241 [label="...Заметка для себя: спорить с Элеонор...",shape=box,color=red];
		2241 -> 2248;
	2242 [label="Да, и?",shape=box,color=blue];
		2242 -> 2243;
	2244 [label="Мне обязательно это говорить?",shape=box,color=blue];
		2244 -> 2245;
	2247 [label="+10 Chemistry",color=orange];
		2247 -> 2246;
	2248 [label="... сейчас не время.",shape=box,color=blue];
		2248 -> 2249;
	2243 [label="Я пыталась спасти ему жизнь. Была готова сражаться настолько грязно, насколько потребуется.",shape=box,color=blue];
		2243 -> 2251;
	2245 [label="Я попалась в ту самую паутину, которую пыталась сплести.",shape=box,color=blue];
		2245 -> 2251;
	2246 [label="Точно. К тому моменту, конечно, было уже поздно. Я пошла на это, думая, что околдую его, но правда в том, что он околдовал меня.",shape=box,color=blue];
		2246 -> 2250;
	2249 [label="Мне это даётся непросто, так что, пожалуйста, выбирай момент получше.",shape=box,color=blue];
		2249 -> 2251;
	2251 [label="Я сказала ему, что беременна. Он предложил жениться. Глупый, прекрасный идиот.",shape=box,color=blue];
		2251 -> 2252;
	2250 [label="Прости. Я не смогу пройти через это, не заплакав, так что если буду отвечать медленно, ты хотя бы будешь знать почему.",shape=box,color=blue];
		2250 -> 2251;
	2252 [label="Ты была?",shape=box,color=red];
		2252 -> 2253;
	2253 [label="Нет. Но я думала, что беременна. Я не пыталась его обмануть, если ты об этом спрашиваешь.",shape=box,color=blue];
		2253 -> 2254;
	2254 [label="Артур буквально летал на пушистых облаках от счастья. Парень, которого он считал братом, собирался стать его шурином.",shape=box,color=blue];
		2254 -> 2255;
	2255 [label="Потом всё произошло быстро. Что-то про упреждающий удар. Границы и сдерживание, риск эскалации, чёртов моральный мандат. Кристофера отправляют воевать, Артур уже подписывает контракт, все парни уходят в Багровый Дозор, а моя мама всё ещё пытается рассадить гостей на свадьбе.",shape=box,color=blue];
		2255 -> 2256;
		2255 -> 2257;
	2256 [label="Так что же случилось?",shape=box,color=red];
		2256 -> 2258;
	2257 [label=" Ты в порядке, чтобы продолжать?",shape=box,color=red];
		2257 -> 2258;
	2258 [label="Они убили его. Те, кому мы якобы должны были помогать. Они взорвали его машину бомбой, сделанной из удобрений и строительных гвоздей.",shape=box,color=blue];
		2258 -> 2259;
	2259 [label="Я говорю себе: «По крайней мере, всё было быстро». «По крайней мере, он не мучился». Но, на самом деле, кто знает, может, он умер, крича, с гвоздями в глазах.",shape=box,color=blue];
		2259 -> 2260;
	2260 [label="Вот дерьмо",shape=box,color=blue];
		2260 -> 2261;
	2261 [label="Чёртово дерьмо",shape=box,color=blue];
		2261 -> 2262;
		2261 -> 2263;
	2262 [label="По крайней мере, он умер, делая то, что считал правильным…",shape=box,color=red];
		2262 -> 2264;
	2263 [label="Мне очень жаль...",shape=box,color=red];
		2263 -> 2266;
	2264 [label="Мне кажется, одна вещь, которую я сказала, прошла мимо твоих ушей.",shape=box,color=blue];
		2264 -> 2265;
	2266 [label="Я, конечно, плакала, но всё время думала: «Чего ты ожидала, ГЛУПАЯ девчонка? Ты же ЗНАЛА, на что шла, ты ЗНАЛА, что это случится».",shape=box,color=blue];
		2266 -> 2267;
	2265 [label="Меня не интересуют эти «по крайней мере...». Он умер ГЛУПОЙ смертью из-за ГЛУПОЙ причины.",shape=box,color=blue];
		2265 -> 2269;
	2267 [label="Когда я рассказываю тебе об этом таким образом, это просто похоже на банальную народную песню.",shape=box,color=blue];
		2267 -> 2268;
	2269 [label="Check boolean EleanorDating",color=orange];
		2269 -> 2270 [label=true,color=green];
		2269 -> 2271 [label=false,color=brown];
	2268 [label="Мой милый ушёл на войну, пой фол де рол де ди,  
О, нет, он погиб, буду скитаться по пустым долинам и больше никогда не выйду замуж.",shape=box,color=blue];
		2268 -> 2279;
	2270 [label="И если ты не слушаешь меня, когда я говорю об этом, то что ещё ты пропускаешь мимо ушей? Как бы ни было приятно всё это между нами, я... нет. Это было ошибкой.",shape=box,color=blue];
		2270 -> 2272;
	2271 [label="И если ты не слушаешь меня, когда я говорю об этом, то что ещё ты пропускаешь мимо ушей?",shape=box,color=blue];
		2271 -> 2273;
	2279 [label="Извини. Возьми себя в руки, Элеонора.",shape=box,color=blue];
		2279 -> 2280;
	2272 [label="Вся эта чёртова затея была ошибкой. Проехали.",shape=box,color=blue];
		2272 -> 2275;
	2273 [label="Update boolean EleanorNoDate",color=orange];
		2273 -> 2274;
	2280 [label="Я думаю, он отнёсся бы к тебе с симпатией.",shape=box,color=blue];
		2280 -> 2281;
	2275 [label="Update boolean IsDating",color=orange];
		2275 -> 2276;
	2274 [label="Chat ends.",color=orange];
	2281 [label="+10 Chemistry",color=orange];
		2281 -> 2282;
	2276 [label="Update boolean EleanorDating",color=orange];
		2276 -> 2277;
	2282 [label="Пойду приведу себя в порядок. Скоро снова поговорим.",shape=box,color=blue];
		2282 -> 2283;
	2277 [label="Update boolean EleanorNoDate",color=orange];
		2277 -> 2278;
	2283 [label="Update boolean EleanorChristopher2",color=orange];
		2283 -> 2284;
	2278 [label="Chat ends.",color=orange];
