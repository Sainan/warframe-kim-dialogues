digraph {
	808 [label="EleanorRank3Convo1 begins.",color=orange];
		808 -> 809;
		808 -> 810;
	809 [label="Эй, Элеонора, можно задать тебе вопрос о телепатии?",shape=box,color=red];
		809 -> 811;
	810 [label="Итак, каково это — иметь возможность заглядывать в головы людей?",shape=box,color=red];
		810 -> 813;
	811 [label="Всегда можно спрашивать, если делать это вежливо.",shape=box,color=blue];
		811 -> 812;
	813 [label="Прошу прощения?",shape=box,color=blue];
		813 -> 814;
	812 [label="Некоторым это даётся с большим трудом.",shape=box,color=blue];
		812 -> 817;
		812 -> 818;
	814 [label="Это то, что ты обо мне представляешь? Что я просто так нарушаю чужую частную жизнь?",shape=box,color=blue];
		814 -> 815;
	817 [label="Ты слышишь мысли людей без усилий? Или тебе всегда нужно приложить усилия, чтобы проникнуть в их голову?",shape=box,color=red];
		817 -> 819;
	818 [label="Это как выключатель? Или оно всегда «включено»?",shape=box,color=red];
		818 -> 819;
	815 [label="Если ты так обо мне думаешь, то, боюсь, нам не о чем разговаривать.",shape=box,color=blue];
		815 -> 816;
	819 [label="Да и то, и другое. Если я просто «слушаю», я могу уловить внутренние монологи и сильные эмоции.",shape=box,color=blue];
		819 -> 820;
	816 [label="Chat ends.",color=orange];
	820 [label="Самое сложное — отфильтровать ГРОМКИЕ вещи, которые я не хочу знать.",shape=box,color=blue];
		820 -> 821;
	821 [label="Я не всегда воспринимаю эмоции так, как будто они принадлежат кому-то другому. Чем менее вербальны они, тем труднее различить «их» и «меня».",shape=box,color=blue];
		821 -> 822;
	822 [label="Разрешишь углубиться в тему «слишком много информации»?",shape=box,color=blue];
		822 -> 823;
		822 -> 824;
		822 -> 825;
	823 [label="Ну, теперь я слишком любопытна, чтобы сказать нет...",shape=box,color=red];
		823 -> 827;
	824 [label="Разрешаю.",shape=box,color=red];
		824 -> 828;
	825 [label="Эм... может, в другой раз. [Завершить]",shape=box,color=red];
		825 -> 826;
	827 [label="Я восхищаюсь твоей смелостью.",shape=box,color=blue];
		827 -> 829;
	828 [label="Читай дальше на свой страх и риск.",shape=box,color=blue];
		828 -> 829;
	826 [label="Chat ends.",color=orange];
	829 [label="Недолго после того, как нам всем сделали прививки Энтрати, я подумала, что у меня вторичная инфекция мочевого пузыря. Дружище, я вскакивала с дивана и садилась обратно, как йо-йо. Даже Лэтти охотилась за клюквенным соком и минеральной водой для меня.",shape=box,color=blue];
		829 -> 830;
	830 [label="Оказалось, я просто чувствовала естественные биологические позывы шести человек. Моя нервная система автоматически решила, что они мои.",shape=box,color=blue];
		830 -> 831;
		830 -> 832;
	831 [label="Что было хуже? Узнать, что ты не катастрофически больна, или...",shape=box,color=red];
		831 -> 833;
	832 [label="Должно быть, было облегчением узнать правду.",shape=box,color=red];
		832 -> 834;
	833 [label="Ну, я КАТАСТРОФИЧЕСКИ больна. Давайте уж называть вещи своими именами. Но я лучше буду справляться с телепатией, чем с бесконечным циститом.",shape=box,color=blue];
		833 -> 835;
	834 [label="После этого случая я научилась строить стены вокруг своего разума. Иногда Лэтти находит лекарства, которые могут отключить всю телепатию во мне на несколько часов. У меня есть запас таких, но я их принимаю только тогда, когда мне действительно, очень нужно поспать.",shape=box,color=blue];
		834 -> 835;
	835 [label="Это такой полезный талант, в этом проблема. Артур считает его стратегическим активом.",shape=box,color=blue];
		835 -> 836;
		835 -> 837;
	836 [label="А как насчёт частной жизни людей? Это же плохо для морального духа?",shape=box,color=red];
		836 -> 838;
	837 [label="А если кто-то *не* хочет, чтобы его разум исследовали?",shape=box,color=red];
		837 -> 839;
	838 [label="Это чертовски плохо для морального духа.",shape=box,color=blue];
		838 -> 840;
	839 [label="Даже если я уверяю, что могу это контролировать, ты думаешь, они мне поверят?",shape=box,color=blue];
		839 -> 840;
	840 [label="Никто из нас не мягкий. Мы привыкли к суровым условиям. Это место — пятизвёздочный отель по сравнению с обычными британскими армейскими казармами.",shape=box,color=blue];
		840 -> 841;
	841 [label="Ты вместе принимаешь душ, вместе ешь и так далее. Привыкаешь друг к другу. Это необходимо.",shape=box,color=blue];
		841 -> 842;
	842 [label="Но, как сказал бы Артур, есть чёртова граница.",shape=box,color=blue];
		842 -> 843;
	843 [label="Так как ты с этим справляешься?",shape=box,color=red];
		843 -> 844;
	844 [label="Я просто не даю им знать, насколько много их внутренней жизни я слышу, вижу и чувствую. Я не лезу без приглашения, что бы там Лэтти ни думала.",shape=box,color=blue];
		844 -> 845;
	845 [label="Иногда кто-то из них думает что-то и сразу же думает: «Она слышала, как я это подумал?» Добрее дать им сомневаться. То, чего они не знают, не может им навредить.",shape=box,color=blue];
		845 -> 846;
		845 -> 847;
	846 [label="Ты подслушивала мои мысли?",shape=box,color=red];
		846 -> 848;
	847 [label="Итак... что ты узнала из моей головы?",shape=box,color=red];
		847 -> 848;
	848 [label="Как я уже сказала, я не собираюсь ничего подтверждать или отрицать.",shape=box,color=blue];
		848 -> 849;
	849 [label="Я должна сказать прямо сейчас, что есть ещё одна важная причина, почему я держу всё это при себе.",shape=box,color=blue];
		849 -> 851;
	851 [label="Продолжай…",shape=box,color=red];
		851 -> 850;
	850 [label="Итак, мы с Артуром. Мы на улицах, обыскиваем тайник Скальдры, а он серьёзно не в своей тарелке. Он плохо стреляет, водит, как пьяная утка в бамперных машинках, он даже не может нормально обращаться с мечом.",shape=box,color=blue];
		850 -> 852;
	852 [label="Естественно, я говорю ему собраться. Немедленно он начинает винить МЕНЯ. Он говорит, что я всегда веду себя так высокомерно, разве я не понимаю давления командования, если бы я хоть немного знала, с чем он сталкивается КАЖДЫЙ день, я бы сломалась, вся эта жалость к себе — чушь.",shape=box,color=blue];
		852 -> 853;
	853 [label="Check boolean EleanorHeroVirus",color=orange];
		853 -> 854 [label=true,color=green];
		853 -> 855 [label=false,color=brown];
	854 [label="Помнишь, я рассказывала тебе о Вирусе Героя?",shape=box,color=blue];
		854 -> 856;
	855 [label="У меня есть теория, которую я называю Вирусом Героя.",shape=box,color=blue];
		855 -> 858;
	856 [label="Терминальная стадия.",shape=box,color=blue];
		856 -> 857;
	858 [label="Мальчишки начинают думать, что истории, которыми их кормят, — это то, как на самом деле устроен мир. Они считают себя героями, а всё вокруг вращается вокруг них.",shape=box,color=blue];
		858 -> 859;
	857 [label="Всё всегда было связано с Артуром.",shape=box,color=blue];
		857 -> 861;
	859 [label="У Артура один из самых худших случаев Вируса Героя, которые я когда-либо видела.",shape=box,color=blue];
		859 -> 860;
	861 [label="Так что я отвечаю ему: «Ты ведь знаешь, что я могу понять, когда ты думаешь об Аои, верно?»",shape=box,color=blue];
		861 -> 862;
	860 [label="Update boolean EleanorHeroVirus",color=orange];
		860 -> 861;
	862 [label="Ай.",shape=box,color=red];
		862 -> 863;
	863 [label="Да.",shape=box,color=blue];
		863 -> 864;
	864 [label="Не самый гордый мой момент.",shape=box,color=blue];
		864 -> 865;
	865 [label="Даже если бы он не был моим братом, это был бы отвратительный поступок. Я больше никогда так не сделаю.",shape=box,color=blue];
		865 -> 866;
	866 [label="Как он отреагировал?",shape=box,color=red];
		866 -> 867;
	867 [label="… Мне не нравится, что ты хочешь это знать.",shape=box,color=blue];
		867 -> 868;
	868 [label="Теперь я думаю, что тебе нравится идея унижения Артура.",shape=box,color=blue];
		868 -> 869;
	869 [label="Пожалуйста, скажи, что это не так. Ты начинаешь мне нравиться и это то, на что я не смогу закрыть глаза.",shape=box,color=blue];
		869 -> 870;
		869 -> 871;
		869 -> 872;
	870 [label="Я спрашиваю, потому что мне нравится этот парень.",shape=box,color=red];
		870 -> 873;
	871 [label="Ох, это не то, что я имею в виду. Я просто хочу узнать, как кто-то вроде него реагирует на такое противостояние.",shape=box,color=red];
		871 -> 875;
	872 [label="Мне это нравится. Звучит так, будто Артур сам напрашивался.",shape=box,color=red];
		872 -> 877;
	873 [label="Ладно. Это понятно. Прости, что я сорвалась.",shape=box,color=blue];
		873 -> 874;
	875 [label="Я не просто столкнулась с ним. Я РАНИЛА его.",shape=box,color=blue];
		875 -> 876;
	877 [label="О, понимаю.",shape=box,color=blue];
		877 -> 878;
	874 [label="Он сломался. Я почувствовала себя ужасно.",shape=box,color=blue];
		874 -> 879;
	876 [label="Артур привык, что ему перечат. Посмотри хотя бы на Куинси!",shape=box,color=blue];
		876 -> 880;
	878 [label="Артур — заноза в заднице.",shape=box,color=blue];
		878 -> 881;
	879 [label="Я разрушила что-то важное между нами. Постой. Мне нужно кое-что рассказать, чтобы у тебя сложилась полная картина.",shape=box,color=blue];
		879 -> 885;
	880 [label="Но мы все знаем, что у Артура есть свои стены. Он ведёт себя так, будто его невозможно ранить.",shape=box,color=blue];
		880 -> 884;
	881 [label="Но когда я пытаюсь поговорить с тобой о чём-то, за что я чувствую вину...",shape=box,color=blue];
		881 -> 882;
	885 [label="Когда мы были маленькими, какие-то старшие мальчишки украли любимую игрушку Артура и бросили её на костёр в честь Солнцестояния.",shape=box,color=blue];
		885 -> 886;
	884 [label="Я могла почувствовать, насколько он был шокирован и сбит с толку. Он думал, что рядом со мной безопасно. Но теперь — нет.",shape=box,color=blue];
		884 -> 893;
	882 [label="Забудь.",shape=box,color=blue];
		882 -> 883;
	886 [label="Я до сих пор вижу, как он наклонился, а пластик телесного цвета пузырился и капал на его камуфляжные штаны.",shape=box,color=blue];
		886 -> 887;
		886 -> 888;
	893 [label="Check boolean DrifterSiblingYes",color=orange];
		893 -> 895 [label=true,color=green];
		893 -> 894 [label=false,color=brown];
	883 [label="Chat ends.",color=orange];
	887 [label="Не скучаю по детству.",shape=box,color=red];
		887 -> 889;
	888 [label="Да уж, детство.",shape=box,color=red];
		888 -> 889;
	895 [label="Я знаю, каково это — ранить брата или сестру. У меня... раньше была сестра.",shape=box,color=red];
		895 -> 897;
	894 [label="Check boolean DrifterSiblingNo",color=orange];
		894 -> 895 [label=true,color=green];
		894 -> 896 [label=true,color=green];
		894 -> 895 [label=false,color=brown];
		894 -> 896 [label=false,color=brown];
	889 [label="Мальчишки смеялись и говорили, что Артур должен быть счастлив. Его игрушка отправилась в Зал Героев на зимний праздник, как воины раньше. Я хотела их убить. Маленькие ублюдки.",shape=box,color=blue];
		889 -> 890;
	897 [label="Update boolean DrifterSiblingYes",color=orange];
		897 -> 898;
	896 [label="Похоже, ты сильно его ранила.",shape=box,color=red];
		896 -> 900;
	890 [label="Артур не хотел, чтобы мальчишки видели, как он плачет, и он не хотел плакать перед моим отцом, так что единственный человек, который остался, была я. Его хреновая старшая сестра.",shape=box,color=blue];
		890 -> 891;
	898 [label="Это ужасно, не так ли? Ты так привыкаешь к этому ритуалу — унижать друг друга, язвить и саркастично комментировать...",shape=box,color=blue];
		898 -> 899;
	900 [label="Да, я сделала это. Я извинилась, пообещала, что больше никогда не сделаю ничего подобного, но до сих пор чувствую себя дерьмово из-за этого.",shape=box,color=blue];
		900 -> 901;
	891 [label="Я рассказываю тебе об этом, потому что туда он вернулся, в своей голове. Он вспомнил, что чувствовал себя в безопасности, когда мог плакать рядом со мной, если ему это действительно НУЖНО было. А теперь?",shape=box,color=blue];
		891 -> 892;
	899 [label="Это почти утешает. А потом в какой-то день ты ранишь по-настоящему, и это уже не исправить.",shape=box,color=blue];
		899 -> 901;
	901 [label="Это нечестный бой.",shape=box,color=red];
		901 -> 902;
	892 [label="Теперь это больше не безопасно.",shape=box,color=blue];
		892 -> 893;
	902 [label="ДА.",shape=box,color=blue];
		902 -> 903;
	903 [label="Ты ПОНИМАЕШЬ. Мне это нравится! Нечестный бой.",shape=box,color=blue];
		903 -> 904;
	904 [label="Ты знаешь это чувство, когда споришь с кем-то, и когда всё уже закончилось, ты думаешь о том, что именно нужно было сказать?",shape=box,color=blue];
		904 -> 905;
	905 [label="У меня этого больше нет. У меня есть магическая кнопка «Я выигрываю». Всё, что мне нужно сделать, — это заглянуть в их разум, схватить то, чего они больше всего стыдятся, и ткнуть это им в лицо.",shape=box,color=blue];
		905 -> 906;
	906 [label="И я НЕ МОГУ так поступить, сколько бы я ни хотела. Потому что я должна быть «хорошим человеком».",shape=box,color=blue];
		906 -> 907;
		906 -> 908;
	907 [label="Дело не в попытке быть святым, Элеонора. Даже не в том, чтобы быть героем. Это о том, чтобы не быть подлым придурком.",shape=box,color=red];
		907 -> 909;
	908 [label="Мы все стараемся поступать правильно. Это действительно так сложно для тебя?",shape=box,color=red];
		908 -> 910;
	909 [label="У каждого из нас есть границы, которые мы не переступаем, и это одна из твоих. Я уважаю это.",shape=box,color=red];
		909 -> 912;
	910 [label="О боже. Это то, что я получаю за демонстрацию своих достоинств, верно?",shape=box,color=blue];
		910 -> 911;
	912 [label="Спасибо.",shape=box,color=blue];
		912 -> 913;
	911 [label="Прости. Я ожидала сочувствия. Но и проверка реальностью подойдёт.",shape=box,color=blue];
		911 -> 914;
	913 [label="Я не ищу сочувствия. Честно.",shape=box,color=blue];
		913 -> 915;
	914 [label="Это ведь не так, что только я одна должна держать свои способности под контролем, верно? Мы все как бомбы с часовым механизмом, которые могут взорваться.",shape=box,color=blue];
		914 -> 920;
	915 [label="Я просто хотела, чтобы кто-то ещё понял. Честно говоря, я немного поражена тем, насколько ты ДЕЙСТВИТЕЛЬНО понимаешь.",shape=box,color=blue];
		915 -> 916;
	920 [label="+10 Chemistry",color=orange];
		920 -> 919;
	916 [label="Тебе не обязательно было всё это выслушивать. Но я признательна тебе за это.",shape=box,color=blue];
		916 -> 917;
	919 [label="Ценю этот разговор.",shape=box,color=blue];
		919 -> 921;
	917 [label="У меня в голове полный цирк уродов. Думаю, ты можешь понять, почему я не вывешиваю приветственный коврик для незнакомцев.",shape=box,color=blue];
		917 -> 922;
	921 [label="Chat ends.",color=orange];
	922 [label="+20 Chemistry",color=orange];
		922 -> 918;
	918 [label="Я ожидаю, что люди будут убегать с криками. Ты не убежал. Пока. Интересно, почему. Спасибо. Ещё раз. За всё.",shape=box,color=blue];
		918 -> 923;
	923 [label="Chat ends.",color=orange];
}