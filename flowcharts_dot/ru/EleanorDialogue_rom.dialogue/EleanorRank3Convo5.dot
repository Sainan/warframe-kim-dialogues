digraph {
	1262 [label="EleanorRank3Convo5 begins.",color=orange];
		1262 -> 1263;
	1263 [label="Привет, Скиталец. Я расстроена.",shape=box,color=blue];
		1263 -> 1266;
		1263 -> 1264;
		1263 -> 1265;
	1266 [label="Что тебя расстроило?",shape=box,color=red];
		1266 -> 1268;
	1264 [label="Привет, расстроена. Я Скиталец.",shape=box,color=red];
		1264 -> 1269;
	1265 [label="Сейчас нет времени, извини. [Завершить]",shape=box,color=red];
		1265 -> 1267;
	1268 [label="Две вещи.",shape=box,color=blue];
		1268 -> 1273;
	1269 [label="В БУДУЩЕМ ТОЖЕ ЕСТЬ ПАПИНЫ ШУТКИ",shape=box,color=blue];
		1269 -> 1271;
	1267 [label="Chat ends.",color=orange];
	1273 [label="Я скучаю по вину. Я так давно не пила настоящего вина. Все вино в Хёльвании было реквизировано командованием Скальдры через несколько дней после начала эпидемии.",shape=box,color=blue];
		1273 -> 1274;
	1271 [label="+10 Chemistry",color=orange];
		1271 -> 1270;
	1274 [label="Куинси и Артур пытались приготовить тюремный самогон из фруктовых пакетиков с рационом, но те из нас, у кого ещё оставалось хоть немного достоинства, отказались. Редкий момент солидарности с Лэтти, надо сказать.",shape=box,color=blue];
		1274 -> 1275;
	1270 [label="Теперь я счастлива. Спасибо.",shape=box,color=blue];
		1270 -> 1272;
	1275 [label="Другая вещь, гораздо более значительная, — это будущее.",shape=box,color=blue];
		1275 -> 1276;
	1272 [label="Chat ends.",color=orange];
	1276 [label="Это не твоя вина, но... теперь, когда я увидела будущее твоими глазами, я чувствую себя так ужасно, что привычные способы справиться с этим больше не помогают.",shape=box,color=blue];
		1276 -> 1277;
		1276 -> 1278;
	1277 [label="Что я могу сделать, чтобы тебя подбодрить?",shape=box,color=red];
		1277 -> 1279;
	1278 [label="Обычные методы?",shape=box,color=red];
		1278 -> 1280;
	1279 [label="Не знаю. Может экзотический танец?",shape=box,color=blue];
		1279 -> 1281;
	1280 [label="Провести вечер с Амиром, слушая, как он с воодушевлением рассказывает о какой-нибудь серии комиксов или ретро-игре, на которой он сейчас зациклен.",shape=box,color=blue];
		1280 -> 1282;
	1281 [label="Описание смерти Балласа во всех мелких деталях?",shape=box,color=blue];
		1281 -> 1283;
	1282 [label="Окружу себя кристаллами и буду мысленно распевать мантры, пока Лэтти не вызовет экзорциста.",shape=box,color=blue];
		1282 -> 1284;
	1283 [label="Очень любезно с твоей стороны предложить это, но я думаю, что эту меланхолию придётся просто перетерпеть.",shape=box,color=blue];
		1283 -> 1286;
	1284 [label="Это совсем другая грусть. Она тянет меня вниз, как мокрое одеяло.",shape=box,color=blue];
		1284 -> 1288;
		1284 -> 1289;
	1286 [label="Может быть, я буду рисовать.",shape=box,color=blue];
		1286 -> 1285;
	1288 [label="1999 год в Хёльвании — это жёстко! Скальдра, Техрот, Бездна знает, что ещё. Будущее действительно выглядит настолько хуже?",shape=box,color=red];
		1288 -> 1290;
	1289 [label="Ой, да ладно... ты не из робкого десятка. Ты справишься. Здесь столько всего крутого.",shape=box,color=red];
		1289 -> 1291;
	1285 [label="+5 Chemistry",color=orange];
		1285 -> 1287;
	1290 [label="Слушай, я никогда особо не увлекалась научной фантастикой. У Артура был такой период, но он всегда больше любил суровые военные книги. Настоящие мужики-герои, правильные «истории для мальчиков», куча подтекста — ты, думаю, понимаешь, о чём я.",shape=box,color=blue];
		1290 -> 1292;
	1291 [label="Хорошо. Возьми меня за руку и проведи по улицам Хёльвании.",shape=box,color=blue];
		1291 -> 1293;
	1287 [label="Chat ends.",color=orange];
	1292 [label="Но я знала достаточно о научной фантастике, чтобы понимать: в далёком-далёком будущем мы должны были бы всё уладить. Всё должно быть блестящее и стерильное. Роботы выполняют всю тяжёлую работу, болезней нет, деньги никому не нужны, вокруг серебряные башни, голубые небеса и... сексуальные ящерицы.",shape=box,color=blue];
		1292 -> 1295;
		1292 -> 1296;
	1293 [label="Я знаю одно место, где можно взять пирожки из тёртой репы и посмотреть, как солнце садится над руинами школы.",shape=box,color=blue];
		1293 -> 1294;
	1295 [label="У нас есть роботы. Они выполняют большую часть тяжёлой работы.",shape=box,color=red];
		1295 -> 1298;
	1296 [label="Но то, о чем ты говоришь, это просто вымысел, верно? Так почему ты ожидаешь, что реальность будет соответствовать ему?",shape=box,color=red];
		1296 -> 1299;
	1294 [label="Позже мы сможем потягивать коктейли при свете горящего танка.",shape=box,color=blue];
		1294 -> 1297;
	1298 [label="Ну, ладно. За это ты получаешь очко.",shape=box,color=blue];
		1298 -> 1300;
	1299 [label="Фу. Я не… это сложно. Позвольте мне объяснить.",shape=box,color=blue];
		1299 -> 1301;
	1297 [label="Chat ends.",color=orange];
	1300 [label="Но облегчили ли эти роботы жизнь простым людям?",shape=box,color=blue];
		1300 -> 1303;
	1301 [label="Я не говорю, что ожидаю, что будущее будет похоже на детский комикс. Я просто имею в виду, что с ним был связан определённый оптимизм.",shape=box,color=blue];
		1301 -> 1302;
	1303 [label="Или они просто стали чем-то само собой разумеющимся?",shape=box,color=blue];
		1303 -> 1306;
		1303 -> 1307;
	1302 [label="Я думаю, мы все просто принимали как должное, что каким бы дерьмовым ни было положение дел сейчас, мы в конце концов всё наладим. Наша цивилизация должна развиваться. Мы начали с того, что колотили друг друга дубинками по голове, а спустя несколько тысяч лет научились решать разногласия без этого.",shape=box,color=blue];
		1302 -> 1304;
		1302 -> 1305;
	1306 [label="Ты привыкла видеть во всем худшее, не правда ли?",shape=box,color=red];
		1306 -> 1310;
	1307 [label="Ладно. Мы не избавились от эксплуатации, просто создав роботов.",shape=box,color=red];
		1307 -> 1311;
	1304 [label="Люди остаются людьми, как бы ни менялись технологии.",shape=box,color=red];
		1304 -> 1308;
	1305 [label="Извини, мы тебя подвели?",shape=box,color=red];
		1305 -> 1309;
	1310 [label="Точно.",shape=box,color=blue];
		1310 -> 1315;
	1311 [label="Точно. Вот это и разочаровывает.",shape=box,color=blue];
		1311 -> 1316;
	1308 [label="Точно. Ты прямо в точку — именно это я нахожу таким удручающим во всей этой ситуации.",shape=box,color=blue];
		1308 -> 1313;
	1309 [label="Именно так.",shape=box,color=blue];
		1309 -> 1313;
	1315 [label="Так ты понимаешь, что нужно изменить.",shape=box,color=blue];
		1315 -> 1317;
	1316 [label="Вы продвинутые, но вы должны были стать ещё и ПРОСВЕТЛЁННЫМИ.",shape=box,color=blue];
		1316 -> 1318;
	1313 [label="У вас под рукой была вся эта невероятная, почти магическая технология, и всё, что вы с ней сделали, — нашли новые способы эксплуатации друг друга. Наука сделала нас менее равными, а не более.",shape=box,color=blue];
		1313 -> 1312;
		1313 -> 1314;
	1317 [label="Chat ends.",color=orange];
	1318 [label="Спасибо, что терпишь меня. Я знаю, это много.",shape=box,color=blue];
		1318 -> 1320;
	1312 [label="Эм, напомню вежливо, что моего участия НИ В ЧЁМ из этого не было.",shape=box,color=red];
		1312 -> 1322;
	1314 [label="Я передам твою жалобу Орокин.",shape=box,color=red];
		1314 -> 1322;
	1320 [label="+15 Chemistry",color=orange];
		1320 -> 2837;
	1322 [label="О, боги, я не имею в виду тебя лично. Я имею в виду твою эпоху.",shape=box,color=blue];
		1322 -> 1323;
	2837 [label="Chat ends.",color=orange];
	1323 [label="Если уж на то пошло, вы пошли назад. Божественные короли во плоти! Из всех вещей, которые можно было бы изобрести заново, вы выбрали ИХ.",shape=box,color=blue];
		1323 -> 1324;
	1324 [label="Тэнно убили Орокин. Ты помнишь эту часть?",shape=box,color=red];
		1324 -> 1325;
	1325 [label="Конечно. Я помню ту часть, где эмоционально изломанные сироты убили бессмертную элиту. Мне просто безумно нравится эта часть. Если закрыть глаза, почти могу представить их крики.",shape=box,color=blue];
		1325 -> 1326;
		1325 -> 1327;
	1326 [label="Ладно. Будущее — это бардак. Можешь сосредоточиться на этом, если хочешь.",shape=box,color=red];
		1326 -> 1328;
	1327 [label="Это... это... то, в чем мне не хотелось бы признаваться людям.",shape=box,color=red];
		1327 -> 1329;
	1328 [label="Я на стороне тех людей, которые пытаются сделать жизнь лучше.",shape=box,color=red];
		1328 -> 1330;
	1329 [label="... ирония тоже устареет в будущем?",shape=box,color=blue];
		1329 -> 1331;
	1330 [label="+20 Chemistry",color=orange];
		1330 -> 1332;
	1331 [label="Chat ends.",color=orange];
	1332 [label="Chat ends.",color=orange];
}