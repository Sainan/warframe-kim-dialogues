digraph {
	2845 [label="EleanorRank6Convo2 begins.",color=orange];
		2845 -> 2846;
	2846 [label="Привет. Хочу поделится с тобой парой идей.",shape=box,color=blue];
		2846 -> 2847;
	2847 [label="Я тут подумала о Ночи дьявола. Я годами не наряжалась к ней, но листала один из комиксов Амира, и вдруг подумала:  подождите, я могла бы стать графиней! У меня к этому клыки и всё такое!",shape=box,color=blue];
		2847 -> 2848;
	2848 [label="Может, это слишком банально? Должна ли я быть Денди Дэмеджем?",shape=box,color=blue];
		2848 -> 2849;
		2848 -> 2850;
		2848 -> 2851;
	2849 [label="Кто такой Денди Дэмедж?",shape=box,color=red];
		2849 -> 2852;
	2850 [label="Ты всегда можешь переодеться в Лотос, если хочешь сбить людей с толку.",shape=box,color=red];
		2850 -> 2853;
	2851 [label="… тебе придётся объяснить мне, что такое Ночь Дьявола.",shape=box,color=red];
		2851 -> 2854;
	2852 [label="Ох, дружище.",shape=box,color=blue];
		2852 -> 2855;
	2853 [label="О, Боже, нет. Я видела её в твоей голове. Я не создана для этого.",shape=box,color=blue];
		2853 -> 2856;
	2854 [label="Ммм. Иногда я забываю, что твоей вины тут нету.",shape=box,color=blue];
		2854 -> 2857;
	2855 [label="Дэнди Дэмедж шёл, чтобы «Тэмпл и Потрошители» могли бежать. Он был кошмаром каждой матери и каждой подростковой катастрофой.",shape=box,color=blue];
		2855 -> 2858;
	2856 [label="И этот шлем. Это же шлем? Это часть её? Как она видит сквозь него?",shape=box,color=blue];
		2856 -> 2859;
	2857 [label="Ночь дьявола отмечает затухание влияния Сол на мир.",shape=box,color=blue];
		2857 -> 2860;
	2858 [label="Сложена как палочник, накрашена как королева немого кино. Рот как конфета. Тонкие полоски, кожа и собачья цепь. Скулы как бедра скелета.",shape=box,color=blue];
		2858 -> 2861;
		2858 -> 2862;
	2859 [label="В общем, их трое в одном теле. Я бы никогда не смогла выделить одну из них из других.",shape=box,color=blue];
		2859 -> 2861;
		2859 -> 2862;
	2860 [label="Что на первый взгляд не имеет особого смысла. Зачем праздновать восходящую тьму? Зачем радоваться беззаконию и анархии?",shape=box,color=blue];
		2860 -> 2863;
	2861 [label="Переодевание в костюмы? Вечеринка? В зоне боевых действий? Ты действительно думаешь, что это произойдёт?",shape=box,color=red];
		2861 -> 2864;
	2862 [label="Знаешь, Ночь дьявола звучит очень похоже на Наберус. Люди тоже любят наряжаться для этого праздника.",shape=box,color=red];
		2862 -> 2864;
	2863 [label="Я думаю, что это своего рода прививка, возможно. Небольшая часть того, чего мы боимся, чтобы сделать нас сильнее. Или, может быть, это просто предлог надеть маску дьявола и устроить ад.",shape=box,color=blue];
		2863 -> 2861;
		2863 -> 2862;
	2864 [label="... Я, вероятно, просто веду себя глупо. По-детски. Не так ли?",shape=box,color=blue];
		2864 -> 2865;
	2865 [label="О, я про это только подумала.",shape=box,color=blue];
		2865 -> 2866;
	2866 [label="Мне ведь не нужно переодеваться, правда? Я уже монстр. Вечно и бесповоротно. ",shape=box,color=blue];
		2866 -> 2867;
	2867 [label="Check boolean EleanorDating",color=orange];
		2867 -> 2868 [label=true,color=green];
		2867 -> 2869 [label=true,color=green];
		2867 -> 2870 [label=true,color=green];
		2867 -> 2869 [label=false,color=brown];
		2867 -> 2870 [label=false,color=brown];
	2868 [label="Ты монстр, которого я люблю, Элеонора. Я ни о чём не жалею.",shape=box,color=red];
		2868 -> 2871;
	2869 [label="Мне начинает казаться, что тебе нравится говорить это о себе.",shape=box,color=red];
		2869 -> 2872;
	2870 [label="Нет. Настоящие монстры не заботятся о людях так, как заботишься ты.",shape=box,color=red];
		2870 -> 2873;
	2871 [label="+5 Chemistry",color=orange];
		2871 -> 2874;
	2872 [label="Если ты действительно веришь в это, то Ночь демона — идеальный шанс отпраздновать это.",shape=box,color=red];
		2872 -> 2875;
		2872 -> 2873;
	2873 [label="Я знаю, ты боишься того, кем можешь стать. Но это не ты СЕЙЧАС.",shape=box,color=red];
		2873 -> 2876;
	2874 [label="О да! Глупая я. Забыла, что у монстра есть счастливый конец в нашей маленькой истории.",shape=box,color=blue];
		2874 -> 2877;
	2875 [label="БУДЬ монстром. Признай это. В эту одну ночь в году носи это звание с гордостью.",shape=box,color=red];
		2875 -> 2878;
	2876 [label="Так что надень что-нибудь стильное. Веселись. Бездна знает, что Гексу не помешает немного украсить себя.",shape=box,color=red];
		2876 -> 2879;
	2877 [label="Прости меня. Я до сих пор не могу поверить, что это то, чего ты на самом деле ХОЧЕШЬ. Возможно, мне просто нужно немного больше убеждения.",shape=box,color=blue];
		2877 -> 2880;
	2878 [label="О, есть CТОЛЬКО причин, почему это УЖАСНАЯ ИДЕЯ",shape=box,color=blue];
		2878 -> 2881;
	2879 [label="Ловлю тебя на слове. И спасибо. Ещё раз. x",shape=box,color=blue];
		2879 -> 2882;
	2880 [label="Давай позже сожрём друг друга. xxx",shape=box,color=blue];
		2880 -> 2883;
	2881 [label="ТАК. МНОГО.",shape=box,color=blue];
		2881 -> 2884;
	2882 [label="Chat ends.",color=orange];
	2883 [label="Chat ends.",color=orange];
	2884 [label="(Я сейчас не могу вспомнить ни одного, но, уверена, их ДЕСЯТКИ)",shape=box,color=blue];
		2884 -> 2885;
	2885 [label="... дерьмо.",shape=box,color=blue];
		2885 -> 2886;
	2886 [label="тебе удалось пронзить меня моим собственным вертелом. чёрт тебя подери. хорошая работа. x",shape=box,color=blue];
		2886 -> 2887;
	2887 [label="Chat ends.",color=orange];
}