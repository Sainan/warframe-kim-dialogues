digraph {
	"EleanorRank6Convo2 begins." [color=orange];
		"EleanorRank6Convo2 begins." -> j3793793748;
	j3793793748 [label="Привет. Хочу поделится с тобой парой идей.",shape=box,color=blue];
		j3793793748 -> j4203070596;
	j4203070596 [label="Я тут подумала о Ночи дьявола. Я годами не наряжалась к ней, но листала один из комиксов Амира, и вдруг подумала:  подождите, я могла бы стать графиней! У меня к этому клыки и всё такое!",shape=box,color=blue];
		j4203070596 -> j4001571106;
	j4001571106 [label="Может, это слишком банально? Должна ли я быть Денди Дэмеджем?",shape=box,color=blue];
		j4001571106 -> j2225440612;
		j4001571106 -> j1737955063;
		j4001571106 -> j2668250173;
	j2225440612 [label="Кто такой Денди Дэмедж?",shape=box,color=red];
		j2225440612 -> j2168625147;
	j1737955063 [label="Ты всегда можешь переодеться в Лотос, если хочешь сбить людей с толку.",shape=box,color=red];
		j1737955063 -> j3065178676;
	j2668250173 [label="… тебе придётся объяснить мне, что такое Ночь Дьявола.",shape=box,color=red];
		j2668250173 -> j4197628333;
	j2168625147 [label="Ох, дружище.",shape=box,color=blue];
		j2168625147 -> j3703196719;
	j3065178676 [label="О, Боже, нет. Я видела её в твоей голове. Я не создана для этого.",shape=box,color=blue];
		j3065178676 -> j1223468113;
	j4197628333 [label="Ммм. Иногда я забываю, что твоей вины тут нету.",shape=box,color=blue];
		j4197628333 -> j3137478436;
	j3703196719 [label="Дэнди Дэмедж шёл, чтобы «Тэмпл и Потрошители» могли бежать. Он был кошмаром каждой матери и каждой подростковой катастрофой.",shape=box,color=blue];
		j3703196719 -> j1881277586;
	j1223468113 [label="И этот шлем. Это же шлем? Это часть её? Как она видит сквозь него?",shape=box,color=blue];
		j1223468113 -> j169638507;
	j3137478436 [label="Ночь дьявола отмечает затухание влияния Сол на мир.",shape=box,color=blue];
		j3137478436 -> j1925675944;
	j1881277586 [label="Сложена как палочник, накрашена как королева немого кино. Рот как конфета. Тонкие полоски, кожа и собачья цепь. Скулы как бедра скелета.",shape=box,color=blue];
		j1881277586 -> j1550718335;
		j1881277586 -> j1447304788;
	j169638507 [label="В общем, их трое в одном теле. Я бы никогда не смогла выделить одну из них из других.",shape=box,color=blue];
		j169638507 -> j1550718335;
		j169638507 -> j1447304788;
	j1925675944 [label="Что на первый взгляд не имеет особого смысла. Зачем праздновать восходящую тьму? Зачем радоваться беззаконию и анархии?",shape=box,color=blue];
		j1925675944 -> j417403895;
	j1550718335 [label="Переодевание в костюмы? Вечеринка? В зоне боевых действий? Ты действительно думаешь, что это произойдёт?",shape=box,color=red];
		j1550718335 -> j614915349;
	j1447304788 [label="Знаешь, Ночь дьявола звучит очень похоже на Наберус. Люди тоже любят наряжаться для этого праздника.",shape=box,color=red];
		j1447304788 -> j614915349;
	j417403895 [label="Я думаю, что это своего рода прививка, возможно. Небольшая часть того, чего мы боимся, чтобы сделать нас сильнее. Или, может быть, это просто предлог надеть маску дьявола и устроить ад.",shape=box,color=blue];
		j417403895 -> j1550718335;
		j417403895 -> j1447304788;
	j614915349 [label="... Я, вероятно, просто веду себя глупо. По-детски. Не так ли?",shape=box,color=blue];
		j614915349 -> j16751567;
	j16751567 [label="О, я про это только подумала.",shape=box,color=blue];
		j16751567 -> j3691245503;
	j3691245503 [label="Мне ведь не нужно переодеваться, правда? Я уже монстр. Вечно и бесповоротно. ",shape=box,color=blue];
		j3691245503 -> j2436064064;
	j2436064064 [label="Check boolean EleanorDating",color=orange];
		j2436064064 -> j3182175560 [label=true,color=green];
		j2436064064 -> j350700988 [label=true,color=green];
		j2436064064 -> j2661004254 [label=true,color=green];
		j2436064064 -> j350700988 [label=false,color=brown];
		j2436064064 -> j2661004254 [label=false,color=brown];
	j3182175560 [label="Ты монстр, которого я люблю, Элеонора. Я ни о чём не жалею.",shape=box,color=red];
		j3182175560 -> j654015114;
	j350700988 [label="Мне начинает казаться, что тебе нравится говорить это о себе.",shape=box,color=red];
		j350700988 -> j226359834;
	j2661004254 [label="Нет. Настоящие монстры не заботятся о людях так, как заботишься ты.",shape=box,color=red];
		j2661004254 -> j2007118412;
	j654015114 [label="+5 Chemistry",color=orange];
		j654015114 -> j170110856;
	j226359834 [label="Если ты действительно веришь в это, то Ночь демона — идеальный шанс отпраздновать это.",shape=box,color=red];
		j226359834 -> j2860888327;
		j226359834 -> j2007118412;
	j2007118412 [label="Я знаю, ты боишься того, кем можешь стать. Но это не ты СЕЙЧАС.",shape=box,color=red];
		j2007118412 -> j4069472226;
	j170110856 [label="О да! Глупая я. Забыла, что у монстра есть счастливый конец в нашей маленькой истории.",shape=box,color=blue];
		j170110856 -> j721526177;
	j2860888327 [label="БУДЬ монстром. Признай это. В эту одну ночь в году носи это звание с гордостью.",shape=box,color=red];
		j2860888327 -> j4216887872;
	j4069472226 [label="Так что надень что-нибудь стильное. Веселись. Бездна знает, что Гексу не помешает немного украсить себя.",shape=box,color=red];
		j4069472226 -> j103766976;
	j721526177 [label="Прости меня. Я до сих пор не могу поверить, что это то, чего ты на самом деле ХОЧЕШЬ. Возможно, мне просто нужно немного больше убеждения.",shape=box,color=blue];
		j721526177 -> j3554224911;
	j4216887872 [label="О, есть CТОЛЬКО причин, почему это УЖАСНАЯ ИДЕЯ",shape=box,color=blue];
		j4216887872 -> j3625707598;
	j103766976 [label="Ловлю тебя на слове. И спасибо. Ещё раз. x",shape=box,color=blue];
		j103766976 -> "Chat ends.";
	j3554224911 [label="Давай позже сожрём друг друга. xxx",shape=box,color=blue];
		j3554224911 -> "Chat ends.";
	j3625707598 [label="ТАК. МНОГО.",shape=box,color=blue];
		j3625707598 -> j409991182;
	"Chat ends." [color=orange];
	j409991182 [label="(Я сейчас не могу вспомнить ни одного, но, уверена, их ДЕСЯТКИ)",shape=box,color=blue];
		j409991182 -> j927171235;
	j927171235 [label="... дерьмо.",shape=box,color=blue];
		j927171235 -> j3786049398;
	j3786049398 [label="тебе удалось пронзить меня моим собственным вертелом. чёрт тебя подери. хорошая работа. x",shape=box,color=blue];
		j3786049398 -> "Chat ends.";
}