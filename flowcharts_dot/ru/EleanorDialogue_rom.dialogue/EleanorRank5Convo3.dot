	2335 [label="Чтение мыслей?",shape=box,color=red];
		2335 -> 2338;
	2336 [label="Язык?",shape=box,color=red];
		2336 -> 2339;
	2337 [label="«Я люблю смотреть, как ты спишь...»",shape=box,color=blue];
