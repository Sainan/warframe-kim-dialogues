	2360 [label="Chat ends.",color=orange];
	2373 [label="Что думаешь, как к этому отнесутся остальные?",shape=box,color=red];
		2373 -> 2372;
	2372 [label="Боги. Я даже не думала об этом.",shape=box,color=blue];
		2372 -> 2374;
	2374 [label="Сейчас я слишком счастлива, чтобы беспокоиться об этом, но, полагаю, нам следует им рассказать.",shape=box,color=blue];
		2374 -> 2375;
	2375 [label="Хм. Я всерьёз подумываю о том, чтобы наброситься на тебя в кабинете Артура и «случайно» включить громкоговоритель, чтобы Лэтти могла слышать каждый твой вздох.",shape=box,color=blue];
		2375 -> 2376;
	2376 [label="Хотя лучше не надо. Жизнь и так достаточно травматичная.",shape=box,color=blue];
		2376 -> 2377;
		2376 -> 2378;
	2377 [label="Хорошая идея. Хотя, может, и не в офисе охраны, и не с включённым динамиком.",shape=box,color=red];
		2377 -> 2379;
	2378 [label="Что такое оповещатель?",shape=box,color=red];
		2378 -> 2382;
	2379 [label="+10 Chemistry",color=orange];
		2379 -> 2380;
	2382 [label="Это громкоговоритель.  «Торговый центр закроется через пять минут, бла-бла-бла, воровство в магазине карается казнью без суда и следствия».",shape=box,color=blue];
		2382 -> 2384;
	2380 [label="Запомни эту мысль, любовь моя. Посмотрим, куда приведёт нас воображение.",shape=box,color=blue];
		2380 -> 2381;
	2384 [label="+10 Chemistry",color=orange];
		2384 -> 2383;
