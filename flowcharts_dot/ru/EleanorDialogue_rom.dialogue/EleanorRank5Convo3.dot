		2344 -> 2348;
	2345 [label="Для меня это не проблема.",shape=box,color=red];
		2345 -> 2351;
	2346 [label="Честно говоря... Мне это даже нравится.",shape=box,color=red];
		2346 -> 2347;
	2348 [label="Check boolean EleanorDating",color=orange];
		2348 -> 2349 [label=true,color=green];
		2348 -> 2350 [label=false,color=brown];
	2351 [label="Ну, тогда всё решено.",shape=box,color=blue];
		2351 -> 2354;
	2347 [label="Так... Я не первая женщина с щупальцеобразным языком, с которой ты флиртовал? Вообще-то, не отвечай на этот вопрос. Мне страшно узнать ответ.",shape=box,color=blue];
		2347 -> 2351;
	2349 [label="Ясно.",shape=box,color=blue];
		2349 -> 2352;
	2350 [label="О! Понятно! Воображаешь, что делаешь мне одолжение?",shape=box,color=blue];
		2350 -> 2353;
	2354 [label="Я напугана. Возбуждена. Нервничаю. Честно говоря, более чем немного возбуждена. Возможно, я забегаю вперёд.",shape=box,color=blue];
		2354 -> 2355;
	2352 [label="Я ценю твою честность.",shape=box,color=blue];
		2352 -> 2356;
	2353 [label="Боюсь, что ближе ко мне ты сможешь подобраться, только если подожжёшь себя.",shape=box,color=blue];
		2353 -> 2357;
	2355 [label="Сделаем это?",shape=box,color=blue];
		2355 -> 2364;
		2355 -> 2365;
	2356 [label="Желаю тебе удачи в поиске менее «отвратительного» человека для близких отношений.",shape=box,color=blue];
