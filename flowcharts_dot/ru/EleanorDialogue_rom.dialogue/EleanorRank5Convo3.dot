	2338 [label="ДРУГИМ людям это более неловко.",shape=box,color=blue];
		2338 -> 2340;
	2339 [label="Ну, я ведь не о размере своей задницы говорю, да?",shape=box,color=blue];
		2339 -> 2341;
	2340 [label="Нет. Я имею в виду свой язык. Анаконда в комнате.",shape=box,color=blue];
		2340 -> 2343;
	2341 [label="+5 Chemistry",color=orange];
		2341 -> 2342;
