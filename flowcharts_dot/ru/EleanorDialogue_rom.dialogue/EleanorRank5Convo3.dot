		2289 -> 2293;
	2290 [label="Еще многое предстоит сделать.",shape=box,color=red];
		2290 -> 2294;
	2291 [label="У меня есть на то свои причины.",shape=box,color=red];
		2291 -> 2295;
	2292 [label="О, Боги. Извини. Я не хотела этого. Просто мне трудно воспринимать СЕБЯ как причину, по которой ты терпишь всё... это.",shape=box,color=blue];
		2292 -> 2844;
	2293 [label="...мы говорим об одних и тех же людях?",shape=box,color=blue];
		2293 -> 2844;
	2294 [label="Я имею в виду… сейчас мы знаем, что делаем. Мы сдерживаем распространение. Твоя миссия исполнена. Тебе не нужно оставаться. И всё же…",shape=box,color=blue];
		2294 -> 2844;
	2295 [label="Ой, не будь такой загадкой. Я буду чувствовать себя обязанной как-то вытянуть из тебя информацию.",shape=box,color=blue];
		2295 -> 2844;
	2844 [label="Check boolean IsDating",color=orange];
		2844 -> 2300 [label=true,color=green];
		2844 -> 2299 [label=true,color=green];
		2844 -> 2296 [label=false,color=brown];
	2300 [label="Мне так надоело вести этот разговор с людьми. Я не уйду. Всё. [Завершить]",shape=box,color=red];
		2300 -> 2301;
	2299 [label="Я очень переживаю за нашу команду. Вы все для меня теперь… семья. Та, которой у меня никогда не было.",shape=box,color=red];
		2299 -> 2304;
	2296 [label="Check boolean EleanorDating",color=orange];
		2296 -> 2297 [label=true,color=green];
		2296 -> 2300 [label=true,color=green];
		2296 -> 2298 [label=false,color=brown];
		2296 -> 2299 [label=false,color=brown];
		2296 -> 2300 [label=false,color=brown];
	2301 [label="...подожди, ты куда?",shape=box,color=blue];
		2301 -> 2302;
	2304 [label="И я благодарю богов за тот день, когда мы объединились.",shape=box,color=blue];
		2304 -> 2307;
	2297 [label="Я думаю, что тот факт, что мы вместе, будет достаточным намёком на то, почему я хочу здесь остаться.",shape=box,color=red];
		2297 -> 2303;
	2298 [label="Мне нужно это сказать? Я здесь из-за тебя. [Признаться в чувствах]",shape=box,color=red];
		2298 -> 2305;
	2302 [label="Chat ends.",color=orange];
	2307 [label="Я рада, что тебе удалось найти то, ради чего ты здесь. Все реки в конце концов впадают в море.",shape=box,color=blue];
		2307 -> 2313;
	2303 [label="Теперь я начинаю думать, что я сделала, чтобы обмануть тебя. Или манипулировать тобой. Может, я вложила в твою голову какое-то предложение?",shape=box,color=blue];
		2303 -> 2308;
	2305 [label="Теперь я начинаю думать, что я сделала, чтобы обмануть тебя. Или манипулировать тобой. Может, я вложила в твою голову какое-то предложение? Или, может быть, в твоей системе есть вторичный вирус Техрота, которого привлекает то, что есть в моей.",shape=box,color=blue];
		2305 -> 2306;
	2313 [label="+20 Chemistry",color=orange];
		2313 -> 2312;
	2308 [label="Или, может быть, в твоей системе есть вторичный вирус Техрота, которого привлекает то, что есть в моей.",shape=box,color=blue];
		2308 -> 2309;
	2306 [label="Меня тянет к ТЕБЕ, Элеонора. По разным причинам.",shape=box,color=red];
		2306 -> 2310;
	2312 [label="Если говорить о семьях, то тут полный бардак. Но я бы не стала менять мою семью ни за что на свете.",shape=box,color=blue];
		2312 -> 2314;
	2309 [label="Или, может быть (глубокий вдох) я тебе нравлюсь так же, как и ты мне. Неужели это так просто?",shape=box,color=blue];
		2309 -> 2315;
	2310 [label="Check boolean EleanorConfession",color=orange];
		2310 -> 2311 [label=true,color=green];
		2310 -> 2315 [label=false,color=brown];
	2314 [label="Chat ends.",color=orange];
	2315 [label="Я заключу с тобой сделку. Пойди к Лэтти, попроси её провести тебе быструю психологическую оценку, докопаться до сути того, что НА САМОМ ДЕЛЕ здесь происходит, и мы просто забудем об этом разговоре.",shape=box,color=blue];
		2315 -> 2316;
		2315 -> 2317;
		2315 -> 2318;
	2311 [label="Я думаю, что это понятно.",shape=box,color=red];
		2311 -> 2315;
	2316 [label="Мне не нужна психологическая оценка. Нет ничего безумного в том, чтобы любить тебя. Если ты не чувствуешь те же чувства в отношении меня, пожалуйста, скажи об этом.",shape=box,color=red];
		2316 -> 2321;
	2317 [label="Если ты не чувствуешь ко мне того же, просто скажи об этом открыто.",shape=box,color=red];
		2317 -> 2321;
	2318 [label="Ого. Ладно. Неважно.",shape=box,color=red];
		2318 -> 2319;
	2321 [label="КОНЕЧНО Я ЧУВСТВУЮ ТО ЖЕ САМОЕ",shape=box,color=blue];
		2321 -> 2322;
	2319 [label="Видишь? Это было легко.",shape=box,color=blue];
		2319 -> 2320;
	2322 [label="ТЫ ЛУЧШЕЕ, ЧТО КОГДА-ЛИБО ПРОИЗОШЛО В МОЕЙ АБСУРДНОЙ ЖИЗНИ",shape=box,color=blue];
		2322 -> 2323;
	2320 [label="Chat ends.",color=orange];
	2323 [label="ЭТО ЗНАЧИТ, ЧТО ТЫ НЕ ДОЛГО БУДЕШЬ БЫТЬ ЧАСТЬЮ ЭТОГО, И ЧЕМ РАНЬШЕ МЫ ОБА ЭТО ПРИЗНАЕМ, ТЕМ ЛУЧШЕ",shape=box,color=blue];
		2323 -> 2324;
	2324 [label="ПОТОМУ ЧТО ТАК ЭТО РАБОТАЕТ",shape=box,color=blue];
		2324 -> 2325;
	2325 [label="Check boolean EleanorChristopher1",color=orange];
		2325 -> 2326 [label=true,color=green];
		2325 -> 2327 [label=false,color=brown];
	2326 [label="Я знаю, что ты теряла близких. Я тоже. Мы не одиноки в этом.",shape=box,color=red];
		2326 -> 2328;
	2327 [label="Элеонора, я никуда не уйду. Моё место здесь, с тобой.",shape=box,color=red];
		2327 -> 2330;
	2328 [label="+5 Chemistry",color=orange];
		2328 -> 2329;
	2330 [label="Хорошо. Я вижу, что твоё решение окончательно.",shape=box,color=blue];
		2330 -> 2331;
	2329 [label="Нет. Мы ведь не одиноки, правда? И нам никогда не придётся быть одинокими.",shape=box,color=blue];
		2329 -> 2331;
	2331 [label="Я могла бы придумать десяток разных причин, почему нам не стоит быть вместе, и у тебя был бы ответ на каждую из них. О, а что если я заражу тебя? У тебя иммунитет. А если я попробую тебя съесть? Тебе даровано бессмертие. А что если я загляну тебе в голову? Уверена, ты просто опять выкинешь меня оттуда.",shape=box,color=blue];
		2331 -> 2332;
	2332 [label="Ты чудесное, невозможное создание. Уходя, тебе удалось покорить меня.",shape=box,color=blue];
		2332 -> 2333;
	2333 [label="О, и последнее. Не знаю, заметно ли это, но у меня есть одна неловкая личная проблема. Нам нужно её решить.",shape=box,color=blue];
		2333 -> 2334;
		2333 -> 2335;
		2333 -> 2336;
	2334 [label="Твои светящиеся глаза не дадут мне спать по ночам?",shape=box,color=red];
