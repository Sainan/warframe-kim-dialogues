digraph {
	1803 [label="EleanorRank4Convo5 begins.",color=orange];
		1803 -> 1804;
	1804 [label="Королевство, которое было твоим. Дувири. Это ведь не вымысел, правда?",shape=box,color=blue];
		1804 -> 1805;
		1804 -> 1806;
	1805 [label="И так, и не совсем так. Место и персонажи появились из моей любимой детской книги. «Сказки о Дувири». Она была воплощена в жизнь с помощью Бездны.",shape=box,color=red];
		1805 -> 1807;
	1806 [label="Мне так надоело говорить о Дувири...",shape=box,color=red];
		1806 -> 1813;
	1807 [label="Тебе удалось этого добиться?",shape=box,color=blue];
		1807 -> 1809;
		1807 -> 1810;
	1813 [label="+5 Chemistry",color=orange];
		1813 -> 1808;
	1809 [label="Думаю, остальные дети, кроме меня, погибли или были спасены. Подробности мне неясны.",shape=box,color=red];
		1809 -> 1811;
	1810 [label="Это было не совсем намеренно. Всё, что я помню, это…",shape=box,color=red];
		1810 -> 1811;
	1808 [label="Упс. Моя ошибка.",shape=box,color=blue];
		1808 -> 1814;
	1811 [label="Ангелы наступали, пробивая стены, и мне некуда было бежать. У меня была книга, и я помню, как пришла в голову мысль: «Здесь я могу быть в безопасности.»",shape=box,color=red];
		1811 -> 1812;
	1814 [label="Это было безрассудно с моей стороны, не так ли? Это место не было для тебя лагерем отдыха.",shape=box,color=blue];
		1814 -> 1815;
	1812 [label="Ангелы? В это время ангелы считались доброжелательными существами. Иногда ужасающими, но на стороне добра. Если только не имелись в виду падшие ангелы.",shape=box,color=blue];
		1812 -> 1817;
	1815 [label="Мне искренне жаль. Отныне я буду держать своё любопытство под контролем.",shape=box,color=blue];
		1815 -> 1816;
	1817 [label="За моё время это не особо изменилось. Ангелы — это крылатые, сияющие существа из старых историй, которые помогают добрым людям. Я говорю об Ангелах Бездны. Это совсем другие создания.",shape=box,color=red];
		1817 -> 1818;
	1816 [label="Chat ends.",color=orange];
	1818 [label="Понятно. Я не могу представить, чтобы нечто под названием «Ангел Бездны» спустилось и благословило новорожденного.",shape=box,color=blue];
		1818 -> 1819;
	1819 [label="Насколько я могу судить, они были людьми. Когда песня Ангелов достигает их, они начинают меняться. Когда они больше не могут ей сопротивляться, они сами становятся Ангелами.",shape=box,color=red];
		1819 -> 1820;
	1820 [label="Будущее, как ты его описываешь, звучит чертовски ужасно.",shape=box,color=blue];
		1820 -> 1821;
	1821 [label="Я не могу винить тебя за желание спрятаться от этих Ангелов Бездны. Особенно если они были…",shape=box,color=blue];
		1821 -> 1822;
	1822 [label="О. У меня просто возникла мысль. Это ведь не твои родители, да?",shape=box,color=blue];
		1822 -> 1823;
		1822 -> 1824;
		1822 -> 1825;
	1823 [label="Я верю в то, что мои родители мертвы.",shape=box,color=red];
		1823 -> 1826;
	1824 [label="Может и они. Другие дети слышали, как их родители звали.",shape=box,color=red];
		1824 -> 1826;
	1825 [label="Думаю, да. Куинн предупреждал меня не искать знакомые голоса. Наверное, он это имел в виду.",shape=box,color=red];
		1825 -> 1826;
	1826 [label="Мне очень жаль. Я рада, что тебе удалось найти безопасную гавань, даже если она не осталась такой.",shape=box,color=blue];
		1826 -> 1827;
	1827 [label="Это было безопасно долгое время. Достаточно долго, чтобы наступило забытье. Думаю, это то, чего мне хотелось больше всего.",shape=box,color=red];
		1827 -> 1828;
	1828 [label="Но как, черт возьми, тебе это удалось? Ты всего лишь ребёнок. Что дало тебе силу создать целое королевство из ничего?",shape=box,color=blue];
		1828 -> 1829;
		1828 -> 1830;
		1828 -> 1831;
	1829 [label="Дети интересны тем, что они ещё не знают, чего они не могут сделать. У меня не было знания, что я не могу. Поэтому всё получилось.",shape=box,color=red];
		1829 -> 1833;
	1830 [label="У меня было так много эмоций, все сразу, что я... просто... они преобразовались. Это трудно объяснить.",shape=box,color=red];
		1830 -> 1832;
	1831 [label="Бездна — это не «ничто». Я знаю, это звучит так, как будто это должно быть так, но это не так. Альбрехт это доказал.",shape=box,color=red];
		1831 -> 1832;
	1833 [label="Когда мне было пять, я хотела стать ведьмой. Я кричала «Абракадабра» и прыгала с лестницы. Я не знала, что не умею летать. Но я быстро поняла.",shape=box,color=blue];
		1833 -> 1834;
	1832 [label="Мы знаем об этом очень мало, даже сейчас. Но даже Орокин поняли одну вещь: Бездна реагирует на человеческие эмоции.",shape=box,color=red];
		1832 -> 1836;
	1834 [label="Сила, создавшая Дувири, должна была прийти откуда-то извне. Она была использована тобой, чтобы сделать что-то невероятное, но она не была твоей.",shape=box,color=blue];
		1834 -> 1835;
	1836 [label="ПОНЯТНО. Так что если ты посмотришь в Бездну с… хм, скажем, чувством голода… ты можешь создать рыскающего полуголодного волка. Или королевский пир, может быть. Или буханку хлеба со скрежещущими в ней волчьими зубами.",shape=box,color=blue];
		1836 -> 1837;
	1835 [label="По крайней мере, не поначалу. Но сейчас это в тебе. Дикая энергия. Петли во времени. Боги, ты чудо.",shape=box,color=blue];
		1835 -> 1838;
	1837 [label="Какая ужасающая и воодушевляющая мысль.",shape=box,color=blue];
		1837 -> 1838;
	1838 [label="Почему Орокин посчитали хорошей идеей запустить корабль, полный детей, в Бездну? Разве это не была эмоциональная бомба замедленного действия, готовая взорваться?",shape=box,color=blue];
		1838 -> 1839;
	1839 [label="Вот для чего предназначалась эта книга рассказов. На первый взгляд, она была о вычурных персонажах при дворе безумного короля, чьё настроение менялось каждый день.",shape=box,color=red];
		1839 -> 1840;
	1840 [label="Но настоящий урок этой книги был о том, как управлять своими эмоциями. Мы должны были извлечь из этого важный урок, чтобы путешествие было безопасным.",shape=box,color=red];
		1840 -> 1841;
	1841 [label="Тьфу. Извини, но тебе удалось всё испортить.",shape=box,color=blue];
		1841 -> 1842;
	1842 [label="Почему бы не просто оставить истории как истории? Я НЕНАВИДЕЛА, когда узнала, что Рудольфо, король леопардов, который героически погиб в битве с Зодиакальным Змеем, должен был быть Сол с солнечными пятнами, страдающим на звёздном дереве.",shape=box,color=blue];
		1842 -> 1843;
	1843 [label="Прятать религию в детских книгах — это как прятать лекарства в конфетах. ПРОСТО РАССКАЗЫВАЙТЕ ИСТОРИИ.",shape=box,color=blue];
		1843 -> 1844;
		1843 -> 1845;
	1844 [label="Не имею понятия о Рудольфо — короле леопардов.",shape=box,color=red];
		1844 -> 1846;
	1845 [label="Я хочу когда-нибудь услышать историю о Рудольфо - короле леопардов.",shape=box,color=red];
		1845 -> 1847;
	1846 [label="Я могу умереть счастливой женщиной, зная, что об этих книгах забудут. Ура будущему!",shape=box,color=blue];
		1846 -> 1848;
	1847 [label="Фу. Пожалуйста, нет. Это не легенда, это ужасная серия детских книг.",shape=box,color=blue];
		1847 -> 1849;
	1848 [label="Но ведь у вас же есть истории, не так ли?",shape=box,color=blue];
		1848 -> 1850;
	1849 [label="Но если настаиваешь, я могу рассказать тебе некоторые из наших настоящих легенд.",shape=box,color=blue];
		1849 -> 1851;
		1849 -> 1852;
	1850 [label="Множество. Даже у Тэнно и варфреймов есть истории.",shape=box,color=red];
		1850 -> 1854;
	1851 [label="Мне бы понравилось.",shape=box,color=red];
		1851 -> 1861;
	1852 [label="Не сейчас [Завершить]",shape=box,color=red];
		1852 -> 1853;
	1854 [label="Есть такой парень, Драсус Левериан. Он как музейный куратор. Он хранит записи всех легенд варфреймов.",shape=box,color=red];
		1854 -> 1855;
	1861 [label="Посмотрим. Конечно, есть Артур. Старый добрый Артур. Оригинал. Лучший в Британии.",shape=box,color=blue];
		1861 -> 1863;
	1853 [label="Chat ends.",color=orange];
	1855 [label="Ну, это меня ошарашило. Ты из далёкого будущего, но ты в это же время в стороне от событий в Дувири так много лет, что события, которые произошли при твоей жизни, успели стать мифами?",shape=box,color=blue];
		1855 -> 1856;
	1863 [label="А потом была Локсли Янг. Я её любила. Хотела быть ею. Она была образцом определённого типа молодой женщины.",shape=box,color=blue];
		1863 -> 1866;
	1856 [label="У меня начинается головокружение.",shape=box,color=blue];
		1856 -> 1857;
		1856 -> 1858;
	1866 [label="Какова её история?",shape=box,color=red];
		1866 -> 1867;
	1857 [label="Поверь мне. Я знаю, что ты чувствуешь.",shape=box,color=red];
		1857 -> 1859;
	1858 [label="Тогда расскажи мне о ваших мифах.",shape=box,color=red];
		1858 -> 1860;
	1867 [label="Хорошо. Краткая версия: она была дочерью знатного человека в стародавние времена, когда земля страдала под жестоким королём.",shape=box,color=blue];
		1867 -> 1868;
	1859 [label="Вы ведь тоже сказочный персонаж, не так ли?",shape=box,color=blue];
		1859 -> 1862;
	1860 [label="Вот это да. Если я начну, мы тут весь год просидим.",shape=box,color=blue];
		1860 -> 1861;
	1868 [label="Её брат был убит в сражении в чужих землях, но весть об этом ещё не дошла до дома, так что, когда угнетённым людям понадобился герой, она начала борьбу.",shape=box,color=blue];
		1868 -> 1881;
	1862 [label="Попадаешь в ловушку волшебного королевства, где время течёт по-другому, призываешься туда, где это больше всего нужно…",shape=box,color=blue];
		1862 -> 1864;
	1881 [label="Check boolean EleanorHeroVirus",color=orange];
		1881 -> 1882 [label=true,color=green];
		1881 -> 1883 [label=false,color=brown];
	1864 [label="Всё, что нам нужно, чтобы завершить историю, — это любовная интрига или слюнявое, бесчеловечное чудовище.",shape=box,color=blue];
		1864 -> 1865;
	1882 [label="Кажется, ты ненавидишь героев.",shape=box,color=red];
		1882 -> 1885;
	1883 [label="Теперь я не выношу героические фигуры. Они токсичны. Заразны, и по этой причине опасны.",shape=box,color=blue];
		1883 -> 1884;
	1865 [label="(Или слюнявая, бесчеловечная любовная интрига, в зависимости от ваших вкусов.)",shape=box,color=blue];
		1865 -> 1869;
		1865 -> 1870;
	1885 [label="Ей можно. Заткнись.",shape=box,color=blue];
		1885 -> 1886;
	1884 [label="Локсли Янг другая.",shape=box,color=blue];
		1884 -> 1887;
	1869 [label="Мне всегда монстры казались интереснее, в любом случае. Герои скучные. Предсказуемые…Обыденные.",shape=box,color=red];
		1869 -> 1872;
	1870 [label="М-м-м. Не думаю, что монстры — это действительно мой тип.",shape=box,color=red];
		1870 -> 1871;
	1886 [label="Как я уже говорила. Она была очень похожа на своего брата, поэтому переоделась в его старую одежду, выдала себя за него и пошла возглавлять революцию. Если кто-то подходил слишком близко, мог заметить, что она девушка, поэтому она носила капюшон. Это стало её визитной карточкой.",shape=box,color=blue];
		1886 -> 1888;
	1887 [label="Update boolean EleanorHeroVirus",color=orange];
		1887 -> 1888;
	1872 [label="Update boolean EleanorFlirt",color=orange];
		1872 -> 1873;
	1871 [label="И это нормально, честно говоря.",shape=box,color=blue];
		1871 -> 1878;
	1888 [label="Она отлично владела луком и стрелами. Она и её команда стали известной бандой разбойников, грабивших королевских сборщиков налогов и раздавали деньги тем, кто в них больше нуждался.",shape=box,color=blue];
		1888 -> 1889;
	1873 [label="+15 Chemistry",color=orange];
		1873 -> 1874;
	1878 [label="Монстры привыкли к одиночеству.",shape=box,color=blue];
		1878 -> 1879;
	1889 [label="Похоже, она бы заслужила уважение сама по себе. Зачем ей было притворяться своим братом?",shape=box,color=red];
		1889 -> 1890;
	1874 [label="Чудовищность — она в глазах смотрящего...",shape=box,color=blue];
		1874 -> 1875;
	1879 [label="Мы - те, кто выжил.",shape=box,color=blue];
		1879 -> 1880;
	1890 [label="Вот такая история. В те времена считалось, что мужчины занимались войной, а значит, и правлением тоже. Люди привыкли подчиняться мужчинам. Ей нужно было использовать репутацию своего брата, чтобы сделать то, что она должна была. Или так, или погибнуть.",shape=box,color=blue];
		1890 -> 1892;
		1890 -> 1891;
		1890 -> 1893;
	1875 [label="Если вас искренне тянет к качествам, которые вы считаете «чудовищными» в другом человеке, то вам лучше убедиться, что этот человек разделяет ваш выбор ярлыков и наслаждается этим. В противном случае вы совершаете грубейшую фетишизацию.",shape=box,color=blue];
		1875 -> 1876;
	1880 [label="Chat ends.",color=orange];
	1892 [label="Что с ней случилось в конце концов?",shape=box,color=red];
		1892 -> 1895;
	1891 [label="Хорошо, что мы исправили это в будущем.",shape=box,color=red];
		1891 -> 1894;
	1893 [label="У меня нет уверенности, что мы *полностью* исправим это в будущем...",shape=box,color=red];
		1893 -> 1896;
	1876 [label="Назвала бы я себя монстром, например? Да. С удовольствием. Я принимаю титул, которым меня награждают другие, и радуюсь этому. На случай, если тебе интересно.",shape=box,color=blue];
		1876 -> 1877;
	1895 [label="+20 Chemistry",color=orange];
		1895 -> 1898;
	1894 [label="+20 Chemistry",color=orange];
		1894 -> 1897;
	1896 [label="+20 Chemistry",color=orange];
		1896 -> 1899;
	1877 [label="Chat ends.",color=orange];
	1898 [label="Это зависит от того, какую версию истории ты читаешь. Либо её сразу вызвали в Зал Героев, либо она обручилась со своенравной дочерью короля, либо её заточили в дубе, где она спит до сих пор, ожидая часа, когда она понадобится Британии.",shape=box,color=blue];
		1898 -> 1901;
	1897 [label="Я тоже так думаю.",shape=box,color=blue];
		1897 -> 1900;
	1899 [label="Нет, если верить персонажу Балласа, вы этого не сделали.",shape=box,color=blue];
		1899 -> 1902;
	1901 [label="Отсюда и поговорка у нас дома. Если дела идут плохо, как во время войны, принято пожимать плечами и говорить: «Ну, не может быть, чтобы всё было ТАК плохо. Локсли Янг ещё не объявилась».",shape=box,color=blue];
		1901 -> 1904;
	1900 [label="Боги, я бы отдала всё, чтобы увидеть твою эпоху своими глазами. Может, ты смогла бы пронести для меня одну из тех ледяных гробниц, и я просто бы спааааала в ней несколько тысячелетий.",shape=box,color=blue];
		1900 -> 1903;
	1902 [label="Сколько, чёрт побери, ещё нужно ждать?",shape=box,color=blue];
		1902 -> 1905;
	1904 [label="Chat ends.",color=orange];
	1903 [label="Chat ends.",color=orange];
	1905 [label="Chat ends.",color=orange];
}