	"Chat ends." [color=orange];
	j3364311394 [label="Check boolean EleanorConsentComplete",color=orange];
		j3364311394 -> "Chat ends." [label=true,color=green];
		j3364311394 -> j2085881990 [label=false,color=brown];
	j3528729371 [label="Check boolean EleanorPolyamorySuccess",color=orange];
		j3528729371 -> j3364311394 [label=true,color=green];
		j3528729371 -> "Chat ends." [label=false,color=brown];
	j2085881990 [label="Мне кажется, самое раздражающее здесь то, что я сначала нашла эти мысли у тебя в голове.",shape=box,color=blue];
		j2085881990 -> j2184910098;
	j2184910098 [label="Не то чтобы я не знала, что ты собирался прийти и вежливо спросить разрешения. Здравствуй.",shape=box,color=blue];
		j2184910098 -> j1742122401;
	j1742122401 [label="Ответ звучит как очень надутый, скрестивший руки «Да, конечно», в то же время пока я сижу здесь и старательно не думаю о том, как ты забавляешься там с той прекрасной вещью, которую я мельком увидела в твоих фантазиях.",shape=box,color=blue];
		j1742122401 -> j548802372;
	j548802372 [label="Теперь это в МОИХ фантазиях, поскольку я застряла здесь и сейчас, в этом месте и времени. Спасибо-тебе-большое!",shape=box,color=blue];
		j548802372 -> j584337097;
	j584337097 [label="Прости. Я действительно хотел спросить твоего согласия. Знаю, мы это раньше не обсуждали. Я хотел убедиться, что ты будешь не против.",shape=box,color=red];
		j584337097 -> j2946859879;
	j2946859879 [label="Конечно! Я вижу их в твоём воображении. И если ты им доверяешь, то и я доверяю.",shape=box,color=blue];
		j2946859879 -> j1913633603;
	j1913633603 [label="Мне просто грустно, что у меня нет возможности поиграть в эти игры.",shape=box,color=blue];
		j1913633603 -> j3239553825;
	j3239553825 [label="+20 Chemistry",color=orange];
		j3239553825 -> j2721557449;
	j2721557449 [label="Но, возможно, я смогу сделать это косвенно через тебя, отличная мысль.",shape=box,color=blue];
		j2721557449 -> j298331240;
	j298331240 [label="Boolean EleanorConsentComplete is now true.",color=orange];
		j298331240 -> "Chat ends.";
}