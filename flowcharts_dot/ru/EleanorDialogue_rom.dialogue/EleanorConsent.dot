	3318 [label="Chat ends.",color=orange];
	3319 [label="Мне кажется, самое раздражающее здесь то, что я сначала нашла эти мысли у тебя в голове.",shape=box,color=blue];
		3319 -> 3320;
	3317 [label="Chat ends.",color=orange];
	3320 [label="Не то чтобы я не знала, что ты собирался прийти и вежливо спросить разрешения. Здравствуй.",shape=box,color=blue];
		3320 -> 3321;
	3321 [label="Ответ звучит как очень надутый, скрестивший руки «Да, конечно», в то же время пока я сижу здесь и старательно не думаю о том, как ты забавляешься там с той прекрасной вещью, которую я мельком увидела в твоих фантазиях.",shape=box,color=blue];
		3321 -> 3322;
	3322 [label="Теперь это в МОИХ фантазиях, поскольку я застряла здесь и сейчас, в этом месте и времени. Спасибо-тебе-большое!",shape=box,color=blue];
		3322 -> 3323;
	3323 [label="Прости. Я действительно хотел спросить твоего согласия. Знаю, мы это раньше не обсуждали. Я хотел убедиться, что ты будешь не против.",shape=box,color=red];
		3323 -> 3324;
	3324 [label="Конечно! Я вижу их в твоём воображении. И если ты им доверяешь, то и я доверяю.",shape=box,color=blue];
		3324 -> 3325;
	3325 [label="Мне просто грустно, что у меня нет возможности поиграть в эти игры.",shape=box,color=blue];
		3325 -> 3326;
	3326 [label="+20 Chemistry",color=orange];
		3326 -> 3327;
	3327 [label="Но, возможно, я смогу сделать это косвенно через тебя, отличная мысль.",shape=box,color=blue];
		3327 -> 3328;
	3328 [label="Update boolean EleanorConsentComplete",color=orange];
		3328 -> 3329;
	3329 [label="Chat ends.",color=orange];
}