		3288 -> 3289;
	3289 [label="а потом я подумала, ну и ладно, можно пустить всё на самотёк, сойти с ума и делать всё, что захочу, потому что всегда можно снова ударить кулаком по полу и всё обнулить.",shape=box,color=blue];
