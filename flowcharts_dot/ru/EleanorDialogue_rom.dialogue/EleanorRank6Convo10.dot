digraph {
	"EleanorRank6Convo10 begins." [color=orange];
		"EleanorRank6Convo10 begins." -> j690265104;
	j690265104 [label="Поэтому я подумала: год, как всегда, завершится в конце декабря, и хотя это будет ощущаться как совершенно новый год, на самом деле это будет не так.",shape=box,color=blue];
		j690265104 -> j1257426803;
	j1257426803 [label="и хотя я ДУМАЮ, что знаю, сколько раз это уже случалось, на самом деле я этого не знаю, потому что МОГУ НЕ ПОМНИТЬ ЭТОГО",shape=box,color=blue];
		j1257426803 -> j3264843143;
	j3264843143 [label="Что, если то, что я помню как Первый виток, на самом деле был виток номер пятнадцать тысяч сорок два?",shape=box,color=blue];
		j3264843143 -> j1853128627;
	j1853128627 [label="а потом я подумала, ну и ладно, можно пустить всё на самотёк, сойти с ума и делать всё, что захочу, потому что всегда можно снова ударить кулаком по полу и всё обнулить.",shape=box,color=blue];
		j1853128627 -> j1396817909;
	j1396817909 [label="но ПОТОМ я подумала: нет, подожди, а что, если это тот момент, когда всё действительно сработает? Когда мы наконец-то перейдём с 1999 года в 2000 год?",shape=box,color=blue];
		j1396817909 -> j2487248651;
	j2487248651 [label="Я не хочу выглядеть полной идиоткой в этом единственном витке, который окажется решающим в 1999 году. Я бы себе не простила.",shape=box,color=blue];
		j2487248651 -> j1677337680;
	j1677337680 [label="Однажды настанет время Солнцестояния, а не просто бесконечной зимы, чтобы использовать унылую старую аналогию.",shape=box,color=blue];
		j1677337680 -> j420725480;
	j420725480 [label="Check boolean EleanorDating",color=orange];
		j420725480 -> j1761001528 [label=true,color=green];
		j420725480 -> j3361101688 [label=false,color=brown];
	j1761001528 [label="Нам с тобой просто придётся поддерживать друг друга в тепле до тех пор. x",shape=box,color=blue];
		j1761001528 -> "Chat ends.";
	j3361101688 [label="До тех пор нам всем придётся согревать друг друга.",shape=box,color=blue];
		j3361101688 -> "Chat ends.";
	"Chat ends." [color=orange];
}