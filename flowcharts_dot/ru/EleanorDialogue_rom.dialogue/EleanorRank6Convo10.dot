		"EleanorRank6Convo10 begins." -> j2041660623;
	j2041660623 [label="Поэтому я подумала: год, как всегда, завершится в конце декабря, и хотя это будет ощущаться как совершенно новый год, на самом деле это будет не так.",shape=box,color=blue];
		j2041660623 -> j4034218330;
	j4034218330 [label="и хотя я ДУМАЮ, что знаю, сколько раз это уже случалось, на самом деле я этого не знаю, потому что МОГУ НЕ ПОМНИТЬ ЭТОГО",shape=box,color=blue];
		j4034218330 -> j3567377736;
	j3567377736 [label="Что, если то, что я помню как Первый виток, на самом деле был виток номер пятнадцать тысяч сорок два?",shape=box,color=blue];
		j3567377736 -> j2626011556;
	j2626011556 [label="а потом я подумала, ну и ладно, можно пустить всё на самотёк, сойти с ума и делать всё, что захочу, потому что всегда можно снова ударить кулаком по полу и всё обнулить.",shape=box,color=blue];
		j2626011556 -> j540052669;
	j540052669 [label="но ПОТОМ я подумала: нет, подожди, а что, если это тот момент, когда всё действительно сработает? Когда мы наконец-то перейдём с 1999 года в 2000 год?",shape=box,color=blue];
		j540052669 -> j1176125732;
	j1176125732 [label="Я не хочу выглядеть полной идиоткой в этом единственном витке, который окажется решающим в 1999 году. Я бы себе не простила.",shape=box,color=blue];
		j1176125732 -> j1626224882;
	j1626224882 [label="Однажды настанет время Солнцестояния, а не просто бесконечной зимы, чтобы использовать унылую старую аналогию.",shape=box,color=blue];
		j1626224882 -> j420725480;
