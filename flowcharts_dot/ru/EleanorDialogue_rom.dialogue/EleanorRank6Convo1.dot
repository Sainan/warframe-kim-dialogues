		j3580897117 -> j3690064145;
	j3285732478 [label="Мой Скиталец. Войдя в мою жизнь и перевернув её с ног на голову. Из всех возможных, выбор пал на меня. Ты оставляешь меня с открытыми глазами и в полном изумлении.",shape=box,color=blue];
