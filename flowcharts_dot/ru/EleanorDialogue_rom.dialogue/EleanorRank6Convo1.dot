		j1556304216 -> j3633482616;
	j4157190938 [label="Помню, как подумала: «Ну вот, это чертовски неудобно, Элеонора, теперь ты точно выставишь себя полной дурой».",shape=box,color=blue];
		j4157190938 -> j1277656034;
	j3633482616 [label="Тот момент, когда я поняла, что моя жизнь изменилась благодаря тебе. С твоим появлением в моём сердце. Ты- часть семьи.",shape=box,color=blue];
		j3633482616 -> j3547196129;
	j1277656034 [label="Но я не помню, когда и как это произошло.",shape=box,color=blue];
		j1277656034 -> j2227507717;
		j1277656034 -> j14299713;
	j3547196129 [label="Наверное, мне стоит сказать спасибо. За то, что слушаешь. За то, что развлекаешься моими дикими фантазиями. И, что самое важное, за то, мы друзья.",shape=box,color=blue];
		j3547196129 -> j3792435852;
	j2227507717 [label="Я... ох. Я не чувствую готовности к такому уровню привязанности... Прости.",shape=box,color=red];
