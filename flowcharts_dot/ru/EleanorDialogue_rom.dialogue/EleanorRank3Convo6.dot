digraph {
	1333 [label="EleanorRank3Convo6 begins.",color=orange];
		1333 -> 1334;
	1334 [label="Знаешь, что было самым лучшим в Хёльвании до того, как её захватила Скальдра?",shape=box,color=blue];
		1334 -> 1335;
		1334 -> 1336;
		1334 -> 1337;
		1334 -> 1338;
		1334 -> 1339;
	1335 [label="Ночная жизнь?",shape=box,color=red];
		1335 -> 1342;
	1336 [label="Подпольные бойцовские турниры?",shape=box,color=red];
		1336 -> 1343;
	1337 [label="Шопинг?",shape=box,color=red];
		1337 -> 1344;
	1338 [label="Без понятия.",shape=box,color=red];
		1338 -> 1345;
	1339 [label="Мне всё равно. [Завершить]",shape=box,color=red];
		1339 -> 1340;
	1342 [label="О Боги. Хирургически идеальные люди, кайфующие на непроверенных препаратах? Нет.",shape=box,color=blue];
		1342 -> 1346;
	1343 [label="Слушай. У меня нет ничего против того, чтобы посмотреть, как двое потных мужиков жёстко сходятся в поединке. Но нет.",shape=box,color=blue];
		1343 -> 1346;
	1344 [label="Хорошая догадка. Можно было бы ожидать что угодно — от набора из сумочки и перчаток от Бресслина до человеческого глаза в куске льда. Но нет.",shape=box,color=blue];
		1344 -> 1346;
	1345 [label="Ну конечно, ты ничего не понимаешь. Ты в этом не имеешь опыта.",shape=box,color=blue];
		1345 -> 1346;
	1340 [label="Буу.",shape=box,color=blue];
		1340 -> 1341;
	1346 [label="Баня!",shape=box,color=blue];
		1346 -> 1347;
	1341 [label="Chat ends.",color=orange];
	1347 [label="Не знаю, есть ли что-то подобное там, где ты находишься. Это такие храмы, думаю, так их можно назвать, обычно с залами Сола и Луа. Можно расслабиться в общем или частном бассейне. Всё пахнет травами и паром, и это ТАК здорово помогает привести мысли в порядок.",shape=box,color=blue];
		1347 -> 1348;
	1348 [label="В Хёльвании всегда была невероятно важна традиция ритуальной чистоты. Думаю, это уходит корнями к горячим источникам, на которых и был построен город.",shape=box,color=blue];
		1348 -> 1349;
	1349 [label="Вся эта чушь о «чистоте», которую несёт Виктор? Он просто повторяет древнюю песню. Всем гражданам понятно, откуда у него такие идеи.",shape=box,color=blue];
		1349 -> 1350;
	1350 [label="Я раньше обожала платить лишние хёллары за то, чтобы крепкий профессионал выбил из моих мышц всю напряжённость. Тебе бы это понравилось, уверена.",shape=box,color=blue];
		1350 -> 1351;
		1350 -> 1352;
		1350 -> 1353;
	1351 [label="Я в этом сомневаюсь.",shape=box,color=red];
		1351 -> 1354;
	1352 [label="Звучит как развлечение, которое мне могло бы понравиться.",shape=box,color=red];
		1352 -> 1357;
	1353 [label="Что с ними случилось?",shape=box,color=red];
		1353 -> 1359;
	1354 [label="Ты запросто разгуливаешь в костюме из тела заражённого человека, но массажи для тебя — это уже чересчур?",shape=box,color=blue];
		1354 -> 1355;
	1357 [label="Я знала, что ты мой товарищ по команде.",shape=box,color=blue];
		1357 -> 1358;
	1359 [label="Уверена, ты можешь догадаться. Техрот разрушил так много всего. После вспышек болезни бани просто не могли остаться открытыми.",shape=box,color=blue];
		1359 -> 1360;
	1355 [label="Странно.",shape=box,color=blue];
		1355 -> 1356;
	1358 [label="Жаль, что некоторые из остальных такие зажатые. К сожалению, после вспышек болезни бани не могли оставаться открытыми.",shape=box,color=blue];
		1358 -> 1360;
	1360 [label="Судя по тому, что я видела, некоторые из них теперь фактически стали рассадниками инфекции. Честно говоря, это разрывает мне сердце. Помню, как видела мраморные и мозаичные полы тысячелетней давности, покрытые ползущей плотью.",shape=box,color=blue];
		1360 -> 1361;
	1356 [label="Chat ends.",color=orange];
	1361 [label="У вас в ваше время есть что-то подобное?",shape=box,color=blue];
		1361 -> 1362;
	1362 [label="Священные общественные бани? Нет, не припоминаю.",shape=box,color=red];
		1362 -> 1363;
	1363 [label="Так что же делают люди, чтобы расслабиться?",shape=box,color=blue];
		1363 -> 1364;
		1363 -> 1365;
		1363 -> 1366;
	1364 [label="Есть Ратуум.",shape=box,color=red];
		1364 -> 1367;
	1365 [label="Некоторые делают ставки в Индексе.",shape=box,color=red];
		1365 -> 1368;
	1366 [label="Коми существует уже приличное время.",shape=box,color=red];
		1366 -> 1369;
	1367 [label="Звучит, как Амир, издающий звуки эффектов сам для себя...",shape=box,color=blue];
		1367 -> 1370;
	1368 [label="Биржевые маклеры?",shape=box,color=blue];
		1368 -> 1371;
	1369 [label="Коми? Чёрные и белые фишки? Свадебная война Сол и Луа?",shape=box,color=blue];
		1369 -> 1372;
	1370 [label="Это фишка Гринир. Ритуальная арена боя, транслируемая на всю Систему.",shape=box,color=red];
		1370 -> 1373;
	1371 [label="...вот как? Это как сочетание торговли акциями и насилия в мини-футболе. Я знаю, это звучит странно.",shape=box,color=red];
		1371 -> 1374;
	1372 [label="Эм... да? Подожди, это то, в чём смысл Коми?",shape=box,color=red];
		1372 -> 1375;
	1373 [label="Для них это очень важно. Очень серьёзно.",shape=box,color=red];
		1373 -> 1376;
	1374 [label="Корпус просто сходит с ума по этому поводу.",shape=box,color=red];
		1374 -> 1377;
	1375 [label="Мы знаем её только как настольную игру!",shape=box,color=red];
		1375 -> 1378;
	1376 [label="Папа и Артур каждый субботний вечер вместе смотрели рестлинг.",shape=box,color=blue];
		1376 -> 1380;
	1377 [label="Но они же твои враги, разве нет? Или в командных играх действует какое-то перемирие?",shape=box,color=blue];
		1377 -> 1383;
	1378 [label="Орокин это нравилось. Это даже в Дувири.",shape=box,color=red];
		1378 -> 1379;
	1380 [label="+10 Chemistry",color=orange];
		1380 -> 2815;
	1383 [label="+10 Chemistry",color=orange];
		1383 -> 2079;
	1379 [label="Для меня оказалось неожиданностью, что она настолько древняя.",shape=box,color=red];
		1379 -> 1384;
	2815 [label="Подкинь ему несколько записей Ратуума, если будет возможность. Думаю, ему это понравится.",shape=box,color=blue];
		2815 -> 1381;
	2079 [label="Что я говорю? Конечно, существует. Просто люди такие.",shape=box,color=blue];
		2079 -> 1382;
	1384 [label="Древняя? Это СВЯЩЕННО! Но при этом весело. Прекрасное сочетание.",shape=box,color=blue];
		1384 -> 1385;
	1381 [label="Chat ends.",color=orange];
	1382 [label="Chat ends.",color=orange];
	1385 [label="Всё сводится к двум основным принципам, знаешь? Разум и тело. Символ и значение. Сол и Луа.",shape=box,color=blue];
		1385 -> 1387;
	1387 [label="+20 Chemistry",color=orange];
		1387 -> 1386;
	1386 [label="Артур и я играли в Коми каждый год на Солнцестояние. Почему мы вообще перестали?",shape=box,color=blue];
		1386 -> 1388;
	1388 [label="Chat ends.",color=orange];
}