digraph {
	386 [label="EleanorRank2Convo2 begins.",color=orange];
		386 -> 387;
		386 -> 388;
	387 [label="Как ты оказалась здесь, в Хёльвании?",shape=box,color=red];
		387 -> 389;
	388 [label="Каково было расти с Артуром?",shape=box,color=red];
		388 -> 390;
	389 [label="Долгая история.",shape=box,color=blue];
		389 -> 391;
		389 -> 392;
	390 [label="Идиллия. Мы никогда не ссорились, даже ни разу. Хранили секреты друг друга. Он даже позволял мне заплетать ему косички.",shape=box,color=blue];
		390 -> 393;
	391 [label="Мне вообще стоит спрашивать? Или этот разговор лучше отложить на потом?",shape=box,color=red];
		391 -> 397;
	392 [label="Ты собираешься рассказать мне правду?",shape=box,color=red];
		392 -> 398;
	393 [label="Неудивительно, что все остальные завидуют мне и хотят, чтобы Артур был их братом тоже.",shape=box,color=blue];
		393 -> 395;
		393 -> 394;
	397 [label="Позже, если только ты не улизнёшь из города, а я не мутирую в яростную бесформенную массу мышечной ткани и ртов.",shape=box,color=blue];
		397 -> 399;
	398 [label="Может быть, когда я буду уверена, что ты не будешь бегать туда-сюда между мной и Артуром, сравнивая заметки.",shape=box,color=blue];
		398 -> 400;
	395 [label="Держу пари, он даже позволял тебе практиковаться на нём с макияжем.",shape=box,color=red];
		395 -> 404;
	394 [label="Как мило. [Завершить]",shape=box,color=red];
		394 -> 396;
	399 [label="Потому что ты можешь узнать вещи о некоторых людях, которые тебе будет трудно принять.",shape=box,color=blue];
		399 -> 402;
	400 [label="Не думаю, что он сильно раскрылся перед тобой.",shape=box,color=blue];
		400 -> 401;
	404 [label="На самом деле, он так и делал. До недавнего времени, если быть точной.",shape=box,color=blue];
		404 -> 405;
	396 [label="Chat ends.",color=orange];
	402 [label="Не так ли я загадочна? Прямо как Сфинкс. Р-р-р.",shape=box,color=blue];
		402 -> 403;
	401 [label="Да, он довольно закрытый человек.",shape=box,color=red];
		401 -> 406;
	405 [label="Жаль, что он не носит подводку чаще. Он утверждает, что это слишком хлопотно. Предпочитает обгоревшую пробку.",shape=box,color=blue];
		405 -> 413;
	403 [label="Chat ends.",color=orange];
	406 [label="Артур считает, что есть вещи, о которых не стоит говорить. Он старомоден в этом. «Это плохо для боевого духа», скажет он. «Лагерные сплетни». «Будь осторожен, может быть, распространяешь вражескую пропаганду»",shape=box,color=blue];
		406 -> 408;
	413 [label="Тёмный размазанный взгляд ему идёт, но он не знает, когда остановиться с тенями для глаз. Он пытается быть мрачным богом с щетиной, со скрещёнными руками у автобусных остановок в два часа ночи, но продолжает и превращается в похмельного эмо-панду. И потом удивляется, почему люди не воспринимают его всерьёз.",shape=box,color=blue];
		413 -> 414;
	408 [label="Всегда солдат. Бывает ли он НЕ на дежурстве?",shape=box,color=red];
		408 -> 409;
	414 [label="Update boolean EleanorArthurPanda",color=orange];
		414 -> 411;
		414 -> 412;
		414 -> 410;
	409 [label="О, это у нас семейное.",shape=box,color=blue];
		409 -> 435;
	411 [label="Не знаю, а по-моему, он довольно сексуален... для похмельной эмо-панды.",shape=box,color=red];
		411 -> 416;
	412 [label="Я бы позволила тебе практиковаться с макияжем на мне, если хочешь. ;)",shape=box,color=red];
		412 -> 418;
	410 [label="Мне трудно воспринимать тебя СЕРЬЁЗНО.",shape=box,color=red];
		410 -> 407;
	435 [label="У папы на стене в туалете висел старый армейский плакат времён Бомбардировки 37-го года. Квадратная челюсть лояльного солдата, выбивающего очки с тощего нытика. Подпись: «Заткни ублюдка, который распространяет чушь!»",shape=box,color=blue];
		435 -> 437;
	416 [label="Это полностью твоё право, и я не буду осуждать тебя за твой выбор",shape=box,color=blue];
		416 -> 417;
	418 [label="КАК ТЫ СМЕЕШЬ",shape=box,color=blue];
		418 -> 419;
	407 [label="Что ж, именно это мне и нужно.",shape=box,color=blue];
		407 -> 415;
	437 [label="Артур любил это, потому что это было «грубо». Но он воспринял урок. «Не говори о вещах, которые могут навредить тем, о ком мы заботимся».",shape=box,color=blue];
		437 -> 438;
		437 -> 439;
	417 [label="Я даже пожелаю тебе удачной охоты, если тебе этого хочется",shape=box,color=blue];
		417 -> 420;
	419 [label="Не надо принижать священный ритуал нанесения друг другу макияжа",shape=box,color=blue];
		419 -> 421;
	415 [label="Chat ends.",color=orange];
	438 [label="Дай ему поблажку. Это разумно для боевой команды. Нельзя плыть на дырявом корабле.",shape=box,color=red];
		438 -> 442;
	439 [label="Это неправильно. Если ты не говоришь о болезненных вещах, ты просто… запираешь это внутри себя.",shape=box,color=red];
		439 -> 440;
	420 [label="ОДНАКО",shape=box,color=blue];
		420 -> 422;
	421 [label="Мы даже близко не знакомы достаточно, чтобы это обсуждать.",shape=box,color=blue];
		421 -> 426;
	442 [label="Всё хорошо до тех пор, пока это не используется, чтобы заткнуть тебя.",shape=box,color=blue];
		442 -> 443;
	440 [label="А если запираешь внутри, это может выйти из-под контроля. ... У меня есть некоторый опыт в этом...",shape=box,color=red];
		440 -> 441;
	422 [label="Если я хотя бы НА МГНОВЕНИЕ заподозрю, что ты используешь всё, чем я поделюсь с тобой, чтобы пробраться в его бронированные штаны...",shape=box,color=blue];
		422 -> 423;
	426 [label="Извини, дай мне перевести дыхание.",shape=box,color=blue];
		426 -> 427;
	443 [label="Всю мою жизнь были вещи, о которых НАДО было поговорить. Были разговоры, которые мы ДОЛЖНЫ были провести. Бабушка Кэлли. Кристофер. Особняк Кавона. Они гнили между нами.",shape=box,color=blue];
		443 -> 444;
	441 [label="Именно. Всё хорошо до тех пор, пока это не используется, чтобы заткнуть тебя.",shape=box,color=blue];
		441 -> 443;
	423 [label="... я стану монстром, каким люди думают, что я являюсь, ровно настолько, чтобы ты пожелала вернуться на арену казней.",shape=box,color=blue];
		423 -> 424;
	427 [label="... Я не говорю никогда. Хорошо? И мне только что пришло в голову, что это, возможно, впервые для тебя.",shape=box,color=blue];
		427 -> 428;
	444 [label="Но нет. Говорить об этом было Совершенно Недопустимо. Ставки были слишком высоки.",shape=box,color=blue];
		444 -> 445;
	424 [label="Update boolean EleanorArthurHunt",color=orange];
		424 -> 425;
	428 [label="Так что я прощаю тебя на этот раз. Но, серьёзно, это не та тема, над которой стоит шутить.",shape=box,color=blue];
		428 -> 429;
	445 [label="Так что, поскольку альтернатива заключалась в том, чтобы больше никогда не чувствовать себя чистой в своей собственной шкуре, я взяла за правило узнавать о других вещах, о которых люди не хотели говорить, и я говорила о них. Я писала о таких вещах, что вскоре люди пытались столкнуть мою машину с горного перевала в Гибернии.",shape=box,color=blue];
		445 -> 446;
		445 -> 447;
	425 [label="Chat ends.",color=orange];
	429 [label="Для Артура это много значило, доверить мне такое. Для меня было ещё важнее то, что я смогла заставить его почувствовать себя по-настоящему хорошо.",shape=box,color=blue];
		429 -> 430;
	446 [label="Помни, я не отсюда. О чём вещи?",shape=box,color=red];
		446 -> 448;
	447 [label="Гиберния что?",shape=box,color=red];
		447 -> 449;
	430 [label="Боже мой. Теперь я чувствую, что должна извиниться перед тобой, а я обычно этого не делаю.",shape=box,color=blue];
		430 -> 432;
	448 [label="Обычные вещи. Коррупция на самых верхах власти. Скандалы с отцовством в королевской семье Хёльвании. Молочная смесь с токсинами, которую распространяли среди кормящих матерей в «нежелательных» районах Нового Холивелла.",shape=box,color=blue];
		448 -> 450;
	449 [label="Правда, да. Турист из нашего времени. Обычные вещи. Коррупция на самых верхах власти. Скандалы с отцовством в королевской семье Хёльвании. Молочная смесь с токсинами, которую распространяли среди кормящих матерей в «нежелательных» районах Нового Холивелла.",shape=box,color=blue];
		449 -> 450;
	432 [label="+15 Chemistry",color=orange];
		432 -> 431;
	450 [label="Потому что когда кто-то говорит тебе замолчать, ты НИКОГДА этого не делаешь.",shape=box,color=blue];
		450 -> 451;
		450 -> 452;
	431 [label="Считаем это уроком, ладно?",shape=box,color=blue];
		431 -> 433;
	451 [label="Ты напоминаешь мне Ночную Нору.",shape=box,color=red];
		451 -> 456;
	452 [label="Согласна.",shape=box,color=red];
		452 -> 457;
	433 [label="Update boolean EleanorHasFlirted",color=orange];
		433 -> 434;
	456 [label="+20 Chemistry",color=orange];
		456 -> 453;
	457 [label="+15 Chemistry",color=orange];
		457 -> 454;
	434 [label="Chat ends.",color=orange];
	453 [label="Предполагаю, это комплимент? Расскажи мне о ней как-нибудь, когда я не буду хотеть оторвать кому-нибудь голову.",shape=box,color=blue];
		453 -> 458;
	454 [label="Так или иначе, Артур хотел, чтобы я замолчала, ради семьи. Теперь я вообще не разговариваю. Но почему-то Артур всё равно не доволен.",shape=box,color=blue];
		454 -> 455;
	458 [label="Chat ends.",color=orange];
	455 [label="Вот скажи, что сестра должна делать?",shape=box,color=blue];
		455 -> 459;
