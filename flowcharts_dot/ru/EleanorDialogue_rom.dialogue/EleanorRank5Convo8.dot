digraph {
	2659 [label="EleanorRank5Convo8 begins.",color=orange];
		2659 -> 2660;
	2660 [label="Я тут подумала. Мне нужно кое-что сделать.",shape=box,color=blue];
		2660 -> 2661;
	2661 [label="Мне понадобится помощь.",shape=box,color=blue];
		2661 -> 2662;
		2661 -> 2663;
	2662 [label="Всегда здесь для тебя. О чем ты думаешь?",shape=box,color=red];
		2662 -> 2665;
	2663 [label="Извини, сейчас не могу общаться. [Завершить]",shape=box,color=red];
		2663 -> 2664;
	2665 [label="Check boolean EleanorChristopher2",color=orange];
		2665 -> 2667 [label=true,color=green];
		2665 -> 2666 [label=false,color=brown];
	2664 [label="Chat ends.",color=orange];
	2667 [label="Итак. Кристофер.",shape=box,color=blue];
		2667 -> 2675;
	2666 [label="Check boolean EleanorChristopher1",color=orange];
		2666 -> 2671 [label=true,color=green];
		2666 -> 2668 [label=false,color=brown];
	2675 [label="Я держалась за него все эти годы. Артур тоже. Каждый год мы проводим ритуал в его память. Но не в этом году. Я не смогла это пережить.",shape=box,color=blue];
		2675 -> 2676;
	2671 [label="Чтобы... очень коротко и трагично рассказать всю историю... Кристофер погиб от взрыва бомбы до того, как мы успели пожениться.",shape=box,color=blue];
		2671 -> 2672;
	2668 [label="Пришло время рассказать тебе о Кристофере.",shape=box,color=blue];
		2668 -> 2669;
	2676 [label="Я не знаю, существуют ли призраки, но это вполне возможно, поскольку я позволила ему стать одним из них.",shape=box,color=blue];
		2676 -> 2677;
	2672 [label="Возможно, я расскажу тебе всю историю в другой раз. А может, и нет.",shape=box,color=blue];
		2672 -> 2673;
	2669 [label="Лучший друг Артура. Мы были помолвлены. Я думала, что влюблена в него.",shape=box,color=blue];
		2669 -> 2670;
	2677 [label="Не будь так строга к себе. Ты была влюблена в этого парня.",shape=box,color=red];
		2677 -> 2678;
	2673 [label="Я рассказываю тебе все это сейчас, потому что...",shape=box,color=blue];
		2673 -> 2674;
	2670 [label="Update boolean EleanorChristopher1",color=orange];
		2670 -> 2671;
	2678 [label="О. Я ДУМАЛА, что это так. Я любила его, но я даже не знала, влюблена я в него или нет.",shape=box,color=blue];
		2678 -> 2679;
	2674 [label="Update boolean EleanorChristopher2",color=orange];
		2674 -> 2675;
	2679 [label="Звучит ужасно, не правда ли? Но это правда. В то время это просто не казалось важным. Потом он умер, и это стало тем, о чём была наша история.",shape=box,color=blue];
		2679 -> 2680;
	2680 [label="Всё, что я в нём ценила, теперь затмилось тем, как он умер. Я не могу думать о нём, без того чтобы этот комок не подступал к горлу.",shape=box,color=blue];
		2680 -> 2681;
	2681 [label="Это несправедливо. ПО ОТНОШЕНИЮ К НЕМУ. Он заслуживает лучшего.",shape=box,color=blue];
		2681 -> 2682;
		2681 -> 2683;
	2682 [label="Понимаю. Полностью. Я выбираю помнить своих родителей так, как они того заслуживали.",shape=box,color=red];
		2682 -> 2684;
	2683 [label="То, что произошло, было ужасно. Это не исправить. Но мы не можем позволить этому быть единственным, за что мы держимся.",shape=box,color=red];
		2683 -> 2684;
	2684 [label="Так почему же я чувствую себя такой виноватой?",shape=box,color=blue];
		2684 -> 2685;
	2685 [label="Почему мне кажется, что отпустить его — это то же самое, что выбросить его?",shape=box,color=blue];
		2685 -> 2686;
		2685 -> 2688;
	2686 [label="Потому что ты носила память о нём так долго, что не знаешь, как остановиться.",shape=box,color=red];
		2686 -> 2687;
	2688 [label="Потому что ты беспокоишься, что никто другой никогда не сможет тебя полюбить.",shape=box,color=red];
		2688 -> 2689;
	2687 [label="Боги. Это чертовски верно, знаешь ли.",shape=box,color=blue];
		2687 -> 2692;
	2689 [label="Check boolean EleanorDating",color=orange];
		2689 -> 2690 [label=true,color=green];
		2689 -> 2691 [label=false,color=brown];
	2692 [label="Мы абсолютно не умеем справляться с этим, моя семья. Мы всё в себе держим. Мы надеваем смелое лицо и насвистываем в окопах. Это помогает нам пройти через всё, как и нашим родителям. Но мы не знаем, как остановиться.",shape=box,color=blue];
		2692 -> 2693;
	2690 [label="Неужели я настолько поверхностна?",shape=box,color=blue];
		2690 -> 2694;
	2691 [label="Сомневаюсь, что даже Кристофер любил бы меня в моём нынешнем состоянии.",shape=box,color=blue];
		2691 -> 2696;
	2693 [label="Что мне делать? Как мне отпустить его?",shape=box,color=blue];
		2693 -> 2698;
	2694 [label="Я не чувствую, что заслуживаю ни одного из вас прямо сейчас.",shape=box,color=blue];
		2694 -> 2695;
	2696 [label="... Нет. Это нечестно. Я совсем нечестно поступаю с ним, правда?",shape=box,color=blue];
		2696 -> 2697;
	2698 [label="Check boolean LettieDiasdeMuertos",color=orange];
		2698 -> 2699 [label=true,color=green];
		2698 -> 2700 [label=true,color=green];
		2698 -> 2701 [label=true,color=green];
		2698 -> 2700 [label=false,color=brown];
		2698 -> 2701 [label=false,color=brown];
	2695 [label="Я думаю... Я хочу быть твоей ВСЯ. Я не хочу, чтобы часть меня была скована бесконечным трауром.",shape=box,color=blue];
		2695 -> 2698;
	2697 [label="Он не хотел бы встать на пути моего счастья. Он был добрым.",shape=box,color=blue];
		2697 -> 2698;
	2699 [label="Я действительно думаю, что Лэтти могла бы помочь.",shape=box,color=red];
		2699 -> 2702;
	2700 [label="Ты можешь написать ему письмо.",shape=box,color=red];
		2700 -> 2703;
	2701 [label="Поговори с Артуром, может быть. Он переживает это горе вместе с тобой с самого начала.",shape=box,color=red];
		2701 -> 2704;
	2702 [label="Лэтти?",shape=box,color=blue];
		2702 -> 2705;
	2703 [label="Часть меня думает, что это глупая идея. Он не будет это читать. Он мёртв. Но...",shape=box,color=blue];
		2703 -> 2706;
	2704 [label="Да, это так. Может быть, это часть проблемы. Я знаю, что он расстроен, что я не продолжила нашу маленькую церемонию памяти в этом году.",shape=box,color=blue];
		2704 -> 2707;
	2705 [label="Почему она?",shape=box,color=blue];
		2705 -> 2708;
	2706 [label="... чем больше я об этом думаю, тем менее глупым это кажется.",shape=box,color=blue];
		2706 -> 2710;
	2707 [label="Я просто... должна попрощаться с Кристофером по-своему на этот раз. Раз и навсегда.",shape=box,color=blue];
		2707 -> 2711;
	2708 [label="У неё большой опыт. Она знает все о поминовении усопших.",shape=box,color=red];
		2708 -> 2709;
	2710 [label="Да. Я сделаю это. Мне нужно сказать ему кое-что. То, чего я никогда не говорила, когда он был жив. Может, тогда он сможет упокоиться.",shape=box,color=blue];
		2710 -> 2712;
	2711 [label="Для Артура он навсегда останется потерянным братом, павшим солдатом. Это траур, который он знает и понимает. Но я не должна.",shape=box,color=blue];
		2711 -> 2713;
	2709 [label="Я точно знаю, что если бы ты уважительно попросила у неё совета, она бы тебе не отказала.",shape=box,color=red];
		2709 -> 2720;
	2712 [label="Спасибо за внимание и за совет.",shape=box,color=blue];
		2712 -> 2714;
	2713 [label="Я больше не могу делать так, как Артур. Я думаю... если я просто скажу ему это, он поймёт.",shape=box,color=blue];
		2713 -> 2718;
	2720 [label="…",shape=box,color=blue];
		2720 -> 2721;
	2714 [label="+20 Chemistry",color=orange];
		2714 -> 2715;
	2718 [label="+10 Chemistry",color=orange];
		2718 -> 2719;
	2721 [label="Да.",shape=box,color=blue];
		2721 -> 2722;
	2715 [label="Я никогда, никогда этого не забуду.",shape=box,color=blue];
		2715 -> 2716;
	2719 [label="Спасибо.",shape=box,color=blue];
		2719 -> 2717;
	2722 [label="Пришло время.",shape=box,color=blue];
		2722 -> 2723;
	2716 [label="Chat ends.",color=orange];
	2717 [label="Chat ends.",color=orange];
	2723 [label="+20 Chemistry",color=orange];
		2723 -> 2724;
	2724 [label="Я думаю, мне нужно отпустить МНОГОЕ.",shape=box,color=blue];
		2724 -> 2725;
	2725 [label="Дай мне с ней поговорить. Если она пошлёт меня куда подальше, ну и ладно. Но хотя бы я попробую, правильно?",shape=box,color=blue];
		2725 -> 2726;
	2726 [label="Попробовать стоит. Лэтти не такая бессердечная, как думают люди.",shape=box,color=red];
		2726 -> 2727;
	2727 [label="Точно. Живя так, как мы живём, и делая то, что делаем каждый день, мы все выстраиваем стены. Просто забываем оставить в них двери.",shape=box,color=blue];
		2727 -> 2728;
	2728 [label="Спасибо, что бьёшься своей прекрасной головой о мою стену.",shape=box,color=blue];
		2728 -> 2729;
	2729 [label="Chat ends.",color=orange];
}