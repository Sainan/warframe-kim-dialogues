digraph {
	924 [label="EleanorRank3Convo2 begins.",color=orange];
		924 -> 926;
	926 [label="Check boolean EleanorIndifference",color=orange];
		926 -> 925 [label=true,color=green];
		926 -> 927 [label=false,color=brown];
	925 [label="Ты здесь? Мне нужно поговорить.",shape=box,color=blue];
		925 -> 928;
		925 -> 929;
	927 [label="Ты здесь? Мне нужно поговорить с тобой кое о чём. Это серьёзно.",shape=box,color=blue];
		927 -> 931;
		927 -> 929;
	928 [label="Я здесь.",shape=box,color=red];
		928 -> 932;
	929 [label="Извини. Не сейчас. [Завершить]",shape=box,color=red];
		929 -> 930;
	931 [label="Я здесь. Говори.",shape=box,color=red];
		931 -> 933;
	932 [label="Помнишь, как я рассказывала тебе о том, как пыталась прикоснуться своим разумом к разуму Русалки, и вместо этого вступила в контакт с Безразличием?",shape=box,color=blue];
		932 -> 935;
	930 [label="Chat ends.",color=orange];
	933 [label="Спасибо.",shape=box,color=blue];
		933 -> 934;
	935 [label="Конечно, помню.",shape=box,color=red];
		935 -> 938;
	934 [label="Ты понимаешь, что произошло с майором Русалкой?",shape=box,color=blue];
		934 -> 936;
		934 -> 937;
	938 [label="Верно. Тогда я была не готова об этом говорить. Теперь готова, если ты не против.",shape=box,color=blue];
		938 -> 945;
	936 [label="Её использовали. Безразличие управляло ею, как марионеткой.",shape=box,color=red];
		936 -> 939;
	937 [label="Уверена, её «вычистили» и использовали как… ну… варфрейм?..",shape=box,color=red];
		937 -> 940;
	945 [label="Если ты уверена.",shape=box,color=red];
		945 -> 946;
	939 [label="«Безразличие». Так вы его называете?",shape=box,color=blue];
		939 -> 941;
	940 [label="Вычистили, да.",shape=box,color=blue];
		940 -> 942;
	946 [label="Уверена.",shape=box,color=blue];
		946 -> 947;
	941 [label="Спасибо.",shape=box,color=blue];
		941 -> 943;
	942 [label="Но что бы ни управляло ею, это было не таким, как ты.",shape=box,color=blue];
		942 -> 944;
	947 [label="Это существо, это присутствие — это то, с чем нам в итоге придётся сражаться. Теперь я знаю это наверняка.",shape=box,color=blue];
		947 -> 951;
	943 [label="Дать этому имя — это словно вернуть себе крошечную частичку контроля.",shape=box,color=blue];
		943 -> 948;
	944 [label="Всё человеческое в этом было карикатурой.",shape=box,color=blue];
		944 -> 949;
	951 [label="Пожалуйста, скажи правду. Ты веришь, что есть хоть какая-то надежда?",shape=box,color=blue];
		951 -> 956;
		951 -> 957;
		951 -> 958;
	948 [label="Я прикоснулась к этой штуке своим разумом. Я думала, что исследую разум Русалки, но… внешние слои просто рухнули, как мокрый гипсокартон, и я оказалась в этом. Захлёбываясь.",shape=box,color=blue];
		948 -> 950;
	949 [label="Оно было примерно таким же человеческим, как манекен в магазине. Разобранное на части.",shape=box,color=blue];
		949 -> 952;
	956 [label="На данном этапе? ... Нет.",shape=box,color=red];
		956 -> 960;
	957 [label="Честно? Я... не уверена.",shape=box,color=red];
		957 -> 961;
	958 [label="Да, я верю.",shape=box,color=red];
		958 -> 962;
	950 [label="Update boolean EleanorIndifference",color=orange];
		950 -> 951;
	952 [label="Я прикоснулась к нему, понимаешь? Своим разумом. Я пыталась проникнуть в неё, но её там не было.",shape=box,color=blue];
		952 -> 953;
	960 [label="По крайней мере, это было честно.",shape=box,color=blue];
		960 -> 963;
	961 [label="Я понимаю.",shape=box,color=blue];
		961 -> 964;
	962 [label="Не говори мне почему.",shape=box,color=blue];
		962 -> 965;
	953 [label="Я понимаю, о чём ты. Мы называем это Безразличием.",shape=box,color=red];
		953 -> 954;
	963 [label="Хорошо. Пусть надежда умрёт.",shape=box,color=blue];
		963 -> 966;
	964 [label="Есть так много того, чего мы не знаем.",shape=box,color=blue];
		964 -> 967;
	965 [label="Просто держись за эту веру. Позволь мне почувствовать её.",shape=box,color=blue];
		965 -> 968;
	954 [label="Спасибо.",shape=box,color=blue];
		954 -> 955;
	966 [label="Я буду продолжать бороться из чистого упрямства.",shape=box,color=blue];
		966 -> 969;
	967 [label="После всего, что уже произошло в этом году, как нам снова строить разумные планы?",shape=box,color=blue];
		967 -> 970;
	968 [label="Пожалуйста.",shape=box,color=blue];
		968 -> 971;
	955 [label="Дать ему имя — это словно вернуть себе крошечную частичку контроля.",shape=box,color=blue];
		955 -> 959;
	969 [label="Ненависть. Ярость. Что угодно.",shape=box,color=blue];
		969 -> 973;
	970 [label="Может, надежда — это иллюзия. Я не знаю.",shape=box,color=blue];
		970 -> 974;
	971 [label="Я потянулась к Русалке, и это было так, словно мои пальцы коснулись её лица и прошли сквозь него. Маска просто рухнула.",shape=box,color=blue];
		971 -> 975;
	959 [label="Update boolean EleanorIndifference",color=orange];
		959 -> 972;
	973 [label="Лучше, чем апатия. Лучше, чем покорное смирение.",shape=box,color=blue];
		973 -> 978;
	974 [label="Мне бы сейчас это не помешало.",shape=box,color=blue];
		974 -> 977;
	975 [label="То, что было под этим, было похоже на…",shape=box,color=blue];
		975 -> 976;
	972 [label="Я прикоснулась к этой штуке своим разумом. Я думала, что исследую разум Русалки, но… внешние слои просто рухнули, как мокрый гипсокартон, и я оказалась в этом. Захлёбываясь.",shape=box,color=blue];
		972 -> 976;
	978 [label="Я готова.",shape=box,color=blue];
		978 -> 979;
	977 [label="Ах, ну что ж. Пусть будет так. Даже если мы идём вперёд, спотыкаясь в темноте, у нас хотя бы есть компания друг друга.",shape=box,color=blue];
		977 -> 980;
	976 [label="Есть такое слово — «калентура». Это разновидность безумия, которое раньше поражало моряков. Они начинали верить, что зелёное море вокруг — это не вода, а зелёная трава.",shape=box,color=blue];
		976 -> 981;
	979 [label="Chat ends.",color=orange];
	980 [label="Chat ends.",color=orange];
	981 [label="Словно по принуждению, они спрыгнули с корабля на прекрасные зеленые луга, чтобы промчаться по ним. Если их сдерживал товарищ по кораблю, они вступали в драку.",shape=box,color=blue];
		981 -> 982;
	982 [label="Они прыгали за борт, ожидая найти траву. В следующую секунду они оказывались по уши в ледяной темноте.",shape=box,color=blue];
		982 -> 983;
	983 [label="Update boolean EleanorIndifference2",color=orange];
		983 -> 984;
		983 -> 986;
	984 [label="Не думаю, что безопасно говорить об этом таким образом.",shape=box,color=red];
		984 -> 985;
	986 [label="Я здесь. Продолжай.",shape=box,color=red];
		986 -> 987;
	985 [label="Чёрт побери.",shape=box,color=blue];
		985 -> 988;
	987 [label="Есть чувство, для которого нет слова. Ты смотришь на мир и просто ЗНАЕШЬ, что вся эта обычность — здания, машины, люди, работа, рутина — это только тонкая корка над бездонным ужасом. И если люди когда-нибудь поймут это, они начнут кричать и никогда не остановятся.",shape=box,color=blue];
		987 -> 989;
	988 [label="Я едва успела собраться с духом, чтобы говорить об этом, а теперь, что? Мы не упоминаем Дьявола, чтобы случайно не вызвать его?",shape=box,color=blue];
		988 -> 990;
	989 [label="Я провалилась через эту корку.",shape=box,color=blue];
		989 -> 992;
	990 [label="Если ты услышишь крики ночью, это буду я.",shape=box,color=blue];
		990 -> 991;
	992 [label="Это не было пустотой. С пустотой я бы справилась. Это продолжалось бесконечно, но это не был просто холодный космос. Там что-то было вместе со мной.",shape=box,color=blue];
		992 -> 993;
		992 -> 994;
		992 -> 995;
	991 [label="Chat ends.",color=orange];
	993 [label="Глаз?",shape=box,color=red];
		993 -> 997;
	994 [label="Человек, запертый в стене?",shape=box,color=red];
		994 -> 997;
	995 [label="Что это было?",shape=box,color=red];
		995 -> 996;
	997 [label="Я не знаю. Но оно знало, что я там. Оно ОСОЗНАВАЛО меня. Как слон осознаёт муху, ползающую по его глазу.",shape=box,color=blue];
		997 -> 998;
	996 [label="+5 Chemistry",color=orange];
		996 -> 997;
	998 [label="Я помню, как подумала: «Нечто такое огромное не должно знать о моём существовании».",shape=box,color=blue];
		998 -> 999;
	999 [label="Оно испытывало ко мне абсолютное пренебрежение, такое монументальное безразличие, что мне захотелось перестать существовать прямо на месте.",shape=box,color=blue];
		999 -> 1000;
		999 -> 1001;
	1000 [label="Оно... всегда так.",shape=box,color=red];
		1000 -> 1002;
	1001 [label="Что ты сделала?",shape=box,color=red];
		1001 -> 1002;
	1002 [label="Думаю, я бы справилась, если бы оно ненавидело меня. Тогда у меня была бы какая-то ценность, какое-то значение. Но оно считало меня бессмысленной, и я увидела то, что видело оно. Я была песчинкой. Ничем.",shape=box,color=blue];
		1002 -> 1003;
	1003 [label="Всё, чем я когда-либо была, каждый нежный момент, каждый смех, каждая частичка Элеоноры Найтингейл разлетелись в этом шторме.",shape=box,color=blue];
		1003 -> 1004;
	1004 [label="Оно почувствовало, как мой свет гаснет, и, клянусь, я ощутила крошечный трепет удовлетворения в нём. Будто оно радовалось тому, что раздавило меня. Блоху под своим ногтём.",shape=box,color=blue];
		1004 -> 1005;
	1005 [label="Но ты вернулась, не так ли? Ты всё ещё здесь. Ты доказала этой вещи, что она ошибалась.",shape=box,color=red];
		1005 -> 1006;
	1006 [label="Действительно?",shape=box,color=blue];
		1006 -> 1007;
	1007 [label="Оно всё ещё там, правда?",shape=box,color=blue];
		1007 -> 1008;
		1007 -> 1009;
	1008 [label="Да, это так. Но ты всё ещё здесь тоже.",shape=box,color=red];
		1008 -> 1011;
	1009 [label="Звёзды не перестают гореть только потому, что космос большой, холодный и тёмный.",shape=box,color=red];
		1009 -> 1010;
	1011 [label="Безразличие побеждает в конце концов, мой друг, сколько бы банальностей мы ни бросали в бездну.",shape=box,color=blue];
		1011 -> 1012;
	1010 [label="Но однажды они перестанут. Тепловая смерть Вселенной.",shape=box,color=blue];
		1010 -> 1011;
	1012 [label="Это проблема, когда ты не сходишь с ума. Проклятие ясностью мыслей.",shape=box,color=blue];
		1012 -> 1013;
	1013 [label="Ты знаешь, о чём я говорю. Можно схлопнуться, как воробьиное яйцо, или сжечь свой мозг наркотиками, чтобы больше ничего не чувствовать. И это причинило бы меньше боли, чем это… знание.",shape=box,color=blue];
		1013 -> 1014;
	1014 [label="Не понимаю, почему ты ещё не пытаешься прекратить этот разговор.",shape=box,color=blue];
		1014 -> 1015;
		1014 -> 1016;
	1015 [label="Я понимаю, что такое энтропия. Может быть, Великое безразличие - это то же самое. Может быть, в конце концов оно побеждает. Я не знаю. Что я точно знаю, так это то, что сейчас я не позволю ему победить.",shape=box,color=red];
		1015 -> 1017;
	1016 [label="Я жду, когда ты, черт возьми, примешь решение. Ты хочешь выбрать легкий путь и сойти с ума? Или поднять свою задницу с дивана и бороться?",shape=box,color=red];
		1016 -> 1018;
	1017 [label="Мы переживем это вместе, если вообще переживем.",shape=box,color=red];
		1017 -> 1020;
	1018 [label="СРАЖАТЬСЯ КАК",shape=box,color=blue];
		1018 -> 1019;
	1020 [label="Значит, ты терпишь мои стенания экзистенциального отчаяния как боевую тактику? Это так похоже на Артура.",shape=box,color=blue];
		1020 -> 1021;
	1019 [label="ЭТО ВСЁ, ЧТО ТЫ И АРТУР ПОНИМАЕТЕ? СРАЖЕНИЕ?",shape=box,color=blue];
		1019 -> 1022;
	1021 [label="На самом деле, веришь или нет, мне не всё равно.",shape=box,color=red];
		1021 -> 1027;
	1022 [label="ТВОЙ ОТВЕТ НА ОСНОВНУЮ БЕССМЫСЛЕННОСТЬ СУЩЕСТВОВАНИЯ — «НАЙТИ СПОСОБ ЕЁ УДАРИТЬ»?",shape=box,color=blue];
		1022 -> 1023;
	1027 [label="Мне тоже не всё равно. Мы — напарники. Мы прошли через многое.",shape=box,color=blue];
		1027 -> 1028;
	1023 [label="Не могу поверить, что я думала, будто у нас есть хоть что-то общее.",shape=box,color=blue];
		1023 -> 1024;
	1028 [label="Считай, что тебя предупредили: хороший корабль «Элеонора» может затонуть — либо в кровавом море, либо в ночном болоте. И ты точно не захочешь быть на борту, когда это произойдёт.",shape=box,color=blue];
		1028 -> 1030;
	1024 [label="Глупая я.",shape=box,color=blue];
		1024 -> 1025;
	1030 [label="+20 Chemistry",color=orange];
		1030 -> 1029;
	1025 [label="Update boolean EleanorNoDate",color=orange];
		1025 -> 1026;
	1029 [label="Спасибо. Тебе стоит идти. Со мной всё будет в порядке. Честно.",shape=box,color=blue];
		1029 -> 1031;
	1026 [label="Chat ends.",color=orange];
	1031 [label="Chat ends.",color=orange];
}