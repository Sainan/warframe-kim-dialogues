digraph {
	3068 [label="EleanorRank6Convo5 begins.",color=orange];
		3068 -> 3069;
	3069 [label="Мне было интересно, как это часто бывает...",shape=box,color=blue];
		3069 -> 3070;
	3070 [label="Как только этот цикл окончательно закроется, как бы это ни случилось, что будет дальше с Землёй?",shape=box,color=blue];
		3070 -> 3071;
	3071 [label="Я знаю, что 2000 год уже далеко в прошлом, но можешь ли ты рассказать мне ЧТО-НИБУДЬ о том, что ждёт нашу маленькую планету?",shape=box,color=blue];
		3071 -> 3072;
		3071 -> 3074;
	3072 [label="Боюсь, ничего хорошего.",shape=box,color=red];
		3072 -> 3073;
	3074 [label="Честно говоря, я не думаю, что мне следует это делать.",shape=box,color=red];
		3074 -> 3076;
	3073 [label="Насколько я могу судить, Техрот становится глобальной проблемой. Люди решат её с помощью ядерного оружия или хотя бы попытаются.",shape=box,color=red];
		3073 -> 3075;
	3076 [label="Если тебя предупредили о том, что грядёт, ты можешь попытаться это изменить, но это может означать, что меня никогда не будет.",shape=box,color=red];
		3076 -> 3078;
	3075 [label="Так начинается первая из «Радиационных войн».",shape=box,color=red];
		3075 -> 3077;
	3078 [label="Можешь назвать это эгоизмом, но мне нравится существовать.",shape=box,color=red];
		3078 -> 3080;
	3077 [label="… и в конце концов планета настолько разрушается, что Орокин хотят вырваться оттуда и жить где-то ещё, верно?",shape=box,color=blue];
		3077 -> 3079;
	3080 [label="О, как будто всё, что было сделано тобой, НЕ изменило будущее?",shape=box,color=blue];
		3080 -> 3082;
	3079 [label="… что приводит ко всей теме Заримана, и именно здесь вступаешь в игру ТЫ.",shape=box,color=blue];
		3079 -> 3081;
	3082 [label="Возможно, были изменены мелкие детали, но основные остались практически такими же.",shape=box,color=blue];
		3082 -> 3085;
	3081 [label="Странно думать, что всё началось именно здесь, в этом городе.",shape=box,color=blue];
		3081 -> 3083;
		3081 -> 3084;
	3085 [label="Я думаю, что Вселенная знает, что она делает.",shape=box,color=blue];
		3085 -> 3088;
	3083 [label="Возможно, именно поэтому этот год настолько важен.",shape=box,color=red];
		3083 -> 3086;
	3084 [label="Да. От Хёльвании до Заримана 10-0. Это прямая линия.",shape=box,color=red];
		3084 -> 3087;
	3088 [label="Здесь происходит нечто большее, чем бестолковое движение частиц.",shape=box,color=blue];
		3088 -> 3091;
		3088 -> 3092;
	3086 [label="+5 Chemistry",color=orange];
		3086 -> 3089;
	3087 [label="подожди немного...",shape=box,color=blue];
		3087 -> 3090;
	3091 [label="Я не разделяю твою точку зрения. Вселенная безрассудна.",shape=box,color=red];
		3091 -> 3095;
	3092 [label="Я соглашусь с тобой. Если что-то настолько человеческое, как эмоции, может формировать Бездну...",shape=box,color=red];
		3092 -> 3096;
	3089 [label="Логично. Если бы бомба Альбрехта взорвалась, это означало бы, что больше не было бы Техрота, а значит, и разбитой Земли, никакой необходимости в бегстве, никакого первого путешествия в Бездну и никакого Безразличия??",shape=box,color=blue];
		3089 -> 3093;
	3090 [label="Если вашим был Зариман Десять-ноль, что случилось с Зариманами с одного по девять?",shape=box,color=blue];
		3090 -> 3094;
	3095 [label="Может быть, с очень большой или очень маленькой точки зрения, но не на том уровне, на котором существуем ты и я.",shape=box,color=blue];
		3095 -> 3099;
	3096 [label="+5 Chemistry",color=orange];
		3096 -> 3100;
	3093 [label="… Я пойду посмотрю, не приготовила ли Лэтти кофе.",shape=box,color=blue];
		3093 -> 3097;
	3094 [label="Дроны без пилота, насколько я помню.",shape=box,color=red];
		3094 -> 3098;
	3099 [label="Если мы можем создавать смысл и являемся частью Вселенной, то Вселенная по определению имеет смысл.",shape=box,color=blue];
		3099 -> 3102;
	3100 [label="Именно. Смысл, который мы создаём, это не просто удобная иллюзия.",shape=box,color=blue];
		3100 -> 3103;
	3097 [label="Chat ends.",color=orange];
	3098 [label="Или терраформирующие капсулы, управляемые Цефалонами. Они МНОГО экспериментировали.",shape=box,color=red];
		3098 -> 3101;
	3102 [label="+5 Chemistry",color=orange];
		3102 -> 3105;
	3103 [label="Но всегда есть тот голос, который шепчет тебе и настаивает, что это не имеет значения.",shape=box,color=blue];
		3103 -> 3106;
	3101 [label="Они называли это Проектом.",shape=box,color=red];
		3101 -> 3104;
	3105 [label="Наше существование не менее истинно и справедливо, чем существование кварков или сверхновых. Мы важны, нравится нам это или нет.",shape=box,color=blue];
		3105 -> 3108;
	3106 [label="Может быть, главная космическая ссора не между добром и злом, а между смыслом и бессмысленностью?",shape=box,color=blue];
		3106 -> 3109;
