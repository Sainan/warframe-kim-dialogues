digraph {
	graph [fontname="Roboto Condensed"];
	node [fontname="Roboto Condensed"];
	edge [fontname="Roboto Condensed"];

	"EleanorRank6Convo5 begins." [color=orange];
		"EleanorRank6Convo5 begins." -> j3567025326;
	j3567025326 [label="Мне было интересно, как это часто бывает...",shape=box,color=blue];
		j3567025326 -> j408870042;
	j408870042 [label="Как только этот цикл окончательно закроется, как бы это ни случилось, что будет дальше с Землёй?",shape=box,color=blue];
		j408870042 -> j40277231;
	j40277231 [label="Я знаю, что 2000 год уже далеко в прошлом, но можешь ли ты рассказать мне ЧТО-НИБУДЬ о том, что ждёт нашу маленькую планету?",shape=box,color=blue];
		j40277231 -> j1337372425;
		j40277231 -> j3527869698;
	j1337372425 [label="Боюсь, ничего хорошего.",shape=box,color=red];
		j1337372425 -> j3373128347;
	j3527869698 [label="Честно говоря, я не думаю, что мне следует это делать.",shape=box,color=red];
		j3527869698 -> j1173614886;
	j3373128347 [label="Насколько я могу судить, Техрот становится глобальной проблемой. Люди решат её с помощью ядерного оружия или хотя бы попытаются.",shape=box,color=red];
		j3373128347 -> j446842940;
	j1173614886 [label="Если тебя предупредили о том, что грядёт, ты можешь попытаться это изменить, но это может означать, что меня никогда не будет.",shape=box,color=red];
		j1173614886 -> j3233759785;
	j446842940 [label="Так начинается первая из «Радиационных войн».",shape=box,color=red];
		j446842940 -> j1686802948;
	j3233759785 [label="Можешь назвать это эгоизмом, но мне нравится существовать.",shape=box,color=red];
		j3233759785 -> j4030096880;
	j1686802948 [label="… и в конце концов планета настолько разрушается, что Орокин хотят вырваться оттуда и жить где-то ещё, верно?",shape=box,color=blue];
		j1686802948 -> j1062423028;
	j4030096880 [label="О, как будто всё, что было сделано тобой, НЕ изменило будущее?",shape=box,color=blue];
		j4030096880 -> j1229529369;
	j1062423028 [label="… что приводит ко всей теме Заримана, и именно здесь вступаешь в игру ТЫ.",shape=box,color=blue];
		j1062423028 -> j81814397;
	j1229529369 [label="Возможно, были изменены мелкие детали, но основные остались практически такими же.",shape=box,color=blue];
		j1229529369 -> j2307767959;
	j81814397 [label="Странно думать, что всё началось именно здесь, в этом городе.",shape=box,color=blue];
		j81814397 -> j3794624508;
		j81814397 -> j2716475084;
	j2307767959 [label="Я думаю, что Вселенная знает, что она делает.",shape=box,color=blue];
		j2307767959 -> j771440999;
	j3794624508 [label="Возможно, именно поэтому этот год настолько важен.",shape=box,color=red];
		j3794624508 -> j3020007055;
	j2716475084 [label="Да. От Хёльвании до Заримана 10-0. Это прямая линия.",shape=box,color=red];
		j2716475084 -> j641278331;
	j771440999 [label="Здесь происходит нечто большее, чем бестолковое движение частиц.",shape=box,color=blue];
		j771440999 -> j1877056784;
		j771440999 -> j2951676812;
	j3020007055 [label="+5 Chemistry",color=orange];
		j3020007055 -> j3499798341;
	j641278331 [label="подожди немного...",shape=box,color=blue];
		j641278331 -> j53398686;
	j1877056784 [label="Я не разделяю твою точку зрения. Вселенная безрассудна.",shape=box,color=red];
		j1877056784 -> j485107210;
	j2951676812 [label="Я соглашусь с тобой. Если что-то настолько человеческое, как эмоции, может формировать Бездну...",shape=box,color=red];
		j2951676812 -> j257877124;
	j3499798341 [label="Логично. Если бы бомба Альбрехта взорвалась, это означало бы, что больше не было бы Техрота, а значит, и разбитой Земли, никакой необходимости в бегстве, никакого первого путешествия в Бездну и никакого Безразличия??",shape=box,color=blue];
		j3499798341 -> j1092840613;
	j53398686 [label="Если вашим был Зариман Десять-ноль, что случилось с Зариманами с одного по девять?",shape=box,color=blue];
		j53398686 -> j3610794074;
	j485107210 [label="Может быть, с очень большой или очень маленькой точки зрения, но не на том уровне, на котором существуем ты и я.",shape=box,color=blue];
		j485107210 -> j802027251;
	j257877124 [label="+5 Chemistry",color=orange];
		j257877124 -> j2270381348;
	j1092840613 [label="… Я пойду посмотрю, не приготовила ли Лэтти кофе.",shape=box,color=blue];
		j1092840613 -> "Chat ends.";
	j3610794074 [label="Дроны без пилота, насколько я помню.",shape=box,color=red];
		j3610794074 -> j3684136625;
	j802027251 [label="Если мы можем создавать смысл и являемся частью Вселенной, то Вселенная по определению имеет смысл.",shape=box,color=blue];
		j802027251 -> j1294383899;
	j2270381348 [label="Именно. Смысл, который мы создаём, это не просто удобная иллюзия.",shape=box,color=blue];
		j2270381348 -> j4038557578;
	"Chat ends." [color=orange];
	j3684136625 [label="Или терраформирующие капсулы, управляемые Цефалонами. Они МНОГО экспериментировали.",shape=box,color=red];
		j3684136625 -> j1100916226;
	j1294383899 [label="+5 Chemistry",color=orange];
		j1294383899 -> j1257295548;
	j4038557578 [label="Но всегда есть тот голос, который шепчет тебе и настаивает, что это не имеет значения.",shape=box,color=blue];
		j4038557578 -> j4117308368;
	j1100916226 [label="Они называли это Проектом.",shape=box,color=red];
		j1100916226 -> j3805935182;
	j1257295548 [label="Наше существование не менее истинно и справедливо, чем существование кварков или сверхновых. Мы важны, нравится нам это или нет.",shape=box,color=blue];
		j1257295548 -> "Chat ends.";
	j4117308368 [label="Может быть, главная космическая ссора не между добром и злом, а между смыслом и бессмысленностью?",shape=box,color=blue];
		j4117308368 -> "Chat ends.";
	j3805935182 [label="+5 Chemistry",color=orange];
		j3805935182 -> j2272767579;
	j2272767579 [label="Звучит лучше, чем «Операция Свалим на новую планету, чтобы засрать и её».",shape=box,color=blue];
		j2272767579 -> "Chat ends.";
}