digraph {
	graph [fontname="Roboto Condensed"];
	node [fontname="Roboto Condensed"];
	edge [fontname="Roboto Condensed"];

	"EleanorRank6Convo5 begins." [color=orange];
		"EleanorRank6Convo5 begins." -> j259569161;
	j259569161 [label="Мне было интересно, как это часто бывает...",shape=box,color=blue];
		j259569161 -> j4207850233;
	j4207850233 [label="Как только этот цикл окончательно закроется, как бы это ни случилось, что будет дальше с Землёй?",shape=box,color=blue];
		j4207850233 -> j2029232145;
	j2029232145 [label="Я знаю, что 2000 год уже далеко в прошлом, но можешь ли ты рассказать мне ЧТО-НИБУДЬ о том, что ждёт нашу маленькую планету?",shape=box,color=blue];
		j2029232145 -> j2239408256;
		j2029232145 -> j4218837115;
	j2239408256 [label="Боюсь, ничего хорошего.",shape=box,color=red];
		j2239408256 -> j2246745631;
	j4218837115 [label="Честно говоря, я не думаю, что мне следует это делать.",shape=box,color=red];
		j4218837115 -> j1240257481;
	j2246745631 [label="Насколько я могу судить, Техрот становится глобальной проблемой. Люди решат её с помощью ядерного оружия или хотя бы попытаются.",shape=box,color=red];
		j2246745631 -> j1195435984;
	j1240257481 [label="Если тебя предупредили о том, что грядёт, ты можешь попытаться это изменить, но это может означать, что меня никогда не будет.",shape=box,color=red];
		j1240257481 -> j680242203;
	j1195435984 [label="Так начинается первая из «Радиационных войн».",shape=box,color=red];
		j1195435984 -> j528364654;
	j680242203 [label="Можешь назвать это эгоизмом, но мне нравится существовать.",shape=box,color=red];
		j680242203 -> j10704453;
	j528364654 [label="… и в конце концов планета настолько разрушается, что Орокин хотят вырваться оттуда и жить где-то ещё, верно?",shape=box,color=blue];
		j528364654 -> j3022588281;
	j10704453 [label="О, как будто всё, что было сделано тобой, НЕ изменило будущее?",shape=box,color=blue];
		j10704453 -> j1229529369;
	j3022588281 [label="… что приводит ко всей теме Заримана, и именно здесь вступаешь в игру ТЫ.",shape=box,color=blue];
		j3022588281 -> j1402017961;
	j1229529369 [label="Возможно, были изменены мелкие детали, но основные остались практически такими же.",shape=box,color=blue];
		j1229529369 -> j2307767959;
	j1402017961 [label="Странно думать, что всё началось именно здесь, в этом городе.",shape=box,color=blue];
		j1402017961 -> j3861526588;
		j1402017961 -> j3499411195;
	j2307767959 [label="Я думаю, что Вселенная знает, что она делает.",shape=box,color=blue];
		j2307767959 -> j771440999;
	j3861526588 [label="Возможно, именно поэтому этот год настолько важен.",shape=box,color=red];
		j3861526588 -> j1067148813;
	j3499411195 [label="Да. От Хёльвании до Заримана 10-0. Это прямая линия.",shape=box,color=red];
		j3499411195 -> j4152144598;
	j771440999 [label="Здесь происходит нечто большее, чем бестолковое движение частиц.",shape=box,color=blue];
		j771440999 -> j1172290192;
		j771440999 -> j823776361;
	j1067148813 [label="+5 Chemistry",color=orange];
		j1067148813 -> j658274161;
	j4152144598 [label="подожди немного...",shape=box,color=blue];
		j4152144598 -> j2563243480;
	j1172290192 [label="Я не разделяю твою точку зрения. Вселенная безрассудна.",shape=box,color=red];
		j1172290192 -> j3865792527;
	j823776361 [label="Я соглашусь с тобой. Если что-то настолько человеческое, как эмоции, может формировать Бездну...",shape=box,color=red];
		j823776361 -> j3341373151;
	j658274161 [label="Логично. Если бы бомба Альбрехта взорвалась, это означало бы, что больше не было бы Техрота, а значит, и разбитой Земли, никакой необходимости в бегстве, никакого первого путешествия в Бездну и никакого Безразличия??",shape=box,color=blue];
		j658274161 -> j1527200772;
	j2563243480 [label="Если вашим был Зариман Десять-ноль, что случилось с Зариманами с одного по девять?",shape=box,color=blue];
		j2563243480 -> j1972463375;
	j3865792527 [label="Может быть, с очень большой или очень маленькой точки зрения, но не на том уровне, на котором существуем ты и я.",shape=box,color=blue];
		j3865792527 -> j580272958;
	j3341373151 [label="+5 Chemistry",color=orange];
		j3341373151 -> j905537664;
	j1527200772 [label="… Я пойду посмотрю, не приготовила ли Лэтти кофе.",shape=box,color=blue];
		j1527200772 -> "Chat ends.";
	j1972463375 [label="Дроны без пилота, насколько я помню.",shape=box,color=red];
		j1972463375 -> j3695780847;
	j580272958 [label="Если мы можем создавать смысл и являемся частью Вселенной, то Вселенная по определению имеет смысл.",shape=box,color=blue];
		j580272958 -> j1319028095;
	j905537664 [label="Именно. Смысл, который мы создаём, это не просто удобная иллюзия.",shape=box,color=blue];
		j905537664 -> j4038557578;
	"Chat ends." [color=orange];
	j3695780847 [label="Или терраформирующие капсулы, управляемые Цефалонами. Они МНОГО экспериментировали.",shape=box,color=red];
		j3695780847 -> j855194664;
	j1319028095 [label="+5 Chemistry",color=orange];
		j1319028095 -> j207491411;
	j4038557578 [label="Но всегда есть тот голос, который шепчет тебе и настаивает, что это не имеет значения.",shape=box,color=blue];
		j4038557578 -> j4117308368;
	j855194664 [label="Они называли это Проектом.",shape=box,color=red];
		j855194664 -> j2182283303;
	j207491411 [label="Наше существование не менее истинно и справедливо, чем существование кварков или сверхновых. Мы важны, нравится нам это или нет.",shape=box,color=blue];
		j207491411 -> "Chat ends.";
	j4117308368 [label="Может быть, главная космическая ссора не между добром и злом, а между смыслом и бессмысленностью?",shape=box,color=blue];
		j4117308368 -> "Chat ends.";
	j2182283303 [label="+5 Chemistry",color=orange];
		j2182283303 -> j4060461395;
	j4060461395 [label="Звучит лучше, чем «Операция Свалим на новую планету, чтобы засрать и её».",shape=box,color=blue];
		j4060461395 -> "Chat ends.";
}