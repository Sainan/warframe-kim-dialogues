		1220 -> 1221;
	1228 [label="Это прозвучит глупо, но, пожалуйста, пообещай мне кое-что.",shape=box,color=blue];
		1228 -> 1229;
	1235 [label="Chat ends.",color=orange];
	1217 [label="+5 Chemistry",color=orange];
		1217 -> 1218;
	1221 [label="Update boolean EleanorHeroVirus",color=orange];
		1221 -> 1222;
	1229 [label="Я знаю, что ты считаешь, что нашёл своё место здесь, среди нас. Я рада этому, правда.",shape=box,color=blue];
		1229 -> 1230;
	1218 [label="Chat ends.",color=orange];
	1222 [label="+5 Chemistry",color=orange];
		1222 -> 1223;
	1230 [label="Но я прошу тебя позаботиться об этом ребёнке, если сможешь.",shape=box,color=blue];
		1230 -> 1236;
		1230 -> 1237;
		1230 -> 1238;
	1223 [label="Chat ends.",color=orange];
	1236 [label="С ребёнком все в порядке, честно говоря. Лотос с ним. И Лойд тоже. Они не собираются сдаваться.",shape=box,color=red];
		1236 -> 1239;
	1237 [label="Не недооценивай их, Элеонора. Они прекрасно обходились без меня годами.",shape=box,color=red];
		1237 -> 1243;
	1238 [label="Не волнуйся. Я уже это делаю. Я передам им привет, если хочешь.",shape=box,color=red];
		1238 -> 1247;
	1239 [label="Хорошо. Я просто надеюсь, что ты знаешь что делаешь.",shape=box,color=blue];
		1239 -> 1241;
	1243 [label="Честно говоря, я не уверена, что истребление тысяч, неся на себе неизмеримую травму, можно считать чем-то «в порядке».",shape=box,color=blue];
		1243 -> 1246;
	1247 [label="Спасибо. Признаюсь, идея поговорить с альтернативной версией самой себя меня захватывает.",shape=box,color=blue];
