	1248 [label="Check boolean EleanorSister",color=orange];
		1248 -> 1251 [label=true,color=green];
		1248 -> 1249 [label=false,color=brown];
	1240 [label="Потому что то, что есть у них внутри, что позволяет выдержать всё, через что они прошли, и всё ещё сохранять эмпатию? Нам это понадобится.",shape=box,color=blue];
		1240 -> 1242;
	1244 [label="Мне бы хотелось узнать, как они справляются.",shape=box,color=blue];
		1244 -> 1245;
	1251 [label="Я пытаюсь установить с ней телепатический контакт. Если ты можешь, значит, и я могу, верно?",shape=box,color=blue];
		1251 -> 1252;
		1251 -> 1253;
	1249 [label="На самом деле, узнав о твоей альтернативной версии, я убедила себя, что где-то там должна быть и другая версия меня, которая решила стать монахиней. Апостол Луа, с бритой головой, регулярными молитвами — всё в таком духе.",shape=box,color=blue];
		1249 -> 1250;
	1242 [label="Chat ends.",color=orange];
	1245 [label="Chat ends.",color=orange];
	1252 [label="Не могу сказать уверенно, что это такая уж хорошая идея.",shape=box,color=red];
		1252 -> 1254;
	1253 [label="У тебя что-нибудь получилось?",shape=box,color=red];
