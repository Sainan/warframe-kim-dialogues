digraph {
	1123 [label="EleanorRank3Convo4 begins.",color=orange];
		1123 -> 1124;
	1124 [label="Поправь меня, если я что-то не так поняла:",shape=box,color=blue];
		1124 -> 1125;
	1125 [label="У тебя есть другая версия самого себя, где-то там, бродящая вокруг. Эта копия - одновременно и ты, и не ты. Он как твоё детское воплощение из другой версии реальности.",shape=box,color=blue];
		1125 -> 1126;
		1125 -> 1127;
	1126 [label="Не совсем. Это их версия реальности. Я здесь ни при чём.",shape=box,color=red];
		1126 -> 1128;
	1127 [label="Скорее всего, в какой-то момент мы разделились и пошли в разные стороны.",shape=box,color=red];
		1127 -> 1129;
	1128 [label="Вот это поворот. Подожди. Позволь мне это осмыслить.",shape=box,color=blue];
		1128 -> 1130;
	1129 [label="И я понимаю, мы живём не в ТВОЕЙ реальности. Дай… подумать.",shape=box,color=blue];
		1129 -> 1130;
	1130 [label="Итак… ты как приглашённая звезда из перекрёстного эпизода, и тебя добавили в шоу?",shape=box,color=blue];
		1130 -> 1131;
	1131 [label="Почти так.",shape=box,color=red];
		1131 -> 1132;
	1132 [label="Это сводит меня с ума. Так что же случилось с твоей версией реальности? Куда она делась?",shape=box,color=blue];
		1132 -> 1133;
		1132 -> 1134;
		1132 -> 1135;
	1133 [label="Думаю, единственное, что от неё осталось — это корабль-призрак Зариман, затыкающий дыру между измерениями…",shape=box,color=red];
		1133 -> 1136;
	1134 [label="Думаю, то, что от неё осталось, пришло со мной в Дувири. К лучшему или к худшему.",shape=box,color=red];
		1134 -> 1137;
	1135 [label="Я не особо зацикливаюсь на этом. Думаю, она утеряна.",shape=box,color=red];
		1135 -> 1138;
	1136 [label="Check boolean EleanorHoldfasts1",color=orange];
		1136 -> 1139 [label=true,color=green];
		1136 -> 1140 [label=false,color=brown];
	1137 [label="И тогда она в каком-то смысле продолжает жить.",shape=box,color=blue];
		1137 -> 1145;
	1138 [label="Ты не можешь просто ПОТЕРЯТЬ целый космос. Это безумие. Он должен быть где-то там.",shape=box,color=blue];
		1138 -> 1146;
	1139 [label="Ах! Логово ваших дружелюбных призраков. Неукротимых.",shape=box,color=blue];
		1139 -> 1141;
	1140 [label="Извини, хоть это и звучит заманчиво, но я понятия не имею, о чем ты.",shape=box,color=blue];
		1140 -> 1142;
	1145 [label="Не знаю, утешает ли это.",shape=box,color=blue];
		1145 -> 1147;
	1146 [label="Может быть. Как я говорю, это не главная моя проблема.",shape=box,color=red];
		1146 -> 1148;
	1141 [label="Не могу себе представить, что это то место, куда может захотеться вернуться ради ностальгической прогулки.",shape=box,color=blue];
		1141 -> 1143;
	1142 [label="Корабль-призрак?",shape=box,color=blue];
		1142 -> 1144;
	1147 [label="Я понимаю, что дом и семья это больше о том, где ты существуешь, и кто вокруг тебя.",shape=box,color=red];
		1147 -> 1149;
	1148 [label="Но это твой ДОМ. Ты не хочешь вернуться туда?",shape=box,color=blue];
		1148 -> 1150;
	1143 [label="Я не могу даже представить, что тебе пришлось потерять.",shape=box,color=blue];
		1143 -> 1151;
	1144 [label="Дыра между измерениями?",shape=box,color=blue];
		1144 -> 1152;
	1149 [label="И меньше о том, где и почему ты рождаешься.",shape=box,color=red];
		1149 -> 1157;
	1150 [label="На самом деле я больше не хочу туда. У меня нет дома.",shape=box,color=red];
		1150 -> 1158;
	1151 [label="Я так не считаю.",shape=box,color=red];
		1151 -> 1153;
	1152 [label="«Зариман» был колониальным кораблём. Направлялся на Тау. Так и не добрался.",shape=box,color=red];
		1152 -> 1154;
	1157 [label="Я не сосредотачиваюсь на том, что было потеряно. Я сосредотачиваюсь на том, что у меня все ещё есть. Мне нравится это место. Мне нравитесь все вы. Потому что…",shape=box,color=red];
		1157 -> 1159;
	1158 [label="Знаешь, прозвище «скиталец» прижилось не просто так.",shape=box,color=red];
		1158 -> 1159;
	1153 [label="Мне удалось выбраться, выжить. Какое это безумное везение!",shape=box,color=red];
		1153 -> 1155;
	1154 [label="Оказавшись в Бездне, нечто там существовавшее решило превратить корабль в сущий ад.",shape=box,color=red];
		1154 -> 1156;
	1159 [label="Из всех мест, где мне пришлось побывать, это место кажется мне наиболее родным.",shape=box,color=red];
		1159 -> 1171;
	1155 [label="Честно говоря, шансы на то, что кто-то из нас вообще существует, настолько малы, что для меня это просто ещё одно чудо.",shape=box,color=red];
		1155 -> 1160;
	1156 [label="Корабль метался  из Бездны в реальность и обратно, и теперь застрял где-то посередине.",shape=box,color=red];
		1156 -> 1161;
	1171 [label="Хм. Странно, но я горжусь этим.",shape=box,color=blue];
		1171 -> 1172;
	1160 [label="Не зацикливайся на том, что потеряно. Береги то, что у нас осталась.",shape=box,color=red];
		1160 -> 1170;
	1161 [label="Это не совсем один корабль. Это как бы... несколько его версий одновременно.",shape=box,color=red];
		1161 -> 1162;
	1172 [label="Возможно, тебе просто нужна была группа смертельно стильных городских био-коммандос, с которыми можно было бы общаться.",shape=box,color=blue];
		1172 -> 1173;
	1170 [label="Например? У меня теперь есть это место. И все вы. Это первое место, где я действительно чувствую себя как дома.",shape=box,color=red];
		1170 -> 1171;
	1162 [label="Update boolean EleanorHoldfasts1",color=orange];
		1162 -> 1163;
	1173 [label="Такие неудачники и чудаки, как я?",shape=box,color=red];
		1173 -> 1174;
	1163 [label="Не могу себе представить, что это то место, куда может захотеться вернуться ради ностальгической прогулки.",shape=box,color=blue];
		1163 -> 1164;
	1174 [label="И гордиться этим.",shape=box,color=blue];
		1174 -> 1175;
	1164 [label="Я не могу даже представить, что тебе пришлось потерять.",shape=box,color=blue];
		1164 -> 1165;
		1164 -> 1166;
	1175 [label="Но возвращаясь к другой версии тебя…",shape=box,color=blue];
		1175 -> 1176;
		1175 -> 1177;
	1165 [label="Я так не считаю.",shape=box,color=red];
		1165 -> 1167;
	1166 [label="У меня теперь есть это место. Первое место, где я действительно чувствую себя как дома.",shape=box,color=red];
		1166 -> 1171;
	1176 [label="Верно. Ордис называет его «Оператором». Лотос говорит, что это её дитя. А я чаще всего просто называю его «ребёнок».",shape=box,color=red];
		1176 -> 1180;
	1177 [label="Я стараюсь избегать их, как только могу. Мне явно недостаточно платят, чтобы быть нянькой, даже если нянчить приходится только себя.",shape=box,color=red];
		1177 -> 1178;
	1167 [label="Мне удалось выбраться, выжить. Какое это безумное везение!",shape=box,color=red];
		1167 -> 1168;
	1180 [label="+10 Chemistry",color=orange];
		1180 -> 1181;
	1178 [label="Ох. Жёстко.",shape=box,color=blue];
		1178 -> 1179;
	1168 [label="Честно говоря, шансы на то, что кто-то из нас вообще существует, настолько малы, что для меня это просто ещё одно чудо.",shape=box,color=red];
		1168 -> 1169;
	1181 [label="Check boolean EleanorLotus",color=orange];
		1181 -> 1182 [label=true,color=green];
		1181 -> 1185 [label=false,color=brown];
	1179 [label="Учитывая, сколько у вас общего, можно вести себя немного добрее.",shape=box,color=blue];
		1179 -> 1185;
	1169 [label="Не зацикливайся на том, что потеряно. Береги то, что у нас осталась.",shape=box,color=red];
		1169 -> 1170;
	1182 [label="Мне нравится, что у неё есть дети. Смертоносные космические дети.",shape=box,color=blue];
		1182 -> 1183;
	1185 [label="И вот что я не могу понять.",shape=box,color=blue];
		1185 -> 1186;
	1183 [label="Интересно, позволит ли она мне стать одним из них? Смогу ли я стать Тэнно?",shape=box,color=blue];
		1183 -> 1184;
	1186 [label="Этому ребёнку умопомрачительное количество лет, но большую часть этого времени он провёл в заморозке, так что он всё ещё ребёнок, верно?",shape=box,color=blue];
		1186 -> 1187;
		1186 -> 1188;
	1184 [label="Нет. Думаю, вряд ли, правда? Начнём с того, что я слишком стара.",shape=box,color=blue];
		1184 -> 1185;
	1187 [label="Что-то вроде того.",shape=box,color=red];
		1187 -> 1189;
	1188 [label="Не знаю, насколько они действительно «по-детски» выглядят, когда их тренировали убивать ради выживания.",shape=box,color=red];
		1188 -> 1190;
	1189 [label="Окей.",shape=box,color=blue];
		1189 -> 1191;
	1190 [label="Ребёнок. Есть. Ребёнок.",shape=box,color=blue];
		1190 -> 1192;
	1191 [label="Потерпи немного.",shape=box,color=blue];
		1191 -> 1194;
	1192 [label="Они не превращаются во что-то иное, когда с ними плохо обращаются.",shape=box,color=blue];
		1192 -> 1193;
	1194 [label="Останови меня сразу, если это не то, о чём ты хочешь говорить.",shape=box,color=blue];
		1194 -> 1195;
	1193 [label="Chat ends.",color=orange];
	1195 [label="Зариман? Что случилось с твоими родителями? Этот ребёнок прошёл через те же ужасные испытания, через которые которые пришлось пройти тебе, верно?",shape=box,color=blue];
		1195 -> 1196;
	1196 [label="Да.",shape=box,color=red];
		1196 -> 1197;
	1197 [label="Ты должна понимать, что поначалу была только одна версия меня, нас. Мы были одним человеком, пока не пожали руку этой штуке. Тогда наши пути разделились.",shape=box,color=red];
		1197 -> 1198;
	1198 [label="Ладно. У меня голова болит, когда я об этом думаю, но ладно.",shape=box,color=blue];
		1198 -> 1199;
	1199 [label="Итак, есть ребёнок. Глубоко травмированный ребёнок. И кто-то решил, что хорошая идея — дать этому ребёнку оружие и броню, выбор боевых костюмов, сделанных из мёртвых, обучить его убивать и отправить на войну?",shape=box,color=blue];
		1199 -> 1200;
	1200 [label="Да. Это был Орокин.",shape=box,color=red];
		1200 -> 1201;
	1201 [label="Скажи мне, после всего, через что этот ребёнок прошёл и продолжает проходить, как он до сих пор не лежит в больнице в кататоническом состоянии?",shape=box,color=blue];
		1201 -> 1202;
		1201 -> 1203;
	1202 [label="Честно говоря, не могу сказать. Знаю только, что у них есть те, кто их любит и заботится о них. В основном Ордис и Лотос.",shape=box,color=red];
		1202 -> 1204;
	1203 [label="Бездна знает, они видели гораздо больше насилия и кровопролития, чем любой ребёнок вообще должен видеть. И они сами на это дерьмо никогда не подписывались.",shape=box,color=red];
		1203 -> 1204;
	1204 [label="У Тэнно не было выбора, становиться ли воинами. Орокин собирались убить каждого из них, пока не нашли им применение.",shape=box,color=red];
		1204 -> 1205;
	1205 [label="Но как они могут двигаться внутри? Я не думаю, что их этому учили. Это что-то о том, кто они есть.",shape=box,color=red];
		1205 -> 1206;
	1206 [label="Забота? Сочувствие?",shape=box,color=blue];
		1206 -> 1207;
		1206 -> 1208;
		1206 -> 1209;
	1207 [label="Справедливость. Праведность.",shape=box,color=red];
		1207 -> 1210;
	1208 [label="Возможно, что-то более глубокое.",shape=box,color=red];
		1208 -> 1224;
	1209 [label="Инстинкты выживания. Люди хотят жить, в конце концов.",shape=box,color=red];
		1209 -> 1231;
	1210 [label="Check boolean EleanorHeroVirus",color=orange];
		1210 -> 1211 [label=true,color=green];
		1210 -> 1212 [label=false,color=brown];
	1224 [label="Возможно, это то, что является противоположностью Безразличия.",shape=box,color=blue];
		1224 -> 1225;
	1231 [label="Хм, я не знаю.",shape=box,color=blue];
		1231 -> 1232;
	1211 [label="Конечно. Вирус Героя. Я должна была предположить, что он доживёт до твоего времени.",shape=box,color=blue];
		1211 -> 1213;
	1212 [label="Тьфу. Вирус Героя.",shape=box,color=blue];
		1212 -> 1214;
	1225 [label="Интересно…",shape=box,color=blue];
		1225 -> 1226;
	1232 [label="Они ничем не отличались бы от Техрота, если бы единственное, чего они хотели, — это выжить.",shape=box,color=blue];
		1232 -> 1233;
	1213 [label="Эти бедные дети были окутаны мифом, не так ли?",shape=box,color=blue];
		1213 -> 1215;
	1214 [label="Это я называю циклом ерунды, который начинается с красивых рассказов и заканчивается тем, что молодёжь добровольно идёт на смерть.",shape=box,color=blue];
		1214 -> 1219;
	1226 [label="Что?",shape=box,color=red];
		1226 -> 1227;
	1233 [label="Учитывая, как ты говоришь о ребёнке, я не знаю, больше ли я боюсь за него или его.",shape=box,color=blue];
		1233 -> 1234;
	1215 [label="Их учили верить, что они доблестные воины, а не наивные марионетки?",shape=box,color=blue];
		1215 -> 1216;
	1219 [label="У Артура он есть. У Кристофера он есть.",shape=box,color=blue];
		1219 -> 1220;
	1227 [label="Ничего. Просто возникла идея.",shape=box,color=blue];
		1227 -> 1228;
	1234 [label="Я думаю, что в этом и состоит милосердие. Какое-то глубокое сочувствие. Возможно, однажды я увижу это своими глазами.",shape=box,color=blue];
		1234 -> 1235;
	1216 [label="Нет необходимости отвечать. Я уверена, что и так знаю.",shape=box,color=blue];
