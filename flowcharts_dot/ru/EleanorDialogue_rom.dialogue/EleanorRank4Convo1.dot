digraph {
	1389 [label="EleanorRank4Convo1 begins.",color=orange];
		1389 -> 1390;
	1390 [label="Я должна тебя кое о чём спросить, и, думаю, тебе это не понравится. Кажется, ты где-то в глубине души знаешь, что этот разговор однажды придётся завести, учитывая моё состояние.",shape=box,color=blue];
		1390 -> 1391;
	1391 [label="Я доверяю тебе, и ты мне нравишься, поэтому я просто выскажусь, ладно?",shape=box,color=blue];
		1391 -> 1392;
	1392 [label="На самом деле я не имею права спрашивать, но мне нужно знать.",shape=box,color=blue];
		1392 -> 1393;
	1393 [label="Если бы я полностью изменилась — если бы техрот поглотил меня, и я больше не была той Элеонорой, которую ты знаешь, — ты убьёшь меня?",shape=box,color=blue];
		1393 -> 1394;
		1393 -> 1395;
		1393 -> 1396;
		1393 -> 1397;
	1394 [label="Ты бы этого хотела?",shape=box,color=red];
		1394 -> 1398;
	1395 [label="Конечно.",shape=box,color=red];
		1395 -> 1399;
	1396 [label="Никогда.",shape=box,color=red];
		1396 -> 1400;
	1397 [label="Я не буду отвечать на этот вопрос.",shape=box,color=red];
		1397 -> 1401;
	1398 [label="Хм. Неплохое начало. Ты переводишь разговор на то, чего хочу я, и не используешь мою жизнь для демонстрации своих моральных принципов. Ты даёшь мне понять, что дело здесь не в тебе.",shape=box,color=blue];
		1398 -> 1402;
	1399 [label="Ого. Ладно.",shape=box,color=blue];
		1399 -> 1403;
	1400 [label="Ладно. Эм.",shape=box,color=blue];
		1400 -> 1404;
	1401 [label="Как хочешь.",shape=box,color=blue];
		1401 -> 1405;
	1402 [label="Это редкость.",shape=box,color=blue];
		1402 -> 1406;
	1403 [label="Никаких колебаний, никакой борьбы, простое «да».",shape=box,color=blue];
		1403 -> 1407;
	1404 [label="Извини. Я немного ошеломлена. Не ожидала, что ты скажешь это так открыто.",shape=box,color=blue];
		1404 -> 1408;
	1405 [label="Я больше не буду спрашивать.",shape=box,color=blue];
		1405 -> 1409;
	1406 [label="К сожалению, это не решает нашу дилемму, потому что значит, что я никогда не смогу передумать.",shape=box,color=blue];
		1406 -> 1410;
	1407 [label="Спасибо. Ты для меня во многом загадка, но теперь я знаю, что ты можешь пустить пулю мне в голову, а такие вещи важны на рабочем месте.",shape=box,color=blue];
		1407 -> 1411;
	1408 [label="Ты сможешь позволить монстру жить?",shape=box,color=blue];
		1408 -> 1412;
	1409 [label="Полагаю, нам придётся дождаться момента, когда это случится, чтобы увидеть, как ты отреагируешь, верно?",shape=box,color=blue];
		1409 -> 1413;
	1410 [label="Допустим, я скажу «да», я бы хотела, чтобы ты покончил со мной быстро и чисто, а не позволил мне жить дальше как безумное чудовище. Допустим, это то, чего Элеонора хочет СЕЙЧАС.",shape=box,color=blue];
		1410 -> 1414;
	1411 [label="Иииии я только что почувствовала, как Техрот в моих клетках тревожно задрожал.",shape=box,color=blue];
		1411 -> 1415;
	1412 [label="Извини, извини, просто я живу каждый день, слушая, как Лэтти твердит мне в ухо, что я не заслуживаю быть здесь, а Артур смотрит на меня, как на безнадёжный случай, считая дни до того момента, когда ему придётся это сделать. Я просто не ожидала, что ты так скажешь, вот и всё.",shape=box,color=blue];
		1412 -> 1422;
	1413 [label="Ты — смертельная маленькая загадка.",shape=box,color=blue];
		1413 -> 1417;
	1414 [label="А что если это безумное чудовище — это всё ещё я, только в большей степени? Что если, когда моя человечность сгорит в горниле Техрота, я больше НЕ захочу умирать?",shape=box,color=blue];
		1414 -> 1424;
	1415 [label="Думаю, теперь он будет вести себя немного лучше. Ничто так не наводит страх на паразита, как угроза его хозяину, верно?",shape=box,color=blue];
		1415 -> 1418;
	1422 [label="+20 Chemistry",color=orange];
		1422 -> 1416;
	1417 [label="И я тоже.",shape=box,color=blue];
		1417 -> 1420;
	1424 [label="Потому что это заставляет меня чувствовать себя живой, Скиталец. По-настоящему живой.",shape=box,color=blue];
		1424 -> 1425;
		1424 -> 1426;
		1424 -> 1427;
		1424 -> 1428;
	1418 [label="Update boolean EleanorNoDate",color=orange];
		1418 -> 1419;
	1416 [label="Плачу. Слезы счастья. Говори скорее. Пожалуйста",shape=box,color=blue];
		1416 -> 1423;
	1420 [label="Update boolean EleanorNoDate",color=orange];
		1420 -> 1421;
	1425 [label="Мне всё равно пришлось бы это сделать.",shape=box,color=red];
		1425 -> 1429;
	1426 [label="Замечание принято. Я не сделаю этого.",shape=box,color=red];
		1426 -> 1430;
	1427 [label="Это будет зависеть от того, сколько других людей подвергнутся опасности.",shape=box,color=red];
		1427 -> 1431;
	1428 [label="Ты не ответила на вопрос. Ты бы хотела, чтобы я?",shape=box,color=red];
		1428 -> 1432;
	1419 [label="Chat ends.",color=orange];
	1423 [label="Chat ends. Next chat will be EleanorMonster.",color=orange];
	1421 [label="Chat ends.",color=orange];
	1429 [label="Хорошо. Значит, мы приносим счастливую, сильную Элеонору в жертву Элеоноре, какой она была раньше?",shape=box,color=blue];
		1429 -> 1433;
	1430 [label="Ах, то есть всё, что мне нужно, — это хлопнуть своими большими красивыми глазами, и вся твоя решимость рухнет?",shape=box,color=blue];
		1430 -> 1434;
	1431 [label="Ах, понятно. В этом сценарии я — бесчеловечное чудовище, которое, предположительно, убивает людей налево и направо. Ты можешь отнести меня к категории «хищных животных», вроде бешеных собак и голодных медведей, а это значит, что никаких моральных дилемм не возникает.",shape=box,color=blue];
		1431 -> 1435;
	1432 [label="… Не знаю. В некоторые дни мне так кажется. Я чувствую себя, как типичный персонаж из мелодрамы.",shape=box,color=blue];
		1432 -> 1436;
	1433 [label="Я могу изменить своё мнение и решить жить, но ты не можешь изменить своё?",shape=box,color=blue];
		1433 -> 1442;
	1434 [label="И каким же бесстрашным охотником на вампиров ты станешь тогда?",shape=box,color=blue];
		1434 -> 1443;
	1435 [label="Скажи мне.",shape=box,color=blue];
		1435 -> 1438;
	1436 [label="«О нет, бедная девушка, которую мы когда-то любили, стала сексуальным вампиром. Давайте убьём её, чтобы в смерти она снова стала чистой и невинной.»",shape=box,color=blue];
		1436 -> 1437;
	1442 [label="Я не должна удивляться. Это конец, к которому тебя готовят истории.",shape=box,color=blue];
		1442 -> 1444;
	1443 [label="Скажу тебе. Ты будешь персонажем, кто умирает на середине фильма, потому что у него не хватило духу сделать то, что нужно.",shape=box,color=blue];
		1443 -> 1445;
	1438 [label="Неужели ты ждёшь, пока я найду свою первую жертву, прежде чем всадить мне пулю в череп?",shape=box,color=blue];
		1438 -> 1439;
	1437 [label="Update boolean EleanorArthurNightmare",color=orange];
		1437 -> 1441;
	1444 [label="«О нет, бедная девушка, которую мы когда-то любили, стала сексуальным вампиром. Давайте убьём её, чтобы в смерти она снова стала чистой и невинной.»",shape=box,color=blue];
		1444 -> 1448;
	1445 [label="Ты станешь предупреждением для остальных, вот что!",shape=box,color=blue];
		1445 -> 1446;
	1439 [label="Потому что если ты этого не сделаешь, как ты можешь надеяться, что я не представляю опасность?",shape=box,color=blue];
		1439 -> 1440;
	1441 [label="Я реально зациклилась на этом. Мне снились кошмары, где я просыпалась на своём диване, а Артур стоял надо мной с мечом в руке и слезами на глазах. Он сквозь зубы говорил что-то вроде: «Элеонора была моей сестрой, но теперь Элеоноры больше нет, и я должен это сделать, даже если это убивает меня», — бу-гу-гу.",shape=box,color=blue];
		1441 -> 1450;
	1448 [label="Update boolean EleanorArthurNightmare",color=orange];
		1448 -> 1449;
	1446 [label="Извини. Я не полностью честна с тобой. Скоро поговорим.",shape=box,color=blue];
		1446 -> 1447;
	1440 [label="Chat ends.",color=orange];
	1450 [label="И когда он вонзает лезвие мне между рёбер, я кричу: «Элеонора ПРЯМО ПЕРЕД ТОБОЙ, тупой ублюдок!», но он меня больше не слышит.",shape=box,color=blue];
		1450 -> 1451;
	1449 [label="Я реально зациклилась на этом. Мне снились кошмары, где я просыпалась на своём диване, а Артур стоял надо мной с мечом в руке и слезами на глазах. Он сквозь зубы говорил что-то вроде: «Элеонора была моей сестрой, но теперь Элеоноры больше нет, и я должен это сделать, даже если это убивает меня», — бу-гу-гу.",shape=box,color=blue];
		1449 -> 1455;
	1447 [label="Chat ends.",color=orange];
	1451 [label="Итак, я слышу, что у тебя нет желания решить этот вопрос заранее.",shape=box,color=red];
		1451 -> 1452;
	1455 [label="И когда он вонзает лезвие мне между рёбер, я кричу: «Элеонора ПРЯМО ПЕРЕД ТОБОЙ, тупой ублюдок!», но он меня больше не слышит.",shape=box,color=blue];
		1455 -> 1456;
	1452 [label="В таком случае ты не можешь ожидать этого и от меня.",shape=box,color=red];
		1452 -> 1453;
	1456 [label="Может быть, в следующий раз я увижу тебя во сне.",shape=box,color=blue];
		1456 -> 1457;
	1453 [label="+20 Chemistry",color=orange];
		1453 -> 1454;
	1457 [label="Chat ends.",color=orange];
	1454 [label="Chat ends.",color=orange];
}