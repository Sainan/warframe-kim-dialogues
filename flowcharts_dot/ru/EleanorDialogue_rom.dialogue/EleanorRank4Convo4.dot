digraph {
	1700 [label="EleanorRank4Convo4 begins.",color=orange];
		1700 -> 1701;
		1700 -> 1702;
		1700 -> 1703;
	1701 [label="Вы с Лэтти когда-нибудь были друзьями?",shape=box,color=red];
		1701 -> 1704;
	1702 [label="У вас довольно сплочённая группа. Кто-нибудь из вас когда-нибудь встречался с кем-то ещё из Гекса?",shape=box,color=red];
		1702 -> 1705;
	1703 [label="Как бы ты отнеслась к тому, если бы Артур начал с кем-то романтические отношения?",shape=box,color=red];
		1703 -> 1706;
	1704 [label="О Боги, да. Мы были не разлей вода какое-то время.",shape=box,color=blue];
		1704 -> 1707;
	1705 [label="Это немного личный вопрос, но ладно. Ты уже давно с нами, имеешь право знать, как тут всё устроено.",shape=box,color=blue];
		1705 -> 1708;
	1706 [label="Ты имеешь в виду кого-то не так уж далеко отсюда?",shape=box,color=blue];
		1706 -> 1709;
	1707 [label="Конечно, это было до Энтрати.",shape=box,color=blue];
		1707 -> 1710;
	1708 [label="Кроме того, что Артур и Аои встречаются? Нет. По крайней мере, я об этом не знаю… а я бы знала.",shape=box,color=blue];
		1708 -> 1711;
	1709 [label="Можешь не отвечать.",shape=box,color=blue];
		1709 -> 1712;
	1710 [label="Теперь она ведёт себя так, будто я совсем другой человек. Удобно для неё. Если я больше не Элеонора, то она может быть сколько угодно жестокой со мной, ведь она не ранит того человека, которого знала. По-моему, это трусость.",shape=box,color=blue];
		1710 -> 1715;
	1711 [label="И если ты вдруг думаешь о том, чтобы попытаться с кем-то из нас...",shape=box,color=blue];
		1711 -> 1713;
	1712 [label="Если бы я думала, что они знают, что делают, и испытывают искренние чувства к этому парню, я была бы в восторге. Очевидно.",shape=box,color=blue];
		1712 -> 1714;
	1715 [label="Она всё ещё хочет, чтобы ты оправилась от этого, верно?",shape=box,color=red];
		1715 -> 1723;
	1713 [label="… нет ничего хуже, чем заслужить доверие Куинси. Он многое видит. Может, стоит присмотреться и сделать выводы.",shape=box,color=blue];
		1713 -> 1716;
	1714 [label="Но я хотела бы убедиться, что они знают, как легко причинить ему боль.",shape=box,color=blue];
		1714 -> 1719;
	1723 [label="Да брось. Скорее у меня вырастут крылья и хвост, чем ЭТО произойдёт.",shape=box,color=blue];
		1723 -> 1724;
	1716 [label="+5 Chemistry",color=orange];
		1716 -> 1717;
	1719 [label="Что это за роботы такие, снаружи сплошная броня и дерзость, а внутри всё мягкое и нежное, как органика?",shape=box,color=blue];
		1719 -> 1718;
		1719 -> 1720;
		1719 -> 1721;
	1724 [label="Энтрати исчез. Если когда-то и была надежда вернуть старую Элеонору, ту, что пела в душе и улыбалась детям на улице, эта надежда ушла вместе с ним.",shape=box,color=blue];
		1724 -> 1728;
		1724 -> 1729;
	1717 [label="Chat ends.",color=orange];
	1718 [label="Солярис?",shape=box,color=red];
		1718 -> 1722;
	1720 [label="Нокс?",shape=box,color=red];
		1720 -> 1722;
	1721 [label="Владеющие Разумом?",shape=box,color=red];
		1721 -> 1722;
	1728 [label="Лэтти нужно посмотреть в зеркало и понять, что она тоже всего в паре плохих дней от того, чтобы потерять свою человечность.",shape=box,color=red];
		1728 -> 1730;
	1729 [label="Если Артур считает, что ты всё ещё его сестра, этого должно быть достаточно и для Лэтти.",shape=box,color=red];
		1729 -> 1731;
	1722 [label="Неважно. Дело в том, что Артур такой же.",shape=box,color=blue];
		1722 -> 1725;
	1730 [label="Ты пытаешься расположить меня к себе?",shape=box,color=blue];
		1730 -> 1732;
	1731 [label="МОЖНО ПОДУМАТЬ.",shape=box,color=blue];
		1731 -> 1733;
	1725 [label="Если он тебя впустит, ради Сол, прояви к нему нежность.",shape=box,color=blue];
		1725 -> 1726;
	1732 [label="Я имею в виду, да. Она это делает.",shape=box,color=blue];
		1732 -> 1734;
	1733 [label="Лэтти обожает Артура. Он для неё старший брат, которого у неё никогда не было. Если бы Артура не было рядом, я бы проснулась с кляпом из хлороформа на лице и оказалась на дне реки.",shape=box,color=blue];
		1733 -> 1735;
	1726 [label="+5 Chemistry",color=orange];
		1726 -> 1727;
	1734 [label="Я до сих пор не простила ей то, что она сказала, что этот город должен сгореть.",shape=box,color=blue];
		1734 -> 1736;
	1735 [label="Она думает, что он грезит, цепляется за прошлое. Но она любит этого парня и она хороший солдат, поэтому никогда не пойдёт против него.",shape=box,color=blue];
		1735 -> 1737;
		1735 -> 1738;
	1727 [label="Chat ends.",color=orange];
	1736 [label="Даже Аои была в шоке. Это заставляет задуматься, кто здесь настоящие монстры, не так ли?",shape=box,color=blue];
		1736 -> 1737;
		1736 -> 1738;
	1737 [label="Почему она вообще тебя так ненавидит?",shape=box,color=red];
		1737 -> 1739;
	1738 [label="Неужели её действительно пугает только язык? Или её пугает способность чтения мыслей?",shape=box,color=red];
		1738 -> 1739;
	1739 [label="Это сложно. Причин может быть несколько.",shape=box,color=blue];
		1739 -> 1740;
	1740 [label="Она мне прямо в лицо сказала, что я не должна лезть ей в голову. Если бы я не согласилась, она бы ушла из Гекса и попытала бы счастья сама. Безумие.",shape=box,color=blue];
		1740 -> 1741;
	1741 [label="Так что отчасти это просто потому, что она боится, что я прочту её подростковый дневник, так сказать. Я загляну в её самые затаённые секреты и посмеюсь над ними до упаду, а она будет унижена навсегда.",shape=box,color=blue];
		1741 -> 1742;
	1742 [label="Правда в том, что я просто не настолько любопытна. Какой бы маленький секрет она ни скрывала от меня, это безопасно.",shape=box,color=blue];
		1742 -> 1743;
		1742 -> 1744;
	1743 [label="Была ли у вас двоих когда-нибудь… более романтическая история?",shape=box,color=red];
		1743 -> 1745;
	1744 [label="Как думаешь, может быть, ты ей НРАВИШЬСЯ?",shape=box,color=red];
		1744 -> 1746;
	1745 [label="Ты думаешь, что я буду болтать об этом направо-налево?",shape=box,color=blue];
		1745 -> 1747;
	1746 [label="Мне это приходило в голову.",shape=box,color=blue];
		1746 -> 1748;
	1747 [label="Нет, ничего не было.",shape=box,color=blue];
		1747 -> 1749;
	1748 [label="Я бы, наверное, не отказалась. В конце концов, нет ничего плохого в поцелуе и нежностях между друзьями, особенно если Артур должен был бы дать нам неловкую речь на брифинге о том, как не позволять нашим чувствам мешать работе.",shape=box,color=blue];
		1748 -> 1750;
	1749 [label="Что, в общем-то, к лучшему, потому что можешь представить, какая неловкость была бы между нами сейчас?",shape=box,color=blue];
		1749 -> 1751;
	1750 [label="Это позволяет выпустить пар, поднять боевой дух и стоит недорого.",shape=box,color=blue];
		1750 -> 1752;
	1751 [label="Я имею в виду… Я бы не сказала «нет». Просто этот вопрос никогда не поднимался.",shape=box,color=blue];
		1751 -> 1755;
	1752 [label="Но что бы ни скрывала мисс Гарсия, в её понимании это что-то люди могут использовать против неё. Так что я представляю угрозу, потому что могу увидеть это в её мыслях.",shape=box,color=blue];
		1752 -> 1754;
	1755 [label="+10 Chemistry",color=orange];
		1755 -> 1753;
	1754 [label="Подожди, разве Артур и Аои не были парой?",shape=box,color=red];
		1754 -> 1757;
	1753 [label="Так что если она тебя привлекает, то вперёд и с песней! Я буду болеть с трибуны! Луа знает, Лэтти точно не помешает немного счастья в её мрачной, одинокой жизни.",shape=box,color=blue];
		1753 -> 1756;
	1757 [label="А что? У тебя виды на моего брата? Или на Аои?",shape=box,color=blue];
		1757 -> 1758;
		1757 -> 1759;
		1757 -> 1760;
	1756 [label="Chat ends.",color=orange];
	1758 [label="Ну. Эм. Вообще-то...",shape=box,color=red];
		1758 -> 1761;
	1759 [label="Э-э… нет… на самом деле у меня на *тебя* виды…",shape=box,color=red];
		1759 -> 1762;
	1760 [label="Нет. Хаха. Они не в моем вкусе, извините. Слишком «героические».",shape=box,color=red];
		1760 -> 1801;
	1761 [label="Ой! Ой! Скажи...",shape=box,color=blue];
		1761 -> 1764;
		1761 -> 1765;
	1762 [label="Интересно.",shape=box,color=blue];
		1762 -> 1793;
	1801 [label="+20 Chemistry",color=orange];
		1801 -> 1763;
	1764 [label="Артур.",shape=box,color=red];
		1764 -> 1766;
	1765 [label="Аои.",shape=box,color=red];
		1765 -> 1767;
	1793 [label="Извини, это, вероятно, не тот ответ, которого ты ожидаешь, не так ли?",shape=box,color=blue];
		1793 -> 1794;
	1763 [label="ХАХАХА",shape=box,color=blue];
		1763 -> 1798;
	1766 [label="Я ЗНАЛА ЭТО.",shape=box,color=blue];
		1766 -> 1768;
	1767 [label="Я тебя нисколько не виню.",shape=box,color=blue];
		1767 -> 1770;
	1794 [label="Хорошо.",shape=box,color=blue];
		1794 -> 1795;
	1798 [label="Суровый, лихой Артур? Чистая, добросердечная Аои? Ни один из них не подходит тебе?",shape=box,color=blue];
		1798 -> 1799;
	1768 [label="У меня нет смелости сказать тебе, во что ты себя ввязываешь. Ты можешь пройти этот путь самостоятельно.",shape=box,color=blue];
		1768 -> 1769;
	1770 [label="Я знаю, она кажется слишком чистой, чтобы быть настоящей, но поверь мне, она такой же солдат, как и все мы.",shape=box,color=blue];
		1770 -> 1771;
	1795 [label="Посмотрим.",shape=box,color=blue];
		1795 -> 1796;
	1799 [label="Я заинтригована.",shape=box,color=blue];
		1799 -> 1800;
	1769 [label="Просто чтобы было ясно: травля Артура — МОЯ прерогатива. И если ты когда-нибудь будешь с ним жестока намеренно, я тебя убью. И ещё одно…",shape=box,color=blue];
		1769 -> 1772;
	1771 [label="Познакомься с НАСТОЯЩЕЙ Аои, а не с тем образом, который у тебя сложился в голове, и всё будет в порядке. А ещё…",shape=box,color=blue];
		1771 -> 1772;
	1796 [label="+5 Chemistry",color=orange];
		1796 -> 1797;
	1800 [label="«Мы поговорим об этом в другой раз», — сказала она, накидывая на лицо свой красный плащ и уходя...",shape=box,color=blue];
		1800 -> 1802;
	1772 [label="Отношения Артура и Аои стали одними из первых жертв этого конфликта. Ни один из них так и не оправился. Это открытая рана, так что будь осторожна.",shape=box,color=blue];
		1772 -> 1773;
		1772 -> 1774;
	1797 [label="Chat ends.",color=orange];
	1802 [label="Chat ends.",color=orange];
	1773 [label="Почему они расстались?",shape=box,color=red];
		1773 -> 1775;
	1774 [label="Я не могу представить, чтобы у них что-то получилось.",shape=box,color=red];
		1774 -> 1791;
	1775 [label="Почему ты спрашиваешь?",shape=box,color=blue];
		1775 -> 1776;
		1775 -> 1777;
	1791 [label="+10 Chemistry",color=orange];
		1791 -> 1788;
	1776 [label="Никогда не бывает вреда от безобидных сплетен.",shape=box,color=red];
		1776 -> 1778;
	1777 [label="Это было бы полезно, чтобы не сыпать соль на раны.",shape=box,color=red];
		1777 -> 1786;
	1788 [label="Ну, в этом ничего уникального.",shape=box,color=blue];
		1788 -> 1789;
	1778 [label="Хм. Я не согласна.",shape=box,color=blue];
		1778 -> 1779;
	1786 [label="+20 Chemistry",color=orange];
		1786 -> 1782;
	1789 [label="Но нельзя же подойти к людям, которые горюют, сказать: «Я же говорила». Надо их поддерживать. Я сделала всё, что могла, чтобы утешить Артура, а Лэтти старалась залечить разбитое сердце Аои.",shape=box,color=blue];
		1789 -> 1790;
	1779 [label="Аои — мой друг. И каким бы придурком ни был Артур, он всё равно мой брат.",shape=box,color=blue];
		1779 -> 1780;
	1782 [label="Ладно. Я не знаю, что ОНИ тебе скажут, но с моей точки зрения они просто тянут в разные стороны.",shape=box,color=blue];
		1782 -> 1783;
	1790 [label="Проявляй осторожность. Вот всё, что я хочу сказать.",shape=box,color=blue];
		1790 -> 1792;
	1780 [label="Я не уверена, что мне следует тебе что-то доверять.",shape=box,color=blue];
		1780 -> 1781;
	1783 [label="Они оба романтики, просто разного рода. Артур хочет дом с розами у двери. Он утверждает, что не хочет, но это не так.",shape=box,color=blue];
		1783 -> 1784;
	1792 [label="Chat ends.",color=orange];
	1781 [label="Chat ends.",color=orange];
	1784 [label="Боги, он даже говорил, что когда-нибудь откроет паб. Я могу точно представить его с его маленькой компанией постоянных клиентов, наливающим пиво, готовящим воскресные жаркое, полный жизненной мудрости, добытой с трудом.",shape=box,color=blue];
		1784 -> 1785;
	1785 [label="Можешь ли ты представить, чтобы Аои нашла себе место в таком сне? Я не могу. Ей нужно пространство, чтобы расправить крылья.",shape=box,color=blue];
		1785 -> 1787;
	1787 [label="Chat ends.",color=orange];
}