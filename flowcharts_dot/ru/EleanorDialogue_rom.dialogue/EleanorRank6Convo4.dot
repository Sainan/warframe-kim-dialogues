digraph {
	2968 [label="EleanorRank6Convo4 begins.",color=orange];
		2968 -> 2969;
	2969 [label="У тебя когда-нибудь бывает так, что ты принимаешь душ, и вдруг какой-то странный голосок задаёт вопрос, который никогда раньше не возникал?",shape=box,color=blue];
		2969 -> 2970;
		2969 -> 2971;
		2969 -> 2972;
	2970 [label="Не совсем, нет. [Завершить]",shape=box,color=red];
		2970 -> 2973;
	2971 [label="Например: Что подумали люди на Земле, когда Луа вдруг снова появилась в небе?",shape=box,color=red];
		2971 -> 2974;
	2972 [label="Ты имеешь в виду что-то вроде \"Оператор! Вы могли бы рассмотреть возможность сделать своего плюшевого кубрау?\"",shape=box,color=red];
		2972 -> 2975;
	2973 [label="Chat ends.",color=orange];
	2974 [label="Верно, именно.",shape=box,color=blue];
		2974 -> 2976;
	2975 [label="Это просто Ордис. Он так делает.",shape=box,color=red];
		2975 -> 2977;
	2976 [label="погоди",shape=box,color=blue];
		2976 -> 2978;
	2977 [label="Благослови его. Нет, я имею в виду внутренний голос.",shape=box,color=blue];
		2977 -> 2979;
	2978 [label="Луа исчезла?",shape=box,color=blue];
		2978 -> 2980;
	2979 [label="Будто бы твой разум занимался чем-то другим, пока занимаешься важным делом - личной гигиеной.",shape=box,color=blue];
		2979 -> 2981;
	2980 [label="Надолго? Куда она делась? Что случилось с приливами и отливами?",shape=box,color=blue];
		2980 -> 2982;
		2980 -> 2983;
	2981 [label="Со мной так всё время. Странно случайно. Так часто в последнее время, что я начинаю задаваться вопросом, действительно ли они вообще из моей головы.",shape=box,color=blue];
		2981 -> 2984;
	2982 [label="В порядке: не знаю, Бездна, не знаю.",shape=box,color=red];
		2982 -> 2985;
	2983 [label="Лотос отправила её в Бездну в конце Старой Войны. Ребёнок вернул её совсем недавно.",shape=box,color=red];
		2983 -> 2986;
	2984 [label="Некоторые из них я превратила в картины.",shape=box,color=blue];
		2984 -> 2985;
	2985 [label="неважно, мы ещё вернёмся к этому.",shape=box,color=blue];
		2985 -> 2987;
	2986 [label="Понятия не имею, как там приливы.",shape=box,color=red];
		2986 -> 2988;
	2987 [label="Итак, случайные мысли под душем. Сегодня утром меня просто ошеломило.",shape=box,color=blue];
		2987 -> 2989;
	2988 [label="Как Лотос могла сместить целую ЛУНУ?",shape=box,color=blue];
		2988 -> 2985;
	2989 [label="Оно звучало так: Эй, а что, если Боги реальны?",shape=box,color=blue];
		2989 -> 2990;
	2990 [label="Я на мгновение задрожала. Чтобы прийти в себя, пришлось умыть лицо холодной водой.",shape=box,color=blue];
		2990 -> 2991;
		2990 -> 2992;
		2990 -> 2993;
	2991 [label="Что в этом странного? Мне кажется, что это довольно простой вопрос.",shape=box,color=red];
		2991 -> 2994;
	2992 [label="... разве люди не верят, что Боги реальны? Я уверена, что Лэтти верит.",shape=box,color=red];
		2992 -> 2995;
	2993 [label="Да, это ужасно.",shape=box,color=red];
		2993 -> 2996;
	2994 [label="Ах, вот почему я обожаю говорить с тобой об этих вещах",shape=box,color=blue];
		2994 -> 2997;
	2995 [label="Да брось. Никто на самом деле не думает, что Боги реальны. Реальны в плане как столы и стулья.",shape=box,color=blue];
		2995 -> 2998;
	2996 [label="Не так ли? Что, если каждый раз, когда ты думаешь, что вселенная посылает тебе послание, оно на самом деле им является?",shape=box,color=blue];
		2996 -> 2999;
	2997 [label="Твоя жизнь настолько фантастически абсурдна, что реальность богов для тебя стала настолько же естественным вопросом, как и относительные достоинства начинки для пиццы.",shape=box,color=blue];
		2997 -> 3000;
	2998 [label="Настоящие Боги — это как деревенские колодцы и туалеты на дворе. Это то, что у людей было РАНЬШЕ.",shape=box,color=blue];
		2998 -> 3001;
	2999 [label="Представь, что всё оказалось в руках этих мелочных, бессмертных ублюдков, которые правили просто так, а не потому, что заслуживали этого.",shape=box,color=blue];
		2999 -> 3002;
	3000 [label="Может, тебе уже удалось встретить Бога. Если это то, чем является Безразличие.",shape=box,color=blue];
		3000 -> 3003;
	3001 [label="Теперь это просто символы, метафоры или что-то в этом роде.",shape=box,color=blue];
		3001 -> 3004;
		3001 -> 3005;
	3002 [label="И самое безумное в том, что именно так люди жили на самом деле. Это была их реальность, каждый день их жизни.",shape=box,color=blue];
		3002 -> 3006;
	3003 [label="Ты только что напомнила мне кое-что из Заримана. Первое знакомство с Безразличием.",shape=box,color=red];
		3003 -> 3007;
	3004 [label="Может быть, люди просто стали меньше бояться?",shape=box,color=red];
		3004 -> 3008;
	3005 [label="Я думаю, что Сол и Луа — ваши Боги.",shape=box,color=red];
		3005 -> 3009;
	3006 [label="Для них Боги были такими же реальными, как погода, и они не обращали на них внимания.",shape=box,color=blue];
		3006 -> 3010;
	3007 [label="Тогда, естественно мне не было известно, что это именно так. Однако я помню, что там говорилось.",shape=box,color=red];
		3007 -> 3011;
	3008 [label="Я думаю, что это всё, да.",shape=box,color=blue];
		3008 -> 3012;
	3009 [label="Ну, да, они таковы. Но это также просто небесные тела.",shape=box,color=blue];
		3009 -> 3013;
	3010 [label="Честно говоря, это не сильно отличается от жизни под Орокин.",shape=box,color=red];
		3010 -> 3014;
	3011 [label="Я сказал, что она может взять мой свет. Она улыбнулась и сказала: «Спасибо, малыш. Я так и сделаю».",shape=box,color=red];
		3011 -> 3015;
	3012 [label="И, кажется, я знаю, почему.",shape=box,color=blue];
		3012 -> 3016;
	3013 [label="Например, Британия  это страна, с именем, самобытностью и прочим, но это также просто куча земли и камней. Она может быть и тем, и другим одновременно.",shape=box,color=blue];
		3013 -> 3017;
	3014 [label="Бессмертные, мелочные, при власти, потому что они уже были при власти...",shape=box,color=red];
		3014 -> 3018;
	3015 [label="О, черт, от тебя у меня мурашки по коже.",shape=box,color=blue];
		3015 -> 3019;
	3016 [label="Всё дело в свете.",shape=box,color=blue];
		3016 -> 3020;
	3017 [label="Ты можешь пойти куда-то в прекрасный солнечный день, почувствовать благодарность, посмотреть на Сол и сказать «Спасибо»! Ты говоришь серьёзно. Это по-человечески.",shape=box,color=blue];
		3017 -> 3021;
	3018 [label="Правильно. У вас БЫЛИ живые Боги. Но вы их всех убили.",shape=box,color=blue];
		3018 -> 3022;
	3019 [label="Дьявол  это тот, кто строго следует букве закона, во всех старых народных сказках.",shape=box,color=blue];
		3019 -> 3023;
	3020 [label="Что такое Сол и Луа, в конце концов? До того, как кому-то пришло в голову считать их богами, они были ИСТОЧНИКАМИ СВЕТА.",shape=box,color=blue];
		3020 -> 3024;
		3020 -> 3025;
	3021 [label="Но сегодня никто не думает, что Сол или Луа буквально сделали какую-то человеческую женщину беременной или стали матерью ребёнку какого-то человеческого парня, и именно оттуда произошёл Король.",shape=box,color=blue];
		3021 -> 3026;
	3022 [label="(Не пойми меня неправильно, мне это нравится.)",shape=box,color=blue];
		3022 -> 3027;
	3023 [label="Думаешь, она чувствует, что получила от тебя обещание ? Твоего «света»?",shape=box,color=blue];
		3023 -> 3028;
		3023 -> 3029;
	3024 [label="Верно. Свет символизирует добро всё же.",shape=box,color=red];
		3024 -> 3030;
	3025 [label="Единственный свет, которым обладало человечество на протяжении долгого, долгого времени.",shape=box,color=red];
		3025 -> 3030;
	3026 [label="Раньше люди верили в это. Теперь мы знаем, что эти истории были просто легендами. Мы их переросли.",shape=box,color=blue];
		3026 -> 3031;
		3026 -> 3032;
	3027 [label="Ты путаешь меня с этим парнем. Я никогда не был частью великого восстания Тэнно.",shape=box,color=red];
		3027 -> 3033;
	3028 [label="Там говорится, что мы заключили договор. Так что, наверное, она думает, что я в долгу.",shape=box,color=red];
		3028 -> 3034;
	3029 [label="Я имел в виду светящийся шар, который был у меня, но кто знает, что он мог значить.",shape=box,color=red];
		3029 -> 3034;
	3030 [label="ДА.",shape=box,color=blue];
		3030 -> 3035;
	3031 [label="Боги и люди... собрались вместе?",shape=box,color=red];
		3031 -> 3036;
	3032 [label="Короли с богами вместо родителей? А мне казалось, что Орокин  просто ублюдки.",shape=box,color=red];
		3032 -> 3036;
	3033 [label="Мне никогда не доводилось участвовать в программе Маргулис для Очень Особых Детей, никогда не удавалось получить варфрейм, никогда не приходилось сражаться в Старой Войне.",shape=box,color=red];
		3033 -> 3037;
	3034 [label="По крайней мере, одно я знаю об этом. Она играет в игры.",shape=box,color=red];
		3034 -> 3038;
	3035 [label="Но потом какой-то маленький пещерный ботаник, которого, вероятно, подцепили большие пещерные девчонки, случайно ударили камень о камень, и вот результат.",shape=box,color=blue];
		3035 -> 3039;
	3036 [label="Ох, такого было много. По всему миру.",shape=box,color=blue];
		3036 -> 3040;
	3037 [label="... тебе бы этого хотелось?",shape=box,color=blue];
		3037 -> 3041;
		3037 -> 3042;
		3037 -> 3043;
	3038 [label="+20 Chemistry",color=orange];
		3038 -> 3044;
	3039 [label="Свет по требованию! Независимость от больших огней в небе!",shape=box,color=blue];
		3039 -> 3045;
	3040 [label="Представь, что ты какой-то высокомерный священник, отправляющийся в море, чтобы проповедовать евангелие Сол дикарям в новом мире, только чтобы обнаружить, что они не только уже знают всё о Сол, но и что настоящий сын Сол правит ими.",shape=box,color=blue];
		3040 -> 3046;
	3041 [label="Я действительно не знаю.",shape=box,color=red];
		3041 -> 3047;
	3042 [label="Честно говоря, нет.",shape=box,color=red];
		3042 -> 3048;
	3043 [label="Да, хорошо бы.",shape=box,color=red];
		3043 -> 3049;
	3044 [label="ладно. Как бы там ни было сегодня и кто бы с тобой ни был, будь то я или Артур или кто-либо из нас… береги себя.",shape=box,color=blue];
		3044 -> 3050;
	3045 [label="Теперь — посмотри. Свет повсюду. Мы сделали его дешёвым.",shape=box,color=blue];
		3045 -> 3003;
	3046 [label="И ты бежишь домой, поджав хвост, или сразу обращаешься в веру.",shape=box,color=blue];
		3046 -> 3051;
		3046 -> 3052;
	3047 [label="Это справедливо. Я это уважаю.",shape=box,color=blue];
		3047 -> 3057;
	3048 [label="Я рада. Если ты чувствуешь, что твоя жизнь могла быть хуже, чем она есть, полагаю, нам есть чем отпраздновать?",shape=box,color=blue];
		3048 -> 3057;
	3049 [label="Я понимаю, думаю. Многое прошло вдали от тебя, не так ли?",shape=box,color=blue];
		3049 -> 3057;
	3050 [label="Check boolean EleanorDating",color=orange];
		3050 -> 3054 [label=true,color=green];
		3050 -> 3055 [label=false,color=brown];
	3051 [label="Ты действительно веришь, что Боги реальны? Или ты просто боишься мысли, что они могут существовать?",shape=box,color=red];
		3051 -> 3056;
	3052 [label="Ладно. Значит, ты говоришь: а что, если люди в прошлом были правы всё это время?",shape=box,color=red];
		3052 -> 3056;
	3057 [label="Check boolean EleanorDating",color=orange];
		3057 -> 3053 [label=true,color=green];
		3057 -> 3310 [label=false,color=brown];
	3054 [label="Я люблю тебя. Любой бог, который попытается встать на пути этого, пусть лучше помолится тому, кто, черт возьми, стоит выше богов.",shape=box,color=blue];
		3054 -> 3058;
	3055 [label="Ты мой дорогой друг. Любой Бог, который попытается отнять тебя у меня, испытает свою реальность в тяжёлом испытании.",shape=box,color=blue];
		3055 -> 3059;
	3056 [label="Скажем так, раньше я была гораздо увереннее в скучной материальной реальности вещей, чем сейчас.",shape=box,color=blue];
		3056 -> 3060;
	3053 [label="+20 Chemistry",color=orange];
		3053 -> 3061;
	3310 [label="+20 Chemistry",color=orange];
		3310 -> 3062;
	3058 [label="Chat ends.",color=orange];
	3059 [label="Chat ends.",color=orange];
	3060 [label="Там, где раньше была эта уверенность, теперь есть дыра в форме Скитальца.",shape=box,color=blue];
		3060 -> 3063;
	3061 [label="У нас обоих есть свои шрамы, моя любовь.",shape=box,color=blue];
		3061 -> 3064;
	3062 [label="У нас обоих есть свои шрамы.",shape=box,color=blue];
		3062 -> 3065;
	3063 [label="+20 Chemistry",color=orange];
		3063 -> 3066;
	3064 [label="Chat ends.",color=orange];
	3065 [label="Chat ends.",color=orange];
	3066 [label="Честно? Я не скучаю по этому, правда. Иногда приятно переживать из-за всех этих возможностей.",shape=box,color=blue];
		3066 -> 3067;
	3067 [label="Chat ends.",color=orange];
