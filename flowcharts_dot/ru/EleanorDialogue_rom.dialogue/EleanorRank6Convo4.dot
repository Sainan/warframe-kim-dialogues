digraph {
	"EleanorRank6Convo4 begins." [color=orange];
		"EleanorRank6Convo4 begins." -> j2517610411;
	j2517610411 [label="У тебя когда-нибудь бывает так, что ты принимаешь душ, и вдруг какой-то странный голосок задаёт вопрос, который никогда раньше не возникал?",shape=box,color=blue];
		j2517610411 -> j3671809506;
		j2517610411 -> j2623677503;
		j2517610411 -> j1138472593;
	j3671809506 [label="Не совсем, нет. [Завершить]",shape=box,color=red];
		j3671809506 -> "Chat ends.";
	j2623677503 [label="Например: Что подумали люди на Земле, когда Луа вдруг снова появилась в небе?",shape=box,color=red];
		j2623677503 -> j920077907;
	j1138472593 [label="Ты имеешь в виду что-то вроде \"Оператор! Вы могли бы рассмотреть возможность сделать своего плюшевого кубрау?\"",shape=box,color=red];
		j1138472593 -> j719957055;
	"Chat ends." [color=orange];
	j920077907 [label="Верно, именно.",shape=box,color=blue];
		j920077907 -> j218687345;
	j719957055 [label="Это просто Ордис. Он так делает.",shape=box,color=red];
		j719957055 -> j3475505153;
	j218687345 [label="погоди",shape=box,color=blue];
		j218687345 -> j227204441;
	j3475505153 [label="Благослови его. Нет, я имею в виду внутренний голос.",shape=box,color=blue];
		j3475505153 -> j102693763;
	j227204441 [label="Луа исчезла?",shape=box,color=blue];
		j227204441 -> j1873468191;
	j102693763 [label="Будто бы твой разум занимался чем-то другим, пока занимаешься важным делом - личной гигиеной.",shape=box,color=blue];
		j102693763 -> j622558655;
	j1873468191 [label="Надолго? Куда она делась? Что случилось с приливами и отливами?",shape=box,color=blue];
		j1873468191 -> j3114281867;
		j1873468191 -> j3748299860;
	j622558655 [label="Со мной так всё время. Странно случайно. Так часто в последнее время, что я начинаю задаваться вопросом, действительно ли они вообще из моей головы.",shape=box,color=blue];
		j622558655 -> j1034953178;
	j3114281867 [label="В порядке: не знаю, Бездна, не знаю.",shape=box,color=red];
		j3114281867 -> j3399479145;
	j3748299860 [label="Лотос отправила её в Бездну в конце Старой Войны. Ребёнок вернул её совсем недавно.",shape=box,color=red];
		j3748299860 -> j1670391202;
	j1034953178 [label="Некоторые из них я превратила в картины.",shape=box,color=blue];
		j1034953178 -> j3399479145;
	j3399479145 [label="неважно, мы ещё вернёмся к этому.",shape=box,color=blue];
		j3399479145 -> j2185660788;
	j1670391202 [label="Понятия не имею, как там приливы.",shape=box,color=red];
		j1670391202 -> j1114513573;
	j2185660788 [label="Итак, случайные мысли под душем. Сегодня утром меня просто ошеломило.",shape=box,color=blue];
		j2185660788 -> j2242033196;
	j1114513573 [label="Как Лотос могла сместить целую ЛУНУ?",shape=box,color=blue];
		j1114513573 -> j3399479145;
	j2242033196 [label="Оно звучало так: Эй, а что, если Боги реальны?",shape=box,color=blue];
		j2242033196 -> j2819241410;
	j2819241410 [label="Я на мгновение задрожала. Чтобы прийти в себя, пришлось умыть лицо холодной водой.",shape=box,color=blue];
		j2819241410 -> j2213744257;
		j2819241410 -> j2200594640;
		j2819241410 -> j529069542;
	j2213744257 [label="Что в этом странного? Мне кажется, что это довольно простой вопрос.",shape=box,color=red];
		j2213744257 -> j1034458262;
	j2200594640 [label="... разве люди не верят, что Боги реальны? Я уверена, что Лэтти верит.",shape=box,color=red];
		j2200594640 -> j3429850454;
	j529069542 [label="Да, это ужасно.",shape=box,color=red];
		j529069542 -> j797026844;
	j1034458262 [label="Ах, вот почему я обожаю говорить с тобой об этих вещах",shape=box,color=blue];
		j1034458262 -> j2899522432;
	j3429850454 [label="Да брось. Никто на самом деле не думает, что Боги реальны. Реальны в плане как столы и стулья.",shape=box,color=blue];
		j3429850454 -> j1641528289;
	j797026844 [label="Не так ли? Что, если каждый раз, когда ты думаешь, что вселенная посылает тебе послание, оно на самом деле им является?",shape=box,color=blue];
		j797026844 -> j3965019382;
	j2899522432 [label="Твоя жизнь настолько фантастически абсурдна, что реальность богов для тебя стала настолько же естественным вопросом, как и относительные достоинства начинки для пиццы.",shape=box,color=blue];
		j2899522432 -> j2212680199;
	j1641528289 [label="Настоящие Боги — это как деревенские колодцы и туалеты на дворе. Это то, что у людей было РАНЬШЕ.",shape=box,color=blue];
		j1641528289 -> j3761239544;
	j3965019382 [label="Представь, что всё оказалось в руках этих мелочных, бессмертных ублюдков, которые правили просто так, а не потому, что заслуживали этого.",shape=box,color=blue];
		j3965019382 -> j1033783894;
	j2212680199 [label="Может, тебе уже удалось встретить Бога. Если это то, чем является Безразличие.",shape=box,color=blue];
		j2212680199 -> j1518561392;
	j3761239544 [label="Теперь это просто символы, метафоры или что-то в этом роде.",shape=box,color=blue];
		j3761239544 -> j289856055;
		j3761239544 -> j1363820476;
	j1033783894 [label="И самое безумное в том, что именно так люди жили на самом деле. Это была их реальность, каждый день их жизни.",shape=box,color=blue];
		j1033783894 -> j332542801;
	j1518561392 [label="Ты только что напомнила мне кое-что из Заримана. Первое знакомство с Безразличием.",shape=box,color=red];
		j1518561392 -> j576888098;
	j289856055 [label="Может быть, люди просто стали меньше бояться?",shape=box,color=red];
		j289856055 -> j2405513792;
	j1363820476 [label="Я думаю, что Сол и Луа — ваши Боги.",shape=box,color=red];
		j1363820476 -> j2764621699;
	j332542801 [label="Для них Боги были такими же реальными, как погода, и они не обращали на них внимания.",shape=box,color=blue];
		j332542801 -> j1469900689;
	j576888098 [label="Тогда, естественно мне не было известно, что это именно так. Однако я помню, что там говорилось.",shape=box,color=red];
		j576888098 -> j2764419681;
	j2405513792 [label="Я думаю, что это всё, да.",shape=box,color=blue];
		j2405513792 -> j3420534761;
	j2764621699 [label="Ну, да, они таковы. Но это также просто небесные тела.",shape=box,color=blue];
		j2764621699 -> j4015865191;
	j1469900689 [label="Честно говоря, это не сильно отличается от жизни под Орокин.",shape=box,color=red];
		j1469900689 -> j240144393;
	j2764419681 [label="Я сказал, что она может взять мой свет. Она улыбнулась и сказала: «Спасибо, малыш. Я так и сделаю».",shape=box,color=red];
		j2764419681 -> j815870894;
	j3420534761 [label="И, кажется, я знаю, почему.",shape=box,color=blue];
		j3420534761 -> j3840430911;
	j4015865191 [label="Например, Британия  это страна, с именем, самобытностью и прочим, но это также просто куча земли и камней. Она может быть и тем, и другим одновременно.",shape=box,color=blue];
		j4015865191 -> j144423769;
	j240144393 [label="Бессмертные, мелочные, при власти, потому что они уже были при власти...",shape=box,color=red];
		j240144393 -> j599989871;
	j815870894 [label="О, черт, от тебя у меня мурашки по коже.",shape=box,color=blue];
		j815870894 -> j2614959572;
	j3840430911 [label="Всё дело в свете.",shape=box,color=blue];
		j3840430911 -> j201040495;
	j144423769 [label="Ты можешь пойти куда-то в прекрасный солнечный день, почувствовать благодарность, посмотреть на Сол и сказать «Спасибо»! Ты говоришь серьёзно. Это по-человечески.",shape=box,color=blue];
		j144423769 -> j3149656471;
	j599989871 [label="Правильно. У вас БЫЛИ живые Боги. Но вы их всех убили.",shape=box,color=blue];
		j599989871 -> j4237671486;
	j2614959572 [label="Дьявол  это тот, кто строго следует букве закона, во всех старых народных сказках.",shape=box,color=blue];
		j2614959572 -> j878615260;
	j201040495 [label="Что такое Сол и Луа, в конце концов? До того, как кому-то пришло в голову считать их богами, они были ИСТОЧНИКАМИ СВЕТА.",shape=box,color=blue];
		j201040495 -> j3230535663;
		j201040495 -> j4037616471;
	j3149656471 [label="Но сегодня никто не думает, что Сол или Луа буквально сделали какую-то человеческую женщину беременной или стали матерью ребёнку какого-то человеческого парня, и именно оттуда произошёл Король.",shape=box,color=blue];
		j3149656471 -> j1927944527;
	j4237671486 [label="(Не пойми меня неправильно, мне это нравится.)",shape=box,color=blue];
		j4237671486 -> j2838785557;
	j878615260 [label="Думаешь, она чувствует, что получила от тебя обещание? Твоего «света»?",shape=box,color=blue];
		j878615260 -> j1870112261;
		j878615260 -> j975365925;
	j3230535663 [label="Верно. Свет символизирует добро всё же.",shape=box,color=red];
		j3230535663 -> j2542175687;
	j4037616471 [label="Единственный свет, которым обладало человечество на протяжении долгого, долгого времени.",shape=box,color=red];
		j4037616471 -> j2542175687;
	j1927944527 [label="Раньше люди верили в это. Теперь мы знаем, что эти истории были просто легендами. Мы их переросли.",shape=box,color=blue];
		j1927944527 -> j3011257261;
		j1927944527 -> j3808831062;
	j2838785557 [label="Ты путаешь меня с этим парнем. Я никогда не был частью великого восстания Тэнно.",shape=box,color=red];
		j2838785557 -> j1509681547;
	j1870112261 [label="Там говорится, что мы заключили договор. Так что, наверное, она думает, что я в долгу.",shape=box,color=red];
		j1870112261 -> j1555903718;
	j975365925 [label="Я имел в виду светящийся шар, который был у меня, но кто знает, что он мог значить.",shape=box,color=red];
		j975365925 -> j1555903718;
	j2542175687 [label="ДА.",shape=box,color=blue];
		j2542175687 -> j1079242078;
	j3011257261 [label="Боги и люди... собрались вместе?",shape=box,color=red];
		j3011257261 -> j1201426111;
	j3808831062 [label="Короли с богами вместо родителей? А мне казалось, что Орокин  просто ублюдки.",shape=box,color=red];
		j3808831062 -> j1201426111;
	j1509681547 [label="Мне никогда не доводилось участвовать в программе Маргулис для Очень Особых Детей, никогда не удавалось получить варфрейм, никогда не приходилось сражаться в Старой Войне.",shape=box,color=red];
		j1509681547 -> j2107176256;
	j1555903718 [label="По крайней мере, одно я знаю об этом. Она играет в игры.",shape=box,color=red];
		j1555903718 -> j483299931;
	j1079242078 [label="Но потом какой-то маленький пещерный ботаник, которого, вероятно, подцепили большие пещерные девчонки, случайно ударили камень о камень, и вот результат.",shape=box,color=blue];
		j1079242078 -> j806480826;
	j1201426111 [label="Ох, такого было много. По всему миру.",shape=box,color=blue];
		j1201426111 -> j605068619;
	j2107176256 [label="... тебе бы этого хотелось?",shape=box,color=blue];
		j2107176256 -> j3181188857;
		j2107176256 -> j2664946184;
		j2107176256 -> j841636646;
	j483299931 [label="+20 Chemistry",color=orange];
		j483299931 -> j697869007;
	j806480826 [label="Свет по требованию! Независимость от больших огней в небе!",shape=box,color=blue];
		j806480826 -> j4101329862;
	j605068619 [label="Представь, что ты какой-то высокомерный священник, отправляющийся в море, чтобы проповедовать евангелие Сол дикарям в новом мире, только чтобы обнаружить, что они не только уже знают всё о Сол, но и что настоящий сын Сол правит ими.",shape=box,color=blue];
		j605068619 -> j2178348311;
	j3181188857 [label="Я действительно не знаю.",shape=box,color=red];
		j3181188857 -> j1738294659;
	j2664946184 [label="Честно говоря, нет.",shape=box,color=red];
		j2664946184 -> j3289954910;
	j841636646 [label="Да, хорошо бы.",shape=box,color=red];
		j841636646 -> j2678172676;
	j697869007 [label="ладно. Как бы там ни было сегодня и кто бы с тобой ни был, будь то я или Артур или кто-либо из нас… береги себя.",shape=box,color=blue];
		j697869007 -> j3435349021;
	j4101329862 [label="Теперь — посмотри. Свет повсюду. Мы сделали его дешёвым.",shape=box,color=blue];
		j4101329862 -> j1518561392;
	j2178348311 [label="И ты бежишь домой, поджав хвост, или сразу обращаешься в веру.",shape=box,color=blue];
		j2178348311 -> j2274792316;
		j2178348311 -> j2663377166;
	j1738294659 [label="Это справедливо. Я это уважаю.",shape=box,color=blue];
		j1738294659 -> j2991126293;
	j3289954910 [label="Я рада. Если ты чувствуешь, что твоя жизнь могла быть хуже, чем она есть, полагаю, нам есть чем отпраздновать?",shape=box,color=blue];
		j3289954910 -> j2991126293;
	j2678172676 [label="Я понимаю, думаю. Многое прошло вдали от тебя, не так ли?",shape=box,color=blue];
		j2678172676 -> j2991126293;
	j3435349021 [label="Check boolean EleanorDating",color=orange];
		j3435349021 -> j1189959486 [label=true,color=green];
		j3435349021 -> j570903771 [label=false,color=brown];
	j2274792316 [label="Ты действительно веришь, что Боги реальны? Или ты просто боишься мысли, что они могут существовать?",shape=box,color=red];
		j2274792316 -> j1675662353;
	j2663377166 [label="Ладно. Значит, ты говоришь: а что, если люди в прошлом были правы всё это время?",shape=box,color=red];
		j2663377166 -> j1675662353;
	j2991126293 [label="Check boolean EleanorDating",color=orange];
		j2991126293 -> j687547537 [label=true,color=green];
		j2991126293 -> j4162961185 [label=false,color=brown];
	j1189959486 [label="Я люблю тебя. Любой бог, который попытается встать на пути этого, пусть лучше помолится тому, кто, черт возьми, стоит выше богов.",shape=box,color=blue];
		j1189959486 -> "Chat ends.";
	j570903771 [label="Ты мой дорогой друг. Любой Бог, который попытается отнять тебя у меня, испытает свою реальность в тяжёлом испытании.",shape=box,color=blue];
		j570903771 -> "Chat ends.";
	j1675662353 [label="Скажем так, раньше я была гораздо увереннее в скучной материальной реальности вещей, чем сейчас.",shape=box,color=blue];
		j1675662353 -> j2884524527;
	j687547537 [label="+20 Chemistry",color=orange];
		j687547537 -> j1071453734;
	j4162961185 [label="+20 Chemistry",color=orange];
		j4162961185 -> j232765496;
	j2884524527 [label="Там, где раньше была эта уверенность, теперь есть дыра в форме Скитальца.",shape=box,color=blue];
		j2884524527 -> j72706371;
	j1071453734 [label="У нас обоих есть свои шрамы, моя любовь.",shape=box,color=blue];
		j1071453734 -> "Chat ends.";
	j232765496 [label="У нас обоих есть свои шрамы.",shape=box,color=blue];
		j232765496 -> "Chat ends.";
	j72706371 [label="+20 Chemistry",color=orange];
		j72706371 -> j2935493065;
	j2935493065 [label="Честно? Я не скучаю по этому, правда. Иногда приятно переживать из-за всех этих возможностей.",shape=box,color=blue];
		j2935493065 -> "Chat ends.";
}