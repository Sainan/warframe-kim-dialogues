digraph {
	553 [label="EleanorRank2Convo4 begins.",color=orange];
		553 -> 554;
	554 [label="Как ты думаешь, что происходит после смерти?",shape=box,color=blue];
		554 -> 555;
		554 -> 556;
		554 -> 557;
		554 -> 558;
	555 [label="Я в порядке, Элеонора, спасибо, что спросила! А как ты?",shape=box,color=red];
		555 -> 560;
	556 [label="... Ты в порядке?",shape=box,color=red];
		556 -> 561;
	557 [label="Мне пришлось повидать достаточно, чтобы понять, что личность может пережить смерть.",shape=box,color=red];
		557 -> 562;
	558 [label="Никаких больше глупых разговоров. [Завершить]",shape=box,color=red];
		558 -> 559;
	560 [label="Хех.",shape=box,color=blue];
		560 -> 563;
	561 [label="Совсем нет.",shape=box,color=blue];
		561 -> 564;
	562 [label="Продолжай?",shape=box,color=blue];
		562 -> 565;
	559 [label="Chat ends.",color=orange];
	563 [label="Слушай, мы можем поговорить о погоде, если хочешь.",shape=box,color=blue];
		563 -> 566;
	564 [label="Но я не думаю о смерти в каком-то мрачном ключе, если ты об этом волновалась. Я счастлива продолжать жить ещё долго.",shape=box,color=blue];
		564 -> 567;
	565 [label="(Представь меня лежащей на животе, растянувшейся на весь диван, с подбородком на руках, смотрящей на Пом-2 и с нетерпением ожидающей, что ты напишешь дальше.)",shape=box,color=blue];
		565 -> 572;
		565 -> 573;
		565 -> 574;
		565 -> 575;
	566 [label="Или, раз уж мы уже в торговом центре, можем взять латте и поболтать о том, какая Лэтти настоящая стерва за то, что держит все эти розово-жёлтые таблетки при себе, вместо того чтобы делиться с нами, как ей положено, не так ли?",shape=box,color=blue];
		566 -> 568;
	567 [label="Просто у меня много долгих, тёмных часов в одиночестве и достаточно времени, чтобы размышлять, пока мои бедные маленькие клетки крутятся и извиваются, как сухарики в ведьмином бульоне, в который превратилась моя кровь.",shape=box,color=blue];
		567 -> 572;
		567 -> 573;
		567 -> 574;
		567 -> 575;
	572 [label="У нас там, откуда я, есть «Цефалоны». Стеклянные кубы, которые раньше были людьми, и всё ещё выражают их личность. Ну, почти.",shape=box,color=red];
		572 -> 576;
	573 [label="Орокин переносили своё сознание в украденные тела, чтобы жить вечно.",shape=box,color=red];
		573 -> 577;
	574 [label="Все Тэнно могут использовать «перенос», чтобы управлять варфреймами. Мы не привязаны к физической форме. Так что странно представлять, что наше существование заканчивается, когда наши тела умирают.",shape=box,color=red];
		574 -> 578;
	575 [label="Мне очень некомфортно подпитывать эту твою одержимость, Элеонора.",shape=box,color=red];
		575 -> 579;
	568 [label="(Мне противно это писать. Извини.)",shape=box,color=blue];
		568 -> 569;
	576 [label="Check boolean EleanorOrigin",color=orange];
		576 -> 580 [label=true,color=green];
		576 -> 581 [label=false,color=brown];
	577 [label="Check boolean EleanorEntrati",color=orange];
		577 -> 582 [label=true,color=green];
		577 -> 583 [label=false,color=brown];
	578 [label="Check boolean EleanorVoidLove",color=orange];
		578 -> 584 [label=true,color=green];
		578 -> 585 [label=false,color=brown];
	579 [label="Одержимость?",shape=box,color=blue];
		579 -> 586;
	569 [label="Я знаю, я пропускаю всякие мелочи и сразу иду к сути, но, честно говоря, это твоя вина, что ты так меня интересуешь.",shape=box,color=blue];
		569 -> 570;
	580 [label="Я видела. И я не думаю, что существование, которое Орокин считали НАКАЗАНИЕМ, можно назвать стоящей загробной жизнью.",shape=box,color=blue];
		580 -> 581;
	581 [label="Фу. Я бы предпочла быть по-настоящему мёртвой.",shape=box,color=blue];
		581 -> 588;
	582 [label="Из всех отвратительных вещей, которые есть на этой планете, я думаю, что Орокин — худшее.",shape=box,color=blue];
		582 -> 583;
	583 [label="Интересно, не поздно ли остановить их существование вообще. Может, мне просто нужно найти правильную бабочку, чтобы раздавить.",shape=box,color=blue];
		583 -> 589;
	584 [label="Ещё больше магии Бездны. Чем больше я узнаю о Бездне, тем больше хочу туда. Возможно, это моё место. За краем карты. Здесь водятся драконы. У вас, Тэнно, Бездна в крови. Счастливчики.",shape=box,color=blue];
		584 -> 585;
	585 [label="Для вас всё замечательно, а что насчёт нас, простолюдинов? Мы не все можем быть Тэнно, не так ли?",shape=box,color=blue];
		585 -> 590;
	586 [label="Что, ты как бедное маленькое инопланетное существо, которое так далеко от дома, а я учёный, одержимый идеей препарировать тебя, чтобы понять, как ты устроена?",shape=box,color=blue];
		586 -> 587;
	570 [label="Полубог-путешественник во времени буквально вваливается в мою жизнь, уже и без того нелепую, и от меня ожидают, что я просто отойду в сторону из-за социальных приличий?",shape=box,color=blue];
		570 -> 571;
	588 [label="Не будь такой дурой, Элеонора. Цефалоны — тоже люди.",shape=box,color=red];
		588 -> 595;
	589 [label="Только представь. Целую когорту самодовольных ублюдков стёрли из существования. Единственный минус в том, что мы бы не услышали их крики.",shape=box,color=blue];
		589 -> 597;
	590 [label="Я просто говорю, что думаю, что выживание после смерти возможно.",shape=box,color=red];
		590 -> 599;
	587 [label="Извини. Я думала, мы друг друга находим довольно интересными. Я считала, что эти наши перепалки — это способ узнать друг друга.",shape=box,color=blue];
		587 -> 591;
	571 [label="Ты можешь дать мне перспективы, которых никто другой не может. Так что, пожалуйста. До того, как я начну царапать мебель. Поговори со мной.",shape=box,color=blue];
		571 -> 572;
		571 -> 573;
		571 -> 574;
		571 -> 575;
	595 [label="Останови меня, если я ошибаюсь, но... то, о чём ты говоришь, не звучит как настоящий человек. Это скорее компьютер, запрограммированный ДУМАТЬ, что он человек. Верно?",shape=box,color=blue];
		595 -> 596;
	597 [label="Хотя…",shape=box,color=blue];
		597 -> 598;
	599 [label="Да-да, я знаю, что ты имеешь в виду. Удовлетвори моё любопытство.",shape=box,color=blue];
		599 -> 600;
	591 [label="Но нет. Видимо, я ничем не лучше какой-то фанатки Зик, которая каждую минуту своей жизни тратит на мысли о своей «одержимости».",shape=box,color=blue];
		591 -> 592;
	596 [label="В некотором роде. Некралоид — это копия Лойда, который всё ещё жив. Но даже если Цефалон — не оригинал, они всё равно личности.",shape=box,color=red];
		596 -> 601;
	598 [label="Чёрт.",shape=box,color=blue];
		598 -> 602;
	600 [label="Бездна может быть местом, где существуют души. Это то, о чём мы говорим? Кто-то взломал духовный мир, и теперь вы используете его для питания половины своих устройств?",shape=box,color=blue];
		600 -> 605;
	592 [label="Ты больше не в Дувири, ваше Величество. Здесь никому нет до этого дела.",shape=box,color=blue];
		592 -> 593;
	601 [label="Мм. Извини, но это не одно и то же. Мы не говорим здесь о личности. Мы говорим о продолжительности.",shape=box,color=blue];
		601 -> 806;
	602 [label="Если бы я их уничтожила, то и тебя бы уничтожила, не так ли? Потому что твоё существование зависит от ИХ существования.",shape=box,color=blue];
		602 -> 603;
		602 -> 604;
	605 [label="Не просто кто-то. Энтрати. Он сделал первые шаги в Бездну.",shape=box,color=red];
		605 -> 606;
	593 [label="Справься с этим.",shape=box,color=blue];
		593 -> 594;
	806 [label="Я могла бы попросить Амира перепрограммировать куклу болтушка Шарлотта с набором фраз Элеоноры, чтобы он потом пугал Лэтти после моей смерти, но это ведь буду не Я.",shape=box,color=blue];
		806 -> 807;
	603 [label="О, только этого нам не хватало. Ещё больше людей, играющихся с временными линиями.",shape=box,color=red];
		603 -> 610;
	604 [label="Или ты просто создашь новую ветвь истории и отправишься по ней.",shape=box,color=red];
		604 -> 611;
	606 [label="Надо было догадаться, что этот двуличный ублюдок тоже приложил к этому руку.",shape=box,color=blue];
		606 -> 608;
	594 [label="Chat ends.",color=orange];
	807 [label="Разве что я как-то смогла бы её одержать. Дай мне это обдумать.",shape=box,color=blue];
		807 -> 622;
		807 -> 623;
	610 [label="Ух ты.",shape=box,color=blue];
		610 -> 612;
	611 [label="Даже не начинай. Если начнёшь, мы застрянем здесь на неделю.",shape=box,color=blue];
		611 -> 613;
	608 [label="Кто-нибудь когда-нибудь встречал мёртвого человека в Бездне? Или Бездна когда-либо принимала форму мёртвого человека? Прости за вопрос, но мне нужно знать.",shape=box,color=blue];
		608 -> 609;
	622 [label="Если это выглядит как пилопасть и орёт как пилопасть, значит, это пилопасть. Всё то же самое, верно?",shape=box,color=red];
		622 -> 624;
	623 [label="Всё это действительно имеет значение для тебя, да?",shape=box,color=red];
		623 -> 625;
	612 [label="Я думала, это просто забавный разговор.",shape=box,color=blue];
		612 -> 614;
	613 [label="Мы всё ещё обсуждаем вопрос «переживает ли душа смерть тела». Ещё рано переходить к «существует ли свободная воля».",shape=box,color=blue];
		613 -> 615;
	609 [label="Я знаю несколько таких мертвецов. Неукротимые.",shape=box,color=red];
		609 -> 617;
	624 [label="Хм. Нет. Не думаю, что так.",shape=box,color=blue];
		624 -> 640;
	625 [label="О, ты замечаешь?",shape=box,color=blue];
		625 -> 645;
	614 [label="Чтобы было ясно, у меня нет НИКАКИХ реальных планов возиться с будущим. Просто",shape=box,color=blue];
		614 -> 616;
	615 [label="(«Вот что ты получаешь, Элеонора, — сказала она себе. — Вот куда тебя приводит задавание Больших Важных Вопросов интересному человеку».)",shape=box,color=blue];
		615 -> 622;
		615 -> 623;
	617 [label="Update boolean EleanorHoldfasts1",color=orange];
		617 -> 626;
	640 [label="Если Бездна сделала бы копию меня, я бы потом не могла спать, размышляя, кто из нас настоящий.",shape=box,color=blue];
		640 -> 641;
	645 [label="Да. Это действительно важно для меня.",shape=box,color=blue];
		645 -> 646;
	616 [label="Знаешь что? Это не стоит того.",shape=box,color=blue];
		616 -> 618;
	626 [label="Прошу прощения?",shape=box,color=blue];
		626 -> 627;
	641 [label="Потому что если она может сделать это, когда ты мёртв, то, конечно, она может сделать это и пока ты жив.",shape=box,color=blue];
		641 -> 642;
	646 [label="Боюсь, больше, чем я позволяю себе это признать.",shape=box,color=blue];
		646 -> 647;
	618 [label="Я ПЫТАЛАСЬ сказать, как сильно не хочу тебя отпускать. Настолько, что я готова позволить людям в моём будущем продолжать страдать под гнётом кучи тиранов, лишь бы ничего не менять.",shape=box,color=blue];
		618 -> 619;
	627 [label="Ты знаешь мёртвых людей? В социальном плане?",shape=box,color=blue];
		627 -> 628;
	642 [label="... Мне некомфортно, куда это всё идёт. Извини. Поговорим позже. Может быть.",shape=box,color=blue];
		642 -> 643;
	647 [label="Скажем так, у меня есть основания надеяться, что что-то из нас переживет смерть тела. Я не единственная, кто так думает, Я знаю это.",shape=box,color=blue];
		647 -> 648;
	619 [label="Шутка дурного тона. Извини. Больше так не буду.",shape=box,color=blue];
		619 -> 620;
	628 [label="Они помнят, как умерли? Они осознают, что мертвы?",shape=box,color=blue];
		628 -> 629;
		628 -> 630;
	643 [label="+10 Chemistry",color=orange];
		643 -> 644;
	648 [label="Update boolean EleanorBereaved",color=orange];
		648 -> 649;
	620 [label="+5 Chemistry",color=orange];
		620 -> 621;
	629 [label="Да. Раньше они были офицерами на Заримане. Колониальном корабле, который затерялся в Бездне. Теперь, полагаю, они призраки.",shape=box,color=red];
		629 -> 631;
	630 [label="Это... сложно. Вещи могут попадать в Бездну, но они уже не совсем те же, когда выходят.",shape=box,color=red];
		630 -> 632;
	644 [label="Chat ends.",color=orange];
	649 [label="Ты спрашиваешь не того человека. Не уверена, что я могу умереть.",shape=box,color=red];
		649 -> 650;
	621 [label="Chat ends.",color=orange];
	631 [label="Чёрт возьми, это невероятно.",shape=box,color=blue];
		631 -> 633;
	632 [label="Ах. Тебе трудно найти нужные слова? Или ты не хочешь рассказывать всю историю? Я начинаю нервничать, когда люди что-то утаивают.",shape=box,color=blue];
		632 -> 634;
	650 [label="Check boolean EleanorDuviri",color=orange];
		650 -> 651 [label=true,color=green];
		650 -> 652 [label=false,color=brown];
	633 [label="Хотя…",shape=box,color=blue];
		633 -> 635;
	634 [label="Постой. Не отвечай. Что-то только что промелькнуло у меня в голове. Не знаю, была ли это твоя мимолётная мысль или нет, но, чёрт возьми, но Сол на Звёздном дереве, это нагоняет на меня ужас.",shape=box,color=blue];
		634 -> 636;
	651 [label="Верно. Они пытались, не так ли? Тракс превратил тебя в регулярное представление. Не знаю, как тебе удалось пройти через этот кошмар и сохранить рассудок.",shape=box,color=blue];
		651 -> 652;
	652 [label="Между нами говоря, я тоже не уверена, что могу умереть.",shape=box,color=blue];
		652 -> 653;
	635 [label="Как мы можем быть уверены, что там тот же человек? С тем же мировоззрением?",shape=box,color=blue];
		635 -> 637;
	636 [label="Ангелы.",shape=box,color=blue];
		636 -> 638;
	653 [label="Внутри меня сейчас живёт комитет крошечных Техноцитов, которые будут крайне раздражены, если их дом разрушат.",shape=box,color=blue];
		653 -> 654;
	637 [label="А что, если это просто... не знаю, Клон Бездны или что-то подобное? Может ли такое быть? Что Бездна берёт ИДЕЮ человека и придаёт ему форму. А эта форма потом ДУМАЕТ, что она тот же человек, который умер.",shape=box,color=blue];
		637 -> 622;
		637 -> 623;
	638 [label="Святая Луа, я их слышу. Это как... когда кондиционер так долго работает в комнате, что ты уже не замечаешь его шум, а потом вдруг осознаёшь его",shape=box,color=blue];
		638 -> 639;
	654 [label="Именно поэтому они так старались сделать меня большой и сильной.",shape=box,color=blue];
		654 -> 655;
	639 [label="Почему я начала спрашивать тебя об этом, ЧЁРТ ПОБЕРИ, СОЛ",shape=box,color=blue];
		639 -> 668;
	655 [label="Это заставляет меня задуматься, что случится, если меня убьют окончательно. Техрот может поддерживать труп в движении и использовать его. Я видела это. Как колония термитов, работающая слаженно, чтобы управлять роботом.",shape=box,color=blue];
		655 -> 656;
	668 [label="Ладно. Ладно. Хорошо. Я сейчас сосредоточусь. Пожалуйста, оставайся со мной. Я строю стену из своих мыслей. Она поднимается между мной и ангелами.",shape=box,color=blue];
		668 -> 669;
	656 [label="Итак... я стану чем-то вроде зомби Техрота? Если он вернёт меня, буду ли я всё ещё собой? Или я стану просто коллективным разумом Техрота с доступом к моим воспоминаниям, который ДУМАЕТ, что он — это я?",shape=box,color=blue];
		656 -> 657;
	669 [label="Стена, стена, стена, прекрасная-прекрасная стена",shape=box,color=blue];
		669 -> 670;
	657 [label="Не думаю, что тебе полезно зацикливаться на этом.",shape=box,color=red];
		657 -> 658;
	670 [label="Вот. Стена на месте. Всё тихо теперь. Мне, вероятно, стоит отпустить тебя, не так ли.",shape=box,color=blue];
		670 -> 671;
	658 [label="Не думаю, что я вообще здорова. Вот так.",shape=box,color=blue];
		658 -> 659;
	671 [label="+10 Chemistry",color=orange];
		671 -> 672;
	659 [label="Но…",shape=box,color=blue];
		659 -> 660;
	672 [label="Chat ends.",color=orange];
	660 [label="Я ценю, что тебе не всё равно, раз ты говоришь это.",shape=box,color=blue];
		660 -> 661;
	661 [label="Лэтти проверяет, что делает моё тело, потому что Артуру нужно, чтобы я была готова к действию. Я не злюсь на неё за это. Это её работа.",shape=box,color=blue];
		661 -> 662;
	662 [label="Но никто не проверяет МЕНЯ.",shape=box,color=blue];
		662 -> 663;
	663 [label="По крайней мере, до сих пор.",shape=box,color=blue];
		663 -> 664;
	664 [label="Боги, всё, что ты делаешь, это проявляешь доброту, а прошло так чертовски много времени с тех пор, как мы просто были добры друг к другу, что я устраиваю из этого целое шоу.",shape=box,color=blue];
		664 -> 666;
	666 [label="+20 Chemistry",color=orange];
		666 -> 665;
	665 [label="Кхм. Спасибо. Конец.",shape=box,color=blue];
		665 -> 667;
	667 [label="Chat ends.",color=orange];
}