digraph {
	"EleanorRank6Convo3 begins." [color=orange];
		"EleanorRank6Convo3 begins." -> j2684370652;
	j2684370652 [label="Не знаю, замечаешь ли ты, но случилось что-то чертовски фантастическое.",shape=box,color=blue];
		j2684370652 -> j3878036254;
	j3878036254 [label="Артур снова поёт. Слава богам.",shape=box,color=blue];
		j3878036254 -> j2873583710;
		j3878036254 -> j361873845;
		j3878036254 -> j1305921308;
	j2873583710 [label="Почему он остановился?",shape=box,color=red];
		j2873583710 -> j3967183778;
	j361873845 [label="Я не особо фанатею по этому поводу, но если это делает его счастливым...",shape=box,color=red];
		j361873845 -> j676836441;
	j1305921308 [label="Приятно это слышать. Он в этом хорош.",shape=box,color=red];
		j1305921308 -> j2795757613;
	j3967183778 [label="Тревога по поводу эффективности. Всё просто.",shape=box,color=blue];
		j3967183778 -> j478252430;
	j676836441 [label="Спасибо, что так деликатно это излагаешь.",shape=box,color=blue];
		j676836441 -> j1429968863;
	j2795757613 [label="Не так ли?",shape=box,color=blue];
		j2795757613 -> j280634026;
	j478252430 [label="Трудно поверить, что кто-то такой смелый, как Артур, мог так испугаться.",shape=box,color=red];
		j478252430 -> j2892697909;
	j1429968863 [label="Для меня важно, что тебе не всё равно.",shape=box,color=blue];
		j1429968863 -> j2075361856;
	j280634026 [label="Когда я думаю о том, сколько усилий потребовалось, чтобы заставить его встать перед толпой и спеть...",shape=box,color=blue];
		j280634026 -> j172735329;
	j2892697909 [label="Что за трещина в его броне?",shape=box,color=red];
		j2892697909 -> j2609196665;
	j2075361856 [label="Тем более что есть причины, по которым он бросил петь, о которых тебе могло быть не известно.",shape=box,color=blue];
		j2075361856 -> j1645197787;
		j2075361856 -> j1854024354;
	j172735329 [label="... я имею в виду, когда у него впервые сдали нервы.",shape=box,color=blue];
		j172735329 -> j111770449;
	j2609196665 [label="Это имя. В этом вся проблема.",shape=box,color=blue];
		j2609196665 -> j50466238;
	j1645197787 [label="Недостаточно моральной поддержки?",shape=box,color=red];
		j1645197787 -> j2418472139;
	j1854024354 [label="Слишком много толпы?",shape=box,color=red];
		j1854024354 -> j2418472139;
	j111770449 [label="Концерт Solstice Carol в восьмидесятых. Представьте нашего маленького человека в коротких штанах, исполняющего соло песню «How Bright The Dew Upon That Morn».",shape=box,color=blue];
		j111770449 -> j172126600;
		j111770449 -> j3695374667;
	j50466238 [label="О, тебя зовут найтингейл, ха-ха, соловей, спой нам тогда песенку",shape=box,color=blue];
		j50466238 -> j490908509;
	j2418472139 [label="Скорее, надоело слишком часто слышать одну и ту же шутку.",shape=box,color=blue];
		j2418472139 -> j2609196665;
	j172126600 [label="Могу себе представить.",shape=box,color=red];
		j172126600 -> j128343644;
	j3695374667 [label="Мне это не знакомо.",shape=box,color=red];
		j3695374667 -> j601871557;
	j490908509 [label="Разные придурки повторяли одну и ту же фразу всю нашу жизнь. Теперь это делает Виктор.",shape=box,color=blue];
		j490908509 -> j2724974076;
	j128343644 [label="Он воспринимал это так серьёзно. Неделя за неделей практики, а затем, ночью, он запивал это. Он прятался в крыльях и отказывался выходить наружу.",shape=box,color=blue];
		j128343644 -> j2694169651;
		j128343644 -> j478252430;
	j601871557 [label="Ну, я бы спела её для тебя, но не уверена, какой звук получился бы, если бы я попробовала.",shape=box,color=blue];
		j601871557 -> j683414254;
	j2724974076 [label="+5 Chemistry",color=orange];
		j2724974076 -> j200576337;
	j2694169651 [label="Как тебе удалось его убедить?",shape=box,color=red];
		j2694169651 -> j719330279;
	j683414254 [label="Чёртов Техрот. Я пыталась спеть «С Днём Рождения» для Аои, и это звучало как лягушка, попавшая в шредер.",shape=box,color=blue];
		j683414254 -> j1022324358;
	j200576337 [label="Честно говоря, я горжусь Артуром за то, что у него хватило смелости вообще петь.",shape=box,color=blue];
		j200576337 -> "Chat ends.";
	j719330279 [label="Я буквально надрала ему зад. Не горжусь этим. Но это нужно было сделать.",shape=box,color=blue];
		j719330279 -> j920841359;
	j1022324358 [label="Прости. Должно быть, тебе тяжело, что ты больше не можешь петь.",shape=box,color=red];
		j1022324358 -> j4125749218;
	"Chat ends." [color=orange];
	j920841359 [label="Дело в том, что он всё это делал не ради наших родителей или чтобы сделать миссис Хеншо счастливой.",shape=box,color=blue];
		j920841359 -> j2005801251;
	j4125749218 [label="О, это не такая уж большая потеря. Я бы всё равно не смогла петь.",shape=box,color=blue];
		j4125749218 -> j1008630633;
	j2005801251 [label="Он пел, потому что любил это делать. Но когда внимание сосредоточилось на нём, он стал замкнутым.",shape=box,color=blue];
		j2005801251 -> j2695932201;
		j2005801251 -> j2892697909;
	j1008630633 [label="Ближе всего мне удалось подойти, когда я кричала тексты из Shag Cannons в своей спальне, потому что хотела быть в группе Мэнди Джеллико, потому что она мне нравилась.",shape=box,color=blue];
		j1008630633 -> j2089119618;
	j2695932201 [label="Возможно, ему просто нужно было вспомнить, как сильно он любил это делать.",shape=box,color=red];
		j2695932201 -> j2530604133;
	j2089119618 [label="Слышь, как отец стучится в дверь и угрожает вымыть мне рот стиральным порошком, если услышит ещё что-нибудь из этой грязи.",shape=box,color=blue];
		j2089119618 -> j1830873912;
	j2530604133 [label="Артур самый счастливый, когда может забыть об Артуре. Когда он может отправить призрак самого себя на покой и просто БЫТЬ.",shape=box,color=blue];
		j2530604133 -> j3124725754;
	j1830873912 [label="(Я не знаю, есть ли у вас там «панк», откуда ты, но не иметь голоса — это скорее требование, чем препятствие.)",shape=box,color=blue];
		j1830873912 -> j4158401772;
		j1830873912 -> j3667509732;
	j3124725754 [label="Пиво помогает.",shape=box,color=blue];
		j3124725754 -> j1499117397;
	j4158401772 [label="У нас нет панка, но есть скег.",shape=box,color=red];
		j4158401772 -> j1336775653;
	j3667509732 [label="Что случилось с группой?",shape=box,color=red];
		j3667509732 -> j4286523521;
	j1499117397 [label="И, конечно же, не помешал бы тот факт, что Велимир ведёт себя как отец, которого выбрал бы Артур, если бы мог выбрать кого-то из каталога отцов.",shape=box,color=blue];
		j1499117397 -> j3938492989;
		j1499117397 -> j1957192109;
	j1336775653 [label="Не смей писать что-то подобное в чате без объяснений.",shape=box,color=blue];
		j1336775653 -> j2840704174;
	j4286523521 [label="Они даже не дошли до стадии «благотворителього концерта в местном пабе».",shape=box,color=blue];
		j4286523521 -> j1364200852;
	j3938492989 [label="Я его не виню.",shape=box,color=red];
		j3938492989 -> j2182381695;
	j1957192109 [label="Мне казалось, что Велимир и Минерва слишком похожи на твоих настоящих родителей.",shape=box,color=red];
		j1957192109 -> j3604740185;
	j2840704174 [label="Я требую объяснить мне, что такое Скег.",shape=box,color=blue];
		j2840704174 -> j2456719267;
	j1364200852 [label="Ходили слухи, что Мэнди планирует плюнуть на публику, и на этом всё. Позор.",shape=box,color=blue];
		j1364200852 -> j3003806973;
		j1364200852 -> j1604395114;
	j2182381695 [label="Артур месяцами таскал с собой этого медвежонка. А теперь появляется Велимир. Как будто судьба почувствовала дыру в жизни Артура в форме медвежонка...",shape=box,color=blue];
		j2182381695 -> j3533468197;
	j3604740185 [label="да, ну. Может быть, ссоры заставляют его чувствовать себя как дома.",shape=box,color=blue];
		j3604740185 -> j1323720273;
	j2456719267 [label="Потому что это звучит как что-то, что продают в мешках в поместье Ладстона.",shape=box,color=blue];
		j2456719267 -> j3594879155;
		j2456719267 -> j2537787072;
	j3003806973 [label="Кто боится небольшого плевка?",shape=box,color=red];
		j3003806973 -> j3938405805;
	j1604395114 [label="Плевок? Звучит как идея Техноцита Кода для хорошей ночи.",shape=box,color=red];
		j1604395114 -> j770299672;
	j3533468197 [label="+5 Chemistry",color=orange];
		j3533468197 -> j2087113172;
	j1323720273 [label="+5 Chemistry",color=orange];
		j1323720273 -> j1896664762;
	j3594879155 [label="Это как музыка, только её надо создавать, нанося удары по трубам. И вентиляциям. И шлемам Корпуса. И по всему остальному, что можно найти для удара, если серьёзно.",shape=box,color=red];
		j3594879155 -> j3185243743;
	j2537787072 [label="Это просто бессмысленный шум. Только Детям Труб это нравится.",shape=box,color=red];
		j2537787072 -> j149440495;
	j3938405805 [label="+5 Chemistry",color=orange];
		j3938405805 -> j3163603250;
	j770299672 [label="Это было другое время. В то время панк был настоящим панком.",shape=box,color=blue];
		j770299672 -> j2556668547;
	j2087113172 [label="... извини. Не моё дело размышлять. Я просто рада, что он счастлив.",shape=box,color=blue];
		j2087113172 -> "Chat ends.";
	j1896664762 [label="Странно, что такое может вызвать тоску по дому, не так ли?",shape=box,color=blue];
		j1896664762 -> "Chat ends.";
	j3185243743 [label="Это фишка Детей Труб.",shape=box,color=red];
		j3185243743 -> j1658621624;
	j149440495 [label="Хм. Бессмысленный шум. Я уже слышала это раньше.",shape=box,color=blue];
		j149440495 -> j811720101;
	j3163603250 [label="Только не я, чёрт возьми, это можно сказать наверняка.",shape=box,color=blue];
		j3163603250 -> j2556668547;
	j2556668547 [label="... Я просто подумала: Хотела бы я, чтобы она меня сейчас видела. Думаю, ей бы понравилась эта версия меня.",shape=box,color=blue];
		j2556668547 -> j2702574558;
	j1658621624 [label="+5 Chemistry",color=orange];
		j1658621624 -> j3764116469;
	j811720101 [label="Я не думаю, что есть что-то настолько бессмысленное, что оно не может стать саундтреком к чьей-то молодости.",shape=box,color=blue];
		j811720101 -> j1103700222;
	j2702574558 [label="Боги, посмотрите на меня, я сошла с ума и погрузилась в ностальгию.",shape=box,color=blue];
		j2702574558 -> j3957594483;
	j3764116469 [label="Хм. Звучит как музыка выживших. Не против послушать, если у тебя будет шанс записать её для меня.",shape=box,color=blue];
		j3764116469 -> j4077916672;
	j1103700222 [label="Мне лучше остановиться. Я начинаю быть сентиментальной.",shape=box,color=blue];
		j1103700222 -> "Chat ends.";
	j3957594483 [label="+5 Chemistry",color=orange];
		j3957594483 -> j3346698501;
	j4077916672 [label="Но лучше держать это подальше от динамиков торгового центра.",shape=box,color=blue];
		j4077916672 -> "Chat ends.";
	j3346698501 [label="Пора возвращаться к работе. Спасибо за внимание.",shape=box,color=blue];
		j3346698501 -> "Chat ends.";
}