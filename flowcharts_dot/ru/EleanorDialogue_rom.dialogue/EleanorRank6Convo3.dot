digraph {
	2888 [label="EleanorRank6Convo3 begins.",color=orange];
		2888 -> 2889;
	2889 [label="Не знаю, замечаешь ли ты, но случилось что-то чертовски фантастическое.",shape=box,color=blue];
		2889 -> 2890;
	2890 [label="Артур снова поёт. Слава богам.",shape=box,color=blue];
		2890 -> 2891;
		2890 -> 2892;
		2890 -> 2893;
	2891 [label="Почему он остановился?",shape=box,color=red];
		2891 -> 2894;
	2892 [label="Я не особо фанатею по этому поводу, но если это делает его счастливым...",shape=box,color=red];
		2892 -> 2895;
	2893 [label="Приятно это слышать. Он в этом хорош.",shape=box,color=red];
		2893 -> 2896;
	2894 [label="Тревога по поводу эффективности. Всё просто.",shape=box,color=blue];
		2894 -> 2897;
	2895 [label="Спасибо, что так деликатно это излагаешь.",shape=box,color=blue];
		2895 -> 2898;
	2896 [label="Не так ли?",shape=box,color=blue];
		2896 -> 2899;
	2897 [label="Трудно поверить, что кто-то такой смелый, как Артур, мог так испугаться.",shape=box,color=red];
		2897 -> 2900;
	2898 [label="Для меня важно, что тебе не всё равно.",shape=box,color=blue];
		2898 -> 2901;
	2899 [label="Когда я думаю о том, сколько усилий потребовалось, чтобы заставить его встать перед толпой и спеть...",shape=box,color=blue];
		2899 -> 2902;
	2900 [label="Что за трещина в его броне?",shape=box,color=red];
		2900 -> 2903;
	2901 [label="Тем более что есть причины, по которым он бросил петь, о которых тебе могло быть не известно.",shape=box,color=blue];
		2901 -> 2904;
		2901 -> 2905;
	2902 [label="... я имею в виду, когда у него впервые сдали нервы.",shape=box,color=blue];
		2902 -> 2906;
	2903 [label="Это имя. В этом вся проблема.",shape=box,color=blue];
		2903 -> 2907;
	2904 [label="Недостаточно моральной поддержки?",shape=box,color=red];
		2904 -> 2908;
	2905 [label="Слишком много толпы?",shape=box,color=red];
		2905 -> 2908;
	2906 [label="Концерт Solstice Carol в восьмидесятых. Представьте нашего маленького человека в коротких штанах, исполняющего соло песню «How Bright The Dew Upon That Morn».",shape=box,color=blue];
		2906 -> 2909;
		2906 -> 2910;
	2907 [label="О, тебя зовут найтингейл, ха-ха, соловей, спой нам тогда песенку",shape=box,color=blue];
		2907 -> 2911;
	2908 [label="Скорее, надоело слишком часто слышать одну и ту же шутку.",shape=box,color=blue];
		2908 -> 2903;
	2909 [label="Могу себе представить.",shape=box,color=red];
		2909 -> 2912;
	2910 [label="Мне это не знакомо.",shape=box,color=red];
		2910 -> 2913;
	2911 [label="Разные придурки повторяли одну и ту же фразу всю нашу жизнь. Теперь это делает Виктор.",shape=box,color=blue];
		2911 -> 2914;
	2912 [label="Он воспринимал это так серьёзно. Неделя за неделей практики, а затем, ночью, он запивал это. Он прятался в крыльях и отказывался выходить наружу.",shape=box,color=blue];
		2912 -> 2915;
		2912 -> 2897;
	2913 [label="Ну, я бы спела её для тебя, но не уверена, какой звук получился бы, если бы я попробовала.",shape=box,color=blue];
		2913 -> 2916;
	2914 [label="+5 Chemistry",color=orange];
		2914 -> 2917;
	2915 [label="Как тебе удалось его убедить?",shape=box,color=red];
		2915 -> 2918;
	2916 [label="Чёртов Техрот. Я пыталась спеть «С Днём Рождения» для Аои, и это звучало как лягушка, попавшая в шредер.",shape=box,color=blue];
		2916 -> 2919;
	2917 [label="Честно говоря, я горжусь Артуром за то, что у него хватило смелости вообще петь.",shape=box,color=blue];
		2917 -> 2920;
	2918 [label="Я буквально надрала ему зад. Не горжусь этим. Но это нужно было сделать.",shape=box,color=blue];
		2918 -> 2921;
	2919 [label="Прости. Должно быть, тебе тяжело, что ты больше не можешь петь.",shape=box,color=red];
		2919 -> 2922;
	2920 [label="Chat ends.",color=orange];
	2921 [label="Дело в том, что он всё это делал не ради наших родителей или чтобы сделать миссис Хеншо счастливой.",shape=box,color=blue];
		2921 -> 2923;
	2922 [label="О, это не такая уж большая потеря. Я бы всё равно не смогла петь.",shape=box,color=blue];
		2922 -> 2924;
	2923 [label="Он пел, потому что любил это делать. Но когда внимание сосредоточилось на нём, он стал замкнутым.",shape=box,color=blue];
		2923 -> 2925;
		2923 -> 2900;
	2924 [label="Ближе всего мне удалось подойти, когда я кричала тексты из Shag Cannons в своей спальне, потому что хотела быть в группе Мэнди Джеллико, потому что она мне нравилась.",shape=box,color=blue];
		2924 -> 2926;
	2925 [label="Возможно, ему просто нужно было вспомнить, как сильно он любил это делать.",shape=box,color=red];
		2925 -> 2927;
	2926 [label="Слышь, как отец стучится в дверь и угрожает вымыть мне рот стиральным порошком, если услышит ещё что-нибудь из этой грязи.",shape=box,color=blue];
		2926 -> 2928;
	2927 [label="Артур самый счастливый, когда может забыть об Артуре. Когда он может отправить призрак самого себя на покой и просто БЫТЬ.",shape=box,color=blue];
		2927 -> 2929;
	2928 [label="(Я не знаю, есть ли у вас там «панк», откуда ты, но не иметь голоса — это скорее требование, чем препятствие.)",shape=box,color=blue];
		2928 -> 2930;
		2928 -> 2931;
	2929 [label="Пиво помогает.",shape=box,color=blue];
		2929 -> 2932;
	2930 [label="У нас нет панка, но есть скег.",shape=box,color=red];
		2930 -> 2933;
	2931 [label="Что случилось с группой?",shape=box,color=red];
		2931 -> 2934;
	2932 [label="И, конечно же, не помешал бы тот факт, что Велимир ведёт себя как отец, которого выбрал бы Артур, если бы мог выбрать кого-то из каталога отцов.",shape=box,color=blue];
		2932 -> 2935;
		2932 -> 2936;
	2933 [label="Не смей писать что-то подобное в чате без объяснений.",shape=box,color=blue];
		2933 -> 2937;
	2934 [label="Они даже не дошли до стадии «благотворителього концерта в местном пабе».",shape=box,color=blue];
		2934 -> 2938;
	2935 [label="Я его не виню.",shape=box,color=red];
		2935 -> 2939;
	2936 [label="Мне казалось, что Велимир и Минерва слишком похожи на твоих настоящих родителей.",shape=box,color=red];
		2936 -> 2940;
	2937 [label="Я требую объяснить мне, что такое Скег.",shape=box,color=blue];
		2937 -> 2941;
	2938 [label="Ходили слухи, что Мэнди планирует плюнуть на публику, и на этом всё. Позор.",shape=box,color=blue];
		2938 -> 2942;
		2938 -> 2943;
	2939 [label="Артур месяцами таскал с собой этого медвежонка. А теперь появляется Велимир. Как будто судьба почувствовала дыру в жизни Артура в форме медвежонка...",shape=box,color=blue];
		2939 -> 2944;
	2940 [label="да, ну. Может быть, ссоры заставляют его чувствовать себя как дома.",shape=box,color=blue];
		2940 -> 2945;
	2941 [label="Потому что это звучит как что-то, что продают в мешках в поместье Ладстона.",shape=box,color=blue];
		2941 -> 2946;
		2941 -> 2947;
	2942 [label="Кто боится небольшого плевка?",shape=box,color=red];
		2942 -> 2948;
	2943 [label="Плевок? Звучит как идея Техноцита Кода для хорошей ночи.",shape=box,color=red];
		2943 -> 2949;
	2944 [label="+5 Chemistry",color=orange];
		2944 -> 2950;
	2945 [label="+5 Chemistry",color=orange];
		2945 -> 2951;
	2946 [label="Это как музыка, только её надо создавать, нанося удары по трубам. И вентиляциям. И шлемам Корпуса. И по всему остальному, что можно найти для удара, если серьёзно.",shape=box,color=red];
		2946 -> 2952;
	2947 [label="Это просто бессмысленный шум. Только Детям Труб это нравится.",shape=box,color=red];
		2947 -> 2953;
	2948 [label="+5 Chemistry",color=orange];
		2948 -> 2954;
	2949 [label="Это было другое время. В то время панк был настоящим панком.",shape=box,color=blue];
		2949 -> 2955;
	2950 [label="... извини. Не моё дело размышлять. Я просто рада, что он счастлив.",shape=box,color=blue];
		2950 -> 3311;
	2951 [label="Странно, что такое может вызвать тоску по дому, не так ли?",shape=box,color=blue];
		2951 -> 2956;
	2952 [label="Это фишка Детей Труб.",shape=box,color=red];
		2952 -> 2957;
	2953 [label="Хм. Бессмысленный шум. Я уже слышала это раньше.",shape=box,color=blue];
		2953 -> 2958;
	2954 [label="Только не я, чёрт возьми, это можно сказать наверняка.",shape=box,color=blue];
		2954 -> 2955;
	2955 [label="... Я просто подумала: Хотела бы я, чтобы она меня сейчас видела. Думаю, ей бы понравилась эта версия меня.",shape=box,color=blue];
		2955 -> 2959;
	3311 [label="Chat ends.",color=orange];
	2956 [label="Chat ends.",color=orange];
	2957 [label="+5 Chemistry",color=orange];
		2957 -> 2960;
	2958 [label="Я не думаю, что есть что-то настолько бессмысленное, что оно не может стать саундтреком к чьей-то молодости.",shape=box,color=blue];
		2958 -> 2961;
	2959 [label="Боги, посмотрите на меня, я сошла с ума и погрузилась в ностальгию.",shape=box,color=blue];
		2959 -> 2962;
	2960 [label="Хм. Звучит как музыка выживших. Не против послушать, если у тебя будет шанс записать её для меня.",shape=box,color=blue];
		2960 -> 2963;
	2961 [label="Мне лучше остановиться. Я начинаю быть сентиментальной.",shape=box,color=blue];
		2961 -> 2964;
	2962 [label="+5 Chemistry",color=orange];
		2962 -> 2965;
	2963 [label="Но лучше держать это подальше от динамиков торгового центра.",shape=box,color=blue];
		2963 -> 2966;
	2964 [label="Chat ends.",color=orange];
	2965 [label="Пора возвращаться к работе. Спасибо за внимание.",shape=box,color=blue];
