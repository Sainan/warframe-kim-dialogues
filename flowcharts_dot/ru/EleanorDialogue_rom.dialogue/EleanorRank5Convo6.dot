digraph {
	2541 [label="EleanorRank5Convo6 begins.",color=orange];
		2541 -> 2542;
	2542 [label="Возможно, ты замечаешь, что сегодня утром торговый центр выглядит несколько иначе.",shape=box,color=blue];
		2542 -> 2543;
	2543 [label="Ничего большого и очевидного. Просто немного больше улыбок на лицах. Пара смешков тут и там. Щепотка счастья в воздухе.",shape=box,color=blue];
		2543 -> 2544;
		2543 -> 2545;
	2544 [label="Это твоих рук дело, верно?",shape=box,color=red];
		2544 -> 2547;
	2545 [label="Сейчас вернусь [Завершить]",shape=box,color=red];
		2545 -> 2546;
	2547 [label="Это мой способ отдать что-то взамен. Как ты знаешь, телепат может не только принимать, но и отправлять. И необязательно бить струёй в одного человека — можно распылять лёгкий туман на целую область.",shape=box,color=blue];
		2547 -> 2548;
	2546 [label="Chat ends.",color=orange];
	2548 [label="У вас там, откуда ты, есть эти газонные разбрызгиватели?",shape=box,color=blue];
		2548 -> 2549;
		2548 -> 2550;
	2549 [label="У нас были ДРРО-НЭ и подобные дроны. Они ухаживали за растениями на Заримане. Ты об этом?",shape=box,color=red];
		2549 -> 2551;
	2550 [label="Разбрызгиватели?",shape=box,color=red];
		2550 -> 2552;
	2551 [label="Вот именно.",shape=box,color=blue];
		2551 -> 2553;
	2552 [label="Да, дорогуша, разбрызгиватели. Распылители воды для поддержания чистоты и влажности вашего газона.",shape=box,color=blue];
		2552 -> 2554;
	2553 [label="Я обожала газонные разбрызгиватели, когда была маленькой. Это было как волшебство. На самом ярком солнце в них можно было поймать радугу. Ты бегаешь сквозь них — и по всему телу пробегает такой приятный холодок.",shape=box,color=blue];
		2553 -> 2555;
	2554 [label="Также идеально подходит для того, чтобы брызгать в лицо брата до тех пор, пока он не закричит.",shape=box,color=blue];
		2554 -> 2555;
	2555 [label="«Счастье — это разбрызгиватель для газонов». Напиши это на поздравительной открытке.",shape=box,color=blue];
		2555 -> 2556;
	2556 [label="У тебя сегодня хорошее настроение. Радостно это видеть.",shape=box,color=red];
		2556 -> 2557;
	2557 [label="Да. И я не вижу, почему я должна держать это в себе. Поэтому я заливаю этим весь торговый центр.",shape=box,color=blue];
		2557 -> 2558;
		2557 -> 2559;
		2557 -> 2560;
	2558 [label="Разве это не похоже на подмешивание наркотиков людям?",shape=box,color=red];
		2558 -> 2561;
	2559 [label="Распространять позитивное настроение? А почему бы и нет. По мне, это не сильно отличается от того, чтобы включить музыку.",shape=box,color=red];
		2559 -> 2562;
	2560 [label="Значит, сегодня тот самый день, когда я, возможно, увижу улыбку Артура?",shape=box,color=red];
		2560 -> 2563;
	2561 [label="... Отлично. Тут я, значит, пытаюсь быть тайной феей счастья, разбрасывающей радость, а в итоге превращаюсь в какого-то злого гоблина-наркодилера. Настроение улетело в пике.",shape=box,color=blue];
		2561 -> 2564;
	2562 [label="О! Хорошая аналогия!",shape=box,color=blue];
		2562 -> 2566;
	2563 [label="Может быть. Надеюсь. Ему пришлось столько всего вытерпеть.",shape=box,color=blue];
		2563 -> 2567;
	2564 [label="Ладно, я остановлюсь.",shape=box,color=blue];
		2564 -> 2565;
	2566 [label="Если Аои может влиять на настроение через музыку, то и я могу делать это через вибрации, верно?",shape=box,color=blue];
		2566 -> 2568;
	2567 [label="С момента твоего появления, так много всего изменилось. Я имею в виду не только тебя и меня. Я имею в виду всё. Даже торговый центр.",shape=box,color=blue];
		2567 -> 2568;
	2565 [label="Chat ends.",color=orange];
	2568 [label="Я рада, что Аои убедила меня остаться. Благослови её Бог.",shape=box,color=blue];
		2568 -> 2569;
		2568 -> 2570;
	2569 [label="Подожди. Что она сделала?",shape=box,color=red];
		2569 -> 2571;
	2570 [label="Отмотай назад. Кажется эта часть прошла мимо меня.",shape=box,color=red];
		2570 -> 2571;
	2571 [label="Я тебе не говорила?",shape=box,color=blue];
		2571 -> 2572;
	2572 [label="А, это было незадолго до твоего появления. Мы весь день возились с уничтожением улья Техрота. В воздухе прямо витало убийственное напряжение. Обычно сражения выжигают из нас злость, оставляя только усталость, чтобы сцепляться друг с другом уже не было сил. Но этот день оказался другим.",shape=box,color=blue];
		2572 -> 2573;
	2573 [label="Я помню, как Артур сказал что-то вроде «завтра мы сделаем это снова», и это ударило нас всех, как кувалдой. Никто не произнёс ни слова по дороге обратно в торговый центр.",shape=box,color=blue];
		2573 -> 2574;
		2573 -> 2575;
		2573 -> 2576;
	2574 [label="Ого. Отличный способ поднять боевой дух команды, Артур.",shape=box,color=red];
		2574 -> 2579;
	2575 [label="Он может быть таким обаятельным...",shape=box,color=red];
		2575 -> 2579;
	2576 [label="На его плечах лежит большая ответственность. Это сказывается.",shape=box,color=red];
		2576 -> 2577;
	2579 [label="Думаю, он просто хотел, чтобы мы сосредоточились на задаче. Но я чувствовала себя сломанной. Артур и Аои не разговаривали, Амир так доставал Куинси, что я начала бояться за его жизнь, а Лэтти косилась на меня при каждом удобном случае.",shape=box,color=blue];
		2579 -> 2580;
	2577 [label="Да. Обычно ему удаётся это скрыть, даже когда он на пределе. Но, думаю, у него просто ничего не осталось.",shape=box,color=blue];
		2577 -> 2578;
	2580 [label="В тот день я много времени провела, глядя в зеркало. Всё представляла, как моё отражение хватает меня за горло и шипит: «Ты — проблема. Если бы не ты, ничего этого бы не случилось».",shape=box,color=blue];
		2580 -> 2581;
		2580 -> 2582;
	2578 [label="Он выгорел, пытаясь сохранить команду.",shape=box,color=blue];
		2578 -> 2579;
	2581 [label="Похоже, все остальные для разнообразия залезли в ТВОЮ голову.",shape=box,color=red];
		2581 -> 2583;
	2582 [label="Звучит как та фигня, что Лэтти обычно выдаёт.",shape=box,color=red];
		2582 -> 2584;
	2583 [label="О, это была не она. Это я. Вся накопившаяся неуверенность и самоненависть, которую я так долго загоняла внутрь, вырвалась наружу в тот день.",shape=box,color=blue];
		2583 -> 2585;
	2584 [label="Спасибо. Я знаю, что ты на моей стороне, и для меня это очень важно.",shape=box,color=blue];
		2584 -> 2586;
	2585 [label="Я подумала: этой группе нужен козёл отпущения.",shape=box,color=blue];
		2585 -> 2587;
	2586 [label="Я столько раз слышала эту фразу от Лэтти, что в итоге подумала: может, она права. Я подвергаю всех опасности, оставаясь здесь.",shape=box,color=blue];
		2586 -> 2588;
	2587 [label="Я монстр. Кто-то виноват во всём.",shape=box,color=blue];
		2587 -> 2588;
	2588 [label="Я придумала целый план. Ускользнуть ночью, спрятаться где-нибудь в городе, где Артур никогда меня не найдёт, и — вот этим я особенно гордилась — продолжать помогать издалека.",shape=box,color=blue];
		2588 -> 2589;
		2588 -> 2590;
	2589 [label="Я думаю, он бы тебя нашёл. Он настроен решительно.",shape=box,color=red];
		2589 -> 2591;
	2590 [label="Более вероятным сценарием является то, что он бы погиб, пытаясь найти тебя.",shape=box,color=red];
		2590 -> 2592;
	2591 [label="Как? Амир не может отслеживать телепатию.",shape=box,color=blue];
		2591 -> 2593;
	2592 [label="Пытаешься вызвать у меня чувство вины?",shape=box,color=blue];
		2592 -> 2594;
	2593 [label="Я собиралась стать благородной изгнанницей. Залезать на крыши, выглядеть такой вся из себя суровой и решительной. Могла бы докладывать о скоплениях Техрота, предупреждать Гекс, где Скальдра устраивают блокпосты, даже быть экстренным реле для связи. И каждый раз, спасая Лэтти её задницу, заставляла бы её это прочувствовать. Мелочно? Ещё как.",shape=box,color=blue];
		2593 -> 2595;
	2594 [label="Не старайся. Я и так чувствую себя ужасно.",shape=box,color=blue];
		2594 -> 2598;
	2595 [label="Я выбрала момент. Дождалась, пока Амир заснёт. Затем накинула длинное пальто и как можно тише направилась в гараж.",shape=box,color=blue];
		2595 -> 2596;
	2598 [label="Chat ends.",color=orange];
	2596 [label="Решётка безопасности опустилась сама собой. Я обернулся и увидел Аои.",shape=box,color=blue];
		2596 -> 2597;
	2597 [label="Мы проговорили всю ночь и рыдали, обнявшись. Она тоже страдала. Глубоко. К тому моменту, как взошло солнце, я решила остаться.",shape=box,color=blue];
		2597 -> 2599;
		2597 -> 2600;
		2597 -> 2601;
	2599 [label="Ещё есть время изменить своё мнение.",shape=box,color=red];
		2599 -> 2602;
	2600 [label="Аои замечательная. Я рада, что она была рядом с тобой.",shape=box,color=red];
		2600 -> 2604;
	2601 [label="Это была удача.",shape=box,color=red];
		2601 -> 2604;
	2602 [label="Какой бы мерзкий импульс ни заставил тебя это сказать, надеюсь, он станет тебе поперёк горла.",shape=box,color=blue];
		2602 -> 2603;
	2604 [label="+20 Chemistry",color=orange];
		2604 -> 2605;
	2603 [label="Chat ends.",color=orange];
	2605 [label="Да. Все шестеро должны были быть здесь в канун Нового года, как мне кажется. И ты, конечно. Незнакомка на пороге, приносящая удачу.",shape=box,color=blue];
		2605 -> 2606;
	2606 [label="Chat ends.",color=orange];
}