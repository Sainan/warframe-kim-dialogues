digraph {
	2607 [label="EleanorRank5Convo7 begins.",color=orange];
		2607 -> 2608;
	2608 [label="«Безразличие» — это то, ЧТО оно есть, или то, ЧЕГО оно хочет?",shape=box,color=blue];
		2608 -> 2609;
		2608 -> 2610;
		2608 -> 2611;
	2609 [label="Знаешь, ты и Лэтти обе так делаете. Забываете сказать «Привет».",shape=box,color=red];
		2609 -> 2613;
	2610 [label="Большинство людей начали бы со слова «привет».",shape=box,color=red];
		2610 -> 2614;
	2611 [label="[Игнорировать]",shape=box,color=red];
		2611 -> 2612;
	2613 [label="Поздравляю, ты нашла то единственное, что нас объединяет. И прости. Это важнее.",shape=box,color=blue];
		2613 -> 2615;
	2614 [label="Извини. Это важнее.",shape=box,color=blue];
		2614 -> 2615;
	2612 [label="Chat ends.",color=orange];
	2615 [label="Я думаю, что «Великое Безразличие» попытается каким-то образом встать между нами.",shape=box,color=blue];
		2615 -> 2616;
	2616 [label="Не смейся. Я чувствую это, прямо до глубины костного мозга. Та штука, что была в Русалке, просто обожает смотреть, как мы рвём друг друга на куски.",shape=box,color=blue];
		2616 -> 2617;
	2617 [label="Я не знаю почему. Я просто знаю.",shape=box,color=blue];
		2617 -> 2618;
		2617 -> 2619;
	2618 [label="Да, я думаю, ты права.",shape=box,color=red];
		2618 -> 2620;
	2619 [label="Может, это и случилось с семьёй Энтрати. Они годами жили прямо над его лабораторией, даже не зная об этом. А когда ребёнок нашёл их, они уже были чужими друг другу, утопая в злости и обидах.",shape=box,color=red];
		2619 -> 2620;
	2620 [label="Я видела это у тебя в голове. Альбрехт и Лойд. Мать и Отец. Ты и твои родители. Русалка и Виктор, насколько мы знаем. И, конечно, мы шестеро.",shape=box,color=blue];
		2620 -> 2621;
	2621 [label="То, что делает эта штука, — это холодно. Извращённо. Но где-то за этим кроется мотив.",shape=box,color=blue];
		2621 -> 2622;
		2621 -> 2623;
	2622 [label="Думаю, ты права. На Заримане первыми сходили с ума родители. Может, Неукротимые держались так долго, потому что у них не было детей.",shape=box,color=red];
		2622 -> 2627;
	2623 [label="Я не люблю притворяться, что понимаю штуки, которые по сути *боги*. Эта штука пытается разобраться в эмоциях. Просто у неё плохо получается играть с игрушками.",shape=box,color=red];
		2623 -> 2624;
	2627 [label="Только пусть попробует влезть между нами. Клянусь Сол, я его прикончу. Найду способ.",shape=box,color=blue];
		2627 -> 2628;
	2624 [label="Теория-то похвальная, но мы же этого не *знаем*, правда?",shape=box,color=blue];
		2624 -> 2625;
	2628 [label="Во Вселенной есть силы, против которых эта штука не устоит. Я выбираю верить в это каждой частицей себя.",shape=box,color=blue];
		2628 -> 2629;
	2625 [label="Если правда на твоей стороне, то это невинно. Детски, почти. Это не вяжется с тем, что нам известно. Это злонамеренно.",shape=box,color=blue];
		2625 -> 2626;
	2629 [label="Если оно проглотит меня целиком, я застряну у него в глотке и задушу его.",shape=box,color=blue];
		2629 -> 2630;
		2629 -> 2631;
	2626 [label="Chat ends.",color=orange];
	2630 [label="Это отличный способ умереть.",shape=box,color=red];
		2630 -> 2632;
	2631 [label="Я пока не знаю, как мы это сделаем, но я с тобой. Мы должны победить.",shape=box,color=red];
		2631 -> 2635;
	2632 [label="В этом случае я в любом случае мертва.",shape=box,color=blue];
		2632 -> 2633;
	2635 [label="Если бы это была сказка, тебе пришлось бы придумать бы какой-нибудь хитрый трюк. Найти каменное сердце великана и разбить его лебединым пером или обмануть, заставив его броситься с обрыва.",shape=box,color=blue];
		2635 -> 2636;
	2633 [label="Но, по крайней мере, я могу плюнуть ему в глаз.",shape=box,color=blue];
		2633 -> 2634;
	2636 [label="Ты говорила, что ты «журналистка». Это ведь не те истории, что ты привыкла рассказывать, да? Ты рассказывала правду, какой бы уродливой она ни была.",shape=box,color=red];
		2636 -> 2637;
	2634 [label="Chat ends.",color=orange];
	2637 [label="Если бы те старые истории не говорили правду, люди бы не продолжали их рассказывать.",shape=box,color=blue];
		2637 -> 2638;
	2638 [label="Я не про то, что великаны настоящие. Я про то, что старые истории говорят о другом виде правды.",shape=box,color=blue];
		2638 -> 2639;
		2638 -> 2640;
	2639 [label="Чтобы пережить это, нам понадобится нечто большее, чем сказки, какими бы вдохновляющими они ни были.",shape=box,color=red];
		2639 -> 2641;
	2640 [label="Моя жизнь прошла в королевстве, созданном из историй. Я знаю, насколько они могут быть сильны.",shape=box,color=red];
		2640 -> 2643;
	2641 [label="Я знаю. Хотелось бы иметь что-то большее, чем инстинкт, чтобы продолжать.",shape=box,color=blue];
		2641 -> 2642;
	2643 [label="Думаю, все эти истории про победу над великанами объединяет одно: они учат разбираться в правилах и использовать их с умом.",shape=box,color=blue];
		2643 -> 2644;
	2642 [label="Мы сталкиваемся с чем-то огромным, ужасающим и находящимся за пределами нашего понимания. Обычно это доступно только детям. Для этого и существуют сказки.",shape=box,color=blue];
		2642 -> 2645;
		2642 -> 2646;
	2644 [label="Некоторые монстры глупы. Некоторые вынуждены понимать всё буквально. У некоторых есть тайны. Но ты не победишь, пока не узнаешь правила, которые держат монстра в узде.",shape=box,color=blue];
		2644 -> 2645;
		2644 -> 2646;
	2645 [label="Он застрял в Стене. У меня даже нет уверенности, что это за Стена.",shape=box,color=red];
		2645 -> 2647;
	2646 [label="Мне кажется, «Безразличие» не связано никакими правилами.",shape=box,color=red];
		2646 -> 2649;
	2647 [label="Неважно. Если оно действительно застряло, то мы можем сделать два вывода, не так ли?",shape=box,color=blue];
		2647 -> 2651;
	2649 [label="Должны быть! Даже у богов есть правила! Как бы могущественно «Безразличие» ни казалось, оно не бог.",shape=box,color=blue];
		2649 -> 2650;
	2651 [label="Во-первых, его можно поймать. Может, даже заточить.",shape=box,color=blue];
		2651 -> 2653;
	2650 [label="Тебе удалось победить Тракса. Неважно, сколько раз пришлось упасть и оказаться на земле. ПОБЕДА осталась за тобой. Так почему бы тебе не одолеть и Человека в Стене?",shape=box,color=blue];
		2650 -> 2648;
	2653 [label="+15 Chemistry",color=orange];
		2653 -> 2652;
	2648 [label="Когда ты перестала его бояться, Элеонора?",shape=box,color=red];
		2648 -> 2655;
	2652 [label="А во-вторых, он чего-то ХОЧЕТ. Хочет выбраться. Если мы поймём, чего он хочет, мы уже будем на шаг впереди.",shape=box,color=blue];
		2652 -> 2654;
	2655 [label="Я не перестала.",shape=box,color=blue];
		2655 -> 2657;
	2654 [label="Chat ends.",color=orange];
	2657 [label="+20 Chemistry",color=orange];
		2657 -> 2656;
	2656 [label="Я просто больше боюсь потерять тебя, понимаешь?",shape=box,color=blue];
		2656 -> 2658;
	2658 [label="Chat ends.",color=orange];
}