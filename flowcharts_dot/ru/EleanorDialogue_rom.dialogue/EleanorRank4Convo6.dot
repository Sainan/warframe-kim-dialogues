digraph {
	1906 [label="EleanorRank4Convo6 begins.",color=orange];
		1906 -> 1907;
		1906 -> 1908;
	1907 [label="Итак… почему кристаллы?",shape=box,color=red];
		1907 -> 1909;
	1908 [label="Итак. Ты и Куинси. Вы когда-нибудь… ну, понимаешь?",shape=box,color=red];
		1908 -> 1910;
	1909 [label="О, я всегда их обожала. Когда я была маленькой, папа отвёл нас в Музей инноваций в Людстоне, и мы с Артуром получили наборы для выращивания кристаллов. У Артура получилось нечто ужасное — буквально комковатая каменная какашка. Кристалл сразу выкинули. А у меня вырос прекрасный голубой кристалл, как алмаз. С того дня я как-то почувствовала, что кристаллы на моей стороне.",shape=box,color=blue];
		1909 -> 1912;
	1910 [label="Ладно, сегодня я чувствую себя доброй, поэтому расскажу тебе это бесплатно.",shape=box,color=blue];
		1910 -> 1911;
	1912 [label="Так они просто для украшения?",shape=box,color=red];
		1912 -> 1916;
	1911 [label="Мы никогда. Даже не чуть-чуть.",shape=box,color=blue];
		1911 -> 1913;
	1916 [label="А. Нет.",shape=box,color=blue];
		1916 -> 1917;
	1913 [label="Не могу избавиться от мысли, что любимая позиция Куинси была бы «партнёр сверху с зеркалом, чтобы он мог представить, что занимается сексом с самим собой».",shape=box,color=blue];
		1913 -> 1914;
	1917 [label="Я знаю, что о кристаллах написано много ерунды. Не моё. Я не верю, что они очищают мою ауру или освещают мои чакры.",shape=box,color=blue];
		1917 -> 1918;
	1914 [label="Нет, спасибо. Мне достаточно любоваться им издалека.",shape=box,color=blue];
		1914 -> 1915;
	1918 [label="Но у них есть сущность.",shape=box,color=blue];
		1918 -> 1919;
	1915 [label="Chat ends.",color=orange];
	1919 [label="Извини. Я знаю, что звучу как полная идиотка.",shape=box,color=blue];
		1919 -> 1920;
		1919 -> 1921;
		1919 -> 1922;
	1920 [label="Хорошо, что ты сказала это, а не я. Это просто красивые камешки.",shape=box,color=red];
		1920 -> 1923;
	1921 [label="У меня есть друзья, которые являются Цефалонами. Они буквально представляют собой разум в форме стеклянных кубов. С чего ты взяла, что я буду смеяться над тобой за то, что ты думаешь, будто у кристаллов есть некая сущность?",shape=box,color=red];
		1921 -> 1924;
	1922 [label="Я провожу слишком много времени, выкапывая кристаллы из земли, чтобы они не имели какого-то более глубокого значения. Ты бы удивилась, сколько варфреймов были созданы частично благодаря кристаллам одного или нескольких видов.",shape=box,color=red];
		1922 -> 1925;
	1923 [label="О, иногда ты просто СВОДИШЬ С УМА.",shape=box,color=blue];
		1923 -> 1926;
	1924 [label="Ну вот, теперь я чувствую себя глупо за то, что почувствовала себя глупо.",shape=box,color=blue];
		1924 -> 1929;
	1925 [label="Удивительно и интригующе!",shape=box,color=blue];
		1925 -> 1930;
	1926 [label="Я бы подумала, что ты, из всех людей, можешь поднять свой взгляд выше сугубо материального.",shape=box,color=blue];
		1926 -> 1927;
	1929 [label="Думаю, у вас есть кристаллы, о которых я могу только мечтать.",shape=box,color=blue];
		1929 -> 1931;
		1929 -> 1932;
		1929 -> 1933;
	1930 [label="Расскажи мне о кристаллах твоего времени.",shape=box,color=blue];
		1930 -> 1932;
	1927 [label="Уйди прочь. Оставь меня моим причудливым камням.",shape=box,color=blue];
		1927 -> 1928;
	1931 [label="Аргон. Его можно найти только в Бездн, и он распадается, как только его достаёшь.",shape=box,color=red];
		1931 -> 1934;
	1932 [label="Есть целый варфрейм, сделанный из кристалла. Цитрина.",shape=box,color=red];
		1932 -> 1944;
	1933 [label="У нас есть пара обречённых влюблённых, превращённых в кристалл.",shape=box,color=red];
		1933 -> 1941;
	1928 [label="Chat ends.",color=orange];
	1934 [label="Ты говоришь: «Его можно найти только в Бездне», как будто люди постоянно туда-сюда из Бездны шастают. Я думала, это безумное измерение, а не курорт у моря.",shape=box,color=blue];
		1934 -> 1937;
	1944 [label="+10 Chemistry",color=orange];
		1944 -> 1935;
	1941 [label="+10 Chemistry",color=orange];
		1941 -> 1936;
	1937 [label="Думаю, ты ещё не знаешь о Башнях Орокин. Это как крепости в Бездне, возведённые на случай, если Владеющие Разумом попытаются напасть.",shape=box,color=red];
		1937 -> 1951;
	1935 [label="Это её имя? Мне кажется, я видела её в твоём воображении!",shape=box,color=blue];
		1935 -> 1938;
	1936 [label="Как красиво и грустно. Каково это — стать памятником своей любви?",shape=box,color=blue];
		1936 -> 1939;
	1951 [label="+20 Chemistry",color=orange];
		1951 -> 1946;
	1938 [label="Красивая дама-жеода. Полагаю, теперь мы с ней родственницы. Утешительная мысль.",shape=box,color=blue];
		1938 -> 1943;
	1939 [label="Надеюсь, никто не отломит от них кусочки на память. В моё время это бы точно произошло.",shape=box,color=blue];
		1939 -> 1940;
	1946 [label="Это знакомо. Под Людстоном и Манкунией есть сверхсекретные бункеры. Идея в том, что если когда-нибудь начнётся Радиационная Война, толстосумы и шишки смогут спрятаться в своих роскошных убежищах и потягивать коктейли, пока нас всех наверху превращают в пепел.",shape=box,color=blue];
		1946 -> 1947;
	1943 [label="Добро пожаловать в семью, я полагаю?",shape=box,color=red];
		1943 -> 1945;
	1940 [label="Люди пытаются, но мы их бережём. Это меньшее, что мы можем сделать.",shape=box,color=red];
		1940 -> 1942;
	1947 [label="«Та же старая история», — сказала она со вздохом.",shape=box,color=blue];
		1947 -> 1948;
	1945 [label="Chat ends.",color=orange];
	1942 [label="Chat ends.",color=orange];
	1948 [label="Забавно. Когда я росла, все так боялись Радиационной Войны. Помню те общественные объявления, которые шли по телевидению. Суровые советы о том, как запасаться припасами, как подготовить убежище и что обязательно нужно похоронить умерших родственников, даже если не хочется.",shape=box,color=blue];
		1948 -> 1949;
	1949 [label="Когда я увидела взрывающийся реактор в твоих мыслях, это вернуло меня ко всем тем кошмарам. Я поняла, что мы должны это остановить, чего бы это ни стоило. Я заставила бы остальных поверить тебе.",shape=box,color=blue];
		1949 -> 1950;
	1950 [label="Но этой планете грозит не Радиационная Война, верно? Это Техрот. Так или иначе, этот цикл завершится, и когда это случится, остальной мир заразится.",shape=box,color=blue];
		1950 -> 1952;
	1952 [label="Chat ends.",color=orange];
}