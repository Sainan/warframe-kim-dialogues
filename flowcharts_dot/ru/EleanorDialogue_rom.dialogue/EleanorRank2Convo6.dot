		1975 -> 787;
	786 [label="Он очаровательный маленький бесёнок. Зачем ты спрашиваешь?",shape=box,color=blue];
		786 -> 788;
		786 -> 789;
	787 [label="Ну, я думаю, что люблю их не больше и не меньше других. Почему ты спрашиваешь?",shape=box,color=blue];
		787 -> 788;
		787 -> 789;
	788 [label="Амир пытается собрать команду, чтобы сыграть в «Предания и Просторы». Я имею намерение помочь.",shape=box,color=red];
		788 -> 790;
	789 [label="Амир действительно хочет сыграть в «Предания и Просторы», со всеми. Ты в деле?",shape=box,color=red];
		789 -> 790;
	790 [label="Ах. Поняла. Ты избранный посланник, посланный от Громобойного Короля, чтобы завербовать благородную Элеонору. Несомненно, меня ждут всяческие авантюры. Fol de rol и так далее.",shape=box,color=blue];
		790 -> 791;
		790 -> 792;
	791 [label="Да, я думаю, это будет полнейшей тратой времени, но я стараюсь быть милой.",shape=box,color=red];
		791 -> 793;
	792 [label="Если честно, я думаю, что это будет весело. И, кажется, для него это важно.",shape=box,color=red];
		792 -> 794;
	793 [label="Я окажу тебе услугу и НЕ передам эти слова ему. Совет: обращайся с ним с большим уважением, когда я рядом.",shape=box,color=blue];
		793 -> 436;
	794 [label="Если честно, поиграть с глупым голосом и немного поактёрствовать пару часов звучит идеально. Записывайте меня.",shape=box,color=blue];
		794 -> 795;
	436 [label="Chat ends.",color=orange];
	795 [label="О! Я бы хотела быть волшебником. Или, может быть, бардом. Или и тем, и другим? Можно БЫТЬ обоими?",shape=box,color=blue];
		795 -> 796;
	796 [label="Или я могла бы быть болотной ведьмой! Если, конечно, мне разрешат носить тесный корсаж. Матушка Мосситица съест твои кости, маленький человечек.",shape=box,color=blue];
		796 -> 804;
