digraph {
	2081 [label="EleanorRank5Convo1 begins.",color=orange];
		2081 -> 2082;
	2082 [label="Check boolean EleanorDating",color=orange];
		2082 -> 2083 [label=true,color=green];
		2082 -> 2084 [label=false,color=brown];
	2083 [label="Привет, дорогуша. Я чувствую себя немного меланхолично. У тебя есть минутка?",shape=box,color=blue];
		2083 -> 2085;
		2083 -> 2086;
	2084 [label="Привет. Я чувствую себя немного меланхолично. У тебя есть минутка?",shape=box,color=blue];
		2084 -> 2085;
		2084 -> 2086;
	2085 [label="Для тебя, всегда.",shape=box,color=red];
		2085 -> 2088;
	2086 [label="Мне *очень* жаль, я сейчас не могу. [Завершить]",shape=box,color=red];
		2086 -> 2087;
	2088 [label="Спасибо, искренне.",shape=box,color=blue];
		2088 -> 2089;
	2087 [label="Chat ends.",color=orange];
	2089 [label="Знаешь ли ты, кто такая Женщина в капюшоне?",shape=box,color=blue];
		2089 -> 2090;
	2090 [label="Check boolean LettieFantasma2",color=orange];
		2090 -> 2091 [label=true,color=green];
		2090 -> 2092 [label=true,color=green];
		2090 -> 2093 [label=true,color=green];
		2090 -> 2094 [label=true,color=green];
		2090 -> 2095 [label=true,color=green];
		2090 -> 2092 [label=false,color=brown];
		2090 -> 2093 [label=false,color=brown];
		2090 -> 2094 [label=false,color=brown];
		2090 -> 2095 [label=false,color=brown];
	2091 [label="La Flaca?",shape=box,color=red];
		2091 -> 2096;
	2092 [label="… убийца из Скальдры?",shape=box,color=red];
		2092 -> 2098;
	2093 [label="Один из образов Луа?",shape=box,color=red];
		2093 -> 2099;
	2094 [label="Так ты называешь смерть?",shape=box,color=red];
		2094 -> 2099;
		2094 -> 2101;
	2095 [label="Понятия не имею.",shape=box,color=red];
		2095 -> 2101;
	2096 [label="+5 Chemistry",color=orange];
		2096 -> 2097;
	2098 [label="Не совсем.",shape=box,color=blue];
		2098 -> 2101;
	2099 [label="+5 Chemistry",color=orange];
		2099 -> 2100;
	2101 [label="Она — Смерть. Также одна из Сущностей Луа, в зависимости от того, какой традиции ты придерживаешься. Она та, кто приходит, укрывает тебя одеялом после шумного дня Жизни, целует на ночь и поёт колыбельную, чтобы ты уснула.",shape=box,color=blue];
		2101 -> 2102;
		2101 -> 2103;
	2097 [label="Ха. Если говорить о нашей дорогой Лэтти, то я понимаю. Да.",shape=box,color=blue];
		2097 -> 2101;
	2100 [label="Вообще-то да.",shape=box,color=blue];
		2100 -> 2101;
	2102 [label="Ты ведь не шутила, когда говорила о меланхолии?",shape=box,color=red];
		2102 -> 2104;
	2103 [label="Это будет один из тех разговоров в духе «устраивайся поудобнее, скиталец, это займёт какое-то время», не так ли?",shape=box,color=red];
		2103 -> 2105;
	2104 [label="Понимаешь… Всё, что дал нам Энтрати... сила, способности, бронированные задницы… Я бы отдала всё это за крошку уверенности в том, что смерть — это не конец.",shape=box,color=blue];
		2104 -> 2108;
	2105 [label="...так и должно было быть.",shape=box,color=blue];
		2105 -> 2106;
	2108 [label="Я пыталась. Мне не нравится это признавать, но иногда, когда мы патрулируем и происходит драка, я заглядываю в сознание умирающих и пытаюсь пройти через этот процесс вместе с ними. Если есть хоть какой-то свет в конце туннеля, я просто хочу его увидеть.",shape=box,color=blue];
		2108 -> 2109;
		2108 -> 2110;
	2106 [label="Забудь об этом. Я уверена, у тебя есть дела поважнее.",shape=box,color=blue];
		2106 -> 2107;
	2109 [label="Элеонора, это так мрачно. У тебя нет на это права.",shape=box,color=red];
		2109 -> 2111;
	2110 [label="Пытаешься ли ты их хоть как-то утешить?",shape=box,color=red];
		2110 -> 2114;
	2107 [label="Chat ends.",color=orange];
	2111 [label="Я знаю. Я ЗНАЮ.",shape=box,color=blue];
		2111 -> 2112;
	2114 [label="Да, однажды я это сделала. Какая разница, правда? Они всё равно умирают. Это была молодая солдатка Скальдры. Она шла на меня, и я выстрелила ей в грудь.",shape=box,color=blue];
		2114 -> 2115;
	2112 [label="Я говорю себе, что пыталась помочь, но правда в том, что мне просто хотелось посмотреть. Ты права. Это мрачно.",shape=box,color=blue];
		2112 -> 2113;
	2115 [label="Я опустилась на колени рядом с ней, пока она захлёбывалась собственной кровью, и попыталась сказать, что всё в порядке, боль скоро закончится, что вскоре она будет со своей семьёй, которая ушла раньше. Все эти спокойные, успокаивающие слова, которые приходят в голову, когда приходится проводить кого-то на смертном одре.",shape=box,color=blue];
		2115 -> 2116;
	2113 [label="Chat ends.",color=orange];
	2116 [label="Она была в ужасе. Остатки её сознания метались, как крыса в водяном баке. Когда она почувствовала, что я рядом, в её сознании, она попыталась зацепиться за меня. Она умоляла помочь. А под всем этим было... даже не знаю, как это назвать...",shape=box,color=blue];
		2116 -> 2117;
		2116 -> 2118;
		2116 -> 2119;
	2117 [label="Надежда?",shape=box,color=red];
		2117 -> 2120;
	2118 [label="Страх?",shape=box,color=red];
		2118 -> 2120;
	2119 [label="Отрицание?",shape=box,color=red];
		2119 -> 2120;
	2120 [label="Отрицание. Она не верила, что может умереть. И почему она должна была это сделать? Она всегда была там раньше. Как смерть могла забрать её сейчас?",shape=box,color=blue];
		2120 -> 2121;
	2121 [label="Каждый день своей жизни ты принимаешь СЕБЯ как должное. Ты есть, когда просыпаешься, и ты есть, когда засыпаешь. Ты проживаешь всю свою жизнь в доме, построенном из тебя самой. Ты никогда не выходишь наружу, потому что не можешь.",shape=box,color=blue];
		2121 -> 2122;
	2122 [label="И вот однажды ты видишь, как рушится дом.",shape=box,color=blue];
		2122 -> 2123;
		2122 -> 2124;
	2123 [label="Почему ты ей не помогла?",shape=box,color=red];
		2123 -> 2125;
	2124 [label="Ты оставалась с ней до конца?",shape=box,color=red];
		2124 -> 2126;
	2125 [label="Что мне надо было делать? Позвала Лэтти? Исцелила зияющую дыру в груди? Только потому, что я увидела приближение смерти так близко?",shape=box,color=blue];
		2125 -> 2127;
	2126 [label="Да. Я была чертовски напугана. Когда она почувствовала, как уходит, я была уверена, что она и меня потянет за собой. Я чувствовала это течение, тянущее меня.",shape=box,color=blue];
		2126 -> 2128;
	2127 [label="Со Скальдрой отношения такие — убить или быть убитой. Они не предлагают нам роскошь милосердия.",shape=box,color=blue];
		2127 -> 2129;
	2128 [label="Но мне пришлось остаться. Я не могла бросить её умирать в одиночестве.",shape=box,color=blue];
		2128 -> 2130;
	2129 [label="Chat ends.",color=orange];
	2130 [label="Хотя, думаю, она так и сделала, в конце концов. Я не смогла сделать с ней этот последний шаг.",shape=box,color=blue];
		2130 -> 2131;
		2130 -> 2132;
	2131 [label="Чему ты научилась из этого опыта?",shape=box,color=red];
		2131 -> 2133;
	2132 [label="Итак, ты увидела то, что хотела увидеть?",shape=box,color=red];
		2132 -> 2134;
	2133 [label="Я ничему не научилась.",shape=box,color=blue];
		2133 -> 2135;
	2134 [label="Нет.",shape=box,color=blue];
		2134 -> 2135;
	2135 [label="Но она видела. Она видела лицо своей матери, детей, с которыми ходила в школу, свою кошку, какого-то утонувшего кузена. Но это были не присутствия или духи. Просто воспоминания, вытолкнутые на поверхность умирающим мозгом, отчаянно ищущим, за что бы зацепиться.",shape=box,color=blue];
		2135 -> 2137;
	2137 [label="Тогда дом её личности начал рушиться вокруг неё. Прежде чем она умерла, она широко открыла глаза. Я думаю, в тот момент, впервые в своей жизни, она действительно поняла, что такое смерть.",shape=box,color=blue];
		2137 -> 2136;
		2137 -> 2138;
	2136 [label="Умирающий понимает, что такое смерть. Какое прозрение, Элеонора.",shape=box,color=red];
		2136 -> 2139;
	2138 [label="Что ты имеешь в виду? Все знают, что такое смерть.",shape=box,color=red];
		2138 -> 2140;
	2139 [label="Слушай. В следующий раз, когда почувствуешь необходимость остановить мой поток чепухи, не думай, что тебе нужно сначала это выслушать.",shape=box,color=blue];
		2139 -> 2141;
	2140 [label="Нет. Мы думаем, что знаем, что это такое, но весь наш опыт получен извне.",shape=box,color=blue];
		2140 -> 2143;
	2141 [label="Никто тебя не заставляет со мной разговаривать. Пока.",shape=box,color=blue];
		2141 -> 2142;
	2143 [label="Всю свою жизнь она была как женщина, живущая в доме без света, и всё, что у неё было, это фонарик. Она освещала светом своего сознания то одно, то другое место. Воспоминание, задача, взаимодействие.",shape=box,color=blue];
		2143 -> 2144;
	2142 [label="Chat ends.",color=orange];
	2144 [label="Она переходила из комнаты в комнату, исследовала подвалы во сне, но всегда это был замкнутый, конечный процесс. Понимаешь о чём я?",shape=box,color=blue];
		2144 -> 2145;
		2144 -> 2146;
	2145 [label="Не совсем, но продолжай.",shape=box,color=red];
		2145 -> 2147;
	2146 [label="Да.",shape=box,color=red];
		2146 -> 2147;
	2147 [label="Затем, когда дом был разрушен, и её личность рассыпалась на куски вокруг неё, внезапно фонарик не светил на стену, книгу или диван. Он светил в бесконечное небо. Её осознание вспыхнуло в бесконечности без препятствия в виде неё самой, стоящей на пути.",shape=box,color=blue];
		2147 -> 2149;
		2147 -> 2150;
		2147 -> 2151;
	2149 [label="Но осознание умирает, когда умирает тело. То, что ты испытала, было всего лишь спазмом в её умирающем мозге.",shape=box,color=red];
		2149 -> 2148;
	2150 [label="Ты думаешь, что «осознание» — это то, кем мы на самом деле являемся, а всё остальное — лишь оболочка?",shape=box,color=red];
		2150 -> 2155;
	2151 [label="Ого. Так глубоко. Ты кого-то застрелила, а потом ещё и нарушила её частную жизнь.",shape=box,color=red];
		2151 -> 2156;
	2148 [label="Я много раз пыталась убедить себя в этом.",shape=box,color=blue];
		2148 -> 2152;
	2155 [label="+5 Chemistry",color=orange];
		2155 -> 2154;
	2156 [label="Слушай. В следующий раз, когда почувствуешь необходимость остановить мой поток чепухи, не думай, что тебе нужно сначала это выслушать.",shape=box,color=blue];
		2156 -> 2157;
	2152 [label="Я не могу поверить, что это было не что иное, как отключение мозга. Это было похоже на то, как будто душа вырвалась на свободу.",shape=box,color=blue];
		2152 -> 2153;
	2154 [label="Я знаю, что это не имеет никакого смысла. Это ощущается так нелогично — мысль о том, что мы сначала являемся точкой зрения, а уже потом личностью. Всё, что я знаю, это то, как это чувствовалось — быть рядом с человеческой душой, когда она переходила от жизни к смерти.",shape=box,color=blue];
		2154 -> 2159;
	2157 [label="Никто тебя не заставляет со мной разговаривать. Пока.",shape=box,color=blue];
		2157 -> 2158;
	2153 [label="Chat ends.",color=orange];
	2159 [label="Что ты обо всем этом думаешь?",shape=box,color=red];
		2159 -> 2160;
	2158 [label="Chat ends.",color=orange];
	2160 [label="Утешение? Мне нравится мысль, что что-то из нас выживает. Я люблю думать, что смерть — это не исчезновение из вселенной, а уничтожение всего, что отделяет нас от вселенной.",shape=box,color=blue];
		2160 -> 2161;
	2161 [label="Но то, что делает нас НАМИ, — это не только чистое осознание. Это память, эмоции, мнение, всякие слои. Когда ты теряешь всё это, ты теряешь настоящего человека, даже если эта искорка как-то выживает.",shape=box,color=red];
		2161 -> 2162;
	2162 [label="Я знаю.",shape=box,color=blue];
		2162 -> 2163;
	2163 [label="Честно говоря, вот почему я хотела поговорить с тобой о привидениях Бездны, цефалонах и всех этих вещах из твоего времени. Мне нужно знать, будет ли у нас когда-нибудь шанс общаться с людьми, которых мы потеряли.",shape=box,color=blue];
		2163 -> 2164;
	2164 [label="Реальное общение, а не какая-то голографическая чушь. Такое, которое позволяет точно узнать, что думал человек.",shape=box,color=blue];
		2164 -> 2165;
		2164 -> 2166;
	2165 [label="Нет, не совсем. Даже в будущем, люди, которых мы потеряли… к лучшему или к худшему. просто… ушли.",shape=box,color=red];
		2165 -> 2167;
	2166 [label="Элеонора, ближе к делу. Кого ты потеряла?",shape=box,color=red];
		2166 -> 2169;
	2167 [label="Понятно. Есть двери, которые мы никогда не сможем открыть. Может быть, это и к лучшему.",shape=box,color=blue];
		2167 -> 2168;
	2169 [label="Его звали Кристофер. Он был лучшим другом Артура.",shape=box,color=blue];
		2169 -> 2170;
	2168 [label="Chat ends.",color=orange];
	2170 [label="Мы были помолвлены. Я думала, что влюблена в него.",shape=box,color=blue];
		2170 -> 2171;
	2171 [label="Update boolean EleanorChristopher1",color=orange];
		2171 -> 2172;
	2172 [label="+10 Chemistry",color=orange];
		2172 -> 2173;
	2173 [label="Извини. Я не могу этого сделать. Я поговорю с тобой в другой раз.",shape=box,color=blue];
		2173 -> 2174;
	2174 [label="Chat ends.",color=orange];
}