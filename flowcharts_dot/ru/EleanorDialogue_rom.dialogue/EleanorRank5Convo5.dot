	2462 [label="Chat ends.",color=orange];
	2464 [label="Привет, моя любовь.",shape=box,color=blue];
		2464 -> 2467;
		2464 -> 2468;
	2465 [label="Привет, таинственный и странно притягательный пришелец из другого времени.",shape=box,color=blue];
		2465 -> 2467;
		2465 -> 2468;
	2467 [label="Ты лучше спала прошлой ночью?",shape=box,color=red];
		2467 -> 2466;
	2468 [label="Тебе снова приснился кошмар?",shape=box,color=red];
		2468 -> 2466;
	2466 [label="Мне не снился сон про Артура с тех пор, как я рассказала тебе о бабушке Кэлли. Кажется, мне удалось изгнать этого демона.",shape=box,color=blue];
		2466 -> 2469;
	2469 [label="Check boolean EleanorDating",color=orange];
		2469 -> 2470 [label=true,color=green];
		2469 -> 2471 [label=false,color=brown];
	2470 [label="Но с тех пор, как мы вместе, начало происходить кое-что ещё. Честно говоря, это немного неловко. Я всё собиралась поговорить с тобой об этом, но подходящего момента так и не было.",shape=box,color=blue];
		2470 -> 2472;
		2470 -> 2473;
		2470 -> 2474;
	2471 [label="Но это не значит, что не было ДРУГИХ снов. Вполне себе тревожных.",shape=box,color=blue];
		2471 -> 2480;
		2471 -> 2481;
		2471 -> 2482;
	2472 [label="Ты видишь во сне меня?",shape=box,color=red];
		2472 -> 2475;
	2473 [label="Ты видишь во сне нас?",shape=box,color=red];
		2473 -> 2476;
	2474 [label="Неловко? Звучит нехорошо.",shape=box,color=red];
		2474 -> 2477;
	2480 [label="Не думаю, что тебя так легко потревожить.",shape=box,color=red];
		2480 -> 2483;
	2481 [label="Падаешь с бесконечного лестничного пролёта?",shape=box,color=red];
		2481 -> 2484;
	2482 [label="Это может быть важно. С твоими способностями сон может оказаться вовсе не сном.",shape=box,color=red];
		2482 -> 2485;
	2475 [label="Это было бы не неловко. А вот это — да.",shape=box,color=blue];
		2475 -> 2478;
	2476 [label="Боже, если бы это. Боюсь, ничего приятного.",shape=box,color=blue];
		2476 -> 2478;
	2477 [label="Не волнуйся. Это не так уж и плохо. Я не боюсь. Просто…",shape=box,color=blue];
		2477 -> 2478;
	2483 [label="Нет, но именно поэтому меня так беспокоит.",shape=box,color=blue];
		2483 -> 2486;
	2484 [label="Нет, не этот. Забавно, что, похоже, он был у всех.",shape=box,color=blue];
		2484 -> 2486;
	2485 [label="Именно этого я и боюсь.",shape=box,color=blue];
		2485 -> 2486;
	2478 [label="(Ладно, Элеонора, глубокий вдох, ты сможешь это сделать)",shape=box,color=blue];
		2478 -> 2479;
	2486 [label="(Ладно, Элеонора, глубокий вдох, ты сможешь это сделать)",shape=box,color=blue];
		2486 -> 2487;
	2479 [label="Я думаю, что Техрот ревнует.",shape=box,color=blue];
		2479 -> 2490;
		2479 -> 2491;
	2487 [label="Я думаю, что Техрот ревнует.",shape=box,color=blue];
		2487 -> 2488;
		2487 -> 2489;
	2490 [label="Ты шутишь!",shape=box,color=red];
		2490 -> 2494;
	2491 [label="Ревнует?",shape=box,color=red];
		2491 -> 2495;
	2488 [label="Ты шутишь!",shape=box,color=red];
		2488 -> 2492;
	2489 [label="Ревнует?",shape=box,color=red];
		2489 -> 2493;
	2494 [label="Ах, я бы хотела.",shape=box,color=blue];
		2494 -> 2496;
	2495 [label="Ревнует к тебе за то, что ты забираешь меня, да.",shape=box,color=blue];
		2495 -> 2496;
	2492 [label="Ах, если бы.",shape=box,color=blue];
		2492 -> 2497;
	2493 [label="Ревнует из за нашей дружбы, да.",shape=box,color=blue];
		2493 -> 2497;
	2496 [label="На каком-то глубоко искажённом уровне он считает меня своей собственностью. Я должна была стать его перспективой в целях размножения. Легациты видят во мне соперницу-королеву, знаешь ли.",shape=box,color=blue];
		2496 -> 2498;
		2496 -> 2499;
	2497 [label="На каком-то глубоко искажённом уровне он считает меня своей собственностью. Я должна была стать его перспективой в целях размножения. Легациты видят во мне соперницу-королеву, знаешь ли.",shape=box,color=blue];
		2497 -> 2500;
		2497 -> 2501;
	2498 [label="Это не то, как работают варфреймы. Заражение в них укрощено, оно бездействует. Ну, за исключением Нидуса, думаю, но он сам себе закон.",shape=box,color=red];
		2498 -> 2503;
	2499 [label="Значит, Техрот думает, что я украл тебя у него, а теперь хочет вернуть?",shape=box,color=red];
		2499 -> 2504;
	2500 [label="Это не то, как работают варфреймы. Заражение в них укрощено, оно бездействует. Ну, за исключением Нидуса, думаю, но он сам себе закон.",shape=box,color=red];
		2500 -> 2502;
	2501 [label="Так значит, Техрот думает, что я удерживаю тебя от возвращения к нему?",shape=box,color=red];
		2501 -> 2505;
	2503 [label="Ну, может быть, если бы я была полноценным варфреймом, Техрот не воспринимал бы меня таким образом. А пока мои клетки всё ещё живы, он считает меня своей собственностью.",shape=box,color=blue];
		2503 -> 2506;
	2504 [label="Разве это не странно? Брошенная бывшая!",shape=box,color=blue];
		2504 -> 2506;
	2502 [label="Ну, может быть, если бы я была полноценным варфреймом, Техрот не воспринимал бы меня таким образом. А пока мои клетки всё ещё живы, он считает меня своей собственностью.",shape=box,color=blue];
		2502 -> 2507;
	2505 [label="Да. Он хочет вернуть меня в свою стаю.",shape=box,color=blue];
		2505 -> 2507;
	2506 [label="Там, откуда я родом, тебе пришлось бы выйти и подраться с ним за местным супермаркетом. Не уверена, как это работает в твоё время.",shape=box,color=blue];
		2506 -> 2508;
	2507 [label="«Я твоя НАСТОЯЩАЯ семья», — шепчет он. «Стань снова частью нас, заблудшая сестра. Мы примем тебя обратно».",shape=box,color=blue];
		2507 -> 2508;
	2508 [label="Подожди, вернись немного назад. Откуда ты знаешь, что Техрот чувствует именно это?",shape=box,color=red];
		2508 -> 2509;
	2509 [label="О Боги, вот и началась неловкая часть.",shape=box,color=blue];
		2509 -> 2510;
	2510 [label="Сны, о которых я упоминала ранее. Я уверена, что их посылает Техрот.",shape=box,color=blue];
		2510 -> 2511;
	2511 [label="Что бы у этой штуки ни было, что можно назвать разумом, оно всегда могло подключаться к моему. Мысли, которые оно посылает, всегда грубые, но слабые, так что я легко могу от них защититься.",shape=box,color=blue];
		2511 -> 2512;
	2512 [label="Большую часть времени это ощущается как мучительное царапанье в затылке, словно ты в ванной, а кот пытается открыть дверь.",shape=box,color=blue];
		2512 -> 2513;
		2512 -> 2514;
	2513 [label="Но когда ты спишь, всё иначе, верно?",shape=box,color=red];
		2513 -> 2515;
	2514 [label="Кажется, я понимаю, к чему ты клонишь.",shape=box,color=red];
		2514 -> 2515;
	2515 [label="Верно. Моя защита ослаблена, и он может достучаться до меня.",shape=box,color=blue];
		2515 -> 2516;
	2516 [label="Он воздействует на меня на самом примитивном уровне, если ты понимаешь, о чём я. Он хочет вернуть меня. Обещает, что сможет подарить мне экстаз, который я никогда не испытывала.",shape=box,color=blue];
		2516 -> 2517;
	2517 [label="Он заселит мою плоть капающими кистами новой жизни. Потому что он думает, что именно этого я хочу, понимаешь.",shape=box,color=blue];
		2517 -> 2518;
	2518 [label="Check boolean EleanorDating",color=orange];
		2518 -> 2519 [label=true,color=green];
		2518 -> 2520 [label=true,color=green];
		2518 -> 2521 [label=false,color=brown];
		2518 -> 2522 [label=false,color=brown];
	2519 [label="Ладно, думаю, на этом всё. Как я могу с этим бороться?",shape=box,color=red];
		2519 -> 2523;
	2520 [label="Я *сожгу всё до тла*, прежде чем позволю ему забрать тебя.",shape=box,color=red];
		2520 -> 2524;
	2521 [label="Я никогда не позволю ему забрать тебя, Элеонора. Ты мой друг.",shape=box,color=red];
		2521 -> 2525;
	2522 [label="Ты мне как семья. Я не позволю ему забрать тебя.",shape=box,color=red];
		2522 -> 2526;
	2523 [label="+20 Chemistry",color=orange];
		2523 -> 2530;
	2524 [label="Вот это тот самый разговор, за который Скиталец покрывается поцелуями с головы до ног.",shape=box,color=blue];
		2524 -> 2527;
	2525 [label="Я знаю. Думаю, он тоже знает, поэтому так злится. Он не может конкурировать.",shape=box,color=blue];
		2525 -> 2528;
	2526 [label="Я буду спать спокойнее, зная, что ты меня поддерживаешь.",shape=box,color=blue];
		2526 -> 2529;
	2530 [label="Ничего, моя милая. Я не собираюсь оставлять тебя ради гноящейся массы заражённой плоти с плавающими в ней кусками бесхозной технологии.",shape=box,color=blue];
		2530 -> 2531;
	2527 [label="+20 Chemistry",color=orange];
		2527 -> 2532;
	2528 [label="+20 Chemistry",color=orange];
		2528 -> 2533;
	2529 [label="+20 Chemistry",color=orange];
		2529 -> 2534;
	2531 [label="Просто… если ты увидишь, что я выгляжу особенно усталой и измождённой в какое-то утро, когда мы проснёмся вместе, пожалуйста, принеси мне крепкий кофе и не расспрашивай о подробностях, ладно?",shape=box,color=blue];
		2531 -> 2535;
		2531 -> 2536;
	2532 [label="Хочешь заставить Техрот позеленеть от настоящей ревности?",shape=box,color=blue];
		2532 -> 2538;
	2533 [label="Тогда мы пройдём через это вместе. Бок о бок. Навсегда.",shape=box,color=blue];
		2533 -> 2539;
	2534 [label="Мы семья. Одной крови. Нерушимая.",shape=box,color=blue];
		2534 -> 2540;
	2535 [label="Я могу это сделать.",shape=box,color=red];
		2535 -> 2537;
	2536 [label="...Принято.",shape=box,color=red];
		2536 -> 2537;
	2538 [label="Chat ends.",color=orange];
	2539 [label="Chat ends.",color=orange];
	2540 [label="Chat ends.",color=orange];
	2537 [label="Chat ends.",color=orange];
