digraph {
	220 [label="EleanorRank1Convo4 begins.",color=orange];
		220 -> 221;
	221 [label="Каково это? Иметь свободу гулять по городу, заполненному чумой, и знать, что тебе не придётся беспокоиться о том, чтобы заразиться?",shape=box,color=blue];
		221 -> 222;
		221 -> 223;
		221 -> 224;
	222 [label="«Слоняться без дела» — это несправедливо, Элеонора.",shape=box,color=red];
		222 -> 225;
	223 [label="Я не знаю, что не заражусь. Просто пока зараза меня не достала.",shape=box,color=red];
		223 -> 226;
	224 [label="Это фантастика. Я могу помогать людям в опасности.",shape=box,color=red];
		224 -> 248;
	225 [label="Я буду говорить, как захочу, спасибо большое.",shape=box,color=blue];
		225 -> 227;
		225 -> 228;
	226 [label="О, да ладно тебе.",shape=box,color=blue];
		226 -> 230;
	248 [label="Хех. Это был весь стиль Энтрати. Когда он впервые появился со своим представлением «Доктор Пятница» в стиле медицинских шоу.",shape=box,color=blue];
		248 -> 255;
	227 [label="И я скажу, когда ты перейдёшь черту.",shape=box,color=red];
		227 -> 232;
	228 [label="Как хочешь. [Завершить]",shape=box,color=red];
		228 -> 229;
	230 [label="Я видела, как ты действуешь. Возможно, ты была человеком когда-то, но теперь ты — Блестящие Сапожки, Космический Эльф. Все эти жуткие световые шоу и мистические силы.",shape=box,color=blue];
		230 -> 231;
	255 [label="Check boolean EleanorEntrati",color=orange];
		255 -> 256 [label=true,color=green];
		255 -> 257 [label=false,color=brown];
	232 [label="…",shape=box,color=blue];
		232 -> 233;
	229 [label="Chat ends.",color=orange];
	231 [label="Не думаю, что тебя можно убить. Не навсегда. И я знаю, как сильно люди старались.",shape=box,color=blue];
		231 -> 236;
	256 [label="Заставляет задуматься, почему он так и не заразился. Ведь его семья, в конце концов, пострадала.",shape=box,color=blue];
		256 -> 263;
	257 [label="Ему удалось защитить себя от падения, по крайней мере. Может, он больше похож на тебя, чем ты думаешь.",shape=box,color=blue];
		257 -> 263;
	233 [label="Ладно. Меня подловили. Прости.",shape=box,color=blue];
		233 -> 234;
	236 [label="Ты не боишься Техрота. А зачем тебе? У тебя нет причин.",shape=box,color=blue];
		236 -> 237;
	263 [label="У Хёльвании была куча так называемых спасителей.",shape=box,color=blue];
		263 -> 264;
	234 [label="Элеонора сегодня настоящая кислая лимонка.",shape=box,color=blue];
		234 -> 235;
	237 [label="Ты не заразишься.",shape=box,color=blue];
		237 -> 245;
		237 -> 246;
		237 -> 247;
	264 [label="Принцесса, в своё время. Потом Энтрати. Виктор. Конечно, мой брат. А теперь ты.",shape=box,color=blue];
		264 -> 265;
	235 [label="Сол, как же я скучаю по вкусу лимонов.",shape=box,color=blue];
		235 -> 238;
		235 -> 239;
	245 [label="Ты не знаешь эту вещь так, как знаю её я. Она развивается. Мутирует. Она учится. Орокин думали, что смогут её победить. Им это так и не удалось.",shape=box,color=red];
		245 -> 249;
	246 [label="Может быть, ты права. Но мы этого не ЗНАЕМ.",shape=box,color=red];
		246 -> 261;
	247 [label="Ты права. Я могла бы помогать людям больше.",shape=box,color=red];
		247 -> 248;
	265 [label="Ты видишь себя героем?",shape=box,color=blue];
		265 -> 270;
	238 [label="Что-то на уме?",shape=box,color=red];
		238 -> 242;
	239 [label="Развлекайся. [Завершить]",shape=box,color=red];
		239 -> 244;
	249 [label="Check boolean EleanorOrigin",color=orange];
		249 -> 252 [label=true,color=green];
		249 -> 253 [label=false,color=brown];
	261 [label="+10 Chemistry",color=orange];
		261 -> 250;
	270 [label="Update boolean EleanorHatesHeroes",color=orange];
		270 -> 271;
		270 -> 272;
		270 -> 273;
		270 -> 274;
	242 [label="+10 Chemistry",color=orange];
		242 -> 240;
	244 [label="Chat ends.",color=orange];
	252 [label="О, Боги, теперь я помню. Эрида. Обломки. Поверхность Деймоса.",shape=box,color=blue];
		252 -> 253;
	253 [label="Я постоянно забываю, что мы не выигрываем у Техрота.",shape=box,color=blue];
		253 -> 258;
	250 [label="Полагаю, нет. И мне вообще не стоит об этом размышлять.",shape=box,color=blue];
		250 -> 251;
	271 [label="Я просто стараюсь изо всех сил.",shape=box,color=red];
		271 -> 281;
	272 [label="Да. Я вижу.",shape=box,color=red];
		272 -> 276;
	273 [label="Нет, не вижу.",shape=box,color=red];
		273 -> 280;
	274 [label="Я не верю в героев.",shape=box,color=red];
		274 -> 279;
	240 [label="Ничего, чем бы я гордилась.",shape=box,color=blue];
		240 -> 241;
	258 [label="Это почти заставляет то, что мы пытаемся сделать здесь, казаться бессмысленным.",shape=box,color=blue];
		258 -> 259;
	251 [label="Просто меня коробит видеть, как ты так возвышаешься над всем этим, понимаешь?",shape=box,color=blue];
		251 -> 254;
	281 [label="+10 Chemistry",color=orange];
		281 -> 275;
	276 [label="Я просто не могу понять, как можно оказаться в сказочном королевстве и ДО СИХ ПОР не перерасти такие вещи.",shape=box,color=blue];
		276 -> 283;
	280 [label="+15 Chemistry",color=orange];
		280 -> 277;
	279 [label="+20 Chemistry",color=orange];
		279 -> 278;
	241 [label="Но всё равно спасибо, что проверяешь.",shape=box,color=blue];
		241 -> 243;
	259 [label="Сол. А я тут жалею себя за то, что стала жертвой чумы, и обрушиваюсь на тебя за то, что у тебя к ней иммунитет, хотя тебе выпало увидеть, как целые миры были поглощены этим самым мерзким гнильём.",shape=box,color=blue];
		259 -> 268;
	254 [label="Не обращай внимания. Гноящиеся пятна и так достаточно уродливы. Жалость к себе ещё хуже.",shape=box,color=blue];
		254 -> 260;
	275 [label="Достаточно. Продолжай, солдат.",shape=box,color=blue];
		275 -> 282;
	283 [label="Chat ends.",color=orange];
	277 [label="Рада. Человек, проживший столько веков, как ты, должен повзрослеть к этому времени.",shape=box,color=blue];
		277 -> 284;
	278 [label="Тем лучше для тебя. Потому что я видела, что произошло, когда один маленький мальчик решил отправиться в Героическое Путешествие и начал думать о нас, как о второстепенных персонажах.",shape=box,color=blue];
		278 -> 285;
	243 [label="Chat ends.",color=orange];
	268 [label="+20 Chemistry",color=orange];
		268 -> 266;
	260 [label="Update boolean EleanorGalvanized",color=orange];
