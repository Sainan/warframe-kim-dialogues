	266 [label="Я думаю, что буду благодарна за то, что у меня есть.",shape=box,color=blue];
		266 -> 267;
	262 [label="Chat ends.",color=orange];
	267 [label="Update boolean EleanorGalvanized",color=orange];
		267 -> 269;
