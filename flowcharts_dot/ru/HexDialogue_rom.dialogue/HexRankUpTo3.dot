digraph {
	4 [label="HexRankUpTo3 begins.",color=orange];
		4 -> 85;
	85 [label="Soldja1Shot1kil: так говорят, когда мужик проголодался…",shape=box,color=blue];
		85 -> 86;
	86 [label="H16h V0l7463: хах! голодныйголодныйКуинси. знаешь, у меня была настолка такая в детстве, и я спорю, что смогу—",shape=box,color=blue];
		86 -> 87;
		86 -> 88;
		86 -> 89;
	87 [label="Командный Обед?",shape=box,color=red];
		87 -> 188;
	88 [label="Предложение всегда в силе — присоединяйтесь ко мне.",shape=box,color=red];
		88 -> 189;
	89 [label="Фудкорт большой, заходите.",shape=box,color=red];
		89 -> 190;
	188 [label="Update boolean HexTeamLunch",color=orange];
		188 -> 90;
	189 [label="Update boolean HexJoinLunch",color=orange];
		189 -> 90;
	190 [label="Update boolean HexAllLunch",color=orange];
		190 -> 90;
	90 [label="Soldja1Shot1kil: позволь мне закончить. Так вот, если мужик проголодался, а этот сахарный корпоративный рекламный блев постоянно звучит в фудкорте… что бы ты сказал, если бы я подстрелил технику, которая качает этот гул?",shape=box,color=blue];
		90 -> 91;
	91 [label="xX GLIMMER Xx: ооо, дай мне разнести их. я буду осторожна, не поврежу Зика! <RETRO_EMOJI_PUMPEDUP>",shape=box,color=blue];
		91 -> 92;
	92 [label="Belladonna ~{@: ¡Ay, no!
Я же говорила, что нам, может, придётся класть туда пациентов, снаружи этих стен
Без осколков, без мусора
Мне необходимо чистое пространство",shape=box,color=blue];
		92 -> 93;
	93 [label="Salem: Ну-ну, дорогая Лэтти. Разве никто ничего не заметил?",shape=box,color=blue];
		93 -> 94;
	94 [label="Broadsword: Заметил что, Эл?",shape=box,color=blue];
		94 -> 95;
	95 [label="Salem: Не пациенты окружают стены молла снаружи, а любопытные жители, которые, кажется, чувствуют себя… в безопасности здесь.",shape=box,color=blue];
		95 -> 96;
	96 [label="H16h V0l7463: подождите. вы хотите сказать, что... мы реально тут что-то меняем?",shape=box,color=blue];
		96 -> 97;
		96 -> 98;
		96 -> 99;
	97 [label="Конечно, меняем.",shape=box,color=red];
		97 -> 191;
	98 [label="Меняем.",shape=box,color=red];
		98 -> 192;
	99 [label="Я люблю так думать.",shape=box,color=red];
		99 -> 193;
	191 [label="Update boolean HexMakeADiffSure",color=orange];
		191 -> 100;
	192 [label="Update boolean HexMakeADiff",color=orange];
		192 -> 100;
	193 [label="Update boolean HexMakeADiffHope",color=orange];
		193 -> 100;
	100 [label="Broadsword: Мы не так уж плохи как команда",shape=box,color=blue];
		100 -> 101;
	101 [label="H16h V0l7463: ОНЩАССКАЖЕТЭТОСЛОВО",shape=box,color=blue];
		101 -> 102;
	102 [label="Broadsword: …Команда.",shape=box,color=blue];
		102 -> 103;
	103 [label="Soldja1Shot1kil: больше ртов кормить... даже если Его Величество думает, что мы тут в тепле и уюте? плохая идея",shape=box,color=blue];
		103 -> 104;
	104 [label="Salem: Я могла бы прогнать их. Это стоило бы мне всего мысли…",shape=box,color=blue];
		104 -> 105;
	105 [label="xX GLIMMER Xx: я не могу отделаться от чувства, что… даже если мы стараемся изо всех сил, зачем давать людям ложную надежду, что мы сможем их спасти? Это не закончится ничем хорошим.",shape=box,color=blue];
		105 -> 106;
		105 -> 107;
		105 -> 108;
	106 [label="А если это не ложь?",shape=box,color=red];
		106 -> 194;
	107 [label="Может, всё в этом и дело. Знать, что МЫ можем что-то изменить.",shape=box,color=red];
		107 -> 195;
	108 [label="Чем больше людей здесь, прямо сейчас, которые чувствуют надежду, тем лучше.",shape=box,color=red];
		108 -> 196;
	194 [label="Update boolean HexGiveComfort",color=orange];
		194 -> 109;
	195 [label="Update boolean HexGiveAssurance",color=orange];
		195 -> 109;
	196 [label="Update boolean HexGiveHope",color=orange];
		196 -> 109;
	109 [label="H16h V0l7463: хмм, не хочу портить момент, но у меня ощущение, что мы зовём людей на вечеринку разочарований.",shape=box,color=blue];
		109 -> 110;
	110 [label="Salem: Но разве мы не должны качнуть чашу весов судьбы? Даже лёгкий толчок на весах может быть интересным.",shape=box,color=blue];
		110 -> 111;
	111 [label="Belladonna ~{@: Ну, значит, я буду отвечать за сопли и ампутации?
Моя тётя всегда говорила: \"никаких больших решений на пустой желудок\"
Давайте встретимся в фудкорте и обсудим, что делать",shape=box,color=blue];
		111 -> 112;
	112 [label="xX GLIMMER Xx: <RETRO_EMOJI_HAPPY2> оооо! командный обед!",shape=box,color=blue];
		112 -> 113;
	113 [label="Broadsword: Командный обед.",shape=box,color=blue];
		113 -> 114;
	114 [label="Soldja1Shot1kil: я в деле. и благодарите меня за то, что я это начал.",shape=box,color=blue];
		114 -> 115;
