		j3431664773 -> j1297313159;
	j1297313159 [label="Soldja1Shot1kil: думаешь, люди почувствуют себя желанными? элеонора их не отпугнёт своим оскалом? хах ;)",shape=box,color=blue];
		j1297313159 -> j3045566484;
	j3045566484 [label="Broadsword: Фокус. Всё готово?",shape=box,color=blue];
		j3045566484 -> j253070169;
		j3045566484 -> j3212986503;
		j3045566484 -> j2440766384;
	j253070169 [label="Да, мы можем открыть это место для \"гражданских\".",shape=box,color=red];
		j253070169 -> j2286741761;
	j3212986503 [label="Гражданские должны услышать, что это место под защитой Гекса.",shape=box,color=red];
		j3212986503 -> j4045332544;
