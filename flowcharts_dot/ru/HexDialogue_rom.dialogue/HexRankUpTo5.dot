	j3663680250 [label="Boolean HexSongC is now true.",color=orange];
		j3663680250 -> j2085228592;
	j2085228592 [label="Salem: Ммм, хорошая идея.",shape=box,color=blue];
		j2085228592 -> j1870142761;
	j1870142761 [label="Soldja1Shot1kil: вернёмся к делу — мы готовы открыть ворота? я могу вести себя прилично. почти",shape=box,color=blue];
		j1870142761 -> j1383891210;
	j1383891210 [label="Belladonna ~{@: Хватит болтать\n¡Vamos! Давайте двигаться\nНе могу дождаться, чтобы поговорить с кем-то, кроме как о боевой стойке Артура",shape=box,color=blue];
		j1383891210 -> j2934574961;
	j2934574961 [label="Salem: Ох, Лэтти, да мы *все* знаем, что ты бы его уделала.",shape=box,color=blue];
		j2934574961 -> j2817705289;
	j2817705289 [label="xX GLIMMER Xx: лэтти? ты серьёзно? ты реально звучишь взволнованно! <RETRO_EMOJI_JOY>",shape=box,color=blue];
		j2817705289 -> j3888048951;
	j3888048951 [label="Broadsword: Ладно, я открываю торговый центр. Назад пути нет. Без сомнений. Запомните: для этих людей важно иметь место, где они могут почувствовать себя в безопасности. Но мы можем лучше. Давайте снова повеселимся.",shape=box,color=blue];
		j3888048951 -> j119875361;
