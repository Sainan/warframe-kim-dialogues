digraph {
	"HexRankUpTo5 begins." [color=orange];
		"HexRankUpTo5 begins." -> j521951165;
	j521951165 [label="H16h V0l7463: ::прочищает горло:: кхм-кхм! ВНИМАНИЕ ВСЕМ! Приглашения раздаются всем на Самую Гексовую Пицца-вечеринку в мире.",shape=box,color=blue];
		j521951165 -> j2964765525;
	j2964765525 [label="xX GLIMMER Xx: <RETRO_EMOJI_HORRIFIED> амир, подожди, я не закончила постер!..",shape=box,color=blue];
		j2964765525 -> j3431664773;
	j3431664773 [label="Belladonna ~{@: Думаю, у меня хватит антацидов для этого\n*Думаю*",shape=box,color=blue];
		j3431664773 -> j1297313159;
	j1297313159 [label="Soldja1Shot1kil: думаешь, люди почувствуют себя желанными? элеонора их не отпугнёт своим оскалом? хах ;)",shape=box,color=blue];
		j1297313159 -> j3045566484;
	j3045566484 [label="Broadsword: Фокус. Всё готово?",shape=box,color=blue];
		j3045566484 -> j253070169;
		j3045566484 -> j3212986503;
		j3045566484 -> j2440766384;
	j253070169 [label="Да, мы можем открыть это место для \"гражданских\".",shape=box,color=red];
		j253070169 -> j2286741761;
	j3212986503 [label="Гражданские должны услышать, что это место под защитой Гекса.",shape=box,color=red];
		j3212986503 -> j4045332544;
	j2440766384 [label="Надеюсь, они придут, нужно дать им хоть что-то, чего они смогут ждать.",shape=box,color=red];
		j2440766384 -> j2777551979;
	j2286741761 [label="Boolean HexOpenThePlace is now true.",color=orange];
		j2286741761 -> j386822427;
	j4045332544 [label="Boolean HexProtection is now true.",color=orange];
		j4045332544 -> j386822427;
	j2777551979 [label="Boolean HexLookForwardTo is now true.",color=orange];
		j2777551979 -> j386822427;
	j386822427 [label="H16h V0l7463: новички — больше монет выкачивать. сладкие-сладкие монеты.",shape=box,color=blue];
		j386822427 -> j83576307;
	j83576307 [label="xX GLIMMER Xx: фу, Амир, мерзость.",shape=box,color=blue];
		j83576307 -> j1405341848;
	j1405341848 [label="xX GLIMMER Xx: но — больше людей! может, стоит встретить их с плейлистом? какую песню поставим?",shape=box,color=blue];
		j1405341848 -> j2265475556;
		j1405341848 -> j2805972231;
		j1405341848 -> j976141112;
	j2265475556 [label="Давайте “Party of your Lifetime”.",shape=box,color=red];
		j2265475556 -> j1846591391;
	j2805972231 [label="О, “Зов”, обожаю.",shape=box,color=red];
		j2805972231 -> j3524220739;
	j976141112 [label="А давайте иронично: “Гнилые жизни”.",shape=box,color=red];
		j976141112 -> j3663680250;
	j1846591391 [label="Boolean HexSongA is now true.",color=orange];
		j1846591391 -> j2085228592;
	j3524220739 [label="Boolean HexSongB is now true.",color=orange];
