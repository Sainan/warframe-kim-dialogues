	j357362656 [label="xX GLIMMER Xx: лэтти? ты серьёзно? ты реально звучишь взволнованно! <RETRO_EMOJI_JOY>",shape=box,color=blue];
		j357362656 -> j2912960111;
	j2912960111 [label="Broadsword: Ладно, я открываю торговый центр. Назад пути нет. Без сомнений. Запомните: для этих людей важно иметь место, где они могут почувствовать себя в безопасности. Но мы можем лучше. Давайте снова повеселимся.",shape=box,color=blue];
