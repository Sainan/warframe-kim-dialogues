		"HexRankUpTo1 begins." -> j2932094506;
	j2932094506 [label="Broadsword: Мы застряли здесь, поняли? Так что убирайте за собой — Фудкорт грязнее улиц. Это вам не чёртов зоопарк.",shape=box,color=blue];
		j2932094506 -> j3312998839;
	j3312998839 [label="Salem: Лэтти, может, этим займётся, если",shape=box,color=blue];
		j3312998839 -> j647224247;
	j647224247 [label="Belladonna ~{@: Хватит.",shape=box,color=blue];
		j647224247 -> j3907083295;
	j3907083295 [label="Soldja1Shot1kil: хаха, попался.",shape=box,color=blue];
		j3907083295 -> j900148395;
	j900148395 [label="H16h V0l7463: вау, вы, ребят, наконец-то юзаете мой групповой чат?! ЭТО ЖЕ ТАК КРУТО!!",shape=box,color=blue];
		j900148395 -> j1472591362;
	j1472591362 [label="xX GLIMMER Xx: :) <3 Говорил же, Амир!",shape=box,color=blue];
		j1472591362 -> j2652830145;
	j2652830145 [label="Invoke /Lotus/Scripts/1999/DialogueScriptNodes.lua:SetDroneTypeLocData",color=orange];
		j2652830145 -> j3426359649;
		j2652830145 -> j665039796;
		j2652830145 -> j3864583514;
	j3426359649 [label="Кстати, у меня есть кое-что, что поможет с уборкой — встречайте |ITEM_A|.",shape=box,color=red];
		j3426359649 -> j1376671573;
	j665039796 [label="Кстати, у меня есть кое-что, что поможет с уборкой — встречайте |ITEM_B|.",shape=box,color=red];
		j665039796 -> j1358903714;
	j3864583514 [label="Кстати, у меня есть кое-что, что поможет с уборкой — встречайте |ITEM_C|.",shape=box,color=red];
