		"HexRankUpTo1 begins." -> j3273204450;
	j3273204450 [label="Broadsword: Мы застряли здесь, поняли? Так что убирайте за собой — Фудкорт грязнее улиц. Это вам не чёртов зоопарк.",shape=box,color=blue];
