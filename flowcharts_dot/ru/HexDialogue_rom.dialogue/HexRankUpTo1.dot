		j4197216479 -> j325946153;
	j325946153 [label="H16h V0l7463: вау, вы, ребят, наконец-то юзаете мой групповой чат?! ЭТО ЖЕ ТАК КРУТО!!",shape=box,color=blue];
		j325946153 -> j1263792404;
