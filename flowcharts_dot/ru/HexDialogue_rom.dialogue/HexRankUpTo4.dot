		j3785967908 -> j2662115967;
	j2662115967 [label="Broadsword: Кто бы ещё ни был на этой доске, я думаю, мы сделали этот год, это место, это время — нашим. Давайте никогда не отпустим это. Защитим тех, кто здесь, и друг друга.",shape=box,color=blue];
