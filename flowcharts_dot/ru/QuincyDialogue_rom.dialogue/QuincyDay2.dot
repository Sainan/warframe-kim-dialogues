		3067 -> 3065;
	3065 [label="а теперь... теперь у меня есть этот ублюдок - этот УБЛЮДОК - и теперь МЕНЯ ДОЛЖНО ВОЛНОВАТЬ, ЧТО С НИМ СЛУЧИТСЯ",shape=box,color=blue];
		3065 -> 3064;
