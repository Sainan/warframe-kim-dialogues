		3064 -> 3059;
	3059 [label="так что когда его задница ВТЯНУЛА НАС В СЕРЬЁЗНОЕ ДЕРЬМО ПАРУ МЕСЯЦЕВ СПУСТЯ, и его вот-вот должны были УВОЛИТЬ?!",shape=box,color=blue];
		3059 -> 3066;
	3066 [label="МНЕ НАДО ВЫБИРАТЬ. солгать начальству? или бросить его под автобус, как я уже делал раньше? или сделать ПРАВИЛЬНОЕ ДЕЛО",shape=box,color=blue];
		3066 -> 3057;
	3057 [label="я делаю ПРАВИЛЬНОЕ ЧЁРТОВО ДЕЛО, ПОТОМУ ЧТО Я ЕМУ ДОЛЖЕН, и я... я ухожу из армии с ним, и... и прощай моя мечта о колледже",shape=box,color=blue];
		3057 -> 3061;
	3061 [label="вся эта моя мечта о том, чтобы сделать лучше для себя и своей семьи? исчезла. но артур говорит: \"дааааа ладно, бро, всё будет нормально\"",shape=box,color=blue];
		3061 -> 3060;
	3060 [label="\"я договорился о новой должности в миротворческой организации. они платят больше и авансом. у тебя всё будет хорошо\"",shape=box,color=blue];
		3060 -> 3058;
