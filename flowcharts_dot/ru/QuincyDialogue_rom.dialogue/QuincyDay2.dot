	3026 [label="я рассказывал тебе, почему я пошёл в армию. как я хотел сделать лучше для себя и своей семьи",shape=box,color=blue];
		3026 -> 3119;
	3027 [label="я никогда не говорил тебе, почему я попал в армию. скажу коротко. это просто. я хотел сделать лучше для себя и своей семьи",shape=box,color=blue];
		3027 -> 3028;
	3020 [label="Update boolean QuincyDating",color=orange];
		3020 -> 3019;
	3119 [label="и как всё пошло наперекосяк, прежде чем у меня появился этот шанс",shape=box,color=blue];
		3119 -> 3038;
	3028 [label="а там, где я вырос? тебе не дают бесплатные возможности для этого. нет, тебе надо выбираться, чтобы добиться этого",shape=box,color=blue];
		3028 -> 3029;
	3019 [label="Update boolean IsDating",color=orange];
		3019 -> 3018;
	3038 [label="не надо быть гением, чтобы понять, что Его Величество — причина того, почему всё пошло не так в моей жизни. и почему я поклялся никогда больше никого так близко не подпускать",shape=box,color=blue];
		3038 -> 3035;
	3029 [label="а самый простой способ для кого-то вроде меня выбраться? армия. у них есть стипендии — гранты — чтобы платить солдатам за колледж",shape=box,color=blue];
		3029 -> 3032;
	3018 [label="Chat ends.",color=orange];
	3035 [label="итак",shape=box,color=blue];
		3035 -> 3036;
	3032 [label="так я решил, что пойду убивать ради них на пару лет, а потом пойду в бизнес-школу. на финансы или, может, MBA или что-то такое",shape=box,color=blue];
		3032 -> 3030;
	3036 [label="и по чистой случайности, броску костей, я оказался в том же полку, что и Его Величество. 3-й батальон, багровый дозор",shape=box,color=blue];
		3036 -> 3034;
	3030 [label="вернуться домой, устроить свою семью как следует, изменить что-то по-настоящему важное",shape=box,color=blue];
		3030 -> 3031;
	3034 [label="он уже был командиром, да? а я только что закончил академию",shape=box,color=blue];
		3034 -> 3039;
	3031 [label="но всё пошло наперекосяк, прежде чем у меня появился этот шанс",shape=box,color=blue];
		3031 -> 3033;
	3039 [label="и некоторое время я пытаюсь играть по правилам, быть хорошим маленьким солдатом. но по мере того, как я иду дальше... я понимаю, что колода всё ещё сложена против меня",shape=box,color=blue];
		3039 -> 3037;
	3033 [label="Update boolean QuincyArthur3",color=orange];
		3033 -> 3038;
	3037 [label="жизнь несправедлива. куда бы ты ни пошёл. кумовство. фаворитизм. предвзятость. повсюду. люди смотрят на меня свысока из-за того, откуда я",shape=box,color=blue];
		3037 -> 3044;
	3044 [label="из-за того, кем я являюсь",shape=box,color=blue];
		3044 -> 3041;
	3041 [label="так что я... начал глупеть. начал делать то, о чём сейчас жалею. начал срываться в тупых вещах. если они хотели забрать у меня? я забирал у них",shape=box,color=blue];
		3041 -> 3042;
	3042 [label="потому что если они не прикрывали меня, почему я должен был прикрывать их? так что я смотрел только за собой. и только за СОБОЙ, понял меня?",shape=box,color=blue];
		3042 -> 3040;
	3040 [label="я не крал ничего. не нарушал протокол. я был хорошим маленьким солдатом. но если ты когда-нибудь слышал фразу \"злонамеренное подчинение\", ты понимаешь мой вайб",shape=box,color=blue];
		3040 -> 3045;
	3045 [label="ни секунды в своей жизни я не собирался тратить на то, чтобы делать что-то выше или сверх того, что от меня требовали. я хотел отсидеть своё время и выйти с чеками",shape=box,color=blue];
		3045 -> 3049;
	3049 [label="потом всё пошло наперекосяк. мы на задании. я на наблюдении. вижу со своей позиции, что противники — оппозиция — внезапно начинают суетиться из-за нас. они знают, что мы там",shape=box,color=blue];
		3049 -> 3046;
	3046 [label="артур и остальные на поле, а у меня доля секунды, чтобы решить. я могу раскрыть свою позицию и открыть огонь по штурмующим противникам, чтобы дать Его Величеству и команде предупреждение и время уйти в безопасное место",shape=box,color=blue];
		3046 -> 3047;
	3047 [label="но если я это сделаю, мне точно крышка. гарантированно эти противники прижмут мою тупую задницу очень быстро. так что...",shape=box,color=blue];
		3047 -> 3051;
	3051 [label="я собираю свои вещи, передаю по рации, что нас раскусили... подумал, Его Величество и остальные уже трупы...",shape=box,color=blue];
		3051 -> 3050;
	3050 [label="я выхожу из комнаты, где прятался, и за углом натыкаюсь на дуло чьей-то винтовки",shape=box,color=blue];
		3050 -> 3048;
	3048 [label="не, чувак. они знали, что я там всё это время. они поняли, что я был там с самого начала",shape=box,color=blue];
		3048 -> 3054;
	3054 [label="меня вытаскивают на улицу. ставят на колени и упирают пистолет в затылок",shape=box,color=blue];
		3054 -> 3053;
	3053 [label="БАХ БАХ",shape=box,color=blue];
		3053 -> 3561;
	3561 [label="это чёртов артур. чёртов Его Величество, появляющийся из ниоткуда, чтобы спасти меня",shape=box,color=blue];
		3561 -> 3562;
	3562 [label="и я был ТАК ЧЁРТОВСКИ ЗОЛ на него за это. поднялся на ноги и тут же отчитал его",shape=box,color=blue];
		3562 -> 3055;
		3562 -> 3056;
