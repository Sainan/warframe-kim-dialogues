	3012 [label="но теперь это произойдёт. потому что теперь моя очередь рассказать тебе историю, которая заставит тебя меня ненавидеть",shape=box,color=blue];
		3012 -> 3014;
	3014 [label="потому что кто-то должен делать эту работу ПРАВИЛЬНО, и если это не будешь ты? Это снова ляжет на меня. Как всегда, чёрт возьми",shape=box,color=blue];
