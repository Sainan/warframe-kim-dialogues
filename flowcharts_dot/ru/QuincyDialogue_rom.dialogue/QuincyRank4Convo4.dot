	2323 [label="Крупная корпорация? Что ты имеешь в виду?",shape=box,color=red];
		2323 -> 2325;
	2324 [label="Корпорация? В смысле корпоративный?",shape=box,color=red];
		2324 -> 2326;
	2328 [label="Счастлив? Я его толком не знаю, Ку. Мы не тусуемся.",shape=box,color=red];
		2328 -> 2331;
	2327 [label="Почему ты спрашиваешь?",shape=box,color=red];
		2327 -> 2332;
