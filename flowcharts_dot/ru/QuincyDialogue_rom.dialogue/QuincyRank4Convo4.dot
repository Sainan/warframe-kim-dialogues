		2329 -> 2330;
	2325 [label="корпорация. корпоративный. таскающий пачки денег. денежный человек",shape=box,color=blue];
		2325 -> 2335;
		2325 -> 2334;
	2326 [label="да, ты знаешь. таскает пачки денег. финансист",shape=box,color=blue];
		2326 -> 2335;
		2326 -> 2334;
	2331 [label="да, но ты же с ним общаешься. ты слышишь, как он говорит, ты взаимодействуешь с людьми, с которыми он имеет дело",shape=box,color=blue];
		2331 -> 2333;
	2332 [label="потому что этот мир всегда строился на тех, кто имеет, и тех, кто не имеет, да? всегда так было, и я просто хочу знать, всегда ли так будет",shape=box,color=blue];
		2332 -> 2340;
		2332 -> 2338;
		2332 -> 2339;
	2330 [label="Chat ends.",color=orange];
	2335 [label="На самом деле, да. Парвос Грэнум, глава Корпуса.",shape=box,color=red];
		2335 -> 2337;
	2334 [label="Мне некогда это обсуждать, извини. [Завершить]",shape=box,color=red];
		2334 -> 2336;
	2333 [label="ты думаешь, он доволен своей жизнью? даже счастлив?",shape=box,color=blue];
		2333 -> 2340;
		2333 -> 2338;
		2333 -> 2339;
	2340 [label="Я не думаю, что деньги могут купить счастье.",shape=box,color=red];
		2340 -> 2341;
	2338 [label="Я думаю, люди, которые говорят, что деньги не покупают счастье, просто недостаточно креативны.",shape=box,color=red];
		2338 -> 2343;
	2339 [label="Похоже, он счастлив, насколько я могу судить. У него есть люди, которые поддерживают его по причинам, кажущимся не *только* из-за денег.",shape=box,color=red];
		2339 -> 2344;
	2337 [label="Update boolean QuincyParvos",color=orange];
		2337 -> 2333;
	2336 [label="Chat ends.",color=orange];
	2341 [label="ну тогда я скажу, что ты недостаточно стараешься, хаха",shape=box,color=blue];
		2341 -> 2342;
	2343 [label="ТОЧНО. вот именно. они просто не стараются достаточно, ржунимагу",shape=box,color=blue];
		2343 -> 2342;
	2344 [label="о да? рассказывай",shape=box,color=blue];
		2344 -> 2346;
		2344 -> 2345;
	2342 [label="а у него есть семья? люди, которые его поддерживают?",shape=box,color=blue];
		2342 -> 2346;
		2342 -> 2345;
	2346 [label="Есть одна женщина, Вала Глэриос. Изначально она была одной из его подчинённых. Но она пошла на дно вместе со своими кораблями, сражаясь до конца, громко крича.",shape=box,color=red];
		2346 -> 2347;
	2345 [label="У него есть сёстры, которых он тренирует и окружает себя ими. И я могу сказать, что он действительно ими гордится. Считает их семьёй.",shape=box,color=red];
		2345 -> 2349;
	2347 [label="Он открыл карман Бездны, который, ну, это долгая история, неважно. Он спас ей жизнь. Думаю, он действительно её ценит. Считает её сестрой.",shape=box,color=red];
		2347 -> 2348;
	2349 [label="Это немного смахивает на культ, если честно. Но что ты можешь сделать? Деньги такие.",shape=box,color=red];
		2349 -> 2351;
	2348 [label="И я думаю, что она смотрит на него как на семью в ответ.",shape=box,color=red];
		2348 -> 2353;
	2351 [label="деньги покупают лояльность, пока у тебя их достаточно. и нет культа старше, чем культ золота",shape=box,color=blue];
		2351 -> 2350;
		2351 -> 2352;
	2353 [label="никто не бывает абсолютно злым или абсолютно добрым, знаешь? похоже, этот парень знает, кто его банда, понял меня?",shape=box,color=blue];
		2353 -> 2354;
	2350 [label="Мне правда не нравится, как сильно ты похож на этого парня. В жизни есть нечто большее, чем деньги.",shape=box,color=red];
		2350 -> 2361;
	2352 [label="Вы двое точно бы сдружились. Слишком уж много общего.",shape=box,color=red];
		2352 -> 2361;
	2354 [label="у него есть ресурсы, чтобы заботиться о тех, кто ему дорог, и люди вокруг него это признают",shape=box,color=blue];
		2354 -> 2357;
		2354 -> 2358;
		2354 -> 2355;
		2354 -> 2356;
	2361 [label="я не говорю, что этот чувак тут герой, кузен. ржунимагу. в этом мире нет героев. я говорю, что у него есть ВОЗМОЖНОСТЬ быть СЧАСТЛИВЫМ и заботиться о тех, кто ему дорог",shape=box,color=blue];
		2361 -> 2362;
	2357 [label="Он делает то, что должен, чтобы выжить. Я могу это уважать. Даже если это обычно означает, что мы по разные стороны баррикад.",shape=box,color=red];
		2357 -> 2359;
	2358 [label="Он держит людей рядом, пока они приносят пользу. Уверен, как только они станут обузой, их выкинут.",shape=box,color=red];
		2358 -> 2361;
	2355 [label="Это не значит, что он не безжалостен и не груб. Я ему не доверяю, и его люди всегда встают у меня на пути.",shape=box,color=red];
		2355 -> 2361;
	2356 [label="Я вообще не согласен с его позицией насчёт того, чтобы выкачивать вселенную до последней капли. Я предпочитаю помогать тем, кто в этом нуждается, а не зацикливаться на жадности.",shape=box,color=red];
		2356 -> 2361;
	2362 [label="а для меня? это и есть мечта. всё устроено для меня, моих друзей и моей семьи. никто не остаётся без ничего. а чтобы это сделать? нужны БАБКИ",shape=box,color=blue];
		2362 -> 2365;
		2362 -> 2363;
		2362 -> 2364;
	2359 [label="+10 Chemistry",color=orange];
