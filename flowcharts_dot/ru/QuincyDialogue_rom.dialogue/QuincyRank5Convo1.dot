		2946 -> 2893;
	2995 [label="Но такова жизнь, не так ли? Ты делаешь выбор. И всегда задаёшься вопросом, правильный ли ты сделал выбор. Я знаю одно — в любом из миров они не выжили бы с Безразличием.",shape=box,color=red];
		2995 -> 2994;
	2985 [label="Я не знаю, жалею ли я о том, что не сделал это быстро для них. Иногда жалею. Иногда думаю... нет. Я всегда бы дал им шанс очнуться.",shape=box,color=red];
		2985 -> 2995;
	2988 [label="Но потом я вспоминаю всех детей, которые не смогли этого сделать, и оставили своих родителей гнить в клетках, пока их не спасли. Наблюдать, как они разрывают себя на части, как дикие, безумные животные. Я не знаю, что хуже.",shape=box,color=red];
		2988 -> 2990;
	2891 [label="Нет. Ты хочешь меня ненавидеть, чтобы оставаться одному, потому что быть одному безопасно. Потому что тогда никто не сможет тебя ранить.",shape=box,color=red];
