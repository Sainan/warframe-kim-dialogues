		2986 -> 2985;
	2989 [label="Иногда я думаю, каким монстром должен быть человек, чтобы убить собственных родителей. Чтобы смотреть в их лица, искажённые яростью и чудовищным голодом, и завершить их жизни.",shape=box,color=red];
