		1193 -> 1194;
		1193 -> 1195;
	1189 [label="серьёзно? не-а, для меня это мечта. стоять под светом? вся эта толпа, мужики и девчонки, все пускают слюни на меня? деньги катятся, тусовки каждую ночь?",shape=box,color=blue];
		1189 -> 1196;
	1191 [label="ТЫ ЧИТАЕШЬ МЕНЯ. вот это МЕЧТА. стоять под светом. вся эта толпа, мужики и девчонки, все пускают слюни на меня. деньги катятся, тусовки каждую ночь",shape=box,color=blue];
		1191 -> 1196;
