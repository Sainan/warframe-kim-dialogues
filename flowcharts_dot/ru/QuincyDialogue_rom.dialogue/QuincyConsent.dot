		3976 -> 3977;
	3977 [label="Нет! Нет. Артур живой. Я просто хотел поговорить с тобой о кое-чём и надеюсь, не поставит тебя в неловкое положение.",shape=box,color=red];
		3977 -> 3978;
	3978 [label="Я не хочу ставить тебя в ситуацию, в которой ты будешь чувствовать себя плохо. Так что если ты скажешь нет, это нормально. Мне важно, чтобы это было ясно.",shape=box,color=red];
		3978 -> 3979;
	3979 [label="То, что есть между нами, важно для меня. Очень важно. И оно настоящее. Я не хочу, чтобы были какие-то сомнения.",shape=box,color=red];
