		3981 -> 3983;
	3984 [label="Я хотел поговорить с тобой и получить твоё согласие, прежде чем зайдёт слишком далеко. Я не хочу, чтобы ты расстроился, и мы никогда раньше такое не обсуждали.",shape=box,color=red];
		3984 -> 3986;
	3983 [label="Я хотел поговорить с тобой и получить твоё согласие, прежде чем зайдёт слишком далеко. Я не хочу, чтобы ты расстроился, и мы никогда раньше такое не обсуждали.",shape=box,color=red];
		3983 -> 3985;
