		j3870760305 -> "Chat ends.";
	j3747046831 [label="Я хочу поговорить с тобой кое о чём и сначала убедиться, что ты в порядке.",shape=box,color=red];
		j3747046831 -> j3501266045;
	j3501266045 [label="Я не хочу, чтобы у тебя была мысль, что я лгу или как-то нечестно обращаюсь.",shape=box,color=red];
		j3501266045 -> j955854274;
	j955854274 [label="хаха, ну что там опять произошло",shape=box,color=blue];
		j955854274 -> j1100859259;
	j1100859259 [label="кого завалил, Его Вели4 уже труп?",shape=box,color=blue];
		j1100859259 -> j2474705971;
	j2474705971 [label="Нет! Нет. Артур живой. Я просто хотел поговорить с тобой о кое-чём и надеюсь, не поставит тебя в неловкое положение.",shape=box,color=red];
		j2474705971 -> j386286680;
	j386286680 [label="Я не хочу ставить тебя в ситуацию, в которой ты будешь чувствовать себя плохо. Так что если ты скажешь нет, это нормально. Мне важно, чтобы это было ясно.",shape=box,color=red];
		j386286680 -> j3545586881;
	j3545586881 [label="То, что есть между нами, важно для меня. Очень важно. И оно настоящее. Я не хочу, чтобы были какие-то сомнения.",shape=box,color=red];
		j3545586881 -> j1148984836;
	j1148984836 [label="Check boolean QuincyForgiven",color=orange];
		j1148984836 -> j817342936 [label=true,color=green];
		j1148984836 -> j4104365787 [label=false,color=brown];
	j817342936 [label="ооо чёрт, детка, ты мне щас хочешь сказать, что у тебя другой любовник в другом городе?",shape=box,color=blue];
		j817342936 -> j1003771404;
	j4104365787 [label="ооо чёрт, детка, ты мне щас хочешь сказать, что у тебя другая игра в другом городе?",shape=box,color=blue];
		j4104365787 -> j2650472236;
	j1003771404 [label="Я хотел поговорить с тобой и получить твоё согласие, прежде чем зайдёт слишком далеко. Я не хочу, чтобы ты расстроился, и мы никогда раньше такое не обсуждали.",shape=box,color=red];
		j1003771404 -> j4108194319;
	j2650472236 [label="Я хотел поговорить с тобой и получить твоё согласие, прежде чем зайдёт слишком далеко. Я не хочу, чтобы ты расстроился, и мы никогда раньше такое не обсуждали.",shape=box,color=red];
		j2650472236 -> j1042820952;
	j4108194319 [label="кто вообще сказал, что я расстроился? не, детка, я пытаюсь понять, как уговорить розоволосую меня подбросить хахаха",shape=box,color=blue];
		j4108194319 -> j2298802172;
	j1042820952 [label="не! не, респект тому, кто умеет играть",shape=box,color=blue];
		j1042820952 -> j1062555565;
	j2298802172 [label="не, ну по-честному, я понимаю. я знаю, как оно. иногда влюбляешься, а потом ещё раз, и это просто значит, что у тебя сердце умеет так жить, в этом нет позора",shape=box,color=blue];
		j2298802172 -> j368625126;
	j1062555565 [label="не, ну по-честному, я понимаю. я знаю, каково это. иногда влюбляешься, а потом влюбляешься ещё раз и это просто значит, что у тебя сердце умеет так жить, в этом нет позора",shape=box,color=blue];
		j1062555565 -> j4110293447;
	j368625126 [label="+20 Chemistry",color=orange];
		j368625126 -> j1571425878;
	j4110293447 [label="+20 Chemistry",color=orange];
		j4110293447 -> j1319598381;
	j1571425878 [label="если ты говоришь, что между нами всё ещё реально, я тебе верю",shape=box,color=blue];
		j1571425878 -> j345113995;
	j1319598381 [label="если ты говоришь, что между нами всё ещё в силе, я тебе верю",shape=box,color=blue];
		j1319598381 -> j345113995;
	j345113995 [label="только смотри мне, не начинай делать странные лица, когда смотришь на Гекса или на Круглый стол",shape=box,color=blue];
