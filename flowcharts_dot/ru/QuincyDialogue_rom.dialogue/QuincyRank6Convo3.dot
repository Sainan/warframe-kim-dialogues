		j4281908293 -> j2418322376;
	j3709986907 [label="Значит, в Скульптуры Аятан можно вставить Звёзды Аятан. Если так сделать, они начинают двигаться.",shape=box,color=red];
		j3709986907 -> j85676969;
	j2398300964 [label="Они выбирали молодых и красивых «Юванов» в качестве невольных носителей и использовали Куву, чтобы уничтожить сознание оригинального человека и заменить его своим.",shape=box,color=red];
		j2398300964 -> j3095163561;
	j1680835319 [label="Они также содержат чертежи варфреймов. Многие из них мы до сих пор продолжаем открывать.",shape=box,color=red];
		j1680835319 -> j1136308505;
	j2735359781 [label="Хорошая новость в том, что в будущем они нам пригодятся. Мы переплавляем их и используем для улучшения собственного вооружения.",shape=box,color=red];
