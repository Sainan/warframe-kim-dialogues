	1359 [label="+20 Chemistry",color=orange];
		1359 -> 1358;
	1361 [label="я как-то чувствую, что мне не стоит поворачиваться к ней спиной. должен ли я переживать, что она всё ещё работает на Энтрати?",shape=box,color=blue];
		1361 -> 1364;
		1361 -> 1363;
	1362 [label="Итак, насколько я могу судить, каваты, к которым относится Калимос, произошли от ваших «кошек», которые поменьше.",shape=box,color=red];
		1362 -> 1365;
	1363 [label="Думаю, Калимос устала от всего дерьма Энтрати, честно говоря. Как и многие другие.",shape=box,color=red];
		1363 -> 1369;
	1364 [label="Возможно? Я имею в виду, она же кават. Они всегда *немного* изворотливые, да? Хаха.",shape=box,color=red];
		1364 -> 1370;
	1358 [label="... да, ладно, это было смешно 6/10",shape=box,color=blue];
