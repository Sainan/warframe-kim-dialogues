		1374 -> 1376 [label=false,color=brown];
	1373 [label="она вела себя как милая и ласковая, мурлыкала, мурлыкала, мурлыкала, любила тебя, а потом, как только ты думал, что безопасен... КОГТИ В ЛИЦО, КОРЕШ",shape=box,color=blue];
		1373 -> 1380;
	1375 [label="она как те кавии, о которых лэтти мне рассказывала? она была в полной ярости из-за них, давно я не видел ее такой злой",shape=box,color=blue];
		1375 -> 1378;
		1375 -> 1379;
	1376 [label="Я имею в виду... Энтрати уже создавал животных с человеческим интеллектом. Но обычно они разговаривают.",shape=box,color=red];
		1376 -> 1377;
	1380 [label="кошки. они всегда на волоске от того, чтобы выцарапать тебе глаза",shape=box,color=blue];
		1380 -> 1382;
		1380 -> 1383;
	1378 [label="Думаю, она умна как мы. Просто делает вид, что всё нормально, и я не собираюсь с ней это обсуждать, потому что мне нравится мое лицо.",shape=box,color=red];
		1378 -> 1381;
	1379 [label="Я уверен, если бы Калимос была настолько умной, она бы уже дала нам знать... правда?",shape=box,color=red];
		1379 -> 1381;
	1377 [label="Их называют Кавия. Но я уверен, если бы Калимос была одной из них, она бы уже дала нам знать... правда?",shape=box,color=red];
		1377 -> 1381;
	1382 [label="Я люблю каватов. Умные, грациозные. Они любят тебя, потому что *они* так решили. Кубрау - собаки, извиняй - они гораздо больше запрограммированы на такое поведение.",shape=box,color=red];
		1382 -> 1385;
	1383 [label="Я с тобой. Я тоже такой кубрау — извиняй, собачник.",shape=box,color=red];
		1383 -> 1384;
	1381 [label="хаха, я могу рассказать тебе истории о своей бывшей",shape=box,color=blue];
		1381 -> 1389;
	1385 [label="кошки всегда что-то замышляют",shape=box,color=blue];
		1385 -> 1386;
	1384 [label="Просто всегда рады видеть тебя. Просто хотят любви",shape=box,color=blue];
		1384 -> 1385;
	1389 [label="она всегда играла в эту кокетливую игру. мур-мур. а потом, когда ты меньше всего этого ожидаешь?.. УБИЙСТВО. все недооценивали её. включая меня",shape=box,color=blue];
		1389 -> 1390;
	1386 [label="и мне кажется, что эта монстр-кошка может иметь хорошие намерения сейчас, но она что-то замышляет",shape=box,color=blue];
		1386 -> 1387;
		1386 -> 1388;
	1390 [label="никогда не сделаю эту ошибку дважды. ни с человеком, ни с гигантской монстр-кошкой",shape=box,color=blue];
		1390 -> 1391;
	1387 [label="Не знаю. Я знаю, как это быть использованным и брошенным. Если она хочет остаться? У неё есть теплое место и столько почесываний от меня, сколько захочет.",shape=box,color=red];
		1387 -> 1397;
	1388 [label="Мудрый совет. Спасибо.",shape=box,color=red];
		1388 -> 1394;
	1391 [label="я не собираюсь поворачивать спину к этой штуке, хах, тебе стоит тоже держать глаза открытыми",shape=box,color=blue];
