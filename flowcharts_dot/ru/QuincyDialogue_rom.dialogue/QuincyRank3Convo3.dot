		1370 -> 1371;
	1360 [label="Chat ends.",color=orange];
	1366 [label="но мне стоит волноваться, что она всё ещё работает на энтрати",shape=box,color=blue];
		1366 -> 1367;
		1366 -> 1368;
	1372 [label="типа, мы говорим о человеческом интеллекте? разберись со мной",shape=box,color=blue];
		1372 -> 1374;
	1371 [label="моя бабушка иногда оставляла меня с подругой. Милая старушка. У нее была кошка, которая была СОВЕРШЕННО чокнутой",shape=box,color=blue];
		1371 -> 1373;
	1367 [label="Я имею в виду, «кошки» всегда немного изворотливы, да? Хаха.",shape=box,color=red];
		1367 -> 1370;
