		1890 -> 1891;
	1891 [label="но я извинился, что вёл себя с ним как с придурком всё это время",shape=box,color=blue];
		1891 -> 1895;
	1895 [label="сказал, что он тоже принадлежит нам так же, как и все остальные. что у меня просто свой стиль, как и у него, и это просто кто мы есть, понимаешь?",shape=box,color=blue];
