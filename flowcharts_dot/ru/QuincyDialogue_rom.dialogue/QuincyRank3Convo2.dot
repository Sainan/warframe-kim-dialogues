	1312 [label="Маленькими шагами. По одному. Одна вуаль за раз. Один город за раз. Одна планета за раз.",shape=box,color=red];
		1312 -> 1314;
	1313 [label="Я не делал это в одиночку. Даже такие враги, как Корпус или Гринир, поняли, что у нас есть общий враг. Даже отец Эрры мне помог. Хунхау.",shape=box,color=red];
		1313 -> 1315;
	1314 [label="всегда так и было. во время войны все забывают о тех, кто на передовой. думают, что это люди в кабинетах делают все решающие шаги",shape=box,color=blue];
		1314 -> 1316;
	1315 [label="чёрт. его собственный отец. это жестко... война иногда так портит семьи, да? но думаю, теперь все забыто, да? вы все снова хлопаете друг другу, как будто ничего не было",shape=box,color=blue];
		1315 -> 1317;
