		2402 -> 2403;
	2409 [label="я столько дерьма выливал на свою тётю за то, что она таскала меня в церковь каждое воскресенье, говорила, что луа и сол — это просто пустая трата времени",shape=box,color=blue];
		2409 -> 2410;
