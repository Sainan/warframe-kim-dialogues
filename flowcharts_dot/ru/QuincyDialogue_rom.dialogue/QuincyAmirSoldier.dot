		1871 -> 1877;
	1877 [label="затем он... рассказал мне о тех кошмарах, которые ему снятся",shape=box,color=blue];
		1877 -> 1874;
	1874 [label="и как он чувствует себя, как будто не принадлежит группе, потому что он не солдат",shape=box,color=blue];
		1874 -> 1872;
	1872 [label="так что я рассказал ему, как ужасно мне было, когда я впервые убил как солдат",shape=box,color=blue];
		1872 -> 1873;
	1873 [label="как часто я мучился от кошмаров из-за этого, хуже, чем когда я был маленьким",shape=box,color=blue];
		1873 -> 1875;
	1875 [label="но я извинился, что вёл себя с ним как с придурком всё это время",shape=box,color=blue];
		1875 -> 1876;
	1876 [label="сказал, что он тоже принадлежит нам так же, как и все остальные. что у меня просто свой стиль, как и у него, и это просто кто мы есть, понимаешь?",shape=box,color=blue];
