		1859 -> 1860;
	1860 [label="одно дело, когда ты в разгаре сражения... какой-то ублюдок идёт к тебе с оружием или ножом или чем-то еще...",shape=box,color=blue];
		1860 -> 1861;
	1861 [label="совсем другое, когда ты на крыше, в 300 ярдах, а они даже не знают, что ты там...",shape=box,color=blue];
		1861 -> 1864;
	1864 [label="и у тебя есть время *думать* о них. кто они. почему они там. есть ли у них семья? дети?",shape=box,color=blue];
		1864 -> 1862;
	1862 [label="и... тогда ты нажимаешь на спуск. БААХ",shape=box,color=blue];
