		1000 -> 1001;
		1000 -> 1002;
	1025 [label="затем я поворачиваюсь и продаю это людям, которые всё ещё думают, что это сделает их жизнь немного менее дерьмовой. Они начинают видеть в нас молодых Локсли, дающих нуждающимся",shape=box,color=blue];
