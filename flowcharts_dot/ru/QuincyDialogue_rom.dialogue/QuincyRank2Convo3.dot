		931 -> 932;
	919 [label="Мне пришлось сражаться, в основном в одиночку, чтобы освободить невинных жителей Изначальной Системы, которым промыли мозги, чтобы они попытались восстать и сражаться с двумя безумцами, стоявшими у власти.",shape=box,color=red];
		919 -> 918;
	920 [label="Это было первое место, где я встретился с Равнодушием. и не последнее. но именно там Человек в Стене отнял *всё* у меня.",shape=box,color=red];
		920 -> 922;
	921 [label="Кстати, он был порождением моих собственных воспоминаний, когда Бездна вторглась в мой разум и вытащила обрывки из книги сказок.",shape=box,color=red];
		921 -> 923;
