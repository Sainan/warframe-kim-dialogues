		2667 -> 2673;
	2664 [label="Мы друзья, К. Очевидно, ты не хочешь рассказать мне, что случилось. Ты должен доверять мне такие вещи.",shape=box,color=red];
		2664 -> 2670;
	2668 [label="слушай, я дам тебе поблажку, потому что очевидно, что у тебя было не так много отношений в жизни, ЕСЛИ ВООБЩЕ БЫЛИ",shape=box,color=blue];
