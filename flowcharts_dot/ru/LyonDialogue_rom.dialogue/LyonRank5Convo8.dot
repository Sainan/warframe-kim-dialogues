	"Chat ends." [color=orange];
	j1198593860 [label="Должен сказать, что обстановка в этом фальшивом склепе значительно улучшилась. Или, возможно, это просто моё восприятие происходящего. Я был... рассеянный в последнее время.",shape=box,color=blue];
		j1198593860 -> j1890799654;
	j2028328896 [label="Должен сказать, что в этом фальшивом склепе дела обстоят намного лучше. От тебя он получил выход для его разочарований, не так ли?",shape=box,color=blue];
		j2028328896 -> j629364467;
	j2056488865 [label="О тебя была дана ему своего рода гарантию. Цель. И за это я не могу быть более благодарен. И я знаю, что то же самое относится и к Мари.",shape=box,color=blue];
		j2056488865 -> j609672971;
	j3617874954 [label="Боюсь, мало что изменилось. Я думаю, что это бедное животное скоро разорвёт себя на части от тоски.",shape=box,color=blue];
		j3617874954 -> j969044242;
	j1890799654 [label="Evaluate expressions",color=orange];
		j1890799654 -> j322793976 [label="RoatheRedeemed",color=purple];
		j1890799654 -> j1531792629 [label="RoatheVillain",color=purple];
		j1890799654 -> j1386208710 [label="false",color=purple];
	j629364467 [label="Прости меня. Это пронизано намеками, которые я не хотел подразумевать. Я просто хотел сказать, что ты довольно успешно даешь ему советы.",shape=box,color=blue];
		j629364467 -> j2566241704;
	j609672971 [label="+5 Chemistry",color=orange];
		j609672971 -> j2424672543;
	j969044242 [label="Если Мари не подтолкнёт его к этому первой.",shape=box,color=blue];
		j969044242 -> "Chat ends.";
	j322793976 [label="Ты научил его способу саморефлексии. Направлению. И за это я не могу быть более благодарен. И я знаю, что то же самое относится и к Мари.",shape=box,color=blue];
		j322793976 -> j2407451877;
	j1531792629 [label="О тебя была дана ему своего рода гарантию. Цель. И за это я не могу быть более благодарен. И я знаю, что то же самое относится и к Мари.",shape=box,color=blue];
		j1531792629 -> j2407451877;
	j1386208710 [label="Я не знаю, как сложится его судьба. Я надеюсь, что мы сможем решить это. Потому что я беспокоюсь о том, во что он превратится, если слишком долго будет предоставлен самому себе.",shape=box,color=blue];
		j1386208710 -> "Chat ends.";
	j2566241704 [label="Я. Собираюсь просто отойти от этого компьютера на остаток вечера.",shape=box,color=blue];
		j2566241704 -> j3571019910;
	j2424672543 [label="Нам есть за что быть благодарными, когда речь заходит о тебе.",shape=box,color=blue];
