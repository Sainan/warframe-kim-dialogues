digraph {
	1485 [label="LyonRank5Convo2 begins.",color=orange];
		1485 -> 1486;
	1486 [label="Evaluate expressions",color=orange];
		1486 -> 1487 [label="LyonPainOff",color=purple];
		1486 -> 1491 [label="LyonBackstory3a",color=purple];
		1486 -> 1490 [label="LyonBackstory3b",color=purple];
		1486 -> 1489 [label="LyonBackstory2",color=purple];
		1486 -> 1489 [label="LyonBackstory1",color=purple];
		1486 -> 1488 [label="false",color=purple];
	1487 [label="+20 Chemistry",color=orange];
		1487 -> 490;
	1491 [label="Друг мой, ты был со мной терпелив и добрее, чем заслуживал. Знаю, тебя заинтересовала эта часть моей истории – о ночи, когда Луа была в самом тёмном состоянии.",shape=box,color=blue];
		1491 -> 1493;
	1490 [label="Друг мой, ты был терпелив со мной. Знаю, тебя заинтересовала эта часть моей истории – о ночи, когда Луа была в самом тёмном состоянии.",shape=box,color=blue];
		1490 -> 1493;
	1489 [label="Мой друг, тебе было интересно узнать о моём прошлом. И я знаю, тебе должно быть интересно услышать эту часть моей истории — о той ночи, когда Луа была в своей самой тёмном состоянии.",shape=box,color=blue];
		1489 -> 1493;
	1488 [label="Мой друг, я знаю, тебе, должно быть, интересно услышать мою историю и о той ночи, когда Луа была в самой тьме.",shape=box,color=blue];
		1488 -> 1493;
	490 [label="[Разговор пропущен из-за ранее установленного предупреждения.]",shape=box,color=blue];
		490 -> 1492;
	1493 [label="Это история, которую я поклялся никогда не рассказывать. О ней знает только Мари, прочитавшая её в моих дневниках. А теперь я расскажу её тебе.",shape=box,color=blue];
		1493 -> 1495;
	1492 [label="Update boolean LyonConfession1",color=orange];
		1492 -> 1494;
	1495 [label="Как только я начну, я не смогу остановиться, ведь потом мне не удастся начать снова. Так что прости меня, если я не позволю тебе задавать мне вопросы.",shape=box,color=blue];
		1495 -> 1499;
		1495 -> 1498;
		1495 -> 1497;
		1495 -> 1496;
	1494 [label="Chat ends.",color=orange];
	1499 [label="Конечно.",shape=box,color=red];
		1499 -> 1503;
	1498 [label="[Позволь ему продолжить.]",shape=box,color=red];
		1498 -> 1502;
	1497 [label="[Внимание: обсуждение о членовредительстве и жестком обращении с детьми. Нажмите здесь, чтобы закончить. Это не приведёт к потере «Симпатии» с Лионом.]",shape=box,color=red];
		1497 -> 1501;
	1496 [label="[Конец.]",shape=box,color=red];
		1496 -> 1500;
	1503 [label="Спасибо.",shape=box,color=blue];
		1503 -> 1507;
	1502 [label="+5 Chemistry",color=orange];
		1502 -> 1503;
	1501 [label="Check boolean LyonSpeech",color=orange];
		1501 -> 1505 [label=true,color=green];
		1501 -> 1506 [label=false,color=brown];
	1500 [label="Update boolean LyonConfessionFail",color=orange];
		1500 -> 1504;
	1507 [label="Evaluate expressions",color=orange];
		1507 -> 1511 [label="LyonBackstory3a",color=purple];
		1507 -> 1511 [label="LyonBackstory3b",color=purple];
		1507 -> 1510 [label="false",color=purple];
	1505 [label="+20 Chemistry",color=orange];
		1505 -> 1508;
	1506 [label="Если ты считаешь себя трусом, сделав этот выбор, умоляю тебя – не делай этого. Ибо это боль, с которой тебе не справиться. Она моя. Тебе не хотелось терпеть этот момент.",shape=box,color=blue];
		1506 -> 1509;
	1504 [label="Chat ends.",color=orange];
	1511 [label="Мы говорили о моей семье. О времени, проведённом на ферме, где я вырос. О видениях, которые меня преследовали и доводили до насилия.",shape=box,color=blue];
		1511 -> 1515;
	1510 [label="Я знаю, что не рассказал тебе много о тех, кто меня воспитал. И, боюсь, на то есть веская причина.",shape=box,color=blue];
		1510 -> 1514;
	1508 [label="Update boolean LyonConfession1",color=orange];
		1508 -> 1512;
	1509 [label="Это механическое приспособление, за которым мы сидим, создаёт впечатление скрытой безличности. Мы словно защищённы от любого вреда, который может причинить нам другой человек, какими бы словами он нам ни писал.",shape=box,color=blue];
		1509 -> 1513;
	1515 [label="Я рассказывал тебе о голосах, которые я слышал, шепчущих мне, зовущих меня из других комнат. Иногда казалось, будто они произносят моё имя -",shape=box,color=blue];
		1515 -> 1518;
	1514 [label="Моя мать... считала мои видения происками дьявола. И стремилась выбить их из меня розгой. Часто до тех пор, пока я уже не мог стоять на ногах.",shape=box,color=blue];
		1514 -> 1517;
	1512 [label="Chat ends.",color=orange];
	1513 [label="Я бы, пожалуй, утверждал обратное - обнаженные от тех доспехов, что мы надеваем в будничных обстоятельствах общения, мы оказываемся лишены того, что могло бы нас защитить.",shape=box,color=blue];
		1513 -> 1516;
	1518 [label="Иногда они звучали как что-то совершенно невнятное. Неразборчивая хрипота или дьявольская речь.",shape=box,color=blue];
		1518 -> 1521;
	1517 [label="А мой отец? Что ж. Как бы жестока ни была моя мать, отец был хуже. Я избавлю тебя от подробностей.",shape=box,color=blue];
		1517 -> 1520;
	1516 [label="Поэтому в подобных ситуациях... я прекрасно понимаю, что выпускаю стрелу, которая может попасть не в готового к бою солдата, а в яремную вену ничего не подозревающего оленя в чаще леса.",shape=box,color=blue];
		1516 -> 1519;
	1521 [label="Поначалу этот бессвязный бред этих голосов пугал меня до дрожи. Я умолял их обрести смысл. Молил Луа, чтобы её духи сказали мне, чего они хотят от меня.",shape=box,color=blue];
		1521 -> 1524;
	1520 [label="Но их жестокость не оставалась без ответа. Мои видения делали меня трудным соперником - особенно когда я вырос, когда стал выше и крепче даже моего отца.",shape=box,color=blue];
		1520 -> 1523;
	1519 [label="И потому я оставлю тебя вот с чем:",shape=box,color=blue];
		1519 -> 1522;
	1524 [label="Но когда я начал понимать, чего они желали - я пожалел о том, о чём так отчаянно молился. Ибо теперь я знал, какие деяния они желали, чтобы я творил ради них.",shape=box,color=blue];
		1524 -> 1526;
	1523 [label="И эти видения часто принимали форму голосов. Иногда казалось, что они зовут меня по имени -",shape=box,color=blue];
		1523 -> 1518;
	1522 [label="Мы должны напоминать себе, как найти в себе силы поднять другого человека на ноги, даже когда едва способны подняться сами.",shape=box,color=blue];
		1522 -> 1525;
	1526 [label="И, какую ужасную цену им пришлось бы заплатить.",shape=box,color=blue];
		1526 -> 1528;
	1525 [label="В этом и есть истинный смысл истории.",shape=box,color=blue];
		1525 -> 1527;
	1528 [label="Не пойми меня превратно. Ни к отцу, ни к матери я не питал любви. Вся та семейная преданность, которую я мог к ним испытывать, давно исчезла под чередой синяков и шрамов.",shape=box,color=blue];
		1528 -> 1530;
	1527 [label="+20 Chemistry",color=orange];
		1527 -> 1529;
	1530 [label="Но то, что они велели мне сделать ради них... И то, к чему толкали меня в ту самую тёмную из ночей...?",shape=box,color=blue];
		1530 -> 1532;
	1529 [label="Будь здоров, Скиталец. Мы ещё поговорим.",shape=box,color=blue];
		1529 -> 1531;
	1532 [label="Я был едва ли больше чем мальчишкой - вряд ли даже юношей. Может, мне было шестнадцать лет? Восемнадцать? Сначала я решил, что это ещё один чудовищный кошмар - исковерканный сон.",shape=box,color=blue];
		1532 -> 1534;
	1531 [label="-Ф. Лион Аллард",shape=box,color=blue];
		1531 -> 1533;
	1534 [label="Фигуры стояли вокруг меня, истощённые, искаженные облики, сотканные из одной лишь тени и злобы.",shape=box,color=blue];
		1534 -> 1536;
	1533 [label="Update boolean LyonConfession1",color=orange];
		1533 -> 1535;
	1536 [label="Издевались надо мной, требовали сделать то, что должно быть сделано - ведь если те, кто якобы любит меня, желают моей плоти, то почему я не должен, в ответ, желать их...",shape=box,color=blue];
		1536 -> 1537;
	1535 [label="Chat ends.",color=orange];
	1537 [label="Когда я вырвался из того сна - или, возможно, я и не спал, точно не знаю, я держал в руке охотничий нож. И стоял у двери в комнату родителей.",shape=box,color=blue];
		1537 -> 1538;
	1538 [label="Луна была новой. Облака плотными. Не было ни малейшего проблеска света, чтобы что-то разглядеть. Тьма была кромешной. ",shape=box,color=blue];
		1538 -> 1539;
	1539 [label="Луа оставила меня.",shape=box,color=blue];
		1539 -> 1540;
	1540 [label="Я не смог ответить на зов голосов. Я не мог отдать им души матери и отца.",shape=box,color=blue];
		1540 -> 1541;
	1541 [label="Я бежал в пустую ночь. В густые леса, где ветви рвали мою голую кожу, хотя боль меня ничуть не волновала.",shape=box,color=blue];
		1541 -> 1542;
	1542 [label="Я бежал, пока ноги не подкосились, я не мог нести меня дальше. Возможно, я плакал, я не знаю.",shape=box,color=blue];
		1542 -> 1543;
	1543 [label="Но их облики последовали за мной. И они продолжали шептаться о крови.",shape=box,color=blue];
		1543 -> 1544;
	1544 [label="Я надеялся, что если я их больше не увижу, они в конце концов исчезнут... когда я вонзил этот нож себе в глазницу...",shape=box,color=blue];
		1544 -> 1545;
	1545 [label="Жаль, что я потерял сознание и не смог выполнить задание. Теперь я никогда не узнаю.",shape=box,color=blue];
		1545 -> 1546;
	1546 [label="Очнулся я уже в местном приходе Луа. Меня нашёл брат и перевязал мои раны. Он спросил, от чего я бежал.",shape=box,color=blue];
		1546 -> 1547;
	1547 [label="Я был вне себя. Я не мог лгать ему. Я во всём признался - в видениях, в том, что они мне велели сделать. Я ожидал осуждения.",shape=box,color=blue];
		1547 -> 1548;
	1548 [label="Когда я закончил, он лишь улыбнулся с понимающей грустью и вложил мне в ладонь амулет Луа. «Она и благословение, и проклятие, сын мой».",shape=box,color=blue];
		1548 -> 1549;
	1549 [label="Он отправил меня в собор в Cité de la Lumière. Там я и оставался, пока меня не нашёл Энтрати...",shape=box,color=blue];
		1549 -> 1550;
	1550 [label="Вот... теперь ты знаешь.",shape=box,color=blue];
		1550 -> 1551;
	1551 [label="И... теперь мне необходимо идти.",shape=box,color=blue];
		1551 -> 1552;
	1552 [label="Update boolean LyonConfession1",color=orange];
		1552 -> 1553;
	1553 [label="+20 Chemistry",color=orange];
		1553 -> 1554;
	1554 [label="- Лион",shape=box,color=blue];
		1554 -> 1555;
	1555 [label="Chat ends.",color=orange];
}