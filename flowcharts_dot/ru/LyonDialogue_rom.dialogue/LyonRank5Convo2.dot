digraph {
	graph [fontname="Roboto Condensed"];
	node [fontname="Roboto Condensed"];
	edge [fontname="Roboto Condensed"];

	"LyonRank5Convo2 begins." [color=orange];
		"LyonRank5Convo2 begins." -> j680575522;
	j680575522 [label="Evaluate expressions",color=orange];
		j680575522 -> j771903054 [label="LyonPainOff",color=purple];
		j680575522 -> j2221679493 [label="LyonBackstory3a",color=purple];
		j680575522 -> j3107046375 [label="LyonBackstory3b",color=purple];
		j680575522 -> j95183477 [label="LyonBackstory2",color=purple];
		j680575522 -> j95183477 [label="LyonBackstory1",color=purple];
		j680575522 -> j590751826 [label="false",color=purple];
	j771903054 [label="+20 Chemistry",color=orange];
		j771903054 -> j2376068732;
	j2221679493 [label="Друг мой, ты был со мной терпелив и добрее, чем заслуживал. Знаю, тебя заинтересовала эта часть моей истории – о ночи, когда Луа была в самом тёмном состоянии.",shape=box,color=blue];
		j2221679493 -> j3095327465;
	j3107046375 [label="Друг мой, ты был терпелив со мной. Знаю, тебя заинтересовала эта часть моей истории – о ночи, когда Луа была в самом тёмном состоянии.",shape=box,color=blue];
		j3107046375 -> j3095327465;
	j95183477 [label="Мой друг, тебе было интересно узнать о моём прошлом. И я знаю, тебе должно быть интересно услышать эту часть моей истории — о той ночи, когда Луа была в своей самой тёмном состоянии.",shape=box,color=blue];
		j95183477 -> j3095327465;
	j590751826 [label="Мой друг, я знаю, тебе, должно быть, интересно услышать мою историю и о той ночи, когда Луа была в самой тьме.",shape=box,color=blue];
		j590751826 -> j3095327465;
	j2376068732 [label="[Разговор пропущен из-за ранее установленного предупреждения.]",shape=box,color=blue];
		j2376068732 -> j370687875;
	j3095327465 [label="Это история, которую я поклялся никогда не рассказывать. О ней знает только Мари, прочитавшая её в моих дневниках. А теперь я расскажу её тебе.",shape=box,color=blue];
		j3095327465 -> j3007229479;
	j370687875 [label="Boolean LyonConfession1 is now true.",color=orange];
		j370687875 -> "Chat ends.";
	j3007229479 [label="Как только я начну, я не смогу остановиться, ведь потом мне не удастся начать снова. Так что прости меня, если я не позволю тебе задавать мне вопросы.",shape=box,color=blue];
		j3007229479 -> j3415286097;
		j3007229479 -> j3188572741;
		j3007229479 -> j3189386059;
		j3007229479 -> j697320010;
	"Chat ends." [color=orange];
	j3415286097 [label="Конечно.",shape=box,color=red];
		j3415286097 -> j1501508141;
	j3188572741 [label="[Позволь ему продолжить.]",shape=box,color=red];
		j3188572741 -> j1861345704;
	j3189386059 [label="[Внимание: обсуждение о членовредительстве и жестком обращении с детьми. Нажмите здесь, чтобы закончить. Это не приведёт к потере «Симпатии» с Лионом.]",shape=box,color=red];
		j3189386059 -> j784838610;
	j697320010 [label="[Конец.]",shape=box,color=red];
		j697320010 -> j3856020424;
	j1501508141 [label="Спасибо.",shape=box,color=blue];
		j1501508141 -> j141195667;
	j1861345704 [label="+5 Chemistry",color=orange];
		j1861345704 -> j1501508141;
	j784838610 [label="Check boolean LyonSpeech",color=orange];
		j784838610 -> j3342655806 [label=true,color=green];
		j784838610 -> j2478800512 [label=false,color=brown];
	j3856020424 [label="Boolean LyonConfessionFail is now true.",color=orange];
		j3856020424 -> "Chat ends.";
	j141195667 [label="Evaluate expressions",color=orange];
		j141195667 -> j2733756207 [label="LyonBackstory3a",color=purple];
		j141195667 -> j2733756207 [label="LyonBackstory3b",color=purple];
		j141195667 -> j3300430401 [label="false",color=purple];
	j3342655806 [label="+20 Chemistry",color=orange];
		j3342655806 -> j370687875;
	j2478800512 [label="Если ты считаешь себя трусом, сделав этот выбор, умоляю тебя – не делай этого. Ибо это боль, с которой тебе не справиться. Она моя. Тебе не хотелось терпеть этот момент.",shape=box,color=blue];
		j2478800512 -> j1385322679;
	j2733756207 [label="Мы говорили о моей семье. О времени, проведённом на ферме, где я вырос. О видениях, которые меня преследовали и доводили до насилия.",shape=box,color=blue];
		j2733756207 -> j3091635800;
	j3300430401 [label="Я знаю, что не рассказал тебе много о тех, кто меня воспитал. И, боюсь, на то есть веская причина.",shape=box,color=blue];
		j3300430401 -> j2997963160;
	j1385322679 [label="Это механическое приспособление, за которым мы сидим, создаёт впечатление скрытой безличности. Мы словно защищённы от любого вреда, который может причинить нам другой человек, какими бы словами он нам ни писал.",shape=box,color=blue];
		j1385322679 -> j222740211;
	j3091635800 [label="Я рассказывал тебе о голосах, которые я слышал, шепчущих мне, зовущих меня из других комнат. Иногда казалось, будто они произносят моё имя -",shape=box,color=blue];
		j3091635800 -> j2643358235;
	j2997963160 [label="Моя мать... считала мои видения происками дьявола. И стремилась выбить их из меня розгой. Часто до тех пор, пока я уже не мог стоять на ногах.",shape=box,color=blue];
		j2997963160 -> j3279067364;
	j222740211 [label="Я бы, пожалуй, утверждал обратное - обнаженные от тех доспехов, что мы надеваем в будничных обстоятельствах общения, мы оказываемся лишены того, что могло бы нас защитить.",shape=box,color=blue];
		j222740211 -> j3487186797;
	j2643358235 [label="Иногда они звучали как что-то совершенно невнятное. Неразборчивая хрипота или дьявольская речь.",shape=box,color=blue];
		j2643358235 -> j4023434584;
	j3279067364 [label="А мой отец? Что ж. Как бы жестока ни была моя мать, отец был хуже. Я избавлю тебя от подробностей.",shape=box,color=blue];
		j3279067364 -> j1921420395;
	j3487186797 [label="Поэтому в подобных ситуациях... я прекрасно понимаю, что выпускаю стрелу, которая может попасть не в готового к бою солдата, а в яремную вену ничего не подозревающего оленя в чаще леса.",shape=box,color=blue];
		j3487186797 -> j2530183724;
	j4023434584 [label="Поначалу этот бессвязный бред этих голосов пугал меня до дрожи. Я умолял их обрести смысл. Молил Луа, чтобы её духи сказали мне, чего они хотят от меня.",shape=box,color=blue];
		j4023434584 -> j3823468676;
	j1921420395 [label="Но их жестокость не оставалась без ответа. Мои видения делали меня трудным соперником - особенно когда я вырос, когда стал выше и крепче даже моего отца.",shape=box,color=blue];
		j1921420395 -> j1302847975;
	j2530183724 [label="И потому я оставлю тебя вот с чем:",shape=box,color=blue];
		j2530183724 -> j3474647352;
	j3823468676 [label="Но когда я начал понимать, чего они желали - я пожалел о том, о чём так отчаянно молился. Ибо теперь я знал, какие деяния они желали, чтобы я творил ради них.",shape=box,color=blue];
		j3823468676 -> j1078796834;
	j1302847975 [label="И эти видения часто принимали форму голосов. Иногда казалось, что они зовут меня по имени -",shape=box,color=blue];
		j1302847975 -> j2643358235;
	j3474647352 [label="Мы должны напоминать себе, как найти в себе силы поднять другого человека на ноги, даже когда едва способны подняться сами.",shape=box,color=blue];
		j3474647352 -> j4086050990;
	j1078796834 [label="И, какую ужасную цену им пришлось бы заплатить.",shape=box,color=blue];
		j1078796834 -> j2030347749;
	j4086050990 [label="В этом и есть истинный смысл истории.",shape=box,color=blue];
		j4086050990 -> j3023753997;
	j2030347749 [label="Не пойми меня превратно. Ни к отцу, ни к матери я не питал любви. Вся та семейная преданность, которую я мог к ним испытывать, давно исчезла под чередой синяков и шрамов.",shape=box,color=blue];
		j2030347749 -> j1703893576;
	j3023753997 [label="+20 Chemistry",color=orange];
		j3023753997 -> j1834651304;
	j1703893576 [label="Но то, что они велели мне сделать ради них... И то, к чему толкали меня в ту самую тёмную из ночей...?",shape=box,color=blue];
		j1703893576 -> j889725295;
	j1834651304 [label="Будь здоров, Скиталец. Мы ещё поговорим.",shape=box,color=blue];
		j1834651304 -> j3260858017;
	j889725295 [label="Я был едва ли больше чем мальчишкой - вряд ли даже юношей. Может, мне было шестнадцать лет? Восемнадцать? Сначала я решил, что это ещё один чудовищный кошмар - исковерканный сон.",shape=box,color=blue];
		j889725295 -> j2940022392;
	j3260858017 [label="-Ф. Лион Аллард",shape=box,color=blue];
		j3260858017 -> j370687875;
	j2940022392 [label="Фигуры стояли вокруг меня, истощённые, искаженные облики, сотканные из одной лишь тени и злобы.",shape=box,color=blue];
		j2940022392 -> j2936001222;
	j2936001222 [label="Издевались надо мной, требовали сделать то, что должно быть сделано - ведь если те, кто якобы любит меня, желают моей плоти, то почему я не должен, в ответ, желать их...",shape=box,color=blue];
		j2936001222 -> j2710639679;
	j2710639679 [label="Когда я вырвался из того сна - или, возможно, я и не спал, точно не знаю, я держал в руке охотничий нож. И стоял у двери в комнату родителей.",shape=box,color=blue];
		j2710639679 -> j2740264755;
	j2740264755 [label="Луна была новой. Облака плотными. Не было ни малейшего проблеска света, чтобы что-то разглядеть. Тьма была кромешной. ",shape=box,color=blue];
		j2740264755 -> j341844182;
	j341844182 [label="Луа оставила меня.",shape=box,color=blue];
		j341844182 -> j4278470908;
	j4278470908 [label="Я не смог ответить на зов голосов. Я не мог отдать им души матери и отца.",shape=box,color=blue];
		j4278470908 -> j2777262740;
	j2777262740 [label="Я бежал в пустую ночь. В густые леса, где ветви рвали мою голую кожу, хотя боль меня ничуть не волновала.",shape=box,color=blue];
		j2777262740 -> j3663744054;
	j3663744054 [label="Я бежал, пока ноги не подкосились, я не мог нести меня дальше. Возможно, я плакал, я не знаю.",shape=box,color=blue];
		j3663744054 -> j350433779;
	j350433779 [label="Но их облики последовали за мной. И они продолжали шептаться о крови.",shape=box,color=blue];
		j350433779 -> j3007636292;
	j3007636292 [label="Я надеялся, что если я их больше не увижу, они в конце концов исчезнут... когда я вонзил этот нож себе в глазницу...",shape=box,color=blue];
		j3007636292 -> j3141757247;
	j3141757247 [label="Жаль, что я потерял сознание и не смог выполнить задание. Теперь я никогда не узнаю.",shape=box,color=blue];
		j3141757247 -> j1389796601;
	j1389796601 [label="Очнулся я уже в местном приходе Луа. Меня нашёл брат и перевязал мои раны. Он спросил, от чего я бежал.",shape=box,color=blue];
		j1389796601 -> j1831681725;
	j1831681725 [label="Я был вне себя. Я не мог лгать ему. Я во всём признался - в видениях, в том, что они мне велели сделать. Я ожидал осуждения.",shape=box,color=blue];
		j1831681725 -> j237192515;
	j237192515 [label="Когда я закончил, он лишь улыбнулся с понимающей грустью и вложил мне в ладонь амулет Луа. «Она и благословение, и проклятие, сын мой».",shape=box,color=blue];
		j237192515 -> j2694543036;
	j2694543036 [label="Он отправил меня в собор в Cité de la Lumière. Там я и оставался, пока меня не нашёл Энтрати...",shape=box,color=blue];
		j2694543036 -> j2597844170;
	j2597844170 [label="Вот... теперь ты знаешь.",shape=box,color=blue];
		j2597844170 -> j1191195262;
	j1191195262 [label="И... теперь мне необходимо идти.",shape=box,color=blue];
		j1191195262 -> j1481511178;
	j1481511178 [label="Boolean LyonConfession1 is now true.",color=orange];
		j1481511178 -> j1577140548;
	j1577140548 [label="+20 Chemistry",color=orange];
		j1577140548 -> j3176698568;
	j3176698568 [label="- Лион",shape=box,color=blue];
		j3176698568 -> "Chat ends.";
}