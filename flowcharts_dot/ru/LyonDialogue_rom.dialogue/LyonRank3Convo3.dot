digraph {
	114 [label="LyonRank3Convo3 begins.",color=orange];
		114 -> 115;
	115 [label="Я помогал M. Лойду в его библиотеке, расставляя книги по полках, хотя он и настаивал, что эти причудливые летающие... приспособления могли бы сделать это вместо меня -",shape=box,color=blue];
		115 -> 116;
	116 [label="И мне попался на глаза занятный том с детскими сказками, действие которых происходит в вымышленном мире, описанным некой Эйлерией Энтрати.",shape=box,color=blue];
		116 -> 117;
	117 [label="Заметив, что фамилия автора совпадает с настоящим именем нашего «Cardinal Dimanche», я немедленно отложил копию для себя.",shape=box,color=blue];
		117 -> 120;
		117 -> 119;
		117 -> 118;
	120 [label="Мне кажется, я знаю, о какой книге ты говоришь...",shape=box,color=red];
		120 -> 123;
	119 [label="Мы можем без предисловий, пожалуйста? Спрашивай меня о том, что хочешь знать.",shape=box,color=red];
		119 -> 122;
	118 [label="[Игнорировать.]",shape=box,color=red];
		118 -> 121;
	123 [label="+5 Chemistry",color=orange];
		123 -> 125;
	122 [label="Update boolean LyonMITW1",color=orange];
		122 -> 124;
	121 [label="Chat ends.",color=orange];
	125 [label="Я подозреваю - судя по испуганному взгляду, которым M. Лойд одарил меня, и по его настойчивым просьбам немедленно вернуть книгу на место, «дабы я тебя не расстроил», - что ты всё же кое-что знаешь об этом, да.",shape=box,color=blue];
		125 -> 128;
	124 [label="Мой вопрос связан с природой «концептуального воплощение». Судя по прочитанному, что книга была задумана как наставление детям предотвращать взаимодействие своих эмоций с Бездной.",shape=box,color=blue];
		124 -> 126;
		124 -> 127;
	128 [label="«Сказки о Дувири». Хотя я и получил довольно... исчерпывающие и многострадальные объяснения от M. Лойда относительно того, что тебе пришлось пережить, есть один особый вопрос, который я хотел бы задать.",shape=box,color=blue];
		128 -> 131;
	126 [label="Мало толку от этого было. Особенно в моем случае.",shape=box,color=red];
		126 -> 129;
	127 [label="Сильные эмоции, взаимодействующие с Бездной, могут вызвать... серьезные проблемы.",shape=box,color=red];
		127 -> 130;
	131 [label="Если, конечно, это не слишком побеспокоит тебя?",shape=box,color=blue];
		131 -> 134;
		131 -> 135;
	129 [label="Как много из нашей жизни было предписано нам другими как факт только для того, чтобы при проверке оказаться бесполезным?",shape=box,color=blue];
		129 -> 132;
	130 [label="Похоже, что так. Я встречался с Кавией. Мне рассказывали об Ангелах Бездны. Я собственными глазами видел шёпот. ",shape=box,color=blue];
		130 -> 133;
	134 [label="Без проблем. Продолжай.",shape=box,color=red];
		134 -> 122;
	135 [label="Полагаю, это полностью зависит от конкретных обстоятельств. Я понятия не имею, о чём ты собственно собираешься меня спросить.",shape=box,color=red];
		135 -> 140;
	132 [label="Update boolean LyonFaith1",color=orange];
		132 -> 136;
	133 [label="И такова природа моего любопытства. Я задался этим вопросом «вслух», чтобы узнать, сможешь ли ты объяснить это подробнее. Когда Бездна обретает форму, что из неё выходит - является ли она «реальной»?",shape=box,color=blue];
		133 -> 137;
		133 -> 138;
		133 -> 139;
	140 [label="+5 Chemistry",color=orange];
		140 -> 146;
	136 [label="Я часто задаюсь вопросом, зачем забивать головы других такой бесполезной ложью? Они стремятся к власти? Влиянию? Или ты думаешь, что они искренне верят в свои слова и не знают о собственной лжи?",shape=box,color=blue];
		136 -> 142;
		136 -> 141;
	137 [label="Нет, я думаю, всё, что создано Бездной, просто... временно. Фрагмент того, кто или что бы это ни создало. Призрак воспоминания.",shape=box,color=red];
		137 -> 143;
	138 [label="Я верю, что это так и есть, да. Как картина, написанная художником, она может возникнуть в чьем-то воображении, но как только она создана, она становится реальностью.",shape=box,color=red];
		138 -> 144;
	139 [label="Это полностью зависит от твоего определения понятия «реальности».",shape=box,color=red];
		139 -> 145;
	146 [label="Да, прошу прощения. Прямые разговоры никогда не были моей сильной стороной. Тем более когда беседа ведется столь странным путём, как этот. Но я сейчас постораюсь приложить все усилия.",shape=box,color=blue];
		146 -> 122;
	142 [label="В данном случае, я думаю, Эйлерия Энтрати хотела бы, чтобы то, что она написала, было бы полезным. Просто это не помогло мне, когда мне это было нужно.",shape=box,color=red];
		142 -> 148;
	141 [label="Я не знаю. Какой ложью была забита твоя голова, Лион?",shape=box,color=red];
		141 -> 147;
	143 [label="Тогда не являются ли эффекты, вызванные такими элементами Бездны, «реальностью»?",shape=box,color=blue];
		143 -> 149;
	144 [label="Но аналогия, которую ты используешь, не совсем точна, верно? Материя, извлеченная из Бездны, возвращается обратно в Бездну, не так ли?",shape=box,color=blue];
		144 -> 150;
	145 [label="+5 Chemistry",color=orange];
		145 -> 151;
	148 [label="В её защиту могу лишь сказать, что моё знакомство с Бездной было гораздо более длительным, чем то, для чего она намеревалась использовать книгу в качестве руководства.",shape=box,color=red];
		148 -> 153;
	147 [label="Ничего такого, чтобы я хотел с тобой обсудить.",shape=box,color=blue];
		147 -> 152;
	149 [label="Многие воспоминания подталкивали людей к бутылке или побуждали их на самоубийство. Разве эти воспоминания не «реальны»?",shape=box,color=blue];
		149 -> 154;
	150 [label="Очень хорошо, тогда это мысль. Стихотворение или песня существуют, даже если они не записаны.",shape=box,color=red];
		150 -> 155;
	151 [label="Можешь пояснить?",shape=box,color=blue];
		151 -> 156;
	153 [label="+5 Chemistry",color=orange];
		153 -> 157;
	152 [label="Chat ends.",color=orange];
	154 [label="Но это были внутренние силы, которым человек позволил на себя воздействовать, вот что я хочу сказать. Не внешние.",shape=box,color=red];
		154 -> 158;
	155 [label="Но если это забыто, оно перестает существовать. История, утраченная временем, пропадает навсегда.",shape=box,color=blue];
		155 -> 159;
	156 [label="Как ты можешь измерить «реальность»?",shape=box,color=red];
		156 -> 160;
		156 -> 161;
		156 -> 162;
	157 [label="Беспомощное неведение это самое лучшее, на что кто из нас может надеяться, если говорить о том, что порождает чью то злобу.",shape=box,color=blue];
		157 -> 163;
	158 [label="Но в чем разница, вот мой вопрос? Если конечный результат один и тот же, имеет ли это значение?",shape=box,color=blue];
		158 -> 164;
		158 -> 165;
		158 -> 166;
	159 [label="Революция, выбитая из умов тех, кто призван ею распоряжаться, превращается в меч удивительно тупой и бесполезный.",shape=box,color=blue];
		159 -> 164;
		159 -> 165;
		159 -> 166;
	160 [label="По физической неизменности? По весу и массе? Всё, что пришло из Бездны, удерживается здесь лишь на время.",shape=box,color=red];
		160 -> 167;
	161 [label="По её воздействию на события? То, что пришло из Бездны, уже изменило ход истории.",shape=box,color=red];
		161 -> 168;
	162 [label="По её воздействию на других? Влияние «вещей», пришедших из Бездны, несомненно успело оставить такой след.",shape=box,color=red];
		162 -> 169;
	163 [label="Моя любознательность, однако, вовсе не о книге и не о её пользе. Простите, что на мгновение впадаю в поэтичность.",shape=box,color=blue];
		163 -> 170;
	164 [label="Ты же интересуешься не тем, «реальны» ли они, а тем, признавать ли их «значимыми». Следует ли отбросить их или все же нет.",shape=box,color=red];
		164 -> 171;
	165 [label="Я бы также хотел спросить, являются или нет твои Люминарии «настоящими» просто потому, что ты не можешь пожать руку Солу или Луа.",shape=box,color=red];
		165 -> 172;
	166 [label="Ты спрашиваешь окольным путём, не существуют ли все «вещи» из Бездны только потому, что мы сами пожелали их существования.",shape=box,color=red];
		166 -> 173;
	167 [label="Ты говоришь, что всё, что приходит из Бездны, должно в неё вернуться? Но разве Бездна, по определению, не состоит из ничего?",shape=box,color=blue];
		167 -> 174;
	168 [label="Справедливое замечание. Разве революция не «реальна» только потому, что её нельзя положить в корзину и взвесить?",shape=box,color=blue];
		168 -> 169;
	169 [label="Она точно стоила многим душам их голов. Они бы весьма поспорили относительно её действительности. Однако поразмысли над следующим:",shape=box,color=blue];
		169 -> 175;
	170 [label="Я задался этим вопросом «вслух», чтобы узнать, сможешь ли ты объяснить это подробнее. Когда Бездна обретает форму, что из неё выходит - является ли она «реальной»?",shape=box,color=blue];
		170 -> 137;
		170 -> 139;
		170 -> 138;
	171 [label="+5 Chemistry",color=orange];
		171 -> 176;
	172 [label="Мы не обсуждаем Люминарий. Мы обсуждаем Бездну.",shape=box,color=blue];
		172 -> 177;
		172 -> 178;
		172 -> 179;
		172 -> 180;
	173 [label="+5 Chemistry",color=orange];
		173 -> 181;
	174 [label="Полагаю? Те стороны Бездны, с которыми у меня были взаимодействия, обычно уже несут какой-то отпечаток. Будто мы сами придали ей форму. Или мы уже слишком сильно размыли грань между реальностями.",shape=box,color=red];
		174 -> 182;
		174 -> 183;
	175 [label="Сила революции реальна лишь постольку, поскольку она живёт в сознании тех, кто её вершит.",shape=box,color=blue];
		175 -> 184;
	176 [label="Да, я полагаю, это можно выразиться и так. Должны ли мы игнорировать призраков, которые бродят по нашим коридорам, или же, уделяя им хоть каплю внимания, мы только усиливаем их?",shape=box,color=blue];
		176 -> 177;
		176 -> 178;
		176 -> 179;
		176 -> 180;
	177 [label="Я считаю, что вызовы, с которыми мы сталкиваемся сейчас, опасны. Чрезвычайно опасны. И нам стоит относиться к ним соответствующим образом.",shape=box,color=red];
		177 -> 185;
	178 [label="Призраки достаточно реальны, чтобы причинять нам боль. Но их не вылечишь пулей. По крайней мере, мне такая ещё не попадалась.",shape=box,color=red];
		178 -> 186;
	179 [label="К чему все это, Лион? О чём идет речь?",shape=box,color=red];
		179 -> 187;
	180 [label="Я... честно не знаю, Лион. И мне бы хотелось знать.",shape=box,color=red];
		180 -> 188;
	181 [label="Да, я полагаю, это можно выразиться и так. Как нам быть уверенными, что мы сами не... воплотили собственных демонов?",shape=box,color=blue];
		181 -> 177;
		181 -> 178;
		181 -> 179;
		181 -> 180;
	182 [label="Целые структуры, да и сама Луа, были помещены в Бездну и возвращены обратно. Значит, она не поглощает материю только от того, что она в ней находится.",shape=box,color=red];
		182 -> 189;
	183 [label="Ты подразумеваешь существование «более глубокой» Бездны, где ничто не может существовать, и, честно говоря, я не могу судить об этом.",shape=box,color=red];
		183 -> 190;
	184 [label="Если вычеркнуть это из сознания каждого, кто о нём помнит, разве оно не исчезнет полностью?",shape=box,color=blue];
		184 -> 165;
		184 -> 164;
		184 -> 166;
	185 [label="Update boolean LyonReal1",color=orange];
		185 -> 191;
	186 [label="Update boolean LyonFake1",color=orange];
		186 -> 192;
	187 [label="Update boolean LyonFaith1",color=orange];
		187 -> 193;
	188 [label="Твоя честность, с которой ты признаёшь то, чего не знаешь, отрадна. Если бы у человечества было побольше такого дара.",shape=box,color=blue];
		188 -> 194;
	189 [label="Меня не волнует, что материя помещается в Бездну и извлекается оттуда. Меня волнует то, что было создано из Бездны, из цельной ткани.",shape=box,color=blue];
		189 -> 164;
		189 -> 165;
		189 -> 166;
	190 [label="Я ценю твою откровенность. Полагаю, меня куда меньше интересует то, чего не может быть, и то, что уже существует.",shape=box,color=blue];
		190 -> 164;
		190 -> 165;
		190 -> 166;
	191 [label="Да, я полагаю, тебе должно быть известно, что можно извлечь из Бездны силой, а что нет...",shape=box,color=blue];
		191 -> 195;
	192 [label="Возможно, именно поэтому столь многие прибегают к излишествам… чтобы залатать кровоточащую рану, невидимую, но ноющую. Рану, что можно исцелить, но лишь силой духа, а не оружием.",shape=box,color=blue];
		192 -> 195;
	193 [label="Очевидно, я подошёл к этому совсем неверно. Мы вернёмся к этому в другой раз. Прости за моё вторжение.",shape=box,color=blue];
		193 -> 196;
	194 [label="Как бы то ни было, я нахожу, что мои мысли по этому поводу всё ещё совершенно не прояснены.",shape=box,color=blue];
		194 -> 193;
	195 [label="Хотя я вновь оказываюсь во власти сомнений. Прости за моё вторжение. Благодарю за уделённое время, Скиталец.",shape=box,color=blue];
		195 -> 196;
	196 [label="-Ф. Лион Аллард",shape=box,color=blue];
		196 -> 197;
	197 [label="Chat ends.",color=orange];
}