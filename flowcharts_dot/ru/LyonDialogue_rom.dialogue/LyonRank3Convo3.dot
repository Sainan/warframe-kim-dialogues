digraph {
	"LyonRank3Convo3 begins." [color=orange];
		"LyonRank3Convo3 begins." -> j2032880659;
	j2032880659 [label="Я помогал M. Лойду в его библиотеке, расставляя книги по полках, хотя он и настаивал, что эти причудливые летающие... приспособления могли бы сделать это вместо меня -",shape=box,color=blue];
		j2032880659 -> j323138302;
	j323138302 [label="И мне попался на глаза занятный том с детскими сказками, действие которых происходит в вымышленном мире, описанным некой Эйлерией Энтрати.",shape=box,color=blue];
		j323138302 -> j3199172665;
	j3199172665 [label="Заметив, что фамилия автора совпадает с настоящим именем нашего «Cardinal Dimanche», я немедленно отложил копию для себя.",shape=box,color=blue];
		j3199172665 -> j3460780827;
		j3199172665 -> j2228822222;
		j3199172665 -> j2869381411;
	j3460780827 [label="Мне кажется, я знаю, о какой книге ты говоришь...",shape=box,color=red];
		j3460780827 -> j3777808452;
	j2228822222 [label="Мы можем без предисловий, пожалуйста? Спрашивай меня о том, что хочешь знать.",shape=box,color=red];
		j2228822222 -> j843868905;
	j2869381411 [label="[Игнорировать.]",shape=box,color=red];
		j2869381411 -> "Chat ends.";
	j3777808452 [label="+5 Chemistry",color=orange];
		j3777808452 -> j4159184116;
	j843868905 [label="Boolean LyonMITW1 is now true.",color=orange];
		j843868905 -> j3526013492;
	"Chat ends." [color=orange];
	j4159184116 [label="Я подозреваю - судя по испуганному взгляду, которым M. Лойд одарил меня, и по его настойчивым просьбам немедленно вернуть книгу на место, «дабы я тебя не расстроил», - что ты всё же кое-что знаешь об этом, да.",shape=box,color=blue];
		j4159184116 -> j3745730263;
	j3526013492 [label="Мой вопрос связан с природой «концептуального воплощение». Судя по прочитанному, что книга была задумана как наставление детям предотвращать взаимодействие своих эмоций с Бездной.",shape=box,color=blue];
		j3526013492 -> j3376827238;
		j3526013492 -> j793536286;
	j3745730263 [label="«Сказки о Дувири». Хотя я и получил довольно... исчерпывающие и многострадальные объяснения от M. Лойда относительно того, что тебе пришлось пережить, есть один особый вопрос, который я хотел бы задать.",shape=box,color=blue];
		j3745730263 -> j858958036;
	j3376827238 [label="Мало толку от этого было. Особенно в моем случае.",shape=box,color=red];
		j3376827238 -> j1878532363;
	j793536286 [label="Сильные эмоции, взаимодействующие с Бездной, могут вызвать... серьезные проблемы.",shape=box,color=red];
		j793536286 -> j3864084707;
	j858958036 [label="Если, конечно, это не слишком побеспокоит тебя?",shape=box,color=blue];
		j858958036 -> j671963327;
		j858958036 -> j1587970469;
	j1878532363 [label="Как много из нашей жизни было предписано нам другими как факт только для того, чтобы при проверке оказаться бесполезным?",shape=box,color=blue];
		j1878532363 -> j2409392561;
	j3864084707 [label="Похоже, что так. Я встречался с Кавией. Мне рассказывали об Ангелах Бездны. Я собственными глазами видел Шёпот. ",shape=box,color=blue];
		j3864084707 -> j2995845826;
	j671963327 [label="Без проблем. Продолжай.",shape=box,color=red];
		j671963327 -> j843868905;
	j1587970469 [label="Полагаю, это полностью зависит от конкретных обстоятельств. Я понятия не имею, о чём ты собственно собираешься меня спросить.",shape=box,color=red];
		j1587970469 -> j3386926936;
	j2409392561 [label="Boolean LyonFaith1 is now true.",color=orange];
		j2409392561 -> j3065494304;
	j2995845826 [label="И такова природа моего любопытства. Я задался этим вопросом «вслух», чтобы узнать, сможешь ли ты объяснить это подробнее. Когда Бездна обретает форму, что из неё выходит - является ли она «реальной»?",shape=box,color=blue];
		j2995845826 -> j1184023755;
		j2995845826 -> j3573491867;
		j2995845826 -> j2027510908;
	j3386926936 [label="+5 Chemistry",color=orange];
		j3386926936 -> j2146790194;
	j3065494304 [label="Я часто задаюсь вопросом, зачем забивать головы других такой бесполезной ложью? Они стремятся к власти? Влиянию? Или ты думаешь, что они искренне верят в свои слова и не знают о собственной лжи?",shape=box,color=blue];
		j3065494304 -> j1395055277;
		j3065494304 -> j3875977077;
	j1184023755 [label="Нет, я думаю, всё, что создано Бездной, просто... временно. Фрагмент того, кто или что бы это ни создало. Призрак воспоминания.",shape=box,color=red];
		j1184023755 -> j1488815491;
	j3573491867 [label="Я верю, что это так и есть, да. Как картина, написанная художником, она может возникнуть в чьем-то воображении, но как только она создана, она становится реальностью.",shape=box,color=red];
		j3573491867 -> j1910835410;
	j2027510908 [label="Это полностью зависит от твоего определения понятия «реальности».",shape=box,color=red];
		j2027510908 -> j3779582077;
	j2146790194 [label="Да, прошу прощения. Прямые разговоры никогда не были моей сильной стороной. Тем более когда беседа ведется столь странным путём, как этот. Но я сейчас постораюсь приложить все усилия.",shape=box,color=blue];
		j2146790194 -> j843868905;
	j1395055277 [label="В данном случае, я думаю, Эйлерия Энтрати хотела бы, чтобы то, что она написала, было бы полезным. Просто это не помогло мне, когда мне это было нужно.",shape=box,color=red];
		j1395055277 -> j412038842;
	j3875977077 [label="Я не знаю. Какой ложью была забита твоя голова, Лион?",shape=box,color=red];
		j3875977077 -> j3894898391;
	j1488815491 [label="Тогда не являются ли эффекты, вызванные такими элементами Бездны, «реальностью»?",shape=box,color=blue];
		j1488815491 -> j32863879;
	j1910835410 [label="Но аналогия, которую ты используешь, не совсем точна, верно? Материя, извлеченная из Бездны, возвращается обратно в Бездну, не так ли?",shape=box,color=blue];
		j1910835410 -> j2789838431;
	j3779582077 [label="+5 Chemistry",color=orange];
		j3779582077 -> j47340678;
	j412038842 [label="В её защиту могу лишь сказать, что моё знакомство с Бездной было гораздо более длительным, чем то, для чего она намеревалась использовать книгу в качестве руководства.",shape=box,color=red];
		j412038842 -> j3377336341;
	j3894898391 [label="Ничего такого, чтобы я хотел с тобой обсудить.",shape=box,color=blue];
		j3894898391 -> "Chat ends.";
	j32863879 [label="Многие воспоминания подталкивали людей к бутылке или побуждали их на самоубийство. Разве эти воспоминания не «реальны»?",shape=box,color=blue];
		j32863879 -> j3001770924;
	j2789838431 [label="Очень хорошо, тогда это мысль. Стихотворение или песня существуют, даже если они не записаны.",shape=box,color=red];
		j2789838431 -> j3435233365;
	j47340678 [label="Можешь пояснить?",shape=box,color=blue];
		j47340678 -> j3480234984;
	j3377336341 [label="+5 Chemistry",color=orange];
		j3377336341 -> j3642272963;
	j3001770924 [label="Но это были внутренние силы, которым человек позволил на себя воздействовать, вот что я хочу сказать. Не внешние.",shape=box,color=red];
		j3001770924 -> j2362688839;
	j3435233365 [label="Но если это забыто, оно перестает существовать. История, утраченная временем, пропадает навсегда.",shape=box,color=blue];
		j3435233365 -> j1523204848;
	j3480234984 [label="Как ты можешь измерить «реальность»?",shape=box,color=red];
		j3480234984 -> j4113978410;
		j3480234984 -> j83905465;
		j3480234984 -> j3219669757;
	j3642272963 [label="Беспомощное неведение это самое лучшее, на что кто из нас может надеяться, если говорить о том, что порождает чью то злобу.",shape=box,color=blue];
		j3642272963 -> j607536339;
	j2362688839 [label="Но в чем разница, вот мой вопрос? Если конечный результат один и тот же, имеет ли это значение?",shape=box,color=blue];
		j2362688839 -> j3232100831;
		j2362688839 -> j234309506;
		j2362688839 -> j1747312709;
	j1523204848 [label="Революция, выбитая из умов тех, кто призван ею распоряжаться, превращается в меч удивительно тупой и бесполезный.",shape=box,color=blue];
		j1523204848 -> j3232100831;
		j1523204848 -> j234309506;
		j1523204848 -> j1747312709;
	j4113978410 [label="По физической неизменности? По весу и массе? Всё, что пришло из Бездны, удерживается здесь лишь на время.",shape=box,color=red];
		j4113978410 -> j2107549286;
	j83905465 [label="По её воздействию на события? То, что пришло из Бездны, уже изменило ход истории.",shape=box,color=red];
		j83905465 -> j241581115;
	j3219669757 [label="По её воздействию на других? Влияние «вещей», пришедших из Бездны, несомненно успело оставить такой след.",shape=box,color=red];
		j3219669757 -> j2875359868;
	j607536339 [label="Моя любознательность, однако, вовсе не о книге и не о её пользе. Простите, что на мгновение впадаю в поэтичность.",shape=box,color=blue];
		j607536339 -> j3594715796;
	j3232100831 [label="Ты же интересуешься не тем, «реальны» ли они, а тем, признавать ли их «значимыми». Следует ли отбросить их или все же нет.",shape=box,color=red];
		j3232100831 -> j271515780;
	j234309506 [label="Я бы также хотел спросить, являются или нет твои Люминарии «настоящими» просто потому, что ты не можешь пожать руку Солу или Луа.",shape=box,color=red];
		j234309506 -> j3355513787;
	j1747312709 [label="Ты спрашиваешь окольным путём, не существуют ли все «вещи» из Бездны только потому, что мы сами пожелали их существования.",shape=box,color=red];
		j1747312709 -> j3507577125;
	j2107549286 [label="Ты говоришь, что всё, что приходит из Бездны, должно в неё вернуться? Но разве Бездна, по определению, не состоит из ничего?",shape=box,color=blue];
		j2107549286 -> j621470343;
	j241581115 [label="Справедливое замечание. Разве революция не «реальна» только потому, что её нельзя положить в корзину и взвесить?",shape=box,color=blue];
		j241581115 -> j2875359868;
	j2875359868 [label="Она точно стоила многим душам их голов. Они бы весьма поспорили относительно её действительности. Однако поразмысли над следующим:",shape=box,color=blue];
		j2875359868 -> j4142237292;
	j3594715796 [label="Я задался этим вопросом «вслух», чтобы узнать, сможешь ли ты объяснить это подробнее. Когда Бездна обретает форму, что из неё выходит - является ли она «реальной»?",shape=box,color=blue];
		j3594715796 -> j1184023755;
		j3594715796 -> j2027510908;
		j3594715796 -> j3573491867;
	j271515780 [label="+5 Chemistry",color=orange];
		j271515780 -> j737482421;
	j3355513787 [label="Мы не обсуждаем Люминарий. Мы обсуждаем Бездну.",shape=box,color=blue];
		j3355513787 -> j554755477;
		j3355513787 -> j1938919041;
		j3355513787 -> j3133078257;
		j3355513787 -> j1208106709;
	j3507577125 [label="+5 Chemistry",color=orange];
		j3507577125 -> j2785611193;
	j621470343 [label="Полагаю? Те стороны Бездны, с которыми у меня были взаимодействия, обычно уже несут какой-то отпечаток. Будто мы сами придали ей форму. Или мы уже слишком сильно размыли грань между реальностями.",shape=box,color=red];
		j621470343 -> j3106009734;
		j621470343 -> j4102236771;
	j4142237292 [label="Сила революции реальна лишь постольку, поскольку она живёт в сознании тех, кто её вершит.",shape=box,color=blue];
		j4142237292 -> j3496982433;
	j737482421 [label="Да, я полагаю, это можно выразиться и так. Должны ли мы игнорировать призраков, которые бродят по нашим коридорам, или же, уделяя им хоть каплю внимания, мы только усиливаем их?",shape=box,color=blue];
		j737482421 -> j554755477;
		j737482421 -> j1938919041;
		j737482421 -> j3133078257;
		j737482421 -> j1208106709;
	j554755477 [label="Я считаю, что вызовы, с которыми мы сталкиваемся сейчас, опасны. Чрезвычайно опасны. И нам стоит относиться к ним соответствующим образом.",shape=box,color=red];
		j554755477 -> j859741624;
	j1938919041 [label="Призраки достаточно реальны, чтобы причинять нам боль. Но их не вылечишь пулей. По крайней мере, мне такая ещё не попадалась.",shape=box,color=red];
		j1938919041 -> j550322958;
	j3133078257 [label="К чему все это, Лион? О чём идет речь?",shape=box,color=red];
		j3133078257 -> j3053297090;
	j1208106709 [label="Я... честно не знаю, Лион. И мне бы хотелось знать.",shape=box,color=red];
		j1208106709 -> j2033349070;
	j2785611193 [label="Да, я полагаю, это можно выразиться и так. Как нам быть уверенными, что мы сами не... воплотили собственных демонов?",shape=box,color=blue];
		j2785611193 -> j554755477;
		j2785611193 -> j1938919041;
		j2785611193 -> j3133078257;
		j2785611193 -> j1208106709;
	j3106009734 [label="Целые структуры, да и сама Луа, были помещены в Бездну и возвращены обратно. Значит, она не поглощает материю только от того, что она в ней находится.",shape=box,color=red];
		j3106009734 -> j4271132821;
	j4102236771 [label="Ты подразумеваешь существование «более глубокой» Бездны, где ничто не может существовать, и, честно говоря, я не могу судить об этом.",shape=box,color=red];
		j4102236771 -> j4263306000;
	j3496982433 [label="Если вычеркнуть это из сознания каждого, кто о нём помнит, разве оно не исчезнет полностью?",shape=box,color=blue];
		j3496982433 -> j234309506;
		j3496982433 -> j3232100831;
		j3496982433 -> j1747312709;
	j859741624 [label="Boolean LyonReal1 is now true.",color=orange];
		j859741624 -> j375451419;
	j550322958 [label="Boolean LyonFake1 is now true.",color=orange];
		j550322958 -> j34656996;
	j3053297090 [label="Boolean LyonFaith1 is now true.",color=orange];
		j3053297090 -> j3112695685;
	j2033349070 [label="Твоя честность, с которой ты признаёшь то, чего не знаешь, отрадна. Если бы у человечества было побольше такого дара.",shape=box,color=blue];
		j2033349070 -> j124698674;
	j4271132821 [label="Меня не волнует, что материя помещается в Бездну и извлекается оттуда. Меня волнует то, что было создано из Бездны, из цельной ткани.",shape=box,color=blue];
		j4271132821 -> j3232100831;
		j4271132821 -> j234309506;
		j4271132821 -> j1747312709;
	j4263306000 [label="Я ценю твою откровенность. Полагаю, меня куда меньше интересует то, чего не может быть, и то, что уже существует.",shape=box,color=blue];
		j4263306000 -> j3232100831;
		j4263306000 -> j234309506;
		j4263306000 -> j1747312709;
	j375451419 [label="Да, я полагаю, тебе должно быть известно, что можно извлечь из Бездны силой, а что нет...",shape=box,color=blue];
		j375451419 -> j1394130786;
	j34656996 [label="Возможно, именно поэтому столь многие прибегают к излишествам… чтобы залатать кровоточащую рану, невидимую, но ноющую. Рану, что можно исцелить, но лишь силой духа, а не оружием.",shape=box,color=blue];
		j34656996 -> j1394130786;
	j3112695685 [label="Очевидно, я подошёл к этому совсем неверно. Мы вернёмся к этому в другой раз. Прости за моё вторжение.",shape=box,color=blue];
		j3112695685 -> j1542260442;
	j124698674 [label="Как бы то ни было, я нахожу, что мои мысли по этому поводу всё ещё совершенно не прояснены.",shape=box,color=blue];
		j124698674 -> j3112695685;
	j1394130786 [label="Хотя я вновь оказываюсь во власти сомнений. Прости за моё вторжение. Благодарю за уделённое время, Скиталец.",shape=box,color=blue];
		j1394130786 -> j1542260442;
	j1542260442 [label="-Ф. Лион Аллард",shape=box,color=blue];
		j1542260442 -> "Chat ends.";
}