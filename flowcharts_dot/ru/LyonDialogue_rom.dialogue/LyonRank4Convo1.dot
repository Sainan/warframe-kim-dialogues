		j2232810544 -> j2535791993;
	j2843734095 [label="Знакома ли тебе эта фраза: «На пустом перекрестке ищите затмение — ибо, когда Сол и Луа объединятся, заблудшие найдут дорогу домой.»",shape=box,color=red];
