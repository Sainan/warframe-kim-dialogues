		671 -> 679;
	666 [label="Я следую за Люминариями, но стараюсь придерживаться сбалансированного пути.",shape=box,color=red];
		666 -> 679;
	667 [label="Я верю, что нечто существует, но я не думаю, что люди действительно могут знать ответы в конце концов.",shape=box,color=red];
		667 -> 680;
	668 [label="Во мне нет религиозности. Мне кажется, религия это опора для тех, кто живет в страхе - без обид.",shape=box,color=red];
		668 -> 681;
	669 [label="Во мне нет религиозности. Я не скажу, что чего-то не может быть, но меня это не беспокоит.",shape=box,color=red];
