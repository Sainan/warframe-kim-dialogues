		745 -> 750 [label="false",color=purple];
		745 -> 751 [label="false",color=purple];
	755 [label="Почему?",shape=box,color=blue];
		755 -> 760;
	754 [label="Я расскажу тебе историю о первом затмении, которое я наблюдал в другой раз. Здесь уже поздно. Или, возможно, рано. Точно сказать не могу.",shape=box,color=blue];
		754 -> 759;
	748 [label="Это не моих рук дело.",shape=box,color=red];
		748 -> 756;
	749 [label="Да. Это было не так уж впечатляюще.",shape=box,color=red];
		749 -> 757;
	750 [label="Да. Было нормально.",shape=box,color=red];
		750 -> 757;
	751 [label="Да. Это было потрясающе.",shape=box,color=red];
		751 -> 746;
	753 [label="Да. Поверь или нет, у меня от этого случилась ужасная глазная мигрень. Но всё равно это было потрясающе.",shape=box,color=red];
		753 -> 758;
	752 [label="Да. Поверь или нет, у меня от этого случилась ужасная глазная мигрень. Но всё равно это было потрясающе.",shape=box,color=red];
		752 -> 758;
	760 [label="Знакома ли тебе эта фраза: «На пустом перекрестке ищите затмение — ибо, когда Сол и Луа объединятся, заблудшие найдут дорогу домой.»",shape=box,color=red];
