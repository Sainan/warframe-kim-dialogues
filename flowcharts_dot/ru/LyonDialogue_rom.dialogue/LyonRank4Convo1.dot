		757 -> 746;
	758 [label="Должно быть, тебя коснулись Светила, и их присутствие переполнило тебя. А может, они хотели покарать тебя за какой‑нибудь великий грех. Одно из двух. Хех.",shape=box,color=blue];
		758 -> 761;
	764 [label="Целестины 18:19, Третья Православная Книга Луа. Где, во имя Светил, ты это слышал?",shape=box,color=blue];
