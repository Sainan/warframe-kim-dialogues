	662 [label="Боюсь, я мог бы долго обсуждать многие темы. Но не пойми меня неправильно, я бы с радостью это сделал, просто не хочу тебя утомлять. С чего тебе бы хотелось начать?",shape=box,color=blue];
		662 -> 664;
		662 -> 665;
	675 [label="Нет, мне скорее любопытно, чем что-либо ещё.",shape=box,color=red];
		675 -> 686;
	676 [label="Во мне есть религиозность. Моя вера чем-то напоминает твою, хотя ты бы её всё равно не распознал.",shape=box,color=red];
		676 -> 687;
	674 [label="Во мне есть религиозности. Хотя вряд ли ты узнаешь какие-либо наши обряды.",shape=box,color=red];
		674 -> 685;
	673 [label="Во мне есть религиозности. Это своего рода вера, которая для меня очень личная - у неё как такового нет названия.",shape=box,color=red];
		673 -> 684;
	672 [label="Я следую пути Сола, как и Мари.",shape=box,color=red];
		672 -> 679;
