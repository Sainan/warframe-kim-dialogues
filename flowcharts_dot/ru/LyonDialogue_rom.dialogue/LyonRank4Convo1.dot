		j1073023867 -> j1436016261 [label="DrifterFaithAgnostic",color=purple];
		j1073023867 -> j2100241776 [label="DrifterFaithNoFear",color=purple];
		j1073023867 -> j1436016261 [label="DrifterFaithNoFear",color=purple];
		j1073023867 -> j2444255462 [label="DrifterFaithNoMaybe",color=purple];
		j1073023867 -> j1436016261 [label="DrifterFaithNoMaybe",color=purple];
		j1073023867 -> j2538544313 [label="DrifterFaithNoMITW",color=purple];
		j1073023867 -> j1436016261 [label="DrifterFaithNoMITW",color=purple];
		j1073023867 -> j1436016261 [label="false",color=purple];
	j3866321985 [label="Боюсь, я мог бы долго обсуждать многие темы. Но не пойми меня неправильно, я бы с радостью это сделал, просто не хочу тебя утомлять. С чего тебе бы хотелось начать?",shape=box,color=blue];
		j3866321985 -> j2951796959;
		j3866321985 -> j2342125218;
	j1436016261 [label="Нет, мне скорее любопытно, чем что-либо ещё.",shape=box,color=red];
		j1436016261 -> j2305594065;
	j4159244942 [label="Во мне есть религиозность. Моя вера чем-то напоминает твою, хотя ты бы её всё равно не распознал.",shape=box,color=red];
		j4159244942 -> j1262090061;
	j2363824770 [label="Во мне есть религиозности. Хотя вряд ли ты узнаешь какие-либо наши обряды.",shape=box,color=red];
		j2363824770 -> j920469158;
	j1501078770 [label="Во мне есть религиозности. Это своего рода вера, которая для меня очень личная - у неё как такового нет названия.",shape=box,color=red];
		j1501078770 -> j2213172138;
	j1380509068 [label="Я следую пути Сола, как и Мари.",shape=box,color=red];
		j1380509068 -> j1855460839;
	j3149308876 [label="Я, как и ты, следую пути Луа.",shape=box,color=red];
		j3149308876 -> j1855460839;
	j2921410083 [label="Я следую за Люминариями, но стараюсь придерживаться сбалансированного пути.",shape=box,color=red];
		j2921410083 -> j1855460839;
	j3894704263 [label="Я верю, что нечто существует, но я не думаю, что люди действительно могут знать ответы в конце концов.",shape=box,color=red];
		j3894704263 -> j4176380790;
	j2100241776 [label="Во мне нет религиозности. Мне кажется, религия это опора для тех, кто живет в страхе - без обид.",shape=box,color=red];
		j2100241776 -> j616680942;
	j2444255462 [label="Во мне нет религиозности. Я не скажу, что чего-то не может быть, но меня это не беспокоит.",shape=box,color=red];
		j2444255462 -> j3532909668;
	j2538544313 [label="Во мне нет религиозности. Я думаю, что все боги - даже Безразличие - это продукт нашего воображения. Без обид.",shape=box,color=red];
		j2538544313 -> j2701495512;
	j2951796959 [label="Можешь рассказать мне больше о ваших праздниках?",shape=box,color=red];
		j2951796959 -> j2372415271;
	j2342125218 [label="Можешь рассказать мне больше о Сол и Луа?",shape=box,color=red];
		j2342125218 -> j3249733706;
	j2305594065 [label="Check boolean LyonSuspicious",color=orange];
		j2305594065 -> j4069766747 [label=true,color=green];
		j2305594065 -> j2139229764 [label=false,color=brown];
	j1262090061 [label="+20 Chemistry",color=orange];
		j1262090061 -> j2165022589;
	j920469158 [label="+20 Chemistry",color=orange];
		j920469158 -> j126293434;
	j2213172138 [label="И как шёл твой путь к такой личной вере, если ты не возражаешь, что я спрашиваю?",shape=box,color=blue];
		j2213172138 -> j2047718961;
		j2213172138 -> j3049247036;
		j2213172138 -> j66652221;
