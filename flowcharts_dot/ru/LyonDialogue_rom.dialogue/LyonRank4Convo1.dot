	701 [label="Интересно, насколько сильно наши религии повлияли друг на друга, намеренно или непреднамеренно, в зависимости от обстоятельств.",shape=box,color=blue];
		701 -> 704;
	698 [label="Увлекательно! Как служитель, посвятивший себя учению, я надеюсь, что у нас будет достаточно времени, чтобы обстоятельно обменяться знаниями о наших верованиях.",shape=box,color=blue];
		698 -> 704;
	695 [label="Это длинная история. ",shape=box,color=red];
		695 -> 707;
	696 [label="Я изучил множество разных религий, и ни одна из них мне не подошла. В конце концов я собрал некое странное собрание того, что человечество придумало.",shape=box,color=red];
		696 -> 708;
	697 [label="Я верю в то, что чувствую. И мне не нужен здание или книга, чтобы объяснять мне, что это такое.",shape=box,color=red];
		697 -> 709;
	690 [label="Вот как? Я... удивлен. Удивлен, но рад. И неудивительно, что тебе любопытно. Наши учения, должно быть, кажутся совсем чужими твоему опыту. Прошло так много времени.",shape=box,color=blue];
		690 -> 704;
	691 [label="Я уважаю это. В этом есть честь, в признании того, чего мы не можем знать, в осознании малости человеческого существования.",shape=box,color=blue];
		691 -> 704;
	692 [label="Поверь мне, я нисколько не обиделся. Во многом действительно твоя правда.",shape=box,color=blue];
		692 -> 705;
		692 -> 706;
	693 [label="Я бы признал, что завидую тебе в том, что ты не находишь повода тревожиться о том, что может ждать нас за завесой. Если бы больше людей поступало так же, наш мир знал бы больше мира в свои дни.",shape=box,color=blue];
		693 -> 704;
	694 [label="Это тема, на которую я хотел бы поговорить с тобой подробнее. Просто не сейчас, в то время, когда я не готов к подобному обсуждению.",shape=box,color=blue];
		694 -> 704;
	688 [label="Мудрое начало. Узнать культуру по её праздникам значит познать её сердце. Ведь как празднует народ, зависит, какими его запомнят. Ведь именно эти моменты самые дорогие для тех, кто ими делится.",shape=box,color=blue];
		688 -> 702;
	689 [label="Разумеется. Давай начнем с того, что тебе уже может быть знакомо: Сол и Луа, солнце и луна. Они божества, чьи облики вечно изменчивы.",shape=box,color=blue];
		689 -> 703;
	710 [label="Хм. Позволь мне удовлетворить твоё любопытство. Чтобы не утомлять тебя до слез, с какого места ты желаешь начать?",shape=box,color=blue];
		710 -> 665;
		710 -> 664;
	704 [label="И я проявил нерадивость, не удержавшись в русле беседы. Боюсь, я слишком далеко отошел от нашей темы.",shape=box,color=blue];
		704 -> 714;
	707 [label="+20 Chemistry",color=orange];
		707 -> 717;
	708 [label="+20 Chemistry",color=orange];
		708 -> 718;
	709 [label="+20 Chemistry",color=orange];
		709 -> 719;
	705 [label="Однако это не значит, что я не заинтересован в обучении.",shape=box,color=red];
		705 -> 715;
	706 [label="А как насчёт твоего случая?",shape=box,color=red];
		706 -> 716;
	702 [label="Наши главные и наиболее распространенные праздники - это дни зимнего и летнего солнцестояния, которые отмечают самые короткие и самые длинные дни в году.",shape=box,color=blue];
		702 -> 711;
	703 [label="Появляясь в самых разных обликах на протяжении веков и многим верующим. Порой в мужском виде, порой в женском. Но всегда как Сол, Солнце, и Луа, Луна.",shape=box,color=blue];
		703 -> 712;
		703 -> 713;
	714 [label="Тебе хотелось узнать о Православие Люминарий, не так ли? Чтобы не утомлять тебя до слез, с какого места ты желаешь начать?",shape=box,color=blue];
		714 -> 665;
		714 -> 664;
	717 [label="Мм. И это лучше всего сказать надежному другу. Я прекрасно понимаю. К тому же это тебе необходимы сведения от меня, а не наоборот.",shape=box,color=blue];
		717 -> 704;
	718 [label="Витраж души. Раздробленный, когда его оставляют в разобранном виде, но какой прекрасный образ создается, когда его собирают.",shape=box,color=blue];
		718 -> 704;
	719 [label="Мир был бы лучше, если бы он разделял твою веру.",shape=box,color=blue];
		719 -> 704;
	715 [label="И за это я воздаю должное твоему любопытству и учености. ",shape=box,color=blue];
		715 -> 704;
	716 [label="Мой случай... сложен. Но я не стану лгать и говорить, что в нем не было страха. Хотя религия принесла в мою жизнь целый поток этого страха, она ни разу не избавила меня от него.",shape=box,color=blue];
		716 -> 704;
	711 [label="Оба праздника отмечаются большими пиршествами, хотя различаются тем, с кем именно ими делишься. Если зимнее солнцестояние посвящено семье и близким друзьям, то летнее солнцестояние предназначено для незнакомцев.",shape=box,color=blue];
		711 -> 720;
		711 -> 721;
	712 [label="Ох, теперь в этом гораздо больше смысла.",shape=box,color=red];
		712 -> 722;
	713 [label="[Позволь ему продолжить.]",shape=box,color=red];
		713 -> 723;
	720 [label="Правда? Расскажи мне побольше о дне Летнего Солнцестояния.",shape=box,color=red];
		720 -> 724;
	721 [label="Расскажи мне побольше о дне Зимнего Солнцестояния.",shape=box,color=red];
		721 -> 725;
	722 [label="Да, некоторые секты могут быть чересчур строгими в выборе иконографии, утверждая, что Сол «Должен» быть одним или «Должен» быть другим, но Православие не признает это фактом.",shape=box,color=blue];
		722 -> 726;
	723 [label="Каждый из Люминарий содержит в себе множество аспектов. Каждый аспект можно рассматривать как функцию целого. Луа, например, является матерью, девой, старухой.",shape=box,color=blue];
		723 -> 731;
	724 [label="Летнее Солнцестояние предназначено для щедрого угощения и для того, чтобы соединять незнакомцев, которые прежде никогда не встречались. Люди собираются в поле, приносят еду и вещи, сделанные собственными руками, и вовсе не важно, какие именно.",shape=box,color=blue];
		724 -> 728;
	725 [label="Зимнее Солнцестояние предназначено для того, чтобы стойко встречать холод и ценить тех, кто согревает нас в самые темные времена. Люди украшают дерево свечами, по одному огоньку за каждого, кто ушёл прежде и освещает путь, словно звезды на небесах.",shape=box,color=blue];
		725 -> 729;
	726 [label="Я ожидаю, что все, что дожило до этого далекого будущего, в конечном итоге стало... несколько сбивчивым в своем описании моей веры.",shape=box,color=blue];
		726 -> 730;
	731 [label="Но Луа может быть и Тем, кто ведёт души по реке слез к бесконечной ночи. Самой Смертью. Предвестником и вестником.",shape=box,color=blue];
		731 -> 734;
	728 [label="Свечи, или хлеб, или одежду, или картины. Или сборники стихов. Или венки из цветов. Даже прийти с пустыми руками, но «с радостной вестью», считается благословением.",shape=box,color=blue];
		728 -> 732;
	729 [label="И на самой вершине стоит Сол, страдающий на звездном древе во тьме. Померкший, но не забытый. Ведь это время Луа. И мы чествуем её в этот час теней.",shape=box,color=blue];
		729 -> 733;
	730 [label="Я порой ощущаю себя живой археологической реликвией. Как это удручающе. Но я отвлекся от темы.",shape=box,color=blue];
		730 -> 723;
	734 [label="А в других сектах Смерть это старая женщина под вуалью. Образы различаются. Но говорит о том же духе, простирающем руку ко всем нам. О серебристой длани, что желает направить нас в тот последний миг.",shape=box,color=blue];
		734 -> 737;
	732 [label="Празднование жизни - смеха - музыки - обмена всем этим начиналось в этот день, самый долгий день Сола. ",shape=box,color=blue];
		732 -> 735;
	733 [label="И когда мы собираемся ближе друг к другу и лакомимся жареной птицей, корнеплодами и всем то, что не может расти свежим в мерзлой земле, мы обнимаем тех, кого любим. И рассказываем истории о тех, кого уже нет.",shape=box,color=blue];
		733 -> 736;
	737 [label="Луна, что скользит по солнцу во время затмения, ведет нас через перекресток того мгновения, когда кажется, что все потеряно.",shape=box,color=blue];
		737 -> 739;
	735 [label="Все были рады завести новых друзей среди незнакомцев и забрать домой то, в чем нуждались.",shape=box,color=blue];
		735 -> 738;
	736 [label="В самую длинную ночь Луа мы вспоминаем, что в конце концов она проведет нас и нашу семью через все это.",shape=box,color=blue];
		736 -> 738;
	739 [label="Update boolean DrifterEclipse",color=orange];
		739 -> 741;
	738 [label="Но самым священным праздником для Люминарий является Суммум Бонум. Это редкое событие, когда Сол и Луа выстраиваются в идеальное затмение.",shape=box,color=blue];
		738 -> 740;
	741 [label="Check boolean VelimirEclipse",color=orange];
		741 -> 744 [label=true,color=green];
		741 -> 743 [label=false,color=brown];
	740 [label="Это дивное и священное событие, на которое откликается вся природа. Тебе посчастливилось увидеть его собственными глазами?",shape=box,color=blue];
		740 -> 742;
	744 [label="Погоди...",shape=box,color=red];
		744 -> 747;
	743 [label="Ты когда-нибудь видел затмение?",shape=box,color=red];
		743 -> 746;
	742 [label="Update boolean DrifterEclipse",color=orange];
		742 -> 745;
	747 [label="Звучит... очень знакомо.",shape=box,color=red];
		747 -> 755;
	746 [label="Мне посчастливилось увидеть это дважды. И оба раза это было для меня... преображающим. Если бы я мог задержаться в этом кратком мгновении, застыть там навсегда, я бы остался.",shape=box,color=blue];
		746 -> 754;
