		j616680942 -> j336613713;
	j3532909668 [label="+20 Chemistry",color=orange];
		j3532909668 -> j1943317137;
	j2701495512 [label="Boolean LyonMITW2 is now true.",color=orange];
		j2701495512 -> j677735251;
	j2372415271 [label="Boolean LyonLectureHolidays is now true.",color=orange];
		j2372415271 -> j3959692233;
	j3249733706 [label="Boolean LyonLectureSolLua is now true.",color=orange];
		j3249733706 -> j1434344794;
	j4069766747 [label="Boolean DrifterLiar is now true.",color=orange];
		j4069766747 -> j1579624335;
	j2139229764 [label="Boolean LyonSuspicious is now true.",color=orange];
		j2139229764 -> j1579624335;
	j2165022589 [label="Интересно, насколько сильно наши религии повлияли друг на друга, намеренно или непреднамеренно, в зависимости от обстоятельств.",shape=box,color=blue];
		j2165022589 -> j3711459822;
	j126293434 [label="Увлекательно! Как служитель, посвятивший себя учению, я надеюсь, что у нас будет достаточно времени, чтобы обстоятельно обменяться знаниями о наших верованиях.",shape=box,color=blue];
		j126293434 -> j3711459822;
	j2047718961 [label="Это длинная история. ",shape=box,color=red];
		j2047718961 -> j3379541819;
	j3049247036 [label="Я изучил множество разных религий, и ни одна из них мне не подошла. В конце концов я собрал некое странное собрание того, что человечество придумало.",shape=box,color=red];
		j3049247036 -> j325748056;
	j66652221 [label="Я верю в то, что чувствую. И мне не нужен здание или книга, чтобы объяснять мне, что это такое.",shape=box,color=red];
		j66652221 -> j1256261085;
	j1562596541 [label="Вот как? Я... удивлен. Удивлен, но рад. И неудивительно, что тебе любопытно. Наши учения, должно быть, кажутся совсем чужими твоему опыту. Прошло так много времени.",shape=box,color=blue];
		j1562596541 -> j3711459822;
	j1934416483 [label="Я уважаю это. В этом есть честь, в признании того, чего мы не можем знать, в осознании малости человеческого существования.",shape=box,color=blue];
		j1934416483 -> j3711459822;
	j336613713 [label="Поверь мне, я нисколько не обиделся. Во многом действительно твоя правда.",shape=box,color=blue];
		j336613713 -> j538216820;
		j336613713 -> j329584678;
	j1943317137 [label="Я бы признал, что завидую тебе в том, что ты не находишь повода тревожиться о том, что может ждать нас за завесой. Если бы больше людей поступало так же, наш мир знал бы больше мира в свои дни.",shape=box,color=blue];
		j1943317137 -> j3711459822;
	j677735251 [label="Это тема, на которую я хотел бы поговорить с тобой подробнее. Просто не сейчас, в то время, когда я не готов к подобному обсуждению.",shape=box,color=blue];
		j677735251 -> j3711459822;
	j3959692233 [label="Мудрое начало. Узнать культуру по её праздникам значит познать её сердце. Ведь как празднует народ, зависит, какими его запомнят. Ведь именно эти моменты самые дорогие для тех, кто ими делится.",shape=box,color=blue];
		j3959692233 -> j647465050;
	j1434344794 [label="Разумеется. Давай начнем с того, что тебе уже может быть знакомо: Сол и Луа, солнце и луна. Они божества, чьи облики вечно изменчивы.",shape=box,color=blue];
		j1434344794 -> j1419540770;
	j1579624335 [label="Хм. Позволь мне удовлетворить твоё любопытство. Чтобы не утомлять тебя до слез, с какого места ты желаешь начать?",shape=box,color=blue];
		j1579624335 -> j2342125218;
		j1579624335 -> j2951796959;
	j3711459822 [label="И я проявил нерадивость, не удержавшись в русле беседы. Боюсь, я слишком далеко отошел от нашей темы.",shape=box,color=blue];
		j3711459822 -> j2600449755;
	j3379541819 [label="+20 Chemistry",color=orange];
		j3379541819 -> j590355960;
	j325748056 [label="+20 Chemistry",color=orange];
		j325748056 -> j1960345408;
	j1256261085 [label="+20 Chemistry",color=orange];
		j1256261085 -> j3821361056;
	j538216820 [label="Однако это не значит, что я не заинтересован в обучении.",shape=box,color=red];
		j538216820 -> j1202974244;
	j329584678 [label="А как насчёт твоего случая?",shape=box,color=red];
		j329584678 -> j2680597211;
	j647465050 [label="Наши главные и наиболее распространенные праздники - это дни зимнего и летнего солнцестояния, которые отмечают самые короткие и самые длинные дни в году.",shape=box,color=blue];
		j647465050 -> j875791417;
	j1419540770 [label="Появляясь в самых разных обликах на протяжении веков и многим верующим. Порой в мужском виде, порой в женском. Но всегда как Сол, Солнце, и Луа, Луна.",shape=box,color=blue];
		j1419540770 -> j170808202;
		j1419540770 -> j4049079773;
	j2600449755 [label="Тебе хотелось узнать о Православие Люминарий, не так ли? Чтобы не утомлять тебя до слез, с какого места ты желаешь начать?",shape=box,color=blue];
		j2600449755 -> j2342125218;
		j2600449755 -> j2951796959;
	j590355960 [label="Мм. И это лучше всего сказать надежному другу. Я прекрасно понимаю. К тому же это тебе необходимы сведения от меня, а не наоборот.",shape=box,color=blue];
		j590355960 -> j3711459822;
	j1960345408 [label="Витраж души. Раздробленный, когда его оставляют в разобранном виде, но какой прекрасный образ создается, когда его собирают.",shape=box,color=blue];
		j1960345408 -> j3711459822;
	j3821361056 [label="Мир был бы лучше, если бы он разделял твою веру.",shape=box,color=blue];
		j3821361056 -> j3711459822;
	j1202974244 [label="И за это я воздаю должное твоему любопытству и учености. ",shape=box,color=blue];
		j1202974244 -> j3711459822;
	j2680597211 [label="Мой случай... сложен. Но я не стану лгать и говорить, что в нем не было страха. Хотя религия принесла в мою жизнь целый поток этого страха, она ни разу не избавила меня от него.",shape=box,color=blue];
		j2680597211 -> j3711459822;
	j875791417 [label="Оба праздника отмечаются большими пиршествами, хотя различаются тем, с кем именно ими делишься. Если зимнее солнцестояние посвящено семье и близким друзьям, то летнее солнцестояние предназначено для незнакомцев.",shape=box,color=blue];
		j875791417 -> j8515261;
		j875791417 -> j606995983;
	j170808202 [label="Ох, теперь в этом гораздо больше смысла.",shape=box,color=red];
		j170808202 -> j3146027554;
	j4049079773 [label="[Позволь ему продолжить.]",shape=box,color=red];
		j4049079773 -> j2554472096;
	j8515261 [label="Правда? Расскажи мне побольше о дне Летнего Солнцестояния.",shape=box,color=red];
		j8515261 -> j112496753;
	j606995983 [label="Расскажи мне побольше о дне Зимнего Солнцестояния.",shape=box,color=red];
		j606995983 -> j1498901093;
	j3146027554 [label="Да, некоторые секты могут быть чересчур строгими в выборе иконографии, утверждая, что Сол «Должен» быть одним или «Должен» быть другим, но Православие не признает это фактом.",shape=box,color=blue];
		j3146027554 -> j3915132006;
	j2554472096 [label="Каждый из Люминарий содержит в себе множество аспектов. Каждый аспект можно рассматривать как функцию целого. Луа, например, является матерью, девой, старухой.",shape=box,color=blue];
		j2554472096 -> j1246094251;
	j112496753 [label="Летнее Солнцестояние предназначено для щедрого угощения и для того, чтобы соединять незнакомцев, которые прежде никогда не встречались. Люди собираются в поле, приносят еду и вещи, сделанные собственными руками, и вовсе не важно, какие именно.",shape=box,color=blue];
		j112496753 -> j3784775822;
	j1498901093 [label="Зимнее Солнцестояние предназначено для того, чтобы стойко встречать холод и ценить тех, кто согревает нас в самые темные времена. Люди украшают дерево свечами, по одному огоньку за каждого, кто ушёл прежде и освещает путь, словно звезды на небесах.",shape=box,color=blue];
		j1498901093 -> j842063901;
	j3915132006 [label="Я ожидаю, что все, что дожило до этого далекого будущего, в конечном итоге стало... несколько сбивчивым в своем описании моей веры.",shape=box,color=blue];
		j3915132006 -> j3663193487;
	j1246094251 [label="Но Луа может быть и Тем, кто ведёт души по реке слез к бесконечной ночи. Самой Смертью. Предвестником и вестником.",shape=box,color=blue];
		j1246094251 -> j324729767;
	j3784775822 [label="Свечи, или хлеб, или одежду, или картины. Или сборники стихов. Или венки из цветов. Даже прийти с пустыми руками, но «с радостной вестью», считается благословением.",shape=box,color=blue];
		j3784775822 -> j961718624;
	j842063901 [label="И на самой вершине стоит Сол, страдающий на звездном древе во тьме. Померкший, но не забытый. Ведь это время Луа. И мы чествуем её в этот час теней.",shape=box,color=blue];
		j842063901 -> j3439271855;
	j3663193487 [label="Я порой ощущаю себя живой археологической реликвией. Как это удручающе. Но я отвлекся от темы.",shape=box,color=blue];
		j3663193487 -> j2554472096;
	j324729767 [label="А в других сектах Смерть это старая женщина под вуалью. Образы различаются. Но говорит о том же духе, простирающем руку ко всем нам. О серебристой длани, что желает направить нас в тот последний миг.",shape=box,color=blue];
		j324729767 -> j4287936065;
	j961718624 [label="Празднование жизни - смеха - музыки - обмена всем этим начиналось в этот день, самый долгий день Сола. ",shape=box,color=blue];
		j961718624 -> j1892649750;
	j3439271855 [label="И когда мы собираемся ближе друг к другу и лакомимся жареной птицей, корнеплодами и всем то, что не может расти свежим в мерзлой земле, мы обнимаем тех, кого любим. И рассказываем истории о тех, кого уже нет.",shape=box,color=blue];
		j3439271855 -> j3824261617;
	j4287936065 [label="Луна, что скользит по солнцу во время затмения, ведет нас через перекресток того мгновения, когда кажется, что все потеряно.",shape=box,color=blue];
		j4287936065 -> j1402025786;
	j1892649750 [label="Все были рады завести новых друзей среди незнакомцев и забрать домой то, в чем нуждались.",shape=box,color=blue];
		j1892649750 -> j485052248;
	j3824261617 [label="В самую длинную ночь Луа мы вспоминаем, что в конце концов она проведет нас и нашу семью через все это.",shape=box,color=blue];
		j3824261617 -> j485052248;
	j1402025786 [label="Boolean DrifterEclipse is now true.",color=orange];
		j1402025786 -> j1704025367;
	j485052248 [label="Но самым священным праздником для Люминарий является Суммум Бонум. Это редкое событие, когда Сол и Луа выстраиваются в идеальное затмение.",shape=box,color=blue];
		j485052248 -> j3785460624;
	j1704025367 [label="Check boolean VelimirEclipse",color=orange];
		j1704025367 -> j3325581859 [label=true,color=green];
		j1704025367 -> j3762823419 [label=false,color=brown];
	j3785460624 [label="Это дивное и священное событие, на которое откликается вся природа. Тебе посчастливилось увидеть его собственными глазами?",shape=box,color=blue];
		j3785460624 -> j1351788480;
	j3325581859 [label="Погоди...",shape=box,color=red];
		j3325581859 -> j3871007239;
	j3762823419 [label="Ты когда-нибудь видел затмение?",shape=box,color=red];
		j3762823419 -> j101622780;
	j1351788480 [label="Boolean DrifterEclipse is now true.",color=orange];
		j1351788480 -> j2702204293;
	j3871007239 [label="Звучит... очень знакомо.",shape=box,color=red];
		j3871007239 -> j2695686480;
