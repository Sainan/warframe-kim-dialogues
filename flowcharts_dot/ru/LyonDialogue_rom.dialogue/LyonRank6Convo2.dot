	j563633888 [label="Да, ну что ж. Кажется, я начинаю понимать, как это произошло.",shape=box,color=blue];
		j563633888 -> "Chat ends.";
	j3684999980 [label="Если бы тебе было слышно, как я смеюсь. Но я тебя не осуждаю, я искренне сочувствую, больше, чем ты можешь себе представить. И именно поэтому я помогу.",shape=box,color=blue];
