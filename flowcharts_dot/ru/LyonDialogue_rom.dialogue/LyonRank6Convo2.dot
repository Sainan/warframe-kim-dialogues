		j1310452999 -> "Chat ends.";
	j391526169 [label="Мари — сестра моей души, и дьявол мне должен услугу. Я не буду говорить, как это случилось, это секрет, который я намерен унести с собой в могилу, так что не утруждайся спрашивать об этом.",shape=box,color=blue];
		j391526169 -> j1084797099;
