digraph {
	1076 [label="LyonRank4Convo5 begins.",color=orange];
		1076 -> 1077;
	1077 [label="Check boolean LyonSerum1",color=orange];
		1077 -> 1079 [label=true,color=green];
		1077 -> 1080 [label=true,color=green];
		1077 -> 1078 [label=false,color=brown];
		1077 -> 1080 [label=false,color=brown];
	1079 [label="Лион, мне интересно, могу ли я услышать остальную часть истории о том, как Роyт пришел в собор вместе с тобой и Мари?",shape=box,color=red];
		1079 -> 1082;
	1080 [label="[Конец.]",shape=box,color=red];
		1080 -> 1083;
	1078 [label="Лион, мне интересно, могу ли я услышать историю о том, как Роyт пришел в собор вместе с тобой и Мари?",shape=box,color=red];
		1078 -> 1081;
	1082 [label="Как хочешь. Однако это не самая приятная история. Его подбросили к нашему порогу, как раненого дикого кота.",shape=box,color=blue];
		1082 -> 1084;
	1083 [label="Chat ends.",color=orange];
	1081 [label="Как хочешь. Его бросили у нашего порога, как раненого дикого кота. История не из самых приятных.",shape=box,color=blue];
		1081 -> 1084;
	1084 [label="Evaluate expressions",color=orange];
		1084 -> 1087 [label="LyonStray",color=purple];
		1084 -> 1086 [label="RoatheSerum1",color=purple];
		1084 -> 1085 [label="false",color=purple];
	1087 [label="Я был прав, эта история предназначалась для Роута.",shape=box,color=red];
		1087 -> 1090;
	1086 [label="С его точки зрения, у него было полное основание быть немного… диким, когда он появился.",shape=box,color=red];
		1086 -> 1089;
	1085 [label="Ладно, продолжай.",shape=box,color=red];
		1085 -> 1088;
	1090 [label="Это была история о бродячем коте, который раньше навещал Собор. То, что ты усвоишь из её смысла, или моя причина, по которой я рассказал её тебе, — полностью твоя ответственность. Я же священник, не так ли?",shape=box,color=blue];
		1090 -> 1088;
	1089 [label="Я бы ожидал, что человек его положения и характера будет чувствовать себя обиженным действиями Энтрати. Честно говоря, я был бы гораздо более ошеломлён, если бы он отнёсся к этому достойно.",shape=box,color=blue];
		1089 -> 1088;
	1088 [label="Evaluate expressions",color=orange];
		1088 -> 1092 [label="LyonSerum1",color=purple];
		1088 -> 1091 [label="false",color=purple];
	1092 [label="Полагаю, там, где я нас оставил, Энтрати недавно вернулся из своего исчезновения вместе с Роутом, таким, каким мы его видим сейчас, уже изменившимся. Энтрати раскрыл нам всю ложь, которую он произносил более трёх лет.",shape=box,color=blue];
		1092 -> 1094;
	1091 [label="Я постараюсь кратко изложить события, которые привели к тому моменту, иначе это может показаться… по крайней мере, бессмысленным.",shape=box,color=blue];
		1091 -> 1093;
	1094 [label="Он предложил нам «сыворотки протофреймов», которые сделали нас теми, кто мы есть сейчас, а как только мы их приняли… сразу же снова оставил нас.",shape=box,color=blue];
		1094 -> 1096;
	1093 [label="Три года, два месяца и одиннадцать дней он служил в нашем Соборе как Cardinal Dimanche. И всё это время Мари и я служили ему, не ведая о его планах для нас.",shape=box,color=blue];
		1093 -> 1095;
	1096 [label="И вот мы остались там, как недавно осиротевшие амальгамы, с телами и душами, переделанными в создания, которые мы едва могли понять, не говоря уже о том, чтобы овладеть ими.",shape=box,color=blue];
		1096 -> 1098;
	1095 [label="Я знаю твои вопросы, ещё прежде чем ты их задашь. Что он замышлял? Заразил ли он город, как, как я слышал, он сделал с Хёльванией? Каковы были его планы? Его открытия?",shape=box,color=blue];
		1095 -> 1097;
	1098 [label="Застряв в городе, который был нашим домом, но больше не был нам дружелюбен. Нам пришлось… скрываться.",shape=box,color=blue];
		1098 -> 1100;
		1098 -> 1101;
	1097 [label="На это я скажу, ты будешь разочарован. Он проповедовал. Он изучал. Он отдыхал. И он молился. Затем, однажды ночью, он исчез посреди страшной бури. Той самой, в которой он появился.",shape=box,color=blue];
		1097 -> 1099;
	1100 [label="Из-за того, как ты выглядел?",shape=box,color=red];
		1100 -> 1104;
	1101 [label="Собор отверг вас?",shape=box,color=red];
		1101 -> 1105;
	1099 [label="Check boolean MarieLyonVisions",color=orange];
		1099 -> 1103 [label=true,color=green];
		1099 -> 1102 [label=false,color=brown];
	1104 [label="Не уверен, ускользнуло ли это от твоего внимания, но Мари умеет летать, а Роут… синий, помимо прочих особенностей.",shape=box,color=blue];
		1104 -> 1107;
	1105 [label="Не… совсем так. Нас вынудили отказаться от общественной жизни. Но наши братья и сёстры не изгоняли нас на улицу и не сжигали на костре. «Cardinal Dimanche» убедил их, что наши изменения… дело Светил.",shape=box,color=blue];
		1105 -> 1108;
	1103 [label="Хотя я прекрасно понимаю, что для других эта буря не имела значения, для меня она была весьма отчетливой.",shape=box,color=blue];
		1103 -> 1102;
	1102 [label="Ровно через год он появился в последний раз, и вот... Роут, каким ты видишь его сейчас, лежит у его ног без сознания.",shape=box,color=blue];
		1102 -> 1106;
	1107 [label="Я знаю, что ты проводишь дни, балуясь с говорящими животными и черепами и размышляя о вопросе космической Бездны, но для большинства людей это не считается обычным.",shape=box,color=blue];
		1107 -> 1110;
	1108 [label="Нас прятали в склепах, скрывая от посторонних глаз. Наши бывшие братья, хоть и боялись нас, приносили нам припасы.",shape=box,color=blue];
		1108 -> 1111;
	1106 [label="Дьявол во плоти, или так казалось. Именно тогда Энтрати открыл нам правду о том, кто он такой, когда явился, и какое истинное задание он нам поручил. Он избрал нас обоих для самой «священной миссии».",shape=box,color=blue];
		1106 -> 1109;
	1110 [label="Действительно, я тот из нас троих, кто, возможно, мог бы бродить среди толпы, если бы достаточно хорошо укрыл себя. ",shape=box,color=blue];
		1110 -> 1113;
		1110 -> 1114;
	1111 [label="Они… настаивали на том, чтобы общаться только с Мари, несмотря на её внезапные, призрачные появления на лестнице, когда она встречала их. ",shape=box,color=blue];
		1111 -> 1115;
		1111 -> 1116;
	1109 [label="Мари легко приняла сыворотку. Конечно, она это сделала. Как она могла не сделать этого? И как я мог не последовать за ней? Как я мог не искать истину, куда бы она ни привела?",shape=box,color=blue];
		1109 -> 1112;
	1113 [label="Где вы жили?",shape=box,color=red];
		1113 -> 1120;
	1114 [label="Как вы все здесь оказались?",shape=box,color=red];
		1114 -> 1121;
	1115 [label="Я могу понять, почему избегают Роут, но… они предпочли бы это, чем говорить с тобой?",shape=box,color=red];
		1115 -> 1122;
	1116 [label="Она очень милая...",shape=box,color=red];
		1116 -> 1123;
	1112 [label="Update boolean LyonSerum1",color=orange];
		1112 -> 1117;
		1112 -> 1118;
		1112 -> 1119;
	1120 [label="Наши братья и сёстры не изгоняли нас на улицу и не сжигали на костре. «Cardinal Dimanche» убедил их, что наши изменения… дело Светил.",shape=box,color=blue];
		1120 -> 1127;
	1121 [label="Роут узнает все подробности того, «как» именно, но после… многих лет работы он создал «Гельминта» из образцов нашей крови.",shape=box,color=blue];
		1121 -> 1128;
	1122 [label="Я полагаю, мы уже встречались, не так ли?",shape=box,color=blue];
		1122 -> 1129;
	1123 [label="Именно так.",shape=box,color=blue];
		1123 -> 1130;
	1117 [label="Мне кажется, она все еще слишком сильно поклоняется Энтрати.",shape=box,color=red];
		1117 -> 1124;
	1118 [label="Что произошло потом?",shape=box,color=red];
		1118 -> 1125;
	1119 [label="Ты жалеешь об этом?",shape=box,color=red];
		1119 -> 1126;
	1127 [label="Нас прятали в склепах, скрывая от посторонних глаз. Наши бывшие братья, хоть и боялись нас, приносили нам припасы.",shape=box,color=blue];
		1127 -> 1134;
	1128 [label="Я считаю, что Заражение каким-то образом связано само с собой через... время... хотя подробности мне совершенно не понятны.",shape=box,color=blue];
		1128 -> 1135;
		1128 -> 1136;
	1129 [label="Как долго вы все были там заперты?",shape=box,color=red];
		1129 -> 1137;
	1130 [label="Так... они держали вас всех в подвале?",shape=box,color=red];
		1130 -> 1138;
	1124 [label="Update boolean LyonMarieEntrati",color=orange];
		1124 -> 1131;
	1125 [label="Роут очнулся. Сначала он едва помнил своё имя. Энтрати сказал последнюю фразу этому ублюдку: «Уриэль, Еретик Ксеты, в изгнании, ответь - могут ли Орокин когда-либо быть прощены?",shape=box,color=blue];
		1125 -> 1132;
	1126 [label="Я жалею обо всём, Скиталец. Да, конечно, жалею. Но сделал бы я это снова? Да, конечно, сделал бы. Я не могу оставить Мари одну.",shape=box,color=blue];
		1126 -> 1133;
	1134 [label="Они… настаивали на том, чтобы общаться только с Мари, несмотря на её внезапные, призрачные появления на лестнице, когда она встречала их. ",shape=box,color=blue];
		1134 -> 1139;
		1134 -> 1140;
	1135 [label="Он воссоздал Гельминта?! Сколько времени это заняло?!",shape=box,color=red];
		1135 -> 1141;
	1136 [label="Я не думаю, что кто-либо это понимает. Это новое открытие.",shape=box,color=red];
		1136 -> 1142;
	1137 [label="Возможно, я не тот, кого тебе стоит спрашивать о том, сколько лет прошло после того, как мы превратились в говорящих заражённых амальгам. Моё восприятие времени с тех пор... запуталось.",shape=box,color=blue];
		1137 -> 1143;
		1137 -> 1144;
	1138 [label="Возможно, это звучит более сурово, чем кажется. Больше нас некуда было разместить. Колокольня была слишком открытой, слишком открытой для суровой стихии. В склепе было тепло и уютно.",shape=box,color=blue];
		1138 -> 1145;
	1131 [label="В этом мы согласны. Но я также не могу её за это осуждать. Дай ей время. Она придёт к пониманию. Она невероятно умна, Скиталец. Не относись к ней как к глупой.",shape=box,color=blue];
		1131 -> 1133;
	1132 [label="Энтрати тогда ушёл в последний раз. И оставил Роут с нами, теперь уже изменившегося в того, кого ты видишь сейчас - лучше подготовленного к общению с своенравным дьяволом.",shape=box,color=blue];
		1132 -> 1096;
	1133 [label="Продолжая рассказ.. Энтрати тогда ушёл в последний раз. И оставил Роут с нами, теперь уже изменившегося в того, кого ты видишь сейчас - лучше подготовленного к общению с своенравным дьяволом.",shape=box,color=blue];
		1133 -> 1096;
	1139 [label="Я могу понять, почему избегают Роут, но… они предпочли бы это, чем говорить с тобой?",shape=box,color=red];
		1139 -> 1146;
	1140 [label="Она очень милая...",shape=box,color=red];
		1140 -> 1147;
	1141 [label="Update boolean LyonRoatheHelminth",color=orange];
		1141 -> 1148;
	1142 [label="Не знаю, утешает это или тревожит, спасибо. Довольно странно узнать, что Заражение теперь умеет говорить.",shape=box,color=blue];
		1142 -> 1149;
		1142 -> 1150;
	1143 [label="Запуталось, как?",shape=box,color=red];
		1143 -> 1151;
	1144 [label="Я не уверен, стоит ли мне говорить тебе, что Заражение тоже умеет говорить...",shape=box,color=red];
		1144 -> 1152;
	1145 [label="И, к сожалению, мы обнаружили, что там есть выходы, которые Роут мог использовать, чтобы... бродить.",shape=box,color=blue];
		1145 -> 1153;
	1146 [label="Я полагаю, мы уже встречались, не так ли?",shape=box,color=blue];
		1146 -> 1129;
		1146 -> 1130;
	1147 [label="Именно так.",shape=box,color=blue];
		1147 -> 1130;
		1147 -> 1129;
	1148 [label="Возможно, я не тот, кого тебе стоит спрашивать. Моё восприятие времени с тех пор стало... запутанным. Хотя, возможно, точнее будет сказать «ещё более запутанным». Как будто ужаснее уже быть не может...",shape=box,color=blue];
		1148 -> 1143;
		1148 -> 1144;
	1149 [label="Не все предметы быта. Стулья иногда могут быть… ну… не важно, продолжай, пожалуйста.",shape=box,color=red];
		1149 -> 1154;
	1150 [label="Я избавлю тебя от разговора о гитаре.",shape=box,color=red];
		1150 -> 1155;
	1151 [label="Update boolean LyonTime1",color=orange];
		1151 -> 1156;
	1152 [label="Поверьте, я знаю. И это сбивает с толку, спасибо. Хотя, кажется, каждый случайный предмет обихода в этом месте умеет говорить.",shape=box,color=blue];
		1152 -> 1149;
		1152 -> 1150;
	1153 [label="Evaluate expressions",color=orange];
		1153 -> 1157 [label="MarieRoathePastry1",color=purple];
		1153 -> 1157 [label="RoatheMariePastry1",color=purple];
		1153 -> 1158 [label="false",color=purple];
	1154 [label="Если ты собирался сказать слово «занят», то я тоже его видел, Скиталец. Того, что шептал. Того, что в стене. Я слышал стук...",shape=box,color=blue];
		1154 -> 1159;
	1155 [label="Пожалуйста, избавь. Хотя, думаю, мне было бы куда легче, если бы музыкальный инструмент оказался каким‑нибудь мимолётным полубогом, а не… чем бы ни являлось то, что пришло терзать и оставлять мой разум. Странно ли это, что я… с тех пор как он...",shape=box,color=blue];
		1155 -> 1160;
	1156 [label="Я не уверен, связано ли это просто с моей уникальной чувствительностью к этому делу, или из‑за… индивидуальных обстоятельств моего создания, или… его -",shape=box,color=blue];
		1156 -> 1161;
	1157 [label="Так я и слышал.",shape=box,color=red];
		1157 -> 1162;
	1158 [label="Да?",shape=box,color=red];
		1158 -> 1163;
	1159 [label="Есть голос, который призывает меня, и я знаю, что не слышал его всю свою жизнь, но он тянется в моё прошлое и далеко в моё будущее...",shape=box,color=blue];
		1159 -> 1164;
	1160 [label="Он?",shape=box,color=red];
		1160 -> 1159;
	1161 [label="И знаю, ты подумаешь, что я сумасшедший, когда скажу это, но я не воспринимаю время… полностью… линейно.",shape=box,color=blue];
		1161 -> 1165;
		1161 -> 1166;
	1162 [label="Думаю, это одна из его немногих оправдательных черт. Не кража, заметь. А причина, стоящая за ней. По моей теории, он добывал эти незаконные вещи, чтобы подтолкнуть Мари к разговорам с ним.",shape=box,color=blue];
		1162 -> 1167;
	1163 [label="Ни здесь, ни там.",shape=box,color=blue];
		1163 -> 1168;
		1163 -> 1169;
	1164 [label="Это не может быть так, чтобы он всегда был там. И всё же теперь я могу вспомнить его, такой же ясный, как серебряный свет самой Луа, за стеной дома моего детства. Голос молодого человека. Присутствие ещё одного, стоящего рядом с ним… «Рэп, тук, тук...»",shape=box,color=blue];
		1164 -> 1170;
	1165 [label="«Его?» Кто такой «он»?",shape=box,color=red];
		1165 -> 1159;
	1166 [label="Мне пришлось переживать время на протяжении неисчислимых столетий как повторяющиеся спирали, Лион.",shape=box,color=red];
		1166 -> 1171;
	1167 [label="И, возможно, потому, что они заставляли её улыбаться, когда она думала, что он не смотрит. Однажды он сказал мне: «Это большая вина судьбы, что она так обделена жизнью».",shape=box,color=blue];
		1167 -> 1172;
	1168 [label="Сколько времени ушло на то, чтобы вы все вернулись… ну, к тому, что есть сейчас?",shape=box,color=red];
		1168 -> 1173;
	1169 [label="Что произошло потом?",shape=box,color=red];
		1169 -> 1121;
	1170 [label="Я… прости меня. Мне нужно уйти. Я не могу говорить об этом сейчас. Мне… мне жаль. Не спрашивай меня об этом снова.",shape=box,color=blue];
		1170 -> 1174;
	1171 [label="Что же ты скажешь, когда я говорю о голосе, что манил меня из-за пределов моего собственного рационального разума? Я знаю, что не слышал его всю свою жизнь. Не может быть, чтобы он всегда был там.",shape=box,color=blue];
		1171 -> 1175;
	1172 [label="Update boolean LyonRoathePastry",color=orange];
		1172 -> 1176;
		1172 -> 1168;
	1173 [label="Возможно, я не тот, кого тебе стоит спрашивать о том, сколько лет прошло после того, как мы превратились в говорящих заражённых амальгам. Моё восприятие времени с тех пор... запуталось.",shape=box,color=blue];
		1173 -> 1144;
		1173 -> 1143;
	1174 [label="Лион, подожди!",shape=box,color=red];
		1174 -> 1177;
	1175 [label="Но я помню его и сейчас, так же ясно, как серебряный свет самой Луа, за стеной дома моего детства. Молодой мужской голос... «Рэп, тук, тук...»",shape=box,color=blue];
		1175 -> 1170;
	1176 [label="Вот это уже почти умилительно для него, ты прав. И что было дальше?",shape=box,color=red];
		1176 -> 1121;
	1177 [label="Update boolean LyonRell1",color=orange];
		1177 -> 1178;
	1178 [label="+20 Chemistry",color=orange];
		1178 -> 1179;
	1179 [label="Chat ends.",color=orange];
}