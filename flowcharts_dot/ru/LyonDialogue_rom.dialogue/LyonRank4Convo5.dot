digraph {
	graph [fontname="Roboto Condensed"];
	node [fontname="Roboto Condensed"];
	edge [fontname="Roboto Condensed"];

	"LyonRank4Convo5 begins." [color=orange];
		"LyonRank4Convo5 begins." -> j3425926750;
	j3425926750 [label="Check boolean LyonSerum1",color=orange];
		j3425926750 -> j2616742376 [label=true,color=green];
		j3425926750 -> j1310452999 [label=true,color=green];
		j3425926750 -> j1118462167 [label=false,color=brown];
		j3425926750 -> j1310452999 [label=false,color=brown];
	j2616742376 [label="Лион, мне интересно, могу ли я услышать остальную часть истории о том, как Роyт пришел в собор вместе с тобой и Мари?",shape=box,color=red];
		j2616742376 -> j342863009;
	j1310452999 [label="[Конец.]",shape=box,color=red];
		j1310452999 -> "Chat ends.";
	j1118462167 [label="Лион, мне интересно, могу ли я услышать историю о том, как Роyт пришел в собор вместе с тобой и Мари?",shape=box,color=red];
		j1118462167 -> j3286516042;
	j342863009 [label="Как хочешь. Однако это не самая приятная история. Его подбросили к нашему порогу, как раненого дикого кота.",shape=box,color=blue];
		j342863009 -> j3769319211;
	"Chat ends." [color=orange];
	j3286516042 [label="Как хочешь. Его бросили у нашего порога, как раненого дикого кота. История не из самых приятных.",shape=box,color=blue];
		j3286516042 -> j3769319211;
	j3769319211 [label="Evaluate expressions",color=orange];
		j3769319211 -> j3323397374 [label="LyonStray",color=purple];
		j3769319211 -> j2919460924 [label="RoatheSerum1",color=purple];
		j3769319211 -> j3453388784 [label="false",color=purple];
	j3323397374 [label="Я был прав, эта история предназначалась для Роута.",shape=box,color=red];
		j3323397374 -> j3234094144;
	j2919460924 [label="С его точки зрения, у него было полное основание быть немного… диким, когда он появился.",shape=box,color=red];
		j2919460924 -> j675185694;
	j3453388784 [label="Ладно, продолжай.",shape=box,color=red];
		j3453388784 -> j2266356665;
	j3234094144 [label="Это была история о бродячем коте, который раньше навещал Собор. То, что ты усвоишь из её смысла, или моя причина, по которой я рассказал её тебе, — полностью твоя ответственность. Я же священник, не так ли?",shape=box,color=blue];
		j3234094144 -> j2266356665;
	j675185694 [label="Я бы ожидал, что человек его положения и характера будет чувствовать себя обиженным действиями Энтрати. Честно говоря, я был бы гораздо более ошеломлён, если бы он отнёсся к этому достойно.",shape=box,color=blue];
		j675185694 -> j2266356665;
	j2266356665 [label="Evaluate expressions",color=orange];
		j2266356665 -> j936137800 [label="LyonSerum1",color=purple];
		j2266356665 -> j2825147735 [label="false",color=purple];
	j936137800 [label="Полагаю, там, где я нас оставил, Энтрати недавно вернулся из своего исчезновения вместе с Роутом, таким, каким мы его видим сейчас, уже изменившимся. Энтрати раскрыл нам всю ложь, которую он произносил более трёх лет.",shape=box,color=blue];
		j936137800 -> j1153024307;
	j2825147735 [label="Я постараюсь кратко изложить события, которые привели к тому моменту, иначе это может показаться… по крайней мере, бессмысленным.",shape=box,color=blue];
		j2825147735 -> j3374229985;
	j1153024307 [label="Он предложил нам «сыворотки протофреймов», которые сделали нас теми, кто мы есть сейчас, а как только мы их приняли… сразу же снова оставил нас.",shape=box,color=blue];
		j1153024307 -> j3300554822;
	j3374229985 [label="Три года, два месяца и одиннадцать дней он служил в нашем Соборе как Cardinal Dimanche. И всё это время Мари и я служили ему, не ведая о его планах для нас.",shape=box,color=blue];
		j3374229985 -> j1281646941;
	j3300554822 [label="И вот мы остались там, как недавно осиротевшие амальгамы, с телами и душами, переделанными в создания, которые мы едва могли понять, не говоря уже о том, чтобы овладеть ими.",shape=box,color=blue];
		j3300554822 -> j3021059063;
	j1281646941 [label="Я знаю твои вопросы, ещё прежде чем ты их задашь. Что он замышлял? Заразил ли он город, как, как я слышал, он сделал с Хёльванией? Каковы были его планы? Его открытия?",shape=box,color=blue];
		j1281646941 -> j1360824985;
	j3021059063 [label="Застряв в городе, который был нашим домом, но больше не был нам дружелюбен. Нам пришлось… скрываться.",shape=box,color=blue];
		j3021059063 -> j2612104917;
		j3021059063 -> j4512183;
	j1360824985 [label="На это я скажу, ты будешь разочарован. Он проповедовал. Он изучал. Он отдыхал. И он молился. Затем, однажды ночью, он исчез посреди страшной бури. Той самой, в которой он появился.",shape=box,color=blue];
		j1360824985 -> j2575044127;
	j2612104917 [label="Из-за того, как ты выглядел?",shape=box,color=red];
		j2612104917 -> j878589314;
	j4512183 [label="Собор отверг вас?",shape=box,color=red];
		j4512183 -> j895671966;
	j2575044127 [label="Check boolean MarieLyonVisions",color=orange];
		j2575044127 -> j449566239 [label=true,color=green];
		j2575044127 -> j1527096223 [label=false,color=brown];
	j878589314 [label="Не уверен, ускользнуло ли это от твоего внимания, но Мари умеет летать, а Роут… синий, помимо прочих особенностей.",shape=box,color=blue];
		j878589314 -> j4288962859;
	j895671966 [label="Не… совсем так. Нас вынудили отказаться от общественной жизни. Но наши братья и сёстры не изгоняли нас на улицу и не сжигали на костре. «Cardinal Dimanche» убедил их, что наши изменения… дело Светил.",shape=box,color=blue];
		j895671966 -> j1711721867;
	j449566239 [label="Хотя я прекрасно понимаю, что для других эта буря не имела значения, для меня она была весьма отчетливой.",shape=box,color=blue];
		j449566239 -> j1527096223;
	j1527096223 [label="Ровно через год он появился в последний раз, и вот... Роут, каким ты видишь его сейчас, лежит у его ног без сознания.",shape=box,color=blue];
		j1527096223 -> j2603971916;
	j4288962859 [label="Я знаю, что ты проводишь дни, балуясь с говорящими животными и черепами и размышляя о вопросе космической Бездны, но для большинства людей это не считается обычным.",shape=box,color=blue];
		j4288962859 -> j3640858807;
	j1711721867 [label="Нас прятали в склепах, скрывая от посторонних глаз. Наши бывшие братья, хоть и боялись нас, приносили нам припасы.",shape=box,color=blue];
		j1711721867 -> j2780757512;
	j2603971916 [label="Дьявол во плоти, или так казалось. Именно тогда Энтрати открыл нам правду о том, кто он такой, когда явился, и какое истинное задание он нам поручил. Он избрал нас обоих для самой «священной миссии».",shape=box,color=blue];
		j2603971916 -> j2595859219;
	j3640858807 [label="Действительно, я тот из нас троих, кто, возможно, мог бы бродить среди толпы, если бы достаточно хорошо укрыл себя. ",shape=box,color=blue];
		j3640858807 -> j774111821;
		j3640858807 -> j809429761;
	j2780757512 [label="Они… настаивали на том, чтобы общаться только с Мари, несмотря на её внезапные, призрачные появления на лестнице, когда она встречала их. ",shape=box,color=blue];
		j2780757512 -> j2010850705;
		j2780757512 -> j1329034906;
	j2595859219 [label="Мари легко приняла сыворотку. Конечно, она это сделала. Как она могла не сделать этого? И как я мог не последовать за ней? Как я мог не искать истину, куда бы она ни привела?",shape=box,color=blue];
		j2595859219 -> j249472217;
	j774111821 [label="Где вы жили?",shape=box,color=red];
		j774111821 -> j3050061589;
	j809429761 [label="Как вы все здесь оказались?",shape=box,color=red];
		j809429761 -> j3497223749;
	j2010850705 [label="Я могу понять, почему избегают Роут, но… они предпочли бы это, чем говорить с тобой?",shape=box,color=red];
		j2010850705 -> j3466499544;
	j1329034906 [label="Она очень милая...",shape=box,color=red];
		j1329034906 -> j1903315080;
	j249472217 [label="Boolean LyonSerum1 is now true.",color=orange];
		j249472217 -> j3561659615;
		j249472217 -> j2808696910;
		j249472217 -> j1203633850;
	j3050061589 [label="Наши братья и сёстры не изгоняли нас на улицу и не сжигали на костре. «Cardinal Dimanche» убедил их, что наши изменения… дело Светил.",shape=box,color=blue];
		j3050061589 -> j1572938848;
	j3497223749 [label="Роут узнает все подробности того, «как» именно, но после… многих лет работы он создал «Гельминта» из образцов нашей крови.",shape=box,color=blue];
		j3497223749 -> j1284702753;
	j3466499544 [label="Я полагаю, мы уже встречались, не так ли?",shape=box,color=blue];
		j3466499544 -> j3946381470;
	j1903315080 [label="Именно так.",shape=box,color=blue];
		j1903315080 -> j412605056;
	j3561659615 [label="Мне кажется, она все еще слишком сильно поклоняется Энтрати.",shape=box,color=red];
		j3561659615 -> j415397419;
	j2808696910 [label="Что произошло потом?",shape=box,color=red];
		j2808696910 -> j469565261;
	j1203633850 [label="Ты жалеешь об этом?",shape=box,color=red];
		j1203633850 -> j2854100056;
	j1572938848 [label="Нас прятали в склепах, скрывая от посторонних глаз. Наши бывшие братья, хоть и боялись нас, приносили нам припасы.",shape=box,color=blue];
		j1572938848 -> j394969288;
	j1284702753 [label="Я считаю, что Заражение каким-то образом связано само с собой через... время... хотя подробности мне совершенно не понятны.",shape=box,color=blue];
		j1284702753 -> j1433375070;
		j1284702753 -> j1853978888;
	j3946381470 [label="Как долго вы все были там заперты?",shape=box,color=red];
		j3946381470 -> j2037617509;
	j412605056 [label="Так... они держали вас всех в подвале?",shape=box,color=red];
		j412605056 -> j2139600117;
	j415397419 [label="Boolean LyonMarieEntrati is now true.",color=orange];
		j415397419 -> j4270311454;
	j469565261 [label="Роут очнулся. Сначала он едва помнил своё имя. Энтрати сказал последнюю фразу этому ублюдку: «Уриэль, Еретик Ксеты, в изгнании, ответь - могут ли Орокин когда-либо быть прощены?",shape=box,color=blue];
		j469565261 -> j1775167758;
	j2854100056 [label="Я жалею обо всём, Скиталец. Да, конечно, жалею. Но сделал бы я это снова? Да, конечно, сделал бы. Я не могу оставить Мари одну.",shape=box,color=blue];
		j2854100056 -> j1528412933;
	j394969288 [label="Они… настаивали на том, чтобы общаться только с Мари, несмотря на её внезапные, призрачные появления на лестнице, когда она встречала их. ",shape=box,color=blue];
		j394969288 -> j3974701372;
		j394969288 -> j2483248175;
	j1433375070 [label="Он воссоздал Гельминта?! Сколько времени это заняло?!",shape=box,color=red];
		j1433375070 -> j972707512;
	j1853978888 [label="Я не думаю, что кто-либо это понимает. Это новое открытие.",shape=box,color=red];
		j1853978888 -> j2155692897;
	j2037617509 [label="Возможно, я не тот, кого тебе стоит спрашивать о том, сколько лет прошло после того, как мы превратились в говорящих заражённых амальгам. Моё восприятие времени с тех пор... запуталось.",shape=box,color=blue];
		j2037617509 -> j185365133;
		j2037617509 -> j1717167911;
	j2139600117 [label="Возможно, это звучит более сурово, чем кажется. Больше нас некуда было разместить. Колокольня была слишком открытой, слишком открытой для суровой стихии. В склепе было тепло и уютно.",shape=box,color=blue];
		j2139600117 -> j2830593208;
	j4270311454 [label="В этом мы согласны. Но я также не могу её за это осуждать. Дай ей время. Она придёт к пониманию. Она невероятно умна, Скиталец. Не относись к ней как к глупой.",shape=box,color=blue];
		j4270311454 -> j1528412933;
	j1775167758 [label="Энтрати тогда ушёл в последний раз. И оставил Роут с нами, теперь уже изменившегося в того, кого ты видишь сейчас - лучше подготовленного к общению с своенравным дьяволом.",shape=box,color=blue];
		j1775167758 -> j3300554822;
	j1528412933 [label="Продолжая рассказ.. Энтрати тогда ушёл в последний раз. И оставил Роут с нами, теперь уже изменившегося в того, кого ты видишь сейчас - лучше подготовленного к общению с своенравным дьяволом.",shape=box,color=blue];
		j1528412933 -> j3300554822;
	j3974701372 [label="Я могу понять, почему избегают Роут, но… они предпочли бы это, чем говорить с тобой?",shape=box,color=red];
		j3974701372 -> j845943027;
	j2483248175 [label="Она очень милая...",shape=box,color=red];
		j2483248175 -> j3975628287;
	j972707512 [label="Boolean LyonRoatheHelminth is now true.",color=orange];
		j972707512 -> j3842744958;
	j2155692897 [label="Не знаю, утешает это или тревожит, спасибо. Довольно странно узнать, что Заражение теперь умеет говорить.",shape=box,color=blue];
		j2155692897 -> j2655685506;
		j2155692897 -> j719258401;
	j185365133 [label="Запуталось, как?",shape=box,color=red];
		j185365133 -> j1062891382;
	j1717167911 [label="Я не уверен, стоит ли мне говорить тебе, что Заражение тоже умеет говорить...",shape=box,color=red];
		j1717167911 -> j2858703092;
	j2830593208 [label="И, к сожалению, мы обнаружили, что там есть выходы, которые Роут мог использовать, чтобы... бродить.",shape=box,color=blue];
		j2830593208 -> j845860967;
	j845943027 [label="Я полагаю, мы уже встречались, не так ли?",shape=box,color=blue];
		j845943027 -> j3946381470;
		j845943027 -> j412605056;
	j3975628287 [label="Именно так.",shape=box,color=blue];
		j3975628287 -> j412605056;
		j3975628287 -> j3946381470;
	j3842744958 [label="Возможно, я не тот, кого тебе стоит спрашивать. Моё восприятие времени с тех пор стало... запутанным. Хотя, возможно, точнее будет сказать «ещё более запутанным». Как будто ужаснее уже быть не может...",shape=box,color=blue];
		j3842744958 -> j185365133;
		j3842744958 -> j1717167911;
	j2655685506 [label="Не все предметы быта. Стулья иногда могут быть… ну… не важно, продолжай, пожалуйста.",shape=box,color=red];
		j2655685506 -> j4125627168;
	j719258401 [label="Я избавлю тебя от разговора о гитаре.",shape=box,color=red];
		j719258401 -> j2096301888;
	j1062891382 [label="Boolean LyonTime1 is now true.",color=orange];
		j1062891382 -> j3902735655;
	j2858703092 [label="Поверьте, я знаю. И это сбивает с толку, спасибо. Хотя, кажется, каждый случайный предмет обихода в этом месте умеет говорить.",shape=box,color=blue];
		j2858703092 -> j2655685506;
		j2858703092 -> j719258401;
	j845860967 [label="Evaluate expressions",color=orange];
		j845860967 -> j1903179588 [label="MarieRoathePastry1",color=purple];
		j845860967 -> j1903179588 [label="RoatheMariePastry1",color=purple];
		j845860967 -> j3177399546 [label="false",color=purple];
	j4125627168 [label="Если ты собирался сказать слово «занят», то я тоже его видел, Скиталец. Того, что шептал. Того, что в стене. Я слышал стук...",shape=box,color=blue];
		j4125627168 -> j3941034666;
	j2096301888 [label="Пожалуйста, избавь. Хотя, думаю, мне было бы куда легче, если бы музыкальный инструмент оказался каким‑нибудь мимолётным полубогом, а не… чем бы ни являлось то, что пришло терзать и оставлять мой разум. Странно ли это, что я… с тех пор как он...",shape=box,color=blue];
		j2096301888 -> j2429991298;
	j3902735655 [label="Я не уверен, связано ли это просто с моей уникальной чувствительностью к этому делу, или из‑за… индивидуальных обстоятельств моего создания, или… его -",shape=box,color=blue];
		j3902735655 -> j1413873888;
	j1903179588 [label="Так я и слышал.",shape=box,color=red];
		j1903179588 -> j3813214293;
	j3177399546 [label="Да?",shape=box,color=red];
		j3177399546 -> j1085074346;
	j3941034666 [label="Есть голос, который призывает меня, и я знаю, что не слышал его всю свою жизнь, но он тянется в моё прошлое и далеко в моё будущее...",shape=box,color=blue];
		j3941034666 -> j1223085005;
	j2429991298 [label="Он?",shape=box,color=red];
		j2429991298 -> j3941034666;
	j1413873888 [label="И знаю, ты подумаешь, что я сумасшедший, когда скажу это, но я не воспринимаю время… полностью… линейно.",shape=box,color=blue];
		j1413873888 -> j3672382235;
		j1413873888 -> j1207647512;
	j3813214293 [label="Думаю, это одна из его немногих оправдательных черт. Не кража, заметь. А причина, стоящая за ней. По моей теории, он добывал эти незаконные вещи, чтобы подтолкнуть Мари к разговорам с ним.",shape=box,color=blue];
		j3813214293 -> j1347127734;
	j1085074346 [label="Ни здесь, ни там.",shape=box,color=blue];
		j1085074346 -> j1765009034;
		j1085074346 -> j3958572001;
	j1223085005 [label="Это не может быть так, чтобы он всегда был там. И всё же теперь я могу вспомнить его, такой же ясный, как серебряный свет самой Луа, за стеной дома моего детства. Голос молодого человека. Присутствие ещё одного, стоящего рядом с ним… «Рэп, тук, тук...»",shape=box,color=blue];
		j1223085005 -> j2236401606;
	j3672382235 [label="«Его?» Кто такой «он»?",shape=box,color=red];
		j3672382235 -> j3941034666;
	j1207647512 [label="Мне пришлось переживать время на протяжении неисчислимых столетий как повторяющиеся спирали, Лион.",shape=box,color=red];
		j1207647512 -> j2959384799;
	j1347127734 [label="И, возможно, потому, что они заставляли её улыбаться, когда она думала, что он не смотрит. Однажды он сказал мне: «Это большая вина судьбы, что она так обделена жизнью».",shape=box,color=blue];
		j1347127734 -> j3733610902;
	j1765009034 [label="Сколько времени ушло на то, чтобы вы все вернулись… ну, к тому, что есть сейчас?",shape=box,color=red];
		j1765009034 -> j698161568;
	j3958572001 [label="Что произошло потом?",shape=box,color=red];
		j3958572001 -> j3497223749;
	j2236401606 [label="Я… прости меня. Мне нужно уйти. Я не могу говорить об этом сейчас. Мне… мне жаль. Не спрашивай меня об этом снова.",shape=box,color=blue];
		j2236401606 -> j3683603386;
	j2959384799 [label="Что же ты скажешь, когда я говорю о голосе, что манил меня из-за пределов моего собственного рационального разума? Я знаю, что не слышал его всю свою жизнь. Не может быть, чтобы он всегда был там.",shape=box,color=blue];
		j2959384799 -> j2081382084;
	j3733610902 [label="Boolean LyonRoathePastry is now true.",color=orange];
		j3733610902 -> j1814919830;
		j3733610902 -> j1765009034;
	j698161568 [label="Возможно, я не тот, кого тебе стоит спрашивать о том, сколько лет прошло после того, как мы превратились в говорящих заражённых амальгам. Моё восприятие времени с тех пор... запуталось.",shape=box,color=blue];
		j698161568 -> j1717167911;
		j698161568 -> j185365133;
	j3683603386 [label="Лион, подожди!",shape=box,color=red];
		j3683603386 -> j777162605;
	j2081382084 [label="Но я помню его и сейчас, так же ясно, как серебряный свет самой Луа, за стеной дома моего детства. Молодой мужской голос... «Рэп, тук, тук...»",shape=box,color=blue];
		j2081382084 -> j2236401606;
	j1814919830 [label="Вот это уже почти умилительно для него, ты прав. И что было дальше?",shape=box,color=red];
		j1814919830 -> j3497223749;
	j777162605 [label="Boolean LyonRell1 is now true.",color=orange];
