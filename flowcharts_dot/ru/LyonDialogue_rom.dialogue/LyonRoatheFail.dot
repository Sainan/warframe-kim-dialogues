		2269 -> 2271 [label="RoatheFailNot21",color=purple];
		2269 -> 2270 [label="RoatheFailUnloved",color=purple];
	2273 [label="Роуту пришлось смириться с правдой о том, что он... ну... принимал сыворотку. И я не знаю почему, но мне кажется, что моя помощь в этом оказалась слабой.",shape=box,color=red];
		2273 -> 2277;
	2272 [label="У меня нет уверенности. Кажется, мною было сказано что-то, чего мне не следовало говорить.",shape=box,color=red];
		2272 -> 2276;
	2271 [label="Он сказал мне не углубляться в его воспоминания. Так что с моей стороны не было этих попыток. И теперь мы, кажется... застряли?",shape=box,color=red];
		2271 -> 2275;
	2270 [label="Мной было ему сказано, что мое нахождение рядом с ним, всего лишь желание просто пообщаться, и хотя у него, казалось, не было с этим проблем, теперь я чувствую, что между нами произошел регресс.",shape=box,color=red];
		2270 -> 2274;
	2277 [label="Я понимаю. Иногда бывает трудно примириться с прошлыми поступками, когда они предстают в новом свете. Я проклинаю Энтрати за то, что он втянул его и нас в эту отвратительную ситуацию.",shape=box,color=blue];
		2277 -> 2280;
	2276 [label="Я понимаю. Боюсь, я должен сказать тебе, что я мало что могу сделать в этом вопросе, поскольку ты переживаешь последствия принципа «что посеешь, то и пожнёшь».",shape=box,color=blue];
		2276 -> 2278;
	2275 [label="Понятно. Иногда действовать из лучших побуждений это не то же самое, что следовать чьей-то воле до последней буквы.",shape=box,color=blue];
		2275 -> 2279;
	2274 [label="Я понимаю. Боюсь, мне нужно сказать тебе, что я мало что могу сделать в этом вопросе, поскольку ты переживаешь последствия принципа «что посеешь, то и пожнёшь».",shape=box,color=blue];
		2274 -> 2278;
	2280 [label="Я сделаю всё, что в моих силах, чтобы убедить его прислушаться к тебе. Но я должен посоветовать тебе подготовить более веские аргументы в пользу того, почему он должен интерпретировать свои действия иначе, чем как трусость.",shape=box,color=blue];
		2280 -> 2282;
	2278 [label="Такое бессердечное пренебрежение неизбежно приведёт к ответному поведению. Особенно когда ты имеешь дело с таким человеком, как Роут.",shape=box,color=blue];
		2278 -> 2281;
	2279 [label="Это ужасный поступок, который мы должны совершить, не подчиниться чьим-то желаниям, особенно в таком деле, как копание в их личных воспоминаниях и мыслях.",shape=box,color=blue];
		2279 -> 2341;
	2282 [label="Ибо я знаю, что именно это съедает его изнутри.",shape=box,color=blue];
		2282 -> 2284;
	2281 [label="Я не знаю, как ты можешь это исправить. Но я не верю, что ты найдёшь выход из положения с помощью Мари или меня, прости меня.",shape=box,color=blue];
		2281 -> 2283;
	2341 [label="Я проклинаю Энтрати за то, что он поставил его и нас самих в такое жалкое положение.",shape=box,color=blue];
		2341 -> 2342;
	2284 [label="Я знаю, что нам также понадобится помощь Мари в этом вопросе. Возможно, убедить её будет сложнее, поскольку ты знаешь, что между этими двумя людьми не так много любви.",shape=box,color=blue];
		2284 -> 2286;
	2283 [label="Возможно, на данном этапе лучше всего рассмотреть другие варианты.",shape=box,color=blue];
		2283 -> 2285;
	2342 [label="Но мне кажется, что, к сожалению, единственный способ помочь ему - это сделать именно это. И продолжать исследовать Спуск до тех пор, пока не останется ни одного нераскрытого воспоминания.",shape=box,color=blue];
		2342 -> 2343;
	2286 [label="Update boolean LyonRoatheFailFix",color=orange];
		2286 -> 2287;
	2285 [label="Chat ends.",color=orange];
	2343 [label="Как бы дьявол ни протестовал.",shape=box,color=blue];
		2343 -> 2344;
	2287 [label="Луа направит тебя.",shape=box,color=blue];
		2287 -> 2288;
	2344 [label="Chat ends.",color=orange];
