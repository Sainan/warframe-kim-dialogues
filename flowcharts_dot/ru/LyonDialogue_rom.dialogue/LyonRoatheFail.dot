	2267 [label="Если я могу чем-то помочь, я сделаю это, mon miracle. Что, по-видимому, между вами двумя пошло не так?",shape=box,color=blue];
		2267 -> 2269;
	2268 [label="Если я могу чем-то помочь, я сделаю это, мой друг. Что, по-видимому, между вами двумя пошло не так?",shape=box,color=blue];
		2268 -> 2269;
	2269 [label="Evaluate expressions",color=orange];
