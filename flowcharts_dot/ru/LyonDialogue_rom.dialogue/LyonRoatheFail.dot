digraph {
	graph [fontname="Roboto Condensed"];
	node [fontname="Roboto Condensed"];
	edge [fontname="Roboto Condensed"];

	"LyonRoatheFail begins." [color=orange];
		"LyonRoatheFail begins." -> j4172105399;
		"LyonRoatheFail begins." -> j1310452999;
	j4172105399 [label="Лион, мне нужна твоя помощь с Роут.",shape=box,color=red];
		j4172105399 -> j421763245;
	j1310452999 [label="[Конец.]",shape=box,color=red];
		j1310452999 -> "Chat ends.";
	j421763245 [label="Check boolean LyonDating",color=orange];
		j421763245 -> j195903136 [label=true,color=green];
		j421763245 -> j3857907277 [label=false,color=brown];
	"Chat ends." [color=orange];
	j195903136 [label="Если я могу чем-то помочь, я сделаю это, mon miracle. Что, по-видимому, между вами двумя пошло не так?",shape=box,color=blue];
		j195903136 -> j572992334;
	j3857907277 [label="Если я могу чем-то помочь, я сделаю это, мой друг. Что, по-видимому, между вами двумя пошло не так?",shape=box,color=blue];
		j3857907277 -> j572992334;
	j572992334 [label="Evaluate expressions",color=orange];
		j572992334 -> j4233216998 [label="RoatheFail",color=purple];
		j572992334 -> j4233216998 [label="RoatheFailStall",color=purple];
		j572992334 -> j3793646763 [label="RoatheFailUltimate",color=purple];
		j572992334 -> j396498842 [label="RoatheFailNot21",color=purple];
		j572992334 -> j1034297623 [label="RoatheFailUnloved",color=purple];
		j572992334 -> j4233216998 [label="RoatheRepair1",color=purple];
	j4233216998 [label="Роуту пришлось смириться с правдой о том, что он... ну... принимал сыворотку. И я не знаю почему, но мне кажется, что моя помощь в этом оказалась слабой.",shape=box,color=red];
		j4233216998 -> j3287777553;
	j3793646763 [label="У меня нет уверенности. Кажется, мною было сказано что-то, чего мне не следовало говорить.",shape=box,color=red];
		j3793646763 -> j144013583;
	j396498842 [label="Он сказал мне не углубляться в его воспоминания. Так что с моей стороны не было этих попыток. И теперь мы, кажется... застряли?",shape=box,color=red];
		j396498842 -> j3185663687;
	j1034297623 [label="Мной было ему сказано, что мое нахождение рядом с ним, всего лишь желание просто пообщаться, и хотя у него, казалось, не было с этим проблем, теперь я чувствую, что между нами произошел регресс.",shape=box,color=red];
		j1034297623 -> j144013583;
	j3287777553 [label="Я понимаю. Иногда бывает трудно примириться с прошлыми поступками, когда они предстают в новом свете. Я проклинаю Энтрати за то, что он втянул его и нас в эту отвратительную ситуацию.",shape=box,color=blue];
		j3287777553 -> j2476914938;
	j144013583 [label="Я понимаю. Боюсь, я должен сказать тебе, что я мало что могу сделать в этом вопросе, поскольку ты переживаешь последствия принципа «что посеешь, то и пожнёшь».",shape=box,color=blue];
		j144013583 -> j811664664;
	j3185663687 [label="Понятно. Иногда действовать из лучших побуждений это не то же самое, что следовать чьей-то воле до последней буквы.",shape=box,color=blue];
		j3185663687 -> j2686197991;
	j2476914938 [label="Я сделаю всё, что в моих силах, чтобы убедить его прислушаться к тебе. Но я должен посоветовать тебе подготовить более веские аргументы в пользу того, почему он должен интерпретировать свои действия иначе, чем как трусость.",shape=box,color=blue];
		j2476914938 -> j1552074232;
	j811664664 [label="Такое бессердечное пренебрежение неизбежно приведёт к ответному поведению. Особенно когда ты имеешь дело с таким человеком, как Роут.",shape=box,color=blue];
		j811664664 -> j1162963366;
	j2686197991 [label="Это ужасный поступок, который мы должны совершить, не подчиниться чьим-то желаниям, особенно в таком деле, как копание в их личных воспоминаниях и мыслях.",shape=box,color=blue];
		j2686197991 -> j2929968504;
	j1552074232 [label="Ибо я знаю, что именно это съедает его изнутри.",shape=box,color=blue];
		j1552074232 -> j558081994;
	j1162963366 [label="Я не знаю, как ты можешь это исправить. Но я не верю, что ты найдёшь выход из положения с помощью Мари или меня, прости меня.",shape=box,color=blue];
		j1162963366 -> j3685555788;
	j2929968504 [label="Я проклинаю Энтрати за то, что он поставил его и нас самих в такое жалкое положение.",shape=box,color=blue];
		j2929968504 -> j1101115139;
	j558081994 [label="Boolean LyonRoatheFailFix is now true.",color=orange];
		j558081994 -> j618688711;
	j3685555788 [label="Возможно, на данном этапе лучше всего рассмотреть другие варианты.",shape=box,color=blue];
		j3685555788 -> "Chat ends.";
	j1101115139 [label="Но мне кажется, что, к сожалению, единственный способ помочь ему - это сделать именно это. И продолжать исследовать Спуск до тех пор, пока не останется ни одного нераскрытого воспоминания.",shape=box,color=blue];
		j1101115139 -> j422462791;
	j618688711 [label="Check boolean MarieRoatheFailFix",color=orange];
		j618688711 -> j4224060531 [label=true,color=green];
		j618688711 -> j3515382368 [label=false,color=brown];
	j422462791 [label="Как бы дьявол ни протестовал.",shape=box,color=blue];
		j422462791 -> "Chat ends.";
	j4224060531 [label="Похоже, Мари уже помогла тебе его убедить. Я впечатлён. Между ними, кажется, нет никакой симпатии.",shape=box,color=blue];
		j4224060531 -> j1669649403;
	j3515382368 [label="Я знаю, что нам также понадобится помощь Мари в этом вопросе. Возможно, убедить её будет сложнее, поскольку ты знаешь, что между этими двумя людьми не так много любви.",shape=box,color=blue];
		j3515382368 -> j1802282090;
	j1669649403 [label="Тогда, полагаю, мы можем начать.",shape=box,color=blue];
		j1669649403 -> "Initiate conversation RoatheRepair in /Lotus/Types/Gameplay/1999Wf/Dialogue/RoatheDialogue_rom.dialogue";
	j1802282090 [label="Луа направит тебя.",shape=box,color=blue];
		j1802282090 -> "Initiate conversation MarieRoatheFail in /Lotus/Types/Gameplay/1999Wf/Dialogue/MarieDialogue_rom.dialogue";
	"Initiate conversation RoatheRepair in /Lotus/Types/Gameplay/1999Wf/Dialogue/RoatheDialogue_rom.dialogue" [label="Initiate conversation RoatheRepair in /Lotus/Types/Gameplay/1999Wf/Dialogue/RoatheDialogue_rom.dialogue",color=orange];
		"Initiate conversation RoatheRepair in /Lotus/Types/Gameplay/1999Wf/Dialogue/RoatheDialogue_rom.dialogue" -> "Chat ends.";
	"Initiate conversation MarieRoatheFail in /Lotus/Types/Gameplay/1999Wf/Dialogue/MarieDialogue_rom.dialogue" [label="Initiate conversation MarieRoatheFail in /Lotus/Types/Gameplay/1999Wf/Dialogue/MarieDialogue_rom.dialogue",color=orange];
		"Initiate conversation MarieRoatheFail in /Lotus/Types/Gameplay/1999Wf/Dialogue/MarieDialogue_rom.dialogue" -> "Chat ends.";
}