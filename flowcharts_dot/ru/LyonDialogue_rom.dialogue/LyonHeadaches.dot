		j3793588528 -> j1375529092 [label="MarieLyonSuffering1",color=purple];
		j3793588528 -> j3508047652 [label="MarieLyonSuffering1",color=purple];
		j3793588528 -> j816195871 [label="false",color=purple];
		j3793588528 -> j1375529092 [label="false",color=purple];
	j1333749346 [label="Я в порядке. Я просто хотел узнать, как ты. До меня дошли сведения, что вчера тебе было нехорошо.",shape=box,color=red];
		j1333749346 -> j1132901080;
	j1478998117 [label="Я сам сейчас сражаюсь с небольшой меланхолией.",shape=box,color=red];
		j1478998117 -> j3308562408;
	j3723615216 [label="Я сам сейчас сражаюсь с небольшой мигренью.",shape=box,color=red];
		j3723615216 -> j839162394;
	j3781010403 [label="Я сам сейчас сражаюсь с небольшой головной болью.",shape=box,color=red];
		j3781010403 -> j2702633543;
	j816195871 [label="Я просто знаю по личному опыту, что иногда моменты, когда мы не хотим принимать помощь от других - это именно те самые моменты, когда мы больше всего в ней нуждаемся.",shape=box,color=red];
		j816195871 -> j177343282;
	j1375529092 [label="Я уважаю это. Я не стану лезть, если ты не хочешь говорить. Но я здесь, чтобы выслушать, если ты захочешь.",shape=box,color=red];
		j1375529092 -> j177343282;
	j1427671937 [label="Похоже, она намекала, что у тебя есть какие-то теории, почему у тебя случаются эти головные боли?",shape=box,color=red];
		j1427671937 -> j3875694456;
	j1249306019 [label="Мари считает, что ты пытаешься нести весь этот груз в одиночку. Мне просто хочется дать тебе знать, что я здесь, рядом.",shape=box,color=red];
		j1249306019 -> j272043737;
	j3508047652 [label="Мари считает, что ты напрасно страдаешь из-за всей этой ситуации. Мне хотелось бы спросить, могу ли я чем-то помочь.",shape=box,color=red];
		j3508047652 -> j272043737;
	j1132901080 [label="Ах. Понятно. Сегодня я чувствую себя гораздо лучше, благодарю за заботу. Хотя я и не уверен, что мне особенно по душе то, что Мари посчитала нужным рассказать тебе о моём недуге.",shape=box,color=blue];
		j1132901080 -> j4290593911;
		j1132901080 -> j1894624607;
		j1132901080 -> j1554976414;
	j3308562408 [label="Boolean LyonSuspicious is now true.",color=orange];
		j3308562408 -> j3841020609;
	j839162394 [label="Полагаю, в здешние времена так говорят и о тех сильных головных болях от которых я мучаюсь. Не могу представить, что этот светящийся аппарат хоть как-то облегчает твоё состояние. Тебе лучше уйти и отдохнуть.",shape=box,color=blue];
		j839162394 -> j524165601;
		j839162394 -> j3918936086;
		j839162394 -> j584514364;
	j2702633543 [label="Я тоже мучаюсь от подобного. Не могу представить, что этот светящийся аппарат хоть как-то облегчает твоё состояние. Тебе лучше уйти и отдохнуть.",shape=box,color=blue];
		j2702633543 -> j524165601;
		j2702633543 -> j3918936086;
		j2702633543 -> j584514364;
	j177343282 [label="Я не говорю, что сейчас настало время просить о помощи. Но если оно настанет? Я рядом.",shape=box,color=red];
		j177343282 -> j749213832;
	j3875694456 [label="И подобные теории, к сожалению, теперь прочно канули в «Бездну».",shape=box,color=blue];
		j3875694456 -> j408839534;
		j3875694456 -> j2176527235;
	j272043737 [label="Прошу извинить меня, Скиталец, когда я скажу следующее:",shape=box,color=blue];
		j272043737 -> j3742832774;
	j3841020609 [label="Хм. Я тоже мучаюсь от подобного. Не могу представить, что этот светящийся аппарат хоть как-то облегчает твоё состояние. Тебе лучше уйти и отдохнуть.",shape=box,color=blue];
		j3841020609 -> j524165601;
		j3841020609 -> j3918936086;
		j3841020609 -> j584514364;
	j524165601 [label="Твоя правда. Я пойду. Я просто хочу узнать, как ты, прежде всего.",shape=box,color=red];
		j524165601 -> j2989453561;
	j3918936086 [label="Ты меня подловил. Я просто не знаю, как ещё... с тобой связаться.",shape=box,color=red];
		j3918936086 -> j3009970375;
	j584514364 [label="Я ещё немного продержусь. Как давно ты страдаешь от подобных головных болей?",shape=box,color=red];
		j584514364 -> j370663926;
	j749213832 [label="Boolean LyonOffer is now true.",color=orange];
		j749213832 -> j272043737;
	j408839534 [label="Ох?",shape=box,color=red];
		j408839534 -> j1335393647;
	j2176527235 [label="Что это значит?",shape=box,color=red];
		j2176527235 -> j1335393647;
	j3742832774 [label="Сейчас я окружен незнакомцами и говорящими зверьми в мире фантастического безумия и, казалось бы, бесконечного и безудержного истребления.",shape=box,color=blue];
		j3742832774 -> j1093962949;
	j2989453561 [label="+20 Chemistry",color=orange];
		j2989453561 -> j3293456576;
	j3009970375 [label="Я ценю твою готовность признать ложь и тот факт, что я не... самый приветливый человек, которого ты когда-либо встречал.",shape=box,color=blue];
		j3009970375 -> j278417357;
	j370663926 [label="Это личное дело каждого, Скиталец. Я ценю твою попытку поговорить со мной. И я ценю твою готовность признать ложь и тот факт, что я не... самый приветливый человек, которого ты когда-либо встречал.",shape=box,color=blue];
		j370663926 -> j278417357;
	j1335393647 [label="Boolean LyonFaithHeadache is now true.",color=orange];
		j1335393647 -> j272043737;
	j1093962949 [label="Все, что я знал, было сметено пылающими лучами «Нефритового света» и «Империей Орокин» и «Бездной», и находится под угрозой «Шёпота».",shape=box,color=blue];
		j1093962949 -> j2990271487;
	j3293456576 [label="Как можешь «видеть», я уже полностью оправился. А теперь тебе стоит беспокоиться о себе. Так что иди и найди какое-нибудь тёмное место, чтобы восстановиться.",shape=box,color=blue];
		j3293456576 -> j2237539099;
	j278417357 [label="Могу ли я быть откровенным и спросить, почему ты вообще пытаешься со мной общаться?",shape=box,color=blue];
		j278417357 -> j4248022048;
		j278417357 -> j1532148483;
		j278417357 -> j4127684725;
		j278417357 -> j816195871;
	j2990271487 [label="Так что прошу простить меня, если я нахожу это... твоё предложение родства странно смешным из-за его наивности. Я тебя и не знаю и не доверяю тебе. По сути, мне остаётся только полагаться на слова других.",shape=box,color=blue];
		j2990271487 -> j664584926;
	j2237539099 [label="Убирайся, Скиталец. Пока я не нашёл тебя и не принудил к отдыху. И уверен, это не доставит удовольствия ни одному из нас.",shape=box,color=blue];
		j2237539099 -> j1927168968;
		j2237539099 -> j4234453234;
	j4248022048 [label="Раз уж мы откровенны, я честно не могу перестать думать о тебе с того самого момента, как мы встретились.",shape=box,color=red];
		j4248022048 -> j2905931503;
	j1532148483 [label="Энтрати превратил тебя в протофреймов, и вот ты здесь, без подготовки, без ничего. Если я могу хоть как-то помочь тебе адаптироваться, я хочу это сделать.",shape=box,color=red];
		j1532148483 -> j272043737;
	j4127684725 [label="Ну...? Ты мне и в правду очень интересен. Хочу узнать тебя получше.",shape=box,color=red];
		j4127684725 -> j272043737;
	j664584926 [label="Слова других людей, которых я тоже пока не знаю и которым не доверяю. Все это навалилось на нас, не обращай внимания на то бремя, которое ты не видишь.",shape=box,color=blue];
		j664584926 -> j1544693731;
	j1927168968 [label="Ладно, ладно. Я иду.",shape=box,color=red];
		j1927168968 -> j2489539620;
	j4234453234 [label="Что ж... Возможно, мне это понравится куда больше, чем ты думаешь.",shape=box,color=red];
		j4234453234 -> j719613752;
	j2905931503 [label="+20 Chemistry",color=orange];
		j2905931503 -> j719613752;
	j1544693731 [label="В общем, я ценю твою приветливость и прошу простить отсутствие таковой у меня. Я понимаю, чего ты добиваешься, и ценю тебя за это. И надеюсь, что если когда-нибудь случится так, что мне понадобится твоя помощь, твоё предложение останется в силе.",shape=box,color=blue];
		j1544693731 -> j1301471091;
		j1544693731 -> j2000305406;
		j1544693731 -> j1233551926;
