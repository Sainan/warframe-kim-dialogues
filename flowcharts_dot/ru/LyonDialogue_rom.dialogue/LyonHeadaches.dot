		242 -> 246;
	240 [label="Сейчас я окружен незнакомцами и говорящими зверьми в мире фантастического безумия и, казалось бы, бесконечного и безудержного истребления.",shape=box,color=blue];
		240 -> 245;
	236 [label="+20 Chemistry",color=orange];
		236 -> 243;
	237 [label="Я ценю твою готовность признать ложь и тот факт, что я не... самый приветливый человек, которого ты когда-либо встречал.",shape=box,color=blue];
		237 -> 244;
	238 [label="Это личное дело каждого, Скиталец. Я ценю твою попытку поговорить со мной. И я ценю твою готовность признать ложь и тот факт, что я не... самый приветливый человек, которого ты когда-либо встречал.",shape=box,color=blue];
		238 -> 244;
	246 [label="Update boolean LyonFaithHeadache",color=orange];
		246 -> 234;
	245 [label="Все, что я знал, было сметено пылающими лучами «Нефритового света» и «Империей Орокин» и «Бездной», и находится под угрозой «Шёпота».",shape=box,color=blue];
		245 -> 251;
	243 [label="Как можешь «видеть», я уже полностью оправился. А теперь тебе стоит беспокоиться о себе. Так что иди и найди какое-нибудь тёмное место, чтобы восстановиться.",shape=box,color=blue];
		243 -> 247;
	244 [label="Могу ли я быть откровенным и спросить, почему ты вообще пытаешься со мной общаться?",shape=box,color=blue];
		244 -> 248;
		244 -> 249;
		244 -> 250;
		244 -> 224;
	251 [label="Так что прошу простить меня, если я нахожу это... твоё предложение родства странно смешным из-за его наивности. Я тебя и не знаю и не доверяю тебе. По сути, мне остаётся только полагаться на слова других.",shape=box,color=blue];
		251 -> 255;
	247 [label="Убирайся, Скиталец. Пока я не нашёл тебя и не принудил к отдыху. И уверен, это не доставит удовольствия ни одному из нас.",shape=box,color=blue];
		247 -> 252;
		247 -> 253;
	248 [label="Раз уж мы откровенны, я честно не могу перестать думать о тебе с того самого момента, как мы встретились.",shape=box,color=red];
		248 -> 254;
	249 [label="Энтрати превратил тебя в протофреймов, и вот ты здесь, без подготовки, без ничего. Если я могу хоть как-то помочь тебе адаптироваться, я хочу это сделать.",shape=box,color=red];
