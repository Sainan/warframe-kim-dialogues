		225 -> 233;
	228 [label="Похоже, она намекала, что у тебя есть какие-то теории, почему у тебя случаются эти головные боли?",shape=box,color=red];
		228 -> 235;
	227 [label="Мари считает, что ты пытаешься нести весь этот груз в одиночку. Мне просто хочется дать тебе знать, что я здесь, рядом.",shape=box,color=red];
		227 -> 234;
	226 [label="Мари считает, что ты напрасно страдаешь из-за всей этой ситуации. Мне хотелось бы спросить, могу ли я чем-то помочь.",shape=box,color=red];
		226 -> 234;
	220 [label="Ах. Понятно. Сегодня я чувствую себя гораздо лучше, благодарю за заботу. Хотя я и не уверен, что мне особенно по душе то, что Мари посчитала нужным рассказать тебе о моём недуге.",shape=box,color=blue];
