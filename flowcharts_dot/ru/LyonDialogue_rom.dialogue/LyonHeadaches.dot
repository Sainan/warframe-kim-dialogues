	221 [label="Update boolean LyonSuspicious",color=orange];
		221 -> 229;
	223 [label="Полагаю, в здешние времена так говорят и о тех сильных головных болях от которых я мучаюсь. Не могу представить, что этот светящийся аппарат хоть как-то облегчает твоё состояние. Тебе лучше уйти и отдохнуть.",shape=box,color=blue];
