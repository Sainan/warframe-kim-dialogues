	j1134964341 [label="+5 Chemistry",color=orange];
		j1134964341 -> j2403767666;
	"Chat ends." [color=orange];
	j3074797558 [label="Понимаю, вероятно, это слово вашего времени для моих сильных головных болей. Да, так и было. Сегодня я чувствую себя куда лучше, благодарю за заботу. Хотя не уверен, что мне особенно по вкусу то, что Мари рассказала тебе о моём недуге.",shape=box,color=blue];
		j3074797558 -> j4290593911;
		j3074797558 -> j1894624607;
		j3074797558 -> j1554976414;
	j4290593911 [label="Почему?",shape=box,color=red];
		j4290593911 -> j2853070419;
	j1894624607 [label="Она лишь упомянула, что тебе было нехорошо, только из заботы о тебе.",shape=box,color=red];
		j1894624607 -> j3101487344;
	j1554976414 [label="Это вылезло само собой, так, мимоходом. Она не просила меня проверить тебя.",shape=box,color=red];
		j1554976414 -> j3101487344;
	j2403767666 [label="У меня всё хорошо, благодарю тебя за заботу. А у тебя как дела?",shape=box,color=blue];
		j2403767666 -> j9112577;
	j2853070419 [label="Вероятно, тебя не удивит, что я предпочитаю, чтобы мои дела оставались приватными.",shape=box,color=blue];
		j2853070419 -> j3793588528;
	j3101487344 [label="Разумеется. Мария бы исцелила весь мир всеми лучами Сола, если бы могла. Но вероятно, тебя не удивит, что я предпочитаю, чтобы мои дела оставались приватными.",shape=box,color=blue];
		j3101487344 -> j3793588528;
