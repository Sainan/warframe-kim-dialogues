	j2548032838 [label="Как ты сегодня себя чувствуешь? Мари сказала, что тебя свалило мигренью.",shape=box,color=red];
		j2548032838 -> j3074797558;
	j720965105 [label="Ах. Да. Было так. Сегодня я чувствую себя гораздо лучше, благодарю за заботу. Хотя я и не уверен, что мне особенно по душе то, что Мари посчитала нужным рассказать тебе о моём недуге.",shape=box,color=blue];
