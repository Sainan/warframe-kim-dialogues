		253 -> 257;
	254 [label="+20 Chemistry",color=orange];
		254 -> 258;
	259 [label="В общем, я ценю твою приветливость и прошу простить отсутствие таковой у меня. Я понимаю, чего ты добиваешься, и ценю тебя за это. И надеюсь, что если когда-нибудь случится так, что мне понадобится твоя помощь, твоё предложение останется в силе.",shape=box,color=blue];
