	204 [label="Chat ends.",color=orange];
	206 [label="Понимаю, вероятно, это слово вашего времени для моих сильных головных болей. Да, так и было. Сегодня я чувствую себя куда лучше, благодарю за заботу. Хотя не уверен, что мне особенно по вкусу то, что Мари рассказала тебе о моём недуге.",shape=box,color=blue];
