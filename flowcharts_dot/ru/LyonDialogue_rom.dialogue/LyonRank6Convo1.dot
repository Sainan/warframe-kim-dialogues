		j2340461870 -> j1231358775 [label="false",color=purple];
	j1900708499 [label="Я буду сидеть в тихой молитве, благодаря того бога, который привёл тебя к нам, за то, что у тебя хватило терпения... доброты... выслушать меня так долго.",shape=box,color=blue];
		j1900708499 -> j940697021;
	j4111850001 [label="Я буду сидеть в тихой молитве, благодаря того бога, который привёл тебя к нам, за то, что у тебя хватило терпения... доброты... выслушать меня так долго.",shape=box,color=blue];
		j4111850001 -> j846259705;
	j2359830945 [label="Что я мог так много говорить тебе о своей боли, и это было принято мной? И никакой просьбы у тебя не было от меня взамен... Моя благодарность ничтожна по сравнению с этим.",shape=box,color=blue];
		j2359830945 -> j1809527872;
	j1231358775 [label="Я знаю, что другим не так-то легко страдать от того, кем я стал, каким я всегда был.",shape=box,color=blue];
		j1231358775 -> j1809527872;
	j940697021 [label="Что я мог так беспечно открыть тебе правду своей души, а твоё восприятие приняло это с открытым сердцем.",shape=box,color=blue];
		j940697021 -> j810160347;
	j846259705 [label="Что я мог так беспечно открыть тебе правду своей души, а твоё восприятие приняло это с распростёртыми объятиями.",shape=box,color=blue];
		j846259705 -> j810160347;
	j1809527872 [label="И я очень благодарен тебе за всё то терпение, которое было проявлено тобой ко мне.",shape=box,color=blue];
		j1809527872 -> j810160347;
	j810160347 [label="Evaluate expressions",color=orange];
