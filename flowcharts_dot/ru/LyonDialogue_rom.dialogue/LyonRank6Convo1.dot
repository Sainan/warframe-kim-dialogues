	j3209749914 [label="Друг мой, я буду сражаться рядом с тобой, что бы ни случилось.",shape=box,color=blue];
		j3209749914 -> j2030393221;
	j2631803475 [label="Куда бы ни был направлен твой путь. В каких бы битвах у тебя ни были сражения. Куда бы ни устремилось твое сердце -",shape=box,color=blue];
