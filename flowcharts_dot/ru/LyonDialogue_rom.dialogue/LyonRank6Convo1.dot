	j464842743 [label="Mon miracle, я преклоню колени перед твоим алтарём, как самый преданный слуга и солдат.",shape=box,color=blue];
		j464842743 -> j2631803475;
	j2493833830 [label="Друг мой, я буду сражаться рядом с тобой, что бы ни случилось. Как я мог не попытаться защитить тебя, кем было похищено сердце моей сестры?",shape=box,color=blue];
		j2493833830 -> j2030393221;
	j2155713815 [label="Друг мой, я буду сражаться рядом с тобой, что бы ни случилось. Как я мог не попытаться защитить тебя, кто смог усмирить самого дьявола?",shape=box,color=blue];
