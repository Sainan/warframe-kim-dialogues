digraph {
	graph [fontname="Roboto Condensed"];
	node [fontname="Roboto Condensed"];
	edge [fontname="Roboto Condensed"];

	"LyonRank3Convo4 begins." [color=orange];
		"LyonRank3Convo4 begins." -> j3724854779;
	j3724854779 [label="Прости за прямоту вопроса, но иначе я не знаю, как его ещё можно сформулировать. Что такое Шёпот?",shape=box,color=blue];
		j3724854779 -> j1639589434;
		j3724854779 -> j3140177164;
		j3724854779 -> j2926655573;
	j1639589434 [label="Всё, что я способен сказать тебе, являются не более чем догадками о том, что можно считать «сознанием» самого «Безразличия».",shape=box,color=red];
		j1639589434 -> j1307355008;
	j3140177164 [label="Я верю, что это попытка Бездны... понять человеческую форму.",shape=box,color=red];
		j3140177164 -> j4161105350;
	j2926655573 [label="Ты имеешь в виду это буквально или метафорически?",shape=box,color=red];
		j2926655573 -> j743220553;
	j1307355008 [label="Evaluate expressions",color=orange];
		j1307355008 -> j671179491 [label="DrifterFaithNoMITW",color=purple];
		j1307355008 -> j2174732567 [label="LyonFake1",color=purple];
		j1307355008 -> j3105153447 [label="LyonFaith1",color=purple];
		j1307355008 -> j3277217150 [label="LyonReal1",color=purple];
		j1307355008 -> j1695454462 [label="false",color=purple];
	j4161105350 [label="Вот как? Откуда такая уверенность?",shape=box,color=blue];
		j4161105350 -> j3334451123;
		j4161105350 -> j2735764191;
		j4161105350 -> j130923604;
	j743220553 [label="Ах. Верно. Уместное уточнение. Я полагаю, я имел это в виду скорее метафорически. Очевидно же, что он буквально состоят из пыли и пепла.",shape=box,color=blue];
		j743220553 -> j3395959954;
	j671179491 [label="+10 Chemistry",color=orange];
		j671179491 -> j3152251214;
	j2174732567 [label="+10 Chemistry",color=orange];
		j2174732567 -> j2787052589;
	j3105153447 [label="+10 Chemistry",color=orange];
		j3105153447 -> j3546880567;
	j3277217150 [label="+10 Chemistry",color=orange];
		j3277217150 -> j1695454462;
	j1695454462 [label="Увлекательно. Я полагал, что ты воспринимаешь своё Безразличие как некое божество, подобно Луе или Солу. Я ошибался?",shape=box,color=blue];
		j1695454462 -> j2678385184;
		j1695454462 -> j1345915623;
	j3334451123 [label="Нет. Но мне кажется, что это мне даёт определённое спокойствие мысль о том, что я могу догадаться о том, что делает Безразличие, в конце концов.",shape=box,color=red];
		j3334451123 -> j1058094017;
	j2735764191 [label="Нет, в конце концов, наверное, нет. Но у меня было достаточно много с этим взаимодействия, поэтому я считаю, что имею право попытаться разобраться в этом.",shape=box,color=red];
		j2735764191 -> j419205773;
	j130923604 [label="Кем же ещё они могут быть? Безразличие словно берёт каждую часть человеческого тела и по очереди пытается понять, для чего она предназначена.",shape=box,color=red];
		j130923604 -> j2479746653;
	j3395959954 [label="Ведь именно в это они и превращаются, будучи убиты. Мы всё это уже не раз это доказали.",shape=box,color=blue];
		j3395959954 -> j2550898234;
		j3395959954 -> j3345595037;
		j3395959954 -> j4077326411;
	j3152251214 [label="Мм. Да. Мари говорила мне об этом. Ты не веришь в действия невидимых сил в нашем мире - включая и Безразличие. Так ли это?",shape=box,color=blue];
		j3152251214 -> j1904950811;
		j3152251214 -> j1347570794;
	j2787052589 [label="Интригующе. Это уже второй раз, когда у меня складывается впечатление, что ты, похоже, не веришь в реальность твоего Безразличия. Так ли это?",shape=box,color=blue];
		j2787052589 -> j828500853;
		j2787052589 -> j2231375430;
	j3546880567 [label="Интригующе. Стоит ли мне заключить, что твоя вера в последнее время пошатнулась? Или же у тебя никогда и не было истинной веры в твоё Безразличие?",shape=box,color=blue];
		j3546880567 -> j828500853;
		j3546880567 -> j2231375430;
	j2678385184 [label="У меня не было уверенности, что Безразличие в принципе существовало, пока мы сами не сделали его реальным. Думаю, мы сотворили его точно так же, как я сотворил Дувири.",shape=box,color=red];
		j2678385184 -> j1340892451;
	j1345915623 [label="Я действительно считаю Безразличие подлинным божеством - с настоящим разумом, стоящим за ним.",shape=box,color=red];
		j1345915623 -> j4279391798;
	j1058094017 [label="Иногда я задумываюсь, не в этом ли причина, по которой в конце концов так многие обращаются к вере...",shape=box,color=blue];
		j1058094017 -> j2764123768;
	j419205773 [label="Прости, но я начинаю беспокоиться, когда кто-либо считает себя «оправданным» в любых действиях, особенно когда дело касается попыток предугадать мотивы других.",shape=box,color=blue];
		j419205773 -> j1926263630;
		j419205773 -> j1302535909;
	j2479746653 [label="Стоит ли нам беспокоиться о том, что произойдёт, когда оно доберётся до тех частей, чьё назначение не столь очевидно?",shape=box,color=blue];
		j2479746653 -> j3207972162;
	j2550898234 [label="Я думаю, Безразличие стремится постичь, что значит быть «человеком». Оно всегда было чем-то Большим. Иным. И теперь оно пытается научиться существовать как нечто Меньшее и как одно из Нас.",shape=box,color=red];
		j2550898234 -> j2741587556;
	j3345595037 [label="Иногда мне кажется, что у Безразличия и вправду никогда не было собственного тела, пока мы не вступили с ним во взаимодействие. Так что теперь оно просто учится существовать.",shape=box,color=red];
		j3345595037 -> j1309693307;
	j4077326411 [label="Безразличие словно берёт каждую часть человеческого тела и по очереди пытается понять, для чего она предназначена.",shape=box,color=red];
		j4077326411 -> j2479746653;
	j1904950811 [label="Я сомневаюсь, что Безразличие вообще было чем-то реальным пока мы не воплотили его в жизнь. Думаю, мы создали его точно так же, как мною было создано Дувири.",shape=box,color=red];
		j1904950811 -> j1816512914;
	j1347570794 [label="Мне жаль, что она тебе это сказала. Я действительно считаю Безразличие подлинным божеством - с настоящим разумом, стоящим за ним.",shape=box,color=red];
		j1347570794 -> j4217905354;
	j828500853 [label="Иногда мне кажется, что у Безразличия и вправду никогда не было собственного тела, пока мы не вступили с ним во взаимодействие. Так что теперь оно просто учится существовать.",shape=box,color=red];
		j828500853 -> j1340892451;
	j2231375430 [label="Нет, не это было моим намерением, извини. Я действительно считаю Безразличие подлинным божеством - с настоящим разумом, стоящим за ним.",shape=box,color=red];
		j2231375430 -> j97974860;
	j1340892451 [label="Boolean LyonFake1 is now true.",color=orange];
		j1340892451 -> j2695613738;
	j4279391798 [label="Ах. Простите меня, я неправильно понял. Что ж, я ценю твою честность, даже в твоей неуверенности, хотя это оставляет меня наедине с моими размышлениями.",shape=box,color=blue];
		j4279391798 -> j4061623738;
	j2764123768 [label="Спокойствие находится в вымышленных ответах, когда иных попросту нет.",shape=box,color=blue];
		j2764123768 -> j3941927914;
	j1926263630 [label="И прости меня, но разве ты не священник, который решает, кто «праведник», а кто «грешник»? Это тебе не кажется слегка лицемерным?",shape=box,color=red];
		j1926263630 -> j2106347465;
	j1302535909 [label="Прости меня. У меня не было в мыслях обидеть тебя.",shape=box,color=red];
		j1302535909 -> j1534958700;
	j3207972162 [label="Это была жалкая попытка пошутить, прости. В качестве наказания назначаю себе десять ударов плетью.",shape=box,color=blue];
		j3207972162 -> j2446131667;
		j3207972162 -> j3537956095;
	j2741587556 [label="Boolean LyonReal1 is now true.",color=orange];
		j2741587556 -> j4235260738;
	j1309693307 [label="Boolean LyonFake1 is now true.",color=orange];
		j1309693307 -> j4244429298;
	j1816512914 [label="Это слова дьявола, но чем чаще я их слышу, тем больше они начинают иметь для меня смысл.",shape=box,color=blue];
		j1816512914 -> j1019277336;
	j4217905354 [label="Check boolean LyonSuspicious",color=orange];
		j4217905354 -> j3649495670 [label=true,color=green];
		j4217905354 -> j3090996093 [label=false,color=brown];
	j97974860 [label="Boolean LyonReal1 is now true.",color=orange];
		j97974860 -> j1694282416;
	j2695613738 [label="Boolean LyonReal1 is now false.",color=orange];
		j2695613738 -> j1816512914;
	j4061623738 [label="+10 Chemistry",color=orange];
		j4061623738 -> j1280356309;
	j3941927914 [label="Спасибо. Я думаю, на сегодня этого достаточно.",shape=box,color=blue];
		j3941927914 -> j776416120;
	j2106347465 [label="+10 Chemistry",color=orange];
		j2106347465 -> j3853580246;
	j1534958700 [label="+10 Chemistry",color=orange];
		j1534958700 -> j978953905;
	j2446131667 [label="Как бы то ни было, я не знаю, зачем оно подражает человеческим частям. Думаю, чтобы понять, что «движет» нами.",shape=box,color=red];
		j2446131667 -> j665128025;
	j3537956095 [label="Этот образ ещё долго будет сидеть у меня в голове. Предоставляю тебе решать, что именно - плети или Шёпот.",shape=box,color=red];
		j3537956095 -> j3470655639;
	j4235260738 [label="Boolean LyonFake1 is now false.",color=orange];
		j4235260738 -> j3368949293;
	j4244429298 [label="Boolean LyonReal1 is now false.",color=orange];
		j4244429298 -> j3868156183;
	j1019277336 [label="Что такое Бездна, если не само ничто? Зеркало для гадания из вихрящегося полированного оникса, в которое мы вглядываемся, ожидая, когда наше отражение исказится и извратится?",shape=box,color=blue];
		j1019277336 -> j1083129710;
	j3649495670 [label="Boolean DrifterLiar is now true.",color=orange];
		j3649495670 -> j1969380927;
	j3090996093 [label="Boolean LyonSuspicious is now true.",color=orange];
		j3090996093 -> j1969380927;
	j1694282416 [label="Boolean LyonFake1 is now false.",color=orange];
		j1694282416 -> j4279391798;
	j1280356309 [label="Благодарю тебя. Боюсь, мне пора возвращаться к своим обязанностям.",shape=box,color=blue];
		j1280356309 -> j1542260442;
	j776416120 [label="-Ф. Лион Аллард",shape=box,color=blue];
		j776416120 -> j2379301672;
	j3853580246 [label="Да... Боюсь, что так и есть. И мне неприятно думать, что твоё мнение обо мне так быстро и так ошибочно изменилось в худшую сторону.",shape=box,color=blue];
		j3853580246 -> j637016252;
	j978953905 [label="Я прощаю тебя.",shape=box,color=blue];
		j978953905 -> j971203531;
	j665128025 [label="Хм. Любопытно. Хотя и весьма узко по охвату. По-твоему, это всего лишь дитя, играющее с игрушками. Я вынужден вернуться к своим обязанностям.",shape=box,color=blue];
		j665128025 -> j2911402704;
	j3470655639 [label="+20 Chemistry",color=orange];
		j3470655639 -> j109261257;
	j3368949293 [label="Evaluate expressions",color=orange];
		j3368949293 -> j1615317553 [label="DrifterFaithNoMITW",color=purple];
		j3368949293 -> j37718960 [label="RoatheMITW1",color=purple];
		j3368949293 -> j639569321 [label="false",color=purple];
	j3868156183 [label="Что такое Бездна, если не самое подлинное отсутствие всего?",shape=box,color=blue];
		j3868156183 -> j3505667310;
	j1083129710 [label="Ища в самих себе отблеск вечности - проблеск гения, который, как мы надеемся, продлится дольше, чем тлеющий миг наших смертных жизней. И в этих тенях, каких же ужасов может породить подобная пустота, питающаяся тьмой нашего разума, наших собственных опустошённых душ?",shape=box,color=blue];
		j1083129710 -> j2142751165;
	j1969380927 [label="Хм. Я неправильно понял. Я ценю твою честность, даже в твоей неуверенности, хотя это оставляет меня наедине с моими размышлениями.",shape=box,color=blue];
		j1969380927 -> j4061623738;
	j1542260442 [label="-Ф. Лион Аллард",shape=box,color=blue];
		j1542260442 -> "Chat ends.";
	j2379301672 [label="+20 Chemistry",color=orange];
		j2379301672 -> j801521378;
	j637016252 [label="Check boolean LyonFaith1",color=orange];
		j637016252 -> j179672303 [label=true,color=green];
		j637016252 -> j1372720188 [label=false,color=brown];
	j971203531 [label="Мне нужно вернуться к своим обязанностям. К сожалению, мы не закончили нашу беседу, ноt.. c'est la vie.",shape=box,color=blue];
		j971203531 -> j1542260442;
	j2911402704 [label="-Ф. Лион Аллард",shape=box,color=blue];
		j2911402704 -> j1933300832;
	j109261257 [label="Мари скажет тебе, как трудно добиться от меня улыбки. Так что справедливо будет сказать, что тебе это удалось. Отлично сыграно.",shape=box,color=blue];
		j109261257 -> j971203531;
