	328 [label="Увлекательно. Я полагал, что ты воспринимаешь своё Безразличие как некое божество, подобно Луе или Солу. Я ошибался?",shape=box,color=blue];
		328 -> 337;
		328 -> 338;
	333 [label="Нет. Но мне кажется, что это мне даёт определённое спокойствие мысль о том, что я могу догадаться о том, что делает Безразличие, в конце концов.",shape=box,color=red];
		333 -> 342;
	334 [label="Нет, в конце концов, наверное, нет. Но у меня было достаточно много с этим взаимодействия, поэтому я считаю, что имею право попытаться разобраться в этом.",shape=box,color=red];
		334 -> 343;
	335 [label="Кем же ещё они могут быть? Безразличие словно берёт каждую часть человеческого тела и по очереди пытается понять, для чего она предназначена.",shape=box,color=red];
		335 -> 344;
	336 [label="Ведь именно в это они и превращаются, будучи убиты. Мы всё это уже не раз это доказали.",shape=box,color=blue];
		336 -> 345;
		336 -> 346;
		336 -> 347;
	341 [label="Мм. Да. Мари говорила мне об этом. Ты не веришь в действия невидимых сил в нашем мире - включая и Безразличие. Так ли это?",shape=box,color=blue];
		341 -> 352;
		341 -> 353;
	340 [label="Интригующе. Это уже второй раз, когда у меня складывается впечатление, что ты, похоже, не веришь в реальность твоего Безразличия. Так ли это?",shape=box,color=blue];
		340 -> 350;
		340 -> 351;
	339 [label="Интригующе. Стоит ли мне заключить, что твоя вера в последнее время пошатнулась? Или же у тебя никогда и не было истинной веры в твоё Безразличие?",shape=box,color=blue];
		339 -> 350;
		339 -> 351;
	337 [label="У меня не было уверенности, что Безразличие в принципе существовало, пока мы сами не сделали его реальным. Думаю, мы сотворили его точно так же, как я сотворил Дувири.",shape=box,color=red];
		337 -> 348;
	338 [label="Я действительно считаю Безразличие подлинным божеством - с настоящим разумом, стоящим за ним.",shape=box,color=red];
		338 -> 349;
	342 [label="Иногда я задумываюсь, не в этом ли причина, по которой в конце концов так многие обращаются к вере...",shape=box,color=blue];
		342 -> 354;
	343 [label="Прости, но я начинаю беспокоиться, когда кто-либо считает себя «оправданным» в любых действиях, особенно когда дело касается попыток предугадать мотивы других.",shape=box,color=blue];
		343 -> 355;
		343 -> 356;
	344 [label="Стоит ли нам беспокоиться о том, что произойдёт, когда оно доберётся до тех частей, чьё назначение не столь очевидно?",shape=box,color=blue];
		344 -> 357;
	345 [label="Я думаю, Безразличие стремится постичь, что значит быть «человеком». Оно всегда было чем-то Большим. Иным. И теперь оно пытается научиться существовать как нечто Меньшее и как одно из Нас.",shape=box,color=red];
		345 -> 358;
	346 [label="Иногда мне кажется, что у Безразличия и вправду никогда не было собственного тела, пока мы не вступили с ним во взаимодействие. Так что теперь оно просто учится существовать.",shape=box,color=red];
		346 -> 359;
	347 [label="Безразличие словно берёт каждую часть человеческого тела и по очереди пытается понять, для чего она предназначена.",shape=box,color=red];
		347 -> 344;
	352 [label="Я сомневаюсь, что Безразличие вообще было чем-то реальным пока мы не воплотили его в жизнь. Думаю, мы создали его точно так же, как мною было создано Дувири.",shape=box,color=red];
		352 -> 364;
	353 [label="Мне жаль, что она тебе это сказала. Я действительно считаю Безразличие подлинным божеством - с настоящим разумом, стоящим за ним.",shape=box,color=red];
		353 -> 365;
