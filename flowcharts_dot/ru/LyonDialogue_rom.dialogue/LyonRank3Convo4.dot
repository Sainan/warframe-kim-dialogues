		j139798550 -> j4016593858;
	j3672724877 [label="Boolean LyonSuspicious is now true.",color=orange];
		j3672724877 -> j4016593858;
	j896096337 [label="Я знаю, дьявол говорил с тобой о своих теориях. И в поздние часы я ловлю себя на мысли, что в них, возможно, есть какой-то смысл.",shape=box,color=blue];
		j896096337 -> j1019277336;
	j1832251651 [label="+20 Chemistry",color=orange];
		j1832251651 -> j1280356309;
	j2538917865 [label="Зачем богу, не имеющему представления о разуме человечества, стремиться посмеяться над нашей собственной глупостью? Зачем ему желать мучить нас? Издеваться над нашими неудачами и имитировать наши формы?",shape=box,color=blue];
		j2538917865 -> j4116538339;
	j990450588 [label="Я прошу прощения ещё раз, но это тема, которую я не желаю обсуждать. Полагаю, тебе несложно догадаться по каким причинам, учитывая твоё более широкое знание обстоятельств.",shape=box,color=blue];
		j990450588 -> j3184057676;
		j990450588 -> j2712401015;
	j2856410810 [label="Boolean LyonFaith1 is now true.",color=orange];
		j2856410810 -> j990450588;
	j4016593858 [label="Хм. Действительно. Что же должно быть на душе у непостижимого бога, превращённого в муравья, подобного одному из нас?",shape=box,color=blue];
		j4016593858 -> j1280356309;
	j4116538339 [label="Есть ли что-нибудь более страшное, чем смотреть в зияющую пасть Бездны и чувствовать, как Ничто смотрит на тебя? Чтобы узнать, насколько бесконечно малой крупицей мы являемся в её безмерности? ",shape=box,color=blue];
		j4116538339 -> j261696669;
	j3184057676 [label="Я думаю, это может быть связано с Энтрати. И, возможно, с Безразличием.",shape=box,color=red];
		j3184057676 -> j2426016660;
	j2712401015 [label="Да, но ведь мы пришли сюда только из-за моих предположений о мотивах других, не так ли?",shape=box,color=red];
		j2712401015 -> j2895030039;
	j261696669 [label="Чего бы я только не отдал за тишину Бездны. За тишину, которую она предвещает. Всё - что угодно - только не за сводящие с ума голоса, которые следуют за этим...",shape=box,color=blue];
		j261696669 -> j1324505699;
	j2426016660 [label="Тогда я прав, и нам нет необходимости говорить об этом.",shape=box,color=blue];
		j2426016660 -> "Chat ends.";
	j2895030039 [label="+10 Chemistry",color=orange];
		j2895030039 -> j938785489;
	j1324505699 [label="И именно эти голоса и вселяют во мне такие сомнения, Скиталец. И именно из-за них мои руки дрожат, пока я набираю эти слова...",shape=box,color=blue];
		j1324505699 -> j1690708097;
	j938785489 [label="Я… да. Вновь ты прав. Благодарю. Я уточню своё заявление и скажу, что я… просто не желаю говорить об этом в данный момент.",shape=box,color=blue];
		j938785489 -> j3177147032;
	j1690708097 [label="+10 Chemistry",color=orange];
		j1690708097 -> j1732464599;
	j3177147032 [label="Мне нужно вернуться к своим молитвам. Какими бы вялыми они ни были.",shape=box,color=blue];
		j3177147032 -> j1542260442;
	j1732464599 [label="Прости меня. Мне... надо идти.",shape=box,color=blue];
