		j1615317553 -> j139798550 [label=true,color=green];
		j1615317553 -> j3672724877 [label=false,color=brown];
	j37718960 [label="Что же должно быть на душе у непостижимого бога, превращённого в муравья, подобного одному из нас?",shape=box,color=blue];
		j37718960 -> j896096337;
	j639569321 [label="Что же должно быть на душе у непостижимого бога, превращённого в муравья, подобного одному из нас?",shape=box,color=blue];
		j639569321 -> j4061623738;
	j3505667310 [label="Интересно... да, пожалуй, в этом действительно есть смысл.",shape=box,color=blue];
