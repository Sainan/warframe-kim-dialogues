	"Chat ends." [color=orange];
	j801521378 [label="Boolean LyonFaith1 is now true.",color=orange];
		j801521378 -> "Chat ends.";
	j179672303 [label="Возможно, тобой уже было уловлено, что моя... собственная приверженность вере... в последнее время пошатнулась.",shape=box,color=blue];
		j179672303 -> j990450588;
	j1372720188 [label="Моя собственная приверженность вере... в последнее время пошатнулась.",shape=box,color=blue];
		j1372720188 -> j2856410810;
	j1933300832 [label="+10 Chemistry",color=orange];
