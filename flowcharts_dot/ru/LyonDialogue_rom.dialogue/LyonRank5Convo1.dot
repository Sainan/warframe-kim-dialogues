		1312 -> 1316 [label="false",color=purple];
		1312 -> 1313 [label="false",color=purple];
	1315 [label="Ранее ты упомянул, что хотел поговорить о том, что я не верю, что Безразличие — это «настоящий бог». Сейчас подходящее время?",shape=box,color=red];
		1315 -> 1320;
	1313 [label="[Конец.]",shape=box,color=red];
		1313 -> 1318;
	1314 [label="На днях ты спрашивал меня о концептуальном воплощении и о Безразличии. Тебя что‑то тревожит?",shape=box,color=red];
		1314 -> 1319;
	1317 [label="Роут убеждён, что Человек в Стене — не настоящий бог. Что он — продукт «концептуального воплощения». Что ты думаешь?",shape=box,color=red];
		1317 -> 1322;
	1316 [label="Лион, что происходит между тобой и Роут? Я знаю лишь обрывки информации.",shape=box,color=red];
		1316 -> 1321;
	1320 [label="Я не уверен, что любое время «подходящее» для обсуждения той реальной проблемы, которую это мне создало, Скиталец.",shape=box,color=blue];
		1320 -> 1324;
	1318 [label="Chat ends.",color=orange];
	1319 [label="Меня многое беспокоит, Скиталец. Боюсь, тема Безразличия и концептуального воплощения, лишь одна из них.",shape=box,color=blue];
		1319 -> 1323;
	1322 [label="Проблема, Скиталец, в том, что я не знаю. Если бы я знал ответ, я бы не раздирал себя таким внутренним спором.",shape=box,color=blue];
		1322 -> 1326;
	1321 [label="Я кратко подытожу, хотя поражён, что ты избегал его тирады на эту тему. Он чрезвычайно усерден в том, чтобы делиться ими при каждом удобном случае.",shape=box,color=blue];
		1321 -> 1325;
	1324 [label="Но, таким образом, сейчас самое «подходящее» время. Меня заинтриговало, что ты, похоже, разделяешь мнение Роут о том, что Безразличие не является истинным богом.",shape=box,color=blue];
		1324 -> 1326;
	1323 [label="Или, возможно, даже две, в зависимости от того, как ты решишь интерпретировать ситуацию. Хотя, полагаю, именно в этом и заключается суть моей дилеммы.",shape=box,color=blue];
		1323 -> 1326;
	1326 [label="Однако, мне следует... начать с самого начала. Ты не поймёшь, почему эта тема так важна для меня, если не будешь знать контекста...",shape=box,color=blue];
		1326 -> 1328;
	1325 [label="Он полагает, что Безразличие не является богом Бездны, ни в каком смысле этого слова, и что оно на самом деле было создано Энтрати и всеми теми, кто взаимодействовал с ним впоследствии -",shape=box,color=blue];
		1325 -> 1327;
	1328 [label="Я — Брат Луа. Я посвятил свою жизнь её почитанию. Всю свою жизнь я в это верил.",shape=box,color=blue];
		1328 -> 1330;
	1327 [label="- создал его из Бездны посредством того, что ты знаешь как «концептуальное воплощение». ",shape=box,color=blue];
		1327 -> 1329;
	1330 [label="И все годы, что прошли с моего прихода в церковь, я крепко держался за свою веру — за то твёрдое убеждение, что мои страдания, моя боль и мои видения были -",shape=box,color=blue];
		1330 -> 1331;
	1329 [label="Думаю, во многом таким же образом вы создали Дувири.",shape=box,color=blue];
		1329 -> 1326;
	1331 [label="служением ей. Были во имя её. Были ради её замысла.",shape=box,color=blue];
		1331 -> 1332;
	1332 [label="Так было... пока «Cardinal Dimanche» не оказался Альбрехтом Энтрати.",shape=box,color=blue];
		1332 -> 1333;
	1333 [label="И когда он поведал нам правду о том, кто он, рассказал историю своих проступков, связанных с Бездной, и всего, что из этого последовало. Точнее… всего, что из неё вышло.",shape=box,color=blue];
		1333 -> 1334;
		1333 -> 1335;
	1334 [label="Безразличие.",shape=box,color=red];
		1334 -> 1336;
	1335 [label="И?",shape=box,color=red];
		1335 -> 1337;
	1336 [label="Верно. Он рассказал нам о презрительном существе, которое его встретило, о пальцах, которые он извлёк из места, напоминавшего его лабораторию.",shape=box,color=blue];
		1336 -> 1338;
	1337 [label="Он рассказал нам о своём спуске в пустоту в серигласовом колоколе. О месте, напоминавшем его лабораторию. ",shape=box,color=blue];
		1337 -> 1338;
	1338 [label="Более того, он рассказал о великом ужасе, что охватил его, когда он понял, что выпустил нечто, способное следовать за ним не только через пространство, но и через время.",shape=box,color=blue];
		1338 -> 1339;
	1339 [label="Бога пустоты. Существо, которое должно быть заключено. Создание, части которого находились у него, и которое царапало стены, пытаясь освободиться.",shape=box,color=blue];
		1339 -> 1340;
	1340 [label="Ужасный и всепоглощающий бог, который был и не был свободен.",shape=box,color=blue];
		1340 -> 1341;
		1340 -> 1342;
	1341 [label="Что ты имеешь в виду?",shape=box,color=red];
		1341 -> 1343;
	1342 [label="«Был» и «одновременно не был» уже свободен?",shape=box,color=red];
		1342 -> 1343;
	1343 [label="Check boolean LyonRell1",color=orange];
		1343 -> 1345 [label=true,color=green];
		1343 -> 1344 [label=false,color=brown];
	1345 [label="Время… запутано для кого-то вроде меня, в том состоянии, в котором я нахожусь сейчас. Это трудно описать. Я уже однажды пытался объяснить это и потерпел полное поражение.",shape=box,color=blue];
		1345 -> 1346;
	1344 [label="Время… запутано для кого-то вроде меня, в том состоянии, в котором я сейчас нахожусь. Это трудно описать, и я делаю это крайне неумело.",shape=box,color=blue];
		1344 -> 1346;
	1346 [label="Я бы предпочел объяснить подробности в другой раз, поскольку это не суть того, что я пытаюсь донести до сути сегодня.",shape=box,color=blue];
		1346 -> 1347;
	1347 [label="Check boolean LyonRell1",color=orange];
		1347 -> 1348 [label=true,color=green];
		1347 -> 1349 [label=true,color=green];
		1347 -> 1350 [label=true,color=green];
		1347 -> 1349 [label=false,color=brown];
		1347 -> 1350 [label=false,color=brown];
	1348 [label="Но если ты слышишь — или слышал— Рэлла… я хочу поговорить об этом.",shape=box,color=red];
		1348 -> 1351;
	1349 [label="Хорошо. Ты решаешь.",shape=box,color=red];
		1349 -> 1352;
	1350 [label="Я действительно хочу поговорить об этом...",shape=box,color=red];
		1350 -> 1353;
	1351 [label="Я знаю. И я всячески избегал этой темы. Одно лишь его имя",shape=box,color=blue];
		1351 -> 1354;
	1352 [label="Знаю, что я упорно избегал этой темы, и прошу прощения. Но это может погрузить меня в видения, от которых я вряд ли смогу легко оправиться.",shape=box,color=blue];
		1352 -> 1355;
	1353 [label="Уверяю, мы обязательно это сделаем. Я знаю, что крайне избегал этой темы, и прошу прощения. Но это, вероятно, может вызвать у меня видение, после которого я не уверен, что смогу легко прийти в себя.",shape=box,color=blue];
		1353 -> 1355;
	1354 [label="оно грозит",shape=box,color=blue];
		1354 -> 1356;
	1355 [label="Я не хочу снова прерывать этот разговор из-за того, что я не в состоянии его продолжать из-за собственных недугов.",shape=box,color=blue];
		1355 -> 1357;
		1355 -> 1358;
		1355 -> 1359;
	1356 [label="вызвать видения, облик человека в цепях",shape=box,color=blue];
		1356 -> 1360;
	1357 [label="Никого, кто вынес то, что вынес Лион, нельзя назвать “немощным”.",shape=box,color=red];
		1357 -> 1361;
	1358 [label="«Немощный» — ужасный способ сказать «проклятый видениями, о которых не просил». Но делай, как знаешь.",shape=box,color=red];
		1358 -> 1361;
	1359 [label="Ты знаешь, на что способен, так что я последую за тобой.",shape=box,color=red];
		1359 -> 1362;
	1360 [label="залитого кровью",shape=box,color=blue];
		1360 -> 1363;
	1361 [label="Я ценю эти слова. Но я знаю, что в лучшие дни я лишь разбитое витражное стекло. Я стою здесь, размышляя, куда же делись многие из осколков.",shape=box,color=blue];
		1361 -> 1364;
	1362 [label="Спасибо. Я восхищаюсь твоим терпением. Я знаю, что в лучшие дни я лишь разбитое витражное стекло. Я стою здесь и думаю, куда же делись многие из осколков.",shape=box,color=blue];
		1362 -> 1364;
	1363 [label="сотканного из жил и плоти",shape=box,color=blue];
		1363 -> 1365;
	1364 [label="И каждый раз, когда нахожу тот, что потерялся, я скорее поранюсь о его острые края, чем извлеку пользу, пытаясь вернуть его на место.",shape=box,color=blue];
		1364 -> 1366;
	1365 [label="пожалуйста… пусть оно прекратится",shape=box,color=blue];
		1365 -> 1367;
	1366 [label="Порой я думаю, не лучше ли было бы стать одним из тех по‑настоящему пустоглазых Харроу, которых я вижу в своих видениях, тянущихся так далеко, как только позволяют кошмары.",shape=box,color=blue];
		1366 -> 1368;
	1367 [label="эти лица
бесчисленные тысячи 
пустые, сломленные
запертые в тишине
навеки в разбитой молитве. 
кем я стану",shape=box,color=blue];
		1367 -> 1369;
		1367 -> 1370;
	1368 [label="Evaluate expressions",color=orange];
		1368 -> 1372 [label="MarieDating",color=purple];
		1368 -> 1371 [label="MarieDating",color=purple];
		1368 -> 1371 [label="RoatheDating",color=purple];
		1368 -> 1372 [label="RoatheDating",color=purple];
		1368 -> 1371 [label="false",color=purple];
		1368 -> 1372 [label="false",color=purple];
		1368 -> 1373 [label="false",color=purple];
	1369 [label="Дыши, Лион. Дыши. Их на самом деле нет.",shape=box,color=red];
		1369 -> 1374;
	1370 [label="Я... извини, Лион. Сосредоточься на экране. Я здесь.",shape=box,color=red];
		1370 -> 1375;
	1372 [label="Я знаю, что на тебя взвалили ужасное бремя. И, возможно, так быть не должно. Но я не вижу выхода.",shape=box,color=red];
		1372 -> 1377;
	1371 [label="Ты очень много значишь для Мари. Ты стал для меня таким дорогим другом. Думаю, даже Роут скучал бы по тебе, хоть он этого и не признает.",shape=box,color=red];
		1371 -> 1376;
	1373 [label="[Признаться в чувствах.] Если ты позволишь этому случиться с тобой, Лион, мне будет больно. Я... я забочусь о тебе.",shape=box,color=red];
		1373 -> 1378;
	1374 [label="вот тут ты ошибаешься
они есть
и они никогда меня не покинут
никогда больше
энтрати об этом позаботился
прости меня",shape=box,color=blue];
		1374 -> 1379;
	1375 [label="рвут мою сущность,
срывают слои моего бытия.
почему? ради чего?
чей голод этим утоляют?",shape=box,color=blue];
		1375 -> 1380;
		1375 -> 1381;
	1377 [label="Не без того, чтобы прибегнуть к… немыслимому. Или к тому.",shape=box,color=red];
		1377 -> 1383;
	1376 [label="Ты дорог. Тебя любят. У тебя есть семья и друзья. Даже если это не всегда ощущается.",shape=box,color=red];
		1376 -> 1382;
	1378 [label="Ты… должно быть, шутишь. Ты не можешь говорить всерьёз после того, что только что увидел. Либо ты лишился рассудка, либо твоё сострадание затмило тебе здравый смысл.",shape=box,color=blue];
		1378 -> 1384;
		1378 -> 1385;
	1379 [label="+10 Chemistry",color=orange];
		1379 -> 1386;
	1380 [label="Ничей. Тебе больше не нужно так страдать. Отпусти это.",shape=box,color=red];
		1380 -> 1387;
	1381 [label="Я знаю. Знаю, как это больно. Прости. Мне так жаль. Выйди из комнаты.",shape=box,color=red];
		1381 -> 1388;
	1383 [label="+10 Chemistry",color=orange];
		1383 -> 1390;
	1382 [label="Ты не один, Лион. И тебя бы очень не хватало.",shape=box,color=red];
		1382 -> 1389;
	1384 [label="Нет, Лион. Я серьёзно. Ты для меня бесценен, и всё, чего я хочу, — это как-то заставить тебя в это поверить.",shape=box,color=red];
		1384 -> 1391;
	1385 [label="Я... может быть, ты прав. Может быть, сейчас неподходящее время.",shape=box,color=red];
		1385 -> 1392;
	1386 [label="Update boolean LyonRell2b",color=orange];
		1386 -> 1393;
	1387 [label="если бы это было так просто
эти цепи были моими так долго
дольше, чем язык
дольше, чем моё собственное имя
прости меня",shape=box,color=blue];
		1387 -> 1379;
	1388 [label="Развернись и мысленно выйди из комнаты.",shape=box,color=red];
		1388 -> 1394;
	1390 [label="Я вижу М. Некралоида и слышу рассказы о М. Ордисе или М. Отаке. Я думаю о пустых Варфреймах, чьи мысли вытащены из черепов.",shape=box,color=blue];
		1390 -> 1396;
	1389 [label="+10 Chemistry",color=orange];
		1389 -> 1395;
	1391 [label="Я.",shape=box,color=blue];
		1391 -> 1397;
	1392 [label="Хорошо. Я рад, что ты наконец вышел из своего мгновенного безумия. Видимо, оно заразно. Пожалуй, нам стоит сделать перерыв от этого устройства, боюсь, оно уже начинает разъедать тебе мозги.",shape=box,color=blue];
		1392 -> 1398;
	1393 [label="Chat ends.",color=orange];
	1394 [label="да
они будут там в другой раз
эта комната крови и цепей
ожидания
вечного ожидания",shape=box,color=blue];
		1394 -> 1399;
	1396 [label="Check boolean LyonPainOff",color=orange];
		1396 -> 1400 [label=true,color=green];
		1396 -> 1401 [label=false,color=brown];
	1395 [label="Спасибо… но я всё же задаюсь вопросом, как долго пройдёт, прежде чем эта скорбь станет просто ещё одной ношей, которую со временем легче нести?",shape=box,color=blue];
		1395 -> 1390;
	1397 [label="Evaluate expressions",color=orange];
		1397 -> 1403 [label="DrifterLiar",color=purple];
		1397 -> 1402 [label="LyonNoDate",color=purple];
		1397 -> 1404 [label="false",color=purple];
	1398 [label="Chat ends.",color=orange];
	1399 [label="Я должен просить твоего прощения. Бывают моменты, когда моя ясность мыслей подводит меня, и я ненавижу, когда другие становятся свидетелями этого.",shape=box,color=blue];
		1399 -> 1405;
	1400 [label="Было бы так просто сдаться. Отказаться от борьбы. Возложить свою муку на алтарь страданий и сказать, довольно.",shape=box,color=blue];
		1400 -> 1406;
	1401 [label="Было бы так просто сдаться. Отказаться от борьбы. Возложить свою муку на алтарь страданий и сказать, довольно.
Или поступить куда хуже —так, как многие опасались, что я могу совершить в тёмную ночь.",shape=box,color=blue];
		1401 -> 1406;
	1403 [label="Есть… лишь одна проблема, Скиталец. Как мне принять твои слова за истину, если знаю, что ложь уже имела место прежде?",shape=box,color=blue];
		1403 -> 1408;
	1402 [label="Хоть мне и приятно, боюсь, мой ответ, совершенно и однозначно нет.",shape=box,color=blue];
		1402 -> 1407;
	1404 [label="У меня нет слов.",shape=box,color=blue];
		1404 -> 1409;
	1405 [label="Evaluate expressions",color=orange];
		1405 -> 1410 [label="MarieDating",color=purple];
		1405 -> 1412 [label="MarieDating",color=purple];
