		1428 -> 1434;
	1429 [label="Луа высоко… где я остановился?",shape=box,color=blue];
		1429 -> 1435;
	1430 [label="Хорошо. Я рад, что ты наконец вышел из своего мгновенного безумия. Видимо, оно заразно. Пожалуй, нам стоит сделать перерыв от этого устройства, боюсь, оно уже начинает разъедать тебе мозги.",shape=box,color=blue];
		1430 -> 1436;
	1431 [label="У тебя есть все основания время от времени выплескивать эмоции. Мне приятно, что тебе комфортно со мной общаться.",shape=box,color=red];
		1431 -> 1437;
	1432 [label="Это точно не жалость к себе. Мне бы пришлось посмотреть на двоих других, чтобы понять, верно ли это.",shape=box,color=red];
		1432 -> 1438;
