	"LyonRank5Convo1 begins." [color=orange];
		"LyonRank5Convo1 begins." -> j3626627435;
	j3626627435 [label="Evaluate expressions",color=orange];
		j3626627435 -> j2308531388 [label="LyonMITW2",color=purple];
		j3626627435 -> j1310452999 [label="LyonMITW2",color=purple];
		j3626627435 -> j2606601947 [label="LyonMITW1",color=purple];
		j3626627435 -> j1310452999 [label="LyonMITW1",color=purple];
		j3626627435 -> j3769491772 [label="RoatheMITW3",color=purple];
		j3626627435 -> j1310452999 [label="RoatheMITW3",color=purple];
		j3626627435 -> j3769491772 [label="RoatheMITW2",color=purple];
		j3626627435 -> j1310452999 [label="RoatheMITW2",color=purple];
		j3626627435 -> j3769491772 [label="RoatheMITW1",color=purple];
		j3626627435 -> j1310452999 [label="RoatheMITW1",color=purple];
		j3626627435 -> j469977456 [label="false",color=purple];
		j3626627435 -> j1310452999 [label="false",color=purple];
	j2308531388 [label="Ранее ты упомянул, что хотел поговорить о том, что я не верю, что Безразличие — это «настоящий бог». Сейчас подходящее время?",shape=box,color=red];
		j2308531388 -> j2308625429;
	j1310452999 [label="[Конец.]",shape=box,color=red];
		j1310452999 -> "Chat ends.";
	j2606601947 [label="На днях ты спрашивал меня о концептуальном воплощении и о Безразличии. Тебя что‑то тревожит?",shape=box,color=red];
		j2606601947 -> j2961083647;
	j3769491772 [label="Роут убеждён, что Человек в Стене — не настоящий бог. Что он — продукт «концептуального воплощения». Что ты думаешь?",shape=box,color=red];
		j3769491772 -> j3951386762;
	j469977456 [label="Лион, что происходит между тобой и Роут? Я знаю лишь обрывки информации.",shape=box,color=red];
		j469977456 -> j547788432;
	j2308625429 [label="Я не уверен, что любое время «подходящее» для обсуждения той реальной проблемы, которую это мне создало, Скиталец.",shape=box,color=blue];
		j2308625429 -> j2504564557;
	"Chat ends." [color=orange];
	j2961083647 [label="Меня многое беспокоит, Скиталец. Боюсь, тема Безразличия и концептуального воплощения, лишь одна из них.",shape=box,color=blue];
		j2961083647 -> j3608290630;
	j3951386762 [label="Проблема, Скиталец, в том, что я не знаю. Если бы я знал ответ, я бы не раздирал себя таким внутренним спором.",shape=box,color=blue];
		j3951386762 -> j2970758745;
	j547788432 [label="Я кратко подытожу, хотя поражён, что ты избегал его тирады на эту тему. Он чрезвычайно усерден в том, чтобы делиться ими при каждом удобном случае.",shape=box,color=blue];
		j547788432 -> j1324621133;
	j2504564557 [label="Но, таким образом, сейчас самое «подходящее» время. Меня заинтриговало, что ты, похоже, разделяешь мнение Роут о том, что Безразличие не является истинным богом.",shape=box,color=blue];
		j2504564557 -> j2970758745;
	j3608290630 [label="Или, возможно, даже две, в зависимости от того, как ты решишь интерпретировать ситуацию. Хотя, полагаю, именно в этом и заключается суть моей дилеммы.",shape=box,color=blue];
		j3608290630 -> j2970758745;
	j2970758745 [label="Однако, мне следует... начать с самого начала. Ты не поймёшь, почему эта тема так важна для меня, если не будешь знать контекста...",shape=box,color=blue];
		j2970758745 -> j1249644894;
	j1324621133 [label="Он полагает, что Безразличие не является богом Бездны, ни в каком смысле этого слова, и что оно на самом деле было создано Энтрати и всеми теми, кто взаимодействовал с ним впоследствии -",shape=box,color=blue];
		j1324621133 -> j722054791;
	j1249644894 [label="Я — Брат Луа. Я посвятил свою жизнь её почитанию. Всю свою жизнь я в это верил.",shape=box,color=blue];
		j1249644894 -> j3500693846;
	j722054791 [label="- создал его из Бездны посредством того, что ты знаешь как «концептуальное воплощение». ",shape=box,color=blue];
		j722054791 -> j1259651944;
	j3500693846 [label="И все годы, что прошли с моего прихода в церковь, я крепко держался за свою веру — за то твёрдое убеждение, что мои страдания, моя боль и мои видения были -",shape=box,color=blue];
		j3500693846 -> j30530299;
	j1259651944 [label="Думаю, во многом таким же образом вы создали Дувири.",shape=box,color=blue];
		j1259651944 -> j2970758745;
	j30530299 [label="служением ей. Были во имя её. Были ради её замысла.",shape=box,color=blue];
		j30530299 -> j255676742;
	j255676742 [label="Так было... пока «Cardinal Dimanche» не оказался Альбрехтом Энтрати.",shape=box,color=blue];
		j255676742 -> j703951997;
	j703951997 [label="И когда он поведал нам правду о том, кто он, рассказал историю своих проступков, связанных с Бездной, и всего, что из этого последовало. Точнее… всего, что из неё вышло.",shape=box,color=blue];
		j703951997 -> j1205673241;
		j703951997 -> j1788958934;
	j1205673241 [label="Безразличие.",shape=box,color=red];
		j1205673241 -> j1511848348;
	j1788958934 [label="И?",shape=box,color=red];
		j1788958934 -> j2164648144;
	j1511848348 [label="Верно. Он рассказал нам о презрительном существе, которое его встретило, о пальцах, которые он извлёк из места, напоминавшего его лабораторию.",shape=box,color=blue];
		j1511848348 -> j1200566381;
	j2164648144 [label="Он рассказал нам о своём спуске в пустоту в серигласовом колоколе. О месте, напоминавшем его лабораторию. ",shape=box,color=blue];
		j2164648144 -> j1200566381;
	j1200566381 [label="Более того, он рассказал о великом ужасе, что охватил его, когда он понял, что выпустил нечто, способное следовать за ним не только через пространство, но и через время.",shape=box,color=blue];
		j1200566381 -> j4203066651;
	j4203066651 [label="Бога пустоты. Существо, которое должно быть заключено. Создание, части которого находились у него, и которое царапало стены, пытаясь освободиться.",shape=box,color=blue];
		j4203066651 -> j3254467000;
	j3254467000 [label="Ужасный и всепоглощающий бог, который был и не был свободен.",shape=box,color=blue];
		j3254467000 -> j2623022028;
		j3254467000 -> j3911005;
	j2623022028 [label="Что ты имеешь в виду?",shape=box,color=red];
		j2623022028 -> j3826452011;
	j3911005 [label="«Был» и «одновременно не был» уже свободен?",shape=box,color=red];
		j3911005 -> j3826452011;
	j3826452011 [label="Check boolean LyonRell1",color=orange];
		j3826452011 -> j2331250825 [label=true,color=green];
		j3826452011 -> j717415731 [label=false,color=brown];
	j2331250825 [label="Время… запутано для кого-то вроде меня, в том состоянии, в котором я нахожусь сейчас. Это трудно описать. Я уже однажды пытался объяснить это и потерпел полное поражение.",shape=box,color=blue];
		j2331250825 -> j2808389610;
	j717415731 [label="Время… запутано для кого-то вроде меня, в том состоянии, в котором я сейчас нахожусь. Это трудно описать, и я делаю это крайне неумело.",shape=box,color=blue];
		j717415731 -> j2808389610;
	j2808389610 [label="Я бы предпочел объяснить подробности в другой раз, поскольку это не суть того, что я пытаюсь донести до сути сегодня.",shape=box,color=blue];
		j2808389610 -> j366078008;
	j366078008 [label="Check boolean LyonRell1",color=orange];
		j366078008 -> j3385759612 [label=true,color=green];
		j366078008 -> j3334175808 [label=true,color=green];
		j366078008 -> j1657239180 [label=true,color=green];
		j366078008 -> j3334175808 [label=false,color=brown];
		j366078008 -> j1657239180 [label=false,color=brown];
	j3385759612 [label="Но если ты слышишь — или слышал— Рэлла… я хочу поговорить об этом.",shape=box,color=red];
		j3385759612 -> j3786828292;
	j3334175808 [label="Хорошо. Ты решаешь.",shape=box,color=red];
		j3334175808 -> j2040807656;
	j1657239180 [label="Я действительно хочу поговорить об этом...",shape=box,color=red];
		j1657239180 -> j2033301454;
	j3786828292 [label="Я знаю. И я всячески избегал этой темы. Одно лишь его имя",shape=box,color=blue];
		j3786828292 -> j151885900;
	j2040807656 [label="Знаю, что я упорно избегал этой темы, и прошу прощения. Но это может погрузить меня в видения, от которых я вряд ли смогу легко оправиться.",shape=box,color=blue];
		j2040807656 -> j2722733930;
	j2033301454 [label="Уверяю, мы обязательно это сделаем. Я знаю, что крайне избегал этой темы, и прошу прощения. Но это, вероятно, может вызвать у меня видение, после которого я не уверен, что смогу легко прийти в себя.",shape=box,color=blue];
		j2033301454 -> j2722733930;
	j151885900 [label="оно грозит",shape=box,color=blue];
		j151885900 -> j2712770968;
	j2722733930 [label="Я не хочу снова прерывать этот разговор из-за того, что я не в состоянии его продолжать из-за собственных недугов.",shape=box,color=blue];
		j2722733930 -> j1825674135;
		j2722733930 -> j13216190;
		j2722733930 -> j2190138830;
	j2712770968 [label="вызвать видения, облик человека в цепях",shape=box,color=blue];
		j2712770968 -> j1599629339;
	j1825674135 [label="Никого, кто вынес то, что вынес Лион, нельзя назвать “немощным”.",shape=box,color=red];
		j1825674135 -> j3090628340;
	j13216190 [label="«Немощный» — ужасный способ сказать «проклятый видениями, о которых не просил». Но делай, как знаешь.",shape=box,color=red];
		j13216190 -> j3090628340;
	j2190138830 [label="Ты знаешь, на что способен, так что я последую за тобой.",shape=box,color=red];
		j2190138830 -> j583112156;
	j1599629339 [label="залитого кровью",shape=box,color=blue];
		j1599629339 -> j2926234818;
	j3090628340 [label="Я ценю эти слова. Но я знаю, что в лучшие дни я лишь разбитое витражное стекло. Я стою здесь, размышляя, куда же делись многие из осколков.",shape=box,color=blue];
		j3090628340 -> j866717849;
	j583112156 [label="Спасибо. Я восхищаюсь твоим терпением. Я знаю, что в лучшие дни я лишь разбитое витражное стекло. Я стою здесь и думаю, куда же делись многие из осколков.",shape=box,color=blue];
		j583112156 -> j866717849;
	j2926234818 [label="сотканного из жил и плоти",shape=box,color=blue];
		j2926234818 -> j3237076989;
	j866717849 [label="И каждый раз, когда нахожу тот, что потерялся, я скорее поранюсь о его острые края, чем извлеку пользу, пытаясь вернуть его на место.",shape=box,color=blue];
		j866717849 -> j1604179569;
	j3237076989 [label="пожалуйста… пусть оно прекратится",shape=box,color=blue];
		j3237076989 -> j594461012;
	j1604179569 [label="Порой я думаю, не лучше ли было бы стать одним из тех по‑настоящему пустоглазых Харроу, которых я вижу в своих видениях, тянущихся так далеко, как только позволяют кошмары.",shape=box,color=blue];
		j1604179569 -> j3090338735;
	j594461012 [label="эти лица\nбесчисленные тысячи \nпустые, сломленные\nзапертые в тишине\nнавеки в разбитой молитве. \nкем я стану",shape=box,color=blue];
		j594461012 -> j4242776611;
		j594461012 -> j2610015965;
	j3090338735 [label="Evaluate expressions",color=orange];
		j3090338735 -> j1615209115 [label="MarieDating",color=purple];
		j3090338735 -> j3851078439 [label="MarieDating",color=purple];
		j3090338735 -> j3851078439 [label="RoatheDating",color=purple];
		j3090338735 -> j1615209115 [label="RoatheDating",color=purple];
		j3090338735 -> j3851078439 [label="false",color=purple];
		j3090338735 -> j1615209115 [label="false",color=purple];
		j3090338735 -> j2629576730 [label="false",color=purple];
	j4242776611 [label="Дыши, Лион. Дыши. Их на самом деле нет.",shape=box,color=red];
		j4242776611 -> j4271563921;
	j2610015965 [label="Я... извини, Лион. Сосредоточься на экране. Я здесь.",shape=box,color=red];
		j2610015965 -> j4018526546;
	j1615209115 [label="Я знаю, что на тебя взвалили ужасное бремя. И, возможно, так быть не должно. Но я не вижу выхода.",shape=box,color=red];
		j1615209115 -> j602224554;
	j3851078439 [label="Ты очень много значишь для Мари. Ты стал для меня таким дорогим другом. Думаю, даже Роут скучал бы по тебе, хоть он этого и не признает.",shape=box,color=red];
		j3851078439 -> j1743655425;
	j2629576730 [label="[Признаться в чувствах.] Если ты позволишь этому случиться с тобой, Лион, мне будет больно. Я... я забочусь о тебе.",shape=box,color=red];
		j2629576730 -> j3670034648;
	j4271563921 [label="вот тут ты ошибаешься\nони есть\nи они никогда меня не покинут\nникогда больше\nэнтрати об этом позаботился\nпрости меня",shape=box,color=blue];
		j4271563921 -> j2862131335;
	j4018526546 [label="рвут мою сущность,\nсрывают слои моего бытия.\nпочему? ради чего?\nчей голод этим утоляют?",shape=box,color=blue];
		j4018526546 -> j3521793131;
		j4018526546 -> j1356499685;
	j602224554 [label="Не без того, чтобы прибегнуть к… немыслимому. Или к тому.",shape=box,color=red];
		j602224554 -> j2393943035;
	j1743655425 [label="Ты дорог. Тебя любят. У тебя есть семья и друзья. Даже если это не всегда ощущается.",shape=box,color=red];
		j1743655425 -> j4208260166;
	j3670034648 [label="Ты… должно быть, шутишь. Ты не можешь говорить всерьёз после того, что только что увидел. Либо ты лишился рассудка, либо твоё сострадание затмило тебе здравый смысл.",shape=box,color=blue];
		j3670034648 -> j2357773640;
		j3670034648 -> j3433972572;
	j2862131335 [label="+10 Chemistry",color=orange];
		j2862131335 -> j4006363057;
	j3521793131 [label="Ничей. Тебе больше не нужно так страдать. Отпусти это.",shape=box,color=red];
		j3521793131 -> j744971950;
	j1356499685 [label="Я знаю. Знаю, как это больно. Прости. Мне так жаль. Выйди из комнаты.",shape=box,color=red];
		j1356499685 -> j3190490396;
	j2393943035 [label="+10 Chemistry",color=orange];
		j2393943035 -> j4293830802;
	j4208260166 [label="Ты не один, Лион. И тебя бы очень не хватало.",shape=box,color=red];
		j4208260166 -> j1259102814;
	j2357773640 [label="Нет, Лион. Я серьёзно. Ты для меня бесценен, и всё, чего я хочу, — это как-то заставить тебя в это поверить.",shape=box,color=red];
		j2357773640 -> j2740697248;
	j3433972572 [label="Я... может быть, ты прав. Может быть, сейчас неподходящее время.",shape=box,color=red];
		j3433972572 -> j3949883489;
	j4006363057 [label="Boolean LyonRell2b is now true.",color=orange];
		j4006363057 -> "Chat ends.";
	j744971950 [label="если бы это было так просто\nэти цепи были моими так долго\nдольше, чем язык\nдольше, чем моё собственное имя\nпрости меня",shape=box,color=blue];
		j744971950 -> j2862131335;
	j3190490396 [label="Развернись и мысленно выйди из комнаты.",shape=box,color=red];
		j3190490396 -> j2392128910;
	j4293830802 [label="Я вижу М. Некралоида и слышу рассказы о М. Ордисе или М. Отаке. Я думаю о пустых Варфреймах, чьи мысли вытащены из черепов.",shape=box,color=blue];
		j4293830802 -> j798816541;
	j1259102814 [label="+10 Chemistry",color=orange];
		j1259102814 -> j3328761105;
	j2740697248 [label="Я.",shape=box,color=blue];
		j2740697248 -> j2228720352;
	j3949883489 [label="Хорошо. Я рад, что ты наконец вышел из своего мгновенного безумия. Видимо, оно заразно. Пожалуй, нам стоит сделать перерыв от этого устройства, боюсь, оно уже начинает разъедать тебе мозги.",shape=box,color=blue];
		j3949883489 -> "Chat ends.";
	j2392128910 [label="да\nони будут там в другой раз\nэта комната крови и цепей\nожидания\nвечного ожидания",shape=box,color=blue];
		j2392128910 -> j646558860;
	j798816541 [label="Check boolean LyonPainOff",color=orange];
		j798816541 -> j326595255 [label=true,color=green];
		j798816541 -> j1484109570 [label=false,color=brown];
	j3328761105 [label="Спасибо… но я всё же задаюсь вопросом, как долго пройдёт, прежде чем эта скорбь станет просто ещё одной ношей, которую со временем легче нести?",shape=box,color=blue];
		j3328761105 -> j4293830802;
	j2228720352 [label="Evaluate expressions",color=orange];
		j2228720352 -> j257764876 [label="DrifterLiar",color=purple];
		j2228720352 -> j3969863165 [label="LyonNoDate",color=purple];
		j2228720352 -> j1940845278 [label="false",color=purple];
	j646558860 [label="Я должен просить твоего прощения. Бывают моменты, когда моя ясность мыслей подводит меня, и я ненавижу, когда другие становятся свидетелями этого.",shape=box,color=blue];
		j646558860 -> j1242024200;
	j326595255 [label="Было бы так просто сдаться. Отказаться от борьбы. Возложить свою муку на алтарь страданий и сказать, довольно.",shape=box,color=blue];
		j326595255 -> j3461015509;
	j1484109570 [label="Было бы так просто сдаться. Отказаться от борьбы. Возложить свою муку на алтарь страданий и сказать, довольно.\nИли поступить куда хуже —так, как многие опасались, что я могу совершить в тёмную ночь.",shape=box,color=blue];
		j1484109570 -> j3461015509;
	j257764876 [label="Есть… лишь одна проблема, Скиталец. Как мне принять твои слова за истину, если знаю, что ложь уже имела место прежде?",shape=box,color=blue];
