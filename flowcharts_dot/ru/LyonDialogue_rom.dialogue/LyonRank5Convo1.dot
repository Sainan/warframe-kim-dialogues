		1421 -> 1427;
		1421 -> 1428;
	1422 [label="+10 Chemistry",color=orange];
		1422 -> 1429;
	1423 [label="Нет, Лион. Я серьёзно. Ты для меня бесценен, и всё, чего я хочу, — это как-то заставить тебя в это поверить.",shape=box,color=red];
		1423 -> 1391;
	1424 [label="Я... может быть, ты прав. Может быть, сейчас неподходящее время.",shape=box,color=red];
		1424 -> 1430;
	1425 [label="Мы слишком отклонились от сути разговора, не правда ли? Мне очень жаль. Не стоит терпеть эту высокопарную, саможалостливую болтовню.",shape=box,color=blue];
		1425 -> 1431;
		1425 -> 1432;
