		1435 -> 1441;
	1436 [label="Chat ends.",color=orange];
	1437 [label="Спасибо. Я стараюсь не превращать свои тревоги в бремя для других, когда могу этого избежать. Но я ценю такую возможность.",shape=box,color=blue];
