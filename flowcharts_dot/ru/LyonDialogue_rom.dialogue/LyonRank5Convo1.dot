		1405 -> 1412 [label="RoatheDating",color=purple];
		1405 -> 1410 [label="false",color=purple];
		1405 -> 1411 [label="false",color=purple];
		1405 -> 1412 [label="false",color=purple];
	1406 [label="Но это… не то, кем я являюсь. И не то, кем я когда-либо стану. Мне суждено оставаться этим… сломанным бастионом, этим разбитым щитом...",shape=box,color=blue];
		1406 -> 1413;
	1408 [label="Я уже поймал тебя на лжи. И хоть я не знаю, ради какой цели она была произнесена, боюсь, у меня уже нет способности доверять тебе.",shape=box,color=blue];
		1408 -> 1414;
	1407 [label="Chat ends.",color=orange];
	1409 [label="Что, как я знаю, для меня вовсе не редкость, однако я чувствую, что должен ответить на это",shape=box,color=blue];
		1409 -> 1415;
	1410 [label="Ты хочешь остановиться здесь? Или может продолжить? Я понимаю оба варианта.",shape=box,color=red];
		1410 -> 1416;
	1412 [label="Всё хорошо. Я рядом. С тобой всё будет в порядке?",shape=box,color=red];
		1412 -> 1418;
	1411 [label="[Признаться в чувствах.] Лион, я... я забочусь о тебе. Я хочу быть рядом в такие моменты, если ты мне позволишь.",shape=box,color=red];
		1411 -> 1417;
	1413 [label="Всегда истекать кровью, но никогда не умирать...",shape=box,color=blue];
		1413 -> 1419;
	1414 [label="Так что, как бы мне ни было лестно, я вынужден сказать совершенно и однозначно -",shape=box,color=blue];
		1414 -> 1420;
	1415 [label="- каким-то остроумным образом или, по крайней мере, так, чтобы это выглядело уместно для ситуации и не -",shape=box,color=blue];
		1415 -> 1421;
	1416 [label="Я могу продолжать, спасибо. Всё прошло, как и всегда. Эти... мои видения — словно облака, проплывающие над Луа. Они могут быть совершенно тёмными, но часто краткими.",shape=box,color=blue];
		1416 -> 1422;
	1418 [label="Да, спасибо. Всё прошло, как и всегда. Эти... мои видения — словно облака, проплывающие над Луа. Они могут быть совершенно тёмными, но часто краткими.",shape=box,color=blue];
		1418 -> 1422;
	1417 [label="Ты, должно быть, шутишь. Ты не можешь говорить всерьёз после того, что только что увидел. Либо ты лишился рассудка, либо твоё сострадание затмило тебе здравый смысл.",shape=box,color=blue];
		1417 -> 1423;
