digraph {
	graph [fontname="Roboto Condensed"];
	node [fontname="Roboto Condensed"];
	edge [fontname="Roboto Condensed"];

	"LyonFlirt begins." [color=orange];
		"LyonFlirt begins." -> j1491164762;
		"LyonFlirt begins." -> j787318414;
		"LyonFlirt begins." -> j588267410;
	j1491164762 [label="Лион? Можем поговорить? ",shape=box,color=red];
		j1491164762 -> j2055628912;
	j787318414 [label="Лион? Мне очень, очень жаль, если мои слова заставили тебя чувствовать себя не. Это не входило в мои намерения.",shape=box,color=red];
		j787318414 -> j2610591526;
	j588267410 [label="[Конец.]",shape=box,color=red];
		j588267410 -> j2883342425;
	j2055628912 [label="Что ты намериваешься обсудить, Скиталец?",shape=box,color=blue];
		j2055628912 -> j2058714944;
	j2610591526 [label="Полагаю, тогда мне остается лишь недоумевать, не флиртуешь ли ты со мной только для того, чтобы поставить меня в неловкое положение только ради собственного развлечения... почему вообще тебе пришло в голову флиртовать?",shape=box,color=blue];
		j2610591526 -> j718996553;
		j2610591526 -> j1855126556;
		j2610591526 -> j786977000;
	j2883342425 [label="Boolean LyonFlirtIgnored is now true.",color=orange];
		j2883342425 -> "Chat ends.";
	j2058714944 [label="Твои кокетливые комментарии для собственного развлечения? Или же ты хочешь перейти к другим темам?",shape=box,color=blue];
		j2058714944 -> j978770350;
		j2058714944 -> j4092360667;
		j2058714944 -> j786977000;
	j718996553 [label="Ты интересуешь меня, Лион. Всё действительно так просто.",shape=box,color=red];
		j718996553 -> j2813487566;
	j1855126556 [label="Я не знаю, что на меня нашло, Лион. Очевидно, всё это было ошибкой. Мне очень жаль.",shape=box,color=red];
		j1855126556 -> j1823303689;
	j786977000 [label="Я... имелось в виду то, что было мною сказано. Но это всё слишком стремительно, я понимаю.",shape=box,color=red];
		j786977000 -> j1823303689;
	"Chat ends." [color=orange];
	j978770350 [label="Не было никакого флирта с тобой ради того, чтобы просто позабавить меня, Лион. Прости, если ты думаешь, что всё было именно так.",shape=box,color=red];
		j978770350 -> j1823303689;
	j4092360667 [label="У меня не было желания обидеть тебя, это просто было подтрунивание. Извини, пожалуйста.",shape=box,color=red];
		j4092360667 -> j2488004327;
	j2813487566 [label="И это не взаимно. Тут всё совершенно ясно.",shape=box,color=blue];
		j2813487566 -> "Chat ends.";
	j1823303689 [label="Я... Прости меня, Скиталец.",shape=box,color=blue];
		j1823303689 -> j2132342647;
	j2488004327 [label="Я понимаю.",shape=box,color=blue];
		j2488004327 -> "Chat ends.";
	j2132342647 [label="И прошу вновь простить мою прямоту, когда я высказываю всё то, что в последнее время переполняет мой разум:",shape=box,color=blue];
		j2132342647 -> j1718516919;
	j1718516919 [label="Сейчас я окружен незнакомцами и говорящими зверьми в мире фантастического безумия и, казалось бы, бесконечного и безудержного истребления.",shape=box,color=blue];
		j1718516919 -> j3955598789;
	j3955598789 [label="Все, что я знал, было сметено пылающими лучами «Нефритового света» и «Империей Орокин» и «Бездной», и находится под угрозой «Шёпота».",shape=box,color=blue];
		j3955598789 -> j3602949776;
	j3602949776 [label="Так что прошу простить меня, если я нахожу это... твоё проявление симпатии странно смешным из-за его наивности. Я тебя и не знаю и не доверяю тебе. По сути, мне остаётся только полагаться на слова других.",shape=box,color=blue];
		j3602949776 -> j4035107598;
	j4035107598 [label="Слова других людей, которых я тоже пока не знаю и которым не доверяю.",shape=box,color=blue];
		j4035107598 -> j3179665396;
	j3179665396 [label="И всё это, между тем, лишь внешние силы, которые накапливаются перед Мари и мной. Не говоря уже обо всём остальном, с чем мне приходится иметь дело и чего ты не можешь видеть.",shape=box,color=blue];
		j3179665396 -> j21612548;
	j21612548 [label="Я ценю твою откровенность. Я понимаю, чего ты добиваешься, и уважаю тебя за это. И надеюсь, что если когда-нибудь настанет момент, когда я... переосмыслю твоё предложение? Оно всё ещё будет в силе.",shape=box,color=blue];
		j21612548 -> j1320942732;
		j21612548 -> j292064223;
		j21612548 -> j2408562420;
	j1320942732 [label="Ничего не обещаю, священник.",shape=box,color=red];
		j1320942732 -> j1131538598;
	j292064223 [label="Как сказал бы один мой дорогой друг: «я упрям, приятель».",shape=box,color=red];
		j292064223 -> j4170366279;
	j2408562420 [label="Так и будет.",shape=box,color=red];
		j2408562420 -> j2075593602;
	j1131538598 [label="Разумеется. Никаких ожиданий не было.",shape=box,color=blue];
		j1131538598 -> j1547653815;
	j4170366279 [label="Boolean LyonFlirtOffer is now true.",color=orange];
		j4170366279 -> j218499903;
	j2075593602 [label="Boolean LyonFlirtOffer is now true.",color=orange];
		j2075593602 -> j433773783;
	j1547653815 [label="+15 Chemistry",color=orange];
		j1547653815 -> j2679492938;
	j218499903 [label="Boolean DrifterLyon is now true.",color=orange];
		j218499903 -> j3506485587;
	j433773783 [label="Boolean DrifterLyon is now true.",color=orange];
		j433773783 -> j415853486;
	j2679492938 [label="Прощай.",shape=box,color=blue];
		j2679492938 -> j1542260442;
	j3506485587 [label="Я... ну... тогда...",shape=box,color=blue];
		j3506485587 -> j4285945646;
	j415853486 [label="Посмотрим.",shape=box,color=blue];
		j415853486 -> j4285945646;
