		280 -> 283;
	282 [label="Лион? Мне очень, очень жаль, если мои слова заставили тебя чувствовать себя не. Это не входило в мои намерения.",shape=box,color=red];
		282 -> 285;
	281 [label="[Конец.]",shape=box,color=red];
		281 -> 284;
