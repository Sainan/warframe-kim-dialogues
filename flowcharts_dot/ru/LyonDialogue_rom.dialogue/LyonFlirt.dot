		283 -> 286;
	285 [label="Полагаю, тогда мне остается лишь недоумевать, не флиртуешь ли ты со мной только для того, чтобы поставить меня в неловкое положение только ради собственного развлечения... почему вообще тебе пришло в голову флиртовать?",shape=box,color=blue];
		285 -> 288;
		285 -> 289;
		285 -> 290;
	284 [label="Update boolean LyonFlirtIgnored",color=orange];
		284 -> 287;
	286 [label="Твои кокетливые комментарии для собственного развлечения? Или же ты хочешь перейти к другим темам?",shape=box,color=blue];
		286 -> 291;
		286 -> 292;
		286 -> 290;
	288 [label="Ты интересуешь меня, Лион. Всё действительно так просто.",shape=box,color=red];
		288 -> 293;
	289 [label="Я не знаю, что на меня нашло, Лион. Очевидно, всё это было ошибкой. Мне очень жаль.",shape=box,color=red];
		289 -> 294;
	290 [label="Я... имелось в виду то, что было мною сказано. Но это всё слишком стремительно, я понимаю.",shape=box,color=red];
		290 -> 294;
	287 [label="Chat ends.",color=orange];
	291 [label="Не было никакого флирта с тобой ради того, чтобы просто позабавить меня, Лион. Прости, если ты думаешь, что всё было именно так.",shape=box,color=red];
		291 -> 294;
	292 [label="У меня не было желания обидеть тебя, это просто было подтрунивание. Извини, пожалуйста.",shape=box,color=red];
		292 -> 295;
	293 [label="И это не взаимно. Тут всё совершенно ясно.",shape=box,color=blue];
		293 -> 296;
	294 [label="Я... Прости меня, Скиталец.",shape=box,color=blue];
		294 -> 297;
	295 [label="Я понимаю.",shape=box,color=blue];
		295 -> 298;
	296 [label="Chat ends.",color=orange];
	297 [label="И прошу вновь простить мою прямоту, когда я высказываю всё то, что в последнее время переполняет мой разум:",shape=box,color=blue];
		297 -> 299;
	298 [label="Chat ends.",color=orange];
	299 [label="Сейчас я окружен незнакомцами и говорящими зверьми в мире фантастического безумия и, казалось бы, бесконечного и безудержного истребления.",shape=box,color=blue];
		299 -> 300;
	300 [label="Все, что я знал, было сметено пылающими лучами «Нефритового света» и «Империей Орокин» и «Бездной», и находится под угрозой «Шёпота».",shape=box,color=blue];
		300 -> 301;
	301 [label="Так что прошу простить меня, если я нахожу это... твоё проявление симпатии странно смешным из-за его наивности. Я тебя и не знаю и не доверяю тебе. По сути, мне остаётся только полагаться на слова других.",shape=box,color=blue];
		301 -> 302;
	302 [label="Слова других людей, которых я тоже пока не знаю и которым не доверяю.",shape=box,color=blue];
		302 -> 303;
	303 [label="И всё это, между тем, лишь внешние силы, которые накапливаются перед Мари и мной. Не говоря уже обо всём остальном, с чем мне приходится иметь дело и чего ты не можешь видеть.",shape=box,color=blue];
		303 -> 304;
	304 [label="Я ценю твою откровенность. Я понимаю, чего ты добиваешься, и уважаю тебя за это. И надеюсь, что если когда-нибудь настанет момент, когда я... переосмыслю твоё предложение? Оно всё ещё будет в силе.",shape=box,color=blue];
		304 -> 305;
		304 -> 306;
		304 -> 307;
	305 [label="Ничего не обещаю, священник.",shape=box,color=red];
		305 -> 308;
	306 [label="Как сказал бы один мой дорогой друг: «я упрям, приятель».",shape=box,color=red];
		306 -> 309;
	307 [label="Так и будет.",shape=box,color=red];
		307 -> 310;
	308 [label="Разумеется. Никаких ожиданий не было.",shape=box,color=blue];
		308 -> 311;
