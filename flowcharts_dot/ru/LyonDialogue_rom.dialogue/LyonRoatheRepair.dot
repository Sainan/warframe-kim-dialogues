	2322 [label="Тогда у меня нет другого выбора, кроме как простить тебя. ",shape=box,color=blue];
		2322 -> 2325;
	2323 [label="И что же изменилось, что заставило тебя внезапно забеспокоиться, хотя раньше тебе было это незаметно?",shape=box,color=blue];
		2323 -> 2326;
		2323 -> 2327;
	2328 [label="У меня, конечно, нет другого выбора, кроме как простить тебя. Я не знаю, зачем тебе понадобилась такая сломленная вещь, как я, загромождающая твоё пространство.",shape=box,color=blue];
