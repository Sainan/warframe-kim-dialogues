		j8348369 -> j2207884261 [label="RoatheLyonConfessionDeal, LyonConfessionFail",color=purple];
		j8348369 -> "Chat ends." [label="false",color=purple];
	j2628005858 [label="Неужели у тебя действительно не было выбора до такой степени, что тебе пришлось умолять Роута приставать ко мне, чтобы... принять извинения?",shape=box,color=blue];
		j2628005858 -> j1554560946;
	j753480377 [label="Ты действительно оказался настолько лишенным других возможностей, что обратился к Роут с петицией, чтобы он приставал ко мне от твоего имени, чтобы отправить М. Лойда наверх?",shape=box,color=blue];
		j753480377 -> j1586858615;
	j2207884261 [label="Ты действительно оказался настолько лишенным других возможностей, что обратился к Роут с петицией, чтобы он приставал ко мне от твоего имени?",shape=box,color=blue];
		j2207884261 -> j1159721257;
	"Chat ends." [color=orange];
	j1554560946 [label="Ты понимаешь, как нелепо это звучит, да?",shape=box,color=blue];
		j1554560946 -> j648010282;
		j1554560946 -> j1537413222;
	j1586858615 [label="Я не хочу тратить больше времени, чем я уже потерял, слушая его аргументы. Я просто скажу, что очень хорошо.",shape=box,color=blue];
		j1586858615 -> j2169173578;
	j1159721257 [label="Проблема, поправь меня, если я ошибаюсь, заключалась в том, что у тебя не было желания копаться в моём прошлом. Теперь, кажется, твоё мнение изменилось?",shape=box,color=blue];
		j1159721257 -> j1754110771;
	j648010282 [label="Мне было неизвестно, что речь шла о том, что я извинюсь.",shape=box,color=red];
		j648010282 -> j2488004327;
	j1537413222 [label="Мне было неизвестно, что ещё сделать. Оглядываясь назад, я понимаю, что это нелепо.",shape=box,color=red];
		j1537413222 -> j890005892;
	j2169173578 [label="Check boolean MarieFamilyFail",color=orange];
		j2169173578 -> j2435816031 [label=true,color=green];
		j2169173578 -> j4261920817 [label=false,color=brown];
	j1754110771 [label="Я не понимаю. Мы не можем вернуться назад. Эти воды невозможно перечитать.",shape=box,color=blue];
		j1754110771 -> j4194202751;
		j1754110771 -> j1494629453;
	j2488004327 [label="Я понимаю.",shape=box,color=blue];
		j2488004327 -> "Chat ends.";
	j890005892 [label="Признаюсь, отчасти это и заставило меня прийти и разобраться в этом. Тебя это так расстраивает? Я не могу представить, что отсутствие моего общества в твоей жизни это так ужасно.",shape=box,color=blue];
		j890005892 -> j4013206687;
	j2435816031 [label="Я помогу тебе, если ты попросишь. Мне жаль, что твой атакующий дьявол сделает что-нибудь с Мари.",shape=box,color=blue];
		j2435816031 -> j92487004;
	j4261920817 [label="Я помогу тебе, если ты попросишь. А теперь, пожалуйста, отзови своего атакующего дьявола.",shape=box,color=blue];
		j4261920817 -> j770168571;
	j4194202751 [label="Ой. Что ж, тогда это была пустая трата времени, не так ли?",shape=box,color=red];
		j4194202751 -> "Chat ends.";
	j1494629453 [label="Думаю, я... тогда просто извинюсь. За то, что надо было всё же послушать тебя.",shape=box,color=red];
		j1494629453 -> j2216691790;
	j4013206687 [label="Так и есть, Лион. Я забочусь о тебе. Чрезвычайно. И я знаю, что с тобой была совершена серьезная ошибка.",shape=box,color=red];
		j4013206687 -> j3030085905;
	j92487004 [label="Boolean LyonFamilySuccess is now true.",color=orange];
		j92487004 -> j547953661;
	j770168571 [label="Boolean LyonFamilySuccess is now true.",color=orange];
		j770168571 -> j3711686580;
	j2216691790 [label="Могу я спросить, почему тебе нельзя этого было сделать? Тебя испугала тема? Возможно, она тебе наскучила? Или тебе казалось, что у тебя не хватит сил выдержать это?",shape=box,color=blue];
		j2216691790 -> j59264239;
		j2216691790 -> j1046719994;
		j2216691790 -> j2920656548;
	j3030085905 [label="И мне очень, очень жаль.",shape=box,color=red];
		j3030085905 -> j1070828880;
	j547953661 [label="Boolean LyonFamilyFail is now false.",color=orange];
		j547953661 -> "Initiate conversation MarieLyonRepair in /Lotus/Types/Gameplay/1999Wf/Dialogue/MarieDialogue_rom.dialogue";
	j3711686580 [label="Boolean LyonFamilyFail is now false.",color=orange];
		j3711686580 -> "Chat ends.";
	j59264239 [label="Мне было страшно.",shape=box,color=red];
		j59264239 -> j2209445307;
	j1046719994 [label="У меня не было в мыслях, что у меня хватит сил справиться с этим.",shape=box,color=red];
		j1046719994 -> j2209445307;
	j2920656548 [label="Тогда мне было всё равно. Но теперь мне не все равно.",shape=box,color=red];
		j2920656548 -> j2568923312;
	j1070828880 [label="У меня не было другого выхода, кроме как обратиться за помощью к Роут.",shape=box,color=red];
		j1070828880 -> j1673919340;
	"Initiate conversation MarieLyonRepair in /Lotus/Types/Gameplay/1999Wf/Dialogue/MarieDialogue_rom.dialogue" [label="Initiate conversation MarieLyonRepair in /Lotus/Types/Gameplay/1999Wf/Dialogue/MarieDialogue_rom.dialogue",color=orange];
		"Initiate conversation MarieLyonRepair in /Lotus/Types/Gameplay/1999Wf/Dialogue/MarieDialogue_rom.dialogue" -> "Chat ends.";
	j2209445307 [label="Тогда у меня нет другого выбора, кроме как простить тебя. ",shape=box,color=blue];
		j2209445307 -> j106665696;
	j2568923312 [label="И что же изменилось, что заставило тебя внезапно забеспокоиться, хотя раньше тебе было это незаметно?",shape=box,color=blue];
		j2568923312 -> j363529998;
		j2568923312 -> j1548754292;
	j1673919340 [label="У меня, конечно, нет другого выбора, кроме как простить тебя. Я не знаю, зачем тебе понадобилась такая сломленная вещь, как я, загромождающая твоё пространство.",shape=box,color=blue];
		j1673919340 -> j47788902;
	j106665696 [label="Boolean LyonConfessionFail is now false.",color=orange];
		j106665696 -> "Chat ends.";
	j363529998 [label="Моё мнение о тебе изменилось.",shape=box,color=red];
		j363529998 -> j2209445307;
	j1548754292 [label="Я чувствую, что есть прогресс, который может быть заблокирован из-за прослушивания твоих историй.",shape=box,color=red];
		j1548754292 -> j414745356;
	j47788902 [label="Но теперь я нахожу, что моё раздражение по поводу твоих слов утихает, когда я знаю, на какие совершенно невероятные меры ты можешь пойти, чтобы заполучить меня на свою сторону.",shape=box,color=blue];
		j47788902 -> j2398113586;
