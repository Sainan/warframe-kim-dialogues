		2317 -> 2322;
	2318 [label="Тогда мне было всё равно. Но теперь мне не все равно.",shape=box,color=red];
		2318 -> 2323;
	2324 [label="У меня не было другого выхода, кроме как обратиться за помощью к Роут.",shape=box,color=red];
		2324 -> 2328;
