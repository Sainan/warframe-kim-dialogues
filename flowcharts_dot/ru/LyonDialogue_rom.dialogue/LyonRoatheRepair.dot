		2327 -> 2330;
	2331 [label="Но теперь я нахожу, что моё раздражение по поводу твоих слов утихает, когда я знаю, на какие совершенно невероятные меры ты можешь пойти, чтобы заполучить меня на свою сторону.",shape=box,color=blue];
