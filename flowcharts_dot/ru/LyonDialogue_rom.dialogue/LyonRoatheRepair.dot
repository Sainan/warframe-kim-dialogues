		2290 -> 2291 [label="false",color=purple];
	2294 [label="Неужели у тебя действительно не было выбора до такой степени, что тебе пришлось умолять Роута приставать ко мне, чтобы... принять извинения?",shape=box,color=blue];
		2294 -> 2297;
	2292 [label="Ты действительно оказался настолько лишенным других возможностей, что обратился к Роут с петицией, чтобы он приставал ко мне от твоего имени, чтобы отправить М. Лойда наверх?",shape=box,color=blue];
		2292 -> 2295;
	2293 [label="Ты действительно оказался настолько лишенным других возможностей, что обратился к Роут с петицией, чтобы он приставал ко мне от твоего имени?",shape=box,color=blue];
		2293 -> 2296;
	2291 [label="Chat ends.",color=orange];
	2297 [label="Ты понимаешь, как нелепо это звучит, да?",shape=box,color=blue];
		2297 -> 2300;
		2297 -> 2301;
	2295 [label="Я не хочу тратить больше времени, чем я уже потерял, слушая его аргументы. Я просто скажу, что очень хорошо.",shape=box,color=blue];
		2295 -> 2298;
	2296 [label="Проблема, поправь меня, если я ошибаюсь, заключалась в том, что у тебя не было желания копаться в моём прошлом. Теперь, кажется, твоё мнение изменилось?",shape=box,color=blue];
		2296 -> 2299;
	2300 [label="Мне было неизвестно, что речь шла о том, что я извинюсь.",shape=box,color=red];
		2300 -> 2306;
	2301 [label="Мне было неизвестно, что ещё сделать. Оглядываясь назад, я понимаю, что это нелепо.",shape=box,color=red];
		2301 -> 2307;
	2298 [label="Check boolean MarieFamilyFail",color=orange];
		2298 -> 2302 [label=true,color=green];
		2298 -> 2303 [label=false,color=brown];
	2299 [label="Я не понимаю. Мы не можем вернуться назад. Эти воды невозможно перечитать.",shape=box,color=blue];
		2299 -> 2304;
		2299 -> 2305;
	2306 [label="Я понимаю.",shape=box,color=blue];
		2306 -> 2312;
	2307 [label="Признаюсь, отчасти это и заставило меня прийти и разобраться в этом. Тебя это так расстраивает? Я не могу представить, что отсутствие моего общества в твоей жизни это так ужасно.",shape=box,color=blue];
		2307 -> 2313;
	2302 [label="Я помогу тебе, если ты попросишь. Мне жаль, что твой атакующий дьявол сделает что-нибудь с Мари.",shape=box,color=blue];
		2302 -> 2308;
	2303 [label="Я помогу тебе, если ты попросишь. А теперь, пожалуйста, отзови своего атакующего дьявола.",shape=box,color=blue];
		2303 -> 2309;
	2304 [label="Ой. Что ж, тогда это была пустая трата времени, не так ли?",shape=box,color=red];
		2304 -> 2310;
	2305 [label="Думаю, я... тогда просто извинюсь. За то, что надо было всё же послушать тебя.",shape=box,color=red];
		2305 -> 2311;
	2312 [label="Chat ends.",color=orange];
	2313 [label="Так и есть, Лион. Я забочусь о тебе. Чрезвычайно. И я знаю, что с тобой была совершена серьезная ошибка.",shape=box,color=red];
		2313 -> 2319;
	2308 [label="Update boolean LyonFamilySuccess",color=orange];
		2308 -> 2314;
	2309 [label="Update boolean LyonFamilySuccess",color=orange];
		2309 -> 2315;
	2310 [label="Chat ends.",color=orange];
	2311 [label="Могу я спросить, почему тебе нельзя этого было сделать? Тебя испугала тема? Возможно, она тебе наскучила? Или тебе казалось, что у тебя не хватит сил выдержать это?",shape=box,color=blue];
		2311 -> 2316;
		2311 -> 2317;
