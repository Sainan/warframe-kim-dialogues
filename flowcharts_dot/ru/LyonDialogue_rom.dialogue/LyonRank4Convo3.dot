digraph {
	871 [label="LyonRank4Convo3 begins.",color=orange];
		871 -> 872;
		871 -> 873;
		871 -> 874;
	872 [label="Как у тебя складываются отношения с Кавией?",shape=box,color=red];
		872 -> 875;
	873 [label="Что ты думаешь о Лойде?",shape=box,color=red];
		873 -> 876;
	874 [label="[Конец.]",shape=box,color=red];
		874 -> 877;
	875 [label="Мне очень нравится слушать их шутки, хотя, как ты понимаешь, я сам в них не участвую. Мне нечего добавить к их разговору.",shape=box,color=blue];
		875 -> 878;
	876 [label="Я нахожу его весьма приятным. На самом деле, среди моих новых… товарищей, именно к его обществу я испытываю наибольшее влечение.",shape=box,color=blue];
		876 -> 879;
	877 [label="Chat ends.",color=orange];
	878 [label="Меня, однако, тревожит, когда я вижу, что Роут стоит и долго разговаривает с Птичкой 3. Я не понимаю, чего он хочет этим достичь.",shape=box,color=blue];
		878 -> 880;
	879 [label="Хотя, полагаю, это никого не удивит. На первый взгляд, у нас очень похожие темпераменты.",shape=box,color=blue];
		879 -> 881;
	880 [label="Update boolean LyonRoatheCavia1",color=orange];
		880 -> 882;
		880 -> 883;
	881 [label="Больше же странным мне кажется молодой Оператор… и та, кого называют Лотус. И то, как нас держат на расстоянии от них.",shape=box,color=blue];
		881 -> 884;
	882 [label="Хм. Я спрошу его об этом.",shape=box,color=red];
		882 -> 885;
	883 [label="Почему ты думаешь, что он чего‑то добивается?",shape=box,color=red];
		883 -> 886;
	884 [label="Нам, конечно, разрешено взаимодействовать, но не так. Не здесь. Почему так?",shape=box,color=blue];
		884 -> 887;
		884 -> 888;
	885 [label="Возможно, это разумно. Мне бы не хотелось увидеть, как он превращает этих существ в ещё более используемые объекты, чем они уже являются.",shape=box,color=blue];
		885 -> 881;
	886 [label="У Роута всегда есть своя цель, когда он с кем‑то разговаривает. Мне бы не хотелось увидеть, как он манипулирует этими существами, превращая их в ещё более используемые объекты, чем они уже являются.",shape=box,color=blue];
		886 -> 889;
	887 [label="Этот ребёнок… переживает собственный хаос. Мы не можем требовать от них ещё большего. Это неправильно.",shape=box,color=red];
		887 -> 890;
	888 [label="Наверное… это потому, что у меня есть «предыдущий опыт» с протофреймами?",shape=box,color=red];
		888 -> 891;
	889 [label="Возможно, стоит это расследовать, если у тебя будет время. Хотя это целиком на твоё усмотрение.",shape=box,color=blue];
		889 -> 881;
	890 [label="Да. Я слышал шёпоты о том, что им пришлось вынести. Истории о войне и… разрушенной дружбе, разорванной на части.",shape=box,color=blue];
		890 -> 892;
	891 [label="Check boolean IsDating",color=orange];
		891 -> 894 [label=true,color=green];
		891 -> 893 [label=false,color=brown];
	892 [label="Меня глубоко огорчает то, что уничтожается войной. И ещё более странно для меня то, что она способна создать.",shape=box,color=blue];
		892 -> 895;
	894 [label="Хм. Так они теперь это называют? «Предыдущий опыт?» Как удивительно деликатно. Хотя Энтрати, похоже, и устроил порядочный беспорядок, я рад, что у тебя… получилось найти способ себя развлечь.",shape=box,color=blue];
		894 -> 898;
		894 -> 899;
		894 -> 900;
	893 [label="М. Лойд рассказал мне о твоём «несчастливом приключении» в Хёльвании вашего прошлого, нашего будущего. Энтрати, конечно же, устроил изрядный беспорядок.",shape=box,color=blue];
		893 -> 896;
		893 -> 897;
	895 [label="М. Лойд рассказал мне о твоём «несчастливом приключении» в Хёльвании вашего прошлого, нашего будущего. Энтрати, конечно же, устроил изрядный беспорядок.",shape=box,color=blue];
		895 -> 896;
		895 -> 897;
	898 [label="Я что‑то сделал не так здесь?",shape=box,color=red];
		898 -> 903;
	899 [label="Будь осторожен, а то я могу подумать, что тебе интересно, не кажется ли трава зеленее на другой стороне забора, Cвященник.",shape=box,color=red];
		899 -> 904;
	900 [label="Ты говоришь так, будто это просто интрижка, Лион. Пожалуйста, не оскорбляй меня так.",shape=box,color=red];
		900 -> 905;
	896 [label="Поверь, всё могло бы закончиться гораздо хуже.",shape=box,color=red];
		896 -> 901;
	897 [label="Они мои хорошие друзья, эти протофреймы. Они стали для меня как семья.",shape=box,color=red];
		897 -> 902;
	903 [label="Check boolean LyonFirstFlirt",color=orange];
		903 -> 908 [label=true,color=green];
		903 -> 909 [label=false,color=brown];
	904 [label="Check boolean LyonFirstFlirt",color=orange];
		904 -> 908 [label=true,color=green];
		904 -> 910 [label=false,color=brown];
	905 [label="Check boolean LyonFirstFlirt",color=orange];
		905 -> 908 [label=true,color=green];
		905 -> 911 [label=false,color=brown];
	901 [label="И я уверен, что всё это было частью великого и мастерского плана Энтрати. Доверить судьбу будущего тебе и отряду изгоев.",shape=box,color=blue];
		901 -> 906;
	902 [label="Мои бабушка и дедушка встретились во времена Галлиикской революции. Война и смерть всегда шли рука об руку, ведя танец товарищества самыми странными способами.",shape=box,color=blue];
		902 -> 907;
	908 [label="Прости меня. Мне просто кажется, что в последний раз, когда мы обсуждали эти вопросы, ты... ",shape=box,color=blue];
		908 -> 915;
	909 [label="Прости меня. Я не знаю твоего сердца и сердец других. То, что ты делаешь в своё время с другими, это исключительно твоё дело.",shape=box,color=blue];
		909 -> 916;
		909 -> 917;
	910 [label="Прости меня. Нет, ты прав. Я не хочу звучать ревниво или как будто считаю себя каким-то провокатором. То, что ты делаешь в своё время с другими, это исключительно твое дело.",shape=box,color=blue];
		910 -> 916;
		910 -> 917;
	911 [label="Конечно. Прости меня. Я не знаю твоего сердца и сердец других. То, что ты делаешь в своё время с другими, это исключительно твоё дело.",shape=box,color=blue];
		911 -> 916;
		911 -> 917;
	906 [label="Я… Скиталец - я знаю, что я не самый… приветливый из тех, с кем тебе приходится взаимодействовать, и за это я продолжаю извиняться.",shape=box,color=blue];
		906 -> 912;
	907 [label="Update boolean LyonBackstory2",color=orange];
		907 -> 913;
		907 -> 914;
	915 [label="Нет, не важно… Мне не стоит удивляться, когда сердца изменчивы и непостоянны. Особенно когда я в этом замешан.",shape=box,color=blue];
		915 -> 921;
		915 -> 922;
	916 [label="Пришлось пройти через многое с ними. Это обычно сближает людей.",shape=box,color=red];
		916 -> 923;
	917 [label="[Признаться в чувствах.] Честно говоря, я всё равно пытаюсь понять, как поднять с тобой эту тему.",shape=box,color=red];
		917 -> 924;
	912 [label="Я просто такой, какой есть, и я не знаю, как измениться. Более того, я не думаю, что способен исправить тот вред, который нанесли моей душе проклятые, которые пришли преследовать меня.",shape=box,color=blue];
		912 -> 918;
	913 [label="Похоже, так и есть, так было повсюду на протяжении всей истории.",shape=box,color=red];
		913 -> 919;
	914 [label="Мне бы хотелось узнать больше о твоей семье.",shape=box,color=red];
		914 -> 920;
	921 [label="Подожди. Ты неправильно всё понял. Не было намерения вводить тебя в заблуждение. Просто… всё сложно.",shape=box,color=red];
		921 -> 931;
	922 [label="Я думала, что я тебе не интересен.",shape=box,color=red];
		922 -> 932;
	923 [label="Мои бабушка и дедушка встретились во времена Галлиикской революции. Война и смерть всегда шли рука об руку в танце, который порождает страсть и любовь самыми странными способами.",shape=box,color=blue];
		923 -> 907;
	924 [label="И теперь я ужасно нервничаю… Осмелюсь спросить - почему?",shape=box,color=blue];
		924 -> 933;
		924 -> 934;
	918 [label="То, что скрывается под этой поверхностью трескающегося стекла, - это...",shape=box,color=blue];
		918 -> 925;
		918 -> 926;
	919 [label="В самом деле. Полагаю, мне не стоит отвергать любые хорошие вещи, которые могут возникнуть из тьмы и разрушений войны.",shape=box,color=blue];
		919 -> 927;
		919 -> 928;
	920 [label="Это не та история, которую я люблю рассказывать. Кому бы то ни было. Так что прости, если я не спешу ею делиться. Возможно, в другой раз.",shape=box,color=blue];
		920 -> 929;
		920 -> 930;
	931 [label="Пожалуйста продолжай.",shape=box,color=blue];
		931 -> 933;
		931 -> 934;
	932 [label="Со всем уважением, я тебя не знаю. И учитывая всё, что на меня свалилось, романтические отношения с незнакомцем — далеко не самый главный мой приоритет.",shape=box,color=blue];
		932 -> 941;
	933 [label="Я… мы попробуем это в другой раз, прости. ",shape=box,color=red];
		933 -> 942;
	934 [label="Я не знаю, легко ли тебе это понять или звучит для тебя безумно, но… для меня я… могу испытывать сильные чувства к нескольким людям одновременно.",shape=box,color=red];
		934 -> 943;
	925 [label="Всё в порядке, Лион. Мы разберёмся. Я никуда не тороплюсь, поверь.",shape=box,color=red];
		925 -> 935;
	926 [label="Это, что?",shape=box,color=red];
		926 -> 936;
	927 [label="Ты о чём?",shape=box,color=red];
		927 -> 937;
	928 [label="Ты это отвергаешь?",shape=box,color=red];
		928 -> 938;
	929 [label="Я буду здесь.",shape=box,color=red];
		929 -> 939;
	930 [label="Конечно. Как только будешь готов, Лион.",shape=box,color=red];
		930 -> 940;
	941 [label="Я уверен, что есть другие, кто нашёл бы утешение в стремительных объятиях другого в подобных случаях, но я не из числа этих счастливых душ.",shape=box,color=blue];
		941 -> 948;
	942 [label="+20 Chemistry",color=orange];
		942 -> 949;
	943 [label="У меня есть чувства к тебе. Но и к ним тоже. И для меня оба чувства верны.",shape=box,color=red];
		943 -> 950;
	935 [label="+20 Chemistry",color=orange];
		935 -> 944;
	936 [label="+10 Chemistry",color=orange];
		936 -> 945;
	937 [label="Прости меня. Это не та история, которую я люблю рассказывать. Кому бы то ни было. Так что прости, если я не спешу ею делиться. Возможно, в другой раз.",shape=box,color=blue];
		937 -> 929;
		937 -> 930;
	938 [label="Не само существование любви — скорее, её отсутствие в моей собственной семейной жизни. Прости. Это не история, которую я люблю рассказывать. Кому бы то ни было. Так что прошу понять, если я не спешу ею делиться. Возможно, в другой раз.",shape=box,color=blue];
		938 -> 929;
		938 -> 930;
	939 [label="+15 Chemistry",color=orange];
		939 -> 946;
	940 [label="+20 Chemistry",color=orange];
		940 -> 947;
	948 [label="Возможно, лучше обратиться к кому‑то из них. Хорошего дня.",shape=box,color=blue];
		948 -> 954;
	949 [label="Очень хорошо. Мы можем обсудить это в другой раз, если ты того захочешь. А пока я вернусь к своим обязанностям на сегодня.",shape=box,color=blue];
		949 -> 954;
	950 [label="Такая концепция не настолько чужда моему сердцу, как тебе может показаться. В самом деле, меня останавливает не сама идея, а скорее те, кто в неё вовлечён — без обид.",shape=box,color=blue];
		950 -> 955;
	944 [label="Update boolean LyonVisions3",color=orange];
		944 -> 951;
	945 [label="Для большинства это слишком тяжело, чтобы вынести. Благодарю тебя за то, что продолжаешь пытаться. Вот и всё.",shape=box,color=blue];
		945 -> 952;
	946 [label="Да, я прихожу к этому неизбежному выводу. Хорошего дня.",shape=box,color=blue];
		946 -> 953;
	947 [label="Спасибо. До скорой встречи, желаю тебе хорошего дня.",shape=box,color=blue];
		947 -> 953;
	954 [label="-Ф. Лион Аллард",shape=box,color=blue];
		954 -> 958;
	955 [label="И, возможно, то, насколько близко к нашему новому «дому» стремится полететь твоя стрела.",shape=box,color=blue];
		955 -> 959;
		955 -> 960;
	951 [label="Спасибо...",shape=box,color=blue];
		951 -> 952;
	952 [label="-Ф. Лион Аллард",shape=box,color=blue];
		952 -> 956;
	953 [label="-Ф. Лион Аллард",shape=box,color=blue];
		953 -> 957;
	958 [label="Chat ends.",color=orange];
	959 [label="Честно говоря, я не говорил «сейчас». Просто объясняю себя.",shape=box,color=red];
		959 -> 961;
	960 [label="Итак… ты хочешь сказать, что… у меня есть шанс?",shape=box,color=red];
		960 -> 962;
	956 [label="Chat ends.",color=orange];
	957 [label="Chat ends.",color=orange];
	961 [label="+20 Chemistry",color=orange];
		961 -> 963;
	962 [label="+20 Chemistry",color=orange];
		962 -> 964;
	963 [label="Да, ну… Если к тому моменту я решу, что не испытываю к тебе отвращения, возможно, мы тогда снова поднимем этот разговор.",shape=box,color=blue];
		963 -> 965;
	964 [label="Да... возможно. Если к тому моменту я решу, что не стану тебя ненавидеть. Это ещё предстоит выяснить, Скиталец.",shape=box,color=blue];
		964 -> 965;
	965 [label="А теперь я должен вернуться к своим обязанностям на сегодня. Я ценю этот… интересный разговор. Наверное.",shape=box,color=blue];
