digraph {
	graph [fontname="Roboto Condensed"];
	node [fontname="Roboto Condensed"];
	edge [fontname="Roboto Condensed"];

	"LyonRank4Convo3 begins." [color=orange];
		"LyonRank4Convo3 begins." -> j3909048194;
		"LyonRank4Convo3 begins." -> j3132783912;
		"LyonRank4Convo3 begins." -> j1310452999;
	j3909048194 [label="Как у тебя складываются отношения с Кавией?",shape=box,color=red];
		j3909048194 -> j3171083433;
	j3132783912 [label="Что ты думаешь о Лойде?",shape=box,color=red];
		j3132783912 -> j176769516;
	j1310452999 [label="[Конец.]",shape=box,color=red];
		j1310452999 -> "Chat ends.";
	j3171083433 [label="Мне очень нравится слушать их шутки, хотя, как ты понимаешь, я сам в них не участвую. Мне нечего добавить к их разговору.",shape=box,color=blue];
		j3171083433 -> j967988034;
	j176769516 [label="Я нахожу его весьма приятным. На самом деле, среди моих новых… товарищей, именно к его обществу я испытываю наибольшее влечение.",shape=box,color=blue];
		j176769516 -> j1188210666;
	"Chat ends." [color=orange];
	j967988034 [label="Меня, однако, тревожит, когда я вижу, что Роут стоит и долго разговаривает с Птичкой 3. Я не понимаю, чего он хочет этим достичь.",shape=box,color=blue];
		j967988034 -> j2507757158;
	j1188210666 [label="Хотя, полагаю, это никого не удивит. На первый взгляд, у нас очень похожие темпераменты.",shape=box,color=blue];
		j1188210666 -> j1593185047;
	j2507757158 [label="Boolean LyonRoatheCavia1 is now true.",color=orange];
		j2507757158 -> j799256318;
		j2507757158 -> j1566065217;
	j1593185047 [label="Больше же странным мне кажется молодой Оператор… и та, кого называют Лотус. И то, как нас держат на расстоянии от них.",shape=box,color=blue];
		j1593185047 -> j2096405917;
	j799256318 [label="Хм. Я спрошу его об этом.",shape=box,color=red];
		j799256318 -> j2157316087;
	j1566065217 [label="Почему ты думаешь, что он чего‑то добивается?",shape=box,color=red];
		j1566065217 -> j2406003618;
	j2096405917 [label="Нам, конечно, разрешено взаимодействовать, но не так. Не здесь. Почему так?",shape=box,color=blue];
		j2096405917 -> j3989211571;
		j2096405917 -> j3780579852;
	j2157316087 [label="Возможно, это разумно. Мне бы не хотелось увидеть, как он превращает этих существ в ещё более используемые объекты, чем они уже являются.",shape=box,color=blue];
		j2157316087 -> j1593185047;
	j2406003618 [label="У Роута всегда есть своя цель, когда он с кем‑то разговаривает. Мне бы не хотелось увидеть, как он манипулирует этими существами, превращая их в ещё более используемые объекты, чем они уже являются.",shape=box,color=blue];
		j2406003618 -> j3731267898;
	j3989211571 [label="Этот ребёнок… переживает собственный хаос. Мы не можем требовать от них ещё большего. Это неправильно.",shape=box,color=red];
		j3989211571 -> j416760020;
	j3780579852 [label="Наверное… это потому, что у меня есть «предыдущий опыт» с протофреймами?",shape=box,color=red];
		j3780579852 -> j3260070664;
	j3731267898 [label="Возможно, стоит это расследовать, если у тебя будет время. Хотя это целиком на твоё усмотрение.",shape=box,color=blue];
		j3731267898 -> j1593185047;
	j416760020 [label="Да. Я слышал шёпоты о том, что им пришлось вынести. Истории о войне и… разрушенной дружбе, разорванной на части.",shape=box,color=blue];
		j416760020 -> j2111720417;
	j3260070664 [label="Check boolean IsDating",color=orange];
		j3260070664 -> j2531704245 [label=true,color=green];
		j3260070664 -> j3411739055 [label=false,color=brown];
	j2111720417 [label="Меня глубоко огорчает то, что уничтожается войной. И ещё более странно для меня то, что она способна создать.",shape=box,color=blue];
		j2111720417 -> j3411739055;
	j2531704245 [label="Хм. Так они теперь это называют? «Предыдущий опыт?» Как удивительно деликатно. Хотя Энтрати, похоже, и устроил порядочный беспорядок, я рад, что у тебя… получилось найти способ себя развлечь.",shape=box,color=blue];
		j2531704245 -> j3102605414;
		j2531704245 -> j2715944952;
		j2531704245 -> j1800054009;
	j3411739055 [label="М. Лойд рассказал мне о твоём «несчастливом приключении» в Хёльвании вашего прошлого, нашего будущего. Энтрати, конечно же, устроил изрядный беспорядок.",shape=box,color=blue];
		j3411739055 -> j2172823146;
		j3411739055 -> j529326143;
	j3102605414 [label="Я что‑то сделал не так здесь?",shape=box,color=red];
		j3102605414 -> j3487893497;
	j2715944952 [label="Будь осторожен, а то я могу подумать, что тебе интересно, не кажется ли трава зеленее на другой стороне забора, Cвященник.",shape=box,color=red];
		j2715944952 -> j619519124;
	j1800054009 [label="Ты говоришь так, будто это просто интрижка, Лион. Пожалуйста, не оскорбляй меня так.",shape=box,color=red];
		j1800054009 -> j1331458418;
	j2172823146 [label="Поверь, всё могло бы закончиться гораздо хуже.",shape=box,color=red];
		j2172823146 -> j1809798063;
	j529326143 [label="Они мои хорошие друзья, эти протофреймы. Они стали для меня как семья.",shape=box,color=red];
		j529326143 -> j4119653030;
	j3487893497 [label="Check boolean LyonFirstFlirt",color=orange];
		j3487893497 -> j1135139822 [label=true,color=green];
		j3487893497 -> j1823254389 [label=false,color=brown];
	j619519124 [label="Check boolean LyonFirstFlirt",color=orange];
		j619519124 -> j1135139822 [label=true,color=green];
		j619519124 -> j2919652659 [label=false,color=brown];
	j1331458418 [label="Check boolean LyonFirstFlirt",color=orange];
		j1331458418 -> j1135139822 [label=true,color=green];
		j1331458418 -> j3423688680 [label=false,color=brown];
	j1809798063 [label="И я уверен, что всё это было частью великого и мастерского плана Энтрати. Доверить судьбу будущего тебе и отряду изгоев.",shape=box,color=blue];
		j1809798063 -> j2149155746;
	j4119653030 [label="Мои бабушка и дедушка встретились во времена Галлиикской революции. Война и смерть всегда шли рука об руку, ведя танец товарищества самыми странными способами.",shape=box,color=blue];
		j4119653030 -> j3628502303;
	j1135139822 [label="Прости меня. Мне просто кажется, что в последний раз, когда мы обсуждали эти вопросы, ты... ",shape=box,color=blue];
		j1135139822 -> j1117216982;
	j1823254389 [label="Прости меня. Я не знаю твоего сердца и сердец других. То, что ты делаешь в своё время с другими, это исключительно твоё дело.",shape=box,color=blue];
		j1823254389 -> j1210187858;
		j1823254389 -> j4208515296;
	j2919652659 [label="Прости меня. Нет, ты прав. Я не хочу звучать ревниво или как будто считаю себя каким-то провокатором. То, что ты делаешь в своё время с другими, это исключительно твое дело.",shape=box,color=blue];
		j2919652659 -> j1210187858;
		j2919652659 -> j4208515296;
	j3423688680 [label="Конечно. Прости меня. Я не знаю твоего сердца и сердец других. То, что ты делаешь в своё время с другими, это исключительно твоё дело.",shape=box,color=blue];
		j3423688680 -> j1210187858;
		j3423688680 -> j4208515296;
	j2149155746 [label="Я… Скиталец - я знаю, что я не самый… приветливый из тех, с кем тебе приходится взаимодействовать, и за это я продолжаю извиняться.",shape=box,color=blue];
		j2149155746 -> j1105844957;
	j3628502303 [label="Boolean LyonBackstory2 is now true.",color=orange];
		j3628502303 -> j2203359330;
		j3628502303 -> j224830283;
	j1117216982 [label="Нет, не важно… Мне не стоит удивляться, когда сердца изменчивы и непостоянны. Особенно когда я в этом замешан.",shape=box,color=blue];
		j1117216982 -> j1266182075;
		j1117216982 -> j3203752449;
	j1210187858 [label="Пришлось пройти через многое с ними. Это обычно сближает людей.",shape=box,color=red];
		j1210187858 -> j2156682584;
	j4208515296 [label="[Признаться в чувствах.] Честно говоря, я всё равно пытаюсь понять, как поднять с тобой эту тему.",shape=box,color=red];
		j4208515296 -> j897194311;
	j1105844957 [label="Я просто такой, какой есть, и я не знаю, как измениться. Более того, я не думаю, что способен исправить тот вред, который нанесли моей душе проклятые, которые пришли преследовать меня.",shape=box,color=blue];
		j1105844957 -> j2243923394;
	j2203359330 [label="Похоже, так и есть, так было повсюду на протяжении всей истории.",shape=box,color=red];
		j2203359330 -> j1350123952;
	j224830283 [label="Мне бы хотелось узнать больше о твоей семье.",shape=box,color=red];
		j224830283 -> j623752157;
	j1266182075 [label="Подожди. Ты неправильно всё понял. Не было намерения вводить тебя в заблуждение. Просто… всё сложно.",shape=box,color=red];
		j1266182075 -> j1096402843;
	j3203752449 [label="Я думала, что я тебе не интересен.",shape=box,color=red];
		j3203752449 -> j304520847;
	j2156682584 [label="Мои бабушка и дедушка встретились во времена Галлиикской революции. Война и смерть всегда шли рука об руку в танце, который порождает страсть и любовь самыми странными способами.",shape=box,color=blue];
		j2156682584 -> j3628502303;
	j897194311 [label="И теперь я ужасно нервничаю… Осмелюсь спросить - почему?",shape=box,color=blue];
		j897194311 -> j3564201258;
		j897194311 -> j33702784;
	j2243923394 [label="То, что скрывается под этой поверхностью трескающегося стекла, - это...",shape=box,color=blue];
		j2243923394 -> j3313609246;
		j2243923394 -> j1183861460;
	j1350123952 [label="В самом деле. Полагаю, мне не стоит отвергать любые хорошие вещи, которые могут возникнуть из тьмы и разрушений войны.",shape=box,color=blue];
		j1350123952 -> j1971609120;
		j1350123952 -> j946729010;
	j623752157 [label="Это не та история, которую я люблю рассказывать. Кому бы то ни было. Так что прости, если я не спешу ею делиться. Возможно, в другой раз.",shape=box,color=blue];
		j623752157 -> j1188206790;
		j623752157 -> j2106643726;
	j1096402843 [label="Пожалуйста продолжай.",shape=box,color=blue];
		j1096402843 -> j3564201258;
		j1096402843 -> j33702784;
	j304520847 [label="Со всем уважением, я тебя не знаю. И учитывая всё, что на меня свалилось, романтические отношения с незнакомцем — далеко не самый главный мой приоритет.",shape=box,color=blue];
		j304520847 -> j615383021;
	j3564201258 [label="Я… мы попробуем это в другой раз, прости. ",shape=box,color=red];
		j3564201258 -> j1068012552;
	j33702784 [label="Я не знаю, легко ли тебе это понять или звучит для тебя безумно, но… для меня я… могу испытывать сильные чувства к нескольким людям одновременно.",shape=box,color=red];
		j33702784 -> j2759798652;
	j3313609246 [label="Всё в порядке, Лион. Мы разберёмся. Я никуда не тороплюсь, поверь.",shape=box,color=red];
		j3313609246 -> j2913781195;
	j1183861460 [label="Это, что?",shape=box,color=red];
		j1183861460 -> j2010665018;
	j1971609120 [label="Ты о чём?",shape=box,color=red];
		j1971609120 -> j3067125739;
	j946729010 [label="Ты это отвергаешь?",shape=box,color=red];
		j946729010 -> j1308453374;
	j1188206790 [label="Я буду здесь.",shape=box,color=red];
		j1188206790 -> j2769999561;
	j2106643726 [label="Конечно. Как только будешь готов, Лион.",shape=box,color=red];
		j2106643726 -> j94748195;
	j615383021 [label="Я уверен, что есть другие, кто нашёл бы утешение в стремительных объятиях другого в подобных случаях, но я не из числа этих счастливых душ.",shape=box,color=blue];
		j615383021 -> j3126434927;
	j1068012552 [label="+20 Chemistry",color=orange];
		j1068012552 -> j2974301423;
	j2759798652 [label="У меня есть чувства к тебе. Но и к ним тоже. И для меня оба чувства верны.",shape=box,color=red];
		j2759798652 -> j693465297;
	j2913781195 [label="+20 Chemistry",color=orange];
		j2913781195 -> j2312547136;
	j2010665018 [label="+10 Chemistry",color=orange];
		j2010665018 -> j3444469619;
	j3067125739 [label="Прости меня. Это не та история, которую я люблю рассказывать. Кому бы то ни было. Так что прости, если я не спешу ею делиться. Возможно, в другой раз.",shape=box,color=blue];
		j3067125739 -> j1188206790;
		j3067125739 -> j2106643726;
	j1308453374 [label="Не само существование любви — скорее, её отсутствие в моей собственной семейной жизни. Прости. Это не история, которую я люблю рассказывать. Кому бы то ни было. Так что прошу понять, если я не спешу ею делиться. Возможно, в другой раз.",shape=box,color=blue];
		j1308453374 -> j1188206790;
		j1308453374 -> j2106643726;
	j2769999561 [label="+15 Chemistry",color=orange];
		j2769999561 -> j4280076605;
	j94748195 [label="+20 Chemistry",color=orange];
		j94748195 -> j2229443736;
	j3126434927 [label="Возможно, лучше обратиться к кому‑то из них. Хорошего дня.",shape=box,color=blue];
		j3126434927 -> j1542260442;
	j2974301423 [label="Очень хорошо. Мы можем обсудить это в другой раз, если ты того захочешь. А пока я вернусь к своим обязанностям на сегодня.",shape=box,color=blue];
		j2974301423 -> j1542260442;
	j693465297 [label="Такая концепция не настолько чужда моему сердцу, как тебе может показаться. В самом деле, меня останавливает не сама идея, а скорее те, кто в неё вовлечён — без обид.",shape=box,color=blue];
		j693465297 -> j1034975758;
	j2312547136 [label="Boolean LyonVisions3 is now true.",color=orange];
		j2312547136 -> j1703685557;
	j3444469619 [label="Для большинства это слишком тяжело, чтобы вынести. Благодарю тебя за то, что продолжаешь пытаться. Вот и всё.",shape=box,color=blue];
		j3444469619 -> j1542260442;
	j4280076605 [label="Да, я прихожу к этому неизбежному выводу. Хорошего дня.",shape=box,color=blue];
		j4280076605 -> j1542260442;
	j2229443736 [label="Спасибо. До скорой встречи, желаю тебе хорошего дня.",shape=box,color=blue];
		j2229443736 -> j1542260442;
	j1542260442 [label="-Ф. Лион Аллард",shape=box,color=blue];
		j1542260442 -> "Chat ends.";
	j1034975758 [label="И, возможно, то, насколько близко к нашему новому «дому» стремится полететь твоя стрела.",shape=box,color=blue];
		j1034975758 -> j2009604479;
		j1034975758 -> j2155603309;
	j1703685557 [label="Спасибо...",shape=box,color=blue];
		j1703685557 -> j1542260442;
	j2009604479 [label="Честно говоря, я не говорил «сейчас». Просто объясняю себя.",shape=box,color=red];
		j2009604479 -> j3524526472;
	j2155603309 [label="Итак… ты хочешь сказать, что… у меня есть шанс?",shape=box,color=red];
		j2155603309 -> j3310124751;
	j3524526472 [label="+20 Chemistry",color=orange];
		j3524526472 -> j1814645598;
	j3310124751 [label="+20 Chemistry",color=orange];
		j3310124751 -> j1095662428;
	j1814645598 [label="Да, ну… Если к тому моменту я решу, что не испытываю к тебе отвращения, возможно, мы тогда снова поднимем этот разговор.",shape=box,color=blue];
		j1814645598 -> j1717159270;
	j1095662428 [label="Да... возможно. Если к тому моменту я решу, что не стану тебя ненавидеть. Это ещё предстоит выяснить, Скиталец.",shape=box,color=blue];
		j1095662428 -> j1717159270;
	j1717159270 [label="А теперь я должен вернуться к своим обязанностям на сегодня. Я ценю этот… интересный разговор. Наверное.",shape=box,color=blue];
		j1717159270 -> j2501983996;
	j2501983996 [label="Boolean DrifterLyon is now true.",color=orange];
		j2501983996 -> j1156565171;
	j1156565171 [label="Boolean LyonDatingWait is now true.",color=orange];
		j1156565171 -> j1542260442;
}