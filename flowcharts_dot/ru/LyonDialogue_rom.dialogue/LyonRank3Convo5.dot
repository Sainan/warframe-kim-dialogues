digraph {
	graph [fontname="Roboto Condensed"];
	node [fontname="Roboto Condensed"];
	edge [fontname="Roboto Condensed"];

	"LyonRank3Convo5 begins." [color=orange];
		"LyonRank3Convo5 begins." -> j3796342901;
	j3796342901 [label="В ту ночь гремела гроза, когда Cardinal Dimanche пришёл к нам. Он стоял в святилище церкви, не тронутый штормом, который бушевал снаружи.",shape=box,color=blue];
		j3796342901 -> j477225032;
	j477225032 [label="Это должно было послужить моей первой причиной для беспокойства. Вместо этого я склонил перед ним голову и поприветствовал его так, как приветствовал бы любого нового посланника Пресвятой Матери.",shape=box,color=blue];
		j477225032 -> j1366589975;
	j1366589975 [label="Мы, в конце концов, ожидали нового кардинала с тех пор, как наш предыдущий скончался несколько месяцев назад от болезни.",shape=box,color=blue];
		j1366589975 -> j2232568246;
	j2232568246 [label="Dimanche поприветствовал меня тёплой улыбкой и крепким рукопожатием. Я спросил его, долгим ли было его путешествие. Его ответ я никогда не забуду.",shape=box,color=blue];
		j2232568246 -> j823556881;
	j823556881 [label="«Путь был тяжёлым... но не долгим».",shape=box,color=blue];
		j823556881 -> j3127675000;
	j3127675000 [label="В то время это озадачило меня, как и тот факт, что его шинель была абсолютно сухой. Но я отмахнулся от этого, как обычно поступают все, кто сталкивается с необычным.",shape=box,color=blue];
		j3127675000 -> j147664407;
	j147664407 [label="И у меня не было времени обдумать это, так как Мари в своем нетерпении появилась мгновение спустя.",shape=box,color=blue];
		j147664407 -> j2214599849;
	j2214599849 [label="Он опустился на колени, чтобы поприветствовать её на уровне её кресла, и взял её руки в свои. Я должен был понять, что это была за манипуляция.",shape=box,color=blue];
		j2214599849 -> j471510599;
	j471510599 [label="В конце концов, он был не единственным дьяволом, что явился к нашему порогу во время бури.",shape=box,color=blue];
		j471510599 -> j1928339452;
	j1928339452 [label="Boolean LyonEntrati1 is now true.",color=orange];
		j1928339452 -> j2100050873;
	j2100050873 [label="Check boolean MarieEntrati1",color=orange];
		j2100050873 -> j3159227661 [label=true,color=green];
		j2100050873 -> j3624080031 [label=true,color=green];
		j2100050873 -> j1385893085 [label=true,color=green];
		j2100050873 -> j4074901471 [label=false,color=brown];
		j2100050873 -> j3159227661 [label=false,color=brown];
	j3159227661 [label="Другой дьявол это Роут?",shape=box,color=red];
		j3159227661 -> j3113501436;
	j3624080031 [label="Она рассказывает эту историю совсем по-другому.",shape=box,color=red];
		j3624080031 -> j2681018677;
	j1385893085 [label="Она всё ещё верит в его добрые намерения. А ты?",shape=box,color=red];
		j1385893085 -> j504570630;
	j4074901471 [label="Я так понимаю, ты не союзник Энтрати?",shape=box,color=red];
		j4074901471 -> j3451949777;
	j3113501436 [label="Да. Но это история для другого раза. Если я начну говорить о нём, моё и без того скверное настроение испортится... ",shape=box,color=blue];
		j3113501436 -> j2145905679;
	j2681018677 [label="Да. В самом деле.",shape=box,color=blue];
		j2681018677 -> j583439389;
		j2681018677 -> j1838738231;
	j504570630 [label="+5 Chemistry",color=orange];
		j504570630 -> j2575118466;
	j3451949777 [label="После того, как мы пережили его ложь и предательство, и пока мы продолжаем страдать от его манипуляций с Мари, тебе бы хотелось бы, чтобы я был таким? Нет, я определенно не такой.",shape=box,color=blue];
		j3451949777 -> j3463226852;
	j2145905679 [label="…неприемлемо. Я бы куда охотнее предпочёл бы направить своё нынешнее состояние на проступки Энтрати, если тебе нет разницы.",shape=box,color=blue];
		j2145905679 -> j1428371468;
	j583439389 [label="Она сказала мне, что ты порой видишь то, чего другие не замечают.",shape=box,color=red];
		j583439389 -> j2477073165;
	j1838738231 [label="И? ",shape=box,color=red];
		j1838738231 -> j3850118618;
	j2575118466 [label="Мари видит в каждой душе самое лучшее. Это умение она выработала и довела его до совершенства и отполировала как щит от всего, что её окружает.",shape=box,color=blue];
		j2575118466 -> j1275680474;
		j2575118466 -> j2319358511;
	j3463226852 [label="+5 Chemistry",color=orange];
		j3463226852 -> j3433502857;
	j1428371468 [label="Check boolean RoatheSerum1",color=orange];
		j1428371468 -> j2127823619 [label=true,color=green];
		j1428371468 -> j2009685606 [label=true,color=green];
		j1428371468 -> j2127823619 [label=false,color=brown];
		j1428371468 -> j3952346574 [label=false,color=brown];
	j2477073165 [label="И что бы ты сказал об этом утверждении, если бы оно было правдой, Скиталец?",shape=box,color=blue];
		j2477073165 -> j2821822155;
	j3850118618 [label="«И» ничего. Я рассказал тебе о том, как я был свидетелем этого события, как об истинном моём переживании этого события. Больше ничего.",shape=box,color=blue];
		j3850118618 -> j2575118466;
	j1275680474 [label="Мари не располагает всеми фактами о том, на что на самом деле способен Энтрати, и обо всех ужасных вещах, которые он совершил во имя «прогресса», а теперь и «искупления».",shape=box,color=red];
		j1275680474 -> j1343375574;
	j2319358511 [label="Мари взрослая женщина. И хотя я ценю твоё стремление защищать её, она может сама решать, во что ей верить и в кого верить.",shape=box,color=red];
		j2319358511 -> j4211736425;
	j3433502857 [label="Оскверняющие наши тела, разрушающие наше будущее, искажающие наше прошлое - всё это, возможно, я мог бы простить.",shape=box,color=blue];
		j3433502857 -> j2506218858;
	j2127823619 [label="У Энтрати, возможно, не самые лучшие манеры, но он пытается спасти вселенную.",shape=box,color=red];
		j2127823619 -> j3433502857;
	j2009685606 [label="Он заставил тебя стать протофреймом, как Роут?",shape=box,color=red];
		j2009685606 -> j2572921829;
	j3952346574 [label="Конечно. Почему ты так расстроен из-за Энтрати?",shape=box,color=red];
		j3952346574 -> j3463226852;
	j2821822155 [label="Check boolean LyonVisions1",color=orange];
		j2821822155 -> j211049165 [label=true,color=green];
		j2821822155 -> j598981925 [label=true,color=green];
		j2821822155 -> j3714547798 [label=true,color=green];
		j2821822155 -> j211049165 [label=false,color=brown];
		j2821822155 -> j2963287501 [label=false,color=brown];
		j2821822155 -> j598981925 [label=false,color=brown];
	j1343375574 [label="Доверие подобно витражу. Хрупкое в своём создании. Прекрасное в своём великолепии. Трагичное в момент разрушения. И опасное, когда оно разбито.",shape=box,color=blue];
		j1343375574 -> j3964237135;
	j4211736425 [label="Доверие подобно витражу. Хрупкое в своём создании. Прекрасное в своём великолепии. Трагичное в момент разрушения. И опасное, когда оно разбито.",shape=box,color=blue];
		j4211736425 -> j3247322111;
	j2506218858 [label="Но видеть, как он перекроил Мари... как использовал её светлую веру в других ради своих собственных целей?",shape=box,color=blue];
		j2506218858 -> j1404002213;
	j2572921829 [label="Нет. У меня свои были причины принять эликсир. Я знал, в какое исковерканное существо он меня превратит. Как знала и Мари.",shape=box,color=blue];
		j2572921829 -> j2784831068;
	j211049165 [label="Наверное, мне в целом всё равно?",shape=box,color=red];
		j211049165 -> j2332800363;
	j598981925 [label="Мой единственный вопрос в том, если ты действительно что-то видишь, беспокоят ли тебя эти видения?",shape=box,color=red];
		j598981925 -> j818726377;
	j3714547798 [label="После того, что ты сказал на днях - меня заставило задуматься, всё ли у тебя в порядке, вот и всё.",shape=box,color=red];
		j3714547798 -> j2784912812;
	j2963287501 [label="Я просто хочу понять, всё ли у тебя в порядке, вот и всё.",shape=box,color=red];
		j2963287501 -> j2784912812;
	j3964237135 [label="+15 Chemistry",color=orange];
		j3964237135 -> j3892576786;
	j3247322111 [label="В тёплом свете Сола она греется его сиянием, не замечая изъянов, что проступают на его поверхности. Не слыша, как трещины становятся глубже.",shape=box,color=blue];
		j3247322111 -> j768659706;
	j1404002213 [label="Этого я никогда не прощу. За это я желаю выбить покаяние из его плоти своим кадилом, пока он не станет умолять о спасении.",shape=box,color=blue];
		j1404002213 -> j1275680474;
		j1404002213 -> j2319358511;
	j2784831068 [label="Мы не были... сломлены насильно, как тот дьявол. И часть моего сердца сочувствует Роуту за всё, что ему пришлось пережить.",shape=box,color=blue];
		j2784831068 -> j1931849671;
	j2332800363 [label="Тогда я не вижу смысла продолжать этот разговор.",shape=box,color=blue];
		j2332800363 -> "Chat ends.";
	j818726377 [label="Я буду предельно откровенен, я не знаю, как ответить на это, Скиталец.",shape=box,color=blue];
		j818726377 -> j4283588588;
	j2784912812 [label="Boolean LyonAllRight is now true.",color=orange];
		j2784912812 -> j210937615;
	j3892576786 [label="Если бы я только мог вырвать из неё ту скверну, что он вложил в её разуме. Я лишь могу молить о том, чтобы тебе удалось то, чего не смог добиться я.",shape=box,color=blue];
		j3892576786 -> j2038856903;
	j768659706 [label="Не подозревая о том, что осколки её собственного шедевра вскоре будут обращены против неё. Предпочитая закрывать глаза на то, что неизбежно последует.",shape=box,color=blue];
		j768659706 -> j2499183117;
	j1931849671 [label="Затем он открывает рот, чтобы заговорить.",shape=box,color=blue];
		j1931849671 -> j2382684689;
		j1931849671 -> j562284119;
	"Chat ends." [color=orange];
	j4283588588 [label="За все мои годы я видел ужасы, от которых других бы давно отправили в психушки. Что ещё более трагично, время от времени мои видения действительно сбывались.",shape=box,color=blue];
		j4283588588 -> j3065577900;
	j210937615 [label="«Всё ли у меня в порядке»? Я буду предельно откровенен, я не знаю, как ответить на это, Скиталец.",shape=box,color=blue];
		j210937615 -> j4283588588;
	j2038856903 [label="-О. Лион Аллард",shape=box,color=blue];
		j2038856903 -> "Chat ends.";
	j2499183117 [label="Если бы только я мог принять эти страдания вместо неё, с какой радостью я бы вытатуировал это в своей душе. Но это предназначено ей, и только ей.",shape=box,color=blue];
		j2499183117 -> j879001267;
	j2382684689 [label="Нужно помнить, каким было его воспитание. В каком мире ему приходилось учиться жить. Он был - есть - Орокин.",shape=box,color=red];
		j2382684689 -> j4073735349;
		j2382684689 -> j3615814157;
	j562284119 [label="Честно говоря, я не думаю, что он такой уж ужасный. Он постепенно начинает мне нравиться.",shape=box,color=red];
		j562284119 -> j3022627292;
	j3065577900 [label="Boolean LyonVisions1 is now true.",color=orange];
		j3065577900 -> j3144221222;
	j879001267 [label="Так что я постараюсь предотвратить эту боль, Скиталец. ",shape=box,color=blue];
		j879001267 -> j836478225;
	j4073735349 [label="Это не делает всё правильным, но, возможно, поможет тебе научиться идти ему навстречу.",shape=box,color=red];
		j4073735349 -> j1077965337;
	j3615814157 [label="Он поступает так, как считает нужным.",shape=box,color=red];
		j3615814157 -> j2696395841;
	j3022627292 [label="Я бы сходил к M. Лойду за мазью от этого недуга. Чтобы он не распространялся.",shape=box,color=blue];
		j3022627292 -> j3627765297;
		j3022627292 -> j20268679;
	j3144221222 [label="Boolean LyonBackstory1 is now true.",color=orange];
		j3144221222 -> j3184244210;
	j836478225 [label="А если ты усматриваешь в этом поступке какую-то попытку принизить ее?",shape=box,color=blue];
		j836478225 -> j4094882177;
	j1077965337 [label="Add 1 to Thermostat counter",color=orange];
		j1077965337 -> j1967743549;
	j2696395841 [label="Add -1 to Thermostat counter",color=orange];
		j2696395841 -> j3792985330;
	j3627765297 [label="У дьявола всегда есть своя особая притягательность.",shape=box,color=red];
		j3627765297 -> j2494373704;
	j20268679 [label="Не волнуйся, я не поддамся его обаянию.",shape=box,color=red];
		j20268679 -> j520891111;
	j3184244210 [label="И поэтому я принимал их за наставления Луа. Что я был избран Люминариями для того, чтобы нести такое бремя. По крайней мере, в то время я так считал. Вот причина, по которой я стремился стать священником.",shape=box,color=blue];
		j3184244210 -> j287546222;
		j3184244210 -> j2979511281;
		j3184244210 -> j52455596;
	j4094882177 [label="Да пусть сжалится Луа над твоей душой.",shape=box,color=blue];
		j4094882177 -> j2038856903;
	j1967743549 [label="В нашем писании говорится, что с бесами не ведут переговоров- их изгоняют. Но они не подготовили нас к этому конкретному состоянию.",shape=box,color=blue];
		j1967743549 -> j2196255362;
	j3792985330 [label="Возможно. Я пока не могу с уверенностью сказать, что в сердце этого существа не таятся сомнения.",shape=box,color=blue];
		j3792985330 -> j2196255362;
	j2494373704 [label="Add -1 to Thermostat counter",color=orange];
		j2494373704 -> j1707147642;
	j520891111 [label="Add 1 to Thermostat counter",color=orange];
		j520891111 -> j1167839777;
	j287546222 [label="Ты верил, что эти видения исходили от Луа? Теперь уже нет?",shape=box,color=red];
		j287546222 -> j3647532123;
	j2979511281 [label="Какого именно рода ужасы...?",shape=box,color=red];
		j2979511281 -> j3887731479;
	j52455596 [label="И что ты думаешь об этом теперь?",shape=box,color=red];
		j52455596 -> j4133384734;
	j2196255362 [label="Мы ещё увидим, какой путь этот дьявол выберет со временем, не так ли?",shape=box,color=blue];
		j2196255362 -> j540250305;
	j1707147642 [label="И это меня беспокоит. Дьявол улыбается и говорит разумно, когда все остальные изрыгают безумие. ",shape=box,color=blue];
		j1707147642 -> j300420107;
	j1167839777 [label="+20 Chemistry",color=orange];
		j1167839777 -> j798965872;
	j3647532123 [label="То, во что я верю, в последнее время стало... сложным из-за появления новой информации.",shape=box,color=blue];
		j3647532123 -> j4133384734;
	j3887731479 [label="Мы ведь только начали говорить о таких вещах, Скиталец. Не то чтобы я не верил, что ты своими глазами видел самые ужасные страдания, и я не верю в то, что ты нуждался бы в защите от тех скудных описаний, которые я мог бы придумать.",shape=box,color=blue];
		j3887731479 -> j1939825498;
	j4133384734 [label="Проще говоря, Скиталец, было бы честно сказать, что я не знаю, во что верить.",shape=box,color=blue];
		j4133384734 -> j678685353;
	j540250305 [label="-О. Лион Аллард",shape=box,color=blue];
		j540250305 -> j367054140;
	j300420107 [label="Он подстерегает нас в моменты нашей наибольшей неосмотрительности - когда мы уязвимы. Когда мы слабы. Когда мы отчаянно нуждаемся в ответах.",shape=box,color=blue];
		j300420107 -> j392607914;
		j300420107 -> j2290197398;
	j798965872 [label="Хорошо. Постарайся не позволять этому случиться. Мне бы очень не хотелось вдалбливать в тебя хоть немного здравого смысла. Похоже, ты из тех, кто открывает ответный огонь.",shape=box,color=blue];
		j798965872 -> j139806738;
	j1939825498 [label="Мне просто тяжело обсуждать подобные вещи с тем, которого я едва знаю, лишь затем, чтобы никогда больше не подошел ко мне. Я бы предпочёл избежать подобного, особенно сейчас, когда мы, кажется, вынуждены работать вместе, по крайней мере, в ближайшее время.",shape=box,color=blue];
		j1939825498 -> j2838512320;
		j1939825498 -> j3271029105;
	j678685353 [label="Boolean LyonFaith1 is now true.",color=orange];
		j678685353 -> j251928733;
	j367054140 [label="+20 Chemistry",color=orange];
		j367054140 -> "Chat ends.";
	j392607914 [label="Я справлюсь самостоятельно. Обещаю, я не позволю ему влезть мне в голову.",shape=box,color=red];
		j392607914 -> j1210636640;
	j2290197398 [label="Похоже, ты говоришь из личного опыта. Какие ответы он дал тебе?",shape=box,color=red];
		j2290197398 -> j3366956378;
	j139806738 [label="И в каком же странном состоянии мы бы оказались тогда?",shape=box,color=blue];
		j139806738 -> "Chat ends.";
	j2838512320 [label="Если ты хочешь подождать, пока не начнёшь мне больше доверять, я понимаю.",shape=box,color=red];
		j2838512320 -> j2704659988;
	j3271029105 [label="Я никуда не уйду, Лион. Ты можешь мне доверять.",shape=box,color=red];
		j3271029105 -> j1673952207;
	j251928733 [label="Но боюсь, эти все разговоры для другого раза.",shape=box,color=blue];
		j251928733 -> j1484903352;
	j1210636640 [label="+20 Chemistry",color=orange];
		j1210636640 -> j1304813314;
	j3366956378 [label="Те, которых я боюсь... поставили под сомнение множество прежних убеждений. Но боюсь, эти все разговоры для другого раза.",shape=box,color=blue];
		j3366956378 -> j2710405964;
	j2704659988 [label="+20 Chemistry",color=orange];
		j2704659988 -> j1960887780;
	j1673952207 [label="+15 Chemistry",color=orange];
		j1673952207 -> j2968554301;
	j1484903352 [label="+20 Chemistry",color=orange];
		j1484903352 -> j3765177545;
