	532 [label="То, во что я верю, в последнее время стало... сложным из-за появления новой информации.",shape=box,color=blue];
		532 -> 534;
	533 [label="Мы ведь только начали говорить о таких вещах, Скиталец. Не то чтобы я не верил, что ты своими глазами видел самые ужасные страдания, и я не верю в то, что ты нуждался бы в защите от тех скудных описаний, которые я мог бы придумать.",shape=box,color=blue];
		533 -> 539;
