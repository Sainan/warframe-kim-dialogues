		518 -> 524;
	519 [label="И поэтому я принимал их за наставления Луа. Что я был избран Люминариями для того, чтобы нести такое бремя. По крайней мере, в то время я так считал. Вот причина, по которой я стремился стать священником.",shape=box,color=blue];
		519 -> 525;
