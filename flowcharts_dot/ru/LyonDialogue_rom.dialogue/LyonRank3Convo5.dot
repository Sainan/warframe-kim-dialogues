digraph {
	445 [label="LyonRank3Convo5 begins.",color=orange];
		445 -> 446;
	446 [label="В ту ночь гремела гроза, когда Cardinal Dimanche пришёл к нам. Он стоял в святилище церкви, не тронутый штормом, который бушевал снаружи.",shape=box,color=blue];
		446 -> 447;
	447 [label="Это должно было послужить моей первой причиной для беспокойства. Вместо этого я склонил перед ним голову и поприветствовал его так, как приветствовал бы любого нового посланника Пресвятой Матери.",shape=box,color=blue];
		447 -> 448;
	448 [label="Мы, в конце концов, ожидали нового кардинала с тех пор, как наш предыдущий скончался несколько месяцев назад от болезни.",shape=box,color=blue];
		448 -> 449;
	449 [label="Dimanche поприветствовал меня тёплой улыбкой и крепким рукопожатием. Я спросил его, долгим ли было его путешествие. Его ответ я никогда не забуду.",shape=box,color=blue];
		449 -> 450;
	450 [label="«Путь был тяжёлым... но не долгим».",shape=box,color=blue];
		450 -> 451;
	451 [label="В то время это озадачило меня, как и тот факт, что его шинель была абсолютно сухой. Но я отмахнулся от этого, как обычно поступают все, кто сталкивается с необычным.",shape=box,color=blue];
		451 -> 452;
	452 [label="И у меня не было времени обдумать это, так как Мари в своем нетерпении появилась мгновение спустя.",shape=box,color=blue];
		452 -> 453;
	453 [label="Он опустился на колени, чтобы поприветствовать её на уровне её кресла, и взял её руки в свои. Я должен был понять, что это была за манипуляция.",shape=box,color=blue];
		453 -> 454;
	454 [label="В конце концов, он был не единственным дьяволом, что явился к нашему порогу во время бури.",shape=box,color=blue];
		454 -> 455;
	455 [label="Update boolean LyonEntrati1",color=orange];
		455 -> 456;
	456 [label="Check boolean MarieEntrati1",color=orange];
		456 -> 457 [label=true,color=green];
		456 -> 459 [label=true,color=green];
		456 -> 460 [label=true,color=green];
		456 -> 458 [label=false,color=brown];
		456 -> 457 [label=false,color=brown];
	457 [label="Другой дьявол это Роут?",shape=box,color=red];
		457 -> 461;
	459 [label="Она рассказывает эту историю совсем по-другому.",shape=box,color=red];
		459 -> 463;
	460 [label="Она всё ещё верит в его добрые намерения. А ты?",shape=box,color=red];
		460 -> 464;
	458 [label="Я так понимаю, ты не союзник Энтрати?",shape=box,color=red];
		458 -> 462;
	461 [label="Да. Но это история для другого раза. Если я начну говорить о нём, моё и без того скверное настроение испортится... ",shape=box,color=blue];
		461 -> 465;
	463 [label="Да. В самом деле.",shape=box,color=blue];
		463 -> 467;
		463 -> 468;
	464 [label="+5 Chemistry",color=orange];
		464 -> 469;
	462 [label="После того, как мы пережили его ложь и предательство, и пока мы продолжаем страдать от его манипуляций с Мари, тебе бы хотелось бы, чтобы я был таким? Нет, я определенно не такой.",shape=box,color=blue];
		462 -> 466;
	465 [label="…неприемлемо. Я бы куда охотнее предпочёл бы направить своё нынешнее состояние на проступки Энтрати, если тебе нет разницы.",shape=box,color=blue];
		465 -> 470;
	467 [label="Она сказала мне, что ты порой видишь то, чего другие не замечают.",shape=box,color=red];
		467 -> 472;
	468 [label="И? ",shape=box,color=red];
		468 -> 473;
	469 [label="Мари видит в каждой душе самое лучшее. Это умение она выработала и довела его до совершенства и отполировала как щит от всего, что её окружает.",shape=box,color=blue];
		469 -> 474;
		469 -> 475;
	466 [label="+5 Chemistry",color=orange];
		466 -> 471;
	470 [label="Check boolean RoatheSerum1",color=orange];
		470 -> 476 [label=true,color=green];
		470 -> 477 [label=true,color=green];
		470 -> 476 [label=false,color=brown];
		470 -> 478 [label=false,color=brown];
	472 [label="И что бы ты сказал об этом утверждении, если бы оно было правдой, Скиталец?",shape=box,color=blue];
		472 -> 480;
	473 [label="«И» ничего. Я рассказал тебе о том, как я был свидетелем этого события, как об истинном моём переживании этого события. Больше ничего.",shape=box,color=blue];
		473 -> 469;
	474 [label="Мари не располагает всеми фактами о том, на что на самом деле способен Энтрати, и обо всех ужасных вещах, которые он совершил во имя «прогресса», а теперь и «искупления».",shape=box,color=red];
		474 -> 481;
	475 [label="Мари взрослая женщина. И хотя я ценю твоё стремление защищать её, она может сама решать, во что ей верить и в кого верить.",shape=box,color=red];
		475 -> 482;
	471 [label="Оскверняющие наши тела, разрушающие наше будущее, искажающие наше прошлое - всё это, возможно, я мог бы простить.",shape=box,color=blue];
		471 -> 479;
	476 [label="У Энтрати, возможно, не самые лучшие манеры, но он пытается спасти вселенную.",shape=box,color=red];
		476 -> 471;
	477 [label="Он заставил тебя стать протофреймом, как Роут?",shape=box,color=red];
		477 -> 483;
