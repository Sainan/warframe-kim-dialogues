		541 -> 548;
	542 [label="Я справлюсь самостоятельно. Обещаю, я не позволю ему влезть мне в голову.",shape=box,color=red];
		542 -> 549;
	543 [label="Похоже, ты говоришь из личного опыта. Какие ответы он дал тебе?",shape=box,color=red];
