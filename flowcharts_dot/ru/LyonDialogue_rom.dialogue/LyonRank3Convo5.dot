		480 -> 487 [label=false,color=brown];
		480 -> 488 [label=false,color=brown];
	481 [label="Доверие подобно витражу. Хрупкое в своём создании. Прекрасное в своём великолепии. Трагичное в момент разрушения. И опасное, когда оно разбито.",shape=box,color=blue];
		481 -> 496;
	482 [label="Доверие подобно витражу. Хрупкое в своём создании. Прекрасное в своём великолепии. Трагичное в момент разрушения. И опасное, когда оно разбито.",shape=box,color=blue];
		482 -> 491;
	479 [label="Но видеть, как он перекроил Мари... как использовал её светлую веру в других ради своих собственных целей?",shape=box,color=blue];
		479 -> 485;
	483 [label="Нет. У меня свои были причины принять эликсир. Я знал, в какое исковерканное существо он меня превратит. Как знала и Мари.",shape=box,color=blue];
		483 -> 492;
	484 [label="+5 Chemistry",color=orange];
		484 -> 471;
	486 [label="Наверное, мне в целом всё равно?",shape=box,color=red];
		486 -> 493;
	488 [label="Мой единственный вопрос в том, если ты действительно что-то видишь, беспокоят ли тебя эти видения?",shape=box,color=red];
		488 -> 495;
	489 [label="После того, что ты сказал на днях - меня заставило задуматься, всё ли у тебя в порядке, вот и всё.",shape=box,color=red];
		489 -> 494;
	487 [label="Я просто хочу понять, всё ли у тебя в порядке, вот и всё.",shape=box,color=red];
		487 -> 494;
	496 [label="+15 Chemistry",color=orange];
		496 -> 502;
	491 [label="В тёплом свете Сола она греется его сиянием, не замечая изъянов, что проступают на его поверхности. Не слыша, как трещины становятся глубже.",shape=box,color=blue];
		491 -> 497;
	485 [label="Этого я никогда не прощу. За это я желаю выбить покаяние из его плоти своим кадилом, пока он не станет умолять о спасении.",shape=box,color=blue];
		485 -> 474;
		485 -> 475;
	492 [label="Мы не были... сломлены насильно, как тот дьявол. И часть моего сердца сочувствует Роуту за всё, что ему пришлось пережить.",shape=box,color=blue];
		492 -> 498;
	493 [label="Тогда я не вижу смысла продолжать этот разговор.",shape=box,color=blue];
		493 -> 499;
	495 [label="Я буду предельно откровенен, я не знаю, как ответить на это, Скиталец.",shape=box,color=blue];
		495 -> 501;
	494 [label="Update boolean LyonAllRight",color=orange];
		494 -> 500;
	502 [label="Если бы я только мог вырвать из неё ту скверну, что он вложил в её разуме. Я лишь могу молить о том, чтобы тебе удалось то, чего не смог добиться я.",shape=box,color=blue];
		502 -> 507;
	497 [label="Не подозревая о том, что осколки её собственного шедевра вскоре будут обращены против неё. Предпочитая закрывать глаза на то, что неизбежно последует.",shape=box,color=blue];
		497 -> 503;
	498 [label="Затем он открывает рот, чтобы заговорить.",shape=box,color=blue];
		498 -> 504;
		498 -> 505;
	499 [label="Chat ends.",color=orange];
	501 [label="За все мои годы я видел ужасы, от которых других бы давно отправили в психушки. Что ещё более трагично, время от времени мои видения действительно сбывались.",shape=box,color=blue];
		501 -> 506;
	500 [label="«Всё ли у меня в порядке»? Я буду предельно откровенен, я не знаю, как ответить на это, Скиталец.",shape=box,color=blue];
		500 -> 501;
	507 [label="-О. Лион Аллард",shape=box,color=blue];
		507 -> 513;
	503 [label="Если бы только я мог принять эти страдания вместо неё, с какой радостью я бы вытатуировал это в своей душе. Но это предназначено ей, и только ей.",shape=box,color=blue];
		503 -> 508;
	504 [label="Нужно помнить, каким было его воспитание. В каком мире ему приходилось учиться жить. Он был - есть - Орокин.",shape=box,color=red];
		504 -> 509;
		504 -> 510;
	505 [label="Честно говоря, я не думаю, что он такой уж ужасный. Он постепенно начинает мне нравиться.",shape=box,color=red];
