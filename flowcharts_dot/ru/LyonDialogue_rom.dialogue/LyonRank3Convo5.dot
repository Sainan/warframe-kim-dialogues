	536 [label="-О. Лион Аллард",shape=box,color=blue];
		536 -> 541;
	537 [label="Он подстерегает нас в моменты нашей наибольшей неосмотрительности - когда мы уязвимы. Когда мы слабы. Когда мы отчаянно нуждаемся в ответах.",shape=box,color=blue];
		537 -> 542;
		537 -> 543;
	538 [label="Хорошо. Постарайся не позволять этому случиться. Мне бы очень не хотелось вдалбливать в тебя хоть немного здравого смысла. Похоже, ты из тех, кто открывает ответный огонь.",shape=box,color=blue];
		538 -> 544;
	539 [label="Мне просто тяжело обсуждать подобные вещи с тем, которого я едва знаю, лишь затем, чтобы никогда больше не подошел ко мне. Я бы предпочёл избежать подобного, особенно сейчас, когда мы, кажется, вынуждены работать вместе, по крайней мере, в ближайшее время.",shape=box,color=blue];
		539 -> 545;
