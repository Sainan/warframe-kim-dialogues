	1289 [label="[Конец.]",shape=box,color=red];
		1289 -> 1292;
	1290 [label="+5 Chemistry",color=orange];
		1290 -> 1293;
	1291 [label="И хотя я это ценю, мне всё же кажется, что ты имеешь право услышать от меня объяснение. Я постараюсь быть кратким и не перегружать себя ненужной эрудицией.",shape=box,color=blue];
		1291 -> 1294;
	1292 [label="Chat ends.",color=orange];
	1293 [label="Спасибо. Постараюсь быть кратким и не перегружать себя излишней эрудицией.",shape=box,color=blue];
		1293 -> 1294;
	1294 [label="Беседы даются мне тяжело. Гораздо тяжелее в близком, личном общении, чем в подобных безличных, механических разговорах или переписке.",shape=box,color=blue];
		1294 -> 1295;
	1295 [label="Я не знаю, как это описать, но это так... как будто я хватаюсь за что-то, но вижу, как пылинки выскальзывают сквозь мои пальцы. ",shape=box,color=blue];
		1295 -> 1296;
	1296 [label="Часто это ощущается так, будто я - пустой клочок холста, по которому я размазываю масляные краски, тщетно пытаясь создать тень образа, который вижу внутренним взором.",shape=box,color=blue];
		1296 -> 1297;
	1297 [label="Но чем больше я тружусь, тем более безнадёжной становится попытка.",shape=box,color=blue];
		1297 -> 1298;
	1298 [label="Чем больше я пытаюсь, тем сложнее мне это удаётся. Поэтому я просто научился... вообще не предпринимать никаких попыток.",shape=box,color=blue];
		1298 -> 1299;
	1299 [label="Вот почему я изначально избегал тебя. И почему по сей день… склонен к приступам уединения. Слова ускользают от меня.",shape=box,color=blue];
		1299 -> 1300;
		1299 -> 1301;
		1299 -> 1302;
	1300 [label="Мне всегда будет приятно, если ты просто будешь рядом со мной в тишине.",shape=box,color=red];
		1300 -> 1303;
	1301 [label="Я иногда так же себя веду. Ничего страшного.",shape=box,color=red];
		1301 -> 1304;
	1302 [label="Извинения приняты.",shape=box,color=red];
		1302 -> 1305;
	1303 [label="+15 Chemistry",color=orange];
		1303 -> 1306;
	1304 [label="+15 Chemistry",color=orange];
		1304 -> 1307;
	1305 [label="+10 Chemistry",color=orange];
		1305 -> 1308;
	1306 [label="Я... запомню. Спасибо, Скиталец.",shape=box,color=blue];
		1306 -> 1309;
	1307 [label="Я не осознавал этого. Запомню, что не стоит думать, будто я так одинок в этом мире... Спасибо, Скиталец.",shape=box,color=blue];
		1307 -> 1309;
