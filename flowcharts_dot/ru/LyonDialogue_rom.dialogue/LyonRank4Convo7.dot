digraph {
	1285 [label="LyonRank4Convo7 begins.",color=orange];
		1285 -> 1286;
	1286 [label="Скиталец? Могу ли я извиниться перед тобой за кое-что?",shape=box,color=blue];
		1286 -> 1287;
		1286 -> 1288;
		1286 -> 1289;
	1287 [label="Конечно? За что?",shape=box,color=red];
