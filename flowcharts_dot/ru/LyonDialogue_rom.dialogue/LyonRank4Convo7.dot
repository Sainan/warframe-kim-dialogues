digraph {
	"LyonRank4Convo7 begins." [color=orange];
		"LyonRank4Convo7 begins." -> j3277157038;
	j3277157038 [label="Скиталец? Могу ли я извиниться перед тобой за кое-что?",shape=box,color=blue];
		j3277157038 -> j18029932;
		j3277157038 -> j2284265753;
		j3277157038 -> j1310452999;
	j18029932 [label="Конечно? За что?",shape=box,color=red];
		j18029932 -> j131652044;
	j2284265753 [label="Не нужно, Лион. Ты ничего не сделал плохого.",shape=box,color=red];
		j2284265753 -> j2925625717;
	j1310452999 [label="[Конец.]",shape=box,color=red];
		j1310452999 -> "Chat ends.";
	j131652044 [label="+5 Chemistry",color=orange];
		j131652044 -> j1875722883;
	j2925625717 [label="И хотя я это ценю, мне всё же кажется, что ты имеешь право услышать от меня объяснение. Я постараюсь быть кратким и не перегружать себя ненужной эрудицией.",shape=box,color=blue];
		j2925625717 -> j1681096841;
	"Chat ends." [color=orange];
	j1875722883 [label="Спасибо. Постараюсь быть кратким и не перегружать себя излишней эрудицией.",shape=box,color=blue];
		j1875722883 -> j1681096841;
	j1681096841 [label="Беседы даются мне тяжело. Гораздо тяжелее в близком, личном общении, чем в подобных безличных, механических разговорах или переписке.",shape=box,color=blue];
		j1681096841 -> j112166571;
	j112166571 [label="Я не знаю, как это описать, но это так... как будто я хватаюсь за что-то, но вижу, как пылинки выскальзывают сквозь мои пальцы. ",shape=box,color=blue];
		j112166571 -> j3030086651;
	j3030086651 [label="Часто это ощущается так, будто я - пустой клочок холста, по которому я размазываю масляные краски, тщетно пытаясь создать тень образа, который вижу внутренним взором.",shape=box,color=blue];
		j3030086651 -> j514073822;
	j514073822 [label="Но чем больше я тружусь, тем более безнадёжной становится попытка.",shape=box,color=blue];
		j514073822 -> j2498701343;
	j2498701343 [label="Чем больше я пытаюсь, тем сложнее мне это удаётся. Поэтому я просто научился... вообще не предпринимать никаких попыток.",shape=box,color=blue];
		j2498701343 -> j1317492521;
	j1317492521 [label="Вот почему я изначально избегал тебя. И почему по сей день… склонен к приступам уединения. Слова ускользают от меня.",shape=box,color=blue];
		j1317492521 -> j446713178;
		j1317492521 -> j2038167405;
		j1317492521 -> j3161259319;
	j446713178 [label="Мне всегда будет приятно, если ты просто будешь рядом со мной в тишине.",shape=box,color=red];
		j446713178 -> j4198941030;
	j2038167405 [label="Я иногда так же себя веду. Ничего страшного.",shape=box,color=red];
		j2038167405 -> j1478668275;
	j3161259319 [label="Извинения приняты.",shape=box,color=red];
		j3161259319 -> j1981870540;
	j4198941030 [label="+15 Chemistry",color=orange];
		j4198941030 -> j80952443;
	j1478668275 [label="+15 Chemistry",color=orange];
		j1478668275 -> j1387646990;
	j1981870540 [label="+10 Chemistry",color=orange];
		j1981870540 -> j2677002636;
	j80952443 [label="Я... запомню. Спасибо, Скиталец.",shape=box,color=blue];
		j80952443 -> j1542260442;
	j1387646990 [label="Я не осознавал этого. Запомню, что не стоит думать, будто я так одинок в этом мире... Спасибо, Скиталец.",shape=box,color=blue];
		j1387646990 -> j1542260442;
	j2677002636 [label="Конечно. Спасибо, Скиталец.",shape=box,color=blue];
		j2677002636 -> j1542260442;
	j1542260442 [label="-Ф. Лион Аллард",shape=box,color=blue];
		j1542260442 -> "Chat ends.";
}