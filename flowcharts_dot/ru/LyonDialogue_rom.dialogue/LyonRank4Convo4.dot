	990 [label="+5 Chemistry",color=orange];
		990 -> 996;
	986 [label="Я не всегда знаю, как правильно реагировать в ситуациях, когда проявляется простое любопытство к чьей‑то истории или даже безобидные проявления дружбы.",shape=box,color=blue];
		986 -> 992;
	993 [label="+5 Chemistry",color=orange];
