		980 -> 983;
	984 [label="Я бы просто подумал, что есть более подходящие способы тратить свои силы. Например, защищать какой‑нибудь бастион от наступающего отряда врага, открывать неизвестные знания… или сортировать одежду.",shape=box,color=blue];
