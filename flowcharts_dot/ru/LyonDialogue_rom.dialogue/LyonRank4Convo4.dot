		j2497026849 -> j2698061538 [label="false",color=purple];
	j367054140 [label="+20 Chemistry",color=orange];
		j367054140 -> "Chat ends.";
	j107652854 [label="Боюсь, это не из самых приятных историй для рассказа. Я уже рассказывал тебе о видениях, которые привели меня в Собор поклоняться Светилам, и о бабушке и дедушке, которые встретились во времена Галлиикской революции. Ты точно хочешь потратить своё время на такие вещи?",shape=box,color=blue];
		j107652854 -> j2694531421;
		j107652854 -> j294454065;
		j107652854 -> j1036542134;
	j1760587774 [label="Боюсь, это не из самых приятных историй для рассказа. Я уже говорил тебе о видениях, которые привели меня в Собор поклоняться Светилам. Ты точно хочешь потратить своё время на такие вещи?",shape=box,color=blue];
		j1760587774 -> j2694531421;
