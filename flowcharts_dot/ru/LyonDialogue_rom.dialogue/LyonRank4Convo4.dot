		995 -> 999;
	996 [label="Я… должен признаться, что выбор твоих слов заставляет меня испытывать тревогу. Хотя я не знаю, имеешь ли ты в виду их так, как я их понимаю.",shape=box,color=blue];
		996 -> 1000;
