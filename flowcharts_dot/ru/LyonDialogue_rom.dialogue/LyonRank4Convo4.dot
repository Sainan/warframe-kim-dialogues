		1043 -> 1046 [label=true,color=green];
		1043 -> 1045 [label=false,color=brown];
		1043 -> 1046 [label=false,color=brown];
	1044 [label="Моя мать уже давно умерла, когда мы уехали сюда. А теперь она, лишь пыль. Она прожила жизнь, полную страданий… и была обречена распространять эти страдания.",shape=box,color=blue];
		1044 -> 1047;
	1046 [label="Причинить боль ребенку... Это непростительно.",shape=box,color=red];
		1046 -> 1042;
	1045 [label="Вот почему ты...?",shape=box,color=red];
		1045 -> 1048;
	1047 [label="Она была напугана. Что бы меня ни беспокоило, будь то бремя богов, безумие или проклятие, она была не в состоянии с этим справиться.",shape=box,color=blue];
		1047 -> 1049;
	1048 [label="Check boolean LyonLecture2",color=orange];
		1048 -> 1050 [label=true,color=green];
		1048 -> 1051 [label=false,color=brown];
	1049 [label="Тем не менее, насколько бы жестокой ни была моя мать, мой отец был ещё хуже. Я избавлю тебя от подробностей.",shape=box,color=blue];
		1049 -> 1052;
	1050 [label="Возможно. Я часто задавался вопросом, не была ли это частью принуждения. Но, как я уже говорил тебе ранее, это также метод Луа.",shape=box,color=blue];
		1050 -> 1053;
	1051 [label="Возможно. Я часто задавался вопросом, не была ли это частью принуждения. Но это метод Луа, Светил. Я не один в их практике.",shape=box,color=blue];
		1051 -> 1054;
	1052 [label="Когда я подрос, видения сменились голосами. Шёпотом, который приходил ко мне в любое время. Наяву и во сне. Из‑за этого страдала моя работа на ферме, и я страдал в ответ.",shape=box,color=blue];
		1052 -> 1055;
		1052 -> 1056;
	1053 [label="+5 Chemistry",color=orange];
		1053 -> 2233;
	1054 [label="+5 Chemistry",color=orange];
		1054 -> 1058;
	1055 [label="Что побудило тебя пойти в церковь?",shape=box,color=red];
		1055 -> 1059;
	1056 [label="Некоторые люди не заслуживают быть родителями.",shape=box,color=red];
		1056 -> 1060;
	2233 [label="Я настаиваю на том, что это приносит мне хоть каплю покоя, хотя я знаю, что тебе всё ещё должно казаться странным, что это так.",shape=box,color=blue];
		2233 -> 1049;
	1058 [label="Этому меня научил один из других Отцов в Соборе, чтобы помочь… очищать разум. Те, кого выбирает Луа, часто “благословляются” “видениями”.",shape=box,color=blue];
		1058 -> 1061;
	1059 [label="Check boolean LyonPainOff",color=orange];
		1059 -> 1063 [label=true,color=green];
		1059 -> 1062 [label=false,color=brown];
	1060 [label="Я ценю это выражение сочувствия, но не могу недооценивать и то, насколько трудным ребёнком я был для них, особенно когда стал выше и сильнее их.",shape=box,color=blue];
		1060 -> 1059;
	1061 [label="Update boolean LyonLecture2",color=orange];
		1061 -> 1049;
	1063 [label="Мои видения и голоса часто приводили меня в жестокие припадки, Скиталец. Самоистязание нередко было единственным способом вывести себя из того, что я видел.",shape=box,color=blue];
		1063 -> 1064;
	1062 [label="Мои видения и голоса часто приводили меня в жестокие припадки, Скиталец. Я нередко брал нож, чтобы себя, потому что боль была единственным, что могло вывести меня из этого состояния.",shape=box,color=blue];
		1062 -> 1064;
	1064 [label="Но это было тогда, когда голоса приказали мне",shape=box,color=blue];
		1064 -> 1065;
	1065 [label="Я… я не могу. Я просто не могу. Прости. У меня дрожат руки, пока я это пишу. Мне нужно остановиться. Пока что.",shape=box,color=blue];
		1065 -> 1066;
		1065 -> 1067;
	1066 [label="Конечно. Всё в порядке. Некуда спешить. Я здесь, как только будешь готов.",shape=box,color=red];
		1066 -> 1068;
	1067 [label="Я понимаю, всего этого уже более чем достаточно. Отдохни, хорошо? И… спасибо. Это много для меня значит.",shape=box,color=red];
		1067 -> 1069;
