		973 -> 975;
	979 [label="Боюсь, это не из самых приятных историй для рассказа. Я уже рассказывал тебе о видениях, которые привели меня в Собор поклоняться Светилам, и о бабушке и дедушке, которые встретились во времена Галлиикской революции. Ты точно хочешь потратить своё время на такие вещи?",shape=box,color=blue];
