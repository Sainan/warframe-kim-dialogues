	1032 [label="Да, Скиталец. Видения меня напугали.",shape=box,color=blue];
		1032 -> 1031;
	1033 [label="Что она сделала?",shape=box,color=red];
		1033 -> 1035;
	1034 [label="Думала ли она, что это совпадение или знак?",shape=box,color=red];
		1034 -> 1036;
	1035 [label="Она била меня прутом, пока я не терял силы стоять. Моя спина кровоточила до тех пор, пока меня не заставляли спать лицом вниз. Я до сих пор помню её крики, когда она наносила удары: «Diable! Sorcier!»",shape=box,color=blue];
		1035 -> 1037;
		1035 -> 1038;
		1035 -> 1039;
		1035 -> 1040;
	1036 [label="Не знаю. Знаю только что она била меня прутом, пока я не терял силы стоять. Моя спина кровоточила до тех пор, пока меня не заставляли спать лицом вниз. Я до сих пор помню её крики, когда она наносила удары: «Diable! Sorcier!»",shape=box,color=blue];
		1036 -> 1037;
