		j2698061538 -> j1036542134;
	"Chat ends." [color=orange];
	j2694531421 [label="Почему ты считаешь, что это пустая трата времени?",shape=box,color=red];
		j2694531421 -> j3274878157;
	j294454065 [label="Для меня это не пустая трата времени, Лион. Мне бы очень хотелось узнать тебя получше.",shape=box,color=red];
		j294454065 -> j1584197471;
	j1036542134 [label="Тогда не важно. Если ты предпочитаешь не говорить.",shape=box,color=red];
		j1036542134 -> j3327403513;
	j3274878157 [label="Я бы просто подумал, что есть более подходящие способы тратить свои силы. Например, защищать какой‑нибудь бастион от наступающего отряда врага, открывать неизвестные знания… или сортировать одежду.",shape=box,color=blue];
		j3274878157 -> j2074201886;
		j3274878157 -> j3311043678;
	j1584197471 [label="Evaluate expressions",color=orange];
		j1584197471 -> j1849193476 [label="LyonFirstFlirt",color=purple];
		j1584197471 -> j863755946 [label="LyonFlirtIgnored",color=purple];
		j1584197471 -> j4069346622 [label="false",color=purple];
	j3327403513 [label="Нет, прости. Я… прошу прощения за то, как плохо справляюсь со всем этим.",shape=box,color=blue];
		j3327403513 -> j2075495504;
	j2074201886 [label="Лион, если хочешь, чтобы меня не было рядом, скажи прямо.",shape=box,color=red];
		j2074201886 -> j3563784876;
	j3311043678 [label="Ты вовсе не делаешь это проще. ",shape=box,color=red];
		j3311043678 -> j3327403513;
	j1849193476 [label="+5 Chemistry",color=orange];
		j1849193476 -> j677676069;
	j863755946 [label="У тебя есть путь? Или, может быть, твои нервы просто более измотаны, чем мои?",shape=box,color=blue];
		j863755946 -> j32242260;
		j863755946 -> j3279682022;
	j4069346622 [label="+5 Chemistry",color=orange];
		j4069346622 -> j155980454;
	j2075495504 [label="Я не всегда знаю, как правильно реагировать в ситуациях, когда проявляется простое любопытство к чьей‑то истории или даже безобидные проявления дружбы.",shape=box,color=blue];
		j2075495504 -> j3036568328;
	j3563784876 [label="+5 Chemistry",color=orange];
		j3563784876 -> j3327403513;
	j677676069 [label="Да, и именно это… чувство заставляет меня всё больше тревожиться. Ради моего спокойствия просто подтверди, что ты имеешь в виду то, чего я всё сильнее опасаюсь.",shape=box,color=blue];
		j677676069 -> j172694058;
		j677676069 -> j4212034478;
	j32242260 [label="Прости, что игнорировал раньше...",shape=box,color=red];
		j32242260 -> j726023275;
	j3279682022 [label="Ты о чём...?",shape=box,color=red];
		j3279682022 -> j726023275;
	j155980454 [label="Я… должен признаться, что выбор твоих слов заставляет меня испытывать тревогу. Хотя я не знаю, имеешь ли ты в виду их так, как я их понимаю.",shape=box,color=blue];
		j155980454 -> j172694058;
		j155980454 -> j4212034478;
	j3036568328 [label="Тем не менее, тебе было интересно узнать о моём прошлом, да?",shape=box,color=blue];
		j3036568328 -> j2212448163;
	j172694058 [label="Тогда позволь мне тебя успокоить - у меня нет к тебе чувств.",shape=box,color=red];
		j172694058 -> j732824058;
	j4212034478 [label="Неужели так трудно поверить, что у меня могут быть к тебе чувства, Лион?",shape=box,color=red];
		j4212034478 -> j2803790827;
	j726023275 [label="Ты бросил это дело с таким же рвением, как и начал. Я предположил, что это было правильное решение, что его продолжение было бы ошибкой.",shape=box,color=blue];
		j726023275 -> j2577999713;
		j726023275 -> j1502197043;
	j2212448163 [label="Наверное, тебе уже известно, что я вижу… видения. Это было частью моей жизни с самого детства.",shape=box,color=blue];
		j2212448163 -> j442334973;
	j732824058 [label="Я не хотел никого оттолкнуть, но приятно знать, как обстоят дела. Я... прошу прощения за то, как плохо я со всем этим справляюсь.",shape=box,color=blue];
		j732824058 -> j2075495504;
	j2803790827 [label="Boolean DrifterLyon is now true.",color=orange];
		j2803790827 -> j3690034570;
	j2577999713 [label="Ты прав, это всё ошибка.",shape=box,color=red];
		j2577999713 -> j1182168295;
	j1502197043 [label="Просто было трудно понять, были ли мои шаги желанны. ",shape=box,color=red];
		j1502197043 -> j3491267110;
	j442334973 [label="Эти видения редко были приятными, мягко говоря.",shape=box,color=blue];
		j442334973 -> j2945784874;
		j442334973 -> j4160093181;
		j442334973 -> j753388177;
	j3690034570 [label="Проще говоря? Ну да. Я… не хочу отвергать твои усилия. Я просто… не привык… к проявлениям привязанности, Скиталец. Любого рода.",shape=box,color=blue];
		j3690034570 -> j2418003201;
	j1182168295 [label="Я так и думал. Тогда просто желаю тебе хорошего остатка дня.",shape=box,color=blue];
		j1182168295 -> "Chat ends.";
	j3491267110 [label="+5 Chemistry",color=orange];
		j3491267110 -> j3165131926;
	j2945784874 [label="И ты думаешь, что эти видения исходят от Луа?",shape=box,color=red];
		j2945784874 -> j221148788;
	j4160093181 [label="Что они включали в себя?",shape=box,color=red];
		j4160093181 -> j221148788;
	j753388177 [label="Они напугали тебя?",shape=box,color=red];
		j753388177 -> j2599758697;
	j2418003201 [label="Если ты желаешь идти по этому пути, я не стану тебя останавливать, и я… нахожу это столь же непривычным и… чуждым для себя?",shape=box,color=blue];
		j2418003201 -> j970726004;
	j3165131926 [label="Они не… нежеланны, per se? Просто они… озадачивают, учитывая, что вообще существуют.",shape=box,color=blue];
		j3165131926 -> j4256506942;
		j3165131926 -> j4212034478;
	j221148788 [label="Однажды я проснулся посреди ночи и увидел старую женщину, сидящую у изножья моей кровати.",shape=box,color=blue];
		j221148788 -> j1991075365;
	j2599758697 [label="Однажды я проснулся посреди ночи и увидел старую женщину, сидящую у изножья моей кровати.",shape=box,color=blue];
		j2599758697 -> j3536724296;
	j970726004 [label="+5 Chemistry",color=orange];
		j970726004 -> j1223134531;
	j4256506942 [label="Мне остановиться?",shape=box,color=red];
		j4256506942 -> j3584360341;
	j1991075365 [label="Она была настолько худой и хрупкой, что, возможно, уже давно умерла и была похоронена; ее кожа так плотно облегала ее кости, что я видел промежутки между ними.",shape=box,color=blue];
		j1991075365 -> j3413677425;
	j3536724296 [label="Она была настолько худой и хрупкой, что, возможно, уже давно умерла и была похоронена; ее кожа так плотно облегала ее кости, что я видел промежутки между ними.",shape=box,color=blue];
		j3536724296 -> j3770268786;
	j1223134531 [label="Я… возможно, осторожно надеюсь увидеть, куда приведёт этот новый путь. Однако, тебе было интересно узнать о моём прошлом, да?",shape=box,color=blue];
		j1223134531 -> j2455730669;
	j3584360341 [label="Нет. Я… не хочу отвергать твои усилия. Я просто… не привык… к проявлениям привязанности, Скиталец. Любого рода.",shape=box,color=blue];
		j3584360341 -> j2418003201;
	j3413677425 [label="Её волосы были едва длиннее нескольких седых прядей, безжизненно свисавших с головы. Но больше всего мне запомнились её глаза. ",shape=box,color=blue];
		j3413677425 -> j2621771102;
	j3770268786 [label="Её волосы были едва длиннее нескольких седых прядей, безжизненно свисавших с головы. Но больше всего мне запомнились её глаза. ",shape=box,color=blue];
		j3770268786 -> j928406487;
	j2455730669 [label="Boolean LyonFlirt2 is now true.",color=orange];
		j2455730669 -> j2212448163;
	j2621771102 [label="Ибо у неё их вовсе не было.",shape=box,color=blue];
		j2621771102 -> j1909695230;
	j928406487 [label="Ибо у неё их вовсе не было.",shape=box,color=blue];
		j928406487 -> j1465568387;
	j1909695230 [label="Три месяца спустя в деревне была найдена мёртвая женщина в своём доме. Её глаза были изъедены крысами.",shape=box,color=blue];
		j1909695230 -> j594346079;
	j1465568387 [label="Три месяца спустя в деревне была найдена мёртвая женщина в своём доме. Её глаза были изъедены крысами.",shape=box,color=blue];
		j1465568387 -> j2168514957;
	j594346079 [label="Я рассказал матери о том, что видел в ту ночь, когда видение разбудило меня. Она, как и я сам, помнила то, что я видел.",shape=box,color=blue];
		j594346079 -> j553856853;
		j594346079 -> j2627275083;
	j2168514957 [label="Да, Скиталец. Видения меня напугали.",shape=box,color=blue];
		j2168514957 -> j594346079;
	j553856853 [label="Что она сделала?",shape=box,color=red];
		j553856853 -> j212520337;
	j2627275083 [label="Думала ли она, что это совпадение или знак?",shape=box,color=red];
		j2627275083 -> j1300026035;
	j212520337 [label="Она била меня прутом, пока я не терял силы стоять. Моя спина кровоточила до тех пор, пока меня не заставляли спать лицом вниз. Я до сих пор помню её крики, когда она наносила удары: «Diable! Sorcier!»",shape=box,color=blue];
		j212520337 -> j106146298;
		j212520337 -> j4238870160;
		j212520337 -> j97746720;
		j212520337 -> j4116244195;
	j1300026035 [label="Не знаю. Знаю только что она била меня прутом, пока я не терял силы стоять. Моя спина кровоточила до тех пор, пока меня не заставляли спать лицом вниз. Я до сих пор помню её крики, когда она наносила удары: «Diable! Sorcier!»",shape=box,color=blue];
		j1300026035 -> j106146298;
		j1300026035 -> j4238870160;
		j1300026035 -> j97746720;
		j1300026035 -> j4116244195;
	j106146298 [label="Сколько тебе было лет?",shape=box,color=red];
		j106146298 -> j700845540;
	j4238870160 [label="Ох, Лион... Мне так, так жаль...",shape=box,color=red];
		j4238870160 -> j3725111933;
	j97746720 [label="Это ужасно...",shape=box,color=red];
		j97746720 -> j3725111933;
	j4116244195 [label="Она была невежественна. Она не знала лучше.",shape=box,color=red];
		j4116244195 -> j3725111933;
	j700845540 [label="Четыре, наверное. Шесть, самое большее. Не знаю. Мы не считали свои годы с таким рвением, как ты сейчас.",shape=box,color=blue];
		j700845540 -> j2698478763;
	j3725111933 [label="+5 Chemistry",color=orange];
		j3725111933 -> j2499101517;
	j2698478763 [label="Check boolean LyonPainOff",color=orange];
		j2698478763 -> j3777475565 [label=true,color=green];
		j2698478763 -> j3117432680 [label=false,color=brown];
		j2698478763 -> j3777475565 [label=false,color=brown];
	j2499101517 [label="Моя мать уже давно умерла, когда мы уехали сюда. А теперь она, лишь пыль. Она прожила жизнь, полную страданий… и была обречена распространять эти страдания.",shape=box,color=blue];
		j2499101517 -> j3935241837;
	j3777475565 [label="Причинить боль ребенку... Это непростительно.",shape=box,color=red];
		j3777475565 -> j3725111933;
	j3117432680 [label="Вот почему ты...?",shape=box,color=red];
		j3117432680 -> j2933368378;
	j3935241837 [label="Она была напугана. Что бы меня ни беспокоило, будь то бремя богов, безумие или проклятие, она была не в состоянии с этим справиться.",shape=box,color=blue];
		j3935241837 -> j2482543608;
	j2933368378 [label="Check boolean LyonLecture2",color=orange];
		j2933368378 -> j3167055066 [label=true,color=green];
		j2933368378 -> j2033127235 [label=false,color=brown];
	j2482543608 [label="Тем не менее, насколько бы жестокой ни была моя мать, мой отец был ещё хуже. Я избавлю тебя от подробностей.",shape=box,color=blue];
		j2482543608 -> j3148536177;
	j3167055066 [label="Возможно. Я часто задавался вопросом, не была ли это частью принуждения. Но, как я уже говорил тебе ранее, это также метод Луа.",shape=box,color=blue];
		j3167055066 -> j2679121487;
	j2033127235 [label="Возможно. Я часто задавался вопросом, не была ли это частью принуждения. Но это метод Луа, Светил. Я не один в их практике.",shape=box,color=blue];
		j2033127235 -> j1609795217;
	j3148536177 [label="Когда я подрос, видения сменились голосами. Шёпотом, который приходил ко мне в любое время. Наяву и во сне. Из‑за этого страдала моя работа на ферме, и я страдал в ответ.",shape=box,color=blue];
		j3148536177 -> j2921695067;
		j3148536177 -> j2872116799;
	j2679121487 [label="+5 Chemistry",color=orange];
		j2679121487 -> j2728600202;
	j1609795217 [label="+5 Chemistry",color=orange];
		j1609795217 -> j2140947616;
	j2921695067 [label="Что побудило тебя пойти в церковь?",shape=box,color=red];
		j2921695067 -> j4013567020;
	j2872116799 [label="Некоторые люди не заслуживают быть родителями.",shape=box,color=red];
		j2872116799 -> j2335820167;
	j2728600202 [label="Я настаиваю на том, что это приносит мне хоть каплю покоя, хотя я знаю, что тебе всё ещё должно казаться странным, что это так.",shape=box,color=blue];
		j2728600202 -> j2482543608;
	j2140947616 [label="Этому меня научил один из других Отцов в Соборе, чтобы помочь… очищать разум. Те, кого выбирает Луа, часто “благословляются” “видениями”.",shape=box,color=blue];
		j2140947616 -> j3315190309;
	j4013567020 [label="Check boolean LyonPainOff",color=orange];
		j4013567020 -> j891700674 [label=true,color=green];
		j4013567020 -> j1204977649 [label=false,color=brown];
	j2335820167 [label="Я ценю это выражение сочувствия, но не могу недооценивать и то, насколько трудным ребёнком я был для них, особенно когда стал выше и сильнее их.",shape=box,color=blue];
		j2335820167 -> j4013567020;
	j3315190309 [label="Boolean LyonLecture2 is now true.",color=orange];
		j3315190309 -> j2482543608;
	j891700674 [label="Мои видения и голоса часто приводили меня в жестокие припадки, Скиталец. Самоистязание нередко было единственным способом вывести себя из того, что я видел.",shape=box,color=blue];
		j891700674 -> j2692495547;
	j1204977649 [label="Мои видения и голоса часто приводили меня в жестокие припадки, Скиталец. Я нередко брал нож, чтобы себя, потому что боль была единственным, что могло вывести меня из этого состояния.",shape=box,color=blue];
		j1204977649 -> j2692495547;
	j2692495547 [label="Но это было тогда, когда голоса приказали мне",shape=box,color=blue];
		j2692495547 -> j4257432992;
	j4257432992 [label="Я… я не могу. Я просто не могу. Прости. У меня дрожат руки, пока я это пишу. Мне нужно остановиться. Пока что.",shape=box,color=blue];
		j4257432992 -> j3467266921;
		j4257432992 -> j1225163137;
	j3467266921 [label="Конечно. Всё в порядке. Некуда спешить. Я здесь, как только будешь готов.",shape=box,color=red];
		j3467266921 -> j4002858504;
	j1225163137 [label="Я понимаю, всего этого уже более чем достаточно. Отдохни, хорошо? И… спасибо. Это много для меня значит.",shape=box,color=red];
		j1225163137 -> j467802377;
	j4002858504 [label="+10 Chemistry",color=orange];
		j4002858504 -> j3488598470;
