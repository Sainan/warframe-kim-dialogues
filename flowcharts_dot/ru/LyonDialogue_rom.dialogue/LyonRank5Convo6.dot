digraph {
	"LyonRank5Convo6 begins." [color=orange];
		"LyonRank5Convo6 begins." -> j3203510524;
	j3203510524 [label="Evaluate expressions",color=orange];
		j3203510524 -> j3423938048 [label="LoidFamilyComplete",color=purple];
		j3203510524 -> j350838049 [label="MarieEntratiCompleteA",color=purple];
		j3203510524 -> j3630282149 [label="MarieEntratiCompleteB",color=purple];
		j3203510524 -> j3248041138 [label="MarieEntratiCompleteC",color=purple];
		j3203510524 -> "Chat ends." [label="false",color=purple];
	j3423938048 [label="Скиталец. Можно тебя попросить?",shape=box,color=blue];
		j3423938048 -> j3572677649;
		j3423938048 -> j1310452999;
	j350838049 [label="Могу ли я воспользоваться моментом, чтобы похвалить тебя за то, что, как мне казалось, раньше было невозможно сделать иным способом?",shape=box,color=blue];
		j350838049 -> j4143565687;
		j350838049 -> j2284627778;
		j350838049 -> j1310452999;
	j3630282149 [label="Я должен направить тебе свои соболезнования по поводу твоих благородных, но трагически недолговечных попыток, когда дело касается Мари и вопроса о «le Cardinal».",shape=box,color=blue];
		j3630282149 -> j2284627778;
		j3630282149 -> j4143565687;
		j3630282149 -> j1310452999;
	j3248041138 [label="Мне жаль, что вы с Мари не пришли к единому мнению по поводу «le Cardinal». Но я, по крайней мере, рад, что дело не дошло до драки.",shape=box,color=blue];
		j3248041138 -> j2284627778;
		j3248041138 -> j4143565687;
		j3248041138 -> j1310452999;
	"Chat ends." [color=orange];
	j3572677649 [label="Что это такое?",shape=box,color=red];
		j3572677649 -> j1770870867;
	j1310452999 [label="[Конец.]",shape=box,color=red];
		j1310452999 -> "Chat ends.";
	j4143565687 [label="Я не то чтобы горжусь некоторыми из тех вещей, которые я сказал, но... ",shape=box,color=red];
		j4143565687 -> j1675985708;
	j2284627778 [label="Она рассказала тебе всё это, не так ли?",shape=box,color=red];
		j2284627778 -> j2789532619;
	j1770870867 [label="Пожалуйста, убеди Мари прекратить использовать некрамиты для создания копий мебели. Я и так не знаю, что делать со всеми этими стульями.",shape=box,color=blue];
		j1770870867 -> j3612840457;
	j1675985708 [label="В конце концов, есть причина, по которой был изобретен термин «преступление в состоянии аффекта». Я думаю, что если бы мы, как живые существа, не придерживались своих убеждений, жизнь была бы ужасно скучной.",shape=box,color=blue];
		j1675985708 -> j4177267542;
	j2789532619 [label="Она так и сделала. Мы каждый вечер обсуждаем события дня. И после вашего разговора она поспешила ко мне, чтобы высказать всё, что она об этом думает.",shape=box,color=blue];
		j2789532619 -> j961482172;
		j2789532619 -> j3938693616;
	j3612840457 [label="+20 Chemistry",color=orange];
		j3612840457 -> j3478626340;
	j4177267542 [label="Безусловно тише. Более мирно. Но скучно. Определённо не было бы никакого искусства, о котором можно было бы говорить.",shape=box,color=blue];
		j4177267542 -> j1441574423;
	j961482172 [label="Что она тебе сказала?",shape=box,color=red];
		j961482172 -> j3495933037;
	j3938693616 [label="... И?",shape=box,color=red];
		j3938693616 -> j3495933037;
	j3478626340 [label="И я отказываюсь брать её с собой... красочные предложения относительно того, в какой части анатомии Роута они должны храниться.",shape=box,color=blue];
		j3478626340 -> "Chat ends.";
	j1441574423 [label="Но я отвлёкся. Интересно, в моих разговорах с ней твои слова звучали трогательно. Не могу не спросить - есть ли у тебя удовлетворение тем, на какой ноте вы тогда закончили?",shape=box,color=blue];
		j1441574423 -> j1424199455;
	j3495933037 [label="Check boolean LyonDating",color=orange];
		j3495933037 -> j233680853 [label=true,color=green];
		j3495933037 -> j4077526634 [label=false,color=brown];
	j1424199455 [label="Evaluate expressions",color=orange];
		j1424199455 -> j2816825083 [label="MarieDating, MarieFamilyFail",color=purple];
		j1424199455 -> j3934889384 [label="MarieDating, MarieFamilyFail",color=purple];
		j1424199455 -> j3983952195 [label="MarieFamilyFail",color=purple];
		j1424199455 -> j2806572537 [label="MarieFamilyFail",color=purple];
		j1424199455 -> j2816825083 [label="MarieFamilySuccess",color=purple];
		j1424199455 -> j3756650508 [label="MarieEntratiCompleteA",color=purple];
		j1424199455 -> j2484408577 [label="MarieEntratiCompleteB",color=purple];
		j1424199455 -> j4196628889 [label="MarieEntratiCompleteB",color=purple];
		j1424199455 -> j2036364753 [label="MarieEntratiCompleteC",color=purple];
		j1424199455 -> j4066933677 [label="false",color=purple];
	j233680853 [label="Ха! Как будто я предам её доверие тебе. Как бы ты ни был дорог мне, mon miracle, она была сестрой моей души на протяжении многих, многих долгих лет.",shape=box,color=blue];
		j233680853 -> j3650260931;
	j4077526634 [label="Ха! Как будто я предам её доверие тебе. Как бы ты ни был дорог мне, мой друг, она была сестрой моей души на протяжении многих, многих долгих лет.",shape=box,color=blue];
		j4077526634 -> j3650260931;
	j2816825083 [label="Я. Я думаю, она поможет наладить отношения между Лойдом и семьей наверху. И это... Это очень важно, Лиону. Не думаю, что смогу объяснить, насколько это важно.",shape=box,color=red];
		j2816825083 -> j2670091659;
	j3934889384 [label="Нет, честно говоря, из-за того, что между нами все осталось по-прежнему, я лишил её возможности помочь мне наладить отношения между Лойдом и семьей наверху.",shape=box,color=red];
		j3934889384 -> j1780623097;
	j3983952195 [label="Нет, честно говоря, из-за того, что между нами все осталось по-прежнему, я лишил её возможности помочь мне наладить отношения между Лойдом и семьей наверху.",shape=box,color=red];
		j3983952195 -> j2769973807;
	j2806572537 [label="Я. Она не станет помогать мне мирить Лоида и семью наверху, и меня это вполне устраивает.",shape=box,color=red];
		j2806572537 -> j2659574012;
	j3756650508 [label="Я. Я рад, что она увидела, что Энтрати, возможно, не совсем «добрый», и... но ведь он и не полностью «злой», не так ли?",shape=box,color=red];
		j3756650508 -> j2369601491;
	j2484408577 [label="Меня устраивает то, на чём мы остановились. Если честно, чем больше я это обдумываю, тем больше понимаю, что в вопросе об Энтрати я скорее на её стороне.",shape=box,color=red];
		j2484408577 -> j2659574012;
	j4196628889 [label="Мы не сошлись во взглядах на Энтрати. Мне не удалось её убедить и… жаль, что у меня не получилось сделать это лучше.",shape=box,color=red];
		j4196628889 -> j4173908626;
	j2036364753 [label="Мы «согласились не соглашаться» по поводу Энтрати, и я думаю, что это всё, чего мы когда-либо добьемся в этом вопросе. Я не думаю, что дальнейшие разговоры помогут делу.",shape=box,color=red];
		j2036364753 -> j3329960370;
	j4066933677 [label="Честно говоря, всё в порядке. Не думаю, что на данный момент ситуация изменится к лучшему или к худшему.",shape=box,color=red];
		j4066933677 -> j3329960370;
	j3650260931 [label="Нет, я боюсь, что её слова, обращенные ко мне, останутся моей тайной. Но, тем не менее, они были обращены к ней. Однако мне всё же интересно, есть ли у тебя удовлетворение тем, как вы тогда завершили разговор?",shape=box,color=blue];
		j3650260931 -> j1424199455;
	j2670091659 [label="Я действительно верю, что могу постичь его величие, если не масштабы. Для меня... большая честь быть его частью, пусть и в малой степени.",shape=box,color=blue];
		j2670091659 -> j1143547087;
		j2670091659 -> j3621172781;
	j1780623097 [label="Очаровательно... Что ж, теперь ты её любовь, не так ли? Если у кого-то в этом месте и было бы достаточно влияния, чтобы убедить её, то это была бы твоя роль, да?",shape=box,color=blue];
		j1780623097 -> j1565389005;
	j2769973807 [label="Очаровательно... Что ж, известно, что я имею на нее некоторое... влияние, пусть и ограниченное. Ты считаешь, что это налаживание отношений между M. Лойдом и отдалившейся семьей Энтрати важно?",shape=box,color=blue];
		j2769973807 -> j1947240282;
		j2769973807 -> j4191357963;
	j2659574012 [label="Я не могу сказать, что это за тон раздражительности, высокомерия, невежества или апатии. Поэтому я остановлюсь на сочетании всех четырех и буду жить дальше своей жизнью.",shape=box,color=blue];
		j2659574012 -> j3000182659;
	j2369601491 [label="В самом деле. Я придерживаюсь похожего взгляда, что и ты. Я не верю, что он был тем или иным, но все же... в его мотивах была путаница.",shape=box,color=blue];
		j2369601491 -> j3989835383;
	j4173908626 [label="Хм. Что ж, к сожалению, наступает время, когда всему приходит конец. С тестом можно переборщить. Художник может добавить слишком много к своей картине. И спор вполне может быть чрезмерно раздут.",shape=box,color=blue];
		j4173908626 -> j289712295;
	j3329960370 [label="Да, возможно, было бы лучше перейти к другим темам.",shape=box,color=blue];
		j3329960370 -> j2893528714;
	j1143547087 [label="У меня и в мыслях не было, что ты предложишь помощь.",shape=box,color=red];
		j1143547087 -> j2914814356;
	j3621172781 [label="Значит ли это, что ты поможешь мне убедить Лойда подняться наверх и поговорить с ними?",shape=box,color=red];
		j3621172781 -> j3857020136;
	j1565389005 [label="Я просто надеюсь, что в своих словах к ней ты не принес какую-то жертву, не поставил один приоритет выше другого в попытке добиться её расположения.",shape=box,color=blue];
		j1565389005 -> j2738356212;
	j1947240282 [label="В этом мире так много одиночества, Лион. Так много грусти. Почему бы не покончить с этим, пока есть такая возможность? ",shape=box,color=red];
		j1947240282 -> j368859983;
	j4191357963 [label="Не знаю, это инстинкт, какое-то внутреннее чувство. Мне кажется, что вы трое были приведены сюда Энтрати в этот момент по какой-то причине.",shape=box,color=red];
		j4191357963 -> j2542892954;
	j3000182659 [label="Сожаление.",shape=box,color=blue];
		j3000182659 -> j3497962379;
	j3989835383 [label="Им двигала гордыня. Жажда знаний. Теперь, возможно, жажда прощения. Кто знает? Интересно, знает ли он сам.",shape=box,color=blue];
		j3989835383 -> j2594858649;
	j289712295 [label="Полагаю, я бы просто предпочёл оставить всё как есть. И надеюсь, что когда-нибудь у неё будет шанс увидеть Энтрати таким, каким мы его знаем - в лучшем случае, сложным.",shape=box,color=blue];
		j289712295 -> j2594858649;
	j2893528714 [label="Я, по крайней мере, уже готов к тому, чтобы они перестали бесконечно обсуждать этого чудесного и безупречного «le Cardinal».",shape=box,color=blue];
		j2893528714 -> j2594858649;
	j2914814356 [label="Я знаю, что я не слишком приветлив, но и не какой-нибудь там упырь. Если тебе нужна моя помощь, ты ее получишь.",shape=box,color=blue];
		j2914814356 -> j2800191596;
	j3857020136 [label="Разумеется. Если тебе нужна моя помощь, ты её получишь.",shape=box,color=blue];
		j3857020136 -> j2800191596;
	j2738356212 [label="Какое же это было бы жалкое положение дел.",shape=box,color=blue];
		j2738356212 -> j4007178351;
	j368859983 [label="Хм. А что насчёт возможной боли, которую может причинить повторное знакомство между вовлеченными сторонами, когда такие откровения будут сделаны?",shape=box,color=blue];
		j368859983 -> j1610573302;
		j368859983 -> j2945451136;
	j2542892954 [label="И ты, значит, занимаешься тем, что выполняешь поручения Энтрати под влиянием «внутреннего чувства»?",shape=box,color=blue];
		j2542892954 -> j2885546872;
		j2542892954 -> j4002287354;
	j3497962379 [label="Boolean LyonFamilyFail is now true.",color=orange];
		j3497962379 -> "Chat ends.";
	j2594858649 [label="Я не знаю, как разовьются отношения между M. Лойдом и отдалившейся семьей Энтрати. Я просто хотел сказать, что если тебе нужна моя помощь, ты её получишь.",shape=box,color=blue];
		j2594858649 -> j2800191596;
	j2800191596 [label="Evaluate expressions",color=orange];
		j2800191596 -> j1559092392 [label="RoatheFamilyDelay",color=purple];
		j2800191596 -> j1998736091 [label="RoatheFamilyFail",color=purple];
		j2800191596 -> j431663653 [label="false",color=purple];
	j4007178351 [label="Ты получишь мою помощь, какой бы малой пользы это тебе ни принесло.",shape=box,color=blue];
		j4007178351 -> j1484678790;
	j1610573302 [label="Сначала это будет больно, конечно. Как вправлять сломанную кость. Но это единственный способ, чтобы что-то подобное смогло правильно зажить.",shape=box,color=red];
		j1610573302 -> j3556475633;
	j2945451136 [label="Я думаю, то, что мы все можем получить, будучи вместе, больше того, что мы можем потерять, будучи порознь.",shape=box,color=red];
		j2945451136 -> j3556475633;
	j2885546872 [label="Нет, но я занимаюсь тем, что защищаю людей, которые в этом нуждаются. И я не могу вечно защищать их и это место от Шёпота и Заражения. Но вы двое - и, возможно, даже Роут - можете.",shape=box,color=red];
		j2885546872 -> j3556475633;
	j4002287354 [label="Я, конечно, не доверяю ему, но всё же не думаю, что он наш враг. Я чувствую, что приближается война, и нас всех ставят на те места, где мы должны быть. И это то место, где нам самое место.",shape=box,color=red];
		j4002287354 -> j1173878949;
	j1559092392 [label="Хотя я полагаю, что вы уже выполнили то, что было самой трудной задачей - убедили Роут.",shape=box,color=blue];
		j1559092392 -> j3009498664;
	j1998736091 [label="Хотя мне придётся посидеть и подумать, как убедить Роут передумать... что, я не уверен, мне удастся это сделать. А без него это может оказаться безнадёжным делом.",shape=box,color=blue];
		j1998736091 -> j1980610739;
		j1998736091 -> j3499119481;
	j431663653 [label="Хотя труднее всего убедить, я боюсь об этом думать, вероятно, самого важного - Роут.",shape=box,color=blue];
		j431663653 -> j1980610739;
		j431663653 -> j3499119481;
	j1484678790 [label="Boolean LyonFamilySuccess is now true.",color=orange];
		j1484678790 -> j3887740085;
	j3556475633 [label="+20 Chemistry",color=orange];
		j3556475633 -> j3070764680;
	j1173878949 [label="Ммм. Возможно. Но мы не шахматные фигуры, и я отказываюсь, чтобы со мной обращались как с таковыми. Если Энтрати хочет подать такую апелляцию, он может отправить проклятое письмо.",shape=box,color=blue];
		j1173878949 -> j2193250803;
	j3009498664 [label="Этот проклятый ублюдок - как бы мне ни хотелось найти способ заткнуть ему рот - полезен.",shape=box,color=blue];
		j3009498664 -> j3941867773;
	j1980610739 [label="Да...",shape=box,color=red];
		j1980610739 -> j3009498664;
	j3499119481 [label="Почему Роут вообще так важен для всего этого дела?",shape=box,color=red];
		j3499119481 -> j2651351009;
	j3887740085 [label="- Лион",shape=box,color=blue];
		j3887740085 -> j1933300832;
	j3070764680 [label="Действительно. Мудрые слова. Очень хорошо. Я поговорю с ней. Посмотрим, смогу ли я убедить её снова поговорить с тобой по этому поводу.",shape=box,color=blue];
		j3070764680 -> j2755898966;
		j3070764680 -> j3257643879;
	j2193250803 [label="Боюсь, что в этом смысле я присоединяюсь к жалобам М. Лойд. Вы можете рассчитывать на мою помощь в его убеждении, но я не думаю, что вы далеко продвинетесь без Мари.",shape=box,color=blue];
		j2193250803 -> j4039547409;
	j3941867773 [label="Check boolean RoatheDating",color=orange];
		j3941867773 -> j2438239507 [label=true,color=green];
		j3941867773 -> j4259454218 [label=false,color=brown];
	j2651351009 [label="Мари и я - чужаки. Роут, Лойд, Энтрати и дочь Энтрати - ровесники. Не говоря уже о том, что у него есть знания, которые он может использовать, чтобы защитить их, если что-то пойдет не так.",shape=box,color=blue];
		j2651351009 -> j3026535390;
	j1933300832 [label="+10 Chemistry",color=orange];
		j1933300832 -> "Chat ends.";
	j2755898966 [label="Подожди... ты... убедишь её помочь мне с семьей Энтрати?",shape=box,color=red];
		j2755898966 -> j1339652253;
	j3257643879 [label="Я. Ты. Ты сделаешь это?",shape=box,color=red];
		j3257643879 -> j1339652253;
	j4039547409 [label="Boolean LyonFamilySuccess is now true.",color=orange];
		j4039547409 -> j4144085880;
	j2438239507 [label="Без обид.",shape=box,color=blue];
		j2438239507 -> j4251813888;
		j2438239507 -> j527844083;
	j4259454218 [label="Я снова отвлёкся от темы. Как я уже сказал, когда придёт время. И, говоря о времени, я должен вас покинуть.",shape=box,color=blue];
		j4259454218 -> j3537028482;
	j3026535390 [label="Хотя мне и неприятно это признавать, мы с Мари всё равно бы путались в попытках разобраться, как пользоваться половиной оборудования в этом здании, в то время как он управлялся бы с ним с легкостью.",shape=box,color=blue];
		j3026535390 -> j3009498664;
	j1339652253 [label="Check boolean LyonDating",color=orange];
		j1339652253 -> j133111780 [label=true,color=green];
		j1339652253 -> j3866021824 [label=false,color=brown];
	j4144085880 [label="Желаю удачи. А пока прощай.",shape=box,color=blue];
		j4144085880 -> j3176698568;
	j4251813888 [label="Мне больше достанется.",shape=box,color=red];
		j4251813888 -> j2387846162;
	j527844083 [label="Да никаких. Я понимаю, что он подходит не каждому.",shape=box,color=red];
