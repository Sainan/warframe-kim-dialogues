digraph {
	1824 [label="LyonRank5Convo6 begins.",color=orange];
		1824 -> 1825;
	1825 [label="Evaluate expressions",color=orange];
		1825 -> 1826 [label="LoidFamilyComplete",color=purple];
		1825 -> 1830 [label="MarieEntratiCompleteA",color=purple];
		1825 -> 1829 [label="MarieEntratiCompleteB",color=purple];
		1825 -> 1828 [label="MarieEntratiCompleteC",color=purple];
		1825 -> 1827 [label="false",color=purple];
	1826 [label="Скиталец. Можно тебя попросить?",shape=box,color=blue];
		1826 -> 1832;
		1826 -> 1831;
	1830 [label="Могу ли я воспользоваться моментом, чтобы похвалить тебя за то, что, как мне казалось, раньше было невозможно сделать иным способом?",shape=box,color=blue];
		1830 -> 1834;
		1830 -> 1833;
		1830 -> 1835;
	1829 [label="Я должен направить тебе свои соболезнования по поводу твоих благородных, но трагически недолговечных попыток, когда дело касается Мари и вопроса о «le Cardinal».",shape=box,color=blue];
		1829 -> 1833;
		1829 -> 1834;
		1829 -> 1835;
	1828 [label="Мне жаль, что вы с Мари не пришли к единому мнению по поводу «le Cardinal». Но я, по крайней мере, рад, что дело не дошло до драки.",shape=box,color=blue];
		1828 -> 1833;
		1828 -> 1834;
		1828 -> 1835;
	1827 [label="Chat ends.",color=orange];
	1832 [label="Что это такое?",shape=box,color=red];
		1832 -> 1837;
	1831 [label="[Конец.]",shape=box,color=red];
		1831 -> 1836;
	1834 [label="Я не то чтобы горжусь некоторыми из тех вещей, которые я сказал, но... ",shape=box,color=red];
		1834 -> 1839;
	1833 [label="Она рассказала тебе всё это, не так ли?",shape=box,color=red];
		1833 -> 1838;
	1835 [label="[Конец.]",shape=box,color=red];
		1835 -> 1840;
	1837 [label="Пожалуйста, убеди Мари прекратить использовать некрамиты для создания копий мебели. Я и так не знаю, что делать со всеми этими стульями.",shape=box,color=blue];
		1837 -> 1841;
	1836 [label="Chat ends.",color=orange];
	1839 [label="В конце концов, есть причина, по которой был изобретен термин «преступление в состоянии аффекта». Я думаю, что если бы мы, как живые существа, не придерживались своих убеждений, жизнь была бы ужасно скучной.",shape=box,color=blue];
		1839 -> 1844;
	1838 [label="Она так и сделала. Мы каждый вечер обсуждаем события дня. И после вашего разговора она поспешила ко мне, чтобы высказать всё, что она об этом думает.",shape=box,color=blue];
		1838 -> 1842;
		1838 -> 1843;
	1840 [label="Chat ends.",color=orange];
	1841 [label="+20 Chemistry",color=orange];
		1841 -> 1845;
	1844 [label="Безусловно тише. Более мирно. Но скучно. Определённо не было бы никакого искусства, о котором можно было бы говорить.",shape=box,color=blue];
		1844 -> 1847;
	1842 [label="Что она тебе сказала?",shape=box,color=red];
		1842 -> 1846;
	1843 [label="... И?",shape=box,color=red];
		1843 -> 1846;
	1845 [label="И я отказываюсь брать её с собой... красочные предложения относительно того, в какой части анатомии Роута они должны храниться.",shape=box,color=blue];
		1845 -> 1848;
	1847 [label="Но я отвлёкся. Интересно, в моих разговорах с ней твои слова звучали трогательно. Не могу не спросить - есть ли у тебя удовлетворение тем, на какой ноте вы тогда закончили?",shape=box,color=blue];
		1847 -> 1851;
	1846 [label="Check boolean LyonDating",color=orange];
		1846 -> 1850 [label=true,color=green];
		1846 -> 1849 [label=false,color=brown];
	1848 [label="Chat ends.",color=orange];
	1851 [label="Evaluate expressions",color=orange];
		1851 -> 1853 [label="MarieDating, MarieFamilyFail",color=purple];
		1851 -> 1854 [label="MarieDating, MarieFamilyFail",color=purple];
		1851 -> 1858 [label="MarieFamilyFail",color=purple];
		1851 -> 1859 [label="MarieFamilyFail",color=purple];
		1851 -> 1853 [label="MarieFamilySuccess",color=purple];
		1851 -> 1860 [label="MarieEntratiCompleteA",color=purple];
		1851 -> 1855 [label="MarieEntratiCompleteB",color=purple];
		1851 -> 1856 [label="MarieEntratiCompleteB",color=purple];
		1851 -> 1857 [label="MarieEntratiCompleteC",color=purple];
		1851 -> 1861 [label="false",color=purple];
	1850 [label="Ха! Как будто я предам её доверие тебе. Как бы ты ни был дорог мне, mon miracle, она была сестрой моей души на протяжении многих, многих долгих лет.",shape=box,color=blue];
		1850 -> 1852;
	1849 [label="Ха! Как будто я предам её доверие тебе. Как бы ты ни был дорог мне, мой друг, она была сестрой моей души на протяжении многих, многих долгих лет.",shape=box,color=blue];
		1849 -> 1852;
	1853 [label="Я. Я думаю, она поможет наладить отношения между Лойдом и семьей наверху. И это... Это очень важно, Лиону. Не думаю, что смогу объяснить, насколько это важно.",shape=box,color=red];
		1853 -> 1862;
	1854 [label="Нет, честно говоря, из-за того, что между нами все осталось по-прежнему, я лишил её возможности помочь мне наладить отношения между Лойдом и семьей наверху.",shape=box,color=red];
		1854 -> 1863;
	1858 [label="Нет, честно говоря, из-за того, что между нами все осталось по-прежнему, я лишил её возможности помочь мне наладить отношения между Лойдом и семьей наверху.",shape=box,color=red];
		1858 -> 1866;
	1859 [label="Я. Она не станет помогать мне мирить Лоида и семью наверху, и меня это вполне устраивает.",shape=box,color=red];
		1859 -> 1867;
	1860 [label="Я. Я рад, что она увидела, что Энтрати, возможно, не совсем «добрый», и... но ведь он и не полностью «злой», не так ли?",shape=box,color=red];
		1860 -> 1868;
	1855 [label="Меня устраивает то, на чём мы остановились. Если честно, чем больше я это обдумываю, тем больше понимаю, что в вопросе об Энтрати я скорее на её стороне.",shape=box,color=red];
		1855 -> 1867;
	1856 [label="Мы не сошлись во взглядах на Энтрати. Мне не удалось её убедить и… жаль, что у меня не получилось сделать это лучше.",shape=box,color=red];
		1856 -> 1864;
	1857 [label="Мы «согласились не соглашаться» по поводу Энтрати, и я думаю, что это всё, чего мы когда-либо добьемся в этом вопросе. Я не думаю, что дальнейшие разговоры помогут делу.",shape=box,color=red];
		1857 -> 1865;
	1861 [label="Честно говоря, всё в порядке. Не думаю, что на данный момент ситуация изменится к лучшему или к худшему.",shape=box,color=red];
		1861 -> 1865;
	1852 [label="Нет, я боюсь, что её слова, обращенные ко мне, останутся моей тайной. Но, тем не менее, они были обращены к ней. Однако мне всё же интересно, есть ли у тебя удовлетворение тем, как вы тогда завершили разговор?",shape=box,color=blue];
		1852 -> 1851;
	1862 [label="Я действительно верю, что могу постичь его величие, если не масштабы. Для меня... большая честь быть его частью, пусть и в малой степени.",shape=box,color=blue];
		1862 -> 1869;
		1862 -> 1870;
	1863 [label="Очаровательно... Что ж, теперь ты её любовь, не так ли? Если у кого-то в этом месте и было бы достаточно влияния, чтобы убедить её, то это была бы твоя роль, да?",shape=box,color=blue];
		1863 -> 1871;
	1866 [label="Очаровательно... Что ж, известно, что я имею на нее некоторое... влияние, пусть и ограниченное. Ты считаешь, что это налаживание отношений между M. Лойдом и отдалившейся семьей Энтрати важно?",shape=box,color=blue];
		1866 -> 1874;
		1866 -> 1875;
	1867 [label="Я не могу сказать, что это за тон раздражительности, высокомерия, невежества или апатии. Поэтому я остановлюсь на сочетании всех четырех и буду жить дальше своей жизнью.",shape=box,color=blue];
		1867 -> 1876;
	1868 [label="В самом деле. Я придерживаюсь похожего взгляда, что и ты. Я не верю, что он был тем или иным, но все же... в его мотивах была путаница.",shape=box,color=blue];
		1868 -> 1877;
	1864 [label="Хм. Что ж, к сожалению, наступает время, когда всему приходит конец. С тестом можно переборщить. Художник может добавить слишком много к своей картине. И спор вполне может быть чрезмерно раздут.",shape=box,color=blue];
		1864 -> 1872;
	1865 [label="Да, возможно, было бы лучше перейти к другим темам.",shape=box,color=blue];
		1865 -> 1873;
	1869 [label="У меня и в мыслях не было, что ты предложишь помощь.",shape=box,color=red];
		1869 -> 1878;
	1870 [label="Значит ли это, что ты поможешь мне убедить Лойда подняться наверх и поговорить с ними?",shape=box,color=red];
		1870 -> 1879;
	1871 [label="Я просто надеюсь, что в своих словах к ней ты не принес какую-то жертву, не поставил один приоритет выше другого в попытке добиться её расположения.",shape=box,color=blue];
		1871 -> 1880;
	1874 [label="В этом мире так много одиночества, Лион. Так много грусти. Почему бы не покончить с этим, пока есть такая возможность? ",shape=box,color=red];
		1874 -> 1882;
	1875 [label="Не знаю, это инстинкт, какое-то внутреннее чувство. Мне кажется, что вы трое были приведены сюда Энтрати в этот момент по какой-то причине.",shape=box,color=red];
		1875 -> 1883;
	1876 [label="Сожаление.",shape=box,color=blue];
		1876 -> 1884;
	1877 [label="Им двигала гордыня. Жажда знаний. Теперь, возможно, жажда прощения. Кто знает? Интересно, знает ли он сам.",shape=box,color=blue];
		1877 -> 1881;
	1872 [label="Полагаю, я бы просто предпочёл оставить всё как есть. И надеюсь, что когда-нибудь у неё будет шанс увидеть Энтрати таким, каким мы его знаем - в лучшем случае, сложным.",shape=box,color=blue];
		1872 -> 1881;
	1873 [label="Я, по крайней мере, уже готов к тому, чтобы они перестали бесконечно обсуждать этого чудесного и безупречного «le Cardinal».",shape=box,color=blue];
		1873 -> 1881;
	1878 [label="Я знаю, что я не слишком приветлив, но и не какой-нибудь там упырь. Если тебе нужна моя помощь, ты ее получишь.",shape=box,color=blue];
		1878 -> 1885;
	1879 [label="Разумеется. Если тебе нужна моя помощь, ты её получишь.",shape=box,color=blue];
		1879 -> 1885;
	1880 [label="Какое же это было бы жалкое положение дел.",shape=box,color=blue];
		1880 -> 1886;
	1882 [label="Хм. А что насчёт возможной боли, которую может причинить повторное знакомство между вовлеченными сторонами, когда такие откровения будут сделаны?",shape=box,color=blue];
		1882 -> 1887;
		1882 -> 1888;
	1883 [label="И ты, значит, занимаешься тем, что выполняешь поручения Энтрати под влиянием «внутреннего чувства»?",shape=box,color=blue];
		1883 -> 1889;
		1883 -> 1890;
	1884 [label="Update boolean LyonFamilyFail",color=orange];
		1884 -> 1891;
	1881 [label="Я не знаю, как разовьются отношения между M. Лойдом и отдалившейся семьей Энтрати. Я просто хотел сказать, что если тебе нужна моя помощь, ты её получишь.",shape=box,color=blue];
		1881 -> 1885;
	1885 [label="Evaluate expressions",color=orange];
		1885 -> 1893 [label="RoatheFamilyDelay",color=purple];
		1885 -> 1894 [label="RoatheFamilyFail",color=purple];
		1885 -> 1892 [label="false",color=purple];
	1886 [label="Ты получишь мою помощь, какой бы малой пользы это тебе ни принесло.",shape=box,color=blue];
		1886 -> 1895;
	1887 [label="Сначала это будет больно, конечно. Как вправлять сломанную кость. Но это единственный способ, чтобы что-то подобное смогло правильно зажить.",shape=box,color=red];
		1887 -> 1896;
	1888 [label="Я думаю, то, что мы все можем получить, будучи вместе, больше того, что мы можем потерять, будучи порознь.",shape=box,color=red];
		1888 -> 1896;
	1889 [label="Нет, но я занимаюсь тем, что защищаю людей, которые в этом нуждаются. И я не могу вечно защищать их и это место от Шёпота и Заражения. Но вы двое - и, возможно, даже Роут - можете.",shape=box,color=red];
		1889 -> 1896;
	1890 [label="Я, конечно, не доверяю ему, но всё же не думаю, что он наш враг. Я чувствую, что приближается война, и нас всех ставят на те места, где мы должны быть. И это то место, где нам самое место.",shape=box,color=red];
		1890 -> 1897;
	1891 [label="Chat ends.",color=orange];
	1893 [label="Хотя я полагаю, что вы уже выполнили то, что было самой трудной задачей - убедили Роут.",shape=box,color=blue];
		1893 -> 1900;
	1894 [label="Хотя мне придётся посидеть и подумать, как убедить Роут передумать... что, я не уверен, мне удастся это сделать. А без него это может оказаться безнадёжным делом.",shape=box,color=blue];
		1894 -> 1898;
		1894 -> 1899;
	1892 [label="Хотя труднее всего убедить, я боюсь об этом думать, вероятно, самого важного - Роут.",shape=box,color=blue];
		1892 -> 1898;
		1892 -> 1899;
	1895 [label="Update boolean LyonFamilySuccess",color=orange];
		1895 -> 1901;
	1896 [label="+20 Chemistry",color=orange];
		1896 -> 1902;
	1897 [label="Ммм. Возможно. Но мы не шахматные фигуры, и я отказываюсь, чтобы со мной обращались как с таковыми. Если Энтрати хочет подать такую апелляцию, он может отправить проклятое письмо.",shape=box,color=blue];
		1897 -> 1903;
	1900 [label="Этот проклятый ублюдок - как бы мне ни хотелось найти способ заткнуть ему рот - полезен.",shape=box,color=blue];
		1900 -> 1905;
	1898 [label="Да...",shape=box,color=red];
		1898 -> 1900;
	1899 [label="Почему Роут вообще так важен для всего этого дела?",shape=box,color=red];
		1899 -> 1904;
	1901 [label="- Лион",shape=box,color=blue];
		1901 -> 1906;
	1902 [label="Действительно. Мудрые слова. Очень хорошо. Я поговорю с ней. Посмотрим, смогу ли я убедить её снова поговорить с тобой по этому поводу.",shape=box,color=blue];
		1902 -> 1907;
		1902 -> 1908;
	1903 [label="Боюсь, что в этом смысле я присоединяюсь к жалобам М. Лойд. Вы можете рассчитывать на мою помощь в его убеждении, но я не думаю, что вы далеко продвинетесь без Мари.",shape=box,color=blue];
		1903 -> 1909;
	1905 [label="Check boolean RoatheDating",color=orange];
		1905 -> 1912 [label=true,color=green];
		1905 -> 1911 [label=false,color=brown];
	1904 [label="Мари и я - чужаки. Роут, Лойд, Энтрати и дочь Энтрати - ровесники. Не говоря уже о том, что у него есть знания, которые он может использовать, чтобы защитить их, если что-то пойдет не так.",shape=box,color=blue];
		1904 -> 1910;
	1906 [label="+10 Chemistry",color=orange];
		1906 -> 1913;
	1907 [label="Подожди... ты... убедишь её помочь мне с семьей Энтрати?",shape=box,color=red];
		1907 -> 1914;
	1908 [label="Я. Ты. Ты сделаешь это?",shape=box,color=red];
		1908 -> 1914;
	1909 [label="Update boolean LyonFamilySuccess",color=orange];
		1909 -> 1915;
	1912 [label="Без обид.",shape=box,color=blue];
		1912 -> 1917;
		1912 -> 1918;
	1911 [label="Я снова отвлёкся от темы. Как я уже сказал, когда придёт время. И, говоря о времени, я должен вас покинуть.",shape=box,color=blue];
		1911 -> 1916;
	1910 [label="Хотя мне и неприятно это признавать, мы с Мари всё равно бы путались в попытках разобраться, как пользоваться половиной оборудования в этом здании, в то время как он управлялся бы с ним с легкостью.",shape=box,color=blue];
		1910 -> 1900;
	1913 [label="Chat ends.",color=orange];
	1914 [label="Check boolean LyonDating",color=orange];
		1914 -> 1920 [label=true,color=green];
		1914 -> 1919 [label=false,color=brown];
	1915 [label="Желаю удачи. А пока прощай.",shape=box,color=blue];
		1915 -> 1921;
	1917 [label="Мне больше достанется.",shape=box,color=red];
		1917 -> 1923;
	1918 [label="Да никаких. Я понимаю, что он подходит не каждому.",shape=box,color=red];
		1918 -> 1923;
	1916 [label="+20 Chemistry",color=orange];
		1916 -> 1922;
	1920 [label="Я сделаю всё, что в моих силах, mon miracle. Она моя сестра. Но я мало что могу сделать. Я постараюсь, чтобы она снова поговорила с тобой, но после этого ты должен будешь сделать всё остальное.",shape=box,color=blue];
		1920 -> 1924;
	1919 [label="Я сделаю всё, что в моих силах, друг мой. Она моя сестра. Но я мало что могу сделать. Я постараюсь, чтобы она снова поговорила с тобой, но после этого ты должен будешь сделать всё остальное.",shape=box,color=blue];
		1919 -> 1924;
	1921 [label="- Лион",shape=box,color=blue];
		1921 -> 1925;
	1923 [label="Ммм. Что ж, как я уже сказал, я помогу вам, когда придёт время. И, говоря о времени, я должен вас покинуть.",shape=box,color=blue];
		1923 -> 1916;
