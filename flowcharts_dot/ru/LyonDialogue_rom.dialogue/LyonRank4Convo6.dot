		1181 -> 1183 [label="false",color=purple];
		1181 -> 1182 [label="false",color=purple];
	2232 [label="+20 Chemistry",color=orange];
		2232 -> 2231;
	1186 [label="Лион, мы с Мари говорили о твоих… привычках и хотелось бы узнать, можем ли мы поговорить?",shape=box,color=red];
		1186 -> 1192;
	1183 [label="[Отключить разговоры о самоповреждении. При этом никакой потери химии с Лионом или любым другим персонажем не произойдёт.]",shape=box,color=red];
		1183 -> 1189;
	1182 [label="[Конец.]",shape=box,color=red];
		1182 -> 1188;
	1185 [label="Лион? Можем ли мы поговорить о чём‑то, что может быть… немного неприятно для тебя?",shape=box,color=red];
		1185 -> 1191;
	1184 [label="Лион, мне было интересно, могу ли я поговорить с тобой о том, почему ты… эм… навредил себе, если ты не против?",shape=box,color=red];
		1184 -> 1190;
	2231 [label="[Разговор пропущен из-за ранее установленного предупреждения.]",shape=box,color=blue];
		2231 -> 1057;
	1192 [label="Она сказала мне, что вы двое говорили — да, разумеется. Ты можешь удивиться, но меня куда меньше тревожит разговор об этой моей особенности, чем можно было бы ожидать.",shape=box,color=blue];
		1192 -> 1197;
	1189 [label="Update boolean LyonPainOff",color=orange];
		1189 -> 1194;
	1188 [label="Chat ends.",color=orange];
	1191 [label="Ты можешь спросить, хотя я оставляю за собой право прекратить разговор, если почувствую, что он заходит в область обсуждения, в которой я больше не хочу участвовать. ",shape=box,color=blue];
		1191 -> 1196;
	1190 [label="Хм. Честно говоря, я удивлён, что тебе понадобилось столько времени, чтобы поинтересоваться этой моей особенностью. Обычно именно она вызывает у людей наибольший отклик.",shape=box,color=blue];
		1190 -> 1195;
	1057 [label="Chat ends.",color=orange];
	1197 [label="Обычно именно это люди замечают прежде всего. Либо из тревоги, либо из отвращения, либо из мрачного любопытства.",shape=box,color=blue];
		1197 -> 1204;
	1194 [label="Если ты считаешь себя трусом, сделав этот выбор, умоляю тебя – не делай этого. Ибо это боль, с которой тебе не справиться. Она моя. Тебе не хотелось терпеть этот момент.",shape=box,color=blue];
		1194 -> 1198;
	1196 [label="Речь о том, что ты иногда причиняешь себе боль. Мне просто хотелось подойти к этому осторожно, вот и всё.",shape=box,color=red];
		1196 -> 1203;
	1195 [label="Либо из-за беспокойства, либо отвращения, либо той самой мрачной любопытности, что заставляет кого-то заглядывать сквозь решётки клетки безумца. Интересно, а ты кто?",shape=box,color=blue];
		1195 -> 1199;
		1195 -> 1200;
		1195 -> 1201;
		1195 -> 1202;
	1204 [label="Evaluate expressions",color=orange];
		1204 -> 1199 [label="LyonBackstory3a",color=purple];
		1204 -> 1210 [label="LyonBackstory3a",color=purple];
		1204 -> 1199 [label="LyonBackstory3b",color=purple];
		1204 -> 1210 [label="LyonBackstory3b",color=purple];
		1204 -> 1199 [label="DrifterHarmHelp",color=purple];
		1204 -> 1201 [label="DrifterHarmHelp",color=purple];
		1204 -> 1199 [label="DrifterHarmStop",color=purple];
		1204 -> 1202 [label="DrifterHarmStop",color=purple];
		1204 -> 1199 [label="DrifterHarmLoss",color=purple];
		1204 -> 1200 [label="DrifterHarmLoss",color=purple];
		1204 -> 1199 [label="false",color=purple];
	1198 [label="Это механическое приспособление, за которым мы сидим, создаёт впечатление скрытой безличности. Мы словно защищённы от любого вреда, который может причинить нам другой человек, какими бы словами он нам ни писал.",shape=box,color=blue];
		1198 -> 1205;
	1203 [label="+5 Chemistry",color=orange];
		1203 -> 1209;
	1199 [label="Извини, но, если подумать, я не могу этого сделать. [Конец.]",shape=box,color=red];
		1199 -> 1194;
	1200 [label="[Предупреждение: разговор о самоубийстве.] Мне… однажды пришлось потерять кого‑то из‑за такой вот “привычки”, и я...",shape=box,color=red];
		1200 -> 1206;
	1201 [label="Я просто хочу тебе помочь. Убедиться, что с тобой всё в порядке. Вот и всё.",shape=box,color=red];
		1201 -> 1207;
	1202 [label="Мне просто кажется, что это нездорово и это нужно прекратить. ",shape=box,color=red];
		1202 -> 1208;
	1210 [label="Я знаю, ты говорил, что причинял себе боль ещё до сыворотки, но… не могу представить, чтобы она сделала это лучше.",shape=box,color=red];
		1210 -> 1215;
	1205 [label="Я бы, пожалуй, утверждал обратное - обнаженные от тех доспехов, что мы надеваем в будничных обстоятельствах общения, мы оказываемся лишены того, что могло бы нас защитить.",shape=box,color=blue];
		1205 -> 1211;
	1209 [label="Я… ценю ту деликатность, с которой ты поднимаешь этот вопрос, Странник. Спасибо. Но я уже привык, что эта тема нередко становится предметом обсуждения. Будь то из заботы, отвращения или мрачного любопытства. Хотя, уже понятно, что речь у тебя о первом.",shape=box,color=blue];
		1209 -> 1199;
		1209 -> 1200;
		1209 -> 1201;
		1209 -> 1202;
	1206 [label="Update boolean DrifterHarmLoss",color=orange];
		1206 -> 1212;
	1207 [label="Update boolean DrifterHarmHelp",color=orange];
		1207 -> 1213;
	1208 [label="Update boolean DrifterHarmStop",color=orange];
		1208 -> 1214;
	1215 [label="Нет, боюсь, что нет. Она взяла то, что было… необходимостью, чтобы очистить мой разум от видений, что терзали меня, и превратила это в необходимость ради того, чтобы владеть “даром\" этой сыворотки.",shape=box,color=blue];
		1215 -> 1221;
	1211 [label="Поэтому в подобных ситуациях... я прекрасно понимаю, что выпускаю стрелу, которая может попасть не в готового к бою солдата, а в яремную вену ничего не подозревающего оленя в чаще леса.",shape=box,color=blue];
		1211 -> 1216;
	1212 [label="О, мой друг… нет таких слов, которыми я мог бы выразить всё своё сочувствие к тому, через что тебе пришлось пройти.",shape=box,color=blue];
		1212 -> 1217;
	1213 [label="Check boolean LyonAllRight",color=orange];
		1213 -> 1219 [label=true,color=green];
		1213 -> 1218 [label=false,color=brown];
	1214 [label="Боюсь, ты опоздал на несколько лет и на одну сыворотку протофрейма, чтобы положить конец этой моей… склонности. Полагаю, теперь это скорее необходимость, не так ли?",shape=box,color=blue];
		1214 -> 1220;
	1221 [label="+5 Chemistry",color=orange];
		1221 -> 1226;
	1216 [label="И потому я оставлю тебя вот с чем:",shape=box,color=blue];
		1216 -> 1222;
	1217 [label="В такие моменты язык кажется ничтожным. Мы стараемся использовать его как можно лучше, но он всегда нас подводит.",shape=box,color=blue];
		1217 -> 1223;
	1219 [label="Я снова стараюсь не смеяться над мыслью о том, что я всё ещё приближаюсь к понятию «всё в порядке». Но я очень ценю твоё чувство, Скиталец.",shape=box,color=blue];
		1219 -> 1224;
	1218 [label="Я стараюсь не смеяться над мыслью о том, что я всё ещё приближаюсь к понятию «всё в порядке». Но я очень ценю твоё чувство, Скиталец.",shape=box,color=blue];
		1218 -> 1224;
	1220 [label="+5 Chemistry",color=orange];
		1220 -> 1225;
	1226 [label="Если раньше у меня ещё была возможность избавиться от своей склонности к самоповреждению, то, думаю, объединение с варфреймом \"Харроу\" сделало это теперь совершенно невозможным.",shape=box,color=blue];
		1226 -> 1231;
	1222 [label="Мы должны напоминать себе, как найти в себе силы поднять другого человека на ноги, даже когда едва способны подняться сами.",shape=box,color=blue];
		1222 -> 1227;
	1223 [label="Если ты позволишь, в свете твоего признания я мог бы сделать три вещи.",shape=box,color=blue];
		1223 -> 1228;
	1224 [label="+5 Chemistry",color=orange];
		1224 -> 1229;
		1224 -> 1230;
	1225 [label="Но я не хочу быть столь легкомысленным, ведь, как мне кажется, ты выражаешь заботу о моём физическом и ментальном состоянии, прости. Я просто не думаю, что способен это прекратить.",shape=box,color=blue];
		1225 -> 1229;
		1225 -> 1230;
	1231 [label="Если позволишь мне выразиться грубо, Скиталец, я не думаю, что теперь вообще способен нанести себе какой‑либо настоящий, необратимый вред подобным образом.",shape=box,color=blue];
		1231 -> 1235;
	1227 [label="В этом и есть истинный смысл истории.",shape=box,color=blue];
		1227 -> 1232;
	1228 [label="Во‑первых, хочу заверить тебя, что я в полной безопасности. Если ты думаешь, что моё стремление причинять себе боль вызвано глубокой и тяжёлой внутренней неприязнью, я с радостью развею эти страхи.",shape=box,color=blue];
		1228 -> 1233;
	1229 [label="Могу я спросить, почему ты это делаешь?",shape=box,color=red];
		1229 -> 1234;
	1230 [label="Я просто боюсь, что однажды ты зайдёшь слишком далеко.",shape=box,color=red];
		1230 -> 1231;
	1235 [label="Хотя я не способен на высокомерие, необходимое, чтобы считать себя неуязвимым, такой поступок кажется... скажем так... частью замысла.",shape=box,color=blue];
		1235 -> 1241;
	1232 [label="+20 Chemistry",color=orange];
		1232 -> 1236;
	1233 [label="Хотя… я знаю эту глубокую меланхолию, она вовсе не вдохновляет моё кадило. (Да и Мари этого бы никогда не позволила. Скорее уж она скормит его мне, чем подпустит меня к нему снова.)",shape=box,color=blue];
		1233 -> 1237;
	1234 [label="Evaluate expressions",color=orange];
		1234 -> 1240 [label="LyonBackstory3a, LyonLecture2",color=purple];
		1234 -> 1240 [label="LyonBackstory3b, LyonLecture2",color=purple];
		1234 -> 1239 [label="LyonBackstory3a",color=purple];
		1234 -> 1239 [label="LyonBackstory3b",color=purple];
		1234 -> 1238 [label="false",color=purple];
	1241 [label="+5 Chemistry",color=orange];
		1241 -> 1246;
	1236 [label="Будь здоров, Скиталец. Скоро мы снова поговорим.",shape=box,color=blue];
		1236 -> 1242;
	1237 [label="Но никогда ещё столь глубокая боль не нашептывала мне по ночам, мой друг. В этом я могу тебе поклясться. В этом я клянусь тебе всем, что мне дорого.",shape=box,color=blue];
		1237 -> 1243;
	1240 [label="Я сказал тебе правду о том, что побуждает меня к этому: боль очищает мой разум от видений, что терзают меня. И среди Братьев Луа эта практика не считается такой постыдной, как может казаться в вашей культуре. Могу поклясться всем, что мне дорого, что я не утаю ни одной тайны.",shape=box,color=blue];
		1240 -> 1245;
	1239 [label="Это сложная тема, ведь причины, по которым я терзаю собственную плоть, не сводятся к одной. Я уже говорил тебе о видениях, что мучают меня, и о том, что боль проясняет мой разум. Но сам по себе этот акт куда менее табуирован, чем ты мог бы думать.",shape=box,color=blue];
		1239 -> 1244;
	1238 [label="Это сложная тема, поскольку причины, по которым я терзаю себя, не единичны. Должен начать с того, что эта тема далеко не так табуирована, как может показаться тебе в наши дни.",shape=box,color=blue];
		1238 -> 1244;
	1246 [label="Я не считаю, что то, что я делаю, \"правильно\". Я не считаю, что это следует практиковать другим. Я не считаю, что в этом есть что‑то достойное зависти.",shape=box,color=blue];
		1246 -> 1251;
	1242 [label="-Ф. Лион Аллард",shape=box,color=blue];
		1242 -> 1247;
	1243 [label="Во-вторых, я должен похвалить тебя за смелость написать мне эти слова. Было бы проще избежать их. Ты этого не сделал.",shape=box,color=blue];
		1243 -> 1248;
	1245 [label="Если ты считаешь, что мое желание причинять себе боль вызвано глубокой и тяжёлой внутренней неприязнью, я с радостью развею эти страхи.",shape=box,color=blue];
		1245 -> 1250;
	1244 [label="Среди Братьев Луа существует древняя практика бичевания. Она редка, и даже в мои времена считалась архаичной, её применяли лишь те, кого называли \"одарёнными её видениями\".",shape=box,color=blue];
		1244 -> 1249;
	1251 [label="Однако для меня это — в моем невероятно уникальном и довольно «сверхъестественном» в самом буквальном смысле слова состоянии — также не является строго опасным.",shape=box,color=blue];
		1251 -> 1256;
	1247 [label="Update boolean LyonSpeech",color=orange];
		1247 -> 1252;
	1248 [label="В‑третьих, я не понимаю и никогда не смогу понять, весь контекст того, что пережил твой компаньон. И, в каком‑то смысле, никто, кроме них самих, никогда не сможет.",shape=box,color=blue];
		1248 -> 1253;
	1250 [label="Хотя я... знаю эту великую меланхолию, она не вдохновляет моё кадило. Мари, например, никогда бы этого не допустила.",shape=box,color=blue];
		1250 -> 1255;
	1249 [label="Один из Отцов в Соборе научил меня этому вскоре после моего прибытия, когда он заметил, что я тоже… “одарён”, и счёл нужным мне помочь. ",shape=box,color=blue];
		1249 -> 1254;
	1256 [label="Я нередко задумывался, не существует ли какого‑нибудь современного чуда науки, что могло бы помочь мне с моими недугами. Будь я в состоянии принять такую помощь, я бы принял её. Но теперь я сомневаюсь, что моя физиология вообще позволила бы это.",shape=box,color=blue];
		1256 -> 1261;
	1252 [label="Chat ends.",color=orange];
	1253 [label="Страдать таким всепоглощающим образом, по определению, значит быть одиноким.",shape=box,color=blue];
		1253 -> 1257;
	1255 [label="Update boolean LyonSNo",color=orange];
		1255 -> 1260;
		1255 -> 1259;
		1255 -> 1258;
	1254 [label="Update boolean LyonLecture2",color=orange];
		1254 -> 1258;
		1254 -> 1259;
		1254 -> 1260;
	1261 [label="В любом случае, уверяю тебя, я от этого не умру. Это ноша, что лежит на мне с детства. И это симптом, который, как я решил, лучше, чем гноящаяся рана, если я не буду сдирать корочку.",shape=box,color=blue];
		1261 -> 1264;
	1257 [label="Я лишь молюсь своему богу, и твоему, и их богам, чтобы тебе не пришлось носить в сердце вину. Ибо если что-то в этом мире или в любом другом и заслуживает прощения, так это доброта знакомства с тем, кто так страдал.",shape=box,color=blue];
		1257 -> 1262;
	1260 [label="И ты думаешь, что никогда… не зайдёшь слишком далеко?",shape=box,color=red];
		1260 -> 1231;
	1259 [label="Меня поражает, насколько странными порой могут быть религиозные обряды.",shape=box,color=red];
		1259 -> 1263;
	1258 [label="Думаю, это меня немного успокоит.",shape=box,color=red];
		1258 -> 1231;
	1264 [label="Check boolean LyonSNo",color=orange];
		1264 -> 1267 [label=true,color=green];
		1264 -> 1268 [label=false,color=brown];
	1262 [label="+15 Chemistry",color=orange];
		1262 -> 1265;
	1263 [label="Я не вижу смысла спорить с тобой. Меня интересуют различия в религиозных обрядах. Мне очень нравится изучать все связанные с ними документы.",shape=box,color=blue];
		1263 -> 1266;
	1267 [label="+10 Chemistry",color=orange];
		1267 -> 1271;
	1268 [label="Если ты считаешь, что мое желание причинять себе боль вызвано глубокой и тяжёлой внутренней неприязнью, я с радостью развею эти страхи.",shape=box,color=blue];
		1268 -> 1272;
	1265 [label="Будь здоров, Скиталец. Мы ещё поговорим.",shape=box,color=blue];
		1265 -> 1269;
	1266 [label="Религиозная антропология - тема, которая мне особенно близка. Изучая обряды народа и общества, можно узнать о них очень многое. ",shape=box,color=blue];
		1266 -> 1270;
	1271 [label="Однако одно я тебе обещаю: если когда-нибудь я действительно испытаю страх, что больше не могу доверять самому себе, я скажу об этом.",shape=box,color=blue];
		1271 -> 1275;
	1272 [label="Хотя я... знаю эту великую меланхолию, она не вдохновляет моё кадило. Мари, например, никогда бы этого не допустила.",shape=box,color=blue];
		1272 -> 1267;
	1269 [label="-Ф. Лион Аллард",shape=box,color=blue];
		1269 -> 1273;
	1270 [label="На далёком замёрзшем севере есть секта Светил, что поклоняется трупу, выкопанному ими из отступающего ледника. Он был идеально сохранён, и никто не знает, насколько он древний. Но на его шее висел латунный диск с выбитым изображением солнца.",shape=box,color=blue];
		1270 -> 1274;
	1275 [label="Для Мари, для тебя, для М. Лойда, даже для Роут это не будет иметь значения. Я произнесу слова. В этом я клянусь.",shape=box,color=blue];
		1275 -> 1277;
		1275 -> 1278;
	1273 [label="Chat ends.",color=orange];
	1274 [label="Они верят, что это мумфицированное тело принадлежит самому Солу. И верят, что однажды он вновь оживёт и восстанет. Каждые сто лет они готовятся к \"Великому Сочельнику\", и многие из их последователей накануне принимают отравленное вино.",shape=box,color=blue];
		1274 -> 1276;
	1277 [label="Это всё, о чём мне нужно было просить. Спасибо, Лион.",shape=box,color=red];
		1277 -> 1280;
	1278 [label="Я тебе доверяю. Я просто хотелось пройти через это вместе с тобой.",shape=box,color=red];
		1278 -> 1280;
	1276 [label="Само собой разумеется, когда на следующее утро их мумифицированное тело не вернулось, у них появилась вполне веская причина, по которой их расчеты оказались неверными, и дата была сдвинута еще на столетие или около того.",shape=box,color=blue];
		1276 -> 1279;
	1280 [label="И я глубоко ценю твоё желание убедиться, что мной не движет какой‑то безудержный порыв к самоуничтожению.",shape=box,color=blue];
		1280 -> 1281;
	1279 [label="Но я довольно далеко отклонился от темы.",shape=box,color=blue];
		1279 -> 1241;
	1281 [label="Я не привык иметь в своей жизни таких спутников.",shape=box,color=blue];
		1281 -> 1282;
	1282 [label="Будь здоров, Скиталец. Мы ещё поговорим.",shape=box,color=blue];
		1282 -> 1283;
	1283 [label="-Ф. Лион Аллард",shape=box,color=blue];
		1283 -> 1284;
	1284 [label="Chat ends.",color=orange];
}