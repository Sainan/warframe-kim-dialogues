digraph {
	1180 [label="LyonRank4Convo6 begins.",color=orange];
		1180 -> 1181;
	1181 [label="Evaluate expressions",color=orange];
		1181 -> 2232 [label="LyonPainOff",color=purple];
		1181 -> 1186 [label="DrifterHarmHelp",color=purple];
		1181 -> 1183 [label="DrifterHarmHelp",color=purple];
		1181 -> 1182 [label="DrifterHarmHelp",color=purple];
		1181 -> 1186 [label="DrifterHarmStop",color=purple];
