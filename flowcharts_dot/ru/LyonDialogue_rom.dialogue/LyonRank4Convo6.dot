		j1596835387 -> j1087468627 [label="DrifterHarmStop",color=purple];
		j1596835387 -> j1310452999 [label="DrifterHarmStop",color=purple];
		j1596835387 -> j2399152914 [label="DrifterHarmLoss",color=purple];
		j1596835387 -> j1087468627 [label="DrifterHarmLoss",color=purple];
		j1596835387 -> j1310452999 [label="DrifterHarmLoss",color=purple];
		j1596835387 -> j1017398503 [label="false",color=purple];
		j1596835387 -> j2413587000 [label="false",color=purple];
		j1596835387 -> j1087468627 [label="false",color=purple];
		j1596835387 -> j1310452999 [label="false",color=purple];
	j3542996977 [label="+20 Chemistry",color=orange];
		j3542996977 -> j2953563043;
	j2399152914 [label="Лион, мы с Мари говорили о твоих… привычках и хотелось бы узнать, можем ли мы поговорить?",shape=box,color=red];
		j2399152914 -> j175627238;
	j1087468627 [label="[Отключить разговоры о самоповреждении. При этом никакой потери химии с Лионом или любым другим персонажем не произойдёт.]",shape=box,color=red];
		j1087468627 -> j492667283;
	j1310452999 [label="[Конец.]",shape=box,color=red];
		j1310452999 -> "Chat ends.";
	j1017398503 [label="Лион? Можем ли мы поговорить о чём‑то, что может быть… немного неприятно для тебя?",shape=box,color=red];
		j1017398503 -> j2294880752;
	j2413587000 [label="Лион, мне было интересно, могу ли я поговорить с тобой о том, почему ты… эм… навредил себе, если ты не против?",shape=box,color=red];
		j2413587000 -> j3227346665;
	j2953563043 [label="[Разговор пропущен из-за ранее установленного предупреждения.]",shape=box,color=blue];
		j2953563043 -> "Chat ends.";
	j175627238 [label="Она сказала мне, что вы двое говорили — да, разумеется. Ты можешь удивиться, но меня куда меньше тревожит разговор об этой моей особенности, чем можно было бы ожидать.",shape=box,color=blue];
		j175627238 -> j219539187;
	j492667283 [label="Boolean LyonPainOff is now true.",color=orange];
		j492667283 -> j1025645885;
	"Chat ends." [color=orange];
	j2294880752 [label="Ты можешь спросить, хотя я оставляю за собой право прекратить разговор, если почувствую, что он заходит в область обсуждения, в которой я больше не хочу участвовать. ",shape=box,color=blue];
		j2294880752 -> j883391258;
	j3227346665 [label="Хм. Честно говоря, я удивлён, что тебе понадобилось столько времени, чтобы поинтересоваться этой моей особенностью. Обычно именно она вызывает у людей наибольший отклик.",shape=box,color=blue];
		j3227346665 -> j1222632098;
	j219539187 [label="Обычно именно это люди замечают прежде всего. Либо из тревоги, либо из отвращения, либо из мрачного любопытства.",shape=box,color=blue];
		j219539187 -> j897187574;
	j1025645885 [label="Если ты считаешь себя трусом, сделав этот выбор, умоляю тебя – не делай этого. Ибо это боль, с которой тебе не справиться. Она моя. Тебе не хотелось терпеть этот момент.",shape=box,color=blue];
		j1025645885 -> j2593058450;
	j883391258 [label="Речь о том, что ты иногда причиняешь себе боль. Мне просто хотелось подойти к этому осторожно, вот и всё.",shape=box,color=red];
		j883391258 -> j3096865269;
	j1222632098 [label="Либо из-за беспокойства, либо отвращения, либо той самой мрачной любопытности, что заставляет кого-то заглядывать сквозь решётки клетки безумца. Интересно, а ты кто?",shape=box,color=blue];
		j1222632098 -> j104440917;
		j1222632098 -> j1168379128;
		j1222632098 -> j196405507;
		j1222632098 -> j142344293;
	j897187574 [label="Evaluate expressions",color=orange];
		j897187574 -> j104440917 [label="LyonBackstory3a",color=purple];
		j897187574 -> j1662866165 [label="LyonBackstory3a",color=purple];
		j897187574 -> j104440917 [label="LyonBackstory3b",color=purple];
		j897187574 -> j1662866165 [label="LyonBackstory3b",color=purple];
		j897187574 -> j104440917 [label="DrifterHarmHelp",color=purple];
		j897187574 -> j196405507 [label="DrifterHarmHelp",color=purple];
		j897187574 -> j104440917 [label="DrifterHarmStop",color=purple];
		j897187574 -> j142344293 [label="DrifterHarmStop",color=purple];
		j897187574 -> j104440917 [label="DrifterHarmLoss",color=purple];
		j897187574 -> j1168379128 [label="DrifterHarmLoss",color=purple];
		j897187574 -> j104440917 [label="false",color=purple];
	j2593058450 [label="Это механическое приспособление, за которым мы сидим, создаёт впечатление скрытой безличности. Мы словно защищённы от любого вреда, который может причинить нам другой человек, какими бы словами он нам ни писал.",shape=box,color=blue];
		j2593058450 -> j2399057981;
	j3096865269 [label="+5 Chemistry",color=orange];
		j3096865269 -> j575670327;
	j104440917 [label="Извини, но, если подумать, я не могу этого сделать. [Конец.]",shape=box,color=red];
		j104440917 -> j1025645885;
	j1168379128 [label="[Предупреждение: разговор о самоубийстве.] Мне… однажды пришлось потерять кого‑то из‑за такой вот “привычки”, и я...",shape=box,color=red];
		j1168379128 -> j1052811822;
	j196405507 [label="Я просто хочу тебе помочь. Убедиться, что с тобой всё в порядке. Вот и всё.",shape=box,color=red];
		j196405507 -> j4278740242;
	j142344293 [label="Мне просто кажется, что это нездорово и это нужно прекратить. ",shape=box,color=red];
		j142344293 -> j759567528;
	j1662866165 [label="Я знаю, ты говорил, что причинял себе боль ещё до сыворотки, но… не могу представить, чтобы она сделала это лучше.",shape=box,color=red];
		j1662866165 -> j1564145486;
	j2399057981 [label="Я бы, пожалуй, утверждал обратное - обнаженные от тех доспехов, что мы надеваем в будничных обстоятельствах общения, мы оказываемся лишены того, что могло бы нас защитить.",shape=box,color=blue];
		j2399057981 -> j405641072;
	j575670327 [label="Я… ценю ту деликатность, с которой ты поднимаешь этот вопрос, Странник. Спасибо. Но я уже привык, что эта тема нередко становится предметом обсуждения. Будь то из заботы, отвращения или мрачного любопытства. Хотя, уже понятно, что речь у тебя о первом.",shape=box,color=blue];
		j575670327 -> j104440917;
		j575670327 -> j1168379128;
		j575670327 -> j196405507;
		j575670327 -> j142344293;
	j1052811822 [label="Boolean DrifterHarmLoss is now true.",color=orange];
		j1052811822 -> j3154718495;
	j4278740242 [label="Boolean DrifterHarmHelp is now true.",color=orange];
		j4278740242 -> j4131174356;
	j759567528 [label="Boolean DrifterHarmStop is now true.",color=orange];
		j759567528 -> j1627669581;
	j1564145486 [label="Нет, боюсь, что нет. Она взяла то, что было… необходимостью, чтобы очистить мой разум от видений, что терзали меня, и превратила это в необходимость ради того, чтобы владеть “даром\" этой сыворотки.",shape=box,color=blue];
		j1564145486 -> j1670201464;
	j405641072 [label="Поэтому в подобных ситуациях... я прекрасно понимаю, что выпускаю стрелу, которая может попасть не в готового к бою солдата, а в яремную вену ничего не подозревающего оленя в чаще леса.",shape=box,color=blue];
		j405641072 -> j1493655784;
	j3154718495 [label="О, мой друг… нет таких слов, которыми я мог бы выразить всё своё сочувствие к тому, через что тебе пришлось пройти.",shape=box,color=blue];
		j3154718495 -> j1688060559;
	j4131174356 [label="Check boolean LyonAllRight",color=orange];
		j4131174356 -> j1747394751 [label=true,color=green];
		j4131174356 -> j1858202815 [label=false,color=brown];
	j1627669581 [label="Боюсь, ты опоздал на несколько лет и на одну сыворотку протофрейма, чтобы положить конец этой моей… склонности. Полагаю, теперь это скорее необходимость, не так ли?",shape=box,color=blue];
		j1627669581 -> j2875782325;
	j1670201464 [label="+5 Chemistry",color=orange];
		j1670201464 -> j1520824962;
	j1493655784 [label="И потому я оставлю тебя вот с чем:",shape=box,color=blue];
		j1493655784 -> j1095137912;
	j1688060559 [label="В такие моменты язык кажется ничтожным. Мы стараемся использовать его как можно лучше, но он всегда нас подводит.",shape=box,color=blue];
		j1688060559 -> j2038776010;
	j1747394751 [label="Я снова стараюсь не смеяться над мыслью о том, что я всё ещё приближаюсь к понятию «всё в порядке». Но я очень ценю твоё чувство, Скиталец.",shape=box,color=blue];
		j1747394751 -> j833720367;
	j1858202815 [label="Я стараюсь не смеяться над мыслью о том, что я всё ещё приближаюсь к понятию «всё в порядке». Но я очень ценю твоё чувство, Скиталец.",shape=box,color=blue];
		j1858202815 -> j833720367;
	j2875782325 [label="+5 Chemistry",color=orange];
		j2875782325 -> j1558191601;
	j1520824962 [label="Если раньше у меня ещё была возможность избавиться от своей склонности к самоповреждению, то, думаю, объединение с варфреймом \"Харроу\" сделало это теперь совершенно невозможным.",shape=box,color=blue];
		j1520824962 -> j3317662816;
	j1095137912 [label="Мы должны напоминать себе, как найти в себе силы поднять другого человека на ноги, даже когда едва способны подняться сами.",shape=box,color=blue];
		j1095137912 -> j1817689922;
	j2038776010 [label="Если ты позволишь, в свете твоего признания я мог бы сделать три вещи.",shape=box,color=blue];
		j2038776010 -> j2568526503;
	j833720367 [label="+5 Chemistry",color=orange];
		j833720367 -> j2301919822;
		j833720367 -> j3417204562;
	j1558191601 [label="Но я не хочу быть столь легкомысленным, ведь, как мне кажется, ты выражаешь заботу о моём физическом и ментальном состоянии, прости. Я просто не думаю, что способен это прекратить.",shape=box,color=blue];
		j1558191601 -> j2301919822;
		j1558191601 -> j3417204562;
	j3317662816 [label="Если позволишь мне выразиться грубо, Скиталец, я не думаю, что теперь вообще способен нанести себе какой‑либо настоящий, необратимый вред подобным образом.",shape=box,color=blue];
		j3317662816 -> j4221839729;
	j1817689922 [label="В этом и есть истинный смысл истории.",shape=box,color=blue];
		j1817689922 -> j246965765;
	j2568526503 [label="Во‑первых, хочу заверить тебя, что я в полной безопасности. Если ты думаешь, что моё стремление причинять себе боль вызвано глубокой и тяжёлой внутренней неприязнью, я с радостью развею эти страхи.",shape=box,color=blue];
		j2568526503 -> j261520661;
	j2301919822 [label="Могу я спросить, почему ты это делаешь?",shape=box,color=red];
		j2301919822 -> j3106172300;
	j3417204562 [label="Я просто боюсь, что однажды ты зайдёшь слишком далеко.",shape=box,color=red];
		j3417204562 -> j3317662816;
	j4221839729 [label="Хотя я не способен на высокомерие, необходимое, чтобы считать себя неуязвимым, такой поступок кажется... скажем так... частью замысла.",shape=box,color=blue];
		j4221839729 -> j1125902964;
	j246965765 [label="+20 Chemistry",color=orange];
		j246965765 -> j2234901523;
	j261520661 [label="Хотя… я знаю эту глубокую меланхолию, она вовсе не вдохновляет моё кадило. (Да и Мари этого бы никогда не позволила. Скорее уж она скормит его мне, чем подпустит меня к нему снова.)",shape=box,color=blue];
		j261520661 -> j325234205;
	j3106172300 [label="Evaluate expressions",color=orange];
		j3106172300 -> j698706002 [label="LyonBackstory3a & LyonLecture2",color=purple];
		j3106172300 -> j698706002 [label="LyonBackstory3b & LyonLecture2",color=purple];
		j3106172300 -> j2297577348 [label="LyonBackstory3a",color=purple];
		j3106172300 -> j2297577348 [label="LyonBackstory3b",color=purple];
		j3106172300 -> j2532791144 [label="false",color=purple];
	j1125902964 [label="+5 Chemistry",color=orange];
		j1125902964 -> j645144125;
	j2234901523 [label="Будь здоров, Скиталец. Скоро мы снова поговорим.",shape=box,color=blue];
		j2234901523 -> j2896744794;
	j325234205 [label="Но никогда ещё столь глубокая боль не нашептывала мне по ночам, мой друг. В этом я могу тебе поклясться. В этом я клянусь тебе всем, что мне дорого.",shape=box,color=blue];
		j325234205 -> j287213909;
	j698706002 [label="Я сказал тебе правду о том, что побуждает меня к этому: боль очищает мой разум от видений, что терзают меня. И среди Братьев Луа эта практика не считается такой постыдной, как может казаться в вашей культуре. Могу поклясться всем, что мне дорого, что я не утаю ни одной тайны.",shape=box,color=blue];
		j698706002 -> j2804324518;
	j2297577348 [label="Это сложная тема, ведь причины, по которым я терзаю собственную плоть, не сводятся к одной. Я уже говорил тебе о видениях, что мучают меня, и о том, что боль проясняет мой разум. Но сам по себе этот акт куда менее табуирован, чем ты мог бы думать.",shape=box,color=blue];
		j2297577348 -> j2103935802;
	j2532791144 [label="Это сложная тема, поскольку причины, по которым я терзаю себя, не единичны. Должен начать с того, что эта тема далеко не так табуирована, как может показаться тебе в наши дни.",shape=box,color=blue];
		j2532791144 -> j2103935802;
	j645144125 [label="Я не считаю, что то, что я делаю, \"правильно\". Я не считаю, что это следует практиковать другим. Я не считаю, что в этом есть что‑то достойное зависти.",shape=box,color=blue];
		j645144125 -> j118927264;
	j2896744794 [label="-Ф. Лион Аллард",shape=box,color=blue];
		j2896744794 -> j3787621160;
	j287213909 [label="Во-вторых, я должен похвалить тебя за смелость написать мне эти слова. Было бы проще избежать их. Ты этого не сделал.",shape=box,color=blue];
		j287213909 -> j1922276424;
	j2804324518 [label="Если ты считаешь, что мое желание причинять себе боль вызвано глубокой и тяжёлой внутренней неприязнью, я с радостью развею эти страхи.",shape=box,color=blue];
		j2804324518 -> j3525366093;
	j2103935802 [label="Среди Братьев Луа существует древняя практика бичевания. Она редка, и даже в мои времена считалась архаичной, её применяли лишь те, кого называли \"одарёнными её видениями\".",shape=box,color=blue];
		j2103935802 -> j3725895454;
	j118927264 [label="Однако для меня это — в моем невероятно уникальном и довольно «сверхъестественном» в самом буквальном смысле слова состоянии — также не является строго опасным.",shape=box,color=blue];
		j118927264 -> j46132946;
	j3787621160 [label="Boolean LyonSpeech is now true.",color=orange];
		j3787621160 -> "Chat ends.";
	j1922276424 [label="В‑третьих, я не понимаю и никогда не смогу понять, весь контекст того, что пережил твой компаньон. И, в каком‑то смысле, никто, кроме них самих, никогда не сможет.",shape=box,color=blue];
		j1922276424 -> j1105096948;
	j3525366093 [label="Хотя я... знаю эту великую меланхолию, она не вдохновляет моё кадило. Мари, например, никогда бы этого не допустила.",shape=box,color=blue];
		j3525366093 -> j1956864042;
	j3725895454 [label="Один из Отцов в Соборе научил меня этому вскоре после моего прибытия, когда он заметил, что я тоже… “одарён”, и счёл нужным мне помочь. ",shape=box,color=blue];
		j3725895454 -> j2632916461;
	j46132946 [label="Я нередко задумывался, не существует ли какого‑нибудь современного чуда науки, что могло бы помочь мне с моими недугами. Будь я в состоянии принять такую помощь, я бы принял её. Но теперь я сомневаюсь, что моя физиология вообще позволила бы это.",shape=box,color=blue];
		j46132946 -> j4170182776;
	j1105096948 [label="Страдать таким всепоглощающим образом, по определению, значит быть одиноким.",shape=box,color=blue];
		j1105096948 -> j674520968;
	j1956864042 [label="Boolean LyonSNo is now true.",color=orange];
		j1956864042 -> j76467446;
		j1956864042 -> j750858181;
		j1956864042 -> j3165083775;
	j2632916461 [label="Boolean LyonLecture2 is now true.",color=orange];
		j2632916461 -> j3165083775;
		j2632916461 -> j750858181;
		j2632916461 -> j76467446;
	j4170182776 [label="В любом случае, уверяю тебя, я от этого не умру. Это ноша, что лежит на мне с детства. И это симптом, который, как я решил, лучше, чем гноящаяся рана, если я не буду сдирать корочку.",shape=box,color=blue];
		j4170182776 -> j1511931022;
	j674520968 [label="Я лишь молюсь своему богу, и твоему, и их богам, чтобы тебе не пришлось носить в сердце вину. Ибо если что-то в этом мире или в любом другом и заслуживает прощения, так это доброта знакомства с тем, кто так страдал.",shape=box,color=blue];
		j674520968 -> j1001673768;
	j76467446 [label="И ты думаешь, что никогда… не зайдёшь слишком далеко?",shape=box,color=red];
		j76467446 -> j3317662816;
	j750858181 [label="Меня поражает, насколько странными порой могут быть религиозные обряды.",shape=box,color=red];
		j750858181 -> j2450969514;
	j3165083775 [label="Думаю, это меня немного успокоит.",shape=box,color=red];
		j3165083775 -> j3317662816;
	j1511931022 [label="Check boolean LyonSNo",color=orange];
		j1511931022 -> j3591233003 [label=true,color=green];
		j1511931022 -> j1894711453 [label=false,color=brown];
	j1001673768 [label="+15 Chemistry",color=orange];
		j1001673768 -> j1944120655;
	j2450969514 [label="Я не вижу смысла спорить с тобой. Меня интересуют различия в религиозных обрядах. Мне очень нравится изучать все связанные с ними документы.",shape=box,color=blue];
		j2450969514 -> j3268465366;
	j3591233003 [label="+10 Chemistry",color=orange];
		j3591233003 -> j2328576053;
	j1894711453 [label="Если ты считаешь, что мое желание причинять себе боль вызвано глубокой и тяжёлой внутренней неприязнью, я с радостью развею эти страхи.",shape=box,color=blue];
		j1894711453 -> j1634030456;
	j1944120655 [label="Будь здоров, Скиталец. Мы ещё поговорим.",shape=box,color=blue];
		j1944120655 -> j1542260442;
	j3268465366 [label="Религиозная антропология - тема, которая мне особенно близка. Изучая обряды народа и общества, можно узнать о них очень многое. ",shape=box,color=blue];
		j3268465366 -> j534118769;
	j2328576053 [label="Однако одно я тебе обещаю: если когда-нибудь я действительно испытаю страх, что больше не могу доверять самому себе, я скажу об этом.",shape=box,color=blue];
		j2328576053 -> j2912643542;
	j1634030456 [label="Хотя я... знаю эту великую меланхолию, она не вдохновляет моё кадило. Мари, например, никогда бы этого не допустила.",shape=box,color=blue];
		j1634030456 -> j3591233003;
	j1542260442 [label="-Ф. Лион Аллард",shape=box,color=blue];
		j1542260442 -> "Chat ends.";
	j534118769 [label="На далёком замёрзшем севере есть секта Светил, что поклоняется трупу, выкопанному ими из отступающего ледника. Он был идеально сохранён, и никто не знает, насколько он древний. Но на его шее висел латунный диск с выбитым изображением солнца.",shape=box,color=blue];
		j534118769 -> j597291250;
	j2912643542 [label="Для Мари, для тебя, для М. Лойда, даже для Роут это не будет иметь значения. Я произнесу слова. В этом я клянусь.",shape=box,color=blue];
		j2912643542 -> j2883944204;
		j2912643542 -> j3852330539;
	j597291250 [label="Они верят, что это мумфицированное тело принадлежит самому Солу. И верят, что однажды он вновь оживёт и восстанет. Каждые сто лет они готовятся к \"Великому Сочельнику\", и многие из их последователей накануне принимают отравленное вино.",shape=box,color=blue];
		j597291250 -> j209383641;
	j2883944204 [label="Это всё, о чём мне нужно было просить. Спасибо, Лион.",shape=box,color=red];
		j2883944204 -> j916005931;
	j3852330539 [label="Я тебе доверяю. Я просто хотелось пройти через это вместе с тобой.",shape=box,color=red];
		j3852330539 -> j916005931;
	j209383641 [label="Само собой разумеется, когда на следующее утро их мумифицированное тело не вернулось, у них появилась вполне веская причина, по которой их расчеты оказались неверными, и дата была сдвинута еще на столетие или около того.",shape=box,color=blue];
		j209383641 -> j3713015664;
	j916005931 [label="И я глубоко ценю твоё желание убедиться, что мной не движет какой‑то безудержный порыв к самоуничтожению.",shape=box,color=blue];
		j916005931 -> j1523287870;
	j3713015664 [label="Но я довольно далеко отклонился от темы.",shape=box,color=blue];
		j3713015664 -> j1125902964;
	j1523287870 [label="Я не привык иметь в своей жизни таких спутников.",shape=box,color=blue];
		j1523287870 -> j1944120655;
}