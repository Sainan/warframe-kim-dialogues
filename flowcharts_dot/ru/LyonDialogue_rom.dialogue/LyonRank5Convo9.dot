digraph {
	graph [fontname="Roboto Condensed"];
	node [fontname="Roboto Condensed"];
	edge [fontname="Roboto Condensed"];

	"LyonRank5Convo9 begins." [color=orange];
		"LyonRank5Convo9 begins." -> j3594191379;
	j3594191379 [label="Evaluate expressions",color=orange];
		j3594191379 -> "Chat ends." [label="LyonDating & LyonDatingConfession",color=purple];
		j3594191379 -> j3894252074 [label="LyonDating",color=purple];
		j3594191379 -> "Chat ends." [label="false",color=purple];
	"Chat ends." [color=orange];
	j3894252074 [label="Mon miracle, я... должен быть совершенно уверен, что тебе кое-что понятно, прежде чем я расскажу тебе свой следующий анекдот. ",shape=box,color=blue];
		j3894252074 -> j905075933;
	j905075933 [label="Для меня важно, чтобы тобой было уделено очень пристальное внимание этим следующим словам, которые я отправлю. Понимаешь?",shape=box,color=blue];
		j905075933 -> j1882874522;
		j905075933 -> j903704445;
	j1882874522 [label="Ты заставляешь меня нервничать. Что не так?",shape=box,color=red];
		j1882874522 -> j3313584624;
	j903704445 [label="Да, я здесь. Говори.",shape=box,color=red];
		j903704445 -> j3837068867;
	j3313584624 [label="В этом нет ничего плохого - совсем наоборот. Именно это так важно понять - ужасные последствия, от которых я хочу тебя избавить, если ты предполагаешь, что они могут последовать.",shape=box,color=blue];
		j3313584624 -> j4131378047;
		j3313584624 -> j3956327082;
		j3313584624 -> j834893883;
	j3837068867 [label="+5 Chemistry",color=orange];
		j3837068867 -> j15717433;
	j4131378047 [label="Я слушаю.",shape=box,color=red];
		j4131378047 -> j3206270105;
	j3956327082 [label="В твоих словах не так много смысла.",shape=box,color=red];
		j3956327082 -> j2062069796;
	j834893883 [label="Ужасные последствия... что?",shape=box,color=red];
		j834893883 -> j200774946;
	j15717433 [label="Спасибо. Прежде чем я начну, я хочу заверить, что здесь нет ничего плохого - однако, возможно, в этом и кроются ужасные последствия, от которых я хотел бы тебя избавить, если тебе кажется, что они могут быть.",shape=box,color=blue];
		j15717433 -> j4131378047;
		j15717433 -> j3956327082;
		j15717433 -> j834893883;
	j3206270105 [label="+5 Chemistry",color=orange];
		j3206270105 -> j3436932806;
	j2062069796 [label="Да. Я с болью осознаю это.",shape=box,color=blue];
		j2062069796 -> j200774946;
	j200774946 [label="Позволь мне начать сначала.",shape=box,color=blue];
		j200774946 -> j3436932806;
	j3436932806 [label="Я осознаю, что многие могут истолковать мои слова так, что я, на самом деле, вполне могу оказаться... нездоров. По крайней мере, я не совсем в здравом уме.",shape=box,color=blue];
		j3436932806 -> j3383310290;
	j3383310290 [label="Я уже давно примирился с этим. Это меня больше не беспокоит. Видения, которые преследуют меня, - голоса - я научился жить с ними без страха и ненависти.",shape=box,color=blue];
		j3383310290 -> j3310297304;
	j3310297304 [label="(В последнее время, я думаю, немного назло, если быть честным, но это уже не суть важно.)",shape=box,color=blue];
		j3310297304 -> j2362723105;
	j2362723105 [label="Но я хочу, чтобы тебе было понято, что если ты прекратишь это между нами - эту связь, которую я считал ранее невозможной между мной и кем-либо другим -",shape=box,color=blue];
		j2362723105 -> j2800530590;
	j2800530590 [label="Если бы твоему сердцу было позволено когда-нибудь отдалится от моего? ",shape=box,color=blue];
		j2800530590 -> j2997738252;
	j2997738252 [label="Я буду терпеть, mon miracle.",shape=box,color=blue];
		j2997738252 -> j3411471189;
	j3411471189 [label="Я не поддамся тому, что мучило меня до сих пор. ",shape=box,color=blue];
		j3411471189 -> j2851720794;
	j2851720794 [label="Check boolean LyonAllRight",color=orange];
		j2851720794 -> j1174692719 [label=true,color=green];
		j2851720794 -> j78891551 [label=false,color=brown];
	j1174692719 [label="Я буду, выражаясь твоим языком, «в порядке». Я найду повод улыбнуться и посмеяться ещё раз.",shape=box,color=blue];
		j1174692719 -> j3971523205;
		j1174692719 -> j864402165;
	j78891551 [label="Я выживу. Со мной всё будет в порядке. Я найду причину улыбаться и смеяться ещё раз.",shape=box,color=blue];
		j78891551 -> j3971523205;
		j78891551 -> j864402165;
	j3971523205 [label="О, Лион... ты не обуза для меня.",shape=box,color=red];
		j3971523205 -> j2094237061;
	j864402165 [label="Ты... хочешь сказать, что хочешь положить конец отношениям между нами?",shape=box,color=red];
		j864402165 -> j2487247652;
	j2094237061 [label="Я просто пытаюсь избавить тебя от любых предполагаемых трудностей, которые возможно могли быть испытаны тобой из-за меня...",shape=box,color=blue];
		j2094237061 -> j2971895130;
		j2094237061 -> j49273098;
		j2094237061 -> j2118385730;
	j2487247652 [label="Нет! Что-нибудь в этом роде! Я просто пытаюсь избавить тебя от любых предполагаемых трудностей, которые у тебя могли возникнуть из-за меня.",shape=box,color=blue];
		j2487247652 -> j2971895130;
		j2487247652 -> j49273098;
		j2487247652 -> j2118385730;
	j2971895130 [label="Твоя боль... В какой-то мере перекликается с моей собственной. Мне никогда не составит труда помочь тебе справиться с этим.",shape=box,color=red];
		j2971895130 -> j2920626286;
	j49273098 [label="Я не могу описать, что привлекает меня в тебе. Но ты никогда не будешь для меня долгом или обузой.",shape=box,color=red];
		j49273098 -> j1519306016;
	j2118385730 [label="[Расстаться.] Прости, для меня это уже слишком. Возможно, было бы лучше покончить со всем этим прямо сейчас.",shape=box,color=red];
		j2118385730 -> j280516621;
	j2920626286 [label="Я не могу выразить, как сильно моё сердце разрывается из-за тебя. Но я бесконечно благодарен за то, что наши одинокие призраки боли нашли друг друга.",shape=box,color=blue];
		j2920626286 -> j988753420;
	j1519306016 [label="Которому я не могу должным образом выразить свою благодарность, и я не думаю, что какие-либо слова когда-либо смогут это сделать.",shape=box,color=blue];
		j1519306016 -> j988753420;
	j280516621 [label="Да. Конечно. Было бы... лицемерно принимать любой другой ответ на данный момент... ",shape=box,color=blue];
		j280516621 -> j3273922483;
	j988753420 [label="Но теперь, когда я приложил немало усилий, чтобы пройти через то, что было самым впечатляющим вступлением, потакающим своим желаниям...",shape=box,color=blue];
		j988753420 -> j3556522648;
		j988753420 -> j326120491;
		j988753420 -> j45864847;
	j3273922483 [label="Я всё понимаю. И я желаю тебе только самого лучшего. И я буду дорожить всеми моментами, которые мы провели вместе.",shape=box,color=blue];
		j3273922483 -> j742212706;
	j3556522648 [label="Для парня, который начинал с молчания, ты действительно стал многословным.",shape=box,color=red];
		j3556522648 -> j3297158027;
	j326120491 [label="Я нахожу их милыми, не волнуйся.",shape=box,color=red];
		j326120491 -> j3713508575;
	j45864847 [label="Ты мог бы просто сказать: «Знаешь, со мной всё будет в порядке, если наши пути когда-нибудь разойдутся».",shape=box,color=red];
		j45864847 -> j4164167634;
	j742212706 [label="Я буду помнить их в своей душе, даже если они исчезнут из моего сознания. Прощай.",shape=box,color=blue];
		j742212706 -> j1797470039;
	j3297158027 [label="+5 Chemistry",color=orange];
		j3297158027 -> j12359879;
	j3713508575 [label="+5 Chemistry",color=orange];
		j3713508575 -> j666987052;
	j4164167634 [label="+5 Chemistry",color=orange];
		j4164167634 -> j3941467294;
	j1797470039 [label="Boolean LyonDating is now false.",color=orange];
		j1797470039 -> j133216888;
	j12359879 [label="Ба! Если у тебя не было желания знать о том, что творится у меня в голове, тебе не следовало совать туда нос. В этом полностью твоя вина.",shape=box,color=blue];
		j12359879 -> j742207598;
	j666987052 [label="Я очень рад, что тебе нравятся мои странствия. Именно поэтому я предпочитаю говорить как можно меньше. Можешь себе представить, как я переживу это лично? Мари давным-давно расправилась бы со мной, как с бешеной собакой.",shape=box,color=blue];
		j666987052 -> j742207598;
	j3941467294 [label="В тебе, естественно, присутствует определённая доля непочтительности и сарказма, до которых я и не надеялся дойти. Я оставлю это на твоё усмотрение.",shape=box,color=blue];
		j3941467294 -> j742207598;
	j133216888 [label="Boolean IsDating is now false.",color=orange];
		j133216888 -> j3176698568;
	j742207598 [label="Тем не менее, всё это должно было послужить поводом для рассказа, который сейчас покажется тебе довольно коротким по сравнению с остальными...",shape=box,color=blue];
		j742207598 -> j931602219;
	j3176698568 [label="- Лион",shape=box,color=blue];
		j3176698568 -> "Chat ends.";
	j931602219 [label="Прошлой ночью я проснулся от кошмара. Когда я проснулся, меня окружили тени. В моем душевном состоянии нет ничего необычного или нового. Они нависали над моей кроватью и не хотели рассеиваться.",shape=box,color=blue];
		j931602219 -> j3252204079;
	j3252204079 [label="Я не боялся их, потому что знал, что они не могут причинить мне вреда. Однако и из головы они не выходили. Я знал только одно средство избавиться от них.",shape=box,color=blue];
		j3252204079 -> j395572744;
	j395572744 [label="Поднявшись с кровати, я оделся, как мог, пошатываясь, несмотря на расплывчатое видение продолжающегося кошмара. Я схватил свой Кадило и упал на колени посреди комнаты, приготовившись к... ну, в общем. ",shape=box,color=blue];
		j395572744 -> j3360441602;
	j3360441602 [label="Я приготовился «очистить свой разум». Оставим всё как есть.",shape=box,color=blue];
		j3360441602 -> j2561394980;
	j2561394980 [label="Но стоило мне закрыть глаза, как мой разум блуждал. Мои мысли блуждали... к тебе, mon miracle...",shape=box,color=blue];
		j2561394980 -> j656367988;
	j656367988 [label="Звук твоего голоса. Прикосновение твоей руки к моему плечу... ",shape=box,color=blue];
		j656367988 -> j2172221891;
	j2172221891 [label="И видения... исчезли. Они покинули свой пост, преследуемые более сильным призраком... тебя.",shape=box,color=blue];
		j2172221891 -> j2607761851;
	j2607761851 [label="Я... встал. Поставил кадило на прикроватный столик и... решил вместо этого пройтись по песку Санктума...",shape=box,color=blue];
		j2607761851 -> j3475500443;
		j2607761851 -> j4040057426;
	j3475500443 [label="Теперь я могу понять, почему тебе понадобилась эта преамбула.",shape=box,color=red];
		j3475500443 -> j1439743668;
	j4040057426 [label="Я не знаю, что сказать...",shape=box,color=red];
		j4040057426 -> j2882195793;
	j1439743668 [label="Да. Хорошо. Во время прогулки я... мгновенно осознал мрачную опасность такого момента. Что ты можешь... начать думать, что это ответственность - начать воспринимать меня как цепи, которые тянут тебя вниз.",shape=box,color=blue];
		j1439743668 -> j975012763;
	j2882195793 [label="+5 Chemistry",color=orange];
		j2882195793 -> j3770231734;
	j975012763 [label="Я прошу тебя - я молюсь всем богам, как небесным, так и земным - чтобы никогда этого тобой не совершалось. Это тобой преподнесенный мне подарок, и каждый раз я буду беречь его.",shape=box,color=blue];
		j975012763 -> j402432134;
	j3770231734 [label="Не нужно слов, mon miracle... ",shape=box,color=blue];
		j3770231734 -> j3198974278;
	j402432134 [label="Поклянись мне, mon miracle, что, если придёт время, я стану для тебя пустой клеткой... у тебя будет свобода от меня.",shape=box,color=blue];
		j402432134 -> j1210401330;
	j3198974278 [label="Во время прогулки я... мгновенно осознал мрачную опасность такого момента. Что ты можешь... начать думать, что это ответственность - начать воспринимать меня как цепи, которые тянут тебя вниз.",shape=box,color=blue];
		j3198974278 -> j975012763;
	j1210401330 [label="Я не стану пустой тюрьмой для тех, кого люблю. Не для тебя. Не для Мари.",shape=box,color=blue];
		j1210401330 -> j4206004526;
		j1210401330 -> j174580842;
	j4206004526 [label="[Расстаться.] Я - я не могу. Я не могу этого обещать, прости.",shape=box,color=red];
		j4206004526 -> j4233764437;
	j174580842 [label="Я клянусь в этом. ",shape=box,color=red];
		j174580842 -> j927200168;
	j4233764437 [label="+10 Chemistry",color=orange];
		j4233764437 -> j1585134072;
	j927200168 [label="+10 Chemistry",color=orange];
		j927200168 -> j1575702589;
	j1585134072 [label="Спасибо. Спасибо тебе, mon miracle, за твою честность. В тот момент это потребовало мужества, и я благодарю тебя за это.",shape=box,color=blue];
		j1585134072 -> j1453604479;
	j1575702589 [label="Спасибо. Спасибо тебе, mon miracle...",shape=box,color=blue];
		j1575702589 -> j3892523579;
	j1453604479 [label="Я буду дорожить всеми моментами, которые мы провели вместе. Это значит для меня больше, чем ты можешь себе представить.",shape=box,color=blue];
		j1453604479 -> j742212706;
	j3892523579 [label="Я вдруг почувствовал такую сильную усталость, как будто... с моих плеч свалился огромный груз. Боюсь, мне нужно прилечь.",shape=box,color=blue];
		j3892523579 -> j1420839340;
	j1420839340 [label="- Лион",shape=box,color=blue];
		j1420839340 -> j3446510588;
	j3446510588 [label="Boolean LyonDatingConfession is now true.",color=orange];
		j3446510588 -> "Chat ends.";
}