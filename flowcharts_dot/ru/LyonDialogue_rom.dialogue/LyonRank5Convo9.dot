digraph {
	2100 [label="LyonRank5Convo9 begins.",color=orange];
		2100 -> 2101;
	2101 [label="Evaluate expressions",color=orange];
		2101 -> 2102 [label="LyonDating, LyonDatingConfession",color=purple];
		2101 -> 2103 [label="LyonDating",color=purple];
		2101 -> 2102 [label="false",color=purple];
	2102 [label="Chat ends.",color=orange];
	2103 [label="Mon miracle, я... должен быть совершенно уверен, что тебе кое-что понятно, прежде чем я расскажу тебе свой следующий анекдот. ",shape=box,color=blue];
		2103 -> 2104;
	2104 [label="Для меня важно, чтобы тобой было уделено очень пристальное внимание этим следующим словам, которые я отправлю. Понимаешь?",shape=box,color=blue];
		2104 -> 2105;
		2104 -> 2106;
	2105 [label="Ты заставляешь меня нервничать. Что не так?",shape=box,color=red];
		2105 -> 2107;
	2106 [label="Да, я здесь. Говори.",shape=box,color=red];
		2106 -> 2108;
	2107 [label="В этом нет ничего плохого - совсем наоборот. Именно это так важно понять - ужасные последствия, от которых я хочу тебя избавить, если ты предполагаешь, что они могут последовать.",shape=box,color=blue];
		2107 -> 2109;
		2107 -> 2110;
		2107 -> 2111;
	2108 [label="+5 Chemistry",color=orange];
		2108 -> 2112;
	2109 [label="Я слушаю.",shape=box,color=red];
		2109 -> 2113;
	2110 [label="В твоих словах не так много смысла.",shape=box,color=red];
		2110 -> 2114;
	2111 [label="Ужасные последствия... что?",shape=box,color=red];
		2111 -> 2115;
	2112 [label="Спасибо. Прежде чем я начну, я хочу заверить, что здесь нет ничего плохого - однако, возможно, в этом и кроются ужасные последствия, от которых я хотел бы тебя избавить, если тебе кажется, что они могут быть.",shape=box,color=blue];
		2112 -> 2109;
		2112 -> 2110;
		2112 -> 2111;
	2113 [label="+5 Chemistry",color=orange];
		2113 -> 2116;
	2114 [label="Да. Я с болью осознаю это.",shape=box,color=blue];
		2114 -> 2115;
	2115 [label="Позволь мне начать сначала.",shape=box,color=blue];
		2115 -> 2116;
	2116 [label="Я осознаю, что многие могут истолковать мои слова так, что я, на самом деле, вполне могу оказаться... нездоров. По крайней мере, я не совсем в здравом уме.",shape=box,color=blue];
		2116 -> 2117;
	2117 [label="Я уже давно примирился с этим. Это меня больше не беспокоит. Видения, которые преследуют меня, - голоса - я научился жить с ними без страха и ненависти.",shape=box,color=blue];
		2117 -> 2118;
	2118 [label="(В последнее время, я думаю, немного назло, если быть честным, но это уже не суть важно.)",shape=box,color=blue];
		2118 -> 2119;
	2119 [label="Но я хочу, чтобы тебе было понято, что если ты прекратишь это между нами - эту связь, которую я считал ранее невозможной между мной и кем-либо другим -",shape=box,color=blue];
		2119 -> 2120;
	2120 [label="Если бы твоему сердцу было позволено когда-нибудь отдалится от моего? ",shape=box,color=blue];
		2120 -> 2121;
	2121 [label="Я буду терпеть, mon miracle.",shape=box,color=blue];
		2121 -> 2122;
	2122 [label="Я не поддамся тому, что мучило меня до сих пор. ",shape=box,color=blue];
		2122 -> 2123;
	2123 [label="Check boolean LyonAllRight",color=orange];
		2123 -> 2125 [label=true,color=green];
		2123 -> 2124 [label=false,color=brown];
	2125 [label="Я буду, выражаясь твоим языком, «в порядке». Я найду повод улыбнуться и посмеяться ещё раз.",shape=box,color=blue];
		2125 -> 2126;
		2125 -> 2127;
	2124 [label="Я выживу. Со мной всё будет в порядке. Я найду причину улыбаться и смеяться ещё раз.",shape=box,color=blue];
		2124 -> 2126;
		2124 -> 2127;
	2126 [label="О, Лион... ты не обуза для меня.",shape=box,color=red];
		2126 -> 2128;
	2127 [label="Ты... хочешь сказать, что хочешь положить конец отношениям между нами?",shape=box,color=red];
		2127 -> 2129;
	2128 [label="Я просто пытаюсь избавить тебя от любых предполагаемых трудностей, которые возможно могли быть испытаны тобой из-за меня...",shape=box,color=blue];
		2128 -> 2130;
		2128 -> 2131;
		2128 -> 2132;
	2129 [label="Нет! Что-нибудь в этом роде! Я просто пытаюсь избавить тебя от любых предполагаемых трудностей, которые у тебя могли возникнуть из-за меня.",shape=box,color=blue];
		2129 -> 2130;
		2129 -> 2131;
		2129 -> 2132;
	2130 [label="Твоя боль... В какой-то мере перекликается с моей собственной. Мне никогда не составит труда помочь тебе справиться с этим.",shape=box,color=red];
		2130 -> 2133;
	2131 [label="Я не могу описать, что привлекает меня в тебе. Но ты никогда не будешь для меня долгом или обузой.",shape=box,color=red];
		2131 -> 2134;
	2132 [label="[Расстаться.] Прости, для меня это уже слишком. Возможно, было бы лучше покончить со всем этим прямо сейчас.",shape=box,color=red];
		2132 -> 2135;
	2133 [label="Я не могу выразить, как сильно моё сердце разрывается из-за тебя. Но я бесконечно благодарен за то, что наши одинокие призраки боли нашли друг друга.",shape=box,color=blue];
		2133 -> 2136;
	2134 [label="Которому я не могу должным образом выразить свою благодарность, и я не думаю, что какие-либо слова когда-либо смогут это сделать.",shape=box,color=blue];
		2134 -> 2136;
	2135 [label="Да. Конечно. Было бы... лицемерно принимать любой другой ответ на данный момент... ",shape=box,color=blue];
		2135 -> 2137;
	2136 [label="Но теперь, когда я приложил немало усилий, чтобы пройти через то, что было самым впечатляющим вступлением, потакающим своим желаниям...",shape=box,color=blue];
		2136 -> 2138;
		2136 -> 2139;
		2136 -> 2140;
	2137 [label="Я всё понимаю. И я желаю тебе только самого лучшего. И я буду дорожить всеми моментами, которые мы провели вместе.",shape=box,color=blue];
		2137 -> 2141;
	2138 [label="Для парня, который начинал с молчания, ты действительно стал многословным.",shape=box,color=red];
		2138 -> 2142;
	2139 [label="Я нахожу их милыми, не волнуйся.",shape=box,color=red];
		2139 -> 2143;
	2140 [label="Ты мог бы просто сказать: «Знаешь, со мной всё будет в порядке, если наши пути когда-нибудь разойдутся».",shape=box,color=red];
		2140 -> 2144;
	2141 [label="Я буду помнить их в своей душе, даже если они исчезнут из моего сознания. Прощай.",shape=box,color=blue];
		2141 -> 2145;
	2142 [label="+5 Chemistry",color=orange];
		2142 -> 2146;
	2143 [label="+5 Chemistry",color=orange];
		2143 -> 2147;
	2144 [label="+5 Chemistry",color=orange];
		2144 -> 2148;
	2145 [label="Update boolean LyonDating",color=orange];
		2145 -> 2149;
	2146 [label="Ба! Если у тебя не было желания знать о том, что творится у меня в голове, тебе не следовало совать туда нос. В этом полностью твоя вина.",shape=box,color=blue];
		2146 -> 2150;
	2147 [label="Я очень рад, что тебе нравятся мои странствия. Именно поэтому я предпочитаю говорить как можно меньше. Можешь себе представить, как я переживу это лично? Мари давным-давно расправилась бы со мной, как с бешеной собакой.",shape=box,color=blue];
		2147 -> 2150;
	2148 [label="В тебе, естественно, присутствует определённая доля непочтительности и сарказма, до которых я и не надеялся дойти. Я оставлю это на твоё усмотрение.",shape=box,color=blue];
		2148 -> 2150;
	2149 [label="Update boolean IsDating",color=orange];
		2149 -> 2151;
	2150 [label="Тем не менее, всё это должно было послужить поводом для рассказа, который сейчас покажется тебе довольно коротким по сравнению с остальными...",shape=box,color=blue];
		2150 -> 2152;
	2151 [label="- Лион",shape=box,color=blue];
		2151 -> 2153;
	2152 [label="Прошлой ночью я проснулся от кошмара. Когда я проснулся, меня окружили тени. В моем душевном состоянии нет ничего необычного или нового. Они нависали над моей кроватью и не хотели рассеиваться.",shape=box,color=blue];
		2152 -> 2154;
	2153 [label="Chat ends.",color=orange];
	2154 [label="Я не боялся их, потому что знал, что они не могут причинить мне вреда. Однако и из головы они не выходили. Я знал только одно средство избавиться от них.",shape=box,color=blue];
		2154 -> 2155;
	2155 [label="Поднявшись с кровати, я оделся, как мог, пошатываясь, несмотря на расплывчатое видение продолжающегося кошмара. Я схватил свой Кадило и упал на колени посреди комнаты, приготовившись к... ну, в общем. ",shape=box,color=blue];
		2155 -> 2156;
	2156 [label="Я приготовился «очистить свой разум». Оставим всё как есть.",shape=box,color=blue];
		2156 -> 2157;
	2157 [label="Но стоило мне закрыть глаза, как мой разум блуждал. Мои мысли блуждали... к тебе, mon miracle...",shape=box,color=blue];
		2157 -> 2158;
	2158 [label="Звук твоего голоса. Прикосновение твоей руки к моему плечу... ",shape=box,color=blue];
		2158 -> 2159;
	2159 [label="И видения... исчезли. Они покинули свой пост, преследуемые более сильным призраком... тебя.",shape=box,color=blue];
		2159 -> 2160;
	2160 [label="Я... встал. Поставил кадило на прикроватный столик и... решил вместо этого пройтись по песку Санктума...",shape=box,color=blue];
		2160 -> 2161;
		2160 -> 2162;
	2161 [label="Теперь я могу понять, почему тебе понадобилась эта преамбула.",shape=box,color=red];
		2161 -> 2163;
	2162 [label="Я не знаю, что сказать...",shape=box,color=red];
		2162 -> 2164;
	2163 [label="Да. Хорошо. Во время прогулки я... мгновенно осознал мрачную опасность такого момента. Что ты можешь... начать думать, что это ответственность - начать воспринимать меня как цепи, которые тянут тебя вниз.",shape=box,color=blue];
		2163 -> 2165;
	2164 [label="+5 Chemistry",color=orange];
		2164 -> 2166;
	2165 [label="Я прошу тебя - я молюсь всем богам, как небесным, так и земным - чтобы никогда этого тобой не совершалось. Это тобой преподнесенный мне подарок, и каждый раз я буду беречь его.",shape=box,color=blue];
		2165 -> 2167;
	2166 [label="Не нужно слов, mon miracle... ",shape=box,color=blue];
		2166 -> 2168;
	2167 [label="Поклянись мне, mon miracle, что, если придёт время, я стану для тебя пустой клеткой... у тебя будет свобода от меня.",shape=box,color=blue];
		2167 -> 2169;
	2168 [label="Во время прогулки я... мгновенно осознал мрачную опасность такого момента. Что ты можешь... начать думать, что это ответственность - начать воспринимать меня как цепи, которые тянут тебя вниз.",shape=box,color=blue];
		2168 -> 2165;
	2169 [label="Я не стану пустой тюрьмой для тех, кого люблю. Не для тебя. Не для Мари.",shape=box,color=blue];
		2169 -> 2170;
		2169 -> 2171;
	2170 [label="[Расстаться.] Я - я не могу. Я не могу этого обещать, прости.",shape=box,color=red];
		2170 -> 2172;
	2171 [label="Я клянусь в этом. ",shape=box,color=red];
		2171 -> 2173;
	2172 [label="+10 Chemistry",color=orange];
		2172 -> 2174;
	2173 [label="+10 Chemistry",color=orange];
		2173 -> 2175;
	2174 [label="Спасибо. Спасибо тебе, mon miracle, за твою честность. В тот момент это потребовало мужества, и я благодарю тебя за это.",shape=box,color=blue];
		2174 -> 2176;
	2175 [label="Спасибо. Спасибо тебе, mon miracle...",shape=box,color=blue];
		2175 -> 2177;
	2176 [label="Я буду дорожить всеми моментами, которые мы провели вместе. Это значит для меня больше, чем ты можешь себе представить.",shape=box,color=blue];
		2176 -> 2178;
	2177 [label="Я вдруг почувствовал такую сильную усталость, как будто... с моих плеч свалился огромный груз. Боюсь, мне нужно прилечь.",shape=box,color=blue];
		2177 -> 2179;
	2178 [label="Я буду помнить их в своей душе, даже если они исчезнут из моего сознания. Прощай.",shape=box,color=blue];
		2178 -> 2180;
	2179 [label="- Лион",shape=box,color=blue];
		2179 -> 2181;
	2180 [label="Update boolean LyonDating",color=orange];
		2180 -> 2182;
	2181 [label="Update boolean LyonDatingConfession",color=orange];
		2181 -> 2183;
	2182 [label="Update boolean IsDating",color=orange];
		2182 -> 2184;
	2183 [label="Chat ends.",color=orange];
	2184 [label="- Лион",shape=box,color=blue];
		2184 -> 2185;
	2185 [label="Chat ends.",color=orange];
}