	2059 [label="Update boolean LyonDating",color=orange];
		2059 -> 2063;
	2060 [label="Ба! Если у тебя не было желания знать о том, что творится у меня в голове, тебе не следовало совать туда нос. В этом полностью твоя вина.",shape=box,color=blue];
		2060 -> 2064;
	2061 [label="Я очень рад, что тебе нравятся мои странствия. Именно поэтому я предпочитаю говорить как можно меньше. Можешь себе представить, как я переживу это лично? Мари давным-давно расправилась бы со мной, как с бешеной собакой.",shape=box,color=blue];
		2061 -> 2064;
	2062 [label="В тебе, естественно, присутствует определённая доля непочтительности и сарказма, до которых я и не надеялся дойти. Я оставлю это на твоё усмотрение.",shape=box,color=blue];
		2062 -> 2064;
	2063 [label="Update boolean IsDating",color=orange];
		2063 -> 2065;
	2064 [label="Тем не менее, всё это должно было послужить поводом для рассказа, который сейчас покажется тебе довольно коротким по сравнению с остальными...",shape=box,color=blue];
		2064 -> 2066;
	2065 [label="- Лион",shape=box,color=blue];
		2065 -> 2067;
	2066 [label="Прошлой ночью я проснулся от кошмара. Когда я проснулся, меня окружили тени. В моем душевном состоянии нет ничего необычного или нового. Они нависали над моей кроватью и не хотели рассеиваться.",shape=box,color=blue];
		2066 -> 2068;
	2067 [label="Chat ends.",color=orange];
	2068 [label="Я не боялся их, потому что знал, что они не могут причинить мне вреда. Однако и из головы они не выходили. Я знал только одно средство избавиться от них.",shape=box,color=blue];
		2068 -> 2069;
	2069 [label="Поднявшись с кровати, я оделся, как мог, пошатываясь, несмотря на расплывчатое видение продолжающегося кошмара. Я схватил свой Кадило и упал на колени посреди комнаты, приготовившись к... ну, в общем. ",shape=box,color=blue];
		2069 -> 2070;
	2070 [label="Я приготовился «очистить свой разум». Оставим всё как есть.",shape=box,color=blue];
		2070 -> 2071;
	2071 [label="Но стоило мне закрыть глаза, как мой разум блуждал. Мои мысли блуждали... к тебе, mon miracle...",shape=box,color=blue];
		2071 -> 2072;
	2072 [label="Звук твоего голоса. Прикосновение твоей руки к моему плечу... ",shape=box,color=blue];
		2072 -> 2073;
	2073 [label="И видения... исчезли. Они покинули свой пост, преследуемые более сильным призраком... тебя.",shape=box,color=blue];
		2073 -> 2074;
	2074 [label="Я... встал. Поставил кадило на прикроватный столик и... решил вместо этого пройтись по песку Санктума...",shape=box,color=blue];
		2074 -> 2075;
		2074 -> 2076;
	2075 [label="Теперь я могу понять, почему тебе понадобилась эта преамбула.",shape=box,color=red];
		2075 -> 2077;
	2076 [label="Я не знаю, что сказать...",shape=box,color=red];
		2076 -> 2078;
	2077 [label="Да. Хорошо. Во время прогулки я... мгновенно осознал мрачную опасность такого момента. Что ты можешь... начать думать, что это ответственность - начать воспринимать меня как цепи, которые тянут тебя вниз.",shape=box,color=blue];
		2077 -> 2079;
	2078 [label="+5 Chemistry",color=orange];
		2078 -> 2080;
	2079 [label="Я прошу тебя - я молюсь всем богам, как небесным, так и земным - чтобы никогда этого тобой не совершалось. Это тобой преподнесенный мне подарок, и каждый раз я буду беречь его.",shape=box,color=blue];
		2079 -> 2081;
	2080 [label="Не нужно слов, mon miracle... ",shape=box,color=blue];
		2080 -> 2082;
	2081 [label="Поклянись мне, mon miracle, что, если придёт время, я стану для тебя пустой клеткой... у тебя будет свобода от меня.",shape=box,color=blue];
		2081 -> 2083;
	2082 [label="Во время прогулки я... мгновенно осознал мрачную опасность такого момента. Что ты можешь... начать думать, что это ответственность - начать воспринимать меня как цепи, которые тянут тебя вниз.",shape=box,color=blue];
		2082 -> 2079;
	2083 [label="Я не стану пустой тюрьмой для тех, кого люблю. Не для тебя. Не для Мари.",shape=box,color=blue];
		2083 -> 2084;
		2083 -> 2085;
	2084 [label="[Расстаться.] Я - я не могу. Я не могу этого обещать, прости.",shape=box,color=red];
		2084 -> 2086;
	2085 [label="Я клянусь в этом. ",shape=box,color=red];
		2085 -> 2087;
	2086 [label="+10 Chemistry",color=orange];
		2086 -> 2088;
	2087 [label="+10 Chemistry",color=orange];
		2087 -> 2089;
	2088 [label="Спасибо. Спасибо тебе, mon miracle, за твою честность. В тот момент это потребовало мужества, и я благодарю тебя за это.",shape=box,color=blue];
		2088 -> 2090;
	2089 [label="Спасибо. Спасибо тебе, mon miracle...",shape=box,color=blue];
		2089 -> 2091;
	2090 [label="Я буду дорожить всеми моментами, которые мы провели вместе. Это значит для меня больше, чем ты можешь себе представить.",shape=box,color=blue];
		2090 -> 2092;
	2091 [label="Я вдруг почувствовал такую сильную усталость, как будто... с моих плеч свалился огромный груз. Боюсь, мне нужно прилечь.",shape=box,color=blue];
		2091 -> 2093;
	2092 [label="Я буду помнить их в своей душе, даже если они исчезнут из моего сознания. Прощай.",shape=box,color=blue];
		2092 -> 2094;
