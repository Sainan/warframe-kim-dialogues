		j1243665097 -> j1767601810 [label="false",color=purple];
	j1603283996 [label="Как проходит твой день, Лион?",shape=box,color=red];
		j1603283996 -> j1723461250;
	j4174043875 [label="[Признаться в чувствах.] Лион? Я хотела спросить, можем ли мы коё о чём поговорить.",shape=box,color=red];
		j4174043875 -> j3823702953;
	j1310452999 [label="[Конец.]",shape=box,color=red];
		j1310452999 -> "Chat ends.";
	j3412837648 [label="Для меня важно, чтобы вы уделили очень пристальное внимание этим следующим словам, которые я отправлю. Понимаете?",shape=box,color=blue];
		j3412837648 -> j3761790891;
		j3412837648 -> j3997957175;
	j2183298434 [label="Check boolean LyonHasDated",color=orange];
		j2183298434 -> j762696610 [label=true,color=green];
		j2183298434 -> j3183549740 [label=true,color=green];
		j2183298434 -> j572460604 [label=true,color=green];
		j2183298434 -> j3183549740 [label=false,color=brown];
		j2183298434 -> j572460604 [label=false,color=brown];
	j1884151699 [label="Я рад, что есть кто-то, кто может найти в себе силы пробиться сквозь заросли личности Роут и увидеть то, что сломано внутри.",shape=box,color=blue];
		j1884151699 -> j1358993831;
	j1767601810 [label="Могу я задать вопрос, который, как я опасаюсь, может показаться неделикатным, мой друг?",shape=box,color=blue];
		j1767601810 -> j1478587160;
		j1767601810 -> j3728641009;
	j1723461250 [label="Какой удивительно мягкий и очаровательно обыденный вопрос. Мне нечасто задают его.",shape=box,color=blue];
		j1723461250 -> j3438095507;
	j3823702953 [label="Да, в чём дело? Что-то не так?",shape=box,color=blue];
		j3823702953 -> j3845377137;
		j3823702953 -> j4187232906;
	j3761790891 [label="Ты заставляешь меня нервничать. Что не так?",shape=box,color=red];
		j3761790891 -> j3777560431;
	j3997957175 [label="Да, я здесь. Продолжай.",shape=box,color=red];
		j3997957175 -> j4226638240;
	j762696610 [label="Я не знал, как ты отнесёшься к этому с тех пор...",shape=box,color=red];
		j762696610 -> j1875179286;
	j3183549740 [label="Я в некотором роде... я в восторге от неё.",shape=box,color=red];
		j3183549740 -> j2205809516;
	j572460604 [label="Это что, разговор, в котором ты мне угрожаешь? Или?",shape=box,color=red];
		j572460604 -> j3838427260;
	j1358993831 [label="Я знаю, что, хотя он яростно это отрицает, он считает себя трусом. Я бы не стал называть его таковым.",shape=box,color=blue];
		j1358993831 -> j2513313134;
	j1478587160 [label="Конечно. Я уже о многом тебя спрашивал.",shape=box,color=red];
		j1478587160 -> j3673685884;
	j3728641009 [label="Почему я встречаюсь с Роут?",shape=box,color=red];
		j3728641009 -> j445775389;
	j3438095507 [label="Я... в полном порядке, спасибо.",shape=box,color=blue];
		j3438095507 -> j718796967;
	j3845377137 [label="Неважно. Извини. Вообще-то, я забыл, что собирался сказать.",shape=box,color=red];
		j3845377137 -> j2386003655;
	j4187232906 [label="Я не знаю, как лучше это сформулировать, поэтому я собираюсь прямо сказать - у меня есть чувства к тебе.",shape=box,color=red];
		j4187232906 -> j3038097850;
	j3777560431 [label="В этом нет ничего плохого - совсем наоборот. Именно это так важно понять - ужасные последствия, от которых я хочу тебя избавить, если ты предполагаешь, что они могут последовать.",shape=box,color=blue];
		j3777560431 -> j49282802;
		j3777560431 -> j1328180408;
		j3777560431 -> j1102176426;
	j4226638240 [label="+5 Chemistry",color=orange];
		j4226638240 -> j1490597321;
	j1875179286 [label="Ха. Ты думаешь, я удивлён? Я стою в тени её света и всегда был таким. Нет, мой друг, я не испытываю горечи или ревности из-за этого, я обещаю тебе.",shape=box,color=blue];
		j1875179286 -> j4145798740;
	j2205809516 [label="Как и все мы. Сестра моей души не перестаёт удивлять меня. Я так рад за вас обоих, что это невозможно выразить словами.",shape=box,color=blue];
		j2205809516 -> j1091614010;
	j3838427260 [label="Хм? Нет. Вряд ли я был бы настолько самоуверен, чтобы ходить вокруг да около и притворяться её опекуном. Она вполне способна переломать тебе кости, если решит, что ты этого заслуживаешь.",shape=box,color=blue];
		j3838427260 -> j2001655159;
	j2513313134 [label="Энтрати сказал ему, что он понадобится, чтобы спасти будущее, которого он не знал. Будущее, над которым у него не было ни власти, ни народа, который пресмыкался бы у его ног, ни слуг, которые поклонялись бы ему.",shape=box,color=blue];
		j2513313134 -> j3786481424;
	j3673685884 [label="Что... ты нашла в Роут такого, что побудило вас двоих... начать ухаживать?",shape=box,color=blue];
		j3673685884 -> j2105264067;
		j3673685884 -> j3447674388;
		j3673685884 -> j2188815036;
	j445775389 [label="Я вижу, вы либо уже сталкивались с подобными вопросами, либо ожидали их. Да. Именно это. Что... ты в нём находишь?",shape=box,color=blue];
		j445775389 -> j2105264067;
		j445775389 -> j3447674388;
		j445775389 -> j2188815036;
	j718796967 [label="+20 Chemistry",color=orange];
		j718796967 -> j4278098484;
	j2386003655 [label="Это часто случается со мной. Часто, когда я прохожу через дверные проёмы. Я часто задавался вопросом, почему так происходит.",shape=box,color=blue];
		j2386003655 -> j266308163;
	j3038097850 [label="Я... у тебя... есть уверенность в этом? С тобой всё в порядке? У тебя случайно не было в последнее время удара головой?",shape=box,color=blue];
		j3038097850 -> j4162094580;
		j3038097850 -> j3249798850;
	j49282802 [label="Я слушаю.",shape=box,color=red];
		j49282802 -> j2634550369;
	j1328180408 [label="В твоих словах не так много смысла.",shape=box,color=red];
		j1328180408 -> j1887292697;
	j1102176426 [label="Ужасные последствия... что?",shape=box,color=red];
		j1102176426 -> j3179838500;
	j1490597321 [label="Спасибо. Прежде чем я начну, я хочу заверить, что здесь нет ничего плохого - однако, возможно, в этом и кроются ужасные последствия, от которых я хотел бы тебя избавить, если тебе кажется, что они могут быть.",shape=box,color=blue];
		j1490597321 -> j49282802;
		j1490597321 -> j1328180408;
		j1490597321 -> j1102176426;
	j4145798740 [label="Я не держу обиды за то, что произошло между нами, я всё ещё могу выразить только свою благодарность за то время, которое мы провели вместе.",shape=box,color=blue];
		j4145798740 -> j1924035182;
	j1091614010 [label="В её глазах такая радость, когда она говорит о тебе. У нее кружится голова от волнения, когда она думает, что ты, возможно, заглянешь.",shape=box,color=blue];
		j1091614010 -> j3660727414;
	j2001655159 [label="Я просто хотел сказать, что её счастье заразительно, и я ловлю себя на том, что тоже улыбаюсь при мысли об этом. И за это я тоже должен поблагодарить тебя.",shape=box,color=blue];
		j2001655159 -> j3176698568;
	j3786481424 [label="Он может подумать, что это проявление страха - крыса, спасающаяся с тонущего корабля, - принять сыворотку и забыть о действиях, которые привели к этому. ",shape=box,color=blue];
		j3786481424 -> j254203929;
	j2105264067 [label="Грубо говоря? Он тебе попадался на глаза?",shape=box,color=red];
		j2105264067 -> j160581085;
	j3447674388 [label="Я думаю, что в нём есть боль, где-то под всем этим... юмор и индивидуальность.",shape=box,color=red];
		j3447674388 -> j2190980499;
	j2188815036 [label="Я... ничего не могу с собой поделать. В нём есть тьма и опасность, которые я нахожу привлекательными. Это притягивает меня.",shape=box,color=red];
		j2188815036 -> j1005108264;
	j4278098484 [label="Да, я думаю, что сегодня я действительно чувствую себя вполне хорошо.",shape=box,color=blue];
		j4278098484 -> j1692724511;
	j266308163 [label="+5 Chemistry",color=orange];
		j266308163 -> j1692724511;
	j4162094580 [label="Почему в это так трудно поверить?",shape=box,color=red];
		j4162094580 -> j2745399005;
	j3249798850 [label="Конечно, Лион. У меня нет сотрясения мозга.",shape=box,color=red];
		j3249798850 -> j2745399005;
	j2634550369 [label="+5 Chemistry",color=orange];
		j2634550369 -> j208320623;
	j1887292697 [label="Да. Я с болью осознаю это.",shape=box,color=blue];
		j1887292697 -> j3179838500;
	j3179838500 [label="Позволь мне начать сначала.",shape=box,color=blue];
		j3179838500 -> j208320623;
	j1924035182 [label="+10 Chemistry",color=orange];
		j1924035182 -> j4126143297;
	j3660727414 [label="+10 Chemistry",color=orange];
		j3660727414 -> j2001655159;
	j3176698568 [label="- Лион",shape=box,color=blue];
		j3176698568 -> "Chat ends.";
	j254203929 [label="Я смотрю на это как человек, который видел расчёты на поле боя и знал, когда следует покинуть уже потерянное судно. Потому что война ещё не закончилась.",shape=box,color=blue];
		j254203929 -> j1494212890;
	j160581085 [label="Я далёк от того, чтобы осуждать тебя.",shape=box,color=blue];
		j160581085 -> j3405095122;
	j2190980499 [label="+5 Chemistry",color=orange];
		j2190980499 -> j138380368;
	j1005108264 [label="Я могу понять это притяжение. Не буду отрицать, что сам я этого не понимаю. Однако я надеюсь, что ради твоего же блага ты не позволишь поглотить тебя.",shape=box,color=blue];
		j1005108264 -> j1391827668;
	j1692724511 [label="Хорошего тебе оставшегося дня. -Лион",shape=box,color=blue];
		j1692724511 -> "Chat ends.";
	j2745399005 [label="Ну, прямо скажем, когда у тебя есть столько других возможностей... Мари, или Роут, или... кто угодно ещё во вселенной, если уж на то пошло...",shape=box,color=blue];
		j2745399005 -> j827628087;
	j208320623 [label="Я осознаю, что многие могут истолковать мои слова так, что я, на самом деле, вполне могу оказаться... нездоров. По крайней мере, я не совсем в здравом уме.",shape=box,color=blue];
		j208320623 -> j2529298838;
	j4126143297 [label="Я рад, что ты проведёшь это время с ней. Она принесёт тебе радость там, где я мог принести тебе только печаль. Будь счастлив с ней. Я тебя благословляю.",shape=box,color=blue];
		j4126143297 -> j3176698568;
	j1494212890 [label="Evaluate expressions",color=orange];
		j1494212890 -> j1836959154 [label="RoatheVillian",color=purple];
		j1494212890 -> j2350873895 [label="RoatheVillian",color=purple];
		j1494212890 -> j2295587472 [label="RoatheVillian",color=purple];
		j1494212890 -> j1836959154 [label="RoatheRedeemed",color=purple];
		j1494212890 -> j2350873895 [label="RoatheRedeemed",color=purple];
		j1494212890 -> j681369121 [label="RoatheRedeemed",color=purple];
		j1494212890 -> j2295587472 [label="RoatheRedeemed",color=purple];
		j1494212890 -> j1836959154 [label="false",color=purple];
		j1494212890 -> j2350873895 [label="false",color=purple];
	j3405095122 [label="Хотя, ради твоего же блага, я надеюсь, что это увлечение быстро пройдет и не перерастёт в зависимость. Я видел, как подобные вещи губили других.",shape=box,color=blue];
		j3405095122 -> j130115490;
	j138380368 [label="Да, я сам это видел. Возможно, это спрятано глубоко внутри. Но он, возможно, не одобряет твоих попыток совать нос в чужие дела. Я думаю, ему нравится то, кем он стал.",shape=box,color=blue];
		j138380368 -> j130115490;
	j1391827668 [label="Такие меры должны основываться не только на... простой темноте. Однако я не буду читать тебе лекций.",shape=box,color=blue];
		j1391827668 -> j130115490;
	j827628087 [label="Мне трудно поверить, что кто-то стал бы возиться с таким разбитым витражом, как я... разве что был бы серьезно нездоров.",shape=box,color=blue];
		j827628087 -> j1504460201;
		j827628087 -> j258561497;
	j2529298838 [label="Я уже давно примирился с этим. Это меня больше не беспокоит. Видения, которые преследуют меня, - голоса - я научился жить с ними без страха и ненависти.",shape=box,color=blue];
		j2529298838 -> j1558081256;
	j1836959154 [label="У меня просто чувство радости рядом с ним, помогать любым способом, каким могу.",shape=box,color=red];
		j1836959154 -> j4079275103;
	j2350873895 [label="То, что с ним случилось,... сложно. Я думаю, он ещё долго будет разбираться в этом.",shape=box,color=red];
		j2350873895 -> j4079275103;
	j2295587472 [label="Точно. Он сделал это, чтобы выиграть войну, а иногда это означает поражение в нескольких битвах.",shape=box,color=red];
		j2295587472 -> j4079275103;
	j681369121 [label="Со временем он простит себя. Но я не думаю, что внешняя оболочка когда-нибудь по-настоящему изменится.",shape=box,color=red];
		j681369121 -> j4079275103;
	j130115490 [label="Вы знаете свой разум и свои пределы. Я желаю вам обоим всего наилучшего.",shape=box,color=blue];
		j130115490 -> j2784871036;
	j1504460201 [label="Лион? У меня есть чувства к тебе. Ты мне небезразличен. Я хочу быть с тобой, если ты тоже этого хочешь.",shape=box,color=red];
		j1504460201 -> j2246989731;
	j258561497 [label="Если ты говоришь, что это не взаимно...",shape=box,color=red];
		j258561497 -> j2788528104;
	j1558081256 [label="(В последнее время, я думаю, немного назло, если быть честным, но это уже не суть важно.)",shape=box,color=blue];
		j1558081256 -> j2569139055;
	j4079275103 [label="+10 Chemistry",color=orange];
		j4079275103 -> j3606949086;
	j2784871036 [label="+10 Chemistry",color=orange];
		j2784871036 -> j3108346808;
	j2246989731 [label="Прости меня, пожалуйста, прости меня - я просто... мне казалось, что это невозможно, это... не то, что мне... могло бы... представиться...",shape=box,color=blue];
		j2246989731 -> j2906150297;
	j2788528104 [label="Вряд ли! Это не то, что я хотел сказать! На самом деле, это далеко не так, я просто... я думал, что это невозможно... это не то, что я... мог... себе представить...",shape=box,color=blue];
		j2788528104 -> j2906150297;
	j2569139055 [label="Но я хочу, чтобы тебе было понято, что если ты прекратишь это между нами - эту связь, которую я считал ранее невозможной между мной и кем-либо другим -",shape=box,color=blue];
		j2569139055 -> j3848766602;
	j3606949086 [label="На что я желаю вам обоим всего наилучшего.",shape=box,color=blue];
		j3606949086 -> j3108346808;
	j3108346808 [label="К тому же, теперь, когда у него, кажется, появился «зуд, который нужно почесать», он перестал провоцировать Мари на открытый конфликт.",shape=box,color=blue];
		j3108346808 -> j3700663149;
	j2906150297 [label="+20 Chemistry",color=orange];
		j2906150297 -> j2903799033;
	j3848766602 [label="Если бы твоему сердцу было позволено когда-нибудь отдалится от моего? ",shape=box,color=blue];
		j3848766602 -> j4158673179;
	j3700663149 [label="Хорошо. Во всяком случае, не так часто. А пока прощайте.",shape=box,color=blue];
		j3700663149 -> j3176698568;
	j2903799033 [label="Ты действительно mon miracle...",shape=box,color=blue];
		j2903799033 -> j1374158912;
	j4158673179 [label="Я буду терпеть, mon miracle.",shape=box,color=blue];
		j4158673179 -> j1772392149;
	j1374158912 [label="Boolean LyonDating is now true.",color=orange];
		j1374158912 -> j4115967391;
	j1772392149 [label="Я не поддамся тому, что мучило меня до сих пор. ",shape=box,color=blue];
		j1772392149 -> j1697539566;
	j4115967391 [label="Boolean IsDating is now true.",color=orange];
		j4115967391 -> j3642226382;
	j1697539566 [label="Check boolean LyonAllRight",color=orange];
		j1697539566 -> j1758437806 [label=true,color=green];
		j1697539566 -> j2457078286 [label=false,color=brown];
	j3642226382 [label="Boolean LyonHasDated is now true.",color=orange];
		j3642226382 -> "Chat ends.";
	j1758437806 [label="Я буду, выражаясь твоим языком, «в порядке». Я найду повод улыбнуться и посмеяться ещё раз.",shape=box,color=blue];
		j1758437806 -> j1674071543;
		j1758437806 -> j3318925137;
	j2457078286 [label="Я выживу. Со мной всё будет в порядке. Я найду причину улыбаться и смеяться ещё раз.",shape=box,color=blue];
		j2457078286 -> j1674071543;
		j2457078286 -> j3318925137;
	j1674071543 [label="О, Лион... ты не обуза для меня.",shape=box,color=red];
		j1674071543 -> j3421678087;
	j3318925137 [label="Ты... хочешь сказать, что хочешь положить конец отношениям между нами?",shape=box,color=red];
		j3318925137 -> j3304774018;
	j3421678087 [label="Я просто пытаюсь избавить тебя от любых предполагаемых трудностей, которые возможно могли быть испытаны тобой из-за меня...",shape=box,color=blue];
		j3421678087 -> j3605553933;
		j3421678087 -> j2705939816;
		j3421678087 -> j2118385730;
	j3304774018 [label="Нет! Что-нибудь в этом роде! Я просто пытаюсь избавить тебя от любых предполагаемых трудностей, которые у тебя могли возникнуть из-за меня.",shape=box,color=blue];
		j3304774018 -> j3605553933;
		j3304774018 -> j2705939816;
		j3304774018 -> j2118385730;
	j3605553933 [label="Твоя боль... В какой-то мере перекликается с моей собственной. Мне никогда не составит труда помочь тебе справиться с этим.",shape=box,color=red];
		j3605553933 -> j2523904946;
	j2705939816 [label="Я не могу описать, что привлекает меня в тебе. Но ты никогда не будешь для меня долгом или обузой.",shape=box,color=red];
		j2705939816 -> j460536003;
	j2118385730 [label="[Расстаться.] Прости, для меня это уже слишком. Возможно, было бы лучше покончить со всем этим прямо сейчас.",shape=box,color=red];
		j2118385730 -> j280516621;
	j2523904946 [label="Я не могу выразить, как сильно моё сердце разрывается из-за тебя. Но я бесконечно благодарю за то, что наши одинокие призраки боли нашли друг друга.",shape=box,color=blue];
		j2523904946 -> j3825832243;
	j460536003 [label="Которому я не могу должным образом выразить свою благодарность, и я не думаю, что какие-либо слова когда-либо смогут это сделать.",shape=box,color=blue];
		j460536003 -> j3825832243;
	j280516621 [label="Да. Конечно. Было бы... лицемерно принимать любой другой ответ на данный момент... ",shape=box,color=blue];
		j280516621 -> j3273922483;
	j3825832243 [label="Но теперь, когда я приложил немало усилий, чтобы пройти через то, что было самым впечатляющим вступлением, потакающим своим желаниям...",shape=box,color=blue];
		j3825832243 -> j3063527258;
		j3825832243 -> j3541762664;
		j3825832243 -> j236065570;
	j3273922483 [label="Я всё понимаю. И я желаю тебе только самого лучшего. И я буду дорожить всеми моментами, которые мы провели вместе.",shape=box,color=blue];
		j3273922483 -> j742212706;
	j3063527258 [label="Для парня, который начинал с молчания, ты действительно стал многословным.",shape=box,color=red];
		j3063527258 -> j1826654429;
	j3541762664 [label="Я нахожу их милыми, не волнуйся.",shape=box,color=red];
		j3541762664 -> j2824579065;
	j236065570 [label="Ты мог бы просто сказать: «Знаешь, со мной всё будет в порядке, если наши пути когда-нибудь разойдутся».",shape=box,color=red];
		j236065570 -> j3550319410;
	j742212706 [label="Я буду помнить их в своей душе, даже если они исчезнут из моего сознания. Прощай.",shape=box,color=blue];
		j742212706 -> j1797470039;
	j1826654429 [label="+5 Chemistry",color=orange];
		j1826654429 -> j2431550250;
	j2824579065 [label="+5 Chemistry",color=orange];
		j2824579065 -> j3975145159;
	j3550319410 [label="+5 Chemistry",color=orange];
		j3550319410 -> j741387206;
	j1797470039 [label="Boolean LyonDating is now false.",color=orange];
		j1797470039 -> j133216888;
	j2431550250 [label="Ба! Если у тебя не было желания знать о том, что творится у меня в голове, тебе не следовало совать туда нос. В этом полностью твоя вина.",shape=box,color=blue];
		j2431550250 -> j3989096482;
	j3975145159 [label="Я очень рад, что тебе нравятся мои странствия. Именно поэтому я предпочитаю говорить как можно меньше. Можешь себе представить, как я переживу это лично? Мари давным-давно расправилась бы со мной, как с бешеной собакой.",shape=box,color=blue];
		j3975145159 -> j3989096482;
	j741387206 [label="В тебе, естественно, присутствует определённая доля непочтительности и сарказма, до которых я и не надеялся дойти. Я оставлю это на твоё усмотрение.",shape=box,color=blue];
		j741387206 -> j3989096482;
	j133216888 [label="Boolean IsDating is now false.",color=orange];
		j133216888 -> j3176698568;
	j3989096482 [label="Тем не менее, всё это должно было послужить поводом для рассказа, который сейчас покажется тебе довольно коротким по сравнению с остальными...",shape=box,color=blue];
		j3989096482 -> j2339265559;
	j2339265559 [label="Прошлой ночью я проснулся от кошмара. Когда я проснулся, меня окружили тени. В моем душевном состоянии нет ничего необычного или нового. Они нависали над моей кроватью и не хотели рассеиваться.",shape=box,color=blue];
		j2339265559 -> j1482984461;
	j1482984461 [label="Я не боялся их, потому что знал, что они не могут причинить мне вреда. Однако и из головы они не выходили. Я знал только одно средство избавиться от них.",shape=box,color=blue];
		j1482984461 -> j3850508878;
	j3850508878 [label="Поднявшись с кровати, я оделся, как мог, пошатываясь, несмотря на расплывчатое видение продолжающегося кошмара. Я схватил свой Кадило и упал на колени посреди комнаты, приготовившись к... ну, в общем. ",shape=box,color=blue];
		j3850508878 -> j99039966;
	j99039966 [label="Я приготовился «очистить свой разум». Оставим всё как есть.",shape=box,color=blue];
		j99039966 -> j2322052943;
	j2322052943 [label="Но стоило мне закрыть глаза, как мой разум блуждал. Мои мысли блуждали... к тебе, mon miracle...",shape=box,color=blue];
		j2322052943 -> j776050042;
	j776050042 [label="Звук твоего голоса. Прикосновение твоей руки к моему плечу... ",shape=box,color=blue];
		j776050042 -> j2767912305;
	j2767912305 [label="И видения... исчезли. Они покинули свой пост, преследуемые более сильным призраком... тебя.",shape=box,color=blue];
		j2767912305 -> j4161114975;
	j4161114975 [label="Я... встал. Поставил кадило на прикроватный столик и... решил вместо этого пройтись по песку Санктума...",shape=box,color=blue];
		j4161114975 -> j3260208921;
		j4161114975 -> j279963386;
	j3260208921 [label="Теперь я могу понять, почему тебе понадобилась эта преамбула.",shape=box,color=red];
		j3260208921 -> j3722610884;
	j279963386 [label="Я не знаю, что сказать...",shape=box,color=red];
		j279963386 -> j3431122373;
	j3722610884 [label="Да. Хорошо. Во время прогулки я... мгновенно осознал мрачную опасность такого момента. Что ты можешь... начать думать, что это ответственность - начать воспринимать меня как цепи, которые тянут тебя вниз.",shape=box,color=blue];
		j3722610884 -> j30926830;
	j3431122373 [label="+5 Chemistry",color=orange];
		j3431122373 -> j1824992199;
	j30926830 [label="Я прошу тебя - я молюсь всем богам, как небесным, так и земным - чтобы никогда этого тобой не совершалось. Это тобой преподнесенный мне подарок, и каждый раз я буду беречь его.",shape=box,color=blue];
		j30926830 -> j3291561220;
	j1824992199 [label="Не нужно слов, mon miracle... ",shape=box,color=blue];
		j1824992199 -> j1142604217;
	j3291561220 [label="Поклянись мне, mon miracle, что, если придёт время, я стану для тебя пустой клеткой... у тебя будет свобода от меня.",shape=box,color=blue];
		j3291561220 -> j1747532817;
	j1142604217 [label="Во время прогулки я... мгновенно осознал мрачную опасность такого момента. Что ты можешь... начать думать, что это ответственность - начать воспринимать меня как цепи, которые тянут тебя вниз.",shape=box,color=blue];
		j1142604217 -> j30926830;
	j1747532817 [label="Я не стану пустой тюрьмой для тех, кого люблю. Не для тебя. Не для Мари.",shape=box,color=blue];
		j1747532817 -> j4206004526;
		j1747532817 -> j174580842;
	j4206004526 [label="[Расстаться.] Я - я не могу. Я не могу этого обещать, прости.",shape=box,color=red];
		j4206004526 -> j4233764437;
	j174580842 [label="Я клянусь в этом. ",shape=box,color=red];
		j174580842 -> j927200168;
	j4233764437 [label="+10 Chemistry",color=orange];
		j4233764437 -> j1585134072;
	j927200168 [label="+10 Chemistry",color=orange];
		j927200168 -> j1575702589;
	j1585134072 [label="Спасибо. Спасибо тебе, mon miracle, за твою честность. В тот момент это потребовало мужества, и я благодарю тебя за это.",shape=box,color=blue];
		j1585134072 -> j1453604479;
	j1575702589 [label="Спасибо. Спасибо тебе, mon miracle...",shape=box,color=blue];
		j1575702589 -> j3892523579;
	j1453604479 [label="Я буду дорожить всеми моментами, которые мы провели вместе. Это значит для меня больше, чем ты можешь себе представить.",shape=box,color=blue];
		j1453604479 -> j742212706;
	j3892523579 [label="Я вдруг почувствовал такую сильную усталость, как будто... с моих плеч свалился огромный груз. Боюсь, мне нужно прилечь.",shape=box,color=blue];
		j3892523579 -> j1420839340;
	j1420839340 [label="- Лион",shape=box,color=blue];
		j1420839340 -> j3446510588;
