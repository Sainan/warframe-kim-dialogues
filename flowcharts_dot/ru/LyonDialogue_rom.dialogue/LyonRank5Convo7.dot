	"Chat ends." [color=orange];
	j4293248629 [label="Mon miracle, я... должен быть совершенно уверен, что ты кое-что поняла, прежде чем я расскажу тебе свой следующий анекдот. ",shape=box,color=blue];
		j4293248629 -> j3412837648;
	j3199213871 [label="Я не удивлён, что Мари поймала твоё сердце в свои руки, как бабочку. Она... это нечто особенное.",shape=box,color=blue];
		j3199213871 -> j2183298434;
