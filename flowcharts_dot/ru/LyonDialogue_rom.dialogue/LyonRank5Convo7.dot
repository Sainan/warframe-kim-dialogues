		1965 -> 1979;
	1966 [label="Как и все мы. Сестра моей души не перестаёт удивлять меня. Я так рад за вас обоих, что это невозможно выразить словами.",shape=box,color=blue];
		1966 -> 1980;
	1967 [label="Хм? Нет. Вряд ли я был бы настолько самоуверен, чтобы ходить вокруг да около и притворяться её опекуном. Она вполне способна переломать тебе кости, если решит, что ты этого заслуживаешь.",shape=box,color=blue];
		1967 -> 1981;
	1968 [label="Энтрати сказал ему, что он понадобится, чтобы спасти будущее, которого он не знал. Будущее, над которым у него не было ни власти, ни народа, который пресмыкался бы у его ног, ни слуг, которые поклонялись бы ему.",shape=box,color=blue];
