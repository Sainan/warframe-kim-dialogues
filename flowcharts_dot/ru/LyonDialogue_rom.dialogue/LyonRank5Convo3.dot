digraph {
	1556 [label="LyonRank5Convo3 begins.",color=orange];
		1556 -> 1557;
	1557 [label="Evaluate expressions",color=orange];
		1557 -> 1559 [label="LyonDating",color=purple];
		1557 -> 1560 [label="LyonConvession1",color=purple];
		1557 -> 1560 [label="LyonRell2a",color=purple];
		1557 -> 1560 [label="LyonRell2b",color=purple];
		1557 -> 1560 [label="LyonRell1",color=purple];
		1557 -> 1558 [label="false",color=purple];
	1559 [label="Я этим не горжусь, но я выпил целую бутылку вина и теперь готов рассказать тебе все остальное, о чём я отчаянно пытался не рассказывать, mon miracle...",shape=box,color=blue];
		1559 -> 1561;
	1560 [label="Я этим не горжусь, но я выпил целую бутылку вина и теперь готов рассказать тебе все остальное, о чём я отчаянно пытался не рассказывать...",shape=box,color=blue];
		1560 -> 1561;
	1558 [label="Chat ends.",color=orange];
	1561 [label="Если эта бутылка действительно вино, этикетки ведь не было - и М. Лойд не был до конца уверен, что то, что мы называли вином в моё время, и то, что он считал вином, это одно и то же.",shape=box,color=blue];
		1561 -> 1562;
	1562 [label="В своё оправдание могу сказать, что я не собирался выпивать всю бутылку... я пытался определить, действительно ли это то же самое вещество, а потом вдруг закончилось...",shape=box,color=blue];
		1562 -> 1563;
		1562 -> 1564;
		1562 -> 1565;
	1563 [label="Нет. Я не собираюсь этого делать.",shape=box,color=red];
		1563 -> 1566;
	1564 [label="На вкус оно похоже?",shape=box,color=red];
		1564 -> 1567;
	1565 [label="Ты пьян?",shape=box,color=red];
		1565 -> 1568;
	1566 [label="Если бы я мог так легко сбежать. Я тебя не виню.",shape=box,color=blue];
		1566 -> 1569;
	1567 [label="Я не знаю! Это было самое неприятное во всей этой истории! Но суть не в этом. Суть была в том, чтобы напиться. А уж насколько это получилось, я понятия не имею. Я, конечно, не трезвый, но -",shape=box,color=blue];
		1567 -> 1570;
	1568 [label="Возможно. Я определённо не тот, кого они считают трезвым.",shape=box,color=blue];
		1568 -> 1571;
	1569 [label="Update boolean LyonConfessionFail",color=orange];
		1569 -> 1572;
	1570 [label="Так что, я полагаю, этого будет достаточно.",shape=box,color=blue];
		1570 -> 1573;
		1570 -> 1574;
	1571 [label="Впрочем, в этом и состояла затея. Так что, полагаю, пусть будет так.",shape=box,color=blue];
		1571 -> 1573;
		1571 -> 1574;
	1572 [label="Chat ends.",color=orange];
	1573 [label="Что же такого ужасного, что тебе нужно напиться, чтобы это мне сказать?",shape=box,color=red];
		1573 -> 1575;
	1574 [label="Ладно, когда захочешь...",shape=box,color=red];
		1574 -> 1575;
	1575 [label="Рэп... тап... тап...",shape=box,color=blue];
		1575 -> 1576;
		1575 -> 1577;
	1576 [label="... Вот как.",shape=box,color=red];
		1576 -> 1578;
	1577 [label="Этого будет достаточно.",shape=box,color=red];
		1577 -> 1578;
	1578 [label="Я знаю совершенно точно, что их не было в моей голове всю мою жизнь. Тэнно, известный как Релл, и его опекун Харроу. Невозможно, чтобы они были в стенах дома моего детства.",shape=box,color=blue];
		1578 -> 1579;
	1579 [label="Невозможно, чтобы они звучали в моём сознании вместе с шёпотом, искажёнными голосами моих видений все эти годы. И всё же я вижу их там, слышу его там, в своих воспоминаниях.",shape=box,color=blue];
		1579 -> 1580;
	1580 [label="Check boolean LyonTime1",color=orange];
		1580 -> 1581 [label=true,color=green];
		1580 -> 1582 [label=false,color=brown];
	1581 [label="Я понял всё, что Энтрати сказал о том, как энергия может существовать во времени в нескольких местах одновременно, понимал это философски. Но эмоционально мне это не было понятно, пока я... не ввел сыворотку.",shape=box,color=blue];
		1581 -> 1583;
	1582 [label="Будто в тот самый миг, когда я ввел сыворотку, всё стало единым целым. Когда Энтрати раскрыл себя и всю правду своего существования - ",shape=box,color=blue];
		1582 -> 1584;
	1583 [label="Я вижу порой перед своим мысленным взором огромное и неглубокое тихое озеро, простирающееся во все стороны. Чёрное и гладкое, как зеркало для гадания из оникса.",shape=box,color=blue];
		1583 -> 1585;
	1584 [label="Он изложил мне все, что знал о «квантовой запутанности», «суперпозиции», «этернализме» и прочем подобном.",shape=box,color=blue];
		1584 -> 1586;
	1585 [label="Огромное чёрное озеро, уходящее в бесконечность. Невозможное для постижения.",shape=box,color=blue];
		1585 -> 1587;
	1586 [label="Я понимал все это в научном, скорее философском смысле. Но не постиг того сердцем, пока... не ввел сыворотку. Но эмоционально мне это не было понятно, пока... я не ввел сыворотку.",shape=box,color=blue];
		1586 -> 1583;
	1587 [label="И именно там я бы их нашел. Именно там мы бы встретились. И именно там я бы тоже Их ощущал...",shape=box,color=blue];
		1587 -> 1588;
	1588 [label="Их?",shape=box,color=red];
		1588 -> 1589;
	1589 [label="Других Харроу... Пустые статуи вещей, эхо отголосков эха... Они тянутся, и тянутся, и тянутся целую вечность во всех направлениях...",shape=box,color=blue];
		1589 -> 1590;
	1590 [label="Рэлл поместил себя внутрь одного из них. Растворился в нём. И, тем самым, растворился во всех них...",shape=box,color=blue];
		1590 -> 1591;
	1591 [label="Включая меня. Включая того Харроу, который был в сыворотке, создавшей меня.",shape=box,color=blue];
		1591 -> 1592;
		1591 -> 1593;
	1592 [label="Безда, я даже не осознавал этого...",shape=box,color=red];
		1592 -> 1594;
	1593 [label="Ох нет -",shape=box,color=red];
		1593 -> 1594;
	1594 [label="Они были рядом со мной, в моём сознании - Рэлл и его Харроу, такие похожие на меня и в то же время совсем иные.",shape=box,color=blue];
		1594 -> 1595;
	1595 [label="Он не боялся. Он был так уверен. Две вещи, которые никогда не были свойственны мне.",shape=box,color=blue];
		1595 -> 1596;
	1596 [label="Он стоял против Безразличия, не заботясь о том, кем оно является или кем нет. Он просто знал, что нужно делать.",shape=box,color=blue];
		1596 -> 1597;
	1597 [label="Даже после всей перенесённой им жестокости. Все эти годы, в «сейчас» и «тогда» той вечности, в тот момент, когда я ввёл серум... в «до» и «после», он был рядом.",shape=box,color=blue];
		1597 -> 1598;
	1598 [label="Он был моим другом. Он был моим братом.",shape=box,color=blue];
		1598 -> 1599;
	1599 [label="Тогда? В настоящем?",shape=box,color=blue];
		1599 -> 1600;
	1600 [label="Я больше не ощущаю его.",shape=box,color=blue];
		1600 -> 1601;
		1600 -> 1602;
	1601 [label="Он... он покоится с миром, теперь, Лион... он в покое.",shape=box,color=red];
		1601 -> 1603;
	1602 [label="О, Лион...",shape=box,color=red];
		1602 -> 1604;
	1603 [label="Я знаю. Я почувствовал его уход. И я плакал. Я скучаю по нему так, что больно дышать. Я знаю, что он откликается, во мне - каким то образом, хотя я не до конца понимаю, как именно.",shape=box,color=blue];
		1603 -> 1605;
		1603 -> 1606;
	1604 [label="Я скучаю по нему так, что больно дышать. Я знаю, что он откликается, во мне - каким то образом, хотя я не до конца понимаю, как именно.",shape=box,color=blue];
		1604 -> 1605;
		1604 -> 1606;
	1605 [label="Рэлл был сильнейшим из нас. Я рад, что у тебя вообще была возможность его узнать.",shape=box,color=red];
		1605 -> 1607;
	1606 [label="Рэлл был отвержен из-за невежества и жестокости детей... он не заслужил того, что с ним случилось.",shape=box,color=red];
		1606 -> 1608;
	1607 [label="Я рад, что тоже знал его. А насчёт его силы? Возможно. Возможно и нет. В конце концов, он просто знал, что нужно, и был достаточно силён, чтобы это осуществить.",shape=box,color=blue];
		1607 -> 1609;
	1608 [label="Возможно. Но в конце концов он сделал то, что было нужно. И он был достаточно силён, чтобы это осуществить.",shape=box,color=blue];
		1608 -> 1609;
	1609 [label="Я думаю, в такие времена мы можем молиться только о том, чтобы быть «достаточно сильными».",shape=box,color=blue];
		1609 -> 1610;
	1610 [label="Увы, того же нельзя сказать об этом вине... оно было очень крепким, просто медленным в своем действии.",shape=box,color=blue];
		1610 -> 1611;
	1611 [label="Мне стоит уйти, пока ",shape=box,color=blue];
		1611 -> 1612;
	1612 [label="Мне пора идти.",shape=box,color=blue];
		1612 -> 1613;
	1613 [label="Check boolean LyonDating",color=orange];
		1613 -> 1614 [label=true,color=green];
		1613 -> 1615 [label=false,color=brown];
	1614 [label="+20 Chemistry",color=orange];
		1614 -> 1616;
	1615 [label="+20 Chemistry",color=orange];
		1615 -> 1617;
	1616 [label="Спасибо, любовь моя.",shape=box,color=blue];
		1616 -> 1618;
	1617 [label="Спасибо, друг мой.",shape=box,color=blue];
		1617 -> 1618;
	1618 [label="- Лион",shape=box,color=blue];
		1618 -> 1619;
	1619 [label="Update boolean LyonConfession2",color=orange];
		1619 -> 1620;
	1620 [label="Update boolean LyonWillDate",color=orange];
