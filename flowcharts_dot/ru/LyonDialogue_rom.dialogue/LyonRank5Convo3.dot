	"LyonRank5Convo3 begins." [color=orange];
		"LyonRank5Convo3 begins." -> j410090499;
	j410090499 [label="Evaluate expressions",color=orange];
		j410090499 -> j4061932152 [label="LyonDating",color=purple];
		j410090499 -> j4056889739 [label="LyonConvession1",color=purple];
		j410090499 -> j4056889739 [label="LyonRell2a",color=purple];
		j410090499 -> j4056889739 [label="LyonRell2b",color=purple];
		j410090499 -> j4056889739 [label="LyonRell1",color=purple];
		j410090499 -> "Chat ends." [label="false",color=purple];
	j4061932152 [label="Я этим не горжусь, но я выпил целую бутылку вина и теперь готов рассказать тебе все остальное, о чём я отчаянно пытался не рассказывать, mon miracle...",shape=box,color=blue];
		j4061932152 -> j3391622036;
	j4056889739 [label="Я этим не горжусь, но я выпил целую бутылку вина и теперь готов рассказать тебе все остальное, о чём я отчаянно пытался не рассказывать...",shape=box,color=blue];
		j4056889739 -> j3391622036;
	"Chat ends." [color=orange];
	j3391622036 [label="Если эта бутылка действительно вино, этикетки ведь не было - и М. Лойд не был до конца уверен, что то, что мы называли вином в моё время, и то, что он считал вином, это одно и то же.",shape=box,color=blue];
		j3391622036 -> j2852372870;
	j2852372870 [label="В своё оправдание могу сказать, что я не собирался выпивать всю бутылку... я пытался определить, действительно ли это то же самое вещество, а потом вдруг закончилось...",shape=box,color=blue];
		j2852372870 -> j933648660;
		j2852372870 -> j4171322717;
		j2852372870 -> j328057961;
	j933648660 [label="Нет. Я не собираюсь этого делать.",shape=box,color=red];
		j933648660 -> j2463656838;
	j4171322717 [label="На вкус оно похоже?",shape=box,color=red];
		j4171322717 -> j1567851532;
	j328057961 [label="Ты пьян?",shape=box,color=red];
		j328057961 -> j1850324928;
	j2463656838 [label="Если бы я мог так легко сбежать. Я тебя не виню.",shape=box,color=blue];
		j2463656838 -> j3856020424;
	j1567851532 [label="Я не знаю! Это было самое неприятное во всей этой истории! Но суть не в этом. Суть была в том, чтобы напиться. А уж насколько это получилось, я понятия не имею. Я, конечно, не трезвый, но -",shape=box,color=blue];
		j1567851532 -> j918049219;
	j1850324928 [label="Возможно. Я определённо не тот, кого они считают трезвым.",shape=box,color=blue];
		j1850324928 -> j3462003101;
	j3856020424 [label="Boolean LyonConfessionFail is now true.",color=orange];
		j3856020424 -> "Chat ends.";
	j918049219 [label="Так что, я полагаю, этого будет достаточно.",shape=box,color=blue];
		j918049219 -> j3488609688;
		j918049219 -> j3542653591;
	j3462003101 [label="Впрочем, в этом и состояла затея. Так что, полагаю, пусть будет так.",shape=box,color=blue];
		j3462003101 -> j3488609688;
		j3462003101 -> j3542653591;
	j3488609688 [label="Что же такого ужасного, что тебе нужно напиться, чтобы это мне сказать?",shape=box,color=red];
		j3488609688 -> j3288688844;
	j3542653591 [label="Ладно, когда захочешь...",shape=box,color=red];
		j3542653591 -> j3288688844;
	j3288688844 [label="Рап... тап... тап...",shape=box,color=blue];
		j3288688844 -> j646892744;
		j3288688844 -> j1147599881;
	j646892744 [label="... Вот как.",shape=box,color=red];
		j646892744 -> j1494324055;
	j1147599881 [label="Этого будет достаточно.",shape=box,color=red];
		j1147599881 -> j1494324055;
	j1494324055 [label="Я знаю совершенно точно, что их не было в моей голове всю мою жизнь. Тэнно, известный как Рэлл, и его опекун Харроу. Невозможно, чтобы они были в стенах дома моего детства.",shape=box,color=blue];
		j1494324055 -> j3461123372;
	j3461123372 [label="Невозможно, чтобы они звучали в моём сознании вместе с шёпотом, искажёнными голосами моих видений все эти годы. И всё же я вижу их там, слышу его там, в своих воспоминаниях.",shape=box,color=blue];
		j3461123372 -> j252073137;
	j252073137 [label="Check boolean LyonTime1",color=orange];
		j252073137 -> j1881287140 [label=true,color=green];
		j252073137 -> j679560744 [label=false,color=brown];
	j1881287140 [label="Я понял всё, что Энтрати сказал о том, как энергия может существовать во времени в нескольких местах одновременно, понимал это философски. Но эмоционально мне это не было понятно, пока я... не ввел сыворотку.",shape=box,color=blue];
		j1881287140 -> j93106488;
	j679560744 [label="Будто в тот самый миг, когда я ввел сыворотку, всё стало единым целым. Когда Энтрати раскрыл себя и всю правду своего существования - ",shape=box,color=blue];
		j679560744 -> j224233152;
	j93106488 [label="Я вижу порой перед своим мысленным взором огромное и неглубокое тихое озеро, простирающееся во все стороны. Чёрное и гладкое, как зеркало для гадания из оникса.",shape=box,color=blue];
		j93106488 -> j3657928148;
	j224233152 [label="Он изложил мне все, что знал о «квантовой запутанности», «суперпозиции», «этернализме» и прочем подобном.",shape=box,color=blue];
		j224233152 -> j3284682744;
	j3657928148 [label="Огромное чёрное озеро, уходящее в бесконечность. Невозможное для постижения.",shape=box,color=blue];
		j3657928148 -> j2214854238;
	j3284682744 [label="Я понимал все это в научном, скорее философском смысле. Но не постиг того сердцем, пока... не ввел сыворотку. Но эмоционально мне это не было понятно, пока... я не ввел сыворотку.",shape=box,color=blue];
		j3284682744 -> j93106488;
	j2214854238 [label="И именно там я бы их нашел. Именно там мы бы встретились. И именно там я бы тоже Их ощущал...",shape=box,color=blue];
		j2214854238 -> j3392758852;
	j3392758852 [label="Их?",shape=box,color=red];
		j3392758852 -> j1457724791;
	j1457724791 [label="Других Харроу... Пустые статуи вещей, эхо отголосков эха... Они тянутся, и тянутся, и тянутся целую вечность во всех направлениях...",shape=box,color=blue];
		j1457724791 -> j1021475109;
	j1021475109 [label="Рэлл поместил себя внутрь одного из них. Растворился в нём. И, тем самым, растворился во всех них...",shape=box,color=blue];
		j1021475109 -> j3494626227;
	j3494626227 [label="Включая меня. Включая того Харроу, который был в сыворотке, создавшей меня.",shape=box,color=blue];
		j3494626227 -> j1563597272;
		j3494626227 -> j2098451095;
	j1563597272 [label="Безда, я даже не осознавал этого...",shape=box,color=red];
		j1563597272 -> j1394866938;
	j2098451095 [label="Ох нет -",shape=box,color=red];
		j2098451095 -> j1394866938;
	j1394866938 [label="Они были рядом со мной, в моём сознании - Рэлл и его Харроу, такие похожие на меня и в то же время совсем иные.",shape=box,color=blue];
		j1394866938 -> j810967034;
	j810967034 [label="Он не боялся. Он был так уверен. Две вещи, которые никогда не были свойственны мне.",shape=box,color=blue];
		j810967034 -> j4150973441;
	j4150973441 [label="Он стоял против Безразличия, не заботясь о том, кем оно является или кем нет. Он просто знал, что нужно делать.",shape=box,color=blue];
		j4150973441 -> j2939061158;
	j2939061158 [label="Даже после всей перенесённой им жестокости. Все эти годы, в «сейчас» и «тогда» той вечности, в тот момент, когда я ввёл серум... в «до» и «после», он был рядом.",shape=box,color=blue];
		j2939061158 -> j3628030101;
	j3628030101 [label="Он был моим другом. Он был моим братом.",shape=box,color=blue];
		j3628030101 -> j2142296178;
	j2142296178 [label="Тогда? В настоящем?",shape=box,color=blue];
		j2142296178 -> j3362273362;
	j3362273362 [label="Я больше не ощущаю его.",shape=box,color=blue];
		j3362273362 -> j3938410806;
		j3362273362 -> j1690963914;
	j3938410806 [label="Он... он покоится с миром, теперь, Лион... он в покое.",shape=box,color=red];
		j3938410806 -> j3182377744;
	j1690963914 [label="О, Лион...",shape=box,color=red];
		j1690963914 -> j1777815955;
	j3182377744 [label="Я знаю. Я почувствовал его уход. И я плакал. Я скучаю по нему так, что больно дышать. Я знаю, что он откликается, во мне - каким то образом, хотя я не до конца понимаю, как именно.",shape=box,color=blue];
		j3182377744 -> j1879705372;
		j3182377744 -> j1484629550;
	j1777815955 [label="Я скучаю по нему так, что больно дышать. Я знаю, что он откликается, во мне - каким то образом, хотя я не до конца понимаю, как именно.",shape=box,color=blue];
		j1777815955 -> j1879705372;
		j1777815955 -> j1484629550;
	j1879705372 [label="Рэлл был сильнейшим из нас. Я рад, что у тебя вообще была возможность его узнать.",shape=box,color=red];
		j1879705372 -> j1138866290;
	j1484629550 [label="Рэлл был отвержен из-за невежества и жестокости детей... он не заслужил того, что с ним случилось.",shape=box,color=red];
		j1484629550 -> j4012051583;
	j1138866290 [label="Я рад, что тоже знал его. А насчёт его силы? Возможно. Возможно и нет. В конце концов, он просто знал, что нужно, и был достаточно силён, чтобы это осуществить.",shape=box,color=blue];
		j1138866290 -> j2168814016;
	j4012051583 [label="Возможно. Но в конце концов он сделал то, что было нужно. И он был достаточно силён, чтобы это осуществить.",shape=box,color=blue];
		j4012051583 -> j2168814016;
	j2168814016 [label="Я думаю, в такие времена мы можем молиться только о том, чтобы быть «достаточно сильными».",shape=box,color=blue];
		j2168814016 -> j143396972;
	j143396972 [label="Увы, того же нельзя сказать об этом вине... оно было очень крепким, просто медленным в своем действии.",shape=box,color=blue];
		j143396972 -> j475051547;
	j475051547 [label="Мне стоит уйти, пока ",shape=box,color=blue];
		j475051547 -> j664081038;
	j664081038 [label="Мне пора идти.",shape=box,color=blue];
		j664081038 -> j111445917;
	j111445917 [label="Check boolean LyonDating",color=orange];
		j111445917 -> j3213849361 [label=true,color=green];
		j111445917 -> j346558344 [label=false,color=brown];
	j3213849361 [label="+20 Chemistry",color=orange];
		j3213849361 -> j4162960873;
