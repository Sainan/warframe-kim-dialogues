	"LyonRank3Convo6 begins." [color=orange];
		"LyonRank3Convo6 begins." -> j17033452;
		"LyonRank3Convo6 begins." -> j1310452999;
	j17033452 [label="Как долго Энтрати был с вами в соборе, прежде чем появился Роут?",shape=box,color=red];
		j17033452 -> j4119989593;
	j1310452999 [label="[Конец.]",shape=box,color=red];
		j1310452999 -> "Chat ends.";
	j4119989593 [label="Почему ты задаёшь мне этот вопрос?",shape=box,color=blue];
		j4119989593 -> j4196769031;
	"Chat ends." [color=orange];
	j4196769031 [label="Evaluate expressions",color=orange];
		j4196769031 -> j2930761581 [label="MarieLyonVisions",color=purple];
		j4196769031 -> j2158231719 [label="MarieLyonVisions",color=purple];
		j4196769031 -> j4052897595 [label="MarieLyonVisions",color=purple];
		j4196769031 -> j1116456932 [label="MarieLyonVisions",color=purple];
		j4196769031 -> j2158231719 [label="LyonVisions1",color=purple];
		j4196769031 -> j4052897595 [label="LyonVisions1",color=purple];
		j4196769031 -> j1116456932 [label="LyonVisions1",color=purple];
		j4196769031 -> j2930761581 [label="LyonVisions1",color=purple];
		j4196769031 -> j2158231719 [label="false",color=purple];
		j4196769031 -> j4052897595 [label="false",color=purple];
	j2930761581 [label="Меня предупреждали, что ты можешь видеть вещи не так, как мы. Но это меня нисколько не тревожит. Мне действительно важно услышать, что ты знаешь.",shape=box,color=red];
		j2930761581 -> j2423677592;
	j2158231719 [label="Мари, похоже, погружена в навязчивую идею насчёт «le Cardinal». А Роут, как видно, его терпеть не может. Я ищу нейтральную сторону. Ты единственный, кто хотя бы приблизился к этому.",shape=box,color=red];
		j2158231719 -> j2291947904;
	j4052897595 [label="Я... не знаю, о чем ещё тебя спросить?",shape=box,color=red];
		j4052897595 -> j1283864778;
	j1116456932 [label="Меня предупреждали, что ты можешь видеть вещи не так, как мы. Но я думаю, ты замечаешь истину там, где другие её не видят.",shape=box,color=red];
		j1116456932 -> j516158138;
	j2423677592 [label="Хм. Тебя не смущает общение с безумцем и кретином? Любопытно. Впрочем, ты, кажется, водишься с говорящими животными и... существами из другого времени. Полагаю, я ничуть не более и не менее нелеп, чем остальные из этой твоей коллекции.",shape=box,color=blue];
		j2423677592 -> j2845885253;
	j2291947904 [label="Как же тебе не хватает разумных вариантов, когда безумец и лунатик твой единственный источник «нейтрального» мнения. Я не могу понять, почему ты утруждаешь себя разговорами со мной.",shape=box,color=blue];
		j2291947904 -> j2845885253;
	j1283864778 [label="Почему ты вообще настаиваешь на разговорах со мной? Ты же понимаешь, тебе ведь в этом нет нужды. Если ты хочешь подружиться с Мари или даже ухаживать за ней, я ей не сторож и не отец. И каковы бы ни были твои намерения по отношению к этому ублюдку Роуту, меня мало что волнует, кроме ответов, которые он мне должен дать.",shape=box,color=blue];
		j1283864778 -> j2845885253;
	j516158138 [label="«Истину». Хотел бы я, чтобы у тебя было понимание того, насколько смешным это звучит для меня в последнее время. Разве тебя не смущает общение с безумцем и кретином? Любопытно. Впрочем, ты, кажется, водишься с говорящими животными и... существами из другого времени. Полагаю, я ничуть не более и не менее нелеп, чем остальные из этой твоей коллекции.",shape=box,color=blue];
		j516158138 -> j2845885253;
	j2845885253 [label="Evaluate expressions",color=orange];
		j2845885253 -> j3651826253 [label="LyonFirstFlirt",color=purple];
		j2845885253 -> j3651826253 [label="DrifterLyon",color=purple];
		j2845885253 -> j430460578 [label="LyonOffer",color=purple];
		j2845885253 -> j2829883151 [label="false",color=purple];
	j3651826253 [label="И прошу, избавь нас обоих от... ещё одного неловкого момента, хорошо? Я знаю, что тобой были названы причины из-за которых начался разговор со мной. И хотя я нахожу это лестным, я также нахожу это до смешного неискренним.",shape=box,color=blue];
		j3651826253 -> j1874696680;
		j3651826253 -> j2489681560;
		j3651826253 -> j1604954989;
	j430460578 [label="И прошу, избавь нас обоих от очередной лекции на тему, как ты желаешь «помочь» мне, ладно? Я уверен, ты стремишься к доброму, но всё это лишь раздражает своей нелепой неискренностью.",shape=box,color=blue];
		j430460578 -> j1874696680;
		j430460578 -> j2489681560;
		j430460578 -> j1604954989;
	j2829883151 [label="И прошу, избавь нас обоих от длинных лекций о том, как ты желаешь «оказать помощь» мне или как ты «хочешь быть мне другом». Я уверен, ты стремишься к доброму, но всё это лишь раздражает своей нелепой неискренностью.",shape=box,color=blue];
		j2829883151 -> j1874696680;
		j2829883151 -> j2489681560;
		j2829883151 -> j1604954989;
	j1874696680 [label="Неискренним, потому что ты думаешь, что я не имею в виду то, что говорю, или неискренним, потому что ты думаешь, что я не могу этого сказать о тебе?",shape=box,color=red];
		j1874696680 -> j3113857297;
	j2489681560 [label="Священник, все мои желания заключались в том, чтобы услышать историю о том, как долго Энтрати притворялся кардиналом. Вот и всё.",shape=box,color=red];
		j2489681560 -> j1151069184;
	j1604954989 [label="Что ты имеешь в виду под «неискренним»? Ты хочешь сказать меня, что я лгу?",shape=box,color=red];
		j1604954989 -> j5625625;
	j3113857297 [label="Ни то, ни другое. Твои слова являются проявлением снисхождения, в котором я не нуждаюсь и которое мне не нужно.",shape=box,color=blue];
		j3113857297 -> j865909184;
		j3113857297 -> j4126636839;
	j1151069184 [label="Совершенно верно. Три года, два месяца и одиннадцать дней он служил в нашем Соборе как Cardinal Dimanche. И всё это время Мари и я служили ему, не ведая о его планах для нас.",shape=box,color=blue];
		j1151069184 -> j2083901464;
	j5625625 [label="Evaluate expressions",color=orange];
		j5625625 -> j1419606998 [label="DrifterLiar",color=purple];
		j5625625 -> j4199273758 [label="LyonSuspicious",color=purple];
		j5625625 -> j749725373 [label="false",color=purple];
	j865909184 [label="Как Мари мирится с этим...?",shape=box,color=red];
		j865909184 -> j431953491;
	j4126636839 [label="Ты думаешь, что любой, кто решает пообщаться с тобой, совершает акт снисхождения?",shape=box,color=red];
		j4126636839 -> j3835396889;
	j2083901464 [label="Я знаю твои вопросы, ещё прежде чем ты их задашь. Что он замышлял? Заразил ли он город, как, как я слышал, он сделал с Хёльванией? Каковы были его планы? Его открытия?",shape=box,color=blue];
		j2083901464 -> j2443249313;
	j1419606998 [label="Хочешь ли ты в чём-то признаться, Скиталец? Хочешь ли ты принести покаяние?",shape=box,color=blue];
		j1419606998 -> j4152705970;
	j4199273758 [label="Хм. Нет. Пока нет, пожалуй.",shape=box,color=blue];
		j4199273758 -> j749725373;
	j749725373 [label="Твоя неискренность не является ложью. Это подразумевается как снисхождение. В снисхождении я не нуждаюсь и не хочу кого-то об это просить. ",shape=box,color=blue];
		j749725373 -> j865909184;
		j749725373 -> j4126636839;
	j431953491 [label="Лучше спроси её об этом сам. Я часто задавал себе тот же вопрос.",shape=box,color=blue];
		j431953491 -> "Chat ends.";
	j3835396889 [label="Просто? Да.",shape=box,color=blue];
		j3835396889 -> j3994772085;
	j2443249313 [label="На это я скажу, ты будешь разочарован. За эти три года, два месяца и одиннадцать дней? Он проповедовал. Он изучал. Он отдыхал. И он молился.",shape=box,color=blue];
		j2443249313 -> j1707089388;
		j2443249313 -> j629427320;
		j2443249313 -> j4034899954;
	j4152705970 [label="Это ни к чему не обязывает. Тебе захотелось прийти на этот разговор не в поисках прощения, и твоя прежняя ложь не отличается от твоей нынешней неискренности.",shape=box,color=blue];
		j4152705970 -> j739115448;
	j3994772085 [label="Boolean LyonHate1 is now true.",color=orange];
		j3994772085 -> j1897425375;
		j3994772085 -> j1128512380;
		j3994772085 -> j835364796;
	j1707089388 [label="Когда он успел превратить вас в протофреймы?",shape=box,color=red];
		j1707089388 -> j1699112661;
	j629427320 [label="Мне очень трудно представить себе молящегося Энтрати.",shape=box,color=red];
		j629427320 -> j1174036104;
	j4034899954 [label="Значит, у него был... 	длительный творческий перерыв?!",shape=box,color=red];
		j4034899954 -> j2706668882;
	j739115448 [label="То, что ты сейчас говоришь, выглядит как всего лишь снисхождение. В снисхождении я не нуждаюсь и не хочу кого-то об это просить.",shape=box,color=blue];
		j739115448 -> j865909184;
		j739115448 -> j4126636839;
	j1897425375 [label="Об этом стоит поговорить в другой раз - я чувствую, что этот разговор выходит из-под контроля.",shape=box,color=red];
		j1897425375 -> j578961159;
	j1128512380 [label="А как насчёт Мари...?",shape=box,color=red];
		j1128512380 -> j2869239138;
	j835364796 [label="Ты, должно быть, очень плохого мнения о себе.",shape=box,color=red];
		j835364796 -> j461133945;
	j1699112661 [label="После этих трех лет и нескольких с лишним дней он исчез во время ужасной бури. Такой же, как и та, из которой он появился.",shape=box,color=blue];
		j1699112661 -> j3307858394;
	j1174036104 [label="Это невозможно понять, что творится в голове у другого человека. Он стоял на коленях у алтаря, склонив голову. Молился ли он? Или просто погрузился в свои мысли? Я не знаю.",shape=box,color=blue];
		j1174036104 -> j1699112661;
	j2706668882 [label="+5 Chemistry",color=orange];
		j2706668882 -> j1683238755;
	j578961159 [label="+5 Chemistry",color=orange];
		j578961159 -> j597659354;
	j2869239138 [label="Мари могла бы усадить бешеного медведя к себе на колени и позволить ему перегрызть ей горло, если бы думала, что это на мгновение успокоит животное.",shape=box,color=blue];
		j2869239138 -> j3842269285;
	j461133945 [label="Я бы счёл это непоколебимой приверженностью прагматизму, но определяй это как хочешь.",shape=box,color=blue];
		j461133945 -> j3841312252;
	j3307858394 [label="Evaluate expressions",color=orange];
		j3307858394 -> j3656939004 [label="MarieLyonVisions",color=purple];
		j3307858394 -> j3656939004 [label="LyonVisions1",color=purple];
		j3307858394 -> j2099355310 [label="false",color=purple];
	j1683238755 [label="Хех. Я не думал об этом в таком ключе, но да, возможно, так оно и было. Это приводит всех вас в бешенство. Кажется, это соответствует тому немногому, что мы знаем о нём на самом деле.",shape=box,color=blue];
		j1683238755 -> j1699112661;
	j597659354 [label="Вероятно, это мудрое решение. У тебя был вопрос о «Cardinal Dimanche» и его пребывании в Соборе.",shape=box,color=blue];
		j597659354 -> j2284521652;
	j3842269285 [label="Она необыкновенно прекрасная душа, и я буду защищать её до последнего вздоха.",shape=box,color=blue];
		j3842269285 -> j3841312252;
	j3841312252 [label="+5 Chemistry",color=orange];
		j3841312252 -> j3586534123;
	j3656939004 [label="Хотя я прекрасно понимаю, что для других эта буря не имела значения, для меня она была весьма отчетливой.",shape=box,color=blue];
		j3656939004 -> j2099355310;
	j2099355310 [label="Ровно через год он появился в последний раз, и вот... Роут, каким ты видишь его сейчас, лежит у его ног без сознания.",shape=box,color=blue];
		j2099355310 -> j2370601822;
	j2284521652 [label="Три года, два месяца и одиннадцать дней он служил в нашем Соборе как Cardinal Dimanche. И всё это время Мари и я служили ему, не ведая о его планах для нас.",shape=box,color=blue];
		j2284521652 -> j2083901464;
	j3586534123 [label="Но именно этого тебе и стоит ожидать, ведь задавать простой вопрос безумцу часто приводит к заблуждениям. Позволь мне вернуть нас к твоей изначальной теме и увести разговор подальше от моей собственной.",shape=box,color=blue];
		j3586534123 -> j2284521652;
	j2370601822 [label="Дьявол во плоти, или так казалось. Именно тогда Энтрати открыл нам правду о том, кто он такой, когда явился, и какое истинное задание он нам поручил.",shape=box,color=blue];
		j2370601822 -> j2459589384;
	j2459589384 [label="Это он избрал нас обоих для самой «священной миссии».",shape=box,color=blue];
		j2459589384 -> j4071058398;
		j2459589384 -> j356609176;
	j4071058398 [label="К чему эти кавычки?",shape=box,color=red];
		j4071058398 -> j1141707334;
	j356609176 [label="Звучит так, будто ты ему не веришь.",shape=box,color=red];
		j356609176 -> j1141707334;
	j1141707334 [label="Я узнал достаточно, чтобы усомниться в том, что Энтрати соблюдает приверженность к чему-либо святому, будь то природа или какое-нибудь божество, или к чему бы то ни было... если подобные вещи вообще существуют...",shape=box,color=blue];
		j1141707334 -> j3893999243;
		j1141707334 -> j2059675782;
	j3893999243 [label="Если подобные вещи вообще существуют? Лион, что ты имеешь в виду?",shape=box,color=red];
		j3893999243 -> j1261791867;
	j2059675782 [label="Продолжай.",shape=box,color=red];
		j2059675782 -> j316836532;
	j1261791867 [label="Boolean LyonFaith2 is now true.",color=orange];
		j1261791867 -> j3757059224;
	j316836532 [label="Мари легко приняла сыворотку. Конечно, она это сделала. Как она могла не сделать этого? И как я мог не последовать за ней? Как я мог не искать истину, куда бы она ни привела?",shape=box,color=blue];
		j316836532 -> j1813802388;
	j3757059224 [label="Оставим это на иной раз, прошу тебя.",shape=box,color=blue];
		j3757059224 -> j316836532;
	j1813802388 [label="Boolean LyonSerum1 is now true.",color=orange];
		j1813802388 -> j1514677418;
		j1813802388 -> j2763895640;
		j1813802388 -> j3403307418;
	j1514677418 [label="Мне кажется, она всё ещё слишком сильно боготворит Энтрати.",shape=box,color=red];
		j1514677418 -> j705375150;
	j2763895640 [label="Что произошло потом?",shape=box,color=red];
		j2763895640 -> j1237832793;
	j3403307418 [label="Ты сожалеешь об этом?",shape=box,color=red];
		j3403307418 -> j1978299472;
	j705375150 [label="Boolean LyonMarieEntrati is now true.",color=orange];
		j705375150 -> j2674363738;
	j1237832793 [label="Роут очнулся. Сначала он едва помнил своё имя. Энтрати сказал последнюю фразу этому ублюдку: «Уриэль, Еретик Ксеты, в изгнании, ответь - могут ли Орокин когда-либо быть прощены?»",shape=box,color=blue];
		j1237832793 -> j3772469098;
	j1978299472 [label="Я сожалею обо всём, Скиталец. Да, конечно, сожалею. Но сделал бы я это снова? Да, конечно, сделал бы. Я не могу оставить Мари в одиночестве.",shape=box,color=blue];
		j1978299472 -> j3831739410;
	j2674363738 [label="Здесь мы едины во мнении. Но я также не могу её за это осуждать. Дай ей время. Она придёт к пониманию. Она невероятно умна, Скиталец. Не стоит принимать её за простушку.",shape=box,color=blue];
		j2674363738 -> j3831739410;
	j3772469098 [label="Энтрати тогда покинул нас навсегда. И оставил Роута с нами, теперь уже изменившегося в того, кого ты видишь сейчас - куда лучше подготовленным к борьбе с этим своенравным дьяволом.",shape=box,color=blue];
		j3772469098 -> j2537094158;
	j3831739410 [label="Дабы закончить эту историю… Энтрати тогда покинул нас навсегда. И оставил Роута с нами, теперь уже изменившегося в того, кого ты видишь сейчас - куда лучше подготовленным к борьбе с этим своенравным дьяволом.",shape=box,color=blue];
		j3831739410 -> j2537094158;
	j2537094158 [label="Остальное, боюсь, это история, которой придется подождать. М. Лойд нуждается в POM-2, и я с радостью уступлю его. Надеюсь, это помогло прояснить хотя бы часть твоих вопросов.",shape=box,color=blue];
		j2537094158 -> j970756976;
		j2537094158 -> j2582321080;
	j970756976 [label="И собрал вдвое больше этой суммы на новых.",shape=box,color=red];
		j970756976 -> j1698637853;
	j2582321080 [label="Так и есть, спасибо.",shape=box,color=red];
		j2582321080 -> j236182164;
	j1698637853 [label="+15 Chemistry",color=orange];
		j1698637853 -> j1280714698;
	j236182164 [label="+10 Chemistry",color=orange];
		j236182164 -> j1282096254;
	j1280714698 [label="Тогда я выполнил свой долг священника. Желаю тебе спокойной ночи.",shape=box,color=blue];
		j1280714698 -> j2038856903;
	j1282096254 [label="Тогда я пожелаю тебе спокойной ночи.",shape=box,color=blue];
		j1282096254 -> j2038856903;
	j2038856903 [label="-О. Лион Аллард",shape=box,color=blue];
		j2038856903 -> "Chat ends.";
}