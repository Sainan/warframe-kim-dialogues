digraph {
	568 [label="LyonRank3Convo6 begins.",color=orange];
		568 -> 570;
		568 -> 569;
	570 [label="Как долго Энтрати был с вами в соборе, прежде чем появился Роут?",shape=box,color=red];
		570 -> 572;
	569 [label="[Конец.]",shape=box,color=red];
		569 -> 571;
	572 [label="Почему ты задаёшь мне этот вопрос?",shape=box,color=blue];
		572 -> 573;
	571 [label="Chat ends.",color=orange];
	573 [label="Evaluate expressions",color=orange];
		573 -> 577 [label="MarieLyonVisions",color=purple];
		573 -> 574 [label="MarieLyonVisions",color=purple];
		573 -> 575 [label="MarieLyonVisions",color=purple];
		573 -> 576 [label="MarieLyonVisions",color=purple];
		573 -> 574 [label="LyonVisions1",color=purple];
		573 -> 575 [label="LyonVisions1",color=purple];
		573 -> 576 [label="LyonVisions1",color=purple];
		573 -> 577 [label="LyonVisions1",color=purple];
		573 -> 574 [label="false",color=purple];
		573 -> 575 [label="false",color=purple];
	577 [label="Меня предупреждали, что ты можешь видеть вещи не так, как мы. Но это меня нисколько не тревожит. Мне действительно важно услышать, что ты знаешь.",shape=box,color=red];
		577 -> 581;
	574 [label="Мари, похоже, погружена в навязчивую идею насчёт «le Cardinal». А Роут, как видно, его терпеть не может. Я ищу нейтральную сторону. Ты единственный, кто хотя бы приблизился к этому.",shape=box,color=red];
		574 -> 578;
	575 [label="Я... не знаю, о чем ещё тебя спросить?",shape=box,color=red];
		575 -> 579;
	576 [label="Меня предупреждали, что ты можешь видеть вещи не так, как мы. Но я думаю, ты замечаешь истину там, где другие её не видят.",shape=box,color=red];
		576 -> 580;
	581 [label="Хм. Тебя не смущает общение с безумцем и лунатиком? Любопытно. Впрочем, ты, кажется, водишься с говорящими животными и... существами из другого времени. Полагаю, я ничуть не более и не менее нелеп, чем остальные из этой твоей коллекции.",shape=box,color=blue];
		581 -> 582;
	578 [label="Как же тебе не хватает разумных вариантов, когда безумец и лунатик твой единственный источник «нейтрального» мнения. Я не могу понять, почему ты утруждаешь себя разговорами со мной.",shape=box,color=blue];
		578 -> 582;
	579 [label="Почему ты вообще настаиваешь на разговорах со мной? Ты же понимаешь, тебе ведь в этом нет нужды. Если ты хочешь подружиться с Мари или даже ухаживать за ней, я ей не сторож и не отец. И каковы бы ни были твои намерения по отношению к этому ублюдку Роуту, меня мало что волнует, кроме ответов, которые он мне должен дать.",shape=box,color=blue];
		579 -> 582;
	580 [label="«Истину». Хотел бы я, чтобы у тебя было понимание того, насколько смешным это звучит для меня в последнее время. Разве тебя не смущает общение с безумцем и лунатиком? Любопытно. Впрочем, ты, кажется, водишься с говорящими животными и... существами из другого времени. Полагаю, я ничуть не более и не менее нелеп, чем остальные из этой твоей коллекции.",shape=box,color=blue];
		580 -> 582;
	582 [label="Evaluate expressions",color=orange];
		582 -> 585 [label="LyonFirstFlirt",color=purple];
		582 -> 585 [label="DrifterLyon",color=purple];
		582 -> 584 [label="LyonOffer",color=purple];
		582 -> 583 [label="false",color=purple];
	585 [label="И прошу, избавь нас обоих от... ещё одного неловкого момента, хорошо? Я знаю, что тобой были названы причины из-за которых начался разговор со мной. И хотя я нахожу это лестным, я также нахожу это до смешного неискренним.",shape=box,color=blue];
		585 -> 586;
		585 -> 587;
		585 -> 588;
	584 [label="И прошу, избавь нас обоих от очередной лекции на тему, как ты желаешь «помочь» мне, ладно? Я уверен, ты стремишься к доброму, но всё это лишь раздражает своей нелепой неискренностью.",shape=box,color=blue];
		584 -> 586;
		584 -> 587;
		584 -> 588;
	583 [label="И прошу, избавь нас обоих от длинных лекций о том, как ты желаешь «оказать помощь» мне или как ты «хочешь быть мне другом». Я уверен, ты стремишься к доброму, но всё это лишь раздражает своей нелепой неискренностью.",shape=box,color=blue];
		583 -> 586;
		583 -> 587;
		583 -> 588;
	586 [label="Неискренним, потому что ты думаешь, что я не имею в виду то, что говорю, или неискренним, потому что ты думаешь, что я не могу этого сказать о тебе?",shape=box,color=red];
		586 -> 589;
	587 [label="Священник, все мои желания заключались в том, чтобы услышать историю о том, как долго Энтрати притворялся кардиналом. Вот и всё.",shape=box,color=red];
		587 -> 590;
	588 [label="Что ты имеешь в виду под «неискренним»? Ты хочешь сказать меня, что я лгу?",shape=box,color=red];
		588 -> 591;
	589 [label="Ни то, ни другое. Твои слова являются проявлением снисхождения, в котором я не нуждаюсь и которое мне не нужно.",shape=box,color=blue];
		589 -> 592;
		589 -> 593;
	590 [label="Совершенно верно. Три года, два месяца и одиннадцать дней он служил в нашем Соборе как Cardinal Dimanche. И всё это время Мари и я служили ему, не ведая о его планах для нас.",shape=box,color=blue];
		590 -> 594;
	591 [label="Evaluate expressions",color=orange];
		591 -> 597 [label="DrifterLiar",color=purple];
		591 -> 596 [label="LyonSuspicious",color=purple];
		591 -> 595 [label="false",color=purple];
	592 [label="Как Мари мирится с этим...?",shape=box,color=red];
		592 -> 598;
	593 [label="Ты думаешь, что любой, кто решает пообщаться с тобой, совершает акт снисхождения?",shape=box,color=red];
		593 -> 599;
	594 [label="Я знаю твои вопросы, ещё прежде чем ты их задашь. Что он замышлял? Заразил ли он город, как, как я слышал, он сделал с Хёльванией? Каковы были его планы? Его открытия?",shape=box,color=blue];
		594 -> 600;
	597 [label="Хочешь ли ты в чём-то признаться, Скиталец? Хочешь ли ты принести покаяние?",shape=box,color=blue];
		597 -> 601;
	596 [label="Хм. Нет. Пока нет, пожалуй.",shape=box,color=blue];
		596 -> 595;
	595 [label="Твоя неискренность не является ложью. Это подразумевается как снисхождение. В снисхождении я не нуждаюсь и не хочу кого-то об это просить. ",shape=box,color=blue];
		595 -> 592;
		595 -> 593;
	598 [label="Лучше спроси её об этом сам. Я часто задавал себе тот же вопрос.",shape=box,color=blue];
		598 -> 602;
	599 [label="Просто? Да.",shape=box,color=blue];
		599 -> 603;
	600 [label="На это я скажу, ты будешь разочарован. За эти три года, два месяца и одиннадцать дней? Он проповедовал. Он изучал. Он отдыхал. И он молился.",shape=box,color=blue];
		600 -> 604;
		600 -> 605;
		600 -> 606;
	601 [label="Это ни к чему не обязывает. Тебе захотелось прийти на этот разговор не в поисках прощения, и твоя прежняя ложь не отличается от твоей нынешней неискренности.",shape=box,color=blue];
		601 -> 607;
	602 [label="Chat ends.",color=orange];
	603 [label="Update boolean LyonHate1",color=orange];
		603 -> 608;
		603 -> 609;
		603 -> 610;
	604 [label="Когда он успел превратить вас в протофреймы?",shape=box,color=red];
		604 -> 611;
	605 [label="Мне очень трудно представить себе молящегося Энтрати.",shape=box,color=red];
		605 -> 612;
	606 [label="Значит, у него был... 	длительный творческий перерыв?!",shape=box,color=red];
		606 -> 613;
	607 [label="То, что ты сейчас говоришь, выглядит как всего лишь снисхождение. В снисхождении я не нуждаюсь и не хочу кого-то об это просить.",shape=box,color=blue];
		607 -> 592;
		607 -> 593;
	608 [label="Об этом стоит поговорить в другой раз - я чувствую, что этот разговор выходит из-под контроля.",shape=box,color=red];
		608 -> 614;
	609 [label="А как насчёт Мари...?",shape=box,color=red];
		609 -> 615;
	610 [label="Ты, должно быть, очень плохого мнения о себе.",shape=box,color=red];
		610 -> 616;
	611 [label="После этих трех лет и нескольких с лишним дней он исчез во время ужасной бури. Такой же, как и та, из которой он появился.",shape=box,color=blue];
		611 -> 617;
	612 [label="Это невозможно понять, что творится в голове у другого человека. Он стоял на коленях у алтаря, склонив голову. Молился ли он? Или просто погрузился в свои мысли? Я не знаю.",shape=box,color=blue];
		612 -> 611;
	613 [label="+5 Chemistry",color=orange];
		613 -> 618;
	614 [label="+5 Chemistry",color=orange];
		614 -> 619;
	615 [label="Мари могла бы усадить бешеного медведя к себе на колени и позволить ему перегрызть ей горло, если бы думала, что это на мгновение успокоит животное.",shape=box,color=blue];
		615 -> 620;
	616 [label="Я бы счёл это непоколебимой приверженностью прагматизму, но определяй это как хочешь.",shape=box,color=blue];
		616 -> 621;
	617 [label="Evaluate expressions",color=orange];
		617 -> 622 [label="MarieLyonVisions",color=purple];
		617 -> 622 [label="LyonVisions1",color=purple];
		617 -> 623 [label="false",color=purple];
	618 [label="Хех. Я не думал об этом в таком ключе, но да, возможно, так оно и было. Это приводит всех вас в бешенство. Кажется, это соответствует тому немногому, что мы знаем о нём на самом деле.",shape=box,color=blue];
		618 -> 611;
	619 [label="Вероятно, это мудрое решение. У тебя был вопрос о «Cardinal Dimanche» и его пребывании в Соборе.",shape=box,color=blue];
		619 -> 624;
	620 [label="Она необыкновенно прекрасная душа, и я буду защищать её до последнего вздоха.",shape=box,color=blue];
		620 -> 621;
	621 [label="+5 Chemistry",color=orange];
		621 -> 625;
	622 [label="Хотя я прекрасно понимаю, что для других эта буря не имела значения, для меня она была весьма отчетливой.",shape=box,color=blue];
		622 -> 623;
	623 [label="Ровно через год он появился в последний раз, и вот... Роут, каким ты видишь его сейчас, лежит у его ног без сознания.",shape=box,color=blue];
		623 -> 626;
	624 [label="Три года, два месяца и одиннадцать дней он служил в нашем Соборе как Cardinal Dimanche. И всё это время Мари и я служили ему, не ведая о его планах для нас.",shape=box,color=blue];
		624 -> 594;
	625 [label="Но именно этого тебе и стоит ожидать, ведь задавать простой вопрос безумцу часто приводит к заблуждениям. Позволь мне вернуть нас к твоей изначальной теме и увести разговор подальше от моей собственной.",shape=box,color=blue];
		625 -> 624;
	626 [label="Дьявол во плоти, или так казалось. Именно тогда Энтрати открыл нам правду о том, кто он такой, когда явился, и какое истинное задание он нам поручил.",shape=box,color=blue];
		626 -> 627;
	627 [label="Это он избрал нас обоих для самой «священной миссии».",shape=box,color=blue];
		627 -> 628;
		627 -> 629;
	628 [label="К чему эти кавычки?",shape=box,color=red];
		628 -> 630;
	629 [label="Звучит так, будто ты ему не веришь.",shape=box,color=red];
		629 -> 630;
	630 [label="Я узнал достаточно, чтобы усомниться в том, что Энтрати соблюдает приверженность к чему-либо святому, будь то природа или какое-нибудь божество, или к чему бы то ни было... если подобные вещи вообще существуют...",shape=box,color=blue];
		630 -> 631;
		630 -> 632;
	631 [label="Если подобные вещи вообще существуют? Лион, что ты имеешь в виду?",shape=box,color=red];
		631 -> 633;
	632 [label="Продолжай.",shape=box,color=red];
		632 -> 634;
	633 [label="Update boolean LyonFaith2",color=orange];
		633 -> 635;
	634 [label="Мари легко приняла сыворотку. Конечно, она это сделала. Как она могла не сделать этого? И как я мог не последовать за ней? Как я мог не искать истину, куда бы она ни привела?",shape=box,color=blue];
		634 -> 636;
	635 [label="Оставим это на иной раз, прошу тебя.",shape=box,color=blue];
		635 -> 634;
	636 [label="Update boolean LyonSerum1",color=orange];
		636 -> 637;
		636 -> 638;
		636 -> 639;
	637 [label="Мне кажется, она всё ещё слишком сильно боготворит Энтрати.",shape=box,color=red];
		637 -> 640;
	638 [label="Что произошло потом?",shape=box,color=red];
		638 -> 641;
	639 [label="Ты сожалеешь об этом?",shape=box,color=red];
		639 -> 642;
	640 [label="Update boolean LyonMarieEntrati",color=orange];
		640 -> 643;
	641 [label="Роут очнулся. Сначала он едва помнил своё имя. Энтрати сказал последнюю фразу этому ублюдку: «Уриэль, Еретик Ксеты, в изгнании, ответь - могут ли Орокин когда-либо быть прощены?»",shape=box,color=blue];
		641 -> 644;
	642 [label="Я сожалею обо всём, Скиталец. Да, конечно, сожалею. Но сделал бы я это снова? Да, конечно, сделал бы. Я не могу оставить Мари в одиночестве.",shape=box,color=blue];
		642 -> 645;
	643 [label="Здесь мы едины во мнении. Но я также не могу её за это осуждать. Дай ей время. Она придёт к пониманию. Она невероятно умна, Скиталец. Не стоит принимать её за простушку.",shape=box,color=blue];
		643 -> 645;
	644 [label="Энтрати тогда покинул нас навсегда. И оставил Роута с нами, теперь уже изменившегося в того, кого ты видишь сейчас - куда лучше подготовленным к борьбе с этим своенравным дьяволом.",shape=box,color=blue];
		644 -> 646;
	645 [label="Дабы закончить эту историю… Энтрати тогда покинул нас навсегда. И оставил Роута с нами, теперь уже изменившегося в того, кого ты видишь сейчас - куда лучше подготовленным к борьбе с этим своенравным дьяволом.",shape=box,color=blue];
		645 -> 646;
	646 [label="Остальное, боюсь, это история, которой придется подождать. М. Лойд нуждается в POM-2, и я с радостью уступлю его. Надеюсь, это помогло прояснить хотя бы часть твоих вопросов.",shape=box,color=blue];
		646 -> 647;
		646 -> 648;
	647 [label="И собрал вдвое больше этой суммы на новых.",shape=box,color=red];
		647 -> 649;
	648 [label="Так и есть, спасибо.",shape=box,color=red];
		648 -> 650;
	649 [label="+15 Chemistry",color=orange];
		649 -> 651;
	650 [label="+10 Chemistry",color=orange];
		650 -> 652;
	651 [label="Тогда я выполнил свой долг священника. Желаю тебе спокойной ночи.",shape=box,color=blue];
		651 -> 653;
	652 [label="Тогда я пожелаю тебе спокойной ночи.",shape=box,color=blue];
		652 -> 653;
	653 [label="-О. Лион Аллард",shape=box,color=blue];
		653 -> 654;
	654 [label="Chat ends.",color=orange];
}