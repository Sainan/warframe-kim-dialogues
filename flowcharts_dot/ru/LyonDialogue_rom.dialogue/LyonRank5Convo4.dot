	2346 [label="[Разговор пропущен из-за ранее установленного предупреждения.]",shape=box,color=blue];
		2346 -> 2348;
	1624 [label="Я не думаю, что смогу адекватно описать тебе, каким странным был момент введения сыворотки, mon miracle.",shape=box,color=blue];
		1624 -> 1628;
		1624 -> 1629;
		1624 -> 1630;
		1624 -> 1627;
	1625 [label="Я не думаю, что смогу адекватно описать тебе, каким странным был момент введения сыворотки, друг мой.",shape=box,color=blue];
		1625 -> 1628;
		1625 -> 1629;
		1625 -> 1630;
		1625 -> 1627;
	1626 [label="Chat ends.",color=orange];
	2348 [label="Update boolean LyonRell3",color=orange];
		2348 -> 2350;
	1628 [label="Мне говорили, что это невероятно больно.",shape=box,color=red];
		1628 -> 1632;
	1629 [label="Мне даже невозможно вообразить себе такое. ",shape=box,color=red];
		1629 -> 1633;
	1630 [label="[Внимание: краткие упоминания о членовредительстве и жестком обращении с детьми. Нажмите здесь, чтобы закончить. Это не приведёт к потере «Симпатии» с Лионом.]",shape=box,color=red];
		1630 -> 1634;
	1627 [label="[Конец.]",shape=box,color=red];
		1627 -> 1631;
	2350 [label="Update boolean LyonWillDate",color=orange];
		2350 -> 2351;
	1632 [label="Полагаю, что да. Хотя мне кажется, у меня уже были годы практики в этом деле, и потому предупреждения Энтрати произвели на меня гораздо большее впечатление, чем оно оказалось на самом деле.",shape=box,color=blue];
		1632 -> 1633;
	1633 [label="Мы с Мари решили принимать сыворотки наедине. Я попросил её позволить мне пройти через изменение первым, а потом помочь ей пройти через это самостоятельно, но она, конечно же, наотрез отказалась.",shape=box,color=blue];
		1633 -> 1636;
	1634 [label="+20 Chemistry",color=orange];
		1634 -> 1637;
	1631 [label="Update boolean LyonConfessionFail",color=orange];
		1631 -> 1635;
	2351 [label="Chat ends. Next chat will be Lyon5FaithDay2.",color=orange];
	1636 [label="Насмехаясь над самой мыслью о том, что я могу куда-то пойти или что-то сделать без неё, твердо стоящей рядом, она направилась в свои покои.",shape=box,color=blue];
		1636 -> 1638;
	1637 [label="Update boolean LyonFamilySuccess",color=orange];
		1637 -> 1639;
	1635 [label="Chat ends.",color=orange];
	1638 [label="Я запер дверь, разделся и сел посреди комнаты, как можно дальше от любых предметов, прежде чем вонзить себе иглу в бок.",shape=box,color=blue];
		1638 -> 1640;
	1639 [label="Update boolean LyonRell3",color=orange];
		1639 -> 1641;
	1640 [label="Я видел, что Заражение сделало с Роутом, как оно перекручивало его плоть вместе со всем, что было на нём в тот момент. Я не желал оказаться жертвой той же участи.",shape=box,color=blue];
		1640 -> 1642;
	1641 [label="Update boolean LyonFaith3Unknown",color=orange];
		1641 -> 1643;
	1642 [label="Когда агония закончилась, моё и без того страдающее зрение... размылось. Как будто... раздвоилось. Словно я видел всё вдвойне.",shape=box,color=blue];
		1642 -> 1644;
	1643 [label="Chat ends. Next chat will be Lyon5FaithDay2.",color=orange];
	1644 [label="Однако я очень горжусь своей стойкостью, потому что мне удалось натянуть свои штаны прежде, чем меня вывернуло и я потерял сознание.",shape=box,color=blue];
		1644 -> 1645;
	1645 [label="Когда я очнулся, я обнаружил, что не один. Однако я не лежал на полу в своих покоях. Я сидел в своей детской спальне на скрипучем старом полу, который мне так хорошо был знаком.",shape=box,color=blue];
		1645 -> 1646;
	1646 [label="А рядом со мной сидел молодой человек. Позади него стояла фигура, которую я теперь знаю как Харроу. Молодой человек держал в руках маленькую деревянную фигурку. Её конечности были сочленёнными - краска давно облупилась, сохранившись разве что в складках и трещинах. Она принадлежала моему отцу. Это была фигурка солдат.",shape=box,color=blue];
		1646 -> 1647;
	1647 [label="Это была единственная игрушка, что по праву принадлежала мне, когда я был ребёнком.",shape=box,color=blue];
		1647 -> 1648;
		1647 -> 1649;
	1648 [label="В детстве у меня была похожая фигурка. Это была одна из моих любимых игрушек.",shape=box,color=red];
		1648 -> 1650;
	1649 [label="Рэлл?",shape=box,color=red];
		1649 -> 1651;
	1650 [label="Так мне говорили. Полагаю, мой случай в итоге оказался более благоприятным.",shape=box,color=blue];
		1650 -> 1652;
		1650 -> 1653;
		1650 -> 1654;
	1651 [label="Действительно.",shape=box,color=blue];
		1651 -> 1655;
	1652 [label="С Траксом всё непросто. Я бы предпочёл не вдаваться в подробности.",shape=box,color=red];
		1652 -> 1656;
	1653 [label="На самом деле, это была не его вина. Он был именно тем, кем мне нужно было видеть его в тот момент.",shape=box,color=red];
		1653 -> 1657;
	1654 [label="Всё в порядке. Он прогрессирует. Медленно. Каким-то образом. Даже то, что казалось невозможным, может измениться.",shape=box,color=red];
		1654 -> 1658;
	1655 [label="Молодой человек и его молчаливый страж, которые посетили меня в моём сне - в моём сознании, - были мне одновременно незнакомы и в то же время знакомы так, словно мы выросли вместе, как родственники.",shape=box,color=blue];
		1655 -> 1659;
	1656 [label="Совершенно верно. Мы могли бы здесь часами рассуждать о моральных и теологических аспектах Дувири.",shape=box,color=blue];
		1656 -> 1655;
	1657 [label="Когда я представляю себе хотя бы самую малость, что бы я сотворил на твоём месте, меня охватывает ужас. Но разговор мог бы затянуть нас на часы, обсуждая подобные вещи.",shape=box,color=blue];
		1657 -> 1655;
	1658 [label="Если он проявляет признаки перемен, и он является порождением твоих эмоций, возможно, это свидетельствует о чем-то другом. Но, пожалуй, это тема для отдельного разговора.",shape=box,color=blue];
		1658 -> 1655;
	1659 [label="Простите меня за излишне вычурную метафору, но это было похоже на то, как если бы мы были тремя деревьями, чьи корни так переплелись, что различить их стало невозможно -",shape=box,color=blue];
		1659 -> 1660;
	1660 [label="который просто появился на свет в таком состоянии. Я мог вспомнить свою жизнь без Рэлл и Харроу. И всё же они были здесь. В каждый момент - в каждом случае - рядом со мной.",shape=box,color=blue];
		1660 -> 1661;
	1661 [label="К слову сказать, мне так хотелось бы поговорить об этом с Энтрати, я отчаянно хочу понять, какая наука лежит в основе всего этого - прости за невольный каламбур - но когда мы наконец оправились после нашего изменения, Энтрати уже не было.",shape=box,color=blue];
		1661 -> 1662;
	1662 [label="Check boolean LoidFamilyComplete",color=orange];
		1662 -> 1664 [label=true,color=green];
		1662 -> 1663 [label=false,color=brown];
		1662 -> 1664 [label=false,color=brown];
	1664 [label="Насколько я понимаю Заражение и то, как оно действует, кажется, оно как-то... может быть... я не знаю, существует вне времени?",shape=box,color=red];
		1664 -> 1666;
	1663 [label="Дочь Энтрати наверху. Она училась и работала рядом с ним. Возможно, она сможет помочь.",shape=box,color=red];
		1663 -> 1665;
	1666 [label="Там есть... гитара... всё это очень трудно объяснить, и мы оба путешествовали во времени через Гельминта...",shape=box,color=red];
		1666 -> 1668;
	1665 [label="Update boolean LyonFamilySuccess",color=orange];
		1665 -> 1667;
	1668 [label="И этот процесс, полагаю, ещё очень долго будет преследовать меня в кошмарах. Как бы то ни было, я не знаю, как именно Рэллу, Харроу и я оказались связаны на таком... молекулярном, духовном уровне.",shape=box,color=blue];
		1668 -> 1670;
	1667 [label="Add 1 to Family",color=orange];
		1667 -> 1669;
	1670 [label="Но перекрёсток был двусторонним. Раз они были в моей жизни, значит, и я был в их. Я видел Безразличие. Я понимал, против чего они стояли на страже. Я видел мимолётное видение Харроу и того человека, которым он когда-то был.",shape=box,color=blue];
		1670 -> 1672;
	1669 [label="Вот если бы нам только позволили бы поговорить с ней. Я подозреваю, что какие-то замыслы на этот счёт уже есть. Если это так, то ты можешь рассчитывать на мою... помощь. Я могу быть убедительным, когда требуется.",shape=box,color=blue];
		1669 -> 1671;
	1672 [label="Но давление Безразличия взяло верх, я чувствовал это там - слышал, как они постукивали по стенам. Тук... тук... тук...",shape=box,color=blue];
		1672 -> 1673;
	1671 [label="Как бы то ни было, я не знаю, как именно Рэллу, Харроу и я оказались связаны на таком... молекулярном, духовном уровне.",shape=box,color=blue];
		1671 -> 1670;
	1673 [label="Все видения моей юности, все ужасы, которые я видел, - были ли они всего лишь проявлением Безразличия? Может быть, я сейчас путаю воспоминания? Или я действительно был «благословлён» Луа?",shape=box,color=blue];
		1673 -> 1674;
	1674 [label="Моя вера внутри меня... она смялась и исчезла. Не более чем обугленная бумага, превратившаяся в пыль. И, о, как я ненавижу себя за свою слабость...",shape=box,color=blue];
		1674 -> 1675;
	1675 [label="Evaluate expressions",color=orange];
		1675 -> 1681 [label="LyonDating",color=purple];
		1675 -> 1682 [label="DrifterFaithYesSimilar",color=purple];
		1675 -> 1682 [label="DrifterFaithYesForeign",color=purple];
		1675 -> 1682 [label="DrifterFaithPersonal",color=purple];
		1675 -> 1680 [label="DrifterFaithSol",color=purple];
		1675 -> 1680 [label="DrifterFaithLua",color=purple];
		1675 -> 1680 [label="DrifterFaithBalance",color=purple];
		1675 -> 1679 [label="DrifterFaithAgnostic",color=purple];
		1675 -> 1678 [label="DrifterFaithNoFear",color=purple];
		1675 -> 1677 [label="DrifterFaithNoMITW",color=purple];
		1675 -> 1678 [label="DrifterFaithNoMaybe",color=purple];
		1675 -> 1676 [label="false",color=purple];
	1681 [label="Ох, Лион... тебе пришлось так много пережить. Сомнение не является признаком слабости - сомнение происходит из боли.",shape=box,color=red];
		1681 -> 1683;
		1681 -> 1684;
		1681 -> 1685;
		1681 -> 1686;
		1681 -> 1687;
	1682 [label="Вера не обязательно должна быть постоянной, да и не ожидается, что она будет такой. Сколько историй рассказывают о тех, кто теряет веру только для того, чтобы обрести её снова?",shape=box,color=red];
		1682 -> 1683;
		1682 -> 1684;
		1682 -> 1685;
	1680 [label="Ты посвятил свою жизнь служению нашим Люминариям, Лион. Как ты думаешь, они отвернулись бы от тебя из-за чего-то подобного?",shape=box,color=red];
		1680 -> 1683;
		1680 -> 1684;
		1680 -> 1685;
	1679 [label="Я не знаю, есть боги или нет, Лион - я не думаю, что кто-то из нас когда-нибудь узнает это по-настоящему. Но что я знаю точно, так это то, что тебе пришлось пережить слишком многое.",shape=box,color=red];
		1679 -> 1683;
		1679 -> 1685;
		1679 -> 1686;
	1678 [label="Хотя я лично не верю, что в этом мире есть боги, я знаю, насколько это было важно для тебя в твоей жизни. Я не хочу обесценивать это.",shape=box,color=red];
		1678 -> 1685;
		1678 -> 1687;
	1677 [label="Безразличие создано нами - он не бог, Лион. Не позволяй ошибке Энтрати погубить тебя. А как же твоя вера?",shape=box,color=red];
		1677 -> 1685;
		1677 -> 1687;
	1676 [label="Мне неприятно видеть тебя таким, втянутым во весь этот чужой вздор. Ты не заслуживал всего этого.",shape=box,color=red];
		1676 -> 1683;
		1676 -> 1684;
		1676 -> 1685;
		1676 -> 1686;
		1676 -> 1687;
	1683 [label="Я не говорю, что тебе нужно снова обрести свою веру. Я говорю о том, что если ты захочешь - если почувствуешь, что тебе это нужно - это не то, что потеряно навсегда.",shape=box,color=red];
		1683 -> 1688;
	1684 [label="Конечно, Луа видит, через что тебе пришлось пройти. Что ты вытерпел во имя её. ",shape=box,color=red];
		1684 -> 1689;
	1685 [label="Я думаю, что тебе нужно сосредоточиться на том, чтобы найти какой-то покой внутри себя - каким бы способом тебе ни пришлось его искать.",shape=box,color=red];
		1685 -> 1690;
	1686 [label="Если есть бог, если твоя Луа действительно существует, то наверняка она видит, через что тебе пришлось пройти. Что ты вынес во имя её. Это должно что-то для неё значить.",shape=box,color=red];
		1686 -> 1691;
	1687 [label="Я думаю, тебе нужно отпустить саму идею о том, есть боги или нет, и сначала сосредоточиться на своём собственном исцелении.",shape=box,color=red];
		1687 -> 1692;
	1688 [label="Update boolean LyonFaith3Maybe",color=orange];
		1688 -> 1693;
	1689 [label="Update boolean LyonFaith3Yes",color=orange];
		1689 -> 1693;
	1690 [label="Update boolean LyonFaith3Maybe",color=orange];
		1690 -> 1693;
	1691 [label="Update boolean LyonFaith3Yes",color=orange];
		1691 -> 1693;
	1692 [label="Update boolean LyonFaith3No",color=orange];
		1692 -> 1693;
	1693 [label="Твоя правда пожалуй... И моя печальная история о сомнениях вовсе не была сутью разговора. Но я обдумаю твои слова. Завтра поговорим об этом детально.",shape=box,color=blue];
		1693 -> 1694;
	1694 [label="Я увидел жизнь Рэлла на борту Заримана Десять-Ноль и всё, что он пережил после этого. Я увидел жизнь Харроу как солдата, пусть и поблёкшую из-за Заражения. Так же, как они увидели мою жизнь в Gaule и все мои страдания.",shape=box,color=blue];
		1694 -> 1695;
	1695 [label="Тебе может показаться странным, что мы ни разу не обменялись ни словом. Мы просто не ощущали в этом нужды. Между нами было просто... взаимопонимание.",shape=box,color=blue];
		1695 -> 1696;
		1695 -> 1697;
	1696 [label="Действительно? Никогда?",shape=box,color=red];
		1696 -> 1698;
	1697 [label="Да... Я могу понять это.",shape=box,color=red];
		1697 -> 1699;
	1698 [label="Я мог слышать их голоса - я знал все слова, которые они когда-либо произносили в своей жизни. Но ни одно из них никогда не было обращено ко мне.",shape=box,color=blue];
		1698 -> 1699;
	1699 [label="Нужна ли для улыбки речь? Нужно ли хмуриться? Нужно ли слышать плач ребёнка, чтобы понять, что ему больно или страшно? Нет, мы просто знали, что произошло между нами.",shape=box,color=blue];
		1699 -> 1700;
	1700 [label="Пока этого... пока этого больше не стало.",shape=box,color=blue];
		1700 -> 1701;
	1701 [label="Check boolean LyonDating",color=orange];
		1701 -> 1703 [label=true,color=green];
		1701 -> 1702 [label=false,color=brown];
	1703 [label="Они не исчезли, mon miracle... просто умерли.",shape=box,color=blue];
		1703 -> 1704;
	1702 [label="Они не исчезли, друг мой... просто умерли.",shape=box,color=blue];
		1702 -> 1704;
	1704 [label="Я больше не могу слышать те их части, которые были неопределёнными. Теперь, я полагаю, я слышу лишь те, что уже были определены.",shape=box,color=blue];
		1704 -> 1705;
		1704 -> 1706;
	1705 [label="Прошу прощения, определены?",shape=box,color=red];
		1705 -> 1707;
	1706 [label="Когда ты... перестал его слышать?",shape=box,color=red];
		1706 -> 1708;
	1707 [label="Я не могу объяснить это больше, чем уже объяснил. Я не знаю как. Прости меня.",shape=box,color=blue];
		1707 -> 1708;
	1708 [label="В тот момент, когда мы прошли через Гельминта вместе с Роутом и оказались здесь, в Санктум. Я не знаю... почему. Или как.",shape=box,color=blue];
		1708 -> 1709;
	1709 [label="Но, проходя сквозь ту пелену времени, мои друзья, мои братья.. деревья, чьи корни так тесно переплелись с моей душой… увяли и умерли рядом со мной.",shape=box,color=blue];
		1709 -> 1710;
	1710 [label="Теперь там лишь пустота. Тлеющая. Воспоминание о них всё ещё искажает мои собственные. Но будь у меня выбор, я бы не отпустил этого шанса...",shape=box,color=blue];
		1710 -> 1711;
		1710 -> 1712;
	1711 [label="Ох?",shape=box,color=red];
		1711 -> 1713;
	1712 [label="Почему нет?",shape=box,color=red];
		1712 -> 1713;
	1713 [label="Я помню тот момент, когда мать впервые ударила меня. Я помню это сразу в двух обличьях, ясными как самый яркий свет Сола, и знаю, что обе версии правдивы.",shape=box,color=blue];
		1713 -> 1714;
	1714 [label="В одном из них... я плачу одна в темноте своей комнаты. В другом, две фигуры стоят рядом со мной в тени.",shape=box,color=blue];
		1714 -> 1715;
	1715 [label="Я помню, как дважды в первый раз я провел лезвием по своей коже, чтобы избавиться от голосов в своем сознании. В одном случае комната пуста.",shape=box,color=blue];
		1715 -> 1716;
	1716 [label="В другом, я слышу жужжание позади себя. Я чувствую молчаливое присутствие стойкого стража.",shape=box,color=blue];
		1716 -> 1717;
