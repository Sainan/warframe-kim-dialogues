		1720 -> 1725;
	1725 [label="Спасибо. Мне не хватает их присутствия. Но я… начинаю понимать, что в этом месте больше тех, кто может понять мою боль, чем тех, кто не сможет.",shape=box,color=blue];
		1725 -> 1729;
