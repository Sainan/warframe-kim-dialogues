		j2793227429 -> j3073510437 [label="LyonConfession1 & LyonConfession2",color=purple];
		j2793227429 -> "Chat ends." [label="false",color=purple];
	j4225489252 [label="[Разговор пропущен из-за ранее установленного предупреждения.]",shape=box,color=blue];
		j4225489252 -> j1028404978;
	j2765896305 [label="Я не думаю, что смогу адекватно описать тебе, каким странным был момент введения сыворотки, mon miracle.",shape=box,color=blue];
		j2765896305 -> j1231804086;
		j2765896305 -> j1112844440;
		j2765896305 -> j785271532;
		j2765896305 -> j697320010;
	j3073510437 [label="Я не думаю, что смогу адекватно описать тебе, каким странным был момент введения сыворотки, друг мой.",shape=box,color=blue];
		j3073510437 -> j1231804086;
		j3073510437 -> j1112844440;
		j3073510437 -> j785271532;
		j3073510437 -> j697320010;
	"Chat ends." [color=orange];
	j1028404978 [label="Boolean LyonRell3 is now true.",color=orange];
		j1028404978 -> j4075781927;
	j1231804086 [label="Мне говорили, что это невероятно больно.",shape=box,color=red];
		j1231804086 -> j797035112;
	j1112844440 [label="Мне даже невозможно вообразить себе такое. ",shape=box,color=red];
		j1112844440 -> j3432263415;
	j785271532 [label="[Внимание: краткие упоминания о членовредительстве и жестком обращении с детьми. Нажмите здесь, чтобы закончить. Это не приведёт к потере «Симпатии» с Лионом.]",shape=box,color=red];
		j785271532 -> j1843578849;
	j697320010 [label="[Конец.]",shape=box,color=red];
		j697320010 -> j3856020424;
	j4075781927 [label="Boolean LyonWillDate is now true.",color=orange];
		j4075781927 -> "Chat ends. Next chat will be Lyon5FaithDay2.";
	j797035112 [label="Полагаю, что да. Хотя мне кажется, у меня уже были годы практики в этом деле, и потому предупреждения Энтрати произвели на меня гораздо большее впечатление, чем оно оказалось на самом деле.",shape=box,color=blue];
		j797035112 -> j3432263415;
	j3432263415 [label="Мы с Мари решили принимать сыворотки наедине. Я попросил её позволить мне пройти через изменение первым, а потом помочь ей пройти через это самостоятельно, но она, конечно же, наотрез отказалась.",shape=box,color=blue];
		j3432263415 -> j691554748;
	j1843578849 [label="+20 Chemistry",color=orange];
		j1843578849 -> j2698387260;
	j3856020424 [label="Boolean LyonConfessionFail is now true.",color=orange];
		j3856020424 -> "Chat ends.";
	"Chat ends. Next chat will be Lyon5FaithDay2." [color=orange];
	j691554748 [label="Насмехаясь над самой мыслью о том, что я могу куда-то пойти или что-то сделать без неё, твердо стоящей рядом, она направилась в свои покои.",shape=box,color=blue];
		j691554748 -> j3437720827;
	j2698387260 [label="Boolean LyonFamilySuccess is now true.",color=orange];
		j2698387260 -> j2559080857;
	j3437720827 [label="Я запер дверь, разделся и сел посреди комнаты, как можно дальше от любых предметов, прежде чем вонзить себе иглу в бок.",shape=box,color=blue];
		j3437720827 -> j1123327993;
	j2559080857 [label="Boolean LyonRell3 is now true.",color=orange];
		j2559080857 -> j4008758555;
	j1123327993 [label="Я видел, что Заражение сделало с Роутом, как оно перекручивало его плоть вместе со всем, что было на нём в тот момент. Я не желал оказаться жертвой той же участи.",shape=box,color=blue];
		j1123327993 -> j1054142223;
	j4008758555 [label="Boolean LyonFaith3Unknown is now true.",color=orange];
		j4008758555 -> "Chat ends. Next chat will be Lyon5FaithDay2.";
	j1054142223 [label="Когда агония закончилась, моё и без того страдающее зрение... размылось. Как будто... раздвоилось. Словно я видел всё вдвойне.",shape=box,color=blue];
		j1054142223 -> j1934095764;
	j1934095764 [label="Однако я очень горжусь своей стойкостью, потому что мне удалось натянуть свои штаны прежде, чем меня вывернуло и я потерял сознание.",shape=box,color=blue];
		j1934095764 -> j4135425679;
	j4135425679 [label="Когда я очнулся, я обнаружил, что не один. Однако я не лежал на полу в своих покоях. Я сидел в своей детской спальне на скрипучем старом полу, который мне так хорошо был знаком.",shape=box,color=blue];
		j4135425679 -> j4180979806;
	j4180979806 [label="А рядом со мной сидел молодой человек. Позади него стояла фигура, которую я теперь знаю как Харроу. Молодой человек держал в руках маленькую деревянную фигурку. Её конечности были сочленёнными - краска давно облупилась, сохранившись разве что в складках и трещинах. Она принадлежала моему отцу. Это была фигурка солдат.",shape=box,color=blue];
		j4180979806 -> j1214656170;
	j1214656170 [label="Это была единственная игрушка, что по праву принадлежала мне, когда я был ребёнком.",shape=box,color=blue];
		j1214656170 -> j3225932587;
		j1214656170 -> j1366651461;
	j3225932587 [label="В детстве у меня была похожая фигурка. Это была одна из моих любимых игрушек.",shape=box,color=red];
		j3225932587 -> j2748389063;
	j1366651461 [label="Рэлл?",shape=box,color=red];
		j1366651461 -> j4538485;
	j2748389063 [label="Так мне говорили. Полагаю, мой случай в итоге оказался более благоприятным.",shape=box,color=blue];
		j2748389063 -> j896376418;
		j2748389063 -> j3759336252;
		j2748389063 -> j3328432559;
	j4538485 [label="Действительно.",shape=box,color=blue];
		j4538485 -> j3045402062;
	j896376418 [label="С Траксом всё непросто. Я бы предпочёл не вдаваться в подробности.",shape=box,color=red];
		j896376418 -> j1511827657;
	j3759336252 [label="На самом деле, это была не его вина. Он был именно тем, кем мне нужно было видеть его в тот момент.",shape=box,color=red];
		j3759336252 -> j3633984257;
	j3328432559 [label="Всё в порядке. Он прогрессирует. Медленно. Каким-то образом. Даже то, что казалось невозможным, может измениться.",shape=box,color=red];
		j3328432559 -> j192866262;
	j3045402062 [label="Молодой человек и его молчаливый страж, которые посетили меня в моём сне - в моём сознании, - были мне одновременно незнакомы и в то же время знакомы так, словно мы выросли вместе, как родственники.",shape=box,color=blue];
		j3045402062 -> j1294227322;
	j1511827657 [label="Совершенно верно. Мы могли бы здесь часами рассуждать о моральных и теологических аспектах Дувири.",shape=box,color=blue];
		j1511827657 -> j3045402062;
	j3633984257 [label="Когда я представляю себе хотя бы самую малость, что бы я сотворил на твоём месте, меня охватывает ужас. Но разговор мог бы затянуть нас на часы, обсуждая подобные вещи.",shape=box,color=blue];
		j3633984257 -> j3045402062;
	j192866262 [label="Если он проявляет признаки перемен, и он является порождением твоих эмоций, возможно, это свидетельствует о чем-то другом. Но, пожалуй, это тема для отдельного разговора.",shape=box,color=blue];
		j192866262 -> j3045402062;
	j1294227322 [label="Простите меня за излишне вычурную метафору, но это было похоже на то, как если бы мы были тремя деревьями, чьи корни так переплелись, что различить их стало невозможно -",shape=box,color=blue];
		j1294227322 -> j361562486;
	j361562486 [label="который просто появился на свет в таком состоянии. Я мог вспомнить свою жизнь без Рэлл и Харроу. И всё же они были здесь. В каждый момент - в каждом случае - рядом со мной.",shape=box,color=blue];
		j361562486 -> j2889432199;
	j2889432199 [label="К слову сказать, мне так хотелось бы поговорить об этом с Энтрати, я отчаянно хочу понять, какая наука лежит в основе всего этого - прости за невольный каламбур - но когда мы наконец оправились после нашего изменения, Энтрати уже не было.",shape=box,color=blue];
		j2889432199 -> j1937133691;
	j1937133691 [label="Check boolean LoidFamilyComplete",color=orange];
		j1937133691 -> j3857859970 [label=true,color=green];
		j1937133691 -> j2184462652 [label=false,color=brown];
		j1937133691 -> j3857859970 [label=false,color=brown];
	j3857859970 [label="Насколько я понимаю Заражение и то, как оно действует, кажется, оно как-то... может быть... я не знаю, существует вне времени?",shape=box,color=red];
		j3857859970 -> j3117225751;
	j2184462652 [label="Дочь Энтрати наверху. Она училась и работала рядом с ним. Возможно, она сможет помочь.",shape=box,color=red];
		j2184462652 -> j2285883029;
	j3117225751 [label="Там есть... гитара... всё это очень трудно объяснить, и мы оба путешествовали во времени через Гельминта...",shape=box,color=red];
		j3117225751 -> j2019975088;
	j2285883029 [label="Boolean LyonFamilySuccess is now true.",color=orange];
		j2285883029 -> j2809130033;
	j2019975088 [label="И этот процесс, полагаю, ещё очень долго будет преследовать меня в кошмарах. Как бы то ни было, я не знаю, как именно Рэллу, Харроу и я оказались связаны на таком... молекулярном, духовном уровне.",shape=box,color=blue];
		j2019975088 -> j1933258962;
	j2809130033 [label="Add 1 to Family counter",color=orange];
		j2809130033 -> j389439502;
	j1933258962 [label="Но перекрёсток был двусторонним. Раз они были в моей жизни, значит, и я был в их. Я видел Безразличие. Я понимал, против чего они стояли на страже. Я видел мимолётное видение Харроу и того человека, которым он когда-то был.",shape=box,color=blue];
		j1933258962 -> j1407374621;
	j389439502 [label="Вот если бы нам только позволили бы поговорить с ней. Я подозреваю, что какие-то замыслы на этот счёт уже есть. Если это так, то ты можешь рассчитывать на мою... помощь. Я могу быть убедительным, когда требуется.",shape=box,color=blue];
		j389439502 -> j2730596951;
	j1407374621 [label="Но давление Безразличия взяло верх, я чувствовал это там - слышал, как они постукивали по стенам. Рап... тап... тап...",shape=box,color=blue];
		j1407374621 -> j2728961191;
	j2730596951 [label="Как бы то ни было, я не знаю, как именно Рэллу, Харроу и я оказались связаны на таком... молекулярном, духовном уровне.",shape=box,color=blue];
		j2730596951 -> j1933258962;
	j2728961191 [label="Все видения моей юности, все ужасы, которые я видел, - были ли они всего лишь проявлением Безразличия? Может быть, я сейчас путаю воспоминания? Или я действительно был «благословлён» Луа?",shape=box,color=blue];
		j2728961191 -> j1475503155;
	j1475503155 [label="Моя вера внутри меня... она смялась и исчезла. Не более чем обугленная бумага, превратившаяся в пыль. И, о, как я ненавижу себя за свою слабость...",shape=box,color=blue];
		j1475503155 -> j2547210604;
	j2547210604 [label="Evaluate expressions",color=orange];
		j2547210604 -> j1002511696 [label="LyonDating",color=purple];
		j2547210604 -> j2155988668 [label="DrifterFaithYesSimilar",color=purple];
		j2547210604 -> j2155988668 [label="DrifterFaithYesForeign",color=purple];
		j2547210604 -> j2155988668 [label="DrifterFaithPersonal",color=purple];
		j2547210604 -> j2232331538 [label="DrifterFaithSol",color=purple];
		j2547210604 -> j2232331538 [label="DrifterFaithLua",color=purple];
		j2547210604 -> j2232331538 [label="DrifterFaithBalance",color=purple];
		j2547210604 -> j4015786094 [label="DrifterFaithAgnostic",color=purple];
		j2547210604 -> j1188393894 [label="DrifterFaithNoFear",color=purple];
		j2547210604 -> j4147130147 [label="DrifterFaithNoMITW",color=purple];
		j2547210604 -> j1188393894 [label="DrifterFaithNoMaybe",color=purple];
		j2547210604 -> j1286910920 [label="false",color=purple];
	j1002511696 [label="Ох, Лион... тебе пришлось так много пережить. Сомнение не является признаком слабости - сомнение происходит из боли.",shape=box,color=red];
		j1002511696 -> j1389649556;
		j1002511696 -> j45465262;
		j1002511696 -> j3130166959;
		j1002511696 -> j3964431245;
		j1002511696 -> j815899323;
	j2155988668 [label="Вера не обязательно должна быть постоянной, да и не ожидается, что она будет такой. Сколько историй рассказывают о тех, кто теряет веру только для того, чтобы обрести её снова?",shape=box,color=red];
		j2155988668 -> j1389649556;
		j2155988668 -> j45465262;
		j2155988668 -> j3130166959;
	j2232331538 [label="Ты посвятил свою жизнь служению нашим Люминариям, Лион. Как ты думаешь, они отвернулись бы от тебя из-за чего-то подобного?",shape=box,color=red];
		j2232331538 -> j1389649556;
		j2232331538 -> j45465262;
		j2232331538 -> j3130166959;
	j4015786094 [label="Я не знаю, есть боги или нет, Лион - я не думаю, что кто-то из нас когда-нибудь узнает это по-настоящему. Но что я знаю точно, так это то, что тебе пришлось пережить слишком многое.",shape=box,color=red];
		j4015786094 -> j1389649556;
		j4015786094 -> j3130166959;
		j4015786094 -> j3964431245;
	j1188393894 [label="Хотя я лично не верю, что в этом мире есть боги, я знаю, насколько это было важно для тебя в твоей жизни. Я не хочу обесценивать это.",shape=box,color=red];
		j1188393894 -> j3130166959;
		j1188393894 -> j815899323;
	j4147130147 [label="Безразличие создано нами - он не бог, Лион. Не позволяй ошибке Энтрати погубить тебя. А как же твоя вера?",shape=box,color=red];
		j4147130147 -> j3130166959;
		j4147130147 -> j815899323;
	j1286910920 [label="Мне неприятно видеть тебя таким, втянутым во весь этот чужой вздор. Ты не заслуживал всего этого.",shape=box,color=red];
		j1286910920 -> j1389649556;
		j1286910920 -> j45465262;
		j1286910920 -> j3130166959;
		j1286910920 -> j3964431245;
		j1286910920 -> j815899323;
	j1389649556 [label="Я не говорю, что тебе нужно снова обрести свою веру. Я говорю о том, что если ты захочешь - если почувствуешь, что тебе это нужно - это не то, что потеряно навсегда.",shape=box,color=red];
		j1389649556 -> j2800497621;
	j45465262 [label="Конечно, Луа видит, через что тебе пришлось пройти. Что ты вытерпел во имя её. ",shape=box,color=red];
		j45465262 -> j3002554874;
	j3130166959 [label="Я думаю, что тебе нужно сосредоточиться на том, чтобы найти какой-то покой внутри себя - каким бы способом тебе ни пришлось его искать.",shape=box,color=red];
		j3130166959 -> j2800497621;
	j3964431245 [label="Если есть бог, если твоя Луа действительно существует, то наверняка она видит, через что тебе пришлось пройти. Что ты вынес во имя её. Это должно что-то для неё значить.",shape=box,color=red];
		j3964431245 -> j3002554874;
	j815899323 [label="Я думаю, тебе нужно отпустить саму идею о том, есть боги или нет, и сначала сосредоточиться на своём собственном исцелении.",shape=box,color=red];
		j815899323 -> j886526839;
	j2800497621 [label="Boolean LyonFaith3Maybe is now true.",color=orange];
		j2800497621 -> j2417533598;
	j3002554874 [label="Boolean LyonFaith3Yes is now true.",color=orange];
		j3002554874 -> j2417533598;
	j886526839 [label="Boolean LyonFaith3No is now true.",color=orange];
		j886526839 -> j2417533598;
	j2417533598 [label="Твоя правда пожалуй... И моя печальная история о сомнениях вовсе не была сутью разговора. Но я обдумаю твои слова. Завтра поговорим об этом детально.",shape=box,color=blue];
		j2417533598 -> j3498868616;
	j3498868616 [label="Я увидел жизнь Рэлла на борту Заримана Десять-Ноль и всё, что он пережил после этого. Я увидел жизнь Харроу как солдата, пусть и поблёкшую из-за Заражения. Так же, как они увидели мою жизнь в Gaule и все мои страдания.",shape=box,color=blue];
		j3498868616 -> j63311775;
	j63311775 [label="Тебе может показаться странным, что мы ни разу не обменялись ни словом. Мы просто не ощущали в этом нужды. Между нами было просто... взаимопонимание.",shape=box,color=blue];
		j63311775 -> j608878055;
		j63311775 -> j1786708422;
	j608878055 [label="Действительно? Никогда?",shape=box,color=red];
		j608878055 -> j193756698;
	j1786708422 [label="Да... Я могу понять это.",shape=box,color=red];
		j1786708422 -> j3469962159;
	j193756698 [label="Я мог слышать их голоса - я знал все слова, которые они когда-либо произносили в своей жизни. Но ни одно из них никогда не было обращено ко мне.",shape=box,color=blue];
		j193756698 -> j3469962159;
	j3469962159 [label="Нужна ли для улыбки речь? Нужно ли хмуриться? Нужно ли слышать плач ребёнка, чтобы понять, что ему больно или страшно? Нет, мы просто знали, что произошло между нами.",shape=box,color=blue];
		j3469962159 -> j1299728133;
	j1299728133 [label="Пока этого... пока этого больше не стало.",shape=box,color=blue];
		j1299728133 -> j944777217;
	j944777217 [label="Check boolean LyonDating",color=orange];
		j944777217 -> j4207932092 [label=true,color=green];
		j944777217 -> j2825612178 [label=false,color=brown];
	j4207932092 [label="Они не исчезли, mon miracle... просто умерли.",shape=box,color=blue];
		j4207932092 -> j2158832438;
	j2825612178 [label="Они не исчезли, друг мой... просто умерли.",shape=box,color=blue];
		j2825612178 -> j2158832438;
	j2158832438 [label="Я больше не могу слышать те их части, которые были неопределёнными. Теперь, я полагаю, я слышу лишь те, что уже были определены.",shape=box,color=blue];
		j2158832438 -> j2668308615;
		j2158832438 -> j109335735;
	j2668308615 [label="Прошу прощения, определены?",shape=box,color=red];
		j2668308615 -> j1751130146;
	j109335735 [label="Когда ты... перестал его слышать?",shape=box,color=red];
		j109335735 -> j2503074140;
	j1751130146 [label="Я не могу объяснить это больше, чем уже объяснил. Я не знаю как. Прости меня.",shape=box,color=blue];
		j1751130146 -> j2503074140;
	j2503074140 [label="В тот момент, когда мы прошли через Гельминта вместе с Роутом и оказались здесь, в Санктум. Я не знаю... почему. Или как.",shape=box,color=blue];
		j2503074140 -> j1184666037;
	j1184666037 [label="Но, проходя сквозь ту пелену времени, мои друзья, мои братья.. деревья, чьи корни так тесно переплелись с моей душой… увяли и умерли рядом со мной.",shape=box,color=blue];
		j1184666037 -> j3521122368;
	j3521122368 [label="Теперь там лишь пустота. Тлеющая. Воспоминание о них всё ещё искажает мои собственные. Но будь у меня выбор, я бы не отпустил этого шанса...",shape=box,color=blue];
		j3521122368 -> j3231250014;
		j3521122368 -> j1049190067;
	j3231250014 [label="Ох?",shape=box,color=red];
		j3231250014 -> j4246597572;
	j1049190067 [label="Почему нет?",shape=box,color=red];
		j1049190067 -> j4246597572;
	j4246597572 [label="Я помню тот момент, когда мать впервые ударила меня. Я помню это сразу в двух обличьях, ясными как самый яркий свет Сола, и знаю, что обе версии правдивы.",shape=box,color=blue];
		j4246597572 -> j127964692;
	j127964692 [label="В одном из них... я плачу одна в темноте своей комнаты. В другом, две фигуры стоят рядом со мной в тени.",shape=box,color=blue];
		j127964692 -> j871189706;
	j871189706 [label="Я помню, как дважды в первый раз я провел лезвием по своей коже, чтобы избавиться от голосов в своем сознании. В одном случае комната пуста.",shape=box,color=blue];
		j871189706 -> j930915299;
	j930915299 [label="В другом, я слышу жужжание позади себя. Я чувствую молчаливое присутствие стойкого стража.",shape=box,color=blue];
		j930915299 -> j2802844424;
	j2802844424 [label="Если я потеряю веру в мою богиню Луа и взамен получу её наставления... возможно, это та сделка, которую я был бы готов совершить.",shape=box,color=blue];
		j2802844424 -> j2400849994;
	j2400849994 [label="Evaluate expressions",color=orange];
