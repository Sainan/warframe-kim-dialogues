		j2400849994 -> j2559793825 [label="DrifterFaithNoMITW",color=purple];
		j2400849994 -> j4020878407 [label="DrifterFaithNoMaybe",color=purple];
		j2400849994 -> j2559793825 [label="DrifterFaithNoMaybe",color=purple];
		j2400849994 -> j4020878407 [label="false",color=purple];
		j2400849994 -> j2559793825 [label="false",color=purple];
	j4020878407 [label="Мне просто - я просто сожалею о всём, через что вам обоим пришлось пройти.",shape=box,color=red];
		j4020878407 -> j922074686;
	j764769483 [label="Я просто... так радуюсь, что Рэлл и Харроу смогли быть там с тобой, Лион... пусть даже в воспоминаниях.",shape=box,color=red];
		j764769483 -> j2417565523;
	j3239290446 [label="Мог бы ты допустить возможность того, что... может быть это всё дело бога или богов? Чтобы принести тебе утешение?",shape=box,color=red];
		j3239290446 -> j2859593879;
	j3396785621 [label="Мог бы ты допустить возможность того, что... может быть это всё дело рук Луа? Чтобы принести тебе утешение?",shape=box,color=red];
		j3396785621 -> j2859593879;
	j2966845135 [label="Я не знаю, должны ли эти два обличия быть взаимоисключающими, но... Я не знаю. Я не знаю, сможем ли мы когда-либо разобраться в этом.",shape=box,color=red];
		j2966845135 -> j2089483786;
	j2559793825 [label="Я просто... так радуюсь, что Рэлл и Харроу смогли быть там с тобой, Лион... пусть даже в воспоминаниях.",shape=box,color=red];
		j2559793825 -> j922074686;
	j922074686 [label="Спасибо. Мне не хватает их присутствия. Но я… начинаю понимать, что в этом месте больше тех, кто может понять мою боль, чем тех, кто не сможет.",shape=box,color=blue];
		j922074686 -> j4064142349;
	j2417565523 [label="Спасибо. Мне не хватает их присутствия. Но я... больше не одинок, так же, mon miracle?",shape=box,color=blue];
		j2417565523 -> j4064142349;
	j2859593879 [label="Да. Не думай, что я об этом не размышлял. Я не уверен, что моя вера так просто восстановится, но... всё равно, размышлять об этом приятно.",shape=box,color=blue];
		j2859593879 -> j4064142349;
	j2089483786 [label="В самом деле. Не думай, что я не задумывался, были ли Рэлл и Харроу посланы Люминариями, чтобы утешить меня. Но, как верно было замечено тобой, нам не дано этого знать.",shape=box,color=blue];
		j2089483786 -> j4064142349;
	j4064142349 [label="+20 Chemistry",color=orange];
		j4064142349 -> j1926294418;
	j1926294418 [label="У меня такое облегчение, что я наконец смог поговорить обо всём этом с тобой. Будто огромный груз сняли с меня, и я даже не знаю, как выразить тебя свою благодарность в полной мере.",shape=box,color=blue];
		j1926294418 -> j918154824;
	j918154824 [label="Check boolean LyonDating",color=orange];
		j918154824 -> j555930462 [label=true,color=green];
