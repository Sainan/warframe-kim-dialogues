	2211 [label="Check /Lotus/Scripts/1999/DialogueScriptNodes.lua:IsDatingMultiple",color=orange];
		2211 -> 2213 [label=true,color=green];
		2211 -> 2345 [label=false,color=brown];
	2212 [label="Chat ends.",color=orange];
	2213 [label="Check boolean LyonConsentComplete",color=orange];
		2213 -> 2215 [label=true,color=green];
		2213 -> 2216 [label=false,color=brown];
	2345 [label="Check boolean LyonPolyamorySuccess",color=orange];
		2345 -> 2213 [label=true,color=green];
		2345 -> 2214 [label=false,color=brown];
	2215 [label="Chat ends.",color=orange];
	2216 [label="Я хотел бы, если позволишь, вкратце обсудить кое-что, что, как мне кажется, успокоило бы нас обоих, mon miracle.",shape=box,color=blue];
		2216 -> 2217;
		2216 -> 2218;
	2214 [label="Chat ends.",color=orange];
	2217 [label="[Конец.]",shape=box,color=red];
		2217 -> 2219;
	2218 [label="Что-то не так, Лион?",shape=box,color=red];
		2218 -> 2220;
	2219 [label="Update boolean LyonConsentComplete",color=orange];
		2219 -> 2221;
	2220 [label="Нет, ничего не случилось. Я просто хотел сказать, что знаю, что ты проводишь время в... любовных отношениях, когда тебя нет со мной.",shape=box,color=blue];
		2220 -> 2222;
	2221 [label="Chat ends.",color=orange];
	2222 [label="И я просто хотел заверить тебя, что это не вызывает у меня ни сомнений, ни беспокойства. Твоё присутствие в моей жизни не принесло мне ничего, кроме покоя, ничего, кроме радости...",shape=box,color=blue];
		2222 -> 2223;
	2223 [label="И как я мог когда-либо отказать другому в таком подарке?",shape=box,color=blue];
		2223 -> 2224;
		2223 -> 2225;
	2224 [label="Я действительно думаю, что тебя бы обожали, чего бы это ни стоило.",shape=box,color=red];
		2224 -> 2226;
	2225 [label="Спасибо. Это очень много значит для меня.",shape=box,color=red];
		2225 -> 2227;
	2226 [label="Мысль об этом вызывает у меня улыбку. И кто знает, может быть, в другой жизни или в другой день мы встретимся. ",shape=box,color=blue];
		2226 -> 2228;
	2227 [label="Такими, какие мы есть - такими, какой я есть, со всем, что мне было принесено тобой, со всем, что мы собой представляем... Я доволен. Нет, я... счастлив. Впервые за очень, очень долгое время.",shape=box,color=blue];
		2227 -> 2229;
	2228 [label="Но в данном случае я доволен тем, что у нас есть. Нет, я... счастлив. Впервые за очень, очень долгое время.",shape=box,color=blue];
		2228 -> 2229;
	2229 [label="И я должен поблагодарить тебя за это. Но пока я с тобой прощаюсь.",shape=box,color=blue];
		2229 -> 2230;
	2230 [label="- Лион",shape=box,color=blue];
		2230 -> 1193;
	1193 [label="Update boolean LyonConsentComplete",color=orange];
		1193 -> 1187;
	1187 [label="Chat ends.",color=orange];
}