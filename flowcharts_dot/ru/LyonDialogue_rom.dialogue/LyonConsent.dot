		j1809468205 -> j1181132753 [label=true,color=green];
		j1809468205 -> j1316396836 [label=false,color=brown];
	"Chat ends." [color=orange];
	j1181132753 [label="Check boolean LyonConsentComplete",color=orange];
		j1181132753 -> "Chat ends." [label=true,color=green];
		j1181132753 -> j2315714794 [label=false,color=brown];
	j1316396836 [label="Check boolean LyonPolyamorySuccess",color=orange];
		j1316396836 -> j1181132753 [label=true,color=green];
		j1316396836 -> "Chat ends." [label=false,color=brown];
	j2315714794 [label="Я хотел бы, если позволишь, вкратце обсудить кое-что, что, как мне кажется, успокоило бы нас обоих, mon miracle.",shape=box,color=blue];
		j2315714794 -> j2829270956;
		j2315714794 -> j2805259246;
	j2829270956 [label="[Конец.]",shape=box,color=red];
		j2829270956 -> j3944516755;
	j2805259246 [label="Что-то не так, Лион?",shape=box,color=red];
		j2805259246 -> j4234912321;
	j3944516755 [label="Boolean LyonConsentComplete is now true.",color=orange];
		j3944516755 -> "Chat ends.";
	j4234912321 [label="Нет, ничего не случилось. Я просто хотел сказать, что знаю, что ты проводишь время в... любовных отношениях, когда тебя нет со мной.",shape=box,color=blue];
		j4234912321 -> j3542005359;
	j3542005359 [label="И я просто хотел заверить тебя, что это не вызывает у меня ни сомнений, ни беспокойства. Твоё присутствие в моей жизни не принесло мне ничего, кроме покоя, ничего, кроме радости...",shape=box,color=blue];
		j3542005359 -> j1099766700;
	j1099766700 [label="И как я мог когда-либо отказать другому в таком подарке?",shape=box,color=blue];
		j1099766700 -> j3220557346;
		j1099766700 -> j4050489531;
	j3220557346 [label="Я действительно думаю, что тебя бы обожали, чего бы это ни стоило.",shape=box,color=red];
		j3220557346 -> j3151294904;
	j4050489531 [label="Спасибо. Это очень много значит для меня.",shape=box,color=red];
		j4050489531 -> j3307730308;
	j3151294904 [label="Мысль об этом вызывает у меня улыбку. И кто знает, может быть, в другой жизни или в другой день мы встретимся. ",shape=box,color=blue];
		j3151294904 -> j3092642538;
	j3307730308 [label="Такими, какие мы есть - такими, какой я есть, со всем, что мне было принесено тобой, со всем, что мы собой представляем... Я доволен. Нет, я... счастлив. Впервые за очень, очень долгое время.",shape=box,color=blue];
		j3307730308 -> j619387715;
	j3092642538 [label="Но в данном случае я доволен тем, что у нас есть. Нет, я... счастлив. Впервые за очень, очень долгое время.",shape=box,color=blue];
		j3092642538 -> j619387715;
	j619387715 [label="И я должен поблагодарить тебя за это. Но пока я с тобой прощаюсь.",shape=box,color=blue];
		j619387715 -> j427578814;
	j427578814 [label="- Лион",shape=box,color=blue];
		j427578814 -> j3944516755;
}