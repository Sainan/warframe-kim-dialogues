digraph {
	0 [label="LyonRank3Convo1 begins.",color=orange];
		0 -> 1;
	1 [label="Приветствую, Скиталец.",shape=box,color=blue];
		1 -> 2;
	2 [label="До моего сведения дошло, что у тебя есть желание поговорить со мной.",shape=box,color=blue];
		2 -> 3;
		2 -> 4;
		2 -> 5;
	3 [label="Это удовольствие общаться с тобой здесь, Лион - благодарю тебя.",shape=box,color=red];
		3 -> 6;
	4 [label="Наконец Мари убедила тебя, что я не представляю угрозы?",shape=box,color=red];
		4 -> 7;
	5 [label="Ох! Здравствуй, Лион. Честно говоря, у меня не было в мыслях, что тебя удастся убедить. Мне в радость, что ты передумал.",shape=box,color=red];
		5 -> 8;
	6 [label="В конце концов, ты можешь пожалеть, что тебе так сильно не хотелось этого делать, но что ж. Пожалуйста.",shape=box,color=blue];
		6 -> 9;
		6 -> 10;
	7 [label="Не вдохновляй меня так быстро находить причины изменить курс.",shape=box,color=blue];
		7 -> 11;
	8 [label="Да, хорошо. Ты можешь уже не так радоваться этому, когда всё будет сказано и сделано.",shape=box,color=blue];
		8 -> 9;
		8 -> 10;
	9 [label="От других мне стало ясно, что у тебя есть вопросы, которые нам следует обсудить. Могу ли я тебе в этом чем-нибудь помочь?",shape=box,color=red];
		9 -> 12;
	10 [label="Что-то случилось?",shape=box,color=red];
		10 -> 13;
	11 [label="+10 Chemistry",color=orange];
		11 -> 14;
	12 [label="Возможно, со временем. Но мы только начали нашу беседу. Я просто пришёл сюда лишь для того, чтобы... сказать тебе, что уступил настойчивости Мари, утверждающей, что тебе можно доверять хотя бы в рамках разговора.",shape=box,color=blue];
		12 -> 15;
	13 [label="Какой до смешного нелепый вопрос, на который я даже не буду пытаться ответить, поскольку мы только начали нашу беседу. Я просто пришёл сюда лишь для того, чтобы... сказать тебе, что уступил настойчивости Мари, утверждающей, что тебе можно доверять хотя бы в рамках разговора.",shape=box,color=blue];
		13 -> 15;
	14 [label="Chat ends.",color=orange];
	15 [label="Evaluate expressions on HellKeyPlayed",color=orange];
		15 -> 16 [label="x > 0",color=purple];
		15 -> 17 [label="x <= 0",color=purple];
		15 -> 17 [label="false",color=purple];
	16 [label="И раз уж мы теперь напарники в этом начинании, к которому Роут так отчаянно стремится выполнить? Мне кажется, было бы благоразумно, если мы как следует познакомимся. Судя по всему, именно такой способ знакомства тебе по душе. Поэтому я здесь.",shape=box,color=blue];
		16 -> 18;
		16 -> 19;
	17 [label="И раз уж мы можем или не можем навсегда оказаться напарниками в этом начинании, которое Роут так отчаянно стремится осуществить, было бы благоразумно как следует познакомиться. Похоже, что именно такой способ знакомства тебе по душе. Поэтому я здесь.",shape=box,color=blue];
		17 -> 18;
		17 -> 19;
	18 [label="У меня такое чувство, что всё это как-то неправильно началось из-за меня.",shape=box,color=red];
		18 -> 20;
	19 [label="Есть ли... какой-нибудь другой способ, который тебе бы был предпочтителен?",shape=box,color=red];
		19 -> 21;
	20 [label="Нет. Не из-за тебя. Скорее всего, я просто не тот человек, с которым тебе привычней общаться. В этом тебе пока что повезло, хотя сумасшедшие моего калибра встречаются редко.",shape=box,color=blue];
		20 -> 22;
	21 [label="Нет. Это приемлемо. На самом деле, это дает мне время сформулировать собственные мысли так, как я хотел бы. Я понимаю, почему это устройство так привлекательно.",shape=box,color=blue];
		21 -> 23;
	22 [label="Я отвлекся от темы. Боюсь, я пришел сюда не для того, чтобы тратить много времени на «набор текста», что, несомненно, разочарует тебя. Я просто хотел сообщить тебе о своей капитуляции.",shape=box,color=blue];
		22 -> 24;
		22 -> 25;
	23 [label="Однако я боюсь, что я пришел сюда не для того, чтобы тратить много времени на «набор текста», что, несомненно, разочарует тебя. Я просто хотел сообщить тебе о своей капитуляции.",shape=box,color=blue];
		23 -> 25;
		23 -> 24;
	24 [label="Мари опаснее, чем кажется, не так ли?",shape=box,color=red];
		24 -> 26;
	25 [label="Ещё разок, я просто скажу тебе спасибо.",shape=box,color=red];
		25 -> 27;
	26 [label="+20 Chemistry",color=orange];
		26 -> 28;
	27 [label="+15 Chemistry",color=orange];
		27 -> 29;
	28 [label="Это только начало твоих подозрений о том, насколько глубоки эти воды.",shape=box,color=blue];
		28 -> 30;
	29 [label="И... чего бы это ни стоило, пожалуйста.",shape=box,color=blue];
		29 -> 30;
	30 [label="-Ф. Лион Аллард",shape=box,color=blue];
		30 -> 31;
	31 [label="Chat ends.",color=orange];
}