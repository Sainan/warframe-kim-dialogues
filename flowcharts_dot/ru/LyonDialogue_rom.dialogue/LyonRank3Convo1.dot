digraph {
	"LyonRank3Convo1 begins." [color=orange];
		"LyonRank3Convo1 begins." -> j2366511605;
	j2366511605 [label="Приветствую, Скиталец.",shape=box,color=blue];
		j2366511605 -> j3347813803;
	j3347813803 [label="До моего сведения дошло, что у тебя есть желание поговорить со мной.",shape=box,color=blue];
		j3347813803 -> j81171870;
		j3347813803 -> j952263624;
		j3347813803 -> j2036681762;
	j81171870 [label="Это удовольствие общаться с тобой здесь, Лион - благодарю тебя.",shape=box,color=red];
		j81171870 -> j248374989;
	j952263624 [label="Наконец Мари убедила тебя, что я не представляю угрозы?",shape=box,color=red];
		j952263624 -> j1265077256;
	j2036681762 [label="Ох! Здравствуй, Лион. Честно говоря, у меня не было в мыслях, что тебя удастся убедить. Мне в радость, что ты передумал.",shape=box,color=red];
		j2036681762 -> j1759567869;
	j248374989 [label="В конце концов, ты можешь пожалеть, что тебе так сильно не хотелось этого делать, но что ж. Пожалуйста.",shape=box,color=blue];
		j248374989 -> j2931365083;
		j248374989 -> j4146021945;
	j1265077256 [label="Не вдохновляй меня так быстро находить причины изменить курс.",shape=box,color=blue];
		j1265077256 -> j1933300832;
	j1759567869 [label="Да, хорошо. Ты можешь уже не так радоваться этому, когда всё будет сказано и сделано.",shape=box,color=blue];
		j1759567869 -> j2931365083;
		j1759567869 -> j4146021945;
	j2931365083 [label="От других мне стало ясно, что у тебя есть вопросы, которые нам следует обсудить. Могу ли я тебе в этом чем-нибудь помочь?",shape=box,color=red];
		j2931365083 -> j681491416;
	j4146021945 [label="Что-то случилось?",shape=box,color=red];
		j4146021945 -> j1408350969;
	j1933300832 [label="+10 Chemistry",color=orange];
		j1933300832 -> "Chat ends.";
	j681491416 [label="Возможно, со временем. Но мы только начали нашу беседу. Я просто пришёл сюда лишь для того, чтобы... сказать тебе, что уступил настойчивости Мари, утверждающей, что тебе можно доверять хотя бы в рамках разговора.",shape=box,color=blue];
		j681491416 -> j2777944732;
	j1408350969 [label="Какой до смешного нелепый вопрос, на который я даже не буду пытаться ответить, поскольку мы только начали нашу беседу. Я просто пришёл сюда лишь для того, чтобы... сказать тебе, что уступил настойчивости Мари, утверждающей, что тебе можно доверять хотя бы в рамках разговора.",shape=box,color=blue];
		j1408350969 -> j2777944732;
	"Chat ends." [color=orange];
	j2777944732 [label="Evaluate expressions on HellKeyPlayed counter",color=orange];
		j2777944732 -> j373929948 [label="x > 0",color=purple];
		j2777944732 -> j4194697292 [label="x <= 0",color=purple];
		j2777944732 -> j4194697292 [label="false",color=purple];
	j373929948 [label="И раз уж мы теперь напарники в этом начинании, к которому Роут так отчаянно стремится выполнить? Мне кажется, было бы благоразумно, если мы как следует познакомимся. Судя по всему, именно такой способ знакомства тебе по душе. Поэтому я здесь.",shape=box,color=blue];
		j373929948 -> j2309412989;
		j373929948 -> j1565132111;
	j4194697292 [label="И раз уж мы можем или не можем навсегда оказаться напарниками в этом начинании, которое Роут так отчаянно стремится осуществить, было бы благоразумно как следует познакомиться. Похоже, что именно такой способ знакомства тебе по душе. Поэтому я здесь.",shape=box,color=blue];
		j4194697292 -> j2309412989;
		j4194697292 -> j1565132111;
	j2309412989 [label="У меня такое чувство, что всё это как-то неправильно началось из-за меня.",shape=box,color=red];
		j2309412989 -> j3763495448;
	j1565132111 [label="Есть ли... какой-нибудь другой способ, который тебе бы был предпочтителен?",shape=box,color=red];
		j1565132111 -> j3105337248;
	j3763495448 [label="Нет. Не из-за тебя. Скорее всего, я просто не тот человек, с которым тебе привычней общаться. В этом тебе пока что повезло, хотя сумасшедшие моего калибра встречаются редко.",shape=box,color=blue];
		j3763495448 -> j924217367;
	j3105337248 [label="Нет. Это приемлемо. На самом деле, это дает мне время сформулировать собственные мысли так, как я хотел бы. Я понимаю, почему это устройство так привлекательно.",shape=box,color=blue];
		j3105337248 -> j1082337871;
	j924217367 [label="Я отвлекся от темы. Боюсь, я пришел сюда не для того, чтобы тратить много времени на «набор текста», что, несомненно, разочарует тебя. Я просто хотел сообщить тебе о своей капитуляции.",shape=box,color=blue];
		j924217367 -> j8542011;
		j924217367 -> j2819236677;
	j1082337871 [label="Однако я боюсь, что я пришел сюда не для того, чтобы тратить много времени на «набор текста», что, несомненно, разочарует тебя. Я просто хотел сообщить тебе о своей капитуляции.",shape=box,color=blue];
		j1082337871 -> j2819236677;
		j1082337871 -> j8542011;
	j8542011 [label="Мари опаснее, чем кажется, не так ли?",shape=box,color=red];
		j8542011 -> j426503508;
	j2819236677 [label="Ещё разок, я просто скажу тебе спасибо.",shape=box,color=red];
		j2819236677 -> j2147297162;
	j426503508 [label="+20 Chemistry",color=orange];
		j426503508 -> j1516993720;
	j2147297162 [label="+15 Chemistry",color=orange];
		j2147297162 -> j3063165326;
	j1516993720 [label="Это только начало твоих подозрений о том, насколько глубоки эти воды.",shape=box,color=blue];
		j1516993720 -> j1542260442;
	j3063165326 [label="И... чего бы это ни стоило, пожалуйста.",shape=box,color=blue];
		j3063165326 -> j1542260442;
	j1542260442 [label="-Ф. Лион Аллард",shape=box,color=blue];
		j1542260442 -> "Chat ends.";
}