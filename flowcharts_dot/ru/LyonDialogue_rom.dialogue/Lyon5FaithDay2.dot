		1738 -> 1739 [label="LyonFaith3Unknown",color=purple];
		1738 -> 1743 [label="false",color=purple];
	1742 [label="Я размышлял о характере нашего вчерашнего разговора. И о том, что значит для меня иметь присутствие Рэлла и Харроу так неразрывно вплетённым в мою жизнь -",shape=box,color=blue];
		1742 -> 1747;
	1741 [label="Я размышлял о характере нашего вчерашнего разговора. И о том, что значит для меня иметь присутствие Рэлла и Харроу так неразрывно вплетённым в мою жизнь -",shape=box,color=blue];
		1741 -> 1746;
	1740 [label="Я размышлял о характере нашего вчерашнего разговора. И о том, что значит для меня иметь присутствие Рэлла и Харроу так неразрывно вплетённым в мою жизнь -",shape=box,color=blue];
		1740 -> 1745;
	1739 [label="Есть кое-что, о чём я давно хотел поговорить с тобой, и только сейчас у меня появилась возможность сделать это. Когда... Рэлл, Харроу и я оказались переплетены - как и почему это произошло, не важно -",shape=box,color=blue];
		1739 -> 1744;
	1743 [label="Chat ends.",color=orange];
	1747 [label="Лишь затем, чтобы их присутствие вновь было вырвано из моей души, оставив мне только воспоминание. И что всё это, возможно, было даром Луа...",shape=box,color=blue];
		1747 -> 1751;
	1746 [label="Лишь затем, чтобы их присутствие вновь было вырвано из моей души, оставив мне только воспоминание. Это может означать, что в этом мире нет богов.",shape=box,color=blue];
		1746 -> 1750;
	1745 [label="Лишь затем, чтобы их присутствие вновь было вырвано из моей души, оставив мне только воспоминание. И я не знаю, означает ли это, что в этом мире есть боги или нет.",shape=box,color=blue];
		1745 -> 1749;
	1744 [label="Я оказался вплетён в их прошлое так же, как они в моё. Я увидел весь Зариман Десять-Ноль, вспышки Старой Войны, и точно так же они увидели всё моё прошлое.",shape=box,color=blue];
		1744 -> 1748;
	1751 [label="Я пришёл к пониманию, что наша серебряная леди могла бы даровать столь трагическое благословение. Она не хотела бы стирать воспоминания о боли, как это было с Роутом.",shape=box,color=blue];
		1751 -> 1754;
	1750 [label="Но это, я думаю, не меняет тех лет, которые я посвятил служению организации, целью которой было совершать добрые дела в этом мире.",shape=box,color=blue];
		1750 -> 1753;
	1749 [label="Как было сказано тобой, мы... возможно никогда не узнаем. И, возможно, нам не следует этого знать. Таков порядок вещей. Но это, я думаю, не меняет тех лет, которые я посвятил служению организации, целью которой было совершать добрые дела в этом мире.",shape=box,color=blue];
		1749 -> 1753;
	1748 [label="Это... поставило под сомнение очень многие вещи для меня, а именно... моя вера. Она смялась и рассыпалась, как обугленная бумага, превращаясь в пыль. Я ненавижу себя за эту слабость...",shape=box,color=blue];
		1748 -> 1752;
	1754 [label="Так же она не стала бы избавлять меня от жжения удара плетью с моей плоти. И уж точно не в её манере защищать меня от горя, связанного с его кончиной.",shape=box,color=blue];
		1754 -> 1763;
	1753 [label="Чтобы помочь тем, кто желал избавиться от боли в своей жизни в те моменты, когда она могла бы их захлестнуть.",shape=box,color=blue];
		1753 -> 1762;
	1752 [label="Evaluate expressions",color=orange];
		1752 -> 1760 [label="LyonDating",color=purple];
		1752 -> 1761 [label="DrifterFaithYesSimilar",color=purple];
		1752 -> 1761 [label="DrifterFaithYesForeign",color=purple];
		1752 -> 1761 [label="DrifterFaithPersonal",color=purple];
		1752 -> 1759 [label="DrifterFaithSol",color=purple];
		1752 -> 1759 [label="DrifterFaithLua",color=purple];
		1752 -> 1759 [label="DrifterFaithBalance",color=purple];
		1752 -> 1758 [label="DrifterFaithAgnostic",color=purple];
		1752 -> 1757 [label="DrifterFaithNoFear",color=purple];
		1752 -> 1756 [label="DrifterFaithNoMITW",color=purple];
		1752 -> 1757 [label="DrifterFaithNoMaybe",color=purple];
		1752 -> 1755 [label="false",color=purple];
	1763 [label="Там, где Сол бы испепелил мою боль, как раскалённый нож может прижечь рану - Луа позволила бы мне принять тепло той боли, которую могло принести его отсутствие.",shape=box,color=blue];
		1763 -> 1770;
	1762 [label="И я знаю, что если бы я всё ещё мог почувствовать присутствие Рэлла и его Харроу, они не захотели бы, чтобы я мучился из-за их утраты. Они обрели покой.",shape=box,color=blue];
		1762 -> 1769;
	1760 [label="Ох, Лион... тебе пришлось так много пережить. Сомнение не является признаком слабости - сомнение происходит из боли.",shape=box,color=red];
		1760 -> 1764;
		1760 -> 1765;
		1760 -> 1766;
		1760 -> 1767;
		1760 -> 1768;
	1761 [label="Вера не обязательно должна быть постоянной, да и не ожидается, что она будет такой. Сколько историй рассказывают о тех, кто теряет веру только для того, чтобы обрести её снова?",shape=box,color=red];
		1761 -> 1764;
		1761 -> 1765;
		1761 -> 1766;
	1759 [label="Ты посвятил свою жизнь служению нашим Люминариям, Лион. Как ты думаешь, они отвернулись бы от тебя из-за чего-то подобного?",shape=box,color=red];
		1759 -> 1764;
		1759 -> 1765;
		1759 -> 1766;
	1758 [label="Я не знаю, есть боги или нет, Лион - я не думаю, что кто-то из нас когда-нибудь узнает это по-настоящему. Но что я знаю точно, так это то, что тебе пришлось пережить слишком многое.",shape=box,color=red];
		1758 -> 1764;
		1758 -> 1766;
		1758 -> 1767;
	1757 [label="Хотя я лично не верю, что в этом мире есть боги, я знаю, насколько это было важно для тебя в твоей жизни. Я не хочу обесценивать это.",shape=box,color=red];
		1757 -> 1766;
		1757 -> 1768;
	1756 [label="Безразличие создано нами - он не бог, Лион. Не позволяй ошибке Энтрати погубить тебя. А как же твоя вера?",shape=box,color=red];
		1756 -> 1766;
		1756 -> 1768;
	1755 [label="Мне неприятно видеть тебя таким, втянутым во весь этот чужой вздор. Ты не заслуживал всего этого.",shape=box,color=red];
		1755 -> 1764;
		1755 -> 1765;
		1755 -> 1766;
		1755 -> 1767;
		1755 -> 1768;
	1770 [label="Ибо именно отсутствие боли угрожает уничтожить нас точно так же, как её избыток может нас потопить.",shape=box,color=blue];
		1770 -> 1778;
		1770 -> 1779;
		1770 -> 1777;
	1769 [label="И я не верю, что все мои страдания были напрасны. Это не отменяет всего, что я пережил.",shape=box,color=blue];
		1769 -> 1776;
	1764 [label="Я не говорю, что тебе нужно снова обрести свою веру. Я говорю о том, что если ты захочешь - если почувствуешь, что тебе это нужно - это не то, что потеряно навсегда.",shape=box,color=red];
		1764 -> 1771;
	1765 [label="Конечно, Луа видит, через что тебе пришлось пройти. Что ты вытерпел во имя её. ",shape=box,color=red];
		1765 -> 1772;
	1766 [label="Я думаю, что тебе нужно сосредоточиться на том, чтобы найти какой-то покой внутри себя - каким бы способом тебе ни пришлось его искать.",shape=box,color=red];
		1766 -> 1773;
	1767 [label="Если есть бог, если твоя Луа действительно существует, то наверняка она видит, через что тебе пришлось пройти. Что ты вынес во имя её. Это должно что-то для неё значить.",shape=box,color=red];
		1767 -> 1774;
	1768 [label="Я думаю, тебе нужно отпустить саму идею о том, есть боги или нет, и сначала сосредоточиться на своём собственном исцелении.",shape=box,color=red];
		1768 -> 1775;
	1778 [label="Доверься мне... Я знаю, насколько опасной может быть апатия.",shape=box,color=red];
		1778 -> 1785;
	1779 [label="Означает ли это, что ты снова обрёл свою веру?",shape=box,color=red];
		1779 -> 1786;
	1777 [label="[Конец.]",shape=box,color=red];
		1777 -> 1784;
	1776 [label="Ибо именно отсутствие боли угрожает уничтожить нас точно так же, как её избыток может нас потопить.",shape=box,color=blue];
		1776 -> 1778;
		1776 -> 1783;
		1776 -> 1777;
	1771 [label="Update boolean LyonFaith3Maybe",color=orange];
		1771 -> 1780;
	1772 [label="Update boolean LyonFaith3Yes",color=orange];
		1772 -> 1781;
	1773 [label="Update boolean LyonFaith3Maybe",color=orange];
		1773 -> 1780;
	1774 [label="Update boolean LyonFaith3Yes",color=orange];
		1774 -> 1781;
	1775 [label="Update boolean LyonFaith3No",color=orange];
		1775 -> 1782;
	1785 [label="Похоже, что так. ",shape=box,color=blue];
		1785 -> 1791;
	1786 [label="Трудно сказать. Я не знаю, можно ли считать нечто подобное тем, что кто-то вроде меня когда-либо действительно «находит» или «теряет», а не вечно ищет. Вечно задает вопросы, вечно остается в поисках ответов.",shape=box,color=blue];
		1786 -> 1792;
	1784 [label="Update boolean LyonConfessionFail",color=orange];
		1784 -> 1790;
	1783 [label="Означает ли это, что ты отказался от своей веры?",shape=box,color=red];
		1783 -> 1786;
	1780 [label="Я думаю о том, что означает для меня то, что Рэлл и Харроу так прочно вошли в мою жизнь -",shape=box,color=blue];
		1780 -> 1787;
	1781 [label="Я вспоминаю те годы, что я посвятил служению организации, которая по своей сути было призвано творить добрые дела в этом мире... что означает для меня то, что Рэлл и Харроу так прочно вошли в мою жизнь -",shape=box,color=blue];
		1781 -> 1788;
	1782 [label="Я думаю о том, что означает для меня то, что Рэлл и Харроу так прочно вошли в мою жизнь -",shape=box,color=blue];
		1782 -> 1789;
	1791 [label="Я не уверен, является ли нечто вроде веры тем, что такие, как я, когда-либо по-настоящему «находят» или «теряют», а не вечно ищут. Вечно сомневаются, вечно ищут ответы.",shape=box,color=blue];
		1791 -> 1792;
	1792 [label="Но я считаю, что, как и в случае с болью, нужен определённый баланс, чтобы не утонуть в ней и не привыкнуть настолько, чтобы стать невосприимчивым и притупленным.",shape=box,color=blue];
		1792 -> 1796;
	1790 [label="Chat ends.",color=orange];
	1787 [label="Лишь затем, чтобы их присутствие вновь было вырвано из моей души, оставив мне только воспоминание. И я не знаю, означает ли это, что в этом мире есть боги или нет.",shape=box,color=blue];
		1787 -> 1793;
	1788 [label="Лишь затем, чтобы их присутствие вновь было вырвано из моей души, оставив мне только воспоминание. И что всё это, возможно, было даром Луа...",shape=box,color=blue];
		1788 -> 1794;
	1789 [label="Лишь затем, чтобы их присутствие вновь было вырвано из моей души, оставив мне только воспоминание. Это может означать, что в этом мире нет богов.",shape=box,color=blue];
		1789 -> 1795;
	1796 [label="Check boolean DrifterFaithNoMITW",color=orange];
		1796 -> 1797 [label=true,color=green];
		1796 -> 1799 [label=true,color=green];
		1796 -> 1798 [label=false,color=brown];
		1796 -> 1799 [label=false,color=brown];
	1793 [label="Как было сказано тобой, мы... возможно никогда не узнаем. И, возможно, нам не следует этого знать. Таков порядок вещей. Но это, я думаю, не меняет тех лет, которые я посвятил служению организации, целью которой было совершать добрые дела в этом мире.",shape=box,color=blue];
		1793 -> 1753;
	1794 [label="Возможно, ты прав. Возможно, наша серебряная леди дала бы лишь такое трагичное благословение. Она бы не захотела убрать память о боли, как в случае с Роут.",shape=box,color=blue];
		1794 -> 1754;
	1795 [label="Но это, я думаю, не меняет тех лет, которые я посвятил служению организации, целью которой было совершать добрые дела в этом мире.",shape=box,color=blue];
		1795 -> 1753;
	1797 [label="Согласишься ли с Роут и мной в том, что Человек в Стене не является настоящим богом?",shape=box,color=red];
		1797 -> 1800;
	1799 [label="Как ты думаешь, где здесь место Безразличию?",shape=box,color=red];
		1799 -> 1801;
	1798 [label="Поддерживаешь ли ты мнение Роут о том, что Безразличие является настоящим богом или нет?",shape=box,color=red];
		1798 -> 1800;
	1800 [label="Я не знаю, на какой стороне я. У меня недостаточно доказательств, чтобы сделать вывод в ту или иную сторону. Но, полагаю, это мало что меняет, не так ли?",shape=box,color=blue];
		1800 -> 1802;
		1800 -> 1803;
	1801 [label="Не знаю, является ли Безразличие богом, я не знаю, на какой стороне я. У меня недостаточно доказательств, чтобы сделать вывод в ту или иную сторону. Но, полагаю, это мало что меняет, не так ли?",shape=box,color=blue];
		1801 -> 1802;
		1801 -> 1803;
	1802 [label="Думаю, это многое меняет. Если это не настоящий бог - значит, создано людьми. Значит, люди могут его победить.",shape=box,color=red];
		1802 -> 1804;
	1803 [label="Ты о чём?",shape=box,color=red];
		1803 -> 1805;
	1804 [label="Если у тебя не было надежды, что мы сможем победить, зачем вообще противиться? Воистину, ты озадачивающее существо.",shape=box,color=blue];
		1804 -> 1806;
	1805 [label="Способ его появления в нашей вселенной не меняет методов, которыми мы можем его победить.",shape=box,color=blue];
		1805 -> 1807;
	1806 [label="Ты не можешь всерьез говорить эти слова.  Значит, ты просто «поддаёшься» действиям других? Сражаешься потому, что тебе нечем заняться?",shape=box,color=blue];
		1806 -> 1808;
	1807 [label="Взгляните: бог, созданный нами, сшитый из ткани нашей собственной пустоты.",shape=box,color=blue];
		1807 -> 1809;
	1808 [label="Конечно, ты мог бы придумать себе хобби получше.",shape=box,color=blue];
		1808 -> 1810;
		1808 -> 1811;
	1809 [label="Тряпичную куклц, которую мы можем переполнить печалью, горем, болью, гневом, агонией до тех пор, пока швы не начнут лопаться.",shape=box,color=blue];
		1809 -> 1812;
	1810 [label="Нет, я не думал, что это безнадежно - я не это имел в виду.",shape=box,color=red];
		1810 -> 1813;
	1811 [label="Я имел в виду, что это меняет наше представление об убийстве. Понимание этого.",shape=box,color=red];
		1811 -> 1814;
	1812 [label="Извини меня, если это наполняет меня гораздо большим ужасом, чем если бы это было божество до нашего прибытия. ",shape=box,color=blue];
		1812 -> 1815;
	1813 [label="Думать, прежде чем выпускать слова в мир, не обязательно. Как и для пуль. ",shape=box,color=blue];
		1813 -> 1807;
	1814 [label="Я не верю, что это правда. Я бы сказал, что сейчас мы понимаем мотивы так же мало, как если бы это был какой-то «великий и непостижимый бог».",shape=box,color=blue];
		1814 -> 1807;
	1815 [label="Да, на самом деле, я думаю, что мне это больше нравится.",shape=box,color=blue];
		1815 -> 1816;
	1816 [label="Возможно, есть какая-то надежда на то, что он окажется разумнее, чем человечество в целом.",shape=box,color=blue];
		1816 -> 1817;
	1817 [label="С этой... совершенно безрадостной мыслью, я, пожалуй, покину вас на сегодня.",shape=box,color=blue];
		1817 -> 1818;
	1818 [label="Check boolean LyonDating",color=orange];
		1818 -> 1820 [label=true,color=green];
		1818 -> 1819 [label=false,color=brown];
	1820 [label="+20 Chemistry",color=orange];
		1820 -> 1822;
	1819 [label="+20 Chemistry",color=orange];
		1819 -> 1821;
	1822 [label="Мы скоро поговорим, mon miracle. Спасибо.",shape=box,color=blue];
		1822 -> 1823;
	1821 [label="Мы скоро поговорим, мой друг. Спасибо.",shape=box,color=blue];
		1821 -> 1823;
	1823 [label="Chat ends.",color=orange];
}