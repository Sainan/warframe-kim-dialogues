		j2955664667 -> j2120759456 [label="LyonFaith3Unknown",color=purple];
		j2955664667 -> "Chat ends." [label="false",color=purple];
	j2236762294 [label="Я размышлял о характере нашего вчерашнего разговора. И о том, что значит для меня иметь присутствие Рэлла и Харроу так неразрывно вплетённым в мою жизнь -",shape=box,color=blue];
		j2236762294 -> j1048502395;
	j3121596082 [label="Я размышлял о характере нашего вчерашнего разговора. И о том, что значит для меня иметь присутствие Рэлла и Харроу так неразрывно вплетённым в мою жизнь -",shape=box,color=blue];
		j3121596082 -> j2096984015;
	j1008436011 [label="Я размышлял о характере нашего вчерашнего разговора. И о том, что значит для меня иметь присутствие Рэлла и Харроу так неразрывно вплетённым в мою жизнь -",shape=box,color=blue];
		j1008436011 -> j21874108;
	j2120759456 [label="Есть кое-что, о чём я давно хотел поговорить с тобой, и только сейчас у меня появилась возможность сделать это. Когда... Рэлл, Харроу и я оказались переплетены - как и почему это произошло, не важно -",shape=box,color=blue];
		j2120759456 -> j2063288408;
	"Chat ends." [color=orange];
	j1048502395 [label="Лишь затем, чтобы их присутствие вновь было вырвано из моей души, оставив мне только воспоминание. И что всё это, возможно, было даром Луа...",shape=box,color=blue];
		j1048502395 -> j338974662;
	j2096984015 [label="Лишь затем, чтобы их присутствие вновь было вырвано из моей души, оставив мне только воспоминание. Это может означать, что в этом мире нет богов.",shape=box,color=blue];
		j2096984015 -> j3301007209;
	j21874108 [label="Лишь затем, чтобы их присутствие вновь было вырвано из моей души, оставив мне только воспоминание. И я не знаю, означает ли это, что в этом мире есть боги или нет.",shape=box,color=blue];
		j21874108 -> j3529256179;
	j2063288408 [label="Я оказался вплетён в их прошлое так же, как они в моё. Я увидел весь Зариман Десять-Ноль, вспышки Старой Войны, и точно так же они увидели всё моё прошлое.",shape=box,color=blue];
		j2063288408 -> j2908057845;
	j338974662 [label="Я пришёл к пониманию, что наша серебряная леди могла бы даровать столь трагическое благословение. Она не хотела бы стирать воспоминания о боли, как это было с Роутом.",shape=box,color=blue];
		j338974662 -> j1981335219;
	j3301007209 [label="Но это, я думаю, не меняет тех лет, которые я посвятил служению организации, целью которой было совершать добрые дела в этом мире.",shape=box,color=blue];
		j3301007209 -> j2900810125;
	j3529256179 [label="Как было сказано тобой, мы... возможно никогда не узнаем. И, возможно, нам не следует этого знать. Таков порядок вещей. Но это, я думаю, не меняет тех лет, которые я посвятил служению организации, целью которой было совершать добрые дела в этом мире.",shape=box,color=blue];
		j3529256179 -> j2900810125;
	j2908057845 [label="Это... поставило под сомнение очень многие вещи для меня, а именно... моя вера. Она смялась и рассыпалась, как обугленная бумага, превращаясь в пыль. Я ненавижу себя за эту слабость...",shape=box,color=blue];
		j2908057845 -> j3287457751;
	j1981335219 [label="Так же она не стала бы избавлять меня от жжения удара плетью с моей плоти. И уж точно не в её манере защищать меня от горя, связанного с его кончиной.",shape=box,color=blue];
		j1981335219 -> j2299779377;
	j2900810125 [label="Чтобы помочь тем, кто желал избавиться от боли в своей жизни в те моменты, когда она могла бы их захлестнуть.",shape=box,color=blue];
		j2900810125 -> j2995772660;
	j3287457751 [label="Evaluate expressions",color=orange];
		j3287457751 -> j3422429002 [label="LyonDating",color=purple];
		j3287457751 -> j3197209776 [label="DrifterFaithYesSimilar",color=purple];
		j3287457751 -> j3197209776 [label="DrifterFaithYesForeign",color=purple];
		j3287457751 -> j3197209776 [label="DrifterFaithPersonal",color=purple];
		j3287457751 -> j891675440 [label="DrifterFaithSol",color=purple];
		j3287457751 -> j891675440 [label="DrifterFaithLua",color=purple];
		j3287457751 -> j891675440 [label="DrifterFaithBalance",color=purple];
		j3287457751 -> j296518219 [label="DrifterFaithAgnostic",color=purple];
		j3287457751 -> j1314703996 [label="DrifterFaithNoFear",color=purple];
		j3287457751 -> j2354540774 [label="DrifterFaithNoMITW",color=purple];
		j3287457751 -> j1314703996 [label="DrifterFaithNoMaybe",color=purple];
		j3287457751 -> j2399120048 [label="false",color=purple];
	j2299779377 [label="Там, где Сол бы испепелил мою боль, как раскалённый нож может прижечь рану - Луа позволила бы мне принять тепло той боли, которую могло принести его отсутствие.",shape=box,color=blue];
		j2299779377 -> j4232480437;
	j2995772660 [label="И я знаю, что если бы я всё ещё мог почувствовать присутствие Рэлла и его Харроу, они не захотели бы, чтобы я мучился из-за их утраты. Они обрели покой.",shape=box,color=blue];
		j2995772660 -> j3079716433;
	j3422429002 [label="Ох, Лион... тебе пришлось так много пережить. Сомнение не является признаком слабости - сомнение происходит из боли.",shape=box,color=red];
		j3422429002 -> j583060569;
		j3422429002 -> j1503213827;
		j3422429002 -> j2182965208;
		j3422429002 -> j2272199102;
		j3422429002 -> j1528430122;
	j3197209776 [label="Вера не обязательно должна быть постоянной, да и не ожидается, что она будет такой. Сколько историй рассказывают о тех, кто теряет веру только для того, чтобы обрести её снова?",shape=box,color=red];
		j3197209776 -> j583060569;
		j3197209776 -> j1503213827;
		j3197209776 -> j2182965208;
	j891675440 [label="Ты посвятил свою жизнь служению нашим Люминариям, Лион. Как ты думаешь, они отвернулись бы от тебя из-за чего-то подобного?",shape=box,color=red];
		j891675440 -> j583060569;
		j891675440 -> j1503213827;
		j891675440 -> j2182965208;
	j296518219 [label="Я не знаю, есть боги или нет, Лион - я не думаю, что кто-то из нас когда-нибудь узнает это по-настоящему. Но что я знаю точно, так это то, что тебе пришлось пережить слишком многое.",shape=box,color=red];
		j296518219 -> j583060569;
		j296518219 -> j2182965208;
		j296518219 -> j2272199102;
	j1314703996 [label="Хотя я лично не верю, что в этом мире есть боги, я знаю, насколько это было важно для тебя в твоей жизни. Я не хочу обесценивать это.",shape=box,color=red];
		j1314703996 -> j2182965208;
		j1314703996 -> j1528430122;
	j2354540774 [label="Безразличие создано нами - он не бог, Лион. Не позволяй ошибке Энтрати погубить тебя. А как же твоя вера?",shape=box,color=red];
		j2354540774 -> j2182965208;
		j2354540774 -> j1528430122;
	j2399120048 [label="Мне неприятно видеть тебя таким, втянутым во весь этот чужой вздор. Ты не заслуживал всего этого.",shape=box,color=red];
		j2399120048 -> j583060569;
		j2399120048 -> j1503213827;
		j2399120048 -> j2182965208;
		j2399120048 -> j2272199102;
		j2399120048 -> j1528430122;
	j4232480437 [label="Ибо именно отсутствие боли угрожает уничтожить нас точно так же, как её избыток может нас потопить.",shape=box,color=blue];
		j4232480437 -> j723798808;
		j4232480437 -> j3380636373;
		j4232480437 -> j697320010;
	j3079716433 [label="И я не верю, что все мои страдания были напрасны. Это не отменяет всего, что я пережил.",shape=box,color=blue];
		j3079716433 -> j2808885042;
	j583060569 [label="Я не говорю, что тебе нужно снова обрести свою веру. Я говорю о том, что если ты захочешь - если почувствуешь, что тебе это нужно - это не то, что потеряно навсегда.",shape=box,color=red];
		j583060569 -> j3714825375;
	j1503213827 [label="Конечно, Луа видит, через что тебе пришлось пройти. Что ты вытерпел во имя её. ",shape=box,color=red];
		j1503213827 -> j4124054732;
	j2182965208 [label="Я думаю, что тебе нужно сосредоточиться на том, чтобы найти какой-то покой внутри себя - каким бы способом тебе ни пришлось его искать.",shape=box,color=red];
		j2182965208 -> j3714825375;
	j2272199102 [label="Если есть бог, если твоя Луа действительно существует, то наверняка она видит, через что тебе пришлось пройти. Что ты вынес во имя её. Это должно что-то для неё значить.",shape=box,color=red];
		j2272199102 -> j4124054732;
	j1528430122 [label="Я думаю, тебе нужно отпустить саму идею о том, есть боги или нет, и сначала сосредоточиться на своём собственном исцелении.",shape=box,color=red];
		j1528430122 -> j1939906906;
	j723798808 [label="Доверься мне... Я знаю, насколько опасной может быть апатия.",shape=box,color=red];
		j723798808 -> j2427208219;
	j3380636373 [label="Означает ли это, что ты снова обрёл свою веру?",shape=box,color=red];
		j3380636373 -> j2826372797;
	j697320010 [label="[Конец.]",shape=box,color=red];
		j697320010 -> j3856020424;
	j2808885042 [label="Ибо именно отсутствие боли угрожает уничтожить нас точно так же, как её избыток может нас потопить.",shape=box,color=blue];
		j2808885042 -> j723798808;
		j2808885042 -> j2020272985;
		j2808885042 -> j697320010;
	j3714825375 [label="Boolean LyonFaith3Maybe is now true.",color=orange];
		j3714825375 -> j1996052084;
	j4124054732 [label="Boolean LyonFaith3Yes is now true.",color=orange];
		j4124054732 -> j1878559186;
	j1939906906 [label="Boolean LyonFaith3No is now true.",color=orange];
		j1939906906 -> j509086195;
	j2427208219 [label="Похоже, что так. ",shape=box,color=blue];
		j2427208219 -> j3579291514;
	j2826372797 [label="Трудно сказать. Я не знаю, можно ли считать нечто подобное тем, что кто-то вроде меня когда-либо действительно «находит» или «теряет», а не вечно ищет. Вечно задает вопросы, вечно остается в поисках ответов.",shape=box,color=blue];
		j2826372797 -> j2988992237;
	j3856020424 [label="Boolean LyonConfessionFail is now true.",color=orange];
		j3856020424 -> "Chat ends.";
	j2020272985 [label="Означает ли это, что ты отказался от своей веры?",shape=box,color=red];
		j2020272985 -> j2826372797;
	j1996052084 [label="Я думаю о том, что означает для меня то, что Рэлл и Харроу так прочно вошли в мою жизнь -",shape=box,color=blue];
		j1996052084 -> j4012424111;
	j1878559186 [label="Я вспоминаю те годы, что я посвятил служению организации, которая по своей сути было призвано творить добрые дела в этом мире... что означает для меня то, что Рэлл и Харроу так прочно вошли в мою жизнь -",shape=box,color=blue];
		j1878559186 -> j4262111895;
	j509086195 [label="Я думаю о том, что означает для меня то, что Рэлл и Харроу так прочно вошли в мою жизнь -",shape=box,color=blue];
		j509086195 -> j3964062176;
	j3579291514 [label="Я не уверен, является ли нечто вроде веры тем, что такие, как я, когда-либо по-настоящему «находят» или «теряют», а не вечно ищут. Вечно сомневаются, вечно ищут ответы.",shape=box,color=blue];
		j3579291514 -> j2988992237;
	j2988992237 [label="Но я считаю, что, как и в случае с болью, нужен определённый баланс, чтобы не утонуть в ней и не привыкнуть настолько, чтобы стать невосприимчивым и притупленным.",shape=box,color=blue];
		j2988992237 -> j1286686499;
	j4012424111 [label="Лишь затем, чтобы их присутствие вновь было вырвано из моей души, оставив мне только воспоминание. И я не знаю, означает ли это, что в этом мире есть боги или нет.",shape=box,color=blue];
		j4012424111 -> j3529256179;
	j4262111895 [label="Лишь затем, чтобы их присутствие вновь было вырвано из моей души, оставив мне только воспоминание. И что всё это, возможно, было даром Луа...",shape=box,color=blue];
		j4262111895 -> j2905835501;
	j3964062176 [label="Лишь затем, чтобы их присутствие вновь было вырвано из моей души, оставив мне только воспоминание. Это может означать, что в этом мире нет богов.",shape=box,color=blue];
		j3964062176 -> j3301007209;
	j1286686499 [label="Check boolean DrifterFaithNoMITW",color=orange];
		j1286686499 -> j3085904672 [label=true,color=green];
		j1286686499 -> j578719011 [label=true,color=green];
		j1286686499 -> j1309308782 [label=false,color=brown];
		j1286686499 -> j578719011 [label=false,color=brown];
	j2905835501 [label="Возможно, ты прав. Возможно, наша серебряная леди дала бы лишь такое трагичное благословение. Она бы не захотела убрать память о боли, как в случае с Роут.",shape=box,color=blue];
		j2905835501 -> j1981335219;
	j3085904672 [label="Согласишься ли с Роут и мной в том, что Человек в Стене не является настоящим богом?",shape=box,color=red];
		j3085904672 -> j4183960305;
	j578719011 [label="Как ты думаешь, где здесь место Безразличию?",shape=box,color=red];
		j578719011 -> j3297276286;
	j1309308782 [label="Поддерживаешь ли ты мнение Роут о том, что Безразличие является настоящим богом или нет?",shape=box,color=red];
		j1309308782 -> j4183960305;
	j4183960305 [label="Я не знаю, на какой стороне я. У меня недостаточно доказательств, чтобы сделать вывод в ту или иную сторону. Но, полагаю, это мало что меняет, не так ли?",shape=box,color=blue];
		j4183960305 -> j1727526907;
		j4183960305 -> j2572831516;
	j3297276286 [label="Не знаю, является ли Безразличие богом, я не знаю, на какой стороне я. У меня недостаточно доказательств, чтобы сделать вывод в ту или иную сторону. Но, полагаю, это мало что меняет, не так ли?",shape=box,color=blue];
		j3297276286 -> j1727526907;
		j3297276286 -> j2572831516;
	j1727526907 [label="Думаю, это многое меняет. Если это не настоящий бог - значит, создано людьми. Значит, люди могут его победить.",shape=box,color=red];
		j1727526907 -> j3803210928;
	j2572831516 [label="Ты о чём?",shape=box,color=red];
		j2572831516 -> j1135845405;
	j3803210928 [label="Если у тебя не было надежды, что мы сможем победить, зачем вообще противиться? Воистину, ты озадачивающее существо.",shape=box,color=blue];
		j3803210928 -> j1995821881;
	j1135845405 [label="Способ его появления в нашей вселенной не меняет методов, которыми мы можем его победить.",shape=box,color=blue];
		j1135845405 -> j3535480755;
	j1995821881 [label="Ты не можешь всерьез говорить эти слова.  Значит, ты просто «поддаёшься» действиям других? Сражаешься потому, что тебе нечем заняться?",shape=box,color=blue];
		j1995821881 -> j1779700175;
	j3535480755 [label="Взгляните: бог, созданный нами, сшитый из ткани нашей собственной пустоты.",shape=box,color=blue];
		j3535480755 -> j2685491424;
	j1779700175 [label="Конечно, ты мог бы придумать себе хобби получше.",shape=box,color=blue];
		j1779700175 -> j2266037048;
		j1779700175 -> j3367621177;
	j2685491424 [label="Тряпичную куклц, которую мы можем переполнить печалью, горем, болью, гневом, агонией до тех пор, пока швы не начнут лопаться.",shape=box,color=blue];
		j2685491424 -> j3995442499;
	j2266037048 [label="Нет, я не думал, что это безнадежно - я не это имел в виду.",shape=box,color=red];
		j2266037048 -> j500950571;
	j3367621177 [label="Я имел в виду, что это меняет наше представление об убийстве. Понимание этого.",shape=box,color=red];
		j3367621177 -> j1392761147;
	j3995442499 [label="Извини меня, если это наполняет меня гораздо большим ужасом, чем если бы это было божество до нашего прибытия. ",shape=box,color=blue];
		j3995442499 -> j1301064315;
	j500950571 [label="Думать, прежде чем выпускать слова в мир, не обязательно. Как и для пуль. ",shape=box,color=blue];
		j500950571 -> j3535480755;
	j1392761147 [label="Я не верю, что это правда. Я бы сказал, что сейчас мы понимаем мотивы так же мало, как если бы это был какой-то «великий и непостижимый бог».",shape=box,color=blue];
		j1392761147 -> j3535480755;
	j1301064315 [label="Да, на самом деле, я думаю, что мне это больше нравится.",shape=box,color=blue];
		j1301064315 -> j488058733;
	j488058733 [label="Возможно, есть какая-то надежда на то, что он окажется разумнее, чем человечество в целом.",shape=box,color=blue];
		j488058733 -> j2435368726;
	j2435368726 [label="С этой... совершенно безрадостной мыслью, я, пожалуй, покину вас на сегодня.",shape=box,color=blue];
		j2435368726 -> j742749064;
	j742749064 [label="Check boolean LyonDating",color=orange];
		j742749064 -> j3234449411 [label=true,color=green];
		j742749064 -> j2180606298 [label=false,color=brown];
