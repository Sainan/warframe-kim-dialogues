digraph {
	graph [fontname="Roboto Condensed"];
	node [fontname="Roboto Condensed"];
	edge [fontname="Roboto Condensed"];

	"LyonRank3Convo2 begins." [color=orange];
		"LyonRank3Convo2 begins." -> j2597056092;
	j2597056092 [label="Если позволишь, я хотел бы рассказать тебе историю о бродячем коте, который часто заходил к нам за церковь.",shape=box,color=blue];
		j2597056092 -> j353473463;
		j2597056092 -> j1624338762;
		j2597056092 -> j2869381411;
	j353473463 [label="Продолжай.",shape=box,color=red];
		j353473463 -> j4046845390;
	j1624338762 [label="Зачем?",shape=box,color=red];
		j1624338762 -> j3103271990;
	j2869381411 [label="[Игнорировать.]",shape=box,color=red];
		j2869381411 -> "Chat ends.";
	j4046845390 [label="Спасибо.",shape=box,color=blue];
		j4046845390 -> j3267450747;
	j3103271990 [label="Боюсь для объяснения потребуется больше усилий, чем оно того стоит.",shape=box,color=blue];
		j3103271990 -> j513938941;
	"Chat ends." [color=orange];
	j3267450747 [label="Хотя я и подозреваю, что эта история не уникальна для этого потрепанного старого тома, и моё общение с ним, по-видимому, заслуживает внимания, всё равно её стоит рассказать.",shape=box,color=blue];
		j3267450747 -> j2327130023;
	j513938941 [label="Забудь.",shape=box,color=blue];
		j513938941 -> "Chat ends.";
	j2327130023 [label="Каждый день он приходил ко мне, выпрашивая объедки и ласку у меня или у других братьев и сестёр, которые заботились о нём.",shape=box,color=blue];
		j2327130023 -> j3861980964;
	j3861980964 [label="Он был оборванцем, хромал на лапу и у него отсутствовала часть уха. ",shape=box,color=blue];
		j3861980964 -> j226281250;
	j226281250 [label="Когда он не появился в течение нескольких дней, Мари была вне себя от беспокойства. Но что можно сделать для старого бродячего кота, который встретил свой конец, кроме как вознести молитву Луа?",shape=box,color=blue];
		j226281250 -> j3437213928;
	j3437213928 [label="Boolean LyonStray is now true.",color=orange];
		j3437213928 -> j79136976;
		j3437213928 -> j1681644370;
		j3437213928 -> j408674845;
	j79136976 [label="[Позволь ему продолжить.]",shape=box,color=red];
		j79136976 -> j3079938445;
	j1681644370 [label="Это разрешено в вашей религии? Я имею в виду, молиться за животных.",shape=box,color=red];
		j1681644370 -> j2448117271;
	j408674845 [label="Ты бы помолился за душу умершего бездомного кота?",shape=box,color=red];
		j408674845 -> j1438518043;
	j3079938445 [label="Как бы то ни было, представьте себе моё удивление, когда, покупая хлеб на рынке, я увидел старого тома, сидящего рядом с владельцем лотка.",shape=box,color=blue];
		j3079938445 -> j3350982390;
	j2448117271 [label="+10 Chemistry",color=orange];
		j2448117271 -> j2988256871;
	j1438518043 [label="Само собой. Некоторые из самых чистых и ярких душ, с которыми я сталкивался, были заключены в плоть зверя. Не мне судить, как Люминарии наставили их на путь истинный.",shape=box,color=blue];
		j1438518043 -> j2845796030;
	j3350982390 [label="Он поприветствовал меня хриплым мяуканьем, как и всегда, и спрыгнул вниз, чтобы потереться о мою ногу.",shape=box,color=blue];
		j3350982390 -> j2389204357;
	j2988256871 [label="Хороший вопрос. В некоторых культах - нет. Это было бы расценено как ересь. Но в нашей - да. Мы признаем, что животные обладают душами.",shape=box,color=blue];
		j2988256871 -> j2845796030;
	j2845796030 [label="Святая Елизавета Премудрая была известна своей благотворительностью по отношению к животным, хотя многие традиции не признают святых апостолами Люминарий.",shape=box,color=blue];
		j2845796030 -> j1175746718;
	j2389204357 [label="И я бы хотел отметить, Скиталец, что он сделал это без малейшей хромоты.",shape=box,color=blue];
		j2389204357 -> j429249050;
	j1175746718 [label="Я ловлю себя на мысли, что наше влияние сохранилось настолько долго... но вряд ли это было целью разговора.",shape=box,color=blue];
		j1175746718 -> j1689362298;
	j429249050 [label="«А, значит, ты один из дурачков старого Деверо, понятно». Мужчина улыбнулся, кладя мой хлеб в пакет.",shape=box,color=blue];
		j429249050 -> j3539860809;
	j1689362298 [label="Boolean LyonLecture1 is now true.",color=orange];
		j1689362298 -> j3079938445;
	j3539860809 [label="Оказалось, что старый кот разыгрывал нас и ещё нескольких соседей. Он не был ни голоден, ни болен, ни оставлен без внимания каким-либо образом.",shape=box,color=blue];
		j3539860809 -> j320445894;
	j320445894 [label="И действительно, если верить словам этого человека, он был настоящим кровожадным злодеем по отношению к местной популяции птиц.",shape=box,color=blue];
		j320445894 -> j2984539671;
		j320445894 -> j3786201499;
		j320445894 -> j2936921602;
	j2984539671 [label="Ты перестал кормить старика Деверо, когда он пришел в себя?",shape=box,color=red];
		j2984539671 -> j650017565;
	j3786201499 [label="Ты пытаешься предупредить меня насчёт Роута?",shape=box,color=red];
		j3786201499 -> j3527137432;
	j2936921602 [label="Ты тот самый бездомный кот в этой истории?",shape=box,color=red];
		j2936921602 -> j2947609729;
	j650017565 [label="+10 Chemistry",color=orange];
		j650017565 -> j1732230245;
	j3527137432 [label="Есть очень много вещей, которые должны предостеречь тебя от дьявола, которого «Cardinal Dimanche» приставил к нашему порогу. Возможно, это одна из них. А может, это не так.",shape=box,color=blue];
		j3527137432 -> j3636576311;
	j2947609729 [label="Люминарии знают, что в последнее время меня порядком потрепало по краям. Но должно ли это служить предупреждением обо мне самом? Возможно. А возможно, это и не так.",shape=box,color=blue];
		j2947609729 -> j3636576311;
	j1732230245 [label="Нет, вовсе нет. На самом деле, Мари приветствовала его с ещё большей нежностью, подшучивая над ним и называя «её маленьким бесенком».",shape=box,color=blue];
		j1732230245 -> j3876977234;
	j3636576311 [label="Это просто история о том, что порой, когда какое-то существо выглядит так, будто нуждается в помощи -",shape=box,color=blue];
		j3636576311 -> j3156754490;
	j3876977234 [label="Но мы больше о нём не тревожились. Мы знали, что старик Деверо вполне мог сам о себе позаботиться. Он не нуждался в нас.",shape=box,color=blue];
		j3876977234 -> j412435909;
		j3876977234 -> j3194797962;
	j3156754490 [label="+15 Chemistry",color=orange];
		j3156754490 -> j1057218606;
	j412435909 [label="Что случилось со стариком Деверо, тебе известно?",shape=box,color=red];
		j412435909 -> j1939731767;
	j3194797962 [label="Как думаешь, что заставило старика Деверо навестить вас, если в этом не было необходимости?",shape=box,color=red];
		j3194797962 -> j2957448427;
	j1057218606 [label="- проверь, насколько острыми могут быть его когти.",shape=box,color=blue];
		j1057218606 -> "Chat ends.";
	j1939731767 [label="Его следующее исчезновение, случившееся два года спустя, стало окончательным.",shape=box,color=blue];
		j1939731767 -> j84089809;
		j1939731767 -> j3710737560;
	j2957448427 [label="Циничный ответ, который я бы тебе дал, был бы: «жадность». Ибо если можно устроить один пир, то почему не два? Почему не десять?",shape=box,color=blue];
		j2957448427 -> j966279937;
		j2957448427 -> j1923856744;
	j84089809 [label="Ты молился за него?",shape=box,color=red];
		j84089809 -> j380445387;
	j3710737560 [label="Надеюсь, он покинул этот мир в покое и с ощущением, что его любили.",shape=box,color=red];
		j3710737560 -> j2574253525;
	j966279937 [label="Каков был бы не циничный ответ?",shape=box,color=red];
		j966279937 -> j1063446189;
	j1923856744 [label="Остаётся ли это верным, если он лишь искал ласки?",shape=box,color=red];
		j1923856744 -> j3744711852;
	j380445387 [label="В тот вечер, когда я узнал о его смерти, я зажёг для него свечу и молился Луа, чтобы она направила его душу... туда, где нашлось бы место даже такому маленькому сорванцу.",shape=box,color=blue];
		j380445387 -> j1547934751;
	j2574253525 [label="Могу ли я спросить почему?",shape=box,color=blue];
		j2574253525 -> j730123925;
		j2574253525 -> j1229911602;
	j1063446189 [label="+10 Chemistry",color=orange];
		j1063446189 -> j2678353471;
	j3744711852 [label="Алчное желание любви это всё ещё остаётся чревоугодием, хотя это и не голод, утоляемый мясом и вином. И искать его под таким ложным предлогом?",shape=box,color=blue];
		j3744711852 -> j1281100595;
		j3744711852 -> j1010400757;
	j1547934751 [label="И поблагодарил старика Деверо за всю радость, что он дарил Мари, в обмен на все эти желанные кусочки куриных хрящей и ласковые поглаживания по голове.",shape=box,color=blue];
		j1547934751 -> j2993962518;
	j730123925 [label="Он был всего лишь животным. Он просто искал удовлетворения - пищи, приюта, любви - его не движили те же побуждения, что и у людей. Он не «лгал», он охотился, пользуясь другим набором инструментов.",shape=box,color=red];
		j730123925 -> j2248063818;
	j1229911602 [label="Я видел много насилия, Лион. И немало по моей вине. Теперь я надеюсь, что каждый, независимо от его личности и поступков, сможет умереть с миром в окружении тех, кто его любит.",shape=box,color=red];
		j1229911602 -> j4059262394;
	j2678353471 [label="Я поймал себя на странном… уважении к этому коту за то место, которое он занял в этом мире.",shape=box,color=blue];
		j2678353471 -> j2718788512;
	j1281100595 [label="Он был котом, Лион. Он едва ли понимал, что делает.",shape=box,color=red];
		j1281100595 -> j3677553206;
	j1010400757 [label="Мы все еще говорим о коте, да?",shape=box,color=red];
		j1010400757 -> j1059504404;
	j2993962518 [label="Благодарю. Я более не стану отягощать твой день.",shape=box,color=blue];
		j2993962518 -> j2038856903;
	j2248063818 [label="Он ни в чем не отказывал другим, делая вас всех своими «дурачками». Если уж на то пошло... вам всем его визиты, похоже, только пошли на пользу.",shape=box,color=red];
		j2248063818 -> j1392092719;
	j4059262394 [label="Удивительно. Я бы ожидал, что ты будешь презирать своих врагов. Но это моя собственная глупость - предполагать, будто я понимаю, как должен вести себя человек в наше время.",shape=box,color=blue];
		j4059262394 -> j1240710770;
	j2718788512 [label="Это было существо, которое научилось использовать своё состояние - свой облик, свой возраст, свои шрамы - как оружие против окружающих его тех самых «дурачков», которые не понимали его игры.",shape=box,color=blue];
		j2718788512 -> j2417780264;
	j3677553206 [label="Он прекрасно понимал, что нужно притвориться хромым. ",shape=box,color=blue];
		j3677553206 -> j1063446189;
	j1059504404 [label="Делай из этого разговора любые выводы, какие сочтёшь нужными, Скиталец.",shape=box,color=blue];
		j1059504404 -> j1063446189;
	j2038856903 [label="-О. Лион Аллард",shape=box,color=blue];
		j2038856903 -> "Chat ends.";
	j1392092719 [label="Add -1 to Thermostat counter",color=orange];
		j1392092719 -> j4198410422;
	j1240710770 [label="Add 1 to Thermostat counter",color=orange];
		j1240710770 -> j3598885856;
	j2417780264 [label="Он и вправду был бесёнком в колтунах шерсти. И всё же я поймал себя на том, что я каждый раз поглаживал его, когда он захаживал в гости.",shape=box,color=blue];
		j2417780264 -> j2335622370;
	j4198410422 [label="Да. Я полагаю, так оно и было. И уж в куриных хрящиках и ласковых поглаживаниях у нас точно не было недостатка.",shape=box,color=blue];
		j4198410422 -> j3774485472;
	j3598885856 [label="Не говоря уже о ком-то с твоим, особенно любопытным, воспитанием. ",shape=box,color=blue];
		j3598885856 -> j1538397684;
	j2335622370 [label="И так же сокрушён, когда спустя два года его очередное исчезновение оказалось окончательным.",shape=box,color=blue];
		j2335622370 -> j84089809;
		j2335622370 -> j3710737560;
	j3774485472 [label="Наверное, поэтому я и зажёг для него свечу и молил Луа принять его душу и провести её туда… куда она бы повела такого маленького бесёнка, как он.",shape=box,color=blue];
		j3774485472 -> j3660862022;
	j1538397684 [label="+5 Chemistry",color=orange];
		j1538397684 -> j3240837303;
	j3660862022 [label="+5 Chemistry",color=orange];
		j3660862022 -> j1909061788;
	j3240837303 [label="Благодарю. Я более не стану отягощать твой день. Беседа выдалась весьма интересной. До следующего общения.",shape=box,color=blue];
		j3240837303 -> j2038856903;
	j1909061788 [label="И почему я той ночью в своих молитвах благодарил старика Деверо за всю ту радость, которую он принес Мари.",shape=box,color=blue];
		j1909061788 -> j261435474;
	j261435474 [label="Возможно, его маленькое злодейство в каком-то смысле пошло на пользу.",shape=box,color=blue];
		j261435474 -> j3240837303;
}