digraph {
	32 [label="LyonRank3Convo2 begins.",color=orange];
		32 -> 33;
	33 [label="Если позволишь, я хотел бы рассказать тебе историю о бродячем коте, который часто заходил к нам за церковь.",shape=box,color=blue];
		33 -> 36;
		33 -> 35;
		33 -> 34;
	36 [label="Продолжай.",shape=box,color=red];
		36 -> 39;
	35 [label="Зачем?",shape=box,color=red];
		35 -> 38;
	34 [label="[Игнорировать.]",shape=box,color=red];
		34 -> 37;
	39 [label="Спасибо.",shape=box,color=blue];
		39 -> 41;
	38 [label="Боюсь для объяснения потребуется больше усилий, чем оно того стоит.",shape=box,color=blue];
		38 -> 40;
	37 [label="Chat ends.",color=orange];
	41 [label="Хотя я и подозреваю, что эта история не уникальна для этого потрепанного старого тома, и моё общение с ним, по-видимому, заслуживает внимания, все её равно стоит рассказать.",shape=box,color=blue];
		41 -> 43;
	40 [label="Забудь.",shape=box,color=blue];
		40 -> 42;
	43 [label="Каждый день он приходил ко мне, выпрашивая объедки и ласку от меня или от других братьев и сестёр, которые заботились о нём.",shape=box,color=blue];
		43 -> 44;
	42 [label="Chat ends.",color=orange];
	44 [label="Он был оборванцем, хромал на лапу и у него отсутствовала часть уха. ",shape=box,color=blue];
		44 -> 45;
	45 [label="Когда он не появился в течение нескольких дней, Мари была вне себя от беспокойства. Но что можно сделать для старого бродячего кота, который встретил свой конец, кроме как вознести молитву Луа?",shape=box,color=blue];
		45 -> 46;
	46 [label="Update boolean LyonStray",color=orange];
		46 -> 47;
		46 -> 48;
		46 -> 49;
	47 [label="[Позволь ему продолжить.]",shape=box,color=red];
		47 -> 50;
	48 [label="Это разрешено в вашей религии? Я имею в виду, молиться за животных.",shape=box,color=red];
		48 -> 51;
	49 [label="Ты бы помолился за душу умершего бездомного кота?",shape=box,color=red];
		49 -> 52;
	50 [label="Как бы то ни было, представьте себе моё удивление, когда, покупая хлеб на рынке, я увидел старого тома, сидящего рядом с владельцем лотка.",shape=box,color=blue];
		50 -> 53;
	51 [label="+10 Chemistry",color=orange];
		51 -> 54;
	52 [label="Само собой. Некоторые из самых чистых и ярких душ, с которыми я сталкивался, были заключены в плоть зверя. Не мне судить, как Люминарии наставили их на путь истинный.",shape=box,color=blue];
		52 -> 55;
	53 [label="Он поприветствовал меня хриплым мяуканьем, как и всегда, и спрыгнул вниз, чтобы потереться о мою ногу.",shape=box,color=blue];
		53 -> 56;
	54 [label="Хороший вопрос. В некоторых культах - нет. Это было бы расценено как ересь. Но в нашей - да. Мы признаем, что животные обладают душами.",shape=box,color=blue];
		54 -> 55;
	55 [label="Святая Елизавета Премудрая была известна своей благотворительностью по отношению к животным, хотя многие традиции не признают святых апостолами Люминарий.",shape=box,color=blue];
		55 -> 57;
	56 [label="И я бы хотел отметить, Скиталец, что он сделал это без малейшей хромоты.",shape=box,color=blue];
		56 -> 58;
	57 [label="Я ловлю себя на мысли, что наше влияние сохранилось настолько долго... но вряд ли это было целью разговора.",shape=box,color=blue];
		57 -> 59;
	58 [label="«А, значит, ты один из дурачков старого Деверо, понятно». Мужчина улыбнулся, кладя мой хлеб в пакет.",shape=box,color=blue];
		58 -> 60;
	59 [label="Update boolean LyonLecture1",color=orange];
		59 -> 50;
	60 [label="Оказалось, что старый кот разыгрывал нас и ещё нескольких соседей. Он не был ни голоден, ни болен, ни оставлен без внимания каким-либо образом.",shape=box,color=blue];
		60 -> 61;
	61 [label="И действительно, если верить словам этого человека, он был настоящим кровожадным злодеем по отношению к местной популяции птиц.",shape=box,color=blue];
		61 -> 62;
		61 -> 63;
		61 -> 64;
	62 [label="Ты перестал кормить старика Деверо, когда он пришел в себя?",shape=box,color=red];
		62 -> 65;
	63 [label="Ты пытаешься предупредить меня насчёт Роута?",shape=box,color=red];
		63 -> 66;
	64 [label="Ты тот самый бездомный кот в этой истории?",shape=box,color=red];
		64 -> 67;
	65 [label="+10 Chemistry",color=orange];
		65 -> 68;
	66 [label="Есть очень много вещей, которые должны предостеречь тебя от дьявола, которого «Cardinal Dimanche» приставил к нашему порогу. Возможно, это одна из них. А может, это не так.",shape=box,color=blue];
		66 -> 69;
	67 [label="Люминарии знают, что в последнее время меня порядком потрепало по краям. Но должно ли это служить предупреждением обо мне самом? Возможно. А возможно, это и не так.",shape=box,color=blue];
		67 -> 69;
	68 [label="Нет, вовсе нет. На самом деле, Мари приветствовала его с ещё большей нежностью, подшучивая над ним и называя «её маленьким бесенком».",shape=box,color=blue];
		68 -> 70;
	69 [label="Это просто история о том, что порой, когда какое-то существо выглядит так, будто нуждается в помощи -",shape=box,color=blue];
		69 -> 71;
	70 [label="Но мы больше о нём не тревожились. Мы знали, что старик Деверо вполне мог сам о себе позаботиться. Он не нуждался в нас.",shape=box,color=blue];
		70 -> 72;
		70 -> 73;
	71 [label="+15 Chemistry",color=orange];
		71 -> 74;
	72 [label="Что случилось со стариком Деверо, тебе известно?",shape=box,color=red];
		72 -> 75;
	73 [label="Как думаешь, что заставило старика Деверо навестить вас, если в этом не было необходимости?",shape=box,color=red];
		73 -> 76;
	74 [label="- проверь, насколько острыми могут быть его когти.",shape=box,color=blue];
		74 -> 77;
	75 [label="Его следующее исчезновение, случившееся два года спустя, стало окончательным.",shape=box,color=blue];
		75 -> 78;
		75 -> 79;
	76 [label="Циничный ответ, который я бы тебе дал, был бы: «жадность». Ибо если можно устроить один пир, то почему не два? Почему не десять?",shape=box,color=blue];
		76 -> 80;
		76 -> 81;
	77 [label="Chat ends.",color=orange];
	78 [label="Ты молился за него?",shape=box,color=red];
		78 -> 82;
	79 [label="Надеюсь, он покинул этот мир в покое и с ощущением, что его любили.",shape=box,color=red];
		79 -> 83;
	80 [label="Каков был бы не циничный ответ?",shape=box,color=red];
		80 -> 84;
	81 [label="Остаётся ли это верным, если он лишь искал ласки?",shape=box,color=red];
		81 -> 85;
	82 [label="В тот вечер, когда я узнал о его смерти, я зажёг для него свечу и молился Луа, чтобы она направила его душу... туда, где нашлось бы место даже такому маленькому сорванцу.",shape=box,color=blue];
		82 -> 86;
	83 [label="Могу ли я спросить почему?",shape=box,color=blue];
		83 -> 87;
		83 -> 88;
	84 [label="+10 Chemistry",color=orange];
		84 -> 89;
	85 [label="Алчное желание любви это всё ещё остаётся чревоугодием, хотя это и не голод, утоляемый мясом и вином. И искать его под таким ложным предлогом?",shape=box,color=blue];
		85 -> 90;
		85 -> 91;
	86 [label="И поблагодарил старика Деверо за всю радость, что он дарил Мари, в обмен на все эти желанные кусочки куриных хрящей и ласковые поглаживания по голове.",shape=box,color=blue];
		86 -> 92;
	87 [label="Он был всего лишь животным. Он просто искал удовлетворения - пищи, приюта, любви - его не движили те же побуждения, что и у людей. Он не «лгал», он охотился, пользуясь другим набором инструментов.",shape=box,color=red];
		87 -> 93;
	88 [label="Я видел много насилия, Лион. И немало по моей вине. Теперь я надеюсь, что каждый, независимо от его личности и поступков, сможет умереть с миром в окружении тех, кто его любит.",shape=box,color=red];
		88 -> 94;
	89 [label="Я поймал себя на странном… уважении к этому коту за то место, которое он занял в этом мире.",shape=box,color=blue];
		89 -> 95;
	90 [label="Он был котом, Лион. Он едва ли понимал, что делает.",shape=box,color=red];
		90 -> 96;
	91 [label="Мы все еще говорим о коте, да?",shape=box,color=red];
		91 -> 97;
	92 [label="Благодарю. Я более не стану отягощать твой день.",shape=box,color=blue];
		92 -> 98;
	93 [label="Он ни в чем не отказывал другим, делая вас всех своими «дурачками». Если уж на то пошло... вам всем его визиты, похоже, только пошли на пользу.",shape=box,color=red];
		93 -> 99;
	94 [label="Удивительно. Я бы ожидал, что ты будешь презирать своих врагов. Но это моя собственная глупость - предполагать, будто я понимаю, как должен вести себя человек в наше время.",shape=box,color=blue];
		94 -> 100;
	95 [label="Это было существо, которое научилось использовать своё состояние - свой облик, свой возраст, свои шрамы - как оружие против окружающих его тех самых «дурачков», которые не понимали его игры.",shape=box,color=blue];
		95 -> 101;
	96 [label="Он прекрасно понимал, что нужно притвориться хромым. ",shape=box,color=blue];
		96 -> 84;
	97 [label="Делай из этого разговора любые выводы, какие сочтёшь нужными, Скиталец.",shape=box,color=blue];
		97 -> 84;
	98 [label="-О. Лион Аллард",shape=box,color=blue];
		98 -> 102;
	99 [label="Add -1 to Thermostat",color=orange];
		99 -> 103;
	100 [label="Add 1 to Thermostat",color=orange];
		100 -> 104;
	101 [label="Он и вправду был бесёнком в колтунах шерсти. И всё же я поймал себя на том, что я каждый раз поглаживал его, когда он захаживал в гости.",shape=box,color=blue];
		101 -> 105;
	102 [label="Chat ends.",color=orange];
	103 [label="Да. Я полагаю, так оно и было. И уж в куриных хрящиках и ласковых поглаживаниях у нас точно не было недостатка.",shape=box,color=blue];
		103 -> 106;
	104 [label="Не говоря уже о ком-то с твоим, особенно любопытным, воспитанием. ",shape=box,color=blue];
		104 -> 107;
	105 [label="И так же сокрушён, когда спустя два года его очередное исчезновение оказалось окончательным.",shape=box,color=blue];
		105 -> 78;
		105 -> 79;
	106 [label="Наверное, поэтому я и зажёг для него свечу и молил Луа принять его душу и провести её туда… куда она бы повела такого маленького бесёнка, как он.",shape=box,color=blue];
		106 -> 108;
	107 [label="+5 Chemistry",color=orange];
		107 -> 109;
	108 [label="+5 Chemistry",color=orange];
		108 -> 110;
	109 [label="Благодарю. Я более не стану отягощать твой день. Беседа выдалась весьма интересной. До следующего общения.",shape=box,color=blue];
		109 -> 111;
	110 [label="И почему я той ночью в своих молитвах благодарил старика Деверо за всю ту радость, которую он принес Мари.",shape=box,color=blue];
		110 -> 112;
	111 [label="-О. Лион Аллард",shape=box,color=blue];
		111 -> 113;
	112 [label="Возможно, его маленькое злодейство в каком-то смысле пошло на пользу.",shape=box,color=blue];
		112 -> 109;
	113 [label="Chat ends.",color=orange];
}