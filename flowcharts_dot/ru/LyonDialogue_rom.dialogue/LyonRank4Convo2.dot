digraph {
	781 [label="LyonRank4Convo2 begins.",color=orange];
		781 -> 782;
		781 -> 783;
		781 -> 784;
	782 [label="Как ты с Мари вообще совмещаете то, что вы, священник и монахиня, но при этом... совершаете акты насилия?",shape=box,color=red];
		782 -> 785;
		782 -> 786;
		782 -> 787;
	783 [label="Могу ли я задать тебе немного странный вопрос, Лион?",shape=box,color=red];
		783 -> 788;
	784 [label="[Конец.]",shape=box,color=red];
		784 -> 789;
	785 [label="Я слышу, как Мари кричит «païens!» и бросается в бой, и... и всё же мне трудно представить её способной осуждать кого-то за инакомыслие. Не могу представить, что ты сильно отличаешься. Она явно очень высокого мнения о тебе.",shape=box,color=red];
		785 -> 790;
	786 [label="Как бы твоя церковь отнеслась к тому, что ты с Мари делаешь здесь? К тому… что тебя просят совершать от её имени?",shape=box,color=red];
		786 -> 791;
	787 [label="Я наблюдаю за тобой и Мари на поле боя, потом говорю с ней наедине, вижу, как ты тихо читаешь книги… и, полагаю, мне трудно выстроить эти образы в моём сознании.",shape=box,color=red];
	788 [label="Если ты находишь возможность описать наше нынешнее положение просто как «странное», то я либо впечатлён вашей стойкостью, либо огорчён твоим ограниченным словарным запасом. Однако подозреваю, что скорее первое.",shape=box,color=blue];
		788 -> 793;
	789 [label="Chat ends.",color=orange];
	790 [label="Ты совершенно прав. Мари не из тех, кто станет осуждать другого за то, что тот в сердце своём хранит древнее божество деревьев. Вместо этого она постаралась бы найти то, что в её вере перекликается с их верованиями.",shape=box,color=blue];
		790 -> 794;
	791 [label="В своё время немало священных войн велось во имя Сола или Луа. Кровавые «крестовые походы» с целью изгнать «язычников» или «захватить святую землю» или с какой-то другой надуманой целью были излюбленными темами того времени.",shape=box,color=blue];
		791 -> 795;
	793 [label="+5 Chemistry",color=orange];
		793 -> 797;
	794 [label="Разве дерево не питается светом Сола? Разве нет той общей почвы, на которой она могла бы разделить с ними хлеб? Она скорее сядет и выслушает их истории, чем станет причинять им вред за их веру.",shape=box,color=blue];
		794 -> 798;
	795 [label="Православие Люминария не имеет армии и не ведёт войн. Оно не запрещает своим членам предпринимать действия или защищать других.",shape=box,color=blue];
		795 -> 727;
	797 [label="То есть, да, продолжай. Ты не можешь сделать это для меня ещё более «странным», спрашивая о том, что тебя интересует.",shape=box,color=blue];
		797 -> 785;
		797 -> 786;
		797 -> 787;
	798 [label="Когда она вступает в бой со своим противником, я думаю, это может быть по одной из двух причин: либо она немного развлекается, разыгрывая роль древнего крестоносца, представляя себя в сверкающих доспехах Рыцаря Сола -",shape=box,color=blue];
		798 -> 796;
	727 [label="Когда Мари вступает в бой со своими противниками, я думаю, это может быть по одной из двух причин: либо она немного развлекается, разыгрывая роль древнего крестоносца, представляя себя в сверкающих доспехах Рыцаря Сола -",shape=box,color=blue];
		727 -> 796;
	796 [label="Или, что более вероятно, она вспоминает Астафор 8:23: «Одиноки души, которые пытаются силой войти в мой дом, ибо они отвержены светом Сола».",shape=box,color=blue];
		796 -> 799;
	799 [label="По ее мнению, насилие, которое она совершает, оправдано во имя защиты высшего блага. Полагаю, так же поступил бы и ты, и те, с кем ты сражаешься бок о бок. ",shape=box,color=blue];
		799 -> 800;
	800 [label="И поэтому те, с кем она сражается, – независимо от их вероисповедания – изгнаны из Сола. Даже если бы они носили священные одежды её ордена, в её глазах они язычники.",shape=box,color=blue];
		800 -> 801;
		800 -> 802;
	801 [label="Замечаю, что ты умолчал о себе. Что ты думаешь обо всех этих ссорах?",shape=box,color=red];
		801 -> 803;
	802 [label="Это имеет смысл. Спасибо.",shape=box,color=red];
		802 -> 804;
	803 [label="Я намеренно уклоняюсь от ответа, Скиталец.",shape=box,color=blue];
		803 -> 805;
		803 -> 806;
	804 [label="+5 Chemistry",color=orange];
		804 -> 807;
	805 [label="А я, между прочим, преднамеренно настойчив, Священник.",shape=box,color=red];
		805 -> 808;
	806 [label="Ладно, принимаю. На сегодня мне и этого достаточно.",shape=box,color=red];
		806 -> 804;
	807 [label="Чего бы это ни стоило… Мари говорила мне, что у тебя добрые намерения. И я верю ей, даже когда не верю самому себе.",shape=box,color=blue];
		807 -> 809;
	808 [label="+10 Chemistry",color=orange];
		808 -> 810;
	809 [label="В конце концов, мне остаётся лишь просить у тебя терпения. Луа знает, что мне его почти всегда не хватает.",shape=box,color=blue];
		809 -> 811;
	810 [label="Хорошо. Если тебя не переубедить, и ты так любопытен… Меня смерть, которую я причиняю, тревожит не так сильно, как… возможно, ты бы ожидал.",shape=box,color=blue];
		810 -> 812;
	811 [label="-Ф. Лион Аллард",shape=box,color=blue];
		811 -> 813;
	812 [label="Или это можно было бы счесть «подобающим» для такого человека в сане и учёного, как я.",shape=box,color=blue];
		812 -> 814;
		812 -> 815;
	813 [label="Chat ends.",color=orange];
	814 [label="В своей жизни я видел больше войны, чем мира, Лион. Если бы я позволил этому терзать меня, думаю, меня бы уже здесь не было. Но это не значит, что всё это не несёт в себе настоящего бремени — настоящей цены.",shape=box,color=red];
		814 -> 816;
	815 [label="Уверен, остальные уже рассказывали тебе, кто я. Что я. Откуда пришёл. О той смерти, что следует за мной, о той, из которой я вышел. О смерти, что определяет меня. Думаешь, что-то из того, что ты чувствуешь, удивит меня?",shape=box,color=red];
		815 -> 817;
	816 [label="Add 1 to Thermostat",color=orange];
		816 -> 818;
	817 [label="Add -1 to Thermostat",color=orange];
		817 -> 819;
	818 [label="Да, это так.",shape=box,color=blue];
		818 -> 820;
		818 -> 821;
	819 [label="Да.",shape=box,color=blue];
		819 -> 820;
		819 -> 821;
	820 [label="Извини. Мне кажется, я тебя расстроил. Мне не хотелось этого.",shape=box,color=red];
		820 -> 822;
	821 [label="Хочешь… пояснить?",shape=box,color=red];
		821 -> 823;
	822 [label="Не вини себя, Скиталец. Я, как сказали бы наши братья и сёстры из Либертатии, «крепкий орешек».",shape=box,color=blue];
		822 -> 824;
	823 [label="Ужасы, что отзываются в моей памяти, будто не знают границ. Я вижу цепи из человеческих сухожилий, которые когда-то сочились свежей кровью, а теперь стали хрупкими и почерневшими.",shape=box,color=blue];
		823 -> 825;
	824 [label="Я всего лишь осаждённый. Я держу оборону. Открыть ворота — значит поставить под угрозу целостность защиты.",shape=box,color=blue];
		824 -> 826;
		824 -> 827;
	825 [label="Я вижу сотни тысяч собственных обликов, похожих, но чуждых. Опустошённые гробы, трупы искривлённой, сломанной человеческой плоти, подвешенные в завесе между жизнью и смертью.",shape=box,color=blue];
		825 -> 828;
	826 [label="Понимаю. Когда будешь готов, поговорим.",shape=box,color=red];
		826 -> 829;
	827 [label="Что ты имеешь в виду?",shape=box,color=red];
		827 -> 823;
	828 [label="Лица застыли в маске пустого покоя. Но в мерцающих остатках их душ, в тлеющих углях, что не гаснут,
я слышу их крик. Бесконечный вой, требующий возмездия. Свободы.",shape=box,color=blue];
		828 -> 830;
	829 [label="У меня начинает складываться отчётливое впечатление, что у меня нет выбора в этом вопросе.",shape=box,color=blue];
		829 -> 831;
	830 [label="Смерти.",shape=box,color=blue];
		830 -> 832;
	831 [label="+15 Chemistry",color=orange];
		831 -> 833;
	832 [label="Эти видения преследуют меня наяву. В моих снах. У меня нет ночных кошмаров, ведь это всё, что я переживаю, всё, чем я стал.",shape=box,color=blue];
		832 -> 834;
	833 [label="Но, если уж на то пошло, Мари говорила мне, что у тебя добрые намерения. И я верю ей, даже когда не верю самому себе.",shape=box,color=blue];
		833 -> 835;
	834 [label="Check boolean LyonPainOff",color=orange];
		834 -> 836 [label=true,color=green];
		834 -> 837 [label=false,color=brown];
	835 [label="В конце концов, мне остаётся лишь просить у тебя терпения. Луа знает, что мне его почти всегда не хватает.",shape=box,color=blue];
		835 -> 838;
	836 [label="Лишь когда я приношу жертву шёпотам, что звучат в глубине моей души, мир отражается для меня в том виде, который похож на тот, который вы, возможно, найдете знакомым.",shape=box,color=blue];
		836 -> 839;
	837 [label="Лишь когда я раздираю плоть на своём теле в жертву шёпотам, что отзываются в глубине моей души, мир отражается мне так, как, возможно, знаком он тебе.",shape=box,color=blue];
		837 -> 839;
	838 [label="-Ф. Лион Аллард",shape=box,color=blue];
		838 -> 840;
	839 [label="Прошу, не притворяйся, будто знаешь, что я «чувствую», Скиталец. Боюсь, ты лишь начинаешь понимать.",shape=box,color=blue];
		839 -> 841;
		839 -> 842;
		839 -> 843;
	840 [label="Update boolean LyonVisions2d",color=orange];
		840 -> 844;
	841 [label="Я… прости. Нет, мне это было неизвестно.",shape=box,color=red];
		841 -> 845;
	842 [label="И я видел много ужаса и боли, которые ты тоже не понимаешь, Лион.",shape=box,color=red];
		842 -> 846;
	843 [label="Прости, если это было сказано не к месту. Но я хочу понять. Эти твои видения...",shape=box,color=red];
		843 -> 847;
	844 [label="Chat ends.",color=orange];
	845 [label="Да. Ну… Я пережил эти долгие годы. Продержусь ещё несколько, я уверен. Не стоит слишком беспокоиться обо мне.",shape=box,color=blue];
		845 -> 848;
	846 [label="Я почти уверен, что да, ведь отчасти это отражено в образах этого места. Но считаешь ли ты себя высшим? Верховным Знатоком Всех Ужасов и Всех Страданий?",shape=box,color=blue];
		846 -> 849;
		846 -> 850;
	847 [label="Да. Ну… Я выдерживал всё это многие годы. Продержусь ещё несколько, в этом я уверен. Тебе не стоит слишком беспокоиться обо мне.",shape=box,color=blue];
		847 -> 848;
	848 [label="Update boolean LyonVisions2a",color=orange];
		848 -> 851;
		848 -> 852;
	849 [label="Я говорю о том, что, возможно, могу понять то, что ты переживаешь, лучше, чем тебе кажется.",shape=box,color=red];
		849 -> 853;
	850 [label="Я говорю, что мне довелось пережить много смертей и ужасов, Лион. Поэтому мне не нравится, когда со мной из-за этого говорят свысока.",shape=box,color=red];
		850 -> 854;
	851 [label="То, что ты описываешь, Лион… это видение началось до или после того, как ты стал протофреймом?",shape=box,color=red];
		851 -> 855;
	852 [label="Мы можем поговорить об этом ещё раз? Пожалуйста?",shape=box,color=red];
		852 -> 856;
	853 [label="Update boolean LyonVisions2b",color=orange];
		853 -> 857;
	854 [label="Update boolean LyonVisions2c",color=orange];
		854 -> 858;
	855 [label="Если бы этот вопрос был таким простым, как ты думаешь. Как бы то ни было, сегодня я не готов на него отвечать. Кажется, у меня начинает болеть голова.",shape=box,color=blue];
		855 -> 859;
	856 [label="У меня начинает складываться отчётливое впечатление, что у меня нет выбора в этом вопросе.",shape=box,color=blue];
		856 -> 859;
	857 [label="Тебе может показаться странным, что я не ищу сочувствия, Скиталец. Мне нужны ответы. Уверенность. Твёрдая опора, когда всё вокруг — иллюзия и ложь.",shape=box,color=blue];
		857 -> 860;
		857 -> 861;
	858 [label="Тогда позволь мне склониться перед тобой. Восхвалять за всё, что пришлось пережить. Удивляться тому, как удалось сохранить рассудок после всего, что пришлось увидеть.",shape=box,color=blue];
		858 -> 862;
	859 [label="+10 Chemistry",color=orange];
		859 -> 863;
	860 [label="Я сделаю всё, что в моих силах.",shape=box,color=red];
		860 -> 864;
	861 [label="Тогда, возможно, я смогу тебе помочь. Давай поговорим об этом ещё раз? Пожалуйста?",shape=box,color=red];
		861 -> 856;
	862 [label="И удивляться тому, как ты всё ещё находишь время для всех остальных, кого считаешь столь далёкими от своего возвышенного положения.",shape=box,color=blue];
		862 -> 865;
	863 [label="Но, если уж на то пошло, Мари говорила мне, что у тебя добрые намерения. И я верю ей, даже когда не верю самому себе.",shape=box,color=blue];
		863 -> 866;
	864 [label="+5 Chemistry",color=orange];
		864 -> 867;
	865 [label="Chat ends.",color=orange];
	866 [label="В конце концов, мне остаётся лишь просить у тебя терпения. Луа знает, что мне его почти всегда не хватает.",shape=box,color=blue];
		866 -> 868;
	867 [label="Разве это не всё, о чём можно просить?",shape=box,color=blue];
		867 -> 869;
	868 [label="-Ф. Лион Аллард",shape=box,color=blue];
		868 -> 870;
	869 [label="Chat ends.",color=orange];
	870 [label="Chat ends.",color=orange];
}