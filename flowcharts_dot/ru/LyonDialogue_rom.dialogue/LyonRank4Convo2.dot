digraph {
	"LyonRank4Convo2 begins." [color=orange];
		"LyonRank4Convo2 begins." -> j1390400675;
		"LyonRank4Convo2 begins." -> j1682822129;
		"LyonRank4Convo2 begins." -> j1310452999;
	j1390400675 [label="Как ты с Мари вообще совмещаете то, что вы, священник и монахиня, но при этом... совершаете акты насилия?",shape=box,color=red];
		j1390400675 -> j1705206215;
		j1390400675 -> j3474186131;
		j1390400675 -> j1948073286;
	j1682822129 [label="Могу ли я задать тебе немного странный вопрос, Лион?",shape=box,color=red];
		j1682822129 -> j2733238476;
	j1310452999 [label="[Конец.]",shape=box,color=red];
		j1310452999 -> "Chat ends.";
	j1705206215 [label="Я слышу, как Мари кричит «païens!» и бросается в бой, и... и всё же мне трудно представить её способной осуждать кого-то за инакомыслие. Не могу представить, что ты сильно отличаешься. Она явно очень высокого мнения о тебе.",shape=box,color=red];
		j1705206215 -> j1334026985;
	j3474186131 [label="Как бы твоя церковь отнеслась к тому, что ты с Мари делаешь здесь? К тому… что тебя просят совершать от её имени?",shape=box,color=red];
		j3474186131 -> j2967754013;
	j1948073286 [label="Я наблюдаю за тобой и Мари на поле боя, потом говорю с ней наедине, вижу, как ты тихо читаешь книги… и, полагаю, мне трудно выстроить эти образы в моём сознании.",shape=box,color=red];
	j2733238476 [label="Если ты находишь возможность описать наше нынешнее положение просто как «странное», то я либо впечатлён вашей стойкостью, либо огорчён твоим ограниченным словарным запасом. Однако подозреваю, что скорее первое.",shape=box,color=blue];
		j2733238476 -> j2134424212;
	"Chat ends." [color=orange];
	j1334026985 [label="Ты совершенно прав. Мари не из тех, кто станет осуждать другого за то, что тот в сердце своём хранит древнее божество деревьев. Вместо этого она постаралась бы найти то, что в её вере перекликается с их верованиями.",shape=box,color=blue];
		j1334026985 -> j3602206167;
	j2967754013 [label="В своё время немало священных войн велось во имя Сола или Луа. Кровавые «крестовые походы» с целью изгнать «язычников» или «захватить святую землю» или с какой-то другой надуманой целью были излюбленными темами того времени.",shape=box,color=blue];
		j2967754013 -> j4048793494;
	j2134424212 [label="+5 Chemistry",color=orange];
		j2134424212 -> j936705349;
	j3602206167 [label="Разве дерево не питается светом Сола? Разве нет той общей почвы, на которой она могла бы разделить с ними хлеб? Она скорее сядет и выслушает их истории, чем станет причинять им вред за их веру.",shape=box,color=blue];
		j3602206167 -> j1739749974;
	j4048793494 [label="Православие Люминария не имеет армии и не ведёт войн. Оно не запрещает своим членам предпринимать действия или защищать других.",shape=box,color=blue];
		j4048793494 -> j428871848;
	j936705349 [label="То есть, да, продолжай. Ты не можешь сделать это для меня ещё более «странным», спрашивая о том, что тебя интересует.",shape=box,color=blue];
		j936705349 -> j1705206215;
		j936705349 -> j3474186131;
		j936705349 -> j1948073286;
	j1739749974 [label="Когда она вступает в бой со своим противником, я думаю, это может быть по одной из двух причин: либо она немного развлекается, разыгрывая роль древнего крестоносца, представляя себя в сверкающих доспехах Рыцаря Сола -",shape=box,color=blue];
		j1739749974 -> j804967980;
	j428871848 [label="Когда Мари вступает в бой со своими противниками, я думаю, это может быть по одной из двух причин: либо она немного развлекается, разыгрывая роль древнего крестоносца, представляя себя в сверкающих доспехах Рыцаря Сола -",shape=box,color=blue];
		j428871848 -> j804967980;
	j804967980 [label="Или, что более вероятно, она вспоминает Астафор 8:23: «Одиноки души, которые пытаются силой войти в мой дом, ибо они отвержены светом Сола».",shape=box,color=blue];
		j804967980 -> j1578816118;
	j1578816118 [label="По ее мнению, насилие, которое она совершает, оправдано во имя защиты высшего блага. Полагаю, так же поступил бы и ты, и те, с кем ты сражаешься бок о бок. ",shape=box,color=blue];
		j1578816118 -> j1733930491;
	j1733930491 [label="И поэтому те, с кем она сражается, – независимо от их вероисповедания – изгнаны из Сола. Даже если бы они носили священные одежды её ордена, в её глазах они язычники.",shape=box,color=blue];
		j1733930491 -> j3538439469;
		j1733930491 -> j1767462058;
	j3538439469 [label="Замечаю, что ты умолчал о себе. Что ты думаешь обо всех этих ссорах?",shape=box,color=red];
		j3538439469 -> j1468687255;
	j1767462058 [label="Это имеет смысл. Спасибо.",shape=box,color=red];
		j1767462058 -> j2612462747;
	j1468687255 [label="Я намеренно уклоняюсь от ответа, Скиталец.",shape=box,color=blue];
		j1468687255 -> j1205826677;
		j1468687255 -> j4010358570;
	j2612462747 [label="+5 Chemistry",color=orange];
		j2612462747 -> j3250852788;
	j1205826677 [label="А я, между прочим, преднамеренно настойчив, Священник.",shape=box,color=red];
		j1205826677 -> j2857780159;
	j4010358570 [label="Ладно, принимаю. На сегодня мне и этого достаточно.",shape=box,color=red];
		j4010358570 -> j2612462747;
	j3250852788 [label="Чего бы это ни стоило… Мари говорила мне, что у тебя добрые намерения. И я верю ей, даже когда не верю самому себе.",shape=box,color=blue];
		j3250852788 -> j1461911782;
	j2857780159 [label="+10 Chemistry",color=orange];
		j2857780159 -> j3665163207;
	j1461911782 [label="В конце концов, мне остаётся лишь просить у тебя терпения. Луа знает, что мне его почти всегда не хватает.",shape=box,color=blue];
		j1461911782 -> j1542260442;
	j3665163207 [label="Хорошо. Если тебя не переубедить, и ты так любопытен… Меня смерть, которую я причиняю, тревожит не так сильно, как… возможно, ты бы ожидал.",shape=box,color=blue];
		j3665163207 -> j2052577374;
	j1542260442 [label="-Ф. Лион Аллард",shape=box,color=blue];
		j1542260442 -> "Chat ends.";
	j2052577374 [label="Или это можно было бы счесть «подобающим» для такого человека в сане и учёного, как я.",shape=box,color=blue];
		j2052577374 -> j1361008885;
		j2052577374 -> j2780281016;
	j1361008885 [label="В своей жизни я видел больше войны, чем мира, Лион. Если бы я позволил этому терзать меня, думаю, меня бы уже здесь не было. Но это не значит, что всё это не несёт в себе настоящего бремени — настоящей цены.",shape=box,color=red];
		j1361008885 -> j1604515722;
	j2780281016 [label="Уверен, остальные уже рассказывали тебе, кто я. Что я. Откуда пришёл. О той смерти, что следует за мной, о той, из которой я вышел. О смерти, что определяет меня. Думаешь, что-то из того, что ты чувствуешь, удивит меня?",shape=box,color=red];
		j2780281016 -> j442157460;
	j1604515722 [label="Add 1 to Thermostat counter",color=orange];
		j1604515722 -> j3709089183;
	j442157460 [label="Add -1 to Thermostat counter",color=orange];
		j442157460 -> j4293640951;
	j3709089183 [label="Да, это так.",shape=box,color=blue];
		j3709089183 -> j82309162;
		j3709089183 -> j2742804760;
	j4293640951 [label="Да.",shape=box,color=blue];
		j4293640951 -> j82309162;
		j4293640951 -> j2742804760;
	j82309162 [label="Извини. Мне кажется, я тебя расстроил. Мне не хотелось этого.",shape=box,color=red];
		j82309162 -> j354762406;
	j2742804760 [label="Хочешь… пояснить?",shape=box,color=red];
		j2742804760 -> j837043426;
	j354762406 [label="Не вини себя, Скиталец. Я, как сказали бы наши братья и сёстры из Либертатии, «крепкий орешек».",shape=box,color=blue];
		j354762406 -> j3003498538;
	j837043426 [label="Ужасы, что отзываются в моей памяти, будто не знают границ. Я вижу цепи из человеческих сухожилий, которые когда-то сочились свежей кровью, а теперь стали хрупкими и почерневшими.",shape=box,color=blue];
		j837043426 -> j1494342503;
	j3003498538 [label="Я всего лишь осаждённый. Я держу оборону. Открыть ворота — значит поставить под угрозу целостность защиты.",shape=box,color=blue];
		j3003498538 -> j623607472;
		j3003498538 -> j80821924;
	j1494342503 [label="Я вижу сотни тысяч собственных обликов, похожих, но чуждых. Опустошённые гробы, трупы искривлённой, сломанной человеческой плоти, подвешенные в завесе между жизнью и смертью.",shape=box,color=blue];
		j1494342503 -> j2916108845;
	j623607472 [label="Понимаю. Когда будешь готов, поговорим.",shape=box,color=red];
		j623607472 -> j3784217216;
	j80821924 [label="Что ты имеешь в виду?",shape=box,color=red];
		j80821924 -> j837043426;
	j2916108845 [label="Лица застыли в маске пустого покоя. Но в мерцающих остатках их душ, в тлеющих углях, что не гаснут,\nя слышу их крик. Бесконечный вой, требующий возмездия. Свободы.",shape=box,color=blue];
		j2916108845 -> j3597371108;
	j3784217216 [label="У меня начинает складываться отчётливое впечатление, что у меня нет выбора в этом вопросе.",shape=box,color=blue];
		j3784217216 -> j3235207640;
	j3597371108 [label="Смерти.",shape=box,color=blue];
		j3597371108 -> j1330023888;
	j3235207640 [label="+15 Chemistry",color=orange];
		j3235207640 -> j2355845193;
	j1330023888 [label="Эти видения преследуют меня наяву. В моих снах. У меня нет ночных кошмаров, ведь это всё, что я переживаю, всё, чем я стал.",shape=box,color=blue];
		j1330023888 -> j1274675553;
	j2355845193 [label="Но, если уж на то пошло, Мари говорила мне, что у тебя добрые намерения. И я верю ей, даже когда не верю самому себе.",shape=box,color=blue];
		j2355845193 -> j698680066;
	j1274675553 [label="Check boolean LyonPainOff",color=orange];
		j1274675553 -> j933743280 [label=true,color=green];
		j1274675553 -> j982101995 [label=false,color=brown];
	j698680066 [label="В конце концов, мне остаётся лишь просить у тебя терпения. Луа знает, что мне его почти всегда не хватает.",shape=box,color=blue];
		j698680066 -> j2197387322;
	j933743280 [label="Лишь когда я приношу жертву шёпотам, что звучат в глубине моей души, мир отражается для меня в том виде, который похож на тот, который вы, возможно, найдете знакомым.",shape=box,color=blue];
		j933743280 -> j675058086;
	j982101995 [label="Лишь когда я раздираю плоть на своём теле в жертву шёпотам, что отзываются в глубине моей души, мир отражается мне так, как, возможно, знаком он тебе.",shape=box,color=blue];
		j982101995 -> j675058086;
	j2197387322 [label="-Ф. Лион Аллард",shape=box,color=blue];
		j2197387322 -> j2522325746;
	j675058086 [label="Прошу, не притворяйся, будто знаешь, что я «чувствую», Скиталец. Боюсь, ты лишь начинаешь понимать.",shape=box,color=blue];
		j675058086 -> j3059367846;
		j675058086 -> j1683184610;
		j675058086 -> j3813196149;
	j2522325746 [label="Boolean LyonVisions2d is now true.",color=orange];
		j2522325746 -> "Chat ends.";
	j3059367846 [label="Я… прости. Нет, мне это было неизвестно.",shape=box,color=red];
		j3059367846 -> j1379761244;
	j1683184610 [label="И я видел много ужаса и боли, которые ты тоже не понимаешь, Лион.",shape=box,color=red];
		j1683184610 -> j578964012;
	j3813196149 [label="Прости, если это было сказано не к месту. Но я хочу понять. Эти твои видения...",shape=box,color=red];
		j3813196149 -> j416610558;
	j1379761244 [label="Да. Ну… Я пережил эти долгие годы. Продержусь ещё несколько, я уверен. Не стоит слишком беспокоиться обо мне.",shape=box,color=blue];
		j1379761244 -> j4270520825;
	j578964012 [label="Я почти уверен, что да, ведь отчасти это отражено в образах этого места. Но считаешь ли ты себя высшим? Верховным Знатоком Всех Ужасов и Всех Страданий?",shape=box,color=blue];
		j578964012 -> j2360490873;
		j578964012 -> j1759739586;
	j416610558 [label="Да. Ну… Я выдерживал всё это многие годы. Продержусь ещё несколько, в этом я уверен. Тебе не стоит слишком беспокоиться обо мне.",shape=box,color=blue];
		j416610558 -> j4270520825;
	j4270520825 [label="Boolean LyonVisions2a is now true.",color=orange];
		j4270520825 -> j3666649348;
		j4270520825 -> j1743267431;
	j2360490873 [label="Я говорю о том, что, возможно, могу понять то, что ты переживаешь, лучше, чем тебе кажется.",shape=box,color=red];
		j2360490873 -> j3849310143;
	j1759739586 [label="Я говорю, что мне довелось пережить много смертей и ужасов, Лион. Поэтому мне не нравится, когда со мной из-за этого говорят свысока.",shape=box,color=red];
		j1759739586 -> j3546366689;
	j3666649348 [label="То, что ты описываешь, Лион… это видение началось до или после того, как ты стал протофреймом?",shape=box,color=red];
		j3666649348 -> j739674046;
	j1743267431 [label="Мы можем поговорить об этом ещё раз? Пожалуйста?",shape=box,color=red];
		j1743267431 -> j571548293;
	j3849310143 [label="Boolean LyonVisions2b is now true.",color=orange];
		j3849310143 -> j3524654958;
	j3546366689 [label="Boolean LyonVisions2c is now true.",color=orange];
		j3546366689 -> j327998751;
	j739674046 [label="Если бы этот вопрос был таким простым, как ты думаешь. Как бы то ни было, сегодня я не готов на него отвечать. Кажется, у меня начинает болеть голова.",shape=box,color=blue];
		j739674046 -> j593557686;
	j571548293 [label="У меня начинает складываться отчётливое впечатление, что у меня нет выбора в этом вопросе.",shape=box,color=blue];
		j571548293 -> j593557686;
	j3524654958 [label="Тебе может показаться странным, что я не ищу сочувствия, Скиталец. Мне нужны ответы. Уверенность. Твёрдая опора, когда всё вокруг — иллюзия и ложь.",shape=box,color=blue];
		j3524654958 -> j2000009849;
		j3524654958 -> j1258612750;
	j327998751 [label="Тогда позволь мне склониться перед тобой. Восхвалять за всё, что пришлось пережить. Удивляться тому, как удалось сохранить рассудок после всего, что пришлось увидеть.",shape=box,color=blue];
		j327998751 -> j2266514276;
	j593557686 [label="+10 Chemistry",color=orange];
		j593557686 -> j948346719;
	j2000009849 [label="Я сделаю всё, что в моих силах.",shape=box,color=red];
		j2000009849 -> j3450118301;
	j1258612750 [label="Тогда, возможно, я смогу тебе помочь. Давай поговорим об этом ещё раз? Пожалуйста?",shape=box,color=red];
		j1258612750 -> j571548293;
	j2266514276 [label="И удивляться тому, как ты всё ещё находишь время для всех остальных, кого считаешь столь далёкими от своего возвышенного положения.",shape=box,color=blue];
		j2266514276 -> "Chat ends.";
	j948346719 [label="Но, если уж на то пошло, Мари говорила мне, что у тебя добрые намерения. И я верю ей, даже когда не верю самому себе.",shape=box,color=blue];
		j948346719 -> j1461911782;
	j3450118301 [label="+5 Chemistry",color=orange];
		j3450118301 -> j3891465670;
	j3891465670 [label="Разве это не всё, о чём можно просить?",shape=box,color=blue];
		j3891465670 -> "Chat ends.";
}