	j2159732319 [label="MomToxicated: Она заслужила уважение своих солдат, потому что знала, что такое лидерство. Не выкрикивать приказы из-за спины. Но показать людям, что ты будешь сражаться за них. С ними.",shape=box,color=blue];
		j2159732319 -> j2081591785;
	j2382815524 [label="MomToxicated: Блестящие предметы. Как блеснувшая в воде приманка, привлекающая всю ближайшую крупную, тупую рыбу. Молюсь, чтобы она попалась. Это моя маленькая девочка.",shape=box,color=blue];
