		j260215545 -> j149848069;
	j1328370936 [label="MomToxicated: Я бы оспорила твое определение слова \"фанатик\", хотя я понимаю твою точку зрения и, учитывая твое общение с ней, это все, что тебе нужно сделать.",shape=box,color=blue];
		j1328370936 -> j4045548822;
	j1726633661 [label="MomToxicated: Я воспитала ее так, чтобы она полностью раскрыла свой потенциал. На что ты намекаешь?",shape=box,color=blue];
		j1726633661 -> j3969771836;
	j2082242849 [label="PapaPolar: ты \"встречал\" её мать?",shape=box,color=blue];
		j2082242849 -> j1485055615;
	j149848069 [label="PapaPolar: гав.",shape=box,color=blue];
		j149848069 -> j246611126;
	j4045548822 [label="MomToxicated: Я полагаю, что для Нэси, когда она присоединилась к Скальдре, это было средством достижения цели. Она верила в окружающих ее людей меньше, чем в твердую приверженность вере. В отличие от Водяного.",shape=box,color=blue];
		j4045548822 -> j3268830798;
	j3969771836 [label="PapaPolar: я думаю, что совершенно ясно, на что они намекают, М",shape=box,color=blue];
		j3969771836 -> j1344781431;
	j1485055615 [label="MomToxicated: Кхм. И это говорит человек, из-за которого у нее возникли проблемы с курением.",shape=box,color=blue];
		j1485055615 -> j1604132204;
	j246611126 [label="PapaPolar: - слушай. я даже не уверен, что ей действительно нравилось все это... фанатизм сол-луа",shape=box,color=blue];
		j246611126 -> j1606664491;
	j3268830798 [label="MomToxicated: Она всегда была честолюбивой женщиной. Честолюбие, которое я поощряла, взращивала и подпитывала. В отличие от \"кого-то\", кто хотел бы заморозить это и оставить ее в каком-то состоянии прерванного детства.",shape=box,color=blue];
		j3268830798 -> j880072528;
	j1344781431 [label="PapaPolar: яблоки не падают далеко от образного лифчика с пуш-апом, дорогая",shape=box,color=blue];
		j1344781431 -> j3280942103;
	j1604132204 [label="PapaPolar: да, я и говорю, яблоки не падают далеко от образного лифчика с пуш-апом, дорогая",shape=box,color=blue];
		j1604132204 -> j2268401165;
	j1606664491 [label="PapaPolar: по крайней мере, не так сильно, как остальные обитатели скальдры. для нее, я думаю, это всегда было средством достижения цели. ",shape=box,color=blue];
		j1606664491 -> j1688723498;
	j880072528 [label="PapaPolar: ведь это я сказал, что она может уйти, не так ли?!",shape=box,color=blue];
		j880072528 -> j1581928172;
	j3280942103 [label="MomToxicated: Очень смешно. Ты такой ужасно умный. Позволь мне аплодировать твоему подавляющему остроумию. По крайней мере, я не приучила её к проклятой зависимости от сигарет.",shape=box,color=blue];
		j3280942103 -> j3281194292;
	j2268401165 [label="PapaPolar: она научилась тому, чему научилась, потому что это работает, но она взяла это откуда-то. и ты не можешь сказать, что это не так.",shape=box,color=blue];
		j2268401165 -> j1514422978;
	j1688723498 [label="PapaPolar: для некоторых людей любая лестница, по которой стоит подняться, — это лестница, стоящая того, чтобы на неё взобраться.",shape=box,color=blue];
		j1688723498 -> j1441777250;
	j1581928172 [label="MomToxicated: О, да. Тот *единственный* раз, когда ты позволил ей выразить себя без твоего невыносимого переживания, — это *единственный* раз, когда ты решил меня не слушать, не довериться мне и отпустил её, и посмотри, что получилось!",shape=box,color=blue];
		j1581928172 -> j3687852088;
	j3281194292 [label="MomToxicated: Велимир грубо шутит (и делает это довольно неудачно), что иногда у женщины ограниченный выбор подходов к той или иной ситуации.",shape=box,color=blue];
		j3281194292 -> j1548908835;
	j1514422978 [label="PapaPolar: послушай, когда ты служишь в армии, иногда это просто... иногда ты используешь свои возможности, да?",shape=box,color=blue];
		j1514422978 -> j366188713;
	j1441777250 [label="MomToxicated: У неё есть амбиции. Ты всегда ставил ей это в вину.",shape=box,color=blue];
		j1441777250 -> j1684167531;
	j3687852088 [label="PapaPolar: И СКОЛЬКО РАЗ Я ДОЛЖЕН ПОВТОРЯТЬ, ЧТО МНЕ ЧЕРТОВСКИ ЖАЛЬ",shape=box,color=blue];
