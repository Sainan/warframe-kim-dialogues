		j3559833917 -> j260215545;
	j4248889810 [label="Мне просто любопытно, как именно она стала таким военным фанатиком.",shape=box,color=red];
		j4248889810 -> j1328370936;
	j1245371094 [label="Ну, она... Мне интересно, как она стала такой, какая она есть.",shape=box,color=red];
		j1245371094 -> j1726633661;
	j399742351 [label="Ну, она... Мне интересно, как она стала такой, какая она есть.",shape=box,color=red];
		j399742351 -> j2082242849;
