	j2363391670 [label="MomToxicated: О, да. Тот *единственный* раз, когда ты позволил ей выразить себя без твоего невыносимого переживания, — это *единственный* раз, когда ты решил меня не слушать, не довериться мне и отпустил её, и посмотри, что получилось!",shape=box,color=blue];
