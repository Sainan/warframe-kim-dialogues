	j1138299529 [label="Check boolean VelimirEclipse",color=orange];
		j1138299529 -> j392677634 [label=true,color=green];
		j1138299529 -> "Chat ends." [label=false,color=brown];
	j392677634 [label="Check /Lotus/Scripts/1999/DialogueScriptNodes.lua:CheckDuviriMitwCollectibles(collectibleType=/Lotus/Types/Lore/Fragments/DuviriMITWFragments/DuviriMITWCollectibleDeco)",color=orange];
		j392677634 -> j236609087 [label=true,color=green];
		j392677634 -> "Chat ends." [label=false,color=brown];
	"Chat ends." [color=orange];
	j236609087 [label="Эй... ребята?",shape=box,color=red];
		j236609087 -> j2729202403;
	j2729202403 [label="MomToxicated: Да?",shape=box,color=blue];
		j2729202403 -> j1112418100;
	j1112418100 [label="PapaPolar: что такое, дружище?",shape=box,color=blue];
		j1112418100 -> j2202682031;
		j1112418100 -> j703583531;
		j1112418100 -> j987511213;
	j2202682031 [label="У меня есть хорошие и плохие новости. О Нэси.",shape=box,color=red];
		j2202682031 -> j1548388592;
	j703583531 [label="Я хочу, чтобы вы оба не строили иллюзий. У меня есть новости о Нэси, но они... неоднозначные. И пока не дают ясности.",shape=box,color=red];
		j703583531 -> j2633109282;
	j987511213 [label="Ббл... Впрочем, неважно. [Завершить.]",shape=box,color=red];
		j987511213 -> "Chat ends.";
	j1548388592 [label="PapaPolar: давай по-взрослому. начни с плохой новости.",shape=box,color=blue];
		j1548388592 -> j4264579850;
	j2633109282 [label="+5 Chemistry",color=orange];
		j2633109282 -> j2987219819;
	j4264579850 [label="MomToxicated: Соглашусь. Плохие новости всегда приходят первыми.",shape=box,color=blue];
		j4264579850 -> j2295010173;
	j2987219819 [label="MomToxicated: По жизни вообще всё обычно так. Но спасибо за предупреждение.",shape=box,color=blue];
		j2987219819 -> j1803427243;
	j2295010173 [label="Короче. Безразличие ушло в Дувири. и... увело туда с собой Нэси.",shape=box,color=red];
		j2295010173 -> j1556206858;
	j1803427243 [label="+5 Chemistry",color=orange];
		j1803427243 -> j1517643450;
	j1556206858 [label="PapaPolar: подожди. подожди подожди... ты имеешь в виду то сказочное измерение, что ли?",shape=box,color=blue];
		j1556206858 -> j3813201938;
	j1517643450 [label="PapaPolar: настраиваюсь на худшее, но звучит так, будто... она хотя бы жива?",shape=box,color=blue];
		j1517643450 -> j178851899;
	j3813201938 [label="MomToxicated: То самое, где ребёнок-диктатор, который убивал тебя снова и снова?",shape=box,color=blue];
		j3813201938 -> j905300485;
		j3813201938 -> j1407710225;
	j178851899 [label="Я... не знаю. Впрочем, думаю, что нет. Но позвольте мне рассказать то, что я знаю, а вы уже сами сделаете выводы.",shape=box,color=red];
		j178851899 -> j2295010173;
	j905300485 [label="Оказалось, для него это был какой-то момент роста? Впрочем, не суть. Короче...",shape=box,color=red];
		j905300485 -> j2067899809;
	j1407710225 [label="Это оно самое.",shape=box,color=red];
		j1407710225 -> j2067899809;
	j2067899809 [label="Нэси... заняла трон. Шёпот - «армия» Безразличия, если так можно выразиться, вторгся, и она захватила власть.",shape=box,color=red];
		j2067899809 -> j3547579694;
	j3547579694 [label="MomToxicated: Хех. Это моя маленькая девочка.",shape=box,color=blue];
		j3547579694 -> j3718679630;
	j3718679630 [label="PapaPolar: но это правда была *она*? или просто та тварь в её обличье?",shape=box,color=blue];
		j3718679630 -> j269069808;
		j3718679630 -> j1998222029;
	j269069808 [label="Я не знаю.",shape=box,color=red];
		j269069808 -> j3207210803;
	j1998222029 [label="Именно об этом мне и хотелось с вами поговорить.",shape=box,color=red];
		j1998222029 -> j3207210803;
	j3207210803 [label="Я нашёл эти записи. Сначала они были разрозненными. Но когда я собрал их вместе, я... получил вот это сообщение.",shape=box,color=red];
		j3207210803 -> j3223819491;
	j3223819491 [label="Мне было интересно, покажется ли это тебе хоть сколько-нибудь осмысленным.",shape=box,color=red];
		j3223819491 -> j2111932407;
	j2111932407 [label="MomToxicated: Загадки и странные послания? Говоришь прям на нашем языке.",shape=box,color=blue];
		j2111932407 -> j2354010919;
	j2354010919 [label="PapaPolar: 8-800-шпионские-штучки, вы обратились по адресу",shape=box,color=blue];
		j2354010919 -> j2936933567;
	j2936933567 [label="\"Когда Сол и Луа объединятся, заблудшие найдут дорогу домой.\"",shape=box,color=red];
		j2936933567 -> j3470745557;
	j3470745557 [label="PapaPolar: ...чёрт. М. ЧЁРТ.",shape=box,color=blue];
		j3470745557 -> j3402583779;
	j3402583779 [label="MomToxicated: Не поддавайся. Если эта тварь влезла ей в голову, она знает всё, что знает она.",shape=box,color=blue];
		j3402583779 -> j150986838;
		j3402583779 -> j2232833030;
	j150986838 [label="Что? Что это значит?",shape=box,color=red];
		j150986838 -> j3461044273;
	j2232833030 [label="Это... вторая половина, да?",shape=box,color=red];
		j2232833030 -> j2936053660;
	j3461044273 [label="PapaPolar: \"На пустынных перекрестках ищи затмение.\"",shape=box,color=blue];
		j3461044273 -> j1888602531;
	j2936053660 [label="+5 Chemistry",color=orange];
		j2936053660 -> j3690398013;
	j1888602531 [label="PapaPolar: то, что я просил тебя сказать нашей малышке, если вдруг её увидишь.",shape=box,color=blue];
		j1888602531 -> j1043611177;
	j3690398013 [label="PapaPolar: правильно...",shape=box,color=blue];
		j3690398013 -> j3686623633;
	j1043611177 [label="PapaPolar: это был наш код. то, с чего мы начинали каждый звонок — чтоб знать, что линия чиста, что всё в порядке",shape=box,color=blue];
		j1043611177 -> j1075800693;
	j3686623633 [label="PapaPolar: у нас был код. мы начинали с него каждый звонок, чтоб быть уверенными, что всё безопасно",shape=box,color=blue];
		j3686623633 -> j1075800693;
	j1075800693 [label="MomToxicated: Что мы действительно... являемся собой.",shape=box,color=blue];
		j1075800693 -> j4194228648;
	j4194228648 [label="PapaPolar: \"На пустом перекрёстке ищи затмение\" — это была наша часть.",shape=box,color=blue];
		j4194228648 -> j1961768036;
	j1961768036 [label="MomToxicated: \"Когда Сол и Луа объединятся, заблудшие найдут дорогу домой\" — ответная половина.",shape=box,color=blue];
		j1961768036 -> j21734438;
	j21734438 [label="MomToxicated: *Её* половина.",shape=box,color=blue];
		j21734438 -> j2229890929;
		j21734438 -> j2672595715;
	j2229890929 [label="Но мы ведь не можем быть уверены, как ты сказала, Минерва. Безразличие знает, что она знает.",shape=box,color=red];
		j2229890929 -> j274775622;
	j2672595715 [label="Я не понимаю, зачем Безразличию говорить нам это...",shape=box,color=red];
		j2672595715 -> j2193356701;
	j274775622 [label="MomToxicated: Но зачем ему давать нам надежду? Разве чтобы сделать нам ещё больнее.",shape=box,color=blue];
		j274775622 -> j2130919965;
	j2193356701 [label="MomToxicated: Через ложную надежду? Чтобы ранить нас?",shape=box,color=blue];
		j2193356701 -> j109694128;
	j2130919965 [label="PapaPolar: а это больно?",shape=box,color=blue];
		j2130919965 -> j1217284524;
	j109694128 [label="PapaPolar: а это вообще ложь? это больно?",shape=box,color=blue];
		j109694128 -> j1217284524;
	j1217284524 [label="PapaPolar: или это, может, наоборот... какое-то утешение? знать, что наша малышка где-то там ещё жива?",shape=box,color=blue];
		j1217284524 -> j3167248685;
	j3167248685 [label="PapaPolar: что, несмотря ни на что, она всё ещё борется и делает себе имя?",shape=box,color=blue];
		j3167248685 -> j4000280194;
	j4000280194 [label="PapaPolar: пусть и не с нами?",shape=box,color=blue];
		j4000280194 -> j1396417947;
	j1396417947 [label="PapaPolar: это греет моё большое глупое сердце, не знаю, как вас.",shape=box,color=blue];
		j1396417947 -> j2664297388;
	j2664297388 [label="PapaPolar: и что-то подсказывает мне, что это не дело этого так называемого безразличия",shape=box,color=blue];
		j2664297388 -> j3872659422;
	j3872659422 [label="MomToxicated: Ты прав. Услышать эту фразу, подумать, что она *может* быть ещё там, не больно.",shape=box,color=blue];
		j3872659422 -> j1348965486;
	j1348965486 [label="MomToxicated: Я горжусь ею.",shape=box,color=blue];
		j1348965486 -> j1018791092;
		j1348965486 -> j1851921644;
		j1348965486 -> j1720241699;
	j1018791092 [label="Даже если она всё ещё в заложниках у Безразличия?",shape=box,color=red];
		j1018791092 -> j1043425202;
	j1851921644 [label="Даже если это уловка Безразличия?",shape=box,color=red];
		j1851921644 -> j2508719531;
	j1720241699 [label="Она могла бы добровольно работать с Безразличием.",shape=box,color=red];
		j1720241699 -> j407475454;
	j1043425202 [label="PapaPolar: она крепче, чем мешок гвоздей в глыбе титана",shape=box,color=blue];
		j1043425202 -> j1426768853;
	j2508719531 [label="MomToxicated: Почему? Ради чего? Что он может получить от нас двоих?",shape=box,color=blue];
		j2508719531 -> j2125549706;
	j407475454 [label="MomToxicated: Тогда у неё один из самых могущественных союзников во вселенной. В существовании. Она выбрала сторону. Мы тоже.",shape=box,color=blue];
		j407475454 -> j1172045332;
	j1426768853 [label="PapaPolar: и я готов поспорить, что твой \"человек в стене\" это знал и поэтому он забрал её",shape=box,color=blue];
		j1426768853 -> j3459864244;
	j2125549706 [label="PapaPolar: для него мы мелочь. и это, знаешь, в хорошем смысле",shape=box,color=blue];
		j2125549706 -> j4049956955;
	j1172045332 [label="MomToxicated: Будем надеяться, что нам не придётся наставлять друг на друга оружие. А если придётся? Тогда и разберёмся.",shape=box,color=blue];
		j1172045332 -> j4257028246;
	j3459864244 [label="PapaPolar: да ну. с ней всё будет в порядке. либо её уже давно нет там, либо у них сделка, либо она держит его в заложниках. хаха",shape=box,color=blue];
		j3459864244 -> j4049956955;
	j4049956955 [label="MomToxicated: Нет, я верю, что послание было настоящее. И я верю, что это была наша малышка. Она сказала нам... что она всё ещё там.",shape=box,color=blue];
		j4049956955 -> j2892897644;
	j4257028246 [label="PapaPolar: она сама о себе позаботится. мы её так воспитали",shape=box,color=blue];
		j4257028246 -> j4049956955;
	j2892897644 [label="MomToxicated: Сказала по-своему, что она \"в порядке\".",shape=box,color=blue];
		j2892897644 -> j3050581859;
	j3050581859 [label="MomToxicated: И что мы можем перестать за неё переживать.",shape=box,color=blue];
		j3050581859 -> j2524155139;
	j2524155139 [label="PapaPolar: хех. как будто мы когда-нибудь перестанем",shape=box,color=blue];
		j2524155139 -> j2315463457;
	j2315463457 [label="MomToxicated: Проклятье и благословение быть родителем.",shape=box,color=blue];
		j2315463457 -> j800356476;
	j800356476 [label="PapaPolar: хочешь детей, скиталец? эээ, не отвечай. вдруг там какая-то ерунда с Бездной, о которой я не хочу знать.",shape=box,color=blue];
		j800356476 -> j198640942;
		j800356476 -> j1261544195;
		j800356476 -> j4205962271;
	j198640942 [label="Выпить? Выпить.",shape=box,color=red];
		j198640942 -> j1418132967;
	j1261544195 [label="Хорошая мысль.",shape=box,color=red];
		j1261544195 -> j2656577717;
	j4205962271 [label="<RETRO_EMOJI_OHNO>",shape=box,color=red];
		j4205962271 -> j2430295558;
	j1418132967 [label="+5 Chemistry",color=orange];
		j1418132967 -> j2590113692;
	j2656577717 [label="PapaPolar: ну, это не счастливая-счастливая улыбка. это меланхолично-счастливая улыбка? но",shape=box,color=blue];
		j2656577717 -> j1671684826;
	j2430295558 [label="MomToxicated: Согласна. Очень даже подходящая реакция. Хех. Что скажете насчёт пары стаканчиков?",shape=box,color=blue];
		j2430295558 -> j354912628;
	j2590113692 [label="MomToxicated: Вот теперь ты говоришь на нашем языке.",shape=box,color=blue];
		j2590113692 -> j1671684826;
	j1671684826 [label="PapaPolar: я бы сейчас не отказался бахнуть пару рюмок и вспомнить лучшие истории о нашей малышке",shape=box,color=blue];
		j1671684826 -> j1726750114;
	j354912628 [label="PapaPolar: вот теперь ты заговорила по делу",shape=box,color=blue];
		j354912628 -> j1671684826;
	j1726750114 [label="MomToxicated: И... Скиталец? Спасибо. Ещё раз. За всё, что ты делаешь.",shape=box,color=blue];
		j1726750114 -> j1001916908;
	j1001916908 [label="PapaPolar: да, серьёзно, дружище. я не знаю, как мы когда-нибудь сможем тебя отблагодарить. но если выпадет шанс? мы будем рядом.",shape=box,color=blue];
		j1001916908 -> j2840615614;
	j2840615614 [label="PapaPolar: теперь ты семья. хочешь ты того или нет. 8-)",shape=box,color=blue];
		j2840615614 -> "Chat ends.";
}