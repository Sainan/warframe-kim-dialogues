	1513 [label="MomToxicated: Энтрати. В то время я думала, что это был «просто» местный наркобарон или лидер сопротивления.",shape=box,color=blue];
		1513 -> 1514;
	1514 [label="PapaPolar: мы даже не упомянули о долбаном монстре-тостере из сериала \"зомби\". казалось бы, об этом следовало бы говорить чаще.",shape=box,color=blue];
		1514 -> 1515;
	1515 [label="MomToxicated: Интересно, потеряла ли она руку к тому моменту? Полагаю, узнать невозможно.",shape=box,color=blue];
