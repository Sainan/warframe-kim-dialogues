	1506 [label="PapaPolar: но она казалась... напряженной. это было слышно.",shape=box,color=blue];
		1506 -> 1508;
		1506 -> 1509;
	1507 [label="MomToxicated: Или кто управлял ее телом, когда мы разговаривали с ней в тот день.",shape=box,color=blue];
