		1503 -> 1505;
	1504 [label="MomToxicated: Мы не были из Скальдры. Для людей на другом конце провода мы были просто штатскими. Так что она не стала бы передавать нам секретную информацию.",shape=box,color=blue];
		1504 -> 1506;
