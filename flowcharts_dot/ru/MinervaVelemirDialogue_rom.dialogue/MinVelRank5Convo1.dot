		j2692726627 -> j127656405;
	j2835170870 [label="MomToxicated: Все началось с бизнеса. Как она справлялась с управлением. Она, конечно, не смогла сообщить нам цифры или подробности.",shape=box,color=blue];
		j2835170870 -> j3177085393;
	j127656405 [label="MomToxicated: Но все хорошие захватчики заложников знают, как заставить своих пленных птиц петь по команде.",shape=box,color=blue];
		j127656405 -> j1996432617;
	j3177085393 [label="MomToxicated: Мы не были из Скальдры. Для людей на другом конце провода мы были просто штатскими. Так что она не стала бы передавать нам секретную информацию.",shape=box,color=blue];
		j3177085393 -> j2165618358;
