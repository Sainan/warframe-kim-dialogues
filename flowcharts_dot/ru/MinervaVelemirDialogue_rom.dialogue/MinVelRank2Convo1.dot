		j3107438700 -> j2228641523;
	j395033692 [label="Да, похоже, вы больше не вместе.",shape=box,color=red];
		j395033692 -> j2750542610;
	j3043397823 [label="PapaPolar: правда, у неё был маленький плюшевый кролик, за которого она цеплялась. Я сказал ей, что она будет защищать его ценой своей жизни и сохранит в целости.",shape=box,color=blue];
		j3043397823 -> j746661540;
	j1238395751 [label="Boolean MinervaVelimir1 is now true.",color=orange];
		j1238395751 -> j3398601084;
	j2228641523 [label="PapaPolar: когда нэси ушла, чтобы присоединиться к Скальдре... отношения между нами изменились. думаю, это стало последней каплей.",shape=box,color=blue];
		j2228641523 -> j3737184343;
	j2750542610 [label="PapaPolar: что выдало это.",shape=box,color=blue];
		j2750542610 -> j2228641523;
	j746661540 [label="PapaPolar: это очень быстро завоевало доверие нэси. подбежала к М и обняла ее. тогда мы ушли из армии. хорошо. официально. стали \"консультантами\".",shape=box,color=blue];
		j746661540 -> j4050784775;
	j3398601084 [label="PapaPolar: но сейчас это только на бумаге. и я полагаю, что, поскольку эта страна прекратила своё существование примерно в 1982 году, ты можешь решить, имеет ли это вообще значение",shape=box,color=blue];
		j3398601084 -> j3107438700;
		j3398601084 -> j395033692;
	j3737184343 [label="PapaPolar: она взглянула на Скальдру и назвала вещи своими именами. увидела, что это такое. опасный культ.",shape=box,color=blue];
		j3737184343 -> j4003526016;
	j4050784775 [label="PapaPolar: поэтому... мы воспитали ее как свою собственную. Думай о ней как о нашей дочери, даже если она ею не является.",shape=box,color=blue];
		j4050784775 -> j1212812148;
	j4003526016 [label="PapaPolar: и более того, что-то, из-за чего наша маленькая девочка могла погибнуть, но... я сказал, что она больше не ребенок. ",shape=box,color=blue];
		j4003526016 -> j1959648802;
	j1212812148 [label="PapaPolar: когда нэси сказала, что хочет присоединиться к какой-нибудь военной группировке наемников, и сказала, что они действительно во что-то верят? М сказала \"нет\".",shape=box,color=blue];
