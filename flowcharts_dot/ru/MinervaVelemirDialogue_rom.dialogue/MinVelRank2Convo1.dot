		j573255329 -> j2310208308;
	j2310208308 [label="PapaPolar: у меня скорость около восьми миллиардов миль в час, не волнуйся об этом, приятель",shape=box,color=blue];
		j2310208308 -> j2918188144;
	j2918188144 [label="PapaPolar: дерьмо. думаю, я выполнил примерно треть из них. и третья часть, которую я получил, была на треть лишней. тебя обнять, приятель?",shape=box,color=blue];
		j2918188144 -> j1742411930;
		j2918188144 -> j4125722827;
		j2918188144 -> j1753845221;
	j1742411930 [label="Я в порядке. Как ни странно, мне стало лучше с тех пор, как я приехала сюда.",shape=box,color=red];
		j1742411930 -> j1482441931;
	j4125722827 [label="Только не сломай мне хребет, когда будешь это делать, здоровяк.",shape=box,color=red];
		j4125722827 -> j2132747799;
	j1753845221 [label="Я никогда не откажусь от бесплатных объятий. ",shape=box,color=red];
		j1753845221 -> j1987793425;
	j1482441931 [label="PapaPolar: рад, что ты нашел что-то, что помогло заполнить пробелы. это больше, чем многие люди получают в жизни.",shape=box,color=blue];
		j1482441931 -> j989710963;
	j2132747799 [label="PapaPolar: ХА. бесплатный визит к мануальному терапевту, и теперь у меня есть встроенная услуга по наложению пакетов со льдом",shape=box,color=blue];
		j2132747799 -> j4007350778;
	j1987793425 [label="PapaPolar: повезло тебе. жизнь слишком коротка, чтобы отказываться от того, что делает ее лучше.",shape=box,color=blue];
		j1987793425 -> j4007350778;
	j989710963 [label="PapaPolar: дом - это не то место, где ты родился, это не те люди, которые тебя вырастили, это те места и люди, которые заставляют тебя чувствовать себя цельным.",shape=box,color=blue];
