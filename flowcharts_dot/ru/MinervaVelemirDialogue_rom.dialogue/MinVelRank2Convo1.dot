		j949266008 -> j675985519;
	j675985519 [label="PapaPolar: ... и я думаю, ты это прекрасно понимаешь...",shape=box,color=blue];
		j675985519 -> j2931477188;
	j2931477188 [label="PapaPolar: \"и он начинает тараторить мне что-то о каком-то альтернативном измерении, из которого ты родом??",shape=box,color=blue];
		j2931477188 -> j746340379;
