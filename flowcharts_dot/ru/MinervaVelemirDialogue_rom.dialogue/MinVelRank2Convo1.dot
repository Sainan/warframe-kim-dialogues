		j4163388303 -> j1261104763;
	j3268337705 [label="Да, похоже, вы больше не вместе.",shape=box,color=red];
		j3268337705 -> j1411034362;
	j1254945425 [label="PapaPolar: правда, у нее был маленький плюшевый кролик, за которого она цеплялась. Я сказал ей, что она будет защищать его ценой своей жизни и сохранит в целости.",shape=box,color=blue];
		j1254945425 -> j496712097;
	j262291180 [label="Boolean MinervaVelimir1 is now true.",color=orange];
		j262291180 -> j659819683;
	j1261104763 [label="PapaPolar: когда нэси ушла, чтобы присоединиться к Скальдре... отношения между нами изменились. думаю, это стало последней каплей.",shape=box,color=blue];
		j1261104763 -> j1707789560;
	j1411034362 [label="PapaPolar: что выдало это.",shape=box,color=blue];
		j1411034362 -> j1261104763;
	j496712097 [label="PapaPolar: это очень быстро завоевало доверие нэси. подбежала к М и обняла ее. тогда мы ушли из армии. хорошо. официально. стали \"консультантами\".",shape=box,color=blue];
		j496712097 -> j2032601243;
	j659819683 [label="PapaPolar: но сейчас это только на бумаге. и я полагаю, что, поскольку эта страна прекратила свое существование примерно в 1982 году, ты можешь решить, имеет ли это вообще значение",shape=box,color=blue];
		j659819683 -> j4163388303;
		j659819683 -> j3268337705;
	j1707789560 [label="PapaPolar: она взглянула на Скальдру и назвала вещи своими именами. увидела, что это такое. опасный. культ.",shape=box,color=blue];
		j1707789560 -> j4003526016;
	j2032601243 [label="PapaPolar: поэтому... мы воспитали ее как свою собственную. Думай о ней как о нашей дочери, даже если она ею не является.",shape=box,color=blue];
		j2032601243 -> j1835595414;
	j4003526016 [label="PapaPolar: и более того, что-то, из-за чего наша маленькая девочка могла погибнуть, но... я сказал, что она больше не ребенок. ",shape=box,color=blue];
		j4003526016 -> j1959648802;
	j1835595414 [label="PapaPolar: когда нэси сказала, что хочет присоединиться к какой-нибудь военной группировке наемников, и сказала, что они действительно во что-то верят? М сказала \"нет\".",shape=box,color=blue];
