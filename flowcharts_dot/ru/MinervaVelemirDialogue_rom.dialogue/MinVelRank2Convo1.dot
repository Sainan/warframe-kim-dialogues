	j207012418 [label="PapaPolar: хех, да. эй",shape=box,color=blue];
		j207012418 -> j949266008;
	j2967564526 [label="PapaPolar: ну, я чертовски уверен, что у меня нет кольта диснеевской принцессы, так что я не имею в виду это буквально, лол",shape=box,color=blue];
		j2967564526 -> j949266008;
