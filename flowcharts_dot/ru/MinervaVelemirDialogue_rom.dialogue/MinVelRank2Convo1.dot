		j627862165 -> j3268337705;
	j4083023407 [label="PapaPolar: она пыталась шесть раз пырнуть меня ложкой, бах-ха-ха, это самая милая штучка, которую ты когда-либо видел.",shape=box,color=blue];
		j4083023407 -> j1254945425;
