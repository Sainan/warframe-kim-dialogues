		j1270689117 -> j2637937671;
	j3713162856 [label="PapaPolar: однако у нее есть на то свои причины. доверься мне. я не облегчаю ей задачу.",shape=box,color=blue];
		j3713162856 -> j917679871;
	j3014302772 [label="PapaPolar: ммм. вроде как. мы были женаты, но уже не по-настоящему. только на бумаге. где-то. в какой-нибудь стране, которая прекратила свое существование примерно в 1982 году?",shape=box,color=blue];
		j3014302772 -> j627862165;
	j2637937671 [label="PapaPolar: мы были за границей, в маленьком городке в нескольких странах к югу отсюда. дом разнесло вдребезги. нашли там маленькую девочку. совсем крошечную, ростом по колено, рыжеволосую и взбешенную, как пчелиный улей. ",shape=box,color=blue];
