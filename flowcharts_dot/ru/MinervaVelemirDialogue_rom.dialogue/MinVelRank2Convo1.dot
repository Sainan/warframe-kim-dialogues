		j2280871997 -> j377241339;
	j377241339 [label="PapaPolar: ... и я думаю, ты это прекрасно понимаешь...",shape=box,color=blue];
		j377241339 -> j3444661215;
	j3444661215 [label="PapaPolar: и он начинает тараторить мне что-то о каком-то альтернативном измерении, из которого ты родом??",shape=box,color=blue];
		j3444661215 -> j746340379;
