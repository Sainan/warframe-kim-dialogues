		j627862165 -> j395033692;
	j375843643 [label="PapaPolar: она пыталась шесть раз пырнуть меня ложкой, бах-ха-ха, это самая милая штучка, которую ты когда-либо видел.",shape=box,color=blue];
		j375843643 -> j3043397823;
