		j3653584426 -> j1903225259;
	j1934050061 [label="MomToxicated: Нет ничего смешнее, чем маленькая 12-летняя девочка, которая подходит к стойке, щелкает зажигалкой по стойке и пристально смотрит на мужчину за стойкой.",shape=box,color=blue];
