digraph {
	0 [label="MinVelRank1Convo1 begins.",color=orange];
		0 -> 1;
	1 [label="MomToxicated: Что с ней случилось? Мне нужны ответы.",shape=box,color=blue];
		1 -> 2;
	2 [label="MomToxicated: Реальные ответы. И никакой этой ерунды типа \"это трудно объяснить\", которую несут мне другие.",shape=box,color=blue];
		2 -> 3;
		2 -> 4;
		2 -> 5;
		2 -> 6;
	3 [label="Лол.",shape=box,color=red];
		3 -> 7;
	4 [label="Привет?",shape=box,color=red];
		4 -> 7;
	5 [label="Эм.",shape=box,color=red];
		5 -> 7;
	6 [label="И это...?",shape=box,color=red];
		6 -> 7;
	7 [label="PapaPolar: нет причин так себя вести. начни с \"привет, как дела?\"",shape=box,color=blue];
		7 -> 8;
	8 [label="PapaPolar: извини, приятель. когда М видит цель в поле зрения, главное - двигаться, двигаться, двигаться.",shape=box,color=blue];
		8 -> 9;
	9 [label="MomToxicated: И мне не нужно, чтобы ТЫ меня подначивал.",shape=box,color=blue];
		9 -> 10;
	10 [label="PapaPolar: я не?",shape=box,color=blue];
		10 -> 11;
	11 [label="MomToxicated: Ха. Да. Точно. Как будто ты не подрезал меня в Ялческо.",shape=box,color=blue];
		11 -> 12;
		11 -> 13;
	12 [label="Минерва и Велимир, я полагаю?",shape=box,color=red];
		12 -> 14;
	13 [label="Хорошо... Мы можем вернуться, пожалуйста? Что происходит?",shape=box,color=red];
		13 -> 15;
	14 [label="PapaPolar: да. извини. привет. наверное, обо мне было легко догадаться, да? лол",shape=box,color=blue];
		14 -> 16;
	15 [label="PapaPolar: ха! извини, приятель. велимир. и MomToxicated здесь - Минерва.",shape=box,color=blue];
		15 -> 17;
	16 [label="PapaPolar: MomToxicated здесь - Минерва.",shape=box,color=blue];
		16 -> 17;
	17 [label="MomToxicated: ВЕЛИМИР. Какой СМЫСЛ использовать этот ресурс, если ТЫ ПРОСТО - ",shape=box,color=blue];
		17 -> 18;
	18 [label="MomToxicated: ЧЕРТ ВОЗЬМИ.",shape=box,color=blue];
		18 -> 19;
	19 [label="PapaPolar: М, будь благоразумна. процесс исключения. сколько нас, фриков, может быть разумных в этой системе?",shape=box,color=blue];
		19 -> 20;
		19 -> 21;
		19 -> 22;
	20 [label="У меня такое чувство, что с течением времени их будет становиться все больше и больше.",shape=box,color=red];
		20 -> 23;
	21 [label="Не могли бы вы двое разобраться в том, что происходит, а потом прийти и поговорить со мной?",shape=box,color=red];
		21 -> 24;
	22 [label="Я в полном замешательстве.",shape=box,color=red];
		22 -> 25;
	23 [label="Update boolean VelimirFamily1",color=orange];
		23 -> 26;
	24 [label="PapaPolar: боюсь, тогда тебе придется долго ждать, приятель. ха.",shape=box,color=blue];
		24 -> 27;
	25 [label="PapaPolar: что ж, если *ты* в замешательстве, то нам всем крышка. ха!",shape=box,color=blue];
		25 -> 28;
	26 [label="+5 Chemistry",color=orange];
		26 -> 29;
	27 [label="PapaPolar: вот вкратце. У М есть вопросы, на которые она хочет получить ответы, и я хочу, чтобы ты на них ответил.",shape=box,color=blue];
		27 -> 30;
	28 [label="PapaPolar: поскольку именно к тебе мы пришли за ответами.",shape=box,color=blue];
		28 -> 30;
	29 [label="PapaPolar: я, например, надеюсь на это! чем больше людей, тем веселее, говорю я. как гласит старая пословица, единственная разница между культом и религией - это цифры, ха-ха.",shape=box,color=blue];
		29 -> 31;
	30 [label="PapaPolar: ну. так лучше, М? это больше соответствует твоему плану игры \"хороший полицейский / плохой полицейский\"?",shape=box,color=blue];
		30 -> 32;
	31 [label="PapaPolar: это поговорка? ",shape=box,color=blue];
		31 -> 33;
	32 [label="MomToxicated: Сол наверху, я сейчас закричу...",shape=box,color=blue];
		32 -> 34;
		32 -> 35;
		32 -> 36;
	33 [label="PapaPolar: я не знаю. ты понял, к чему я клоню. вода замечательная, все внутри, насколько я могу судить! ну, в общем.",shape=box,color=blue];
		33 -> 27;
	34 [label="Почему у меня такое чувство, что меня допрашивают?",shape=box,color=red];
		34 -> 37;
	35 [label="Ну... э-э... Я бы предпочел, чтобы вы не пытались \"играть\" в беседу со мной.",shape=box,color=red];
		35 -> 38;
	36 [label="Какие у вас вопросы? Помогу, если смогу.",shape=box,color=red];
		36 -> 39;
	37 [label="MomToxicated: Ни слова, Велимир.",shape=box,color=blue];
		37 -> 40;
	38 [label="MomToxicated: Это что угодно, только не игра.",shape=box,color=blue];
		38 -> 41;
	39 [label="MomToxicated: Твое сотрудничество было отмечено, «Скиталец».",shape=box,color=blue];
		39 -> 42;
	40 [label="PapaPolar: :-Х",shape=box,color=blue];
		40 -> 43;
	41 [label="MomToxicated: Ты собираешься отвечать на мои вопросы? Да или нет?",shape=box,color=blue];
		41 -> 44;
		41 -> 45;
	42 [label="MomToxicated: Если это твое настоящее имя.",shape=box,color=blue];
		42 -> 46;
	43 [label="MomToxicated: Например, иметь дело с... чем угодно. Что угодно. Это не имеет значения.",shape=box,color=blue];
		43 -> 41;
	44 [label="Нет, извини. Мне не нравится твое отношение, леди.",shape=box,color=red];
		44 -> 47;
	45 [label="Ладно, хорошо. Что это?",shape=box,color=red];
		45 -> 39;
	46 [label="PapaPolar: (я не думаю, что мы можем судить об этом.)",shape=box,color=blue];
		46 -> 48;
	47 [label="MomToxicated: Это ошибка. Я дам тебе немного времени, чтобы все обдумать и пересмотреть.",shape=box,color=blue];
		47 -> 49;
	48 [label="MomToxicated: ВЕЛИМИР",shape=box,color=blue];
		48 -> 50;
	49 [label="+20 Chemistry",color=orange];
