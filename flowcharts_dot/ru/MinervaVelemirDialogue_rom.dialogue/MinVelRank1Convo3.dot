		197 -> 198;
	198 [label="MomToxicated: Тебе не обязательно хотеть помочь мне ради меня самой. У нас общий враг. Этот \"Человек в стене\".",shape=box,color=blue];
		198 -> 199;
	199 [label="MomToxicated: Насколько я понимаю, нам обоим интересно, куда он делся, что ему нужно и почему он в первую очередь нацелился на Русалку.",shape=box,color=blue];
