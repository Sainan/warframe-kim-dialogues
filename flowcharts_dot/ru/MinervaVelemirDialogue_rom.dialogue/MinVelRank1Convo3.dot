		191 -> 192;
	192 [label="MomToxicated: Мы здесь, в Хельвании, и нам нужно решить проблему. И ты можешь помочь мне решить эту проблему.",shape=box,color=blue];
		192 -> 193;
	193 [label="MomToxicated: Так что мне нужна твоя помощь - и я прошу тебя об этом.",shape=box,color=blue];
		193 -> 194;
		193 -> 195;
		193 -> 196;
