		201 -> 204;
	202 [label="Для первых двух - да. На самом деле мне глубоко наплевать, почему он пошел за Русалкой.",shape=box,color=red];
		202 -> 205;
	203 [label="Конечно. Да. Это верно.",shape=box,color=red];
