		j3117138238 -> j220470340;
		j3117138238 -> j1616967862;
	j1342652445 [label="Доброе утро, Минерва. Если это твое настоящее имя.",shape=box,color=red];
		j1342652445 -> j443423870;
	j2386740303 [label="Я вижу, мы опустили \"кавычки\".",shape=box,color=red];
		j2386740303 -> j3087549901;
	j220470340 [label="Теперь ты спрашиваешь?",shape=box,color=red];
		j220470340 -> j3087549901;
	j1616967862 [label="Серьёзно?",shape=box,color=red];
		j1616967862 -> j141802650;
	j443423870 [label="+5 Chemistry",color=orange];
		j443423870 -> j3914318377;
	j3087549901 [label="MomToxicated: Мне прочитали лекцию о моем так называемом врачебном такте.",shape=box,color=blue];
		j3087549901 -> j1421805891;
	j141802650 [label="+5 Chemistry",color=orange];
		j141802650 -> j2255746141;
	j3914318377 [label="MomToxicated: Веришь или нет, но это так.",shape=box,color=blue];
		j3914318377 -> j1026866957;
	j1421805891 [label="MomToxicated: Что, учитывая все обстоятельства, является истерикой.",shape=box,color=blue];
		j1421805891 -> j1804741829;
	j2255746141 [label="MomToxicated: Сразу к делу. Хорошо.",shape=box,color=blue];
		j2255746141 -> j1804741829;
	j1026866957 [label="MomToxicated: Но дело не в этом.",shape=box,color=blue];
		j1026866957 -> j1804741829;
	j1804741829 [label="MomToxicated: Мы здесь, в Хельвании, и нам нужно решить проблему. И ты можешь помочь мне решить эту проблему.",shape=box,color=blue];
		j1804741829 -> j4154835120;
	j4154835120 [label="MomToxicated: Так что мне нужна твоя помощь - и я прошу тебя об этом.",shape=box,color=blue];
		j4154835120 -> j2390608034;
		j4154835120 -> j909640001;
		j4154835120 -> j33046278;
	j2390608034 [label="Какую проблему я должен решить?",shape=box,color=red];
		j2390608034 -> j3124730757;
	j909640001 [label="Почему я должен помочь тебе?",shape=box,color=red];
		j909640001 -> j3124730757;
	j33046278 [label="И какое отношение это имеет к Русалке?",shape=box,color=red];
		j33046278 -> j3124730757;
	j3124730757 [label="MomToxicated: Это очень хороший вопрос.",shape=box,color=blue];
		j3124730757 -> j2614124625;
	j2614124625 [label="MomToxicated: Тебе не обязательно хотеть помочь мне ради меня самой. У нас общий враг. Этот \"Человек в стене\".",shape=box,color=blue];
		j2614124625 -> j2268085300;
	j2268085300 [label="MomToxicated: Насколько я понимаю, нам обоим интересно, куда он делся, что ему нужно и почему он в первую очередь нацелился на Русалку.",shape=box,color=blue];
		j2268085300 -> j3534326242;
	j3534326242 [label="MomToxicated: Права ли я в своей оценке?",shape=box,color=blue];
		j3534326242 -> j2766176005;
		j3534326242 -> j1934759816;
		j3534326242 -> j613144581;
	j2766176005 [label="Не могла бы ты отойти на минутку и объяснить мне, почему ты так беспокоишься о Русалке?",shape=box,color=red];
		j2766176005 -> j3345353074;
	j1934759816 [label="Для первых двух - да. На самом деле мне глубоко наплевать, почему он пошел за Русалкой.",shape=box,color=red];
		j1934759816 -> j3783224891;
	j613144581 [label="Конечно. Да. Это верно.",shape=box,color=red];
		j613144581 -> j2902556787;
	j3345353074 [label="MomToxicated: \"Почему\" не имеет значения.",shape=box,color=blue];
		j3345353074 -> j3565279164;
	j3783224891 [label="MomToxicated: Если ты, по крайней мере, не заинтересован в ее благополучии, зачем сохранять ей жизнь, как, мы знаем, это сделал ты? Мы слышали эту историю.",shape=box,color=blue];
		j3783224891 -> j2417023089;
		j3783224891 -> j1924347859;
		j3783224891 -> j2889202372;
	j2902556787 [label="Мне неприятно огорчать тебя, но мы, вероятно, застряли в ожидании, пока Человек в стене сделает свой следующий шаг.",shape=box,color=red];
		j2902556787 -> j425727425;
	j3565279164 [label="PapaPolar: тем не менее, это так. и они, вероятно, уже поняли это, в любом случае. не то чтобы мы были такими уж утонченными",shape=box,color=blue];
		j3565279164 -> j2185093587;
	j2417023089 [label="Потому что тогда я бы ничем не отличался от Безразличия. От Скальдры. От Энтрати. Я не хожу вокруг да около и бессмысленно убиваю людей.",shape=box,color=red];
		j2417023089 -> j3564807505;
	j1924347859 [label="Потому что на самом деле не она принимала решения, которые привели ее к этому моменту. То, что я не убил бы ее за это в тот момент, не значит, что мне не все равно, чтобы изо всех сил пытаться спасти ее.",shape=box,color=red];
		j1924347859 -> j2953508655;
	j2889202372 [label="Потому что я не собирался делать грязную работу за Энтрати. Если бы он хотел убить новую марионетку Безразличия, он мог бы сделать это сам.",shape=box,color=red];
		j2889202372 -> j2452190749;
	j425727425 [label="MomToxicated: И почему это так? У тебя нет возможности отследить его? Это? Что бы это ни было? Или ты не знаешь, за чем оно на самом деле охотится?",shape=box,color=blue];
		j425727425 -> j2093451048;
		j425727425 -> j1252614840;
	j2185093587 [label="PapaPolar: и, может быть, *только может быть*, если бы ты доверила нашему новому приятелю немного информации, они, возможно, были бы более готовы * помочь вам*",shape=box,color=blue];
		j2185093587 -> j2297477400;
	j3564807505 [label="Что подразумевает, что я целенаправленно убиваю людей. Чего я не делаю. Я имею в виду. Я действительно убиваю людей. Но это другое. Вы понимаете, что я имею в виду.",shape=box,color=red];
		j3564807505 -> j2999865192;
	j2953508655 [label="Я ее не *знал*.",shape=box,color=red];
		j2953508655 -> j1379591353;
	j2452190749 [label="Но, как я и подозревал, старому ублюдку нравится стрелять только в тех, кто, как он знает, встанет на ноги.",shape=box,color=red];
		j2452190749 -> j4266546217;
	j2093451048 [label="Точно не могу прикрепить маячок слежения к полубогу-божеству-существу, нет.",shape=box,color=red];
		j2093451048 -> j4060107456;
	j1252614840 [label="Да, в данный момент мы немного не понимаем его мотивов. Но ничего хорошего в этом нет.",shape=box,color=red];
		j1252614840 -> j4060107456;
	j2297477400 [label="PapaPolar: иногда кажется, что люди именно так и работают. ",shape=box,color=blue];
		j2297477400 -> j2984228427;
	j2999865192 [label="+5 Chemistry",color=orange];
		j2999865192 -> j73412173;
	j1379591353 [label="PapaPolar: и мы не даем тебе повода для беспокойства. не так ли, М?",shape=box,color=blue];
		j1379591353 -> j3399967450;
	j4266546217 [label="PapaPolar: очень странное заявление, но ладно",shape=box,color=blue];
		j4266546217 -> j3459895195;
		j4266546217 -> j2578504621;
	j4060107456 [label="MomToxicated: Итак, ты предлагаешь нам сесть. И ждать. Пока это произойдет... что. Поднимет голову? И мы сыграем в \"Бей хорька\"?!",shape=box,color=blue];
		j4060107456 -> j1769051081;
	j2984228427 [label="MomToxicated: Какая от этого польза?",shape=box,color=blue];
		j2984228427 -> j2072246252;
	j73412173 [label="PapaPolar: ты разговариваешь с парой бывших военных спецназовцев, мы поняли. лол",shape=box,color=blue];
		j73412173 -> j1364738861;
	j3399967450 [label="MomToxicated: Заткнись, Велимир.",shape=box,color=blue];
		j3399967450 -> j3345353074;
	j3459895195 [label="Все в порядке. Я часто умираю. Я к этому привык.",shape=box,color=red];
		j3459895195 -> j3837089597;
	j2578504621 [label="На самом деле это не имеет значения.",shape=box,color=red];
		j2578504621 -> j2902556787;
		j2578504621 -> j580908712;
	j1769051081 [label="PapaPolar: по крайней мере, здесь хорошая компания и хороший бар?",shape=box,color=blue];
		j1769051081 -> j2739079128;
	j2072246252 [label="PapaPolar: в этом мире нет ничего плохого в том, чтобы иметь друзей, М.",shape=box,color=blue];
		j2072246252 -> j106236155;
	j1364738861 [label="PapaPolar: то, что мы должны делать во имя \"общего блага\", иногда становится размытым",shape=box,color=blue];
		j1364738861 -> j3267732909;
	j3837089597 [label="PapaPolar: ооки-доки... конечно, дружище... конечно...",shape=box,color=blue];
		j3837089597 -> j1056793028;
	j580908712 [label="Почему ты так отчаянно хочешь узнать, что случилось с Русалкой?",shape=box,color=red];
		j580908712 -> j3345353074;
	j2739079128 [label="PapaPolar: музыка довольно хорошая. этот парень, артур, кажется, мой собутыльник",shape=box,color=blue];
		j2739079128 -> j1713091364;
	j106236155 [label="MomToxicated: Зачем нам нужны \"друзья\"?! Мы уйдем отсюда, как только узнаем, где нам нужно быть, чтобы спасти Нэси.",shape=box,color=blue];
		j106236155 -> j3538998315;
	j3267732909 [label="PapaPolar: вот почему, когда мы можем сделать что-то важное, мы это делаем. вот почему мы здесь, пытаемся спасти нэси",shape=box,color=blue];
		j3267732909 -> j2902556787;
		j3267732909 -> j580908712;
	j1056793028 [label="PapaPolar: короче...",shape=box,color=blue];
		j1056793028 -> j2902556787;
		j1056793028 -> j580908712;
	j1713091364 [label="MomToxicated: И что, мы так и будем жить, не зная, что с ней на самом деле случилось?! И все ли с ней в порядке?! И действительно ли она теперь это она?!",shape=box,color=blue];
		j1713091364 -> j4203064227;
	j3538998315 [label="PapaPolar: не знаю, как насчет этого. похоже, будет сложно предугадать передвижения полубога-монстра из бездны... вот так штука. амирит, дружище?",shape=box,color=blue];
		j3538998315 -> j1252614840;
		j3538998315 -> j2093451048;
	j4203064227 [label="MomToxicated: Как ты можешь сидеть здесь и мириться с этим, Велимир?!",shape=box,color=blue];
		j4203064227 -> j2311656715;
	j2311656715 [label="PapaPolar: я никогда не говорил, что меня это устраивает, М! я просто понимаю, когда нам приходится сидеть и ждать своего часа!",shape=box,color=blue];
		j2311656715 -> j3255332354;
	j3255332354 [label="MomToxicated: Я поговорила с Элеонор. Она рассказала мне, что почувствовала, когда прикоснулась к разуму Нэси. Или к тому, что от нее осталось.",shape=box,color=blue];
		j3255332354 -> j1967017679;
	j1967017679 [label="MomToxicated: Женщина, которую мы вырастили. Женщина, которую мы любили как свою собственную.",shape=box,color=blue];
		j1967017679 -> j1246395180;
	j1246395180 [label="MomToxicated: Кто знает, что именно - ",shape=box,color=blue];
		j1246395180 -> j1741366456;
	j1741366456 [label="MomToxicated: И ты хочешь поговорить о выпивке с Артуром.",shape=box,color=blue];
		j1741366456 -> j4192311546;
	j4192311546 [label="MomToxicated: Иди к черту, Велимир.",shape=box,color=blue];
		j4192311546 -> j1687234117;
	j1687234117 [label="PapaPolar: а-а-а, и она уходит...",shape=box,color=blue];
		j1687234117 -> j2825172274;
		j1687234117 -> j1810700546;
	j2825172274 [label="Что она сказала...?",shape=box,color=red];
		j2825172274 -> j1775294889;
	j1810700546 [label="Наверное, это было грубое выражение.",shape=box,color=red];
		j1810700546 -> j61029646;
	j1775294889 [label="PapaPolar: радость от участия в стольких зарубежных операциях. выслушивать ругательства на 100 разных языках",shape=box,color=blue];
		j1775294889 -> j3710313934;
		j1775294889 -> j1952648828;
	j61029646 [label="PapaPolar: да. радость от участия в стольких зарубежных операциях. выслушивать ругательства на 100 разных языках",shape=box,color=blue];
		j61029646 -> j3710313934;
		j61029646 -> j1952648828;
	j3710313934 [label="Вы двое... женаты?",shape=box,color=red];
		j3710313934 -> j3857344219;
