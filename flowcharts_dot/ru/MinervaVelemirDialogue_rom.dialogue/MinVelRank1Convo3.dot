		j1952648828 -> j3096872548;
	j3857344219 [label="Boolean MinervaVelimir1 is now true.",color=orange];
		j3857344219 -> j1330093734;
	j3096872548 [label="Boolean MinervaNeci3a is now true.",color=orange];
		j3096872548 -> j3425971681;
	j1330093734 [label="PapaPolar: ммм. вроде того. на самом деле уже нет. только на бумаге. где-то. в какой-нибудь стране, которая прекратила свое существование примерно в 1982 году?",shape=box,color=blue];
		j1330093734 -> j4101025697;
	j3425971681 [label="PapaPolar: более или менее. мы были за границей, в маленьком городке в нескольких странах к югу отсюда. дом разнесло на куски. нашли ее там, в здании, рыжеволосую и очень злууую.",shape=box,color=blue];
		j3425971681 -> j1594407334;
	j4101025697 [label="PapaPolar: это считается?",shape=box,color=blue];
		j4101025697 -> j1715078279;
		j4101025697 -> j2307886026;
	j1594407334 [label="PapaPolar: она пыталась шесть раз пырнуть меня ложкой, бах-ха-ха, это самая милая штучка, которую ты когда-либо видел.",shape=box,color=blue];
		j1594407334 -> j1399887874;
	j1715078279 [label="Да, похоже, вы больше не вместе.",shape=box,color=red];
		j1715078279 -> j146632647;
	j2307886026 [label="Думаю, это объясняет споры.",shape=box,color=red];
		j2307886026 -> j700280985;
	j1399887874 [label="PapaPolar: правда, у нее был маленький плюшевый кролик, за которого она цеплялась. Я сказал ей, что она будет защищать его ценой своей жизни и сохранит в целости.",shape=box,color=blue];
		j1399887874 -> j887764113;
	j146632647 [label="PapaPolar: что выдало это.",shape=box,color=blue];
		j146632647 -> j700280985;
	j700280985 [label="PapaPolar: когда нэси ушла, чтобы присоединиться к Скальдре... отношения между нами изменились. думаю, это стало последней каплей.",shape=box,color=blue];
		j700280985 -> j4264029040;
	j887764113 [label="PapaPolar: это очень быстро завоевало доверие нэси. подбежала к М и обняла ее. тогда мы ушли из армии. хорошо. официально. стали \"консультантами\".",shape=box,color=blue];
		j887764113 -> j2321862864;
	j4264029040 [label="PapaPolar: эх.",shape=box,color=blue];
		j4264029040 -> j1290981131;
	j2321862864 [label="PapaPolar: так что... да. можно сказать, мы ее вырастили.",shape=box,color=blue];
		j2321862864 -> j1290981131;
	j1290981131 [label="PapaPolar: ладно, мне пора делать то, что у меня получается лучше всего.",shape=box,color=blue];
		j1290981131 -> j2185255394;
	j2185255394 [label="PapaPolar: притвориться, что я знаю, что сказал что-то не так, и притвориться, что я больше не ошибусь в будущем.",shape=box,color=blue];
		j2185255394 -> j2017522426;
