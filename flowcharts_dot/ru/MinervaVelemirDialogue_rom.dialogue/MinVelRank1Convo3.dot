	221 [label="PapaPolar: очень странное заявление, но ладно",shape=box,color=blue];
		221 -> 226;
		221 -> 227;
	222 [label="MomToxicated: Итак, ты предлагаешь нам сесть. И ждать. Пока это произойдет... что. Поднимет голову? И мы сыграем в \"Бей хорька\"?!",shape=box,color=blue];
