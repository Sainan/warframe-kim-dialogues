		204 -> 207;
	205 [label="MomToxicated: Если ты, по крайней мере, не заинтересован в ее благополучии, зачем сохранять ей жизнь, как, мы знаем, это сделал ты? Мы слышали эту историю.",shape=box,color=blue];
		205 -> 208;
		205 -> 209;
		205 -> 210;
	206 [label="Мне неприятно огорчать тебя, но мы, вероятно, застряли в ожидании, пока Человек в стене сделает свой следующий шаг.",shape=box,color=red];
		206 -> 211;
	207 [label="PapaPolar: тем не менее, это так. и они, вероятно, уже поняли это, в любом случае. не то чтобы мы были такими уж утонченными",shape=box,color=blue];
		207 -> 212;
	208 [label="Потому что тогда я бы ничем не отличался от Безразличия. От Скальдры. От Энтрати. Я не хожу вокруг да около и бессмысленно убиваю людей.",shape=box,color=red];
		208 -> 213;
	209 [label="Потому что на самом деле не она принимала решения, которые привели ее к этому моменту. То, что я не убил бы ее за это в тот момент, не значит, что мне не все равно, чтобы изо всех сил пытаться спасти ее.",shape=box,color=red];
		209 -> 214;
	210 [label="Потому что я не собирался делать грязную работу за Энтрати. Если бы он хотел убить новую марионетку Безразличия, он мог бы сделать это сам.",shape=box,color=red];
		210 -> 215;
	211 [label="MomToxicated: И почему это так? У тебя нет возможности отследить его? Это? Что бы это ни было? Или ты не знаешь, за чем оно на самом деле охотится?",shape=box,color=blue];
		211 -> 216;
		211 -> 217;
	212 [label="PapaPolar: и, может быть, *только может быть*, если бы ты доверила нашему новому приятелю немного информации, они, возможно, были бы более готовы * помочь вам*",shape=box,color=blue];
		212 -> 218;
	213 [label="Что подразумевает, что я целенаправленно убиваю людей. Чего я не делаю. Я имею в виду. Я действительно убиваю людей. Но это другое. Вы понимаете, что я имею в виду.",shape=box,color=red];
		213 -> 219;
	214 [label="Я ее не *знал*.",shape=box,color=red];
		214 -> 220;
	215 [label="Но, как я и подозревал, старому ублюдку нравится стрелять только в тех, кто, как он знает, встанет на ноги.",shape=box,color=red];
		215 -> 221;
	216 [label="Точно не могу прикрепить маячок слежения к полубогу-божеству-существу, нет.",shape=box,color=red];
		216 -> 222;
	217 [label="Да, в данный момент мы немного не понимаем его мотивов. Но ничего хорошего в этом нет.",shape=box,color=red];
