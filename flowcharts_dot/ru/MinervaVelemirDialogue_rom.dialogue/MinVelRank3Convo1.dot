		j1297307754 -> j2593556263 [label=false,color=brown];
	j875334486 [label="Привет, Велимир. Могу я спросить *тебя*, как вы с Минервой познакомились?",shape=box,color=red];
		j875334486 -> j2377130707;
	j2593556263 [label="Как вы двое вообще познакомились?",shape=box,color=red];
		j2593556263 -> j2966326053;
	j2377130707 [label="Я спрашивал Минерву, но... знаешь...",shape=box,color=red];
		j2377130707 -> j2966326053;
	j2966326053 [label="PapaPolar: ну, ничего себе, там мы и были.",shape=box,color=blue];
		j2966326053 -> j1028592607;
	j1028592607 [label="PapaPolar: как вдруг в бар заходит [УДАЛЕНО]. они вытаскивают это СОВЕРШЕННО НЕВЕРОЯТНОЕ, я имею в виду, серьезно, ты должен был это увидеть, это было ОГРОМНОЕ [УДАЛЕНО]",shape=box,color=blue];
		j1028592607 -> j1460546979;
	j1460546979 [label="PapaPolar: и я такой: \"УБИРАЙСЯ ОТТУДА, ПОКА [УДАЛЕНО] НЕ СТАЛО [УДАЛЕНО]\"!!!",shape=box,color=blue];
		j1460546979 -> j3317830021;
	j3317830021 [label="PapaPolar: [УДАЛЕНО] просто лезет вверх. Я имею в виду, полностью вбок. [УДАЛЕНО] везде... просто [УДАЛЕНО]...",shape=box,color=blue];
		j3317830021 -> j901954557;
	j901954557 [label="PapaPolar: наши глаза встретились через [УДАЛЕНО] и это было все. я был обречен",shape=box,color=blue];
		j901954557 -> j3970028924;
		j901954557 -> j3431501894;
	j3970028924 [label="Ты можешь пойти [УДАЛЕНО] сам.",shape=box,color=red];
		j3970028924 -> j790384589;
	j3431501894 [label="... Ты издеваешься надо мной, да?",shape=box,color=red];
		j3431501894 -> j2301412990;
	j790384589 [label="PapaPolar: ЛОЛ",shape=box,color=blue];
		j790384589 -> j4086402370;
	j2301412990 [label="Check boolean MinervaVelimir2",color=orange];
		j2301412990 -> j111444806 [label=true,color=green];
		j2301412990 -> j1237119752 [label=false,color=brown];
	j4086402370 [label="+5 Chemistry",color=orange];
		j4086402370 -> j2127725677;
	j111444806 [label="PapaPolar: извини, после того, как М рассказала тебе о \"секретной\" ерунде, я просто не смог удержаться. лол",shape=box,color=blue];
		j111444806 -> j1995111503;
	j1237119752 [label="PapaPolar: не смог удержаться, извини. лол",shape=box,color=blue];
		j1237119752 -> j1995111503;
	j2127725677 [label="PapaPolar: чудно.",shape=box,color=blue];
		j2127725677 -> j2301412990;
	j1995111503 [label="PapaPolar: правдивая история очень скучна. мы познакомились на конференции.",shape=box,color=blue];
		j1995111503 -> j3931664543;
	j3931664543 [label="MomToxicated: Если ты собираешься просто сидеть и *снова* разглашать секретную информацию, Велимир, то, по крайней мере, не говори, где именно, пожалуйста?",shape=box,color=blue];
		j3931664543 -> j1054851928;
	j1054851928 [label="MomToxicated: Учитывая, что цель конференции заключалась не в том, чтобы делать именно это, и ты бы выдал местонахождение тех, кто присутствовал на ней.",shape=box,color=blue];
		j1054851928 -> j264783129;
	j264783129 [label="PapaPolar: да, да. в любом случае, это не имеет особого значения для истории.",shape=box,color=blue];
		j264783129 -> j2939204295;
		j264783129 -> j4035627325;
	j2939204295 [label="Что это за конференция?",shape=box,color=red];
		j2939204295 -> j449710652;
	j4035627325 [label="Подождите, подождите, подождите, подождите, подождите. У них проводятся конференции для международных шпионов, занимающихся секретными операциями?!",shape=box,color=red];
		j4035627325 -> j4135635360;
	j449710652 [label="PapaPolar: если я скажу, мне придётся убить тебя. B-)",shape=box,color=blue];
		j449710652 -> j3237298155;
	j4135635360 [label="MomToxicated: В каждой отрасли есть конференции... к лучшему это или к худшему. И все они одинаково скучны, независимо от сферы деятельности.",shape=box,color=blue];
		j4135635360 -> j175657948;
	j3237298155 [label="MomToxicated: Что ж, поскольку Велимир уже нарушил протокол, можно с таким же успехом разрушить и все остальное. \"Международная ассоциация межкультурного лидерства и консалтинга\".",shape=box,color=blue];
		j3237298155 -> j2873607969;
	j175657948 [label="MomToxicated: Что ж, поскольку Велимир уже нарушил протокол, можно с таким же успехом разрушить и все остальное. \"Международная ассоциация межкультурного лидерства и консалтинга\".",shape=box,color=blue];
		j175657948 -> j3954238668;
	j2873607969 [label="PapaPolar: это значит «шпионы». это шпионская конференция. и это чертовски скучно.",shape=box,color=blue];
		j2873607969 -> j3939535374;
	j3954238668 [label="PapaPolar: и, как сказала М., это чертовски скучно.",shape=box,color=blue];
		j3954238668 -> j3939535374;
	j3939535374 [label="PapaPolar: и никто в баре не мог приготовить что-нибудь старомодное. я не знаю, в чем, черт возьми, была их проблема.",shape=box,color=blue];
		j3939535374 -> j1426829659;
	j1426829659 [label="PapaPolar: поэтому я заплатил парню, чтобы он позволил мне вернуться и приготовить его самому.",shape=box,color=blue];
		j1426829659 -> j3002781466;
	j3002781466 [label="PapaPolar: вот я, смешиваю себе действительно ХОРОШИЙ старомодный коктейль — серьёзно, кто, черт возьми, кладёт лёд в старомодный коктейль, что, черт возьми, с тобой не так...",shape=box,color=blue];
		j3002781466 -> j289897219;
	j289897219 [label="PapaPolar: ты используешь один большой куб или шар льда. вы, идиоты, хотите, чтобы он таял медленно",shape=box,color=blue];
		j289897219 -> j3292325442;
		j289897219 -> j1929841629;
	j3292325442 [label="Фокус.",shape=box,color=red];
		j3292325442 -> j1306973001;
	j1929841629 [label="Принято.",shape=box,color=red];
		j1929841629 -> j3994321767;
	j1306973001 [label="PapaPolar: да, да, так что, в любом случае, черт возьми, я был там, приводил себя в надлежащий старомодный вид, когда услышал самый потрясающий страстный голос",shape=box,color=blue];
		j1306973001 -> j4139110424;
	j3994321767 [label="PapaPolar: так что, черт возьми, я был там, приводя себя в надлежащий старомодный вид, когда услышал самый потрясающий страстный голос",shape=box,color=blue];
		j3994321767 -> j4139110424;
