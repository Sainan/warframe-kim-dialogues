		j4139110424 -> j3030341866;
	j3030341866 [label="PapaPolar: я смотрю вверх",shape=box,color=blue];
		j3030341866 -> j3472227351;
	j3472227351 [label="PapaPolar: хннннггхххх",shape=box,color=blue];
		j3472227351 -> j4267985077;
		j3472227351 -> j1947042584;
	j4267985077 [label="Какая мать, такая и дочь?",shape=box,color=red];
		j4267985077 -> j1838281;
	j1947042584 [label="Что это было? Я пропустил. Лол.",shape=box,color=red];
		j1947042584 -> j2941667418;
	j1838281 [label="PapaPolar: пожалуйста, не порти мне воспоминания",shape=box,color=blue];
		j1838281 -> j1602357423;
	j2941667418 [label="PapaPolar: ты, наверное, не знаешь старомодных мультфильмов, где скунс влюбляется в кошку, которую он считает скунсом",shape=box,color=blue];
		j2941667418 -> j761166601;
