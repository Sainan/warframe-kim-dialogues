	j2639706896 [label="MomToxicated: \"Должно быть, я обморозилась, потому что, когда я смотрю на тебя, у меня мурашки по всему телу.\"",shape=box,color=blue];
		j2639706896 -> j4269527569;
		j2639706896 -> j402267558;
