		j4109561181 -> j2332246917;
		j4109561181 -> j3620962020;
		j4109561181 -> j413944219;
	j2332246917 [label="Держу пари, мои ещё хуже. Мне пришлось провести столетия, застряв в карманном измерении, где не было никого, кроме сказочных персонажей, которые постоянно пытались меня убить.",shape=box,color=red];
		j2332246917 -> j438350626;
