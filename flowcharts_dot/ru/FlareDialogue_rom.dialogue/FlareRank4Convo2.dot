		j3873269191 -> j3796609842;
	j3240014398 [label="Твоё «поделиться» для нас выглядит как «разрушение». Придётся постараться это понять тебе. Понимаю, быть «меньше» тяжело, но попытайся. Помнишь, что произошло с Элеанорой? И с Лэтти?",shape=box,color=red];
