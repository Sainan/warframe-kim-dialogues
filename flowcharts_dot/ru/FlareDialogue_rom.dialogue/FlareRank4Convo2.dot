		j4132534168 -> j2145864098;
	j289869806 [label="Полегче! Моей целью было лишь убрать Флэр подальше отсюда. Я хочу обсудить возможность какого-нибудь перемирия между вами двумя.",shape=box,color=red];
		j289869806 -> j2029700028;
	j2710379199 [label="Потому что ты ошибаешься, и тебя больше не хотят видеть в своей жизни. Поэтому я найду способ уничтожить тебя, сбросить в Бездну - или типа того. Мне без разницы, как именно.",shape=box,color=red];
		j2710379199 -> j992902541;
