	j3112655114 [label="Уфф.",shape=box,color=red];
		j3112655114 -> j2771959586;
	j1686537800 [label="Ты подхватила техрот?",shape=box,color=red];
		j1686537800 -> j2771959586;
	j2771959586 [label="0/5 звёзд. не рекомендую. лежу я, значит, в туровом автобусе, и тут — стук в дверь",shape=box,color=blue];
		j2771959586 -> j3300282081;
		j2771959586 -> j784591401;
	j3300282081 [label="Энтрати?",shape=box,color=red];
		j3300282081 -> j802976297;
	j784591401 [label="Дай угадаю.",shape=box,color=red];
		j784591401 -> j159624300;
	j802976297 [label="дзынь-дзынь-дзынь.",shape=box,color=blue];
		j802976297 -> j159624300;
	j159624300 [label="пф, ты и так знаешь, какова история. волшебное мистическое лекарство? обещание, что я проявлю артистичность, какую мир ещё не видел?",shape=box,color=blue];
		j159624300 -> j148119234;
	j148119234 [label="и так далее, и так далее, и так далее.",shape=box,color=blue];
		j148119234 -> j3011772906;
	j3011772906 [label="этот ублюдок хотел концерт? ну он его получил. мой сценический образ всегда был немного... через край",shape=box,color=blue];
		j3011772906 -> j3866630340;
	j3866630340 [label="всегда с громкостью, выкрученной на максимум ",shape=box,color=blue];
		j3866630340 -> j3706701556;
	j3706701556 [label="но теперь? *теперь?* это было похоже на бег выше облаков, на какой-то волне, нельзя было даже представить, что подобное * существует*",shape=box,color=blue];
		j3706701556 -> j817418907;
		j3706701556 -> j1621138099;
	j817418907 [label="И что потом?",shape=box,color=red];
		j817418907 -> j4033834770;
	j1621138099 [label="Бездна — это та ещё доза.",shape=box,color=red];
		j1621138099 -> j508168867;
	j4033834770 [label="и на сцене стоит образ меня... я... чувствуя себя-меня... вживую. на самом деле. больше чем когда-либо. это было великолепно. свободно. как полёт",shape=box,color=blue];
		j4033834770 -> j2433887075;
	j508168867 [label="что?",shape=box,color=blue];
		j508168867 -> j1643221865;
	j2433887075 [label="мы устроили Хёльвании концерт, который они никогда не забудут. этот ублюдок хотел, чтобы мы дали им надежду? и веру? мы дали. в себя",shape=box,color=blue];
		j2433887075 -> j2458278006;
	j1643221865 [label="Не важно, продолжай. ",shape=box,color=red];
		j1643221865 -> j4033834770;
	j2458278006 [label="а дальше они уже переворачивали грузовики Скальдры и сносили статуи хахаха",shape=box,color=blue];
		j2458278006 -> j3494227454;
	j3494227454 [label="этот мелкий ублюдок так злился...",shape=box,color=blue];
		j3494227454 -> j3845645122;
