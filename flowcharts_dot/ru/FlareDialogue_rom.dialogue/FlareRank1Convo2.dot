		j3134658306 -> j2871417898;
	j3104529179 [label="ублюдок решил, что получит своё шоу. так или иначе. только на этот раз? это будет не концерт",shape=box,color=blue];
		j3104529179 -> j2222207981;
	j2871417898 [label="их невозможно было остановить. слишком много. и все против меня... смотрю, как ты их крошишь, будто конфеты жуёшь...",shape=box,color=blue];
		j2871417898 -> j1577247119;
