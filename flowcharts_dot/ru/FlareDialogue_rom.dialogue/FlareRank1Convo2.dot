	j2058307696 [label="Ладно. Можно спросить, что привело тебя в Хёльванию?",shape=box,color=red];
		j2058307696 -> j3718084876;
	j714511890 [label="Окей, но... там говорилось о «ней», которая тебя убьёт. Это прозвучало серьёзно. Кто «она»?",shape=box,color=red];
		j714511890 -> j3607640724;
	j73235138 [label="Окей, но в тебе была сильная грусть. Думаю, это не то, что стоит оставлять без внимания... Что происходит?",shape=box,color=red];
		j73235138 -> j3607640724;
	j3718084876 [label="Boolean FlareBackstory1 is now true.",color=orange];
		j3718084876 -> j204293716;
	j3607640724 [label="ты совсем не слышишь предупреждений... ТЫ НЕ СЛЫШИШЬ ПРЕДУПРЕЖДЕНИЙ... это не моя вина... это НЕ МОЯ ВИНА, ты понимаешь?! Чёрт... ЧЁРТ",shape=box,color=blue];
		j3607640724 -> j145207193;
	j204293716 [label="однажды раздался самый странный звонок от одного скользкого маленького ублюдка. надувался и растопыривал перья, словно пытался что-то доказать",shape=box,color=blue];
		j204293716 -> j4261137652;
	j145207193 [label="Boolean FlareLizzie2 is now true.",color=orange];
		j145207193 -> j261191027;
	j4261137652 [label="трепался о том, какой он важный, как этот город «разлагается» и «теряет веру», и как мы могли бы «помочь ему в его благородном деле привести всё в порядок»",shape=box,color=blue];
		j4261137652 -> j3613456982;
	j261191027 [label="+20 Chemistry",color=orange];
		j261191027 -> "Chat ends. Next chat will be FlareRank1Convo3.";
	j3613456982 [label="он реально думал, что знает, с кем говорит. лучшая часть? он утверждал, что он наш *фанат*",shape=box,color=blue];
		j3613456982 -> j1895295586;
	"Chat ends. Next chat will be FlareRank1Convo3." [color=orange];
	j1895295586 [label="нет ничего хуже, чем наблюдать, как идиоты перекручивают твои слова ради своих целей",shape=box,color=blue];
		j1895295586 -> j2058733824;
	j2058733824 [label="так что, конечно, мы сказали да. в основном потому, что мне стало понятно, что мы должны выбесить этого мелкого ублюдка и показать ему, насколько его член на самом деле мал",shape=box,color=blue];
		j2058733824 -> j1490006529;
	j1490006529 [label="зря мы не поверили таблоидам про всю эту странную чуму, конечно",shape=box,color=blue];
		j1490006529 -> j842184670;
	j842184670 [label="это была лютая хрень",shape=box,color=blue];
		j842184670 -> j3112655114;
		j842184670 -> j2876484565;
	j3112655114 [label="Уфф.",shape=box,color=red];
		j3112655114 -> j2771959586;
	j2876484565 [label="Заразился техрот?",shape=box,color=red];
		j2876484565 -> j2771959586;
	j2771959586 [label="0/5 звёзд. не рекомендую. лежу я, значит, в туровом автобусе, и тут — стук в дверь",shape=box,color=blue];
		j2771959586 -> j3968570786;
		j2771959586 -> j540766551;
	j3968570786 [label="Энтрати?",shape=box,color=red];
		j3968570786 -> j3746671304;
	j540766551 [label="Дай угадаю.",shape=box,color=red];
		j540766551 -> j1039252124;
	j3746671304 [label="дзынь-дзынь-дзынь.",shape=box,color=blue];
		j3746671304 -> j1039252124;
	j1039252124 [label="пф, ты и так знаешь, какова история. волшебное мистическое лекарство? обещание, что я стану артистом, какого мир ещё не видел?",shape=box,color=blue];
		j1039252124 -> j148119234;
	j148119234 [label="и так далее, и так далее, и так далее.",shape=box,color=blue];
		j148119234 -> j3011772906;
	j3011772906 [label="этот ублюдок хотел концерт? ну он его получил. мой сценический образ всегда был немного... через край",shape=box,color=blue];
		j3011772906 -> j3866630340;
	j3866630340 [label="всегда с громкостью, выкрученной на максимум ",shape=box,color=blue];
		j3866630340 -> j3706701556;
	j3706701556 [label="но теперь? *теперь?* это было похоже на бег выше облаков, на какой-то волне, нельзя было даже представить, что подобное * существует*",shape=box,color=blue];
		j3706701556 -> j2113842709;
		j3706701556 -> j1852250715;
	j2113842709 [label="И что потом?",shape=box,color=red];
		j2113842709 -> j4221711722;
	j1852250715 [label="Бездна — это та ещё доза.",shape=box,color=red];
		j1852250715 -> j1884335208;
	j4221711722 [label="и на сцене стоит новый я... чувствуя себя-меня... вживую. на самом деле. больше чем когда-либо. это было великолепно. свободно. как полёт",shape=box,color=blue];
		j4221711722 -> j2433887075;
	j1884335208 [label="что?",shape=box,color=blue];
		j1884335208 -> j978979845;
	j2433887075 [label="мы устроили Хёльвании концерт, который они никогда не забудут. этот ублюдок хотел, чтобы мы дали им надежду? и веру? мы дали. в себя",shape=box,color=blue];
		j2433887075 -> j2458278006;
	j978979845 [label="Не важно, продолжай. ",shape=box,color=red];
		j978979845 -> j4221711722;
	j2458278006 [label="а дальше они уже переворачивали грузовики Скальдры и сносили статуи хахаха",shape=box,color=blue];
		j2458278006 -> j3494227454;
	j3494227454 [label="этот мелкий ублюдок так злился...",shape=box,color=blue];
		j3494227454 -> j3845645122;
