		j261191027 -> "Chat ends. Next chat will be FlareRank1Convo3.";
	j3613456982 [label="он реально думал, что знает, с кем говорит. лучшая часть? он утверждал, что он наш *фанат*",shape=box,color=blue];
		j3613456982 -> j1895295586;
	"Chat ends. Next chat will be FlareRank1Convo3." [color=orange];
	j1895295586 [label="нет ничего хуже, чем наблюдать, как идиоты перекручивают твои слова ради своих целей",shape=box,color=blue];
		j1895295586 -> j2058733824;
	j2058733824 [label="так что, конечно, мы сказали да. в основном потому, что мне стало понятно, что мы должны выбесить этого мелкого ублюдка и показать ему, насколько его член на самом деле мал",shape=box,color=blue];
		j2058733824 -> j1490006529;
	j1490006529 [label="зря мы не поверили таблоидам про всю эту странную чуму, конечно",shape=box,color=blue];
		j1490006529 -> j842184670;
	j842184670 [label="это была лютая хрень",shape=box,color=blue];
		j842184670 -> j3112655114;
