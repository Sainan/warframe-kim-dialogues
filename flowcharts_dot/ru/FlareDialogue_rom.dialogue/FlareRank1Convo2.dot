	j2058307696 [label="Ладно. Можно спросить, что привело тебя в Хёльванию?",shape=box,color=red];
		j2058307696 -> j3718084876;
	j714511890 [label="Окей, но... там говорилось о «ней», которая тебя убьёт. Это прозвучало серьёзно. Кто «она»?",shape=box,color=red];
		j714511890 -> j3607640724;
	j73235138 [label="Окей, но в тебе была сильная грусть. Думаю, это не то, что стоит оставлять без внимания... Что происходит?",shape=box,color=red];
		j73235138 -> j3607640724;
	j3718084876 [label="Boolean FlareBackstory1 is now true.",color=orange];
		j3718084876 -> j204293716;
	j3607640724 [label="ты совсем не слышишь предупреждений... ТЫ НЕ СЛЫШИШЬ ПРЕДУПРЕЖДЕНИЙ... это не моя вина... это НЕ МОЯ ВИНА, ты понимаешь?! Чёрт... ЧЁРТ",shape=box,color=blue];
		j3607640724 -> j145207193;
	j204293716 [label="однажды раздался самый странный звонок от одного скользкого маленького ублюдка. надувался и растопыривал перья, словно пытался что-то доказать",shape=box,color=blue];
		j204293716 -> j4261137652;
	j145207193 [label="Boolean FlareLizzie2 is now true.",color=orange];
		j145207193 -> j261191027;
	j4261137652 [label="трепался о том, какой он важный, как этот город «разлагается» и «теряет веру», и как мы могли бы «помочь ему в его благородном деле привести всё в порядок»",shape=box,color=blue];
		j4261137652 -> j3613456982;
