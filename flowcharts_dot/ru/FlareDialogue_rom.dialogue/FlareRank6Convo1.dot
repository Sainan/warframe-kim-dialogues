		j1877297320 -> j378651341 [label=false,color=brown];
	j2216547390 [label="Я вижу огонь, что пылает в твоих глазах,  \nСол в клетке, растворяется в небесах.  \nТвоя улыбка подобна греху, я вижу твою боль,\nКаждый вздох, каждое прикосновение – сколько ты выдержишь?",shape=box,color=blue];
		j2216547390 -> j904886397;
	j2849651726 [label="Я видел зев Сол распахнулся, \nИзлился золотом, словно мёд.  \nМиллион голосов шептали так сладко,  \nСквозь запутанные залы и сны.",shape=box,color=blue];
		j2849651726 -> j904886397;
	j45469346 [label="Прокляни имя моё, я дьявол сегодня,  \nВзойдёт ли цветок зла, или завянет?",shape=box,color=blue];
