		j2106164143 -> j1460456354 [label=true,color=green];
		j2106164143 -> j1460456354 [label=false,color=brown];
	j3292246946 [label="Я вижу лёд в твоих глазах,  \nЛуа в клетке, растворяется в ночи.  \nТвоя улыбка подобна греху, я вижу твою боль,\nКаждый вздох, каждое прикосновение – сколько ты выдержишь?",shape=box,color=blue];
		j3292246946 -> j1908806570;
	j877182355 [label="Я видел зев Луа распахнулся, \nИзлился сахаром и серебром.  \nМиллион голосов шептали так сладко,  \nСквозь запутанные залы и сны.",shape=box,color=blue];
		j877182355 -> j1908806570;
	j4159496684 [label="Голодные крылья расправив на заре\nТы высекаешь судьбу на моей коже своими когтями\nОдин вдох, я свят — следующий вдох, и я во грехе\nНе могу сказать, я всё, или ничто.",shape=box,color=blue];
		j4159496684 -> j2729667313;
	j456381641 [label="Ты на вкус как огонь, ты поёшь как грех,\nТы притягиваешь меня к себе и забираешь.\nЛюби меня или оставь меня, мне будет больно в любом случае\nКаждый рассвет — это война, но с тобой мне суждено остаться.",shape=box,color=blue];
		j456381641 -> j3766366316;
	j1108137744 [label="Check boolean FlarePainUnique",color=orange];
		j1108137744 -> j2824715002 [label=true,color=green];
		j1108137744 -> j812880635 [label=false,color=brown];
	j2077574868 [label="Я танцую в Бездне, гремя твоими оковами\nВ своих кошмарах я не помню своих имён\nТы мой спаситель или мой рок?\nТы держишь Луа высоко, но тонешь в море\nО, люби меня или оставь, только не освобождай меня",shape=box,color=blue];
		j2077574868 -> j2794568679;
	j3900974630 [label="Check boolean FlarePainChronic",color=orange];
