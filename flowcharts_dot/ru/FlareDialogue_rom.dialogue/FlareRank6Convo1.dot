		j4192447210 -> j2755109891 [label=true,color=green];
		j4192447210 -> j2106164143 [label=false,color=brown];
	j2684892167 [label="Я просыпаюсь в пламени, заря обжигает,\nПорезы от серебряного света обрекают меня,\nКаждый вдох - битва, каждый шаг — война,\nТы шепчешь моё имя, пробуждая мой голод",shape=box,color=blue];
		j2684892167 -> j1908806570;
	j2637123773 [label="Check boolean FlarePainEmpathy",color=orange];
		j2637123773 -> j3292246946 [label=true,color=green];
		j2637123773 -> j877182355 [label=false,color=brown];
	j673193840 [label="Я танцую в Бездне, в твоём пламени,\nКаждое утро я просыпаюсь с новым именем\nТы мой спаситель или моё обречение?\nДержу Сол высоко, но тону в море,\nО, люби меня или оставь, только не освобождай меня",shape=box,color=blue];
