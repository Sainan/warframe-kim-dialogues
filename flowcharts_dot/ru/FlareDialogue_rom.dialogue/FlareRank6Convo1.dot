		j3900974630 -> j3492093567 [label=false,color=brown];
	j1460456354 [label="О, я сегодня грешник или святой?\nВосстану ли я как феникс, или пропаду?",shape=box,color=blue];
		j1460456354 -> j2321641489;
	j2729667313 [label="Check boolean FlareStoryVillain",color=orange];
		j2729667313 -> j3115228015 [label=true,color=green];
		j2729667313 -> j3710448588 [label=false,color=brown];
	j3766366316 [label="Твои прикосновения — яд, твой поцелуй — божественен\nДемон с руками, которые я чувствую хребтом.\nИногда я ползаю, иногда я летаю\nСкажи, что удержишь меня, когда я не смогу дотянуться до неба.",shape=box,color=blue];
		j3766366316 -> j2729667313;
	j2824715002 [label="Твои руки открывают секреты под моей кожей\nВытравливая клятвы там, где были шрамы\nИногда я стою, иногда ползаю\nНо ты заставляешь меня чувствовать, что у меня есть всё.",shape=box,color=blue];
		j2824715002 -> j3755931232;
	j812880635 [label="Check boolean FlarePainEmpathy",color=orange];
		j812880635 -> j2959958720 [label=true,color=green];
		j812880635 -> j2930403319 [label=false,color=brown];
	j2794568679 [label="Голодные крылья, расправленные в ночи\nТы вытравливаешь свою судьбу на моей коже укусом\nОдин вдох, я свят — следующий вдох, я во грехе\nНе могу сказать, я всё, или ничто.",shape=box,color=blue];
		j2794568679 -> j1941418009;
	j597022191 [label="Я сгораю, я распадаюсь, я теряюсь в твоих глазах\nТы — Бездна, где прячется умирающая Луа\nЛюби меня или оставь меня, мне будет больно в любом случае\nКаждый рассвет — это война, но с тобой мне суждено остаться.",shape=box,color=blue];
		j597022191 -> j1063090118;
	j3492093567 [label="Check boolean FlarePainUnique",color=orange];
		j3492093567 -> j3888906594 [label=true,color=green];
		j3492093567 -> j3828935203 [label=false,color=brown];
	j3115228015 [label="Сегодня я зло, во всём моя вина,\nМне гнаться за светом или потеряться в стыде?",shape=box,color=blue];
		j3115228015 -> j2252365749;
	j3710448588 [label="Check boolean FlareStoryHero",color=orange];
		j3710448588 -> j2467020687 [label=true,color=green];
		j3710448588 -> j828767743 [label=false,color=brown];
	j3755931232 [label="Я целую Бездну, ощущая вкус света\nТы ближе и мне хорошо\nНошу Сол, как золотую корону\nНо твои касания подобны гнили, покрыты плесенью",shape=box,color=blue];
		j3755931232 -> j2729667313;
	j2959958720 [label="Твоё прикосновение — гром, твой поцелуй — молния,\nНо внутри ты кричишь, пытаясь согреться.\nЯ вижу трещины под твоей кожей,\nТы сражаешься в битве без шансов на победу.",shape=box,color=blue];
		j2959958720 -> j2600185716;
	j2930403319 [label="Ты на вкус как огонь, ты поёшь как грех\nТы притягиваешь меня к себе и увлекаешь за собой\nО, люби меня или оставь, только не освобождай меня\nМне лучше принадлежать тебе, чем помнить себя",shape=box,color=blue];
		j2930403319 -> j3001220792;
	j1941418009 [label="Check boolean FlareStoryVillain",color=orange];
		j1941418009 -> j1008937991 [label=true,color=green];
		j1941418009 -> j1934034599 [label=false,color=brown];
	j1063090118 [label="Твои прикосновения — яд, твой поцелуй — божественен\nДемон с руками, которые я чувствую хребтом.\nИногда я ползаю ночью, иногда я летаю\nСкажи, что удержишь меня, если я не смогу дотянуться до неба.",shape=box,color=blue];
		j1063090118 -> j1941418009;
	j3888906594 [label="Твои руки открывают секреты под моей кожей\nВытравливая клятвы во тьме, где были шрамы\nИногда я стою, иногда ползаю по ночам\nНо ты заставляешь меня чувствовать, что у меня есть всё.",shape=box,color=blue];
		j3888906594 -> j1190264510;
	j3828935203 [label="Check boolean FlarePainEmpathy",color=orange];
		j3828935203 -> j2604762240 [label=true,color=green];
		j3828935203 -> j1702898484 [label=false,color=brown];
	j2252365749 [label="Золотые нимбы и змеиные усмешки,  \nПеснь любви умирает там, где зародились.\nВознесусь ли я? Упаду ли я?\nВознесусь ли я? Упаду ли я?",shape=box,color=blue];
		j2252365749 -> j1828110484;
	j2467020687 [label="Сегодня я герой, на мне нет вины,\nНести ли свет или затеряться в пламени?",shape=box,color=blue];
		j2467020687 -> j2252365749;
	j828767743 [label="Check boolean FlareStoryNone",color=orange];
		j828767743 -> j2092986305 [label=true,color=green];
		j828767743 -> j2092986305 [label=false,color=brown];
	j2600185716 [label="Сердце, как у Сол, но ты живёшь в Бездне\nОсвещаешь небо, чтобы  умереть\nЯ чувствую твой огонь, я знаю твою боль\nЯ горю так же, как и ты, мы истекаем кровью вместе.",shape=box,color=blue];
		j2600185716 -> j2729667313;
	j3001220792 [label="Я чувствую, как ты ползёшь под моей кожей\nТысяча рук, и один голос внутри\nО, я хранитель или жертва?\nЯ твоя болезнь или рай?",shape=box,color=blue];
		j3001220792 -> j2729667313;
	j1008937991 [label="Сегодня я зло, во всём моя вина,\nМне гнаться за светом или потеряться в стыде?",shape=box,color=blue];
		j1008937991 -> j1429056601;
	j1934034599 [label="Check boolean FlareStoryHero",color=orange];
		j1934034599 -> j1913157369 [label=true,color=green];
		j1934034599 -> j406023769 [label=false,color=brown];
	j1190264510 [label="Я целую Бездну, я пробую ночь на вкус\nТы прижимаешь меня к себе, и мне хорошо\nТы носишь Луа, как древнюю корону\nНо твоё прикосновение мёртвое и леденящее.",shape=box,color=blue];
		j1190264510 -> j1941418009;
	j2604762240 [label="Твоё прикосновение — хаос, но оно собирает меня воедино\nМолитва грешника высечена на моих костях\nКаждая рана, он и моя рана тоже\nКаждый крик, я слышу его в тебе",shape=box,color=blue];
		j2604762240 -> j2836396194;
	j1702898484 [label="Ты на вкус как лёд, ты поёшь как грех\nТы притягиваешь меня к себе и увлекаешь за собой\nО, люби меня или оставь, только не освобождай меня\nМне лучше принадлежать тебе, чем помнить себя",shape=box,color=blue];
		j1702898484 -> j1313715699;
	j1828110484 [label="----",shape=box,color=blue];
		j1828110484 -> j2765382384;
