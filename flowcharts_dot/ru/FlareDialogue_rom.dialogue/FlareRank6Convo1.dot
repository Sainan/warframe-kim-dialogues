		j1870422903 -> j1877297320 [label=false,color=brown];
	j1050493756 [label="Я просыпаюсь в пламени, заря обжигает,\nПорезы от света, но я всё ещё держусь\nКаждый вдох - битва, каждый шаг — война,\nТы шепчешь моё имя, пробуждая мой голод",shape=box,color=blue];
