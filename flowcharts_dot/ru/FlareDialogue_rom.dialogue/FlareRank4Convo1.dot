digraph {
	graph [fontname="Roboto Condensed"];
	node [fontname="Roboto Condensed"];
	edge [fontname="Roboto Condensed"];

	"FlareRank4Convo1 begins." [color=orange];
		"FlareRank4Convo1 begins." -> j3513417116;
	j3513417116 [label="я весь день думаю об этом... обо всей этой дурацкой ситуации...",shape=box,color=blue];
		j3513417116 -> j297037465;
	j297037465 [label="и о лучшем пути вперёд",shape=box,color=blue];
		j297037465 -> j3699902760;
	j3699902760 [label="или... о его полном отсутствии",shape=box,color=blue];
		j3699902760 -> j1977225158;
	j1977225158 [label="и у меня появилась идея",shape=box,color=blue];
		j1977225158 -> j2523934781;
		j1977225158 -> j1378080787;
	j2523934781 [label="Ух ох.",shape=box,color=red];
		j2523934781 -> j2786875075;
	j1378080787 [label="Серьёзно?",shape=box,color=red];
		j1378080787 -> j3501101005;
	j2786875075 [label="нет, нет, послушай меня",shape=box,color=blue];
		j2786875075 -> j3767038486;
	j3501101005 [label="итак",shape=box,color=blue];
		j3501101005 -> j3767038486;
	j3767038486 [label="лиззи говорит, что она из «откуда угодно и когда угодно», так что...",shape=box,color=blue];
		j3767038486 -> j1844711774;
	j1844711774 [label="просить тебя затащить её в какое-нибудь далёкое будущее не поможет, она просто приползёт обратно",shape=box,color=blue];
		j1844711774 -> j3721491836;
	j3721491836 [label="верно?",shape=box,color=blue];
		j3721491836 -> j1967992057;
		j3721491836 -> j102092385;
	j1967992057 [label="Кажется вероятным?",shape=box,color=red];
		j1967992057 -> j4011324295;
	j102092385 [label="Понятия не имею.",shape=box,color=red];
		j102092385 -> j264575482;
	j4011324295 [label="великолепно",shape=box,color=blue];
		j4011324295 -> j3534074143;
	j264575482 [label="давай допустим, что так",shape=box,color=blue];
		j264575482 -> j3534074143;
	j3534074143 [label="но, судя по тому, что мне удалось узнать от других обаятельных фриков...",shape=box,color=blue];
		j3534074143 -> j2977440113;
	j2977440113 [label="есть место, где Заражения *нет*",shape=box,color=blue];
		j2977440113 -> j1815995477;
	j1815995477 [label="где-то, куда мы могли бы ее заточить, откуда она *не смогла бы* выползти назад...",shape=box,color=blue];
		j1815995477 -> j859668117;
		j1815995477 -> j2835907842;
	j859668117 [label="Флэр, что-то мне очень не нравится куда все идёт... о чём ты говоришь?",shape=box,color=red];
		j859668117 -> j3637153573;
	j2835907842 [label="Если ты предлагаешь о том, чтобы сбросить её в Бездну... ответ — нет.",shape=box,color=red];
		j2835907842 -> j1538109525;
	j3637153573 [label="я не говорю о бездне",shape=box,color=blue];
		j3637153573 -> j4125644910;
	j1538109525 [label="Я не знаю как представлено Заражение в Бездне. Но и усугублять ситуацию не имею желания.",shape=box,color=red];
		j1538109525 -> j3637153573;
	j4125644910 [label="я говорю о дувири",shape=box,color=blue];
		j4125644910 -> j180661344;
		j4125644910 -> j1743904427;
		j4125644910 -> j3760319936;
	j180661344 [label="Думаю, это *послужило бы* уроком Траксу...",shape=box,color=red];
		j180661344 -> j1998776495;
	j1743904427 [label="ЧТО. НЕТ! Абсолютно нет!",shape=box,color=red];
		j1743904427 -> j1998776495;
	j3760319936 [label="Я - откуда ты знаешь о Дувири?!",shape=box,color=red];
		j3760319936 -> j4021366613;
	j1998776495 [label="судя по тому, что он тебе причинил, у тебя нет никаких долгов",shape=box,color=blue];
		j1998776495 -> j1507762669;
		j1998776495 -> j292276560;
		j1998776495 -> j3540113014;
	j4021366613 [label="понимаешь, я могу *разговаривать* с другими протофреймами",shape=box,color=blue];
		j4021366613 -> j247519164;
	j1507762669 [label="А что дает тебе право указывать мне, что я могу послать всё к чёрту?",shape=box,color=red];
		j1507762669 -> j639503878;
		j1507762669 -> j3668852742;
		j1507762669 -> j160051788;
	j292276560 [label="Может. А может и нет.",shape=box,color=red];
		j292276560 -> j639503878;
		j292276560 -> j3668852742;
		j292276560 -> j160051788;
	j3540113014 [label="Ты слишком упрощаешь ситуацию. Дувири было — и *есть* — гораздо больше, чем просто «место».",shape=box,color=red];
		j3540113014 -> j639503878;
		j3540113014 -> j3668852742;
		j3540113014 -> j160051788;
	j247519164 [label="и они мне всё рассказали про этот странный маленький дикий мир, в котором ты жил",shape=box,color=blue];
		j247519164 -> j1998776495;
	j639503878 [label="Ты никогда там не был. Ты не провёл там столетия. Ты не жил и не умирал там.",shape=box,color=red];
		j639503878 -> j3344755518;
		j639503878 -> j161587473;
		j639503878 -> j3584140548;
	j3668852742 [label="Если короче, Флэр? Это место... такая же часть меня, как и сказка, на которой оно основано.",shape=box,color=red];
		j3668852742 -> j3344755518;
		j3668852742 -> j161587473;
		j3668852742 -> j3584140548;
	j160051788 [label="Хотя моё отношение к нему не назвать... радужным... я не могу просто запулить туда Заражение и уйти.",shape=box,color=red];
		j160051788 -> j3344755518;
		j160051788 -> j3584140548;
		j160051788 -> j161587473;
	j3344755518 [label="И как бы иногда мне ни хотелось вернуться туда и набить кому-нибудь физиономию... Это не мой мусоропровод.",shape=box,color=red];
		j3344755518 -> j413186643;
	j161587473 [label="Нравится мне это или нет... каким-то глупым образом, я — тот, кто отвечает за это место.",shape=box,color=red];
		j161587473 -> j1789919777;
	j3584140548 [label="У меня там столько же приятных воспоминаний, сколько и болезненных.",shape=box,color=red];
		j3584140548 -> j1256907006;
	j413186643 [label="Так что это не твой мусоропровод тоже.",shape=box,color=red];
		j413186643 -> j2633697316;
		j413186643 -> j1665273356;
		j413186643 -> j3887238337;
	j1789919777 [label="Мне приходится быть рядом, чтобы защищать его, когда ему грозит опасность.",shape=box,color=red];
		j1789919777 -> j3887238337;
		j1789919777 -> j1665273356;
		j1789919777 -> j2633697316;
	j1256907006 [label="И только потому, что я хотел от него освободиться, не значит, что оно должно страдать.",shape=box,color=red];
		j1256907006 -> j3887238337;
		j1256907006 -> j2633697316;
		j1256907006 -> j1665273356;
	j2633697316 [label="Ты просишь меня заставить других страдать.",shape=box,color=red];
		j2633697316 -> j3376983249;
	j1665273356 [label="Флэр, подумай, о чём ты меня просишь.",shape=box,color=red];
		j1665273356 -> j1091422137;
	j3887238337 [label="Ты правда хочешь подвергнуть такому риску целый другой мир?",shape=box,color=red];
		j3887238337 -> j1058534185;
	j3376983249 [label="+5 Chemistry",color=orange];
		j3376983249 -> j1939670710;
	j1091422137 [label="тогда я был бы рад, и я имею в виду *рад*, если бы ты предложил другой вариант",shape=box,color=blue];
		j1091422137 -> j3230811514;
	j1058534185 [label="я - но дувири ведь не *настоящее*",shape=box,color=blue];
		j1058534185 -> j2773219578;
		j1058534185 -> j4125990670;
	j1939670710 [label="я - но они ведь не настоящие люди -",shape=box,color=blue];
		j1939670710 -> j2501533913;
	j3230811514 [label="потому что, я что-то не вижу от тебя никаких вообще предложений",shape=box,color=blue];
		j3230811514 -> j2990166568;
	j2773219578 [label="Ладно. Договорились. Ты садишься за стол по-хорошему, а я... рассмотрю вариант запереть её в Дувири, если окажется, что она лжёт.",shape=box,color=red];
		j2773219578 -> j857111232;
	j4125990670 [label="Кто мы такие, чтобы решать, что реально, а что нет?",shape=box,color=red];
		j4125990670 -> j1823278476;
	j2501533913 [label="нет, нет. я уже слышу эти слова у себя в голове",shape=box,color=blue];
		j2501533913 -> j1389234707;
	j2990166568 [label="Boolean FlareWar4 is now true.",color=orange];
		j2990166568 -> j517075388;
	j857111232 [label="Boolean FlareWar4b is now true.",color=orange];
		j857111232 -> j229978144;
	j1823278476 [label="я... да... это справедливо.",shape=box,color=blue];
		j1823278476 -> j4271882624;
	j1389234707 [label="что делает человека реальным, в конце концов? кто мы такие, чтобы решать?",shape=box,color=blue];
		j1389234707 -> j2477488299;
	j517075388 [label="+20 Chemistry",color=orange];
		j517075388 -> "Chat ends. Next chat will be FlareRank4Convo2.";
	j229978144 [label="+5 Chemistry",color=orange];
		j229978144 -> j1610236158;
	j4271882624 [label="+5 Chemistry",color=orange];
		j4271882624 -> j2477488299;
	j2477488299 [label="твоё Безразличие, похоже, считает, что мы ничего не значим.",shape=box,color=blue];
		j2477488299 -> j45155935;
	"Chat ends. Next chat will be FlareRank4Convo2." [color=orange];
	j1610236158 [label="благодарю, космический странник. ещё раз спасибо. удачи тебе",shape=box,color=blue];
		j1610236158 -> j517075388;
	j45155935 [label="дерьмо. *дерьмо. *ДЕРЬМО. скиталец, я просто... у меня... у меня больше нет идей, я в отчаянии, прошу... я не знаю, что ещё *делать*",shape=box,color=blue];
		j45155935 -> j2773219578;
		j45155935 -> j3154119231;
	j3154119231 [label="Позволь мне просто... попытаться поговорить об этом с Лиззи.",shape=box,color=red];
		j3154119231 -> j3022901865;
	j3022901865 [label="Boolean FlarePeace4 is now true.",color=orange];
