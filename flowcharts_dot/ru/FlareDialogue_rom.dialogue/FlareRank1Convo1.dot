	j2558787007 [label="о, сол, нет, конечно. извини, если создалось такое впечатление. хотя, думаю, правда твоя. мы, протофреймы, не единственные эксперименты в этом городе, да?",shape=box,color=blue];
		j2558787007 -> j4292812616;
		j2558787007 -> j101729760;
		j2558787007 -> j2511731834;
	j2499038190 [label="мне бы *очень* хотелось узнать, как именно, по-твоему, это может стать ещё хуже",shape=box,color=blue];
		j2499038190 -> j3172717676;
	j2089100034 [label="собственно, именно об этом мне хотелось с тобой поболтать...",shape=box,color=blue];
		j2089100034 -> j3330197702;
	j3838847190 [label="так что рассказывай",shape=box,color=blue];
