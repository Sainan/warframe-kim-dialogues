	1 [label="эй, космический странник",shape=box,color=blue];
		1 -> 2;
		1 -> 3;
	2 [label="О, привет. Флэр, верно?",shape=box,color=red];
		2 -> 4;
	3 [label="Эй. чего надо?",shape=box,color=red];
		3 -> 5;
	4 [label="ты же тот научный эксперимент о котором мне рассказывали, да?",shape=box,color=blue];
		4 -> 6;
		4 -> 7;
	5 [label="сижу тут, заняться нечем. у меня куча вопросов, если у тебя есть время",shape=box,color=blue];
		5 -> 8;
		5 -> 9;
		5 -> 10;
	6 [label="Я бы сказал, что вряд ли тут найдётся второй я, но… ну, длинная история. Не суть.",shape=box,color=red];
		6 -> 11;
	7 [label="Зависит от того, что именно они говорили. Но, скорее всего, да.",shape=box,color=red];
		7 -> 12;
	8 [label="Нечем заняться, и ты решаешь постучать по стеклу зоопарка? Забавно.",shape=box,color=red];
		8 -> 13;
	9 [label="Серьёзно? Нечем заняться? Мне даже льстит. хаха.",shape=box,color=red];
		9 -> 14;
	10 [label="Если хочешь задать вопросы, Я тут. Спрашивай.",shape=box,color=red];
		10 -> 15;
	11 [label="ладно. ну. они ввели меня в курс дела.",shape=box,color=blue];
		11 -> 16;
