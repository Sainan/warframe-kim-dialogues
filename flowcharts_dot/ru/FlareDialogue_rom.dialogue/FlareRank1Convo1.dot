		32 -> 39;
	34 [label="и если не ошибаюсь, то кое-кто рассказывал кое-что о \"космической травме\", верно?",shape=box,color=blue];
		34 -> 33;
		34 -> 40;
	33 [label="Хаха. Ну, хотя бы можно пропустить вводную часть.",shape=box,color=red];
