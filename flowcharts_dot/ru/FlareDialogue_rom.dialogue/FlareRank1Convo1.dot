	53 [label="Её?",shape=box,color=red];
		53 -> 59;
	54 [label="То, что с тобой происходит, ничем не отличается от того, через что прошёл Гекс. Твой случай не уникален.",shape=box,color=red];
		54 -> 60;
	55 [label="Я понимаю, через что ты проходишь. Я могу помочь.",shape=box,color=red];
