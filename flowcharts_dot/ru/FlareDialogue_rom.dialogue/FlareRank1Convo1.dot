		j2511731834 -> j3838847190;
	j3165144512 [label="начни с самого начала. если не трудно. прояви доброту. *сейчас*.",shape=box,color=blue];
		j3165144512 -> j2988955069;
	j2850897917 [label="Check boolean QuincySpaceTrauma",color=orange];
