	56 [label="Я знаю, что всё это пугает — стать протофреймом, да ещё и ситуация здесь, в Хёльвании —",shape=box,color=red];
		56 -> 62;
	57 [label="Подразумевалось, что в мире есть гораздо худшие вещи, чем быть фриком. Брр.",shape=box,color=red];
		57 -> 63;
	58 [label="я не знаю, какая помощь тебе нужна, какие взятки, какие услуги мне нужно для тебя оказать, но мне *нужно* избавиться от неё прямо *сейчас*",shape=box,color=blue];
