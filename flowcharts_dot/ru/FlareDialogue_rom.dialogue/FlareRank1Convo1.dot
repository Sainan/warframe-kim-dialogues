		j1959807674 -> j1893615857;
	j3384219267 [label="ты же тот научный эксперимент о котором мне рассказывали, да?",shape=box,color=blue];
		j3384219267 -> j3496083699;
		j3384219267 -> j2744104443;
	j1893615857 [label="сижу тут, заняться нечем. у меня куча вопросов, если у тебя есть время",shape=box,color=blue];
		j1893615857 -> j3875772292;
		j1893615857 -> j3401857658;
		j1893615857 -> j2832411842;
	j3496083699 [label="Я бы сказал, что вряд ли тут найдётся второй я, но… ну, длинная история. Не суть.",shape=box,color=red];
		j3496083699 -> j1793644824;
	j2744104443 [label="Зависит от того, что именно они говорили. Но, скорее всего, да.",shape=box,color=red];
		j2744104443 -> j4092733596;
	j3875772292 [label="Нечем заняться, и ты решаешь постучать по стеклу зоопарка? Забавно.",shape=box,color=red];
		j3875772292 -> j3474521451;
	j3401857658 [label="Серьёзно? Нечем заняться? Мне даже льстит. хаха.",shape=box,color=red];
		j3401857658 -> j2936401773;
	j2832411842 [label="Если хочешь задать вопросы, Я тут. Спрашивай.",shape=box,color=red];
		j2832411842 -> j3437428046;
	j1793644824 [label="ладно. ну. они ввели меня в курс дела.",shape=box,color=blue];
