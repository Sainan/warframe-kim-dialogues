		40 -> 17;
		40 -> 18;
	41 [label="потому что, если посмотреть с моей стороны, у меня. в крови яд, который медленно сводит меня с ума и разлагает моё тело",shape=box,color=blue];
		41 -> 46;
	42 [label="я называю это бредом",shape=box,color=blue];
		42 -> 47;
	43 [label="я... извиняюсь. обычно я так себя не веду. но я в ситуации, которую... очень сложно описать",shape=box,color=blue];
		43 -> 48;
	44 [label="дело не в том, что я хочу ответы, дорогой космический странник. дело в том, что они мне *нужны*",shape=box,color=blue];
		44 -> 49;
	45 [label="я не думаю, что смогу подобрать слова, чтобы адекватно выразить, насколько я не в порядке",shape=box,color=blue];
		45 -> 48;
	46 [label="и единственный человек, который мог бы дать мне ответы — единственный, кто мог бы объяснить это мне или избавить меня от неё, *исчез*",shape=box,color=blue];
		46 -> 50;
	47 [label="поэтому я хочу знать о нём всё, что знаешь ты. если ты не возражаешь",shape=box,color=blue];
