		15 -> 20;
	16 [label="амир... скажем так, очень быстро предоставил мне подробности.",shape=box,color=blue];
		16 -> 21;
	17 [label="Ты здесь, чтобы тыкать палкой в клетку зверя?",shape=box,color=red];
		17 -> 22;
	18 [label="Чем могу помочь?",shape=box,color=red];
		18 -> 20;
	19 [label="о, сол, нет, конечно. извини, если создалось такое впечатление. хотя, думаю, правда твоя. мы, протофреймы, не единственные научные эксперименты в этом городе, да?",shape=box,color=blue];
		19 -> 23;
		19 -> 24;
		19 -> 25;
	20 [label="заражение. эта гниль. эта штука, отравляющая мою кровь. мне нужно знать всё, что ты знаешь",shape=box,color=blue];
		20 -> 26;
	21 [label="очень... очень быстро...",shape=box,color=blue];
		21 -> 27;
