		j4092733596 -> j477431900;
	j3474521451 [label="+5 Chemistry",color=orange];
		j3474521451 -> j811266603;
	j2936401773 [label="хех, прости. неудачно вышло.",shape=box,color=blue];
		j2936401773 -> j3330197702;
	j3437428046 [label="отлично",shape=box,color=blue];
		j3437428046 -> j3330197702;
	j2252812107 [label="амир... скажем так, очень быстро предоставил мне подробности.",shape=box,color=blue];
		j2252812107 -> j2482605175;
	j2106687694 [label="Ты здесь, чтобы тыкать палкой в клетку зверя?",shape=box,color=red];
		j2106687694 -> j2394873371;
	j477431900 [label="Чем могу помочь?",shape=box,color=red];
		j477431900 -> j3330197702;
	j811266603 [label="о, сол, нет, конечно. извини, если создалось такое впечатление. хотя, думаю, правда твоя. мы, протофреймы, не единственные научные эксперименты в этом городе, да?",shape=box,color=blue];
		j811266603 -> j4292812616;
		j811266603 -> j101729760;
		j811266603 -> j2511731834;
	j3330197702 [label="заражение. эта гниль. эта штука, отравляющая мою кровь. мне нужно знать всё, что ты знаешь",shape=box,color=blue];
		j3330197702 -> j3165144512;
	j2482605175 [label="очень... очень быстро...",shape=box,color=blue];
