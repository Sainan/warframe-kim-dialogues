		j1796919634 -> j3877571879;
	j907540136 [label="Я знаю, что всё это пугает — стать протофреймом, да ещё и ситуация здесь, в Хёльвании —",shape=box,color=red];
		j907540136 -> j3922270106;
	j2105034172 [label="Подразумевалось, что в мире есть гораздо худшие вещи, чем быть фриком. Брр.",shape=box,color=red];
		j2105034172 -> j2344383404;
	j4040565568 [label="я не знаю, какая помощь тебе нужна, какие взятки, какие услуги мне нужно для тебя оказать, но мне *нужно* избавиться от неё прямо *сейчас*",shape=box,color=blue];
