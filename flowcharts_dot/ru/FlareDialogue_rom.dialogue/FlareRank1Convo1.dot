		j2988955069 -> j2342585710;
	j3739507757 [label="и если не ошибаюсь, то кое-кто рассказывал кое-что о \"космической травме\", верно?",shape=box,color=blue];
		j3739507757 -> j1021507802;
		j3739507757 -> j476672578;
	j1021507802 [label="Хаха. Ну, хотя бы можно пропустить вводную часть.",shape=box,color=red];
		j1021507802 -> j2106687694;
		j1021507802 -> j477431900;
	j3172717676 [label="просвети меня",shape=box,color=blue];
		j3172717676 -> j3912079914;
	j1890695332 [label="куда он делся? энтрати? остальные говорят, что не знают. что ты тоже не знаешь",shape=box,color=blue];
		j1890695332 -> j1210413679;
	j3903206155 [label="Мне не очень нравится твой тон",shape=box,color=red];
		j3903206155 -> j3369910595;
	j2278303825 [label="Эм... Это займёт время, и, думаю, тебе не понравятся ответы.",shape=box,color=red];
		j2278303825 -> j2493371446;
	j2342585710 [label="Эй, стой, полегче. Давай назад. Ты в порядке?",shape=box,color=red];
		j2342585710 -> j483296724;
	j476672578 [label="Ага. Это, должно быть, Куинси.",shape=box,color=red];
		j476672578 -> j2106687694;
		j476672578 -> j477431900;
	j3912079914 [label="потому что, если посмотреть с моей стороны, у меня. в крови яд, который медленно сводит меня с ума и разлагает моё тело",shape=box,color=blue];
		j3912079914 -> j3564719690;
	j1210413679 [label="я называю это бредом",shape=box,color=blue];
		j1210413679 -> j1752011362;
	j3369910595 [label="я... извиняюсь. обычно я так себя не веду. но я в ситуации, которую... очень сложно описать",shape=box,color=blue];
		j3369910595 -> j1395429895;
	j2493371446 [label="дело не в том, что я хочу ответы, дорогой космический странник. дело в том, что они мне *нужны*",shape=box,color=blue];
		j2493371446 -> j2921080696;
	j483296724 [label="я не думаю, что смогу подобрать слова, чтобы адекватно выразить, насколько я не в порядке",shape=box,color=blue];
		j483296724 -> j1395429895;
	j3564719690 [label="и единственный человек, который мог бы дать мне ответы — единственный, кто мог бы объяснить это мне или избавить меня от неё, *исчез*",shape=box,color=blue];
		j3564719690 -> j1702964281;
	j1752011362 [label="поэтому я хочу знать о нём всё, что знаешь ты. если ты не возражаешь",shape=box,color=blue];
		j1752011362 -> j2671079504;
	j1395429895 [label="и напомню тебе, что моя работа это подбирать слова для своих чувств",shape=box,color=blue];
		j1395429895 -> j3288693986;
	j2921080696 [label="и я не думаю, что смогу подобрать слова, чтобы объяснить, насколько моя ситуация отличается от остальных и насколько мне необходимо избавиться от неё *немедленно*",shape=box,color=blue];
		j2921080696 -> j2109673303;
