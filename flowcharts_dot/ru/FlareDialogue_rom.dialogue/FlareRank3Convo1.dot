	j4140010517 [label="должно быть, это прекрасно.",shape=box,color=blue];
		j4140010517 -> j815429711;
	j1456585454 [label="Даже не знаю есть ли способ описать. Но я понимаю. Поверь на слово.",shape=box,color=red];
		j1456585454 -> j3602424550;
	j2740230311 [label="Иногда приходилось просыпаться и чувствовать себя в чужой шкуре, буквально. Что я-не то, что снаружи. Что я какая-то подделка, ложь.",shape=box,color=red];
		j2740230311 -> j1458093711;
	j1503574417 [label="Иногда я просыпаюсь и боль настолько сильна, что хочется заползти в какую-нибудь дыру на весь день. Чтобы попробовать завтра. Но я знаю, что это повторится снова.",shape=box,color=red];
