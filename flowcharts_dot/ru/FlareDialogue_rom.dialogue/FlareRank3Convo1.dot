		j2949251941 -> j1166997282;
	j1446046271 [label="или удастся ли вообще дожить до конца дня? придётся ли закрыться в комнате, запереть дверь и кричать всем, чтобы УШЛИ ПРОЧЬ",shape=box,color=blue];
