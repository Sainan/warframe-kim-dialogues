		j3602424550 -> j445190833;
	j1458093711 [label="о, теперь ты поёшь мою песню, cкиталец. у меня всегда было ощущение, что во мне два человека. ещё даже до появления Лиззи в моей жизни",shape=box,color=blue];
		j1458093711 -> j3768693949;
	j1581525576 [label="хроническая боль... когда тело не слушается тебя. у меня был хороший друг, которому пришлось отказаться от тура с группой именно из-за этого",shape=box,color=blue];
