	j3733750901 [label="Уфф.",shape=box,color=red];
		j3733750901 -> j3560602067;
	j2788883742 [label="Заразился техрот?",shape=box,color=red];
		j2788883742 -> j3560602067;
	j812854342 [label="как это происходит, когда она - ",shape=box,color=blue];
		j812854342 -> j1403097193;
	j3046357825 [label="*и* вдобавок ко всему, она просто продолжает * приставать* ко мне из-за того, что я постоянно кормлю её всеми этими странными вещами, такими как -",shape=box,color=blue];
		j3046357825 -> j662939116;
	j3560602067 [label="0/5 звёзд. не рекомендую. лежу я, значит, в туровом автобусе, и тут — стук в дверь",shape=box,color=blue];
		j3560602067 -> j1993005722;
