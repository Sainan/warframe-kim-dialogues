		j62893014 -> j2327894423;
	j1947992385 [label="+5 Chemistry",color=orange];
		j1947992385 -> j1295464717;
	j3755660139 [label="моё появление было как снег на голову и устроило срач в чужом доме, не так ли?",shape=box,color=blue];
		j3755660139 -> j2123485136;
		j3755660139 -> j3994015024;
	j759960329 [label="не могу дождаться, когда вплету их всех в свою музыку",shape=box,color=blue];
		j759960329 -> j2189847744;
	j1568932332 [label="однажды раздался самый странный звонок от одного скользкого маленького ублюдка. растопыривал перья, словно пытался что-то доказать",shape=box,color=blue];
		j1568932332 -> j122162352;
	j2327894423 [label="ощущение, что оно где-то там, в углу комнаты, просто смотрит на меня, не моргая, всё время",shape=box,color=blue];
		j2327894423 -> j2229186300;
	j1295464717 [label="хах, прости. нет, я имею в виду — чувствую себя так, будто я на вечеринке, куда меня никто не звал",shape=box,color=blue];
		j1295464717 -> j3755660139;
	j2123485136 [label="Оглянитесь вокруг. Хёльвания и так была в ужасном состоянии до твоего приезда.",shape=box,color=red];
		j2123485136 -> j3388044817;
	j3994015024 [label="Кирпич ведь не просил, чтобы им швырялись, не так ли?",shape=box,color=red];
		j3994015024 -> j2325326043;
	j2189847744 [label="интересно, можно ли было бы научить их играть...",shape=box,color=blue];
		j2189847744 -> j619938223;
	j122162352 [label="трепался о том, какой он важный, как этот город «разлагается» и «теряет веру», и как мы могли бы «помочь ему в его благородном деле привести всё в порядок»",shape=box,color=blue];
		j122162352 -> j2832001220;
	j2229186300 [label="безглазое, но всегда смотрящее, без век, пустое, *голодное*",shape=box,color=blue];
		j2229186300 -> j3031012087;
	j3388044817 [label="мм, наверное. трудно сломать то, что уже сломано",shape=box,color=blue];
		j3388044817 -> j1395176453;
	j2325326043 [label="нет, но она ведь была довольно полезным тупым предметом, не так ли?",shape=box,color=blue];
		j2325326043 -> j3342633725;
	j619938223 [label="Check boolean QuincyArthur2",color=orange];
