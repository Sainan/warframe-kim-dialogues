		j2589764137 -> j958770756;
	j3842017404 [label="ублюдок решил, что получит своё шоу. так или иначе. только на этот раз? это будет не концерт",shape=box,color=blue];
		j3842017404 -> j3049337841;
	j958770756 [label="их невозможно было остановить. было слишком много. против одного меня? смотрю, как ты их крошишь, будто конфеты жуёшь...",shape=box,color=blue];
		j958770756 -> j62170390;
