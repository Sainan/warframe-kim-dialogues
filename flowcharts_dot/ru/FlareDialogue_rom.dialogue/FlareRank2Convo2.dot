		j4182930701 -> j2555618956;
	j2555618956 [label="пф, ты и так знаешь, какова история. волшебное мистическое лекарство? обещание, что я стану артистом, какого мир ещё не видел?",shape=box,color=blue];
		j2555618956 -> j1278533528;
