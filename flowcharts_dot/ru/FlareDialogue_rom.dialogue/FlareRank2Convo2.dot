		j619938223 -> j2353104188 [label=false,color=brown];
		j619938223 -> j863381958 [label=false,color=brown];
	j2832001220 [label="он реально думал, что знает, с кем говорит. лучшая часть? он утверждал, что он наш *фанат*",shape=box,color=blue];
		j2832001220 -> j3036325131;
	j3031012087 [label="ждёт, когда я моргну. ждёт, когда я посмотрю, мельком гляну или опущу защиту, чтобы внезапно наброситься ",shape=box,color=blue];
		j3031012087 -> j2128611582;
	j1395176453 [label="и всё равно не покидает чувство, что я делаю хуже, а не лучше",shape=box,color=blue];
		j1395176453 -> j2057921890;
	j3342633725 [label="но я понял о чём ты",shape=box,color=blue];
		j3342633725 -> j2810379196;
	j3861051650 [label="Знаю из надёжного источника, что Артур умеет петь.",shape=box,color=red];
		j3861051650 -> j383455539;
	j732976558 [label="Я знаю, что Аои присоединилась бы к тебе за *один удар сердца*.",shape=box,color=red];
		j732976558 -> j2865823168;
	j863381958 [label="Ох, Бездна. Я представляю их всех в группе. Кажется, я сейчас умру от смеха.",shape=box,color=red];
		j863381958 -> j2865823168;
	j2353104188 [label="Я... желаю тебе удачи. всей, какая только есть.",shape=box,color=red];
		j2353104188 -> j942044436;
	j3036325131 [label="нет ничего хуже, чем наблюдать, как идиоты перекручивают твои слова ради своих целей",shape=box,color=blue];
		j3036325131 -> j1257609397;
	j2128611582 [label="как акула, чувствуя кровь в воде...",shape=box,color=blue];
		j2128611582 -> j1740930415;
		j2128611582 -> j3393214336;
	j2057921890 [label="всё потому, что я позволил энтрати использовать меня. я жаждал силы, которая показала бы этому ублюдку, что музыку нельзя убить",shape=box,color=blue];
		j2057921890 -> j911049419;
	j2810379196 [label="меня использовали. я позволил этому случиться. я был в ярости. я жаждал силы, которая показала бы этому ублюдку, что музыку нельзя убить",shape=box,color=blue];
		j2810379196 -> j911049419;
	j383455539 [label="он не похож на бэк-вокалиста, но кто знает",shape=box,color=blue];
		j383455539 -> j942044436;
	j2865823168 [label="какой восхитительный образ",shape=box,color=blue];
		j2865823168 -> j942044436;
	j942044436 [label="но всё это несбыточная мечта...",shape=box,color=blue];
		j942044436 -> j734632044;
	j1257609397 [label="так что, конечно, мы сказали да. в основном потому, что мне стало понятно, что мы должны выбесить этого мелкого ублюдка и показать ему, насколько его член на самом деле мал",shape=box,color=blue];
		j1257609397 -> j148511080;
	j1740930415 [label="Эй, успокойся на секунду. О чём ты говоришь?",shape=box,color=red];
		j1740930415 -> j1602724943;
	j3393214336 [label="Ладно, Флер. Ты меня пугаешь.",shape=box,color=red];
		j3393214336 -> j2281108993;
	j911049419 [label="но... я... устраиваюсь поудобнее, чтобы ответить на твой вопрос ",shape=box,color=blue];
		j911049419 -> j1132996973;
	j734632044 [label="сейчас в дуэте... но вскоре стану соло, если она добьется своего...",shape=box,color=blue];
		j734632044 -> j3268976782;
		j734632044 -> j3393214336;
	j148511080 [label="зря мы не поверили таблоидам про всю эту странную чуму, конечно",shape=box,color=blue];
		j148511080 -> j1038490020;
	j1602724943 [label="прошу прощения...",shape=box,color=blue];
		j1602724943 -> j361035586;
	j2281108993 [label="в этом ты не одинок",shape=box,color=blue];
		j2281108993 -> j1602724943;
	j1132996973 [label="даже если я больше никогда в жизни не буду есть пиццу, я умру счастливым",shape=box,color=blue];
		j1132996973 -> j2440349542;
