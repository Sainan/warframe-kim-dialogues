	"Chat ends. Next chat will be FlareRank2Convo3." [color=orange];
	j2934563654 [label="но теперь? *теперь?* это было похоже на бег выше облаков, на какой-то волне, нельзя было даже представить, что подобное * существует*",shape=box,color=blue];
		j2934563654 -> j3387041579;
		j2934563654 -> j1267527436;
	j3387041579 [label="И что потом?",shape=box,color=red];
		j3387041579 -> j2940124401;
	j1267527436 [label="Бездна — это та ещё доза.",shape=box,color=red];
		j1267527436 -> j3455658654;
	j2940124401 [label="и на сцене стоит новый я... чувствуя себя-меня... вживую. на самом деле. больше чем когда-либо. это было великолепно. свободно. как полёт",shape=box,color=blue];
		j2940124401 -> j1864477339;
	j3455658654 [label="что?",shape=box,color=blue];
		j3455658654 -> j1489102541;
	j1864477339 [label="мы устроили Хёльвании концерт, который они никогда не забудут. этот ублюдок хотел, чтобы мы дали им надежду? и веру? мы дали. в себя",shape=box,color=blue];
		j1864477339 -> j2834106624;
	j1489102541 [label="Не важно, продолжай. ",shape=box,color=red];
		j1489102541 -> j2940124401;
	j2834106624 [label="а дальше они уже переворачивали грузовики Скальдры и сносили статуи хахаха",shape=box,color=blue];
		j2834106624 -> j2294348030;
	j2294348030 [label="этот мелкий ублюдок так злился...",shape=box,color=blue];
		j2294348030 -> j3032908246;
	j3032908246 [label="надо было понимать, чем это нам обойдётся...",shape=box,color=blue];
		j3032908246 -> j755876145;
