digraph {
	0 [label="LoidRank1Convo1 begins.",color=orange];
		0 -> 1;
	1 [label="Скиталец. Прости за беспокойство, я не хотел связываться с тобой через это устройство. Но ситуация почти чрезвычайная, и я не знал, к кому ещё могу обратиться.",shape=box,color=blue];
		1 -> 2;
		1 -> 3;
	2 [label="ПОМ2_ЛАБ1?",shape=box,color=red];
		2 -> 4;
	3 [label="Кто это?..",shape=box,color=red];
		3 -> 4;
	4 [label="Ах да. Настройки всё ещё по умолчанию. Это Лойд. Мне следовало бы... начать с этого, но в последнее время в Санктум Анатомика полный хаос.",shape=box,color=blue];
		4 -> 5;
	5 [label="Вот почему я обращаюсь к тебе. Мне нужна твоя помощь. Три протофрейма прибыли сюда, в Санктум, ещё в моё время. И не те, которые нам были когда-либо известны.",shape=box,color=blue];
		5 -> 6;
	6 [label="Один из них, это...",shape=box,color=blue];
		6 -> 7;
	7 [label="... я извиняюсь...",shape=box,color=blue];
		7 -> 8;
	8 [label="Один из них - Орокин, Скиталец.",shape=box,color=blue];
		8 -> 9;
		8 -> 10;
		8 -> 11;
	9 [label="Где Лотос?",shape=box,color=red];
		9 -> 12;
	10 [label="О, нет... ",shape=box,color=red];
		10 -> 13;
	11 [label="Что?!",shape=box,color=red];
		11 -> 13;
	12 [label="У Лотос и Оператора есть другие дела, поверь. Они и так уже загружены до предела. Я бы не просил тебя помочь мне с этими проблемами, если бы чувствовал, что мне есть к кому обратиться.",shape=box,color=blue];
		12 -> 14;
	13 [label="Я бы не просил тебя о помощи, если бы чувствовал, что мне есть к кому обратиться. Ты… возможно, новый эксперт в подобных вопросах.",shape=box,color=blue];
		13 -> 15;
	14 [label="Ты… возможно, новый эксперт в подобных вопросах.",shape=box,color=blue];
		14 -> 15;
	15 [label="Я не знаю, как лучше их описать. Но если вы придёте в Санктум, я думаю, их будет трудно не заметить. Двое из них согласились поговорить с тобой здесь через ПОМ-2. Ещё с одним, возможно, придётся поговорить дополнительно.",shape=box,color=blue];
		15 -> 16;
	16 [label="Я... верю... что ты добьёшься успеха.",shape=box,color=blue];
		16 -> 29;
	29 [label="Update boolean LoidTriadAvailable",color=orange];
		29 -> 17;
	17 [label="Chat ends. Next chat will be LoidFamily.",color=orange];
}