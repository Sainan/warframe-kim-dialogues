digraph {
	"LoidRank1Convo1 begins." [color=orange];
		"LoidRank1Convo1 begins." -> j1314391750;
	j1314391750 [label="Скиталец. Прости за беспокойство, я не хотел связываться с тобой через это устройство. Но ситуация почти чрезвычайная, и я не знал, к кому ещё могу обратиться.",shape=box,color=blue];
		j1314391750 -> j1388350474;
		j1314391750 -> j2018886515;
	j1388350474 [label="ПОМ2_ЛАБ1?",shape=box,color=red];
		j1388350474 -> j4143721306;
	j2018886515 [label="Кто это?..",shape=box,color=red];
		j2018886515 -> j4143721306;
	j4143721306 [label="Ах да. Настройки всё ещё по умолчанию. Это Лойд. Мне следовало бы... начать с этого, но в последнее время в Санктум Анатомика полный хаос.",shape=box,color=blue];
		j4143721306 -> j506491457;
	j506491457 [label="Вот почему я обращаюсь к тебе. Мне нужна твоя помощь. Три протофрейма прибыли сюда, в Санктум, ещё в моё время. И не те, которые нам были когда-либо известны.",shape=box,color=blue];
		j506491457 -> j2579149323;
	j2579149323 [label="Один из них, это...",shape=box,color=blue];
		j2579149323 -> j209243487;
	j209243487 [label="... я извиняюсь...",shape=box,color=blue];
		j209243487 -> j579480860;
	j579480860 [label="Один из них - Орокин, Скиталец.",shape=box,color=blue];
		j579480860 -> j1607844475;
		j579480860 -> j2388199478;
		j579480860 -> j1563905430;
	j1607844475 [label="Где Лотос?",shape=box,color=red];
		j1607844475 -> j319455749;
	j2388199478 [label="О, нет... ",shape=box,color=red];
		j2388199478 -> j4012052415;
	j1563905430 [label="Что?!",shape=box,color=red];
		j1563905430 -> j4012052415;
	j319455749 [label="У Лотос и Оператора есть другие дела, поверь. Они и так уже загружены до предела. Я бы не просил тебя помочь мне с этими проблемами, если бы чувствовал, что мне есть к кому обратиться.",shape=box,color=blue];
		j319455749 -> j1766733182;
	j4012052415 [label="Я бы не просил тебя о помощи, если бы чувствовал, что мне есть к кому обратиться. Ты… возможно, новый эксперт в подобных вопросах.",shape=box,color=blue];
		j4012052415 -> j3604455702;
	j1766733182 [label="Ты… возможно, новый эксперт в подобных вопросах.",shape=box,color=blue];
		j1766733182 -> j3604455702;
	j3604455702 [label="Я не знаю, как лучше их описать. Но если вы придёте в Санктум, я думаю, их будет трудно не заметить. Двое из них согласились поговорить с тобой здесь через ПОМ-2. Ещё с одним, возможно, придётся поговорить дополнительно.",shape=box,color=blue];
		j3604455702 -> j2755391203;
	j2755391203 [label="Я... верю... что ты добьёшься успеха.",shape=box,color=blue];
		j2755391203 -> j3173882;
	j3173882 [label="Boolean LoidTriadAvailable is now true.",color=orange];
		j3173882 -> "Chat ends. Next chat will be LoidFamily.";
	"Chat ends. Next chat will be LoidFamily." [color=orange];
}