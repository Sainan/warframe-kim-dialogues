	"LoidRank1Convo1 begins." [color=orange];
		"LoidRank1Convo1 begins." -> j1264401747;
	j1264401747 [label="Скиталец. Прости за беспокойство, я не хотел связываться с тобой через это устройство. Но ситуация почти чрезвычайная, и я не знал, к кому ещё могу обратиться.",shape=box,color=blue];
		j1264401747 -> j3188804846;
		j1264401747 -> j2473752769;
	j3188804846 [label="ПОМ2_ЛАБ1?",shape=box,color=red];
		j3188804846 -> j111347431;
	j2473752769 [label="Кто это?..",shape=box,color=red];
		j2473752769 -> j111347431;
	j111347431 [label="Ах да. Настройки всё ещё по умолчанию. Это Лойд. Мне следовало бы... начать с этого, но в последнее время в Санктум Анатомика полный хаос.",shape=box,color=blue];
		j111347431 -> j4157329080;
	j4157329080 [label="Вот почему я обращаюсь к тебе. Мне нужна твоя помощь. Три протофрейма прибыли сюда, в Санктум, ещё в моё время. И не те, которые нам были когда-либо известны.",shape=box,color=blue];
		j4157329080 -> j2579149323;
	j2579149323 [label="Один из них, это...",shape=box,color=blue];
		j2579149323 -> j209243487;
	j209243487 [label="... я извиняюсь...",shape=box,color=blue];
		j209243487 -> j579480860;
	j579480860 [label="Один из них - Орокин, Скиталец.",shape=box,color=blue];
		j579480860 -> j1242553297;
		j579480860 -> j1306252235;
		j579480860 -> j1037794588;
	j1242553297 [label="Где Лотос?",shape=box,color=red];
		j1242553297 -> j3008771131;
	j1306252235 [label="О, нет... ",shape=box,color=red];
		j1306252235 -> j514230516;
	j1037794588 [label="Что?!",shape=box,color=red];
		j1037794588 -> j514230516;
	j3008771131 [label="У Лотос и Оператора есть другие дела, поверь. Они и так уже загружены до предела. Я бы не просил тебя помочь мне с этими проблемами, если бы чувствовал, что мне есть к кому обратиться.",shape=box,color=blue];
		j3008771131 -> j3664890187;
	j514230516 [label="Я бы не просил тебя о помощи, если бы чувствовал, что мне есть к кому обратиться. Ты… возможно, новый эксперт в подобных вопросах.",shape=box,color=blue];
		j514230516 -> j4248229716;
	j3664890187 [label="Ты… возможно, новый эксперт в подобных вопросах.",shape=box,color=blue];
		j3664890187 -> j4248229716;
	j4248229716 [label="Я не знаю, как лучше их описать. Но если вы придёте в Санктум, я думаю, их будет трудно не заметить. Двое из них согласились поговорить с тобой здесь через ПОМ-2. Ещё с одним, возможно, придётся поговорить дополнительно.",shape=box,color=blue];
		j4248229716 -> j2755391203;
	j2755391203 [label="Я... верю... что ты добьёшься успеха.",shape=box,color=blue];
		j2755391203 -> j3173882;
	j3173882 [label="Boolean LoidTriadAvailable is now true.",color=orange];
		j3173882 -> "Chat ends. Next chat will be LoidFamily.";
	"Chat ends. Next chat will be LoidFamily." [color=orange];
}