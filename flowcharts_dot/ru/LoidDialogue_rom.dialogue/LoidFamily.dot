	j796632493 [label="Скиталец. Я больше не могу. Роут, Мари и Лион убедили меня, что настал мой час.",shape=box,color=blue];
		j796632493 -> j3677934456;
	j3677934456 [label="Я боюсь грядущего до мозга костей. Возможно, именно это и будет извлечено из меня, когда меня порвут на части в припадке ярости, если Гомайтру и её семья узнают о том, что творилось у них под носом всё это время.",shape=box,color=blue];
		j3677934456 -> j864309891;
	j864309891 [label="Так странно называть её этим именем сейчас, но между нами так много изменилось. И ещё многое изменится в ближайшее время.",shape=box,color=blue];
		j864309891 -> j2315979387;
		j864309891 -> j4189804400;
	j2315979387 [label="Давно пора было это сделать. Всё будет хорошо.",shape=box,color=red];
