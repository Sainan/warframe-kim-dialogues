		j2502471650 -> "Chat ends." [label="false",color=purple];
	j1346448475 [label="Скиталец. Я больше не могу. Роут, Мари и Лион убедили меня, что настал мой час.",shape=box,color=blue];
		j1346448475 -> j540153026;
	j540153026 [label="Я боюсь грядущего до мозга костей. Возможно, именно это и будет извлечено из меня, когда меня порвут на части в припадке ярости, если Гомайтру и её семья узнают о том, что творилось у них под носом всё это время.",shape=box,color=blue];
		j540153026 -> j1463553628;
	j1463553628 [label="Так странно называть её этим именем сейчас, но между нами так много изменилось. И ещё многое изменится в ближайшее время.",shape=box,color=blue];
		j1463553628 -> j848204417;
		j1463553628 -> j3180108020;
	j848204417 [label="Давно пора было это сделать. Всё будет хорошо.",shape=box,color=red];
		j848204417 -> j466364352;
	j3180108020 [label="Ты справишься.",shape=box,color=red];
		j3180108020 -> j466364352;
	j466364352 [label="Да, ну ладно. Пожалуйста, зайди как-нибудь и убедись, что мои внутренности не используются в качестве праздничного декора в Некралиске, ладно? Я боюсь, мне понадобится немного успокоения, когда всё будет сказано и сделано.",shape=box,color=blue];
		j466364352 -> j937202740;
