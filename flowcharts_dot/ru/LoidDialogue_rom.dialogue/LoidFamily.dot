	j4189804400 [label="Ты справишься.",shape=box,color=red];
		j4189804400 -> j3508559448;
	j3508559448 [label="Да, ну ладно. Пожалуйста, зайди как-нибудь и убедись, что мои внутренности не используются в качестве праздничного декора в Некралиске, ладно? Я боюсь, мне понадобится немного успокоения, когда всё будет сказано и сделано.",shape=box,color=blue];
		j3508559448 -> j937202740;
