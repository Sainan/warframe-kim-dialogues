	25 [label="Ты справишься.",shape=box,color=red];
		25 -> 26;
	26 [label="Да, ну ладно. Пожалуйста, зайди как-нибудь и убедись, что мои внутренности не используются в качестве праздничного декора в Некралиске, ладно? Я боюсь, мне понадобится немного успокоения, когда всё будет сказано и сделано.",shape=box,color=blue];
		26 -> 27;
