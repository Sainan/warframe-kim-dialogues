		20 -> 22;
	21 [label="Chat ends.",color=orange];
	22 [label="Я боюсь грядущего до мозга костей. Возможно, именно это и будет извлечено из меня, когда меня порвут на части в припадке ярости, если Гомайтру и её семья узнают о том, что творилось у них под носом всё это время.",shape=box,color=blue];
		22 -> 23;
	23 [label="Так странно называть её этим именем сейчас, но между нами так много изменилось. И ещё многое изменится в ближайшее время.",shape=box,color=blue];
		23 -> 24;
