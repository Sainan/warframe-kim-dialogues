	2070 [label="Oui, конечно.",shape=box,color=blue];
		2070 -> 2060;
	2071 [label="Ты знаешь, с чего началась моя история, но есть часть, которую я тебе не рассказала.",shape=box,color=blue];
		2071 -> 2077;
	2072 [label="Update boolean MarieBackstory1",color=orange];
		2072 -> 2078;
	2073 [label="Это причиняет ему боль, но всё же это часть его самого. И если ты подойдёшь к нему avec colère, с раздражением, он вздрогнет от твоего прикосновения.",shape=box,color=blue];
		2073 -> 2079;
	2074 [label="Chat ends.",color=orange];
	2075 [label="Chat ends.",color=orange];
	2076 [label="Chat ends.",color=orange];
	2077 [label="Я ведь говорила тебе, что была нищенкой на улицах, когда была jeune fille. И что потом устроила свою жизнь и у меня появилось много друзей.",shape=box,color=blue];
		2077 -> 2080;
	2078 [label="Я родилась в богатой семье, что, возможно, удивит тебя. В семье буржуа, которые ближе к Орокин, чем можно подумать.",shape=box,color=blue];
		2078 -> 2081;
	2079 [label="Нужно завоевать доверие бродячего создания. Пусть он сам придёт к тебе, non ? Понимаешь, что я имею в виду ?",shape=box,color=blue];
		2079 -> 2082;
		2079 -> 2083;
		2079 -> 2084;
	2080 [label="Одним из них был большой мальчик постарше по имени Хьюго.",shape=box,color=blue];
		2080 -> 2085;
	2081 [label="Но когда я родилась такой… искривлённой, c mes pieds tordus et inutilisables? Ох, ma mère не могла этого допустить.",shape=box,color=blue];
		2081 -> 2086;
	2082 [label="Да, на самом деле. Спасибо.",shape=box,color=red];
		2082 -> 2087;
	2083 [label="Больше, чем следовало бы, спасибо.",shape=box,color=red];
		2083 -> 2088;
	2084 [label="Неа. Но спасибо за попытку.",shape=box,color=red];
		2084 -> 2089;
	2085 [label="Он был в некотором роде вожаком стаи. И он всегда следил за тем, чтобы никто ни кто меня обижал, и чтобы у меня было всё мне необходимое.",shape=box,color=blue];
		2085 -> 2090;
	2086 [label="Нужно было ведь поддерживать видимость, oui? Следить за стандартами.",shape=box,color=blue];
		2086 -> 2091;
	2087 [label="Bien! Я уже боялась, что опять увлекусь своими метафорами.",shape=box,color=blue];
		2087 -> 2092;
	2088 [label="Мари и её метафоры. Ах, bon.",shape=box,color=blue];
		2088 -> 2092;
	2089 [label="Mince alors. Вот ведь знала же, снова дала волю своим métaphores.",shape=box,color=blue];
		2089 -> 2092;
	2090 [label="Он даже помог мне соорудить des béquilles - как ты их там называешь... эх... костыли ? Чтобы я могла передвигаться, используя обрезки дерева, которые мы подобрали.",shape=box,color=blue];
		2090 -> 2093;
	2091 [label="Итак, что же делать с бедной, искалеченной Мари? Меня отвезли в la Cité de la Lumière, где я, конечно же, погибла бы на улицах...",shape=box,color=blue];
		2091 -> 2094;
	2092 [label="Хм. Мне думается, что, возможно, описание Лиона как бродячей собаки - не самое лестное сравнение...",shape=box,color=blue];
		2092 -> 2095;
	2093 [label="Однажды утром мы пошли его будить и нашли его -",shape=box,color=blue];
		2093 -> 2096;
	2094 [label="И была оставлена умирать.",shape=box,color=blue];
		2094 -> 2097;
		2094 -> 2098;
	2095 [label="Пожалуй, не стоит говорить ему, что я так сказала, oui?..",shape=box,color=blue];
		2095 -> 2099;
	2096 [label="Je... я пощажу тебя подробностями... Я уверена, ты и так можешь догадаться о чём речь.",shape=box,color=blue];
		2096 -> 2100;
	2097 [label="Сколько тебе было лет?",shape=box,color=red];
		2097 -> 2101;
	2098 [label="Твоя семья оставила тебя умирать?",shape=box,color=red];
		2098 -> 2102;
	2099 [label="Update boolean LyonStrayDog",color=orange];
		2099 -> 2103;
		2099 -> 2104;
	2100 [label="Но он оставил нам сообщение. Едва разборчивое. Он был единственным из всех детей, кто умел читать и писать, и мне пришлось прочитать его остальным. ",shape=box,color=blue];
		2100 -> 2105;
	2101 [label="Лет шесть? Семь? На их взгляд, они многие годы старались сделать всё возможное, чтобы исцелить меня. Наставники учили меня ходить. Ортезы. Ортопедическая обувь.",shape=box,color=blue];
		2101 -> 2106;
	2102 [label="На их взгляд, они многие годы старались сделать всё возможное, чтобы исцелить меня. Наставники учили меня ходить. Ортезы. Ортопедическая обувь.",shape=box,color=blue];
		2102 -> 2106;
	2103 [label="По-моему, это мило, и он тоже так подумает.",shape=box,color=red];
		2103 -> 2107;
	2104 [label="Со мной твой секрет под надёжным замком.",shape=box,color=red];
		2104 -> 2108;
	2105 [label="Я до сих пор помню, как мой голос дрогнул. Но мне нужно было держаться. Потому что даже тогда я понимала, что у меня есть долг перед другими. ",shape=box,color=blue];
		2105 -> 2109;
	2106 [label="Они устали от этой обузы. И вот я, едва умея читать и писать самостоятельно цифры и буквы, я очутилась среди уличной грязи.",shape=box,color=blue];
		2106 -> 2110;
		2106 -> 2111;
	2107 [label="Quelle horrible personne ! J'espère que votre chaise va s'effondrer et vous donner plein d'échardes douloureuses !",shape=box,color=blue];
		2107 -> 2112;
	2108 [label="Merci! Какое облегчение...",shape=box,color=blue];
		2108 -> 2113;
	2109 [label="Они говорили мне, что Хьюго всегда казался нам таким жизнерадостным. Si joyeux. Всегда смеялся, всегда шутил над жизнью.",shape=box,color=blue];
		2109 -> 2114;
	2110 [label="Это ужасно.",shape=box,color=red];
		2110 -> 2115;
	2111 [label="Как тебе удалось выжить?",shape=box,color=red];
		2111 -> 2115;
	2112 [label="Chat ends.",color=orange];
	2113 [label="Chat ends.",color=orange];
	2114 [label="Даже когда нас прогоняли или его били палкой за воровство или шатание без дела, казалось, его это ничуть не беспокоило.",shape=box,color=blue];
		2114 -> 2116;
	2115 [label="Check boolean MarieSecretPower",color=orange];
		2115 -> 2117 [label=true,color=green];
		2115 -> 2118 [label=false,color=brown];
	2116 [label="Но мы ведь никогда не знаем, насколько глубока боль в сердцах других. И из этого оставленного сообщения я поняла, что он плакал вместе с Луа.",shape=box,color=blue];
		2116 -> 2119;
	2117 [label="Всё было так, как и было сказано тобой, non ? В каждом неудобстве скрыта своя сила.",shape=box,color=blue];
		2117 -> 2118;
	2118 [label="То, что сделало меня indésirable pour ma mère, сделало меня весьма популярной среди детей улицы.",shape=box,color=blue];
		2118 -> 2120;
	2119 [label="Но теперь он обрёл покой рядом с ней. Какое-то время я обижалась на него за то, что он ушёл. Ведь остальные смотрели на меня в поисках опоры. И я затаила обиду на него за то, что он бросил меня.",shape=box,color=blue];
		2119 -> 2121;
	2120 [label="Что может быть более pathétique, чем ребёнок без pieds, oui? Я могла заработать за день с открытыми ладонями больше, чем они успевали украсть за неделю.",shape=box,color=blue];
		2120 -> 2122;
	2121 [label="Но со временем я пришла к пониманию одной истины.",shape=box,color=blue];
		2121 -> 2123;
	2122 [label="И я всегда был склонна делиться. Поэтому у меня и было много друзей, которые присматривали за мной, заботились обо мне. Одним из них был большой мальчик постарше по имени Хьюго.",shape=box,color=blue];
		2122 -> 2085;
	2123 [label="Мы можем простить себя только за то, что мы люди. И простить себе боль от их ухода.",shape=box,color=blue];
		2123 -> 2124;
	2124 [label="Ведь боль именно от их отсутствие причиняется нам. И от чувства, что мы не сумели помочь им достаточно.",shape=box,color=blue];
		2124 -> 2125;
	2125 [label="Мы никогда не узнаем о бремени, которое несут другие.",shape=box,color=blue];
		2125 -> 2126;
	2126 [label="И это большая tragédie. Но именно это и значит быть человеком.",shape=box,color=blue];
		2126 -> 2127;
	2127 [label="Не знаю, послужил ли тебе мой рассказ утешением. Но я надеюсь на это. Мне нужно идти, Monsieur Лойд зовёт.",shape=box,color=blue];
		2127 -> 2128;
		2127 -> 2129;
	2128 [label="Спасибо, Мари.",shape=box,color=red];
		2128 -> 2130;
	2129 [label="[Промолчать.]",shape=box,color=red];
		2129 -> 2131;
	2130 [label="+20 Chemistry",color=orange];
		2130 -> 2132;
	2131 [label="+20 Chemistry",color=orange];
		2131 -> 2133;
	2132 [label="Всегда пожалуйста. À bientôt.",shape=box,color=blue];
		2132 -> 2134;
	2133 [label="À la revoyure.",shape=box,color=blue];
		2133 -> 2135;
	2134 [label="Chat ends.",color=orange];
