		2047 -> 2055;
	2048 [label="Сделать больше означало бы раздавить их или их прогнать.",shape=box,color=blue];
		2048 -> 2056;
	2049 [label="Вот и всё, чего я прошу. Ох, но я так счастлива ! Мне нужно постараться, чтобы эта пара сложилась!",shape=box,color=blue];
		2049 -> 2057;
		2049 -> 2058;
		2049 -> 2059;
	2050 [label="Тогда поговори с ним о своих тревогах. Он выслушает. Он ведь не ребёнок. ",shape=box,color=blue];
		2050 -> 2060;
	2051 [label="+20 Chemistry",color=orange];
		2051 -> 2061;
	2052 [label="Давайте на этом закончим. ",shape=box,color=red];
		2052 -> 2062;
	2053 [label="Давай лучше вернёмся к разговору о Лионе, ладно?",shape=box,color=red];
		2053 -> 2063;
	2054 [label="Наверное... мне хотелось бы узнать о них больше.",shape=box,color=red];
		2054 -> 2064;
	2055 [label="Тебе нужно научиться читать между строк, non ? Он говорит историями. Притчами. Если он молчит, прислушайся к языку его тела.",shape=box,color=blue];
		2055 -> 2056;
	2056 [label="Ты ведь заботишься о нём, хочешь помочь — и, я уверена, он это чувствует. Ах! Вот оно что. Он как бездомный пёс со шрамом на лапе. Шрам зажил, но неправильно. Теперь всё ещё ноет и зудит.",shape=box,color=blue];
		2056 -> 2065;
	2057 [label="Постой, я не имею в виду, чтобы ты вмешивалась!",shape=box,color=red];
		2057 -> 2066;
	2058 [label="Стоит ли мне беспокоиться?",shape=box,color=red];
		2058 -> 2066;
	2059 [label="Мне бы не помешала помощь.",shape=box,color=red];
		2059 -> 2067;
	2060 [label="Он как бездомный пёс со шрамом на лапе. Шрам зажил, но неправильно. Теперь всё ещё ноет и зудит.",shape=box,color=blue];
		2060 -> 2065;
	2061 [label="Merci. Это всё, о чем я могу просить. À bientôt.",shape=box,color=blue];
