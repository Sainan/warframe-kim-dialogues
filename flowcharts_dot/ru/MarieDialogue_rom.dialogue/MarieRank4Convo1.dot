		j738506989 -> j1079694227 [label="false",color=purple];
		j738506989 -> j2391164010 [label="false",color=purple];
	j2329809322 [label="[Отключите все разговоры о членовредительстве. Вы не потеряете очки симпатии ни с одним персонажем.]",shape=box,color=red];
		j2329809322 -> j982025565;
	j2032252329 [label="Честно говоря, я не знаю, было бы мной предпочтено, чтобы эти его видения были настоящими или фальшивыми.",shape=box,color=red];
		j2032252329 -> j1195696072;
	j2218050600 [label="Когда он говорит о всех тех ужасных вещах, что ему доводится видеть. Его описания...",shape=box,color=red];
		j2218050600 -> j1195696072;
	j1079694227 [label="Что однажды он может причинить себе вред так, что пути обратно уже не будет?",shape=box,color=red];
		j1079694227 -> j2628304435;
	j2391164010 [label="Бывает ли, что ты чувствуешь себя небезопасно в его присутствии? Что он способен навредить тебе, даже не понимая этого?",shape=box,color=red];
		j2391164010 -> j464076125;
	j982025565 [label="Boolean LyonPainOff is now true.",color=orange];
		j982025565 -> j1254492242;
	j1195696072 [label="+5 Chemistry",color=orange];
		j1195696072 -> j2892329838;
	j2628304435 [label="Ах... это неловкая тема, oui? Pardon, но я не совсем знаю, как об этом говорить, не запутавшись в собственных словах.",shape=box,color=blue];
		j2628304435 -> j3509256174;
	j464076125 [label="Я верю, что Лион скорее лишит себя жизни, чем причинит мне вреда. У меня есть вера, во всех богов и дьяволов...",shape=box,color=blue];
		j464076125 -> j442713619;
	j1254492242 [label="+20 Chemistry",color=orange];
		j1254492242 -> j1534304376;
	j2892329838 [label="Кошмары, которые наполняют его разум - Луа направляет его по трудному пути, oui?",shape=box,color=blue];
		j2892329838 -> j772178023;
	j3509256174 [label="Но я сделаю всё, что в моих силах. Я полагаю, ты спрашиваешь из-за беспокойства о нём?",shape=box,color=blue];
		j3509256174 -> j326629071;
		j3509256174 -> j4132818251;
	j442713619 [label="- что даже твоё Indifférence не смогло заставить его настолько, чтобы он осмелился поднять на руку меня.",shape=box,color=blue];
		j442713619 -> j1937476987;
	j1534304376 [label="[Это позволит все диалоги о членовредительстве обходить стороной.]",shape=box,color=blue];
		j1534304376 -> "Chat ends.";
	j772178023 [label="Боюсь, об этом трудно говорить. Потому что я знаю, что этого не должно быть, oui ?",shape=box,color=blue];
		j772178023 -> j3454219883;
	j326629071 [label="Известно, что Варфрейм, которому дали сыворотку... ну...",shape=box,color=red];
		j326629071 -> j58185703;
		j326629071 -> j2608506538;
		j326629071 -> j653890609;
	j4132818251 [label="Это довольно очевидно, стоит только на него взглянуть... без обид. Нетрудно было догадаться.",shape=box,color=red];
		j4132818251 -> j58185703;
		j4132818251 -> j2608506538;
		j4132818251 -> j653890609;
	j1937476987 [label="Скорее поверю, что бабочка способна devour меня без остатка, чем испугаюсь брата своей души.",shape=box,color=blue];
		j1937476987 -> j772178023;
	j3454219883 [label="Мне хотелось бы остановить его. Уберечь от этого его стремления причинить себе такой вред.",shape=box,color=blue];
		j3454219883 -> j680576281;
	j58185703 [label="Я лишь беспокоюсь, что однажды он может зайти слишком далеко.",shape=box,color=red];
		j58185703 -> j772178023;
	j2608506538 [label="Он нужен нам целым и невредимым.",shape=box,color=red];
		j2608506538 -> j2437848986;
	j653890609 [label="Я не хочу переживать из-за того, что мне придётся убирать его труп.",shape=box,color=red];
		j653890609 -> j698283448;
	j680576281 [label="Если есть что-то, в чём у меня есть уверенность насчёт Лиона, так это в том, что он всегда будет рядом, когда понадобится.",shape=box,color=blue];
		j680576281 -> j2924461461;
	j2437848986 [label="Ты эхом отдаёшь слова дьявола. Неужели тебя вдохновляет лишь холодная нужда в чьих-то умелых руках ?",shape=box,color=blue];
		j2437848986 -> j129966982;
		j2437848986 -> j184362862;
	j698283448 [label="Dégoûtant.",shape=box,color=blue];
		j698283448 -> j1508231473;
	j2924461461 [label="Он великий защитник, le bouclier sacré de Lua.... Сияющий свет во тьме ночи.",shape=box,color=blue];
		j2924461461 -> j964978829;
	j129966982 [label="Нет, я очень за него переживаю. Просто я переживаю, что, когда он нам понадобится, его не будет рядом.",shape=box,color=red];
		j129966982 -> j680576281;
	j184362862 [label="Мне лишь нужно знать, могу ли я на него рассчитывать или он уже слишком сломлен.",shape=box,color=red];
		j184362862 -> j1210539792;
	j1508231473 [label="Boolean MarieNoDate is now true.",color=orange];
		j1508231473 -> "Chat ends.";
	j964978829 [label="Боль, которую он причиняет себе... он делает это, чтобы услышать собственные мысли. Чтобы почувствовать своё тело. ",shape=box,color=blue];
		j964978829 -> j3970834316;
	j1210539792 [label="Интересно, кто поможет тебе, когда ты окажешься в затруднительном положении и будешь нуждаться в помощи.",shape=box,color=blue];
		j1210539792 -> j590985574;
	j3970834316 [label="Ибо небо усыпано звёздами, и каждая из них шепчет ему, а он, как и сама Луа, теряется среди них.",shape=box,color=blue];
		j3970834316 -> j1670335897;
	j590985574 [label="Или ты полагаешь, что время уже пришло и прошло, и теперь ты выше подобного упрека?",shape=box,color=blue];
		j590985574 -> j698283448;
	j1670335897 [label="И подобно Луа, он проходит через свои фазы. Его поглощает Бездна, чтобы потом сиять так ярко, что мы можем идти во тьме без страха.",shape=box,color=blue];
		j1670335897 -> j526060029;
	j526060029 [label="Но, как и любое благословение, оно несёт с собой проклятие. Слышен ли в моих словах хоть какой-то смысл ? Боюсь, я просто несу чепуху.",shape=box,color=blue];
		j526060029 -> j4056151493;
		j526060029 -> j212812291;
		j526060029 -> j1162531794;
		j526060029 -> j679732551;
		j526060029 -> j3279082839;
	j4056151493 [label="Я всё прекрасно понимаю. И мне нужно… кое в чём признаться. [Признаться в чувствах к Лиону.]",shape=box,color=red];
		j4056151493 -> j3922663500;
	j212812291 [label="Я понимаю, о чём ты говоришь, но я не могу оправдать его поступок. Он должен остановиться.",shape=box,color=red];
		j212812291 -> j2482795532;
	j1162531794 [label="[Предупреждение: обсуждение самоубийства.] Я однажды потеряла человека из-за подобного самоповреждения. Я не могу... я не могу это оправдать.",shape=box,color=red];
		j1162531794 -> j88584593;
	j679732551 [label="Должен быть другой путь.",shape=box,color=red];
		j679732551 -> j3095325183;
	j3279082839 [label="Ты всё говоришь совершенно логично. Мне просто... хотелось бы ему помочь.",shape=box,color=red];
		j3279082839 -> j3095325183;
	j3922663500 [label="Boolean DrifterLyon is now true.",color=orange];
		j3922663500 -> j1548776478;
	j2482795532 [label="Boolean DrifterHarmStop is now true.",color=orange];
		j2482795532 -> j3178109370;
	j88584593 [label="Boolean DrifterHarmLoss is now true.",color=orange];
		j88584593 -> j2172387227;
	j3095325183 [label="Boolean DrifterHarmHelp is now true.",color=orange];
		j3095325183 -> j3466069344;
	j1548776478 [label="Я боюсь, что он... завладел моим сердцем, и оно разрывается от осознания того, что ему больно.",shape=box,color=red];
		j1548776478 -> j944704724;
	j3178109370 [label="Его страдания куда глубже тех ран, что он причиняет своей плоти. То, что он делает с собой теперь, уже не отпустит его.",shape=box,color=blue];
		j3178109370 -> j2265614703;
	j2172387227 [label="О! Я не знала, мне так, так жаль... Какие бы жалкие попытки утешения и молитвы я бы ни произнесла, они всё равно покажутся пустыми, я уверена...",shape=box,color=blue];
		j2172387227 -> j1031170968;
	j3466069344 [label="+20 Chemistry",color=orange];
		j3466069344 -> j474903050;
	j944704724 [label="+20 Chemistry",color=orange];
		j944704724 -> j2592836597;
	j2265614703 [label="Это проясняет его разум, успокаивает душу. И теперь, как протофрейм - как отчасти этот... Харроу, как я отчасти Висп, это его не убьёт, да? ",shape=box,color=blue];
		j2265614703 -> j1430063236;
		j2265614703 -> j2524003837;
	j1031170968 [label="- ведь какие condoléances может выразить тот, кто едва тебе знаком, которые могли бы стать бальзамом на душу после такой трагедии?",shape=box,color=blue];
		j1031170968 -> j3238867601;
	j474903050 [label="И за это я не могу не восхищаться тобой ещё больше. Но форма помощи может быть разной, non ?",shape=box,color=blue];
		j474903050 -> j3570357661;
	j2592836597 [label="Ох!! Я только что закричала, словно увидела мышь, и напугала Monsieur Лойда! Pardon!!",shape=box,color=blue];
		j2592836597 -> j3965606651;
	j1430063236 [label="Нет, это не убьёт его. Но всё равно так нельзя.",shape=box,color=red];
		j1430063236 -> j123881750;
	j2524003837 [label="Пожалуй, я понимаю твою точку зрения.",shape=box,color=red];
		j2524003837 -> j280577678;
	j3238867601 [label="Эта душа, о потере которой ты говоришь… она была тебе близка?",shape=box,color=blue];
		j3238867601 -> j601579112;
		j3238867601 -> j49043520;
	j3570357661 [label="Иногда помочь птенцу значит погубить его. Помочь пламени свечи может означать задуть его в твоей exubérance.",shape=box,color=blue];
		j3570357661 -> j2834505640;
	j3965606651 [label="Ох, но это же чудесная новость!",shape=box,color=blue];
		j3965606651 -> j3755357903;
		j3965606651 -> j2574040211;
	j123881750 [label="Я поняла, что быть рядом с ним, когда он нуждается во мне... слушать его, обнимать его, когда он плачет?",shape=box,color=blue];
		j123881750 -> j304573589;
	j280577678 [label="+10 Chemistry",color=orange];
		j280577678 -> j2834505640;
	j601579112 [label="Да.",shape=box,color=red];
		j601579112 -> j3195211772;
	j49043520 [label="Не очень.",shape=box,color=red];
		j49043520 -> j2823814751;
	j2834505640 [label="Я поняла, что быть рядом с ним, когда он нуждается во мне... слушать его, просто сидеть рядом с ним, когда он плачет ?",shape=box,color=blue];
		j2834505640 -> j3988718669;
	j3755357903 [label="Правда? Мне неизвестно было твоё отношение к этому.",shape=box,color=red];
		j3755357903 -> j738693288;
	j2574040211 [label="Мне бы только хотелось знать, выносит ли он моё присутствие или нет...",shape=box,color=red];
		j2574040211 -> j2355836413;
	j304573589 [label="Это даёт для него больше, чем просто говорит о том, что он должен и не должен делать.",shape=box,color=blue];
		j304573589 -> j1438542641;
	j3195211772 [label="Так вот почему ты стараешься уберечь Лиона от той же участи ? Или тебя просто тревожит сама тема ?",shape=box,color=blue];
		j3195211772 -> j481492906;
		j3195211772 -> j87047670;
	j2823814751 [label="Но даже при этом, когда кто-то рядом с тобой чувствует себя настолько зажатым в своём окружении, что есть только один способ выбраться... ",shape=box,color=blue];
		j2823814751 -> j3195211772;
	j3988718669 [label="Это даёт для него больше, чем просто говорит о том, что он должен и не должен делать.",shape=box,color=blue];
		j3988718669 -> j4090215265;
		j3988718669 -> j280675519;
		j3988718669 -> j787353508;
	j738693288 [label="Ох, я вне себя от радости. Tellement ravie! Лион так нуждается в любви - ты даже не представляешь!",shape=box,color=blue];
		j738693288 -> j1598394363;
	j2355836413 [label="Ах, как будто разговариваешь с de marbre статуей, non ? Я понимаю, что ты чувствуешь. Часто бывало, что я увлекалась историей минут на двадцать, а потом понимала, что он меня даже не слушает.",shape=box,color=blue];
		j2355836413 -> j2897892214;
	j1438542641 [label="Тебе нужно научиться читать между строк, non ? Он говорит историями. Притчами. Если он молчит, прислушайся к языку его тела.",shape=box,color=blue];
		j1438542641 -> j1016638817;
	j481492906 [label="Я... просто прошу, давай не будем об этом. Я не в силах. ",shape=box,color=red];
		j481492906 -> j2976703178;
	j87047670 [label="Мне нужна уверенность, что Лион не пострадает...",shape=box,color=red];
		j87047670 -> j279389600;
	j4090215265 [label="Я сделаю все, что в моих силах, чтобы воспользоваться твоим советом. Я просто не знаю, как ещё до него достучаться.",shape=box,color=red];
		j4090215265 -> j4136836606;
	j280675519 [label="Я сделаю всё, что в моих силах, мне лишь... мне хотелось бы сделать больше.",shape=box,color=red];
		j280675519 -> j2082363253;
	j787353508 [label="Он просто бывает таким... раздражающим.",shape=box,color=red];
		j787353508 -> j4136836606;
	j1598394363 [label="Ах, но может, и понимаешь. Он, как ты замечаешь, страдает, хоть снаружи и не скажешь...",shape=box,color=blue];
		j1598394363 -> j1760736752;
	j2897892214 [label="Снова заблудился в коридорах собственного разума или уделяет внимание какому-то другому esprit в комнате.",shape=box,color=blue];
		j2897892214 -> j2653961649;
	j1016638817 [label="Будь мягче с ним, прояви доброту, et je vous en supplie, не рань его, oui ?",shape=box,color=blue];
		j1016638817 -> j3528338721;
		j1016638817 -> j2388174204;
	j2976703178 [label="Boolean LyonPainOff is now true.",color=orange];
		j2976703178 -> j1475703003;
	j279389600 [label="Boolean LyonPainResolved is now true.",color=orange];
		j279389600 -> j1475703003;
	j4136836606 [label="Ах, как будто разговариваешь с de marbre статуей, non ? Я понимаю, что ты чувствуешь. Часто бывало, что я увлекалась историей минут на двадцать, а потом понимала, что он меня даже не слушает.",shape=box,color=blue];
		j4136836606 -> j2581780536;
	j2082363253 [label="Oui, я понимаю. Но порой мы можем сделать совсем немного. Но просто быть рядом с другими так, как и когда они сами этого хотят.",shape=box,color=blue];
		j2082363253 -> j3942601492;
	j1760736752 [label="Будь мягче с ним, прояви доброту, et je vous en supplie, не рань его, oui ?",shape=box,color=blue];
		j1760736752 -> j2432658306;
	j2653961649 [label="Тебе нужно научиться читать между строк, non ? Он говорит историями. Притчами. Если он молчит, прислушайся к языку его тела.",shape=box,color=blue];
		j2653961649 -> j1760736752;
	j3528338721 [label="Я всё равно не считаю это правильным.",shape=box,color=red];
		j3528338721 -> j231217521;
	j2388174204 [label="Я сделаю всё, что в моих силах.",shape=box,color=red];
		j2388174204 -> j2461342959;
	j1475703003 [label="Разумеется… Хочешь, я расскажу тебе историю о том, кого я знала, кто сделал то же самое ? Или тебе бы больше хотелось, чтобы мы пошли каждый своей дорогой ?",shape=box,color=blue];
		j1475703003 -> j1041171430;
		j1475703003 -> j1855079480;
		j1475703003 -> j733801164;
	j2581780536 [label="Снова заблудился в коридорах собственного разума или уделяет внимание какому-то другому esprit в комнате.",shape=box,color=blue];
		j2581780536 -> j2474273618;
	j3942601492 [label="Сделать больше означало бы раздавить их или их прогнать.",shape=box,color=blue];
		j3942601492 -> j3117076149;
	j2432658306 [label="Вот и всё, чего я прошу. Ох, но я так счастлива ! Мне нужно постараться, чтобы эта пара сложилась!",shape=box,color=blue];
		j2432658306 -> j1341230681;
		j2432658306 -> j1622112468;
		j2432658306 -> j1425455014;
	j231217521 [label="Тогда поговори с ним о своих тревогах. Он выслушает. Он ведь не ребёнок. ",shape=box,color=blue];
		j231217521 -> j2071545470;
	j2461342959 [label="+20 Chemistry",color=orange];
		j2461342959 -> j410896772;
	j1041171430 [label="Давайте на этом закончим. ",shape=box,color=red];
		j1041171430 -> j1858461255;
	j1855079480 [label="Давай лучше вернёмся к разговору о Лионе, ладно?",shape=box,color=red];
		j1855079480 -> j4184327849;
	j733801164 [label="Наверное... мне хотелось бы узнать о них больше.",shape=box,color=red];
		j733801164 -> j2767069790;
	j2474273618 [label="Тебе нужно научиться читать между строк, non ? Он говорит историями. Притчами. Если он молчит, прислушайся к языку его тела.",shape=box,color=blue];
		j2474273618 -> j3117076149;
	j3117076149 [label="Ты ведь заботишься о нём, хочешь помочь — и, я уверена, он это чувствует. Ах! Вот оно что. Он как бездомный пёс со шрамом на лапе. Шрам зажил, но неправильно. Теперь всё ещё ноет и зудит.",shape=box,color=blue];
		j3117076149 -> j1964080891;
	j1341230681 [label="Постой, я не имею в виду, чтобы ты вмешивалась!",shape=box,color=red];
		j1341230681 -> j66337758;
	j1622112468 [label="Стоит ли мне беспокоиться?",shape=box,color=red];
		j1622112468 -> j66337758;
	j1425455014 [label="Мне бы не помешала помощь.",shape=box,color=red];
		j1425455014 -> j3745384427;
	j2071545470 [label="Он как бездомный пёс со шрамом на лапе. Шрам зажил, но неправильно. Теперь всё ещё ноет и зудит.",shape=box,color=blue];
		j2071545470 -> j1964080891;
	j410896772 [label="Merci. Это всё, о чем я могу просить. À bientôt.",shape=box,color=blue];
		j410896772 -> "Chat ends.";
	j1858461255 [label="+20 Chemistry",color=orange];
		j1858461255 -> j3889826157;
	j4184327849 [label="+20 Chemistry",color=orange];
		j4184327849 -> j4224911143;
	j2767069790 [label="Check boolean MarieBackstory1",color=orange];
		j2767069790 -> j3701354470 [label=true,color=green];
		j2767069790 -> j860419100 [label=false,color=brown];
	j1964080891 [label="Он грызёт эту лапу, и хоть это вновь раскрывает рану и причиняет боль, ему становится легче.",shape=box,color=blue];
		j1964080891 -> j3667272785;
	j66337758 [label="Хах! Теперь уже слишком поздно отступать. Мари, au travail! Il y a de l'amour dans l'!",shape=box,color=blue];
		j66337758 -> "Chat ends.";
	j3745384427 [label="Oui! И тебе меня всё равно не удержать, даже если захотелось бы. Мари, приступай к делу!",shape=box,color=blue];
		j3745384427 -> "Chat ends.";
	j3889826157 [label="Oui, конечно. À bientôt.",shape=box,color=blue];
		j3889826157 -> "Chat ends.";
	j4224911143 [label="Oui, конечно.",shape=box,color=blue];
		j4224911143 -> j2071545470;
	j3701354470 [label="Ты знаешь, с чего началась моя история, но есть часть, которую я тебе не рассказала.",shape=box,color=blue];
		j3701354470 -> j2229376764;
	j860419100 [label="Boolean MarieBackstory1 is now true.",color=orange];
		j860419100 -> j3822040022;
	j3667272785 [label="Это причиняет ему боль, но всё же это часть его самого. И если ты подойдёшь к нему avec colère, с раздражением, он вздрогнет от твоего прикосновения.",shape=box,color=blue];
		j3667272785 -> j2681022311;
	j2229376764 [label="Я ведь говорила тебе, что была нищенкой на улицах, когда была jeune fille. И что потом устроила свою жизнь и у меня появилось много друзей.",shape=box,color=blue];
		j2229376764 -> j1509749520;
	j3822040022 [label="Я родилась в богатой семье, что, возможно, удивит тебя. В семье буржуа, которые ближе к Орокин, чем можно подумать.",shape=box,color=blue];
		j3822040022 -> j658557554;
	j2681022311 [label="Нужно завоевать доверие бродячего создания. Пусть он сам придёт к тебе, non ? Понимаешь, что я имею в виду ?",shape=box,color=blue];
		j2681022311 -> j3876020591;
		j2681022311 -> j2237879357;
		j2681022311 -> j4278960509;
	j1509749520 [label="Одним из них был большой мальчик постарше по имени Хьюго.",shape=box,color=blue];
		j1509749520 -> j1227213011;
	j658557554 [label="Но когда я родилась такой… искривлённой, c mes pieds tordus et inutilisables? Ох, ma mère не могла этого допустить.",shape=box,color=blue];
		j658557554 -> j988264284;
	j3876020591 [label="Да, на самом деле. Спасибо.",shape=box,color=red];
		j3876020591 -> j536098198;
	j2237879357 [label="Больше, чем следовало бы, спасибо.",shape=box,color=red];
		j2237879357 -> j223383384;
	j4278960509 [label="Неа. Но спасибо за попытку.",shape=box,color=red];
		j4278960509 -> j4214214068;
	j1227213011 [label="Он был в некотором роде вожаком стаи. И он всегда следил за тем, чтобы никто ни кто меня обижал, и чтобы у меня было всё мне необходимое.",shape=box,color=blue];
		j1227213011 -> j734776308;
	j988264284 [label="Нужно было ведь поддерживать видимость, oui? Следить за стандартами.",shape=box,color=blue];
		j988264284 -> j4206528692;
	j536098198 [label="Bien! Я уже боялась, что опять увлекусь своими метафорами.",shape=box,color=blue];
		j536098198 -> j3913996009;
	j223383384 [label="Мари и её метафоры. Ах, bon.",shape=box,color=blue];
		j223383384 -> j3913996009;
	j4214214068 [label="Mince alors. Вот ведь знала же, снова дала волю своим métaphores.",shape=box,color=blue];
		j4214214068 -> j3913996009;
	j734776308 [label="Он даже помог мне соорудить des béquilles - как ты их там называешь... эх... костыли ? Чтобы я могла передвигаться, используя обрезки дерева, которые мы подобрали.",shape=box,color=blue];
		j734776308 -> j4263288182;
	j4206528692 [label="Итак, что же делать с бедной, искалеченной Мари? Меня отвезли в la Cité de la Lumière, где я, конечно же, погибла бы на улицах...",shape=box,color=blue];
		j4206528692 -> j1630912760;
	j3913996009 [label="Хм. Мне думается, что, возможно, описание Лиона как бродячей собаки - не самое лестное сравнение...",shape=box,color=blue];
		j3913996009 -> j4208521170;
	j4263288182 [label="Однажды утром мы пошли его будить и нашли его -",shape=box,color=blue];
		j4263288182 -> j4280856685;
	j1630912760 [label="И была оставлена умирать.",shape=box,color=blue];
		j1630912760 -> j3412736327;
		j1630912760 -> j1811098478;
	j4208521170 [label="Пожалуй, не стоит говорить ему, что я так сказала, oui?..",shape=box,color=blue];
		j4208521170 -> j1672678032;
	j4280856685 [label="Je... я пощажу тебя подробностями... Я уверена, ты и так можешь догадаться о чём речь.",shape=box,color=blue];
		j4280856685 -> j383738763;
	j3412736327 [label="Сколько тебе было лет?",shape=box,color=red];
		j3412736327 -> j630259880;
	j1811098478 [label="Твоя семья оставила тебя умирать?",shape=box,color=red];
		j1811098478 -> j1704836839;
	j1672678032 [label="Boolean LyonStrayDog is now true.",color=orange];
		j1672678032 -> j653665348;
		j1672678032 -> j285634287;
	j383738763 [label="Но он оставил нам сообщение. Едва разборчивое. Он был единственным из всех детей, кто умел читать и писать, и мне пришлось прочитать его остальным. ",shape=box,color=blue];
		j383738763 -> j1173901600;
	j630259880 [label="Лет шесть? Семь? На их взгляд, они многие годы старались сделать всё возможное, чтобы исцелить меня. Наставники учили меня ходить. Ортезы. Ортопедическая обувь.",shape=box,color=blue];
		j630259880 -> j3549203659;
	j1704836839 [label="На их взгляд, они многие годы старались сделать всё возможное, чтобы исцелить меня. Наставники учили меня ходить. Ортезы. Ортопедическая обувь.",shape=box,color=blue];
		j1704836839 -> j3549203659;
	j653665348 [label="По-моему, это мило, и он тоже так подумает.",shape=box,color=red];
		j653665348 -> j758510050;
	j285634287 [label="Со мной твой секрет под надёжным замком.",shape=box,color=red];
		j285634287 -> j1060793373;
	j1173901600 [label="Я до сих пор помню, как мой голос дрогнул. Но мне нужно было держаться. Потому что даже тогда я понимала, что у меня есть долг перед другими. ",shape=box,color=blue];
		j1173901600 -> j1797459759;
	j3549203659 [label="Они устали от этой обузы. И вот я, едва умея читать и писать самостоятельно цифры и буквы, я очутилась среди уличной грязи.",shape=box,color=blue];
		j3549203659 -> j891008651;
		j3549203659 -> j953636700;
	j758510050 [label="Quelle horrible personne ! J'espère que votre chaise va s'effondrer et vous donner plein d'échardes douloureuses !",shape=box,color=blue];
		j758510050 -> "Chat ends.";
	j1060793373 [label="Merci! Какое облегчение...",shape=box,color=blue];
		j1060793373 -> "Chat ends.";
	j1797459759 [label="Они говорили мне, что Хьюго всегда казался нам таким жизнерадостным. Si joyeux. Всегда смеялся, всегда шутил над жизнью.",shape=box,color=blue];
		j1797459759 -> j647578249;
	j891008651 [label="Это ужасно.",shape=box,color=red];
		j891008651 -> j714426695;
	j953636700 [label="Как тебе удалось выжить?",shape=box,color=red];
		j953636700 -> j714426695;
	j647578249 [label="Даже когда нас прогоняли или его били палкой за воровство или шатание без дела, казалось, его это ничуть не беспокоило.",shape=box,color=blue];
		j647578249 -> j3409467309;
	j714426695 [label="Check boolean MarieSecretPower",color=orange];
		j714426695 -> j1609012870 [label=true,color=green];
		j714426695 -> j592962764 [label=false,color=brown];
	j3409467309 [label="Но мы ведь никогда не знаем, насколько глубока боль в сердцах других. И из этого оставленного сообщения я поняла, что он плакал вместе с Луа.",shape=box,color=blue];
		j3409467309 -> j2140543108;
	j1609012870 [label="Всё было так, как и было сказано тобой, non ? В каждом неудобстве скрыта своя сила.",shape=box,color=blue];
		j1609012870 -> j592962764;
	j592962764 [label="То, что сделало меня indésirable pour ma mère, сделало меня весьма популярной среди детей улицы.",shape=box,color=blue];
		j592962764 -> j1992355931;
	j2140543108 [label="Но теперь он обрёл покой рядом с ней. Какое-то время я обижалась на него за то, что он ушёл. Ведь остальные смотрели на меня в поисках опоры. И я затаила обиду на него за то, что он бросил меня.",shape=box,color=blue];
		j2140543108 -> j800322396;
	j1992355931 [label="Что может быть более pathétique, чем ребёнок без pieds, oui? Я могла заработать за день с открытыми ладонями больше, чем они успевали украсть за неделю.",shape=box,color=blue];
		j1992355931 -> j2510555322;
	j800322396 [label="Но со временем я пришла к пониманию одной истины.",shape=box,color=blue];
		j800322396 -> j621012557;
	j2510555322 [label="И я всегда был склонна делиться. Поэтому у меня и было много друзей, которые присматривали за мной, заботились обо мне. Одним из них был большой мальчик постарше по имени Хьюго.",shape=box,color=blue];
		j2510555322 -> j1227213011;
	j621012557 [label="Мы можем простить себя только за то, что мы люди. И простить себе боль от их ухода.",shape=box,color=blue];
		j621012557 -> j875424167;
	j875424167 [label="Ведь боль именно от их отсутствие причиняется нам. И от чувства, что мы не сумели помочь им достаточно.",shape=box,color=blue];
		j875424167 -> j2471827104;
	j2471827104 [label="Мы никогда не узнаем о бремени, которое несут другие.",shape=box,color=blue];
		j2471827104 -> j1699023053;
	j1699023053 [label="И это большая tragédie. Но именно это и значит быть человеком.",shape=box,color=blue];
		j1699023053 -> j1240159793;
	j1240159793 [label="Не знаю, послужил ли тебе мой рассказ утешением. Но я надеюсь на это. Мне нужно идти, Monsieur Лойд зовёт.",shape=box,color=blue];
		j1240159793 -> j2651869698;
		j1240159793 -> j3098522841;
	j2651869698 [label="Спасибо, Мари.",shape=box,color=red];
		j2651869698 -> j1613814033;
	j3098522841 [label="[Промолчать.]",shape=box,color=red];
		j3098522841 -> j3386425480;
	j1613814033 [label="+20 Chemistry",color=orange];
		j1613814033 -> j1342569429;
	j3386425480 [label="+20 Chemistry",color=orange];
		j3386425480 -> j1123121321;
	j1342569429 [label="Всегда пожалуйста. À bientôt.",shape=box,color=blue];
		j1342569429 -> "Chat ends.";
	j1123121321 [label="À la revoyure.",shape=box,color=blue];
		j1123121321 -> "Chat ends.";
}