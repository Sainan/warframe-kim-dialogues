		2065 -> 2073;
	2066 [label="Хах! Теперь уже слишком поздно отступать. Мари, au travail! Il y a de l'amour dans l'!",shape=box,color=blue];
		2066 -> 2074;
	2067 [label="Oui! И тебе меня всё равно не удержать, даже если захотелось бы. Мари, приступай к делу!",shape=box,color=blue];
		2067 -> 2075;
