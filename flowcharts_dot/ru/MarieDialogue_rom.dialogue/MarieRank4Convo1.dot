	2024 [label="Так вот почему ты стараешься уберечь Лиона от той же участи ? Или тебя просто тревожит сама тема ?",shape=box,color=blue];
		2024 -> 2030;
		2024 -> 2031;
	2025 [label="Но даже при этом, когда кто-то рядом с тобой чувствует себя настолько зажатым в своём окружении, что есть только один способ выбраться... ",shape=box,color=blue];
		2025 -> 2024;
