		2031 -> 2039;
	2032 [label="Я сделаю все, что в моих силах, чтобы воспользоваться твоим советом. Я просто не знаю, как ещё до него достучаться.",shape=box,color=red];
		2032 -> 2040;
	2033 [label="Я сделаю всё, что в моих силах, мне лишь... мне хотелось бы сделать больше.",shape=box,color=red];
		2033 -> 2041;
	2034 [label="Он просто бывает таким... раздражающим.",shape=box,color=red];
		2034 -> 2040;
	2035 [label="Ах, но может, и понимаешь. Он, как ты замечаешь, страдает, хоть снаружи и не скажешь...",shape=box,color=blue];
		2035 -> 2042;
	2036 [label="Снова заблудился в коридорах собственного разума или уделяет внимание какому-то другому esprit в комнате.",shape=box,color=blue];
		2036 -> 2043;
	2037 [label="Будь мягче с ним, прояви доброту, et je vous en supplie, не рань его, oui ?",shape=box,color=blue];
