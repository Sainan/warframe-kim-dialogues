		2026 -> 2032;
		2026 -> 2033;
		2026 -> 2034;
	2027 [label="Ох, я вне себя от радости. Tellement ravie! Лион так нуждается в любви - ты даже не представляешь!",shape=box,color=blue];
		2027 -> 2035;
	2028 [label="Ах, как будто разговариваешь с de marbre статуей, non ? Я понимаю, что ты чувствуешь. Часто бывало, что я увлекалась историей минут на двадцать, а потом понимала, что он меня даже не слушает.",shape=box,color=blue];
		2028 -> 2036;
	2029 [label="Тебе нужно научиться читать между строк, non ? Он говорит историями. Притчами. Если он молчит, прислушайся к языку его тела.",shape=box,color=blue];
		2029 -> 2037;
	2030 [label="Я... просто прошу, давай не будем об этом. Я не в силах. ",shape=box,color=red];
		2030 -> 2038;
