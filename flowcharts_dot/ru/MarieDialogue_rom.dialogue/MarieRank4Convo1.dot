	j3023005664 [label="Давай лучше вернёмся к разговору о Лионе, ладно?",shape=box,color=red];
		j3023005664 -> j2354543051;
	j733801164 [label="Наверное... мне хотелось бы узнать о них больше.",shape=box,color=red];
		j733801164 -> j2767069790;
	j2752162220 [label="Тебе нужно научиться читать между строк, non? Он говорит историями. Притчами. Если он молчит, прислушайся к языку его тела.",shape=box,color=blue];
		j2752162220 -> j1737729889;
	j1737729889 [label="Ты ведь заботишься о нём, хочешь помочь — и, я уверена, он это чувствует. Ах! Вот оно что. Он как бездомный пёс со шрамом на лапе. Шрам зажил, но неправильно. Теперь всё ещё ноет и зудит.",shape=box,color=blue];
		j1737729889 -> j3856930608;
	j2595691466 [label="Постой, я не имею в виду, чтобы ты вмешивалась!",shape=box,color=red];
		j2595691466 -> j1326007606;
	j728685592 [label="Стоит ли мне беспокоиться?",shape=box,color=red];
		j728685592 -> j1326007606;
	j1425455014 [label="Мне бы не помешала помощь.",shape=box,color=red];
		j1425455014 -> j3745384427;
	j3701117064 [label="Он как бездомный пёс со шрамом на лапе. Шрам зажил, но неправильно. Теперь всё ещё ноет и зудит.",shape=box,color=blue];
		j3701117064 -> j3856930608;
	j410896772 [label="Merci. Это всё, о чем я могу просить. À bientôt.",shape=box,color=blue];
		j410896772 -> "Chat ends.";
	j1858461255 [label="+20 Chemistry",color=orange];
		j1858461255 -> j3889826157;
	j2354543051 [label="+20 Chemistry",color=orange];
		j2354543051 -> j4273840202;
	j2767069790 [label="Check boolean MarieBackstory1",color=orange];
		j2767069790 -> j3769210228 [label=true,color=green];
		j2767069790 -> j860419100 [label=false,color=brown];
	j3856930608 [label="Он грызёт эту лапу, и хоть это вновь раскрывает рану и причиняет боль, ему становится легче.",shape=box,color=blue];
		j3856930608 -> j640586281;
	j1326007606 [label="Хах! Теперь уже слишком поздно отступать. Мари, au travail! Il y a de l'amour dans l'air !",shape=box,color=blue];
		j1326007606 -> "Chat ends.";
	j3745384427 [label="Oui! И тебе меня всё равно не удержать, даже если захотелось бы. Мари, приступай к делу!",shape=box,color=blue];
		j3745384427 -> "Chat ends.";
	j3889826157 [label="Oui, конечно. À bientôt.",shape=box,color=blue];
		j3889826157 -> "Chat ends.";
	j4273840202 [label="Oui, конечно.",shape=box,color=blue];
		j4273840202 -> j3701117064;
	j3769210228 [label="Ты знаешь, с чего началась моя история, но есть часть, которую я тебе не рассказала.",shape=box,color=blue];
		j3769210228 -> j3812362497;
	j860419100 [label="Boolean MarieBackstory1 is now true.",color=orange];
		j860419100 -> j3822040022;
	j640586281 [label="Это причиняет ему боль, но всё же это часть его самого. И если ты подойдёшь к нему avec colère, с раздражением, он вздрогнет от твоего прикосновения.",shape=box,color=blue];
		j640586281 -> j2559699374;
	j3812362497 [label="Я ведь говорила тебе, что была нищенкой на улицах, когда была jeune fille. И что потом устроила свою жизнь и у меня появилось много друзей.",shape=box,color=blue];
		j3812362497 -> j1938958407;
	j3822040022 [label="Я родилась в богатой семье, что, возможно, удивит тебя. В семье буржуа, которые ближе к Орокин, чем можно подумать.",shape=box,color=blue];
		j3822040022 -> j658557554;
	j2559699374 [label="Нужно завоевать доверие бродячего создания. Пусть он сам придёт к тебе, non? Понимаешь, что я имею в виду?",shape=box,color=blue];
		j2559699374 -> j3876020591;
		j2559699374 -> j2237879357;
		j2559699374 -> j4278960509;
	j1938958407 [label="Одним из них был большой мальчик постарше по имени Хьюго.",shape=box,color=blue];
		j1938958407 -> j2231134242;
	j658557554 [label="Но когда я родилась такой… искривлённой, c mes pieds tordus et inutilisables? Ох, ma mère не могла этого допустить.",shape=box,color=blue];
		j658557554 -> j988264284;
	j3876020591 [label="Да, на самом деле. Спасибо.",shape=box,color=red];
		j3876020591 -> j536098198;
	j2237879357 [label="Больше, чем следовало бы, спасибо.",shape=box,color=red];
		j2237879357 -> j223383384;
	j4278960509 [label="Неа. Но спасибо за попытку.",shape=box,color=red];
		j4278960509 -> j4214214068;
	j2231134242 [label="Он был в некотором роде вожаком стаи. И он всегда следил за тем, чтобы никто меня не обижал, и чтобы у меня было всё мне необходимое.",shape=box,color=blue];
		j2231134242 -> j9961428;
	j988264284 [label="Нужно было ведь поддерживать видимость, oui? Следить за стандартами.",shape=box,color=blue];
		j988264284 -> j4206528692;
	j536098198 [label="Bien! Я уже боялась, что опять увлекусь своими метафорами.",shape=box,color=blue];
		j536098198 -> j3913996009;
	j223383384 [label="Мари и её метафоры. Ах, bon.",shape=box,color=blue];
		j223383384 -> j3913996009;
	j4214214068 [label="Mince alors. Вот ведь знала же, снова дала волю своим métaphores.",shape=box,color=blue];
		j4214214068 -> j3913996009;
	j9961428 [label="Он даже помог мне соорудить des béquilles - как ты их там называешь... эх... костыли? Чтобы я могла передвигаться, используя обрезки дерева, которые мы подобрали.",shape=box,color=blue];
		j9961428 -> j4239152781;
	j4206528692 [label="Итак, что же делать с бедной, искалеченной Мари? Меня отвезли в la Cité de la Lumière, где я, конечно же, погибла бы на улицах...",shape=box,color=blue];
		j4206528692 -> j1630912760;
	j3913996009 [label="Хм. Мне думается, что, возможно, описание Лиона как бродячей собаки - не самое лестное сравнение...",shape=box,color=blue];
		j3913996009 -> j4208521170;
	j4239152781 [label="Однажды утром мы пошли его будить и нашли его -",shape=box,color=blue];
		j4239152781 -> j630926070;
	j1630912760 [label="И была оставлена умирать.",shape=box,color=blue];
		j1630912760 -> j3412736327;
		j1630912760 -> j1811098478;
	j4208521170 [label="Пожалуй, не стоит говорить ему, что я так сказала, oui?..",shape=box,color=blue];
		j4208521170 -> j1672678032;
	j630926070 [label="Je... я пощажу тебя подробностями... Я уверена, ты и так можешь догадаться о чём речь.",shape=box,color=blue];
		j630926070 -> j3354141209;
	j3412736327 [label="Сколько тебе было лет?",shape=box,color=red];
		j3412736327 -> j630259880;
	j1811098478 [label="Твоя семья оставила тебя умирать?",shape=box,color=red];
		j1811098478 -> j1704836839;
	j1672678032 [label="Boolean LyonStrayDog is now true.",color=orange];
		j1672678032 -> j653665348;
		j1672678032 -> j285634287;
	j3354141209 [label="Но он оставил нам сообщение. Едва разборчивое. Он был единственным из всех детей, кто умел читать и писать, и мне пришлось прочитать его остальным. ",shape=box,color=blue];
		j3354141209 -> j680464642;
	j630259880 [label="Лет шесть? Семь? На их взгляд, они многие годы старались сделать всё возможное, чтобы исцелить меня. Наставники учили меня ходить. Ортезы. Ортопедическая обувь.",shape=box,color=blue];
		j630259880 -> j3549203659;
	j1704836839 [label="На их взгляд, они многие годы старались сделать всё возможное, чтобы исцелить меня. Наставники учили меня ходить. Ортезы. Ортопедическая обувь.",shape=box,color=blue];
		j1704836839 -> j3549203659;
	j653665348 [label="По-моему, это мило, и он тоже так подумает.",shape=box,color=red];
		j653665348 -> j758510050;
	j285634287 [label="Со мной твой секрет под надёжным замком.",shape=box,color=red];
		j285634287 -> j1060793373;
	j680464642 [label="Я до сих пор помню, как мой голос дрогнул. Но мне нужно было держаться. Потому что даже тогда я понимала, что у меня есть долг перед другими. ",shape=box,color=blue];
		j680464642 -> j833803204;
	j3549203659 [label="Они устали от этой обузы. И вот я, едва умея читать и писать самостоятельно цифры и буквы, я очутилась среди уличной грязи.",shape=box,color=blue];
		j3549203659 -> j891008651;
		j3549203659 -> j953636700;
	j758510050 [label="Quelle horrible personne ! J'espère que votre chaise va s'effondrer et vous donner plein d'échardes douloureuses !",shape=box,color=blue];
		j758510050 -> "Chat ends.";
	j1060793373 [label="Merci! Какое облегчение...",shape=box,color=blue];
		j1060793373 -> "Chat ends.";
	j833803204 [label="Они говорили мне, что Хьюго всегда казался нам таким жизнерадостным. Si joyeux. Всегда смеялся, всегда шутил над жизнью.",shape=box,color=blue];
		j833803204 -> j1722716913;
	j891008651 [label="Это ужасно.",shape=box,color=red];
		j891008651 -> j714426695;
	j953636700 [label="Как тебе удалось выжить?",shape=box,color=red];
		j953636700 -> j714426695;
	j1722716913 [label="Даже когда нас прогоняли или его били палкой за воровство или шатание без дела, казалось, его это ничуть не беспокоило.",shape=box,color=blue];
		j1722716913 -> j1881942575;
	j714426695 [label="Check boolean MarieSecretPower",color=orange];
		j714426695 -> j4203022185 [label=true,color=green];
		j714426695 -> j980836052 [label=false,color=brown];
	j1881942575 [label="Но мы ведь никогда не знаем, насколько глубока боль в сердцах других. И из этого оставленного сообщения я поняла, что он плакал вместе с Луа.",shape=box,color=blue];
		j1881942575 -> j3296429694;
	j4203022185 [label="Всё было так, как и было сказано тобой, non? В каждом неудобстве скрыта своя сила.",shape=box,color=blue];
		j4203022185 -> j980836052;
	j980836052 [label="То, что сделало меня indésirable pour ma mère, сделало меня весьма популярной среди детей улицы.",shape=box,color=blue];
		j980836052 -> j1841920623;
	j3296429694 [label="Но теперь он обрёл покой рядом с ней. Какое-то время я обижалась на него за то, что он ушёл. Ведь остальные смотрели на меня в поисках опоры. И я затаила обиду на него за то, что он бросил меня.",shape=box,color=blue];
		j3296429694 -> j939118697;
	j1841920623 [label="Что может быть более pathétique, чем ребёнок без pieds, oui? Я могла заработать за день с открытыми ладонями больше, чем они успевали украсть за неделю.",shape=box,color=blue];
		j1841920623 -> j1636140211;
	j939118697 [label="Но со временем я пришла к пониманию одной истины.",shape=box,color=blue];
		j939118697 -> j1359924331;
	j1636140211 [label="И я всегда был склонна делиться. Поэтому у меня и было много друзей, которые присматривали за мной, заботились обо мне. Одним из них был большой мальчик постарше по имени Хьюго.",shape=box,color=blue];
		j1636140211 -> j2231134242;
	j1359924331 [label="Мы можем простить себя только за то, что мы люди. И простить себе боль от их ухода.",shape=box,color=blue];
		j1359924331 -> j2841624219;
	j2841624219 [label="Именно их отсутствие причиняет нам боль. И мысль о том, что мы не смогли сделать больше, чтобы им помочь.",shape=box,color=blue];
		j2841624219 -> j2471827104;
	j2471827104 [label="Мы никогда не узнаем о бремени, которое несут другие.",shape=box,color=blue];
		j2471827104 -> j1699023053;
	j1699023053 [label="И это большая tragédie. Но именно это и значит быть человеком.",shape=box,color=blue];
		j1699023053 -> j1240159793;
	j1240159793 [label="Не знаю, послужил ли тебе мой рассказ утешением. Но я надеюсь на это. Мне нужно идти, Monsieur Лойд зовёт.",shape=box,color=blue];
		j1240159793 -> j2651869698;
		j1240159793 -> j3098522841;
	j2651869698 [label="Спасибо, Мари.",shape=box,color=red];
		j2651869698 -> j1613814033;
	j3098522841 [label="[Промолчать.]",shape=box,color=red];
		j3098522841 -> j3386425480;
	j1613814033 [label="+20 Chemistry",color=orange];
		j1613814033 -> j1342569429;
	j3386425480 [label="+20 Chemistry",color=orange];
		j3386425480 -> j1123121321;
	j1342569429 [label="Всегда пожалуйста. À bientôt.",shape=box,color=blue];
		j1342569429 -> "Chat ends.";
	j1123121321 [label="À la revoyure.",shape=box,color=blue];
		j1123121321 -> "Chat ends.";
}