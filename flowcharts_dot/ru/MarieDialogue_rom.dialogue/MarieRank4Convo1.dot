		j738506989 -> j25627000 [label="false",color=purple];
	j2329809322 [label="[Отключите все разговоры о членовредительстве. Вы не потеряете очки симпатии ни с одним персонажем.]",shape=box,color=red];
		j2329809322 -> j982025565;
	j2153559420 [label="Честно говоря, я не знаю, было бы лучше, чтобы эти его видения были настоящими или фальшивыми.",shape=box,color=red];
		j2153559420 -> j2627360344;
	j1498129589 [label="Когда он говорит о всех тех ужасных вещах, что ему доводится видеть. Его описания...",shape=box,color=red];
		j1498129589 -> j2627360344;
	j1079694227 [label="Что однажды он может причинить себе вред так, что пути обратно уже не будет?",shape=box,color=red];
		j1079694227 -> j2628304435;
	j25627000 [label="Бывает ли, что ты чувствуешь себя небезопасно в его присутствии? Что он способен навредить тебе, даже не понимая этого?",shape=box,color=red];
		j25627000 -> j3212700568;
	j982025565 [label="Boolean LyonPainOff is now true.",color=orange];
		j982025565 -> j1254492242;
	j2627360344 [label="+5 Chemistry",color=orange];
		j2627360344 -> j2167062712;
	j2628304435 [label="Ах... это неловкая тема, oui? Pardon, но я не совсем знаю, как об этом говорить, не запутавшись в собственных словах.",shape=box,color=blue];
		j2628304435 -> j3509256174;
	j3212700568 [label="Я верю, что Лион скорее лишит себя жизни, чем причинит мне вреда. У меня есть вера, во всех богов и дьяволов...",shape=box,color=blue];
		j3212700568 -> j83051675;
	j1254492242 [label="+20 Chemistry",color=orange];
		j1254492242 -> j1534304376;
	j2167062712 [label="Кошмары, которые наполняют его разум - Луа направляет его по трудному пути, oui?",shape=box,color=blue];
		j2167062712 -> j2235105403;
	j3509256174 [label="Но я сделаю всё, что в моих силах. Я полагаю, ты спрашиваешь из-за беспокойства о нём?",shape=box,color=blue];
		j3509256174 -> j326629071;
		j3509256174 -> j4132818251;
	j83051675 [label="- что даже твоё Indifférence не смогло заставить его настолько, чтобы он осмелился поднять на руку меня.",shape=box,color=blue];
		j83051675 -> j2425497027;
	j1534304376 [label="[Это позволит все диалоги о членовредительстве обходить стороной.]",shape=box,color=blue];
		j1534304376 -> "Chat ends.";
	j2235105403 [label="Боюсь, об этом трудно говорить. Потому что я знаю, что этого не должно быть, oui?",shape=box,color=blue];
		j2235105403 -> j671849401;
	j326629071 [label="Известно, что Варфрейм, которому дали сыворотку... ну...",shape=box,color=red];
		j326629071 -> j810312764;
		j326629071 -> j2212677162;
		j326629071 -> j653890609;
	j4132818251 [label="Это довольно очевидно, стоит только на него взглянуть... без обид. Нетрудно было догадаться.",shape=box,color=red];
		j4132818251 -> j810312764;
		j4132818251 -> j2212677162;
		j4132818251 -> j653890609;
	j2425497027 [label="Скорее поверю, что бабочка способна devour меня без остатка, чем испугаюсь брата своей души.",shape=box,color=blue];
		j2425497027 -> j2235105403;
	j671849401 [label="Мне хотелось бы остановить его. Уберечь от этого его стремления причинить себе такой вред.",shape=box,color=blue];
		j671849401 -> j1183898543;
	j810312764 [label="Я лишь беспокоюсь, что однажды он может зайти слишком далеко.",shape=box,color=red];
		j810312764 -> j2235105403;
	j2212677162 [label="Он нужен нам целым и невредимым.",shape=box,color=red];
		j2212677162 -> j3747844951;
	j653890609 [label="Я не хочу переживать из-за того, что мне придётся убирать его труп.",shape=box,color=red];
		j653890609 -> j698283448;
	j1183898543 [label="Если есть что-то, в чём у меня есть уверенность насчёт Лиона, так это в том, что он всегда будет рядом, когда понадобится.",shape=box,color=blue];
		j1183898543 -> j1013300748;
	j3747844951 [label="Ты эхом отдаёшь слова дьявола. Неужели тебя вдохновляет лишь холодная нужда в чьих-то умелых руках?",shape=box,color=blue];
		j3747844951 -> j1004685545;
		j3747844951 -> j184362862;
	j698283448 [label="Dégoûtant.",shape=box,color=blue];
		j698283448 -> j1508231473;
	j1013300748 [label="Он великий защитник, le bouclier sacré de Lua.... Сияющий свет во тьме ночи.",shape=box,color=blue];
		j1013300748 -> j2809436599;
	j1004685545 [label="Нет, я очень за него переживаю. Просто я переживаю, что, когда он нам понадобится, его не будет рядом.",shape=box,color=red];
		j1004685545 -> j1183898543;
	j184362862 [label="Мне лишь нужно знать, могу ли я на него рассчитывать или он уже слишком сломлен.",shape=box,color=red];
		j184362862 -> j1210539792;
	j1508231473 [label="Boolean MarieNoDate is now true.",color=orange];
		j1508231473 -> "Chat ends.";
	j2809436599 [label="Боль, которую он причиняет себе... он делает это, чтобы услышать собственные мысли. Чтобы почувствовать своё тело. ",shape=box,color=blue];
		j2809436599 -> j2726103416;
	j1210539792 [label="Интересно, кто поможет тебе, когда ты окажешься в затруднительном положении и будешь нуждаться в помощи.",shape=box,color=blue];
		j1210539792 -> j590985574;
	j2726103416 [label="Ибо небо усыпано звёздами, и каждая из них шепчет ему, а он, как и сама Луа, теряется среди них.",shape=box,color=blue];
		j2726103416 -> j2791300789;
	j590985574 [label="Или ты полагаешь, что время уже пришло и прошло, и теперь ты выше подобного упрека?",shape=box,color=blue];
		j590985574 -> j698283448;
	j2791300789 [label="И подобно Луа, он проходит через свои фазы. Его поглощает Бездна, чтобы потом сиять так ярко, что мы можем идти во тьме без страха.",shape=box,color=blue];
		j2791300789 -> j2303065669;
	j2303065669 [label="Но, как и любое благословение, оно несёт с собой проклятие. Слышен ли в моих словах хоть какой-то смысл? Боюсь, я просто несу чепуху.",shape=box,color=blue];
		j2303065669 -> j4056151493;
		j2303065669 -> j212812291;
		j2303065669 -> j1162531794;
		j2303065669 -> j871429733;
		j2303065669 -> j2408425503;
	j4056151493 [label="Я всё прекрасно понимаю. И мне нужно… кое в чём признаться. [Признаться в чувствах к Лиону.]",shape=box,color=red];
		j4056151493 -> j3922663500;
	j212812291 [label="Я понимаю, о чём ты говоришь, но я не могу оправдать его поступок. Он должен остановиться.",shape=box,color=red];
		j212812291 -> j2482795532;
	j1162531794 [label="[Предупреждение: обсуждение самоубийства.] Я однажды потеряла человека из-за подобного самоповреждения. Я не могу... я не могу это оправдать.",shape=box,color=red];
		j1162531794 -> j88584593;
	j871429733 [label="Должен быть другой путь.",shape=box,color=red];
		j871429733 -> j2261274227;
	j2408425503 [label="Ты всё говоришь совершенно логично. Мне просто... хотелось бы ему помочь.",shape=box,color=red];
		j2408425503 -> j2261274227;
	j3922663500 [label="Boolean DrifterLyon is now true.",color=orange];
		j3922663500 -> j1548776478;
	j2482795532 [label="Boolean DrifterHarmStop is now true.",color=orange];
		j2482795532 -> j3178109370;
	j88584593 [label="Boolean DrifterHarmLoss is now true.",color=orange];
		j88584593 -> j2172387227;
	j2261274227 [label="Boolean DrifterHarmHelp is now true.",color=orange];
		j2261274227 -> j4015407045;
	j1548776478 [label="Я боюсь, что он... завладел моим сердцем, и оно разрывается от осознания того, что ему больно.",shape=box,color=red];
		j1548776478 -> j944704724;
	j3178109370 [label="Его страдания куда глубже тех ран, что он причиняет своей плоти. То, что он делает с собой теперь, уже не отпустит его.",shape=box,color=blue];
		j3178109370 -> j2265614703;
	j2172387227 [label="О! Я не знала, мне так, так жаль... Какие бы жалкие попытки утешения и молитвы я бы ни произнесла, они всё равно покажутся пустыми, я уверена...",shape=box,color=blue];
		j2172387227 -> j1031170968;
	j4015407045 [label="+20 Chemistry",color=orange];
		j4015407045 -> j126435539;
	j944704724 [label="+20 Chemistry",color=orange];
		j944704724 -> j2592836597;
	j2265614703 [label="Это проясняет его разум, успокаивает душу. И теперь, как протофрейм - как отчасти этот... Харроу, как я отчасти Висп, это его не убьёт, да? ",shape=box,color=blue];
		j2265614703 -> j1873560884;
		j2265614703 -> j1669450034;
	j1031170968 [label="- ведь какие condoléances может выразить тот, кто едва тебе знаком, которые могли бы стать бальзамом на душу после такой трагедии?",shape=box,color=blue];
		j1031170968 -> j3238867601;
	j126435539 [label="И за это я не могу не восхищаться тобой ещё больше. Но форма помощи может быть разной, non?",shape=box,color=blue];
		j126435539 -> j3788924436;
	j2592836597 [label="Ох!! Я только что закричала, словно увидела мышь, и напугала Monsieur Лойда! Pardon!!",shape=box,color=blue];
		j2592836597 -> j3965606651;
	j1873560884 [label="Нет, это не убьёт его. Но всё равно так нельзя.",shape=box,color=red];
		j1873560884 -> j1339310291;
	j1669450034 [label="Пожалуй, я понимаю твою точку зрения.",shape=box,color=red];
		j1669450034 -> j4125251312;
	j3238867601 [label="Эта душа, о потере которой ты говоришь… она была тебе близка?",shape=box,color=blue];
		j3238867601 -> j642575735;
		j3238867601 -> j3287704204;
	j3788924436 [label="Иногда помочь птенцу значит погубить его. Помочь пламени свечи может означать задуть его в твоей exubérance.",shape=box,color=blue];
		j3788924436 -> j842179784;
	j3965606651 [label="Ох, но это же чудесная новость!",shape=box,color=blue];
		j3965606651 -> j501899887;
		j3965606651 -> j4119939799;
	j1339310291 [label="Я поняла, что быть рядом с ним, когда он нуждается во мне... слушать его, обнимать его, когда он плачет?",shape=box,color=blue];
		j1339310291 -> j3368875003;
	j4125251312 [label="+10 Chemistry",color=orange];
		j4125251312 -> j842179784;
	j642575735 [label="Да.",shape=box,color=red];
		j642575735 -> j1947130787;
	j3287704204 [label="Не очень.",shape=box,color=red];
		j3287704204 -> j106500825;
	j842179784 [label="Я поняла, что быть рядом с ним, когда он нуждается во мне... слушать его, просто сидеть рядом с ним, когда он плачет?",shape=box,color=blue];
		j842179784 -> j3988718669;
	j501899887 [label="Правда? Мне неизвестно было твоё отношение к этому.",shape=box,color=red];
		j501899887 -> j3426114380;
	j4119939799 [label="Мне бы только хотелось знать, выносит ли он моё присутствие или нет...",shape=box,color=red];
		j4119939799 -> j900504161;
	j3368875003 [label="Это даёт для него больше, чем просто говорит о том, что он должен и не должен делать.",shape=box,color=blue];
		j3368875003 -> j4142346394;
	j1947130787 [label="Так вот почему ты стараешься уберечь Лиона от той же участи ? Или тебя просто тревожит сама тема?",shape=box,color=blue];
		j1947130787 -> j2488945507;
		j1947130787 -> j3211208641;
	j106500825 [label="Но даже при этом, когда кто-то рядом с тобой чувствует себя настолько зажатым в своём окружении, что есть только один способ выбраться... ",shape=box,color=blue];
		j106500825 -> j1947130787;
	j3988718669 [label="Это даёт для него больше, чем просто говорит о том, что он должен и не должен делать.",shape=box,color=blue];
		j3988718669 -> j4184874843;
		j3988718669 -> j83648484;
		j3988718669 -> j2800133246;
	j3426114380 [label="Ох, я вне себя от радости. Tellement ravie! Лион так нуждается в любви - ты даже не представляешь!",shape=box,color=blue];
		j3426114380 -> j905437698;
	j900504161 [label="Ах, как будто разговариваешь с de marbre статуей, non? Я понимаю, что ты чувствуешь. Часто бывало, что я увлекалась историей минут на двадцать, а потом понимала, что он меня даже не слушает.",shape=box,color=blue];
		j900504161 -> j3033807890;
	j4142346394 [label="Тебе нужно научиться читать между строк, non? Он говорит историями. Притчами. Если он молчит, прислушайся к языку его тела.",shape=box,color=blue];
		j4142346394 -> j1009132837;
	j2488945507 [label="Я... просто прошу, давай не будем об этом. Я не в силах. ",shape=box,color=red];
		j2488945507 -> j1642353090;
	j3211208641 [label="Мне нужна уверенность, что Лион не пострадает...",shape=box,color=red];
		j3211208641 -> j1709222970;
	j4184874843 [label="Я сделаю все, что в моих силах, чтобы воспользоваться твоим советом. Я просто не знаю, как ещё до него достучаться.",shape=box,color=red];
		j4184874843 -> j3857129502;
	j83648484 [label="Я сделаю всё, что в моих силах, мне лишь... мне хотелось бы сделать больше.",shape=box,color=red];
		j83648484 -> j1958897754;
	j2800133246 [label="Он просто бывает таким... раздражающим.",shape=box,color=red];
		j2800133246 -> j3857129502;
	j905437698 [label="Ах, но может, и понимаешь. Он, как ты замечаешь, страдает, хоть снаружи и не скажешь...",shape=box,color=blue];
		j905437698 -> j2315040283;
	j3033807890 [label="Снова заблудился в коридорах собственного разума или уделяет внимание какому-то другому esprit в комнате.",shape=box,color=blue];
		j3033807890 -> j1733216459;
	j1009132837 [label="Будь мягче с ним, прояви доброту, et je vous en supplie, не рань его, oui?",shape=box,color=blue];
		j1009132837 -> j1206697325;
		j1009132837 -> j2388174204;
	j1642353090 [label="Boolean LyonPainOff is now true.",color=orange];
		j1642353090 -> j571499690;
	j1709222970 [label="Boolean LyonPainResolved is now true.",color=orange];
		j1709222970 -> j571499690;
	j3857129502 [label="Ах, как будто разговариваешь с de marbre статуей, non? Я понимаю, что ты чувствуешь. Часто бывало, что я увлекалась историей минут на двадцать, а потом понимала, что он меня даже не слушает.",shape=box,color=blue];
		j3857129502 -> j2382152762;
	j1958897754 [label="Oui, я понимаю. Но порой мы можем сделать совсем немного. Но просто быть рядом с другими так, как и когда они сами этого хотят.",shape=box,color=blue];
		j1958897754 -> j367068056;
	j2315040283 [label="Будь мягче с ним, прояви доброту, et je vous en supplie, не рань его, oui?",shape=box,color=blue];
		j2315040283 -> j1180276336;
	j1733216459 [label="Тебе нужно научиться читать между строк, non? Он говорит историями. Притчами. Если он молчит, прислушайся к языку его тела.",shape=box,color=blue];
		j1733216459 -> j2315040283;
	j1206697325 [label="Я всё равно не считаю это правильным.",shape=box,color=red];
		j1206697325 -> j2654702102;
	j2388174204 [label="Я сделаю всё, что в моих силах.",shape=box,color=red];
		j2388174204 -> j2461342959;
	j571499690 [label="Разумеется… Хочешь, я расскажу тебе историю о том, кого я знала, кто сделал то же самое? Или тебе бы больше хотелось, чтобы мы пошли каждый своей дорогой?",shape=box,color=blue];
		j571499690 -> j1041171430;
		j571499690 -> j3023005664;
		j571499690 -> j733801164;
	j2382152762 [label="Снова заблудился в коридорах собственного разума или уделяет внимание какому-то другому esprit в комнате.",shape=box,color=blue];
		j2382152762 -> j2752162220;
	j367068056 [label="Сделать больше означало бы раздавить их или их прогнать.",shape=box,color=blue];
		j367068056 -> j1737729889;
	j1180276336 [label="Вот и всё, чего я прошу. Ох, но я так счастлива! Мне нужно постараться, чтобы эта пара сложилась!",shape=box,color=blue];
		j1180276336 -> j2595691466;
		j1180276336 -> j728685592;
		j1180276336 -> j1425455014;
	j2654702102 [label="Тогда поговори с ним о своих тревогах. Он выслушает. Он ведь не ребёнок. ",shape=box,color=blue];
		j2654702102 -> j3701117064;
