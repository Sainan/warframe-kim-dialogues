	2039 [label="Update boolean LyonPainResolved",color=orange];
		2039 -> 2046;
	2040 [label="Ах, как будто разговариваешь с de marbre статуей, non ? Я понимаю, что ты чувствуешь. Часто бывало, что я увлекалась историей минут на двадцать, а потом понимала, что он меня даже не слушает.",shape=box,color=blue];
		2040 -> 2047;
	2041 [label="Oui, я понимаю. Но порой мы можем сделать совсем немного. Но просто быть рядом с другими так, как и когда они сами этого хотят.",shape=box,color=blue];
		2041 -> 2048;
	2042 [label="Будь мягче с ним, прояви доброту, et je vous en supplie, не рань его, oui ?",shape=box,color=blue];
		2042 -> 2049;
	2043 [label="Тебе нужно научиться читать между строк, non ? Он говорит историями. Притчами. Если он молчит, прислушайся к языку его тела.",shape=box,color=blue];
		2043 -> 2042;
	2044 [label="Я всё равно не считаю это правильным.",shape=box,color=red];
		2044 -> 2050;
	2045 [label="Я сделаю всё, что в моих силах.",shape=box,color=red];
		2045 -> 2051;
	2046 [label="Разумеется… Хочешь, я расскажу тебе историю о том, кого я знала, кто сделал то же самое ? Или тебе бы больше хотелось, чтобы мы пошли каждый своей дорогой ?",shape=box,color=blue];
		2046 -> 2052;
