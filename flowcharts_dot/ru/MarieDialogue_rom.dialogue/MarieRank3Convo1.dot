		j321226664 -> j2607789382;
	j2357593951 [label="Возможно, тогда ещё не было желания покидать Дувири. Возможно, оно ещё не стало роковым. Может быть, не хотелось покидать друзей?",shape=box,color=blue];
		j2357593951 -> j2595713086;
	j1416864853 [label="+5 Chemistry",color=orange];
		j1416864853 -> j2459624804;
	j1067141663 [label="Можешь ли ты сказать, что нет ни малейшей причины, по которой он мог оставить тебя? ",shape=box,color=blue];
		j1067141663 -> j2357593951;
	j2457606619 [label="Boolean MarieNeci is now true.",color=orange];
		j2457606619 -> j3615834963;
	j127501284 [label="О, какая мысль! Думаю, это дело стоит отстаивать!",shape=box,color=blue];
		j127501284 -> j2093984253;
	j2595713086 [label="Возможно, он не знал, сможет ли забрать тебя оттуда, боясь разрушить и без того хрупкое. Возможно, он думал, что l'Indifférence заберёт его, если тебя не станет. Peut-être, peut-être, peut-être.",shape=box,color=blue];
		j2595713086 -> j1591510439;
	j2459624804 [label="Merci, merci - вот что мне дорого. Мы не должны предполагать худшее, ведь именно это ожесточает наши сердца больше всего.",shape=box,color=blue];
		j2459624804 -> j550441965;
	j3615834963 [label="Я не знаю, что об этом думать... но это довольно любопытно... ",shape=box,color=blue];
		j3615834963 -> j544580505;
