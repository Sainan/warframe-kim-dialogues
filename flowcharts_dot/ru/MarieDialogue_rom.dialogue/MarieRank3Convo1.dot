		j1698826678 -> j3503575572 [label="false",color=purple];
	j3812032888 [label="Боюсь, мы знаем очень мало о людях, которых превратили в первые варфреймы.",shape=box,color=red];
		j3812032888 -> j3298910989;
	j2129979791 [label="Боюсь, о первоначальной Висп известно очень мало.",shape=box,color=red];
		j2129979791 -> j3298910989;
	j2733874687 [label="Расскажи мне, волк, об этой, что зовётся «Висп», чья искажённая кровь течёт во мне, что даровала мне этот дар полёта и чью душу я ощущаю в тени ночи, так близко, рядом с собственной.",shape=box,color=blue];
		j2733874687 -> j1631568751;
		j2733874687 -> j1691692904;
	j2364582561 [label="Расскажи мне, волк, об этой, что зовётся «Висп», чья искажённая кровь течёт во мне, что даровала мне этот дар полёта и чью душу я ощущаю в тени ночи, так близко, рядом с собственной.",shape=box,color=blue];
		j2364582561 -> j31702885;
	j3298910989 [label="Vraiment? Записи исчезли с течением времени или, возможно, их посчитали не столь важными, чтобы сохранить?",shape=box,color=blue];
		j3298910989 -> j2776433631;
		j3298910989 -> j1315955354;
		j3298910989 -> j2706044354;
	j1631568751 [label="Боюсь, мы знаем очень мало о людях, которых превратили в первые варфреймы.",shape=box,color=red];
		j1631568751 -> j701445822;
	j1691692904 [label="Боюсь, о первоначальной Висп известно очень мало.",shape=box,color=red];
		j1691692904 -> j701445822;
	j31702885 [label="Если разговор о душах не вызывает беспокойства? Понимаю, если всё же вызывает, можем перейти к более практичным вещам, не хотелось бы создавать тебе дискомфорт.",shape=box,color=blue];
		j31702885 -> j1027945619;
		j31702885 -> j273205012;
		j31702885 -> j1310452999;
	j2776433631 [label="Похоже, их посчитали не столь важными, чтобы их запомнили.",shape=box,color=red];
		j2776433631 -> j629461806;
	j1315955354 [label="Похоже, они просто исчезли с течением времени.",shape=box,color=red];
		j1315955354 -> j629461806;
	j2706044354 [label="В конце концов, немного и того, и другого. Для своего создателя они были… отчасти оружием, отчасти произведением искусства.",shape=box,color=red];
		j2706044354 -> j2595169206;
	j701445822 [label="Vraiment? Мне кажется, я знаю её так, будто она моя родная сестра, и притом моя, а не из Cathédrale.",shape=box,color=blue];
		j701445822 -> j1382073101;
	j1027945619 [label="Ничего, мы можем поговорить о душах.",shape=box,color=red];
		j1027945619 -> j1631568751;
		j1027945619 -> j1691692904;
		j1027945619 -> j1310452999;
	j273205012 [label="Я не очень верю в существование душ, поэтому, если возможно, давай сосредоточимся на конкретных фактах?",shape=box,color=red];
		j273205012 -> j2772159158;
	j1310452999 [label="[Конец.]",shape=box,color=red];
		j1310452999 -> "Chat ends.";
	j629461806 [label="Видишь? Ces Орокин, они дьяволы.",shape=box,color=blue];
		j629461806 -> j3700729042;
		j629461806 -> j623521784;
	j2595169206 [label="+5 Chemistry",color=orange];
		j2595169206 -> j1793136185;
	j1382073101 [label="Я не слышу её, не так, как Лион слышит богов и своих покровителей. Я не вижу её. Я просто чувствую её рядом, рядом со мной.",shape=box,color=blue];
		j1382073101 -> j756577218;
	j2772159158 [label="Boolean DrifterFaithStop is now true.",color=orange];
		j2772159158 -> j4257252413;
	"Chat ends." [color=orange];
	j3700729042 [label="Оружие можно использовать как для защиты, так и для нанесения вреда. Нам не нравится, что оно нам нужно, но... оно нам нужно.",shape=box,color=red];
		j3700729042 -> j2286870306;
	j623521784 [label="Не все. Но этот? Да. Есть ещё такие, которых не стоило бы сразу осуждать.",shape=box,color=red];
		j623521784 -> j483298523;
	j1793136185 [label="Une ужасный toile d'os peinte avec du sang... понимаешь? Ces Орокин, они дьяволы.",shape=box,color=blue];
		j1793136185 -> j3700729042;
		j1793136185 -> j623521784;
	j756577218 [label="Как старая подруга, наверное. Я знаю, что ей нравилось, знаю, как она двигалась. Помню, как её смех разносился по ветру...",shape=box,color=blue];
		j756577218 -> j445512932;
	j4257252413 [label="+5 Chemistry",color=orange];
		j4257252413 -> j2215270098;
	j2286870306 [label="Add -1 to Thermostat counter",color=orange];
		j2286870306 -> j3381334606;
	j483298523 [label="Add 1 to Thermostat counter",color=orange];
		j483298523 -> j1285726017;
	j445512932 [label="Должно быть, я кажусь тебе совсем безумной! Прости меня.",shape=box,color=blue];
		j445512932 -> j1260641970;
		j445512932 -> j101371862;
		j445512932 -> j1306103815;
		j445512932 -> j3198233941;
	j2215270098 [label="Oui, bien sûr! Никто не хочет выслушивать нотации, особенно от сестры. Я понимаю. Merci, я бы не хотела выставить себя дурой.",shape=box,color=blue];
		j2215270098 -> j3812032888;
		j2215270098 -> j2129979791;
		j2215270098 -> j1310452999;
	j3381334606 [label="Да, это правда. Теперь я - оружие, как хорошо знают Murmure! Но я стремлюсь следовать пути, который мне указал Кардинал, благословенному, как он есть.",shape=box,color=blue];
		j3381334606 -> j668400536;
		j3381334606 -> j1113205350;
	j1285726017 [label="Как и le Cardinal. Он был Орокин, не так ли? И я бы его точно не осудила. Без него я бы не была такой, какой я есть сейчас. Благословенной.",shape=box,color=blue];
		j1285726017 -> j2140218930;
		j1285726017 -> j3360154190;
	j1260641970 [label="Варфреймы… создавались далеко не самыми добрыми способами. Я лишь надеюсь, что она не оказалась запертой внутри Заражения.",shape=box,color=red];
		j1260641970 -> j903570748;
	j101371862 [label="Думаю, кем бы ни была Висп, она бы обрадовалась, узнав тебя.",shape=box,color=red];
		j101371862 -> j1924397661;
	j1306103815 [label="Я надеюсь, что их души смогли двигаться дальше и обрести покой, но думаю, что какая-то часть их памяти всё же осталась.",shape=box,color=red];
		j1306103815 -> j3697890158;
	j3198233941 [label="Вовсе нет. Я думаю, что часть людей, превращённых в варфреймы, остаются в рамках своих основных чертежей.",shape=box,color=red];
		j3198233941 -> j3042829630;
	j668400536 [label="Можно было бы поспорить с ним о многом, но скажу, что у него, похоже, хорошее чутьё, кому давать какую сыворотку протофрейма. Даже если я не понимаю, зачем он это делает.",shape=box,color=red];
		j668400536 -> j616518531;
	j1113205350 [label="Мне не хотелось бы, чтобы ты не доверяло Энтрати так сильно, как сейчас. Мы ведь не знаем, почему он поступает так, как поступает, и его мотивы остаются неясными.",shape=box,color=red];
		j1113205350 -> j1722407835;
	j2140218930 [label="Мы должны держаться Энтрати. Думаю, нам нужно просто следовать за ним. Он - наш единственный шанс остановить Безразличие.",shape=box,color=red];
		j2140218930 -> j737842484;
	j3360154190 [label="Он лжец, Мари. Он бросает и причиняет боль всем, кто оказывается в его жизни. Он уже бросил тебя, разве ты не видишь? ",shape=box,color=red];
		j3360154190 -> j1591510439;
	j903570748 [label="+5 Chemistry",color=orange];
		j903570748 -> j649374106;
	j1924397661 [label="+5 Chemistry",color=orange];
