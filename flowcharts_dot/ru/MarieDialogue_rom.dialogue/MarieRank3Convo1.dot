		1005 -> 1010;
	1006 [label="Chat ends.",color=orange];
	1007 [label="Возможно, он не знал, сможет ли забрать тебя оттуда, боясь разрушить и без того хрупкое. Возможно, он думал, что l'Indifférence заберёт его, если тебя не станет. Peut-être, peut-être, peut-être.",shape=box,color=blue];
