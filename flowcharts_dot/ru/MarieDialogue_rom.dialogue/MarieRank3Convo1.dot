		j550441965 -> j2595713086;
	j2237867949 [label="Ты и крошечная copie уже так хорошо справились с его famille… Хм, теперь это интригует!",shape=box,color=blue];
		j2237867949 -> j2607789382;
	j2357386533 [label="Хм… теперь ты заставляешь меня строить планы! Но сначала ты нужно продолжить свою работу с его famille наверху. Либо ты, либо эта крошечная копия.",shape=box,color=blue];
