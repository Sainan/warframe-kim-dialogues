		916 -> 926 [label="MarieEntratiFan1",color=purple];
		916 -> 927 [label="false",color=purple];
	917 [label="Evaluate expressions",color=orange];
		917 -> 930 [label="DrifterFaithSol",color=purple];
		917 -> 932 [label="DrifterFaithLua",color=purple];
		917 -> 931 [label="DrifterFaithBalance",color=purple];
		917 -> 929 [label="false",color=purple];
	918 [label="I have only been told of the Infestation, I know little of it... but I believe you. And if what I feel is the truth, and I pray that it is, I do not think she is trapped.",shape=box,color=blue];
		918 -> 933;
	919 [label="Очень мило с твоей стороны. Если то, что я чувствую, правда, и я молюсь, чтобы это было так, то, oui, думаю, ты прав. Я не верю, что она в ловушке.",shape=box,color=blue];
		919 -> 933;
	920 [label="Если то, что я чувствую, правда, и я молюсь, чтобы так и было, то, non, я не думаю, что она в ловушке.",shape=box,color=blue];
		920 -> 933;
	921 [label="Если то, что я чувствую, правда, и я молюсь, чтобы так и было, то, oui, ты прав. И они остаются, чтобы помочь нам. Я не думаю, что она в ловушке.",shape=box,color=blue];
		921 -> 933;
	922 [label="Oui, le Cardinal блогословил меня... но я знаю, что моя любовь к нему почти уникальна, ведь её не омрачают ни печаль, ни ненависть, ни горечь.",shape=box,color=blue];
		922 -> 934;
	925 [label="Я знаю, ты считаешь его каким-то ужасным чудовищем. Но я должна спросить, что заставило тебя так не доверять ему?",shape=box,color=blue];
		925 -> 937;
		925 -> 939;
		925 -> 938;
	923 [label="Я думала, ты веришь в него? Почему же ты так внезапно изменил своё мнение? Неужели ты настолько непостоянен? ",shape=box,color=blue];
		923 -> 935;
		923 -> 936;
	924 [label="Почему ты ему так не доверяешь?",shape=box,color=blue];
		924 -> 937;
		924 -> 938;
		924 -> 939;
	928 [label="Oui, и ты так быстро меняешь своё мнение? Ты лжёшь. Зачем, я не знаю. Et je ne veux pas le savoir.",shape=box,color=blue];
		928 -> 941;
	926 [label="+5 Chemistry",color=orange];
		926 -> 940;
	927 [label="Update boolean MarieEntratiFan1",color=orange];
		927 -> 940;
	930 [label="Для нас, кто следует пути Сола, мы всегда должны быть светом, который ведёт тех, кто пытается идти с перекрёстка, non? ",shape=box,color=blue];
		930 -> 942;
	932 [label="Ты следуешь Луа, тебе известно, что мы учим, что некоторые должны ходить в тени в одиночестве, oui?",shape=box,color=blue];
		932 -> 942;
	931 [label="Ты идёшь путём Светил, и ты должен знать, что мы учим, что некоторые идут по неизведанным дорогам в одиночку, oui?",shape=box,color=blue];
		931 -> 942;
	929 [label="В моей вере мы знаем тех, кто идет по дорогам жизни и оказывается на перекрестке, где встречаются Луа и Сол. ",shape=box,color=blue];
		929 -> 942;
	933 [label="От неё я чувствую лишь тепло улыбки Сола. Думаю, Кардинал был мудр в своём выборе. Для меня большая честь носить ее в своих венах.",shape=box,color=blue];
		933 -> 908;
		933 -> 907;
		933 -> 905;
		933 -> 906;
	934 [label="Я прощаю его за то, что он покунил нас. Не думаю, что кто-то ещё способен на это...",shape=box,color=blue];
		934 -> 943;
		934 -> 944;
		934 -> 937;
		934 -> 938;
	937 [label="Он... приходил в Дувири. Давным-давно...",shape=box,color=red];
		937 -> 947;
	939 [label="Ну, для начала он выстрелил мне в грудь и оставил умирать.",shape=box,color=red];
		939 -> 948;
	938 [label="Он не оставляет после себя ничего, кроме боли, смерти и одиночества.",shape=box,color=red];
		938 -> 917;
	935 [label="Доверия к нему никогда не было, просто не хотелось тебя отпугнуть.",shape=box,color=red];
		935 -> 945;
	936 [label="Не хотелось лгать, просто было непонятно, как к этому подойти. Ты ведь его явно обожаешь...",shape=box,color=red];
		936 -> 946;
	941 [label="Update boolean MarieNoDate",color=orange];
		941 -> 950;
	940 [label="Да, мы должны оставаться сильными! Braves contre les ténèbres, pour toujours et à jamais!",shape=box,color=blue];
		940 -> 949;
	942 [label="Update boolean DrifterCrossroads",color=orange];
		942 -> 951;
	943 [label="Он причинял боль и покидал многих, ты права. И, похоже, он думает, что у него не было другого выбора.",shape=box,color=red];
		943 -> 952;
	944 [label="Тяжело, когда уходит тот, кто так много для тебя значит, кого ты любишь и на кого полагаешься. Особенно, если не знаешь почему. Или он не возвращается.",shape=box,color=red];
		944 -> 953;
	947 [label="Сол! Этот мир, что ты создал, вызванный из книги, которую написала его дочь, да? Monsieur Лойд говорил о нём... Кардинал был там? Почему? ",shape=box,color=blue];
		947 -> 956;
		947 -> 957;
		947 -> 958;
	948 [label="Et pourtant, ты всё ещё живёшь! Ты живёшь, не так ли? И в здравии? И процветаешь, если верить рассказам Monsieur Лойд о твоих приключениях в прошлом-будущем.",shape=box,color=blue];
		948 -> 959;
	945 [label="Ah, je vois! Je suis une idiote, c'est ça?! Juste une petite invalide venue d'un passé lointain, incapable de penser par elle-même?! Mieux vaut l'approcher comme un faon dans les bois, de peur de l'effrayer!",shape=box,color=blue];
		945 -> 954;
	946 [label="Ах, да… Я, наверное, совсем не сделала это лёгким для тебя, говорить правду, n'est-ce pas?",shape=box,color=blue];
		946 -> 955;
	950 [label="Chat ends.",color=orange];
	949 [label="Я простила его за то, что он покинул нас. Не думаю, что кто-то ещё способен на это...",shape=box,color=blue];
		949 -> 943;
		949 -> 944;
	951 [label="Кардинал должен найти дорогу обратно к нам. Мы можем лишь сделать всё возможное, чтобы помочь ему, когда он позовёт, и следовать указаниям тех, кто, как он, благословлён.",shape=box,color=blue];
		951 -> 960;
	952 [label="+5 Chemistry",color=orange];
		952 -> 961;
	953 [label="+5 Chemistry",color=orange];
		953 -> 962;
	956 [label="Я думаю, что сначала какая-то часть его искала хотя бы частичку той дочери, которую он оставил. Но вместо этого он нашёл способ бороться с Безразличием - с теми эмоциями, от которых пытался дистанцироваться.",shape=box,color=red];
		956 -> 964;
	957 [label="Его заметки рассказывают весьма отвратительную самовосхваляющую историю о том, как он отправился изучать концептуальное воплощение, а вместо этого усвоил ценность борьбы с Безразличием.",shape=box,color=red];
		957 -> 965;
	958 [label="Если верить его записям, он был там, чтобы научить Дувири — и, соответственно, меня — защищаться от Безразличия. И какая от этого польза в итоге?",shape=box,color=red];
		958 -> 966;
	959 [label="Check boolean IsDating",color=orange];
		959 -> 968 [label=true,color=green];
		959 -> 967 [label=false,color=brown];
	954 [label="Va t'asseoir sur une ruche.",shape=box,color=blue];
		954 -> 963;
	955 [label="Так скажи же мне правду, волк. Почему ты считаешь, что ему нельзя доверять? И я постараюсь сдержать свой гнев.",shape=box,color=blue];
		955 -> 944;
		955 -> 937;
		955 -> 938;
		955 -> 939;
	960 [label="Evaluate expressions",color=orange];
		960 -> 969 [label="MarieEntratiMonster1",color=purple];
		960 -> 971 [label="MarieEntratiMonster1",color=purple];
		960 -> 969 [label="MarieEntratiFan1",color=purple];
		960 -> 972 [label="MarieEntratiFan1",color=purple];
		960 -> 969 [label="false",color=purple];
		960 -> 971 [label="false",color=purple];
		960 -> 972 [label="false",color=purple];
		960 -> 970 [label="false",color=purple];
	961 [label="Да, верно. Думаю, его преследует чувство вины за всё, что он совершил. Полагаю, он намеренно дистанцируется от окружающих.",shape=box,color=blue];
		961 -> 973;
	962 [label="Да, это ужасное горе, ужасная боль. Знать, что кто-то... всё ещё жив, и, по-видимому, сознательно выбирает не быть рядом с тобой?",shape=box,color=blue];
		962 -> 973;
	964 [label="Mon cœur se brise dans la tragédie - Я не думаю, что смогу вынести всю эту печаль... и все же, она не простит его?",shape=box,color=blue];
		964 -> 975;
		964 -> 976;
	965 [label="Ты знаешь, почему он ушел?",shape=box,color=blue];
		965 -> 975;
		965 -> 977;
	966 [label="Ты о чём? ",shape=box,color=blue];
		966 -> 978;
		966 -> 979;
	968 [label="В самом деле, если слухи среди Кавиа верны, vous y avez vraiment trouvé beaucoup de joie, non ?",shape=box,color=blue];
		968 -> 967;
	967 [label="Нет, Кардинал причинил куда больше зла многим другим, ты просто злишься из-за того, что тебе доставили неудобства.",shape=box,color=blue];
		967 -> 917;
	963 [label="Update boolean MarieNoDate",color=orange];
		963 -> 974;
	969 [label="Я просто хочу, чтобы… все вокруг Энтрати перестали винить себя и друг друга за то, что произошло.",shape=box,color=red];
		969 -> 980;
	971 [label="Не знаю, смогу ли я когда-нибудь назвать его святым.",shape=box,color=red];
		971 -> 982;
	972 [label="Было бы гораздо легче простить Энтрати за его проступки, если бы можно было их понять.",shape=box,color=red];
		972 -> 983;
	970 [label="Я сделаю всё, что ему от меня нужно, чтобы решить эту проблему. А потом, когда всё будет сказано и сделано, я его осужу.",shape=box,color=red];
		970 -> 981;
	973 [label="Il inflige la douleur dans le cœur des autres, car la douleur vaut mieux que rien du tout. Ибо страдание лучше пустоты, не так ли?",shape=box,color=blue];
		973 -> 984;
	975 [label="Боюсь, если он не объяснится, нам остается только придумывать собственные причины.",shape=box,color=red];
		975 -> 985;
	976 [label="Ты не понимаешь. Он оставил меня там. Он увидел кого-то брошенного в Бездне, и всё равно оставил меня там.",shape=box,color=red];
		976 -> 986;
	977 [label="Нет. Я просто знаю, что он оставил меня там. Он увидел кого-то, брошенного в Бездне, и просто… оставил меня там.",shape=box,color=red];
		977 -> 985;
	978 [label="Он оставил меня там. Он появился, в какой-то момент, я не знаю, и увидел кого-то, брошенного в Бездне, и... оставил меня там.",shape=box,color=red];
		978 -> 986;
	979 [label="В конце концов, Безразличие всё равно пришло в Дувири. (Хотя с неожиданной помощью, но это уже не важно)",shape=box,color=red];
		979 -> 987;
	974 [label="Chat ends.",color=orange];
	980 [label="Update boolean MarieEntratiFamily",color=orange];
		980 -> 988;
	982 [label="Тогда, я думаю, мы можем продолжать соглашаться или не соглашаться.",shape=box,color=blue];
		982 -> 990;
	983 [label="Я молюсь, чтобы в конце концов так и случилось. Молюсь, чтобы мы все дожили до этого момента. А пока я вижу семью вокруг себя и молюсь, чтобы они нашли прощение в своих сердцах. Ради собственного счастья.",shape=box,color=blue];
		983 -> 991;
	981 [label="+10 Chemistry",color=orange];
		981 -> 989;
	984 [label="Этот урок мой дорогой Лион усвоил лучше многих… Я так рада, что он теперь разговаривает с тобой. Но сегодня мы говорим о Кардинале.",shape=box,color=blue];
		984 -> 992;
	985 [label="Я могу только предположить, что это произошло до... murder ad infinitum.",shape=box,color=red];
		985 -> 993;
	986 [label="И ты не знаешь, почему он тебя там оставил?",shape=box,color=blue];
		986 -> 994;
		986 -> 985;
		986 -> 995;
	987 [label="Нет. Ждать. У L'Indifférence есть... союзник?",shape=box,color=blue];
		987 -> 996;
		987 -> 997;
	988 [label="Add 1 to Family",color=orange];
		988 -> 998;
	990 [label="Update boolean MarieEntratiMonster2",color=orange];
		990 -> 1000;
	991 [label="Update boolean MarieEntratiFan2",color=orange];
		991 -> 1000;
	989 [label="Oui, c'est raisonnable, и вполне справедливо, учитывая всё, что ты видел и знаешь. Я не могу просить от тебя большего.",shape=box,color=blue];
		989 -> 999;
	992 [label="Update boolean MarieLyonSuffering3",color=orange];
		992 -> 917;
	993 [label="Тогда я должна попросить тебя не предполагать о нём худшего, ведь это ожесточит твоё сердце. ",shape=box,color=blue];
		993 -> 1001;
	994 [label="Я могу только надеяться, что у него была веская причина.",shape=box,color=red];
		994 -> 1002;
	995 [label="Нет, и это неважно. Он мог бы меня спасти. Но не спас.",shape=box,color=red];
		995 -> 1003;
	996 [label="Оно просто носит другое лицо.",shape=box,color=red];
		996 -> 1004;
	997 [label="Возможно? Или заложник. Или оно просто носит её лицо. Мы толком не знаем.",shape=box,color=red];
		997 -> 1004;
	998 [label="+10 Chemistry",color=orange];
