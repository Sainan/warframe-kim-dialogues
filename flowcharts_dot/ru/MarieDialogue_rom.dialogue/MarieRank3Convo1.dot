	868 [label="Боюсь, мы знаем очень мало о людях, которых превратили в первые варфреймы.",shape=box,color=red];
		868 -> 871;
	867 [label="Боюсь, о первоначальной Висп известно очень мало.",shape=box,color=red];
		867 -> 871;
	870 [label="Расскажи мне, волк, об этой, что зовётся «Висп», чья искажённая кровь течёт во мне, что даровала мне этот дар полёта и чью душу я ощущаю в тени ночи, так близко, рядом с собственной.",shape=box,color=blue];
		870 -> 874;
		870 -> 873;
	869 [label="Расскажи мне, волк, об этой, что зовётся «Висп», чья искажённая кровь течёт во мне, что даровала мне этот дар полёта и чью душу я ощущаю в тени ночи, так близко, рядом с собственной.",shape=box,color=blue];
		869 -> 872;
	871 [label="Vraiment? Записи исчезли с течением времени или, возможно, их посчитали не столь важными, чтобы сохранить?",shape=box,color=blue];
		871 -> 875;
		871 -> 876;
		871 -> 877;
	874 [label="Боюсь, мы знаем очень мало о людях, которых превратили в первые варфреймы.",shape=box,color=red];
		874 -> 881;
	873 [label="Боюсь, о первоначальной Висп известно очень мало.",shape=box,color=red];
		873 -> 881;
	872 [label="Если разговор о душах не вызывает беспокойства? Понимаю, если всё же вызывает, можем перейти к более практичным вещам, не хотелось бы создавать тебе дискомфорт.",shape=box,color=blue];
		872 -> 880;
		872 -> 879;
		872 -> 878;
	875 [label="Похоже, их посчитали не столь важными, чтобы их запомнили.",shape=box,color=red];
		875 -> 882;
	876 [label="Похоже, они просто исчезли с течением времени.",shape=box,color=red];
		876 -> 882;
	877 [label="В конце концов, немного и того, и другого. Для своего создателя они были… отчасти оружием, отчасти произведением искусства.",shape=box,color=red];
		877 -> 883;
	881 [label="Vraiment? Мне кажется, я знаю её так, будто она моя родная сестра, и притом моя, а не из Cathédrale.",shape=box,color=blue];
		881 -> 887;
	880 [label="Ничего, мы можем поговорить о душах.",shape=box,color=red];
		880 -> 874;
		880 -> 873;
		880 -> 886;
	879 [label="Я не очень верю в существование душ, поэтому, если возможно, давай сосредоточимся на конкретных фактах?",shape=box,color=red];
		879 -> 885;
	878 [label="[Конец.]",shape=box,color=red];
		878 -> 884;
	882 [label="Видишь? Ces Орокин, они дьяволы.",shape=box,color=blue];
		882 -> 888;
		882 -> 889;
	883 [label="+5 Chemistry",color=orange];
		883 -> 890;
	887 [label="Я не слышу её, не так, как Лион слышит богов и своих покровителей. Я не вижу её. Я просто чувствую её рядом, рядом со мной.",shape=box,color=blue];
		887 -> 893;
	886 [label="[Конец.]",shape=box,color=red];
		886 -> 892;
	885 [label="Update boolean DrifterFaithStop",color=orange];
		885 -> 891;
	884 [label="Chat ends.",color=orange];
	888 [label="Оружие можно использовать как для защиты, так и для нанесения вреда. Нам не нравится, что оно нам нужно, но... оно нам нужно.",shape=box,color=red];
		888 -> 894;
	889 [label="Не все. Но этот? Да. Есть ещё такие, которых не стоило бы сразу осуждать.",shape=box,color=red];
		889 -> 895;
	890 [label="Une ужасный toile d'os peinte avec du sang... понимаешь? Ces Орокин, они дьяволы.",shape=box,color=blue];
		890 -> 888;
		890 -> 889;
	893 [label="Как старая подруга, наверное. Я знаю, что ей нравилось, знаю, как она двигалась. Помню, как её смех разносился по ветру...",shape=box,color=blue];
		893 -> 897;
	892 [label="Chat ends.",color=orange];
	891 [label="+5 Chemistry",color=orange];
		891 -> 896;
	894 [label="Add -1 to Thermostat",color=orange];
		894 -> 898;
	895 [label="Add 1 to Thermostat",color=orange];
		895 -> 899;
	897 [label="Должно быть, я кажусь тебе совсем безумной! Прости меня.",shape=box,color=blue];
		897 -> 901;
		897 -> 902;
		897 -> 903;
		897 -> 904;
	896 [label="Oui, bien sûr! Никто не хочет выслушивать нотации, особенно от сестры. Я понимаю. Merci, я бы не хотела выставить себя дурой.",shape=box,color=blue];
		896 -> 868;
		896 -> 867;
		896 -> 900;
	898 [label="Да, это правда. Теперь я - оружие, как хорошо знают Murmure! Но я стремлюсь следовать пути, который мне указал Кардинал, благословенному, как он есть.",shape=box,color=blue];
		898 -> 905;
		898 -> 906;
	899 [label="Как и le Cardinal. Он был Орокин, не так ли? И я бы его точно не осудила. Без него я бы не была такой, какой я есть сейчас. Благословенной.",shape=box,color=blue];
		899 -> 907;
		899 -> 908;
	901 [label="Варфреймы… создавались далеко не самыми добрыми способами. Я лишь надеюсь, что она не оказалась запертой внутри Заражения.",shape=box,color=red];
		901 -> 910;
	902 [label="Думаю, кем бы ни была Висп, она бы обрадовалась, узнав тебя.",shape=box,color=red];
		902 -> 911;
	903 [label="Я надеюсь, что их души смогли двигаться дальше и обрести покой, но думаю, что какая-то часть их памяти всё же осталась.",shape=box,color=red];
		903 -> 912;
	904 [label="Вовсе нет. Я думаю, что часть людей, превращённых в варфреймы, остаются в рамках своих основных чертежей.",shape=box,color=red];
		904 -> 913;
	900 [label="[Конец.]",shape=box,color=red];
		900 -> 909;
	905 [label="Можно было бы поспорить с ним о многом, но скажу, что у него, похоже, хорошее чутьё, кому давать какую сыворотку протофрейма. Даже если я не понимаю, зачем он это делает.",shape=box,color=red];
		905 -> 914;
	906 [label="Мне не хотелось бы, чтобы ты не доверяло Энтрати так сильно, как сейчас. Мы ведь не знаем, почему он поступает так, как поступает, и его мотивы остаются неясными.",shape=box,color=red];
		906 -> 915;
	907 [label="Мы должны держаться Энтрати. Думаю, нам нужно просто следовать за ним. Он - наш единственный шанс остановить Безразличие.",shape=box,color=red];
		907 -> 916;
	908 [label="Он лжец, Мари. Он бросает и причиняет боль всем, кто оказывается в его жизни. Он уже бросил тебя, разве ты не видишь? ",shape=box,color=red];
		908 -> 917;
