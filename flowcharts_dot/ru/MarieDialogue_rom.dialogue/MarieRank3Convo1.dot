	j737842484 [label="Evaluate expressions",color=orange];
		j737842484 -> j1797315484 [label="MarieEntratiMonster1",color=purple];
		j737842484 -> j2128449112 [label="MarieEntratiFan1",color=purple];
		j737842484 -> j831121025 [label="false",color=purple];
	j1591510439 [label="Evaluate expressions",color=orange];
		j1591510439 -> j623675577 [label="DrifterFaithSol",color=purple];
		j1591510439 -> j4202908946 [label="DrifterFaithLua",color=purple];
		j1591510439 -> j2537523320 [label="DrifterFaithBalance",color=purple];
		j1591510439 -> j3123082061 [label="false",color=purple];
	j649374106 [label="Мне только рассказали о Заражении, я мало что о нём знаю... но я верю тебе. И если то, что я чувствую, правда, а я молюсь об этом, я не думаю, что она в ловушке.",shape=box,color=blue];
		j649374106 -> j3833354182;
	j2714116976 [label="Очень мило с твоей стороны. Если то, что я чувствую, правда, и я молюсь, чтобы это было так, то, oui, думаю, ты прав. Я не верю, что она в ловушке.",shape=box,color=blue];
		j2714116976 -> j3833354182;
	j476071390 [label="Если то, что я чувствую, правда, и я молюсь, чтобы так и было, то, non, я не думаю, что она в ловушке.",shape=box,color=blue];
		j476071390 -> j3833354182;
	j877662214 [label="Если то, что я чувствую, правда, и я молюсь, чтобы так и было, то, oui, ты прав. И они остаются, чтобы помочь нам. Я не думаю, что она в ловушке.",shape=box,color=blue];
		j877662214 -> j3833354182;
	j4013977955 [label="Oui, le Cardinal блогословил меня... но я знаю, что моя любовь к нему почти уникальна, ведь её не омрачают ни печаль, ни ненависть, ни горечь.",shape=box,color=blue];
		j4013977955 -> j4193423837;
	j1833911131 [label="Я знаю, ты считаешь его каким-то ужасным чудовищем. Но я должна спросить, что заставило тебя так не доверять ему?",shape=box,color=blue];
		j1833911131 -> j3619544922;
		j1833911131 -> j2308985542;
		j1833911131 -> j418915886;
	j2411558115 [label="Я думала, ты веришь в него? Почему же ты так внезапно изменил своё мнение? Неужели ты настолько непостоянен? ",shape=box,color=blue];
		j2411558115 -> j516668827;
		j2411558115 -> j1224802670;
	j3670140524 [label="Почему ты ему так не доверяешь?",shape=box,color=blue];
		j3670140524 -> j3619544922;
		j3670140524 -> j418915886;
		j3670140524 -> j2308985542;
	j1797315484 [label="Oui, и ты так быстро меняешь своё мнение? Ты лжёшь. Зачем, я не знаю. Et je ne veux pas le savoir.",shape=box,color=blue];
		j1797315484 -> j1508231473;
	j2128449112 [label="+5 Chemistry",color=orange];
		j2128449112 -> j3305563685;
	j831121025 [label="Boolean MarieEntratiFan1 is now true.",color=orange];
		j831121025 -> j3305563685;
	j623675577 [label="Для нас, кто следует пути Сола, мы всегда должны быть светом, который ведёт тех, кто пытается идти с перекрёстка, non? ",shape=box,color=blue];
		j623675577 -> j3663078462;
	j4202908946 [label="Ты следуешь Луа, тебе известно, что мы учим, что некоторые должны ходить в тени в одиночестве, oui?",shape=box,color=blue];
		j4202908946 -> j3663078462;
	j2537523320 [label="Ты идёшь путём Светил, и ты должен знать, что мы учим, что некоторые идут по неизведанным дорогам в одиночку, oui?",shape=box,color=blue];
		j2537523320 -> j3663078462;
	j3123082061 [label="В моей вере мы знаем тех, кто идет по дорогам жизни и оказывается на перекрестке, где встречаются Луа и Сол. ",shape=box,color=blue];
		j3123082061 -> j3663078462;
	j3833354182 [label="От неё я чувствую лишь тепло улыбки Сола. Думаю, Кардинал был мудр в своём выборе. Для меня большая честь носить ее в своих венах.",shape=box,color=blue];
		j3833354182 -> j3360154190;
		j3833354182 -> j2140218930;
		j3833354182 -> j668400536;
		j3833354182 -> j1113205350;
	j4193423837 [label="Я прощаю его за то, что он покунил нас. Не думаю, что кто-то ещё способен на это...",shape=box,color=blue];
		j4193423837 -> j753344693;
		j4193423837 -> j4183769464;
		j4193423837 -> j3619544922;
		j4193423837 -> j418915886;
	j3619544922 [label="Он... приходил в Дувири. Давным-давно...",shape=box,color=red];
		j3619544922 -> j1945622147;
	j2308985542 [label="Ну, для начала он выстрелил мне в грудь и оставил умирать.",shape=box,color=red];
		j2308985542 -> j630995436;
	j418915886 [label="Он не оставляет после себя ничего, кроме боли, смерти и одиночества.",shape=box,color=red];
		j418915886 -> j1591510439;
	j516668827 [label="Доверия к нему никогда не было, просто не хотелось тебя отпугнуть.",shape=box,color=red];
		j516668827 -> j536548774;
	j1224802670 [label="Не хотелось лгать, просто было непонятно, как к этому подойти. Ты ведь его явно обожаешь...",shape=box,color=red];
		j1224802670 -> j2751090361;
	j1508231473 [label="Boolean MarieNoDate is now true.",color=orange];
		j1508231473 -> "Chat ends.";
	j3305563685 [label="Да, мы должны оставаться сильными! Braves contre les ténèbres, pour toujours et à jamais!",shape=box,color=blue];
		j3305563685 -> j3436506676;
	j3663078462 [label="Boolean DrifterCrossroads is now true.",color=orange];
		j3663078462 -> j1825355270;
	j753344693 [label="Он причинял боль и покидал многих, ты права. И, похоже, он думает, что у него не было другого выбора.",shape=box,color=red];
		j753344693 -> j717630067;
	j4183769464 [label="Тяжело, когда уходит тот, кто так много для тебя значит, кого ты любишь и на кого полагаешься. Особенно, если не знаешь почему. Или он не возвращается.",shape=box,color=red];
		j4183769464 -> j3221590514;
	j1945622147 [label="Сол! Этот мир, что ты создал, вызванный из книги, которую написала его дочь, да? Monsieur Лойд говорил о нём... Кардинал был там? Почему? ",shape=box,color=blue];
		j1945622147 -> j4116034761;
		j1945622147 -> j684748256;
		j1945622147 -> j1744720416;
	j630995436 [label="Et pourtant, ты всё ещё живёшь! Ты живёшь, не так ли? И в здравии? И процветаешь, если верить рассказам Monsieur Лойд о твоих приключениях в прошлом-будущем.",shape=box,color=blue];
		j630995436 -> j4231093281;
	j536548774 [label="Ah, je vois! Je suis une idiote, c'est ça?! Juste une petite invalide venue d'un passé lointain, incapable de penser par elle-même?! Mieux vaut l'approcher comme un faon dans les bois, de peur de l'effrayer!",shape=box,color=blue];
		j536548774 -> j2523403966;
	j2751090361 [label="Ах, да… Я, наверное, совсем не сделала это лёгким для тебя, говорить правду, n'est-ce pas?",shape=box,color=blue];
		j2751090361 -> j2698728403;
	j3436506676 [label="Я простила его за то, что он покинул нас. Не думаю, что кто-то ещё способен на это...",shape=box,color=blue];
		j3436506676 -> j753344693;
		j3436506676 -> j4183769464;
	j1825355270 [label="Кардинал должен найти дорогу обратно к нам. Мы можем лишь сделать всё возможное, чтобы помочь ему, когда он позовёт, и следовать указаниям тех, кто, как он, благословлён.",shape=box,color=blue];
		j1825355270 -> j989297039;
	j717630067 [label="+5 Chemistry",color=orange];
		j717630067 -> j1192972674;
	j3221590514 [label="+5 Chemistry",color=orange];
		j3221590514 -> j3163789438;
	j4116034761 [label="Я думаю, что сначала какая-то часть его искала хотя бы частичку той дочери, которую он оставил. Но вместо этого он нашёл способ бороться с Безразличием - с теми эмоциями, от которых пытался дистанцироваться.",shape=box,color=red];
		j4116034761 -> j3926378840;
	j684748256 [label="Его заметки рассказывают весьма отвратительную самовосхваляющую историю о том, как он отправился изучать концептуальное воплощение, а вместо этого усвоил ценность борьбы с Безразличием.",shape=box,color=red];
		j684748256 -> j2044161954;
	j1744720416 [label="Если верить его записям, он был там, чтобы научить Дувири — и, соответственно, меня — защищаться от Безразличия. И какая от этого польза в итоге?",shape=box,color=red];
		j1744720416 -> j4196067948;
	j4231093281 [label="Check boolean IsDating",color=orange];
		j4231093281 -> j851932387 [label=true,color=green];
		j4231093281 -> j3194528018 [label=false,color=brown];
	j2523403966 [label="Va t'asseoir sur une ruche.",shape=box,color=blue];
		j2523403966 -> j1508231473;
	j2698728403 [label="Так скажи же мне правду, волк. Почему ты считаешь, что ему нельзя доверять? И я постараюсь сдержать свой гнев.",shape=box,color=blue];
		j2698728403 -> j4183769464;
		j2698728403 -> j3619544922;
		j2698728403 -> j418915886;
		j2698728403 -> j2308985542;
	j989297039 [label="Evaluate expressions",color=orange];
		j989297039 -> j1490571476 [label="MarieEntratiMonster1",color=purple];
		j989297039 -> j2237017247 [label="MarieEntratiMonster1",color=purple];
		j989297039 -> j1490571476 [label="MarieEntratiFan1",color=purple];
		j989297039 -> j2324516095 [label="MarieEntratiFan1",color=purple];
		j989297039 -> j1490571476 [label="false",color=purple];
		j989297039 -> j2237017247 [label="false",color=purple];
		j989297039 -> j2324516095 [label="false",color=purple];
		j989297039 -> j1710920601 [label="false",color=purple];
	j1192972674 [label="Да, верно. Думаю, его преследует чувство вины за всё, что он совершил. Полагаю, он намеренно дистанцируется от окружающих.",shape=box,color=blue];
		j1192972674 -> j258041841;
	j3163789438 [label="Да, это ужасное горе, ужасная боль. Знать, что кто-то... всё ещё жив, и, по-видимому, сознательно выбирает не быть рядом с тобой?",shape=box,color=blue];
		j3163789438 -> j258041841;
	j3926378840 [label="Mon cœur se brise dans la tragédie - Я не думаю, что смогу вынести всю эту печаль... и все же, она не простит его?",shape=box,color=blue];
		j3926378840 -> j1656594059;
		j3926378840 -> j1501010342;
	j2044161954 [label="Ты знаешь, почему он ушел?",shape=box,color=blue];
		j2044161954 -> j1656594059;
		j2044161954 -> j3190255428;
	j4196067948 [label="Ты о чём? ",shape=box,color=blue];
		j4196067948 -> j2760540284;
		j4196067948 -> j2318873909;
	j851932387 [label="В самом деле, если слухи среди Кавиа верны, vous y avez vraiment trouvé beaucoup de joie, non?",shape=box,color=blue];
		j851932387 -> j3194528018;
	j3194528018 [label="Нет, Кардинал причинил куда больше зла многим другим, ты просто злишься из-за того, что тебе доставили неудобства.",shape=box,color=blue];
		j3194528018 -> j1591510439;
	j1490571476 [label="Я просто хочу, чтобы… все вокруг Энтрати перестали винить себя и друг друга за то, что произошло.",shape=box,color=red];
		j1490571476 -> j1133972297;
	j2237017247 [label="Не знаю, смогу ли я когда-нибудь назвать его святым.",shape=box,color=red];
		j2237017247 -> j1235899194;
	j2324516095 [label="Было бы гораздо легче простить Энтрати за его проступки, если бы можно было их понять.",shape=box,color=red];
		j2324516095 -> j2665764906;
	j1710920601 [label="Я сделаю всё, что ему от меня нужно, чтобы решить эту проблему. А потом, когда всё будет сказано и сделано, я его осужу.",shape=box,color=red];
		j1710920601 -> j2566963915;
	j258041841 [label="Il inflige la douleur dans le cœur des autres, car la douleur vaut mieux que rien du tout. Ибо страдание лучше пустоты, не так ли?",shape=box,color=blue];
		j258041841 -> j2083520110;
	j1656594059 [label="Боюсь, если он не объяснится, нам остается только придумывать собственные причины.",shape=box,color=red];
		j1656594059 -> j2021246683;
	j1501010342 [label="Ты не понимаешь. Он оставил меня там. Он увидел кого-то брошенного в Бездне, и всё равно оставил меня там.",shape=box,color=red];
		j1501010342 -> j544580505;
	j3190255428 [label="Нет. Я просто знаю, что он оставил меня там. Он увидел кого-то, брошенного в Бездне, и просто… оставил меня там.",shape=box,color=red];
		j3190255428 -> j2021246683;
	j2760540284 [label="Он оставил меня там. Он появился, в какой-то момент, я не знаю, и увидел кого-то, брошенного в Бездне, и... оставил меня там.",shape=box,color=red];
		j2760540284 -> j544580505;
	j2318873909 [label="В конце концов, Безразличие всё равно пришло в Дувири. (Хотя с неожиданной помощью, но это уже не важно)",shape=box,color=red];
		j2318873909 -> j4011095572;
	j1133972297 [label="Boolean MarieEntratiFamily is now true.",color=orange];
		j1133972297 -> j2862059757;
	j1235899194 [label="Тогда, я думаю, мы можем продолжать соглашаться или не соглашаться.",shape=box,color=blue];
		j1235899194 -> j829653963;
	j2665764906 [label="Я молюсь, чтобы в конце концов так и случилось. Молюсь, чтобы мы все дожили до этого момента. А пока я вижу семью вокруг себя и молюсь, чтобы они нашли прощение в своих сердцах. Ради собственного счастья.",shape=box,color=blue];
		j2665764906 -> j429806559;
	j2566963915 [label="+10 Chemistry",color=orange];
		j2566963915 -> j1030930978;
	j2083520110 [label="Этот урок мой дорогой Лион усвоил лучше многих… Я так рада, что он теперь разговаривает с тобой. Но сегодня мы говорим о Кардинале.",shape=box,color=blue];
		j2083520110 -> j221931327;
	j2021246683 [label="Я могу только предположить, что это произошло до... murder ad infinitum.",shape=box,color=red];
		j2021246683 -> j3874196736;
	j544580505 [label="И ты не знаешь, почему он тебя там оставил?",shape=box,color=blue];
		j544580505 -> j414794056;
		j544580505 -> j2021246683;
		j544580505 -> j3626532898;
	j4011095572 [label="Нет. Ждать. У L'Indifférence есть... союзник?",shape=box,color=blue];
		j4011095572 -> j1774150617;
		j4011095572 -> j1566511738;
	j2862059757 [label="Add 1 to Family counter",color=orange];
		j2862059757 -> j2014029704;
	j829653963 [label="Boolean MarieEntratiMonster2 is now true.",color=orange];
		j829653963 -> j2607789382;
	j429806559 [label="Boolean MarieEntratiFan2 is now true.",color=orange];
		j429806559 -> j2607789382;
	j1030930978 [label="Oui, c'est raisonnable, и вполне справедливо, учитывая всё, что ты видел и знаешь. Я не могу просить от тебя большего.",shape=box,color=blue];
		j1030930978 -> j321226664;
	j221931327 [label="Boolean MarieLyonSuffering3 is now true.",color=orange];
		j221931327 -> j1591510439;
	j3874196736 [label="Тогда я должна попросить тебя не предполагать о нём худшего, ведь это ожесточит твоё сердце. ",shape=box,color=blue];
		j3874196736 -> j2357593951;
	j414794056 [label="Я могу только надеяться, что у него была веская причина.",shape=box,color=red];
		j414794056 -> j1416864853;
	j3626532898 [label="Нет, и это неважно. Он мог бы меня спасти. Но не спас.",shape=box,color=red];
		j3626532898 -> j1067141663;
	j1774150617 [label="Оно просто носит другое лицо.",shape=box,color=red];
		j1774150617 -> j2457606619;
	j1566511738 [label="Возможно? Или заложник. Или оно просто носит её лицо. Мы толком не знаем.",shape=box,color=red];
		j1566511738 -> j2457606619;
	j2014029704 [label="+10 Chemistry",color=orange];
		j2014029704 -> j127501284;
	j2607789382 [label="Ах, Лион зовет меня. À la revoyure!",shape=box,color=blue];
