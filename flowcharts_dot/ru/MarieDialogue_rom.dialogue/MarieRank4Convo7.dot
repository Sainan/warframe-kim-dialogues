digraph {
	graph [fontname="Roboto Condensed"];
	node [fontname="Roboto Condensed"];
	edge [fontname="Roboto Condensed"];

	"MarieRank4Convo7 begins." [color=orange];
		"MarieRank4Convo7 begins." -> j2946575423;
	j2946575423 [label="Boolean MarieLyonAvailable is now true.",color=orange];
		j2946575423 -> j3255816954;
	j3255816954 [label="Evaluate expressions on HellKeyPlayed counter",color=orange];
		j3255816954 -> j3408529405 [label="x >= 0",color=purple];
		j3255816954 -> "Chat ends." [label="x <= 0",color=purple];
		j3255816954 -> "Chat ends." [label="false",color=purple];
	j3408529405 [label="Скиталец, excusez-moi... Неужели ты и в самом деле веришь, что это мудро помогать дьяволу?",shape=box,color=blue];
		j3408529405 -> j2711080606;
	"Chat ends." [color=orange];
	j2711080606 [label="Я не желаю отворачивать от себя тех, кто ищет отпущения грехов или спасения, но... я также не думаю, что дьявол приходит за тем же.",shape=box,color=blue];
		j2711080606 -> j1627716072;
		j2711080606 -> j3670046937;
		j2711080606 -> j3271821374;
		j2711080606 -> j1310452999;
	j1627716072 [label="И что же, по-твоему, он ищет на самом деле?",shape=box,color=red];
		j1627716072 -> j124104969;
	j3670046937 [label="Мне известно, что вы двое не ладите друг с другом, и я сожалею об этом. Но я ведь не могу просто выгнать его.",shape=box,color=red];
		j3670046937 -> j3370349534;
	j3271821374 [label="Роут забыл об Орокин больше - в буквальном смысле этого слова - чем мы когда-либо узнаем. Он нам нужен.",shape=box,color=red];
		j3271821374 -> j3503286609;
	j1310452999 [label="[Конец.]",shape=box,color=red];
		j1310452999 -> "Chat ends.";
	j124104969 [label="Он — дикое существо. Приблизится, если предложить еду и тёплую постель, но вдруг исчезнет, как только он решит, что пользы от тебя нет.",shape=box,color=blue];
		j124104969 -> j1568519343;
	j3370349534 [label="Add 1 to Thermostat counter",color=orange];
		j3370349534 -> j3632129482;
	j3503286609 [label="Add -1 to Thermostat counter",color=orange];
		j3503286609 -> j124104969;
	j1568519343 [label="Ему что-то нужно от тебя. От нас. ",shape=box,color=blue];
		j1568519343 -> j863296879;
	j3632129482 [label="Non, и я вовсе не предлагаю, тебе это делать. Просто он... не заслуживает доверия. Ни сейчас, ни когда-либо.",shape=box,color=blue];
		j3632129482 -> j124104969;
	j863296879 [label="Evaluate expressions on HellKeyPlayed counter",color=orange];
		j863296879 -> j4093421340 [label="x > 5",color=purple];
		j863296879 -> j1074523869 [label="x <= 5",color=purple];
		j863296879 -> j1074523869 [label="false",color=purple];
	j4093421340 [label="Evaluate expressions on HellKeyPlayed counter",color=orange];
		j4093421340 -> j3523851019 [label="x >= 21",color=purple];
		j4093421340 -> j1598612613 [label="x < 21",color=purple];
		j4093421340 -> j1598612613 [label="false",color=purple];
	j1074523869 [label="Эти утраченные им воспоминания, эти былые ужасы Тау... меня беспокоит то, что они предвещают.",shape=box,color=blue];
		j1074523869 -> j2576831397;
		j1074523869 -> j112660369;
	j3523851019 [label="Я знаю, ты думаешь, что мы раскрыли всё, что можно было узнать в его разбитом разуме.",shape=box,color=blue];
		j3523851019 -> j3194361364;
		j3523851019 -> j112660369;
	j1598612613 [label="Чем больше мы узнаём, чем глубже погружаемся в его разбитый разум, тем сильнее меня охватывает тревога. Тем очевиднее становится опасность.",shape=box,color=blue];
		j1598612613 -> j112660369;
		j1598612613 -> j2576831397;
	j2576831397 [label="Я не думаю, что он просто исчезнет в тот момент, когда вернёт себе память. Здесь есть нечто большее.",shape=box,color=red];
		j2576831397 -> j4149340823;
	j112660369 [label="Вполне вероятно, что он жаждет чего-то большего. Не в своих воспоминаниях, а от нас.",shape=box,color=red];
		j112660369 -> j4230752006;
	j3194361364 [label="Я верю ему, когда он говорит, что это всё, что мы узнаем. И если это так, то почему он всё ещё здесь?",shape=box,color=red];
		j3194361364 -> j4149340823;
	j4149340823 [label="Признаюсь, меня больше тревожит то, что он намерен сделать с этим знанием, а не само знание.",shape=box,color=blue];
		j4149340823 -> j1626368238;
	j4230752006 [label="Oui! Я беспокоюсь именно из-за этого. Но что это может быть? Какой его цели мы сейчас служим?",shape=box,color=blue];
		j4230752006 -> j1626368238;
	j1626368238 [label="Каким бы образом он не собирался вести своё новое существование, я боюсь, что он попытается вовлечь нас. И я просто хочу, чтобы мы не позволяли себе ослепнуть в надежде на его доброжелательность.",shape=box,color=blue];
		j1626368238 -> j2081725898;
		j1626368238 -> j4068291813;
		j1626368238 -> j3932320930;
	j2081725898 [label="Я с тобой. Я ему не доверяю.",shape=box,color=red];
		j2081725898 -> j949409210;
	j4068291813 [label="Он могущественный и знающий. Он тот, кого я бы очень хотел иметь на моей стороне.",shape=box,color=red];
		j4068291813 -> j1439723141;
	j3932320930 [label="Нет смысла гадать, предаст он нас или нет - он этого не сделал. И я не считаю людей виновными в грехах, которых они ещё не совершили.",shape=box,color=red];
		j3932320930 -> j577536839;
	j949409210 [label="+20 Chemistry",color=orange];
		j949409210 -> j572794042;
	j1439723141 [label="Add -1 to Thermostat counter",color=orange];
		j1439723141 -> j1869763764;
	j577536839 [label="Add 1 to Thermostat counter",color=orange];
		j577536839 -> j2837792642;
	j572794042 [label="Bien! Тогда мне будет спокойнее, зная, что и другие глаза следят за этим дьяволом. Возможно, это поможет мне уснуть. Merci.",shape=box,color=blue];
		j572794042 -> j3984234322;
	j1869763764 [label="Oui, но мне интересно, какова будет окончательная цена этого союза. Конечный результат может оказаться не таким, на который надеялись.",shape=box,color=blue];
		j1869763764 -> j845568025;
	j2837792642 [label="Oui... я думаю, правда твоя. Мы не можем преследовать тени. Мы должны стоять плечом к плечу со всеми, кто желает победить Безразличие.",shape=box,color=blue];
		j2837792642 -> j808986917;
	j3984234322 [label="Boolean MarieRoatheNoTrust is now true.",color=orange];
		j3984234322 -> "Chat ends.";
	j845568025 [label="Я лишь хочу посоветовать тебе быть осторожнее... это чудовище, облачённое в кожу джентльмена. Будь осторожен с ним, s'il te plaît?",shape=box,color=blue];
		j845568025 -> j4011145589;
		j845568025 -> j3062537530;
	j808986917 [label="Check boolean DrifterFaithNoMITW",color=orange];
		j808986917 -> j3180210047 [label=true,color=green];
		j808986917 -> j2527231819 [label=false,color=brown];
	j4011145589 [label="Я думаю, ты немного несправедлива к нему.",shape=box,color=red];
		j4011145589 -> j1293420193;
	j3062537530 [label="Я не буду рисковать, обещаю.",shape=box,color=red];
		j3062537530 -> j2697932879;
	j3180210047 [label="Даже если ты веришь, что сила, стоящая за всем этим, исходит не от бога, а нашими собственным разумом, это всё равно остаётся угрозой.",shape=box,color=blue];
		j3180210047 -> j845568025;
	j2527231819 [label="Даже если он верит, что сила, стоящая за всем этим, исходит не от бога, а нашими собственным разумом, это всё равно остаётся угрозой.",shape=box,color=blue];
		j2527231819 -> j845568025;
	j1293420193 [label="Add -1 to Thermostat counter",color=orange];
		j1293420193 -> j635509809;
	j2697932879 [label="+20 Chemistry",color=orange];
		j2697932879 -> j1834974611;
	j635509809 [label="Oui? В каком смысле? Я говорю это не с жестокостью, мне действительно любопытно.",shape=box,color=blue];
		j635509809 -> j1925373398;
		j635509809 -> j4073459567;
		j635509809 -> j3949311507;
		j635509809 -> j2876453069;
	j1834974611 [label="Merci. Я больше ничего не прошу.",shape=box,color=blue];
		j1834974611 -> "Chat ends.";
	j1925373398 [label="Он вырос в другом обществе, в другое время - с другими ожиданиями. Нам может это не нравиться, но он такой, какой есть.",shape=box,color=red];
		j1925373398 -> j449433254;
	j4073459567 [label="Ты и Лион приняли протофреймовую сыворотку от Энтрати. Добровольно. Он нет. Представь, каково это?",shape=box,color=red];
		j4073459567 -> j535225286;
		j4073459567 -> j2188950235;
		j4073459567 -> j449433254;
	j3949311507 [label="Он прошел через целые века, делая то, что считал необходимым. Мы просто не согласны с тем, что это значит.",shape=box,color=red];
		j3949311507 -> j535225286;
		j3949311507 -> j2059865251;
	j2876453069 [label="Я думаю, что в общем... тебя отталкивает его поведение. А не действия.",shape=box,color=red];
		j2876453069 -> j2059865251;
		j2876453069 -> j535225286;
	j449433254 [label="Он высокопоставленный солдат и светский человек. И оба эти качества иногда требуют принятия непростых решений.",shape=box,color=red];
		j449433254 -> j681163897;
	j535225286 [label="Я думаю, что человек может делать то, что мы считаем «неправильным», и делать это с добрыми намерениями.",shape=box,color=red];
		j535225286 -> j3903879267;
	j2188950235 [label="Он сделал всё, что мог, во имя спасения Империи Орокин - и в благодарность за это он оказался втянутым в эту историю против своей воли.",shape=box,color=red];
		j2188950235 -> j681163897;
	j2059865251 [label="Я думаю, он раздражает тебя, потому что гордится тем, что сделал.",shape=box,color=red];
		j2059865251 -> j3882848207;
	j681163897 [label="Check boolean MarieGrineer",color=orange];
		j681163897 -> j1845726482 [label=true,color=green];
		j681163897 -> j1981980746 [label=false,color=brown];
	j3903879267 [label="Ты видишь в нём дьявола, но для него самого это мысль, максимально далёкая от истины.",shape=box,color=red];
		j3903879267 -> j681163897;
	j3882848207 [label="Oui, мне не нравятся те, кто наслаждается смертью. И я нахожу его стремление пролить кровь тревожным. И тот факт, что ты не находишь это тревожным, тревожит не меньше.",shape=box,color=blue];
		j3882848207 -> j1299928439;
	j1845726482 [label="И я думаю, что те, кто командует этими «Корпусами» или «Гринирами», с которыми ты сражаешься, сказали бы то же самое. Они не считают себя неправыми.",shape=box,color=blue];
		j1845726482 -> j2984451800;
	j1981980746 [label="И я думаю, что те, кто командует этими «Корпусами» или «Гринир-ами», с которыми ты сражаешься, сказали бы то же самое. Они не считают себя неправыми.",shape=box,color=blue];
		j1981980746 -> j2984451800;
	j1299928439 [label="Слишком легко позволить пути самоотречения обратиться в грех насилия, отвергнуть его ужас, объявив его бессмысленным во имя того, «что действительно важно».",shape=box,color=blue];
		j1299928439 -> j2272456577;
	j2984451800 [label="Они верят, что их деяния справедливы, благие и необходимы. Как можно прощать одного дьявола, но не другого?",shape=box,color=blue];
		j2984451800 -> j2209499423;
		j2984451800 -> j3003370294;
		j2984451800 -> j42661998;
		j2984451800 -> j95190378;
	j2272456577 [label="Гордиться самим деянием... это уже слишком для меня. Я не испытываю радости, когда приходится отнимать чью-то жизнь, а он — да. Вот так, выходит? Мы совершенно разные.",shape=box,color=blue];
		j2272456577 -> j1584174005;
	j2209499423 [label="Я постараюсь остановить их, когда они делают то, с чем у меня нет согласия. Но… я буду сражаться вместе с ними, когда понадобится.",shape=box,color=red];
		j2209499423 -> j620083190;
	j3003370294 [label="Я не верю, что эти группы являются «хорошими» или «плохими» по определению. Только в тех действиях, которые они решают предпринять.",shape=box,color=red];
		j3003370294 -> j2374602993;
	j42661998 [label="Я не вправе решать, какие действия «хорошие», а какие «плохие». Я делаю то, что делаю, чтобы защитить людей, которые нуждаются в защите.",shape=box,color=red];
		j42661998 -> j620083190;
	j95190378 [label="Ты просишь меня судить о целой группе людей по тем же критериям, по которым я мог бы судить об отдельном человеке.",shape=box,color=red];
		j95190378 -> j2374602993;
	j1584174005 [label="Я могу лишь молиться, чтобы не было слишком поздно, если дьявол решит вонзить свой нож тебе в рёбра. Не хочу, чтобы твои последние мысли были: «Мари предупреждала меня».",shape=box,color=blue];
		j1584174005 -> j3535272154;
		j1584174005 -> j1506618728;
	j620083190 [label="И ты полагаешь, что дьявол не представляет угрозы? Что он не dangereux для окружающих? Он способен причинить большое вред.",shape=box,color=blue];
		j620083190 -> j396872000;
		j620083190 -> j3559567988;
	j2374602993 [label="А как насчёт ужасных деяний, что он совершил? Все эти смерти, вся эта резня? Неужели ты считаешь, что всё это было оправдано?",shape=box,color=blue];
		j2374602993 -> j3559567988;
	j3535272154 [label="Он не станет этого делать. А если он попытается, я его остановлю.",shape=box,color=red];
		j3535272154 -> j1727433332;
	j1506618728 [label="Я обещаю, что это не будут мои последние мысли.",shape=box,color=red];
		j1506618728 -> j351614075;
	j396872000 [label="Если настанет время, когда он повернётся против нас, я буду действовать. До тех пор он проявлял себя лишь союзником. Если... слегка мелодраматично.",shape=box,color=red];
		j396872000 -> j1069354950;
	j3559567988 [label="Я не рассматриваю его опасные качества как проблему. Он представляет собой оружие. А оружие может служить как для убийства, так и для защиты.",shape=box,color=red];
		j3559567988 -> j256230697;
	j1727433332 [label="Я восхищаюсь твоей верой в себя, хотя мне и жаль, что эта вера распространяется и на него. Так что, полагаю, я, в свою очередь, буду верить в тебя.",shape=box,color=blue];
		j1727433332 -> j2454419430;
	j351614075 [label="Я полагаю, что ты вкладываешь в эти слова не тот смысл, на который я надеялась, но я не стану искать в них слишком большого значения.",shape=box,color=blue];
		j351614075 -> j2454419430;
	j1069354950 [label="Add 1 to Thermostat counter",color=orange];
		j1069354950 -> j1584174005;
	j256230697 [label="Add -1 to Thermostat counter",color=orange];
		j256230697 -> j1584174005;
	j2454419430 [label="Мне нужно идти. Но снова прошу тебя - не рискуй. Ради меня, если не ради себя, d’accord?",shape=box,color=blue];
		j2454419430 -> j367054140;
	j367054140 [label="+20 Chemistry",color=orange];
		j367054140 -> "Chat ends.";
}