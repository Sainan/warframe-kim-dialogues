digraph {
	1842 [label="MarieRank4Convo7 begins.",color=orange];
		1842 -> 1843;
	1843 [label="Evaluate expressions on HellKeyPlayed",color=orange];
		1843 -> 1844 [label="x >= 0",color=purple];
		1843 -> 1845 [label="x <= 0",color=purple];
		1843 -> 1845 [label="false",color=purple];
	1844 [label="Скиталец, excusez-moi... Неужели ты и в самом деле веришь, что это мудро помогать дьяволу?",shape=box,color=blue];
		1844 -> 1846;
	1845 [label="Chat ends.",color=orange];
	1846 [label="Я не желаю отворачивать от себя тех, кто ищет отпущения грехов или спасения, но... я также не думаю, что дьявол приходит за тем же.",shape=box,color=blue];
		1846 -> 1847;
		1846 -> 1848;
		1846 -> 1849;
		1846 -> 1850;
	1847 [label="И что же, по-твоему, он ищет на самом деле?",shape=box,color=red];
		1847 -> 1851;
	1848 [label="Мне известно, что вы двое не ладите друг с другом, и я сожалею об этом. Но я ведь не могу просто выгнать его.",shape=box,color=red];
		1848 -> 1852;
	1849 [label="Роут забыл об Орокин больше - в буквальном смысле этого слова - чем мы когда-либо узнаем. Он нам нужен.",shape=box,color=red];
		1849 -> 1853;
	1850 [label="[Конец.]",shape=box,color=red];
		1850 -> 1854;
	1851 [label="Он — дикое существо. Приблизится, если предложить еду и тёплую постель, но вдруг исчезнет, как только он решит, что пользы от тебя нет.",shape=box,color=blue];
		1851 -> 1855;
	1852 [label="Add 1 to Thermostat",color=orange];
		1852 -> 1856;
	1853 [label="Add -1 to Thermostat",color=orange];
		1853 -> 1851;
	1854 [label="Chat ends.",color=orange];
	1855 [label="Ему что-то нужно от тебя. От нас. ",shape=box,color=blue];
		1855 -> 1857;
	1856 [label="Non, и я вовсе не предлагаю, тебе это делать. Просто он... не заслуживает доверия. Ни сейчас, ни когда-либо.",shape=box,color=blue];
		1856 -> 1851;
	1857 [label="Evaluate expressions on HellKeyPlayed",color=orange];
		1857 -> 1859 [label="x > 5",color=purple];
		1857 -> 1858 [label="x <= 5",color=purple];
		1857 -> 1858 [label="false",color=purple];
	1859 [label="Evaluate expressions on HellKeyPlayed",color=orange];
		1859 -> 1863 [label="x >= 21",color=purple];
		1859 -> 1862 [label="x < 21",color=purple];
		1859 -> 1862 [label="false",color=purple];
	1858 [label="Эти утраченные им воспоминания, эти былые ужасы Тау... меня беспокоит то, что они предвещают.",shape=box,color=blue];
		1858 -> 1860;
		1858 -> 1861;
	1863 [label="Я знаю, ты думаешь, что мы раскрыли всё, что можно было узнать в его разбитом разуме.",shape=box,color=blue];
		1863 -> 1866;
		1863 -> 1861;
	1862 [label="Чем больше мы узнаём, чем глубже погружаемся в его разбитый разум, тем сильнее меня охватывает тревога. Тем очевиднее становится опасность.",shape=box,color=blue];
		1862 -> 1861;
		1862 -> 1860;
	1860 [label="Я не думаю, что он просто исчезнет в тот момент, когда вернёт себе память. Здесь есть нечто большее.",shape=box,color=red];
		1860 -> 1864;
	1861 [label="Вполне вероятно, что он жаждет чего-то большего. Не в своих воспоминаниях, а от нас.",shape=box,color=red];
		1861 -> 1865;
	1866 [label="Я верю ему, когда он говорит, что это всё, что мы узнаем. И если это так, то почему он всё ещё здесь?",shape=box,color=red];
		1866 -> 1864;
	1864 [label="Признаюсь, меня больше тревожит то, что он намерен сделать с этим знанием, а не само знание.",shape=box,color=blue];
		1864 -> 1867;
	1865 [label="Oui! Я беспокоюсь именно из-за этого. Но что это может быть? Какой его цели мы сейчас служим?",shape=box,color=blue];
		1865 -> 1867;
	1867 [label="Каким бы образом он не собирался вести своё новое существование, я боюсь, что он попытается вовлечь нас. И я просто хочу, чтобы мы не позволяли себе ослепнуть в надежде на его доброжелательность.",shape=box,color=blue];
		1867 -> 1868;
		1867 -> 1869;
		1867 -> 1870;
	1868 [label="Я с тобой. Я ему не доверяю.",shape=box,color=red];
		1868 -> 1871;
	1869 [label="Он могущественный и знающий. Он тот, кого я бы очень хотел иметь на моей стороне.",shape=box,color=red];
		1869 -> 1872;
	1870 [label="Нет смысла гадать, предаст он нас или нет - он этого не сделал. И я не считаю людей виновными в грехах, которых они ещё не совершили.",shape=box,color=red];
		1870 -> 1873;
	1871 [label="+20 Chemistry",color=orange];
		1871 -> 1874;
	1872 [label="Add -1 to Thermostat",color=orange];
		1872 -> 1875;
	1873 [label="Add 1 to Thermostat",color=orange];
		1873 -> 1876;
	1874 [label="Bien! Тогда мне будет спокойнее, зная, что и другие глаза следят за этим дьяволом. Возможно, это поможет мне уснуть. Merci.",shape=box,color=blue];
		1874 -> 1877;
	1875 [label="Oui, но мне интересно, какова будет окончательная цена этого союза. Конечный результат может оказаться не таким, на который надеялись.",shape=box,color=blue];
		1875 -> 1878;
	1876 [label="Oui... я думаю, правда твоя. Мы не можем преследовать тени. Мы должны стоять плечом к плечу со всеми, кто желает победить Безразличие.",shape=box,color=blue];
		1876 -> 1879;
	1877 [label="Update boolean MarieRoatheNoTrust",color=orange];
		1877 -> 1880;
	1878 [label="Я лишь хочу посоветовать тебе быть осторожнее... это чудовище, облачённое в кожу джентльмена. Будь осторожен с ним, s'il te plaît?",shape=box,color=blue];
		1878 -> 1881;
		1878 -> 1882;
	1879 [label="Check boolean DrifterFaithNoMITW",color=orange];
		1879 -> 1883 [label=true,color=green];
		1879 -> 1884 [label=false,color=brown];
	1880 [label="Chat ends.",color=orange];
	1881 [label="Я думаю, ты немного несправедлива к нему.",shape=box,color=red];
		1881 -> 1885;
	1882 [label="Я не буду рисковать, обещаю.",shape=box,color=red];
		1882 -> 1886;
	1883 [label="Даже если ты веришь, что сила, стоящая за всем этим, исходит не от бога, а нашими собственным разумом, это всё равно остаётся угрозой.",shape=box,color=blue];
		1883 -> 1878;
	1884 [label="Даже если он верит, что сила, стоящая за всем этим, исходит не от бога, а нашими собственным разумом, это всё равно остаётся угрозой.",shape=box,color=blue];
		1884 -> 1878;
	1885 [label="Add -1 to Thermostat",color=orange];
		1885 -> 1887;
	1886 [label="+20 Chemistry",color=orange];
		1886 -> 1888;
	1887 [label="Oui? В каком смысле? Я говорю это не с жестокостью, мне действительно любопытно.",shape=box,color=blue];
		1887 -> 1889;
		1887 -> 1890;
		1887 -> 1891;
		1887 -> 1892;
	1888 [label="Merci. Я больше ничего не прошу.",shape=box,color=blue];
		1888 -> 1893;
	1889 [label="Он вырос в другом обществе, в другое время - с другими ожиданиями. Нам может это не нравиться, но он такой, какой есть.",shape=box,color=red];
		1889 -> 1894;
	1890 [label="Ты и Лион приняли протофреймовую сыворотку от Энтрати. Добровольно. Он нет. Представь, каково это?",shape=box,color=red];
		1890 -> 1895;
		1890 -> 1896;
		1890 -> 1894;
	1891 [label="Он прошел через целые века, делая то, что считал необходимым. Мы просто не согласны с тем, что это значит.",shape=box,color=red];
		1891 -> 1895;
		1891 -> 1897;
	1892 [label="Я думаю, что в общем... тебя отталкивает его поведение. А не действия.",shape=box,color=red];
		1892 -> 1897;
		1892 -> 1895;
	1893 [label="Chat ends.",color=orange];
	1894 [label="Он высокопоставленный солдат и светский человек. И оба эти качества иногда требуют принятия непростых решений.",shape=box,color=red];
		1894 -> 1898;
	1895 [label="Я думаю, что человек может делать то, что мы считаем «неправильным», и делать это с добрыми намерениями.",shape=box,color=red];
		1895 -> 1899;
	1896 [label="Он сделал всё, что мог, во имя спасения Империи Орокин - и в благодарность за это он оказался втянутым в эту историю против своей воли.",shape=box,color=red];
		1896 -> 1898;
	1897 [label="Я думаю, он раздражает тебя, потому что гордится тем, что сделал.",shape=box,color=red];
		1897 -> 1900;
	1898 [label="Check boolean MarieGrineer",color=orange];
		1898 -> 1902 [label=true,color=green];
		1898 -> 1901 [label=false,color=brown];
	1899 [label="Ты видишь в нём дьявола, но для него самого это мысль, максимально далёкая от истины.",shape=box,color=red];
		1899 -> 1898;
	1900 [label="Oui, мне не нравятся те, кто наслаждается смертью. И я нахожу его стремление пролить кровь тревожным. И тот факт, что ты не находишь это тревожным, тревожит не меньше.",shape=box,color=blue];
		1900 -> 1903;
	1902 [label="И я думаю, что те, кто командует этими «Корпусами» или «Гринирами», с которыми ты сражаешься, сказали бы то же самое. Они не считают себя неправыми.",shape=box,color=blue];
		1902 -> 1904;
	1901 [label="И я думаю, что те, кто командует этими «Корпусами» или «Гринир-ами», с которыми ты сражаешься, сказали бы то же самое. Они не считают себя неправыми.",shape=box,color=blue];
		1901 -> 1904;
	1903 [label="Слишком легко позволить пути самоотречения обратиться в грех насилия, отвергнуть его ужас, объявив его бессмысленным во имя того, «что действительно важно».",shape=box,color=blue];
		1903 -> 1905;
	1904 [label="Они верят, что их деяния справедливы, благие и необходимы. Как можно прощать одного дьявола, но не другого?",shape=box,color=blue];
		1904 -> 1906;
		1904 -> 1907;
		1904 -> 1908;
		1904 -> 1909;
	1905 [label="Гордиться самим деянием... это уже слишком для меня. Я не испытываю радости, когда приходится отнимать чью-то жизнь, а он — да. Вот так, выходит ? Мы совершенно разные.",shape=box,color=blue];
		1905 -> 1910;
	1906 [label="Я постараюсь остановить их, когда они делают то, с чем у меня нет согласия. Но… я буду сражаться вместе с ними, когда понадобится.",shape=box,color=red];
		1906 -> 1911;
	1907 [label="Я не верю, что эти группы являются «хорошими» или «плохими» по определению. Только в тех действиях, которые они решают предпринять.",shape=box,color=red];
		1907 -> 1912;
	1908 [label="Я не вправе решать, какие действия «хорошие», а какие «плохие». Я делаю то, что делаю, чтобы защитить людей, которые нуждаются в защите.",shape=box,color=red];
		1908 -> 1911;
	1909 [label="Ты просишь меня судить о целой группе людей по тем же критериям, по которым я мог бы судить об отдельном человеке.",shape=box,color=red];
		1909 -> 1912;
	1910 [label="Я могу лишь молиться, чтобы не было слишком поздно, если дьявол решит вонзить свой нож тебе в рёбра. Не хочу, чтобы твои последние мысли были: «Мари предупреждала меня».",shape=box,color=blue];
		1910 -> 1913;
		1910 -> 1914;
	1911 [label="И ты полагаешь, что дьявол не представляет угрозы ? Что он не dangereux для окружающих ? Он способен причинить большое вред.",shape=box,color=blue];
		1911 -> 1915;
		1911 -> 1916;
	1912 [label="А как насчёт ужасных деяний, что он совершил ? Все эти смерти, вся эта резня? Неужели ты считаешь, что всё это было оправдано ?",shape=box,color=blue];
		1912 -> 1916;
	1913 [label="Он не станет этого делать. А если он попытается, я его остановлю.",shape=box,color=red];
		1913 -> 1917;
	1914 [label="Я обещаю, что это не будут мои последние мысли.",shape=box,color=red];
		1914 -> 1918;
	1915 [label="Если настанет время, когда он повернётся против нас, я буду действовать. До тех пор он проявлял себя лишь союзником. Если... слегка мелодраматично.",shape=box,color=red];
		1915 -> 1919;
	1916 [label="Я не рассматриваю его опасные качества как проблему. Он представляет собой оружие. А оружие может служить как для убийства, так и для защиты.",shape=box,color=red];
		1916 -> 1920;
	1917 [label="Я восхищаюсь твоей верой в себя, хотя мне и жаль, что эта вера распространяется и на него. Так что, полагаю, я, в свою очередь, буду верить в тебя.",shape=box,color=blue];
		1917 -> 1921;
	1918 [label="Я полагаю, что ты вкладываешь в эти слова не тот смысл, на который я надеялась, но я не стану искать в них слишком большого значения.",shape=box,color=blue];
		1918 -> 1921;
	1919 [label="Add 1 to Thermostat",color=orange];
		1919 -> 1910;
	1920 [label="Add -1 to Thermostat",color=orange];
		1920 -> 1910;
	1921 [label="Мне нужно идти. Но снова прошу тебя - не рискуй. Ради меня, если не ради себя, d’accord ?",shape=box,color=blue];
		1921 -> 1922;
	1922 [label="+20 Chemistry",color=orange];
		1922 -> 1923;
	1923 [label="Chat ends.",color=orange];
}