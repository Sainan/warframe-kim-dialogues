		j148501058 -> j2181451166 [label="MarieFamilyOther",color=purple];
		j148501058 -> j2443494855 [label="false",color=purple];
	j3980718873 [label="Думалось о том, как убедить Лойда наконец подняться по тем лестницам и поговорить с семьёй, и… у меня есть идея, но мне кажется, она тебе не понравится.",shape=box,color=red];
		j3980718873 -> j3431982611;
	j2181451166 [label="Ты уже думала о том, как убедить Лойда поговорить с семьей Энтрати наверху?",shape=box,color=red];
		j2181451166 -> j2607534784;
	j436289787 [label="По поводу попыток заставить Лойда и семью Энтрати поговорить… мне было интересно, не передумала ли ты насчёт участия Роута?",shape=box,color=red];
		j436289787 -> j1903226774;
	j177608807 [label="Мари, ты всё ещё не против… ну, попробовать убедить Лойда поговорить с «соседями сверху»? Знаю, мы тогда закончили этот разговор немного странно.",shape=box,color=red];
		j177608807 -> j1903226774;
	j2443494855 [label="Я размышляла о том, почему Monsieur Лойд так боится говорить с семьёй le Cardinal.",shape=box,color=blue];
		j2443494855 -> j3667434321;
	j3431982611 [label="Check boolean MarieDating",color=orange];
		j3431982611 -> j1464707314 [label=true,color=green];
		j3431982611 -> j1505916791 [label=false,color=brown];
	j2607534784 [label="Check boolean MarieDating",color=orange];
		j2607534784 -> j2741683493 [label=true,color=green];
		j2607534784 -> j2741683493 [label=false,color=brown];
	j1903226774 [label="Check boolean MarieDating",color=orange];
		j1903226774 -> j2723894982 [label=true,color=green];
		j1903226774 -> j86331251 [label=false,color=brown];
	j3667434321 [label="И как же нам нужно разорвать этот тупик. Это purgatoire, в котором мы застряли, не должно продолжаться. Оно кажется таким ненужно болезненным.",shape=box,color=blue];
		j3667434321 -> j3012673518;
	j1464707314 [label="Bonjour, mon cœur! И что же ты боишься, что мне не понравится?",shape=box,color=blue];
		j1464707314 -> j1705698412;
	j1505916791 [label="Bonjour! Ох? И что же ты боишься, что мне не понравится?",shape=box,color=blue];
		j1505916791 -> j1705698412;
	j2741683493 [label="Bonjour mon cœur! Я об этом подумала, oui.. и должна признаться, мне крайне не хочется это говорить. Это вовсе не доставляет мне удовольствия.",shape=box,color=blue];
		j2741683493 -> j2163610619;
	j2723894982 [label="Bonjour, bonjour, mon cœur! Я об этом подумала, oui... и должна признаться, мне крайне не хочется это говорить. Это вовсе не доставляет мне удовольствия.",shape=box,color=blue];
		j2723894982 -> j2411167931;
	j86331251 [label="Bonjour - Я об этом подумала, oui... и должна признаться, мне крайне не хочется это говорить. Это вовсе не доставляет мне удовольствия.",shape=box,color=blue];
		j86331251 -> j2411167931;
	j3012673518 [label="Но мне кажется, нам нужен... какой-то бастион, не? Есть идеи?",shape=box,color=blue];
		j3012673518 -> j2008897772;
		j3012673518 -> j1705698412;
	j1705698412 [label="Думаю, нам понадобится помощь Роута, чтобы убедить Лойда поговорить с семьёй Энтрати. Не думаю, что он сделает это иначе. Без гарантий, что семья и он сам будут в безопасности.",shape=box,color=red];
		j1705698412 -> j525362741;
	j2163610619 [label="Но я думаю... я думаю — ах, Сол, прости меня, — что может потребоваться помощь дьявола. Иначе, думаю, Monsieur Лойд, нас не послушает.",shape=box,color=blue];
		j2163610619 -> j2602888146;
	j2411167931 [label="Думаю, ты прав. Возможно, именно дьявол и есть то недостающее звено, которое нам нужно. Ах, мне даже печатать эти слова больно! ",shape=box,color=blue];
		j2411167931 -> j636489540;
	j2008897772 [label="У меня нет ни одной хорошей идеи, которая не предполагала бы обращения за помощью к ужасным источникам. Источникам, которые могут в дальнейшем вовлечь нас в серьёзные проблемы. А именно, к Роуту.",shape=box,color=red];
		j2008897772 -> j1812014718;
	j525362741 [label="Мне... неприятно это признавать, но я думаю, есть истина в твоих словах... Сол, прости меня.",shape=box,color=blue];
		j525362741 -> j636489540;
	j2602888146 [label="Дьявол могуществен, и обещает определённую силу, если что-то пойдёт не так, не правда ли?",shape=box,color=blue];
		j2602888146 -> j1121561661;
		j2602888146 -> j424319572;
	j636489540 [label="Evaluate expressions",color=orange];
		j636489540 -> j3775623791 [label="RoatheFamilyFail",color=purple];
		j636489540 -> j2935604910 [label="RoatheRedeemed, RoatheFamilyDelay
",color=purple];
		j636489540 -> j2935604910 [label="RoatheRedeemed, RoatheFamilySuccess
",color=purple];
		j636489540 -> j2394614552 [label="RoatheVillain, RoatheFamilyDelay
",color=purple];
		j636489540 -> j2394614552 [label="RoatheVillain, RoatheFamilySuccess",color=purple];
		j636489540 -> j1361353430 [label="false",color=purple];
	j1812014718 [label="Точно? Если я смогла отбросить свои разногласия с дьяволом, то и ты, конечно, сможешь, не так ли?",shape=box,color=blue];
		j1812014718 -> j2535590125;
		j1812014718 -> j959003753;
	j1121561661 [label="Нет, должен быть другой выход. Я отказываюсь просить его о помощи в этом вопросе.",shape=box,color=red];
		j1121561661 -> j1812014718;
	j424319572 [label="Правота на твоей стороне. Согласие твоё было неожиданным. Было страшно спросить.",shape=box,color=red];
		j424319572 -> j636489540;
	j3775623791 [label="Окажет ли он нам помощь в этом деле?",shape=box,color=blue];
		j3775623791 -> j2362530618;
	j2935604910 [label="Окажет ли он нам помощь в этом деле?",shape=box,color=blue];
		j2935604910 -> j3050539978;
	j2394614552 [label="Окажет ли он нам помощь в этом деле?",shape=box,color=blue];
		j2394614552 -> j1214221323;
	j1361353430 [label="Но как ты думаешь, сможешь ли ты убедить его помочь нам?",shape=box,color=blue];
		j1361353430 -> j2834452593;
		j1361353430 -> j3156618600;
	j2535590125 [label="Нет, извини. ",shape=box,color=red];
		j2535590125 -> j78136410;
	j959003753 [label="Ладно. Если ты не против, то и я не против.",shape=box,color=red];
		j959003753 -> j876940586;
	j2362530618 [label="Нет, к сожалению... Думаю, это был тупик. Как думаешь, есть другой выход?",shape=box,color=red];
		j2362530618 -> j273854071;
	j3050539978 [label="Он поможет. Мне удалось убедить его содействовать их воссоединению — и ты не поверишь этому — думаю, он делает это для того, чтобы помочь защитить семью Энтрати. В конце концов, они — всё, что по-настоящему осталось от Орокин.",shape=box,color=red];
		j3050539978 -> j65442853;
	j1214221323 [label="Окажет. Я убедил его помочь воссоединить их — и ты не удивишься этому — думаю, в основном из желания насолить Альбрехту в его отсутствие.",shape=box,color=red];
		j1214221323 -> j385067392;
	j2834452593 [label="Пока ничего не решено. Он... ну, ты же знаешь, каким он бывает.",shape=box,color=red];
		j2834452593 -> j2913252443;
	j3156618600 [label="Я все еще работаю над этим, но думаю, что да.",shape=box,color=red];
		j3156618600 -> j1104176810;
	j78136410 [label="+20 Chemistry",color=orange];
		j78136410 -> j1698874931;
	j876940586 [label="Oui, мне не обязательно этим наслаждаться, но, полагаю, это то un médicament, которое мы должны проглотить.",shape=box,color=blue];
		j876940586 -> j636489540;
	j273854071 [label="О! Это... печально. Я не знаю… Не думаю. Можешь ли ты придумать другой подход к дьяволу? Или способ попытаться снова?",shape=box,color=blue];
		j273854071 -> j1987400956;
	j65442853 [label="Он помогает защищать семью человека, который против его воли превратил его в протофрейм и забросил в прошлое, лишив его памяти...",shape=box,color=blue];
		j65442853 -> j1094785287;
	j385067392 [label="Точно, я... не удивлена.",shape=box,color=blue];
		j385067392 -> j1340838153;
		j385067392 -> j2339441577;
	j2913252443 [label="Check boolean RoatheDating",color=orange];
		j2913252443 -> j3650820357 [label=true,color=green];
		j2913252443 -> j1517380258 [label=false,color=brown];
	j1104176810 [label="Check boolean RoatheDating",color=orange];
		j1104176810 -> j3023236375 [label=true,color=green];
		j1104176810 -> j1834545778 [label=false,color=brown];
	j1698874931 [label="Тогда я тоже поддержу твой выбор.",shape=box,color=blue];
		j1698874931 -> j1179567760;
	j1987400956 [label="В это же время я поговорю с Лионом, но мои надежды крайне малы.",shape=box,color=blue];
		j1987400956 -> j3034776440;
	j1094785287 [label="+20 Chemistry",color=orange];
		j1094785287 -> j1736701249;
	j1340838153 [label="По крайней мере, он всё-таки поможет. А я прослежу, чтобы он на самом деле не довёл свои угрозы до конца.",shape=box,color=red];
		j1340838153 -> j3669875898;
	j2339441577 [label="Думаю, это всего лишь оправдание, которое он придумывает, чтобы это скрыть.",shape=box,color=red];
		j2339441577 -> j3879319310;
	j3650820357 [label="Oui, я знаю. Но я думаю, у тебя есть особый способ убедить его, в котором все остальные потерпели неудачу, non?",shape=box,color=blue];
		j3650820357 -> j2990859171;
		j3650820357 -> j1148410369;
	j1517380258 [label="Oui, конечно знаю. Этот дьявол и в лучшие времена бывает упрямым. Иногда мне кажется, ему просто нравится быть противоречивым!",shape=box,color=blue];
		j1517380258 -> j2937165411;
		j1517380258 -> j2796991242;
	j3023236375 [label="Я думаю, у тебя есть особый способ убедить его, в котором все остальные потерпели неудачу, non?",shape=box,color=blue];
		j3023236375 -> j2990859171;
		j3023236375 -> j1148410369;
	j1834545778 [label="Желаю тебе удачи. Этот дьявол и в лучшие времена бывает упрямым. Иногда мне кажется, ему просто нравится быть противоречивым!",shape=box,color=blue];
		j1834545778 -> j2937165411;
		j1834545778 -> j2796991242;
	j1179567760 [label="Boolean MarieFamilyFail is now true.",color=orange];
		j1179567760 -> j2605366984;
	j3034776440 [label="+20 Chemistry",color=orange];
		j3034776440 -> j1602778258;
	j1736701249 [label="Я глубоко недооценила этого нашего дьявола...",shape=box,color=blue];
		j1736701249 -> j2704126474;
	j3669875898 [label="Oui. По крайней мере, ты рядом и можешь не дать ему последовать своим... низменным инстинктам.",shape=box,color=blue];
		j3669875898 -> j2198758823;
	j3879319310 [label="Oui, надеюсь, это верно.",shape=box,color=blue];
		j3879319310 -> j2198758823;
	j2990859171 [label="Я бы не хотел использовать наши с ним отношения как инструмент переговоров.",shape=box,color=red];
		j2990859171 -> j4017153713;
	j1148410369 [label="На что ты намекаешь, Мари?",shape=box,color=red];
		j1148410369 -> j1731493957;
	j2937165411 [label="Мне это даже нравится, как бы странно это ни звучало. Мы хорошо ладим.",shape=box,color=red];
		j2937165411 -> j1582393785;
	j2796991242 [label="Он может таким быть, но, думаю, во многом это просто показуха.",shape=box,color=red];
		j2796991242 -> j1103601002;
	j2605366984 [label="Boolean MarieRank5Convo4Complete is now true.",color=orange];
		j2605366984 -> "Chat ends.";
	j1602778258 [label="Дьявол переменчив! C'est la vie, как говорится!",shape=box,color=blue];
		j1602778258 -> j3569999725;
	j2704126474 [label="И я не настолько глупа, чтобы не видеть твою роль в том, чтобы всё это стало возможным!",shape=box,color=blue];
		j2704126474 -> j3242583483;
	j2198758823 [label="Check boolean MarieDating",color=orange];
		j2198758823 -> j3052568488 [label=true,color=green];
		j2198758823 -> j657481369 [label=false,color=brown];
	j4017153713 [label="О! Я вовсе не это имела в виду, прости меня! Просто он, похоже, благоволит тебе, так что, возможно, ты способен быть для него тем, кого он выслушает, тогда как всех остальных может проигнорировать.",shape=box,color=blue];
		j4017153713 -> j1037312302;
	j1731493957 [label="+5 Chemistry",color=orange];
		j1731493957 -> j1057337993;
	j1582393785 [label="Oui, похоже, он явно благоволит тебе. Возможно, это потому, что вы разделяете одно время и одно место, чего у нас нет? Зачем ещё ему это делать?",shape=box,color=blue];
		j1582393785 -> j3822691405;
	j1103601002 [label="Oui? Что ты имеешь в виду?",shape=box,color=blue];
		j1103601002 -> j3822691405;
	j3569999725 [label="Boolean MarieFamilySuccess is now true.",color=orange];
		j3569999725 -> j2605366984;
	j3242583483 [label="Check boolean MarieDating",color=orange];
		j3242583483 -> j3031246523 [label=true,color=green];
		j3242583483 -> j2252758308 [label=false,color=brown];
	j3052568488 [label="+10 Chemistry",color=orange];
		j3052568488 -> j646651845;
	j657481369 [label="+10 Chemistry",color=orange];
		j657481369 -> j828099987;
	j1037312302 [label="+5 Chemistry",color=orange];
		j1037312302 -> j256704916;
	j1057337993 [label="Я совершенно не понимаю, о чём ты! Я ни на что не намекаю. Я всего лишь une innocente Sœur de Sol.",shape=box,color=blue];
		j1057337993 -> j2458410148;
	j3822691405 [label="Evaluate expressions",color=orange];
		j3822691405 -> j4192355691 [label="RoatheVillain",color=purple];
		j3822691405 -> j4279010532 [label="RoatheRedeemed",color=purple];
		j3822691405 -> j2277127340 [label="RoatheUnloved3",color=purple];
		j3822691405 -> j1997914311 [label="RoatheTraitor2",color=purple];
		j3822691405 -> j587802014 [label="RoatheExecutor2",color=purple];
		j3822691405 -> j921181441 [label="false",color=purple];
	j3031246523 [label="Merci, merci, merci, mon cœur!",shape=box,color=blue];
		j3031246523 -> j2585656339;
	j2252758308 [label="Merci, merci, merci!",shape=box,color=blue];
		j2252758308 -> j2585656339;
	j646651845 [label="Ну что ж! Когда придёт время, я буду готова и буду ждать! А пока, merci, mon cœur.",shape=box,color=blue];
		j646651845 -> j3569999725;
	j828099987 [label="Ну что ж! Когда придёт время, я буду готова и буду ждать! А пока, merci.",shape=box,color=blue];
		j828099987 -> j3569999725;
	j256704916 [label="Я просто рада твоему счастью. И если чёрту есть куда приложить свои... усилия... тем лучше, non?",shape=box,color=blue];
		j256704916 -> j4266679228;
	j2458410148 [label="Я бы никогда не сказала, что раз дьявол, судя по всему, благоволит тебе, то, возможно, он тебя выслушает, тогда как всех остальных он, похоже, игнорирует.",shape=box,color=blue];
		j2458410148 -> j1719509906;
	j4192355691 [label="Все, кто его окружал, пытались выставить его каким-то чудовищем. Полагаю, я первый, кто этого не совершил.",shape=box,color=red];
		j4192355691 -> j4206228515;
	j4279010532 [label="Многое в нём он просто не умеет показывать. Дело не в доспехах как таковых, но он не доверяет людям и боится, что они причинят ему вред.",shape=box,color=red];
		j4279010532 -> j3930739790;
	j2277127340 [label="За свою жизнь он... пережил немало серьёзных душевных мук. Сердце просто покрыто коркой от шипов, вот и всё.",shape=box,color=red];
		j2277127340 -> j1452216598;
	j1997914311 [label="Думаю, я могу понять, сколько лет он прожил. Мне довелось увидеть столько же смертей, сколько и он.",shape=box,color=red];
		j1997914311 -> j3525852777;
	j587802014 [label="Он всегда старался поступать только правильно. Может, и неправильно, конечно, но он пытался спасти Изначальную Систему от Орокин.",shape=box,color=red];
		j587802014 -> j250630184;
	j921181441 [label="Мне нравится его тонкое чувство юмора. Он умный, если не обращать внимания на его эго.",shape=box,color=red];
		j921181441 -> j618577815;
	j2585656339 [label="Ну что ж! Когда придёт время, я буду готова и буду ждать! А пока!",shape=box,color=blue];
		j2585656339 -> j3569999725;
	j4266679228 [label="Тем более для всех нас, если ты станешь немного un ange на его плече, смягчающим его.",shape=box,color=blue];
		j4266679228 -> j3730671248;
		j4266679228 -> j3643171867;
	j1719509906 [label="И никогда в личные моменты. Non. Jamais.",shape=box,color=blue];
		j1719509906 -> j2179164989;
		j1719509906 -> j3108888271;
	j4206228515 [label="И, похоже, я в последнее время возглавляю этот список, не так ли? Полагаю, мне стоит... задуматься о причинах, по которым он стал таким, какой он есть. Осуждение не спасает души.",shape=box,color=blue];
		j4206228515 -> j2980018588;
	j3930739790 [label="Мы всегда скрываем от окружающих какую-то боль. Что-то, что мы пытаемся скрыть, опасаясь, что другие ею воспользуются. Думаю, мне стоит быть к нему добрее, если то, что ты говоришь, правда.",shape=box,color=blue];
		j3930739790 -> j2980018588;
	j1452216598 [label="Я не могу представить, сколько любви и потерь приходится пережить за все эти годы. Это кажется таким нереальным, даже учитывая всё, что я видела.",shape=box,color=blue];
		j1452216598 -> j2824783903;
	j3525852777 [label="Иногда, разговаривая с ним, я забываю, сколько веков он прожил. Это кажется таким нереальным, даже учитывая всё, что я видела.",shape=box,color=blue];
		j3525852777 -> j4121218739;
	j250630184 [label="Всегда есть... нюансы, да? Всегда есть причины поступать так или иначе. Полагаю, мне стоит стараться быть к нему добрее, если то, что ты говоришь, правда.",shape=box,color=blue];
		j250630184 -> j2980018588;
	j618577815 [label="Никто никогда не отказывал дьяволу в остроумии.",shape=box,color=blue];
		j618577815 -> j3097791306;
	j3730671248 [label="Кто сказал, что я пытаюсь его смягчить?",shape=box,color=red];
		j3730671248 -> j3147050988;
	j3643171867 [label="Я не могу ничего обещать.",shape=box,color=red];
		j3643171867 -> j3773598225;
	j2179164989 [label="Раньше не виделось в тебе чего-то подобного.",shape=box,color=red];
		j2179164989 -> j1037312302;
	j3108888271 [label="Ты меня удивляешь. Меня это впечатляет. ",shape=box,color=red];
		j3108888271 -> j1037312302;
	j2980018588 [label="+10 Chemistry",color=orange];
		j2980018588 -> j3608779776;
	j2824783903 [label="Oui, какой вред это может причинить душе? Я понимаю, почему ты хочешь найти другого, кто тебя поймёт. А он – тебя.",shape=box,color=blue];
		j2824783903 -> j2980018588;
	j4121218739 [label="Прожить так долго, увидеть столько смерти - и самому заплатить за это столь многим?",shape=box,color=blue];
		j4121218739 -> j2824783903;
	j3097791306 [label="+5 Chemistry",color=orange];
		j3097791306 -> j3608779776;
	j3147050988 [label="Add -1 to Thermostat counter",color=orange];
		j3147050988 -> j665773379;
	j3773598225 [label="Add 1 to Thermostat counter",color=orange];
		j3773598225 -> j860042811;
	j3608779776 [label="Я просто рада, что у дьявола есть кто-то, с кем он может поговорить и кто может попытаться его усмирить. Un ange на его плече.",shape=box,color=blue];
		j3608779776 -> j3730671248;
		j3608779776 -> j3643171867;
	j665773379 [label="+10 Chemistry",color=orange];
		j665773379 -> j29675652;
	j860042811 [label="+10 Chemistry",color=orange];
		j860042811 -> j2214542425;
	j29675652 [label="Может и так... Что такое un ange без son diable? Он напоминает нам всем, чего следует избегать.",shape=box,color=blue];
		j29675652 -> j2559669198;
	j2214542425 [label="Oui, боюсь, в нём есть какая-то злоба, от которой невозможно излечиться. Он слишком этим наслаждается.",shape=box,color=blue];
		j2214542425 -> j2559669198;
	j2559669198 [label="Ну что ж! Когда ты убедишь дьявола помочь нам в нашей миссии, я буду готова и буду ждать! До тех пор!",shape=box,color=blue];
		j2559669198 -> j3569999725;
}