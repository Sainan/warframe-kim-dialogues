		j1613373557 -> j2309817989;
	j19626990 [label="Я пытаюсь убедить Роута помочь нам воссоединить Лойда и семью Энтрати. Но он упрямится и не хочет принимать сыворотку. Мне нужна твоя помощь, чтобы поговорить с ним.",shape=box,color=red];
		j19626990 -> j1056341945;
	j3191805519 [label="Я пытаюсь помочь Роуту осознать, что он способен измениться. Что он может простить себя за свои поступки в прошлом. И мне нужна твоя помощь в этом.",shape=box,color=red];
		j3191805519 -> j4188715776;
	j349975446 [label="Роут терзает себя изнутри из-за содеянного. И без твоей помощи, боюсь, он продолжит разрушать себя, если не примет себя таким, какой он есть.",shape=box,color=red];
		j349975446 -> j3460159165;
	j4141607983 [label="Роут узнал правду о сыворотке. Что он принял её добровольно. И это его губит. Мне нужна твоя помощь, чтобы успокоить его.",shape=box,color=red];
		j4141607983 -> j1056341945;
	j2309817989 [label="Роут сводит меня с ума. Я не знаю, как с ним разговаривать. Можешь что-нибудь посоветовать?",shape=box,color=red];
		j2309817989 -> j1056341945;
	j1056341945 [label="Нет, если бы я умела разговаривать с этим дьяволом, думаешь, я бы всегда кричала на него на Gaullique?",shape=box,color=blue];
		j1056341945 -> j2486488511;
	j4188715776 [label="Add 10 to Thermostat counter",color=orange];
		j4188715776 -> j3285718715;
	j3460159165 [label="Add -10 to Thermostat counter",color=orange];
		j3460159165 -> j3285718715;
	j2486488511 [label="Pardonne-moi, я думаю, дальше ты сам по себе...",shape=box,color=blue];
		j2486488511 -> "Chat ends.";
	j3285718715 [label="Я сделаю всё, что смогу. Ради тебя я постараюсь.",shape=box,color=blue];
