digraph {
	0 [label="MarieRank1Convo1 begins.",color=orange];
		0 -> 1;
	1 [label="Bonjour, bonjour, Скиталец! Как дела в этот прекрасный день? Или вечер. Я, честно говоря, совсем не знаю, который сейчас час в этом месте.",shape=box,color=blue];
		1 -> 2;
	2 [label="Я уверена, что одна из этих безделушек, которые хранит Monsieur Лойд, это часы, но я ни за что на свете не могу определить, какие именно.",shape=box,color=blue];
		2 -> 3;
	3 [label="Я боюсь трогать какие-либо устройства в этом странном святилище. Я твёрдо верю, что с той же вероятностью могу закинуть себя куда-нибудь в далёкие времена, так же легко, как и просто подогреть чашку чая.",shape=box,color=blue];
		3 -> 5;
		3 -> 6;
		3 -> 4;
	5 [label="Наверное, лучше не нажимать кнопки, в которых не уверены, нет. ",shape=box,color=red];
		5 -> 8;
	6 [label="Я знаю, с тобой всё будет в порядке.",shape=box,color=red];
		6 -> 9;
	4 [label="[Конец.]",shape=box,color=red];
		4 -> 7;
	8 [label="Очень дельный совет, действительно. Я слышала от Monsieur Лоида, что у тебя была своя aventure temporelle. Интересно...",shape=box,color=blue];
		8 -> 10;
	9 [label="C’est très gentil de votre part, но... не тебя же бросили в другое... ах. Верно. Да!",shape=box,color=blue];
		9 -> 11;
	7 [label="Chat ends.",color=orange];
	10 [label="Было ли это так же опасно, как и сейчас?",shape=box,color=blue];
		10 -> 12;
		10 -> 13;
	11 [label="Ты ведь знаешь, не так ли? Прости меня. Твоё собственное приключение было столь же опасным, как это?",shape=box,color=blue];
		11 -> 12;
		11 -> 13;
	12 [label="Период времени? Или именно моё пребывание там?",shape=box,color=red];
		12 -> 14;
	13 [label="Всё было по-другому, но я обещаю, что здесь ты в безопасности.",shape=box,color=red];
		13 -> 15;
	14 [label="+10 Chemistry",color=orange];
		14 -> 16;
	15 [label="Я очень ценю твоё воодушевляющее проявление уверенности, но не совсем разделяю его. Особенно учитывая, что мне даже трудно понять, какое сейчас время.",shape=box,color=blue];
		15 -> 17;
	16 [label="Хорошо провести такое различие. Я сомневаюсь, что твой опыт с прошлым можно назвать «нормальным» по общим меркам. Я очень надеюсь, что нет, судя по всему.",shape=box,color=blue];
		16 -> 18;
	17 [label="Можно было бы ожидать, что он появится в углу этого... «экрана», но, увы, нет! Mauvaise qualité, если хочешь знать моё мнение.",shape=box,color=blue];
		17 -> 19;
	18 [label="Я имела в виду сам «период времени». Позволь мне перефразировать...",shape=box,color=blue];
		18 -> 20;
	19 [label="Впрочем, мы изрядно отошли от моего вопроса!",shape=box,color=blue];
		19 -> 20;
	20 [label="Было ли то «прошлое», в которое тебя забросило, ведь оно куда ближе к тому «далёкому прошлому», из которого я родом, было ли оно, скажем, более или менее скрыто опасным, чем нынешнее время, в котором мы сейчас с тобой оказались?",shape=box,color=blue];
		20 -> 21;
	21 [label="(Боже милостивый! Мне это так по душе, должна сказать, это гораздо интереснее, чем протирать пыль с посуды для причастия.)",shape=box,color=blue];
		21 -> 22;
		21 -> 23;
		21 -> 24;
		21 -> 25;
	22 [label="Думаю, примерно одинаково. Оружие другое, и, может быть, они ещё не знают, с чем имеют дело, но война есть война, а смерть есть смерть.",shape=box,color=red];
		22 -> 26;
	23 [label="Думаю, это время менее опасно. У нас больше возможностей справляться с трудностями. Они только начинают.",shape=box,color=red];
		23 -> 27;
	24 [label="Думаю, это время более опасно. Хоть заражённые у нас и общие, они тогда имели куда более примитивное оружие.",shape=box,color=red];
		24 -> 27;
	25 [label="Честно говоря, мне просто радостно, что тебе весело. Адаптироваться ко всему сразу бывает непросто.",shape=box,color=red];
		25 -> 28;
	26 [label="+5 Chemistry",color=orange];
		26 -> 29;
	27 [label="Может, и так. Я подумаю об этом. Спасибо.",shape=box,color=blue];
		27 -> 30;
	28 [label="+5 Chemistry",color=orange];
		28 -> 31;
	29 [label="Как и во всём, полагаю, это относительно, non? Хищник, что убивает нас теперь, столь же смертоносен, как и тот, что охотился тогда. Просто точит зубы.",shape=box,color=blue];
		29 -> 32;
		29 -> 33;
	30 [label="Chat ends.",color=orange];
	31 [label="К этому меня подготовил le Cardinal Dimanche — твой Альбрехт Энтрати. В отличие от моего дорогого Лиона, я принимала его слова за истину. И в отличие от Лиона, я вижу в этом великое приключение, а не бремя.",shape=box,color=blue];
		31 -> 34;
	32 [label="Разве что ты не Орокин, что нашли способ избежать смерти... теоретически, если не на деле.",shape=box,color=red];
		32 -> 35;
	33 [label="Меня также радует, что ты хорошо адаптируешься к будущему.",shape=box,color=red];
		33 -> 36;
	34 [label="Служение Светилам не должно быть актом страдания. В этом мы всегда расходились.",shape=box,color=blue];
		34 -> 37;
	35 [label="И я считаю, что дьявол — это идеальный пример того, почему смерть есть величайший дар, который Луа когда-либо дарила нам.",shape=box,color=blue];
		35 -> 38;
	36 [label="+5 Chemistry",color=orange];
		36 -> 39;
	37 [label="Update boolean MarieLyonSuffering1",color=orange];
		37 -> 40;
	38 [label="Update boolean MarieRoathe1",color=orange];
		38 -> 41;
	39 [label="К этому меня подготовил le Cardinal Dimanche - твой Альбрехт Энтрати. В отличие от моего дорогого Лиона, я принимала его слова за истину. И в отличие от Лиона, я вижу в этом великое приключение, а не бремя.",shape=box,color=blue];
		39 -> 42;
	40 [label="И не уходи от моего вопроса, глупое создание! Какое время ты считаешь более опасным?",shape=box,color=blue];
		40 -> 43;
		40 -> 44;
		40 -> 45;
	41 [label="О! Вот это звук часов, который я узнаю, хотя до сих пор не могу понять, где же эта проклятая штука находится. В любом случае, боюсь, мне пора. Это было восхитительно. Пока мы не «встретимся» вновь! Aux Dieux!",shape=box,color=blue];
		41 -> 46;
	42 [label="Служение Светилам не должно быть актом страдания. В этом мы всегда расходились.",shape=box,color=blue];
		42 -> 47;
	43 [label="Я считаю, что это время более смертоносно. Сколько же у нас теперь невероятных врагов, желающих нас убить?",shape=box,color=red];
		43 -> 48;
	44 [label="Я считаю, что наше время менее опасно. Они только открывают новые способы убивать друг друга. Наши просто выглядят чуть эффектнее, пожалуй.",shape=box,color=red];
		44 -> 48;
	45 [label="Думаю, в итоге всё примерно одинаково. Смерть есть смерть, не так ли?",shape=box,color=red];
		45 -> 49;
	46 [label="Chat ends.",color=orange];
	47 [label="Update boolean MarieLyonSuffering1",color=orange];
		47 -> 41;
	48 [label="Может, и так. Я подумаю об этом. Спасибо.",shape=box,color=blue];
		48 -> 50;
	49 [label="+5 Chemistry",color=orange];
		49 -> 51;
	50 [label="Chat ends.",color=orange];
	51 [label="Как и во всём, полагаю, это относительно, no? Хищник, что убивает нас теперь, столь же смертоносен, как и тот, что охотился тогда. Просто точит зубы.",shape=box,color=blue];
		51 -> 52;
		51 -> 53;
	52 [label="Как тот, кто пытается защищаться от волка, часто ощущаешь истощение.",shape=box,color=red];
		52 -> 54;
	53 [label="Разве что ты не Орокин, что нашли способ избежать смерти... теоретически, если не на деле.",shape=box,color=red];
		53 -> 55;
	54 [label="Думаю, ты, мой дорогой Скиталец, скорее сам присоединишься к стае, чем укроешься от неё. И поверь, я говорю это как комплимент.",shape=box,color=blue];
		54 -> 41;
	55 [label="И я считаю, что дьявол это идеальный пример того, почему смерть есть величайший дар, который Луа когда-либо дарила нам.",shape=box,color=blue];
		55 -> 56;
	56 [label="Update boolean MarieRoathe1",color=orange];
		56 -> 41;
}