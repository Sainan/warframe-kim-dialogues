digraph {
	graph [fontname="Roboto Condensed"];
	node [fontname="Roboto Condensed"];
	edge [fontname="Roboto Condensed"];

	"MarieRank1Convo1 begins." [color=orange];
		"MarieRank1Convo1 begins." -> j2397136427;
	j2397136427 [label="Bonjour, bonjour, Скиталец! Как дела в этот прекрасный день? Или вечер. Я, честно говоря, совсем не знаю, который сейчас час в этом месте.",shape=box,color=blue];
		j2397136427 -> j2365846289;
	j2365846289 [label="Я уверена, что одна из этих безделушек, которые хранит Monsieur Лойд, это часы, но я ни за что на свете не могу определить, какие именно.",shape=box,color=blue];
		j2365846289 -> j114196702;
	j114196702 [label="Я боюсь трогать какие-либо устройства в этом странном святилище. Я твёрдо верю, что с той же вероятностью могу закинуть себя куда-нибудь в далёкие времена, так же легко, как и просто подогреть чашку чая.",shape=box,color=blue];
		j114196702 -> j1661867903;
		j114196702 -> j4181231771;
		j114196702 -> j1310452999;
	j1661867903 [label="Наверное, лучше не нажимать кнопки, в которых не уверены, нет. ",shape=box,color=red];
		j1661867903 -> j1958255492;
	j4181231771 [label="Я знаю, с тобой всё будет в порядке.",shape=box,color=red];
		j4181231771 -> j3323387614;
	j1310452999 [label="[Конец.]",shape=box,color=red];
		j1310452999 -> "Chat ends.";
	j1958255492 [label="Очень дельный совет, действительно. Я слышала от Monsieur Лоида, что у тебя была своя aventure temporelle. Интересно...",shape=box,color=blue];
		j1958255492 -> j1495046933;
	j3323387614 [label="C’est très gentil de votre part, но... не тебя же бросили в другое... ах. Верно. Да!",shape=box,color=blue];
		j3323387614 -> j4112384258;
	"Chat ends." [color=orange];
	j1495046933 [label="Было ли это так же опасно, как и сейчас?",shape=box,color=blue];
		j1495046933 -> j3245886988;
		j1495046933 -> j3662958556;
	j4112384258 [label="Ты ведь знаешь, не так ли? Прости меня. Твоё собственное приключение было столь же опасным, как это?",shape=box,color=blue];
		j4112384258 -> j3245886988;
		j4112384258 -> j3662958556;
	j3245886988 [label="Период времени? Или именно моё пребывание там?",shape=box,color=red];
		j3245886988 -> j3364502589;
	j3662958556 [label="Всё было по-другому, но я обещаю, что здесь ты в безопасности.",shape=box,color=red];
		j3662958556 -> j3189707361;
	j3364502589 [label="+10 Chemistry",color=orange];
		j3364502589 -> j902292376;
	j3189707361 [label="Я очень ценю твоё воодушевляющее проявление уверенности, но не совсем разделяю его. Особенно учитывая, что мне даже трудно понять, какое сейчас время.",shape=box,color=blue];
		j3189707361 -> j2086891369;
	j902292376 [label="Хорошо провести такое различие. Я сомневаюсь, что твой опыт с прошлым можно назвать «нормальным» по общим меркам. Я очень надеюсь, что нет, судя по всему.",shape=box,color=blue];
		j902292376 -> j4189102083;
	j2086891369 [label="Можно было бы ожидать, что он появится в углу этого... «экрана», но, увы, нет! Mauvaise qualité, если хочешь знать моё мнение.",shape=box,color=blue];
		j2086891369 -> j2496777076;
	j4189102083 [label="Я имела в виду сам «период времени». Позволь мне перефразировать...",shape=box,color=blue];
		j4189102083 -> j4029644440;
	j2496777076 [label="Впрочем, мы изрядно отошли от моего вопроса!",shape=box,color=blue];
		j2496777076 -> j4029644440;
	j4029644440 [label="Было ли то «прошлое», в которое тебя забросило, ведь оно куда ближе к тому «далёкому прошлому», из которого я родом, было ли оно, скажем, более или менее скрыто опасным, чем нынешнее время, в котором мы сейчас с тобой оказались?",shape=box,color=blue];
		j4029644440 -> j3977510749;
	j3977510749 [label="(Боже милостивый! Мне это так по душе, должна сказать, это гораздо интереснее, чем протирать пыль с посуды для причастия.)",shape=box,color=blue];
		j3977510749 -> j3114209571;
		j3977510749 -> j1268080389;
		j3977510749 -> j2757398835;
		j3977510749 -> j3528563544;
	j3114209571 [label="Думаю, примерно одинаково. Оружие другое, и, может быть, они ещё не знают, с чем имеют дело, но война есть война, а смерть есть смерть.",shape=box,color=red];
		j3114209571 -> j3476192881;
	j1268080389 [label="Думаю, это время менее опасно. У нас больше возможностей справляться с трудностями. Они только начинают.",shape=box,color=red];
		j1268080389 -> j1896707317;
	j2757398835 [label="Думаю, это время более опасно. Хоть заражённые у нас и общие, они тогда имели куда более примитивное оружие.",shape=box,color=red];
		j2757398835 -> j1896707317;
	j3528563544 [label="Честно говоря, мне просто радостно, что тебе весело. Адаптироваться ко всему сразу бывает непросто.",shape=box,color=red];
		j3528563544 -> j3121686967;
	j3476192881 [label="+5 Chemistry",color=orange];
		j3476192881 -> j1126763189;
	j1896707317 [label="Может, и так. Я подумаю об этом. Спасибо.",shape=box,color=blue];
		j1896707317 -> "Chat ends.";
	j3121686967 [label="+5 Chemistry",color=orange];
		j3121686967 -> j3824807321;
	j1126763189 [label="Как и во всём, полагаю, это относительно, non? Хищник, что убивает нас теперь, столь же смертоносен, как и тот, что охотился тогда. Просто точит зубы.",shape=box,color=blue];
		j1126763189 -> j3549495398;
		j1126763189 -> j689515612;
	j3824807321 [label="К этому меня подготовил le Cardinal Dimanche — твой Альбрехт Энтрати. В отличие от моего дорогого Лиона, я принимала его слова за истину. И в отличие от Лиона, я вижу в этом великое приключение, а не бремя.",shape=box,color=blue];
		j3824807321 -> j1874302807;
	j3549495398 [label="Разве что ты не Орокин, что нашли способ избежать смерти... теоретически, если не на деле.",shape=box,color=red];
		j3549495398 -> j2127488946;
	j689515612 [label="Меня также радует, что ты хорошо адаптируешься к будущему.",shape=box,color=red];
		j689515612 -> j2669585692;
	j1874302807 [label="Служение Светилам не должно быть актом страдания. В этом мы всегда расходились.",shape=box,color=blue];
		j1874302807 -> j3793555983;
	j2127488946 [label="И я считаю, что дьявол — это идеальный пример того, почему смерть есть величайший дар, который Луа когда-либо дарила нам.",shape=box,color=blue];
		j2127488946 -> j4146768040;
	j2669585692 [label="+5 Chemistry",color=orange];
		j2669585692 -> j2963291800;
	j3793555983 [label="Boolean MarieLyonSuffering1 is now true.",color=orange];
		j3793555983 -> j3982524671;
	j4146768040 [label="Boolean MarieRoathe1 is now true.",color=orange];
		j4146768040 -> j1791219830;
	j2963291800 [label="К этому меня подготовил le Cardinal Dimanche - твой Альбрехт Энтрати. В отличие от моего дорогого Лиона, я принимала его слова за истину. И в отличие от Лиона, я вижу в этом великое приключение, а не бремя.",shape=box,color=blue];
		j2963291800 -> j2276266955;
	j3982524671 [label="И не уходи от моего вопроса, глупое создание! Какое время ты считаешь более опасным?",shape=box,color=blue];
		j3982524671 -> j1264672876;
		j3982524671 -> j3944007200;
		j3982524671 -> j2420100879;
	j1791219830 [label="О! Вот это звук часов, который я узнаю, хотя до сих пор не могу понять, где же эта проклятая штука находится. В любом случае, боюсь, мне пора. Это было восхитительно. Пока мы не «встретимся» вновь! Aux Dieux!",shape=box,color=blue];
		j1791219830 -> "Chat ends.";
	j2276266955 [label="Служение Светилам не должно быть актом страдания. В этом мы всегда расходились.",shape=box,color=blue];
		j2276266955 -> j1502584386;
	j1264672876 [label="Я считаю, что это время более смертоносно. Сколько же у нас теперь невероятных врагов, желающих нас убить?",shape=box,color=red];
		j1264672876 -> j1896707317;
	j3944007200 [label="Я считаю, что наше время менее опасно. Они только открывают новые способы убивать друг друга. Наши просто выглядят чуть эффектнее, пожалуй.",shape=box,color=red];
		j3944007200 -> j1896707317;
	j2420100879 [label="Думаю, в итоге всё примерно одинаково. Смерть есть смерть, не так ли?",shape=box,color=red];
		j2420100879 -> j383142927;
	j1502584386 [label="Boolean MarieLyonSuffering1 is now true.",color=orange];
		j1502584386 -> j1791219830;
	j383142927 [label="+5 Chemistry",color=orange];
		j383142927 -> j3243885943;
	j3243885943 [label="Как и во всём, полагаю, это относительно, no? Хищник, что убивает нас теперь, столь же смертоносен, как и тот, что охотился тогда. Просто точит зубы.",shape=box,color=blue];
		j3243885943 -> j3331823050;
		j3243885943 -> j338445817;
	j3331823050 [label="Как тот, кто пытается защищаться от волка, часто ощущаешь истощение.",shape=box,color=red];
		j3331823050 -> j3921934952;
	j338445817 [label="Разве что ты не Орокин, что нашли способ избежать смерти... теоретически, если не на деле.",shape=box,color=red];
		j338445817 -> j256354477;
	j3921934952 [label="Думаю, ты, мой дорогой Скиталец, скорее сам присоединишься к стае, чем укроешься от неё. И поверь, я говорю это как комплимент.",shape=box,color=blue];
		j3921934952 -> j1791219830;
	j256354477 [label="И я считаю, что дьявол это идеальный пример того, почему смерть есть величайший дар, который Луа когда-либо дарила нам.",shape=box,color=blue];
		j256354477 -> j4146768040;
}