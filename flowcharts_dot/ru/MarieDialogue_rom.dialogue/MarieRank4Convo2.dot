		j1646882152 -> j742360628;
	j1200107616 [label="Boolean DrifterFaithSol is now false.",color=orange];
		j1200107616 -> j3801357883;
	j742360628 [label="Я начинаю веровать и в тебя тоже.",shape=box,color=blue];
		j742360628 -> j265770102;
	j3801357883 [label="Boolean DrifterFaithPersonal is now false.",color=orange];
