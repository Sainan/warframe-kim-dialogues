	3953 [label="+5 Chemistry",color=orange];
		3953 -> 3954;
	2144 [label="+5 Chemistry",color=orange];
		2144 -> 2149;
	2152 [label="Вроде тобой упоминалось, что у тебя такая же вера, как и у меня, non ? Почему ты веришь ?",shape=box,color=blue];
		2152 -> 2162;
		2152 -> 2163;
		2152 -> 2164;
		2152 -> 2165;
		2152 -> 2166;
	2153 [label="Вроде тобой упоминалось, что тоже веруешь, хоть твоя вера и иная, чем моя. Почему ты веруешь ?",shape=box,color=blue];
		2153 -> 2162;
		2153 -> 2163;
		2153 -> 2164;
		2153 -> 2165;
		2153 -> 2166;
	2154 [label="Вроде тобой упоминалось, что твоя вера это твоё личное дело, как une histoire, которую ты самостоятельно создаёшь, но всё же это всё равно вера. Почему ты веруешь ?",shape=box,color=blue];
		2154 -> 2162;
		2154 -> 2163;
