	"Chat ends." [color=orange];
	j859026982 [label="Oui! Знаешь ли ты, что когда я нахожусь в полном полёте, меня невозможно à voir?! Je suis invisible!",shape=box,color=blue];
		j859026982 -> j3012398539;
	j1869385335 [label="+5 Chemistry",color=orange];
		j1869385335 -> j3045626960;
	j186264682 [label="+5 Chemistry",color=orange];
		j186264682 -> j3648719684;
	j2527340781 [label="Вроде тобой упоминалось, что у тебя такая же вера, как и у меня, non? Почему ты веришь?",shape=box,color=blue];
		j2527340781 -> j649804141;
		j2527340781 -> j1662502145;
		j2527340781 -> j3143669981;
		j2527340781 -> j3399111534;
		j2527340781 -> j2649475080;
	j3503231874 [label="Вроде, тобой упоминалось, что тоже веруешь, хоть твоя вера и иная, чем моя. Почему ты веруешь?",shape=box,color=blue];
		j3503231874 -> j649804141;
		j3503231874 -> j1662502145;
		j3503231874 -> j3143669981;
		j3503231874 -> j3399111534;
		j3503231874 -> j2649475080;
	j1535756367 [label="Вроде тобой упоминалось, что твоя вера это твоё личное дело, как une histoire, которую ты самостоятельно создаёшь, но всё же это всё равно вера. Почему ты веруешь?",shape=box,color=blue];
		j1535756367 -> j649804141;
		j1535756367 -> j1662502145;
		j1535756367 -> j3143669981;
		j1535756367 -> j3399111534;
		j1535756367 -> j2649475080;
	j3119263435 [label="Почему ты спрашиваешь?",shape=box,color=blue];
		j3119263435 -> j649804141;
		j3119263435 -> j1662502145;
		j3119263435 -> j3143669981;
		j3119263435 -> j3399111534;
		j3119263435 -> j2649475080;
	j2473563725 [label="Я мог бы спросить тебя то же самое о Луа, non? Почему ты веришь?",shape=box,color=blue];
		j2473563725 -> j649804141;
		j2473563725 -> j3143669981;
		j2473563725 -> j3399111534;
		j2473563725 -> j2649475080;
		j2473563725 -> j1662502145;
	j122432860 [label="Почему именно Сол? А не Луа или, может быть, равновесие, которому ты следуешь? Очень хороший вопрос. Почему ты веруешь?",shape=box,color=blue];
		j122432860 -> j649804141;
		j122432860 -> j1662502145;
		j122432860 -> j3143669981;
		j122432860 -> j3399111534;
		j122432860 -> j2649475080;
	j1476216255 [label="Ты спрашиваешь, что даёт мне такую уверенность? Одновременно с твоими словами, что мы не можем познать вселенную?",shape=box,color=blue];
		j1476216255 -> j2813293379;
	j1580955818 [label="Для того, кто не придерживается никакой веры, я понимаю, почему это может показаться так странно, oui.",shape=box,color=blue];
		j1580955818 -> j2663563121;
	j2667964072 [label="Ты спрашиваешь, что даёт мне такую уверенность?",shape=box,color=blue];
		j2667964072 -> j2813293379;
	j3012398539 [label="Ты знаешь, что это означает?!",shape=box,color=blue];
		j3012398539 -> j3018446101;
		j3012398539 -> j341469104;
	j3045626960 [label="Oui! Я не люблю срезанные цветы. Если хочешь сделать мне подарок, молюсь, чтобы это были не розы в вазе.",shape=box,color=blue];
		j3045626960 -> j683436934;
		j3045626960 -> j4021008936;
	j3648719684 [label="Pour toi ? Bien sûr.",shape=box,color=blue];
		j3648719684 -> j3782571301;
		j3648719684 -> j1310452999;
	j649804141 [label="Я... полагаю, я чувствую себя обязанным спросить.",shape=box,color=red];
		j649804141 -> j3222404579;
	j1662502145 [label="Мой ответ на тот вопрос не был по-настоящему честным.",shape=box,color=red];
		j1662502145 -> j979460944;
	j3143669981 [label="Со мной произошёл один случай. Он изменил мою жизнь.",shape=box,color=red];
		j3143669981 -> j4035081952;
	j3399111534 [label="Ничего ведь не случалось на самом деле, просто у меня было чувство. И это чувство направляло меня.",shape=box,color=red];
		j3399111534 -> j3739647936;
	j2649475080 [label="Я хочу веровать. Поэтому я верю.",shape=box,color=red];
		j2649475080 -> j3080931226;
	j2813293379 [label="Боюсь, мой ответ может тебя огорчит, волк. Не было никакого великого чуда. Ни лучей с небес, нисходящих на меня.",shape=box,color=blue];
		j2813293379 -> j3131519592;
	j2663563121 [label="«Почему эта рассудительная молодая женщина верит в такие вещи, которые я не считаю реальными, это же выглядит глупо,» non?",shape=box,color=blue];
		j2663563121 -> j412038561;
		j2663563121 -> j600884207;
	j3018446101 [label="Нет?",shape=box,color=red];
		j3018446101 -> j1503134712;
	j341469104 [label="Стоит ли мне беспокоиться?",shape=box,color=red];
		j341469104 -> j2851939116;
	j683436934 [label="Как ты догадалась, что мне хотелось спросить именно это? Просто невероятно.",shape=box,color=red];
		j683436934 -> j817154613;
	j4021008936 [label="Это... не то, что мне хотелось спросить, но я запомню, спасибо!",shape=box,color=red];
		j4021008936 -> j2846620021;
	j3782571301 [label="Почему ты веруешь в Сола?",shape=box,color=red];
		j3782571301 -> j2563733639;
	j3222404579 [label="Check boolean DrifterFaithNoPeace",color=orange];
		j3222404579 -> j80446712 [label=true,color=green];
		j3222404579 -> j925588478 [label=false,color=brown];
	j979460944 [label="Oui? Мне любопытно, зачем тебе было лгать?",shape=box,color=blue];
		j979460944 -> j3269135516;
		j979460944 -> j3215769469;
	j4035081952 [label="Тогда я завидую! Большинству не так везет в том, что бы у них было событие, на которое они могут ссылаться так ferme, oui?",shape=box,color=blue];
		j4035081952 -> j160957958;
	j3739647936 [label="А, тогда наши ответы совпадают. Я никогда не познавала чуда, разве что прибытие le Cardinal в Cathédrale.",shape=box,color=blue];
		j3739647936 -> j218860453;
	j3080931226 [label="Check boolean DrifterFaithNoPeace",color=orange];
		j3080931226 -> j1986309997 [label=true,color=green];
		j3080931226 -> j3545306609 [label=false,color=brown];
	j3131519592 [label="Non, я всегда просто чувствовала, будто в моей жизни есть некое présence, что направляет меня. Благодетель, который улыбается и указывает путь, когда я оказываюсь на перепутье, и ничего больше.",shape=box,color=blue];
		j3131519592 -> j3724338117;
		j3131519592 -> j3840436648;
	j412038561 [label="Честно? Да, вроде того. Хотя мне и не хотелось формулировать это именно так.",shape=box,color=red];
		j412038561 -> j441774668;
	j600884207 [label="Мне скорее хотелось бы узнать, если было ли какое-то событие или... момент, который к этому привёл.",shape=box,color=red];
		j600884207 -> j2813293379;
	j1503134712 [label="И я не знаю! Но теперь возможности безграничны!",shape=box,color=blue];
		j1503134712 -> j2152322782;
	j2851939116 [label="Peut-être! Ведь теперь возможности безграничны!",shape=box,color=blue];
		j2851939116 -> j2152322782;
	j817154613 [label="Потому что дьявол сказал мне, что ты это сделаешь.",shape=box,color=blue];
		j817154613 -> j3880474737;
	j2846620021 [label="Ой! Ой, простите меня! Мне очень жаль. Что хотелось узнать? Et maintenant, je suis mortifiée...",shape=box,color=blue];
		j2846620021 -> j3782571301;
		j2846620021 -> j1310452999;
	j80446712 [label="И ты говоришь, что это не даёт тебе покоя... у меня сердце сжимается от этих слов.",shape=box,color=blue];
		j80446712 -> j925588478;
	j925588478 [label="Я не стану говорить тебе, что делать. И не мне тебе указывать, по какому пути идти.",shape=box,color=blue];
		j925588478 -> j3936864134;
	j3269135516 [label="Честно говоря, не могу сказать. Это было импульсивно.",shape=box,color=red];
		j3269135516 -> j3630607769;
	j3215769469 [label="Мне показалось, что так я смогу узнать тебя получше...",shape=box,color=red];
		j3215769469 -> j1254171692;
	j160957958 [label="Но твой вопрос был о том, почему я верою, а я довольно невежливо обернула вопрос обратно к тебе, je m'excuse.",shape=box,color=blue];
		j160957958 -> j2813293379;
	j218860453 [label="И всё же, это было деяние человека и науки, а не Люминарий, non? Этот sérum, что даровал мне способность летать...",shape=box,color=blue];
		j218860453 -> j292948892;
	j1986309997 [label="И всё же ты говоришь, что это не даёт тебе достаточно покоя? Мне больно это слышать...",shape=box,color=blue];
		j1986309997 -> j583247514;
	j3545306609 [label="Мне кажется, твоя вера может быть самой сильной из всех, non?",shape=box,color=blue];
		j3545306609 -> j715575497;
	j3724338117 [label="А ты не назвала бы сыворотку Энтрати чудом?",shape=box,color=red];
		j3724338117 -> j218860453;
	j3840436648 [label="Даже голоса Лиона? Или Безразличие?",shape=box,color=red];
		j3840436648 -> j4007260819;
	j441774668 [label="Ох, считать меня наивной за то, что я верю в Светил это, пожалуй, самое вежливое, что можно подумать о человеке другого верования.",shape=box,color=blue];
		j441774668 -> j4138091879;
	j2152322782 [label="Дьяволу следует очень бояться! Берегись, нечестивый! Свет поразит тебя свыше!",shape=box,color=blue];
		j2152322782 -> j2718912295;
	j3880474737 [label="Non, non, non... Тебе ведь не хотелось меня об этом спрашивать? Ах!! Je vais lui faire bouffer un de ces livres!",shape=box,color=blue];
		j3880474737 -> j1602359304;
	j3936864134 [label="Ибо я лишь хрупкое укрытие в буре Бездны, в которой ты оказался.",shape=box,color=blue];
		j3936864134 -> j181259820;
	j3630607769 [label="Я не знаю, какой инстинкт заставил тебя сказать мне такие вещи. Но я рада, что теперь услышала от тебя правду.",shape=box,color=blue];
		j3630607769 -> j637012058;
	j1254171692 [label="О... тебе не нужно было говорить мне такие вещи, чтобы узнать меня.",shape=box,color=blue];
		j1254171692 -> j637012058;
	j292948892 [label="Это творение человека. Но я верю, что именно Сол направил наши пути, чтобы они сошлись в один.",shape=box,color=blue];
		j292948892 -> j3055957090;
	j583247514 [label="Звучит так, будто ты блуждаешь по чаще деревьев, отчаянно ища тропу, которую лишь надеешься найти.",shape=box,color=blue];
		j583247514 -> j2256996912;
	j715575497 [label="Бродить по тропе в чаще деревьев, полагаясь лишь на надежду в сердце, что она укажет путь?",shape=box,color=blue];
		j715575497 -> j4222352837;
	j4007260819 [label="Вполне возможно, я не знаю. Авось, дьявол и прав, и всё это результат науки, что пока за пределами нашего понимания. Ведь одно другое не исключает, non?",shape=box,color=blue];
		j4007260819 -> j3055957090;
	j4138091879 [label="Это меня нисколько не задевает, и я лишь рада твоей честности, как всегда. ",shape=box,color=blue];
		j4138091879 -> j2813293379;
	j2718912295 [label="+20 Chemistry",color=orange];
		j2718912295 -> j3199134152;
	j1602359304 [label="Что именно хотелось спросить? Et maintenant, je suis mortifiee...",shape=box,color=blue];
		j1602359304 -> j3782571301;
		j1602359304 -> j1310452999;
	j181259820 [label="Но я задаюсь вопросом, если ты стоишь на перепутье, и, может быть, тебе стоило бы задуматься в каком направлении двигаться дальше, non?",shape=box,color=blue];
		j181259820 -> j1788768280;
	j637012058 [label="Душа не сводится лишь к вере, что исповедуется. Я une Sœur de Sol, но хочу надеяться, что ты видишь во мне нечто большее, чем это, non?",shape=box,color=blue];
		j637012058 -> j3254229020;
	j3055957090 [label="Вот почему я верую. Когда я теряюсь и не знаю, в каком направлении двигаться, я ощущаю Сола рядом с собой. Закрываю глаза et il est là, чтобы направить меня.",shape=box,color=blue];
		j3055957090 -> j2329663399;
		j3055957090 -> j2786784645;
		j3055957090 -> j3377410038;
	j2256996912 [label="Я не знаю, найдёшь ли ты это когда-нибудь, но молюсь, чтобы нашёл. Ведь то, что ты там откроешь, будет un miracle. ",shape=box,color=blue];
		j2256996912 -> j160957958;
	j4222352837 [label="Это прекрасно...",shape=box,color=blue];
		j4222352837 -> j160957958;
	j3199134152 [label="Sainte Mère Sol, vous avez béni votre fille aujourd'hui ! HA-HA !!",shape=box,color=blue];
		j3199134152 -> "Chat ends.";
	j1788768280 [label="Обязанность не может быть причиной веры. В лучшем случае он приносит сомнение, а в худшем холодное презрение.",shape=box,color=blue];
		j1788768280 -> j3532941953;
	j3254229020 [label="Тем для выбора столько же, сколько звезд на небе!",shape=box,color=blue];
		j3254229020 -> j3378729597;
		j3254229020 -> j251868864;
	j2329663399 [label="Это прекрасно.",shape=box,color=red];
		j2329663399 -> j540544197;
	j2786784645 [label="Бывало ли так, что он переставал тебя направлять?",shape=box,color=red];
		j2786784645 -> j1007438783;
	j3377410038 [label="Мне хотелось бы также...",shape=box,color=red];
		j3377410038 -> j846612573;
	j3532941953 [label="Вера должна быть бальзамом для души. Не опорой и не оправданием.",shape=box,color=blue];
		j3532941953 -> j2115506538;
	j3378729597 [label="Значит, ты прощаешь меня?",shape=box,color=red];
		j3378729597 -> j5104361;
	j251868864 [label="Мне жаль. Это было глупо с моей стороны.",shape=box,color=red];
		j251868864 -> j503008410;
	j540544197 [label="Oui, и я знаю, что мне повезло. И это покой, который так легко хочется навязать другим, хотят они того или нет.",shape=box,color=blue];
		j540544197 -> j541045823;
	j1007438783 [label="Oui, много раз. И в такие моменты я размышляю, почему. Возможно, мне просто суждено искать свой путь, non? Ou peut-être que je suis une folle après tout, хах! Нам не всегда дано знать.",shape=box,color=blue];
		j1007438783 -> j541045823;
	j846612573 [label="Oui, и я молюсь, чтобы однажды и ты это обретёшь. Но это не то, что можно передать или чему можно научить, это то, что нужно найти самостоятельно.",shape=box,color=blue];
		j846612573 -> j1228165689;
	j2115506538 [label="Boolean DrifterCrossroads is now true.",color=orange];
		j2115506538 -> j160957958;
	j5104361 [label="Oui, я тебя прощаю. Будь ты как Лион, десять ударов плетью были бы твоей расплатой.",shape=box,color=blue];
		j5104361 -> j3729337789;
	j503008410 [label="Oui, и будь ты как Лион, я бы сказала, что тебе полагается десять ударов плетью в наказание! Но ты не он. И я прощаю.",shape=box,color=blue];
		j503008410 -> j3729337789;
	j541045823 [label="Пока мои верования никому не приносят вреда, я не вижу ничего дурного в том, чтобы их иметь, oui?",shape=box,color=blue];
		j541045823 -> j3443489496;
	j1228165689 [label="В тебе или вне тебя, где бы это ни находилось, для каждого оно своё.",shape=box,color=blue];
		j1228165689 -> j3443489496;
	j3729337789 [label="Boolean DrifterFaithBalance is now false.",color=orange];
		j3729337789 -> j1006535126;
	j3443489496 [label="Однако в последнее время одно стало для меня совершенно ясно.",shape=box,color=blue];
		j3443489496 -> j1825353415;
		j3443489496 -> j4180802291;
