		2154 -> 2166;
	2150 [label="Почему ты спрашиваешь ?",shape=box,color=blue];
		2150 -> 2162;
		2150 -> 2163;
		2150 -> 2164;
		2150 -> 2165;
		2150 -> 2166;
	2151 [label="Я мог бы спросить тебя то же самое о Луа, non ? Почему ты веришь ?",shape=box,color=blue];
		2151 -> 2162;
		2151 -> 2164;
		2151 -> 2165;
		2151 -> 2166;
		2151 -> 2163;
	2155 [label="Почему именно Сол ? А не Луа или, может быть, равновесие, которому ты следуешь ? Очень хороший вопрос. Почему ты веруешь ?",shape=box,color=blue];
		2155 -> 2162;
		2155 -> 2163;
		2155 -> 2164;
		2155 -> 2165;
		2155 -> 2166;
	2157 [label="Ты спрашиваешь, что даёт мне такую уверенность ? Одновременно с твоими словами, что мы не можем познать вселенную ?",shape=box,color=blue];
		2157 -> 2168;
	2156 [label="Для того, кто не придерживается никакой веры, я понимаю, почему это может показаться так странно, oui.",shape=box,color=blue];
		2156 -> 2167;
	2158 [label="Ты спрашиваешь, что даёт мне такую уверенность ?",shape=box,color=blue];
		2158 -> 2168;
	2159 [label="Ты знаешь, что это означает ?!",shape=box,color=blue];
		2159 -> 2169;
		2159 -> 2170;
	3954 [label="Oui ! I am unfond of cut flowers. If you wish to get me a gift, I pray it will not be roses in a vase.",shape=box,color=blue];
		3954 -> 3955;
		3954 -> 3956;
	2149 [label="Pour toi ? Bien sûr.",shape=box,color=blue];
		2149 -> 2160;
		2149 -> 2161;
	2162 [label="Я... полагаю, я чувствую себя обязанным спросить.",shape=box,color=red];
		2162 -> 2172;
	2163 [label="Давая такой ответ, мои слова не были по настоящему честны.",shape=box,color=red];
		2163 -> 2173;
	2164 [label="Со мной произошёл один случай. Он изменил мою жизнь.",shape=box,color=red];
		2164 -> 2174;
	2165 [label="Ничего ведь не случалось на самом деле, просто у меня было чувство. И это чувство направляло меня.",shape=box,color=red];
		2165 -> 2175;
	2166 [label="Я хочу веровать. Поэтому я верю.",shape=box,color=red];
		2166 -> 2176;
	2168 [label="Боюсь, мой ответ может тебя огорчит, волк. Не было никакого великого чуда. Ни лучей с небес, нисходящих на меня.",shape=box,color=blue];
		2168 -> 2179;
	2167 [label="«Почему эта рассудительная молодая женщина верит в такие вещи, которые я не считаю реальными, это же выглядит глупо,» non ?",shape=box,color=blue];
