		2173 -> 2184;
		2173 -> 2185;
	2174 [label="Тогда я завидую! Большинству не так везет в том, что бы у них было событие, на которое они могут ссылаться так ferme, oui?",shape=box,color=blue];
		2174 -> 2186;
	2175 [label="А, тогда наши ответы совпадают. Я никогда не познавала чуда, разве что прибытие le Cardinal в Cathédrale.",shape=box,color=blue];
		2175 -> 2187;
	2176 [label="Check boolean DrifterFaithNoPeace",color=orange];
		2176 -> 2188 [label=true,color=green];
		2176 -> 2189 [label=false,color=brown];
	2179 [label="Non, я всегда просто чувствовала, будто в моей жизни есть некое présence, что направляет меня. Благодетель, который улыбается и указывает путь, когда я оказываюсь на перепутье, и ничего больше.",shape=box,color=blue];
		2179 -> 2191;
		2179 -> 2192;
	2177 [label="Честно? Да, вроде того. Хотя мне и не хотелось формулировать это именно так.",shape=box,color=red];
		2177 -> 2190;
	2178 [label="Мне скорее хотелось бы узнать, если было ли какое-то событие или... момент, который к этому привёл.",shape=box,color=red];
		2178 -> 2168;
	2180 [label="И я не знаю! Но теперь возможности безграничны!",shape=box,color=blue];
