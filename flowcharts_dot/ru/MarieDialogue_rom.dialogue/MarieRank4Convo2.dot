	2181 [label="Peut-être! Ведь теперь возможности безграничны!",shape=box,color=blue];
		2181 -> 2193;
	3957 [label="Because the devil told me you were going to.",shape=box,color=blue];
		3957 -> 3959;
	3958 [label="Oh ! Oh, forgive me ! I am sorry. What is it that you wished to ask ? Et maintenant, je suis mortifiée...",shape=box,color=blue];
		3958 -> 2160;
		3958 -> 2161;
	2171 [label="Chat ends.",color=orange];
	2182 [label="И ты говоришь, что это не даёт тебе покоя... у меня сердце сжимается от этих слов.",shape=box,color=blue];
		2182 -> 2183;
	2183 [label="Я не стану говорить тебе, что делать. И не мне тебе указывать, по какому пути идти.",shape=box,color=blue];
		2183 -> 2194;
	2184 [label="Честно говоря, не могу сказать. Это было импульсивно.",shape=box,color=red];
		2184 -> 2195;
	2185 [label="Мне показалось, что так я смогу узнать тебя получше...",shape=box,color=red];
		2185 -> 2196;
	2186 [label="Но твой вопрос был о том, почему я верою, а я довольно невежливо обернула вопрос обратно к тебе, je m'excuse.",shape=box,color=blue];
		2186 -> 2168;
	2187 [label="И всё же, это было деяние человека и науки, а не Люминарий, non ? Этот sérum, что даровал мне способность летать -",shape=box,color=blue];
		2187 -> 2197;
	2188 [label="И всё же ты говоришь, что это не даёт тебе достаточно покоя ? Мне больно это слышать...",shape=box,color=blue];
		2188 -> 2198;
	2189 [label="Мне кажется, твоя вера может быть самой сильной из всех, non ?",shape=box,color=blue];
		2189 -> 2199;
	2191 [label="А ты не назвала бы сыворотку Энтрати чудом?",shape=box,color=red];
		2191 -> 2187;
	2192 [label="Даже голоса Лиона? Или Безразличие?",shape=box,color=red];
		2192 -> 2201;
	2190 [label="Ох, считать меня наивной за то, что я верю в Светил это, пожалуй, самое вежливое, что можно подумать о человеке другого верования.",shape=box,color=blue];
		2190 -> 2200;
	2193 [label="Дьяволу следует очень бояться! Берегись, нечестивый! Свет поразит тебя свыше!",shape=box,color=blue];
		2193 -> 2202;
	3959 [label="Non, non, non... You were not going to ask me that, were you ? Ah !! Je vais lui faire bouffer un de ces livres !",shape=box,color=blue];
		3959 -> 3960;
	2194 [label="Ибо я лишь хрупкое укрытие в буре Бездны, в которой ты оказался.",shape=box,color=blue];
		2194 -> 2203;
	2195 [label="Я не знаю, какой инстинкт заставил тебя сказать мне такие вещи. Но я рада, что теперь услышала от тебя правду.",shape=box,color=blue];
		2195 -> 2204;
	2196 [label="О... тебе не нужно было говорить мне такие вещи, чтобы узнать меня.",shape=box,color=blue];
		2196 -> 2204;
	2197 [label="Это творение человека. Но я верю, что именно Сол направил наши пути, чтобы они сошлись в один.",shape=box,color=blue];
		2197 -> 2205;
	2198 [label="Звучит так, будто ты блуждаешь по чаще деревьев, отчаянно ища тропу, которую лишь надеешься найти.",shape=box,color=blue];
		2198 -> 2206;
	2199 [label="Бродить по тропе в чаще деревьев, полагаясь лишь на надежду в сердце, что она укажет путь ?",shape=box,color=blue];
		2199 -> 2207;
	2201 [label="Вполне возможно, я не знаю. Авось, дьявол и прав, и всё это результат науки, что пока за пределами нашего понимания. Ведь одно другое не исключает, non ?",shape=box,color=blue];
		2201 -> 2205;
	2200 [label="Это меня нисколько не задевает, и я лишь рада твоей честности, как всегда. ",shape=box,color=blue];
		2200 -> 2168;
	2202 [label="+20 Chemistry",color=orange];
		2202 -> 2208;
	3960 [label="What is it that you wished to ask ? Et maintenant, je suis mortifiée...",shape=box,color=blue];
		3960 -> 2160;
		3960 -> 2161;
	2203 [label="Но я задаюсь вопросом, если ты стоишь на перепутье, и, может быть, тебе стоило бы задуматься в каком направлении двигаться дальше, non ?",shape=box,color=blue];
		2203 -> 2209;
	2204 [label="Душа не сводится лишь к вере, что исповедуется. Я une Sœur de Sol, но хочу надеяться, что ты видишь во мне нечто большее, чем это, non ?",shape=box,color=blue];
		2204 -> 2210;
	2205 [label="Вот почему я верую. Когда я теряюсь и не знаю, в каком направлении двигаться, я ощущаю Сола рядом с собой. Закрываю глаза et il est là, чтобы направить меня.",shape=box,color=blue];
		2205 -> 2211;
		2205 -> 2212;
		2205 -> 2213;
	2206 [label="Я не знаю, найдёшь ли ты это когда-нибудь, но молюсь, чтобы нашёл. Ведь то, что ты там откроешь, будет un miracle. ",shape=box,color=blue];
		2206 -> 2186;
	2207 [label="Это прекрасно...",shape=box,color=blue];
		2207 -> 2186;
	2208 [label="Sainte Mère Sol, vous avez béni votre fille aujourd'hui ! HA-HA !!",shape=box,color=blue];
		2208 -> 2214;
	2209 [label="Обязанность не может быть причиной веры. В лучшем случае он приносит сомнение, а в худшем холодное презрение.",shape=box,color=blue];
		2209 -> 2215;
	2210 [label="Тем для выбора столько же, сколько звезд на небе!",shape=box,color=blue];
		2210 -> 2216;
		2210 -> 2217;
	2211 [label="Это прекрасно.",shape=box,color=red];
		2211 -> 2218;
	2212 [label="Бывало ли так, что он переставал тебя направлять?",shape=box,color=red];
		2212 -> 2219;
	2213 [label="Мне хотелось бы также...",shape=box,color=red];
		2213 -> 2220;
	2214 [label="Chat ends.",color=orange];
	2215 [label="Вера должна быть бальзамом для души. Не опорой и не оправданием.",shape=box,color=blue];
		2215 -> 2221;
	2216 [label="Значит, ты прощаешь меня?",shape=box,color=red];
		2216 -> 2222;
	2217 [label="Мне жаль. Это было глупо с моей стороны.",shape=box,color=red];
		2217 -> 2223;
	2218 [label="Oui, и я знаю, что мне повезло. И это покой, который так легко хочется навязать другим, хотят они того или нет.",shape=box,color=blue];
		2218 -> 2224;
	2219 [label="Oui, много раз. И в такие моменты я размышляю, почему. Возможно, мне просто суждено искать свой путь, non? Ou peut-être que je suis une folle après tout, хах! Нам не всегда дано знать.",shape=box,color=blue];
		2219 -> 2224;
	2220 [label="Oui, и я молюсь, чтобы однажды и ты это обретёшь. Но это не то, что можно передать или чему можно научить, это то, что нужно найти самостоятельно.",shape=box,color=blue];
		2220 -> 2225;
	2221 [label="Update boolean DrifterCrossroads",color=orange];
		2221 -> 2186;
	2222 [label="Oui, я тебя прощаю. Будь ты как Лион, десять ударов плетью были бы твоей расплатой.",shape=box,color=blue];
		2222 -> 2226;
	2223 [label="Oui, и будь ты как Лион, я бы сказала, что тебе полагается десять ударов плетью в наказание! Но ты не он. И я прощаю.",shape=box,color=blue];
		2223 -> 2226;
	2224 [label="Пока мои верования никому не приносят вреда, я не вижу ничего дурного в том, чтобы их иметь, oui ?",shape=box,color=blue];
		2224 -> 2227;
	2225 [label="В тебе или вне тебя, где бы это ни находилось, для каждого оно своё.",shape=box,color=blue];
		2225 -> 2227;
	2226 [label="Update boolean DrifterFaithBalance",color=orange];
