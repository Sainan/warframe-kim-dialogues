	"Chat ends." [color=orange];
	j3781347963 [label="Oui! Знаешь ли ты, что когда я нахожусь в полном полёте, меня невозможно à voir?! Je suis invisible!",shape=box,color=blue];
		j3781347963 -> j1265399834;
	j2128463269 [label="+5 Chemistry",color=orange];
		j2128463269 -> j2894622072;
	j186264682 [label="+5 Chemistry",color=orange];
		j186264682 -> j3648719684;
	j58771541 [label="Вроде тобой упоминалось, что у тебя такая же вера, как и у меня, non ? Почему ты веришь ?",shape=box,color=blue];
		j58771541 -> j649804141;
		j58771541 -> j3439949280;
		j58771541 -> j3143669981;
		j58771541 -> j2522414934;
		j58771541 -> j2649475080;
	j3315803401 [label="Вроде тобой упоминалось, что тоже веруешь, хоть твоя вера и иная, чем моя. Почему ты веруешь ?",shape=box,color=blue];
		j3315803401 -> j649804141;
		j3315803401 -> j3439949280;
		j3315803401 -> j3143669981;
		j3315803401 -> j2522414934;
		j3315803401 -> j2649475080;
	j1931924732 [label="Вроде тобой упоминалось, что твоя вера это твоё личное дело, как une histoire, которую ты самостоятельно создаёшь, но всё же это всё равно вера. Почему ты веруешь ?",shape=box,color=blue];
		j1931924732 -> j649804141;
		j1931924732 -> j3439949280;
		j1931924732 -> j3143669981;
		j1931924732 -> j2522414934;
		j1931924732 -> j2649475080;
	j2309772683 [label="Почему ты спрашиваешь ?",shape=box,color=blue];
		j2309772683 -> j649804141;
		j2309772683 -> j3439949280;
		j2309772683 -> j3143669981;
		j2309772683 -> j2522414934;
		j2309772683 -> j2649475080;
	j4231141 [label="Я мог бы спросить тебя то же самое о Луа, non ? Почему ты веришь ?",shape=box,color=blue];
		j4231141 -> j649804141;
		j4231141 -> j3143669981;
		j4231141 -> j2522414934;
		j4231141 -> j2649475080;
		j4231141 -> j3439949280;
	j2199017394 [label="Почему именно Сол ? А не Луа или, может быть, равновесие, которому ты следуешь ? Очень хороший вопрос. Почему ты веруешь ?",shape=box,color=blue];
		j2199017394 -> j649804141;
		j2199017394 -> j3439949280;
		j2199017394 -> j3143669981;
		j2199017394 -> j2522414934;
		j2199017394 -> j2649475080;
	j1275012514 [label="Ты спрашиваешь, что даёт мне такую уверенность ? Одновременно с твоими словами, что мы не можем познать вселенную ?",shape=box,color=blue];
		j1275012514 -> j2813293379;
	j473241279 [label="Для того, кто не придерживается никакой веры, я понимаю, почему это может показаться так странно, oui.",shape=box,color=blue];
		j473241279 -> j2907163789;
	j2192063355 [label="Ты спрашиваешь, что даёт мне такую уверенность ?",shape=box,color=blue];
		j2192063355 -> j2813293379;
	j1265399834 [label="Ты знаешь, что это означает ?!",shape=box,color=blue];
		j1265399834 -> j3018446101;
		j1265399834 -> j341469104;
	j2894622072 [label="Oui ! I am unfond of cut flowers. If you wish to get me a gift, I pray it will not be roses in a vase.",shape=box,color=blue];
		j2894622072 -> j1167775302;
		j2894622072 -> j1744236198;
	j3648719684 [label="Pour toi ? Bien sûr.",shape=box,color=blue];
		j3648719684 -> j3782571301;
		j3648719684 -> j1310452999;
	j649804141 [label="Я... полагаю, я чувствую себя обязанным спросить.",shape=box,color=red];
		j649804141 -> j3222404579;
	j3439949280 [label="Давая такой ответ, мои слова не были по настоящему честны.",shape=box,color=red];
		j3439949280 -> j2928608106;
	j3143669981 [label="Со мной произошёл один случай. Он изменил мою жизнь.",shape=box,color=red];
		j3143669981 -> j4035081952;
	j2522414934 [label="Ничего ведь не случалось на самом деле, просто у меня было чувство. И это чувство направляло меня.",shape=box,color=red];
		j2522414934 -> j2632620715;
	j2649475080 [label="Я хочу веровать. Поэтому я верю.",shape=box,color=red];
		j2649475080 -> j3080931226;
	j2813293379 [label="Боюсь, мой ответ может тебя огорчит, волк. Не было никакого великого чуда. Ни лучей с небес, нисходящих на меня.",shape=box,color=blue];
		j2813293379 -> j3131519592;
	j2907163789 [label="«Почему эта рассудительная молодая женщина верит в такие вещи, которые я не считаю реальными, это же выглядит глупо,» non ?",shape=box,color=blue];
		j2907163789 -> j412038561;
		j2907163789 -> j600884207;
	j3018446101 [label="Нет?",shape=box,color=red];
		j3018446101 -> j1503134712;
	j341469104 [label="Стоит ли мне беспокоиться?",shape=box,color=red];
		j341469104 -> j2851939116;
	j1167775302 [label="How did you guess that was what I was going to ask? That's amazing.",shape=box,color=red];
		j1167775302 -> j2787571972;
	j1744236198 [label="That... wasn't what I was going to ask, but I will keep it in mind, thank you!",shape=box,color=red];
		j1744236198 -> j470421604;
	j3782571301 [label="Почему ты веруешь в Сола?",shape=box,color=red];
		j3782571301 -> j2563733639;
	j3222404579 [label="Check boolean DrifterFaithNoPeace",color=orange];
		j3222404579 -> j499655079 [label=true,color=green];
		j3222404579 -> j774358799 [label=false,color=brown];
	j2928608106 [label="Oui ? Мне любопытно, зачем тебе было лгать ?",shape=box,color=blue];
		j2928608106 -> j3070520444;
		j2928608106 -> j334075324;
	j4035081952 [label="Тогда я завидую! Большинству не так везет в том, что бы у них было событие, на которое они могут ссылаться так ferme, oui?",shape=box,color=blue];
		j4035081952 -> j160957958;
	j2632620715 [label="А, тогда наши ответы совпадают. Я никогда не познавала чуда, разве что прибытие le Cardinal в Cathédrale.",shape=box,color=blue];
		j2632620715 -> j1380163222;
	j3080931226 [label="Check boolean DrifterFaithNoPeace",color=orange];
		j3080931226 -> j3825161304 [label=true,color=green];
		j3080931226 -> j3645040001 [label=false,color=brown];
	j3131519592 [label="Non, я всегда просто чувствовала, будто в моей жизни есть некое présence, что направляет меня. Благодетель, который улыбается и указывает путь, когда я оказываюсь на перепутье, и ничего больше.",shape=box,color=blue];
		j3131519592 -> j3352838684;
		j3131519592 -> j3485656698;
	j412038561 [label="Честно? Да, вроде того. Хотя мне и не хотелось формулировать это именно так.",shape=box,color=red];
		j412038561 -> j441774668;
	j600884207 [label="Мне скорее хотелось бы узнать, если было ли какое-то событие или... момент, который к этому привёл.",shape=box,color=red];
		j600884207 -> j2813293379;
	j1503134712 [label="И я не знаю! Но теперь возможности безграничны!",shape=box,color=blue];
		j1503134712 -> j2152322782;
	j2851939116 [label="Peut-être! Ведь теперь возможности безграничны!",shape=box,color=blue];
		j2851939116 -> j2152322782;
	j2787571972 [label="Because the devil told me you were going to.",shape=box,color=blue];
		j2787571972 -> j3920130825;
	j470421604 [label="Oh ! Oh, forgive me ! I am sorry. What is it that you wished to ask ? Et maintenant, je suis mortifiée...",shape=box,color=blue];
		j470421604 -> j3782571301;
		j470421604 -> j1310452999;
	j499655079 [label="И ты говоришь, что это не даёт тебе покоя... у меня сердце сжимается от этих слов.",shape=box,color=blue];
		j499655079 -> j774358799;
	j774358799 [label="Я не стану говорить тебе, что делать. И не мне тебе указывать, по какому пути идти.",shape=box,color=blue];
		j774358799 -> j3599885711;
	j3070520444 [label="Честно говоря, не могу сказать. Это было импульсивно.",shape=box,color=red];
		j3070520444 -> j3895582766;
	j334075324 [label="Мне показалось, что так я смогу узнать тебя получше...",shape=box,color=red];
		j334075324 -> j2866439058;
	j160957958 [label="Но твой вопрос был о том, почему я верою, а я довольно невежливо обернула вопрос обратно к тебе, je m'excuse.",shape=box,color=blue];
		j160957958 -> j2813293379;
	j1380163222 [label="И всё же, это было деяние человека и науки, а не Люминарий, non ? Этот sérum, что даровал мне способность летать -",shape=box,color=blue];
		j1380163222 -> j292948892;
	j3825161304 [label="И всё же ты говоришь, что это не даёт тебе достаточно покоя ? Мне больно это слышать...",shape=box,color=blue];
		j3825161304 -> j583247514;
	j3645040001 [label="Мне кажется, твоя вера может быть самой сильной из всех, non ?",shape=box,color=blue];
		j3645040001 -> j3212425527;
	j3352838684 [label="А ты не назвала бы сыворотку Энтрати чудом?",shape=box,color=red];
		j3352838684 -> j1380163222;
	j3485656698 [label="Даже голоса Лиона? Или Безразличие?",shape=box,color=red];
		j3485656698 -> j3633315548;
	j441774668 [label="Ох, считать меня наивной за то, что я верю в Светил это, пожалуй, самое вежливое, что можно подумать о человеке другого верования.",shape=box,color=blue];
		j441774668 -> j4138091879;
	j2152322782 [label="Дьяволу следует очень бояться! Берегись, нечестивый! Свет поразит тебя свыше!",shape=box,color=blue];
		j2152322782 -> j2718912295;
	j3920130825 [label="Non, non, non... You were not going to ask me that, were you ? Ah !! Je vais lui faire bouffer un de ces livres !",shape=box,color=blue];
		j3920130825 -> j1595618664;
	j3599885711 [label="Ибо я лишь хрупкое укрытие в буре Бездны, в которой ты оказался.",shape=box,color=blue];
		j3599885711 -> j4135819878;
	j3895582766 [label="Я не знаю, какой инстинкт заставил тебя сказать мне такие вещи. Но я рада, что теперь услышала от тебя правду.",shape=box,color=blue];
		j3895582766 -> j2683212843;
	j2866439058 [label="О... тебе не нужно было говорить мне такие вещи, чтобы узнать меня.",shape=box,color=blue];
		j2866439058 -> j2683212843;
	j292948892 [label="Это творение человека. Но я верю, что именно Сол направил наши пути, чтобы они сошлись в один.",shape=box,color=blue];
		j292948892 -> j3055957090;
	j583247514 [label="Звучит так, будто ты блуждаешь по чаще деревьев, отчаянно ища тропу, которую лишь надеешься найти.",shape=box,color=blue];
		j583247514 -> j2256996912;
	j3212425527 [label="Бродить по тропе в чаще деревьев, полагаясь лишь на надежду в сердце, что она укажет путь ?",shape=box,color=blue];
		j3212425527 -> j4222352837;
	j3633315548 [label="Вполне возможно, я не знаю. Авось, дьявол и прав, и всё это результат науки, что пока за пределами нашего понимания. Ведь одно другое не исключает, non ?",shape=box,color=blue];
		j3633315548 -> j3055957090;
	j4138091879 [label="Это меня нисколько не задевает, и я лишь рада твоей честности, как всегда. ",shape=box,color=blue];
		j4138091879 -> j2813293379;
	j2718912295 [label="+20 Chemistry",color=orange];
		j2718912295 -> j3199134152;
	j1595618664 [label="What is it that you wished to ask ? Et maintenant, je suis mortifiée...",shape=box,color=blue];
		j1595618664 -> j3782571301;
		j1595618664 -> j1310452999;
	j4135819878 [label="Но я задаюсь вопросом, если ты стоишь на перепутье, и, может быть, тебе стоило бы задуматься в каком направлении двигаться дальше, non ?",shape=box,color=blue];
		j4135819878 -> j1788768280;
	j2683212843 [label="Душа не сводится лишь к вере, что исповедуется. Я une Sœur de Sol, но хочу надеяться, что ты видишь во мне нечто большее, чем это, non ?",shape=box,color=blue];
		j2683212843 -> j3254229020;
	j3055957090 [label="Вот почему я верую. Когда я теряюсь и не знаю, в каком направлении двигаться, я ощущаю Сола рядом с собой. Закрываю глаза et il est là, чтобы направить меня.",shape=box,color=blue];
		j3055957090 -> j3486277768;
		j3055957090 -> j392703861;
		j3055957090 -> j3377410038;
	j2256996912 [label="Я не знаю, найдёшь ли ты это когда-нибудь, но молюсь, чтобы нашёл. Ведь то, что ты там откроешь, будет un miracle. ",shape=box,color=blue];
		j2256996912 -> j160957958;
	j4222352837 [label="Это прекрасно...",shape=box,color=blue];
		j4222352837 -> j160957958;
	j3199134152 [label="Sainte Mère Sol, vous avez béni votre fille aujourd'hui ! HA-HA !!",shape=box,color=blue];
		j3199134152 -> "Chat ends.";
	j1788768280 [label="Обязанность не может быть причиной веры. В лучшем случае он приносит сомнение, а в худшем холодное презрение.",shape=box,color=blue];
		j1788768280 -> j3532941953;
	j3254229020 [label="Тем для выбора столько же, сколько звезд на небе!",shape=box,color=blue];
		j3254229020 -> j3378729597;
		j3254229020 -> j251868864;
	j3486277768 [label="Это прекрасно.",shape=box,color=red];
		j3486277768 -> j980150710;
	j392703861 [label="Бывало ли так, что он переставал тебя направлять?",shape=box,color=red];
		j392703861 -> j3249021496;
	j3377410038 [label="Мне хотелось бы также...",shape=box,color=red];
		j3377410038 -> j846612573;
	j3532941953 [label="Вера должна быть бальзамом для души. Не опорой и не оправданием.",shape=box,color=blue];
		j3532941953 -> j2115506538;
	j3378729597 [label="Значит, ты прощаешь меня?",shape=box,color=red];
		j3378729597 -> j5104361;
	j251868864 [label="Мне жаль. Это было глупо с моей стороны.",shape=box,color=red];
		j251868864 -> j503008410;
	j980150710 [label="Oui, и я знаю, что мне повезло. И это покой, который так легко хочется навязать другим, хотят они того или нет.",shape=box,color=blue];
		j980150710 -> j2807841902;
	j3249021496 [label="Oui, много раз. И в такие моменты я размышляю, почему. Возможно, мне просто суждено искать свой путь, non? Ou peut-être que je suis une folle après tout, хах! Нам не всегда дано знать.",shape=box,color=blue];
		j3249021496 -> j2807841902;
	j846612573 [label="Oui, и я молюсь, чтобы однажды и ты это обретёшь. Но это не то, что можно передать или чему можно научить, это то, что нужно найти самостоятельно.",shape=box,color=blue];
		j846612573 -> j1228165689;
	j2115506538 [label="Boolean DrifterCrossroads is now true.",color=orange];
		j2115506538 -> j160957958;
	j5104361 [label="Oui, я тебя прощаю. Будь ты как Лион, десять ударов плетью были бы твоей расплатой.",shape=box,color=blue];
		j5104361 -> j3729337789;
	j503008410 [label="Oui, и будь ты как Лион, я бы сказала, что тебе полагается десять ударов плетью в наказание! Но ты не он. И я прощаю.",shape=box,color=blue];
		j503008410 -> j3729337789;
	j2807841902 [label="Пока мои верования никому не приносят вреда, я не вижу ничего дурного в том, чтобы их иметь, oui ?",shape=box,color=blue];
		j2807841902 -> j3443489496;
	j1228165689 [label="В тебе или вне тебя, где бы это ни находилось, для каждого оно своё.",shape=box,color=blue];
		j1228165689 -> j3443489496;
	j3729337789 [label="Boolean DrifterFaithBalance is now false.",color=orange];
		j3729337789 -> j1006535126;
	j3443489496 [label="Однако в последнее время одно стало для меня совершенно ясно.",shape=box,color=blue];
		j3443489496 -> j1825353415;
		j3443489496 -> j4180802291;
	j1006535126 [label="Boolean DrifterFaithYesForeign is now false.",color=orange];
		j1006535126 -> j209219430;
	j1825353415 [label="Что?",shape=box,color=red];
		j1825353415 -> j1646882152;
	j4180802291 [label="Ох?",shape=box,color=red];
