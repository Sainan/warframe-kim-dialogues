digraph {
	"MarieRank1Convo5 begins." [color=orange];
		"MarieRank1Convo5 begins." -> j712118698;
	j712118698 [label="Bonjour, bonjour! Вы, должно быть, Скиталец, да? Monsieur Лойд так много мне о вас рассказывал. Я так рада нашей «встрече» здесь...",shape=box,color=blue];
		j712118698 -> j428025011;
	j428025011 [label="Appareil cliquetant, но раздражающее устройство !",shape=box,color=blue];
		j428025011 -> j3187048200;
	j3187048200 [label="Меня зовут сестра Мари Леру, но ты можешь называть меня Мари. Недавно я приехала сюда с братом моей души, отцом Лионом Аллардом, и… ну, думаю, Monsieur Лойд, возможно, говорил тебе о дьяволе, n’est-ce pas?",shape=box,color=blue];
		j3187048200 -> j2114383311;
		j3187048200 -> j332053819;
		j3187048200 -> j1310452999;
	j2114383311 [label="Приятно познакомиться. И не поймите неправильно, вам здесь рады, но... что вы все здесь делаете?",shape=box,color=red];
		j2114383311 -> j2106552108;
	j332053819 [label="Дьявол? Ты имеешь в виду Орокин?",shape=box,color=red];
		j332053819 -> j674542629;
	j1310452999 [label="[Конец.]",shape=box,color=red];
		j1310452999 -> "Chat ends.";
	j2106552108 [label="+5 Chemistry",color=orange];
		j2106552108 -> j2515653162;
	j674542629 [label="Да, это чудовище, à la peau bleue, доверенное нам le Cardinal. Полагаю, ты знаешь его как Альбрехта Энтрати? Он — причина, по которой мы здесь. Но это очень долгая история, j’en ai bien peur.",shape=box,color=blue];
		j674542629 -> j2354924744;
		j674542629 -> j688385929;
	"Chat ends." [color=orange];
	j2515653162 [label="Merci ! The what and the how of our being here is a very long story, j'en ai bien peur. We were sent here by le Cardinal. I believe you know him as Albrecht Entrati ? He entrusted us with that blue-skinned monstre irritant.",shape=box,color=blue];
		j2515653162 -> j2354924744;
		j2515653162 -> j688385929;
	j2354924744 [label="Я сделаю все возможное, чтобы помочь.",shape=box,color=red];
		j2354924744 -> j2790986558;
	j688385929 [label="«Доверено?»",shape=box,color=red];
		j688385929 -> j936407693;
	j2790986558 [label="+5 Chemistry",color=orange];
		j2790986558 -> j2464907899;
	j936407693 [label="Мы должны сделать всё возможное, чтобы направить его душу на правильный путь, si c’est possible. Et si ce n’est pas le cas? Тогда мы должны по крайней мере позаботиться о том, чтобы он больше не причинял вреда.",shape=box,color=blue];
		j936407693 -> j4174287213;
		j936407693 -> j3859330190;
	j2464907899 [label="Именно так тебя описали описали Monsieur Лойд и Кавии! Думаю, мы обязательно станем хорошими друзьями.",shape=box,color=blue];
		j2464907899 -> j648895693;
	j4174287213 [label="Хочу помочь тебе попробовать.",shape=box,color=red];
		j4174287213 -> j2790986558;
	j3859330190 [label="Он Орокин. Единственный способ сделать это — всадить ему пулю между глаз.",shape=box,color=red];
		j3859330190 -> j2584250748;
	j648895693 [label="Ах ! Мне нужно идти, прости. Я надеюсь, мы скоро снова поговорим ! À la revoyure !",shape=box,color=blue];
		j648895693 -> "Chat ends.";
	j2584250748 [label="Ты говоришь прямо как Лион. Я не откажусь от надежды. Пока нет.",shape=box,color=blue];
		j2584250748 -> j648895693;
}