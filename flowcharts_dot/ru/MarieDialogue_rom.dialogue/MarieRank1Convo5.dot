digraph {
	3964 [label="MarieRank1Convo5 begins.",color=orange];
		3964 -> 3965;
	3965 [label="Bonjour, bonjour ! You must be the Drifter, oui ? Monsieur Loid has told me so very much about you. I am so very pleased to \"meet\" you on this...",shape=box,color=blue];
		3965 -> 3966;
	3966 [label="Appareil cliquetant, clever though it is !",shape=box,color=blue];
		3966 -> 3967;
	3967 [label="I am Sœur Marie Leroux, but you may call me Marie. I have recently come here with the brother of my soul, Father Lyon Allard and... well, I think Monsieur Loid may have warned you of the devil, n'est-ce pas ?",shape=box,color=blue];
		3967 -> 3968;
		3967 -> 3969;
		3967 -> 3970;
	3968 [label="It's lovely to meet you. And don't take this the wrong way, you're welcome here, but... what are you all doing here?",shape=box,color=red];
		3968 -> 3972;
	3969 [label="The devil? You mean the Orokin?",shape=box,color=red];
		3969 -> 3974;
	3970 [label="[Конец.]",shape=box,color=red];
		3970 -> 3971;
	3972 [label="+5 Chemistry",color=orange];
		3972 -> 3973;
	3974 [label="Oui, ce monstre irritant à la peau bleue that we have been entrusted with by le Cardinal. I believe you know him as Albrecht Entrati ? He is the reason why we are here. But that is a very long story, j'en ai bien peur.",shape=box,color=blue];
		3974 -> 3975;
		3974 -> 3976;
	3971 [label="Chat ends.",color=orange];
	3973 [label="Merci ! The what and the how of our being here is a very long story, j'en ai bien peur. We were sent here by le Cardinal. I believe you know him as Albrecht Entrati ? He entrusted us with that blue-skinned irritant monstrueux.",shape=box,color=blue];
		3973 -> 3975;
		3973 -> 3976;
	3975 [label="I'll do what I can to help.",shape=box,color=red];
		3975 -> 3980;
	3976 [label="\"Entrusted?\"",shape=box,color=red];
		3976 -> 3977;
	3980 [label="+5 Chemistry",color=orange];
		3980 -> 3981;
	3977 [label="We are to do what we can to guide his soul, si c'est possible. Et si ce n'est pas le cas ? Then we must ensure at the very least that he does not cause any more harm.",shape=box,color=blue];
		3977 -> 3978;
		3977 -> 3979;
	3981 [label="You are just as Monsieur Loid and the Cavia described ! I think we are bound to be good friends.",shape=box,color=blue];
		3981 -> 3983;
	3978 [label="I'm willing to help you try.",shape=box,color=red];
		3978 -> 3980;
	3979 [label="He's Orokin. The only way you'll be able to do that is by putting a bullet between his eyes.",shape=box,color=red];
		3979 -> 3982;
	3983 [label="Ah ! I must go, forgive me. I hope we shall speak again soon ! À la revoyure !",shape=box,color=blue];
		3983 -> 3984;
	3982 [label="You sound like Lyon. I shall not give up hope. Not yet.",shape=box,color=blue];
		3982 -> 3983;
	3984 [label="Chat ends.",color=orange];
}