digraph {
	graph [fontname="Roboto Condensed"];
	node [fontname="Roboto Condensed"];
	edge [fontname="Roboto Condensed"];

	"MarieRank1Convo5 begins." [color=orange];
		"MarieRank1Convo5 begins." -> j342743106;
	j342743106 [label="Bonjour, bonjour! Вы, должно быть, Скиталец, да? Monsieur Лойд так много мне о вас рассказывал. Я так рада нашей «встрече» здесь...",shape=box,color=blue];
		j342743106 -> j3258628973;
	j3258628973 [label="Appareil cliquetant, но раздражающее устройство !",shape=box,color=blue];
		j3258628973 -> j1934491583;
	j1934491583 [label="Меня зовут сестра Мари Леру, но ты можешь называть меня Мари. Недавно я приехала сюда с братом моей души, отцом Лионом Аллардом, и… ну, думаю, Monsieur Лойд, возможно, говорил тебе о дьяволе, n'est-ce pas?",shape=box,color=blue];
		j1934491583 -> j1176503370;
		j1934491583 -> j1500907527;
		j1934491583 -> j1310452999;
	j1176503370 [label="Приятно познакомиться. И не поймите неправильно, вам здесь рады, но... что вы все здесь делаете?",shape=box,color=red];
		j1176503370 -> j2169524469;
	j1500907527 [label="Дьявол? Ты имеешь в виду Орокин?",shape=box,color=red];
		j1500907527 -> j3912091449;
	j1310452999 [label="[Конец.]",shape=box,color=red];
		j1310452999 -> "Chat ends.";
	j2169524469 [label="+5 Chemistry",color=orange];
		j2169524469 -> j2173686369;
	j3912091449 [label="Да, это чудовище, à la peau bleue, доверенное нам le Cardinal. Полагаю, ты знаешь его как Альбрехта Энтрати? Он — причина, по которой мы здесь. Но это очень долгая история, j'en ai bien peur.",shape=box,color=blue];
		j3912091449 -> j2002857747;
		j3912091449 -> j2387190216;
	"Chat ends." [color=orange];
	j2173686369 [label="Спасибо! Что и как привело нас сюда — очень долгая история, j'en ai bien peur. Нас послал сюда le Cardinal. Полагаю, ты знаешь его как Альбрехта Энтрати? Он доверил нам этого синекожего monstre irritant.",shape=box,color=blue];
		j2173686369 -> j2002857747;
		j2173686369 -> j2387190216;
	j2002857747 [label="Я сделаю все возможное, чтобы помочь.",shape=box,color=red];
		j2002857747 -> j3775438496;
	j2387190216 [label="«Доверено?»",shape=box,color=red];
		j2387190216 -> j1223482523;
	j3775438496 [label="+5 Chemistry",color=orange];
		j3775438496 -> j3516263181;
	j1223482523 [label="Мы должны сделать всё возможное, чтобы направить его душу на правильный путь, si c'est possible. Et si ce n'est pas le cas? Тогда мы должны по крайней мере позаботиться о том, чтобы он больше не причинял вреда.",shape=box,color=blue];
		j1223482523 -> j2448155199;
		j1223482523 -> j3859330190;
	j3516263181 [label="Именно так тебя описали описали Monsieur Лойд и Кавии! Думаю, мы обязательно станем хорошими друзьями.",shape=box,color=blue];
		j3516263181 -> j648895693;
	j2448155199 [label="Хочу помочь тебе попробовать.",shape=box,color=red];
		j2448155199 -> j3775438496;
	j3859330190 [label="Он Орокин. Единственный способ сделать это — всадить ему пулю между глаз.",shape=box,color=red];
		j3859330190 -> j2584250748;
	j648895693 [label="Ах ! Мне нужно идти, прости. Я надеюсь, мы скоро снова поговорим ! À la revoyure !",shape=box,color=blue];
		j648895693 -> "Chat ends.";
	j2584250748 [label="Ты говоришь прямо как Лион. Я не откажусь от надежды. Пока нет.",shape=box,color=blue];
		j2584250748 -> j648895693;
}