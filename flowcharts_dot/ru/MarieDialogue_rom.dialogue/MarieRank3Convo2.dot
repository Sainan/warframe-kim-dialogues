digraph {
	1015 [label="MarieRank3Convo2 begins.",color=orange];
		1015 -> 3736;
	3736 [label="Update boolean MarieLyonAvailable",color=orange];
		3736 -> 2923;
	2923 [label="Check boolean LoidFamilyComplete",color=orange];
		2923 -> 2924 [label=true,color=green];
		2923 -> 1016 [label=false,color=brown];
	2924 [label="Надеюсь, ты не сочтёшь меня немощной… но порой я испытываю самое странное ощущение, будто я уже делала это раньше?",shape=box,color=blue];
		2924 -> 2925;
	1016 [label="Check boolean MarieFamily1",color=orange];
		1016 -> 1017 [label=true,color=green];
		1016 -> 1018 [label=false,color=brown];
	2925 [label="Вела ли я эти разговоры… встречала ли этих людей… хотя это же невозможно, non?",shape=box,color=blue];
		2925 -> 2926;
	1017 [label="Расскажешь мне больше о famille le Cardinal? Мне очень интересно узнать о его прошлом.",shape=box,color=blue];
		1017 -> 1020;
		1017 -> 1021;
		1017 -> 1019;
	1018 [label="Расскажешь мне о famille le Cardinal? Мне очень интересно узнать о его прошлом.",shape=box,color=blue];
		1018 -> 1020;
		1018 -> 1021;
		1018 -> 1019;
	2926 [label="+20 Chemistry",color=orange];
		2926 -> 2927;
	1020 [label="Я расскажу тебе всё, что знаю, но боюсь, что это не так много, как ты можешь подумать.",shape=box,color=red];
		1020 -> 1023;
	1021 [label="О, конечно, но... разве Лойд не тот, с кем лучше об этом поговорить?",shape=box,color=red];
		1021 -> 1024;
	1019 [label="[Конец.]",shape=box,color=red];
		1019 -> 1022;
	2927 [label="Мы называем это déjà vu. Должно быть, из-за serum и путешествия во времени. C'est la vie!",shape=box,color=blue];
		2927 -> 2928;
	1023 [label="Я сохраню в памяти всё, что ты мне расскажешь. Promis!",shape=box,color=blue];
		1023 -> 1025;
	1024 [label="Кстати о le Cardinal... похоже, это очень сильно ранит Monsieur Лойда. Мне не нравится слишком часто задевать его этим.",shape=box,color=blue];
		1024 -> 1025;
	1022 [label="Chat ends.",color=orange];
	2928 [label="Chat ends.",color=orange];
	1025 [label="Особенно учитывая, что я делаю это avec une certaine joie, чего, похоже, никто другой не делает.",shape=box,color=blue];
		1025 -> 1026;
		1025 -> 1027;
	1026 [label="О ком ты хочешь узнать?",shape=box,color=red];
		1026 -> 1028;
	1027 [label="Ну, там есть Мать, Отец, Сын, Дочь и Бабушка.",shape=box,color=red];
		1027 -> 1028;
	1028 [label="Сначала разберись с одним моментом, ладно? Дьявол каждый раз смеётся надо мной, когда я спрашиваю, будто это какая-то личная шутка. Grand-mère. Бабушка.",shape=box,color=blue];
		1028 -> 1029;
	1029 [label="Это ведь не жена Кардинала, правда?",shape=box,color=blue];
		1029 -> 1030;
	1030 [label="Нет, это мать отца. Теща матери.",shape=box,color=red];
		1030 -> 1031;
	1031 [label="Je… vois. И… почему они не называют друг друга по имени? Ne serait-ce pas plus simple?",shape=box,color=blue];
		1031 -> 1032;
		1031 -> 1033;
	1032 [label="Хочешь услышать длинную историю?",shape=box,color=red];
		1032 -> 1034;
	1033 [label="Я расскажу тебе вкратце.",shape=box,color=red];
		1033 -> 1035;
	1034 [label="Oui ! У меня ещё есть немного времени, так что я вся во внимании.",shape=box,color=blue];
		1034 -> 1036;
	1035 [label="Семья наверху оказалась здесь в ловушке после падения Империи Орокин. Сын, внук Энтрати, впустил Зараженных.",shape=box,color=red];
		1035 -> 1037;
	1036 [label="Итак, мы на луне под названием Деймос. Здесь давным-давно была взорвана биологическая бомба в отчаянной попытке отразить Владеющих Разумом.",shape=box,color=red];
		1036 -> 1038;
	1037 [label="Par Sol! Намеренно?",shape=box,color=blue];
		1037 -> 1039;
	1038 [label="Те, с кем Орокин воевали давным-давно? Те, кого мы видим в Тёмном Рефрактории с дьяволом, oui?",shape=box,color=blue];
		1038 -> 1040;
	1039 [label="Check /Lotus/Scripts/1999/DialogueScriptNodes.lua:IsSyndicateRank",color=orange];
		1039 -> 1041 [label=true,color=green];
		1039 -> 1042 [label=true,color=green];
		1039 -> 1042 [label=false,color=brown];
		1039 -> 1043 [label=false,color=brown];
	1040 [label="Да. Они пытались использовать Заражение для борьбы с Владеющими Разумом. Но Деймос был полностью захвачен. Они заперлись в Некралиске, который находится над нами, чтобы укрыться.",shape=box,color=red];
		1040 -> 1044;
	1041 [label=" Нет, я думаю, это была случайность. Я думаю, он хотел как лучше.",shape=box,color=red];
		1041 -> 1045;
	1042 [label="Я пока не знаю правды, но воздержусь от суждений, пока не узнаю больше.",shape=box,color=red];
		1042 -> 1045;
	1043 [label="Я пока не знаю всей правды, но он высокомерен, это я тебе точно скажу.",shape=box,color=red];
		1043 -> 1046;
	1044 [label="Однако сын, внук Энтрати, был полон решимости сохранить и изучать заражённых животных.",shape=box,color=red];
		1044 -> 1047;
	1045 [label="+10 Chemistry",color=orange];
		1045 -> 1048;
	1046 [label="Какой позор. Надеюсь, это не правда, ради него и ради нас. Продолжай, пожалуйста.",shape=box,color=blue];
		1046 -> 1049;
	1047 [label="О, Сол... он хотел как лучше?",shape=box,color=blue];
		1047 -> 1076;
	1048 [label="Очень любезно с твоей стороны. Continuez, s'il vous plaît.",shape=box,color=blue];
		1048 -> 1049;
	1049 [label="Итак, запертые в Некралиске, охваченные горем, без Империи Орокин, которая могла бы прийти на помощь, а теперь еще и Заражение просачивается внутрь...",shape=box,color=red];
		1049 -> 1053;
	1076 [label="Check /Lotus/Scripts/1999/DialogueScriptNodes.lua:IsSyndicateRank",color=orange];
		1076 -> 1051 [label=true,color=green];
		1076 -> 1052 [label=true,color=green];
		1076 -> 1055 [label=true,color=green];
		1076 -> 1051 [label=false,color=brown];
		1076 -> 1052 [label=false,color=brown];
		1076 -> 1054 [label=false,color=brown];
	1053 [label="Они набросились друг на друга. Разорвали друг друга на части изнутри. А остальное довершило Заражение, лишив их даже имён. ",shape=box,color=red];
		1053 -> 1058;
	1051 [label="Да, я думаю, он так и сделал. Мне кажется, он действительно заботится о этих существах.",shape=box,color=red];
		1051 -> 1056;
	1052 [label="К сожалению, это не имело значения: ущерб был нанесен.",shape=box,color=red];
		1052 -> 1057;
	1055 [label="Нет, им двигало высокомерие. Даже если он утверждает, что это была случайность.",shape=box,color=red];
		1055 -> 1059;
	1054 [label="Я пока не знаю всей правды, но он высокомерен, это я тебе точно скажу.",shape=box,color=red];
		1054 -> 1059;
	1058 [label="Это высшая форма жестокости - быть лишённым имени...",shape=box,color=blue];
		1058 -> 1062;
	1056 [label="+10 Chemistry",color=orange];
		1056 -> 1060;
	1057 [label="+5 Chemistry",color=orange];
		1057 -> 1061;
	1059 [label="Какой позор. Надеюсь, это не правда, ради него и ради нас. Продолжай, пожалуйста.",shape=box,color=blue];
		1059 -> 1049;
	1062 [label="Update boolean MarieFamily2",color=orange];
		1062 -> 1066;
		1062 -> 1067;
		1062 -> 1068;
	1060 [label="Интересно, что бы он подумал о Кавии… Жаль, что он не может встретиться с ними...",shape=box,color=blue];
		1060 -> 1063;
		1060 -> 1064;
	1061 [label="Если бы значение имела только чистота намерений, мир был бы прекрасным местом, non? C'est la vie.",shape=box,color=blue];
		1061 -> 1065;
	1066 [label="Если только ты не отдашь это, как бабушка.",shape=box,color=red];
		1066 -> 1071;
	1067 [label="Честно говоря, всё не так уж плохо, со временем привыкаешь.",shape=box,color=red];
		1067 -> 1072;
	1068 [label="У животных нет имён, и они кажутся вполне счастливыми. Мы даём им имена просто для собственного удовольствия.",shape=box,color=red];
		1068 -> 1073;
	1063 [label="Я улыбаюсь при одной этой мысли. Но, думаю, это было бы неразумно.",shape=box,color=red];
		1063 -> 1069;
	1064 [label="Я надеюсь, что это когда-нибудь произойдёт. Очень надеюсь.",shape=box,color=red];
		1064 -> 1070;
	1065 [label="Et ensuite?",shape=box,color=blue];
		1065 -> 1049;
	1071 [label="+5 Chemistry",color=orange];
		1071 -> 1077;
	1072 [label="А-а-ах! Quelle horreur! Я не хотела! Мне так жаль, прости меня, я не хотела… ох, я такая глупая!",shape=box,color=blue];
		1072 -> 1078;
		1072 -> 1079;
	1073 [label="+5 Chemistry",color=orange];
		1073 -> 1080;
	1069 [label="А почему бы и нет?",shape=box,color=blue];
		1069 -> 1074;
		1069 -> 1075;
	1070 [label="Add 1 to Family",color=orange];
		1070 -> 1050;
	1077 [label="Теперь она звучит как та дама, с которой мне бы очень хотелось познакомиться… ",shape=box,color=blue];
		1077 -> 1085;
	1078 [label="И как ты собираешься загладить свою вину?",shape=box,color=red];
		1078 -> 1086;
	1079 [label="Всё в порядке, просто шучу. Обиды нет.",shape=box,color=red];
		1079 -> 1087;
	1080 [label="That is quite true ! I never thought of it that way. And you could choose your own. How freeing, in its own sense.",shape=box,color=blue];
		1080 -> 1085;
	1074 [label="Боюсь, одна половина будет воспринимать другую как «другую семью».",shape=box,color=red];
		1074 -> 1081;
	1075 [label="Ситуация наверху… даже в лучшие дни довольно хрупкая. Не хочу их расстраивать.",shape=box,color=red];
		1075 -> 1082;
	1050 [label="Check /Lotus/Scripts/1999/DialogueScriptNodes.lua:IsSyndicateRank",color=orange];
		1050 -> 1083 [label=true,color=green];
		1050 -> 1084 [label=false,color=brown];
	1085 [label="Это был такой замечательный разговор, но боюсь, что пришло моё время подавать обед. Monsieur Лойд учит меня правильно подавать чай по его манере!",shape=box,color=blue];
		1085 -> 1094;
	1086 [label="Maintenant, vous parlez aussi mal que le diable. Нет, я не поведусь на твои уловки.",shape=box,color=blue];
		1086 -> 1095;
	1087 [label="+5 Chemistry",color=orange];
		1087 -> 1096;
	1081 [label="Add 1 to Family",color=orange];
		1081 -> 1088;
	1082 [label="Ты удивишься, насколько душа устойчива. А те, кто меня сейчас окружают, так стары, так закалены временем.",shape=box,color=blue];
		1082 -> 1089;
	1083 [label="Это возможно. Возможно, проще, чем ты думаешь. Нам просто нужно подумать, как именно. ",shape=box,color=blue];
		1083 -> 1090;
		1083 -> 1091;
	1084 [label="Oui? И как продвигается твоя работа, или работа твоих крошечных копий, с семьёй наверху?",shape=box,color=blue];
		1084 -> 1092;
		1084 -> 1093;
	1094 [label="Chat ends.",color=orange];
	1095 [label="Chat ends.",color=orange];
	1096 [label="О, loué soit Sol! Но возникает вопрос... Ты знаешь, откуда появилось прозвище? «Скиталец»?»",shape=box,color=blue];
		1096 -> 1099;
		1096 -> 1100;
	1088 [label="+5 Chemistry",color=orange];
		1088 -> 1097;
	1089 [label="+5 Chemistry",color=orange];
		1089 -> 1098;
	1090 [label="Нам просто нужно быть осторожными. Боюсь, одна половина будет воспринимать другую как «другую семью».",shape=box,color=red];
		1090 -> 1081;
	1091 [label="Ситуация наверху… даже в лучшие дни довольно хрупкая. Не хочу их расстраивать.",shape=box,color=red];
		1091 -> 1082;
	1092 [label="Медленно. Осторожно. Боюсь, одна половина будет воспринимать другую как «другую семью».",shape=box,color=red];
		1092 -> 1081;
	1093 [label="Ситуация наверху… даже в лучшие дни довольно хрупкая. Не хочу их расстраивать.",shape=box,color=red];
		1093 -> 1082;
	1099 [label="Надеюсь, выбор был сделан мною.",shape=box,color=red];
		1099 -> 1103;
	1100 [label="Честно говоря, я не помню.",shape=box,color=red];
		1100 -> 1104;
	1097 [label="Ох... Par Sol, я думаю, ты, возможно, разгадал эту загадку!",shape=box,color=blue];
		1097 -> 1101;
	1098 [label="Они уже много раз удивлялись. Позволь им удивить тебя хотя бы один раз.",shape=box,color=blue];
		1098 -> 1102;
	1103 [label="Какая это была бы свобода! Выбрать себе имя. В Кафедральном соборе я даже одежду себе не могла выбрать. Ха!",shape=box,color=blue];
		1103 -> 1085;
	1104 [label="Столько тайн ты приносишь с собой! ",shape=box,color=blue];
		1104 -> 1085;
	1101 [label="Update boolean MarieFamilyOther",color=orange];
		1101 -> 1105;
	1102 [label="Но, пожалуйста, пожалуйста, s'il vous plaît, продолжай свой рассказ. Ваша маленькая волчица Мари должна знать свою добычу, прежде чем охотиться по-настоящему, не так ли?",shape=box,color=blue];
		1102 -> 1106;
		1102 -> 1107;
		1102 -> 3914;
	1105 [label="Я вне себя от волнения — je suis assise ici, remuant sur ma chaise!",shape=box,color=blue];
		1105 -> 1102;
	1106 [label="Где я был?",shape=box,color=red];
		1106 -> 1108;
	1107 [label="That was a little wicked of you, wasn't it?",shape=box,color=red];
		1107 -> 1109;
	3914 [label="Perhaps I wish you would hunt me...",shape=box,color=red];
		3914 -> 3915;
	1108 [label="Сын подпустил Animaux Infestés слишком близко.",shape=box,color=blue];
		1108 -> 1049;
	1109 [label="Peut-être! Но ведь нет вреда в капле озорства во имя добра, не так ли?",shape=box,color=blue];
		1109 -> 1110;
		1109 -> 1111;
	3915 [label="Update boolean DrifterMarie",color=orange];
		3915 -> 3913;
	1110 [label="Ладно... Ладно, вернемся к истории.",shape=box,color=red];
		1110 -> 1049;
	1111 [label="Не пойми неправильно. Мне понравилось.",shape=box,color=red];
		1111 -> 1112;
	3913 [label="You are going to ruin me ! I just squeaked audibly and Monsieur Loid asked if I was all right. I had to lie and say that I saw a mouse, only for him to tell me that we have no mice in this time !",shape=box,color=blue];
		3913 -> 3916;
	1112 [label="Ха! Я так и думала. Ну всё, хватит твоих глупостей, возвращайся к своей истории. Сын подпустил Animaux Infestés слишком близко, да?",shape=box,color=blue];
		1112 -> 1049;
	3916 [label="+5 Chemistry",color=orange];
		3916 -> 3917;
	3917 [label="Quelle méchanceté, tu es terrible ! Je te déteste et tu me fais rougir maintenant !",shape=box,color=blue];
		3917 -> 3918;
		3917 -> 3919;
	3918 [label="Are you mad at me?",shape=box,color=red];
		3918 -> 3920;
	3919 [label="Ладно... Ладно, вернемся к истории.",shape=box,color=red];
		3919 -> 1049;
	3920 [label="Non ! Just continue your story !",shape=box,color=blue];
		3920 -> 1049;
