digraph {
	"MarieRank3Convo2 begins." [color=orange];
		"MarieRank3Convo2 begins." -> j3102612293;
	j3102612293 [label="Boolean MarieLyonAvailable is now true.",color=orange];
		j3102612293 -> j369807617;
	j369807617 [label="Check boolean LoidFamilyComplete",color=orange];
		j369807617 -> j2974119716 [label=true,color=green];
		j369807617 -> j1668831657 [label=false,color=brown];
	j2974119716 [label="Надеюсь, ты не сочтёшь меня немощной… но порой я испытываю самое странное ощущение, будто я уже делала это раньше?",shape=box,color=blue];
		j2974119716 -> j4049385619;
	j1668831657 [label="Check boolean MarieFamily1",color=orange];
		j1668831657 -> j765839474 [label=true,color=green];
		j1668831657 -> j658443305 [label=false,color=brown];
	j4049385619 [label="Вела ли я эти разговоры… встречала ли этих людей… хотя это же невозможно, non?",shape=box,color=blue];
		j4049385619 -> j2500437750;
	j765839474 [label="Расскажешь мне больше о famille le Cardinal? Мне очень интересно узнать о его прошлом.",shape=box,color=blue];
		j765839474 -> j4070938057;
		j765839474 -> j2528384977;
		j765839474 -> j1310452999;
	j658443305 [label="Расскажешь мне о famille le Cardinal? Мне очень интересно узнать о его прошлом.",shape=box,color=blue];
		j658443305 -> j4070938057;
		j658443305 -> j2528384977;
		j658443305 -> j1310452999;
	j2500437750 [label="+20 Chemistry",color=orange];
		j2500437750 -> j965228268;
	j4070938057 [label="Я расскажу тебе всё, что знаю, но боюсь, что это не так много, как ты можешь подумать.",shape=box,color=red];
		j4070938057 -> j2850836964;
	j2528384977 [label="О, конечно, но... разве Лойд не тот, с кем лучше об этом поговорить?",shape=box,color=red];
		j2528384977 -> j2536074914;
	j1310452999 [label="[Конец.]",shape=box,color=red];
		j1310452999 -> "Chat ends.";
	j965228268 [label="Мы называем это déjà vu. Должно быть, из-за serum и путешествия во времени. C'est la vie!",shape=box,color=blue];
		j965228268 -> "Chat ends.";
	j2850836964 [label="Я сохраню в памяти всё, что ты мне расскажешь. Promis!",shape=box,color=blue];
		j2850836964 -> j1446728503;
	j2536074914 [label="Кстати о le Cardinal... похоже, это очень сильно ранит Monsieur Лойда. Мне не нравится слишком часто задевать его этим.",shape=box,color=blue];
		j2536074914 -> j1446728503;
	"Chat ends." [color=orange];
	j1446728503 [label="Особенно учитывая, что я делаю это avec une certaine joie, чего, похоже, никто другой не делает.",shape=box,color=blue];
		j1446728503 -> j3647190566;
		j1446728503 -> j2711135236;
	j3647190566 [label="О ком ты хочешь узнать?",shape=box,color=red];
		j3647190566 -> j2365704134;
	j2711135236 [label="Ну, там есть Мать, Отец, Сын, Дочь и Бабушка.",shape=box,color=red];
		j2711135236 -> j2365704134;
	j2365704134 [label="Сначала разберись с одним моментом, ладно? Дьявол каждый раз смеётся надо мной, когда я спрашиваю, будто это какая-то личная шутка. Grand-mère. Бабушка.",shape=box,color=blue];
		j2365704134 -> j2758270167;
	j2758270167 [label="Это ведь не жена Кардинала, правда?",shape=box,color=blue];
		j2758270167 -> j2937845138;
	j2937845138 [label="Нет, это мать отца. Теща матери.",shape=box,color=red];
		j2937845138 -> j1172102865;
	j1172102865 [label="Je… vois. И… почему они не называют друг друга по имени? Ne serait-ce pas plus simple?",shape=box,color=blue];
		j1172102865 -> j94332968;
		j1172102865 -> j267422206;
	j94332968 [label="Хочешь услышать длинную историю?",shape=box,color=red];
		j94332968 -> j822948509;
	j267422206 [label="Я расскажу тебе вкратце.",shape=box,color=red];
		j267422206 -> j2792640587;
	j822948509 [label="Oui ! У меня ещё есть немного времени, так что я вся во внимании.",shape=box,color=blue];
		j822948509 -> j3212129985;
	j2792640587 [label="Семья наверху оказалась здесь в ловушке после падения Империи Орокин. Сын, внук Энтрати, впустил Зараженных.",shape=box,color=red];
		j2792640587 -> j2842713586;
	j3212129985 [label="Итак, мы на луне под названием Деймос. Здесь давным-давно была взорвана биологическая бомба в отчаянной попытке отразить Владеющих Разумом.",shape=box,color=red];
		j3212129985 -> j249803796;
	j2842713586 [label="Par Sol! Намеренно?",shape=box,color=blue];
		j2842713586 -> j385755729;
	j249803796 [label="Те, с кем Орокин воевали давным-давно? Те, кого мы видим в Тёмном Рефрактории с дьяволом, oui?",shape=box,color=blue];
		j249803796 -> j761920630;
	j385755729 [label="Check /Lotus/Scripts/1999/DialogueScriptNodes.lua:IsSyndicateRank",color=orange];
		j385755729 -> j1718550505 [label=true,color=green];
		j385755729 -> j164672711 [label=true,color=green];
		j385755729 -> j164672711 [label=false,color=brown];
		j385755729 -> j180154897 [label=false,color=brown];
	j761920630 [label="Да. Они пытались использовать Заражение для борьбы с Владеющими Разумом. Но Деймос был полностью захвачен. Они заперлись в Некралиске, который находится над нами, чтобы укрыться.",shape=box,color=red];
		j761920630 -> j4150216031;
	j1718550505 [label=" Нет, я думаю, это была случайность. Я думаю, он хотел как лучше.",shape=box,color=red];
		j1718550505 -> j3708057158;
	j164672711 [label="Я пока не знаю правды, но воздержусь от суждений, пока не узнаю больше.",shape=box,color=red];
		j164672711 -> j3708057158;
	j180154897 [label="Я пока не знаю всей правды, но он высокомерен, это я тебе точно скажу.",shape=box,color=red];
		j180154897 -> j2800366773;
	j4150216031 [label="Однако сын, внук Энтрати, был полон решимости сохранить и изучать заражённых животных.",shape=box,color=red];
		j4150216031 -> j1711620125;
	j3708057158 [label="+10 Chemistry",color=orange];
		j3708057158 -> j1660992480;
	j2800366773 [label="Какой позор. Надеюсь, это не правда, ради него и ради нас. Продолжай, пожалуйста.",shape=box,color=blue];
		j2800366773 -> j4151154469;
	j1711620125 [label="О, Сол... он хотел как лучше?",shape=box,color=blue];
		j1711620125 -> j240603373;
	j1660992480 [label="Очень любезно с твоей стороны. Continuez, s'il vous plaît.",shape=box,color=blue];
		j1660992480 -> j4151154469;
	j4151154469 [label="Итак, запертые в Некралиске, охваченные горем, без Империи Орокин, которая могла бы прийти на помощь, а теперь еще и Заражение просачивается внутрь...",shape=box,color=red];
		j4151154469 -> j3069438698;
	j240603373 [label="Check /Lotus/Scripts/1999/DialogueScriptNodes.lua:IsSyndicateRank",color=orange];
		j240603373 -> j1359920682 [label=true,color=green];
		j240603373 -> j3778037895 [label=true,color=green];
		j240603373 -> j703237995 [label=true,color=green];
		j240603373 -> j1359920682 [label=false,color=brown];
		j240603373 -> j3778037895 [label=false,color=brown];
		j240603373 -> j2248171782 [label=false,color=brown];
	j3069438698 [label="Они набросились друг на друга. Разорвали друг друга на части изнутри. А остальное довершило Заражение, лишив их даже имён. ",shape=box,color=red];
		j3069438698 -> j375397818;
	j1359920682 [label="Да, я думаю, он так и сделал. Мне кажется, он действительно заботится о этих существах.",shape=box,color=red];
		j1359920682 -> j1138423739;
	j3778037895 [label="К сожалению, это не имело значения: ущерб был нанесен.",shape=box,color=red];
		j3778037895 -> j3267677668;
	j703237995 [label="Нет, им двигало высокомерие. Даже если он утверждает, что это была случайность.",shape=box,color=red];
		j703237995 -> j2800366773;
	j2248171782 [label="Я пока не знаю всей правды, но он высокомерен, это я тебе точно скажу.",shape=box,color=red];
		j2248171782 -> j2800366773;
	j375397818 [label="Это высшая форма жестокости - быть лишённым имени...",shape=box,color=blue];
		j375397818 -> j482800561;
	j1138423739 [label="+10 Chemistry",color=orange];
		j1138423739 -> j2135920743;
	j3267677668 [label="+5 Chemistry",color=orange];
		j3267677668 -> j3108700749;
	j482800561 [label="Boolean MarieFamily2 is now true.",color=orange];
		j482800561 -> j3365275698;
		j482800561 -> j663813227;
		j482800561 -> j1647858636;
	j2135920743 [label="Интересно, что бы он подумал о Кавии… Жаль, что он не может встретиться с ними...",shape=box,color=blue];
		j2135920743 -> j1218230692;
		j2135920743 -> j748093190;
	j3108700749 [label="Если бы значение имела только чистота намерений, мир был бы прекрасным местом, non? C'est la vie.",shape=box,color=blue];
		j3108700749 -> j670811365;
	j3365275698 [label="Если только ты не отдашь это, как бабушка.",shape=box,color=red];
		j3365275698 -> j3821249339;
	j663813227 [label="Честно говоря, всё не так уж плохо, со временем привыкаешь.",shape=box,color=red];
		j663813227 -> j1504227404;
	j1647858636 [label="У животных нет имён, и они кажутся вполне счастливыми. Мы даём им имена просто для собственного удовольствия.",shape=box,color=red];
		j1647858636 -> j2455530810;
	j1218230692 [label="Я улыбаюсь при одной этой мысли. Но, думаю, это было бы неразумно.",shape=box,color=red];
		j1218230692 -> j3517583829;
	j748093190 [label="Я надеюсь, что это когда-нибудь произойдёт. Очень надеюсь.",shape=box,color=red];
		j748093190 -> j1526667533;
	j670811365 [label="Et ensuite?",shape=box,color=blue];
		j670811365 -> j4151154469;
	j3821249339 [label="+5 Chemistry",color=orange];
		j3821249339 -> j329384637;
	j1504227404 [label="А-а-ах! Quelle horreur! Я не хотела! Мне так жаль, прости меня, я не хотела… ох, я такая глупая!",shape=box,color=blue];
		j1504227404 -> j1440848277;
		j1504227404 -> j2430626749;
	j2455530810 [label="+5 Chemistry",color=orange];
		j2455530810 -> j839558744;
	j3517583829 [label="А почему бы и нет?",shape=box,color=blue];
		j3517583829 -> j1767362068;
		j3517583829 -> j3892423532;
	j1526667533 [label="Add 1 to Family counter",color=orange];
		j1526667533 -> j788680427;
	j329384637 [label="Теперь она звучит как та дама, с которой мне бы очень хотелось познакомиться… ",shape=box,color=blue];
		j329384637 -> j1716770728;
	j1440848277 [label="И как ты собираешься загладить свою вину?",shape=box,color=red];
		j1440848277 -> j2597774265;
	j2430626749 [label="Всё в порядке, просто шучу. Обиды нет.",shape=box,color=red];
		j2430626749 -> j1705960831;
	j839558744 [label="Совершенно верно! Я никогда так не думала. И тебе можно было бы выбрать своего собственного. Как это освобождает, в каком-то смысле.",shape=box,color=blue];
		j839558744 -> j1716770728;
	j1767362068 [label="Боюсь, одна половина будет воспринимать другую как «другую семью».",shape=box,color=red];
		j1767362068 -> j416484362;
	j3892423532 [label="Ситуация наверху… даже в лучшие дни довольно хрупкая. Не хочу их расстраивать.",shape=box,color=red];
		j3892423532 -> j2070772660;
	j788680427 [label="Check /Lotus/Scripts/1999/DialogueScriptNodes.lua:IsSyndicateRank",color=orange];
		j788680427 -> j4051651663 [label=true,color=green];
		j788680427 -> j3617211932 [label=false,color=brown];
	j1716770728 [label="Это был такой замечательный разговор, но боюсь, что пришло моё время подавать обед. Monsieur Лойд учит меня правильно подавать чай по его манере!",shape=box,color=blue];
		j1716770728 -> "Chat ends.";
	j2597774265 [label="Maintenant, vous parlez aussi mal que le diable. Нет, я не поведусь на твои уловки.",shape=box,color=blue];
		j2597774265 -> "Chat ends.";
	j1705960831 [label="+5 Chemistry",color=orange];
		j1705960831 -> j3275019193;
	j416484362 [label="Add 1 to Family counter",color=orange];
		j416484362 -> j2740196068;
	j2070772660 [label="Ты удивишься, насколько душа устойчива. А те, кто меня сейчас окружают, так стары, так закалены временем.",shape=box,color=blue];
		j2070772660 -> j3454648107;
	j4051651663 [label="Это возможно. Возможно, проще, чем ты думаешь. Нам просто нужно подумать, как именно. ",shape=box,color=blue];
		j4051651663 -> j1113094005;
		j4051651663 -> j3892423532;
	j3617211932 [label="Oui? И как продвигается твоя работа, или работа твоих крошечных копий, с семьёй наверху?",shape=box,color=blue];
		j3617211932 -> j2073748540;
		j3617211932 -> j3892423532;
	j3275019193 [label="О, loué soit Sol! Но возникает вопрос... Ты знаешь, откуда появилось прозвище? «Скиталец»?»",shape=box,color=blue];
		j3275019193 -> j1059678775;
		j3275019193 -> j2030549391;
	j2740196068 [label="+5 Chemistry",color=orange];
		j2740196068 -> j400820345;
	j3454648107 [label="+5 Chemistry",color=orange];
		j3454648107 -> j1916627568;
	j1113094005 [label="Нам просто нужно быть осторожными. Боюсь, одна половина будет воспринимать другую как «другую семью».",shape=box,color=red];
		j1113094005 -> j416484362;
	j2073748540 [label="Медленно. Осторожно. Боюсь, одна половина будет воспринимать другую как «другую семью».",shape=box,color=red];
		j2073748540 -> j416484362;
	j1059678775 [label="Надеюсь, выбор был сделан мною.",shape=box,color=red];
		j1059678775 -> j4205994241;
	j2030549391 [label="Честно говоря, я не помню.",shape=box,color=red];
		j2030549391 -> j2311755109;
	j400820345 [label="Ох... Par Sol, я думаю, ты, возможно, разгадал эту загадку!",shape=box,color=blue];
		j400820345 -> j4148565133;
	j1916627568 [label="Они уже много раз удивлялись. Позволь им удивить тебя хотя бы один раз.",shape=box,color=blue];
		j1916627568 -> j1772635777;
	j4205994241 [label="Какая это была бы свобода! Выбрать себе имя. В Кафедральном соборе я даже одежду себе не могла выбрать. Ха!",shape=box,color=blue];
		j4205994241 -> j1716770728;
	j2311755109 [label="Столько тайн ты приносишь с собой! ",shape=box,color=blue];
		j2311755109 -> j1716770728;
	j4148565133 [label="Boolean MarieFamilyOther is now true.",color=orange];
		j4148565133 -> j1405446576;
	j1772635777 [label="Но, пожалуйста, пожалуйста, s'il vous plaît, продолжай свой рассказ. Ваша маленькая волчица Мари должна знать свою добычу, прежде чем охотиться по-настоящему, не так ли?",shape=box,color=blue];
		j1772635777 -> j2621593181;
		j1772635777 -> j1709633017;
		j1772635777 -> j2039001586;
	j1405446576 [label="Я вне себя от волнения — je suis assise ici, remuant sur ma chaise!",shape=box,color=blue];
		j1405446576 -> j1772635777;
	j2621593181 [label="Где я был?",shape=box,color=red];
		j2621593181 -> j463410878;
	j1709633017 [label="Это было немного злонамеренно с твоей стороны, не так ли?",shape=box,color=red];
		j1709633017 -> j1327850714;
	j2039001586 [label="Мне хотелось бы чтобы ты за мной поохотилась...",shape=box,color=red];
		j2039001586 -> j3410547929;
	j463410878 [label="Сын подпустил Animaux Infestés слишком близко.",shape=box,color=blue];
		j463410878 -> j4151154469;
	j1327850714 [label="Peut-être! Но ведь нет вреда в капле озорства во имя добра, не так ли?",shape=box,color=blue];
		j1327850714 -> j2636679201;
		j1327850714 -> j2258825381;
	j3410547929 [label="Boolean DrifterMarie is now true.",color=orange];
		j3410547929 -> j3334956915;
	j2636679201 [label="Ладно... Ладно, вернемся к истории.",shape=box,color=red];
		j2636679201 -> j4151154469;
	j2258825381 [label="Не пойми неправильно. Мне понравилось.",shape=box,color=red];
		j2258825381 -> j649758446;
	j3334956915 [label="Ты доведёшь меня до погибели! Я едва не вскрикнула вслух, и Monsieur Лоид поинтересовался, всё ли со мной в порядке. Мне пришлось солгать, будто я увидела мышь, на что он невозмутимо ответил, что в эту эпоху мышей у нас нет!",shape=box,color=blue];
		j3334956915 -> j2616478708;
	j649758446 [label="Ха! Я так и думала. Ну всё, хватит твоих глупостей, возвращайся к своей истории. Сын подпустил Animaux Infestés слишком близко, да?",shape=box,color=blue];
		j649758446 -> j4151154469;
	j2616478708 [label="+5 Chemistry",color=orange];
		j2616478708 -> j2189726668;
	j2189726668 [label="Quelle méchanceté, tu es terrible ! Je te déteste et tu me fais rougir maintenant !",shape=box,color=blue];
		j2189726668 -> j4248985945;
		j2189726668 -> j2636679201;
	j4248985945 [label="Ты на меня злишься?",shape=box,color=red];
		j4248985945 -> j2704828936;
	j2704828936 [label="Non ! Просто продолжай свою историю!",shape=box,color=blue];
		j2704828936 -> j4151154469;
}