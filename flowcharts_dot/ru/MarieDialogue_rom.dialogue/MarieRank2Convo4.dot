digraph {
	599 [label="MarieRank2Convo4 begins.",color=orange];
		599 -> 602;
		599 -> 601;
		599 -> 600;
	602 [label="Позволь спросить тебя про Роута? Или это вызовет у тебя гневную тираду?",shape=box,color=red];
		602 -> 605;
	601 [label="Могу ли я спросить тебя о слоне в комнате?",shape=box,color=red];
		601 -> 604;
	600 [label="[Конец.]",shape=box,color=red];
		600 -> 603;
	605 [label="Ce diable est un imbécile qui se croit au-dessus de tout reproche! Je préfèrerais boire un pot de vernis à bois plutôt que de passer une minute de plus à l'écouter s'enorgueillir comme un chat qui se lèche le pelage!",shape=box,color=blue];
		605 -> 607;
		605 -> 608;
	604 [label="Quoi! Où ça? Un éléphant?!",shape=box,color=blue];
		604 -> 606;
	603 [label="Chat ends.",color=orange];
	607 [label="Это было удивительно познавательно.",shape=box,color=red];
		607 -> 610;
	608 [label="Я... полагаю, что ничего из сказанного не было по-доброму.",shape=box,color=red];
		608 -> 611;
	606 [label="Я вижу только рыбу, птицу и..... кем бы ни был M’sieur Тагфер. Я вижу много странного в этом Святилище, но ни одного éléphant. Ты шутишь?",shape=box,color=blue];
		606 -> 609;
	610 [label="+5 Chemistry",color=orange];
		610 -> 614;
	611 [label="+5 Chemistry",color=orange];
		611 -> 615;
	609 [label="Ох! Прости. Это просто выражение, которому меня научили друзья из 1999... ",shape=box,color=red];
		609 -> 612;
		609 -> 613;
	614 [label="Merci. Это было креативно, но ведь был задан мне вопрос, и мой гнев не должен был быть направлен на тебя, прости меня.",shape=box,color=blue];
		614 -> 618;
	615 [label="Это не так. Прости, мне не следовало это направлять на тебя. ",shape=box,color=blue];
		615 -> 618;
	612 [label="Боюсь, мною не имелось в виду это буквально.",shape=box,color=red];
		612 -> 616;
	613 [label="Теперь я понимаю, почему они всегда считают это таким милым, когда я в замешательстве...",shape=box,color=red];
		613 -> 617;
	618 [label="Evaluate expressions",color=orange];
		618 -> 624 [label="MarieRoatheWarning",color=purple];
		618 -> 623 [label="DrifterRoathe",color=purple];
		618 -> 622 [label="MarieRoatheSoldier",color=purple];
		618 -> 621 [label="false",color=purple];
	616 [label="+5 Chemistry",color=orange];
		616 -> 619;
	617 [label="+5 Chemistry",color=orange];
		617 -> 620;
	624 [label="Хотя я удивлена, что ты снова обращаешься ко мне за моими мыслями. В твоих предупреждениях прежде было достаточно ясности. Ты ведь не желаешь слышать, как я плохо говорю о нём и ему подобных.",shape=box,color=blue];
		624 -> 633;
		624 -> 634;
	623 [label="Я признаюсь, я не знаю, как мне продолжить этот разговор, если быть честной. Тебя, кажется, тянет к нему comme un papillon vers une flamme.",shape=box,color=blue];
		623 -> 631;
		623 -> 632;
	622 [label="Всё ещё ищешь в нём союзника? Ты играешь в опасную игру, присоединяя его к своей стае, волк. Он в любой момент способен перегрызть тебе глотку, когда ты меньше всего этого ожидаешь.",shape=box,color=blue];
		622 -> 629;
		622 -> 630;
	621 [label="Я удивлена твоему выбору собеседника. Понятно, что я плохо думаю об этом дьяволе.",shape=box,color=blue];
		621 -> 627;
		621 -> 628;
	619 [label="Я бы не удивилась, если бы и правда был! Похоже, у нас в этом месте собрана всякая прочая ménagerie.",shape=box,color=blue];
		619 -> 625;
	620 [label="Oui, это очаровательно, не так ли? Я часто говорю что-нибудь Monsieur Лойду, а он смотрит на меня так, будто я застала его врасплох.",shape=box,color=blue];
		620 -> 626;
	633 [label="Моя реакция была чересчур жёсткой, и я прошу прощения за это. Я пока не спешу судить его за его поступки - я просто пытаюсь понять его со всех сторон.",shape=box,color=red];
		633 -> 642;
	634 [label="Я не хочу. Он прожил жизнь, которая трудна для понимания. Но мне было интересно, если ты расскажешь, как вы познакомились.",shape=box,color=red];
		634 -> 643;
	631 [label="Я просто пытаюсь найти объяснение тому, почему он такой, какой есть. Я стараюсь понять его.",shape=box,color=red];
		631 -> 640;
	632 [label="Если я узнаю о нём больше, это, возможно, поможет мне направить его на немного... более мирный путь.",shape=box,color=red];
		632 -> 641;
	629 [label="Я знаю. Но я не могу ненавидеть его за то, что он сделал то, что должен был, чтобы служить своему народу. Мне приходилось поступать так же.",shape=box,color=red];
		629 -> 638;
	630 [label="Он один из самых опасных Орокин, каких только знала империя. Мы были бы глупцами, отвергнув такого рода помощь.",shape=box,color=red];
		630 -> 639;
	627 [label="Я знаю, но ведь у тебя должно быть понимание его натуры. Я пытаюсь лучше его понять.",shape=box,color=red];
		627 -> 636;
	628 [label="Which is why I'm asking you about him. I want to understand him, and I don't particularly trust how he tells his side of the story.",shape=box,color=red];
		628 -> 637;
	625 [label="Что означает эта фраза? Если в комнате есть слон, почему бы нам не поговорить об этом?",shape=box,color=blue];
		625 -> 635;
	626 [label="И для человека, который мог бы служить самой королеве, я горжусь этим.",shape=box,color=blue];
		626 -> 625;
	642 [label="Add 1 to Thermostat",color=orange];
		642 -> 651;
	643 [label="Add 1 to Thermostat",color=orange];
		643 -> 652;
	640 [label="Add -1 to Thermostat",color=orange];
		640 -> 649;
	641 [label="Add 1 to Thermostat",color=orange];
		641 -> 650;
	638 [label="Add 1 to Thermostat",color=orange];
		638 -> 647;
	639 [label="Add -1 to Thermostat",color=orange];
		639 -> 648;
	636 [label="Add -1 to Thermostat",color=orange];
		636 -> 645;
	637 [label="Add 1 to Thermostat",color=orange];
		637 -> 646;
	635 [label="Я не могу себе представить, чтобы для большинства людей, которые не живут среди летающих голов и говорящих животных, слон не был бы поводом для беседы.",shape=box,color=blue];
		635 -> 644;
	651 [label="+5 Chemistry",color=orange];
		651 -> 660;
	652 [label="И ты полагаешь, что я не смогу понять? Я не глупая - я не впадала в истерику из-за перемещения, которое я пережила, из-за преображений, которые со мной случились.",shape=box,color=blue];
		652 -> 661;
		652 -> 662;
	649 [label="Меня волнует, к чему это всё приведёт. Но ведь тебе не нужно, чтобы я читала тебе нотации, я не твоя мать и не хочу омрачать нашу дружбу в самом её начале...",shape=box,color=blue];
		649 -> 658;
	650 [label="+5 Chemistry",color=orange];
		650 -> 659;
	647 [label="+5 Chemistry",color=orange];
		647 -> 656;
	648 [label="Я просто призываю к осторожности. Я думаю, он мог бы обаять Луа так, что она подарила бы ему звёзды с неба.",shape=box,color=blue];
		648 -> 657;
	645 [label="Меня волнует, к чему это всё приведёт. Но ведь тебе не нужно, чтобы я читала тебе нотации.",shape=box,color=blue];
		645 -> 654;
	646 [label="+5 Chemistry",color=orange];
		646 -> 655;
	644 [label="... Я полагаю, я сама ответила на свой вопрос, разве нет?",shape=box,color=blue];
		644 -> 653;
	660 [label="Я ценю извинения и я принимаю их, но учти, что я была перенесена и преображена, и я оказалась в окружении l'impossible. ",shape=box,color=blue];
		660 -> 666;
	661 [label="Неважно. Я только пойду поговорю с самим дьяволом.",shape=box,color=red];
		661 -> 667;
	662 [label="Прости. У меня не было желания спорить с тобой, это совсем не то, что подразумевалось. ",shape=box,color=red];
		662 -> 668;
		662 -> 669;
	658 [label="Я просто тревожусь за тебя. Он искусен и умеет манипулировать, как настоящий хищник... ",shape=box,color=blue];
		658 -> 664;
	659 [label="И я причислила бы тебя к лику святых Сол хотя бы за одну попытку сделать такое.",shape=box,color=blue];
		659 -> 664;
	656 [label="Oui, проклятие солдата... Сжечь город, чтобы спасти страну. Убить человека, чтобы спасти семью. Но где же кончается этот ужас?",shape=box,color=blue];
		656 -> 665;
	657 [label="Помни, кем и чем он является в конце концов... не богом и даже не зверем, а человеком. Человеком, который слишком высокого мнения о себе.",shape=box,color=blue];
		657 -> 664;
	654 [label="Думаю, он мог бы очаровать Луа, чтобы получить звёзды с неба. Осторожность — прежде всего, вот и всё, что я скажу.",shape=box,color=blue];
		654 -> 664;
	655 [label="Тогда ты поступаешь мудро, не слушая его сладких речей. Я думаю, он мог бы обаять Луа так, что она подарила бы ему звёзды с неба.",shape=box,color=blue];
		655 -> 664;
	653 [label="Именно так. Это значит: «можем ли мы поговорить о теме, которую все обходят стороной, как будто в комнате нет гигантского слона, которого все притворяются не замечают».",shape=box,color=red];
		653 -> 663;
	666 [label="Когда ты считаешь, что я не могу понять или не могу испытывать сочувствия к историям других, прошу, подумай об этом ещё раз, oui?",shape=box,color=blue];
		666 -> 673;
	667 [label="Qu'il en soit ainsi.",shape=box,color=blue];
		667 -> 674;
	668 [label="Он солдат. Ему приходилось совершать ужасные вещи во имя «великой цели». Я знаю, каково это. Иногда такая жизнь превращает... вот. В кого-то вроде него.",shape=box,color=red];
		668 -> 675;
	669 [label="Он прожил уже сотни, если не тысячи лет. Кто знает, что на самом деле это делает с человеком? Сколько в нём боли, сколько страданий? Я знаю, каково это.",shape=box,color=red];
		669 -> 676;
	664 [label="Но ведь было же желания с твоей стороны спросить меня о самом дьяволе, не так ли? Что именно ты хочешь узнать?",shape=box,color=blue];
		664 -> 670;
		664 -> 671;
		664 -> 672;
	665 [label="Мы должны смотреть на войну глазами статистика, ведь если бы мы видели её глазами павших, мы бы никогда не перестали плакать.",shape=box,color=blue];
		665 -> 664;
	663 [label="И если мне позволено будет предположить ещё раз насчёт природы этого éléphant... у него, случаем, не синяя кожа?",shape=box,color=blue];
		663 -> 618;
	673 [label="А я, со своей стороны, ещё раз подумаю, стоит ли мне говорить тебе как правильно жить.",shape=box,color=blue];
		673 -> 661;
		673 -> 680;
	674 [label="Chat ends.",color=orange];
	675 [label="+5 Chemistry",color=orange];
		675 -> 681;
	676 [label="+5 Chemistry",color=orange];
		676 -> 682;
	670 [label="Почему он тебе так сильно не нравится?",shape=box,color=red];
		670 -> 677;
	671 [label="Почему Энтрати оставил его с тобой и Лионом?",shape=box,color=red];
		671 -> 678;
	672 [label="Мне любопытно, как вы встретились?",shape=box,color=red];
		672 -> 679;
	680 [label="Да, это так.",shape=box,color=red];
		680 -> 687;
	681 [label="Ах, теперь я чувствую себя полной дурой. Да, конечно, ты знаешь, каково это — убивать во имя «цели», как ты говоришь… Естественно, тебе хотелось бы понять того, кто сделал то же самое.",shape=box,color=blue];
		681 -> 688;
	682 [label="Ах, и теперь я чувствую себя дурой. Да, конечно, ты знаешь, каково это — жить снова и снова… Конечно, ты хочешь узнать кого-то, кто прошёл через то же самое.",shape=box,color=blue];
		682 -> 688;
	677 [label="Разве не очевидно? Его поведение напоминает поведение толстого кота, который постоянно метит свою территорию и сбрасывает вещи с полок.",shape=box,color=blue];
		677 -> 683;
		677 -> 684;
	678 [label="Когда Cardinal Dimanche — Энтрати — покинул нас в последний раз, он оставил в пороге дьявола. Сломленного, истекающего кровью и едва способного вспомнить даже собственное имя.",shape=box,color=blue];
		678 -> 685;
	679 [label="В ту ночь, когда к нам явился дьявол, была гроза. Страшный грохот сотрясал стены Cathédrale.",shape=box,color=blue];
		679 -> 686;
	687 [label="Update boolean MarieRoatheWarning",color=orange];
		687 -> 694;
	688 [label="Let us come to an accord. Когда ты считаешь, что я не могу понять или не могу испытывать сочувствия к историям других, прошу, подумай об этом ещё раз, oui?",shape=box,color=blue];
		688 -> 673;
	683 [label="Лично мне кошки нравятся.",shape=box,color=red];
		683 -> 689;
	684 [label="Ты не любишь кошек?",shape=box,color=red];
		684 -> 690;
	685 [label="Теперь я знаю, что ему только ввели sérum, и такая трансформация, если против воли, может быть... болезненной.",shape=box,color=blue];
		685 -> 691;
	686 [label="Check boolean MarieLyonVisions",color=orange];
		686 -> 693 [label=true,color=green];
		686 -> 692 [label=false,color=brown];
	694 [label="Magnifique! Так ведь было же желания с твоей стороны спросить меня о самом дьяволе, не так ли? Что именно ты хочешь узнать?",shape=box,color=blue];
		694 -> 670;
		694 -> 671;
		694 -> 672;
	689 [label="Кошки просто восхитительны, когда кошка — это кошка! А он — взрослый человек, за плечами которого многие годы целой жизни!",shape=box,color=blue];
		689 -> 695;
	690 [label="Я люблю, когда кошка — это кошка! А он — человек, за плечами которого многие годы целой жизни!",shape=box,color=blue];
		690 -> 695;
	691 [label="Le Cardinal посмотрел на дьявола сверху вниз и произнёс: «Уриэль, еретик Ксеты, находящийся в изгнании, ответь - смогут ли Орокин когда-нибудь быть прощены?»",shape=box,color=blue];
		691 -> 696;
	693 [label="На этот раз, если Лион расскажет тебе о буре, которая потрясла наш дом, он расскажет о реальности этого, о том, что мы пережили.",shape=box,color=blue];
		693 -> 692;
	692 [label="Я предполагаю, это было замечательное cliché, чтобы такое зло появилось в самом центре водоворота.",shape=box,color=blue];
		692 -> 678;
	695 [label="Гораздо больше лет, чем должно быть любому человеческому существу, посиневшему или иным образом преображённому до неузнаваемости, как бы того ни хотелось.",shape=box,color=blue];
		695 -> 697;
		695 -> 698;
		695 -> 3906;
	696 [label="И в раскате грома, словно сами боги призвали его к себе, le Cardinal просто исчез.",shape=box,color=blue];
		696 -> 699;
	697 [label="Генетическое изменение внешности было модным во времена Орокин. Но они были такими же людьми, как и мы. Или были ими, я полагаю.",shape=box,color=red];
		697 -> 700;
	698 [label="За исключением хвоста, он, по правде говоря, выглядит... более человечно, чем многие из Орокин в те времена.",shape=box,color=red];
		698 -> 701;
	3906 [label="Don't worry, I think you're much prettier than he is.",shape=box,color=red];
		3906 -> 3907;
	699 [label="И мы остались с... ним. Дьяволом.",shape=box,color=blue];
		699 -> 702;
	700 [label="Да, пожалуй, я уже и сама не знаю, кто я теперь. Отчасти Мари, отчасти... «Висп» отчасти... какое-то заражённое существо, которое теперь разделяет мои вены.",shape=box,color=blue];
		700 -> 703;
	701 [label="Да, я смотрел на старый портрет le Cardinal, когда он был больше похож на дьявола. Он рассказал мне об обычаях Орокин, о том, как они менялись.",shape=box,color=blue];
		701 -> 704;
	3907 [label="Check boolean DrifterMarie",color=orange];
		3907 -> 3908 [label=true,color=green];
		3907 -> 3909 [label=false,color=brown];
	702 [label="Le Cardinal оставил его нам, чтобы... возможно, мы могли разглядеть его душу? Или, по крайней мере, помнить о цепях, которые его связывают. Je préférerais le renvoyer en enfer.",shape=box,color=blue];
		702 -> 705;
		702 -> 706;
	703 [label="Разговор для другого раза, пожалуй.",shape=box,color=blue];
		703 -> 707;
	704 [label="Как похоже и всё же так же далеко от того, как дамы моего времени носили их вычурные парики, которые стремились ввысь к небу, а наряды были столь огромны, что в них без труда уместился бы целый приют!",shape=box,color=blue];
		704 -> 708;
	3908 [label="You must stop making me blush ! Monsieur Loid will wonder what I am doing sitting here !",shape=box,color=blue];
		3908 -> 3911;
	3909 [label="Update boolean DrifterMarie",color=orange];
		3909 -> 3910;
	705 [label="Как ты думаешь, все ли могут быть прощены в конце концов?",shape=box,color=red];
		705 -> 709;
	706 [label="Есть ли в нём хоть что-то, что тебе нравится? Хоть что-нибудь?",shape=box,color=red];
		706 -> 710;
	707 [label="Update boolean MarieInfestation",color=orange];
		707 -> 711;
	708 [label="Люди такие, какими они всегда будут - несчастными в своих собственных формах, данных им Солом. Они стремятся работать со своей плотью, как с глиной. Я полагаю, я не исключение.",shape=box,color=blue];
		708 -> 712;
	3911 [label="Besides, it is not so difficult to be prettier than the devil, non ? His features are handsome, but the blue... ce n'est pas pour moi.",shape=box,color=blue];
		3911 -> 3912;
	3910 [label="Ah ! You are making me blush ! What will Monsieur Loid think if he sees me sitting here, like so ?",shape=box,color=blue];
		3910 -> 3911;
	709 [label="Думаю ли я так? Oui. Да. Я верю в то, что любая душа способна заслужить прощение за свои проступки.",shape=box,color=blue];
		709 -> 713;
	710 [label="Ничего. Совсем ничего.",shape=box,color=blue];
		710 -> 714;
		710 -> 715;
	711 [label="Моя проблема с ним в том, что у него есть вся убийственная кошачья самоуверенность, но нет ни капли обаяния маленького, очаровательного компаньона.",shape=box,color=blue];
		711 -> 716;
	712 [label="Как бы я ни была счастлива принять решение, которое сделало меня отчасти Мари, отчасти… «Висп» и отчасти… какое-то заражённое существо, которое теперь разделяет мои вены.",shape=box,color=blue];
		712 -> 703;
	3912 [label="I do accept your compliment, if it was sincerely meant. I was simply startled. May we... return to the topic at hand ?",shape=box,color=blue];
		3912 -> 707;
	713 [label="Вопрос остаётся открытым... испытывает ли он вообще нужду в чём-либо подобном?",shape=box,color=blue];
		713 -> 717;
	714 [label="Что ж, я ценю твой рассказ. Значит, Энтрати хочет, чтобы его... простили? За что? Тау? Или просто за то, что он тоже был Орокин?",shape=box,color=red];
		714 -> 718;
	715 [label="Хорошо, я тебе верю. Не думаю, что тебе есть смысл мне лгать.",shape=box,color=red];
		715 -> 719;
	716 [label="Он слишком высокого мнения о себе. Он отнимает жизни без малейших колебаний. Он играет со своими врагами, словно те мышки, загнанные им в угол.",shape=box,color=blue];
		716 -> 702;
	717 [label="Прощение не может быть даровано тем, кто не считает себя в нём нуждающимся. Уж лучше попытаться научить рыбу летать.",shape=box,color=blue];
		717 -> 720;
	718 [label="Я не знаю. И другой вопрос остаётся открытым, испытывает ли он вообще нужду в чём-либо подобном, как прощение?",shape=box,color=blue];
		718 -> 717;
	719 [label="Fie! Очень хорошо. Есть одна вещь, которая нас роднит.... гнусное искушение сладостями. Дьявол часто возвращался в Cathédrale, украв пирожные из лавок и не заплатив за них как следует.",shape=box,color=blue];
		719 -> 721;
	720 [label="Но поговори с ним на эту тему сам, если ты желаешь понять с каким непреодолимым испытанием тебе предстоит столкнуться, если пытаешься выиграть именно эту войну.",shape=box,color=blue];
		720 -> 722;
	721 [label="Я бы объяснила ему, что это была кража, и он продолжил бы какую-нибудь длинную лекцию о том, что Орокин скоро будут править солнечной системой, то по большому счёту это вовсе не считается воровством...",shape=box,color=blue];
		721 -> 723;
	722 [label="Я лишь желаю тебе удачи.",shape=box,color=blue];
		722 -> 724;
	723 [label="Я бы накричала на него, и Лион был бы вынужден вмешаться...",shape=box,color=blue];
		723 -> 725;
		723 -> 726;
	724 [label="+10 Chemistry",color=orange];
		724 -> 727;
	725 [label="А выпечка?..",shape=box,color=red];
		725 -> 728;
	726 [label="Ты когда-нибудь задумывалась, не приносил ли он их, чтобы вы могли насладиться ими вместе?",shape=box,color=red];
		726 -> 729;
	727 [label="Chat ends.",color=orange];
	728 [label="Мы ведь не могли просто так дать им пропасть, правда? Было грехом их съесть, но ещё большим грехом - дать им сгнить. Так что мы насладились ими.",shape=box,color=blue];
		728 -> 730;
	729 [label="Если это правда, то он устроил ужасное представление. Но… возможно, правда твоя. Как бы то ни было, мы не могли позволить им пропасть даром. Грех было их есть, но ещё больший грех — позволить им сгнить. Так что мы их съели, и насладились.",shape=box,color=blue];
		729 -> 730;
	730 [label="+10 Chemistry",color=orange];
		730 -> 731;
	731 [label="Хм. Теперь, когда я думаю об этом, пожалуй, у него и правда была такая привычка, приносить больше, чем мог съесть сам...",shape=box,color=blue];
		731 -> 732;
	732 [label="Update boolean MarieRoathePastry1",color=orange];
		732 -> 733;
	733 [label="Я подумаю об этом. До завтра. À la revoyure.",shape=box,color=blue];
		733 -> 734;
	734 [label="Chat ends.",color=orange];
}