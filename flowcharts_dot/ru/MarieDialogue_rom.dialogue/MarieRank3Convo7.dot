digraph {
	graph [fontname="Roboto Condensed"];
	node [fontname="Roboto Condensed"];
	edge [fontname="Roboto Condensed"];

	"MarieRank3Convo7 begins." [color=orange];
		"MarieRank3Convo7 begins." -> j678565364;
	j678565364 [label="Boolean MarieLyonAvailable is now true.",color=orange];
		j678565364 -> j2177830014;
		j678565364 -> j2074805613;
		j678565364 -> j1310452999;
	j2177830014 [label="Как ты познакомилась с Лионом?",shape=box,color=red];
		j2177830014 -> j2948914527;
	j2074805613 [label="С Лионом... все в порядке?",shape=box,color=red];
		j2074805613 -> j2184589485;
	j1310452999 [label="[Конец.]",shape=box,color=red];
		j1310452999 -> "Chat ends.";
	j2948914527 [label="Мой дорогой Лион уже давно служил в Cathédrale, когда Mère Supérieure приютила меня, и я вступила в Собор Светил как сестра. (Я прямо кружусь от радости, что ты заговорил!)",shape=box,color=blue];
		j2948914527 -> j756810819;
		j2948914527 -> j3850037453;
	j2184589485 [label="Прежде чем мы продолжим, я попрошу тебя объяснить, что ты имеешь в виду. И прошу сделать это мягко, с осторожным напоминанием о том, что он - брат моей души.",shape=box,color=blue];
		j2184589485 -> j661700065;
		j2184589485 -> j794826274;
	"Chat ends." [color=orange];
	j756810819 [label="Ты... нуждалась в крове?",shape=box,color=red];
		j756810819 -> j4065256536;
	j3850037453 [label="Могу я задать нескромный вопрос?",shape=box,color=red];
		j3850037453 -> j3173127446;
	j661700065 [label="Если этот разговор тебе неприятен, мы можем перейти к чему‑нибудь другому.",shape=box,color=red];
		j661700065 -> j1064416311;
	j794826274 [label="Я совсем не хочу тебя расстраивать. Я просто переживаю за него. Снаружи он кажется спокойным и сдержанным, но у меня ощущение, что ему больно, вот и всё.",shape=box,color=red];
		j794826274 -> j2182952387;
	j4065256536 [label="Потому что меня туда изгнала ma famille много лет назад, когда я была маленькой девочкой. Я много лет прожила как нищенка, выживая как могла.",shape=box,color=blue];
		j4065256536 -> j3989395646;
	j3173127446 [label="+5 Chemistry",color=orange];
		j3173127446 -> j2247527970;
	j1064416311 [label="Нет, нет. Всё в порядке. Я просто привыкла к любопытным зевакам, которые подкрадываются и стучат по прутьям клетки, будто он какой-то monstre de cirque.",shape=box,color=blue];
		j1064416311 -> j422604905;
		j1064416311 -> j3585085753;
		j1064416311 -> j1682142960;
	j2182952387 [label="+5 Chemistry",color=orange];
		j2182952387 -> j3169662144;
	j3989395646 [label="Boolean MarieBeggar1 is now true.",color=orange];
		j3989395646 -> j2150911951;
	j2247527970 [label="Судя по всему, тебя называют волком, а со мной ты ведёшь себя так воспитанно! Это так мило видеть. Думаю, я знаю, что ты хочешь спросить. Почему я оказалась на улице?",shape=box,color=blue];
		j2247527970 -> j4065256536;
	j422604905 [label="Как вы двое познакомились?",shape=box,color=red];
		j422604905 -> j3426378719;
	j3585085753 [label="Мне привычно было быть чем-то вроде «местной достопримечательности», я понимаю, как ты можешь защищаться.",shape=box,color=red];
		j3585085753 -> j3901436021;
	j1682142960 [label="Всё в порядке. Я просто волнуюсь за него.",shape=box,color=red];
		j1682142960 -> j3046101778;
	j3169662144 [label="Я... прошу прощения за свою резкость. Я просто привыкла к любопытным зевакам, которые подкрадываются и стучат по прутьям клетки, будто он какой-то monstre de cirque.",shape=box,color=blue];
		j3169662144 -> j3585085753;
		j3169662144 -> j1682142960;
	j2150911951 [label="Можешь себе представить, что dans la Cité de la Lumière не было ни работы, ни мест, куда могла бы податься такая, как я, без рабочих ног.",shape=box,color=blue];
		j2150911951 -> j3442699588;
	j3426378719 [label="Мой дорогой Лион уже давно служил в Cathédrale, когда Mère Supérieure приютила меня, и я вступила в Собор Светил как сестра.",shape=box,color=blue];
		j3426378719 -> j356118740;
		j3426378719 -> j3548251846;
	j3901436021 [label="Oui, я полагаю, ты и вправду такое создание, что умеет петлять во времени и вызывать целые миры из самой ткани бытия! Немного волшебник, не так ли?",shape=box,color=blue];
		j3901436021 -> j2241552384;
		j3901436021 -> j4281973882;
	j3046101778 [label="+5 Chemistry",color=orange];
		j3046101778 -> j452443779;
	j3442699588 [label="Видимо, поэтому мы с Лионом так быстро стали словно родня. Он ни разу не посмотрел на меня с жалостью. Да и я на него тоже.",shape=box,color=blue];
		j3442699588 -> j3565971189;
	j356118740 [label="Ты... нуждалась в крове?",shape=box,color=red];
		j356118740 -> j4240976258;
	j3548251846 [label="Могу я задать нескромный вопрос?",shape=box,color=red];
		j3548251846 -> j2412634970;
	j2241552384 [label="Это довольно аккуратно описывает ситуацию.",shape=box,color=red];
		j2241552384 -> j3957620818;
	j4281973882 [label="Честно говоря, мне хотелось бы, чтобы люди видели во мне нечто большее, чем это.",shape=box,color=red];
		j4281973882 -> j3267421391;
	j452443779 [label="И я обожаю тебя за это. Он силён и может выдержать всё, что ему выпало. Но ведь любое бремя становится легче, когда несёшь его не один.",shape=box,color=blue];
		j452443779 -> j1571387689;
		j452443779 -> j2302210495;
	j3565971189 [label="В то время как другие так спешат с любопытством постучать по прутьям клетки, словно он какой-то monstre de cirque.",shape=box,color=blue];
		j3565971189 -> j2903278122;
	j4240976258 [label="Потому что меня туда изгнала ma famille много лет назад, когда я была маленькой девочкой. Я много лет прожила как нищенка, выживая как могла.",shape=box,color=blue];
		j4240976258 -> j629066377;
	j2412634970 [label="+5 Chemistry",color=orange];
		j2412634970 -> j99998499;
	j3957620818 [label="+10 Chemistry",color=orange];
		j3957620818 -> j2496412066;
	j3267421391 [label="+15 Chemistry",color=orange];
		j3267421391 -> j1145430256;
	j1571387689 [label="Я чувствую, будто он не хочет со мной разговаривать.",shape=box,color=red];
		j1571387689 -> j459080847;
	j2302210495 [label="Я хочу ему помочь, если я смогу. Можешь что-нибудь посоветовать?",shape=box,color=red];
		j2302210495 -> j459080847;
	j2903278122 [label="Надеюсь, ты не этим занимаешься здесь.",shape=box,color=blue];
		j2903278122 -> j2779898776;
		j2903278122 -> j2200514637;
	j629066377 [label="Boolean MarieBeggar1 is now true.",color=orange];
		j629066377 -> j2356568265;
	j99998499 [label="Судя по всему, тебя называют волком, а со мной ты ведёшь себя так воспитанно! Это так мило видеть. Думаю, я знаю, что ты хочешь спросить. Почему я оказалась на улице?",shape=box,color=blue];
		j99998499 -> j4240976258;
	j2496412066 [label="Когда-нибудь о тебе напишут книгу, я думаю. Как очаровательно звучит эта мысль! Возможно, я сама её напишу. Хотя бы на Gallique! Imaginez cela!",shape=box,color=blue];
		j2496412066 -> j761052766;
	j1145430256 [label="Значит, ты и вправду понимаешь. Я больше, чем сестра Мари, бедная девушка без ног, которой дарована сила летать. А Лион больше, чем трагичный священник, несущий своё бремя в молчании.",shape=box,color=blue];
		j1145430256 -> j643375473;
	j459080847 [label="+10 Chemistry",color=orange];
		j459080847 -> j1215661218;
	j2779898776 [label="Мне привычно было быть чем-то вроде «местной достопримечательности», я знаю, что вы оба чувствуете. Нет, дело не в этом. ",shape=box,color=red];
		j2779898776 -> j1622800141;
	j2200514637 [label="Нет, мне просто было любопытно. И, честно говоря, у меня было беспокойство о нём. Я думаю, он прячет большую часть своей боли.",shape=box,color=red];
		j2200514637 -> j467059352;
	j2356568265 [label="Можешь себе представить, что dans la Cité de la Lumière не было ни работы, ни мест, куда могла бы податься такая, как я, без рабочих ног.",shape=box,color=blue];
		j2356568265 -> j1527894560;
	j761052766 [label="Или, пожалуй, не воображай себе ничего подобного. Это может стать реальностью. Ха! И на этой замечательной ноте, боюсь, мне придётся с тобой adieu. Шёпот никогда не смолкает!",shape=box,color=blue];
		j761052766 -> "Chat ends.";
	j643375473 [label="Помни об этом, и, полагаю, мы будем хорошими друзьями. И на этой замечательной ноте, боюсь, мне придётся с тобой adieu. Шёпот никогда не cease!",shape=box,color=blue];
		j643375473 -> "Chat ends.";
	j1215661218 [label="Проявляй терпение. Он… не сразу идёт на контакт. Но он придёт к тебе, когда настанет время. Если твои намерения чисты, он это узнает. Но теперь, боюсь, мне пора сказать тебе adieu.",shape=box,color=blue];
		j1215661218 -> "Chat ends.";
	j1622800141 [label="Oui, я полагаю, ты и вправду такое создание, что умеет петлять во времени и вызывать целые миры из самой ткани бытия! Немного волшебник, не так ли?",shape=box,color=blue];
		j1622800141 -> j2158621396;
		j1622800141 -> j4281973882;
	j467059352 [label="+15 Chemistry",color=orange];
		j467059352 -> j3194795989;
	j1527894560 [label="Видимо, поэтому мы с Лионом так быстро стали словно родня. Он ни разу не посмотрел на меня с жалостью. Да и я на него тоже.",shape=box,color=blue];
		j1527894560 -> j3274528547;
		j1527894560 -> j2451189261;
	j2158621396 [label="Это довольно точно подытоживает всё.",shape=box,color=red];
		j2158621396 -> j3957620818;
	j3194795989 [label="Твоя правда, он действительно так делает. Но он считает необходимым это делать, чтобы защитить других вокруг него. Когда он почувствует, что тебе больше не нужна эта защита, он расскажет, что его тревожит. Прояви терпение. Со временем он сам заговорит с тобой.",shape=box,color=blue];
		j3194795989 -> j44487853;
	j3274528547 [label="Надеюсь, вскоре он почувствует себя достаточно спокойно, чтобы поговорить со мной.",shape=box,color=red];
		j3274528547 -> j4125789335;
	j2451189261 [label="Мне приятно осознавать, что вы нашли друг друга. В каждом из нас скрыто большее, чем кажется на первый взгляд.",shape=box,color=red];
		j2451189261 -> j1919595750;
	j44487853 [label="Пфф. Боюсь, мне придётся с тобой adieu. Шёпот никогда не смолкает!",shape=box,color=blue];
		j44487853 -> "Chat ends.";
	j4125789335 [label="+10 Chemistry",color=orange];
		j4125789335 -> j2019840298;
	j1919595750 [label="+15 Chemistry",color=orange];
		j1919595750 -> j3146701814;
	j2019840298 [label="Будь терпелив. Он… не сразу идёт на контакт. Но он придёт к тебе, когда настанет время. Если твои намерения чисты, он это узнает. Но теперь, боюсь, мне пора сказать тебе adieu.",shape=box,color=blue];
		j2019840298 -> "Chat ends.";
	j3146701814 [label="Значит, ты и вправду понимаешь. Я больше, чем сестра Мари, бедная девушка без ног, которой дарована сила летать. А Лион больше, чем трагичный священник, несущий своё бремя в молчании.",shape=box,color=blue];
		j3146701814 -> j2640334756;
	j2640334756 [label="Помни об этом, и, полагаю, мы будем хорошими друзьями. И на этой замечательной ноте, боюсь, мне придётся с тобой adieu. Шёпот никогда не смолкает!",shape=box,color=blue];
		j2640334756 -> "Chat ends.";
}