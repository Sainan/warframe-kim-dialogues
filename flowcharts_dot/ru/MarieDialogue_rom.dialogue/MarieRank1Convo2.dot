digraph {
	57 [label="MarieRank1Convo2 begins.",color=orange];
		57 -> 59;
		57 -> 58;
	59 [label="Мари? Я чем-то обидел Лиона?",shape=box,color=red];
		59 -> 61;
	58 [label="[Конец.]",shape=box,color=red];
		58 -> 60;
	61 [label="Хм? Pourquoi? О... потому что он ещё не говорит с тобой через это устройство?",shape=box,color=blue];
		61 -> 62;
		61 -> 63;
		61 -> 64;
	60 [label="Chat ends.",color=orange];
	62 [label="Он не знает, как печатать?",shape=box,color=red];
		62 -> 65;
	63 [label="Он технофоб?",shape=box,color=red];
		63 -> 66;
	64 [label="Понятно. Подумалось, раз и ты, и Роут здесь...",shape=box,color=red];
		64 -> 67;
	65 [label="Ха! Он один из самых быстрых учеников, которых я когда-либо встречала, Скиталец! Я бы не советовала тебе бросать ему вызов в головоломках, если в них замешаны деньги.",shape=box,color=blue];
		65 -> 67;
	66 [label="Нет, с новым он ладит отлично. Не удивлюсь, если он уже изучил тех самых ходящих машин, что топчут логова внизу, и вскоре обзаведётся собственными чертежами.",shape=box,color=blue];
		66 -> 67;
	67 [label="Дело лишь в том, что он тебя не знает. Лион не слишком... разговорчив, даже когда в хорошем настроении. Он вовсе не желал тебя задеть.",shape=box,color=blue];
		67 -> 68;
		67 -> 69;
	68 [label="Можно ли хоть как-то помочь?",shape=box,color=red];
		68 -> 70;
	69 [label="Хорошо, что это не я...",shape=box,color=red];
		69 -> 71;
	70 [label="У Лиона... в голове слишком много шума. Он осторожно выбирает, с кем разделить этот шум.",shape=box,color=blue];
		70 -> 72;
	71 [label="+5 Chemistry",color=orange];
		71 -> 73;
	72 [label="+15 Chemistry",color=orange];
		72 -> 74;
	73 [label="Нет, нет, нет, дело не в тебе. У Лиона... слишком много шума в голове. Он осторожно выбирает, с кем разделить этот шум.",shape=box,color=blue];
		73 -> 72;
	74 [label="Понадобится время. И терпение.",shape=box,color=blue];
		74 -> 75;
	75 [label="Ах! Мне нужно идти. Мы скоро поговорим.",shape=box,color=blue];
		75 -> 76;
	76 [label="Chat ends.",color=orange];
}