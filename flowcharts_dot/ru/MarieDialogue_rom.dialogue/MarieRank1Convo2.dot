	"Chat ends." [color=orange];
	j259830419 [label="Он не знает, как печатать?",shape=box,color=red];
		j259830419 -> j1341076022;
	j1970307391 [label="Он технофоб?",shape=box,color=red];
		j1970307391 -> j1337794291;
	j2830994406 [label="Понятно. Подумалось, раз и ты, и Роут здесь...",shape=box,color=red];
		j2830994406 -> j314445264;
	j1341076022 [label="Ха! Он один из самых быстрых учеников, которых я когда-либо встречала, Скиталец! Я бы не советовала тебе бросать ему вызов в головоломках, если в них замешаны деньги.",shape=box,color=blue];
		j1341076022 -> j314445264;
	j1337794291 [label="Нет, с новым он ладит отлично. Не удивлюсь, если он уже изучил тех самых ходящих машин, что топчут логова внизу, и вскоре обзаведётся собственными чертежами.",shape=box,color=blue];
		j1337794291 -> j314445264;
	j314445264 [label="Дело лишь в том, что он тебя не знает. Лион не слишком... разговорчив, даже когда в хорошем настроении. Он вовсе не желал тебя задеть.",shape=box,color=blue];
		j314445264 -> j858329648;
		j314445264 -> j1442388330;
	j858329648 [label="Можно ли хоть как-то помочь?",shape=box,color=red];
		j858329648 -> j675536675;
	j1442388330 [label="Хорошо, что это не я...",shape=box,color=red];
		j1442388330 -> j2822190205;
	j675536675 [label="У Лиона... в голове слишком много шума. Он осторожно выбирает, с кем разделить этот шум.",shape=box,color=blue];
		j675536675 -> j2994816000;
	j2822190205 [label="+5 Chemistry",color=orange];
		j2822190205 -> j1387305338;
	j2994816000 [label="+15 Chemistry",color=orange];
		j2994816000 -> j2944797030;
	j1387305338 [label="Нет, нет, нет, дело не в тебе. У Лиона... слишком много шума в голове. Он осторожно выбирает, с кем разделить этот шум.",shape=box,color=blue];
		j1387305338 -> j2994816000;
	j2944797030 [label="Понадобится время. И терпение.",shape=box,color=blue];
		j2944797030 -> j1809497105;
	j1809497105 [label="Ах! Мне нужно идти. Мы скоро поговорим.",shape=box,color=blue];
		j1809497105 -> "Chat ends.";
}