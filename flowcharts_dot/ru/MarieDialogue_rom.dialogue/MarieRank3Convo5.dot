		1380 -> 1387;
	1381 [label="+20 Chemistry",color=orange];
		1381 -> 1388;
	1382 [label="Только не подпускай к ним дьявола. Sinon, il va les voler! Он ведь любит воровать сладости, если ему не достаётся вдоволь!",shape=box,color=blue];
		1382 -> 1389;
	1390 [label="Они всё ещё восстанавливаются. Их путь ещё не окончен.",shape=box,color=red];
		1390 -> 1398;
	1391 [label="Мне бы хотелось сделать для них больше. ",shape=box,color=red];
		1391 -> 1398;
	1392 [label="Да, верно. Многие ищут веру в надежде, что она даст им именно это - цель. Направление.",shape=box,color=blue];
		1392 -> 1399;
	1393 [label="(А, вот как это пишется, merci!) Что даже народ, которому внушали, что это их единственная цель, может найти другую.",shape=box,color=blue];
		1393 -> 1400;
	1386 [label="Вот это дух! Даже дьяволу время от времени не помешает кусочек пирожного, я полагаю.",shape=box,color=blue];
		1386 -> 1394;
	1387 [label="Je vous en prie. Надеюсь, я хоть немного подняла тебе настроение. Ты ведь точно поднял мне его.",shape=box,color=blue];
		1387 -> 1402;
	1388 [label="Ах, я жалуюсь, но даже самый последний дьявол время от времени заслуживает немного пирожного, да?",shape=box,color=blue];
