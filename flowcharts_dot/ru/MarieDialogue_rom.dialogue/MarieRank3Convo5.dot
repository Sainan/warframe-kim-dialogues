	j4003794622 [label="Boolean MarieGrineer is now true.",color=orange];
		j4003794622 -> j480731786;
	j643735970 [label="Ну что ж! Обед подан, и теперь я голодна. Надеюсь, я хоть немного подняла тебе настроение. Ты ведь точно поднял мне его.",shape=box,color=blue];
