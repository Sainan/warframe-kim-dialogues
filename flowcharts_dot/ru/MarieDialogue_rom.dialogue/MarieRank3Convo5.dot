	1409 [label="Думаю, когда ты находишь ответ на этот вопрос, ты обретаешь своё собственное спокойствие.",shape=box,color=blue];
		1409 -> 1412;
	1407 [label="Да! Представь себе Лиона и меня, когда дьявол войдет в комнату в маске и пальто, с карманами, набитыми крадеными сладостями!",shape=box,color=blue];
		1407 -> 1410;
	1411 [label="Чтобы насладиться видами, конечно.",shape=box,color=blue];
		1411 -> 1412;
	1412 [label="Ах! Обед подан. Мне пора идти.",shape=box,color=blue];
		1412 -> 1415;
	1410 [label="Он говорил нам, что раз Орокин скоро будут править всей системой, это вовсе не кража! Et puis on se crie dessus et Лион умолял о тишине.",shape=box,color=blue];
		1410 -> 1413;
		1410 -> 1414;
	1415 [label="Chat ends.",color=orange];
	1413 [label="А Роут принес достаточно, чтобы поделиться?",shape=box,color=red];
		1413 -> 1416;
	1414 [label="И выпечку?",shape=box,color=red];
		1414 -> 1417;
	1416 [label="Да, достаточно. Но я не знаю, было ли это намеренным решением или же угрозой насилия со стороны Лиона.",shape=box,color=blue];
		1416 -> 1394;
	1417 [label="Мы не могли позволить ей пропасть зря, n'est-ce pas?",shape=box,color=blue];
		1417 -> 1394;
}