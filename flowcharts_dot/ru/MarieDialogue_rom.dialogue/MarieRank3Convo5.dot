		j420323306 -> j2747377268;
	j1424290028 [label="И, думаю, ты уже делаешь всё, что можешь. Они придут к тебе, когда ты им понадобишься.",shape=box,color=blue];
		j1424290028 -> j480731786;
	j480731786 [label="Так многие выбирают путь в надежде, что он приведёт их к ответам.",shape=box,color=blue];
