	j1127025487 [label="Ах! Обед подан. Мне пора идти.",shape=box,color=blue];
		j1127025487 -> "Chat ends.";
	j1283361828 [label="Он говорил нам, что раз Орокин скоро будут править всей системой, это вовсе не кража! Et puis on se crie dessus et Лион умолял о тишине.",shape=box,color=blue];
