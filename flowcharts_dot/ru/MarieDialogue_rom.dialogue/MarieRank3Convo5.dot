		j1402799028 -> j1939437020 [label=true,color=green];
		j1402799028 -> j3893366084 [label=false,color=brown];
	j1939437020 [label="Ma famille à Sol ! Моя родня в Сол как мы в этот день ?",shape=box,color=blue];
		j1939437020 -> j405088617;
		j1939437020 -> j953194529;
		j1939437020 -> j362333639;
		j1939437020 -> j3665388371;
		j1939437020 -> j1310452999;
	j3893366084 [label="Bonjour! Как у нас дела в этот день?",shape=box,color=blue];
		j3893366084 -> j405088617;
		j3893366084 -> j362333639;
		j3893366084 -> j3665388371;
		j3893366084 -> j1310452999;
		j3893366084 -> j953194529;
	j405088617 [label="У меня все хорошо, как у тебя?",shape=box,color=red];
		j405088617 -> j700974073;
	j953194529 [label="Бывает и лучше, но спасибо за вопрос. Как у тебя дела?",shape=box,color=red];
		j953194529 -> j3889822389;
	j362333639 [label="Признаюсь, мне пришлось соврать, я... на самом деле не последователь Сола.",shape=box,color=red];
		j362333639 -> j690372440;
	j3665388371 [label="Теперь, когда я говорю с тобой, мне лучше. Но ты делаешь все мои дни ярче своим присутствием.",shape=box,color=red];
		j3665388371 -> j2318020235;
	j1310452999 [label="[Конец.]",shape=box,color=red];
		j1310452999 -> "Chat ends.";
	j700974073 [label="Думаю, у меня всё хорошо. Хотя, если задуматься, я чувствую себя не так, как следовало бы.",shape=box,color=blue];
		j700974073 -> j3319849541;
		j700974073 -> j3586732285;
	j3889822389 [label="Со мной всё в порядке, но теперь ты меня интригуешь. Qu’y a-t-il?",shape=box,color=blue];
		j3889822389 -> j779743364;
		j3889822389 -> j3017375610;
		j3889822389 -> j3742340999;
		j3889822389 -> j3400308943;
	j690372440 [label="О! Я... понимаю. Pourquoi?",shape=box,color=blue];
		j690372440 -> j1757907655;
		j690372440 -> j761575222;
		j690372440 -> j3798433776;
	j2318020235 [label="Волк! Я из-за тебя со стула упаду !",shape=box,color=blue];
		j2318020235 -> j4058036914;
		j2318020235 -> j3881972223;
	"Chat ends." [color=orange];
	j3319849541 [label="Что ты имеешь в виду?",shape=box,color=red];
		j3319849541 -> j2741969015;
	j3586732285 [label="Однажды мне пришлось быть на твоём месте.",shape=box,color=red];
		j3586732285 -> j1210869522;
	j779743364 [label="Это... просто... трудно объяснить.",shape=box,color=red];
		j779743364 -> j1894922775;
	j3017375610 [label="Слишком много забот, слишком мало времени.",shape=box,color=red];
		j3017375610 -> j2688480557;
	j3742340999 [label="Мой друг однажды назвал это «пауками». Они время от времени появляются.",shape=box,color=red];
		j3742340999 -> j2852571337;
	j3400308943 [label="Иногда всё... просто выводит меня из себя. Но со мной всё будет в порядке.",shape=box,color=red];
		j3400308943 -> j357655985;
	j1757907655 [label="Мне показалось, что это будет возможность узнать тебя поближе...",shape=box,color=red];
		j1757907655 -> j1400906848;
	j761575222 [label="Показалось, что это будет забавно?",shape=box,color=red];
		j761575222 -> j2362158306;
	j3798433776 [label="Честно, не знаю. Просто так, спонтанно вышло.",shape=box,color=red];
		j3798433776 -> j3761144824;
	j4058036914 [label="Я имею это в виду. Извини, если я тебя смущаю.",shape=box,color=red];
		j4058036914 -> j1180282791;
	j3881972223 [label="Извини. Я шучу.",shape=box,color=red];
		j3881972223 -> j1180282791;
	j2741969015 [label="Я une Sœur de Sol. Мне не суждено… сражаться. Убивать. Шёпот не жив, или, по крайней мере, так говорят мне кавии, но что насчёт остальных, с кем мне приходится сталкиваться?",shape=box,color=blue];
		j2741969015 -> j1052507791;
	j1210869522 [label="+5 Chemistry",color=orange];
		j1210869522 -> j3044817766;
	j1894922775 [label="Тогда не буду любопытствовать. Знаю, иногда трудно выразить словами.",shape=box,color=blue];
		j1894922775 -> j3293792709;
	j2688480557 [label="В Соборе была одна Сестра, похожая на эту. Она всё время суетилась и суетилась. Однажды я застала её полирующей серебро в три часа ночи.",shape=box,color=blue];
		j2688480557 -> j1265678562;
	j2852571337 [label="Ах, oui. Кажется, я понимаю, о чём ты говоришь. Как бы... облако, которое движется по солнцу.",shape=box,color=blue];
		j2852571337 -> j2282430008;
	j357655985 [label="Как чашка, которую наполняют водой по капле, non?",shape=box,color=blue];
		j357655985 -> j1158370929;
	j1400906848 [label="Тебе не нужно было говорить мне такую ложь, чтобы узнать меня.",shape=box,color=blue];
		j1400906848 -> j3335722132;
	j2362158306 [label="Je ne comprends pas votre humour. Возможно, в будущем слово «забавно» будет означать что-то другое?",shape=box,color=blue];
		j2362158306 -> j42114329;
	j3761144824 [label="Я не знаю, какой инстинкт заставил тебя сказать мне такую ложь. ",shape=box,color=blue];
		j3761144824 -> j189071249;
	j1180282791 [label="Bon, où en étais-je ?",shape=box,color=blue];
		j1180282791 -> j4244769428;
	j1052507791 [label="Сражаться во имя Сол... это ли мой путь? Должна ли я стать убийцей во имя Сол? Moi, petite Marie?",shape=box,color=blue];
		j1052507791 -> j2325083979;
		j1052507791 -> j2945137999;
	j3044817766 [label="Знаю, ты используешь une métaphore, но я смеюсь не могу сдержаться! Не думаю, что ты смог бы оказаться на моём месте, даже если бы попытался!",shape=box,color=blue];
		j3044817766 -> j204196565;
	j3293792709 [label="Есть столько способов, как наши дни и мысли могут пойти наперекосяк. Они могут находить тёмные норы, в которых мы застреваем, не так ли?",shape=box,color=blue];
		j3293792709 -> j1592714337;
	j1265678562 [label="Я спросила её, зачем она это делает, а она ответила, что не может спать, слишком сильно волнуется.",shape=box,color=blue];
		j1265678562 -> j711478551;
	j2282430008 [label="У нас есть слово для этого, ennui. Усталость и недовольство, из-за которых всё кажется… бессмысленным.",shape=box,color=blue];
		j2282430008 -> j538566395;
	j1158370929 [label="Она наполнится и прольётся. Возможно, даже опрокинет своё содержимое. И тогда всё это покажется настоящей катастрофой. ",shape=box,color=blue];
		j1158370929 -> j2696579173;
	j3335722132 [label="Душа — это не только вера, которую она носит. Я — une Sœur de Sol, но я надеюсь, ты видишь во мне нечто большее, не так ли?",shape=box,color=blue];
		j3335722132 -> j3064013146;
	j42114329 [label="Не для меня.",shape=box,color=blue];
		j42114329 -> j1097657522;
	j189071249 [label="Остаётся только надеяться, что это было безобидно, а не жестокой шуткой надо мной. Поэтому я предпочту последовать примеру Сола -",shape=box,color=blue];
		j189071249 -> j757589517;
	j4244769428 [label="Check boolean DrifterFaithSol",color=orange];
		j4244769428 -> j2017890960 [label=true,color=green];
		j4244769428 -> j1543293861 [label=false,color=brown];
	j2325083979 [label="Меня не готовили быть солдатом. Не то что мальчишку. И тебя тоже.",shape=box,color=red];
		j2325083979 -> j2694684856;
	j2945137999 [label="Я не всегда был таким. Я всегда был бойцом. Мне пришлось учиться на горьком опыте.",shape=box,color=red];
		j2945137999 -> j1701990369;
	j204196565 [label="От этого образа в моей голове меня бросает в дрожь. Прежде чем я перестану дышать, скажи мне о чём ты говоришь?",shape=box,color=blue];
		j204196565 -> j2325083979;
		j204196565 -> j2945137999;
	j1592714337 [label="Мы можем лишь стараться быть добрыми и терпеливыми к самим себе, когда это случается.",shape=box,color=blue];
		j1592714337 -> j2093463038;
	j711478551 [label="Каждый раз, когда я находила её в таком состоянии, я спрашивала, стоит ли мне составить ей компанию. Иногда она соглашалась, иногда нет.",shape=box,color=blue];
		j711478551 -> j3293792709;
	j538566395 [label="Или, может быть, у тебя есть желание спрятаться, заплакать, это больше похоже на отчаяние, я не могу сказать.",shape=box,color=blue];
		j538566395 -> j470535849;
	j2696579173 [label="Ты убираешь беспорядок, ставишь чашку на место… и всё начинается снова, oui?",shape=box,color=blue];
		j2696579173 -> j1642316071;
	j3064013146 [label="Тем для выбора столько же, сколько звезд на небе!",shape=box,color=blue];
		j3064013146 -> j30900819;
		j3064013146 -> j168274654;
	j1097657522 [label="Boolean DrifterFaithSol is now false.",color=orange];
		j1097657522 -> j1508231473;
	j757589517 [label="- чью веру я исповедую, веришь ты в неё или нет, и прощаю тебя. Будь ты как Лион, я бы сказала, что десять ударов плетью, твоя расплата.",shape=box,color=blue];
		j757589517 -> j3864516817;
	j2017890960 [label="Ma famille à Sol ! My family in Sol, how are we this day ?",shape=box,color=blue];
		j2017890960 -> j405088617;
		j2017890960 -> j953194529;
		j2017890960 -> j362333639;
		j2017890960 -> j1310452999;
	j1543293861 [label="Bonjour ! How are we this day?",shape=box,color=blue];
		j1543293861 -> j405088617;
		j1543293861 -> j953194529;
		j1543293861 -> j362333639;
		j1543293861 -> j1310452999;
	j2694684856 [label="Oui! Эти крошечные копии и их печальная история… Мне хочется плакать, вспоминая об этом. Превратить их в машины войны теми, кого они считали семьёй?",shape=box,color=blue];
		j2694684856 -> j964452499;
	j1701990369 [label="Oui! Я слышала, тебе пришлось многое пережить, чтобы научиться сражаться так, как сейчас. Смерть — это жестокий учитель, не могу себе представить…",shape=box,color=blue];
		j1701990369 -> j964452499;
	j2093463038 [label="Не знаю, будут ли эти слова что-то значить для тебя. Или же это всего лишь светящиеся точки на жужжащем оборудование.",shape=box,color=blue];
		j2093463038 -> j3180921528;
	j470535849 [label="Я не знаю этого твоего друга, но я думаю, как хорошо, что у него есть ты.",shape=box,color=blue];
		j470535849 -> j3293792709;
	j1642316071 [label="В часовне был отец, темперамент которого, кажется, был очень похож на твой. Он мог выдерживать всё, до определённого момента.",shape=box,color=blue];
		j1642316071 -> j317276834;
	j30900819 [label="Прости. Это было глупо с моей стороны.",shape=box,color=red];
		j30900819 -> j3610365465;
	j168274654 [label="Так ты прощаешь меня?",shape=box,color=red];
		j168274654 -> j353193822;
	j1508231473 [label="Boolean MarieNoDate is now true.",color=orange];
		j1508231473 -> "Chat ends.";
	j3864516817 [label="Boolean DrifterFaithSol is now false.",color=orange];
		j3864516817 -> j2176048951;
	j964452499 [label="Non. Я предпочитаю остаться такой, какая я есть сейчас. Я сама выбрала взять принять помощь от le Cardinal, ввести сыворотку, которую он предложил.",shape=box,color=blue];
		j964452499 -> j4025031596;
	j3180921528 [label="И в самом деле, если задуматься о реальности этого, когда я пишу эти слова, вполне возможно, что с того момента, как я их записал, прошло либо несколько дней, либо много лет, в зависимости от того, когда ты находишься.",shape=box,color=blue];
		j3180921528 -> j2772898822;
	j317276834 [label="Когда он чувствовал себя подавленным и всё вокруг казалось хаосом, я спрашивала, не хочет ли он моей компании. Des fois, oui, des fois, non.",shape=box,color=blue];
		j317276834 -> j3293792709;
	j3610365465 [label="Boolean DrifterFaithSol is now false.",color=orange];
		j3610365465 -> j1479489239;
	j353193822 [label="Boolean DrifterFaithSol is now false.",color=orange];
		j353193822 -> j3298673405;
	j2176048951 [label="Мы всего лишь слепые создания, пытающиеся найти свой путь в этом мире.",shape=box,color=blue];
		j2176048951 -> j851032625;
	j4025031596 [label="Но ты знаешь, какая печаль меня терзает, какая неуверенность. Не родиться и не вырасти в этой жизни, предназначенной для войны.",shape=box,color=blue];
		j4025031596 -> j4046916454;
		j4025031596 -> j2244054723;
	j2772898822 [label="Всё это к тому, что я понимаю, мои слова о том, что ты не один, могут звучать пусто.",shape=box,color=blue];
		j2772898822 -> j2247579637;
	j1479489239 [label="+10 Chemistry",color=orange];
		j1479489239 -> j1440597734;
	j3298673405 [label="+5 Chemistry",color=orange];
		j3298673405 -> j97041530;
	j851032625 [label="Но я спросила, как ты. И вопрос всё ещё остаётся в силе, petit mensonge ou non.",shape=box,color=blue];
		j851032625 -> j890650518;
		j851032625 -> j1960225255;
		j851032625 -> j3722304322;
	j4046916454 [label="Иногда я думаю о том, как многому мне пришлось учиться самому, и я немного завидую этому парню, ведь у него была такая настоящая подготовка.",shape=box,color=red];
		j4046916454 -> j3522187279;
	j2244054723 [label="Я думаю, нет «хорошего» способа попасть в жизнь, полную войны. Родиться, вырасти или выбрать её. В конечном счёте, всё зависит от того, кто ты и как ты с этим справляешься.",shape=box,color=red];
		j2244054723 -> j1740474017;
	j2247579637 [label="Хотя окружающие могут казаться отстраненными, цифровыми или просто терпеливо сидящими в ожидании, когда ты скажешь «привет».",shape=box,color=blue];
		j2247579637 -> j3720192728;
	j1440597734 [label="Oui, и если бы твой характер был как у Леона, я бы сказала, что десять ударов плетью — твоя расплата! Но это не так. И прощение даровано.",shape=box,color=blue];
		j1440597734 -> j2176048951;
	j97041530 [label="Oui, я тебя прощаю. Будь твой характер как у Лиона — десять ударов плетью были бы твоей расплатой.",shape=box,color=blue];
		j97041530 -> j2176048951;
	j890650518 [label="Честно говоря… бывало и лучше.",shape=box,color=red];
		j890650518 -> j2774260367;
	j1960225255 [label="Честно говоря, у меня всё в порядке. А у тебя как?",shape=box,color=red];
		j1960225255 -> j700974073;
	j3722304322 [label="Теперь лучше. Спасибо. Говорят, исповедь полезна для людей, правда?",shape=box,color=red];
		j3722304322 -> j590480982;
	j3522187279 [label="Add -1 to Thermostat counter",color=orange];
		j3522187279 -> j3460655188;
	j1740474017 [label="Add 1 to Thermostat counter",color=orange];
		j1740474017 -> j2727538749;
	j3720192728 [label="И я надеюсь, что этот момент пройдёт для тебя быстро.",shape=box,color=blue];
		j3720192728 -> j3083402369;
	j2774260367 [label="Qu’y a-t-il? В чём дело?",shape=box,color=blue];
		j2774260367 -> j779743364;
		j2774260367 -> j3017375610;
		j2774260367 -> j3742340999;
		j2774260367 -> j3400308943;
	j590480982 [label="+5 Chemistry",color=orange];
		j590480982 -> j2707656806;
	j3460655188 [label="+10 Chemistry",color=orange];
		j3460655188 -> j4079664284;
	j2727538749 [label="+10 Chemistry",color=orange];
		j2727538749 -> j2103212344;
	j3083402369 [label="А если нет? У меня есть решение, которое всегда помогает!",shape=box,color=blue];
		j3083402369 -> j848208416;
	j2707656806 [label="Ха! Oui, так и есть. Très bien, я рада это слышать.",shape=box,color=blue];
		j2707656806 -> j3883861076;
	j4079664284 [label="Oui, но тогда не быть тебе лихим волком, которого мы знаем и любим, не так ли? Думаю, Сол поместил тебя именно туда, где тебе и надлежало быть.",shape=box,color=blue];
		j4079664284 -> j1570911449;
	j2103212344 [label="Oui, я полностью согласна. Никто не рождается для войны. Ну, кроме этих, Гринир, о которых мне рассказывали, и то...",shape=box,color=blue];
		j2103212344 -> j2224842052;
	j848208416 [label="Des pâtisseries!",shape=box,color=blue];
		j848208416 -> j4132951681;
	j3883861076 [label="Ах! Обед подан. Мне пора идти. Пока, волк. Я очень рада, что мы поговорили.",shape=box,color=blue];
		j3883861076 -> "Chat ends.";
	j1570911449 [label="Но я понимаю, что ты имеешь в виду. Ты видишь ту структуру и поддержку, которую дали другим, и невольно мечтаешь о том же. Особенно когда ты был так одинок.",shape=box,color=blue];
		j1570911449 -> j1516580681;
	j2224842052 [label="Интересно, не выбрали бы они другой путь, если бы у них был настоящий выбор?",shape=box,color=blue];
		j2224842052 -> j620666876;
		j2224842052 -> j2136008684;
	j4132951681 [label="Check boolean MarieRoathePastry1",color=orange];
		j4132951681 -> j2648122796 [label=true,color=green];
		j4132951681 -> j3084503278 [label=true,color=green];
		j4132951681 -> j3463619218 [label=true,color=green];
		j4132951681 -> j3084503278 [label=false,color=brown];
		j4132951681 -> j1264865546 [label=false,color=brown];
	j1516580681 [label="Теперь я не могу не видеть крошечную копию, которая так одинока... и волка, который бежит со стаей.",shape=box,color=blue];
		j1516580681 -> j974012088;
	j620666876 [label="Трудно, когда тебя с детства учат верить, что это и есть твоя единственная цель, всё твоё существование, вырваться из этой формы. Цель даёт людям утешение.",shape=box,color=red];
		j620666876 -> j3506788257;
	j2136008684 [label="Думаю, так и было бы. Некоторые из них, с которыми мне довелось встретиться, доказали, что Гринир - это нечто большее, чем просто война и смерть.",shape=box,color=red];
		j2136008684 -> j4128775935;
