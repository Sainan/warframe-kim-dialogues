	1371 [label="Chat ends.",color=orange];
	1376 [label="Теперь я не могу не видеть крошечную копию, которая так одинока... и волка, который бежит со стаей.",shape=box,color=blue];
		1376 -> 1383;
	1377 [label="Трудно, когда тебя с детства учат верить, что это и есть твоя единственная цель, всё твоё существование, вырваться из этой формы. Цель даёт людям утешение.",shape=box,color=red];
		1377 -> 1384;
	1378 [label="Думаю, так и было бы. Некоторые из них, с которыми мне довелось встретиться, доказали, что Гринир - это нечто большее, чем просто война и смерть.",shape=box,color=red];
		1378 -> 1385;
	1372 [label="Мне просто нужно будет принести достаточно выпечки на всех.",shape=box,color=red];
		1372 -> 1379;
	1373 [label="Спасибо, Мари.",shape=box,color=red];
		1373 -> 1380;
	1374 [label="Я просто не позволю Роуту даже приблизиться к ним.",shape=box,color=red];
		1374 -> 1381;
	1375 [label="С выпечкой никогда не прогадаешь.",shape=box,color=red];
		1375 -> 1382;
	1383 [label="Похоже, роли поменялись, не так ли?",shape=box,color=blue];
		1383 -> 1390;
