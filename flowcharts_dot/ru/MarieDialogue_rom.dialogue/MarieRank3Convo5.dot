		j1513648151 -> j1127025487;
	j782707230 [label="Да! Представь себе Лиона и меня, когда дьявол войдет в комнату в маске и пальто, с карманами, набитыми крадеными сладостями!",shape=box,color=blue];
		j782707230 -> j1283361828;
