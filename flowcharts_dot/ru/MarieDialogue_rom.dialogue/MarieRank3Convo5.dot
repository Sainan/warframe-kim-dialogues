	j1491872934 [label="Только не подпускай к ним дьявола. Sinon, il va les voler! Он ведь любит воровать сладости, если ему не достаётся вдоволь!",shape=box,color=blue];
		j1491872934 -> j420323306;
	j4203434366 [label="Они всё ещё восстанавливаются. Их путь ещё не окончен.",shape=box,color=red];
		j4203434366 -> j1424290028;
	j3346089996 [label="Мне бы хотелось сделать для них больше. ",shape=box,color=red];
		j3346089996 -> j1424290028;
	j2273298611 [label="Да, верно. Многие ищут веру в надежде, что она даст им именно это - цель. Направление.",shape=box,color=blue];
		j2273298611 -> j480731786;
	j209899500 [label="(А, вот как это пишется, merci!) Что даже народ, которому внушали, что это их единственная цель, может найти другую.",shape=box,color=blue];
		j209899500 -> j4003794622;
	j334615163 [label="Вот это дух! Даже дьяволу время от времени не помешает кусочек пирожного, я полагаю.",shape=box,color=blue];
		j334615163 -> j643735970;
	j93588186 [label="Je vous en prie. Надеюсь, я хоть немного подняла тебе настроение. У тебя ведь получилось поднять его мне.",shape=box,color=blue];
		j93588186 -> "Chat ends.";
	j2842054178 [label="Ах, я жалуюсь, но даже самый последний дьявол время от времени заслуживает немного пирожного, да?",shape=box,color=blue];
