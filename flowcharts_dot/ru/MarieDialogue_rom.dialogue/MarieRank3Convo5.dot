	1278 [label="Bonjour! Как у нас дела в этот день?",shape=box,color=blue];
		1278 -> 1281;
		1278 -> 1280;
		1278 -> 1283;
		1278 -> 3947;
		1278 -> 1282;
	1281 [label="У меня все хорошо, как у тебя?",shape=box,color=red];
		1281 -> 1285;
	1280 [label="Бывает и лучше, но спасибо за вопрос. Как у тебя дела?",shape=box,color=red];
		1280 -> 1284;
	1283 [label="Признаюсь, мне пришлось соврать, я... на самом деле не последователь Сола.",shape=box,color=red];
		1283 -> 1287;
	3947 [label="Better now that I'm speaking to you. But you make all my days brighter by being in them.",shape=box,color=red];
		3947 -> 3948;
	1282 [label="[Конец.]",shape=box,color=red];
		1282 -> 1286;
	1285 [label="Думаю, у меня всё хорошо. Хотя, если задуматься, я чувствую себя не так, как следовало бы.",shape=box,color=blue];
		1285 -> 1292;
		1285 -> 1293;
	1284 [label="Со мной всё в порядке, но теперь ты меня заинтриговал. Qu’y a-t-il?",shape=box,color=blue];
		1284 -> 1288;
		1284 -> 1289;
		1284 -> 1290;
		1284 -> 1291;
	1287 [label="О! Я... понимаю. Pourquoi?",shape=box,color=blue];
		1287 -> 1294;
		1287 -> 1295;
		1287 -> 1296;
	3948 [label="Wolf ! You will make me fall out of my chair !",shape=box,color=blue];
		3948 -> 3949;
		3948 -> 3950;
	1286 [label="Chat ends.",color=orange];
	1292 [label="Что ты имеешь в виду?",shape=box,color=red];
		1292 -> 1301;
	1293 [label="Однажды мне пришлось быть на твоём месте.",shape=box,color=red];
		1293 -> 1302;
	1288 [label="Это... просто... трудно объяснить.",shape=box,color=red];
		1288 -> 1297;
	1289 [label="Слишком много забот, слишком мало времени.",shape=box,color=red];
		1289 -> 1298;
	1290 [label="Мой друг однажды назвал это «пауками». Они время от времени появляются.",shape=box,color=red];
		1290 -> 1299;
	1291 [label="Иногда всё... просто выводит меня из себя. Но со мной всё будет в порядке.",shape=box,color=red];
		1291 -> 1300;
	1294 [label="Мне показалось, что это будет возможность узнать тебя поближе...",shape=box,color=red];
		1294 -> 1303;
	1295 [label="Показалось, что это будет забавно?",shape=box,color=red];
		1295 -> 1304;
	1296 [label="Честно, не знаю. Просто так, спонтанно вышло.",shape=box,color=red];
		1296 -> 1305;
	3949 [label="I do mean it. I'm sorry if I'm making you uncomfortable.",shape=box,color=red];
		3949 -> 3951;
	3950 [label="I'm sorry. I was just teasing.",shape=box,color=red];
		3950 -> 3951;
	1301 [label="Я une Sœur de Sol. Мне не суждено... сражаться. Убивать. Шёпоты не живы, или, по крайней мере, так говорит мне Кавия, но что насчёт остальных, с кем мне приходится сталкиваться?",shape=box,color=blue];
		1301 -> 1310;
	1302 [label="+5 Chemistry",color=orange];
		1302 -> 1311;
	1297 [label="Тогда не буду любопытствовать. Знаю, иногда трудно выразить словами.",shape=box,color=blue];
		1297 -> 1306;
	1298 [label="В Соборе была одна Сестра, похожая на эту. Она всё время суетилась и суетилась. Однажды я застала её полирующей серебро в три часа ночи.",shape=box,color=blue];
		1298 -> 1307;
	1299 [label="Ах, oui. Кажется, я понимаю, о чём ты говоришь. Как бы... облако, которое движется по солнцу.",shape=box,color=blue];
		1299 -> 1308;
	1300 [label="Как чашка, которую наполняют водой по капле, non?",shape=box,color=blue];
		1300 -> 1309;
	1303 [label="Тебе не нужно было говорить мне такую ложь, чтобы узнать меня.",shape=box,color=blue];
		1303 -> 1312;
	1304 [label="Je ne comprends pas votre humour. Возможно, в будущем слово «забавно» будет означать что-то другое?",shape=box,color=blue];
		1304 -> 1313;
	1305 [label="Я не знаю, какой инстинкт заставил тебя сказать мне такую ложь. ",shape=box,color=blue];
		1305 -> 1314;
	3951 [label="Bon, où en étais-je ?",shape=box,color=blue];
		3951 -> 1278;
	1310 [label="Сражаться во имя Сола... это ли мой путь? Должна ли я стать убийцей во имя его? Moi, petite Marie?",shape=box,color=blue];
		1310 -> 1319;
		1310 -> 1320;
	1311 [label="Знаю, ты используешь une métaphore, но я смеюсь не могу сдержаться! Не думаю, что ты смог бы оказаться на моём месте, даже если бы попытался!",shape=box,color=blue];
		1311 -> 1321;
	1306 [label="Есть столько способов, как наши дни и мысли могут пойти наперекосяк. Они могут находить тёмные норы, в которых мы застреваем, не так ли?",shape=box,color=blue];
		1306 -> 1315;
	1307 [label="Я спросила её, зачем она это делает, а она ответила, что не может спать, слишком сильно волнуется.",shape=box,color=blue];
		1307 -> 1316;
	1308 [label="У нас есть слово для этого, ennui. Усталость и недовольство, из-за которых всё кажется… бессмысленным.",shape=box,color=blue];
		1308 -> 1317;
	1309 [label="Она наполнится и прольётся. Возможно, даже опрокинет своё содержимое. И тогда всё это покажется настоящей катастрофой. ",shape=box,color=blue];
		1309 -> 1318;
	1312 [label="Душа - это не только вера, которую она носит. Я une Sœur de Sol, но я надеюсь, ты видишь во мне нечто большее, не так ли?",shape=box,color=blue];
		1312 -> 1322;
	1313 [label="Не для меня.",shape=box,color=blue];
		1313 -> 1323;
	1314 [label="Остаётся только надеяться, что это было безобидно, а не жестокой шуткой надо мной. Поэтому я предпочту последовать примеру Сола -",shape=box,color=blue];
		1314 -> 1324;
	1319 [label="Меня не готовили быть солдатом. Не то что мальчишку. И тебя тоже.",shape=box,color=red];
		1319 -> 1328;
	1320 [label="Я не всегда был таким. Я всегда был бойцом. Мне пришлось учиться на горьком опыте.",shape=box,color=red];
		1320 -> 1329;
	1321 [label="От этого образа в моей голове меня бросает в дрожь. Прежде чем я перестану дышать, скажи мне о чём ты говоришь?",shape=box,color=blue];
		1321 -> 1319;
		1321 -> 1320;
	1315 [label="Мы можем лишь стараться быть добрыми и терпеливыми к самим себе, когда это случается.",shape=box,color=blue];
		1315 -> 1325;
	1316 [label="Каждый раз, когда я находила её в таком состоянии, я спрашивала, стоит ли мне составить ей компанию. Иногда она соглашалась, иногда нет.",shape=box,color=blue];
		1316 -> 1306;
	1317 [label="Или, может быть, у тебя есть желание спрятаться, заплакать, это больше похоже на отчаяние, я не могу сказать.",shape=box,color=blue];
		1317 -> 1335;
	1318 [label="You clean the mess, you right the cup... and it starts over again, oui ?",shape=box,color=blue];
		1318 -> 1327;
	1322 [label="Тем для выбора столько же, сколько звезд на небе!",shape=box,color=blue];
		1322 -> 1330;
		1322 -> 1331;
	1323 [label="Update boolean DrifterFaithSol",color=orange];
		1323 -> 1332;
	1324 [label="- чью веру я исповедую, веришь ты в неё или нет, и прощаю тебя. Будь ты как Лион, я бы сказала, что десять ударов плетью, твоя расплата.",shape=box,color=blue];
		1324 -> 1333;
	1328 [label="Oui! Эти крошечные копии и их печальная история… Мне хочется плакать, вспоминая об этом. Превратить их в машины войны теми, кого они считали семьёй?",shape=box,color=blue];
		1328 -> 1337;
	1329 [label="Oui! Я слышала, ты многое пережил, чтобы научиться сражаться так, как сейчас. Смерть - это жестокий учитель, не могу себе представить...",shape=box,color=blue];
		1329 -> 1337;
	1325 [label="Не знаю, будут ли эти слова что-то значить для тебя. Или же это всего лишь светящиеся точки на жужжащем оборудование.",shape=box,color=blue];
		1325 -> 1334;
	1335 [label="Я не знаю этого твоего друга, но я думаю, как хорошо, что у него есть ты.",shape=box,color=blue];
		1335 -> 1306;
	1327 [label="В часовне был отец, темперамент которого, кажется, был очень похож на твой. Он мог выдерживать всё, до определённого момента.",shape=box,color=blue];
		1327 -> 1336;
	1330 [label="Прости. Это было глупо с моей стороны.",shape=box,color=red];
		1330 -> 1338;
	1331 [label="Так ты прощаешь меня?",shape=box,color=red];
		1331 -> 1339;
	1332 [label="Update boolean MarieNoDate",color=orange];
		1332 -> 1340;
	1333 [label="Update boolean DrifterFaithSol",color=orange];
		1333 -> 1341;
	1337 [label="Non. Я предпочитаю остаться такой, какая я есть сейчас. Я сама выбрала взять руку Кардинала, принять сыворотку, которую он предложил.",shape=box,color=blue];
		1337 -> 1343;
	1334 [label="Indeed, when you consider the reality of the thing, when I write these words, it could very well be days or many years since I have set them down, depending on when you are.",shape=box,color=blue];
		1334 -> 1342;
	1336 [label="Когда он чувствовал себя подавленным и всё вокруг казалось беспорядочным, я спрашивал, не хочет ли он моей компании. Des fois, oui, des fois, non.",shape=box,color=blue];
		1336 -> 1306;
	1338 [label="Update boolean DrifterFaithSol",color=orange];
		1338 -> 1344;
	1339 [label="Update boolean DrifterFaithSol",color=orange];
		1339 -> 1345;
	1340 [label="Chat ends.",color=orange];
	1341 [label="Мы всего лишь слепые создания, пытающиеся найти свой путь в этом мире.",shape=box,color=blue];
		1341 -> 1346;
	1343 [label="Но ты знаешь, какая печаль меня терзает, какая неуверенность. Не родиться и не вырасти в этой жизни, предназначенной для войны.",shape=box,color=blue];
		1343 -> 1348;
		1343 -> 1349;
	1342 [label="Всё это к тому, что я понимаю, мои слова о том, что ты не один, могут звучать пусто.",shape=box,color=blue];
		1342 -> 1347;
	1344 [label="+10 Chemistry",color=orange];
		1344 -> 1350;
	1345 [label="+5 Chemistry",color=orange];
		1345 -> 1351;
	1346 [label="Но я спросила, как ты. И вопрос всё ещё остаётся в силе, petit mensonge ou non.",shape=box,color=blue];
		1346 -> 1352;
		1346 -> 1353;
		1346 -> 1354;
	1348 [label="Иногда я думаю о том, как многому мне пришлось учиться самому, и я немного завидую этому парню, ведь у него была такая настоящая подготовка.",shape=box,color=red];
		1348 -> 1356;
	1349 [label="Я думаю, нет «хорошего» способа попасть в жизнь, полную войны. Родиться, вырасти или выбрать её. В конечном счёте, всё зависит от того, кто ты и как ты с этим справляешься.",shape=box,color=red];
		1349 -> 1357;
	1347 [label="Хотя окружающие могут казаться отстраненными, цифровыми или просто терпеливо сидящими в ожидании, когда ты скажешь «привет».",shape=box,color=blue];
		1347 -> 1355;
	1350 [label="Oui, и если бы ты был как Лион, я бы сказала, что десять ударов плетью - твоя расплата! Но это не так. И прощение даровано.",shape=box,color=blue];
		1350 -> 1341;
	1351 [label="Oui, я тебя прощаю. Будь ты как Лион, десять ударов плетью были бы твоей расплатой.",shape=box,color=blue];
		1351 -> 1341;
	1352 [label="Честно говоря… бывало и лучше.",shape=box,color=red];
		1352 -> 1358;
	1353 [label="Честно говоря, у меня всё в порядке. А у тебя как?",shape=box,color=red];
		1353 -> 1285;
	1354 [label="Теперь лучше. Спасибо. Говорят, исповедь полезна для людей, правда?",shape=box,color=red];
		1354 -> 1359;
	1356 [label="Add -1 to Thermostat",color=orange];
		1356 -> 1361;
	1357 [label="Add 1 to Thermostat",color=orange];
		1357 -> 1362;
	1355 [label="И я надеюсь, что этот момент пройдёт для тебя быстро.",shape=box,color=blue];
		1355 -> 1360;
	1358 [label="Qu’y a-t-il? В чём дело?",shape=box,color=blue];
		1358 -> 1288;
		1358 -> 1289;
