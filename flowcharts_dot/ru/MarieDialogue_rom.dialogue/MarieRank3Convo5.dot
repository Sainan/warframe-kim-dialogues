		j4132951681 -> j3101373897 [label=false,color=brown];
		j4132951681 -> j1264865546 [label=false,color=brown];
	j1516580681 [label="Теперь я не могу не видеть крошечную копию, которая так одинока... и волка, который бежит со стаей.",shape=box,color=blue];
		j1516580681 -> j974012088;
	j620666876 [label="Трудно, когда тебя с детства учат верить, что это и есть твоя единственная цель, всё твоё существование, вырваться из этой формы. Цель даёт людям утешение.",shape=box,color=red];
		j620666876 -> j3506788257;
	j2136008684 [label="Думаю, так и было бы. Некоторые из них, с которыми мне довелось встретиться, доказали, что Гринир - это нечто большее, чем просто война и смерть.",shape=box,color=red];
		j2136008684 -> j4128775935;
	j2648122796 [label="Мне просто нужно будет принести достаточно выпечки на всех.",shape=box,color=red];
		j2648122796 -> j2783187047;
	j3101373897 [label="Спасибо, Мари.",shape=box,color=red];
		j3101373897 -> j2069502592;
	j3463619218 [label="Я просто не позволю Роуту даже приблизиться к ним.",shape=box,color=red];
		j3463619218 -> j1059255455;
	j1264865546 [label="С выпечкой никогда не прогадаешь.",shape=box,color=red];
		j1264865546 -> j1491872934;
