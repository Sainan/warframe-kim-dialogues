	1361 [label="+10 Chemistry",color=orange];
		1361 -> 1365;
	1362 [label="+10 Chemistry",color=orange];
		1362 -> 1366;
	1360 [label="А если нет? У меня есть решение, которое всегда помогает!",shape=box,color=blue];
		1360 -> 1364;
	1363 [label="Ха! Oui, так и есть. Très bien, я рада это слышать.",shape=box,color=blue];
		1363 -> 1367;
	1365 [label="Oui, но тогда ты бы не был тем лихим волком, которого мы знаем и любим, не так ли? Думаю, Сол поместил тебя именно туда, где тебе и надлежало быть.",shape=box,color=blue];
		1365 -> 1369;
	1366 [label="Oui, я полностью согласна. Никто не рождается для войны. Ну, кроме этих, Гринир, о которых мне рассказывали, и то...",shape=box,color=blue];
		1366 -> 1370;
	1364 [label="Des pâtisseries!",shape=box,color=blue];
		1364 -> 1368;
	1367 [label="Ах! Обед подан. Мне пора идти. Пока, волк. Я очень рада, что мы поговорили.",shape=box,color=blue];
		1367 -> 1371;
	1369 [label="Но я понимаю, что ты имеешь в виду. Ты видишь ту структуру и поддержку, которую дали другим, и невольно мечтаешь о том же. Особенно когда ты был так одинок.",shape=box,color=blue];
		1369 -> 1376;
	1370 [label="Интересно, не выбрали бы они другой путь, если бы у них был настоящий выбор?",shape=box,color=blue];
		1370 -> 1377;
		1370 -> 1378;
