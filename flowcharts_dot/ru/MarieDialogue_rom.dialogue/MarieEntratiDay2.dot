		2762 -> 3889;
	2763 [label="Но если ты предлагаешь более… официальные ухаживания, то oui! Oui! Мне бы этого хотелось.",shape=box,color=blue];
		2763 -> 2764;
		2763 -> 2765;
	2764 [label="Времена определённо немного изменились. Не скажешь, что всё стало «официальнее», но мне определённо приятно… показать тебе.",shape=box,color=red];
