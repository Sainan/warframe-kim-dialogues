digraph {
	2615 [label="MarieEntratiDay2 begins.",color=orange];
		2615 -> 2616;
	2616 [label="Скиталец. Я взяла время подумать и... успокоиться. У меня есть строгое правило: не заводить разговоры, когда я в furieuse.",shape=box,color=blue];
		2616 -> 2617;
	2617 [label="Evaluate expressions",color=orange];
		2617 -> 2618 [label="MarieEntrati5a",color=purple];
		2617 -> 2619 [label="MarieEntrati5b",color=purple];
		2617 -> 2620 [label="MarieEntrati5c",color=purple];
		2617 -> 2621 [label="MarieEntrati5d",color=purple];
		2617 -> 2622 [label="MarieEntrati5e",color=purple];
		2617 -> 2623 [label="MarieEntrati5f",color=purple];
		2617 -> 2624 [label="MarieEntrati5g",color=purple];
		2617 -> 2625 [label="MarieEntrati5h",color=purple];
		2617 -> 2626 [label="MarieEntrati5i",color=purple];
		2617 -> 2627 [label="false",color=purple];
	2618 [label="Это был… удар кинжалом между рёбер, который ты мне нанёс вчера. Признаюсь, я сбежала в гневе, oui, но и с répulsion. Не к тебе, а к себе.",shape=box,color=blue];
		2618 -> 2628;
	2619 [label="Но прежде чем мы продолжим, я должна затронуть одну вещь, твой тон, когда ты говоришь со мной. Я знаю, ты, должно быть, считаешь меня ребёнком. Ты ведь живёшь века, если не больше.",shape=box,color=blue];
		2619 -> 2629;
	2620 [label="Я долго размышляла над вашими словами. Что это не священная война, и что le Cardinal манипулирует людьми.",shape=box,color=blue];
		2620 -> 2630;
	2621 [label="Было… разумеется, верно задать вопрос о том, где в писаниях Сола сказано, что невинные - расходный материал. Там этого нет.",shape=box,color=blue];
		2621 -> 2631;
	2622 [label="Прежде чем мы продолжим, я должна затронуть одну вещь, твою готовность использовать мою веру против меня в споре, при том что сам ты в вере не участвуешь.",shape=box,color=blue];
		2622 -> 2632;
	2623 [label="Я… прости, что вчера ушла из нашего разговора. Это было просто слишком. Но должна спросить, прежде чем мы продолжим, ты действительно говорил серьёзно? Или лишь пытался сыграть на моих чувствах, чтобы избежать неприятного спора?",shape=box,color=blue];
		2623 -> 2633;
		2623 -> 2634;
	2624 [label="Похоже, мы зашли в тупик в отношении le Cardinal, oui? Ты видишь в нём чудовище, а я - святого.",shape=box,color=blue];
		2624 -> 2635;
	2625 [label="Я хочу поговорить с тобой о твоём решении встать на сторону Энтрати лишь затем, чтобы завоевать моё расположение. Если ты не против.",shape=box,color=blue];
		2625 -> 2636;
	2626 [label="Я бы хотела поговорить с тобой о твоей лжи, если ты не возражаешь.",shape=box,color=blue];
		2626 -> 2636;
	2627 [label="Chat ends.",color=orange];
	2628 [label="How could I be surprised that you were so deadly precise with your aim ? To compare my words with that of the devil...",shape=box,color=blue];
		2628 -> 2637;
	2629 [label="Ты странствовал по неизведанным измерениям, сквозь саму Бездну. Сражался с богами и ангелами. Кто я для тебя, oui? Просто глупая маленькая Мари.",shape=box,color=blue];
		2629 -> 2638;
	2630 [label="И я верю… oui, ты прав. Это не священная война. Потому что священных войн не бывает. Война никогда не бывает святой, справедливой или праведной. Боль не должна быть путеводным светом.",shape=box,color=blue];
		2630 -> 2639;
	2631 [label="Война никогда не бывает священной, справедливой или праведной. Боль никогда не должна быть путеводной звездой.",shape=box,color=blue];
		2631 -> 2639;
	2632 [label="Это было неискренне, Скиталец. Жестоко и безрезультатно. Это была попытка «выиграть» разговор, и так себя вести не следовало.",shape=box,color=blue];
		2632 -> 2640;
	2633 [label="Мои слова были серьёзными. Прости, если я... не вовремя. Ты мне очень дорога, Мари...",shape=box,color=red];
		2633 -> 2641;
	2634 [label="Это не имелось в виду, просто… всё оказалось запутанно. Мне очень, очень жаль. Страсть момента.",shape=box,color=red];
		2634 -> 2642;
	2635 [label="Однако… я не хочу, чтобы между нами всё закончилось вот так. Ты добрая душа, и есть многое между нами, что я не хочу оставлять испорченным.",shape=box,color=blue];
		2635 -> 2946;
	2636 [label="Пытаться манипулировать ситуацией так, чтобы управлять моими чувствами... лицемерно и жестоко. Я признаюсь, я жажду возненавидеть тебя за это, Скиталец.",shape=box,color=blue];
		2636 -> 2644;
	2637 [label="Я считала себя человеком с открытым сердцем и разумом, к миру и ко всем, кто в нём живёт. А ты метко, одним колким выстрелом, доказал, что я ошибалась.",shape=box,color=blue];
		2637 -> 2645;
	2638 [label="С одной стороны, я это понимаю. Сочувствую. Мы оба были вспыльчивы. Но с другой стороны, я прошу тебя отнестись ко мне с большей вежливостью и тактом, чем прежде.",shape=box,color=blue];
		2638 -> 2646;
	2639 [label="Даже то, что мы делаем сейчас - уничтожаем Шёпот и сражаемся со всеми твоими многочисленными врагами, не является путём Светил.",shape=box,color=blue];
		2639 -> 2647;
	2640 [label="Вера не является и никогда не должна быть оружием против другого. Она щит. Свет во тьме. Голос, указывающий путь.",shape=box,color=blue];
		2640 -> 2648;
	2641 [label="Before I face the - the enormity of that, I must explain myself regarding le Cardinal, s'il vous plaît.",shape=box,color=blue];
		2641 -> 2649;
	2642 [label="Update boolean DrifterMarie",color=orange];
		2642 -> 2650;
	2946 [label="Check boolean LoidFamilyComplete",color=orange];
		2946 -> 2651 [label=true,color=green];
		2946 -> 2643 [label=false,color=brown];
	2644 [label="Однако... я не хочу, чтобы наши отношения остались такими. Между нами есть много такого, что я не хочу портить.",shape=box,color=blue];
		2644 -> 1395;
	2645 [label="Полагаю, я здесь pour m’excuser - чтобы сказать, что мне искренне жаль, что я была так глупо упряма. Надеюсь, ты понимаешь.",shape=box,color=blue];
		2645 -> 2653;
		2645 -> 2654;
	2646 [label="Ведь я жила на улице. Каждый день своей жизни я прожила в физических мучениях. Я познала горе, я познала любовь, я познала страх и отвержение. Я познала жизнь и утраты.",shape=box,color=blue];
		2646 -> 2655;
	2647 [label="Как бы ни было необходимо поднять меч, чтобы мир не был захвачен подобными, его не следует чтить. И уж точно непростительно, когда в результате этого страдают невинные.",shape=box,color=blue];
		2647 -> 2656;
	2648 [label="А ты пытался использовать это против меня, чтобы просто «победить» меня? Это была трусливая тактика. Но мы оба были в ярости, и я… прощу тебя, если ты простишь меня, за слова, сказанные в гневе.",shape=box,color=blue];
		2648 -> 2657;
		2648 -> 2658;
	2649 [label="Думаю, мне трудно отказаться от защиты le Cardinal... и мне потребовалось некоторое время, чтобы понять, почему я не могу его отпустить.",shape=box,color=blue];
		2649 -> 2659;
	2650 [label="Non, я понимаю... Сколько убийств было совершено «в порыве страсти», oui? И, конечно же, столько же детей было рождено в порыве страсти.",shape=box,color=blue];
		2650 -> 2660;
	2651 [label="И ты стал для меня важен, за такое короткое время... Я нахожу наши беседы такими радостными.",shape=box,color=blue];
		2651 -> 2661;
	2643 [label="Да, я по-прежнему хочу увидеть, как Monsieur Лойд воссоединится с теми, кто наверху. Хочу, чтобы утешение пришло к оставшейся семье le Cardinal, и ты есть путь к этому! ",shape=box,color=blue];
		2643 -> 2651;
	1395 [label="Check boolean LoidFamilyComplete",color=orange];
		1395 -> 2662 [label=true,color=green];
		1395 -> 2652 [label=false,color=brown];
	2653 [label="Да, я понимаю. И извини, если мои слова тебя обидели. Я просто не знаю, как ещё нужно было сказать.",shape=box,color=red];
		2653 -> 2663;
	2654 [label="Приятно, что мои слова дошли до тебя. Надежда уже почти исчезала.",shape=box,color=red];
		2654 -> 2664;
	2655 [label="И если ты действительно считаешь себя настолько выше всех нас, то ты не увидишь ничего, кроме облаков, в которых ты затерялся.",shape=box,color=blue];
		2655 -> 2657;
		2655 -> 2658;
	2656 [label="Итак... я признаю, что le Cardinal не имеет права причинять вред другим во имя «большего блага».",shape=box,color=blue];
		2656 -> 2665;
	2657 [label="Мне это неприятно, но не знаю, как ещё тебя вразумить. Энтрати тебе не друг. И не отец.",shape=box,color=red];
		2657 -> 2666;
	2658 [label="Прости. Потерялось самообладание, и сказано было то, чего не хотелось говорить.",shape=box,color=red];
		2658 -> 2667;
	2659 [label="Я просто не хочу, чтобы ты думал обо мне хуже, если я признаюсь тебе во всём этом. Это кажется таким мелким и жалким.",shape=box,color=blue];
		2659 -> 2668;
		2659 -> 2669;
	2660 [label="Я… разочарована. Мне больно. Но я… я прощаю тебя.",shape=box,color=blue];
		2660 -> 2670;
	2661 [label="Evaluate expressions",color=orange];
		2661 -> 2671 [label="DrifterMarie",color=purple];
		2661 -> 2672 [label="DrifterLyon",color=purple];
		2661 -> 2673 [label="DrifterRoathe",color=purple];
		2661 -> 2674 [label="false",color=purple];
	2662 [label="И есть ещё много добра, которое ты мог бы сделать для моего Лиона и даже, полагаю, для самого дьявола...",shape=box,color=blue];
		2662 -> 2675;
		2662 -> 2676;
	2652 [label="Да, я по-прежнему хочу увидеть, как Monsieur Лойд воссоединится с теми, кто наверху. Хочу, чтобы утешение пришло к оставшейся семье le Cardinal, и ты есть путь к этому! ",shape=box,color=blue];
		2652 -> 2662;
	2663 [label="+10 Chemistry",color=orange];
		2663 -> 2677;
	2664 [label="Знаешь, стоит проявлять великодушие, когда \"побеждаешь\".",shape=box,color=blue];
		2664 -> 2678;
		2664 -> 2679;
	2665 [label="Какое же «высшее благо» останется, если на его пути будут лишь разбитые жизни и сердца?",shape=box,color=blue];
		2665 -> 2645;
	2666 [label="Non. Он не мой отец. Мой отец оставил меня на улице в детстве, а le Cardinal не сделал ничего столь жестокого.",shape=box,color=blue];
		2666 -> 2680;
	2667 [label="Множество злодеяний совершено в пылу страсти. Таков порядок вещей. ",shape=box,color=blue];
		2667 -> 2681;
	2668 [label="Думаю, я уже догадываюсь, что это может быть. ",shape=box,color=red];
		2668 -> 2682;
	2669 [label="Я не буду думать о тебе хуже, Мари. Обещаю.",shape=box,color=red];
		2669 -> 2683;
	2670 [label="Чтобы… завершить разговор о le Cardinal, если позволишь, оставив в стороне моё разбитое сердце, s’il te plaît?",shape=box,color=blue];
		2670 -> 2684;
	2671 [label="В самом деле, как я могу оттолкнуть тебя, когда ты признался мне в своих чувствах?",shape=box,color=blue];
		2671 -> 2685;
	2672 [label="В самом деле, как я могу оттолкнуть тебя, когда ты признался мне в своих чувствах к нашему дорогому Лиону? Ты мог бы принести ему столько покоя... столько утешения...",shape=box,color=blue];
		2672 -> 2685;
	2673 [label="В самом деле, как я могу оттолкнуть тебя, когда ты, кажется, на дьявола нацелился? Я не понимаю твоих вкусов, но... кажется, ты будешь рядом с нами, oui?",shape=box,color=blue];
		2673 -> 2685;
	2674 [label="Я не хочу терять тебя как спутника. Можем ли мы отложить всё это в сторону и сказать, что хоть мы и не согласны, мы всё равно можем продолжать вместе?",shape=box,color=blue];
		2674 -> 2686;
		2674 -> 2687;
	2675 [label="Мари, подожди. Пожалуйста. Позволь мне извиниться.",shape=box,color=red];
		2675 -> 2688;
	2676 [label="Честно говоря, я не думал, что мои слова для тебя что-то значат - не думал, что это будет для тебя так важно.",shape=box,color=red];
		2676 -> 2688;
	2677 [label="Я ценю это больше, чем ты можешь себе представить, спасибо.",shape=box,color=blue];
		2677 -> 2689;
	2678 [label="Это была шутка.",shape=box,color=red];
		2678 -> 2690;
	2679 [label="Извини. Я нечасто «побеждаю».",shape=box,color=red];
		2679 -> 2691;
	2680 [label="Update boolean MarieFamilyFail",color=orange];
		2680 -> 2692;
	2681 [label="+5 Chemistry",color=orange];
		2681 -> 2693;
	2682 [label="Полагаю, тебе это должно быть очевидно, non? Человек, который тоже потерял свою famille. ",shape=box,color=blue];
		2682 -> 2694;
	2683 [label="Посмотрим. Думаю, в конце концов я увидела в нём частичку отца, который меня бросил, как бы ничтожно и грустно это мне сейчас ни казалось.",shape=box,color=blue];
		2683 -> 2694;
	2684 [label="Думаю, мне трудно отказаться от защиты le Cardinal... и мне потребовалось некоторое время, чтобы понять, почему я не могу его отпустить.",shape=box,color=blue];
		2684 -> 2695;
	2685 [label="Можем ли мы отложить все это в сторону и сказать, что мы можем не соглашаться, но мы все равно можем продолжать двигаться вперед?",shape=box,color=blue];
		2685 -> 2686;
		2685 -> 2687;
	2686 [label="Нет, это ещё не до конца разобрано. Нам нужно закончить этот разговор.",shape=box,color=red];
		2686 -> 2696;
	2687 [label="Я думаю, это справедливо. С этим можно согласиться.",shape=box,color=red];
		2687 -> 2697;
	2688 [label="Я прощаю тебя за твою ложь, Скиталец. Мы можем остаться друзьями и союзниками. Но лгать мне таким образом, просто чтобы… что?",shape=box,color=blue];
		2688 -> 2698;
	2689 [label="Думаю, мне трудно отказаться от défense of le Cardinal... и мне потребовалось некоторое время, чтобы понять, почему я не могу его отпустить.",shape=box,color=blue];
		2689 -> 2699;
	2690 [label="Oui, конечно, хорошо. ",shape=box,color=blue];
		2690 -> 2689;
	2691 [label="+5 Chemistry",color=orange];
		2691 -> 2690;
	2692 [label="Add -10 to Family",color=orange];
		2692 -> 2700;
	2693 [label="Я принимаю твоё извинение… ведь и сама не раз позволяла своему гневу взять надо мной верх.",shape=box,color=blue];
		2693 -> 2701;
	2694 [label="Подумать только... что после всех этих лет кто-то может оказать мне такую доброту?",shape=box,color=blue];
		2694 -> 2702;
	2695 [label="Я просто не хочу, чтобы ты думал обо мне хуже, если я признаюсь тебе во всём этом. Это кажется таким мелким и жалким.",shape=box,color=blue];
		2695 -> 2703;
		2695 -> 2704;
	2696 [label="Update boolean MarieFamilyFail",color=orange];
		2696 -> 2705;
	2697 [label="+5 Chemistry",color=orange];
		2697 -> 2706;
	2698 [label="Check boolean DrifterMarieWhoops",color=orange];
		2698 -> 2707 [label=true,color=green];
		2698 -> 2708 [label=false,color=brown];
	2699 [label="Я просто не хочу, чтобы ты думал обо мне хуже, если я признаюсь тебе во всём этом. Это кажется таким мелким и жалким.",shape=box,color=blue];
		2699 -> 2709;
		2699 -> 2710;
	2700 [label="Update boolean MarieEntratiCompleteB",color=orange];
		2700 -> 2711;
	2701 [label="Позволь мне просто… объяснить, почему мне так трудно отказаться от защиты le Cardinal. И почему мне потребовалось время, чтобы понять, почему я не могла его отпустить.",shape=box,color=blue];
		2701 -> 2699;
	2702 [label="Глупая маленькая Мари... конечно, он был не таким, каким казался.",shape=box,color=blue];
		2702 -> 2712;
		2702 -> 2713;
	2703 [label="Думаю, я уже догадываюсь, что это может быть. ",shape=box,color=red];
		2703 -> 2714;
	2704 [label="Я не буду думать о тебе хуже, Мари. Обещаю.",shape=box,color=red];
		2704 -> 2715;
	2705 [label="Add -10 to Family",color=orange];
		2705 -> 2716;
	2706 [label="Bien. По крайней мере, мы договорились.",shape=box,color=blue];
		2706 -> 2717;
	2707 [label="Лезть ко мне в постель? Это подло.",shape=box,color=blue];
		2707 -> 2718;
	2708 [label="Использовать меня? Это подло.",shape=box,color=blue];
		2708 -> 2718;
	2709 [label="Думаю, я уже догадываюсь, что это может быть. ",shape=box,color=red];
		2709 -> 2719;
	2710 [label="Я не буду думать о тебе хуже, Мари. Обещаю.",shape=box,color=red];
		2710 -> 2720;
	2711 [label="Update boolean MarieNoDate",color=orange];
		2711 -> 2721;
	2712 [label="Ты не дура, Мари. Совсем нет. Наоборот, это доказывает мне, какая ты замечательная.",shape=box,color=red];
		2712 -> 2722;
	2713 [label="Ты стала так важна для меня, Мари... и мне так жаль, что этот разговор принял такой оборот.",shape=box,color=red];
		2713 -> 2722;
	2714 [label="Полагаю, тебе это должно быть очевидно, non? Человек, который тоже потерял свою famille. ",shape=box,color=blue];
		2714 -> 2723;
	2715 [label="Посмотрим. Думаю, в конце концов я увидела в нём частичку отца, который меня бросил, как бы ничтожно и грустно это мне сейчас ни казалось.",shape=box,color=blue];
		2715 -> 2723;
	2716 [label="Je ne pense pas.",shape=box,color=blue];
		2716 -> 2724;
	2717 [label="À la revoyure.",shape=box,color=blue];
		2717 -> 2725;
	2718 [label="Так что должна сказать: я никогда не смогла бы доверить тебе своё сердце. И, наверное, мне стоит извиниться за эти слова, я уверена, они должны тебя огорчить -",shape=box,color=blue];
		2718 -> 2726;
	2719 [label="Полагаю, тебе это должно быть очевидно, non? Человек, который тоже потерял свою famille. ",shape=box,color=blue];
		2719 -> 2727;
	2720 [label="Посмотрим. Думаю, в конце концов я увидела в нём частичку отца, который меня бросил, как бы ничтожно и грустно это мне сейчас ни казалось.",shape=box,color=blue];
		2720 -> 2727;
	2721 [label="Chat ends.",color=orange];
	2722 [label="Но мне нужно было, чтобы ты поняла, Энтрати может быть сложным. Что он способен причинять боль в той же мере, в какой приносит пользу. Просто не хотелось, чтобы тебе потом стало больнее.",shape=box,color=red];
		2722 -> 2728;
	2723 [label="Подумать только... что после всех этих лет кто-то может оказать мне такую доброту?",shape=box,color=blue];
		2723 -> 2729;
	2724 [label="Update boolean MarieEntratiCompleteB",color=orange];
		2724 -> 2730;
	2725 [label="Update boolean MarieEntratiCompleteC",color=orange];
		2725 -> 2731;
	2726 [label="Но боюсь, что нет. Надеюсь, это не станет для тебя сюрпризом.",shape=box,color=blue];
		2726 -> 2732;
	2727 [label="Подумать только... что после всех этих лет кто-то может оказать мне такую доброту?",shape=box,color=blue];
		2727 -> 2733;
	2728 [label="Глупо, но, кажется, я пытался всё это сделать лишь затем, чтобы защитить тебя. ",shape=box,color=red];
		2728 -> 2734;
	2729 [label="Глупая маленькая Мари... конечно, он был не таким, каким казался.",shape=box,color=blue];
		2729 -> 2735;
