	2731 [label="Update boolean MarieWillDate",color=orange];
		2731 -> 2737;
	2732 [label="Что же касается le Cardinal? Полагаю, мы останемся по этому вопросу расколоты. Как и по отношению к нему.",shape=box,color=blue];
		2732 -> 2738;
	2733 [label="Глупая маленькая Мари... конечно, он был не таким, каким казался.",shape=box,color=blue];
		2733 -> 2739;
		2733 -> 2735;
	2734 [label="Evaluate expressions",color=orange];
		2734 -> 2740 [label="LyonDating",color=purple];
		2734 -> 2741 [label="RoatheDating",color=purple];
		2734 -> 2742 [label="false",color=purple];
	2735 [label="Нет, он был добр к тебе. Это не ложь. Но это не значит, что в нём есть только это, и что на большее он не способен.",shape=box,color=red];
		2735 -> 2743;
	2736 [label="Chat ends.",color=orange];
	2737 [label="Chat ends.",color=orange];
	2738 [label="Au revoir.",shape=box,color=blue];
		2738 -> 2744;
	2739 [label="[Признаться в чувствах.] Ты не дура, Мари. Совсем нет. Наоборот, это доказывает мне, какая ты замечательная.",shape=box,color=red];
		2739 -> 2745;
	2740 [label="И ты говоришь мне это, одновременно признаваясь в любви брату моей души?! Думаешь, сможешь выставить нас обоих дураками?!",shape=box,color=blue];
		2740 -> 2746;
	2741 [label="И ты мне это говоришь, пока сидишь с дьяволом?! Ты что, думаешь нас обоих за дураков выставить?!",shape=box,color=blue];
		2741 -> 2746;
	2742 [label="Я... О, mon cœur. Mon cœur! О, я чувствую то же самое! Но не осмеливалась сказать эти слова, не осмеливалась написать их тебе, ведь считала себя глупой за них.",shape=box,color=blue];
		2742 -> 2747;
	2743 [label="Oui, как ты и сказал, теперь я ясно это вижу. Мне… остаётся лишь ещё раз поблагодарить тебя за терпение.",shape=box,color=blue];
		2743 -> 2748;
	2744 [label="Update boolean MarieNoDate",color=orange];
		2744 -> 2749;
	2745 [label="Ты стала так важна для меня, Мари... и мне так жаль, что этот разговор принял такой оборот.",shape=box,color=red];
		2745 -> 2750;
	2746 [label="Update boolean DrifterMarieWhoops",color=orange];
		2746 -> 2751;
	2747 [label="Ах! Ты сделал меня такой счастливой! Интересно… что ты собираешься делать с этим признанием...?",shape=box,color=blue];
		2747 -> 2752;
		2747 -> 2753;
	2748 [label="В отчаянии удержать отца, которого уже нет, я едва не отвергла семью, что осталась рядом.",shape=box,color=blue];
		2748 -> 2754;
	2749 [label="Update boolean MarieEntratiCompleteB",color=orange];
		2749 -> 3890;
	2750 [label="Но мне нужно было, чтобы ты поняла, Энтрати может быть сложным. Что он способен причинять боль в той же мере, в какой приносит пользу. Просто не хотелось, чтобы тебе потом стало больнее.",shape=box,color=red];
		2750 -> 2756;
	2751 [label="Update boolean MarieNoDate",color=orange];
		2751 -> 2757;
	2752 [label="[Предложить встречаться.] Ну, пришла мысль.. может быть, ты бы хотела… ну… стать парой?",shape=box,color=red];
		2752 -> 2758;
	2753 [label="Думаю, что нам не стоит спешить. Мы ведь всё ещё узнаём друг друга.",shape=box,color=red];
		2753 -> 2759;
	2754 [label="И думаю, я не единственная, non? Я… кажется, теперь как следует вооружена, чтобы помочь в битве, что ждёт нас с теми наверху, oui?",shape=box,color=blue];
		2754 -> 2760;
	3890 [label="Update boolean MarieFamilyFail",color=orange];
		3890 -> 2755;
	2756 [label="Глупо, но, кажется, всё это было сделано мной, только затем, чтобы защитить тебя. ",shape=box,color=red];
		2756 -> 2761;
	2757 [label="Tu crois pouvoir débarquer ici depuis le futur et tous nous manipuler comme des marionnettes?! Je te suggère de prendre cette machine, de te pencher et de te l'enfoncer fermement dans le derrière, espèce de sale pourriture répugnante et puante!",shape=box,color=blue];
		2757 -> 2762;
	2758 [label="«Пара?» Мой дорогой волк, я действительно верю, что времена изменились с тех пор, как у меня были женихи и браки по договоренности... Я почти не сомневаюсь, что ты собираешься пожениться!",shape=box,color=blue];
		2758 -> 2763;
	2759 [label="Oui, это разумно. Вполне разумно. Я ведь родом из эпохи официальных ухаживаний, oui? Хотя мне было бы любопытно узнать, как со временем всё изменилось.",shape=box,color=blue];
		2759 -> 2764;
