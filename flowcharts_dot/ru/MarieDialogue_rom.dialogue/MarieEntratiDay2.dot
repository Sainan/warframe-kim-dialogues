digraph {
	graph [fontname="Roboto Condensed"];
	node [fontname="Roboto Condensed"];
	edge [fontname="Roboto Condensed"];

	"MarieEntratiDay2 begins." [color=orange];
		"MarieEntratiDay2 begins." -> j740237188;
	j740237188 [label="Скиталец. Я взяла время подумать и... успокоиться. У меня есть строгое правило: не заводить разговоры, когда я в furieuse.",shape=box,color=blue];
		j740237188 -> j69936295;
	j69936295 [label="Evaluate expressions",color=orange];
		j69936295 -> j2383263952 [label="MarieEntrati5a",color=purple];
		j69936295 -> j2278650141 [label="MarieEntrati5b",color=purple];
		j69936295 -> j3158920152 [label="MarieEntrati5c",color=purple];
		j69936295 -> j421976586 [label="MarieEntrati5d",color=purple];
		j69936295 -> j2134241877 [label="MarieEntrati5e",color=purple];
		j69936295 -> j1503499928 [label="MarieEntrati5f",color=purple];
		j69936295 -> j1906763565 [label="MarieEntrati5g",color=purple];
		j69936295 -> j143080525 [label="MarieEntrati5h",color=purple];
		j69936295 -> j3103514975 [label="MarieEntrati5i",color=purple];
		j69936295 -> "Chat ends." [label="false",color=purple];
	j2383263952 [label="Это был… удар кинжалом между рёбер, который ты мне нанёс вчера. Признаюсь, я сбежала в гневе, oui, но и с répulsion. Не к тебе, а к себе.",shape=box,color=blue];
		j2383263952 -> j3799766802;
	j2278650141 [label="Но прежде чем мы продолжим, я должна затронуть одну вещь, твой тон, когда ты говоришь со мной. Я знаю, ты, должно быть, считаешь меня ребёнком. Ты ведь живёшь века, если не больше.",shape=box,color=blue];
		j2278650141 -> j1338114274;
	j3158920152 [label="Я долго размышляла над вашими словами. Что это не священная война, и что le Cardinal манипулирует людьми.",shape=box,color=blue];
		j3158920152 -> j3366365661;
	j421976586 [label="Было… разумеется, верно задать вопрос о том, где в писаниях Сол сказано, что невинные — расходный материал. Там этого нет.",shape=box,color=blue];
		j421976586 -> j2040596110;
	j2134241877 [label="Прежде чем мы продолжим, я должна затронуть одну вещь, твою готовность использовать мою веру против меня в споре, при том что сам ты в вере не участвуешь.",shape=box,color=blue];
		j2134241877 -> j692791283;
	j1503499928 [label="Я… прости, что вчера ушла из нашего разговора. Это было просто слишком. Но должна спросить, прежде чем мы продолжим, ты действительно говорил серьёзно? Или лишь пытался сыграть на моих чувствах, чтобы избежать неприятного спора?",shape=box,color=blue];
		j1503499928 -> j587104013;
		j1503499928 -> j3693893425;
	j1906763565 [label="Похоже, мы зашли в тупик в отношении le Cardinal, oui? Ты видишь в нём чудовище, а я - святого.",shape=box,color=blue];
		j1906763565 -> j3126131922;
	j143080525 [label="Я хочу поговорить с тобой о твоём решении встать на сторону Энтрати лишь затем, чтобы завоевать моё расположение. Если ты не против.",shape=box,color=blue];
		j143080525 -> j249740904;
	j3103514975 [label="Я бы хотела поговорить с тобой о твоей лжи, если ты не возражаешь.",shape=box,color=blue];
		j3103514975 -> j249740904;
	"Chat ends." [color=orange];
	j3799766802 [label="Как я могла удивляться твоей смертоносной меткости? Сравни мои слова с дьявольскими...",shape=box,color=blue];
		j3799766802 -> j1385839459;
	j1338114274 [label="Ты странствовал по неизведанным измерениям, сквозь саму Бездну. Сражался с богами и ангелами. Кто я для тебя, oui? Просто глупая маленькая Мари.",shape=box,color=blue];
		j1338114274 -> j2988020914;
	j3366365661 [label="И я верю… oui, ты прав. Это не священная война. Потому что священных войн не бывает. Война никогда не бывает святой, справедливой или праведной. Боль не должна быть путеводным светом.",shape=box,color=blue];
		j3366365661 -> j2837983401;
	j2040596110 [label="Война никогда не бывает священной, справедливой или праведной. Боль никогда не должна быть путеводной звездой.",shape=box,color=blue];
		j2040596110 -> j2837983401;
	j692791283 [label="Это было неискренне, Скиталец. Жестоко и безрезультатно. Это была попытка «выиграть» разговор, и так себя вести не следовало.",shape=box,color=blue];
		j692791283 -> j1550353574;
	j587104013 [label="Мои слова были серьёзными. Прости, если я... не вовремя. Ты мне очень дорога, Мари...",shape=box,color=red];
		j587104013 -> j1846722755;
	j3693893425 [label="Это не имелось в виду, просто… всё оказалось запутанно. Мне очень, очень жаль. Страсть момента.",shape=box,color=red];
		j3693893425 -> j1782858537;
	j3126131922 [label="Однако… я не хочу, чтобы между нами всё закончилось вот так. Ты добрая душа, и есть многое между нами, что я не хочу оставлять испорченным.",shape=box,color=blue];
		j3126131922 -> j483300420;
	j249740904 [label="Пытаться манипулировать ситуацией так, чтобы управлять моими чувствами... лицемерно и жестоко. Я признаюсь, я жажду возненавидеть тебя за это, Скиталец.",shape=box,color=blue];
		j249740904 -> j38443217;
	j1385839459 [label="Я считала себя человеком с открытым сердцем и разумом, к миру и ко всем, кто в нём живёт. А ты метко, одним колким выстрелом, доказал, что я ошибалась.",shape=box,color=blue];
		j1385839459 -> j2206657280;
	j2988020914 [label="С одной стороны, я это понимаю. Сочувствую. Мы оба были вспыльчивы. Но с другой стороны, я прошу тебя отнестись ко мне с большей вежливостью и тактом, чем прежде.",shape=box,color=blue];
		j2988020914 -> j1297102821;
	j2837983401 [label="Даже то, что мы делаем сейчас - уничтожаем Шёпот и сражаемся со всеми твоими многочисленными врагами, не является путём Светил.",shape=box,color=blue];
		j2837983401 -> j521109480;
	j1550353574 [label="Вера не является и никогда не должна быть оружием против другого. Она щит. Свет во тьме. Голос, указывающий путь.",shape=box,color=blue];
		j1550353574 -> j4115522157;
	j1846722755 [label="Прежде чем я осознаю всю чудовищность происходящего, я должна объясниться относительно le Cardinal, s'il vous plaît.",shape=box,color=blue];
		j1846722755 -> j1592747046;
	j1782858537 [label="Boolean DrifterMarie is now false.",color=orange];
		j1782858537 -> j546627797;
	j483300420 [label="Check boolean LoidFamilyComplete",color=orange];
		j483300420 -> j1950139345 [label=true,color=green];
		j483300420 -> j3453470127 [label=false,color=brown];
	j38443217 [label="Однако... я не хочу, чтобы наши отношения остались такими. Между нами есть много такого, что я не хочу портить.",shape=box,color=blue];
		j38443217 -> j3805730835;
	j2206657280 [label="Полагаю, я здесь pour m’excuser - чтобы сказать, что мне искренне жаль, что я была так глупо упряма. Надеюсь, ты понимаешь.",shape=box,color=blue];
		j2206657280 -> j2284574579;
		j2206657280 -> j1756182469;
	j1297102821 [label="Ведь я жила на улице. Каждый день своей жизни я прожила в физических мучениях. Я познала горе, я познала любовь, я познала страх и отвержение. Я познала жизнь и утраты.",shape=box,color=blue];
		j1297102821 -> j837875877;
	j521109480 [label="Как бы ни было необходимо поднять меч, чтобы мир не был захвачен подобными, его не следует чтить. И уж точно непростительно, когда в результате этого страдают невинные.",shape=box,color=blue];
		j521109480 -> j2622180901;
	j4115522157 [label="А ты пытался использовать это против меня, чтобы просто «победить» меня? Это была трусливая тактика. Но мы оба были в ярости, и я… прощу тебя, если ты простишь меня, за слова, сказанные в гневе.",shape=box,color=blue];
		j4115522157 -> j1356679361;
		j4115522157 -> j3896711357;
	j1592747046 [label="Думаю, мне трудно отказаться от защиты le Cardinal... и мне потребовалось некоторое время, чтобы понять, почему я не могу его отпустить.",shape=box,color=blue];
		j1592747046 -> j3700290292;
	j546627797 [label="Non, я понимаю... Сколько убийств было совершено «в порыве страсти», oui? И, конечно же, столько же детей было рождено в порыве страсти.",shape=box,color=blue];
		j546627797 -> j3166654928;
	j1950139345 [label="И ты стал для меня важен, за такое короткое время... Я нахожу наши беседы такими радостными.",shape=box,color=blue];
		j1950139345 -> j1186072069;
	j3453470127 [label="Да, я по-прежнему хочу увидеть, как Monsieur Лойд воссоединится с теми, кто наверху. Хочу, чтобы утешение пришло к оставшейся семье le Cardinal, и ты есть путь к этому! ",shape=box,color=blue];
		j3453470127 -> j1950139345;
	j3805730835 [label="Check boolean LoidFamilyComplete",color=orange];
		j3805730835 -> j1954895281 [label=true,color=green];
		j3805730835 -> j3349952212 [label=false,color=brown];
	j2284574579 [label="Да, я понимаю. И извини, если мои слова тебя обидели. Я просто не знаю, как ещё нужно было сказать.",shape=box,color=red];
		j2284574579 -> j2745953133;
	j1756182469 [label="Приятно, что мои слова дошли до тебя. Надежда уже почти исчезала.",shape=box,color=red];
		j1756182469 -> j1907588711;
	j837875877 [label="И если ты действительно считаешь себя настолько выше всех нас, то ты не увидишь ничего, кроме облаков, в которых ты затерялся.",shape=box,color=blue];
		j837875877 -> j1356679361;
		j837875877 -> j3896711357;
	j2622180901 [label="Итак... я признаю, что le Cardinal не имеет права причинять вред другим во имя «большего блага».",shape=box,color=blue];
		j2622180901 -> j3991997123;
	j1356679361 [label="Мне это неприятно, но не знаю, как ещё тебя вразумить. Энтрати тебе не друг. И не отец.",shape=box,color=red];
		j1356679361 -> j3221714082;
	j3896711357 [label="Прости. Потерялось самообладание, и сказано было то, чего не хотелось говорить.",shape=box,color=red];
		j3896711357 -> j3614697511;
	j3700290292 [label="Я просто не хочу, чтобы ты думал обо мне хуже, если я признаюсь тебе во всём этом. Это кажется таким мелким и жалким.",shape=box,color=blue];
		j3700290292 -> j2111099483;
		j3700290292 -> j612709073;
	j3166654928 [label="Я… разочарована. Мне больно. Но я… я прощаю тебя.",shape=box,color=blue];
		j3166654928 -> j4206952528;
	j1186072069 [label="Evaluate expressions",color=orange];
		j1186072069 -> j1150088798 [label="DrifterMarie",color=purple];
		j1186072069 -> j2605908772 [label="DrifterLyon",color=purple];
		j1186072069 -> j1504794771 [label="DrifterRoathe",color=purple];
		j1186072069 -> j286044360 [label="false",color=purple];
	j1954895281 [label="И есть ещё много добра, которое ты мог бы сделать для моего Лиона и даже, полагаю, для самого дьявола...",shape=box,color=blue];
		j1954895281 -> j857538092;
		j1954895281 -> j3906498977;
	j3349952212 [label="Да, я по-прежнему хочу увидеть, как Monsieur Лойд воссоединится с теми, кто наверху. Хочу, чтобы утешение пришло к оставшейся семье le Cardinal, и ты есть путь к этому! ",shape=box,color=blue];
		j3349952212 -> j1954895281;
	j2745953133 [label="+10 Chemistry",color=orange];
		j2745953133 -> j2789064818;
	j1907588711 [label="Знаешь, стоит проявлять великодушие, когда \"побеждаешь\".",shape=box,color=blue];
		j1907588711 -> j4251264302;
		j1907588711 -> j2724110863;
	j3991997123 [label="Какое же «высшее благо» останется, если на его пути будут лишь разбитые жизни и сердца?",shape=box,color=blue];
		j3991997123 -> j2206657280;
	j3221714082 [label="Non. Он не мой отец. Мой отец оставил меня на улице в детстве, а le Cardinal не сделал ничего столь жестокого.",shape=box,color=blue];
		j3221714082 -> j786197016;
	j3614697511 [label="Множество злодеяний совершено в пылу страсти. Таков порядок вещей. ",shape=box,color=blue];
		j3614697511 -> j3778079597;
	j2111099483 [label="Думаю, я уже догадываюсь, что это может быть. ",shape=box,color=red];
		j2111099483 -> j4023545864;
	j612709073 [label="Я не буду думать о тебе хуже, Мари. Обещаю.",shape=box,color=red];
		j612709073 -> j1041671622;
	j4206952528 [label="Чтобы… завершить разговор о le Cardinal, если позволишь, оставив в стороне моё разбитое сердце, s’il te plaît?",shape=box,color=blue];
		j4206952528 -> j2025299142;
	j1150088798 [label="В самом деле, как я могу оттолкнуть тебя, когда ты признался мне в своих чувствах?",shape=box,color=blue];
		j1150088798 -> j2760824827;
	j2605908772 [label="В самом деле, как я могу оттолкнуть тебя, когда ты признался мне в своих чувствах к нашему дорогому Лиону? Ты мог бы принести ему столько покоя... столько утешения...",shape=box,color=blue];
		j2605908772 -> j2760824827;
	j1504794771 [label="В самом деле, как я могу оттолкнуть тебя, когда ты, кажется, на дьявола нацелился? Я не понимаю твоих вкусов, но... кажется, ты будешь рядом с нами, oui?",shape=box,color=blue];
		j1504794771 -> j2760824827;
	j286044360 [label="Я не хочу терять тебя как спутника. Можем ли мы отложить всё это в сторону и сказать, что хоть мы и не согласны, мы всё равно можем продолжать вместе?",shape=box,color=blue];
		j286044360 -> j2968673205;
		j286044360 -> j3678231248;
	j857538092 [label="Мари, подожди. Пожалуйста. Позволь мне извиниться.",shape=box,color=red];
		j857538092 -> j1423756918;
	j3906498977 [label="Честно говоря, я не думал, что мои слова для тебя что-то значат - не думал, что это будет для тебя так важно.",shape=box,color=red];
		j3906498977 -> j1423756918;
	j2789064818 [label="Я ценю это больше, чем ты можешь себе представить, спасибо.",shape=box,color=blue];
		j2789064818 -> j303828350;
	j4251264302 [label="Это была шутка.",shape=box,color=red];
		j4251264302 -> j2794940695;
	j2724110863 [label="Извини. Я нечасто «побеждаю».",shape=box,color=red];
		j2724110863 -> j1595624008;
	j786197016 [label="Boolean MarieFamilyFail is now true.",color=orange];
		j786197016 -> j542165713;
	j3778079597 [label="+5 Chemistry",color=orange];
		j3778079597 -> j1559369957;
	j4023545864 [label="Полагаю, тебе это должно быть очевидно, non? Человек, который тоже потерял свою famille. ",shape=box,color=blue];
		j4023545864 -> j470193520;
	j1041671622 [label="Посмотрим. Думаю, в конце концов я увидела в нём частичку отца, который меня бросил, как бы ничтожно и грустно это мне сейчас ни казалось.",shape=box,color=blue];
		j1041671622 -> j470193520;
	j2025299142 [label="Думаю, мне трудно отказаться от защиты le Cardinal... и мне потребовалось некоторое время, чтобы понять, почему я не могу его отпустить.",shape=box,color=blue];
		j2025299142 -> j3053485671;
	j2760824827 [label="Можем ли мы отложить все это в сторону и сказать, что мы можем не соглашаться, но мы все равно можем продолжать двигаться вперед?",shape=box,color=blue];
		j2760824827 -> j2968673205;
		j2760824827 -> j3678231248;
	j2968673205 [label="Нет, это ещё не до конца разобрано. Нам нужно закончить этот разговор.",shape=box,color=red];
		j2968673205 -> j2551683190;
	j3678231248 [label="Я думаю, это справедливо. С этим можно согласиться.",shape=box,color=red];
		j3678231248 -> j3592227590;
	j1423756918 [label="Я прощаю тебя за твою ложь, Скиталец. Мы можем остаться друзьями и союзниками. Но лгать мне таким образом, просто чтобы… что?",shape=box,color=blue];
		j1423756918 -> j1574691804;
	j303828350 [label="Думаю, мне трудно отказаться от défense of le Cardinal... и мне потребовалось некоторое время, чтобы понять, почему я не могу его отпустить.",shape=box,color=blue];
		j303828350 -> j890302663;
	j2794940695 [label="Oui, конечно, хорошо. ",shape=box,color=blue];
		j2794940695 -> j303828350;
	j1595624008 [label="+5 Chemistry",color=orange];
		j1595624008 -> j2794940695;
	j542165713 [label="Add -10 to Family counter",color=orange];
		j542165713 -> j816189513;
	j1559369957 [label="Я принимаю твоё извинение… ведь и сама не раз позволяла своему гневу взять надо мной верх.",shape=box,color=blue];
		j1559369957 -> j529447934;
	j470193520 [label="Подумать только... что после всех этих лет кто-то может оказать мне такую доброту?",shape=box,color=blue];
		j470193520 -> j932975943;
	j3053485671 [label="Я просто не хочу, чтобы ты думал обо мне хуже, если я признаюсь тебе во всём этом. Это кажется таким мелким и жалким.",shape=box,color=blue];
		j3053485671 -> j2691523649;
		j3053485671 -> j3097470286;
	j2551683190 [label="Boolean MarieFamilyFail is now true.",color=orange];
		j2551683190 -> j4055920456;
	j3592227590 [label="+5 Chemistry",color=orange];
		j3592227590 -> j3819723046;
	j1574691804 [label="Check boolean DrifterMarieWhoops",color=orange];
		j1574691804 -> j254529291 [label=true,color=green];
		j1574691804 -> j2903262455 [label=false,color=brown];
	j890302663 [label="Я просто не хочу, чтобы ты думал обо мне хуже, если я признаюсь тебе во всём этом. Это кажется таким мелким и жалким.",shape=box,color=blue];
		j890302663 -> j252094611;
		j890302663 -> j1069268708;
	j816189513 [label="Boolean MarieEntratiCompleteB is now true.",color=orange];
		j816189513 -> j1508231473;
	j529447934 [label="Позволь мне просто… объяснить, почему мне так трудно отказаться от защиты le Cardinal. И почему мне потребовалось время, чтобы понять, почему я не могла его отпустить.",shape=box,color=blue];
		j529447934 -> j890302663;
