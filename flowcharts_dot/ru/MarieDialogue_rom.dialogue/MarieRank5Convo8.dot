	3782 [label="Sol, it broke my heart. His voice did not falter when he spoke. Mais je l'ai vu dans ses yeux.",shape=box,color=blue];
		3782 -> 3786;
	3783 [label="It breaks my heart. I hope his does not shatter in his chest some day. I do not know if he will survive it. I do not know if any of us will.",shape=box,color=blue];
