	j520518461 [label="Evaluate expressions",color=orange];
		j520518461 -> j2097252046 [label="RoatheFamilyDelay",color=purple];
		j520518461 -> j3288947747 [label="RoatheDating",color=purple];
		j520518461 -> j4028398856 [label="RoatheRedeemed",color=purple];
		j520518461 -> j2122422504 [label="RoatheVillain",color=purple];
		j520518461 -> j335113399 [label="false",color=purple];
	j3896165059 [label="Oui, qu'est-ce qu'il ya?",shape=box,color=blue];
		j3896165059 -> j2732219570;
	"Chat ends." [color=orange];
	j2097252046 [label="Боюсь, теперь мне придётся называть его «нашим» дьяволом, non? Ведь он не уйдёт в ближайшее время. Ха!",shape=box,color=blue];
		j2097252046 -> j4128017508;
	j3288947747 [label="Мне кажется, это я должна задавать тебе этот вопрос, non? Ведь это ты теперь резвишься с ним!",shape=box,color=blue];
		j3288947747 -> j668841695;
	j4028398856 [label="Я не знаю, как тебе это удалось. Но он рассказал нам правду о приёме сыворотки.",shape=box,color=blue];
		j4028398856 -> j3437481222;
	j2122422504 [label="Я не знаю, как тебе это удалось. Но он рассказал нам правду о приёме sérum.",shape=box,color=blue];
	j335113399 [label="Я переживаю за него. Мне кажется, он причиняет себе больше вреда, чем показывает, n'est-ce pas?",shape=box,color=blue];
		j335113399 -> j3042513590;
	j2732219570 [label="Извини, если тебе кажется, что это происходит из ниоткуда, но раньше не было понятно, как сказать тебе об этом.",shape=box,color=red];
		j2732219570 -> j4014761934;
	j4128017508 [label="Ты хорошо постарался, заручившись его помощью в общении с Monsieur Лойдом. Я не думала, что это возможно.",shape=box,color=blue];
		j4128017508 -> j4011790644;
	j668841695 [label="Я сопротивляюсь искушению спросить тебя о toutes sortes de commérages.",shape=box,color=blue];
		j668841695 -> j4011790644;
	j3437481222 [label="Сол, это разбило мне сердце. Его голос не дрогнул, когда он заговорил. Mais je l'ai vu dans ses yeux.",shape=box,color=blue];
		j3437481222 -> j4011790644;
	j3042513590 [label="Это разбивает мне сердце. Надеюсь, его грудь не разобьётся вдребезги. Не знаю, переживёт ли он это. Не знаю, переживёт ли кто-нибудь из нас.",shape=box,color=blue];
		j3042513590 -> "Chat ends.";
	j4014761934 [label="Я тебя обожаю. Я тебя просто обожаю.",shape=box,color=red];
		j4014761934 -> j4153919760;
	j4011790644 [label="В нём произошла перемена. Незначительная, но она есть. ",shape=box,color=blue];
		j4011790644 -> j538445872;
	j4153919760 [label="Ну, пришла мысль.. может быть, ты бы хотела… ну… стать парой?",shape=box,color=red];
		j4153919760 -> j2298753926;
	j538445872 [label="+5 Chemistry",color=orange];
		j538445872 -> j2244809022;
	j2298753926 [label="Evaluate expressions",color=orange];
		j2298753926 -> j3260681774 [label="MarieNoDate",color=purple];
		j2298753926 -> j1792185252 [label="MarieWillDate",color=purple];
		j2298753926 -> j3260681774 [label="false",color=purple];
	j2244809022 [label="Я знаю, что за это мы должны быть благодарны тебе.",shape=box,color=blue];
		j2244809022 -> j1684652838;
	j3260681774 [label="Ох! Ох, Скиталец. Я не знаю, как это сказать, поэтому скажу прямо. ",shape=box,color=blue];
		j3260681774 -> j617350017;
	j1792185252 [label="О, я чувствую то же самое! Mais je ne sais pas comment te l'écrire, je n'ose pas taper les mots! Я считала себя дурой, даже думая о них!",shape=box,color=blue];
		j1792185252 -> j1129897626;
	j1684652838 [label="Я не знаю, примет ли он это, но дружба у него останется навсегда.",shape=box,color=blue];
		j1684652838 -> j2136981968;
	j617350017 [label="Non.",shape=box,color=blue];
		j617350017 -> "Chat ends.";
	j1129897626 [label="Ах! Я так счастлива!",shape=box,color=blue];
		j1129897626 -> j339633743;
	j2136981968 [label="Хотя я думаю, что никогда не устану на него кричать!",shape=box,color=blue];
		j2136981968 -> j2048229723;
		j2136981968 -> j1521644195;
	j339633743 [label="Если ты предлагаешь более… официальные ухаживания, то oui! Oui! Мне бы этого хотелось.",shape=box,color=blue];
		j339633743 -> j1382454649;
		j339633743 -> j2827946566;
	j2048229723 [label="Мне кажется, ему слишком нравится дразнить тебя.",shape=box,color=red];
		j2048229723 -> j3348449395;
	j1521644195 [label="Мне приятно, что вы двое нашли что-то общее.",shape=box,color=red];
		j1521644195 -> j3196387877;
	j1382454649 [label="Определенно не предлагаю брак, пока нет. ",shape=box,color=red];
		j1382454649 -> j3162132034;
	j2827946566 [label="Времена определённо немного изменились. Не скажешь, что всё стало «официальнее», но мне определённо приятно… показать тебе.",shape=box,color=red];
		j2827946566 -> j1764833621;
	j3348449395 [label="Come un groschat de gouttière. Я к нему привыкла.",shape=box,color=blue];
		j3348449395 -> j2500246819;
	j3196387877 [label="Oui ! Так же и я. С каждым днём он становится чуть менее невыносимым.",shape=box,color=blue];
		j3196387877 -> j3348449395;
	j3162132034 [label="Теперь это уже я дразню тебя, не переживай. Но в любом случае, je suis ravie! И с нетерпением жду, чтобы узнать эти новые… romantique обычаи.",shape=box,color=blue];
		j3162132034 -> j1007493484;
	j1764833621 [label="Ха! Я знаю, когда ты ведёшь себя нехорошо. Что ж. С нетерпением этого жду.",shape=box,color=blue];
		j1764833621 -> j1007493484;
	j2500246819 [label="Думаю, мне было бы грустно, если бы его не стало.",shape=box,color=blue];
		j2500246819 -> "Chat ends.";
	j1007493484 [label="+10 Chemistry",color=orange];
		j1007493484 -> j787058162;
	j787058162 [label="До тех пор? À la revoyure, mon cœur.",shape=box,color=blue];
		j787058162 -> j1559150062;
	j1559150062 [label="Boolean MarieDating is now true.",color=orange];
		j1559150062 -> j264962945;
