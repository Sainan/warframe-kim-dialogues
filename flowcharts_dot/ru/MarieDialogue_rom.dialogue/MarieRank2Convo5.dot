digraph {
	"MarieRank2Convo5 begins." [color=orange];
		"MarieRank2Convo5 begins." -> j1631090094;
	j1631090094 [label="Evaluate expressions",color=orange];
		j1631090094 -> j737039483 [label="MarieOtak1",color=purple];
		j1631090094 -> j4238883093 [label="MarieFamily1",color=purple];
		j1631090094 -> j2371596825 [label="false",color=purple];
	j737039483 [label="Я размышляла над твоими словами о Monsieur Отаке.",shape=box,color=blue];
		j737039483 -> j741678469;
	j4238883093 [label="Я размышляла над твоими словами о семье le Cardinal.",shape=box,color=blue];
		j4238883093 -> j3308977531;
	j2371596825 [label="Я снова пришла с вопросом насчёт Monsieur «Некралоида», если позволишь?",shape=box,color=blue];
		j2371596825 -> j2697758900;
		j2371596825 -> j1310452999;
	j741678469 [label="Мне было интересно, не похожа ли она на одну из моих собственных историй. Могу я рассказать её, если у тебя есть время?",shape=box,color=blue];
		j741678469 -> j833269170;
		j741678469 -> j1310452999;
	j3308977531 [label="Мне было интересно, не расскажешь ли историю Отака, детского лица на затылке Некралоидa?",shape=box,color=blue];
		j3308977531 -> j906981279;
		j3308977531 -> j2105912725;
	j2697758900 [label="Да, конечно. Что за вопрос?",shape=box,color=red];
		j2697758900 -> j580626520;
	j1310452999 [label="[Конец.]",shape=box,color=red];
		j1310452999 -> "Chat ends.";
	j833269170 [label="Давай.",shape=box,color=red];
		j833269170 -> j4185955524;
	j906981279 [label="Конечно.",shape=box,color=red];
		j906981279 -> j3557725345;
	j2105912725 [label="Может позже. [Завершить]",shape=box,color=red];
		j2105912725 -> "Chat ends.";
	j580626520 [label="Мне любопытно, почему у него на спине есть ещё одно лицо, похожее на детские каракули.",shape=box,color=blue];
		j580626520 -> j1561917230;
	"Chat ends." [color=orange];
	j4185955524 [label="В соборе жила сестра, которая однажды заблудилась в коридорах своего прошлого. Сестра Cécilia.",shape=box,color=blue];
		j4185955524 -> j3672401827;
	j3557725345 [label="По всем данным, он был гением и умом, стоящим за освоением кристаллов аргона.",shape=box,color=red];
		j3557725345 -> j2232037397;
	j1561917230 [label="Я расспросила Monsieur Некралоида и Monsieur Лойда, но ни один из них не пожелал об этом говорить, они лишь назвали мне имя, Отак. И произнесли они его с большой печалью.",shape=box,color=blue];
		j1561917230 -> j4135943619;
	j3672401827 [label="Она обычно стояла перед большими часами в холле и объявляла, что сейчас два часа дня, но она не знала, который час.",shape=box,color=blue];
		j3672401827 -> j3091350352;
	j2232037397 [label="Которые извлекаются из Бездны, именно благодаря им мы можем создавать множество мощных варфреймов и оружия.",shape=box,color=red];
		j2232037397 -> j4116553732;
	j4135943619 [label="И вот я здесь, разговариваю с тобой в надежде, что ты сможешь мне помочь.",shape=box,color=blue];
		j4135943619 -> j1779932902;
		j4135943619 -> j1995574329;
	j3091350352 [label="Мы находили все картины в коридорах повёрнутыми не в ту сторону, и она говорила, что они шепчут ей об ужасных заговорах.",shape=box,color=blue];
		j3091350352 -> j3077655924;
	j4116553732 [label="Он специализировался на кристаллографии. И его работы хранились здесь, в лабораториях.",shape=box,color=red];
		j4116553732 -> j47534097;
	j1779932902 [label="Хочешь узнать об Отаке? Или почему ты не можешь с ним говорить?",shape=box,color=red];
		j1779932902 -> j2823232274;
	j1995574329 [label="Отака трудно объяснить...",shape=box,color=red];
		j1995574329 -> j2100059297;
	j3077655924 [label="Мы узнали, что она просто слышала разговоры из других комнат и думала, что это говорят картины...",shape=box,color=blue];
		j3077655924 -> j176175148;
	j47534097 [label="По какой-то причине, я не знаю, его превратили в Цефалона и дали ему собственную некралоидную оболочку.",shape=box,color=red];
		j47534097 -> j4168886033;
	j2823232274 [label="Я полагаю, что со временем хочу узнать и то, и другое, но позволю решать тебе, с чего начать. Я не знаю, что важнее, après tout.",shape=box,color=blue];
		j2823232274 -> j2100059297;
	j2100059297 [label="Check boolean LoidFamilyComplete",color=orange];
		j2100059297 -> j541005225 [label=true,color=green];
		j2100059297 -> j541005225 [label=false,color=brown];
		j2100059297 -> j2023211074 [label=false,color=brown];
	j176175148 [label="Однажды она приняла все подушки в гостиной за детей и устроила для них чаепитие...",shape=box,color=blue];
		j176175148 -> j2018690697;
	j4168886033 [label="Не все Цефалоны были созданы в наказание. Но здесь, на Деймосе, дела пошли... плохо, и он был серьёзно повреждён.",shape=box,color=red];
		j4168886033 -> j3737871929;
	j541005225 [label="Раньше Отак был архимедиан, учёным и академиком Орокин. То, что с ним произошло, нельзя назвать особенно радостной историей.",shape=box,color=red];
		j541005225 -> j2975737090;
	j2023211074 [label="Ну... короче говоря, некоторые из семьи Энтрати находятся наверху, и они... не совсем знают, что мы здесь, внизу.",shape=box,color=red];
		j2023211074 -> j1912138652;
	j2018690697 [label="Когда я вошла в комнату, она подняла на меня глаза и сказала: «О, сестра Одетта, вот вы где! Дети из приюта пришли, присоединитесь ко мне?»",shape=box,color=blue];
		j2018690697 -> j1051653770;
		j2018690697 -> j4138681417;
	j3737871929 [label="+5 Chemistry",color=orange];
		j3737871929 -> j174653061;
	j2975737090 [label="Boolean MarieOtak1 is now true.",color=orange];
		j2975737090 -> j3767993325;
	j1912138652 [label="Boolean MarieFamily1 is now true.",color=orange];
		j1912138652 -> j420961385;
	j1051653770 [label="Что ты сделала?",shape=box,color=red];
		j1051653770 -> j587642662;
	j4138681417 [label="Кем была сестра Одетта?",shape=box,color=red];
		j4138681417 -> j2316226189;
	j174653061 [label="Pauvre petit...",shape=box,color=blue];
		j174653061 -> j932212562;
	j3767993325 [label="Par les Luminaires... пожалуйста, продолжай.",shape=box,color=blue];
		j3767993325 -> j3557725345;
	j420961385 [label="Par les Luminaires... Ты имеешь в виду, что мы все здесь, внизу, в тайне?! Так вот почему нам не разрешают покидать это место?! Mais pourquoi?!",shape=box,color=blue];
		j420961385 -> j3438360531;
	j587642662 [label="Я подъехала на своём кресле к пустому месту за столом и выпила с ней и подушками чай, что ещё я могла сделать?",shape=box,color=blue];
		j587642662 -> j420079282;
	j2316226189 [label="Боюсь, сестра Одетта умерла уже тридцать лет назад.",shape=box,color=blue];
		j2316226189 -> j3757077053;
	j932212562 [label="Итак, его перевели к основному некралоиду, единственному оставшемуся некралоиду - и он... ну? Сложно объяснить.",shape=box,color=red];
		j932212562 -> j388192468;
		j932212562 -> j3074092085;
		j932212562 -> j2153496944;
	j3438360531 [label="Его дочь, Эйлерия, известная как Мать, и её семья всё это время заботились о Деймосе.",shape=box,color=red];
		j3438360531 -> j1000041154;
	j420079282 [label="Как мы смеялись вместе, когда она рассказывала мне истории из своего прошлого. Истории, которые сестра Cécilia никогда раньше никому не рассказывала, по крайней мере, насколько я знаю.",shape=box,color=blue];
		j420079282 -> j1644884089;
	j3757077053 [label="Я подъехала на своём кресле к пустому месту за столом и выпила с ней и подушками чай.",shape=box,color=blue];
		j3757077053 -> j420079282;
	j388192468 [label="Честно говоря, мне бы хотелось его вылечить. Верните настоящего Отака.",shape=box,color=red];
		j388192468 -> j4185955524;
	j3074092085 [label="Он заставляет меня улыбаться. Он забавный, но за этим скрывается что‑то трагичное и сломленное.",shape=box,color=red];
		j3074092085 -> j4185955524;
	j2153496944 [label="К сожалению, его уже не вылечить. И, думаю, он сильно действует на нервы многим. ",shape=box,color=red];
		j2153496944 -> j4185955524;
	j1000041154 [label="Присматривали за этим местом и за сердцем, что гонит энергию Бездны в Изначальную Систему, удерживая всех нас... в рабочем состоянии, с тех пор как исчез Энтрати.",shape=box,color=red];
		j1000041154 -> j3850907693;
	j1644884089 [label="Её глаза порой сияли, а порой тускнели, как у детской куклы...",shape=box,color=blue];
		j1644884089 -> j1468739451;
		j1644884089 -> j3509020746;
		j1644884089 -> j3695690235;
		j1644884089 -> j3465527528;
	j3850907693 [label="Check /Lotus/Scripts/1999/DialogueScriptNodes.lua:IsSyndicateRank",color=orange];
		j3850907693 -> j2551559120 [label=true,color=green];
		j3850907693 -> j2874892276 [label=false,color=brown];
	j1468739451 [label="Почему ты сидела с ней?",shape=box,color=red];
		j1468739451 -> j2269007770;
	j3509020746 [label="Что случилось с сестрой Cécilia?",shape=box,color=red];
		j3509020746 -> j3808005098;
	j3695690235 [label="Хочется верить, что для неё имело значение то, что ты была рядом.",shape=box,color=red];
		j3695690235 -> j2633484602;
	j3465527528 [label="Это было очень мило с твоей стороны, посидеть с ней.",shape=box,color=red];
		j3465527528 -> j2028505857;
	j2551559120 [label="Она смирилась с его отсутствием, и они примирились друг с другом, но это далось им нелегко.",shape=box,color=red];
		j2551559120 -> j3421374363;
	j2874892276 [label="Она не может смириться с его отсутствием, и они готовы вцепиться друг другу в глотки.",shape=box,color=red];
		j2874892276 -> j366086718;
	j2269007770 [label="+15 Chemistry",color=orange];
		j2269007770 -> j1446806763;
	j3808005098 [label="Что происходит со всеми в её состоянии? Она продолжала угасать, словно картина на солнце, пока не осталось ничего. ",shape=box,color=blue];
		j3808005098 -> j3948927223;
	j2633484602 [label="+10 Chemistry",color=orange];
		j2633484602 -> j3209267097;
	j2028505857 [label="+5 Chemistry",color=orange];
		j2028505857 -> j2746302922;
	j3421374363 [label="Зная, что он все еще где-то там, творит, и что он не сказал ей ни слова и даже не отправил письма...?",shape=box,color=red];
		j3421374363 -> j351542500;
	j366086718 [label="Зная, что он все еще где-то там, творит, и что он не сказал ей ни слова и даже не отправил письма...?",shape=box,color=red];
		j366086718 -> j732307869;
	j1446806763 [label="Мудрый вопрос. Очень мудрый вопрос. Думаю, меня вдохновило множество причин. Я хотела бы думать, что это была доброта, которая привела меня к её столу.",shape=box,color=blue];
		j1446806763 -> j2031485423;
	j3948927223 [label="А потом она ушла от нас, и мы устроили для неё вечер памяти при свечах. Я бы хотела, чтобы в конце концов она смогла вспомнить тех, кто был по-настоящему добр к ней. ",shape=box,color=blue];
		j3948927223 -> j4251045301;
	j3209267097 [label="Мне хотелось бы верить, что где-то в глубине души она это поняла.",shape=box,color=blue];
		j3209267097 -> j4251045301;
	j2746302922 [label="Но была ли это доброта? Или это чувство вины заставило меня так поступить? Ах, но ты проявляешь доброту сам, говоря это. ",shape=box,color=blue];
		j2746302922 -> j4251045301;
	j351542500 [label="Не могу представить, как это больно для неё. Для них обоих.",shape=box,color=red];
		j351542500 -> j2517039325;
	j732307869 [label="Это уничтожило бы ту малую надежду на примирение, которая у них могла бы быть.",shape=box,color=red];
		j732307869 -> j1812405471;
	j2031485423 [label="Но, думаю, в глубине души это было чувство вины. Что если бы я этого не сделала, я бы пренебрегла ею. Как пренебрегают ребёнком.",shape=box,color=blue];
		j2031485423 -> j4251045301;
	j4251045301 [label="Я хотела бы верить, что твой Отак чувствует тех, кто добр и терпелив с ним. Но, с другой стороны, его ведь на самом деле нет, не так ли?",shape=box,color=blue];
		j4251045301 -> j160871290;
	j2517039325 [label="Хотя я понимаю логику решения защитить их от боли, причинённой le Cardinal его неизбежным уходом...",shape=box,color=blue];
		j2517039325 -> j1857727863;
	j1812405471 [label="+10 Chemistry",color=orange];
		j1812405471 -> j1505720466;
	j160871290 [label="Я говорю о весьма сложном устройстве, созданном, чтобы напоминать человека, не так ли? О фонографе, во много-много раз более сложном. Как и у Некралоида, у него нет души.",shape=box,color=blue];
		j160871290 -> j1407645897;
		j160871290 -> j1350490518;
		j160871290 -> j274665703;
		j160871290 -> j102835162;
		j160871290 -> j720666048;
	j1857727863 [label="Я считаю это неоправданно жестоким, не так ли? Они могут подумать, что он мёртв. Или ещё хуже! А мы, живущие здесь, comme des rats d'égout?",shape=box,color=blue];
		j1857727863 -> j3758187207;
		j1857727863 -> j955467016;
	j1505720466 [label="Oui... Я понимаю логику. Тогда ты бы попытался примирить их семью, не так ли? Похоже, это единственная надежда для всех нас выбраться из этого места. ",shape=box,color=blue];
		j1505720466 -> j1415652102;
	j1407645897 [label="У Некралоида, может, и нет души, но он уникален. У других Цефалонов, например, Отака, она есть. Они были уничтожены ещё в том виде, в каком были созданы.",shape=box,color=red];
		j1407645897 -> j455274143;
	j1350490518 [label="Ты права. Так что же мне с этим делать?",shape=box,color=red];
		j1350490518 -> j2824631778;
	j274665703 [label="Ты права. Они не такие. Но это не значит, что мы можем обращаться с ними плохо.",shape=box,color=red];
		j274665703 -> j1570426852;
	j102835162 [label="Не знаю, права ты или нет. Но они всё ещё могут думать и чувствовать, и мы не можем обращаться с ними как с вещами.",shape=box,color=red];
		j102835162 -> j1531640605;
	j720666048 [label="У некралоидов есть душа. У всех Цефалонов она есть.",shape=box,color=red];
		j720666048 -> j1866757344;
	j3758187207 [label="На самом деле, это не мое решение.",shape=box,color=red];
		j3758187207 -> j2928049233;
	j955467016 [label="У меня есть друг, который обожает крыс. Я считаю их очаровательными.",shape=box,color=red];
		j955467016 -> j3716953159;
	j1415652102 [label="Чтобы нам не провести остаток жизни здесь, comme des rats d'égout. ",shape=box,color=blue];
		j1415652102 -> j1153868675;
		j1415652102 -> j2040463247;
	j455274143 [label="Boolean MarieCephalonSoul is now true.",color=orange];
		j455274143 -> j2191194731;
	j2824631778 [label="Boolean MarieCephalonNoSoul is now true.",color=orange];
		j2824631778 -> j1498212732;
	j1570426852 [label="Boolean MarieCephalonNoSoul is now true.",color=orange];
		j1570426852 -> j388308836;
	j1531640605 [label="Boolean MarieCephalonUnsure is now true.",color=orange];
		j1531640605 -> j4078853232;
	j1866757344 [label="Boolean MarieCephalonSoul is now true.",color=orange];
		j1866757344 -> j2569756437;
	j2928049233 [label="Я знаю. Это решение Monsieur Лойда и всех остальных, дать о себе знать.",shape=box,color=blue];
		j2928049233 -> j801881132;
	j3716953159 [label="+15 Chemistry",color=orange];
		j3716953159 -> j2579477569;
	j1153868675 [label="Это была моя небрежность. Ты права. Пора браться за дело.",shape=box,color=red];
		j1153868675 -> j429468182;
	j2040463247 [label="У меня есть друг, который обожает крыс. Я считаю их очаровательными. ",shape=box,color=red];
		j2040463247 -> j3801904360;
	j2191194731 [label="+5 Chemistry",color=orange];
		j2191194731 -> j3661258589;
	j1498212732 [label="О, не думай, что я призываю к жестокости! Нет! Береги их, ибо они драгоценны, и не по своей вине они стали такими, какие они есть!",shape=box,color=blue];
		j1498212732 -> j3653092795;
	j388308836 [label="+5 Chemistry",color=orange];
		j388308836 -> j1498212732;
	j4078853232 [label="+5 Chemistry",color=orange];
		j4078853232 -> j4028981711;
	j2569756437 [label="+5 Chemistry",color=orange];
		j2569756437 -> j2370149241;
	j801881132 [label="Я бы предположила, что именно чувство вины, а не благородства, удерживает нас здесь.",shape=box,color=blue];
		j801881132 -> j3028448574;
	j2579477569 [label="И мне бы очень хотелось когда-нибудь с ними встретиться, но это не то, о чем я говорю, глупый волк.",shape=box,color=blue];
		j2579477569 -> j801881132;
	j429468182 [label="+5 Chemistry",color=orange];
		j429468182 -> j3541435727;
	j3801904360 [label="+5 Chemistry",color=orange];
		j3801904360 -> j2579477569;
	j3661258589 [label="Ещё одно доказательство того, что дьявол и ему подобные были справедливо осуждены. Но, возможно, ты прав насчёт Отака и ему подобных, или, возможно, тебе становится спокойнее от этой мысли.",shape=box,color=blue];
		j3661258589 -> j2274790124;
	j3653092795 [label="Сердце моё разрывается лишь от вида изломанных тел, оставленных демонами Орокин. Они были не богами, а пожирателями всего на своём пути. Взгляните хотя бы на того, с кем мы идём, чтобы убедиться в этом.",shape=box,color=blue];
		j3653092795 -> j2114758688;
	j4028981711 [label="Возможно, в том есть правда, но я не думаю, что демоны Орокин знали о механизмах души больше, чем мы. Они не были великими богами.",shape=box,color=blue];
		j4028981711 -> j158394794;
	j2370149241 [label="Возможно, это правда, а может быть, такая вера приносит умиротворение.",shape=box,color=blue];
		j2370149241 -> j2114758688;
