digraph {
	735 [label="MarieRank2Convo5 begins.",color=orange];
		735 -> 736;
	736 [label="Evaluate expressions",color=orange];
		736 -> 739 [label="MarieOtak1",color=purple];
		736 -> 738 [label="MarieFamily1",color=purple];
		736 -> 737 [label="false",color=purple];
	739 [label="Я размышляла над твоими словами о Monsieur Отаке.",shape=box,color=blue];
		739 -> 743;
	738 [label="Я размышляла над твоими словами о семье le Cardinal.",shape=box,color=blue];
		738 -> 742;
	737 [label="Я снова пришла с вопросом насчёт Monsieur «Некралоида», если позволишь?",shape=box,color=blue];
		737 -> 741;
		737 -> 740;
	743 [label="Мне было интересно, не похожа ли она на одну из моих собственных историй. Могу я рассказать её, если у тебя есть время?",shape=box,color=blue];
		743 -> 749;
		743 -> 748;
	742 [label="Мне было интересно, не расскажешь ли историю Отака, детского лица на затылке Некралоидa?",shape=box,color=blue];
		742 -> 747;
		742 -> 746;
	741 [label="Да, конечно. Что за вопрос?",shape=box,color=red];
		741 -> 745;
	740 [label="[Конец.]",shape=box,color=red];
		740 -> 744;
	749 [label="Давай.",shape=box,color=red];
		749 -> 754;
	748 [label="[Конец.]",shape=box,color=red];
		748 -> 753;
	747 [label="Конечно.",shape=box,color=red];
		747 -> 752;
	746 [label="Может позже. [Завершить]",shape=box,color=red];
		746 -> 751;
	745 [label="Мне любопытно, почему у него на спине есть ещё одно лицо, похожее на детские каракули.",shape=box,color=blue];
		745 -> 750;
	744 [label="Chat ends.",color=orange];
	754 [label="В соборе жила сестра, которая однажды заблудилась в коридорах своего прошлого. Сестра Cécilia.",shape=box,color=blue];
		754 -> 757;
	753 [label="Chat ends.",color=orange];
	752 [label="По всем данным, он был гением и умом, стоящим за освоением кристаллов аргона.",shape=box,color=red];
		752 -> 756;
	751 [label="Chat ends.",color=orange];
	750 [label="Я расспросила Monsieur Некралоида и Monsieur Лойда, но ни один из них не пожелал об этом говорить, они лишь назвали мне имя, Отак. И произнесли они его с большой печалью.",shape=box,color=blue];
		750 -> 755;
	757 [label="Она обычно стояла перед большими часами в холле и объявляла, что сейчас два часа дня, но она не знала, который час.",shape=box,color=blue];
		757 -> 761;
	756 [label="Которые извлекаются из Бездны, именно благодаря им мы можем создавать множество мощных варфреймов и оружия.",shape=box,color=red];
		756 -> 760;
	755 [label="И вот я здесь, разговариваю с тобой в надежде, что ты сможешь мне помочь.",shape=box,color=blue];
		755 -> 758;
		755 -> 759;
	761 [label="Мы находили все картины в коридорах повёрнутыми не в ту сторону, и она говорила, что они шепчут ей об ужасных заговорах.",shape=box,color=blue];
		761 -> 766;
	760 [label="Он специализировался на кристаллографии. И его работы хранились здесь, в лабораториях.",shape=box,color=red];
		760 -> 765;
	758 [label="Хочешь узнать об Отаке? Или почему ты не можешь с ним говорить?",shape=box,color=red];
		758 -> 762;
	759 [label="Отака трудно объяснить...",shape=box,color=red];
		759 -> 2919;
	766 [label="Мы узнали, что она просто слышала разговоры из других комнат и думала, что это говорят картины...",shape=box,color=blue];
		766 -> 770;
	765 [label="По какой-то причине, я не знаю, его превратили в Цефалона и дали ему собственную некралоидную оболочку.",shape=box,color=red];
		765 -> 769;
	762 [label="Я полагаю, что со временем хочу узнать и то, и другое, но позволю решать тебе, с чего начать. Я не знаю, что важнее, après tout.",shape=box,color=blue];
		762 -> 2919;
	2919 [label="Check boolean LoidFamilyComplete",color=orange];
		2919 -> 764 [label=true,color=green];
		2919 -> 764 [label=false,color=brown];
		2919 -> 763 [label=false,color=brown];
	770 [label="Однажды она приняла все подушки в гостиной за детей и устроила для них чаепитие...",shape=box,color=blue];
		770 -> 774;
	769 [label="Не все Цефалоны были созданы в наказание. Но здесь, на Деймосе, дела пошли... плохо, и он был серьёзно повреждён.",shape=box,color=red];
		769 -> 773;
	764 [label="Раньше Отак был архимедиан, учёным и академиком Орокин. То, что с ним произошло, нельзя назвать особенно радостной историей.",shape=box,color=red];
		764 -> 768;
	763 [label="Ну... короче говоря, некоторые из семьи Энтрати находятся наверху, и они... не совсем знают, что мы здесь, внизу.",shape=box,color=red];
		763 -> 767;
	774 [label="Когда я вошла в комнату, она подняла на меня глаза и сказала: «О, сестра Одетта, вот вы где! Дети из приюта пришли, присоединитесь ко мне?»",shape=box,color=blue];
		774 -> 777;
		774 -> 778;
	773 [label="+5 Chemistry",color=orange];
		773 -> 776;
	768 [label="Update boolean MarieOtak1",color=orange];
		768 -> 772;
	767 [label="Update boolean MarieFamily1",color=orange];
		767 -> 771;
	777 [label="Что ты сделала?",shape=box,color=red];
		777 -> 781;
	778 [label="Кем была сестра Одетта?",shape=box,color=red];
		778 -> 782;
	776 [label="Pauvre petit...",shape=box,color=blue];
		776 -> 780;
	772 [label="Par les Luminaires... пожалуйста, продолжай.",shape=box,color=blue];
		772 -> 752;
	771 [label="Par les Luminaires... Ты имеешь в виду, что мы все здесь, внизу, в тайне?! Так вот почему нам не разрешают покидать это место?! Mais pourquoi?!",shape=box,color=blue];
		771 -> 775;
	781 [label="Я подъехала на своём кресле к пустому месту за столом и выпила с ней и подушками чай, что ещё я могла сделать?",shape=box,color=blue];
		781 -> 787;
	782 [label="Боюсь, сестра Одетта умерла уже тридцать лет назад.",shape=box,color=blue];
		782 -> 788;
	780 [label="Итак, его перевели к основному некралоиду, единственному оставшемуся некралоиду - и он... ну? Сложно объяснить.",shape=box,color=red];
		780 -> 784;
		780 -> 785;
		780 -> 786;
	775 [label="Его дочь, Эйлерия, известная как Мать, и её семья всё это время заботились о Деймосе.",shape=box,color=red];
		775 -> 779;
	787 [label="Как мы смеялись вместе, когда она рассказывала мне истории из своего прошлого. Истории, которые сестра Cécilia никогда раньше никому не рассказывала, по крайней мере, насколько я знаю.",shape=box,color=blue];
		787 -> 791;
	788 [label="Я подъехала на своём кресле к пустому месту за столом и выпила с ней и подушками чай.",shape=box,color=blue];
		788 -> 787;
	784 [label="Честно говоря, мне бы хотелось его вылечить. Верните настоящего Отака.",shape=box,color=red];
		784 -> 754;
	785 [label="Он заставляет меня улыбаться. Он забавный, но за этим скрывается что‑то трагичное и сломленное.",shape=box,color=red];
		785 -> 754;
	786 [label="К сожалению, его уже не вылечить. И, думаю, он сильно действует на нервы многим. ",shape=box,color=red];
		786 -> 754;
	779 [label="Присматривали за этим местом и за сердцем, что гонит энергию Бездны в Изначальную Систему, удерживая всех нас... в рабочем состоянии, с тех пор как исчез Энтрати.",shape=box,color=red];
		779 -> 783;
	791 [label="Её глаза порой сияли, а порой тускнели, как у детской куклы...",shape=box,color=blue];
		791 -> 794;
		791 -> 795;
		791 -> 796;
		791 -> 797;
	783 [label="Check /Lotus/Scripts/1999/DialogueScriptNodes.lua:IsSyndicateRank",color=orange];
		783 -> 789 [label=true,color=green];
		783 -> 790 [label=false,color=brown];
	794 [label="Почему ты сидела с ней?",shape=box,color=red];
		794 -> 800;
	795 [label="Что случилось с сестрой Cécilia?",shape=box,color=red];
		795 -> 801;
	796 [label="Хочется верить, что для неё имело значение то, что ты была рядом.",shape=box,color=red];
		796 -> 802;
	797 [label="Это было очень мило с твоей стороны, посидеть с ней.",shape=box,color=red];
		797 -> 803;
	789 [label="Она смирилась с его отсутствием, и они примирились друг с другом, но это далось им нелегко.",shape=box,color=red];
		789 -> 792;
	790 [label="Она не может смириться с его отсутствием, и они готовы вцепиться друг другу в глотки.",shape=box,color=red];
		790 -> 793;
	800 [label="+15 Chemistry",color=orange];
		800 -> 806;
	801 [label="Что происходит со всеми в её состоянии? Она продолжала угасать, словно картина на солнце, пока не осталось ничего. ",shape=box,color=blue];
		801 -> 807;
	802 [label="+10 Chemistry",color=orange];
		802 -> 808;
	803 [label="+5 Chemistry",color=orange];
		803 -> 809;
	792 [label="Зная, что он все еще где-то там, творит, и что он не сказал ей ни слова и даже не отправил письма...?",shape=box,color=red];
		792 -> 798;
	793 [label="Зная, что он все еще где-то там, творит, и что он не сказал ей ни слова и даже не отправил письма...?",shape=box,color=red];
		793 -> 799;
	806 [label="Мудрый вопрос. Очень мудрый вопрос. Думаю, меня вдохновило множество причин. Я хотела бы думать, что это была доброта, которая привела меня к её столу.",shape=box,color=blue];
		806 -> 812;
	807 [label="А потом она ушла от нас, и мы устроили для неё вечер памяти при свечах. Я бы хотела, чтобы в конце концов она смогла вспомнить тех, кто был по-настоящему добр к ней. ",shape=box,color=blue];
		807 -> 813;
	808 [label="I would like to believe that she understood, somewhere beneath the surface.",shape=box,color=blue];
		808 -> 813;
	809 [label="Но была ли это доброта? Или это чувство вины заставило меня так поступить? Ах, но ты проявляешь доброту сам, говоря это. ",shape=box,color=blue];
		809 -> 813;
	798 [label="Не могу представить, как это больно для неё. Для них обоих.",shape=box,color=red];
		798 -> 804;
	799 [label="Это уничтожило бы ту малую надежду на примирение, которая у них могла бы быть.",shape=box,color=red];
		799 -> 805;
	812 [label="Но, думаю, в глубине души это было чувство вины. Что если бы я этого не сделала, я бы пренебрегла ею. Как пренебрегают ребёнком.",shape=box,color=blue];
		812 -> 813;
	813 [label="Я хотела бы верить, что твой Отак чувствует тех, кто добр и терпелив с ним. Но, с другой стороны, его ведь на самом деле нет, не так ли?",shape=box,color=blue];
		813 -> 817;
	804 [label="Хотя я понимаю логику решения защитить их от боли, причинённой le Cardinal его неизбежным уходом...",shape=box,color=blue];
		804 -> 810;
	805 [label="+10 Chemistry",color=orange];
		805 -> 811;
	817 [label="Я говорю о весьма сложном устройстве, созданном, чтобы напоминать человека, не так ли? О фонографе, во много-много раз более сложном. Как и у Некралоида, у него нет души.",shape=box,color=blue];
		817 -> 822;
		817 -> 823;
		817 -> 824;
		817 -> 825;
		817 -> 826;
	810 [label="Я считаю это неоправданно жестоким, не так ли? Они могут подумать, что он мёртв. Или ещё хуже! А мы, живущие здесь, comme des rats d'égout?",shape=box,color=blue];
		810 -> 814;
		810 -> 815;
	811 [label="Oui... Я понимаю логику. Тогда ты бы попытался примирить их семью, не так ли? Похоже, это единственная надежда для всех нас выбраться из этого места. ",shape=box,color=blue];
		811 -> 816;
	822 [label="У Некралоида, может, и нет души, но он уникален. У других Цефалонов, например, Отака, она есть. Они были уничтожены ещё в том виде, в каком были созданы.",shape=box,color=red];
		822 -> 831;
	823 [label="Ты права. Так что же мне с этим делать?",shape=box,color=red];
		823 -> 832;
	824 [label="Ты права. Они не такие. Но это не значит, что мы можем обращаться с ними плохо.",shape=box,color=red];
		824 -> 833;
	825 [label="Не знаю, права ты или нет. Но они всё ещё могут думать и чувствовать, и мы не можем обращаться с ними как с вещами.",shape=box,color=red];
		825 -> 834;
	826 [label="У некралоидов есть душа. У всех Цефалонов она есть.",shape=box,color=red];
		826 -> 835;
	814 [label="На самом деле, это не мое решение.",shape=box,color=red];
		814 -> 818;
	815 [label="У меня есть друг, который обожает крыс. Я считаю их очаровательными.",shape=box,color=red];
		815 -> 819;
	816 [label="Чтобы нам не провести остаток жизни здесь, comme des rats d'égout. ",shape=box,color=blue];
		816 -> 820;
		816 -> 821;
	831 [label="Update boolean MarieCephalonSoul",color=orange];
		831 -> 839;
	832 [label="Update boolean MarieCephalonNoSoul",color=orange];
		832 -> 840;
	833 [label="Update boolean MarieCephalonNoSoul",color=orange];
		833 -> 841;
	834 [label="Update boolean MarieCephalonUnsure",color=orange];
		834 -> 842;
	835 [label="Update boolean MarieCephalonSoul",color=orange];
		835 -> 843;
	818 [label="Я знаю. Это решение Monsieur Лойда и всех остальных, дать о себе знать.",shape=box,color=blue];
		818 -> 827;
	819 [label="+15 Chemistry",color=orange];
		819 -> 828;
	820 [label="Это была моя небрежность. Ты права. Пора браться за дело.",shape=box,color=red];
		820 -> 829;
	821 [label="У меня есть друг, который обожает крыс. Я считаю их очаровательными. ",shape=box,color=red];
		821 -> 830;
	839 [label="+5 Chemistry",color=orange];
		839 -> 845;
	840 [label="О, не думай, что я призываю к жестокости! Нет! Береги их, ибо они драгоценны, и не по своей вине они стали такими, какие они есть!",shape=box,color=blue];
		840 -> 846;
	841 [label="+5 Chemistry",color=orange];
		841 -> 840;
	842 [label="+5 Chemistry",color=orange];
		842 -> 847;
	843 [label="+5 Chemistry",color=orange];
		843 -> 848;
	827 [label="Я бы предположила, что именно чувство вины, а не благородства, удерживает нас здесь.",shape=box,color=blue];
		827 -> 836;
	828 [label="И мне бы очень хотелось когда-нибудь с ними встретиться, но это не то, о чем я говорю, глупый волк.",shape=box,color=blue];
		828 -> 827;
	829 [label="+5 Chemistry",color=orange];
		829 -> 837;
	830 [label="+5 Chemistry",color=orange];
		830 -> 838;
	845 [label="Ещё одно доказательство того, что дьявол и ему подобные были справедливо осуждены. Но, возможно, ты прав насчёт Отака и ему подобных, или, возможно, тебе становится спокойнее от этой мысли.",shape=box,color=blue];
		845 -> 850;
	846 [label="Сердце моё разрывается лишь от вида изломанных тел, оставленных демонами Орокин. Они были не богами, а пожирателями всего на своём пути. Взгляните хотя бы на того, с кем мы идём, чтобы убедиться в этом.",shape=box,color=blue];
		846 -> 851;
	847 [label="Возможно, в том есть правда, но я не думаю, что демоны Орокин знали о механизмах души больше, чем мы. Они не были великими богами.",shape=box,color=blue];
		847 -> 852;
	848 [label="Возможно, это правда, а может быть, такая вера приносит умиротворение.",shape=box,color=blue];
		848 -> 851;
	836 [label="Что мы скрываем какой-то большой и страшный грех.",shape=box,color=blue];
		836 -> 844;
	837 [label="Спасибо. Не знаю, получится ли у тебя, но иногда нам остаётся только попытаться.",shape=box,color=blue];
		837 -> 827;
	838 [label="И мне бы очень хотелось когда-нибудь с ними встретиться, но это не то, о чем я говорю, глупый волк.",shape=box,color=blue];
		838 -> 827;
	850 [label="В любом случае, я предпочитаю верить, что Отак, умерший давным-давно, улыбнулся бы сейчас тому, кто был бы добр к тому, что живёт в его памяти.",shape=box,color=blue];
		850 -> 2920;
	851 [label="Мне просто трудно сказать, что у Некралоида есть душа, когда Лойд стоит прямо рядом с ним, oui?",shape=box,color=blue];
		851 -> 850;
	852 [label="Технологии, возможно, наука - да, но душа? Они вряд ли могли совладать со своими сердцами! Взгляни на дьявола, с которым мы путешествуем, если тебе нужны ещё доказательства.",shape=box,color=blue];
		852 -> 851;
	844 [label="И именно этот грех должен быть прощён.",shape=box,color=blue];
		844 -> 849;
	2920 [label="Check boolean LoidFamilyComplete",color=orange];
		2920 -> 2921 [label=true,color=green];
		2920 -> 854 [label=false,color=brown];
	849 [label="Спасибо, ты дал мне много пищи для размышлений. À la revoyure.",shape=box,color=blue];
		849 -> 853;
	2921 [label="Мне пора идти. Но, merci. Мне нужно о многом подумать.",shape=box,color=blue];
		2921 -> 2922;
	854 [label="Я просто надеюсь, что когда-нибудь, когда Monsieur Некралоид снова поднимется наверх, мне удастся встретить то странное fac-similé, что живёт в нём.",shape=box,color=blue];
		854 -> 855;
		854 -> 856;
	853 [label="Chat ends.",color=orange];
	2922 [label="Chat ends.",color=orange];
	855 [label="Не считаю разумным вмешиваться в чужие дела.",shape=box,color=red];
		855 -> 857;
	856 [label="Надеюсь, когда-нибудь мы сможем рассказать семье Энтрати правду. И лучше раньше, чем позже. ",shape=box,color=red];
		856 -> 857;
	857 [label="Check boolean MarieFamily1",color=orange];
		857 -> 858 [label=true,color=green];
		857 -> 859 [label=false,color=brown];
	858 [label="Посмотрим, я хочу узнать больше подробностей о причинах, по которым необходимо оставаться.",shape=box,color=blue];
		858 -> 860;
	859 [label="Кажется, есть история, которую ты мне не рассказываешь. Но, думаю, на сегодня историй уже достаточно, oui?",shape=box,color=blue];
		859 -> 860;
	860 [label="Совсем скоро мы снова поговорим о семье Энтрати.",shape=box,color=blue];
		860 -> 147;
	147 [label="Chat ends.",color=orange];
}