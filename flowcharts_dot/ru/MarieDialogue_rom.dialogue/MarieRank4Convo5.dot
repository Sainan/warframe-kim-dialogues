		1651 -> 1673 [label="MarieEntratiNeutral",color=purple];
		1651 -> 1674 [label="false",color=purple];
	1652 [label="И что же могло тебя отвлечь? Что может быть важнее, чем сесть и разбирать жалобы mécontents?",shape=box,color=blue];
		1652 -> 1676;
	1653 [label="Что может быть сложного в том, чтобы сесть и разобраться с жалобами mécontents?",shape=box,color=blue];
		1653 -> 1677;
	1654 [label="О, magnifique!",shape=box,color=blue];
		1654 -> 1678;
	1655 [label="Chat ends.",color=orange];
	1656 [label="Его дочь, Эйлерия, известная как Мать, и её семья всё это время заботились о Деймосе.",shape=box,color=red];
		1656 -> 1679;
	2937 [label="А что нам мешает просто передвинуть всю мебель, дать им всё заменить, а потом… сделать это снова? Мы могли бы всё продать, получить прибыль с de ce mobilier étrange!",shape=box,color=blue];
		2937 -> 2938;
		2937 -> 2939;
		2937 -> 2940;
	1658 [label="Я прекрасно знаю о наших неразрешённых разногласиях насчёт le Cardinal. Я стараюсь поддерживать civilisée разговор.",shape=box,color=blue];
		1658 -> 1680;
	1661 [label="Я понимаю, что тебе, возможно, не захочется обсуждать вопрос урегулирования разногласий, не найдя возможности указать на тех, кого ты считаешь виновными.",shape=box,color=blue];
		1661 -> 1680;
	1657 [label="Oui! Как ты так часто любишь напоминать мне, ты ведь считаешь его un monstre! В сердце которого лишь злоба и пустота!",shape=box,color=blue];
		1657 -> 1680;
	1659 [label="Я полагала, ты на моей стороне в этой войне за душу le Cardinal?",shape=box,color=blue];
		1659 -> 1681;
	1660 [label="Я полагала, у тебя ещё не было чёткого определения насчёт le Cardinal? Или теперь уже всё изменилось?",shape=box,color=blue];
		1660 -> 1682;
		1660 -> 1683;
	1668 [label="Oui. Этому я учусь у M'sieur Tagfer...",shape=box,color=blue];
		1668 -> 1686;
	1662 [label="Не говори мне о заживших ранах, волк. Я до сих пор зализываю свои после нашей прошлой беседы о le Cardinal.",shape=box,color=blue];
		1662 -> 1680;
	1663 [label="Oui, но тобой уже было сказано это ранее - мы все должны прекратить взаимные обвинения за те раны, что были причинены.",shape=box,color=blue];
		1663 -> 1684;
	1664 [label="Я знаю, ты считаешь le Cardinal каким-то ужасным чудовищем, которое наносит такие страдания.",shape=box,color=blue];
		1664 -> 1680;
	1665 [label="Я знаю, что ты на моей стороне в этой войне за душу le Cardinal, за что я буду вечно благодарна.",shape=box,color=blue];
		1665 -> 1666;
	1667 [label="Я знаю, что суждение о нём пока удерживается, и за это есть огромная признательность.",shape=box,color=blue];
		1667 -> 1666;
	1666 [label="И хотя мне известно, что другие поспешили бы обвинить его, у меня нет желания видеть нас разобщёнными и истекающими кровью, когда возможно единство.",shape=box,color=blue];
		1666 -> 1685;
	1675 [label="Oui, хотя я начинаю понимать - как и с M'sieur Tagfer, что, пожалуй, не всё в равной мере.",shape=box,color=blue];
		1675 -> 1686;
	1669 [label="И мне постепенно приходит понимание, что всё это не в равной мере, как тобою так «любезно» было указано мне, non?",shape=box,color=blue];
		1669 -> 1680;
	1670 [label="Oui, да! Я не виню le Cardinal за его уход, ведь его дело – sacro-saint -",shape=box,color=blue];
		1670 -> 1666;
	1671 [label="И я знаю, ты считаешь le Cardinal каким-то ужасным чудовищем, которое наносит такие страдания.",shape=box,color=blue];
		1671 -> 1680;
	1672 [label="Я знаю, что ты на моей стороне в этой войне за душу le Cardinal, за что я буду вечно благодарна.",shape=box,color=blue];
		1672 -> 1666;
	1673 [label="Я знаю, что суждение о нём пока удерживается, и за это есть огромная признательность.",shape=box,color=blue];
		1673 -> 1666;
	1674 [label="И другие поспешили бы обвинить его в своей боли, у меня просто нет желания видеть нас разобщёнными и страдающими.",shape=box,color=blue];
		1674 -> 1685;
	1676 [label="Я шучу, я же просто дразню! Я не в силах постичь, насколько велика твоя загруженность и сколько мест - и эпох - нуждаются в тебе.",shape=box,color=blue];
		1676 -> 1678;
	1677 [label="Я шучу, я же просто дразню! Я не в силах постичь, через что им пришлось пройти. И как трудно тебе всё это распутать.",shape=box,color=blue];
		1677 -> 1678;
	1678 [label="Я лишь опасаюсь, что без примирения с их бедами, нам не стоит и надеяться быть желанными за их столом. Главная же проблема остаётся нерешённой...",shape=box,color=blue];
		1678 -> 1637;
	1679 [label="Присматривали за этим местом и за сердцем, что гонит энергию Бездны в Изначальную Систему, удерживая всех нас... в рабочем состоянии, с тех пор как исчез Энтрати.",shape=box,color=red];
		1679 -> 1687;
	2938 [label="Что-то мне подсказывает, что стулья Энтрати не особо пользуются спросом...",shape=box,color=red];
		2938 -> 2942;
	2939 [label="Разве мы в конце концов не заполонили бы рынок? Нам пришлось бы продавать их по очень низкой цене...",shape=box,color=red];
		2939 -> 2942;
	2940 [label="Отлично. Не вижу в этом никаких проблем.",shape=box,color=red];
		2940 -> 2941;
	1680 [label="И хотя я понимаю, что эти две темы неразрывно связаны, я попрошу тебя, пусть разговор сегодня будет плодотворным, oui?",shape=box,color=blue];
		1680 -> 1688;
	1681 [label="Что за уловка, волк? Или малышка Мари для тебя всего лишь un jeu?",shape=box,color=blue];
		1681 -> 1689;
		1681 -> 1683;
	1682 [label="Я ещё не приняла решение, насколько оправданы его действия. Но его безжалостность не вызывает сомнений.",shape=box,color=red];
		1682 -> 1680;
	1683 [label="Мне надоело притворяться, прости.",shape=box,color=red];
		1683 -> 1690;
	1686 [label="Мы все должны прекратить взаимные обвинения за те раны, что были причинены.",shape=box,color=blue];
		1686 -> 1684;
	1684 [label="ChatGPT said:

Я тоже не согласна с тем, чтобы винить le Cardinal, учти, но я не хочу видеть нас разделёнными и истекающими кровью, когда мы могли бы быть едины.",shape=box,color=blue];
		1684 -> 1691;
		1684 -> 1692;
	1685 [label="Мы все должны прекратить взаимные обвинения за те раны, что были причинены, независимо от того, кто в итоге виноват.",shape=box,color=blue];
		1685 -> 1691;
		1685 -> 1692;
	1687 [label="Check /Lotus/Scripts/1999/DialogueScriptNodes.lua:IsSyndicateRank",color=orange];
		1687 -> 1693 [label=true,color=green];
		1687 -> 1694 [label=false,color=brown];
	2942 [label="Пфф! Я всё ещё считаю, что это достойный эксперимент. Возможно, нам удастся отгородиться от дьявола стеной из книжных шкафов!",shape=box,color=blue];
		2942 -> 2943;
	2941 [label="Я послушно проигнорирую твой сарказм, потому что считаю это достойным экспериментом. Возможно, нам удастся отгородиться от дьявола стеной из книжных шкафов!",shape=box,color=blue];
		2941 -> 2943;
	1688 [label="Я стремлюсь помочь нам всем в этом... странном сосуществовании, в котором мы оказались, а не спорить.",shape=box,color=blue];
		1688 -> 1686;
	1689 [label="Нет, не игра. Но Энтрати нельзя доверять, и я не знаю иного способа убедить тебя, кроме как сделать вид, будто я на твоей стороне.",shape=box,color=red];
		1689 -> 1695;
	1690 [label="Oui? Что ж, я рада сообщить тебе, что больше в этом нет нужды.",shape=box,color=blue];
		1690 -> 1696;
	1691 [label="Все вместе, как одно целое, мы... странная семья. Но всё же семья, несмотря ни на что.",shape=box,color=red];
		1691 -> 1697;
	1692 [label="Вместе мы станем куда сильнее, чем поодиночке.",shape=box,color=red];
		1692 -> 1698;
		1692 -> 1699;
	1693 [label="Она смирилась с его отсутствием, и они примирились друг с другом, но это далось им нелегко.",shape=box,color=red];
		1693 -> 1700;
	1694 [label="Она не может смириться с его отсутствием, и они готовы вцепиться друг другу в глотки.",shape=box,color=red];
		1694 -> 1701;
	2943 [label="+20 Chemistry",color=orange];
		2943 -> 2944;
	1695 [label="Oui? Что ж, я рада сообщить тебе, что у тебя ничего не вышло.",shape=box,color=blue];
		1695 -> 1696;
	1696 [label="Update boolean MarieEntratiFan1",color=orange];
		1696 -> 1702;
	1697 [label="Add +1 to Family",color=orange];
		1697 -> 1698;
		1697 -> 1699;
	1698 [label="И в минуты страдания порой всё, что у нас есть, — это мы сами. Либо те, кто был нам дан, либо те, кого мы сами нашли.",shape=box,color=red];
		1698 -> 1703;
	1699 [label="Не знаю, принесёт ли это пользу или боль со временем. Но и это... чистилище тоже неправильно.",shape=box,color=red];
		1699 -> 1704;
	1700 [label="Зная, что он все ещё где-то там, творит, и что он не сказал ей ни слова и даже не отправил письма...?",shape=box,color=red];
		1700 -> 1705;
	1701 [label="Зная, что он все ещё где-то там, творит, и что он не сказал ей ни слова и даже не отправил письма...?",shape=box,color=red];
		1701 -> 1706;
	2944 [label="Много дел! À la revoyure!",shape=box,color=blue];
		2944 -> 2929;
	1702 [label="Update boolean MarieEntratiFan2",color=orange];
		1702 -> 1707;
	1703 [label="Add +1 to Family",color=orange];
		1703 -> 1704;
	1704 [label="Oui, я согласна. Но я не могу быть той, которая устранит пропасть между нами. Я не знаю, как это сделать! Для тех, кто там, наверху, я чужда...",shape=box,color=blue];
		1704 -> 1708;
		1704 -> 1709;
	1705 [label="Не могу представить, как это больно для неё. Для них обоих.",shape=box,color=red];
		1705 -> 1710;
	1706 [label="Это уничтожило бы ту малую надежду на примирение, которая у них могла бы быть.",shape=box,color=red];
		1706 -> 1711;
	2929 [label="Chat ends.",color=orange];
	1707 [label="Update boolean MarieNoDate",color=orange];
		1707 -> 1712;
	1708 [label="Лойд знал семью Энтрати. Это должен был быть он. Но убедить его... это уже другой вопрос.",shape=box,color=red];
		1708 -> 1713;
	1709 [label="Может быть, Роут? Он же Орокин, он знал их всех.",shape=box,color=red];
		1709 -> 1714;
	1710 [label="Хотя я понимаю логику решения защитить их от боли, причинённой le Cardinal его неизбежным уходом...",shape=box,color=blue];
		1710 -> 1715;
	1711 [label="Oui... Я понимаю логику. Тогда была бы попытка с твоей стороны примирить их семью, не так ли? Похоже, это единственная надежда для всех нас выбраться из этого места. ",shape=box,color=blue];
		1711 -> 1716;
	1712 [label="Chat ends.",color=orange];
	1713 [label="+5 Chemistry",color=orange];
		1713 -> 1717;
	1714 [label="Non, не дьявол – кто угодно, только не дьявол. Но ты на верном пути. Естественный выбор будет Monsieur Loid, non?",shape=box,color=blue];
		1714 -> 1718;
	1715 [label="Я считаю это неоправданно жестоким, не так ли? Они могут подумать, что он мёртв. Или ещё хуже! А мы, живущие здесь, comme des rats d'égout?",shape=box,color=blue];
		1715 -> 1719;
		1715 -> 1720;
		1715 -> 1721;
	1716 [label="Чтобы нам не провести остаток жизни здесь, comme des rats d'égout. ",shape=box,color=blue];
		1716 -> 1722;
		1716 -> 1723;
	1717 [label="Oui, oui! C'est ça! Но как нам его убедить? Он ведь непреклонен в своей позиции, non?",shape=box,color=blue];
		1717 -> 1724;
		1717 -> 1725;
	1718 [label="Но как нам его убедить? Он ведь непреклонен в своей позиции, non?",shape=box,color=blue];
		1718 -> 1725;
		1718 -> 1724;
	1719 [label="У меня есть друг, который обожает крыс. Я считаю их очаровательными.",shape=box,color=red];
		1719 -> 1726;
	1720 [label="На самом деле, это не моё решение.",shape=box,color=red];
		1720 -> 1727;
	1721 [label="Как ты думаешь, что мне стоит предпринять?",shape=box,color=red];
		1721 -> 1728;
	1722 [label="У меня есть друг, который обожает крыс. Я считаю их очаровательными. ",shape=box,color=red];
		1722 -> 1729;
	1723 [label="Это была моя небрежность. Твоя правда. Пора браться за дело.",shape=box,color=red];
		1723 -> 1730;
	1724 [label="Думаешь, ты или Лион сможете его убедить?",shape=box,color=red];
		1724 -> 1731;
	1725 [label="Тебе не понравится мой ответ, Мари...",shape=box,color=red];
		1725 -> 1732;
	1726 [label="И мне бы очень хотелось когда-нибудь с ними встретиться, но это не то, о чем я говорю, глупый волк.",shape=box,color=blue];
		1726 -> 1728;
	1727 [label="Я знаю. Это решение Monsieur Лойда и всех остальных, дать о себе знать.",shape=box,color=blue];
		1727 -> 1728;
	1728 [label="Я бы предположила, что именно чувство вины, а не благородства, удерживает нас здесь.",shape=box,color=blue];
		1728 -> 1733;
	1729 [label="И мне бы очень хотелось когда-нибудь с ними встретиться, но это не то, о чем я говорю, глупый волк.",shape=box,color=blue];
		1729 -> 1728;
	1730 [label="Спасибо. Не знаю, получится ли у тебя, но иногда нам остаётся только попытаться.",shape=box,color=blue];
		1730 -> 1728;
	1731 [label="Он к нам вполне благосклонен, добр и мягок. Но для него мы всё же étrangers, лишь вновь прибывшие.",shape=box,color=blue];
		1731 -> 1734;
	1732 [label="Ах bon?",shape=box,color=blue];
		1732 -> 1735;
	1733 [label="Что мы скрываем какой-то большой и страшный грех.",shape=box,color=blue];
		1733 -> 1736;
	1734 [label="Я подумаю над этим. Ты сделай то же самое! Решение будет найдено, Сол вёл нас до сих пор!",shape=box,color=blue];
		1734 -> 1737;
	1735 [label="Лойд, возможно, прислушается к Роуту. Он ведь тоже Орокин - их общее прошлое - может сыграть нам на руку.",shape=box,color=red];
		1735 -> 1738;
	1736 [label="И именно этот грех должен быть прощен, или, может быть, доказано, что это ложь?",shape=box,color=blue];
		1736 -> 1739;
		1736 -> 1740;
	1737 [label="+15 Chemistry",color=orange];
		1737 -> 1741;
	1738 [label="Non! Он лжец, он манипулятор, он согласился бы на это только взамен на огромную плату!",shape=box,color=blue];
		1738 -> 1742;
	1739 [label="Ситуация наверху… даже в лучшие дни довольно хрупкая. Не хочу их расстраивать.",shape=box,color=red];
		1739 -> 1743;
	1740 [label="Нам просто нужно быть осторожными. Боюсь, одна половина будет воспринимать другую как «другую семью».",shape=box,color=red];
		1740 -> 1744;
	1741 [label="Мы найдём способ убедить Monsieur Лойд подняться по тем ступеням... Я знаю это.",shape=box,color=blue];
		1741 -> 1745;
	1742 [label="Мы найдём другой способ убедить Monsieur Лойд подняться по тем ступеням... Я знаю это.",shape=box,color=blue];
		1742 -> 1746;
	1743 [label="Ты бы удивился, насколько душа устойчива. А те, кто меня сейчас окружают, так стары, так закалены временем.",shape=box,color=blue];
		1743 -> 1747;
	1744 [label="Add +1 to Family",color=orange];
		1744 -> 1748;
	1745 [label="Мне пора. Много о чём надо подумать, многое сделать. До скорой встречи. À la revoyure.",shape=box,color=blue];
		1745 -> 1749;
	1746 [label="Мне пора. Много о чём надо подумать, многое сделать. До скорой встречи. À la revoyure.",shape=box,color=blue];
