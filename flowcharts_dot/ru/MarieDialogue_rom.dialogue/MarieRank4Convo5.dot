	j1316635360 [label="Evaluate expressions",color=orange];
		j1316635360 -> j83218489 [label="LoidFamilyComplete",color=purple];
		j1316635360 -> j4016879957 [label="MarieFamilyOther",color=purple];
		j1316635360 -> j403264977 [label="MarieFamily2",color=purple];
		j1316635360 -> j403264977 [label="MarieFamily1",color=purple];
		j1316635360 -> j3440795225 [label="false",color=purple];
	j83218489 [label="Скиталец! У меня был план.",shape=box,color=blue];
		j83218489 -> j1191397335;
		j83218489 -> j1310452999;
	j4016879957 [label="Скиталец! Я всё обдумывала, размышляя над тем, что ты сказал о семье, живущей выше нас. И о том, что они, возможно, видят в нас угрозу.",shape=box,color=blue];
		j4016879957 -> j2161124815;
	j403264977 [label="Скиталец! Я всё размышляла над тем, что ты сказал о семье, живущей выше нас. Моё сердце разрывается за них...",shape=box,color=blue];
		j403264977 -> j1000557311;
	j3440795225 [label="Почему мы не можем подняться наверх? Почему нам нельзя поговорить с теми, кто называл le Cardinal семьёй?",shape=box,color=blue];
		j3440795225 -> j637042665;
		j3440795225 -> j1310452999;
	j1191397335 [label="Стоит ли мне бояться?",shape=box,color=red];
		j1191397335 -> j2441801611;
	j1310452999 [label="[Конец.]",shape=box,color=red];
		j1310452999 -> "Chat ends.";
	j2161124815 [label="Как «другая семья» в compétition, oui? Это меня очень беспокоит.",shape=box,color=blue];
		j2161124815 -> j1000557311;
	j1000557311 [label="Check /Lotus/Scripts/1999/DialogueScriptNodes.lua:IsSyndicateRank(syndicate=EntratiSyndicate, syndicateRank=5)",color=orange];
		j1000557311 -> j2098406992 [label=true,color=green];
		j1000557311 -> j3642914 [label=false,color=brown];
	j637042665 [label="Ну... короче говоря, некоторые из семьи Энтрати находятся наверху, и они... не совсем знают, что мы здесь, внизу.",shape=box,color=red];
		j637042665 -> j3738828329;
	j2441801611 [label="Oui! Маленькие летающие роботы. Некра... некра... Как их назвать?",shape=box,color=blue];
		j2441801611 -> j323377944;
	"Chat ends." [color=orange];
	j2098406992 [label="Мы не соревнуемся за любовь le Cardinal, как мы можем помочь им понять это?",shape=box,color=blue];
		j2098406992 -> j3576949127;
		j2098406992 -> j1152704471;
		j2098406992 -> j1923832168;
	j3642914 [label="Check boolean MarieSyndicateMaxRank",color=orange];
		j3642914 -> j2098406992 [label=true,color=green];
		j3642914 -> j2904610473 [label=false,color=brown];
	j3738828329 [label="Boolean MarieFamily1 is now true.",color=orange];
		j3738828329 -> j4274890936;
	j323377944 [label="Некрамиты?",shape=box,color=red];
		j323377944 -> j802027125;
	j3576949127 [label="Твоя правда. Нельзя бороться за то, чего человек не способен дать.",shape=box,color=red];
		j3576949127 -> j380005824;
	j1152704471 [label="Вскрывать покрытые струпьями раны опасно. Можно избавиться от заражения... а можно истечь кровью в этом процессе.",shape=box,color=red];
		j1152704471 -> j2952898253;
	j1923832168 [label="У тебя - у всех нас - есть одна общая черта. В какой-то момент Энтрати оставила нас позади.",shape=box,color=red];
		j1923832168 -> j2515192195;
	j2904610473 [label="Как продвигается твоя работа по улаживанию их внутренних раздоров?",shape=box,color=blue];
		j2904610473 -> j2649377226;
		j2904610473 -> j3774477446;
		j2904610473 -> j477601226;
		j2904610473 -> j1310452999;
	j4274890936 [label="Par les Luminaires... Ты имеешь в виду, что мы все здесь, внизу, в тайне?! Так вот почему нам не разрешают покидать это место?! Mais pourquoi?!",shape=box,color=blue];
		j4274890936 -> j2318472454;
	j802027125 [label="Oui! Ха! Они так настойчиво меняют мебель, non? Но я заметила, что если что-то передвинуть... они делают то же самое.",shape=box,color=blue];
		j802027125 -> j3089212456;
	j380005824 [label="Evaluate expressions",color=orange];
		j380005824 -> j429011906 [label="MarieEntrati3a",color=purple];
		j380005824 -> j429011906 [label="MarieEntrati3b",color=purple];
