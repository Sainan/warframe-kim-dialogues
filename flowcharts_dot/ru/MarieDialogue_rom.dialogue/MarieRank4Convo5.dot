	2930 [label="Скиталец! У меня был план.",shape=box,color=blue];
		2930 -> 2931;
		2930 -> 2932;
	1630 [label="Скиталец! Я всё обдумывала, размышляя над тем, что ты сказал о семье, живущей выше нас. И о том, что они, возможно, видят в нас угрозу.",shape=box,color=blue];
		1630 -> 1633;
	1631 [label="Скиталец! Я всё размышляла над тем, что ты сказал о семье, живущей выше нас. Моё сердце разрывается за них...",shape=box,color=blue];
		1631 -> 1634;
	1632 [label="Почему мы не можем подняться наверх? Почему нам нельзя поговорить с теми, кто называл le Cardinal семьёй?",shape=box,color=blue];
		1632 -> 1635;
		1632 -> 1636;
	2931 [label="Стоит ли мне бояться?",shape=box,color=red];
		2931 -> 2934;
	2932 [label="[Конец.]",shape=box,color=red];
		2932 -> 2933;
	1633 [label="Как «другая семья» в compétition, oui? Это меня очень беспокоит.",shape=box,color=blue];
		1633 -> 1634;
	1634 [label="Check /Lotus/Scripts/1999/DialogueScriptNodes.lua:IsSyndicateRank",color=orange];
		1634 -> 1637 [label=true,color=green];
		1634 -> 1638 [label=false,color=brown];
	1635 [label="Ну... короче говоря, некоторые из семьи Энтрати находятся наверху, и они... не совсем знают, что мы здесь, внизу.",shape=box,color=red];
		1635 -> 1639;
	1636 [label="[Конец.]",shape=box,color=red];
		1636 -> 1640;
	2934 [label="Oui! Маленькие летающие роботы. Некра... некра... Как их назвать?",shape=box,color=blue];
		2934 -> 2935;
	2933 [label="Chat ends.",color=orange];
	1637 [label="Мы не соревнуемся за любовь le Cardinal, как мы можем помочь им понять это?",shape=box,color=blue];
		1637 -> 1641;
		1637 -> 1642;
		1637 -> 1643;
	1638 [label="Как продвигается твоя работа по улаживанию их внутренних раздоров?",shape=box,color=blue];
		1638 -> 1644;
		1638 -> 1645;
		1638 -> 1646;
		1638 -> 1647;
	1639 [label="Update boolean MarieFamily1",color=orange];
		1639 -> 1648;
	1640 [label="Chat ends.",color=orange];
	2935 [label="Некрамиты?",shape=box,color=red];
		2935 -> 2936;
	1641 [label="Твоя правда. Нельзя бороться за то, чего человек не способен дать.",shape=box,color=red];
		1641 -> 1649;
	1642 [label="Вскрывать покрытые струпьями раны опасно. Можно избавиться от заражения... а можно истечь кровью в этом процессе.",shape=box,color=red];
		1642 -> 1650;
	1643 [label="У тебя - у всех нас - есть одна общая черта. В какой-то момент Энтрати оставила нас позади.",shape=box,color=red];
		1643 -> 1651;
	1644 [label="Честно? Занимаюсь кое-чем другим.",shape=box,color=red];
		1644 -> 1652;
	1645 [label="Всё могло бы сложиться и лучше.",shape=box,color=red];
		1645 -> 1653;
	1646 [label="Я делаю успехи.",shape=box,color=red];
		1646 -> 1654;
	1647 [label="[Конец.]",shape=box,color=red];
		1647 -> 1655;
	1648 [label="Par les Luminaires... Ты имеешь в виду, что мы все здесь, внизу, в тайне?! Так вот почему нам не разрешают покидать это место?! Mais pourquoi?!",shape=box,color=blue];
		1648 -> 1656;
	2936 [label="Oui! Ха! Они так настойчиво меняют мебель, non? Но я заметила, что если что-то передвинуть... они делают то же самое.",shape=box,color=blue];
		2936 -> 2937;
