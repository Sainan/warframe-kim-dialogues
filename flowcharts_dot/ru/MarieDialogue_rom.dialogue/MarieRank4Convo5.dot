		j2515192195 -> j3362182815 [label="MarieEntratiMonster1",color=purple];
		j2515192195 -> j3362182815 [label="MarieEntratiMonster2",color=purple];
		j2515192195 -> j2005578040 [label="MarieEntratiFan1",color=purple];
		j2515192195 -> j2005578040 [label="MarieEntratiFan2",color=purple];
		j2515192195 -> j29798931 [label="MarieEntratiNeutral",color=purple];
		j2515192195 -> j3066717405 [label="false",color=purple];
	j2649377226 [label="Честно? Занимаюсь кое-чем другим.",shape=box,color=red];
		j2649377226 -> j2946442664;
	j3774477446 [label="Всё могло бы сложиться и лучше.",shape=box,color=red];
		j3774477446 -> j2486388479;
	j477601226 [label="Я делаю успехи.",shape=box,color=red];
		j477601226 -> j372503351;
	j2318472454 [label="Его дочь, Эйлерия, известная как Мать, и её семья всё это время заботились о Деймосе.",shape=box,color=red];
		j2318472454 -> j2344628012;
	j3089212456 [label="А что нам мешает просто передвинуть всю мебель, дать им всё заменить, а потом… сделать это снова? Мы могли бы всё продать, получить прибыль с de ce mobilier étrange!",shape=box,color=blue];
		j3089212456 -> j3623218671;
		j3089212456 -> j31314074;
		j3089212456 -> j2120997859;
	j429011906 [label="Я прекрасно знаю о наших неразрешённых разногласиях насчёт le Cardinal. Я стараюсь поддерживать civilisée разговор.",shape=box,color=blue];
		j429011906 -> j847543724;
	j2746238457 [label="Я понимаю, что тебе, возможно, не захочется обсуждать вопрос урегулирования разногласий, не найдя возможности указать на тех, кого ты считаешь виновными.",shape=box,color=blue];
		j2746238457 -> j847543724;
	j614359354 [label="Oui! Как ты так часто любишь напоминать мне, ты ведь считаешь его un monstre! В сердце которого лишь злоба и пустота!",shape=box,color=blue];
		j614359354 -> j847543724;
	j768252985 [label="Я полагала, ты на моей стороне в этой войне за душу le Cardinal?",shape=box,color=blue];
		j768252985 -> j4186115965;
	j900406647 [label="Я полагала, у тебя ещё не было чёткого определения насчёт le Cardinal? Или теперь уже всё изменилось?",shape=box,color=blue];
		j900406647 -> j631178613;
		j900406647 -> j2131209522;
	j2558536001 [label="Oui. Этому я учусь у M'sieur Tagfer...",shape=box,color=blue];
		j2558536001 -> j871110740;
	j1846099295 [label="Не говори мне о заживших ранах, волк. Я до сих пор зализываю свои после нашей прошлой беседы о le Cardinal.",shape=box,color=blue];
		j1846099295 -> j847543724;
	j3207675950 [label="Oui, но тобой уже было сказано это ранее - мы все должны прекратить взаимные обвинения за те раны, что были причинены.",shape=box,color=blue];
		j3207675950 -> j3426882333;
	j3937969208 [label="Я знаю, ты считаешь le Cardinal каким-то ужасным чудовищем, которое наносит такие страдания.",shape=box,color=blue];
		j3937969208 -> j847543724;
	j2005578040 [label="Я знаю, что ты на моей стороне в этой войне за душу le Cardinal, за что я буду вечно благодарна.",shape=box,color=blue];
		j2005578040 -> j3952145435;
	j29798931 [label="Я знаю, что суждение о нём пока удерживается, и за это есть огромная признательность.",shape=box,color=blue];
		j29798931 -> j3952145435;
	j3952145435 [label="И хотя мне известно, что другие поспешили бы обвинить его, у меня нет желания видеть нас разобщёнными и истекающими кровью, когда возможно единство.",shape=box,color=blue];
		j3952145435 -> j2617883968;
	j3224975664 [label="Oui, хотя я начинаю понимать - как и с M'sieur Tagfer, что, пожалуй, не всё в равной мере.",shape=box,color=blue];
		j3224975664 -> j871110740;
	j468100278 [label="И мне постепенно приходит понимание, что всё это не в равной мере, как тобою так «любезно» было указано мне, non?",shape=box,color=blue];
		j468100278 -> j847543724;
	j3379984306 [label="Oui, да! Я не виню le Cardinal за его уход, ведь его дело – sacro-saint -",shape=box,color=blue];
		j3379984306 -> j3952145435;
	j3362182815 [label="И я знаю, ты считаешь le Cardinal каким-то ужасным чудовищем, которое наносит такие страдания.",shape=box,color=blue];
		j3362182815 -> j847543724;
	j3066717405 [label="И другие поспешили бы обвинить его в своей боли. У меня просто нет желания видеть нас разобщёнными и страдающими.",shape=box,color=blue];
		j3066717405 -> j2617883968;
	j2946442664 [label="И что же могло тебя отвлечь? Что может быть важнее, чем сесть и разбирать жалобы mécontents?",shape=box,color=blue];
		j2946442664 -> j2108835167;
	j2486388479 [label="Что может быть сложного в том, чтобы сесть и разобраться с жалобами mécontents?",shape=box,color=blue];
		j2486388479 -> j3928980884;
	j372503351 [label="О, magnifique!",shape=box,color=blue];
		j372503351 -> j1872857006;
	j2344628012 [label="Присматривали за этим местом и за сердцем, что гонит энергию Бездны в Изначальную Систему, удерживая всех нас... в рабочем состоянии, с тех пор как исчез Энтрати.",shape=box,color=red];
		j2344628012 -> j3916832970;
	j3623218671 [label="Что-то мне подсказывает, что стулья Энтрати не особо пользуются спросом...",shape=box,color=red];
		j3623218671 -> j775083750;
	j31314074 [label="Разве мы в конце концов не заполонили бы рынок? Нам пришлось бы продавать их по очень низкой цене...",shape=box,color=red];
		j31314074 -> j775083750;
	j2120997859 [label="Отлично. Не вижу в этом никаких проблем.",shape=box,color=red];
		j2120997859 -> j1463521806;
	j847543724 [label="И хотя я понимаю, что эти две темы неразрывно связаны, я попрошу тебя, пусть разговор сегодня будет плодотворным, oui?",shape=box,color=blue];
		j847543724 -> j2342056819;
	j4186115965 [label="Что за уловка, волк? Или малышка Мари для тебя всего лишь un jeu?",shape=box,color=blue];
		j4186115965 -> j2944528936;
		j4186115965 -> j2131209522;
	j631178613 [label="Я ещё не приняла решение, насколько оправданы его действия. Но его безжалостность не вызывает сомнений.",shape=box,color=red];
		j631178613 -> j847543724;
	j2131209522 [label="Мне надоело притворяться, прости.",shape=box,color=red];
		j2131209522 -> j1274499968;
	j871110740 [label="Мы все должны прекратить взаимные обвинения за те раны, что были причинены.",shape=box,color=blue];
		j871110740 -> j3426882333;
	j3426882333 [label="ChatGPT said:\n\nЯ тоже не согласна с тем, чтобы винить le Cardinal, учти, но я не хочу видеть нас разделёнными и истекающими кровью, когда мы могли бы быть едины.",shape=box,color=blue];
		j3426882333 -> j734550676;
		j3426882333 -> j1777030357;
	j2617883968 [label="Мы все должны прекратить взаимные обвинения за те раны, что были причинены, независимо от того, кто в итоге виноват.",shape=box,color=blue];
		j2617883968 -> j734550676;
		j2617883968 -> j1777030357;
	j2108835167 [label="Я шучу, я же просто дразню! Я не в силах постичь, насколько велика твоя загруженность и сколько мест - и эпох - нуждаются в тебе.",shape=box,color=blue];
		j2108835167 -> j1872857006;
	j3928980884 [label="Я шучу, я же просто дразню! Я не в силах постичь, через что им пришлось пройти. И как трудно тебе всё это распутать.",shape=box,color=blue];
		j3928980884 -> j1872857006;
	j1872857006 [label="Я лишь опасаюсь, что без примирения с их бедами, нам не стоит и надеяться быть желанными за их столом. Главная же проблема остаётся нерешённой...",shape=box,color=blue];
		j1872857006 -> j2098406992;
	j3916832970 [label="Check /Lotus/Scripts/1999/DialogueScriptNodes.lua:IsSyndicateRank(syndicate=EntratiSyndicate, syndicateRank=5)",color=orange];
		j3916832970 -> j245831949 [label=true,color=green];
		j3916832970 -> j3337182392 [label=false,color=brown];
	j775083750 [label="Пфф! Я всё ещё считаю, что это достойный эксперимент. Возможно, нам удастся отгородиться от дьявола стеной из книжных шкафов!",shape=box,color=blue];
		j775083750 -> j2970316861;
	j1463521806 [label="Я послушно проигнорирую твой сарказм, потому что считаю это достойным экспериментом. Возможно, нам удастся отгородиться от дьявола стеной из книжных шкафов!",shape=box,color=blue];
		j1463521806 -> j2970316861;
	j2342056819 [label="Я стремлюсь помочь нам всем в этом... странном сосуществовании, в котором мы оказались, а не спорить.",shape=box,color=blue];
		j2342056819 -> j871110740;
	j2944528936 [label="Нет, не игра. Но Энтрати нельзя доверять, и я не знаю иного способа убедить тебя, кроме как сделать вид, будто я на твоей стороне.",shape=box,color=red];
		j2944528936 -> j2248617224;
	j1274499968 [label="Oui? Что ж, я рада сообщить тебе, что больше в этом нет нужды.",shape=box,color=blue];
		j1274499968 -> j1509439757;
	j734550676 [label="Все вместе, как одно целое, мы... странная семья. Но всё же семья, несмотря ни на что.",shape=box,color=red];
		j734550676 -> j1625808289;
	j1777030357 [label="Вместе мы станем куда сильнее, чем поодиночке.",shape=box,color=red];
		j1777030357 -> j3575822414;
		j1777030357 -> j169231993;
	j245831949 [label="Она смирилась с его отсутствием, и они примирились друг с другом, но это далось им нелегко.",shape=box,color=red];
		j245831949 -> j616385198;
	j3337182392 [label="Check boolean MarieSyndicateMaxRank",color=orange];
		j3337182392 -> j245831949 [label=true,color=green];
		j3337182392 -> j921463091 [label=false,color=brown];
	j2970316861 [label="+20 Chemistry",color=orange];
		j2970316861 -> j980300023;
	j2248617224 [label="Oui? Что ж, я рада сообщить тебе, что у тебя ничего не вышло.",shape=box,color=blue];
		j2248617224 -> j1509439757;
	j1509439757 [label="Boolean MarieEntratiFan1 is now false.",color=orange];
		j1509439757 -> j2631316640;
	j1625808289 [label="Add +1 to Family counter",color=orange];
		j1625808289 -> j3575822414;
		j1625808289 -> j169231993;
	j3575822414 [label="И в минуты страдания порой всё, что у нас есть, — это мы сами. Либо те, кто был нам дан, либо те, кого мы сами нашли.",shape=box,color=red];
		j3575822414 -> j157629460;
	j169231993 [label="Не знаю, принесёт ли это пользу или боль со временем. Но и это... чистилище тоже неправильно.",shape=box,color=red];
		j169231993 -> j2596394302;
	j616385198 [label="Зная, что он все ещё где-то там, творит, и что он не сказал ей ни слова и даже не отправил письма...?",shape=box,color=red];
		j616385198 -> j1940713278;
	j921463091 [label="Она не может смириться с его отсутствием, и они готовы вцепиться друг другу в глотки.",shape=box,color=red];
		j921463091 -> j3203382833;
	j980300023 [label="Много дел! À la revoyure!",shape=box,color=blue];
		j980300023 -> "Chat ends.";
	j2631316640 [label="Boolean MarieEntratiFan2 is now false.",color=orange];
		j2631316640 -> j1508231473;
	j157629460 [label="Add +1 to Family counter",color=orange];
		j157629460 -> j2596394302;
	j2596394302 [label="Oui, я согласна. Но я не могу быть той, которая устранит пропасть между нами. Я не знаю, как это сделать! Для тех, кто там, наверху, я чужда...",shape=box,color=blue];
		j2596394302 -> j1434498389;
		j2596394302 -> j3232356289;
	j1940713278 [label="Не могу представить, как это больно для неё. Для них обоих.",shape=box,color=red];
		j1940713278 -> j2852007996;
	j3203382833 [label="Зная, что он все ещё где-то там, творит, и что он не сказал ей ни слова и даже не отправил письма...?",shape=box,color=red];
		j3203382833 -> j927757396;
	j1508231473 [label="Boolean MarieNoDate is now true.",color=orange];
		j1508231473 -> "Chat ends.";
	j1434498389 [label="Лойд знал семью Энтрати. Это должен был быть он. Но убедить его... это уже другой вопрос.",shape=box,color=red];
		j1434498389 -> j1844529950;
	j3232356289 [label="Может быть, Роут? Он же Орокин, он знал их всех.",shape=box,color=red];
		j3232356289 -> j1154601723;
	j2852007996 [label="Хотя я понимаю логику решения защитить их от боли, причинённой le Cardinal его неизбежным уходом...",shape=box,color=blue];
		j2852007996 -> j1815147798;
	j927757396 [label="Это уничтожило бы ту малую надежду на примирение, которая у них могла бы быть.",shape=box,color=red];
		j927757396 -> j3214511712;
	j1844529950 [label="+5 Chemistry",color=orange];
		j1844529950 -> j1224670368;
	j1154601723 [label="Non, не дьявол – кто угодно, только не дьявол. Но ты на верном пути. Естественный выбор будет Monsieur Loid, non?",shape=box,color=blue];
		j1154601723 -> j1140265058;
	j1815147798 [label="Я считаю это неоправданно жестоким, не так ли? Они могут подумать, что он мёртв. Или ещё хуже! А мы, живущие здесь, comme des rats d'égout?",shape=box,color=blue];
		j1815147798 -> j1804068637;
		j1815147798 -> j190927885;
		j1815147798 -> j3474121871;
	j3214511712 [label="Oui... Я понимаю логику. Тогда была бы попытка с твоей стороны примирить их семью, не так ли? Похоже, это единственная надежда для всех нас выбраться из этого места. ",shape=box,color=blue];
		j3214511712 -> j1360081126;
	j1224670368 [label="Oui, oui! C'est ça! Но как нам его убедить? Он ведь непреклонен в своей позиции, non?",shape=box,color=blue];
		j1224670368 -> j2570328287;
		j1224670368 -> j2958819317;
	j1140265058 [label="Но как нам его убедить? Он ведь непреклонен в своей позиции, non?",shape=box,color=blue];
		j1140265058 -> j2958819317;
		j1140265058 -> j2570328287;
	j1804068637 [label="У меня есть друг, который обожает крыс. Я считаю их очаровательными.",shape=box,color=red];
		j1804068637 -> j3436169311;
	j190927885 [label="На самом деле, это не моё решение.",shape=box,color=red];
		j190927885 -> j949791628;
	j3474121871 [label="Как ты думаешь, что мне стоит предпринять?",shape=box,color=red];
		j3474121871 -> j2028225851;
	j1360081126 [label="Чтобы нам не провести остаток жизни здесь, comme des rats d'égout. ",shape=box,color=blue];
		j1360081126 -> j1568698952;
		j1360081126 -> j1001008565;
	j2570328287 [label="Думаешь, ты или Лион сможете его убедить?",shape=box,color=red];
		j2570328287 -> j3850813435;
	j2958819317 [label="Тебе не понравится мой ответ, Мари...",shape=box,color=red];
		j2958819317 -> j3880790515;
	j3436169311 [label="И мне бы очень хотелось когда-нибудь с ними встретиться, но это не то, о чем я говорю, глупый волк.",shape=box,color=blue];
		j3436169311 -> j2028225851;
	j949791628 [label="Я знаю. Это решение Monsieur Лойда и всех остальных, дать о себе знать.",shape=box,color=blue];
		j949791628 -> j2028225851;
	j2028225851 [label="Я бы предположила, что именно чувство вины, а не благородства, удерживает нас здесь.",shape=box,color=blue];
		j2028225851 -> j1349565701;
	j1568698952 [label="У меня есть друг, который обожает крыс. Я считаю их очаровательными. ",shape=box,color=red];
		j1568698952 -> j3436169311;
	j1001008565 [label="Это была моя небрежность. Твоя правда. Пора браться за дело.",shape=box,color=red];
		j1001008565 -> j3937986096;
	j3850813435 [label="Он к нам вполне благосклонен, добр и мягок. Но для него мы всё же étrangers, лишь вновь прибывшие.",shape=box,color=blue];
		j3850813435 -> j1608851240;
	j3880790515 [label="Ах bon?",shape=box,color=blue];
		j3880790515 -> j3966124637;
	j1349565701 [label="Что мы скрываем какой-то большой и страшный грех.",shape=box,color=blue];
		j1349565701 -> j3463376663;
	j3937986096 [label="Спасибо. Не знаю, получится ли у тебя, но иногда нам остаётся только попытаться.",shape=box,color=blue];
		j3937986096 -> j2028225851;
	j1608851240 [label="Я подумаю над этим. Ты сделай то же самое! Решение будет найдено, Сол вёл нас до сих пор!",shape=box,color=blue];
		j1608851240 -> j3289611179;
	j3966124637 [label="Лойд, возможно, прислушается к Роуту. Он ведь тоже Орокин - их общее прошлое - может сыграть нам на руку.",shape=box,color=red];
		j3966124637 -> j1012502074;
	j3463376663 [label="И именно этот грех должен быть прощен, или, может быть, доказано, что это ложь?",shape=box,color=blue];
		j3463376663 -> j1573984980;
		j3463376663 -> j1962629256;
	j3289611179 [label="+15 Chemistry",color=orange];
		j3289611179 -> j33441637;
	j1012502074 [label="Non! Он лжец, он манипулятор, он согласился бы на это только взамен на огромную плату!",shape=box,color=blue];
		j1012502074 -> j1575616924;
	j1573984980 [label="Ситуация наверху… даже в лучшие дни довольно хрупкая. Не хочу их расстраивать.",shape=box,color=red];
		j1573984980 -> j1136177584;
	j1962629256 [label="Нам просто нужно быть осторожными. Боюсь, одна половина будет воспринимать другую как «другую семью».",shape=box,color=red];
		j1962629256 -> j1480617761;
	j33441637 [label="Мы найдём способ убедить Monsieur Лойд подняться по тем ступеням... Я знаю это.",shape=box,color=blue];
		j33441637 -> j3488845251;
	j1575616924 [label="Мы найдём другой способ убедить Monsieur Лойд подняться по тем ступеням... Я знаю это.",shape=box,color=blue];
		j1575616924 -> j1264531930;
	j1136177584 [label="Ты бы удивился, насколько душа устойчива. А те, кто меня сейчас окружают, так стары, так закалены временем.",shape=box,color=blue];
		j1136177584 -> j2516454562;
	j1480617761 [label="Add +1 to Family counter",color=orange];
		j1480617761 -> j789070161;
	j3488845251 [label="Мне пора. Много о чём надо подумать, многое сделать. До скорой встречи. À la revoyure.",shape=box,color=blue];
		j3488845251 -> j3419468122;
	j1264531930 [label="Мне пора. Много о чём надо подумать, многое сделать. До скорой встречи. À la revoyure.",shape=box,color=blue];
		j1264531930 -> j3493145735;
	j2516454562 [label="Ты много раз их удивлял. Позволь им удивить тебя хотя бы один раз.",shape=box,color=blue];
		j2516454562 -> j3014704937;
	j789070161 [label="Ох, Сол, я думаю, что тебе удалось всё же найти решение!",shape=box,color=blue];
		j789070161 -> j3813996837;
	j3419468122 [label="Boolean MarieFamily3b is now true.",color=orange];
		j3419468122 -> "Chat ends.";
	j3493145735 [label="+15 Chemistry",color=orange];
		j3493145735 -> j2660382074;
	j3014704937 [label="Но в каком направлении нам действовать, oui? Мы должны найти способ убедить их.",shape=box,color=blue];
		j3014704937 -> j1777030357;
		j3014704937 -> j734550676;
	j3813996837 [label="Boolean MarieFamilyOther is now true.",color=orange];
		j3813996837 -> j761143367;
	j2660382074 [label="Boolean MarieFamily3a is now true.",color=orange];
		j2660382074 -> "Chat ends.";
	j761143367 [label="Я вне себя от волнения — je suis assise ici, remuant sur ma chaise!",shape=box,color=blue];
		j761143367 -> j3014704937;
}