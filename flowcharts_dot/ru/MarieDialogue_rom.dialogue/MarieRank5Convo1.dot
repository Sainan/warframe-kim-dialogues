		j1655333553 -> j2848888228;
	j1689297695 [label="Мари, он не бог. Он всего лишь человек. Он такой же высокомерный и опасный, как Роут. Он из того же общества и страдает от тех же проблем.",shape=box,color=red];
		j1689297695 -> j1690924978;
	j1590888643 [label="Я знаю, он был добр к тебе. Знаю, он относился к тебе иначе, чем ко многим другим людям. Возможно, он даже относился к тебе как к дочери... Но, пожалуйста, посмотри на ситуацию шире.",shape=box,color=red];
		j1590888643 -> j39170156;
