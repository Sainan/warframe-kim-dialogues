		j1182335275 -> j2259269745;
	j3979149274 [label="Oui! Précisément. И я уверена, со временем все всё поймут. Я просто рада, что у меня есть друг, который поддерживает меня в этом.",shape=box,color=blue];
		j3979149274 -> j300343042;
	j477379265 [label="Поверь, нет, ты не права. Бесчисленное множество людей лишились жизни из-за этого. И я могу назвать имён тех, чьи жизни были разрушены из-за него. Но никто не забыл о Безразличии.",shape=box,color=red];
		j477379265 -> j2546806953;
	j3837381096 [label="Я уверена, что если бы встретила её, то вскоре обо всём узнала бы! Все здесь так быстро рассказывают мне о своих страданиях от его рук. Неудивительно, что le Cardinal не возвращается. На его месте я бы и минуты здесь не провела\n-",shape=box,color=blue];
		j3837381096 -> j1945778071;
	j1528662193 [label="Я не думаю, что это его отпугнёт! Ты правда считаешь, что le Cardinal вернётся в это гнездо vipères?! Non! На его месте я бы и минуты здесь не провела - ",shape=box,color=blue];
