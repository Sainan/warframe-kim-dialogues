digraph {
	"MarieRank5Convo1 begins." [color=orange];
		"MarieRank5Convo1 begins." -> j792556692;
	j792556692 [label="Можем ли мы поговорить?",shape=box,color=blue];
		j792556692 -> j709500590;
	j709500590 [label="Evaluate expressions",color=orange];
		j709500590 -> j1445539399 [label="MarieEntrati4a",color=purple];
		j709500590 -> j3087545421 [label="MarieEntrati4b",color=purple];
		j709500590 -> j4261386917 [label="MarieEntrati3a",color=purple];
		j709500590 -> j399925317 [label="MarieEntrati3b",color=purple];
		j709500590 -> j320894954 [label="MarieEntrati3",color=purple];
		j709500590 -> j509083236 [label="false",color=purple];
	j1445539399 [label="Я размышляла над тем, что ты сказал о le Cardinal.. Что его действия — это... «смесь» благого и гнусного.",shape=box,color=blue];
		j1445539399 -> j2456939962;
	j3087545421 [label="Я размышляла над твоими словами о le Cardinal. Его действия принесли Лиону горе.",shape=box,color=blue];
		j3087545421 -> j2456939962;
	j4261386917 [label="Я больше размышляла о нашем разговоре о Monsieur Тагфере и твоих убедительных аргументах в пользу того, почему он так презирает le Cardinal.",shape=box,color=blue];
		j4261386917 -> j2456939962;
	j399925317 [label="Я много думала о своём споре с Monsieur Тэгфером, и о его причинах так ненавидеть le Cardinal.",shape=box,color=blue];
		j399925317 -> j2456939962;
	j320894954 [label="Я много думала о своём споре с Monsieur Тегфером. И о нашем споре насчёт того спора.",shape=box,color=blue];
		j320894954 -> j2456939962;
	j509083236 [label="Мне кажется, многое так и осталось несказанным о le Cardinal. Остальные, похоже, ходят вокруг меня на цыпочках, боясь говорить о нём.",shape=box,color=blue];
		j509083236 -> j2456939962;
	j2456939962 [label="Я знаю, что другие хотели бы изобразить его мерзавцем, безумцем, предателем. Но для меня он был другим.",shape=box,color=blue];
		j2456939962 -> j2718976672;
	j2718976672 [label="Check boolean MarieBackstory1",color=orange];
		j2718976672 -> j796868956 [label=true,color=green];
		j2718976672 -> j567672323 [label=false,color=brown];
	j796868956 [label="Возможно, это потому, что я так привыкла к тому, что меня бросают. ",shape=box,color=blue];
		j796868956 -> j3966325972;
	j567672323 [label="Меня бросила семья, оставили на улице, когда я был ребёнком, потому что я была... ненормальной. Сломленной. Непригодной для высшего общества.",shape=box,color=blue];
		j567672323 -> j3966325972;
	j3966325972 [label="Возможно, это потому, что у меня никогда не было отца, о котором можно было бы говорить, что я так легко готова простить ему его отсутствие.",shape=box,color=blue];
		j3966325972 -> j4106479212;
	j4106479212 [label="Evaluate expressions",color=orange];
		j4106479212 -> j1082346180 [label="MarieEntrati4a",color=purple];
		j4106479212 -> j1401253269 [label="MarieEntrati4b",color=purple];
		j4106479212 -> j857967444 [label="MarieEntrati3a",color=purple];
		j4106479212 -> j3485780824 [label="MarieEntrati3b",color=purple];
		j4106479212 -> j2316140284 [label="MarieEntrati3",color=purple];
		j4106479212 -> j1796628789 [label="false",color=purple];
	j1082346180 [label="Но факт остаётся фактом, я его прощаю. Ибо вижу больше ценности в его добрых делах, чем вреда в его дурных.",shape=box,color=blue];
		j1082346180 -> j2281295860;
		j1082346180 -> j2244027262;
		j1082346180 -> j3879054982;
		j1082346180 -> j1449889482;
		j1082346180 -> j873965786;
	j1401253269 [label="Я молюсь о том, чтобы Лион был силен и преодолел кризис веры, который он переживает, но я не верю, что это целиком и полностью вина le Cardinal.",shape=box,color=blue];
		j1401253269 -> j2281295860;
		j1401253269 -> j2244027262;
		j1401253269 -> j3879054982;
		j1401253269 -> j1874560685;
		j1401253269 -> j2691596970;
	j857967444 [label="Поэтому, хотя я и ценю твои убедительные аргументы относительно Monsieur Тагфера и тех, кто пострадал от него... я все же вижу больше ценности в его добрых делах, чем вреда в его дурных.",shape=box,color=blue];
		j857967444 -> j2281295860;
		j857967444 -> j2244027262;
		j857967444 -> j3879054982;
		j857967444 -> j3933014249;
		j857967444 -> j18076795;
	j3485780824 [label="Итак, хотя я понимаю гнев Monsieur Тегфера и могу понять его аргументы, он должен найти в своём сердце место, чтобы простить le Cardinal. Потому что я вижу больше пользы в добрых поступках le Cardinal, чем вреда в его порочных деяниях.",shape=box,color=blue];
		j3485780824 -> j2281295860;
		j3485780824 -> j2244027262;
		j3485780824 -> j3879054982;
		j3485780824 -> j584094474;
		j3485780824 -> j1688021018;
	j2316140284 [label="Поэтому, хотя я и ценю историю каждого, связанную с le Cardinal, особенно с Monsieur Тагфером, я все же больше ценю его добрые дела, чем вред от его дурных поступков.",shape=box,color=blue];
		j2316140284 -> j2281295860;
		j2316140284 -> j2244027262;
		j2316140284 -> j3879054982;
		j2316140284 -> j752430501;
	j1796628789 [label="Поэтому, хотя я и ценю историю каждого, связанную с le Cardinal, я все же больше ценю его добрые дела, чем вред от его дурных поступков.",shape=box,color=blue];
		j1796628789 -> j2281295860;
		j1796628789 -> j2244027262;
		j1796628789 -> j3879054982;
	j2281295860 [label="Я не виню тебя за то, что ты ценишь то добро, которое он сделал в твоей жизни, так же, как я не виню других людей за то, что они негодуют по поводу вреда, который он причиняет в их жизни.",shape=box,color=red];
		j2281295860 -> j3495847221;
	j2244027262 [label="Не знаю. Думаю, его действия принесли гораздо больше вреда, чем пользы. Хотелось бы, чтобы ты это поняла.",shape=box,color=red];
		j2244027262 -> j4288371264;
	j3879054982 [label="Я на твоей стороне, Мари. Я не могу винить Энтрати ни за что из того, что он сделал. Он борется с Безразличием.",shape=box,color=red];
		j3879054982 -> j3142094137;
	j1449889482 [label="Ты права, что прощаешь Энтрати. Хотелось бы, чтобы и другие последовали твоему примеру.",shape=box,color=red];
		j1449889482 -> j3142094137;
	j873965786 [label="Я никогда не буду осуждать кого-то за прощение. Но можно простить кого-то, понимая, что нужно защитить себя и других от него.",shape=box,color=red];
		j873965786 -> j2076700677;
	j1874560685 [label="Ты считаешь, что страдания Лиона, это его собственная вина?",shape=box,color=red];
		j1874560685 -> j509258498;
	j2691596970 [label="Лион страдает не только от кризиса веры, Мари. И во многом это связано с Энтрати.",shape=box,color=red];
		j2691596970 -> j4288371264;
	j3933014249 [label="Неужели ничего из сказанного мной не помогло хоть немного выровнять чашу весов?",shape=box,color=red];
		j3933014249 -> j3938272099;
	j18076795 [label="Как можно смотреть на все, что сделал Энтрати, и при этом видеть больше пользы, чем вреда?",shape=box,color=red];
		j18076795 -> j4288371264;
	j584094474 [label="Мне кажется, ты недооцениваешь серьёзность того, что пережили Кавиа и Тагфер.",shape=box,color=red];
		j584094474 -> j4288371264;
	j1688021018 [label="Прощение важно. Но не менее важно признать, что Энтрати может оказаться сложнее, чем ты готова принять.",shape=box,color=red];
		j1688021018 -> j3938272099;
	j752430501 [label="Думаю, ты всё ещё не понимаешь, что пережили Тагфер и Кавия. Это хуже, чем то, что пришлось пережить тебе.",shape=box,color=red];
		j752430501 -> j4288371264;
	j3495847221 [label="Но разве ты не видишь, что эти два чувства не равноценны? Негодование и почтение? Я хочу, чтобы и те, и другие, отказались от своих злобных завидей.",shape=box,color=blue];
		j3495847221 -> j648904188;
		j3495847221 -> j2178020168;
	j4288371264 [label="Evaluate expressions",color=orange];
		j4288371264 -> j1729850838 [label="MarieEntratiMonster1",color=purple];
		j4288371264 -> j1729850838 [label="MarieEntratiMonster2",color=purple];
		j4288371264 -> j116689595 [label="MarieEntratiFan1",color=purple];
		j4288371264 -> j116689595 [label="MarieEntratiFan2",color=purple];
		j4288371264 -> j1061649599 [label="false",color=purple];
	j3142094137 [label="Evaluate expressions",color=orange];
		j3142094137 -> j79740491 [label="MarieEntratiMonster1",color=purple];
		j3142094137 -> j79740491 [label="MarieEntratiMonster2",color=purple];
		j3142094137 -> j2170930440 [label="MarieEntratiFan1",color=purple];
		j3142094137 -> j2170930440 [label="MarieEntratiFan2",color=purple];
		j3142094137 -> j711791582 [label="false",color=purple];
	j2076700677 [label="И ты предлагаешь нам так поступить? Изгнать le Cardinal? Я бы сказала, что, похоже, он уже сделал это сам, non?",shape=box,color=blue];
		j2076700677 -> j3694376311;
		j2076700677 -> j2178020168;
	j509258498 [label="Думаю, Лион страдает от множества недугов, многие из которых вызваны сомнениями в себе и своём разуме. Le Cardinal, похоже, только ускорил события.",shape=box,color=blue];
		j509258498 -> j3935104062;
		j509258498 -> j2178020168;
	j3938272099 [label="Что ты хочешь, чтобы я сделала? Сжечь чучело le Cardinal и осудить его? Приговорить его к смерти, пожелать ему зла, как Monsieur Тагферу?",shape=box,color=blue];
		j3938272099 -> j3694376311;
		j3938272099 -> j2178020168;
	j648904188 [label="В этом-то и проблема, Мари. В том, чего ты требуешь от других. А не в том, чего они требуют от тебя. Или от Энтрати.",shape=box,color=red];
		j648904188 -> j285012824;
	j2178020168 [label="Энтрати оставляет после себя раненых людей, куда бы он ни пошёл. Я просто пытаюсь помочь им всё вернуть на круги своя. Меня не особо волнует, что в его случае «добро» или «зло».",shape=box,color=red];
		j2178020168 -> j1782196192;
	j1729850838 [label="Oui, и ты так последовательно ненавидишь его! Разве ничто из того, что я сказала, не смягчило твоё отношение к le Cardinal?",shape=box,color=blue];
		j1729850838 -> j1217486677;
	j116689595 [label="Разве ты не говорил мне о том, как благоволил Энтрати, как и я, всего несколько минут назад? Что же теперь изменило твоё мнение?",shape=box,color=blue];
		j116689595 -> j293524253;
		j116689595 -> j2582306720;
		j116689595 -> j903145410;
		j116689595 -> j510344154;
	j1061649599 [label="Oui, и ты, похоже, считаешь Энтрати таким чудовищем! Ты так быстро отвергаешь его доброту!",shape=box,color=blue];
		j1061649599 -> j1217486677;
	j79740491 [label="Разве ты не говорил со мной об Entrati’s monstruosité всего несколько мгновений назад? Что заставило тебя передумать?",shape=box,color=blue];
		j79740491 -> j293524253;
		j79740491 -> j2582306720;
		j79740491 -> j903145410;
		j79740491 -> j510344154;
	j2170930440 [label="Merci, и ты был моим стойким спутником в этом крестовом походе! Боюсь, мы одни в таких убеждениях, даже Monsieur Лойд питает такую же обиду...",shape=box,color=blue];
		j2170930440 -> j1812042559;
	j711791582 [label="Спасибо, как я рада это слышать! Боюсь, мы одиноки в этом отношении – даже Monsieur Лойд затаил такую обиду...",shape=box,color=blue];
		j711791582 -> j1812042559;
	j3694376311 [label="Я думаю, проблема скорее в том, что ты просишь от других, а не в том, что они просят от тебя. Или Энтрати.",shape=box,color=red];
		j3694376311 -> j285012824;
	j3935104062 [label="И тебя это не беспокоит?",shape=box,color=red];
		j3935104062 -> j2159116448;
	j285012824 [label="И что же такого чудовищного я прошу от других? Принять прощение в свои сердца?",shape=box,color=blue];
		j285012824 -> j3217592410;
		j285012824 -> j2108885399;
	j1782196192 [label="Благородно, хоть и утомительно, путешествовать сквозь время и пространство, помогая своим mécontents, non? Ты наверное, питаешь к нему неприязнь за это...",shape=box,color=blue];
		j1782196192 -> j4216001531;
		j1782196192 -> j2798272316;
	j1217486677 [label="Этот разговор был ошибкой...",shape=box,color=blue];
		j1217486677 -> j3296805701;
		j1217486677 -> j4049645252;
	j293524253 [label="Честно говоря, мне очень трудно обсуждать эту тему с тобой. И это болезненно. Лично я считаю, что он… ни хороший, ни плохой. Скорее смесь того и другого.",shape=box,color=red];
		j293524253 -> j823965635;
	j2582306720 [label="Моё мнение изменилось.. Я на его стороне. И на твоей тоже. Ты меня убедила.",shape=box,color=red];
		j2582306720 -> j1163293663;
	j903145410 [label="[Признаться в чувствах.] Я просто стараюсь изо всех сил... завоевать твоё расположение. Боюсь, у меня к тебе есть чувства. Гораздо сильнее, чем казалось.",shape=box,color=red];
		j903145410 -> j223410372;
	j510344154 [label="Моё мнение изменилось: он монстр. Раз и навсегда.",shape=box,color=red];
		j510344154 -> j2527187165;
	j1812042559 [label="Вместе, возможно, мы сможем противостоять тем, кто хотел бы опорочить его добрые дела, oui? Но я всё же спрашиваю себя… среди всего, что тебя окружает, почему ты встаешь на мою сторону?",shape=box,color=blue];
		j1812042559 -> j346514577;
	j2159116448 [label="Check boolean LyonDating",color=orange];
		j2159116448 -> j424135439 [label=true,color=green];
		j2159116448 -> j849133195 [label=false,color=brown];
	j3217592410 [label="Ты вознесла Энтрати на пьедестал, Мари. И теперь требуешь от других делать то же самое, словно идиоты.",shape=box,color=red];
		j3217592410 -> j1349101408;
	j2108885399 [label="Мне кажется, ты просишь их сделать больше, чем просто простить Энтрати. Мне кажется, ты просишь их притвориться, что он никогда не сделал ничего плохого.",shape=box,color=red];
		j2108885399 -> j325520816;
	j4216001531 [label="Конечно. Но я также считаю должным поблагодарить его за некоторые из самых важных отношений и дружеских связей, которые у меня когда-либо были.",shape=box,color=red];
		j4216001531 -> j2454032220;
	j2798272316 [label="Нет, не совсем. Ему нужно, чтобы это было сделано, поэтому это будет сделано. Я его осужу, когда всё будет сказано и сделано.",shape=box,color=red];
		j2798272316 -> j2454032220;
	j3296805701 [label="Подожди, Мари. Пожалуйста. Дай мне объяснить.",shape=box,color=red];
		j3296805701 -> j1231688956;
		j3296805701 -> j1668927994;
		j3296805701 -> j659467624;
		j3296805701 -> j3089944140;
	j4049645252 [label="Моё отношение к Энтрати было ясно выражено. Прости. В некоторых вопросах нам просто не суждено прийти к единому мнению.",shape=box,color=red];
		j4049645252 -> j1713391499;
	j823965635 [label="Boolean MarieEntratiMonster1 is now false.",color=orange];
		j823965635 -> j2295998952;
	j1163293663 [label="Boolean MarieEntratiMonster1 is now false.",color=orange];
		j1163293663 -> j4206755482;
	j223410372 [label="Boolean DrifterMarieWhoops is now true.",color=orange];
		j223410372 -> j999713699;
	j2527187165 [label="Boolean MarieEntratiFan1 is now false.",color=orange];
		j2527187165 -> j1973484981;
	j346514577 [label="Но заметь, я не жалуюсь!",shape=box,color=blue];
		j346514577 -> j237235617;
		j346514577 -> j4119415740;
		j346514577 -> j1828185021;
	j424135439 [label="Я знаю, что он нашёл место в твоём сердце, и за это я по-настоящему благодарна — возможно, я наконец смогу перестать беспокоиться о нём, и вся эта борьба скоро утратит смысл -",shape=box,color=blue];
		j424135439 -> j849133195;
	j849133195 [label="Но, конечно, меня это беспокоит. Он же брат моей души! Мой Лион — самое дорогое, что есть у меня на свете, и видеть, как он страдает, — боль в груди, словно его страдания — мои собственные.",shape=box,color=blue];
		j849133195 -> j3715292156;
	j1349101408 [label="Следи за своими словами, Скиталец.",shape=box,color=blue];
		j1349101408 -> j1443179090;
	j325520816 [label="Je ne suis pas naïve, не говори со мной так, будто я такая!",shape=box,color=blue];
		j325520816 -> j153035613;
	j2454032220 [label="Возможно, он лишь выпускает яд, чтобы тело могло исцелиться, и всё это лишь необходимая жестокость.",shape=box,color=blue];
		j2454032220 -> j2972582475;
		j2454032220 -> j1793809603;
	j1231688956 [label="[Признаться в чувствах.] Ты мне очень дорога… больше, чем я обычно показываю. И… прости за резкость. Я просто не могу позволить ему причинить тебе боль. Не после всего, что он сделал другим.",shape=box,color=red];
		j1231688956 -> j3686373221;
	j1668927994 [label="Я видел, как Энтрати только и делает, что сжигает всех, кто ему дорог. Всех, кого он якобы любил. Я не хочу видеть, как он поступит так же с тобой...",shape=box,color=red];
		j1668927994 -> j1507318466;
	j659467624 [label="Я не очень хорошо умею выражать свои мысли, и за это прошу прощения. Но он... боюсь, он использует тебя и твою доброту, чтобы манипулировать тобой. Вот и всё.",shape=box,color=red];
		j659467624 -> j403494227;
	j3089944140 [label="Ты можешь видеть в Энтрати спасителя, а я вижу в нём старого, напуганного человека, судорожно ищущего ответы. Возможно, истина где-то посередине.",shape=box,color=red];
		j3089944140 -> j1349101408;
	j1713391499 [label="Oui. Похоже на то.",shape=box,color=blue];
		j1713391499 -> j3051126039;
	j2295998952 [label="Boolean MarieEntratiMonster2 is now false.",color=orange];
		j2295998952 -> j2709982893;
	j4206755482 [label="Boolean MarieEntratiMonster2 is now false.",color=orange];
		j4206755482 -> j109163637;
