digraph {
	2427 [label="MarieRank5Convo1 begins.",color=orange];
		2427 -> 2428;
	2428 [label="Можем ли мы поговорить?",shape=box,color=blue];
		2428 -> 2429;
	2429 [label="Evaluate expressions",color=orange];
		2429 -> 2430 [label="MarieEntrati4a",color=purple];
		2429 -> 2431 [label="MarieEntrati4b",color=purple];
		2429 -> 2432 [label="MarieEntrati3a",color=purple];
		2429 -> 2433 [label="MarieEntrati3b",color=purple];
		2429 -> 2434 [label="MarieEntrati3",color=purple];
		2429 -> 2435 [label="false",color=purple];
	2430 [label="Я размышляла над тем, что ты сказал о le Cardinal.. Что его действия — это... «смесь» благого и гнусного.",shape=box,color=blue];
		2430 -> 2436;
	2431 [label="Я размышляла над твоими словами о le Cardinal. Его действия принесли Лиону горе.",shape=box,color=blue];
		2431 -> 2436;
	2432 [label="Я больше размышляла о нашем разговоре о Monsieur Тагфере и твоих убедительных аргументах в пользу того, почему он так презирает le Cardinal.",shape=box,color=blue];
		2432 -> 2436;
	2433 [label="Я много думала о своём споре с Monsieur Тэгфером, и о его причинах так ненавидеть le Cardinal.",shape=box,color=blue];
		2433 -> 2436;
	2434 [label="Я много думала о своём споре с Monsieur Тегфером. И о нашем споре насчёт того спора.",shape=box,color=blue];
		2434 -> 2436;
	2435 [label="Мне кажется, многое так и осталось несказанным о le Cardinal. Остальные, похоже, ходят вокруг меня на цыпочках, боясь говорить о нём.",shape=box,color=blue];
		2435 -> 2436;
	2436 [label="Я знаю, что другие хотели бы изобразить его мерзавцем, безумцем, предателем. Но для меня он был другим.",shape=box,color=blue];
		2436 -> 2437;
	2437 [label="Check boolean MarieBackstory1",color=orange];
		2437 -> 2439 [label=true,color=green];
		2437 -> 2438 [label=false,color=brown];
	2439 [label="Возможно, это потому, что я так привыкла к тому, что меня бросают. ",shape=box,color=blue];
		2439 -> 2440;
	2438 [label="Меня бросила семья, оставили на улице, когда я был ребёнком, потому что я была... ненормальной. Сломленной. Непригодной для высшего общества.",shape=box,color=blue];
		2438 -> 2440;
	2440 [label="Возможно, это потому, что у меня никогда не было отца, о котором можно было бы говорить, что я так легко готова простить ему его отсутствие.",shape=box,color=blue];
		2440 -> 2441;
	2441 [label="Evaluate expressions",color=orange];
		2441 -> 2442 [label="MarieEntrati4a",color=purple];
		2441 -> 2443 [label="MarieEntrati4b",color=purple];
		2441 -> 2444 [label="MarieEntrati3a",color=purple];
		2441 -> 2445 [label="MarieEntrati3b",color=purple];
		2441 -> 2446 [label="MarieEntrati3",color=purple];
		2441 -> 2447 [label="false",color=purple];
	2442 [label="Но факт остаётся фактом, я его прощаю. Ибо вижу больше ценности в его добрых делах, чем вреда в его дурных.",shape=box,color=blue];
		2442 -> 2448;
		2442 -> 2449;
		2442 -> 2450;
		2442 -> 2451;
		2442 -> 2452;
	2443 [label="Я молюсь о том, чтобы Лион был силен и преодолел кризис веры, который он переживает, но я не верю, что это целиком и полностью вина le Cardinal.",shape=box,color=blue];
		2443 -> 2448;
		2443 -> 2449;
		2443 -> 2450;
		2443 -> 2453;
		2443 -> 2454;
	2444 [label="Поэтому, хотя я и ценю твои убедительные аргументы относительно Monsieur Тагфера и тех, кто пострадал от него... я все же вижу больше ценности в его добрых делах, чем вреда в его дурных.",shape=box,color=blue];
		2444 -> 2448;
		2444 -> 2449;
		2444 -> 2450;
		2444 -> 2455;
		2444 -> 2456;
	2445 [label="Итак, хотя я понимаю гнев Monsieur Тегфера и могу понять его аргументы, он должен найти в своём сердце место, чтобы простить le Cardinal. Потому что я вижу больше пользы в добрых поступках le Cardinal, чем вреда в его порочных деяниях.",shape=box,color=blue];
		2445 -> 2448;
		2445 -> 2449;
		2445 -> 2450;
		2445 -> 2457;
		2445 -> 2458;
	2446 [label="Поэтому, хотя я и ценю историю каждого, связанную с le Cardinal, особенно с Monsieur Тагфером, я все же больше ценю его добрые дела, чем вред от его дурных поступков.",shape=box,color=blue];
		2446 -> 2448;
		2446 -> 2449;
		2446 -> 2450;
		2446 -> 2459;
	2447 [label="Поэтому, хотя я и ценю историю каждого, связанную с le Cardinal, я все же больше ценю его добрые дела, чем вред от его дурных поступков.",shape=box,color=blue];
		2447 -> 2448;
		2447 -> 2449;
		2447 -> 2450;
	2448 [label="Я не виню тебя за то, что ты ценишь то добро, которое он сделал в твоей жизни, так же, как я не виню других людей за то, что они негодуют по поводу вреда, который он причиняет в их жизни.",shape=box,color=red];
		2448 -> 2460;
	2449 [label="Не знаю. Думаю, его действия принесли гораздо больше вреда, чем пользы. Хотелось бы, чтобы ты это поняла.",shape=box,color=red];
		2449 -> 2461;
	2450 [label="Я на твоей стороне, Мари. Я не могу винить Энтрати ни за что из того, что он сделал. Он борется с Безразличием.",shape=box,color=red];
		2450 -> 2462;
	2451 [label="Ты права, что прощаешь Энтрати. Хотелось бы, чтобы и другие последовали твоему примеру.",shape=box,color=red];
		2451 -> 2462;
	2452 [label="Я никогда не буду осуждать кого-то за прощение. Но можно простить кого-то, понимая, что нужно защитить себя и других от него.",shape=box,color=red];
		2452 -> 2463;
	2453 [label="Ты считаешь, что страдания Лиона, это его собственная вина?",shape=box,color=red];
		2453 -> 2464;
	2454 [label="Лион страдает не только от кризиса веры, Мари. И во многом это связано с Энтрати.",shape=box,color=red];
		2454 -> 2461;
	2455 [label="Неужели ничего из сказанного мной не помогло хоть немного выровнять чашу весов?",shape=box,color=red];
		2455 -> 2465;
	2456 [label="Как можно смотреть на все, что сделал Энтрати, и при этом видеть больше пользы, чем вреда?",shape=box,color=red];
		2456 -> 2461;
	2457 [label="Мне кажется, ты недооцениваешь серьёзность того, что пережили Кавиа и Тагфер.",shape=box,color=red];
		2457 -> 2461;
	2458 [label="Прощение важно. Но не менее важно признать, что Энтрати может оказаться сложнее, чем ты готова принять.",shape=box,color=red];
		2458 -> 2465;
	2459 [label="Думаю, ты всё ещё не понимаешь, что пережили Тагфер и Кавия. Это хуже, чем то, что пришлось пережить тебе.",shape=box,color=red];
		2459 -> 2461;
	2460 [label="Но разве ты не видишь, что эти два чувства не равноценны? Негодование и почтение? Я хочу, чтобы и те, и другие, отказались от своих злобных завидей.",shape=box,color=blue];
		2460 -> 2466;
		2460 -> 2467;
	2461 [label="Evaluate expressions",color=orange];
		2461 -> 2469 [label="MarieEntratiMonster1",color=purple];
		2461 -> 2469 [label="MarieEntratiMonster2",color=purple];
		2461 -> 2468 [label="MarieEntratiFan1",color=purple];
		2461 -> 2468 [label="MarieEntratiFan2",color=purple];
		2461 -> 2470 [label="false",color=purple];
	2462 [label="Evaluate expressions",color=orange];
		2462 -> 2473 [label="MarieEntratiMonster1",color=purple];
		2462 -> 2473 [label="MarieEntratiMonster2",color=purple];
		2462 -> 2471 [label="MarieEntratiFan1",color=purple];
		2462 -> 2471 [label="MarieEntratiFan2",color=purple];
		2462 -> 2472 [label="false",color=purple];
	2463 [label="И ты предлагаешь нам так поступить? Изгнать le Cardinal? Я бы сказала, что, похоже, он уже сделал это сам, non?",shape=box,color=blue];
		2463 -> 2474;
		2463 -> 2467;
	2464 [label="Думаю, Лион страдает от множества недугов, многие из которых вызваны сомнениями в себе и своём разуме. Le Cardinal, похоже, только ускорил события.",shape=box,color=blue];
		2464 -> 2475;
		2464 -> 2467;
	2465 [label="Что ты хочешь, чтобы я сделала? Сжечь чучело le Cardinal и осудить его? Приговорить его к смерти, пожелать ему зла, как Monsieur Тагферу?",shape=box,color=blue];
		2465 -> 2474;
		2465 -> 2467;
	2466 [label="В этом-то и проблема, Мари. В том, чего ты требуешь от других. А не в том, чего они требуют от тебя. Или от Энтрати.",shape=box,color=red];
		2466 -> 2476;
	2467 [label="Энтрати оставляет после себя раненых людей, куда бы он ни пошёл. Я просто пытаюсь помочь им всё вернуть на круги своя. Меня не особо волнует, что в его случае «добро» или «зло».",shape=box,color=red];
		2467 -> 2477;
	2469 [label="Oui, и ты так последовательно ненавидишь его! Разве ничто из того, что я сказала, не смягчило твоё отношение к le Cardinal?",shape=box,color=blue];
		2469 -> 2482;
	2468 [label="Разве ты не говорил мне о том, как благоволил Энтрати, как и я, всего несколько минут назад? Что же теперь изменило твоё мнение?",shape=box,color=blue];
		2468 -> 2478;
		2468 -> 2479;
		2468 -> 2480;
		2468 -> 2481;
	2470 [label="Oui, и ты, похоже, считаешь Энтрати таким чудовищем! Ты так быстро отвергаешь его доброту!",shape=box,color=blue];
		2470 -> 2482;
	2473 [label="Разве ты не говорил со мной об Entrati’s monstruosité всего несколько мгновений назад? Что заставило тебя передумать?",shape=box,color=blue];
		2473 -> 2478;
		2473 -> 2479;
		2473 -> 2480;
		2473 -> 2481;
	2471 [label="Merci, и ты был моим стойким спутником в этом крестовом походе! Боюсь, мы одни в таких убеждениях, даже Monsieur Лойд питает такую же обиду...",shape=box,color=blue];
		2471 -> 2483;
	2472 [label="Merci, and how glad I am to hear it ! I fear that we are alone in such regard - even Monsieur Loid harbors such resentment...",shape=box,color=blue];
		2472 -> 2483;
	2474 [label="Я думаю, проблема скорее в том, что ты просишь от других, а не в том, что они просят от тебя. Или Энтрати.",shape=box,color=red];
		2474 -> 2476;
	2475 [label="И тебя это не беспокоит?",shape=box,color=red];
		2475 -> 2484;
	2476 [label="И что же такого чудовищного я прошу от других? Принять прощение в свои сердца?",shape=box,color=blue];
		2476 -> 2485;
		2476 -> 2486;
	2477 [label="Благородно, хоть и утомительно, путешествовать сквозь время и пространство, помогая своим mécontents, non? Ты наверное, питаешь к нему неприязнь за это...",shape=box,color=blue];
		2477 -> 2487;
		2477 -> 2488;
	2482 [label="Этот разговор был ошибкой...",shape=box,color=blue];
		2482 -> 2493;
		2482 -> 2494;
	2478 [label="Честно говоря, мне очень трудно обсуждать эту тему с тобой. И это болезненно. Лично я считаю, что он… ни хороший, ни плохой. Скорее смесь того и другого.",shape=box,color=red];
		2478 -> 2489;
	2479 [label="Моё мнение изменилось.. Я на его стороне. И на твоей тоже. Ты меня убедила.",shape=box,color=red];
		2479 -> 2490;
	2480 [label="[Признаться в чувствах.] Я просто стараюсь изо всех сил... завоевать твоё расположение. Боюсь, у меня к тебе есть чувства. Гораздо сильнее, чем казалось.",shape=box,color=red];
		2480 -> 2491;
	2481 [label="Моё мнение изменилось: он монстр. Раз и навсегда.",shape=box,color=red];
		2481 -> 2492;
	2483 [label="Вместе, возможно, мы сможем противостоять тем, кто хотел бы опорочить его добрые дела, oui? Но я всё же спрашиваю себя… среди всего, что тебя окружает, почему ты встаешь на мою сторону?",shape=box,color=blue];
		2483 -> 2495;
	2484 [label="Check boolean LyonDating",color=orange];
		2484 -> 2496 [label=true,color=green];
		2484 -> 2497 [label=false,color=brown];
	2485 [label="Ты вознесла Энтрати на пьедестал, Мари. И теперь требуешь от других делать то же самое, словно идиоты.",shape=box,color=red];
		2485 -> 2498;
	2486 [label="Мне кажется, ты просишь их сделать больше, чем просто простить Энтрати. Мне кажется, ты просишь их притвориться, что он никогда не сделал ничего плохого.",shape=box,color=red];
		2486 -> 2499;
	2487 [label="Конечно. Но я также считаю должным поблагодарить его за некоторые из самых важных отношений и дружеских связей, которые у меня когда-либо были.",shape=box,color=red];
		2487 -> 2500;
	2488 [label="Нет, не совсем. Ему нужно, чтобы это было сделано, поэтому это будет сделано. Я его осужу, когда всё будет сказано и сделано.",shape=box,color=red];
		2488 -> 2500;
	2493 [label="Подожди, Мари. Пожалуйста. Дай мне объяснить.",shape=box,color=red];
		2493 -> 2505;
		2493 -> 2506;
		2493 -> 2507;
		2493 -> 2508;
	2494 [label="Моё отношение к Энтрати было ясно выражено. Прости. В некоторых вопросах нам просто не суждено прийти к единому мнению.",shape=box,color=red];
		2494 -> 2509;
	2489 [label="Update boolean MarieEntratiMonster1",color=orange];
		2489 -> 2501;
	2490 [label="Update boolean MarieEntratiMonster1",color=orange];
		2490 -> 2502;
	2491 [label="Update boolean DrifterMarieWhoops",color=orange];
		2491 -> 2503;
	2492 [label="Update boolean MarieEntratiFan1",color=orange];
		2492 -> 2504;
	2495 [label="Но заметь, я не жалуюсь!",shape=box,color=blue];
		2495 -> 2510;
		2495 -> 2511;
		2495 -> 2512;
	2496 [label="I know he has found a place inside your heart, and for this I am so truly grateful - perhaps I can finally stop worrying about him, and all this fighting will soon be moot -",shape=box,color=blue];
		2496 -> 2497;
	2497 [label="Но, конечно, меня это беспокоит. Он же брат моей души! Мой Лион — самое дорогое, что есть у меня на свете, и видеть, как он страдает, — боль в груди, словно его страдания — мои собственные.",shape=box,color=blue];
		2497 -> 2513;
	2498 [label="Следи за своими словами, Скиталец.",shape=box,color=blue];
		2498 -> 2514;
	2499 [label="Je ne suis pas naïve, не говори со мной так, будто я такая!",shape=box,color=blue];
		2499 -> 2515;
	2500 [label="Возможно, он лишь выпускает яд, чтобы тело могло исцелиться, и всё это лишь необходимая жестокость.",shape=box,color=blue];
		2500 -> 2516;
		2500 -> 2517;
	2505 [label="[Признаться в чувствах.] Ты мне очень дорога… больше, чем я обычно показываю. И… прости за резкость. Я просто не могу позволить ему причинить тебе боль. Не после всего, что он сделал другим.",shape=box,color=red];
		2505 -> 2523;
	2506 [label="Я видел, как Энтрати только и делает, что сжигает всех, кто ему дорог. Всех, кого он якобы любил. Я не хочу видеть, как он поступит так же с тобой...",shape=box,color=red];
		2506 -> 2524;
	2507 [label="Я не очень хорошо умею выражать свои мысли, и за это прошу прощения. Но он... боюсь, он использует тебя и твою доброту, чтобы манипулировать тобой. Вот и всё.",shape=box,color=red];
		2507 -> 2525;
	2508 [label="Ты можешь видеть в Энтрати спасителя, а я вижу в нём старого, напуганного человека, судорожно ищущего ответы. Возможно, истина где-то посередине.",shape=box,color=red];
		2508 -> 2498;
	2509 [label="Oui. Похоже на то.",shape=box,color=blue];
		2509 -> 2526;
	2501 [label="Update boolean MarieEntratiMonster2",color=orange];
		2501 -> 2518;
	2502 [label="Update boolean MarieEntratiMonster2",color=orange];
		2502 -> 2519;
	2503 [label="И ты решил обмануть меня, чтобы завоевать мое расположение... je vois.",shape=box,color=blue];
		2503 -> 2520;
		2503 -> 2521;
	2504 [label="Update boolean MarieEntratiFan2",color=orange];
		2504 -> 2522;
	2510 [label="[Признаться в чувствах.] Ты мне дорога. Больше, чем я показываю.",shape=box,color=red];
		2510 -> 2527;
	2511 [label="Я верю, что в этой войне любое средство оправдано. В конце концов, мы ведь пытаемся спасти вселенную от Безразличия, не так ли?",shape=box,color=red];
		2511 -> 2528;
	2512 [label="Я верю в Энтрати. Честно. Думаю, у него есть план, чтобы всё исправить, и всё, что произошло, ради высшего блага.",shape=box,color=red];
		2512 -> 2529;
	2513 [label="Но его падение от веры, не дело рук le Cardinal. Трещина в фундаменте уже была. Просто давление усилилось, oui?",shape=box,color=blue];
		2513 -> 2500;
	2514 [label="Update boolean MarieWarning",color=orange];
		2514 -> 2499;
	2515 [label="Я прекрасно понимаю, что le Cardinal, это одновременно Луа и Сол, свет и тьма, добро и зло. Он ни то, ни другое, и одновременно всё сразу, способен и на доброту, и на жестокость.",shape=box,color=blue];
		2515 -> 2530;
		2515 -> 2531;
	2516 [label="Вот почему остальные злятся, когда ты о нём говоришь. Ты замалчиваешь всё, что он сделал им больного, и притворяешься, будто этого вовсе не было, как будто мы все идиоты.",shape=box,color=red];
		2516 -> 2498;
	2517 [label="Мари, остановись. Тебе нужно признать, что он делает всё это не только потому, что он хороший человек. Нет. Он гораздо сложнее.",shape=box,color=red];
		2517 -> 2499;
	2523 [label="Update boolean DrifterMarie",color=orange];
		2523 -> 2536;
	2524 [label="Следи за своими словами, Скиталец.",shape=box,color=blue];
		2524 -> 2537;
	2525 [label="Мне не нужна такая защита! Je ne suis pas une enfant naïive!",shape=box,color=blue];
		2525 -> 2538;
	2526 [label="Update boolean MarieEntrati5g",color=orange];
		2526 -> 2539;
	2518 [label="Update boolean MarieEntratiFan1",color=orange];
		2518 -> 2532;
	2519 [label="Update boolean MarieEntratiFan2",color=orange];
		2519 -> 2533;
	2520 [label="Ну, когда ты так говоришь... ",shape=box,color=red];
		2520 -> 2534;
	2521 [label="Только частично.",shape=box,color=red];
		2521 -> 2534;
	2522 [label="Update boolean MarieEntratiMonster2",color=orange];
		2522 -> 2535;
	2527 [label="Update boolean DrifterMarieWhoops",color=orange];
		2527 -> 2540;
	2528 [label="Oui! Именно так! Наконец-то хоть кто-то здравомыслящий. Мне больно видеть, что в этой войне страдают невинные, но на кону стоит всё. ",shape=box,color=blue];
		2528 -> 2541;
	2529 [label="Update boolean MarieWillDate",color=orange];
		2529 -> 2542;
	2530 [label="Мари, он не бог. Он всего лишь человек. Он такой же высокомерный и опасный, как Роут. Он из того же общества и страдает от тех же проблем.",shape=box,color=red];
		2530 -> 2543;
	2531 [label="Я знаю, он был добр к тебе. Знаю, он относился к тебе иначе, чем ко многим другим людям. Возможно, он даже относился к тебе как к дочери... Но, пожалуйста, посмотри на ситуацию шире.",shape=box,color=red];
		2531 -> 2544;
	2536 [label="Я… я не знаю, как справиться с этой новостью, особенно после нашего разговора. Честно говоря, я сильно ошеломлёна. ",shape=box,color=blue];
		2536 -> 2549;
	2537 [label="Update boolean MarieWarning",color=orange];
		2537 -> 2525;
	2538 [label="Я прекрасно понимаю, что le Cardinal, это одновременно Луа и Сол, свет и тьма, добро и зло. Он ни то, ни другое, и одновременно всё сразу, способен и на доброту, и на жестокость.",shape=box,color=blue];
		2538 -> 2531;
		2538 -> 2530;
	2539 [label="Chat ends. Next chat will be MarieEntratiDay2.",color=orange];
	2532 [label="Update boolean MarieEntratiFan2",color=orange];
		2532 -> 2545;
	2533 [label="Oui? Я... полна надежды, но не убеждёна. Выбирай слова тщательнее, Скиталец...",shape=box,color=blue];
		2533 -> 2546;
	2534 [label="Update boolean MarieNoDate",color=orange];
		2534 -> 2547;
	2535 [label="Oui? Ты считаешь меня ребёнком или дурой? Выбирай слова осторожнее, Скиталец...",shape=box,color=blue];
		2535 -> 2548;
	2540 [label="И поэтому ты встал на сторону кардинала, чтобы завоевать мое расположение... je vois.",shape=box,color=blue];
		2540 -> 2550;
		2540 -> 2551;
	2541 [label="И на войне гибнут невинные люди. Это печально, но это факт, non?",shape=box,color=blue];
		2541 -> 2552;
		2541 -> 2553;
	2542 [label="Update boolean MarieFamilyFail",color=orange];
		2542 -> 2554;
	2543 [label="Он — человек, призвавший — или, возможно, даже создавший — бога! И теперь он единственный, кто стоит между ним и уничтожением нашей вселенной!",shape=box,color=blue];
		2543 -> 2555;
	2544 [label="Ты думаешь, я не знаю, что я была не единственной «дочерью», которую он оставил?! Я просто единственная, кто его простил!",shape=box,color=blue];
		2544 -> 2556;
		2544 -> 2557;
	2549 [label="Ты правда собираешься сделать это сейчас?! Вот так?! Здесь?! Vraiment?!",shape=box,color=blue];
		2549 -> 2560;
	2545 [label="Oui? Я... прощу тебе эту ложь, но считай, что тебя предупредили. Подбирай слова тщательнее, Скиталец...",shape=box,color=blue];
		2545 -> 2558;
	2546 [label="Update boolean MarieWarning",color=orange];
		2546 -> 2483;
	2547 [label="Update boolean MarieEntrati5i",color=orange];
		2547 -> 2559;
	2548 [label="Update boolean MarieWarning",color=orange];
		2548 -> 2482;
	2550 [label="Ну, когда ты так говоришь... ",shape=box,color=red];
		2550 -> 2561;
	2551 [label="Только отчасти. Я искренне верю в Энтрати.",shape=box,color=red];
		2551 -> 2561;
	2552 [label="Точно. Роут бы тобой очень гордился.",shape=box,color=red];
		2552 -> 2562;
	2553 [label="Сколько священных войн было развязано во имя Сола? Что, ещё одна, так?",shape=box,color=red];
		2553 -> 2563;
	2554 [label="Add -10 to Family",color=orange];
		2554 -> 2564;
	2555 [label="Похоже, я единственная, кто помнит, что здесь поставлено на карту!",shape=box,color=blue];
		2555 -> 2565;
		2555 -> 2557;
	2556 [label="Ты сейчас делаешь предположения. Ты этого не знаешь. Ты никогда её не встречала и понятия не имеешь, через что она прошла. Или что ей пришлось вытерпеть.",shape=box,color=red];
		2556 -> 2566;
	2557 [label="И как думаешь, если ты это сделаешь, он полюбит тебя ещё сильнее? И как думаешь, если ты останешься ему верна, он вернётся к тебе?",shape=box,color=red];
		2557 -> 2567;
	2560 [label="Я... я не могу. Я не могу продолжать. Прости меня. Мы поговорим об этом завтра, мне нужно собраться с мыслями.",shape=box,color=blue];
		2560 -> 2569;
	2558 [label="Update boolean MarieWarning",color=orange];
		2558 -> 2568;
