	j4119415740 [label="Я верю, что в этой войне любое средство оправдано. В конце концов, мы ведь пытаемся спасти вселенную от Безразличия, не так ли?",shape=box,color=red];
		j4119415740 -> j2916039683;
	j1828185021 [label="Я верю в Энтрати. Честно. Думаю, у него есть план, чтобы всё исправить, и всё, что произошло, ради высшего блага.",shape=box,color=red];
		j1828185021 -> j1655333553;
	j3715292156 [label="Но его падение от веры, не дело рук le Cardinal. Трещина в фундаменте уже была. Просто давление усилилось, oui?",shape=box,color=blue];
		j3715292156 -> j2454032220;
	j1443179090 [label="Boolean MarieWarning is now true.",color=orange];
		j1443179090 -> j325520816;
	j153035613 [label="Я прекрасно понимаю, что le Cardinal, это одновременно Луа и Сол, свет и тьма, добро и зло. Он ни то, ни другое, и одновременно всё сразу, способен и на доброту, и на жестокость.",shape=box,color=blue];
		j153035613 -> j1689297695;
		j153035613 -> j1590888643;
	j2972582475 [label="Вот почему остальные злятся, когда ты о нём говоришь. Ты замалчиваешь всё, что он сделал им больного, и притворяешься, будто этого вовсе не было, как будто мы все идиоты.",shape=box,color=red];
		j2972582475 -> j1349101408;
