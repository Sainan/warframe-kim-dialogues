		j4079561523 -> j477379265;
		j4079561523 -> j2906966098;
	j3190905166 [label="Ты сейчас делаешь предположения. Ты этого не знаешь. Ты никогда её не встречала и понятия не имеешь, через что она прошла. Или что ей пришлось вытерпеть.",shape=box,color=red];
		j3190905166 -> j3837381096;
	j2906966098 [label="И как думаешь, если ты это сделаешь, он полюбит тебя ещё сильнее? И как думаешь, если ты останешься ему верна, он вернётся к тебе?",shape=box,color=red];
