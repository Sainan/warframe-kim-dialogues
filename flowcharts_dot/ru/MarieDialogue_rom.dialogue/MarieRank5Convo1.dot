	2561 [label="Update boolean MarieNoDate",color=orange];
		2561 -> 2570;
	2562 [label="Ta gueule!",shape=box,color=blue];
		2562 -> 2571;
	2563 [label="Я... я не это имела в виду. Это не священная война, это что-то совершенно...",shape=box,color=blue];
		2563 -> 2572;
	2564 [label="Oui! Précisément. И я уверена, со временем все всё поймут. Я просто рада, что у меня есть друг, который поддерживает меня в этом.",shape=box,color=blue];
		2564 -> 2573;
	2565 [label="Поверь, нет, ты не права. Бесчисленное множество людей лишились жизни из-за этого. И я могу назвать имён тех, чьи жизни были разрушены из-за него. Но никто не забыл о Безразличии.",shape=box,color=red];
		2565 -> 2574;
	2566 [label="Я уверена, что если бы встретила её, то вскоре обо всём узнала бы! Все здесь так быстро рассказывают мне о своих страданиях от его рук. Неудивительно, что le Cardinal не возвращается. На его месте я бы и минуты здесь не провела
-",shape=box,color=blue];
		2566 -> 2575;
	2567 [label="Я не думаю, что это его отпугнёт! Ты правда считаешь, что le Cardinal вернётся в это гнездо vipères?! Non! На его месте я бы и минуты здесь не провела - ",shape=box,color=blue];
		2567 -> 2575;
	2569 [label="+20 Chemistry",color=orange];
