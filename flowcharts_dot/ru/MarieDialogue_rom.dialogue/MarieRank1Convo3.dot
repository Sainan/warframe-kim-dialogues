digraph {
	graph [fontname="Roboto Condensed"];
	node [fontname="Roboto Condensed"];
	edge [fontname="Roboto Condensed"];

	"MarieRank1Convo3 begins." [color=orange];
		"MarieRank1Convo3 begins." -> j3450640390;
	j3450640390 [label="Il y a un crâne volant! Keksekça?! Тут летает говорящий череп, и все продолжают заниматься своими делами, будто ничего странного не происходит, а я просто хочу, чтобы кто-то признал, насколько это безумно.",shape=box,color=blue];
		j3450640390 -> j1817677815;
		j3450640390 -> j4102606826;
		j3450640390 -> j1310452999;
	j1817677815 [label="Это просто Некралойд. Ну, один из некралойдов. Всё сложно.",shape=box,color=red];
		j1817677815 -> j3906362644;
	j4102606826 [label="Это Некралойд. Он Цефалон, он не причинит тебе вреда.",shape=box,color=red];
		j4102606826 -> j3098608328;
	j1310452999 [label="[Конец.]",shape=box,color=red];
		j1310452999 -> "Chat ends.";
	j3906362644 [label="Прошу прощения, это имя или предмет?",shape=box,color=blue];
		j3906362644 -> j388305241;
		j3906362644 -> j1863098011;
	j3098608328 [label="Я не считаю его угрозой! Он меня не пугает.",shape=box,color=blue];
		j3098608328 -> j2476452890;
	"Chat ends." [color=orange];
	j388305241 [label="Я... не имею об этом полного представления.",shape=box,color=red];
		j388305241 -> j3319429239;
	j1863098011 [label="Да.",shape=box,color=red];
		j1863098011 -> j2260891703;
	j2476452890 [label="На самом деле, нахожу его совершенно очаровательным, хоть он и немного упрям в разговоре. Совсем как его живой прототип. Но с учётом природы моего любимого спутника, можешь понять, что это меня не особенно смущает.",shape=box,color=blue];
		j2476452890 -> j1575973109;
	j3319429239 [label="Во-первых, чьё это творение, эти «Некралойды»? Это имя, или, быть может, обозначение?",shape=box,color=blue];
		j3319429239 -> j3510122715;
		j3319429239 -> j1477917572;
	j2260891703 [label="Я... не понимаю. И как в это вписывается Лойд?",shape=box,color=blue];
		j2260891703 -> j3319429239;
	j1575973109 [label="Нет, то, что ты можешь считать гротескным в его облике, уверяю, не является моей проблемой сейчас.",shape=box,color=blue];
		j1575973109 -> j2486071378;
		j1575973109 -> j2326556772;
	j3510122715 [label="Твой Cardinal Dimanche. Энтрати.",shape=box,color=red];
		j3510122715 -> j997088859;
	j1477917572 [label="Его создал Энтрати. Но сама концепция цефалонов была изобретением Орокин.",shape=box,color=red];
		j1477917572 -> j997088859;
	j2486071378 [label="Удивительно, что тебя не пугает череп.",shape=box,color=red];
		j2486071378 -> j1734944458;
	j2326556772 [label="Признаю, вне контекста он, должно быть, кажется странным. Но что именно тебя тревожит?",shape=box,color=red];
		j2326556772 -> j191081418;
	j997088859 [label="Excusez-moi, ты хочешь сказать, что le Cardinal создал копию летающего черепа-слуги по подобию своего спутника и назвал в его честь?",shape=box,color=blue];
		j997088859 -> j3509317898;
	j1734944458 [label="Ты мало обо мне знаешь, и в том нет твоей вины. Я провела большую часть жизни, заботясь о мёртвых и местах их упокоения. ",shape=box,color=blue];
		j1734944458 -> j600822182;
	j191081418 [label="Мне любопытно, почему у него на спине есть ещё одно лицо, похожее на детский набросок.",shape=box,color=blue];
		j191081418 -> j3444537097;
	j3509317898 [label="Почему же тогда их так мало, этих некралойдов?",shape=box,color=blue];
		j3509317898 -> j2633913396;
		j3509317898 -> j15392655;
		j3509317898 -> j863707517;
	j600822182 [label="И правда, я провела большую часть жизни в их обществе. Они охотно выслушивали мои дневные заботы.",shape=box,color=blue];
		j600822182 -> j4063127048;
	j3444537097 [label="Я спросила и Monsieur Некралоид, и Monsieur Лойда, но оба не захотели говорить об этом. Они лишь назвали имя. Отак. И произнесли его с большой печалью.",shape=box,color=blue];
		j3444537097 -> j3520118009;
	j2633913396 [label="Может, он осознал, насколько ужасно создавать цифровую копию своего возлюбленного.",shape=box,color=red];
		j2633913396 -> j193270395;
	j15392655 [label="Может, он изначально собирался сделать только одного.",shape=box,color=red];
		j15392655 -> j255876810;
	j863707517 [label="Не знаю. Может, просто не успел создать больше?",shape=box,color=red];
		j863707517 -> j2244802588;
	j4063127048 [label="Boolean MarieGraveyard1 is now true.",color=orange];
		j4063127048 -> j2006950412;
		j4063127048 -> j1013807470;
	j3520118009 [label="И вот я здесь, разговариваю с тобой в надежде, что ты сможешь мне помочь.",shape=box,color=blue];
		j3520118009 -> j303435886;
		j3520118009 -> j1824847839;
	j193270395 [label="Ou bien, это была дань его любви и уважения. Он не считал, что эта странная лаборатория может продолжать работать без Monsieur Лойда.",shape=box,color=blue];
		j193270395 -> j3052135670;
		j193270395 -> j3840532702;
	j255876810 [label="+5 Chemistry",color=orange];
		j255876810 -> j1199103299;
	j2244802588 [label="Представь, целая стая летающих черепов, идеальных и безупречно эффективных!",shape=box,color=blue];
		j2244802588 -> j3840532702;
		j2244802588 -> j3966462263;
	j2006950412 [label="Тебе нравилось ухаживать за кладбищами?",shape=box,color=red];
		j2006950412 -> j2043031419;
	j1013807470 [label="Они когда-нибудь отвечали?",shape=box,color=red];
		j1013807470 -> j2884801127;
	j303435886 [label="Хочешь узнать об Отаке? Или почему ты не можешь с ним поговорить?",shape=box,color=red];
		j303435886 -> j3185178571;
	j1824847839 [label="Отака трудно объяснить...",shape=box,color=red];
		j1824847839 -> j3287217001;
	j3052135670 [label="Я бы сказала, что это своеобразный романтический жест, но мне не с чего судить.",shape=box,color=red];
		j3052135670 -> j4069502763;
	j3840532702 [label="Честно, я бы совсем не против, если бы некралойд порхал у меня дома.",shape=box,color=red];
		j3840532702 -> j1735766093;
	j1199103299 [label="Трагично и прекрасно по-своему, non? Дань его любви и уважения, ведь он считал, что без Monsieur Лойда эта странная лаборатория просто не выживет.",shape=box,color=blue];
		j1199103299 -> j3187447999;
		j1199103299 -> j3052135670;
	j3966462263 [label="Честно говоря, меня радует, что он один. Думаю, мир к этому ещё не готов.",shape=box,color=red];
		j3966462263 -> j1834195325;
	j2043031419 [label="И мавзолеи, и крипты, о да. Но признаю, мне больше нравились кладбища под открытым небом, хоть там и было трудно передвигаться в кресле. Боюсь, что не труднее, чем по лестницам.",shape=box,color=blue];
		j2043031419 -> j2427967412;
	j2884801127 [label="Ха! Нет, к счастью. Пока твой «Некралойд» с таким мрачным обликом не ответил мне. Если говорить с мёртвыми это дар Светил, то мне он пока неизвестен.",shape=box,color=blue];
		j2884801127 -> j1524105973;
	j3185178571 [label="Полагаю, что со временем я хочу узнать и то и другое, но позволю решить тебе, с чего начать. Не знаю, что важнее, après tout.",shape=box,color=blue];
		j3185178571 -> j3287217001;
	j3287217001 [label="Check boolean LoidFamilyComplete",color=orange];
		j3287217001 -> j2194613108 [label=true,color=green];
		j3287217001 -> j2194613108 [label=false,color=brown];
		j3287217001 -> j2219829284 [label=false,color=brown];
	j4069502763 [label="И вот теперь я заинтригована, но, похоже, это рассказ для другого раза. Cela dit...",shape=box,color=blue];
		j4069502763 -> j191081418;
	j1735766093 [label="Тогда я совершенно уверена, что тебя одолевает либо потребность в компании, либо в порядке, либо и то и другое. Но это разговор для другого раза.",shape=box,color=blue];
		j1735766093 -> j191081418;
	j3187447999 [label="Думаю, тут всё больше сводилось к тому, чтобы не позволить этому месту развалиться по швам, чем к чему-то ещё.",shape=box,color=red];
		j3187447999 -> j3581241505;
	j1834195325 [label="В самом деле! Как и меня. Что приводит меня к следующему вопросу.",shape=box,color=blue];
		j1834195325 -> j191081418;
	j2427967412 [label="Boolean MarieSerum1 is now true.",color=orange];
		j2427967412 -> j3297056699;
		j2427967412 -> j969516064;
	j1524105973 [label="Нет, слышать духов и голоса это куда больше удел моего дорогого Лиона, чем мой. Хотя я и думаю, не преследует ли Monsieur Некралойда привидение, судя по детским каракулям на затылке.",shape=box,color=blue];
		j1524105973 -> j603404815;
	j2194613108 [label="Раньше Отак был архимедиан, учёным и академиком Орокин. То, что с ним произошло, нельзя назвать особенно радостной историей.",shape=box,color=red];
		j2194613108 -> j3635013123;
	j2219829284 [label="Ну... короче говоря, некоторые из семьи Энтрати находятся наверху, и они... не совсем знают, что мы здесь, внизу.",shape=box,color=red];
		j2219829284 -> j2720451073;
	j3581241505 [label="И вполне может быть именно так. Этот летающий Амальгам, похоже, лишён большей части того, что составляло raison d’être и тонкость настоящего Monsieur Лойда. Cela dit...",shape=box,color=blue];
		j3581241505 -> j191081418;
	j3297056699 [label="Я не знаю, будет ли уместно спрашивать, изменила ли сыворотка твои ноги...",shape=box,color=red];
		j3297056699 -> j2980205143;
	j969516064 [label="Твой стул?",shape=box,color=red];
		j969516064 -> j3096238836;
	j603404815 [label="Собственно, поэтому я и пришла поговорить с тобой, если ты не возражаешь.",shape=box,color=blue];
		j603404815 -> j3444537097;
	j3635013123 [label="Boolean MarieOtak1 is now true.",color=orange];
		j3635013123 -> j4045614372;
	j2720451073 [label="Boolean MarieFamily1 is now true.",color=orange];
		j2720451073 -> j4275229205;
	j2980205143 [label="+10 Chemistry",color=orange];
		j2980205143 -> j339426945;
	j3096238836 [label="Не знаю, как ты это назовёшь? Un fauteuil roulant или, быть может, термин, который я глубоко ненавижу, un fauteuil pour invalide.",shape=box,color=blue];
		j3096238836 -> j1445180334;
	j4045614372 [label="Par les Luminaires... пожалуйста, продолжай.",shape=box,color=blue];
		j4045614372 -> j2162193203;
	j4275229205 [label="Par les Luminaires... Ты имеешь в виду, что мы все здесь, внизу, в тайне?! Так вот почему нам не разрешают покидать это место?! Mais pourquoi?!",shape=box,color=blue];
		j4275229205 -> j3395578804;
	j339426945 [label="О! О, бедняжка. Представляю, как ты сидишь и думаешь, вдруг le Cardinal отнял у меня mes pieds! Non, non, non - ничего подобного.",shape=box,color=blue];
		j339426945 -> j3344826629;
	j1445180334 [label="Как то, на чём мы сейчас сидим перед этими очаровательными маленькими устройствами связи. Только с колёсами по бокам, для передвижения. Кресло на колёсах, если угодно.",shape=box,color=blue];
		j1445180334 -> j2951989697;
		j1445180334 -> j3885324694;
	j2162193203 [label="Судя по всему, он был гением и умом, стоящим за освоением кристаллов аргона.",shape=box,color=red];
		j2162193203 -> j936509184;
	j3395578804 [label="Его дочь, Эйлерия, известная как Мать, и её семья всё это время заботились о Деймосе.",shape=box,color=red];
		j3395578804 -> j2920930969;
	j3344826629 [label="По воли Сол мне было суждено родиться с непослушными ногами. Я не могла ходить.",shape=box,color=blue];
		j3344826629 -> j985211079;
	j2951989697 [label="Ты была инвалидом до того, как стала протофреймом?",shape=box,color=red];
		j2951989697 -> j2347637240;
	j3885324694 [label="Мы называем их инвалидные кресла, хочешь верь, хочешь нет.",shape=box,color=red];
		j3885324694 -> j79897718;
	j936509184 [label="Которые извлекаются из Бездны, именно благодаря им мы можем создавать множество мощных варфреймов и оружия.",shape=box,color=red];
		j936509184 -> j2600879153;
	j2920930969 [label="Присматривали за этим местом и за сердцем, что гонит энергию Бездны в Изначальную Систему, удерживая всех нас... в рабочем состоянии, с тех пор как исчез Энтрати.",shape=box,color=red];
		j2920930969 -> j3173460060;
	j985211079 [label="Но это было не более чем неудобство.",shape=box,color=blue];
		j985211079 -> j468362192;
	j2347637240 [label="Non. Совсем даже нет.",shape=box,color=blue];
		j2347637240 -> j3350176257;
	j79897718 [label="Ха! Ох, как же я сидя здесь смеюсь над собой за то, что была такой дурой. Да, полагаю, ты называешь их инвалидными креслами, ведь это кресла с колёсами. Глупая я.",shape=box,color=blue];
		j79897718 -> j468362192;
	j2600879153 [label="Он специализировался на кристаллографии. И его труды были сохранены здесь, в лабораториях.",shape=box,color=red];
		j2600879153 -> j4218246315;
	j3173460060 [label="Check /Lotus/Scripts/1999/DialogueScriptNodes.lua:CheckDuviriMitwCollectibles",color=orange];
		j3173460060 -> j2978148389 [label=true,color=green];
		j3173460060 -> j2362593335 [label=false,color=brown];
	j468362192 [label="Хотя, признаюсь, я не скучаю по необходимости подталкивать себя. И Лион, думаю, тоже. Какая же это свобода иметь возможность летать!",shape=box,color=blue];
		j468362192 -> j2407409997;
		j468362192 -> j272184406;
		j468362192 -> j3723534956;
	j3350176257 [label="Boolean MarieInvalid is now true.",color=orange];
		j3350176257 -> "Chat ends.";
	j4218246315 [label="По какой-то причине, я не знаю, его превратили в Цефалона и дали ему собственную некралоидную оболочку.",shape=box,color=red];
		j4218246315 -> j3146408142;
	j2978148389 [label="Она смирилась с его отсутствием, и они примирились друг с другом, но это далось им нелегко.",shape=box,color=red];
		j2978148389 -> j4014309364;
	j2362593335 [label="Check boolean MarieSyndicateMaxRank",color=orange];
		j2362593335 -> j2978148389 [label=true,color=green];
		j2362593335 -> j52993684 [label=false,color=brown];
	j2407409997 [label="Я стараюсь думать о инвалидности как о том, что меняет нас. Да, она ограничивает нас в некоторых вещах, но при этом может давать нам силы, которых нет у других.",shape=box,color=red];
		j2407409997 -> j2566889646;
	j272184406 [label="Ты никогда не считала своё состояние проблемой?",shape=box,color=red];
		j272184406 -> j2149563762;
	j3723534956 [label="Ты знала, что сыворотка протофрейма сделает с тобой это?",shape=box,color=red];
		j3723534956 -> j3787685678;
	j3146408142 [label="Не все Цефалоны были созданы в наказание. Но здесь, на Деймосе, дела пошли... плохо, и он был серьёзно повреждён.",shape=box,color=red];
		j3146408142 -> j500508084;
	j4014309364 [label="Зная, что он все ещё где-то там, творит, и что он не сказал ей ни слова и даже не отправил письма?..",shape=box,color=red];
		j4014309364 -> j2139109191;
	j52993684 [label="Она не может смириться с его отсутствием, и они готовы вцепиться друг другу в глотки.",shape=box,color=red];
		j52993684 -> j2425033497;
	j2566889646 [label="+5 Chemistry",color=orange];
		j2566889646 -> j2220689269;
	j2149563762 [label="Я никогда не видела смысла жаловаться. Честно говоря, я уж точно радуюсь способности доставать предметы с верхних полок без посторонней помощи.",shape=box,color=blue];
		j2149563762 -> j702072762;
	j3787685678 [label="Oui, le Cardinal сказал Лиону и мне обо всём, что произойдёт после принятия сывороток, изменивших наши формы. Мы знали, что они сделают.",shape=box,color=blue];
		j3787685678 -> j1094281875;
	j500508084 [label="+5 Chemistry",color=orange];
		j500508084 -> j3409740452;
	j2139109191 [label="Не могу представить, как это больно для неё. Для них обоих.",shape=box,color=red];
		j2139109191 -> j3856864556;
	j2425033497 [label="Зная, что он все ещё где-то там, творит, и что он не сказал ей ни слова и даже не отправил письма?..",shape=box,color=red];
		j2425033497 -> j1622967304;
	j2220689269 [label="Boolean MarieSecretPower is now true.",color=orange];
		j2220689269 -> j3847829276;
	j702072762 [label="Ce qui est fait est fait. Я не могла молить Сола о чуде, когда столько других вокруг меня страдали сильнее, когда было так много тех, кто нуждался больше. Люминарии уже дали мне так много.",shape=box,color=blue];
		j702072762 -> j1664829539;
	j1094281875 [label="Но, как и во всём, я приняла свою с радостью, а Лион принял свою... ох, я боюсь, будто выдаю его и не должна.",shape=box,color=blue];
		j1094281875 -> j806752801;
		j1094281875 -> j1980160073;
	j3409740452 [label="Pauvre petit...",shape=box,color=blue];
		j3409740452 -> j2040206634;
	j3856864556 [label="Хотя я понимаю логику решения защитить их от боли, причинённой le Cardinal его неизбежным уходом...",shape=box,color=blue];
		j3856864556 -> j4270759633;
	j1622967304 [label="Это уничтожило бы ту малую надежду на примирение, которая у них могла бы быть.",shape=box,color=red];
		j1622967304 -> j2943111203;
	j3847829276 [label="Oui! Ты понимаешь. Я знала мир с другого ракурса. Мои руки были сильнее. Я стала терпеливее. Я знаю, что значит наслаждаться мгновением.",shape=box,color=blue];
		j3847829276 -> j3002232370;
	j1664829539 [label="Мне нужно идти. Спасибо за это чудесное отвлечение. ",shape=box,color=blue];
		j1664829539 -> "Chat ends.";
	j806752801 [label="Всё в порядке. Не говори больше, чем тебе комфортно.",shape=box,color=red];
		j806752801 -> j3895269193;
	j1980160073 [label="Пожалуйста, продолжай. Мне трудно достучаться до него.",shape=box,color=red];
		j1980160073 -> j825356554;
	j2040206634 [label="Итак, его перевели к основному некралойду, единственному оставшемуся некралойду - и он... ну? Сложно объяснить.",shape=box,color=red];
		j2040206634 -> j647926155;
		j2040206634 -> j3267458338;
		j2040206634 -> j3741808877;
	j4270759633 [label="Я считаю это неоправданно жестоким, не так ли? Они могут подумать, что он мёртв. Или ещё хуже! А мы, живущие здесь, comme des rats d'égout?",shape=box,color=blue];
		j4270759633 -> j230311368;
		j4270759633 -> j2432194580;
		j4270759633 -> j391001991;
	j2943111203 [label="+10 Chemistry",color=orange];
		j2943111203 -> j911451572;
	j3002232370 [label="Когда я достигаю места назначения, я наслаждаюсь его изяществом. Я не сную туда-сюда, как жучок с миллиардом маленьких ножек.",shape=box,color=blue];
		j3002232370 -> j3508057383;
	j3895269193 [label="+5 Chemistry",color=orange];
		j3895269193 -> j3627770300;
	j825356554 [label="+5 Chemistry",color=orange];
		j825356554 -> j1181087562;
	j647926155 [label="Честно говоря, я бы хотел его вылечить. Верните настоящего Отака.",shape=box,color=red];
		j647926155 -> j124713806;
	j3267458338 [label="Он заставляет меня улыбаться. Он забавный, но за этим скрывается что‑то трагичное и сломленное.",shape=box,color=red];
		j3267458338 -> j532153709;
	j3741808877 [label="К сожалению, его уже не вылечить. И, думаю, он сильно действует на нервы многим. ",shape=box,color=red];
		j3741808877 -> j459246906;
	j230311368 [label="Ты права. Хотелось бы, чтобы мы могли что-то сделать.",shape=box,color=red];
		j230311368 -> j2276822723;
	j2432194580 [label="На самом деле, это не моё решение.",shape=box,color=red];
		j2432194580 -> j1795058871;
	j391001991 [label="У меня есть друг, который обожает крыс. Я считаю их очаровательными.",shape=box,color=red];
		j391001991 -> j709090948;
	j911451572 [label="Oui... Я понимаю логику. Тогда была бы попытка с твоей стороны примирить их семью, не так ли? Похоже, это единственная надежда для всех нас выбраться из этого места. ",shape=box,color=blue];
		j911451572 -> j4223388215;
	j3508057383 [label="Я просто желаю, чтобы мой дорогой Лион мог видеть мир так же, как ты. Чтобы все неудобства могли быть тайной силой, как ты говоришь.",shape=box,color=blue];
		j3508057383 -> j4148783941;
	j3627770300 [label="Я ценю твою доброту, Скиталец. Я просто оставлю всё так, чтобы не переступить через любые неудобства, которые могу тебе причинить...",shape=box,color=blue];
		j3627770300 -> j2554872442;
	j1181087562 [label="Ты не одинок в этом, Скиталец. Лион как семья для меня, и всё же иногда я задаюсь вопросом, знаю ли я его больше, чем статуи святых в соборе.",shape=box,color=blue];
		j1181087562 -> j873274315;
	j124713806 [label="+15 Chemistry",color=orange];
		j124713806 -> j2275636256;
	j532153709 [label="+15 Chemistry",color=orange];
