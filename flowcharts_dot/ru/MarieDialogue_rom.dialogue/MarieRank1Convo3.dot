	j1795058871 [label="Я знаю. Это решение Monsieur Лойда и всех остальных, дать о себе знать.",shape=box,color=blue];
		j1795058871 -> j1853342276;
	j709090948 [label="+10 Chemistry",color=orange];
		j709090948 -> j3644384736;
	j4223388215 [label="Чтобы нам не провести остаток жизни здесь, comme des rats d'égout. ",shape=box,color=blue];
