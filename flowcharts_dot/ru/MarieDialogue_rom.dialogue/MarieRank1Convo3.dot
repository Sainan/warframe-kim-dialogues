digraph {
	77 [label="MarieRank1Convo3 begins.",color=orange];
		77 -> 78;
	78 [label="Il y a un crâne volant! Keksekça?! Тут летает говорящий череп, и все продолжают заниматься своими делами, будто ничего странного не происходит, а я просто хочу, чтобы кто-то признал, насколько это безумно.",shape=box,color=blue];
		78 -> 79;
		78 -> 81;
		78 -> 80;
	79 [label="Это просто Некралойд. Ну, один из некралойдов. Всё сложно.",shape=box,color=red];
		79 -> 82;
	81 [label="Это Некралойд. Он Цефалон, он не причинит тебе вреда.",shape=box,color=red];
		81 -> 84;
	80 [label="[Конец.]",shape=box,color=red];
		80 -> 83;
	82 [label="Прошу прощения, это имя или предмет?",shape=box,color=blue];
		82 -> 85;
		82 -> 86;
	84 [label="Я не считаю его угрозой! Он меня не пугает.",shape=box,color=blue];
		84 -> 87;
	83 [label="Chat ends.",color=orange];
	85 [label="Я... не имею об этом полного представления.",shape=box,color=red];
		85 -> 88;
	86 [label="Да.",shape=box,color=red];
		86 -> 89;
	87 [label="На самом деле, нахожу его совершенно очаровательным, хоть он и немного упрям в разговоре. Совсем как его живой прототип. Но с учётом природы моего любимого спутника, можешь понять, что это меня не особенно смущает.",shape=box,color=blue];
		87 -> 90;
	88 [label="Во-первых, чьё это творение, эти «Некралойды»? Это имя, или, быть может, обозначение?",shape=box,color=blue];
		88 -> 91;
		88 -> 92;
	89 [label="Я... не понимаю. И как в это вписывается Лойд?",shape=box,color=blue];
		89 -> 88;
	90 [label="Нет, то, что ты можешь считать гротескным в его облике, уверяю, не является моей проблемой сейчас.",shape=box,color=blue];
		90 -> 93;
		90 -> 94;
	91 [label="Твой Cardinal Dimanche. Энтрати.",shape=box,color=red];
		91 -> 95;
	92 [label="Его создал Энтрати. Но сама концепция цефалонов была изобретением Орокин.",shape=box,color=red];
		92 -> 95;
	93 [label="Удивительно, что тебя не пугает череп.",shape=box,color=red];
		93 -> 96;
	94 [label="Признаю, вне контекста он, должно быть, кажется странным. Но что именно тебя тревожит?",shape=box,color=red];
		94 -> 97;
	95 [label="Excusez-moi, ты хочешь сказать, что le Cardinal создал копию летающего черепа-слуги по подобию своего спутника и назвал в его честь?",shape=box,color=blue];
		95 -> 98;
	96 [label="Ты мало обо мне знаешь, и в том нет твоей вины. Я провела большую часть жизни, заботясь о мёртвых и местах их упокоения. ",shape=box,color=blue];
		96 -> 99;
	97 [label="Мне любопытно, почему у него на спине есть ещё одно лицо, похожее на детский набросок.",shape=box,color=blue];
		97 -> 100;
	98 [label="Почему же тогда их так мало, этих некралойдов?",shape=box,color=blue];
		98 -> 101;
		98 -> 102;
		98 -> 103;
	99 [label="И правда, я провела большую часть жизни в их обществе. Они охотно выслушивали мои дневные заботы.",shape=box,color=blue];
		99 -> 104;
	100 [label="Я спросила и Monsieur Некралоид, и Monsieur Лойда, но оба не захотели говорить об этом. Они лишь назвали имя. Отак. И произнесли его с большой печалью.",shape=box,color=blue];
		100 -> 105;
	101 [label="Может, он осознал, насколько ужасно создавать цифровую копию своего возлюбленного.",shape=box,color=red];
		101 -> 106;
	102 [label="Может, он изначально собирался сделать только одного.",shape=box,color=red];
		102 -> 107;
	103 [label="Не знаю. Может, просто не успел создать больше?",shape=box,color=red];
		103 -> 108;
	104 [label="Update boolean MarieGraveyard1",color=orange];
		104 -> 109;
		104 -> 110;
	105 [label="И вот я здесь, разговариваю с тобой в надежде, что ты сможешь мне помочь.",shape=box,color=blue];
		105 -> 111;
		105 -> 112;
	106 [label="Ou bien, это была дань его любви и уважения. Он не считал, что эта странная лаборатория может продолжать работать без Monsieur Лойда.",shape=box,color=blue];
		106 -> 113;
		106 -> 114;
	107 [label="+5 Chemistry",color=orange];
		107 -> 115;
	108 [label="Представь, целая стая летающих черепов, идеальных и безупречно эффективных!",shape=box,color=blue];
		108 -> 114;
		108 -> 116;
	109 [label="Тебе нравилось ухаживать за кладбищами?",shape=box,color=red];
		109 -> 117;
	110 [label="Они когда-нибудь отвечали?",shape=box,color=red];
		110 -> 118;
	111 [label="Хочешь узнать об Отаке? Или почему ты не можешь с ним поговорить?",shape=box,color=red];
		111 -> 119;
	112 [label="Отака трудно объяснить...",shape=box,color=red];
		112 -> 2918;
	113 [label="Я бы сказала, что это своеобразный романтический жест, но мне не с чего судить.",shape=box,color=red];
		113 -> 122;
	114 [label="Честно, я бы совсем не против, если бы некралойд порхал у меня дома.",shape=box,color=red];
		114 -> 123;
	115 [label="Трагично и прекрасно по-своему, non? Дань его любви и уважения, ведь он считал, что без Monsieur Лойда эта странная лаборатория просто не выживет.",shape=box,color=blue];
		115 -> 124;
		115 -> 113;
	116 [label="Честно говоря, меня радует, что он один. Думаю, мир к этому ещё не готов.",shape=box,color=red];
		116 -> 125;
	117 [label="И мавзолеи, и крипты, о да. Но признаю, мне больше нравились кладбища под открытым небом, хоть там и было трудно передвигаться в кресле. Боюсь, что не труднее, чем по лестницам.",shape=box,color=blue];
		117 -> 126;
	118 [label="Ха! Нет, к счастью. Пока твой «Некралойд» с таким мрачным обликом не ответил мне. Если говорить с мёртвыми это дар Светил, то мне он пока неизвестен.",shape=box,color=blue];
		118 -> 127;
	119 [label="Полагаю, что со временем я хочу узнать и то и другое, но позволю решить тебе, с чего начать. Не знаю, что важнее, après tout.",shape=box,color=blue];
		119 -> 2918;
	2918 [label="Check boolean LoidFamilyComplete",color=orange];
		2918 -> 121 [label=true,color=green];
		2918 -> 121 [label=false,color=brown];
		2918 -> 120 [label=false,color=brown];
	122 [label="И вот теперь я заинтригована, но, похоже, это рассказ для другого раза. Cela dit...",shape=box,color=blue];
		122 -> 97;
	123 [label="Тогда я совершенно уверена, что тебя одолевает либо потребность в компании, либо в порядке, либо и то и другое. Но это разговор для другого раза.",shape=box,color=blue];
		123 -> 97;
	124 [label="Думаю, тут всё больше сводилось к тому, чтобы не позволить этому месту развалиться по швам, чем к чему-то ещё.",shape=box,color=red];
		124 -> 130;
	125 [label="В самом деле! Как и меня. Что приводит меня к следующему вопросу.",shape=box,color=blue];
		125 -> 97;
	126 [label="Update boolean MarieSerum1",color=orange];
		126 -> 131;
		126 -> 132;
	127 [label="Нет, слышать духов и голоса это куда больше удел моего дорогого Лиона, чем мой. Хотя я и думаю, не преследует ли Monsieur Некралойда привидение, судя по детским каракулям на затылке.",shape=box,color=blue];
		127 -> 133;
	121 [label="Раньше Отак был архимедиан, учёным и академиком Орокин. То, что с ним произошло, нельзя назвать особенно радостной историей.",shape=box,color=red];
		121 -> 129;
	120 [label="Ну... короче говоря, некоторые из семьи Энтрати находятся наверху, и они... не совсем знают, что мы здесь, внизу.",shape=box,color=red];
		120 -> 128;
	130 [label="И вполне может быть именно так. Этот летающий Амальгам, похоже, лишён большей части того, что составляло raison d’être и тонкость настоящего Monsieur Лойда. Cela dit...",shape=box,color=blue];
		130 -> 97;
	131 [label="Я не знаю, будет ли уместно спрашивать, изменила ли сыворотка твои ноги...",shape=box,color=red];
		131 -> 136;
	132 [label="Твой стул?",shape=box,color=red];
		132 -> 137;
	133 [label="Собственно, поэтому я и пришла поговорить с тобой, если ты не возражаешь.",shape=box,color=blue];
		133 -> 100;
	129 [label="Update boolean MarieOtak1",color=orange];
		129 -> 135;
	128 [label="Update boolean MarieFamily1",color=orange];
		128 -> 134;
	136 [label="+10 Chemistry",color=orange];
		136 -> 140;
	137 [label="Не знаю, как ты это назовёшь? Un fauteuil roulant или, быть может, термин, который я глубоко ненавижу, un fauteuil pour invalide.",shape=box,color=blue];
		137 -> 141;
	135 [label="Par les Luminaires... пожалуйста, продолжай.",shape=box,color=blue];
		135 -> 139;
	134 [label="Par les Luminaires... Ты имеешь в виду, что мы все здесь, внизу, в тайне?! Так вот почему нам не разрешают покидать это место?! Mais pourquoi?!",shape=box,color=blue];
		134 -> 138;
	140 [label="О! О, бедняжка. Представляю, как ты сидишь и думаешь, вдруг le Cardinal отнял у меня mes pieds! Non, non, non - ничего подобного.",shape=box,color=blue];
		140 -> 144;
	141 [label="Как то, на чём мы сейчас сидим перед этими очаровательными маленькими устройствами связи. Только с колёсами по бокам, для передвижения. Кресло на колёсах, если угодно.",shape=box,color=blue];
		141 -> 145;
		141 -> 146;
	139 [label="Судя по всему, он был гением и умом, стоящим за освоением кристаллов аргона.",shape=box,color=red];
		139 -> 143;
	138 [label="Его дочь, Эйлерия, известная как Мать, и её семья всё это время заботились о Деймосе.",shape=box,color=red];
		138 -> 142;
	144 [label="По воли Сол мне было суждено родиться с непослушными ногами. Я не могла ходить.",shape=box,color=blue];
		144 -> 149;
	145 [label="Ты была инвалидом до того, как стала протофреймом?",shape=box,color=red];
		145 -> 150;
	146 [label="Мы называем их инвалидные кресла, хочешь верь, хочешь нет.",shape=box,color=red];
		146 -> 151;
	143 [label="Которые извлекаются из Бездны, именно благодаря им мы можем создавать множество мощных варфреймов и оружия.",shape=box,color=red];
		143 -> 148;
	142 [label="Присматривали за этим местом и за сердцем, что гонит энергию Бездны в Изначальную Систему, удерживая всех нас... в рабочем состоянии, с тех пор как исчез Энтрати.",shape=box,color=red];
		142 -> 861;
	149 [label="Но это было не более чем неудобство.",shape=box,color=blue];
		149 -> 155;
	150 [label="Non. Совсем даже нет.",shape=box,color=blue];
		150 -> 156;
	151 [label="Ха! Ох, как же я сидя здесь смеюсь над собой за то, что была такой дурой. Да, полагаю, ты называешь их инвалидными креслами, ведь это кресла с колёсами. Глупая я.",shape=box,color=blue];
		151 -> 155;
	148 [label="Он специализировался на кристаллографии. И его труды были сохранены здесь, в лабораториях.",shape=box,color=red];
		148 -> 154;
	861 [label="Check /Lotus/Scripts/1999/DialogueScriptNodes.lua:IsSyndicateRank",color=orange];
		861 -> 152 [label=true,color=green];
		861 -> 153 [label=false,color=brown];
	155 [label="Хотя, признаюсь, я не скучаю по необходимости подталкивать себя. И Лион, думаю, тоже. Какая же это свобода иметь возможность летать!",shape=box,color=blue];
		155 -> 160;
		155 -> 161;
		155 -> 162;
	156 [label="Update boolean MarieInvalid",color=orange];
		156 -> 163;
	154 [label="По какой-то причине, я не знаю, его превратили в Цефалона и дали ему собственную некралоидную оболочку.",shape=box,color=red];
		154 -> 159;
	152 [label="Она смирилась с его отсутствием, и они примирились друг с другом, но это далось им нелегко.",shape=box,color=red];
		152 -> 157;
	153 [label="Она не может смириться с его отсутствием, и они готовы вцепиться друг другу в глотки.",shape=box,color=red];
		153 -> 158;
	160 [label="Я стараюсь думать о инвалидности как о том, что меняет нас. Да, она ограничивает нас в некоторых вещах, но при этом может давать нам силы, которых нет у других.",shape=box,color=red];
		160 -> 167;
	161 [label="Ты никогда не считала своё состояние проблемой?",shape=box,color=red];
		161 -> 168;
	162 [label="Ты знала, что сыворотка протофрейма сделает с тобой это?",shape=box,color=red];
		162 -> 169;
	163 [label="Chat ends.",color=orange];
	159 [label="Не все Цефалоны были созданы в наказание. Но здесь, на Деймосе, дела пошли... плохо, и он был серьёзно повреждён.",shape=box,color=red];
		159 -> 166;
	157 [label="Зная, что он все ещё где-то там, творит, и что он не сказал ей ни слова и даже не отправил письма?..",shape=box,color=red];
		157 -> 164;
	158 [label="Зная, что он все ещё где-то там, творит, и что он не сказал ей ни слова и даже не отправил письма?..",shape=box,color=red];
		158 -> 165;
	167 [label="+5 Chemistry",color=orange];
		167 -> 173;
	168 [label="Я никогда не видела смысла жаловаться. Честно говоря, я уж точно радуюсь способности доставать предметы с верхних полок без посторонней помощи.",shape=box,color=blue];
		168 -> 174;
	169 [label="Oui, le Cardinal сказал Лиону и мне обо всём, что произойдёт после принятия сывороток, изменивших наши формы. Мы знали, что они сделают.",shape=box,color=blue];
		169 -> 175;
	166 [label="+5 Chemistry",color=orange];
		166 -> 172;
	164 [label="Не могу представить, как это больно для неё. Для них обоих.",shape=box,color=red];
		164 -> 170;
	165 [label="Это уничтожило бы ту малую надежду на примирение, которая у них могла бы быть.",shape=box,color=red];
		165 -> 171;
	173 [label="Update boolean MarieSecretPower",color=orange];
		173 -> 179;
	174 [label="Ce qui est fait est fait. Я не могла молить Сола о чуде, когда столько других вокруг меня страдали сильнее, когда было так много тех, кто нуждался больше. Люминарии уже дали мне так много.",shape=box,color=blue];
		174 -> 180;
	175 [label="Но, как и во всём, я приняла свою с радостью, а Лион принял свою... ох, я боюсь, будто выдаю его и не должна.",shape=box,color=blue];
		175 -> 181;
		175 -> 182;
	172 [label="Pauvre petit...",shape=box,color=blue];
		172 -> 178;
	170 [label="Хотя я понимаю логику решения защитить их от боли, причинённой le Cardinal его неизбежным уходом...",shape=box,color=blue];
		170 -> 176;
	171 [label="+10 Chemistry",color=orange];
		171 -> 177;
	179 [label="Oui! Ты понимаешь. Я знала мир с другого ракурса. Мои руки были сильнее. Я стала терпеливее. Я знаю, что значит наслаждаться мгновением.",shape=box,color=blue];
		179 -> 190;
	180 [label="Мне нужно идти. Спасибо за это чудесное отвлечение. ",shape=box,color=blue];
		180 -> 191;
	181 [label="Всё в порядке. Не говори больше, чем тебе комфортно.",shape=box,color=red];
		181 -> 192;
	182 [label="Пожалуйста, продолжай. Мне трудно достучаться до него.",shape=box,color=red];
		182 -> 193;
	178 [label="Итак, его перевели к основному некралойду, единственному оставшемуся некралойду - и он... ну? Сложно объяснить.",shape=box,color=red];
		178 -> 187;
		178 -> 188;
		178 -> 189;
	176 [label="Я считаю это неоправданно жестоким, не так ли? Они могут подумать, что он мёртв. Или ещё хуже! А мы, живущие здесь, comme des rats d'égout?",shape=box,color=blue];
		176 -> 183;
		176 -> 184;
		176 -> 185;
	177 [label="Oui... Я понимаю логику. Тогда была бы попытка с твоей стороны примирить их семью, не так ли? Похоже, это единственная надежда для всех нас выбраться из этого места. ",shape=box,color=blue];
		177 -> 186;
	190 [label="Когда я достигаю места назначения, я наслаждаюсь его изяществом. Я не сную туда-сюда, как жучок с миллиардом маленьких ножек.",shape=box,color=blue];
		190 -> 202;
	191 [label="Chat ends.",color=orange];
	192 [label="+5 Chemistry",color=orange];
		192 -> 203;
	193 [label="+5 Chemistry",color=orange];
		193 -> 204;
	187 [label="Честно говоря, я бы хотел его вылечить. Верните настоящего Отака.",shape=box,color=red];
		187 -> 199;
	188 [label="Он заставляет меня улыбаться. Он забавный, но за этим скрывается что‑то трагичное и сломленное.",shape=box,color=red];
		188 -> 200;
	189 [label="К сожалению, его уже не вылечить. И, думаю, он сильно действует на нервы многим. ",shape=box,color=red];
		189 -> 201;
	183 [label="Ты права. Хотелось бы, чтобы мы могли что-то сделать.",shape=box,color=red];
		183 -> 194;
	184 [label="На самом деле, это не моё решение.",shape=box,color=red];
		184 -> 195;
	185 [label="У меня есть друг, который обожает крыс. Я считаю их очаровательными.",shape=box,color=red];
		185 -> 196;
	186 [label="Чтобы нам не провести остаток жизни здесь, comme des rats d'égout. ",shape=box,color=blue];
		186 -> 197;
		186 -> 198;
	202 [label="Я просто желаю, чтобы мой дорогой Лион мог видеть мир так же, как ты. Чтобы все неудобства могли быть тайной силой, как ты говоришь.",shape=box,color=blue];
		202 -> 213;
	203 [label="Я ценю твою доброту, Скиталец. Я просто оставлю всё так, чтобы не переступить через любые неудобства, которые могу тебе причинить...",shape=box,color=blue];
		203 -> 214;
	204 [label="Ты не одинок в этом, Скиталец. Лион как семья для меня, и всё же иногда я задаюсь вопросом, знаю ли я его больше, чем статуи святых в соборе.",shape=box,color=blue];
		204 -> 215;
	199 [label="+15 Chemistry",color=orange];
		199 -> 210;
	200 [label="+15 Chemistry",color=orange];
		200 -> 211;
	201 [label="+15 Chemistry",color=orange];
		201 -> 212;
	194 [label="Add 1 to Family",color=orange];
		194 -> 205;
	195 [label="Я знаю. Это решение Monsieur Лойда и всех остальных, дать о себе знать.",shape=box,color=blue];
		195 -> 206;
	196 [label="+10 Chemistry",color=orange];
		196 -> 207;
	197 [label="Это была моя небрежность. Твоя правда. Пора браться за дело.",shape=box,color=red];
		197 -> 208;
