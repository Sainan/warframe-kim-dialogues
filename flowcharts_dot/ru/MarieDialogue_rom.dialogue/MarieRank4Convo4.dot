digraph {
	graph [fontname="Roboto Condensed"];
	node [fontname="Roboto Condensed"];
	edge [fontname="Roboto Condensed"];

	"MarieRank4Convo4 begins." [color=orange];
		"MarieRank4Convo4 begins." -> j2981219499;
	j2981219499 [label="Boolean MarieLyonAvailable is now true.",color=orange];
		j2981219499 -> j3022194826;
	j3022194826 [label="Check boolean MarieTagferFight1",color=orange];
		j3022194826 -> j1284672368 [label=true,color=green];
		j3022194826 -> j3355906501 [label=true,color=green];
		j3022194826 -> j1310452999 [label=true,color=green];
		j3022194826 -> "Chat ends." [label=false,color=brown];
	j1284672368 [label="Мари, мы можем поговорить?",shape=box,color=red];
		j1284672368 -> j1719471724;
	j3355906501 [label="Роут рассказал мне о... драке с Тагфером. Можем ли мы поговорить об этом?",shape=box,color=red];
		j3355906501 -> j3650134096;
	j1310452999 [label="[Конец.]",shape=box,color=red];
		j1310452999 -> "Chat ends.";
	"Chat ends." [color=orange];
	j1719471724 [label="Oui, хотя мне кажется, я знаю, о чём речь... Я вёла себя плохо. Кто тебе сказал?",shape=box,color=blue];
		j1719471724 -> j2584949307;
		j1719471724 -> j2328369575;
		j1719471724 -> j1017709644;
	j3650134096 [label="Bien sur, ce salaud de diable ouvre sa bouche et vous raconte tout! Il ne cherche qu'à m'embarrasser!",shape=box,color=blue];
		j3650134096 -> j1868276548;
	j2584949307 [label="Это не важно.",shape=box,color=red];
		j2584949307 -> j3166838119;
	j2328369575 [label="Лойд. ",shape=box,color=red];
		j2328369575 -> j186041899;
	j1017709644 [label="Роут.",shape=box,color=red];
		j1017709644 -> j3650134096;
	j1868276548 [label="Si je le pouvais, je prendrais ce couteau qu'il aime tant utiliser pour agacer les autres et je le fourrerais là où seule Lua peut le voir!",shape=box,color=blue];
		j1868276548 -> j2084715457;
	j3166838119 [label="Думаю это важно, но, похоже, ты просто хочешь пощадить моё настроение. Так что... не буду тебя больше просить.",shape=box,color=blue];
		j3166838119 -> j184808761;
	j186041899 [label="Мне кажется, ты лжешь, чтобы пощадить мое настроение, так что... Я не буду требовать от тебя большего.",shape=box,color=blue];
		j186041899 -> j184808761;
	j2084715457 [label="Простите меня. Это было... неприлично. Я Sœur de Sol, и не должна терять самообладание или позволять себе такие слова.",shape=box,color=blue];
		j2084715457 -> j4250313566;
	j184808761 [label="+5 Chemistry",color=orange];
		j184808761 -> j1439587803;
	j4250313566 [label="+5 Chemistry",color=orange];
		j4250313566 -> j3411295374;
	j1439587803 [label="Я хочу сохранить хотя бы немного достоинства в этом разговоре, если мне еще это позволено.",shape=box,color=blue];
		j1439587803 -> j3820668063;
	j3411295374 [label="Мой гнев направлен не на тебя. И я всегда благодарна тебе за твою откровенность.",shape=box,color=blue];
		j3411295374 -> j2157089083;
	j3820668063 [label="Если ты пришёл поговорить со мной о ссоре, которая была у меня с Monsieur Тагфером, я не стану отрицать, что она произошла.",shape=box,color=blue];
		j3820668063 -> j2157089083;
	j2157089083 [label="Полагаю, дьявол уже рассказал тебе, из-за чего была та ссора?",shape=box,color=blue];
		j2157089083 -> j370765590;
	j370765590 [label="Evaluate expressions",color=orange];
		j370765590 -> j389649571 [label="MarieTagferFight2a",color=purple];
		j370765590 -> j2022350589 [label="MarieTagferFight2a",color=purple];
		j370765590 -> j442009428 [label="MarieTagferFight2b",color=purple];
		j370765590 -> j389649571 [label="MarieTagferFight2b",color=purple];
		j370765590 -> j389649571 [label="false",color=purple];
		j370765590 -> j3967085104 [label="false",color=purple];
	j389649571 [label="Ему не нужно было мне рассказывать, можно было и так догадаться. Энтрати.",shape=box,color=red];
		j389649571 -> j1905469879;
	j2022350589 [label="Да, он рассказал. Хотя, казалось, он больше всего беспокоился о тебе.",shape=box,color=red];
		j2022350589 -> j2102462907;
	j442009428 [label="Да, он рассказал. Он обеспокоен ситуацией, потому что, как мне кажется, он сочувствует Кавии. ",shape=box,color=red];
		j442009428 -> j4111090739;
	j3967085104 [label="Нет, честно. Он просто сказал мне зайти к тебе.",shape=box,color=red];
		j3967085104 -> j1831528703;
	j1905469879 [label="Oui. Monsieur Тагфер спорил на тему Кардинала.",shape=box,color=blue];
		j1905469879 -> j1423548038;
		j1905469879 -> j3292036540;
	j2102462907 [label="Не знаю, зачем дьяволу нужно, чтобы ты в это поверил. И какая ему от этого польза.",shape=box,color=blue];
		j2102462907 -> j1285856966;
	j4111090739 [label="Дьявол видит трех раненых животных и понимает, что он может легко использовать свою харизму, чтобы они ему льстили.",shape=box,color=blue];
		j4111090739 -> j1754972113;
	j1831528703 [label="Я не знаю, почему дьявол захотел бы, чтобы ты сделал такое. Или какой цели, по его мнению, это могло бы послужить.",shape=box,color=blue];
		j1831528703 -> j1287715881;
	j1423548038 [label="Нет, Тагфер не самый большой сторонник Энтрати.",shape=box,color=red];
		j1423548038 -> j781012377;
	j3292036540 [label="Я полагаю, что спор был громким.",shape=box,color=red];
		j3292036540 -> j550028067;
	j1285856966 [label="Все так называемые проявления доброты ко мне со стороны дьявола служат одной цели, настроить меня против Кардинала. Я знаю это. ",shape=box,color=blue];
		j1285856966 -> j3532756109;
	j1754972113 [label="Он делает это, чтобы повернуть ситуацию против меня. Он хочет настроить меня против le Cardinal. Чтобы увидеть, как я отвернусь от него. Я знаю это.",shape=box,color=blue];
		j1754972113 -> j3532756109;
	j1287715881 [label="Но... ведь не для этого ты здесь, чтобы говорить об этом. Ссора была из‑за Кардинала. ",shape=box,color=blue];
		j1287715881 -> j1423548038;
		j1287715881 -> j3292036540;
	j781012377 [label="И вот этого я не понимаю! Посмотри, что им было даровано!",shape=box,color=blue];
		j781012377 -> j2714639259;
		j781012377 -> j1897609141;
	j550028067 [label="Oui! Он назвал меня тупицей. Он сказал, что я всего лишь ребёнок.",shape=box,color=blue];
		j550028067 -> j2922700532;
		j550028067 -> j2714639259;
	j3532756109 [label="И именно о Кардинале мы спорили с Monsieur Тагфером.",shape=box,color=blue];
		j3532756109 -> j1423548038;
		j3532756109 -> j3292036540;
	j2714639259 [label="Пожалуйста, начни с самого начала. Как вообще началась вся эта ссора?",shape=box,color=red];
		j2714639259 -> j1245108309;
	j1897609141 [label="Я начинаю понимать, почему произошла эта ссора.",shape=box,color=red];
		j1897609141 -> j1245108309;
	j2922700532 [label="Он действительно назвал тебя тупым и ребёнком?",shape=box,color=red];
		j2922700532 -> j1089770377;
	j1245108309 [label="Oui. Я упомянула le Cardinal, хотя даже не знаю, что это было ",shape=box,color=blue];
		j1245108309 -> j3013735739;
	j1089770377 [label="Возможно, даже хуже.",shape=box,color=blue];
		j1089770377 -> j2059309783;
	j3013735739 [label="Monsieur Тагфер закатил глаза и фыркнул. Я попросила его объяснить свою насмешку.",shape=box,color=blue];
		j3013735739 -> j251834969;
	j2059309783 [label="«Ты - дитя, Мари! Невинное. Всю жизнь зависимая от других. Свёрнутая в своём маленьком гнёздышке слепой веры!»",shape=box,color=blue];
		j2059309783 -> j2058910450;
	j251834969 [label="«Альбрехт — грязный, вонючий лжец!»",shape=box,color=blue];
		j251834969 -> j4151261249;
	j2058910450 [label="«Выживаешь на том, что твои старшие пережевали и выплюнули тебе в доверчиво разинутый рот!»",shape=box,color=blue];
		j2058910450 -> j471012429;
	j4151261249 [label="Et j'ai répondu, «Посмотрите на дары, которые вам были даны — дары мысли, языка, Я!»",shape=box,color=blue];
		j4151261249 -> j3413838026;
	j471012429 [label="Boolean MarieEntrati3 is now true.",color=orange];
		j471012429 -> j3538436146;
		j471012429 -> j1391333069;
		j471012429 -> j945518527;
	j3413838026 [label="«Вы должны быть благодарны le Cardinal за все, чем он вас благословил».",shape=box,color=blue];
		j3413838026 -> j1282202554;
		j3413838026 -> j3427396391;
	j3538436146 [label="Тэгфер знает только свою версию событий. Настоящие мотивы или мнения Энтрати… явно не были объяснены.",shape=box,color=red];
		j3538436146 -> j2705802236;
	j1391333069 [label="Я знаю, что ты чувствуешь, когда говоришь о своей «зависимости» от других, и мне жаль, что он сказал тебе такое.",shape=box,color=red];
		j1391333069 -> j3162272898;
	j945518527 [label="У Тагфера есть веские причины чувствовать себя так.",shape=box,color=red];
		j945518527 -> j946548047;
	j1282202554 [label="И как он это воспринял?",shape=box,color=red];
		j1282202554 -> j2059309783;
	j3427396391 [label="О, нет...",shape=box,color=red];
		j3427396391 -> j2059309783;
	j2705802236 [label="+5 Chemistry",color=orange];
		j2705802236 -> j1834421469;
	j3162272898 [label="+5 Chemistry",color=orange];
		j3162272898 -> j1313986821;
	j946548047 [label="Evaluate expressions",color=orange];
		j946548047 -> j2356496653 [label="MarieEntratiFamily",color=purple];
		j946548047 -> j3563519490 [label="MarieEntratiMonster1",color=purple];
		j946548047 -> j3563519490 [label="MarieEntratiMonster2",color=purple];
		j946548047 -> j3745846262 [label="MarieEntratiFan1",color=purple];
		j946548047 -> j3745846262 [label="MarieEntratiFan2",color=purple];
		j946548047 -> j1319417993 [label="MarieEntratiNeutral",color=purple];
		j946548047 -> j2647263211 [label="false",color=purple];
	j1834421469 [label="Это всё равно не даёт ему права! Я не знаю, понимает ли он, насколько глубоко его слова ранили меня. En outre -",shape=box,color=blue];
		j1834421469 -> j946548047;
	j1313986821 [label="Merci, я не знаю, понимает ли он, как глубоко его слова ранили меня.",shape=box,color=blue];
		j1313986821 -> j1809290954;
		j1313986821 -> j206555042;
		j1313986821 -> j1574028735;
	j2356496653 [label="Если это то приветствие, которого le Cardinal ждёт с нетерпением при возвращении, неудивительно, что он остается в стороне!",shape=box,color=blue];
		j2356496653 -> j1773305519;
		j2356496653 -> j1482889484;
	j3563519490 [label="И я уверена, что ты встал на сторону Monsieur Тэгфера, не так ли? Ты считаешь le Cardinal чудовищем, так же, как и этот зверь.",shape=box,color=blue];
		j3563519490 -> j1773305519;
		j3563519490 -> j2072973684;
	j3745846262 [label="Я удивлена, je pensais que tu étais de mon côté! Разве ты ещё мгновение назад не поддерживал меня, отстаивая дело le Cardinal?",shape=box,color=blue];
		j3745846262 -> j3618438125;
	j1319417993 [label="Какое это имеет значение, как ты уже говорил? Мы должны служить ему в его делах, а судить его потом. Эта борьба бессмысленна, non?",shape=box,color=blue];
		j1319417993 -> j2258475568;
		j1319417993 -> j3282793614;
	j2647263211 [label="Я знаю, что они были созданы Бездной руками le Cardinal. Каждому из нас le Cardinal дал дары, которые становятся проклятием, если смотреть на них с разбитым сердцем!",shape=box,color=blue];
		j2647263211 -> j127822268;
	j1809290954 [label="А ты знаешь, как глубоко ранили твои слова? Знаешь ли ты их историю целиком?",shape=box,color=red];
		j1809290954 -> j2647263211;
	j206555042 [label="И то, что ты сказала, ранило его так же сильно.",shape=box,color=red];
		j206555042 -> j2799348017;
	j1574028735 [label="Я честно на твоей стороне, но... мы должны попытаться сохранить мир, Мари.",shape=box,color=red];
		j1574028735 -> j3260493459;
		j1574028735 -> j2367077644;
	j1773305519 [label="Мари, пожалуйста. Я не пытаюсь ссориться. Я просто хочу, чтобы ты поняла, через что им пришлось пройти.",shape=box,color=red];
		j1773305519 -> j1741214482;
	j1482889484 [label="Если бы Энтрати оставался, чтобы помочь убрать последствия своих собственных поступков, у него, возможно, было бы больше друзей в этом мире.",shape=box,color=red];
		j1482889484 -> j406696865;
	j2072973684 [label="Да, я на его стороне. Потому что ты не слушаешь разум. Ты должна понять, что «le Cardinal» — не тот, кем кажется.",shape=box,color=red];
		j2072973684 -> j1741214482;
	j3618438125 [label="Неужели это был твой большой обман? Ты играл un jeu с маленькой Мари?",shape=box,color=blue];
		j3618438125 -> j3673486076;
		j3618438125 -> j3103636992;
	j2258475568 [label="Важно, чтобы рядом с нами никого не осталось, когда мы окажемся по ту сторону. Они многое пережили.",shape=box,color=red];
		j2258475568 -> j1741214482;
	j3282793614 [label="Я думаю, он об этом забудет. Думаю, что и ты тоже.",shape=box,color=red];
		j3282793614 -> j4209555743;
	j127822268 [label="Он всех нас оставил! Скажи, как же они пострадали настолько больше, что я должна терпеть такую ненависть?!",shape=box,color=blue];
		j127822268 -> j1639327012;
	j2799348017 [label="Oui?! Тогда скажи мне, почему!",shape=box,color=blue];
		j2799348017 -> j2647263211;
	j3260493459 [label="Ситуация, в которой оказалась Кавия, была... тяжелой.",shape=box,color=red];
		j3260493459 -> j2647263211;
	j2367077644 [label="Они — животные, даже если им дать разум, они всё равно остаются животными. Их возможности ограничены.",shape=box,color=red];
		j2367077644 -> j2613142660;
	j1741214482 [label="Oui? Тогда сыграй же роль La Lumière Sacrée de Sol и изгони тьму! Просвети глупышку Мари!",shape=box,color=blue];
		j1741214482 -> j2647263211;
	j406696865 [label="Oui! Недостаточно того, что он пытается спасти известную вселенную от бога Бездны, non?!",shape=box,color=blue];
		j406696865 -> j1936425104;
	j3673486076 [label="Нет, я не лгу. Я с тобой. Я просто говорю, что их положение было… трудным.",shape=box,color=red];
		j3673486076 -> j1741214482;
	j3103636992 [label="Нет, не совсем игра… Энтрати нельзя доверять, и я не знаю, как ещё убедить тебя, кроме как притвориться, будто я на твоей стороне.",shape=box,color=red];
		j3103636992 -> j2248617224;
	j4209555743 [label="Non! Разговор начат здесь, его и следует продолжить. Explique!",shape=box,color=blue];
		j4209555743 -> j2647263211;
	j1639327012 [label="Evaluate expressions",color=orange];
		j1639327012 -> j1357143236 [label="MarieFamily2",color=purple];
		j1639327012 -> j2898830985 [label="MarieFamily2",color=purple];
		j1639327012 -> j1357143236 [label="MarieBackstory1",color=purple];
		j1639327012 -> j40840512 [label="MarieBackstory1",color=purple];
		j1639327012 -> j1357143236 [label="MarieInfestation",color=purple];
		j1639327012 -> j813512211 [label="MarieInfestation",color=purple];
		j1639327012 -> j1357143236 [label="MarieLyonSuffering2",color=purple];
		j1639327012 -> j1422294 [label="MarieLyonSuffering2",color=purple];
		j1639327012 -> j1357143236 [label="MarrieLyonSuffering3",color=purple];
		j1639327012 -> j1357143236 [label="false",color=purple];
	j2613142660 [label="Если ты пытаешься вызвать во мне сочувствие к ним и обратить мою ярость против тебя, у меня внезапно возникает искушение.",shape=box,color=blue];
		j2613142660 -> j1936425104;
	j1936425104 [label="Возможно, нам лучше прерваться здесь. Пока гнев не взял верх над нами.",shape=box,color=blue];
		j1936425104 -> "Chat ends.";
	j2248617224 [label="Oui? Что ж, я рада сообщить тебе, что у тебя ничего не вышло.",shape=box,color=blue];
		j2248617224 -> j1509439757;
	j1357143236 [label="Кавиа были случайными созданиями, результатом экспериментов. Лабораторные животные никогда не должны были существовать. Бездна наделила их разумом.",shape=box,color=red];
		j1357143236 -> j1552130702;
	j2898830985 [label="Ты сама сказала: «Отсутствие имени — это высшая форма жестокости». Энтрати так и не потрудился дать им имена, настолько они были никчёмны.",shape=box,color=red];
		j2898830985 -> j614252717;
	j40840512 [label="Ты рассказывала мне, как росла на улицах. Как твоя семья выгнала тебя, потому что ты была для них недостаточно хороша.",shape=box,color=red];
		j40840512 -> j1152301733;
	j813512211 [label="Подумай, что бы ты почувствовала, если бы тебя против воли превратили в протофрейма, а потом бросили?",shape=box,color=red];
		j813512211 -> j3376656109;
	j1422294 [label="Представь, что бы ты почувствовала, если бы Энтрати внезапно появился, превратил Лиона в протофрейма и бросил его?",shape=box,color=red];
		j1422294 -> j2307011885;
	j1509439757 [label="Boolean MarieEntratiFan1 is now false.",color=orange];
		j1509439757 -> j2631316640;
	j1552130702 [label="И когда Энтрати увидел, что он натворил? Когда он понял, что создал? Этих бедных животных, говорящих на языке Бездны, больных от переохлаждения?",shape=box,color=red];
		j1552130702 -> j410990357;
	j614252717 [label="Для него они были просто вещами. Вещами, которыми можно было воспользоваться и выбросить. «Тэгфер?» — это значит «Тэг для утилизации».",shape=box,color=red];
		j614252717 -> j3865795494;
	j1152301733 [label="Твоя семья считала тебя никчёмной.",shape=box,color=red];
		j1152301733 -> j305919163;
	j3376656109 [label="Представь, каково это, иметь заражение в крови, страдать, и никого рядом, кто бы сказал, что ему не всё равно?",shape=box,color=red];
		j3376656109 -> j599110011;
	j2307011885 [label="Использовал его как дешёвый научный эксперимент, а потом умыл руки? Вы все полагались друг на друга до и после того, как изменились. У Кавиа не было никого.",shape=box,color=red];
		j2307011885 -> j3354719520;
	j2631316640 [label="Boolean MarieEntratiFan2 is now false.",color=orange];
		j2631316640 -> j1508231473;
	j410990357 [label="Ему было все равно. ",shape=box,color=red];
		j410990357 -> j3589754736;
	j3865795494 [label="Птица 3? Это птица с числом вместо имени. Фибоначчи сам дал себе это имя.",shape=box,color=red];
		j3865795494 -> j291690416;
	j305919163 [label="Именно такими были Кавии для Энтрати. Одноразовыми лабораторными животными. «Тэгфер?» — это означает «тэг для утилизации».",shape=box,color=red];
		j305919163 -> j3865795494;
	j599110011 [label="Что твои страдания вообще имели значение? Кавия была и остаётся бесполезной для Энтрати. Лабораторные животные одноразового использования. «Тэгфер?» Это означает «Тэг для утилизации».",shape=box,color=red];
		j599110011 -> j3865795494;
	j3354719520 [label="Для Энтрати, Кавия были всего лишь одноразовыми лабораторными животными. Бесполезными. «Тэгфер?» — это означает «тэг для утилизации».",shape=box,color=red];
		j3354719520 -> j3865795494;
	j1508231473 [label="Boolean MarieNoDate is now true.",color=orange];
