	j3589754736 [label="Именно такими были Кавии для Энтрати. Одноразовые. «Тэгфер?» — это означает «тэг для утилизации».",shape=box,color=red];
		j3589754736 -> j2310694661;
	j291690416 [label="Использовалась в эксперименте Бездны. Выжившие в длинной цепочке погибших животных. Никогда не предназначались для существования.",shape=box,color=red];
		j291690416 -> j3434537489;
	j2310694661 [label="Последний из своего рода. Отправлено на утилизацию. Его приятель? Минн? Единственный оставшийся? Погиб во время эксперимента.",shape=box,color=red];
		j2310694661 -> j2293086220;
	j3434537489 [label="Они живы только благодаря Лойду. Он сохранил их, потому что не смог заставить себя усыпить их «по указанию Энтрати».",shape=box,color=red];
		j3434537489 -> j3057472372;
	j2293086220 [label="Вот почему он был зол, Мари. Вот почему он ненавидит Энтрати. И, вероятно, всегда будет ненавидеть.",shape=box,color=red];
		j2293086220 -> j2433363310;
	j3057472372 [label="Ах да, и Тагфер? Он последний в своём роде. Его приятель, Минн? Единственный оставшийся? Погиб во время эксперимента.",shape=box,color=red];
		j3057472372 -> j286743143;
