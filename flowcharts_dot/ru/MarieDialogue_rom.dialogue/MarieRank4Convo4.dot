digraph {
	2286 [label="MarieRank4Convo4 begins.",color=orange];
		2286 -> 2287;
	2287 [label="Check boolean MarieTagferFight1",color=orange];
		2287 -> 2288 [label=true,color=green];
		2287 -> 2290 [label=true,color=green];
		2287 -> 2291 [label=true,color=green];
		2287 -> 2289 [label=false,color=brown];
	2288 [label="Мари, мы можем поговорить?",shape=box,color=red];
		2288 -> 2292;
	2290 [label="Роут рассказал мне о... драке с Тагфером. Можем ли мы поговорить об этом?",shape=box,color=red];
		2290 -> 2293;
	2291 [label="[Конец.]",shape=box,color=red];
		2291 -> 2294;
	2289 [label="Chat ends.",color=orange];
	2292 [label="Oui, хотя мне кажется, я знаю, о чём речь... Я вёла себя плохо. Кто тебе сказал?",shape=box,color=blue];
		2292 -> 2295;
		2292 -> 2296;
		2292 -> 2297;
	2293 [label="Bien sur, ce salaud de diable ouvre sa bouche et vous raconte tout! Il ne cherche qu'à m'embarrasser!",shape=box,color=blue];
		2293 -> 2298;
	2294 [label="Chat ends.",color=orange];
	2295 [label="Это не важно.",shape=box,color=red];
		2295 -> 2299;
	2296 [label="Лойд. ",shape=box,color=red];
		2296 -> 2300;
	2297 [label="Роут.",shape=box,color=red];
		2297 -> 2293;
	2298 [label="Si je le pouvais, je prendrais ce couteau qu'il aime tant utiliser pour agacer les autres et je le fourrerais là où seule Lua peut le voir!",shape=box,color=blue];
		2298 -> 2301;
	2299 [label="Думаю это важно, но, похоже, ты просто хочешь пощадить моё настроение. Так что... не буду тебя больше просить.",shape=box,color=blue];
		2299 -> 2302;
	2300 [label="Мне кажется, ты лжешь, чтобы пощадить мое настроение, так что... Я не буду требовать от тебя большего.",shape=box,color=blue];
		2300 -> 2302;
	2301 [label="Простите меня. Это было... неприлично. Я Sœur de Sol, и не должна терять самообладание или позволять себе такие слова.",shape=box,color=blue];
		2301 -> 2303;
	2302 [label="+5 Chemistry",color=orange];
		2302 -> 2304;
	2303 [label="+5 Chemistry",color=orange];
		2303 -> 2305;
	2304 [label="Я хочу сохранить хотя бы немного достоинства в этом разговоре, если мне еще это позволено.",shape=box,color=blue];
		2304 -> 2306;
	2305 [label="Мой гнев направлен не на тебя. И я всегда благодарна тебе за твою откровенность.",shape=box,color=blue];
		2305 -> 2307;
	2306 [label="Если ты пришёл поговорить со мной о ссоре, которая была у меня с Monsieur Тагфером, я не стану отрицать, что она произошла.",shape=box,color=blue];
		2306 -> 2307;
	2307 [label="Полагаю, дьявол уже рассказал тебе, из-за чего была та ссора?",shape=box,color=blue];
		2307 -> 2308;
	2308 [label="Evaluate expressions",color=orange];
		2308 -> 2310 [label="MarieTagferFight2a",color=purple];
		2308 -> 2311 [label="MarieTagferFight2a",color=purple];
		2308 -> 2309 [label="MarieTagferFight2b",color=purple];
		2308 -> 2310 [label="MarieTagferFight2b",color=purple];
		2308 -> 2310 [label="false",color=purple];
		2308 -> 2312 [label="false",color=purple];
	2310 [label="Ему не нужно было мне рассказывать, можно было и так догадаться. Энтрати.",shape=box,color=red];
		2310 -> 2314;
	2311 [label="Да, он рассказал. Хотя, казалось, он больше всего беспокоился о тебе.",shape=box,color=red];
		2311 -> 2315;
	2309 [label="Да, он рассказал. Он обеспокоен ситуацией, потому что, как мне кажется, он сочувствует Кавии. ",shape=box,color=red];
		2309 -> 2313;
	2312 [label="No, honestly. He said only that I should check in on you.",shape=box,color=red];
		2312 -> 2316;
	2314 [label="Oui. Monsieur Тагфер спорил на тему Кардинала.",shape=box,color=blue];
		2314 -> 2318;
		2314 -> 2319;
	2315 [label="Не знаю, зачем дьяволу нужно, чтобы ты в это поверил. И какая ему от этого польза.",shape=box,color=blue];
		2315 -> 2320;
	2313 [label="Дьявол видит трех раненых животных и понимает, что он может легко использовать свою харизму, чтобы они ему льстили.",shape=box,color=blue];
		2313 -> 2317;
	2316 [label="Я не знаю, почему дьявол захотел бы, чтобы ты сделал такое. Или какой цели, по его мнению, это могло бы послужить.",shape=box,color=blue];
		2316 -> 2321;
	2318 [label="Нет, Тагфер не самый большой сторонник Энтрати.",shape=box,color=red];
		2318 -> 2323;
	2319 [label="Я полагаю, что спор был громким.",shape=box,color=red];
		2319 -> 2324;
	2320 [label="Все так называемые проявления доброты ко мне со стороны дьявола служат одной цели, настроить меня против Кардинала. Я знаю это. ",shape=box,color=blue];
		2320 -> 2322;
	2317 [label="He does this to turn the tide against me. He wishes to corrupt me against le Cardinal. To see me turn my back against him. I know it.",shape=box,color=blue];
		2317 -> 2322;
	2321 [label="Но... ведь не для этого ты здесь, чтобы говорить об этом. Ссора была из‑за Кардинала. ",shape=box,color=blue];
		2321 -> 2318;
		2321 -> 2319;
	2323 [label="И вот этого я не понимаю! Посмотри, что им было даровано!",shape=box,color=blue];
		2323 -> 2325;
		2323 -> 2326;
	2324 [label="Oui! Он назвал меня тупицей. Он сказал, что я всего лишь ребёнок.",shape=box,color=blue];
		2324 -> 2327;
		2324 -> 2325;
	2322 [label="И именно о Кардинале мы спорили с Monsieur Тагфером.",shape=box,color=blue];
		2322 -> 2318;
		2322 -> 2319;
	2325 [label="Пожалуйста, начни с самого начала. Как вообще началась вся эта ссора?",shape=box,color=red];
		2325 -> 2328;
	2326 [label="Я начинаю понимать, почему произошла эта ссора.",shape=box,color=red];
		2326 -> 2328;
	2327 [label="Он действительно назвал тебя тупым и ребёнком?",shape=box,color=red];
		2327 -> 2329;
	2328 [label="Oui. Я упомянула le Cardinal, хотя даже не знаю, что это было ",shape=box,color=blue];
		2328 -> 2330;
	2329 [label="Возможно, даже хуже.",shape=box,color=blue];
		2329 -> 2331;
	2330 [label="Monsieur Тагфер закатил глаза и фыркнул. Я попросила его объяснить свою насмешку.",shape=box,color=blue];
		2330 -> 2332;
	2331 [label="«Ты - дитя, Мари! Невинное. Всю жизнь зависимая от других. Свёрнутая в своём маленьком гнёздышке слепой веры!»",shape=box,color=blue];
		2331 -> 2333;
	2332 [label="«Альбрехт — грязный, вонючий лжец!»",shape=box,color=blue];
		2332 -> 2334;
	2333 [label="«Выживаешь на том, что твои старшие пережевали и выплюнули тебе в доверчиво разинутый рот!»",shape=box,color=blue];
		2333 -> 2335;
	2334 [label="Et j'ai répondu, «Посмотрите на дары, которые вам были даны — дары мысли, языка, Я!»",shape=box,color=blue];
		2334 -> 2336;
	2335 [label="Update boolean MarieEntrati3",color=orange];
		2335 -> 2337;
		2335 -> 2338;
		2335 -> 2339;
	2336 [label="«Вы должны быть благодарны le Cardinal за все, чем он вас благословил».",shape=box,color=blue];
		2336 -> 2340;
		2336 -> 2341;
	2337 [label="Тэгфер знает только свою версию событий. Настоящие мотивы или мнения Энтрати… явно не были объяснены.",shape=box,color=red];
		2337 -> 2342;
	2338 [label="Я знаю, что ты чувствуешь, когда говоришь о своей «зависимости» от других, и мне жаль, что он сказал тебе такое.",shape=box,color=red];
		2338 -> 2343;
	2339 [label="У Тагфера есть веские причины чувствовать себя так.",shape=box,color=red];
		2339 -> 2344;
	2340 [label="И как он это воспринял?",shape=box,color=red];
		2340 -> 2331;
	2341 [label="О, нет...",shape=box,color=red];
		2341 -> 2331;
	2342 [label="+5 Chemistry",color=orange];
		2342 -> 2345;
	2343 [label="+5 Chemistry",color=orange];
		2343 -> 2346;
	2344 [label="Evaluate expressions",color=orange];
		2344 -> 2347 [label="MarieEntratiFamily",color=purple];
		2344 -> 2348 [label="MarieEntratiMonster1",color=purple];
		2344 -> 2348 [label="MarieEntratiMonster2",color=purple];
		2344 -> 2349 [label="MarieEntratiFan1",color=purple];
		2344 -> 2349 [label="MarieEntratiFan2",color=purple];
		2344 -> 2351 [label="MarieEntratiNeutral",color=purple];
		2344 -> 2350 [label="false",color=purple];
	2345 [label="Это всё равно не даёт ему права! Я не знаю, понимает ли он, насколько глубоко его слова ранили меня. En outre -",shape=box,color=blue];
		2345 -> 2344;
	2346 [label="Merci, я не знаю, понимает ли он, как глубоко его слова ранили меня.",shape=box,color=blue];
		2346 -> 2352;
		2346 -> 2353;
		2346 -> 2354;
	2347 [label="Если это то приветствие, которого le Cardinal ждёт с нетерпением при возвращении, неудивительно, что он остается в стороне!",shape=box,color=blue];
		2347 -> 2355;
		2347 -> 2356;
	2348 [label="И я уверена, что ты встал на сторону Monsieur Тэгфера, не так ли? Ты считаешь le Cardinal чудовищем, так же, как и этот зверь.",shape=box,color=blue];
		2348 -> 2357;
		2348 -> 2358;
	2349 [label="Я удивлена, je pensais que tu étais de mon côté! Разве ты ещё мгновение назад не поддерживал меня, отстаивая дело le Cardinal?",shape=box,color=blue];
		2349 -> 2359;
	2351 [label="Какое это имеет значение, как ты уже говорил? Мы должны служить ему в его делах, а судить его потом. Эта борьба бессмысленна, non?",shape=box,color=blue];
		2351 -> 2361;
		2351 -> 2362;
	2350 [label="Я знаю, что они были созданы Бездной руками le Cardinal. Каждому из нас le Cardinal дал дары, которые становятся проклятием, если смотреть на них с разбитым сердцем!",shape=box,color=blue];
		2350 -> 2360;
	2352 [label="А ты знаешь, как глубоко ранили твои слова? Знаешь ли ты их историю целиком?",shape=box,color=red];
		2352 -> 2350;
	2353 [label="И то, что ты сказала, ранило его так же сильно.",shape=box,color=red];
		2353 -> 2363;
	2354 [label="Я честно на твоей стороне, но... мы должны попытаться сохранить мир, Мари.",shape=box,color=red];
		2354 -> 2364;
		2354 -> 2365;
	2355 [label="Мари, пожалуйста. Я не пытаюсь ссориться. Я просто хочу, чтобы ты поняла, через что им пришлось пройти.",shape=box,color=red];
		2355 -> 2366;
	2356 [label="Если бы Энтрати оставался, чтобы помочь убрать последствия своих собственных поступков, у него, возможно, было бы больше друзей в этом мире.",shape=box,color=red];
		2356 -> 2367;
	2357 [label="Мари, пожалуйста. Я не пытаюсь ссориться. Я просто хочу, чтобы ты поняла, через что им пришлось пройти.",shape=box,color=red];
		2357 -> 2366;
	2358 [label="Да, я на его стороне. Потому что ты не слушаешь разум. Ты должна понять, что «le Cardinal» — не тот, кем кажется.",shape=box,color=red];
		2358 -> 2366;
	2359 [label="Неужели это был твой большой обман? Ты играл un jeu с маленькой Мари?",shape=box,color=blue];
		2359 -> 2368;
		2359 -> 2369;
	2361 [label="Важно, чтобы рядом с нами никого не осталось, когда мы окажемся по ту сторону. Они многое пережили.",shape=box,color=red];
		2361 -> 2366;
	2362 [label="Я думаю, он об этом забудет. Думаю, что и ты тоже.",shape=box,color=red];
		2362 -> 2371;
	2360 [label="Он всех нас оставил! Скажи, как же они пострадали настолько больше, что я должна терпеть такую ненависть?!",shape=box,color=blue];
		2360 -> 2370;
	2363 [label="Oui?! Тогда скажи мне, почему!",shape=box,color=blue];
		2363 -> 2350;
	2364 [label="Ситуация, в которой оказалась Кавия, была... тяжелой.",shape=box,color=red];
		2364 -> 2350;
	2365 [label="Они — животные, даже если им дать разум, они всё равно остаются животными. Их возможности ограничены.",shape=box,color=red];
		2365 -> 2372;
	2366 [label="Oui? Тогда сыграй же роль La Lumière Sacrée de Sol и изгони тьму! Просвети глупышку Мари!",shape=box,color=blue];
		2366 -> 2350;
	2367 [label="Oui! Недостаточно того, что он пытается спасти известную вселенную от бога Бездны, non?!",shape=box,color=blue];
		2367 -> 2373;
	2368 [label="Нет, я не лгу. Я с тобой. Я просто говорю, что их положение было… трудным.",shape=box,color=red];
		2368 -> 2366;
	2369 [label="Нет, не совсем игра… Энтрати нельзя доверять, и я не знаю, как ещё убедить тебя, кроме как притвориться, будто я на твоей стороне.",shape=box,color=red];
		2369 -> 2374;
	2371 [label="Non! Разговор начат здесь, его и следует продолжить. Explique!",shape=box,color=blue];
		2371 -> 2350;
	2370 [label="Evaluate expressions",color=orange];
		2370 -> 2375 [label="MarieFamily2",color=purple];
		2370 -> 2377 [label="MarieFamily2",color=purple];
		2370 -> 2375 [label="MarieBackstory1",color=purple];
		2370 -> 2378 [label="MarieBackstory1",color=purple];
		2370 -> 2375 [label="MarieInfestation",color=purple];
		2370 -> 2379 [label="MarieInfestation",color=purple];
		2370 -> 2375 [label="MarieLyonSuffering2",color=purple];
		2370 -> 2376 [label="MarieLyonSuffering2",color=purple];
		2370 -> 2375 [label="MarrieLyonSuffering3",color=purple];
		2370 -> 2375 [label="false",color=purple];
	2372 [label="Если ты пытаешься вызвать во мне сочувствие к ним и обратить мою ярость против тебя, у меня внезапно возникает искушение.",shape=box,color=blue];
		2372 -> 2380;
	2373 [label="Возможно, нам лучше прерваться здесь. Пока гнев не взял верх над нами.",shape=box,color=blue];
		2373 -> 2381;
	2374 [label="Oui? Что ж, я рада сообщить тебе, что у тебя ничего не вышло.",shape=box,color=blue];
		2374 -> 2382;
	2375 [label="Кавиа были случайными созданиями, результатом экспериментов. Лабораторные животные никогда не должны были существовать. Бездна наделила их разумом.",shape=box,color=red];
		2375 -> 2383;
	2377 [label="Ты сама сказала: «Отсутствие имени — это высшая форма жестокости». Энтрати так и не потрудился дать им имена, настолько они были никчёмны.",shape=box,color=red];
		2377 -> 2385;
	2378 [label="Ты рассказывала мне, как росла на улицах. Как твоя семья выгнала тебя, потому что ты была для них недостаточно хороша.",shape=box,color=red];
		2378 -> 2386;
	2379 [label="Подумай, что бы ты почувствовала, если бы тебя против воли превратили в протофрейма, а потом бросили?",shape=box,color=red];
		2379 -> 2387;
	2376 [label="Представь, что бы ты почувствовала, если бы Энтрати внезапно появился, превратил Лиона в протофрейма и бросил его?",shape=box,color=red];
		2376 -> 2384;
	2380 [label="Возможно, нам лучше прерваться здесь. Пока гнев не взял верх над нами.",shape=box,color=blue];
		2380 -> 2388;
	2381 [label="Chat ends.",color=orange];
	2382 [label="Update boolean MarieEntratiFan1",color=orange];
		2382 -> 2389;
	2383 [label="И когда Энтрати увидел, что он натворил? Когда он понял, что создал? Этих бедных животных, говорящих на языке Бездны, больных от переохлаждения?",shape=box,color=red];
		2383 -> 2390;
	2385 [label="Для него они были просто вещами. Вещами, которыми можно было воспользоваться и выбросить. «Тэгфер?» — это значит «Тэг для утилизации».",shape=box,color=red];
		2385 -> 2392;
	2386 [label="Твоя семья считала тебя никчёмной.",shape=box,color=red];
		2386 -> 2393;
	2387 [label="Представь, каково это, иметь заражение в крови, страдать, и никого рядом, кто бы сказал, что ему не всё равно?",shape=box,color=red];
		2387 -> 2394;
	2384 [label="Использовал его как дешёвый научный эксперимент, а потом умыл руки? Вы все полагались друг на друга до и после того, как изменились. У Кавиа не было никого.",shape=box,color=red];
		2384 -> 2391;
	2388 [label="Chat ends.",color=orange];
	2389 [label="Update boolean MarieEntratiFan2",color=orange];
		2389 -> 2395;
	2390 [label="Ему было все равно. ",shape=box,color=red];
		2390 -> 2396;
	2392 [label="Птица 3? Это птица с числом вместо имени. Фибоначчи сам дал себе это имя.",shape=box,color=red];
		2392 -> 2397;
	2393 [label="Именно такими были Кавии для Энтрати. Одноразовыми лабораторными животными. «Тэгфер?» — это означает «тэг для утилизации».",shape=box,color=red];
		2393 -> 2392;
	2394 [label="Что твои страдания вообще имели значение? Кавия была и остаётся бесполезной для Энтрати. Лабораторные животные одноразового использования. «Тэгфер?» Это означает «Тэг для утилизации».",shape=box,color=red];
		2394 -> 2392;
	2391 [label="Для Энтрати, Кавия были всего лишь одноразовыми лабораторными животными. Бесполезными. «Тэгфер?» — это означает «тэг для утилизации».",shape=box,color=red];
		2391 -> 2392;
	2395 [label="Update boolean MarieNoDate",color=orange];
		2395 -> 2398;
	2396 [label="Именно такими были Кавии для Энтрати. Одноразовые. «Тэгфер?» — это означает «тэг для утилизации».",shape=box,color=red];
		2396 -> 2399;
	2397 [label="Использовалась в эксперименте Бездны. Выжившие в длинной цепочке погибших животных. Никогда не предназначались для существования.",shape=box,color=red];
		2397 -> 2400;
	2398 [label="Chat ends.",color=orange];
	2399 [label="Последний из своего рода. Отправлено на утилизацию. Его приятель? Минн? Единственный оставшийся? Погиб во время эксперимента.",shape=box,color=red];
		2399 -> 2401;
	2400 [label="Они живы только благодаря Лойду. Он сохранил их, потому что не смог заставить себя усыпить их «по указанию Энтрати».",shape=box,color=red];
		2400 -> 2402;
	2401 [label="Вот почему он был зол, Мари. Вот почему он ненавидит Энтрати. И, вероятно, всегда будет ненавидеть.",shape=box,color=red];
		2401 -> 2403;
	2402 [label="Ах да, и Тагфер? Он последний в своём роде. Его приятель, Минн? Единственный оставшийся? Погиб во время эксперимента.",shape=box,color=red];
		2402 -> 2404;
	2403 [label="Update boolean MarieEntrati3b",color=orange];
		2403 -> 2405;
		2403 -> 2406;
