digraph {
	graph [fontname="Roboto Condensed"];
	node [fontname="Roboto Condensed"];
	edge [fontname="Roboto Condensed"];

	"MarieConsent begins." [color=orange];
		"MarieConsent begins." -> j3525420089;
	j3525420089 [label="Check boolean MarieDating",color=orange];
		j3525420089 -> j1726666308 [label=true,color=green];
		j3525420089 -> "Chat ends." [label=false,color=brown];
	j1726666308 [label="Check /Lotus/Scripts/1999/DialogueScriptNodes.lua:IsDatingMultiple",color=orange];
		j1726666308 -> j1985950621 [label=true,color=green];
		j1726666308 -> j1134465740 [label=false,color=brown];
	"Chat ends." [color=orange];
	j1985950621 [label="Check boolean MarieConsentComplete",color=orange];
		j1985950621 -> "Chat ends." [label=true,color=green];
		j1985950621 -> j2415178336 [label=false,color=brown];
	j1134465740 [label="Check boolean MariePolyamorySuccess",color=orange];
		j1134465740 -> j1985950621 [label=true,color=green];
		j1134465740 -> "Chat ends." [label=false,color=brown];
	j2415178336 [label="Mon cœur, можем ли мы поговорить? Только на мгновение. ",shape=box,color=blue];
		j2415178336 -> j2873046642;
		j2415178336 -> j711464002;
	j2873046642 [label="Привет, конечно. Что случилось?",shape=box,color=red];
		j2873046642 -> j450188072;
	j711464002 [label="[Конец.]",shape=box,color=red];
		j711464002 -> j952339130;
	j450188072 [label="Я просто хотела сказать, что... Я знаю, что твоё сердце принадлежит и другому человеку. И хотя я не знаю их, моё сердце радуется этому.",shape=box,color=blue];
		j450188072 -> j3595975393;
	j952339130 [label="Boolean MarieConsentComplete is now true.",color=orange];
		j952339130 -> "Chat ends.";
	j3595975393 [label="Я доверяю тебе, и если они занимают место в твоей душе, то я буду рада поделиться им с ними.",shape=box,color=blue];
		j3595975393 -> j408780846;
	j408780846 [label="Я просто надеюсь, что когда-нибудь мне доведётся с ними встретиться, oui? Поэтому возлюбленный моего возлюбленного должен быть и моим...",shape=box,color=blue];
		j408780846 -> j4166427479;
	j4166427479 [label="Конечно, если ты думаешь, что они будут к этому склонны.",shape=box,color=blue];
		j4166427479 -> j1826094980;
		j4166427479 -> j776567486;
		j4166427479 -> j3528442020;
	j1826094980 [label="Честно говоря, ты, возможно, не в их вкусе.",shape=box,color=red];
		j1826094980 -> j3279832215;
	j776567486 [label="Они бы обожали тебя, Мари. Как и я.",shape=box,color=red];
		j776567486 -> j2745480257;
	j3528442020 [label="Я действительно не думаю, что они смогли бы устоять.",shape=box,color=red];
		j3528442020 -> j2745480257;
	j3279832215 [label="Пфф! Ты ужасен, мой волк. Позволь мне увидеть мои сны. А пока, полагаю, ты будешь со мной, когда будешь со мной!",shape=box,color=blue];
		j3279832215 -> j2666747538;
	j2745480257 [label="До тех пор я буду рядом с тобой тогда, когда ты будешь со мной. И я с радостью разделю тебя с теми, кто полюбил тебя так же, как и я.",shape=box,color=blue];
		j2745480257 -> j2666747538;
	j2666747538 [label="В конце концов, кто-то должен стоять на страже против Шёпота, пока ты слоняешься без дела и развлекаешься!",shape=box,color=blue];
		j2666747538 -> j801126463;
	j801126463 [label="И на этой ноте, долг зовёт. À la revoyure!",shape=box,color=blue];
		j801126463 -> j952339130;
}