	3093 [label="Bonjour, bonjour, mon cœur! Я должна сказать тебе преглупейшую вещь.",shape=box,color=blue];
		3093 -> 3095;
		3093 -> 3096;
	3094 [label="Bonjour ! Я должна сказать тебе преглупейшую вещь.",shape=box,color=blue];
		3094 -> 3095;
		3094 -> 3096;
	3095 [label="Ох? Что случилось?",shape=box,color=red];
		3095 -> 3097;
	3096 [label="[Конец.]",shape=box,color=red];
		3096 -> 3098;
	3097 [label="I asked M'sieur Bird Trois what his birthday was, and he did not know ! How terribly sad !",shape=box,color=blue];
		3097 -> 3099;
	3098 [label="Chat ends.",color=orange];
	3099 [label="Никто из Кавии не знает дня своего рождения, что, я полагаю, логично, учитывая, что они родились, не умея говорить и не зная календарь, как мы.",shape=box,color=blue];
		3099 -> 3100;
	3100 [label="Вот я и подумала: \"Какая tragédie ! Надо это исправить немедленно, non ?",shape=box,color=blue];
		3100 -> 3101;
		3100 -> 3102;
		3100 -> 3103;
	3101 [label="Никогда такое в голову не приходило.",shape=box,color=red];
		3101 -> 3104;
	3102 [label="Как ты узнаёшь, когда они родились?",shape=box,color=red];
		3102 -> 3105;
	3103 [label="Ты позволишь им самим выбрать свои дни рождения?",shape=box,color=red];
		3103 -> 3106;
	3104 [label="Oui ! Monsieur Лойд тоже. Когда я это узнала, на его лице отразилась чистая скорбь...",shape=box,color=blue];
		3104 -> 3107;
	3105 [label="Сначала я подумал проверить записи le Cardinal - может быть, он записал, когда они родились, oui ?",shape=box,color=blue];
		3105 -> 3108;
	3106 [label="«Позволить?» Ты говоришь это так, как будто это зависит от меня ! ",shape=box,color=blue];
		3106 -> 3105;
	3107 [label="Мне разбивает сердце, что он думает, будто это его вина, что он не догадался первым. Это не его вина, он делает так много для стольких...",shape=box,color=blue];
		3107 -> 3109;
	3108 [label="Evaluate expressions",color=orange];
		3108 -> 3110 [label="MarieEntratiComplete",color=purple];
		3108 -> 3110 [label="MarieEntrati3a",color=purple];
		3108 -> 3111 [label="false",color=purple];
	3109 [label="Мы все благословлены тем, что знаем доброту Monsieur Лойда. Глубина источника, из которого он черпает, не знает границ.",shape=box,color=blue];
		3109 -> 3112;
		3109 -> 3113;
	3110 [label="Но потом я вспомнила... свои разговоры с Monsieur Тагфер и остальными, и подумала... это, возможно, не так уж и мудро.",shape=box,color=blue];
		3110 -> 3114;
	3111 [label="Но они, похоже, не интересовались поиском сведений о своём прошлом. Я знаю, как болезненно бывает думать о своих корнях.",shape=box,color=blue];
		3111 -> 3114;
	3112 [label="Нам действительно повезло, что он здесь.",shape=box,color=red];
		3112 -> 3115;
	3113 [label="Мне просто хотелось бы, чтобы он время от времени немного поднимал себе настроение.",shape=box,color=red];
		3113 -> 3116;
	3114 [label="В конце концов, я ведь даже не знаю дня своего рождения. ",shape=box,color=blue];
		3114 -> 3117;
		3114 -> 3118;
		3114 -> 3119;
	3115 [label="Да, это так. Мы все такие.",shape=box,color=blue];
		3115 -> 3120;
	3116 [label="Он серьёзный человек, но я видел, как он улыбается. Он умеет шутить, когда этого меньше всего ждёшь. Нужно просто набраться терпения.",shape=box,color=blue];
		3116 -> 3120;
	3117 [label="Если тебе от этого станет легче, то мне тоже. Подозреваю, что ребенок тоже ничего не помнит.",shape=box,color=red];
		3117 -> 3121;
	3118 [label="Дни рождения переоценены.",shape=box,color=red];
		3118 -> 3122;
	3119 [label="В любом случае, выбирать свой собственный гораздо интереснее. Это трогательнее. ",shape=box,color=red];
		3119 -> 3123;
	3120 [label="Check boolean MarieDating",color=orange];
		3120 -> 3125 [label=true,color=green];
		3120 -> 3124 [label=false,color=brown];
	3121 [label="Ещё больше причин поплакать по тебе и твоей крошечной copie. Ещё больше общего у нас !",shape=box,color=blue];
		3121 -> 3120;
	3122 [label="Я не считаю, что их переоценивают! Мы должны чтить тех, кто ещё с нами, так же, как и тех, кого уже нет.",shape=box,color=blue];
		3122 -> 3120;
	3123 [label="Трогательно? Я и не знала, что ты говоришь на Gaullique ! Ты это у меня перенял?",shape=box,color=blue];
		3123 -> 3126;
		3123 -> 3127;
	3125 [label="+20 Chemistry",color=orange];
		3125 -> 3129;
	3124 [label="+20 Chemistry",color=orange];
		3124 -> 3128;
	3126 [label="Я... думаю, что в обоих языках это одинаково...",shape=box,color=red];
		3126 -> 3130;
	3127 [label="Похоже, это перенялось от тебя.",shape=box,color=red];
		3127 -> 3131;
	3129 [label="Сейчас! Давай, mon cœur ! Даже если из этого ничего не выйдет, важна сама мысль ! Au calendrier !",shape=box,color=blue];
		3129 -> 3132;
	3128 [label="Сейчас! Давай! Даже если из этого ничего не выйдет, важна сама мысль ! Au calendrier !",shape=box,color=blue];
		3128 -> 3132;
	3130 [label="Пфф! Все остальные языки вечно крадут лучшие стороны Gaullique и уносят их прочь! Времена никогда не изменятся!",shape=box,color=blue];
		3130 -> 3120;
	3131 [label="Вот как! Gaullique — один из самых красивых языков, когда-либо существовавших, и я рада, что могу принести его в это futur.",shape=box,color=blue];
		3131 -> 3120;
	3132 [label="Chat ends.",color=orange];
}