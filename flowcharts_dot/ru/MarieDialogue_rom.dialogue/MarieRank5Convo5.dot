digraph {
	"MarieRank5Convo5 begins." [color=orange];
		"MarieRank5Convo5 begins." -> j20182927;
	j20182927 [label="Check boolean MarieDating",color=orange];
		j20182927 -> j867776904 [label=true,color=green];
		j20182927 -> j3099096777 [label=false,color=brown];
	j867776904 [label="Bonjour, bonjour, mon cœur! Я должна сказать тебе преглупейшую вещь.",shape=box,color=blue];
		j867776904 -> j2492626118;
		j867776904 -> j1310452999;
	j3099096777 [label="Bonjour ! Я должна сказать тебе преглупейшую вещь.",shape=box,color=blue];
		j3099096777 -> j2492626118;
		j3099096777 -> j1310452999;
	j2492626118 [label="Ох? Что случилось?",shape=box,color=red];
		j2492626118 -> j3356590945;
	j1310452999 [label="[Конец.]",shape=box,color=red];
		j1310452999 -> "Chat ends.";
	j3356590945 [label="I asked M'sieur Bird Trois what his birthday was, and he did not know ! How terribly sad !",shape=box,color=blue];
		j3356590945 -> j3882746202;
	"Chat ends." [color=orange];
	j3882746202 [label="Никто из Кавии не знает дня своего рождения, что, я полагаю, логично, учитывая, что они родились, не умея говорить и не зная календарь, как мы.",shape=box,color=blue];
		j3882746202 -> j2996485418;
	j2996485418 [label="Вот я и подумала: \"Какая tragédie ! Надо это исправить немедленно, non ?",shape=box,color=blue];
		j2996485418 -> j200243825;
		j2996485418 -> j3560047905;
		j2996485418 -> j3220100097;
	j200243825 [label="Никогда такое в голову не приходило.",shape=box,color=red];
		j200243825 -> j1412345378;
	j3560047905 [label="Как ты узнаёшь, когда они родились?",shape=box,color=red];
		j3560047905 -> j3427268383;
	j3220100097 [label="Ты позволишь им самим выбрать свои дни рождения?",shape=box,color=red];
		j3220100097 -> j4013931963;
	j1412345378 [label="Oui ! Monsieur Лойд тоже. Когда я это узнала, на его лице отразилась чистая скорбь...",shape=box,color=blue];
		j1412345378 -> j1900158741;
	j3427268383 [label="Сначала я подумал проверить записи le Cardinal - может быть, он записал, когда они родились, oui ?",shape=box,color=blue];
		j3427268383 -> j2402114516;
	j4013931963 [label="«Позволить?» Ты говоришь это так, как будто это зависит от меня ! ",shape=box,color=blue];
		j4013931963 -> j3427268383;
	j1900158741 [label="Мне разбивает сердце, что он думает, будто это его вина, что он не догадался первым. Это не его вина, он делает так много для стольких...",shape=box,color=blue];
		j1900158741 -> j3196735456;
	j2402114516 [label="Evaluate expressions",color=orange];
		j2402114516 -> j3069827383 [label="MarieEntratiComplete",color=purple];
		j2402114516 -> j3069827383 [label="MarieEntrati3a",color=purple];
		j2402114516 -> j2972907436 [label="false",color=purple];
	j3196735456 [label="Мы все благословлены тем, что знаем доброту Monsieur Лойда. Глубина источника, из которого он черпает, не знает границ.",shape=box,color=blue];
		j3196735456 -> j1355584992;
		j3196735456 -> j2098161665;
	j3069827383 [label="Но потом я вспомнила... свои разговоры с Monsieur Тагфер и остальными, и подумала... это, возможно, не так уж и мудро.",shape=box,color=blue];
		j3069827383 -> j1148553927;
	j2972907436 [label="Но они, похоже, не интересовались поиском сведений о своём прошлом. Я знаю, как болезненно бывает думать о своих корнях.",shape=box,color=blue];
		j2972907436 -> j1148553927;
	j1355584992 [label="Нам действительно повезло, что он здесь.",shape=box,color=red];
		j1355584992 -> j119475734;
	j2098161665 [label="Мне просто хотелось бы, чтобы он время от времени немного поднимал себе настроение.",shape=box,color=red];
		j2098161665 -> j1189070362;
	j1148553927 [label="В конце концов, я ведь даже не знаю дня своего рождения. ",shape=box,color=blue];
		j1148553927 -> j240840956;
		j1148553927 -> j967984288;
		j1148553927 -> j2744806080;
	j119475734 [label="Да, это так. Мы все такие.",shape=box,color=blue];
		j119475734 -> j3542593548;
	j1189070362 [label="Он серьёзный человек, но я видел, как он улыбается. Он умеет шутить, когда этого меньше всего ждёшь. Нужно просто набраться терпения.",shape=box,color=blue];
		j1189070362 -> j3542593548;
	j240840956 [label="Если тебе от этого станет легче, то мне тоже. Подозреваю, что ребенок тоже ничего не помнит.",shape=box,color=red];
		j240840956 -> j3004889938;
	j967984288 [label="Дни рождения переоценены.",shape=box,color=red];
		j967984288 -> j3230760511;
	j2744806080 [label="В любом случае, выбирать свой собственный гораздо интереснее. Это трогательнее. ",shape=box,color=red];
		j2744806080 -> j2811228692;
	j3542593548 [label="Check boolean MarieDating",color=orange];
		j3542593548 -> j2420388491 [label=true,color=green];
		j3542593548 -> j3223022806 [label=false,color=brown];
	j3004889938 [label="Ещё больше причин поплакать по тебе и твоей крошечной copie. Ещё больше общего у нас !",shape=box,color=blue];
		j3004889938 -> j3542593548;
	j3230760511 [label="Я не считаю, что их переоценивают! Мы должны чтить тех, кто ещё с нами, так же, как и тех, кого уже нет.",shape=box,color=blue];
		j3230760511 -> j3542593548;
	j2811228692 [label="Трогательно? Я и не знала, что ты говоришь на Gaullique ! Ты это у меня перенял?",shape=box,color=blue];
		j2811228692 -> j4061202901;
		j2811228692 -> j2322313556;
	j2420388491 [label="+20 Chemistry",color=orange];
		j2420388491 -> j1412675028;
	j3223022806 [label="+20 Chemistry",color=orange];
		j3223022806 -> j3437676106;
	j4061202901 [label="Я... думаю, что в обоих языках это одинаково...",shape=box,color=red];
		j4061202901 -> j4243434408;
	j2322313556 [label="Похоже, это перенялось от тебя.",shape=box,color=red];
		j2322313556 -> j3921832953;
	j1412675028 [label="Сейчас! Давай, mon cœur ! Даже если из этого ничего не выйдет, важна сама мысль ! Au calendrier !",shape=box,color=blue];
		j1412675028 -> "Chat ends.";
	j3437676106 [label="Сейчас! Давай! Даже если из этого ничего не выйдет, важна сама мысль ! Au calendrier !",shape=box,color=blue];
		j3437676106 -> "Chat ends.";
	j4243434408 [label="Пфф! Все остальные языки вечно крадут лучшие стороны Gaullique и уносят их прочь! Времена никогда не изменятся!",shape=box,color=blue];
		j4243434408 -> j3542593548;
	j3921832953 [label="Вот как! Gaullique — один из самых красивых языков, когда-либо существовавших, и я рада, что могу принести его в это futur.",shape=box,color=blue];
		j3921832953 -> j3542593548;
}