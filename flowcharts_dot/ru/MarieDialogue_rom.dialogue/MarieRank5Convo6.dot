	3139 [label="Волк! Мой волк! Я встретила Отака! Наконец-то я его встретила !",shape=box,color=blue];
		3139 -> 3143;
		3139 -> 3144;
	3140 [label="Я встретила Отака! Наконец-то я его встретила !",shape=box,color=blue];
		3140 -> 3143;
		3140 -> 3144;
	3142 [label="Волк! Мой волк! Лицо на спине Monsieur Некралоида! Наконец-то я его встретила !",shape=box,color=blue];
		3142 -> 3145;
		3142 -> 3146;
		3142 -> 3147;
	3141 [label="Лицо на спине Monsieur Некралоида ! Я наконец-то встретила его!",shape=box,color=blue];
		3141 -> 3145;
		3141 -> 3146;
		3141 -> 3147;
	3143 [label="Как прошел твой разговор с ним?",shape=box,color=red];
		3143 -> 3148;
	3144 [label="Тебе понравилось с ним общаться?",shape=box,color=red];
		3144 -> 3149;
	3145 [label="Ты познакомилась с Отаком? О боже... Как всё прошло?",shape=box,color=red];
		3145 -> 3150;
	3146 [label="Приятно, что вы наконец встретились. С Отаком бывает сложновато объяснить.",shape=box,color=red];
		3146 -> 3151;
	3147 [label="Бедный Отак... Как все прошло?",shape=box,color=red];
		3147 -> 3152;
	3148 [label="Он... представился мне трижды в ходе одного разговора, как будто мы никогда не были представлены друг другу.",shape=box,color=blue];
		3148 -> 3153;
	3149 [label="Да. Хотя, возможно, мне хотелось плакать из-за этого. Ведь он представился мне трижды в одном разговоре, словно мы никогда и не были знакомы.",shape=box,color=blue];
		3149 -> 3153;
	3150 [label="Почему ты звучишь так, будто тебе не особенно приятно, что я встретилась с ним?",shape=box,color=blue];
		3150 -> 3154;
		3150 -> 3155;
		3150 -> 3156;
	3151 [label="Да, так я и думаю. Детский каракуль на спине автомата. Мне показался он исключительно милым и очаровательным !",shape=box,color=blue];
		3151 -> 3157;
	3152 [label="Мне показался он исключительно милым и очаровательным! Но под слоем юмора скрывалось моё глубокое горе.",shape=box,color=blue];
		3152 -> 3158;
	3153 [label="Приветствовал меня так же решительно и радушно, как и раньше. Но он знал во мне Sœur de Sol ! ",shape=box,color=blue];
		3153 -> 3159;
	3154 [label="Мне жаль. Он иногда действует людям на нервы. Это не его вина.",shape=box,color=red];
		3154 -> 3160;
	3155 [label="Я не про это. Он просто может быть немного... отталкивающим для некоторых людей.",shape=box,color=red];
		3155 -> 3160;
	3156 [label="Иногда он действует мне на нервы, вот и все. ",shape=box,color=red];
		3156 -> 3161;
	3157 [label="Но за этим юмором скрывается огромное горе.",shape=box,color=blue];
		3157 -> 3158;
	3158 [label="Не расскажешь ли мне историю бедного Monsieur Отака?",shape=box,color=blue];
		3158 -> 3162;
	3159 [label="Да, он много знал о Светилах! Мы долго говорили о «Древних религиях», как он их называл, во времена «до Империи Орокин».",shape=box,color=blue];
		3159 -> 3163;
	3160 [label="И я надеюсь, что они проявят к нему доброту и терпение. Mais par la grâce de Sol, мы все пойдём.",shape=box,color=blue];
		3160 -> 3164;
	3161 [label="Надеюсь, ты постараешься быть добрее к человеку, который явно немощен. Но, в конце концов, мы идём к благодати Сола.",shape=box,color=blue];
		3161 -> 3164;
	3162 [label="Раньше Отак был архимедиан, учёным и академиком Орокин. То, что с ним произошло, нельзя назвать особенно радостной историей.",shape=box,color=red];
		3162 -> 3165;
	3163 [label="Хотя он сказал, что большая часть этих знаний теперь утеряна, спрятана глубоко в архивах и находится под запретом. Он взял с меня клятву хранить тайну.",shape=box,color=blue];
		3163 -> 3166;
	3164 [label="Такая участь может ждать любого из нас. Даже тебя.",shape=box,color=blue];
		3164 -> 3167;
		3164 -> 3168;
	3165 [label="Судя по всему, он был гением и умом, стоящим за освоением кристаллов аргона.",shape=box,color=red];
		3165 -> 3169;
	3166 [label="Он сказал мне, что глубоко обеспокоен тем, что Исполнитель Баллас — кем бы он ни был — может раскрыть мою секту еретиков и казнить меня.",shape=box,color=blue];
		3166 -> 3170;
		3166 -> 3171;
	3167 [label="У меня просто нет времени на него, извини.",shape=box,color=red];
		3167 -> 3172;
	3168 [label="Ты права, извини. Не это было в моих намерениях.",shape=box,color=red];
		3168 -> 3158;
	3169 [label="Которые извлекаются из Бездны, именно благодаря им мы можем создавать множество мощных варфреймов и оружия.",shape=box,color=red];
		3169 -> 3173;
	3170 [label="Этого... не будет. Продолжай говорить.",shape=box,color=red];
		3170 -> 3174;
	3171 [label="Баллас мертв... продолжай.",shape=box,color=red];
		3171 -> 3174;
	3172 [label="Тогда мне жаль, что я потратила еще больше времени.",shape=box,color=blue];
		3172 -> 3175;
	3173 [label="Он специализировался на кристаллографии. И его труды были сохранены здесь, в лабораториях.",shape=box,color=red];
		3173 -> 3176;
	3174 [label="+5 Chemistry",color=orange];
		3174 -> 3177;
	3175 [label="Update boolean MarieOtakComplete",color=orange];
		3175 -> 3178;
	3176 [label="По какой-то причине, я не знаю, его превратили в Цефалона и дали ему собственную некралоидную оболочку.",shape=box,color=red];
		3176 -> 3179;
	3177 [label="Я подозревала... Ну, он спросил меня, откуда я, и когда я ему рассказала, он рассмеялся и сказал: «Нет, это невозможно! А я-то знаю, я -»",shape=box,color=blue];
		3177 -> 3180;
	3178 [label="Chat ends.",color=orange];
	3179 [label="Не все Цефалоны были созданы в наказание. Но здесь, на Деймосе, дела пошли... плохо, и он был серьёзно повреждён.",shape=box,color=red];
		3179 -> 3181;
	3180 [label="А потом он… снова представился мне. И спросил, не с равнин ли я привезла образцы минералов...",shape=box,color=blue];
		3180 -> 3182;
		3180 -> 3183;
	3181 [label="Pauvre petit...",shape=box,color=blue];
		3181 -> 3184;
	3182 [label="Ой, Мари. Мне так жаль...",shape=box,color=red];
		3182 -> 3185;
	3183 [label="Да... это Отак.",shape=box,color=red];
		3183 -> 3185;
	3184 [label="Update boolean MarieOtak1",color=orange];
		3184 -> 3143;
		3184 -> 3144;
	3185 [label="Меня разбивает на миллион осколков мысль о том, что для него ничего нельзя сделать.",shape=box,color=blue];
		3185 -> 3186;
	3186 [label="Evaluate expressions",color=orange];
		3186 -> 3190 [label="MarieCephalonSoul",color=purple];
		3186 -> 3189 [label="MarieCephalonNoSoul",color=purple];
		3186 -> 3188 [label="MarieCephalonUnsure",color=purple];
		3186 -> 3187 [label="false",color=purple];
	3190 [label="О, Светила, что же ты для него устроил, чтобы держать его душу в ловушке этой клетки науки и мерцающих огней ?",shape=box,color=blue];
		3190 -> 3194;
	3189 [label="Я могу только молиться Светилам, чтобы ты был прав, и внутри этой оболочки не осталось ничего, кроме... только науки и мерцающих огней.",shape=box,color=blue];
		3189 -> 3193;
	3188 [label="Я знаю, ты не знаешь, есть ли у Цефалонов души, но я могу только молиться Светилам, чтобы... этот бедный Отак не страдал.",shape=box,color=blue];
		3188 -> 3192;
	3187 [label="Я могу только молиться Светилам, чтобы внутри этой оболочки остались только... наука и мерцающие огни.",shape=box,color=blue];
		3187 -> 3191;
	3194 [label="Зачем оставлять его там, сломленного и ждущего, пока ему позволят умереть и обрести покой? Я могу только молиться... что если там есть хоть какое-то присутствие -",shape=box,color=blue];
		3194 -> 3197;
	3193 [label="И ни одна душа не заперта в этом сломанном существе, ожидая, пока ей наконец позволят умереть, чтобы обрести покой.",shape=box,color=blue];
		3193 -> 3196;
	3192 [label="Что ни одна душа не заперта в этом сломанном существе, ожидая, пока ей наконец позволят умереть, чтобы обрести покой.",shape=box,color=blue];
		3192 -> 3195;
	3191 [label="И ни одна душа не заперта в этом сломанном существе, ожидая, пока ей наконец позволят умереть, чтобы обрести покой.",shape=box,color=blue];
		3191 -> 3195;
	3197 [label="Потому что он по собственному выбору остается своего рода одиноким дозором...",shape=box,color=blue];
		3197 -> 3200;
	3196 [label="А что если ты ошибаешься, и душа остаётся в этой клетке против своей воли ?",shape=box,color=blue];
		3196 -> 3199;
	3195 [label="Или, если там и есть какое-то присутствие, то это потому, что он остается там по своему выбору, в форме одинокого дозора.",shape=box,color=blue];
		3195 -> 3198;
	3200 [label="Думать иначе — значит усомниться в доброте богов, non ?",shape=box,color=blue];
		3200 -> 3201;
	3199 [label="Достаточно лишь усомниться в доброте богов, non ?",shape=box,color=blue];
		3199 -> 3201;
	3198 [label="Думать иначе — значит усомниться в доброте богов, non ?",shape=box,color=blue];
		3198 -> 3201;
	3201 [label="И где бы я тогда была?",shape=box,color=blue];
		3201 -> 3202;
	3202 [label="Прости меня, я... je suis melancolique aujourd'hui.",shape=box,color=blue];
