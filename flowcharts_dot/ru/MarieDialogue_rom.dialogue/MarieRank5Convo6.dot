		3203 -> 3206 [label="false",color=purple];
		3203 -> 3207 [label="false",color=purple];
	3204 [label="Могу я чем-нибудь тебя подбодрить? Можем пойти поиздеваться над Роутом.",shape=box,color=red];
		3204 -> 3208;
	3205 [label="Могу я чем-нибудь тебя подбодрить? Может, украсть немного выпечки?",shape=box,color=red];
		3205 -> 3209;
	3206 [label="Иногда боги бывают жестоки, Мари. Такова жизнь.",shape=box,color=red];
		3206 -> 3210;
	3207 [label="Всё в порядке. У тебя есть на это полное право.",shape=box,color=red];
		3207 -> 3211;
	3208 [label="+15 Chemistry",color=orange];
		3208 -> 3212;
	3209 [label="+20 Chemistry",color=orange];
		3209 -> 3212;
	3210 [label="+5 Chemistry",color=orange];
		3210 -> 3213;
	3211 [label="+20 Chemistry",color=orange];
		3211 -> 3214;
	3212 [label="Ха! Merci. Это точно остановит мои глупые слезы. Ты ведь умеешь подбодрить глупенькую Мари, non ?",shape=box,color=blue];
		3212 -> 3215;
		3212 -> 3216;
	3213 [label="Да. Это так. Так оно и есть. Мир полон историй, подобных истории господина Отака, и много историй гораздо хуже. Я бы не стала плакать ни над одной из них. ",shape=box,color=blue];
		3213 -> 3217;
	3214 [label="Merci. Ну, больше не хочу. Пойду займусь чем-нибудь более весёлым! Кажется, аквариум M'sieur Фибоначчи пора прочистить.",shape=box,color=blue];
		3214 -> 3218;
	3215 [label="Ты совсем не глупишь. Я чувствую то же самое.",shape=box,color=red];
		3215 -> 3219;
	3216 [label="Это самое малое, что я могу для тебя сделать.",shape=box,color=red];
		3216 -> 3219;
	3217 [label="И вот я сижу и делаю именно это. Спасибо, что напомнили мне о моей глупости. Фу! Глупенькая Мари. Ну... Думаю, аквариум M'sieur Фибоначчи пора протереть от пыли.",shape=box,color=blue];
		3217 -> 3218;
