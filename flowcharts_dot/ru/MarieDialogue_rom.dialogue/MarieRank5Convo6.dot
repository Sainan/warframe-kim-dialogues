	"Chat ends." [color=orange];
	j4089898924 [label="Check boolean MarieDating",color=orange];
		j4089898924 -> j438731833 [label=true,color=green];
		j4089898924 -> j929382817 [label=false,color=brown];
	j3097375491 [label="Check boolean MarieDating",color=orange];
		j3097375491 -> j4182147931 [label=true,color=green];
		j3097375491 -> j2081701508 [label=false,color=brown];
	j438731833 [label="Волк! Мой волк! Я встретила Отака! Наконец-то я его встретила !",shape=box,color=blue];
		j438731833 -> j1905210440;
		j438731833 -> j1132064860;
	j929382817 [label="Я встретила Отака! Наконец-то я его встретила !",shape=box,color=blue];
		j929382817 -> j1905210440;
		j929382817 -> j1132064860;
	j4182147931 [label="Волк! Мой волк! Лицо на спине Monsieur Некралоида! Наконец-то я его встретила !",shape=box,color=blue];
		j4182147931 -> j3616156758;
		j4182147931 -> j3599623836;
		j4182147931 -> j2782976077;
	j2081701508 [label="Лицо на спине Monsieur Некралоида ! Я наконец-то встретила его!",shape=box,color=blue];
		j2081701508 -> j3616156758;
		j2081701508 -> j3599623836;
		j2081701508 -> j2782976077;
	j1905210440 [label="Как прошел твой разговор с ним?",shape=box,color=red];
		j1905210440 -> j3193729970;
	j1132064860 [label="Тебе понравилось с ним общаться?",shape=box,color=red];
		j1132064860 -> j4123724128;
	j3616156758 [label="Ты познакомилась с Отаком? О боже... Как всё прошло?",shape=box,color=red];
		j3616156758 -> j746426302;
	j3599623836 [label="Приятно, что вы наконец встретились. С Отаком бывает сложновато объяснить.",shape=box,color=red];
		j3599623836 -> j1218013179;
	j2782976077 [label="Бедный Отак... Как все прошло?",shape=box,color=red];
		j2782976077 -> j120590659;
	j3193729970 [label="Он... представился мне трижды в ходе одного разговора, как будто мы никогда не были представлены друг другу.",shape=box,color=blue];
		j3193729970 -> j2030550814;
	j4123724128 [label="Да. Хотя, возможно, мне хотелось плакать из-за этого. Ведь он представился мне трижды в одном разговоре, словно мы никогда и не были знакомы.",shape=box,color=blue];
		j4123724128 -> j2030550814;
	j746426302 [label="Почему ты звучишь так, будто тебе не особенно приятно, что я встретилась с ним?",shape=box,color=blue];
		j746426302 -> j279216577;
		j746426302 -> j2344658449;
		j746426302 -> j1287696909;
	j1218013179 [label="Да, так я и думаю. Детский каракуль на спине автомата. Мне показался он исключительно милым и очаровательным !",shape=box,color=blue];
		j1218013179 -> j2574557544;
	j120590659 [label="Мне показался он исключительно милым и очаровательным! Но под слоем юмора скрывалось моё глубокое горе.",shape=box,color=blue];
		j120590659 -> j3471875135;
	j2030550814 [label="Приветствовал меня так же решительно и радушно, как и раньше. Но он знал во мне Sœur de Sol ! ",shape=box,color=blue];
		j2030550814 -> j2896217069;
	j279216577 [label="Мне жаль. Он иногда действует людям на нервы. Это не его вина.",shape=box,color=red];
		j279216577 -> j1143893120;
	j2344658449 [label="Я не про это. Он просто может быть немного... отталкивающим для некоторых людей.",shape=box,color=red];
		j2344658449 -> j1143893120;
	j1287696909 [label="Иногда он действует мне на нервы, вот и все. ",shape=box,color=red];
		j1287696909 -> j2433026298;
	j2574557544 [label="Но за этим юмором скрывается огромное горе.",shape=box,color=blue];
		j2574557544 -> j3471875135;
	j3471875135 [label="Не расскажешь ли мне историю бедного Monsieur Отака?",shape=box,color=blue];
		j3471875135 -> j3560409927;
	j2896217069 [label="Да, он много знал о Светилах! Мы долго говорили о «Древних религиях», как он их называл, во времена «до Империи Орокин».",shape=box,color=blue];
		j2896217069 -> j1558640539;
	j1143893120 [label="И я надеюсь, что они проявят к нему доброту и терпение. Mais par la grâce de Sol, мы все пойдём.",shape=box,color=blue];
		j1143893120 -> j1927749692;
	j2433026298 [label="Надеюсь, ты постараешься быть добрее к человеку, который явно немощен. Но, в конце концов, мы идём к благодати Сола.",shape=box,color=blue];
		j2433026298 -> j1927749692;
	j3560409927 [label="Раньше Отак был архимедиан, учёным и академиком Орокин. То, что с ним произошло, нельзя назвать особенно радостной историей.",shape=box,color=red];
		j3560409927 -> j1143674023;
	j1558640539 [label="Хотя он сказал, что большая часть этих знаний теперь утеряна, спрятана глубоко в архивах и находится под запретом. Он взял с меня клятву хранить тайну.",shape=box,color=blue];
		j1558640539 -> j1137989591;
	j1927749692 [label="Такая участь может ждать любого из нас. Даже тебя.",shape=box,color=blue];
		j1927749692 -> j802676067;
		j1927749692 -> j2455912516;
	j1143674023 [label="Судя по всему, он был гением и умом, стоящим за освоением кристаллов аргона.",shape=box,color=red];
		j1143674023 -> j1694013419;
	j1137989591 [label="Он сказал мне, что глубоко обеспокоен тем, что Исполнитель Баллас — кем бы он ни был — может раскрыть мою секту еретиков и казнить меня.",shape=box,color=blue];
		j1137989591 -> j3234203882;
		j1137989591 -> j4109439858;
	j802676067 [label="У меня просто нет времени на него, извини.",shape=box,color=red];
		j802676067 -> j2710153948;
	j2455912516 [label="Ты права, извини. Не это было в моих намерениях.",shape=box,color=red];
		j2455912516 -> j3471875135;
	j1694013419 [label="Которые извлекаются из Бездны, именно благодаря им мы можем создавать множество мощных варфреймов и оружия.",shape=box,color=red];
		j1694013419 -> j1211831517;
	j3234203882 [label="Этого... не будет. Продолжай говорить.",shape=box,color=red];
		j3234203882 -> j4237296056;
	j4109439858 [label="Баллас мертв... продолжай.",shape=box,color=red];
		j4109439858 -> j4237296056;
	j2710153948 [label="Тогда мне жаль, что я потратила еще больше времени.",shape=box,color=blue];
		j2710153948 -> j3007723528;
	j1211831517 [label="Он специализировался на кристаллографии. И его труды были сохранены здесь, в лабораториях.",shape=box,color=red];
		j1211831517 -> j1771166649;
	j4237296056 [label="+5 Chemistry",color=orange];
		j4237296056 -> j2098257419;
	j3007723528 [label="Boolean MarieOtakComplete is now true.",color=orange];
		j3007723528 -> "Chat ends.";
	j1771166649 [label="По какой-то причине, я не знаю, его превратили в Цефалона и дали ему собственную некралоидную оболочку.",shape=box,color=red];
		j1771166649 -> j2823318641;
	j2098257419 [label="Я подозревала... Ну, он спросил меня, откуда я, и когда я ему рассказала, он рассмеялся и сказал: «Нет, это невозможно! А я-то знаю, я -»",shape=box,color=blue];
		j2098257419 -> j3080571554;
	j2823318641 [label="Не все Цефалоны были созданы в наказание. Но здесь, на Деймосе, дела пошли... плохо, и он был серьёзно повреждён.",shape=box,color=red];
		j2823318641 -> j646397063;
	j3080571554 [label="А потом он… снова представился мне. И спросил, не с равнин ли я привезла образцы минералов...",shape=box,color=blue];
		j3080571554 -> j976803763;
		j3080571554 -> j1809265966;
	j646397063 [label="Pauvre petit...",shape=box,color=blue];
		j646397063 -> j1698645168;
	j976803763 [label="Ой, Мари. Мне так жаль...",shape=box,color=red];
		j976803763 -> j1398776889;
	j1809265966 [label="Да... это Отак.",shape=box,color=red];
		j1809265966 -> j1398776889;
	j1698645168 [label="Boolean MarieOtak1 is now true.",color=orange];
		j1698645168 -> j1905210440;
		j1698645168 -> j1132064860;
	j1398776889 [label="Меня разбивает на миллион осколков мысль о том, что для него ничего нельзя сделать.",shape=box,color=blue];
		j1398776889 -> j1970966774;
	j1970966774 [label="Evaluate expressions",color=orange];
		j1970966774 -> j2647094904 [label="MarieCephalonSoul",color=purple];
		j1970966774 -> j3407158518 [label="MarieCephalonNoSoul",color=purple];
		j1970966774 -> j1648138065 [label="MarieCephalonUnsure",color=purple];
		j1970966774 -> j2240463095 [label="false",color=purple];
	j2647094904 [label="О, Светила, что же ты для него устроил, чтобы держать его душу в ловушке этой клетки науки и мерцающих огней ?",shape=box,color=blue];
		j2647094904 -> j3396524990;
	j3407158518 [label="Я могу только молиться Светилам, чтобы ты был прав, и внутри этой оболочки не осталось ничего, кроме... только науки и мерцающих огней.",shape=box,color=blue];
		j3407158518 -> j4053443649;
	j1648138065 [label="Я знаю, ты не знаешь, есть ли у Цефалонов души, но я могу только молиться Светилам, чтобы... этот бедный Отак не страдал.",shape=box,color=blue];
		j1648138065 -> j2162668512;
	j2240463095 [label="Я могу только молиться Светилам, чтобы внутри этой оболочки остались только... наука и мерцающие огни.",shape=box,color=blue];
		j2240463095 -> j267313024;
	j3396524990 [label="Зачем оставлять его там, сломленного и ждущего, пока ему позволят умереть и обрести покой? Я могу только молиться... что если там есть хоть какое-то присутствие -",shape=box,color=blue];
		j3396524990 -> j646954086;
	j4053443649 [label="И ни одна душа не заперта в этом сломанном существе, ожидая, пока ей наконец позволят умереть, чтобы обрести покой.",shape=box,color=blue];
		j4053443649 -> j3665251274;
	j2162668512 [label="Что ни одна душа не заперта в этом сломанном существе, ожидая, пока ей наконец позволят умереть, чтобы обрести покой.",shape=box,color=blue];
		j2162668512 -> j904696999;
	j267313024 [label="И ни одна душа не заперта в этом сломанном существе, ожидая, пока ей наконец позволят умереть, чтобы обрести покой.",shape=box,color=blue];
		j267313024 -> j904696999;
	j646954086 [label="Потому что он по собственному выбору остается своего рода одиноким дозором...",shape=box,color=blue];
		j646954086 -> j427655505;
	j3665251274 [label="А что если ты ошибаешься, и душа остаётся в этой клетке против своей воли ?",shape=box,color=blue];
		j3665251274 -> j232300904;
	j904696999 [label="Или, если там и есть какое-то присутствие, то это потому, что он остается там по своему выбору, в форме одинокого дозора.",shape=box,color=blue];
		j904696999 -> j427655505;
	j427655505 [label="Думать иначе — значит усомниться в доброте богов, non ?",shape=box,color=blue];
		j427655505 -> j4093335892;
	j232300904 [label="Достаточно лишь усомниться в доброте богов, non ?",shape=box,color=blue];
		j232300904 -> j4093335892;
	j4093335892 [label="И где бы я тогда была?",shape=box,color=blue];
		j4093335892 -> j1615376928;
	j1615376928 [label="Прости меня, я... je suis melancolique aujourd'hui.",shape=box,color=blue];
		j1615376928 -> j4190999030;
	j4190999030 [label="Evaluate expressions",color=orange];
		j4190999030 -> j511654286 [label="MarieRoathePastry1",color=purple];
		j4190999030 -> j3500727321 [label="MarieRoathePastry1",color=purple];
		j4190999030 -> j1554023851 [label="MarieRoathePastry1",color=purple];
		j4190999030 -> j2287420529 [label="MarieRoathePastry1",color=purple];
		j4190999030 -> j511654286 [label="RoatheMariePastry1",color=purple];
		j4190999030 -> j3500727321 [label="RoatheMariePastry1",color=purple];
		j4190999030 -> j1554023851 [label="RoatheMariePastry1",color=purple];
		j4190999030 -> j2287420529 [label="RoatheMariePastry1",color=purple];
		j4190999030 -> j511654286 [label="false",color=purple];
		j4190999030 -> j1554023851 [label="false",color=purple];
		j4190999030 -> j2287420529 [label="false",color=purple];
	j511654286 [label="Могу я чем-нибудь тебя подбодрить? Можем пойти поиздеваться над Роутом.",shape=box,color=red];
		j511654286 -> j2477455347;
	j3500727321 [label="Могу я чем-нибудь тебя подбодрить? Может, украсть немного выпечки?",shape=box,color=red];
		j3500727321 -> j1101274222;
	j1554023851 [label="Иногда боги бывают жестоки, Мари. Такова жизнь.",shape=box,color=red];
		j1554023851 -> j3009620550;
	j2287420529 [label="Всё в порядке. У тебя есть на это полное право.",shape=box,color=red];
		j2287420529 -> j2582180110;
	j2477455347 [label="+15 Chemistry",color=orange];
		j2477455347 -> j2791456060;
	j1101274222 [label="+20 Chemistry",color=orange];
		j1101274222 -> j2791456060;
	j3009620550 [label="+5 Chemistry",color=orange];
		j3009620550 -> j3592968611;
	j2582180110 [label="+20 Chemistry",color=orange];
		j2582180110 -> j54735747;
	j2791456060 [label="Ха! Merci. Это точно остановит мои глупые слезы. Ты ведь умеешь подбодрить глупенькую Мари, non ?",shape=box,color=blue];
		j2791456060 -> j3779125387;
		j2791456060 -> j2746178515;
	j3592968611 [label="Да. Это так. Так оно и есть. Мир полон историй, подобных истории господина Отака, и много историй гораздо хуже. Я бы не стала плакать ни над одной из них. ",shape=box,color=blue];
		j3592968611 -> j4250739183;
	j54735747 [label="Merci. Ну, больше не хочу. Пойду займусь чем-нибудь более весёлым! Кажется, аквариум M'sieur Фибоначчи пора прочистить.",shape=box,color=blue];
		j54735747 -> j2425134241;
	j3779125387 [label="Ты совсем не глупишь. Я чувствую то же самое.",shape=box,color=red];
		j3779125387 -> j2235898819;
	j2746178515 [label="Это самое малое, что я могу для тебя сделать.",shape=box,color=red];
		j2746178515 -> j2235898819;
	j4250739183 [label="И вот я сижу и делаю именно это. Спасибо, что напомнили мне о моей глупости. Фу! Глупенькая Мари. Ну... Думаю, аквариум M'sieur Фибоначчи пора протереть от пыли.",shape=box,color=blue];
		j4250739183 -> j2425134241;
	j2425134241 [label="Check boolean MarieDating",color=orange];
		j2425134241 -> j731108299 [label=true,color=green];
		j2425134241 -> j3132378552 [label=false,color=brown];
	j2235898819 [label="+5 Chemistry",color=orange];
		j2235898819 -> j4093292054;
	j731108299 [label="À la revoyure, мой волк.",shape=box,color=blue];
		j731108299 -> j3007723528;
	j3132378552 [label="À la revoyure!",shape=box,color=blue];
		j3132378552 -> j3007723528;
	j4093292054 [label="Check boolean MarieDating",color=orange];
		j4093292054 -> j1927676598 [label=true,color=green];
		j4093292054 -> j2093572631 [label=false,color=brown];
	j1927676598 [label="Merci, merci, merci, my wolf. Let us go, then, and make mischief. ",shape=box,color=blue];
		j1927676598 -> j3007723528;
	j2093572631 [label="Merci, merci, merci. Let us go, then, and make mischief.",shape=box,color=blue];
		j2093572631 -> j3007723528;
}