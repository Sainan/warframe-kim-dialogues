	3190 [label="Oh, Luminaries - what manner of hell have you made for him, to keep his soul trapped within that cage of science and flickering lights ?",shape=box,color=blue];
		3190 -> 3194;
	3189 [label="I can only pray to the Luminaries that you are right and nothing remains inside that shell but... but science and flickering lights.",shape=box,color=blue];
		3189 -> 3193;
	3188 [label="I know you are not sure if the Cephalons contain souls - but I can only pray to the Luminaries that... that poor Otak does not suffer.",shape=box,color=blue];
		3188 -> 3192;
	3187 [label="I can only pray to the Luminaries that all that remains inside that shell is nothing but... but science and flickering lights.",shape=box,color=blue];
		3187 -> 3191;
	3194 [label="Why leave him there, broken and waiting until he is allowed to die to be given peace? I can only pray... that if there is some kind of presence there -",shape=box,color=blue];
