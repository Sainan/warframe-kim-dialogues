	3212 [label="Ha ! Merci. That is sure to stop these foolish tears of mine. You do know how to cheer silly little Marie, non ?",shape=box,color=blue];
		3212 -> 3215;
		3212 -> 3216;
	3213 [label="Oui. You are quite right. They are. The world is full of no end of stories like that of Monsieur Otak, and many far worse than his. I should not weep over one. ",shape=box,color=blue];
		3213 -> 3217;
	3214 [label="Merci. Well, I no longer wish to be. I am going to go do something more cheerful ! I think M'sieur Fibonacci's tank is due for a dusting.",shape=box,color=blue];
