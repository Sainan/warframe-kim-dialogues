	3141 [label="The face upon the back of Monsieur Necraloid ! I have finally met him !",shape=box,color=blue];
		3141 -> 3145;
		3141 -> 3146;
		3141 -> 3147;
	3143 [label="How did your conversation with him go?",shape=box,color=red];
		3143 -> 3148;
	3144 [label="Did you enjoy talking to him?",shape=box,color=red];
		3144 -> 3149;
	3145 [label="You met Otak? Oh boy... How did that go?",shape=box,color=red];
		3145 -> 3150;
	3146 [label="I'm glad you finally met. Otak can be a little hard to explain.",shape=box,color=red];
		3146 -> 3151;
	3147 [label="Poor Otak... How did that go?",shape=box,color=red];
		3147 -> 3152;
	3148 [label="He... introduced himself to me thrice over in the same conversation, as though we had never been introduced.",shape=box,color=blue];
		3148 -> 3153;
	3149 [label="I did. Though perhaps I wanted to weep for it. For he introduced himself to me thrice over in the same conversation, as though we had never been introduced.",shape=box,color=blue];
		3149 -> 3153;
	3150 [label="Why do you sound less than pleased that I met him ?",shape=box,color=blue];
		3150 -> 3154;
		3150 -> 3155;
		3150 -> 3156;
	3151 [label="Yes, I would think so. A child's scrawl written on the back of an automaton. I found him nothing but sweet and charming !",shape=box,color=blue];
		3151 -> 3157;
	3152 [label="I found him nothing but sweet and charming ! But buried beneath a layer of humor, I felt great heartbreak.",shape=box,color=blue];
		3152 -> 3158;
	3153 [label="Greeting me in the same unflinching, cheerful way he had the previous times. But he knew me as a Sœur de Sol ! ",shape=box,color=blue];
		3153 -> 3159;
	3154 [label="I'm sorry. He can get on people's nerves sometimes. It's not his fault.",shape=box,color=red];
		3154 -> 3160;
	3155 [label="I didn't mean to. He can just be a little... off putting for some people.",shape=box,color=red];
		3155 -> 3160;
	3156 [label="He can get on my nerves sometimes, is all. ",shape=box,color=red];
		3156 -> 3161;
	3157 [label="But buried beneath the humor, there is great heartbreak.",shape=box,color=blue];
		3157 -> 3158;
	3158 [label="Не расскажешь ли мне историю бедного Monsieur Отака?",shape=box,color=blue];
		3158 -> 3162;
	3159 [label="Indeed, he knew much of the Luminaries ! We talked at length of the \"Ancient Religions\" as he dubbed them, in the \"days before the Orokin Empire.\"",shape=box,color=blue];
		3159 -> 3163;
	3160 [label="And I would hope they would show him kindness and patience. Mais par la grâce de Sol, go we all.",shape=box,color=blue];
		3160 -> 3164;
	3161 [label="I would hope you would seek to be more kind with someone who is clearly infirme. But for the grace of Sol go we, after all.",shape=box,color=blue];
		3161 -> 3164;
	3162 [label="Раньше Отак был архимедиан, учёным и академиком Орокин. То, что с ним произошло, нельзя назвать особенно радостной историей.",shape=box,color=red];
		3162 -> 3165;
	3163 [label="Though he said much of that knowledge was lost now, deep in the archives, and very much forbidden. He swore me to secrecy.",shape=box,color=blue];
		3163 -> 3166;
	3164 [label="Such a fate could wait for any of us. Even you.",shape=box,color=blue];
		3164 -> 3167;
		3164 -> 3168;
	3165 [label="Судя по всему, он был гением и умом, стоящим за освоением кристаллов аргона.",shape=box,color=red];
		3165 -> 3169;
	3166 [label="He told me that he was deeply concerned that Executor Ballas - whoever he may be - might discover my sect of heretics and have me executed.",shape=box,color=blue];
		3166 -> 3170;
		3166 -> 3171;
	3167 [label="I just don't have the time to spend on him, I'm sorry.",shape=box,color=red];
		3167 -> 3172;
	3168 [label="You're right, I'm sorry. I didn't mean that.",shape=box,color=red];
		3168 -> 3158;
	3169 [label="Которые извлекаются из Бездны, именно благодаря им мы можем создавать множество мощных варфреймов и оружия.",shape=box,color=red];
		3169 -> 3173;
	3170 [label="That... won't happen. Keep talking.",shape=box,color=red];
		3170 -> 3174;
	3171 [label="Ballas is dead... keep going.",shape=box,color=red];
		3171 -> 3174;
	3172 [label="Then I am sorry for wasting more of it.",shape=box,color=blue];
		3172 -> 3175;
	3173 [label="Он специализировался на кристаллографии. И его труды были сохранены здесь, в лабораториях.",shape=box,color=red];
		3173 -> 3176;
	3174 [label="+5 Chemistry",color=orange];
		3174 -> 3177;
	3175 [label="Update boolean MarieOtakComplete",color=orange];
		3175 -> 3178;
	3176 [label="По какой-то причине, я не знаю, его превратили в Цефалона и дали ему собственную некралоидную оболочку.",shape=box,color=red];
		3176 -> 3179;
	3177 [label="I suspected... Well, he asked me where I was from, and when I told him, he laughed and said \"no, that's impossible! And I should know, I'm -\"",shape=box,color=blue];
		3177 -> 3180;
	3178 [label="Chat ends.",color=orange];
	3179 [label="Не все Цефалоны были созданы в наказание. Но здесь, на Деймосе, дела пошли... плохо, и он был серьёзно повреждён.",shape=box,color=red];
		3179 -> 3181;
	3180 [label="And then he... introduced himself to me again. And asked me if I was coming from the plaines with mineral samples...",shape=box,color=blue];
		3180 -> 3182;
		3180 -> 3183;
	3181 [label="Pauvre petit...",shape=box,color=blue];
		3181 -> 3184;
	3182 [label="Oh, Marie. I'm so sorry...",shape=box,color=red];
		3182 -> 3185;
	3183 [label="Yeah... that's Otak.",shape=box,color=red];
		3183 -> 3185;
	3184 [label="Update boolean MarieOtak1",color=orange];
		3184 -> 3143;
		3184 -> 3144;
