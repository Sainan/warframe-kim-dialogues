	2803 [label="Ох, какой добрый вопрос ты задал… Со мной всё будет в порядке. Я не хочу тебя тревожить. Лучше оставить меня до завтра.",shape=box,color=blue];
		2803 -> 2806;
		2803 -> 2807;
	2805 [label="О, mon cœur, какой добрый вопрос ты задаёшь… но, как всегда, боюсь, это всего лишь вопрос сравнения. Но ты ведь знаешь, что это такое, я уверена, oui?",shape=box,color=blue];
