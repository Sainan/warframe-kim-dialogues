	j2205340338 [label="Check boolean DrifterChronicPain",color=orange];
		j2205340338 -> j2938006012 [label=true,color=green];
		j2205340338 -> j2413208739 [label=false,color=brown];
	j2943152006 [label="О, mon cœur, какой добрый вопрос ты задал… Со мной всё будет в порядке. Я не хочу тебя тревожить. Лучше оставить меня до завтра.",shape=box,color=blue];
		j2943152006 -> j3206346742;
		j2943152006 -> j3448023468;
	j899553308 [label="Check boolean DrifterChronicPain",color=orange];
		j899553308 -> j3223770931 [label=true,color=green];
		j899553308 -> j3127806446 [label=false,color=brown];
	j1485810164 [label="Ох, какой добрый вопрос ты задал… Со мной всё будет в порядке. Я не хочу тебя тревожить. Лучше оставить меня до завтра.",shape=box,color=blue];
		j1485810164 -> j3206346742;
		j1485810164 -> j3448023468;
	j2938006012 [label="О, mon cœur, какой добрый вопрос ты задаёшь… но, как всегда, боюсь, это всего лишь вопрос сравнения. Но ты ведь знаешь, что это такое, я уверена, oui?",shape=box,color=blue];
		j2938006012 -> j1435005179;
		j2938006012 -> j1278971846;
	j2413208739 [label="О, mon cœur, какой добрый вопрос ты задаёшь… но, как всегда, боюсь, это лишь вопрос сравнения.",shape=box,color=blue];
		j2413208739 -> j4275637308;
		j2413208739 -> j1085654029;
	j3206346742 [label="Что-то случилось?",shape=box,color=red];
		j3206346742 -> j155334422;
	j3448023468 [label="Хорошо, если ты так хочешь.",shape=box,color=red];
		j3448023468 -> j1354157720;
	j3223770931 [label="О, какой добрый вопрос ты задаёшь… но, как всегда, боюсь, это всего лишь вопрос сравнения. Но ты ведь знаешь, что это такое, я уверена, oui?",shape=box,color=blue];
		j3223770931 -> j1435005179;
		j3223770931 -> j1278971846;
	j3127806446 [label="О, какой добрый вопрос ты задаёшь… но, как всегда, боюсь, это всего лишь вопрос сравнения.",shape=box,color=blue];
		j3127806446 -> j4275637308;
		j3127806446 -> j1085654029;
	j1435005179 [label="Мне жаль, если вопрос оказался для тебя болезненным.",shape=box,color=red];
		j1435005179 -> j132869135;
	j1278971846 [label="Могу ли я чем‑нибудь помочь, чтобы тебе стало легче или отвлечь тебя?",shape=box,color=red];
		j1278971846 -> j2185695993;
	j4275637308 [label="Ой, прости... сегодня сильная боль? ",shape=box,color=red];
		j4275637308 -> j1738556639;
	j1085654029 [label="Могу ли я что-то сделать?",shape=box,color=red];
		j1085654029 -> j661866909;
	j155334422 [label="Vraiment gentil с твоей стороны, но это старая проблема, не стоит из-за неё беспокоиться. Со мной всё будет в порядке.",shape=box,color=blue];
		j155334422 -> j3359734167;
	j1354157720 [label="+10 Chemistry",color=orange];
		j1354157720 -> j2344087059;
	j132869135 [label="+10 Chemistry",color=orange];
		j132869135 -> j905250749;
	j2185695993 [label="+10 Chemistry",color=orange];
		j2185695993 -> j2410909607;
	j1738556639 [label="Oui, боюсь, так и есть. Разум - поистине удивительная вещь. Меня поражает, что они должны постоянно причинять боль, и всё же я научилась просто не обращать на них внимания.",shape=box,color=blue];
		j1738556639 -> j3117392079;
		j1738556639 -> j1661970435;
		j1738556639 -> j1051066108;
	j661866909 [label="Ты делаешь это и сейчас, разговаривая со мной. Разум - удивительная вещь, не так ли? Думаю, mes pieds должны болеть всё время, но я научилась просто не обращать на это внимания.",shape=box,color=blue];
		j661866909 -> j3117392079;
		j661866909 -> j1661970435;
		j661866909 -> j1051066108;
	j3359734167 [label="Boolean MarieChronicPain is now true.",color=orange];
		j3359734167 -> j3385487822;
		j3359734167 -> j114172395;
		j3359734167 -> j3328649764;
	j2344087059 [label="Да, уверяю тебя, со мной всё в порядке. Но спасибо. Я ценю твою заботу.",shape=box,color=blue];
		j2344087059 -> "Chat ends.";
	j905250749 [label="Ха! Забавно, как это работает, non? Твои слова верны. Я ведь и не думала о mes pieds, а теперь думаю, и они болят.",shape=box,color=blue];
		j905250749 -> j3347083596;
	j2410909607 [label="Oui! Ты делаешь это и сейчас, разговаривая со мной. Разум - удивительная вещь, не так ли? Думаю, mes pieds должны болеть всё время, но я научилась просто не обращать на это внимания.",shape=box,color=blue];
		j2410909607 -> j3658490101;
		j2410909607 -> j3392698654;
		j2410909607 -> j3037262681;
	j3117392079 [label="Это звучит утомительно...",shape=box,color=red];
		j3117392079 -> j3506920603;
	j1661970435 [label="Это, наверное, раздражает.",shape=box,color=red];
		j1661970435 -> j2716662205;
	j1051066108 [label="Неужели нет лекарства? Это никогда не прекратится?",shape=box,color=red];
		j1051066108 -> j2482585525;
	j3385487822 [label="Если ты уверена, но я рядом, если захочешь поговорить об этом.",shape=box,color=red];
		j3385487822 -> j3376753888;
	j114172395 [label="Я… знаю, каково это. Прежде чем начались мои «зацикливания», меня сильно поранило в Дувири. Рана зажила, но время от времени всё ещё ужасно ноет. Я стараюсь скрыть, когда боль возвращается.",shape=box,color=red];
		j114172395 -> j2368887637;
	j3328649764 [label="Старые, неразрешённые проблемы могут быть не менее трудными, чем новые. То, что они приходят и уходят, остаются с нами, вовсе не значит, что о них не стоит говорить.",shape=box,color=red];
		j3328649764 -> j1925321156;
	j3347083596 [label="Разум - поистине удивительная вещь. Меня поражает, что они должны постоянно причинять боль, и всё же я научилась просто не обращать на них внимания.",shape=box,color=blue];
		j3347083596 -> j3658490101;
		j3347083596 -> j3392698654;
		j3347083596 -> j3037262681;
	j3658490101 [label="У меня то же самое. Стоит мне сосредоточиться — и больно. Иногда возникает мысль, не поэтому ли так много всего происходит.",shape=box,color=red];
		j3658490101 -> j1660637661;
	j3392698654 [label="Иногда меня злит, когда думаю о том, сколько всего можно было бы сделать, если эта боль не отвлекала меня всё время.",shape=box,color=red];
		j3392698654 -> j1378819069;
	j3037262681 [label="Ты тоже всё время устаёшь? Иногда я думаю, может, поэтому я так устаю. Постоянно трачу силы на то, чтобы терпеть боль где-то на заднем плане.",shape=box,color=red];
		j3037262681 -> j1301289823;
	j3506920603 [label="+10 Chemistry",color=orange];
		j3506920603 -> j870663641;
	j2716662205 [label="Check boolean MarieSecretPower",color=orange];
		j2716662205 -> j297807142 [label=true,color=green];
		j2716662205 -> j1172064548 [label=false,color=brown];
	j2482585525 [label="Non... это никогда не прекратится. Я могу только отвлечься, например, разговаривая, как сейчас. Или оставаясь занятой.",shape=box,color=blue];
		j2482585525 -> j2148493269;
	j3376753888 [label="Это очень любезно с твоей стороны, и... это очень хорошо. Я снова немного упрямая Мари.",shape=box,color=blue];
		j3376753888 -> j1679312995;
	j2368887637 [label="Boolean DrifterChronicPain is now true.",color=orange];
		j2368887637 -> j896963860;
	j1925321156 [label="Oui, верно. Я снова немного упрямая Мари.",shape=box,color=blue];
		j1925321156 -> j1679312995;
	j1660637661 [label="+5 Chemistry",color=orange];
		j1660637661 -> j2989056568;
	j1378819069 [label="Check boolean MarieSecretPower",color=orange];
		j1378819069 -> j880089050 [label=true,color=green];
		j1378819069 -> j827813214 [label=false,color=brown];
	j1301289823 [label="+5 Chemistry",color=orange];
		j1301289823 -> j791043943;
	j870663641 [label="Oui, это так. Например -",shape=box,color=blue];
		j870663641 -> j360638840;
	j297807142 [label="Но ведь, как ты сказал, non? Все неудобства, как мои, приходят с тайной силой. Нужно просто найти их.",shape=box,color=blue];
		j297807142 -> j576760067;
	j1172064548 [label="Oui, верно. Иногда я сидела и смотрела на книгу на верхней полке и думала, как же это несправедливо, что я не могу её достать.",shape=box,color=blue];
		j1172064548 -> j2663244426;
	j2148493269 [label="На днях я вытирала пыль со всех люстр в Санктуме. Monsieur Лойд умолял меня остановиться.",shape=box,color=blue];
		j2148493269 -> j1797594056;
	j1679312995 [label="Это трудно объяснить, но я попробую. Mes pieds, oui? Мои ноги. The sérum изменила меня, подарила мне полёт -",shape=box,color=blue];
		j1679312995 -> j1461364626;
	j896963860 [label="Par les Luminaires, мне очень жаль. Ты понимаешь, каково это, oui?",shape=box,color=blue];
		j896963860 -> j593711406;
	j2989056568 [label="Oui! Ох, на днях я вытирала пыль со всех люстр в Санктуме. Monsieur Лойд умолял меня остановиться.",shape=box,color=blue];
		j2989056568 -> j39011074;
	j880089050 [label="Но ведь, как ты сказал, non? Все неудобства, как наши, приходят с тайной силой. Нужно просто найти их.",shape=box,color=blue];
		j880089050 -> j3348086972;
	j827813214 [label="Да, я понимаю твоё разочарование. Иногда я просто сидела и смотрела на книгу на верхней полке и думала, как же это было несправедливо, что я не могла до неё дотянуться.",shape=box,color=blue];
		j827813214 -> j3291959011;
	j791043943 [label="Oui!! Ох, ты понимаешь!! Par exemple -",shape=box,color=blue];
		j791043943 -> j3067976241;
	j360638840 [label="Ты знаешь, как утомительно всё время парить, jour après jour, heure après heure, когда другие могут просто ходить?",shape=box,color=blue];
		j360638840 -> j2215040923;
	j576760067 [label="Но да, это раздражает. Иногда я сидела и смотрела на книгу на верхней полке и думала, как же несправедливо, что я не могу её достать.",shape=box,color=blue];
		j576760067 -> j2663244426;
	j2663244426 [label="В ней была та информация, которая была важна только мне, никому другому, так почему же мне в этом отказывали? И тут появлялся кто-то с добрыми намерениями и сжалился, доставая её для меня...",shape=box,color=blue];
		j2663244426 -> j917206217;
	j1797594056 [label="Я сказала ему, что мне нужно быть занятой, что я должна постоянно что-то делать. Мне кажется, он не совсем понял, почему я обязана оставаться такой активной.",shape=box,color=blue];
		j1797594056 -> j3329581818;
	j1461364626 [label="Но я всё ещё чувствую их, эти искажённые, зловещие силы, что грозили поглотить меня, раздавить всю надежду и радость в моей душе.",shape=box,color=blue];
		j1461364626 -> j2621188836;
	j593711406 [label="Иметь тело, которое предаёт тебя, которое замедляет твой дух… Даже теперь это кажется таким странным. Sérum изменила меня, подарила мне полёт -",shape=box,color=blue];
		j593711406 -> j2032594754;
	j39011074 [label="Я сказала ему, что мне нужно быть занятой, что я должна постоянно что-то делать. Мне кажется, он не совсем понял, почему я обязана оставаться такой активной.",shape=box,color=blue];
		j39011074 -> j3114060376;
	j3348086972 [label="Но я понимаю твоё разочарование. Ох, я его хорошо знаю. Иногда я просто сидела и смотрела на книгу на верхней полке и думала, как же это было несправедливо, что я не могла до неё дотянуться.",shape=box,color=blue];
		j3348086972 -> j3291959011;
	j3291959011 [label="В ней была та информация, которая была важна только мне, никому другому, так почему же мне в этом отказывали? И тут появлялся кто-то с добрыми намерениями и сжалился, доставая её для меня...",shape=box,color=blue];
		j3291959011 -> j1689600186;
		j3291959011 -> j3807993204;
	j3067976241 [label="Ты знаешь, как утомительно всё время парить, jour après jour, heure après heure, когда другие могут просто ходить?",shape=box,color=blue];
		j3067976241 -> j896694473;
	j2215040923 [label="Я в восторге от того, что могу так свободно передвигаться, что могу дотянуться до всего, чего пожелаю, не пойми меня неправильно. Но всё это по-прежнему так утомительно!",shape=box,color=blue];
		j2215040923 -> j3329581818;
	j917206217 [label="И это не их вина, они совершают добрый поступок, мне нужна была помощь. И это не их вина, что я в ней нуждалась. Но, боже, как же раздражает нуждаться в этой помощи.",shape=box,color=blue];
		j917206217 -> j1823319015;
		j917206217 -> j3683727546;
	j3329581818 [label="Просто... так приятно иметь возможность обо всём этом говорить. Я даже не могу как следует выразить это словами. Так редко удаётся обсудить эту невидимую, безмолвную болезнь, от которой я страдаю.",shape=box,color=blue];
		j3329581818 -> j3911239142;
	j2621188836 [label="Они всегда причиняют боль. Всегда. Даже сейчас, когда я сижу здесь, стоит мне о них подумать, и я чувствую эту боль. Но бывает, что просто замечать её недостаточно.",shape=box,color=blue];
		j2621188836 -> j1085654029;
		j2621188836 -> j4275637308;
	j2032594754 [label="Но я всё ещё чувствую их, эти искажённые, зловещие силы, что грозили поглотить меня, раздавить всю надежду и радость в моей душе.",shape=box,color=blue];
		j2032594754 -> j2254323678;
	j3114060376 [label="Ах, как же я рада знать, что кто-то здесь понимает, каково это. Это такая редкость. Эта тихая, невидимая чума, от которой мы страдаем.",shape=box,color=blue];
		j3114060376 -> j206389672;
	j1689600186 [label="И что в этом плохого?",shape=box,color=red];
		j1689600186 -> j1310731;
	j3807993204 [label="Да, я знаю. И это не их вина.",shape=box,color=red];
		j3807993204 -> j4128591991;
	j896694473 [label="Я в восторге от того, что могу так свободно передвигаться, что могу дотянуться до всего, чего пожелаю, не пойми меня неправильно. Но всё это по-прежнему так утомительно!!",shape=box,color=blue];
		j896694473 -> j3114060376;
	j1823319015 [label="Мне очень жаль, что тебе приходится все это терпеть. ",shape=box,color=red];
		j1823319015 -> j2543446924;
	j3683727546 [label="И ты даже не можешь выразить это разочарование.",shape=box,color=red];
		j3683727546 -> j2543446924;
	j3911239142 [label="Как маленькая abeille, что садится мне на плечо и жалит каждый день. Не достаточно, чтобы уничтожить, но вполне достаточно, чтобы раздражать.",shape=box,color=blue];
		j3911239142 -> j1036924648;
		j3911239142 -> j1971992337;
	j2254323678 [label="Они всегда причиняют боль. Всегда. Даже сейчас, когда я сижу здесь, стоит мне о них подумать, и я чувствую эту боль. Но бывает, что просто замечать её недостаточно.",shape=box,color=blue];
		j2254323678 -> j1278971846;
		j2254323678 -> j1435005179;
	j206389672 [label="Как маленькая abeille, что садится на нас и жалит каждый день. Не настолько, чтобы нас уничтожить, но достаточно, чтобы раздражать.",shape=box,color=blue];
		j206389672 -> j1971992337;
		j206389672 -> j1036924648;
	j1310731 [label="Ничего! Ничего плохого нет. Мне была нужна помощь. Но вот в чём суть, мне была нужна помощь. И это, как ты сказал… раздражает.",shape=box,color=blue];
		j1310731 -> j787153196;
	j4128591991 [label="Oui! Это не их вина, они совершают добрый поступок, мне нужна была помощь. И это не их вина, что я в ней нуждалась. Но, боже, как же раздражает нуждаться в этой помощи.",shape=box,color=blue];
		j4128591991 -> j787153196;
	j2543446924 [label="+10 Chemistry",color=orange];
		j2543446924 -> j3329581818;
	j1036924648 [label="Ну, хотелось бы, чтобы она исчезла...",shape=box,color=red];
		j1036924648 -> j4289342048;
	j1971992337 [label="Что такое «abeille»?",shape=box,color=red];
		j1971992337 -> j2911312181;
	j787153196 [label="+5 Chemistry",color=orange];
		j787153196 -> j3114060376;
	j4289342048 [label="И я тоже! Но в то же время это делает нас частью того, кто мы есть, non? Кто мы такие, чтобы решать, какие наши части важны, а какие нет?",shape=box,color=blue];
		j4289342048 -> j2427033551;
	j2911312181 [label="О! Маленькое существо, желто-черное, в полоску, с иголкой на derrière... производит мед?",shape=box,color=blue];
		j2911312181 -> j2661385443;
		j2911312181 -> j1622376761;
	j2427033551 [label="Evaluate expressions",color=orange];
		j2427033551 -> j1547361545 [label="DrifterFaithStop",color=purple];
		j2427033551 -> j2949504973 [label="DrifterFaithYesSimilar",color=purple];
		j2427033551 -> j133840480 [label="DrifterFaithYesForeign",color=purple];
