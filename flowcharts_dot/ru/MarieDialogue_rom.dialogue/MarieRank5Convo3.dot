		2800 -> 2804 [label=false,color=brown];
	2801 [label="О, mon cœur, какой добрый вопрос ты задал… Со мной всё будет в порядке. Я не хочу тебя тревожить. Лучше оставить меня до завтра.",shape=box,color=blue];
