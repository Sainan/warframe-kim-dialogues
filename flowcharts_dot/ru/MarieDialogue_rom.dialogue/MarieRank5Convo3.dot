		2807 -> 2815;
	2808 [label="О, какой добрый вопрос ты задаёшь… но, как всегда, боюсь, это всего лишь вопрос сравнения. Но ты ведь знаешь, что это такое, я уверена, oui?",shape=box,color=blue];
		2808 -> 2812;
		2808 -> 2813;
	2809 [label="О, какой добрый вопрос ты задаёшь… но, как всегда, боюсь, это всего лишь вопрос сравнения.",shape=box,color=blue];
		2809 -> 2810;
		2809 -> 2811;
	2812 [label="Мне жаль, если вопрос оказался для тебя болезненным.",shape=box,color=red];
		2812 -> 2818;
	2813 [label="Могу ли я чем‑нибудь помочь, чтобы тебе стало легче или отвлечь тебя?",shape=box,color=red];
		2813 -> 2819;
	2810 [label="Ой, прости... сегодня сильная боль? ",shape=box,color=red];
		2810 -> 2816;
	2811 [label="Могу ли я что-то сделать?",shape=box,color=red];
		2811 -> 2817;
	2814 [label="Vraiment gentil с твоей стороны, но это старая проблема, не стоит из-за неё беспокоиться. Со мной всё будет в порядке.",shape=box,color=blue];
		2814 -> 2820;
	2815 [label="+10 Chemistry",color=orange];
		2815 -> 2821;
	2818 [label="+10 Chemistry",color=orange];
		2818 -> 2825;
	2819 [label="+10 Chemistry",color=orange];
		2819 -> 2826;
	2816 [label="Oui, боюсь, так и есть. Разум - поистине удивительная вещь. Меня поражает, что они должны постоянно причинять боль, и всё же я научилась просто не обращать на них внимания.",shape=box,color=blue];
		2816 -> 2822;
		2816 -> 2823;
		2816 -> 2824;
	2817 [label="Ты делаешь это и сейчас, разговаривая со мной. Разум - удивительная вещь, не так ли? Думаю, mes pieds должны болеть всё время, но я научилась просто не обращать на это внимания.",shape=box,color=blue];
		2817 -> 2822;
		2817 -> 2823;
		2817 -> 2824;
	2820 [label="Update boolean MarieChronicPain",color=orange];
		2820 -> 2827;
		2820 -> 2828;
		2820 -> 2829;
	2821 [label="Да, уверяю тебя, со мной всё в порядке. Но спасибо. Я ценю твою заботу.",shape=box,color=blue];
		2821 -> 2830;
	2825 [label="Ха! Забавно, как это работает, non? Ты прав. Я ведь и не думала о mes pieds, а теперь думаю, и они болят. ",shape=box,color=blue];
		2825 -> 2834;
	2826 [label="Oui! Ты делаешь это и сейчас, разговаривая со мной. Разум - удивительная вещь, не так ли? Думаю, mes pieds должны болеть всё время, но я научилась просто не обращать на это внимания.",shape=box,color=blue];
		2826 -> 2835;
		2826 -> 2836;
		2826 -> 2837;
	2822 [label="Это звучит утомительно...",shape=box,color=red];
		2822 -> 2831;
	2823 [label="Это, наверное, раздражает.",shape=box,color=red];
		2823 -> 2832;
	2824 [label="Неужели нет лекарства? Это никогда не прекратится?",shape=box,color=red];
		2824 -> 2833;
	2827 [label="Если ты уверена, но я рядом, если захочешь поговорить об этом.",shape=box,color=red];
		2827 -> 2838;
	2828 [label="Я… знаю, каково это. Прежде чем начались мои «зацикливания», меня сильно поранило в Дувири. Рана зажила, но время от времени всё ещё ужасно ноет. Я стараюсь скрыть, когда боль возвращается.",shape=box,color=red];
		2828 -> 2839;
	2829 [label="Старые, неразрешённые проблемы могут быть не менее трудными, чем новые. То, что они приходят и уходят, остаются с нами, вовсе не значит, что о них не стоит говорить.",shape=box,color=red];
		2829 -> 2840;
	2830 [label="Chat ends.",color=orange];
	2834 [label="Разум - поистине удивительная вещь. Меня поражает, что они должны постоянно причинять боль, и всё же я научилась просто не обращать на них внимания.",shape=box,color=blue];
		2834 -> 2835;
		2834 -> 2836;
		2834 -> 2837;
	2835 [label="У меня то же самое. Стоит мне сосредоточиться — и больно. Иногда возникает мысль, не поэтому ли так много всего происходит.",shape=box,color=red];
		2835 -> 2845;
	2836 [label="Иногда меня злит, когда думаю о том, сколько всего можно было бы сделать, если эта боль не отвлекала меня всё время.",shape=box,color=red];
		2836 -> 2846;
	2837 [label="Ты тоже всё время устаёшь? Иногда я думаю, может, поэтому я так устаю. Постоянно трачу силы на то, чтобы терпеть боль где-то на заднем плане.",shape=box,color=red];
		2837 -> 2847;
