	2841 [label="Oui, это так. Например -",shape=box,color=blue];
		2841 -> 2850;
	2842 [label="Но ведь, как ты сказал, non? Все неудобства, как мои, приходят с тайной силой. Нужно просто найти их.",shape=box,color=blue];
		2842 -> 2851;
	2843 [label="Oui, верно. Иногда я сидела и смотрела на книгу на верхней полке и думала, как же это несправедливо, что я не могу её достать.",shape=box,color=blue];
		2843 -> 2852;
	2844 [label="На днях я вытирала пыль со всех люстр в Санктуме. Monsieur Лойд умолял меня остановиться.",shape=box,color=blue];
		2844 -> 2853;
	2848 [label="Это трудно объяснить, но я попробую. Mes pieds, oui? Мои ноги. The sérum изменила меня, подарила мне полёт -",shape=box,color=blue];
		2848 -> 2858;
	2849 [label="Par les Luminaires, мне очень жаль. Ты понимаешь, каково это, oui?",shape=box,color=blue];
		2849 -> 2859;
	2854 [label="Oui! Ох, на днях я вытирала пыль со всех люстр в Санктуме. Monsieur Лойд умолял меня остановиться.",shape=box,color=blue];
		2854 -> 2863;
	2855 [label="Но ведь, как ты сказал, non? Все неудобства, как наши, приходят с тайной силой. Нужно просто найти их.",shape=box,color=blue];
		2855 -> 2864;
	2856 [label="Да, я понимаю твоё разочарование. Иногда я просто сидела и смотрела на книгу на верхней полке и думала, как же это было несправедливо, что я не могла до неё дотянуться.",shape=box,color=blue];
		2856 -> 2865;
	2857 [label="Oui!! Ох, ты понимаешь!! Par exemple -",shape=box,color=blue];
		2857 -> 2866;
	2850 [label="Ты знаешь, как утомительно всё время парить, jour après jour, heure après heure, когда другие могут просто ходить?",shape=box,color=blue];
		2850 -> 2860;
	2851 [label="Но да, это раздражает. Иногда я сидела и смотрела на книгу на верхней полке и думала, как же несправедливо, что я не могу её достать.",shape=box,color=blue];
		2851 -> 2852;
	2852 [label="В ней была та информация, которая была важна только мне, никому другому, так почему же мне в этом отказывали? И тут появлялся кто-то с добрыми намерениями и сжалился, доставая её для меня...",shape=box,color=blue];
		2852 -> 2861;
	2853 [label="Я сказала ему, что мне нужно быть занятой, что я должна постоянно что-то делать. Мне кажется, он не совсем понял, почему я обязана оставаться такой активной.",shape=box,color=blue];
		2853 -> 2862;
	2858 [label="Но я всё ещё чувствую их, эти искажённые, зловещие силы, что грозили поглотить меня, раздавить всю надежду и радость в моей душе.",shape=box,color=blue];
		2858 -> 2867;
	2859 [label="Иметь тело, которое предаёт тебя, которое замедляет твой дух… Даже теперь это кажется таким странным. Sérum изменила меня, подарила мне полёт -",shape=box,color=blue];
		2859 -> 2868;
	2863 [label="Я сказала ему, что мне нужно быть занятой, что я должна постоянно что-то делать. Мне кажется, он не совсем понял, почему я обязана оставаться такой активной.",shape=box,color=blue];
		2863 -> 2872;
	2864 [label="Но я понимаю твоё разочарование. Ох, я его хорошо знаю. Иногда я просто сидела и смотрела на книгу на верхней полке и думала, как же это было несправедливо, что я не могла до неё дотянуться.",shape=box,color=blue];
		2864 -> 2865;
	2865 [label="В ней была та информация, которая была важна только мне, никому другому, так почему же мне в этом отказывали? И тут появлялся кто-то с добрыми намерениями и сжалился, доставая её для меня...",shape=box,color=blue];
		2865 -> 2873;
		2865 -> 2874;
	2866 [label="Ты знаешь, как утомительно всё время парить, jour après jour, heure après heure, когда другие могут просто ходить?",shape=box,color=blue];
		2866 -> 2875;
	2860 [label="Я в восторге от того, что могу так свободно передвигаться, что могу дотянуться до всего, чего пожелаю, не пойми меня неправильно. Но всё это по-прежнему так утомительно!",shape=box,color=blue];
		2860 -> 2862;
	2861 [label="И это не их вина, они совершают добрый поступок, мне нужна была помощь. И это не их вина, что я в ней нуждалась. Но, боже, как же раздражает нуждаться в этой помощи.",shape=box,color=blue];
		2861 -> 2869;
		2861 -> 2870;
	2862 [label="Просто... так приятно иметь возможность обо всём этом говорить. Я даже не могу как следует выразить это словами. Так редко удаётся обсудить эту невидимую, безмолвную болезнь, от которой я страдаю.",shape=box,color=blue];
		2862 -> 2871;
	2867 [label="Они всегда причиняют боль. Всегда. Даже сейчас, когда я сижу здесь, стоит мне о них подумать, и я чувствую эту боль. Но бывает, что просто замечать её недостаточно.",shape=box,color=blue];
		2867 -> 2811;
		2867 -> 2810;
	2868 [label="Но я всё ещё чувствую их, эти искажённые, зловещие силы, что грозили поглотить меня, раздавить всю надежду и радость в моей душе.",shape=box,color=blue];
		2868 -> 2876;
	2872 [label="Ах, как же я рада знать, что кто-то здесь понимает, каково это. Это такая редкость. Эта тихая, невидимая чума, от которой мы страдаем.",shape=box,color=blue];
		2872 -> 2880;
	2873 [label="И что в этом плохого?",shape=box,color=red];
		2873 -> 2881;
	2874 [label="Да, я знаю. И это не их вина.",shape=box,color=red];
		2874 -> 2882;
	2875 [label="Я в восторге от того, что могу так свободно передвигаться, что могу дотянуться до всего, чего пожелаю, не пойми меня неправильно. Но всё это по-прежнему так утомительно!!",shape=box,color=blue];
		2875 -> 2872;
	2869 [label="Мне очень жаль, что тебе приходится все это терпеть. ",shape=box,color=red];
		2869 -> 2877;
	2870 [label="И ты даже не можешь выразить это разочарование.",shape=box,color=red];
		2870 -> 2877;
	2871 [label="Как маленькая abeille, что садится мне на плечо и жалит каждый день. Не достаточно, чтобы уничтожить, но вполне достаточно, чтобы раздражать.",shape=box,color=blue];
		2871 -> 2878;
		2871 -> 2879;
	2876 [label="Они всегда причиняют боль. Всегда. Даже сейчас, когда я сижу здесь, стоит мне о них подумать, и я чувствую эту боль. Но бывает, что просто замечать её недостаточно.",shape=box,color=blue];
		2876 -> 2813;
		2876 -> 2812;
	2880 [label="Как маленькая abeille, что садится на нас и жалит каждый день. Не настолько, чтобы нас уничтожить, но достаточно, чтобы раздражать.",shape=box,color=blue];
		2880 -> 2879;
		2880 -> 2878;
	2881 [label="Ничего! Ничего плохого нет. Мне была нужна помощь. Но вот в чём суть, мне была нужна помощь. И это, как ты сказал… раздражает.",shape=box,color=blue];
		2881 -> 2885;
	2882 [label="Oui! Это не их вина, они совершают добрый поступок, мне нужна была помощь. И это не их вина, что я в ней нуждалась. Но, боже, как же раздражает нуждаться в этой помощи.",shape=box,color=blue];
		2882 -> 2885;
	2877 [label="+10 Chemistry",color=orange];
		2877 -> 2862;
	2878 [label="Ну, хотелось бы, чтобы она исчезла...",shape=box,color=red];
		2878 -> 2883;
	2879 [label="Что такое «abeille»?",shape=box,color=red];
		2879 -> 2884;
	2885 [label="+5 Chemistry",color=orange];
		2885 -> 2872;
	2883 [label="И я тоже! Но в то же время это делает нас частью того, кто мы есть, non? Кто мы такие, чтобы решать, какие наши части важны, а какие нет?",shape=box,color=blue];
		2883 -> 2886;
	2884 [label="О! Маленькое существо, желто-черное, в полоску, с иголкой на derrière... производит мед?",shape=box,color=blue];
		2884 -> 2887;
		2884 -> 2888;
	2886 [label="Evaluate expressions",color=orange];
		2886 -> 2892 [label="DrifterFaithStop",color=purple];
		2886 -> 2891 [label="DrifterFaithYesSimilar",color=purple];
		2886 -> 2893 [label="DrifterFaithYesForeign",color=purple];
		2886 -> 2894 [label="DrifterFaithPersonal",color=purple];
		2886 -> 2898 [label="DrifterFaithSol",color=purple];
		2886 -> 2889 [label="DrifterFaithLua",color=purple];
		2886 -> 2890 [label="DrifterFaithBalance",color=purple];
		2886 -> 2895 [label="DrifterFaithAgnostic",color=purple];
		2886 -> 2896 [label="DrifterFaithNoFear",color=purple];
		2886 -> 2896 [label="DrifterFaithNoMaybe",color=purple];
		2886 -> 2896 [label="DrifterFaithNoMITW",color=purple];
		2886 -> 2897 [label="false",color=purple];
	2887 [label="О, пчела!",shape=box,color=red];
		2887 -> 2899;
	2888 [label="Нет, не понимаю... продолжай дальше.",shape=box,color=red];
		2888 -> 2900;
	2892 [label="Я не буду говорить о вере, лишь скажу, что... сколь бы несовершенны ни были наши формы с этой ограниченной точки зрения, мы должны... быть в мире с тем, кто мы есть, non? Это всё, что у нас есть.",shape=box,color=blue];
		2892 -> 2901;
	2891 [label="Я знаю, что наши веры схожи по форме, поэтому скажу, что... Сол посчитал нужным создать меня такой, какая я есть, и я должна верить в его замысел, non? Как бы мне это ни казалось несовершенным с моей ограниченной точки зрения. Интересно, не мог бы ты поразмыслить о том же.",shape=box,color=blue];
		2891 -> 2901;
	2893 [label="Я знаю, что наши веры различны по форме, поэтому не буду говорить о том, чего не знаю. Но просто скажу, что Солу было угодно создать меня такой, какая я есть, и я должна верить в его замысел, non? Как бы мне ни казалось это несовершенным с моей ограниченной точки зрения. Интересно, не можешь ли ты поразмыслить о том же.",shape=box,color=blue];
		2893 -> 2901;
	2894 [label="Я знаю, что твоя вера — личное дело каждого, поэтому не буду вмешиваться. Но просто скажу, что Солу было угодно создать меня таким, какой я есть, и я должен верить в его замысел, non ? Как бы мне ни казалось это несовершенным с моей ограниченной точки зрения. Интересно, неужели ты не можешь думать так же о себе.",shape=box,color=blue];
		2894 -> 2901;
	2898 [label="Сол посчитал нужным создать нас обоих такими, какие мы есть, и мы должны верить в его замысел, non? Каким бы несовершенным он ни казался нам с нашей ограниченной точки зрения.",shape=box,color=blue];
		2898 -> 2901;
	2889 [label="Луа посчитала нужным сделать тебя таким, какой ты есть, а Сол посчитал нужным сделать меня такой, какая я есть. Мы должны верить в их замысел, non? Пусть он нам и кажется несовершенным с нашей ограниченной точки зрения.",shape=box,color=blue];
		2889 -> 2901;
	2890 [label="Светилы сочли нужным сделать нас такими, какие мы есть. Мы должны верить в их замысел, non? Пусть он нам и кажется несовершенным с нашей ограниченной точки зрения.",shape=box,color=blue];
		2890 -> 2901;
	2895 [label="Я знаю, ты придерживаешься мнения, что никто из нас не может знать истинного ответа на вопрос о вселенной, и я это ценю и уважаю. Но я просто скажу, что Солу было угодно создать меня такой, какая я есть, и я должна верить в его замысел, non? Как бы я ни считала его несовершенным с моей ограниченной точки зрения.",shape=box,color=blue];
		2895 -> 2901;
	2896 [label="Я знаю, что у тебя нет собственной веры, и я это уважаю. Но я просто скажу, что Солу было угодно создать меня такой, какая я есть, и я должна верить в его замысел, non? Как бы он ни был несовершенен с моей ограниченной точки зрения.",shape=box,color=blue];
		2896 -> 2901;
	2897 [label="Я просто скажу, что Сол счел нужным создать меня такой, какая я есть, и я должна верить в его замысел, каким бы несовершенным он ни казался мне с моей ограниченной точки зрения.",shape=box,color=blue];
		2897 -> 2901;
	2899 [label="Пчела, abeille! Пфф, всё равно. Ха! ",shape=box,color=blue];
		2899 -> 2902;
	2900 [label="Она летает на маленьких крылышках между цветами, погоди. Non. Ты играешь со мной, я знаю!",shape=box,color=blue];
