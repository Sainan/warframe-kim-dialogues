		j2661385443 -> j4239198182;
	j1622376761 [label="Нет, не понимаю... продолжай дальше.",shape=box,color=red];
		j1622376761 -> j532804125;
	j1547361545 [label="Я не буду говорить о вере, лишь скажу, что... сколь бы несовершенны ни были наши формы с этой ограниченной точки зрения, мы должны... быть в мире с тем, кто мы есть, non? Это всё, что у нас есть.",shape=box,color=blue];
		j1547361545 -> j2548984291;
	j2949504973 [label="Я знаю, что наши веры схожи по форме, поэтому скажу, что... Сол посчитал нужным создать меня такой, какая я есть, и я должна верить в его замысел, non? Как бы мне это ни казалось несовершенным с моей ограниченной точки зрения. Интересно, не мог бы ты поразмыслить о том же.",shape=box,color=blue];
		j2949504973 -> j2548984291;
	j133840480 [label="Я знаю, что наши веры различны по форме, поэтому не буду говорить о том, чего не знаю. Но просто скажу, что Сол было угодно создать меня такой, какая я есть, и я должна верить в высший замысел, non? Как бы мне ни казалось это несовершенным с моей ограниченной точки зрения. Интересно, не можешь ли ты поразмыслить о том же.",shape=box,color=blue];
		j133840480 -> j2548984291;
	j2538348116 [label="Я знаю, что твоя вера — личное дело каждого, поэтому не буду вмешиваться. Но просто скажу, что Сол было угодно создать меня такой, какая я есть, и я должна верить в великий замысел, non? Как бы мне ни казалось это несовершенным с моей ограниченной точки зрения. Интересно, неужели ты не можешь думать так же о себе.",shape=box,color=blue];
		j2538348116 -> j2548984291;
	j35980869 [label="Сол посчитал нужным создать нас обоих такими, какие мы есть, и мы должны верить в его замысел, non? Каким бы несовершенным он ни казался нам с нашей ограниченной точки зрения.",shape=box,color=blue];
		j35980869 -> j2548984291;
	j655796309 [label="Луа посчитала нужным сделать тебя таким, какой ты есть, а Сол посчитал нужным сделать меня такой, какая я есть. Мы должны верить в их замысел, non? Пусть он нам и кажется несовершенным с нашей ограниченной точки зрения.",shape=box,color=blue];
		j655796309 -> j2548984291;
	j1703063772 [label="Светилы сочли нужным сделать нас такими, какие мы есть. Мы должны верить в их замысел, non? Пусть он нам и кажется несовершенным с нашей ограниченной точки зрения.",shape=box,color=blue];
		j1703063772 -> j2548984291;
	j3809067309 [label="Я знаю, ты придерживаешься мнения, что никто из нас не может знать истинного ответа на вопрос о вселенной, и я это ценю и уважаю. Но я просто скажу, что Сол было угодно создать меня такой, какая я есть, и я должна верить в высший замысел, non? Как бы я ни считала его несовершенным с моей ограниченной точки зрения.",shape=box,color=blue];
		j3809067309 -> j2548984291;
	j3247243357 [label="Я знаю, что у тебя нет собственной веры, и я это уважаю. Но я просто скажу, что Солу было угодно создать меня такой, какая я есть, и я должна верить в его замысел, non? Как бы он ни был несовершенен с моей ограниченной точки зрения.",shape=box,color=blue];
		j3247243357 -> j2548984291;
	j1419138561 [label="Я просто скажу, что Сол счел нужным создать меня такой, какая я есть, и я должна верить в его замысел, каким бы несовершенным он ни казался мне с моей ограниченной точки зрения.",shape=box,color=blue];
		j1419138561 -> j2548984291;
	j4239198182 [label="Пчела, abeille! Пфф, всё равно. Ха! ",shape=box,color=blue];
