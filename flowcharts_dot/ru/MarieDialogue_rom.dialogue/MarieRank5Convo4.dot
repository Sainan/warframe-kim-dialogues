		3020 -> 3029;
	3027 [label="Update boolean MarieRank5Convo4Complete",color=orange];
		3027 -> 3035;
	3032 [label="The devil is fickle ! C'est la vie, as they say !",shape=box,color=blue];
		3032 -> 3039;
	3033 [label="And I am not a fool to not see the part you played in ensuring this all came to pass !",shape=box,color=blue];
