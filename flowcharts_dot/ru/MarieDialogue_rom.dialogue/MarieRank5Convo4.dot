		2985 -> 2989 [label="false",color=purple];
	2988 [label="Точно? Если я смогла отбросить свои разногласия с дьяволом, то и ты, конечно, сможешь, не так ли?",shape=box,color=blue];
		2988 -> 2995;
		2988 -> 2996;
	2993 [label="Правота на твоей стороне. Согласие твоё было неожиданным. Было страшно спросить.",shape=box,color=red];
		2993 -> 2985;
	2994 [label="Нет, должен быть другой выход. Я отказываюсь просить его о помощи в этом вопросе.",shape=box,color=red];
		2994 -> 2988;
	2990 [label="Окажет ли он нам свою помощь в этом отношении?",shape=box,color=blue];
		2990 -> 2999;
	2991 [label="Окажет ли он нам свою помощь в этом отношении?",shape=box,color=blue];
		2991 -> 3000;
	2992 [label="Окажет ли он нам свою помощь в этом отношении?",shape=box,color=blue];
		2992 -> 3001;
	2989 [label="Но как ты думаешь, сможешь ли ты убедить его помочь нам?",shape=box,color=blue];
		2989 -> 2997;
		2989 -> 2998;
	2995 [label="Ладно. Если ты не против, то и я не против.",shape=box,color=red];
		2995 -> 3002;
	2996 [label="Нет, извини. ",shape=box,color=red];
		2996 -> 3003;
	2999 [label="Нет, к сожалению... Думаю, это был тупик. Как думаешь, есть другой выход?",shape=box,color=red];
		2999 -> 3006;
	3000 [label="Он поможет. Мне удалось убедить его содействовать их воссоединению — и ты не поверишь этому — думаю, он делает это для того, чтобы помочь защитить семью Энтрати. В конце концов, они — всё, что по-настоящему осталось от Орокин.",shape=box,color=red];
		3000 -> 3007;
	3001 [label="Окажет. Я убедил его помочь воссоединить их — и ты не удивишься этому — думаю, в основном из желания насолить Альбрехту в его отсутствие.",shape=box,color=red];
		3001 -> 3008;
	2997 [label="Я все еще работаю над этим, но думаю, что да.",shape=box,color=red];
		2997 -> 3004;
	2998 [label="Пока ничего не решено. Он... ну, ты же знаешь, каким он бывает.",shape=box,color=red];
		2998 -> 3005;
	3002 [label="Oui, мне не обязательно этим наслаждаться, но, полагаю, это то un médicament, которое мы должны проглотить.",shape=box,color=blue];
		3002 -> 2985;
	3003 [label="+20 Chemistry",color=orange];
		3003 -> 3009;
	3006 [label="О! Это... печально. Я не знаю… Не думаю. Можешь ли ты придумать другой подход к дьяволу? Или способ попытаться снова?",shape=box,color=blue];
		3006 -> 3014;
	3007 [label="Он помогает защищать семью человека, который против его воли превратил его в протофрейм и забросил в прошлое, лишив его памяти...",shape=box,color=blue];
