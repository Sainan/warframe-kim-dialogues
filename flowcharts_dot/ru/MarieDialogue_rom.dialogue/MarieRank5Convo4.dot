	2961 [label="S'il te plaît, останови это - скоро я буду смеяться над его шутками. Тогда я пойму, что я окончательно пропала!",shape=box,color=blue];
		2961 -> 2967;
	2964 [label="Ты уже думала о том, как убедить Лойда поговорить с семьей Энтрати наверху?",shape=box,color=red];
		2964 -> 2969;
	2965 [label="Думалось о том, как убедить Лойда наконец подняться по тем лестницам и поговорить с семьёй, и… у меня есть идея, но мне кажется, она тебе не понравится.",shape=box,color=red];
		2965 -> 2970;
	2962 [label="Мари, ты всё ещё не против… ну, попробовать убедить Лойда поговорить с «соседями сверху»? Знаю, мы тогда закончили этот разговор немного странно.",shape=box,color=red];
		2962 -> 2968;
	2963 [label="По поводу попыток заставить Лойда и семью Энтрати поговорить… мне было интересно, не передумала ли ты насчёт участия Роута?",shape=box,color=red];
		2963 -> 2968;
	2966 [label="Я размышляла о том, почему Monsieur Лойд так боится говорить с семьёй le Cardinal.",shape=box,color=blue];
		2966 -> 2971;
