		3078 -> 3082;
	3079 [label="Add -1 to Thermostat",color=orange];
		3079 -> 3083;
	3077 [label="I am simply glad the devil has someone to speak with who might seek to temper him. Un ange upon his shoulder.",shape=box,color=blue];
		3077 -> 3074;
		3077 -> 3073;
	3084 [label="Chat ends.",color=orange];
	3082 [label="+10 Chemistry",color=orange];
		3082 -> 3085;
	3083 [label="+10 Chemistry",color=orange];
		3083 -> 3086;
	3085 [label="Oui, I fear there is a wickedness in him that cannot truly be cured. He enjoys it too much.",shape=box,color=blue];
		3085 -> 3087;
	3086 [label="Perhaps you are right... what is un ange without son diable ? He reminds us all of what we should strive to avoid.",shape=box,color=blue];
		3086 -> 3087;
	3087 [label="Well ! If and when you convince the devil to aid us in our mission, I will be ready and waiting ! Until then !",shape=box,color=blue];
