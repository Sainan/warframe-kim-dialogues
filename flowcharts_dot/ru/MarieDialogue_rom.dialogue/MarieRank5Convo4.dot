	3051 [label="Update boolean MarieRank5Convo4Complete",color=orange];
		3051 -> 3064;
	3053 [label="Merci, merci, merci, mon cœur !",shape=box,color=blue];
		3053 -> 3065;
	3052 [label="Merci, merci, merci !",shape=box,color=blue];
		3052 -> 3065;
	3054 [label="Well ! When the time comes, I will be ready and waiting ! Until then, merci, mon cœur.",shape=box,color=blue];
		3054 -> 3066;
	3055 [label="Well ! When the time comes, I will be ready and waiting ! Until then, merci.",shape=box,color=blue];
		3055 -> 3066;
	3049 [label="I would never imply that since the devil seems to favor you, that perhaps he will listen to you where all others he seems to ignore.",shape=box,color=blue];
		3049 -> 3062;
	3050 [label="I am simply happy that you are happy. And if the devil has somewhere to spend his... efforts... all the better, non ?",shape=box,color=blue];
		3050 -> 3063;
	3045 [label="Everyone in his life has tried to make him out to be some kind of monster. I suppose I'm the first person who hasn't.",shape=box,color=red];
		3045 -> 3058;
	3044 [label="There's a lot about him that he just doesn't know how to show. It's not armor, per se - but he doesn't trust people not to hurt him.",shape=box,color=red];
		3044 -> 3057;
	3047 [label="He's... had some real heartbreak in his many years. It's scabbed over with thorns, that's all.",shape=box,color=red];
		3047 -> 3060;
	3048 [label="I guess I can understand the amount of years he's lived. I've seen the same amount of death he has.",shape=box,color=red];
		3048 -> 3061;
	3043 [label="He's only ever tried to do what was right. Maybe in the wrong way, sure - but he was trying to save the Origin System from the Orokin.",shape=box,color=red];
		3043 -> 3056;
	3046 [label="I enjoy his wry sense of humor. He's clever, when you get past his ego.",shape=box,color=red];
		3046 -> 3059;
	3064 [label="Chat ends.",color=orange];
	3065 [label="Well ! When the time comes, I will be ready and waiting ! Until then !",shape=box,color=blue];
		3065 -> 3075;
	3066 [label="Update boolean MarieFamilySuccess",color=orange];
		3066 -> 3076;
	3062 [label="And never during private moments. Non. Jamais.",shape=box,color=blue];
		3062 -> 3071;
		3062 -> 3072;
	3063 [label="Even more so for us all if you serve as a bit of un ange upon his shoulder to temper him.",shape=box,color=blue];
		3063 -> 3073;
		3063 -> 3074;
	3058 [label="And I suppose I am atop that list of late, non ? I suppose I should... consider his reasons, for why he is the way he is. Condemnation saves no souls.",shape=box,color=blue];
		3058 -> 3067;
	3057 [label="There is always a pain we hide from those around us. Something we seek to shelter, for fear others will wield it. I suppose I should strive to be kinder to him, if what you say is true.",shape=box,color=blue];
		3057 -> 3067;
	3060 [label="I cannot imagine the amount of love and loss one must suffer in all those years. It seems so unreal, even given all that I have seen.",shape=box,color=blue];
		3060 -> 3069;
	3061 [label="Sometimes I forget, when I speak to him, how many centuries he has lived. It seems so unreal, even given all that I have seen.",shape=box,color=blue];
		3061 -> 3070;
	3056 [label="There are always... nuances, oui ? Always reasons for acting one way or another. I suppose I should strive to be kinder to him, if what you say is true.",shape=box,color=blue];
		3056 -> 3067;
	3059 [label="No one has ever denied the devil his wit.",shape=box,color=blue];
		3059 -> 3068;
	3075 [label="Update boolean MarieFamilySuccess",color=orange];
		3075 -> 3080;
	3076 [label="Update boolean MarieRank5Convo4Complete",color=orange];
		3076 -> 3081;
	3071 [label="You surprise me. I'm impressed. ",shape=box,color=red];
		3071 -> 3038;
	3072 [label="I never knew you had this side to you.",shape=box,color=red];
		3072 -> 3038;
	3073 [label="I can't make any promises.",shape=box,color=red];
		3073 -> 3078;
	3074 [label="Who says I'm trying to temper him?",shape=box,color=red];
		3074 -> 3079;
	3067 [label="+10 Chemistry",color=orange];
		3067 -> 3077;
	3069 [label="Oui, what damage could that cause a soul ? I see why you would wish to find another who understood. And he, you.",shape=box,color=blue];
		3069 -> 3067;
	3070 [label="To have lived so long, to have seen so much death - to have paid so much of it yourself ?",shape=box,color=blue];
		3070 -> 3069;
	3068 [label="+5 Chemistry",color=orange];
		3068 -> 3077;
