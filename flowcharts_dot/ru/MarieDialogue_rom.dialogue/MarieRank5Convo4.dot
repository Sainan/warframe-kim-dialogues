		2968 -> 2974 [label=false,color=brown];
	2971 [label="И как же нам нужно разорвать этот тупик. Это purgatoire, в котором мы застряли, не должно продолжаться. Оно кажется таким ненужно болезненным.",shape=box,color=blue];
		2971 -> 2980;
