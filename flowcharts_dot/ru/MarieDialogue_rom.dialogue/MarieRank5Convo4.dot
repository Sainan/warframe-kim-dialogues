	2977 [label="Bonjour mon cœur! Я об этом подумала ... и должна признаться, мне крайне не хочется это говорить. Это вовсе не доставляет мне удовольствия.",shape=box,color=blue];
		2977 -> 2982;
	2976 [label="Bonjour! Я об этом подумала... и должна признаться, мне крайне не хочется это говорить. Это вовсе не доставляет мне удовольствия.",shape=box,color=blue];
		2976 -> 2982;
	2978 [label="Bonjour, mon cœur ! And what are you afraid I will not like ?",shape=box,color=blue];
		2978 -> 2983;
	2979 [label="Bonjour ! Oh ? And what are you afraid I will not like ?",shape=box,color=blue];
		2979 -> 2983;
	2975 [label="Bonjour, bonjour, mon cœur! Я об этом подумала ... и должна признаться, мне крайне не хочется это говорить. Это вовсе не доставляет мне удовольствия.",shape=box,color=blue];
		2975 -> 2981;
	2974 [label="Bonjour - Я об этом подумала... и должна признаться, мне крайне не хочется это говорить. Это вовсе не доставляет мне удовольствия.",shape=box,color=blue];
		2974 -> 2981;
	2980 [label="But I feel as though we need... a bastion of some kind, non ? Do you have any ideas ?",shape=box,color=blue];
		2980 -> 2984;
		2980 -> 2983;
	2982 [label="But I think... I think - ah, Sol forgive me - that the devil's assistance may be required. I do not think Monsieur Loid will listen to us otherwise.",shape=box,color=blue];
		2982 -> 2986;
	2983 [label="I think we might need Roathe's help to convince Loid to talk to the Entrati family. I don't think he'll do it otherwise. Without assurances that the family, and he, will be protected.",shape=box,color=red];
		2983 -> 2987;
	2981 [label="I believe you may be right. The devil may be the missing piece we need. Ah, it pains me even to type the words ! ",shape=box,color=blue];
		2981 -> 2985;
	2984 [label="I don't really have any good ideas that doesn't involve taking help from terrible sources. Sources that might just get us into deep trouble later. Namely, Roathe.",shape=box,color=red];
		2984 -> 2988;
	2986 [label="The devil is powerful, and provides certain promises of strength should things go wrong, non ?",shape=box,color=blue];
		2986 -> 2993;
		2986 -> 2994;
	2987 [label="I... hate to admit it, but I think you may be right... Sol forgive me.",shape=box,color=blue];
		2987 -> 2985;
	2985 [label="Evaluate expressions",color=orange];
