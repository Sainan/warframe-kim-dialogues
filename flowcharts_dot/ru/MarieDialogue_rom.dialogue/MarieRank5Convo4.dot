	3051 [label="Update boolean MarieRank5Convo4Complete",color=orange];
		3051 -> 3064;
	3053 [label="Merci, merci, merci, mon cœur !",shape=box,color=blue];
		3053 -> 3065;
	3052 [label="Merci, merci, merci !",shape=box,color=blue];
		3052 -> 3065;
	3054 [label="Ну что ж! Когда придёт время, я буду готова и буду ждать! А пока, merci, mon cœur.",shape=box,color=blue];
		3054 -> 3066;
	3055 [label="Ну что ж! Когда придёт время, я буду готова и буду ждать! А пока, merci.",shape=box,color=blue];
		3055 -> 3066;
	3049 [label="Я бы никогда не сказала, что раз дьявол, судя по всему, благоволит тебе, то, возможно, он тебя выслушает, тогда как всех остальных он, похоже, игнорирует.",shape=box,color=blue];
		3049 -> 3062;
	3050 [label="Я просто рада твоему счастью. И если чёрту есть куда приложить свои... усилия... тем лучше, non ?",shape=box,color=blue];
		3050 -> 3063;
	3045 [label="Все, кто его окружал, пытались выставить его каким-то чудовищем. Полагаю, я первый, кто этого не совершил.",shape=box,color=red];
		3045 -> 3058;
	3044 [label="Многое в нём он просто не умеет показывать. Дело не в доспехах как таковых, но он не доверяет людям и боится, что они причинят ему вред.",shape=box,color=red];
		3044 -> 3057;
	3047 [label="За свою жизнь он... пережил немало серьёзных душевных мук. Сердце просто покрыто коркой от шипов, вот и всё.",shape=box,color=red];
		3047 -> 3060;
	3048 [label="Думаю, я могу понять, сколько лет он прожил. Мне довелось увидеть столько же смертей, сколько и он.",shape=box,color=red];
		3048 -> 3061;
	3043 [label="Он всегда старался поступать только правильно. Может, и неправильно, конечно, но он пытался спасти Изначальную Систему от Орокин.",shape=box,color=red];
		3043 -> 3056;
	3046 [label="Мне нравится его тонкое чувство юмора. Он умный, если не обращать внимания на его эго.",shape=box,color=red];
		3046 -> 3059;
	3064 [label="Chat ends.",color=orange];
	3065 [label="Ну что ж! Когда придёт время, я буду готова и буду ждать! А пока !",shape=box,color=blue];
		3065 -> 3075;
	3066 [label="Update boolean MarieFamilySuccess",color=orange];
		3066 -> 3076;
	3062 [label="И никогда в личные моменты. Non. Jamais.",shape=box,color=blue];
		3062 -> 3071;
		3062 -> 3072;
	3063 [label="Тем более для всех нас, если ты станешь немного un ange на его плече, смягчающим его.",shape=box,color=blue];
		3063 -> 3073;
		3063 -> 3074;
	3058 [label="И, похоже, я в последнее время возглавляю этот список, не так ли? Полагаю, мне стоит... задуматься о причинах, по которым он стал таким, какой он есть. Осуждение не спасает души.",shape=box,color=blue];
		3058 -> 3067;
	3057 [label="Мы всегда скрываем от окружающих какую-то боль. Что-то, что мы пытаемся скрыть, опасаясь, что другие ею воспользуются. Думаю, мне стоит быть к нему добрее, если то, что ты говоришь, правда.",shape=box,color=blue];
		3057 -> 3067;
	3060 [label="Я не могу представить, сколько любви и потерь приходится пережить за все эти годы. Это кажется таким нереальным, даже учитывая всё, что я видела.",shape=box,color=blue];
		3060 -> 3069;
	3061 [label="Иногда, разговаривая с ним, я забываю, сколько веков он прожил. Это кажется таким нереальным, даже учитывая всё, что я видела.",shape=box,color=blue];
		3061 -> 3070;
	3056 [label="Всегда есть... нюансы, да? Всегда есть причины поступать так или иначе. Полагаю, мне стоит стараться быть к нему добрее, если то, что ты говоришь, правда.",shape=box,color=blue];
		3056 -> 3067;
	3059 [label="Никто никогда не отказывал дьяволу в остроумии.",shape=box,color=blue];
		3059 -> 3068;
	3075 [label="Update boolean MarieFamilySuccess",color=orange];
		3075 -> 3080;
	3076 [label="Update boolean MarieRank5Convo4Complete",color=orange];
		3076 -> 3081;
