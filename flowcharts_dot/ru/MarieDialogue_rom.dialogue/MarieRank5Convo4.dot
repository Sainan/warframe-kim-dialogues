		j2534225574 -> j3471307579;
	j1320247306 [label="Evaluate expressions",color=orange];
		j1320247306 -> j3792141186 [label="MarieFamily3a",color=purple];
		j1320247306 -> j2421882489 [label="MarieFamily3a",color=purple];
		j1320247306 -> j1441170600 [label="MarieFamily3b",color=purple];
		j1320247306 -> j2369191653 [label="MarieFamily3b",color=purple];
		j1320247306 -> j3792141186 [label="MarieFamilyOther",color=purple];
		j1320247306 -> j2421882489 [label="MarieFamilyOther",color=purple];
		j1320247306 -> j4078652808 [label="false",color=purple];
	j3471307579 [label="S'il te plaît, останови это - скоро я буду смеяться над его шутками. Тогда я пойму, что я окончательно пропала!",shape=box,color=blue];
		j3471307579 -> j758933647;
	j3792141186 [label="Ты уже думала о том, как убедить Лойда поговорить с семьей Энтрати наверху?",shape=box,color=red];
		j3792141186 -> j3487613436;
	j2421882489 [label="Думалось о том, как убедить Лойда наконец подняться по тем лестницам и поговорить с семьёй, и… у меня есть идея, но мне кажется, она тебе не понравится.",shape=box,color=red];
		j2421882489 -> j668862974;
	j1441170600 [label="Мари, ты всё ещё не против… ну, попробовать убедить Лойда поговорить с «соседями сверху»? Знаю, мы тогда закончили этот разговор немного странно.",shape=box,color=red];
		j1441170600 -> j374072022;
	j2369191653 [label="По поводу попыток заставить Лойда и семью Энтрати поговорить… мне было интересно, не передумала ли ты насчёт участия Роута?",shape=box,color=red];
		j2369191653 -> j374072022;
	j4078652808 [label="Я размышляла о том, почему Monsieur Лойд так боится говорить с семьёй le Cardinal.",shape=box,color=blue];
		j4078652808 -> j3052206667;
	j758933647 [label="Check boolean MarieNoDate",color=orange];
		j758933647 -> "Chat ends." [label=true,color=green];
		j758933647 -> j2768654365 [label=false,color=brown];
	j3487613436 [label="Check boolean MarieDating",color=orange];
		j3487613436 -> j3909072485 [label=true,color=green];
		j3487613436 -> j635728573 [label=false,color=brown];
	j668862974 [label="Check boolean MarieDating",color=orange];
		j668862974 -> j1234505384 [label=true,color=green];
		j668862974 -> j1943520207 [label=false,color=brown];
	j374072022 [label="Check boolean MarieDating",color=orange];
		j374072022 -> j4081964387 [label=true,color=green];
		j374072022 -> j2060665526 [label=false,color=brown];
	j3052206667 [label="И как же нам нужно разорвать этот тупик. Это purgatoire, в котором мы застряли, не должно продолжаться. Оно кажется таким ненужно болезненным.",shape=box,color=blue];
		j3052206667 -> j507512073;
	j2768654365 [label="Boolean MarieWillDate is now true.",color=orange];
		j2768654365 -> "Chat ends.";
	j3909072485 [label="Bonjour mon cœur! Я об этом подумала ... и должна признаться, мне крайне не хочется это говорить. Это вовсе не доставляет мне удовольствия.",shape=box,color=blue];
		j3909072485 -> j1402644172;
	j635728573 [label="Bonjour! Я об этом подумала... и должна признаться, мне крайне не хочется это говорить. Это вовсе не доставляет мне удовольствия.",shape=box,color=blue];
		j635728573 -> j1402644172;
	j1234505384 [label="Bonjour, mon cœur! И что же ты боишься, что мне не понравится?",shape=box,color=blue];
		j1234505384 -> j2528274249;
	j1943520207 [label="Bonjour! Ох? И что же ты боишься, что мне не понравится?",shape=box,color=blue];
		j1943520207 -> j2528274249;
	j4081964387 [label="Bonjour, bonjour, mon cœur! Я об этом подумала ... и должна признаться, мне крайне не хочется это говорить. Это вовсе не доставляет мне удовольствия.",shape=box,color=blue];
		j4081964387 -> j2819434376;
	j2060665526 [label="Bonjour - Я об этом подумала... и должна признаться, мне крайне не хочется это говорить. Это вовсе не доставляет мне удовольствия.",shape=box,color=blue];
		j2060665526 -> j2819434376;
	j507512073 [label="Но мне кажется, нам нужен... какой-то бастион, не? Есть идеи?",shape=box,color=blue];
		j507512073 -> j2108249810;
		j507512073 -> j2528274249;
	j1402644172 [label="Но я думаю... я думаю — ах, Сол, прости меня, — что может потребоваться помощь дьявола. Иначе, думаю, Monsieur Лойд, нас не послушает.",shape=box,color=blue];
		j1402644172 -> j693697761;
	j2528274249 [label="Думаю, нам понадобится помощь Роута, чтобы убедить Лойда поговорить с семьёй Энтрати. Не думаю, что он сделает это иначе. Без гарантий, что семья и он сам будут в безопасности.",shape=box,color=red];
		j2528274249 -> j1895998546;
	j2819434376 [label="Думаю, ты прав. Возможно, именно дьявол и есть то недостающее звено, которое нам нужно. Ах, мне даже печатать эти слова больно! ",shape=box,color=blue];
		j2819434376 -> j409794056;
	j2108249810 [label="У меня нет ни одной хорошей идеи, которая не предполагала бы обращения за помощью к ужасным источникам. Источникам, которые могут в дальнейшем вовлечь нас в серьёзные проблемы. А именно, к Роуту.",shape=box,color=red];
		j2108249810 -> j2667337721;
	j693697761 [label="Дьявол могуществен, и обещает определённую силу, если что-то пойдёт не так, не правда ли?",shape=box,color=blue];
		j693697761 -> j3848700089;
		j693697761 -> j587719388;
	j1895998546 [label="Мне... неприятно это признавать, но я думаю, есть истина в твоих словах... Сол, прости меня.",shape=box,color=blue];
		j1895998546 -> j409794056;
	j409794056 [label="Evaluate expressions",color=orange];
		j409794056 -> j4002000277 [label="RoatheFamilyFail",color=purple];
		j409794056 -> j1098298577 [label="RoatheRedeemed, RoatheFamilyDelay
",color=purple];
		j409794056 -> j4053548837 [label="RoatheVillain, RoatheFamilyDelay",color=purple];
		j409794056 -> j1198778601 [label="false",color=purple];
	j2667337721 [label="Точно? Если я смогла отбросить свои разногласия с дьяволом, то и ты, конечно, сможешь, не так ли?",shape=box,color=blue];
		j2667337721 -> j3128597432;
		j2667337721 -> j2535590125;
	j3848700089 [label="Правота на твоей стороне. Согласие твоё было неожиданным. Было страшно спросить.",shape=box,color=red];
		j3848700089 -> j409794056;
	j587719388 [label="Нет, должен быть другой выход. Я отказываюсь просить его о помощи в этом вопросе.",shape=box,color=red];
		j587719388 -> j2667337721;
	j4002000277 [label="Окажет ли он нам свою помощь в этом отношении?",shape=box,color=blue];
		j4002000277 -> j2362530618;
	j1098298577 [label="Окажет ли он нам свою помощь в этом отношении?",shape=box,color=blue];
		j1098298577 -> j846307225;
	j4053548837 [label="Окажет ли он нам свою помощь в этом отношении?",shape=box,color=blue];
		j4053548837 -> j3929525966;
	j1198778601 [label="Но как ты думаешь, сможешь ли ты убедить его помочь нам?",shape=box,color=blue];
		j1198778601 -> j2754372730;
		j1198778601 -> j2704753656;
	j3128597432 [label="Ладно. Если ты не против, то и я не против.",shape=box,color=red];
		j3128597432 -> j3450426755;
	j2535590125 [label="Нет, извини. ",shape=box,color=red];
		j2535590125 -> j78136410;
	j2362530618 [label="Нет, к сожалению... Думаю, это был тупик. Как думаешь, есть другой выход?",shape=box,color=red];
		j2362530618 -> j273854071;
	j846307225 [label="Он поможет. Мне удалось убедить его содействовать их воссоединению — и ты не поверишь этому — думаю, он делает это для того, чтобы помочь защитить семью Энтрати. В конце концов, они — всё, что по-настоящему осталось от Орокин.",shape=box,color=red];
		j846307225 -> j1035264518;
	j3929525966 [label="Окажет. Я убедил его помочь воссоединить их — и ты не удивишься этому — думаю, в основном из желания насолить Альбрехту в его отсутствие.",shape=box,color=red];
		j3929525966 -> j665679462;
	j2754372730 [label="Я все еще работаю над этим, но думаю, что да.",shape=box,color=red];
		j2754372730 -> j961489522;
	j2704753656 [label="Пока ничего не решено. Он... ну, ты же знаешь, каким он бывает.",shape=box,color=red];
		j2704753656 -> j3827853471;
	j3450426755 [label="Oui, мне не обязательно этим наслаждаться, но, полагаю, это то un médicament, которое мы должны проглотить.",shape=box,color=blue];
		j3450426755 -> j409794056;
	j78136410 [label="+20 Chemistry",color=orange];
		j78136410 -> j1698874931;
	j273854071 [label="О! Это... печально. Я не знаю… Не думаю. Можешь ли ты придумать другой подход к дьяволу? Или способ попытаться снова?",shape=box,color=blue];
		j273854071 -> j1987400956;
	j1035264518 [label="Он помогает защищать семью человека, который против его воли превратил его в протофрейм и забросил в прошлое, лишив его памяти...",shape=box,color=blue];
		j1035264518 -> j3129483959;
	j665679462 [label="Точно, я... не удивлена.",shape=box,color=blue];
		j665679462 -> j3714984550;
		j665679462 -> j4220946466;
	j961489522 [label="Check boolean RoatheDating",color=orange];
		j961489522 -> j686363486 [label=true,color=green];
		j961489522 -> j1666484318 [label=false,color=brown];
	j3827853471 [label="Check boolean RoatheDating",color=orange];
		j3827853471 -> j3920149722 [label=true,color=green];
		j3827853471 -> j230996583 [label=false,color=brown];
	j1698874931 [label="Тогда я тоже поддержу твой выбор.",shape=box,color=blue];
		j1698874931 -> j1179567760;
	j1987400956 [label="В это же время я поговорю с Лионом, но мои надежды крайне малы.",shape=box,color=blue];
		j1987400956 -> j3034776440;
	j3129483959 [label="+20 Chemistry",color=orange];
		j3129483959 -> j1044197527;
	j3714984550 [label="Думаю, это всего лишь оправдание, которое он придумывает, чтобы это скрыть.",shape=box,color=red];
		j3714984550 -> j829546940;
	j4220946466 [label="По крайней мере, он всё-таки поможет. А я прослежу, чтобы он на самом деле не довёл свои угрозы до конца.",shape=box,color=red];
		j4220946466 -> j2287416454;
	j686363486 [label="Я думаю, у тебя есть особый способ убедить его, в котором все остальные потерпели неудачу, non?",shape=box,color=blue];
		j686363486 -> j2985228380;
		j686363486 -> j1516730944;
	j1666484318 [label="Желаю тебе удачи. Этот дьявол и в лучшие времена бывает упрямым. Иногда мне кажется, ему просто нравится быть противоречивым!",shape=box,color=blue];
		j1666484318 -> j1703942145;
		j1666484318 -> j1956650782;
	j3920149722 [label="Oui, я знаю. Но я думаю, у тебя есть особый способ убедить его, в котором все остальные потерпели неудачу, non?",shape=box,color=blue];
		j3920149722 -> j2985228380;
		j3920149722 -> j1516730944;
	j230996583 [label="Oui, конечно знаю. Этот дьявол и в лучшие времена бывает упрямым. Иногда мне кажется, ему просто нравится быть противоречивым!",shape=box,color=blue];
		j230996583 -> j1703942145;
		j230996583 -> j1956650782;
	j1179567760 [label="Boolean MarieFamilyFail is now true.",color=orange];
		j1179567760 -> j2605366984;
	j3034776440 [label="+20 Chemistry",color=orange];
		j3034776440 -> j1602778258;
	j1044197527 [label="Я глубоко недооценила этого нашего дьявола...",shape=box,color=blue];
		j1044197527 -> j186864971;
	j829546940 [label="Oui, надеюсь, это верно.",shape=box,color=blue];
		j829546940 -> j70687620;
	j2287416454 [label="Oui. По крайней мере, ты рядом и можешь не дать ему последовать своим... низменным инстинктам.",shape=box,color=blue];
		j2287416454 -> j70687620;
	j2985228380 [label="На что ты намекаешь, Мари?",shape=box,color=red];
		j2985228380 -> j3043046464;
	j1516730944 [label="Я бы не хотел использовать наши с ним отношения как инструмент переговоров.",shape=box,color=red];
		j1516730944 -> j2554407206;
	j1703942145 [label="Он может таким быть, но, думаю, во многом это просто показуха.",shape=box,color=red];
		j1703942145 -> j1156700716;
	j1956650782 [label="Мне это даже нравится, как бы странно это ни звучало. Мы хорошо ладим.",shape=box,color=red];
		j1956650782 -> j3967183226;
	j2605366984 [label="Boolean MarieRank5Convo4Complete is now true.",color=orange];
		j2605366984 -> "Chat ends.";
	j1602778258 [label="Дьявол переменчив! C'est la vie, как говорится!",shape=box,color=blue];
		j1602778258 -> j3569999725;
	j186864971 [label="И я не настолько глупа, чтобы не видеть твою роль в том, чтобы всё это стало возможным!",shape=box,color=blue];
		j186864971 -> j1263896752;
	j70687620 [label="Check boolean MarieDating",color=orange];
		j70687620 -> j3052568488 [label=true,color=green];
		j70687620 -> j657481369 [label=false,color=brown];
	j3043046464 [label="+5 Chemistry",color=orange];
		j3043046464 -> j669637828;
	j2554407206 [label="О! Я вовсе не это имела в виду, прости меня! Просто он, похоже, благоволит тебе, так что, возможно, ты способен быть для него тем, кого он выслушает, тогда как всех остальных может проигнорировать.",shape=box,color=blue];
		j2554407206 -> j393373014;
	j1156700716 [label="Oui? Что ты имеешь в виду?",shape=box,color=blue];
		j1156700716 -> j1155893159;
	j3967183226 [label="Oui, похоже, он явно благоволит тебе. Возможно, это потому, что вы разделяете одно время и одно место, чего у нас нет? Зачем ещё ему это делать?",shape=box,color=blue];
		j3967183226 -> j1155893159;
	j3569999725 [label="Boolean MarieFamilySuccess is now true.",color=orange];
		j3569999725 -> j2605366984;
	j1263896752 [label="Check boolean MarieDating",color=orange];
		j1263896752 -> j3031246523 [label=true,color=green];
		j1263896752 -> j2252758308 [label=false,color=brown];
	j3052568488 [label="+10 Chemistry",color=orange];
		j3052568488 -> j646651845;
	j657481369 [label="+10 Chemistry",color=orange];
		j657481369 -> j828099987;
	j669637828 [label="Я совершенно не понимаю, о чём ты! Я ни на что не намекаю. Я всего лишь une innocente Sœur de Sol.",shape=box,color=blue];
		j669637828 -> j441881540;
	j393373014 [label="+5 Chemistry",color=orange];
		j393373014 -> j3411179962;
	j1155893159 [label="Evaluate expressions",color=orange];
		j1155893159 -> j3133028430 [label="RoatheVillain",color=purple];
		j1155893159 -> j3615543371 [label="RoatheRedeemed",color=purple];
		j1155893159 -> j3335482370 [label="RoatheUnloved3",color=purple];
		j1155893159 -> j2873906665 [label="RoatheTraitor2",color=purple];
		j1155893159 -> j2184097753 [label="RoatheExecutor2",color=purple];
		j1155893159 -> j1588301475 [label="false",color=purple];
	j3031246523 [label="Merci, merci, merci, mon cœur!",shape=box,color=blue];
		j3031246523 -> j2585656339;
	j2252758308 [label="Merci, merci, merci!",shape=box,color=blue];
		j2252758308 -> j2585656339;
	j646651845 [label="Ну что ж! Когда придёт время, я буду готова и буду ждать! А пока, merci, mon cœur.",shape=box,color=blue];
		j646651845 -> j3569999725;
	j828099987 [label="Ну что ж! Когда придёт время, я буду готова и буду ждать! А пока, merci.",shape=box,color=blue];
		j828099987 -> j3569999725;
	j441881540 [label="Я бы никогда не сказала, что раз дьявол, судя по всему, благоволит тебе, то, возможно, он тебя выслушает, тогда как всех остальных он, похоже, игнорирует.",shape=box,color=blue];
		j441881540 -> j920228872;
	j3411179962 [label="Я просто рада твоему счастью. И если чёрту есть куда приложить свои... усилия... тем лучше, non?",shape=box,color=blue];
		j3411179962 -> j3185308591;
	j3133028430 [label="Все, кто его окружал, пытались выставить его каким-то чудовищем. Полагаю, я первый, кто этого не совершил.",shape=box,color=red];
		j3133028430 -> j48429634;
	j3615543371 [label="Многое в нём он просто не умеет показывать. Дело не в доспехах как таковых, но он не доверяет людям и боится, что они причинят ему вред.",shape=box,color=red];
		j3615543371 -> j1246734664;
	j3335482370 [label="За свою жизнь он... пережил немало серьёзных душевных мук. Сердце просто покрыто коркой от шипов, вот и всё.",shape=box,color=red];
		j3335482370 -> j1999180165;
	j2873906665 [label="Думаю, я могу понять, сколько лет он прожил. Мне довелось увидеть столько же смертей, сколько и он.",shape=box,color=red];
		j2873906665 -> j1857844305;
	j2184097753 [label="Он всегда старался поступать только правильно. Может, и неправильно, конечно, но он пытался спасти Изначальную Систему от Орокин.",shape=box,color=red];
		j2184097753 -> j3965825027;
	j1588301475 [label="Мне нравится его тонкое чувство юмора. Он умный, если не обращать внимания на его эго.",shape=box,color=red];
		j1588301475 -> j1686958154;
	j2585656339 [label="Ну что ж! Когда придёт время, я буду готова и буду ждать! А пока!",shape=box,color=blue];
		j2585656339 -> j3569999725;
	j920228872 [label="И никогда в личные моменты. Non. Jamais.",shape=box,color=blue];
		j920228872 -> j331107221;
		j920228872 -> j1636907169;
	j3185308591 [label="Тем более для всех нас, если ты станешь немного un ange на его плече, смягчающим его.",shape=box,color=blue];
		j3185308591 -> j3643171867;
		j3185308591 -> j3730671248;
	j48429634 [label="И, похоже, я в последнее время возглавляю этот список, не так ли? Полагаю, мне стоит... задуматься о причинах, по которым он стал таким, какой он есть. Осуждение не спасает души.",shape=box,color=blue];
		j48429634 -> j973950653;
	j1246734664 [label="Мы всегда скрываем от окружающих какую-то боль. Что-то, что мы пытаемся скрыть, опасаясь, что другие ею воспользуются. Думаю, мне стоит быть к нему добрее, если то, что ты говоришь, правда.",shape=box,color=blue];
		j1246734664 -> j973950653;
	j1999180165 [label="Я не могу представить, сколько любви и потерь приходится пережить за все эти годы. Это кажется таким нереальным, даже учитывая всё, что я видела.",shape=box,color=blue];
		j1999180165 -> j4279259923;
	j1857844305 [label="Иногда, разговаривая с ним, я забываю, сколько веков он прожил. Это кажется таким нереальным, даже учитывая всё, что я видела.",shape=box,color=blue];
		j1857844305 -> j1045681872;
	j3965825027 [label="Всегда есть... нюансы, да? Всегда есть причины поступать так или иначе. Полагаю, мне стоит стараться быть к нему добрее, если то, что ты говоришь, правда.",shape=box,color=blue];
		j3965825027 -> j973950653;
	j1686958154 [label="Никто никогда не отказывал дьяволу в остроумии.",shape=box,color=blue];
		j1686958154 -> j1449793398;
	j331107221 [label="Ты меня удивляешь. Меня это впечатляет. ",shape=box,color=red];
		j331107221 -> j393373014;
	j1636907169 [label="Раньше не виделось в тебе чего-то подобного.",shape=box,color=red];
		j1636907169 -> j393373014;
	j3643171867 [label="Я не могу ничего обещать.",shape=box,color=red];
		j3643171867 -> j3773598225;
	j3730671248 [label="Кто сказал, что я пытаюсь его смягчить?",shape=box,color=red];
		j3730671248 -> j3147050988;
	j973950653 [label="+10 Chemistry",color=orange];
		j973950653 -> j2924757745;
	j4279259923 [label="Oui, какой вред это может причинить душе? Я понимаю, почему ты хочешь найти другого, кто тебя поймёт. А он – тебя.",shape=box,color=blue];
		j4279259923 -> j973950653;
	j1045681872 [label="Прожить так долго, увидеть столько смерти - и самому заплатить за это столь многим?",shape=box,color=blue];
		j1045681872 -> j4279259923;
	j1449793398 [label="+5 Chemistry",color=orange];
		j1449793398 -> j2924757745;
	j3773598225 [label="Add 1 to Thermostat counter",color=orange];
		j3773598225 -> j860042811;
	j3147050988 [label="Add -1 to Thermostat counter",color=orange];
		j3147050988 -> j665773379;
	j2924757745 [label="Я просто рада, что у дьявола есть кто-то, с кем он может поговорить и кто может попытаться его усмирить. Un ange на его плече.",shape=box,color=blue];
		j2924757745 -> j3730671248;
		j2924757745 -> j3643171867;
	j860042811 [label="+10 Chemistry",color=orange];
		j860042811 -> j2214542425;
	j665773379 [label="+10 Chemistry",color=orange];
		j665773379 -> j29675652;
	j2214542425 [label="Oui, боюсь, в нём есть какая-то злоба, от которой невозможно излечиться. Он слишком этим наслаждается.",shape=box,color=blue];
		j2214542425 -> j2559669198;
	j29675652 [label="Может и так... Что такое un ange без son diable? Он напоминает нам всем, чего следует избегать.",shape=box,color=blue];
		j29675652 -> j2559669198;
	j2559669198 [label="Ну что ж! Когда ты убедишь дьявола помочь нам в нашей миссии, я буду готова и буду ждать! До тех пор!",shape=box,color=blue];
		j2559669198 -> j3569999725;
}