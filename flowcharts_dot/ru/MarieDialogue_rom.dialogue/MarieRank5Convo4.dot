		2972 -> 2973;
	2977 [label="Bonjour mon cœur! Я об этом подумала ... и должна признаться, мне крайне не хочется это говорить. Это вовсе не доставляет мне удовольствия.",shape=box,color=blue];
		2977 -> 2982;
	2976 [label="Bonjour! Я об этом подумала... и должна признаться, мне крайне не хочется это говорить. Это вовсе не доставляет мне удовольствия.",shape=box,color=blue];
		2976 -> 2982;
	2978 [label="Bonjour, mon cœur! И что же ты боишься, что мне не понравится?",shape=box,color=blue];
		2978 -> 2983;
	2979 [label="Bonjour ! Ох ? И что же ты боишься, что мне не понравится?",shape=box,color=blue];
		2979 -> 2983;
	2975 [label="Bonjour, bonjour, mon cœur! Я об этом подумала ... и должна признаться, мне крайне не хочется это говорить. Это вовсе не доставляет мне удовольствия.",shape=box,color=blue];
		2975 -> 2981;
	2974 [label="Bonjour - Я об этом подумала... и должна признаться, мне крайне не хочется это говорить. Это вовсе не доставляет мне удовольствия.",shape=box,color=blue];
		2974 -> 2981;
	2980 [label="Но мне кажется, нам нужен... какой-то бастион, не? Есть идеи?",shape=box,color=blue];
		2980 -> 2984;
		2980 -> 2983;
	2982 [label="Но я думаю... я думаю — ах, Сол, прости меня, — что может потребоваться помощь дьявола. Иначе, думаю, Monsieur Лойд, нас не послушает.",shape=box,color=blue];
		2982 -> 2986;
	2983 [label="Думаю, нам понадобится помощь Роута, чтобы убедить Лойда поговорить с семьёй Энтрати. Не думаю, что он сделает это иначе. Без гарантий, что семья и он сам будут в безопасности.",shape=box,color=red];
		2983 -> 2987;
	2981 [label="Думаю, ты прав. Возможно, именно дьявол и есть то недостающее звено, которое нам нужно. Ах, мне даже печатать эти слова больно! ",shape=box,color=blue];
		2981 -> 2985;
	2984 [label="У меня нет ни одной хорошей идеи, которая не предполагала бы обращения за помощью к ужасным источникам. Источникам, которые могут в дальнейшем вовлечь нас в серьёзные проблемы. А именно, к Роуту.",shape=box,color=red];
		2984 -> 2988;
	2986 [label="Дьявол могуществен, и обещает определённую силу, если что-то пойдёт не так, не правда ли?",shape=box,color=blue];
		2986 -> 2993;
		2986 -> 2994;
	2987 [label="Мне... неприятно это признавать, но я думаю, есть истина в твоих словах... Сол, прости меня.",shape=box,color=blue];
		2987 -> 2985;
