	2994 [label="No, there has to be another way. I refuse to ask for his help on this.",shape=box,color=red];
		2994 -> 2988;
	2990 [label="Will he give us his aid in this regard ?",shape=box,color=blue];
		2990 -> 2999;
	2991 [label="Will he give us his aid in this regard ?",shape=box,color=blue];
		2991 -> 3000;
	2992 [label="Will he give us his aid in this regard ?",shape=box,color=blue];
		2992 -> 3001;
	2989 [label="Do you think you can convince him to help us, though ?",shape=box,color=blue];
		2989 -> 2997;
		2989 -> 2998;
	2995 [label="All right. If you're okay with it, I'll be okay with it.",shape=box,color=red];
		2995 -> 3002;
	2996 [label="No, I'm sorry. ",shape=box,color=red];
		2996 -> 3003;
	2999 [label="No, unfortunately... I think that was a dead end with him. Do you think there's another way?",shape=box,color=red];
		2999 -> 3006;
	3000 [label="He will. I've convinced him to help reunite them - and you won't believe this - I think it's so that he can help protect Entrati's family. They're all that really remains of the Orokin, after all.",shape=box,color=red];
		3000 -> 3007;
	3001 [label="He will. I've convinced him to help reunite them - and you won't be surprised by this - I think it's mostly to spite Albrecht in his absence.",shape=box,color=red];
		3001 -> 3008;
	2997 [label="I'm still working on it, but I think so.",shape=box,color=red];
		2997 -> 3004;
	2998 [label="Nothing is settled yet. He's... well, you know how he can be.",shape=box,color=red];
		2998 -> 3005;
	3002 [label="Oui, I do not have to enjoy it, but it is un médicament we must swallow, I suppose.",shape=box,color=blue];
		3002 -> 2985;
	3003 [label="+20 Chemistry",color=orange];
		3003 -> 3009;
	3006 [label="Oh ! That is... unfortunate. I do not know ? I do not think so... Can you think of another approach with the devil ? Or a way to try again ?",shape=box,color=blue];
		3006 -> 3014;
