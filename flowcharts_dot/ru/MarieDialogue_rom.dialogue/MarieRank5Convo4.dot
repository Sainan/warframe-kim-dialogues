		3016 -> 3025;
	3017 [label="По крайней мере, он всё-таки поможет. А я прослежу, чтобы он на самом деле не довёл свои угрозы до конца.",shape=box,color=red];
		3017 -> 3026;
	3011 [label="Я думаю, у тебя есть особый способ убедить его, в котором все остальные потерпели неудачу, non ?",shape=box,color=blue];
		3011 -> 3021;
		3011 -> 3022;
	3010 [label="Желаю тебе удачи. Этот дьявол и в лучшие времена бывает упрямым. Иногда мне кажется, ему просто нравится быть противоречивым!",shape=box,color=blue];
		3010 -> 3019;
