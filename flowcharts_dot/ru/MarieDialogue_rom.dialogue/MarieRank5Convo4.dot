		3030 -> 3037;
	3031 [label="Oh ! That is not what I was implying, pardonne-moi ! Simply that he seems to favor you, so you may have his ear where all others he may ignore.",shape=box,color=blue];
		3031 -> 3038;
	3028 [label="Oui ? What do you mean ?",shape=box,color=blue];
