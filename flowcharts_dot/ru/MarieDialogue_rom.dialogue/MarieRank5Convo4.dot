	3030 [label="+5 Chemistry",color=orange];
		3030 -> 3037;
	3031 [label="О! Я вовсе не это имела в виду, прости меня! Просто он, похоже, благоволит тебе, так что, возможно, ты способен быть для него тем, кого он выслушает, тогда как всех остальных может проигнорировать.",shape=box,color=blue];
		3031 -> 3038;
	3028 [label="Oui ? Что ты имеешь в виду ?",shape=box,color=blue];
		3028 -> 3036;
	3029 [label="Oui, похоже, он явно благоволит тебе. Возможно, это потому, что вы разделяете одно время и одно место, чего у нас нет? Зачем ещё ему это делать?",shape=box,color=blue];
		3029 -> 3036;
