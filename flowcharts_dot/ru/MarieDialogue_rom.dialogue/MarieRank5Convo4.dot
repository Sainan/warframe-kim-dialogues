	3023 [label="+20 Chemistry",color=orange];
		3023 -> 3032;
	3024 [label="I have deeply misjudged this devil of ours...",shape=box,color=blue];
		3024 -> 3033;
	3025 [label="Oui, I hope you are correct.",shape=box,color=blue];
		3025 -> 3034;
	3026 [label="Oui. At least you are around to ensure we keep him from following through on his... baser instincts.",shape=box,color=blue];
		3026 -> 3034;
	3021 [label="What're you insinuating, Marie?",shape=box,color=red];
		3021 -> 3030;
	3022 [label="I wouldn't want to use my relationship with him as a negotiation tool.",shape=box,color=red];
		3022 -> 3031;
	3019 [label="He can be, but I think a lot of that is just for show.",shape=box,color=red];
		3019 -> 3028;
