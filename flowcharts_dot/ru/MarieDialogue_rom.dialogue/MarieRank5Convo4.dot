	3014 [label="I will speak to Lyon in the meanwhile, but my hopes are exceedingly low.",shape=box,color=blue];
		3014 -> 3023;
	3015 [label="+20 Chemistry",color=orange];
		3015 -> 3024;
	3016 [label="I think it's just the excuse he's making to cover for it.",shape=box,color=red];
		3016 -> 3025;
	3017 [label="At least he'll help, though. And I'll make sure he doesn't actually follow through with his threats.",shape=box,color=red];
		3017 -> 3026;
	3011 [label="I think you have a special way of convincing him, where all others have failed, non ?",shape=box,color=blue];
		3011 -> 3021;
		3011 -> 3022;
	3010 [label="I wish you the best of luck. That devil can be obstinate at the best of times. Sometimes, I think he just enjoys being contrary !",shape=box,color=blue];
		3010 -> 3019;
		3010 -> 3020;
	3012 [label="Oui, I do. But I think you have a special way of convincing him, where all others have failed, non ?",shape=box,color=blue];
