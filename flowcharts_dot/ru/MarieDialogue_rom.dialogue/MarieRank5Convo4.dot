	3012 [label="Oui, я знаю. Но я думаю, у тебя есть особый способ убедить его, в котором все остальные потерпели неудачу, non ?",shape=box,color=blue];
		3012 -> 3021;
		3012 -> 3022;
	3013 [label="Oui, конечно знаю. Этот дьявол и в лучшие времена бывает упрямым. Иногда мне кажется, ему просто нравится быть противоречивым !",shape=box,color=blue];
		3013 -> 3019;
