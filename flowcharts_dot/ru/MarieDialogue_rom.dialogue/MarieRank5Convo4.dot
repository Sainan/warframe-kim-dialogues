	3023 [label="+20 Chemistry",color=orange];
		3023 -> 3032;
	3024 [label="Я глубоко недооценила этого нашего дьявола...",shape=box,color=blue];
		3024 -> 3033;
	3025 [label="Oui, надеюсь, это верно.",shape=box,color=blue];
		3025 -> 3034;
	3026 [label="Oui. По крайней мере, ты рядом и можешь не дать ему последовать своим... низменным инстинктам.",shape=box,color=blue];
		3026 -> 3034;
	3021 [label="На что ты намекаешь, Мари?",shape=box,color=red];
		3021 -> 3030;
	3022 [label="Я бы не хотел использовать наши с ним отношения как инструмент переговоров.",shape=box,color=red];
		3022 -> 3031;
	3019 [label="Он может таким быть, но, думаю, во многом это просто показуха.",shape=box,color=red];
		3019 -> 3028;
	3020 [label="Мне это даже нравится, как бы странно это ни звучало. Мы хорошо ладим.",shape=box,color=red];
		3020 -> 3029;
	3027 [label="Update boolean MarieRank5Convo4Complete",color=orange];
		3027 -> 3035;
	3032 [label="Дьявол переменчив ! C'est la vie, как говорится!",shape=box,color=blue];
		3032 -> 3039;
	3033 [label="И я не настолько глупа, чтобы не видеть твою роль в том, чтобы всё это стало возможным !",shape=box,color=blue];
		3033 -> 3040;
	3034 [label="Check boolean MarieDating",color=orange];
