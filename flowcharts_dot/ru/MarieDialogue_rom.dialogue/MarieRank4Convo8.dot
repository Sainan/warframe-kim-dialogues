digraph {
	1924 [label="MarieRank4Convo8 begins.",color=orange];
		1924 -> 1925;
	1925 [label="Check boolean MarieOtak1",color=orange];
		1925 -> 1927 [label=true,color=green];
		1925 -> 1926 [label=false,color=brown];
	1927 [label="Скиталец, чем дольше я размышляю над тем, что открыли Monsieur Некралоид и Monsieur Отак, тем больше это меня беспокоит...",shape=box,color=blue];
		1927 -> 1930;
		1927 -> 1931;
	1926 [label="Скиталец, я могу поговорить с тобой?",shape=box,color=blue];
		1926 -> 1928;
		1926 -> 1929;
	1930 [label="Как так?",shape=box,color=red];
		1930 -> 1934;
	1931 [label="В чём именно проблема?",shape=box,color=red];
		1931 -> 1934;
	1928 [label="Конечно. Что это?",shape=box,color=red];
		1928 -> 1932;
	1929 [label="[Конец.]",shape=box,color=red];
		1929 -> 1933;
	1934 [label="Я спросила Monsieur Некралоида, принадлежал ли череп, украшавший его, когда-то живой душе или нет.",shape=box,color=blue];
		1934 -> 1936;
	1932 [label="Мне любопытно, почему у него на спине есть ещё одно лицо, похожее на детские каракули.",shape=box,color=blue];
		1932 -> 1935;
	1933 [label="Chat ends.",color=orange];
	1936 [label="И Monsieur Некралоид сказал мне, что это «его» череп, хотя и признал, что Monsieur Лойд был «оригиналом». Monsieur Лойд вмешался и сказал мне, что это была «реплика» его собственного черепа.",shape=box,color=blue];
		1936 -> 1938;
	1935 [label="Я расспросила Monsieur Некралоида и Monsieur Лойда, но ни один из них не пожелал об этом говорить. Они дали мне только одно имя. Отак. И они произнесли это с большой грустью.",shape=box,color=blue];
		1935 -> 1937;
	1938 [label="Как это возможно? И что означает «воссоздан»? Это настоящий череп или ou bien c'est un faux? Почему у Monsieur Некралоида и Monsieur Лойда разные ответы?",shape=box,color=blue];
		1938 -> 1940;
		1938 -> 1941;
		1938 -> 1942;
	1937 [label="И вот я здесь, разговариваю с тобой в надежде, что ты сможешь мне помочь.",shape=box,color=blue];
		1937 -> 1939;
	1940 [label="Я предполагаю, что с точки зрения Некралоида, это его череп. Это верно. Но с точки зрения Лойда, это лишь реплика.",shape=box,color=red];
		1940 -> 1944;
	1941 [label="Честно говоря, я понятия не имею, из чего он сделан. Это может быть кость. Или какой-то полимер...",shape=box,color=red];
		1941 -> 1945;
	1942 [label="Я думаю, что глубинная суть твоего вопроса, заключается в том, «настоящий ли Некралоид», а не «настоящий ли череп».",shape=box,color=red];
		1942 -> 1946;
	1939 [label="Не расскажешь ли мне историю бедного Monsieur Отака?",shape=box,color=blue];
		1939 -> 1943;
	1944 [label="Я думаю, это то, что меня беспокоит. Вот как эти два джентльмена относятся к своему происхождению. Один считает его священным, другой копией.",shape=box,color=blue];
		1944 -> 1948;
	1945 [label="Я не уверен, что меня так беспокоит состав черепа. Скорее его происхождение. Или, может быть, то, как эти два джентльмена относятся к его происхождению. Один считает его священным, другой копией.",shape=box,color=blue];
		1945 -> 1948;
	1946 [label="+5 Chemistry",color=orange];
		1946 -> 1949;
	1943 [label="Раньше Отак был архимедиан, учёным и академиком Орокин. То, что с ним произошло, нельзя назвать особенно радостной историей.",shape=box,color=red];
		1943 -> 1947;
	1948 [label="Evaluate expressions",color=orange];
		1948 -> 1558 [label="MarieCephalonSoul",color=purple];
		1948 -> 1557 [label="MarieCephalonNoSoul",color=purple];
		1948 -> 1559 [label="MarieCephalonUnsure",color=purple];
		1948 -> 1560 [label="false",color=purple];
	1949 [label="Oui! Это правда, в этом и суть всего - или, скорее череп всего - ха-ха. Один считает его sacro-saint, другой копией.",shape=box,color=blue];
		1949 -> 1948;
	1947 [label="Судя по всему, он был гением и умом, стоящим за освоением кристаллов аргона.",shape=box,color=red];
		1947 -> 1556;
	1558 [label="Как Monsieur Некралоид может обладать душой, когда у него нет собственных костей?",shape=box,color=blue];
		1558 -> 1562;
		1558 -> 1563;
		1558 -> 1564;
	1557 [label="Это ещЁ одно доказательство того, что у Monsieur Некралоида нет души?",shape=box,color=blue];
		1557 -> 1562;
		1557 -> 1563;
		1557 -> 1564;
	1559 [label="Я знаю, ты сомневаешься, может ли у Monsieur Некралоида быть душа. Но как она может быть у того, кто не владеет даже собственными костями.",shape=box,color=blue];
		1559 -> 1562;
		1559 -> 1563;
		1559 -> 1564;
	1560 [label="Я говорю о весьма сложном устройстве, созданном, чтобы напоминать человека, не так ли? О фонографе, во много-много раз более сложном.",shape=box,color=blue];
		1560 -> 1565;
		1560 -> 1566;
		1560 -> 1567;
		1560 -> 1568;
		1560 -> 1569;
	1556 [label="Которые извлекаются из Бездны, именно благодаря им мы можем создавать множество мощных варфреймов и оружия.",shape=box,color=red];
		1556 -> 1561;
	1562 [label="Может быть, ты прав. Возможно, они действительно всего лишь копии людей. Но я не уверен, и нам всё равно нужно относиться к ним так, словно они люди.",shape=box,color=red];
		1562 -> 1571;
	1563 [label="Я думаю, что Некралоид это исключение, а не правило. Он был создан как точная копия человека, а не из человека.",shape=box,color=red];
		1563 -> 1572;
	1564 [label="Ты прав. Вероятно, это лучше и гуманнее, если они не настоящие души, запертые внутри сложных научных рамок...",shape=box,color=red];
		1564 -> 1573;
	1565 [label="У Некралоида, может, и нет души, но он уникален. У других Цефалонов, например, Отака, она есть. Они были уничтожены ещё в том виде, в каком были созданы.",shape=box,color=red];
		1565 -> 1574;
	1566 [label="Ты права. Так что же мне с этим делать?",shape=box,color=red];
		1566 -> 1575;
	1567 [label="Ты права. Они не такие. Но это не значит, что мы можем обращаться с ними плохо.",shape=box,color=red];
		1567 -> 1576;
	1568 [label="Не знаю, права ты или нет. Но они всё ещё могут думать и чувствовать, и мы не можем обращаться с ними как с вещами.",shape=box,color=red];
		1568 -> 1577;
	1569 [label="У Некралоидов есть душа. У всех Цефалонов она есть.",shape=box,color=red];
		1569 -> 1578;
	1561 [label="Он специализировался на кристаллографии. И его труды были сохранены здесь, в лабораториях.",shape=box,color=red];
		1561 -> 1570;
	1571 [label="Update boolean MarieCephalonUnsure",color=orange];
		1571 -> 1580;
	1572 [label="Update boolean MarieCephalonSoul",color=orange];
		1572 -> 1581;
	1573 [label="Update boolean MarieCephalonNoSoul",color=orange];
		1573 -> 1582;
	1574 [label="Update boolean MarieCephalonSoul",color=orange];
		1574 -> 1583;
	1575 [label="Update boolean MarieCephalonNoSoul",color=orange];
		1575 -> 1584;
	1576 [label="Update boolean MarieCephalonNoSoul",color=orange];
		1576 -> 1585;
	1577 [label="Update boolean MarieCephalonUnsure",color=orange];
		1577 -> 1586;
	1578 [label="Update boolean MarieCephalonSoul",color=orange];
		1578 -> 1587;
	1570 [label="По какой-то причине, я не знаю, его превратили в Цефалона и дали ему собственную некралоидную оболочку.",shape=box,color=red];
		1570 -> 1579;
	1580 [label="Update boolean MarieCephalonNoSoul",color=orange];
		1580 -> 1589;
	1581 [label="Update boolean MarieCephalonUnsure",color=orange];
		1581 -> 1590;
	1582 [label="Update boolean MarieCephalonSoul",color=orange];
		1582 -> 1591;
	1583 [label="+5 Chemistry",color=orange];
		1583 -> 1592;
	1584 [label="О, не думай, что я призываю к жестокости! Нет! Береги их, ибо они драгоценны, и не по своей вине они стали такими, какие они есть!",shape=box,color=blue];
		1584 -> 1593;
	1585 [label="+5 Chemistry",color=orange];
		1585 -> 1584;
	1586 [label="+5 Chemistry",color=orange];
		1586 -> 1594;
	1587 [label="+5 Chemistry",color=orange];
		1587 -> 1595;
	1579 [label="Не все Цефалоны были созданы в наказание. Но здесь, на Деймосе, дела пошли... плохо, и он был серьёзно повреждён.",shape=box,color=red];
		1579 -> 1588;
	1589 [label="Update boolean MarieCephalonSoul",color=orange];
		1589 -> 1597;
	1590 [label="Update boolean MarieCephalonNoSoul",color=orange];
		1590 -> 1598;
	1591 [label="Update boolean MarieCephalonUnsure",color=orange];
		1591 -> 1599;
	1592 [label="Ещё одно доказательство того, что дьявол и ему подобные были справедливо осуждены. Но, возможно, ты прав насчёт Отака и ему подобных, или, возможно, тебе становится спокойнее от этой мысли.",shape=box,color=blue];
		1592 -> 1593;
	1593 [label="И, в конце концов, я могу ошибаться. Но проявить доброту и уважение никогда не бывает вредно.",shape=box,color=blue];
		1593 -> 1600;
	1594 [label="Возможно, ты прав, но я не думаю, что демоны Орокин знали о механизмах души больше, чем мы. Они не были великими богами.",shape=box,color=blue];
		1594 -> 1593;
	1595 [label="Возможно, ты прав, а может быть, эта вера приносит тебе умиротворение.",shape=box,color=blue];
		1595 -> 1593;
	1588 [label="Pauvre petit...",shape=box,color=blue];
		1588 -> 1596;
	1597 [label="+5 Chemistry",color=orange];
		1597 -> 1603;
	1598 [label="+5 Chemistry",color=orange];
		1598 -> 1604;
	1599 [label="+5 Chemistry",color=orange];
		1599 -> 1605;
	1600 [label="Я собираюсь вернуться и сплести венок из цветов для Monsieur Некралоида, кем бы он ни был. Он суетился, но мне не говорят non!",shape=box,color=blue];
		1600 -> 1606;
		1600 -> 1607;
		1600 -> 1608;
	1596 [label="Update boolean MarieOtak1",color=orange];
		1596 -> 2945;
	1603 [label="Oui, это очень мудро. Я просто размышляю вслух и делюсь с тобой, что они из себя представляют. Я согласна, никогда не бывает плохого в проявлении доброты и уважения.",shape=box,color=blue];
		1603 -> 1610;
	1604 [label="Возможно, правда твоя. И я надеюсь на это! Как бы ни было, мы должны быть добры - ведь они мыслящие существа. А то, что может мыслить, может и чувствовать.",shape=box,color=blue];
		1604 -> 1610;
	1605 [label="Как бы ни было, мы должны быть добры - ведь они мыслящие существа. А то, что может мыслить, может и чувствовать.",shape=box,color=blue];
		1605 -> 1593;
	1606 [label="Это восхитительно.",shape=box,color=red];
		1606 -> 1611;
	1607 [label="Венок из цветов?",shape=box,color=red];
		1607 -> 1612;
	1608 [label="Повеселись.",shape=box,color=red];
		1608 -> 1613;
	2945 [label="Check boolean LoidFamilyComplete",color=orange];
		2945 -> 1601 [label=true,color=green];
		2945 -> 1602 [label=false,color=brown];
		2945 -> 1601 [label=false,color=brown];
	1610 [label="И, в конце концов, мы можем ошибаться. Но проявить доброту и уважение никогда не бывает вредно. ",shape=box,color=blue];
		1610 -> 1600;
	1611 [label="+5 Chemistry",color=orange];
		1611 -> 1614;
	1612 [label="+10 Chemistry",color=orange];
		1612 -> 1615;
	1613 [label="+5 Chemistry",color=orange];
		1613 -> 1616;
	1601 [label="Как мы до этого дошли?",shape=box,color=red];
		1601 -> 1934;
	1602 [label="Я надеюсь, что однажды ты сможешь с ним встретиться.",shape=box,color=red];
		1602 -> 1609;
	1614 [label="Merci! À la revoyure!",shape=box,color=blue];
		1614 -> 1617;
	1615 [label="О, это подпадает под правила Луа. В годовщину смерти души плетут корону или венок из цветов и возлагают на череп усопшего или могилу. ",shape=box,color=blue];
		1615 -> 1618;
	1616 [label="Merci, обязательно! À la revoyure!",shape=box,color=blue];
		1616 -> 1617;
	1609 [label="Oui. Но, полагаю, меня тревожит не его молчание. Я спросил Monsieur Некралоида, принадлежал ли череп, что украшает его, когда-то живой душе или нет.",shape=box,color=blue];
		1609 -> 1936;
	1617 [label="Chat ends.",color=orange];
	1618 [label="В традиционных склепах тела часто выставлялись на обозрение, oui? Так что можно было так сделать. Я думаю, что некоторые традиции сохранились до сих пор.",shape=box,color=blue];
		1618 -> 1619;
	1619 [label="Я вижу это отражение и в некоторых произведениях искусства Орокин с их любовью к черепам. ",shape=box,color=blue];
		1619 -> 1620;
		1619 -> 1621;
		1619 -> 1622;
	1620 [label="Это многое объясняет.",shape=box,color=red];
		1620 -> 1623;
	1621 [label="Чем больше вещей меняется, huh?",shape=box,color=red];
		1621 -> 1623;
	1622 [label="Кажется, Дочь уже пыталась сделать это раньше, ты же заставишь её ревновать.",shape=box,color=red];
		1622 -> 1624;
	1623 [label="Oui! Прошло так много времени, но влияние остаётся. Приятно осознавать, что сохранились даже крошечные фрагменты.",shape=box,color=blue];
		1623 -> 1625;
	1624 [label="Oui? Так что я не могу дождаться встречи с ней! Я скажу ей, что я ему не давала пощады.",shape=box,color=blue];
		1624 -> 1625;
	1625 [label="Фальшивый череп или нет, Monsieur Некралоиду нужна корона. И это делает его таким застенчивым, что я его обожаю! Я думаю, он бы покраснел, если бы мог. И это заставляет меня улыбаться.",shape=box,color=blue];
		1625 -> 1626;
	1626 [label="À la revoyure!",shape=box,color=blue];
		1626 -> 1627;
	1627 [label="Chat ends.",color=orange];
