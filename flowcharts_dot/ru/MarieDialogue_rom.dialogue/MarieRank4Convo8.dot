digraph {
	graph [fontname="Roboto Condensed"];
	node [fontname="Roboto Condensed"];
	edge [fontname="Roboto Condensed"];

	"MarieRank4Convo8 begins." [color=orange];
		"MarieRank4Convo8 begins." -> j1666837665;
	j1666837665 [label="Boolean MarieLyonAvailable is now true.",color=orange];
		j1666837665 -> j2786051379;
	j2786051379 [label="Check boolean MarieOtak1",color=orange];
		j2786051379 -> j958382081 [label=true,color=green];
		j2786051379 -> j2140833475 [label=false,color=brown];
	j958382081 [label="Скиталец, чем дольше я размышляю над тем, что открыли Monsieur Некралоид и Monsieur Отак, тем больше это меня беспокоит...",shape=box,color=blue];
		j958382081 -> j3802843138;
		j958382081 -> j3347447089;
	j2140833475 [label="Скиталец, я могу поговорить с тобой?",shape=box,color=blue];
		j2140833475 -> j676980343;
		j2140833475 -> j1310452999;
	j3802843138 [label="Как так?",shape=box,color=red];
		j3802843138 -> j406340986;
	j3347447089 [label="В чём именно проблема?",shape=box,color=red];
		j3347447089 -> j406340986;
	j676980343 [label="Конечно. Что это?",shape=box,color=red];
		j676980343 -> j1794851169;
	j1310452999 [label="[Конец.]",shape=box,color=red];
		j1310452999 -> "Chat ends.";
	j406340986 [label="Я спросила Monsieur Некралоида, принадлежал ли череп, украшавший его, когда-то живой душе или нет.",shape=box,color=blue];
		j406340986 -> j2927492133;
	j1794851169 [label="Мне любопытно, почему у него на спине есть ещё одно лицо, похожее на детские каракули.",shape=box,color=blue];
		j1794851169 -> j2276759976;
	"Chat ends." [color=orange];
	j2927492133 [label="И Monsieur Некралоид сказал мне, что это «его» череп, хотя и признал, что Monsieur Лойд был «оригиналом». Monsieur Лойд вмешался и сказал мне, что это была «реплика» его собственного черепа.",shape=box,color=blue];
		j2927492133 -> j4208686164;
	j2276759976 [label="Я расспросила Monsieur Некралоида и Monsieur Лойда, но ни один из них не пожелал об этом говорить. Они дали мне только одно имя. Отак. И они произнесли это с большой грустью.",shape=box,color=blue];
		j2276759976 -> j467385001;
	j4208686164 [label="Как это возможно? И что означает «воссоздан»? Это настоящий череп или ou bien c'est un faux? Почему у Monsieur Некралоида и Monsieur Лойда разные ответы?",shape=box,color=blue];
		j4208686164 -> j3463844403;
		j4208686164 -> j2652064038;
		j4208686164 -> j67660905;
	j467385001 [label="И вот я здесь, разговариваю с тобой в надежде, что ты сможешь мне помочь.",shape=box,color=blue];
		j467385001 -> j3134054622;
	j3463844403 [label="Я предполагаю, что с точки зрения Некралоида, это его череп. Это верно. Но с точки зрения Лойда, это лишь реплика.",shape=box,color=red];
		j3463844403 -> j1197918246;
	j2652064038 [label="Честно говоря, я понятия не имею, из чего он сделан. Это может быть кость. Или какой-то полимер...",shape=box,color=red];
		j2652064038 -> j2634235804;
	j67660905 [label="Я думаю, что глубинная суть твоего вопроса, заключается в том, «настоящий ли Некралоид», а не «настоящий ли череп».",shape=box,color=red];
		j67660905 -> j1764599773;
	j3134054622 [label="Не расскажешь ли мне историю бедного Monsieur Отака?",shape=box,color=blue];
		j3134054622 -> j1774925948;
	j1197918246 [label="Я думаю, это то, что меня беспокоит. Вот как эти два джентльмена относятся к своему происхождению. Один считает его священным, другой копией.",shape=box,color=blue];
		j1197918246 -> j3408858168;
	j2634235804 [label="Я не уверен, что меня так беспокоит состав черепа. Скорее его происхождение. Или, может быть, то, как эти два джентльмена относятся к его происхождению. Один считает его священным, другой копией.",shape=box,color=blue];
		j2634235804 -> j3408858168;
	j1764599773 [label="+5 Chemistry",color=orange];
		j1764599773 -> j4090438173;
	j1774925948 [label="Раньше Отак был архимедиан, учёным и академиком Орокин. То, что с ним произошло, нельзя назвать особенно радостной историей.",shape=box,color=red];
		j1774925948 -> j1757914315;
	j3408858168 [label="Evaluate expressions",color=orange];
		j3408858168 -> j3986735387 [label="MarieCephalonSoul",color=purple];
		j3408858168 -> j3237645858 [label="MarieCephalonNoSoul",color=purple];
		j3408858168 -> j4153576771 [label="MarieCephalonUnsure",color=purple];
		j3408858168 -> j1401816720 [label="false",color=purple];
	j4090438173 [label="Oui! Это правда, в этом и суть всего - или, скорее череп всего - ха-ха. Один считает его sacro-saint, другой копией.",shape=box,color=blue];
		j4090438173 -> j3408858168;
	j1757914315 [label="Судя по всему, он был гением и умом, стоящим за освоением кристаллов аргона.",shape=box,color=red];
		j1757914315 -> j3844324349;
	j3986735387 [label="Как Monsieur Некралоид может обладать душой, когда у него нет собственных костей?",shape=box,color=blue];
		j3986735387 -> j2205811242;
		j3986735387 -> j508144819;
		j3986735387 -> j2235981845;
	j3237645858 [label="Это ещЁ одно доказательство того, что у Monsieur Некралоида нет души?",shape=box,color=blue];
		j3237645858 -> j2205811242;
		j3237645858 -> j508144819;
		j3237645858 -> j2235981845;
	j4153576771 [label="Я знаю, ты сомневаешься, может ли у Monsieur Некралоида быть душа. Но как она может быть у того, кто не владеет даже собственными костями.",shape=box,color=blue];
		j4153576771 -> j2205811242;
		j4153576771 -> j508144819;
		j4153576771 -> j2235981845;
	j1401816720 [label="Я говорю о весьма сложном устройстве, созданном, чтобы напоминать человека, не так ли? О фонографе, во много-много раз более сложном.",shape=box,color=blue];
		j1401816720 -> j973537633;
		j1401816720 -> j3753425718;
		j1401816720 -> j2819259999;
		j1401816720 -> j3219657861;
		j1401816720 -> j3801434779;
	j3844324349 [label="Которые извлекаются из Бездны, именно благодаря им мы можем создавать множество мощных варфреймов и оружия.",shape=box,color=red];
		j3844324349 -> j3669287555;
	j2205811242 [label="Может быть, ты прав. Возможно, они действительно всего лишь копии людей. Но я не уверен, и нам всё равно нужно относиться к ним так, словно они люди.",shape=box,color=red];
		j2205811242 -> j710414026;
	j508144819 [label="Я думаю, что Некралоид это исключение, а не правило. Он был создан как точная копия человека, а не из человека.",shape=box,color=red];
		j508144819 -> j2781444186;
	j2235981845 [label="Ты прав. Вероятно, это лучше и гуманнее, если они не настоящие души, запертые внутри сложных научных рамок...",shape=box,color=red];
		j2235981845 -> j1478195099;
	j973537633 [label="У Некралоида, может, и нет души, но он уникален. У других Цефалонов, например, Отака, она есть. Они были уничтожены ещё в том виде, в каком были созданы.",shape=box,color=red];
		j973537633 -> j3156114056;
	j3753425718 [label="Ты права. Так что же мне с этим делать?",shape=box,color=red];
		j3753425718 -> j2795137717;
	j2819259999 [label="Ты права. Они не такие. Но это не значит, что мы можем обращаться с ними плохо.",shape=box,color=red];
		j2819259999 -> j167572864;
	j3219657861 [label="Не знаю, права ты или нет. Но они всё ещё могут думать и чувствовать, и мы не можем обращаться с ними как с вещами.",shape=box,color=red];
		j3219657861 -> j4263479832;
	j3801434779 [label="У Некралоидов есть душа. У всех Цефалонов она есть.",shape=box,color=red];
		j3801434779 -> j3715601690;
	j3669287555 [label="Он специализировался на кристаллографии. И его труды были сохранены здесь, в лабораториях.",shape=box,color=red];
		j3669287555 -> j785489710;
	j710414026 [label="Boolean MarieCephalonUnsure is now true.",color=orange];
		j710414026 -> j4188142797;
	j2781444186 [label="Boolean MarieCephalonSoul is now true.",color=orange];
		j2781444186 -> j4046415831;
	j1478195099 [label="Boolean MarieCephalonNoSoul is now true.",color=orange];
		j1478195099 -> j1707638335;
	j3156114056 [label="Boolean MarieCephalonSoul is now true.",color=orange];
		j3156114056 -> j1555239307;
	j2795137717 [label="Boolean MarieCephalonNoSoul is now true.",color=orange];
		j2795137717 -> j2694557770;
	j167572864 [label="Boolean MarieCephalonNoSoul is now true.",color=orange];
		j167572864 -> j3476250331;
	j4263479832 [label="Boolean MarieCephalonUnsure is now true.",color=orange];
		j4263479832 -> j796873770;
	j3715601690 [label="Boolean MarieCephalonSoul is now true.",color=orange];
		j3715601690 -> j2778022609;
	j785489710 [label="По какой-то причине, я не знаю, его превратили в Цефалона и дали ему собственную некралоидную оболочку.",shape=box,color=red];
		j785489710 -> j564682237;
	j4188142797 [label="Boolean MarieCephalonNoSoul is now false.",color=orange];
		j4188142797 -> j3803485543;
	j4046415831 [label="Boolean MarieCephalonUnsure is now false.",color=orange];
		j4046415831 -> j1899483925;
	j1707638335 [label="Boolean MarieCephalonSoul is now false.",color=orange];
		j1707638335 -> j3552152693;
	j1555239307 [label="+5 Chemistry",color=orange];
		j1555239307 -> j3009309248;
	j2694557770 [label="О, не думай, что я призываю к жестокости! Нет! Береги их, ибо они драгоценны, и не по своей вине они стали такими, какие они есть!",shape=box,color=blue];
		j2694557770 -> j1429577728;
	j3476250331 [label="+5 Chemistry",color=orange];
		j3476250331 -> j2694557770;
	j796873770 [label="+5 Chemistry",color=orange];
		j796873770 -> j2920560638;
	j2778022609 [label="+5 Chemistry",color=orange];
		j2778022609 -> j2305029236;
	j564682237 [label="Не все Цефалоны были созданы в наказание. Но здесь, на Деймосе, дела пошли... плохо, и он был серьёзно повреждён.",shape=box,color=red];
		j564682237 -> j3998308863;
	j3803485543 [label="Boolean MarieCephalonSoul is now false.",color=orange];
		j3803485543 -> j1477301475;
	j1899483925 [label="Boolean MarieCephalonNoSoul is now false.",color=orange];
		j1899483925 -> j4011185654;
	j3552152693 [label="Boolean MarieCephalonUnsure is now false.",color=orange];
		j3552152693 -> j163470032;
	j3009309248 [label="Ещё одно доказательство того, что дьявол и ему подобные были справедливо осуждены. Но, возможно, ты прав насчёт Отака и ему подобных, или, возможно, тебе становится спокойнее от этой мысли.",shape=box,color=blue];
		j3009309248 -> j1429577728;
	j1429577728 [label="И, в конце концов, я могу ошибаться. Но проявить доброту и уважение никогда не бывает вредно.",shape=box,color=blue];
		j1429577728 -> j2376370393;
	j2920560638 [label="Возможно, ты прав, но я не думаю, что демоны Орокин знали о механизмах души больше, чем мы. Они не были великими богами.",shape=box,color=blue];
		j2920560638 -> j1429577728;
	j2305029236 [label="Возможно, ты прав, а может быть, эта вера приносит тебе умиротворение.",shape=box,color=blue];
		j2305029236 -> j1429577728;
	j3998308863 [label="Pauvre petit...",shape=box,color=blue];
		j3998308863 -> j3134774711;
	j1477301475 [label="+5 Chemistry",color=orange];
		j1477301475 -> j3479257952;
	j4011185654 [label="+5 Chemistry",color=orange];
		j4011185654 -> j440911552;
	j163470032 [label="+5 Chemistry",color=orange];
		j163470032 -> j3390085414;
	j2376370393 [label="Я собираюсь вернуться и сплести венок из цветов для Monsieur Некралоида, кем бы он ни был. Он суетился, но мне не говорят non!",shape=box,color=blue];
		j2376370393 -> j3821368217;
		j2376370393 -> j2470145944;
		j2376370393 -> j2385706685;
	j3134774711 [label="Boolean MarieOtak1 is now true.",color=orange];
		j3134774711 -> j3951815689;
	j3479257952 [label="Oui, это очень мудро. Я просто размышляю вслух и делюсь с тобой, что они из себя представляют. Я согласна, никогда не бывает плохого в проявлении доброты и уважения.",shape=box,color=blue];
		j3479257952 -> j596565448;
	j440911552 [label="Возможно, правда твоя. И я надеюсь на это! Как бы ни было, мы должны быть добры - ведь они мыслящие существа. А то, что может мыслить, может и чувствовать.",shape=box,color=blue];
		j440911552 -> j596565448;
	j3390085414 [label="Как бы ни было, мы должны быть добры - ведь они мыслящие существа. А то, что может мыслить, может и чувствовать.",shape=box,color=blue];
		j3390085414 -> j1429577728;
	j3821368217 [label="Это восхитительно.",shape=box,color=red];
		j3821368217 -> j1606543034;
	j2470145944 [label="Венок из цветов?",shape=box,color=red];
		j2470145944 -> j1379025836;
	j2385706685 [label="Повеселись.",shape=box,color=red];
		j2385706685 -> j578134357;
	j3951815689 [label="Check boolean LoidFamilyComplete",color=orange];
		j3951815689 -> j3779732256 [label=true,color=green];
		j3951815689 -> j2513113499 [label=false,color=brown];
		j3951815689 -> j3779732256 [label=false,color=brown];
	j596565448 [label="И, в конце концов, мы можем ошибаться. Но проявить доброту и уважение никогда не бывает вредно. ",shape=box,color=blue];
		j596565448 -> j2376370393;
	j1606543034 [label="+5 Chemistry",color=orange];
		j1606543034 -> j365059909;
	j1379025836 [label="+10 Chemistry",color=orange];
		j1379025836 -> j2683942547;
	j578134357 [label="+5 Chemistry",color=orange];
		j578134357 -> j2706235525;
	j3779732256 [label="Как мы до этого дошли?",shape=box,color=red];
		j3779732256 -> j406340986;
	j2513113499 [label="Я надеюсь, что однажды ты сможешь с ним встретиться.",shape=box,color=red];
		j2513113499 -> j4081033476;
	j365059909 [label="Merci! À la revoyure!",shape=box,color=blue];
		j365059909 -> "Chat ends.";
	j2683942547 [label="О! Это один из обрядов Луа. В годовщину смерти души плетут венок из цветов и возлагают его на череп или могилу. ",shape=box,color=blue];
		j2683942547 -> j2285327812;
	j2706235525 [label="Merci, обязательно! À la revoyure!",shape=box,color=blue];
		j2706235525 -> "Chat ends.";
	j4081033476 [label="Oui. Но, полагаю, меня тревожит не его молчание. Я спросил Monsieur Некралоида, принадлежал ли череп, что украшает его, когда-то живой душе или нет.",shape=box,color=blue];
		j4081033476 -> j2927492133;
	j2285327812 [label="В традиционных склепах тела часто выставлялись на обозрение, oui? Так что можно было так сделать. Я думаю, что некоторые традиции сохранились до сих пор.",shape=box,color=blue];
		j2285327812 -> j2031917380;
	j2031917380 [label="Я вижу это отражение и в некоторых произведениях искусства Орокин с их любовью к черепам. ",shape=box,color=blue];
		j2031917380 -> j1370259221;
		j2031917380 -> j12177046;
		j2031917380 -> j1335971015;
	j1370259221 [label="Это многое объясняет.",shape=box,color=red];
		j1370259221 -> j1576490582;
	j12177046 [label="Чем больше вещей меняется, huh?",shape=box,color=red];
		j12177046 -> j1576490582;
	j1335971015 [label="Кажется, Дочь уже пыталась сделать это раньше, ты же заставишь её ревновать.",shape=box,color=red];
		j1335971015 -> j3127929204;
	j1576490582 [label="Oui! Прошло так много времени, но влияние остаётся. Приятно осознавать, что сохранились даже крошечные фрагменты.",shape=box,color=blue];
		j1576490582 -> j3434553116;
	j3127929204 [label="Oui? Так что я не могу дождаться встречи с ней! Я скажу ей, что я ему не давала пощады.",shape=box,color=blue];
		j3127929204 -> j3434553116;
	j3434553116 [label="Фальшивый череп или нет, Monsieur Некралоиду нужна корона. И это делает его таким застенчивым, что я его обожаю! Я думаю, он бы покраснел, если бы мог. И это заставляет меня улыбаться.",shape=box,color=blue];
		j3434553116 -> j3429743066;
	j3429743066 [label="À la revoyure!",shape=box,color=blue];
		j3429743066 -> "Chat ends.";
}