		489 -> 497 [label="false",color=purple];
	490 [label="Я рада это слышать. Ведь я знаю, что на самом деле у тебя мало причин для этого. Я слышала истории от Кавий.",shape=box,color=blue];
		490 -> 499;
	484 [label="Мы можем... хотя, скорее всего, предположат, что она мертва.",shape=box,color=red];
		484 -> 493;
	485 [label="Нет, и, кажется, никто не желает говорить о ней.",shape=box,color=red];
		485 -> 493;
	486 [label="Мы должны сохранить веру. Ведь если мы утратим надежду на то, что любовь преобладает над всем, тьма возьмёт верх.",shape=box,color=blue];
		486 -> 494;
	500 [label="Думаю, ты удивишься, узнав, насколько в этом мало моей заслуги. ",shape=box,color=blue];
		500 -> 510;
	501 [label="За отсутствие веры. В l'Indifférence. Вовсе ни во что. Если бы я создала мир du tissu du Néant - из ткани Бездны - пожалуй, я чувствовала бы то же самое.",shape=box,color=blue];
		501 -> 510;
	495 [label="+5 Chemistry",color=orange];
		495 -> 490;
	496 [label="Я стою рядом с дьяволом, живущим на протяжении бесчисленных столетий. Неподалёку от меня стоит женщина, которая сама по себе является машиной, наделённой душой тройственной богини.",shape=box,color=blue];
		496 -> 505;
	498 [label="Хах! Кому как не тебе следует знать, что вера никогда не бывает мудрой. И всё же такие души, как наши, всё равно несут её в себе, хотя она может нас и обжечь. Полагаю, ты это знаешь, если наша предыдущая беседа была правдой.",shape=box,color=blue];
		498 -> 507;
		498 -> 508;
	497 [label="Вера никогда не бывает разумной. Но те из нас, кто несёт её, как факел, стремятся нести её всегда — хоть это и может обжечь нас.",shape=box,color=blue];
		497 -> 506;
	499 [label="Update boolean MarieEntratiFan1",color=orange];
		499 -> 509;
	493 [label="А тебе не приходила мысль когда-нибудь о том, что сердце одного может принадлежать не одной душе, а нескольким? Что один человек может любить больше, чем одного?",shape=box,color=blue];
		493 -> 502;
		493 -> 503;
	494 [label="Ведь только любовь остаётся у нас в этом мире, когда всё остальное рушится, non?",shape=box,color=blue];
		494 -> 504;
	510 [label="Высшее прощение не то, что следует искать у других или даже у Светил.",shape=box,color=blue];
		510 -> 522;
		510 -> 523;
	505 [label="Мой брат слышит голоса мёртвых и самих богов.",shape=box,color=blue];
		505 -> 514;
	507 [label="Порой задаюсь вопросом, не глупо ли тащить в себе то, что способно причинить мне боль.",shape=box,color=red];
		507 -> 516;
	508 [label="Порой задаюсь вопросом, зачем мы вообще это несём.",shape=box,color=red];
		508 -> 517;
	506 [label="Тогда зачем его вообще нести, мне любопытно?",shape=box,color=red];
		506 -> 515;
	509 [label="Evaluate expressions",color=orange];
		509 -> 518 [label="DrifterFaithYesSimilar",color=purple];
		509 -> 518 [label="DrifterFaithYesForeign",color=purple];
