	519 [label="Хоть это и удивительно. Ранее в тебе выражалось создание маловерное.",shape=box,color=blue];
		519 -> 530;
		519 -> 531;
	521 [label="Вера для таких душ, как моя, подобна факелу - мы несём его всегда, хоть он и может сжечь нас в конце концов.",shape=box,color=blue];
		521 -> 506;
	511 [label="Update boolean DrifterPNo",color=orange];
		511 -> 524;
	512 [label="Update boolean DrifterPYes",color=orange];
		512 -> 524;
	513 [label="Это был прекрасный, солнечный день. Я помню, как он стоял перед алтарём, глядя на витражи с улыбкой, хотя я не понимала, почему.",shape=box,color=blue];
		513 -> 525;
	532 [label="Стремление исправить причинённый вред — важно, не пойми меня неправильно. Там, где это вообще возможно, получить прощение от тех, кого ранил — это бальзам на душу.",shape=box,color=blue];
		532 -> 538;
	533 [label="Ох, я вовсе не хочу сказать, что это неважно искать прощения у тех, кому причинил боль! Это важно!",shape=box,color=blue];
		533 -> 539;
	526 [label="Расскажи мне еще раз о тех, кто «просто люди», и я постараюсь изо всех сил не расхохотаться, даю тебе слово.",shape=box,color=blue];
		526 -> 536;
	528 [label="Мы несём это, потому что мы должны. Потому что мы не знаем другого способа существовать. Неважно, что это значит, в конце концов. Мне известно каково тебе.",shape=box,color=blue];
		528 -> 527;
	529 [label="Вера не постоянна. Она как прилив. Она приходит и уходит, и это нормально.",shape=box,color=blue];
		529 -> 527;
	527 [label="Но, боюсь, всё это не о том, ради чего здесь ты хочешь поговорить со мной. Тебе нужна история, non?",shape=box,color=blue];
		527 -> 513;
	530 [label="Я могу по-разному верить в людей и богов.",shape=box,color=red];
		530 -> 537;
	531 [label="Есть разница между верой в богов и верой в людей. А Энтрати - это просто человек.",shape=box,color=red];
		531 -> 488;
	524 [label="Интересно. Я недостаточно хорошо знаю обычаи Орокин, чтобы понять, противоречило ли это их обычаям. Но я знаю, что во многих древних культурах это не осуждалось.",shape=box,color=blue];
		524 -> 534;
	525 [label="Он низко наклонился, чтобы поприветствовать меня, сидящую в кресле, так что его голова оказалась ниже моей.",shape=box,color=blue];
		525 -> 535;
	538 [label="В итоге, когда мы встретимся лицом к лицу со Старухой, когда Луа прольет за нас свои серебряные слезы и смерть будет близка, вот тогда нам предстоит нести тяжесть собственного сердца.",shape=box,color=blue];
		538 -> 545;
		538 -> 546;
	539 [label="Загладить причинённый вред, который кто-то мог бы причинить, — это ещё более сильный бальзам на душу.",shape=box,color=blue];
		539 -> 538;
	536 [label="До тех пор я советую тебе ещё раз переосмыслить, что значит быть благословлённым. Прощай.",shape=box,color=blue];
		536 -> 544;
	537 [label="Oui, одни из них вполне осязаемы. Присутствуют. Другие требует закрыть глаза и поверить. ",shape=box,color=blue];
		537 -> 527;
	534 [label="Но вряд ли нам решать... в данном случае я здесь не для того, чтобы осуждать признания le Cardinal в любви к Monsieur Лойду или о словах любви, что произнёс в ответ M. Лойд.",shape=box,color=blue];
		534 -> 540;
