		517 -> 529;
	515 [label="Мы несём это, потому что мы должны. Потому что мы не знаем другого способа существовать. Неважно, что это значит, в конце концов. Мне известно, каково тебе.",shape=box,color=blue];
		515 -> 527;
	518 [label="Вера для таких душ, как наши, подобна факелу — мы несём его всегда, хоть он и может сжечь нас в конце концов.",shape=box,color=blue];
		518 -> 508;
		518 -> 507;
	520 [label="Хоть это и удивительно, ранее в тебе выражалось сомнение в вере.",shape=box,color=blue];
		520 -> 530;
