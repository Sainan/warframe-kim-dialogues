		j3219220611 -> j1301006523;
	j4117103631 [label="Add 1 to Thermostat counter",color=orange];
		j4117103631 -> j2875449641;
	j2722219027 [label="Oui. Действительно, некоторые назвали бы меня «invalide». Как и ты. Кем-то заслуживающим жалости или презрения. Но le Cardinal не сделал ничего подобного.",shape=box,color=blue];
		j2722219027 -> j988334071;
		j2722219027 -> j2212092051;
	j2042789987 [label="Oui. Действительно, некоторые назвали бы меня «invalide». Кем-то заслуживающим жалости или презрения. Но le Cardinal не сделал ничего подобного.",shape=box,color=blue];
		j2042789987 -> j1076088920;
		j2042789987 -> j317983698;
	j695017675 [label="Пожалуйста... Умоляю тебя, не думай плохо о моём дорогом Лионе. Он не немощен, уверяю тебя. То, что его беспокоит, — это не maladie de l'esprit.",shape=box,color=blue];
		j695017675 -> j1329118554;
	j1301006523 [label="Я могу только уважать твои убеждения, даже если у меня нет с ними согласия.",shape=box,color=blue];
		j1301006523 -> j160282665;
	j2875449641 [label="Oui, именно так. Если ты войдешь в потустороннее с тяжёлым сердцем, твоя душа не сможет взлететь.",shape=box,color=blue];
		j2875449641 -> j3829450079;
	j988334071 [label="Прости, я тебя чем-то обидел?",shape=box,color=red];
		j988334071 -> j245753992;
	j2212092051 [label="Я... искренне прошу прощения за это, у меня никогда не было мысли тебя обидеть.",shape=box,color=red];
		j2212092051 -> j589181368;
	j1076088920 [label="А ты не думаешь, что это не была уловка?",shape=box,color=red];
		j1076088920 -> j2953585011;
	j317983698 [label="Порой люди могут быть такими жестокими...",shape=box,color=red];
		j317983698 -> j1227788235;
	j1329118554 [label="Он просто иногда видит какие-то вещи, или вспоминает вещи, какими ощущались или какими, по словам духов, они должны были быть. Возможно, не такими, какими они были.",shape=box,color=blue];
		j1329118554 -> j3782434405;
	j160282665 [label="Я думаю, le Cardinal понимал, что нельзя войти в потустороннее с тяжёлым сердцем, вот почему он пришёл к нам.",shape=box,color=blue];
		j160282665 -> j4035765841;
	j3829450079 [label="Я думаю, le Cardinal знал это, вот почему он пришёл к нам.",shape=box,color=blue];
		j3829450079 -> j4035765841;
	j245753992 [label="Oui.",shape=box,color=blue];
		j245753992 -> j1508231473;
	j589181368 [label="Ничего страшного, всё хорошо. Другие слишком уж спешат обращаться со мной иначе просто потому, что мои взгляды не такие, как у других, или потому, что я не могу использовать мир так же, как они.",shape=box,color=blue];
		j589181368 -> j3113833300;
	j2953585011 [label="Если бы так и было, я бы радовалась этому каждый день своей жизни. Другие слишком уж спешат обращаться со мной иначе просто потому, что мои взгляды не такие, как у других, или потому, что я не могу использовать мир так же, как они.",shape=box,color=blue];
		j2953585011 -> j530047957;
	j1227788235 [label="Oui, они могут. Другие слишком уж спешат обращаться со мной иначе просто потому, что мои взгляды не такие, как у других, или потому, что я не могу использовать мир так же, как они.",shape=box,color=blue];
		j1227788235 -> j530047957;
	j3782434405 [label="Когда он решит поговорить с тобой, всё, что он расскажет тебе о том событии, будет таким, каким он его воспринял. И в глубине его сердца это будет истинной правдой.",shape=box,color=blue];
		j3782434405 -> j2885091779;
	j1508231473 [label="Boolean MarieNoDate is now true.",color=orange];
		j1508231473 -> "Chat ends.";
	j3113833300 [label="Boolean MarieInvalid is now false.",color=orange];
		j3113833300 -> j3452132992;
	j530047957 [label="Признаюсь, меня коробит от самой мысли о том, что меня будут из-за этого осуждать. Или, что ещё хуже, души не чаять! Пффф!",shape=box,color=blue];
		j530047957 -> j4019945936;
	j2885091779 [label="Он и я... схожи в том, что другие слишком уж стремятся относиться к нам по-другому.",shape=box,color=blue];
		j2885091779 -> j3034856208;
		j2885091779 -> j1983017104;
	j3452132992 [label="Я прощаю тебя. Признаюсь, меня коробит от самой мысли о том, что меня будут из-за этого осуждать. Или, что ещё хуже, души не чаять! Пффф!",shape=box,color=blue];
		j3452132992 -> j4019945936;
	j4019945936 [label="Вот почему le Cardinal был таким желанным présence в моей жизни. Он принёс с собой столько тепла. И ни разу не отнёсся ко мне с презрением или жалостью. Ни разу не посмотрел на меня как на une invalide.",shape=box,color=blue];
		j4019945936 -> j3548731198;
	j3034856208 [label="Люди могут быть жестокими. ",shape=box,color=red];
		j3034856208 -> j3726986319;
	j1983017104 [label="Что ты имеешь в виду?",shape=box,color=red];
		j1983017104 -> j3536475953;
	j3548731198 [label="Я была просто Мари. И только Мари. И за это он заслужил мою веру в него.",shape=box,color=blue];
		j3548731198 -> j1946988171;
	j3726986319 [label="Oui, они могут. Другие слишком уж спешат обращаться со мной иначе просто потому, что мои взгляды не такие, как у других, или потому, что я не могу использовать мир так же, как они.",shape=box,color=blue];
		j3726986319 -> j788058982;
	j3536475953 [label="Другие слишком уж спешат обращаться со мной иначе просто потому, что мои взгляды не такие, как у других, или потому, что я не могу использовать мир так же, как они.",shape=box,color=blue];
		j3536475953 -> j788058982;
