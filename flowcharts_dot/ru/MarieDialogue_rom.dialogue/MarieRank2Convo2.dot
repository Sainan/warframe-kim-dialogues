	502 [label="Лично мне — нет.",shape=box,color=red];
		502 -> 511;
	503 [label="Да, приходило, если бы все стороны были согласны с этим. ",shape=box,color=red];
		503 -> 512;
	504 [label="Ах! Но ты здесь ради историй! Я отняла столько твоего времени так, что я буду кратка.",shape=box,color=blue];
		504 -> 513;
	522 [label="Интересно. Почему ты так говоришь?",shape=box,color=red];
		522 -> 532;
	523 [label="Даже если тобою было причинено зло кому-то другому?",shape=box,color=red];
		523 -> 533;
	514 [label="Я прервала свой пост в компании зверей, которые поинтересовались качеством моего отдыха.",shape=box,color=blue];
		514 -> 526;
	516 [label="Add 1 to Thermostat",color=orange];
