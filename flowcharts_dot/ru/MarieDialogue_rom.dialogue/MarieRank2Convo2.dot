digraph {
	"MarieRank2Convo2 begins." [color=orange];
		"MarieRank2Convo2 begins." -> j4286188460;
		"MarieRank2Convo2 begins." -> j3784654539;
		"MarieRank2Convo2 begins." -> j1310452999;
	j4286188460 [label="Как ты познакомилась с Энтрати?",shape=box,color=red];
		j4286188460 -> j2030628594;
	j3784654539 [label="Позволь мне спросить, как ты относишься к Энтрати теперь, когда ты здесь?",shape=box,color=red];
		j3784654539 -> j650920214;
	j1310452999 [label="[Конец.]",shape=box,color=red];
		j1310452999 -> "Chat ends.";
	j2030628594 [label="Мне он был известен как Cardinal Dimanche. Это тебя, возможно, удивит, сколько лет он служил в церкви, проповедуя нашей пастве.",shape=box,color=blue];
		j2030628594 -> j1157417839;
		j2030628594 -> j977248549;
	j650920214 [label="+5 Chemistry",color=orange];
		j650920214 -> j3859296743;
	"Chat ends." [color=orange];
	j1157417839 [label="По-твоему, это была всего лишь ложь? Или он действительно верил в это?",shape=box,color=red];
		j1157417839 -> j2357604632;
	j977248549 [label="Я не удивляюсь. Он искусный лжец.",shape=box,color=red];
		j977248549 -> j437223675;
	j3859296743 [label="Ах, очень вежливый вопрос, за которым скрывается очень сложный ответ - весьма искусно сформулировано, я должна признать.",shape=box,color=blue];
		j3859296743 -> j3573978103;
	j2357604632 [label="Он говорил о прощении, о семье и о сочувствии с таким рвением и преданностью, что я не знаю, как это могло быть притворством.",shape=box,color=blue];
		j2357604632 -> j3604883984;
	j437223675 [label="Я понимаю, что твой опыт с ним отличается от моего. Но ты также должна понять, что для меня он был только добрым и заботливым.",shape=box,color=blue];
		j437223675 -> j4143302652;
	j3573978103 [label="Я чувствую то же самое, что и в первый день, когда он читал проповедь с кафедры нашим прихожанам. Благословенно быть в его présence.",shape=box,color=blue];
		j3573978103 -> j1920636225;
		j3573978103 -> j155383434;
		j3573978103 -> j1310317355;
	j3604883984 [label="Сохранил ли он веру в Светил? В Сол и Луа? Этого я теперь не знаю, зная, откуда и когда он родом. Peu importe.",shape=box,color=blue];
		j3604883984 -> j2119440074;
	j4143302652 [label="Разве твои истины отменяют мои, или чьим я должна верить? Должна ли я осудить каждый акт милосердия, каждое проявление нежности, которое он проявил за годы, проведённые в приходе?",shape=box,color=blue];
		j4143302652 -> j3051074133;
	j1920636225 [label="Честно говоря, я преисполняюсь радости. Думаю, все слишком спешат его осуждать.",shape=box,color=red];
		j1920636225 -> j3140304449;
	j155383434 [label="Ты считаешь, он обманывал людей? Или всё же верил в то, что говорил?",shape=box,color=red];
		j155383434 -> j2357604632;
	j1310317355 [label="Мне жаль, что ты поддалась на его уловки.",shape=box,color=red];
		j1310317355 -> j437223675;
	j2119440074 [label="Какая разница, как зовут богов, которым ты молишься, если ты носишь их любовь в сердце? Никакой, я скажу.",shape=box,color=blue];
		j2119440074 -> j3313788131;
		j2119440074 -> j3891920654;
	j3051074133 [label="Non. Не думаю.",shape=box,color=blue];
		j3051074133 -> j3588049439;
	j3140304449 [label="+10 Chemistry",color=orange];
		j3140304449 -> j963099827;
	j3313788131 [label="Прекрасный взгляд на вещи. ",shape=box,color=red];
		j3313788131 -> j2140060444;
	j3891920654 [label="Не соглашусь. Быть добрым человеком не делает меня мгновенно последователем бога доброты.",shape=box,color=red];
		j3891920654 -> j3665082640;
	j3588049439 [label="Прости меня, но я не сделаю из него монстра только потому, что ты так говоришь.",shape=box,color=blue];
		j3588049439 -> j2209081154;
	j963099827 [label="Boolean MarieEntratiFan1 is now true.",color=orange];
		j963099827 -> j3467292941;
	j2140060444 [label="Я верю, что le Cardinal искренне верит в Светил в своей душе. Даже если он не верит, они ждут его в вечной жизни.",shape=box,color=blue];
		j2140060444 -> j510112223;
	j3665082640 [label="+5 Chemistry",color=orange];
		j3665082640 -> j1213119459;
	j2209081154 [label="Boolean MarieEntratiMonster1 is now true.",color=orange];
		j2209081154 -> "Chat ends.";
	j3467292941 [label="О! Как это радует моё сердце. Я боялась, что только я разделяю это мнение. Меня окружают только те, кто плохо думает о le Cardinal.",shape=box,color=blue];
		j3467292941 -> j1543476068;
		j3467292941 -> j3854567492;
		j3467292941 -> j174170800;
	j510112223 [label="Кто другой, как не он, знает цену сострадания перед лицом тьмы Безразличия, non?",shape=box,color=blue];
		j510112223 -> j2413258194;
	j1213119459 [label="Твоя правда, не записывает. Я не буду говорить, что ты следуешь за Сол просто потому, что ты неосознанно идёшь Его путём. Чем больше добра в мире, тем лучше мир, мне безразлично какое имя оно носит.",shape=box,color=blue];
		j1213119459 -> j2712955772;
	j1543476068 [label="Мне лишь хочется, чтобы все смогли простить его — он старается всё исправить.",shape=box,color=red];
		j1543476068 -> j2423270083;
	j3854567492 [label="У них есть свои причины. Но он наш единственный шанс остановить Безразличие.",shape=box,color=red];
		j3854567492 -> j3829304613;
	j174170800 [label="Энтрати и сам невысокого мнения о себе. ",shape=box,color=red];
		j174170800 -> j2819686977;
	j2413258194 [label="Check boolean DrifterFaithNoMITW",color=orange];
		j2413258194 -> j2300904849 [label=true,color=green];
		j2413258194 -> j3095235691 [label=false,color=brown];
	j2712955772 [label="И поэтому я верю, что le Cardinal благословен, даже если он на самом деле не придерживается тем именем веры, которое дала бы ей я.",shape=box,color=blue];
		j2712955772 -> j510112223;
	j2423270083 [label="Add 1 to Thermostat counter",color=orange];
		j2423270083 -> j1514348627;
	j3829304613 [label="Add -1 to Thermostat counter",color=orange];
		j3829304613 -> j4173778311;
	j2819686977 [label="Oui, et comme c'est tragique... у меня глаза на мокром месте при мысли об этом. И об одиночестве Monsieur Лойда, чья любовь не умолкает.",shape=box,color=blue];
		j2819686977 -> j821135791;
	j2300904849 [label="Прости, я забыла... ты не веришь, что твоё Indifférence реально. Это всего лишь галлюцинация. Но ты ведь веришь в эмоцию, которая она вызывает, oui?",shape=box,color=blue];
		j2300904849 -> j1148956292;
		j2300904849 -> j598080164;
	j3095235691 [label="Прекрасно, что он пришёл проповедовать послание в противовес тому, что он сам высвободил, n'est-ce pas?",shape=box,color=blue];
		j3095235691 -> j3395515078;
		j3095235691 -> j303234238;
		j3095235691 -> j2433943950;
	j1514348627 [label="Oui, и я также думаю, что это именно те искания, которые стоят перед нами.",shape=box,color=blue];
		j1514348627 -> j821135791;
	j4173778311 [label="Oui, но битву против l'Indifférence не выигрывают мечами и камнями. Её выигрывают сердцем, разве ты не видишь?",shape=box,color=blue];
		j4173778311 -> j821135791;
	j821135791 [label="Речь ведь не о прощении дьявола Орокин, non? Он хочет простить le Cardinal, это ясно. И я думаю, что вдохновляет на это именно любовь Monsieur Лойда.",shape=box,color=blue];
		j821135791 -> j1634060812;
	j1148956292 [label="Все эмоции имеют своё предназначение, даже безразличие.",shape=box,color=red];
		j1148956292 -> j2485456075;
	j598080164 [label="Да, так и есть. Мне довелось пасть жертвой этого в Дувири. Неконтролируемая мной апатия поглотила меня, пока она не стала всем, что осталось.",shape=box,color=red];
		j598080164 -> j3091643977;
	j3395515078 [label="Хотелось бы мне знать, как я могу помочь ему исправить эту проблему.",shape=box,color=red];
		j3395515078 -> j1502510264;
	j303234238 [label="Хотелось бы, чтобы у него был план получше, чем просто «проповедовать».",shape=box,color=red];
		j303234238 -> j1007222540;
	j2433943950 [label="Что ж, раз уж по его вине эта штука бесчинствует... то да. Это меньшее, что он мог сделать.",shape=box,color=red];
		j2433943950 -> j3528444944;
	j1634060812 [label="Это разрывает моё сердце. Больше всего я желаю увидеть, как они воссоединились!",shape=box,color=blue];
		j1634060812 -> j939390105;
		j1634060812 -> j2333406432;
	j2485456075 [label="Конечно, это служит определённой цели. Je ne le nie pas.",shape=box,color=blue];
		j2485456075 -> j1668739757;
	j3091643977 [label="+5 Chemistry",color=orange];
		j3091643977 -> j2663007667;
	j1502510264 [label="+5 Chemistry",color=orange];
		j1502510264 -> j1535756817;
	j1007222540 [label="И кто мы такие, чтобы судить о его методах? Cardinal Dimanche является гением, благословленный Светилами. Он будет направлять нас.",shape=box,color=blue];
		j1007222540 -> j1825209815;
		j1007222540 -> j1376065000;
	j3528444944 [label="Следи за своим тоном. Cardinal Dimanche является гением, благословленный Светилами. Он будет направлять нас.",shape=box,color=blue];
		j3528444944 -> j655407682;
		j3528444944 -> j1825209815;
		j3528444944 -> j1376065000;
	j939390105 [label="Я... думаю, что тут ещё вопрос и о Матери Матери, всё же... жене Энтрати.",shape=box,color=red];
		j939390105 -> j2589708661;
	j2333406432 [label="Я думаю, это лишь вопрос времени. ",shape=box,color=red];
		j2333406432 -> j980657451;
	j1668739757 [label="Я не виню тебя, ты знаешь.",shape=box,color=blue];
		j1668739757 -> j734809245;
		j1668739757 -> j4271191273;
	j2663007667 [label="Да, да — мне доводилось слышать, как другие говорили об этом мире, созданном тобою. Когда ты был совершенно одинок и не к кому было обратиться.",shape=box,color=blue];
		j2663007667 -> j1668739757;
	j1535756817 [label="Cardinal Dimanche является гением, благословленный Светилами. Он будет направлять нас.",shape=box,color=blue];
		j1535756817 -> j141640635;
		j1535756817 -> j1825209815;
		j1535756817 -> j1376065000;
	j1825209815 [label="Энтрати всего лишь человек, не более того. И он даже не Кардинал.",shape=box,color=red];
		j1825209815 -> j1819988593;
	j1376065000 [label="Думаешь, твоя вера в него разумна?",shape=box,color=red];
		j1376065000 -> j1986297819;
	j655407682 [label="Мне жаль. Я разделяю твою веру в него.",shape=box,color=red];
		j655407682 -> j3391524719;
	j2589708661 [label="Знаем ли мы, жива ли она? Или что с ней стало?",shape=box,color=blue];
		j2589708661 -> j2604743034;
		j2589708661 -> j3667693852;
	j980657451 [label="+5 Chemistry",color=orange];
		j980657451 -> j2822845447;
	j734809245 [label="Полагаю, это и есть твоя роль, не так ли? Прощать?",shape=box,color=red];
		j734809245 -> j405589888;
	j4271191273 [label="Винишь меня за что?",shape=box,color=red];
		j4271191273 -> j694969542;
	j141640635 [label="Я разделяю твою веру в него.",shape=box,color=red];
		j141640635 -> j1257834684;
	j1819988593 [label="Да. И ты ведь странствующее сквозь время создание, рождённое из Бездны, и можешь замыкать время и создавать целые миры из ткани бытия.",shape=box,color=blue];
		j1819988593 -> j1686722573;
	j1986297819 [label="Evaluate expressions",color=orange];
		j1986297819 -> j2950804933 [label="DrifterFaithYesSimilar",color=purple];
		j1986297819 -> j2950804933 [label="DrifterFaithYesForeign",color=purple];
		j1986297819 -> j2950804933 [label="DrifterFaithPersonal",color=purple];
		j1986297819 -> j2950804933 [label="DrifterFaithSol",color=purple];
		j1986297819 -> j2950804933 [label="DrifterFaithLua",color=purple];
		j1986297819 -> j2950804933 [label="DrifterFaithBalance",color=purple];
		j1986297819 -> j3253328455 [label="false",color=purple];
	j3391524719 [label="Я рада это слышать. Ведь я знаю, что на самом деле у тебя мало причин для этого. Я слышала истории от Кавий.",shape=box,color=blue];
		j3391524719 -> j879010410;
	j2604743034 [label="Мы можем... хотя, скорее всего, предположат, что она мертва.",shape=box,color=red];
		j2604743034 -> j3744720608;
	j3667693852 [label="Нет, и, кажется, никто не желает говорить о ней.",shape=box,color=red];
		j3667693852 -> j3744720608;
	j2822845447 [label="Мы должны сохранить веру. Ведь если мы утратим надежду на то, что любовь преобладает над всем, тьма возьмёт верх.",shape=box,color=blue];
		j2822845447 -> j920912698;
	j405589888 [label="Думаю, ты удивишься, узнав, насколько в этом мало моей заслуги. ",shape=box,color=blue];
		j405589888 -> j3350804312;
	j694969542 [label="За отсутствие веры. В l'Indifférence. Вовсе ни во что. Если бы я создала мир du tissu du Néant - из ткани Бездны - пожалуй, я чувствовала бы то же самое.",shape=box,color=blue];
		j694969542 -> j3350804312;
	j1257834684 [label="+5 Chemistry",color=orange];
		j1257834684 -> j3391524719;
	j1686722573 [label="Я стою рядом с дьяволом, живущим на протяжении бесчисленных столетий. Неподалёку от меня стоит женщина, которая сама по себе является машиной, наделённой душой тройственной богини.",shape=box,color=blue];
		j1686722573 -> j2337566383;
	j2950804933 [label="Хах! Кому как не тебе следует знать, что вера никогда не бывает мудрой. И всё же такие души, как наши, всё равно несут её в себе, хотя она может нас и обжечь. Полагаю, ты это знаешь, если наша предыдущая беседа была правдой.",shape=box,color=blue];
		j2950804933 -> j1962762147;
		j2950804933 -> j1855941343;
	j3253328455 [label="Вера никогда не бывает разумной. Но те из нас, кто несёт её, как факел, стремятся нести её всегда — хоть это и может обжечь нас.",shape=box,color=blue];
		j3253328455 -> j3794460354;
	j879010410 [label="Boolean MarieEntratiFan1 is now true.",color=orange];
		j879010410 -> j1185699525;
	j3744720608 [label="А тебе не приходила мысль когда-нибудь о том, что сердце одного может принадлежать не одной душе, а нескольким? Что один человек может любить больше, чем одного?",shape=box,color=blue];
		j3744720608 -> j3279832871;
		j3744720608 -> j1791413346;
	j920912698 [label="Ведь только любовь остаётся у нас в этом мире, когда всё остальное рушится, non?",shape=box,color=blue];
		j920912698 -> j216470712;
	j3350804312 [label="Высшее прощение не то, что следует искать у других или даже у Светил.",shape=box,color=blue];
		j3350804312 -> j1524635403;
		j3350804312 -> j3788265601;
	j2337566383 [label="Мой брат слышит голоса мёртвых и самих богов.",shape=box,color=blue];
		j2337566383 -> j2141778574;
	j1962762147 [label="Порой задаюсь вопросом, не глупо ли тащить в себе то, что способно причинить мне боль.",shape=box,color=red];
		j1962762147 -> j1298846291;
	j1855941343 [label="Порой задаюсь вопросом, зачем мы вообще это несём.",shape=box,color=red];
		j1855941343 -> j1310759687;
	j3794460354 [label="Тогда зачем его вообще нести, мне любопытно?",shape=box,color=red];
		j3794460354 -> j3376167199;
	j1185699525 [label="Evaluate expressions",color=orange];
		j1185699525 -> j1136555465 [label="DrifterFaithYesSimilar",color=purple];
		j1185699525 -> j1136555465 [label="DrifterFaithYesForeign",color=purple];
		j1185699525 -> j1136555465 [label="DrifterFaithPersonal",color=purple];
		j1185699525 -> j1136555465 [label="DrifterFaithSol",color=purple];
		j1185699525 -> j1136555465 [label="DrifterFaithLua",color=purple];
		j1185699525 -> j1136555465 [label="DrifterFaithBalance",color=purple];
		j1185699525 -> j3398946604 [label="DrifterFaithAgnostic",color=purple];
		j1185699525 -> j3779048842 [label="DrifterFaithNoFear",color=purple];
		j1185699525 -> j3398946604 [label="DrifterFaithNoMaybe",color=purple];
		j1185699525 -> j814724095 [label="false",color=purple];
	j3279832871 [label="Лично мне — нет.",shape=box,color=red];
		j3279832871 -> j3365281761;
	j1791413346 [label="Да, приходило, если бы все стороны были согласны с этим. ",shape=box,color=red];
		j1791413346 -> j359023331;
	j216470712 [label="Ах! Но ты здесь ради историй! Я отняла столько твоего времени так, что я буду кратка.",shape=box,color=blue];
		j216470712 -> j4035765841;
	j1524635403 [label="Интересно. Почему ты так говоришь?",shape=box,color=red];
		j1524635403 -> j531046271;
	j3788265601 [label="Даже если тобою было причинено зло кому-то другому?",shape=box,color=red];
		j3788265601 -> j1629977241;
	j2141778574 [label="Я прервала свой пост в компании зверей, которые поинтересовались качеством моего отдыха.",shape=box,color=blue];
		j2141778574 -> j1281623591;
	j1298846291 [label="Add 1 to Thermostat counter",color=orange];
		j1298846291 -> j1369602719;
	j1310759687 [label="Add -1 to Thermostat counter",color=orange];
		j1310759687 -> j4063298968;
	j3376167199 [label="Мы несём это, потому что мы должны. Потому что мы не знаем другого способа существовать. Неважно, что это значит, в конце концов. Мне известно, каково тебе.",shape=box,color=blue];
		j3376167199 -> j2212283992;
	j1136555465 [label="Вера для таких душ, как наши, подобна факелу — мы несём его всегда, хоть он и может сжечь нас в конце концов.",shape=box,color=blue];
		j1136555465 -> j1855941343;
		j1136555465 -> j1962762147;
	j3398946604 [label="Хоть это и удивительно, ранее в тебе выражалось сомнение в вере.",shape=box,color=blue];
		j3398946604 -> j3022288831;
		j3398946604 -> j2063365737;
	j3779048842 [label="Хоть это и удивительно. Ранее в тебе выражалось создание маловерное.",shape=box,color=blue];
		j3779048842 -> j3022288831;
		j3779048842 -> j2063365737;
	j814724095 [label="Вера для таких душ, как моя, подобна факелу - мы несём его всегда, хоть он и может сжечь нас в конце концов.",shape=box,color=blue];
		j814724095 -> j3794460354;
	j3365281761 [label="Boolean DrifterPNo is now true.",color=orange];
		j3365281761 -> j870067703;
	j359023331 [label="Boolean DrifterPYes is now true.",color=orange];
		j359023331 -> j870067703;
	j4035765841 [label="Это был прекрасный, солнечный день. Я помню, как он стоял перед алтарём, глядя на витражи с улыбкой, хотя я не понимала, почему.",shape=box,color=blue];
		j4035765841 -> j1866802043;
	j531046271 [label="Стремление исправить причинённый вред — важно, не пойми меня неправильно. Там, где это вообще возможно, получить прощение от тех, кого ранил — это бальзам на душу.",shape=box,color=blue];
		j531046271 -> j3281829690;
	j1629977241 [label="Ох, я вовсе не хочу сказать, что это неважно искать прощения у тех, кому причинил боль! Это важно!",shape=box,color=blue];
		j1629977241 -> j4194855242;
	j1281623591 [label="Расскажи мне еще раз о тех, кто «просто люди», и я постараюсь изо всех сил не расхохотаться, даю тебе слово.",shape=box,color=blue];
		j1281623591 -> j1573637906;
	j1369602719 [label="Мы несём это, потому что мы должны. Потому что мы не знаем другого способа существовать. Неважно, что это значит, в конце концов. Мне известно каково тебе.",shape=box,color=blue];
		j1369602719 -> j2212283992;
	j4063298968 [label="Вера не постоянна. Она как прилив. Она приходит и уходит, и это нормально.",shape=box,color=blue];
		j4063298968 -> j2212283992;
	j2212283992 [label="Но, боюсь, всё это не о том, ради чего здесь ты хочешь поговорить со мной. Тебе нужна история, non?",shape=box,color=blue];
		j2212283992 -> j4035765841;
	j3022288831 [label="Я могу по-разному верить в людей и богов.",shape=box,color=red];
		j3022288831 -> j2406698963;
	j2063365737 [label="Есть разница между верой в богов и верой в людей. А Энтрати - это просто человек.",shape=box,color=red];
		j2063365737 -> j1819988593;
	j870067703 [label="Интересно. Я недостаточно хорошо знаю обычаи Орокин, чтобы понять, противоречило ли это их обычаям. Но я знаю, что во многих древних культурах это не осуждалось.",shape=box,color=blue];
		j870067703 -> j825793759;
	j1866802043 [label="Он низко наклонился, чтобы поприветствовать меня, сидящую в кресле, так что его голова оказалась ниже моей.",shape=box,color=blue];
		j1866802043 -> j855846236;
	j3281829690 [label="В итоге, когда мы встретимся лицом к лицу со Старухой, когда Луа прольет за нас свои серебряные слезы и смерть будет близка, вот тогда нам предстоит нести тяжесть собственного сердца.",shape=box,color=blue];
		j3281829690 -> j3502773246;
		j3281829690 -> j1470315814;
	j4194855242 [label="Загладить причинённый вред, который кто-то мог бы причинить, — это ещё более сильный бальзам на душу.",shape=box,color=blue];
		j4194855242 -> j3281829690;
	j1573637906 [label="До тех пор я советую тебе ещё раз переосмыслить, что значит быть благословлённым. Прощай.",shape=box,color=blue];
		j1573637906 -> "Chat ends.";
	j2406698963 [label="Oui, одни из них вполне осязаемы. Присутствуют. Другие требует закрыть глаза и поверить. ",shape=box,color=blue];
		j2406698963 -> j2212283992;
	j825793759 [label="Но вряд ли нам решать... в данном случае я здесь не для того, чтобы осуждать признания le Cardinal в любви к Monsieur Лойду или о словах любви, что произнёс в ответ M. Лойд.",shape=box,color=blue];
		j825793759 -> j618720980;
	j855846236 [label="Boolean MarieEntrati1 is now true.",color=orange];
		j855846236 -> j3058273487;
		j855846236 -> j2905422451;
		j855846236 -> j1824818120;
	j3502773246 [label="Если тебе нужно простить себя или других, чтобы умереть с «миром», пусть будет так. Мне нет.",shape=box,color=red];
		j3502773246 -> j3391972448;
	j1470315814 [label="В конце концов, если все остальные простят тебя, но ты не простишь себя? Значит, тебя не простил никто.",shape=box,color=red];
		j1470315814 -> j1171454843;
	j618720980 [label="Я могу считать их лишь искренними. Кто я, чтобы утверждать, что они ложны?",shape=box,color=blue];
		j618720980 -> j920912698;
	j3058273487 [label="Он может быть по-настоящему хитрым и склонным к манипуляциям, Мари.",shape=box,color=red];
		j3058273487 -> j2899515025;
	j2905422451 [label="Он был добр к тебе, в отличие от других?",shape=box,color=red];
		j2905422451 -> j2899515025;
	j1824818120 [label="Как бы Лион рассказал эту историю?",shape=box,color=red];
		j1824818120 -> j1370283704;
	j3391972448 [label="+5 Chemistry",color=orange];
		j3391972448 -> j3219220611;
	j1171454843 [label="+5 Chemistry",color=orange];
