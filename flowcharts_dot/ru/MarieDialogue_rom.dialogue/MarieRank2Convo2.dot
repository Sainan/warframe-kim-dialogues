digraph {
	418 [label="MarieRank2Convo2 begins.",color=orange];
		418 -> 421;
		418 -> 420;
		418 -> 419;
	421 [label="Как ты познакомилась с Энтрати?",shape=box,color=red];
		421 -> 424;
	420 [label="Позволь мне спросить, как ты относишься к Энтрати теперь, когда ты здесь?",shape=box,color=red];
		420 -> 423;
	419 [label="[Конец.]",shape=box,color=red];
		419 -> 422;
	424 [label="Мне он был известен как Cardinal Dimanche. Это тебя, возможно, удивит, сколько лет он служил в церкви, проповедуя нашей пастве.",shape=box,color=blue];
		424 -> 426;
		424 -> 427;
	423 [label="+5 Chemistry",color=orange];
		423 -> 425;
	422 [label="Chat ends.",color=orange];
	426 [label="По-твоему, это была всего лишь ложь? Или он действительно верил в это?",shape=box,color=red];
		426 -> 429;
	427 [label="Я не удивляюсь. Он искусный лжец.",shape=box,color=red];
		427 -> 430;
	425 [label="Ах, очень вежливый вопрос, за которым скрывается очень сложный ответ - весьма искусно сформулировано, я должна признать.",shape=box,color=blue];
		425 -> 428;
	429 [label="Он говорил о прощении, о семье и о сочувствии с таким рвением и преданностью, что я не знаю, как это могло быть притворством.",shape=box,color=blue];
		429 -> 434;
	430 [label="Я понимаю, что твой опыт с ним отличается от моего. Но ты также должна понять, что для меня он был только добрым и заботливым.",shape=box,color=blue];
		430 -> 435;
	428 [label="Я чувствую то же самое, что и в первый день, когда он читал проповедь с кафедры нашим прихожанам. Благословенно быть в его présence.",shape=box,color=blue];
		428 -> 431;
		428 -> 432;
		428 -> 433;
	434 [label="Сохранил ли он веру в Светил? В Сол и Луа? Этого я теперь не знаю, зная, откуда и когда он родом. Peu importe.",shape=box,color=blue];
		434 -> 437;
	435 [label="Разве твои истины отменяют мои, или чьим я должна верить? Должна ли я осудить каждый акт милосердия, каждое проявление нежности, которое он проявил за годы, проведённые в приходе?",shape=box,color=blue];
		435 -> 438;
	431 [label="Честно говоря, я преисполняюсь радости. Думаю, все слишком спешат его осуждать.",shape=box,color=red];
		431 -> 436;
	432 [label="Ты считаешь, он обманывал людей? Или всё же верил в то, что говорил?",shape=box,color=red];
		432 -> 429;
	433 [label="Мне жаль, что ты поддалась на его уловки.",shape=box,color=red];
		433 -> 430;
	437 [label="Какая разница, как зовут богов, которым ты молишься, если ты носишь их любовь в сердце? Никакой, я скажу.",shape=box,color=blue];
		437 -> 440;
		437 -> 441;
	438 [label="Non. Не думаю.",shape=box,color=blue];
		438 -> 442;
	436 [label="+10 Chemistry",color=orange];
		436 -> 439;
	440 [label="Прекрасный взгляд на вещи. ",shape=box,color=red];
		440 -> 444;
	441 [label="Не соглашусь. Быть добрым человеком не делает меня мгновенно последователем бога доброты.",shape=box,color=red];
		441 -> 445;
	442 [label="Прости меня, но я не сделаю из него монстра только потому, что ты так говоришь.",shape=box,color=blue];
		442 -> 446;
	439 [label="Update boolean MarieEntratiFan1",color=orange];
		439 -> 443;
	444 [label="Я верю, что le Cardinal искренне верит в Светил в своей душе. Даже если он не верит, они ждут его в вечной жизни.",shape=box,color=blue];
		444 -> 450;
	445 [label="+5 Chemistry",color=orange];
		445 -> 451;
	446 [label="Update boolean MarieEntratiMonster1",color=orange];
		446 -> 452;
	443 [label="О! Как это радует моё сердце. Я боялась, что только я разделяю это мнение. Меня окружают только те, кто плохо думает о le Cardinal.",shape=box,color=blue];
		443 -> 447;
		443 -> 448;
		443 -> 449;
	450 [label="Кто другой, как не он, знает цену сострадания перед лицом тьмы Безразличия, non?",shape=box,color=blue];
		450 -> 456;
	451 [label="Твоя правда, не записывает. Я не буду говорить, что ты следуешь за Сол просто потому, что ты неосознанно идёшь Его путём. Чем больше добра в мире, тем лучше мир, мне безразлично какое имя оно носит.",shape=box,color=blue];
		451 -> 457;
	452 [label="Chat ends.",color=orange];
	447 [label="Мне лишь хочется, чтобы все смогли простить его — он старается всё исправить.",shape=box,color=red];
		447 -> 453;
	448 [label="У них есть свои причины. Но он наш единственный шанс остановить Безразличие.",shape=box,color=red];
		448 -> 454;
	449 [label="Энтрати и сам невысокого мнения о себе. ",shape=box,color=red];
		449 -> 455;
	456 [label="Check boolean DrifterFaithNoMITW",color=orange];
		456 -> 462 [label=true,color=green];
		456 -> 461 [label=false,color=brown];
	457 [label="И поэтому я верю, что le Cardinal благословен, даже если он на самом деле не придерживается тем именем веры, которое дала бы ей я.",shape=box,color=blue];
		457 -> 450;
	453 [label="Add 1 to Thermostat",color=orange];
		453 -> 458;
	454 [label="Add -1 to Thermostat",color=orange];
		454 -> 459;
	455 [label="Oui, et comme c'est tragique... у меня глаза на мокром месте при мысли об этом. И об одиночестве Monsieur Лойда, чья любовь не умолкает.",shape=box,color=blue];
		455 -> 460;
	462 [label="Прости, я забыла... ты не веришь, что твоё Indifférence реально. Это всего лишь галлюцинация. Но ты ведь веришь в эмоцию, которая она вызывает, oui?",shape=box,color=blue];
		462 -> 467;
		462 -> 468;
	461 [label="Прекрасно, что он пришёл проповедовать послание в противовес тому, что он сам высвободил, n'est-ce pas?",shape=box,color=blue];
		461 -> 464;
		461 -> 465;
		461 -> 466;
	458 [label="Oui, и я также думаю, что это именно те искания, которые стоят перед нами.",shape=box,color=blue];
		458 -> 460;
	459 [label="Oui, но битву против l'Indifférence не выигрывают мечами и камнями. Её выигрывают сердцем, разве ты не видишь?",shape=box,color=blue];
		459 -> 460;
	460 [label="Речь ведь не о прощении дьявола Орокин, non? Он хочет простить le Cardinal, это ясно. И я думаю, что вдохновляет на это именно любовь Monsieur Лойда.",shape=box,color=blue];
		460 -> 463;
	467 [label="Все эмоции имеют своё предназначение, даже безразличие.",shape=box,color=red];
		467 -> 474;
	468 [label="Да, так и есть. Мне довелось пасть жертвой этого в Дувири. Неконтролируемая мной апатия поглотила меня, пока она не стала всем, что осталось.",shape=box,color=red];
		468 -> 475;
	464 [label="Хотелось бы мне знать, как я могу помочь ему исправить эту проблему.",shape=box,color=red];
		464 -> 471;
	465 [label="Хотелось бы, чтобы у него был план получше, чем просто «проповедовать».",shape=box,color=red];
		465 -> 472;
	466 [label="Что ж, раз уж по его вине эта штука бесчинствует... то да. Это меньшее, что он мог сделать.",shape=box,color=red];
		466 -> 473;
	463 [label="Это разрывает моё сердце. Больше всего я желаю увидеть, как они воссоединились!",shape=box,color=blue];
		463 -> 469;
		463 -> 470;
	474 [label="Конечно, это служит определённой цели. Je ne le nie pas.",shape=box,color=blue];
		474 -> 482;
	475 [label="+5 Chemistry",color=orange];
		475 -> 483;
	471 [label="+5 Chemistry",color=orange];
		471 -> 478;
	472 [label="И кто мы такие, чтобы судить о его методах? Cardinal Dimanche является гением, благословленный Светилами. Он будет направлять нас.",shape=box,color=blue];
		472 -> 479;
		472 -> 480;
	473 [label="Следи за своим тоном. Cardinal Dimanche является гением, благословленный Светилами. Он будет направлять нас.",shape=box,color=blue];
		473 -> 481;
		473 -> 479;
		473 -> 480;
	469 [label="Я... думаю, что тут ещё вопрос и о Матери Матери, всё же... жене Энтрати.",shape=box,color=red];
		469 -> 476;
	470 [label="Я думаю, это лишь вопрос времени. ",shape=box,color=red];
		470 -> 477;
	482 [label="Я не виню тебя, ты знаешь.",shape=box,color=blue];
		482 -> 491;
		482 -> 492;
	483 [label="Да, да — мне доводилось слышать, как другие говорили об этом мире, созданном тобою. Когда ты был совершенно одинок и не к кому было обратиться.",shape=box,color=blue];
		483 -> 482;
	478 [label="Cardinal Dimanche является гением, благословленный Светилами. Он будет направлять нас.",shape=box,color=blue];
		478 -> 487;
		478 -> 479;
		478 -> 480;
	479 [label="Энтрати всего лишь человек, не более того. И он даже не Кардинал.",shape=box,color=red];
		479 -> 488;
	480 [label="Думаешь, твоя вера в него разумна?",shape=box,color=red];
		480 -> 489;
	481 [label="Мне жаль. Я разделяю твою веру в него.",shape=box,color=red];
		481 -> 490;
	476 [label="Знаем ли мы, жива ли она? Или что с ней стало?",shape=box,color=blue];
		476 -> 484;
		476 -> 485;
	477 [label="+5 Chemistry",color=orange];
		477 -> 486;
	491 [label="Полагаю, это и есть твоя роль, не так ли? Прощать?",shape=box,color=red];
		491 -> 500;
