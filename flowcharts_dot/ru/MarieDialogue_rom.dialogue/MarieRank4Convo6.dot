	1829 [label="Я буду продолжать пытаться.",shape=box,color=red];
		1829 -> 1831;
	1830 [label="Я лишь надеюсь, что это не разорвёт его на куски.",shape=box,color=red];
		1830 -> 1832;
	1831 [label="+10 Chemistry",color=orange];
		1831 -> 1833;
	1832 [label="+5 Chemistry",color=orange];
		1832 -> 1834;
	1833 [label="В конце концов, это всё, что мы можем сделать.",shape=box,color=blue];
		1833 -> 1835;
	1834 [label="Oui... и я тоже. Но всё, что мы можем сделать, это стоять рядом с ним и молиться, non?",shape=box,color=blue];
		1834 -> 1836;
	1835 [label="Продолжать пробовать. И молиться.",shape=box,color=blue];
