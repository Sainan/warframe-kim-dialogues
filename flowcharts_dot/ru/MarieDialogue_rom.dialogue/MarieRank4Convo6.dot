		1836 -> 1837;
	1837 [label="Merci... Мне нужно идти. Прости, если эта беседа была бесполезна. Я волнуюсь, когда не могу действовать.",shape=box,color=blue];
		1837 -> 1838;
		1837 -> 1839;
	1838 [label="То же самое и со мной. Но порой действие бывает неверным выбором.",shape=box,color=red];
