		1789 -> 1795 [label="LyonRell1",color=purple];
		1789 -> 1796 [label="false",color=purple];
	1790 [label="В этом и проблема с подобными как Энтрати. Они не воплощают лишь «Добро» или «Зло». Они смесь.",shape=box,color=red];
		1790 -> 1799;
	1791 [label="Давай оставим этот разговор о le Cardinal в стороне, oui? Я беспокоюсь за брата моей души.",shape=box,color=blue];
		1791 -> 1781;
	1792 [label="Я тоже так не думаю, но факт остаётся фактом, oui? Но я ценю твои чувства. Cela dit...",shape=box,color=blue];
		1792 -> 1791;
	3962 [label="Update boolean DrifterMarie",color=orange];
		3962 -> 3963;
	1793 [label="Лион пытается смириться с тем фактом, что Безразличие это не настоящий бог.",shape=box,color=red];
		1793 -> 1800;
	1795 [label="Я не думаю, что это связано только с чем-то одним. Я думаю, что это происходит из-за множества факторов.",shape=box,color=red];
		1795 -> 1802;
	1797 [label="Лион услышал голос одного из Тэнно, парня по имени Рэлл. Рэлл... погиб. Я не думаю, что он хорошо с этим справляется.",shape=box,color=red];
		1797 -> 1804;
	1798 [label="У него есть Роут, который нашёптывает ему ложь о Человеке в стене.",shape=box,color=red];
		1798 -> 1805;
	1794 [label="Я не могу себе представить, чтобы Энтрати нашёптывал ему, что голоса его богов на самом деле являются голосами из Бездны.",shape=box,color=red];
		1794 -> 1801;
	1796 [label="Честно говоря, я не знаю, нет.",shape=box,color=red];
		1796 -> 1803;
	1799 [label="Давай оставим этот разговор о le Cardinal в стороне, oui? Я беспокоюсь за брата моей души. Но... Я знаю, то, что ты говоришь... всё больше и больше становится чистой правдой.",shape=box,color=blue];
		1799 -> 1806;
	3963 [label="Do not think I do not see what you did, sneaking yourself in there first, wolf.",shape=box,color=blue];
		3963 -> 1799;
	1800 [label="И ты ничем не поможешь по этому поводу, если ты будешь говаривать с ним таким образом. Даже если твои слова правдивы, ты тебе надо проявлять осторожность в том, как они преподносятся.",shape=box,color=blue];
		1800 -> 1807;
	1802 [label="Oui, он был убежищем во время бури для многих... и вот теперь он сам попал в такую же бурю.",shape=box,color=blue];
		1802 -> 1809;
	1804 [label="Я слышала, как он произносил это имя, Рэлл - и знания о судьбе мальчика разбивают моё сердце.",shape=box,color=blue];
		1804 -> 1811;
	1805 [label="За свою долгую жизнь этот дьявол причинил больше горя, чем многие другие! Но я не думаю, что это единственная причина его раздоров, non?",shape=box,color=blue];
		1805 -> 1812;
	1801 [label="S'il te plaît, больше никаких разговоров о le Cardinal. Я не отрицаю, что его слова усугубляют раздор в Лионе, но это не может быть единственной причиной.",shape=box,color=blue];
		1801 -> 1808;
	1803 [label="Тогда, я полагаю... всё, что мы можем сделать, это лишь запастись терпением и надеяться, что со временем выясним, что его беспокоит.",shape=box,color=blue];
		1803 -> 1810;
	1806 [label="Update boolean MarieEntrati4a",color=orange];
		1806 -> 1781;
	1807 [label="Хирургическое вмешательство лучше всего не проводить топором. Это же не британский флот.",shape=box,color=blue];
		1807 -> 1813;
	1809 [label="Разрываемый со всех сторон, и не ведая, по какому пути идти...",shape=box,color=blue];
		1809 -> 1815;
		1809 -> 1816;
	1811 [label="Но я не думаю, что это единственная причина его смуты? Лион следует путём Луа. La mort est une compagne qui marche à ses côtés",shape=box,color=blue];
		1811 -> 1813;
	1812 [label="Это усилило его неуверенность… Но придавать столько значения словам какого-то дьявола? Мой Лион лучше этого. Я думаю, что сейчас его тяготит сразу многое.",shape=box,color=blue];
		1812 -> 1818;
		1812 -> 1819;
	1808 [label="Update boolean MarieEntrati4b",color=orange];
		1808 -> 1814;
	1810 [label="+15 Chemistry",color=orange];
		1810 -> 1817;
	1813 [label="Non, я думаю, что сейчас его тяготит многое.",shape=box,color=blue];
		1813 -> 1818;
		1813 -> 1819;
	1815 [label="Тогда мы должны стать для него убежищем. Местом, о котором он знает, что ему не причинят тут боль.",shape=box,color=red];
		1815 -> 1820;
	1816 [label="Тогда нам необходимо показать ему путь обратно в безопасное место. Станем светом во тьме.",shape=box,color=red];
		1816 -> 1821;
	1818 [label="Тогда, наверное... нам необходимо показать ему путь обратно в безопасное место. Станем светом во тьме.",shape=box,color=red];
		1818 -> 1821;
	1819 [label="Тогда, наверное... мы должны стать для него убежищем. Местом, о котором он знает, что ему не причинят тут боль.",shape=box,color=red];
		1819 -> 1823;
	1814 [label="Он не придал достаточного значения словам le Cardinal, чтобы позволить им погрузить его в такую тьму. Я думаю, что сейчас его тяготит многое.",shape=box,color=blue];
		1814 -> 1819;
		1814 -> 1818;
	1817 [label="Спасибо. Я знаю, что ты стараешься изо всех сил. И за это, я очень тебе благодарна.",shape=box,color=blue];
		1817 -> 1822;
	1820 [label="+10 Chemistry",color=orange];
		1820 -> 1824;
	1821 [label="Как ты можешь помочь тому, кто не слышит твоего зова, не может видеть твоего света? Non, Луа окутала его этой тьмой.",shape=box,color=blue];
		1821 -> 1825;
	1823 [label="+5 Chemistry",color=orange];
		1823 -> 1824;
	1822 [label="Chat ends.",color=orange];
	1824 [label="Oui, пожалуй, ты прав. Нам надлежит быть теми, к кому он сможет обратиться, когда всё иное оставит его.",shape=box,color=blue];
		1824 -> 1826;
	1825 [label="Я не думаю, что даже свет Сол мог бы проникнуть сквозь вуаль.",shape=box,color=blue];
		1825 -> 1826;
	1826 [label="Там, где вера его слабеет, нам надлежит быть твёрдым основанием под его стопами. ",shape=box,color=blue];
		1826 -> 1827;
	1827 [label="Если все невидимые голоса превратились из доброжелательных фантомов в демонов в тени, которые мучают его...",shape=box,color=blue];
		1827 -> 1828;
	1828 [label="Мы должны сделать себя ещё более реальными, non?",shape=box,color=blue];
		1828 -> 1829;
