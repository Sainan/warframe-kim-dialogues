		1761 -> 1764 [label=false,color=brown];
	1762 [label="Он взрослый. Сам решит, когда захочет поговорить.",shape=box,color=red];
		1762 -> 1766;
	1763 [label="Моё сердце разрывается, когда я вижу, как он переживает эту боль. Я не знаю, как ему помочь.",shape=box,color=red];
		1763 -> 1767;
	1764 [label="[Конец.]",shape=box,color=red];
		1764 -> 1768;
	1765 [label="Я не знаю, как ему помочь.",shape=box,color=red];
		1765 -> 1769;
	1766 [label="Когда тебя поймали в ловушку в этом мире, созданной тобой самим, в бесконечном круговороте смертей, была ли у вас помощь, чтобы спастись?",shape=box,color=blue];
		1766 -> 1770;
		1766 -> 1771;
	1767 [label="Oui, и это больно смотреть, как он страдает... Особенно теперь, зная, сколько места в твоём сердце ты для него освободила.",shape=box,color=blue];
		1767 -> 1769;
	1768 [label="Chat ends.",color=orange];
	1769 [label="Это трудно предсказать, где проходят его границы. Они часто меняются день ото дня.",shape=box,color=blue];
		1769 -> 1772;
	1770 [label="Никакая их помощь не имела бы смысла, если бы это не было бы моим желанием, чтобы мне помогли.",shape=box,color=red];
		1770 -> 1773;
		1770 -> 1774;
	1771 [label="Да, друзьям.",shape=box,color=red];
		1771 -> 1773;
		1771 -> 1774;
	1772 [label="Я видела, как он борется с муками, которые боги обрушили на его плечи. Я знала, когда нужно молчать рядом с ним, а когда стать пресловутой стеной, по которой он может колотить кулаками.",shape=box,color=blue];
		1772 -> 1775;
	1773 [label="Я не думаю, что Лион нуждается в моей помощи.",shape=box,color=red];
		1773 -> 1776;
	1774 [label="Я пытаюсь поддерживать его, но он не слушает.",shape=box,color=red];
		1774 -> 1777;
	1775 [label="Mais ça? Это? Это место, слова дьявола, неуверенность, которую вызвал le Cardinal... Это принесло ему боль, от которой я молюсь, чтобы он смог оправиться.",shape=box,color=blue];
		1775 -> 1778;
		1775 -> 1779;
	1776 [label="Тогда, я полагаю... ничего не остаётся, но как набраться терпения, non?",shape=box,color=blue];
		1776 -> 1780;
	1777 [label="Также и мне, поэтому я здесь, что обсудить это с тобой. Я всегда могла его утешить...",shape=box,color=blue];
		1777 -> 1781;
	1778 [label="Так, ты признаёшь, что Энтрати причинил боль Лиону? И как ты к этому относишься?",shape=box,color=red];
		1778 -> 1782;
	1779 [label="Мне кажется, он балансирует на краю пропасти. Как мне помочь вернуть его обратно?",shape=box,color=red];
		1779 -> 1783;
	1780 [label="Merci. Прости меня, что отняла у тебя время.",shape=box,color=blue];
		1780 -> 1784;
	1781 [label="Я ошеломлена его яростью, его désespoir... он избегает моего общества так, как никогда прежде.",shape=box,color=blue];
		1781 -> 1785;
	1782 [label="Pas bien... Но как мне выбрать между моей любовью к брату и моим обожанием le Cardinal? Как я должна выбрить между моей famille?",shape=box,color=blue];
		1782 -> 1786;
		1782 -> 1787;
		1782 -> 1788;
		1782 -> 3961;
	1783 [label="Я не знаю, поэтому я здесь, что обсудить это с тобой. Я всегда могла его утешить...",shape=box,color=blue];
		1783 -> 1781;
	1784 [label="Chat ends.",color=orange];
	1785 [label="Что его так беспокоит? Тебе известна причина?",shape=box,color=blue];
		1785 -> 1789;
	1786 [label="У тебя нет нужды выбирать, Мари. Люди могут быть сложны в том, какое место они занимают в нашей жизни.",shape=box,color=red];
		1786 -> 1790;
	1787 [label="Мне хотелось бы выбрать ту семью, которая ещё здесь. Не ту, которая тебя оставила.",shape=box,color=red];
		1787 -> 1791;
	1788 [label="У меня есть уверенность, что Энтрати не хотел причинять Лиону такую боль.",shape=box,color=red];
		1788 -> 1792;
	3961 [label="You could choose a new family. Like me. And those around you who care, without Entrati.",shape=box,color=red];
		3961 -> 3962;
	1789 [label="Evaluate expressions",color=orange];
		1789 -> 1793 [label="DrifterFaithNoMITW",color=purple];
