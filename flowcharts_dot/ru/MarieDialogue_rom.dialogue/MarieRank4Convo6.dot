digraph {
	"MarieRank4Convo6 begins." [color=orange];
		"MarieRank4Convo6 begins." -> j3023286837;
	j3023286837 [label="Check boolean LyonIndifference1",color=orange];
		j3023286837 -> j3998956483 [label=true,color=green];
		j3023286837 -> "Chat ends." [label=false,color=brown];
	j3998956483 [label="Скиталец? У тебя есть минутка? Мне нужно поговорить с тобой о Лионе...",shape=box,color=blue];
		j3998956483 -> j1531216646;
	"Chat ends." [color=orange];
	j1531216646 [label="Check boolean DrifterLyon",color=orange];
		j1531216646 -> j571594843 [label=true,color=green];
		j1531216646 -> j2393020978 [label=true,color=green];
		j1531216646 -> j1310452999 [label=true,color=green];
		j1531216646 -> j571594843 [label=false,color=brown];
		j1531216646 -> j3001905979 [label=false,color=brown];
		j1531216646 -> j1310452999 [label=false,color=brown];
	j571594843 [label="Он взрослый. Сам решит, когда захочет поговорить.",shape=box,color=red];
		j571594843 -> j1440388672;
	j2393020978 [label="Моё сердце разрывается, когда я вижу, как он переживает эту боль. Я не знаю, как ему помочь.",shape=box,color=red];
		j2393020978 -> j2782383507;
	j1310452999 [label="[Конец.]",shape=box,color=red];
		j1310452999 -> "Chat ends.";
	j3001905979 [label="Я не знаю, как ему помочь.",shape=box,color=red];
		j3001905979 -> j2392430908;
	j1440388672 [label="Когда тебя поймали в ловушку в этом мире, созданной тобой самим, в бесконечном круговороте смертей, была ли у вас помощь, чтобы спастись?",shape=box,color=blue];
		j1440388672 -> j3883550239;
		j1440388672 -> j176691932;
	j2782383507 [label="Oui, и это больно смотреть, как он страдает... Особенно теперь, зная, сколько места в твоём сердце ты для него освободила.",shape=box,color=blue];
		j2782383507 -> j2392430908;
	j2392430908 [label="Это трудно предсказать, где проходят его границы. Они часто меняются день ото дня.",shape=box,color=blue];
		j2392430908 -> j1117652423;
	j3883550239 [label="Никакая их помощь не имела бы смысла, если бы это не было бы моим желанием, чтобы мне помогли.",shape=box,color=red];
		j3883550239 -> j1718664044;
		j3883550239 -> j2196565556;
	j176691932 [label="Да, друзьям.",shape=box,color=red];
		j176691932 -> j1718664044;
		j176691932 -> j2196565556;
	j1117652423 [label="Я видела, как он борется с муками, которые боги обрушили на его плечи. Я знала, когда нужно молчать рядом с ним, а когда стать пресловутой стеной, по которой он может колотить кулаками.",shape=box,color=blue];
		j1117652423 -> j1816235562;
	j1718664044 [label="Я не думаю, что Лион нуждается в моей помощи.",shape=box,color=red];
		j1718664044 -> j3559997814;
	j2196565556 [label="Я пытаюсь поддерживать его, но он не слушает.",shape=box,color=red];
		j2196565556 -> j4086674408;
	j1816235562 [label="Mais ça? Это? Это место, слова дьявола, неуверенность, которую вызвал le Cardinal... Это принесло ему боль, от которой я молюсь, чтобы он смог оправиться.",shape=box,color=blue];
		j1816235562 -> j3532188047;
		j1816235562 -> j491330233;
	j3559997814 [label="Тогда, я полагаю... ничего не остаётся, но как набраться терпения, non?",shape=box,color=blue];
		j3559997814 -> j406008758;
	j4086674408 [label="Также и мне, поэтому я здесь, что обсудить это с тобой. Я всегда могла его утешить...",shape=box,color=blue];
		j4086674408 -> j3885316320;
	j3532188047 [label="Так, ты признаёшь, что Энтрати причинил боль Лиону? И как ты к этому относишься?",shape=box,color=red];
		j3532188047 -> j2118791135;
	j491330233 [label="Мне кажется, он балансирует на краю пропасти. Как мне помочь вернуть его обратно?",shape=box,color=red];
		j491330233 -> j3889659096;
	j406008758 [label="Merci. Прости меня, что отняла у тебя время.",shape=box,color=blue];
		j406008758 -> "Chat ends.";
	j3885316320 [label="Я ошеломлена его яростью, его désespoir... он избегает моего общества так, как никогда прежде.",shape=box,color=blue];
		j3885316320 -> j1565690239;
	j2118791135 [label="Pas bien... Но как мне выбрать между моей любовью к брату и моим обожанием le Cardinal? Как я должна выбрить между моей famille?",shape=box,color=blue];
		j2118791135 -> j4181622284;
		j2118791135 -> j63727922;
		j2118791135 -> j1867846876;
		j2118791135 -> j780293331;
	j3889659096 [label="Я не знаю, поэтому я здесь, что обсудить это с тобой. Я всегда могла его утешить...",shape=box,color=blue];
		j3889659096 -> j3885316320;
	j1565690239 [label="Что его так беспокоит? Тебе известна причина?",shape=box,color=blue];
		j1565690239 -> j2411453274;
	j4181622284 [label="У тебя нет нужды выбирать, Мари. Люди могут быть сложны в том, какое место они занимают в нашей жизни.",shape=box,color=red];
		j4181622284 -> j540830203;
	j63727922 [label="Мне хотелось бы выбрать ту семью, которая ещё здесь. Не ту, которая тебя оставила.",shape=box,color=red];
		j63727922 -> j3900023796;
	j1867846876 [label="У меня есть уверенность, что Энтрати не хотел причинять Лиону такую боль.",shape=box,color=red];
		j1867846876 -> j1778202011;
	j780293331 [label="Ты могла бы выбрать новую семью. Как я. И тех, кто рядом, кому ты небезразлична, без Энтрати.",shape=box,color=red];
		j780293331 -> j1627396687;
	j2411453274 [label="Evaluate expressions",color=orange];
		j2411453274 -> j1024599646 [label="DrifterFaithNoMITW",color=purple];
		j2411453274 -> j3358225607 [label="DrifterFaithNoMITW",color=purple];
		j2411453274 -> j3491199477 [label="LyonRell3",color=purple];
		j2411453274 -> j3358225607 [label="LyonRell3",color=purple];
		j2411453274 -> j1668469850 [label="LyonRoathe3",color=purple];
		j2411453274 -> j3358225607 [label="LyonRoathe3",color=purple];
		j2411453274 -> j3730976878 [label="LyonEntrati3",color=purple];
		j2411453274 -> j3358225607 [label="LyonEntrati3",color=purple];
		j2411453274 -> j3358225607 [label="LyonRell1",color=purple];
		j2411453274 -> j2124647822 [label="false",color=purple];
	j540830203 [label="В этом и проблема с подобными как Энтрати. Они не воплощают лишь «Добро» или «Зло». Они смесь.",shape=box,color=red];
		j540830203 -> j298044435;
	j3900023796 [label="Давай оставим этот разговор о le Cardinal в стороне, oui? Я беспокоюсь за брата моей души.",shape=box,color=blue];
		j3900023796 -> j3885316320;
	j1778202011 [label="Я тоже так не думаю, но факт остаётся фактом, oui? Но я ценю твои чувства. Cela dit...",shape=box,color=blue];
		j1778202011 -> j3900023796;
	j1627396687 [label="Boolean DrifterMarie is now true.",color=orange];
		j1627396687 -> j908017724;
	j1024599646 [label="Лион пытается смириться с тем фактом, что Безразличие это не настоящий бог.",shape=box,color=red];
		j1024599646 -> j3099236821;
	j3358225607 [label="Я не думаю, что это связано только с чем-то одним. Я думаю, что это происходит из-за множества факторов.",shape=box,color=red];
		j3358225607 -> j3640750084;
	j3491199477 [label="Лион услышал голос одного из Тэнно, парня по имени Рэлл. Рэлл... погиб. Я не думаю, что он хорошо с этим справляется.",shape=box,color=red];
		j3491199477 -> j2250594269;
	j1668469850 [label="У него есть Роут, который нашёптывает ему ложь о Человеке в стене.",shape=box,color=red];
		j1668469850 -> j1572185027;
	j3730976878 [label="Я не могу себе представить, чтобы Энтрати нашёптывал ему, что голоса его богов на самом деле являются голосами из Бездны.",shape=box,color=red];
		j3730976878 -> j3162480272;
	j2124647822 [label="Честно говоря, я не знаю, нет.",shape=box,color=red];
		j2124647822 -> j630005297;
	j298044435 [label="Давай оставим этот разговор о le Cardinal в стороне, oui? Я беспокоюсь за брата моей души. Но... Я знаю, то, что ты говоришь... всё больше и больше становится чистой правдой.",shape=box,color=blue];
		j298044435 -> j200917;
	j908017724 [label="Не думай, что я не заметила, как ты проскользнула туда первым, волк.",shape=box,color=blue];
		j908017724 -> j298044435;
	j3099236821 [label="И ты ничем не поможешь по этому поводу, если ты будешь говаривать с ним таким образом. Даже если твои слова правдивы, ты тебе надо проявлять осторожность в том, как они преподносятся.",shape=box,color=blue];
		j3099236821 -> j1538371250;
	j3640750084 [label="Oui, он был убежищем во время бури для многих... и вот теперь он сам попал в такую же бурю.",shape=box,color=blue];
		j3640750084 -> j4110466589;
	j2250594269 [label="Я слышала, как он произносил это имя, Рэлл - и знания о судьбе мальчика разбивают моё сердце.",shape=box,color=blue];
		j2250594269 -> j2684705938;
	j1572185027 [label="За свою долгую жизнь этот дьявол причинил больше горя, чем многие другие! Но я не думаю, что это единственная причина его раздоров, non?",shape=box,color=blue];
		j1572185027 -> j4194489869;
	j3162480272 [label="S'il te plaît, больше никаких разговоров о le Cardinal. Я не отрицаю, что его слова усугубляют раздор в Лионе, но это не может быть единственной причиной.",shape=box,color=blue];
		j3162480272 -> j3464861758;
	j630005297 [label="Тогда, я полагаю... всё, что мы можем сделать, это лишь запастись терпением и надеяться, что со временем выясним, что его беспокоит.",shape=box,color=blue];
		j630005297 -> j2631661354;
	j200917 [label="Boolean MarieEntrati4a is now true.",color=orange];
		j200917 -> j3885316320;
	j1538371250 [label="Хирургическое вмешательство лучше всего не проводить топором. Это же не британский флот.",shape=box,color=blue];
		j1538371250 -> j3714112342;
	j4110466589 [label="Разрываемый со всех сторон, и не ведая, по какому пути идти...",shape=box,color=blue];
		j4110466589 -> j962287933;
		j4110466589 -> j144437183;
	j2684705938 [label="Но я не думаю, что это единственная причина его смуты? Лион следует путём Луа. La mort est une compagne qui marche à ses côtés",shape=box,color=blue];
		j2684705938 -> j3714112342;
	j4194489869 [label="Это усилило его неуверенность… Но придавать столько значения словам какого-то дьявола? Мой Лион лучше этого. Я думаю, что сейчас его тяготит сразу многое.",shape=box,color=blue];
		j4194489869 -> j2812827065;
		j4194489869 -> j3300185536;
	j3464861758 [label="Boolean MarieEntrati4b is now true.",color=orange];
		j3464861758 -> j2902929134;
	j2631661354 [label="+15 Chemistry",color=orange];
		j2631661354 -> j2239352278;
	j3714112342 [label="Non, я думаю, что сейчас его тяготит многое.",shape=box,color=blue];
		j3714112342 -> j2812827065;
		j3714112342 -> j3300185536;
	j962287933 [label="Тогда мы должны стать для него убежищем. Местом, о котором он знает, что ему не причинят тут боль.",shape=box,color=red];
		j962287933 -> j2675121024;
	j144437183 [label="Тогда нам необходимо показать ему путь обратно в безопасное место. Станем светом во тьме.",shape=box,color=red];
		j144437183 -> j3139009342;
	j2812827065 [label="Тогда, наверное... нам необходимо показать ему путь обратно в безопасное место. Станем светом во тьме.",shape=box,color=red];
		j2812827065 -> j3139009342;
	j3300185536 [label="Тогда, наверное... мы должны стать для него убежищем. Местом, о котором он знает, что ему не причинят тут боль.",shape=box,color=red];
		j3300185536 -> j484707431;
	j2902929134 [label="Он не придал достаточного значения словам le Cardinal, чтобы позволить им погрузить его в такую тьму. Я думаю, что сейчас его тяготит многое.",shape=box,color=blue];
		j2902929134 -> j3300185536;
		j2902929134 -> j2812827065;
	j2239352278 [label="Спасибо. Я знаю, что ты стараешься изо всех сил. И за это, я очень тебе благодарна.",shape=box,color=blue];
		j2239352278 -> "Chat ends.";
	j2675121024 [label="+10 Chemistry",color=orange];
		j2675121024 -> j2473476719;
	j3139009342 [label="Как ты можешь помочь тому, кто не слышит твоего зова, не может видеть твоего света? Non, Луа окутала его этой тьмой.",shape=box,color=blue];
		j3139009342 -> j4225287643;
	j484707431 [label="+5 Chemistry",color=orange];
		j484707431 -> j2473476719;
	j2473476719 [label="Oui, пожалуй, ты прав. Нам надлежит быть теми, к кому он сможет обратиться, когда всё иное оставит его.",shape=box,color=blue];
		j2473476719 -> j202293997;
	j4225287643 [label="Я не думаю, что даже свет Сол мог бы проникнуть сквозь вуаль.",shape=box,color=blue];
		j4225287643 -> j202293997;
	j202293997 [label="Там, где вера его слабеет, нам надлежит быть твёрдым основанием под его стопами. ",shape=box,color=blue];
		j202293997 -> j2455989353;
	j2455989353 [label="Если все невидимые голоса превратились из доброжелательных фантомов в демонов в тени, которые мучают его...",shape=box,color=blue];
		j2455989353 -> j3443285709;
	j3443285709 [label="Мы должны сделать себя ещё более реальными, non?",shape=box,color=blue];
		j3443285709 -> j3401174598;
		j3443285709 -> j241318977;
	j3401174598 [label="Я буду продолжать пытаться.",shape=box,color=red];
		j3401174598 -> j1128061958;
	j241318977 [label="Я лишь надеюсь, что это не разорвёт его на куски.",shape=box,color=red];
		j241318977 -> j1675135446;
	j1128061958 [label="+10 Chemistry",color=orange];
		j1128061958 -> j3778227161;
	j1675135446 [label="+5 Chemistry",color=orange];
		j1675135446 -> j9366255;
	j3778227161 [label="В конце концов, это всё, что мы можем сделать.",shape=box,color=blue];
		j3778227161 -> j1396784969;
	j9366255 [label="Oui... и я тоже. Но всё, что мы можем сделать, это стоять рядом с ним и молиться, non?",shape=box,color=blue];
		j9366255 -> j855357943;
	j1396784969 [label="Продолжать пробовать. И молиться.",shape=box,color=blue];
		j1396784969 -> j2672947374;
	j855357943 [label="И надеюсь, что ещё не слишком поздно.",shape=box,color=blue];
		j855357943 -> j2672947374;
	j2672947374 [label="Merci... Мне нужно идти. Прости, если эта беседа была бесполезна. Я волнуюсь, когда не могу действовать.",shape=box,color=blue];
		j2672947374 -> j2559027608;
		j2672947374 -> j136711053;
	j2559027608 [label="То же самое и со мной. Но порой действие бывает неверным выбором.",shape=box,color=red];
		j2559027608 -> j1894773237;
	j136711053 [label="С ним всё будет в порядке. У меня есть уверенность в этом.",shape=box,color=red];
		j136711053 -> j1894773237;
	j1894773237 [label="Я молюсь за твою правоту. Я не знаю, что я буду делать без него.",shape=box,color=blue];
		j1894773237 -> "Chat ends.";
}