digraph {
	1113 [label="MarieRank3Convo3 begins.",color=orange];
		1113 -> 3737;
	3737 [label="Update boolean MarieLyonAvailable",color=orange];
		3737 -> 1114;
	1114 [label="Check boolean MarieGraveyard1",color=orange];
		1114 -> 1115 [label=true,color=green];
		1114 -> 1117 [label=true,color=green];
		1114 -> 1118 [label=true,color=green];
		1114 -> 1116 [label=false,color=brown];
		1114 -> 1117 [label=false,color=brown];
		1114 -> 1118 [label=false,color=brown];
	1115 [label="Расскажешь мне больше о том, каково было жить в Соборе? До того, как пришёл Энтрати?",shape=box,color=red];
		1115 -> 1119;
	1117 [label="Где ты выросла, Мари?",shape=box,color=red];
		1117 -> 2425;
	1118 [label="[Конец.]",shape=box,color=red];
		1118 -> 1122;
	1116 [label="Какой была твоя жизнь в Соборе, прежде чем появился Энтрати?",shape=box,color=red];
		1116 -> 1120;
	1119 [label="Одиноко, полагаю, так оно и было на самом деле. У меня был Лион, но ты ведь знаешь, каким он бывает порой. (Ох! Я так рада, что вы теперь снова общаетесь!)",shape=box,color=blue];
		1119 -> 1123;
	2425 [label="Update boolean MarieBackstory1",color=orange];
		2425 -> 1121;
	1122 [label="Chat ends.",color=orange];
	1120 [label="Ох, не уверена, что тебе это будет особенно интересно, но раз уж тебе так хочется знать, я тебе расскажу. ",shape=box,color=blue];
		1120 -> 1124;
	1123 [label="Update boolean MarieGraveyard2",color=orange];
		1123 -> 1126;
	1121 [label="Я бы сказала, что язык всё выдаёт, но потом вспомнила, что ты ведь не из моего мира, ха!",shape=box,color=blue];
		1121 -> 1125;
	1124 [label="Я провела его, выполняя свои обязанности Сестры Сола. Полировала церковную утварь, расставляла свечи для прихожан. ",shape=box,color=blue];
		1124 -> 1127;
	1126 [label="Но именно поэтому я не провожу столько времени, разговаривая с мёртвыми.",shape=box,color=blue];
		1126 -> 1129;
	1125 [label="Я из la Cité de la Lumière, столицы страны под названием Gaule. В масштабах мира это недалеко от Хёльвании на карте.",shape=box,color=blue];
		1125 -> 1128;
	1127 [label="Я ухаживала за криптой и кладбищем. Это было моё любимое занятие.",shape=box,color=blue];
		1127 -> 1130;
		1127 -> 1131;
	1129 [label="Update boolean MarieGraveyard2",color=orange];
		1129 -> 1134;
	1128 [label="Интересно, стоит ли мой собор в 1999? Какая забавная мысль!",shape=box,color=blue];
		1128 -> 1132;
		1128 -> 1133;
	1130 [label="Почему именно оно?",shape=box,color=red];
		1130 -> 1135;
	1131 [label="Прости… а что тебе в этом нравилось больше всего?",shape=box,color=red];
		1131 -> 1136;
	1134 [label="В этих местах есть своя красота, своё спокойствие. Они такие тихие. Мирные.",shape=box,color=blue];
		1134 -> 1139;
	1132 [label="Тебе нравится отходить от темы, не так ли?",shape=box,color=red];
		1132 -> 1137;
	1133 [label="Я, пожалуй, спрошу у двоих друзей, которые много путешествовали. Кажется, они даже делились воспоминаниями о том городе.",shape=box,color=red];
		1133 -> 1138;
	1135 [label="Мне было очень приятно говорить с теми, кто покоится в земле. Они выслушивали мои тревоги без малейшего осуждения.",shape=box,color=blue];
		1135 -> 1140;
	1136 [label="Моей обязанностью было заботиться о покоящихся в соборе. Я подметала пыль с пола склепа, пропалывала траву во дворе.",shape=box,color=blue];
		1136 -> 1135;
	1139 [label="Думаю, мне нравится рассказывать им о своих проблемах et les activités des autres потому что их тревоги остались позади, не так ли?",shape=box,color=blue];
		1139 -> 1143;
	1137 [label="+5 Chemistry",color=orange];
		1137 -> 1141;
	1138 [label="+5 Chemistry",color=orange];
		1138 -> 1142;
	1140 [label="Ну, они не произносили ни слова в ответ, mais cela me convenait tout à fait! Я предпочла бы, чтобы они хранили молчание.",shape=box,color=blue];
		1140 -> 1144;
	1143 [label="Сейчас им, наверное, всё кажется незначительным, и это меня утешает.",shape=box,color=blue];
		1143 -> 1146;
		1143 -> 1147;
		1143 -> 1148;
	1141 [label="Видно, не правда ли? Лион всё время дразнит меня, говоря, что я — пылинка в солнечном луче, дрейфующая туда, куда подует ветер. (Мне так приятно, что вы с ним теперь общаетесь!)",shape=box,color=blue];
		1141 -> 1145;
	1142 [label="Ой, не беспокой их, это просто глупая идея. Не знаю, как грустно было бы мне думать, что его больше нет.",shape=box,color=blue];
		1142 -> 1145;
	1144 [label="+5 Chemistry",color=orange];
		1144 -> 1149;
	1146 [label="Не знаю… я боюсь по‑настоящему умереть. Мне никогда не было спокойно рядом со смертью.",shape=box,color=red];
		1146 -> 1151;
	1147 [label="Никогда раньше так не думалось.",shape=box,color=red];
		1147 -> 1152;
	1148 [label="Мне тоже чувствовалось спокойствие, бывая на кладбищах. Я тебя прекрасно понимаю.",shape=box,color=red];
		1148 -> 1153;
	1145 [label="Я просто любопытна, не так ли? Я хочу познать tout ce qui existe - всё, что есть в этом мире. Думаю, именно поэтому Кардинал и я были предназначены встретиться.",shape=box,color=blue];
		1145 -> 1150;
	1149 [label="Можешь себе представить? Говорящие черепа, почти как твой Некралоид! Ха!",shape=box,color=blue];
		1149 -> 1154;
		1149 -> 1155;
	1151 [label="Знаю, маленькая угрюмая Мари! Так странно. Но каждому своё, не так ли?",shape=box,color=blue];
		1151 -> 1157;
	1152 [label="Ты не один. Мы ведь не любим тратить слишком много времени на размышления о том, что будет потом. Не раньше, чем мы окажемся к этому близки.",shape=box,color=blue];
		1152 -> 1158;
	1153 [label="Я так рада, что ты понимаешь!",shape=box,color=blue];
		1153 -> 1158;
	1150 [label="Où en étais-je? Ах! Да. Моя история.",shape=box,color=blue];
		1150 -> 1156;
	1154 [label="Это, наверное, была не самая лёгкая задача, учитывая твою инвалидную коляску.",shape=box,color=red];
		1154 -> 1159;
	1155 [label="Разве у тебя не было других друзей, с кем можно было бы поговорить?",shape=box,color=red];
		1155 -> 1160;
	1157 [label="Кто-то же должен о них заботиться. И я с радостью это делаю.",shape=box,color=blue];
		1157 -> 1158;
	1158 [label="Лион шутит, что я ближе к земле, поэтому я так часто думаю о могиле.",shape=box,color=blue];
		1158 -> 1162;
	1156 [label="Я родилась в богатой семье, что, возможно, удивит тебя. В семье буржуа, которые ближе к Орокин, чем можно подумать.",shape=box,color=blue];
		1156 -> 1161;
	1159 [label="Нет, вовсе нет. Но Лион помогал мне подниматься и спускаться в крипту, когда приходило время, а с остальным я справлялась со временем сама.",shape=box,color=blue];
		1159 -> 1163;
	1160 [label="Update boolean MarieGraveyard1",color=orange];
		1160 -> 1164;
	1162 [label=" Я спрашиваю его, пустая ли у него голова, и вот почему она полна призраков.",shape=box,color=blue];
		1162 -> 1166;
	1161 [label="Но когда я родилась такой… искривлённой, c mes pieds tordus et inutilisables? Ох, ma mère не могла этого допустить.",shape=box,color=blue];
		1161 -> 1165;
	1163 [label="Впечатляет, на что способно упрямство, oui?",shape=box,color=blue];
		1163 -> 1167;
	1164 [label="Конечно, у меня был Лион. Но ты видишь, как хорошо это иногда складывается.",shape=box,color=blue];
		1164 -> 1129;
	1166 [label="Тогда он угрожал толкнуть меня с холма, а я в ответ грозила набить его крапивой.",shape=box,color=blue];
		1166 -> 1169;
	1165 [label="Нужно было ведь поддерживать видимость, oui? Следить за стандартами.",shape=box,color=blue];
		1165 -> 1168;
	1167 [label="Ну что ж. Упрямство и сила верхней части тела, ха!",shape=box,color=blue];
		1167 -> 1170;
	1169 [label="La famille.",shape=box,color=blue];
		1169 -> 1172;
		1169 -> 1173;
		1169 -> 1174;
		1169 -> 3921;
	1168 [label="Итак, что же делать с бедной, искалеченной Мари? Меня отвезли в la Cité de la Lumière, где я, конечно же, погибла бы на улицах...",shape=box,color=blue];
		1168 -> 1171;
	1170 [label="Update boolean MarieGraveyard1",color=orange];
		1170 -> 1129;
	1172 [label="Мне жаль, что Энтрати разрушил то, что у тебя было.",shape=box,color=red];
		1172 -> 1177;
	1173 [label="Очень хорошо, что вы двое были друг у друга.",shape=box,color=red];
		1173 -> 1178;
	1174 [label="Вы двое заставляете меня улыбаться.",shape=box,color=red];
		1174 -> 1179;
	3921 [label="So you and he... have never been romantic?",shape=box,color=red];
		3921 -> 3922;
	1171 [label="И бросили умирать.",shape=box,color=blue];
		1171 -> 1175;
		1171 -> 1176;
	1177 [label="+10 Chemistry",color=orange];
		1177 -> 1182;
	1178 [label="+20 Chemistry",color=orange];
		1178 -> 1183;
	1179 [label="+20 Chemistry",color=orange];
		1179 -> 1184;
	3922 [label="Oh, Sol ! Non ! He is like a brother to me in all ways except by blood. I find myself complètement dégoûtée by the very notion !",shape=box,color=blue];
		3922 -> 3923;
		3922 -> 3924;
	1175 [label="Твоя семья оставила тебя умирать?",shape=box,color=red];
		1175 -> 1180;
	1176 [label="Сколько тебе было лет?",shape=box,color=red];
		1176 -> 1181;
	1182 [label="Энтрати ничего не разрушил. Мы с Лионом так же сильны, как и всегда. Просто всё изменилось, не так ли?",shape=box,color=blue];
		1182 -> 1186;
	1183 [label="I would be nowhere with out him. Save, perhaps, the bottom of a hill. Hah !",shape=box,color=blue];
		1183 -> 1187;
	1184 [label="Он умеет заставить меня смеяться самыми странными способами. Но я нахожу, что и ты тоже, волк. Я чувствую себя всё счастливее и счастливее, находясь здесь.",shape=box,color=blue];
		1184 -> 1188;
	3923 [label="I was just curious.",shape=box,color=red];
		3923 -> 3925;
	3924 [label="I admit, I'm a little relieved.",shape=box,color=red];
		3924 -> 3931;
	1180 [label="В их глазах, они долгие годы старались исправить меня. Наставники, чтобы учить ходить, скобы держали мои ноги, обувь сопровождала каждый мой шаг.",shape=box,color=blue];
		1180 -> 1185;
	1181 [label="Шесть? Семь? В их глазах они много лет старались меня исправить. Наставники учили ходить. Скобы. Обувь.",shape=box,color=blue];
		1181 -> 1185;
	1186 [label="Луа постоянно меняется. Даже Сол, каким бы постоянным он ни был, подвержен влиянию в своих орбитах.",shape=box,color=blue];
		1186 -> 1191;
	1187 [label="Он действительно мой брат по духу. Я всё чаще ловлю себя на мысли, что мне всё радостнее быть здесь.",shape=box,color=blue];
		1187 -> 1188;
	1188 [label="Я только надеюсь, что он вскоре поймет то же самое... но дьявол преследует его своими шёпотами и ложью.",shape=box,color=blue];
		1188 -> 1192;
	3925 [label="+10 Chemistry",color=orange];
		3925 -> 3926;
	3931 [label="Check boolean DrifterMarie",color=orange];
		3931 -> 3932 [label=true,color=green];
		3931 -> 3933 [label=false,color=brown];
	1185 [label="Но им надоело нести эту ношу. И вот, едва умея складывать буквы и цифры, я очутилась в грязи.",shape=box,color=blue];
		1185 -> 1189;
		1185 -> 1190;
	1191 [label="Мы не должны цепляться за свои привычки, иначе они нас сломают, волк. К тому же я всё чаще ловлю себя на мысли, что мне радостнее быть здесь.",shape=box,color=blue];
		1191 -> 1188;
	1192 [label="Бах! Только заговоришь о нём, и он сразу откликается. Пора уходить.",shape=box,color=blue];
		1192 -> 1194;
	3926 [label="Check boolean DrifterMarie",color=orange];
		3926 -> 3927 [label=true,color=green];
		3926 -> 3928 [label=false,color=brown];
	3932 [label="Oui, you have made your intentions known. I must warn you that I will not abandon him. I have known Lyon much longer than you.",shape=box,color=blue];
		3932 -> 3928;
	3933 [label="Oui ? And which one of us do you... hunt ?",shape=box,color=blue];
		3933 -> 3934;
		3933 -> 3935;
	1189 [label="Как тебе удалось выжить?",shape=box,color=red];
		1189 -> 1193;
	1190 [label="Это ужасно.",shape=box,color=red];
		1190 -> 1193;
	1194 [label="Chat ends.",color=orange];
	3927 [label="Oui. Simply \"curious.\" You do not fool me. I must warn you that I will not abandon him. I have known Lyon much longer than you.",shape=box,color=blue];
		3927 -> 3928;
	3928 [label="+20 Chemistry",color=orange];
		3928 -> 3929;
	3934 [label="You.",shape=box,color=red];
		3934 -> 3936;
	3935 [label="Лион.",shape=box,color=red];
		3935 -> 3941;
	1193 [label="Check boolean MarieSecretPower",color=orange];
		1193 -> 1196 [label=true,color=green];
		1193 -> 1195 [label=false,color=brown];
	3929 [label="I would be nowhere without him. Save, perhaps, the bottom of a hill. Hah !",shape=box,color=blue];
		3929 -> 3930;
	3936 [label="Update boolean DrifterMarie",color=orange];
		3936 -> 3937;
	3941 [label="Vraiment ?!",shape=box,color=blue];
		3941 -> 3942;
	1196 [label="Верно ведь, не правда ли? Каждое неудобство несёт в себе тайную силу.",shape=box,color=blue];
		1196 -> 1195;
	1195 [label="То, что сделало меня indésirable pour ma mère, сделало меня весьма популярной среди уличных детей.",shape=box,color=blue];
		1195 -> 1197;
	3930 [label="Still, you intrigue me, wolf. I am finding myself happier and happier to be here.",shape=box,color=blue];
		3930 -> 1188;
	3937 [label="+10 Chemistry",color=orange];
		3937 -> 3938;
	3942 [label="+10 Chemistry",color=orange];
		3942 -> 3943;
	1197 [label="Что может быть более pathétique, чем ребёнок без pieds, oui? Я могла заработать за день с открытыми ладонями больше, чем они успевали украсть за неделю.",shape=box,color=blue];
		1197 -> 1198;
	3938 [label="Oh ! Par Sol. You catch me by surprise, I must admit. And now I am sitting here blushing, hiding my face from Monsieur Loid...",shape=box,color=blue];
		3938 -> 3939;
	3943 [label="You do not know how happy this makes me, but please, think on what you say.",shape=box,color=blue];
		3943 -> 3944;
	1198 [label="Именно это привело к тому, что меня нашла на улице одна из les Sœurs de Sol. Они предложили приютить меня.",shape=box,color=blue];
		1198 -> 1199;
		1198 -> 1200;
	3939 [label="I must warn you that I will not abandon him. I have known Lyon much longer than you.",shape=box,color=blue];
		3939 -> 3940;
	3944 [label="Update boolean DrifterLyon",color=orange];
		3944 -> 3945;
	1199 [label="А как насчет остальных детей?",shape=box,color=red];
		1199 -> 1201;
	1200 [label="Разумеется, ты сказала «да».",shape=box,color=red];
		1200 -> 1202;
	3940 [label="+10 Chemistry",color=orange];
		3940 -> 1188;
	3945 [label="Lyon is my brother. I love him more than you can possibly know, but he is a troubled man. Consider your words carefully before you pursue him, n'est-ce pas ?",shape=box,color=blue];
		3945 -> 3946;
	1201 [label="+5 Chemistry",color=orange];
		1201 -> 1203;
	1202 [label="Oui, что я могла сделать? Это был лишь вопрос времени, прежде чем я заболею. Даже будучи ребёнком, я это знала.",shape=box,color=blue];
		1202 -> 1204;
		1202 -> 1205;
	3946 [label="We will speak on this again soon, I think. Do not take me wrong, I am encouraging you ! I simply want you to think it through.",shape=box,color=blue];
		3946 -> 3940;
	1203 [label="У тебя такое доброе сердце. Конечно, они не могли забрать их всех… но я не забыла о своих друзьях.",shape=box,color=blue];
		1203 -> 1206;
	1204 [label="Какими были сестры?",shape=box,color=red];
		1204 -> 1207;
	1205 [label="Как ты приспособилась к жизни в соборе?",shape=box,color=red];
		1205 -> 1208;
	1206 [label="Каждую неделю я возвращалась с моей зарплатой и тем, что удавалось наскрести на кухне или у других.",shape=box,color=blue];
		1206 -> 1209;
	1207 [label="Les Sœurs были так добры ко мне! Хотя я понимаю, почему ты, должно быть, думаешь иначе, non?",shape=box,color=blue];
		1207 -> 1210;
	1208 [label="Как я его обожала! Хотя понимаю, почему тебе может показаться иначе, non?",shape=box,color=blue];
		1208 -> 1210;
	1209 [label="Я заботилась о них настолько хорошо, насколько могла, пока мои друзья оставались рядом. Многие умерли от оспы или туберкулёза...",shape=box,color=blue];
		1209 -> 1211;
	1210 [label="Трёхразовое питание, тёплая постель, крыша над головой. Мне не нужно было беспокоиться о том, что меня изобьют, ограбят или что-нибудь похуже?",shape=box,color=blue];
		1210 -> 1212;
	1211 [label="Некоторые уехали, кто-то погиб в драках или от насилия. Большинство нашли честную работу и выросли. Создали собственные семьи.",shape=box,color=blue];
		1211 -> 1213;
	1212 [label="Меня как следует обучили. Обучили евангелиям Сола и Луа. Велели найти свой путь в вере. Я могла бы уйти, если бы захотела.",shape=box,color=blue];
		1212 -> 1214;
	1213 [label="Некоторые даже заходили в Собор, чтобы увидеть меня. Это согревало моё сердце.",shape=box,color=blue];
		1213 -> 1214;
	1214 [label="Долгое время я чувствовала вину за то, что меня забрали с улиц, а других нет. Иногда я всё ещё ощущаю это.",shape=box,color=blue];
		1214 -> 1215;
		1214 -> 1216;
	1215 [label="Когда думаю обо всех, кто погиб рядом со мной, а мне было повезло выжить, я испытываю то же чувство. Но мы не можем так поступать с собой. Мы должны продолжать бороться, чтобы всё исправить, пока это возможно.",shape=box,color=red];
		1215 -> 1217;
	1216 [label="Ты сделала всё, что могла, чтобы помочь другим тем, что тебе было дано. Когда-то другие поддержали тебя, а теперь, получив такую возможность, ты стараешься поддержать других.",shape=box,color=red];
		1216 -> 1218;
	1217 [label="Разве это навсегда? Борьба? Война против течения, которое стремится нас потопить?",shape=box,color=blue];
		1217 -> 1219;
	1218 [label="Add 1 to Thermostat",color=orange];
		1218 -> 1220;
	1219 [label="Add -1 to Thermostat",color=orange];
		1219 -> 1221;
	1220 [label="+10 Chemistry",color=orange];
		1220 -> 1222;
	1221 [label="+10 Chemistry",color=orange];
