digraph {
	"MarieRank3Convo3 begins." [color=orange];
		"MarieRank3Convo3 begins." -> j336195646;
	j336195646 [label="Boolean MarieLyonAvailable is now true.",color=orange];
		j336195646 -> j971302504;
	j971302504 [label="Check boolean MarieGraveyard1",color=orange];
		j971302504 -> j1848701661 [label=true,color=green];
		j971302504 -> j2374103683 [label=true,color=green];
		j971302504 -> j1310452999 [label=true,color=green];
		j971302504 -> j1775885237 [label=false,color=brown];
		j971302504 -> j2374103683 [label=false,color=brown];
		j971302504 -> j1310452999 [label=false,color=brown];
	j1848701661 [label="Расскажешь мне больше о том, каково было жить в Соборе? До того, как пришёл Энтрати?",shape=box,color=red];
		j1848701661 -> j739075365;
	j2374103683 [label="Где ты выросла, Мари?",shape=box,color=red];
		j2374103683 -> j3234941072;
	j1310452999 [label="[Конец.]",shape=box,color=red];
		j1310452999 -> "Chat ends.";
	j1775885237 [label="Какой была твоя жизнь в Соборе, прежде чем появился Энтрати?",shape=box,color=red];
		j1775885237 -> j3325637904;
	j739075365 [label="Одиноко, полагаю, так оно и было на самом деле. У меня был Лион, но ты ведь знаешь, каким он бывает порой. (Ох! Я так рада, что вы теперь снова общаетесь!)",shape=box,color=blue];
		j739075365 -> j2223635929;
	j3234941072 [label="Boolean MarieBackstory1 is now true.",color=orange];
		j3234941072 -> j4054863072;
	"Chat ends." [color=orange];
	j3325637904 [label="Ох, не уверена, что тебе это будет особенно интересно, но раз уж тебе так хочется знать, я тебе расскажу. ",shape=box,color=blue];
		j3325637904 -> j2824783010;
	j2223635929 [label="Boolean MarieGraveyard2 is now true.",color=orange];
		j2223635929 -> j1062568405;
	j4054863072 [label="Я бы сказала, что язык всё выдаёт, но потом вспомнила, что ты ведь не из моего мира, ха!",shape=box,color=blue];
		j4054863072 -> j513335524;
	j2824783010 [label="Я провела его, выполняя свои обязанности Сестры Сола. Полировала церковную утварь, расставляла свечи для прихожан. ",shape=box,color=blue];
		j2824783010 -> j360762055;
	j1062568405 [label="Но именно поэтому я не провожу столько времени, разговаривая с мёртвыми.",shape=box,color=blue];
		j1062568405 -> j3572477417;
	j513335524 [label="Я из la Cité de la Lumière, столицы страны под названием Gaule. В масштабах мира это недалеко от Хёльвании на карте.",shape=box,color=blue];
		j513335524 -> j3601181814;
	j360762055 [label="Я ухаживала за криптой и кладбищем. Это было моё любимое занятие.",shape=box,color=blue];
		j360762055 -> j248973092;
		j360762055 -> j193941914;
	j3572477417 [label="Boolean MarieGraveyard2 is now true.",color=orange];
		j3572477417 -> j1164659746;
	j3601181814 [label="Интересно, стоит ли мой собор в 1999? Какая забавная мысль!",shape=box,color=blue];
		j3601181814 -> j4145607361;
		j3601181814 -> j3985985794;
	j248973092 [label="Почему именно оно?",shape=box,color=red];
		j248973092 -> j3510718209;
	j193941914 [label="Прости… а что тебе в этом нравилось больше всего?",shape=box,color=red];
		j193941914 -> j959303905;
	j1164659746 [label="В этих местах есть своя красота, своё спокойствие. Они такие тихие. Мирные.",shape=box,color=blue];
		j1164659746 -> j3781156339;
	j4145607361 [label="Тебе нравится отходить от темы, не так ли?",shape=box,color=red];
		j4145607361 -> j298095841;
	j3985985794 [label="Я, пожалуй, спрошу у двоих друзей, которые много путешествовали. Кажется, они даже делились воспоминаниями о том городе.",shape=box,color=red];
		j3985985794 -> j2263193435;
	j3510718209 [label="Мне было очень приятно говорить с теми, кто покоится в земле. Они выслушивали мои тревоги без малейшего осуждения.",shape=box,color=blue];
		j3510718209 -> j3434346240;
	j959303905 [label="Моей обязанностью было заботиться о покоящихся в соборе. Я подметала пыль с пола склепа, пропалывала траву во дворе.",shape=box,color=blue];
		j959303905 -> j3510718209;
	j3781156339 [label="Думаю, мне нравится рассказывать им о своих проблемах et les activités des autres потому что их тревоги остались позади, не так ли?",shape=box,color=blue];
		j3781156339 -> j4287562084;
	j298095841 [label="+5 Chemistry",color=orange];
		j298095841 -> j1764561453;
	j2263193435 [label="+5 Chemistry",color=orange];
		j2263193435 -> j1717027659;
	j3434346240 [label="Ну, они не произносили ни слова в ответ, mais cela me convenait tout à fait! Я предпочла бы, чтобы они хранили молчание.",shape=box,color=blue];
		j3434346240 -> j1454327378;
	j4287562084 [label="Сейчас им, наверное, всё кажется незначительным, и это меня утешает.",shape=box,color=blue];
		j4287562084 -> j4136202443;
		j4287562084 -> j3017923960;
		j4287562084 -> j4105569983;
	j1764561453 [label="Видно, не правда ли? Лион всё время дразнит меня, говоря, что я — пылинка в солнечном луче, дрейфующая туда, куда подует ветер. (Мне так приятно, что вы с ним теперь общаетесь!)",shape=box,color=blue];
		j1764561453 -> j155904472;
	j1717027659 [label="Ой, не беспокой их, это просто глупая идея. Не знаю, как грустно было бы мне думать, что его больше нет.",shape=box,color=blue];
		j1717027659 -> j155904472;
	j1454327378 [label="+5 Chemistry",color=orange];
		j1454327378 -> j12174308;
	j4136202443 [label="Не знаю… я боюсь по‑настоящему умереть. Мне никогда не было спокойно рядом со смертью.",shape=box,color=red];
		j4136202443 -> j3080424787;
	j3017923960 [label="Никогда раньше так не думалось.",shape=box,color=red];
		j3017923960 -> j2763934658;
	j4105569983 [label="Мне тоже чувствовалось спокойствие, бывая на кладбищах. Я тебя прекрасно понимаю.",shape=box,color=red];
		j4105569983 -> j3060570966;
	j155904472 [label="Я просто любопытна, не так ли? Я хочу познать tout ce qui existe - всё, что есть в этом мире. Думаю, именно поэтому Кардинал и я были предназначены встретиться.",shape=box,color=blue];
		j155904472 -> j3487053750;
	j12174308 [label="Можешь себе представить? Говорящие черепа, почти как твой Некралоид! Ха!",shape=box,color=blue];
		j12174308 -> j2722355338;
		j12174308 -> j1642776474;
	j3080424787 [label="Знаю, маленькая угрюмая Мари! Так странно. Но каждому своё, не так ли?",shape=box,color=blue];
		j3080424787 -> j2660267549;
	j2763934658 [label="Ты не один. Мы ведь не любим тратить слишком много времени на размышления о том, что будет потом. Не раньше, чем мы окажемся к этому близки.",shape=box,color=blue];
		j2763934658 -> j952941325;
	j3060570966 [label="Я так рада, что ты понимаешь!",shape=box,color=blue];
		j3060570966 -> j952941325;
	j3487053750 [label="Où en étais-je? Ах! Да. Моя история.",shape=box,color=blue];
		j3487053750 -> j996183587;
	j2722355338 [label="Это, наверное, была не самая лёгкая задача, учитывая твою инвалидную коляску.",shape=box,color=red];
		j2722355338 -> j2688437586;
	j1642776474 [label="Разве у тебя не было других друзей, с кем можно было бы поговорить?",shape=box,color=red];
		j1642776474 -> j784947291;
	j2660267549 [label="Кто-то же должен о них заботиться. И я с радостью это делаю.",shape=box,color=blue];
		j2660267549 -> j952941325;
	j952941325 [label="Лион шутит, что я ближе к земле, поэтому я так часто думаю о могиле.",shape=box,color=blue];
		j952941325 -> j710958178;
	j996183587 [label="Я родилась в богатой семье, что, возможно, удивит тебя. В семье буржуа, которые ближе к Орокин, чем можно подумать.",shape=box,color=blue];
		j996183587 -> j1955286414;
	j2688437586 [label="Нет, вовсе нет. Но Лион помогал мне подниматься и спускаться в крипту, когда приходило время, а с остальным я справлялась со временем сама.",shape=box,color=blue];
		j2688437586 -> j34842999;
	j784947291 [label="Boolean MarieGraveyard1 is now true.",color=orange];
		j784947291 -> j3685954833;
	j710958178 [label=" Я спрашиваю его, пустая ли у него голова, и вот почему она полна призраков.",shape=box,color=blue];
		j710958178 -> j1333273124;
	j1955286414 [label="Но когда я родилась такой… искривлённой, c mes pieds tordus et inutilisables? Ох, ma mère не могла этого допустить.",shape=box,color=blue];
		j1955286414 -> j3416297955;
	j34842999 [label="Впечатляет, на что способно упрямство, oui?",shape=box,color=blue];
		j34842999 -> j1368711828;
	j3685954833 [label="Конечно, у меня был Лион. Но ты видишь, как хорошо это иногда складывается.",shape=box,color=blue];
		j3685954833 -> j3572477417;
	j1333273124 [label="Тогда он угрожал толкнуть меня с холма, а я в ответ грозила набить его крапивой.",shape=box,color=blue];
		j1333273124 -> j1118776134;
	j3416297955 [label="Нужно было ведь поддерживать видимость, oui? Следить за стандартами.",shape=box,color=blue];
		j3416297955 -> j3695130551;
	j1368711828 [label="Ну что ж. Упрямство и сила верхней части тела, ха!",shape=box,color=blue];
		j1368711828 -> j805645244;
	j1118776134 [label="La famille.",shape=box,color=blue];
		j1118776134 -> j3359377992;
		j1118776134 -> j984516124;
		j1118776134 -> j3525995463;
		j1118776134 -> j632170782;
	j3695130551 [label="Итак, что же делать с бедной, искалеченной Мари? Меня отвезли в la Cité de la Lumière, где я, конечно же, погибла бы на улицах...",shape=box,color=blue];
		j3695130551 -> j105295464;
	j805645244 [label="Boolean MarieGraveyard1 is now true.",color=orange];
		j805645244 -> j3572477417;
	j3359377992 [label="Мне жаль, что Энтрати разрушил то, что у тебя было.",shape=box,color=red];
		j3359377992 -> j172717928;
	j984516124 [label="Очень хорошо, что вы двое были друг у друга.",shape=box,color=red];
		j984516124 -> j3968867602;
	j3525995463 [label="Вы двое заставляете меня улыбаться.",shape=box,color=red];
		j3525995463 -> j4125367318;
	j632170782 [label="So you and he... have never been romantic?",shape=box,color=red];
		j632170782 -> j3192651736;
	j105295464 [label="И бросили умирать.",shape=box,color=blue];
		j105295464 -> j145860263;
		j105295464 -> j2262515586;
	j172717928 [label="+10 Chemistry",color=orange];
		j172717928 -> j2202926141;
	j3968867602 [label="+20 Chemistry",color=orange];
		j3968867602 -> j1944708314;
	j4125367318 [label="+20 Chemistry",color=orange];
		j4125367318 -> j2460792180;
	j3192651736 [label="Oh, Sol ! Non ! He is like a brother to me in all ways except by blood. I find myself complètement dégoûtée by the very notion !",shape=box,color=blue];
		j3192651736 -> j240865144;
		j3192651736 -> j981052281;
	j145860263 [label="Твоя семья оставила тебя умирать?",shape=box,color=red];
		j145860263 -> j1265389328;
	j2262515586 [label="Сколько тебе было лет?",shape=box,color=red];
		j2262515586 -> j3406753427;
	j2202926141 [label="Энтрати ничего не разрушил. Мы с Лионом так же сильны, как и всегда. Просто всё изменилось, не так ли?",shape=box,color=blue];
		j2202926141 -> j1743315613;
	j1944708314 [label="Без него меня бы не было нигде. Разве что, пожалуй, на дне холма. Ха !",shape=box,color=blue];
		j1944708314 -> j2135231589;
	j2460792180 [label="Он умеет заставить меня смеяться самыми странными способами. Но я нахожу, что и ты тоже, волк. Я чувствую себя всё счастливее и счастливее, находясь здесь.",shape=box,color=blue];
		j2460792180 -> j3499250688;
	j240865144 [label="I was just curious.",shape=box,color=red];
		j240865144 -> j3385888755;
	j981052281 [label="I admit, I'm a little relieved.",shape=box,color=red];
		j981052281 -> j1335227973;
	j1265389328 [label="В их глазах, они долгие годы старались исправить меня. Наставники, чтобы учить ходить, скобы держали мои ноги, обувь сопровождала каждый мой шаг.",shape=box,color=blue];
		j1265389328 -> j3633814415;
	j3406753427 [label="Шесть? Семь? В их глазах они много лет старались меня исправить. Наставники учили ходить. Скобы. Обувь.",shape=box,color=blue];
		j3406753427 -> j3633814415;
	j1743315613 [label="Луа постоянно меняется. Даже Сол, каким бы постоянным он ни был, подвержен влиянию в своих орбитах.",shape=box,color=blue];
		j1743315613 -> j3445180634;
	j2135231589 [label="Он действительно мой брат по духу. Я всё чаще ловлю себя на мысли, что мне всё радостнее быть здесь.",shape=box,color=blue];
		j2135231589 -> j3499250688;
	j3499250688 [label="Я только надеюсь, что он вскоре поймет то же самое... но дьявол преследует его своими шёпотами и ложью.",shape=box,color=blue];
		j3499250688 -> j753913315;
	j3385888755 [label="+10 Chemistry",color=orange];
		j3385888755 -> j1930259134;
	j1335227973 [label="Check boolean DrifterMarie",color=orange];
		j1335227973 -> j453889903 [label=true,color=green];
		j1335227973 -> j2752111096 [label=false,color=brown];
	j3633814415 [label="Но им надоело нести эту ношу. И вот, едва умея складывать буквы и цифры, я очутилась в грязи.",shape=box,color=blue];
		j3633814415 -> j843415074;
		j3633814415 -> j1862409528;
	j3445180634 [label="Мы не должны цепляться за свои привычки, иначе они нас сломают, волк. К тому же я всё чаще ловлю себя на мысли, что мне радостнее быть здесь.",shape=box,color=blue];
		j3445180634 -> j3499250688;
	j753913315 [label="Бах! Только заговоришь о нём, и он сразу откликается. Пора уходить.",shape=box,color=blue];
		j753913315 -> "Chat ends.";
	j1930259134 [label="Check boolean DrifterMarie",color=orange];
		j1930259134 -> j320684050 [label=true,color=green];
		j1930259134 -> j461725795 [label=false,color=brown];
	j453889903 [label="Oui, you have made your intentions known. I must warn you that I will not abandon him. I have known Lyon much longer than you.",shape=box,color=blue];
		j453889903 -> j461725795;
	j2752111096 [label="Oui ? And which one of us do you... hunt ?",shape=box,color=blue];
		j2752111096 -> j1686258446;
		j2752111096 -> j1981710112;
	j843415074 [label="Как тебе удалось выжить?",shape=box,color=red];
		j843415074 -> j251854413;
	j1862409528 [label="Это ужасно.",shape=box,color=red];
		j1862409528 -> j251854413;
	j320684050 [label="Oui. Simply \"curious.\" You do not fool me. I must warn you that I will not abandon him. I have known Lyon much longer than you.",shape=box,color=blue];
		j320684050 -> j461725795;
	j461725795 [label="+20 Chemistry",color=orange];
		j461725795 -> j433124134;
	j1686258446 [label="You.",shape=box,color=red];
		j1686258446 -> j3242844425;
	j1981710112 [label="Лион.",shape=box,color=red];
		j1981710112 -> j1192626868;
	j251854413 [label="Check boolean MarieSecretPower",color=orange];
		j251854413 -> j2583093721 [label=true,color=green];
		j251854413 -> j993659180 [label=false,color=brown];
	j433124134 [label="I would be nowhere without him. Save, perhaps, the bottom of a hill. Hah !",shape=box,color=blue];
		j433124134 -> j2779423720;
	j3242844425 [label="Boolean DrifterMarie is now true.",color=orange];
		j3242844425 -> j1069415331;
	j1192626868 [label="Vraiment ?!",shape=box,color=blue];
		j1192626868 -> j1475528983;
	j2583093721 [label="Верно ведь, не правда ли? Каждое неудобство несёт в себе тайную силу.",shape=box,color=blue];
		j2583093721 -> j993659180;
	j993659180 [label="То, что сделало меня indésirable pour ma mère, сделало меня весьма популярной среди уличных детей.",shape=box,color=blue];
		j993659180 -> j1354364112;
	j2779423720 [label="Still, you intrigue me, wolf. I am finding myself happier and happier to be here.",shape=box,color=blue];
		j2779423720 -> j3499250688;
	j1069415331 [label="+10 Chemistry",color=orange];
		j1069415331 -> j613216806;
	j1475528983 [label="+10 Chemistry",color=orange];
		j1475528983 -> j3661728997;
	j1354364112 [label="Что может быть более pathétique, чем ребёнок без pieds, oui? Я могла заработать за день с открытыми ладонями больше, чем они успевали украсть за неделю.",shape=box,color=blue];
		j1354364112 -> j2174129980;
	j613216806 [label="Oh ! Par Sol. You catch me by surprise, I must admit. And now I am sitting here blushing, hiding my face from Monsieur Loid...",shape=box,color=blue];
		j613216806 -> j163096993;
	j3661728997 [label="You do not know how happy this makes me, but please, think on what you say.",shape=box,color=blue];
		j3661728997 -> j3219068625;
	j2174129980 [label="Именно это привело к тому, что меня нашла на улице одна из les Sœurs de Sol. Они предложили приютить меня.",shape=box,color=blue];
		j2174129980 -> j205682918;
		j2174129980 -> j4248029321;
	j163096993 [label="I must warn you that I will not abandon him. I have known Lyon much longer than you.",shape=box,color=blue];
		j163096993 -> j3336033203;
	j3219068625 [label="Boolean DrifterLyon is now true.",color=orange];
		j3219068625 -> j1689793561;
	j205682918 [label="А как насчет остальных детей?",shape=box,color=red];
		j205682918 -> j1343790916;
	j4248029321 [label="Разумеется, ты сказала «да».",shape=box,color=red];
		j4248029321 -> j4108315304;
	j3336033203 [label="+10 Chemistry",color=orange];
		j3336033203 -> j3499250688;
	j1689793561 [label="Lyon is my brother. I love him more than you can possibly know, but he is a troubled man. Consider your words carefully before you pursue him, n'est-ce pas ?",shape=box,color=blue];
		j1689793561 -> j2309812515;
	j1343790916 [label="+5 Chemistry",color=orange];
		j1343790916 -> j2744444288;
	j4108315304 [label="Oui, что я могла сделать? Это был лишь вопрос времени, прежде чем я заболею. Даже будучи ребёнком, я это знала.",shape=box,color=blue];
		j4108315304 -> j4104764487;
		j4108315304 -> j647744198;
	j2309812515 [label="We will speak on this again soon, I think. Do not take me wrong, I am encouraging you ! I simply want you to think it through.",shape=box,color=blue];
		j2309812515 -> j3336033203;
	j2744444288 [label="У тебя такое доброе сердце. Конечно, они не могли забрать их всех… но я не забыла о своих друзьях.",shape=box,color=blue];
		j2744444288 -> j2535104380;
	j4104764487 [label="Какими были сестры?",shape=box,color=red];
		j4104764487 -> j3186199765;
	j647744198 [label="Как ты приспособилась к жизни в соборе?",shape=box,color=red];
		j647744198 -> j3088491177;
	j2535104380 [label="Каждую неделю я возвращалась с моей зарплатой и тем, что удавалось наскрести на кухне или у других.",shape=box,color=blue];
		j2535104380 -> j2768994089;
	j3186199765 [label="Les Sœurs были так добры ко мне! Хотя я понимаю, почему ты, должно быть, думаешь иначе, non?",shape=box,color=blue];
		j3186199765 -> j3387725829;
	j3088491177 [label="Как я его обожала! Хотя понимаю, почему тебе может показаться иначе, non?",shape=box,color=blue];
		j3088491177 -> j3387725829;
	j2768994089 [label="Я заботилась о них настолько хорошо, насколько могла, пока мои друзья оставались рядом. Многие умерли от оспы или туберкулёза...",shape=box,color=blue];
		j2768994089 -> j2184597898;
	j3387725829 [label="Трёхразовое питание, тёплая постель, крыша над головой. Мне не нужно было беспокоиться о том, что меня изобьют, ограбят или что-нибудь похуже?",shape=box,color=blue];
		j3387725829 -> j3591515381;
	j2184597898 [label="Некоторые уехали, кто-то погиб в драках или от насилия. Большинство нашли честную работу и выросли. Создали собственные семьи.",shape=box,color=blue];
		j2184597898 -> j1093633988;
	j3591515381 [label="Меня как следует обучили. Обучили евангелиям Сола и Луа. Велели найти свой путь в вере. Я могла бы уйти, если бы захотела.",shape=box,color=blue];
		j3591515381 -> j629124256;
	j1093633988 [label="Некоторые даже заходили в Собор, чтобы увидеть меня. Это согревало моё сердце.",shape=box,color=blue];
		j1093633988 -> j629124256;
	j629124256 [label="Долгое время я чувствовала вину за то, что меня забрали с улиц, а других нет. Иногда я всё ещё ощущаю это.",shape=box,color=blue];
		j629124256 -> j2935816860;
		j629124256 -> j131592751;
	j2935816860 [label="Когда думаю обо всех, кто погиб рядом со мной, а мне было повезло выжить, я испытываю то же чувство. Но мы не можем так поступать с собой. Мы должны продолжать бороться, чтобы всё исправить, пока это возможно.",shape=box,color=red];
		j2935816860 -> j3955754712;
	j131592751 [label="Ты сделала всё, что могла, чтобы помочь другим тем, что тебе было дано. Когда-то другие поддержали тебя, а теперь, получив такую возможность, ты стараешься поддержать других.",shape=box,color=red];
		j131592751 -> j3570146940;
	j3955754712 [label="Разве это навсегда? Борьба? Война против течения, которое стремится нас потопить?",shape=box,color=blue];
		j3955754712 -> j2372153288;
	j3570146940 [label="Add 1 to Thermostat counter",color=orange];
		j3570146940 -> j3953138295;
	j2372153288 [label="Add -1 to Thermostat counter",color=orange];
		j2372153288 -> j4238884216;
	j3953138295 [label="+10 Chemistry",color=orange];
		j3953138295 -> j3231515111;
	j4238884216 [label="+10 Chemistry",color=orange];
		j4238884216 -> j3186479700;
	j3231515111 [label="Oui, именно так. Меня подняли на плот, и теперь я должна сделать то же для других. ",shape=box,color=blue];
		j3231515111 -> j2010638112;
	j3186479700 [label="Но я понимаю, о чём ты. В основе всего этого лежит призыв не сдаваться. Что мне даны эти дары, чтобы я могла стать щитом для других.",shape=box,color=blue];
		j3186479700 -> j2010638112;
	j2010638112 [label="Merci. Но мне пора идти.",shape=box,color=blue];
		j2010638112 -> "Chat ends.";
}