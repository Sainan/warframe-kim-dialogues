	1265 [label="У него есть на то свои причины.",shape=box,color=red];
		1265 -> 1269;
	1266 [label="Ну ладно... Какой у тебя был вопрос?",shape=box,color=red];
		1266 -> 1270;
	1262 [label="Стоит ли мне беспокоиться?",shape=box,color=red];
		1262 -> 1267;
	1263 [label="Vive la révolution! Я думаю.",shape=box,color=red];
		1263 -> 1268;
	1264 [label="Я не совсем понимаю, что сейчас произошло, но, кажется, я согласен?",shape=box,color=red];
		1264 -> 1268;
	1269 [label="Да, безусловно, есть.",shape=box,color=blue];
		1269 -> 1272;
	1270 [label="Ах! Да.",shape=box,color=blue];
		1270 -> 1272;
	1267 [label="Не обращай на меня внимания, я просто немного забавляюсь. Глупенькая маленькая Мари la révolutionnaire.",shape=box,color=blue];
		1267 -> 1271;
	1268 [label="+10 Chemistry",color=orange];
		1268 -> 1267;
	1272 [label="Боюсь, я совсем забыла, зачем пришла к тебе! Ха! Ну что ж, вспомню позже.",shape=box,color=blue];
		1272 -> 1273;
	1271 [label="Спасибо, что ответил на мой вопрос. Пожалуй, я тебя отпущу. ",shape=box,color=blue];
		1271 -> 1273;
	1273 [label="Прошу прощения, что нарушила твое спокойствие. Будь то день, вечер или какое бы ни было время там, где ты сейчас находишься.",shape=box,color=blue];
		1273 -> 1274;
	1274 [label="À la revoyure!",shape=box,color=blue];
