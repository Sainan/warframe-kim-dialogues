digraph {
	"MarieRank3Convo4 begins." [color=orange];
		"MarieRank3Convo4 begins." -> j2870827780;
	j2870827780 [label="Boolean MarieLyonAvailable is now true.",color=orange];
		j2870827780 -> j3772022536;
	j3772022536 [label="Я недавно говорила с Monsieur Лойдом о его детстве и у меня возник к тебе вопрос.",shape=box,color=blue];
		j3772022536 -> j4146207245;
		j3772022536 -> j1123674745;
		j3772022536 -> j1008003881;
		j3772022536 -> j1310452999;
	j4146207245 [label="Прости... что ты делала?",shape=box,color=red];
		j4146207245 -> j142891779;
	j1123674745 [label="Я... не... знаю, как к этому относиться.",shape=box,color=red];
		j1123674745 -> j1338425998;
	j1008003881 [label="В чём вопрос?",shape=box,color=red];
		j1008003881 -> j1509835977;
	j1310452999 [label="[Конец.]",shape=box,color=red];
		j1310452999 -> "Chat ends.";
	j142891779 [label="Он рассказывал мне о своей юности. Ai-je fait quelque chose qui vous a offensé?",shape=box,color=blue];
		j142891779 -> j147758237;
		j142891779 -> j2065249003;
	j1338425998 [label="Я не понимаю. Ai-je fait quelque chose qui vous avez offensé?",shape=box,color=blue];
		j1338425998 -> j147758237;
		j1338425998 -> j2065249003;
	j1509835977 [label="Архимедианцы - были ли они Орокин? Или нет? Это слово употребляется с таким легкомыслием.",shape=box,color=blue];
		j1509835977 -> j2866095632;
	"Chat ends." [color=orange];
	j147758237 [label="Наверное, я просто... завидую.",shape=box,color=red];
		j147758237 -> j446425186;
	j2065249003 [label="Наверное, просто испытываю удивление.",shape=box,color=red];
		j2065249003 -> j1287255794;
	j2866095632 [label="Наверное, я могла бы спросить у дьявола… Но если есть возможность, я предпочитаю с ним не говорить.",shape=box,color=blue];
		j2866095632 -> j3466202541;
		j2866095632 -> j2630167028;
	j446425186 [label="De la jalousie? Pourquoi?",shape=box,color=blue];
		j446425186 -> j2948486830;
	j1287255794 [label="Pourquoi?",shape=box,color=blue];
		j1287255794 -> j2535128503;
		j1287255794 -> j2107906108;
	j3466202541 [label="Нет, Архимедианцы были на ранг ниже Орокин.",shape=box,color=red];
		j3466202541 -> j1246465781;
	j2630167028 [label="Империя Орокин называется так потому, что ею правили Орокин, однако «Орокин» - это в первую очередь название правящего класса.",shape=box,color=red];
		j2630167028 -> j1246465781;
	j2948486830 [label="+10 Chemistry",color=orange];
		j2948486830 -> j179072030;
	j2535128503 [label="Честно говоря, немного удивительно, что ты знаешь о нём больше, чем я.",shape=box,color=red];
		j2535128503 -> j2948486830;
	j2107906108 [label="Я ничего не знаю о прошлом Лойда, хотя знаю его уже давно.",shape=box,color=red];
		j2107906108 -> j2948486830;
	j1246465781 [label="Это случается часто. Ты не одинока.",shape=box,color=red];
		j1246465781 -> j3682319871;
	j179072030 [label="Ох! Не принимай это на свой счёт, s’il vous plaît!",shape=box,color=blue];
		j179072030 -> j407790877;
	j3682319871 [label="Неужели Орокин намеренно сделали свое общество таким запутанным и непонятным?",shape=box,color=blue];
		j3682319871 -> j4234778405;
		j3682319871 -> j1385924757;
		j3682319871 -> j867752547;
	j407790877 [label="Monsieur Лойд, как бы это сказать, отстранён?",shape=box,color=blue];
		j407790877 -> j3053436830;
		j407790877 -> j4126005723;
	j4234778405 [label="Тысячи лет власти, и людям становится... скучно. Скучающие люди создают сложные системы.",shape=box,color=red];
		j4234778405 -> j3473336884;
	j1385924757 [label="Им было по вкусу вычурное и замысловатое. Это распространялось даже на бюрократию.",shape=box,color=red];
		j1385924757 -> j3473336884;
	j867752547 [label="Честно говоря? Я начинаю так думать.",shape=box,color=red];
		j867752547 -> j3473336884;
	j3053436830 [label="Я, по правде говоря, совсем ничего о нём не знаю.",shape=box,color=red];
		j3053436830 -> j3674174741;
	j4126005723 [label="Он немного замкнутый, да.",shape=box,color=red];
		j4126005723 -> j3674174741;
	j3473336884 [label="+10 Chemistry",color=orange];
		j3473336884 -> j4120355658;
	j3674174741 [label="Посмотри, с кем я провожу своё время, oui? Научись читать одну статую, и не так уж сложно научиться читать и другую.",shape=box,color=blue];
		j3674174741 -> j2576727352;
	j4120355658 [label="Думаю, они сделали это просто назло, чтобы раздражать!",shape=box,color=blue];
		j4120355658 -> j458268678;
	j2576727352 [label="+10 Chemistry",color=orange];
		j2576727352 -> j447583437;
	j458268678 [label="Et ils se demandent pourquoi des rébellions éclatent. Vous aviez peut-être vos warframes, mais nous avions nos guillotines!",shape=box,color=blue];
		j458268678 -> j2923775295;
	j447583437 [label="Хотя должна признать, Monsieur Лойд чуть более… пикантен, чем милый Лион.",shape=box,color=blue];
		j447583437 -> j2698573996;
		j447583437 -> j3979832312;
	j2923775295 [label="Vive la révolution!",shape=box,color=blue];
		j2923775295 -> j3553927258;
		j2923775295 -> j2212558226;
		j2923775295 -> j1610717093;
	j2698573996 [label="У него есть на то свои причины.",shape=box,color=red];
		j2698573996 -> j2435036468;
	j3979832312 [label="Ну ладно... Какой у тебя был вопрос?",shape=box,color=red];
		j3979832312 -> j925311712;
	j3553927258 [label="Стоит ли мне беспокоиться?",shape=box,color=red];
		j3553927258 -> j532979150;
	j2212558226 [label="Vive la révolution! Я думаю.",shape=box,color=red];
		j2212558226 -> j2382515922;
	j1610717093 [label="Я не совсем понимаю, что сейчас произошло, но, кажется, я согласен?",shape=box,color=red];
		j1610717093 -> j2382515922;
	j2435036468 [label="Да, безусловно, есть.",shape=box,color=blue];
		j2435036468 -> j620213464;
	j925311712 [label="Ах! Да.",shape=box,color=blue];
		j925311712 -> j620213464;
	j532979150 [label="Не обращай на меня внимания, я просто немного забавляюсь. Глупенькая маленькая Мари la révolutionnaire.",shape=box,color=blue];
		j532979150 -> j3795075935;
	j2382515922 [label="+10 Chemistry",color=orange];
		j2382515922 -> j532979150;
	j620213464 [label="Боюсь, я совсем забыла, зачем пришла к тебе! Ха! Ну что ж, вспомню позже.",shape=box,color=blue];
		j620213464 -> j157879778;
	j3795075935 [label="Спасибо, что ответил на мой вопрос. Пожалуй, я тебя отпущу. ",shape=box,color=blue];
		j3795075935 -> j157879778;
	j157879778 [label="Прошу прощения, что нарушила твое спокойствие. Будь то день, вечер или какое бы ни было время там, где ты сейчас находишься.",shape=box,color=blue];
		j157879778 -> j3429743066;
	j3429743066 [label="À la revoyure!",shape=box,color=blue];
		j3429743066 -> "Chat ends.";
}