		1229 -> 1233;
	1228 [label="[Конец.]",shape=box,color=red];
		1228 -> 1232;
	1235 [label="Он рассказывал мне о своей юности. Ai-je fait quelque chose qui vous a offensé?",shape=box,color=blue];
		1235 -> 1237;
		1235 -> 1238;
	1234 [label="Я не понимаю. Ai-je fait quelque chose qui vous avez offensé?",shape=box,color=blue];
		1234 -> 1237;
		1234 -> 1238;
	1233 [label="Архимедианцы - были ли они Орокин? Или нет? Это слово употребляется с таким легкомыслием.",shape=box,color=blue];
		1233 -> 1236;
	1232 [label="Chat ends.",color=orange];
	1237 [label="Наверное, я просто... завидую.",shape=box,color=red];
		1237 -> 1241;
	1238 [label="Наверное, просто испытываю удивление.",shape=box,color=red];
		1238 -> 1242;
	1236 [label="Наверное, я могла бы спросить у дьявола… Но если есть возможность, я предпочитаю с ним не говорить.",shape=box,color=blue];
		1236 -> 1239;
		1236 -> 1240;
	1241 [label="De la jalousie? Pourquoi?",shape=box,color=blue];
		1241 -> 1244;
	1242 [label="Pourquoi?",shape=box,color=blue];
		1242 -> 1245;
		1242 -> 1246;
	1239 [label="Нет, Архимедианцы были на ранг ниже Орокин.",shape=box,color=red];
		1239 -> 1243;
	1240 [label="Империя Орокин называется так потому, что ею правили Орокин, однако «Орокин» - это в первую очередь название правящего класса.",shape=box,color=red];
		1240 -> 1243;
	1244 [label="+10 Chemistry",color=orange];
		1244 -> 1248;
	1245 [label="Честно говоря, немного удивительно, что ты знаешь о нём больше, чем я.",shape=box,color=red];
		1245 -> 1244;
	1246 [label="Я ничего не знаю о прошлом Лойда, хотя знаю его уже давно.",shape=box,color=red];
		1246 -> 1244;
	1243 [label="Это случается часто. Ты не одинока.",shape=box,color=red];
		1243 -> 1247;
	1248 [label="Ох! Не принимай это на свой счёт, s’il vous plaît!",shape=box,color=blue];
		1248 -> 1252;
	1247 [label="Неужели Орокин намеренно сделали свое общество таким запутанным и непонятным?",shape=box,color=blue];
		1247 -> 1249;
		1247 -> 1250;
		1247 -> 1251;
	1252 [label="Monsieur Лойд, как бы это сказать, отстранён?",shape=box,color=blue];
		1252 -> 1254;
		1252 -> 1255;
	1249 [label="Тысячи лет власти, и людям становится... скучно. Скучающие люди создают сложные системы.",shape=box,color=red];
		1249 -> 1253;
	1250 [label="They had a taste for the ornate and the intricate. It extended to bureaucracy.",shape=box,color=red];
		1250 -> 1253;
	1251 [label="Честно говоря? Я начинаю так думать.",shape=box,color=red];
		1251 -> 1253;
	1254 [label="Я, по правде говоря, совсем ничего о нём не знаю.",shape=box,color=red];
		1254 -> 1257;
	1255 [label="Он немного замкнутый, да.",shape=box,color=red];
		1255 -> 1257;
	1253 [label="+10 Chemistry",color=orange];
		1253 -> 1256;
	1257 [label="Посмотри, с кем я провожу своё время, oui? Научись читать одну статую, и не так уж сложно научиться читать и другую.",shape=box,color=blue];
		1257 -> 1259;
	1256 [label="Думаю, они сделали это просто назло, чтобы раздражать!",shape=box,color=blue];
		1256 -> 1258;
	1259 [label="+10 Chemistry",color=orange];
		1259 -> 1261;
	1258 [label="Et ils se demandent pourquoi des rébellions éclatent. Vous aviez peut-être vos warframes, mais nous avions nos guillotines!",shape=box,color=blue];
		1258 -> 1260;
	1261 [label="Хотя должна признать, Monsieur Лойд чуть более… пикантен, чем милый Лион.",shape=box,color=blue];
		1261 -> 1265;
		1261 -> 1266;
	1260 [label="Vive la révolution!",shape=box,color=blue];
		1260 -> 1262;
		1260 -> 1263;
