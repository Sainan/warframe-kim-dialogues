digraph {
	237 [label="MarieRank1Convo4 begins.",color=orange];
		237 -> 238;
	238 [label="Могу ли я задать вопрос, который, надеюсь, не покажется невежливым? Это всё ещё только начало нашей дружбы, особенно для тебя, ведь вы знаете друг друга столько лет.",shape=box,color=blue];
		238 -> 241;
		238 -> 240;
		238 -> 239;
	241 [label="Честно говоря, мною забыто большинство из прожитых лет. ",shape=box,color=red];
		241 -> 244;
	240 [label="Конечно, я не против. Продолжай.",shape=box,color=red];
		240 -> 243;
	239 [label="[Конец.]",shape=box,color=red];
		239 -> 242;
	244 [label="Сол! Ты разбиваешь моё сердце этими словами. У тебя и у дьявола ум, словно книга с вырванными главами, non?",shape=box,color=blue];
		244 -> 246;
		244 -> 247;
	243 [label="+5 Chemistry",color=orange];
		243 -> 245;
	242 [label="Chat ends.",color=orange];
	246 [label="Я не скучаю по прошлому, которого не помню.",shape=box,color=red];
		246 -> 250;
	247 [label="Если по очень разным причинам, то да.",shape=box,color=red];
		247 -> 251;
	245 [label="Evaluate expressions on HellKeyPlayed",color=orange];
		245 -> 249 [label="x > 0",color=purple];
		245 -> 248 [label="x <= 0",color=purple];
		245 -> 248 [label="false",color=purple];
	250 [label="Правда? Тогда, кажется, только ты одна не знаешь. Среди ребёнка и дьявола, похоже, все ищут части себя, которые потеряли.",shape=box,color=blue];
		250 -> 255;
		250 -> 256;
	251 [label="Могу я спросить, почему ты чувствуешь себя таким одиноким? Причины ребёнка и дьявола мне известны, а твои нет.",shape=box,color=blue];
		251 -> 255;
		251 -> 256;
	249 [label="Почему ты согласилась помочь дьяволу в его начинаниях? Я слышала, что именно на тебе ответственность за истребление его рода.",shape=box,color=blue];
		249 -> 252;
		249 -> 253;
		249 -> 254;
	248 [label="Ты собираешься помочь дьяволу в его начинаниях? Я слышала, что именно на тебе ответственность за истребление его рода.",shape=box,color=blue];
		248 -> 252;
		248 -> 253;
		248 -> 254;
	255 [label="Бесконечно неизвестное количество лет было проведено в разнообразных смертях от рук... хм? Моих же. Я не возражаю против того, что не могу помнить каждую из этих смертей.",shape=box,color=red];
		255 -> 260;
	256 [label="Если коротко, то мне... пришлось провести огромное количество лет в страданиях. Думаю, это какой-то механизм самозащиты. Ну, я о забывании.",shape=box,color=red];
		256 -> 261;
	252 [label="Это было моё второе я. Я верю в вину отдельных лиц, а не общества.",shape=box,color=red];
		252 -> 257;
	253 [label="Это был не я, а ребёнок. Но я ненавижу Орокин так же сильно, как и ребёнок.",shape=box,color=red];
		253 -> 258;
	254 [label="Меня не было в ту ночь, Ночь Барабанов Нага, когда Тэнно восстали против Орокин. Это был ребёнок.",shape=box,color=red];
		254 -> 259;
	260 [label="И я не виню тебя. Если бы со мной обращались подобным образом, я бы тоже поспешила бы всё это поглубже упрятать. Уж точно не стала бы копаться в этом снова.",shape=box,color=blue];
		260 -> 265;
	261 [label="Без сомнений! Если я буду подвержена такому обращению, душа моя, пожалуй, сделала бы то же самое. Cпрятав всё, что невозможно исцелить и что не приносит пользы.",shape=box,color=blue];
		261 -> 265;
	257 [label="Add 1 to Thermostat",color=orange];
		257 -> 262;
	258 [label="Add -1 to Thermostat",color=orange];
		258 -> 263;
	259 [label="Ночь Барабанов Нага. О, я уже это себе представляю. Quelles couleurs magnifiques!",shape=box,color=blue];
		259 -> 264;
	265 [label="+5 Chemistry",color=orange];
		265 -> 268;
	262 [label="Oui, je comprends. Так легко мы готовы спалить дом до тла, лишь за то, что крысы в его стенах воняют.",shape=box,color=blue];
		262 -> 266;
	263 [label="Je meurs d'envie de savoir pourquoi! Оставим этот разговор на другой раз. Иначе мы тут будем вечно, и Monsieur Лойд рассердится на меня.",shape=box,color=blue];
		263 -> 267;
	264 [label="Мне придётся обсудить это с Monsieur Лойдом, чтобы узнать побольше деталей. Но!",shape=box,color=blue];
		264 -> 267;
	268 [label="Хотя, возможно, это даст мне некоторое представление о том, о чём я хотела поговорить с тобой.",shape=box,color=blue];
		268 -> 245;
	266 [label="Но оставим этот разговор на другой раз, иначе мы тут будем вечно, и Monsieur Лойд рассердится на меня.",shape=box,color=blue];
		266 -> 267;
	267 [label="Evaluate expressions on HellKeyPlayed",color=orange];
		267 -> 270 [label="x > 0",color=purple];
		267 -> 269 [label="x <= 0",color=purple];
		267 -> 269 [label="false",color=purple];
	270 [label="Pardonnez-moi! Я ведь совсем даже не дала тебе возможность ответить. Так почему ты окажешь помощь дьяволу?",shape=box,color=blue];
		270 -> 274;
		270 -> 273;
		270 -> 272;
		270 -> 271;
	269 [label="Pardonnez-moi! Я ведь совсем даже не дала тебе возможность ответить. Так окажешь ли ты помощь дьяволу?",shape=box,color=blue];
		269 -> 271;
		269 -> 272;
		269 -> 273;
		269 -> 274;
	274 [label="Он ещё не сделал ничего, чтобы доказать, что не заслуживает помощи... пока.",shape=box,color=red];
		274 -> 278;
	273 [label="Не думаю, что мне стоит отказываться от союзников.",shape=box,color=red];
		273 -> 277;
	272 [label="[Признаться в интересе к Роуту.] В нём есть что-то притягательное...",shape=box,color=red];
		272 -> 276;
	271 [label="Похоже, он просто делает то, что нужно, чтобы выжить. Не могу его за это винить.",shape=box,color=red];
		271 -> 275;
	278 [label="Add 1 to Thermostat",color=orange];
		278 -> 282;
	277 [label="Update boolean MarieRoatheSoldier",color=orange];
		277 -> 281;
	276 [label="Update boolean DrifterRoathe",color=orange];
		276 -> 280;
	275 [label="Add -1 to Thermostat",color=orange];
		275 -> 279;
	282 [label="+5 Chemistry",color=orange];
		282 -> 285;
	281 [label="Ах, я понимаю. Ты просто занят тем, что собираешь себе солдат. Но тот дьявол скорее вонзит тебе кинжал между рёбер, чем прикроет твою спину.",shape=box,color=blue];
		281 -> 284;
	280 [label="Le diable séduit les cœurs les plus forts. Он ведёт хитрую игру, так что будь осторожен. Убедись, что он встретится с твоим взглядом и ни с чем больше.",shape=box,color=blue];
		280 -> 283;
	279 [label="Кажется, он задержался на этом свете куда дольше, чем кому-либо позволено. Я думаю, аду пора вернуть то, что ему принадлежит, оно явно загуляло.",shape=box,color=blue];
		279 -> 283;
	285 [label="Я восхищаюсь твоим состраданием, оно наполняет моё сердце радостью. Светила учат нас, что помощь можно даровать каждому. Каждого можно простить. Но... только если он сам этого ищет.",shape=box,color=blue];
		285 -> 290;
	284 [label="Он не является твоим союзником и никогда не станет им. Тот дьявол встанет на сторону лишь тех, кто служит его нуждам.",shape=box,color=blue];
		284 -> 287;
		284 -> 288;
		284 -> 289;
	283 [label="+5 Chemistry",color=orange];
		283 -> 286;
	290 [label="Бесконечный труд во благо тех, кто и пальцем не пошевелит на ниве собственного искупления, это жизнь раба, обречённого на вечный голод.",shape=box,color=blue];
		290 -> 287;
		290 -> 288;
		290 -> 289;
	287 [label="Я знаю об Орокин и его ситуации более твоего. Мне не нужна твоя помощь.",shape=box,color=red];
		287 -> 291;
	288 [label="Я ценю твои предупреждения. Я учту их, когда буду иметь с ним дело.",shape=box,color=red];
		288 -> 292;
	289 [label="Спасибо. Но я умею о себе позаботиться. И, что более важно? Приходилось иметь дело и с более серьёзными случаями.",shape=box,color=red];
		289 -> 293;
	286 [label="Пожалуй, я говорю слишком резко... ты ведь не знаешь его. Ты не видишь его, какой он на самом деле. Я лишь не хочу, чтобы тебе была причинена боль.",shape=box,color=blue];
		286 -> 287;
		286 -> 288;
		286 -> 289;
	291 [label="Update boolean MarieRoatheWarning",color=orange];
		291 -> 294;
	292 [label="+10 Chemistry",color=orange];
		292 -> 295;
	293 [label="+5 Chemistry",color=orange];
		293 -> 296;
	294 [label="Pardon. Я едва тебя знаю или не ведаю, насколько ты способен устоять перед чьими-то уловками. Я просто беспокоюсь, ведь мы свалили на тебя свои беды.",shape=box,color=blue];
		294 -> 297;
	295 [label="Это всё, о чём я мог просить. Merci, merci, merci. А теперь, боюсь, мне пора.",shape=box,color=blue];
		295 -> 298;
	296 [label="Oui, vous avez raison. Я едва тебя знаю или не ведаю, есть ли у тебя способность устоять перед чьими-то уловками. Я просто беспокоюсь, ведь мы свалили на тебя свои беды.",shape=box,color=blue];
		296 -> 299;
	297 [label="Больше не переступлю дозволенного.",shape=box,color=blue];
		297 -> 300;
	298 [label="Chat ends.",color=orange];
	299 [label="А теперь, боюсь, мне пора.",shape=box,color=blue];
		299 -> 301;
	300 [label="Chat ends.",color=orange];
	301 [label="Chat ends.",color=orange];
}