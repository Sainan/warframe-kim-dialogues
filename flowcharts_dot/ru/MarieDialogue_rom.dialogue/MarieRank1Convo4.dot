digraph {
	graph [fontname="Roboto Condensed"];
	node [fontname="Roboto Condensed"];
	edge [fontname="Roboto Condensed"];

	"MarieRank1Convo4 begins." [color=orange];
		"MarieRank1Convo4 begins." -> j2959068802;
	j2959068802 [label="Могу ли я задать вопрос, который, надеюсь, не покажется невежливым? Это всё ещё только начало нашей дружбы, особенно для тебя, ведь вы знаете друг друга столько лет.",shape=box,color=blue];
		j2959068802 -> j1403309128;
		j2959068802 -> j2442680028;
		j2959068802 -> j1310452999;
	j1403309128 [label="Честно говоря, мною забыто большинство из прожитых лет. ",shape=box,color=red];
		j1403309128 -> j3455204361;
	j2442680028 [label="Конечно, я не против. Продолжай.",shape=box,color=red];
		j2442680028 -> j2947588656;
	j1310452999 [label="[Конец.]",shape=box,color=red];
		j1310452999 -> "Chat ends.";
	j3455204361 [label="Сол! Ты разбиваешь моё сердце этими словами. У тебя и у дьявола ум, словно книга с вырванными главами, non?",shape=box,color=blue];
		j3455204361 -> j4246503745;
		j3455204361 -> j3794593608;
	j2947588656 [label="+5 Chemistry",color=orange];
		j2947588656 -> j523704316;
	"Chat ends." [color=orange];
	j4246503745 [label="Я не скучаю по прошлому, которого не помню.",shape=box,color=red];
		j4246503745 -> j3646135597;
	j3794593608 [label="Если по очень разным причинам, то да.",shape=box,color=red];
		j3794593608 -> j92375932;
	j523704316 [label="Evaluate expressions on HellKeyPlayed counter",color=orange];
		j523704316 -> j3275911590 [label="x > 0",color=purple];
		j523704316 -> j2059099487 [label="x <= 0",color=purple];
		j523704316 -> j2059099487 [label="false",color=purple];
	j3646135597 [label="Правда? Тогда, кажется, только ты одна не знаешь. Среди ребёнка и дьявола, похоже, все ищут части себя, которые потеряли.",shape=box,color=blue];
		j3646135597 -> j3008205355;
		j3646135597 -> j3869102384;
	j92375932 [label="Могу я спросить, почему ты чувствуешь себя таким одиноким? Причины ребёнка и дьявола мне известны, а твои нет.",shape=box,color=blue];
		j92375932 -> j3008205355;
		j92375932 -> j3869102384;
	j3275911590 [label="Почему ты согласилась помочь дьяволу в его начинаниях? Я слышала, что именно на тебе ответственность за истребление его рода.",shape=box,color=blue];
		j3275911590 -> j3890351016;
		j3275911590 -> j1708515904;
		j3275911590 -> j1996925078;
	j2059099487 [label="Ты собираешься помочь дьяволу в его начинаниях? Я слышала, что именно на тебе ответственность за истребление его рода.",shape=box,color=blue];
		j2059099487 -> j3890351016;
		j2059099487 -> j1708515904;
		j2059099487 -> j1996925078;
	j3008205355 [label="Бесконечно неизвестное количество лет было проведено в разнообразных смертях от рук... хм? Моих же. Я не возражаю против того, что не могу помнить каждую из этих смертей.",shape=box,color=red];
		j3008205355 -> j1962377460;
	j3869102384 [label="Если коротко, то мне... пришлось провести огромное количество лет в страданиях. Думаю, это какой-то механизм самозащиты. Ну, я о забывании.",shape=box,color=red];
		j3869102384 -> j1389952570;
	j3890351016 [label="Это было моё второе я. Я верю в вину отдельных лиц, а не общества.",shape=box,color=red];
		j3890351016 -> j421812356;
	j1708515904 [label="Это был не я, а ребёнок. Но я ненавижу Орокин так же сильно, как и ребёнок.",shape=box,color=red];
		j1708515904 -> j3025920740;
	j1996925078 [label="Меня не было в ту ночь, Ночь Барабанов Нага, когда Тэнно восстали против Орокин. Это был ребёнок.",shape=box,color=red];
		j1996925078 -> j1057535869;
	j1962377460 [label="И я не виню тебя. Если бы со мной обращались подобным образом, я бы тоже поспешила бы всё это поглубже упрятать. Уж точно не стала бы копаться в этом снова.",shape=box,color=blue];
		j1962377460 -> j2031738739;
	j1389952570 [label="Без сомнений! Если я буду подвержена такому обращению, душа моя, пожалуй, сделала бы то же самое. Cпрятав всё, что невозможно исцелить и что не приносит пользы.",shape=box,color=blue];
		j1389952570 -> j2031738739;
	j421812356 [label="Add 1 to Thermostat counter",color=orange];
		j421812356 -> j4270268175;
	j3025920740 [label="Add -1 to Thermostat counter",color=orange];
		j3025920740 -> j2381603224;
	j1057535869 [label="Ночь Барабанов Нага. О, я уже это себе представляю. Quelles couleurs magnifiques!",shape=box,color=blue];
		j1057535869 -> j1618346257;
	j2031738739 [label="+5 Chemistry",color=orange];
		j2031738739 -> j4037740539;
	j4270268175 [label="Oui, je comprends. Так легко мы готовы спалить дом до тла, лишь за то, что крысы в его стенах воняют.",shape=box,color=blue];
		j4270268175 -> j2790843343;
	j2381603224 [label="Je meurs d'envie de savoir pourquoi! Оставим этот разговор на другой раз. Иначе мы тут будем вечно, и Monsieur Лойд рассердится на меня.",shape=box,color=blue];
		j2381603224 -> j4192617946;
	j1618346257 [label="Мне придётся обсудить это с Monsieur Лойдом, чтобы узнать побольше деталей. Но!",shape=box,color=blue];
		j1618346257 -> j4192617946;
	j4037740539 [label="Хотя, возможно, это даст мне некоторое представление о том, о чём я хотела поговорить с тобой.",shape=box,color=blue];
		j4037740539 -> j523704316;
	j2790843343 [label="Но оставим этот разговор на другой раз, иначе мы тут будем вечно, и Monsieur Лойд рассердится на меня.",shape=box,color=blue];
		j2790843343 -> j4192617946;
	j4192617946 [label="Evaluate expressions on HellKeyPlayed counter",color=orange];
		j4192617946 -> j1872410928 [label="x > 0",color=purple];
		j4192617946 -> j3799713432 [label="x <= 0",color=purple];
		j4192617946 -> j3799713432 [label="false",color=purple];
	j1872410928 [label="Pardonnez-moi! Я ведь совсем даже не дала тебе возможность ответить. Так почему ты окажешь помощь дьяволу?",shape=box,color=blue];
		j1872410928 -> j2015490752;
		j1872410928 -> j2212133314;
		j1872410928 -> j3027890639;
		j1872410928 -> j452590830;
	j3799713432 [label="Pardonnez-moi! Я ведь совсем даже не дала тебе возможность ответить. Так окажешь ли ты помощь дьяволу?",shape=box,color=blue];
		j3799713432 -> j452590830;
		j3799713432 -> j3027890639;
		j3799713432 -> j2212133314;
		j3799713432 -> j2015490752;
	j2015490752 [label="Он ещё не сделал ничего, чтобы доказать, что не заслуживает помощи... пока.",shape=box,color=red];
		j2015490752 -> j3803735300;
	j2212133314 [label="Не думаю, что мне стоит отказываться от союзников.",shape=box,color=red];
		j2212133314 -> j1229718408;
	j3027890639 [label="[Признаться в интересе к Роуту.] В нём есть что-то притягательное...",shape=box,color=red];
		j3027890639 -> j2298547945;
	j452590830 [label="Похоже, он просто делает то, что нужно, чтобы выжить. Не могу его за это винить.",shape=box,color=red];
		j452590830 -> j3285575763;
	j3803735300 [label="Add 1 to Thermostat counter",color=orange];
		j3803735300 -> j3172712430;
	j1229718408 [label="Boolean MarieRoatheSoldier is now true.",color=orange];
		j1229718408 -> j1443567920;
	j2298547945 [label="Boolean DrifterRoathe is now true.",color=orange];
		j2298547945 -> j2513655109;
	j3285575763 [label="Add -1 to Thermostat counter",color=orange];
		j3285575763 -> j1412702358;
	j3172712430 [label="+5 Chemistry",color=orange];
		j3172712430 -> j1955492502;
	j1443567920 [label="Ах, я понимаю. Ты просто занят тем, что собираешь себе солдат. Но тот дьявол скорее вонзит тебе кинжал между рёбер, чем прикроет твою спину.",shape=box,color=blue];
		j1443567920 -> j1394919497;
	j2513655109 [label="Le diable séduit les cœurs les plus forts. Он ведёт хитрую игру, так что будь осторожен. Убедись, что он встретится с твоим взглядом и ни с чем больше.",shape=box,color=blue];
		j2513655109 -> j332468635;
	j1412702358 [label="Кажется, он задержался на этом свете куда дольше, чем кому-либо позволено. Я думаю, аду пора вернуть то, что ему принадлежит, оно явно загуляло.",shape=box,color=blue];
		j1412702358 -> j332468635;
	j1955492502 [label="Я восхищаюсь твоим состраданием, оно наполняет моё сердце радостью. Светила учат нас, что помощь можно даровать каждому. Каждого можно простить. Но... только если он сам этого ищет.",shape=box,color=blue];
		j1955492502 -> j1806682169;
	j1394919497 [label="Он не является твоим союзником и никогда не станет им. Тот дьявол встанет на сторону лишь тех, кто служит его нуждам.",shape=box,color=blue];
		j1394919497 -> j1186727947;
		j1394919497 -> j1225622096;
		j1394919497 -> j1692965988;
	j332468635 [label="+5 Chemistry",color=orange];
		j332468635 -> j2849544626;
	j1806682169 [label="Бесконечный труд во благо тех, кто и пальцем не пошевелит на ниве собственного искупления, это жизнь раба, обречённого на вечный голод.",shape=box,color=blue];
		j1806682169 -> j1186727947;
		j1806682169 -> j1225622096;
		j1806682169 -> j1692965988;
	j1186727947 [label="Я знаю об Орокин и его ситуации более твоего. Мне не нужна твоя помощь.",shape=box,color=red];
		j1186727947 -> j1868657674;
	j1225622096 [label="Я ценю твои предупреждения. Я учту их, когда буду иметь с ним дело.",shape=box,color=red];
		j1225622096 -> j1716472294;
	j1692965988 [label="Спасибо. Но я умею о себе позаботиться. И, что более важно? Приходилось иметь дело и с более серьёзными случаями.",shape=box,color=red];
		j1692965988 -> j3279675148;
	j2849544626 [label="Пожалуй, я говорю слишком резко... ты ведь не знаешь его. Ты не видишь его, какой он на самом деле. Я лишь не хочу, чтобы тебе была причинена боль.",shape=box,color=blue];
		j2849544626 -> j1186727947;
		j2849544626 -> j1225622096;
		j2849544626 -> j1692965988;
	j1868657674 [label="Boolean MarieRoatheWarning is now true.",color=orange];
		j1868657674 -> j2713978539;
	j1716472294 [label="+10 Chemistry",color=orange];
		j1716472294 -> j723363340;
	j3279675148 [label="+5 Chemistry",color=orange];
		j3279675148 -> j3741022137;
	j2713978539 [label="Pardon. Я едва тебя знаю или не ведаю, насколько ты способен устоять перед чьими-то уловками. Я просто беспокоюсь, ведь мы свалили на тебя свои беды.",shape=box,color=blue];
		j2713978539 -> j408989875;
	j723363340 [label="Это всё, о чём я мог просить. Merci, merci, merci. А теперь, боюсь, мне пора.",shape=box,color=blue];
		j723363340 -> "Chat ends.";
	j3741022137 [label="Oui, vous avez raison. Я едва тебя знаю или не ведаю, есть ли у тебя способность устоять перед чьими-то уловками. Я просто беспокоюсь, ведь мы свалили на тебя свои беды.",shape=box,color=blue];
		j3741022137 -> j323837587;
	j408989875 [label="Больше не переступлю дозволенного.",shape=box,color=blue];
		j408989875 -> "Chat ends.";
	j323837587 [label="А теперь, боюсь, мне пора.",shape=box,color=blue];
		j323837587 -> "Chat ends.";
}