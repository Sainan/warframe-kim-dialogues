digraph {
	graph [fontname="Roboto Condensed"];
	node [fontname="Roboto Condensed"];
	edge [fontname="Roboto Condensed"];

	"MarieRoatheRepair begins." [color=orange];
		"MarieRoatheRepair begins." -> j4217867269;
	j4217867269 [label="Evaluate expressions",color=orange];
		j4217867269 -> j1893313190 [label="RoatheMarieDatingDeal, MarieNoDate",color=purple];
		j4217867269 -> j1991339607 [label="RoatheFamilyDeal, MarieFamilyFail",color=purple];
		j4217867269 -> j1991339607 [label="MarieFamilyFail",color=purple];
		j4217867269 -> j3197039802 [label="RoatheMarieEntratiDeal, MarieEntratiCompleteB",color=purple];
		j4217867269 -> j3197039802 [label="RoatheMarieEntratiDeal, MarieEntratiCompleteC",color=purple];
		j4217867269 -> "Chat ends." [label="false",color=purple];
	j1893313190 [label="Скиталец. Меня преследует дьявол. Он без конца донимает меня своими мелкими извергами! Всё от твоего имени! Он говорит, что ты просто хочешь извиниться, преклонив колено.",shape=box,color=blue];
		j1893313190 -> j2699157939;
		j1893313190 -> j3520716075;
	j1991339607 [label="Меня преследует дьявол. Он бесконечно меня раздражает своими мелкими мерзавцами! И всё во имя ваше! Он говорит, что ты хочешь обсудить мою помощь в том, чтобы поднять Monsieur Лойда наверх?",shape=box,color=blue];
		j1991339607 -> j3017269797;
		j1991339607 -> j3520716075;
	j3197039802 [label="Меня преследует дьявол. Он бесконечно меня раздражает своими мелкими мерзавцами! И всё во имя твоё! Он говорит, что ты хочешь ещё раз обсудить мою преданность le Cardinal?",shape=box,color=blue];
		j3197039802 -> j4111119478;
		j3197039802 -> j3520716075;
	"Chat ends." [color=orange];
	j2699157939 [label="Так.",shape=box,color=red];
		j2699157939 -> j2273559258;
	j3520716075 [label="Да, это так?",shape=box,color=red];
		j3520716075 -> j909419288;
	j3017269797 [label="Так.",shape=box,color=red];
		j3017269797 -> j4289985690;
	j4111119478 [label="Так.",shape=box,color=red];
		j4111119478 -> j2237432360;
	j2273559258 [label="Мне очень жаль. Мои слова обидели тебя. Мне не хотелось этого. Это было последнее, чего мне хотелось — поверь мне.",shape=box,color=red];
		j2273559258 -> j2529673145;
	j909419288 [label="Je vais le tuer! Je savais que ce ce démon était rempli de la pire merde qui soit! Je vais renvoyer ses concrits d'où ils viennent par la peau des fesses!",shape=box,color=blue];
		j909419288 -> "Chat ends.";
	j4289985690 [label="Я не буду долго задерживаться, так как он уже немало убедил меня в твоё отсутствие. И, как это свойственно дьяволу, он весьма убедительно это обосновал.",shape=box,color=blue];
		j4289985690 -> j2355494388;
	j2237432360 [label="Я не буду долго задерживаться, так как он уже немало убедил меня в твоё отсутствие. И, как это свойственно дьяволу, он весьма убедительно это обосновал.",shape=box,color=blue];
		j2237432360 -> j3512923543;
	j2529673145 [label="И почему же?",shape=box,color=blue];
		j2529673145 -> j785367584;
		j2529673145 -> j813499624;
	j2355494388 [label="И я признаю, что мне... начинает надоедать быть запертой здесь без возможности что-либо сделать.",shape=box,color=blue];
		j2355494388 -> j1772188527;
	j3512923543 [label="Но дело не в его словах, а в его уме. Он усадил меня рядом с Monsieur Лойдом.",shape=box,color=blue];
		j3512923543 -> j3177927292;
		j3512923543 -> j1227680441;
	j785367584 [label="[Признаться в чувствах.] Потому что ты мне очень дорога, Мари. Я тебя обожаю.",shape=box,color=red];
		j785367584 -> j4269075120;
	j813499624 [label="Неважно. Это была явная ошибка.",shape=box,color=red];
		j813499624 -> j2804469908;
	j1772188527 [label="Итак, я говорю: «Хорошо». Я помогу тебе. Ты получишь мою помощь.",shape=box,color=blue];
		j1772188527 -> j3151953893;
	j3177927292 [label="Да?",shape=box,color=red];
		j3177927292 -> j21360563;
	j1227680441 [label="Но Лойд любит Альбрехта, не так ли?",shape=box,color=red];
		j1227680441 -> j1043637825;
	j4269075120 [label="Я знаю, что сейчас сболтну лишнего. И, о чудо, так и было.",shape=box,color=red];
		j4269075120 -> j1667222165;
	j2804469908 [label="Ты ничем от него не отличаешься.",shape=box,color=blue];
		j2804469908 -> "Chat ends.";
	j3151953893 [label="Boolean MarieFamilySuccess is now true.",color=orange];
		j3151953893 -> j2529015854;
	j21360563 [label="Именно ясность зрения Лойда позволила мне видеть сквозь собственные затуманенные линзы. Ведь Лойд любит le Cardinal – своего Альбрехта – но всё же видит его со всеми его недостатками.",shape=box,color=blue];
		j21360563 -> j1777118101;
	j1043637825 [label="Да. Так и есть. И всё же я вижу его, несмотря на все его недостатки. И именно эта ясность взгляда позволила мне видеть сквозь собственные затуманенные линзы.",shape=box,color=blue];
		j1043637825 -> j1777118101;
	j1667222165 [label="Мне очень жаль, что мне пришлось обратиться к Роуту, чтобы привлечь твоё внимание, но у меня больше не было никого, к кому можно было обратиться.",shape=box,color=red];
		j1667222165 -> j3821846948;
	j2529015854 [label="Boolean MarieFamilyFail is now false.",color=orange];
		j2529015854 -> "Chat ends.";
	j1777118101 [label="Ибо что значит любить другого, как не принимать его таким, какой он есть, со всем его après tout?",shape=box,color=blue];
		j1777118101 -> j3722403271;
	j3821846948 [label="Ах, Скиталец... бедный мой Скиталец. Тебе не нужно было так далеко ходить, чтобы добиться моего прощения. ",shape=box,color=blue];
		j3821846948 -> j694564102;
	j3722403271 [label="Boolean MarieEntratiCompleteA is now true.",color=orange];
		j3722403271 -> j2737891827;
	j694564102 [label="Я бы отдала его тебе, надо было просто попросить. В моём сердце уже есть место для тебя, понимаешь?",shape=box,color=blue];
		j694564102 -> j308866073;
		j694564102 -> j955555735;
	j2737891827 [label="Boolean MarieEntratiCompleteB is now false.",color=orange];
		j2737891827 -> j3065315887;
	j308866073 [label="Я... честно?",shape=box,color=red];
		j308866073 -> j3513717900;
	j955555735 [label="Но мне пришлось пережить столько неприятностей...",shape=box,color=red];
		j955555735 -> j3513481783;
	j3065315887 [label="Boolean MarieEntratiCompleteC is now false.",color=orange];
		j3065315887 -> "Chat ends.";
	j3513717900 [label="Oui! И если ты хочешь быть вместе со мной, то я тоже этого хочу.",shape=box,color=blue];
		j3513717900 -> j3773098326;
		j3513717900 -> j3711066743;
	j3513481783 [label="И это твоя вина, а не моя! Но если ты хочешь быть со мной, то я тоже этого хочу.",shape=box,color=blue];
		j3513481783 -> j3711066743;
		j3513481783 -> j3773098326;
	j3773098326 [label="Мне бы это понравилось, Мари.",shape=box,color=red];
		j3773098326 -> j159924042;
	j3711066743 [label="Если подумать, то я в порядке.",shape=box,color=red];
		j3711066743 -> j3340021505;
	j159924042 [label="Ах! Я так счастлива!",shape=box,color=blue];
		j159924042 -> j1309863619;
	j3340021505 [label="Je vais te jeter dans le Néant.",shape=box,color=blue];
		j3340021505 -> "Chat ends.";
	j1309863619 [label="Boolean MarieDating is now true.",color=orange];
		j1309863619 -> j2139156819;
	j2139156819 [label="Boolean IsDating is now true.",color=orange];
		j2139156819 -> j312360870;
	j312360870 [label="Boolean MarieHasDated is now true.",color=orange];
		j312360870 -> j3947636400;
	j3947636400 [label="Boolean MarieWillDate is now true.",color=orange];
		j3947636400 -> j4047025782;
	j4047025782 [label="Boolean MarieNoDate is now false.",color=orange];
		j4047025782 -> "Chat ends.";
}