digraph {
	"MarieRank4Convo3 begins." [color=orange];
		"MarieRank4Convo3 begins." -> j2972471883;
		"MarieRank4Convo3 begins." -> j1310452999;
	j2972471883 [label="Как ты сегодня, Мари?",shape=box,color=red];
		j2972471883 -> j4141681980;
	j1310452999 [label="[Конец.]",shape=box,color=red];
		j1310452999 -> "Chat ends.";
	j4141681980 [label="Я не столь grand. Лучше давай завтра поговорим. Сегодня из меня так себе собеседник.",shape=box,color=blue];
		j4141681980 -> j3707033948;
		j4141681980 -> j1697027851;
		j4141681980 -> j515616913;
	"Chat ends." [color=orange];
	j3707033948 [label="Если хочешь, я уйду, но если желаешь поговорить, я останусь и выслушаю.",shape=box,color=red];
		j3707033948 -> j3133474140;
	j1697027851 [label="Всё норм, я понимаю.",shape=box,color=red];
		j1697027851 -> "Chat ends.";
	j515616913 [label="Могу ли я поинтересоваться, что случилось?..",shape=box,color=red];
		j515616913 -> j3133474140;
	j3133474140 [label="C'est vraiment gentil, но это старая проблема... не стоит тебе из-за неё волноваться. Со мной всё будет в порядке.",shape=box,color=blue];
		j3133474140 -> j3096270068;
	j3096270068 [label="Boolean MarieChronicPain is now true.",color=orange];
		j3096270068 -> j2127159289;
		j3096270068 -> j2839237449;
		j3096270068 -> j4227075029;
	j2127159289 [label="Хорошо, если ты уверена, но знай - я рядом, если захочешь поговорить об этом.",shape=box,color=red];
		j2127159289 -> j2896736564;
	j2839237449 [label="Я… знаю, каково это. Прежде чем начались мои «зацикливания», меня сильно поранило в Дувири. Рана зажила, но время от времени всё ещё ужасно ноет. Я стараюсь скрыть, когда боль возвращается.",shape=box,color=red];
		j2839237449 -> j3601169395;
	j4227075029 [label="Старые, неразрешённые проблемы могут быть не менее трудными, чем новые. То, что они приходят и уходят, остаются с нами, вовсе не значит, что о них не стоит говорить.",shape=box,color=red];
		j4227075029 -> j1745312648;
	j2896736564 [label="Это очень любезно с твоей стороны, и... это очень хорошо. Я снова становлюсь маленькой упрямой Мари.",shape=box,color=blue];
		j2896736564 -> j862112314;
	j3601169395 [label="Boolean DrifterChronicPain is now true.",color=orange];
		j3601169395 -> j4020770547;
	j1745312648 [label="Oui, tu as raison. Я снова становлюсь маленькой упрямой Мари.",shape=box,color=blue];
		j1745312648 -> j862112314;
	j862112314 [label="Это трудно объяснить, но я попробую. Mes pieds, oui? Мои ноги. Sérum изменила меня, подарила мне возможность летать -",shape=box,color=blue];
		j862112314 -> j1263148081;
	j4020770547 [label="Par les Luminaires, мне очень жаль. Ты понимаешь, каково это, oui?",shape=box,color=blue];
		j4020770547 -> j3517377219;
	j1263148081 [label="Но я всё ещё чувствую их, эти искажённые, зловещие силы, что грозили поглотить меня, раздавить всю надежду и радость в моей душе.",shape=box,color=blue];
		j1263148081 -> j1304735647;
	j3517377219 [label="Иметь тело, которое предаёт тебя, которое замедляет твой дух… Даже теперь это кажется таким странным. Sérum изменила меня, подарила мне возможность летать -",shape=box,color=blue];
		j3517377219 -> j1263148081;
	j1304735647 [label="Они всегда причиняют боль. Всегда. Даже сейчас, когда я сижу здесь, стоит мне о них подумать, и я чувствую эту боль. Но бывает, что просто замечать её недостаточно.",shape=box,color=blue];
		j1304735647 -> j750788941;
	j750788941 [label="Но всё же боль до сих пор просыпается во мне по ночам. И я задаюсь вопросом, Сол, pourquoi? Зачем мне всё это... agonie interminable?",shape=box,color=blue];
		j750788941 -> j4059861911;
	j4059861911 [label="Какой цели это служит? Ах, но вот наступает утро, и я смеюсь, говоря себе: «Успокойся, Мари, ты благословенна. Посмотри, что у тебя есть и на что ты способна».",shape=box,color=blue];
		j4059861911 -> j1465055768;
	j1465055768 [label="В Cathédrale это звучало так: «Ты умеешь читать, писать, есть, спать. Ты можешь двигаться достаточно хорошо. У тебя есть глаза, чтобы видеть, и язык, чтобы говорить. Руки, чтобы писать. Окружающие, что заботятся о тебе». А теперь я могу летать! Могу защищать будущее от самой Бездны. От l'Indifférence!",shape=box,color=blue];
		j1465055768 -> j3545466673;
	j3545466673 [label="«Плачь сейчас, глупышка, эта постоянная боль сделает тебя сильнее перед лицом грядущего», — говорю себе я. И день сменяет другой, и с каждым новым становится чуть легче.",shape=box,color=blue];
		j3545466673 -> j830269311;
	j830269311 [label="Check boolean DrifterChronicPain",color=orange];
		j830269311 -> j340347055 [label=true,color=green];
		j830269311 -> j3184388987 [label=true,color=green];
		j830269311 -> j3603776293 [label=false,color=brown];
		j830269311 -> j1963409996 [label=false,color=brown];
	j340347055 [label="Если уж какая-то одна вещь и была дана нам, так это умением терпеть боль, пожалуй.",shape=box,color=red];
		j340347055 -> j3694642222;
	j3184388987 [label="Хотя иногда... я просыпаюсь с ощущением, что именно этот день станет тем, когда я не выдержу.",shape=box,color=red];
		j3184388987 -> j3694642222;
	j3603776293 [label="И боль... действительно никогда не перестаёт? Прости, Мари, мне ужасно жаль...",shape=box,color=red];
		j3603776293 -> j1766422781;
	j1963409996 [label="И нет никакого лекарства? Никакого лечения?",shape=box,color=red];
		j1963409996 -> j340093422;
	j3694642222 [label="Однажды один прихожанин спросил меня: «Ты страдаешь? Всегда?» На что я ответила: «Oui, monsieur. Je le suis.» В его взгляде изумление смешалось с ужасом.",shape=box,color=blue];
		j3694642222 -> j3495820152;
	j1766422781 [label="Иногда, я задумывалась, чего бы только смогла достичь, не будь этой agonie, oui? Не будь я заключена в эту плотскую темницу, что так настойчиво ставит преграды повсюду.",shape=box,color=blue];
		j1766422781 -> j4257707771;
	j340093422 [label="Хотела бы, чтобы было. Mais non, нет. Не в моё время, и, боюсь, в этом тоже вряд ли.",shape=box,color=blue];
		j340093422 -> j967607053;
	j3495820152 [label="Следом он спросил: «Как ты живёшь с этим?» И я помню, что я лишь улыбнулась ему и отвечала: «А какой у меня есть выбор, Monsieur...?»",shape=box,color=blue];
		j3495820152 -> j3707672817;
		j3495820152 -> j2142555632;
	j4257707771 [label="Как же это меня злило бы! Какой ревнивой я становилась бы к тем, чьи тела не были им предательством с самого рождения. Но что нам это даёт в итоге, à part rendre nos vies plus amères? Ещё озлобленнее?",shape=box,color=blue];
		j4257707771 -> j2761747848;
	j967607053 [label="Некоторые недуги неподвластны ни человеку, ни науке, ни даже вере.",shape=box,color=blue];
		j967607053 -> j1766422781;
	j3707672817 [label="У меня был такой разговор много раз...",shape=box,color=red];
		j3707672817 -> j1766422781;
	j2142555632 [label="Точно. Мне очень жаль.",shape=box,color=red];
		j2142555632 -> j2608288974;
	j2761747848 [label="Aucun. Я такая, какая я есть, и я выдержу.",shape=box,color=blue];
		j2761747848 -> j2980398560;
	j2608288974 [label="Нет, мне просто жаль, что тебе довелось пережить подобные страдания. ",shape=box,color=blue];
		j2608288974 -> j1766422781;
	j2980398560 [label="Check boolean DrifterChronicPain",color=orange];
		j2980398560 -> j181247378 [label=true,color=green];
		j2980398560 -> j3606240677 [label=false,color=brown];
	j181247378 [label="И ты тоже. И ты тоже. Я в это верю.",shape=box,color=blue];
		j181247378 -> j3606240677;
	j3606240677 [label="+20 Chemistry",color=orange];
		j3606240677 -> j1758495305;
	j1758495305 [label="Не могу выразить словами, как много значил для меня этот разговор. Поэтому просто скажу: «Merci, Скиталец».",shape=box,color=blue];
		j1758495305 -> j3563974437;
	j3563974437 [label="Et encore merci.",shape=box,color=blue];
		j3563974437 -> "Chat ends.";
}