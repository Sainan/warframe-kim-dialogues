digraph {
	2239 [label="MarieRank4Convo3 begins.",color=orange];
		2239 -> 2240;
		2239 -> 2241;
	2240 [label="Как ты сегодня, Мари?",shape=box,color=red];
		2240 -> 2242;
	2241 [label="[Конец.]",shape=box,color=red];
		2241 -> 2243;
	2242 [label="Я не столь grand. Лучше давай завтра поговорим. Сегодня из меня так себе собеседник.",shape=box,color=blue];
		2242 -> 2244;
		2242 -> 2245;
		2242 -> 2246;
	2243 [label="Chat ends.",color=orange];
	2244 [label="Если хочешь, я уйду, но если желаешь поговорить, я останусь и выслушаю.",shape=box,color=red];
		2244 -> 2247;
	2245 [label="Всё норм, я понимаю.",shape=box,color=red];
		2245 -> 2248;
	2246 [label="Могу ли я поинтересоваться, что случилось?..",shape=box,color=red];
		2246 -> 2247;
	2247 [label="C'est vraiment gentil, но это старая проблема... не стоит тебе из-за неё волноваться. Со мной всё будет в порядке.",shape=box,color=blue];
		2247 -> 2249;
	2248 [label="Chat ends.",color=orange];
	2249 [label="Update boolean MarieChronicPain",color=orange];
		2249 -> 2250;
		2249 -> 2251;
		2249 -> 2252;
	2250 [label="Хорошо, если ты уверена, но знай - я рядом, если захочешь поговорить об этом.",shape=box,color=red];
		2250 -> 2253;
	2251 [label="Я… знаю, каково это. Прежде чем начались мои «зацикливания», меня сильно поранило в Дувири. Рана зажила, но время от времени всё ещё ужасно ноет. Я стараюсь скрыть, когда боль возвращается.",shape=box,color=red];
		2251 -> 2254;
	2252 [label="Старые, неразрешённые проблемы могут быть не менее трудными, чем новые. То, что они приходят и уходят, остаются с нами, вовсе не значит, что о них не стоит говорить.",shape=box,color=red];
		2252 -> 2255;
	2253 [label="Это очень любезно с твоей стороны, и... это очень хорошо. Я снова становлюсь маленькой упрямой Мари.",shape=box,color=blue];
		2253 -> 2256;
	2254 [label="Update boolean DrifterChronicPain",color=orange];
		2254 -> 2257;
	2255 [label="Oui, tu as raison. Я снова становлюсь маленькой упрямой Мари.",shape=box,color=blue];
		2255 -> 2256;
	2256 [label="Это трудно объяснить, но я попробую. Mes pieds, oui? Мои ноги. Sérum изменила меня, подарила мне возможность летать -",shape=box,color=blue];
		2256 -> 2258;
	2257 [label="Par les Luminaires, мне очень жаль. Ты понимаешь, каково это, oui?",shape=box,color=blue];
		2257 -> 2259;
	2258 [label="Но я всё ещё чувствую их, эти искажённые, зловещие силы, что грозили поглотить меня, раздавить всю надежду и радость в моей душе.",shape=box,color=blue];
		2258 -> 2260;
	2259 [label="Иметь тело, которое предаёт тебя, которое замедляет твой дух… Даже теперь это кажется таким странным. Sérum изменила меня, подарила мне возможность летать -",shape=box,color=blue];
		2259 -> 2258;
	2260 [label="Они всегда причиняют боль. Всегда. Даже сейчас, когда я сижу здесь, стоит мне о них подумать, и я чувствую эту боль. Но бывает, что просто замечать её недостаточно.",shape=box,color=blue];
		2260 -> 2261;
	2261 [label="Но всё же боль до сих пор просыпается во мне по ночам. И я задаюсь вопросом, Сол, pourquoi ? Зачем мне всё это... agonie interminable ?",shape=box,color=blue];
		2261 -> 2262;
	2262 [label="Какой цели это служит ? Ах, но вот наступает утро, и я смеюсь, говоря себе: «Успокойся, Мари, ты благословенна. Посмотри, что у тебя есть и на что ты способна».",shape=box,color=blue];
		2262 -> 2263;
	2263 [label="В Cathédrale это звучало так: «Ты умеешь читать, писать, есть, спать. Ты можешь двигаться достаточно хорошо. У тебя есть глаза, чтобы видеть, и язык, чтобы говорить. Руки, чтобы писать. Окружающие, что заботятся о тебе». А теперь я могу летать! Могу защищать будущее от самой Бездны. От l'Indifférence!",shape=box,color=blue];
		2263 -> 2264;
	2264 [label="«Плачь сейчас, глупышка, эта постоянная боль сделает тебя сильнее перед лицом грядущего», — говорю себе я. И день сменяет другой, и с каждым новым становится чуть легче.",shape=box,color=blue];
		2264 -> 2265;
	2265 [label="Check boolean DrifterChronicPain",color=orange];
		2265 -> 2266 [label=true,color=green];
		2265 -> 2269 [label=true,color=green];
		2265 -> 2267 [label=false,color=brown];
		2265 -> 2268 [label=false,color=brown];
	2266 [label="Если уж какая-то одна вещь и была дана нам, так это умением терпеть боль, пожалуй.",shape=box,color=red];
		2266 -> 2270;
	2269 [label="Хотя иногда... я просыпаюсь с ощущением, что именно этот день станет тем, когда я не выдержу.",shape=box,color=red];
		2269 -> 2270;
	2267 [label="И боль... действительно никогда не перестаёт? Прости, Мари, мне ужасно жаль...",shape=box,color=red];
		2267 -> 2271;
	2268 [label="И нет никакого лекарства? Никакого лечения?",shape=box,color=red];
		2268 -> 2272;
	2270 [label="Однажды один прихожанин спросил меня: «Ты страдаешь? Всегда?» На что я ответила: «Oui, monsieur. Je le suis.» В его взгляде изумление смешалось с ужасом.",shape=box,color=blue];
		2270 -> 2273;
	2271 [label="Иногда, я задумывалась, чего бы только смогла достичь, не будь этой agonie, oui? Не будь я заключена в эту плотскую темницу, что так настойчиво ставит преграды повсюду.",shape=box,color=blue];
		2271 -> 2274;
	2272 [label="Хотела бы, чтобы было. Mais non, нет. Не в моё время, и, боюсь, в этом тоже вряд ли.",shape=box,color=blue];
		2272 -> 2275;
	2273 [label="Следом он спросил: «Как ты живёшь с этим?» И я помню, что я лишь улыбнулась ему и отвечала: «А какой у меня есть выбор, Monsieur...?»",shape=box,color=blue];
		2273 -> 2276;
		2273 -> 2277;
	2274 [label="Как же это меня злило бы! Какой ревнивой я становилась бы к тем, чьи тела не были им предательством с самого рождения. Но что нам это даёт в итоге, à part rendre nos vies plus amères? Ещё озлобленнее?",shape=box,color=blue];
		2274 -> 2278;
	2275 [label="Некоторые недуги неподвластны ни человеку, ни науке, ни даже вере.",shape=box,color=blue];
		2275 -> 2271;
	2276 [label="У меня был такой разговор много раз...",shape=box,color=red];
		2276 -> 2271;
	2277 [label="Точно. Мне очень жаль.",shape=box,color=red];
		2277 -> 2279;
	2278 [label="Aucun. Я такая, какая я есть, и я выдержу.",shape=box,color=blue];
		2278 -> 2280;
	2279 [label="Нет, мне просто жаль, что тебе довелось пережить подобные страдания. ",shape=box,color=blue];
		2279 -> 2271;
	2280 [label="Check boolean DrifterChronicPain",color=orange];
		2280 -> 2281 [label=true,color=green];
		2280 -> 2282 [label=false,color=brown];
	2281 [label="И ты тоже. И ты тоже. Я в это верю.",shape=box,color=blue];
		2281 -> 2282;
	2282 [label="+20 Chemistry",color=orange];
		2282 -> 2283;
	2283 [label="Не могу выразить словами, как много значил для меня этот разговор. Поэтому просто скажу: «Merci, Скиталец».",shape=box,color=blue];
		2283 -> 2284;
	2284 [label="Et encore merci.",shape=box,color=blue];
		2284 -> 2285;
	2285 [label="Chat ends.",color=orange];
}