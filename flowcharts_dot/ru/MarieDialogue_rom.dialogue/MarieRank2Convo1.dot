digraph {
	302 [label="MarieRank2Convo1 begins.",color=orange];
		302 -> 303;
	303 [label="Надеюсь, ты не сочтёшь меня грубой за вопрос, но мне ужасно любопытно. Веришь ли ты во что-нибудь? В Светила или во что-то ещё.",shape=box,color=blue];
		303 -> 3898;
		303 -> 3899;
		303 -> 3900;
	3898 [label="What if i said I was more interested in you, instead? Would that be blasphemous?",shape=box,color=red];
		3898 -> 3902;
	3899 [label="No, it wouldn't be rude at all.",shape=box,color=red];
		3899 -> 308;
		3899 -> 307;
		3899 -> 306;
		3899 -> 305;
		3899 -> 304;
	3900 [label="[Конец.]",shape=box,color=red];
		3900 -> 3901;
	3902 [label="Update boolean DrifterMarie",color=orange];
		3902 -> 3903;
	308 [label="Это... непросто. Я думаю, что нечто существует, но не могу назвать это какой-то определённой верой.",shape=box,color=red];
		308 -> 313;
	307 [label="Да, я верю. У меня есть вера, в которую я искренне верю, хотя вряд ли ты о ней знаешь.",shape=box,color=red];
		307 -> 312;
	306 [label="Я верю в Светила, как и ты.",shape=box,color=red];
		306 -> 311;
	305 [label="Нет, не верю. Я не верю в богов. Только в науку, которую мы пока не понимаем.",shape=box,color=red];
		305 -> 310;
	304 [label="Честно говоря, я не знаю. Я думаю мир слишком запутан, чтобы у меня был ответ.",shape=box,color=red];
		304 -> 309;
	3901 [label="Chat ends.",color=orange];
	3903 [label="Ah, oui ? What is this ? Quelle audace, I must say I am surprised at you ! I was not expecting...",shape=box,color=blue];
		3903 -> 3904;
	313 [label="Update boolean DrifterFaithPersonal",color=orange];
		313 -> 318;
	312 [label="+5 Chemistry",color=orange];
		312 -> 317;
	311 [label="+5 Chemistry",color=orange];
		311 -> 316;
	310 [label="+5 Chemistry",color=orange];
		310 -> 315;
	309 [label="Update boolean DrifterFaithAgnostic",color=orange];
		309 -> 314;
	3904 [label="But you are trying to distract me ! While I am not opposed, it is far too soon for such things, n'est pas ?",shape=box,color=blue];
		3904 -> 3905;
	318 [label="+5 Chemistry",color=orange];
		318 -> 326;
	317 [label="Как бы она ни называлась, в любой вере я нахожу красоту. Скажи мне, она новая? Древняя? Смогла бы я её узнать хоть как-то?",shape=box,color=blue];
		317 -> 324;
		317 -> 325;
	316 [label="Ты веришь! Oh, comme c'est fascinant! Подумать только, кто-то сохранил веру так далеко в будущем, cela remplit mon cœur de joie. Меня переполняет радость. Хотя, думаю, твоё пребывание в прошлом тут сыграло свою роль, не так ли? Ах, не важно.",shape=box,color=blue];
		316 -> 323;
	315 [label="Я уважаю твой взгляд. Но позволь мне спросить, откуда у тебя такая уверенность? Разве это не форма веры сама по себе? И что это за твоя... твоё Indifférence это не то же самое, что божество?",shape=box,color=blue];
		315 -> 320;
		315 -> 321;
		315 -> 322;
	314 [label="+10 Chemistry",color=orange];
		314 -> 319;
	3905 [label="I... would still like an answer to my question, s'il vous plait, if you do not mind. Though now you have me blushing !",shape=box,color=blue];
		3905 -> 308;
		3905 -> 307;
		3905 -> 306;
		3905 -> 305;
		3905 -> 304;
	326 [label="Ah, oui. Странник, это ведь даже в твоём имени. У тебя же была возможность увидеть столько культур, столько вер, столько миров. Cela est très spirituel, non? Их части, как ракушки у моря, были собраны тобою.",shape=box,color=blue];
		326 -> 336;
		326 -> 337;
	324 [label="Я не думаю, что ты её как-то распознаешь, нет.",shape=box,color=red];
		324 -> 334;
	325 [label="Некоторые её части ты, возможно, бы узнала. Но остальные части показались бы тебе совершенно незнакомы.",shape=box,color=red];
		325 -> 335;
	323 [label="Мне любопытно кому отдана твоя преданность, одному или другому ? Или ищешь равновесие между ними?",shape=box,color=blue];
		323 -> 331;
		323 -> 332;
		323 -> 333;
	320 [label="Во мне нет абсолютной уверенности, ведь никто не может быть. Но лично я всё ещё не верю в богов.",shape=box,color=red];
		320 -> 328;
	321 [label="Я думаю, религия существует для того, чтобы заполнить пустоту в жизни людей, оставленную страхом смерти и неизвестности.",shape=box,color=red];
		321 -> 329;
	322 [label="Я понятия не имею, что представляет собой Безразличие, но богом это точно не является. Нам просто нужно докопаться до сути. ",shape=box,color=red];
		322 -> 330;
	319 [label="Аах, возможно, это и есть самый мудрый ответ! Ведь кто мы, смертные — если нас ещё можно так назвать — чтобы притязать на понимание замысла Богов?",shape=box,color=blue];
		319 -> 327;
	336 [label="Я думаю, есть нечто более древнее, подлинное и глубокое, что говорит со всеми нами. Что-то вроде связующей ткани.",shape=box,color=red];
		336 -> 347;
	337 [label="Именно. Во всех них я вижу что-то прекрасное, я не думаю, что кто-то полностью прав или неправ.",shape=box,color=red];
		337 -> 347;
	334 [label="Update boolean DrifterFaithYesForeign",color=orange];
		334 -> 345;
	335 [label="Update boolean DrifterFaithYesSimilar",color=orange];
		335 -> 346;
	331 [label="Я замечаю, что всё сильнее тянусь к Сол. ",shape=box,color=red];
		331 -> 342;
	332 [label="Я замечаю, что всё сильнее тянусь к Луа.",shape=box,color=red];
		332 -> 343;
	333 [label="Я стремлюсь к балансу. Я полагаю, в этом и состоит естественный порядок вещей.",shape=box,color=red];
		333 -> 344;
	328 [label="Update boolean DrifterFaithNoMaybe",color=orange];
		328 -> 339;
	329 [label="Update boolean DrifterFaithNoFear",color=orange];
		329 -> 340;
	330 [label="Update boolean DrifterFaithNoMITW",color=orange];
		330 -> 341;
	327 [label="Часто я сидела в святилище моего Cathédrale и с весёлым сердцем говорила с незнакомцами, пришедшими лишь за знанием и ничем более.",shape=box,color=blue];
		327 -> 338;
	347 [label="+5 Chemistry",color=orange];
		347 -> 360;
	345 [label="+5 Chemistry",color=orange];
		345 -> 358;
	346 [label="+5 Chemistry",color=orange];
		346 -> 359;
	342 [label="Update boolean DrifterFaithSol",color=orange];
		342 -> 355;
	343 [label="Update boolean DrifterFaithLua",color=orange];
		343 -> 356;
	344 [label="Update boolean DrifterFaithBalance",color=orange];
		344 -> 357;
	339 [label="Oui, je vois... Тебе, возможно, нужно своё «доказательство» для уверенности? В твоей жизни не происходило ничего, что вызвало бы в тебе такое чувство, как то, что мы называем верой и пылом?",shape=box,color=blue];
		339 -> 350;
		339 -> 351;
	340 [label="Oui, c’est vrai - это правда. Вера отвечает на многие вопросы для многих душ. Разве ты не боишься того, что может быть после смерти?",shape=box,color=blue];
		340 -> 352;
		340 -> 353;
	341 [label="Comme c’est fascinant... и теперь уже двое, кто повторяет те же слова... дьявол шептал то же самое.",shape=box,color=blue];
		341 -> 354;
	338 [label="Так любопытны к нашей вере, но не желают сказать «да, да, вот она, истина». Я лишь могу надеяться, что дала им частицу нашей радости, которую они смогут унести с собой.",shape=box,color=blue];
		338 -> 348;
		338 -> 349;
	360 [label="Je comprends et c'est magnifique. Мне часто приходило в голову, не носят ли Светила иные лица. Иные имена.",shape=box,color=blue];
		360 -> 373;
	358 [label="Oh, comme c'est fascinant! Как бы я хотела когда-нибудь познакомиться с твоей верой. Услышать о твоих ритуалах.",shape=box,color=blue];
		358 -> 371;
		358 -> 372;
	359 [label="Oh, comme c’est fascinant! Как бы я хотела однажды услышать, почему она столь схожа и всё же столь различна.",shape=box,color=blue];
		359 -> 371;
		359 -> 372;
	355 [label="+10 Chemistry",color=orange];
		355 -> 368;
	356 [label="+5 Chemistry",color=orange];
		356 -> 369;
	357 [label="+5 Chemistry",color=orange];
		357 -> 370;
	350 [label="Нет, я просто не верю.",shape=box,color=red];
		350 -> 363;
	351 [label="Верно. Мне никогда не удавалось... «почувствовать» веру. Нужды не возникало.",shape=box,color=red];
		351 -> 364;
	352 [label="Все умирают. Бояться этого глупо. Оно приходит ко всем. Или, по крайней мере... должно.",shape=box,color=red];
		352 -> 365;
	353 [label="Мне вдоволь пришлось поумирать. Я не боюсь того, что будет потом. Я жажду этого.",shape=box,color=red];
		353 -> 366;
	354 [label="+5 Chemistry",color=orange];
		354 -> 367;
	348 [label="Меня немного удивляет, что ты столь открыта к людям, не верящим в твою веру.",shape=box,color=red];
		348 -> 361;
	349 [label="Именно так. Я не хочу утверждать, что кто-то «прав» или «не прав».",shape=box,color=red];
		349 -> 362;
	373 [label="Они известны тем, что адаптируют свои формы, чтобы угодить последователям других сект. Но это моя вера, а не твоя.",shape=box,color=blue];
		373 -> 386;
	371 [label="Мне бы понравилось.",shape=box,color=red];
		371 -> 384;
	372 [label="Меня удивляет, что тебе импонирует мысль существования других религий. ",shape=box,color=red];
		372 -> 385;
	368 [label="Странник по сердцу моему! Ты вызываешь у меня такую улыбку на моём лице. Я надеюсь, что ты не лжёшь, чтобы польстить мне.",shape=box,color=blue];
		368 -> 382;
	369 [label="Ах, странник следует тропой ночи, как мой дорогой Лион. Поговори с ним о нашей даме ночи, когда он будет готов, это доставит ему массу удовольствия.",shape=box,color=blue];
		369 -> 382;
	370 [label="Равновесие без нерешительности. Идти по жизни, зная, что после каждого восхода солнца должна взойти и луна, но никогда не поддаваться неуверенности?",shape=box,color=blue];
		370 -> 383;
	363 [label="+5 Chemistry",color=orange];
		363 -> 376;
	364 [label="+5 Chemistry",color=orange];
		364 -> 377;
	365 [label="+5 Chemistry",color=orange];
		365 -> 378;
	366 [label="+5 Chemistry",color=orange];
		366 -> 379;
	367 [label="Моё сердце разрывается от того, что я могу хоть как-то доверять ему, но в этом? Возможно, тебе стоит поговорить с ним. Просто проявляй осторожность. Дьявол ведёт в опасную игру.",shape=box,color=blue];
		367 -> 380;
		367 -> 381;
	361 [label="Полагаю, было бы удивительно видеть человека, который носит рясу и не предъявляет строгих требований к окружающим. Я считаю, что проповеди тем, кто не ищет утешения, не вызывают особой любви.",shape=box,color=blue];
		361 -> 374;
	362 [label="+5 Chemistry",color=orange];
		362 -> 375;
	386 [label="Я просто надеюсь, что твоя вера приносит тебе покой?",shape=box,color=blue];
		386 -> 394;
		386 -> 395;
		386 -> 396;
	384 [label="Ô joie! Я так люблю учиться. Мне часто приходило в голову, не носят ли Светила иные лица. Иные имена.",shape=box,color=blue];
		384 -> 398;
	385 [label="Полагаю, это может удивить, что найти человека, который носит подобное облачение, чтобы не требовать строгих ожиданий от других. Я считаю, что проповеди тем, кто не ищет утешения, не завоевывают особой любви.",shape=box,color=blue];
		385 -> 399;
	382 [label="Я просто думаю, приносит ли наша вера тебе покой?",shape=box,color=blue];
		382 -> 394;
		382 -> 395;
		382 -> 396;
	383 [label="Это редкий дар... и я надеюсь, что ты им воспользуешься. Боюсь, если задержаться на перепутье слишком долго, это значит быть поглощённым раздором.",shape=box,color=blue];
		383 -> 397;
	376 [label="Тогда жизнь наверняка станет проще. Не жить по законам богов и церквей. Признаю, я немного завидую.",shape=box,color=blue];
		376 -> 389;
	377 [label="Тогда я завидую тебе, странник! Прожить столько веков, не зная нужды в богах.",shape=box,color=blue];
		377 -> 389;
	378 [label="Ты говоришь словами последователей Луа, и я не говорю это как оскорбление. Oui, Старуха придёт за нами всеми и прольет свои серебряные слёзы. Но твои слова заставляют меня задуматься...",shape=box,color=blue];
		378 -> 390;
	379 [label="Oui, это заставляет меня задуматься. Я смотрю на тебя, на ребёнка, на дьявола, даже на Monsieur Лойда или le Cardinal... за вами всеми тянутся века.",shape=box,color=blue];
		379 -> 391;
	380 [label="Что это за опасная игра?",shape=box,color=red];
		380 -> 392;
	381 [label="Он тоже не верит, что Человек в Стене реален?",shape=box,color=red];
		381 -> 393;
	374 [label="+5 Chemistry",color=orange];
		374 -> 387;
	375 [label="Меня радует твоя мудрость и понимание по отношению к убеждениям других.",shape=box,color=blue];
		375 -> 388;
	394 [label="Нет.",shape=box,color=red];
		394 -> 400;
	395 [label="Честно говоря, я не думаю об этом.",shape=box,color=red];
		395 -> 401;
	396 [label="Да.",shape=box,color=red];
		396 -> 402;
	398 [label="Они известны тем, что адаптируют свои формы, чтобы угодить последователям других сект. Но это моя вера, а не твоя. Я не буду проповедовать тем, кто не ищет утешения. Я нахожу, что это не вызывает особой любви.",shape=box,color=blue];
		398 -> 399;
	399 [label="Нет, моя вера — это моя вера, а твоя — это твоя собственная вера. Я просто надеюсь, она принесёт тебе покой?",shape=box,color=blue];
		399 -> 394;
		399 -> 395;
		399 -> 396;
	397 [label="В конце концов, все должны выбрать путь, которым будут идти. Но именно перекрёсток это место, где начинается всё, а баланс является основой всех структур.",shape=box,color=blue];
		397 -> 403;
	389 [label="Но мне интересно... разве отсутствие веры приносит тебе покой?",shape=box,color=blue];
		389 -> 394;
		389 -> 395;
		389 -> 396;
	390 [label="О ком ты говоришь, что «оно должно» прийти за всеми вами? Я смотрю на тебя, на ребёнка, на дьявола, даже на Monsieur Лойда или le Cardinal... за вами всеми тянутся века.",shape=box,color=blue];
		390 -> 391;
	391 [label="Интересно, сколько веков пройдёт, прежде чем Луа придёт за нами. И насколько охотно я приму её, когда тот день настанет. Но это моя вера, не твоя.",shape=box,color=blue];
		391 -> 389;
	392 [label="Пока не знаю. Он хранит свои планы при себе, как подобает дьяволу. Но он не верит в богов. Разве что в самого себя.",shape=box,color=blue];
		392 -> 389;
	393 [label="Non, он не верит. Он, как и ты, не верит в богов. Разве что в самого себя.",shape=box,color=blue];
		393 -> 389;
	387 [label="Non, всякий, кто приходит с открытым умом, будет принят с открытыми объятиями.",shape=box,color=blue];
		387 -> 388;
	388 [label="Я просто думаю, приносит ли это тебе покой?",shape=box,color=blue];
		388 -> 394;
		388 -> 395;
		388 -> 396;
	400 [label="Update boolean DrifterFaithNoPeace",color=orange];
		400 -> 404;
	401 [label="+10 Chemistry",color=orange];
		401 -> 405;
	402 [label="+10 Chemistry",color=orange];
		402 -> 406;
	403 [label="Update boolean DrifterCrossroads",color=orange];
		403 -> 407;
	404 [label="+10 Chemistry",color=orange];
		404 -> 408;
	405 [label="Моя зависть безмерна! Она могла бы поглотить меня. Мне бы... очень хотелось снова обсудить это с тобой, если ты позволишь? Я не хочу проповедовать или совать нос не в своё дело. Я не хочу причинять тебе страдания.",shape=box,color=blue];
		405 -> 409;
	406 [label="Тогда я знаю, что мой Сол улыбается тебе, независимо от того молишься ты ему или нет, удалось ли тебе найти тот единственный путь, который тебе нужен.",shape=box,color=blue];
		406 -> 410;
	407 [label="Аах, pardonne-moi! Маленькая Мари проповедует, как неловко! Я не пришла сюда для того, чтобы наставлять тебя, словно школьная учительница.",shape=box,color=blue];
		407 -> 382;
	408 [label="Я глубоко тронута твоей честностью, странник. Мне бы... очень хотелось снова обсудить это с тобой, если ты позволишь? Я не хочу проповедовать или совать нос не в своё дело. Я не хочу причинять тебе страдания.",shape=box,color=blue];
		408 -> 409;
	409 [label="Мне просто любопытно, и я хочу помочь тебе, если смогу. Прошу тебя, скажи мне нет, и мы больше никогда не будем говорить об этом снова.",shape=box,color=blue];
		409 -> 411;
		409 -> 412;
	410 [label="Мне интересно, можем ли мы снова поговорить об этом? Мне слишком уж любопытно узнать больше.",shape=box,color=blue];
		410 -> 411;
		410 -> 412;
	411 [label="Нет, спасибо тебе.",shape=box,color=red];
		411 -> 413;
	412 [label="Конечно.",shape=box,color=red];
		412 -> 414;
	413 [label="Update boolean DrifterFaithStop",color=orange];
		413 -> 415;
	414 [label="Merci, merci! Сказанное тобой вселяет в меня огромное доверие. Я не стану растрачивать его впустую. До встречи.",shape=box,color=blue];
		414 -> 416;
	415 [label="Я полностью понимаю и во мне нет обиды. Спасибо, что мои слова были услышаны, и я благодарна тебе. Перейдём к другим темам, Сол знает, у нас их предостаточно!",shape=box,color=blue];
		415 -> 417;
	416 [label="Chat ends.",color=orange];
	417 [label="Chat ends.",color=orange];
}