digraph {
	"MarieRank2Convo1 begins." [color=orange];
		"MarieRank2Convo1 begins." -> j599317152;
	j599317152 [label="Надеюсь, ты не сочтёшь меня грубой за вопрос, но мне ужасно любопытно. Веришь ли ты во что-нибудь? В Светила или во что-то ещё.",shape=box,color=blue];
		j599317152 -> j4169549912;
		j599317152 -> j3098453528;
		j599317152 -> j1310452999;
	j4169549912 [label="What if i said I was more interested in you, instead? Would that be blasphemous?",shape=box,color=red];
		j4169549912 -> j2160635051;
	j3098453528 [label="No, it wouldn't be rude at all.",shape=box,color=red];
		j3098453528 -> j1993121716;
		j3098453528 -> j3249245134;
		j3098453528 -> j692216333;
		j3098453528 -> j580766076;
		j3098453528 -> j1750439925;
	j1310452999 [label="[Конец.]",shape=box,color=red];
		j1310452999 -> "Chat ends.";
	j2160635051 [label="Boolean DrifterMarie is now true.",color=orange];
		j2160635051 -> j3790062076;
	j1993121716 [label="Это... непросто. Я думаю, что нечто существует, но не могу назвать это какой-то определённой верой.",shape=box,color=red];
		j1993121716 -> j1355262213;
	j3249245134 [label="Да, я верю. У меня есть вера, в которую я искренне верю, хотя вряд ли ты о ней знаешь.",shape=box,color=red];
		j3249245134 -> j936644354;
	j692216333 [label="Я верю в Светила, как и ты.",shape=box,color=red];
		j692216333 -> j935814054;
	j580766076 [label="Нет, не верю. Я не верю в богов. Только в науку, которую мы пока не понимаем.",shape=box,color=red];
		j580766076 -> j3014783557;
	j1750439925 [label="Честно говоря, я не знаю. Я думаю мир слишком запутан, чтобы у меня был ответ.",shape=box,color=red];
		j1750439925 -> j943925802;
	"Chat ends." [color=orange];
	j3790062076 [label="Ah, oui ? What is this ? Quelle audace, I must say I am surprised at you ! I was not expecting...",shape=box,color=blue];
		j3790062076 -> j2621416485;
	j1355262213 [label="Boolean DrifterFaithPersonal is now true.",color=orange];
		j1355262213 -> j4031842224;
	j936644354 [label="+5 Chemistry",color=orange];
		j936644354 -> j1162491383;
	j935814054 [label="+5 Chemistry",color=orange];
		j935814054 -> j896724491;
	j3014783557 [label="+5 Chemistry",color=orange];
		j3014783557 -> j4052686244;
	j943925802 [label="Boolean DrifterFaithAgnostic is now true.",color=orange];
		j943925802 -> j1759952638;
	j2621416485 [label="But you are trying to distract me ! While I am not opposed, it is far too soon for such things, n'est pas ?",shape=box,color=blue];
		j2621416485 -> j2637691484;
	j4031842224 [label="+5 Chemistry",color=orange];
		j4031842224 -> j3448314922;
	j1162491383 [label="Как бы она ни называлась, в любой вере я нахожу красоту. Скажи мне, она новая? Древняя? Смогла бы я её узнать хоть как-то?",shape=box,color=blue];
		j1162491383 -> j3778103626;
		j1162491383 -> j2134677089;
	j896724491 [label="Ты веришь! Oh, comme c'est fascinant! Подумать только, кто-то сохранил веру так далеко в будущем, cela remplit mon cœur de joie. Меня переполняет радость. Хотя, думаю, твоё пребывание в прошлом тут сыграло свою роль, не так ли? Ах, не важно.",shape=box,color=blue];
		j896724491 -> j642711966;
	j4052686244 [label="Я уважаю твой взгляд. Но позволь мне спросить, откуда у тебя такая уверенность? Разве это не форма веры сама по себе? И что это за твоя... твоё Indifférence это не то же самое, что божество?",shape=box,color=blue];
		j4052686244 -> j2958065370;
		j4052686244 -> j2549288948;
		j4052686244 -> j172425612;
	j1759952638 [label="+10 Chemistry",color=orange];
		j1759952638 -> j258251692;
	j2637691484 [label="I... would still like an answer to my question, s'il vous plait, if you do not mind. Though now you have me blushing !",shape=box,color=blue];
		j2637691484 -> j1993121716;
		j2637691484 -> j3249245134;
		j2637691484 -> j692216333;
		j2637691484 -> j580766076;
		j2637691484 -> j1750439925;
	j3448314922 [label="Ah, oui. Странник, это ведь даже в твоём имени. У тебя же была возможность увидеть столько культур, столько вер, столько миров. Cela est très spirituel, non? Их части, как ракушки у моря, были собраны тобою.",shape=box,color=blue];
		j3448314922 -> j843409581;
		j3448314922 -> j1645025567;
	j3778103626 [label="Я не думаю, что ты её как-то распознаешь, нет.",shape=box,color=red];
		j3778103626 -> j1296333622;
	j2134677089 [label="Некоторые её части ты, возможно, бы узнала. Но остальные части показались бы тебе совершенно незнакомы.",shape=box,color=red];
		j2134677089 -> j2605877430;
	j642711966 [label="Мне любопытно кому отдана твоя преданность, одному или другому ? Или ищешь равновесие между ними?",shape=box,color=blue];
		j642711966 -> j179344913;
		j642711966 -> j1698295321;
		j642711966 -> j3970553832;
	j2958065370 [label="Во мне нет абсолютной уверенности, ведь никто не может быть. Но лично я всё ещё не верю в богов.",shape=box,color=red];
		j2958065370 -> j2933796915;
	j2549288948 [label="Я думаю, религия существует для того, чтобы заполнить пустоту в жизни людей, оставленную страхом смерти и неизвестности.",shape=box,color=red];
		j2549288948 -> j3206039366;
	j172425612 [label="Я понятия не имею, что представляет собой Безразличие, но богом это точно не является. Нам просто нужно докопаться до сути. ",shape=box,color=red];
		j172425612 -> j110626774;
	j258251692 [label="Аах, возможно, это и есть самый мудрый ответ! Ведь кто мы, смертные — если нас ещё можно так назвать — чтобы притязать на понимание замысла Богов?",shape=box,color=blue];
		j258251692 -> j1979958810;
	j843409581 [label="Я думаю, есть нечто более древнее, подлинное и глубокое, что говорит со всеми нами. Что-то вроде связующей ткани.",shape=box,color=red];
		j843409581 -> j3189238048;
	j1645025567 [label="Именно. Во всех них я вижу что-то прекрасное, я не думаю, что кто-то полностью прав или неправ.",shape=box,color=red];
		j1645025567 -> j3189238048;
	j1296333622 [label="Boolean DrifterFaithYesForeign is now true.",color=orange];
		j1296333622 -> j1146268380;
	j2605877430 [label="Boolean DrifterFaithYesSimilar is now true.",color=orange];
		j2605877430 -> j1220743500;
	j179344913 [label="Я замечаю, что всё сильнее тянусь к Сол. ",shape=box,color=red];
		j179344913 -> j3240362793;
	j1698295321 [label="Я замечаю, что всё сильнее тянусь к Луа.",shape=box,color=red];
		j1698295321 -> j3489022560;
	j3970553832 [label="Я стремлюсь к балансу. Я полагаю, в этом и состоит естественный порядок вещей.",shape=box,color=red];
		j3970553832 -> j1102295177;
	j2933796915 [label="Boolean DrifterFaithNoMaybe is now true.",color=orange];
		j2933796915 -> j611511064;
	j3206039366 [label="Boolean DrifterFaithNoFear is now true.",color=orange];
		j3206039366 -> j2018623045;
	j110626774 [label="Boolean DrifterFaithNoMITW is now true.",color=orange];
		j110626774 -> j2954451945;
	j1979958810 [label="Часто я сидела в святилище моего Cathédrale и с весёлым сердцем говорила с незнакомцами, пришедшими лишь за знанием и ничем более.",shape=box,color=blue];
		j1979958810 -> j3131059362;
	j3189238048 [label="+5 Chemistry",color=orange];
		j3189238048 -> j3291830022;
	j1146268380 [label="+5 Chemistry",color=orange];
		j1146268380 -> j2449858407;
	j1220743500 [label="+5 Chemistry",color=orange];
		j1220743500 -> j2817538586;
	j3240362793 [label="Boolean DrifterFaithSol is now true.",color=orange];
		j3240362793 -> j962221705;
	j3489022560 [label="Boolean DrifterFaithLua is now true.",color=orange];
		j3489022560 -> j2059180725;
	j1102295177 [label="Boolean DrifterFaithBalance is now true.",color=orange];
		j1102295177 -> j2817179386;
	j611511064 [label="Oui, je vois... Тебе, возможно, нужно своё «доказательство» для уверенности? В твоей жизни не происходило ничего, что вызвало бы в тебе такое чувство, как то, что мы называем верой и пылом?",shape=box,color=blue];
		j611511064 -> j3366494382;
		j611511064 -> j1075427399;
	j2018623045 [label="Oui, c’est vrai - это правда. Вера отвечает на многие вопросы для многих душ. Разве ты не боишься того, что может быть после смерти?",shape=box,color=blue];
		j2018623045 -> j238957233;
		j2018623045 -> j963305430;
	j2954451945 [label="Comme c’est fascinant... и теперь уже двое, кто повторяет те же слова... дьявол шептал то же самое.",shape=box,color=blue];
		j2954451945 -> j949743026;
	j3131059362 [label="Так любопытны к нашей вере, но не желают сказать «да, да, вот она, истина». Я лишь могу надеяться, что дала им частицу нашей радости, которую они смогут унести с собой.",shape=box,color=blue];
		j3131059362 -> j3291776977;
		j3131059362 -> j3485622342;
	j3291830022 [label="Je comprends et c'est magnifique. Мне часто приходило в голову, не носят ли Светила иные лица. Иные имена.",shape=box,color=blue];
		j3291830022 -> j3094450664;
	j2449858407 [label="Oh, comme c'est fascinant! Как бы я хотела когда-нибудь познакомиться с твоей верой. Услышать о твоих ритуалах.",shape=box,color=blue];
		j2449858407 -> j1964622754;
		j2449858407 -> j1171026033;
	j2817538586 [label="Oh, comme c’est fascinant! Как бы я хотела однажды услышать, почему она столь схожа и всё же столь различна.",shape=box,color=blue];
		j2817538586 -> j1964622754;
		j2817538586 -> j1171026033;
	j962221705 [label="+10 Chemistry",color=orange];
		j962221705 -> j2362361844;
	j2059180725 [label="+5 Chemistry",color=orange];
		j2059180725 -> j2580155288;
	j2817179386 [label="+5 Chemistry",color=orange];
		j2817179386 -> j1508163850;
	j3366494382 [label="Нет, я просто не верю.",shape=box,color=red];
		j3366494382 -> j1934281364;
	j1075427399 [label="Верно. Мне никогда не удавалось... «почувствовать» веру. Нужды не возникало.",shape=box,color=red];
		j1075427399 -> j2460466838;
	j238957233 [label="Все умирают. Бояться этого глупо. Оно приходит ко всем. Или, по крайней мере... должно.",shape=box,color=red];
		j238957233 -> j663351289;
	j963305430 [label="Мне вдоволь пришлось поумирать. Я не боюсь того, что будет потом. Я жажду этого.",shape=box,color=red];
		j963305430 -> j1126131325;
	j949743026 [label="+5 Chemistry",color=orange];
		j949743026 -> j1053323769;
	j3291776977 [label="Меня немного удивляет, что ты столь открыта к людям, не верящим в твою веру.",shape=box,color=red];
		j3291776977 -> j2153490319;
	j3485622342 [label="Именно так. Я не хочу утверждать, что кто-то «прав» или «не прав».",shape=box,color=red];
		j3485622342 -> j2345067304;
	j3094450664 [label="Они известны тем, что адаптируют свои формы, чтобы угодить последователям других сект. Но это моя вера, а не твоя.",shape=box,color=blue];
		j3094450664 -> j1924150950;
	j1964622754 [label="Мне бы понравилось.",shape=box,color=red];
		j1964622754 -> j281017531;
	j1171026033 [label="Меня удивляет, что тебе импонирует мысль существования других религий. ",shape=box,color=red];
		j1171026033 -> j4017993886;
	j2362361844 [label="Странник по сердцу моему! Ты вызываешь у меня такую улыбку на моём лице. Я надеюсь, что ты не лжёшь, чтобы польстить мне.",shape=box,color=blue];
		j2362361844 -> j3019535246;
	j2580155288 [label="Ах, странник следует тропой ночи, как мой дорогой Лион. Поговори с ним о нашей даме ночи, когда он будет готов, это доставит ему массу удовольствия.",shape=box,color=blue];
		j2580155288 -> j3019535246;
	j1508163850 [label="Равновесие без нерешительности. Идти по жизни, зная, что после каждого восхода солнца должна взойти и луна, но никогда не поддаваться неуверенности?",shape=box,color=blue];
		j1508163850 -> j2974627538;
	j1934281364 [label="+5 Chemistry",color=orange];
		j1934281364 -> j2047791790;
	j2460466838 [label="+5 Chemistry",color=orange];
		j2460466838 -> j1398445550;
	j663351289 [label="+5 Chemistry",color=orange];
		j663351289 -> j142302320;
	j1126131325 [label="+5 Chemistry",color=orange];
		j1126131325 -> j3804563001;
	j1053323769 [label="Моё сердце разрывается от того, что я могу хоть как-то доверять ему, но в этом? Возможно, тебе стоит поговорить с ним. Просто проявляй осторожность. Дьявол ведёт в опасную игру.",shape=box,color=blue];
		j1053323769 -> j1265691209;
		j1053323769 -> j762178680;
	j2153490319 [label="Полагаю, было бы удивительно видеть человека, который носит рясу и не предъявляет строгих требований к окружающим. Я считаю, что проповеди тем, кто не ищет утешения, не вызывают особой любви.",shape=box,color=blue];
		j2153490319 -> j2837117736;
	j2345067304 [label="+5 Chemistry",color=orange];
		j2345067304 -> j541741650;
	j1924150950 [label="Я просто надеюсь, что твоя вера приносит тебе покой?",shape=box,color=blue];
		j1924150950 -> j1294267823;
		j1924150950 -> j2615532782;
		j1924150950 -> j2773311322;
	j281017531 [label="Ô joie! Я так люблю учиться. Мне часто приходило в голову, не носят ли Светила иные лица. Иные имена.",shape=box,color=blue];
		j281017531 -> j2236894467;
	j4017993886 [label="Полагаю, это может удивить, что найти человека, который носит подобное облачение, чтобы не требовать строгих ожиданий от других. Я считаю, что проповеди тем, кто не ищет утешения, не завоевывают особой любви.",shape=box,color=blue];
		j4017993886 -> j3078986038;
	j3019535246 [label="Я просто думаю, приносит ли наша вера тебе покой?",shape=box,color=blue];
		j3019535246 -> j1294267823;
		j3019535246 -> j2615532782;
		j3019535246 -> j2773311322;
	j2974627538 [label="Это редкий дар... и я надеюсь, что ты им воспользуешься. Боюсь, если задержаться на перепутье слишком долго, это значит быть поглощённым раздором.",shape=box,color=blue];
		j2974627538 -> j3944360391;
	j2047791790 [label="Тогда жизнь наверняка станет проще. Не жить по законам богов и церквей. Признаю, я немного завидую.",shape=box,color=blue];
		j2047791790 -> j1254269190;
	j1398445550 [label="Тогда я завидую тебе, странник! Прожить столько веков, не зная нужды в богах.",shape=box,color=blue];
		j1398445550 -> j1254269190;
	j142302320 [label="Ты говоришь словами последователей Луа, и я не говорю это как оскорбление. Oui, Старуха придёт за нами всеми и прольет свои серебряные слёзы. Но твои слова заставляют меня задуматься...",shape=box,color=blue];
		j142302320 -> j930665376;
	j3804563001 [label="Oui, это заставляет меня задуматься. Я смотрю на тебя, на ребёнка, на дьявола, даже на Monsieur Лойда или le Cardinal... за вами всеми тянутся века.",shape=box,color=blue];
		j3804563001 -> j692533398;
	j1265691209 [label="Что это за опасная игра?",shape=box,color=red];
		j1265691209 -> j2243514672;
	j762178680 [label="Он тоже не верит, что Человек в Стене реален?",shape=box,color=red];
		j762178680 -> j957149499;
	j2837117736 [label="+5 Chemistry",color=orange];
		j2837117736 -> j3128127997;
	j541741650 [label="Меня радует твоя мудрость и понимание по отношению к убеждениям других.",shape=box,color=blue];
		j541741650 -> j3481994801;
	j1294267823 [label="Нет.",shape=box,color=red];
		j1294267823 -> j3842623310;
	j2615532782 [label="Честно говоря, я не думаю об этом.",shape=box,color=red];
		j2615532782 -> j2128409004;
	j2773311322 [label="Да.",shape=box,color=red];
		j2773311322 -> j1033815833;
	j2236894467 [label="Они известны тем, что адаптируют свои формы, чтобы угодить последователям других сект. Но это моя вера, а не твоя. Я не буду проповедовать тем, кто не ищет утешения. Я нахожу, что это не вызывает особой любви.",shape=box,color=blue];
		j2236894467 -> j3078986038;
	j3078986038 [label="Нет, моя вера — это моя вера, а твоя — это твоя собственная вера. Я просто надеюсь, она принесёт тебе покой?",shape=box,color=blue];
		j3078986038 -> j1294267823;
		j3078986038 -> j2615532782;
		j3078986038 -> j2773311322;
	j3944360391 [label="В конце концов, все должны выбрать путь, которым будут идти. Но именно перекрёсток это место, где начинается всё, а баланс является основой всех структур.",shape=box,color=blue];
		j3944360391 -> j2021830871;
	j1254269190 [label="Но мне интересно... разве отсутствие веры приносит тебе покой?",shape=box,color=blue];
		j1254269190 -> j1294267823;
		j1254269190 -> j2615532782;
		j1254269190 -> j2773311322;
	j930665376 [label="О ком ты говоришь, что «оно должно» прийти за всеми вами? Я смотрю на тебя, на ребёнка, на дьявола, даже на Monsieur Лойда или le Cardinal... за вами всеми тянутся века.",shape=box,color=blue];
		j930665376 -> j692533398;
	j692533398 [label="Интересно, сколько веков пройдёт, прежде чем Луа придёт за нами. И насколько охотно я приму её, когда тот день настанет. Но это моя вера, не твоя.",shape=box,color=blue];
		j692533398 -> j1254269190;
	j2243514672 [label="Пока не знаю. Он хранит свои планы при себе, как подобает дьяволу. Но он не верит в богов. Разве что в самого себя.",shape=box,color=blue];
		j2243514672 -> j1254269190;
	j957149499 [label="Non, он не верит. Он, как и ты, не верит в богов. Разве что в самого себя.",shape=box,color=blue];
		j957149499 -> j1254269190;
	j3128127997 [label="Non, всякий, кто приходит с открытым умом, будет принят с открытыми объятиями.",shape=box,color=blue];
		j3128127997 -> j3481994801;
	j3481994801 [label="Я просто думаю, приносит ли это тебе покой?",shape=box,color=blue];
		j3481994801 -> j1294267823;
