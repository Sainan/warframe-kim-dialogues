		j3540560870 -> j4248900492;
	j1129243229 [label="Моя зависть безмерна! Она могла бы поглотить меня. Мне бы... очень хотелось снова обсудить это с тобой, если ты позволишь? Я не хочу проповедовать или совать нос не в своё дело. Я не хочу причинять тебе страдания.",shape=box,color=blue];
		j1129243229 -> j2738143139;
	j2937649893 [label="Тогда я знаю, что мой Сол улыбается тебе, независимо от того молишься ты ему или нет, удалось ли тебе найти тот единственный путь, который тебе нужен.",shape=box,color=blue];
		j2937649893 -> j797039650;
	j3248260447 [label="Аах, pardonne-moi! Маленькая Мари проповедует, как неловко! Я не пришла сюда для того, чтобы наставлять тебя, словно школьная учительница.",shape=box,color=blue];
		j3248260447 -> j3019535246;
	j4248900492 [label="Я глубоко тронута твоей честностью, странник. Мне бы... очень хотелось снова обсудить это с тобой, если ты позволишь? Я не хочу проповедовать или совать нос не в своё дело. Я не хочу причинять тебе страдания.",shape=box,color=blue];
		j4248900492 -> j2738143139;
	j2738143139 [label="Мне просто любопытно, и я хочу помочь тебе, если смогу. Прошу тебя, скажи мне нет, и мы больше никогда не будем говорить об этом снова.",shape=box,color=blue];
		j2738143139 -> j2945910541;
		j2738143139 -> j3864209110;
	j797039650 [label="Мне интересно, можем ли мы снова поговорить об этом? Мне слишком уж любопытно узнать больше.",shape=box,color=blue];
		j797039650 -> j2945910541;
		j797039650 -> j3864209110;
	j2945910541 [label="Нет, спасибо тебе.",shape=box,color=red];
		j2945910541 -> j64102132;
	j3864209110 [label="Конечно.",shape=box,color=red];
		j3864209110 -> j4270089790;
	j64102132 [label="Boolean DrifterFaithStop is now true.",color=orange];
		j64102132 -> j2789874049;
	j4270089790 [label="Merci, merci! Сказанное тобой вселяет в меня огромное доверие. Я не стану растрачивать его впустую. До встречи.",shape=box,color=blue];
		j4270089790 -> "Chat ends.";
	j2789874049 [label="Я полностью понимаю и во мне нет обиды. Спасибо, что мои слова были услышаны, и я благодарна тебе. Перейдём к другим темам, Сол знает, у нас их предостаточно!",shape=box,color=blue];
		j2789874049 -> "Chat ends.";
