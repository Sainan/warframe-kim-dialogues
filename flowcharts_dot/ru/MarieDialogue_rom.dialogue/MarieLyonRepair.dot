		j835535839 -> j3160868664;
	"Chat ends." [color=orange];
	j959993937 [label="Мне бы очень хотелось, чтобы ты нам помогла, Мари. ",shape=box,color=red];
		j959993937 -> j56798041;
	j4230062191 [label="Ты нужна нам, Мари. Без тебя всё бесполезно. Пожалуйста. Сможешь ли ты простить меня?",shape=box,color=red];
		j4230062191 -> j2085683295;
	j3160868664 [label="Прости, что мои слова расстроили тебя. Но, пожалуйста, не вымещай злость на Лойде. Или на семье наверху.",shape=box,color=red];
		j3160868664 -> j2930249034;
	j56798041 [label="Я просто пришла сказать, что тебе не следует использовать доброту Лиона, чтобы искупить свои собственные неудачи.",shape=box,color=blue];
		j56798041 -> "Chat ends.";
	j2085683295 [label="Oui.. Я могу. Мой гнев на тебя в данный момент в любом случае не должен ощущаться другими.",shape=box,color=blue];
		j2085683295 -> j4189322998;
	j2930249034 [label="Oui. В этом ты прав. Мой гнев на тебя в данный момент не должен ощущаться другими.",shape=box,color=blue];
		j2930249034 -> j328594026;
	j4189322998 [label="Итак, я говорю: «Очень хорошо». Я помогу тебе. Tu auras mon aide.",shape=box,color=blue];
		j4189322998 -> j3151953893;
	j328594026 [label="Гнев, за который я сожалею и прощаю тебя.",shape=box,color=blue];
		j328594026 -> j4189322998;
	j3151953893 [label="Boolean MarieFamilySuccess is now true.",color=orange];
