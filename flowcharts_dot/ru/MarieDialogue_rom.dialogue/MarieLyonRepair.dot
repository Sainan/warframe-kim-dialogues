		j383727168 -> "Chat ends." [label=false,color=brown];
	j835535839 [label="Брат моей души посылает меня поговорить с тобой. Он умоляет меня пересмотреть моё решение не помогать тебе в деле Monsieur Лойда.",shape=box,color=blue];
