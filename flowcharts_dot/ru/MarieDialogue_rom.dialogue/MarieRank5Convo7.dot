		j3123960711 -> j3173457305 [label=false,color=brown];
		j3123960711 -> j2155309973 [label=false,color=brown];
	j1987868859 [label="Я забочусь о нём больше, чем могу описать. Я рад, что он чувствует себя в безопасности.",shape=box,color=red];
		j1987868859 -> j3525489081;
