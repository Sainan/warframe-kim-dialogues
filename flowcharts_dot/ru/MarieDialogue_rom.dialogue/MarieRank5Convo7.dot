		j938781141 -> j1310452999;
	j867481954 [label="Он говорит, что уже кое-что тебе рассказал, да? Я рада, что он начал тебе открываться...",shape=box,color=blue];
		j867481954 -> j3162441576;
		j867481954 -> j3722487210;
		j867481954 -> j1310452999;
	j3722487210 [label="Думаю, с ним всё в порядке, правда. Просто... ему пришлось многое пережить.",shape=box,color=red];
		j3722487210 -> j3560632266;
	j3162441576 [label="Это разбило мне сердце... Мне бы хотелось сделать больше, чтобы помочь ему...",shape=box,color=red];
		j3162441576 -> j502773787;
	j2576153201 [label="Приятно, что он… наконец-то достаточно доверился, чтобы рассказать всю свою историю...",shape=box,color=red];
		j2576153201 -> j4271465558;
	j1310452999 [label="[Конец.]",shape=box,color=red];
		j1310452999 -> "Chat ends.";
	j3560632266 [label="+5 Chemistry",color=orange];
		j3560632266 -> j1475668897;
	j502773787 [label="Ты делаешь так много просто тем, что слушаешь. Тем, что рядом, когда он готов говорить. Он не сломлен — трещины в нём не настолько глубоки, чтобы угрожать его основанию. Это шрамы, и они поверхностные.",shape=box,color=blue];
		j502773787 -> j689681535;
	j4271465558 [label="+5 Chemistry",color=orange];
		j4271465558 -> j709279413;
	j1475668897 [label="Oui, ты понимаешь. Он не какая-то сломанная, пустая сущность. Трещины в нём не угрожают его основанию. Это шрамы, и они поверхностные.",shape=box,color=blue];
		j1475668897 -> j689681535;
	j689681535 [label="Знаешь, вчера я увидела его сидящим и читающим книгу по древней философии для M'sieur Фибоначчи?",shape=box,color=blue];
		j689681535 -> j1676540596;
	j709279413 [label="Oui, ты так много делаешь, слушая. Он не какая-то сломанная, пустая сущность. Трещины в нём не угрожают его основанию. Это шрамы, и они поверхностные.",shape=box,color=blue];
		j709279413 -> j689681535;
	j1676540596 [label="M'sieur Фибоначчи уже давно просил, чтобы кто-нибудь прочитал ему эту книгу, но все остальные отказывались! Не хотели давать ему des munitions, ха!",shape=box,color=blue];
		j1676540596 -> j2486207884;
	j2486207884 [label="Evaluate expressions",color=orange];
		j2486207884 -> j1898887950 [label="LyonDating",color=purple];
		j2486207884 -> j1864682015 [label="MarieDating",color=purple];
		j2486207884 -> j3039523048 [label="false",color=purple];
	j1898887950 [label="Наш милый Лион никогда бы не подумал о том, чтобы сделать что-то подобное. Разговаривать с другими таким образом. Он получал от этого удовольствие.",shape=box,color=blue];
		j1898887950 -> j1730761700;
	j1864682015 [label="Лион никогда бы не подумал о том, чтобы сделать что-то подобное. Разговаривать с другими таким образом. Он получал от этого удовольствие, mon cœur.",shape=box,color=blue];
		j1864682015 -> j1730761700;
	j3039523048 [label="Лион никогда бы не подумал о том, чтобы сделать что-то подобное. Разговаривать с другими таким образом. Он получал от этого удовольствие.",shape=box,color=blue];
		j3039523048 -> j1730761700;
	j1730761700 [label="И я знаю, что благодарить за это на вечерней молитве мне следует не кого-то из Светил. А тебя.",shape=box,color=blue];
		j1730761700 -> j3123960711;
	j3123960711 [label="Check boolean LyonDating",color=orange];
