		j3844703164 -> j3127768755 [label="false",color=purple];
	j3740541784 [label="Это... заставляет меня пересмотреть свое решение работать с тобой над налаживанием отношений между Monsieur Лойдом и семьей наверху.",shape=box,color=blue];
		j3740541784 -> j2389906991;
		j3740541784 -> j297093554;
	j2536229311 [label="Это заставляет меня осознать, насколько трагично, что дьявол отказывается помогать нам в восстановлении моста между Monsieur Лойдом и семьёй наверху… Интересно, нельзя ли с этим что-то сделать.",shape=box,color=blue];
		j2536229311 -> j3741076648;
		j2536229311 -> j2203640950;
	j3127768755 [label="Это ещё больше побуждает меня восстановить мост между Monsieur Лойдом и семьёй наверху! Давай примемся за дело и поспешим !",shape=box,color=blue];
		j3127768755 -> "Chat ends.";
	j2389906991 [label="Я… и не надеялся на твою помощь.",shape=box,color=red];
		j2389906991 -> j445686790;
	j297093554 [label="Правда? Ты передумала насчёт этого?",shape=box,color=red];
		j297093554 -> j445686790;
	j3741076648 [label="Ты уверена, что хочешь браться за это с ним?",shape=box,color=red];
		j3741076648 -> j1427323130;
	j2203640950 [label="Серьёзно? Ты бы стала спорить с Роутом от моего имени?",shape=box,color=red];
		j2203640950 -> j1427323130;
	j445686790 [label="За всё, что сделано для помощи брату моей души? Хотя мы можем и не соглашаться по другим вопросам и никогда не сходиться во взглядах, это... Это я сделаю для тебя.",shape=box,color=blue];
		j445686790 -> j384589798;
	j1427323130 [label="Ха! Я сражалась с дьяволом за куда меньшее. А за всё, что было сделано, чтобы помочь брату моей души? Я сделаю это с радостью. ",shape=box,color=blue];
		j1427323130 -> j2367459991;
	j384589798 [label="Boolean MarieFamilySuccess is now true.",color=orange];
		j384589798 -> j3674718410;
	j2367459991 [label="Дьявол не знает себе равных. Смотри, как я разрушаю его волю своей собственной. Мари sera victorieuse !",shape=box,color=blue];
