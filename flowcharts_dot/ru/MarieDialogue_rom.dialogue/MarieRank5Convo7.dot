		j3173457305 -> j3525489081;
	j2155309973 [label="Он заслуживает места, где он может чувствовать себя в безопасности. Среди друзей. Среди Семьи.",shape=box,color=red];
		j2155309973 -> j3525489081;
	j3525489081 [label="+15 Chemistry",color=orange];
		j3525489081 -> j3364975785;
	j3364975785 [label="Oui ! И это лишь еще одно доказательство того, что мы там, где нам суждено быть. Здесь. С тобой. В этом санктуме. И вместе.",shape=box,color=blue];
