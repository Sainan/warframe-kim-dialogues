digraph {
	"MarieRank3Convo6 begins." [color=orange];
		"MarieRank3Convo6 begins." -> j7741117;
	j7741117 [label="Boolean MarieLyonAvailable is now true.",color=orange];
		j7741117 -> j755931174;
	j755931174 [label="Я должна задать тебе вопрос и умоляю тебя не судить меня за него, Скиталец.",shape=box,color=blue];
		j755931174 -> j1488641930;
		j755931174 -> j1007326941;
		j755931174 -> j1310452999;
	j1488641930 [label="Ты попала в нелепую ситуацию. Разумеется, я не буду тебя судить.",shape=box,color=red];
		j1488641930 -> j461728240;
	j1007326941 [label="Я сделаю все возможное.",shape=box,color=red];
		j1007326941 -> j2917528982;
	j1310452999 [label="[Конец.]",shape=box,color=red];
		j1310452999 -> "Chat ends.";
	j461728240 [label="Vraiment gentil оказывая мне такую милость, не зная ни меня, ни того, что я собиралась тебе написать.",shape=box,color=blue];
		j461728240 -> j3556733381;
	j2917528982 [label="+10 Chemistry",color=orange];
		j2917528982 -> j2452034057;
	"Chat ends." [color=orange];
	j3556733381 [label="Но... большеголовая говорящая рыба тоже вызывает у тебя головную боль? Фибоначчи?",shape=box,color=blue];
		j3556733381 -> j1014938780;
		j3556733381 -> j1285688068;
		j3556733381 -> j193185389;
	j2452034057 [label="Я очень ценю это, спасибо.",shape=box,color=blue];
		j2452034057 -> j3556733381;
	j1014938780 [label="Да. Да, конечно. Спасибо.",shape=box,color=red];
		j1014938780 -> j2204104527;
	j1285688068 [label="Мысль о том, что тебя раздражает Фибоначчи, невероятно умилительна.",shape=box,color=red];
		j1285688068 -> j2123680790;
	j193185389 [label="Нет, вообще-то. Я его обожаю.",shape=box,color=red];
		j193185389 -> j443142755;
	j2204104527 [label="Тогда я рада, что я не одна. Но, если честно, я не хочу его обидеть. Если я чувствую себя не в своей тарелке из-за своего нынешнего положения, то, полагаю, он терпит как может.",shape=box,color=blue];
		j2204104527 -> j3056351185;
	j2123680790 [label="О? Как так? Наверное, я рада этому, но просто не понимаю, почему. Моя головная боль, конечно, далеко не так умилительна.",shape=box,color=blue];
		j2123680790 -> j373202070;
		j2123680790 -> j612700975;
	j443142755 [label="Тогда мне остаётся лишь просить у тебя прощения. Я вовсе не хочу его обидеть. Если мне самой не по себе из-за моего нынешнего положения, то, полагаю, он держится, как может.",shape=box,color=blue];
		j443142755 -> j111532455;
	j3056351185 [label="Просто его способы справляться со всем этим не совпадают с моими, когда я подвергаюсь этому слишком долго, вот и всё.",shape=box,color=blue];
		j3056351185 -> j2096611327;
	j373202070 [label="Большую часть времени я провожу в борьбе за жизнь. Такие маленькие напоминания о человечности - это... то, ради чего я живу.",shape=box,color=red];
		j373202070 -> j677292177;
	j612700975 [label="Наверное, время от времени мне приходится делать шаг назад и задумываться над абсурдностью всего этого. Норг и жрица Сола...",shape=box,color=red];
		j612700975 -> j1788526339;
	j111532455 [label="Просто его способы справляться со всем этим не совпадают с моими, когда я подвергаюсь этому слишком долго, вот и всё.",shape=box,color=blue];
		j111532455 -> j2096611327;
	j2096611327 [label="Ба. Мне вообще не следовало жаловаться. Мне нужно сегодня вечером отнести ужин Лиону, у него опять жуткие мигрени.",shape=box,color=blue];
		j2096611327 -> j2153280683;
		j2096611327 -> j632086383;
	j677292177 [label="+5 Chemistry",color=orange];
		j677292177 -> j1018560692;
	j1788526339 [label="+5 Chemistry",color=orange];
		j1788526339 -> j1218063530;
	j2153280683 [label="У него они бывают часто?",shape=box,color=red];
		j2153280683 -> j2590718560;
	j632086383 [label="Прости... что?",shape=box,color=red];
		j632086383 -> j338350490;
	j1018560692 [label="Никогда не теряй эту часть себя, Скиталец. Никогда не отпускай ту часть себя, которая ищет эти искры жизни.",shape=box,color=blue];
		j1018560692 -> j1881143970;
	j1218063530 [label="Боже мой, когда ты так говоришь, неудивительно. Звучит как одна из тех детских шуток, n'est-ce pas?",shape=box,color=blue];
		j1218063530 -> j4217180752;
	j2590718560 [label="Oui, oui. Раз в несколько недель? Раз в два месяца? Дольше всего я видела, как он обходился без этого, наверное, шесть месяцев.",shape=box,color=blue];
		j2590718560 -> j547018639;
	j338350490 [label="Ой! Боже мой. Хм. Представь себе головную боль, только гораздо более сильную. Я слышала, что некоторые называют их желчными головными болями. Они чаще встречаются у женщин.",shape=box,color=blue];
		j338350490 -> j2710805205;
		j338350490 -> j1735823474;
	j1881143970 [label="Мир слишком охотно превращается в тёмное и серьёзное место. Слишком легко готов причинять нам страдания на каждом шагу.",shape=box,color=blue];
		j1881143970 -> j3131721612;
	j4217180752 [label="Сестра, Священник и дьявол из будущего отправляются в прошлое... а затем в будущее... и встречаются с рыбой, оленем, гигантской птицей и дворецким...",shape=box,color=blue];
		j4217180752 -> j1235966365;
	j547018639 [label="Check boolean Megrim",color=orange];
		j547018639 -> j3099446562 [label=true,color=green];
		j547018639 -> j2528414086 [label=true,color=green];
		j547018639 -> j2599187864 [label=true,color=green];
		j547018639 -> j3099446562 [label=false,color=brown];
		j547018639 -> j2528414086 [label=false,color=brown];
		j547018639 -> j1479911266 [label=false,color=brown];
	j2710805205 [label="Думаю, сейчас мы называем это «мигренями».",shape=box,color=red];
		j2710805205 -> j1607719081;
	j1735823474 [label="Ага. Megrims. Спасибо.",shape=box,color=red];
		j1735823474 -> j3853908211;
	j3131721612 [label="Мы должны стремиться к любой яркости, к любой легкости, даже в форме ребячества, если это необходимо.",shape=box,color=blue];
		j3131721612 -> j3352196059;
	j1235966365 [label="Это довольно забавно, ты прав!",shape=box,color=blue];
		j1235966365 -> j66181249;
	j3099446562 [label="Интересно, что является их причиной.",shape=box,color=red];
		j3099446562 -> j1338342082;
	j2528414086 [label="Это звучит ужасно...",shape=box,color=red];
		j2528414086 -> j3828856495;
	j2599187864 [label="У меня тоже бывают мигрени. Они ужасные.",shape=box,color=red];
		j2599187864 -> j1526876880;
	j1479911266 [label="У меня тоже бывают такие головные боли. Они ужасные.",shape=box,color=red];
		j1479911266 -> j1526876880;
	j1607719081 [label="Интересно, какие ещё интересные исторические подробности мы откроем! Захватывающе. Обожаю узнавать новое. «Мигрень». Очевидно, путь был недалеким.",shape=box,color=blue];
		j1607719081 -> j3665021584;
	j3853908211 [label="Boolean Megrim is now true.",color=orange];
		j3853908211 -> j2214803233;
	j3352196059 [label="Теперь только если Лион воспримет это так же.",shape=box,color=blue];
		j3352196059 -> j2924248238;
	j66181249 [label="Если бы только мой дорогой Лион видел в этом свет так же, как я.",shape=box,color=blue];
		j66181249 -> j2924248238;
	j1338342082 [label="У него есть свои теории. ",shape=box,color=blue];
		j1338342082 -> j1490022991;
	j3828856495 [label="Если ты выразишь своё сочувствие, я уверена, оно будет принято с благодарностью. И, как бы это ни звучало, он будет благодарен за компанию.",shape=box,color=blue];
		j3828856495 -> j3852006450;
	j1526876880 [label="У тебя тоже? Ты должен рассказать Лиону. Он должен знать, что другие способны страдать так же.",shape=box,color=blue];
		j1526876880 -> j946258401;
	j3665021584 [label="Boolean Migraine is now true.",color=orange];
		j3665021584 -> j2214803233;
	j2214803233 [label="Как бы её ни называли, Лион лежит без сознания и будет лежать до утра. Бедняга не видит ничего, кроме размытого пятна, не чувствует ни рук, ни ног. И говорит мне, что боль невыносима.",shape=box,color=blue];
		j2214803233 -> j547018639;
	j2924248238 [label="Boolean MarieLyonSuffering1 is now true.",color=orange];
		j2924248238 -> j2590550937;
	j1490022991 [label="Хотя, возможно, правильнее будет сказать, что у него были свои теории, до недавнего времени.",shape=box,color=blue];
		j1490022991 -> j2043897066;
	j3852006450 [label="Хотя его поведение может тебя отговорить, умоляю тебя, Скиталец, будь тверд. За кажущейся суровой и каменной внешностью скрывается человек с огромной нуждой.",shape=box,color=blue];
		j3852006450 -> j1472725762;
		j3852006450 -> j2122830396;
		j3852006450 -> j1759528311;
	j946258401 [label="+5 Chemistry",color=orange];
		j946258401 -> j1426465112;
	j2590550937 [label="Ах да, кстати. Мне ужасно неловко жаловаться на головные боли. Мне нужно сегодня принести Лиону ужин, у него опять жуткая мигрень.",shape=box,color=blue];
		j2590550937 -> j632086383;
		j2590550937 -> j2153280683;
	j2043897066 [label="Boolean MarieLyonFaith1 is now true.",color=orange];
		j2043897066 -> j3852006450;
	j1472725762 [label="Я иногда проявляю большую упрямость. Не волнуйся.",shape=box,color=red];
		j1472725762 -> j1650161094;
	j2122830396 [label="У меня уже есть один Человек в Стене... почему бы не два?",shape=box,color=red];
		j2122830396 -> j974985566;
	j1759528311 [label="Он взрослый человек. Если захочет поговорить, пусть говорит.",shape=box,color=red];
		j1759528311 -> j3136421586;
	j1426465112 [label="Люминары знают, что иначе он добровольно страдал бы в одиночестве...",shape=box,color=blue];
		j1426465112 -> j101820747;
	j1650161094 [label="+5 Chemistry",color=orange];
		j1650161094 -> j2973666735;
	j974985566 [label="Шути со мной так, но не говори такого ему. Тема твоего Indifférence для него болезненна.",shape=box,color=blue];
		j974985566 -> j1776011128;
	j3136421586 [label="Да, он взрослый. Да, он мужчина. И я верю, он хочет говорить. Но я бросаю тебе вызов: спроси, умеет ли он говорить.",shape=box,color=blue];
		j3136421586 -> j492357980;
	j101820747 [label="Boolean MarieLyonSuffering2 is now true.",color=orange];
		j101820747 -> j3852006450;
	j2973666735 [label="Боюсь, тебе это понадобится, когда он рядом. Спасибо, Скиталец. Он мой самый дорогой друг и брат. И мне больно видеть, как он страдает.",shape=box,color=blue];
		j2973666735 -> j1256108278;
	j1776011128 [label="Будь стойким. И терпеливым. И добрым. Он мне как брат и мой самый близкий друг, Скиталец. И мне больно видеть, как он страдает.",shape=box,color=blue];
		j1776011128 -> j1256108278;
	j492357980 [label="Не все из нас одинаково одарены и считают себя вправе на это. Он страдает и считает, что страдать - его удел.",shape=box,color=blue];
		j492357980 -> j405665006;
	j1256108278 [label="Скоро мы снова поговорим. Par la grâce de Sol.",shape=box,color=blue];
		j1256108278 -> "Initiate conversation LyonHeadaches in /Lotus/Types/Gameplay/1999Wf/Dialogue/LyonDialogue_rom.dialogue";
	j405665006 [label="Он мне как брат и самый близкий друг. И моё сердце разрывается от боли за него. Поэтому я могу лишь попросить… быть терпеливыми. И добрыми. Если на это есть способность.",shape=box,color=blue];
		j405665006 -> j1256108278;
	"Initiate conversation LyonHeadaches in /Lotus/Types/Gameplay/1999Wf/Dialogue/LyonDialogue_rom.dialogue" [label="Initiate conversation LyonHeadaches in /Lotus/Types/Gameplay/1999Wf/Dialogue/LyonDialogue_rom.dialogue",color=orange];
		"Initiate conversation LyonHeadaches in /Lotus/Types/Gameplay/1999Wf/Dialogue/LyonDialogue_rom.dialogue" -> "Chat ends.";
}