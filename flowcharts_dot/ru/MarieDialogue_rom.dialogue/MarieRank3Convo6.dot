digraph {
	1418 [label="MarieRank3Convo6 begins.",color=orange];
		1418 -> 3740;
	3740 [label="Update boolean MarieLyonAvailable",color=orange];
		3740 -> 1419;
	1419 [label="Я должна задать тебе вопрос и умоляю тебя не судить меня за него, Скиталец.",shape=box,color=blue];
		1419 -> 1420;
		1419 -> 1421;
		1419 -> 1422;
	1420 [label="Ты попала в нелепую ситуацию. Разумеется, я не буду тебя судить.",shape=box,color=red];
		1420 -> 1423;
	1421 [label="Я сделаю все возможное.",shape=box,color=red];
		1421 -> 1424;
	1422 [label="[Конец.]",shape=box,color=red];
		1422 -> 1425;
	1423 [label="Vraiment gentil оказывая мне такую милость, не зная ни меня, ни того, что я собиралась тебе написать.",shape=box,color=blue];
		1423 -> 1426;
	1424 [label="+10 Chemistry",color=orange];
		1424 -> 1427;
	1425 [label="Chat ends.",color=orange];
	1426 [label="Но... большеголовая говорящая рыба тоже вызывает у тебя головную боль? Фибоначчи?",shape=box,color=blue];
		1426 -> 1428;
		1426 -> 1429;
		1426 -> 1430;
	1427 [label="Я очень ценю это, спасибо.",shape=box,color=blue];
		1427 -> 1426;
	1428 [label="Да. Да, конечно. Спасибо.",shape=box,color=red];
		1428 -> 1431;
	1429 [label="Мысль о том, что тебя раздражает Фибоначчи, невероятно умилительна.",shape=box,color=red];
		1429 -> 1432;
	1430 [label="Нет, вообще-то. Я его обожаю.",shape=box,color=red];
		1430 -> 1433;
	1431 [label="Тогда я рада, что я не одна. Но, если честно, я не хочу его обидеть. Если я чувствую себя не в своей тарелке из-за своего нынешнего положения, то, полагаю, он терпит как может.",shape=box,color=blue];
		1431 -> 1434;
	1432 [label="О? Как так? Наверное, я рада этому, но просто не понимаю, почему. Моя головная боль, конечно, далеко не так умилительна.",shape=box,color=blue];
		1432 -> 1435;
		1432 -> 1436;
	1433 [label="Тогда мне остаётся лишь просить у тебя прощения. Я вовсе не хочу его обидеть. Если мне самой не по себе из-за моего нынешнего положения, то, полагаю, он держится, как может.",shape=box,color=blue];
		1433 -> 1437;
	1434 [label="Просто его способы справляться со всем этим не совпадают с моими, когда я подвергаюсь этому слишком долго, вот и всё.",shape=box,color=blue];
		1434 -> 1438;
	1435 [label="Большую часть времени я провожу в борьбе за жизнь. Такие маленькие напоминания о человечности - это... то, ради чего я живу.",shape=box,color=red];
		1435 -> 1439;
	1436 [label="Наверное, время от времени мне приходится делать шаг назад и задумываться над абсурдностью всего этого. Норг и жрица Сола...",shape=box,color=red];
		1436 -> 1440;
	1437 [label="Просто его способы справляться со всем этим не совпадают с моими, когда я подвергаюсь этому слишком долго, вот и всё.",shape=box,color=blue];
		1437 -> 1441;
	1438 [label="Ба. Мне вообще не следовало жаловаться. Мне нужно сегодня вечером отнести ужин Лиону, у него опять жуткие мигрени.",shape=box,color=blue];
		1438 -> 1442;
		1438 -> 1443;
	1439 [label="+5 Chemistry",color=orange];
		1439 -> 1444;
	1440 [label="+5 Chemistry",color=orange];
		1440 -> 1445;
	1441 [label="Ба. Мне вообще не следовало жаловаться. Мне нужно сегодня вечером отнести ужин Лиону, у него опять жуткие мигрени.",shape=box,color=blue];
		1441 -> 1442;
		1441 -> 1443;
	1442 [label="У него они бывают часто?",shape=box,color=red];
		1442 -> 1446;
	1443 [label="Прости... что?",shape=box,color=red];
		1443 -> 1447;
	1444 [label="Никогда не теряй эту часть себя, Скиталец. Никогда не отпускай ту часть себя, которая ищет эти искры жизни.",shape=box,color=blue];
		1444 -> 1448;
	1445 [label="Боже мой, когда ты так говоришь, неудивительно. Звучит как одна из тех детских шуток, n'est-ce pas?",shape=box,color=blue];
		1445 -> 1449;
	1446 [label="Oui, oui. Раз в несколько недель? Раз в два месяца? Дольше всего я видела, как он обходился без этого, наверное, шесть месяцев.",shape=box,color=blue];
		1446 -> 1450;
	1447 [label="Ой! Боже мой. Хм. Представь себе головную боль, только гораздо более сильную. Я слышала, что некоторые называют их желчными головными болями. Они чаще встречаются у женщин.",shape=box,color=blue];
		1447 -> 1451;
		1447 -> 1452;
	1448 [label="Мир слишком охотно превращается в тёмное и серьёзное место. Слишком легко готов причинять нам страдания на каждом шагу.",shape=box,color=blue];
		1448 -> 1453;
	1449 [label="Сестра, Священник и дьявол из будущего отправляются в прошлое... а затем в будущее... и встречаются с рыбой, оленем, гигантской птицей и дворецким...",shape=box,color=blue];
		1449 -> 1454;
	1450 [label="Check boolean Megrim",color=orange];
		1450 -> 1455 [label=true,color=green];
		1450 -> 1456 [label=true,color=green];
		1450 -> 1458 [label=true,color=green];
		1450 -> 1455 [label=false,color=brown];
		1450 -> 1456 [label=false,color=brown];
		1450 -> 1457 [label=false,color=brown];
	1451 [label="Думаю, сейчас мы называем это «мигренями».",shape=box,color=red];
		1451 -> 1459;
	1452 [label="Ага. Megrims. Спасибо.",shape=box,color=red];
		1452 -> 1460;
	1453 [label="Мы должны стремиться к любой яркости, к любой легкости, даже в форме ребячества, если это необходимо.",shape=box,color=blue];
		1453 -> 1461;
	1454 [label="Это довольно забавно, ты прав!",shape=box,color=blue];
		1454 -> 1462;
	1455 [label="Интересно, что является их причиной.",shape=box,color=red];
		1455 -> 1463;
	1456 [label="Это звучит ужасно...",shape=box,color=red];
		1456 -> 1464;
	1458 [label="У меня тоже бывают мигрени. Они ужасные.",shape=box,color=red];
		1458 -> 1465;
	1457 [label="У меня тоже бывают такие головные боли. Они ужасные.",shape=box,color=red];
		1457 -> 1465;
	1459 [label="Интересно, какие ещё интересные исторические подробности мы откроем! Захватывающе. Обожаю узнавать новое. «Мигрень». Очевидно, путь был недалеким.",shape=box,color=blue];
		1459 -> 1466;
	1460 [label="Update boolean Megrim",color=orange];
		1460 -> 1467;
	1461 [label="Теперь только если Лион воспримет это так же.",shape=box,color=blue];
		1461 -> 1468;
	1462 [label="Если бы только мой дорогой Лион видел в этом свет так же, как я.",shape=box,color=blue];
		1462 -> 1468;
	1463 [label="У него есть свои теории. ",shape=box,color=blue];
		1463 -> 1469;
	1464 [label="Если ты выразишь своё сочувствие, я уверена, оно будет принято с благодарностью. И, как бы это ни звучало, он будет благодарен за компанию.",shape=box,color=blue];
		1464 -> 1470;
	1465 [label="У тебя тоже? Ты должен рассказать Лиону. Он должен знать, что другие способны страдать так же.",shape=box,color=blue];
		1465 -> 1471;
	1466 [label="Update boolean Migraine",color=orange];
		1466 -> 1467;
	1467 [label="Как бы её ни называли, Лион лежит без сознания и будет лежать до утра. Бедняга не видит ничего, кроме размытого пятна, не чувствует ни рук, ни ног. И говорит мне, что боль невыносима.",shape=box,color=blue];
		1467 -> 1450;
	1468 [label="Update boolean MarieLyonSuffering1",color=orange];
		1468 -> 1472;
	1469 [label="Хотя, возможно, правильнее будет сказать, что у него были свои теории, до недавнего времени.",shape=box,color=blue];
		1469 -> 1473;
	1470 [label="Хотя его поведение может тебя отговорить, умоляю тебя, Скиталец, будь тверд. За кажущейся суровой и каменной внешностью скрывается человек с огромной нуждой.",shape=box,color=blue];
		1470 -> 1474;
		1470 -> 1475;
		1470 -> 1476;
	1471 [label="+5 Chemistry",color=orange];
		1471 -> 1477;
	1472 [label="Ах да, кстати. Мне ужасно неловко жаловаться на головные боли. Мне нужно сегодня принести Лиону ужин, у него опять жуткая мигрень.",shape=box,color=blue];
		1472 -> 1443;
		1472 -> 1442;
	1473 [label="Update boolean MarieLyonFaith1",color=orange];
		1473 -> 1470;
	1474 [label="Я иногда проявляю большую упрямость. Не волнуйся.",shape=box,color=red];
		1474 -> 1478;
	1475 [label="У меня уже есть один Человек в Стене... почему бы не два?",shape=box,color=red];
		1475 -> 1479;
	1476 [label="Он взрослый человек. Если захочет поговорить, пусть говорит.",shape=box,color=red];
		1476 -> 1480;
	1477 [label="Люминары знают, что иначе он добровольно страдал бы в одиночестве...",shape=box,color=blue];
		1477 -> 1481;
	1478 [label="+5 Chemistry",color=orange];
		1478 -> 1482;
	1479 [label="Шути со мной так, но не говори такого ему. Тема твоего Indifférence для него болезненна.",shape=box,color=blue];
		1479 -> 1483;
	1480 [label="Да, он взрослый. Да, он мужчина. И я верю, он хочет говорить. Но я бросаю тебе вызов: спроси, умеет ли он говорить.",shape=box,color=blue];
		1480 -> 1484;
	1481 [label="Update boolean MarieLyonSuffering2",color=orange];
		1481 -> 1470;
	1482 [label="Боюсь, тебе это понадобится, когда он рядом. Спасибо, Скиталец. Он мой самый дорогой друг и брат. И мне больно видеть, как он страдает.",shape=box,color=blue];
		1482 -> 1485;
	1483 [label="Будь стойким. И терпеливым. И добрым. Он мне как брат и мой самый близкий друг, Скиталец. И мне больно видеть, как он страдает.",shape=box,color=blue];
		1483 -> 1485;
	1484 [label="Не все из нас одинаково одарены и считают себя вправе на это. Он страдает и считает, что страдать - его удел.",shape=box,color=blue];
		1484 -> 1486;
	1485 [label="Скоро мы снова поговорим. Par la grâce de Sol.",shape=box,color=blue];
		1485 -> 3734;
	1486 [label="Он мне как брат и самый близкий друг. И моё сердце разрывается от боли за него. Поэтому я могу лишь попросить… быть терпеливыми. И добрыми. Если на это есть способность.",shape=box,color=blue];
		1486 -> 1485;
	3734 [label="{\"Id\":3734,\"Incoming\":[1485],\"Outgoing\":[1487],\"GraphPos\":[12826,24521],\"CompletionType\":2,\"OtherDialogueInfos\":[{\"Dialogue\":\"/Lotus/Types/Gameplay/1999Wf/Dialogue/LyonDialogue_rom.dialogue\",\"Tag\":\"LyonHeadaches\",\"Value\":0}]}",color=orange];
		3734 -> 1487;
	1487 [label="Chat ends.",color=orange];
}