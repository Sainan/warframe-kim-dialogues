	j1041733771 [label="Mon cœur! У тебя есть минутка? Я бы с удовольствием поговорила с тобой, если ты найдёшь время.",shape=box,color=blue];
		j1041733771 -> j2201620931;
		j1041733771 -> j1310452999;
	j4011750326 [label="Самый дорогой из моих дорогих! У тебя есть время поговорить со мной минутку?",shape=box,color=blue];
		j4011750326 -> j522083443;
		j4011750326 -> j1310452999;
	j1755318033 [label="Укротитель дьяволов! У тебя есть минутка поговорить со мной?",shape=box,color=blue];
