	j1152213505 [label="У тебя есть минутка? Я бы с удовольствием поговорила с тобой, если ты найдёшь время.",shape=box,color=blue];
		j1152213505 -> j3327518807;
		j1152213505 -> j1310452999;
	j2434075740 [label="У тебя есть минутка? Я бы с удовольствием поговорила с тобой, если у тебя есть время.",shape=box,color=blue];
		j2434075740 -> j773297195;
		j2434075740 -> j3218551002;
		j2434075740 -> j1310452999;
	j2201620931 [label="Для тебя, всегда. Что случилось?",shape=box,color=red];
		j2201620931 -> j615969726;
	j1310452999 [label="[Конец.]",shape=box,color=red];
		j1310452999 -> "Chat ends.";
	j522083443 [label="В любое время. Что случилось?",shape=box,color=red];
		j522083443 -> j3637401890;
	j3342621809 [label="Хе. Не думаю что он приручён. Что случилось?",shape=box,color=red];
		j3342621809 -> j1142722738;
	j3327518807 [label="Для тебя, всегда. Что случилось?",shape=box,color=red];
		j3327518807 -> j1864957210;
	j773297195 [label="Конечно. Что случилось?",shape=box,color=red];
		j773297195 -> j585288646;
	j3218551002 [label="[Признаться в чувствах.] Сейчас самое подходящее время, мне тоже хочется кое-что сказать... ",shape=box,color=red];
		j3218551002 -> j772235770;
	j615969726 [label="Я думаю о том, как много времени мы провели вместе. Как мало это было по сравнению со всеми прожитыми твоими годами.",shape=box,color=blue];
		j615969726 -> j3601373997;
	"Chat ends." [color=orange];
	j3637401890 [label="Как хороша и добра твоя дружба — и какой союзник, о каком невозможно было даже мечтать. ",shape=box,color=blue];
		j3637401890 -> j3352154434;
	j1142722738 [label="Oui, и, думаю, тебе так больше по душе, non ? Ха ! Я не хочу представлять дьявола в таком виде — неважно! Я пришёла поговорить совсем не об этом.",shape=box,color=blue];
		j1142722738 -> j3470333215;
	j1864957210 [label="Evaluate expressions",color=orange];
		j1864957210 -> j2581251732 [label="RoatheDating",color=purple];
		j1864957210 -> j2581251732 [label="LyonDating",color=purple];
		j1864957210 -> j4085054165 [label="IsDating",color=purple];
		j1864957210 -> j2373205721 [label="false",color=purple];
	j585288646 [label="Я думаю о том, как много времени мы провели вместе. Как мало это было по сравнению со всеми прожитыми твоими годами.",shape=box,color=blue];
		j585288646 -> j1007871186;
	j772235770 [label="Non, дай мне высказаться первой, иначе я потеряю самообладание!",shape=box,color=blue];
		j772235770 -> j1471879296;
	j3601373997 [label="Но я думаю о том, как много они для меня значат. Как сильно они изменили меня и ход моей жизни, словно корабль в море.",shape=box,color=blue];
		j3601373997 -> j2425932986;
	j3352154434 [label="Evaluate expressions",color=orange];
		j3352154434 -> j1289142507 [label="LyonFaith3Yes",color=purple];
		j3352154434 -> j4078128976 [label="LyonFaith3No",color=purple];
		j3352154434 -> j2094695975 [label="LyonFaith3Maybe",color=purple];
		j3352154434 -> j2094695975 [label="false",color=purple];
	j3470333215 [label="Evaluate expressions",color=orange];
		j3470333215 -> j4162060710 [label="LoidFamilyComplete",color=purple];
		j3470333215 -> j2827548148 [label="RoatheRedeemed",color=purple];
		j3470333215 -> j3095139704 [label="RoatheVillain",color=purple];
		j3470333215 -> j410070283 [label="RoatheHellComplete",color=purple];
		j3470333215 -> j617070438 [label="false",color=purple];
	j2581251732 [label="Я знаю, что однажды от тебя прозвучали слова о чувствах ко мне. И всё же теперь я вижу тебя с другим человеком. Я просто хотела сказать, что рада за тебя!",shape=box,color=blue];
		j2581251732 -> j3038283474;
	j4085054165 [label="Однажды это было сказано тобой.. ох, я даже не знаю, как это сказать. Что у тебя есть ко мне чувства. И всё же я знаю, что в твоей жизни есть кто‑то ещё.",shape=box,color=blue];
		j4085054165 -> j60150611;
		j4085054165 -> j2712639850;
	j2373205721 [label="Однажды это было сказано тобой.. ох, я даже не знаю, как подобрать слова. Что у тебя есть ко мне чувства.",shape=box,color=blue];
		j2373205721 -> j1928846357;
	j1007871186 [label="Но я думаю о том, как много они для меня значат. Как сильно они изменили меня и ход моей жизни, словно корабль в море.",shape=box,color=blue];
		j1007871186 -> j527482101;
	j1471879296 [label="Evaluate expressions",color=orange];
		j1471879296 -> j947728274 [label="MarieNoDate",color=purple];
		j1471879296 -> j1740750704 [label="MarieWillDate",color=purple];
		j1471879296 -> j947728274 [label="false",color=purple];
	j2425932986 [label="И я думаю про себя - разве это не то, что стремится разрушить Безразличие? Не это ли оно пожирает? Cпособность одних влиять на других?",shape=box,color=blue];
		j2425932986 -> j859145806;
	j1289142507 [label="Брату моей души дарован покой, благодаря тебе. Ему показано, что есть настоящий враг, с которым нужно бороться, - и дана надежда.",shape=box,color=blue];
		j1289142507 -> j237174379;
	j4078128976 [label="Благодаря тебе брату моей души были дарованы утешение и покой - то, чего прежде у него не было. Думаю, твоё присутствие значило для него больше, чем он способен выразить словами.",shape=box,color=blue];
		j4078128976 -> j237174379;
	j2094695975 [label="Хотя мы, возможно, никогда не узнаем ответа на вопрос о том, что такое Безразличие на самом деле, мы знаем, что оно не имеет значения. Мы должны принять его как вызов, который оно бросает, – и это реально.",shape=box,color=blue];
		j2094695975 -> j237174379;
	j4162060710 [label="Я не думала, что нашего дьявола удастся убедить помочь Monsieur Лойду и семье le Cardinal вновь наладить связь. Я понимаю, что его мотивы… возможно, сомнительны, и я по-прежнему не до конца ему доверяю. ",shape=box,color=blue];
		j4162060710 -> j3614689113;
	j2827548148 [label="Я не думала, что нашему дьяволу укажут на его ошибки. Что он хоть немного пожалеет о невинных жизнях, которые он прожил. Моя неправота стала очевидна благодаря тебе.",shape=box,color=blue];
		j2827548148 -> j2191157321;
	j3095139704 [label="Какие бы цепи ни удерживали нашего дьявола, они держат его на привязи. Он кажется куда более… сдержанным, чем прежде. И за это благодарить следует тебя.",shape=box,color=blue];
		j3095139704 -> j2191157321;
	j410070283 [label="Воспоминания, которые мы помогли ему вернуть, похоже, закалили его. Возможно, воспоминания о горе по всем тем, кого он потерял, напомнили ему о тех, кого он ещё может потерять.",shape=box,color=blue];
		j410070283 -> j2191157321;
	j617070438 [label="Может быть, его смягчает привязанность к тебе, не знаю. Какова бы ни была причина, за это стоит благодарить.",shape=box,color=blue];
		j617070438 -> j2191157321;
	j3038283474 [label="Я не держу на тебя ни капли злобы, лишь радость за вас обоих, oui?",shape=box,color=blue];
		j3038283474 -> j1118905654;
		j3038283474 -> j2737876413;
	j60150611 [label="Всё изменилось, и… нужно оставаться верным им. Прости.",shape=box,color=red];
		j60150611 -> j2105463869;
	j2712639850 [label="В это может быть трудно поверить или даже принять, я знаю. Но я… люблю тебя. И люблю их. В равной мере.",shape=box,color=red];
		j2712639850 -> j3734127592;
	j1928846357 [label="Evaluate expressions",color=orange];
		j1928846357 -> j317943053 [label="MarieNoDate",color=purple];
		j1928846357 -> j2675636687 [label="MarieWillDate",color=purple];
		j1928846357 -> j702767753 [label="MarieWillDate",color=purple];
		j1928846357 -> j317943053 [label="false",color=purple];
	j527482101 [label="И я думаю про себя - разве это не то, что стремится разрушить Безразличие? Не это ли оно пожирает? Cпособность одних влиять на других?",shape=box,color=blue];
		j527482101 -> j1351256161;
	j947728274 [label="Боюсь, ты сейчас скажешь мне слова, которые не сможешь взять обратно. И это изменит отношения между нами навсегда.",shape=box,color=blue];
		j947728274 -> j479070245;
	j1740750704 [label="Mon cœur t'appartient depuis notre première recontre...",shape=box,color=blue];
		j1740750704 -> j1504162028;
		j1740750704 -> j4117231419;
	j859145806 [label="Дар заставлять друг друга смеяться. Плакать. Убеждать друг друга в истине или лжи. Менять мнения друг друга. Подбадривать, когда один из вас в боли. Причинять друг другу боль по глупости.",shape=box,color=blue];
		j859145806 -> j3718371365;
	j237174379 [label="И в чём же разница, если именно ты рядом, чтобы вести Лиона через самые тёмные часы и поддерживать его в минуты боли и agonie?",shape=box,color=blue];
		j237174379 -> j1864497539;
	j3614689113 [label="И в этом, без всякого сомнения, следует благодарить тебя. Роут здесь и защищает семью le Cardinal, благодаря тебе.",shape=box,color=blue];
		j3614689113 -> j2191157321;
	j2191157321 [label="И я знаю, что наш дьявол — не наш враг, oui? Наш враг, это Безразличие. И чему учит нас Безразличие, если не тому, чтобы держаться за всё, что оно отвергает, за всё, что оно уничтожает?",shape=box,color=blue];
		j2191157321 -> j3990822654;
	j1118905654 [label="Но... что если ",shape=box,color=red];
		j1118905654 -> j1581257458;
	j2737876413 [label="У меня тоже есть чувства к тебе, Мари.",shape=box,color=red];
		j2737876413 -> j2203521110;
	j2105463869 [label="Oui, я понимаю. Конечно, понимаю! Как я могу тебя винить за то, что ты следуешь за своей душой ?",shape=box,color=blue];
		j2105463869 -> j2449238190;
	j3734127592 [label="Evaluate expressions",color=orange];
		j3734127592 -> j317943053 [label="MarieNoDate",color=purple];
		j3734127592 -> j974135550 [label="MarieWillDate",color=purple];
		j3734127592 -> j317943053 [label="false",color=purple];
	j317943053 [label="Я не знаю, как сказать это, не проявив жестокости, поэтому я... скажу это просто.",shape=box,color=blue];
		j317943053 -> j3156950783;
	j2675636687 [label="Да, у меня есть. Я... не думаю, что ты чувствуешь то же самое?",shape=box,color=red];
		j2675636687 -> j2167364034;
	j702767753 [label="Все изменилось, и... Мне жаль.",shape=box,color=red];
		j702767753 -> j814351419;
	j1351256161 [label="Дар заставлять друг друга смеяться. Плакать. Убеждать друг друга в истине или лжи. Менять мнения друг друга. Подбадривать, когда один из вас в боли. Причинять друг другу боль по глупости.",shape=box,color=blue];
		j1351256161 -> j3115696115;
	j479070245 [label="И мне так печально, о, как же печально мне останавливать тебя прежде, чем ты успеешь это сделать.",shape=box,color=blue];
		j479070245 -> j2046546789;
	j1504162028 [label="Я... не знаю, что это значит, Мари.",shape=box,color=red];
		j1504162028 -> j2106102019;
	j4117231419 [label="Mon cœur t'appartient également, Мари !",shape=box,color=red];
		j4117231419 -> j243439988;
	j3718371365 [label="Дарить друг другу удовольствие, когда вы любите. Причинять друг другу agonie, когда вы теряетесь в ненависти. Таков дар человечности, и именно этим Безразличие не является.",shape=box,color=blue];
		j3718371365 -> j3107998667;
	j1864497539 [label="Чему нас учит Безразличие, независимо от его происхождения, если не тому, чтобы держаться за всё, что оно отвергает, за всё, что оно разрушает?",shape=box,color=blue];
		j1864497539 -> j726737348;
	j3990822654 [label="Я думаю о том, как много времени мы провели вместе. Как мало это было по сравнению со всеми прожитыми твоими годами.",shape=box,color=blue];
		j3990822654 -> j4088314027;
	j1581257458 [label="Вместо этого? Тогда... Боюсь, тебе сначала придётся распутать нити своего сердца, Скиталец. Я не могу сделать это за тебя.",shape=box,color=blue];
		j1581257458 -> j3699890413;
	j2203521110 [label="И вполне возможно, что так оно и есть. Я не ревнивая, но одно дело знать, что кто‑то завладел твоим сердцем, когда я его не знаю -",shape=box,color=blue];
		j2203521110 -> j466575586;
	j2449238190 [label="+10 Chemistry",color=orange];
		j2449238190 -> j1154347886;
	j974135550 [label="Я - ох! Ох, mon cœur!",shape=box,color=blue];
		j974135550 -> j3291411750;
	j3156950783 [label="Боюсь… тебе просто следует выбрать другого человека. Того, что ты чувствуешь ко мне, я к тебе не чувствую. Прости меня.",shape=box,color=blue];
		j3156950783 -> j3483910237;
	j2167364034 [label="Я - ох! Ох, mon cœur!",shape=box,color=blue];
		j2167364034 -> j4084680673;
	j814351419 [label="Oui, я понимаю. Конечно, понимаю! Как я могу тебя винить за то, что ты следуешь за своей душой?",shape=box,color=blue];
		j814351419 -> j2703851229;
	j3115696115 [label="Дарить друг другу удовольствие, когда вы любите. Причинять друг другу agonie, когда вы теряетесь в ненависти. Таков дар человечности, и именно этим Безразличие не является.",shape=box,color=blue];
		j3115696115 -> j4137336061;
	j2046546789 [label="Я не знаю, как сказать это, не проявив жестокости, поэтому я... скажу это просто.",shape=box,color=blue];
		j2046546789 -> j1491413424;
	j2106102019 [label="Oui, я знаю! В этом-то и суть! Мне слишком страшно сказать... сказать, как сильно я тебя полюбила. ",shape=box,color=blue];
		j2106102019 -> j1174408665;
	j243439988 [label="+10 Chemistry",color=orange];
		j243439988 -> j1825202518;
	j3107998667 [label="Оно нечисто и несовершенно, но прекрасно, как звёзды в небе. Миллиард крошечных огоньков, сплетающихся в узор, океан света.",shape=box,color=blue];
		j3107998667 -> j264050409;
	j726737348 [label="Я думаю о том, как много времени мы провели вместе. Как мало это было по сравнению со всеми прожитыми твоими годами.",shape=box,color=blue];
		j726737348 -> j964523448;
	j4088314027 [label="Но я думаю о том, как много они для меня значат. Как сильно они изменили меня и ход моей жизни, словно корабль в море.",shape=box,color=blue];
		j4088314027 -> j498555273;
	j3699890413 [label="Evaluate expressions",color=orange];
		j3699890413 -> j3773598143 [label="LyonDating",color=purple];
		j3699890413 -> j1532370993 [label="RoatheDating",color=purple];
	j466575586 [label="Другое дело, когда это брат моей души или дьявол, с которым мне приходится бороться ежедневно.",shape=box,color=blue];
		j466575586 -> j2804420847;
	j1154347886 [label="Да благословит Сол тебя и твои сердца. Я лишь считаю себя счастливой быть среди тех, кого ты называешь другом!",shape=box,color=blue];
		j1154347886 -> j3501942296;
	j3291411750 [label="Я... не знаю, что сказать, кроме того, что я тебе верю. И что я... я чувствую то же самое. Mon cœur t'appartient depuis notre première rencontre.",shape=box,color=blue];
		j3291411750 -> j1649686317;
	j3483910237 [label="Но верь, в маленькой Мари у тебя есть союзник, который будет рядом с тобой до конца, что бы ни случилось.",shape=box,color=blue];
		j3483910237 -> "Chat ends.";
	j4084680673 [label="Я... не знаю, что сказать, кроме того, что... я чувствую то же самое. Mon cœur t'appartient depuis notre première rencontre.",shape=box,color=blue];
		j4084680673 -> j1649686317;
	j2703851229 [label="+10 Chemistry",color=orange];
		j2703851229 -> j3549456701;
	j4137336061 [label="Оно нечисто и несовершенно, но прекрасно, как звёзды в небе. Миллиард крошечных огоньков, сплетающихся в узор, океан света.",shape=box,color=blue];
		j4137336061 -> j3622229851;
	j1491413424 [label="То, что ты чувствуешь ко мне, я не чувствую в ответ. Прости.",shape=box,color=blue];
		j1491413424 -> j3483910237;
	j1174408665 [label="Mon cœur t'appartient depuis notre première recontre.",shape=box,color=blue];
		j1174408665 -> j1649686317;
	j1825202518 [label="Ах! Где ты этому научился?! Лион?! О, неважно! О, мой волк!",shape=box,color=blue];
		j1825202518 -> j1649686317;
	j264050409 [label="Это всё детали, без какой-либо précision, oui? Кого волнует, откуда они берутся... это то, чем мы являемся.",shape=box,color=blue];
		j264050409 -> j2237913211;
	j964523448 [label="Но я думаю о том, как много они для меня значат. Как сильно они изменили меня и ход моей жизни, словно корабль в море.",shape=box,color=blue];
		j964523448 -> j4248476815;
	j498555273 [label="И я думаю про себя - разве это не то, что стремится разрушить Безразличие? Не это ли оно пожирает? Cпособность одних влиять на других?",shape=box,color=blue];
		j498555273 -> j3767414531;
	j3773598143 [label="Я лишь молюсь, чтобы Лион не был введён в заблуждение и не пострадал лишне. Он — существо хрупкое, под этой каменной внешностью.",shape=box,color=blue];
		j3773598143 -> j2099266133;
	j1532370993 [label="Я не желаю Роуту страданий, хотя и подкалываю его и читаю нотации. Не причиняй ему боли, если можешь.",shape=box,color=blue];
		j1532370993 -> j2099266133;
	j2804420847 [label="Я могла бы успокоиться и даже возрадоваться, если бы мне пришлось делить тебя с кем-то другим, но с семьёй или врагом? Думаю, это для меня слишком.",shape=box,color=blue];
		j2804420847 -> j2208877159;
		j2804420847 -> j2070820196;
	j3501942296 [label="И верь, в маленькой Мари у тебя есть друг, который будет рядом с тобой до конца, что бы ни случилось.",shape=box,color=blue];
		j3501942296 -> "Chat ends.";
	j1649686317 [label="Я думаю о том, как много времени мы провели вместе. Как мало это было по сравнению со всеми прожитыми твоими годами.",shape=box,color=blue];
		j1649686317 -> j634189634;
	j3549456701 [label="Я просто считаю себя благословенной, находясь среди тех, кого ты называешь другом!",shape=box,color=blue];
		j3549456701 -> j3501942296;
	j3622229851 [label="Это всё детали, без какой-либо точности, да? Кого волнует, откуда они берутся... это то, чем мы являемся.",shape=box,color=blue];
