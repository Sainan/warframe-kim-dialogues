		j997875809 -> j967122264 [label=true,color=green];
		j997875809 -> "Chat ends." [label=false,color=brown];
	j967122264 [label="Check boolean MarieOtak1",color=orange];
		j967122264 -> j3619684352 [label=true,color=green];
		j967122264 -> j3979133402 [label=false,color=brown];
	j3619684352 [label="Check boolean MarieDating",color=orange];
		j3619684352 -> j1831743963 [label=true,color=green];
		j3619684352 -> j3702629866 [label=false,color=brown];
	j3979133402 [label="Check boolean MarieDating",color=orange];
		j3979133402 -> j1740871694 [label=true,color=green];
		j3979133402 -> j970233788 [label=false,color=brown];
	j1831743963 [label="Волк! Мой волк! Я встретила Отака! Наконец-то я его встретила!",shape=box,color=blue];
		j1831743963 -> j1336338782;
		j1831743963 -> j2168146470;
	j3702629866 [label="Я встретила Отака! Наконец-то я его встретила!",shape=box,color=blue];
		j3702629866 -> j1336338782;
		j3702629866 -> j2168146470;
	j1740871694 [label="Волк! Мой волк! Лицо на спине Monsieur Некралоида! Наконец-то я его встретила!",shape=box,color=blue];
		j1740871694 -> j1095794543;
		j1740871694 -> j4152192953;
		j1740871694 -> j919812164;
	j970233788 [label="Лицо на спине Monsieur Некралоида! Я наконец-то встретила его!",shape=box,color=blue];
		j970233788 -> j1095794543;
		j970233788 -> j4152192953;
		j970233788 -> j919812164;
	j1336338782 [label="Тебе понравилось с ним общаться?",shape=box,color=red];
		j1336338782 -> j2703944994;
	j2168146470 [label="Как прошел твой разговор с ним?",shape=box,color=red];
		j2168146470 -> j4164112970;
	j1095794543 [label="Бедный Отак... Как все прошло?",shape=box,color=red];
		j1095794543 -> j3484293064;
	j4152192953 [label="Приятно, что вы наконец встретились. С Отаком бывает сложновато объяснить.",shape=box,color=red];
		j4152192953 -> j3631455926;
	j919812164 [label="Ты познакомилась с Отаком? О боже... Как всё прошло?",shape=box,color=red];
		j919812164 -> j201752908;
	j2703944994 [label="Да. Хотя, возможно, мне хотелось плакать из-за этого. Ведь он представился мне трижды в одном разговоре, словно мы никогда и не были знакомы.",shape=box,color=blue];
		j2703944994 -> j97767831;
	j4164112970 [label="Он... представился мне трижды в ходе одного разговора, как будто мы никогда не были представлены друг другу.",shape=box,color=blue];
		j4164112970 -> j97767831;
	j3484293064 [label="Мне показался он исключительно милым и очаровательным! Но под слоем юмора скрывалось моё глубокое горе.",shape=box,color=blue];
		j3484293064 -> j1189597611;
	j3631455926 [label="Да, так я и думаю. Детский каракуль на спине автомата. Мне показался он исключительно милым и очаровательным!",shape=box,color=blue];
		j3631455926 -> j540666587;
	j201752908 [label="Почему ты звучишь так, будто тебе не особенно приятно, что я встретилась с ним?",shape=box,color=blue];
		j201752908 -> j2362664230;
		j201752908 -> j1849259466;
		j201752908 -> j3957267530;
	j97767831 [label="Приветствовал меня так же решительно и радушно, как и раньше. Но он знал во мне Sœur de Sol! ",shape=box,color=blue];
		j97767831 -> j3463763354;
	j1189597611 [label="Не расскажешь ли мне историю бедного Monsieur Отака?",shape=box,color=blue];
		j1189597611 -> j3220971277;
	j540666587 [label="Но за этим юмором скрывается огромное горе.",shape=box,color=blue];
		j540666587 -> j1189597611;
	j2362664230 [label="Иногда он действует мне на нервы, вот и все. ",shape=box,color=red];
		j2362664230 -> j832379628;
	j1849259466 [label="Я не про это. Он просто может быть немного... отталкивающим для некоторых людей.",shape=box,color=red];
		j1849259466 -> j575133948;
	j3957267530 [label="Мне жаль. Он иногда действует людям на нервы. Это не его вина.",shape=box,color=red];
		j3957267530 -> j575133948;
	j3463763354 [label="Да, он много знал о Светилах! Мы долго говорили о «Древних религиях», как он их называл, во времена «до Империи Орокин».",shape=box,color=blue];
		j3463763354 -> j1993269787;
	j3220971277 [label="Раньше Отак был архимедиан, учёным и академиком Орокин. То, что с ним произошло, нельзя назвать особенно радостной историей.",shape=box,color=red];
		j3220971277 -> j2829147922;
	j832379628 [label="Надеюсь, ты постараешься быть добрее к человеку, который явно немощен. Mais par la grâce de Sol, идём все мы.",shape=box,color=blue];
		j832379628 -> j669267770;
	j575133948 [label="И я надеюсь, что они проявят к нему доброту и терпение. Mais par la grâce de Sol, мы все пойдём.",shape=box,color=blue];
		j575133948 -> j669267770;
	j1993269787 [label="Хотя он сказал, что большая часть этих знаний теперь утеряна, спрятана глубоко в архивах и находится под запретом. Он взял с меня клятву хранить тайну.",shape=box,color=blue];
		j1993269787 -> j2919224244;
	j2829147922 [label="Судя по всему, он был гением и умом, стоящим за освоением кристаллов аргона.",shape=box,color=red];
		j2829147922 -> j3465113580;
	j669267770 [label="Такая участь может ждать любого из нас. Даже тебя.",shape=box,color=blue];
		j669267770 -> j508849510;
		j669267770 -> j802676067;
	j2919224244 [label="Он сказал мне, что глубоко обеспокоен тем, что Исполнитель Баллас — кем бы он ни был — может раскрыть мою секту еретиков и казнить меня.",shape=box,color=blue];
		j2919224244 -> j1593130068;
		j2919224244 -> j2312600381;
	j3465113580 [label="Которые извлекаются из Бездны, именно благодаря им мы можем создавать множество мощных варфреймов и оружия.",shape=box,color=red];
		j3465113580 -> j1018738462;
	j508849510 [label="Ты права, извини. Не это было в моих намерениях.",shape=box,color=red];
		j508849510 -> j1189597611;
	j802676067 [label="У меня просто нет времени на него, извини.",shape=box,color=red];
		j802676067 -> j2710153948;
	j1593130068 [label="Баллас мертв... продолжай.",shape=box,color=red];
		j1593130068 -> j877350583;
	j2312600381 [label="Этого... не будет. Продолжай говорить.",shape=box,color=red];
		j2312600381 -> j877350583;
	j1018738462 [label="Он специализировался на кристаллографии. И его труды были сохранены здесь, в лабораториях.",shape=box,color=red];
		j1018738462 -> j2027768084;
	j2710153948 [label="Тогда мне жаль, что я потратила еще больше времени.",shape=box,color=blue];
		j2710153948 -> j3007723528;
	j877350583 [label="+5 Chemistry",color=orange];
		j877350583 -> j1083131065;
	j2027768084 [label="По какой-то причине, я не знаю, его превратили в Цефалона и дали ему собственную некралоидную оболочку.",shape=box,color=red];
		j2027768084 -> j4253068678;
	j3007723528 [label="Boolean MarieOtakComplete is now true.",color=orange];
		j3007723528 -> "Chat ends.";
	j1083131065 [label="Я подозревала... Ну, он спросил меня, откуда я, и когда я ему рассказала, он рассмеялся и сказал: «Нет, это невозможно! А я-то знаю, я -»",shape=box,color=blue];
		j1083131065 -> j4208166086;
	j4253068678 [label="Не все Цефалоны были созданы в наказание. Но здесь, на Деймосе, дела пошли... плохо, и он был серьёзно повреждён.",shape=box,color=red];
		j4253068678 -> j2105349457;
	j4208166086 [label="А потом он… снова представился мне. И спросил, не с равнин ли я привезла образцы минералов...",shape=box,color=blue];
		j4208166086 -> j3240907016;
		j4208166086 -> j1559402234;
	j2105349457 [label="Pauvre petit...",shape=box,color=blue];
		j2105349457 -> j253530729;
	j3240907016 [label="Да... это Отак.",shape=box,color=red];
		j3240907016 -> j2493711906;
	j1559402234 [label="Ой, Мари. Мне так жаль...",shape=box,color=red];
		j1559402234 -> j2493711906;
	j253530729 [label="Boolean MarieOtak1 is now true.",color=orange];
		j253530729 -> j1336338782;
		j253530729 -> j2168146470;
	j2493711906 [label="Меня разбивает на миллион осколков мысль о том, что для него ничего нельзя сделать.",shape=box,color=blue];
		j2493711906 -> j457335464;
	j457335464 [label="Evaluate expressions",color=orange];
		j457335464 -> j1881983361 [label="MarieCephalonSoul",color=purple];
		j457335464 -> j4185072693 [label="MarieCephalonNoSoul",color=purple];
		j457335464 -> j905839708 [label="MarieCephalonUnsure",color=purple];
		j457335464 -> j2123025035 [label="false",color=purple];
	j1881983361 [label="О, Светила, что же ты для него устроил, чтобы держать его душу в ловушке этой клетки науки и мерцающих огней?",shape=box,color=blue];
		j1881983361 -> j4097517473;
	j4185072693 [label="Я могу только молиться Светилам, чтобы ты был прав, и внутри этой оболочки не осталось ничего, кроме... только науки и мерцающих огней.",shape=box,color=blue];
		j4185072693 -> j3068448448;
	j905839708 [label="Я знаю, ты не знаешь, есть ли у Цефалонов души, но я могу только молиться Светилам, чтобы... этот бедный Отак не страдал.",shape=box,color=blue];
		j905839708 -> j3913443648;
	j2123025035 [label="Я могу только молиться Светилам, чтобы внутри этой оболочки остались только... наука и мерцающие огни.",shape=box,color=blue];
		j2123025035 -> j2329740112;
	j4097517473 [label="Зачем оставлять его там, сломленного и ждущего, пока ему позволят умереть и обрести покой? Я могу только молиться... что если там есть хоть какое-то присутствие -",shape=box,color=blue];
		j4097517473 -> j3407132689;
	j3068448448 [label="И ни одна душа не заперта в этом сломанном существе, ожидая, пока ей наконец позволят умереть, чтобы обрести покой.",shape=box,color=blue];
		j3068448448 -> j2769278846;
	j3913443648 [label="Что ни одна душа не заперта в этом сломанном существе, ожидая, пока ей наконец позволят умереть, чтобы обрести покой.",shape=box,color=blue];
		j3913443648 -> j2267339661;
	j2329740112 [label="И ни одна душа не заперта в этом сломанном существе, ожидая, пока ей наконец позволят умереть, чтобы обрести покой.",shape=box,color=blue];
		j2329740112 -> j2267339661;
	j3407132689 [label="Потому что он по собственному выбору остается своего рода одиноким дозором...",shape=box,color=blue];
		j3407132689 -> j1280892260;
	j2769278846 [label="А что если ты ошибаешься, и душа остаётся в этой клетке против своей воли?",shape=box,color=blue];
		j2769278846 -> j1457517650;
	j2267339661 [label="Или, если там и есть какое-то присутствие, то это потому, что он остается там по своему выбору, в форме одинокого дозора.",shape=box,color=blue];
		j2267339661 -> j1280892260;
	j1280892260 [label="Думать иначе — значит усомниться в доброте богов, non?",shape=box,color=blue];
		j1280892260 -> j3769039066;
	j1457517650 [label="Достаточно лишь усомниться в доброте богов, non?",shape=box,color=blue];
		j1457517650 -> j3769039066;
	j3769039066 [label="И где бы я тогда была?",shape=box,color=blue];
		j3769039066 -> j3804864696;
	j3804864696 [label="Простите меня, я... Я сегодня в печали. ",shape=box,color=blue];
		j3804864696 -> j3251038745;
	j3251038745 [label="Evaluate expressions",color=orange];
		j3251038745 -> j4021675711 [label="MarieRoathePastry1",color=purple];
		j3251038745 -> j1712243944 [label="MarieRoathePastry1",color=purple];
		j3251038745 -> j3855982153 [label="MarieRoathePastry1",color=purple];
		j3251038745 -> j4263915490 [label="MarieRoathePastry1",color=purple];
		j3251038745 -> j4021675711 [label="RoatheMariePastry1",color=purple];
		j3251038745 -> j1712243944 [label="RoatheMariePastry1",color=purple];
		j3251038745 -> j3855982153 [label="RoatheMariePastry1",color=purple];
		j3251038745 -> j4263915490 [label="RoatheMariePastry1",color=purple];
		j3251038745 -> j4021675711 [label="false",color=purple];
		j3251038745 -> j1712243944 [label="false",color=purple];
		j3251038745 -> j4263915490 [label="false",color=purple];
	j4021675711 [label="Всё в порядке. У тебя есть на это полное право.",shape=box,color=red];
		j4021675711 -> j111946564;
	j1712243944 [label="Могу я чем-нибудь тебя подбодрить? Можем пойти поиздеваться над Роутом.",shape=box,color=red];
		j1712243944 -> j3595061476;
	j3855982153 [label="Могу я чем-нибудь тебя подбодрить? Может, украсть немного выпечки?",shape=box,color=red];
		j3855982153 -> j3818422622;
	j4263915490 [label="Иногда боги бывают жестоки, Мари. Такова жизнь.",shape=box,color=red];
		j4263915490 -> j3960997310;
	j111946564 [label="+20 Chemistry",color=orange];
		j111946564 -> j3551538987;
	j3595061476 [label="+15 Chemistry",color=orange];
		j3595061476 -> j3919006069;
	j3818422622 [label="+20 Chemistry",color=orange];
		j3818422622 -> j3919006069;
	j3960997310 [label="+5 Chemistry",color=orange];
		j3960997310 -> j1824569516;
	j3551538987 [label="Merci. Ну, больше не хочу. Пойду займусь чем-нибудь более весёлым! Кажется, аквариум M'sieur Фибоначчи пора прочистить.",shape=box,color=blue];
		j3551538987 -> j2486340526;
	j3919006069 [label="Ха! Merci. Это точно остановит мои глупые слезы. Ты ведь умеешь подбодрить глупенькую Мари, non?",shape=box,color=blue];
		j3919006069 -> j356853658;
		j3919006069 -> j4053231125;
	j1824569516 [label="Да. Это так. Так оно и есть. Мир полон историй, подобных истории господина Отака, и много историй гораздо хуже. Я бы не стала плакать ни над одной из них. ",shape=box,color=blue];
		j1824569516 -> j4168050748;
	j2486340526 [label="Check boolean MarieDating",color=orange];
		j2486340526 -> j731108299 [label=true,color=green];
		j2486340526 -> j3132378552 [label=false,color=brown];
	j356853658 [label="Это самое малое, что я могу для тебя сделать.",shape=box,color=red];
		j356853658 -> j1350233930;
	j4053231125 [label="Ты совсем не глупишь. Я чувствую то же самое.",shape=box,color=red];
		j4053231125 -> j1350233930;
	j4168050748 [label="И вот я сижу и делаю именно это. Спасибо, что напомнили мне о моей глупости. Fie! Глупенькая Мари. Ну... Думаю, аквариум M'sieur Фибоначчи пора протереть от пыли.",shape=box,color=blue];
		j4168050748 -> j2486340526;
	j731108299 [label="À la revoyure, мой волк.",shape=box,color=blue];
		j731108299 -> j3007723528;
	j3132378552 [label="À la revoyure!",shape=box,color=blue];
		j3132378552 -> j3007723528;
	j1350233930 [label="+5 Chemistry",color=orange];
		j1350233930 -> j4058209286;
	j4058209286 [label="Check boolean MarieDating",color=orange];
		j4058209286 -> j1426956655 [label=true,color=green];
		j4058209286 -> j3871346983 [label=false,color=brown];
	j1426956655 [label="Merci, merci, merci, мой волк. Пошли тогда и пошалим. ",shape=box,color=blue];
		j1426956655 -> j3007723528;
	j3871346983 [label="Merci, merci, merci. Пошли тогда и пошалим.",shape=box,color=blue];
		j3871346983 -> j3007723528;
}