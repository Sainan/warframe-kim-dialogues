	2640 [label="Нет, ничего нового
Sólo las arañas
Они вернулись
В конце концов, они уйдут",shape=box,color=blue];
		2640 -> 2641;
	2641 [label="Иногда мне хотелось бы,
Чтобы это было простой задачкой
Тогда я бы смогла её решить, ¿sí?
Обсудила, встряхнула бы как следует jajaja",shape=box,color=blue];
		2641 -> 2642;
	2642 [label="Проблемы могут быть решены
У проблем есть ответы
Los sentimientos no se arreglan
Поверь мне, я пыталась",shape=box,color=blue];
		2642 -> 2643;
		2642 -> 2644;
	2643 [label="Но у тебя есть куча причин быть счастливой.",shape=box,color=red];
		2643 -> 2645;
	2644 [label="В Дувири я на собственном горьком опыте убедился, что «исправлять чувства» иногда является худшим выбором.",shape=box,color=red];
		2644 -> 2646;
	2645 [label="Ay, sí, это правда
И я знаю это
И я хотела бы иногда
Чтобы люди поняли эту часть меня
Я никогда не позволю этому проникнуть",shape=box,color=blue];
		2645 -> 2647;
	2646 [label="Síí...
Хотя иногда это заманчиво jajaja
Просто желаю, чтобы все это закончилось
Но ты рассказывал мне о том, что произойдёт
Когда всё это затихнет",shape=box,color=blue];
		2646 -> 2648;
	2647 [label="Я бы хотела быть другой
Но я та, кто я есть
И я отказался извиняться за это
Давным-давно",shape=box,color=blue];
		2647 -> 2649;
	2648 [label="Я бы никому этого не пожелала
Хорошо, может быть, Альбрехт
Pinche güey
Хотя его сердце уже достаточно холодно, чтобы вот так",shape=box,color=blue];
		2648 -> 2650;
		2648 -> 2651;
	2649 [label="Chat ends.",color=orange];
	2650 [label="Что мы могли бы такого сделать, чтобы отвлечь тебя? Или хочешь просто остаться?",shape=box,color=red];
		2650 -> 2652;
	2651 [label="Остаётся только надеяться, что он играет в долгую.",shape=box,color=red];
		2651 -> 2653;
	2652 [label="Эээх, хороший вопрос
Честно говоря, не уверена 
Было бы не плохо просто остаться 
Или, можем и выйти, устроить бойню
