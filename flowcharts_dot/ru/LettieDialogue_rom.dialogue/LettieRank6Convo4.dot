digraph {
	"LettieRank6Convo4 begins." [color=orange];
		"LettieRank6Convo4 begins." -> j1310452999;
		"LettieRank6Convo4 begins." -> j3496141565;
	j1310452999 [label="[Конец.]",shape=box,color=red];
		j1310452999 -> "Chat ends.";
	j3496141565 [label="Как ты держишься?",shape=box,color=red];
		j3496141565 -> j3271328994;
	"Chat ends." [color=orange];
	j3271328994 [label="Eh, así así\nОдин из таких дней\nПройдёт, как всегда",shape=box,color=blue];
		j3271328994 -> j2361580123;
		j3271328994 -> j2424691428;
	j2361580123 [label=":( Мне жаль это слышать.",shape=box,color=red];
		j2361580123 -> j3196224169;
	j2424691428 [label="Что-то происходит?",shape=box,color=red];
		j2424691428 -> j1186932811;
	j3196224169 [label="Sólo las arañas\nОни вернулись\nВ конце концов, они уйдут",shape=box,color=blue];
		j3196224169 -> j2630843464;
	j1186932811 [label="Нет, ничего нового\nSólo las arañas\nОни вернулись\nВ конце концов, они уйдут",shape=box,color=blue];
		j1186932811 -> j2630843464;
	j2630843464 [label="Иногда мне хотелось бы,\nЧтобы это было простой задачкой\nТогда я бы смогла её решить, ¿sí?\nОбсудила, встряхнула бы как следует jajaja",shape=box,color=blue];
		j2630843464 -> j774460968;
	j774460968 [label="Проблемы могут быть решены\nУ проблем есть ответы\nLos sentimientos no se arreglan\nПоверь мне, я пыталась",shape=box,color=blue];
		j774460968 -> j1794608101;
		j774460968 -> j2642101270;
	j1794608101 [label="Но у тебя есть куча причин быть счастливой.",shape=box,color=red];
		j1794608101 -> j1843038763;
	j2642101270 [label="В Дувири я на собственном горьком опыте убедился, что «исправлять чувства» иногда является худшим выбором.",shape=box,color=red];
		j2642101270 -> j2606766575;
	j1843038763 [label="Ay, sí, это правда\nИ я знаю это\nИ я хотела бы иногда\nЧтобы люди поняли эту часть меня\nЯ никогда не позволю этому проникнуть",shape=box,color=blue];
		j1843038763 -> j1609995682;
	j2606766575 [label="Síí...\nХотя иногда это заманчиво jajaja\nПросто желаю, чтобы все это закончилось\nНо ты рассказывал мне о том, что произойдёт\nКогда всё это затихнет",shape=box,color=blue];
		j2606766575 -> j652559958;
	j1609995682 [label="Я бы хотела быть другой\nНо я та, кто я есть\nИ я отказался извиняться за это\nДавным-давно",shape=box,color=blue];
		j1609995682 -> "Chat ends.";
	j652559958 [label="Я бы никому этого не пожелала\nХорошо, может быть, Альбрехт\nPinche güey\nХотя его сердце уже достаточно холодно, чтобы вот так",shape=box,color=blue];
		j652559958 -> j619195704;
		j652559958 -> j1148802230;
	j619195704 [label="Что мы могли бы такого сделать, чтобы отвлечь тебя? Или хочешь просто остаться?",shape=box,color=red];
		j619195704 -> j2976733973;
	j1148802230 [label="Остаётся только надеяться, что он играет в долгую.",shape=box,color=red];
		j1148802230 -> j507719540;
	j2976733973 [label="Эээх, хороший вопрос\nЧестно говоря, не уверена \nБыло бы не плохо просто остаться \nИли, можем и выйти, устроить бойню\n¿Te quedas?, ¿o vamos a matar cosas? \nАх, эти мучительные решения...",shape=box,color=blue];
		j2976733973 -> j1352820280;
		j2976733973 -> j3389035902;
	j507719540 [label="Единственное, на что я надеюсь, когда замешан этот cabrón\nЭто долгая поездка на лифте\nСо мной\nИ бейсбольной битой",shape=box,color=blue];
		j507719540 -> j98988268;
	j1352820280 [label="Я голосую за то, чтобы остаться.",shape=box,color=red];
		j1352820280 -> j4115664861;
	j3389035902 [label="Я голосую за кровавую вылазку.",shape=box,color=red];
		j3389035902 -> j3031365995;
	j98988268 [label="Вот такой образ и поднимает мне настроение\nJajaja",shape=box,color=blue];
		j98988268 -> j3819368348;
	j4115664861 [label="Хороший выбор\nСидеть в баре с МиВ\nМожет быть, перекинуться в картишки\nОтвлечёт меня от этого",shape=box,color=blue];
		j4115664861 -> j3819368348;
	j3031365995 [label="Jajaja хороший выбор\nУбрать боль из моих дум\nВбивая её в кого-нибудь другого",shape=box,color=blue];
		j3031365995 -> j3819368348;
	j3819368348 [label="Check boolean LettieDating",color=orange];
		j3819368348 -> j1587771096 [label=true,color=green];
		j3819368348 -> j3243804387 [label=false,color=brown];
	j1587771096 [label="Check boolean LettieReal",color=orange];
		j1587771096 -> j1355625237 [label=true,color=green];
		j1587771096 -> j4256533151 [label=false,color=brown];
	j3243804387 [label="Gracias, дружище",shape=box,color=blue];
		j3243804387 -> "Chat ends.";
	j1355625237 [label="Gracias, corazón",shape=box,color=blue];
		j1355625237 -> "Chat ends.";
	j4256533151 [label="Gracias, solecito",shape=box,color=blue];
		j4256533151 -> "Chat ends.";
}