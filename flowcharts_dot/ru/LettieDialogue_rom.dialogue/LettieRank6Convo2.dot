		2539 -> 2544;
	2540 [label="+5 Chemistry",color=orange];
		2540 -> 2545;
	2541 [label="Sool, Noong, Sahd, Seer, Zhwong, Hahf, Hesh, Zhee, Pahk, Now, Senn?",shape=box,color=blue];
		2541 -> 2546;
		2541 -> 2547;
	2542 [label="Estiércol, chorro, excremento...
Больше ничего не приходит в голову
Хотя точно знаю, что ещё какие-то есть",shape=box,color=blue];
		2542 -> 2548;
		2542 -> 2549;
	2543 [label="¡JAJAJAJAJA!
