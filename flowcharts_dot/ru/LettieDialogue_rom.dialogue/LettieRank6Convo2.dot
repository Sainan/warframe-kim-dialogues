		2553 -> 2556;
		2553 -> 2557;
	2554 [label="Jajaja на самом деле мы так не говорим
Довольно забавно
Мы бы сказали
¡Puta madre!",shape=box,color=blue];
		2554 -> 2558;
		2554 -> 2559;
	2555 [label="Нужно так: Sool, noong, zhwong, sahd, seer, hahf, hesh, zhee, pahk, now, senn. ",shape=box,color=red];
		2555 -> 2560;
	2556 [label="Конечно. У Остронцев есть парочка отменных. ",shape=box,color=red];
		2556 -> 2561;
		2556 -> 2562;
	2557 [label="Я не думаю, что тебе необходима помощь в этом вопросе. :P",shape=box,color=red];
		2557 -> 2563;
	2558 [label="А у меня не будет проблем, если я это скажу?",shape=box,color=red];
		2558 -> 2564;
	2559 [label="Что это значит?",shape=box,color=red];
		2559 -> 2565;
	2560 [label="Так что я думаю, что у тебя был только zhwong, который был не в том месте. ",shape=box,color=red];
		2560 -> 2566;
	2561 [label="«Suhn plah kuhn mermu kohng loch ruh!» означает «В рыболовных сетях твоей матери были дыры!»",shape=box,color=red];
		2561 -> 2567;
	2562 [label="«Vobi-da» означает «козлиное дерьмо».",shape=box,color=red];
		2562 -> 2568;
	2563 [label="Jaja
