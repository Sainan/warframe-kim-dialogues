	j3224298303 [label="Если это не взаимно, просто скажи мне, я выдержу.",shape=box,color=red];
		j3224298303 -> j2720179985;
	j2699652399 [label="Я до сих пор не понимаю, хорошее ли это «mierda» или плохое…",shape=box,color=red];
		j2699652399 -> j2019222025;
	j2627987937 [label="Мм \nСтоило догадаться \nИди играй с Куинси \nUn escuincle как он, кажется, больше твоего типа",shape=box,color=blue];
		j2627987937 -> "Chat ends.";
	j2720179985 [label="Check boolean LettieTrust1",color=orange];
		j2720179985 -> j675720518 [label=true,color=green];
		j2720179985 -> j1208720996 [label=false,color=brown];
	j2019222025 [label="Jajaja, это значит «дерьмо»\nНо нет, нет, это не плохой разговор\nПросто —",shape=box,color=blue];
		j2019222025 -> j2720179985;
	j675720518 [label="Check boolean LettieTrust2",color=orange];
		j675720518 -> j1042230360 [label=true,color=green];
		j675720518 -> j2336550535 [label=false,color=brown];
	j1208720996 [label="Слушай \nДоверие для меня — это очень сложная вещь \nЭто самое важное в отношениях \nИ если его предать, особенно в такой ситуации, это уже нельзя исправить",shape=box,color=blue];
		j1208720996 -> j416678767;
	j1042230360 [label="Ты знаешь, как трудно мне доверять людям \nИ как важно для меня доверие ¿no? \nНу... в отношениях это ещё важнее",shape=box,color=blue];
		j1042230360 -> j4269887957;
	j2336550535 [label="Ты знаешь, что доверие — это очень сложная вещь для меня \nИ это самое важное в отношениях \nПреданное доверие в такой ситуации невозможно восстановить",shape=box,color=blue];
		j2336550535 -> j170893038;
	j416678767 [label="Boolean LettieTrust1 is now true.",color=orange];
		j416678767 -> j170893038;
	j4269887957 [label="Потому что такие отношения, как я предпочитаю, часто бывают болезненными, solecito \nЕсли ты понимаешь, о чём я \nТолько настолько, насколько мы этого хотим \nИ только до той степени, до которой ты готова зайти \nПотому что такие вещи требуют доверия",shape=box,color=blue];
		j4269887957 -> j1064378688;
	j170893038 [label="Boolean LettieTrust2 is now true.",color=orange];
		j170893038 -> j4269887957;
	j1064378688 [label="А преданное доверие в таком деле \nневозможно восстановить \n¿Me explico?",shape=box,color=blue];
		j1064378688 -> j2446032281;
		j1064378688 -> j600406697;
		j1064378688 -> j14917845;
	j2446032281 [label="Я не говорю «нет», но можно спросить… почему тебе нравится боль?",shape=box,color=red];
		j2446032281 -> j1241650836;
	j600406697 [label="Только если мы сможем чередоваться время от времени...",shape=box,color=red];
		j600406697 -> j1815347909;
	j14917845 [label="Мне не очень нравится смешивать боль и удовольствие, извини.",shape=box,color=red];
		j14917845 -> j253101613;
	j1241650836 [label="Ммм, не знаю \nМожет быть, потому что это боль, которую я могу контролировать \nВ отличие от всей той боли, которую я не могу",shape=box,color=blue];
		j1241650836 -> j61866115;
	j1815347909 [label="Jajaja, конечно \nНо как только ты это заслужишь \nСначала мне нужно знать, что я могу тебе доверять \nИтак... что скажешь?",shape=box,color=blue];
		j1815347909 -> j1101957280;
	j253101613 [label="Ay, sÍ \nЭто не для всех.\nEntiendo, без проблем",shape=box,color=blue];
		j253101613 -> j2477665661;
	j61866115 [label="Или, может быть, это что-то интенсивное \nЧто-то острое, что пронзает всю остальную чушь \nС которой мне приходится разбираться каждый день \nЭто РЕАЛЬНО \nЯ могу углубиться в это \nЗаставить это звучать \nЧувствовать пульсацию",shape=box,color=blue];
		j61866115 -> j2912662015;
	j1101957280 [label="Хочешь совершить ужасную ошибку со мной?",shape=box,color=blue];
		j1101957280 -> j4235868226;
		j1101957280 -> j2114327343;
	j2477665661 [label="+10 Chemistry",color=orange];
		j2477665661 -> j1327158907;
	j2912662015 [label="И это ТРЕБУЕТ доверия \nБез него это не работает, solecito \nИтак... что скажешь?",shape=box,color=blue];
		j2912662015 -> j1101957280;
	j4235868226 [label="Да. На самом деле хочу. :) [Встречаться с Лэтти]",shape=box,color=red];
		j4235868226 -> j2356641165;
	j2114327343 [label="Мне нужно обдумать это. Извини.",shape=box,color=red];
		j2114327343 -> j2477665661;
