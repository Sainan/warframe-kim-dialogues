		j2129367046 -> "Chat ends.";
	j3234884360 [label="Ладно \nПриготовься, solecito \nЯ не буду жалеть тебя \nПотому что я видела, как ты сражаешься \nЯ знаю, что ты справишься",shape=box,color=blue];
