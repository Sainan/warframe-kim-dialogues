	"LettieRank6Convo9 begins." [color=orange];
		"LettieRank6Convo9 begins." -> j824797476;
	j824797476 [label="Эй\nА что это за странная тварь, с которой я вижу, как ты бегаешь?\nОна не выглядит нормальной",shape=box,color=blue];
		j824797476 -> j2748842916;
		j824797476 -> j2713757158;
	j2748842916 [label="Ты удивишься, насколько это не помогает уточнить.",shape=box,color=red];
		j2748842916 -> j2220210894;
	j2713757158 [label="Оно было из металла или живое?",shape=box,color=red];
		j2713757158 -> j2018199072;
	j2220210894 [label="Jajaja fair\nОк, у него были какие-то огромные странные штуки торчащие из головы",shape=box,color=blue];
		j2220210894 -> j1504014312;
		j2220210894 -> j2367349547;
		j2220210894 -> j3645571337;
		j2220210894 -> j210121513;
	j2018199072 [label="Живое... вроде бы\nМягкое, так что точно не из металла\nОгромные странные штуки торчали из головы",shape=box,color=blue];
		j2018199072 -> j1504014312;
		j2018199072 -> j2367349547;
		j2018199072 -> j3645571337;
		j2018199072 -> j210121513;
	j1504014312 [label="Без понятия. Может, ты видела, как за мной гнался заражённый.",shape=box,color=red];
		j1504014312 -> j4093388285;
	j2367349547 [label="Это не вульпафила, случайно? Она похожа на «лисичку» или на тощего «пса» с большими длинными ушами со светящимися штуками?",shape=box,color=red];
		j2367349547 -> j986402041;
	j3645571337 [label="Это не смита кават, случайно? Она похожа на Калимоса, но с большими заострёнными ушами?",shape=box,color=red];
		j3645571337 -> j3618104194;
	j210121513 [label="Это не придазит визирь, случайно? Она похожа на... здорового крепкого «пса» со светящимися штуками на голове? Огромными ушами, как у летучей мыши?",shape=box,color=red];
		j210121513 -> j4041337700;
	j4093388285 [label="No me gusta\nNo me gusta nadita",shape=box,color=blue];
		j4093388285 -> "Chat ends.";
	j986402041 [label="¡¡Sí!!\n¡¿Qué demonios es esa cosa?!",shape=box,color=blue];
		j986402041 -> j3525979811;
		j986402041 -> j1191199693;
		j986402041 -> j1546019931;
		j986402041 -> j648034374;
	j3618104194 [label="Эээх, нет\nНе совсем оно\nУ неё светились какие-то штуки на ушах",shape=box,color=blue];
		j3618104194 -> j469347651;
		j3618104194 -> j3508859663;
	j4041337700 [label="Эээх, нет, близко\nУши такие длинные и тонкие",shape=box,color=blue];
		j4041337700 -> j3525979811;
		j4041337700 -> j648034374;
