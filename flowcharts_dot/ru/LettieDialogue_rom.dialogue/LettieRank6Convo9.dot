		j4041337700 -> j1191199693;
	"Chat ends." [color=orange];
	j3525979811 [label="Ага... без понятия, прости.",shape=box,color=red];
		j3525979811 -> j4093388285;
	j1191199693 [label="Это моя пронырливая вульпафила. Они с Деймоса, заражённой планеты. Вне Деймоса таких редко увидишь. :) Они безобидны. Ну. Для тебя, по крайней мере.",shape=box,color=red];
		j1191199693 -> j2518730738;
	j1546019931 [label="Это моя серповидная вульпафила. Они с Деймоса, заражённой планеты. Вне Деймоса таких редко увидишь. :) Они безобидны. Ну. Для тебя, по крайней мере.",shape=box,color=red];
		j1546019931 -> j2518730738;
	j648034374 [label="Это моя панцирная вульпафила. Они с Деймоса, заражённой планеты. :) Они безобидны. Ну. Для тебя, по крайней мере.",shape=box,color=red];
		j648034374 -> j2518730738;
	j469347651 [label="Огромные пылающие уши летучей мыши?",shape=box,color=red];
		j469347651 -> j4041337700;
	j3508859663 [label="Длинные, тонкие пылающие уши?",shape=box,color=red];
		j3508859663 -> j986402041;
	j2518730738 [label="Bien...\nБольше заражённых...\nИменно то, что нам нужно..\nТолько держи это подальше от меня, ¿sí?",shape=box,color=blue];
		j2518730738 -> j3899864479;
		j2518730738 -> j2978907949;
	j3899864479 [label="Полностью приручено, клянусь.",shape=box,color=red];
		j3899864479 -> j3474221874;
	j2978907949 [label="Но это очаровательное заражённое животное, Лэтти. Ты знаешь, что тебе хочется его погладить.",shape=box,color=red];
		j2978907949 -> j3814525991;
	j3474221874 [label="Я уверена, что именно это они сказали о Техроте\nПрежде чем он съел их лица",shape=box,color=blue];
		j3474221874 -> "Chat ends.";
	j3814525991 [label="+5 Chemistry",color=orange];
