	2733 [label="Ага... без понятия, прости.",shape=box,color=red];
		2733 -> 2739;
	2734 [label="Это моя пронырливая вульпафила. Они с Деймоса, заражённой планеты. Вне Деймоса таких редко увидишь. :) Они безобидны. Ну. Для тебя, по крайней мере.",shape=box,color=red];
		2734 -> 2740;
	2735 [label="Это моя серповидная вульпафила. Они с Деймоса, заражённой планеты. Вне Деймоса таких редко увидишь. :) Они безобидны. Ну. Для тебя, по крайней мере.",shape=box,color=red];
		2735 -> 2740;
	2736 [label="Это моя панцирная вульпафила. Они с Деймоса, заражённой планеты. :) Они безобидны. Ну. Для тебя, по крайней мере.",shape=box,color=red];
