		2803 -> 2805;
	2804 [label="Я читерила
Элеонор меня предупредила
Jajaja она ужасная сплетница",shape=box,color=blue];
		2804 -> 2806;
	2805 [label="Но только не про гекс
Mi familia no, ¿por favor?
Мне придётся целую неделю тереться дезинфицирующими салфетками",shape=box,color=blue];
		2805 -> 2807;
	2806 [label="Трудно винить тебя, ты столько видишь
Столько путешествуешь
