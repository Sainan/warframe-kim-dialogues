	2787 [label="Update boolean LettieConsentComplete",color=orange];
		2787 -> 2789;
	2790 [label="Я хочу поговорить с тобой кое о чём и сначала убедиться, что ты в порядке.",shape=box,color=red];
		2790 -> 2791;
	2789 [label="Chat ends.",color=orange];
	2791 [label="Я не хочу, чтобы у тебя была мысль, что я лгу или как-то нечестно обращаюсь.",shape=box,color=red];
		2791 -> 2792;
		2791 -> 2793;
		2791 -> 2794;
	2792 [label="Пожалуйста, не причиняй мне боль.",shape=box,color=red];
		2792 -> 2795;
	2793 [label="Пожалуйста, не злись.",shape=box,color=red];
		2793 -> 2796;
	2794 [label="Надеюсь, ты понимаешь.",shape=box,color=red];
		2794 -> 2797;
	2795 [label="Jajajajaj
Мы уже говорили об этом
Я причиняю тебе боль только так, как тебе нравится
Ну и что ты там теперь несёшь",shape=box,color=blue];
		2795 -> 2798;
	2796 [label="¿Sí?
И на что мне тут злиться?",shape=box,color=blue];
		2796 -> 2798;
	2797 [label="¿Sí?
И что тут понимать?",shape=box,color=blue];
		2797 -> 2798;
	2798 [label="Я не хочу ставить тебя в ситуацию, в которой ты будешь чувствовать себя плохо. Я знаю, мы это раньше не обсуждали. Так что если ты скажешь нет, это нормально. Мне важно, чтобы это было ясно.",shape=box,color=red];
		2798 -> 2799;
	2799 [label="То, что есть между нами, важно для меня. Очень важно. И оно настоящее. Я не хочу, чтобы были какие-то сомнения.",shape=box,color=red];
		2799 -> 2800;
	2800 [label="Aah, entiendo...
Полагаю, я просто хочу знать
Ты правда о них заботишься, solecito?
¿Quiénes son?",shape=box,color=blue];
		2800 -> 2801;
		2800 -> 2802;
	2801 [label="Я забочусь о них. Но я тоже очень глубоко забочусь о тебе.",shape=box,color=red];
		2801 -> 2803;
	2802 [label="Мне нужно было догадаться, что вы быстро это поймете.",shape=box,color=red];
		2802 -> 2804;
	2803 [label="Ay, sí
Трудно винить тебя, ты столько видишь
Столько путешествуешь
