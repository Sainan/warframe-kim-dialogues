		j143195468 -> j114151457;
	j3702107533 [label="Boolean LettieConsentComplete is now true.",color=orange];
		j3702107533 -> "Chat ends.";
	j114151457 [label="Я хочу поговорить с тобой кое о чём и сначала убедиться, что ты в порядке.",shape=box,color=red];
		j114151457 -> j462007747;
	j462007747 [label="Я не хочу, чтобы у тебя была мысль, что я лгу или как-то нечестно обращаюсь.",shape=box,color=red];
		j462007747 -> j1587657213;
		j462007747 -> j4244824522;
		j462007747 -> j1453426233;
	j1587657213 [label="Пожалуйста, не причиняй мне боль.",shape=box,color=red];
		j1587657213 -> j2766939387;
	j4244824522 [label="Пожалуйста, не злись.",shape=box,color=red];
		j4244824522 -> j3486816965;
	j1453426233 [label="Надеюсь, ты понимаешь.",shape=box,color=red];
		j1453426233 -> j765824081;
	j2766939387 [label="Jajajajaj
Мы уже говорили об этом
Я причиняю тебе боль только так, как тебе нравится
Ну и что ты там теперь несёшь",shape=box,color=blue];
		j2766939387 -> j1234991741;
	j3486816965 [label="¿Sí?
И на что мне тут злиться?",shape=box,color=blue];
		j3486816965 -> j1234991741;
	j765824081 [label="¿Sí?
И что тут понимать?",shape=box,color=blue];
		j765824081 -> j1234991741;
	j1234991741 [label="Я не хочу ставить тебя в ситуацию, в которой ты будешь чувствовать себя плохо. Я знаю, мы это раньше не обсуждали. Так что если ты скажешь нет, это нормально. Мне важно, чтобы это было ясно.",shape=box,color=red];
		j1234991741 -> j104576281;
	j104576281 [label="То, что есть между нами, важно для меня. Очень важно. И оно настоящее. Я не хочу, чтобы были какие-то сомнения.",shape=box,color=red];
		j104576281 -> j3121732056;
	j3121732056 [label="Aah, entiendo...
Полагаю, я просто хочу знать
Ты правда о них заботишься, solecito?
¿Quiénes son?",shape=box,color=blue];
		j3121732056 -> j993315232;
		j3121732056 -> j1681457789;
	j993315232 [label="Я забочусь о них. Но я тоже очень глубоко забочусь о тебе.",shape=box,color=red];
		j993315232 -> j1545464616;
	j1681457789 [label="Мне нужно было догадаться, что вы быстро это поймете.",shape=box,color=red];
		j1681457789 -> j487206401;
	j1545464616 [label="Ay, sí
Трудно винить тебя, ты столько видишь
Столько путешествуешь
Мне это ок",shape=box,color=blue];
		j1545464616 -> j1291639897;
	j487206401 [label="Я читерила
Элеонор меня предупредила
Jajaja она ужасная сплетница",shape=box,color=blue];
		j487206401 -> j3885090588;
	j1291639897 [label="Но только не про гекс
Mi familia no, ¿por favor?
Мне придётся целую неделю тереться дезинфицирующими салфетками",shape=box,color=blue];
		j1291639897 -> j3035144147;
	j3885090588 [label="Трудно винить тебя, ты столько видишь
Столько путешествуешь
Меня это устраивает",shape=box,color=blue];
		j3885090588 -> j1291639897;
	j3035144147 [label="+20 Chemistry",color=orange];
		j3035144147 -> j2208341221;
	j2208341221 [label="Ты стала для меня очень важной, solecito
И если они принесут тебе счастье?
Значит, и мне принесут то же самое
Всё просто",shape=box,color=blue];
		j2208341221 -> j3556917619;
	j3556917619 [label="Oh
И найди способ привести их сюда когда-нибудь
Я хочу встретиться с ними",shape=box,color=blue];
		j3556917619 -> j2353177469;
		j3556917619 -> j3680221407;
