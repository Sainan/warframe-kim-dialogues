	"Chat ends." [color=orange];
	j2985555336 [label="Check boolean LettieConsentComplete",color=orange];
		j2985555336 -> "Chat ends." [label=true,color=green];
		j2985555336 -> j580753472 [label=false,color=brown];
		j2985555336 -> j237903766 [label=false,color=brown];
	j4172583155 [label="Check boolean LettiePolyamorySuccess",color=orange];
		j4172583155 -> j2985555336 [label=true,color=green];
		j4172583155 -> "Chat ends." [label=false,color=brown];
	j580753472 [label="Эй, Лэтти? Ты занята? [Спросить согласие нескольких партнёров.]",shape=box,color=red];
		j580753472 -> j143195468;
	j237903766 [label="[Конец.]",shape=box,color=red];
		j237903766 -> j3702107533;
	j143195468 [label="Всегда\nНо для тебя?\n¿Qué?",shape=box,color=blue];
		j143195468 -> j114151457;
	j3702107533 [label="Boolean LettieConsentComplete is now true.",color=orange];
		j3702107533 -> "Chat ends.";
	j114151457 [label="Я хочу поговорить с тобой кое о чём и сначала убедиться, что ты в порядке.",shape=box,color=red];
		j114151457 -> j462007747;
	j462007747 [label="Я не хочу, чтобы у тебя была мысль, что я лгу или как-то нечестно обращаюсь.",shape=box,color=red];
		j462007747 -> j546529331;
		j462007747 -> j4034404260;
		j462007747 -> j3063495031;
	j546529331 [label="Пожалуйста, не причиняй мне боль.",shape=box,color=red];
		j546529331 -> j366324885;
	j4034404260 [label="Пожалуйста, не злись.",shape=box,color=red];
		j4034404260 -> j2168011545;
	j3063495031 [label="Надеюсь, ты понимаешь.",shape=box,color=red];
		j3063495031 -> j1583650449;
	j366324885 [label="Jajajajaj\nМы уже говорили об этом\nЯ причиняю тебе боль только так, как тебе нравится\nНу и что ты там теперь несёшь",shape=box,color=blue];
		j366324885 -> j965710403;
	j2168011545 [label="¿Sí?\nИ на что мне тут злиться?",shape=box,color=blue];
		j2168011545 -> j965710403;
	j1583650449 [label="¿Sí?\nИ что тут понимать?",shape=box,color=blue];
		j1583650449 -> j965710403;
	j965710403 [label="Я не хочу ставить тебя в ситуацию, в которой ты будешь чувствовать себя плохо. Я знаю, мы это раньше не обсуждали. Так что если ты скажешь нет, это нормально. Мне важно, чтобы это было ясно.",shape=box,color=red];
		j965710403 -> j2598368456;
	j2598368456 [label="То, что есть между нами, важно для меня. Очень важно. И оно настоящее. Я не хочу, чтобы были какие-то сомнения.",shape=box,color=red];
		j2598368456 -> j1980514323;
	j1980514323 [label="Ах, entiendo…\nТы же знаешь, я не всегда так поступаю\nНаверное, я просто хочу знать…\nЭтот человек тебе и правда не безразличен, solecito?\n¿Quiénes son?\nНеужели он так дорог тебе?",shape=box,color=blue];
		j1980514323 -> j3033813937;
		j1980514323 -> j314575960;
	j3033813937 [label="Я забочусь о них. Но я тоже очень глубоко забочусь о тебе.",shape=box,color=red];
		j3033813937 -> j1484347643;
	j314575960 [label="Мне нужно было догадаться, что вы быстро это поймете.",shape=box,color=red];
		j314575960 -> j3117713032;
	j1484347643 [label="Ay, sí\nТрудно винить тебя, ты столько видишь\nСтолько путешествуешь\nТолько не проси меня присоединиться\nВ остальном - я в порядке",shape=box,color=blue];
		j1484347643 -> j1291639897;
	j3117713032 [label="Я читерила\nЭлеонор меня предупредила\nJajaja она ужасная сплетница",shape=box,color=blue];
		j3117713032 -> j1116359112;
	j1291639897 [label="Но только не про гекс\nMi familia no, ¿por favor?\nМне придётся целую неделю тереться дезинфицирующими салфетками",shape=box,color=blue];
		j1291639897 -> j3035144147;
	j1116359112 [label="Трудно винить тебя, ты столько видишь\nСтолько путешествуешь\nТолько не проси меня присоединиться\nВ остальном - я в порядке",shape=box,color=blue];
		j1116359112 -> j1291639897;
	j3035144147 [label="+20 Chemistry",color=orange];
		j3035144147 -> j2208341221;
	j2208341221 [label="Ты стала для меня очень важной, solecito\nИ если они принесут тебе счастье?\nЗначит, и мне принесут то же самое\nВсё просто",shape=box,color=blue];
		j2208341221 -> j3556917619;
	j3556917619 [label="Oh\nИ найди способ привести их сюда когда-нибудь\nЯ хочу встретиться с ними",shape=box,color=blue];
		j3556917619 -> j2353177469;
		j3556917619 -> j3680221407;
	j2353177469 [label="Да, мадам. :)",shape=box,color=red];
		j2353177469 -> j3702107533;
	j3680221407 [label="Посмотрю, что смогу сделать.",shape=box,color=red];
		j3680221407 -> j3702107533;
}