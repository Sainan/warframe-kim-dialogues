		j2548450594 -> j4086907321;
	j3223573379 [label="И я доверяю тебе, mi corazón\nМы будем двигаться медленно, шаг за шагом\nИ если ты передумаешь, всё нормально\nМы найдём другие способы повеселиться\nДля меня чрезвычайно важно, что ты доверяешь мне и хочешь попробовать",shape=box,color=blue];
