		j2664122190 -> j1425515783;
		j2664122190 -> j4240423632;
		j2664122190 -> j1471958521;
	j2636141519 [label="Ayyy ты милашка, но иногда babas\nТебе нужно, чтобы я всё разжевала?\nИногда мне нравится, когда больно\nМне нравится, когда это заходит слишком далеко для большинства людей\nИ я знаю, что тебе это не нравится, и это нормально\nLa vida es compromiso, мы можем найти способы работать вместе",shape=box,color=blue];
		j2636141519 -> j4256776741;
		j2636141519 -> j22720954;
		j2636141519 -> j1586756090;
		j2636141519 -> j1781243632;
	j3138028415 [label="Ayyy, ты милашка, но иногда babas\nТебе нужно, чтобы я всё разжевала?\nИногда мне нравится, когда больно\nМне нравится, когда это заходит слишком далеко для большинства людей\nИ мне нужно быть уверенной, что тебе это подходит\nВ любом случае, мне просто нужно знать",shape=box,color=blue];
		j3138028415 -> j1781243632;
