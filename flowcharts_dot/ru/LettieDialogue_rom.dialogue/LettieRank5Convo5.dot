		j3138028415 -> j1471958521;
	j4256776741 [label="Прости, Лэтти... Значит ли это, что нам нужно расстаться?",shape=box,color=red];
		j4256776741 -> j786922791;
	j22720954 [label="Ну… когда мне пришлось сказать это, у меня… возможно, не было такого сильного доверия к тебе, как сейчас. А что если я соглашусь попробовать?",shape=box,color=red];
		j22720954 -> j2951668627;
	j1586756090 [label="Могу я спросить, *почему* тебе нравится такая боль?",shape=box,color=red];
		j1586756090 -> j3232830818;
	j1781243632 [label="Я не могу этого сделать. Прости. [Разорвать отношения]",shape=box,color=red];
		j1781243632 -> j355381327;
	j1425515783 [label="Просто, чтобы уточнить, кто причиняет боль, а кто её получает в этой ситуации?",shape=box,color=red];
		j1425515783 -> j1605761785;
	j4240423632 [label="Я доверяю тебе. Я готова попробовать.",shape=box,color=red];
		j4240423632 -> j959901069;
	j1471958521 [label="Не знаю, подходит ли мне боль, Лэтти... Значит ли это, что нам нужно расстаться?",shape=box,color=red];
		j1471958521 -> j786922791;
	j786922791 [label="Nonono, solecito\nЭто не значит, что нужно расставаться\nЕсть другие вещи, которые мы можем делать, другие грани, которые можно исследовать, без боли, если ты мне доверяешь\nТы доверяешь?",shape=box,color=blue];
		j786922791 -> j237005299;
		j786922791 -> j3503357912;
	j2951668627 [label="Aay solecito...\nДля меня многое значит, что ты не против попробовать\nЕсли твоя уверенность СИЛЬНА\nПотому что мы можем найти другие грани для исследования без боли, если ты мне доверяешь",shape=box,color=blue];
		j2951668627 -> j356442504;
		j2951668627 -> j2816996658;
	j3232830818 [label="Мм.\nТрудно сказать, почему\nМожет, потому что в моей жизни есть столько боли, которую я не могу контролировать\nМне нравится боль, которую я могу контролировать\nЕсли это имеет смысл",shape=box,color=blue];
		j3232830818 -> j341722211;
		j3232830818 -> j3194930582;
		j3232830818 -> j3322999369;
	j355381327 [label="Mm, sí\nЕщё одна ошибка в моём списке\nNo hay problema\nРада, что мы выяснили это сейчас",shape=box,color=blue];
		j355381327 -> j2548450594;
	j1605761785 [label="JAJAJA\nЭто зависит от того\nТы хорошо себя ведёшь, как милашка babas или нет\nИ могу ли я тебе доверять...\nВопрос в том, доверяешь ли ты мне достаточно, чтобы попробовать?",shape=box,color=blue];
		j1605761785 -> j356442504;
		j1605761785 -> j3503357912;
	j959901069 [label="+20 Chemistry",color=orange];
