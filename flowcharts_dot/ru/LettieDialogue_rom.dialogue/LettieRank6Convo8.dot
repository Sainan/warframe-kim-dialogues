digraph {
	"LettieRank6Convo8 begins." [color=orange];
		"LettieRank6Convo8 begins." -> j372621289;
	j372621289 [label="До меня дошло, что там было с Кайей\nЧто какая-то мелкая comadreja de mierda с ней сотворила",shape=box,color=blue];
		j372621289 -> j1642272781;
		j372621289 -> j2674735906;
	j1642272781 [label="Ух ох.",shape=box,color=red];
		j1642272781 -> j2939377062;
	j2674735906 [label="Да...",shape=box,color=red];
		j2674735906 -> j2939377062;
	j2939377062 [label="Я не знаю как\nЯ не знаю, возможно ли это вообще\nНо ты нарушаешь законы времени и пространства",shape=box,color=blue];
		j2939377062 -> j944710492;
	j944710492 [label="Я хочу найти его\nИ я хочу притащить его сюда\nИ я хочу посадить его прямо перед всеми нами",shape=box,color=blue];
		j944710492 -> j1165300826;
		j944710492 -> j1934406263;
	j1165300826 [label="И что потом?",shape=box,color=red];
		j1165300826 -> j1342708872;
	j1934406263 [label="Мы не можем причинить вред какому-то случайному подростку.",shape=box,color=red];
		j1934406263 -> j1036072810;
	j1342708872 [label="Я хочу, чтобы он почувствовал, каково это, когда страшно, и весь мир против тебя\nКогда все смеются над ним\nНасмехается над ним",shape=box,color=blue];
		j1342708872 -> j1843894271;
	j1036072810 [label="Кто сказал, что это вообще был план\nЯ знаю таких\nТрусы, все они, извергают свои слова из того места, где, по их мнению безопасно",shape=box,color=blue];
		j1036072810 -> j1342708872;
	j1843894271 [label="Ты представляешь, каково это было расти похожим на меня?\nГоворить как я?\nОдеваться как я?\nВ окружении детей на военных базах, которые были не такими?",shape=box,color=blue];
		j1843894271 -> j135339333;
	j135339333 [label="Большую часть времени я приходила домой избитая, потому что умела постоять за себя\nMi mamá всегда цыкала на меня и говорила, что мне следовало вести себя сдержанно\n¿Quedarme callada?\nДа ни за что",shape=box,color=blue];
		j135339333 -> j580547789;
	j580547789 [label="Check boolean KayaFutureWin2",color=orange];
		j580547789 -> j4196518764 [label=true,color=green];
		j580547789 -> j2482057532 [label=false,color=brown];
	j4196518764 [label="Я не виню её за желание сбежать\nЕсли бы я могла, я бы это сделала\nНо\nЗамечаешь, она ведь не уходит насовсем?",shape=box,color=blue];
		j4196518764 -> j2375655136;
		j4196518764 -> j1246387475;
	j2482057532 [label="Я не виню её за желание сбежать\nЕсли бы я могла, я бы это сделала\nКогда она станет старше, это пройдет",shape=box,color=blue];
		j2482057532 -> j2939175681;
		j2482057532 -> j3176854542;
	j2375655136 [label="Нет?",shape=box,color=red];
		j2375655136 -> j4267466141;
	j1246387475 [label="Ну, только она и может разобраться с Временной Архимедией.",shape=box,color=red];
		j1246387475 -> j3372990401;
	j2939175681 [label="Мне жаль, что я не смог ей в этом помочь.",shape=box,color=red];
		j2939175681 -> j545429648;
	j3176854542 [label="Это то, с чем ты можешь ей помочь?",shape=box,color=red];
		j3176854542 -> j545429648;
	j4267466141 [label="JAJAJA непомни мне никогда не добавлять тебя на случай экстренного контакта\nSííí, она временами пропадает, но возвращается сюда\nИз-за этой своей Временной Архичего-то\nНо, я думаю... и из-за нас тоже",shape=box,color=blue];
		j4267466141 -> j528407241;
	j3372990401 [label="Sííí, Временной Архичего-то\nНо, я думаю... и из-за нас тоже",shape=box,color=blue];
		j3372990401 -> j528407241;
	j545429648 [label="Иногда нужно просто время\nНо я постараюсь помочь ей, если смогу\nЛуа знает, насколько она увлечена медицинской наукой jajaja\nElla siempre hace preguntas espeluznantes",shape=box,color=blue];
		j545429648 -> j883543959;
	j528407241 [label="Мне нравится, когда она рядом\nЯ думаю, она это знает\nЕй нравится помогать мне на операциях, хотя...\nElla siempre hace preguntas espeluznante",shape=box,color=blue];
		j528407241 -> j1604290178;
	j883543959 [label="Не помогает и то, что она телепортируется\nМне нравится смотреть, как она пугает Амира\nШустрый ублюдок заслуживает этого, он делает то же самое с нами достаточно JAJAJAJA",shape=box,color=blue];
		j883543959 -> "Chat ends.";
	j1604290178 [label="Не помогает и то, что она телепортируется\nМне нравится смотреть, как она пугает Амира\nШустрый ублюдок заслуживает этого, он делает то же самое с нами достаточно JAJAJAJA\nНадеюсь, она никогда не уйдет навсегда",shape=box,color=blue];
		j1604290178 -> "Chat ends.";
	"Chat ends." [color=orange];
