		j3333294518 -> j1696737829;
	j2063405610 [label="Оглянись. Посмотри, что у ТЕБЯ есть. На семью вокруг тебя. На людей, которым не всё равно на ТЕБЯ.",shape=box,color=red];
		j2063405610 -> j1590731585;
