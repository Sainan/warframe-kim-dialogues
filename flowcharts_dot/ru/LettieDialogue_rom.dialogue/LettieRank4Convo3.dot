digraph {
	graph [fontname="Roboto Condensed"];
	node [fontname="Roboto Condensed"];
	edge [fontname="Roboto Condensed"];

	"LettieRank4Convo3 begins." [color=orange];
		"LettieRank4Convo3 begins." -> j2341955853;
		"LettieRank4Convo3 begins." -> j157618355;
	j2341955853 [label="Для кого-то, чья работа — предотвращать смерть, ты, кажется, довольно спокойно к ней относишься.",shape=box,color=red];
		j2341955853 -> j2998012832;
	j157618355 [label="Мне было бы интересно узнать, как ты стала медиком.",shape=box,color=red];
		j157618355 -> j4278065424;
	j2998012832 [label="Мм, sí, полагаю, так оно и есть \nПо двум причинам \nUno, я вижу La Flaca всё время в своей работе \nМы с ней старые «друзья» \nDos, мой народ, думаю, иначе смотрит на смерть",shape=box,color=blue];
		j2998012832 -> j3899454361;
		j2998012832 -> j3411803358;
		j2998012832 -> j3779377062;
	j4278065424 [label="Jaja, как я стала медиком — это легко, babas \nЯ пошла на службу и была плоха в этом \nПотом стала хороша",shape=box,color=blue];
		j4278065424 -> j3952484625;
		j4278065424 -> j111184337;
	j3899454361 [label="Что ты имеешь в виду, когда говоришь, что твой народ иначе смотрит на смерть?",shape=box,color=red];
		j3899454361 -> j1224768997;
	j3411803358 [label="Почему ты стала медиком?",shape=box,color=red];
		j3411803358 -> j4053264587;
	j3779377062 [label="Понятно. [Завершить]",shape=box,color=red];
		j3779377062 -> "Chat ends.";
	j3952484625 [label="Ладно, *почему* ты в итоге стала медиком?",shape=box,color=red];
		j3952484625 -> j4053264587;
	j111184337 [label="Спасибо. Хорошая беседа. [Завершить]",shape=box,color=red];
		j111184337 -> "Chat ends.";
	j1224768997 [label="Мы чествуем наших любимых, которые возвращаются и навещают нас \nПриглашаем их вернуться, чтобы увидеть нас раз в год \nМы готовим наш pan de muerto, наши calaveritas de azúcar и высаживаем наши бархатцы, чтобы пригласить их домой",shape=box,color=blue];
		j1224768997 -> j3771788647;
		j1224768997 -> j2564160449;
	j4053264587 [label="Mi papá служил в армии\nМы много переезжали, с базы на базу\nНо когда mi tía заболела, она переехала к нам\nИ я научилась заботиться о ней до того, как она ушла",shape=box,color=blue];
		j4053264587 -> j2985861959;
	"Chat ends." [color=orange];
	j3771788647 [label="Люди, с которыми я сталкивалась среди мёртвых, были... ну, более... интенсивными, да.",shape=box,color=red];
		j3771788647 -> j3933227862;
	j2564160449 [label="Это красиво.",shape=box,color=red];
		j2564160449 -> j1734317179;
	j2985861959 [label="Boolean LettieAunt is now true.",color=orange];
		j2985861959 -> j128722431;
		j2985861959 -> j4156425825;
	j3933227862 [label="Мы сидим у их могил и рассказываем истории \nМы едим то, что приносим для них, с ними \nМы разговариваем с ними и смеёмся с ними \nМы не шепчем и не плачем, когда они приходят к нам ночью",shape=box,color=blue];
		j3933227862 -> j519105657;
	j1734317179 [label="+5 Chemistry",color=orange];
		j1734317179 -> j2319748819;
	j128722431 [label="О... мне жаль.",shape=box,color=red];
		j128722431 -> j195099276;
	j4156425825 [label="Сколько тебе было лет?",shape=box,color=red];
		j4156425825 -> j3473671259;
	j519105657 [label="Меня познакомили с La Flaca, когда я была маленькой \nMi papá служил в армии \nМы много переезжали, с базы на базу \nНо когда mi tía заболела, она переехала к нам \nИ я научилась заботиться о ней до того, как она ушла",shape=box,color=blue];
		j519105657 -> j284760100;
	j2319748819 [label="Gracias",shape=box,color=blue];
		j2319748819 -> j3933227862;
	j195099276 [label="Eh, está bien \nТак случается, ¿no? \nПроблемы с сердцем делали её всё более слабой \nЭто была хорошая тренировка для моего будущего и полезная помощь mi mamá",shape=box,color=blue];
		j195099276 -> j1296513871;
		j195099276 -> j1785817672;
		j195099276 -> j1060254967;
	j3473671259 [label="10? 11? \nMi mamá нуждалась в помощи \nМне не было тяжело \nХорошая практика для будущего, быть парой рук",shape=box,color=blue];
		j3473671259 -> j1296513871;
		j3473671259 -> j1785817672;
		j3473671259 -> j1060254967;
	j284760100 [label="Boolean LettieAunt is now true.",color=orange];
		j284760100 -> j1118164677;
	j1296513871 [label="Скучаешь по своей тёте?",shape=box,color=red];
		j1296513871 -> j9969332;
	j1785817672 [label="Я знаю, каково это, потерять семью в раннем возрасте.",shape=box,color=red];
		j1785817672 -> j3701774792;
	j1060254967 [label="Сколько тебе было лет, когда ты пошла в армию?",shape=box,color=red];
		j1060254967 -> j486635778;
	j1118164677 [label="Mi tía приходит ко мне каждый год, похлопывает меня по плечу и говорит: «Buen trabajo, amorcito, sigue así»\nИ это заставляет меня улыбаться, а не кричать и убегать от страха",shape=box,color=blue];
		j1118164677 -> j479666767;
	j9969332 [label="+5 Chemistry",color=orange];
		j9969332 -> j2731468669;
	j3701774792 [label="+5 Chemistry",color=orange];
		j3701774792 -> j719012074;
	j486635778 [label="+10 Chemistry",color=orange];
		j486635778 -> j2123561831;
	j479666767 [label="Boolean LettieDiasdeMuertos is now true.",color=orange];
		j479666767 -> j1944008774;
	j2731468669 [label="Нет\nЯ вижу её раз в год на фестивале мёртвых\n¡Mierda! Перед тем как ты спросишь, нет, это не то, что ты думаешь\nМы не выкапываем их, мы празднуем их души jajaja\nНу, некоторые так делают — но мы не делаем, зависит от того, откуда ты родом",shape=box,color=blue];
		j2731468669 -> j2050665948;
		j2731468669 -> j945924120;
	j719012074 [label="Sí, но я не скучаю по ним \nОни ушли из моего повседневного, но не ушли из моей души, они всё ещё навещают меня раз в год на фестивале мёртвых \nМы не выкапываем их, мы празднуем их души jajaja \nНу, некоторые так делают — но мы не делаем, зависит от того, откуда ты родом",shape=box,color=blue];
		j719012074 -> j2050665948;
		j719012074 -> j945924120;
	j2123561831 [label="Mi papá заставил меня подождать до 20, прежде чем я вступила\nНо я была готова уйти раньше jajaja\nПыжилась, хотела, чтобы он и mi tía гордились\nЯ рада, что он заставил меня подождать, я не была готова",shape=box,color=blue];
		j2123561831 -> j2175001459;
	j1944008774 [label="Надеюсь, она выйдет сюда…\nМне нужно будет сделать ей бумажные бархатцы\nМожет, Артур поможет мне сделать pan de muerto, я ужасный пекарь jajaja",shape=box,color=blue];
		j1944008774 -> j4183053060;
		j1944008774 -> j310370842;
	j2050665948 [label="Фух. Я собирался спросить. ха-ха",shape=box,color=red];
		j2050665948 -> j2327362804;
	j945924120 [label="ХА-ХА! Это звучит как крутой праздник, на самом деле.",shape=box,color=red];
		j945924120 -> j2327362804;
	j2175001459 [label="Наблюдать, как твоя тётя медленно умирает от сердечной недостаточности — это одно \nНаблюдать, как люди убивают друг друга жестоко \nКрики смерти, кровавые смерти \nЭто что-то другое",shape=box,color=blue];
		j2175001459 -> j1319363119;
	j4183053060 [label="Уверен, он с радостью поможет.",shape=box,color=red];
		j4183053060 -> j3018346605;
	j310370842 [label="Я бы тоже с радостью помог.",shape=box,color=red];
		j310370842 -> j4048331328;
	j2327362804 [label="Мы строим ofrendas для наших любимых, делаем pan de muerto, calaveritas de azúcar и выкладываем наши бархатцы, чтобы пригласить их домой \nМы едим то, что принесли для них, с ними \nМы сидим у их могил и рассказываем истории о них \nМы разговариваем с ними и смеёмся с ними",shape=box,color=blue];
		j2327362804 -> j1118164677;
	j1319363119 [label="Но ты это знаешь, не так ли? \nТы знаешь La Flaca так же хорошо, как и я \nГоворя о ней \nОна не ждёт никого, и уж точно не наших разговоров",shape=box,color=blue];
		j1319363119 -> "Chat ends.";
	j3018346605 [label="Check boolean LettieDuviri",color=orange];
		j3018346605 -> j1842643675 [label=true,color=green];
		j3018346605 -> j383403120 [label=false,color=brown];
	j4048331328 [label="+5 Chemistry",color=orange];
		j4048331328 -> j926648478;
	j1842643675 [label="Если хочешь, мы можем построить ofrenda для твоей семьи \nМожет, они придут увидеть своих babas после столь долгого времени \nЯ уверена, что они гордятся тобой",shape=box,color=blue];
		j1842643675 -> j958849681;
		j1842643675 -> j434895163;
		j1842643675 -> j2733172674;
	j383403120 [label="У тебя есть любимые люди, которых ты хочешь увидеть \nМы могли бы работать вместе и построить тебе ofrenda \nМожет, они придут увидеть своих babas после столь долгого времени, я уверена, что они гордятся тобой",shape=box,color=blue];
		j383403120 -> j958849681;
		j383403120 -> j434895163;
		j383403120 -> j2733172674;
	j926648478 [label="Ты милашка \nSí, может быть, мы сможем поработать вместе",shape=box,color=blue];
		j926648478 -> j3018346605;
	j958849681 [label="Мне... на самом деле очень хотелось бы этого. Спасибо, Лэтти.",shape=box,color=red];
		j958849681 -> j3403692974;
	j434895163 [label="Я с радостью помогу тебе, но давай оставим мою семью в будущем, где им и место.",shape=box,color=red];
		j434895163 -> j3824652590;
	j2733172674 [label="Эм... не думаю, что они захотят меня увидеть...",shape=box,color=red];
		j2733172674 -> j4115334670;
	j3403692974 [label="+10 Chemistry",color=orange];
		j3403692974 -> j4128892158;
	j3824652590 [label="+10 Chemistry",color=orange];
		j3824652590 -> j392357131;
	j4115334670 [label="Check boolean LettieReligion4",color=orange];
		j4115334670 -> j912937549 [label=true,color=green];
		j4115334670 -> j2194251521 [label=false,color=brown];
	j4128892158 [label="Claro, друг \nМм, теперь, когда я думаю \nМогут ли души путешествовать во времени? \nAy, equis, иногда важна сама мысль",shape=box,color=blue];
		j4128892158 -> "Chat ends.";
	j392357131 [label="Справедливо \nМм, теперь, когда я думаю \nМогут ли души путешествовать во времени? \nAy, equis, важна сама мысль",shape=box,color=blue];
		j392357131 -> "Chat ends.";
	j912937549 [label="Из-за того, что твой Xipe Totec заставил тебя сделать \nЭто была не твоя вина, они сошли с ума \nИногда необходимо прижечь рану \nТы остановил их, это было не убийство",shape=box,color=blue];
		j912937549 -> j3557772836;
		j912937549 -> j2905910971;
	j2194251521 [label="¿Por qué?",shape=box,color=blue];
		j2194251521 -> j2260677784;
		j2194251521 -> j4141331289;
	j3557772836 [label="Это не так чувствовалось.",shape=box,color=red];
		j3557772836 -> j3553414059;
	j2905910971 [label="Правда твоя...",shape=box,color=red];
		j2905910971 -> j3423161059;
	j2260677784 [label="Потому что, когда Человек в стене довёл родителей до безумия, они напали на детей, и... дети должны были убить их своими силами Бездны, и....",shape=box,color=red];
		j2260677784 -> j327118775;
	j4141331289 [label="Я не могу говорить об этом. Извини.",shape=box,color=red];
		j4141331289 -> j3013417649;
	j3553414059 [label="+10 Chemistry",color=orange];
		j3553414059 -> j486469450;
	j3423161059 [label="+10 Chemistry",color=orange];
		j3423161059 -> j86981582;
	j327118775 [label="Boolean LettieReligion4 is now true.",color=orange];
		j327118775 -> j2665771369;
	j3013417649 [label="Ay, sí, \nя понимаю",shape=box,color=blue];
		j3013417649 -> "Chat ends.";
	j486469450 [label="Sí, я не могу представить твои чувства\nкогда тебе пришлось так навредить собственной семье \nНо у тебя не было выбора, solecito \nЭто были разъярённые животные, вышедшие из-под контроля",shape=box,color=blue];
		j486469450 -> j1125487462;
	j86981582 [label="У тебя не было выбора, solecito \nОни были как бешеные животные и не контролировали себя \nИ вот такой выбор я *действительно* понимаю",shape=box,color=blue];
		j86981582 -> j123455067;
	j2665771369 [label="Это твой Xipe Totec это сделал, твой скальпированный бог \nИменно его действия свели их с ума и привели к их гибели",shape=box,color=blue];
		j2665771369 -> j3423161059;
	j1125487462 [label="И вот такой выбор я *действительно* понимаю \nНо это история на другой раз \nLa Flaca никого не ждёт, равно как и наших разговоров, а у меня есть пациенты",shape=box,color=blue];
		j1125487462 -> "Chat ends.";
	j123455067 [label="Но это история на другой раз \nLa Flaca никого не ждёт, равно как и наших разговоров, а у меня есть пациенты",shape=box,color=blue];
		j123455067 -> "Chat ends.";
