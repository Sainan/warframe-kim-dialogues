digraph {
	"LettieRank6Convo6 begins." [color=orange];
		"LettieRank6Convo6 begins." -> j1169797960;
	j1169797960 [label="Энтрати почти всё компенсируют\nОтправив нам Минерву\n*Почти*",shape=box,color=blue];
		j1169797960 -> j2573508453;
		j1169797960 -> j241707632;
	j2573508453 [label="Стоит ли мне беспокоиться?",shape=box,color=red];
		j2573508453 -> j3390971199;
	j241707632 [label="Мне думалось, что вы двое могли бы поладить, ХАХА.",shape=box,color=red];
		j241707632 -> j2636733233;
	j3390971199 [label="Jajaja нет\nНо всё же приятно, когда есть компания\nОсобенно она, которая умет за себя постоять\nСпокойнее, когда рядом кто-то, за кого не боишься, что придётся потом собирать по кускам",shape=box,color=blue];
		j3390971199 -> j1095583830;
	j2636733233 [label="JAJAJAJA\nТы сейчас на что намекаешь?!\nЭто приятно, когда есть компания\nОсобенно она, которая умет за себя постоять\nСпокойнее, когда рядом кто-то, за кого не боишься, что придётся потом собирать по кускам",shape=box,color=blue];
		j2636733233 -> j1095583830;
	j1095583830 [label="А Велимир заставляет меня улыбаться\nУважаю того, который чётко знает кто он есть\nAlguien auténtico y fiel a sí mismo, ¿sí?\nНа днях он позволил Аои накрасить ему ногти на ногах jajajaja\nИ при этом обсуждая любимые классические либертарианские маслкары\nЕму вообще плевать",shape=box,color=blue];
		j1095583830 -> j1379184160;
	j1379184160 [label="Не знаю, будет ли что-то ещё\nНо впервые за долгое время\nХочется, чтобы было",shape=box,color=blue];
		j1379184160 -> "Chat ends.";
	"Chat ends." [color=orange];
}