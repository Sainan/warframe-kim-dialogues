	"LettieRank4Convo1 begins." [color=orange];
		"LettieRank4Convo1 begins." -> j3545444017;
		"LettieRank4Convo1 begins." -> j338941979;
		"LettieRank4Convo1 begins." -> j943600600;
	j3545444017 [label="Ты никогда не рассказывала всю историю о том, как ты встретила Артура.",shape=box,color=red];
		j3545444017 -> j251696354;
	j338941979 [label="У тебя есть минута, чтобы поболтать, Лэтти? Или ты занята?",shape=box,color=red];
		j338941979 -> j1673205613;
	j943600600 [label="[Завершить]",shape=box,color=red];
		j943600600 -> "Chat ends.";
	j251696354 [label="Эх, это было запутанно \nДумала, тебе не нужны все кровавые подробности \nНо sí, если хочешь знать \nЯ расскажу тебе",shape=box,color=blue];
		j251696354 -> j486509491;
	j1673205613 [label="+5 Chemistry",color=orange];
		j1673205613 -> j4191887659;
	"Chat ends." [color=orange];
	j486509491 [label="Мы служили на одной базе \nОн — в Британии, а я — в армии Либертатии \nРазные страны, одни и те же враги",shape=box,color=blue];
		j486509491 -> j1560963592;
	j4191887659 [label="Всегда занята \nНо могу сделать перерыв \n¿Qué onda?",shape=box,color=blue];
		j4191887659 -> j1566093524;
	j1560963592 [label="Я была полевым медиком в моём полку \nМы были размещены рядом с его \nВсё превратилось в настоящий cagadero\nОчень быстро",shape=box,color=blue];
		j1560963592 -> j2999185485;
	j1566093524 [label="Мне было интересно, как ты и Артур познакомились.",shape=box,color=red];
		j1566093524 -> j251696354;
	j2999185485 [label="Большинство из моего экипажа не выжило \nБольшинство его тоже \nМы поддерживали друг друга \nБуквально \nЯ хорошо зашила его руку jaja \nКогда он ушел на пенсию и пошел в МСР \nЯ последовала за ним без вопросов \nМне уже надоела вся эта армейская драма",shape=box,color=blue];
		j2999185485 -> j3333393204;
	j3333393204 [label="Я сказала ему, что пойду за ним на край света \nНе думала, что последую за ним к границе Mictlán",shape=box,color=blue];
		j3333393204 -> j1119438411;
	j1119438411 [label="Это определённо покажется тебе таким тривиальным, не так ли? \nИстории, подобные этой \nТебе пришлось сражаться с чудовищами и богами \nТебе пришлось столько раз танцевать с этой La Flaca",shape=box,color=blue];
		j1119438411 -> j3207784194;
	j3207784194 [label="Boolean LettieArthur1 is now true.",color=orange];
		j3207784194 -> j3378020445;
		j3207784194 -> j3919786035;
		j3207784194 -> j468588890;
	j3378020445 [label="Просто потому, что мои битвы немного зрелищные, это не значит, что я не могу оценить, насколько это было ужасно.",shape=box,color=red];
		j3378020445 -> j2170819620;
	j3919786035 [label="Любая война — дерьмо, и точка.",shape=box,color=red];
		j3919786035 -> j715920807;
	j468588890 [label="Эх, маленькие люди, маленькие истории.",shape=box,color=red];
		j468588890 -> j4124326144;
	j2170819620 [label="+10 Chemistry",color=orange];
		j2170819620 -> j1468777374;
	j715920807 [label="+15 Chemistry",color=orange];
		j715920807 -> j3751398329;
	j4124326144 [label="Seguro",shape=box,color=blue];
		j4124326144 -> j2703113057;
	j1468777374 [label="Ay, sí \nЯркое и блестящее или маленькое и личное \nLa Flaca в конце концов всегда одинакова \nПо крайней мере… так должно быть \nНо не для los fantasmas",shape=box,color=blue];
		j1468777374 -> "Chat ends.";
	j3751398329 [label="Sí, всё одно и то же \nНеважно, насколько большие и глупые пушки",shape=box,color=blue];
		j3751398329 -> "Chat ends.";
	j2703113057 [label="Boolean LettieNoDate is now true.",color=orange];
		j2703113057 -> "Chat ends.";
}