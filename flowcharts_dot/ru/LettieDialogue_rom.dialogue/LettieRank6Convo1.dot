	j2520769829 [label="Ого, спасибо.",shape=box,color=red];
		j2520769829 -> j1854546331;
	j3278531486 [label="Я имею в виду... ну да, но...",shape=box,color=red];
		j3278531486 -> j1854546331;
	j1854546331 [label="Потом всё стало только хуже \nОт дерьма к ещё большему дерьму \nКогда кошмар становился всё мрачнее\nИ ЛЮБОЙ, у кого есть хотя бы половина мозга, убежал бы обратно в будущее",shape=box,color=blue];
		j1854546331 -> j492224433;
	j492224433 [label="Но ты не убегаешь \nТы остаёшься по какой-то глупой причине \nТы остаёшься с нами, борешься и помогаешь нам собраться заново",shape=box,color=blue];
		j492224433 -> j1244895268;
	j1244895268 [label="Ay, Луа, sálvame \nЯ до сих пор НЕ знаю, почему \nУ тебя не было причин оставаться ради незнакомцев",shape=box,color=blue];
