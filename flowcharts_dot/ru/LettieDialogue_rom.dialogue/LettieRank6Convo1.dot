		j2969545787 -> j4083288880 [label=false,color=brown];
	j3377334128 [label="Не привыкай к этому \nЯ всё ещё надеру тебе зад \nСуть в том, что я привыкла к тебе под ногами \nМне нравится, что ты рядом",shape=box,color=blue];
		j3377334128 -> j1059718737;
	j2226684218 [label="Boolean LettieDating is now false.",color=orange];
		j2226684218 -> j2703113057;
	j1218744686 [label="Не привыкай к этому, mi corazón \nЯ всё ещё надеру тебе зад \nAy, ну ладно...",shape=box,color=blue];
		j1218744686 -> j158816081;
	j4083288880 [label="Не привыкай к этому, solecito \nЯ всё ещё надеру тебе зад \nСуть в том, что я привыкла к тебе под ногами \nМне нравится, что ты рядом",shape=box,color=blue];
		j4083288880 -> j4111743740;
	j1059718737 [label="Твоя дружба для меня очень ценна \nИ я полагаюсь на тебя так, как не полагаюсь ни на кого другого \nЯ доверяю тебе, а это то, что я не делаю легкомысленно",shape=box,color=blue];
		j1059718737 -> j2927885936;
	j2703113057 [label="Boolean LettieNoDate is now true.",color=orange];
		j2703113057 -> "Chat ends.";
	j158816081 [label="Te amo, mi corazón \nЯ люблю тебя, моё сердце",shape=box,color=blue];
		j158816081 -> j1059505259;
		j158816081 -> j3225111692;
	j4111743740 [label="Me importas mucho \nЯ сильно забочусь о тебе \nИ я полагаюсь на тебя так, как не полагаюсь ни на кого другого \nЯ доверяю тебе, а это то, что я не делаю легкомысленно",shape=box,color=blue];
		j4111743740 -> j4146950381;
	j2927885936 [label="За нас, мой друг \nИ за будущее \nНаполненное fantasmas, бесконечными мирами, богами и демонами, какими бы они ни были \nМы есть друг у друга \nИ этого вполне достаточно",shape=box,color=blue];
		j2927885936 -> "Chat ends.";
	j1059505259 [label="Я не чувствую этого так сильно, извини...",shape=box,color=red];
		j1059505259 -> j3592175983;
	j3225111692 [label="Я… я тоже тебя люблю, Лэтти. У меня не было надежды… Я свечусь от счастья.",shape=box,color=red];
		j3225111692 -> j4191985824;
	j4146950381 [label="За нас, solecito \nИ за будущее \nНаполненное fantasmas, бесконечными мирами, богами и демонами, какими бы они ни были \nМы есть друг у друга \nИ этого вполне достаточно",shape=box,color=blue];
		j4146950381 -> "Chat ends.";
	j3592175983 [label="Ay \nSí \nЛадно",shape=box,color=blue];
		j3592175983 -> j2357188720;
	j4191985824 [label="JAJAJA síí \nЯ знаю, что меня трудно понять \nAггх, я тоже так счастлива\nДавай отпразднуем это сегодня вечером, ¿мм?",shape=box,color=blue];
		j4191985824 -> j1622653669;
	j2357188720 [label="Вот почему я не доверяю людям, jajaja",shape=box,color=blue];
		j2357188720 -> j442422169;
	j1622653669 [label="Я не хочу, чтобы тебе приходилось спрашивать \nЯ не хочу, чтобы тебе приходилось быть МИЛАШКОЙ \nПокажи мне, чего ХОЧЕШЬ, ¿entendiste?",shape=box,color=blue];
		j1622653669 -> j4165829008;
		j1622653669 -> j4214187009;
	j442422169 [label="Всё нормально, такое бывает \nГлупая я, опять допускаю ошибки \nДля меня будет лучше, если мы не будем продолжать так дальше \nТы понимаешь",shape=box,color=blue];
		j442422169 -> j3606744485;
	j4165829008 [label="Да, мадам.",shape=box,color=red];
		j4165829008 -> j1082467052;
	j4214187009 [label="<RETRO_EMOJI_SNEAKY>",shape=box,color=red];
		j4214187009 -> j1082467052;
	j1082467052 [label="Вот это дух \nЗа нас, mi corazón \nИ за будущее \nНаполненное fantasmas, бесконечными мирами, богами и демонами, какими бы они ни были \nУ нас есть наша любовь \nИ этого более чем достаточно",shape=box,color=blue];
