		j2292833065 -> j472821285;
	j472821285 [label="С твоим появлением...\nЯ знала, что ты принесёшь проблемы \nНовая, невозможная проблема в нашу растущую кучу mierda, с которым надо разбираться",shape=box,color=blue];
