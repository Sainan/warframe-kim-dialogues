		1813 -> 1815 [label=false,color=brown];
	1814 [label="Мы не хотели верить 
Что наше доверие было предано 
Мы... мы тоже принимали это лекарство, solecito... 
Мы распространяли чуму...",shape=box,color=blue];
		1814 -> 1816;
	1815 [label="Мы не хотели верить 
Что наше доверие было предано 
Мы... мы тоже принимали это лекарство
Мы распространяли чуму...",shape=box,color=blue];
		1815 -> 1816;
	1816 [label="Так что, когда он сказал, что штамм Техрота мутировал... и мы больше не в безопасности...",shape=box,color=blue];
		1816 -> 1817;
	1817 [label="Мы выстроились в очередь 
Как хорошие маленькие soldaditos",shape=box,color=blue];
		1817 -> 1818;
	1818 [label="Луа, это было больно 
И это был не тот вид боли, что может нравиться... 
Крики Аои были худшими 
Я не могла ей помочь, я была слишком занята умиранием 
Она плакала от страха, а всё, чего я хотела, — это обнять её",shape=box,color=blue];
		1818 -> 1819;
	1819 [label="Скажи ей, что всё будет хорошо 
Что боль пройдет, и La Flaca заберёт её домой 
Она так боялась, а я не могла ей помочь 
Мои ноги просто не работали...",shape=box,color=blue];
		1819 -> 1820;
	1820 [label="И я буду ненавидеть эту сволочь 
Каждый день своей бесконечной жизни 
За это предательство",shape=box,color=blue];
		1820 -> 1821;
	1821 [label="И если я когда-нибудь увижу его снова? 
Лучше будь рядом, чтобы удержать меня 
Иначе я покажу ему, что такое настоящая боль",shape=box,color=blue];
		1821 -> 1822;
		1821 -> 1823;
		1821 -> 1824;
		1821 -> 1825;
	1822 [label="Держать обиду на кого-то — это нездорово, даже если то, что он сделал, было неправильно.",shape=box,color=red];
		1822 -> 1826;
	1823 [label="Чёрт возьми… У меня не было понимания этого. Мне так жаль, что он использовал вас вот так. Да… во мне он тоже вызвал бы только ненависть.",shape=box,color=red];
		1823 -> 1827;
	1824 [label="Я - так - подожди. Вы ведь частично виноваты в распространении Техрота?",shape=box,color=red];
		1824 -> 1828;
	1825 [label="Извини, на меня сон напал на секунду. О чём ты говорила?",shape=box,color=red];
		1825 -> 1829;
	1826 [label="Посмотри на себя 
Вся в духе San Babas 
Прощая грехи 
Нет 
Некоторые вещи нельзя простить 
То, что он сделал с нами, — одно из них 
То, что мы сделали с людьми в этом городе, — другое",shape=box,color=blue];
		1826 -> 1833;
		1826 -> 1834;
		1826 -> 1836;
	1827 [label="SÍ 
Я плохо переношу предательство 
Но мы хотели верить ему, и это сделало нас глупыми 
Если ты больше не хочешь быть рядом с нами, я пойму
Другие тоже поймут",shape=box,color=blue];
		1827 -> 1833;
		1827 -> 1834;
		1827 -> 1836;
	1828 [label="SÍ 
Мы были виноваты 
Но мы хотели верить ему, и это сделало нас глупыми 
Если ты больше не хочешь быть рядом с нами, я пойму 
Другие тоже поймут",shape=box,color=blue];
		1828 -> 1833;
		1828 -> 1834;
