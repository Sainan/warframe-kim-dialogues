	1829 [label="Update boolean LettieDating",color=orange];
		1829 -> 1830;
	1833 [label="Я здесь не для того, чтобы говорить, можно ли простить то, что вы сделали. Это не то, что могу решить я, и, честно говоря, я не думаю, что то, что ты описываешь, можно простить.",shape=box,color=red];
		1833 -> 1839;
	1834 [label="Энтрати пришёл сюда и нашёл именно то, что искал, — полезных, умелых людей, которых он мог обмануть, чтобы они делали то, что он хочет. Людей, которые не будут слишком много размышлять. Вы попались на его удочку, как многие до вас.",shape=box,color=red];
		1834 -> 1837;
	1836 [label="То, что произошло, не твоя вина. Тебя обманули. Да, возможно, ты была немного слепа после того, как всё начало идти наперекосяк. Но кто может тебя винить? Надежда — опасный наркотик. И он вколол тебе его.",shape=box,color=red];
		1836 -> 1838;
	1830 [label="Update boolean IsDating",color=orange];
		1830 -> 1831;
	1839 [label="Люди умерли. Люди, которые не вернутся. Потому что ты хотела верить в чудо-препарат, который предлагал какой-то «старик в уродливом плаще».",shape=box,color=red];
		1839 -> 1842;
	1837 [label="Ты хотела верить его лжи. И ты верила. Это на тебе. И все те, кто заболел из-за этого? Это тоже на тебе.",shape=box,color=red];
		1837 -> 1839;
		1837 -> 1840;
	1838 [label="Так что, конечно, ты пошла на это. Конечно, ты хотела верить, что есть шанс.",shape=box,color=red];
		1838 -> 1841;
	1831 [label="Update boolean LettieNoDate",color=orange];
		1831 -> 1832;
	1842 [label="Но это не моя задача — освободить вас от этого. Извини.",shape=box,color=red];
		1842 -> 1845;
	1840 [label="Но люди совершают ошибки. И люди признают их. И ты здесь, пытаешься это сделать. Так что... я вижу людей, которые пытаются сделать правильное, исправляя свои ошибки.",shape=box,color=red];
		1840 -> 1843;
	1841 [label="Думаю, мне бы пришлось поступить так же.",shape=box,color=red];
		1841 -> 1835;
