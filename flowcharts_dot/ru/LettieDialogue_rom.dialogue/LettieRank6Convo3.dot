		j3781410724 -> j1006872109 [label=false,color=brown];
	j2371122653 [label="JAJAJAJA\nА я думала, ты не из такого типа людей\nAaaay, babas...\nНачинаю переосмыслить некоторые вещи..",shape=box,color=blue];
		j2371122653 -> j1415890038;
		j2371122653 -> j2959902851;
	j1302043161 [label="JAJAJAJA\nМожет позже, babas\nNo me distraigas",shape=box,color=blue];
		j1302043161 -> j529020921;
	j3926799146 [label="Бассейн на крыше?",shape=box,color=red];
		j3926799146 -> j589640935;
	j3982142470 [label="Насколько я помню, а зачем?",shape=box,color=red];
		j3982142470 -> j3195127176;
	j3210507066 [label="Check boolean LettieReal",color=orange];
		j3210507066 -> j2594551054 [label=true,color=green];
		j3210507066 -> j1118968904 [label=false,color=brown];
	j1006872109 [label="Aayy, с тобой не весело\nЛадно уж\nNo me distraigas",shape=box,color=blue];
		j1006872109 -> j529020921;
	j1415890038 [label="Ха, просто подкалываю. Не строй иллюзий.",shape=box,color=red];
		j1415890038 -> j2937031476;
	j2959902851 [label="Могу я извиниться? За мои слова, которые расстроили тебя. Мне кажется, я ляпнул что-то не то, сам того не осознавая.",shape=box,color=red];
		j2959902851 -> j1592666077;
	j589640935 [label="Jajaja нет, но, может быть\nЭто очень заманчиво\nЯ подумала, может быть, мы могли бы построить теплицу",shape=box,color=blue];
		j589640935 -> j1034038892;
	j3195127176 [label="Я подумала\nВся эта ровная площадь\nМожет быть, мы могли бы построить теплицу",shape=box,color=blue];
		j3195127176 -> j1034038892;
	j2594551054 [label="Айй, с тобой совсем не весело\nЛадно, corazón\nВ общем\nNo me distraigas",shape=box,color=blue];
		j2594551054 -> j529020921;
	j1118968904 [label="Айй, с тобой совсем не весело\nЛадно, solecito\nВ общем\nNo me distraigas",shape=box,color=blue];
		j1118968904 -> j529020921;
	j2937031476 [label="Sí, Sí\nСледовало бы догадаться\nNo me distraigas",shape=box,color=blue];
		j2937031476 -> j529020921;
	j1592666077 [label=".....\nАаааххххххгггх mierda\nSíííííí... хорошо\nНе смогу и дальше поучать Артура, что нужно двигаться дальше\nЕсли я сама не делаю того же",shape=box,color=blue];
		j1592666077 -> j916337026;
	j1034038892 [label="Знаю, что этого не произойдет ни сегодня, ни завтра\nВозможно, не в ближайшее время\nНо просто думать об этом может быть приятно\n¿Qué te parece?",shape=box,color=blue];
		j1034038892 -> j2355003940;
		j1034038892 -> j671220577;
		j1034038892 -> j4244687976;
	j916337026 [label="Boolean LettieNoDate is now false.",color=orange];
		j916337026 -> j2080514312;
	j2355003940 [label="Ох, мы могли бы вырастить немного свежих овощей.",shape=box,color=red];
		j2355003940 -> j1708376447;
	j671220577 [label="Это было бы здорово для приготовления panquecitos. :) Немного времени под солнышком без волнения о них.",shape=box,color=red];
		j671220577 -> j3771682084;
	j4244687976 [label="Мне это нравится! Но почему теплица?",shape=box,color=red];
		j4244687976 -> j2825134085;
	j2080514312 [label="Te perdono\nПрощаю\nТолько не заставляй меня пожалеть об этом, eh babas?",shape=box,color=blue];
		j2080514312 -> j3875440028;
	j1708376447 [label="Sí, sí\nСвежая еда (Si como más pizza voy a gritar)\nЯ могу выращивать cempasúchil цветы\nНо... эх, не смейся",shape=box,color=blue];
		j1708376447 -> j259346572;
	j3771682084 [label="+5 Chemistry",color=orange];
		j3771682084 -> j977661750;
	j2825134085 [label="Множество причин\nСвежая еда (Si como más pizza voy a gritar)\nЯ могу выращивать cempasúchil цветы\nНо... эх, не смейся",shape=box,color=blue];
		j2825134085 -> j259346572;
	j3875440028 [label="В любом случае\nNo me distraigas",shape=box,color=blue];
		j3875440028 -> j529020921;
	j259346572 [label="Это для Элеоноры",shape=box,color=blue];
		j259346572 -> j2715964138;
		j259346572 -> j921296022;
		j259346572 -> j1382357647;
	j977661750 [label="Ааай, не заставляй меня плакать\nЭто так мило, думать о моих panquecitos\nGracias\nЯ тоже думала о чём-то другом\nНо... эх, не смейся",shape=box,color=blue];
		j977661750 -> j259346572;
	j2715964138 [label="Я помню, что она любит растения. Я думаю, ей бы это понравилось.",shape=box,color=red];
		j2715964138 -> j1265759356;
	j921296022 [label="Я просто радуюсь, что вы двое всё уладили. ",shape=box,color=red];
		j921296022 -> j2595953648;
	j1382357647 [label="С чего бы мне смеяться?",shape=box,color=red];
		j1382357647 -> j2398878952;
	j1265759356 [label="Здесь так уныло\nNo necesitamos mantenerlo lúgubre y sucio\nЛучше бы она разговаривала с растениями, а не с...\nНу... с пушками...",shape=box,color=blue];
		j1265759356 -> j1317354346;
	j2595953648 [label="Sí\nИногда бывает трудно отпустить что-то\nПризнать, когда все может измениться\nЛучше бы она разговаривала с растениями, а не с...\nНу... с пушками...",shape=box,color=blue];
		j2595953648 -> j1317354346;
	j2398878952 [label="Мы не всегда были с ней «лучшими подругами»\nИногда трудно отпускать вещи\nПризнай, что когда-то всё могло измениться\nЛучше бы она разговаривала с растениями, чем...\nНу... с оружием...",shape=box,color=blue];
		j2398878952 -> j1317354346;
	j1317354346 [label="Но я заметила, что когда она улыбается\nЯ улыбаюсь\nВероятно, больше от su onda de bruja jajaja",shape=box,color=blue];
		j1317354346 -> j1179168022;
	j1179168022 [label="В любом случае\nДумаю, это было бы неплохо\n«Мёртвый торговый центр» не обязательно понимать так буквально",shape=box,color=blue];
		j1179168022 -> "Chat ends.";
	"Chat ends." [color=orange];
