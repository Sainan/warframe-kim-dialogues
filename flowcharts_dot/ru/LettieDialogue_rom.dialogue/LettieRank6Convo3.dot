digraph {
	"LettieRank6Convo3 begins." [color=orange];
		"LettieRank6Convo3 begins." -> j3670338757;
	j3670338757 [label="В следующий раз\nКогда мы соберёмся расширить это место\nУ меня есть просьба\nPero no hay prisa, ¿no?",shape=box,color=blue];
		j3670338757 -> j1501868932;
