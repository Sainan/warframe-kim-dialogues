digraph {
	3513 [label="AoiRank5Convo5 begins.",color=orange];
		3513 -> 3514;
		3513 -> 3515;
	3514 [label="Одна вещь, которой я действительно восхищаюсь в тебе, - это твоя непоколебимая приверженность построению лучшего мира. Откуда это берется?",shape=box,color=red];
		3514 -> 3516;
	3515 [label="У тебя впечатляющий запас драйва. Что зажигает огонь в тебе?",shape=box,color=red];
		3515 -> 3516;
	3516 [label="ого, спасибо за такие слова. Эмм... хм. Нет какого-то решающего момента, который определил бы мой жизненный путь или что-то в этом роде.",shape=box,color=blue];
		3516 -> 3517;
	3517 [label="насколько я могу судить, я унаследовала это от своих родителей. они были практичными людьми, но и мечтателями тоже",shape=box,color=blue];
		3517 -> 3518;
	3518 [label="Я имею в виду, что ты не строишь ракеты для исследования космоса, если ты не мечтатель.",shape=box,color=blue];
		3518 -> 3519;
		3518 -> 3520;
		3518 -> 3521;
	3519 [label="Подожди. Твои родители строили ракеты?",shape=box,color=red];
		3519 -> 3522;
	3520 [label="Это чертовски крутой семейный бизнес. Похоже, они установили высокую планку.",shape=box,color=red];
		3520 -> 3523;
	3521 [label="Это не совсем обычное семейное наследие. Они когда-нибудь говорили о том, что их вдохновляло?",shape=box,color=red];
		3521 -> 3524;
	3522 [label="ну, папа знал, и мама знала, как это делать.",shape=box,color=blue];
		3522 -> 3525;
	3523 [label="да... и когда я стала солдатом, они ясно дали мне понять, что это не совсем та жизнь, которую они надеялись построить для меня.",shape=box,color=blue];
		3523 -> 3525;
	3524 [label="не очень. они не были большими любителями делиться своими мечтами вслух. Я думаю, они считали, что их вклад в мир скажет за них.",shape=box,color=blue];
		3524 -> 3525;
	3525 [label="папа был аэрокосмическим инженером. мама преподавала проектирование космических систем в университете, где они познакомились, когда были студентами.",shape=box,color=blue];
		3525 -> 3527;
		3525 -> 3526;
		3525 -> 3528;
	3527 [label="Ого, ваш дом был наполовину аналитическим центром, наполовину стартовой площадкой.",shape=box,color=red];
		3527 -> 3530;
	3526 [label="С ними, должно быть, было интересно общаться.",shape=box,color=red];
		3526 -> 3529;
	3528 [label="Они звучат так, словно были великолепны. Должно быть, это было невероятно - расти в такой обстановке.",shape=box,color=red];
		3528 -> 3529;
	3530 [label="хаха, не совсем. в основном было просто тихо.",shape=box,color=blue];
		3530 -> 3531;
	3529 [label="да, я так полагаю",shape=box,color=blue];
		3529 -> 3532;
	3531 [label="большинство наших разговоров состояли из \"привет, милая\" и \"привет\" мимоходом. Затем они хватали ужин по пути в офис, чтобы поработать допоздна или что-то в этом роде",shape=box,color=blue];
		3531 -> 3533;
	3532 [label="но большинство наших разговоров состояло только из \"эй, милая\" и \"привет\", когда мы проходили мимо друг друга на кухне. Они быстро перекусывали и возвращались в свои офисы, чтобы поработать допоздна",shape=box,color=blue];
		3532 -> 3533;
	3533 [label="они были заняты",shape=box,color=blue];
		3533 -> 3534;
	3534 [label="пока я не попадала в неприятности, они не особо обо мне беспокоились. И, несмотря на весь огонь, который горел у меня внутри, мне действительно удавалось избегать неприятностей.",shape=box,color=blue];
		3534 -> 3535;
		3534 -> 3536;
		3534 -> 3537;
	3535 [label="Я понимаю. Мои родители тоже всегда были заняты. Управление судном Зариман требовало полной занятости для всех. Тем не менее, мы всегда находили время, чтобы хотя бы посидеть вместе за обедом.",shape=box,color=red];
		3535 -> 3538;
	3536 [label="Это имеет смысл. Когда работа затягивает тебя так сильно, времени остается не так уж много, но я уверен, что они думали о тебе постоянно.",shape=box,color=red];
		3536 -> 3539;
	3537 [label="Не могу сказать, что я их виню. Я знаю по себе, что космические путешествия не оставляют много времени для отдыха. Похоже, ты облегчила им жизнь, не высовываясь.",shape=box,color=red];
		3537 -> 3540;
	3538 [label="+5 Chemistry",color=orange];
		3538 -> 3541;
	3539 [label="+5 Chemistry",color=orange];
		3539 -> 3542;
	3540 [label="да, я так думаю.",shape=box,color=blue];
		3540 -> 3545;
	3541 [label="это мило. Я рада, что они это сделали.",shape=box,color=blue];
		3541 -> 3543;
	3542 [label="может быть",shape=box,color=blue];
		3542 -> 3544;
	3545 [label="Надеюсь, что да.",shape=box,color=blue];
		3545 -> 3546;
	3543 [label="Теперь я понимаю, насколько важны такие моменты, но когда я росла, мне не казалось странным, что их у меня было мало.",shape=box,color=blue];
		3543 -> 3546;
	3544 [label="на самом деле да, я думаю, это правда :)",shape=box,color=blue];
		3544 -> 3546;
	3546 [label="Я понимаю, почему мои родители были так сосредоточены на своей работе. По-своему, это был их способ проявлять любовь. Они хотели обеспечить меня и создать технологию, которая могла бы помочь человечеству обрести лучшее будущее",shape=box,color=blue];
		3546 -> 3547;
	3547 [label="оглядываясь назад, это своего рода прекрасно",shape=box,color=blue];
		3547 -> 3548;
		3547 -> 3549;
		3547 -> 3550;
	3548 [label="Может быть, так, но мне все равно не по себе, что их дочь не проводила с ними больше времени. У нас в этой жизни не так уж много времени, понимаешь? Мы должны проводить как можно больше времени с теми, кого любим.",shape=box,color=red];
		3548 -> 3551;
	3549 [label="Красиво, конечно, но и практично тоже. Они делали что-то важное, и важнее этого не бывает.",shape=box,color=red];
		3549 -> 3554;
	3550 [label="Это сильная любовь, даже если она не та, что проявляется за обеденным столом.",shape=box,color=red];
		3550 -> 3552;
	3551 [label="+5 Chemistry",color=orange];
		3551 -> 3553;
	3554 [label="и все же я не могу не думать о том, что мы не так уж много времени проводили вместе.",shape=box,color=blue];
		3554 -> 3556;
	3552 [label="+5 Chemistry",color=orange];
		3552 -> 3555;
	3553 [label="вот эта часть «как можно больше времени» — сложная, не правда ли? её трудно измерить",shape=box,color=blue];
		3553 -> 3556;
	3556 [label="если я когда-нибудь увижу их снова, я обязательно наверстаю упущенное время. Я знаю, что они тоже так сделают.",shape=box,color=blue];
		3556 -> 3563;
		3556 -> 3558;
		3556 -> 3561;
	3555 [label="точно! не такой, как в кино, но вполне реальный.",shape=box,color=blue];
		3555 -> 3556;
	3563 [label="Справедливо. Просто не трать время на то, чтобы сейчас переживать из-за этого. Они сделали свой выбор, а ты свой. Похоже, ты прекрасно справляешься с тем, что они тебе дали.",shape=box,color=red];
		3563 -> 3564;
	3558 [label="Знаешь, это твое стремление сделать мир лучше... оно глубже, чем ты себе представляешь. Тебе стоит больше гордиться этим.",shape=box,color=red];
		3558 -> 3557;
	3561 [label="Надеюсь, у тебя будет такой шанс. Твое сердце полно надежды и силы. Я думаю, они гордились бы тем, кем ты стала.",shape=box,color=red];
		3561 -> 3560;
	3564 [label="Я так думаю",shape=box,color=blue];
		3564 -> 3567;
		3564 -> 3566;
		3564 -> 3565;
	3557 [label="+5 Chemistry",color=orange];
		3557 -> 3559;
	3560 [label="+5 Chemistry",color=orange];
		3560 -> 3562;
	3567 [label="У тебя их мозги и стремление, но ты сделала это своим. Вот что имеет значение.",shape=box,color=red];
		3567 -> 3570;
	3566 [label="Мне кажется, ты выросла таким любящим и внимательным человеком, в котором нуждалась, когда была моложе. Этим стоит гордиться.",shape=box,color=red];
		3566 -> 3568;
	3565 [label="Ты взяла всё, что они тебе дали, и даже больше — ты не только богата мечтами и стремлениями, но и состраданием. Нелегко сделать что-то подобное.",shape=box,color=red];
		3565 -> 3569;
	3559 [label="о? как так?",shape=box,color=blue];
		3559 -> 3567;
		3559 -> 3566;
		3559 -> 3565;
	3562 [label="это много для меня значит. Я тоже на это надеюсь.",shape=box,color=blue];
		3562 -> 3567;
		3562 -> 3566;
		3562 -> 3565;
	3570 [label="это... на самом деле очень классный способ об этом подумать.",shape=box,color=blue];
		3570 -> 3573;
		3570 -> 3572;
		3570 -> 3574;
	3568 [label="+5 Chemistry",color=orange];
		3568 -> 3571;
	3569 [label="+5 Chemistry",color=orange];
		3569 -> 3571;
	3573 [label="Просто говорю так, как я это вижу.",shape=box,color=red];
		3573 -> 3575;
	3572 [label="В любое время.",shape=box,color=red];
		3572 -> 3575;
	3574 [label="Ты заслуживаешь этого.",shape=box,color=red];
		3574 -> 3575;
	3571 [label="Я никогда раньше не думала об этом в таком ключе. Это... действительно прекрасный способ увидеть это. Спасибо.",shape=box,color=blue];
		3571 -> 3573;
		3571 -> 3572;
		3571 -> 3574;
	3575 [label="<3",shape=box,color=blue];
		3575 -> 3576;
	3576 [label="Chat ends.",color=orange];
}