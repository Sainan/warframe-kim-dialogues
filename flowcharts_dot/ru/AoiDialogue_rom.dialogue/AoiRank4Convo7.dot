		2939 -> 2940;
	2952 [label="Chat ends.",color=orange];
	2957 [label="Этого достаточно, чтобы изменить жизнь. Я знаю этих животных. Я бы сказал, друзей. Кавия. Они прикоснулись к Бездне и научились \"говорить\", как по волшебству.",shape=box,color=red];
