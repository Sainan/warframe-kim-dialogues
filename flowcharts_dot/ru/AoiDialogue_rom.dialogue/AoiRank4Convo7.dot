		2936 -> 2937;
	2940 [label="ух. Скальдра. они, вероятно, уничтожили их. зачем им сохранять в целости и сохранности инструмент, способный даровать надежду?",shape=box,color=blue];
		2940 -> 2941;
	2959 [label="И когда они заговорили сейчас, все начиналось так безнадежно. Так неправильно. Язык Бездны сначала дал этим существам почувствовать только одно: безнадежность.",shape=box,color=red];
