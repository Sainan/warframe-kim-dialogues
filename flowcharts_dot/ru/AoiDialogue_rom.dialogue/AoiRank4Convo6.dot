		2831 -> 2835;
		2831 -> 2834;
	2835 [label="Прости, что разочаровываю. Он тот, кто тебе нужен. Отказался от Кувы, которая позволяет получить бессмертие. Не пошёл на поводу у модной длиннорукости. Ничего подобного.",shape=box,color=red];
		2835 -> 2833;
	2834 [label="Ага, эм… Я придумаю крутого Орокин. Дай мне минутку.",shape=box,color=red];
		2834 -> 2832;
	2833 [label="я уверена, что он просто хотел добиться того, что было ему выгодно.",shape=box,color=blue];
		2833 -> 2836;
