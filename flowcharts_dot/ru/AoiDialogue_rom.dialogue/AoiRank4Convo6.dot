		2837 -> 2840;
	2838 [label="Ха. Я не Орокин. Я просто из их империи. Очень отличается.",shape=box,color=red];
		2838 -> 2841;
	2839 [label="хм. теперь ты решаешь важные вопросы, да? Думаю, ты это заслужил.",shape=box,color=blue];
		2839 -> 2843;
