		2841 -> 2842;
	2843 [label="такие люди, как он, только притворяются обаятельными, когда это им выгодно",shape=box,color=blue];
		2843 -> 2844;
		2843 -> 2845;
	2842 [label="хотя мне действительно не понравился Энтрати. такие люди, как он, только притворяются очаровательными, когда им это выгодно",shape=box,color=blue];
		2842 -> 2844;
