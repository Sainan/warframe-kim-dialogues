	j875258591 [label="в чём моя вина?",shape=box,color=blue];
		j875258591 -> j2727599450;
	j2727599450 [label="Нет-нет! Ничего! Мне нужно поговорить с тобой о... надеюсь, это не будет очень неудобно для тебя.",shape=box,color=red];
		j2727599450 -> j4167997108;
	j4167997108 [label="Я не хочу ставить тебя в ситуацию, в которой ты будешь чувствовать себя плохо. Я знаю, мы это раньше не обсуждали. Так что если ты скажешь нет, это нормально. И я хочу, чтобы ты это знала.",shape=box,color=red];
		j4167997108 -> j1223033739;
	j1223033739 [label="То, что есть между нами, важно для меня. Очень важно. И оно настоящее. Я не хочу, чтобы были какие-то сомнения.",shape=box,color=red];
