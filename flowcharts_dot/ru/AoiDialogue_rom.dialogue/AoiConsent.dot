		j3530296210 -> j3258759838;
	j3258759838 [label="наверное, я просто хочу понять, увижусь ли я с ними или нет?",shape=box,color=blue];
		j3258759838 -> j2223458855;
	j2223458855 [label="ох... это же... это же не кто-то из гекс, нет? или с круглого стола? потому что было немного брр",shape=box,color=blue];
		j2223458855 -> j925531313;
