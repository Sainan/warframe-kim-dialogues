	"AoiRank5Convo3 begins." [color=orange];
		"AoiRank5Convo3 begins." -> j2411019374;
		"AoiRank5Convo3 begins." -> j3147484208;
	j2411019374 [label="Ты должна быть самым сильным героем в Гексе. Я имею в виду, учитывая, что все здесь частично металлические, ты определенно не тот, с кем стоит связываться.",shape=box,color=red];
		j2411019374 -> j492820411;
	j3147484208 [label="Я думаю, что из всех членов команды твоё инстинктивное стремление всегда заботиться о других делает тебя самой героической из всех нас.",shape=box,color=red];
		j3147484208 -> j4003005390;
	j492820411 [label="хаха",shape=box,color=blue];
		j492820411 -> j1482354626;
	j4003005390 [label="+5 Chemistry",color=orange];
		j4003005390 -> j946801006;
	j1482354626 [label="ты говоришь как Амир",shape=box,color=blue];
		j1482354626 -> j3168392988;
		j1482354626 -> j2120048876;
		j1482354626 -> j1971351082;
		j1482354626 -> j3972929351;
	j946801006 [label="<3",shape=box,color=blue];
		j946801006 -> j1482354626;
	j3168392988 [label="Впервые в жизни мне такое говорят.",shape=box,color=red];
		j3168392988 -> j2554990705;
	j2120048876 [label="Спасибо. Почему?",shape=box,color=red];
		j2120048876 -> j3076049436;
	j1971351082 [label="Серьёзно? Что заставляет тебя так говорить?",shape=box,color=red];
		j1971351082 -> j2199297045;
	j3972929351 [label="Это комплимент?",shape=box,color=red];
		j3972929351 -> j1702670205;
	j2554990705 [label="правда? но вы двое так похожи ;)",shape=box,color=blue];
		j2554990705 -> j2199297045;
	j3076049436 [label="+5 Chemistry",color=orange];
		j3076049436 -> j2199297045;
	j2199297045 [label="просто когда Амир впервые присоединился к Гексу, он шутил обо мне, говоря, что я супергерой",shape=box,color=blue];
		j2199297045 -> j2618140661;
	j1702670205 [label="Разумеется!",shape=box,color=blue];
		j1702670205 -> j2199297045;
	j2618140661 [label="... и он мой помощник",shape=box,color=blue];
		j2618140661 -> j1610959433;
	j1610959433 [label="это было мило, но и немного грустно",shape=box,color=blue];
		j1610959433 -> j3208035350;
		j1610959433 -> j1926597842;
		j1610959433 -> j4081311149;
	j3208035350 [label="Это удивительно. Амир всегда кажется таким уверенным.",shape=box,color=red];
		j3208035350 -> j4101521997;
	j1926597842 [label="Помощник, да? Это не похоже на того Амира, которого я знаю сейчас. Что изменилось?",shape=box,color=red];
		j1926597842 -> j4101521997;
	j4081311149 [label="Грустно? Я думал, вы двое близки.",shape=box,color=red];
		j4081311149 -> j1224185549;
	j4101521997 [label="потребовалось время. Амир присоединился к нам без какого-либо военного опыта, поэтому борьба была для него непосильной",shape=box,color=blue];
		j4101521997 -> j728619824;
	j1224185549 [label="о, да! Амир мой лучший друг. Некоторые из моих любимых воспоминаний — это мы в игровом зале, игры и рок-н-ролл под On-lyne",shape=box,color=blue];
		j1224185549 -> j3528637216;
	j728619824 [label="ему просто нужно было понять, что быть героем - это не только сражаться",shape=box,color=blue];
		j728619824 -> j462711733;
	j3528637216 [label="но вся эта история с помощником? Я могу сказать, что он чувствовал себя... маленьким.",shape=box,color=blue];
		j3528637216 -> j462711733;
	j462711733 [label="Я всегда знала, что такой великий хакер, как он, может быть по-своему героем",shape=box,color=blue];
		j462711733 -> j2877915085;
		j462711733 -> j2965792300;
	j2877915085 [label="Что для него изменилось? Сейчас он не кажется чьим-то помощником.",shape=box,color=red];
		j2877915085 -> j411437535;
	j2965792300 [label="И ты сыграла большую роль в том, чтобы помочь ему это осознать, не так ли?",shape=box,color=red];
		j2965792300 -> j411437535;
	j411437535 [label="Я не могу приписать себе всю заслугу, но я была рядом, когда у него случился прорыв.",shape=box,color=blue];
		j411437535 -> j923548348;
	j923548348 [label="однажды я наткнулась на дикую трансляцию от онлайн-фаната, который собрал воедино некоторые сомнительные подробности о HitMaker (это лейбл On-lyne)",shape=box,color=blue];
		j923548348 -> j1578052352;
	j1578052352 [label="она фактически умоляла кого-нибудь помочь им, и Амир без колебаний бросился на помощь",shape=box,color=blue];
		j1578052352 -> j80844958;
		j1578052352 -> j487970165;
		j1578052352 -> j594843378;
	j80844958 [label="Как Амир мог оказаться втянутым в нечто подобное?",shape=box,color=red];
		j80844958 -> j446191951;
	j487970165 [label="Амир? Я думал, это ты побежишь спасать On-lyne.",shape=box,color=red];
		j487970165 -> j3646784855;
	j594843378 [label="Мне кажется, это легендарная пара Аои-Амир.",shape=box,color=red];
		j594843378 -> j3513147084;
	j446191951 [label="Я показала ему трансляцию. Амир позаботился обо всем остальном!",shape=box,color=blue];
		j446191951 -> j96513463;
	j3646784855 [label="ну, это была командная работа. можно сказать, что я была его помощником ^_^",shape=box,color=blue];
		j3646784855 -> j96513463;
	j3513147084 [label="+5 Chemistry",color=orange];
		j3513147084 -> j2175231167;
	j96513463 [label="он взломал электронную почту их менеджера и обнаружил кучу сделок с Скальдрой. они клонировали группу и подвергали её опасности, и все это скрывал их менеджмент",shape=box,color=blue];
		j96513463 -> j4195748554;
	j2175231167 [label="супер-фанат объединяет усилия с супер-хакером? Ничто не может нас остановить!",shape=box,color=blue];
		j2175231167 -> j96513463;
	j4195748554 [label="бе!",shape=box,color=blue];
		j4195748554 -> j1354169442;
	j1354169442 [label="без навыков Амира ничего из этого не выплыло бы наружу",shape=box,color=blue];
		j1354169442 -> j3435520791;
		j1354169442 -> j1624088267;
	j3435520791 [label="Ого. Это невероятно. Амир действительно все это раскрыл?",shape=box,color=red];
		j3435520791 -> j1339184376;
	j1624088267 [label="Знаешь, если правда, что знание — сила, то хакеры действительно сильны.",shape=box,color=red];
		j1624088267 -> j1339184376;
	j1339184376 [label="конечно. все эти испытания полностью помогли ему понять, что он не просто помощник. он был героем сам по себе ^_^",shape=box,color=blue];
		j1339184376 -> j2648210924;
		j1339184376 -> j2227918158;
	j2648210924 [label="И вы все равно сможете вместе оторваться в игровом зале",shape=box,color=red];
		j2648210924 -> j297263055;
	j2227918158 [label="Как будто могли быть какие-то сомнения.",shape=box,color=red];
		j2227918158 -> j2363243976;
	j297263055 [label="просто два героя отдыхают!",shape=box,color=blue];
		j297263055 -> j3993498765;
	j2363243976 [label="верно?",shape=box,color=blue];
		j2363243976 -> j3993498765;
	j3993498765 [label="ты тоже герой, ты знаешь <3",shape=box,color=blue];
		j3993498765 -> j821643165;
		j3993498765 -> j3683611892;
		j3993498765 -> j3128586537;
	j821643165 [label="Для меня многое значит, что ты сказала это.",shape=box,color=red];
