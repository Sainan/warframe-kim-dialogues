	2339 [label="Конечно. Я имею в виду... Я не очень хорошо ее знаю? Ребенок знает ее лучше, чем я. Но она спасла мне жизнь.",shape=box,color=red];
		2339 -> 2341;
	2340 [label="Я в долгу перед ней за то, что она спасла мне жизнь. Поэтому, когда ей понадобилось, чтобы я приехал сюда, я откликнулся на звонок.",shape=box,color=red];
		2340 -> 2342;
	2267 [label="Хех. Ну, помнишь, я тебе рассказывал про настоящих драконов? Вот где они были.",shape=box,color=red];
		2267 -> 2270;
	2269 [label="Дувири может быть красивым, но он... также опасен, как и все сказочные миры. Наполнен монстрами и уроками, которые нужно усвоить.",shape=box,color=red];
		2269 -> 2272;
