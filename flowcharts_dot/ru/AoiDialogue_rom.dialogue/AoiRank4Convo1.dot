	2271 [label="<RETRO_EMOJI_WHOA>",shape=box,color=blue];
		2271 -> 2273;
	2343 [label="Моя версия из этой временной линии, которая не состарилась, потому что они застряли в стазисной капсуле на Луа, и Лотос, которая позже спасла меня, отправила Луа и ребенка в Бездну на некоторое время, чтобы все были в безопасности--",shape=box,color=red];
		2343 -> 2345;
	2344 [label="Верно. Да. Так что, технически, я из другой временной шкалы. Другая моя версия постарела не так сильно, потому что... понимаешь? Это долгая история.",shape=box,color=red];
		2344 -> 3059;
	2365 [label="Когда я был в Дувири, я был... в ловушке. В апатии. Я забыл, кто я. Зачем я там.",shape=box,color=red];
		2365 -> 2367;
	2366 [label="Иногда, когда ты оказываешься на дне своей жизни... тебе просто нужна рука помощи.",shape=box,color=red];
		2366 -> 2368;
	2285 [label="Знаешь, как я могу использовать Перенос, чтобы направлять тебя? Я могу использовать Перенос и на Оровирме. Это *действительно* странно.",shape=box,color=red];
		2285 -> 2287;
	2286 [label="Они могут быть такими, когда не пытаются тебя убить.",shape=box,color=red];
