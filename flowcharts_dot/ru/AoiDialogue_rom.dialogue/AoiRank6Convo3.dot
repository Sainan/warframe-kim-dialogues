		3974 -> 3976;
	3975 [label="да, так и будет, так или иначе",shape=box,color=blue];
		3975 -> 3977;
	3976 [label="Даже если это делается для того, чтобы навести порядок в его жизни, в некотором смысле, это приносит именно это во вселенную. То сочувствие, о котором ты говоришь.",shape=box,color=red];
