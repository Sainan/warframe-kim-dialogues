		3929 -> 3930;
	3930 [label="что",shape=box,color=blue];
		3930 -> 3931;
		3930 -> 3932;
	3931 [label="РЖ;ВЛМ: Альбрехт отправился в Бездну, запаниковал и в итоге украл несколько пальцев Безразличия.",shape=box,color=red];
		3931 -> 3933;
	3932 [label="Ну. Ладно. Итак. Альбрехт... был первым человеком, который «открыл», как попасть в Бездну.",shape=box,color=red];
		3932 -> 3934;
	3933 [label="сначала... РЖ;ВЛМ:?",shape=box,color=blue];
		3933 -> 3935;
	3934 [label="Это был своего рода водолазный колокол. Сделанный из чего-то, что называется синтстекла. Он растянул мембрану между мирами.",shape=box,color=red];
		3934 -> 3936;
	3935 [label="Скажу коротко, потому что очень долго. Это Куинси научил меня этому.",shape=box,color=red];
		3935 -> 3937;
	3936 [label="Дела пошли... мягко говоря, не так. Он запаниковал, пошатнулся, штука наклонилась, ударилась об острый как бритва край мембраны.",shape=box,color=red];
		3936 -> 3938;
	3937 [label="хм...",shape=box,color=blue];
		3937 -> 3939;
	3938 [label="Колокол из синтстекла разбился, и упал в Бездну.",shape=box,color=red];
		3938 -> 3940;
	3939 [label="сек",shape=box,color=blue];
		3939 -> 3941;
	3940 [label="И когда он пришел в себя, он снова был в своей лаборатории, только это была не его лаборатория. И он смотрел на себя. Только это был не он. И «он» назвал себя именем, которое знала только его мать.",shape=box,color=red];
		3940 -> 3942;
	3941 [label="****У ТЕБЯ ЕСТЬ ПАЛЬЦЫ?!?!?!****",shape=box,color=blue];
		3941 -> 3943;
	3942 [label="Итак, Альбрехт бежал, спасая свою жизнь. Он порезался о разбитое синтстекло и написал своей кровью, чтобы его дочь закрыла за ним мембрану -",shape=box,color=red];
		3942 -> 3944;
	3943 [label="И ТЫ ИСПОЛЬЗУЕШЬ ЕГО ДЛЯ ПИТАНИЯ СВОЕГО РЭЙЛДЖЕКА?!?!",shape=box,color=blue];
		3943 -> 3945;
	3944 [label="- потому что он чувствовал, что «человек» тянется к нему.",shape=box,color=red];
		3944 -> 3946;
	3945 [label="<RETRO_EMOJI_HORRIFIED>",shape=box,color=blue];
		3945 -> 3947;
