		j2539132642 -> j3612687929;
	j3612687929 [label="космические путешествия должны были быть... весёлыми. крутыми. полными... исследований и встреч с новыми видами",shape=box,color=blue];
		j3612687929 -> j3931325412;
	j3931325412 [label="это должны быть особые приключения. ну я не знаю. у амира целая речь есть, цитаты из шоу",shape=box,color=blue];
		j3931325412 -> j191897404;
	j191897404 [label="но предполагалось, что это будет о... человечности, сочувствии, обучении и приключениях",shape=box,color=blue];
