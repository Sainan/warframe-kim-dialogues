		j3646158132 -> j3145997857;
	j2837761897 [label="Не знаю, принесет ли пользу их возврат. Не думаю, что это изменит его мнение.",shape=box,color=red];
		j2837761897 -> j3234027407;
	j3145997857 [label="Это как-то привязывает его здесь? Удерживает на нашем игровом поле? Пока мы держим его пальцы, оно вынуждено играть по нашим правилам.",shape=box,color=red];
