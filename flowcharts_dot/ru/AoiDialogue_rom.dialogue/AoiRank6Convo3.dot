	3922 [label="как это работает?",shape=box,color=blue];
		3922 -> 3924;
	3923 [label="оба!!! начни с большого корабля!!",shape=box,color=blue];
		3923 -> 3925;
	3924 [label="Ну, это зависит от того, большой это корабль или маленький, но они оба используют Бездну, чтобы преодолевать большие расстояния. Они пересекают Бездну.",shape=box,color=red];
		3924 -> 3926;
	3925 [label="Ну, это мой Рэйлджек. В нем находится точная копия отрезанного пальца Безразличия, известная как Реликварный Привод.",shape=box,color=red];
		3925 -> 3927;
	3926 [label="Большой корабль, Рэйлджек, использует устройство, называемое Реликварный Привод - в нём есть точная копия отрубленного пальца Безразличия.",shape=box,color=red];
		3926 -> 3928;
	3927 [label="Он использует это, чтобы проникнуть в Бездну, чтобы пересекать большие расстояния между планетами. Он проходит через Бездну.",shape=box,color=red];
		3927 -> 3928;
