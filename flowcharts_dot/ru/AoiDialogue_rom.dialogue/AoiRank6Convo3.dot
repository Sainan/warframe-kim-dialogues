		j1153220655 -> j3589206295;
	j106291427 [label="оба!!! начни с большого корабля!!",shape=box,color=blue];
		j106291427 -> j1587765838;
	j3589206295 [label="Ну, это зависит от того, большой это корабль или маленький, но они оба используют Бездну, чтобы преодолевать большие расстояния. Они пересекают Бездну.",shape=box,color=red];
		j3589206295 -> j1480218692;
	j1587765838 [label="Ну, это мой Рэйлджек. В нем находится точная копия отрезанного пальца Безразличия, известная как Реликварный Привод.",shape=box,color=red];
		j1587765838 -> j2614832799;
	j1480218692 [label="Большой корабль, Рэйлджек, использует устройство, называемое Реликварный Привод - в нём есть точная копия отрубленного пальца Безразличия.",shape=box,color=red];
		j1480218692 -> j2887337636;
	j2614832799 [label="Он использует это, чтобы проникнуть в Бездну, чтобы пересекать большие расстояния между планетами. Он проходит через Бездну.",shape=box,color=red];
		j2614832799 -> j2887337636;
	j2887337636 [label="<RETRO_EMOJI_OHNO>",shape=box,color=blue];
		j2887337636 -> j1218484349;
	j1218484349 [label="извини",shape=box,color=blue];
		j1218484349 -> j802514745;
	j802514745 [label="что",shape=box,color=blue];
		j802514745 -> j3511704589;
		j802514745 -> j2815579828;
	j3511704589 [label="РЖ;ВЛМ: Альбрехт отправился в Бездну, запаниковал и в итоге украл несколько пальцев Безразличия.",shape=box,color=red];
		j3511704589 -> j525908678;
	j2815579828 [label="Ну. Ладно. Итак. Альбрехт... был первым человеком, который «открыл», как попасть в Бездну.",shape=box,color=red];
		j2815579828 -> j3336463830;
	j525908678 [label="сначала... РЖ;ВЛМ:?",shape=box,color=blue];
		j525908678 -> j2470497757;
	j3336463830 [label="Это был своего рода водолазный колокол. Сделанный из чего-то, что называется синтстекла. Он растянул мембрану между мирами.",shape=box,color=red];
		j3336463830 -> j3735213027;
	j2470497757 [label="Скажу коротко, потому что очень долго. Это Куинси научил меня этому.",shape=box,color=red];
		j2470497757 -> j4006057645;
	j3735213027 [label="Дела пошли... мягко говоря, не так. Он запаниковал, пошатнулся, штука наклонилась, ударилась об острый как бритва край мембраны.",shape=box,color=red];
		j3735213027 -> j228746703;
	j4006057645 [label="хм...",shape=box,color=blue];
		j4006057645 -> j831848191;
	j228746703 [label="Колокол из синтстекла разбился, и упал в Бездну.",shape=box,color=red];
		j228746703 -> j168762007;
	j831848191 [label="сек",shape=box,color=blue];
		j831848191 -> j3527539946;
	j168762007 [label="И когда он пришел в себя, он снова был в своей лаборатории, только это была не его лаборатория. И он смотрел на себя. Только это был не он. И «он» назвал себя именем, которое знала только его мать.",shape=box,color=red];
		j168762007 -> j3120133981;
	j3527539946 [label="****У ТЕБЯ ЕСТЬ ПАЛЬЦЫ?!?!?!****",shape=box,color=blue];
		j3527539946 -> j3762927273;
	j3120133981 [label="Итак, Альбрехт бежал, спасая свою жизнь. Он порезался о разбитое синтстекло и написал своей кровью, чтобы его дочь закрыла за ним мембрану -",shape=box,color=red];
		j3120133981 -> j3997459672;
	j3762927273 [label="И ТЫ ИСПОЛЬЗУЕШЬ ЕГО ДЛЯ ПИТАНИЯ СВОЕГО РЭЙЛДЖЕКА?!?!",shape=box,color=blue];
		j3762927273 -> j1121709813;
	j3997459672 [label="- потому что он чувствовал, что «человек» тянется к нему.",shape=box,color=red];
		j3997459672 -> j1557806020;
	j1121709813 [label="<RETRO_EMOJI_HORRIFIED>",shape=box,color=blue];
		j1121709813 -> j2794308215;
	j1557806020 [label="Она это сделала. А когда она закрылась? Ну... пальцы были отрезаны и лежали на полу.",shape=box,color=red];
		j1557806020 -> j976513379;
	j2794308215 [label="может быть, это да, безумно!!!",shape=box,color=blue];
		j2794308215 -> j3124138881;
