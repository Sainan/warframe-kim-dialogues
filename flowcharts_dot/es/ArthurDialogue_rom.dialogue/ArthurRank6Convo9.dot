digraph {
	3555 [label="ArthurRank6Convo9 begins.",color=orange];
		3555 -> 3556;
	3556 [label="No sé cómo sentirme con estas... armas infestadas que Eleanor está coleccionando.",shape=box,color=blue];
		3556 -> 3557;
		3556 -> 3558;
	3557 [label="¿Por qué?",shape=box,color=red];
		3557 -> 3559;
	3558 [label="Al menos no hablan.",shape=box,color=red];
		3558 -> 3560;
	3559 [label="¿Además del hecho de que creo que puede hablar con ellas?",shape=box,color=blue];
		3559 -> 3561;
	3560 [label="Con *nosotros*. No estoy del todo seguro de que no hablen con *ella*.",shape=box,color=blue];
		3560 -> 3561;
	3561 [label="Sé que le hablan a la guitarra. Y no quiero pensar en ello más de lo necesario.",shape=box,color=blue];
		3561 -> 3562;
	3562 [label="Pero ¿debería preocuparnos que se propaguen? Parecen multiplicarse.",shape=box,color=blue];
		3562 -> 3563;
	3563 [label="Lo cual no entiendo. Tampoco quiero pensar demasiado de dónde viene su munición. Ni de qué está hecha.",shape=box,color=blue];
		3563 -> 3564;
		3563 -> 3565;
	3564 [label="¿Al menos estas cosas infestadas están de nuestro lado?",shape=box,color=red];
		3564 -> 3566;
	3565 [label="Entonces quizás prefieras quedarte con las armas normales.",shape=box,color=red];
		3565 -> 3567;
	3566 [label="Sí. Por *ahora*.",shape=box,color=blue];
		3566 -> 3568;
	3567 [label="Creo que eso haré.",shape=box,color=blue];
		3567 -> 3568;
	3568 [label="Al menos si mi arma me hace un agujero en el pie sé que yo soy el idiota responsable.",shape=box,color=blue];
		3568 -> 3569;
	3569 [label="Y no que mi arma haya decidido repensar su lealtad o haya tenido un ataque de hambre a medianoche.",shape=box,color=blue];
		3569 -> 3570;
	3570 [label="Chat ends.",color=orange];
}