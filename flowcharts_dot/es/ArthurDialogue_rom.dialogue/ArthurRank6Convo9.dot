digraph {
	"ArthurRank6Convo9 begins." [color=orange];
		"ArthurRank6Convo9 begins." -> j1512460750;
	j1512460750 [label="No sé cómo sentirme con estas... armas infestadas que Eleanor está coleccionando.",shape=box,color=blue];
		j1512460750 -> j1857078456;
		j1512460750 -> j2820760309;
	j1857078456 [label="¿Por qué?",shape=box,color=red];
		j1857078456 -> j737920800;
	j2820760309 [label="Al menos no hablan.",shape=box,color=red];
		j2820760309 -> j524830101;
	j737920800 [label="¿Además del hecho de que creo que puede hablar con ellas?",shape=box,color=blue];
		j737920800 -> j2411194697;
	j524830101 [label="Con *nosotros*. No estoy del todo seguro de que no hablen con *ella*.",shape=box,color=blue];
		j524830101 -> j2411194697;
	j2411194697 [label="Sé que le hablan a la guitarra. Y no quiero pensar en ello más de lo necesario.",shape=box,color=blue];
		j2411194697 -> j3337120009;
	j3337120009 [label="Pero ¿debería preocuparnos que se propaguen? Parecen multiplicarse.",shape=box,color=blue];
		j3337120009 -> j382371523;
	j382371523 [label="Lo cual no entiendo. Tampoco quiero pensar demasiado de dónde viene su munición. Ni de qué está hecha.",shape=box,color=blue];
		j382371523 -> j2997946361;
		j382371523 -> j1130214862;
	j2997946361 [label="¿Al menos estas cosas infestadas están de nuestro lado?",shape=box,color=red];
		j2997946361 -> j3403153307;
	j1130214862 [label="Entonces quizás prefieras quedarte con las armas normales.",shape=box,color=red];
		j1130214862 -> j1123541406;
	j3403153307 [label="Sí. Por *ahora*.",shape=box,color=blue];
		j3403153307 -> j1715585524;
	j1123541406 [label="Creo que eso haré.",shape=box,color=blue];
		j1123541406 -> j1715585524;
	j1715585524 [label="Al menos si mi arma me hace un agujero en el pie sé que yo soy el idiota responsable.",shape=box,color=blue];
		j1715585524 -> j4085391445;
	j4085391445 [label="Y no que mi arma haya decidido repensar su lealtad o haya tenido un ataque de hambre a medianoche.",shape=box,color=blue];
		j4085391445 -> "Chat ends.";
	"Chat ends." [color=orange];
}