		1537 -> 1538;
	1538 [label="Todo el mundo se une al ejército por una razón distinta. En mi caso, me uní por... honor. Por un propósito.",shape=box,color=blue];
		1538 -> 1539;
	1536 [label="Chat ends.",color=orange];
	1539 [label="Quería ser un héroe, como un completo idiota.",shape=box,color=blue];
