	1556 [label="Pero eran demasiadas.",shape=box,color=blue];
		1556 -> 1557;
	1557 [label="Cuando fui por ahí exigiendo respuestas de por qué acabábamos de masacrar a inocentes, los altos mandos me amenazaron con una baja deshonrosa.",shape=box,color=blue];
