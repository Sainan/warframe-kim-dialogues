digraph {
	graph [fontname="Roboto Condensed"];
	node [fontname="Roboto Condensed"];
	edge [fontname="Roboto Condensed"];

	"ArthurRank6Convo4 begins." [color=orange];
		"ArthurRank6Convo4 begins." -> j2801138386;
	j2801138386 [label="Pregunta rara. ¿Hay juguetes en el espacio?",shape=box,color=blue];
		j2801138386 -> j2961973798;
		j2801138386 -> j2971822926;
	j2961973798 [label="¿Juguetes para niños? Claro.",shape=box,color=red];
		j2961973798 -> j3208418010;
	j2971822926 [label="¿Qué... tipo de juguetes?",shape=box,color=red];
		j2971822926 -> j1966108975;
	j3208418010 [label="Je. ¿En serio?",shape=box,color=blue];
		j3208418010 -> j3526678413;
	j1966108975 [label="POR SOL. ¡No me refería a ESE tipo, y lo sabes!",shape=box,color=blue];
		j1966108975 -> j518983531;
	j3526678413 [label="Es difícil imaginar que miles de millones de años en el futuro,",shape=box,color=blue];
		j3526678413 -> j3751641229;
	j518983531 [label="Me refiero a juguetes infantiles. Muñecas. Figuras de acción. Cosas así.",shape=box,color=blue];
		j518983531 -> j1914860250;
		j518983531 -> j351284982;
	j3751641229 [label="Los niños siguen sentados recreando historias con figuritas y jugando a ser \"ladrones\" o \"salvar a la princesa\".",shape=box,color=blue];
		j3751641229 -> j2694498707;
		j3751641229 -> j2942397050;
		j3751641229 -> j1883429698;
	j1914860250 [label="Sólo te estoy molestando. :P",shape=box,color=red];
		j1914860250 -> j3128672043;
	j351284982 [label="No, no tenemos. [Fin]",shape=box,color=red];
		j351284982 -> "Chat ends.";
	j2694498707 [label="¿Qué te hizo pensar en esto?",shape=box,color=red];
		j2694498707 -> j3287726078;
	j2942397050 [label="¿Con qué jugabas en tu infancia?",shape=box,color=red];
		j2942397050 -> j705264807;
	j1883429698 [label="Tenemos diferentes nombres para los juegos que jugamos, pero definitivamente tenía juguetes.",shape=box,color=red];
		j1883429698 -> j2194369359;
	j3128672043 [label="Sí, claro que tenemos. ",shape=box,color=red];
		j3128672043 -> j3208418010;
	"Chat ends." [color=orange];
	j3287726078 [label="Estaba viendo a Amir jugando uno de sus juegos de arcade. ",shape=box,color=blue];
		j3287726078 -> j3365180364;
	j705264807 [label="Es bastante reconfortante pensar que, a pesar de todas las diferencias entre nuestras culturas, los niños todavía... se sientan y juegan con juguetes.",shape=box,color=blue];
		j705264807 -> j1207571047;
	j2194369359 [label="¿Como cuáles?",shape=box,color=blue];
		j2194369359 -> j1698496858;
		j2194369359 -> j4276926861;
	j3365180364 [label="Y me puse a pensar: \"Lo que daría por tener esa clase de alegría en mi vida otra vez\".",shape=box,color=blue];
		j3365180364 -> j4123700545;
	j1207571047 [label="Yo tenía una figura de acción. Action Angus. Era un soldado, ya sé, muy predecible.",shape=box,color=blue];
		j1207571047 -> j1376406932;
	j1698496858 [label="Todo tipo de figuritas, peluches y bloques para construir cosas. Cosas típicas de niños. ",shape=box,color=red];
		j1698496858 -> j705264807;
	j4276926861 [label="Tenía una, supongo que podría llamarse figurita, de un niño Dax, a quien, bueno, le puse el nombre de un personaje de un libro que tenía: Dominus Thrax.",shape=box,color=red];
		j4276926861 -> j1554204552;
	j4123700545 [label="Nunca he menospreciado a Aoi, ni a Amir, ni siquiera a Kaya, por divertirse con cosas \"infantiles\". Nunca me ha molestado.",shape=box,color=blue];
		j4123700545 -> j1896061744;
	j1376406932 [label="Durante una celebración del solsticio, un grupo de niños mayores me lo robaron junto con un montón de otros juguetes y, bueno...",shape=box,color=blue];
		j1376406932 -> j465938392;
	j1554204552 [label="Demonios. Debí haberlo sabido. Siento mucho haber sacado el tema.",shape=box,color=blue];
		j1554204552 -> j3314241072;
		j1554204552 -> j570499337;
	j1896061744 [label="Pero a veces tengo miedo de que la parte de mí que es capaz de sentir eso haya muerto hace mucho tiempo.",shape=box,color=blue];
		j1896061744 -> j4210686030;
	j465938392 [label="Es una larga historia. En resumen, dijeron que era \"demasiado mayor\" para jugar con muñecas. Esa fue la última vez que jugué con juguetes.",shape=box,color=blue];
		j465938392 -> j1313480489;
	j3314241072 [label="No es mi tema favorito para discutir.",shape=box,color=red];
		j3314241072 -> j1107348745;
	j570499337 [label="Está bien. No es tu culpa.",shape=box,color=red];
		j570499337 -> j161192135;
	j4210686030 [label="Es un poco triste, ¿no? Que les digamos a los niños que amen algo y luego les digamos que lo dejen cuando \"maduran\".",shape=box,color=blue];
		j4210686030 -> j1109165857;
		j4210686030 -> j1050060981;
	j1313480489 [label="El otro día, estaba viendo a Amir jugar uno de sus juegos. Se nota que significa mucho para él, que lo hace muy feliz. Y me dio un poco de envidia no tener nada parecido en mi vida.",shape=box,color=blue];
		j1313480489 -> j4210686030;
	j1107348745 [label="Ahora me siento como un completo idiota.",shape=box,color=blue];
		j1107348745 -> "Chat ends.";
	j161192135 [label="Teníamos todos los juguetes normales, supongo. Bloques de construcción, peluches, figuras, muñecas.",shape=box,color=red];
		j161192135 -> j714254173;
	j1109165857 [label="No lo sé. Todos tenemos que madurar. No podemos escondernos en la fantasía. Lo aprendí a las malas.",shape=box,color=red];
		j1109165857 -> j2929846042;
	j1050060981 [label="Creo que la vida puede ser fea, dolorosa y corta. Y deberíamos llenarla con tanta diversión, risas y amor como podamos.",shape=box,color=red];
		j1050060981 -> j3747569633;
	j714254173 [label="La mía se volvió un poquito más problemática debido a todo el asunto del... Vacío.",shape=box,color=red];
		j714254173 -> j705264807;
	j2929846042 [label="Tienes razón. Creo que cuando se convierte en un sustituto de la realidad, es un problema. No me refiero a eso.",shape=box,color=blue];
		j2929846042 -> j3244217196;
	j3747569633 [label="Tienes razón. Y espero que sea algo que recordemos mientras avanzamos juntos en... lo que sea que estemos viviendo.",shape=box,color=blue];
		j3747569633 -> j3244217196;
	j3244217196 [label="¿Sabes? Encontré a Eleanor, Velimir, Aoi y Amir jugando al escondite con Flare y Lizzie. (Quincy dijo que no le dejaban jugar porque el desgraciado hacía trampa y usaba su mira para ver a través de las paredes).",shape=box,color=blue];
		j3244217196 -> j3534750985;
	j3534750985 [label="Todos me veían preocupados de que me enojara porque los había encontrado jugando en vez de haciendo algo útil.",shape=box,color=blue];
		j3534750985 -> j1128368832;
	j1128368832 [label="Estaba más molesto porque no me habían invitado. Je. Pero tuve que poner cara de líder gruñón y fingir que estaba enojado porque los puestos estaban vacíos, etcétera.",shape=box,color=blue];
		j1128368832 -> j1535381528;
	j1535381528 [label="Pero Amir tiene sus juegos. Aoi tiene a On-lyne. Incluso Kaya tiene sus stickers y su Jinymon, a pesar de que el mundo la haya obligado a convertirse en adulta demasiado pronto.",shape=box,color=blue];
		j1535381528 -> j2339775089;
		j1535381528 -> j2488038142;
	j2339775089 [label="¿Qué estás tratando de decirme?",shape=box,color=red];
		j2339775089 -> j1568536810;
	j2488038142 [label="Creo que es algo que podrías recuperar si lo intentas. Me refiero a divertirte con juguetes y juegos.",shape=box,color=red];
		j2488038142 -> j190041756;
	j1568536810 [label="¿Honestamente? No estoy seguro. Sólo sé que siento que me estoy perdiendo de algo que desapareció de mi vida hace muchísimo tiempo.",shape=box,color=blue];
		j1568536810 -> j3343616721;
	j190041756 [label="Casi puedo oír la risa. Pero supongo que eso es lo que me detiene, ¿no? La vergüenza.",shape=box,color=blue];
		j190041756 -> j1363576155;
	j3343616721 [label="No sé si podré recuperarlo o si ya es demasiado tarde, pero quién sabe... Con el tiempo, quizá todo sea posible.",shape=box,color=blue];
		j3343616721 -> "Chat ends.";
	j1363576155 [label="No estoy seguro de que sea posible recuperarlo, incluso si pudiera superar la vergüenza inicial. Pero quién sabe. Con suficientes repeticiones, tal vez se pueda.",shape=box,color=blue];
		j1363576155 -> "Chat ends.";
}