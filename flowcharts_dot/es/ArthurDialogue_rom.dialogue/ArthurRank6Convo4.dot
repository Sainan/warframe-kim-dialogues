digraph {
	3433 [label="ArthurRank6Convo4 begins.",color=orange];
		3433 -> 3434;
	3434 [label="Pregunta rara. ¿Hay juguetes en el espacio?",shape=box,color=blue];
		3434 -> 3435;
		3434 -> 3436;
	3435 [label="¿Juguetes para niños? Claro.",shape=box,color=red];
		3435 -> 3437;
	3436 [label="¿Qué... tipo de juguetes?",shape=box,color=red];
		3436 -> 3438;
	3437 [label="Je. ¿En serio?",shape=box,color=blue];
		3437 -> 3439;
	3438 [label="POR SOL. ¡No me refería a ESE tipo, y lo sabes!",shape=box,color=blue];
		3438 -> 3440;
	3439 [label="Es difícil imaginar que miles de millones de años en el futuro,",shape=box,color=blue];
		3439 -> 3441;
	3440 [label="Me refiero a juguetes infantiles. Muñecas. Figuras de acción. Cosas así.",shape=box,color=blue];
		3440 -> 3442;
		3440 -> 3448;
	3441 [label="Los niños siguen sentados recreando historias con figuritas y jugando a ser \"ladrones\" o \"salvar a la princesa\".",shape=box,color=blue];
		3441 -> 3444;
		3441 -> 3445;
		3441 -> 3446;
	3442 [label="Sólo te estoy molestando. :P",shape=box,color=red];
		3442 -> 3447;
	3448 [label="No, no tenemos. [Fin]",shape=box,color=red];
		3448 -> 3452;
	3444 [label="¿Qué te hizo pensar en esto?",shape=box,color=red];
		3444 -> 3449;
	3445 [label="¿Con qué jugabas en tu infancia?",shape=box,color=red];
		3445 -> 3450;
	3446 [label="Tenemos diferentes nombres para los juegos que jugamos, pero definitivamente tenía juguetes.",shape=box,color=red];
		3446 -> 3451;
	3447 [label="Sí, claro que tenemos. ",shape=box,color=red];
		3447 -> 3437;
	3452 [label="Chat ends.",color=orange];
	3449 [label="Estaba viendo a Amir jugando uno de sus juegos de arcade. ",shape=box,color=blue];
		3449 -> 3453;
	3450 [label="Es bastante reconfortante pensar que, a pesar de todas las diferencias entre nuestras culturas, los niños todavía... se sientan y juegan con juguetes.",shape=box,color=blue];
		3450 -> 3454;
	3451 [label="¿Como cuáles?",shape=box,color=blue];
		3451 -> 3455;
		3451 -> 3456;
	3453 [label="Y me puse a pensar: \"Lo que daría por tener esa clase de alegría en mi vida otra vez\".",shape=box,color=blue];
		3453 -> 3457;
	3454 [label="Yo tenía una figura de acción. Action Angus. Era un soldado, ya sé, muy predecible.",shape=box,color=blue];
		3454 -> 3458;
	3455 [label="Todo tipo de figuritas, peluches y bloques para construir cosas. Cosas típicas de niños. ",shape=box,color=red];
		3455 -> 3450;
	3456 [label="Tenía una, supongo que podría llamarse figurita, de un niño Dax, a quien, bueno, le puse el nombre de un personaje de un libro que tenía: Dominus Thrax.",shape=box,color=red];
		3456 -> 3459;
	3457 [label="Nunca he menospreciado a Aoi, ni a Amir, ni siquiera a Kaya, por divertirse con cosas \"infantiles\". Nunca me ha molestado.",shape=box,color=blue];
		3457 -> 3460;
	3458 [label="Durante una celebración del solsticio, un grupo de niños mayores me lo robaron junto con un montón de otros juguetes y, bueno...",shape=box,color=blue];
		3458 -> 3461;
	3459 [label="Demonios. Debí haberlo sabido. Siento mucho haber sacado el tema.",shape=box,color=blue];
		3459 -> 3462;
		3459 -> 3463;
	3460 [label="Pero a veces tengo miedo de que la parte de mí que es capaz de sentir eso haya muerto hace mucho tiempo.",shape=box,color=blue];
		3460 -> 3464;
	3461 [label="Es una larga historia. En resumen, dijeron que era \"demasiado mayor\" para jugar con muñecas. Esa fue la última vez que jugué con juguetes.",shape=box,color=blue];
		3461 -> 3465;
	3462 [label="No es mi tema favorito para discutir.",shape=box,color=red];
		3462 -> 3466;
	3463 [label="Está bien. No es tu culpa.",shape=box,color=red];
		3463 -> 3467;
	3464 [label="Es un poco triste, ¿no? Que les digamos a los niños que amen algo y luego les digamos que lo dejen cuando \"maduran\".",shape=box,color=blue];
		3464 -> 3468;
		3464 -> 3469;
	3465 [label="El otro día, estaba viendo a Amir jugar uno de sus juegos. Se nota que significa mucho para él, que lo hace muy feliz. Y me dio un poco de envidia no tener nada parecido en mi vida.",shape=box,color=blue];
		3465 -> 3464;
	3466 [label="Ahora me siento como un completo idiota.",shape=box,color=blue];
		3466 -> 3470;
	3467 [label="Teníamos todos los juguetes normales, supongo. Bloques de construcción, peluches, figuras, muñecas.",shape=box,color=red];
		3467 -> 3471;
	3468 [label="No lo sé. Todos tenemos que madurar. No podemos escondernos en la fantasía. Lo aprendí a las malas.",shape=box,color=red];
		3468 -> 3472;
	3469 [label="Creo que la vida puede ser fea, dolorosa y corta. Y deberíamos llenarla con tanta diversión, risas y amor como podamos.",shape=box,color=red];
		3469 -> 3473;
	3470 [label="Chat ends.",color=orange];
	3471 [label="La mía se volvió un poquito más problemática debido a todo el asunto del... Vacío.",shape=box,color=red];
		3471 -> 3450;
	3472 [label="Tienes razón. Creo que cuando se convierte en un sustituto de la realidad, es un problema. No me refiero a eso.",shape=box,color=blue];
		3472 -> 3474;
	3473 [label="Tienes razón. Y espero que sea algo que recordemos mientras avanzamos juntos en... lo que sea que estemos viviendo.",shape=box,color=blue];
		3473 -> 3474;
	3474 [label="¿Sabes? Encontré a Eleanor, Velimir, Aoi y Amir jugando al escondite con Flare y Lizzie. (Quincy dijo que no le dejaban jugar porque el desgraciado hacía trampa y usaba su mira para ver a través de las paredes).",shape=box,color=blue];
		3474 -> 3475;
	3475 [label="Todos me veían preocupados de que me enojara porque los había encontrado jugando en vez de haciendo algo útil.",shape=box,color=blue];
		3475 -> 3476;
	3476 [label="Estaba más molesto porque no me habían invitado. Je. Pero tuve que poner cara de líder gruñón y fingir que estaba enojado porque los puestos estaban vacíos, etcétera.",shape=box,color=blue];
		3476 -> 3477;
	3477 [label="Pero Amir tiene sus juegos. Aoi tiene a On-lyne. Incluso Kaya tiene sus stickers y su Jinymon, a pesar de que el mundo la haya obligado a convertirse en adulta demasiado pronto.",shape=box,color=blue];
		3477 -> 3478;
		3477 -> 3479;
	3478 [label="¿Qué estás tratando de decirme?",shape=box,color=red];
		3478 -> 3480;
	3479 [label="Creo que es algo que podrías recuperar si lo intentas. Me refiero a divertirte con juguetes y juegos.",shape=box,color=red];
		3479 -> 3481;
	3480 [label="¿Honestamente? No estoy seguro. Sólo sé que siento que me estoy perdiendo de algo que desapareció de mi vida hace muchísimo tiempo.",shape=box,color=blue];
		3480 -> 3482;
	3481 [label="Casi puedo oír la risa. Pero supongo que eso es lo que me detiene, ¿no? La vergüenza.",shape=box,color=blue];
		3481 -> 3483;
	3482 [label="No sé si podré recuperarlo o si ya es demasiado tarde, pero quién sabe... Con el tiempo, quizá todo sea posible.",shape=box,color=blue];
		3482 -> 3484;
	3483 [label="No estoy seguro de que sea posible recuperarlo, incluso si pudiera superar la vergüenza inicial. Pero quién sabe. Con suficientes repeticiones, tal vez se pueda.",shape=box,color=blue];
		3483 -> 3485;
	3484 [label="Chat ends.",color=orange];
	3485 [label="Chat ends.",color=orange];
}