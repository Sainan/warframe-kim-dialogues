	j4160331738 [label="Arthur, ¿podemos hablar? [Solicitar consentimiento para tener varias parejas]",shape=box,color=red];
		j4160331738 -> j3289270074;
	j1104685808 [label="[Fin]",shape=box,color=red];
		j1104685808 -> j3652224286;
	j3289270074 [label="Siempre. ¿Pasa algo?",shape=box,color=blue];
		j3289270074 -> j525323393;
	j3652224286 [label="Boolean ArthurConsentComplete is now true.",color=orange];
		j3652224286 -> "Chat ends.";
	j525323393 [label="No, no exactamente. Solo quería contarte una situación que espero no te incomode.",shape=box,color=red];
		j525323393 -> j3959492290;
	j3959492290 [label="No quiero ponerte en una situación incómoda. Sé que no hemos hablado de esto. Así que si no estás de acuerdo, no hay problema. Quiero que lo sepas.",shape=box,color=red];
		j3959492290 -> j666887942;
	j666887942 [label="Lo que tenemos es importante para mí, muy importante, y es real. No quiero que lo dudes.",shape=box,color=red];
		j666887942 -> j3480346923;
	j3480346923 [label="Ah, ya veo adónde quieres llegar. ¿Tú... sientes algo por alguien más?",shape=box,color=blue];
		j3480346923 -> j1066137893;
		j3480346923 -> j1877034935;
	j1066137893 [label="Sí. Y sé que puede ser difícil de entender, pero eso no significa que te ame menos.",shape=box,color=red];
		j1066137893 -> j1612150241;
	j1877034935 [label="Sí. Pero ahora que lo pienso, creo que deberíamos dejarlo así. [Terminar la relación]",shape=box,color=red];
		j1877034935 -> j3483414308;
	j1612150241 [label="Cariño, ¿de verdad crees que he pasado tantos años en el ejército y no he visto prácticamente todo los tipos de relaciones que existen?",shape=box,color=blue];
		j1612150241 -> j1615338638;
	j3483414308 [label="Si eso es lo que realmente quieres, entonces...",shape=box,color=blue];
		j3483414308 -> j3701883258;
	j1615338638 [label="Cuando pasas la mayor parte de tu vida al borde de la muerte, aprendes a apreciar lo que importa en la vida y lo que no.",shape=box,color=blue];
		j1615338638 -> j1011860695;
	j3701883258 [label="Boolean IsDating is now false.",color=orange];
		j3701883258 -> j913620630;
	j1011860695 [label="No sé cómo funcionará esto, pero significas tanto para mí que estoy dispuesto a intentarlo.",shape=box,color=blue];
		j1011860695 -> j2123242248;
	j913620630 [label="Boolean ArthurDating is now false.",color=orange];
		j913620630 -> "Chat ends.";
	j2123242248 [label="Tú me importas. Y si a ti te importa esa persona, entonces a mí también.",shape=box,color=blue];
		j2123242248 -> j160390829;
	j160390829 [label="Sólo... que no sea alguien del centro comercial. ¿De acuerdo?",shape=box,color=blue];
		j160390829 -> j3116625313;
	j3116625313 [label="Las cosas ya están bastante complicadas de por sí.",shape=box,color=blue];
		j3116625313 -> j1069707098;
		j3116625313 -> j295351671;
	j1069707098 [label="Ja, ja. Lo prometo.",shape=box,color=red];
		j1069707098 -> j764723024;
	j295351671 [label="Si sirve de algo, creo que te caería bien.",shape=box,color=red];
		j295351671 -> j4134804350;
	j764723024 [label="Gracias. Y espero conocer a esa persona algún día. Por... razones personales, claro.",shape=box,color=blue];
		j764723024 -> j3017067277;
	j4134804350 [label="Y espero conocer a esa persona algún día. Por... razones personales, claro.",shape=box,color=blue];
