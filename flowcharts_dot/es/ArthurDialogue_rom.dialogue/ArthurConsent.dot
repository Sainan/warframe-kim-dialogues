		3611 -> 3614;
	3610 [label="Chat ends.",color=orange];
	3615 [label="Siempre. ¿Pasa algo?",shape=box,color=blue];
		3615 -> 3617;
	3614 [label="Update boolean ArthurConsentComplete",color=orange];
		3614 -> 3616;
	3617 [label="No, no exactamente. Solo quería contarte una situación que espero no te incomode.",shape=box,color=red];
		3617 -> 3618;
	3616 [label="Chat ends.",color=orange];
	3618 [label="No quiero ponerte en una situación incómoda. Sé que no hemos hablado de esto. Así que si no estás de acuerdo, no hay problema. Quiero que lo sepas.",shape=box,color=red];
		3618 -> 3619;
	3619 [label="Lo que tenemos es importante para mí, muy importante, y es real. No quiero que lo dudes.",shape=box,color=red];
		3619 -> 3620;
	3620 [label="Ah, ya veo adónde quieres llegar. ¿Sientes algo por alguien más?",shape=box,color=blue];
		3620 -> 3621;
		3620 -> 3622;
	3621 [label="Sí. Y sé que puede ser difícil de entender, pero eso no significa que te ame menos.",shape=box,color=red];
		3621 -> 3623;
	3622 [label="Sí. Pero ahora que lo pienso, creo que deberíamos dejarlo así. [Terminar la relación]",shape=box,color=red];
		3622 -> 3624;
	3623 [label="Cariño, ¿de verdad crees que he pasado tantos años en el ejército y no he visto prácticamente todo los tipos de relaciones que existen?",shape=box,color=blue];
		3623 -> 3625;
	3624 [label="Si eso es lo que realmente quieres, entonces...",shape=box,color=blue];
		3624 -> 3626;
	3625 [label="Cuando pasas la mayor parte de tu vida al borde de la muerte, aprendes a apreciar lo que importa en la vida y lo que no.",shape=box,color=blue];
		3625 -> 3627;
	3626 [label="Update boolean IsDating",color=orange];
		3626 -> 3628;
	3627 [label="Dejas de pensar en los límites. Lo entiendo perfectamente.",shape=box,color=blue];
		3627 -> 3629;
	3628 [label="Update boolean ArthurDating",color=orange];
		3628 -> 3630;
	3629 [label="La verdad es que significas mucho para mí. Y si esa persona es importante para ti, lo es también para mí.",shape=box,color=blue];
		3629 -> 3631;
	3630 [label="Chat ends.",color=orange];
	3631 [label="Sólo... que no sea alguien del Hex. ¿De acuerdo? No creo poder soportarlo si se tratara de alguien de \"la familia\", por así decirlo.",shape=box,color=blue];
		3631 -> 3632;
	3632 [label="El sólo pensarlo me daría pesadillas.",shape=box,color=blue];
		3632 -> 3634;
		3632 -> 3633;
	3634 [label="Ja, ja. Lo prometo.",shape=box,color=red];
		3634 -> 3636;
	3633 [label="Si sirve de algo, creo que te caería bien.",shape=box,color=red];
		3633 -> 3635;
	3636 [label="Gracias. Y espero conocer a esa persona algún día. Por... razones personales, claro.",shape=box,color=blue];
		3636 -> 3637;
	3635 [label="Y espero conocer a esa persona algún día. Por... razones personales, claro.",shape=box,color=blue];
		3635 -> 3637;
	3637 [label="+20 Chemistry",color=orange];
