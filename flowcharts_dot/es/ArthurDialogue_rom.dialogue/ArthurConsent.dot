	j2489973029 [label="Arthur, ¿podemos hablar? [Solicitar consentimiento para tener varias parejas]",shape=box,color=red];
		j2489973029 -> j2510208328;
	j1104685808 [label="[Fin]",shape=box,color=red];
		j1104685808 -> j3652224286;
	j2510208328 [label="Siempre. ¿Pasa algo?",shape=box,color=blue];
		j2510208328 -> j1414119735;
	j3652224286 [label="Boolean ArthurConsentComplete is now true.",color=orange];
		j3652224286 -> "Chat ends.";
	j1414119735 [label="No, no exactamente. Solo quería contarte una situación que espero no te incomode.",shape=box,color=red];
		j1414119735 -> j2646867709;
	j2646867709 [label="No quiero ponerte en una situación incómoda. Sé que no hemos hablado de esto. Así que si no estás de acuerdo, no hay problema. Quiero que lo sepas.",shape=box,color=red];
		j2646867709 -> j3186646755;
	j3186646755 [label="Lo que tenemos es importante para mí, muy importante, y es real. No quiero que lo dudes.",shape=box,color=red];
		j3186646755 -> j2392911657;
	j2392911657 [label="Ah, ya veo adónde quieres llegar. ¿Sientes algo por alguien más?",shape=box,color=blue];
		j2392911657 -> j4248648837;
		j2392911657 -> j1877034935;
	j4248648837 [label="Sí. Y sé que puede ser difícil de entender, pero eso no significa que te ame menos.",shape=box,color=red];
		j4248648837 -> j2866740928;
	j1877034935 [label="Sí. Pero ahora que lo pienso, creo que deberíamos dejarlo así. [Terminar la relación]",shape=box,color=red];
		j1877034935 -> j3483414308;
	j2866740928 [label="Cariño, ¿de verdad crees que he pasado tantos años en el ejército y no he visto prácticamente todo los tipos de relaciones que existen?",shape=box,color=blue];
		j2866740928 -> j1728871349;
	j3483414308 [label="Si eso es lo que realmente quieres, entonces...",shape=box,color=blue];
		j3483414308 -> j3701883258;
	j1728871349 [label="Cuando pasas la mayor parte de tu vida al borde de la muerte, aprendes a apreciar lo que importa en la vida y lo que no.",shape=box,color=blue];
		j1728871349 -> j2489674469;
	j3701883258 [label="Boolean IsDating is now false.",color=orange];
		j3701883258 -> j913620630;
	j2489674469 [label="Dejas de pensar en los límites. Lo entiendo perfectamente.",shape=box,color=blue];
		j2489674469 -> j791700680;
	j913620630 [label="Boolean ArthurDating is now false.",color=orange];
		j913620630 -> "Chat ends.";
	j791700680 [label="La verdad es que significas mucho para mí. Y si esa persona es importante para ti, lo es también para mí.",shape=box,color=blue];
		j791700680 -> j543336323;
	j543336323 [label="Sólo... que no sea alguien del Hex. ¿De acuerdo? No creo poder soportarlo si se tratara de alguien de \"la familia\", por así decirlo.",shape=box,color=blue];
		j543336323 -> j4103151019;
	j4103151019 [label="El sólo pensarlo me daría pesadillas.",shape=box,color=blue];
		j4103151019 -> j1069707098;
		j4103151019 -> j295351671;
	j1069707098 [label="Ja, ja. Lo prometo.",shape=box,color=red];
		j1069707098 -> j764723024;
	j295351671 [label="Si sirve de algo, creo que te caería bien.",shape=box,color=red];
		j295351671 -> j4134804350;
	j764723024 [label="Gracias. Y espero conocer a esa persona algún día. Por... razones personales, claro.",shape=box,color=blue];
		j764723024 -> j3017067277;
	j4134804350 [label="Y espero conocer a esa persona algún día. Por... razones personales, claro.",shape=box,color=blue];
		j4134804350 -> j3017067277;
	j3017067277 [label="+20 Chemistry",color=orange];
		j3017067277 -> j209814853;
	j209814853 [label="Sólo... cuídate mucho, amor.",shape=box,color=blue];
		j209814853 -> j3652224286;
