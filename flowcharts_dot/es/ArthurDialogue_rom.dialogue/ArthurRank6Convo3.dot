		3371 -> 3374;
	3372 [label="¿Qué ideas tiene?",shape=box,color=red];
		3372 -> 3375;
	3373 [label="Me alegro de que estés haciendo amigos. lol. ",shape=box,color=red];
		3373 -> 3376;
	3374 [label="¿Qué? ¡No! Claro que no.",shape=box,color=blue];
		3374 -> 3377;
	3375 [label="Ideas fascinantes, sobre la cantidad de veces que el año se ha repetido.",shape=box,color=blue];
		3375 -> 3378;
	3376 [label="Supongo que es agradable tener cerca gente con la que hablar, con la que no he pasado tanto tiempo.",shape=box,color=blue];
		3376 -> 3379;
	3377 [label="Los Hex son mi familia. Mi equipo. Lo sabes.",shape=box,color=blue];
		3377 -> 3376;
	3378 [label="Cuántas veces he olvidado, o no, años pasados. Cómo ella vive... ¿fuera del tiempo? Y cómo nosotros no.",shape=box,color=blue];
		3378 -> 3380;
	3379 [label="No sé si eso tiene sentido. Los conozco, confío en ellos, pero no he pasado por *todo un infierno* con ellos.",shape=box,color=blue];
		3379 -> 3381;
	3380 [label="Y antes de que digas algo, no. No quiero saber. No tengo derecho a saber.",shape=box,color=blue];
		3380 -> 3382;
	3381 [label="Por eso a veces es más fácil sentarme y beber con ellos.",shape=box,color=blue];
		3381 -> 3383;
		3381 -> 3384;
		3381 -> 3385;
	3382 [label="Supongo que solo quiero decir: ya sea que lo hayas hecho o no, no importa. No te lo reprocharé.",shape=box,color=blue];
		3382 -> 3386;
	3383 [label="Yo nunca he tenido esa opción.",shape=box,color=red];
		3383 -> 3387;
	3384 [label="Sí. Lo entiendo.",shape=box,color=red];
		3384 -> 3388;
	3385 [label="También ayuda que algunos de ellos sean un poco mayores y tengan experiencia militar.",shape=box,color=red];
		3385 -> 3389;
	3386 [label="¿Esta situación en la que estamos? No es normal. Nosotros... es decir, los humanos... no estamos hechos para este tipo de cosas.",shape=box,color=blue];
		3386 -> 3390;
	3387 [label="Supongo que no.",shape=box,color=blue];
		3387 -> 3391;
	3388 [label="No hay tanta... carga. Tanta historia. Amir lo llamaría equipaje.",shape=box,color=blue];
		3388 -> 3391;
	3389 [label="Por Sol. Vaya que sí. Al principio no sabía qué pensar de los libertatianos. ¿Pero ahora? Me da gusto que estén aquí.",shape=box,color=blue];
		3389 -> 3391;
	3390 [label="No hay guías para esto. Sea lo que sea que decidas hacer, confío en que tienes buenas razones para hacerlo.",shape=box,color=blue];
		3390 -> 3392;
	3391 [label="Pero me hizo pensar.",shape=box,color=blue];
		3391 -> 3393;
		3391 -> 3394;
	3392 [label="Check boolean ArthurDating",color=orange];
		3392 -> 3396 [label=true,color=green];
		3392 -> 3395 [label=false,color=brown];
	3393 [label="Oh, no.",shape=box,color=red];
		3393 -> 3397;
	3394 [label="¿Sobre qué?",shape=box,color=red];
		3394 -> 3398;
	3396 [label="Te amo. ¿Y si lo olvido? ¿Y si eliges ir por otro camino? Está bien.",shape=box,color=blue];
		3396 -> 3400;
	3395 [label="Te confío mi vida. Y nada cambiará eso. Aunque lo olvide por un rato.",shape=box,color=blue];
		3395 -> 3399;
	3397 [label="Je. Escúchame. Esto se trata de ti.",shape=box,color=blue];
		3397 -> 3401;
	3398 [label="Sobre ti. ",shape=box,color=blue];
		3398 -> 3401;
	3400 [label="Antes de que vinieras aquí, no creo que hubiera podido aceptarlo. Habría tenido demasiado miedo de perderte. De perder esto.",shape=box,color=blue];
		3400 -> 3402;
	3399 [label="Antes de que vinieras aquí, no creo que hubiera podido aceptarlo. Habría tenido demasiado miedo de perder una parte de mí.",shape=box,color=blue];
		3399 -> 3402;
	3401 [label="Y sobre toda esta... línea temporal repetitiva. Y me puse a pensar en cuántos años 1999 no recuerdo.",shape=box,color=blue];
		3401 -> 3403;
		3401 -> 3404;
		3401 -> 3405;
	3402 [label="Me habría aferrado a eso como un hombre desesperado a un bote en el mar. Pero quizá ya he pasado por esto bastantes veces, o... quizá solo seas tú, no lo sé.",shape=box,color=blue];
		3402 -> 3406;
	3403 [label="Todo lo que te ha dicho la guitarra es mentira, te lo juro.",shape=box,color=red];
		3403 -> 3407;
	3404 [label="¿Estoy en problemas?",shape=box,color=red];
		3404 -> 3407;
	3405 [label="Yo... no creo que debamos hablar sobre esto, Arthur.",shape=box,color=red];
		3405 -> 3407;
	3406 [label="Esta felicidad que me has dado, esta paz, vale más en este momento que saber que podría durar para siempre.",shape=box,color=blue];
		3406 -> 3408;
	3407 [label="Espera un segundo, ¿quieres? Sabes que escribo más lento que tú.",shape=box,color=blue];
		3407 -> 3409;
	3408 [label="Si hay algo que aprendes en la vida como soldado es que todo es temporal.",shape=box,color=blue];
		3408 -> 3410;
	3409 [label="Lo que estoy tratando de decir es esto:",shape=box,color=blue];
		3409 -> 3411;
	3410 [label="Todo puede desaparecer en un segundo. Supongo que lo he aceptado. De una vez por todas.",shape=box,color=blue];
		3410 -> 3412;
	3411 [label="Si hiciste que yo o el resto del Hex olvidáramos nuestras interacciones pasadas... relájate, está bien.",shape=box,color=blue];
		3411 -> 3413;
	3412 [label="Entonces, ¿nuestro tiempo juntos se acaba porque golpeas el suelo y me olvido de todo?",shape=box,color=blue];
		3412 -> 3414;
	3413 [label="No te lo voy a reprochar.",shape=box,color=blue];
		3413 -> 3386;
	3414 [label="¿O porque la Indiferencia te atrapa algún día?",shape=box,color=blue];
		3414 -> 3415;
	3415 [label="Voy a disfrutar este momento. Aquí y ahora. Porque es lo que tengo.",shape=box,color=blue];
		3415 -> 3416;
	3416 [label="Y sé que es de lo que puedo estar seguro.",shape=box,color=blue];
		3416 -> 3417;
		3416 -> 3418;
		3416 -> 3419;
	3417 [label="No es nada personal. Es principalmente porque sigo cometiendo errores al intentar salir con tu hermana. :P",shape=box,color=red];
		3417 -> 3420;
	3418 [label="Gracias, Arthur... eso significa más para mí de lo que creo poder expresar.",shape=box,color=red];
		3418 -> 3421;
	3419 [label="Desearía poder pensar como tú, a veces. <3",shape=box,color=red];
		3419 -> 3422;
	3420 [label="Ja, ja. Bueno, menos mal que tienes un superpoder mágico que te permite arreglarlo todo si lo arruinas espectacularmente, ¿no?",shape=box,color=blue];
		3420 -> 3423;
	3421 [label="De vez en cuando intento relajarme lo suficiente para poder decir algo significativo.",shape=box,color=blue];
		3421 -> 3424;
	3422 [label="Es más bien porque sé que, funcionalmente, no tengo otra opción que mantener la compostura. Así es el estilo británico. ",shape=box,color=blue];
		3422 -> 3425;
	3423 [label="Los demás solo tenemos que aprender a comunicarnos. Pero tengo una pregunta.",shape=box,color=blue];
		3423 -> 3426;
	3424 [label="Bueno, creo que es hora de ir a tomar algo. ¿Vamos?",shape=box,color=blue];
		3424 -> 3427;
		3424 -> 3428;
	3425 [label="Como dice el viejo refrán: \"Mantén la calma y sigue adelante\".",shape=box,color=blue];
