		3367 -> 3368;
	3368 [label="Pensé que debería ir a presentarme formalmente.",shape=box,color=blue];
		3368 -> 3369;
	3369 [label="Tiene muchísimas ideas útiles. Y Flare es adorable. Sinceramente, todo ese grupo en el bar es una bocanada de aire fresco. ",shape=box,color=blue];
		3369 -> 3370;
	3370 [label="Bueno. No es que tenga nada en contra de los demás.",shape=box,color=blue];
