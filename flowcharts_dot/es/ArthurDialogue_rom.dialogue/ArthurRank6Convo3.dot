digraph {
	graph [fontname="Roboto Condensed"];
	node [fontname="Roboto Condensed"];
	edge [fontname="Roboto Condensed"];

	"ArthurRank6Convo3 begins." [color=orange];
		"ArthurRank6Convo3 begins." -> j1369020020;
	j1369020020 [label="El otro día tuve una conversación con la guitarra.",shape=box,color=blue];
		j1369020020 -> j3282536381;
		j1369020020 -> j465566409;
	j3282536381 [label="Personalmente, no soy un gran fan.",shape=box,color=red];
		j3282536381 -> j328662373;
	j465566409 [label="¿Lizzie? ¿Cómo te fue?",shape=box,color=red];
		j465566409 -> j1166174347;
	j328662373 [label="Sinceramente, me cae bien. Una vez que ignoras su lado... raro...",shape=box,color=blue];
		j328662373 -> j939065167;
	j1166174347 [label="Mejor de lo que pensaba. Me agrada bastante.",shape=box,color=blue];
		j1166174347 -> j939065167;
	j939065167 [label="Además,",shape=box,color=blue];
		j939065167 -> j3421733409;
	j3421733409 [label="Ya que ella y Eleanor parecen estar siempre riéndose de chistes que nadie más puede oír.",shape=box,color=blue];
		j3421733409 -> j2843668539;
	j2843668539 [label="Pensé que debería ir a presentarme formalmente.",shape=box,color=blue];
		j2843668539 -> j1829964091;
	j1829964091 [label="Tiene muchísimas ideas útiles. Y Flare es adorable. Sinceramente, todo ese grupo en el bar es una bocanada de aire fresco. ",shape=box,color=blue];
		j1829964091 -> j3656125476;
	j3656125476 [label="Bueno. No es que tenga nada en contra de los demás.",shape=box,color=blue];
		j3656125476 -> j1973363098;
		j3656125476 -> j3830243954;
		j3656125476 -> j2150268427;
	j1973363098 [label="¿Ya estás harto del Hex?",shape=box,color=red];
		j1973363098 -> j1795291343;
	j3830243954 [label="¿Qué ideas tiene?",shape=box,color=red];
		j3830243954 -> j3341120443;
	j2150268427 [label="Me alegro de que estés haciendo amigos. lol. ",shape=box,color=red];
		j2150268427 -> j1454068590;
	j1795291343 [label="¿Qué? ¡No! Claro que no.",shape=box,color=blue];
		j1795291343 -> j1644537619;
	j3341120443 [label="Ideas fascinantes, sobre la cantidad de veces que el año se ha repetido.",shape=box,color=blue];
		j3341120443 -> j3703566418;
	j1454068590 [label="Supongo que es agradable tener cerca gente con la que hablar, con la que no he pasado tanto tiempo.",shape=box,color=blue];
		j1454068590 -> j3016812486;
	j1644537619 [label="Los Hex son mi familia. Mi equipo. Lo sabes.",shape=box,color=blue];
		j1644537619 -> j1454068590;
	j3703566418 [label="Cuántas veces he olvidado, o no, años pasados. Cómo ella vive... ¿fuera del tiempo? Y cómo nosotros no.",shape=box,color=blue];
		j3703566418 -> j428612030;
	j3016812486 [label="No sé si eso tiene sentido. Los conozco, confío en ellos, pero no he pasado por *todo un infierno* con ellos.",shape=box,color=blue];
		j3016812486 -> j2075013629;
	j428612030 [label="Y antes de que digas algo, no. No quiero saber. No tengo derecho a saber.",shape=box,color=blue];
		j428612030 -> j1096141249;
	j2075013629 [label="Por eso a veces es más fácil sentarme y beber con ellos.",shape=box,color=blue];
		j2075013629 -> j2022278932;
		j2075013629 -> j1653347573;
		j2075013629 -> j4102508586;
	j1096141249 [label="Supongo que solo quiero decir: ya sea que lo hayas hecho o no, no importa. No te lo reprocharé.",shape=box,color=blue];
		j1096141249 -> j1727462660;
	j2022278932 [label="Yo nunca he tenido esa opción.",shape=box,color=red];
		j2022278932 -> j3241011105;
	j1653347573 [label="Sí. Lo entiendo.",shape=box,color=red];
		j1653347573 -> j950333366;
	j4102508586 [label="También ayuda que algunos de ellos sean un poco mayores y tengan experiencia militar.",shape=box,color=red];
		j4102508586 -> j824614010;
	j1727462660 [label="¿Esta situación en la que estamos? No es normal. Nosotros... es decir, los humanos... no estamos hechos para este tipo de cosas.",shape=box,color=blue];
		j1727462660 -> j2681776630;
	j3241011105 [label="Supongo que no.",shape=box,color=blue];
		j3241011105 -> j3975403210;
	j950333366 [label="No hay tanta... carga. Tanta historia. Amir lo llamaría equipaje.",shape=box,color=blue];
		j950333366 -> j3975403210;
	j824614010 [label="Por Sol. Vaya que sí. Al principio no sabía qué pensar de los libertatianos. ¿Pero ahora? Me da gusto que estén aquí.",shape=box,color=blue];
		j824614010 -> j3975403210;
	j2681776630 [label="No hay guías para esto. Sea lo que sea que decidas hacer, confío en que tienes buenas razones para hacerlo.",shape=box,color=blue];
		j2681776630 -> j2674809731;
	j3975403210 [label="Pero me hizo pensar.",shape=box,color=blue];
		j3975403210 -> j2255019928;
		j3975403210 -> j1962383990;
	j2674809731 [label="Check boolean ArthurDating",color=orange];
		j2674809731 -> j4065434779 [label=true,color=green];
		j2674809731 -> j4170330374 [label=false,color=brown];
	j2255019928 [label="Oh, no.",shape=box,color=red];
		j2255019928 -> j486826522;
	j1962383990 [label="¿Sobre qué?",shape=box,color=red];
		j1962383990 -> j1618926723;
	j4065434779 [label="Te amo. ¿Y si lo olvido? ¿Y si eliges ir por otro camino? Está bien.",shape=box,color=blue];
		j4065434779 -> j2035869355;
	j4170330374 [label="Te confío mi vida. Y nada cambiará eso. Aunque lo olvide por un rato.",shape=box,color=blue];
		j4170330374 -> j1125445635;
	j486826522 [label="Je. Escúchame. Esto se trata de ti.",shape=box,color=blue];
		j486826522 -> j1842680563;
	j1618926723 [label="Sobre ti. ",shape=box,color=blue];
		j1618926723 -> j1842680563;
	j2035869355 [label="Antes de que vinieras aquí, no creo que hubiera podido aceptarlo. Habría tenido demasiado miedo de perderte. De perder esto.",shape=box,color=blue];
		j2035869355 -> j1797690172;
	j1125445635 [label="Antes de que vinieras aquí, no creo que hubiera podido aceptarlo. Habría tenido demasiado miedo de perder una parte de mí.",shape=box,color=blue];
		j1125445635 -> j1797690172;
	j1842680563 [label="Y sobre toda esta... línea temporal repetitiva. Y me puse a pensar en cuántos años 1999 no recuerdo.",shape=box,color=blue];
		j1842680563 -> j529328990;
		j1842680563 -> j1341020640;
		j1842680563 -> j4200172923;
	j1797690172 [label="Me habría aferrado a eso como un hombre desesperado a un bote en el mar. Pero quizá ya he pasado por esto bastantes veces, o... quizá solo seas tú, no lo sé.",shape=box,color=blue];
		j1797690172 -> j2666680862;
	j529328990 [label="Todo lo que te ha dicho la guitarra es mentira, te lo juro.",shape=box,color=red];
		j529328990 -> j3563771587;
	j1341020640 [label="¿Estoy en problemas?",shape=box,color=red];
		j1341020640 -> j3563771587;
	j4200172923 [label="Yo... no creo que debamos hablar sobre esto, Arthur.",shape=box,color=red];
		j4200172923 -> j3563771587;
	j2666680862 [label="Esta felicidad que me has dado, esta paz, vale más en este momento que saber que podría durar para siempre.",shape=box,color=blue];
		j2666680862 -> j1185561870;
	j3563771587 [label="Espera un segundo, ¿quieres? Sabes que escribo más lento que tú.",shape=box,color=blue];
		j3563771587 -> j424317332;
	j1185561870 [label="Si hay algo que aprendes en la vida como soldado es que todo es temporal.",shape=box,color=blue];
		j1185561870 -> j2180967949;
	j424317332 [label="Lo que estoy tratando de decir es esto:",shape=box,color=blue];
		j424317332 -> j3291773441;
	j2180967949 [label="Todo puede desaparecer en un segundo. Supongo que lo he aceptado. De una vez por todas.",shape=box,color=blue];
		j2180967949 -> j4114536336;
	j3291773441 [label="Si hiciste que yo o el resto del Hex olvidáramos nuestras interacciones pasadas... relájate, está bien.",shape=box,color=blue];
		j3291773441 -> j3286856675;
	j4114536336 [label="Entonces, ¿nuestro tiempo juntos se acaba porque golpeas el suelo y me olvido de todo?",shape=box,color=blue];
		j4114536336 -> j1063238195;
	j3286856675 [label="No te lo voy a reprochar.",shape=box,color=blue];
		j3286856675 -> j1727462660;
	j1063238195 [label="¿O porque la Indiferencia te atrapa algún día?",shape=box,color=blue];
		j1063238195 -> j4004222959;
	j4004222959 [label="Voy a disfrutar este momento. Aquí y ahora. Porque es lo que tengo.",shape=box,color=blue];
		j4004222959 -> j2432636542;
	j2432636542 [label="Y sé que es de lo que puedo estar seguro.",shape=box,color=blue];
		j2432636542 -> j802716511;
		j2432636542 -> j3577708457;
		j2432636542 -> j1443111162;
	j802716511 [label="No es nada personal. Es principalmente porque sigo cometiendo errores al intentar salir con tu hermana. :P",shape=box,color=red];
		j802716511 -> j4163286714;
	j3577708457 [label="Gracias, Arthur... eso significa más para mí de lo que creo poder expresar.",shape=box,color=red];
		j3577708457 -> j588941387;
	j1443111162 [label="Desearía poder pensar como tú, a veces. <3",shape=box,color=red];
		j1443111162 -> j2647712;
	j4163286714 [label="Ja, ja. Bueno, menos mal que tienes un superpoder mágico que te permite arreglarlo todo si lo arruinas espectacularmente, ¿no?",shape=box,color=blue];
		j4163286714 -> j2690626487;
	j588941387 [label="De vez en cuando intento relajarme lo suficiente para poder decir algo significativo.",shape=box,color=blue];
		j588941387 -> j1641743054;
	j2647712 [label="Es más bien porque sé que, funcionalmente, no tengo otra opción que mantener la compostura. Así es el estilo británico. ",shape=box,color=blue];
		j2647712 -> j4182288621;
	j2690626487 [label="Los demás solo tenemos que aprender a comunicarnos. Pero tengo una pregunta.",shape=box,color=blue];
		j2690626487 -> j779607165;
	j1641743054 [label="Bueno, creo que es hora de ir a tomar algo. ¿Vamos?",shape=box,color=blue];
		j1641743054 -> j2512923587;
		j1641743054 -> j1305971514;
	j4182288621 [label="Como dice el viejo refrán: \"Mantén la calma y sigue adelante\".",shape=box,color=blue];
		j4182288621 -> j1641743054;
	j779607165 [label="¿Ella baja sus estándares con cada reinicio?",shape=box,color=blue];
		j779607165 -> "Chat ends.";
	j2512923587 [label="Quizás más tarde.",shape=box,color=red];
		j2512923587 -> j2204079508;
	j1305971514 [label="Nos vemos allí. :)",shape=box,color=red];
		j1305971514 -> "Chat ends.";
	"Chat ends." [color=orange];
	j2204079508 [label="Como quieras.",shape=box,color=blue];
		j2204079508 -> "Chat ends.";
}