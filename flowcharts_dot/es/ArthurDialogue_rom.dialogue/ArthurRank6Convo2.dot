digraph {
	"ArthurRank6Convo2 begins." [color=orange];
		"ArthurRank6Convo2 begins." -> j3864178492;
	j3864178492 [label="He estado pensando... ¿cuántos más de nosotros crees que hay?",shape=box,color=blue];
		j3864178492 -> j2715449496;
		j3864178492 -> j3344149150;
	j2715449496 [label="¿Te refieres aquí en 1999 o en un sentido más amplio?",shape=box,color=red];
		j2715449496 -> j2188431561;
	j3344149150 [label="¿A qué te refieres con \"nosotros\"?",shape=box,color=red];
		j3344149150 -> j4051265852;
	j2188431561 [label="Ambos, supongo. Aquí, ahora, en el pasado... en el futuro.",shape=box,color=blue];
		j2188431561 -> j461539443;
	j4051265852 [label="Protoframes. Aquí o donde sea. O en cualquier momento, supongo.",shape=box,color=blue];
		j4051265852 -> j461539443;
	j461539443 [label="Entrati nos creó con un propósito. Con múltiples propósitos. Está claro que no se limitó a nosotros seis. ",shape=box,color=blue];
		j461539443 -> j2437268203;
		j461539443 -> j2835917132;
	j2437268203 [label="Al principio, pensé que me estaba haciendo warframes \"de repuesto\" por si los míos no llegaban a través del Helminto. Ahora, ya no tengo tanta certeza.",shape=box,color=red];
		j2437268203 -> j389593246;
	j2835917132 [label="Desearía saber qué tramaba. O cuáles eran sus verdaderas motivaciones para crear más protoframes.",shape=box,color=red];
		j2835917132 -> j3718707382;
	j389593246 [label="Tenía sentido cuando éramos sólo seis.",shape=box,color=blue];
		j389593246 -> j3718707382;
	j3718707382 [label="¿De verdad crees que su verdadera motivación es detener la Indiferencia?",shape=box,color=blue];
		j3718707382 -> j4267482913;
	j4267482913 [label="¿Podemos *realmente* confiar en él?",shape=box,color=blue];
		j4267482913 -> j2166453176;
		j4267482913 -> j3790654066;
		j4267482913 -> j32654626;
	j2166453176 [label="No lo sé, honestamente. No pondría mis manos al fuego por él. Además, sin un warframe, mis manos se queman rápido.",shape=box,color=red];
		j2166453176 -> j1990702923;
	j3790654066 [label="No. No podemos confiar en sus motivos más de lo que podemos confiar en sus métodos.",shape=box,color=red];
		j3790654066 -> j1942355289;
		j3790654066 -> j2573822027;
	j32654626 [label="Sí. No siempre estoy de acuerdo con sus métodos. Pero sí, quiere detener esa cosa.",shape=box,color=red];
		j32654626 -> j2573822027;
		j32654626 -> j1942355289;
	j1990702923 [label="+5 Chemistry",color=orange];
		j1990702923 -> j1309146000;
	j1942355289 [label="Está intentando volver a meter al genio en la botella, si es que se puede. Y es un proceso complicado.",shape=box,color=red];
		j1942355289 -> j498343272;
	j2573822027 [label="Pero no tenemos otra opción, ¿o sí? La niña y yo solo podemos seguirlo y limpiar sus desastres. ",shape=box,color=red];
		j2573822027 -> j2607094153;
		j2573822027 -> j3044037788;
	j1309146000 [label="Je.",shape=box,color=blue];
		j1309146000 -> j1942355289;
		j1309146000 -> j2573822027;
	j498343272 [label="Y nosotros somos los conserjes del colegio, barriendo los pisos para él. Adorable.",shape=box,color=blue];
		j498343272 -> j2607094153;
		j498343272 -> j3044037788;
	j2607094153 [label="Ahora que Kaya tiene su propia visión de los viajes en el tiempo, tal vez me resulte más fácil ir y venir.",shape=box,color=red];
		j2607094153 -> j2889202640;
	j3044037788 [label="Pero yo me quedo aquí, así que ahora todo depende de la niña.",shape=box,color=red];
		j3044037788 -> j161265069;
	j2889202640 [label="Esa niña a veces es una molestia pero agradezco su ayuda.",shape=box,color=blue];
		j2889202640 -> j2211268681;
	j161265069 [label="Check boolean ArthurDating",color=orange];
		j161265069 -> j525570795 [label=true,color=green];
		j161265069 -> j810874984 [label=false,color=brown];
	j2211268681 [label="Es bueno saber que cuando sales a trabajar... es posible que vuelvas... :/",shape=box,color=blue];
		j2211268681 -> j2613732724;
	j525570795 [label="Eh. Ya veremos. Te conozco bien, cariño. Y sé que no sabes cuándo mantenerte al margen.",shape=box,color=blue];
		j525570795 -> j380767519;
	j810874984 [label="Eh. Ya veremos. Te conozco bien, Viajero. Y sé que no sabes cuándo mantenerte al margen.",shape=box,color=blue];
		j810874984 -> j327415346;
	j2613732724 [label="Check boolean ArthurDating",color=orange];
		j2613732724 -> j33603917 [label=true,color=green];
		j2613732724 -> j1811598966 [label=false,color=brown];
		j2613732724 -> j3341516749 [label=false,color=brown];
	j380767519 [label="Es una de las razones por las que te adoro tanto. ;)",shape=box,color=blue];
		j380767519 -> j3341516749;
	j327415346 [label="Es una de las razones por las que tolero tenerte cerca. ;)",shape=box,color=blue];
		j327415346 -> j1811598966;
	j33603917 [label="Le debo mucho, me ha dado cierta paz mental. :)",shape=box,color=blue];
		j33603917 -> j1811598966;
		j33603917 -> j3341516749;
	j1811598966 [label="¡Un emoticono! :D",shape=box,color=red];
		j1811598966 -> j2785121969;
	j3341516749 [label="No te pongas sentimental conmigo. ",shape=box,color=red];
		j3341516749 -> j1363421610;
	j2785121969 [label="Sí, sí. No te acostumbres. Todavía se siente raro.",shape=box,color=blue];
		j2785121969 -> j4037391826;
	j1363421610 [label="Mm, ya me conoces. Crujiente por fuera, suavecito por dentro. Como una versión rancia de esos pastelillos horribles de los que hablan Amir y Velimir.",shape=box,color=blue];
		j1363421610 -> j3281640856;
	j4037391826 [label="Bueno, acepto el cumplido.",shape=box,color=red];
		j4037391826 -> j3210108666;
	j3281640856 [label="¿Tweebies?",shape=box,color=blue];
		j3281640856 -> j3210108666;
	j3210108666 [label="En fin. Volviendo al tema. A veces tengo la sensación de que Entrati tiene un propósito mayor para todos nosotros.",shape=box,color=blue];
		j3210108666 -> j2871537260;
		j3210108666 -> j4241857915;
		j3210108666 -> j1662934075;
	j2871537260 [label="¿Qué te hace decir eso?",shape=box,color=red];
		j2871537260 -> j3515573495;
	j4241857915 [label="Sí, puede que tengas razón.",shape=box,color=red];
		j4241857915 -> j3348908807;
	j1662934075 [label="¿Podría ser esto simplemente una ilusión?",shape=box,color=red];
		j1662934075 -> j348064258;
	j3515573495 [label="Todo el esfuerzo que ha dedicado a crearnos... Y el hecho de que haya más de seis...",shape=box,color=blue];
		j3515573495 -> j1816448558;
	j3348908807 [label="¿Cuál crees que sea? ¿Y qué está esperando?",shape=box,color=blue];
		j3348908807 -> j544964552;
		j3348908807 -> j3907091666;
	j348064258 [label="¿Qué quieres decir?",shape=box,color=blue];
		j348064258 -> j2564106833;
		j348064258 -> j3571552547;
	j1816448558 [label="No construyes armas como estas a menos que sepas que las vas a usar, camarada.",shape=box,color=blue];
		j1816448558 -> j2853835207;
	j544964552 [label="<RETRO_EMOJI_SHRUG>",shape=box,color=red];
		j544964552 -> j3446965821;
	j3907091666 [label="Ojalá supiera ambas respuestas.",shape=box,color=red];
		j3907091666 -> j3446965821;
	j2564106833 [label="A veces es difícil pensar que ya no eres \"importante\".",shape=box,color=red];
		j2564106833 -> j4177629670;
	j3571552547 [label="Bueno, sólo digo que... tal vez no quieras sentir que él te abandonó.",shape=box,color=red];
		j3571552547 -> j731470599;
	j2853835207 [label="A menos que *sepas* que va a haber una guerra.",shape=box,color=blue];
		j2853835207 -> j2920113617;
		j2853835207 -> j1746239373;
		j2853835207 -> j3272800401;
	j3446965821 [label="¿Tal vez necesite un ejército? Tal vez esté buscando \"lo único\" que cree que puede derrotar a la Indiferencia. Tal vez... muchas cosas.",shape=box,color=red];
		j3446965821 -> j1982243363;
	j4177629670 [label="Cierto...",shape=box,color=blue];
		j4177629670 -> "Chat ends.";
	j731470599 [label="Que por lo que haya estado aquí, lo que te haya hecho... aún importa. Que sigue siendo válido. Que no fue en vano.",shape=box,color=red];
		j731470599 -> j1233236516;
		j731470599 -> j3708344573;
	j2920113617 [label="Entonces todo lo que podemos hacer es estar preparados por si sucede.",shape=box,color=red];
		j2920113617 -> j1341682257;
	j1746239373 [label="Es posible. Pero Entrati también parece ser el tipo de persona que tiene planes de contingencia. ",shape=box,color=red];
		j1746239373 -> j1131935173;
	j3272800401 [label="No lo sé. Minerva y Velimir me hablaban de la... \"¿Guerra Fría?\". Parece que la gente construyó un montón de armas locas y luego nunca las usaron.",shape=box,color=red];
		j3272800401 -> j2905718240;
	j1982243363 [label="No puedo evitar pensar que somos balas en una pistola. Destinadas a ser usadas, gastadas y desechadas.",shape=box,color=blue];
		j1982243363 -> j2356499121;
		j1982243363 -> j2031623660;
	"Chat ends." [color=orange];
	j1233236516 [label="Y para que quede claro, tú aún importas.",shape=box,color=red];
		j1233236516 -> j4131996877;
		j1233236516 -> j2041374657;
		j1233236516 -> j183457527;
	j3708344573 [label="Y para que quede claro, tú aún eres importante para *mí*. ",shape=box,color=red];
		j3708344573 -> j4131996877;
		j3708344573 -> j2041374657;
		j3708344573 -> j183457527;
	j1341682257 [label="+5 Chemistry",color=orange];
		j1341682257 -> j3776442240;
	j1131935173 [label="Tal vez.",shape=box,color=blue];
		j1131935173 -> j3832409055;
	j2905718240 [label="Es un buen argumento. Pero eso es entre países, implica diplomacia. Hay factores que influyen.",shape=box,color=blue];
		j2905718240 -> j1515907912;
	j2356499121 [label="Ojalá pudiera decírtelo. Pero haré todo lo posible para evitar que pase.",shape=box,color=red];
		j2356499121 -> j27436742;
	j2031623660 [label="¿Crees que aún no has terminado?",shape=box,color=red];
		j2031623660 -> j284639595;
	j4131996877 [label="¿Pero pensar que tu historia termina aquí, sin tener un papel al final? Qué horror.",shape=box,color=red];
		j4131996877 -> j2696156537;
	j2041374657 [label="Pero quizá te duele pensar que has sido reemplazado por Arthur 2.0 en alguna parte.",shape=box,color=red];
		j2041374657 -> j3591194659;
	j183457527 [label="¿Pero tal vez solo quieres que tus sacrificios sigan importando en un sentido más cósmico?",shape=box,color=red];
		j183457527 -> j295679865;
	j3776442240 [label="De acuerdo.",shape=box,color=blue];
		j3776442240 -> j3754414686;
	j3832409055 [label="Una parte de mí espera que haya más gente como nosotros allá afuera. Pero si acaban viniendo, quizá necesitemos un centro comercial más grande.",shape=box,color=blue];
		j3832409055 -> "Chat ends.";
	j1515907912 [label="Esto es entre un dios y un hombre que cree serlo.",shape=box,color=blue];
		j1515907912 -> j973314524;
	j27436742 [label="Sé que lo harás. Y que afrontaremos ese día juntos, y confío en ello.",shape=box,color=blue];
		j27436742 -> j2397353713;
	j284639595 [label="No. Uno no construye armas como estas a menos que sepa que las va a usar, camarada.",shape=box,color=blue];
		j284639595 -> j883910719;
		j284639595 -> j1746239373;
		j284639595 -> j2920113617;
	j2696156537 [label="Eso podría ser parte de ello. ¿Si la indiferencia es la razón por la que soy así? ¿Y por la que tuve que pasar por esto?",shape=box,color=blue];
		j2696156537 -> j4047234920;
	j3591194659 [label="Camarada, estaba listo para jubilarme antes de que me involucraran en estas tonterías. Para nada.",shape=box,color=blue];
		j3591194659 -> j2763608178;
	j295679865 [label="Quizás. Quizás no. Pero ¿cuántos sacrificios de la gente no significan nada en la vida? La mayoría.",shape=box,color=blue];
		j295679865 -> j848631392;
	j3754414686 [label="Y espero que si más de nosotros aparecemos aquí, no necesitemos un centro comercial más grande.",shape=box,color=blue];
		j3754414686 -> "Chat ends.";
	j973314524 [label="Apuesto a que habrá un enfrentamiento inevitable. No creo que su ego les permita otra cosa.",shape=box,color=blue];
		j973314524 -> j984212200;
		j973314524 -> j3919565990;
	j2397353713 [label="+5 Chemistry",color=orange];
		j2397353713 -> j1648722223;
	j883910719 [label="No lo sé. Minerva y Velimir me hablaban de la... \"¿Guerra Fría?\". Parece que la gente construyó un montón de armas locas y luego nunca las usaron.",shape=box,color=red];
		j883910719 -> j176272951;
	j4047234920 [label="Quiero ayudar a destruirla.",shape=box,color=blue];
		j4047234920 -> j686343829;
