		3258 -> 3261;
	3259 [label="No te pongas sentimental conmigo. ",shape=box,color=red];
		3259 -> 3262;
	3261 [label="Sí, sí. No te acostumbres. Todavía se siente raro.",shape=box,color=blue];
		3261 -> 3263;
	3262 [label="Mm, ya me conoces. Crujiente por fuera, suavecito por dentro. Como una versión rancia de esos pastelillos horribles de los que hablan Amir y Velimir.",shape=box,color=blue];
		3262 -> 3264;
	3263 [label="Bueno, acepto el cumplido.",shape=box,color=red];
		3263 -> 3265;
	3264 [label="¿Tweebies?",shape=box,color=blue];
		3264 -> 3265;
	3265 [label="En fin. Volviendo al tema. A veces tengo la sensación de que Entrati tiene un propósito mayor para todos nosotros.",shape=box,color=blue];
		3265 -> 3266;
		3265 -> 3267;
		3265 -> 3268;
	3266 [label="¿Qué te hace decir eso?",shape=box,color=red];
