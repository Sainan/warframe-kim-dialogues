		3254 -> 3252 [label=false,color=brown];
	3253 [label="Es bueno saber que cuando sales a trabajar... es posible que vuelvas... :/",shape=box,color=blue];
		3253 -> 3255;
	3603 [label="Eh. Ya veremos. Te conozco bien, cariño. Y sé que no sabes cuándo mantenerte al margen.",shape=box,color=blue];
		3603 -> 3257;
	3252 [label="Eh. Ya veremos. Te conozco bien, Viajero. Y sé que no sabes cuándo mantenerte al margen.",shape=box,color=blue];
