		3255 -> 3259 [label=false,color=brown];
	3257 [label="Es una de las razones por las que te adoro tanto. ;)",shape=box,color=blue];
		3257 -> 3259;
	3256 [label="Es una de las razones por las que tolero tenerte cerca. ;)",shape=box,color=blue];
		3256 -> 3258;
	3260 [label="Le debo mucho, me ha dado cierta paz mental. :)",shape=box,color=blue];
		3260 -> 3258;
		3260 -> 3259;
