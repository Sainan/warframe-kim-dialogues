	3273 [label="<RETRO_EMOJI_SHRUG>",shape=box,color=red];
		3273 -> 3278;
	3274 [label="Ojalá supiera ambas respuestas.",shape=box,color=red];
		3274 -> 3278;
	3275 [label="A veces es difícil pensar que ya no eres \"importante\".",shape=box,color=red];
		3275 -> 3279;
	3276 [label="Bueno, sólo digo que... tal vez no quieras sentir que él te abandonó.",shape=box,color=red];
		3276 -> 3280;
	3277 [label="A menos que *sepas* que va a haber una guerra.",shape=box,color=blue];
		3277 -> 3281;
		3277 -> 3282;
		3277 -> 3283;
	3278 [label="¿Tal vez necesite un ejército? Tal vez esté buscando \"lo único\" que cree que puede derrotar a la Indiferencia. Tal vez... muchas cosas.",shape=box,color=red];
		3278 -> 3284;
	3279 [label="Cierto...",shape=box,color=blue];
		3279 -> 3285;
	3280 [label="Que por lo que haya estado aquí, lo que te haya hecho... aún importa. Que sigue siendo válido. Que no fue en vano.",shape=box,color=red];
		3280 -> 3286;
		3280 -> 3287;
	3281 [label="Entonces todo lo que podemos hacer es estar preparados por si sucede.",shape=box,color=red];
		3281 -> 3288;
	3282 [label="Es posible. Pero Entrati también parece ser el tipo de persona que tiene planes de contingencia. ",shape=box,color=red];
		3282 -> 3289;
	3283 [label="No lo sé. Minerva y Velimir me hablaban de la... \"¿Guerra Fría?\". Parece que la gente construyó un montón de armas locas y luego nunca las usaron.",shape=box,color=red];
		3283 -> 3290;
	3284 [label="No puedo evitar pensar que somos balas en una pistola. Destinadas a ser usadas, gastadas y desechadas.",shape=box,color=blue];
		3284 -> 3291;
		3284 -> 3292;
	3285 [label="Chat ends.",color=orange];
	3286 [label="Y para que quede claro, tú aún importas.",shape=box,color=red];
