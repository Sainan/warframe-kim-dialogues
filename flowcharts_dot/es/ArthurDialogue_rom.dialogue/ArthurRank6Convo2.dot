		3267 -> 3270;
	3268 [label="¿Podría ser esto simplemente una ilusión?",shape=box,color=red];
		3268 -> 3271;
	3269 [label="Todo el esfuerzo que ha dedicado a crearnos... Y el hecho de que haya más de seis...",shape=box,color=blue];
		3269 -> 3272;
	3270 [label="¿Cuál crees que sea? ¿Y qué está esperando?",shape=box,color=blue];
