digraph {
	3229 [label="ArthurRank6Convo2 begins.",color=orange];
		3229 -> 3230;
	3230 [label="He estado pensando... ¿cuántos más de nosotros crees que hay?",shape=box,color=blue];
		3230 -> 3231;
		3230 -> 3232;
	3231 [label="¿Te refieres aquí en 1999 o en un sentido más amplio?",shape=box,color=red];
		3231 -> 3233;
	3232 [label="¿A qué te refieres con \"nosotros\"?",shape=box,color=red];
		3232 -> 3234;
	3233 [label="Ambos, supongo. Aquí, ahora, en el pasado... en el futuro.",shape=box,color=blue];
		3233 -> 3235;
	3234 [label="Protoframes. Aquí o donde sea. O en cualquier momento, supongo.",shape=box,color=blue];
		3234 -> 3235;
	3235 [label="Entrati nos creó con un propósito. Con múltiples propósitos. Está claro que no se limitó a nosotros seis. ",shape=box,color=blue];
		3235 -> 3236;
		3235 -> 3237;
	3236 [label="Al principio, pensé que me estaba haciendo warframes \"de repuesto\" por si los míos no llegaban a través del Helminto. Ahora, ya no tengo tanta certeza.",shape=box,color=red];
		3236 -> 3238;
	3237 [label="Desearía saber qué tramaba. O cuáles eran sus verdaderas motivaciones para crear más protoframes.",shape=box,color=red];
		3237 -> 3239;
	3238 [label="Tenía sentido cuando éramos sólo seis.",shape=box,color=blue];
		3238 -> 3239;
	3239 [label="¿De verdad crees que su verdadera motivación es detener la Indiferencia?",shape=box,color=blue];
		3239 -> 3240;
	3240 [label="¿Podemos *realmente* confiar en él?",shape=box,color=blue];
		3240 -> 3241;
		3240 -> 3242;
		3240 -> 3243;
	3241 [label="No lo sé, honestamente. No pondría mis manos al fuego por él. Además, sin un warframe, mis manos se queman rápido.",shape=box,color=red];
		3241 -> 3244;
	3242 [label="No. No podemos confiar en sus motivos más de lo que podemos confiar en sus métodos.",shape=box,color=red];
		3242 -> 3245;
		3242 -> 3246;
	3243 [label="Sí. No siempre estoy de acuerdo con sus métodos. Pero sí, quiere detener esa cosa.",shape=box,color=red];
		3243 -> 3246;
		3243 -> 3245;
	3244 [label="+5 Chemistry",color=orange];
		3244 -> 3247;
	3245 [label="Está intentando volver a meter al genio en la botella, si es que se puede. Y es un proceso complicado.",shape=box,color=red];
		3245 -> 3248;
	3246 [label="Pero no tenemos otra opción, ¿o sí? La niña y yo solo podemos seguirlo y limpiar sus desastres. ",shape=box,color=red];
		3246 -> 3249;
		3246 -> 3250;
	3247 [label="Je.",shape=box,color=blue];
		3247 -> 3245;
		3247 -> 3246;
	3248 [label="Y nosotros somos los conserjes del colegio, barriendo los pisos para él. Adorable.",shape=box,color=blue];
		3248 -> 3249;
		3248 -> 3250;
	3249 [label="Ahora que Kaya tiene su propia visión de los viajes en el tiempo, tal vez me resulte más fácil ir y venir.",shape=box,color=red];
		3249 -> 3251;
	3250 [label="Pero yo me quedo aquí, así que ahora todo depende de la niña.",shape=box,color=red];
		3250 -> 3254;
	3251 [label="Esa niña a veces es una molestia pero agradezco su ayuda.",shape=box,color=blue];
		3251 -> 3253;
