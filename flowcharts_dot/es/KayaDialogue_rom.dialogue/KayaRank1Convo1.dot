digraph {
	"KayaRank1Convo1 begins." [color=orange];
		"KayaRank1Convo1 begins." -> j2051470252;
	j2051470252 [label="Hola. ¿Todos pueden viajar en el tiempo o sólo tú?",shape=box,color=blue];
		j2051470252 -> j3087547217;
		j2051470252 -> j3272932381;
	j3087547217 [label="Buen día para ti también. Mira, niña, no es tan simple.",shape=box,color=red];
		j3087547217 -> j1564041939;
	j3272932381 [label="Hola, ¿Kaya, verdad? ¿Cómo va tu día?",shape=box,color=red];
		j3272932381 -> j792986950;
	j1564041939 [label="No soy una niña. Tengo 19.",shape=box,color=blue];
		j1564041939 -> j3257773376;
		j1564041939 -> j853104180;
	j792986950 [label="Bien. ",shape=box,color=blue];
		j792986950 -> j3330147279;
	j3257773376 [label="Cierto. Pero eres la más joven de este nuevo grupo, así que, niña.",shape=box,color=red];
		j3257773376 -> j2722902532;
	j853104180 [label="Sí, sí, bueno, pero no te apresures con eso de viajar en el tiempo. Es... complicado.",shape=box,color=red];
		j853104180 -> j483428811;
	j3330147279 [label="Entonces, ¿sólo tú? ¿Hay otros? ¿En las escuelas del futuro te enseñan a viajar en el tiempo?",shape=box,color=blue];
		j3330147279 -> j488101241;
	j2722902532 [label="Ugh. Bueno, sí, la más joven, pero también la más decidida a hacer algo para encontrar respuestas. Trata de seguirme el ritmo. Así que: viajar en el tiempo. ¿Cómo y quién?",shape=box,color=blue];
		j2722902532 -> j3027041700;
	j483428811 [label="Ugh. ¿Qué tan complicado? ¿Fórmulas? ¿Elementos químicos y atómicos? Yo puedo resolverlo. Sólo indícame una dirección.",shape=box,color=blue];
		j483428811 -> j2746225868;
		j483428811 -> j1090353911;
	j488101241 [label="Digamos que sólo soy yo. Así es más sencillo.",shape=box,color=red];
		j488101241 -> j1057341298;
	j3027041700 [label="¿Y por qué tú? ¿Tienes un plan? ",shape=box,color=blue];
		j3027041700 -> j4202732233;
	j2746225868 [label="No sé muy bien qué decirte. No es un tema exclusivo de la ciencia, o si lo es, es una ciencia que Entrati conoce.",shape=box,color=red];
		j2746225868 -> j4224396351;
	j1090353911 [label="Aquí hay una dirección: Para. [Fin]",shape=box,color=red];
		j1090353911 -> j2547432773;
	j1057341298 [label="En cuanto a si lo enseñan en las escuelas, de ser así, no lo estudié. Pero, ¿puede ser? ",shape=box,color=red];
		j1057341298 -> j273876357;
	j4202732233 [label="Y si no, ¿qué me recomiendas para poder obtener fuentes científicas sobre tus habilidades?",shape=box,color=blue];
		j4202732233 -> j234591211;
	j4224396351 [label="Ugh, ese bastardo. Sabía que debería haberle hecho más preguntas. Ok. Al menos, si es ciencia, significa que puedo reproducirla y, como puedes ir y venir, puedo averiguarlo. Adiós.",shape=box,color=blue];
		j4224396351 -> j2547432773;
	j2547432773 [label="+20 Chemistry",color=orange];
		j2547432773 -> "Initiate conversation HexKayaConvo1 in HexDialogue_rom.dialogue";
	j273876357 [label="¿Por qué? ¿Quieres tener tarea? Los viajes en el tiempo probablemente sean demasiado avanzados por ahora...",shape=box,color=red];
		j273876357 -> j1470840600;
	j234591211 [label="Son muchas preguntas, niña. Lamento decírtelo, pero no lo sé. Sólo Entrati tiene las respuestas.",shape=box,color=red];
		j234591211 -> j2507192691;
	"Initiate conversation HexKayaConvo1 in HexDialogue_rom.dialogue" [label="Queue conversation HexKayaConvo1 in HexDialogue_rom.dialogue",color=orange];
		"Initiate conversation HexKayaConvo1 in HexDialogue_rom.dialogue" -> "Chat ends. Next chat will be KayaRank1Convo2.";
	j1470840600 [label="Ugh, ¿es en serio?",shape=box,color=blue];
		j1470840600 -> j4201724503;
	j2507192691 [label="Boolean KayaSetKid is now true.",color=orange];
		j2507192691 -> j216897697;
	"Chat ends. Next chat will be KayaRank1Convo2." [color=orange];
	j4201724503 [label="¿Alguien del Hex sabe cómo? ¿Tienen alguna información? ",shape=box,color=blue];
		j4201724503 -> j297856287;
		j4201724503 -> j2294281405;
	j216897697 [label="K.",shape=box,color=blue];
		j216897697 -> j2547432773;
	j297856287 [label="¿Tal vez Amir? Probablemente conoce juegos con historias de viajes en el tiempo...",shape=box,color=red];
		j297856287 -> j183489854;
	j2294281405 [label="No lo creo, niña. Pero si quieres aprender algo útil, pídele a Lettie que te dé una lección básica sobre hacer curaciones.",shape=box,color=red];
		j2294281405 -> j4051136678;
	j183489854 [label="Boolean KayaAmirTravel is now true.",color=orange];
		j183489854 -> j747047508;
	j4051136678 [label="Boolean KayaLettieHeal is now true.",color=orange];
		j4051136678 -> j3421222938;
	j747047508 [label="¿Juegos? Sólo necesito respuestas, una dirección, cualquier cosa. Lo averiguaré. Si se te ocurre algo ÚTIL, búscame.",shape=box,color=blue];
