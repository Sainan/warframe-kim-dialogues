digraph {
	0 [label="KayaRank1Convo1 begins.",color=orange];
		0 -> 1;
	1 [label="Hola. ¿Todos pueden viajar en el tiempo o sólo tú?",shape=box,color=blue];
		1 -> 2;
		1 -> 3;
	2 [label="Buen día para ti también. Mira, niña, no es tan simple.",shape=box,color=red];
		2 -> 4;
	3 [label="Hola, ¿Kaya, verdad? ¿Cómo va tu día?",shape=box,color=red];
		3 -> 5;
	4 [label="No soy una niña. Tengo 19.",shape=box,color=blue];
		4 -> 6;
		4 -> 7;
	5 [label="Bien. ",shape=box,color=blue];
		5 -> 8;
	6 [label="Cierto. Pero eres la más joven de este nuevo grupo, así que, niña.",shape=box,color=red];
		6 -> 9;
	7 [label="Sí, sí, bueno, pero no te apresures con eso de viajar en el tiempo. Es... complicado.",shape=box,color=red];
		7 -> 10;
	8 [label="Entonces, ¿sólo tú? ¿Hay otros? ¿En las escuelas del futuro te enseñan a viajar en el tiempo?",shape=box,color=blue];
		8 -> 11;
	9 [label="Ugh. Bueno, sí, la más joven, pero también la más decidida a hacer algo para encontrar respuestas. Trata de seguirme el ritmo. Así que: viajar en el tiempo. ¿Cómo y quién?",shape=box,color=blue];
		9 -> 12;
	10 [label="Ugh. ¿Qué tan complicado? ¿Fórmulas? ¿Elementos químicos y atómicos? Yo puedo resolverlo. Sólo indícame una dirección.",shape=box,color=blue];
		10 -> 13;
		10 -> 14;
	11 [label="Digamos que sólo soy yo. Así es más sencillo.",shape=box,color=red];
		11 -> 15;
	12 [label="¿Y por qué tú? ¿Tienes un plan? ",shape=box,color=blue];
		12 -> 16;
	13 [label="No sé muy bien qué decirte. No es un tema exclusivo de la ciencia, o si lo es, es una ciencia que Entrati conoce.",shape=box,color=red];
		13 -> 17;
	14 [label="Aquí hay una dirección: Para. [Fin]",shape=box,color=red];
		14 -> 1022;
	15 [label="En cuanto a si lo enseñan en las escuelas, de ser así, no lo estudié. Pero, ¿puede ser? ",shape=box,color=red];
		15 -> 18;
	16 [label="Y si no, ¿qué me recomiendas para poder obtener fuentes científicas sobre tus habilidades?",shape=box,color=blue];
		16 -> 19;
	17 [label="Ugh, ese bastardo. Sabía que debería haberle hecho más preguntas. Ok. Al menos, si es ciencia, significa que puedo reproducirla y, como puedes ir y venir, puedo averiguarlo. Adiós.",shape=box,color=blue];
		17 -> 20;
	1022 [label="+20 Chemistry",color=orange];
		1022 -> 1018;
	18 [label="¿Por qué? ¿Quieres tener tarea? Los viajes en el tiempo probablemente sean demasiado avanzados por ahora...",shape=box,color=red];
		18 -> 21;
	19 [label="Son muchas preguntas, niña. Lamento decírtelo, pero no lo sé. Sólo Entrati tiene las respuestas.",shape=box,color=red];
		19 -> 22;
	20 [label="+20 Chemistry",color=orange];
		20 -> 1015;
	1018 [label="{\"Id\":1018,\"Incoming\":[1022],\"Outgoing\":[1023],\"GraphPos\":[3236,718],\"CompletionType\":2,\"OtherDialogueInfos\":[{\"Dialogue\":\"/Lotus/Types/Gameplay/1999Wf/Dialogue/HexDialogue_rom.dialogue\",\"Tag\":\"HexKayaConvo1\",\"Value\":0}]}",color=orange];
		1018 -> 1023;
	21 [label="Ugh, ¿es en serio?",shape=box,color=blue];
		21 -> 24;
	22 [label="Update boolean KayaSetKid",color=orange];
		22 -> 25;
	1015 [label="{\"Id\":1015,\"Incoming\":[20],\"Outgoing\":[23],\"GraphPos\":[3252,817],\"CompletionType\":2,\"OtherDialogueInfos\":[{\"Dialogue\":\"/Lotus/Types/Gameplay/1999Wf/Dialogue/HexDialogue_rom.dialogue\",\"Tag\":\"HexKayaConvo1\",\"Value\":0}]}",color=orange];
		1015 -> 23;
	1023 [label="Chat ends. Next chat will be KayaRank1Convo2.",color=orange];
	24 [label="¿Alguien del Hex sabe cómo? ¿Tienen alguna información? ",shape=box,color=blue];
		24 -> 26;
		24 -> 27;
	25 [label="K.",shape=box,color=blue];
		25 -> 28;
	23 [label="Chat ends. Next chat will be KayaRank1Convo2.",color=orange];
	26 [label="¿Tal vez Amir? Probablemente conoce juegos con historias de viajes en el tiempo...",shape=box,color=red];
		26 -> 29;
	27 [label="No lo creo, niña. Pero si quieres aprender algo útil, pídele a Lettie que te dé una lección básica sobre hacer curaciones.",shape=box,color=red];
		27 -> 30;
	28 [label="+20 Chemistry",color=orange];
		28 -> 996;
	29 [label="Update boolean KayaAmirTravel",color=orange];
		29 -> 32;
	30 [label="Update boolean KayaLettieHeal",color=orange];
		30 -> 33;
	996 [label="{\"Id\":996,\"Incoming\":[28],\"Outgoing\":[31],\"GraphPos\":[4241,541],\"CompletionType\":2,\"OtherDialogueInfos\":[{\"Dialogue\":\"/Lotus/Types/Gameplay/1999Wf/Dialogue/HexDialogue_rom.dialogue\",\"Tag\":\"HexKayaConvo1\",\"Value\":0}]}",color=orange];
		996 -> 31;
	32 [label="¿Juegos? Sólo necesito respuestas, una dirección, cualquier cosa. Lo averiguaré. Si se te ocurre algo ÚTIL, búscame.",shape=box,color=blue];
		32 -> 34;
	33 [label="No es mi estilo. En fin.",shape=box,color=blue];
		33 -> 35;
	31 [label="Chat ends. Next chat will be KayaRank1Convo2.",color=orange];
	34 [label="+20 Chemistry",color=orange];
		34 -> 998;
