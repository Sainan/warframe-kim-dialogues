digraph {
	graph [fontname="Roboto Condensed"];
	node [fontname="Roboto Condensed"];
	edge [fontname="Roboto Condensed"];

	"KayaRank1Convo1 begins." [color=orange];
		"KayaRank1Convo1 begins." -> j2051470252;
	j2051470252 [label="Hola. ¿Todos pueden viajar en el tiempo o sólo tú?",shape=box,color=blue];
		j2051470252 -> j3087547217;
		j2051470252 -> j3272932381;
	j3087547217 [label="Buen día para ti también. Mira, niña, no es tan simple.",shape=box,color=red];
		j3087547217 -> j1564041939;
	j3272932381 [label="Hola, ¿Kaya, verdad? ¿Cómo va tu día?",shape=box,color=red];
		j3272932381 -> j792986950;
	j1564041939 [label="No soy una niña. Tengo 19.",shape=box,color=blue];
		j1564041939 -> j1183157171;
		j1564041939 -> j853104180;
	j792986950 [label="Bien. ",shape=box,color=blue];
		j792986950 -> j3330147279;
	j1183157171 [label="Cierto. Pero eres la más joven de este nuevo grupo, así que, niña.",shape=box,color=red];
		j1183157171 -> j1160170266;
	j853104180 [label="Sí, sí, bueno, pero no te apresures con eso de viajar en el tiempo. Es... complicado.",shape=box,color=red];
		j853104180 -> j483428811;
	j3330147279 [label="Entonces, ¿sólo tú? ¿Hay otros? ¿En las escuelas del futuro te enseñan a viajar en el tiempo?",shape=box,color=blue];
		j3330147279 -> j488101241;
	j1160170266 [label="Ugh. Bueno, sí, la más joven, pero también la más decidida a hacer algo para encontrar respuestas. Trata de seguirme el ritmo. Así que: viajar en el tiempo. ¿Cómo y quién?",shape=box,color=blue];
		j1160170266 -> j2969493714;
	j483428811 [label="Ugh. ¿Qué tan complicado? ¿Fórmulas? ¿Elementos químicos y atómicos? Yo puedo resolverlo. Sólo indícame una dirección.",shape=box,color=blue];
		j483428811 -> j1258538005;
		j483428811 -> j2262353043;
	j488101241 [label="Digamos que sólo soy yo. Así es más sencillo.",shape=box,color=red];
		j488101241 -> j1057341298;
	j2969493714 [label="¿Y por qué tú? ¿Tienes un plan? ",shape=box,color=blue];
		j2969493714 -> j1168217212;
	j1258538005 [label="No sé muy bien qué decirte. No es un tema exclusivo de la ciencia, o si lo es, es una ciencia que Entrati conoce.",shape=box,color=red];
		j1258538005 -> j2671298572;
	j2262353043 [label="Aquí hay una dirección: Para. [Fin]",shape=box,color=red];
		j2262353043 -> j2938341431;
	j1057341298 [label="En cuanto a si lo enseñan en las escuelas, de ser así, no lo estudié. Pero, ¿puede ser? ",shape=box,color=red];
		j1057341298 -> j273876357;
	j1168217212 [label="Y si no, ¿qué me recomiendas para poder obtener fuentes científicas sobre tus habilidades?",shape=box,color=blue];
		j1168217212 -> j1176531151;
	j2671298572 [label="Ugh, ese bastardo. Sabía que debería haberle hecho más preguntas. Ok. Al menos, si es ciencia, significa que puedo reproducirla y, como puedes ir y venir, puedo averiguarlo. Adiós.",shape=box,color=blue];
		j2671298572 -> j2938341431;
	j2938341431 [label="+20 Chemistry",color=orange];
		j2938341431 -> "Initiate conversation HexKayaConvo1 in /Lotus/Types/Gameplay/1999Wf/Dialogue/HexDialogue_rom.dialogue";
	j273876357 [label="¿Por qué? ¿Quieres tener tarea? Los viajes en el tiempo probablemente sean demasiado avanzados por ahora...",shape=box,color=red];
		j273876357 -> j1470840600;
	j1176531151 [label="Son muchas preguntas, niña. Lamento decírtelo, pero no lo sé. Sólo Entrati tiene las respuestas.",shape=box,color=red];
		j1176531151 -> j285977890;
	"Initiate conversation HexKayaConvo1 in /Lotus/Types/Gameplay/1999Wf/Dialogue/HexDialogue_rom.dialogue" [label="Initiate conversation HexKayaConvo1 in /Lotus/Types/Gameplay/1999Wf/Dialogue/HexDialogue_rom.dialogue",color=orange];
		"Initiate conversation HexKayaConvo1 in /Lotus/Types/Gameplay/1999Wf/Dialogue/HexDialogue_rom.dialogue" -> "Chat ends. Next chat will be KayaRank1Convo2.";
	j1470840600 [label="Ugh, ¿es en serio?",shape=box,color=blue];
		j1470840600 -> j4201724503;
	j285977890 [label="Boolean KayaSetKid is now true.",color=orange];
		j285977890 -> j1219546166;
	"Chat ends. Next chat will be KayaRank1Convo2." [color=orange];
	j4201724503 [label="¿Alguien del Hex sabe cómo? ¿Tienen alguna información? ",shape=box,color=blue];
		j4201724503 -> j3249447557;
		j4201724503 -> j3688094109;
	j1219546166 [label="K.",shape=box,color=blue];
		j1219546166 -> j2938341431;
	j3249447557 [label="¿Tal vez Amir? Probablemente conoce juegos con historias de viajes en el tiempo...",shape=box,color=red];
		j3249447557 -> j1832760200;
	j3688094109 [label="No lo creo, niña. Pero si quieres aprender algo útil, pídele a Lettie que te dé una lección básica sobre hacer curaciones.",shape=box,color=red];
		j3688094109 -> j3182650418;
	j1832760200 [label="Boolean KayaAmirTravel is now true.",color=orange];
		j1832760200 -> j2309257880;
	j3182650418 [label="Boolean KayaLettieHeal is now true.",color=orange];
		j3182650418 -> j1244982309;
	j2309257880 [label="¿Juegos? Sólo necesito respuestas, una dirección, cualquier cosa. Lo averiguaré. Si se te ocurre algo ÚTIL, búscame.",shape=box,color=blue];
		j2309257880 -> j2938341431;
	j1244982309 [label="No es mi estilo. En fin.",shape=box,color=blue];
		j1244982309 -> j2938341431;
}