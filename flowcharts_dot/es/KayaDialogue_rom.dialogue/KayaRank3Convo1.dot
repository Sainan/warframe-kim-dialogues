	j1454470470 [label="Uh, oh. ¿En el buen sentido?",shape=box,color=red];
		j1454470470 -> j592316422;
	j196950791 [label="¿Un estudiante increíblemente atractivo y brillante?",shape=box,color=red];
		j196950791 -> j3862430268;
	j232151871 [label="Me preparo para que esto no inicie una pelea...",shape=box,color=red];
		j232151871 -> j2450487412;
	j592316422 [label="De hecho, sí. ",shape=box,color=blue];
		j592316422 -> j2040267594;
	j3862430268 [label="Ew. Odio decírtelo, pero yo no coqueteo. Nunca.",shape=box,color=blue];
		j3862430268 -> j388467196;
	j2450487412 [label="Oh, Dios, no, no. Este es un recuerdo feliz.",shape=box,color=blue];
		j2450487412 -> j1607790665;
		j2450487412 -> j2764674914;
	j2040267594 [label="Estaba horneando un pastel para demostrarte que estabas equivocado.",shape=box,color=blue];
		j2040267594 -> j532254473;
	j388467196 [label="ESPECIALMENTE no en Internet.",shape=box,color=blue];
		j388467196 -> j659972321;
		j388467196 -> j1068003222;
	j1607790665 [label="Si tú lo dices.",shape=box,color=red];
		j1607790665 -> j2079827414;
	j2764674914 [label="Parece que no tienes muchos de esos.",shape=box,color=red];
		j2764674914 -> j2231802370;
	j532254473 [label="Y me hizo pensar en la única vez que alguien me preparó un pastel... fue este tímido compañero de clase.",shape=box,color=blue];
		j532254473 -> j2944972357;
	j659972321 [label="¿Y si quisiera?",shape=box,color=red];
		j659972321 -> j3808869328;
	j1068003222 [label="Uy, disculpa. Fue un error.",shape=box,color=red];
		j1068003222 -> j3209621102;
	j2079827414 [label="En realidad, se trata de mi cumpleaños, pero no de mí. ",shape=box,color=blue];
		j2079827414 -> j2579591503;
	j2231802370 [label="¡Bueno, entonces, déjame compartir uno! ",shape=box,color=blue];
		j2231802370 -> j2079827414;
	j2944972357 [label="Quien de alguna manera descubrió que era mi cumpleaños a pesar de que nunca me habían visto con esa persona.",shape=box,color=blue];
		j2944972357 -> j418708416;
	j3808869328 [label="Jamás será conmigo.",shape=box,color=blue];
		j3808869328 -> j2013445877;
	j3209621102 [label="No lo intentes de nuevo.",shape=box,color=blue];
		j3209621102 -> j931425517;
	j2579591503 [label="Bueno, supongo que un poco sí lo fue. Debo decir que definitivamente era el tipo de persona con la que todos querían estar.",shape=box,color=blue];
		j2579591503 -> j3472122380;
	j418708416 [label="Era un pastel de vainilla con glaseado de vainilla, el pastel tenía como tres capas de alto, lo juro.",shape=box,color=blue];
		j418708416 -> j1982623298;
	j2013445877 [label="+5 Chemistry",color=orange];
		j2013445877 -> "Chat ends. Next chat will be KayaRank3Convo2.";
	j931425517 [label="Prometo que no lo haré.",shape=box,color=red];
		j931425517 -> j4015720128;
	j3472122380 [label="Buenas notas, más que buenas, en realidad. Y capitana del grupo de animadoras. Era algo grande que fueras invitado a mi fiesta de cumpleaños.",shape=box,color=blue];
		j3472122380 -> j3724965154;
	j1982623298 [label="Y bueno, vi que traía el pastel y me preocupó mucho que la clase viera que me daba un pastel a MÍ. NO nos juntábamos con la misma gente.",shape=box,color=blue];
		j1982623298 -> j527637984;
	"Chat ends. Next chat will be KayaRank3Convo2." [color=orange];
	j4015720128 [label="Boolean KayaFlirtPromise is now true.",color=orange];
		j4015720128 -> j2407363397;
	j3724965154 [label="Bueno, este estudiante me preparó un pastel de cumpleaños, pero me dijo que no lo compartiera con nadie y que esperara hasta llegar a casa para comérmelo. ",shape=box,color=blue];
		j3724965154 -> j1307705814;
	j527637984 [label="Tenía buenas notas. Más que buenas, en realidad. Y era la capitana del grupo de animadoras. Era algo grande que fueras invitado a mi fiesta de cumpleaños.",shape=box,color=blue];
		j527637984 -> j3724965154;
	j2407363397 [label="Bien.",shape=box,color=blue];
		j2407363397 -> j3724965154;
	j1307705814 [label="Y para ser honesta, me asustó un poco, como te pasó a ti al principio. Pero luego lo corté y mi cuchillo de cocina golpeó algo duro.",shape=box,color=blue];
		j1307705814 -> j691609659;
	j691609659 [label="Qué asco, ¿verdad? Muy asqueroso. Pero luego miré y vi que era como un recipiente de plástico que escondió debajo del pastel lleno de paquetes de cartas de Jinymon sellados. Eran mis cosas favoritas.",shape=box,color=blue];
		j691609659 -> j1549879619;
	j1549879619 [label="Pero una chica como yo no podía ser vista con ese en la escuela. Y aparentemente este chico tímido vio quién era yo realmente y me dio el verdadero regalo a escondidas mientras hacía que pareciera que quería mi atención con un gran pastel o algo así, no sé.",shape=box,color=blue];
		j1549879619 -> j1883437853;
		j1549879619 -> j625460790;
		j1549879619 -> j1523680589;
	j1883437853 [label="No te voy a hornear un pastel.",shape=box,color=red];
		j1883437853 -> j2819905164;
	j625460790 [label="Para alguien que se supone que es una niña genio, tardas mucho en llegar al grano...",shape=box,color=red];
		j625460790 -> j1015223555;
	j1523680589 [label="¿Y exactamente en qué te recuerda esto a mí?",shape=box,color=red];
		j1523680589 -> j3232486551;
	j2819905164 [label="+20 Chemistry",color=orange];
		j2819905164 -> j1770879854;
	j1015223555 [label="Y para alguien del grandioso e inspirador futuro, seguro que no entendiste el punto. ¡Cartas de Jinymon! ¡YO! ¿Puedes creerlo? ",shape=box,color=blue];
		j1015223555 -> j2418293506;
		j1015223555 -> j3691697445;
	j3232486551 [label="Supongo que, a mi manera, te estoy diciendo que confío en que sepas que colecciono cartas de Jinymon. Son algo así como para perdedores.",shape=box,color=blue];
		j3232486551 -> j1648824144;
	j1770879854 [label="¡Ja, ja, ja!",shape=box,color=blue];
		j1770879854 -> j1829338307;
	j2418293506 [label="¡No tengo idea de qué son!",shape=box,color=red];
		j2418293506 -> j1930225165;
	j3691697445 [label="¿Son como... objetos especiales de colección?",shape=box,color=red];
		j3691697445 -> j1930225165;
	j1648824144 [label="O al menos eso creía yo. Pero los verdaderos perdedores eran todos los demás. ",shape=box,color=blue];
		j1648824144 -> j1747920428;
		j1648824144 -> j3762250843;
		j1648824144 -> j440623557;
	j1829338307 [label="Seguramente te quedaría algo asqueroso.",shape=box,color=blue];
		j1829338307 -> j1447606035;
		j1829338307 -> j1745855684;
	j1930225165 [label="Son como un juego de cartas de monstruos para niños y totalmente para perdedores, especialmente en la universidad.",shape=box,color=blue];
		j1930225165 -> j1648824144;
	j1747920428 [label="¿Tal vez me muestres tus cartas de Jinymon algún día?",shape=box,color=red];
		j1747920428 -> j1927967421;
	j3762250843 [label="¡Guau, terminamos una conversación entera sin hablar SÓLO de viajes en el tiempo! ",shape=box,color=red];
		j3762250843 -> j3697299123;
	j440623557 [label="¿Es esta tu manera de abrirte a mí? ¡Maravilloso!",shape=box,color=red];
		j440623557 -> j2252585938;
	j1447606035 [label="Probablemente tengas razón.",shape=box,color=red];
		j1447606035 -> j371065428;
	j1745855684 [label="Vería cómo hacerlo.",shape=box,color=red];
		j1745855684 -> j371065428;
	j1927967421 [label="Tal vez.",shape=box,color=blue];
		j1927967421 -> j1895387827;
	j3697299123 [label="¡Tarán!",shape=box,color=blue];
		j3697299123 -> j1895387827;
	j2252585938 [label="No te acostumbres. Tal vez. Ugh, no lo sé. ",shape=box,color=blue];
		j2252585938 -> j1895387827;
