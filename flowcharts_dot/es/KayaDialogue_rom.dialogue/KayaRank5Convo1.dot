digraph {
	"KayaRank5Convo1 begins." [color=orange];
		"KayaRank5Convo1 begins." -> j1355375866;
	j1355375866 [label="Sigo encontrando estas cosas moradas, pero desaparecen al día siguiente.",shape=box,color=blue];
		j1355375866 -> j4076325381;
	j4076325381 [label="Y creo que hay algo interesante en su declive.",shape=box,color=blue];
		j4076325381 -> j2674894373;
	j2674894373 [label="Porque la materia no se está reformando simplemente en un estado de desintegración de un nuevo isótopo.",shape=box,color=blue];
		j2674894373 -> j1591022381;
	j1591022381 [label="En realidad está desapareciendo de AQUÍ.",shape=box,color=blue];
		j1591022381 -> j1978124618;
		j1591022381 -> j1900446397;
	j1978124618 [label="¿Te refieres a la criótica?",shape=box,color=red];
		j1978124618 -> j2440147987;
	j1900446397 [label="¿Te refieres a los cristales de argón? ",shape=box,color=red];
		j1900446397 -> j3185465355;
	j2440147987 [label="Mmm, nop, eso no.",shape=box,color=blue];
		j2440147987 -> j1900446397;
		j2440147987 -> j2437200782;
	j3185465355 [label="¡Debe ser eso!",shape=box,color=blue];
		j3185465355 -> j1944119004;
	j2437200782 [label="¿Te refieres a la célula orokin?",shape=box,color=red];
		j2437200782 -> j1830832401;
	j1944119004 [label="¿Consigues conservarlos en el lugar de donde vienes?",shape=box,color=blue];
		j1944119004 -> j3663426692;
		j1944119004 -> j3084390569;
	j1830832401 [label="Mmm, no, definitivamente eso tampoco.",shape=box,color=blue];
		j1830832401 -> j3635528096;
		j1830832401 -> j3748330734;
	j3663426692 [label="Siempre desaparecen cuando los sacas del Vacío.",shape=box,color=red];
		j3663426692 -> j678784935;
	j3084390569 [label="Nunca, siempre asumí que simplemente se descomponían. ",shape=box,color=red];
		j3084390569 -> j678784935;
	j3635528096 [label="¿Te refieres al rubedo?",shape=box,color=red];
		j3635528096 -> j648959008;
	j3748330734 [label="¿Te refieres a los cristales de argón?",shape=box,color=red];
		j3748330734 -> j3185465355;
	j678784935 [label="Bueno, eso es: en el Vacío son inertes.",shape=box,color=blue];
		j678784935 -> j1013189436;
	j648959008 [label="No lo creo, si no podemos resolverlo puede que nunca lo resuelva.",shape=box,color=blue];
		j648959008 -> j3218380962;
		j648959008 -> j3748330734;
	j1013189436 [label="Y cuando salen del Vacío, siempre vuelven al Vacío. No se desintegran en materia nueva.",shape=box,color=blue];
		j1013189436 -> j3235068822;
	j3218380962 [label="¿Te refieres a las nanoesporas?",shape=box,color=red];
		j3218380962 -> j4264839796;
	j3235068822 [label="Vuelven al Vacío. El Vacío está en todas partes y los llama de vuelta.",shape=box,color=blue];
		j3235068822 -> j221969447;
	j4264839796 [label="Ugh, oh, no, la última muestra que tenía se acabó. Yo... ugh. Tengo que irme.",shape=box,color=blue];
		j4264839796 -> j3621771850;
	j221969447 [label="Boolean KayaFutureWin2 is now true.",color=orange];
		j221969447 -> j3567610413;
		j221969447 -> j2441027692;
	j3621771850 [label="No creo que pueda hacer esto.",shape=box,color=blue];
		j3621771850 -> j4123196853;
	j3567610413 [label="¿Esto te ayudará a salir de 1999? ¿Piensas esconderte en el Vacío? No te lo recomiendo.",shape=box,color=red];
		j3567610413 -> j2513542867;
	j2441027692 [label="¿Esto es importante para tu objetivo?",shape=box,color=red];
		j2441027692 -> j465438418;
	j4123196853 [label="+20 Chemistry",color=orange];
		j4123196853 -> "Chat ends. Next chat will be KayaRank5Convo2.";
	j2513542867 [label="Se trata más de los estados de la materia y la teoría de que el Vacío no es \"lineal\" en nuestra comprensión, por lo que puedo usarlo como un trampolín para SEGUIRTE de regreso de manera efectiva.",shape=box,color=blue];
		j2513542867 -> j3457013609;
	j465438418 [label="¡Mucho, mucho, mucho! Significa que la materia tiene una conexión entre el VACÍO y el AQUÍ. Los átomos, la materia, son CONSISTENTES en ambas áreas. ",shape=box,color=blue];
		j465438418 -> j1674736411;
	"Chat ends. Next chat will be KayaRank5Convo2." [color=orange];
	j3457013609 [label="Espera, ¿seguirme? ",shape=box,color=red];
		j3457013609 -> j353790805;
	j1674736411 [label="El Vacío no es \"lineal\" según nuestra comprensión, por lo que puedo usarlo como un trampolín para seguirte de manera efectiva.",shape=box,color=blue];
		j1674736411 -> j3457013609;
	j353790805 [label="Sí, no importa cuántas veces ejecute pruebas o ecuaciones, me falta un \"faro\", por así decirlo. El salto en trampolín tiene que aterrizar en algún lugar, y si has regresado a él aunque sea una vez, eso debería ser suficiente para la calibración. ",shape=box,color=blue];
		j353790805 -> j1514765444;
		j353790805 -> j1887862337;
	j1514765444 [label="¡Ojalá puedas dar un salto hacia atrás! Se acerca un faro. ",shape=box,color=red];
		j1514765444 -> j3693310725;
	j1887862337 [label="Vaya, no sé si me siento cómodo con esto. ¿Qué pasa si te quedas atascada o te pierdes? ",shape=box,color=red];
		j1887862337 -> j2179697341;
	j3693310725 [label="Por supuesto, todavía no estoy lista del todo. Mide dos veces, corta una. Mide... 1000 veces. ",shape=box,color=blue];
		j3693310725 -> j1148966090;
		j3693310725 -> j803079999;
	j2179697341 [label="Eso no pasará. ",shape=box,color=blue];
		j2179697341 -> j309223387;
	j1148966090 [label="Así es, la ciencia debe realizarse con confianza.",shape=box,color=red];
		j1148966090 -> j1855493972;
	j803079999 [label="¡Probemos! No hay tiempo para precauciones, ¡vamos ya! ",shape=box,color=red];
		j803079999 -> j3669564211;
	j309223387 [label="Podría pasar.",shape=box,color=red];
		j309223387 -> j1921572172;
	j1855493972 [label="Te estoy enseñando bien, ya veo.",shape=box,color=blue];
		j1855493972 -> j4179401872;
		j1855493972 -> j3958773240;
	j3669564211 [label="¡Ah, no, no, no estoy lista! ¡No puedes apresurar esto!",shape=box,color=blue];
		j3669564211 -> j2978421293;
	j1921572172 [label="Nop.",shape=box,color=blue];
		j1921572172 -> j3442570861;
		j1921572172 -> j3320589656;
	j4179401872 [label="¡Ya quisieras! ",shape=box,color=red];
		j4179401872 -> j4123196853;
	j3958773240 [label="Ah, claro, eres una gran profesora. Aunque creo que lo único que te he visto hacer es enseñarle a Minerva a jugar nuevos juegos para beber.",shape=box,color=red];
		j3958773240 -> j116865929;
	j2978421293 [label="Bieeen, parece que todavía te das cuenta de lo peligroso que puede ser esto. Bien hecho.",shape=box,color=red];
		j2978421293 -> j1997653843;
	j3442570861 [label="Ahh...",shape=box,color=red];
		j3442570861 -> j3279966979;
	j3320589656 [label="Pero... podría pasar.",shape=box,color=red];
		j3320589656 -> j3279966979;
	j116865929 [label="Pero Minerva con resaca es más peligrosa que viajar en el tiempo. ¡CORRE!",shape=box,color=blue];
		j116865929 -> j4123196853;
	j1997653843 [label="Pero Minerva con resaca es más peligrosa. ¡CORRE!",shape=box,color=blue];
