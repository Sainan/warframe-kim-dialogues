		j4294415938 -> j1130722790 [label=true,color=green];
		j4294415938 -> j3456439457 [label=false,color=brown];
	j3771218626 [label="Ugh. No tiene gracia. ",shape=box,color=blue];
		j3771218626 -> j2292283515;
	j1626039619 [label="Cometí un error TONTO. Una vez. ",shape=box,color=blue];
		j1626039619 -> j4127635712;
	j782308189 [label="En serio, cero bromas.",shape=box,color=blue];
		j782308189 -> j1669438625;
	j4184862542 [label="Arthur y Eleanor definitivamente te ven como una hermana pequeña que es mucho más inteligente que ellos.",shape=box,color=red];
		j4184862542 -> j1921459910;
	j2004976731 [label="Tú eres el que dice que soy como una niña, ¿y si me pasa algo?",shape=box,color=blue];
		j2004976731 -> j1710365850;
	j735578817 [label="Nada que pueda cambiar ahora.",shape=box,color=blue];
		j735578817 -> j3391947178;
	j1130722790 [label="Escucha, sé que piensas que sólo soy una niña.",shape=box,color=blue];
		j1130722790 -> j93653328;
	j3456439457 [label="Está bien, tienes razón.",shape=box,color=blue];
	j2292283515 [label="+20 Chemistry",color=orange];
		j2292283515 -> "Chat ends. Next chat will be KayaRank2Convo2.";
	j4127635712 [label="Y yo no cometo errores.",shape=box,color=blue];
		j4127635712 -> j3326053039;
	j1669438625 [label="Ni siquiera es gracioso. Pones a chicas como nosotras en una habitación y todo el mundo espera que nos peleemos entre nosotras.",shape=box,color=blue];
		j1669438625 -> j2732254992;
	j1921459910 [label="Amir y Quincy no pueden superar tu agujero de gusano y juro que cuando no estás mirando, saltan a través de él.",shape=box,color=red];
		j1921459910 -> j1906841173;
	j1710365850 [label="Entonces espero que puedas ver en la gente que te rodea que somos un equipo que se ayuda mutuamente.",shape=box,color=red];
		j1710365850 -> j1423050578;
	j3391947178 [label="Bueno, ¿es por eso que quieres descubrir cómo funciona esto de viajar en el tiempo? ¿Para demostrar algo?",shape=box,color=red];
		j3391947178 -> j2606508660;
	j93653328 [label="Pero ",shape=box,color=blue];
		j93653328 -> j1626039619;
	"Chat ends. Next chat will be KayaRank2Convo2." [color=orange];
	j3326053039 [label="Así que dame unos cuantos días más, quizá unas cuantas semanas, y tendré todo resuelto y será un adiós a 1999.",shape=box,color=blue];
		j3326053039 -> j456372112;
	j2732254992 [label="Celos. Comparaciones. Uf. Ya terminé con esa parte de mi vida. No intentes ponerme en contra de las otras chicas. ",shape=box,color=blue];
		j2732254992 -> j2292283515;
	j1906841173 [label="Aoi y Lettie no parecen poder decidir si quieren ser tu mejor amiga o tu madre.",shape=box,color=red];
		j1906841173 -> j2472094606;
	j1423050578 [label="Mmm. ",shape=box,color=blue];
		j1423050578 -> j1024354787;
	j2606508660 [label="Tal vez.",shape=box,color=blue];
		j2606508660 -> j2338693456;
	j456372112 [label="Puedes contar con ello.",shape=box,color=blue];
		j456372112 -> j2292283515;
	j2472094606 [label="Y, claro, yo estoy feliz de que alguien quiera entender cómo diablos terminé aquí.",shape=box,color=red];
		j2472094606 -> j2369031004;
	j1024354787 [label="Tienes razón. No eres precisamente impopular.",shape=box,color=blue];
		j1024354787 -> j1353459461;
	j2338693456 [label="¿Por qué te importa, en realidad?",shape=box,color=blue];
		j2338693456 -> j1791098276;
		j2338693456 -> j324594118;
		j2338693456 -> j3219656364;
	j2369031004 [label="A ustedes... ¿de verdad les caigo bien?",shape=box,color=blue];
		j2369031004 -> j1471078416;
		j2369031004 -> j4137691427;
	j1353459461 [label="Y todos parecen confiar en ti, o al menos eso dicen.",shape=box,color=blue];
		j1353459461 -> j3219656364;
		j1353459461 -> j324594118;
		j1353459461 -> j1791098276;
	j1791098276 [label="Confiar en las personas y trabajar juntos es lo que nos hace ser quienes somos. ",shape=box,color=red];
		j1791098276 -> j3162987335;
	j324594118 [label="Preocuparme por mis amigos es una fortaleza. Es una razón para soportar toda esta mierda.",shape=box,color=red];
		j324594118 -> j3162987335;
	j3219656364 [label="Todos tenemos problemas con los que lidiar. Es difícil hacerlo solo.",shape=box,color=red];
		j3219656364 -> j3162987335;
	j1471078416 [label="Sólo estamos esperando que te sientas cómoda con nosotros.",shape=box,color=red];
		j1471078416 -> j2696980963;
	j4137691427 [label="¿Cómo podría ser de otra manera?",shape=box,color=red];
		j4137691427 -> j2696980963;
