digraph {
	"KayaRank2Convo1 begins." [color=orange];
		"KayaRank2Convo1 begins." -> j832333638;
	j832333638 [label="¡Ey, Kaya!",shape=box,color=red];
		j832333638 -> j3607959753;
	j3607959753 [label="Nova, cuando estoy en línea, soy Nova.",shape=box,color=blue];
		j3607959753 -> j2880625878;
		j3607959753 -> j911310659;
	j2880625878 [label="Okey, Nova. ",shape=box,color=red];
		j2880625878 -> j2560607296;
	j911310659 [label="Ya veo. ¿Desde cuándo?",shape=box,color=red];
		j911310659 -> j2683482861;
	j2560607296 [label="Ok, gracias, sólo no me llames Kaya en Internet. Puedes llamarme así en persona, pero aquí: NOVA. ¿Ok?",shape=box,color=blue];
		j2560607296 -> j3393498682;
		j2560607296 -> j2549520661;
	j2683482861 [label="Mmm, ¿acaso importa? Es Internet, prefiero no usar mi nombre real.",shape=box,color=blue];
		j2683482861 -> j1093920314;
		j2683482861 -> j2655270837;
	j3393498682 [label="Okey, pero ¿puedo preguntar por qué?",shape=box,color=red];
		j3393498682 -> j2148890768;
	j2549520661 [label="Entendido. Nova. Nova. Bien. Quería preguntar: ¿Hay algo que pueda hacer para que te sientas más cómoda aquí?",shape=box,color=red];
		j2549520661 -> j1169913894;
	j1093920314 [label="Cierto, no quisiera que la gente viera con qué frecuencia me preguntas sobre los viajes en el tiempo.",shape=box,color=red];
		j1093920314 -> j1464291110;
	j2655270837 [label="¿Ah, sí? Estoy bastante seguro de que Amir tiene esta red bien bloqueada, a menos de que me esté perdiendo algo.",shape=box,color=red];
		j2655270837 -> j1628716797;
	j2148890768 [label="¿Le has preguntado a alguien más si le gusta un apodo? Sólo hazlo. ",shape=box,color=blue];
		j2148890768 -> j2549520661;
	j1169913894 [label="Sé que ninguno de nosotros pidió realmente “estar aquí” en esta casa improvisada, pero hacemos lo mejor que podemos.",shape=box,color=red];
		j1169913894 -> j3683389425;
	j1464291110 [label="¿En serio? Internet es peligroso. De verdad.",shape=box,color=blue];
		j1464291110 -> j2990039620;
		j1464291110 -> j1073295665;
	j1628716797 [label="A mí me importa. No quiero que nadie vuelva a encontrar a Kaya en Internet.",shape=box,color=blue];
		j1628716797 -> j2371169201;
		j1628716797 -> j3598725745;
	j3683389425 [label="Hmm. Umm. Hmm. Cómoda. Nadie ha difundido rumores sobre mí, ¿verdad?",shape=box,color=blue];
		j3683389425 -> j3933683409;
		j3683389425 -> j3779572260;
	j2990039620 [label="¿Te pasó algo?",shape=box,color=red];
		j2990039620 -> j960515419;
	j1073295665 [label="¿Y crees que el viaje en el tiempo no lo es?",shape=box,color=red];
		j1073295665 -> j4294415938;
	j2371169201 [label="La policía no te atrapará, lo juro.",shape=box,color=red];
		j2371169201 -> j3771218626;
	j3598725745 [label="¿Te metiste en problemas?",shape=box,color=red];
		j3598725745 -> j1626039619;
	j3933683409 [label="Pues, Aoi dijo...",shape=box,color=red];
		j3933683409 -> j782308189;
	j3779572260 [label="Ni una palabra. Están felices de que estés aquí.",shape=box,color=red];
		j3779572260 -> j4184862542;
