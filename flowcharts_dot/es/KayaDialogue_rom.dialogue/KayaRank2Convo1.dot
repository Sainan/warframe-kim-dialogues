	j2357108715 [label="No entiendo...",shape=box,color=red];
		j2357108715 -> j2134710351;
	j2134710351 [label="En la universidad, un grupo de chicas se llaman a sí mismas hermanas y creen que eso significa algo. Como un \"club\", supongo. ",shape=box,color=blue];
