digraph {
	"KayaRank4Convo1 begins." [color=orange];
		"KayaRank4Convo1 begins." -> j3132121270;
	j3132121270 [label="¿Quieres saber cómo es? Internet aparece y nos promete mucho.",shape=box,color=blue];
		j3132121270 -> j4057218284;
	j4057218284 [label="Entonces, imagina que eres yo. Tienes 18 años. Inicias sesión. ¡Empiezas a chatear con nuevos amigos de TODAS PARTES!",shape=box,color=blue];
		j4057218284 -> j1934841161;
	j1934841161 [label="Y para una \"chica inteligente\" como yo, haces la cosa más estúpida que jamás haya existido en Internet. ",shape=box,color=blue];
		j1934841161 -> j3536908032;
	j3536908032 [label="Confías en la persona del otro lado. ",shape=box,color=blue];
		j3536908032 -> j861256913;
	j861256913 [label="Y miras toda esta nueva tecnología y olvidas que las personas siguen siendo personas. ",shape=box,color=blue];
		j861256913 -> j148114064;
	j148114064 [label="Y envías una foto tuya desnuda que haría sonrojar a Lua. Crees que tienes una conexión con alguien que conociste en Internet. Puedes confiar en tu novio en línea. ",shape=box,color=blue];
		j148114064 -> j613207910;
	j613207910 [label="Y al día siguiente, esa foto está en todas partes. Todos en el campus la ha visto. La han compartido. La han enviado a tus PROFESORES. Por todo INTERNET. En países que ni siquiera sabía que existían.",shape=box,color=blue];
		j613207910 -> j4201043578;
	j4201043578 [label="Podría haber sido la persona más inteligente en esta roca y la gente sólo me recordaría por esa foto.",shape=box,color=blue];
		j4201043578 -> j398452249;
	j398452249 [label="Así que cuando digo que me voy de aquí, lo digo en serio. Sé que esa foto no significa NADA, el futuro continuó y la gente se divirtió.",shape=box,color=blue];
		j398452249 -> j824372778;
	j824372778 [label="Pero a mí me arruinó la vida. Quiero vivir en un futuro sin Internet. Quiero demostrar que puedo superarlo. Volver al pasado demuestra que TIENEN razón en que no puedo superarlo.",shape=box,color=blue];
		j824372778 -> j971560081;
	j971560081 [label="Así que espera un poco. Me volverás a ver de donde vienes. ",shape=box,color=blue];
		j971560081 -> j2834480921;
	j2834480921 [label="Y podemos mirar el mundo y reír, pensando que mis decisiones no me destruyeron. Todo esto sólo me hizo más inteligente. Lo suficientemente inteligente para salir adelante.",shape=box,color=blue];
		j2834480921 -> j3258508148;
	j3258508148 [label="+20 Chemistry",color=orange];
		j3258508148 -> "Chat ends. Next chat will be KayaRank4Convo2.";
	"Chat ends. Next chat will be KayaRank4Convo2." [color=orange];
}