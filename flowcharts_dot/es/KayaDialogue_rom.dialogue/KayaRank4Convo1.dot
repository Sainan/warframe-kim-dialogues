digraph {
	541 [label="KayaRank4Convo1 begins.",color=orange];
		541 -> 542;
	542 [label="¿Quieres saber cómo es? Internet aparece y nos promete mucho.",shape=box,color=blue];
		542 -> 543;
	543 [label="Entonces, imagina que eres yo. Tienes 18 años. Inicias sesión. ¡Empiezas a chatear con nuevos amigos de TODAS PARTES!",shape=box,color=blue];
		543 -> 544;
	544 [label="Y para una \"chica inteligente\" como yo, haces la cosa más estúpida que jamás haya existido en Internet. ",shape=box,color=blue];
		544 -> 545;
	545 [label="Confías en la persona del otro lado. ",shape=box,color=blue];
		545 -> 546;
	546 [label="Y miras toda esta nueva tecnología y olvidas que las personas siguen siendo personas. ",shape=box,color=blue];
		546 -> 547;
	547 [label="Y envías una foto tuya desnuda que haría sonrojar a Lua. Crees que tienes una conexión con alguien que conociste en Internet. Puedes confiar en tu novio en línea. ",shape=box,color=blue];
		547 -> 548;
	548 [label="Y al día siguiente, esa foto está en todas partes. Todos en el campus la ha visto. La han compartido. La han enviado a tus PROFESORES. Por todo INTERNET. En países que ni siquiera sabía que existían.",shape=box,color=blue];
		548 -> 549;
	549 [label="Podría haber sido la persona más inteligente en esta roca y la gente sólo me recordaría por esa foto.",shape=box,color=blue];
		549 -> 550;
	550 [label="Así que cuando digo que me voy de aquí, lo digo en serio. Sé que esa foto no significa NADA, el futuro continuó y la gente se divirtió.",shape=box,color=blue];
		550 -> 551;
	551 [label="Pero a mí me arruinó la vida. Quiero vivir en un futuro sin Internet. Quiero demostrar que puedo superarlo. Volver al pasado demuestra que TIENEN razón en que no puedo superarlo.",shape=box,color=blue];
		551 -> 552;
	552 [label="Así que espera un poco. Me volverás a ver de donde vienes. ",shape=box,color=blue];
		552 -> 553;
	553 [label="Y podemos mirar el mundo y reír, pensando que mis decisiones no me destruyeron. Todo esto sólo me hizo más inteligente. Lo suficientemente inteligente para salir adelante.",shape=box,color=blue];
		553 -> 554;
	554 [label="+20 Chemistry",color=orange];
		554 -> 555;
	555 [label="Chat ends. Next chat will be KayaRank4Convo2.",color=orange];
}