digraph {
	"KayaRank5Convo2 begins." [color=orange];
		"KayaRank5Convo2 begins." -> j4189934535;
	j4189934535 [label="¿Qué tal si esta vez soy yo el que pregunta sobre los viajes en el tiempo?",shape=box,color=red];
		j4189934535 -> j3593537982;
	j3593537982 [label="Nah. Mejor hablemos de otra cosa. ¿Te parece?",shape=box,color=blue];
		j3593537982 -> j3602582192;
	j3602582192 [label="Check boolean KayaPromiseRegret",color=orange];
		j3602582192 -> j2365195603 [label=true,color=green];
		j3602582192 -> j3825324666 [label=false,color=brown];
		j3602582192 -> j1262721163 [label=false,color=brown];
	j2365195603 [label="¿Como mi mayor arrepentimiento?",shape=box,color=red];
		j2365195603 -> j4082280373;
	j3825324666 [label="¿Cómo qué? Tú elige.",shape=box,color=red];
		j3825324666 -> j4226604859;
	j1262721163 [label="¿Qué tal... Kalymos?",shape=box,color=red];
		j1262721163 -> j2903529410;
	j4082280373 [label="Mmm, okey, sí, claro. ¿Cuál es? ",shape=box,color=blue];
		j4082280373 -> j601811239;
		j4082280373 -> j2922650698;
		j4082280373 -> j1090645778;
	j4226604859 [label="Ummm, qué tal... ¿mi primera mascota? ",shape=box,color=blue];
		j4226604859 -> j2854187964;
	j2903529410 [label=" Sí, sí, está bien. Aunque a mí me gustan más los perros. Crecí con uno. Ojalá pudiera volver a verlo.",shape=box,color=blue];
		j2903529410 -> j1608166448;
		j2903529410 -> j877326296;
		j2903529410 -> j303653062;
	j601811239 [label="No haberle pedido más a Albrecht.",shape=box,color=red];
		j601811239 -> j2439544604;
	j2922650698 [label="No haber detenido a Ballas antes.",shape=box,color=red];
		j2922650698 -> j3886514888;
	j1090645778 [label="Haberme dado por vencido.",shape=box,color=red];
		j1090645778 -> j2671270244;
	j2854187964 [label="Aunque esa suele ser una de esas preguntas que hacen los hackers de Internet, así que no se lo digas a nadie.",shape=box,color=blue];
		j2854187964 -> j1526338191;
	j1608166448 [label="Mis más sinceras condolencias. Es mejor terminar aquí. [Fin]",shape=box,color=red];
		j1608166448 -> j3219460250;
	j877326296 [label="Lo siento, cuéntame sobre él.",shape=box,color=red];
		j877326296 -> j2330183188;
	j303653062 [label="Yo también perdí una mascota. ¿Cómo se llamaba?",shape=box,color=red];
		j303653062 -> j2330183188;
	j2439544604 [label="Incluso después de todo eso, lo dejé ir.",shape=box,color=red];
		j2439544604 -> j2501383481;
	j3886514888 [label="No sé cómo podría haber cambiado las cosas.",shape=box,color=red];
		j3886514888 -> j570649574;
	j2671270244 [label="No importa cómo lo vean los demás. Hubo un momento en que nadie me odiaba más que yo mismo.",shape=box,color=red];
		j2671270244 -> j4105382786;
	j1526338191 [label="Su nombre era Zylo. Podrías decir que es un kubrow.",shape=box,color=blue];
		j1526338191 -> j2549469188;
	j3219460250 [label="+20 Chemistry",color=orange];
		j3219460250 -> "Chat ends. Next chat will be KayaRank5Convo3.";
	j2330183188 [label="En realidad es un poco injusto. ¿Entrati puede viajar en el tiempo con su extraño felino?",shape=box,color=blue];
		j2330183188 -> j3002450614;
	j2501383481 [label="Sé que cree que me está enseñando algo, pero ese imbécil ni siquiera se da cuenta de lo que me hizo pasar.",shape=box,color=red];
		j2501383481 -> j2644830046;
	j570649574 [label="Pero sé que si hubiera sido un minuto más rápido, alguien habría sufrido menos.",shape=box,color=red];
		j570649574 -> j2405312607;
	j4105382786 [label="Ni siquiera podía MORIR. Y deseaba poder hacerlo. ",shape=box,color=red];
		j4105382786 -> j490254783;
	j2549469188 [label="ENORME, el perro más grande que puedas imaginar. Apuesto a que podría abarcar la mitad del señor Volkov de una sola mordida.",shape=box,color=blue];
		j2549469188 -> j1367426932;
		j2549469188 -> j2105797066;
	"Chat ends. Next chat will be KayaRank5Convo3." [color=orange];
	j3002450614 [label="Si tuviera a Zylo conmigo... este viaje sería mucho más fácil.",shape=box,color=blue];
		j3002450614 -> j4240097528;
	j2644830046 [label="Y no SÓLO a mí. A todos nosotros. Y Loid, Gomaitru... es repugnante. No sé si podré contenerme si lo veo.",shape=box,color=red];
		j2644830046 -> j490254783;
	j2405312607 [label="Ballas es todo lo que temo. Es lo peor de la vida misma. ",shape=box,color=red];
		j2405312607 -> j490254783;
	j490254783 [label="Cuando lo pones de esta manera... Supongo que la vida y la gente a veces apestan, ¿no?",shape=box,color=blue];
		j490254783 -> j3354676225;
	j1367426932 [label="¡De donde yo vengo todavía tenemos kubrows grandes! ",shape=box,color=red];
		j1367426932 -> j87329257;
	j2105797066 [label="Ehh no lo sé. El señor Volkov es bastante fuerte.",shape=box,color=red];
		j2105797066 -> j2466593851;
	j4240097528 [label="¿Sabes? Zylo fue el primer ser vivo en verme llorar. ",shape=box,color=blue];
		j4240097528 -> j3160782795;
	j3354676225 [label="Pero a veces es tan increíble.",shape=box,color=blue];
		j3354676225 -> j3140751192;
	j87329257 [label="Dios mío... una razón más para IR ALLÍ. ¡Guau!",shape=box,color=blue];
		j87329257 -> j708354219;
	j2466593851 [label="En realidad, puede que tengas razón... pero, en fin, Zylo era grande y aterrador. Pero me protegía ferozmente.",shape=box,color=blue];
		j2466593851 -> j4240097528;
	j3160782795 [label="Tenía unos 5 años y desde que tengo memoria me negué a llorar.",shape=box,color=blue];
		j3160782795 -> j902173077;
	j3140751192 [label="Supongo que no podemos definirnos por nuestro mayor arrepentimiento. Siento que me ayudaste a superar el mío.",shape=box,color=blue];
		j3140751192 -> j1438553904;
	j708354219 [label="Mi Zylo me protegía ferozmente. ",shape=box,color=blue];
		j708354219 -> j4240097528;
	j902173077 [label="Pero llegué a casa después de mi primer día de primer grado en la escuela y Zylo estaba allí.",shape=box,color=blue];
		j902173077 -> j3486981972;
	j1438553904 [label="Pero no cambiaría el hecho de que pasó. ",shape=box,color=blue];
		j1438553904 -> j3727132198;
	j3486981972 [label="Y él me siguió hasta mi habitación y vigilaba la puerta mientras yo sollozaba.",shape=box,color=blue];
		j3486981972 -> j4268416689;
		j3486981972 -> j2203215063;
	j3727132198 [label="Porque, después de todo, no odio esto. ¿Y Nova? Es lo más genial que jamás haya existido.",shape=box,color=blue];
		j3727132198 -> j3412502590;
	j4268416689 [label="¿Qué te puso tan mal?",shape=box,color=red];
		j4268416689 -> j4259363290;
	j2203215063 [label="¿Cómo recuerdas eso?",shape=box,color=red];
		j2203215063 -> j4247906474;
	j3412502590 [label="¿No cambiarías nada?",shape=box,color=red];
		j3412502590 -> j2830935126;
	j4259363290 [label="Alguien me llamó gorda.",shape=box,color=blue];
		j4259363290 -> j2282835672;
	j4247906474 [label="¡¿Cómo podría olvidarlo?!",shape=box,color=blue];
		j4247906474 -> j4259363290;
	j2830935126 [label="Ni una sola cosa. Y espero que tú tampoco.",shape=box,color=blue];
		j2830935126 -> j3219460250;
	j2282835672 [label="Eso hacía que los niños fueran impopulares cuando yo era pequeña.",shape=box,color=blue];
		j2282835672 -> j689779546;
		j2282835672 -> j46129885;
	j689779546 [label="Los niños pueden ser muy crueles.",shape=box,color=red];
		j689779546 -> j1747615399;
	j46129885 [label="¿Es tan importante ser popular?",shape=box,color=red];
		j46129885 -> j21503594;
	j1747615399 [label="Todo el mundo es cruel.",shape=box,color=blue];
		j1747615399 -> j826089325;
	j21503594 [label="Lo era... hasta que pasó todo esto. Siento que soy una mejor persona después de toda esta mierda, que soy quien realmente debería haber sido todo este tiempo.",shape=box,color=blue];
		j21503594 -> j710004429;
	j826089325 [label="Todo el mundo quiere ser alguien cool.",shape=box,color=blue];
		j826089325 -> j1077790147;
	j710004429 [label="Ya no me importa lo que la gente piense de mí. Simplemente.. vivo.",shape=box,color=blue];
		j710004429 -> j3219460250;
	j1077790147 [label="Pero ahora me he dado cuenta de que es mucho más cool no preocuparse por ser cool. Y eso te hace ser muy cool.",shape=box,color=blue];
		j1077790147 -> j4033913120;
	j4033913120 [label="Siento que soy una mejor persona después de toda esta mierda, que soy quien realmente debería haber sido todo este tiempo.",shape=box,color=blue];
		j4033913120 -> j710004429;
}