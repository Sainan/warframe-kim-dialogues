digraph {
	"KayaRank1Convo2 begins." [color=orange];
		"KayaRank1Convo2 begins." -> j3900777359;
	j3900777359 [label="Hola. ¿Por qué la configuración intertemporal de Entrati implicaría lo que parece ser una conexión activa con la red en línea de Kinemantik?",shape=box,color=blue];
		j3900777359 -> j2090837676;
	j2090837676 [label="O, bueno... Hola, ¿se requiere Internet para viajar en el tiempo?",shape=box,color=blue];
		j2090837676 -> j3179763368;
		j2090837676 -> j1518332282;
	j3179763368 [label="Directo al grano... ok. No, el Internet no ha llegado a mi época, así que no puede ser necesario. O tal vez sí. ",shape=box,color=red];
		j3179763368 -> j1120597382;
	j1518332282 [label="Y hola a ti también, Kaya. ",shape=box,color=red];
		j1518332282 -> j902670995;
	j1120597382 [label="¿Entonces no necesitas una conexión a Internet para entrar y salir cuando quieras? ¿Entrati sí?",shape=box,color=blue];
		j1120597382 -> j3734515151;
	j902670995 [label="Ugh. ¿Internet? Puedo entender cómo, dadas las propiedades de una red...",shape=box,color=blue];
		j902670995 -> j3734515151;
	j3734515151 [label="En realidad no sé nada con certeza. Sólo sé que había una secuencia, que Entrati tenía un plan y que me involucraba a mí, aquí y ahora. Necesitaba llegar aquí para conocerlos a todos.",shape=box,color=red];
		j3734515151 -> j662885996;
	j662885996 [label="Okey, pero ¿por qué parece haber una conexión a Internet que no es negociable en algunas de sus notas?",shape=box,color=blue];
		j662885996 -> j744748549;
		j662885996 -> j2897752247;
		j662885996 -> j2520618110;
	j744748549 [label="Le preguntaré la próxima vez que lo vea.",shape=box,color=red];
		j744748549 -> j3135231552;
	j2897752247 [label="¿Tienes sus notas?",shape=box,color=red];
		j2897752247 -> j2227365706;
	j2520618110 [label="¿Es eso un problema? ¿A una niña como tú no le encantaría Internet? ",shape=box,color=red];
		j2520618110 -> j2322558332;
	j3135231552 [label="?",shape=box,color=blue];
		j3135231552 -> j1485182673;
		j3135231552 -> j1224380597;
	j2227365706 [label="No exactamente. Sólo lo que vi cuando lo encontré. No creo que esperara que lo encontraran.",shape=box,color=blue];
		j2227365706 -> j448789439;
	j2322558332 [label="Check boolean KayaSetKid",color=orange];
		j2322558332 -> j2673398168 [label=true,color=green];
		j2322558332 -> j2780568705 [label=false,color=brown];
	j1485182673 [label="Lo siento, era una broma... Existen en el futuro.",shape=box,color=red];
		j1485182673 -> j1363951022;
	j1224380597 [label="Es una broma. Relájate.",shape=box,color=red];
		j1224380597 -> j874650605;
	j448789439 [label="Boolean KayaSetFound is now true.",color=orange];
		j448789439 -> j469973358;
		j448789439 -> j3783148031;
	j2673398168 [label="¿Te hace sentir mejor seguir llamándome niña? ¿No lo entiendes?",shape=box,color=blue];
		j2673398168 -> j583526763;
	j2780568705 [label="No sabes nada de mí.",shape=box,color=blue];
		j2780568705 -> j1557784581;
	j1363951022 [label="Está bien.",shape=box,color=blue];
		j1363951022 -> j1036398430;
	j874650605 [label="No.",shape=box,color=blue];
		j874650605 -> j1557784581;
	j469973358 [label="¿TÚ? ¿Encontraste a Entrati cuando nadie más pudo?",shape=box,color=red];
		j469973358 -> j1358996795;
	j3783148031 [label="¿Lo encontraste? ¿Cómo?",shape=box,color=red];
		j3783148031 -> j1358996795;
	j583526763 [label="Tuve que crecer RÁPIDO. La gente de este maldito Internet se encargó de que así fuera.",shape=box,color=blue];
		j583526763 -> j1557784581;
	j1557784581 [label="+20 Chemistry",color=orange];
		j1557784581 -> "Chat ends. Next chat will be KayaRank1Convo3.";
	j1036398430 [label="+20 Chemistry",color=orange];
		j1036398430 -> j2167473051;
	j1358996795 [label="Quería respuestas.",shape=box,color=blue];
		j1358996795 -> j1534094940;
	"Chat ends. Next chat will be KayaRank1Convo3." [color=orange];
	j2167473051 [label="¿Y estás seguro de que no habrá Internet en tu futuro? ¿Totalmente seguro?",shape=box,color=blue];
		j2167473051 -> j3741562322;
	j1534094940 [label="+20 Chemistry",color=orange];
		j1534094940 -> j2660098369;
	j3741562322 [label="De hecho, olvida lo que dije. Lo averiguaré cuando llegue.",shape=box,color=blue];
		j3741562322 -> j1557784581;
	j2660098369 [label="Las cosas cambiaron demasiado rápido en este agujero de mierda. Especialmente en los cuartos secretos de Internet donde se habla de este Doktor.",shape=box,color=blue];
		j2660098369 -> j421754161;
	j421754161 [label="Y bueno, lo encontré, lo sorprendí. Y, Dios mío, el abuelo Doktor no estaba contento, pero fui directo al grano.",shape=box,color=blue];
		j421754161 -> j4039852653;
	j4039852653 [label="Sabía que él venía del futuro. Él sabía que yo lo sabía. Me dio una opción y bueno, no importa. Ahora te encontré. ",shape=box,color=blue];
		j4039852653 -> j3366407463;
	j3366407463 [label="Y de alguna manera también te doy una opción: ayúdame o arrepiéntete.",shape=box,color=blue];
		j3366407463 -> j1802028445;
		j3366407463 -> j1475539412;
	j1802028445 [label="Qué simpática. No soy tu enemigo, ¿sabes?",shape=box,color=red];
		j1802028445 -> j1048624886;
	j1475539412 [label="¿Amenazas a todos tus nuevos amigos?",shape=box,color=red];
		j1475539412 -> j519705931;
	j1048624886 [label="Todavía no, al menos. La gente cambia. Ya veremos.",shape=box,color=blue];
		j1048624886 -> j1557784581;
	j519705931 [label="Sólo para protegerme. ",shape=box,color=blue];
		j519705931 -> j1557784581;
}