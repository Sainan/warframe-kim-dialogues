	j3305805775 [label="Porque si alguien está leyendo esto, fue KAYA VELASCO quien lo descubrió.",shape=box,color=blue];
		j3305805775 -> j2356106634;
	j1878447323 [label="Y si saliera, sería una crueldad. Sería demasiado peligrosa como para que alguien me siguiera.",shape=box,color=blue];
		j1878447323 -> j2130711998;
	j2356106634 [label="Si vas a buscar mi nombre, encuentra dos cosas: que ENCONTRÉ LA SOLUCIÓN, y que SALÍ de 1999.",shape=box,color=blue];
