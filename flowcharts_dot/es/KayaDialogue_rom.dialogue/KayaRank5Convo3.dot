digraph {
	graph [fontname="Roboto Condensed"];
	node [fontname="Roboto Condensed"];
	edge [fontname="Roboto Condensed"];

	"KayaRank5Convo3 begins." [color=orange];
		"KayaRank5Convo3 begins." -> j1931337280;
	j1931337280 [label="Ahhh, hola, ¿puedo presentarte un tutorial sobre las CARTAS JINYMON?",shape=box,color=blue];
		j1931337280 -> j3323657453;
	j3323657453 [label="Amir, por supuesto, está emocionado de finalmente tener alguien con quien jugar (y perder).",shape=box,color=blue];
		j3323657453 -> j4056474915;
	j4056474915 [label="Pero ambos pensamos que sería divertido que conocieras las Jinymon. ",shape=box,color=blue];
		j4056474915 -> j2413649400;
		j4056474915 -> j608647035;
		j4056474915 -> j4092030335;
	j2413649400 [label="Ustedes jueguen. Yo no tengo tiempo. [Fin]",shape=box,color=red];
		j2413649400 -> j145506587;
	j608647035 [label="Tengo algunos hölares quemándome el bolsillo, ¿por dónde empezamos?",shape=box,color=red];
		j608647035 -> j2666218078;
	j4092030335 [label="Recuérdame... ¿de qué estamos hablando?",shape=box,color=red];
		j4092030335 -> j256236629;
	j145506587 [label="+20 Chemistry",color=orange];
		j145506587 -> "Chat ends. Next chat will be KayaRank5Convo4.";
	j2666218078 [label="¡Ooookay, sí! Bien, primero, centrémonos en ti. ¿Te ves más como un dragón, un águila o una pantera?",shape=box,color=blue];
		j2666218078 -> j2202718511;
		j2666218078 -> j4210387402;
		j2666218078 -> j3442209588;
	j256236629 [label="¡Del programa, juego y tarjetas coleccionables más populares de 1999!",shape=box,color=blue];
		j256236629 -> j3509658241;
	"Chat ends. Next chat will be KayaRank5Convo4." [color=orange];
	j2202718511 [label="Una pantera.",shape=box,color=red];
		j2202718511 -> j1062148485;
	j4210387402 [label="Un águila.",shape=box,color=red];
		j4210387402 -> j188813319;
	j3442209588 [label="Un dragón.",shape=box,color=red];
		j3442209588 -> j2144536892;
	j3509658241 [label="Ya sabes, como criaturas y personajes súper cool...",shape=box,color=blue];
		j3509658241 -> j3638496816;
	j1062148485 [label="OK, entonces, ABSOLUTAMENTE querrías comenzar el juego con Tailala",shape=box,color=blue];
		j1062148485 -> j2271436010;
	j188813319 [label="OK, entonces, DEFINITIVAMENTE querrías comenzar el juego con Plumebert",shape=box,color=blue];
		j188813319 -> j1679864915;
	j2144536892 [label="OK, entonces, PROBABLEMENTE querrías comenzar el juego con Frogobogo.",shape=box,color=blue];
		j2144536892 -> j571035429;
	j3638496816 [label="Supongo que no es ese el punto. De todos modos, empecemos por ti. ¿Te ves más como un dragón, un águila o una pantera?",shape=box,color=blue];
		j3638496816 -> j2202718511;
		j3638496816 -> j4210387402;
		j3638496816 -> j3442209588;
	j2271436010 [label="Lo cual es la opción más cool, pero definitivamente complicada, comienza muy débil.",shape=box,color=blue];
		j2271436010 -> j1232673135;
	j1679864915 [label="Lo cual es un poco avanzado pero realmente cool. ",shape=box,color=blue];
		j1679864915 -> j2672155934;
	j571035429 [label="Lo cual es una gran opción para principiantes. ",shape=box,color=blue];
		j571035429 -> j1063316041;
	j1232673135 [label="Pero al final, la pantera más hermosa y majestuosa es básicamente tuya.",shape=box,color=blue];
		j1232673135 -> j82391539;
	j2672155934 [label="Y Plumebert es súper lindo porque puedes alimentarlo con uvas efervescentes para subir de nivel más rápido que los demás.",shape=box,color=blue];
		j2672155934 -> j3144093551;
	j1063316041 [label="Y claro, comienzas con la rana más linda que haya existido, pero eventualmente, si ganas suficientes batallas...",shape=box,color=blue];
		j1063316041 -> j3625160975;
	j82391539 [label="Una elección verdaderamente elegante.",shape=box,color=blue];
		j82391539 -> j2605091381;
	j3144093551 [label="Lo que te permitirá desbloquear todo un sistema de recolección.",shape=box,color=blue];
		j3144093551 -> j2605091381;
	j3625160975 [label="Puedes convertir a Frogobogo en un DRAGÓN.",shape=box,color=blue];
		j3625160975 -> j2605091381;
	j2605091381 [label="¿De qué trata exactamente este juego...?",shape=box,color=red];
		j2605091381 -> j1144022206;
	j1144022206 [label="Bien, entonces recolectas Jinymons y ellos luchan por ti y puedes vivir aventuras.",shape=box,color=blue];
		j1144022206 -> j624581692;
	j624581692 [label="Pero eso es en la versión del videojuego. En la versión del juego de cartas, es como si estuvieras librando batallas solo contra otra persona en la vida real.",shape=box,color=blue];
		j624581692 -> j4221680322;
	j4221680322 [label="Es como si fuera la misma idea. Jinymon, Jinymon, Jinymon. ",shape=box,color=blue];
		j4221680322 -> j734943234;
	j734943234 [label="Entonces, ¿listo para jugar tu primera partida?",shape=box,color=blue];
		j734943234 -> j895000791;
		j734943234 -> j3495173954;
		j734943234 -> j3964309526;
		j734943234 -> j533801501;
	j895000791 [label="De ninguna manera. [Fin]",shape=box,color=red];
		j895000791 -> j145506587;
	j3495173954 [label="Por supuesto, ¿por qué no? La suerte del principiante tiene que estar de mi lado.",shape=box,color=red];
		j3495173954 -> j456073169;
	j3964309526 [label="Sólo quieres una victoria fácil. De ninguna manera.",shape=box,color=red];
		j3964309526 -> j3650787552;
	j533801501 [label="No, ahora todo está menos claro. ¡No me explicaste nada! ",shape=box,color=red];
		j533801501 -> j3650787552;
	j456073169 [label="Genial... sólo necesitas desembolsar unos 10 000 hölares para obtener tu propio paquete inicial...",shape=box,color=blue];
		j456073169 -> j1563572383;
		j456073169 -> j1796169722;
	j3650787552 [label="Oh, vamos... seré indulgente contigo. ¡Incluso dejaré que Amir te ayude! ",shape=box,color=blue];
		j3650787552 -> j2354995595;
	j1563572383 [label="Si tú lo dices...",shape=box,color=red];
		j1563572383 -> j308498614;
	j1796169722 [label="¡Qué carajo! No tengo esa cantidad de dinero.",shape=box,color=red];
		j1796169722 -> j308498614;
	j2354995595 [label="¡Y si ganas te daré un paquete de Jinymon sin abrir!",shape=box,color=blue];
		j2354995595 -> j605676861;
		j2354995595 -> j1084340226;
		j2354995595 -> j1798267792;
	j308498614 [label="No hay problema, si pudieras poner tu información bancaria aquí...",shape=box,color=blue];
		j308498614 -> j3058326752;
		j308498614 -> j2942537287;
	j605676861 [label="Bueno, está bien. Sólo si me ayuda Amir.",shape=box,color=red];
		j605676861 -> j456073169;
	j1084340226 [label="¿Qué tal después?",shape=box,color=red];
		j1084340226 -> j3341254301;
	j1798267792 [label="¡De ninguna manera! ",shape=box,color=red];
		j1798267792 -> j3341254301;
	j3058326752 [label="¡No voy a caer en eso!",shape=box,color=red];
		j3058326752 -> j4183155597;
	j2942537287 [label="Está bien, 4...1",shape=box,color=red];
		j2942537287 -> j4281148566;
	j3341254301 [label="Okeeeey.",shape=box,color=blue];
		j3341254301 -> j145506587;
	j4183155597 [label="Felicidades, pasaste la prueba de seguridad K.O.L. ",shape=box,color=blue];
		j4183155597 -> j2229089576;
	j4281148566 [label="¡AY, NO! Era una prueba. ¡Uno NO pone su información bancaria en los servicios de internet de K.O.L.! ",shape=box,color=blue];
		j4281148566 -> j3610506216;
	j2229089576 [label="Ay, Amir estaba segurísimo de que caerías en la trampa.",shape=box,color=blue];
		j2229089576 -> j545356543;
	j3610506216 [label="¡Ugh, maldición! Le debo un juego a Amir. Dijo que caerías en la trampa.",shape=box,color=blue];
		j3610506216 -> j145506587;
	j545356543 [label="Pero sí, jugamos más tarde.",shape=box,color=blue];
		j545356543 -> j145506587;
}