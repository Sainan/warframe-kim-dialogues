	j572005521 [label="Confío en ti.",shape=box,color=blue];
		j572005521 -> j353754866;
	j353754866 [label="Aunque eso no significa que me quedaré aquí sin una opción de escape.",shape=box,color=blue];
		j353754866 -> j3206636276;
		j353754866 -> j3785957008;
		j353754866 -> j193926071;
	j3206636276 [label="Me alegro de que ahora confiemos el uno en el otro [Fin]",shape=box,color=red];
		j3206636276 -> j465934596;
	j3785957008 [label="¿Qué tan cerca estás de asegurar tu \"escape\"?",shape=box,color=red];
		j3785957008 -> j4149740948;
	j193926071 [label="¿Qué te convenció?",shape=box,color=red];
		j193926071 -> j4143048729;
	j465934596 [label="+20 Chemistry",color=orange];
		j465934596 -> "Chat ends. Next chat will be KayaRank4Convo4.";
	j4149740948 [label="Ehhh... ¿me lo vuelves a preguntar mañana?",shape=box,color=blue];
		j4149740948 -> j3322622330;
	j4143048729 [label="Sé que ya hemos dejado atrás la secundaria. ",shape=box,color=blue];
		j4143048729 -> j3574533705;
	"Chat ends. Next chat will be KayaRank4Convo4." [color=orange];
	j3322622330 [label="Podría estar bastante cerca, realmente estoy en algo.",shape=box,color=blue];
		j3322622330 -> j3816685351;
		j3322622330 -> j2607949083;
	j3574533705 [label="Pero no hace falta ser un genio para ver que realmente te preocupas por nosotros. Y todos te respetamos.",shape=box,color=blue];
		j3574533705 -> j2434685091;
	j3816685351 [label="¿Cerca de escapar de 1999?",shape=box,color=red];
		j3816685351 -> j3673814240;
	j2607949083 [label="¿Cual es la pista actual?",shape=box,color=red];
		j2607949083 -> j328467787;
	j2434685091 [label="Hasta Arthur. Y antes que nada, tengo que decirlo, ¡él me encanta!",shape=box,color=blue];
		j2434685091 -> j1211137507;
	j3673814240 [label="¡Sip! Por supuesto, hay algunas reservas. La forma más segura es ir EXACTAMENTE al lugar de donde viniste, porque hay una especie de \"huella digital del Vacío\" allí.",shape=box,color=blue];
		j3673814240 -> j2219466429;
		j3673814240 -> j3777722660;
		j3673814240 -> j3459558524;
	j328467787 [label="Tú, por supuesto.",shape=box,color=blue];
		j328467787 -> j1818049398;
		j328467787 -> j1093266213;
	j1211137507 [label="Check boolean ArthurDating",color=orange];
		j1211137507 -> j3545357315 [label=true,color=green];
		j1211137507 -> j2559720252 [label=false,color=brown];
		j1211137507 -> j2279067760 [label=false,color=brown];
	j2219466429 [label="Entonces, ¿estás segura de esto?",shape=box,color=red];
		j2219466429 -> j2683394697;
	j3777722660 [label="Mis tiempos no son precisamente mejores, pero al menos estoy ahí para ayudar.",shape=box,color=red];
		j3777722660 -> j2387201478;
	j3459558524 [label="Hmm, el Vacío realmente se toma los dedos muy en serio.",shape=box,color=red];
		j3459558524 -> j827244180;
	j1818049398 [label="Debo ser alguien especial.",shape=box,color=red];
		j1818049398 -> j3673814240;
	j1093266213 [label="¿Yo?",shape=box,color=red];
		j1093266213 -> j3673814240;
	j3545357315 [label="Sí sabes que está con alguien, ¿no?",shape=box,color=red];
		j3545357315 -> j2335140282;
	j2559720252 [label="Hablaré bien de ti.",shape=box,color=red];
		j2559720252 -> j3157704961;
	j2279067760 [label="Puaj.",shape=box,color=red];
		j2279067760 -> j4110442029;
	j2683394697 [label="Segurísima. Es un reto. Que pase lo que pase, ¿no? Además, me mantiene ocupada, concentrada... ",shape=box,color=blue];
		j2683394697 -> j1217118289;
	j2387201478 [label="¡Exactamente! ¡Quememos los barcos! ¡No hay vuelta atrás!",shape=box,color=blue];
		j2387201478 -> j465934596;
	j827244180 [label="¿Eh?",shape=box,color=blue];
		j827244180 -> j3431320681;
	j2335140282 [label="Uff, ya lo sé, ¡qué SUERTE tiene! En fin.",shape=box,color=blue];
		j2335140282 -> j2714948763;
	j3157704961 [label="UFF, ¡NO, por favor, no lo hagas! ¡Te lo dije en CONFIANZA! Como sea...",shape=box,color=blue];
		j3157704961 -> j2714948763;
	j4110442029 [label="¿Eh? ¿Estás loco? Nada de puaj. ¡EN FIN!",shape=box,color=blue];
		j4110442029 -> j2714948763;
	j1217118289 [label="No hay lado negativo. O lo descubro o no lo descubro. Nos vemos aquí o nos vemos allá. ¿Cierto? ¡Hasta luego!",shape=box,color=blue];
		j1217118289 -> j465934596;
	j3431320681 [label="Todo esto, todo lo que hizo Entrati. Su búsqueda del Vacío, la esencia de... todo.",shape=box,color=red];
		j3431320681 -> j812885115;
	j2714948763 [label="Pero en cierto sentido es como la secundaria, a todo el mundo le gustas.",shape=box,color=blue];
		j2714948763 -> j3066043263;
	j812885115 [label="Todo se reduce a un dedo. Un dedo.",shape=box,color=red];
		j812885115 -> j2659280804;
	j3066043263 [label="Y eso dice algo más profundo que sólo popularidad.",shape=box,color=blue];
		j3066043263 -> j128499520;
	j2659280804 [label="¿Te tomaste las cervezas de Arthur? ¿Por qué no lo mencionaste antes?",shape=box,color=blue];
		j2659280804 -> j4247680079;
		j2659280804 -> j3615625625;
		j2659280804 -> j382980555;
	j128499520 [label="Todos estamos un poco trastornados. ",shape=box,color=blue];
		j128499520 -> j3348071059;
		j128499520 -> j3427435739;
		j128499520 -> j1477189399;
	j4247680079 [label="El Vacío. Los libros de texto no ayudan mucho en ese tema.",shape=box,color=red];
		j4247680079 -> j2642061675;
	j3615625625 [label="Una cerveza probablemente ayudaría a que las cosas tengan sentido.",shape=box,color=red];
		j3615625625 -> j2642061675;
	j382980555 [label="No es algo que simplemente se \"mencione\". Es el fin y el principio.",shape=box,color=red];
		j382980555 -> j2642061675;
	j3348071059 [label="¡Trastornados y ocupados! Bienvenida al equipo. [Fin]",shape=box,color=red];
		j3348071059 -> j465934596;
	j3427435739 [label="¿Quién crees que esté más trastornado?",shape=box,color=red];
		j3427435739 -> j1398906263;
	j1477189399 [label="¿Eso es un cumplido?",shape=box,color=red];
		j1477189399 -> j2299142443;
	j2642061675 [label="Pero, ¿qué quieres decir con un dedo?",shape=box,color=blue];
		j2642061675 -> j3417615360;
		j2642061675 -> j370195404;
	j1398906263 [label="Ay, Dios... ¿chisme? ¿Después de lo que acabo de decir? ",shape=box,color=blue];
		j1398906263 -> j922080589;
	j2299142443 [label="Absolutamente. Cien por ciento. Porque aquí nadie está compitiendo.",shape=box,color=blue];
		j2299142443 -> j242813707;
	j3417615360 [label="Albrecht tiene su dedo.",shape=box,color=red];
		j3417615360 -> j3965160224;
	j370195404 [label="Hay un dedo de... eso. En mi tiempo. De nuestro mundo, supongo.",shape=box,color=red];
		j370195404 -> j3965160224;
	j922080589 [label="(Pero obviamente Arthur, porque estaba hablando con él y parece que realmente te metiste con su cabeza).",shape=box,color=blue];
		j922080589 -> j1037203744;
	j242813707 [label="Es algo muy extraño. Nos estamos convirtiendo en monstruos, pero es lo más humano que me he sentido nunca.",shape=box,color=blue];
		j242813707 -> j2243213711;
	j3965160224 [label="Ok, entonces se mantiene el tema, ¡gracias!",shape=box,color=blue];
		j3965160224 -> j1909197043;
	j1037203744 [label="Lo cual, por cierto, confirmó una hipótesis que tenía sobre tu conexión corpórea con 1999.",shape=box,color=blue];
		j1037203744 -> j3590390290;
	j2243213711 [label="Ahora realmente puedo ser yo misma.",shape=box,color=blue];
		j2243213711 -> j4292837979;
	j1909197043 [label="¿Eso es todo?",shape=box,color=red];
		j1909197043 -> j907039886;
	j3590390290 [label="Lo cual es relevante porque... ¡Ah! Prueba finalizada. Nos vemos pronto.",shape=box,color=blue];
		j3590390290 -> j465934596;
	j4292837979 [label="Ya no tengo miedo.",shape=box,color=blue];
		j4292837979 -> j2731363410;
	j907039886 [label="¿Ni siquiera un \"qué es eso\"? ¿Por qué tiene un dedo?",shape=box,color=red];
		j907039886 -> j1500076146;
	j2731363410 [label="Así que... ¿gracias?",shape=box,color=blue];
		j2731363410 -> j465934596;
	j1500076146 [label="Puedes encargarte de ello. Son más interesantes los estados de conservación de la materia. ¡Gracias!",shape=box,color=blue];
		j1500076146 -> j465934596;
}