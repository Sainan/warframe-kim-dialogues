	j2131313305 [label="+5 Chemistry",color=orange];
		j2131313305 -> j3517992619;
	j3459206266 [label="Él estaba en su computadora o algo así.",shape=box,color=blue];
		j3459206266 -> j1937391307;
	j997073770 [label="Bueno, supongo que tratamos de aprovechar al máximo nuestras herramientas. ¿Hablaste con Amir sobre tus preguntas?",shape=box,color=red];
		j997073770 -> j2291959845;
	j368315635 [label="Check boolean KayaLettieHeal",color=orange];
		j368315635 -> j1263606237 [label=true,color=green];
		j368315635 -> j2752863574 [label=false,color=brown];
	j2347462154 [label="Sí, no te conozco. Sólo sé lo que puedes hacer. Por eso estamos hablando. Y habla en serio.",shape=box,color=blue];
		j2347462154 -> j706105843;
	j1631459172 [label="Una promesa de un extraño en Internet. Dame un respiro. Ja. Sólo dime lo que quiero saber.",shape=box,color=blue];
		j1631459172 -> j472482639;
	j1937391307 [label="Y aparezco y él se asusta. De verdad. Era como si NO esperara que alguien apareciera.",shape=box,color=blue];
		j1937391307 -> j2999127209;
		j1937391307 -> j213140131;
	j2291959845 [label="Sí. Coincidimos en algunos aspectos fundamentales, pero no parece interesado en un teorema de viaje en el tiempo concreto y reproducible. ",shape=box,color=blue];
		j2291959845 -> j1872363997;
	j1263606237 [label="Bueno, supongo que tratamos de aprovechar al máximo nuestras herramientas. ¿Has hablado con Lettie? Creo que se llevarían bien.",shape=box,color=red];
		j1263606237 -> j614273264;
	j2752863574 [label="De acuerdo, sólo quería decir que sería un poco más fácil, supongo, si tuviera acceso a más herramientas de mi tiempo.",shape=box,color=red];
		j2752863574 -> j485788575;
	j706105843 [label="Bueno, seamos serios.",shape=box,color=red];
		j706105843 -> j4119344233;
		j706105843 -> j1841725918;
	j472482639 [label="¿Te pasó algo?",shape=box,color=red];
		j472482639 -> j848742098;
	j2999127209 [label="Vaya, eso es impresionante.",shape=box,color=red];
		j2999127209 -> j2936212324;
	j213140131 [label="Guau, ¿en serio estás alardeando?",shape=box,color=red];
		j213140131 -> j2936212324;
	j1872363997 [label="De hecho, me convenció de que estaba equivocada en algunas de mis hipótesis originales, así que eso me ayudó, pero me recordó que tal vez pueda pagar para obtener una respuesta, o al menos pagar para hablar con alguien más del futuro si no me ayudas.",shape=box,color=blue];
		j1872363997 -> j1372891231;
		j1872363997 -> j2286052093;
	j614273264 [label="Nos llevamos bien. Me recuerda a una profesora que tuve una vez, no era desagradable y reconocía mi intelecto.",shape=box,color=blue];
		j614273264 -> j1435192695;
	j485788575 [label="¿Es una oferta? ¿A qué puedo acceder? Cualquier cosa sería de ayuda.",shape=box,color=blue];
		j485788575 -> j929084480;
	j4119344233 [label="Quieres viajar en el tiempo, pero ¿adónde? ¿Por qué?",shape=box,color=red];
		j4119344233 -> j3739305361;
	j1841725918 [label="¿Has mirado a tu alrededor?",shape=box,color=red];
		j1841725918 -> j1576602055;
	j848742098 [label="A todos nos ha pasado algo. Avísame si encuentras una manera de ayudarme. ",shape=box,color=blue];
		j848742098 -> j3994434447;
	j2936212324 [label="Ugh, ¿por qué te cuento esto?",shape=box,color=blue];
		j2936212324 -> j1871153838;
	j1372891231 [label="Por 10 hölares te diré cómo mueres.",shape=box,color=red];
		j1372891231 -> j2228029214;
	j2286052093 [label="Cualquiera que te venda algo así te está mintiendo. Intentaré ayudarte, realmente lo haré. Y gratis.",shape=box,color=red];
		j2286052093 -> j459150327;
	j1435192695 [label="De hecho, es muy tranquila y también inteligente. Me dijo que confiara en ti de verdad, así que, bueno, ya veremos.",shape=box,color=blue];
		j1435192695 -> j2738387023;
		j1435192695 -> j701024863;
	j929084480 [label="Veré qué puedo encontrar para ti, si quieres resolverlo en tus propios términos.",shape=box,color=red];
		j929084480 -> j2669868400;
	j3739305361 [label="¿Acaso no puedes adivinar NADA? Ugh.",shape=box,color=blue];
		j3739305361 -> j3680018756;
	j1576602055 [label="Sí. Ya lo vi todo. Ese punto de inflexión milagroso en el milenio. Invitaciones a tantas vacaciones porque la gente quería que \"esa chica\" estuviera allí.",shape=box,color=blue];
		j1576602055 -> j1847854987;
	j1871153838 [label="Sólo dime, ¿tengo que ahorrar o algo?",shape=box,color=blue];
		j1871153838 -> j711114253;
		j1871153838 -> j2604645348;
	j2228029214 [label="Ugh. Qué enfermo.",shape=box,color=blue];
		j2228029214 -> j3994434447;
	j459150327 [label="Ya veremos, ¿no?",shape=box,color=blue];
		j459150327 -> j3994434447;
	j2738387023 [label="No estoy aquí para traicionarte ni nada, y no soy un libro de texto de viajes en el tiempo.",shape=box,color=red];
		j2738387023 -> j2458663320;
	j701024863 [label="Te prometo que puedes confiar en mí, no estoy seguro de por qué eres tan hostil.",shape=box,color=red];
		j701024863 -> j876834305;
	j2669868400 [label="Sí quiero. Y lo haré.",shape=box,color=blue];
		j2669868400 -> j3994434447;
	j3680018756 [label="¿Quién querría quedarse aquí? En serio...",shape=box,color=blue];
		j3680018756 -> j3513504567;
	j1847854987 [label="Esto nunca se detendrá. Mira hacia el futuro. Avísame cuando puedas ayudarme.",shape=box,color=blue];
		j1847854987 -> j3994434447;
	j711114253 [label="Kaya, creo que estás demasiado obsesionada con esto. ¿Y si no puedes entenderlo?",shape=box,color=red];
		j711114253 -> j443139111;
	j2604645348 [label="Ni idea. Soy el elegiiiidoooo, Kaya. ",shape=box,color=red];
		j2604645348 -> j1850687974;
	j2458663320 [label="Ugh. OK",shape=box,color=blue];
		j2458663320 -> j3994434447;
	j876834305 [label="Tengo mis razones",shape=box,color=blue];
		j876834305 -> j3994434447;
	j3513504567 [label="Lo resolveré, sé que puedo, así que, sí. Adiós.",shape=box,color=blue];
		j3513504567 -> j3994434447;
	j443139111 [label="Lo haré.",shape=box,color=blue];
		j443139111 -> j3994434447;
	j1850687974 [label="Sí, el elegido para ser IMBÉCIL",shape=box,color=blue];
		j1850687974 -> j3994434447;
