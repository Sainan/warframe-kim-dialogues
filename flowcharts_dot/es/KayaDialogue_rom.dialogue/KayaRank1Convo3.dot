		"KayaRank1Convo3 begins." -> j2384506747;
	j2384506747 [label="Viajar en el tiempo... ¿es caro? ¿Tiene un costo asociado a las materias primas? ¿O, en tu época, se ha convertido en una mercancía que de alguna manera es relevante para algo aquí?",shape=box,color=blue];
