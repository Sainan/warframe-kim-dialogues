		j781731815 -> j248492207;
	j1904130597 [label="Debiste haber sido una gran estudiante.",shape=box,color=red];
		j1904130597 -> j953610800;
	j3548726252 [label="No tengo por qué ser humilde. Obtuve la nota más alta en la historia de mi secundaria Y en mi primer año de universidad tuve el mejor récord académico en 100 años.",shape=box,color=blue];
		j3548726252 -> j1420084216;
		j3548726252 -> j2448615386;
	j248492207 [label="¿Has oído hablar de \"Nora Night\"?",shape=box,color=blue];
		j248492207 -> j2562237740;
		j248492207 -> j1139310633;
	j953610800 [label="Obtuve la nota más alta en la historia de mi secundaria Y en mi primer año de universidad tuve el mejor récord académico en 100 años.",shape=box,color=blue];
		j953610800 -> j2187461810;
	j1420084216 [label="Pero eso no significa que puedas hacer un pastel, a menos que hayas estudiado repostería.",shape=box,color=red];
		j1420084216 -> j1623350814;
	j2448615386 [label="Pero no eres lo suficientemente inteligente como para no tomar el suero de Entrati, ¿eh?",shape=box,color=red];
		j2448615386 -> j2084081974;
	j2562237740 [label="Creo que sí, pero seguro que ha oído hablar de mí.",shape=box,color=red];
		j2562237740 -> j2145852699;
	j1139310633 [label="Guau, sí. Ella es de mi época.",shape=box,color=red];
		j1139310633 -> j2145852699;
	j2187461810 [label="Yo era más que una excelente estudiante. Había universidades que me pedían que fuera allí. Mi primer año hubiera sido perfecto...",shape=box,color=blue];
