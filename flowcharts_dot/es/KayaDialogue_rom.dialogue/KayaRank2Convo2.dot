	j410486491 [label="Hola. ¿Podrías confirmarme algo? ",shape=box,color=blue];
		j410486491 -> j116878715;
	j116878715 [label="¿La clave de tus habilidades para viajar en el tiempo es una mezcla de tecnocito y del Vacío, en alguna proporción?",shape=box,color=blue];
		j116878715 -> j2776473512;
		j116878715 -> j4094814185;
	j2776473512 [label="¿Una mezcla? ¿Estamos horneando un pastel?",shape=box,color=red];
		j2776473512 -> j3520822839;
	j4094814185 [label="Entonces, ¿tus estudios van bien?",shape=box,color=red];
		j4094814185 -> j3280245045;
	j3520822839 [label="Nunca intenté hacer uno, pero apuesto a que me quedaría delicioso.",shape=box,color=blue];
		j3520822839 -> j119862243;
		j3520822839 -> j2430287065;
	j3280245045 [label="Muy bien. Estoy muy cerca, de hecho. Muy cerca.",shape=box,color=blue];
