		j2084081974 -> j1197618309;
		j2084081974 -> j810300984;
	j2145852699 [label="Mmm, claro. ¡Pues bien, he conseguido crear una fórmula de intercepción temporal que acabó recibiendo ondas sonoras! ",shape=box,color=blue];
		j2145852699 -> j154584925;
	j3659152549 [label="Si no fuera por... ¿todo esto?",shape=box,color=red];
