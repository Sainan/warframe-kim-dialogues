	j2337921710 [label="¿Hay un sol?",shape=box,color=blue];
		j2337921710 -> j854834280;
		j2337921710 -> j3975457994;
	j2128993099 [label="Creo que sí. Lo sabría si desapareciera cuando me fuera.",shape=box,color=red];
		j2128993099 -> j3465798795;
	j3681789745 [label="¿Qué pasa si te pierdes en algún lugar, en algún momento?",shape=box,color=red];
		j3681789745 -> j1748637660;
	j634398199 [label="No me importa seguir con todo esto, pero ¿de verdad crees que encontrarás una manera de salir de 1999?",shape=box,color=red];
