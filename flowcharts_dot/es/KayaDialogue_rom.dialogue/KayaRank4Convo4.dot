	j2016166560 [label="Y el sistema donde está el otro niño es un lugar en el que he estado.",shape=box,color=red];
		j2016166560 -> j1529376289;
	j1529376289 [label="Mmm, todos tus pasos son realmente la clave para que yo pueda \"seguirte con seguridad\", ¿sabes?",shape=box,color=blue];
		j1529376289 -> j3318143629;
	j3318143629 [label="Boolean KayaFutureWin1 is now true.",color=orange];
		j3318143629 -> j1319623791;
	j1319623791 [label="Cuando se trata de partículas que son atraídas hacia su siguiente forma, es como una gran señal luminosa de salida del Vacío.",shape=box,color=blue];
		j1319623791 -> j3259519759;
	j3259519759 [label="Ah, perdón, pero, mmm, ¿qué es 'Duviri'? ¿Un estado de la materia? ",shape=box,color=blue];
		j3259519759 -> j1032787997;
		j3259519759 -> j1651028046;
	j1032787997 [label="Es un lugar que creé en el Vacío.",shape=box,color=red];
		j1032787997 -> j4072390018;
	j1651028046 [label="En muchos sentidos, es mi verdadero hogar. Donde... crecí.",shape=box,color=red];
		j1651028046 -> j309918286;
	j4072390018 [label="Lleno de encarnaciones de conceptos y emociones.",shape=box,color=red];
		j4072390018 -> j1667009547;
	j309918286 [label="Está en el Vacío.",shape=box,color=red];
		j309918286 -> j2769248137;
	j1667009547 [label="Básicamente, es un \"libro de texto\" que cobró vida.",shape=box,color=red];
		j1667009547 -> j3207297049;
	j2769248137 [label="Sin embargo, no recibimos muchas visitas estos días.",shape=box,color=red];
		j2769248137 -> j1220701245;
	j3207297049 [label="¡Jaja! Dios mío. Ok, ya veo, ¿y está en el Vacío?",shape=box,color=blue];
		j3207297049 -> j1330723586;
	j1220701245 [label="Prepara la alfombra roja en caso de que aparezca.",shape=box,color=blue];
		j1220701245 -> j483519544;
		j1220701245 -> j977448795;
		j1220701245 -> j499536072;
	j1330723586 [label="Sí, pero vinculado a la Zariman.",shape=box,color=red];
		j1330723586 -> j120263212;
	j483519544 [label="No vuelvo allí a menudo...",shape=box,color=red];
		j483519544 -> j979349776;
	j977448795 [label="¿De verdad crees que irás allí?",shape=box,color=red];
		j977448795 -> j1347028722;
	j499536072 [label="¡Cuenta con ello, viajera espacial! [FIN]",shape=box,color=red];
		j499536072 -> j392027042;
	j120263212 [label="Como una gran luna de metal.",shape=box,color=red];
		j120263212 -> j2337921710;
	j979349776 [label="¿Aún está ahí? ¿Cómo puedes estar seguro?",shape=box,color=blue];
