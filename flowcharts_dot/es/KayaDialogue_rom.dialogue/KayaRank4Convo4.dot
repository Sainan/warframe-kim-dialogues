	j4218294367 [label="Creo que tengo algo que puede ayudarte.",shape=box,color=red];
		j4218294367 -> j1362385350;
	j1362385350 [label="Hay un lugar que conozco, creo que de ahí vengo, en realidad. Duviri.",shape=box,color=red];
		j1362385350 -> j3424892367;
	j3424892367 [label="Y sigue ahí, aunque ya no esté. En el Vacío.",shape=box,color=red];
