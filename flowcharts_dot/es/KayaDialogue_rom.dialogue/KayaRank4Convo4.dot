		j1487584150 -> j1863655712 [label=false,color=brown];
	j774465526 [label="Todas las cosas del universo conocido se definen por su relación con los cuerpos celestes. Qué extraño es este Vacío.",shape=box,color=blue];
		j774465526 -> j3985413064;
		j774465526 -> j2716891653;
	j735047084 [label="No sé si quiero eso.",shape=box,color=red];
		j735047084 -> j1342159278;
	j3012395548 [label="Si se pudiera, resolveríamos muchos problemas.",shape=box,color=red];
		j3012395548 -> j1342159278;
	j3629073220 [label="¿Se te dificulta la filosofía?",shape=box,color=red];
		j3629073220 -> j473144163;
	j1126590337 [label="A pesar de las circunstancias... si llegamos a ese punto, lo haré. ",shape=box,color=red];
		j1126590337 -> j2006625982;
	j2115611447 [label="Entendido. ",shape=box,color=red];
		j2115611447 -> j2006625982;
	j1863655712 [label="Espero que no llegue a eso.",shape=box,color=red];
		j1863655712 -> j1779594926;
	j3985413064 [label="Es \"el Vacío\". No hay nada hasta que hay algo.",shape=box,color=red];
		j3985413064 -> j3704288431;
	j2716891653 [label="Cuando encontremos a Albrecht tendremos que llevarlo allí o algo así. Todavía no tengo ningún plan.",shape=box,color=red];
		j2716891653 -> j3704288431;
	j1342159278 [label="Bueno, por tu bien supongo que sería divertido tener respuesta a tu enigma científico. Espero que obtengas respuestas.",shape=box,color=blue];
		j1342159278 -> j3612483970;
		j1342159278 -> j4207473213;
	j473144163 [label="Supongo que sí. No es que se me \"dificulte\" exactamente, más bien... a quién le importa el por qué y el quién, sólo hagamos cosas cool.",shape=box,color=blue];
		j473144163 -> j1309249862;
		j473144163 -> j111490442;
	j2006625982 [label="¡Graciaaas!",shape=box,color=blue];
		j2006625982 -> j392027042;
	j1779594926 [label="Meh.",shape=box,color=blue];
		j1779594926 -> j2006625982;
	j3704288431 [label="Pues... parece estar relacionado, pero no es mi tema de estudio. ¡Nos vemos, si nos vemos!",shape=box,color=blue];
		j3704288431 -> j392027042;
	j3612483970 [label="No sé si me gustarán las respuestas, Nova.",shape=box,color=red];
