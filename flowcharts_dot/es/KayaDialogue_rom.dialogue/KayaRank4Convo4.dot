	"Chat ends. Next chat will be KayaRank5Convo1." [color=orange];
	j854834280 [label="Piensa mucho en ello y... ¿tal vez lo haya?",shape=box,color=red];
		j854834280 -> j478626608;
	j3975457994 [label="Estaba siendo poético, no hay sol.",shape=box,color=red];
		j3975457994 -> j297987730;
	j3465798795 [label="¿Tú crees? Hay una escuela científica que podría pensar que la observación de Duviri sería clave para su existencia.",shape=box,color=blue];
		j3465798795 -> j228548639;
		j3465798795 -> j1836670069;
	j1748637660 [label="No sé, y si nunca me vuelves a ver, di algo bonito en mi funeral.",shape=box,color=blue];
		j1748637660 -> j4094990899;
	j1670816907 [label="¡Sí, y avísame si puedes ayudarme! ",shape=box,color=blue];
		j1670816907 -> j392027042;
	j478626608 [label="Ja, ja.",shape=box,color=blue];
		j478626608 -> j3832021951;
	j297987730 [label="¿Algún objeto celeste?",shape=box,color=blue];
		j297987730 -> j869793912;
		j297987730 -> j3738489538;
	j228548639 [label="No estoy seguro de que la ciencia pueda explicar esto. \"Eso\" es la causa de todo esto.",shape=box,color=red];
		j228548639 -> j1625112846;
	j1836670069 [label="Eso suena más a filosofía.",shape=box,color=red];
		j1836670069 -> j4050896884;
	j4094990899 [label="Ah, y dile a Arthur que creo que es lindo... pero sólo si realmente me fui. ",shape=box,color=blue];
