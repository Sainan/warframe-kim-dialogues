digraph {
	"KayaRank3Convo2 begins." [color=orange];
		"KayaRank3Convo2 begins." -> j1829454344;
	j1829454344 [label="Pareces realmente fascinada por los \"viajes en el tiempo\". De hecho, obsesionada.",shape=box,color=red];
		j1829454344 -> j971122585;
	j971122585 [label="Estoy trabajando en ello. Ya casi lo consigo.",shape=box,color=blue];
		j971122585 -> j3613731207;
	j3613731207 [label="Una vez que entiendas el viaje en el tiempo, habrá un problema mayor: el eternalismo. ",shape=box,color=red];
		j3613731207 -> j1797614850;
	j1797614850 [label="Um... ¿qué?",shape=box,color=blue];
		j1797614850 -> j3498801236;
		j1797614850 -> j3344738110;
	j3498801236 [label="Veamos si eres lo suficientemente inteligente para resolver esto. Gracias al eternalismo, existe una versión de esta conversación que no termina aquí. [FIN]",shape=box,color=red];
		j3498801236 -> j3655577789;
	j3344738110 [label="Espero que no estés ocupada, porque esta es la verdadera razón por la que estoy aquí.",shape=box,color=red];
		j3344738110 -> j4278908434;
	j3655577789 [label="Boolean KayaEternalismTest is now true.",color=orange];
		j3655577789 -> j2156753723;
	j4278908434 [label="No lo estoy, por favor explícame. Podría ser increíblemente relevante para los toques teóricos finales sobre la manipulación temporal.",shape=box,color=blue];
		j4278908434 -> j3187599366;
	j2156753723 [label="+20 Chemistry",color=orange];
		j2156753723 -> "Chat ends. Next chat will be KayaRank3Convo3.";
	j3187599366 [label="Todo esto no ocurrió porque un científico descubriera una fórmula.",shape=box,color=red];
		j3187599366 -> j1742648;
	"Chat ends. Next chat will be KayaRank3Convo3." [color=orange];
	j1742648 [label="Bueno, supongo que así fue como empezó.",shape=box,color=red];
		j1742648 -> j2097412683;
	j2097412683 [label="Pero, ¿todo esto ahora? Va más allá de eso. Es porque Albrecht fue a algún lugar, despertó algo y eso lo siguió. El Vacío.",shape=box,color=red];
		j2097412683 -> j3163490423;
		j2097412683 -> j4148517370;
	j3163490423 [label="El Vacío está vivo pero a la vez, no lo está. Es pero no es. Es una paradoja que es la causa y razón de todo lo que nos ha sucedido a cada uno de nosotros.",shape=box,color=red];
		j3163490423 -> j3838699824;
	j4148517370 [label="No existe una \"tabla periódica\" o fórmula para describir lo que es.",shape=box,color=red];
		j4148517370 -> j3928613977;
	j3838699824 [label="Hola, mundo.",shape=box,color=blue];
		j3838699824 -> j60632020;
		j3838699824 -> j1559345280;
	j3928613977 [label="La ciencia puede explicarlo. Lo rige todo.",shape=box,color=blue];
		j3928613977 -> j3668359530;
	j60632020 [label="\"Adiós, Albrecht\"",shape=box,color=red];
		j60632020 -> j1988642735;
	j1559345280 [label="¿Qué?",shape=box,color=red];
		j1559345280 -> j1025084520;
	j3668359530 [label="Check boolean KayaVoidTest",color=orange];
		j3668359530 -> j1928023927 [label=true,color=green];
		j3668359530 -> j801601445 [label=false,color=brown];
	j1988642735 [label="+5 Chemistry",color=orange];
		j1988642735 -> j542593274;
	j1025084520 [label="Fue lo primero que se publicó en Internet. El primer mensaje publicado por el creador de Internet para demostrar que \"funcionaba\".",shape=box,color=blue];
		j1025084520 -> j2579473895;
	j1928023927 [label="Te dije que tuvieras cuidado con el Vacío. Esta es la razón.",shape=box,color=red];
		j1928023927 -> j940311559;
	j801601445 [label="¿Y si no pudiera?",shape=box,color=red];
		j801601445 -> j428292135;
	j542593274 [label="¡Ja! ¡Ojalá! Pero, ¿conoces \"Hola, mundo\"?",shape=box,color=blue];
		j542593274 -> j1025084520;
	j2579473895 [label="Y a partir de ahí se desató el infierno. La gente perdió la cabeza. La ciencia. La banca. La tecnología. El entretenimiento.",shape=box,color=blue];
		j2579473895 -> j2101898125;
	j940311559 [label="Algunas cosas no pueden ser reguladas.",shape=box,color=red];
		j940311559 -> j561137178;
	j428292135 [label="¿Y si todo esto fuera una regla estricta...?",shape=box,color=red];
		j428292135 -> j3538276831;
	j2101898125 [label="Y a través de miles de millones de elecciones, causas y efectos, me llevó a conectarme un día a Internet y... ",shape=box,color=blue];
		j2101898125 -> j829373816;
	j561137178 [label="Algunas cosas no se pueden explicar.",shape=box,color=red];
		j561137178 -> j4215129326;
	j3538276831 [label="Sólo sucedió porque algo ahí afuera así lo quiso.",shape=box,color=red];
		j3538276831 -> j4215129326;
	j829373816 [label="Y fue el fin de Nova, o mejor dicho, de Kaya. Su futuro, su carrera, sus amigos, todo. Por culpa de un error. ",shape=box,color=blue];
		j829373816 -> j1249149815;
	j4215129326 [label="Entonces, estás diciendo que la parte que falta en mis experimentos, pruebas, investigaciones e hipótesis es la \"magia\".",shape=box,color=blue];
		j4215129326 -> j1781374619;
		j4215129326 -> j3915562802;
	j1249149815 [label="Así que supongo que confío más en el Vacío que en otras personas.",shape=box,color=blue];
		j1249149815 -> j2990181518;
		j1249149815 -> j958782671;
		j1249149815 -> j610738071;
	j1781374619 [label="No es magia. Sólo... Vacío. El Vacío. Una energía de algún otro lugar.",shape=box,color=red];
		j1781374619 -> j1271669840;
	j3915562802 [label="¿Has visto lo que puedo hacer? ",shape=box,color=red];
		j3915562802 -> j3367656945;
	j2990181518 [label="No lo hagas. [Fin]",shape=box,color=red];
		j2990181518 -> j2156753723;
	j958782671 [label="Eso es deprimente, Nova.",shape=box,color=red];
		j958782671 -> j1735350466;
	j610738071 [label="Yo también confié.",shape=box,color=red];
		j610738071 -> j1735350466;
	j1271669840 [label="Puedo trabajar con eso.",shape=box,color=blue];
		j1271669840 -> j2553377744;
		j1271669840 -> j1275696813;
	j3367656945 [label="Visto. Observado. Anotado. Estudiado. Reexaminado. Mmmmm. Todo se puede explicar. Tiene su origen en algo. La \"magia\", tal vez.",shape=box,color=blue];
		j3367656945 -> j1271669840;
	j1735350466 [label="Supongo que quizás no lo hayas entendido todo. ",shape=box,color=blue];
		j1735350466 -> j196758520;
	j2553377744 [label="Intentar algo imprudente podría costarte muy caro.",shape=box,color=red];
		j2553377744 -> j1735350466;
	j1275696813 [label="¿Puedes \"trabajar con eso\"?",shape=box,color=red];
		j1275696813 -> j1735350466;
	j196758520 [label="Pero saldré de 1999.",shape=box,color=blue];
		j196758520 -> j114753854;
	j114753854 [label="Literalmente no me importa lo que me pase mientras intento lograr esto.",shape=box,color=blue];
		j114753854 -> j4036626443;
	j4036626443 [label="Es lo único que tengo en mente.",shape=box,color=blue];
		j4036626443 -> j2566758002;
	j2566758002 [label="Y para mí, eso es algo bueno. ",shape=box,color=blue];
		j2566758002 -> j2156753723;
}