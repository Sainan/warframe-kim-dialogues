	472 [label="Bueno, supongo que así fue como empezó.",shape=box,color=red];
		472 -> 473;
	473 [label="Pero, ¿todo esto ahora? Va más allá de eso. Es porque Albrecht fue a algún lugar, despertó algo y eso lo siguió. El Vacío.",shape=box,color=red];
		473 -> 474;
		473 -> 475;
	474 [label="El Vacío está vivo pero a la vez, no lo está. Es pero no es. Es una paradoja que es la causa y razón de todo lo que nos ha sucedido a cada uno de nosotros.",shape=box,color=red];
		474 -> 476;
	475 [label="No existe una \"tabla periódica\" o fórmula para describir lo que es.",shape=box,color=red];
		475 -> 477;
	476 [label="Hola, mundo.",shape=box,color=blue];
		476 -> 478;
		476 -> 479;
	477 [label="La ciencia puede explicarlo. Lo rige todo.",shape=box,color=blue];
		477 -> 480;
	478 [label="\"Adiós, Albrecht\"",shape=box,color=red];
		478 -> 481;
	479 [label="¿Qué?",shape=box,color=red];
		479 -> 482;
	480 [label="Check boolean KayaVoidTest",color=orange];
		480 -> 484 [label=true,color=green];
		480 -> 483 [label=false,color=brown];
	481 [label="+5 Chemistry",color=orange];
		481 -> 485;
	482 [label="Fue lo primero que se publicó en Internet. El primer mensaje publicado por el creador de Internet para demostrar que \"funcionaba\".",shape=box,color=blue];
		482 -> 486;
	484 [label="Te dije que tuvieras cuidado con el Vacío. Esta es la razón.",shape=box,color=red];
		484 -> 488;
	483 [label="¿Y si no pudiera?",shape=box,color=red];
		483 -> 487;
	485 [label="¡Ja! ¡Ojalá! Pero, ¿conoces \"Hola, mundo\"?",shape=box,color=blue];
		485 -> 482;
	486 [label="Y a partir de ahí se desató el infierno. La gente perdió la cabeza. La ciencia. La banca. La tecnología. El entretenimiento.",shape=box,color=blue];
		486 -> 489;
	488 [label="Algunas cosas no pueden ser reguladas.",shape=box,color=red];
		488 -> 491;
	487 [label="¿Y si todo esto fuera una regla estricta...?",shape=box,color=red];
		487 -> 490;
	489 [label="Y a través de miles de millones de elecciones, causas y efectos, me llevó a conectarme un día a Internet y... ",shape=box,color=blue];
		489 -> 492;
	491 [label="Algunas cosas no se pueden explicar.",shape=box,color=red];
		491 -> 493;
	490 [label="Sólo sucedió porque algo ahí afuera así lo quiso.",shape=box,color=red];
		490 -> 493;
	492 [label="Y fue el fin de Nova, o mejor dicho, de Kaya. Su futuro, su carrera, sus amigos, todo. Por culpa de un error. ",shape=box,color=blue];
		492 -> 494;
	493 [label="Entonces, estás diciendo que la parte que falta en mis experimentos, pruebas, investigaciones e hipótesis es la \"magia\".",shape=box,color=blue];
		493 -> 495;
		493 -> 496;
	494 [label="Así que supongo que confío más en el Vacío que en otras personas.",shape=box,color=blue];
		494 -> 497;
		494 -> 498;
		494 -> 499;
	495 [label="No es magia. Sólo... Vacío. El Vacío. Una energía de algún otro lugar.",shape=box,color=red];
		495 -> 500;
	496 [label="¿Has visto lo que puedo hacer? ",shape=box,color=red];
		496 -> 501;
