digraph {
	460 [label="KayaRank3Convo2 begins.",color=orange];
		460 -> 461;
	461 [label="Pareces realmente fascinada por los \"viajes en el tiempo\". De hecho, obsesionada.",shape=box,color=red];
		461 -> 462;
	462 [label="Estoy trabajando en ello. Ya casi lo consigo.",shape=box,color=blue];
