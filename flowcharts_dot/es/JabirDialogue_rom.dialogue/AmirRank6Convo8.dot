	j3272138059 [label="Usemos ese silbato para ratas.",shape=box,color=red];
		j3272138059 -> j3197735171;
	j197108911 [label="Uso el panel de control.",shape=box,color=red];
		j197108911 -> j2524485340;
	j2534079924 [label="Corro hacia el Railjack.",shape=box,color=red];
		j2534079924 -> j2875261742;
	j4281269846 [label="Hago que Zabir ataque al guardia de la rampa.",shape=box,color=red];
		j4281269846 -> j654996664;
	j3197735171 [label="\"Zabir toma el silbato y toca una nota larga. No se oye nada, sólo una respiración. Te sientas y esperas, pero no pasa nada. Ni ratas, nada. Zabir se encoge de hombros\".",shape=box,color=blue];
		j3197735171 -> j1348674349;
	j2524485340 [label="\"Llegas al panel de control, pero no antes de que un guardia te note. Intentas levantar las manos para rendirte, pero te dispara de todos modos, porque los grineer son así de malos\".",shape=box,color=blue];
		j2524485340 -> j2583757553;
		j2524485340 -> j2507904814;
	j2875261742 [label="\"Corres hacia la nave, pero el guardia de la rampa te ve y abre fuego. Tu día y tu vida terminan dolorosamente\".",shape=box,color=blue];
		j2875261742 -> j2583757553;
		j2875261742 -> j3318911399;
	j654996664 [label="oh, claro, cuando hay peligro envías a amir",shape=box,color=blue];
		j654996664 -> j3960956481;
	j1348674349 [label="\"Entonces lo escuchas: un crujido. Como si masticaran. De repente, las ratas salen disparadas de las rejillas de ventilación que rodean el hangar. Los grineer gritan como niños y abren fuego. Las balas vuelan por todas partes\".",shape=box,color=blue];
		j1348674349 -> j2994106534;
	j2583757553 [label="Necesito un descanso. [Fin]",shape=box,color=red];
		j2583757553 -> j2477325910;
	j2507904814 [label="Una vez más.",shape=box,color=red];
		j2507904814 -> j318932394;
	j3318911399 [label="¡De nuevo!",shape=box,color=red];
		j3318911399 -> j1595881847;
	j3960956481 [label="digo, zabir",shape=box,color=blue];
		j3960956481 -> j601877454;
	j2994106534 [label="\"Las ratas tienen a los guardias distraídos. ¿Ahora qué?\"",shape=box,color=blue];
		j2994106534 -> j2088356456;
		j2994106534 -> j3825335227;
	j2477325910 [label="volverás",shape=box,color=blue];
