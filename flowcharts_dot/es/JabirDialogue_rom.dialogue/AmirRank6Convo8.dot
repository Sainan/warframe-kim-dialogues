		j892020778 -> "Chat ends.";
	j1722965102 [label="\"Enciendes la nave y justo cuando estás a punto de presionar el botón para abrir la rampa y cerrar la puerta, Zabir dice: ¡Espera! No podemos dejarlas\".",shape=box,color=blue];
		j1722965102 -> j2631564662;
		j1722965102 -> j1832918923;
	j2631564662 [label="Tienes razón, tenemos que salvarlas.",shape=box,color=red];
		j2631564662 -> j3729318926;
	j1832918923 [label="Por favor, no. Deberíamos dejarlas.",shape=box,color=red];
		j1832918923 -> j3359303048;
	j3729318926 [label="\"Zabir levanta el silbato y sopla\".",shape=box,color=blue];
		j3729318926 -> j2134918330;
