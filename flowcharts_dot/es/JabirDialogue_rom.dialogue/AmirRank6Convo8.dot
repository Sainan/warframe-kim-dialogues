		j3825335227 -> j3565380930;
	j3355979694 [label="\"Gritas: '¡Zabir, ve por él!' mientras señalas al guardia de la rampa\".",shape=box,color=blue];
		j3355979694 -> j3222648995;
	j3748212647 [label="\"Zabir corre hacia el guardia y lo ataca. Cae sin fuerzas\".",shape=box,color=blue];
		j3748212647 -> j3028613594;
	j3565380930 [label="\"Te acercas sigilosamente al panel de control e intentas operar la consola, esforzándote por mantenerte oculto. Consigues que se abran las puertas del hangar\".",shape=box,color=blue];
		j3565380930 -> j3167404464;
	j3222648995 [label="\"En contra de su buen juicio, Zabir se lanza valientemente. Ni siquiera él es lo suficientemente rápido como para pasar desapercibido. Los guardias abren fuego y Zabir muere trágicamente\".",shape=box,color=blue];
		j3222648995 -> j682544828;
