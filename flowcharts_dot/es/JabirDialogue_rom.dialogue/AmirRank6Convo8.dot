		j3359303048 -> j3729318926;
	j2134918330 [label="Segundos después, una docena de ratas entran en la nave. Zabir te mira y grita: \"¡LISTO!\"",shape=box,color=blue];
		j2134918330 -> j285461390;
	j285461390 [label="\"La nave despega. Los grineer disparan, pero sus balas rebotan en el poderoso Railjack al salir del hangar\".",shape=box,color=blue];
		j285461390 -> j1416349384;
	j1416349384 [label="\"Mientras las ratas corren por el puente, contemplas la inmensidad del espacio y dices con seguridad: «RAILDRIVE, ACTIVADO». Mientras el Railjack se pierde en la distancia\".",shape=box,color=blue];
