	j2371478743 [label="+5 Chemistry",color=orange];
		j2371478743 -> j2229322494;
	j2305684511 [label="+5 Chemistry",color=orange];
		j2305684511 -> j3400901020;
	j2229322494 [label="oh... está listo",shape=box,color=blue];
		j2229322494 -> j275292195;
	j3400901020 [label="no te culpo, es muy apuesto",shape=box,color=blue];
		j3400901020 -> j275292195;
	j275292195 [label="aquí vamos",shape=box,color=blue];
		j275292195 -> j2112340397;
	j2112340397 [label="\"Estás en el laboratorio eléctrico con Zabir, ahora libre. Él te mira y te dice: «No hay tiempo que perder, sígueme»\".",shape=box,color=blue];
		j2112340397 -> j739312339;
	j739312339 [label="\"Te guía pasillo tras pasillo. Conoce este asteroide como la palma de su mano, a cada guardia y sus movimientos\".",shape=box,color=blue];
		j739312339 -> j3807297425;
		j739312339 -> j831310587;
		j739312339 -> j2407403147;
	j3807297425 [label="Le pregunto a Zabir sobre las ratas.",shape=box,color=red];
		j3807297425 -> j3827045311;
	j831310587 [label="¿Él también es un prisionero?",shape=box,color=red];
		j831310587 -> j229630040;
	j2407403147 [label="¿A dónde me lleva Zabir?",shape=box,color=red];
		j2407403147 -> j2571032896;
	j3827045311 [label="Zabir está impactado. \"¿Las ratas te encontraron? ¡Increíble! Funcionó. Mira\". Zabir levanta un silbato dorado con un intrincado relieve. \"Me lo dio la Reina Rata. Tenemos que encontrarla\".",shape=box,color=blue];
		j3827045311 -> j2013508696;
	j229630040 [label="\"Le preguntas a Zabir cómo llegó aquí, 'No hay tiempo para eso', responde, 'tenemos que concentrarnos en salir de aquí'\".",shape=box,color=blue];
		j229630040 -> j3807297425;
		j229630040 -> j2407403147;
	j2571032896 [label="\"Zabir mira hacia atrás: «Te llevaré al hangar. Robaremos una nave y nos iremos lo más lejos posible de aquí. Encuentra a la Reina Rata»\".",shape=box,color=blue];
		j2571032896 -> j2013508696;
	j2013508696 [label="¿REINA RATA?",shape=box,color=red];
		j2013508696 -> j1995722175;
	j1995722175 [label="\"Ella me dio este silbato. Las ratas lo escuchan. Es mi amiga. No siempre es amable, pero se preocupa por uno\".",shape=box,color=blue];
		j1995722175 -> j158838339;
		j1995722175 -> j2441676651;
	j158838339 [label="¿Por casualidad le has mostrado esto a Lettie?",shape=box,color=red];
		j158838339 -> j3611404960;
	j2441676651 [label="Ella me suena conocida también.",shape=box,color=red];
		j2441676651 -> j2443381551;
	j3611404960 [label="valoro demasiado mi vida como para tomar ese riesgo",shape=box,color=blue];
		j3611404960 -> j3211388426;
	j2443381551 [label="cualquier parecido con personas reales o imaginarias es mera coincidencia",shape=box,color=blue];
		j2443381551 -> j3211388426;
	j3211388426 [label="\"Con la ayuda de Zabir, zigzagueas por los pasillos del asteroide. Él esquiva con destreza a los guardias y las cámaras de seguridad\".",shape=box,color=blue];
		j3211388426 -> j3022441626;
	j3022441626 [label="\"Finalmente, llegan a una gran puerta. Zabir hace señas para que se agachen. Ambos se agachan y entran sigilosamente al hangar de la nave\".",shape=box,color=blue];
		j3022441626 -> j3291280521;
	j3291280521 [label="\"Te agachas a la sombra de un pilar. Se escuchan guardias grineer cerca\".",shape=box,color=blue];
		j3291280521 -> j3520550343;
	j3520550343 [label="\"¿Qué haces?\"",shape=box,color=blue];
		j3520550343 -> j578035157;
		j3520550343 -> j1441891748;
	j578035157 [label="Ataco a los guardias.",shape=box,color=red];
		j578035157 -> j311395318;
	j1441891748 [label="Miro a mi alrededor.",shape=box,color=red];
		j1441891748 -> j266510064;
	j311395318 [label="\"Sin el mínimo instinto de supervivencia ni previsión, corres al descubierto. Al otro lado, un grupo de guardias empieza a disparar. Te lanzas contra una lluvia de balas que te mata al instante. Zabir niega con la cabeza ante tu insensato acto de valentía\".",shape=box,color=blue];
		j311395318 -> j16249528;
	j266510064 [label="\"Echas un vistazo a la vuelta de la esquina y examinas el área\".",shape=box,color=blue];
		j266510064 -> j117036215;
	j16249528 [label="¿Quieres intentarlo de nuevo y no morir instantáneamente esta vez?",shape=box,color=blue];
		j16249528 -> j2085731152;
		j16249528 -> j871412165;
	j117036215 [label="\"Hay un Railjack estacionado en el centro del hangar. La rampa de acceso está bloqueada por un guardia. A un lado del hangar, hay una docena de grineer jugando ruidosamente a los dados. A pocos metros de ti hay un escritorio con un panel de control\".",shape=box,color=blue];
		j117036215 -> j3828441437;
	j2085731152 [label="Sipi.",shape=box,color=red];
		j2085731152 -> j4158970265;
	j871412165 [label="Fue suficiente por hoy. [Fin]",shape=box,color=red];
		j871412165 -> "Chat ends.";
	j3828441437 [label="\"Para salir, primero tenemos que abrir las puertas del hangar\", susurra Zabir.",shape=box,color=blue];
		j3828441437 -> j1454240872;
	j4158970265 [label="\"¿Qué haces ahora?\"",shape=box,color=blue];
		j4158970265 -> j4053482713;
		j4158970265 -> j1441891748;
