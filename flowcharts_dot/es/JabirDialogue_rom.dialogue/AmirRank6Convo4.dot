		j518290788 -> j2271836556;
	j2271836556 [label="\"Las ratas se dan la vuelta y salen corriendo. Quien les haya dado la llave sabía que estabas aquí abajo. Sólo hay una persona con semejante poder... Lotus\". ",shape=box,color=blue];
