		j3787606934 -> j4075541452;
	j3891582796 [label="\"Las ratas te rodean. Te mantienes en guardia, listo para luchar, pero no te atacan. En cambio, la más grande te saluda con una reverencia. Te das cuenta de que lleva un collar. La cadena de plata se resbala y cae al suelo. La rata parece decir: Esto es para ti\".",shape=box,color=blue];
