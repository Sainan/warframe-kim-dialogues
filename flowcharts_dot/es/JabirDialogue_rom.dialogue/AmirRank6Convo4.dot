		j221085784 -> j2730501732 [label=false,color=brown];
	j1477391141 [label="\"Te escabulles con cuidado de la celda. A tu derecha hay una gran puerta es la salida. Está apenas entreabierta. Escuchas a más guardias grineer dando vueltas al otro lado. A tu izquierda, el pasillo de la mazmorra continúa, pero está demasiado oscuro para ver\".",shape=box,color=blue];
