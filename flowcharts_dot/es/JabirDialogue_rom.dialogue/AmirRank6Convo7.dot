	j1862211981 [label="“Mientras giras la llave que te da una pandilla de ratas gigantes sorprendentemente amables, rezas para que lo que esté más allá de la puerta sea mejor que el calabozo detrás de ti”.",shape=box,color=blue];
		j1862211981 -> j2572798060;
	"Chat ends. Next chat will be AmirRank6Convo3." [color=orange];
	"Chat ends. Next chat will be AmirRank6Convo2." [color=orange];
	j2572798060 [label="\"Te encuentras frente a un gran ascensor de servicio. ¿Esto no es un simple calabozo?\"",shape=box,color=blue];
		j2572798060 -> j3113675106;
		j2572798060 -> j2358311460;
	j3113675106 [label="Regreso al calabozo.",shape=box,color=red];
		j3113675106 -> j991521435;
	j2358311460 [label="Tomo el elevador.",shape=box,color=red];
		j2358311460 -> j425998330;
	j991521435 [label="“Te das la vuelta y miras el calabozo, pensando: sería una tontería volver ahí”.",shape=box,color=blue];
		j991521435 -> j3845594438;
	j425998330 [label="\"Subes en el elevador. A través de la reja abierta, puedes ver cómo las paredes de piedra del calabozo son reemplazadas por tecnología cada vez más avanzada. Te preguntas de nuevo: ¿Dónde demonios estoy?\"",shape=box,color=blue];
		j425998330 -> j3143975756;
	j3845594438 [label="jaja... Está bien, tomo ese elevador.",shape=box,color=red];
		j3845594438 -> j425998330;
	j3143975756 [label="\"El elevador da a una sala de máquinas zumbantes y tubos gigantes. ¿Es esto una especie de laboratorio?\"",shape=box,color=blue];
		j3143975756 -> j3024861229;
	j3024861229 [label="Desde una habitación al final del pasillo, se oye a un hombre gritar de dolor.",shape=box,color=blue];
		j3024861229 -> j1659275181;
		j3024861229 -> j659135783;
	j1659275181 [label="Ignoro los gritos y busco una salida.",shape=box,color=red];
		j1659275181 -> j635466225;
	j659135783 [label="Voy hacia el hombre que grita.",shape=box,color=red];
		j659135783 -> j2794778400;
	j635466225 [label="\"Buscas algo útil por todo el pasillo pero los gritos se vuelven imposibles de ignorar. Te sientes atraído por este hombre y debes ayudarlo\".",shape=box,color=blue];
		j635466225 -> j2794778400;
	j2794778400 [label="\"Caminas por el pasillo siguiendo el origen de los gritos agonizantes. Entras en una gran sala de máquinas y allí ves a un hombre. Un hombre bastante atractivo, atado a una máquina. De sus dedos salen rayos eléctricos que alimentan una turbina gigante\".",shape=box,color=blue];
		j2794778400 -> j4235250106;
		j2794778400 -> j3915199992;
	j4235250106 [label="Le pregunto: \"¿Qué te pasa?\"",shape=box,color=red];
		j4235250106 -> j3087321838;
	j3915199992 [label="Examino al hombre.",shape=box,color=red];
		j3915199992 -> j3087321838;
	j3087321838 [label="\"El hombre está atado a una plataforma elevada, con los brazos extendidos. En las puntas de sus dedos lleva sondas que se entrelazan formando un gran cable que conduce a una turbina gigante. Arcos eléctricos danzan ágilmente desde sus manos\".",shape=box,color=blue];
		j3087321838 -> j361502271;
	j361502271 [label="Entre gritos y descargas, el hombre logra decir: \"¡DETÉN... LAS... TURBINAS!\"",shape=box,color=blue];
		j361502271 -> j3934109170;
	j3934109170 [label="Examino la habitación.",shape=box,color=red];
		j3934109170 -> j4095081675;
	j4095081675 [label="\"Miras alrededor de la habitación buscando algo útil. Ves un banco con herramientas. Una palanca. Un cortaalambres gigante. Un panel de control\".",shape=box,color=blue];
		j4095081675 -> j1571667540;
