digraph {
	"EleanorRank6Convo3 begins." [color=orange];
		"EleanorRank6Convo3 begins." -> j242116222;
	j242116222 [label="No sé si te has dado cuenta, pero ocurrió algo realmente fantástico.",shape=box,color=blue];
		j242116222 -> j2675771115;
	j2675771115 [label="Arthur está cantando de nuevo. Gracias a los dioses.",shape=box,color=blue];
		j2675771115 -> j2622310811;
		j2675771115 -> j910922973;
		j2675771115 -> j3112748100;
	j2622310811 [label="¿Por qué ya no lo hacía?",shape=box,color=red];
		j2622310811 -> j1287393610;
	j910922973 [label="En sí, no era su fan, pero si eso lo hace feliz...",shape=box,color=red];
		j910922973 -> j44390589;
	j3112748100 [label="Me alegro. Es bueno en eso.",shape=box,color=red];
		j3112748100 -> j762307163;
	j1287393610 [label="Ansiedad escénica. Así de simple.",shape=box,color=blue];
		j1287393610 -> j2418665149;
	j44390589 [label="Gracias por expresarlo con tanta delicadeza.",shape=box,color=blue];
		j44390589 -> j1764756342;
	j762307163 [label="¿Verdad?",shape=box,color=blue];
		j762307163 -> j1062855116;
	j2418665149 [label="Me cuesta creer que alguien tan valiente como Arthur pudiera tener ese miedo.",shape=box,color=red];
		j2418665149 -> j757479387;
	j1764756342 [label="Significa mucho para mí que te importe.",shape=box,color=blue];
		j1764756342 -> j2457534996;
	j1062855116 [label="Cuando pienso en cuánto le costó ponerse de pie frente a una multitud y cantar...",shape=box,color=blue];
		j1062855116 -> j1840679696;
	j757479387 [label="¿Cuál es su punto débil?",shape=box,color=red];
		j757479387 -> j3274877944;
	j2457534996 [label="Especialmente porque hay razones por las cuales dejó de cantar, razones que posiblemente no conozcas.",shape=box,color=blue];
		j2457534996 -> j1484908974;
		j2457534996 -> j1608812807;
	j1840679696 [label="... quiero decir, la primera vez que realmente superó sus nervios.",shape=box,color=blue];
		j1840679696 -> j3905451687;
	j3274877944 [label="Es el nombre. Ese es el maldito problema.",shape=box,color=blue];
		j3274877944 -> j1882797569;
	j1484908974 [label="¿No tiene el suficiente apoyo moral?",shape=box,color=red];
		j1484908974 -> j3333380527;
	j1608812807 [label="¿Varias veces con un público difícil?",shape=box,color=red];
		j1608812807 -> j3333380527;
	j3905451687 [label="Concierto de villancicos del solsticio de los 80. Imagina a nuestro hombrecillo en pantaloncillos cantando solo \"How Bright The Dew Upon That Morn\".",shape=box,color=blue];
		j3905451687 -> j2538355081;
		j3905451687 -> j1949842029;
	j1882797569 [label="\"Ah, tu nombre es nightingale ¿verdad? ja, ja, cántanos una canción entonces\"",shape=box,color=blue];
		j1882797569 -> j2124299634;
	j3333380527 [label="Más bien, escuchar la misma broma tan seguido.",shape=box,color=blue];
		j3333380527 -> j3274877944;
	j2538355081 [label="Vaya imagen visual.",shape=box,color=red];
		j2538355081 -> j586541481;
	j1949842029 [label="No me sé esa.",shape=box,color=red];
		j1949842029 -> j170389753;
	j2124299634 [label="Diferentes imbéciles, misma frase, por toda la vida. Ahora Viktor lo está haciendo. ",shape=box,color=blue];
		j2124299634 -> j2630710518;
	j586541481 [label="Se lo tomó muy en serio. Semanas y semanas de práctica y luego, esa noche, lo dejó todo. Se escondió tras bambalinas y se negó a salir.",shape=box,color=blue];
		j586541481 -> j1346723335;
		j586541481 -> j2418665149;
	j170389753 [label="Bueno. Te la cantaría, pero no estoy segura de qué tipo de sonido saldría si lo intento.",shape=box,color=blue];
		j170389753 -> j3535555298;
	j2630710518 [label="+5 Chemistry",color=orange];
		j2630710518 -> j1680186381;
	j1346723335 [label="¿Cómo lo convenciste?",shape=box,color=red];
		j1346723335 -> j2339008461;
	j3535555298 [label="Maldito Techrot. Traté de cantarle Feliz cumpleaños a Aoi y soné como si una rana hubiera sido atrapada en una trituradora de papel.",shape=box,color=blue];
		j3535555298 -> j801690368;
	j1680186381 [label="La verdad, estoy orgullosa de que Arthur tenga el coraje de cantar.",shape=box,color=blue];
		j1680186381 -> "Chat ends.";
	j2339008461 [label="Literalmente le di una paliza. No estoy orgullosa de ello. Pero era necesario.",shape=box,color=blue];
		j2339008461 -> j566371386;
	j801690368 [label="Lo siento. Ha de ser duro no poder cantar más.",shape=box,color=red];
		j801690368 -> j525645870;
	"Chat ends." [color=orange];
	j566371386 [label="La cosa es que, él no practicó por nuestros padres o para hacer feliz a la señora Henshaw. ",shape=box,color=blue];
		j566371386 -> j3962894735;
	j525645870 [label="Ah, no fue gran pérdida. Ni cantaba bien.",shape=box,color=blue];
		j525645870 -> j2411077497;
	j3962894735 [label="Él cantaba porque amaba hacerlo. Pero cuando los reflectores estaban sobre él, se paralizaba.",shape=box,color=blue];
		j3962894735 -> j515386450;
		j3962894735 -> j757479387;
	j2411077497 [label="A lo más que llegué fue a gritar la letra de los Shang Cannons en mi cuarto porque quería estar en la banda de Mandy Jellicoe porque ella era mi favorita. ",shape=box,color=blue];
		j2411077497 -> j3127043049;
	j515386450 [label="Tal vez sólo necesitaba recordar lo mucho que le gustaba hacerlo.",shape=box,color=red];
		j515386450 -> j207663577;
	j3127043049 [label="Lo cual llevaba a mi padre a tocar mi puerta y amenazar con lavarme la boca con ácido si volvía a oír esa basura.",shape=box,color=blue];
		j3127043049 -> j155751962;
	j207663577 [label="Arthur es el más feliz cuando se olvida de Arthur. Cuando puede dejar atrás su propio fantasma para descansar y sólo ser él mismo.",shape=box,color=blue];
		j207663577 -> j2481276863;
	j155751962 [label="(No sé si haya \"punk\" de donde eres pero no saber cantar es más un requisito que una desventaja)",shape=box,color=blue];
		j155751962 -> j3838015525;
		j155751962 -> j3394854751;
	j2481276863 [label="La cerveza ayuda.",shape=box,color=blue];
		j2481276863 -> j2992115335;
	j3838015525 [label="No tenemos punk, pero tenemos Skeg.",shape=box,color=red];
		j3838015525 -> j1597335219;
	j3394854751 [label="¿Qué le pasó a la banda?",shape=box,color=red];
		j3394854751 -> j3867227833;
	j2992115335 [label="Y no está mal que Velimir está actuando como el papá que Arthur hubiera escogido, si hubiera podido elegir uno de un catálogo.",shape=box,color=blue];
		j2992115335 -> j1654824702;
		j2992115335 -> j1114714120;
	j1597335219 [label="No te atrevas a enviar algo así en el chat sin dar más detalles después. ",shape=box,color=blue];
		j1597335219 -> j4007105;
	j3867227833 [label="Ni siquiera llegaron a pisar el escenario del bar local.",shape=box,color=blue];
		j3867227833 -> j478366622;
	j1654824702 [label="No lo culpo.",shape=box,color=red];
		j1654824702 -> j1067244995;
	j1114714120 [label="Llegué a pensar que Velimir y Minerva se veían como tus verdaderos padres.",shape=box,color=red];
		j1114714120 -> j791776259;
	j4007105 [label="Exijo saber qué es el Skeg.",shape=box,color=blue];
		j4007105 -> j3814303276;
	j478366622 [label="Se esparció un rumor donde se decía que Mandy estaba planeando escupirle a la audiencia y ahí se acabó todo. Una lástima.",shape=box,color=blue];
		j478366622 -> j2577976957;
		j478366622 -> j540332244;
	j1067244995 [label="Arthur ha estado cargando ese osito de peluche por meses. Y ahora Velimir aparece. Parece que el destino sintió un vacío en forma de osito en la vida de Arthur...",shape=box,color=blue];
		j1067244995 -> j455426776;
	j791776259 [label="sí, bueno. Tal vez las peleas hacen que se sienta en casa. ",shape=box,color=blue];
		j791776259 -> j1072312019;
	j3814303276 [label="Porque suena como algo que se vende en pequeñas bolsas plásticas en el estado de Ludston.",shape=box,color=blue];
		j3814303276 -> j483762204;
		j3814303276 -> j1746575626;
	j2577976957 [label="¿Quién le tiene miedo a un poco de saliva?",shape=box,color=red];
		j2577976957 -> j1463917411;
	j540332244 [label="¿Escupir? Suena a la noche perfecta de un Tecnocito Coda.",shape=box,color=red];
		j540332244 -> j1750046516;
	j455426776 [label="+5 Chemistry",color=orange];
		j455426776 -> j2024582692;
	j1072312019 [label="+5 Chemistry",color=orange];
		j1072312019 -> j587773375;
	j483762204 [label="Es música, sólo que la creas golpeando tubos. Y conductos de ventilación. Y cascos del Corpus. Y cualquier otra cosa que encuentres para golpear, la verdad. ",shape=box,color=red];
		j483762204 -> j2265052173;
	j1746575626 [label="Es ruido sin sentido. Sólo le gusta a los Ventkids.",shape=box,color=red];
		j1746575626 -> j2647470054;
	j1463917411 [label="+5 Chemistry",color=orange];
		j1463917411 -> j258459679;
	j1750046516 [label="Eran otros tiempos. Cuando el punk era punk de verdad. ",shape=box,color=blue];
		j1750046516 -> j505355167;
	j2024582692 [label="... Perdón. No me corresponde especular. Solo estoy feliz de que él sea feliz.",shape=box,color=blue];
		j2024582692 -> "Chat ends.";
	j587773375 [label="Es raro ver qué te hace extrañar tu hogar, ¿no es así?",shape=box,color=blue];
		j587773375 -> "Chat ends.";
	j2265052173 [label="Es algo de los Ventkids.",shape=box,color=red];
		j2265052173 -> j920114674;
	j2647470054 [label="Huh. \"Ruido sin sentido\". He escuchado eso antes.",shape=box,color=blue];
		j2647470054 -> j1874644814;
	j258459679 [label="Yo no, eso te lo puedo asegurar.",shape=box,color=blue];
		j258459679 -> j505355167;
	j505355167 [label="... Yo solo pensaba \"ojalá ahora me pueda ver\". Creo que a ella le gustaría esa versión de mí.",shape=box,color=blue];
		j505355167 -> j2527978285;
	j920114674 [label="+5 Chemistry",color=orange];
		j920114674 -> j1399760654;
	j1874644814 [label="No creo que haya nada tan inútil que no pueda ser la banda sonora de la juventud de alguien.",shape=box,color=blue];
		j1874644814 -> j2141356614;
	j2527978285 [label="Cielos, veme, me puse toda sentimental y nostálgica.",shape=box,color=blue];
		j2527978285 -> j3108965268;
	j1399760654 [label="Mmm. Suena a música de supervivientes. No me importaría escucharla si tienes la oportunidad de grabar algo para mí.",shape=box,color=blue];
		j1399760654 -> j1096666168;
	j2141356614 [label="Será mejor que pare. Me estoy poniendo sentimental.",shape=box,color=blue];
		j2141356614 -> "Chat ends.";
	j3108965268 [label="+5 Chemistry",color=orange];
		j3108965268 -> j3547188036;
	j1096666168 [label="De todas formas, es mejor mantenerlo alejado de los altavoces del centro comercial.",shape=box,color=blue];
		j1096666168 -> "Chat ends.";
