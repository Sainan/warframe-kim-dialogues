digraph {
	2888 [label="EleanorRank6Convo3 begins.",color=orange];
		2888 -> 2889;
	2889 [label="No sé si te has dado cuenta, pero ocurrió algo realmente fantástico.",shape=box,color=blue];
		2889 -> 2890;
	2890 [label="Arthur está cantando de nuevo. Gracias a los dioses.",shape=box,color=blue];
		2890 -> 2891;
		2890 -> 2892;
		2890 -> 2893;
	2891 [label="¿Por qué ya no lo hacía?",shape=box,color=red];
		2891 -> 2894;
	2892 [label="En sí, no era su fan, pero si eso lo hace feliz...",shape=box,color=red];
		2892 -> 2895;
	2893 [label="Me alegro. Es bueno en eso.",shape=box,color=red];
		2893 -> 2896;
	2894 [label="Ansiedad escénica. Así de simple.",shape=box,color=blue];
		2894 -> 2897;
	2895 [label="Gracias por expresarlo con tanta delicadeza.",shape=box,color=blue];
		2895 -> 2898;
	2896 [label="¿Verdad?",shape=box,color=blue];
		2896 -> 2899;
	2897 [label="Me cuesta creer que alguien tan valiente como Arthur pudiera tener ese miedo.",shape=box,color=red];
		2897 -> 2900;
	2898 [label="Significa mucho para mí que te importe.",shape=box,color=blue];
		2898 -> 2901;
	2899 [label="Cuando pienso en cuánto le costó ponerse de pie frente a una multitud y cantar...",shape=box,color=blue];
		2899 -> 2902;
	2900 [label="¿Cuál es su punto débil?",shape=box,color=red];
		2900 -> 2903;
	2901 [label="Especialmente porque hay razones por las cuales dejó de cantar, razones que posiblemente no conozcas.",shape=box,color=blue];
		2901 -> 2904;
		2901 -> 2905;
	2902 [label="... quiero decir, la primera vez que realmente superó sus nervios.",shape=box,color=blue];
		2902 -> 2906;
	2903 [label="Es el nombre. Ese es el maldito problema.",shape=box,color=blue];
		2903 -> 2907;
	2904 [label="¿No tiene el suficiente apoyo moral?",shape=box,color=red];
		2904 -> 2908;
	2905 [label="¿Varias veces con un público difícil?",shape=box,color=red];
		2905 -> 2908;
	2906 [label="Concierto de villancicos del solsticio de los 80. Imagina a nuestro hombrecillo en pantaloncillos cantando solo \"How Bright The Dew Upon That Morn\".",shape=box,color=blue];
		2906 -> 2909;
		2906 -> 2910;
	2907 [label="\"Ah, tu nombre es nightingale ¿verdad? ja, ja, cántanos una canción entonces\"",shape=box,color=blue];
		2907 -> 2911;
	2908 [label="Más bien, escuchar la misma broma tan seguido.",shape=box,color=blue];
		2908 -> 2903;
	2909 [label="Vaya imagen visual.",shape=box,color=red];
		2909 -> 2912;
	2910 [label="No me sé esa.",shape=box,color=red];
		2910 -> 2913;
	2911 [label="Diferentes imbéciles, misma frase, por toda la vida. Ahora Viktor lo está haciendo. ",shape=box,color=blue];
		2911 -> 2914;
	2912 [label="Se lo tomó muy en serio. Semanas y semanas de práctica y luego, esa noche, lo dejó todo. Se escondió tras bambalinas y se negó a salir.",shape=box,color=blue];
		2912 -> 2915;
		2912 -> 2897;
	2913 [label="Bueno. Te la cantaría, pero no estoy segura de qué tipo de sonido saldría si lo intento.",shape=box,color=blue];
		2913 -> 2916;
	2914 [label="+5 Chemistry",color=orange];
		2914 -> 2917;
	2915 [label="¿Cómo lo convenciste?",shape=box,color=red];
		2915 -> 2918;
	2916 [label="Maldito Techrot. Traté de cantarle Feliz cumpleaños a Aoi y soné como si una rana hubiera sido atrapada en una trituradora de papel.",shape=box,color=blue];
		2916 -> 2919;
	2917 [label="La verdad, estoy orgullosa de que Arthur tenga el coraje de cantar.",shape=box,color=blue];
		2917 -> 2920;
	2918 [label="Literalmente le di una paliza. No estoy orgullosa de ello. Pero era necesario.",shape=box,color=blue];
		2918 -> 2921;
	2919 [label="Lo siento. Ha de ser duro no poder cantar más.",shape=box,color=red];
		2919 -> 2922;
	2920 [label="Chat ends.",color=orange];
	2921 [label="La cosa es que, él no practicó por nuestros padres o para hacer feliz a la señora Henshaw. ",shape=box,color=blue];
		2921 -> 2923;
	2922 [label="Ah, no fue gran pérdida. Ni cantaba bien.",shape=box,color=blue];
		2922 -> 2924;
	2923 [label="Él cantaba porque amaba hacerlo. Pero cuando los reflectores estaban sobre él, se paralizaba.",shape=box,color=blue];
		2923 -> 2925;
		2923 -> 2900;
	2924 [label="A lo más que llegué fue a gritar la letra de los Shang Cannons en mi cuarto porque quería estar en la banda de Mandy Jellicoe porque ella era mi favorita. ",shape=box,color=blue];
		2924 -> 2926;
	2925 [label="Tal vez sólo necesitaba recordar lo mucho que le gustaba hacerlo.",shape=box,color=red];
		2925 -> 2927;
	2926 [label="Lo cual llevaba a mi padre a tocar mi puerta y amenazar con lavarme la boca con ácido si volvía a oír esa basura.",shape=box,color=blue];
		2926 -> 2928;
	2927 [label="Arthur es el más feliz cuando se olvida de Arthur. Cuando puede dejar atrás su propio fantasma para descansar y sólo ser él mismo.",shape=box,color=blue];
		2927 -> 2929;
	2928 [label="(No sé si haya \"punk\" de donde eres pero no saber cantar es más un requisito que una desventaja)",shape=box,color=blue];
		2928 -> 2930;
		2928 -> 2931;
	2929 [label="La cerveza ayuda.",shape=box,color=blue];
		2929 -> 2932;
	2930 [label="No tenemos punk, pero tenemos Skeg.",shape=box,color=red];
		2930 -> 2933;
	2931 [label="¿Qué le pasó a la banda?",shape=box,color=red];
		2931 -> 2934;
	2932 [label="Y no está mal que Velimir está actuando como el papá que Arthur hubiera escogido, si hubiera podido elegir uno de un catálogo.",shape=box,color=blue];
		2932 -> 2935;
		2932 -> 2936;
	2933 [label="No te atrevas a enviar algo así en el chat sin dar más detalles después. ",shape=box,color=blue];
		2933 -> 2937;
	2934 [label="Ni siquiera llegaron a pisar el escenario del bar local.",shape=box,color=blue];
		2934 -> 2938;
	2935 [label="No lo culpo.",shape=box,color=red];
		2935 -> 2939;
	2936 [label="Llegué a pensar que Velimir y Minerva se veían como tus verdaderos padres.",shape=box,color=red];
		2936 -> 2940;
	2937 [label="Exijo saber qué es el Skeg.",shape=box,color=blue];
		2937 -> 2941;
	2938 [label="Se esparció un rumor donde se decía que Mandy estaba planeando escupirle a la audiencia y ahí se acabó todo. Una lástima.",shape=box,color=blue];
		2938 -> 2942;
		2938 -> 2943;
	2939 [label="Arthur ha estado cargando ese osito de peluche por meses. Y ahora Velimir aparece. Parece que el destino sintió un vacío en forma de osito en la vida de Arthur...",shape=box,color=blue];
		2939 -> 2944;
	2940 [label="sí, bueno. Tal vez las peleas hacen que se sienta en casa. ",shape=box,color=blue];
		2940 -> 2945;
	2941 [label="Porque suena como algo que se vende en pequeñas bolsas plásticas en el estado de Ludston.",shape=box,color=blue];
		2941 -> 2946;
		2941 -> 2947;
	2942 [label="¿Quién le tiene miedo a un poco de saliva?",shape=box,color=red];
		2942 -> 2948;
	2943 [label="¿Escupir? Suena a la noche perfecta de un Tecnocito Coda.",shape=box,color=red];
		2943 -> 2949;
	2944 [label="+5 Chemistry",color=orange];
		2944 -> 2950;
	2945 [label="+5 Chemistry",color=orange];
		2945 -> 2951;
	2946 [label="Es música, sólo que la creas golpeando tubos. Y conductos de ventilación. Y cascos del Corpus. Y cualquier otra cosa que encuentres para golpear, la verdad. ",shape=box,color=red];
		2946 -> 2952;
	2947 [label="Es ruido sin sentido. Sólo le gusta a los Ventkids.",shape=box,color=red];
		2947 -> 2953;
	2948 [label="+5 Chemistry",color=orange];
		2948 -> 2954;
	2949 [label="Eran otros tiempos. Cuando el punk era punk de verdad. ",shape=box,color=blue];
		2949 -> 2955;
	2950 [label="... Perdón. No me corresponde especular. Solo estoy feliz de que él sea feliz.",shape=box,color=blue];
		2950 -> 3311;
	2951 [label="Es raro ver qué te hace extrañar tu hogar, ¿no es así?",shape=box,color=blue];
		2951 -> 2956;
	2952 [label="Es algo de los Ventkids.",shape=box,color=red];
		2952 -> 2957;
	2953 [label="Huh. \"Ruido sin sentido\". He escuchado eso antes.",shape=box,color=blue];
		2953 -> 2958;
	2954 [label="Yo no, eso te lo puedo asegurar.",shape=box,color=blue];
		2954 -> 2955;
	2955 [label="... Yo solo pensaba \"ojalá ahora me pueda ver\". Creo que a ella le gustaría esa versión de mí.",shape=box,color=blue];
		2955 -> 2959;
