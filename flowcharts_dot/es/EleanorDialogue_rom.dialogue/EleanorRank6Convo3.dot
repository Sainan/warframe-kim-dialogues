	2957 [label="+5 Chemistry",color=orange];
		2957 -> 2960;
	2958 [label="No creo que haya nada tan inútil que no pueda ser la banda sonora de la juventud de alguien.",shape=box,color=blue];
		2958 -> 2961;
	2959 [label="Cielos, veme, me puse toda sentimental y nostálgica.",shape=box,color=blue];
		2959 -> 2962;
	2960 [label="Mmm. Suena a música de supervivientes. No me importaría escucharla si tienes la oportunidad de grabar algo para mí.",shape=box,color=blue];
