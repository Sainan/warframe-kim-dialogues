	1342 [label="Dios mío. ¿Personas quirúrgicamente bellas llenándose sus inmaculados rostros de drogas experimentales? No.",shape=box,color=blue];
		1342 -> 1346;
	1343 [label="Mira, no tengo nada en contra de ver a un par de tipos sudorosos pelearse entre sí, con fuerza. Pero no.",shape=box,color=blue];
		1343 -> 1346;
	1344 [label="Buena suposición. Podrías conseguir cualquier cosa, desde un bolso y unos guantes Bresslin hasta un globo ocular humano sobre hielo. Pero no.",shape=box,color=blue];
		1344 -> 1346;
	1345 [label="Bueno, claro que no tienes ni idea. Acabas de llegar.",shape=box,color=blue];
		1345 -> 1346;
	1340 [label="Buuu.",shape=box,color=blue];
		1340 -> 1341;
	1346 [label="¡Las casas de baños!",shape=box,color=blue];
		1346 -> 1347;
	1341 [label="Chat ends.",color=orange];
	1347 [label="No sé si tienen algo parecido donde vives. Supongo que son templos, normalmente con un conjunto de habitaciones Sol y un conjunto Lua. Puedes sumergirte en una piscina pública o privada. Todo huele a hierbas y vapor y son MUY BUENOS para recuperar la calma.",shape=box,color=blue];
		1347 -> 1348;
	1348 [label="En Höllvania siempre ha existido una tradición muy importante de limpieza ritual. Supongo que se remonta a las fuentes termales sobre las que se construyó la ciudad.",shape=box,color=blue];
		1348 -> 1349;
	1349 [label="¿Todas esas tonterías sobre la \"pureza\" que dice Viktor? Está cantando una melodía muy antigua. Todos los ciudadanos están familiarizados.",shape=box,color=blue];
		1349 -> 1350;
	1350 [label="Me encantaba pagar los hölares adicionales para que un profesional musculoso me quitara toda la tensión de los músculos. A ti te hubiera encantado. Estoy segura.",shape=box,color=blue];
		1350 -> 1351;
		1350 -> 1352;
		1350 -> 1353;
	1351 [label="No lo sé.",shape=box,color=red];
		1351 -> 1354;
	1352 [label="Suena como mi tipo de diversión.",shape=box,color=red];
		1352 -> 1357;
	1353 [label="¿Qué les pasó?",shape=box,color=red];
		1353 -> 1359;
	1354 [label="Te paseas por ahí con un traje hecho a partir de un cuerpo humano infestado, pero ¿no aceptas masajes?",shape=box,color=blue];
		1354 -> 1355;
	1357 [label="Sabía que eras mi tipo de camarada.",shape=box,color=blue];
		1357 -> 1358;
	1359 [label="Estoy segura de que puedes adivinarlo. El Techrot causó muchos daños. No había forma de que los baños pudieran permanecer abiertos después de los brotes.",shape=box,color=blue];
		1359 -> 1360;
	1355 [label="Qué extraño.",shape=box,color=blue];
		1355 -> 1356;
	1358 [label="Ojalá algunos de los demás fueran un poco menos estrictos. Lamentablemente, no hubo forma de que los baños pudieran permanecer abiertos después de los brotes.",shape=box,color=blue];
		1358 -> 1360;
	1360 [label="Por lo que he visto, algunos de ellos son básicamente estanques infestados. Me parte el corazón, para ser sincera. Recuerdo haber encontrado pisos de mármol y mosaico de mil años de antigüedad cubiertos de piel arrastrándose.",shape=box,color=blue];
		1360 -> 1361;
	1356 [label="Chat ends.",color=orange];
	1361 [label="¿Tienen algo parecido en tu tiempo?",shape=box,color=blue];
		1361 -> 1362;
	1362 [label="¿Baños públicos sagrados? No, en realidad no.",shape=box,color=red];
		1362 -> 1363;
	1363 [label="Entonces, ¿qué hace la gente para relajarse?",shape=box,color=blue];
		1363 -> 1364;
		1363 -> 1365;
		1363 -> 1366;
	1364 [label="Está el Rathuum.",shape=box,color=red];
		1364 -> 1367;
