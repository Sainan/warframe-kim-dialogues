digraph {
	2845 [label="EleanorRank6Convo2 begins.",color=orange];
		2845 -> 2846;
	2846 [label="Hola. Necesito hablar unas cosas contigo.",shape=box,color=blue];
		2846 -> 2847;
	2847 [label="He estado pensando en el Fiendsnight. Hace años que no me visto para eso, pero estaba hojeando un cómic de Amir y de repente pensé: ¡Un momento, podría ser la Condesa! ¡Tengo los colmillos para ello y todo!",shape=box,color=blue];
		2847 -> 2848;
	2848 [label="¿Pero será muy obvio? ¿Debería ser Dandy Damage?",shape=box,color=blue];
		2848 -> 2849;
		2848 -> 2850;
		2848 -> 2851;
	2849 [label="¿Quién es Dandy Damage?",shape=box,color=red];
		2849 -> 2852;
	2850 [label="Siempre puedes disfrazarte de Lotus, si quieres confundir a la gente.",shape=box,color=red];
		2850 -> 2853;
	2851 [label="… Vas a tener que decirme qué es Fiendsnight.",shape=box,color=red];
		2851 -> 2854;
	2852 [label="Ay, amigo. ",shape=box,color=blue];
		2852 -> 2855;
	2853 [label="Oh, Dios, no. La he visto en tu mente. Nunca podría hacerle justicia.",shape=box,color=blue];
		2853 -> 2856;
	2854 [label="Mmm. A veces me olvido de que eres un inocente forastero. ",shape=box,color=blue];
		2854 -> 2857;
	2855 [label="Dandy Damage caminó para que Temple and the Rippers pudieran correr. Era la pesadilla de toda madre y el sueño de toda adolescente rebelde.",shape=box,color=blue];
		2855 -> 2858;
	2856 [label="Y ese casco. ¿Es un casco? ¿Es parte de ella? ¿Cómo ve a través de él?",shape=box,color=blue];
		2856 -> 2859;
	2857 [label="Fiendsnight celebra el desvanecimiento de la influencia de Sol en el mundo.",shape=box,color=blue];
		2857 -> 2860;
	2858 [label="Con la complexión de un insecto palo y la apariencia de una reina del cine mudo. Boca de caramelo. Rayas, cuero y cadena de perro. Pómulos como las caderas de un esqueleto.",shape=box,color=blue];
		2858 -> 2861;
		2858 -> 2862;
	2859 [label="En fin, hay tres de ella en un solo cuerpo. Nunca podría elegir a una sobre las demás.",shape=box,color=blue];
		2859 -> 2861;
		2859 -> 2862;
	2860 [label="Lo cual, a primera vista, no tiene mucho sentido. ¿Por qué celebrar la creciente oscuridad? ¿Por qué regocijarse en la anarquía y la ilegalidad?",shape=box,color=blue];
		2860 -> 2863;
	2861 [label="¿Disfrazarse? ¿De fiesta? ¿En una zona de guerra? ¿De verdad crees que eso va a pasar?",shape=box,color=red];
		2861 -> 2864;
	2862 [label="Sabes, Fiendsnight suena mucho a Naberus. A la gente también le gusta disfrazarse para eso.",shape=box,color=red];
		2862 -> 2864;
	2863 [label="Creo que es como una inoculación, quizá. Un poquito de lo que tememos, para fortalecernos. O quizá solo sea una excusa para ponernos la máscara del diablo y armar un alboroto.",shape=box,color=blue];
		2863 -> 2861;
		2863 -> 2862;
	2864 [label="... Probablemente estoy siendo algo ridícula. Infantil, ¿no?",shape=box,color=blue];
		2864 -> 2865;
	2865 [label="Oh, ¿en qué estoy pensando?",shape=box,color=blue];
		2865 -> 2866;
	2866 [label="No necesito disfrazarme, ¿verdad? Ya soy un monstruo. Para siempre.",shape=box,color=blue];
		2866 -> 2867;
	2867 [label="Check boolean EleanorDating",color=orange];
		2867 -> 2868 [label=true,color=green];
		2867 -> 2869 [label=true,color=green];
		2867 -> 2870 [label=true,color=green];
		2867 -> 2869 [label=false,color=brown];
		2867 -> 2870 [label=false,color=brown];
	2868 [label="Eres el monstruo que amo, Eleanor. No me arrepiento de nada.",shape=box,color=red];
		2868 -> 2871;
	2869 [label="Estoy empezando a pensar que te gusta decir eso de ti misma.",shape=box,color=red];
		2869 -> 2872;
	2870 [label="No. Los verdaderos monstruos no se preocupan por la gente como tú lo haces.",shape=box,color=red];
		2870 -> 2873;
	2871 [label="+5 Chemistry",color=orange];
		2871 -> 2874;
	2872 [label="Si eso es lo que realmente crees que eres, entonces Fiendsnight es la oportunidad perfecta para celebrarlo.",shape=box,color=red];
		2872 -> 2875;
		2872 -> 2873;
	2873 [label="Sé que tienes miedo de lo que podrías llegar a ser. Pero AHORA MISMO, no eres eso.",shape=box,color=red];
		2873 -> 2876;
	2874 [label="¡Ah, sí! ¡Qué tonta! Olvidé que el monstruo tuvo un final feliz en nuestra pequeña historia.",shape=box,color=blue];
		2874 -> 2877;
	2875 [label="SÉ el monstruo. Asúmelo. Por esta noche del año, luce ese título con orgullo.",shape=box,color=red];
		2875 -> 2878;
	2876 [label="Así que vístete. Diviértete. Hasta el Vacío sabe que a todos los Hex les vendría bien.",shape=box,color=red];
		2876 -> 2879;
	2877 [label="Perdóname. Todavía no puedo creer que esto es lo que realmente QUIERES. Quizás sólo necesito un poco más de persuasión.",shape=box,color=blue];
		2877 -> 2880;
	2878 [label="Oh, hay MUCHAS razones por las que esa es una TERRIBLE IDEA",shape=box,color=blue];
		2878 -> 2881;
	2879 [label="Seguiré tu consejo. Y gracias de nuevo. x",shape=box,color=blue];
		2879 -> 2882;
	2880 [label="Hay que devorarnos más tarde. xxx",shape=box,color=blue];
		2880 -> 2883;
	2881 [label="MUCHAS.",shape=box,color=blue];
		2881 -> 2884;
	2882 [label="Chat ends.",color=orange];
	2883 [label="Chat ends.",color=orange];
	2884 [label="(No puedo pensar en ninguna ahora mismo, pero estoy segura de que hay DOCENAS)",shape=box,color=blue];
		2884 -> 2885;
	2885 [label="... mierda.",shape=box,color=blue];
		2885 -> 2886;
	2886 [label="me has atrapado en mi propio juego. Maldita sea. Bien hecho. x",shape=box,color=blue];
		2886 -> 2887;
	2887 [label="Chat ends.",color=orange];
}