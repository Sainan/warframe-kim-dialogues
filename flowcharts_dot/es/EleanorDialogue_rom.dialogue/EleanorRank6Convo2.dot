digraph {
	"EleanorRank6Convo2 begins." [color=orange];
		"EleanorRank6Convo2 begins." -> j320511151;
	j320511151 [label="Hola. Necesito hablar unas cosas contigo.",shape=box,color=blue];
		j320511151 -> j3115129357;
	j3115129357 [label="He estado pensando en el Fiendsnight. Hace años que no me visto para eso, pero estaba hojeando un cómic de Amir y de repente pensé: ¡Un momento, podría ser la Condesa! ¡Tengo los colmillos para ello y todo!",shape=box,color=blue];
		j3115129357 -> j2566891876;
	j2566891876 [label="¿Pero será muy obvio? ¿Debería ser Dandy Damage?",shape=box,color=blue];
		j2566891876 -> j2063860045;
		j2566891876 -> j3220442984;
		j2566891876 -> j2988382043;
	j2063860045 [label="¿Quién es Dandy Damage?",shape=box,color=red];
		j2063860045 -> j4289021021;
	j3220442984 [label="Siempre puedes disfrazarte de Lotus, si quieres confundir a la gente.",shape=box,color=red];
		j3220442984 -> j3290682915;
	j2988382043 [label="… Vas a tener que decirme qué es Fiendsnight.",shape=box,color=red];
		j2988382043 -> j3544860582;
	j4289021021 [label="Ay, amigo. ",shape=box,color=blue];
		j4289021021 -> j3894868376;
	j3290682915 [label="Oh, Dios, no. La he visto en tu mente. Nunca podría hacerle justicia.",shape=box,color=blue];
		j3290682915 -> j1826748464;
	j3544860582 [label="Mmm. A veces me olvido de que eres un inocente forastero. ",shape=box,color=blue];
		j3544860582 -> j248832719;
	j3894868376 [label="Dandy Damage caminó para que Temple and the Rippers pudieran correr. Era la pesadilla de toda madre y el sueño de toda adolescente rebelde.",shape=box,color=blue];
		j3894868376 -> j3993243063;
	j1826748464 [label="Y ese casco. ¿Es un casco? ¿Es parte de ella? ¿Cómo ve a través de él?",shape=box,color=blue];
		j1826748464 -> j2294875319;
	j248832719 [label="Fiendsnight celebra el desvanecimiento de la influencia de Sol en el mundo.",shape=box,color=blue];
		j248832719 -> j4030003946;
	j3993243063 [label="Con la complexión de un insecto palo y la apariencia de una reina del cine mudo. Boca de caramelo. Rayas, cuero y cadena de perro. Pómulos como las caderas de un esqueleto.",shape=box,color=blue];
		j3993243063 -> j4001400119;
		j3993243063 -> j2428516674;
	j2294875319 [label="En fin, hay tres de ella en un solo cuerpo. Nunca podría elegir a una sobre las demás.",shape=box,color=blue];
		j2294875319 -> j4001400119;
		j2294875319 -> j2428516674;
	j4030003946 [label="Lo cual, a primera vista, no tiene mucho sentido. ¿Por qué celebrar la creciente oscuridad? ¿Por qué regocijarse en la anarquía y la ilegalidad?",shape=box,color=blue];
		j4030003946 -> j643328670;
	j4001400119 [label="¿Disfrazarse? ¿De fiesta? ¿En una zona de guerra? ¿De verdad crees que eso va a pasar?",shape=box,color=red];
		j4001400119 -> j3597093088;
	j2428516674 [label="Sabes, Fiendsnight suena mucho a Naberus. A la gente también le gusta disfrazarse para eso.",shape=box,color=red];
		j2428516674 -> j3597093088;
	j643328670 [label="Creo que es como una inoculación, quizá. Un poquito de lo que tememos, para fortalecernos. O quizá solo sea una excusa para ponernos la máscara del diablo y armar un alboroto.",shape=box,color=blue];
		j643328670 -> j4001400119;
		j643328670 -> j2428516674;
	j3597093088 [label="... Probablemente estoy siendo algo ridícula. Infantil, ¿no?",shape=box,color=blue];
		j3597093088 -> j4237967926;
	j4237967926 [label="Oh, ¿en qué estoy pensando?",shape=box,color=blue];
		j4237967926 -> j3466289517;
	j3466289517 [label="No necesito disfrazarme, ¿verdad? Ya soy un monstruo. Para siempre.",shape=box,color=blue];
		j3466289517 -> j2436064064;
	j2436064064 [label="Check boolean EleanorDating",color=orange];
		j2436064064 -> j611166950 [label=true,color=green];
		j2436064064 -> j295073411 [label=true,color=green];
		j2436064064 -> j2546915741 [label=true,color=green];
		j2436064064 -> j295073411 [label=false,color=brown];
		j2436064064 -> j2546915741 [label=false,color=brown];
	j611166950 [label="Eres el monstruo que amo, Eleanor. No me arrepiento de nada.",shape=box,color=red];
		j611166950 -> j1147141695;
	j295073411 [label="Estoy empezando a pensar que te gusta decir eso de ti misma.",shape=box,color=red];
		j295073411 -> j4194249131;
	j2546915741 [label="No. Los verdaderos monstruos no se preocupan por la gente como tú lo haces.",shape=box,color=red];
		j2546915741 -> j2538809406;
	j1147141695 [label="+5 Chemistry",color=orange];
		j1147141695 -> j2374572440;
	j4194249131 [label="Si eso es lo que realmente crees que eres, entonces Fiendsnight es la oportunidad perfecta para celebrarlo.",shape=box,color=red];
		j4194249131 -> j1306022660;
		j4194249131 -> j2538809406;
	j2538809406 [label="Sé que tienes miedo de lo que podrías llegar a ser. Pero AHORA MISMO, no eres eso.",shape=box,color=red];
		j2538809406 -> j1331856390;
	j2374572440 [label="¡Ah, sí! ¡Qué tonta! Olvidé que el monstruo tuvo un final feliz en nuestra pequeña historia.",shape=box,color=blue];
		j2374572440 -> j1078150364;
	j1306022660 [label="SÉ el monstruo. Asúmelo. Por esta noche del año, luce ese título con orgullo.",shape=box,color=red];
		j1306022660 -> j1997093465;
	j1331856390 [label="Así que vístete. Diviértete. Hasta el Vacío sabe que a todos los Hex les vendría bien.",shape=box,color=red];
		j1331856390 -> j3703772434;
	j1078150364 [label="Perdóname. Todavía no puedo creer que esto es lo que realmente QUIERES. Quizás sólo necesito un poco más de persuasión.",shape=box,color=blue];
		j1078150364 -> j3077246355;
	j1997093465 [label="Oh, hay MUCHAS razones por las que esa es una TERRIBLE IDEA",shape=box,color=blue];
		j1997093465 -> j626933195;
	j3703772434 [label="Seguiré tu consejo. Y gracias de nuevo. x",shape=box,color=blue];
		j3703772434 -> "Chat ends.";
	j3077246355 [label="Hay que devorarnos más tarde. xxx",shape=box,color=blue];
		j3077246355 -> "Chat ends.";
	j626933195 [label="MUCHAS.",shape=box,color=blue];
		j626933195 -> j4094605852;
	"Chat ends." [color=orange];
	j4094605852 [label="(No puedo pensar en ninguna ahora mismo, pero estoy segura de que hay DOCENAS)",shape=box,color=blue];
		j4094605852 -> j34016936;
	j34016936 [label="... mierda.",shape=box,color=blue];
		j34016936 -> j829628048;
	j829628048 [label="me has atrapado en mi propio juego. Maldita sea. Bien hecho. x",shape=box,color=blue];
		j829628048 -> "Chat ends.";
}