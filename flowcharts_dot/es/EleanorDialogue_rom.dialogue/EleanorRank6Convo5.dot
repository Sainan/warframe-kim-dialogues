digraph {
	3068 [label="EleanorRank6Convo5 begins.",color=orange];
		3068 -> 3069;
	3069 [label="Me estaba preguntando, como siempre lo hago...",shape=box,color=blue];
		3069 -> 3070;
	3070 [label="Cuando este ciclo termine, independientemente de cómo suceda, ¿qué pasará con la Tierra?",shape=box,color=blue];
		3070 -> 3071;
	3071 [label="Sé que el año 2000 ya está muy lejos en tu pasado, pero ¿puedes decirme ALGO de lo que le pasará a nuestro pequeño planeta?",shape=box,color=blue];
		3071 -> 3072;
		3071 -> 3074;
	3072 [label="Me temo que nada bueno.",shape=box,color=red];
		3072 -> 3073;
	3074 [label="Honestamente no creo que deba.",shape=box,color=red];
		3074 -> 3076;
	3073 [label="De lo poco que te puedo decir, el Techrot se convierte en un problema mundial. La gente lo resuelve con bombas atómicas... bueno, lo intenta.",shape=box,color=red];
		3073 -> 3075;
	3076 [label="Si te advierto de lo que va a venir puede que intentes cambiarlo, y eso podría ocasionar que yo no exista.",shape=box,color=red];
		3076 -> 3078;
	3075 [label="Así es como empieza la primera de las \"Guerras Radiactivas\".",shape=box,color=red];
		3075 -> 3077;
	3078 [label="Llámame egoísta, pero me gusta existir.",shape=box,color=red];
		3078 -> 3080;
	3077 [label="... y eventualmente que el planeta sea tan inservible que los orokin quieran irse, ¿no?",shape=box,color=blue];
		3077 -> 3079;
	3080 [label="Ah, y supongo que todo lo que has hecho NO ha cambiado el futuro, ¿eh?",shape=box,color=blue];
		3080 -> 3082;
	3079 [label="... lo que nos lleva a todo el asunto de la Zariman, y ahí es donde entras TÚ.",shape=box,color=blue];
		3079 -> 3081;
	3082 [label="Puede que hayas cambiado pequeños detalles, pero los grandes siguen siendo prácticamente los mismos.",shape=box,color=blue];
		3082 -> 3085;
	3081 [label="Es extraño pensar que todo comienza aquí en esta ciudad.",shape=box,color=blue];
		3081 -> 3083;
		3081 -> 3084;
	3085 [label="Creo que el universo sabe lo que está haciendo.",shape=box,color=blue];
		3085 -> 3088;
	3083 [label="Quizás es por eso que este año es tan importante.",shape=box,color=red];
		3083 -> 3086;
	3084 [label="Sí. Desde Höllvania hasta la Zariman Diez-Cero. Es una línea continua.",shape=box,color=red];
		3084 -> 3087;
	3088 [label="Hay mucho más que sólo partículas ciegas flotando por ahí.",shape=box,color=blue];
		3088 -> 3091;
		3088 -> 3092;
	3086 [label="+5 Chemistry",color=orange];
		3086 -> 3089;
	3087 [label="espera...",shape=box,color=blue];
		3087 -> 3090;
	3091 [label="No comparto tu opinión. El universo no tiene mente.",shape=box,color=red];
		3091 -> 3095;
	3092 [label="Estoy de acuerdo. Si algo tan humano como la emoción puede moldear el Vacío...",shape=box,color=red];
		3092 -> 3096;
	3089 [label="Tiene sentido. Si la bomba nuclear de Albrecht hubiera explotado, ¿significaría que no habría Techrot, y por lo tanto, una Tierra destrozada, sin necesidad de escapar, sin el primer viaje al Vacío y sin Indiferencia?",shape=box,color=blue];
		3089 -> 3093;
	3090 [label="Si la tuya era la Zariman Diez-Cero, ¿qué pasó con la Zariman del uno al nueve?",shape=box,color=blue];
		3090 -> 3094;
	3095 [label="Quizás desde una perspectiva muy grande o muy pequeña, pero no al nivel en el que tú y yo existimos.",shape=box,color=blue];
		3095 -> 3099;
	3096 [label="+5 Chemistry",color=orange];
		3096 -> 3100;
	3093 [label="... Voy a ver si Lettie tiene café para llevar. ",shape=box,color=blue];
		3093 -> 3097;
	3094 [label="Drones no tripulados, por lo que recuerdo. ",shape=box,color=red];
		3094 -> 3098;
	3099 [label="Si podemos darle sentido y somos parte del universo, entonces el universo es, por definición, significativo.",shape=box,color=blue];
		3099 -> 3102;
	3100 [label="Exactamente. El significado que le damos no es sólo una conveniente ilusión.",shape=box,color=blue];
		3100 -> 3103;
	3097 [label="Chat ends.",color=orange];
	3098 [label="O cápsulas de terraformación pilotadas por cefalones. Experimentaron muchísimo.",shape=box,color=red];
		3098 -> 3101;
	3102 [label="+5 Chemistry",color=orange];
		3102 -> 3105;
	3103 [label="Pero siempre hay una voz que te susurra y te insiste en que nada de esto importa.",shape=box,color=blue];
		3103 -> 3106;
	3101 [label="Lo llamaron \"El Proyecto\". ",shape=box,color=red];
		3101 -> 3104;
	3105 [label="Nuestra existencia no es menos verdadera ni válida que la de los quarks o las supernovas. Somos importantes, nos guste o no.",shape=box,color=blue];
		3105 -> 3108;
	3106 [label="¿Tal vez el gran enfrentamiento cósmico no sea entre el bien y el mal, sino entre el sentido y la falta de significado?",shape=box,color=blue];
		3106 -> 3109;
	3104 [label="+5 Chemistry",color=orange];
		3104 -> 3107;
	3108 [label="Chat ends.",color=orange];
	3109 [label="Chat ends.",color=orange];
	3107 [label="Suena mejor que \"Operación: Llevemos nuestros irresponsables culos a un nuevo planeta donde podamos mandar todo a la mierda\".",shape=box,color=blue];
		3107 -> 3110;
