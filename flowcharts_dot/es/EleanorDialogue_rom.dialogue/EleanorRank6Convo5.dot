digraph {
	"EleanorRank6Convo5 begins." [color=orange];
		"EleanorRank6Convo5 begins." -> j2569397128;
	j2569397128 [label="Me estaba preguntando, como siempre lo hago...",shape=box,color=blue];
		j2569397128 -> j235176332;
	j235176332 [label="Cuando este ciclo termine, independientemente de cómo suceda, ¿qué pasará con la Tierra?",shape=box,color=blue];
		j235176332 -> j2891885573;
	j2891885573 [label="Sé que el año 2000 ya está muy lejos en tu pasado, pero ¿puedes decirme ALGO de lo que le pasará a nuestro pequeño planeta?",shape=box,color=blue];
		j2891885573 -> j3890886113;
		j2891885573 -> j1125508929;
	j3890886113 [label="Me temo que nada bueno.",shape=box,color=red];
		j3890886113 -> j261375909;
	j1125508929 [label="Honestamente no creo que deba.",shape=box,color=red];
		j1125508929 -> j3218751261;
	j261375909 [label="De lo poco que te puedo decir, el Techrot se convierte en un problema mundial. La gente lo resuelve con bombas atómicas... bueno, lo intenta.",shape=box,color=red];
		j261375909 -> j353507332;
	j3218751261 [label="Si te advierto de lo que va a venir puede que intentes cambiarlo, y eso podría ocasionar que yo no exista.",shape=box,color=red];
		j3218751261 -> j2676839598;
	j353507332 [label="Así es como empieza la primera de las \"Guerras Radiactivas\".",shape=box,color=red];
		j353507332 -> j1502798063;
	j2676839598 [label="Llámame egoísta, pero me gusta existir.",shape=box,color=red];
		j2676839598 -> j1413086709;
	j1502798063 [label="... y eventualmente que el planeta sea tan inservible que los orokin quieran irse, ¿no?",shape=box,color=blue];
		j1502798063 -> j3136437424;
	j1413086709 [label="Ah, y supongo que todo lo que has hecho NO ha cambiado el futuro, ¿eh?",shape=box,color=blue];
		j1413086709 -> j2324278920;
	j3136437424 [label="... lo que nos lleva a todo el asunto de la Zariman, y ahí es donde entras TÚ.",shape=box,color=blue];
		j3136437424 -> j3921720961;
	j2324278920 [label="Puede que hayas cambiado pequeños detalles, pero los grandes siguen siendo prácticamente los mismos.",shape=box,color=blue];
		j2324278920 -> j209242514;
	j3921720961 [label="Es extraño pensar que todo comienza aquí en esta ciudad.",shape=box,color=blue];
		j3921720961 -> j1955230006;
		j3921720961 -> j2054145865;
	j209242514 [label="Creo que el universo sabe lo que está haciendo.",shape=box,color=blue];
		j209242514 -> j284403843;
	j1955230006 [label="Quizás es por eso que este año es tan importante.",shape=box,color=red];
		j1955230006 -> j675999452;
	j2054145865 [label="Sí. Desde Höllvania hasta la Zariman Diez-Cero. Es una línea continua.",shape=box,color=red];
		j2054145865 -> j143867293;
	j284403843 [label="Hay mucho más que sólo partículas ciegas flotando por ahí.",shape=box,color=blue];
		j284403843 -> j3385519946;
		j284403843 -> j2940088254;
	j675999452 [label="+5 Chemistry",color=orange];
		j675999452 -> j3027002506;
	j143867293 [label="espera...",shape=box,color=blue];
		j143867293 -> j396646206;
	j3385519946 [label="No comparto tu opinión. El universo no tiene mente.",shape=box,color=red];
		j3385519946 -> j525899279;
	j2940088254 [label="Estoy de acuerdo. Si algo tan humano como la emoción puede moldear el Vacío...",shape=box,color=red];
		j2940088254 -> j2118032536;
	j3027002506 [label="Tiene sentido. Si la bomba nuclear de Albrecht hubiera explotado, ¿significaría que no habría Techrot, y por lo tanto, una Tierra destrozada, sin necesidad de escapar, sin el primer viaje al Vacío y sin Indiferencia?",shape=box,color=blue];
		j3027002506 -> j1454316792;
	j396646206 [label="Si la tuya era la Zariman Diez-Cero, ¿qué pasó con la Zariman del uno al nueve?",shape=box,color=blue];
		j396646206 -> j3071149477;
	j525899279 [label="Quizás desde una perspectiva muy grande o muy pequeña, pero no al nivel en el que tú y yo existimos.",shape=box,color=blue];
		j525899279 -> j903617007;
	j2118032536 [label="+5 Chemistry",color=orange];
		j2118032536 -> j3607007961;
	j1454316792 [label="... Voy a ver si Lettie tiene café para llevar. ",shape=box,color=blue];
		j1454316792 -> "Chat ends.";
	j3071149477 [label="Drones no tripulados, por lo que recuerdo. ",shape=box,color=red];
		j3071149477 -> j1876538549;
	j903617007 [label="Si podemos darle sentido y somos parte del universo, entonces el universo es, por definición, significativo.",shape=box,color=blue];
		j903617007 -> j2835424294;
	j3607007961 [label="Exactamente. El significado que le damos no es sólo una conveniente ilusión.",shape=box,color=blue];
		j3607007961 -> j251673940;
	"Chat ends." [color=orange];
	j1876538549 [label="O cápsulas de terraformación pilotadas por cefalones. Experimentaron muchísimo.",shape=box,color=red];
		j1876538549 -> j606982860;
	j2835424294 [label="+5 Chemistry",color=orange];
		j2835424294 -> j3554050147;
	j251673940 [label="Pero siempre hay una voz que te susurra y te insiste en que nada de esto importa.",shape=box,color=blue];
		j251673940 -> j1940527807;
	j606982860 [label="Lo llamaron \"El Proyecto\". ",shape=box,color=red];
		j606982860 -> j1406650295;
	j3554050147 [label="Nuestra existencia no es menos verdadera ni válida que la de los quarks o las supernovas. Somos importantes, nos guste o no.",shape=box,color=blue];
		j3554050147 -> "Chat ends.";
	j1940527807 [label="¿Tal vez el gran enfrentamiento cósmico no sea entre el bien y el mal, sino entre el sentido y la falta de significado?",shape=box,color=blue];
		j1940527807 -> "Chat ends.";
	j1406650295 [label="+5 Chemistry",color=orange];
		j1406650295 -> j3617934885;
	j3617934885 [label="Suena mejor que \"Operación: Llevemos nuestros irresponsables culos a un nuevo planeta donde podamos mandar todo a la mierda\".",shape=box,color=blue];
		j3617934885 -> "Chat ends.";
}