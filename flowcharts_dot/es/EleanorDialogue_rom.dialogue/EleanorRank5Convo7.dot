digraph {
	2607 [label="EleanorRank5Convo7 begins.",color=orange];
		2607 -> 2608;
	2608 [label="¿\"La Indiferencia\" es lo que ES o lo que QUIERE?",shape=box,color=blue];
		2608 -> 2609;
		2608 -> 2610;
		2608 -> 2611;
	2609 [label="Tú y Lettie hacen eso, ¿sabes? Se olvidan de decir \"hola\".",shape=box,color=red];
		2609 -> 2613;
	2610 [label="La mayoría de la gente comenzaría con \"hola\".",shape=box,color=red];
		2610 -> 2614;
	2611 [label="[Ignorar]",shape=box,color=red];
		2611 -> 2612;
	2613 [label="Has encontrado lo único que compartimos, felicitaciones. Y lo siento. Esto es más importante.",shape=box,color=blue];
		2613 -> 2615;
	2614 [label="Lo siento. Esto es más importante.",shape=box,color=blue];
		2614 -> 2615;
	2612 [label="Chat ends.",color=orange];
	2615 [label="Creo que 'La Gran Indiferencia' va a intentar interponerse entre nosotros, de alguna manera.",shape=box,color=blue];
		2615 -> 2616;
	2616 [label="No te rías. Lo puedo sentir, en lo más profundo de mi ser. A la cosa que había en Rusalka le encantaría vernos destrozándonos unos a otros.",shape=box,color=blue];
		2616 -> 2617;
	2617 [label="No sé por qué. Simplemente lo sé.",shape=box,color=blue];
		2617 -> 2618;
		2617 -> 2619;
	2618 [label="Sí, creo que tienes razón.",shape=box,color=red];
		2618 -> 2620;
	2619 [label="Tal vez eso fue lo que le pasó a la familia de Entrati. Llevaban años viviendo encima de su laboratorio sin saberlo. Cuando el infante los encontró, estaban distanciados y sumidos en su despecho.",shape=box,color=red];
		2619 -> 2620;
	2620 [label="Lo he visto en tu cabeza. Albrecht y Loid. Madre y Padre. Tú y tus padres. Rusalka y Viktor, por lo que sabemos. Y nosotros seis, por supuesto.",shape=box,color=blue];
		2620 -> 2621;
	2621 [label="Lo que hace esta cosa es frío y perverso, pero hay una motivación detrás, en algún lugar.",shape=box,color=blue];
		2621 -> 2622;
		2621 -> 2623;
	2622 [label="Creo que tienes razón. En la Zariman, los padres fueron los primeros en perder la cabeza. Tal vez Los Inquebrantables resistieron tanto tiempo porque ninguno de ellos tenía hijos.",shape=box,color=red];
		2622 -> 2627;
	2623 [label="No me gusta pretender que entiendo cosas que son básicamente *dioses*. Esta cosa está intentando comprender las emociones. Pero está jugando mal con sus juguetes.",shape=box,color=red];
		2623 -> 2624;
	2627 [label="Deja que intente interponerse entre nosotros. Por Sol que acabaré con ella. Encontraré una manera.",shape=box,color=blue];
		2627 -> 2628;
	2624 [label="Una teoría admirable, pero no lo SABEMOS, ¿verdad?",shape=box,color=blue];
		2624 -> 2625;
	2628 [label="Hay poderes en el universo contra los cuales esa cosa no puede oponerse. Elijo creer en ello con cada átomo de mi ser.",shape=box,color=blue];
		2628 -> 2629;
	2625 [label="Si tienes razón, entonces es inocente. Casi infantil. Eso no encaja con lo que sabemos. Es malévolo.",shape=box,color=blue];
		2625 -> 2626;
	2629 [label="Si me traga entera, me clavaré en su garganta y la ahogaré.",shape=box,color=blue];
		2629 -> 2630;
		2629 -> 2631;
	2626 [label="Chat ends.",color=orange];
	2630 [label="Esa es una gran manera de morir.",shape=box,color=red];
		2630 -> 2632;
	2631 [label="Aún no sé cómo lo vamos a hacer, pero estoy contigo. Tenemos que ganar.",shape=box,color=red];
		2631 -> 2635;
	2632 [label="Estoy muerta de todas formas en este escenario.",shape=box,color=blue];
		2632 -> 2633;
	2635 [label="Si esto fuera una historia, se te ocurriría algún truco ingenioso: desenterrarías el corazón de piedra del gigante y lo romperías con una pluma de cisne, o lo engañarías para que se arrojara por un acantilado.",shape=box,color=blue];
		2635 -> 2636;
	2633 [label="Pero al menos puedo escupirle en el ojo.",shape=box,color=blue];
		2633 -> 2634;
	2636 [label="Dijiste que eras \"periodista\". Ese no era el tipo de historias que solías contar, ¿no? Decías la verdad, por muy fea que fuera.",shape=box,color=red];
		2636 -> 2637;
	2634 [label="Chat ends.",color=orange];
	2637 [label="Si esas viejas historias no dijeran la verdad, la gente no habría seguido contándolas.",shape=box,color=blue];
		2637 -> 2638;
	2638 [label="No quiero decir que los gigantes sean reales, sólo que las viejas historias cuentan un tipo de verdad diferente.",shape=box,color=blue];
		2638 -> 2639;
		2638 -> 2640;
	2639 [label="Necesitaremos algo más que cuentos de hadas para superar esto, por muy inspiradores que sean.",shape=box,color=red];
		2639 -> 2641;
	2640 [label="He vivido en un reino hecho de historias. Sé lo poderosas que pueden ser.",shape=box,color=red];
		2640 -> 2643;
	2641 [label="Lo sé. Ojalá tuviera algo más que instinto para seguir adelante.",shape=box,color=blue];
		2641 -> 2642;
	2643 [label="Creo que lo único que todas esas historias de asesinos de gigantes tienen en común es esto: todas tratan sobre aprender las reglas y descubrir cómo ser astuto con ellas.",shape=box,color=blue];
		2643 -> 2644;
	2642 [label="Nos enfrentamos a algo enorme, aterrador y que escapa a nuestra comprensión. Normalmente, sólo los niños pueden hacerlo. Por eso existen los cuentos de hadas.",shape=box,color=blue];
		2642 -> 2645;
		2642 -> 2646;
	2644 [label="Algunos monstruos son estúpidos. Algunos se ven obligados a ser literales. Algunos tienen secretos. Pero no puedes ganar hasta que conozcas las reglas a las que está sujeto el monstruo.",shape=box,color=blue];
		2644 -> 2645;
		2644 -> 2646;
	2645 [label="Está atascado en la Pared. Ni siquiera sé qué es la Pared.",shape=box,color=red];
		2645 -> 2647;
	2646 [label="No creo que la Indiferencia esté sujeta a ninguna regla.",shape=box,color=red];
		2646 -> 2649;
	2647 [label="No importa. Si realmente está atascado, entonces podemos deducir dos cosas, ¿no?",shape=box,color=blue];
		2647 -> 2651;
	2649 [label="¡Tiene que estarlo! ¡Hasta los dioses tienen reglas! No importa cuán poderosa parezca la Indiferencia, no es un Dios.",shape=box,color=blue];
		2649 -> 2650;
	2651 [label="Uno: puede quedar atrapado. Tal vez incluso encarcelado.",shape=box,color=blue];
		2651 -> 2653;
	2650 [label="Venciste a Thrax. No importa cuántas veces fallaste y terminaste en el suelo. GANASTE. ¿Por qué no deberías vencer también al Hombre en la Pared?",shape=box,color=blue];
		2650 -> 2648;
	2653 [label="+15 Chemistry",color=orange];
		2653 -> 2652;
	2648 [label="¿Cuándo dejaste de tenerle miedo, Eleanor?",shape=box,color=red];
		2648 -> 2655;
	2652 [label="Y segundo: QUIERE algo. Quiere salir. Si sabemos lo que quiere, ya estamos un paso por delante.",shape=box,color=blue];
		2652 -> 2654;
	2655 [label="No lo hice.",shape=box,color=blue];
		2655 -> 2657;
	2654 [label="Chat ends.",color=orange];
	2657 [label="+20 Chemistry",color=orange];
		2657 -> 2656;
	2656 [label="Sólo tengo más miedo de perderte, ¿de acuerdo?",shape=box,color=blue];
		2656 -> 2658;
	2658 [label="Chat ends.",color=orange];
}