digraph {
	1521 [label="EleanorRank4Convo2 begins.",color=orange];
		1521 -> 1522;
	1522 [label="¡Oh, Viajero! ¡Oh, vagabundo del tiempo y del espacio! ¡Qué bienvenida es tu presencia en esta pequeña pantalla mía!",shape=box,color=blue];
		1522 -> 1523;
		1522 -> 1524;
	1523 [label="Hola, Eleanor.",shape=box,color=red];
		1523 -> 1526;
	1524 [label="Ya vengo, Kalymos está jugando con los cables de nuevo y podría desconec.. [Fin]",shape=box,color=red];
		1524 -> 1525;
	1526 [label="Ey, colega.",shape=box,color=blue];
		1526 -> 1527;
	1525 [label="Chat ends.",color=orange];
	1527 [label="Adivina qué.",shape=box,color=blue];
		1527 -> 1528;
		1527 -> 1529;
	1528 [label="¿Tienes alguna pregunta sobre cómo será la vida en el futuro?",shape=box,color=red];
		1528 -> 1530;
	1529 [label="Te ha crecido una cola.",shape=box,color=red];
		1529 -> 1531;
	1530 [label="Ugh. Soy tan tediosamente predecible.",shape=box,color=blue];
		1530 -> 1533;
	1531 [label="...te gustaría eso, ¿no?",shape=box,color=blue];
		1531 -> 1532;
	1533 [label="Sí. Una más. Pero esta es una muy importante, así que ten paciencia, ¿de acuerdo?",shape=box,color=blue];
		1533 -> 1534;
	1532 [label="Lamentablemente, no. Mi trasero no ha mejorado con la adición de una cola. No se puede mejorar, porque ya es perfecto.",shape=box,color=blue];
		1532 -> 1535;
	1534 [label="Haré mi mejor esfuerzo.",shape=box,color=red];
		1534 -> 1536;
	1535 [label="Sin embargo, tengo una pregunta para ti.",shape=box,color=blue];
		1535 -> 1537;
	1536 [label="Bien. Genial. Entonces.",shape=box,color=blue];
		1536 -> 1537;
	1537 [label="¿Cómo funcionan las relaciones en tu época? Es decir, ¿se trata de lo típico: \"dos o más adultos se reúnen con distintos grados de solemnidad\"? ¿O hay todo tipo de reglas sobre quién puede estar con quién?",shape=box,color=blue];
		1537 -> 1538;
		1537 -> 1539;
		1537 -> 1540;
	1538 [label="Eso es algo que no he investigado.",shape=box,color=red];
		1538 -> 1541;
	1539 [label="Depende de la cultura.",shape=box,color=red];
		1539 -> 1542;
	1540 [label="… ¿Por qué preguntas?",shape=box,color=red];
		1540 -> 1543;
	1541 [label="Vaya.",shape=box,color=blue];
		1541 -> 1547;
	1542 [label="Cierto. Por supuesto.",shape=box,color=blue];
		1542 -> 1548;
	1543 [label="Check boolean EleanorEntrati",color=orange];
		1543 -> 1544 [label=true,color=green];
		1543 -> 1545 [label=false,color=brown];
	1547 [label="Sabía de tu aislamiento en Duviri, pero no tenía idea de que hubiera sido TAN intenso.",shape=box,color=blue];
		1547 -> 1552;
	1548 [label="Déjame intentar otra táctica.",shape=box,color=blue];
		1548 -> 1550;
	1544 [label="Esos dos de Deimos, Padre y Madre, son una pareja casada. Puede que sean gigantescos ex-orokin infestados, pero están clara y dolorosamente CASADOS, exactamente de la misma manera que mi madre y mi padre.",shape=box,color=blue];
		1544 -> 1546;
	1545 [label="De los fragmentos que he recopilado de tu mente, todavía veo parejas típicas de personas. Personas que están clara y dolorosamente CASADAS exactamente de la misma manera que lo están mi mamá y mi papá.",shape=box,color=blue];
		1545 -> 1546;
	1552 [label="+15 Chemistry",color=orange];
		1552 -> 1549;
	1550 [label="Vamos a ver...",shape=box,color=blue];
		1550 -> 1554;
	1546 [label="¿Entonces ese era el estándar para los Orokin?",shape=box,color=blue];
		1546 -> 1551;
	1549 [label="Lamento sinceramente si te he causado alguna molestia al preguntar.",shape=box,color=blue];
		1549 -> 1553;
	1554 [label="Está bien. Entonces, de donde vienes, ¿sería normal que una persona mantuviera una relación con, digamos, un céfalon?",shape=box,color=blue];
		1554 -> 1555;
		1554 -> 1556;
	1551 [label="Los Orokin eran muy partidarios de las reglas y los tabúes. Les encantaba la jerarquía. Las relaciones no podían cruzar las barreras sociales. Un Dax no podía estar con un noble orokin, por ejemplo.",shape=box,color=red];
		1551 -> 1554;
	1553 [label="Chat ends.",color=orange];
	1555 [label="Podría intentar arrastrar a Ordis de regreso aquí en el tiempo si quieres intentar averiguarlo...",shape=box,color=red];
		1555 -> 1557;
	1556 [label="… Nunca he oído hablar de ello y no estoy seguro de cómo funcionaría.",shape=box,color=red];
		1556 -> 1560;
	1557 [label="¡Estoy tratando de hacer una pregunta TEÓRICA!",shape=box,color=blue];
		1557 -> 1558;
	1560 [label="Maldita sea. Déjame intentarlo otra vez.",shape=box,color=blue];
		1560 -> 1561;
	1558 [label="No tengo ganas de frotarme contra tu compañero de vidrio, por muy encantador que sea",shape=box,color=blue];
		1558 -> 1559;
	1561 [label="Inventa a alguien de tu época que sea mujer y peligrosa. Y también fuerte. Como la Mayor Rusalka sin la posesión demoníaca.",shape=box,color=blue];
		1561 -> 1562;
		1561 -> 1563;
	1559 [label="Estoy intentando, y sin éxito, preguntarte sobre los DESEQUILIBRIOS DE PODER",shape=box,color=blue];
		1559 -> 1561;
	1562 [label="¿Una francotiradora grineer?",shape=box,color=red];
		1562 -> 1564;
	1563 [label="¿Una Dax?",shape=box,color=red];
		1563 -> 1565;
	1564 [label="Está bien. Digamos que hay una francotiradora grineer que se enamora de un humano. Y es mutuo. Amantes desventurados. Desesperadamente trágicos. ¿Podrían estar juntos?",shape=box,color=blue];
		1564 -> 1566;
		1564 -> 1567;
		1564 -> 1568;
		1564 -> 1569;
	1565 [label="Está bien. Digamos que hay una Dax que se enamora de un humano. Y es mutuo. Amantes desventurados. Desesperadamente trágicos. ¿Podrían estar juntos?",shape=box,color=blue];
		1565 -> 1566;
		1565 -> 1567;
		1565 -> 1568;
		1565 -> 1569;
	1566 [label="Si es lo que ambos quisieran, claro.",shape=box,color=red];
		1566 -> 1570;
	1567 [label="¿Por qué no?",shape=box,color=red];
		1567 -> 1570;
	1568 [label="Me gustaría ver que alguien intentara detenerlos.",shape=box,color=red];
		1568 -> 1570;
	1569 [label="Sí, pero sería difícil.",shape=box,color=red];
		1569 -> 1576;
	1570 [label="Estoy enredando más las cosas.",shape=box,color=blue];
		1570 -> 1572;
	1576 [label="+5 Chemistry",color=orange];
		1576 -> 1571;
	1572 [label="¿Es normal en donde vienes que la gente tenga parejas mucho más poderosas y peligrosas que ellos? ¿Como en 'Gumbly y los calcetines del dragón', cuando el príncipe elfo acaba casado con el gigante?",shape=box,color=blue];
		1572 -> 1574;
	1571 [label="Gracias.",shape=box,color=blue];
		1571 -> 1573;
	1574 [label="… no sabes de qué estoy hablando, ¿verdad?",shape=box,color=blue];
		1574 -> 1578;
		1574 -> 1579;
	1573 [label="Pregunta: ¿Pueden dos personas con físicos y niveles de letalidad muy diferentes tener una relación? Respuesta: sí.",shape=box,color=blue];
		1573 -> 1575;
	1578 [label="En realidad, tengo la certeza de que sí.",shape=box,color=red];
		1578 -> 1582;
	1579 [label="No realmente, no.",shape=box,color=red];
		1579 -> 1580;
	1575 [label="Eso es todo lo que quería saber.",shape=box,color=blue];
		1575 -> 1577;
	1582 [label="No quiero arruinarte el día. Lo siento.",shape=box,color=blue];
		1582 -> 1583;
	1580 [label="Será mejor que pare. Estoy en peligro de hacer el ridículo.",shape=box,color=blue];
		1580 -> 1581;
	1577 [label="Chat ends.",color=orange];
	1583 [label="¿Me permites un discurso autocompasivo?",shape=box,color=blue];
		1583 -> 1584;
		1583 -> 1585;
	1581 [label="Chat ends.",color=orange];
	1584 [label="Adelante.",shape=box,color=red];
		1584 -> 1587;
	1585 [label="Lo siento, no tengo tiempo para esto. [Fin]",shape=box,color=red];
		1585 -> 1586;
	1587 [label="NO estoy diciendo que mi vida no tenga sentido sin alguien con quien compartirla",shape=box,color=blue];
		1587 -> 1588;
	1586 [label="Chat ends.",color=orange];
	1588 [label="NO me define a quién elijo amar",shape=box,color=blue];
		1588 -> 1589;
	1589 [label="Yo soy suficiente para mí misma",shape=box,color=blue];
		1589 -> 1590;
	1590 [label="PERO ¿CÓMO SE SUPONE QUE VOY A CONSIDERAR LA POSIBILIDAD DE UNA RELACIÓN CUANDO PODRÍA MATAR LITERALMENTE A ALGUIEN POR ACCIDENTE SI ME DEJO LLEVAR?",shape=box,color=blue];
		1590 -> 1591;
	1591 [label="Bienvenidos a Eleanor y sus problemas carnales de mantis",shape=box,color=blue];
		1591 -> 1592;
	1592 [label="Si algún día encuentro a ese cabrón de Entrati, le convertiré las pelotas en pendientes. Si es que tiene pelotas.",shape=box,color=blue];
		1592 -> 1593;
		1592 -> 1594;
	1593 [label="Siempre puedes salir con alguien del Hex.",shape=box,color=red];
		1593 -> 1595;
	1594 [label="Espera. ¿Estás soltera porque te preocupa lastimar a alguien?",shape=box,color=red];
		1594 -> 1596;
	1595 [label="OH POR SOL",shape=box,color=blue];
		1595 -> 1597;
	1596 [label="Sí.",shape=box,color=blue];
		1596 -> 1601;
	1597 [label="LITERALMENTE ME ESTOY MORDIENDO LA LENGUA PARA NO REÍR",shape=box,color=blue];
		1597 -> 1598;
	1601 [label="Tú sabes lo que soy mejor que yo, creo. Soy un protoframe. Soy una máquina de guerra parcialmente transformada, y parece que cada día eso se vuelve menos parcial.",shape=box,color=blue];
		1601 -> 1602;
	1598 [label="La única de esos cuatro con la que podría CONSIDERAR salir es Aoi y eso es complicado debido a Arthur",shape=box,color=blue];
		1598 -> 1599;
	1602 [label="Quien sea que diseñó a la pobre \"Nyx\" estaba construyendo una asesina. Esa soy yo, ahora. Eficiente. Letal. Adorable como un explosivo.",shape=box,color=blue];
		1602 -> 1603;
	1599 [label="Gracias por la sugerencia, pero no, ni en un millón de años",shape=box,color=blue];
		1599 -> 1600;
	1603 [label="Todo esto está muy bien cuando se trata del trabajo diario, pero en la fiesta de la oficina, ¿quién va a besar una trampa mortal ambulante bajo el muérdago?",shape=box,color=blue];
		1603 -> 1604;
		1603 -> 1606;
	1600 [label="Chat ends.",color=orange];
	1604 [label="Este daño accidental que te preocupa, ¿ha pasado alguna vez? ¿Alguna vez has hecho daño a alguien con quien estabas?",shape=box,color=red];
		1604 -> 1605;
	1606 [label="Quiero decir, al menos la buena noticia es que si hubiera un accidente, nadie en Höllvania permanece muerto después del reinicio...",shape=box,color=red];
		1606 -> 1607;
	1605 [label="No, no ha sucedido porque yo no lo he permitido. ¿De acuerdo?",shape=box,color=blue];
		1605 -> 1608;
	1607 [label="...",shape=box,color=blue];
		1607 -> 1609;
	1608 [label="Sin parejas, no hay víctimas. No vale la pena correr el riesgo.",shape=box,color=blue];
		1608 -> 1610;
	1609 [label="No lo había considerado.",shape=box,color=blue];
		1609 -> 1611;
	1610 [label="Prefiero estar sola que sumida en la culpa, gracias.",shape=box,color=blue];
		1610 -> 1612;
	1611 [label="Sin embargo, nuestros recuerdos persisten.",shape=box,color=blue];
		1611 -> 1613;
	1612 [label="¿Entonces has estado soltera desde las inyecciones de Entrati?",shape=box,color=red];
		1612 -> 1618;
	1613 [label="No creo que nadie quisiera tener una relación con alguien que le arrancó la cabeza una vez, incluso si la cosa mejora.",shape=box,color=blue];
		1613 -> 1614;
	1618 [label="+20 Chemistry",color=orange];
		1618 -> 1615;
	1614 [label="Lua lloró. Necesito un trago ahora.",shape=box,color=blue];
		1614 -> 1620;
	1615 [label="Correcto. Un compromiso que estoy dispuesta a aceptar.",shape=box,color=blue];
		1615 -> 1616;
	1620 [label="Chat ends.",color=orange];
	1616 [label="Lo siento. No estoy segura de que hablar de esto haya sido una buena idea.",shape=box,color=blue];
		1616 -> 1617;
	1617 [label="Creo que necesito estar sola por un rato.",shape=box,color=blue];
