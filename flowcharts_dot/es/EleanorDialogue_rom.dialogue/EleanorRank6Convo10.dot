		j760463110 -> j2906569668;
	j2906569668 [label="¿Y si lo que recuerdo como el primer ciclo es realmente el ciclo quince mil cuarenta y dos?",shape=box,color=blue];
		j2906569668 -> j3412647883;
	j3412647883 [label="y luego pensé, bueno, al diablo, también podría volverme completamente loca y hacer lo que yo quiera porque, al final, siempre puedo reiniciar todo de nuevo",shape=box,color=blue];
		j3412647883 -> j365031555;
	j365031555 [label="pero LUEGO pensé, no, espera, ¿y si esta es la definitiva? ¿Donde por fin pasaremos de 1999 al 2000?",shape=box,color=blue];
		j365031555 -> j1264282529;
	j1264282529 [label="No quiero hacer el ridículo en un bucle que termine siendo el 1999 definitivo. Nunca podría arreglarlo.",shape=box,color=blue];
		j1264282529 -> j919135375;
	j919135375 [label="Para usar la vieja y cansada analogía, un día será el solsticio y no solo el inverno interminable",shape=box,color=blue];
