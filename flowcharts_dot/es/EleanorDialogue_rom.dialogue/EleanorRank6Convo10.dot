	j3188348462 [label="Entonces, estaba pensando: el año se va a repetir al final de diciembre, como siempre lo hace, y aunque se va a SENTIR como un nuevo año, REALMENTE no lo será",shape=box,color=blue];
		j3188348462 -> j760463110;
