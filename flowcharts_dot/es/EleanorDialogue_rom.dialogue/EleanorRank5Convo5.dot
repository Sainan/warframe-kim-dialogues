	2468 [label="¿Tuviste otra pesadilla?",shape=box,color=red];
		2468 -> 2466;
	2466 [label="No he tenido el sueño de Arthur ni una vez desde que te conté lo de la abuela Callie. Creo que exorcizaste a ese demonio.",shape=box,color=blue];
		2466 -> 2469;
	2469 [label="Check boolean EleanorDating",color=orange];
		2469 -> 2470 [label=true,color=green];
		2469 -> 2471 [label=false,color=brown];
	2470 [label="Pero desde que estamos juntos, ha sucedido algo más. Es un poco incómodo, en realidad. Tenía pensado hablar contigo sobre esto, pero no ha sido un buen momento.",shape=box,color=blue];
		2470 -> 2472;
		2470 -> 2473;
		2470 -> 2474;
	2471 [label="Pero eso no quiere decir que no haya habido OTROS sueños. Unos sueños bastante inquietantes.",shape=box,color=blue];
		2471 -> 2480;
		2471 -> 2481;
		2471 -> 2482;
	2472 [label="¿Estás soñando conmigo?",shape=box,color=red];
		2472 -> 2475;
	2473 [label="¿Sueñas con nosotros?",shape=box,color=red];
		2473 -> 2476;
	2474 [label="¿Incómodo? Esto no suena bien.",shape=box,color=red];
		2474 -> 2477;
	2480 [label="No creo que te alteres fácilmente.",shape=box,color=red];
		2480 -> 2483;
	2481 [label="¿Que vas cayendo por un tramo interminable de escaleras?",shape=box,color=red];
		2481 -> 2484;
	2482 [label="Podría ser importante. Con tu habilidad, un sueño podría no ser solo un sueño.",shape=box,color=red];
		2482 -> 2485;
	2475 [label="Eso no sería incómodo. Esto sí lo es.",shape=box,color=blue];
		2475 -> 2478;
	2476 [label="Dioses, ojalá. Nada tan agradable, me temo.",shape=box,color=blue];
		2476 -> 2478;
	2477 [label="No te preocupes. No es tan malo. No tengo miedo. Es solo que...",shape=box,color=blue];
		2477 -> 2478;
	2483 [label="No lo hago, y por eso esto es tan preocupante.",shape=box,color=blue];
		2483 -> 2486;
	2484 [label="No, no es ese. Pero es curioso que todo el mundo parezca haberlo tenido.",shape=box,color=blue];
		2484 -> 2486;
	2485 [label="Eso es exactamente lo que temo.",shape=box,color=blue];
		2485 -> 2486;
	2478 [label="(Está bien, Eleanor, respira profundo, puedes hacerlo)",shape=box,color=blue];
		2478 -> 2479;
	2486 [label="(Está bien, Eleanor, respira profundo, puedes hacerlo)",shape=box,color=blue];
		2486 -> 2487;
	2479 [label="Creo que el Techrot está celoso.",shape=box,color=blue];
		2479 -> 2490;
		2479 -> 2491;
	2487 [label="Creo que el Techrot está celoso.",shape=box,color=blue];
		2487 -> 2488;
		2487 -> 2489;
	2490 [label="Tienes que estar bromeando.",shape=box,color=red];
		2490 -> 2494;
	2491 [label="¿Celoso?",shape=box,color=red];
		2491 -> 2495;
	2488 [label="Tienes que estar bromeando.",shape=box,color=red];
		2488 -> 2492;
	2489 [label="¿Celoso?",shape=box,color=red];
		2489 -> 2493;
	2494 [label="¡Oh, eso quisiera!",shape=box,color=blue];
		2494 -> 2496;
	2495 [label="Celoso de ti por llevarme lejos, sí.",shape=box,color=blue];
		2495 -> 2496;
	2492 [label="¡Oh, eso quisiera!",shape=box,color=blue];
		2492 -> 2497;
	2493 [label="Celoso de nuestra amistad, sí.",shape=box,color=blue];
		2493 -> 2497;
	2496 [label="En un nivel profundamente desquiciado, me considera su propiedad. Se suponía que yo sería su candidata a procrear. Las legacitas me ven como una reina rival, ¿sabes?",shape=box,color=blue];
		2496 -> 2498;
		2496 -> 2499;
	2497 [label="En un nivel profundamente desquiciado, me considera su propiedad. Se suponía que yo sería su candidata a procrear. Las legacitas me ven como una reina rival, ¿sabes?",shape=box,color=blue];
		2497 -> 2500;
		2497 -> 2501;
	2498 [label="Los warframes no funcionan así. La infestación que hay en ellos está controlada, latente. Excepto por Nidus, supongo, pero él es una ley en sí mismo.",shape=box,color=red];
		2498 -> 2503;
	2499 [label="Entonces, ¿el Techrot piensa que te robé y ahora quiere recuperarte?",shape=box,color=red];
		2499 -> 2504;
	2500 [label="Los warframes no funcionan así. La infestación que hay en ellos está controlada, latente. Excepto por Nidus, supongo, pero él es una ley en sí mismo.",shape=box,color=red];
		2500 -> 2502;
	2501 [label="¿Entonces el Techrot piensa que te estoy impidiendo volver a él?",shape=box,color=red];
		2501 -> 2505;
	2503 [label="Bueno, tal vez si yo fuera un warframe completo, el Techrot no me vería de esta manera. Tal como están las cosas, mis células aún se están desvaneciendo y me ve como si fuera suya.",shape=box,color=blue];
		2503 -> 2506;
	2504 [label="¿No es extraño? ¡El ex despechado!",shape=box,color=blue];
		2504 -> 2506;
	2502 [label="Bueno, tal vez si yo fuera un warframe completo, el Techrot no me vería de esta manera. Tal como están las cosas, mis células aún se están desvaneciendo y me ve como si fuera suya.",shape=box,color=blue];
		2502 -> 2507;
	2505 [label="Sí. Quiere que vuelva a su banda.",shape=box,color=blue];
		2505 -> 2507;
	2506 [label="De donde yo vengo, tendrías que ir a pelearte con él en la parte trasera del supermercado local. No estoy segura de cómo funciona eso en tu época.",shape=box,color=blue];
		2506 -> 2508;
	2507 [label="Ésta es tu familia REAL, susurra. Vuelve a ser parte de nosotros, hermana separada. Sé aceptada.",shape=box,color=blue];
		2507 -> 2508;
	2508 [label="Espera, retrocede un poco. ¿Cómo sabes que eso es lo que siente el Techrot?",shape=box,color=red];
		2508 -> 2509;
	2509 [label="Oh, dioses, esta es la parte incómoda.",shape=box,color=blue];
		2509 -> 2510;
	2510 [label="¿Los sueños que mencioné antes? Estoy segura de que el Techrot los envía.",shape=box,color=blue];
		2510 -> 2511;
	2511 [label="Sea lo que sea lo que tiene esa cosa como mente, siempre ha podido conectarse con la mía. Los pensamientos que envía son siempre tan crudos y débiles que puedo rechazarlos fácilmente.",shape=box,color=blue];
		2511 -> 2512;
	2512 [label="La mayor parte del tiempo simplemente siento un rasguño frenético en la parte posterior del cráneo, como cuando estás en el baño y hay un gato tratando de abrir la puerta.",shape=box,color=blue];
		2512 -> 2513;
		2512 -> 2514;
	2513 [label="Pero cuando estás dormida la historia es diferente ¿verdad?",shape=box,color=red];
		2513 -> 2515;
	2514 [label="Creo que puedo ver hacia dónde va esto.",shape=box,color=red];
		2514 -> 2515;
	2515 [label="Correcto. Mis defensas están abajo y puede alcanzarme.",shape=box,color=blue];
		2515 -> 2516;
	2516 [label="Me ha estado golpeando en el nivel más primordial, si sabes a qué me refiero. Quiere que vuelva. Promete que puede hacerme sentir un éxtasis como nunca antes lo he conocido.",shape=box,color=blue];
		2516 -> 2517;
	2517 [label="Sembrará en mi carne los quistes supurantes de la nueva vida, porque cree que eso es lo que quiero, ¿entiendes?",shape=box,color=blue];
		2517 -> 2518;
	2518 [label="Check boolean EleanorDating",color=orange];
		2518 -> 2519 [label=true,color=green];
		2518 -> 2520 [label=true,color=green];
		2518 -> 2521 [label=false,color=brown];
		2518 -> 2522 [label=false,color=brown];
	2519 [label="Bueno, supongo que hasta aquí llegó nuestra relación. ¿Cómo puedo competir con eso?",shape=box,color=red];
		2519 -> 2523;
	2520 [label="Lo *quemaré todo* antes de dejar que te lleve.",shape=box,color=red];
		2520 -> 2524;
	2521 [label="Nunca dejaré que te lleve, Eleanor. Eres mi amiga.",shape=box,color=red];
		2521 -> 2525;
	2522 [label="Eres como familia para mí. No voy a dejar que eso te lleve.",shape=box,color=red];
		2522 -> 2526;
	2523 [label="+20 Chemistry",color=orange];
		2523 -> 2530;
	2524 [label="Bien, ese es el tipo de conversación que hace que un Viajero quede completamente cubierto de besos.",shape=box,color=blue];
		2524 -> 2527;
	2525 [label="Lo sé. Creo que él también lo sabe, por eso está tan enojado. No puede competir.",shape=box,color=blue];
		2525 -> 2528;
	2526 [label="Dormiré más tranquila sabiendo que me cuidas.",shape=box,color=blue];
		2526 -> 2529;
	2530 [label="Está bien, mi amor. No voy a dejarte por una masa supurante de carne tuberculosa con trozos de tecnología huérfana flotando en ella.",shape=box,color=blue];
		2530 -> 2531;
	2527 [label="+20 Chemistry",color=orange];
		2527 -> 2532;
