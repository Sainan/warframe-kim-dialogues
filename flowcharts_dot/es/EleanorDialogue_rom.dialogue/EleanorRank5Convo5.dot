		2528 -> 2533;
	2529 [label="+20 Chemistry",color=orange];
		2529 -> 2534;
	2531 [label="Solo… si me ves con ojos especialmente oscuros y demacrados cualquier mañana en particular cuando nos despertamos juntos, por favor tráeme un buen café cargado y no me presiones para obtener detalles.",shape=box,color=blue];
		2531 -> 2535;
		2531 -> 2536;
	2532 [label="¿Te gustaría darle al Techrot algo de lo que estar REALMENTE celoso?",shape=box,color=blue];
		2532 -> 2538;
	2533 [label="Lo afrontaremos juntos, entonces. Lado a lado. Siempre.",shape=box,color=blue];
		2533 -> 2539;
	2534 [label="Somos familia. De sangre y elegida. Inquebrantable.",shape=box,color=blue];
