	2464 [label="Hola mi amor.",shape=box,color=blue];
		2464 -> 2467;
		2464 -> 2468;
	2465 [label="Hola, misterioso y extrañamente cautivador visitante de otro tiempo.",shape=box,color=blue];
		2465 -> 2467;
		2465 -> 2468;
	2467 [label="¿Dormiste mejor anoche?",shape=box,color=red];
