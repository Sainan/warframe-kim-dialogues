	2042 [label="Chat ends.",color=orange];
	2045 [label="Ey, Eleanor. ¿Recuerdas el juego de mesa que está preparando Amir? ¿Fables & Frontiers?",shape=box,color=red];
		2045 -> 2044;
	2046 [label="Ey, Eleanor. Tú y Amir son amigos, ¿verdad?",shape=box,color=red];
		2046 -> 2048;
	2047 [label="Te gustan los juegos de mesa, ¿verdad?",shape=box,color=red];
		2047 -> 2049;
	2044 [label="Sí. Ese que dijiste que iba a ser una pérdida de tiempo y que solo ibas a jugar por lástima hacia él, ese, ¿no?",shape=box,color=blue];
		2044 -> 2050;
		2044 -> 2052;
		2044 -> 2053;
	2048 [label="Es un diablillo encantador. ¿Por qué lo preguntas?",shape=box,color=blue];
		2048 -> 2055;
		2048 -> 2056;
	2049 [label="Tanto como a cualquier otra persona, supongo. ¿Por qué lo preguntas?",shape=box,color=blue];
		2049 -> 2055;
		2049 -> 2056;
	2050 [label="Vaya. Okay. Sigues enfadada. Tomo nota.",shape=box,color=red];
		2050 -> 2051;
	2052 [label="En ese momento pensé que eras \"demasiado genial para eso\" y solo estaba tratando de fingir que yo también lo era. Ahora sé que no es así.",shape=box,color=red];
		2052 -> 2054;
	2053 [label="Sí, yo... solo quería disculparme por eso. No quise decir eso. Solo tenía miedo de que dijeras que no.",shape=box,color=red];
		2053 -> 2062;
	2055 [label="Amir está intentando reunir al equipo para jugar una partida de Fables & Frontiers, y le dije que lo ayudaría.",shape=box,color=red];
		2055 -> 2057;
	2056 [label="Amir tiene muchas ganas de jugar Fables & Frontiers con todo el mundo. ¿Te apuntas?",shape=box,color=red];
		2056 -> 2057;
	2051 [label="Chat ends.",color=orange];
	2054 [label="¿Quién de nosotros ya no es \"demasiado genial\" para el juego, exactamente? ¿Tú o yo?",shape=box,color=blue];
		2054 -> 2058;
		2054 -> 2059;
		2054 -> 2060;
	2062 [label="Todos hemos estado en esa situación en algún momento de nuestras vidas... tratando de usar una máscara para impresionar a alguien y cayendo de bruces porque no podemos ver hacia dónde vamos. Y tú y yo apenas nos habíamos conocido cuando preguntaste. Está bien. Te perdono.",shape=box,color=blue];
		2062 -> 2067;
	2057 [label="Ah, ya veo. Eres el mensajero elegido, enviado por el Rey del Trueno para reclutar a la bella Eleanor. Sin duda me esperan todo tipo de travesuras. Historias fantásticas y demás.",shape=box,color=blue];
		2057 -> 2063;
		2057 -> 2064;
	2058 [label="Tú. Sigo pensando que es un juego tonto, pero como sea.",shape=box,color=red];
		2058 -> 2061;
	2059 [label="Yo. Definitivamente yo. Eres demasiado genial para el juego. Pero yo soy idiota, o eso dice Quincy.",shape=box,color=red];
		2059 -> 2062;
	2060 [label="...Ambos?",shape=box,color=red];
		2060 -> 2062;
	2067 [label="Sinceramente, poner una voz tonta y actuar durante unas horas suena ideal. Cuenten conmigo.",shape=box,color=blue];
		2067 -> 2068;
	2063 [label="Creo que será divertido, sinceramente. Y parece significar mucho para él.",shape=box,color=red];
		2063 -> 2067;
	2064 [label="Sí, creo que va a ser una total pérdida de tiempo, pero estoy tratando de ser amable.",shape=box,color=red];
		2064 -> 2065;
	2061 [label="Chat ends.",color=orange];
	2068 [label="¡Oh! Me gustaría ser un mago. O tal vez un bardo. ¿O tal vez ambos? ¿Puedes SER ambos?",shape=box,color=blue];
		2068 -> 2069;
	2065 [label="Te haré un favor y NO le transmitiré esas palabras. Un consejo: trátalo con más respeto en el futuro en mi presencia.",shape=box,color=blue];
		2065 -> 2066;
	2069 [label="¡O podría ser una bruja del pantano! Mientras pueda usar un corpiño ajustado, por supuesto. La madre Pechimusgo se comerá tus huesos, pequeño hombrecito.",shape=box,color=blue];
		2069 -> 2077;
	2066 [label="Chat ends.",color=orange];
