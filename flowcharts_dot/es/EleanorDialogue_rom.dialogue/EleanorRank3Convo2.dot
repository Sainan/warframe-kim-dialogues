digraph {
	924 [label="EleanorRank3Convo2 begins.",color=orange];
		924 -> 926;
	926 [label="Check boolean EleanorIndifference",color=orange];
		926 -> 925 [label=true,color=green];
		926 -> 927 [label=false,color=brown];
	925 [label="¿Estás ahí? Necesito hablar.",shape=box,color=blue];
		925 -> 928;
		925 -> 929;
	927 [label="¿Estás ahí? Necesito hablar contigo. Es algo serio.",shape=box,color=blue];
		927 -> 931;
		927 -> 929;
	928 [label="Aquí estoy.",shape=box,color=red];
		928 -> 932;
	929 [label="Lo siento mucho. Ahora no puedo. [Fin]",shape=box,color=red];
		929 -> 930;
	931 [label="Estoy aquí. Adelante.",shape=box,color=red];
		931 -> 933;
	932 [label="¿Recuerdas que te conté cómo intenté tocar la mente de Rusalka con la mía y, en cambio, hice contacto con la Indiferencia?",shape=box,color=blue];
		932 -> 935;
	930 [label="Chat ends.",color=orange];
	933 [label="Gracias.",shape=box,color=blue];
		933 -> 934;
	935 [label="Claro que lo recuerdo.",shape=box,color=red];
		935 -> 938;
	934 [label="¿Entiendes lo que le pasó a la Mayor Rusalka?",shape=box,color=blue];
		934 -> 936;
		934 -> 937;
	938 [label="Cierto. No estaba preparada para hablar de ello en aquel momento. Ahora sí, si tú quieres.",shape=box,color=blue];
		938 -> 945;
	936 [label="La estaban utilizando. La Indiferencia la estaba manipulando.",shape=box,color=red];
		936 -> 939;
	937 [label="Tengo la certeza de que la vaciaron y la manejaron como... bueno... como un ¿warframe...?",shape=box,color=red];
		937 -> 940;
	945 [label="Si estás segura.",shape=box,color=red];
		945 -> 946;
	939 [label="\"La Indiferencia\". ¿Así la llamas?",shape=box,color=blue];
		939 -> 941;
	940 [label="La vaciaron, sí.",shape=box,color=blue];
		940 -> 942;
	946 [label="Estoy segura.",shape=box,color=blue];
		946 -> 947;
	941 [label="Gracias.",shape=box,color=blue];
		941 -> 943;
	942 [label="Pero lo que la manejaba no era como tú.",shape=box,color=blue];
		942 -> 944;
	947 [label="Esta criatura, esta presencia, es a lo que nos enfrentamos en última instancia. Eso lo sé ahora.",shape=box,color=blue];
		947 -> 951;
	943 [label="Ponerle nombre me hace sentir como si hubiera recuperado un poco de control.",shape=box,color=blue];
		943 -> 948;
	944 [label="Cualquier cosa que tuviera de humano era como una parodia.",shape=box,color=blue];
		944 -> 949;
	951 [label="Por favor, dime la verdad. ¿Crees que hay alguna esperanza?",shape=box,color=blue];
		951 -> 956;
		951 -> 957;
		951 -> 958;
	948 [label="He tocado esa cosa con mi mente. Pensé que estaría sondeando la mente de Rusalka, pero… las capas externas simplemente se derrumbaron como placas de yeso y luego me sumergí en ella. Sin rumbo.",shape=box,color=blue];
		948 -> 950;
	949 [label="Era tan humano como un maniquí. En pedazos.",shape=box,color=blue];
		949 -> 952;
	956 [label="¿A estas alturas?... No.",shape=box,color=red];
		956 -> 960;
	957 [label="¿Sinceramente? No lo sé...",shape=box,color=red];
		957 -> 961;
	958 [label="Sí, lo creo.",shape=box,color=red];
		958 -> 962;
	950 [label="Update boolean EleanorIndifference",color=orange];
		950 -> 951;
	952 [label="La toqué, ¿sabes? Con mi mente. Traté de sondearla, pero no estaba allí.",shape=box,color=blue];
		952 -> 953;
	960 [label="Aprecio tu honestidad.",shape=box,color=blue];
		960 -> 963;
	961 [label="Lo entiendo.",shape=box,color=blue];
		961 -> 964;
	962 [label="No me digas por qué.",shape=box,color=blue];
		962 -> 965;
	953 [label="Sé lo que quieres decir. La llamamos la Indiferencia.",shape=box,color=red];
		953 -> 954;
	963 [label="Bien. Dejemos que la esperanza muera.",shape=box,color=blue];
		963 -> 966;
	964 [label="Hay tanto que no sabemos.",shape=box,color=blue];
		964 -> 967;
	965 [label="Simplemente aférrate a esa creencia. Déjame sentirla.",shape=box,color=blue];
		965 -> 968;
	954 [label="Gracias.",shape=box,color=blue];
		954 -> 955;
	966 [label="Seguiré luchando por pura maldita terquedad.",shape=box,color=blue];
		966 -> 969;
	967 [label="Después de lo que ha pasado este año, ¿cómo se supone que volveremos a hacer planes sensatos?",shape=box,color=blue];
		967 -> 970;
	968 [label="Por favor.",shape=box,color=blue];
		968 -> 971;
	955 [label="Ponerle nombre me hace sentir como si hubiera recuperado un poco de control.",shape=box,color=blue];
		955 -> 959;
	969 [label="Odio. Rabia. Cualquier cosa.",shape=box,color=blue];
		969 -> 973;
	970 [label="Quizás la esperanza sea solo una ilusión. No lo sé.",shape=box,color=blue];
		970 -> 974;
	971 [label="Extendí la mano hacia Rusalka y fue como si mis dedos tocaran su rostro y lo atravesaran. La máscara simplemente se derrumbó.",shape=box,color=blue];
		971 -> 975;
	959 [label="Update boolean EleanorIndifference",color=orange];
		959 -> 972;
	973 [label="Mejor que la apatía. Mejor que solo rendirse.",shape=box,color=blue];
		973 -> 978;
	974 [label="Realmente me vendría bien un poco ahora mismo.",shape=box,color=blue];
		974 -> 977;
	975 [label="Lo que había debajo era como…",shape=box,color=blue];
		975 -> 976;
	972 [label="He tocado esa cosa con mi mente. Pensé que estaría sondeando la mente de Rusalka, pero… las capas externas simplemente se derrumbaron como placas de yeso y luego me sumergí en ella. Sin rumbo.",shape=box,color=blue];
		972 -> 976;
	978 [label="Estoy lista.",shape=box,color=blue];
		978 -> 979;
	977 [label="Ah, en fin. Así es esto. Aunque sigamos avanzando en la oscuridad, al menos nos haremos compañía.",shape=box,color=blue];
		977 -> 980;
	976 [label="La palabra \"calentura\" se refiere a una especie de locura que solía afectar a los marineros. Estaban convencidos de que el mar verde que los rodeaba no era agua en absoluto, sino pasto.",shape=box,color=blue];
		976 -> 981;
	979 [label="Chat ends.",color=orange];
	980 [label="Chat ends.",color=orange];
	981 [label="Sentían la necesidad de saltar del barco hacia los hermosos prados verdes y correr por ellos. Si un compañero de barco intentaba detenerlos, luchaban.",shape=box,color=blue];
		981 -> 982;
	982 [label="Salté, esperando encontrar pasto. Al segundo siguiente, me encontré en medio de una oscuridad helada.",shape=box,color=blue];
		982 -> 983;
	983 [label="Update boolean EleanorIndifference2",color=orange];
		983 -> 984;
		983 -> 986;
	984 [label="No creo que sea seguro para ti hablar de esto así.",shape=box,color=red];
		984 -> 985;
	986 [label="Estoy aquí. Continúa.",shape=box,color=red];
		986 -> 987;
	985 [label="Vaya, mierda.",shape=box,color=blue];
		985 -> 988;
	987 [label="Hay una sensación para la que no hay palabras. Miras el mundo y SABES que todo lo cotidiano (edificios, autos, gente, trabajos, rutina) es solo una fina capa sobre un horror sin fondo, y si la gente se diera cuenta, empezaría a gritar y no pararía nunca.",shape=box,color=blue];
		987 -> 989;
	988 [label="Apenas había logrado mentalizarme para esto, y ahora, ¿qué? ¿No vamos a mencionar al Diablo en caso de que lo invoquemos?",shape=box,color=blue];
		988 -> 990;
	989 [label="Caí a través de esa capa.",shape=box,color=blue];
		989 -> 992;
	990 [label="Si oyes gritos en la noche, soy yo.",shape=box,color=blue];
		990 -> 991;
	992 [label="No era un vacío. Podría haber soportado eso. Se prolongaba eternamente, pero no era solo un espacio frío. Había algo allí conmigo.",shape=box,color=blue];
		992 -> 993;
		992 -> 994;
		992 -> 995;
	991 [label="Chat ends.",color=orange];
	993 [label="¿Un ojo?",shape=box,color=red];
		993 -> 997;
	994 [label="¿Un hombre atrapado en una pared?",shape=box,color=red];
		994 -> 997;
	995 [label="¿Qué era?",shape=box,color=red];
		995 -> 996;
	997 [label="No lo sé, pero eso sabía que yo estaba allí. Era CONSCIENTE de mi presencia, como un elefante sería consciente de una mosca que se arrastra frente a su ojo.",shape=box,color=blue];
		997 -> 998;
	996 [label="+5 Chemistry",color=orange];
		996 -> 997;
	998 [label="Recuerdo que pensé: \"Nada tan grande debería saber que existo\".",shape=box,color=blue];
		998 -> 999;
	999 [label="Sentí tal desprecio por mí, tal indiferencia monumental, que quería dejar de existir en ese momento.",shape=box,color=blue];
		999 -> 1000;
		999 -> 1001;
	1000 [label="Esa cosa... hace eso.",shape=box,color=red];
		1000 -> 1002;
	1001 [label="¿Qué hiciste?",shape=box,color=red];
		1001 -> 1002;
	1002 [label="Creo que podría habérmelas arreglado si me hubiera odiado. Entonces habría tenido algún valor, algún significado. Pero me veía como alguien sin importancia, y yo veía lo mismo que él. Yo era una partícula de polvo. Nada.",shape=box,color=blue];
		1002 -> 1003;
	1003 [label="Todo lo que alguna vez había sido, cada momento tierno, cada risa, cada pedacito de Eleanor Nightingale se esfumó en esa tormenta.",shape=box,color=blue];
		1003 -> 1004;
	1004 [label="Sintió que mi luz se apagaba y juro que un pequeño temblor de satisfacción lo recorrió. Como si estuviera contento de haberme aplastado. Una pulga bajo su dedo.",shape=box,color=blue];
		1004 -> 1005;
	1005 [label="Pero regresaste, ¿no? Todavía estás aquí. Demostraste que eso se equivocaba.",shape=box,color=red];
		1005 -> 1006;
	1006 [label="¿Lo hice?",shape=box,color=blue];
		1006 -> 1007;
	1007 [label="Todavía está ahí afuera, ¿no?",shape=box,color=blue];
		1007 -> 1008;
		1007 -> 1009;
	1008 [label="Sí, lo está. Pero tú también sigues aquí.",shape=box,color=red];
		1008 -> 1011;
	1009 [label="Las estrellas no dejan de brillar sólo porque el espacio es grande, frío y oscuro.",shape=box,color=red];
		1009 -> 1010;
	1011 [label="La Indiferencia triunfa al final, camarada, por más banalidades que arrojemos al abismo.",shape=box,color=blue];
		1011 -> 1012;
	1010 [label="Pero dejarán de brillar. Algún día. La muerte térmica del Universo.",shape=box,color=blue];
		1010 -> 1011;
	1012 [label="Ése es el problema de no volverse loco: tu maldición es la claridad de pensamiento.",shape=box,color=blue];
		1012 -> 1013;
	1013 [label="Sabes de qué hablo. Podrías haberte hecho añicos como un huevo de gorrión o haberte quemado el cerebro con drogas hasta no sentir nada más. Y te habría dolido menos que… saber esto.",shape=box,color=blue];
		1013 -> 1014;
	1014 [label="No entiendo por qué no te has alejado de esta conversación todavía.",shape=box,color=blue];
		1014 -> 1015;
		1014 -> 1016;
	1015 [label="Entiendo la entropía. Quizá la Gran Indiferencia sea lo mismo. Quizá gane al final. No lo sé. Lo que sí sé es que no voy a dejar que gane AHORA.",shape=box,color=red];
		1015 -> 1017;
	1016 [label="Estoy esperando que tomes una maldita decisión. ¿Quieres tomar el camino fácil y volverte loca? ¿O levantarte del sofá y pelear?",shape=box,color=red];
		1016 -> 1018;
	1017 [label="Sobreviviremos a esto juntos, si es que logramos sobrevivir.",shape=box,color=red];
		1017 -> 1020;
	1018 [label="LUCHAR CÓMO",shape=box,color=blue];
		1018 -> 1019;
	1020 [label="¿Así que estás soportando mis lamentos de desesperación existencial como táctica de batalla? Eso es muy Arthur de tu parte.",shape=box,color=blue];
		1020 -> 1021;
	1019 [label="¿ESO ES TODO LO QUE TÚ Y ARTHUR PUEDEN ENTENDER? ¿PELEAR?",shape=box,color=blue];
		1019 -> 1022;
	1021 [label="En realidad, aunque no lo creas, me importas.",shape=box,color=red];
		1021 -> 1027;
	1022 [label="TU RESPUESTA A LA FALTA DE SENTIDO SUBYACENTE DE LA EXISTENCIA ES \"¿ENCONTRAR UNA MANERA DE GOLPEARLA?\"",shape=box,color=blue];
		1022 -> 1023;
	1027 [label="Tú también me importas. Somos compañeros de escuadrón. Hemos pasado por muchas cosas.",shape=box,color=blue];
		1027 -> 1028;
	1023 [label="No puedo creer que pensé que teníamos algo en común.",shape=box,color=blue];
		1023 -> 1024;
	1028 [label="Es justo advertirte que el buen barco Eleanor puede hundirse, ya sea en el mar sangriento o en el pantano negro como la noche, y tú no querrás estar a bordo cuando eso ocurra.",shape=box,color=blue];
		1028 -> 1030;
	1024 [label="Qué tonto de mi parte.",shape=box,color=blue];
		1024 -> 1025;
	1030 [label="+20 Chemistry",color=orange];
		1030 -> 1029;
	1025 [label="Update boolean EleanorNoDate",color=orange];
		1025 -> 1026;
	1029 [label="Gracias. Deberías irte. Voy a estar bien. De verdad.",shape=box,color=blue];
		1029 -> 1031;
	1026 [label="Chat ends.",color=orange];
	1031 [label="Chat ends.",color=orange];
}