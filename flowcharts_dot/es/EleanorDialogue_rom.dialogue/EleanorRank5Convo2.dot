	2268 [label="Mi amor, se ha ido a la guerra, canta ay ay, oh no, está muerto, vagaré por los valles solitarios y nunca me casaré con otro",shape=box,color=blue];
		2268 -> 2279;
	2270 [label="Y si no me escuchas cuando hablo de esto, ¿qué más no estás escuchando? Por más encantador que haya sido todo esto entre nosotros, yo... no. Esto fue un error.",shape=box,color=blue];
		2270 -> 2272;
	2271 [label="Y si no me escuchas cuando hablo de esto, ¿qué más no estás escuchando?",shape=box,color=blue];
