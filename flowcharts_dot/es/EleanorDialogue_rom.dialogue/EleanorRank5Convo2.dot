digraph {
	2175 [label="EleanorRank5Convo2 begins.",color=orange];
		2175 -> 2176;
	2176 [label="Bueno. Estoy tan tranquila y tan lista como podré estarlo.",shape=box,color=blue];
		2176 -> 2177;
	2177 [label="¿Puedo hablarte de Christopher?",shape=box,color=blue];
		2177 -> 2178;
	2178 [label="Check boolean EleanorChristopher1",color=orange];
		2178 -> 2184 [label=true,color=green];
		2178 -> 2180 [label=true,color=green];
		2178 -> 2185 [label=true,color=green];
		2178 -> 2179 [label=false,color=brown];
		2178 -> 2185 [label=false,color=brown];
	2184 [label="Te escucho.",shape=box,color=red];
		2184 -> 2186;
	2180 [label="¿Por qué es alguien de quien necesito saber?",shape=box,color=red];
		2180 -> 2187;
	2185 [label="[Ignorar]",shape=box,color=red];
		2185 -> 2181;
	2179 [label="¿Quién es Christopher?",shape=box,color=red];
		2179 -> 2182;
	2186 [label="Gracias.",shape=box,color=blue];
		2186 -> 2188;
	2187 [label="Porque es alguien a quien perdí, alguien que era muy querido para mí.",shape=box,color=blue];
		2187 -> 2188;
	2181 [label="Chat ends.",color=orange];
	2182 [label="El mejor amigo de Arthur. Estábamos comprometidos. Pensé que estaba enamorada de él.",shape=box,color=blue];
		2182 -> 2183;
	2188 [label="Check boolean EleanorDating",color=orange];
		2188 -> 2189 [label=true,color=green];
		2188 -> 2190 [label=false,color=brown];
	2183 [label="Update boolean EleanorChristopher1",color=orange];
		2183 -> 2184;
		2183 -> 2180;
	2189 [label="Ya que tú y yo estamos mucho más cerca ahora (de tantas maneras encantadoras), deberías saber realmente con quién te estás involucrando.",shape=box,color=blue];
		2189 -> 2191;
	2190 [label="Por favor corrígeme si me equivoco, pero últimamente siento que tú y yo somos más que simples compañeros de equipo.",shape=box,color=blue];
		2190 -> 2193;
	2191 [label="He visto dentro de tu cabeza, pero tú no has visto dentro de la mía.",shape=box,color=blue];
		2191 -> 2192;
	2193 [label="Check boolean EleanorConfession",color=orange];
		2193 -> 2194 [label=true,color=green];
		2193 -> 2195 [label=false,color=brown];
	2192 [label="Así que, por favor, prepárate y ten paciencia conmigo.",shape=box,color=blue];
		2192 -> 2197;
	2194 [label="Me has dejado muy claro cómo te sientes, lo cual aprecio.",shape=box,color=blue];
		2194 -> 2196;
	2195 [label="Definitivamente somos amigos. Quizás más que eso. Pero aún nos sentimos inseguros el uno con el otro y esperamos que el otro dé el primer paso.",shape=box,color=blue];
		2195 -> 2196;
	2197 [label="Quiero contarte sobre Christopher porque creo que mereces saberlo.",shape=box,color=blue];
		2197 -> 2198;
		2197 -> 2199;
	2196 [label="Me gustas mucho. Confío en ti. Has tenido muchas oportunidades de tratarme como a un bicho raro, como hace Lettie, y no lo has hecho. No creas que no me he dado cuenta.",shape=box,color=blue];
		2196 -> 2197;
	2198 [label="Adelante.",shape=box,color=red];
		2198 -> 2202;
	2199 [label="No tengo tiempo para esto ahora, lo siento. [Fin]",shape=box,color=red];
		2199 -> 2200;
	2202 [label="Era unos años mayor que Arthur y yo. No recuerdo un momento en el que no estuviera presente. Nuestros padres eran amigos, así que siempre estaba de visita.",shape=box,color=blue];
		2202 -> 2203;
	2200 [label="Hay momentos para abandonar una conversación con un amigo. Este no era uno de ellos.",shape=box,color=blue];
		2200 -> 2201;
	2203 [label="Solía jugar a los soldados con Arthur en los bosques que había detrás de la finca. Christopher era el comandante y Arthur, el teniente leal. Si alguna vez me dejaban jugar, tenía que ser la enfermera. Obviamente.",shape=box,color=blue];
		2203 -> 2204;
	2201 [label="Chat ends.",color=orange];
	2204 [label="Ojalá papá hubiera visto a Arthur lanzándose sobre otra granada de pino, muriendo valientemente para salvar a su oficial al mando, y hubiera pensado: \"Hmmm, mi hijo se está encariñando demasiado con esta broma del ejército, tal vez debería decirle que recibir disparos no es tan divertido como él piensa\".",shape=box,color=blue];
		2204 -> 2205;
		2204 -> 2206;
		2204 -> 2207;
	2205 [label="¿Crees que Arthur habría escuchado si se lo hubiera dicho?",shape=box,color=red];
		2205 -> 2210;
	2206 [label="Pienso que todo salió bien, considerando todas las circunstancias.",shape=box,color=red];
		2206 -> 2209;
	2207 [label="Pero si Arthur hubiera escuchado, nunca nos habríamos conocido. :)",shape=box,color=red];
		2207 -> 2208;
	2210 [label="Probablemente no. Él lo habría visto como una prueba de papá.",shape=box,color=blue];
		2210 -> 2216;
	2209 [label="En algunos aspectos, sí.",shape=box,color=blue];
		2209 -> 2211;
	2208 [label="Que nuestros caminos se cruzaran fue una rara bendición en mi vida, sí.",shape=box,color=blue];
		2208 -> 2212;
	2216 [label="En fin, los veranos fueron pasando uno tras otro. Nos convertimos en adolescentes. Todo era muy extraño, maloliente y hormonal. Había fiestas y exámenes. Christopher se fue a la universidad. El perro murió y compramos uno nuevo. Inserta montaje aquí. ",shape=box,color=blue];
		2216 -> 2217;
	2211 [label="Pero estaba tratando de contarte acerca de un duelo.",shape=box,color=blue];
		2211 -> 2215;
	2212 [label="Pero permítame desear que no hubiera tenido ese costo.",shape=box,color=blue];
		2212 -> 2213;
	2217 [label="De repente, un día entré en la cocina, vi a este impresionante joven en uniforme frente a mí y pensé: \"Grroarr\" por segunda vez en mi vida.",shape=box,color=blue];
		2217 -> 2218;
		2217 -> 2219;
	2215 [label="Realmente no es el momento de buscar el lado positivo de las cosas.",shape=box,color=blue];
		2215 -> 2216;
	2213 [label="Especialmente cuando aún no te he contado cuán profundas son las heridas.",shape=box,color=blue];
		2213 -> 2214;
	2218 [label="Perdón, ¿qué fue ese sonido? No lo escuché. :P",shape=box,color=red];
		2218 -> 2220;
	2219 [label="¿Quién fue el primero?",shape=box,color=red];
		2219 -> 2222;
	2214 [label="Chat ends.",color=orange];
	2220 [label="¿\"Grroarr\"?",shape=box,color=blue];
		2220 -> 2221;
	2222 [label="Mandy Jellicoe. Mi crush. Abandonó la escuela, se tiñó el pelo, se hizo piercings, andaba por la ciudad con una chaqueta de cuero fumando cigarrillos y fulminando con la mirada a cualquiera que se acercara demasiado. La miré y sentí que se me derretían los huesos.",shape=box,color=blue];
		2222 -> 2223;
	2221 [label="Es una expresión tradicional británica de admiración. Debe expresarse como un gruñido bajo y con las mejillas infladas.",shape=box,color=blue];
		2221 -> 2223;
	2223 [label="En fin. NO ES RELEVANTE.",shape=box,color=blue];
		2223 -> 2224;
	2224 [label="Entonces, tú y Christopher…",shape=box,color=red];
		2224 -> 2225;
	2225 [label="Sip. Era amable. Guapo. Fuerte. También era fácil de entusiasmar, lo que era una gran ventaja. Pero estaba decidido a alistarse en el ejército. ",shape=box,color=blue];
		2225 -> 2226;
	2226 [label="No estábamos de acuerdo en eso. Para él era una vocación. Estaría ahí para ayudar a la gente que lo necesitaba, marcando una diferencia en el mundo. Había aceptado todo el papel del héroe varonil, igual que Arthur. ",shape=box,color=blue];
		2226 -> 2227;
	2227 [label="Check boolean EleanorHeroVirus",color=orange];
		2227 -> 2228 [label=true,color=green];
		2227 -> 2229 [label=true,color=green];
		2227 -> 2230 [label=true,color=green];
		2227 -> 2229 [label=false,color=brown];
		2227 -> 2230 [label=false,color=brown];
	2228 [label="Sé lo mucho que odias el concepto de héroes. ¿Es por esto?",shape=box,color=red];
		2228 -> 2231;
	2229 [label="Tenía razón. La gente dispuesta a luchar por un mundo mejor es lo único que marca la diferencia.",shape=box,color=red];
		2229 -> 2233;
	2230 [label="Es una idea atractiva. La gente quiere ayudar. Es fácil aprovecharse de eso.",shape=box,color=red];
		2230 -> 2236;
	2231 [label="Sí. Odio lo que le hizo a Christopher, lo que todavía le está haciendo a Arthur, lo que le hace a tantos otros como ellos.",shape=box,color=blue];
		2231 -> 2232;
	2233 [label="¡Puedes luchar por un mundo mejor sin creerte las tonterías del héroe!",shape=box,color=blue];
		2233 -> 2234;
	2236 [label="\"¿Por qué quieres ir a matar gente en nombre de un príncipe al que no le importas una mierda?\", le decía. Se sentía dolido, porque no se suponía que se tratara de servir a Su Majestad. Para él se trataba de acabar con los señores de la guerra que acaparaban comida y obligaban a sus prisioneros políticos a trabajar en las minas de rubedo hasta que morían de agotamiento.",shape=box,color=blue];
		2236 -> 2237;
	2232 [label="No tengo nada en contra de los valores. Los dioses saben que yo misma tengo algunos. Pero toda la narrativa del héroe es una estupidez perniciosa.",shape=box,color=blue];
		2232 -> 2237;
	2234 [label="El punto del Virus del Héroe es que es un virus. NO LE IMPORTA EL ANFITRIÓN. Te convence de que morir por una causa sería justo y noble, en lugar de ser un desperdicio trágico y sangriento.",shape=box,color=blue];
		2234 -> 2235;
	2237 [label="Estaba segura de que podría convencer a Christopher de que no hiciera el servicio militar. Si no convencerlo, al menos seducirlo para que no lo hiciera.",shape=box,color=blue];
		2237 -> 2238;
		2237 -> 2239;
		2237 -> 2240;
		2237 -> 2241;
	2235 [label="Chat ends.",color=orange];
	2238 [label="Eso es algo arrogante de tu parte.",shape=box,color=red];
		2238 -> 2242;
	2239 [label="Me estoy preparando para el \"pero\".",shape=box,color=red];
		2239 -> 2244;
	2240 [label="Suena a que él ya había tomado una decisión.",shape=box,color=red];
		2240 -> 2247;
	2241 [label="...Nota para mí: discutir con Eleanor...",shape=box,color=red];
		2241 -> 2248;
	2242 [label="Si, ¿y?",shape=box,color=blue];
		2242 -> 2243;
	2244 [label="¿Es necesario deletrearlo?",shape=box,color=blue];
		2244 -> 2245;
	2247 [label="+10 Chemistry",color=orange];
		2247 -> 2246;
	2248 [label="...no es realmente el momento.",shape=box,color=blue];
		2248 -> 2249;
	2243 [label="Estaba tratando de salvarle la vida. Estaba dispuesta a luchar tan sucio como fuera necesario.",shape=box,color=blue];
		2243 -> 2251;
	2245 [label="Quedé atrapada en la misma red que estaba intentando tejer.",shape=box,color=blue];
		2245 -> 2251;
	2246 [label="Bien. Para entonces, por supuesto, ya era demasiado tarde. Había empezado a hacerlo pensando que lo hechizaría, pero la verdad es que él me hechizó a mí.",shape=box,color=blue];
		2246 -> 2250;
	2249 [label="Esto no es fácil para mí, así que por favor elige el momento un poco mejor.",shape=box,color=blue];
		2249 -> 2251;
	2251 [label="Le dije que estaba embarazada y él ofreció casarse conmigo. Estúpido y hermoso idiota.",shape=box,color=blue];
		2251 -> 2252;
	2250 [label="Lo siento. No voy a poder contar esto sin llorar, así que si tardo en responder, al menos sabrás por qué.",shape=box,color=blue];
		2250 -> 2251;
	2252 [label="¿Lo estabas?",shape=box,color=red];
		2252 -> 2253;
	2253 [label="No, pero pensé que lo estaba. No intenté engañarlo, si es eso lo que me estás preguntando.",shape=box,color=blue];
		2253 -> 2254;
	2254 [label="Arthur estaba saltando sobre nubes esponjosas, estaba muy feliz. El chico que veía como un hermano iba a ser su cuñado.",shape=box,color=blue];
		2254 -> 2255;
	2255 [label="Luego todo avanza rápidamente. Algo sobre un ataque preventivo. Fronteras y contención, riesgo de escalación, mandato moral sangriento. Christopher está desplegado, Arthur ya se está inscribiendo, todos los chicos se van a la Guardia Carmesí y mi madre todavía está tratando de organizar los lugares para la boda.",shape=box,color=blue];
		2255 -> 2256;
		2255 -> 2257;
	2256 [label="¿Entonces qué pasó?",shape=box,color=red];
		2256 -> 2258;
	2257 [label="¿Te sientes bien como para continuar?",shape=box,color=red];
		2257 -> 2258;
	2258 [label="Lo mataron. La gente a la que supuestamente íbamos a ayudar. Hicieron estallar su vehículo con una bomba hecha con fertilizante y clavos.",shape=box,color=blue];
		2258 -> 2259;
	2259 [label="Me digo a mí misma: “Al menos fue rápido”. “Al menos no sufrió”. Pero por lo que sé, murió gritando con clavos en los ojos",shape=box,color=blue];
		2259 -> 2260;
	2260 [label="Mierda",shape=box,color=blue];
		2260 -> 2261;
	2261 [label="Mierda mierda",shape=box,color=blue];
		2261 -> 2262;
		2261 -> 2263;
	2262 [label="Al menos murió haciendo lo que creía correcto...",shape=box,color=red];
		2262 -> 2264;
	2263 [label="Lo siento muchísimo...",shape=box,color=red];
		2263 -> 2266;
	2264 [label="Siento que no has prestado atención a UNA SOLA COSA de lo que te he estado diciendo aquí",shape=box,color=blue];
		2264 -> 2265;
	2266 [label="Lloré, por supuesto, pero todo el tiempo estaba pensando: \"¿Qué esperabas, chica ESTÚPIDA? SABÍAS en lo que te estabas metiendo, SABÍAS que esto iba a pasar\".",shape=box,color=blue];
		2266 -> 2267;
	2265 [label="No me interesa el \"al menos...\". Murió de una manera ESTÚPIDA por una razón ESTÚPIDA",shape=box,color=blue];
		2265 -> 2269;
	2267 [label="Contártelo así lo hace parecer una canción folklórica cursi",shape=box,color=blue];
		2267 -> 2268;
