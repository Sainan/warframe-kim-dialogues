digraph {
	"EleanorRank6Convo4 begins." [color=orange];
		"EleanorRank6Convo4 begins." -> j1996732447;
	j1996732447 [label="¿Alguna vez te pasa que mientras te duchas sientes como si una vocecita extraña te hiciera una pregunta que nunca antes habías pensado hacerte?",shape=box,color=blue];
		j1996732447 -> j2666386769;
		j1996732447 -> j2507749262;
		j1996732447 -> j3557675185;
	j2666386769 [label="No, la verdad, no. [Fin]",shape=box,color=red];
		j2666386769 -> "Chat ends.";
	j2507749262 [label="Es como \"¿Qué pensó la gente en la Tierra cuando Lua apareció de repente otra vez en el cielo?\"",shape=box,color=red];
		j2507749262 -> j3970702570;
	j3557675185 [label="Te refieres a algo como \"¡Operador! ¿Considerarías tener tu kubrow disecado?\" ",shape=box,color=red];
		j3557675185 -> j2027637210;
	"Chat ends." [color=orange];
	j3970702570 [label="Correcto, exactamente.",shape=box,color=blue];
		j3970702570 -> j3275661153;
	j2027637210 [label="Eso es solo Ordis siendo Ordis, él hace eso.",shape=box,color=red];
		j2027637210 -> j942032954;
	j3275661153 [label="espera",shape=box,color=blue];
		j3275661153 -> j1171361340;
	j942032954 [label="Que los dioses lo bendigan. No, me refiero a una voz interior.",shape=box,color=blue];
		j942032954 -> j1253657385;
	j1171361340 [label="¿Lua desapareció?",shape=box,color=blue];
		j1171361340 -> j3352803757;
	j1253657385 [label="Un poco como si tu cerebro se mantuviera ocupado mientras te ocupas del importante asunto de la higiene personal.",shape=box,color=blue];
		j1253657385 -> j2317125300;
	j3352803757 [label="¿Por cuánto tiempo? ¿A dónde se fue? ¿Qué pasó con las mareas?",shape=box,color=blue];
		j3352803757 -> j3920709937;
		j3352803757 -> j1001592655;
	j2317125300 [label="Las escucho todo el tiempo. Son extrañamente aleatorias. Tanto que últimamente me he estado preguntando si realmente salieron de mi cabeza. ",shape=box,color=blue];
		j2317125300 -> j73098245;
	j3920709937 [label="En orden: no sé, el Vacío, no sé.",shape=box,color=red];
		j3920709937 -> j71163848;
	j1001592655 [label="Lotus la envió al Vacío hacia el final de la Antigua Guerra. El infante la trajo de vuelta hace poco.",shape=box,color=red];
		j1001592655 -> j3332895577;
	j73098245 [label="Algunas de ellas las he convertido en pinturas.",shape=box,color=blue];
		j73098245 -> j71163848;
	j71163848 [label="olvídalo, luego volvemos a eso.",shape=box,color=blue];
		j71163848 -> j3003998619;
	j3332895577 [label="No tengo idea sobre las mareas.",shape=box,color=red];
		j3332895577 -> j3963950418;
	j3003998619 [label="Bueno, pensamientos aleatorios en la ducha. Esta mañana uno me pegó como una bomba.",shape=box,color=blue];
		j3003998619 -> j2635415408;
	j3963950418 [label="¿Cómo logró Lotus desplazar una LUNA entera?",shape=box,color=blue];
		j3963950418 -> j71163848;
	j2635415408 [label="Decía: \"Oye, ¿qué pasaría si los dioses fueran reales?\"",shape=box,color=blue];
		j2635415408 -> j1876412244;
	j1876412244 [label="Me quedé un poco aturdida por un momento. Tuve que abrir el agua fría y ponérmela en la cara para reaccionar.",shape=box,color=blue];
		j1876412244 -> j3389798087;
		j1876412244 -> j1571050925;
		j1876412244 -> j1224819711;
	j3389798087 [label="¿Qué tiene de raro? Me parece una pregunta bastante básica.",shape=box,color=red];
		j3389798087 -> j3376266902;
	j1571050925 [label="… ¿acaso la gente no piensa que los dioses son reales? Seguro que Lettie sí.",shape=box,color=red];
		j1571050925 -> j2340634511;
	j1224819711 [label="Sí, es un pensamiento horrible.",shape=box,color=red];
		j1224819711 -> j3161997790;
	j3376266902 [label="Ah, por eso me encanta hablar contigo de estas cosas.",shape=box,color=blue];
		j3376266902 -> j241224771;
	j2340634511 [label="Vamos. Nadie cree que los dioses sean reales. No como, no sé, las mesas y las sillas.",shape=box,color=blue];
		j2340634511 -> j1574528501;
	j3161997790 [label="¿Verdad? ¿Y si cada vez que pensabas que el universo te envíaba una señal, realmente lo hacía?",shape=box,color=blue];
		j3161997790 -> j3398225465;
	j241224771 [label="Tu vida es tan fantásticamente absurda que la realidad de los dioses es una especulación tan natural para ti como los méritos relativos de los ingredientes de la pizza.",shape=box,color=blue];
		j241224771 -> j4291249117;
	j1574528501 [label="Los verdaderos dioses son como pozos de pueblo y baños al aire libre. Eran algo que la gente SOLÍA tener. ",shape=box,color=blue];
		j1574528501 -> j3386392645;
	j3398225465 [label="Imagina que todo estuviera en manos de estos insignificantes e inmortales bastardos que estaban a cargo solo porque así son las cosas, no porque se lo merecieran.",shape=box,color=blue];
		j3398225465 -> j2799382330;
	j4291249117 [label="Quizás hayas conocido a un dios. Si eso es lo que es la Indiferencia.",shape=box,color=blue];
		j4291249117 -> j1699139995;
	j3386392645 [label="Hoy en día son sólo símbolos, o metáforas, o alguna tontería por el estilo.",shape=box,color=blue];
		j3386392645 -> j439882984;
		j3386392645 -> j3346213370;
	j2799382330 [label="Y lo más loco es que de verdad así vivía la gente. Esa era su realidad, todos los días de sus vidas.",shape=box,color=blue];
		j2799382330 -> j1960782632;
	j1699139995 [label="Me acabas de recordar algo, allá en la Zariman. La primera vez que conocí a la Indiferencia.",shape=box,color=red];
		j1699139995 -> j3975953518;
	j439882984 [label="¿Tal vez la gente simplemente tiene menos miedo ahora?",shape=box,color=red];
		j439882984 -> j2962208597;
	j3346213370 [label="Pensé que Sol y Lua eran tus dioses.",shape=box,color=red];
		j3346213370 -> j470159428;
	j1960782632 [label="Para ellos, los dioses eran tan reales como el clima y les importaban casi lo mismo.",shape=box,color=blue];
		j1960782632 -> j2850471251;
	j3975953518 [label="Por supuesto, no sabía que era eso entonces. Pero recuerdo lo que decía. ",shape=box,color=red];
		j3975953518 -> j1258151242;
	j2962208597 [label="Creo que es eso, sí. ",shape=box,color=blue];
		j2962208597 -> j1560349544;
	j470159428 [label="Bueno, sí lo son. Pero también son solo cuerpos celestes. ",shape=box,color=blue];
		j470159428 -> j4184747455;
	j2850471251 [label="Honestamente, no suena tan diferente de la vida bajo el mandato de los orokin.",shape=box,color=red];
		j2850471251 -> j1881003252;
	j1258151242 [label="Le dije que podía llevarse mi luz, y me sonrió y dijo: \"Gracias, chiqui. Creo que lo haré\".",shape=box,color=red];
		j1258151242 -> j1228730788;
	j1560349544 [label="Creo que también sé por qué.",shape=box,color=blue];
		j1560349544 -> j3739875498;
	j4184747455 [label="Así como Britannia es un país, con nombre, identidad y demás, pero también es solo una masa de tierra y rocas. Puede ser ambas cosas a la vez.",shape=box,color=blue];
		j4184747455 -> j2461090380;
	j1881003252 [label="Inmortales, mezquinos, a cargo porque estaban a cargo...",shape=box,color=red];
		j1881003252 -> j2397168095;
	j1228730788 [label="Diablos, me estás dando escalofríos.",shape=box,color=blue];
		j1228730788 -> j837506694;
	j3739875498 [label="Es todo sobre la luz.",shape=box,color=blue];
		j3739875498 -> j2861509874;
	j2461090380 [label="Puedes salir en un lindo día soleado y sentirte agradecido, ver hacia el Sol y decir \"¡viva!\" Y lo dices en serio, eso es algo muy humano.",shape=box,color=blue];
		j2461090380 -> j1425207776;
	j2397168095 [label="Cierto. Tú TENÍAS dioses vivos. Pero los mataste.",shape=box,color=blue];
		j2397168095 -> j408783142;
	j837506694 [label="El diablo es muy estricto en lo que dice la ley, en todos los cuentos antiguos",shape=box,color=blue];
		j837506694 -> j3351197792;
	j2861509874 [label="¿Qué son Sol y Lua, después de todo? ¿Antes de que se les ocurriera considerarlos como dioses? Ellos eran las LUCES.",shape=box,color=blue];
		j2861509874 -> j2700076053;
		j2861509874 -> j154855646;
	j1425207776 [label="Pero hoy en día nadie piensa que Sol o Lua hayan embarazado a alguna mujer o que hayan sido protectores del hijo de algún tipo y que de ahí haya venido el rey.",shape=box,color=blue];
		j1425207776 -> j3959828901;
	j408783142 [label="(No me lo tomes a mal, amo eso de ti)",shape=box,color=blue];
		j408783142 -> j1957481537;
	j3351197792 [label="¿Crees que piense que le has prometido algo? ¿Tu \"luz\"?",shape=box,color=blue];
		j3351197792 -> j2845927167;
		j3351197792 -> j2917462832;
	j2700076053 [label="Cierto. La luz simboliza el bien, a donde sea que vayas.",shape=box,color=red];
		j2700076053 -> j433692466;
	j154855646 [label="Las únicas luces que tenía la humanidad, durante mucho, mucho tiempo.",shape=box,color=red];
		j154855646 -> j433692466;
	j3959828901 [label="La gente solía creer en esas cosas. Ahora sabemos que esas historias eran solo leyendas. Las hemos dejado atrás.",shape=box,color=blue];
		j3959828901 -> j2407654474;
		j3959828901 -> j3307799893;
	j1957481537 [label="Me estás confundiendo con el infante. Nunca participé en la gran insurrección del tenno.",shape=box,color=red];
		j1957481537 -> j3385060794;
	j2845927167 [label="Dice que hicimos un \"trato\". Así que supongo que piensa que le debo... algo.",shape=box,color=red];
		j2845927167 -> j2307242329;
	j2917462832 [label="Me refiero al globo de luz que llevaba conmigo, pero quién sabe a qué se refería.",shape=box,color=red];
		j2917462832 -> j2307242329;
	j433692466 [label="SÍ.",shape=box,color=blue];
		j433692466 -> j2207130034;
	j2407654474 [label="Los dioses y humanos... ¿se unieron?",shape=box,color=red];
		j2407654474 -> j3030305738;
	j3307799893 [label="¿Reyes con dioses por padres? Y creí que los orokin eran unos imbéciles.",shape=box,color=red];
		j3307799893 -> j3030305738;
	j3385060794 [label="Nunca fui parte del programa de Margulis de Infantes Muy Especiales, nunca tuve un warframe, nunca peleé en la Antigua Guerra.",shape=box,color=red];
		j3385060794 -> j1504824054;
	j2307242329 [label="Al menos sé una cosa sobre esa cosa. Le gustan los juegos.",shape=box,color=red];
		j2307242329 -> j856253472;
	j2207130034 [label="Pero entonces un pequeño nerd cavernícola, que probablemente era molestado por las chicas grandes cavernícolas, se le ocurrió el truco de golpear rocas entre sí y bingo.",shape=box,color=blue];
		j2207130034 -> j1952181591;
	j3030305738 [label="Oh, ese tipo de cosas pasaron MUCHO. Por todo el mundo.",shape=box,color=blue];
		j3030305738 -> j2939746517;
	j1504824054 [label="... ¿te hubiera gustado eso?",shape=box,color=blue];
		j1504824054 -> j4158281564;
		j1504824054 -> j571342738;
		j1504824054 -> j1138909083;
	j856253472 [label="+20 Chemistry",color=orange];
		j856253472 -> j1993475047;
	j1952181591 [label="¡Luz siempre disponible! ¡Independencia de las grandes luces del cielo!",shape=box,color=blue];
		j1952181591 -> j3986784514;
	j2939746517 [label="Imagina que eres un sacerdote arrogante que cruza los mares para difundir la palabra de Sol a los \"salvajes\" del nuevo mundo, sólo para encontrar que ellos no sólo ya saben sobre Sol, sino que tienen al hijo de Sol gobernándolos.",shape=box,color=blue];
		j2939746517 -> j3768759059;
	j4158281564 [label="La verdad no lo sé.",shape=box,color=red];
		j4158281564 -> j2753832429;
	j571342738 [label="Honestamente, no.",shape=box,color=red];
		j571342738 -> j769493916;
	j1138909083 [label="Sí, me hubiera gustado.",shape=box,color=red];
		j1138909083 -> j3886359435;
	j1993475047 [label="está bien. Lo que sea que hagas hoy, estés con quien estés, sea yo o Arthur o cualquiera de nosotros... cuídate.",shape=box,color=blue];
		j1993475047 -> j3435349021;
	j3986784514 [label="Y ahora, míranos. Luces por todos lados. La hicimos accesible.",shape=box,color=blue];
		j3986784514 -> j1699139995;
	j3768759059 [label="Huirías de regreso con la cola entre las patas, o te convertirías en ese mismo momento.",shape=box,color=blue];
		j3768759059 -> j1454793284;
		j3768759059 -> j1308775278;
	j2753832429 [label="Entiendo. Lo respeto.",shape=box,color=blue];
		j2753832429 -> j2991126293;
	j769493916 [label="Me alegro. Si sientes que tu vida pudo haber sido peor de lo que es, ¿supongo que tenemos algo que celebrar?",shape=box,color=blue];
		j769493916 -> j2991126293;
	j3886359435 [label="Creo que lo entiendo. Te perdiste de una gran oportunidad, ¿no es así?",shape=box,color=blue];
		j3886359435 -> j2991126293;
	j3435349021 [label="Check boolean EleanorDating",color=orange];
		j3435349021 -> j995652729 [label=true,color=green];
		j3435349021 -> j2859160817 [label=false,color=brown];
	j1454793284 [label="¿De verdad crees que los dioses son reales? ¿O sólo te asustó la idea de que podrían serlo?",shape=box,color=red];
		j1454793284 -> j4229016169;
	j1308775278 [label="Está bien. Entonces lo que estás diciendo es: ¿Y si la gente del pasado siempre estuvo en lo cierto?",shape=box,color=red];
		j1308775278 -> j4229016169;
	j2991126293 [label="Check boolean EleanorDating",color=orange];
		j2991126293 -> j2996383611 [label=true,color=green];
		j2991126293 -> j3197125136 [label=false,color=brown];
	j995652729 [label="Te amo. Cualquier dios que intente entrometerse será mejor que le rece a lo que sea que esté más arriba de los dioses.",shape=box,color=blue];
		j995652729 -> "Chat ends.";
	j2859160817 [label="Eres un amigo muy querido para mí. El dios que intente alejarte de mí encontrará su realidad puesta a prueba.",shape=box,color=blue];
		j2859160817 -> "Chat ends.";
	j4229016169 [label="Digamos que antes tenía mucha más confianza en la aburrida realidad material de las cosas.",shape=box,color=blue];
		j4229016169 -> j532879566;
	j2996383611 [label="+20 Chemistry",color=orange];
		j2996383611 -> j3675254622;
	j3197125136 [label="+20 Chemistry",color=orange];
		j3197125136 -> j1559419031;
	j532879566 [label="Hay un agujero en forma del viajero donde la confianza solía estar.",shape=box,color=blue];
		j532879566 -> j1309050645;
	j3675254622 [label="Ambos tenemos nuestras cicatrices, mi amor. ",shape=box,color=blue];
