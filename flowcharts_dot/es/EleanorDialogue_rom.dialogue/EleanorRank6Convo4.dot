		3039 -> 3045;
	3040 [label="Imagina que eres un sacerdote arrogante que cruza los mares para difundir la palabra de Sol a los \"salvajes\" del nuevo mundo, sólo para encontrar que ellos no sólo ya saben sobre Sol, sino que tienen al hijo de Sol gobernándolos.",shape=box,color=blue];
