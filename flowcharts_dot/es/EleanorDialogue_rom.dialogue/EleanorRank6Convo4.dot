	3032 [label="¿Reyes con dioses por padres? Y creí que los orokin eran unos imbéciles.",shape=box,color=red];
		3032 -> 3036;
	3033 [label="Nunca fui parte del programa de Margulis de Infantes Muy Especiales, nunca tuve un warframe, nunca peleé en la Antigua Guerra.",shape=box,color=red];
		3033 -> 3037;
	3034 [label="Al menos sé una cosa sobre esa cosa. Le gustan los juegos.",shape=box,color=red];
		3034 -> 3038;
	3035 [label="Pero entonces un pequeño nerd cavernícola, que probablemente era molestado por las chicas grandes cavernícolas, se le ocurrió el truco de golpear rocas entre sí y bingo.",shape=box,color=blue];
