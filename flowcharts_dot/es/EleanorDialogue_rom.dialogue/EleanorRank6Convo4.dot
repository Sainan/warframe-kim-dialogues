digraph {
	2968 [label="EleanorRank6Convo4 begins.",color=orange];
		2968 -> 2969;
	2969 [label="¿Alguna vez te pasa que mientras te duchas sientes como si una vocecita extraña te hiciera una pregunta que nunca antes habías pensado hacerte?",shape=box,color=blue];
