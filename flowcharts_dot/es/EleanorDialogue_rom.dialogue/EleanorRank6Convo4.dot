	2988 [label="¿Cómo logró Lotus desplazar una LUNA entera?",shape=box,color=blue];
		2988 -> 2985;
	2989 [label="Decía: \"Oye, ¿qué pasaría si los dioses fueran reales?\"",shape=box,color=blue];
		2989 -> 2990;
	2990 [label="Me quedé un poco aturdida por un momento. Tuve que abrir el agua fría y ponérmela en la cara para reaccionar.",shape=box,color=blue];
		2990 -> 2991;
		2990 -> 2992;
		2990 -> 2993;
	2991 [label="¿Qué tiene de raro? Me parece una pregunta bastante básica.",shape=box,color=red];
		2991 -> 2994;
	2992 [label="… ¿acaso la gente no piensa que los dioses son reales? Seguro que Lettie sí.",shape=box,color=red];
		2992 -> 2995;
	2993 [label="Sí, es un pensamiento horrible.",shape=box,color=red];
		2993 -> 2996;
	2994 [label="Ah, por eso me encanta hablar contigo de estas cosas.",shape=box,color=blue];
		2994 -> 2997;
	2995 [label="Vamos. Nadie cree que los dioses sean reales. No como, no sé, las mesas y las sillas.",shape=box,color=blue];
		2995 -> 2998;
	2996 [label="¿Verdad? ¿Y si cada vez que pensabas que el universo te envíaba una señal, realmente lo hacía?",shape=box,color=blue];
		2996 -> 2999;
	2997 [label="Tu vida es tan fantásticamente absurda que la realidad de los dioses es una especulación tan natural para ti como los méritos relativos de los ingredientes de la pizza.",shape=box,color=blue];
		2997 -> 3000;
	2998 [label="Los verdaderos dioses son como pozos de pueblo y baños al aire libre. Eran algo que la gente SOLÍA tener. ",shape=box,color=blue];
		2998 -> 3001;
	2999 [label="Imagina que todo estuviera en manos de estos insignificantes e inmortales bastardos que estaban a cargo solo porque así son las cosas, no porque se lo merecieran.",shape=box,color=blue];
		2999 -> 3002;
	3000 [label="Quizás hayas conocido a un dios. Si eso es lo que es la Indiferencia.",shape=box,color=blue];
		3000 -> 3003;
	3001 [label="Hoy en día son sólo símbolos, o metáforas, o alguna tontería por el estilo.",shape=box,color=blue];
		3001 -> 3004;
		3001 -> 3005;
	3002 [label="Y lo más loco es que de verdad así vivía la gente. Esa era su realidad, todos los días de sus vidas.",shape=box,color=blue];
		3002 -> 3006;
	3003 [label="Me acabas de recordar algo, allá en la Zariman. La primera vez que conocí a la Indiferencia.",shape=box,color=red];
		3003 -> 3007;
	3004 [label="¿Tal vez la gente simplemente tiene menos miedo ahora?",shape=box,color=red];
		3004 -> 3008;
	3005 [label="Pensé que Sol y Lua eran tus dioses.",shape=box,color=red];
		3005 -> 3009;
	3006 [label="Para ellos, los dioses eran tan reales como el clima y les importaban casi lo mismo.",shape=box,color=blue];
		3006 -> 3010;
	3007 [label="Por supuesto, no sabía que era eso entonces. Pero recuerdo lo que decía. ",shape=box,color=red];
		3007 -> 3011;
	3008 [label="Creo que es eso, sí. ",shape=box,color=blue];
		3008 -> 3012;
	3009 [label="Bueno, sí lo son. Pero también son solo cuerpos celestes. ",shape=box,color=blue];
		3009 -> 3013;
	3010 [label="Honestamente, no suena tan diferente de la vida bajo el mandato de los orokin.",shape=box,color=red];
		3010 -> 3014;
	3011 [label="Le dije que podía llevarse mi luz, y me sonrió y dijo: \"Gracias, chiqui. Creo que lo haré\".",shape=box,color=red];
		3011 -> 3015;
	3012 [label="Creo que también sé por qué.",shape=box,color=blue];
		3012 -> 3016;
	3013 [label="Así como Britannia es un país, con nombre, identidad y demás, pero también es solo una masa de tierra y rocas. Puede ser ambas cosas a la vez.",shape=box,color=blue];
		3013 -> 3017;
	3014 [label="Inmortales, mezquinos, a cargo porque estaban a cargo...",shape=box,color=red];
		3014 -> 3018;
	3015 [label="Diablos, me estás dando escalofríos.",shape=box,color=blue];
		3015 -> 3019;
	3016 [label="Es todo sobre la luz.",shape=box,color=blue];
		3016 -> 3020;
	3017 [label="Puedes salir en un lindo día soleado y sentirte agradecido, ver hacia el Sol y decir \"¡viva!\" Y lo dices en serio, eso es algo muy humano.",shape=box,color=blue];
		3017 -> 3021;
	3018 [label="Cierto. Tú TENÍAS dioses vivos. Pero los mataste.",shape=box,color=blue];
		3018 -> 3022;
	3019 [label="El diablo es muy estricto en lo que dice la ley, en todos los cuentos antiguos",shape=box,color=blue];
		3019 -> 3023;
	3020 [label="¿Qué son Sol y Lua, después de todo? ¿Antes de que se les ocurriera considerarlos como dioses? Ellos eran las LUCES.",shape=box,color=blue];
		3020 -> 3024;
		3020 -> 3025;
	3021 [label="Pero hoy en día nadie piensa que Sol o Lua hayan embarazado a alguna mujer o que hayan sido protectores del hijo de algún tipo y que de ahí haya venido el rey.",shape=box,color=blue];
		3021 -> 3026;
	3022 [label="(No me lo tomes a mal, amo eso de ti)",shape=box,color=blue];
		3022 -> 3027;
	3023 [label="¿Crees que piense que le has prometido algo? ¿Tu \"luz\"?",shape=box,color=blue];
		3023 -> 3028;
		3023 -> 3029;
	3024 [label="Cierto. La luz simboliza el bien, a donde sea que vayas.",shape=box,color=red];
		3024 -> 3030;
	3025 [label="Las únicas luces que tenía la humanidad, durante mucho, mucho tiempo.",shape=box,color=red];
		3025 -> 3030;
	3026 [label="La gente solía creer en esas cosas. Ahora sabemos que esas historias eran solo leyendas. Las hemos dejado atrás.",shape=box,color=blue];
		3026 -> 3031;
		3026 -> 3032;
	3027 [label="Me estás confundiendo con el infante. Nunca participé en la gran insurrección del tenno.",shape=box,color=red];
		3027 -> 3033;
	3028 [label="Dice que hicimos un \"trato\". Así que supongo que piensa que le debo... algo.",shape=box,color=red];
		3028 -> 3034;
	3029 [label="Me refiero al globo de luz que llevaba conmigo, pero quién sabe a qué se refería.",shape=box,color=red];
