		2976 -> 2978;
	2977 [label="Que los dioses lo bendigan. No, me refiero a una voz interior.",shape=box,color=blue];
		2977 -> 2979;
	2978 [label="¿Lua desapareció?",shape=box,color=blue];
		2978 -> 2980;
	2979 [label="Un poco como si tu cerebro se mantuviera ocupado mientras te ocupas del importante asunto de la higiene personal.",shape=box,color=blue];
		2979 -> 2981;
	2980 [label="¿Por cuánto tiempo? ¿A dónde se fue? ¿Qué pasó con las mareas?",shape=box,color=blue];
		2980 -> 2982;
		2980 -> 2983;
	2981 [label="Las escucho todo el tiempo. Son extrañamente aleatorias. Tanto que últimamente me he estado preguntando si realmente salieron de mi cabeza. ",shape=box,color=blue];
		2981 -> 2984;
	2982 [label="En orden: no sé, el Vacío, no sé.",shape=box,color=red];
		2982 -> 2985;
	2983 [label="Lotus la envió al Vacío hacia el final de la Antigua Guerra. El infante la trajo de vuelta hace poco.",shape=box,color=red];
		2983 -> 2986;
	2984 [label="Algunas de ellas las he convertido en pinturas.",shape=box,color=blue];
		2984 -> 2985;
	2985 [label="olvídalo, luego volvemos a eso.",shape=box,color=blue];
		2985 -> 2987;
	2986 [label="No tengo idea sobre las mareas.",shape=box,color=red];
		2986 -> 2988;
	2987 [label="Bueno, pensamientos aleatorios en la ducha. Esta mañana uno me pegó como una bomba.",shape=box,color=blue];
