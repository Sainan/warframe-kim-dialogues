		3215 -> 3216;
	3216 [label="¿Soy como un campo minado?",shape=box,color=blue];
		3216 -> 3217;
	3217 [label="Porque Kaya dice que lo soy. Y tuve uno de esos momentos de \"¡Oh, mierda!\" en los que recuerdas todas las conversaciones que tuviste con alguien y de repente te ves con otros ojos.",shape=box,color=blue];
		3217 -> 3218;
		3217 -> 3219;
		3217 -> 3220;
	3218 [label="No, no eres como un campo minado.",shape=box,color=red];
		3218 -> 3221;
	3219 [label="Creo que sé lo que quiere decir, y sí. Lo siento, pero tiene razón.",shape=box,color=red];
		3219 -> 3222;
	3220 [label="Espera, ¿Kaya dijo esto?",shape=box,color=red];
		3220 -> 3223;
	3221 [label="+5 Chemistry",color=orange];
		3221 -> 3224;
	3222 [label="oh.",shape=box,color=blue];
		3222 -> 3225;
		3222 -> 3226;
	3223 [label="Sí. Simplemente lo soltó en medio de una charla. \"Eres genial, pero eres como un campo minado. Nunca sé cómo vas a reaccionar\".",shape=box,color=blue];
		3223 -> 3218;
		3223 -> 3219;
	3224 [label="Es bueno saberlo. Gracias.",shape=box,color=blue];
		3224 -> 3227;
	3225 [label="Me alegra que Kaya te lo haya dicho. Dije cosas aquí que creí inofensivas y reaccionaste como si le hubiera prendido fuego a tu pelo.",shape=box,color=red];
		3225 -> 3228;
		3225 -> 3229;
	3226 [label="A veces tienes reacciones muy extremas. Son desproporcionadas a lo que te he dicho.",shape=box,color=red];
		3226 -> 3229;
		3226 -> 3228;
	3227 [label="Adolescentes, ¿eh? ",shape=box,color=blue];
		3227 -> 3230;
	3228 [label="Es como si saltaras directamente a la peor interpretación posible de lo que podría haber querido decir.",shape=box,color=red];
		3228 -> 3231;
	3229 [label="A veces simplemente abandonas la conversación por completo y ni siquiera tengo oportunidad de explicarme.",shape=box,color=red];
		3229 -> 3231;
	3230 [label="Chat ends.",color=orange];
	3231 [label="Bueno.",shape=box,color=blue];
		3231 -> 3232;
	3232 [label="Ahora mismo tengo ganas de cerrar la sesión y no volver a usar KIM nunca más.",shape=box,color=blue];
		3232 -> 3233;
		3232 -> 3234;
	3233 [label="¿Tal vez deberías pensar en lo que acabas de decir?",shape=box,color=red];
		3233 -> 3235;
	3234 [label="Ahí está. ¡Bum! Campo minado.",shape=box,color=red];
		3234 -> 3236;
		3234 -> 3235;
	3235 [label="¿No lo ves?",shape=box,color=red];
		3235 -> 3237;
	3236 [label="Creo que necesitas algo de tiempo para pensar en eso. [FIN]",shape=box,color=red];
		3236 -> 3238;
	3237 [label="Ok. Ok. Escúchame.",shape=box,color=blue];
		3237 -> 3239;
	3238 [label="Chat ends.",color=orange];
	3239 [label="Por favor.",shape=box,color=blue];
		3239 -> 3240;
	3240 [label="Ten en cuenta esto:",shape=box,color=blue];
		3240 -> 3241;
	3241 [label="Soy telépata. No pedí ser así. Pero lo soy. Puedo percibir los pensamientos.",shape=box,color=blue];
		3241 -> 3242;
	3242 [label="Si hablamos cara a cara, entonces tengo todo tipo de señales que me dicen lo que estás sintiendo.",shape=box,color=blue];
