	"EleanorRank6Convo8 begins." [color=orange];
		"EleanorRank6Convo8 begins." -> j658012250;
	j658012250 [label="¿Tienes un momento? Estoy un poco molesta por algo y me vendría bien que alguien me escuche. O que me regañe. Aún no estoy segura.",shape=box,color=blue];
		j658012250 -> j754387616;
	j754387616 [label="Check boolean EleanorDating",color=orange];
		j754387616 -> j3144306639 [label=true,color=green];
		j754387616 -> j2673053166 [label=true,color=green];
		j754387616 -> j1945472433 [label=true,color=green];
		j754387616 -> j2673053166 [label=false,color=brown];
		j754387616 -> j3144306639 [label=false,color=brown];
	j3144306639 [label="Ahora no, lo siento. [Fin]",shape=box,color=red];
		j3144306639 -> "Chat ends.";
	j2673053166 [label="Seguro.",shape=box,color=red];
		j2673053166 -> j1524637081;
	j1945472433 [label="Para ti, siempre.",shape=box,color=red];
		j1945472433 -> j1638425394;
	"Chat ends." [color=orange];
	j1524637081 [label="Gracias, camarada.",shape=box,color=blue];
		j1524637081 -> j682398688;
	j1638425394 [label="Gracias, amor.",shape=box,color=blue];
		j1638425394 -> j682398688;
	j682398688 [label="¿Soy como un campo minado?",shape=box,color=blue];
		j682398688 -> j3708678806;
	j3708678806 [label="Porque Kaya dice que lo soy. Y tuve uno de esos momentos de \"¡Oh, mierda!\" en los que recuerdas todas las conversaciones que tuviste con alguien y de repente te ves con otros ojos.",shape=box,color=blue];
		j3708678806 -> j1309963688;
		j3708678806 -> j454571232;
		j3708678806 -> j3662917921;
	j1309963688 [label="No, no eres como un campo minado.",shape=box,color=red];
		j1309963688 -> j4033672513;
	j454571232 [label="Creo que sé lo que quiere decir, y sí. Lo siento, pero tiene razón.",shape=box,color=red];
		j454571232 -> j2700699045;
	j3662917921 [label="Espera, ¿Kaya dijo esto?",shape=box,color=red];
		j3662917921 -> j469247135;
	j4033672513 [label="+5 Chemistry",color=orange];
		j4033672513 -> j4158720463;
	j2700699045 [label="oh.",shape=box,color=blue];
		j2700699045 -> j2494136455;
		j2700699045 -> j836284844;
	j469247135 [label="Sí. Simplemente lo soltó en medio de una charla. \"Eres genial, pero eres como un campo minado. Nunca sé cómo vas a reaccionar\".",shape=box,color=blue];
		j469247135 -> j1309963688;
		j469247135 -> j454571232;
	j4158720463 [label="Es bueno saberlo. Gracias.",shape=box,color=blue];
		j4158720463 -> j1724768044;
	j2494136455 [label="Me alegra que Kaya te lo haya dicho. Dije cosas aquí que creí inofensivas y reaccionaste como si le hubiera prendido fuego a tu pelo.",shape=box,color=red];
		j2494136455 -> j1177394036;
		j2494136455 -> j2830371688;
	j836284844 [label="A veces tienes reacciones muy extremas. Son desproporcionadas a lo que te he dicho.",shape=box,color=red];
		j836284844 -> j2830371688;
		j836284844 -> j1177394036;
	j1724768044 [label="Adolescentes, ¿eh? ",shape=box,color=blue];
		j1724768044 -> "Chat ends.";
	j1177394036 [label="Es como si saltaras directamente a la peor interpretación posible de lo que podría haber querido decir.",shape=box,color=red];
		j1177394036 -> j1695420316;
	j2830371688 [label="A veces simplemente abandonas la conversación por completo y ni siquiera tengo oportunidad de explicarme.",shape=box,color=red];
		j2830371688 -> j1695420316;
	j1695420316 [label="Bueno.",shape=box,color=blue];
		j1695420316 -> j2182667931;
	j2182667931 [label="Ahora mismo tengo ganas de cerrar la sesión y no volver a usar KIM nunca más.",shape=box,color=blue];
		j2182667931 -> j2662490646;
		j2182667931 -> j4115993448;
	j2662490646 [label="¿Tal vez deberías pensar en lo que acabas de decir?",shape=box,color=red];
		j2662490646 -> j3345801300;
	j4115993448 [label="Ahí está. ¡Bum! Campo minado.",shape=box,color=red];
		j4115993448 -> j4140632268;
		j4115993448 -> j3345801300;
	j3345801300 [label="¿No lo ves?",shape=box,color=red];
		j3345801300 -> j326670842;
	j4140632268 [label="Creo que necesitas algo de tiempo para pensar en eso. [FIN]",shape=box,color=red];
		j4140632268 -> "Chat ends.";
	j326670842 [label="Ok. Ok. Escúchame.",shape=box,color=blue];
		j326670842 -> j20669327;
	j20669327 [label="Por favor.",shape=box,color=blue];
		j20669327 -> j1795191517;
	j1795191517 [label="Ten en cuenta esto:",shape=box,color=blue];
		j1795191517 -> j3087974487;
	j3087974487 [label="Soy telépata. No pedí ser así. Pero lo soy. Puedo percibir los pensamientos.",shape=box,color=blue];
		j3087974487 -> j893544647;
	j893544647 [label="Si hablamos cara a cara, entonces tengo todo tipo de señales que me dicen lo que estás sintiendo.",shape=box,color=blue];
		j893544647 -> j778728837;
	j778728837 [label="expresiones, lenguaje corporal y, a veces, un PENSAMIENTO real porque, como dije, SOY TELÉPATA",shape=box,color=blue];
		j778728837 -> j2382015036;
	j2382015036 [label="pero aquí en el KIM tengo que adivinar y no tengo pistas",shape=box,color=blue];
		j2382015036 -> j2152751563;
	j2152751563 [label="y sí, a veces hago cosas por instinto.",shape=box,color=blue];
		j2152751563 -> j628389698;
		j2152751563 -> j3650019494;
	j628389698 [label="¿En serio?",shape=box,color=red];
		j628389698 -> j2905184990;
	j3650019494 [label="Sí, lo haces.",shape=box,color=red];
		j3650019494 -> j2905184990;
	j2905184990 [label="Bueno. Entonces.",shape=box,color=blue];
		j2905184990 -> j1543843287;
	j1543843287 [label="(respira hondo, siéntate derecha, tranquilízate, Eleanor)",shape=box,color=blue];
		j1543843287 -> j1358562783;
	j1358562783 [label="Haré todo lo posible para no convertirme en un campo minado en el futuro.",shape=box,color=blue];
		j1358562783 -> j814574359;
	j814574359 [label="Y echaré un vistazo a nuestras viejas conversaciones y lo meditaré por un tiempo.",shape=box,color=blue];
		j814574359 -> j1681563438;
	j1681563438 [label="Te lo debo. Porque, campo minado o no, sigues aquí. Seguiste caminando. x",shape=box,color=blue];
		j1681563438 -> j4122200191;
	j4122200191 [label="Boolean EleanorNoDate is now false.",color=orange];
		j4122200191 -> "Chat ends.";
}