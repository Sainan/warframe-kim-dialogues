digraph {
	2659 [label="EleanorRank5Convo8 begins.",color=orange];
		2659 -> 2660;
	2660 [label="He estado pensando. Hay algo que tengo que hacer.",shape=box,color=blue];
		2660 -> 2661;
	2661 [label="Voy a necesitar ayuda.",shape=box,color=blue];
		2661 -> 2662;
		2661 -> 2663;
	2662 [label="Siempre estoy aquí para ti. ¿Qué tienes en mente?",shape=box,color=red];
		2662 -> 2665;
	2663 [label="No puedo hablar ahora, lo siento. [Fin]",shape=box,color=red];
		2663 -> 2664;
	2665 [label="Check boolean EleanorChristopher2",color=orange];
		2665 -> 2667 [label=true,color=green];
		2665 -> 2666 [label=false,color=brown];
	2664 [label="Chat ends.",color=orange];
	2667 [label="Entonces. Christopher.",shape=box,color=blue];
		2667 -> 2675;
	2666 [label="Check boolean EleanorChristopher1",color=orange];
		2666 -> 2671 [label=true,color=green];
		2666 -> 2668 [label=false,color=brown];
	2675 [label="Me he estado aferrando a él durante años. Arthur también. Todos los años celebramos un ritual en su memoria. Pero este año no. No pude afrontarlo.",shape=box,color=blue];
		2675 -> 2676;
	2671 [label="Para resumir una historia muy larga y trágica... Christopher murió debido a una bomba al costado del camino antes de que nos casáramos.",shape=box,color=blue];
		2671 -> 2672;
	2668 [label="Ya es hora de que te cuente sobre Christopher.",shape=box,color=blue];
		2668 -> 2669;
	2676 [label="No sé si los fantasmas existen, pero es posible que existan, porque le he permitido convertirse en uno.",shape=box,color=blue];
		2676 -> 2677;
	2672 [label="Quizás te cuente toda la historia otro día. Quizás no.",shape=box,color=blue];
		2672 -> 2673;
	2669 [label="El mejor amigo de Arthur. Estábamos comprometidos. Pensé que estaba enamorada de él.",shape=box,color=blue];
		2669 -> 2670;
	2677 [label="No seas tan dura contigo misma. Estabas enamorada de él.",shape=box,color=red];
		2677 -> 2678;
	2673 [label="Te cuento todo esto ahora porque...",shape=box,color=blue];
		2673 -> 2674;
	2670 [label="Update boolean EleanorChristopher1",color=orange];
		2670 -> 2671;
	2678 [label="Oh, camarada. CREÍ que lo estaba. Lo amaba, pero ni siquiera sabía si estaba ENAMORADA de él o no.",shape=box,color=blue];
		2678 -> 2679;
	2674 [label="Update boolean EleanorChristopher2",color=orange];
		2674 -> 2675;
	2679 [label="Suena horrible, ¿no? Pero es verdad. En ese momento, no parecía importante. Luego murió y eso se convirtió en el tema central de nuestra historia.",shape=box,color=blue];
		2679 -> 2680;
	2680 [label="Todo lo que admiraba de él quedó eclipsado por su muerte. No puedo pensar en él sin que se me haga un nudo en el estómago.",shape=box,color=blue];
		2680 -> 2681;
	2681 [label="No es justo PARA ÉL. Se merece algo mejor que eso.",shape=box,color=blue];
		2681 -> 2682;
		2681 -> 2683;
	2682 [label="Lo entiendo. Totalmente. Tomé la decisión de recordar a mis padres como se merecían.",shape=box,color=red];
		2682 -> 2684;
	2683 [label="Lo que pasó fue terrible. No hay forma de evitarlo, pero no podemos permitir que eso sea lo único a lo que nos aferramos.",shape=box,color=red];
		2683 -> 2684;
	2684 [label="Entonces ¿por qué me siento tan culpable?",shape=box,color=blue];
		2684 -> 2685;
	2685 [label="¿Por qué siento que dejarlo ir es lo mismo que desecharlo?",shape=box,color=blue];
		2685 -> 2686;
		2685 -> 2688;
	2686 [label="Porque lo has llevado encima durante tanto tiempo que no sabes cómo parar.",shape=box,color=red];
		2686 -> 2687;
	2688 [label="Porque te preocupa que nadie más sea capaz de amarte.",shape=box,color=red];
		2688 -> 2689;
	2687 [label="Dioses, tienes toda la razón, sabes.",shape=box,color=blue];
		2687 -> 2692;
	2689 [label="Check boolean EleanorDating",color=orange];
		2689 -> 2690 [label=true,color=green];
		2689 -> 2691 [label=false,color=brown];
	2692 [label="Somos unos inútiles para lidiar con esto, mi gente. Nos lo guardamos todo. Ponemos cara de valientes y vamos a las trincheras. Eso nos ayuda a salir adelante, igual que ayudó a nuestros padres a salir adelante. Pero no sabemos cómo parar.",shape=box,color=blue];
		2692 -> 2693;
	2690 [label="¿Eso es todo? ¿Soy tan superficial?",shape=box,color=blue];
		2690 -> 2694;
	2691 [label="Dudo que incluso Christopher me amaría en mi condición actual.",shape=box,color=blue];
		2691 -> 2696;
	2693 [label="¿Qué debo hacer? ¿Cómo puedo dejarlo ir?",shape=box,color=blue];
		2693 -> 2698;
	2694 [label="No siento que merezca a NINGUNO de ustedes en este momento",shape=box,color=blue];
		2694 -> 2695;
	2696 [label="... no, eso no es justo. No estoy siendo justa con él en absoluto, ¿verdad?",shape=box,color=blue];
		2696 -> 2697;
	2698 [label="Check boolean LettieDiasdeMuertos",color=orange];
		2698 -> 2699 [label=true,color=green];
		2698 -> 2700 [label=true,color=green];
		2698 -> 2701 [label=true,color=green];
		2698 -> 2700 [label=false,color=brown];
		2698 -> 2701 [label=false,color=brown];
	2695 [label="Creo... que quiero que tengas TODO de mí. No puedo contener una parte de mí en un estado de duelo interminable.",shape=box,color=blue];
		2695 -> 2698;
	2697 [label="Él no querría interponerse en mi camino hacia la felicidad. Era amable.",shape=box,color=blue];
		2697 -> 2698;
	2699 [label="Creo que Lettie podría ayudar.",shape=box,color=red];
		2699 -> 2702;
	2700 [label="Podrías escribirle una carta.",shape=box,color=red];
		2700 -> 2703;
	2701 [label="Podrías hablar con Arthur. Él te ha acompañado en este duelo desde el principio.",shape=box,color=red];
		2701 -> 2704;
	2702 [label="¿Lettie?",shape=box,color=blue];
		2702 -> 2705;
	2703 [label="Una parte de mí piensa que es una idea estúpida. No la leerá. Está muerto. Pero...",shape=box,color=blue];
		2703 -> 2706;
	2704 [label="Sí, lo ha hecho. Tal vez eso sea parte del problema. Sé que está molesto porque no mantuve nuestra pequeña ceremonia de conmemoración este año.",shape=box,color=blue];
		2704 -> 2707;
	2705 [label="¿Por qué ella?",shape=box,color=blue];
		2705 -> 2708;
	2706 [label="... cuanto más lo pienso, menos estúpido me parece.",shape=box,color=blue];
		2706 -> 2710;
	2707 [label="Solo... tengo que despedirme de Christopher a MI manera esta vez. De una vez por todas.",shape=box,color=blue];
		2707 -> 2711;
	2708 [label="Tiene mucha experiencia, sabe todo sobre la conmemoración de los muertos.",shape=box,color=red];
		2708 -> 2709;
	2710 [label="Sí, lo haré. Hay cosas que necesito decirle. Cosas que nunca le dije cuando estaba vivo. Tal vez así pueda descansar.",shape=box,color=blue];
		2710 -> 2712;
	2711 [label="Para Arthur siempre será un hermano perdido, un soldado caído. Ése es el duelo que él conoce y entiende. Pero no es el mío.",shape=box,color=blue];
		2711 -> 2713;
	2709 [label="Pienso que si le pidieras un consejo, respetuosamente, no te rechazaría.",shape=box,color=red];
		2709 -> 2720;
	2712 [label="Gracias por escucharme y por el consejo.",shape=box,color=blue];
		2712 -> 2714;
	2713 [label="Ya no puedo hacerlo a la manera de Arthur. Creo que... si se lo digo, lo entenderá.",shape=box,color=blue];
		2713 -> 2718;
	2720 [label="…",shape=box,color=blue];
		2720 -> 2721;
	2714 [label="+20 Chemistry",color=orange];
		2714 -> 2715;
	2718 [label="+10 Chemistry",color=orange];
		2718 -> 2719;
	2721 [label="Sí.",shape=box,color=blue];
		2721 -> 2722;
	2715 [label="Nunca, nunca olvidaré esto.",shape=box,color=blue];
		2715 -> 2716;
	2719 [label="Gracias.",shape=box,color=blue];
		2719 -> 2717;
	2722 [label="Ya es hora.",shape=box,color=blue];
		2722 -> 2723;
	2716 [label="Chat ends.",color=orange];
	2717 [label="Chat ends.",color=orange];
	2723 [label="+20 Chemistry",color=orange];
		2723 -> 2724;
	2724 [label="Creo que necesito dejar ir MUCHAS cosas.",shape=box,color=blue];
		2724 -> 2725;
	2725 [label="Déjame hablar con ella. Si me dice que me vaya a la mierda, que así sea. Pero al menos lo habré intentado, ¿no?",shape=box,color=blue];
		2725 -> 2726;
	2726 [label="Vale la pena intentarlo. Lettie no es tan despiadada como la gente cree.",shape=box,color=red];
		2726 -> 2727;
	2727 [label="Estoy segura. Viviendo así, haciendo lo que hacemos todos los días, todos levantamos muros. Solo que nos olvidamos de ponerles puertas.",shape=box,color=blue];
		2727 -> 2728;
	2728 [label="Gracias por golpear tu hermosa cabeza contra mi pared.",shape=box,color=blue];
		2728 -> 2729;
	2729 [label="Chat ends.",color=orange];
}