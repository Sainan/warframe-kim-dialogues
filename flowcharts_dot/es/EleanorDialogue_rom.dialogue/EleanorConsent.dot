	3319 [label="Creo que lo único que me molesta un poco es que primero encontré pensamientos sobre esta persona en tu cabeza.",shape=box,color=blue];
		3319 -> 3320;
	3317 [label="Chat ends.",color=orange];
	3320 [label="Sabía que vendrías y pedirías permiso educadamente. Hola.",shape=box,color=blue];
		3320 -> 3321;
	3321 [label="Te respondo, muy malhumorada y con los brazos cruzados, con un \"sí, por supuesto\", mientras me siento aquí sin pensar en ti disfrutando de esa belleza que vislumbré en tus fantasías.",shape=box,color=blue];
		3321 -> 3322;
	3322 [label="Que ahora está en MIS fantasías, mientras estoy atrapada aquí, en este tiempo y lugar, ¡muchas gracias!",shape=box,color=blue];
		3322 -> 3323;
	3323 [label="Lo siento. Estaba a punto de preguntarte si estabas de acuerdo. Sé que no es algo que hayamos hablado antes. Quería asegurarme de que te parecía bien.",shape=box,color=red];
		3323 -> 3324;
	3324 [label="¡Claro que sí! Lo veo todo en tu mente. Y si confías en esa persona, yo también.",shape=box,color=blue];
		3324 -> 3325;
	3325 [label="Lástima que no pueda unirme a la diversión ni un ratito.",shape=box,color=blue];
		3325 -> 3326;
	3326 [label="+20 Chemistry",color=orange];
		3326 -> 3327;
	3327 [label="Pero tal vez pueda hacerlo indirectamente a través de ti. Piénsalo.",shape=box,color=blue];
		3327 -> 3328;
	3328 [label="Update boolean EleanorConsentComplete",color=orange];
		3328 -> 3329;
