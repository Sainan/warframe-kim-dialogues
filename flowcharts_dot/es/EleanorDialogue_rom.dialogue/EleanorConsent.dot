		j3528729371 -> "Chat ends." [label=false,color=brown];
	j1487527557 [label="Creo que lo único que me molesta un poco es que primero encontré pensamientos sobre esta persona en tu cabeza.",shape=box,color=blue];
		j1487527557 -> j311289147;
	j311289147 [label="Sabía que vendrías y pedirías permiso educadamente. Hola.",shape=box,color=blue];
		j311289147 -> j3796247821;
	j3796247821 [label="Te respondo, muy malhumorada y con los brazos cruzados, con un \"sí, por supuesto\", mientras me siento aquí sin pensar en ti disfrutando de esa belleza que vislumbré en tus fantasías.",shape=box,color=blue];
		j3796247821 -> j290799005;
	j290799005 [label="Que ahora está en MIS fantasías, mientras estoy atrapada aquí, en este tiempo y lugar, ¡muchas gracias!",shape=box,color=blue];
		j290799005 -> j3139958063;
	j3139958063 [label="Lo siento. Estaba a punto de preguntarte si estabas de acuerdo. Sé que no es algo que hayamos hablado antes. Quería asegurarme de que te parecía bien.",shape=box,color=red];
		j3139958063 -> j3489743458;
	j3489743458 [label="¡Claro que sí! Lo veo todo en tu mente. Y si confías en esa persona, yo también.",shape=box,color=blue];
		j3489743458 -> j1237501145;
	j1237501145 [label="Lástima que no pueda unirme a la diversión ni un ratito.",shape=box,color=blue];
		j1237501145 -> j253615274;
	j253615274 [label="+20 Chemistry",color=orange];
		j253615274 -> j27270483;
	j27270483 [label="Pero tal vez pueda hacerlo indirectamente a través de ti. Piénsalo.",shape=box,color=blue];
		j27270483 -> j298331240;
	j298331240 [label="Boolean EleanorConsentComplete is now true.",color=orange];
		j298331240 -> "Chat ends.";
