		j1947317088 -> j88799559;
	j809955678 [label="A veces sólo se necesita tiempo\nPero voy a intentar ayudarle si es que puedo\nLua sabe que siente mucha curiosidad por la ciencia médica jajaja\nElla siempre hace preguntas espeluznantes",shape=box,color=blue];
		j809955678 -> j2883479240;
	j88799559 [label="Me gusta tenerla cerca\nCreo que lo sabe\nLe gusta ayudarme en las cirugías, pero...\nElla siempre hace preguntas espeluznantes",shape=box,color=blue];
