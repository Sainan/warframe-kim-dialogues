		j418859562 -> j978885782;
	j978885782 [label="No sé cómo\nNo sé si es posible\nPero rompiste las reglas del tiempo y el espacio",shape=box,color=blue];
		j978885782 -> j2196864396;
	j2196864396 [label="Quiero encontrarlo\nY quiero traerlo aquí\nY quiero sentarlo enfrente de todos nosotros",shape=box,color=blue];
