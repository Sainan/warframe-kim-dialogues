	j3994702672 [label="¿Es algo en lo que puedas ayudarle?",shape=box,color=red];
		j3994702672 -> j809955678;
	j3791782346 [label="JAJAJA recuérdame nunca ponerte como contacto de emergencia\nSííí, ella va para despejarse pero siempre regresa aquí\nPor la arqui-quecosa temporal\nPero creo que también por... nosotros",shape=box,color=blue];
