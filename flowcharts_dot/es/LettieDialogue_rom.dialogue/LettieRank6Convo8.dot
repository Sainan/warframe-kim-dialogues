		j1406584365 -> j3994702672;
	j1614882605 [label="¿No?",shape=box,color=red];
		j1614882605 -> j3791782346;
	j3629644953 [label="Bueno, ella es la única que puede ayudar con lo de Arquimedea Temporal.",shape=box,color=red];
		j3629644953 -> j1947317088;
	j3256216627 [label="Me pone triste que no pude ayudarla con eso.",shape=box,color=red];
