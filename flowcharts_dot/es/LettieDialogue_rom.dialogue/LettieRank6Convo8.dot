		j580547789 -> j1406584365 [label=false,color=brown];
	j1403152846 [label="No la culpo por querer huir\nSi hubiera podido, lo hubiera hecho\nPero\n¿Te das cuenta de que no se va para siempre?",shape=box,color=blue];
