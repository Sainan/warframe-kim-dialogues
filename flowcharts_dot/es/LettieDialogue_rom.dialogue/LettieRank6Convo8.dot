	j3487343150 [label="No podemos lastimar a un adolescente cualquiera.",shape=box,color=red];
		j3487343150 -> j2333007084;
	j447336469 [label="Quiero que él sienta lo que es estar asustado y que todo el mundo esté en tu contra\nY que todos estén riéndose de él\nBurlándose de él",shape=box,color=blue];
		j447336469 -> j873738372;
	j2333007084 [label="¿Quién dijo que ese era el plan?\nConozco a los de su tipo\nCobardes, todos ellos, parloteando a lo alto desde donde creen que están a salvo",shape=box,color=blue];
		j2333007084 -> j447336469;
	j873738372 [label="¿Sabes cómo es crecer luciendo como yo?\n¿Sonando como yo?\n¿Vistiéndote como yo?\n¿En bases militares rodeada de niños nada parecidos a mí?",shape=box,color=blue];
		j873738372 -> j3124522358;
	j3124522358 [label="Varias veces llegué a mi casa toda madreada por haberme defendido\nMi mamá siempre me decía que debía ser más agachona\n¿Quedarme callada?\nComo si yo fuera hacer eso",shape=box,color=blue];
		j3124522358 -> j580547789;
