		j1157546170 -> j2081631406;
	j3541585113 [label="Sólo las arañas\nVolviendo a sentirse como en casa\nPero ya se irán pronto",shape=box,color=blue];
		j3541585113 -> j3213049075;
	j2081631406 [label="No, nada nuevo\nSólo las arañas\nVolviendo a sentirse como en casa\nPero ya se irán pronto",shape=box,color=blue];
		j2081631406 -> j3213049075;
	j3213049075 [label="A veces quisiera\nQue fuera tan fácil como un problema\nAsí podría arreglarlo, ¿sí?\nHablarlo, golpearlo jajaja",shape=box,color=blue];
		j3213049075 -> j1380452798;
	j1380452798 [label="Los problemas se pueden resolver\nLos problemas tienen respuestas\nLos sentimientos no se arreglan\nCréeme, lo he intentado",shape=box,color=blue];
		j1380452798 -> j907785092;
		j1380452798 -> j746690281;
	j907785092 [label="Pero tienes muchas razones para ser feliz.",shape=box,color=red];
		j907785092 -> j3009422554;
	j746690281 [label="Aprendí a las malas en Duviri que \"arreglar los sentimientos\" a veces es la peor opción.",shape=box,color=red];
		j746690281 -> j3319021223;
	j3009422554 [label="Ay sí, las tengo\nY sé que las tengo\nY a veces quisiera\nQue la gente entendiera esa parte de mí\nQue no es fácil de asimilar",shape=box,color=blue];
		j3009422554 -> j3123317678;
	j3319021223 [label="Síí...\nAunque a veces es tentador jajaja\nSólo quisiera que todo se disipara\nPero me has dicho qué es lo que pasa \nCuando todo se vuelve gris",shape=box,color=blue];
		j3319021223 -> j2924817959;
	j3123317678 [label="Desearía poder ser diferente\nPero soy quien soy\nY ya dejé de disculparme por eso\nHace mucho tiempo",shape=box,color=blue];
		j3123317678 -> "Chat ends.";
	j2924817959 [label="No le desearía eso a nadie\nBueno, tal vez a Albrecht\nPinche güey\nAunque su corazón ya es demasiado frío así como es",shape=box,color=blue];
		j2924817959 -> j1343056994;
		j2924817959 -> j1685907853;
	j1343056994 [label="¿Qué podemos hacer para distraerte? ¿O prefieres seguir así?",shape=box,color=red];
		j1343056994 -> j433463703;
	j1685907853 [label="Solo podemos esperar a que esté jugando a largo plazo.",shape=box,color=red];
		j1685907853 -> j837052328;
	j433463703 [label="Ahhh, buena pregunta\nLa verdad no lo sé\nQuedarme así suena bien \nO podríamos salir y matar cosas\n¿Te quedas o vamos a matar cosas? \nDecisiones, decisiones...",shape=box,color=blue];
		j433463703 -> j4061354044;
		j433463703 -> j3275225931;
	j837052328 [label="Lo único que le deseo, donde quiera que esté ese cabrón\nEs un largo viaje en el elevador\nConmigo\nY un bate de béisbol",shape=box,color=blue];
		j837052328 -> j1306323686;
	j4061354044 [label="Voto por quedarme.",shape=box,color=red];
		j4061354044 -> j1419984095;
	j3275225931 [label="Voto por ir a matar cosas.",shape=box,color=red];
		j3275225931 -> j129080326;
