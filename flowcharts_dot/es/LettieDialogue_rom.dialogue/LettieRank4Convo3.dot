	"LettieRank4Convo3 begins." [color=orange];
		"LettieRank4Convo3 begins." -> j2259268121;
		"LettieRank4Convo3 begins." -> j544902275;
	j2259268121 [label="Para alguien que se dedica a prevenir la muerte, te ves muy relajada.",shape=box,color=red];
		j2259268121 -> j1029382785;
	j544902275 [label="Me encantaría saber más sobre cómo te convertiste en doctora.",shape=box,color=red];
		j544902275 -> j3416912238;
	j1029382785 [label="Mm, sí, supongo que lo estoy\nHay dos razones para ello\nUno, veo a La Flaca todo el tiempo en mi línea de trabajo\nElla y yo somos viejas \"amigas\"\nDos, mi gente percibe diferente a la muerte, eso creo",shape=box,color=blue];
		j1029382785 -> j1823993829;
		j1029382785 -> j292399319;
		j1029382785 -> j4252667707;
	j3416912238 [label="Jaja eso es fácil, babas \nMe enlisté y era muy mala en ello\nPero luego mejoré",shape=box,color=blue];
		j3416912238 -> j1185472402;
		j3416912238 -> j3430870997;
	j1823993829 [label="¿Qué quieres decir con que tu gente percibe diferente a la muerte?",shape=box,color=red];
		j1823993829 -> j2781594579;
	j292399319 [label="¿Por qué terminaste convirtiéndote en doctora?",shape=box,color=red];
		j292399319 -> j4114697540;
	j4252667707 [label="Tiene sentido. [Fin]",shape=box,color=red];
		j4252667707 -> "Chat ends.";
	j1185472402 [label="Bueno, ¿*por qué* terminaste convirtiéndote en doctora?",shape=box,color=red];
		j1185472402 -> j4114697540;
	j3430870997 [label="Gracias, buena charla. [Fin]",shape=box,color=red];
		j3430870997 -> "Chat ends.";
	j2781594579 [label="Celebramos que nuestros seres queridos regresan a visitarnos\nLos invitamos para que estén con nosotros una vez al año\nHacemos nuestro pan de muerto, calaveritas de azúcar, y ponemos cempasúchil para invitarlos a la casa",shape=box,color=blue];
		j2781594579 -> j1397198796;
		j2781594579 -> j1779056832;
	j4114697540 [label="Mi papá estaba en el ejército\nViajábamos mucho, de base en base\nPero cuando mi tía se enfermó nos tuvimos que mudar con ella\nY aprendí a cuidarla hasta que falleció",shape=box,color=blue];
		j4114697540 -> j2985861959;
	"Chat ends." [color=orange];
	j1397198796 [label="Los muertos con los que tengo experiencia son un poco más... intensos, sí.",shape=box,color=red];
		j1397198796 -> j1511450625;
	j1779056832 [label="Eso es hermoso.",shape=box,color=red];
		j1779056832 -> j1986671764;
	j2985861959 [label="Boolean LettieAunt is now true.",color=orange];
		j2985861959 -> j3811398363;
		j2985861959 -> j3221887568;
	j1511450625 [label="Nos sentamos junto a sus tumbas y les decimos historias\nComemos con ellos lo que les trajimos\nLes hablamos y reímos con ellos\nNo murmuramos o lloramos cuando ellos vienen en la noche",shape=box,color=blue];
		j1511450625 -> j2074838548;
	j1986671764 [label="+5 Chemistry",color=orange];
		j1986671764 -> j1825300840;
	j3811398363 [label="Oh... lo siento.",shape=box,color=red];
		j3811398363 -> j1986995372;
	j3221887568 [label="¿Que edad tenias?",shape=box,color=red];
		j3221887568 -> j3514357156;
	j2074838548 [label="Conocí a La Flaca cuando era pequeña\nMi papá estaba en el ejército\nViajábamos mucho, de base en base\nPero cuando mi tía se enfermó nos tuvimos que mudar con ella\nY aprendí a cuidarla hasta que falleció",shape=box,color=blue];
		j2074838548 -> j4173716244;
	j1825300840 [label="Gracias",shape=box,color=blue];
		j1825300840 -> j1511450625;
	j1986995372 [label="Eh, está bien \nSon cosas que pasan, ¿no? \nSus problemas del corazón hicieron que se enfermará más y más\nFue una buena práctica para el futuro, ser una ayuda para mi mamá",shape=box,color=blue];
		j1986995372 -> j334577020;
		j1986995372 -> j422762784;
		j1986995372 -> j782940388;
	j3514357156 [label="¿10?, ¿11? \nMi mamá necesitaba ayuda\nNo me molesto\nFue una buena práctica para el futuro, ser una ayuda para mi mamá",shape=box,color=blue];
		j3514357156 -> j334577020;
		j3514357156 -> j422762784;
		j3514357156 -> j782940388;
	j4173716244 [label="Boolean LettieAunt is now true.",color=orange];
		j4173716244 -> j1775594460;
	j334577020 [label="¿Extrañas a tu tía?",shape=box,color=red];
		j334577020 -> j3644157704;
	j422762784 [label="Sé lo que es perder a tu familia a una edad temprana.",shape=box,color=red];
		j422762784 -> j414493688;
	j782940388 [label="¿Qué edad tenías cuando te uniste al ejército?",shape=box,color=red];
		j782940388 -> j3995215645;
	j1775594460 [label="Mi tía viene a verme todos los años, me da una palmadita en el hombro y dice \"buen trabajo, amorcito, sigue así\"\nY me hace sonreír, no me hace gritar o correr del miedo",shape=box,color=blue];
		j1775594460 -> j1943865825;
	j3644157704 [label="+5 Chemistry",color=orange];
		j3644157704 -> j3565279371;
	j414493688 [label="+5 Chemistry",color=orange];
		j414493688 -> j161536163;
	j3995215645 [label="+10 Chemistry",color=orange];
		j3995215645 -> j3350585984;
	j1943865825 [label="Boolean LettieDiasdeMuertos is now true.",color=orange];
		j1943865825 -> j2721324681;
	j3565279371 [label="No\nLa veo cada año en el festival de la muerte\n¡Mierda! Y antes de que preguntes, ya sé cómo suena\nNo es que los desenterremos para celebrar sus almas jajaja\nBueno, hay gente que lo hace, pero depende más del lugar de donde eres",shape=box,color=blue];
		j3565279371 -> j1420239756;
		j3565279371 -> j2533398639;
	j161536163 [label="Sí, pero no los extraño\nSe fueron de mi día a día pero no se fueron de mi lado, me visitan cada año en el festival de la muerte\nNo es que los desenterremos para celebrar sus almas jajaja\nBueno, hay gente que lo hace, pero depende más del lugar de donde eres",shape=box,color=blue];
		j161536163 -> j1420239756;
		j161536163 -> j2533398639;
	j3350585984 [label="Mi papá me hizo esperar hasta que tuviera 20 para unirme\nPero yo ya quería hacerlo jajaja\nMe moría de ganas, quería que él y mi tía estuvieran orgullosos de mí\nMe alegra que me haya hecho esperar, no estaba lista",shape=box,color=blue];
		j3350585984 -> j366472824;
	j2721324681 [label="Espero pueda llegar hasta acá...\nLe tengo que hacer sus flores de cempasúchil con papel\nTal vez Arthur me ayude a hacer un poco de pan de muerto, soy muy mala horneando jajaja",shape=box,color=blue];
		j2721324681 -> j2264313037;
		j2721324681 -> j2021859161;
	j1420239756 [label="Uff. Es lo que iba a decir. lol",shape=box,color=red];
		j1420239756 -> j2319896126;
	j2533398639 [label="¡LOL! Perece ser que es una celebración increíble.",shape=box,color=red];
		j2533398639 -> j2319896126;
	j366472824 [label="Ver a tu tía morir lentamente por insuficiencia cardíaca es una cosa\nVer a la gente matarse violentamente entre sí\nGritos de muerte, muertes sangrientas\nEs algo muy diferente",shape=box,color=blue];
		j366472824 -> j2639446749;
	j2264313037 [label="Creo que le va a encantar ayudarte.",shape=box,color=red];
		j2264313037 -> j3018346605;
	j2021859161 [label="Me encantaría ayudar también.",shape=box,color=red];
		j2021859161 -> j1563032416;
	j2319896126 [label="Ponemos nuestras ofrendas para nuestros seres queridos y hacemos pan de muerto, calaveritas de azúcar, y colocamos cempasúchil para invitarlos a la casa\nComemos con ellos lo que les trajimos\nNos sentamos junto a sus tumbas y les contamos historias\nLes hablamos y reímos con ellos",shape=box,color=blue];
		j2319896126 -> j1775594460;
	j2639446749 [label="Pero tú sabes de eso, ¿no es así?\nTú conoces a La Flaca tan bien como yo\nY hablando de\nElla no espera a nadie y mucho menos por nuestras conversaciones",shape=box,color=blue];
		j2639446749 -> "Chat ends.";
	j3018346605 [label="Check boolean LettieDuviri",color=orange];
