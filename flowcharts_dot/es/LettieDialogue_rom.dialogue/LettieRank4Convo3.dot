		j3018346605 -> j3462865447 [label=false,color=brown];
	j1563032416 [label="+5 Chemistry",color=orange];
		j1563032416 -> j2660943494;
	j3415765588 [label="Si quieres, podríamos poner una ofrenda para tu familia\nTal vez quieran venir a ver a su babas después de tanto tiempo\nEstoy segura de que están orgullosos de ti",shape=box,color=blue];
		j3415765588 -> j239694454;
		j3415765588 -> j1812524455;
		j3415765588 -> j4254978862;
	j3462865447 [label="¿Tienes seres queridos que quisieras que te visitaran?\nPodríamos juntos ponerles una ofrenda\nTal vez quieran venir a ver a su babas después de tanto tiempo, estoy segura de que están orgullosos de ti",shape=box,color=blue];
		j3462865447 -> j239694454;
		j3462865447 -> j1812524455;
		j3462865447 -> j4254978862;
