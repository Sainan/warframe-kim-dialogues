	j3420297688 [label="Ay, sí \nEntiendo",shape=box,color=blue];
		j3420297688 -> "Chat ends.";
	j146259090 [label="Sí, me imagino como es que se sintió\nTener que lastimar a tu propia familia de esa forma\nPero no tenías opción, solecito\nEran animales rabiosos y no tenían control alguno",shape=box,color=blue];
		j146259090 -> j1415283365;
	j3588381713 [label="No tenías opción, solecito \nEran animales rabiosos y no tenían control alguno\nY *yo* entiendo ese tipo de decisión",shape=box,color=blue];
		j3588381713 -> j1243452733;
	j2222943258 [label="Tu Xipe Tótec hizo esto, tu dios desollado\nFueron sus acciones las que volvieron locos a todos y los mataran",shape=box,color=blue];
		j2222943258 -> j3006979223;
	j1415283365 [label="Y *yo* entiendo ese tipo de decisión\nPero esa es una historia para otro momento\nLa Flaca no espera a nadie y mucho menos por nuestras conversaciones, tengo pacientes esperando",shape=box,color=blue];
