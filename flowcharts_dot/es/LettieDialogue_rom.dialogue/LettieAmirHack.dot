		j3074449243 -> j3929697966;
	j1364743715 [label="Oye, es que, todo fue un error. Amir estaba intentando enviarte crema de maní para tus ratas.",shape=box,color=red];
		j1364743715 -> j751726567;
	j3929697966 [label="Todo esto es un malentendido. Él estaba tratando de mandarte un regalo.",shape=box,color=red];
		j3929697966 -> j2056447001;
	j751726567 [label="Pero se arruinó, y le voy a ayudar a arreglarlo.",shape=box,color=red];
