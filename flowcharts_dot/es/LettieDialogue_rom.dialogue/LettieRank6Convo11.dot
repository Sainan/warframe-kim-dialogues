	j1757010678 [label="Sí\nLo hará\nPero no cambia el hecho de que la naturaleza de la vida\nEs corta",shape=box,color=blue];
		j1757010678 -> j3170683584;
	j993419154 [label="Gracias\nPero esa es la naturaleza de la vida\nEs corta",shape=box,color=blue];
		j993419154 -> j3170683584;
	j3170683584 [label="La vida de las ratas es corta para las personas\nLa vida de las personas es corta para los árboles\nLa vida de los árboles es corta para los dioses",shape=box,color=blue];
		j3170683584 -> j139049157;
	j139049157 [label="Y la vida de los insectos es corta para las ratas\nTodo es relativo\nY nosotros solo seguimos reiniciándonos, ¿no es así? jajaja",shape=box,color=blue];
