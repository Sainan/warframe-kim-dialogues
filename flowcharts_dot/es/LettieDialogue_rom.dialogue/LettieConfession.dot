	j201927781 [label="Jajaja depende del contexto\nPero no, no, esto no es malo\nSolo que...",shape=box,color=blue];
		j201927781 -> j2720179985;
	j675720518 [label="Check boolean LettieTrust2",color=orange];
		j675720518 -> j1635717649 [label=true,color=green];
		j675720518 -> j3178219534 [label=false,color=brown];
	j862358656 [label="Mira\nLa confianza es algo que me cuesta mucho trabajo dar\nY es lo más importante en una relación para mí\nCuando se rompe la confianza es algo que no se puede reparar, especialmente en una situación como esta",shape=box,color=blue];
		j862358656 -> j1697996313;
	j1635717649 [label="Tú sabes que tan difícil es para mí confiar en los demás\nY que tan importante es la confianza para mí, ¿no?\nBueno... Es aún más importante cuando estoy en una relación con alguien",shape=box,color=blue];
		j1635717649 -> j2790205521;
	j3178219534 [label="Tú sabes que tan difícil es para mí confiar en los demás\nY es lo más importante en una relación para mí\nCuando se rompe la confianza es algo que no se puede reparar, especialmente en una situación como esta",shape=box,color=blue];
