		j880302747 -> j2633393722;
	j3513190368 [label="La verdad no me gusta combinar el dolor con el placer, lo siento.",shape=box,color=red];
		j3513190368 -> j1975609067;
	j2770132690 [label="Mmm, no lo sé\nTal vez porque el dolor es algo que puedo controlar\nEn contraste a todo el dolor que no puedo",shape=box,color=blue];
		j2770132690 -> j2677593041;
	j2633393722 [label="Jajaja por supuesto\nPero cuando te ganes ese turno\nNecesito saber si puedo confiar en ti primero\nAsí que... ¿Qué dices?",shape=box,color=blue];
		j2633393722 -> j1507693083;
