	j3898559246 [label="Siempre\n¿Pero para ti?\n¿Qué?",shape=box,color=blue];
		j3898559246 -> j3300546227;
	j3702107533 [label="Boolean LettieConsentComplete is now true.",color=orange];
		j3702107533 -> "Chat ends.";
	j3300546227 [label="Quiero hablar contigo sobre algo y quiero asegurarme de que estés de acuerdo.",shape=box,color=red];
		j3300546227 -> j3905682239;
	j3905682239 [label="Para mí es importante que no sientas que te estoy mintiendo o que no hablo con total honestidad.",shape=box,color=red];
		j3905682239 -> j2820643664;
		j3905682239 -> j2069895778;
		j3905682239 -> j1379404721;
	j2820643664 [label="Por favor, no me lastimes.",shape=box,color=red];
		j2820643664 -> j3004325057;
	j2069895778 [label="Por favor, no te enojes.",shape=box,color=red];
		j2069895778 -> j207056562;
	j1379404721 [label="Espero que lo entiendas.",shape=box,color=red];
		j1379404721 -> j76761294;
	j3004325057 [label="Jajajajaj\nYa hablamos de esto\nSólo te lastimo de la forma que te gusta\nAhora, ¿de qué estás hablando?",shape=box,color=blue];
		j3004325057 -> j3218530610;
	j207056562 [label="¿Sí?\n¿Y por qué me enojaría?",shape=box,color=blue];
		j207056562 -> j3218530610;
	j76761294 [label="¿Sí?\n¿Y qué hay que entender?",shape=box,color=blue];
		j76761294 -> j3218530610;
	j3218530610 [label="No quiero ponerte en una situación incómoda. Sé que no hemos hablado de esto. Así que si no estás de acuerdo, no hay problema. Quiero que lo sepas.",shape=box,color=red];
		j3218530610 -> j2850143172;
	j2850143172 [label="Lo que tenemos es importante para mí, muy importante, y es real. No quiero que lo dudes.",shape=box,color=red];
		j2850143172 -> j803208527;
	j803208527 [label="Aah, entiendo...\nSabes que normalmente no me gusta estar así\nCreo que sólo quiero saber una cosa\n¿De verdad te importa esa persona, solecito?\n¿Quién es?\n¿De verdad te importa?",shape=box,color=blue];
		j803208527 -> j4154410534;
		j803208527 -> j832384625;
	j4154410534 [label="Me preocupo por ellos. Pero también me preocupo mucho por ti.",shape=box,color=red];
		j4154410534 -> j2532929709;
	j832384625 [label="Debería haber sabido que lo entenderías rápidamente.",shape=box,color=red];
		j832384625 -> j112327435;
	j2532929709 [label="Ay, sí\nEs difícil culparte, cuando ves tanto\nViajas tanto\nSólo no me pidas que me una\nPor mí está bien",shape=box,color=blue];
		j2532929709 -> j246555583;
	j112327435 [label="Fue un engaño, sí\nEleanor me lo dijo\nJajaja es una gran chismosa",shape=box,color=blue];
		j112327435 -> j959786953;
	j246555583 [label="Pero que no sea alguien del hex\nMi familia no, por favor\nTendría que frotarme con toallitas desinfectantes toda una semana",shape=box,color=blue];
		j246555583 -> j3206520638;
	j959786953 [label="Es difícil culparte, cuando ves tanto\nViajas tanto\nSólo no me pidas que me una\nPor mí está bien",shape=box,color=blue];
		j959786953 -> j246555583;
	j3206520638 [label="+20 Chemistry",color=orange];
		j3206520638 -> j3145390019;
	j3145390019 [label="Te has vuelto muy importante para mí, solecito\n¿Y si te hacen feliz?\nEntonces a mí también\nAsí de simple",shape=box,color=blue];
		j3145390019 -> j5779024;
	j5779024 [label="Ah\nY encuentra la manera de que venga aquí algún día\nQuiero conocer a esa persona",shape=box,color=blue];
		j5779024 -> j968629883;
		j5779024 -> j2617046972;
	j968629883 [label="Sí, señora. :)",shape=box,color=red];
		j968629883 -> j3702107533;
