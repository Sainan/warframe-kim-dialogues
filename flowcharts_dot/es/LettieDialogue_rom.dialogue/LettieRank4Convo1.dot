		j202800200 -> "Chat ends.";
	j748671655 [label="Eh, fue complicado\nMe imagino que no quieres saber la parte sangrienta\nPero, si quieres saber\nTe lo diré",shape=box,color=blue];
		j748671655 -> j1527108376;
