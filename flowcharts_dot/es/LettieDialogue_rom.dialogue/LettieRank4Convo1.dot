	j172812638 [label="Bueno, nunca supe la historia completa de como es que conociste a Arthur.",shape=box,color=red];
		j172812638 -> j748671655;
	j2190854137 [label="¿Tienes un momento para chatear, Lettie?, ¿o estás muy ocupada?",shape=box,color=red];
