		1502 -> 1504;
	1503 [label="MomToxicated: Pero todos los buenos secuestradores saben cómo lograr que sus rehenes hablen cuando se les ordena.",shape=box,color=blue];
		1503 -> 1505;
	1504 [label="MomToxicated: No éramos de la Scaldra. Para la gente del otro lado de la línea, solo éramos civiles. Así que no podía darnos información clasificada.",shape=box,color=blue];
