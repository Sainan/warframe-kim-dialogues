	j1230026408 [label="PapaPolar: la última vez que hablamos con ella fue por una línea segura. ",shape=box,color=blue];
		j1230026408 -> j1412239021;
	j1412239021 [label="PapaPolar: y ese pequeño tipo grasiento de aspecto extraño probablemente estaba escuchando",shape=box,color=blue];
		j1412239021 -> j2916302303;
	j2916302303 [label="PapaPolar: en ese momento todavía estábamos *técnicamente* juntos, pero las cosas estaban empeorando, rápidamente...",shape=box,color=blue];
		j2916302303 -> j838345780;
	j838345780 [label="MomToxicated: Apuesto a que ella lo sabía. Podía oírlo. Aunque ni siquiera nosotros lo supiéramos en ese momento.",shape=box,color=blue];
		j838345780 -> j422223397;
		j838345780 -> j1527195986;
	j422223397 [label="¿Podías darte cuenta si ella estaba... ya sabes bajo \"Su\" control?",shape=box,color=red];
		j422223397 -> j1871179323;
	j1527195986 [label="¿De qué hablaron los tres?",shape=box,color=red];
		j1527195986 -> j2936314086;
	j1871179323 [label="PapaPolar: ella sonaba como nuestra pequeña niña, si es eso lo que preguntas. sabía qué decir y cómo decirlo.",shape=box,color=blue];
		j1871179323 -> j815376769;
	j2936314086 [label="MomToxicated: empezamos con negocios. cómo llevaba el mando. no podía darnos cifras ni detalles, por supuesto.",shape=box,color=blue];
		j2936314086 -> j1666237920;
	j815376769 [label="MomToxicated: Pero todos los buenos secuestradores saben cómo lograr que sus rehenes hablen cuando se les ordena.",shape=box,color=blue];
		j815376769 -> j3865284633;
	j1666237920 [label="MomToxicated: No éramos de la Scaldra. Para la gente del otro lado de la línea, solo éramos civiles. Así que no podía darnos información clasificada.",shape=box,color=blue];
		j1666237920 -> j3330883110;
	j3865284633 [label="MomToxicated: Eso no dice nada sobre cuándo o cómo esta “Indiferencia” se apoderó de ella.",shape=box,color=blue];
		j3865284633 -> j2688173160;
	j3330883110 [label="PapaPolar: pero ella sonaba... estresada. podías escucharla.",shape=box,color=blue];
		j3330883110 -> j2265305530;
		j3330883110 -> j2404333671;
	j2688173160 [label="MomToxicated: O quién controlaba su cuerpo cuando hablamos con ella ese día.",shape=box,color=blue];
		j2688173160 -> j3880933904;
