	"Chat ends." [color=orange];
	j2094302395 [label="Eh... ¿chicos?",shape=box,color=red];
		j2094302395 -> j689075596;
	j689075596 [label="MomToxicated: ¿Sí?",shape=box,color=blue];
		j689075596 -> j290647582;
	j290647582 [label="PapaPolar: ¿qué pasa, camarada?",shape=box,color=blue];
		j290647582 -> j1376999377;
		j290647582 -> j4247754937;
		j290647582 -> j4184917933;
	j1376999377 [label="Traigo buenas y malas noticias. Es sobre Neci...",shape=box,color=red];
		j1376999377 -> j984724821;
	j4247754937 [label="Necesito que no se ilusionen. Tengo noticias sobre Neci, pero son... contradictorias. E inconclusas.",shape=box,color=red];
		j4247754937 -> j3890302700;
	j4184917933 [label="Mie... En realidad, no es nada. [Fin]",shape=box,color=red];
		j4184917933 -> "Chat ends.";
	j984724821 [label="PapaPolar: Hazlo como un adulto. Primero las malas noticias.",shape=box,color=blue];
		j984724821 -> j1755433431;
	j3890302700 [label="+5 Chemistry",color=orange];
		j3890302700 -> j1960047348;
	j1755433431 [label="MomToxicated: Estoy de acuerdo. Las malas noticias siempre van primero.",shape=box,color=blue];
		j1755433431 -> j1318044654;
	j1960047348 [label="MomToxicated: En general, todo en la vida lo es. Pero gracias por la advertencia.",shape=box,color=blue];
		j1960047348 -> j1533870777;
	j1318044654 [label="Entonces... la Indiferencia fue a Duviri... y se llevó a Neci consigo.",shape=box,color=red];
		j1318044654 -> j2386632207;
	j1533870777 [label="+5 Chemistry",color=orange];
		j1533870777 -> j3698930955;
	j2386632207 [label="PapaPolar: espera. espera. espera. ¿esa cosa dimensional del libro de cuentos?",shape=box,color=blue];
		j2386632207 -> j2400384382;
	j3698930955 [label="PapaPolar: me estoy preparando para la noticia, pero, al menos parece que ella... ¿sigue viva?",shape=box,color=blue];
		j3698930955 -> j1914860539;
	j2400384382 [label="MomToxicated: ¿El del niño dictador que te mataba una y otra vez?",shape=box,color=blue];
		j2400384382 -> j2324542514;
		j2400384382 -> j4071458632;
	j1914860539 [label="No... lo sé. No lo creo. Pero déjenme decirles lo que sí sé y ya ustedes me dirán lo que piensan.",shape=box,color=red];
		j1914860539 -> j1318044654;
	j2324542514 [label="Al parecer, fue un momento de crecimiento para él... pero, ese no es el punto. En fin...",shape=box,color=red];
		j2324542514 -> j3875378270;
	j4071458632 [label="Ese es.",shape=box,color=red];
		j4071458632 -> j3875378270;
	j3875378270 [label="Neci... tomó el trono. El Murmullo —el \"ejército\" de la Indiferencia, a falta de una palabra mejor— invadió el reino y ella tomó el poder.",shape=box,color=red];
		j3875378270 -> j3920575700;
	j3920575700 [label="MomToxicated: Je. Esa es mi niña.",shape=box,color=blue];
		j3920575700 -> j2868978549;
	j2868978549 [label="PapaPolar: ¿pero era realmente *ella*? ¿o sólo esa cosa que llevaba su cara?",shape=box,color=blue];
		j2868978549 -> j3732807583;
		j2868978549 -> j6478455;
	j3732807583 [label="No lo sé.",shape=box,color=red];
		j3732807583 -> j1425994332;
	j6478455 [label="Eso es lo que quería decirles.",shape=box,color=red];
		j6478455 -> j1425994332;
	j1425994332 [label="Encontré estos registros. Al principio no parecían tener sentido, pero cuando los junté... recibí este mensaje.",shape=box,color=red];
		j1425994332 -> j561113215;
	j561113215 [label="Tenía curiosidad por saber si tenía algún sentido para ustedes.",shape=box,color=red];
		j561113215 -> j1834442530;
	j1834442530 [label="MomToxicated: ¿Acertijos y mensajes extraños? Hablas nuestro idioma.",shape=box,color=blue];
		j1834442530 -> j2887333537;
	j2887333537 [label="PapaPolar: 1-800-cosas-de-espionaje, has llegado al lugar correcto",shape=box,color=blue];
		j2887333537 -> j1237343343;
	j1237343343 [label="\"Porque cuando Sol y Lua se alineen, los perdidos encontrarán el camino a casa\".",shape=box,color=red];
		j1237343343 -> j312999451;
	j312999451 [label="PapaPolar: ... mierda. M. MIERDA.",shape=box,color=blue];
		j312999451 -> j1066031767;
	j1066031767 [label="MomToxicated: No te dejes engañar. Si esa cosa está en su cabeza, sabe lo que ella sabe.",shape=box,color=blue];
		j1066031767 -> j3620448790;
		j1066031767 -> j2524596591;
	j3620448790 [label="¿Qué? ¿Qué significa?",shape=box,color=red];
		j3620448790 -> j790875750;
	j2524596591 [label="Es la otra mitad, ¿no?",shape=box,color=red];
		j2524596591 -> j2064211735;
	j790875750 [label="PapaPolar: \"En encrucijadas vacías, busca el eclipse\".",shape=box,color=blue];
		j790875750 -> j2960811882;
	j2064211735 [label="+5 Chemistry",color=orange];
		j2064211735 -> j887022242;
	j2960811882 [label="PapaPolar: lo que te dije que le dijeras a nuestra niña si la volvías a ver.",shape=box,color=blue];
		j2960811882 -> j309994777;
	j887022242 [label="PapaPolar: exactamente...",shape=box,color=blue];
		j887022242 -> j2768411018;
	j309994777 [label="PapaPolar: era nuestra mitad de una frase clave. así iniciábamos cada llamada telefónica para saber que estábamos en una línea segura y que todo estaba bien",shape=box,color=blue];
		j309994777 -> j3082453243;
	j2768411018 [label="PapaPolar: teníamos una frase clave. así empezábamos cada llamada telefónica para saber que estábamos en una línea segura y que todo estaba bien",shape=box,color=blue];
		j2768411018 -> j3082453243;
	j3082453243 [label="MomToxicated: Para saber que éramos… nosotros.",shape=box,color=blue];
		j3082453243 -> j1661448892;
	j1661448892 [label="PapaPolar: \"En encrucijadas vacías, busca el eclipse\" era nuestra mitad.",shape=box,color=blue];
		j1661448892 -> j2033003155;
	j2033003155 [label="MomToxicated: \"Porque cuando Sol y Lua se alineen, los perdidos encontrarán el camino a casa\", era la respuesta.",shape=box,color=blue];
		j2033003155 -> j2255725371;
	j2255725371 [label="MomToxicated: *Su* mitad.",shape=box,color=blue];
		j2255725371 -> j2658732886;
		j2255725371 -> j3597798022;
	j2658732886 [label="Pero no podemos estar seguros de que fuera ella. Como dijiste, Minerva, la Indiferencia sabe lo que ella sabe.",shape=box,color=red];
		j2658732886 -> j2830516002;
	j3597798022 [label="No sé por qué te diría eso la Indiferencia...",shape=box,color=red];
		j3597798022 -> j2976853154;
	j2830516002 [label="MomToxicated: Pero, ¿por qué intentaría darnos esperanza? A menos que simplemente estuviera tratando de hacernos daño.",shape=box,color=blue];
		j2830516002 -> j71193056;
	j2976853154 [label="MomToxicated: ¿Quizás para darnos falsas esperanzas? ¿Para hacernos sufrir?",shape=box,color=blue];
		j2976853154 -> j3793736152;
	j71193056 [label="PapaPolar: ¿esto duele?",shape=box,color=blue];
		j71193056 -> j307466627;
	j3793736152 [label="PapaPolar: pero, ¿será mentira? ¿acaso duele?",shape=box,color=blue];
		j3793736152 -> j307466627;
	j307466627 [label="PapaPolar: ¿o nos trae cierta paz... saber que nuestra pequeña sigue por ahí, viva, en algún lugar?",shape=box,color=blue];
		j307466627 -> j173909986;
	j173909986 [label="PapaPolar: ¿que a pesar de todos los obstáculos, sigue pateando traseros y forjándose un nombre?",shape=box,color=blue];
		j173909986 -> j3073751529;
	j3073751529 [label="PapaPolar: ¿aunque no esté con nosotros?",shape=box,color=blue];
		j3073751529 -> j371347166;
	j371347166 [label="PapaPolar: no sé tú pero, eso calienta mi gran y bobo corazón.",shape=box,color=blue];
		j371347166 -> j3545453684;
	j3545453684 [label="PapaPolar: y algo me dice que esto no es lo que la llamada Indiferencia tenía en mente",shape=box,color=blue];
		j3545453684 -> j4252806201;
	j4252806201 [label="MomToxicated: Tienes toda la razón. Escuchar esa frase y pensar que *quizás* aún esté ahí fuera no duele.",shape=box,color=blue];
		j4252806201 -> j1829938061;
	j1829938061 [label="MomToxicated: Estoy orgullosa de ella.",shape=box,color=blue];
		j1829938061 -> j3177079777;
		j1829938061 -> j1285178081;
		j1829938061 -> j54625943;
	j3177079777 [label="¿Aunque siga secuestrada por la Indiferencia?",shape=box,color=red];
		j3177079777 -> j169541155;
	j1285178081 [label="¿Aunque sea un truco de la Indiferencia?",shape=box,color=red];
		j1285178081 -> j29313873;
	j54625943 [label="Ella podría estar trabajando voluntariamente con la Indiferencia.",shape=box,color=red];
		j54625943 -> j2455586893;
	j169541155 [label="PapaPolar: ella es tan dura como los clavos de un enorme bloque de aleación de titanio.",shape=box,color=blue];
		j169541155 -> j1184621043;
	j29313873 [label="MomToxicated: ¿Por qué? ¿Para qué? ¿Qué ganaría con nosotros dos?",shape=box,color=blue];
		j29313873 -> j4156510433;
	j2455586893 [label="MomToxicated: Entonces tiene uno de los aliados más poderosos del universo. De la existencia. Eligió un bando. Igual que nosotros.",shape=box,color=blue];
		j2455586893 -> j801768491;
	j1184621043 [label="PapaPolar: y apuesto que tu \"hombre en la pared\" lo sabía, y por eso se la llevó en primer lugar",shape=box,color=blue];
		j1184621043 -> j3840736993;
	j4156510433 [label="PapaPolar: somos peces pequeñitos ante esa cosa. lo cual digo de la mejor manera posible",shape=box,color=blue];
		j4156510433 -> j132327778;
	j801768491 [label="MomToxicated: Ojalá nunca tengamos que apuntarnos con armas. Y si eso llegara a pasar, ya lidiaremos con ello.",shape=box,color=blue];
		j801768491 -> j3171774498;
	j3840736993 [label="PapaPolar: no, ella estará bien. o ya se fue hace mucho, o tienen un acuerdo mutuo, o ella lo tiene como rehén. Jajaja",shape=box,color=blue];
		j3840736993 -> j132327778;
	j132327778 [label="MomToxicated: No, creo que el mensaje era real. Y creo que era de nuestra pequeña. Nos decía... que sigue ahí fuera.",shape=box,color=blue];
		j132327778 -> j204839802;
	j3171774498 [label="PapaPolar: pero ella puede cuidarse sola. así es como la criamos",shape=box,color=blue];
		j3171774498 -> j132327778;
	j204839802 [label="MomToxicated: Diciéndonos, a su manera, que \"está bien\".",shape=box,color=blue];
		j204839802 -> j3456721339;
	j3456721339 [label="MomToxicated: Y que podemos dejar de preocuparnos por ella.",shape=box,color=blue];
		j3456721339 -> j2777977835;
	j2777977835 [label="PapaPolar: je. como si pudiéramos",shape=box,color=blue];
		j2777977835 -> j4184652787;
	j4184652787 [label="MomToxicated: La maldición y la bendición de ser padre.",shape=box,color=blue];
		j4184652787 -> j1969762558;
	j1969762558 [label="PapaPolar: ¿te gustaría tener hijos algún día, Viajero? eeeeh, no respondas a eso. probablemente dirás alguna tontería del vació de la que no quiero saber nada.",shape=box,color=blue];
		j1969762558 -> j4190737136;
		j1969762558 -> j3486483610;
		j1969762558 -> j374858887;
	j4190737136 [label="¿Que si me gustaría tomar algo? Sí, claro.",shape=box,color=red];
		j4190737136 -> j3362460367;
	j3486483610 [label="Sabia decisión.",shape=box,color=red];
		j3486483610 -> j3982549738;
	j374858887 [label="<RETRO_EMOJI_OHNO>",shape=box,color=red];
		j374858887 -> j1147175607;
	j3362460367 [label="+5 Chemistry",color=orange];
		j3362460367 -> j4275887520;
	j3982549738 [label="PapaPolar: bueno, no es una sonrisa muy feliz... más bien algo melancólica... pero",shape=box,color=blue];
		j3982549738 -> j3370795017;
	j1147175607 [label="MomToxicated: Esa es una respuesta válida, estoy de acuerdo. Je. ¿Qué tal unas copas?",shape=box,color=blue];
		j1147175607 -> j3977191658;
	j4275887520 [label="MomToxicated: Ahora sí hablamos el mismo idioma.",shape=box,color=blue];
		j4275887520 -> j3370795017;
	j3370795017 [label="PapaPolar: me gustaría contar algunas buenas historias sobre nuestra pequeña",shape=box,color=blue];
		j3370795017 -> j120299584;
	j3977191658 [label="PapaPolar: ya nos estamos entendiendo",shape=box,color=blue];
		j3977191658 -> j3370795017;
	j120299584 [label="MomToxicated: Y... ¿Viajero? Gracias. De nuevo. Por todo lo que haces.",shape=box,color=blue];
		j120299584 -> j4107969526;
	j4107969526 [label="PapaPolar: sí. en serio, camarada. no sé cómo podremos pagarte. pero si se presenta la oportunidad, cuenta con nosotros.",shape=box,color=blue];
		j4107969526 -> j2334074410;
	j2334074410 [label="PapaPolar: ahora eres familia, te guste o no. 8-)",shape=box,color=blue];
		j2334074410 -> "Chat ends.";
}