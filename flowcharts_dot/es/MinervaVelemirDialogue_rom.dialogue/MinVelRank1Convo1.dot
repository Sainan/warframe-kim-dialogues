		28 -> 30;
	29 [label="PapaPolar: yo por mi parte espero que así sea. Cuantos más, mejor. Como dice el viejo refrán, la única diferencia entre una secta y una religión son los números, jaja.",shape=box,color=blue];
		29 -> 31;
