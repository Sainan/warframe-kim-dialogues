		480 -> 484;
	481 [label="MomToxicated: Ejem, lo dice el hombre que le causó una adicción al tabaco.",shape=box,color=blue];
		481 -> 485;
	482 [label="PapaPolar: mira, ni siquiera estoy seguro de si estaba realmente interesada en todo ese asunto del fanatismo de sol-lua",shape=box,color=blue];
		482 -> 486;
	483 [label="MomToxicated: Ella siempre fue una mujer con ambición, una ambición que yo alenté y fomenté, a diferencia de *alguien* que quería congelarla y mantenerla en un estado de infancia estancada.",shape=box,color=blue];
		483 -> 487;
	484 [label="PapaPolar: su escote está obviamente influenciado por alguien, querida",shape=box,color=blue];
		484 -> 488;
	485 [label="PapaPolar: sí y lo que estoy diciendo es que ese escote está obviamente influenciado por alguien, querida",shape=box,color=blue];
		485 -> 489;
	486 [label="PapaPolar: al menos no tanto como el resto de la scaldra. para ella, creo que siempre fue un medio para un fin. ",shape=box,color=blue];
		486 -> 490;
	487 [label="PapaPolar: ¡yo fui quien dijo que ella podía ir, ¿no?!",shape=box,color=blue];
		487 -> 491;
	488 [label="MomToxicated: Muy gracioso. Eres muy inteligente. Déjame aplaudir tu gran ingenio. Al menos no le di un maldito problema de tabaquismo.",shape=box,color=blue];
		488 -> 492;
	489 [label="PapaPolar: ella aprendió lo que aprendió porque funciona, pero lo obtuvo de algún lado. y no puedes decir que eso no es cierto.",shape=box,color=blue];
		489 -> 493;
	490 [label="PapaPolar: cualquier escalera hacia arriba, vale la pena escalarla, en la mente de algunas personas.",shape=box,color=blue];
		490 -> 494;
	491 [label="MomToxicated: Ah, sí. La *única* vez que la dejaste expresarse sin tus lamentos insoportables fue la *única* vez que elegiste no escucharme, confiaste en mí, y la dejaste ir ¡y mira lo que pasó!",shape=box,color=blue];
		491 -> 495;
	492 [label="MomToxicated: Sobre lo que Velimir está haciendo bromas vulgares (miserablemente) es que a veces, como mujer, tienes opciones limitadas en cuanto a cómo abordar una situación.",shape=box,color=blue];
		492 -> 496;
	493 [label="PapaPolar: mira, cuando estás en el ejército, a veces solo... a veces aprovechas tus atributos, ¿sí?",shape=box,color=blue];
		493 -> 497;
	494 [label="MomToxicated: Ella tiene ambición. Siempre la resentiste por eso.",shape=box,color=blue];
