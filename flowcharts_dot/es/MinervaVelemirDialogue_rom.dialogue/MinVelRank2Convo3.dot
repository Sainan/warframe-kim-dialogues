		561 -> 567;
	562 [label="MomToxicated: Por supuesto, esto se volvió una pelea a gritos entre los dos señores de la guerra, hasta que se dieron cuenta, durante la discusión, de que ella nunca había hablado con el primer señor de la guerra. Se lo había dicho a propósito.",shape=box,color=blue];
