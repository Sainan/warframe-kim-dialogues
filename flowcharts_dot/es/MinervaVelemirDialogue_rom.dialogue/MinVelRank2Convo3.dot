		478 -> 482;
	479 [label="MomToxicated: Creo que para Neci, unirse a la Scaldra, era un medio para un fin. Creía en las personas que la rodeaban, pero no tenía una firme adhesión a la fe. No como Vodyanoi.",shape=box,color=blue];
		479 -> 483;
