		554 -> 561;
	555 [label="MomToxicated: Le dijo deliberadamente al segundo señor de la guerra que el primero le había enseñado una frase en su lengua materna. Dijo que significaba \"Es un honor conocerte\". Lo que en realidad dijo fue \"Eres un gran idiota\".",shape=box,color=blue];
