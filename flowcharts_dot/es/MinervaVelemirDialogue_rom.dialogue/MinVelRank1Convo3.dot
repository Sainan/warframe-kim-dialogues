		j749923745 -> j3924767402;
		j749923745 -> j3800923460;
		j749923745 -> j3850266272;
	j453865403 [label="Buenos días, Minerva. Si ese es tu verdadero nombre.",shape=box,color=red];
		j453865403 -> j689784161;
	j3924767402 [label="Veo que hemos eliminado las \"comillas\".",shape=box,color=red];
		j3924767402 -> j3057883679;
	j3800923460 [label="¿Ahora lo preguntas?",shape=box,color=red];
		j3800923460 -> j3057883679;
	j3850266272 [label="¿Sí?",shape=box,color=red];
		j3850266272 -> j262237190;
	j689784161 [label="+5 Chemistry",color=orange];
		j689784161 -> j3779373467;
