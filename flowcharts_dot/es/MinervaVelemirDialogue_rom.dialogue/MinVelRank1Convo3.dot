		j3670764615 -> j1267537874;
	j766470494 [label="PapaPolar: mmm. más o menos. ya no realmente. sólo en el papel. en algún lugar. ¿en algún país que dejó de existir alrededor de 1982?",shape=box,color=blue];
		j766470494 -> j1596110326;
	j1267537874 [label="PapaPolar: más o menos. estábamos en el extranjero en un pequeño pueblo a unos cuantos países al sur de aquí. el lugar fue destruído. la encontramos allí en un edificio, pelirroja y muy enojada.",shape=box,color=blue];
		j1267537874 -> j2187538341;
	j1596110326 [label="PapaPolar: ¿eso cuenta?",shape=box,color=blue];
		j1596110326 -> j2021640991;
		j1596110326 -> j2547151612;
	j2187538341 [label="PapaPolar: intentó apuñalarme seis veces con una cuchara jajajaja, la cosa más linda que jamás hayas visto.",shape=box,color=blue];
		j2187538341 -> j1042039785;
	j2021640991 [label="Sí, no parece que sigan juntos.",shape=box,color=red];
		j2021640991 -> j2012532043;
	j2547151612 [label="Supongo que eso explica las discusiones.",shape=box,color=red];
		j2547151612 -> j3547689619;
	j1042039785 [label="PapaPolar: tenía un pequeño conejo de peluche al que se aferraba. M le dijo que lo protegería con su vida y lo mantendría a salvo.",shape=box,color=blue];
		j1042039785 -> j3511978875;
	j2012532043 [label="PapaPolar: ¿cómo lo supiste?",shape=box,color=blue];
		j2012532043 -> j3547689619;
	j3547689619 [label="PapaPolar: cuando neci se fue para unirse a la scaldra... las cosas nunca volvieron a ser iguales entre nosotros. fue la gota que derramó el vaso, creo.",shape=box,color=blue];
		j3547689619 -> j2100155807;
	j3511978875 [label="PapaPolar: así se ganó la confianza de neci muy rápido. ella corrió directamente hacia M y la abrazó. entonces dejamos el ejército. bueno, oficialmente nos convertimos en \"consultores\".",shape=box,color=blue];
		j3511978875 -> j2417195764;
	j2100155807 [label="PapaPolar: ahh.",shape=box,color=blue];
		j2100155807 -> j1820310580;
