		j3057883679 -> j4279064257;
	j262237190 [label="+5 Chemistry",color=orange];
		j262237190 -> j1493621853;
	j3779373467 [label="MomToxicated: Lo creas o no, lo soy.",shape=box,color=blue];
		j3779373467 -> j2739892515;
	j4279064257 [label="MomToxicated: Lo cual es gracioso, considerando todo.",shape=box,color=blue];
		j4279064257 -> j2360265339;
	j1493621853 [label="MomToxicated: Directo al grano. Bien.",shape=box,color=blue];
		j1493621853 -> j2360265339;
	j2739892515 [label="MomToxicated: Pero ese no es el punto.",shape=box,color=blue];
		j2739892515 -> j2360265339;
	j2360265339 [label="MomToxicated: Estamos aquí en Höllvania con un problema que resolver. Y tú puedes ayudarme a resolverlo.",shape=box,color=blue];
		j2360265339 -> j799999458;
	j799999458 [label="MomToxicated: Así que necesito, te lo pido por favor, que me ayudes.",shape=box,color=blue];
		j799999458 -> j3411344873;
		j799999458 -> j712652317;
		j799999458 -> j488484845;
	j3411344873 [label="¿Cuál es el problema que se supone que debo resolver?",shape=box,color=red];
		j3411344873 -> j727704653;
	j712652317 [label="¿Por qué debería ayudarte?",shape=box,color=red];
		j712652317 -> j727704653;
	j488484845 [label="¿Y qué tiene esto que ver con Rusalka?",shape=box,color=red];
		j488484845 -> j727704653;
	j727704653 [label="MomToxicated: Esa es una muy buena pregunta.",shape=box,color=blue];
		j727704653 -> j782223588;
	j782223588 [label="MomToxicated: No tienes por qué querer ayudarme por mi bien. Tenemos un enemigo común: ese \"Hombre en la Pared\".",shape=box,color=blue];
		j782223588 -> j2787057710;
	j2787057710 [label="MomToxicated: Hasta donde puedo entender, a ti también te interesa saber a dónde ha ido, qué busca y por qué atacó a Rusalka en primer lugar.",shape=box,color=blue];
		j2787057710 -> j657495227;
	j657495227 [label="MomToxicated: ¿Mi observación es correcta?",shape=box,color=blue];
		j657495227 -> j4175675101;
		j657495227 -> j2577464317;
		j657495227 -> j4131106006;
	j4175675101 [label="¿Puedes dar un paso atrás y tomarte un minuto para explicarme por qué te preocupas tanto por Rusalka?",shape=box,color=red];
		j4175675101 -> j3612410475;
	j2577464317 [label="En cuanto a los dos primeros, sí. En realidad, no me importa un carajo por qué atacó a Rusalka.",shape=box,color=red];
		j2577464317 -> j897019494;
	j4131106006 [label="Claro. Sí. Eso es correcto.",shape=box,color=red];
		j4131106006 -> j1959474863;
	j3612410475 [label="MomToxicated: El por qué no es importante.",shape=box,color=blue];
		j3612410475 -> j1993221604;
	j897019494 [label="MomToxicated: Si no te interesa al menos un poco su bienestar, ¿por qué le perdonaste la vida como sabemos que lo hiciste? Escuchamos la historia.",shape=box,color=blue];
		j897019494 -> j3293689458;
		j897019494 -> j2745659649;
		j897019494 -> j4109839433;
	j1959474863 [label="Lamento decírtelo, pero probablemente estemos atrapados esperando hasta que el Hombre en la Pared haga su próximo movimiento.",shape=box,color=red];
		j1959474863 -> j377788128;
	j1993221604 [label="PapaPolar: pero sí lo es, y probablemente ya lo hayan descubierto. no es que seamos exactamente sutiles",shape=box,color=blue];
		j1993221604 -> j2906033919;
	j3293689458 [label="Porque entonces yo no sería diferente de la Indiferencia. De la Scaldra. De Entrati. Yo no ando por ahí asesinando gente sin sentido.",shape=box,color=red];
		j3293689458 -> j1442136998;
	j2745659649 [label="Porque en realidad no fueron sus decisiones que la llevaron a ese punto. El hecho de que yo no la matara en ese momento no significa que me *importe* lo suficiente como para hacer todo lo posible para salvarla.",shape=box,color=red];
		j2745659649 -> j700093463;
	j4109839433 [label="Porque no quería hacer el trabajo sucio de Entrati por él. Si quería matar al nuevo títere de la Indiferencia, podía hacerlo él mismo.",shape=box,color=red];
		j4109839433 -> j2167438743;
	j377788128 [label="MomToxicated: ¿Y por qué? ¿No tienes forma de rastrearlo? ¿A eso? ¿Sea lo que sea? ¿O no sabes qué es lo que realmente busca?",shape=box,color=blue];
		j377788128 -> j1957394656;
		j377788128 -> j2447440263;
	j2906033919 [label="PapaPolar: y tal vez, *solo tal vez* si confiaras en nuestro camarada con un poco de información, podría ser más fácil que nos *ayudeee*",shape=box,color=blue];
		j2906033919 -> j2706260853;
	j1442136998 [label="Lo que implica es que mato a personas a propósito, lo cual no es mi caso. Sí mato a personas, pero es diferente. Ya sabes a qué me refiero.",shape=box,color=red];
		j1442136998 -> j3765441859;
	j700093463 [label="Yo no la *conocía*.",shape=box,color=red];
		j700093463 -> j2860756027;
	j2167438743 [label="Pero tal como sospechaba, al viejo bastardo sólo le gusta dispararle a gente que sabe que se levantará.",shape=box,color=red];
		j2167438743 -> j2462093789;
	j1957394656 [label="No es exactamente posible colocar una baliza de rastreo en un algo-semidiós-dios.",shape=box,color=red];
		j1957394656 -> j4039602890;
	j2447440263 [label="No entendemos sus motivaciones del todo, sí, pero no son nada bueno.",shape=box,color=red];
		j2447440263 -> j4039602890;
	j2706260853 [label="PapaPolar: es casi como si así fuera como la gente trabaja a veces. ",shape=box,color=blue];
		j2706260853 -> j924385634;
	j3765441859 [label="+5 Chemistry",color=orange];
		j3765441859 -> j647302308;
	j2860756027 [label="PapaPolar: y no te estamos dando exactamente un motivo para que te importe. ¿verdad, M?",shape=box,color=blue];
		j2860756027 -> j54408231;
	j2462093789 [label="PapaPolar: una declaración extrañamente específica pero está bien",shape=box,color=blue];
		j2462093789 -> j759281012;
		j2462093789 -> j3118477024;
	j4039602890 [label="MomToxicated: Entonces, ¿estás sugiriendo que nos sentemos y esperemos a que... ¿qué? ¿A que levante la cabeza? ¿Y entonces veamos si lo atrapamos?",shape=box,color=blue];
		j4039602890 -> j385868673;
	j924385634 [label="MomToxicated: ¿De qué serviría?",shape=box,color=blue];
		j924385634 -> j3423715588;
	j647302308 [label="PapaPolar: estás hablando con un par de exmilitares de operaciones especiales, lo entendemos. jajaja",shape=box,color=blue];
		j647302308 -> j875409756;
	j54408231 [label="MomToxicated: Cállate, Velimir.",shape=box,color=blue];
		j54408231 -> j3612410475;
	j759281012 [label="Está bien. Siempre estoy muriendo. Ya me acostumbré.",shape=box,color=red];
		j759281012 -> j2560069248;
	j3118477024 [label="En realidad no importa.",shape=box,color=red];
		j3118477024 -> j1959474863;
		j3118477024 -> j3396874159;
	j385868673 [label="PapaPolar: ¿al menos en este lugar hay buena compañía y un lindo bar?",shape=box,color=blue];
		j385868673 -> j2490072743;
	j3423715588 [label="PapaPolar: no está de más tener amigos en este mundo, M.",shape=box,color=blue];
		j3423715588 -> j1866445831;
	j875409756 [label="PapaPolar: lo que tenemos que hacer en nombre del \"bien mayor\" a veces no es tan claro",shape=box,color=blue];
		j875409756 -> j3638337717;
	j2560069248 [label="PapaPolar: oookie dokie... seguro, camarada... seguro...",shape=box,color=blue];
		j2560069248 -> j4174241860;
	j3396874159 [label="¿Por qué tienes tanto interés en saber qué le pasó a Rusalka?",shape=box,color=red];
		j3396874159 -> j3612410475;
	j2490072743 [label="PapaPolar: la música es bastante buena. ese tal arthur parece un buen compañero de copas",shape=box,color=blue];
		j2490072743 -> j3254868176;
	j1866445831 [label="MomToxicated: ¿Para qué necesitamos \"amigos\"? Nos iremos de aquí en cuanto sepamos dónde tenemos que estar para salvar a Neci.",shape=box,color=blue];
		j1866445831 -> j3694898977;
	j3638337717 [label="PapaPolar: por eso, cuando podemos hacer algo que importa, lo hacemos. por eso estamos aquí, tratando de salvar a neci",shape=box,color=blue];
		j3638337717 -> j1959474863;
		j3638337717 -> j3396874159;
	j4174241860 [label="PapaPolar: en fin...",shape=box,color=blue];
		j4174241860 -> j1959474863;
		j4174241860 -> j3396874159;
	j3254868176 [label="MomToxicated: ¿Y qué? ¿Seguimos sin saber qué le pasó realmente? ¿O si está bien? ¿O si realmente sigue siendo ella?",shape=box,color=blue];
		j3254868176 -> j2164784362;
	j3694898977 [label="PapaPolar: no estoy seguro. parece que será difícil predecir los movimientos de un monstruo del vacío semidiós... cosa. ¿verdad, camarada?",shape=box,color=blue];
		j3694898977 -> j2447440263;
		j3694898977 -> j1957394656;
	j2164784362 [label="MomToxicated: ¡¿Cómo puedes solo sentarte y estar bien con eso, Velimir?!",shape=box,color=blue];
		j2164784362 -> j3367594069;
	j3367594069 [label="PapaPolar: ¡nunca dije que estaba bien con eso, M! ¡simplemente entiendo cuando tenemos que sentarnos y esperar el momento oportuno!",shape=box,color=blue];
		j3367594069 -> j2215651023;
	j2215651023 [label="MomToxicated: He hablado con Eleanor. Me contó lo que sintió cuando tocó la mente de Neci. O lo que quedaba de ella.",shape=box,color=blue];
		j2215651023 -> j1203709438;
	j1203709438 [label="MomToxicated: La mujer que criamos. La mujer que amamos como si fuera nuestra.",shape=box,color=blue];
		j1203709438 -> j1083561286;
	j1083561286 [label="MomToxicated: Quien sabe qué... ",shape=box,color=blue];
		j1083561286 -> j1167507710;
