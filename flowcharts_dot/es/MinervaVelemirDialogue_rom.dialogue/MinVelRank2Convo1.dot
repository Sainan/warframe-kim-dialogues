	j92670913 [label="PapaPolar: je, sí. hola",shape=box,color=blue];
		j92670913 -> j3300370640;
	j1725574880 [label="PapaPolar: bueno, estoy seguro de que no soy ninguna princesa gisney, así que no lo digo literalmente, jajaja",shape=box,color=blue];
		j1725574880 -> j3300370640;
	j3300370640 [label="PapaPolar: en fin, estoy hablando con él, o mejor dicho, él me está hablando a mí",shape=box,color=blue];
