		j3808077967 -> j1016707487;
	j3130100167 [label="PapaPolar: blegh. necesito una cerveza fría. voy a tomarme unas cuantas. hablamos luego.",shape=box,color=blue];
		j3130100167 -> j1972364092;
	j2406530924 [label="PapaPolar: gracias. intenté dejar que mi pequeña corriera libre y perdí a toda mi familia por eso.",shape=box,color=blue];
