	j1451443115 [label="PapaPolar: ... lo cual es algo que tengo la sensación de que entiendes perfectamente...",shape=box,color=blue];
		j1451443115 -> j1361008384;
	j1361008384 [label="PapaPolar: ¿¿y entonces empieza a parlotear sobre algo de alguna dimensión alternativa de la que vienes??",shape=box,color=blue];
		j1361008384 -> j1161697943;
		j1361008384 -> j1687372546;
	j1161697943 [label="Duviri. Es complicado.",shape=box,color=red];
		j1161697943 -> j2935131308;
	j1687372546 [label="Sí, es una larga historia.",shape=box,color=red];
		j1687372546 -> j2935131308;
	j2935131308 [label="PapaPolar: llegué a ese punto a unos ocho billones de kilómetros por hora, no te preocupes por eso, colega",shape=box,color=blue];
		j2935131308 -> j4064816733;
	j4064816733 [label="PapaPolar: mierda. creo que entendí aproximadamente un tercio. y el tercio que entendí, fue demasiado. ¿necesitas un abrazo, camarada?",shape=box,color=blue];
		j4064816733 -> j3636252132;
		j4064816733 -> j2949301196;
		j4064816733 -> j666103590;
	j3636252132 [label="Estoy bien. Curiosamente, estoy mejor desde que llegué aquí.",shape=box,color=red];
		j3636252132 -> j1798194073;
	j2949301196 [label="Pero no me rompas la columna cuando lo hagas, grandulón.",shape=box,color=red];
		j2949301196 -> j3865984105;
	j666103590 [label="Nunca rechazaré un abrazo gratis. ",shape=box,color=red];
		j666103590 -> j1253670115;
	j1798194073 [label="PapaPolar: me alegra que hayas encontrado un lugar que te haya ayudado a llenar el vacío. eso es más de lo que mucha gente consigue en la vida.",shape=box,color=blue];
		j1798194073 -> j467920369;
	j3865984105 [label="PapaPolar: ¡JA! visita gratuita al quiropráctico y ahora tengo un servicio de compresas de hielo incorporado",shape=box,color=blue];
		j3865984105 -> j4007350778;
	j1253670115 [label="PapaPolar: bien por ti. la vida es una mierda y no debemos rechazar las cosas que la hacen mejor.",shape=box,color=blue];
		j1253670115 -> j4007350778;
	j467920369 [label="PapaPolar: el hogar no es donde naciste, no son las personas que te criaron, son los lugares y las personas que te hacen sentir completo.",shape=box,color=blue];
		j467920369 -> j4007350778;
