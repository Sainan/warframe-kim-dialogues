	j543584207 [label="¿Minerva todavía está enojada contigo?",shape=box,color=red];
		j543584207 -> j2161210399;
	j1156204548 [label="Entonces... ¿Minerva y tú están... juntos?",shape=box,color=red];
		j1156204548 -> j443628499;
	j3991799366 [label="PapaPolar: ya que ella todavía está desconectada y enojada conmigo, supongo que no está de más decírtelo",shape=box,color=blue];
		j3991799366 -> j3280458674;
	j2161210399 [label="PapaPolar: cuándo no lo está...",shape=box,color=blue];
		j2161210399 -> j2773590708;
	j443628499 [label="Boolean MinervaVelimir1 is now true.",color=orange];
		j443628499 -> j3276728141;
	j3280458674 [label="Boolean MinervaNeci3a is now true.",color=orange];
		j3280458674 -> j3029796109;
	j2773590708 [label="PapaPolar: pero ella tiene sus razones, créeme, no se la pongo fácil.",shape=box,color=blue];
		j2773590708 -> j917679871;
	j3276728141 [label="PapaPolar: mmm. más o menos. estuvimos casados pero ya no. sólo en el papel. en algún lugar. ¿en algún país que dejó de existir alrededor de 1982?",shape=box,color=blue];
		j3276728141 -> j219776512;
	j3029796109 [label="PapaPolar: estábamos en el extranjero en un pequeño pueblo a unos pocos países al sur de aquí. el lugar explotó en pedazos. encontramos allí a una niñita. era una criatura diminuta, pelirroja y rabiosa como un avispero ",shape=box,color=blue];
		j3029796109 -> j1512702618;
