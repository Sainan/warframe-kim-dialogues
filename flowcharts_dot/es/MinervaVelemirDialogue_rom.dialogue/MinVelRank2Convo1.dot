		j917679871 -> j3991799366 [label=true,color=green];
		j917679871 -> j2525394121 [label=false,color=brown];
	j219776512 [label="PapaPolar: ¿eso cuenta?",shape=box,color=blue];
		j219776512 -> j60622405;
		j219776512 -> j1335763844;
	j1512702618 [label="PapaPolar: intentó apuñalarme seis veces con una cuchara jajajaja, la cosa más linda que jamás hayas visto.",shape=box,color=blue];
		j1512702618 -> j534357179;
	j2525394121 [label="PapaPolar: probablemente puedas verlo claro como el día, los dos solíamos estar \"juntos\". en realidad, casados.",shape=box,color=blue];
		j2525394121 -> j2716961855;
	j60622405 [label="Supongo que eso explica las discusiones.",shape=box,color=red];
		j60622405 -> j4011465593;
	j1335763844 [label="Sí, no parece que sigan juntos.",shape=box,color=red];
		j1335763844 -> j224530233;
	j534357179 [label="PapaPolar: tenía un pequeño conejo de peluche al que se aferraba. M le dijo que lo protegería con su vida y lo mantendría a salvo.",shape=box,color=blue];
		j534357179 -> j194810782;
	j2716961855 [label="Boolean MinervaVelimir1 is now true.",color=orange];
		j2716961855 -> j1131616269;
	j4011465593 [label="PapaPolar: cuando neci se fue para unirse a la scaldra... las cosas nunca volvieron a ser iguales entre nosotros. fue la gota que derramó el vaso, creo.",shape=box,color=blue];
		j4011465593 -> j1691812752;
	j224530233 [label="PapaPolar: ¿cómo lo supiste?",shape=box,color=blue];
		j224530233 -> j4011465593;
	j194810782 [label="PapaPolar: así se ganó la confianza de neci muy rápido. ella corrió directamente hacia M y la abrazó. entonces dejamos el ejército. bueno, oficialmente nos convertimos en \"consultores\".",shape=box,color=blue];
		j194810782 -> j4273566156;
	j1131616269 [label="PapaPolar: pero ahora es sólo una cosa en papel. y supongo que, dado que ese país dejó de existir alrededor de 1982, tú puedes decidir si todavía cuenta para algo",shape=box,color=blue];
		j1131616269 -> j60622405;
		j1131616269 -> j1335763844;
	j1691812752 [label="PapaPolar: ella echó un vistazo a la scaldra y llamó a las cosas por su nombre. lo vio como lo que era. peligroso. un culto.",shape=box,color=blue];
		j1691812752 -> j3650914049;
	j4273566156 [label="PapaPolar: así que... la criamos como si fuera nuestra. pensamos en ella como nuestra hija, aunque no lo sea.",shape=box,color=blue];
		j4273566156 -> j2821917534;
	j3650914049 [label="PapaPolar: y además, algo que iba a matar a nuestra pequeña niña. pero... le dije que ya no era una niña. ",shape=box,color=blue];
		j3650914049 -> j2955036978;
	j2821917534 [label="PapaPolar: ¿cuándo neci dijo que quería unirse a una facción militar mercenaria y dijo que realmente creían en algo? M se negó.",shape=box,color=blue];
		j2821917534 -> j1691812752;
	j2955036978 [label="PapaPolar: yo... le di mi bendición para que se fuera.",shape=box,color=blue];
		j2955036978 -> j1588635148;
	j1588635148 [label="PapaPolar: le dije a M... que \"tuviera un poco de fe\" ja ja...",shape=box,color=blue];
		j1588635148 -> j4075824017;
	j4075824017 [label="PapaPolar: pensé que tal vez neci había visto algo en ese tipo viktor, que tal vez encontraría a alguien como yo encontré a alguien...",shape=box,color=blue];
		j4075824017 -> j2149251284;
	j2149251284 [label="PapaPolar: en fin.",shape=box,color=blue];
		j2149251284 -> j2602955334;
		j2149251284 -> j3032688819;
		j2149251284 -> j2280489670;
	j2602955334 [label="No es tu culpa.",shape=box,color=red];
		j2602955334 -> j2885578768;
	j3032688819 [label="Oh...",shape=box,color=red];
		j3032688819 -> j4267469410;
	j2280489670 [label="Lo siento mucho.",shape=box,color=red];
		j2280489670 -> j2344110951;
	j2885578768 [label="PapaPolar: gracias, pero yo le dije que subiera a ese barco que se hundía y se hundió. minerva vio los agujeros. yo elegí ignorarlos",shape=box,color=blue];
		j2885578768 -> j3808077967;
	j4267469410 [label="PapaPolar: típico del grande y estúpido de mí, haciendo cosas grandes y estúpidas.",shape=box,color=blue];
