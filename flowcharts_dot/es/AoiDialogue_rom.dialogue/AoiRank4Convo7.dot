		2956 -> 2960;
	2935 [label="¡sí! bueno, para ponerte al día, la música ha sido muy importante aquí desde siempre. los chicos y las chicas se sentaban frente a un piano en lugar de ver la televisión y simplemente creaban.",shape=box,color=blue];
