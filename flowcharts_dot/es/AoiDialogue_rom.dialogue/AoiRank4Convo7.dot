		2962 -> 2963;
	2937 [label="pero imagínalo: ¿crear algo para este mundo nuestro que pueda hacer llorar a la gente? ¿bailar? ¿cantar? para mí es mágico.",shape=box,color=blue];
		2937 -> 2942;
