digraph {
	2825 [label="AoiRank4Convo6 begins.",color=orange];
		2825 -> 2826;
	2826 [label="me has contado tantas historias horribles sobre los orokin... ¿hubo alguna vez alguien que rechazó su forma de vida?",shape=box,color=blue];
		2826 -> 2827;
		2826 -> 2828;
	2827 [label="Lo creas o no, el doctor Albrecht Entrati.",shape=box,color=red];
		2827 -> 2829;
	2828 [label="La mayoría de ellos acabaron muertos, pero Albrecht Entrati lo hizo, a su manera.",shape=box,color=red];
		2828 -> 2830;
	2829 [label="ew.",shape=box,color=blue];
		2829 -> 2831;
	2830 [label="ugh, ese tipo. siempre escapándose de las garras de la muerte.",shape=box,color=blue];
		2830 -> 2831;
	2831 [label="y yo aquí esperando que fuera alguien... genial.",shape=box,color=blue];
		2831 -> 2835;
		2831 -> 2834;
	2835 [label="Lamento decepcionarte. Él es tu hombre. Rechazó el Kuva, lo que les permite ser inmortales. No optó por el brazo largo de moda. Nada de eso.",shape=box,color=red];
		2835 -> 2833;
	2834 [label="Sí, eh... Deja pienso en un orokin genial. Dame un minuto.",shape=box,color=red];
