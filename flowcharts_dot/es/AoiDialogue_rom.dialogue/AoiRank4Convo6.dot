	2871 [label="ugh. ni siquiera el futuro está a salvo de ese tipo.",shape=box,color=blue];
		2871 -> 2872;
		2871 -> 2873;
	2872 [label="Dejó atrás a una hija que todavía está tratando de arreglar las piezas que él rompió. Aunque está enojada, siento que no puede evitar creer en él.",shape=box,color=red];
