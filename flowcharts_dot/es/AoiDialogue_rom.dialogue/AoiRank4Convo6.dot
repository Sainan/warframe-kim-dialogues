		2833 -> 2836;
		2833 -> 2837;
	2832 [label="bueno, estás tú, supongo ^_^",shape=box,color=blue];
		2832 -> 2836;
		2832 -> 2837;
		2832 -> 2838;
	2836 [label="¿Alguna vez respetaste a Entrati?",shape=box,color=red];
		2836 -> 2839;
	2837 [label="¿Qué opinas realmente de Entrati? Más allá del veredicto de que no es \"genial\".",shape=box,color=red];
		2837 -> 2840;
	2838 [label="Jaja, yo no soy un Orokin, solo soy de su imperio. Muy diferente.",shape=box,color=red];
		2838 -> 2841;
	2839 [label="hmm. sacando a relucir las preguntas grandes, ¿eh? supongo que te lo has ganado.",shape=box,color=blue];
		2839 -> 2843;
	2840 [label="ya no me queda ningún respeto que perder por ese tipo ^_^",shape=box,color=blue];
		2840 -> 2843;
	2841 [label="ooooh. confuso",shape=box,color=blue];
		2841 -> 2842;
	2843 [label="a la gente como él solo les gusta fingir ser encantadores cuando le conviene",shape=box,color=blue];
		2843 -> 2844;
		2843 -> 2845;
	2842 [label="sin embargo, realmente nunca me gustó Entrati. la gente como él solo es encantadora cuando les conviene",shape=box,color=blue];
		2842 -> 2844;
		2842 -> 2845;
	2844 [label="¿Qué crees que es lo que busca realmente?",shape=box,color=red];
		2844 -> 2846;
	2845 [label="Entonces en algún momento lo encontraste encantador.",shape=box,color=red];
		2845 -> 2847;
	2846 [label="control. dominación completa.",shape=box,color=blue];
		2846 -> 2848;
	2847 [label="yo no iría tan lejos. más bien, estaba dispuesta a respetarlo.",shape=box,color=blue];
		2847 -> 2849;
	2848 [label="pero no en el estilo divertido de una gira mundial como estrella pop.",shape=box,color=blue];
