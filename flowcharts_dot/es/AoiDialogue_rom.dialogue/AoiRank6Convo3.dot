	j2486866178 [label="para empezar... ¿ML;CG:?",shape=box,color=blue];
		j2486866178 -> j1265058306;
	j382773175 [label="Era una especie de campana de buceo. Hecha de algo llamado seriglás. Abrió la membrana entre los mundos.",shape=box,color=red];
		j382773175 -> j1281402254;
	j1265058306 [label="Muy largo, cero ganas. Quincy me lo enseñó.",shape=box,color=red];
		j1265058306 -> j1917375683;
	j1281402254 [label="Las cosas salieron... mal, por decirlo de algún modo. Entró en pánico, se tambaleó, la cosa se volcó y se golpeó contra el filo afilado de la membrana.",shape=box,color=red];
		j1281402254 -> j2931208690;
	j1917375683 [label="eh...",shape=box,color=blue];
		j1917375683 -> j154773540;
	j2931208690 [label="La campana de seriglás se hizo añicos y él cayó al Vacío.",shape=box,color=red];
		j2931208690 -> j680900134;
	j154773540 [label="espera",shape=box,color=blue];
		j154773540 -> j1085895394;
	j680900134 [label="Y cuando volvió en sí, estaba de vuelta en su laboratorio, sólo que ya no era su laboratorio. Y se miraba a sí mismo. Sólo que no era él mismo. Y \"él\" se llamó a sí mismo con un nombre que sólo su madre sabría.",shape=box,color=red];
		j680900134 -> j2173560467;
	j1085895394 [label="****¡¿TIENES SUS DEDOS?!****",shape=box,color=blue];
		j1085895394 -> j2507835281;
	j2173560467 [label="Entonces, Albrecht corrió para salvar su vida. Se cortó con el pedazo de seriglás y escribió con su propia sangre para que su hija cerrara la membrana tras él",shape=box,color=red];
		j2173560467 -> j2113113092;
	j2507835281 [label="¡¿Y USAS ESO PARA ALIMENTAR TU RAILJACK?!",shape=box,color=blue];
