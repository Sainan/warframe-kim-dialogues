	j972514569 [label="ML;CG: Albrecht entró al Vacío, sintió pánico y terminó robando algunos de los dedos de la Indiferencia.",shape=box,color=red];
		j972514569 -> j2486866178;
	j1842060702 [label="Bueno. Okey. A ver, Albrecht fue... la primera persona en \"descubrir\" cómo entrar al Vacío.",shape=box,color=red];
