	3939 [label="espera",shape=box,color=blue];
		3939 -> 3941;
	3940 [label="Y cuando volvió en sí, estaba de vuelta en su laboratorio, sólo que ya no era su laboratorio. Y se miraba a sí mismo. Sólo que no era él mismo. Y \"él\" se llamó a sí mismo con un nombre que sólo su madre sabría.",shape=box,color=red];
