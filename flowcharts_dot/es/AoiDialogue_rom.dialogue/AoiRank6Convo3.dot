	j984871249 [label="Pero, desafortunadamente, el daño está hecho. Albrecht se llevó los dedos. Y ya no hay vuelta atrás.",shape=box,color=red];
		j984871249 -> j1680806024;
	j42150930 [label="Hay algo sobre los \"Hilos de Khra\". Es súper complicado... Algo... no sé qué sea...",shape=box,color=red];
		j42150930 -> j1718308017;
