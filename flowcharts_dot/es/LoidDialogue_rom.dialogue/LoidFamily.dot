		j2984606967 -> j935748819;
	"Chat ends." [color=orange];
	j935748819 [label="Me aterra lo que debo hacer hasta la médula. De hecho, eso podría ser lo que me quiten cuando me descuarticen en un ataque de ira cuando Gomaitru y su familia descubran lo que ha estado sucediendo bajo sus pies todo este tiempo.",shape=box,color=blue];
		j935748819 -> j3575813285;
	j3575813285 [label="Qué extraño llamarla así ahora; pero mucho ha cambiado entre nosotros. Y mucho más cambiará pronto.",shape=box,color=blue];
		j3575813285 -> j780321366;
		j3575813285 -> j3610540299;
	j780321366 [label="Esto se debió hace tiempo. Estarás bien.",shape=box,color=red];
		j780321366 -> j4015331591;
	j3610540299 [label="Tú puedes hacerlo.",shape=box,color=red];
		j3610540299 -> j4015331591;
	j4015331591 [label="Sí, bueno. Por favor, ven y asegura de que mis entrañas no se usen como decoración festiva en el Necralisk, ¿por favor? Me temo que necesitaré un poco de aseguranza, al fin y al cabo.",shape=box,color=blue];
		j4015331591 -> j937202740;
	j937202740 [label="Boolean LoidFamilyComplete is now true.",color=orange];
