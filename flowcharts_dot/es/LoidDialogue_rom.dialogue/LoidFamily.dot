		j2502471650 -> "Chat ends." [label="false",color=purple];
	j2984606967 [label="Viajero. Debo ceder. Roathe, Marie y Lyon me han convencido de que por fin ha llegado el momento.",shape=box,color=blue];
		j2984606967 -> j935748819;
	j935748819 [label="Me aterra lo que debo hacer hasta la médula. De hecho, eso podría ser lo que me quiten cuando me descuarticen en un ataque de ira cuando Gomaitru y su familia descubran lo que ha estado sucediendo bajo sus pies todo este tiempo.",shape=box,color=blue];
		j935748819 -> j3575813285;
	j3575813285 [label="Qué extraño llamarla así ahora; pero mucho ha cambiado entre nosotros. Y mucho más cambiará pronto.",shape=box,color=blue];
		j3575813285 -> j3595395297;
		j3575813285 -> j4136259357;
	j3595395297 [label="Esto debió hacerse hace mucho tiempo. Estarás bien.",shape=box,color=red];
		j3595395297 -> j2128832942;
	j4136259357 [label="Tú puedes hacerlo.",shape=box,color=red];
		j4136259357 -> j2128832942;
	j2128832942 [label="Sí, bueno. Un favor, ¿podrías venir y asegurarte de que mis entrañas no se usen como decoración festiva en el Necralisk? Me temo que necesitaré un poco de tranquilidad cuando todo esto termine.",shape=box,color=blue];
		j2128832942 -> j937202740;
	j937202740 [label="Boolean LoidFamilyComplete is now true.",color=orange];
