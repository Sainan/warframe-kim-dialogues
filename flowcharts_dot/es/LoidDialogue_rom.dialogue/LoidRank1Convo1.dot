digraph {
	"LoidRank1Convo1 begins." [color=orange];
		"LoidRank1Convo1 begins." -> j695295711;
	j695295711 [label="Viajero. Le pido disculpas por la indiscreción de esta petición. No deseaba contactarlo por este medio, pero la situación se está volviendo crítica y no sabía a quién más acudir.",shape=box,color=blue];
		j695295711 -> j2574153129;
		j695295711 -> j742128489;
	j2574153129 [label="¿POM2_LAB1?",shape=box,color=red];
		j2574153129 -> j3428702592;
	j742128489 [label="¿Quién es...?",shape=box,color=red];
		j742128489 -> j3428702592;
	j3428702592 [label="Ah, sí. Sigue con la configuración predeterminada. Soy Loid. Debería haber... empezado con eso, pero últimamente la situación en el Sanctum Anatomica ha sido un caos.",shape=box,color=blue];
		j3428702592 -> j4057922184;
	j4057922184 [label="Por eso me pongo en contacto con usted. Necesito su ayuda. Tres prototipos han llegado aquí, al Santuario, en mi tiempo. Y no los conocíamos antes.",shape=box,color=blue];
		j4057922184 -> j1538922543;
	j1538922543 [label="Uno de ellos es un",shape=box,color=blue];
		j1538922543 -> j1825112330;
	j1825112330 [label="Pido disculpas",shape=box,color=blue];
		j1825112330 -> j2393223276;
	j2393223276 [label="Uno de ellos es orokin, Viajero.",shape=box,color=blue];
		j2393223276 -> j3426268165;
		j2393223276 -> j3013892568;
		j2393223276 -> j2660613910;
	j3426268165 [label="¿Dónde está Lotus?",shape=box,color=red];
		j3426268165 -> j3947470607;
	j3013892568 [label="Oh, no... ",shape=box,color=red];
		j3013892568 -> j2951299282;
	j2660613910 [label="¡¿Qué?!",shape=box,color=red];
		j2660613910 -> j2951299282;
	j3947470607 [label="Lotus y el operador tienen otros asuntos que atender, créeme. Ya han sido sobrecargados hasta el límite. No te pediría ayuda con estos asuntos si sintiera que tengo a alguien más a quien recurrir.",shape=box,color=blue];
		j3947470607 -> j3091066572;
	j2951299282 [label="No te pediría ayuda con estos asuntos si sintiera que tengo a alguien más a quien recurrir. Pareces ser... el nuevo experto en este tipo de asuntos.",shape=box,color=blue];
		j2951299282 -> j1982199481;
	j3091066572 [label="Usted es... aparentemente el nuevo experto en asuntos de este tipo.",shape=box,color=blue];
		j3091066572 -> j1982199481;
	j1982199481 [label="No sé cómo describirlos mejor. Pero si vienen al Santuario, creo que será difícil no verlos. Dos de ellos han accedido a hablar con usted aquí en el POM-2. Quizás necesiten más pruebas para convencerlos.",shape=box,color=blue];
		j1982199481 -> j1899764319;
	j1899764319 [label="Tengo... fe... que tendrás éxito.",shape=box,color=blue];
