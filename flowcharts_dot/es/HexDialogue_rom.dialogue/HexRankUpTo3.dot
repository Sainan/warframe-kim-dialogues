digraph {
	4 [label="HexRankUpTo3 begins.",color=orange];
		4 -> 85;
	85 [label="Soldja1Shot1kil: digamos que un hombre tiene hambre…",shape=box,color=blue];
		85 -> 86;
	86 [label="H16h V0l7463: ¡Ja! hambrientohambrientoQuincy. sabes, yo tenía un juego de mesa como ese cuando era niño, y apuesto a que podría...",shape=box,color=blue];
		86 -> 87;
		86 -> 88;
		86 -> 89;
	87 [label="¿Almuerzo en equipo?",shape=box,color=red];
		87 -> 188;
	88 [label="La oferta para unirse a mí siempre está abierta.",shape=box,color=red];
		88 -> 189;
	89 [label="Es un gran patio de comidas, únete.",shape=box,color=red];
		89 -> 190;
	188 [label="Update boolean HexTeamLunch",color=orange];
		188 -> 90;
	189 [label="Update boolean HexJoinLunch",color=orange];
		189 -> 90;
	190 [label="Update boolean HexAllLunch",color=orange];
		190 -> 90;
	90 [label="Soldja1Shot1kil: déjenme terminar. digamos que un hombre tiene hambre, pero ese vómito publicitario corporativo sigue sonando en nuestros oídos en ese patio de comidas. ¿qué me dirían si le disparara al hardware y acabara con ese zumbido?",shape=box,color=blue];
		90 -> 91;
	91 [label="xX GLIMMER Xx: ooh ooh déjame aplastarlos. ¡tendré cuidado de no dañar a Zeke! <RETRO_EMOJI_PUMPEDUP> ",shape=box,color=blue];
		91 -> 92;
	92 [label="Belladonna ~{@: ¡Ay, no!
Les dije que tal vez vamos a poner pacientes allí, que vengan de afuera
Sin metralla, sin escombros
Necesito un espacio que esté limpio",shape=box,color=blue];
		92 -> 93;
	93 [label="Salem: Vamos, vamos, querida Lettie. ¿Nadie se ha dado cuenta?",shape=box,color=blue];
		93 -> 94;
	94 [label="Broadsword: ¿Darnos cuenta de qué, El?",shape=box,color=blue];
		94 -> 95;
	95 [label="Salem: No son pacientes los que han rodeado los muros del centro comercial, sino ciudadanos curiosos que parecen sentirse… más seguros por aquí.",shape=box,color=blue];
		95 -> 96;
	96 [label="H16h V0l7463: esperaesperaespera. ¿quieres decir que... realmente estamos haciendo una diferencia?",shape=box,color=blue];
		96 -> 97;
		96 -> 98;
		96 -> 99;
	97 [label="Por supuesto que sí.",shape=box,color=red];
		97 -> 191;
	98 [label="Lo estamos haciendo.",shape=box,color=red];
		98 -> 192;
	99 [label="Me gusta pensar que sí.",shape=box,color=red];
		99 -> 193;
	191 [label="Update boolean HexMakeADiffSure",color=orange];
		191 -> 100;
	192 [label="Update boolean HexMakeADiff",color=orange];
		192 -> 100;
	193 [label="Update boolean HexMakeADiffHope",color=orange];
		193 -> 100;
	100 [label="Broadsword: No somos un mal eq",shape=box,color=blue];
		100 -> 101;
	101 [label="H16h V0l7463: LOVAADECIR",shape=box,color=blue];
		101 -> 102;
	102 [label="Broadsword: ...Equipo.",shape=box,color=blue];
		102 -> 103;
	103 [label="Soldja1Shot1kil: más bocas que alimentar... ¿aunque Su Majestad piense que estamos bien y cómodos? no es una buena idea",shape=box,color=blue];
		103 -> 104;
	104 [label="Salem: Podría hacer que se fueran. Solo con un pensamiento…",shape=box,color=blue];
		104 -> 105;
	105 [label="xX GLIMMER Xx: no puedo evitar sentir que... aunque hagamos nuestro mejor esfuerzo, ¿para que darle a la gente la falsa esperanza de que podemos salvarlos? no va a terminar bien para nadie.",shape=box,color=blue];
		105 -> 106;
		105 -> 107;
		105 -> 108;
	106 [label="¿Y si no fuera falsa?",shape=box,color=red];
		106 -> 194;
	107 [label="Quizás de eso se trate: de saber que PODEMOS cambiar las cosas.",shape=box,color=red];
		107 -> 195;
	108 [label="Cuanta más gente aquí, ahora mismo, sienta esperanza, mejor.",shape=box,color=red];
		108 -> 196;
	194 [label="Update boolean HexGiveComfort",color=orange];
		194 -> 109;
	195 [label="Update boolean HexGiveAssurance",color=orange];
		195 -> 109;
	196 [label="Update boolean HexGiveHope",color=orange];
		196 -> 109;
	109 [label="H16h V0l7463: hmm, no es por ser pesimista, pero tengo la sensación de que estaríamos invitando a más personas a la fiesta de la decepción.",shape=box,color=blue];
		109 -> 110;
	110 [label="Salem: Pero ¿no deberíamos inclinar la balanza del destino? Incluso un pequeño cambio en la balanza podría ser de lo más interesante.",shape=box,color=blue];
		110 -> 111;
	111 [label="Belladonna ~{@: Seguro y luego a mí me tocan las narices que moquean y las amputaciones
Mi tía siempre decía \"no hay que tomar decisiones importantes con la panza vacía\"
Nos vemos en la zona de comida y decidimos qué hacer",shape=box,color=blue];
		111 -> 112;
	112 [label="xX GLIMMER Xx: <RETRO_EMOJI_HAPPY2> ¡oooh! ¡almuerzo de equipo!",shape=box,color=blue];
		112 -> 113;
	113 [label="Broadsword: Almuerzo de equipo.",shape=box,color=blue];
		113 -> 114;
	114 [label="Soldja1Shot1kil: estoy dentro y de nada por organizar esto",shape=box,color=blue];
		114 -> 115;
		114 -> 116;
		114 -> 117;
	115 [label="Me alegro de que todos estemos haciendo algo juntos.",shape=box,color=red];
		115 -> 197;
	116 [label="Protejámoslos y los unos a los otros.",shape=box,color=red];
		116 -> 198;
	117 [label="Gracias Quincy, gracias a todos. Creo que es momento de unirnos.",shape=box,color=red];
		117 -> 199;
