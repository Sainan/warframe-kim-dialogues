		"HexRankUpTo1 begins." -> j4103617525;
	j4103617525 [label="Broadsword: Estamos atrapados aquí, ¿entienden? Así que limpien lo que ensucian: el área de comida está más sucio que la calle. Esto no es un maldito zoológico.",shape=box,color=blue];
