	j2413497348 [label="H16h V0l7463: ¿a qué te refieres con que tienes un MALDITO ROBOT DE LIMPIEZA?",shape=box,color=blue];
		j2413497348 -> j1473218517;
	j1473218517 [label="Broadsword: Bien. Pero Aoi lo convertirá en chatarra si me mantiene despierto.",shape=box,color=blue];
		j1473218517 -> j769922456;
	j769922456 [label="Soldja1Shot1kil: nah, voy a practicar mis disparos con él, compa",shape=box,color=blue];
		j769922456 -> j1766982410;
	j1766982410 [label="Belladonna ~{@: Arthur está diciendo lo que estaba pesando\nLimpien cuando terminen\nPuede que llegue un momento en el que usemos el área de comida como sala de operaciones\n¿Entendieron?",shape=box,color=blue];
		j1766982410 -> j2417125697;
	j2417125697 [label="Salem: Vaya, Lettie, ten un poco de optimismo. Tenemos un nuevo jugador en el equipo.",shape=box,color=blue];
		j2417125697 -> j4080277354;
	j4080277354 [label="xX GLIMMER Xx: ¿verdad? ¡optimismo! ¡cierto! entonces, Viajero, tienes una visión nueva. ¿qué opinas del área de comida? <RETRO_EMOJI_FOOD>",shape=box,color=blue];
		j4080277354 -> j1772780230;
		j4080277354 -> j403402768;
	j1772780230 [label="Parece que hay suficiente espacio para que todos podamos comer allí.",shape=box,color=red];
		j1772780230 -> j2596765317;
	j403402768 [label="Me recuerda a algo, a poder tener un lugar donde comer y divertirse, casi.",shape=box,color=red];
