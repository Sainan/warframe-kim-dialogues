	edge [fontname="Roboto Condensed"];

	"MarieRank3Convo6 begins." [color=orange];
		"MarieRank3Convo6 begins." -> j2599877783;
	j2599877783 [label="Boolean MarieLyonAvailable is now true.",color=orange];
		j2599877783 -> j527377641;
	j527377641 [label="Debo preguntarle algo, y te debo implorar que no me juzgues por ello, Viajero.",shape=box,color=blue];
		j527377641 -> j3855396852;
		j527377641 -> j3580355413;
		j527377641 -> j202800200;
	j3855396852 [label="Te metieron en una situación extraña. Claro que no te juzgaré.",shape=box,color=red];
		j3855396852 -> j170399503;
	j3580355413 [label="Lo haré lo mejor que pueda.",shape=box,color=red];
		j3580355413 -> j4009484220;
	j202800200 [label="[Fin]",shape=box,color=red];
		j202800200 -> "Chat ends.";
	j170399503 [label="Vraiment gentil de tu parte concederme tal gracia sin conocerme o sin saber que es lo que estaba a punto de escribirte.",shape=box,color=blue];
		j170399503 -> j1095236226;
	j4009484220 [label="+10 Chemistry",color=orange];
		j4009484220 -> j773060485;
	"Chat ends." [color=orange];
	j1095236226 [label="Pero... ¿el pez parlante de cabeza grande también te da dolor de cabeza? ¿Fibonacci?",shape=box,color=blue];
		j1095236226 -> j12956700;
		j1095236226 -> j1605979251;
		j1095236226 -> j1276916340;
	j773060485 [label="Lo aprecio, gracias.",shape=box,color=blue];
		j773060485 -> j1095236226;
	j12956700 [label="Sí. Sí, por supuesto. Gracias.",shape=box,color=red];
		j12956700 -> j3470686747;
	j1605979251 [label="La idea de que Fibonacci te moleste es increíblemente adorable.",shape=box,color=red];
		j1605979251 -> j3773933429;
	j1276916340 [label="No, en realidad lo adoro.",shape=box,color=red];
		j1276916340 -> j2354028197;
	j3470686747 [label="Entonces me alegra no estar sola. Pero, para ser claros, no le quiero faltar al respeto. Si me siento mal por mi situación actual, me imagino que él lo aguanta lo mejor que puede.",shape=box,color=blue];
		j3470686747 -> j2412349524;
	j3773933429 [label="¿Sí? ¿Y cómo es eso? Supongo que me alegra, pero simplemente no entiendo por qué. Mi dolor de cabeza no se acerca ni por poco a ser encantador.",shape=box,color=blue];
		j3773933429 -> j2103317312;
		j3773933429 -> j1688680309;
	j2354028197 [label="Entonces sólo puedo rogar por tu perdón, no le quiero faltar al respeto. Si me siento mal por mi situación actual, me imagino que él lo aguanta lo mejor que puede.",shape=box,color=blue];
		j2354028197 -> j2391344283;
	j2412349524 [label="Sus maneras de hacerlo simplemente no van conmigo cuando estoy sometida a ello durante mucho tiempo, eso es todo.",shape=box,color=blue];
		j2412349524 -> j3359278970;
	j2103317312 [label="Pasó la mayoría del tiempo peleando por mi vida. Pequeños recordatorios de humanidad como estos son... en cierto modo mi razón de ser.",shape=box,color=red];
		j2103317312 -> j2854527447;
	j1688680309 [label="Supongo que de vez en cuando tengo que dar un pasó atrás y reflexionar en lo absurdo que es todo esto. Un Norg y una sacerdotisa del Sol...",shape=box,color=red];
		j1688680309 -> j3786478989;
	j2391344283 [label="Sus maneras de hacerlo simplemente no van conmigo cuando estoy sometida a ello durante mucho tiempo, eso es todo.",shape=box,color=blue];
		j2391344283 -> j3359278970;
	j3359278970 [label="Ja. No debería estarme quejando. Debo traerle su cena a Lyon esta noche, una vez más se encuentra acostado con una hemicránea terrible.",shape=box,color=blue];
		j3359278970 -> j2448819962;
		j3359278970 -> j1004142943;
	j2854527447 [label="+5 Chemistry",color=orange];
		j2854527447 -> j766566908;
	j3786478989 [label="+5 Chemistry",color=orange];
		j3786478989 -> j3077135829;
	j2448819962 [label="¿Las tiene a menudo?",shape=box,color=red];
		j2448819962 -> j2185066823;
	j1004142943 [label="Perdóname... ¿Una qué?",shape=box,color=red];
		j1004142943 -> j426645875;
	j766566908 [label="Nunca pierdas esa parte de ti, Viajero. Jamás dejes ir esa parte de ti que busca esas chispas de vida.",shape=box,color=blue];
		j766566908 -> j3207716130;
	j3077135829 [label="Santo cielo, cuando lo pones así, no me extraña. Suena como una de esas bromas infantiles, n'est-ce pas ?",shape=box,color=blue];
		j3077135829 -> j212312358;
	j2185066823 [label="Oui, oui. ¿Una cada pocas semanas? ¿Una cada dos meses? El periodo más largo sin que tuviera una es de seis meses, quizás.",shape=box,color=blue];
		j2185066823 -> j547018639;
	j426645875 [label="¡Oh! Cielos. Mmm. Piensa en un dolor de cabeza, pero mucho más intenso. He escuchado que otros lo llaman dolores de cabeza con náuseas. Son más comúnes en las mujeres.",shape=box,color=blue];
		j426645875 -> j2589238730;
		j426645875 -> j3681829193;
	j3207716130 [label="El mundo está demasiado ansioso por convertirse en un lugar oscuro y serio. Está bastante dispuesto a imponernos sufrimiento a cada paso.",shape=box,color=blue];
		j3207716130 -> j2214906871;
	j212312358 [label="Una hermana, un sacerdote y un demonio del futuro son enviados al pasado... y luego al futuro... y conocen a un pez, a una cosa con forma de venado, un ave gigante y un mayordomo...",shape=box,color=blue];
		j212312358 -> j683623864;
	j547018639 [label="Check boolean Megrim",color=orange];
		j547018639 -> j1167386327 [label=true,color=green];
		j547018639 -> j1723419122 [label=true,color=green];
		j547018639 -> j3545149879 [label=true,color=green];
		j547018639 -> j1167386327 [label=false,color=brown];
		j547018639 -> j1723419122 [label=false,color=brown];
		j547018639 -> j2373996969 [label=false,color=brown];
	j2589238730 [label="Creo que ahora las llamamos \"migrañas\".",shape=box,color=red];
		j2589238730 -> j3530195591;
	j3681829193 [label="Vaya. Hemicráneas. Gracias.",shape=box,color=red];
		j3681829193 -> j3588790090;
	j2214906871 [label="Debemos buscar todo el brillo, cualquier levedad que podamos, incluso en forma de inmadurez si es necesario.",shape=box,color=blue];
		j2214906871 -> j2655026186;
	j683623864 [label="¡Es bastante divertido, tienes toda la razón!",shape=box,color=blue];
		j683623864 -> j3565107504;
	j1167386327 [label="Me pregunto qué las causa.",shape=box,color=red];
		j1167386327 -> j251515778;
	j1723419122 [label="Eso suena horrible...",shape=box,color=red];
		j1723419122 -> j2205888144;
	j3545149879 [label="A mí también me dan hemicráneas. Son terribles.",shape=box,color=red];
		j3545149879 -> j1614402619;
	j2373996969 [label="A mi también me dan ese tipo de dolores de cabeza. Son terribles.",shape=box,color=red];
		j2373996969 -> j1614402619;
	j3530195591 [label="¡Me pregunto que otras particularités históricas fascinantes descubriremos! Qué emocionante. Amo aprender cosas nuevas. \"Migrañas\". El camino continúa.",shape=box,color=blue];
		j3530195591 -> j3370424306;
	j3588790090 [label="Boolean Megrim is now true.",color=orange];
		j3588790090 -> j3754856319;
	j2655026186 [label="Ojalá Lyon lo viera de la misma manera.",shape=box,color=blue];
		j2655026186 -> j1801037987;
	j3565107504 [label="Si sólo mi querido Lyon pudiera ver el brillo en eso de la misma manera.",shape=box,color=blue];
		j3565107504 -> j1801037987;
	j251515778 [label="Tiene sus teorías. ",shape=box,color=blue];
		j251515778 -> j3781724093;
	j2205888144 [label="Si le expresaras tu apoyo, estoy segura de que lo aceptaría. Y a pesar de como pueda verse, él apreciaría la compañía.",shape=box,color=blue];
		j2205888144 -> j1024784227;
	j1614402619 [label="¿También? Le deberías de decir a Lyon. Necesita saber que otros son capaces de sufrir de una manera similar.",shape=box,color=blue];
		j1614402619 -> j982455117;
	j3370424306 [label="Boolean Migraine is now true.",color=orange];
		j3370424306 -> j3754856319;
	j3754856319 [label="No importa el nombre que tenga, Lyon está postrado con una y lo estará hasta la mañana. Pobre hombre no puede ver nada más que borroso, no siente sus manos o sus pies. Y me dice que el dolor es insoportable.",shape=box,color=blue];
		j3754856319 -> j547018639;
	j1801037987 [label="Boolean MarieLyonSuffering1 is now true.",color=orange];
		j1801037987 -> j1424312281;
	j3781724093 [label="Aunque quizá sea más correcto decir que tenía sus teorías, hasta hace poco.",shape=box,color=blue];
		j3781724093 -> j372481038;
	j1024784227 [label="Aunque su actitud intente disuadirte, te imploro que te mantengas firme, Viajero. Hay un hombre con una gran necesidad enterrado en lo que parece ser un exterior estoico y frío.",shape=box,color=blue];
		j1024784227 -> j3695416422;
		j1024784227 -> j1740820631;
		j1024784227 -> j3448478115;
	j982455117 [label="+5 Chemistry",color=orange];
		j982455117 -> j481801520;
	j1424312281 [label="Ah, hablando de eso. Me siento terrible por estarme quejando sobre dolores de cabeza. Le debo traer a Lyon su cena esta noche, está una vez más acostado con una hemicránea terrible.",shape=box,color=blue];
		j1424312281 -> j1004142943;
		j1424312281 -> j2448819962;
	j372481038 [label="Boolean MarieLyonFaith1 is now true.",color=orange];
		j372481038 -> j1024784227;
	j3695416422 [label="Puedo ser muy terco, no te preocupes.",shape=box,color=red];
		j3695416422 -> j1919639706;
	j1740820631 [label="Ya tengo un hombre en la pared... ¿Por qué no dos?",shape=box,color=red];
		j1740820631 -> j2784997231;
	j3448478115 [label="Es un adulto. Si quiere hablar, puede hacerlo.",shape=box,color=red];
		j3448478115 -> j2115896437;
	j481801520 [label="Las Luminarias saben que de lo contrario él sufriría voluntariamente solo...",shape=box,color=blue];
		j481801520 -> j2838262979;
	j1919639706 [label="+5 Chemistry",color=orange];
		j1919639706 -> j813029709;
	j2784997231 [label="Bromea conmigo de esa manera, pero no le hagas esos comentarios a él. El tema de tu Indiferencia es algo delicado para él.",shape=box,color=blue];
		j2784997231 -> j2070136591;
	j2115896437 [label="Ya es un adulto, sí. Es un hombre, sí. Y creo que él quiere hablar. Pero te reto a que te preguntes si él puede hablar.",shape=box,color=blue];
		j2115896437 -> j3167663700;
	j2838262979 [label="Boolean MarieLyonSuffering2 is now true.",color=orange];
		j2838262979 -> j1024784227;
	j813029709 [label="Me temo que lo necesitarás con él. Gracias, Viajero. Es mi más querido amigo, y como un hermano para mí. Y me rompe el corazón verlo con tal dolor.",shape=box,color=blue];
		j813029709 -> j3851397455;
	j2070136591 [label="Sé resiliente. Y paciente. Y amable. Es como un hermano para mí y es mi más querido amigo, Viajero. Y me rompe el corazón verlo con tal dolor.",shape=box,color=blue];
		j2070136591 -> j3851397455;
	j3167663700 [label="No todos fuimos bendecidos de la misma manera o sentimos que somos merecedores de tales cosas. Sufre y cree que es su destino sufrir.",shape=box,color=blue];
		j3167663700 -> j3319565012;
	j3851397455 [label="Hablaremos de nuevo pronto. Par la grâce de Sol.",shape=box,color=blue];
		j3851397455 -> "Initiate conversation LyonHeadaches in /Lotus/Types/Gameplay/1999Wf/Dialogue/LyonDialogue_rom.dialogue";
	j3319565012 [label="También es como un hermano para mí y es mi amigo más querido. Y mi corazón se rompe en pedazos por él. Así que sólo puedo pedirte que... seas paciente. Y sé amable. Si puedes.",shape=box,color=blue];
		j3319565012 -> j3851397455;
	"Initiate conversation LyonHeadaches in /Lotus/Types/Gameplay/1999Wf/Dialogue/LyonDialogue_rom.dialogue" [label="Initiate conversation LyonHeadaches in /Lotus/Types/Gameplay/1999Wf/Dialogue/LyonDialogue_rom.dialogue",color=orange];
		"Initiate conversation LyonHeadaches in /Lotus/Types/Gameplay/1999Wf/Dialogue/LyonDialogue_rom.dialogue" -> "Chat ends.";
}