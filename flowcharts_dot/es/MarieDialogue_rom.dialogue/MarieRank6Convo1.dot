	3304 [label="Y me pregunto: ¿Es esto lo que la Indiferencia quiere destruir? ¿Es esto lo que la Indiferencia consume? ¿Ese poder de otros para influir en otros?",shape=box,color=blue];
		3304 -> 3321;
	3309 [label="Le has traído tanta paz al hermano de mi alma. Lo has convencido de que tenemos un verdadero enemigo contra el que luchar, y le has dado esperanza.",shape=box,color=blue];
		3309 -> 3329;
	3310 [label="Le has traído a mi hermano del alma consuelo y una cierta paz que antes no tenía. Creo que tu compañía ha significado más para él de lo que puede expresar.",shape=box,color=blue];
		3310 -> 3329;
	3311 [label="Aunque quizá nunca sepamos qué es realmente la Indiferencia, sabemos que no importa. Debemos afrontarla como el desafío que plantea, que es real.",shape=box,color=blue];
		3311 -> 3329;
	3312 [label="No pensé se pudiera convencer a nuestro diablo de ayudar a Monsieur Loid y a la familia del Cardenal a reconectarse. Sé que sus razones son... dudosas, quizás, y sigo sin confiar plenamente en él. ",shape=box,color=blue];
		3312 -> 3330;
	3313 [label="No pensé que a nuestro diablo se le pudiera hacer comprender sus errores. Que pudiera arrepentirse siquiera de las vidas inocentes que ha sacrificado. Me demostraste que estaba equivocada.",shape=box,color=blue];
		3313 -> 3331;
	3314 [label="Cualesquiera que sean las cadenas que usas con nuestro diablo, lo mantienen atado. Parece más... calmado que antes. Y es gracias a ti.",shape=box,color=blue];
		3314 -> 3331;
	3315 [label="Los recuerdos que le hemos ayudado a recuperar parecen haberlo calmado. Quizás recordar el dolor por todos los que perdió le haya hecho pensar en los que aún podría perder.",shape=box,color=blue];
		3315 -> 3331;
	3316 [label="Quizás sea su cariño por ti lo que lo calma, no lo sé. Sea cual sea la razón, sé que es gracias a ti.",shape=box,color=blue];
		3316 -> 3331;
	3308 [label="No guardo ningún rencor hacia ti y solo me alegro por ambos, oui ?",shape=box,color=blue];
		3308 -> 3327;
		3308 -> 3328;
	3306 [label="Las cosas han cambiado y... tengo que permanecer fiel, lo siento.",shape=box,color=red];
		3306 -> 3325;
	3307 [label="Puede que sea difícil de creer, o incluso de aceptar, lo sé. Pero... te amo. Y los amo a ellos. En igual medida.",shape=box,color=red];
		3307 -> 3326;
