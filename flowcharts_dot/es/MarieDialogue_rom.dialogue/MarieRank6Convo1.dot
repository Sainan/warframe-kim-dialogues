		j3699890413 -> j1482223254 [label="RoatheDating",color=purple];
	j821167684 [label="Es otra historia cuando se trata del hermano de mi alma o del diablo con quien tengo que luchar a diario.",shape=box,color=blue];
		j821167684 -> j1974257875;
	j2506613743 [label="Que Sol los bendiga a ustedes y a sus corazones. ¡Me siento bendecida por estar entre aquellos a quienes llamas amigos!",shape=box,color=blue];
		j2506613743 -> j2465422711;
