	j566250356 [label="Claro, ¿qué pasa?",shape=box,color=red];
		j566250356 -> j677649891;
	j2657230895 [label="[Confiesar sentimientos.] Es un buen momento, también tengo algo que me gustaría decirte... ",shape=box,color=red];
		j2657230895 -> j2836430127;
	j858689494 [label="Pienso en cuánto tiempo hemos pasado juntos. Qué poco ha sido, en comparación con todos los años que has vivido.",shape=box,color=blue];
		j858689494 -> j2326823322;
	"Chat ends." [color=orange];
	j2507557468 [label="Has sido una amistad tan buena y amable. Y nuestra alianza ha sido tan valiosa que ni siquiera podría haber rezado por algo así. ",shape=box,color=blue];
		j2507557468 -> j3352154434;
	j170903821 [label="Oui, y creo que lo prefieres así, non ? ¡Ja! No quiero imaginarme al diablo de esa manera, ¡en fin! No he venido a hablar de eso.",shape=box,color=blue];
		j170903821 -> j3470333215;
	j1864957210 [label="Evaluate expressions",color=orange];
		j1864957210 -> j2747671285 [label="RoatheDating",color=purple];
		j1864957210 -> j2747671285 [label="LyonDating",color=purple];
		j1864957210 -> j2093157936 [label="IsDating",color=purple];
		j1864957210 -> j2157780372 [label="false",color=purple];
	j677649891 [label="Pienso en cuánto tiempo hemos pasado juntos. Qué poco ha sido, en comparación con todos los años que has vivido.",shape=box,color=blue];
		j677649891 -> j2836153316;
	j2836430127 [label="¡Non, déjame hablar primero, perderé el valor si no lo hago!",shape=box,color=blue];
		j2836430127 -> j1471879296;
	j2326823322 [label="Pero pienso en lo mucho que han significado para mí. En lo mucho que me han cambiado a mí y al curso de mi vida, como un barco en el mar.",shape=box,color=blue];
		j2326823322 -> j3009490879;
	j3352154434 [label="Evaluate expressions",color=orange];
		j3352154434 -> j760338925 [label="LyonFaith3Yes",color=purple];
		j3352154434 -> j4165039524 [label="LyonFaith3No",color=purple];
		j3352154434 -> j4054915052 [label="LyonFaith3Maybe",color=purple];
		j3352154434 -> j4054915052 [label="false",color=purple];
	j3470333215 [label="Evaluate expressions",color=orange];
		j3470333215 -> j1784702241 [label="LoidFamilyComplete",color=purple];
		j3470333215 -> j1339561547 [label="RoatheRedeemed",color=purple];
		j3470333215 -> j3028980143 [label="RoatheVillain",color=purple];
		j3470333215 -> j3879349012 [label="RoatheHellComplete",color=purple];
		j3470333215 -> j1834120287 [label="false",color=purple];
	j2747671285 [label="Sé que una vez dijiste que sentías algo por mí. Sin embargo, ahora te veo con alguien más. ¡Solo quería decirte que me alegro por ti!",shape=box,color=blue];
		j2747671285 -> j958237656;
	j2093157936 [label="Una vez me dijiste que... ay, ni siquiera sé cómo expresarlo con palabras. Que sentías algo por mí. Pero sé que tienes a alguien más.",shape=box,color=blue];
		j2093157936 -> j4102432144;
		j2093157936 -> j466926558;
	j2157780372 [label="Una vez me dijiste que... ay, ni siquiera sé cómo expresarlo con palabras. Que sentías algo por mí.",shape=box,color=blue];
		j2157780372 -> j1928846357;
	j2836153316 [label="Pero pienso en lo mucho que han significado para mí. En lo mucho que me han cambiado a mí y al curso de mi vida, como un barco en el mar.",shape=box,color=blue];
		j2836153316 -> j674569178;
	j1471879296 [label="Evaluate expressions",color=orange];
		j1471879296 -> j4050100580 [label="MarieNoDate",color=purple];
		j1471879296 -> j2314777629 [label="MarieWillDate",color=purple];
		j1471879296 -> j4050100580 [label="false",color=purple];
	j3009490879 [label="Y me pregunto: ¿Es esto lo que la Indiferencia quiere destruir? ¿Es esto lo que la Indiferencia consume? ¿Ese poder de otros para influir en otros?",shape=box,color=blue];
		j3009490879 -> j2236293601;
	j760338925 [label="Le has traído tanta paz al hermano de mi alma. Lo has convencido de que tenemos un verdadero enemigo contra el que luchar, y le has dado esperanza.",shape=box,color=blue];
		j760338925 -> j2794860804;
	j4165039524 [label="Le has traído a mi hermano del alma consuelo y una cierta paz que antes no tenía. Creo que tu compañía ha significado más para él de lo que puede expresar.",shape=box,color=blue];
		j4165039524 -> j2794860804;
	j4054915052 [label="Aunque quizá nunca sepamos qué es realmente la Indiferencia, sabemos que no importa. Debemos afrontarla como el desafío que plantea, que es real.",shape=box,color=blue];
		j4054915052 -> j2794860804;
	j1784702241 [label="No pensé se pudiera convencer a nuestro diablo de ayudar a Monsieur Loid y a la familia del Cardenal a reconectarse. Sé que sus razones son... dudosas, quizás, y sigo sin confiar plenamente en él. ",shape=box,color=blue];
		j1784702241 -> j2202654598;
	j1339561547 [label="No pensé que a nuestro diablo se le pudiera hacer comprender sus errores. Que pudiera arrepentirse siquiera de las vidas inocentes que ha sacrificado. Me demostraste que estaba equivocada.",shape=box,color=blue];
		j1339561547 -> j1421245194;
	j3028980143 [label="Cualesquiera que sean las cadenas que usas con nuestro diablo, lo mantienen atado. Parece más... calmado que antes. Y es gracias a ti.",shape=box,color=blue];
		j3028980143 -> j1421245194;
	j3879349012 [label="Los recuerdos que le hemos ayudado a recuperar parecen haberlo calmado. Quizás recordar el dolor por todos los que perdió le haya hecho pensar en los que aún podría perder.",shape=box,color=blue];
		j3879349012 -> j1421245194;
	j1834120287 [label="Quizás sea su cariño por ti lo que lo calma, no lo sé. Sea cual sea la razón, sé que es gracias a ti.",shape=box,color=blue];
		j1834120287 -> j1421245194;
	j958237656 [label="No guardo ningún rencor hacia ti y solo me alegro por ambos, oui ?",shape=box,color=blue];
		j958237656 -> j1609508354;
		j958237656 -> j266924667;
	j4102432144 [label="Las cosas han cambiado y... tengo que permanecer fiel, lo siento.",shape=box,color=red];
		j4102432144 -> j1304585251;
	j466926558 [label="Puede que sea difícil de creer, o incluso de aceptar, lo sé. Pero... te amo. Y los amo a ellos. En igual medida.",shape=box,color=red];
		j466926558 -> j3734127592;
	j1928846357 [label="Evaluate expressions",color=orange];
		j1928846357 -> j2201059124 [label="MarieNoDate",color=purple];
		j1928846357 -> j2039633616 [label="MarieWillDate",color=purple];
		j1928846357 -> j549668576 [label="MarieWillDate",color=purple];
		j1928846357 -> j2201059124 [label="false",color=purple];
	j674569178 [label="Y me pregunto: ¿Es esto lo que la Indiferencia quiere destruir? ¿Es esto lo que la Indiferencia consume? ¿Ese poder de otros para influir en otros?",shape=box,color=blue];
		j674569178 -> j4271716459;
	j4050100580 [label="Me temo que estás a punto de decirme algo de lo que no podrás retractarte. Y eso cambiará las cosas entre nosotros para siempre.",shape=box,color=blue];
		j4050100580 -> j1725956268;
	j2314777629 [label="Mon cœur t'appartient depuis notre première rencontre...",shape=box,color=blue];
		j2314777629 -> j2525151666;
		j2314777629 -> j2822781970;
	j2236293601 [label="El don de hacernos reír. De llorar. De convencernos de verdades o mentiras. De cambiar de opinión. De animarnos cuando algo nos lastima. De herirnos en un momento de locura.",shape=box,color=blue];
		j2236293601 -> j2887494651;
	j2794860804 [label="¿Y cuál es la diferencia, cuando tú estás allí para guiar a Lyon en las horas más oscuras y sostenerlo en sus momentos de dolor y agonía?",shape=box,color=blue];
		j2794860804 -> j3286875145;
	j2202654598 [label="Los resultados son, sin duda, gracias a ti. Roathe está aquí y protege a la familia del le Cardinal gracias a ti.",shape=box,color=blue];
		j2202654598 -> j1421245194;
	j1421245194 [label="Y sé que nuestro diablo no es nuestro enemigo, oui ? Es la Indiferencia. ¿Y qué nos enseña la Indiferencia, sino aferrarnos a todo lo que rechaza, a todo lo que destruye ?",shape=box,color=blue];
		j1421245194 -> j1993418312;
	j1609508354 [label="Pero... qué tal si ",shape=box,color=red];
		j1609508354 -> j1832832397;
	j266924667 [label="Yo también siento algo por ti, Marie.",shape=box,color=red];
		j266924667 -> j301083216;
	j1304585251 [label="Oui, lo entiendo. ¡Claro que lo entiendo! ¿Cómo podría culparte por seguir a tu alma?",shape=box,color=blue];
		j1304585251 -> j387616460;
	j3734127592 [label="Evaluate expressions",color=orange];
		j3734127592 -> j2201059124 [label="MarieNoDate",color=purple];
		j3734127592 -> j4174779115 [label="MarieWillDate",color=purple];
		j3734127592 -> j2201059124 [label="false",color=purple];
	j2201059124 [label="No sé cómo decir esto sin ser cruel así que... simplemente lo diré.",shape=box,color=blue];
		j2201059124 -> j2322526824;
	j2039633616 [label="Sí. Yo... ¿supongo que no sientes lo mismo?",shape=box,color=red];
		j2039633616 -> j783128902;
	j549668576 [label="Las cosas han cambiado y... lo siento.",shape=box,color=red];
		j549668576 -> j2357242154;
	j4271716459 [label="El don de hacernos reír. De llorar. De convencernos de verdades o mentiras. De cambiar de opinión. De animarnos cuando algo nos lastima. De herirnos en un momento de locura.",shape=box,color=blue];
		j4271716459 -> j2582080170;
	j1725956268 [label="Y me duele, oh, cómo me duele tener que detenerte antes de que lo hagas.",shape=box,color=blue];
		j1725956268 -> j347271974;
	j2525151666 [label="Yo... no sé qué significa eso, Marie.",shape=box,color=red];
		j2525151666 -> j3801555402;
	j2822781970 [label="Mon cœur t'appartient également, Marie !",shape=box,color=red];
		j2822781970 -> j3026173952;
	j2887494651 [label="Darnos placer mutuamente cuando estamos enamorados. Provocarnos agonía cuando estamos perdidos en el odio. Este es el don de la humanidad; esto es lo que la Indiferencia no es.",shape=box,color=blue];
		j2887494651 -> j3595498456;
	j3286875145 [label="¿Qué nos enseña la Indiferencia, sea cual sea su origen, sino aferrarnos a todo lo que rechaza, a todo lo que destruye?",shape=box,color=blue];
		j3286875145 -> j1872180202;
	j1993418312 [label="Pienso en cuánto tiempo hemos pasado juntos. Qué poco ha sido, en comparación con todos los años que has vivido.",shape=box,color=blue];
		j1993418312 -> j2809781157;
	j1832832397 [label="¿En lugar de eso? Entonces... Me temo que primero debes desenredar los hilos de tu propio corazón, Viajero. No puedo hacerlo por ti.",shape=box,color=blue];
		j1832832397 -> j3699890413;
	j301083216 [label="Y bien podría ser así. No soy celosa, pero una cosa es saber que alguien ya ha conquistado tu corazón, cuando no lo conozco...",shape=box,color=blue];
		j301083216 -> j821167684;
	j387616460 [label="+10 Chemistry",color=orange];
		j387616460 -> j2506613743;
	j4174779115 [label="Yo - oh ! Oh, mon cœur !",shape=box,color=blue];
		j4174779115 -> j3810122069;
	j2322526824 [label="Me temo... que deberías simplemente intentarlo con otro. Lo que sientes por mí, yo no lo siento por ti. Perdóname.",shape=box,color=blue];
		j2322526824 -> j884119375;
	j783128902 [label="Yo - oh ! Oh, mon cœur !",shape=box,color=blue];
