	3291 [label="Has sido una amistad tan buena y amable. Y nuestra alianza ha sido tan valiosa que ni siquiera podría haber rezado por algo así. ",shape=box,color=blue];
		3291 -> 3299;
	3292 [label="Oui, y creo que lo prefieres así, non ? ¡Ja! No quiero imaginarme al diablo de esa manera, ¡en fin! No he venido a hablar de eso.",shape=box,color=blue];
