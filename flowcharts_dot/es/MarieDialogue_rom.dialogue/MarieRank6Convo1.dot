	3303 [label="Y me pregunto: ¿Es esto lo que la Indiferencia quiere destruir? ¿Es esto lo que la Indiferencia consume? ¿Ese poder de otros para influir en otros?",shape=box,color=blue];
		3303 -> 3320;
	3302 [label="Me temo que estás a punto de decirme algo de lo que no podrás retractarte. Y eso cambiará las cosas entre nosotros para siempre.",shape=box,color=blue];
		3302 -> 3319;
	3301 [label="Mon cœur t'appartient depuis notre première rencontre...",shape=box,color=blue];
		3301 -> 3317;
		3301 -> 3318;
	3321 [label="El don de hacernos reír. De llorar. De convencernos de verdades o mentiras. De cambiar de opinión. De animarnos cuando algo nos lastima. De herirnos en un momento de locura.",shape=box,color=blue];
		3321 -> 3336;
	3329 [label="¿Y cuál es la diferencia, cuando tú estás allí para guiar a Lyon en las horas más oscuras y sostenerlo en sus momentos de dolor y agonía?",shape=box,color=blue];
		3329 -> 3343;
	3330 [label="Los resultados son, sin duda, gracias a ti. Roathe está aquí y protege a la familia del le Cardinal gracias a ti.",shape=box,color=blue];
		3330 -> 3331;
	3331 [label="Y sé que nuestro diablo no es nuestro enemigo, oui ? Es la Indiferencia. ¿Y qué nos enseña la Indiferencia, sino aferrarnos a todo lo que rechaza, a todo lo que destruye ?",shape=box,color=blue];
		3331 -> 3344;
