	3298 [label="Sé que una vez dijiste que sentías algo por mí. Sin embargo, ahora te veo con alguien más. ¡Solo quería decirte que me alegro por ti!",shape=box,color=blue];
		3298 -> 3308;
	3297 [label="Una vez me dijiste que... ay, ni siquiera sé cómo expresarlo con palabras. Que sentías algo por mí. Pero sé que tienes a alguien más.",shape=box,color=blue];
		3297 -> 3306;
