	j4265859907 [label="Cuando quieras. ¿Qué pasa?",shape=box,color=red];
		j4265859907 -> j2507557468;
	j3497740465 [label="Je. No sé si en verdad está domesticado. ¿Qué pasa?",shape=box,color=red];
