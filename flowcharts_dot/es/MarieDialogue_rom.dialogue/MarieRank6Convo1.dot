		j893585656 -> j592477889;
	j143997940 [label="No quiero hacerle daño a nadie y no seré la \"otra mujer\" que le cause dolor a alguien. ¿Si tienes sentimientos más fuertes por mí a a costa de alguien más?",shape=box,color=blue];
