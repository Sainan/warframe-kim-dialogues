		j2072866972 -> j893585656;
	j552505092 [label="Solo rezo para que no desvíes a Lyon del camino correcto ni le hagas daño innecesariamente. Es una criatura delicada, bajo ese exterior de piedra.",shape=box,color=blue];
		j552505092 -> j143997940;
	j1482223254 [label="No deseo que Roathe sufra, a pesar de todo. No le causes dolor, si puedes evitarlo.",shape=box,color=blue];
		j1482223254 -> j143997940;
	j1974257875 [label="Podría estar en paz, incluso alegrarme, ante la idea de compartirte con alguien más, pero ¿con mi familia o con un enemigo? Creo que eso es demasiado para mí.",shape=box,color=blue];
		j1974257875 -> j1449646411;
		j1974257875 -> j2853195823;
