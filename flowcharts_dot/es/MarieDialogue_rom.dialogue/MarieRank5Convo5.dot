digraph {
	"MarieRank5Convo5 begins." [color=orange];
		"MarieRank5Convo5 begins." -> j20182927;
	j20182927 [label="Check boolean MarieDating",color=orange];
		j20182927 -> j224350290 [label=true,color=green];
		j20182927 -> j346248087 [label=false,color=brown];
	j224350290 [label="Bonjour, bonjour, mon cœur ! Tengo que contarte la cosa más tonta.",shape=box,color=blue];
		j224350290 -> j4203290004;
		j224350290 -> j2429168889;
	j346248087 [label="Bonjour ! Tengo que contarte la cosa más tonta.",shape=box,color=blue];
		j346248087 -> j4203290004;
		j346248087 -> j2429168889;
	j4203290004 [label="¿Oh? ¿Qué pasó?",shape=box,color=red];
		j4203290004 -> j1897262333;
	j2429168889 [label="[Fin.]",shape=box,color=red];
		j2429168889 -> "Chat ends.";
	j1897262333 [label="Le pregunté a M'sieur Bird Trois qué día era su cumpleaños, ¡y no lo sabía! ¡Qué terriblemente triste!",shape=box,color=blue];
		j1897262333 -> j3768923649;
	"Chat ends." [color=orange];
	j3768923649 [label="Ninguno de los Cavia conoce su fecha de nacimiento, lo cual supongo que tiene sentido, dado que nacieron sin la capacidad de hablar ni de entender el calendario como nosotros.",shape=box,color=blue];
		j3768923649 -> j3795400169;
	j3795400169 [label="Entonces pensé: Qué tragédie ! Debemos solucionarlo de inmediato, non ?",shape=box,color=blue];
		j3795400169 -> j345027778;
		j3795400169 -> j3268183702;
		j3795400169 -> j4051052695;
	j345027778 [label="Nunca lo había pensado.",shape=box,color=red];
		j345027778 -> j1999825210;
	j3268183702 [label="¿Cómo sabrás cuándo nacieron?",shape=box,color=red];
		j3268183702 -> j1887222409;
	j4051052695 [label="¿Les dejarás elegir sus fechas de cumpleaños?",shape=box,color=red];
		j4051052695 -> j2953366367;
	j1999825210 [label="Oui ! Monsieur tampoco. La expresión de su rostro cuando lo descubrí fue de pura tristeza...",shape=box,color=blue];
		j1999825210 -> j2732370540;
	j1887222409 [label="Al principio pensé en consultar los registros de le Cardinal; tal vez anotó cuándo nacieron, non ?",shape=box,color=blue];
		j1887222409 -> j2402114516;
	j2953366367 [label="\"¿Dejarlos?\" ¡Lo dices como si dependiera de mí! ",shape=box,color=blue];
		j2953366367 -> j1887222409;
	j2732370540 [label="Me rompe el corazón que piense que es su culpa por no haberlo pensado primero. No es su culpa, él hace tanto por tanta gente...",shape=box,color=blue];
		j2732370540 -> j960964763;
	j2402114516 [label="Evaluate expressions",color=orange];
		j2402114516 -> j31403501 [label="MarieEntratiComplete",color=purple];
		j2402114516 -> j31403501 [label="MarieEntrati3a",color=purple];
		j2402114516 -> j474366582 [label="false",color=purple];
	j960964763 [label="Todos tenemos la bendición de conocer la bondad de Monsieur Loid. Su generosidad no tiene límite.",shape=box,color=blue];
		j960964763 -> j2280985567;
		j960964763 -> j2174585345;
	j31403501 [label="Pero entonces recordé... mis conversaciones con M'sieur Tagfer y los demás, y pensé... que eso tal vez no sea tan prudente.",shape=box,color=blue];
		j31403501 -> j4079918434;
	j474366582 [label="Pero parecían desinteresados en encontrar registros de su pasado. Sé lo doloroso que puede ser pensar en los orígenes de uno mismo.",shape=box,color=blue];
		j474366582 -> j4079918434;
	j2280985567 [label="Tenemos mucha suerte de que esté aquí.",shape=box,color=red];
		j2280985567 -> j2884258883;
	j2174585345 [label="Desearía que se animara un poco de vez en cuando.",shape=box,color=red];
		j2174585345 -> j3093362759;
	j4079918434 [label="Después de todo, yo desconozco mi fecha de nacimiento. ",shape=box,color=blue];
		j4079918434 -> j2528319806;
		j4079918434 -> j3396254833;
		j4079918434 -> j552354672;
	j2884258883 [label="Oui, así es. Lo somos.",shape=box,color=blue];
		j2884258883 -> j3542593548;
	j3093362759 [label="Es un hombre serio, pero lo he visto sonreír. Tiene sentido del humor cuando menos te lo esperas. Solo hay que tener paciencia.",shape=box,color=blue];
		j3093362759 -> j3542593548;
	j2528319806 [label="Si te hace sentir mejor, yo tampoco. Sospecho que el chico tampoco lo recuerda.",shape=box,color=red];
		j2528319806 -> j3746172943;
	j3396254833 [label="Los cumpleaños están sobrevalorados.",shape=box,color=red];
		j3396254833 -> j3112253739;
	j552354672 [label="De todos modos, es más divertido elegirlo tu mismo. Más poignant. ",shape=box,color=red];
		j552354672 -> j1578805624;
	j3542593548 [label="Check boolean MarieDating",color=orange];
		j3542593548 -> j3240900040 [label=true,color=green];
		j3542593548 -> j1340945817 [label=false,color=brown];
	j3746172943 [label="¡Más razones para llorar por ti y tu minúscula copia! ¡Y aún más cosas que tenemos en común!",shape=box,color=blue];
		j3746172943 -> j3542593548;
	j3112253739 [label="¡No creo que estén sobrevalorados en absoluto! Debemos celebrar a quienes aún están con nosotros, del mismo modo que celebramos a quienes se han ido.",shape=box,color=blue];
		j3112253739 -> j3542593548;
	j1578805624 [label="¿Poignant? No sabía que hablabas Gaullique ! ¿Lo aprendiste de mí?",shape=box,color=blue];
		j1578805624 -> j3379765845;
		j1578805624 -> j2558704582;
	j3240900040 [label="+20 Chemistry",color=orange];
		j3240900040 -> j1243838876;
	j1340945817 [label="+20 Chemistry",color=orange];
		j1340945817 -> j1168766704;
	j3379765845 [label="Yo... creo que lo escuché por ahí...",shape=box,color=red];
		j3379765845 -> j1959255861;
	j2558704582 [label="Debí haberlo aprendido de ti.",shape=box,color=red];
		j2558704582 -> j2630492731;
	j1243838876 [label="¡Ahora! ¡Vamos, mon cœur ! Aunque al final no salga nada de esto, ¡lo que cuenta siempre es la intención! Au calendrier !",shape=box,color=blue];
		j1243838876 -> "Chat ends.";
	j1168766704 [label="¡Ahora! ¡Vamos! Aunque al final no salga nada de esto, ¡lo que cuenta es la intención! Au calendrier !",shape=box,color=blue];
		j1168766704 -> "Chat ends.";
	j1959255861 [label="¡Bah! ¡Las demás lenguas siempre se apropian de lo mejor del Gaullique y se salen con la suya! ¡Los tiempos nunca cambiarán!",shape=box,color=blue];
		j1959255861 -> j3542593548;
	j2630492731 [label="¡Entonces eres inteligente! El Gaullique es uno de los idiomas más hermosos que jamás hayan existido, y me alegra traerlo a este futuro.",shape=box,color=blue];
		j2630492731 -> j3542593548;
}