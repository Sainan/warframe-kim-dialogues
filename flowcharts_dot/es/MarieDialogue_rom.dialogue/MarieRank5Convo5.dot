	3094 [label="Bonjour ! Tengo que contarte la cosa más tonta.",shape=box,color=blue];
		3094 -> 3095;
		3094 -> 3096;
	3095 [label="¿Oh? ¿Qué pasó?",shape=box,color=red];
		3095 -> 3097;
	3096 [label="[Fin.]",shape=box,color=red];
		3096 -> 3098;
	3097 [label="Le pregunté a M'sieur Bird Trois qué día era su cumpleaños, ¡y no lo sabía! ¡Qué terriblemente triste!",shape=box,color=blue];
		3097 -> 3099;
	3098 [label="Chat ends.",color=orange];
	3099 [label="Ninguno de los Cavia conoce su fecha de nacimiento, lo cual supongo que tiene sentido, dado que nacieron sin la capacidad de hablar ni de entender el calendario como nosotros.",shape=box,color=blue];
		3099 -> 3100;
	3100 [label="Entonces pensé: Qué tragédie ! Debemos solucionarlo de inmediato, non ?",shape=box,color=blue];
		3100 -> 3101;
		3100 -> 3102;
		3100 -> 3103;
	3101 [label="Nunca lo había pensado.",shape=box,color=red];
		3101 -> 3104;
	3102 [label="¿Cómo sabrás cuándo nacieron?",shape=box,color=red];
		3102 -> 3105;
	3103 [label="¿Les dejarás elegir sus fechas de cumpleaños?",shape=box,color=red];
		3103 -> 3106;
	3104 [label="Oui ! Monsieur tampoco. La expresión de su rostro cuando lo descubrí fue de pura tristeza...",shape=box,color=blue];
		3104 -> 3107;
	3105 [label="Al principio pensé en consultar los registros de le Cardinal; tal vez anotó cuándo nacieron, non ?",shape=box,color=blue];
		3105 -> 3108;
	3106 [label="\"¿Dejarlos?\" ¡Lo dices como si dependiera de mí! ",shape=box,color=blue];
		3106 -> 3105;
	3107 [label="Me rompe el corazón que piense que es su culpa por no haberlo pensado primero. No es su culpa, él hace tanto por tanta gente...",shape=box,color=blue];
		3107 -> 3109;
	3108 [label="Evaluate expressions",color=orange];
		3108 -> 3110 [label="MarieEntratiComplete",color=purple];
		3108 -> 3110 [label="MarieEntrati3a",color=purple];
		3108 -> 3111 [label="false",color=purple];
	3109 [label="Todos tenemos la bendición de conocer la bondad de Monsieur Loid. Su generosidad no tiene límite.",shape=box,color=blue];
		3109 -> 3112;
		3109 -> 3113;
	3110 [label="Pero entonces recordé... mis conversaciones con M'sieur Tagfer y los demás, y pensé... que eso tal vez no sea tan prudente.",shape=box,color=blue];
		3110 -> 3114;
	3111 [label="Pero parecían desinteresados en encontrar registros de su pasado. Sé lo doloroso que puede ser pensar en los orígenes de uno mismo.",shape=box,color=blue];
		3111 -> 3114;
	3112 [label="Tenemos mucha suerte de que esté aquí.",shape=box,color=red];
		3112 -> 3115;
	3113 [label="Desearía que se animara un poco de vez en cuando.",shape=box,color=red];
		3113 -> 3116;
	3114 [label="Después de todo, yo desconozco mi fecha de nacimiento. ",shape=box,color=blue];
		3114 -> 3117;
		3114 -> 3118;
		3114 -> 3119;
	3115 [label="Oui, así es. Lo somos.",shape=box,color=blue];
		3115 -> 3120;
	3116 [label="Es un hombre serio, pero lo he visto sonreír. Tiene sentido del humor cuando menos te lo esperas. Solo hay que tener paciencia.",shape=box,color=blue];
		3116 -> 3120;
	3117 [label="Si te hace sentir mejor, yo tampoco. Sospecho que el chico tampoco lo recuerda.",shape=box,color=red];
		3117 -> 3121;
	3118 [label="Los cumpleaños están sobrevalorados.",shape=box,color=red];
		3118 -> 3122;
	3119 [label="De todos modos, es más divertido elegirlo tu mismo. Más poignant. ",shape=box,color=red];
		3119 -> 3123;
	3120 [label="Check boolean MarieDating",color=orange];
		3120 -> 3125 [label=true,color=green];
		3120 -> 3124 [label=false,color=brown];
	3121 [label="¡Más razones para llorar por ti y tu minúscula copia! ¡Y aún más cosas que tenemos en común!",shape=box,color=blue];
		3121 -> 3120;
	3122 [label="¡No creo que estén sobrevalorados en absoluto! Debemos celebrar a quienes aún están con nosotros, del mismo modo que celebramos a quienes se han ido.",shape=box,color=blue];
		3122 -> 3120;
	3123 [label="¿Poignant? No sabía que hablabas Gaullique ! ¿Lo aprendiste de mí?",shape=box,color=blue];
		3123 -> 3126;
		3123 -> 3127;
	3125 [label="+20 Chemistry",color=orange];
		3125 -> 3129;
	3124 [label="+20 Chemistry",color=orange];
		3124 -> 3128;
	3126 [label="Yo... creo que lo escuché por ahí...",shape=box,color=red];
		3126 -> 3130;
	3127 [label="Debí haberlo aprendido de ti.",shape=box,color=red];
		3127 -> 3131;
	3129 [label="¡Ahora! ¡Vamos, mon cœur ! Aunque al final no salga nada de esto, ¡lo que cuenta siempre es la intención! Au calendrier !",shape=box,color=blue];
		3129 -> 3132;
	3128 [label="¡Ahora! ¡Vamos! Aunque al final no salga nada de esto, ¡lo que cuenta es la intención! Au calendrier !",shape=box,color=blue];
		3128 -> 3132;
	3130 [label="¡Bah! ¡Las demás lenguas siempre se apropian de lo mejor del Gaullique y se salen con la suya! ¡Los tiempos nunca cambiarán!",shape=box,color=blue];
		3130 -> 3120;
	3131 [label="¡Entonces eres inteligente! El Gaullique es uno de los idiomas más hermosos que jamás hayan existido, y me alegra traerlo a este futuro.",shape=box,color=blue];
		3131 -> 3120;
	3132 [label="Chat ends.",color=orange];
