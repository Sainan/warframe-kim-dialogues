		j162358221 -> j1268519469;
		j162358221 -> j539622858;
	j3414217583 [label="Ahora estás haciendo suposiciones. No lo sabes. Nunca la has conocido y no tienes ni idea de lo que ha vivido. Ni de lo que ha tenido que soportar.",shape=box,color=red];
