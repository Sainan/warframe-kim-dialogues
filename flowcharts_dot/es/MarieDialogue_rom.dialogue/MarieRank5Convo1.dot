digraph {
	2427 [label="MarieRank5Convo1 begins.",color=orange];
		2427 -> 2428;
	2428 [label="¿Podemos hablar?",shape=box,color=blue];
		2428 -> 2429;
	2429 [label="Evaluate expressions",color=orange];
		2429 -> 2430 [label="MarieEntrati4a",color=purple];
		2429 -> 2431 [label="MarieEntrati4b",color=purple];
		2429 -> 2432 [label="MarieEntrati3a",color=purple];
		2429 -> 2433 [label="MarieEntrati3b",color=purple];
		2429 -> 2434 [label="MarieEntrati3",color=purple];
		2429 -> 2435 [label="false",color=purple];
	2430 [label="He estado reflexionando sobre lo que dijiste acerca de le Cardinal. Que sus acciones son... una \"mezcla\" de bondad y maldad.",shape=box,color=blue];
		2430 -> 2436;
	2431 [label="He estado reflexionando sobre lo que dijiste acerca de le Cardinal. Que sus acciones han lastimado a Lyon.",shape=box,color=blue];
		2431 -> 2436;
	2432 [label="He estado pensando más en nuestra conversación sobre M'sieur Tagfer y en tus convincentes argumentos sobre por qué desprecia tanto a le Cardinal.",shape=box,color=blue];
		2432 -> 2436;
	2433 [label="He estado reflexionando más sobre mi discusión con M'sieur Tagfer y sus razones para despreciar tanto a le Cardinal.",shape=box,color=blue];
		2433 -> 2436;
	2434 [label="He estado reflexionando más sobre mi discusión con M'sieur Tagfer. Y sobre nuestra discusión acerca de esa discusión.",shape=box,color=blue];
		2434 -> 2436;
	2435 [label="Siento que muchas cosas se han quedado sin decir sobre le Cardinal. Los demás parecen tratar el tema con mucho cuidado a mi alrededor, temerosos de hablar de él.",shape=box,color=blue];
		2435 -> 2436;
	2436 [label="Sé que otros quieren pintarlo como un canalla, un loco, un traidor. Pero para mí no era nada de eso.",shape=box,color=blue];
		2436 -> 2437;
	2437 [label="Check boolean MarieBackstory1",color=orange];
		2437 -> 2439 [label=true,color=green];
		2437 -> 2438 [label=false,color=brown];
	2439 [label="Quizás sea porque estoy muy acostumbrada a que me abandonen. ",shape=box,color=blue];
		2439 -> 2440;
	2438 [label="Mi familia me abandonó, me dejaron en la calle cuando era una niña, por ser... anormal. Rota. No apta para la alta sociedad.",shape=box,color=blue];
		2438 -> 2440;
	2440 [label="Quizás sea porque nunca tuve un padre del que hablar, que estoy tan dispuesta a perdonarle su ausencia.",shape=box,color=blue];
		2440 -> 2441;
	2441 [label="Evaluate expressions",color=orange];
		2441 -> 2442 [label="MarieEntrati4a",color=purple];
		2441 -> 2443 [label="MarieEntrati4b",color=purple];
		2441 -> 2444 [label="MarieEntrati3a",color=purple];
		2441 -> 2445 [label="MarieEntrati3b",color=purple];
		2441 -> 2446 [label="MarieEntrati3",color=purple];
		2441 -> 2447 [label="false",color=purple];
	2442 [label="Pero lo cierto es que lo perdono. Porque veo más valor en sus buenas acciones que daño en las malas.",shape=box,color=blue];
		2442 -> 2448;
		2442 -> 2449;
		2442 -> 2450;
		2442 -> 2451;
		2442 -> 2452;
	2443 [label="Rezo para que Lyon sea fuerte y supere la crisis de fe que enfrenta, pero no creo que sea totalmente culpa de le Cardinal.",shape=box,color=blue];
		2443 -> 2448;
		2443 -> 2449;
		2443 -> 2450;
		2443 -> 2453;
		2443 -> 2454;
	2444 [label="Así que, aunque aprecio tus convincentes argumentos con respecto a M'sieur Tagfer y a quienes han sido dañados por él... sigo viendo más valor en sus buenas acciones que daño en las malas.",shape=box,color=blue];
		2444 -> 2448;
		2444 -> 2449;
		2444 -> 2450;
		2444 -> 2455;
		2444 -> 2456;
	2445 [label="Así que, aunque comprendo la indignación de M'sieur Tagfer y simpatizo con su punto de vista, debe encontrar en su corazón el perdón para le Cardinal. Porque veo más valor en sus buenas acciones que daño en sus malas.",shape=box,color=blue];
		2445 -> 2448;
		2445 -> 2449;
		2445 -> 2450;
		2445 -> 2457;
		2445 -> 2458;
	2446 [label="Así que, aunque aprecio las historias que todos tienen con le Cardinal, especialmente M'Sieur Tagfer, sigo valorando más sus buenas acciones que el daño causado por las malas.",shape=box,color=blue];
		2446 -> 2448;
		2446 -> 2449;
		2446 -> 2450;
		2446 -> 2459;
	2447 [label="Así que, aunque aprecio las historias que todos tienen con le Cardinal, sigo valorando más sus buenas acciones que el daño causado por las malas.",shape=box,color=blue];
		2447 -> 2448;
		2447 -> 2449;
		2447 -> 2450;
	2448 [label="No te culpo por apreciar el bien que ha hecho en tu vida, así como no culpo a otras personas por resentir el daño que está causando en las suyas.",shape=box,color=red];
		2448 -> 2460;
	2449 [label="No lo sé. Creo que sus acciones han causado mucho más daño que bien. Ojalá pudieras verlo.",shape=box,color=red];
		2449 -> 2461;
	2450 [label="Estoy de tu lado, Marie. No puedo culpar a Entrati por nada de lo que ha hecho. Está luchando contra la indiferencia.",shape=box,color=red];
		2450 -> 2462;
	2451 [label="Tienes razón al perdonar a Entrati. Ojalá más personas siguieran tu ejemplo.",shape=box,color=red];
		2451 -> 2462;
	2452 [label="Jamás culparé a alguien por perdonar. Pero se puede perdonar a alguien entendiendo que es necesario protegerte a ti mismo y a los demás de esa persona.",shape=box,color=red];
		2452 -> 2463;
	2453 [label="¿Crees que el sufrimiento de Lyon es su culpa?",shape=box,color=red];
		2453 -> 2464;
	2454 [label="Lyon sufre algo mucho más grave que una crisis de fe, Marie. Y gran parte de ello tiene que ver con Entrati.",shape=box,color=red];
		2454 -> 2461;
	2455 [label="¿Nada de lo que dije sirvió siquiera para equilibrar la balanza?",shape=box,color=red];
		2455 -> 2465;
	2456 [label="¿Cómo puedes ver todo lo que ha hecho Entrati y seguir viendo más bien que mal?",shape=box,color=red];
		2456 -> 2461;
	2457 [label="Creo que estás menospreciando lo que sufrieron los Cavia y Tagfer.",shape=box,color=red];
		2457 -> 2461;
	2458 [label="El perdón es importante. Pero también lo es reconocer que Entrati podría ser más complicado de lo que estás dispuesta a aceptar.",shape=box,color=red];
		2458 -> 2465;
	2459 [label="Creo que todavía no entiendes lo que sufrieron Tagfer y los Cavia. Es peor que lo que tú viviste.",shape=box,color=red];
		2459 -> 2461;
	2460 [label="Pero, ¿comprendes que ambos no tienen el mismo valor? ¿El resentimiento y la veneración? Deseo que los demás abandonen sus rencores maliciosos.",shape=box,color=blue];
		2460 -> 2466;
		2460 -> 2467;
	2461 [label="Evaluate expressions",color=orange];
		2461 -> 2469 [label="MarieEntratiMonster1",color=purple];
		2461 -> 2469 [label="MarieEntratiMonster2",color=purple];
		2461 -> 2468 [label="MarieEntratiFan1",color=purple];
		2461 -> 2468 [label="MarieEntratiFan2",color=purple];
		2461 -> 2470 [label="false",color=purple];
	2462 [label="Evaluate expressions",color=orange];
		2462 -> 2473 [label="MarieEntratiMonster1",color=purple];
		2462 -> 2473 [label="MarieEntratiMonster2",color=purple];
		2462 -> 2471 [label="MarieEntratiFan1",color=purple];
		2462 -> 2471 [label="MarieEntratiFan2",color=purple];
		2462 -> 2472 [label="false",color=purple];
	2463 [label="¿Y qué sugieres que hagamos? ¿Exiliar a le Cardinal? Yo diría que eso es precisamente lo que él mismo se ha hecho, non ?",shape=box,color=blue];
		2463 -> 2474;
		2463 -> 2467;
	2464 [label="Creo que Lyon sufre de muchos males, muchos de ellos debidos a la inseguridad que siente y a su mente. 
Le Cardenal parece haber... agravado aún más la situación.",shape=box,color=blue];
		2464 -> 2475;
		2464 -> 2467;
	2465 [label="¿Qué quieres que haga? ¿Quemar una efigie de le Cardenal y denunciarlo? ¿Condenarlo al Vacío, desearle el mal como M'sieur Tagfer?",shape=box,color=blue];
		2465 -> 2474;
		2465 -> 2467;
	2466 [label="Ese es el problema, Marie. Lo que les pides a los demás. No lo que ellos te piden a ti. Ni a Entrati.",shape=box,color=red];
		2466 -> 2476;
	2467 [label="Entrati deja gente herida por donde pasa. Lo único que intento es ayudar a esas personas a reconstruir sus vidas. Si es \"bueno\" o \"malo\" no me importa mucho.",shape=box,color=red];
		2467 -> 2477;
	2469 [label="Sí, ¡y eres tan consistente en tu odio hacia él! ¿Acaso nada de lo que he dicho ha logrado cambiar tus sentimientos por le Cardinal?",shape=box,color=blue];
		2469 -> 2482;
	2468 [label="¿No estabas diciendo hace un momento que tú también apoyabas a Entrati, igual que yo? ¿Qué te hizo cambiar de opinión ahora?",shape=box,color=blue];
		2468 -> 2478;
		2468 -> 2479;
		2468 -> 2480;
		2468 -> 2481;
	2470 [label="Oui, ¡y parece que consideras a Entrati un monstruo! ¡Rechazas con tanta rapidez su amabilidad!",shape=box,color=blue];
		2470 -> 2482;
	2473 [label="¿No me estabas hablando de la monstruosidad de Entrati hace un momento? ¿Qué te ha hecho cambiar de opinión ahora?",shape=box,color=blue];
		2473 -> 2478;
		2473 -> 2479;
		2473 -> 2480;
		2473 -> 2481;
	2471 [label="Merci, ¡y has sido mi fiel compañero en esta cruzada! Me temo que somos los únicos que pensamos así; incluso Monsieur Loid alberga tal resentimiento...",shape=box,color=blue];
		2471 -> 2483;
	2472 [label="Gracias, ¡y qué alegría me da oírlo! Me temo que somos los únicos que pensamos así; incluso Monsieur Loid alberga tal resentimiento...",shape=box,color=blue];
		2472 -> 2483;
	2474 [label="Creo que el problema radica más en lo que les pides a los demás, no en lo que ellos te piden a ti. O a Entrati.",shape=box,color=red];
		2474 -> 2476;
	2475 [label="¿Y eso no te molesta?",shape=box,color=red];
		2475 -> 2484;
	2476 [label="¿Y qué es lo que les pido a los demás que resulte tan grotesco? ¿Que abran sus corazones al perdón?",shape=box,color=blue];
		2476 -> 2485;
		2476 -> 2486;
	2477 [label="Noble, aunque tedioso, viajar a través del tiempo y el espacio para ayudar a sus mécontents, non ? Seguramente le guardas rencor por ello...",shape=box,color=blue];
		2477 -> 2487;
		2477 -> 2488;
	2482 [label="Esta conversación fue un error...",shape=box,color=blue];
		2482 -> 2493;
		2482 -> 2494;
	2478 [label="Sinceramente, me ha costado mucho abordar este tema contigo. Muchísimo. Personalmente, creo que él... no es ni bueno ni malo. Es una mezcla.",shape=box,color=red];
		2478 -> 2489;
	2479 [label="He cambiado de opinión. Estoy de su lado. Y del tuyo. Me convenciste.",shape=box,color=red];
		2479 -> 2490;
	2480 [label="[Confesar sentimientos.] Me temo que solo he intentado hacer lo posible por... agradarte. Siento algo por ti. Más de lo que parece.",shape=box,color=red];
		2480 -> 2491;
	2481 [label="He cambiado de opinión y he decidido que es un monstruo. De una vez por todas.",shape=box,color=red];
		2481 -> 2492;
	2483 [label="Juntos, tal vez podamos oponernos a quienes quieren desprestigiar sus buenas obras, oui ? Pero me pregunto, con todo lo que te rodea... ¿por qué te pones de mi lado?",shape=box,color=blue];
		2483 -> 2495;
	2484 [label="Check boolean LyonDating",color=orange];
		2484 -> 2496 [label=true,color=green];
		2484 -> 2497 [label=false,color=brown];
	2485 [label="Marie, has puesto a Entrati en un pedestal. Y ahora pides a los demás que hagan lo mismo, como si fueran idiotas.",shape=box,color=red];
		2485 -> 2498;
	2486 [label="Creo que les estás pidiendo que hagan más que simplemente perdonar a Entrati. Creo que les estás pidiendo que finjan que nada de lo que hizo estuvo mal.",shape=box,color=red];
		2486 -> 2499;
	2487 [label="Claro. Pero también debo \"agradecerle\" por las relaciones y amistades más importantes que he tenido.",shape=box,color=red];
		2487 -> 2500;
	2488 [label="No, en realidad no. Él necesita que lo haga, así que lo haré. Lo juzgaré cuando todo haya terminado.",shape=box,color=red];
		2488 -> 2500;
	2493 [label="Espera, Marie. Por favor. Déjame explicarte.",shape=box,color=red];
		2493 -> 2505;
		2493 -> 2506;
		2493 -> 2507;
		2493 -> 2508;
	2494 [label="He dejado claro lo que pienso de Entrati. Lo siento. En algunas cosas, no coincidimos.",shape=box,color=red];
		2494 -> 2509;
	2489 [label="Update boolean MarieEntratiMonster1",color=orange];
		2489 -> 2501;
	2490 [label="Update boolean MarieEntratiMonster1",color=orange];
		2490 -> 2502;
	2491 [label="Update boolean DrifterMarieWhoops",color=orange];
		2491 -> 2503;
	2492 [label="Update boolean MarieEntratiFan1",color=orange];
		2492 -> 2504;
	2495 [label="¡No es queja, por cierto!",shape=box,color=blue];
		2495 -> 2510;
		2495 -> 2511;
		2495 -> 2512;
	2496 [label="Sé que ha encontrado un lugar en tu corazón, y por ello te estoy profundamente agradecida; quizás por fin pueda dejar de preocuparme por él, y toda esta lucha pronto será en vano...",shape=box,color=blue];
		2496 -> 2497;
	2497 [label="Pero claro que me duele. ¡Es el hermano de mi alma! Mi Lyon es lo más preciado que tengo en este mundo, y verlo sufrir hace que me duela el pecho como si su agonía fuera la mía.",shape=box,color=blue];
		2497 -> 2513;
	2498 [label="Cuidado con lo que dices, Viajero.",shape=box,color=blue];
		2498 -> 2514;
	2499 [label="Je ne suis pas naïve, ¡no me hables como si lo fuera!",shape=box,color=blue];
		2499 -> 2515;
	2500 [label="Quizás solo esté inyectando un veneno para que el cuerpo pueda sanar, y todo esto no sea más que una crueldad necesaria.",shape=box,color=blue];
		2500 -> 2516;
		2500 -> 2517;
	2505 [label="[Confesar sentimientos.] Me importas. Más de lo que parece. Y yo... lamento haber sido tan duro, pero no puedo permitir que te haga daño. No como ya lo ha hecho con tantos otros.",shape=box,color=red];
		2505 -> 2523;
	2506 [label="He visto cómo Entrati no ha hecho más que destruir a todos los que le importan. A todos los que supuestamente ha amado. No quiero que te haga lo mismo a ti...",shape=box,color=red];
		2506 -> 2524;
	2507 [label="No se me da bien expresarme, y lo siento. Pero él... me temo que te está utilizando, y que se está aprovechando de tu amabilidad para manipularte. Eso es todo.",shape=box,color=red];
		2507 -> 2525;
	2508 [label="Puede que veas a Entrati como un salvador, pero yo lo veo como un viejo asustado que busca desesperadamente respuestas. Quizás la respuesta se encuentre en algún punto intermedio.",shape=box,color=red];
		2508 -> 2498;
	2509 [label="Oui. Eso parece.",shape=box,color=blue];
		2509 -> 2526;
	2501 [label="Update boolean MarieEntratiMonster2",color=orange];
		2501 -> 2518;
	2502 [label="Update boolean MarieEntratiMonster2",color=orange];
		2502 -> 2519;
	2503 [label="Y has decidido engañarme para ganarte mi afecto... je vois.",shape=box,color=blue];
		2503 -> 2520;
		2503 -> 2521;
	2504 [label="Update boolean MarieEntratiFan2",color=orange];
		2504 -> 2522;
	2510 [label="[Confesar sentimientos.] Me importas. Más de lo que parece.",shape=box,color=red];
		2510 -> 2527;
	2511 [label="Creo que en esta guerra todo es necesario. Al fin y al cabo, estamos intentando salvar el universo de la Indiferencia, ¿no?",shape=box,color=red];
		2511 -> 2528;
	2512 [label="Creo en Entrati. De verdad. Creo que tiene un plan para resolver esto, y todo ha sido para un bien mayor.",shape=box,color=red];
		2512 -> 2529;
	2513 [label="Pero su pérdida de fe no es obra de le Cardinal. La grieta en los cimientos ya estaba ahí. Simplemente se añadió más presión, oui ?",shape=box,color=blue];
		2513 -> 2500;
	2514 [label="Update boolean MarieWarning",color=orange];
		2514 -> 2499;
	2515 [label="Soy plenamente consciente de que le Cardinal es tanto Lua como Sol —luz y oscuridad—, bien y mal. No es ni lo uno ni lo otro, y es ambos a la vez; es capaz de ser bondadoso y cruel",shape=box,color=blue];
		2515 -> 2530;
		2515 -> 2531;
	2516 [label="Por eso los demás se enfadan cuando hablas de él. Ignoras todo lo que les ha hecho para lastimarlos y finges que no ha pasado nada.",shape=box,color=red];
		2516 -> 2498;
	2517 [label="Marie, basta. Tienes que aceptar que no hace todo esto simplemente porque sea un buen hombre. No lo es. Es más complejo que eso.",shape=box,color=red];
		2517 -> 2499;
	2523 [label="Update boolean DrifterMarie",color=orange];
		2523 -> 2536;
	2524 [label="Cuidado con lo que dices, Viajero.",shape=box,color=blue];
		2524 -> 2537;
	2525 [label="¡No necesito que me protejan! Je ne suis pas une enfant naïve !",shape=box,color=blue];
		2525 -> 2538;
	2526 [label="Update boolean MarieEntrati5g",color=orange];
		2526 -> 2539;
	2518 [label="Update boolean MarieEntratiFan1",color=orange];
		2518 -> 2532;
	2519 [label="Update boolean MarieEntratiFan2",color=orange];
		2519 -> 2533;
	2520 [label="Bueno, cuando lo dices así... ",shape=box,color=red];
		2520 -> 2534;
	2521 [label="Solo parcialmente.",shape=box,color=red];
		2521 -> 2534;
	2522 [label="Update boolean MarieEntratiMonster2",color=orange];
		2522 -> 2535;
	2527 [label="Update boolean DrifterMarieWhoops",color=orange];
		2527 -> 2540;
	2528 [label="Oui ! ¡Exacto! Por fin alguien con sentido común. Me parte el corazón que haya inocentes que sufran en esta guerra, pero hay demasiado en juego. ",shape=box,color=blue];
		2528 -> 2541;
	2529 [label="Update boolean MarieWillDate",color=orange];
		2529 -> 2542;
	2530 [label="Marie, él no es un dios. Es solo un hombre. Es igual de arrogante e igual de peligroso que Roathe. Proviene de la misma sociedad y sufre los mismos problemas.",shape=box,color=red];
		2530 -> 2543;
	2531 [label="Sé que fue amable contigo. Sé que tal vez fue diferente contigo a como lo ha sido con muchas otras personas. Quizás incluso te trató como a una hija... Pero, por favor, ve la imagen completa.",shape=box,color=red];
		2531 -> 2544;
	2536 [label="Yo... No sé cómo reaccionar ante esta noticia, dada nuestra conversación. Estoy... bastante sorprendida. ",shape=box,color=blue];
		2536 -> 2549;
	2537 [label="Update boolean MarieWarning",color=orange];
		2537 -> 2525;
	2538 [label="Soy plenamente consciente de que le Cardinal es tanto Lua como Sol —luz y oscuridad—, bien y mal. No es ni lo uno ni lo otro, y es ambos a la vez; es capaz de ser bondadoso y cruel",shape=box,color=blue];
		2538 -> 2531;
		2538 -> 2530;
	2539 [label="Chat ends. Next chat will be MarieEntratiDay2.",color=orange];
	2532 [label="Update boolean MarieEntratiFan2",color=orange];
		2532 -> 2545;
	2533 [label="Oui ? Tengo esperanzas, pero no estoy convencida. Ten más cuidado con lo que dices, Viajero...",shape=box,color=blue];
		2533 -> 2546;
	2534 [label="Update boolean MarieNoDate",color=orange];
		2534 -> 2547;
	2535 [label="Oui ? ¿Crees que soy una niña tonta? Ten cuidado con lo que dices, Viajero...",shape=box,color=blue];
		2535 -> 2548;
	2540 [label="Y te pusiste del lado de le Cardinal para ganarte mi favor... je vois.",shape=box,color=blue];
		2540 -> 2550;
		2540 -> 2551;
	2541 [label="Y en la guerra se pierden vidas inocentes. Es triste, pero es un hecho, non ?",shape=box,color=blue];
		2541 -> 2552;
		2541 -> 2553;
	2542 [label="Update boolean MarieFamilyFail",color=orange];
		2542 -> 2554;
	2543 [label="¡Es un hombre que invocó —o quizás incluso creó— a un dios! ¡Y ahora es el único que se interpone entre él y la destrucción de nuestro universo!",shape=box,color=blue];
		2543 -> 2555;
	2544 [label="¿Crees que no sé que no fui la única \"hija\" a la que abandonó? ¡Simplemente soy la única que lo perdona!",shape=box,color=blue];
		2544 -> 2556;
		2544 -> 2557;
	2549 [label="¿¡De verdad piensas hacer esto ahora?! ¿¡Así?! ¿¡Aquí?! Vraiment ?!",shape=box,color=blue];
		2549 -> 2560;
	2545 [label="Oui ? Te perdonaré esta mentira, pero estás advertido. Ten más cuidado con lo que dices, Viajero...",shape=box,color=blue];
		2545 -> 2558;
	2546 [label="Update boolean MarieWarning",color=orange];
		2546 -> 2483;
	2547 [label="Update boolean MarieEntrati5i",color=orange];
		2547 -> 2559;
	2548 [label="Update boolean MarieWarning",color=orange];
		2548 -> 2482;
	2550 [label="Bueno, cuando lo dices así... ",shape=box,color=red];
		2550 -> 2561;
	2551 [label="Solo parcialmente. Sinceramente creo en Entrati.",shape=box,color=red];
		2551 -> 2561;
	2552 [label="Exacto. Roathe estaría muy orgulloso de ti.",shape=box,color=red];
		2552 -> 2562;
	2553 [label="¿Cuántas guerras santas se han cometido en nombre de Sol? ¿Qué más da una más, verdad?",shape=box,color=red];
		2553 -> 2563;
	2554 [label="Add -10 to Family",color=orange];
		2554 -> 2564;
	2555 [label="¡Parece que soy la única que recuerda lo que está en juego aquí!",shape=box,color=blue];
		2555 -> 2565;
		2555 -> 2557;
	2556 [label="Ahora estás haciendo suposiciones. No lo sabes. Nunca la has conocido y no tienes ni idea de lo que ha vivido. Ni de lo que ha tenido que soportar.",shape=box,color=red];
		2556 -> 2566;
	2557 [label="¿Y crees que eso hará que él te quiera más? ¿Crees que eso hará que vuelva contigo, si eres tú quien se mantiene fiel?",shape=box,color=red];
		2557 -> 2567;
	2560 [label="Yo... no puedo. No puedo continuar. Discúlpame. Hablaremos de esto mañana, necesito ordenar mis ideas.",shape=box,color=blue];
		2560 -> 2569;
	2558 [label="Update boolean MarieWarning",color=orange];
		2558 -> 2568;
	2559 [label="Chat ends. Next chat will be MarieEntratiDay2.",color=orange];
	2561 [label="Update boolean MarieNoDate",color=orange];
		2561 -> 2570;
	2562 [label="Ta gueule !",shape=box,color=blue];
		2562 -> 2571;
	2563 [label="Yo... eso no es lo que quería decir. Esto no es una guerra santa, esto es algo completamente...",shape=box,color=blue];
		2563 -> 2572;
	2564 [label="Oui ! Exactamente. Y estoy segura de que con el tiempo todos lo entenderán. Simplemente me alegra tener alguien que me apoye en este asunto.",shape=box,color=blue];
		2564 -> 2573;
	2565 [label="Créeme, no, no lo eres. Innumerables personas han perdido la vida por esto. Y podría darte una larga lista de nombres de personas cuyas vidas quedaron arruinadas por su culpa. Pero nadie ha olvidado la Indiferencia.",shape=box,color=red];
		2565 -> 2574;
	2566 [label="Estoy segura de que si la conociera, lo sabría enseguida. ¡Aquí todos hablan sobre el sufrimiento que han padecido a manos de él! No me extraña que le Cardinal no regrese. Si fuera él, no pasaría ni un solo minuto aquí.",shape=box,color=blue];
		2566 -> 2575;
	2567 [label="¡No creo que eso lo ahuyente! ¿Crees que le Cardinal volvería a este nido de víboras? Non ! Si yo fuera él no pasaría ni un solo momento aquí. ",shape=box,color=blue];
		2567 -> 2575;
	2569 [label="+20 Chemistry",color=orange];
		2569 -> 2577;
	2568 [label="Y no tienes por qué hablarme como si fuera una niña.",shape=box,color=blue];
		2568 -> 2576;
	2570 [label="Update boolean MarieEntrati5h",color=orange];
		2570 -> 2578;
	2571 [label="+20 Chemistry",color=orange];
		2571 -> 2579;
	2572 [label="Debo irme.",shape=box,color=blue];
		2572 -> 2580;
	2573 [label="+40 Chemistry",color=orange];
		2573 -> 2581;
	2574 [label="¿De verdad lo crees? ¡Aquí todos se apresuran a contarme el sufrimiento que padecieron a manos de él! ¡Pero nunca mencionan la causa a la que servía!",shape=box,color=blue];
		2574 -> 2582;
	2575 [label="¡Incluso Monsieur Loid, que dice amarlo, no puede evitar hablar de su crueldad en cada oportunidad!",shape=box,color=blue];
		2575 -> 2583;
	2577 [label="Update boolean MarieEntrati5f",color=orange];
		2577 -> 2584;
	2576 [label="Soy plenamente consciente de que le Cardinal es tanto Lua como Sol —luz y oscuridad—, bien y mal. No es ni lo uno ni lo otro, y es ambos a la vez; es capaz de ser bondadoso y cruel",shape=box,color=blue];
		2576 -> 2531;
		2576 -> 2530;
	2578 [label="Chat ends. Next chat will be MarieEntratiDay2.",color=orange];
	2579 [label="Update boolean MarieEntrati5a",color=orange];
		2579 -> 2585;
	2580 [label="+15 Chemistry",color=orange];
		2580 -> 2586;
	2581 [label="Chat ends.",color=orange];
	2582 [label="¡Le Cardinal está peleando una guerra! Y en la guerra, algunos inocentes deben resultar heridos. Es triste, pero es la realidad.",shape=box,color=blue];
		2582 -> 2587;
		2582 -> 2588;
		2582 -> 2589;
	2583 [label="Nadie entiende a le Cardinal. ¡Está librando una guerra! Y en la guerra, algunos inocentes resultan heridos. Es triste, ¡pero es la realidad!",shape=box,color=blue];
		2583 -> 2589;
		2583 -> 2588;
		2583 -> 2587;
	2584 [label="Chat ends. Next chat will be MarieEntratiDay2.",color=orange];
	2585 [label="Chat ends. Next chat will be MarieEntratiDay2.",color=orange];
	2586 [label="Update boolean MarieEntrati5d",color=orange];
		2586 -> 2590;
	2587 [label="Roathe estaría muy orgulloso de ti.",shape=box,color=red];
		2587 -> 2591;
	2588 [label="Marie, lo siento, esto no es ninguna \"guerra santa\". Eres muy nueva en todo esto, y Entrati te tiene completamente cegada.",shape=box,color=red];
		2588 -> 2592;
	2589 [label="Y... ¿dónde dice en la doctrina de Sol que está bien lastimar a inocentes en la guerra?",shape=box,color=red];
		2589 -> 2593;
	2590 [label="Chat ends. Next chat will be MarieEntratiDay2.",color=orange];
	2591 [label="Ta gueule !",shape=box,color=blue];
