digraph {
	"MarieRank5Convo1 begins." [color=orange];
		"MarieRank5Convo1 begins." -> j2869273028;
	j2869273028 [label="¿Podemos hablar?",shape=box,color=blue];
		j2869273028 -> j709500590;
	j709500590 [label="Evaluate expressions",color=orange];
		j709500590 -> j392315276 [label="MarieEntrati4a",color=purple];
		j709500590 -> j1550172686 [label="MarieEntrati4b",color=purple];
		j709500590 -> j1104365232 [label="MarieEntrati3a",color=purple];
		j709500590 -> j3268233964 [label="MarieEntrati3b",color=purple];
		j709500590 -> j238005420 [label="MarieEntrati3",color=purple];
		j709500590 -> j568201101 [label="false",color=purple];
	j392315276 [label="He estado reflexionando sobre lo que dijiste acerca de le Cardinal. Que sus acciones son... una \"mezcla\" de bondad y maldad.",shape=box,color=blue];
		j392315276 -> j892406483;
	j1550172686 [label="He estado reflexionando sobre lo que dijiste acerca de le Cardinal. Que sus acciones han lastimado a Lyon.",shape=box,color=blue];
		j1550172686 -> j892406483;
	j1104365232 [label="He estado pensando más en nuestra conversación sobre M'sieur Tagfer y en tus convincentes argumentos sobre por qué desprecia tanto a le Cardinal.",shape=box,color=blue];
		j1104365232 -> j892406483;
	j3268233964 [label="He estado reflexionando más sobre mi discusión con M'sieur Tagfer y sus razones para despreciar tanto a le Cardinal.",shape=box,color=blue];
		j3268233964 -> j892406483;
	j238005420 [label="He estado reflexionando más sobre mi discusión con M'sieur Tagfer. Y sobre nuestra discusión acerca de esa discusión.",shape=box,color=blue];
		j238005420 -> j892406483;
	j568201101 [label="Siento que muchas cosas se han quedado sin decir sobre le Cardinal. Los demás parecen tratar el tema con mucho cuidado a mi alrededor, temerosos de hablar de él.",shape=box,color=blue];
		j568201101 -> j892406483;
	j892406483 [label="Sé que otros quieren pintarlo como un canalla, un loco, un traidor. Pero para mí no era nada de eso.",shape=box,color=blue];
		j892406483 -> j2718976672;
	j2718976672 [label="Check boolean MarieBackstory1",color=orange];
		j2718976672 -> j2097467498 [label=true,color=green];
		j2718976672 -> j4093614259 [label=false,color=brown];
	j2097467498 [label="Quizás sea porque estoy muy acostumbrada a que me abandonen. ",shape=box,color=blue];
		j2097467498 -> j2062779500;
	j4093614259 [label="Mi familia me abandonó, me dejaron en la calle cuando era una niña, por ser... anormal. Rota. No apta para la alta sociedad.",shape=box,color=blue];
		j4093614259 -> j2062779500;
	j2062779500 [label="Quizás sea porque nunca tuve un padre del que hablar, que estoy tan dispuesta a perdonarle su ausencia.",shape=box,color=blue];
		j2062779500 -> j4106479212;
	j4106479212 [label="Evaluate expressions",color=orange];
		j4106479212 -> j2602062024 [label="MarieEntrati4a",color=purple];
		j4106479212 -> j3440247339 [label="MarieEntrati4b",color=purple];
		j4106479212 -> j3254196328 [label="MarieEntrati3a",color=purple];
		j4106479212 -> j4050585266 [label="MarieEntrati3b",color=purple];
		j4106479212 -> j3976427883 [label="MarieEntrati3",color=purple];
		j4106479212 -> j3559624435 [label="false",color=purple];
	j2602062024 [label="Pero lo cierto es que lo perdono. Porque veo más valor en sus buenas acciones que daño en las malas.",shape=box,color=blue];
		j2602062024 -> j783475418;
		j2602062024 -> j2191870166;
		j2602062024 -> j540267777;
		j2602062024 -> j1078309393;
		j2602062024 -> j2156842185;
	j3440247339 [label="Rezo para que Lyon sea fuerte y supere la crisis de fe que enfrenta, pero no creo que sea totalmente culpa de le Cardinal.",shape=box,color=blue];
		j3440247339 -> j783475418;
		j3440247339 -> j2191870166;
		j3440247339 -> j540267777;
		j3440247339 -> j3500134503;
		j3440247339 -> j2248579496;
	j3254196328 [label="Así que, aunque aprecio tus convincentes argumentos con respecto a M'sieur Tagfer y a quienes han sido dañados por él... sigo viendo más valor en sus buenas acciones que daño en las malas.",shape=box,color=blue];
		j3254196328 -> j783475418;
		j3254196328 -> j2191870166;
		j3254196328 -> j540267777;
		j3254196328 -> j3201461497;
		j3254196328 -> j3400198391;
	j4050585266 [label="Así que, aunque comprendo la indignación de M'sieur Tagfer y simpatizo con su punto de vista, debe encontrar en su corazón el perdón para le Cardinal. Porque veo más valor en sus buenas acciones que daño en sus malas.",shape=box,color=blue];
		j4050585266 -> j783475418;
		j4050585266 -> j2191870166;
		j4050585266 -> j540267777;
		j4050585266 -> j3850589850;
		j4050585266 -> j1633988713;
	j3976427883 [label="Así que, aunque aprecio las historias que todos tienen con le Cardinal, especialmente M'Sieur Tagfer, sigo valorando más sus buenas acciones que el daño causado por las malas.",shape=box,color=blue];
		j3976427883 -> j783475418;
		j3976427883 -> j2191870166;
		j3976427883 -> j540267777;
		j3976427883 -> j457696509;
	j3559624435 [label="Así que, aunque aprecio las historias que todos tienen con le Cardinal, sigo valorando más sus buenas acciones que el daño causado por las malas.",shape=box,color=blue];
		j3559624435 -> j783475418;
		j3559624435 -> j2191870166;
		j3559624435 -> j540267777;
	j783475418 [label="No te culpo por apreciar el bien que ha hecho en tu vida, así como no culpo a otras personas por resentir el daño que está causando en las suyas.",shape=box,color=red];
		j783475418 -> j3719222304;
	j2191870166 [label="No lo sé. Creo que sus acciones han causado mucho más daño que bien. Ojalá pudieras verlo.",shape=box,color=red];
		j2191870166 -> j4288371264;
	j540267777 [label="Estoy de tu lado, Marie. No puedo culpar a Entrati por nada de lo que ha hecho. Está luchando contra la indiferencia.",shape=box,color=red];
		j540267777 -> j3142094137;
	j1078309393 [label="Tienes razón al perdonar a Entrati. Ojalá más personas siguieran tu ejemplo.",shape=box,color=red];
		j1078309393 -> j3142094137;
	j2156842185 [label="Jamás culparé a alguien por perdonar. Pero se puede perdonar a alguien entendiendo que es necesario protegerte a ti mismo y a los demás de esa persona.",shape=box,color=red];
		j2156842185 -> j1055482529;
	j3500134503 [label="¿Crees que el sufrimiento de Lyon es su culpa?",shape=box,color=red];
		j3500134503 -> j2270188685;
	j2248579496 [label="Lyon sufre algo mucho más grave que una crisis de fe, Marie. Y gran parte de ello tiene que ver con Entrati.",shape=box,color=red];
		j2248579496 -> j4288371264;
	j3201461497 [label="¿Nada de lo que dije sirvió siquiera para equilibrar la balanza?",shape=box,color=red];
		j3201461497 -> j170550440;
	j3400198391 [label="¿Cómo puedes ver todo lo que ha hecho Entrati y seguir viendo más bien que mal?",shape=box,color=red];
		j3400198391 -> j4288371264;
	j3850589850 [label="Creo que estás menospreciando lo que sufrieron los Cavia y Tagfer.",shape=box,color=red];
		j3850589850 -> j4288371264;
	j1633988713 [label="El perdón es importante. Pero también lo es reconocer que Entrati podría ser más complicado de lo que estás dispuesta a aceptar.",shape=box,color=red];
		j1633988713 -> j170550440;
	j457696509 [label="Creo que todavía no entiendes lo que sufrieron Tagfer y los Cavia. Es peor que lo que tú viviste.",shape=box,color=red];
		j457696509 -> j4288371264;
	j3719222304 [label="Pero, ¿comprendes que ambos no tienen el mismo valor? ¿El resentimiento y la veneración? Deseo que los demás abandonen sus rencores maliciosos.",shape=box,color=blue];
		j3719222304 -> j1309220323;
		j3719222304 -> j348379304;
	j4288371264 [label="Evaluate expressions",color=orange];
		j4288371264 -> j656533614 [label="MarieEntratiMonster1",color=purple];
		j4288371264 -> j656533614 [label="MarieEntratiMonster2",color=purple];
		j4288371264 -> j2261039632 [label="MarieEntratiFan1",color=purple];
		j4288371264 -> j2261039632 [label="MarieEntratiFan2",color=purple];
		j4288371264 -> j2043896580 [label="false",color=purple];
	j3142094137 [label="Evaluate expressions",color=orange];
		j3142094137 -> j4267863987 [label="MarieEntratiMonster1",color=purple];
		j3142094137 -> j4267863987 [label="MarieEntratiMonster2",color=purple];
		j3142094137 -> j1239725791 [label="MarieEntratiFan1",color=purple];
		j3142094137 -> j1239725791 [label="MarieEntratiFan2",color=purple];
		j3142094137 -> j1204775654 [label="false",color=purple];
	j1055482529 [label="¿Y qué sugieres que hagamos? ¿Exiliar a le Cardinal? Yo diría que eso es precisamente lo que él mismo se ha hecho, non ?",shape=box,color=blue];
		j1055482529 -> j1059252146;
		j1055482529 -> j348379304;
	j2270188685 [label="Creo que Lyon sufre de muchos males, muchos de ellos debidos a la inseguridad que siente y a su mente. \nLe Cardenal parece haber... agravado aún más la situación.",shape=box,color=blue];
		j2270188685 -> j1012579166;
		j2270188685 -> j348379304;
	j170550440 [label="¿Qué quieres que haga? ¿Quemar una efigie de le Cardenal y denunciarlo? ¿Condenarlo al Vacío, desearle el mal como M'sieur Tagfer?",shape=box,color=blue];
		j170550440 -> j1059252146;
		j170550440 -> j348379304;
	j1309220323 [label="Ese es el problema, Marie. Lo que les pides a los demás. No lo que ellos te piden a ti. Ni a Entrati.",shape=box,color=red];
		j1309220323 -> j185274062;
	j348379304 [label="Entrati deja gente herida por donde pasa. Lo único que intento es ayudar a esas personas a reconstruir sus vidas. Si es \"bueno\" o \"malo\" no me importa mucho.",shape=box,color=red];
		j348379304 -> j3202288186;
	j656533614 [label="Sí, ¡y eres tan consistente en tu odio hacia él! ¿Acaso nada de lo que he dicho ha logrado cambiar tus sentimientos por le Cardinal?",shape=box,color=blue];
		j656533614 -> j276724294;
	j2261039632 [label="¿No estabas diciendo hace un momento que tú también apoyabas a Entrati, igual que yo? ¿Qué te hizo cambiar de opinión ahora?",shape=box,color=blue];
		j2261039632 -> j857959485;
		j2261039632 -> j3178651340;
		j2261039632 -> j1015093617;
		j2261039632 -> j3218992891;
	j2043896580 [label="Oui, ¡y parece que consideras a Entrati un monstruo! ¡Rechazas con tanta rapidez su amabilidad!",shape=box,color=blue];
		j2043896580 -> j276724294;
	j4267863987 [label="¿No me estabas hablando de la monstruosidad de Entrati hace un momento? ¿Qué te ha hecho cambiar de opinión ahora?",shape=box,color=blue];
		j4267863987 -> j857959485;
		j4267863987 -> j3178651340;
		j4267863987 -> j1015093617;
		j4267863987 -> j3218992891;
	j1239725791 [label="Merci, ¡y has sido mi fiel compañero en esta cruzada! Me temo que somos los únicos que pensamos así; incluso Monsieur Loid alberga tal resentimiento...",shape=box,color=blue];
		j1239725791 -> j299659009;
	j1204775654 [label="Gracias, ¡y qué alegría me da oírlo! Me temo que somos los únicos que pensamos así; incluso Monsieur Loid alberga tal resentimiento...",shape=box,color=blue];
		j1204775654 -> j299659009;
	j1059252146 [label="Creo que el problema radica más en lo que les pides a los demás, no en lo que ellos te piden a ti. O a Entrati.",shape=box,color=red];
		j1059252146 -> j185274062;
	j1012579166 [label="¿Y eso no te molesta?",shape=box,color=red];
		j1012579166 -> j2159116448;
	j185274062 [label="¿Y qué es lo que les pido a los demás que resulte tan grotesco? ¿Que abran sus corazones al perdón?",shape=box,color=blue];
		j185274062 -> j3439930698;
		j185274062 -> j1959341890;
	j3202288186 [label="Noble, aunque tedioso, viajar a través del tiempo y el espacio para ayudar a sus mécontents, non ? Seguramente le guardas rencor por ello...",shape=box,color=blue];
		j3202288186 -> j4278841378;
		j3202288186 -> j749840630;
	j276724294 [label="Esta conversación fue un error...",shape=box,color=blue];
		j276724294 -> j3576822800;
		j276724294 -> j2921691581;
	j857959485 [label="Sinceramente, me ha costado mucho abordar este tema contigo. Muchísimo. Personalmente, creo que él... no es ni bueno ni malo. Es una mezcla.",shape=box,color=red];
		j857959485 -> j2169901662;
	j3178651340 [label="He cambiado de opinión. Estoy de su lado. Y del tuyo. Me convenciste.",shape=box,color=red];
		j3178651340 -> j2465297989;
	j1015093617 [label="[Confesar sentimientos.] Me temo que solo he intentado hacer lo posible por... agradarte. Siento algo por ti. Más de lo que parece.",shape=box,color=red];
		j1015093617 -> j3922202379;
	j3218992891 [label="He cambiado de opinión y he decidido que es un monstruo. De una vez por todas.",shape=box,color=red];
		j3218992891 -> j2796295294;
	j299659009 [label="Juntos, tal vez podamos oponernos a quienes quieren desprestigiar sus buenas obras, oui ? Pero me pregunto, con todo lo que te rodea... ¿por qué te pones de mi lado?",shape=box,color=blue];
		j299659009 -> j1335626902;
	j2159116448 [label="Check boolean LyonDating",color=orange];
		j2159116448 -> j3431975294 [label=true,color=green];
		j2159116448 -> j3812022268 [label=false,color=brown];
	j3439930698 [label="Marie, has puesto a Entrati en un pedestal. Y ahora pides a los demás que hagan lo mismo, como si fueran idiotas.",shape=box,color=red];
		j3439930698 -> j1747564341;
	j1959341890 [label="Creo que les estás pidiendo que hagan más que simplemente perdonar a Entrati. Creo que les estás pidiendo que finjan que nada de lo que hizo estuvo mal.",shape=box,color=red];
		j1959341890 -> j3561848445;
	j4278841378 [label="Claro. Pero también debo \"agradecerle\" por las relaciones y amistades más importantes que he tenido.",shape=box,color=red];
		j4278841378 -> j868928596;
	j749840630 [label="No, en realidad no. Él necesita que lo haga, así que lo haré. Lo juzgaré cuando todo haya terminado.",shape=box,color=red];
		j749840630 -> j868928596;
	j3576822800 [label="Espera, Marie. Por favor. Déjame explicarte.",shape=box,color=red];
		j3576822800 -> j638947954;
		j3576822800 -> j4268377258;
		j3576822800 -> j2351170634;
		j3576822800 -> j3110666402;
	j2921691581 [label="He dejado claro lo que pienso de Entrati. Lo siento. En algunas cosas, no coincidimos.",shape=box,color=red];
		j2921691581 -> j1440135837;
	j2169901662 [label="Boolean MarieEntratiMonster1 is now false.",color=orange];
		j2169901662 -> j2564439422;
	j2465297989 [label="Boolean MarieEntratiMonster1 is now false.",color=orange];
		j2465297989 -> j652327541;
	j3922202379 [label="Boolean DrifterMarieWhoops is now true.",color=orange];
		j3922202379 -> j1557511324;
	j2796295294 [label="Boolean MarieEntratiFan1 is now false.",color=orange];
		j2796295294 -> j611036076;
	j1335626902 [label="¡No es queja, por cierto!",shape=box,color=blue];
		j1335626902 -> j2781197339;
		j1335626902 -> j614171208;
		j1335626902 -> j2569915765;
	j3431975294 [label="Sé que ha encontrado un lugar en tu corazón, y por ello te estoy profundamente agradecida; quizás por fin pueda dejar de preocuparme por él, y toda esta lucha pronto será en vano...",shape=box,color=blue];
		j3431975294 -> j3812022268;
	j3812022268 [label="Pero claro que me duele. ¡Es el hermano de mi alma! Mi Lyon es lo más preciado que tengo en este mundo, y verlo sufrir hace que me duela el pecho como si su agonía fuera la mía.",shape=box,color=blue];
		j3812022268 -> j4153847628;
	j1747564341 [label="Cuidado con lo que dices, Viajero.",shape=box,color=blue];
		j1747564341 -> j2062517625;
	j3561848445 [label="Je ne suis pas naïve, ¡no me hables como si lo fuera!",shape=box,color=blue];
		j3561848445 -> j1298715884;
	j868928596 [label="Quizás solo esté inyectando un veneno para que el cuerpo pueda sanar, y todo esto no sea más que una crueldad necesaria.",shape=box,color=blue];
		j868928596 -> j1144196031;
		j868928596 -> j2986298114;
	j638947954 [label="[Confesar sentimientos.] Me importas. Más de lo que parece. Y yo... lamento haber sido tan duro, pero no puedo permitir que te haga daño. No como ya lo ha hecho con tantos otros.",shape=box,color=red];
		j638947954 -> j4130497228;
	j4268377258 [label="He visto cómo Entrati no ha hecho más que destruir a todos los que le importan. A todos los que supuestamente ha amado. No quiero que te haga lo mismo a ti...",shape=box,color=red];
		j4268377258 -> j726270982;
	j2351170634 [label="No se me da bien expresarme, y lo siento. Pero él... me temo que te está utilizando, y que se está aprovechando de tu amabilidad para manipularte. Eso es todo.",shape=box,color=red];
		j2351170634 -> j1438034581;
	j3110666402 [label="Puede que veas a Entrati como un salvador, pero yo lo veo como un viejo asustado que busca desesperadamente respuestas. Quizás la respuesta se encuentre en algún punto intermedio.",shape=box,color=red];
		j3110666402 -> j1747564341;
	j1440135837 [label="Oui. Eso parece.",shape=box,color=blue];
		j1440135837 -> j3051126039;
	j2564439422 [label="Boolean MarieEntratiMonster2 is now false.",color=orange];
		j2564439422 -> j3059332973;
	j652327541 [label="Boolean MarieEntratiMonster2 is now false.",color=orange];
		j652327541 -> j831459769;
	j1557511324 [label="Y has decidido engañarme para ganarte mi afecto... je vois.",shape=box,color=blue];
		j1557511324 -> j1606290598;
		j1557511324 -> j3379573628;
	j611036076 [label="Boolean MarieEntratiFan2 is now false.",color=orange];
		j611036076 -> j3584762965;
	j2781197339 [label="[Confesar sentimientos.] Me importas. Más de lo que parece.",shape=box,color=red];
		j2781197339 -> j516569157;
	j614171208 [label="Creo que en esta guerra todo es necesario. Al fin y al cabo, estamos intentando salvar el universo de la Indiferencia, ¿no?",shape=box,color=red];
		j614171208 -> j1288296609;
	j2569915765 [label="Creo en Entrati. De verdad. Creo que tiene un plan para resolver esto, y todo ha sido para un bien mayor.",shape=box,color=red];
		j2569915765 -> j1302252600;
	j4153847628 [label="Pero su pérdida de fe no es obra de le Cardinal. La grieta en los cimientos ya estaba ahí. Simplemente se añadió más presión, oui ?",shape=box,color=blue];
		j4153847628 -> j868928596;
	j2062517625 [label="Boolean MarieWarning is now true.",color=orange];
		j2062517625 -> j3561848445;
	j1298715884 [label="Soy plenamente consciente de que le Cardinal es tanto Lua como Sol —luz y oscuridad—, bien y mal. No es ni lo uno ni lo otro, y es ambos a la vez; es capaz de ser bondadoso y cruel",shape=box,color=blue];
		j1298715884 -> j1057379059;
		j1298715884 -> j2612921063;
	j1144196031 [label="Por eso los demás se enfadan cuando hablas de él. Ignoras todo lo que les ha hecho para lastimarlos y finges que no ha pasado nada.",shape=box,color=red];
		j1144196031 -> j1747564341;
	j2986298114 [label="Marie, basta. Tienes que aceptar que no hace todo esto simplemente porque sea un buen hombre. No lo es. Es más complejo que eso.",shape=box,color=red];
		j2986298114 -> j3561848445;
	j4130497228 [label="Boolean DrifterMarie is now true.",color=orange];
		j4130497228 -> j546647502;
	j726270982 [label="Cuidado con lo que dices, Viajero.",shape=box,color=blue];
		j726270982 -> j1585733485;
	j1438034581 [label="¡No necesito que me protejan! Je ne suis pas une enfant naïve !",shape=box,color=blue];
		j1438034581 -> j1465248694;
	j3051126039 [label="Boolean MarieEntrati5g is now true.",color=orange];
		j3051126039 -> "Chat ends. Next chat will be MarieEntratiDay2.";
	j3059332973 [label="Boolean MarieEntratiFan1 is now false.",color=orange];
		j3059332973 -> j446326525;
	j831459769 [label="Boolean MarieEntratiFan2 is now true.",color=orange];
		j831459769 -> j2684818839;
	j1606290598 [label="Bueno, cuando lo dices así... ",shape=box,color=red];
		j1606290598 -> j1073700449;
	j3379573628 [label="Solo parcialmente.",shape=box,color=red];
		j3379573628 -> j1073700449;
	j3584762965 [label="Boolean MarieEntratiMonster2 is now true.",color=orange];
		j3584762965 -> j777085533;
	j516569157 [label="Boolean DrifterMarieWhoops is now true.",color=orange];
		j516569157 -> j709938182;
	j1288296609 [label="Oui ! ¡Exacto! Por fin alguien con sentido común. Me parte el corazón que haya inocentes que sufran en esta guerra, pero hay demasiado en juego. ",shape=box,color=blue];
		j1288296609 -> j438963210;
	j1302252600 [label="Boolean MarieWillDate is now true.",color=orange];
		j1302252600 -> j2457825899;
	j1057379059 [label="Marie, él no es un dios. Es solo un hombre. Es igual de arrogante e igual de peligroso que Roathe. Proviene de la misma sociedad y sufre los mismos problemas.",shape=box,color=red];
		j1057379059 -> j1759789601;
	j2612921063 [label="Sé que fue amable contigo. Sé que tal vez fue diferente contigo a como lo ha sido con muchas otras personas. Quizás incluso te trató como a una hija... Pero, por favor, ve la imagen completa.",shape=box,color=red];
		j2612921063 -> j1421733418;
	j546647502 [label="Yo... No sé cómo reaccionar ante esta noticia, dada nuestra conversación. Estoy... bastante sorprendida. ",shape=box,color=blue];
		j546647502 -> j2872504059;
	j1585733485 [label="Boolean MarieWarning is now true.",color=orange];
		j1585733485 -> j1438034581;
