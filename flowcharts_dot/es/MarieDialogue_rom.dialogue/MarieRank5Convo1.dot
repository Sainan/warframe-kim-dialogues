	j221774206 [label="Oui ! Exactamente. Y estoy segura de que con el tiempo todos lo entenderán. Simplemente me alegra tener alguien que me apoye en este asunto.",shape=box,color=blue];
		j221774206 -> j300343042;
	j1268519469 [label="Créeme, no, no lo eres. Innumerables personas han perdido la vida por esto. Y podría darte una larga lista de nombres de personas cuyas vidas quedaron arruinadas por su culpa. Pero nadie ha olvidado la Indiferencia.",shape=box,color=red];
		j1268519469 -> j4219330706;
	j373782619 [label="Estoy segura de que si la conociera, lo sabría enseguida. ¡Aquí todos hablan sobre el sufrimiento que han padecido a manos de él! No me extraña que le Cardinal no regrese. Si fuera él, no pasaría ni un solo minuto aquí.",shape=box,color=blue];
