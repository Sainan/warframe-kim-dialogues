	2594 [label="+20 Chemistry",color=orange];
		2594 -> 2599;
	2595 [label="Te dije que no me hablaras de ese modo. Aquí se acabó todo. Y aquí termina todo entre nosotros.",shape=box,color=blue];
		2595 -> 2600;
	2596 [label="¡No me hables con ese tono! No soy tonta, veo las consecuencias de sus actos. ¡Simplemente no creo que sean injustificables!",shape=box,color=blue];
		2596 -> 2601;
	2597 [label="¿Y ahora me hablas de fe? ¿Cuándo te conviene? ¡No! ¡No lo creo! Aquí se acabó. Y aquí se acabó todo entre nosotros.",shape=box,color=blue];
		2597 -> 2602;
	2598 [label="Ne t'avise pas de me parler de ce dont tu ne sais rien, toi... non. Non ! Non ! Nous en avons terminé !",shape=box,color=blue];
		2598 -> 2603;
