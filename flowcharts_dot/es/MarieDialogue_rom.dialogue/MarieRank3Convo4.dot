	j2297973630 [label="Boolean MarieLyonAvailable is now true.",color=orange];
		j2297973630 -> j2862815840;
	j2862815840 [label="El otro día estaba hablando con Monsieur Loid acerca de su niñez y tenía una pregunta para ti.",shape=box,color=blue];
		j2862815840 -> j2323713137;
		j2862815840 -> j1133913418;
		j2862815840 -> j3982566488;
		j2862815840 -> j202800200;
	j2323713137 [label="Perdón ¿Tú qué?",shape=box,color=red];
		j2323713137 -> j1448314431;
	j1133913418 [label="No... sé... cómo sentirme acerca de esto.",shape=box,color=red];
		j1133913418 -> j1954984870;
	j3982566488 [label="¿Cuál es la pregunta?",shape=box,color=red];
		j3982566488 -> j1618327720;
	j202800200 [label="[Fin]",shape=box,color=red];
		j202800200 -> "Chat ends.";
	j1448314431 [label="Me estaba hablando de su juventud. Ai-je fait quelque chose qui vous a offensé ?",shape=box,color=blue];
		j1448314431 -> j513962773;
		j1448314431 -> j3681412834;
	j1954984870 [label="No entiendo. Ai-je fait quelque chose qui vous avez offensé ?",shape=box,color=blue];
		j1954984870 -> j513962773;
		j1954984870 -> j3681412834;
	j1618327720 [label="¿Los arquimedianos eran orokins? ¿O no lo eran? La palabra se usa con mucha frivolidad.",shape=box,color=blue];
		j1618327720 -> j53352957;
	"Chat ends." [color=orange];
	j513962773 [label="Supongo que sólo me dan... celos.",shape=box,color=red];
		j513962773 -> j1941779967;
	j3681412834 [label="Supongo que sólo me... sorprende.",shape=box,color=red];
		j3681412834 -> j1010099276;
	j53352957 [label="Le preguntaría al diablo, supongo. Pero no me gusta hablar con él si es que puedo evitarlo.",shape=box,color=blue];
		j53352957 -> j982753;
		j53352957 -> j2458185870;
	j1941779967 [label="De la jalousie ? Pourquoi ?",shape=box,color=blue];
		j1941779967 -> j2254879381;
	j1010099276 [label="Pourquoi ?",shape=box,color=blue];
		j1010099276 -> j3307414622;
		j1010099276 -> j3526186372;
	j982753 [label="No, los arquimedianos eran un rango debajo de los orokin.",shape=box,color=red];
		j982753 -> j3858429916;
	j2458185870 [label="El imperio Orokin es llamado así porque los orokin lo dirigían, pero los orokin era sólo el nombre de la clase dominante.",shape=box,color=red];
		j2458185870 -> j3858429916;
	j2254879381 [label="+10 Chemistry",color=orange];
		j2254879381 -> j2813572150;
	j3307414622 [label="Sólo me sorprende que sabes más sobre él de lo que sé yo.",shape=box,color=red];
		j3307414622 -> j2254879381;
	j3526186372 [label="No sé nada sobre el pasado de Loid, y llevo conociéndolo por un tiempo.",shape=box,color=red];
		j3526186372 -> j2254879381;
	j3858429916 [label="Esto pasa seguido. No estás sola.",shape=box,color=red];
		j3858429916 -> j1227409179;
	j2813572150 [label="¡Oh! No lo tomo personal, s'il vous plaît !",shape=box,color=blue];
		j2813572150 -> j1639578482;
	j1227409179 [label="¿Los orokin hicieron que su sociedad fuera despistada y lenta a propósito?",shape=box,color=blue];
		j1227409179 -> j1803570435;
		j1227409179 -> j471641294;
		j1227409179 -> j1350525853;
	j1639578482 [label="Monsieur Loid es, cuál era la palabra ¿Distante?",shape=box,color=blue];
		j1639578482 -> j3004591798;
		j1639578482 -> j1856956519;
	j1803570435 [label="Miles de años de estar al mando, hace que la gente se... aburra. La gente aburrida crea sistemas complicados.",shape=box,color=red];
		j1803570435 -> j1505859957;
	j471641294 [label="Tenían un gusto por lo ornamentado y lo intricado. Eso se extendió a la burocracia.",shape=box,color=red];
		j471641294 -> j1505859957;
	j1350525853 [label="¿La verdad? Empiezo a creer que sí.",shape=box,color=red];
		j1350525853 -> j1505859957;
	j3004591798 [label="La verdad no sé nada sobre él.",shape=box,color=red];
		j3004591798 -> j2947727748;
	j1856956519 [label="Es un poco distante, sí.",shape=box,color=red];
		j1856956519 -> j2947727748;
	j1505859957 [label="+10 Chemistry",color=orange];
		j1505859957 -> j2043651191;
	j2947727748 [label="Mira con quién paso mi tiempo, oui ? Aprende a leer una estatua y no es tan difícil llegar a leer otra.",shape=box,color=blue];
		j2947727748 -> j2837793825;
	j2043651191 [label="¡Creo que sólo lo hicieron para molestar!",shape=box,color=blue];
		j2043651191 -> j1451255618;
	j2837793825 [label="+10 Chemistry",color=orange];
		j2837793825 -> j3990177558;
	j1451255618 [label="Et ils se demandent pourquoi des rébellions éclatent. Vous aviez peut-être vos warframes, mais nous avions nos guillotines !",shape=box,color=blue];
		j1451255618 -> j3566713005;
	j3990177558 [label="Aunque admito que Monsieur Loid es un poco... piquant, más que el querido Lyon.",shape=box,color=blue];
		j3990177558 -> j1313174193;
		j3990177558 -> j1335023153;
	j3566713005 [label="Vive la révolution !",shape=box,color=blue];
		j3566713005 -> j330760656;
		j3566713005 -> j3352442735;
		j3566713005 -> j2366372526;
	j1313174193 [label="Tiene sus razones.",shape=box,color=red];
		j1313174193 -> j2210722700;
	j1335023153 [label="De todos formas... ¿Cuál era tu pregunta?",shape=box,color=red];
		j1335023153 -> j4059302591;
	j330760656 [label="¿Debería preocuparme?",shape=box,color=red];
		j330760656 -> j2822305352;
	j3352442735 [label="Vive la révolution ! Eso creo.",shape=box,color=red];
		j3352442735 -> j4023249220;
	j2366372526 [label="No sé qué es lo que pasó, pero creo que ¿estoy de acuerdo?",shape=box,color=red];
		j2366372526 -> j4023249220;
	j2210722700 [label="Sí, ciertamente las tiene.",shape=box,color=blue];
		j2210722700 -> j3121725374;
	j4059302591 [label="¡Ah! Sí.",shape=box,color=blue];
		j4059302591 -> j3121725374;
	j2822305352 [label="No te preocupes por mí, sólo me estoy divirtiendo. La pequeña y tonta de Marie la révolutionnaire.",shape=box,color=blue];
		j2822305352 -> j2938251899;
	j4023249220 [label="+10 Chemistry",color=orange];
		j4023249220 -> j2822305352;
	j3121725374 [label="¡Me temo que se me ha olvidado por completo lo que venía a preguntarte! ¡Ja! Ah bueno. Me acordaré después.",shape=box,color=blue];
		j3121725374 -> j1444741289;
	j2938251899 [label="Gracias por responder mi pregunta, debería dejarte continuar tu camino. ",shape=box,color=blue];
		j2938251899 -> j1444741289;
	j1444741289 [label="Me disculpo si te interrumpo en tu día. O tarde. O sea cual sea la hora, cuando sea y donde sea que te encuentres.",shape=box,color=blue];
		j1444741289 -> j4101990552;
	j4101990552 [label="À la revoyure !",shape=box,color=blue];
		j4101990552 -> "Chat ends.";
}