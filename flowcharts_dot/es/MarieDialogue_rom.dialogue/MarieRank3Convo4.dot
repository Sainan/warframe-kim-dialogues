		1260 -> 1263;
		1260 -> 1264;
	1265 [label="Tiene sus razones.",shape=box,color=red];
		1265 -> 1269;
	1266 [label="De todos formas... ¿Cuál era tu pregunta?",shape=box,color=red];
		1266 -> 1270;
	1262 [label="¿Debería preocuparme?",shape=box,color=red];
		1262 -> 1267;
	1263 [label="Vive la révolution ! Eso creo.",shape=box,color=red];
		1263 -> 1268;
	1264 [label="No sé qué es lo que pasó, pero creo que ¿estoy de acuerdo?",shape=box,color=red];
		1264 -> 1268;
	1269 [label="Sí, ciertamente las tiene.",shape=box,color=blue];
		1269 -> 1272;
	1270 [label="¡Ah! Sí.",shape=box,color=blue];
		1270 -> 1272;
	1267 [label="No te preocupes por mí, sólo me estoy divirtiendo. La pequeña y tonta de Marie la révolutionnaire.",shape=box,color=blue];
		1267 -> 1271;
	1268 [label="+10 Chemistry",color=orange];
		1268 -> 1267;
	1272 [label="¡Me temo que se me ha olvidado por completo lo que venía a preguntarte! ¡Ja! Ah bueno. Me acordaré después.",shape=box,color=blue];
		1272 -> 1273;
	1271 [label="Gracias por responder mi pregunta, debería dejarte continuar tu camino. ",shape=box,color=blue];
