		1234 -> 1237;
		1234 -> 1238;
	1233 [label="¿Los arquimedianos eran orokins? ¿O no lo eran? La palabra se usa con mucha frivolidad.",shape=box,color=blue];
		1233 -> 1236;
	1232 [label="Chat ends.",color=orange];
	1237 [label="Supongo que sólo me dan... celos.",shape=box,color=red];
		1237 -> 1241;
	1238 [label="Supongo que sólo me... sorprende.",shape=box,color=red];
		1238 -> 1242;
	1236 [label="Le preguntaría al diablo, supongo. Pero no me gusta hablar con él si es que puedo evitarlo.",shape=box,color=blue];
		1236 -> 1239;
		1236 -> 1240;
	1241 [label="De la jalousie ? Pourquoi ?",shape=box,color=blue];
		1241 -> 1244;
	1242 [label="Pourquoi ?",shape=box,color=blue];
		1242 -> 1245;
		1242 -> 1246;
	1239 [label="No, los arquimedianos eran un rango debajo de los orokin.",shape=box,color=red];
		1239 -> 1243;
	1240 [label="El imperio Orokin es llamado así porque los orokin lo dirigían, pero los orokin era sólo el nombre de la clase dominante.",shape=box,color=red];
		1240 -> 1243;
	1244 [label="+10 Chemistry",color=orange];
		1244 -> 1248;
	1245 [label="Sólo me sorprende que sabes más sobre él de lo que sé yo.",shape=box,color=red];
		1245 -> 1244;
	1246 [label="No sé nada sobre el pasado de Loid, y llevo conociéndolo por un tiempo.",shape=box,color=red];
		1246 -> 1244;
	1243 [label="Esto pasa seguido. No estás sola.",shape=box,color=red];
		1243 -> 1247;
	1248 [label="¡Oh! No lo tomo personal, s'il vous plaît !",shape=box,color=blue];
		1248 -> 1252;
	1247 [label="¿Los orokin hicieron que su sociedad fuera despistada y lenta a propósito?",shape=box,color=blue];
		1247 -> 1249;
		1247 -> 1250;
		1247 -> 1251;
	1252 [label="Monsieur Loid es, cuál era la palabra ¿Distante?",shape=box,color=blue];
		1252 -> 1254;
		1252 -> 1255;
	1249 [label="Miles de años de estar al mando, hace que la gente se... aburra. La gente aburrida crea sistemas complicados.",shape=box,color=red];
		1249 -> 1253;
	1250 [label="Tenían un gusto por lo ornamentado y lo intricado. Eso se extendió a la burocracia.",shape=box,color=red];
		1250 -> 1253;
	1251 [label="¿La verdad? Empiezo a creer que sí.",shape=box,color=red];
		1251 -> 1253;
	1254 [label="La verdad no sé nada sobre él.",shape=box,color=red];
		1254 -> 1257;
	1255 [label="Es un poco distante, sí.",shape=box,color=red];
		1255 -> 1257;
	1253 [label="+10 Chemistry",color=orange];
		1253 -> 1256;
	1257 [label="Mira con quién paso mi tiempo, oui ? Aprende a leer una estatua y no es tan difícil llegar a leer otra.",shape=box,color=blue];
		1257 -> 1259;
	1256 [label="¡Creo que sólo lo hicieron para molestar!",shape=box,color=blue];
		1256 -> 1258;
	1259 [label="+10 Chemistry",color=orange];
		1259 -> 1261;
	1258 [label="Et ils se demandent pourquoi des rébellions éclatent. Vous aviez peut-être vos warframes, mais nous avions nos guillotines !",shape=box,color=blue];
		1258 -> 1260;
	1261 [label="Aunque admito que Monsieur Loid es un poco... piquant, más que el querido Lyon.",shape=box,color=blue];
		1261 -> 1265;
