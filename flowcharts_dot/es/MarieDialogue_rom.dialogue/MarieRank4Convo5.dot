	j3256735832 [label="+15 Chemistry",color=orange];
		j3256735832 -> j3925272598;
	j3141453693 [label="¡No! Es un mentiroso, un manipulador, ¡solo haría esto a cambio de una buena recompensa!",shape=box,color=blue];
		j3141453693 -> j1932792902;
	j1636166711 [label="La situación allá arriba es... frágil en el mejor de los días. No quiero molestarlos.",shape=box,color=red];
		j1636166711 -> j660856450;
	j1278371849 [label="Sólo tenemos que ser cuidadosos. Me temo que una mitad vería a la otra mitad como \"la otra familia\".",shape=box,color=red];
		j1278371849 -> j1352717256;
	j3925272598 [label="Encontraremos una manera de convencer a Monsieur Loid de que suba esas escaleras... Lo sé.",shape=box,color=blue];
		j3925272598 -> j3118995108;
	j1932792902 [label="Encontraremos otra manera de convencer a Monsieur Loid de que suba esas escaleras... Lo sé.",shape=box,color=blue];
		j1932792902 -> j294257248;
	j660856450 [label="Estarías sorprendido de que tan resiliente es el alma. Y aquellos que ahora me rodean son muy viejos, magullados por el tiempo.",shape=box,color=blue];
