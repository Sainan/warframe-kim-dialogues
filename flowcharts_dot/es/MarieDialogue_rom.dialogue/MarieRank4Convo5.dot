	1641 [label="Tienes razón. No se puede competir por algo que una persona no tiene para dar.",shape=box,color=red];
		1641 -> 1649;
	1642 [label="Abrir heridas cicatrizadas es peligroso. Podrías curar una infección... o podrías desangrarte en el proceso.",shape=box,color=red];
		1642 -> 1650;
	1643 [label="Todos tenemos algo en común. En algún momento, Entrati nos abandonó.",shape=box,color=red];
		1643 -> 1651;
