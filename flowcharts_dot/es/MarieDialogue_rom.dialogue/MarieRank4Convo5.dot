	1655 [label="Chat ends.",color=orange];
	1656 [label="Su hija, Euleria, conocida como Madre, y su familia han estado cuidando Deimos durante todo este tiempo.",shape=box,color=red];
		1656 -> 1679;
	2937 [label="¿Qué nos impide simplemente mover todos los muebles, dejar que los vuelvan a colocar, y luego... hacerlo de nuevo? ¡Podríamos venderlo todo! ¡Obtener ganancias con ce mobilier étrange !",shape=box,color=blue];
		2937 -> 2938;
		2937 -> 2939;
		2937 -> 2940;
	1658 [label="Soy plenamente consciente de nuestras desacuerdos pendientes con respecto a le Cardinal. Intento mantener una conversación civilisée.",shape=box,color=blue];
		1658 -> 1680;
	1661 [label="Entiendo que quizás no quieras discutir cómo resolver los conflictos sin encontrar oportunidades para señalar a aquellos que sientes que son culpables.",shape=box,color=blue];
		1661 -> 1680;
	1657 [label="Oui ! Como sueles recordarme, ¡crees que es un monstre ! ¡Sólo con rencor y vacío en el corazón!",shape=box,color=blue];
		1657 -> 1680;
	1659 [label="¿Creí que estabas de mi lado en esta guerra por el alma de le Cardinal?",shape=box,color=blue];
		1659 -> 1681;
	1660 [label="Creía que no te habías decidido sobre le Cardinal. ¿O eso ha cambiado?",shape=box,color=blue];
		1660 -> 1682;
		1660 -> 1683;
	1668 [label="Oui. Eso lo estoy aprendiendo con M'sieur Tagfer...",shape=box,color=blue];
		1668 -> 1686;
	1662 [label="No me hables de heridas cicatrizadas, lobo. Todavía me lamo las mías por nuestra última conversación sobre le Cardinal.",shape=box,color=blue];
		1662 -> 1680;
	1663 [label="Oui, pero lo dijiste antes: todos debemos dejar de culparnos unos a otros por estas heridas que sufrimos.",shape=box,color=blue];
		1663 -> 1684;
	1664 [label="Sé que crees que le Cardinal es una especie de monstruo horrible por causar tales heridas.",shape=box,color=blue];
		1664 -> 1680;
	1665 [label="Sé que estás de mi lado en esta guerra por el alma de le Cardinal, por lo que te estaré eternamente agradecida.",shape=box,color=blue];
		1665 -> 1666;
	1667 [label="Sé que estás evitando juzgarlo, por lo cual estoy inmensamente agradecida.",shape=box,color=blue];
		1667 -> 1666;
	1666 [label="Y aunque sé que los demás se apresuran a culparlo, no deseo que nos dividamos y lastimemos cuando podríamos estar juntos.",shape=box,color=blue];
		1666 -> 1685;
	1675 [label="Oui, aunque estoy aprendiendo que quizá no a todos en el mismo grado, como le ocurrió a M'sieur Tagfer.",shape=box,color=blue];
		1675 -> 1686;
	1669 [label="Y estoy aprendiendo que no a todos al mismo grado, como fuiste tan \"amable\" en señalarme, non ?",shape=box,color=blue];
		1669 -> 1680;
	1670 [label="Oui, sí! Aunque no culpo a le Cardinal por irse, pues su obra es sagrada...",shape=box,color=blue];
		1670 -> 1666;
	1671 [label="Y sé que crees que le Cardinal es una especie de monstruo horrible por causar tales heridas.",shape=box,color=blue];
		1671 -> 1680;
	1672 [label="Sé que estás de mi lado en esta guerra por el alma de le Cardinal, por lo que te estaré eternamente agradecida.",shape=box,color=blue];
		1672 -> 1666;
	1673 [label="Sé que estás evitando juzgarlo, por lo cual estoy inmensamente agradecida.",shape=box,color=blue];
		1673 -> 1666;
	1674 [label="Y mientras los demás se apresuran a culparlo por su dolor, yo simplemente no deseo vernos divididos y sufriendo.",shape=box,color=blue];
		1674 -> 1685;
	1676 [label="¡Te estoy provocando, es broma! No puedo imaginar lo ocupado que estás, ni todos los lugares y momentos en que te necesitan.",shape=box,color=blue];
		1676 -> 1678;
	1677 [label="¡Te estoy provocando, es broma! No puedo comprender lo que han soportado. Y lo difícil que es para ti desenredarlo.",shape=box,color=blue];
		1677 -> 1678;
	1678 [label="Simplemente me preocupa que, si no resuelven sus problemas, jamás podremos aspirar a ser bienvenidos en su mesa. El problema mayor sigue sin resolverse:",shape=box,color=blue];
		1678 -> 1637;
	1679 [label="Velando por este lugar y por el corazón que bombea energía del Vacío al Sistema Origen, manteniéndonos a todos... utilizables, realmente, desde que Entrati se fue.",shape=box,color=red];
		1679 -> 1687;
	2938 [label="No sé si hay mucho mercado para las sillas de Entrati...",shape=box,color=red];
		2938 -> 2942;
	2939 [label="¿No acabaríamos saturando el mercado? Tendríamos que venderlos muy baratos...",shape=box,color=red];
		2939 -> 2942;
	2940 [label="¡Excelente! No le veo ningún problema.",shape=box,color=red];
		2940 -> 2941;
	1680 [label="Y aunque entiendo que ambos temas están inexorablemente ligados, me gustaría pedirte que manetngas tu productividad, oui ?",shape=box,color=blue];
		1680 -> 1688;
	1681 [label="¿Qué es este engaño tuyo, lobo? ¿O es que la pequeña Marie es solo un jeu para ti?",shape=box,color=blue];
		1681 -> 1689;
		1681 -> 1683;
	1682 [label="Aún no sé qué pienso sobre la necesidad de sus acciones. Pero su crueldad es incuestionable.",shape=box,color=red];
		1682 -> 1680;
	1683 [label="Ya me cansé de fingir, lo siento.",shape=box,color=red];
		1683 -> 1690;
	1686 [label="Todos debemos dejar de culparnos unos a otros por estas heridas.",shape=box,color=blue];
		1686 -> 1684;
