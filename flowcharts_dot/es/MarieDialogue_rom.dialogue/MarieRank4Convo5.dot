	2942 [label="¡Pff! Sigo pensando que es un experimento que vale la pena. ¡Quizás podamos encerrar al diablo en un montón de estanterías!",shape=box,color=blue];
		2942 -> 2943;
	2941 [label="Voy a ignorar tu sarcasmo, porque creo que es un experimento que vale la pena. ¡Quizás podamos encerrar al diablo en un montón de estanterías!",shape=box,color=blue];
		2941 -> 2943;
	1688 [label="Busco ayudarnos a todos en esta… extraña coexistencia en la que nos encontramos, no para discutir.",shape=box,color=blue];
		1688 -> 1686;
	1689 [label="No, no es un juego. Pero no se puede confiar en Entrati, y no sé cómo convencerte más que fingiendo estar de tu lado.",shape=box,color=red];
		1689 -> 1695;
	1690 [label="Oui ? Bueno, me alegra decirte que ya no es necesario.",shape=box,color=blue];
		1690 -> 1696;
	1691 [label="Juntos, todos, somos... una familia extraña. Pero una familia, al fin y al cabo.",shape=box,color=red];
		1691 -> 1697;
	1692 [label="Seríamos más fuertes juntos que separados.",shape=box,color=red];
		1692 -> 1698;
		1692 -> 1699;
	1693 [label="Ella ha aceptado su ausencia y han hecho las paces, pero fue algo que les costó mucho trabajo.",shape=box,color=red];
		1693 -> 1700;
	1694 [label="Ella no ha podido aceptar su ausencia y siguen en desacuerdo.",shape=box,color=red];
		1694 -> 1701;
	2943 [label="+20 Chemistry",color=orange];
		2943 -> 2944;
	1695 [label="Oui ? Bueno, me alegra decirte que has fracasado.",shape=box,color=blue];
		1695 -> 1696;
	1696 [label="Update boolean MarieEntratiFan1",color=orange];
		1696 -> 1702;
	1697 [label="Add +1 to Family",color=orange];
		1697 -> 1698;
		1697 -> 1699;
	1698 [label="Y en momentos de sufrimiento, a veces solo nos tenemos el uno al otro. Ya sea a los que nos dieron o a los que encontramos.",shape=box,color=red];
		1698 -> 1703;
	1699 [label="No sé si ayudaría o perjudicaría a la larga. Pero este... purgatorio tampoco está bien.",shape=box,color=red];
		1699 -> 1704;
	1700 [label="¿Saber que él todavía está ahí afuera, suelto, y que no le ha dicho ni una palabra, ni le ha enviado una carta...?",shape=box,color=red];
		1700 -> 1705;
	1701 [label="¿Saber que él todavía está ahí afuera, suelto, y que no le ha dicho ni una palabra, ni le ha enviado una carta...?",shape=box,color=red];
		1701 -> 1706;
	2944 [label="¡Tengo mucho por hacer! À la revoyure !",shape=box,color=blue];
		2944 -> 2929;
	1702 [label="Update boolean MarieEntratiFan2",color=orange];
		1702 -> 1707;
	1703 [label="Add +1 to Family",color=orange];
		1703 -> 1704;
	1704 [label="Oui, estoy de acuerdo. Pero no puedo ser yo quien disminuya la distancia entre nosotros. ¡No sé cómo! Soy una desconocida para los de arriba...",shape=box,color=blue];
		1704 -> 1708;
		1704 -> 1709;
	1705 [label="No puedo imaginar lo doloroso que debe ser esto para ella. Para ellos.",shape=box,color=red];
		1705 -> 1710;
	1706 [label="Eso destruiría cualquier pequeña posibilidad de reconciliación que pudieran tener.",shape=box,color=red];
		1706 -> 1711;
	2929 [label="Chat ends.",color=orange];
	1707 [label="Update boolean MarieNoDate",color=orange];
		1707 -> 1712;
	1708 [label="Loid conocía a la familia Entrati. Debería ser él. Convencerlo, sin embargo... es otra historia.",shape=box,color=red];
		1708 -> 1713;
	1709 [label="¿Roathe, quizás? Es un Orokin, los conocía a todos.",shape=box,color=red];
		1709 -> 1714;
	1710 [label="Si bien entiendo la lógica detrás de la decisión de protegerlos del dolor que le Cardinal causó con su necesaria partida...",shape=box,color=blue];
		1710 -> 1715;
	1711 [label="Oui... Ya veo la lógica. Yo trabajaría para recomponer a su familia, si es posible, non ? Parece ser la única esperanza que tenemos para salir de aquí. ",shape=box,color=blue];
		1711 -> 1716;
	1712 [label="Chat ends.",color=orange];
	1713 [label="+5 Chemistry",color=orange];
		1713 -> 1717;
	1714 [label="Non, el diablo no, cualquiera menos el diablo. Pero has dado con algo. La opción natural es Monsieur Loid, non ?",shape=box,color=blue];
		1714 -> 1718;
	1715 [label="Me parece innecesariamente cruel, ¿no crees ? Podrían pensar que está muerto. ¡O peor! Y nosotros, viviendo aquí comme des rats d'égout ?",shape=box,color=blue];
		1715 -> 1719;
		1715 -> 1720;
		1715 -> 1721;
	1716 [label="Para que no pasemos el resto de nuestras vidas atrapados aquí, comme des rats d'égout. ",shape=box,color=blue];
		1716 -> 1722;
		1716 -> 1723;
	1717 [label="Oui, oui ! C'est ça !  Pero ¿cómo lo convencemos? Se ha mantenido firme en su posición, non ?",shape=box,color=blue];
		1717 -> 1724;
		1717 -> 1725;
	1718 [label="Pero ¿cómo lo convencemos? Se ha mantenido firme en su posición, non ?",shape=box,color=blue];
		1718 -> 1725;
		1718 -> 1724;
	1719 [label="De hecho, tengo una amiga que adora las ratas. Me parecen adorables.",shape=box,color=red];
		1719 -> 1726;
	1720 [label="En realidad, esa decisión no depende de mí.",shape=box,color=red];
		1720 -> 1727;
	1721 [label="¿Qué me sugieres hacer?",shape=box,color=red];
		1721 -> 1728;
	1722 [label="De hecho, tengo una amiga que adora las ratas. Me parecen adorables. ",shape=box,color=red];
		1722 -> 1729;
	1723 [label="He sido negligente. Tienes razón. Me pondré a trabajar.",shape=box,color=red];
		1723 -> 1730;
	1724 [label="¿Crees que tú o Lyon podrían convencerlo?",shape=box,color=red];
		1724 -> 1731;
	1725 [label="No te va a gustar mi respuesta, Marie...",shape=box,color=red];
		1725 -> 1732;
	1726 [label="Y me encantaría conocerla algún día, pero ese no es precisamente el punto, lobito tonto.",shape=box,color=blue];
		1726 -> 1728;
	1727 [label="Lo sé. Darse a conocer es decisión de Monsieur Loid y de todos los demás.",shape=box,color=blue];
		1727 -> 1728;
	1728 [label="Yo diría que es la culpa, no la nobleza, lo que nos mantiene aquí.",shape=box,color=blue];
		1728 -> 1733;
	1729 [label="Y me encantaría conocerla algún día, pero ese no es precisamente el punto, lobito tonto.",shape=box,color=blue];
		1729 -> 1728;
	1730 [label="Gracias. No sé si puedas hacerlo, pero a veces lo único que podemos hacer es intentarlo.",shape=box,color=blue];
		1730 -> 1728;
	1731 [label="Le caemos bien, es amable y gentil. Pero somos desconocidos para él, recién llegados.",shape=box,color=blue];
		1731 -> 1734;
	1732 [label="Ah bon ?",shape=box,color=blue];
		1732 -> 1735;
	1733 [label="Que estamos escondiendo algún gran y terrible pecado.",shape=box,color=blue];
		1733 -> 1736;
	1734 [label="Lo pensaré. ¡Hazlo tú también! Encontraremos una solución. ¡Sol nos ha guiado hasta aquí!",shape=box,color=blue];
		1734 -> 1737;
	1735 [label="Loid podría escuchar a Roathe. Como es un Orokin, su historia compartida podría ser útil en este caso.",shape=box,color=red];
		1735 -> 1738;
	1736 [label="¿Y ese pecado es el que debe ser perdonado, o tal vez demostrado como falso?",shape=box,color=blue];
		1736 -> 1739;
		1736 -> 1740;
	1737 [label="+15 Chemistry",color=orange];
		1737 -> 1741;
	1738 [label="¡No! Es un mentiroso, un manipulador, ¡solo haría esto a cambio de una buena recompensa!",shape=box,color=blue];
		1738 -> 1742;
	1739 [label="La situación allá arriba es... frágil en el mejor de los días. No quiero molestarlos.",shape=box,color=red];
		1739 -> 1743;
	1740 [label="Sólo tenemos que ser cuidadosos. Me temo que una mitad vería a la otra mitad como \"la otra familia\".",shape=box,color=red];
		1740 -> 1744;
	1741 [label="Encontraremos una manera de convencer a Monsieur Loid de que suba esas escaleras... Lo sé.",shape=box,color=blue];
		1741 -> 1745;
	1742 [label="Encontraremos otra manera de convencer a Monsieur Loid de que suba esas escaleras... Lo sé.",shape=box,color=blue];
		1742 -> 1746;
	1743 [label="Estarías sorprendido de que tan resiliente es el alma. Y aquellos que ahora me rodean son muy viejos, magullados por el tiempo.",shape=box,color=blue];
		1743 -> 1747;
	1744 [label="Add +1 to Family",color=orange];
		1744 -> 1748;
	1745 [label="Debo irme. Tengo mucho que pensar, mucho que hacer. À la revoyure.",shape=box,color=blue];
		1745 -> 1749;
	1746 [label="Debo irme. Tengo mucho que pensar, mucho que hacer. À la revoyure.",shape=box,color=blue];
		1746 -> 1750;
	1747 [label="Los has sorprendido tantas veces. Déjalos que te sorprendan esta vez.",shape=box,color=blue];
		1747 -> 1751;
	1748 [label="Oh Sol, ¡creo que lo resolviste!",shape=box,color=blue];
		1748 -> 1752;
	1749 [label="Update boolean MarieFamily3b",color=orange];
		1749 -> 1753;
	1750 [label="+15 Chemistry",color=orange];
		1750 -> 1754;
