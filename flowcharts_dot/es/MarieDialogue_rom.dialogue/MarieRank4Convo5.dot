		j1316635360 -> j797972570 [label="false",color=purple];
	j2639429977 [label="¡Viajero! He estado tramando algo.",shape=box,color=blue];
		j2639429977 -> j2456126391;
		j2639429977 -> j2429168889;
	j2312033486 [label="¡Viajero! He estado pensando en lo que dijiste de la familia que está arriba de nosotros. Y en cómo podrían vernos como intrusos.",shape=box,color=blue];
		j2312033486 -> j1765123513;
	j3299503499 [label="¡Viajero! He estado pensando en lo que dijiste de la familia que está arriba. Se me rompe el corazón por ellos...",shape=box,color=blue];
		j3299503499 -> j1000557311;
	j797972570 [label="¿Por qué no podemos subir? ¿Por qué no podemos hablar con quienes llamaron familia a le Cardinal?",shape=box,color=blue];
		j797972570 -> j3176531879;
		j797972570 -> j202800200;
	j2456126391 [label="¿Debería de asustarme?",shape=box,color=red];
		j2456126391 -> j2160712467;
	j2429168889 [label="[Fin.]",shape=box,color=red];
		j2429168889 -> "Chat ends.";
	j1765123513 [label="Como la \"otra familia\" compétition, oui ? Esto me preocupa mucho.",shape=box,color=blue];
		j1765123513 -> j1000557311;
	j1000557311 [label="Check /Lotus/Scripts/1999/DialogueScriptNodes.lua:IsSyndicateRank(syndicate=EntratiSyndicate, syndicateRank=5)",color=orange];
		j1000557311 -> j1657751375 [label=true,color=green];
		j1000557311 -> j3642914 [label=false,color=brown];
	j3176531879 [label="Bueno... en resumen, algunos miembros de la familia Entrati están arriba, y... no saben que estamos aquí abajo.",shape=box,color=red];
		j3176531879 -> j4043795391;
	j202800200 [label="[Fin]",shape=box,color=red];
		j202800200 -> "Chat ends.";
	j2160712467 [label="Oui ! Los pequeños robots voladores. Los necra... necra... ¿Cómo se llaman?",shape=box,color=blue];
		j2160712467 -> j4252451530;
	"Chat ends." [color=orange];
	j1657751375 [label="No competimos por el amor de le Cardinal, ¿cómo podemos ayudarles a ver eso?",shape=box,color=blue];
		j1657751375 -> j1359330267;
		j1657751375 -> j746618153;
		j1657751375 -> j355844278;
	j3642914 [label="Check boolean MarieSyndicateMaxRank",color=orange];
		j3642914 -> j1657751375 [label=true,color=green];
		j3642914 -> j538717460 [label=false,color=brown];
	j4043795391 [label="Boolean MarieFamily1 is now true.",color=orange];
		j4043795391 -> j2279065001;
	j4252451530 [label="¿Necramitos?",shape=box,color=red];
		j4252451530 -> j2068729578;
	j1359330267 [label="Tienes razón. No se puede competir por algo que una persona no tiene para dar.",shape=box,color=red];
		j1359330267 -> j380005824;
	j746618153 [label="Abrir heridas cicatrizadas es peligroso. Podrías curar una infección... o podrías desangrarte en el proceso.",shape=box,color=red];
		j746618153 -> j2952898253;
	j355844278 [label="Todos tenemos algo en común. En algún momento, Entrati nos abandonó.",shape=box,color=red];
		j355844278 -> j2515192195;
	j538717460 [label="¿Cómo va tu trabajo para reparar sus conflictos internos?",shape=box,color=blue];
		j538717460 -> j3593036855;
		j538717460 -> j2290655299;
		j538717460 -> j3639963971;
		j538717460 -> j2429168889;
	j2279065001 [label="Por las Luminarias... ¿Quieres decir que estamos aquí en secreto? ¿Es por eso que no podemos salir de aquí? Mais pourquoi ?!",shape=box,color=blue];
		j2279065001 -> j3282801535;
	j2068729578 [label="Oui ! Son muy persistentes en cambiar los muebles, non ? Pero me he dado cuenta de que si mueves las cosas... hacen lo mismo.",shape=box,color=blue];
		j2068729578 -> j1173137833;
	j380005824 [label="Evaluate expressions",color=orange];
		j380005824 -> j3367602919 [label="MarieEntrati3a",color=purple];
		j380005824 -> j3367602919 [label="MarieEntrati3b",color=purple];
		j380005824 -> j3367602919 [label="MarieEntrati3",color=purple];
