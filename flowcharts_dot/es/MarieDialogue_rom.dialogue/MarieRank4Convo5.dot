		1647 -> 1655;
	1648 [label="Por las Luminarias... ¿Quieres decir que estamos aquí en secreto? ¿Es por eso que no podemos salir de aquí? Mais pourquoi ?!",shape=box,color=blue];
		1648 -> 1656;
	2936 [label="Oui ! Son muy persistentes en cambiar los muebles, non ? Pero me he dado cuenta de que si mueves las cosas... hacen lo mismo.",shape=box,color=blue];
