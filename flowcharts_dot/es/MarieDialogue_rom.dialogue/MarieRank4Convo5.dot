	1652 [label="¿Y qué podría distraerte? ¿Qué podría ser más importante que sentarte y analizar las quejas de los mécontents ?",shape=box,color=blue];
		1652 -> 1676;
	1653 [label="¿Qué tan difícil es sentarse y analizar las quejas de los mécontents ?",shape=box,color=blue];
		1653 -> 1677;
	1654 [label="Oh, magnifique !",shape=box,color=blue];
