		j2952898253 -> j2694541455 [label="false",color=purple];
	j2515192195 [label="Evaluate expressions",color=orange];
		j2515192195 -> j1821266814 [label="MarieEntrati3a",color=purple];
		j2515192195 -> j1821266814 [label="MarieEntrati3b",color=purple];
		j2515192195 -> j3093002041 [label="MarieEntrati3",color=purple];
		j2515192195 -> j1648506085 [label="MarieEntratiFamily",color=purple];
		j2515192195 -> j495403366 [label="MarieEntratiMonster1",color=purple];
		j2515192195 -> j495403366 [label="MarieEntratiMonster2",color=purple];
		j2515192195 -> j3410049922 [label="MarieEntratiFan1",color=purple];
		j2515192195 -> j3410049922 [label="MarieEntratiFan2",color=purple];
		j2515192195 -> j1971047755 [label="MarieEntratiNeutral",color=purple];
		j2515192195 -> j46487937 [label="false",color=purple];
	j3593036855 [label="¿Honestamente? Me distraje.",shape=box,color=red];
		j3593036855 -> j2379365282;
	j2290655299 [label="Podría ir mejor.",shape=box,color=red];
		j2290655299 -> j1973866359;
	j3639963971 [label="Estoy progresando.",shape=box,color=red];
		j3639963971 -> j3582023435;
	j3282801535 [label="Su hija, Euleria, conocida como Madre, y su familia han estado cuidando Deimos durante todo este tiempo.",shape=box,color=red];
		j3282801535 -> j757068915;
	j1173137833 [label="¿Qué nos impide simplemente mover todos los muebles, dejar que los vuelvan a colocar, y luego... hacerlo de nuevo? ¡Podríamos venderlo todo! ¡Obtener ganancias con ce mobilier étrange !",shape=box,color=blue];
		j1173137833 -> j3114640882;
		j1173137833 -> j1135963084;
		j1173137833 -> j3265474423;
	j3367602919 [label="Soy plenamente consciente de nuestras desacuerdos pendientes con respecto a le Cardinal. Intento mantener una conversación civilisée.",shape=box,color=blue];
		j3367602919 -> j760410469;
	j869395697 [label="Entiendo que quizás no quieras discutir cómo resolver los conflictos sin encontrar oportunidades para señalar a aquellos que sientes que son culpables.",shape=box,color=blue];
		j869395697 -> j760410469;
	j2497799312 [label="Oui ! Como sueles recordarme, ¡crees que es un monstre ! ¡Sólo con rencor y vacío en el corazón!",shape=box,color=blue];
		j2497799312 -> j760410469;
	j817815978 [label="¿Creí que estabas de mi lado en esta guerra por el alma de le Cardinal?",shape=box,color=blue];
		j817815978 -> j1305892640;
	j2049817170 [label="Creía que no te habías decidido sobre le Cardinal. ¿O eso ha cambiado?",shape=box,color=blue];
		j2049817170 -> j998728845;
		j2049817170 -> j3627917506;
	j522194216 [label="Oui. Eso lo estoy aprendiendo con M'sieur Tagfer...",shape=box,color=blue];
		j522194216 -> j1041131476;
	j3322629822 [label="No me hables de heridas cicatrizadas, lobo. Todavía me lamo las mías por nuestra última conversación sobre le Cardinal.",shape=box,color=blue];
		j3322629822 -> j760410469;
	j3370180148 [label="Oui, pero lo dijiste antes: todos debemos dejar de culparnos unos a otros por estas heridas que sufrimos.",shape=box,color=blue];
		j3370180148 -> j2184422293;
	j3162193704 [label="Sé que crees que le Cardinal es una especie de monstruo horrible por causar tales heridas.",shape=box,color=blue];
		j3162193704 -> j760410469;
	j3410049922 [label="Sé que estás de mi lado en esta guerra por el alma de le Cardinal, por lo que te estaré eternamente agradecida.",shape=box,color=blue];
		j3410049922 -> j2694541455;
	j1971047755 [label="Sé que estás evitando juzgarlo, por lo cual estoy inmensamente agradecida.",shape=box,color=blue];
		j1971047755 -> j2694541455;
	j2694541455 [label="Y aunque sé que los demás se apresuran a culparlo, no deseo que nos dividamos y lastimemos cuando podríamos estar juntos.",shape=box,color=blue];
		j2694541455 -> j1580277937;
	j1821266814 [label="Oui, aunque estoy aprendiendo que quizá no a todos en el mismo grado, como le ocurrió a M'sieur Tagfer.",shape=box,color=blue];
		j1821266814 -> j1041131476;
	j3093002041 [label="Y estoy aprendiendo que no a todos al mismo grado, como fuiste tan \"amable\" en señalarme, non ?",shape=box,color=blue];
		j3093002041 -> j760410469;
	j1648506085 [label="Oui, sí! Aunque no culpo a le Cardinal por irse, pues su obra es sagrada...",shape=box,color=blue];
		j1648506085 -> j2694541455;
	j495403366 [label="Y sé que crees que le Cardinal es una especie de monstruo horrible por causar tales heridas.",shape=box,color=blue];
		j495403366 -> j760410469;
	j46487937 [label="Y mientras los demás se apresuran a culparlo por su dolor, yo simplemente no deseo vernos divididos y sufriendo.",shape=box,color=blue];
		j46487937 -> j1580277937;
	j2379365282 [label="¿Y qué podría distraerte? ¿Qué podría ser más importante que sentarte y analizar las quejas de los mécontents ?",shape=box,color=blue];
		j2379365282 -> j1123725909;
	j1973866359 [label="¿Qué tan difícil es sentarse y analizar las quejas de los mécontents ?",shape=box,color=blue];
		j1973866359 -> j3946241605;
	j3582023435 [label="Oh, magnifique !",shape=box,color=blue];
		j3582023435 -> j803068133;
	j757068915 [label="Velando por este lugar y por el corazón que bombea energía del Vacío al Sistema Origen, manteniéndonos a todos... utilizables, realmente, desde que Entrati se fue.",shape=box,color=red];
		j757068915 -> j3916832970;
	j3114640882 [label="No sé si hay mucho mercado para las sillas de Entrati...",shape=box,color=red];
		j3114640882 -> j3620394468;
	j1135963084 [label="¿No acabaríamos saturando el mercado? Tendríamos que venderlos muy baratos...",shape=box,color=red];
		j1135963084 -> j3620394468;
	j3265474423 [label="¡Excelente! No le veo ningún problema.",shape=box,color=red];
		j3265474423 -> j2529578232;
	j760410469 [label="Y aunque entiendo que ambos temas están inexorablemente ligados, me gustaría pedirte que manetngas tu productividad, oui ?",shape=box,color=blue];
		j760410469 -> j954266215;
	j1305892640 [label="¿Qué es este engaño tuyo, lobo? ¿O es que la pequeña Marie es solo un jeu para ti?",shape=box,color=blue];
		j1305892640 -> j461457766;
		j1305892640 -> j3627917506;
	j998728845 [label="Aún no sé qué pienso sobre la necesidad de sus acciones. Pero su crueldad es incuestionable.",shape=box,color=red];
		j998728845 -> j760410469;
	j3627917506 [label="Ya me cansé de fingir, lo siento.",shape=box,color=red];
		j3627917506 -> j2981098814;
	j1041131476 [label="Todos debemos dejar de culparnos unos a otros por estas heridas.",shape=box,color=blue];
		j1041131476 -> j2184422293;
	j2184422293 [label="Tampoco estoy de acuerdo con culpar a le Cardinal, pero no quiero que nos dividamos y nos lastimemos cuando podríamos estar juntos.",shape=box,color=blue];
		j2184422293 -> j3634166711;
		j2184422293 -> j2682261112;
	j1580277937 [label="Todos debemos dejar de culparnos unos a otros por estas heridas, sin importar quién sea el culpable a fin de cuentas.",shape=box,color=blue];
		j1580277937 -> j3634166711;
		j1580277937 -> j2682261112;
	j1123725909 [label="¡Te estoy provocando, es broma! No puedo imaginar lo ocupado que estás, ni todos los lugares y momentos en que te necesitan.",shape=box,color=blue];
		j1123725909 -> j803068133;
	j3946241605 [label="¡Te estoy provocando, es broma! No puedo comprender lo que han soportado. Y lo difícil que es para ti desenredarlo.",shape=box,color=blue];
		j3946241605 -> j803068133;
	j803068133 [label="Simplemente me preocupa que, si no resuelven sus problemas, jamás podremos aspirar a ser bienvenidos en su mesa. El problema mayor sigue sin resolverse:",shape=box,color=blue];
		j803068133 -> j1657751375;
	j3916832970 [label="Check /Lotus/Scripts/1999/DialogueScriptNodes.lua:IsSyndicateRank(syndicate=EntratiSyndicate, syndicateRank=5)",color=orange];
		j3916832970 -> j2719225676 [label=true,color=green];
		j3916832970 -> j3337182392 [label=false,color=brown];
	j3620394468 [label="¡Pff! Sigo pensando que es un experimento que vale la pena. ¡Quizás podamos encerrar al diablo en un montón de estanterías!",shape=box,color=blue];
		j3620394468 -> j254745515;
	j2529578232 [label="Voy a ignorar tu sarcasmo, porque creo que es un experimento que vale la pena. ¡Quizás podamos encerrar al diablo en un montón de estanterías!",shape=box,color=blue];
		j2529578232 -> j254745515;
	j954266215 [label="Busco ayudarnos a todos en esta… extraña coexistencia en la que nos encontramos, no para discutir.",shape=box,color=blue];
		j954266215 -> j1041131476;
	j461457766 [label="No, no es un juego. Pero no se puede confiar en Entrati, y no sé cómo convencerte más que fingiendo estar de tu lado.",shape=box,color=red];
		j461457766 -> j2719961087;
	j2981098814 [label="Oui ? Bueno, me alegra decirte que ya no tienes que hacerlo.",shape=box,color=blue];
		j2981098814 -> j1509439757;
	j3634166711 [label="Juntos, todos, somos... una familia extraña. Pero una familia, al fin y al cabo.",shape=box,color=red];
		j3634166711 -> j1625808289;
	j2682261112 [label="Seríamos más fuertes juntos que separados.",shape=box,color=red];
		j2682261112 -> j2062798946;
		j2682261112 -> j1465864689;
	j2719225676 [label="Ella ha aceptado su ausencia y han hecho las paces, pero fue algo que les costó mucho trabajo.",shape=box,color=red];
		j2719225676 -> j1797869804;
	j3337182392 [label="Check boolean MarieSyndicateMaxRank",color=orange];
		j3337182392 -> j2719225676 [label=true,color=green];
		j3337182392 -> j497019487 [label=false,color=brown];
	j254745515 [label="+20 Chemistry",color=orange];
		j254745515 -> j3927590428;
	j2719961087 [label="Oui ? Bueno, me alegra decirte que has fracasado.",shape=box,color=blue];
		j2719961087 -> j1509439757;
	j1509439757 [label="Boolean MarieEntratiFan1 is now false.",color=orange];
		j1509439757 -> j2631316640;
	j1625808289 [label="Add +1 to Family counter",color=orange];
		j1625808289 -> j2062798946;
		j1625808289 -> j1465864689;
	j2062798946 [label="Y en momentos de sufrimiento, a veces solo nos tenemos el uno al otro. Ya sea a los que nos dieron o a los que encontramos.",shape=box,color=red];
		j2062798946 -> j756830710;
	j1465864689 [label="No sé si ayudaría o perjudicaría a la larga. Pero este... purgatorio tampoco está bien.",shape=box,color=red];
		j1465864689 -> j236874068;
	j1797869804 [label="¿Saber que él todavía está ahí afuera, suelto, y que no le ha dicho ni una palabra, ni le ha enviado una carta...?",shape=box,color=red];
		j1797869804 -> j3522120889;
	j497019487 [label="Ella no ha podido aceptar su ausencia y siguen en desacuerdo.",shape=box,color=red];
		j497019487 -> j3338887631;
	j3927590428 [label="¡Tengo mucho por hacer! À la revoyure !",shape=box,color=blue];
		j3927590428 -> "Chat ends.";
	j2631316640 [label="Boolean MarieEntratiFan2 is now false.",color=orange];
		j2631316640 -> j1508231473;
	j756830710 [label="Add +1 to Family counter",color=orange];
		j756830710 -> j236874068;
	j236874068 [label="Oui, estoy de acuerdo. Pero no puedo ser yo quien disminuya la distancia entre nosotros. ¡No sé cómo! Soy una desconocida para los de arriba...",shape=box,color=blue];
		j236874068 -> j1733160843;
		j236874068 -> j2433868460;
	j3522120889 [label="No puedo imaginar lo doloroso que debe ser esto para ella. Para ellos.",shape=box,color=red];
		j3522120889 -> j2366235883;
	j3338887631 [label="¿Saber que él todavía está ahí afuera, suelto, y que no le ha dicho ni una palabra, ni le ha enviado una carta...?",shape=box,color=red];
		j3338887631 -> j3549381979;
	j1508231473 [label="Boolean MarieNoDate is now true.",color=orange];
		j1508231473 -> "Chat ends.";
	j1733160843 [label="Loid conocía a la familia Entrati. Debería ser él. Convencerlo, sin embargo... es otra historia.",shape=box,color=red];
		j1733160843 -> j3879803054;
	j2433868460 [label="¿Roathe, quizás? Es un Orokin, los conocía a todos.",shape=box,color=red];
		j2433868460 -> j2409273476;
	j2366235883 [label="Si bien entiendo la lógica detrás de la decisión de protegerlos del dolor que le Cardinal causó con su necesaria partida...",shape=box,color=blue];
		j2366235883 -> j1503412507;
	j3549381979 [label="Eso destruiría cualquier pequeña posibilidad de reconciliación que pudieran tener.",shape=box,color=red];
		j3549381979 -> j3894270695;
	j3879803054 [label="+5 Chemistry",color=orange];
		j3879803054 -> j2245323177;
	j2409273476 [label="Non, el diablo no, cualquiera menos el diablo. Pero has dado con algo. La opción natural es Monsieur Loid, non ?",shape=box,color=blue];
		j2409273476 -> j1497016771;
	j1503412507 [label="Me parece innecesariamente cruel, ¿no crees ? Podrían pensar que está muerto. ¡O peor! Y nosotros, viviendo aquí comme des rats d'égout ?",shape=box,color=blue];
		j1503412507 -> j4262135412;
		j1503412507 -> j2360444181;
		j1503412507 -> j85101819;
	j3894270695 [label="Oui... Ya veo la lógica. Yo trabajaría para recomponer a su familia, si es posible, non ? Parece ser la única esperanza que tenemos para salir de aquí. ",shape=box,color=blue];
		j3894270695 -> j2488548906;
	j2245323177 [label="Oui, oui ! C'est ça !  Pero ¿cómo lo convencemos? Se ha mantenido firme en su posición, non ?",shape=box,color=blue];
		j2245323177 -> j1350341486;
		j2245323177 -> j2710880109;
	j1497016771 [label="Pero ¿cómo lo convencemos? Se ha mantenido firme en su posición, non ?",shape=box,color=blue];
		j1497016771 -> j2710880109;
		j1497016771 -> j1350341486;
	j4262135412 [label="De hecho, tengo una amiga que adora las ratas. Me parecen adorables.",shape=box,color=red];
		j4262135412 -> j1615831423;
	j2360444181 [label="En realidad, esa decisión no depende de mí.",shape=box,color=red];
		j2360444181 -> j989046421;
	j85101819 [label="¿Qué me sugieres hacer?",shape=box,color=red];
		j85101819 -> j4045256422;
	j2488548906 [label="Para que no pasemos el resto de nuestras vidas atrapados aquí, comme des rats d'égout. ",shape=box,color=blue];
		j2488548906 -> j2903538917;
		j2488548906 -> j1563533639;
	j1350341486 [label="¿Crees que tú o Lyon podrían convencerlo?",shape=box,color=red];
		j1350341486 -> j491704692;
	j2710880109 [label="No te va a gustar mi respuesta, Marie...",shape=box,color=red];
		j2710880109 -> j3399053819;
	j1615831423 [label="Y me encantaría conocerla algún día, pero ese no es precisamente el punto, lobito tonto.",shape=box,color=blue];
		j1615831423 -> j4045256422;
	j989046421 [label="Lo sé. Darse a conocer es decisión de Monsieur Loid y de todos los demás.",shape=box,color=blue];
		j989046421 -> j4045256422;
	j4045256422 [label="Yo diría que es la culpa, no la nobleza, lo que nos mantiene aquí.",shape=box,color=blue];
		j4045256422 -> j2552954181;
	j2903538917 [label="De hecho, tengo una amiga que adora las ratas. Me parecen adorables. ",shape=box,color=red];
		j2903538917 -> j1615831423;
	j1563533639 [label="He sido negligente. Tienes razón. Me pondré a trabajar.",shape=box,color=red];
		j1563533639 -> j2305579946;
	j491704692 [label="Le caemos bien, es amable y gentil. Pero somos desconocidos para él, recién llegados.",shape=box,color=blue];
		j491704692 -> j60552140;
	j3399053819 [label="Ah bon ?",shape=box,color=blue];
		j3399053819 -> j443212832;
	j2552954181 [label="Que estamos escondiendo algún gran y terrible pecado.",shape=box,color=blue];
		j2552954181 -> j2105593118;
	j2305579946 [label="Gracias. No sé si puedas hacerlo, pero a veces lo único que podemos hacer es intentarlo.",shape=box,color=blue];
		j2305579946 -> j4045256422;
	j60552140 [label="Lo pensaré. ¡Hazlo tú también! Encontraremos una solución. ¡Sol nos ha guiado hasta aquí!",shape=box,color=blue];
		j60552140 -> j3256735832;
	j443212832 [label="Loid podría escuchar a Roathe. Como es un Orokin, su historia compartida podría ser útil en este caso.",shape=box,color=red];
		j443212832 -> j3141453693;
	j2105593118 [label="¿Y ese pecado es el que debe ser perdonado, o tal vez demostrado como falso?",shape=box,color=blue];
