digraph {
	0 [label="MarieRank1Convo1 begins.",color=orange];
		0 -> 1;
	1 [label="Bonjour, bonjour, Viajero ! ¿Cómo te va en este bello día? O tarde. La verdad no sé qué hora es aquí.",shape=box,color=blue];
		1 -> 2;
	2 [label="Estoy segura de que uno de esos bibelots que guarda Monsieur Loid es un reloj, pero no puedo determinar cuál es.",shape=box,color=blue];
		2 -> 3;
	3 [label="Me da miedo tocar cualquiera de los dispositivos de este extraño santuario. Estoy convencida de que podría terminar varada en algún tiempo remoto o calentando una taza de té.",shape=box,color=blue];
		3 -> 5;
		3 -> 6;
		3 -> 4;
	5 [label="Quizá sea mejor no presionar botones si no sabes qué hacen. ",shape=box,color=red];
		5 -> 8;
	6 [label="Seguro estarás bien.",shape=box,color=red];
		6 -> 9;
	4 [label="[Fin]",shape=box,color=red];
		4 -> 7;
	8 [label="Excelente consejo, sin duda. Monsieur Loid me contó que tuviste tu propia aventure temporelle. Me pregunto...",shape=box,color=blue];
		8 -> 10;
	9 [label="C'est très gentil de votre part, pero... a ti no te llevaron a otro... ah, momento, sí fue así.",shape=box,color=blue];
		9 -> 11;
	7 [label="Chat ends.",color=orange];
	10 [label="¿Fue tan peligrosa como esta?",shape=box,color=blue];
		10 -> 12;
		10 -> 13;
	11 [label="Lo entiendes, ¿verdad? Perdóname. ¿Tu propia aventura fue tan peligrosa como esta?",shape=box,color=blue];
		11 -> 12;
		11 -> 13;
	12 [label="¿La época en sí? ¿O mi estancia allí en particular?",shape=box,color=red];
		12 -> 14;
	13 [label="Era diferente, pero te prometo que aquí estás a salvo.",shape=box,color=red];
		13 -> 15;
	14 [label="+10 Chemistry",color=orange];
		14 -> 16;
	15 [label="Agradezco mucho tu voto de confianza, pero no comparto ese sentimiento. Sobre todo cuando me cuesta tanto leer la hora.",shape=box,color=blue];
		15 -> 17;
	16 [label="Es bueno hacer la distinción. Dudo mucho que tu experiencia pasada haya sido \"normal\" según los estándares generales. Por lo que sé, parece que no.",shape=box,color=blue];
		16 -> 18;
	17 [label="Uno esperaría que hubiera uno en la esquina de esta... \"pantalla\", ¡pero no lo hay! En mi opinión, es mauvaise qualité.",shape=box,color=blue];
		17 -> 19;
	18 [label="Me refería a \"la época en sí\". Permíteme reformularlo...",shape=box,color=blue];
		18 -> 20;
	19 [label="¡Pero ya nos alejamos mucho de mi pregunta!",shape=box,color=blue];
		19 -> 20;
	20 [label="¿Esa época \"pasada\" a la que viajaste y que en realidad está mucho más cerca del \"pasado lejano\" del que vengo, era más o menos peligrosa que este tiempo en el que nos encontramos ahora?",shape=box,color=blue];
		20 -> 21;
	21 [label="(Cielos ! Me encanta esto, tengo que decir que es mucho más interesante que desempolvar los utensilios de la comunión).",shape=box,color=blue];
		21 -> 22;
		21 -> 23;
		21 -> 24;
		21 -> 25;
	22 [label="Creo que es más o menos lo mismo. Las armas son diferentes y puede que aún no sepan a qué se enfrentan, pero la guerra es la guerra, y la muerte es la muerte.",shape=box,color=red];
		22 -> 26;
	23 [label="Creo que estos tiempos son menos peligrosos. Estamos mejor preparados para afrontar los desafíos que enfrentamos. Esto apenas comienza.",shape=box,color=red];
		23 -> 27;
	24 [label="Creo que estos tiempos son más peligrosos. Aunque todavía tenemos en común a los infestados, en aquel entonces usaban armas mucho más rudimentarias.",shape=box,color=red];
		24 -> 27;
	25 [label="Sinceramente, me alegra que te diviertas. Puede ser un poco difícil acostumbrarse a todo de golpe.",shape=box,color=red];
		25 -> 28;
	26 [label="+5 Chemistry",color=orange];
		26 -> 29;
	27 [label="Quizás tengas razón. Lo pensaré. Gracias.",shape=box,color=blue];
		27 -> 30;
	28 [label="+5 Chemistry",color=orange];
		28 -> 31;
	29 [label="Como todas las cosas, supongo que es algo relativo, non ? El depredador que nos mata hoy es tan letal como el que nos cazaba entonces. Simplemente está afilando sus dientes.",shape=box,color=blue];
		29 -> 32;
		29 -> 33;
	30 [label="Chat ends.",color=orange];
	31 [label="Le Cardinal Dimanche, tu Albrecht Entrati, me preparó para esto. A diferencia de mi querido Lyon, creí en sus palabras como hechos. Y a diferencia de Lyon, veo esto como una gran aventura, no como una carga.",shape=box,color=blue];
		31 -> 34;
	32 [label="A menos que seas un orokin y hayas encontrado una forma de evitar la muerte... en teoría, si no en la práctica.",shape=box,color=red];
		32 -> 35;
	33 [label="Me da gusto ver que te estás adaptando bien al futuro.",shape=box,color=red];
		33 -> 36;
	34 [label="Servir a las Luminarias no tiene por qué ser un acto de sufrimiento. Siempre hemos discrepado en eso.",shape=box,color=blue];
		34 -> 37;
	35 [label="Y creo que el diablo es un ejemplo perfecto de por qué la muerte es el mayor regalo que Lua nos ha dado jamás.",shape=box,color=blue];
		35 -> 38;
	36 [label="+5 Chemistry",color=orange];
		36 -> 39;
	37 [label="Update boolean MarieLyonSuffering1",color=orange];
		37 -> 40;
	38 [label="Update boolean MarieRoathe1",color=orange];
		38 -> 41;
	39 [label="Le Cardinal Dimanche, tu Albrecht Entrati, me preparó para esto. A diferencia de mi querido Lyon, creí en sus palabras como hechos. Y a diferencia de Lyon, veo esto como una gran aventura, no como una carga.",shape=box,color=blue];
		39 -> 42;
	40 [label="¡Y no evadas mi pregunta, eh! ¿Cuál época es más peligrosa?",shape=box,color=blue];
		40 -> 43;
		40 -> 44;
		40 -> 45;
	41 [label="Oh ! Ese es el sonido de reloj que sí reconozco, aunque todavía no sé dónde está. En fin, me temo que tengo que irme. Esto fue maravilloso. ¡Hasta que nos volvamos a \"ver\"! Aux Dieux !",shape=box,color=blue];
		41 -> 46;
	42 [label="Servir a las Luminarias no tiene por qué ser un acto de sufrimiento. Siempre hemos discrepado en eso.",shape=box,color=blue];
		42 -> 47;
	43 [label="Creo que esta es más mortal. ¿Cuántos enemigos invencibles intentan matarnos?",shape=box,color=red];
		43 -> 48;
	44 [label="Creo que nuestra época es menos peligrosa. Simplemente están descubriendo nuevas formas de matarse entre sí. Nuestros métodos son quizás un poco más emocionantes.",shape=box,color=red];
		44 -> 48;
	45 [label="Creo que al final son igual de peligrosas. La muerte es la muerte, ¿no?",shape=box,color=red];
		45 -> 49;
	46 [label="Chat ends.",color=orange];
	47 [label="Update boolean MarieLyonSuffering1",color=orange];
		47 -> 41;
	48 [label="Quizás tengas razón. Lo pensaré. Gracias.",shape=box,color=blue];
		48 -> 50;
	49 [label="+5 Chemistry",color=orange];
		49 -> 51;
	50 [label="Chat ends.",color=orange];
	51 [label="Como todas las cosas, supongo que es algo relativo, non ? El depredador que nos mata hoy es tan letal como el que nos cazaba entonces. Simplemente está afilando sus dientes.",shape=box,color=blue];
		51 -> 52;
		51 -> 53;
	52 [label="Como alguien que intenta defenderse del lobo, ya estoy cansado de lidiar con esto.",shape=box,color=red];
		52 -> 54;
	53 [label="A menos que seas un orokin y hayas encontrado una forma de evitar la muerte... en teoría, si no en la práctica.",shape=box,color=red];
		53 -> 55;
	54 [label="Creo que es más probable que tú, querido Viajero, huyas y te unas a la manada de lobos a que te enfrentes a ella. Y lo digo como un cumplido.",shape=box,color=blue];
		54 -> 41;
	55 [label="Y creo que el diablo es un ejemplo perfecto de por qué la muerte es el mayor regalo que Lua nos ha dado jamás.",shape=box,color=blue];
		55 -> 56;
	56 [label="Update boolean MarieRoathe1",color=orange];
		56 -> 41;
}