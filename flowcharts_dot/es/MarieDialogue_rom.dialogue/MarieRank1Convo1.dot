digraph {
	"MarieRank1Convo1 begins." [color=orange];
		"MarieRank1Convo1 begins." -> j1318259646;
	j1318259646 [label="Bonjour, bonjour, Viajero ! ¿Cómo te va en este bello día? O tarde. La verdad no sé qué hora es aquí.",shape=box,color=blue];
		j1318259646 -> j1176856834;
	j1176856834 [label="Estoy segura de que uno de esos bibelots que guarda Monsieur Loid es un reloj, pero no puedo determinar cuál es.",shape=box,color=blue];
		j1176856834 -> j85648669;
	j85648669 [label="Me da miedo tocar cualquiera de los dispositivos de este extraño santuario. Estoy convencida de que podría terminar varada en algún tiempo remoto o calentando una taza de té.",shape=box,color=blue];
		j85648669 -> j3795238468;
		j85648669 -> j3170382002;
		j85648669 -> j202800200;
	j3795238468 [label="Quizá sea mejor no presionar botones si no sabes qué hacen. ",shape=box,color=red];
		j3795238468 -> j267526772;
	j3170382002 [label="Seguro estarás bien.",shape=box,color=red];
		j3170382002 -> j80513379;
	j202800200 [label="[Fin]",shape=box,color=red];
		j202800200 -> "Chat ends.";
	j267526772 [label="Excelente consejo, sin duda. Monsieur Loid me contó que tuviste tu propia aventure temporelle. Me pregunto...",shape=box,color=blue];
		j267526772 -> j4108808240;
	j80513379 [label="C'est très gentil de votre part, pero... a ti no te llevaron a otro... ah, momento, sí fue así.",shape=box,color=blue];
		j80513379 -> j3478871788;
	"Chat ends." [color=orange];
	j4108808240 [label="¿Fue tan peligrosa como esta?",shape=box,color=blue];
		j4108808240 -> j1348486452;
		j4108808240 -> j3415325286;
	j3478871788 [label="Lo entiendes, ¿verdad? Perdóname. ¿Tu propia aventura fue tan peligrosa como esta?",shape=box,color=blue];
		j3478871788 -> j1348486452;
		j3478871788 -> j3415325286;
	j1348486452 [label="¿La época en sí? ¿O mi estancia allí en particular?",shape=box,color=red];
		j1348486452 -> j403368249;
	j3415325286 [label="Era diferente, pero te prometo que aquí estás a salvo.",shape=box,color=red];
		j3415325286 -> j3689751379;
	j403368249 [label="+10 Chemistry",color=orange];
		j403368249 -> j3468779129;
	j3689751379 [label="Agradezco mucho tu voto de confianza, pero no comparto ese sentimiento. Sobre todo cuando me cuesta tanto leer la hora.",shape=box,color=blue];
		j3689751379 -> j90889214;
	j3468779129 [label="Es bueno hacer la distinción. Dudo mucho que tu experiencia pasada haya sido \"normal\" según los estándares generales. Por lo que sé, parece que no.",shape=box,color=blue];
		j3468779129 -> j1043937317;
	j90889214 [label="Uno esperaría que hubiera uno en la esquina de esta... \"pantalla\", ¡pero no lo hay! En mi opinión, es mauvaise qualité.",shape=box,color=blue];
		j90889214 -> j2060424688;
	j1043937317 [label="Me refería a \"la época en sí\". Permíteme reformularlo...",shape=box,color=blue];
		j1043937317 -> j2378546193;
	j2060424688 [label="¡Pero ya nos alejamos mucho de mi pregunta!",shape=box,color=blue];
		j2060424688 -> j2378546193;
	j2378546193 [label="¿Esa época \"pasada\" a la que viajaste y que en realidad está mucho más cerca del \"pasado lejano\" del que vengo, era más o menos peligrosa que este tiempo en el que nos encontramos ahora?",shape=box,color=blue];
		j2378546193 -> j3879257675;
	j3879257675 [label="(Cielos ! Me encanta esto, tengo que decir que es mucho más interesante que desempolvar los utensilios de la comunión).",shape=box,color=blue];
		j3879257675 -> j1711823664;
		j3879257675 -> j332893122;
		j3879257675 -> j956304944;
		j3879257675 -> j2206299601;
	j1711823664 [label="Creo que es más o menos lo mismo. Las armas son diferentes y puede que aún no sepan a qué se enfrentan, pero la guerra es la guerra, y la muerte es la muerte.",shape=box,color=red];
		j1711823664 -> j2047064744;
	j332893122 [label="Creo que estos tiempos son menos peligrosos. Estamos mejor preparados para afrontar los desafíos que enfrentamos. Esto apenas comienza.",shape=box,color=red];
		j332893122 -> j2961991473;
	j956304944 [label="Creo que estos tiempos son más peligrosos. Aunque todavía tenemos en común a los infestados, en aquel entonces usaban armas mucho más rudimentarias.",shape=box,color=red];
		j956304944 -> j2961991473;
	j2206299601 [label="Sinceramente, me alegra que te diviertas. Puede ser un poco difícil acostumbrarse a todo de golpe.",shape=box,color=red];
		j2206299601 -> j2102123293;
	j2047064744 [label="+5 Chemistry",color=orange];
		j2047064744 -> j3952759224;
	j2961991473 [label="Quizás tengas razón. Lo pensaré. Gracias.",shape=box,color=blue];
		j2961991473 -> "Chat ends.";
	j2102123293 [label="+5 Chemistry",color=orange];
		j2102123293 -> j1669853894;
	j3952759224 [label="Como todas las cosas, supongo que es algo relativo, non ? El depredador que nos mata hoy es tan letal como el que nos cazaba entonces. Simplemente está afilando sus dientes.",shape=box,color=blue];
		j3952759224 -> j2046617403;
		j3952759224 -> j2272753191;
	j1669853894 [label="Le Cardinal Dimanche, tu Albrecht Entrati, me preparó para esto. A diferencia de mi querido Lyon, creí en sus palabras como hechos. Y a diferencia de Lyon, veo esto como una gran aventura, no como una carga.",shape=box,color=blue];
		j1669853894 -> j1846947999;
	j2046617403 [label="A menos que seas un orokin y hayas encontrado una forma de evitar la muerte... en teoría, si no en la práctica.",shape=box,color=red];
		j2046617403 -> j2063854098;
	j2272753191 [label="Me da gusto ver que te estás adaptando bien al futuro.",shape=box,color=red];
		j2272753191 -> j695170913;
	j1846947999 [label="Servir a las Luminarias no tiene por qué ser un acto de sufrimiento. Siempre hemos discrepado en eso.",shape=box,color=blue];
		j1846947999 -> j1056939810;
	j2063854098 [label="Y creo que el diablo es un ejemplo perfecto de por qué la muerte es el mayor regalo que Lua nos ha dado jamás.",shape=box,color=blue];
		j2063854098 -> j680977457;
	j695170913 [label="+5 Chemistry",color=orange];
		j695170913 -> j1110428271;
	j1056939810 [label="Boolean MarieLyonSuffering1 is now true.",color=orange];
		j1056939810 -> j1466878394;
	j680977457 [label="Boolean MarieRoathe1 is now true.",color=orange];
		j680977457 -> j4209557603;
	j1110428271 [label="Le Cardinal Dimanche, tu Albrecht Entrati, me preparó para esto. A diferencia de mi querido Lyon, creí en sus palabras como hechos. Y a diferencia de Lyon, veo esto como una gran aventura, no como una carga.",shape=box,color=blue];
		j1110428271 -> j3748315369;
	j1466878394 [label="¡Y no evadas mi pregunta, eh! ¿Cuál época es más peligrosa?",shape=box,color=blue];
		j1466878394 -> j2704410106;
		j1466878394 -> j1425284458;
		j1466878394 -> j1389778500;
	j4209557603 [label="Oh ! Ese es el sonido de reloj que sí reconozco, aunque todavía no sé dónde está. En fin, me temo que tengo que irme. Esto fue maravilloso. ¡Hasta que nos volvamos a \"ver\"! Aux Dieux !",shape=box,color=blue];
		j4209557603 -> "Chat ends.";
	j3748315369 [label="Servir a las Luminarias no tiene por qué ser un acto de sufrimiento. Siempre hemos discrepado en eso.",shape=box,color=blue];
		j3748315369 -> j3673099243;
	j2704410106 [label="Creo que esta es más mortal. ¿Cuántos enemigos invencibles intentan matarnos?",shape=box,color=red];
		j2704410106 -> j2961991473;
	j1425284458 [label="Creo que nuestra época es menos peligrosa. Simplemente están descubriendo nuevas formas de matarse entre sí. Nuestros métodos son quizás un poco más emocionantes.",shape=box,color=red];
		j1425284458 -> j2961991473;
	j1389778500 [label="Creo que al final son igual de peligrosas. La muerte es la muerte, ¿no?",shape=box,color=red];
		j1389778500 -> j767672461;
	j3673099243 [label="Boolean MarieLyonSuffering1 is now true.",color=orange];
		j3673099243 -> j4209557603;
	j767672461 [label="+5 Chemistry",color=orange];
		j767672461 -> j2006831884;
	j2006831884 [label="Como todas las cosas, supongo que es algo relativo, non ? El depredador que nos mata hoy es tan letal como el que nos cazaba entonces. Simplemente está afilando sus dientes.",shape=box,color=blue];
		j2006831884 -> j3703443284;
		j2006831884 -> j2046617403;
	j3703443284 [label="Como alguien que intenta defenderse del lobo, ya estoy cansado de lidiar con esto.",shape=box,color=red];
		j3703443284 -> j1451540254;
	j1451540254 [label="Creo que es más probable que tú, querido Viajero, huyas y te unas a la manada de lobos a que te enfrentes a ella. Y lo digo como un cumplido.",shape=box,color=blue];
		j1451540254 -> j4209557603;
}