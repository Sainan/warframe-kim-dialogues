		2766 -> 2773;
	2767 [label="¿Y me dices esto mientras le confiesas tu amor al hermano de mi alma? ¿Acaso crees que nos vas a tomar el pelo a los dos?",shape=box,color=blue];
		2767 -> 2774;
	2768 [label="¿¡Y me dices esto mientras te ves con el diablo?! ¿¡Acaso crees que nos vas a tomar el pelo a los dos?!",shape=box,color=blue];
