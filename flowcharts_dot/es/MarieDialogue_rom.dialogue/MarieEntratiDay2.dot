	2699 [label="Simplemente no quiero que tu opinión sobre mí cambie si te confieso toda la verdad. Parece algo tan insignificante y pathétique.",shape=box,color=blue];
		2699 -> 2709;
		2699 -> 2710;
	2700 [label="Update boolean MarieEntratiCompleteB",color=orange];
		2700 -> 2711;
	2701 [label="Permítanme explicarte, sencillamente, por qué me resulta tan difícil dejar de defender a le Cardinal. Y por qué tardé en comprender por qué no podía dejarlo ir.",shape=box,color=blue];
		2701 -> 2699;
	2702 [label="Pobrecita ingenua Marie... claro, él no era lo que parecía.",shape=box,color=blue];
		2702 -> 2712;
		2702 -> 2713;
	2703 [label="Creo que ya sé de qué se trata. ",shape=box,color=red];
		2703 -> 2714;
	2704 [label="No te juzgaré, Marie. Te lo prometo.",shape=box,color=red];
		2704 -> 2715;
	2705 [label="Add -10 to Family",color=orange];
		2705 -> 2716;
	2706 [label="Bien. Al menos tenemos un acuerdo.",shape=box,color=blue];
		2706 -> 2717;
	2707 [label="¿Para ir a la cama conmigo? ¡Es repugnante!",shape=box,color=blue];
		2707 -> 2718;
	2708 [label="¿Para usarme? ¡Es repugnante!",shape=box,color=blue];
		2708 -> 2718;
	2709 [label="Creo que ya sé de qué se trata. ",shape=box,color=red];
		2709 -> 2719;
	2710 [label="No te juzgaré, Marie. Te lo prometo.",shape=box,color=red];
		2710 -> 2720;
	2711 [label="Update boolean MarieNoDate",color=orange];
		2711 -> 2721;
	2712 [label="No eres ninguna tonta, Marie. Todo lo contrario. Esto me demuestra lo maravillosa que eres en realidad.",shape=box,color=red];
		2712 -> 2722;
	2713 [label="Te has vuelto muy importante para mí, Marie... y lamento mucho que esta conversación haya tomado este rumbo.",shape=box,color=red];
		2713 -> 2722;
	2714 [label="Supongo que te resultará obvio, non ? Como alguien que también perdió a su familia. ",shape=box,color=blue];
		2714 -> 2723;
	2715 [label="Ya veremos. Creo que, al final, vi en él un poco del padre que me abandonó, por pequeño y triste que me parezca ahora.",shape=box,color=blue];
		2715 -> 2723;
	2716 [label="Je ne pense pas.",shape=box,color=blue];
		2716 -> 2724;
	2717 [label="À la revoyure.",shape=box,color=blue];
		2717 -> 2725;
	2718 [label="Así que debo decir que jamás podría confiarte mi corazón. Lamento estas palabras, que deben ser una decepción",shape=box,color=blue];
		2718 -> 2726;
	2719 [label="Supongo que te resultará obvio, non ? Como alguien que también perdió a su familia. ",shape=box,color=blue];
		2719 -> 2727;
	2720 [label="Ya veremos. Creo que, al final, vi en él un poco del padre que me abandonó, por pequeño y triste que me parezca ahora.",shape=box,color=blue];
		2720 -> 2727;
	2721 [label="Chat ends.",color=orange];
	2722 [label="Pero necesitaba que vieras que Entrati podía ser complicado. Que podía causar daño en igual medida. No quería que te lastimara más después.",shape=box,color=red];
		2722 -> 2728;
	2723 [label="Pensar... que después de todos estos años, alguien podría convencerme ofreciéndome tanta amabilidad.",shape=box,color=blue];
		2723 -> 2729;
	2724 [label="Update boolean MarieEntratiCompleteB",color=orange];
		2724 -> 2730;
	2725 [label="Update boolean MarieEntratiCompleteC",color=orange];
		2725 -> 2731;
	2726 [label="Pero me temo que no. Espero que esto no te sorprenda.",shape=box,color=blue];
		2726 -> 2732;
	2727 [label="Pensar... que después de todos estos años, alguien podría convencerme ofreciéndome tanta amabilidad.",shape=box,color=blue];
		2727 -> 2733;
	2728 [label="Ingenuamente, creo que intentaba hacer todo esto para protegerte. ",shape=box,color=red];
		2728 -> 2734;
	2729 [label="Pobrecita ingenua Marie... claro, él no era lo que parecía.",shape=box,color=blue];
		2729 -> 2735;
	2730 [label="Update boolean MarieWillDate",color=orange];
		2730 -> 2736;
	2731 [label="Update boolean MarieWillDate",color=orange];
		2731 -> 2737;
	2732 [label="¿Y en cuanto a le Cardinal? Supongo que seguiremos teniendo opiniones distintas al respecto. Como con nuestros sentimientos.",shape=box,color=blue];
		2732 -> 2738;
	2733 [label="Pobrecita ingenua Marie... claro, él no era lo que parecía.",shape=box,color=blue];
		2733 -> 2739;
		2733 -> 2735;
	2734 [label="Evaluate expressions",color=orange];
		2734 -> 2740 [label="LyonDating",color=purple];
		2734 -> 2741 [label="RoatheDating",color=purple];
		2734 -> 2742 [label="false",color=purple];
	2735 [label="No, él fue amable contigo. Eso no es mentira. Pero eso no significa que siempre sea así y que no sea capaz de otras cosas.",shape=box,color=red];
		2735 -> 2743;
	2736 [label="Chat ends.",color=orange];
	2737 [label="Chat ends.",color=orange];
	2738 [label="Au revoir.",shape=box,color=blue];
		2738 -> 2744;
	2739 [label="[Confesar sentimientos] No eres ninguna tonta, Marie. Todo lo contrario. Esto me demuestra lo maravillosa que eres en realidad.",shape=box,color=red];
		2739 -> 2745;
	2740 [label="¿Y me dices esto mientras le confiesas tu amor al hermano de mi alma? ¿Acaso crees que nos vas a tomar el pelo a los dos?",shape=box,color=blue];
		2740 -> 2746;
	2741 [label="¿¡Y me dices esto mientras te ves con el diablo?! ¿¡Acaso crees que nos vas a tomar el pelo a los dos?!",shape=box,color=blue];
		2741 -> 2746;
	2742 [label="Yo... Oh, mon cœur. Mon cœur ! ¡Yo siento lo mismo! Pero no me atreví a decir esas palabras, no me atreví a escribírtelas, porque me creía una tonta por decirlas.",shape=box,color=blue];
		2742 -> 2747;
	2743 [label="Oui, como ya dijiste, y ahora lo entiendo perfectamente. Solo me queda agradecerte una vez más tu paciencia.",shape=box,color=blue];
		2743 -> 2748;
	2744 [label="Update boolean MarieNoDate",color=orange];
		2744 -> 2749;
	2745 [label="Te has vuelto muy importante para mí, Marie... y lamento mucho que esta conversación haya tomado este rumbo.",shape=box,color=red];
		2745 -> 2750;
	2746 [label="Update boolean DrifterMarieWhoops",color=orange];
		2746 -> 2751;
	2747 [label="¡Ah! ¡Me has hecho tan feliz! Me pregunto... ¿qué piensas hacer con esta declaración...?",shape=box,color=blue];
		2747 -> 2752;
		2747 -> 2753;
	2748 [label="En mi desesperación por aferrarme a un padre que ya no está, casi ahuyenté a una familia que aún está aquí.",shape=box,color=blue];
		2748 -> 2754;
	2749 [label="Update boolean MarieEntratiCompleteB",color=orange];
		2749 -> 3890;
	2750 [label="Pero necesitaba que vieras que Entrati podía ser complicado. Que podía causar daño en igual medida. No quería que te lastimara más después.",shape=box,color=red];
		2750 -> 2756;
	2751 [label="Update boolean MarieNoDate",color=orange];
		2751 -> 2757;
	2752 [label="[Invitar a salir.] Bueno, me preguntaba... si te gustaría, bueno... ¿que seamos una pareja?",shape=box,color=red];
		2752 -> 2758;
	2753 [label="Supuse que nos lo tomaríamos con calma. Todavía nos estamos conociendo.",shape=box,color=red];
		2753 -> 2759;
	2754 [label="Y creo que no soy la única, non ? Creo que ahora tengo la capacidad suficiente para ayudar en la batalla que libramos contra los de arriba, oui ?",shape=box,color=blue];
		2754 -> 2760;
	3890 [label="Update boolean MarieFamilyFail",color=orange];
		3890 -> 2755;
	2756 [label="Creo que ingenuamente intentaba hacer todo esto para protegerte. ",shape=box,color=red];
		2756 -> 2761;
	2757 [label="Tu crois pouvoir débarquer ici depuis le futur et tous nous manipuler comme des marionnettes ?! Je te suggère de prendre cette machine, de te pencher et de te l'enfoncer fermement dans le derrière, espèce de sale pourriture répugnante et puante !",shape=box,color=blue];
		2757 -> 2762;
	2758 [label="¿Una \"pareja\"? Mi querido lobito, creo que los tiempos han cambiado desde mi época de prometidos y matrimonios concertados... ¡Dudo mucho que me estés pidiendo matrimonio!",shape=box,color=blue];
		2758 -> 2763;
	2759 [label="Sí, es sensato. Muy sensato. Vengo de una época donde el cortejo era formal, oui ? Aunque me gustaría saber cómo han cambiado las cosas.",shape=box,color=blue];
		2759 -> 2764;
		2759 -> 2765;
	2760 [label="+10 Chemistry",color=orange];
