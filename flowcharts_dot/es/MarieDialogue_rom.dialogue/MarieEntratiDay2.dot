digraph {
	2615 [label="MarieEntratiDay2 begins.",color=orange];
		2615 -> 2616;
	2616 [label="Viajero. Me he tomado un tiempo para pensar y... calmarme. Soy muy estricta respecto a entablar conversaciones cuando estoy furieuse.",shape=box,color=blue];
		2616 -> 2617;
	2617 [label="Evaluate expressions",color=orange];
		2617 -> 2618 [label="MarieEntrati5a",color=purple];
		2617 -> 2619 [label="MarieEntrati5b",color=purple];
		2617 -> 2620 [label="MarieEntrati5c",color=purple];
		2617 -> 2621 [label="MarieEntrati5d",color=purple];
		2617 -> 2622 [label="MarieEntrati5e",color=purple];
		2617 -> 2623 [label="MarieEntrati5f",color=purple];
		2617 -> 2624 [label="MarieEntrati5g",color=purple];
		2617 -> 2625 [label="MarieEntrati5h",color=purple];
		2617 -> 2626 [label="MarieEntrati5i",color=purple];
		2617 -> 2627 [label="false",color=purple];
	2618 [label="Fue... una puñalada entre las costillas lo que me hiciste ayer. Admito que huí furiosa, oui, pero también con repulsión. No hacia ti, sino hacia mí misma.",shape=box,color=blue];
		2618 -> 2628;
	2619 [label="Pero antes de continuar, debo aclarar un asunto: el tono con el que me hablas. Sé que me consideras una niña. Tu edad se cuenta en siglos, si no más.",shape=box,color=blue];
		2619 -> 2629;
	2620 [label="He reflexionado mucho sobre tus palabras. Que esta no es una guerra santa y que le Cardinal ha sido manipulador en su forma de actuar.",shape=box,color=blue];
		2620 -> 2630;
	2621 [label="Tenías razón, por supuesto, al preguntarme dónde en las escrituras de Sol se afirma que los inocentes son desechables. No lo dice.",shape=box,color=blue];
		2621 -> 2631;
	2622 [label="Antes de continuar, debo abordar una cuestión: tu disposición a utilizar mi fe en mi contra en una discusión, cuando tú no practicas la fe.",shape=box,color=blue];
		2622 -> 2632;
	2623 [label="Lamento haber huido de nuestra conversación de ayer. Simplemente fue demasiado. Sin embargo, antes de continuar, debo preguntarte: ¿hablabas en serio? ¿O solo intentabas manipular mis sentimientos para evitar una discusión incómoda?",shape=box,color=blue];
		2623 -> 2633;
		2623 -> 2634;
	2624 [label="Parece que hemos llegado a un punto muerto con respecto a le Cardinal, ¿verdad? Tú lo consideras un monstruo y yo un santo.",shape=box,color=blue];
		2624 -> 2635;
	2625 [label="Me gustaría hablar contigo sobre tu decisión de ponerte del lado de Entrati solo para agradarme, si te parece bien.",shape=box,color=blue];
		2625 -> 2636;
	2626 [label="Me gustaría hablar sobre tu mentira, si te parece bien.",shape=box,color=blue];
		2626 -> 2636;
	2627 [label="Chat ends.",color=orange];
	2628 [label="¿Cómo iba a sorprenderme de que tuvieras tan buena puntería? Comparar mis palabras con las del mismísimo diablo...",shape=box,color=blue];
		2628 -> 2637;
	2629 [label="Has viajado por dimensiones desconocidas, por el Vacío mismo. Has luchado contra dioses y ángeles. ¿Quién soy yo para ti? Solo la pequeña y tonta Marie.",shape=box,color=blue];
		2629 -> 2638;
	2630 [label="Y creo que... oui, tienes razón. Esta no es una guerra santa. Porque tal cosa no existe. La guerra nunca es santa, justa ni correcta. El dolor jamás debería ser lo que nos guía.",shape=box,color=blue];
		2630 -> 2639;
	2631 [label="La guerra nunca es santa, justa ni correcta. El dolor nunca debería ser la luz que nos guíe.",shape=box,color=blue];
		2631 -> 2639;
	2632 [label="Eso fue deshonesto, Viajero. Cruel e ineficaz. Fue un intento de \"ganar\" una conversación, y no es así como uno debe comportarse.",shape=box,color=blue];
		2632 -> 2640;
	2633 [label="Lo que dije fue sincero. Lamento si no fue el momento correcto. Me importas mucho, Marie...",shape=box,color=red];
		2633 -> 2641;
	2634 [label="No lo decía en serio, simplemente... me dejé llevar. Lo siento muchísimo. Fue la pasión del momento.",shape=box,color=red];
		2634 -> 2642;
	2635 [label="Sin embargo... no quiero que las cosas entre nosotros queden así. Eres una persona bondadosa, y hay mucho entre nosotros que no quiero que nos aleje.",shape=box,color=blue];
		2635 -> 2946;
	2636 [label="Intentar manipular la situación para controlar mis sentimientos es... deshonesto y cruel. Admito que me muero de ganas de odiarte por ello, Viajero.",shape=box,color=blue];
		2636 -> 2644;
	2637 [label="Me consideraba una persona con la mente y el corazón abiertos al mundo y a todos los que lo habitan. Y tú, de forma concisa y con un solo golpe, me demostraste lo contrario.",shape=box,color=blue];
		2637 -> 2645;
	2638 [label="Por un lado, lo entiendo. Comprendo la situación. Ambos perdimos la calma. Pero por otro lado, te pido que me trates con más delicadeza y tacto.",shape=box,color=blue];
		2638 -> 2646;
	2639 [label="Incluso lo que hacemos ahora —destruir al Murmullo y luchar contra todos tus numerosos enemigos— no es el camino de las Luminarias.",shape=box,color=blue];
		2639 -> 2647;
	2640 [label="La fe no es, ni debería ser jamás, un arma para usar contra otro. Es un escudo. Una luz en la oscuridad. Una voz que guía el camino.",shape=box,color=blue];
		2640 -> 2648;
	2641 [label="Antes de afrontar la enormidad de eso, debo explicarme con respecto a le Cardinal, s'il vous plaît.",shape=box,color=blue];
		2641 -> 2649;
	2642 [label="Update boolean DrifterMarie",color=orange];
		2642 -> 2650;
	2946 [label="Check boolean LoidFamilyComplete",color=orange];
		2946 -> 2651 [label=true,color=green];
		2946 -> 2643 [label=false,color=brown];
	2644 [label="Sin embargo... no quiero que las cosas entre nosotros queden así. Hay mucho entre nosotros que no quiero que nos afecte.",shape=box,color=blue];
		2644 -> 1395;
	2645 [label="Supongo que estoy aquí pour m'excuser, para pedir disculpas por haberme aferrado a mi postura de forma tan imprudente. Espero que lo entiendas.",shape=box,color=blue];
		2645 -> 2653;
		2645 -> 2654;
	2646 [label="Porque he vivido en la calle. He vivido cada día de mi vida en una agonía física. He conocido el desamor, he conocido el amor, he conocido el miedo y el rechazo. He conocido la vida y la pérdida.",shape=box,color=blue];
		2646 -> 2655;
	2647 [label="Aunque sea necesario alzar la espada para evitar que el mundo sea invadido por gente como ellos, no debe ser venerada. Y desde luego, no es excusable cuando esto perjudica a inocentes.",shape=box,color=blue];
		2647 -> 2656;
	2648 [label="¿Y que intentaras usarlo en mi contra para simplemente \"derrotarme\"? Fue una táctica cobarde. Pero ambos nos enojamos, y te perdonaré, si tú me perdonas, por las palabras que dije con ira.",shape=box,color=blue];
		2648 -> 2657;
		2648 -> 2658;
	2649 [label="Creo que me resulta difícil dejar de defender a le Cardinal... y me llevó algún tiempo comprender por qué no podía dejarlo ir.",shape=box,color=blue];
		2649 -> 2659;
	2650 [label="No, entiendo... ¿Cuántos asesinatos se han cometido como \"crímenes pasionales\", oui? Ciertamente, también se han concebido muchos niños en momentos así.",shape=box,color=blue];
		2650 -> 2660;
	2651 [label="Y te has vuelto importante para mí en tan poco tiempo... Nuestras conversaciones me han resultado muy joyeuses.",shape=box,color=blue];
		2651 -> 2661;
	2643 [label="En efecto, sigo deseando ver a Monsieur Loid reunido con los de arriba. Deseo que la familia de le Cardinal encuentre consuelo, ¡y tú eres el camino para lograrlo! ",shape=box,color=blue];
		2643 -> 2651;
	1395 [label="Check boolean LoidFamilyComplete",color=orange];
		1395 -> 2662 [label=true,color=green];
		1395 -> 2652 [label=false,color=brown];
	2653 [label="Sí. Y te pido perdón si mis palabras te hirieron. Simplemente no sabía cómo expresarlas de otra manera.",shape=box,color=red];
		2653 -> 2663;
	2654 [label="Me alegra que me entiendas. Estaba empezando a perder la esperanza.",shape=box,color=red];
		2654 -> 2664;
	2655 [label="Y si de verdad te crees tan superior a todos nosotros, entonces solo verás las nubes en las que estás perdido.",shape=box,color=blue];
		2655 -> 2657;
		2655 -> 2658;
	2656 [label="Así que... admito que le Cardinal no tiene justificación para dañar a otros en nombre de un \"bien mayor\".",shape=box,color=blue];
		2656 -> 2665;
	2657 [label="Fue frustrante, pero no sé cómo hacerte entrar en razón. Entrati no es tu amigo. Ni tu padre.",shape=box,color=red];
		2657 -> 2666;
	2658 [label="Perdón. Perdí el control y dije cosas que no quería decir.",shape=box,color=red];
		2658 -> 2667;
	2659 [label="Simplemente no quiero que tu opinión sobre mí cambie si te confieso toda la verdad. Parece algo tan insignificante y pathétique.",shape=box,color=blue];
		2659 -> 2668;
		2659 -> 2669;
	2660 [label="Estoy... decepcionada. Herida. Pero... te perdono.",shape=box,color=blue];
		2660 -> 2670;
	2661 [label="Evaluate expressions",color=orange];
		2661 -> 2671 [label="DrifterMarie",color=purple];
		2661 -> 2672 [label="DrifterLyon",color=purple];
		2661 -> 2673 [label="DrifterRoathe",color=purple];
		2661 -> 2674 [label="false",color=purple];
	2662 [label="Y todavía podrías mostrar tanta amabilidad hacia mi Lyon e incluso hacia el diablo, supongo...",shape=box,color=blue];
		2662 -> 2675;
		2662 -> 2676;
	2652 [label="En efecto, sigo deseando ver a Monsieur Loid reunido con los de arriba. Deseo que la familia de le Cardinal encuentre consuelo, ¡y tú eres el camino para lograrlo! ",shape=box,color=blue];
		2652 -> 2662;
	2663 [label="+10 Chemistry",color=orange];
		2663 -> 2677;
	2664 [label="Hay que reconocer que es importante ser amable cuando uno \"gana\", ¿sabes?",shape=box,color=blue];
		2664 -> 2678;
		2664 -> 2679;
	2665 [label="¿Pues qué \"bien mayor\" habrá cuando solo queden vidas y corazones destrozados en su camino?",shape=box,color=blue];
		2665 -> 2645;
	2666 [label="Non. Él no es mi padre. Porque mi padre me abandonó en la calle cuando era una niña, y le Cardinal no hizo nada tan cruel.",shape=box,color=blue];
		2666 -> 2680;
	2667 [label="Muchas atrocidades se han cometido en un momento de pasión. Así son las cosas. ",shape=box,color=blue];
		2667 -> 2681;
	2668 [label="Creo que ya sé de qué se trata. ",shape=box,color=red];
		2668 -> 2682;
	2669 [label="No te juzgaré, Marie. Te lo prometo.",shape=box,color=red];
		2669 -> 2683;
	2670 [label="Para... terminar la conversación sobre le Cardinal, si es posible, dejando de lado mi desilusión, s'il te plaît?",shape=box,color=blue];
		2670 -> 2684;
	2671 [label="¿Cómo podría rechazarte, cuando me has confesado lo que sientes?",shape=box,color=blue];
		2671 -> 2685;
	2672 [label="¿Cómo podría rechazarte, si me has confesado lo que sientes por nuestro querido Lyon? Podrías brindarle tanta paz... tanto consuelo...",shape=box,color=blue];
		2672 -> 2685;
	2673 [label="¿Cómo podría rechazarte si pareces tan seguro acerca del diablo? No entiendo tus gustos, pero... parece que estarás de nuestro lado, ¿verdad?",shape=box,color=blue];
		2673 -> 2685;
	2674 [label="No quiero perder tu compañía. ¿Podemos dejar todo esto de lado y decir que, aunque no estemos de acuerdo, podemos seguir adelante?",shape=box,color=blue];
		2674 -> 2686;
		2674 -> 2687;
	2675 [label="Marie, espera. Por favor. Déjame disculparme.",shape=box,color=red];
		2675 -> 2688;
	2676 [label="Sinceramente no pensé que lo que te dije importara; no creí que fuera algo tan serio para ti.",shape=box,color=red];
		2676 -> 2688;
	2677 [label="Lo aprecio más de lo que imaginas, gracias.",shape=box,color=blue];
		2677 -> 2689;
	2678 [label="Sólo estaba bromeando.",shape=box,color=red];
		2678 -> 2690;
	2679 [label="Lo siento. No \"gano\" muy a menudo.",shape=box,color=red];
		2679 -> 2691;
	2680 [label="Update boolean MarieFamilyFail",color=orange];
		2680 -> 2692;
	2681 [label="+5 Chemistry",color=orange];
		2681 -> 2693;
	2682 [label="Supongo que te resultará obvio, non ? Como alguien que también perdió a su familia. ",shape=box,color=blue];
		2682 -> 2694;
	2683 [label="Ya veremos. Creo que, al final, vi en él un poco del padre que me abandonó, por pequeño y triste que me parezca ahora.",shape=box,color=blue];
		2683 -> 2694;
	2684 [label="Creo que me resulta difícil dejar de defender a le Cardinal... y me llevó algún tiempo comprender por qué no podía dejarlo ir.",shape=box,color=blue];
		2684 -> 2695;
	2685 [label="¿Podemos dejar todo esto de lado y decir que, aunque no estemos de acuerdo, podemos seguir adelante?",shape=box,color=blue];
		2685 -> 2686;
		2685 -> 2687;
	2686 [label="No, todavía no he terminado de analizar esto. Necesitamos terminar esta conversación.",shape=box,color=red];
		2686 -> 2696;
	2687 [label="Me parece justo. Estoy de acuerdo.",shape=box,color=red];
		2687 -> 2697;
	2688 [label="Te perdono tus mentiras, Viajero. Podemos seguir siendo amigos y aliados. Pero mentirme como lo has hecho, simplemente para intentar... ¿qué?",shape=box,color=blue];
		2688 -> 2698;
	2689 [label="Creo que me resulta difícil dejar de defender a le Cardinal... y me llevó algún tiempo comprender por qué no podía dejarlo ir.",shape=box,color=blue];
		2689 -> 2699;
	2690 [label="Oui, sí, bueno. ",shape=box,color=blue];
		2690 -> 2689;
	2691 [label="+5 Chemistry",color=orange];
		2691 -> 2690;
	2692 [label="Add -10 to Family",color=orange];
		2692 -> 2700;
	2693 [label="Acepto tu disculpa... ya que yo también dejé que mi temperamento me dominara en varias ocasiones.",shape=box,color=blue];
		2693 -> 2701;
	2694 [label="Pensar... que después de todos estos años, alguien podría convencerme ofreciéndome tanta amabilidad.",shape=box,color=blue];
		2694 -> 2702;
	2695 [label="Simplemente no quiero que tu opinión sobre mí cambie si te confieso toda la verdad. Parece algo tan insignificante y pathétique.",shape=box,color=blue];
