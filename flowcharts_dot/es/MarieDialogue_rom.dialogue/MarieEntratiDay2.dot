		2761 -> 2769 [label="false",color=purple];
	2762 [label="Update boolean MarieEntratiCompleteB",color=orange];
		2762 -> 3889;
	2763 [label="Pero si lo que buscas es una relación más... formal, entonces ¡oui! ¡Oui! Me gustaría.",shape=box,color=blue];
		2763 -> 2764;
		2763 -> 2765;
	2764 [label="Las cosas han evolucionado un poco. No diría que son más \"formales\", pero me alegra mucho... poder mostrarte.",shape=box,color=red];
