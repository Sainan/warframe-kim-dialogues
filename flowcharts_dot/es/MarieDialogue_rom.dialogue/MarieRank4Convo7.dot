	1844 [label="Viajero, excusez-moi... ¿De verdad crees que es sabio ayudar al diablo?",shape=box,color=blue];
		1844 -> 1846;
	1845 [label="Chat ends.",color=orange];
	1846 [label="No deseo rechazar a quienes buscan absolución o ayuda, pero... no creo que sea eso lo que busca el diablo.",shape=box,color=blue];
		1846 -> 1847;
		1846 -> 1848;
		1846 -> 1849;
		1846 -> 1850;
	1847 [label="¿Y qué crees que es lo que busca realmente?",shape=box,color=red];
		1847 -> 1851;
	1848 [label="Sé que ustedes dos no se llevan bien, y lo lamento. Pero no puedo echarlo.",shape=box,color=red];
		1848 -> 1852;
	1849 [label="Roathe ha olvidado más sobre los Orokin —literalmente— de lo que nosotros jamás sabremos. Lo necesitamos.",shape=box,color=red];
		1849 -> 1853;
	1850 [label="[Fin.]",shape=box,color=red];
		1850 -> 1854;
	1851 [label="Es un animal salvaje. Puede que se acerque si le ofreces comida y un lugar cálido donde refugiarse, pero lo olvidará en cuanto dejes de serle útil.",shape=box,color=blue];
		1851 -> 1855;
	1852 [label="Add 1 to Thermostat",color=orange];
		1852 -> 1856;
	1853 [label="Add -1 to Thermostat",color=orange];
		1853 -> 1851;
	1854 [label="Chat ends.",color=orange];
	1855 [label="Él necesita algo de ti. De nosotros. ",shape=box,color=blue];
		1855 -> 1857;
	1856 [label="No, ni sugiero que lo hagas. Simplemente que... no es digno de confianza. Ni ahora ni nunca.",shape=box,color=blue];
		1856 -> 1851;
	1857 [label="Evaluate expressions on HellKeyPlayed",color=orange];
		1857 -> 1859 [label="x > 5",color=purple];
		1857 -> 1858 [label="x <= 5",color=purple];
		1857 -> 1858 [label="false",color=purple];
	1859 [label="Evaluate expressions on HellKeyPlayed",color=orange];
		1859 -> 1863 [label="x >= 21",color=purple];
		1859 -> 1862 [label="x < 21",color=purple];
		1859 -> 1862 [label="false",color=purple];
	1858 [label="Esos recuerdos perdidos, esos horrores pasados de Tau... me preocupa lo que presagian.",shape=box,color=blue];
		1858 -> 1860;
		1858 -> 1861;
	1863 [label="Sé que piensas que hemos descubierto todo lo que hay que saber dentro de su mente destrozada.",shape=box,color=blue];
		1863 -> 1866;
		1863 -> 1861;
	1862 [label="Mientras más sabemos y más profundizamos en su mente destrozada, más me inquieto. El peligro se vuelve más evidente.",shape=box,color=blue];
		1862 -> 1861;
		1862 -> 1860;
	1860 [label="No creo que él solamente desaparezca en cuanto recupere la memoria. Hay algo más en todo esto.",shape=box,color=red];
		1860 -> 1864;
	1861 [label="Probablemente hay algo más que busca. No en sus recuerdos, sino en nosotros.",shape=box,color=red];
		1861 -> 1865;
	1866 [label="Le creo cuando dice que eso es todo lo que descubriremos. Y si es así, ¿por qué sigue aquí?",shape=box,color=red];
		1866 -> 1864;
	1864 [label="Admito que me preocupa más lo que pretende hacer con este conocimiento, que el conocimiento en sí mismo.",shape=box,color=blue];
		1864 -> 1867;
	1865 [label="Oui ! Esa es precisamente mi preocupación. Pero, ¿qué podría ser? ¿Qué utilidad tenemos para él ahora?",shape=box,color=blue];
		1865 -> 1867;
	1867 [label="Sea cual sea su intención al usar esta nueva existencia, me temo que busca involucrarnos. Y solo deseo que no nos dejemos cegar por la esperanza de que sea de alguna manera benigno.",shape=box,color=blue];
		1867 -> 1868;
		1867 -> 1869;
		1867 -> 1870;
	1868 [label="Estoy de acuerdo. No confío en él.",shape=box,color=red];
		1868 -> 1871;
	1869 [label="Es poderoso y sabio. Es alguien a quien preferiría tener de mi lado.",shape=box,color=red];
		1869 -> 1872;
	1870 [label="De nada sirve preguntarse si nos va a traicionar; no lo ha hecho. Y yo no culpo a la gente de pecados que aún no han cometido.",shape=box,color=red];
		1870 -> 1873;
	1871 [label="+20 Chemistry",color=orange];
		1871 -> 1874;
	1872 [label="Add -1 to Thermostat",color=orange];
		1872 -> 1875;
	1873 [label="Add 1 to Thermostat",color=orange];
		1873 -> 1876;
	1874 [label="Bien ! Al menos estaré tranquila sabiendo que otros ojos vigilan a ese demonio. Quizá me ayude a dormir. Gracias.",shape=box,color=blue];
		1874 -> 1877;
	1875 [label="Oui, pero me pregunto cuál será el verdadero precio de esa alianza al final. Puede que no te alegres de haberlo pagado.",shape=box,color=blue];
		1875 -> 1878;
	1876 [label="Oui.. supongo que tienes razón. No podemos asustarnos sin razón. Debemos apoyar a todos aquellos que desean ver derrotada la Indiferencia.",shape=box,color=blue];
		1876 -> 1879;
	1877 [label="Update boolean MarieRoatheNoTrust",color=orange];
		1877 -> 1880;
	1878 [label="Solo quiero aconsejarte que tengas cuidado... es un monstruo con apariencia de caballero. Ten cuidado con él, s'il te plaît ?",shape=box,color=blue];
		1878 -> 1881;
		1878 -> 1882;
	1879 [label="Check boolean DrifterFaithNoMITW",color=orange];
		1879 -> 1883 [label=true,color=green];
		1879 -> 1884 [label=false,color=brown];
	1880 [label="Chat ends.",color=orange];
	1881 [label="Creo que estás siendo algo injusta con él.",shape=box,color=red];
		1881 -> 1885;
	1882 [label="Tendré cuidado. Lo prometo.",shape=box,color=red];
		1882 -> 1886;
	1883 [label="Aunque creas que la fuerza que la impulsa no proviene de un dios sino de nuestra propia mente, sigue siendo una amenaza.",shape=box,color=blue];
		1883 -> 1878;
	1884 [label="Aunque él crea que la fuerza que la impulsa no proviene de un dios sino de nuestras propias mentes, sigue siendo una amenaza.",shape=box,color=blue];
		1884 -> 1878;
	1885 [label="Add -1 to Thermostat",color=orange];
		1885 -> 1887;
	1886 [label="+20 Chemistry",color=orange];
		1886 -> 1888;
	1887 [label="Oui ? ¿Cómo es eso? No lo digo con mala intención, de verdad tengo curiosidad.",shape=box,color=blue];
		1887 -> 1889;
		1887 -> 1890;
		1887 -> 1891;
		1887 -> 1892;
	1888 [label="Merci. Eso es todo lo que pido.",shape=box,color=blue];
		1888 -> 1893;
	1889 [label="Se crió en una sociedad diferente, en otra época, con otras expectativas. Puede que no nos guste, pero así es él.",shape=box,color=red];
		1889 -> 1894;
	1890 [label="Tú y Lyon aceptaron el suero de protoframe de Entrati. Voluntariamente. Él no. ¿Te imaginas cómo es eso?",shape=box,color=red];
		1890 -> 1895;
		1890 -> 1896;
		1890 -> 1894;
	1891 [label="Ha pasado siglos enteros haciendo lo que cree necesario. Simplemente estamos en desacuerdo sobre qué es eso.",shape=box,color=red];
		1891 -> 1895;
		1891 -> 1897;
	1892 [label="Creo que lo que te molesta mucho es su... comportamiento. No sus acciones.",shape=box,color=red];
		1892 -> 1897;
		1892 -> 1895;
	1893 [label="Chat ends.",color=orange];
	1894 [label="Es un militar de alto rango y un miembro de la alta sociedad. Y ambas cosas requieren, a veces, tomar decisiones cuestionables.",shape=box,color=red];
		1894 -> 1898;
	1895 [label="Creo que una persona puede hacer lo que consideramos \"incorrecto\" y haberlo hecho con buenas intenciones.",shape=box,color=red];
		1895 -> 1899;
	1896 [label="Todo lo que hizo fue en nombre de la salvación del Imperio Orokin y su recompensa fue acabar atrapado en este desastre contra su voluntad.",shape=box,color=red];
		1896 -> 1898;
	1897 [label="Creo que no te agrada porque se enorgullece de lo que ha hecho.",shape=box,color=red];
		1897 -> 1900;
	1898 [label="Check boolean MarieGrineer",color=orange];
		1898 -> 1902 [label=true,color=green];
		1898 -> 1901 [label=false,color=brown];
	1899 [label="Puede que tú lo consideres un demonio, pero en su mente nada podría estar más lejos de la realidad.",shape=box,color=red];
		1899 -> 1898;
	1900 [label="Oui, no me agradan quienes se complacen con la muerte. Y me alarma su afán por derramar sangre. Y el hecho de que a ti no te resulte inquietante, me perturba también.",shape=box,color=blue];
		1900 -> 1903;
	1902 [label="Y creo que quienes comandan cualquiera de estos \"Corpus\" o \"Grineer\" contra los que luchas dirían lo mismo. No piensan estar equivocados.",shape=box,color=blue];
		1902 -> 1904;
	1901 [label="Y creo que quienes comandan cualquiera de estos \"Corpus\" o \"Grin-ire\" contra los que luchas dirían lo mismo. No piensan estar equivocados.",shape=box,color=blue];
		1901 -> 1904;
	1903 [label="Es muy fácil adaptar el camino de la abnegación al pecado de la violencia, rechazar su horror, decir que no tiene sentido en nombre de \"lo que importa\".",shape=box,color=blue];
		1903 -> 1905;
	1904 [label="Creen que sus acciones son justas, buenas y necesarias. ¿Cómo puedes tolerar a un demonio y no a otro?",shape=box,color=blue];
		1904 -> 1906;
		1904 -> 1907;
		1904 -> 1908;
		1904 -> 1909;
	1905 [label="Sentir orgullo por el acto en sí... me parece excesivo. No disfruto al quitar una vida, pero él sí. Así que en ese sentido somos muy diferentes.",shape=box,color=blue];
		1905 -> 1910;
	1906 [label="Intentaré detenerlos cuando hagan cosas con las que no esté de acuerdo. Pero... lucharé a su lado cuando sea necesario.",shape=box,color=red];
		1906 -> 1911;
	1907 [label="No creo que esos grupos sean \"buenos\" o \"malos\" por definición. Solo lo son por las acciones que deciden tomar.",shape=box,color=red];
		1907 -> 1912;
	1908 [label="No me corresponde declarar que algunas acciones son \"buenas\" y otras \"malas\". Hago lo que hago para proteger a las personas que lo necesitan.",shape=box,color=red];
		1908 -> 1911;
	1909 [label="Me pides que juzgue a todo un grupo de personas con los mismos criterios que usaría para juzgar a un individuo.",shape=box,color=red];
		1909 -> 1912;
	1910 [label="Solo puedo rezar para que no sea demasiado tarde si el diablo decide clavarte su cuchillo en las costillas. No quiero que tus últimos pensamientos sean \"Marie me lo advirtió\".",shape=box,color=blue];
		1910 -> 1913;
		1910 -> 1914;
	1911 [label="¿Y no crees que el diablo es una amenaza? ¿Que no es peligroso para quienes lo rodean? Podría causar mucho daño.",shape=box,color=blue];
		1911 -> 1915;
		1911 -> 1916;
	1912 [label="¿Y qué hay de los horribles actos que ha cometido? ¿Toda la muerte, la masacre? ¿Acaso consideras justificadas esas acciones?",shape=box,color=blue];
		1912 -> 1916;
	1913 [label="No lo hará. Y si lo intenta, lo detendré.",shape=box,color=red];
		1913 -> 1917;
	1914 [label="Te prometo que esos no serán mis últimos pensamientos.",shape=box,color=red];
		1914 -> 1918;
	1915 [label="Si en algún momento nos traiciona, actuaré. Hasta entonces, ha demostrado ser un aliado incondicional. Aunque... quizá un poco melodramático.",shape=box,color=red];
		1915 -> 1919;
	1916 [label="No considero que su peligrosidad sea un problema. Él es un arma. Y las armas pueden usarse para matar o para proteger.",shape=box,color=red];
		1916 -> 1920;
	1917 [label="Te adoro por la fe que tienes en ti mismo, aunque lamento que tengas fe en él. Así que supongo que yo también tendré fe en ti.",shape=box,color=blue];
		1917 -> 1921;
	1918 [label="Creo que esas palabras no tienen el significado que espero, pero no les daré demasiada importancia.",shape=box,color=blue];
		1918 -> 1921;
	1919 [label="Add 1 to Thermostat",color=orange];
		1919 -> 1910;
	1920 [label="Add -1 to Thermostat",color=orange];
		1920 -> 1910;
	1921 [label="Debo irme. Pero, de nuevo, te lo ruego: ten cuidado. Hazlo por mi, si no lo haces por ti, ¿de acuerdo?",shape=box,color=blue];
		1921 -> 1922;
	1922 [label="+20 Chemistry",color=orange];
		1922 -> 1923;
	1923 [label="Chat ends.",color=orange];
}