		j3255816954 -> "Chat ends." [label="x <= 0",color=purple];
		j3255816954 -> "Chat ends." [label="false",color=purple];
	j3691741719 [label="Viajero, excusez-moi... ¿De verdad crees que es sabio ayudar al diablo?",shape=box,color=blue];
		j3691741719 -> j3247706475;
	"Chat ends." [color=orange];
	j3247706475 [label="No deseo rechazar a quienes buscan absolución o ayuda, pero... no creo que sea eso lo que busca el diablo.",shape=box,color=blue];
		j3247706475 -> j2684795202;
		j3247706475 -> j1554037235;
		j3247706475 -> j1305189343;
		j3247706475 -> j2429168889;
	j2684795202 [label="¿Y qué crees que es lo que busca realmente?",shape=box,color=red];
		j2684795202 -> j1689074099;
	j1554037235 [label="Sé que ustedes dos no se llevan bien, y lo lamento. Pero no puedo echarlo.",shape=box,color=red];
		j1554037235 -> j21389289;
	j1305189343 [label="Roathe ha olvidado más sobre los Orokin —literalmente— de lo que nosotros jamás sabremos. Lo necesitamos.",shape=box,color=red];
		j1305189343 -> j1128009222;
	j2429168889 [label="[Fin.]",shape=box,color=red];
		j2429168889 -> "Chat ends.";
	j1689074099 [label="Es un animal salvaje. Puede que se acerque si le ofreces comida y un lugar cálido donde refugiarse, pero lo olvidará en cuanto dejes de serle útil.",shape=box,color=blue];
		j1689074099 -> j2383800901;
	j21389289 [label="Add 1 to Thermostat counter",color=orange];
		j21389289 -> j2401999072;
	j1128009222 [label="Add -1 to Thermostat counter",color=orange];
		j1128009222 -> j1689074099;
	j2383800901 [label="Él necesita algo de ti. De nosotros. ",shape=box,color=blue];
		j2383800901 -> j863296879;
	j2401999072 [label="No, ni sugiero que lo hagas. Simplemente que... no es digno de confianza. Ni ahora ni nunca.",shape=box,color=blue];
		j2401999072 -> j1689074099;
	j863296879 [label="Evaluate expressions on HellKeyPlayed counter",color=orange];
		j863296879 -> j4093421340 [label="x > 5",color=purple];
		j863296879 -> j4173151422 [label="x <= 5",color=purple];
		j863296879 -> j4173151422 [label="false",color=purple];
	j4093421340 [label="Evaluate expressions on HellKeyPlayed counter",color=orange];
		j4093421340 -> j2009915799 [label="x >= 21",color=purple];
		j4093421340 -> j403760676 [label="x < 21",color=purple];
		j4093421340 -> j403760676 [label="false",color=purple];
	j4173151422 [label="Esos recuerdos perdidos, esos horrores pasados de Tau... me preocupa lo que presagian.",shape=box,color=blue];
		j4173151422 -> j4290972361;
		j4173151422 -> j1146271039;
	j2009915799 [label="Sé que piensas que hemos descubierto todo lo que hay que saber dentro de su mente destrozada.",shape=box,color=blue];
		j2009915799 -> j1623193463;
		j2009915799 -> j1146271039;
	j403760676 [label="Mientras más sabemos y más profundizamos en su mente destrozada, más me inquieto. El peligro se vuelve más evidente.",shape=box,color=blue];
		j403760676 -> j1146271039;
		j403760676 -> j4290972361;
	j4290972361 [label="No creo que él solamente desaparezca en cuanto recupere la memoria. Hay algo más en todo esto.",shape=box,color=red];
		j4290972361 -> j3754918749;
	j1146271039 [label="Probablemente hay algo más que busca. No en sus recuerdos, sino en nosotros.",shape=box,color=red];
		j1146271039 -> j1115641949;
	j1623193463 [label="Le creo cuando dice que eso es todo lo que descubriremos. Y si es así, ¿por qué sigue aquí?",shape=box,color=red];
		j1623193463 -> j3754918749;
	j3754918749 [label="Admito que me preocupa más lo que pretende hacer con este conocimiento, que el conocimiento en sí mismo.",shape=box,color=blue];
		j3754918749 -> j3550773771;
	j1115641949 [label="Oui ! Esa es precisamente mi preocupación. Pero, ¿qué podría ser? ¿Qué utilidad tenemos para él ahora?",shape=box,color=blue];
		j1115641949 -> j3550773771;
	j3550773771 [label="Sea cual sea su intención al usar esta nueva existencia, me temo que busca involucrarnos. Y solo deseo que no nos dejemos cegar por la esperanza de que sea de alguna manera benigno.",shape=box,color=blue];
		j3550773771 -> j3281291018;
		j3550773771 -> j3977800887;
		j3550773771 -> j1073537339;
	j3281291018 [label="Estoy de acuerdo. No confío en él.",shape=box,color=red];
		j3281291018 -> j1886070050;
	j3977800887 [label="Es poderoso y sabio. Es alguien a quien preferiría tener de mi lado.",shape=box,color=red];
		j3977800887 -> j826584770;
	j1073537339 [label="De nada sirve preguntarse si nos va a traicionar; no lo ha hecho. Y yo no culpo a la gente de pecados que aún no han cometido.",shape=box,color=red];
		j1073537339 -> j3672054281;
	j1886070050 [label="+20 Chemistry",color=orange];
		j1886070050 -> j1173864048;
	j826584770 [label="Add -1 to Thermostat counter",color=orange];
		j826584770 -> j766899107;
	j3672054281 [label="Add 1 to Thermostat counter",color=orange];
		j3672054281 -> j3966790395;
	j1173864048 [label="Bien ! Al menos estaré tranquila sabiendo que otros ojos vigilan a ese demonio. Quizá me ayude a dormir. Gracias.",shape=box,color=blue];
		j1173864048 -> j3984234322;
	j766899107 [label="Oui, pero me pregunto cuál será el verdadero precio de esa alianza al final. Puede que no te alegres de haberlo pagado.",shape=box,color=blue];
		j766899107 -> j278728328;
	j3966790395 [label="Oui.. supongo que tienes razón. No podemos asustarnos sin razón. Debemos apoyar a todos aquellos que desean ver derrotada la Indiferencia.",shape=box,color=blue];
		j3966790395 -> j808986917;
	j3984234322 [label="Boolean MarieRoatheNoTrust is now true.",color=orange];
		j3984234322 -> "Chat ends.";
	j278728328 [label="Solo quiero aconsejarte que tengas cuidado... es un monstruo con apariencia de caballero. Ten cuidado con él, s'il te plaît ?",shape=box,color=blue];
		j278728328 -> j946458814;
		j278728328 -> j3977365903;
	j808986917 [label="Check boolean DrifterFaithNoMITW",color=orange];
		j808986917 -> j1116781991 [label=true,color=green];
		j808986917 -> j668036291 [label=false,color=brown];
	j946458814 [label="Creo que estás siendo algo injusta con él.",shape=box,color=red];
		j946458814 -> j3638020312;
	j3977365903 [label="Tendré cuidado. Lo prometo.",shape=box,color=red];
		j3977365903 -> j3084323745;
	j1116781991 [label="Aunque creas que la fuerza que la impulsa no proviene de un dios sino de nuestra propia mente, sigue siendo una amenaza.",shape=box,color=blue];
		j1116781991 -> j278728328;
	j668036291 [label="Aunque él crea que la fuerza que la impulsa no proviene de un dios sino de nuestras propias mentes, sigue siendo una amenaza.",shape=box,color=blue];
		j668036291 -> j278728328;
	j3638020312 [label="Add -1 to Thermostat counter",color=orange];
		j3638020312 -> j1935724123;
	j3084323745 [label="+20 Chemistry",color=orange];
		j3084323745 -> j2974488551;
	j1935724123 [label="Oui ? ¿Cómo es eso? No lo digo con mala intención, de verdad tengo curiosidad.",shape=box,color=blue];
		j1935724123 -> j1502084194;
		j1935724123 -> j3620677035;
		j1935724123 -> j2418624892;
		j1935724123 -> j3744855314;
	j2974488551 [label="Merci. Eso es todo lo que pido.",shape=box,color=blue];
		j2974488551 -> "Chat ends.";
	j1502084194 [label="Se crió en una sociedad diferente, en otra época, con otras expectativas. Puede que no nos guste, pero así es él.",shape=box,color=red];
		j1502084194 -> j496702582;
	j3620677035 [label="Tú y Lyon aceptaron el suero de protoframe de Entrati. Voluntariamente. Él no. ¿Te imaginas cómo es eso?",shape=box,color=red];
		j3620677035 -> j50131975;
		j3620677035 -> j2242986589;
		j3620677035 -> j496702582;
	j2418624892 [label="Ha pasado siglos enteros haciendo lo que cree necesario. Simplemente estamos en desacuerdo sobre qué es eso.",shape=box,color=red];
		j2418624892 -> j50131975;
		j2418624892 -> j3305506382;
	j3744855314 [label="Creo que lo que te molesta mucho es su... comportamiento. No sus acciones.",shape=box,color=red];
		j3744855314 -> j3305506382;
		j3744855314 -> j50131975;
	j496702582 [label="Es un militar de alto rango y un miembro de la alta sociedad. Y ambas cosas requieren, a veces, tomar decisiones cuestionables.",shape=box,color=red];
		j496702582 -> j681163897;
	j50131975 [label="Creo que una persona puede hacer lo que consideramos \"incorrecto\" y haberlo hecho con buenas intenciones.",shape=box,color=red];
		j50131975 -> j2278643726;
	j2242986589 [label="Todo lo que hizo fue en nombre de la salvación del Imperio Orokin y su recompensa fue acabar atrapado en este desastre contra su voluntad.",shape=box,color=red];
		j2242986589 -> j681163897;
	j3305506382 [label="Creo que no te agrada porque se enorgullece de lo que ha hecho.",shape=box,color=red];
		j3305506382 -> j3083828587;
	j681163897 [label="Check boolean MarieGrineer",color=orange];
		j681163897 -> j3249162886 [label=true,color=green];
		j681163897 -> j3910253264 [label=false,color=brown];
	j2278643726 [label="Puede que tú lo consideres un demonio, pero en su mente nada podría estar más lejos de la realidad.",shape=box,color=red];
		j2278643726 -> j681163897;
	j3083828587 [label="Oui, no me agradan quienes se complacen con la muerte. Y me alarma su afán por derramar sangre. Y el hecho de que a ti no te resulte inquietante, me perturba también.",shape=box,color=blue];
		j3083828587 -> j1616573234;
	j3249162886 [label="Y creo que quienes comandan cualquiera de estos \"Corpus\" o \"Grineer\" contra los que luchas dirían lo mismo. No piensan estar equivocados.",shape=box,color=blue];
		j3249162886 -> j1643152817;
	j3910253264 [label="Y creo que quienes comandan cualquiera de estos \"Corpus\" o \"Grin-ire\" contra los que luchas dirían lo mismo. No piensan estar equivocados.",shape=box,color=blue];
		j3910253264 -> j1643152817;
	j1616573234 [label="Es muy fácil adaptar el camino de la abnegación al pecado de la violencia, rechazar su horror, decir que no tiene sentido en nombre de \"lo que importa\".",shape=box,color=blue];
		j1616573234 -> j4183099194;
	j1643152817 [label="Creen que sus acciones son justas, buenas y necesarias. ¿Cómo puedes tolerar a un demonio y no a otro?",shape=box,color=blue];
		j1643152817 -> j377577879;
		j1643152817 -> j2324434432;
		j1643152817 -> j3267602329;
		j1643152817 -> j2367263911;
	j4183099194 [label="Sentir orgullo por el acto en sí... me parece excesivo. No disfruto al quitar una vida, pero él sí. Así que en ese sentido somos muy diferentes.",shape=box,color=blue];
		j4183099194 -> j219939015;
	j377577879 [label="Intentaré detenerlos cuando hagan cosas con las que no esté de acuerdo. Pero... lucharé a su lado cuando sea necesario.",shape=box,color=red];
		j377577879 -> j1331641386;
	j2324434432 [label="No creo que esos grupos sean \"buenos\" o \"malos\" por definición. Solo lo son por las acciones que deciden tomar.",shape=box,color=red];
		j2324434432 -> j2519762367;
	j3267602329 [label="No me corresponde declarar que algunas acciones son \"buenas\" y otras \"malas\". Hago lo que hago para proteger a las personas que lo necesitan.",shape=box,color=red];
		j3267602329 -> j1331641386;
	j2367263911 [label="Me pides que juzgue a todo un grupo de personas con los mismos criterios que usaría para juzgar a un individuo.",shape=box,color=red];
		j2367263911 -> j2519762367;
	j219939015 [label="Solo puedo rezar para que no sea demasiado tarde si el diablo decide clavarte su cuchillo en las costillas. No quiero que tus últimos pensamientos sean \"Marie me lo advirtió\".",shape=box,color=blue];
		j219939015 -> j3735049882;
		j219939015 -> j3742877802;
	j1331641386 [label="¿Y no crees que el diablo es una amenaza? ¿Que no es peligroso para quienes lo rodean? Podría causar mucho daño.",shape=box,color=blue];
		j1331641386 -> j781643381;
		j1331641386 -> j2259751536;
	j2519762367 [label="¿Y qué hay de los horribles actos que ha cometido? ¿Toda la muerte, la masacre? ¿Acaso consideras justificadas esas acciones?",shape=box,color=blue];
		j2519762367 -> j2259751536;
	j3735049882 [label="No lo hará. Y si lo intenta, lo detendré.",shape=box,color=red];
		j3735049882 -> j3711843980;
	j3742877802 [label="Te prometo que esos no serán mis últimos pensamientos.",shape=box,color=red];
		j3742877802 -> j3413840768;
	j781643381 [label="Si en algún momento nos traiciona, actuaré. Hasta entonces, ha demostrado ser un aliado incondicional. Aunque... quizá un poco melodramático.",shape=box,color=red];
		j781643381 -> j2707253289;
	j2259751536 [label="No considero que su peligrosidad sea un problema. Él es un arma. Y las armas pueden usarse para matar o para proteger.",shape=box,color=red];
		j2259751536 -> j2703597228;
	j3711843980 [label="Te adoro por la fe que tienes en ti mismo, aunque lamento que tengas fe en él. Así que supongo que yo también tendré fe en ti.",shape=box,color=blue];
		j3711843980 -> j1418539742;
	j3413840768 [label="Creo que esas palabras no tienen el significado que espero, pero no les daré demasiada importancia.",shape=box,color=blue];
		j3413840768 -> j1418539742;
	j2707253289 [label="Add 1 to Thermostat counter",color=orange];
		j2707253289 -> j219939015;
	j2703597228 [label="Add -1 to Thermostat counter",color=orange];
		j2703597228 -> j219939015;
	j1418539742 [label="Debo irme. Pero, de nuevo, te lo ruego: ten cuidado. Hazlo por mi, si no lo haces por ti, ¿de acuerdo?",shape=box,color=blue];
		j1418539742 -> j367054140;
	j367054140 [label="+20 Chemistry",color=orange];
		j367054140 -> "Chat ends.";
}