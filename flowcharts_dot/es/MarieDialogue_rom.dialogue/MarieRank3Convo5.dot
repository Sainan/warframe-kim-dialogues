	j1924445686 [label="Estoy bien ¿Cómo estás?",shape=box,color=red];
		j1924445686 -> j3633102855;
	j3699442668 [label="He estado mejor, pero gracias por preguntar. ¿Cómo estás?",shape=box,color=red];
		j3699442668 -> j1271196849;
	j2005527236 [label="Yo... debería de confesar que estaba mintiendo. No soy realmente... un seguidor del Sol.",shape=box,color=red];
		j2005527236 -> j1138551704;
	j876840920 [label="Mejor ahora que hablo contigo. Pero tú haces que todos mis días sean más brillantes estando en ellos.",shape=box,color=red];
		j876840920 -> j892563849;
	j202800200 [label="[Fin]",shape=box,color=red];
		j202800200 -> "Chat ends.";
	j3633102855 [label="Estoy bien, supongo. Aunque pensándolo bien, siento que no debería estarlo.",shape=box,color=blue];
		j3633102855 -> j368950240;
		j3633102855 -> j1991459050;
	j1271196849 [label="Estoy bien, pero ahora me dio curiosidad. Qu'y a-t-il ?",shape=box,color=blue];
		j1271196849 -> j1707121537;
		j1271196849 -> j2864798737;
		j1271196849 -> j1537231488;
		j1271196849 -> j1964058918;
	j1138551704 [label="¡Oh! Ya... veo. Pourquoi ?",shape=box,color=blue];
		j1138551704 -> j959180293;
		j1138551704 -> j2979677656;
		j1138551704 -> j3490906106;
	j892563849 [label="¡Lobo! ¡Harás que me caiga de la silla!",shape=box,color=blue];
		j892563849 -> j1881171999;
		j892563849 -> j557364267;
	"Chat ends." [color=orange];
	j368950240 [label="¿Qué quieres decir?",shape=box,color=red];
		j368950240 -> j3483361561;
	j1991459050 [label="Estuve en tu lugar una vez.",shape=box,color=red];
		j1991459050 -> j499159422;
	j1707121537 [label="Es... sólo... difícil de explicar.",shape=box,color=red];
		j1707121537 -> j4065356097;
	j2864798737 [label="Mucho de qué preocuparse. Muy poco tiempo.",shape=box,color=red];
		j2864798737 -> j707055214;
	j1537231488 [label="Una amiga mía una vez lo describió como \"arañas\". Aparecen de vez en cuando.",shape=box,color=red];
		j1537231488 -> j2316260255;
	j1964058918 [label="A veces, todo... me afecta. Pero estaré bien.",shape=box,color=red];
		j1964058918 -> j4117139659;
	j959180293 [label="Pensé que sería una oportunidad para conocerte mejor...",shape=box,color=red];
		j959180293 -> j958306475;
	j2979677656 [label="¿Pensé que sería divertido?",shape=box,color=red];
		j2979677656 -> j1944381313;
	j3490906106 [label="La verdad no lo sé. Fue sólo un impulso.",shape=box,color=red];
		j3490906106 -> j2600880889;
	j1881171999 [label="Lo digo en serio. Lo siento si te incomodo.",shape=box,color=red];
		j1881171999 -> j1180282791;
	j557364267 [label="Lo siento. Solo estaba bromeando.",shape=box,color=red];
		j557364267 -> j1180282791;
	j3483361561 [label="Soy une Sœur de Sol. No estoy destinada a... pelear. Matar. El Murmullo no está vivo o eso es lo que me dicen los Cavia ¿Pero qué hay de los otros a los que me enfrento?",shape=box,color=blue];
		j3483361561 -> j711045174;
	j499159422 [label="+5 Chemistry",color=orange];
		j499159422 -> j212829440;
	j4065356097 [label="Entonces no debería de rezar. Sé que a veces es difícil expresar las cosas con palabras.",shape=box,color=blue];
		j4065356097 -> j3035180572;
	j707055214 [label="Había una hermana en la Cathédrale que era así. Se quejaba y quejaba. La encontré una vez puliendo plata a las tres de la mañana.",shape=box,color=blue];
		j707055214 -> j328651766;
	j2316260255 [label="Ah, oui. Creo que sé a lo que te refieres. Es como una... nube que se mueve sobre el sol.",shape=box,color=blue];
		j2316260255 -> j3346200261;
	j4117139659 [label="Como una taza que se llena con agua, gota por gota, non ?",shape=box,color=blue];
		j4117139659 -> j3450521239;
	j958306475 [label="No necesitas decirme tal mensonge para conocerme.",shape=box,color=blue];
		j958306475 -> j2010669793;
	j1944381313 [label="Je ne comprends pas votre humour. ¿Tal vez en el futuro lo \"divertido\" es diferente?",shape=box,color=blue];
		j1944381313 -> j1619139042;
	j2600880889 [label="No sé qué tipo de instinto es el que te llevó a decirme tal mensonge. ",shape=box,color=blue];
		j2600880889 -> j467724684;
	j1180282791 [label="Bon, où en étais-je ?",shape=box,color=blue];
		j1180282791 -> j4244769428;
	j711045174 [label="Para pelear en el nombre de Sol... ¿Debería ser ese mi camino? ¿Debo convertirme en una asesina en su nombre? Moi, petite Marie ?",shape=box,color=blue];
		j711045174 -> j2277739222;
		j711045174 -> j853264110;
	j212829440 [label="Sé que estás usando une métaphore, ¡pero me estoy muriendo de risa! ¡No creo que puedas estar en mi lugar aunque lo intentaras!",shape=box,color=blue];
		j212829440 -> j1077775444;
	j3035180572 [label="Hay muchas maneras en las que nuestros días y mentes pueden ir mal. Nos podemos quedar atrapadnos en esos agujeros oscuros, non ?",shape=box,color=blue];
		j3035180572 -> j3444910592;
	j328651766 [label="Le pregunté por qué lo estaba haciendo, y dijo que no podía dormir, porque estaba demasiado inquieta.",shape=box,color=blue];
		j328651766 -> j1029014230;
	j3346200261 [label="Tenemos una palabra para esto, ennui. Un cansancio y un descontento que hace parecer que todo es... inútil.",shape=box,color=blue];
		j3346200261 -> j3828828558;
	j3450521239 [label="Que se llena y se derrama. Tal vez incluso vaciando su contenido. Y que todo se vea como une catastrophe. ",shape=box,color=blue];
		j3450521239 -> j1403320907;
	j2010669793 [label="Un alma es más que la fe que uno tiene. Soy une Sœur de Sol, pero esperaría que vieras más que eso en mí, non ?",shape=box,color=blue];
		j2010669793 -> j1534172859;
	j1619139042 [label="Para mí, no lo es.",shape=box,color=blue];
		j1619139042 -> j1097657522;
	j467724684 [label="Sólo puedo esperar que sea benigna, y no una broma cruel a costa mía. Así que debería escoger seguir el ejemplo de Sol...",shape=box,color=blue];
		j467724684 -> j3245893391;
	j4244769428 [label="Check boolean DrifterFaithSol",color=orange];
		j4244769428 -> j1463821160 [label=true,color=green];
		j4244769428 -> j258967484 [label=false,color=brown];
	j2277739222 [label="No me entrenaron para ser un soldado. No como al infante. A ti tampoco.",shape=box,color=red];
		j2277739222 -> j1505193629;
	j853264110 [label="No siempre... fui así. Siempre un peleador. Tuve que aprender a las malas.",shape=box,color=red];
		j853264110 -> j761444921;
	j1077775444 [label="La imagen que tengo en la cabeza me dará escalofríos. Antes de que no pueda respirar, dime ¿a qué te refieres?",shape=box,color=blue];
		j1077775444 -> j2277739222;
		j1077775444 -> j853264110;
	j3444910592 [label="Sólo podemos esforzarnos por ser amables y pacientes con nosotros mismos cuando sucede.",shape=box,color=blue];
		j3444910592 -> j3510282520;
	j1029014230 [label="Cada vez que me la encontraba así le preguntaba si quería compañía. A veces decía que sí, a veces decía que no.",shape=box,color=blue];
		j1029014230 -> j3035180572;
	j3828828558 [label="O tal vez lo tuyo es un deseo de esconderte, de llorar, es más bien desesperación, no estoy segura.",shape=box,color=blue];
		j3828828558 -> j2570365837;
	j1403320907 [label="Limpias el desastre, arreglas la taza... y vuelve a empezar, oui ?",shape=box,color=blue];
		j1403320907 -> j1973035082;
	j1534172859 [label="¡Hay muchos temas que podríamos elegir como estrellas en el cielo!",shape=box,color=blue];
		j1534172859 -> j3378796849;
		j1534172859 -> j1180738478;
	j1097657522 [label="Boolean DrifterFaithSol is now false.",color=orange];
		j1097657522 -> j1508231473;
	j3245893391 [label="... Cuya fe yo sigo, la compartas o no, te perdono. Si fueras como Lyon, te diría que te mereces diez latigazos.",shape=box,color=blue];
		j3245893391 -> j3332828926;
	j1463821160 [label="Ma famille à Sol ! Mi familia de Sol, ¿Cómo estamos hoy?",shape=box,color=blue];
		j1463821160 -> j1924445686;
		j1463821160 -> j3699442668;
		j1463821160 -> j2005527236;
		j1463821160 -> j202800200;
	j258967484 [label="Bonjour ! ¿Cómo estamos hoy?",shape=box,color=blue];
		j258967484 -> j1924445686;
		j258967484 -> j3699442668;
		j258967484 -> j2005527236;
		j258967484 -> j202800200;
	j1505193629 [label="Oui ! La minúscula copia y su triste historia... me dan ganas de llorar al pensarlo. Ser convertido en una máquina de guerra por aquellos que pensó que eran su famille ?",shape=box,color=blue];
		j1505193629 -> j16244717;
	j761444921 [label="Oui ! Eso he escuchado, sufriste mucho para aprender a pelear como lo haces ahora. La muerte pude ser una maestra cruel, no me lo puedo imaginar...",shape=box,color=blue];
		j761444921 -> j16244717;
	j3510282520 [label="No sé si estás palabras te importen... O si son sólo puntos brillosos de una pieza de una ruidosa machinerie.",shape=box,color=blue];
		j3510282520 -> j741429728;
	j2570365837 [label="No conozco a esa amiga tuya, pero creo que es bueno que te tenga.",shape=box,color=blue];
		j2570365837 -> j3035180572;
	j1973035082 [label="Había un padre en la capilla con un temperamento parecido al tuyo, creo. Podía soportarlo todo, hasta que no pudo más.",shape=box,color=blue];
		j1973035082 -> j4129828434;
	j3378796849 [label="Lo siento, fue una tontería hacerlo.",shape=box,color=red];
		j3378796849 -> j825633533;
	j1180738478 [label="Entonces ¿Me perdonas?",shape=box,color=red];
		j1180738478 -> j447053184;
	j1508231473 [label="Boolean MarieNoDate is now true.",color=orange];
		j1508231473 -> "Chat ends.";
	j3332828926 [label="Boolean DrifterFaithSol is now false.",color=orange];
		j3332828926 -> j3480411221;
	j16244717 [label="Non. Prefiero ser como soy ahora. Elijo tomar la mano de le Cardinal y el sérum que me ofreció",shape=box,color=blue];
		j16244717 -> j3239795737;
	j741429728 [label="En cierto que cuando consideras la realidad de las cosas, cuando escribo estas palabras, muy bien podría ser que hayan pasado días o muchos años desde que las escribí, dependiendo de cuando estés.",shape=box,color=blue];
		j741429728 -> j205270377;
	j4129828434 [label="Cuando era mucho para él, y que todo parecía un desastre, le preguntaba si quería mi companie. Des fois, oui, des fois, non.",shape=box,color=blue];
		j4129828434 -> j3035180572;
	j825633533 [label="Boolean DrifterFaithSol is now false.",color=orange];
		j825633533 -> j528274610;
	j447053184 [label="Boolean DrifterFaithSol is now false.",color=orange];
		j447053184 -> j467043330;
	j3480411221 [label="Todos somos sólo cosas ciegas intentando encontrar nuestro camino a través de este mundo.",shape=box,color=blue];
		j3480411221 -> j1446087612;
	j3239795737 [label="Pero conoces la tristeza que me atormenta, la incertidumbre. De no nacer, o ser criada, en esta vida de guerra.",shape=box,color=blue];
		j3239795737 -> j640579464;
		j3239795737 -> j568639601;
	j205270377 [label="Todo eso es para decir, que entiendo que se puede sentir vacío lo que escribo pero no estás solo.",shape=box,color=blue];
		j205270377 -> j4128807204;
	j528274610 [label="+10 Chemistry",color=orange];
		j528274610 -> j3740279296;
	j467043330 [label="+5 Chemistry",color=orange];
		j467043330 -> j3622336147;
	j1446087612 [label="Pero te pregunte cómo estabas. Y la pregunta sigue en pie, petit mensonge ou non.",shape=box,color=blue];
		j1446087612 -> j1762724614;
		j1446087612 -> j3545225525;
		j1446087612 -> j1487373569;
	j640579464 [label="A veces, pienso que tanto tuve que descubrir por mi cuenta, y envidio al infante por el entrenamiento que tuvo.",shape=box,color=red];
		j640579464 -> j141838542;
	j568639601 [label="Creo que no hay una \"buena\" manera de terminar en una vida de guerra. Para nacer y ser criado o elegirlo. Al final sólo se trata de quién eres y qué haces con eso.",shape=box,color=red];
		j568639601 -> j80984366;
	j4128807204 [label="Aunque aquellos que te rodean parezcan distantes o en forma digital o sentados pacientemente para decirte hola.",shape=box,color=blue];
		j4128807204 -> j2156850332;
	j3740279296 [label="Oui, ¡y si fueras como Lyon, te diría que te mereces diez latigazos! Pero no lo eres. Y estás perdonado.",shape=box,color=blue];
		j3740279296 -> j3480411221;
	j3622336147 [label="Oui, te perdono. Si fueras como Lyon, te diría que te mereces diez latigazos.",shape=box,color=blue];
		j3622336147 -> j3480411221;
	j1762724614 [label="He estado... mejor, la verdad.",shape=box,color=red];
		j1762724614 -> j499880850;
	j3545225525 [label="La verdad estoy bien. ¿Y tú cómo estás?",shape=box,color=red];
		j3545225525 -> j3633102855;
	j1487373569 [label="Estoy mejor ahora, gracias. He escuchado que confesarse es bueno para la gente, ¿no?",shape=box,color=red];
		j1487373569 -> j1752899095;
	j141838542 [label="Add -1 to Thermostat counter",color=orange];
		j141838542 -> j446507064;
	j80984366 [label="Add 1 to Thermostat counter",color=orange];
		j80984366 -> j542984067;
	j2156850332 [label="Y espero que este momento pase rápido para ti.",shape=box,color=blue];
		j2156850332 -> j852921428;
	j499880850 [label="Qu'y a-t-il ? ¿Qué pasa ?",shape=box,color=blue];
		j499880850 -> j1707121537;
		j499880850 -> j2864798737;
		j499880850 -> j1537231488;
		j499880850 -> j1964058918;
	j1752899095 [label="+5 Chemistry",color=orange];
		j1752899095 -> j2376520308;
	j446507064 [label="+10 Chemistry",color=orange];
		j446507064 -> j2358623481;
	j542984067 [label="+10 Chemistry",color=orange];
		j542984067 -> j1738260746;
	j852921428 [label="¿Y si no es así? ¡Tengo una solución que siempre ayuda!",shape=box,color=blue];
		j852921428 -> j2741842295;
	j2376520308 [label="¡Ja! Oui, así es. Très bien, me alegra escucharlo.",shape=box,color=blue];
		j2376520308 -> j3684656592;
	j2358623481 [label="Oui, pero entonces no serías el lobo vicioso que conocemos y amamos, ¿no? Creo que Sol te puso en donde necesitabas estar.",shape=box,color=blue];
		j2358623481 -> j529192816;
	j1738260746 [label="Oui, estoy totalmente de acuerdo. Nadie nace para la guerra. Bueno, salvo esos \"Grei-nier\" que me han contado, y aun así...",shape=box,color=blue];
		j1738260746 -> j368845630;
	j2741842295 [label="Des pâtisseries !",shape=box,color=blue];
		j2741842295 -> j4132951681;
	j3684656592 [label="¡Ah! La merienda está servida. Debo rime. Hasta luego, lobo. Me alegra que hayamos hablado.",shape=box,color=blue];
		j3684656592 -> "Chat ends.";
	j529192816 [label="Pero sé a lo que te refieres. Ver la estructura y la guía que tu otro yo obtuvo, y no puedes evitar desear haber tenido lo mismo. Especialmente cuando estás tan solo.",shape=box,color=blue];
		j529192816 -> j3697659825;
	j368845630 [label="Me pregunto si no elegirían otro camino si les dieran realmente la opción de hacerlo.",shape=box,color=blue];
		j368845630 -> j1179455797;
		j368845630 -> j4077050716;
	j4132951681 [label="Check boolean MarieRoathePastry1",color=orange];
		j4132951681 -> j3434234556 [label=true,color=green];
		j4132951681 -> j1075927228 [label=true,color=green];
		j4132951681 -> j2455132235 [label=true,color=green];
		j4132951681 -> j1075927228 [label=false,color=brown];
		j4132951681 -> j1506222990 [label=false,color=brown];
	j3697659825 [label="No puedo evitar ver que ahora una copia minúscula es quien está muy sola... y un lobo que corre tras su manada.",shape=box,color=blue];
		j3697659825 -> j2821994519;
	j1179455797 [label="Cuando eres criado para pensar que eso es tu único propósito, tu sola existencia, es difícil romper ese molde. El propósito le da a la gente consuelo.",shape=box,color=red];
		j1179455797 -> j3478588409;
	j4077050716 [label="Creo que lo harían. Hay algunos de ellos a quienes he conocido que me han demostrado que los grineer son más que sólo guerra y muerte.",shape=box,color=red];
		j4077050716 -> j1566914787;
	j3434234556 [label="Sólo me tengo que segurar de traer suficientes pasteles para todos.",shape=box,color=red];
		j3434234556 -> j1443250810;
	j1075927228 [label="Gracias, Marie.",shape=box,color=red];
		j1075927228 -> j2174150784;
	j2455132235 [label="No dejaré a Roathe cerca de ellos.",shape=box,color=red];
		j2455132235 -> j455676074;
	j1506222990 [label="Nunca puedes equivocarte con los pasteles.",shape=box,color=red];
		j1506222990 -> j2527042449;
	j2821994519 [label="Creo que los papeles se han invertido, non ?",shape=box,color=blue];
		j2821994519 -> j1556115881;
		j2821994519 -> j1003207334;
	j3478588409 [label="Add -1 to Thermostat counter",color=orange];
		j3478588409 -> j3667305182;
	j1566914787 [label="Add 1 to Thermostat counter",color=orange];
		j1566914787 -> j4137414190;
	j1443250810 [label="+20 Chemistry",color=orange];
		j1443250810 -> j1500495289;
	j2174150784 [label="+20 Chemistry",color=orange];
		j2174150784 -> j883491203;
	j455676074 [label="+20 Chemistry",color=orange];
		j455676074 -> j18825019;
	j2527042449 [label="Sólo no los dejes cerca del diablo. Sinon, il va les voler ! ¡Suele robar dulces cuando no le dan los suficientes!",shape=box,color=blue];
		j2527042449 -> j420323306;
	j1556115881 [label="Se siguen recuperando. Su viaje aún no ha terminado.",shape=box,color=red];
		j1556115881 -> j4048863395;
	j1003207334 [label="Desería poder hacer más por ellos. ",shape=box,color=red];
		j1003207334 -> j4048863395;
	j3667305182 [label="Oui, estás en lo correcto. Muchos buscan la fe con la esperanza de que les dé eso, un propósito. Una guía.",shape=box,color=blue];
		j3667305182 -> j663917036;
	j4137414190 [label="(Con que así es como se escribe, merci !) Me hace muy feliz saberlo. Que incluso una raza a la cual se le enseñó que ese era su único propósito, pueda encontrar otro.",shape=box,color=blue];
		j4137414190 -> j2796407774;
	j1500495289 [label="¡Ese es el espíritu! Supongo que hasta el diablo merece de vez en cuando un pedacito de pastel.",shape=box,color=blue];
		j1500495289 -> j3372178700;
	j883491203 [label="Je vous en prie. Espero haberte animado, aunque sea un poco. Tú me has alegrado a mí.",shape=box,color=blue];
		j883491203 -> "Chat ends.";
	j18825019 [label="Ah, me quejo, pero hasta el más bajo de los demonios se merece un pedacito de pastel de vez en cuando, oui ?",shape=box,color=blue];
		j18825019 -> j3372178700;
	j420323306 [label="Boolean MarieRoathePastry1 is now true.",color=orange];
		j420323306 -> j1578388044;
		j420323306 -> j760148647;
	j4048863395 [label="Y creo que estás haciendo tanto como puedes. Vendrán a ti cuando te necesiten.",shape=box,color=blue];
		j4048863395 -> j663917036;
	j663917036 [label="Muchos encuentran un camino para recorrer con la esperanza de que los conduzcan a las respuestas.",shape=box,color=blue];
		j663917036 -> j3759272571;
		j663917036 -> j2611866888;
	j2796407774 [label="Boolean MarieGrineer is now true.",color=orange];
		j2796407774 -> j663917036;
	j3372178700 [label="¡Bueno! La merienda está servida, estoy hambrienta. Espero haberte alegrado, aunque sea un poco. Tú me has alegrado a mí.",shape=box,color=blue];
		j3372178700 -> "Chat ends.";
	j1578388044 [label="Me aseguraré de traer suficiente para todos.",shape=box,color=red];
		j1578388044 -> j1443250810;
