		1333 -> 1341;
	1337 [label="Non. Prefiero ser como soy ahora. Elijo tomar la mano de le Cardinal y el sérum que me ofreció",shape=box,color=blue];
		1337 -> 1343;
	1334 [label="En cierto que cuando consideras la realidad de las cosas, cuando escribo estas palabras, muy bien podría ser que hayan pasado días o muchos años desde que las escribí, dependiendo de cuando estés.",shape=box,color=blue];
		1334 -> 1342;
	1336 [label="Cuando era mucho para él, y que todo parecía un desastre, le preguntaba si quería mi companie. Des fois, oui, des fois, non.",shape=box,color=blue];
		1336 -> 1306;
	1338 [label="Update boolean DrifterFaithSol",color=orange];
