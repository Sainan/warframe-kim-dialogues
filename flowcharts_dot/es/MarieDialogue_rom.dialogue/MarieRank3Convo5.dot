		1278 -> 1282;
	1281 [label="Estoy bien ¿Cómo estás?",shape=box,color=red];
		1281 -> 1285;
	1280 [label="He estado mejor, pero gracias por preguntar. ¿Cómo estás?",shape=box,color=red];
		1280 -> 1284;
	1283 [label="Yo... debería de confesar que estaba mintiendo. No soy realmente... un seguidor del Sol.",shape=box,color=red];
		1283 -> 1287;
	3947 [label="Mejor ahora que hablo contigo. Pero tú haces que todos mis días sean más brillantes estando en ellos.",shape=box,color=red];
