	1360 [label="¿Y si no es así? ¡Tengo una solución que siempre ayuda!",shape=box,color=blue];
		1360 -> 1364;
	1363 [label="¡Ja! Oui, así es. Très bien, me alegra escucharlo.",shape=box,color=blue];
		1363 -> 1367;
	1365 [label="Oui, pero entonces no serías el lobo vicioso que conocemos y amamos, ¿no? Creo que Sol te puso en donde necesitabas estar.",shape=box,color=blue];
		1365 -> 1369;
	1366 [label="Oui, estoy totalmente de acuerdo. Nadie nace para la guerra. Bueno, salvo esos \"Grei-nier\" que me han contado, y aun así...",shape=box,color=blue];
		1366 -> 1370;
	1364 [label="Des pâtisseries !",shape=box,color=blue];
		1364 -> 1368;
	1367 [label="¡Ah! La merienda está servida. Debo rime. Hasta luego, lobo. Me alegra que hayamos hablado.",shape=box,color=blue];
		1367 -> 1371;
	1369 [label="Pero sé a lo que te refieres. Ver la estructura y la guía que tu otro yo obtuvo, y no puedes evitar desear haber tenido lo mismo. Especialmente cuando estás tan solo.",shape=box,color=blue];
		1369 -> 1376;
	1370 [label="Me pregunto si no elegirían otro camino si les dieran realmente la opción de hacerlo.",shape=box,color=blue];
