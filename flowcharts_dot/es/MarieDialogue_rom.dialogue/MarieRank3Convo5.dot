		1381 -> 1388;
	1382 [label="Sólo no los dejes cerca del diablo. Sinon, il va les voler ! ¡Suele robar dulces cuando no le dan los suficientes!",shape=box,color=blue];
		1382 -> 1389;
	1390 [label="Se siguen recuperando. Su viaje aún no ha terminado.",shape=box,color=red];
		1390 -> 1398;
	1391 [label="Desería poder hacer más por ellos. ",shape=box,color=red];
		1391 -> 1398;
	1392 [label="Oui, estás en lo correcto. Muchos buscan la fe con la esperanza de que les dé eso, un propósito. Una guía.",shape=box,color=blue];
		1392 -> 1399;
	1393 [label="(Con que así es como se escribe, merci !) Me hace muy feliz saberlo. Que incluso una raza a la cual se le enseñó que ese era su único propósito, pueda encontrar otro.",shape=box,color=blue];
		1393 -> 1400;
	1386 [label="¡Ese es el espíritu! Supongo que hasta el diablo merece de vez en cuando un pedacito de pastel.",shape=box,color=blue];
		1386 -> 1394;
	1387 [label="Je vous en prie. Espero haberte animado, aunque sea un poco. Tú me has alegrado a mí.",shape=box,color=blue];
		1387 -> 1402;
	1388 [label="Ah, me quejo, pero hasta el más bajo de los demonios se merece un pedacito de pastel de vez en cuando, oui ?",shape=box,color=blue];
