	1409 [label="Creo que cuando encuentres esa respuesta, descubrirás tu propia paz.",shape=box,color=blue];
		1409 -> 1412;
	1407 [label="Oui ! ¡Imaginez Lyon y yo, cuando el diablo entraba, con máscara y abrigo puestos, con los bolsillos llenos de dulces robados!",shape=box,color=blue];
		1407 -> 1410;
	1411 [label="Para disfrutar del paisaje, por supuesto.",shape=box,color=blue];
