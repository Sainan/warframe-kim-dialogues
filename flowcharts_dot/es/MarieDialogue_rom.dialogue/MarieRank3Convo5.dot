		1346 -> 1352;
		1346 -> 1353;
		1346 -> 1354;
	1348 [label="A veces, pienso que tanto tuve que descubrir por mi cuenta, y envidio al infante por el entrenamiento que tuvo.",shape=box,color=red];
		1348 -> 1356;
	1349 [label="Creo que no hay una \"buena\" manera de terminar en una vida de guerra. Para nacer y ser criado o elegirlo. Al final sólo se trata de quién eres y qué haces con eso.",shape=box,color=red];
		1349 -> 1357;
	1347 [label="Aunque aquellos que te rodean parezcan distantes o en forma digital o sentados pacientemente para decirte hola.",shape=box,color=blue];
		1347 -> 1355;
	1350 [label="Oui, ¡y si fueras como Lyon, te diría que te mereces diez latigazos! Pero no lo eres. Y estás perdonado.",shape=box,color=blue];
