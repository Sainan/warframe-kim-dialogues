	1292 [label="¿Qué quieres decir?",shape=box,color=red];
		1292 -> 1301;
	1293 [label="Estuve en tu lugar una vez.",shape=box,color=red];
		1293 -> 1302;
	1288 [label="Es... sólo... difícil de explicar.",shape=box,color=red];
		1288 -> 1297;
	1289 [label="Mucho de qué preocuparse. Muy poco tiempo.",shape=box,color=red];
		1289 -> 1298;
	1290 [label="Una amiga mía una vez lo describió como \"arañas\". Aparecen de vez en cuando.",shape=box,color=red];
		1290 -> 1299;
	1291 [label="A veces, todo... me afecta. Pero estaré bien.",shape=box,color=red];
		1291 -> 1300;
	1294 [label="Pensé que sería una oportunidad para conocerte mejor...",shape=box,color=red];
		1294 -> 1303;
	1295 [label="¿Pensé que sería divertido?",shape=box,color=red];
		1295 -> 1304;
	1296 [label="La verdad no lo sé. Fue sólo un impulso.",shape=box,color=red];
		1296 -> 1305;
	3949 [label="Lo digo en serio. Lo siento si te incomodo.",shape=box,color=red];
		3949 -> 3951;
	3950 [label="Lo siento. Solo estaba bromeando.",shape=box,color=red];
		3950 -> 3951;
	1301 [label="Soy une Sœur de Sol. No estoy destinada a... pelear. Matar. El Murmullo no está vivo o eso es lo que me dicen los Cavia ¿Pero qué hay de los otros a los que me enfrento?",shape=box,color=blue];
		1301 -> 1310;
	1302 [label="+5 Chemistry",color=orange];
		1302 -> 1311;
	1297 [label="Entonces no debería de rezar. Sé que a veces es difícil expresar las cosas con palabras.",shape=box,color=blue];
		1297 -> 1306;
	1298 [label="Había una hermana en la Cathédrale que era así. Se quejaba y quejaba. La encontré una vez puliendo plata a las tres de la mañana.",shape=box,color=blue];
		1298 -> 1307;
	1299 [label="Ah, oui. Creo que sé a lo que te refieres. Es como una... nube que se mueve sobre el sol.",shape=box,color=blue];
		1299 -> 1308;
	1300 [label="Como una taza que se llena con agua, gota por gota, non ?",shape=box,color=blue];
		1300 -> 1309;
	1303 [label="No necesitas decirme tal mensonge para conocerme.",shape=box,color=blue];
		1303 -> 1312;
	1304 [label="Je ne comprends pas votre humour. ¿Tal vez en el futuro lo \"divertido\" es diferente?",shape=box,color=blue];
		1304 -> 1313;
	1305 [label="No sé qué tipo de instinto es el que te llevó a decirme tal mensonge. ",shape=box,color=blue];
		1305 -> 1314;
	3951 [label="Bon, où en étais-je ?",shape=box,color=blue];
		3951 -> 1278;
	1310 [label="Para pelear en el nombre de Sol... ¿Debería ser ese mi camino? ¿Debo convertirme en una asesina en su nombre? Moi, petite Marie ?",shape=box,color=blue];
		1310 -> 1319;
		1310 -> 1320;
	1311 [label="Sé que estás usando une métaphore, ¡pero me estoy muriendo de risa! ¡No creo que puedas estar en mi lugar aunque lo intentaras!",shape=box,color=blue];
		1311 -> 1321;
	1306 [label="Hay muchas maneras en las que nuestros días y mentes pueden ir mal. Nos podemos quedar atrapadnos en esos agujeros oscuros, non ?",shape=box,color=blue];
		1306 -> 1315;
	1307 [label="Le pregunté por qué lo estaba haciendo, y dijo que no podía dormir, porque estaba demasiado inquieta.",shape=box,color=blue];
		1307 -> 1316;
	1308 [label="Tenemos una palabra para esto, ennui. Un cansancio y un descontento que hace parecer que todo es... inútil.",shape=box,color=blue];
		1308 -> 1317;
	1309 [label="Que se llena y se derrama. Tal vez incluso vaciando su contenido. Y que todo se vea como une catastrophe. ",shape=box,color=blue];
		1309 -> 1318;
	1312 [label="Un alma es más que la fe que uno tiene. Soy une Sœur de Sol, pero esperaría que vieras más que eso en mí, non ?",shape=box,color=blue];
		1312 -> 1322;
	1313 [label="Para mí, no lo es.",shape=box,color=blue];
		1313 -> 1323;
	1314 [label="Sólo puedo esperar que sea benigna, y no una broma cruel a costa mía. Así que debería escoger seguir el ejemplo de Sol...",shape=box,color=blue];
		1314 -> 1324;
	1319 [label="No me entrenaron para ser un soldado. No como al infante. A ti tampoco.",shape=box,color=red];
		1319 -> 1328;
	1320 [label="No siempre... fui así. Siempre un peleador. Tuve que aprender a las malas.",shape=box,color=red];
		1320 -> 1329;
	1321 [label="La imagen que tengo en la cabeza me dará escalofríos. Antes de que no pueda respirar, dime ¿a qué te refieres?",shape=box,color=blue];
		1321 -> 1319;
		1321 -> 1320;
	1315 [label="Sólo podemos esforzarnos por ser amables y pacientes con nosotros mismos cuando sucede.",shape=box,color=blue];
		1315 -> 1325;
	1316 [label="Cada vez que me la encontraba así le preguntaba si quería compañía. A veces decía que sí, a veces decía que no.",shape=box,color=blue];
		1316 -> 1306;
	1317 [label="O tal vez lo tuyo es un deseo de esconderte, de llorar, es más bien desesperación, no estoy segura.",shape=box,color=blue];
		1317 -> 1335;
	1318 [label="Limpias el desastre, arreglas la taza... y vuelve a empezar, oui ?",shape=box,color=blue];
		1318 -> 1327;
	1322 [label="¡Hay muchos temas que podríamos elegir como estrellas en el cielo!",shape=box,color=blue];
		1322 -> 1330;
		1322 -> 1331;
	1323 [label="Update boolean DrifterFaithSol",color=orange];
		1323 -> 1332;
	1324 [label="... Cuya fe yo sigo, la compartas o no, te perdono. Si fueras como Lyon, te diría que te mereces diez latigazos.",shape=box,color=blue];
		1324 -> 1333;
	1328 [label="Oui ! La minúscula copia y su triste historia... me dan ganas de llorar al pensarlo. Ser convertido en una máquina de guerra por aquellos que pensó que eran su famille ?",shape=box,color=blue];
		1328 -> 1337;
	1329 [label="Oui ! Eso he escuchado, sufriste mucho para aprender a pelear como lo haces ahora. La muerte pude ser una maestra cruel, no me lo puedo imaginar...",shape=box,color=blue];
		1329 -> 1337;
	1325 [label="No sé si estás palabras te importen... O si son sólo puntos brillosos de una pieza de una ruidosa machinerie.",shape=box,color=blue];
		1325 -> 1334;
	1335 [label="No conozco a esa amiga tuya, pero creo que es bueno que te tenga.",shape=box,color=blue];
		1335 -> 1306;
	1327 [label="Había un padre en la capilla con un temperamento parecido al tuyo, creo. Podía soportarlo todo, hasta que no pudo más.",shape=box,color=blue];
		1327 -> 1336;
	1330 [label="Lo siento, fue una tontería hacerlo.",shape=box,color=red];
		1330 -> 1338;
	1331 [label="Entonces ¿Me perdonas?",shape=box,color=red];
