	1341 [label="Todos somos sólo cosas ciegas intentando encontrar nuestro camino a través de este mundo.",shape=box,color=blue];
		1341 -> 1346;
	1343 [label="Pero conoces la tristeza que me atormenta, la incertidumbre. De no nacer, o ser criada, en esta vida de guerra.",shape=box,color=blue];
		1343 -> 1348;
		1343 -> 1349;
	1342 [label="Todo eso es para decir, que entiendo que se puede sentir vacío lo que escribo pero no estás solo.",shape=box,color=blue];
