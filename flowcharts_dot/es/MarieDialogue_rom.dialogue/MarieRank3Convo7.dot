		1521 -> 1528;
	1522 [label="+15 Chemistry",color=orange];
		1522 -> 1529;
	1523 [label="Siento que él no hablaría conmigo.",shape=box,color=red];
		1523 -> 1530;
	1524 [label="Le quiero ayudar, si puedo. ¿Tienes algún consejo?",shape=box,color=red];
		1524 -> 1530;
	1531 [label="Espero que no sea eso lo que estás haciendo aquí.",shape=box,color=blue];
		1531 -> 1536;
