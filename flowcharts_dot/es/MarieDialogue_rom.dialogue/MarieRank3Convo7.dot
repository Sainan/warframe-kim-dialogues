		j678565364 -> j202800200;
	j729405815 [label="¿Cómo se conocieron tú y Lyon?",shape=box,color=red];
		j729405815 -> j761821306;
	j733558605 [label="¿Está Lyon... bien?",shape=box,color=red];
		j733558605 -> j3357635188;
	j202800200 [label="[Fin]",shape=box,color=red];
		j202800200 -> "Chat ends.";
	j761821306 [label="Mi querido Lyon ya llevaba tiempo establecido en la Cathédrale cuando la Mère Supérieure me acogió, y me uní a la iglesia de las Luminarias como una hermana. (¡Me emociona que estés hablando!)",shape=box,color=blue];
		j761821306 -> j3793521958;
		j761821306 -> j2008574296;
	j3357635188 [label="Te voy a pedir que definas eso antes de que sigamos. Y te voy a pedir que lo hagas gentilmente, y con un recordatorio cuidadoso de que él es el hermano de mi alma.",shape=box,color=blue];
		j3357635188 -> j890488481;
		j3357635188 -> j1470188947;
	"Chat ends." [color=orange];
	j3793521958 [label="¿Necesitabas... un lugar donde quedarte?",shape=box,color=red];
		j3793521958 -> j714211782;
	j2008574296 [label="¿Puedo preguntarte algo delicado?",shape=box,color=red];
		j2008574296 -> j1047989686;
	j890488481 [label="Si esta conversación te molesta, podemos pasar a otra cosa.",shape=box,color=red];
		j890488481 -> j969264724;
	j1470188947 [label="No te quiero molestar en absoluto. Sólo me preocupo por él. Tiene una apariencia estoica, pero entiendo que está sufriendo, eso es todo.",shape=box,color=red];
		j1470188947 -> j4029644739;
	j714211782 [label="Porque mi famille me desecho allí muchos años antes cuando era una pequeña niña. Pasé muchos años mendigando, sobreviviendo.",shape=box,color=blue];
		j714211782 -> j1898043900;
	j1047989686 [label="+5 Chemistry",color=orange];
		j1047989686 -> j1543044493;
	j969264724 [label="No, no. Está bien. Simplemente estoy acostumbrada a que los curiosos se acerquen, que lleguen a golpear las barras de su jaula como si fuera un monstre de cirque.",shape=box,color=blue];
		j969264724 -> j517229366;
		j969264724 -> j1105618244;
		j969264724 -> j2363296905;
	j4029644739 [label="+5 Chemistry",color=orange];
		j4029644739 -> j3246552876;
	j1898043900 [label="Boolean MarieBeggar1 is now true.",color=orange];
		j1898043900 -> j180546081;
	j1543044493 [label="Al parecer, te dicen que eres un lobo, ¡pero conmigo tienes esos modales! Es muy dulce verlo. Creo que sé lo que quieres preguntar. ¿Por qué estaba en la calle?",shape=box,color=blue];
		j1543044493 -> j714211782;
	j517229366 [label="¿Cómo se conocieron?",shape=box,color=red];
		j517229366 -> j1137063653;
	j1105618244 [label="Estoy acostumbrado a ser la \"atracción local\", entiendo por qué pudieras estar a la defensiva.",shape=box,color=red];
		j1105618244 -> j4282518211;
	j2363296905 [label="Está bien. Sólo me preocupo por él.",shape=box,color=red];
		j2363296905 -> j514245619;
	j3246552876 [label="Me... disculpo por mi brusquedad. Simplemente estoy acostumbrada a que los curiosos se acerquen, que lleguen a golpear las barras de su jaula como si fuera un monstre de cirque.",shape=box,color=blue];
		j3246552876 -> j1105618244;
		j3246552876 -> j2363296905;
	j180546081 [label="Te puedes imaginar que no hay muchos trabajos o lugares para alguien como yo, sin unas piernas que funcionen, dans la Cité de la Lumière en mi tiempo.",shape=box,color=blue];
		j180546081 -> j3213364588;
	j1137063653 [label="Mi querido Lyon ya llevaba tiempo establecido en la Cathédrale cuando la Mère Supérieure me acogió, y me uní a la iglesia de las Luminarias como una hermana.",shape=box,color=blue];
		j1137063653 -> j444450991;
		j1137063653 -> j2188717803;
	j4282518211 [label="Oui, me imagino que lo eres, una criatura que viaja en el tiempo quien puede hacer bucles en el tiempo y crear mundos de la nada! Eres como un mago, non ?",shape=box,color=blue];
		j4282518211 -> j4017616765;
		j4282518211 -> j1164157699;
	j514245619 [label="+5 Chemistry",color=orange];
		j514245619 -> j1093819547;
	j3213364588 [label="Por eso supongo que Lyon y yo nos convertimos en familia tan rápido. Nunca me miró con lástima. Ni yo a él.",shape=box,color=blue];
		j3213364588 -> j3659802993;
	j444450991 [label="¿Necesitabas... un lugar donde quedarte?",shape=box,color=red];
		j444450991 -> j3617410686;
	j2188717803 [label="¿Puedo preguntarte algo delicado?",shape=box,color=red];
		j2188717803 -> j294746142;
	j4017616765 [label="Eso lo resume bastante bien.",shape=box,color=red];
		j4017616765 -> j4197356837;
	j1164157699 [label="La verdad me gustaría que la gente me viera como algo más que eso.",shape=box,color=red];
		j1164157699 -> j242826396;
	j1093819547 [label="Y adoro eso de ti. Es fuerte y puede soportar lo que se le ha impuesto. Pero todas las cargas son más fáciles cuando se llevan con alguien.",shape=box,color=blue];
		j1093819547 -> j2966526534;
		j1093819547 -> j2525273464;
	j3659802993 [label="Mientras otros se apresuran a golpear con curiosidad las barras de su jaula como si fuera una especie de monstre de cirque.",shape=box,color=blue];
		j3659802993 -> j1357504939;
	j3617410686 [label="Porque mi famille me desecho allí muchos años antes cuando era una pequeña niña. Pasé muchos años mendigando, sobreviviendo.",shape=box,color=blue];
		j3617410686 -> j3577122212;
	j294746142 [label="+5 Chemistry",color=orange];
		j294746142 -> j1217774859;
	j4197356837 [label="+10 Chemistry",color=orange];
		j4197356837 -> j2930221757;
	j242826396 [label="+15 Chemistry",color=orange];
		j242826396 -> j1838043737;
	j2966526534 [label="Siento que él no hablaría conmigo.",shape=box,color=red];
		j2966526534 -> j2256293749;
	j2525273464 [label="Le quiero ayudar, si puedo. ¿Tienes algún consejo?",shape=box,color=red];
		j2525273464 -> j2256293749;
	j1357504939 [label="Espero que no sea eso lo que estás haciendo aquí.",shape=box,color=blue];
		j1357504939 -> j4127960885;
		j1357504939 -> j3772506316;
	j3577122212 [label="Boolean MarieBeggar1 is now true.",color=orange];
		j3577122212 -> j1486369569;
	j1217774859 [label="Al parecer, te dicen que eres un lobo, ¡pero conmigo tienes esos modales! Es muy dulce verlo. Creo que sé lo que quieres preguntar. ¿Por qué estaba en la calle?",shape=box,color=blue];
		j1217774859 -> j3617410686;
	j2930221757 [label="Creo que algún día habrá un cuento sobre ti. ¡Qué idea tan encantadora! Tal vez debería escribirlo. ¡Pero estaría en gaullique! Imaginez cela !",shape=box,color=blue];
		j2930221757 -> j2442803744;
	j1838043737 [label="Entonces realmente lo entiendes. Soy más que la hermana Marie, la pobre niña sin pies que pudo volar. Y que Lyon es más que un sacerdote trágico que lleva sus cargas en silencio.",shape=box,color=blue];
		j1838043737 -> j3671672066;
	j2256293749 [label="+10 Chemistry",color=orange];
		j2256293749 -> j3149177137;
	j4127960885 [label="No es eso. Estoy acostumbrado a ser la \"atracción local\", sé como se sienten ustedes dos. ",shape=box,color=red];
		j4127960885 -> j538381733;
	j3772506316 [label="No, solo tenía curiosidad. Y la verdad, estaba preocupado por él. Creo que disimula su dolor.",shape=box,color=red];
		j3772506316 -> j4232759225;
	j1486369569 [label="Te puedes imaginar que no hay muchos trabajos o lugares para alguien como yo, sin unas piernas que funcionen, dans la Cité de la Lumière en mi tiempo.",shape=box,color=blue];
		j1486369569 -> j3277783688;
	j2442803744 [label="O quizás no lo imagines, puede que se vuelva realidad. ¡Ja! Y con esa maravillosa nota, me temo que debo decirte adieu. ¡El Murmullo nunca descansa!",shape=box,color=blue];
		j2442803744 -> "Chat ends.";
	j3671672066 [label="Recuerda eso y seremos buenos amigos, creo. Y con esa maravillosa nota, me temo que debo decirte adieu. ¡El Murmullo nunca descansa!",shape=box,color=blue];
		j3671672066 -> "Chat ends.";
	j3149177137 [label="Sé paciente. Él es... no muy comunicativo al principio. Pero se acercará a ti, cuando sea tiempo. Si tienes buenas intenciones, él lo sabrá. Pero por ahora, me temo que debo decirte adieu.",shape=box,color=blue];
		j3149177137 -> "Chat ends.";
	j538381733 [label="Oui, me imagino que lo eres, una criatura que viaja en el tiempo quien puede hacer bucles en el tiempo y crear mundos de la nada! Eres como un mago, non ?",shape=box,color=blue];
		j538381733 -> j4017616765;
		j538381733 -> j1164157699;
	j4232759225 [label="+15 Chemistry",color=orange];
		j4232759225 -> j1203051066;
	j3277783688 [label="Por eso supongo que Lyon y yo nos convertimos en familia tan rápido. Nunca me miró con lástima. Ni yo a él.",shape=box,color=blue];
		j3277783688 -> j1106866202;
		j3277783688 -> j706988830;
	j1203051066 [label="Estás en lo correcto, él disimula. Pero siente que es necesario hacerlo, para proteger a aquellos que lo rodean. Cuando siente que no es necesario, te dirá que es lo que le preocupa. Sé paciente. Te hablará a su debido tiempo.",shape=box,color=blue];
		j1203051066 -> j1404843639;
	j1106866202 [label="Espero que pronto se sienta lo suficientemente cómodo como para hablarme.",shape=box,color=red];
		j1106866202 -> j2699470711;
	j706988830 [label="Me alegra que se hayan encontrado el uno al otro. Todos somos más de lo que parecemos a primera vista.",shape=box,color=red];
		j706988830 -> j242826396;
	j1404843639 [label="Bah. Me temo que debo decirte adieu. ¡El Murmullo nunca descansa!",shape=box,color=blue];
		j1404843639 -> "Chat ends.";
	j2699470711 [label="+10 Chemistry",color=orange];
		j2699470711 -> j3270387739;
	j3270387739 [label="Sé paciente. Él es... no muy comunicativo al principio. Pero vendrá a ti, cuando sea tiempo. Si tienes buenas intenciones, él lo sabrá. Pero por ahora, me temo que debo decirte adieu.",shape=box,color=blue];
		j3270387739 -> "Chat ends.";
}