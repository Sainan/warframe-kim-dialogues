		1526 -> 1532;
	1527 [label="Al parecer, te dicen que eres un lobo, ¡pero conmigo tienes esos modales! Es muy dulce verlo. Creo que sé lo que quieres preguntar. ¿Por qué estaba en la calle?",shape=box,color=blue];
		1527 -> 1519;
	1528 [label="Creo que algún día habrá un cuento sobre ti. ¡Qué idea tan encantadora! Tal vez debería escribirlo. ¡Pero estaría en gaullique! Imaginez cela !",shape=box,color=blue];
		1528 -> 1533;
	1529 [label="Entonces realmente lo entiendes. Soy más que la hermana Marie, la pobre niña sin pies que pudo volar. Y que Lyon es más que un sacerdote trágico que lleva sus cargas en silencio.",shape=box,color=blue];
		1529 -> 1534;
	1530 [label="+10 Chemistry",color=orange];
		1530 -> 1535;
	1536 [label="No es eso. Estoy acostumbrado a ser la \"atracción local\", sé como se sienten ustedes dos. ",shape=box,color=red];
		1536 -> 1541;
	1537 [label="No, solo tenía curiosidad. Y la verdad, estaba preocupado por él. Creo que disimula su dolor.",shape=box,color=red];
		1537 -> 1542;
	1532 [label="Te puedes imaginar que no hay muchos trabajos o lugares para alguien como yo, sin unas piernas que funcionen, dans la Cité de la Lumière en mi tiempo.",shape=box,color=blue];
		1532 -> 1538;
	1533 [label="O quizás no lo imagines, puede que se vuelva realidad. ¡Ja! Y con esa maravillosa nota, me temo que debo decirte adieu. ¡El Murmullo nunca descansa!",shape=box,color=blue];
		1533 -> 1539;
	1534 [label="Recuerda eso y seremos buenos amigos, creo. Y con esa maravillosa nota, me temo que debo decirte adieu. ¡El Murmullo nunca descansa!",shape=box,color=blue];
		1534 -> 1540;
	1535 [label="Sé paciente. Él es... no muy comunicativo al principio. Pero se acercará a ti, cuando sea tiempo. Si tienes buenas intenciones, él lo sabrá. Pero por ahora, me temo que debo decirte adieu.",shape=box,color=blue];
		1535 -> 2424;
	1541 [label="Oui, me imagino que lo eres, una criatura que viaja en el tiempo quien puede hacer bucles en el tiempo y crear mundos de la nada! Eres como un mago, non ?",shape=box,color=blue];
