	1543 [label="Espero que pronto se sienta lo suficientemente cómodo como para hablarme.",shape=box,color=red];
		1543 -> 1548;
	1544 [label="Me alegra que se hayan encontrado el uno al otro. Todos somos más de lo que parecemos a primera vista.",shape=box,color=red];
		1544 -> 1549;
	1550 [label="Bah. Me temo que debo decirte adieu. ¡El Murmullo nunca descansa!",shape=box,color=blue];
