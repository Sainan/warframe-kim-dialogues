	1545 [label="Eso lo resume bastante bien.",shape=box,color=red];
		1545 -> 1521;
	1546 [label="La verdad me gustaría que la gente me viera como algo más que eso.",shape=box,color=red];
		1546 -> 1522;
	1547 [label="Estás en lo correcto, él disimula. Pero siente que es necesario hacerlo, para proteger a aquellos que lo rodean. Cuando siente que no es necesario, te dirá que es lo que le preocupa. Sé paciente. Te hablará a su debido tiempo.",shape=box,color=blue];
