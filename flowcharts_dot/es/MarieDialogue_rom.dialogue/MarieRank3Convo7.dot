		1489 -> 1492;
	1494 [label="Mi querido Lyon ya llevaba tiempo establecido en la Cathédrale cuando la Mère Supérieure me acogió, y me uní a la iglesia de las Luminarias como una hermana. (¡Me emociona que estés hablando!)",shape=box,color=blue];
		1494 -> 1497;
		1494 -> 1498;
	1493 [label="Te voy a pedir que definas eso antes de que sigamos. Y te voy a pedir que lo hagas gentilmente, y con un recordatorio cuidadoso de que él es el hermano de mi alma.",shape=box,color=blue];
		1493 -> 1495;
		1493 -> 1496;
	1492 [label="Chat ends.",color=orange];
	1497 [label="¿Necesitabas... un lugar donde quedarte?",shape=box,color=red];
		1497 -> 1501;
	1498 [label="¿Puedo preguntarte algo delicado?",shape=box,color=red];
		1498 -> 1502;
	1495 [label="Si esta conversación te molesta, podemos pasar a otra cosa.",shape=box,color=red];
		1495 -> 1499;
	1496 [label="No te quiero molestar en absoluto. Sólo me preocupo por él. Tiene una apariencia estoica, pero entiendo que está sufriendo, eso es todo.",shape=box,color=red];
		1496 -> 1500;
	1501 [label="Porque mi famille me desecho allí muchos años antes cuando era una pequeña niña. Pasé muchos años mendigando, sobreviviendo.",shape=box,color=blue];
		1501 -> 1507;
	1502 [label="+5 Chemistry",color=orange];
		1502 -> 1508;
	1499 [label="No, no. Está bien. Simplemente estoy acostumbrada a que los curiosos se acerquen, que lleguen a golpear las barras de su jaula como si fuera un monstre de cirque.",shape=box,color=blue];
		1499 -> 1503;
		1499 -> 1504;
