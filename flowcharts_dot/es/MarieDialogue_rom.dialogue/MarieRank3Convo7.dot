	1500 [label="+5 Chemistry",color=orange];
		1500 -> 1506;
	1507 [label="Update boolean MarieBeggar1",color=orange];
		1507 -> 1512;
	1508 [label="Al parecer, te dicen que eres un lobo, ¡pero conmigo tienes esos modales! Es muy dulce verlo. Creo que sé lo que quieres preguntar. ¿Por qué estaba en la calle?",shape=box,color=blue];
		1508 -> 1501;
	1503 [label="¿Cómo se conocieron?",shape=box,color=red];
		1503 -> 1509;
	1504 [label="Estoy acostumbrado a ser la \"atracción local\", entiendo por qué pudieras estar a la defensiva.",shape=box,color=red];
		1504 -> 1510;
	1505 [label="Está bien. Sólo me preocupo por él.",shape=box,color=red];
		1505 -> 1511;
	1506 [label="Me... disculpo por mi brusquedad. Simplemente estoy acostumbrada a que los curiosos se acerquen, que lleguen a golpear las barras de su jaula como si fuera un monstre de cirque.",shape=box,color=blue];
		1506 -> 1504;
		1506 -> 1505;
	1512 [label="Te puedes imaginar que no hay muchos trabajos o lugares para alguien como yo, sin unas piernas que funcionen, dans la Cité de la Lumière en mi tiempo.",shape=box,color=blue];
		1512 -> 1518;
	1509 [label="Mi querido Lyon ya llevaba tiempo establecido en la Cathédrale cuando la Mère Supérieure me acogió, y me uní a la iglesia de las Luminarias como una hermana.",shape=box,color=blue];
		1509 -> 1513;
		1509 -> 1514;
	1510 [label="Oui, me imagino que lo eres, una criatura que viaja en el tiempo quien puede hacer bucles en el tiempo y crear mundos de la nada! Eres como un mago, non ?",shape=box,color=blue];
		1510 -> 1515;
		1510 -> 1516;
	1511 [label="+5 Chemistry",color=orange];
		1511 -> 1517;
	1518 [label="Por eso supongo que Lyon y yo nos convertimos en familia tan rápido. Nunca me miró con lástima. Ni yo a él.",shape=box,color=blue];
		1518 -> 1525;
	1513 [label="¿Necesitabas... un lugar donde quedarte?",shape=box,color=red];
		1513 -> 1519;
	1514 [label="¿Puedo preguntarte algo delicado?",shape=box,color=red];
		1514 -> 1520;
	1515 [label="Eso lo resume bastante bien.",shape=box,color=red];
		1515 -> 1521;
	1516 [label="La verdad me gustaría que la gente me viera como algo más que eso.",shape=box,color=red];
		1516 -> 1522;
	1517 [label="Y adoro eso de ti. Es fuerte y puede soportar lo que se le ha impuesto. Pero todas las cargas son más fáciles cuando se llevan con alguien.",shape=box,color=blue];
		1517 -> 1523;
		1517 -> 1524;
	1525 [label="Mientras otros se apresuran a golpear con curiosidad las barras de su jaula como si fuera una especie de monstre de cirque.",shape=box,color=blue];
		1525 -> 1531;
	1519 [label="Porque mi famille me desecho allí muchos años antes cuando era una pequeña niña. Pasé muchos años mendigando, sobreviviendo.",shape=box,color=blue];
		1519 -> 1526;
	1520 [label="+5 Chemistry",color=orange];
