digraph {
	"MarieRank1Convo4 begins." [color=orange];
		"MarieRank1Convo4 begins." -> j2212172046;
	j2212172046 [label="¿Puedo hacerte una pregunta que espero no suene grosera? Aún estamos en las primeras etapas de nuestra amistad, sobre todo contigo, que, al parecer, nos conocemos desde hace tantos años.",shape=box,color=blue];
		j2212172046 -> j3803174911;
		j2212172046 -> j2700364365;
		j2212172046 -> j202800200;
	j3803174911 [label="Sinceramente, he olvidado la mayor parte de los años que he vivido. ",shape=box,color=red];
		j3803174911 -> j1562615790;
	j2700364365 [label="Claro, no hay problema. Adelante.",shape=box,color=red];
		j2700364365 -> j2947588656;
	j202800200 [label="[Fin]",shape=box,color=red];
		j202800200 -> "Chat ends.";
	j1562615790 [label="¡Por Sol! Me rompes el corazón con tus palabras. Tú y el diablo tienen la mente tan vacía como un libro sin capítulos, non ?",shape=box,color=blue];
		j1562615790 -> j1272935677;
		j1562615790 -> j2302323603;
	j2947588656 [label="+5 Chemistry",color=orange];
		j2947588656 -> j523704316;
	"Chat ends." [color=orange];
	j1272935677 [label="No extraño las partes olvidadas de mi pasado.",shape=box,color=red];
		j1272935677 -> j3677589587;
	j2302323603 [label="Sí, pero por razones muy diferentes.",shape=box,color=red];
		j2302323603 -> j3664258943;
	j523704316 [label="Evaluate expressions on HellKeyPlayed counter",color=orange];
		j523704316 -> j380212148 [label="x > 0",color=purple];
		j523704316 -> j2158199115 [label="x <= 0",color=purple];
		j523704316 -> j2158199115 [label="false",color=purple];
	j3677589587 [label="¿En serio? Parece que eres el único en esta situación. Entre el niño y el diablo, cada uno parece estar buscando partes de sí mismo que ha perdido.",shape=box,color=blue];
		j3677589587 -> j1544304792;
		j3677589587 -> j879197074;
	j3664258943 [label="¿Es inapropiado preguntar por qué te ves perdido? Conozco las razones del niño y del diablo, pero no las tuyas.",shape=box,color=blue];
		j3664258943 -> j1544304792;
		j3664258943 -> j879197074;
	j380212148 [label="¿Por qué accediste a ayudar al diablo en sus planes? He oído que eres responsable de la masacre de los suyos.",shape=box,color=blue];
		j380212148 -> j1544093501;
		j380212148 -> j410812062;
		j380212148 -> j2987176338;
	j2158199115 [label="¿Pretendes ayudar al diablo en sus planes? He oído que eres responsable de la masacre de los suyos.",shape=box,color=blue];
		j2158199115 -> j1544093501;
		j2158199115 -> j410812062;
		j2158199115 -> j2987176338;
	j1544304792 [label="Pasé un número indeterminado de años muriendo a manos de... mí mismo. No me importa no poder recordarlos a todos.",shape=box,color=red];
		j1544304792 -> j3064075628;
	j879197074 [label="En resumen, pasé... muchos años sufriendo. Supongo que es una especie de mecanismo de autodefensa, olvidar...",shape=box,color=red];
		j879197074 -> j1128412441;
	j1544093501 [label="Ese era mi otro yo. Creo en culpar a las individuos, no a las sociedades.",shape=box,color=red];
		j1544093501 -> j4239912292;
	j410812062 [label="No fui yo, fue el niño. Pero odio a los orokin tanto como él.",shape=box,color=red];
		j410812062 -> j4011854049;
	j2987176338 [label="No estuve allí la Noche de los Tambores Naga cuando los tenno atacaron a los orokin. Ese era el chico.",shape=box,color=red];
		j2987176338 -> j2281464686;
	j3064075628 [label="No te culpo. Si yo fuera víctima de semejante abuso, estaría decidido a olvidarlo todo. Como mínimo, no iría a buscarlos.",shape=box,color=blue];
		j3064075628 -> j3553578646;
	j1128412441 [label="¡No me cabe la menor duda! Si yo sufriera ese tipo de abuso, imagino que mi alma haría algo similar. Ocultaría todo aquello que no tenga solución y que sólo cause daño.",shape=box,color=blue];
		j1128412441 -> j3553578646;
	j4239912292 [label="Add 1 to Thermostat counter",color=orange];
		j4239912292 -> j410199735;
	j4011854049 [label="Add -1 to Thermostat counter",color=orange];
		j4011854049 -> j410515483;
	j2281464686 [label="La Noche de los Tambores Naga. ¡Oh, puedo verlo en mi cabeza! Quelles couleurs magnifiques !",shape=box,color=blue];
		j2281464686 -> j3591392245;
	j3553578646 [label="+5 Chemistry",color=orange];
		j3553578646 -> j2610012064;
	j410199735 [label="Oui, je comprends. Nos apuramos por quemar el edificio, cuando el olor proviene de las ratas que deambulan por sus paredes.",shape=box,color=blue];
		j410199735 -> j1534758285;
	j410515483 [label="Je meurs d'envie de savoir pourquoi ! Pero eso será para después. Si no, nos quedaremos aquí para siempre y Monsieur Loid se enojará conmigo.",shape=box,color=blue];
		j410515483 -> j4192617946;
	j3591392245 [label="Tendré que hablar con Monsieur Loid para obtener más detalles, pero...",shape=box,color=blue];
		j3591392245 -> j4192617946;
	j2610012064 [label="Sin embargo, esto puede darme una idea de lo que quería hablarte.",shape=box,color=blue];
		j2610012064 -> j523704316;
	j1534758285 [label="Pero eso será para otro día. Si no, nos quedaremos aquí para siempre y Monsieur Loid se enojará conmigo.",shape=box,color=blue];
		j1534758285 -> j4192617946;
	j4192617946 [label="Evaluate expressions on HellKeyPlayed counter",color=orange];
		j4192617946 -> j3654528347 [label="x > 0",color=purple];
		j4192617946 -> j2246249957 [label="x <= 0",color=purple];
		j4192617946 -> j2246249957 [label="false",color=purple];
	j3654528347 [label="Pardonnez-moi ! No te dejo hablar. Entonces, ¿para qué ayudar al diablo?",shape=box,color=blue];
		j3654528347 -> j1327740508;
		j3654528347 -> j3527598342;
		j3654528347 -> j3382563026;
		j3654528347 -> j2333979915;
	j2246249957 [label="Pardonnez-moi ! No te dejo hablar. Entonces, ¿vas a echarle una mano al diablo?",shape=box,color=blue];
		j2246249957 -> j2333979915;
		j2246249957 -> j3382563026;
		j2246249957 -> j3527598342;
		j2246249957 -> j1327740508;
	j1327740508 [label="No ha hecho nada para demostrar que no merece ayuda... todavía.",shape=box,color=red];
		j1327740508 -> j1505960271;
	j3527598342 [label="No creo que pueda permitirme el lujo de rechazar aliados.",shape=box,color=red];
		j3527598342 -> j643880197;
	j3382563026 [label="[Confiesa interés en Roathe.] Hay algo fascinante en él...",shape=box,color=red];
		j3382563026 -> j1494816050;
	j2333979915 [label="Parece que está haciendo lo que tiene que hacer para sobrevivir. No puedo culparlo.",shape=box,color=red];
		j2333979915 -> j2502414170;
	j1505960271 [label="Add 1 to Thermostat counter",color=orange];
		j1505960271 -> j1358181769;
	j643880197 [label="Boolean MarieRoatheSoldier is now true.",color=orange];
		j643880197 -> j2787733841;
	j1494816050 [label="Boolean DrifterRoathe is now true.",color=orange];
		j1494816050 -> j3202287330;
	j2502414170 [label="Add -1 to Thermostat counter",color=orange];
		j2502414170 -> j1087108852;
	j1358181769 [label="+5 Chemistry",color=orange];
		j1358181769 -> j220846414;
	j2787733841 [label="Ah, ya veo. Tu trabajo es simplemente reunir soldados. Pero este demonio prefiere clavarte una daga en las costillas antes que cuidarte la espalda.",shape=box,color=blue];
		j2787733841 -> j2875458197;
	j3202287330 [label="Le diable séduit les cœurs les plus forts. Juega con astucia, pero ten cuidado. Asegúrate de que te mire a los ojos y nada más. ",shape=box,color=blue];
		j3202287330 -> j3647141405;
	j1087108852 [label="Me parece que ha sobrevivido más de lo que nadie debería. Creo que quizás el infierno debería regresar y reclamar lo que le pertenece, ya que parece habérsele ido.",shape=box,color=blue];
		j1087108852 -> j3647141405;
	j220846414 [label="Alabo tu compasión, me llena de alegría. Las Luminarias nos enseñan que todos deberían poder recibir ayuda. Que todos pueden ser perdonados. Pero... sólo si eso piden.",shape=box,color=blue];
		j220846414 -> j4265073276;
	j2875458197 [label="Él no es tu aliado y nunca lo será. Este diablo sólo se pone del lado de quienes sirven a sus intereses.",shape=box,color=blue];
		j2875458197 -> j3962149888;
		j2875458197 -> j766047724;
		j2875458197 -> j1290530953;
	j3647141405 [label="+5 Chemistry",color=orange];
		j3647141405 -> j895646982;
	j4265073276 [label="Es un trabajo sin fin ayudar a quien nunca suda en el campo de su propia redención, es la vida de un esclavo siempre sometido a trabajos forzados.",shape=box,color=blue];
		j4265073276 -> j3962149888;
		j4265073276 -> j766047724;
		j4265073276 -> j1290530953;
	j3962149888 [label="Sé más que tú sobre los orokin y su situación. No necesito tu ayuda.",shape=box,color=red];
		j3962149888 -> j1886932363;
	j766047724 [label="Agradezco tus advertencias. Las tendré en cuenta al tratar con él.",shape=box,color=red];
		j766047724 -> j3960853175;
	j1290530953 [label="Gracias. Pero lo estoy superando. Y, lo más importante, he lidiado con cosas peores que él.",shape=box,color=red];
		j1290530953 -> j4078559017;
	j895646982 [label="Pero estoy siendo cruel... no lo conoces. No lo ves como es. Simplemente no quiero que sufras.",shape=box,color=blue];
		j895646982 -> j3962149888;
		j895646982 -> j766047724;
		j895646982 -> j1290530953;
	j1886932363 [label="Boolean MarieRoatheWarning is now true.",color=orange];
		j1886932363 -> j2333002440;
	j3960853175 [label="+10 Chemistry",color=orange];
		j3960853175 -> j2552536202;
	j4078559017 [label="+5 Chemistry",color=orange];
		j4078559017 -> j3968367261;
	j2333002440 [label="Pardon. No te conozco bien, ni conozco tu capacidad para resistir la manipulación. Sólo me preocupa que te estemos abrumando con nuestras desgracias.",shape=box,color=blue];
		j2333002440 -> j3193220306;
	j2552536202 [label="Eso es todo lo que pido. Merci, merci, merci. Ahora, me temo que tengo que irme.",shape=box,color=blue];
		j2552536202 -> "Chat ends.";
	j3968367261 [label="Oui, vous avez raison. No te conozco bien, ni conozco tu capacidad para resistir la manipulación. Sólo me preocupa que te estemos abrumando con nuestras desgracias.",shape=box,color=blue];
		j3968367261 -> j427154238;
	j3193220306 [label="No volveré a cruzar los límites.",shape=box,color=blue];
		j3193220306 -> "Chat ends.";
	j427154238 [label="Y ahora, temo que debo irme.",shape=box,color=blue];
		j427154238 -> "Chat ends.";
}