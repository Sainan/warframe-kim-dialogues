	281 [label="Ah, ya veo. Tu trabajo es simplemente reunir soldados. Pero este demonio prefiere clavarte una daga en las costillas antes que cuidarte la espalda.",shape=box,color=blue];
		281 -> 284;
	280 [label="Le diable séduit les cœurs les plus forts. Juega con astucia, pero ten cuidado. Asegúrate de que te mire a los ojos y nada más. ",shape=box,color=blue];
		280 -> 283;
	279 [label="Me parece que ha sobrevivido más de lo que nadie debería. Creo que quizás el infierno debería regresar y reclamar lo que le pertenece, ya que parece habérsele ido.",shape=box,color=blue];
		279 -> 283;
	285 [label="Alabo tu compasión, me llena de alegría. Las Luminarias nos enseñan que todos deberían poder recibir ayuda. Que todos pueden ser perdonados. Pero... sólo si eso piden.",shape=box,color=blue];
