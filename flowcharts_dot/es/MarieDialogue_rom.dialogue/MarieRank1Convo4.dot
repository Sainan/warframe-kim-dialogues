	259 [label="La noche de los tambores Naga. ¡Oh, puedo verlo en mi cabeza! Quelles couleurs magnifiques !",shape=box,color=blue];
		259 -> 264;
	265 [label="+5 Chemistry",color=orange];
		265 -> 268;
	262 [label="Oui, je comprends. Nos apuramos por quemar el edificio, cuando el olor proviene de las ratas que deambulan por sus paredes.",shape=box,color=blue];
		262 -> 266;
	263 [label="Je meurs d'envie de savoir pourquoi ! Pero eso será para después. Si no, nos quedaremos aquí para siempre y Monsieur Loid se enojará conmigo.",shape=box,color=blue];
		263 -> 267;
	264 [label="Tendré que hablar con Monsieur Loid para obtener más detalles, pero...",shape=box,color=blue];
