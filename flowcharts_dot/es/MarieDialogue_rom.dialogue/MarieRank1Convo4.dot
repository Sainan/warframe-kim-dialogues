		237 -> 238;
	238 [label="¿Puedo hacerte una pregunta que espero no suene grosera? Aún estamos en las primeras etapas de nuestra amistad, sobre todo contigo, que, al parecer, nos conocemos desde hace tantos años.",shape=box,color=blue];
		238 -> 241;
