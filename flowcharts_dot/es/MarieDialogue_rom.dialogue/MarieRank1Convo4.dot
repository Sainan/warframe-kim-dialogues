		249 -> 254;
	248 [label="¿Pretendes ayudar al diablo en sus planes? He oído que eres responsable de la masacre de los suyos.",shape=box,color=blue];
		248 -> 252;
		248 -> 253;
		248 -> 254;
	255 [label="Pasé un número indeterminado de años muriendo a manos de... mí mismo. No me importa no poder recordarlos a todos.",shape=box,color=red];
		255 -> 260;
	256 [label="En resumen, pasé... muchos años sufriendo. Supongo que es una especie de mecanismo de autodefensa, olvidar...",shape=box,color=red];
		256 -> 261;
	252 [label="Ese era mi otro yo. Creo en culpar a las individuos, no a las sociedades.",shape=box,color=red];
		252 -> 257;
	253 [label="No fui yo, fue el niño. Pero odio a los orokin tanto como él.",shape=box,color=red];
		253 -> 258;
	254 [label="No estuve allí la noche de los tambores Naga cuando los tenno atacaron a los orokin. Ese era el chico.",shape=box,color=red];
		254 -> 259;
	260 [label="No te culpo. Si yo fuera víctima de semejante abuso, estaría decidido a olvidarlo todo. Como mínimo, no iría a buscarlos.",shape=box,color=blue];
		260 -> 265;
	261 [label="¡No me cabe la menor duda! Si yo sufriera ese tipo de abuso, imagino que mi alma haría algo similar. Ocultaría todo aquello que no tenga solución y que sólo cause daño.",shape=box,color=blue];
		261 -> 265;
