	250 [label="¿En serio? Parece que eres el único en esta situación. Entre el niño y el diablo, cada uno parece estar buscando partes de sí mismo que ha perdido.",shape=box,color=blue];
		250 -> 255;
		250 -> 256;
	251 [label="¿Es inapropiado preguntar por qué te ves perdido? Conozco las razones del niño y del diablo, pero no las tuyas.",shape=box,color=blue];
		251 -> 255;
		251 -> 256;
	249 [label="¿Por qué accediste a ayudar al diablo en sus planes? He oído que eres responsable de la masacre de los suyos.",shape=box,color=blue];
		249 -> 252;
