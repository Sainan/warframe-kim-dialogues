	1592 [label="Más pruebas de que el diablo y sus semejantes debían ser condenados. Pero quizás tengas razón sobre Otak y los de su clase, o quizás te tranquilice creerlo.",shape=box,color=blue];
		1592 -> 1593;
	1593 [label="Y a fin de cuentas puede ser que me equivoque. Nunca está de más mostrar amabilidad y respeto.",shape=box,color=blue];
		1593 -> 1600;
	1594 [label="Quizás tengas razón, pero no creo que los demonios Orokin supieran más del funcionamiento del alma que nosotros. No eran grandes dioses.",shape=box,color=blue];
		1594 -> 1593;
	1595 [label="Quizás tengas razón, o quizás te dé paz creerlo.",shape=box,color=blue];
