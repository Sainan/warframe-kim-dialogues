		1948 -> 1560 [label="false",color=purple];
	1949 [label="Oui ! Tienes razón, ese es el corazón (o la cabeza) del problema, ja. Uno cree que es sacrosanto, el otro una copia.",shape=box,color=blue];
		1949 -> 1948;
	1947 [label="Todo indica que era un genio y la mente detrás del aprovechamiento de los cristales de argón.",shape=box,color=red];
		1947 -> 1556;
	1558 [label="¿Cómo puede Monsieur Necraloid tener un alma, si ni siquiera tiene sus propios huesos?",shape=box,color=blue];
		1558 -> 1562;
