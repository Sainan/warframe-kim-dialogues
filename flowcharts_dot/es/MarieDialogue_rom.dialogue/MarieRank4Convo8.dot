	1596 [label="Update boolean MarieOtak1",color=orange];
		1596 -> 2945;
	1603 [label="Oui, eso es muy sabio. Simplemente estoy pensando en voz alta y preguntándote qué son. Tienes toda la razón, nunca está de más mostrar amabilidad y respeto.",shape=box,color=blue];
		1603 -> 1610;
	1604 [label="Quizás tengas razón. ¡Y espero que así sea! En cualquier caso, debemos ser amables, pues son seres pensantes. Y aquello que piensa, siente.",shape=box,color=blue];
