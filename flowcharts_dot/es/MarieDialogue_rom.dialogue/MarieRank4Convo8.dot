		1558 -> 1564;
	1557 [label="¿Es una prueba más de que Monsieur Necraloid no tiene alma?",shape=box,color=blue];
		1557 -> 1562;
		1557 -> 1563;
		1557 -> 1564;
	1559 [label="Sé que no tienes certeza de que Monsieur Necraloid pueda tener alma. Pero no sé cómo podría, si ni siquiera tiene sus propios huesos.",shape=box,color=blue];
		1559 -> 1562;
		1559 -> 1563;
		1559 -> 1564;
	1560 [label="Estoy hablando de un aparato tecnológico muy elaborado diseñado para parecerse a un hombre, ¿no es así? Un fonógrafo, muchísimo más complejo.",shape=box,color=blue];
		1560 -> 1565;
		1560 -> 1566;
		1560 -> 1567;
		1560 -> 1568;
		1560 -> 1569;
	1556 [label="Que se extraen del Vacío. Son la razón por la que podemos crear muchos de los poderosos warframes y armas que fabricamos.",shape=box,color=red];
		1556 -> 1561;
	1562 [label="Tal vez tengas razón. Tal vez realmente sean solo copias de personas. Pero no lo sé y de todos modos tenemos que tratarlos como si fueran personas.",shape=box,color=red];
		1562 -> 1571;
	1563 [label="Creo que el Necraloid es la excepción, no la regla. Fue creado como una réplica de una persona, no a partir de una persona.",shape=box,color=red];
		1563 -> 1572;
	1564 [label="Tienes razón. Probablemente sea mejor, y más humano, que no sean almas atrapadas en experimentos científicos complejos...",shape=box,color=red];
		1564 -> 1573;
	1565 [label="Puede que el Necraloid no tenga alma, pero es único. Otros céfalones, como Otak, sí la tienen. Fueron destruidos en su proceso de creación.",shape=box,color=red];
		1565 -> 1574;
	1566 [label="Tienes razón. ¿Qué sugieres que haga al respecto?",shape=box,color=red];
		1566 -> 1575;
	1567 [label="Tienes razón. No la tienen. Pero eso no significa que podamos tratarlos mal.",shape=box,color=red];
		1567 -> 1576;
	1568 [label="No sé si tienes razón. Pero aún pueden pensar y sentir, y no podemos tratarlos como cosas.",shape=box,color=red];
		1568 -> 1577;
	1569 [label="El Necraloid tiene alma. Todos los céfalones la tienen.",shape=box,color=red];
		1569 -> 1578;
	1561 [label="Se especializó en cristalografía. Y sus trabajos se archivaron aquí, en los laboratorios.",shape=box,color=red];
