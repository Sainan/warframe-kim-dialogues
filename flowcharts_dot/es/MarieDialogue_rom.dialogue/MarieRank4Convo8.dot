		j956613021 -> j3977126476;
	j1007520421 [label="Boolean MarieCephalonSoul is now true.",color=orange];
		j1007520421 -> j1267519885;
	j3660742713 [label="Por alguna razón, no sé por qué, lo convirtieron en un céfalon y le dieron su propio caparazón necraloide.",shape=box,color=red];
		j3660742713 -> j4213358425;
	j2170834562 [label="Boolean MarieCephalonNoSoul is now false.",color=orange];
		j2170834562 -> j41840244;
	j2292734754 [label="Boolean MarieCephalonUnsure is now false.",color=orange];
		j2292734754 -> j3369963611;
	j2257592565 [label="Boolean MarieCephalonSoul is now false.",color=orange];
		j2257592565 -> j2097970461;
	j1482821798 [label="+5 Chemistry",color=orange];
		j1482821798 -> j1833407343;
	j3508194482 [label="¡Oh, no creas que pretendo que seas cruel! ¡No! Atesóralos, porque son preciosos, y no es culpa suya ser como son.",shape=box,color=blue];
		j3508194482 -> j4110403632;
	j501524458 [label="+5 Chemistry",color=orange];
		j501524458 -> j3508194482;
	j3977126476 [label="+5 Chemistry",color=orange];
		j3977126476 -> j151547801;
	j1267519885 [label="+5 Chemistry",color=orange];
		j1267519885 -> j700714149;
	j4213358425 [label="No todos los cefalones fueron creados como castigo. Pero aquí en Deimos, las cosas salieron... mal, y él resultó gravemente dañado.",shape=box,color=red];
		j4213358425 -> j3998308863;
	j41840244 [label="Boolean MarieCephalonSoul is now false.",color=orange];
		j41840244 -> j3467029352;
	j3369963611 [label="Boolean MarieCephalonNoSoul is now false.",color=orange];
		j3369963611 -> j3909531511;
	j2097970461 [label="Boolean MarieCephalonUnsure is now false.",color=orange];
		j2097970461 -> j3758279007;
	j1833407343 [label="Más pruebas de que el diablo y sus semejantes debían ser condenados. Pero quizás tengas razón sobre Otak y los de su clase, o quizás te tranquilice creerlo.",shape=box,color=blue];
		j1833407343 -> j4110403632;
	j4110403632 [label="Y a fin de cuentas puede ser que me equivoque. Nunca está de más mostrar amabilidad y respeto.",shape=box,color=blue];
		j4110403632 -> j2894393796;
	j151547801 [label="Quizás tengas razón, pero no creo que los demonios Orokin supieran más del funcionamiento del alma que nosotros. No eran grandes dioses.",shape=box,color=blue];
		j151547801 -> j4110403632;
	j700714149 [label="Quizás tengas razón, o quizás te dé paz creerlo.",shape=box,color=blue];
		j700714149 -> j4110403632;
	j3998308863 [label="Pauvre petit...",shape=box,color=blue];
		j3998308863 -> j3134774711;
	j3467029352 [label="+5 Chemistry",color=orange];
		j3467029352 -> j1556091703;
	j3909531511 [label="+5 Chemistry",color=orange];
		j3909531511 -> j421969481;
	j3758279007 [label="+5 Chemistry",color=orange];
		j3758279007 -> j4064518518;
	j2894393796 [label="Voy a volver a hacer una corona de flores para Monsieur Necraloid, de cualquier modo. Se quejó, ¡pero no aceptaré un no!",shape=box,color=blue];
		j2894393796 -> j3945000665;
		j2894393796 -> j3695361766;
		j2894393796 -> j52503894;
	j3134774711 [label="Boolean MarieOtak1 is now true.",color=orange];
		j3134774711 -> j3951815689;
	j1556091703 [label="Oui, eso es muy sabio. Simplemente estoy pensando en voz alta y preguntándote qué son. Tienes toda la razón, nunca está de más mostrar amabilidad y respeto.",shape=box,color=blue];
		j1556091703 -> j4026666733;
	j421969481 [label="Quizás tengas razón. ¡Y espero que así sea! En cualquier caso, debemos ser amables, pues son seres pensantes. Y aquello que piensa, siente.",shape=box,color=blue];
		j421969481 -> j4026666733;
	j4064518518 [label="En cualquier caso, debemos ser amables, pues son seres pensantes. Y aquello que piensa, siente.",shape=box,color=blue];
		j4064518518 -> j4110403632;
	j3945000665 [label="Eso es adorable.",shape=box,color=red];
		j3945000665 -> j366938164;
	j3695361766 [label="¿Una corona de flores?",shape=box,color=red];
		j3695361766 -> j3528263151;
	j52503894 [label="Diviértete.",shape=box,color=red];
		j52503894 -> j4089416208;
	j3951815689 [label="Check boolean LoidFamilyComplete",color=orange];
		j3951815689 -> j3408449281 [label=true,color=green];
		j3951815689 -> j1554959816 [label=false,color=brown];
