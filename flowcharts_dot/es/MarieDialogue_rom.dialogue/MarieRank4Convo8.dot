	1934 [label="Le pregunté a Monsieur Necraloid si el cráneo que lo adornaba había pertenecido a un alma viviente en algún momento o no.",shape=box,color=blue];
		1934 -> 1936;
	1932 [label="Tengo curiosidad de saber por qué hay otra cara en su espalda que parece el garabato de un niño.",shape=box,color=blue];
		1932 -> 1935;
	1933 [label="Chat ends.",color=orange];
	1936 [label="Y Monsieur Necraloid me dijo que era \"su\" cráneo, aunque admitió que Monsieur Loid era el \"original\". Monsieur Loid intervino para decirme que era una versión \"replicada\" de su propio cráneo.",shape=box,color=blue];
		1936 -> 1938;
	1935 [label="Le pregunté a Monsieur Necraloide y a Monsieur Loid, pero ninguno quiso hablar del tema. Sólo me dijeron un nombre: Otak. Y lo dijeron con gran tristeza.",shape=box,color=blue];
		1935 -> 1937;
	1938 [label="¿Cómo es posible? ¿Y qué significa \"replicado\"? ¿Es un cráneo real o es falso? ¿Por qué Monsieur Necraloid y Monsieur Loid me dieron respuestas diferentes?",shape=box,color=blue];
		1938 -> 1940;
		1938 -> 1941;
		1938 -> 1942;
	1937 [label="Así que heme aquí, hablando contigo, esperando que puedas ayudarme.",shape=box,color=blue];
		1937 -> 1939;
	1940 [label="Supongo que, desde la perspectiva del Necraloid, es su cráneo. Es cierto. Pero, desde la perspectiva de Loid, es una réplica.",shape=box,color=red];
		1940 -> 1944;
	1941 [label="Sinceramente, no sé de qué está hecho. Podría ser hueso. O algún tipo de polímero...",shape=box,color=red];
		1941 -> 1945;
	1942 [label="Creo que lo que en verdad quieres saber es si el Necraloid es real, no el cráneo.",shape=box,color=red];
		1942 -> 1946;
	1939 [label="¿Me contarás la historia del pobre Monsieur Otak?",shape=box,color=blue];
		1939 -> 1943;
	1944 [label="Creo que eso es lo que me preocupa. Es la forma en que ambos caballeros consideran su origen. Uno cree que es sacro-santo, el otro una copia.",shape=box,color=blue];
		1944 -> 1948;
	1945 [label="No sé si lo que me inquieta tanto es de qué está hecha la calavera, su origen, o quizá la forma en que ambos caballeros lo interpretan. Uno la considera sacrosanta, el otro una copia.",shape=box,color=blue];
		1945 -> 1948;
	1946 [label="+5 Chemistry",color=orange];
		1946 -> 1949;
	1943 [label="Otak era un arquimediano, un científico y académico orokin. Lo que le ocurrió no es precisamente una historia feliz.",shape=box,color=red];
		1943 -> 1947;
	1948 [label="Evaluate expressions",color=orange];
