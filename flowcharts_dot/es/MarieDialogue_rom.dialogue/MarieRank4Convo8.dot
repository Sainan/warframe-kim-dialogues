	j4026666733 [label="Y a fin de cuentas puede ser que nos equivoquemos. Nunca está de más mostrar amabilidad y respeto. ",shape=box,color=blue];
		j4026666733 -> j2894393796;
	j366938164 [label="+5 Chemistry",color=orange];
		j366938164 -> j2511082154;
	j3528263151 [label="+10 Chemistry",color=orange];
		j3528263151 -> j951535250;
	j4089416208 [label="+5 Chemistry",color=orange];
		j4089416208 -> j27967790;
	j3408449281 [label="¿Cómo llegamos a esto?",shape=box,color=red];
		j3408449281 -> j3066067;
	j1554959816 [label="Espero que algún día puedas conocerlo.",shape=box,color=red];
		j1554959816 -> j126383066;
	j2511082154 [label="Merci ! À la revoyure !",shape=box,color=blue];
		j2511082154 -> "Chat ends.";
	j951535250 [label="¡Oh! Es uno de los ritos de Lua. En el aniversario del fallecimiento de un alma, se trenza una corona o guirnalda de flores y se coloca sobre su cráneo o sobre su tumba. ",shape=box,color=blue];
		j951535250 -> j564055649;
	j27967790 [label="Merci, lo haré! À la revoyure !",shape=box,color=blue];
		j27967790 -> "Chat ends.";
	j126383066 [label="Oui. Pero supongo que no es su silencio lo que me preocupa. Le pregunté a Monsieur Necraloid si el cráneo que lo adornaba perteneció a un alma viviente en algún momento.",shape=box,color=blue];
		j126383066 -> j4032902895;
	j564055649 [label="Las criptas tradicionales para los muertos a menudo tenían los cuerpos expuestos, oui ? Así que se podía hacer esto. Creo que algo de esto ha sobrevivido, incluso hoy en día.",shape=box,color=blue];
		j564055649 -> j3561986340;
	j3561986340 [label="Lo veo reflejado en algunas de las obras de arte Orokin, con su amor por los cráneos. ",shape=box,color=blue];
		j3561986340 -> j1530899544;
		j3561986340 -> j2640942461;
		j3561986340 -> j1556904028;
	j1530899544 [label="Eso explica muchas cosas.",shape=box,color=red];
		j1530899544 -> j2165399940;
	j2640942461 [label="Cuanto más cambian las cosas, ¿eh?",shape=box,color=red];
		j2640942461 -> j2165399940;
	j1556904028 [label="Creo que tu Hija ya lo ha intentado, la pondrás celosa.",shape=box,color=red];
		j1556904028 -> j2900268459;
	j2165399940 [label="Oui ! Ha pasado tanto tiempo, y sin embargo su influencia perdura. Me alegra saber que aún quedan pequeños fragmentos.",shape=box,color=blue];
		j2165399940 -> j674457192;
	j2900268459 [label="Oui ? ¡Entonces espero con ansias el día en que pueda conocerla! Le diré que hice mi mejor esfuerzo.",shape=box,color=blue];
		j2900268459 -> j674457192;
	j674457192 [label="Con o sin calavera falsa, Monsieur Necraloid debería tener una corona. ¡Y le da tanta pena cuando lo mimo! Creo que se sonrojaría si pudiera. Y eso me hace sonreír.",shape=box,color=blue];
		j674457192 -> j4101990552;
	j4101990552 [label="À la revoyure !",shape=box,color=blue];
		j4101990552 -> "Chat ends.";
}