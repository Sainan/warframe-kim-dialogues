digraph {
	graph [fontname="Roboto Condensed"];
	node [fontname="Roboto Condensed"];
	edge [fontname="Roboto Condensed"];

	"MarieRank4Convo8 begins." [color=orange];
		"MarieRank4Convo8 begins." -> j2786051379;
	j2786051379 [label="Check boolean MarieOtak1",color=orange];
		j2786051379 -> j3526662589 [label=true,color=green];
		j2786051379 -> j226072211 [label=false,color=brown];
	j3526662589 [label="Viajero, cuanto más conozco sobre Monsieur Necraloid y Monsieur Otak, más me preocupo...",shape=box,color=blue];
		j3526662589 -> j1682855254;
		j3526662589 -> j380471107;
	j226072211 [label="Viajero, ¿puedo hablar contigo?",shape=box,color=blue];
		j226072211 -> j4073272552;
		j226072211 -> j2429168889;
	j1682855254 [label="¿Por qué?",shape=box,color=red];
		j1682855254 -> j3066067;
	j380471107 [label="¿Cuál es específicamente el problema?",shape=box,color=red];
		j380471107 -> j3066067;
	j4073272552 [label="Claro. ¿Qué pasa?",shape=box,color=red];
		j4073272552 -> j3416103416;
	j2429168889 [label="[Fin.]",shape=box,color=red];
		j2429168889 -> "Chat ends.";
	j3066067 [label="Le pregunté a Monsieur Necraloid si el cráneo que lo adornaba había pertenecido a un alma viviente en algún momento o no.",shape=box,color=blue];
		j3066067 -> j4032902895;
	j3416103416 [label="Tengo curiosidad de saber por qué hay otra cara en su espalda que parece el garabato de un niño.",shape=box,color=blue];
		j3416103416 -> j4099093318;
	"Chat ends." [color=orange];
	j4032902895 [label="Y Monsieur Necraloid me dijo que era \"su\" cráneo, aunque admitió que Monsieur Loid era el \"original\". Monsieur Loid intervino para decirme que era una versión \"replicada\" de su propio cráneo.",shape=box,color=blue];
		j4032902895 -> j2691408527;
	j4099093318 [label="Le pregunté a Monsieur Necraloide y a Monsieur Loid, pero ninguno quiso hablar del tema. Sólo me dijeron un nombre: Otak. Y lo dijeron con gran tristeza.",shape=box,color=blue];
		j4099093318 -> j681912673;
	j2691408527 [label="¿Cómo es posible? ¿Y qué significa \"replicado\"? ¿Es un cráneo real o es falso? ¿Por qué Monsieur Necraloid y Monsieur Loid me dieron respuestas diferentes?",shape=box,color=blue];
		j2691408527 -> j1408529578;
		j2691408527 -> j3638363690;
		j2691408527 -> j2336462351;
	j681912673 [label="Así que heme aquí, hablando contigo, esperando que puedas ayudarme.",shape=box,color=blue];
		j681912673 -> j715043988;
	j1408529578 [label="Supongo que, desde la perspectiva del Necraloid, es su cráneo. Es cierto. Pero, desde la perspectiva de Loid, es una réplica.",shape=box,color=red];
		j1408529578 -> j2684585117;
	j3638363690 [label="Sinceramente, no sé de qué está hecho. Podría ser hueso. O algún tipo de polímero...",shape=box,color=red];
		j3638363690 -> j799187260;
	j2336462351 [label="Creo que lo que en verdad quieres saber es si el Necraloid es real, no el cráneo.",shape=box,color=red];
		j2336462351 -> j13123132;
	j715043988 [label="¿Me contarás la historia del pobre Monsieur Otak?",shape=box,color=blue];
		j715043988 -> j3328973941;
	j2684585117 [label="Creo que eso es lo que me preocupa. Es la forma en que ambos caballeros consideran su origen. Uno cree que es sacro-santo, el otro una copia.",shape=box,color=blue];
		j2684585117 -> j3408858168;
	j799187260 [label="No sé si lo que me inquieta tanto es de qué está hecha la calavera, su origen, o quizá la forma en que ambos caballeros lo interpretan. Uno la considera sacrosanta, el otro una copia.",shape=box,color=blue];
		j799187260 -> j3408858168;
	j13123132 [label="+5 Chemistry",color=orange];
		j13123132 -> j3899896968;
	j3328973941 [label="Otak era un arquimediano, un científico y académico orokin. Lo que le ocurrió no es precisamente una historia feliz.",shape=box,color=red];
		j3328973941 -> j2408791939;
	j3408858168 [label="Evaluate expressions",color=orange];
		j3408858168 -> j3295088627 [label="MarieCephalonSoul",color=purple];
		j3408858168 -> j3630453977 [label="MarieCephalonNoSoul",color=purple];
		j3408858168 -> j3046042184 [label="MarieCephalonUnsure",color=purple];
		j3408858168 -> j3012031889 [label="false",color=purple];
	j3899896968 [label="Oui ! Tienes razón, ese es el corazón (o la cabeza) del problema, ja. Uno cree que es sacrosanto, el otro una copia.",shape=box,color=blue];
		j3899896968 -> j3408858168;
	j2408791939 [label="Todo indica que era un genio y la mente detrás del aprovechamiento de los cristales de argón.",shape=box,color=red];
		j2408791939 -> j1165692872;
	j3295088627 [label="¿Cómo puede Monsieur Necraloid tener un alma, si ni siquiera tiene sus propios huesos?",shape=box,color=blue];
		j3295088627 -> j3258263191;
		j3295088627 -> j3268422255;
		j3295088627 -> j1254029782;
	j3630453977 [label="¿Es una prueba más de que Monsieur Necraloid no tiene alma?",shape=box,color=blue];
		j3630453977 -> j3258263191;
		j3630453977 -> j3268422255;
		j3630453977 -> j1254029782;
	j3046042184 [label="Sé que no tienes certeza de que Monsieur Necraloid pueda tener alma. Pero no sé cómo podría, si ni siquiera tiene sus propios huesos.",shape=box,color=blue];
		j3046042184 -> j3258263191;
		j3046042184 -> j3268422255;
		j3046042184 -> j1254029782;
	j3012031889 [label="Estoy hablando de un aparato tecnológico muy elaborado diseñado para parecerse a un hombre, ¿no es así? Un fonógrafo, muchísimo más complejo.",shape=box,color=blue];
		j3012031889 -> j300164606;
		j3012031889 -> j426567719;
		j3012031889 -> j3554247836;
		j3012031889 -> j1649167364;
		j3012031889 -> j3623849674;
	j1165692872 [label="Que se extraen del Vacío. Son la razón por la que podemos crear muchos de los poderosos warframes y armas que fabricamos.",shape=box,color=red];
		j1165692872 -> j3559405939;
	j3258263191 [label="Tal vez tengas razón. Tal vez realmente sean solo copias de personas. Pero no lo sé y de todos modos tenemos que tratarlos como si fueran personas.",shape=box,color=red];
		j3258263191 -> j2230357975;
	j3268422255 [label="Creo que el Necraloid es la excepción, no la regla. Fue creado como una réplica de una persona, no a partir de una persona.",shape=box,color=red];
		j3268422255 -> j235442725;
	j1254029782 [label="Tienes razón. Probablemente sea mejor, y más humano, que no sean almas atrapadas en experimentos científicos complejos...",shape=box,color=red];
		j1254029782 -> j2770659718;
	j300164606 [label="Puede que el Necraloid no tenga alma, pero es único. Otros céfalones, como Otak, sí la tienen. Fueron destruidos en su proceso de creación.",shape=box,color=red];
		j300164606 -> j1212281627;
	j426567719 [label="Tienes razón. ¿Qué sugieres que haga al respecto?",shape=box,color=red];
		j426567719 -> j1564537897;
	j3554247836 [label="Tienes razón. No la tienen. Pero eso no significa que podamos tratarlos mal.",shape=box,color=red];
		j3554247836 -> j2343276542;
	j1649167364 [label="No sé si tienes razón. Pero aún pueden pensar y sentir, y no podemos tratarlos como cosas.",shape=box,color=red];
		j1649167364 -> j956613021;
	j3623849674 [label="El Necraloid tiene alma. Todos los céfalones la tienen.",shape=box,color=red];
		j3623849674 -> j1007520421;
	j3559405939 [label="Se especializó en cristalografía. Y sus trabajos se archivaron aquí, en los laboratorios.",shape=box,color=red];
		j3559405939 -> j3660742713;
	j2230357975 [label="Boolean MarieCephalonUnsure is now true.",color=orange];
		j2230357975 -> j2170834562;
