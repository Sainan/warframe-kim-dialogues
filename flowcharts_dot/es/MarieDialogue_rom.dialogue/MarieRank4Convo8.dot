		1602 -> 1609;
	1614 [label="Merci ! À la revoyure !",shape=box,color=blue];
		1614 -> 1617;
	1615 [label="¡Oh! Es uno de los ritos de Lua. En el aniversario del fallecimiento de un alma, se trenza una corona o guirnalda de flores y se coloca sobre su cráneo o sobre su tumba. ",shape=box,color=blue];
		1615 -> 1618;
	1616 [label="Merci, lo haré! À la revoyure !",shape=box,color=blue];
		1616 -> 1617;
	1609 [label="Oui. Pero supongo que no es su silencio lo que me preocupa. Le pregunté a Monsieur Necraloid si el cráneo que lo adornaba perteneció a un alma viviente en algún momento.",shape=box,color=blue];
		1609 -> 1936;
	1617 [label="Chat ends.",color=orange];
	1618 [label="Las criptas tradicionales para los muertos a menudo tenían los cuerpos expuestos, oui ? Así que se podía hacer esto. Creo que algo de esto ha sobrevivido, incluso hoy en día.",shape=box,color=blue];
		1618 -> 1619;
	1619 [label="Lo veo reflejado en algunas de las obras de arte Orokin, con su amor por los cráneos. ",shape=box,color=blue];
		1619 -> 1620;
		1619 -> 1621;
		1619 -> 1622;
	1620 [label="Eso explica muchas cosas.",shape=box,color=red];
		1620 -> 1623;
	1621 [label="Cuanto más cambian las cosas, ¿eh?",shape=box,color=red];
		1621 -> 1623;
	1622 [label="Creo que tu Hija ya lo ha intentado, la pondrás celosa.",shape=box,color=red];
		1622 -> 1624;
	1623 [label="Oui ! Ha pasado tanto tiempo, y sin embargo su influencia perdura. Me alegra saber que aún quedan pequeños fragmentos.",shape=box,color=blue];
		1623 -> 1625;
	1624 [label="Oui ? ¡Entonces espero con ansias el día en que pueda conocerla! Le diré que hice mi mejor esfuerzo.",shape=box,color=blue];
		1624 -> 1625;
	1625 [label="Con o sin calavera falsa, Monsieur Necraloid debería tener una corona. ¡Y le da tanta pena cuando lo mimo! Creo que se sonrojaría si pudiera. Y eso me hace sonreír.",shape=box,color=blue];
		1625 -> 1626;
	1626 [label="À la revoyure !",shape=box,color=blue];
		1626 -> 1627;
