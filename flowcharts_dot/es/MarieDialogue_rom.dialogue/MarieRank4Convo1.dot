		2064 -> 2072 [label=false,color=brown];
	2065 [label="Se muerde la pierna y, aunque eso abre la herida y le produce dolor, también le produce alivio.",shape=box,color=blue];
		2065 -> 2073;
	2066 [label="¡Ja! Ya es demasiado tarde para eso. Marie, au travail ! Il y a de l'amour dans l'air !",shape=box,color=blue];
		2066 -> 2074;
	2067 [label="Oui ! Y no podrías detenerme, aunque quisieras. ¡Marie, a trabajar!",shape=box,color=blue];
		2067 -> 2075;
	2068 [label="Chat ends.",color=orange];
	2069 [label="Oui, por supuesto. À bientôt.",shape=box,color=blue];
		2069 -> 2076;
	2070 [label="Oui, por supuesto.",shape=box,color=blue];
		2070 -> 2060;
	2071 [label="Ya sabes cómo empieza mi historia, pero hay una parte que no te conté.",shape=box,color=blue];
		2071 -> 2077;
	2072 [label="Update boolean MarieBackstory1",color=orange];
		2072 -> 2078;
	2073 [label="Le hace daño, pero es parte de él, de todos modos. Y si te acercas a él avec colère, de forma brusca, se espantará al tocarlo.",shape=box,color=blue];
		2073 -> 2079;
	2074 [label="Chat ends.",color=orange];
	2075 [label="Chat ends.",color=orange];
	2076 [label="Chat ends.",color=orange];
	2077 [label="Te conté que mendigaba en la calle cuando era una jeune fille. Y que me iba bien y tenía muchos amigos.",shape=box,color=blue];
		2077 -> 2080;
	2078 [label="Nací en una familia rica, lo que puede sorprenderte. La clase burguesa es bastante cercana a los orokin.",shape=box,color=blue];
		2078 -> 2081;
	2079 [label="Debes ganarte la confianza del perro callejero. Dejar que venga a ti, non ? ¿Eso tiene sentido?",shape=box,color=blue];
		2079 -> 2082;
		2079 -> 2083;
		2079 -> 2084;
	2080 [label="Uno de ellos era un niño mayor llamado Hugo.",shape=box,color=blue];
		2080 -> 2085;
	2081 [label="Pero cuando nací así como yo era... deforme, con mes pieds tordus et inutilisables ? Oh, ma mère no podía permitirlo.",shape=box,color=blue];
		2081 -> 2086;
	2082 [label="Sí, de hecho. Gracias.",shape=box,color=red];
		2082 -> 2087;
	2083 [label="Más de lo que debería, gracias.",shape=box,color=red];
		2083 -> 2088;
	2084 [label="Para nada. Pero gracias por intentarlo.",shape=box,color=red];
		2084 -> 2089;
	2085 [label="Era un poco el líder de la manada. Y siempre se aseguraba de que nadie se metiera conmigo y de que tuviera todo lo que necesitaba.",shape=box,color=blue];
		2085 -> 2090;
	2086 [label="Había apariencias que mantener, oui ? Estándares que mantener.",shape=box,color=blue];
		2086 -> 2091;
	2087 [label="Bien ! Tenía miedo de volver a dejar que mis metáforas se salieran de control.",shape=box,color=blue];
		2087 -> 2092;
	2088 [label="Marie y sus metáforas. Ah, bon.",shape=box,color=blue];
		2088 -> 2092;
	2089 [label="Mince alors. Creo que exageré con mis métaphores.",shape=box,color=blue];
		2089 -> 2092;
	2090 [label="Incluso me ayudó a construir des béquilles (podrías llamarlas... ¿eh?... ¿muletas?) con trozos de madera que encontrábamos. Con ellas podía arrastrarme.",shape=box,color=blue];
		2090 -> 2093;
	2091 [label="Así que, ¿Qué se tenía que hacer con la pobre mal formada de Marie? Me llevaron a la Cité de la Lumière, donde me dejaron en la calle...",shape=box,color=blue];
		2091 -> 2094;
	2092 [label="Hm. Pienso que quizás describir a Lyon como un perro callejero no sea la comparación más halagadora...",shape=box,color=blue];
		2092 -> 2095;
	2093 [label="Una mañana fuimos a despertarlo y lo encontramos...",shape=box,color=blue];
		2093 -> 2096;
	2094 [label="Y me abandonaron para morir.",shape=box,color=blue];
		2094 -> 2097;
		2094 -> 2098;
	2095 [label="Tal vez no deberías decirle que lo hice, oui...?",shape=box,color=blue];
		2095 -> 2099;
	2096 [label="Je... Te ahorraré los detalles... Estoy segura de que puedes adivinarlo.",shape=box,color=blue];
		2096 -> 2100;
	2097 [label="¿Qué edad tenías?",shape=box,color=red];
		2097 -> 2101;
	2098 [label="¿Tu familia te dio por muerta?",shape=box,color=red];
		2098 -> 2102;
	2099 [label="Update boolean LyonStrayDog",color=orange];
		2099 -> 2103;
		2099 -> 2104;
	2100 [label="Pero nos dejó una nota. Era apenas legible. Era el único de los otros niños que sabía escribir y yo tuve que leérsela a los demás. ",shape=box,color=blue];
		2100 -> 2105;
	2101 [label="¿Seis? ¿Siete? Ellos sentían que habían hecho todo lo posible por curarme durante muchos años. Tutores para enseñarme a caminar. Aparatos ortopédicos. Calzado.",shape=box,color=blue];
		2101 -> 2106;
	2102 [label="Ellos sentían que habían hecho todo lo posible por curarme durante muchos años. Tutores para enseñarme a caminar. Aparatos ortopédicos. Calzado.",shape=box,color=blue];
		2102 -> 2106;
	2103 [label="Pienso que es adorable, y él también lo pensará.",shape=box,color=red];
		2103 -> 2107;
	2104 [label="Tu secreto está a salvo conmigo.",shape=box,color=red];
		2104 -> 2108;
	2105 [label="Aún recuerdo cómo se me quebró la voz. Pero tuve que ser fuerte. Porque incluso entonces, sabía que tenía un deber con los demás. ",shape=box,color=blue];
		2105 -> 2109;
	2106 [label="Estaban hartos de la carga. Así que, cuando apenas era capaz de leer y escribir números y letras, me encontré en la inmundicia.",shape=box,color=blue];
		2106 -> 2110;
		2106 -> 2111;
	2107 [label="Quelle horrible personne ! J'espère que votre chaise va s'effondrer et vous donner plein d'échardes douloureuses !",shape=box,color=blue];
		2107 -> 2112;
	2108 [label="Merci ! ¡Qué alivio!",shape=box,color=blue];
		2108 -> 2113;
	2109 [label="Hugo siempre nos había parecido tan feliz, me dijeron. Si joyeux. Siempre afrontando la vida con risa y de forma burlona.",shape=box,color=blue];
		2109 -> 2114;
	2110 [label="Eso es horrible.",shape=box,color=red];
		2110 -> 2115;
	2111 [label="¿Cómo sobreviviste?",shape=box,color=red];
		2111 -> 2115;
