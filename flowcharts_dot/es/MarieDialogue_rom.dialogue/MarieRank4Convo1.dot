	j630814749 [label="[Desactivar todas las conversaciones sobre autolesiones. No perderás puntos de química con ningún personaje.]",shape=box,color=red];
		j630814749 -> j1381028442;
	j3595191591 [label="Sinceramente no sé si preferiría que sus visiones fueran reales o falsas.",shape=box,color=red];
		j3595191591 -> j529997219;
	j6941518 [label="Cuando habla de todas las cosas terribles que ve. Las descripciones...",shape=box,color=red];
		j6941518 -> j529997219;
	j3247752286 [label="¿Que algún día podría dañarse a sí mismo sin que haya vuelta atrás?",shape=box,color=red];
		j3247752286 -> j13323814;
	j1639805636 [label="¿Te has sentido insegura en su presencia? ¿Sientes que podría hacerte daño sin darse cuenta?",shape=box,color=red];
		j1639805636 -> j3347571735;
	j1381028442 [label="Boolean LyonPainOff is now true.",color=orange];
		j1381028442 -> j307993975;
	j529997219 [label="+5 Chemistry",color=orange];
		j529997219 -> j2614836226;
	j13323814 [label="Ah... es un tema incómodo, oui ? Disculpa, pero no sé muy bien cómo hablar de ello sin enredarme.",shape=box,color=blue];
		j13323814 -> j1147725558;
	j3347571735 [label="Creo que Lyon se quitaría la vida antes de hacerme daño. Tengo fe en todos los dioses y demonios...",shape=box,color=blue];
		j3347571735 -> j1844579555;
	j307993975 [label="+20 Chemistry",color=orange];
		j307993975 -> j1229319393;
	j2614836226 [label="Las pesadillas que llenan su mente: Lua lo guía por un camino difícil, oui ?",shape=box,color=blue];
		j2614836226 -> j2407038165;
	j1147725558 [label="Pero haré lo mejor que pueda. Supongo que preguntas porque te preocupa, ¿no?",shape=box,color=blue];
		j1147725558 -> j410052141;
		j1147725558 -> j4045077654;
	j1844579555 [label="y sé que ni siquiera tu Indifférence podría hacerlo levantar su mano violentamente contra mí.",shape=box,color=blue];
		j1844579555 -> j2736875584;
	j1229319393 [label="[Esto evitará todas las conversaciones relacionadas con la autolesión.]",shape=box,color=blue];
		j1229319393 -> "Chat ends.";
	j2407038165 [label="Me temo que es difícil hablar de ello. Porque sé que es algo que no debería ser, oui ?",shape=box,color=blue];
		j2407038165 -> j3029497266;
	j410052141 [label="Se sabe que el warframe del que le dieron el suero... bueno, ya lo has visto.",shape=box,color=red];
		j410052141 -> j2130375794;
		j410052141 -> j248446757;
		j410052141 -> j1531636426;
	j4045077654 [label="Es bastante obvio de solo verlo... sin ofender. No fue difícil adivinarlo.",shape=box,color=red];
		j4045077654 -> j2130375794;
		j4045077654 -> j248446757;
		j4045077654 -> j1531636426;
	j2736875584 [label="Podría temer más que una mariposa me devorara por completo, antes que temer al hermano de mi alma.",shape=box,color=blue];
		j2736875584 -> j2407038165;
	j3029497266 [label="Debería querer detenerlo. Protegerlo de este deseo suyo de hacerse tanto daño.",shape=box,color=blue];
		j3029497266 -> j4018083130;
	j2130375794 [label="Sólo me preocupa que algún día pueda llegar demasiado lejos.",shape=box,color=red];
		j2130375794 -> j2407038165;
	j248446757 [label="Lo necesitamos en una sola pieza.",shape=box,color=red];
		j248446757 -> j7973071;
	j1531636426 [label="No quiero tener que preocuparme por limpiar su cadáver.",shape=box,color=red];
		j1531636426 -> j698283448;
	j4018083130 [label="Si hay algo que sé sobre Lyon es que siempre estará ahí cuando se le necesite.",shape=box,color=blue];
		j4018083130 -> j1579631951;
	j7973071 [label="Repites las palabras del diablo. ¿Es solo la necesidad insensible de contar con manos capaces lo que te inspira?",shape=box,color=blue];
		j7973071 -> j182022604;
		j7973071 -> j3141669665;
	j698283448 [label="Dégoûtant.",shape=box,color=blue];
		j698283448 -> j1508231473;
	j1579631951 [label="Él es el gran protector, le bouclier sacré de Lua.... La luz que brilla en la oscuridad de la noche.",shape=box,color=blue];
		j1579631951 -> j3030573971;
	j182022604 [label="No, él me importa mucho. Solo me preocupa que, cuando lo necesitemos, no esté.",shape=box,color=red];
		j182022604 -> j4018083130;
	j3141669665 [label="Solo necesito saber si puedo contar con él o no, o si ya está demasiado roto.",shape=box,color=red];
		j3141669665 -> j3116325573;
	j1508231473 [label="Boolean MarieNoDate is now true.",color=orange];
		j1508231473 -> "Chat ends.";
	j3030573971 [label="El dolor que se inflige... lo hace para escuchar sus propios pensamientos. Para sentir su propio cuerpo. ",shape=box,color=blue];
		j3030573971 -> j1860527152;
	j3116325573 [label="Me pregunto quién te ayudará cuando caigas en la desesperación y necesites una mano.",shape=box,color=blue];
		j3116325573 -> j4026676545;
	j1860527152 [label="Porque el cielo está lleno de estrellas, y cada una de ellas le susurra, y él, como la propia Lua, se perdería entre ellas.",shape=box,color=blue];
		j1860527152 -> j1443459546;
	j4026676545 [label="¿O acaso crees que el tiempo ya pasó y que ahora estás por encima de tal reproche?",shape=box,color=blue];
		j4026676545 -> j698283448;
	j1443459546 [label="Y como Lua, pasa por sus fases. Es consumido por el Vacío solo para brillar con tanta intensidad para que todos podamos caminar en la oscuridad sin miedo.",shape=box,color=blue];
		j1443459546 -> j2952838261;
	j2952838261 [label="Pero como toda bendición, conlleva una maldición. ¿Tiene sentido lo que digo? Me temo que solo estoy divagando.",shape=box,color=blue];
		j2952838261 -> j2964692373;
		j2952838261 -> j2500657840;
		j2952838261 -> j4271451766;
		j2952838261 -> j1839744868;
		j2952838261 -> j2488164701;
	j2964692373 [label="Lo entiendo perfectamente. Y tengo... una pequeña confesión que hacer. [Confiesa tus sentimientos por Lyon.]",shape=box,color=red];
		j2964692373 -> j2663363544;
	j2500657840 [label="Entiendo lo que dices, pero no puedo tolerar que se haga daño. Debería parar.",shape=box,color=red];
		j2500657840 -> j3506432440;
	j4271451766 [label="[Advertencia: Discusión sobre suicidio.] Una vez perdí a alguien por ese tipo de autolesión. No puedo... no puedo tolerarlo.",shape=box,color=red];
		j4271451766 -> j1429002984;
	j1839744868 [label="Tiene que haber otra manera.",shape=box,color=red];
		j1839744868 -> j1720667743;
	j2488164701 [label="Tienes toda la razón. Sólo... desearía poder ayudarlo.",shape=box,color=red];
		j2488164701 -> j1720667743;
	j2663363544 [label="Boolean DrifterLyon is now true.",color=orange];
		j2663363544 -> j2831114762;
	j3506432440 [label="Boolean DrifterHarmStop is now true.",color=orange];
		j3506432440 -> j2948464140;
	j1429002984 [label="Boolean DrifterHarmLoss is now true.",color=orange];
		j1429002984 -> j481364936;
	j1720667743 [label="Boolean DrifterHarmHelp is now true.",color=orange];
		j1720667743 -> j3821311942;
	j2831114762 [label="Me temo que él se ha apoderado de mi corazón, y se rompe al saber que está sufriendo.",shape=box,color=red];
		j2831114762 -> j3227021882;
	j2948464140 [label="El dolor que siente es más profundo que el que se inflige en el cuerpo. Ya no puede evitar lo que se hace a sí mismo.",shape=box,color=blue];
		j2948464140 -> j787841952;
	j481364936 [label="¡Ay! No lo sabía, lo siento muchísimo... Estoy segura de que las patéticas frases y oraciones que pudiera ofrecerte se sentirían vacías",shape=box,color=blue];
		j481364936 -> j1661721282;
	j3821311942 [label="+20 Chemistry",color=orange];
		j3821311942 -> j1595708540;
	j3227021882 [label="+20 Chemistry",color=orange];
		j3227021882 -> j4112192232;
	j787841952 [label="Le aclara la mente, le tranquiliza el alma. Y ahora, como protoframe — parte... Harrow, así como yo soy parte Wisp—, esto no lo matará, oui ? ",shape=box,color=blue];
		j787841952 -> j731362414;
		j787841952 -> j3958728336;
	j1661721282 [label="¿qué condolencias podría darte alguien a quien apenas conoces, que pudieran servir para aliviar una tragedia así?",shape=box,color=blue];
		j1661721282 -> j3279379409;
	j1595708540 [label="Y por eso no puedo adorarte más. Pero la ayuda puede ser muchas cosas, non ?",shape=box,color=blue];
		j1595708540 -> j626398450;
	j4112192232 [label="¡Ay! ¡Acabo de gritar como si hubiera visto un ratón y asusté a Monsieur Loid! Pardon !!",shape=box,color=blue];
		j4112192232 -> j1747201732;
	j731362414 [label="No, no lo matará. Pero aún así no está bien.",shape=box,color=red];
		j731362414 -> j1453627813;
	j3958728336 [label="Supongo que entiendo tu punto.",shape=box,color=red];
		j3958728336 -> j3769303949;
	j3279379409 [label="Esa alma que perdiste y de la que hablas... ¿era cercana a ti?",shape=box,color=blue];
		j3279379409 -> j2431488;
		j3279379409 -> j2178957263;
	j626398450 [label="Ayudar a un pajarito puede significar matarlo. Ayudar a la llama de una vela a arder puede acabar por apagarla.",shape=box,color=blue];
		j626398450 -> j2759940836;
	j1747201732 [label="¡Ah, pero esta es una noticia tan maravillosa!",shape=box,color=blue];
		j1747201732 -> j3114165825;
		j1747201732 -> j2570273251;
	j1453627813 [label="He descubierto que estar a su lado cuando me necesita... escucharlo, abrazarlo cuando llora...",shape=box,color=blue];
		j1453627813 -> j3921869147;
	j3769303949 [label="+10 Chemistry",color=orange];
		j3769303949 -> j2759940836;
	j2431488 [label="Sí.",shape=box,color=red];
		j2431488 -> j1977226571;
	j2178957263 [label="No mucho.",shape=box,color=red];
		j2178957263 -> j2224200300;
	j2759940836 [label="He descubierto que estar a su lado cuando me necesita... escucharlo, simplemente sentarme a su lado cuando llora...",shape=box,color=blue];
		j2759940836 -> j4011997120;
	j3114165825 [label="¿En serio? No sabía cómo te sentirías al respecto.",shape=box,color=red];
		j3114165825 -> j2915376725;
	j2570273251 [label="Sólo desearía saber si él soporta mi presencia o no...",shape=box,color=red];
		j2570273251 -> j3392815321;
	j3921869147 [label="Le ayuda más que hablar de lo que debe y no debe hacer.",shape=box,color=blue];
		j3921869147 -> j212880701;
	j1977226571 [label="¿Es por eso que intentas asegurarte de que Lyon no corra la misma suerte? ¿O es simplemente el tema en sí lo que te afecta?",shape=box,color=blue];
		j1977226571 -> j1066728565;
		j1977226571 -> j4100378543;
	j2224200300 [label="Aún así, tener a alguien cercano a ti que se siente tan atrapado dentro de su contexto como para que sólo haya una forma de escapar... ",shape=box,color=blue];
		j2224200300 -> j1977226571;
	j4011997120 [label="Le ayuda más que hablar de lo que debe y no debe hacer.",shape=box,color=blue];
		j4011997120 -> j4041515313;
		j4011997120 -> j455775836;
		j4011997120 -> j1185006434;
	j2915376725 [label="¡Ay, estoy muy feliz! Tellement ravie ! Lyon necesita tanto amor, ¡ni te imaginas!",shape=box,color=blue];
		j2915376725 -> j1699574357;
	j3392815321 [label="Ah, es como hablar con una statue de marbre, non ? Sé cómo te sientes. Muchas veces le he estado hablado por veinte minutos absorta en una historia sólo para darme cuenta de que no me escuchaba.",shape=box,color=blue];
		j3392815321 -> j2974521327;
	j212880701 [label="Debes aprender a leer entre líneas, non ? Él habla con historias. Con parábolas. Si guarda silencio, escucha sus acciones.",shape=box,color=blue];
		j212880701 -> j1177124300;
	j1066728565 [label="Necesito... evitar el tema, por favor. No puedo. ",shape=box,color=red];
		j1066728565 -> j2373693271;
	j4100378543 [label="Necesito asegurarme de que el Lyon no sufre...",shape=box,color=red];
		j4100378543 -> j556124064;
	j4041515313 [label="Haré lo que pueda por seguir tu consejo. Simplemente no sé cómo acercarme a él.",shape=box,color=red];
		j4041515313 -> j3201829694;
	j455775836 [label="Haré lo que pueda, sólo... desearía poder hacer más.",shape=box,color=red];
		j455775836 -> j1158857845;
	j1185006434 [label="Él puede ser... frustrante.",shape=box,color=red];
		j1185006434 -> j3201829694;
	j1699574357 [label="Ah, quizá sí. Como puedes ver, sufre mucho, a pesar de las apariencias...",shape=box,color=blue];
		j1699574357 -> j946848881;
	j2974521327 [label="Perdido nuevamente en los pasillos de su mente o prestando atención a algún otro esprit en la habitación.",shape=box,color=blue];
		j2974521327 -> j128905694;
	j1177124300 [label="Sé paciente con él, sé amable, et je vous en supplie, no lo lastimes, oui ?",shape=box,color=blue];
		j1177124300 -> j2977601452;
		j1177124300 -> j1159107712;
