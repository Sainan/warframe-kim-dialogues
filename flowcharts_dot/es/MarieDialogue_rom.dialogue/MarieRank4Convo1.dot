	2027 [label="¡Ay, estoy muy feliz! Tellement ravie ! Lyon necesita tanto amor, ¡ni te imaginas!",shape=box,color=blue];
		2027 -> 2035;
	2028 [label="Ah, es como hablar con una statue de marbre, non ? Sé cómo te sientes. Muchas veces le he estado hablado por veinte minutos absorta en una historia sólo para darme cuenta de que no me escuchaba.",shape=box,color=blue];
		2028 -> 2036;
	2029 [label="Debes aprender a leer entre líneas, non ? Él habla con historias. Con parábolas. Si guarda silencio, escucha sus acciones.",shape=box,color=blue];
