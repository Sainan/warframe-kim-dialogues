		2053 -> 2063;
	2054 [label="Creo que me gustaría escucharlo.",shape=box,color=red];
		2054 -> 2064;
	2055 [label="Debes aprender a leer entre líneas, non ? Él habla con historias. Con parábolas. Si guarda silencio, escucha sus acciones.",shape=box,color=blue];
		2055 -> 2056;
	2056 [label="Pero te importa, quieres ayudarlo, y estoy segura de que él lo sabe. ¡Ah! Ya sé. Es como un perro callejero, con una cicatriz en la pata. Está curada, mal curada. Así que todavía le duele y le pica.",shape=box,color=blue];
		2056 -> 2065;
	2057 [label="Espera, ¡no era mi intención que te entrometieras!",shape=box,color=red];
		2057 -> 2066;
	2058 [label="¿Debería preocuparme?",shape=box,color=red];
		2058 -> 2066;
	2059 [label="Me vendría bien la ayuda.",shape=box,color=red];
		2059 -> 2067;
	2060 [label="Es como un perro callejero, con una cicatriz en la pierna. Está curada, mal curada. Así que todavía le duele y le pica.",shape=box,color=blue];
		2060 -> 2065;
	2061 [label="Merci. Eso es todo lo que puedo pedir. À bientôt.",shape=box,color=blue];
