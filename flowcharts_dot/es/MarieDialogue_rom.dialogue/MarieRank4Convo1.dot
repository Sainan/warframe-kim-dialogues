	1989 [label="Porque el cielo está lleno de estrellas, y cada una de ellas le susurra, y él, como la propia Lua, se perdería entre ellas.",shape=box,color=blue];
		1989 -> 1990;
	2426 [label="¿O acaso crees que el tiempo ya pasó y que ahora estás por encima de tal reproche?",shape=box,color=blue];
