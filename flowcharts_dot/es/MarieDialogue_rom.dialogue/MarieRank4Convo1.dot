		j128905694 -> j946848881;
	j2977601452 [label="Aún así no creo que esté bien.",shape=box,color=red];
		j2977601452 -> j2038309259;
	j1159107712 [label="Haré lo que pueda.",shape=box,color=red];
		j1159107712 -> j809457417;
	j316733138 [label="Claro... ¿Puedo contarte la historia de alguien que conocí y que hizo lo mismo? ¿O preferirías que cada uno siguiera su camino?",shape=box,color=blue];
		j316733138 -> j3174315789;
		j316733138 -> j413379712;
		j316733138 -> j2207753939;
	j450314656 [label="Perdido nuevamente en los pasillos de su mente o prestando atención a algún otro esprit en la habitación.",shape=box,color=blue];
		j450314656 -> j2478938019;
	j4079073821 [label="Hacer más podría aplastarlos o alejarlos.",shape=box,color=blue];
		j4079073821 -> j4045280306;
	j464042380 [label="Eso es todo lo que pido. ¡Ay, qué alegría! ¡Tengo que esforzarme para que esta unión se haga realidad!",shape=box,color=blue];
		j464042380 -> j1766610498;
		j464042380 -> j677021783;
		j464042380 -> j165353161;
	j2038309259 [label="Entonces háblale de tu preocupación. Él te escuchará. No es un niño. ",shape=box,color=blue];
		j2038309259 -> j399449816;
	j809457417 [label="+20 Chemistry",color=orange];
		j809457417 -> j1678989750;
	j3174315789 [label="Dejemos esto aquí. ",shape=box,color=red];
		j3174315789 -> j604214681;
	j413379712 [label="¿Podemos volver a hablar de Lyon?",shape=box,color=red];
		j413379712 -> j254943105;
	j2207753939 [label="Creo que me gustaría escucharlo.",shape=box,color=red];
		j2207753939 -> j2767069790;
	j2478938019 [label="Debes aprender a leer entre líneas, non ? Él habla con historias. Con parábolas. Si guarda silencio, escucha sus acciones.",shape=box,color=blue];
		j2478938019 -> j4045280306;
	j4045280306 [label="Pero te importa, quieres ayudarlo, y estoy segura de que él lo sabe. ¡Ah! Ya sé. Es como un perro callejero, con una cicatriz en la pata. Está curada, mal curada. Así que todavía le duele y le pica.",shape=box,color=blue];
		j4045280306 -> j1538816476;
	j1766610498 [label="Espera, ¡no era mi intención que te entrometieras!",shape=box,color=red];
		j1766610498 -> j4127695731;
	j677021783 [label="¿Debería preocuparme?",shape=box,color=red];
		j677021783 -> j4127695731;
	j165353161 [label="Me vendría bien la ayuda.",shape=box,color=red];
		j165353161 -> j862070229;
	j399449816 [label="Es como un perro callejero, con una cicatriz en la pierna. Está curada, mal curada. Así que todavía le duele y le pica.",shape=box,color=blue];
		j399449816 -> j1538816476;
	j1678989750 [label="Merci. Eso es todo lo que puedo pedir. À bientôt.",shape=box,color=blue];
		j1678989750 -> "Chat ends.";
	j604214681 [label="+20 Chemistry",color=orange];
		j604214681 -> j3509258703;
	j254943105 [label="+20 Chemistry",color=orange];
		j254943105 -> j721412917;
