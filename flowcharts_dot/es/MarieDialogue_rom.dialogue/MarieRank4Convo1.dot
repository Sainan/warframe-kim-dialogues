		2115 -> 2117 [label=true,color=green];
		2115 -> 2118 [label=false,color=brown];
	2116 [label="Pero nunca sabemos la profundidad del dolor que otros sienten en sus corazones. Y en esa carta, supe que él lloró con Lua.",shape=box,color=blue];
		2116 -> 2119;
	2117 [label="Fue como dijiste, non? Todos los inconvenientes traen consigo un poder secreto.",shape=box,color=blue];
		2117 -> 2118;
	2118 [label="Lo que me hizo indeseable pour ma mère, me hizo bastante popular entre los demás niños de la calle.",shape=box,color=blue];
		2118 -> 2120;
	2119 [label="Pero que ahora estaba en paz a su lado. Por un tiempo, le guardé rencor por irse. Porque los demás recurrían a mí en busca de orientación. Y le guardé rencor por abandonarme.",shape=box,color=blue];
		2119 -> 2121;
	2120 [label="¿Qué es más pathétique que un niño sin pieds, oui ? Podría ganar más en un día mendigando de lo que ellos podrían robar en una semana.",shape=box,color=blue];
		2120 -> 2122;
	2121 [label="Pero con el tiempo, llegué a comprender la verdad.",shape=box,color=blue];
		2121 -> 2123;
	2122 [label="Y siempre estaba dispuesta a compartir. Así que tuve muchos amigos que me cuidaban. Uno de ellos era un niño grande llamado Hugo.",shape=box,color=blue];
		2122 -> 2085;
	2123 [label="Solo podemos perdonarnos por ser humanos. Y perdonarnos el dolor de su partida.",shape=box,color=blue];
		2123 -> 2124;
	2124 [label="Porque es su ausencia lo que nos duele. Y pensar que no pudimos hacer más para ayudarlos.",shape=box,color=blue];
		2124 -> 2125;
	2125 [label="Nunca podemos saber lo que cargan los demás.",shape=box,color=blue];
		2125 -> 2126;
	2126 [label="Y esa es una gran tragédie. Pero es lo que significa ser humano.",shape=box,color=blue];
		2126 -> 2127;
	2127 [label="No sé si esta historia te ayudó. Pero solo puedo rezar para que así sea. Debo irme, Monsieur Loid me llama.",shape=box,color=blue];
		2127 -> 2128;
		2127 -> 2129;
	2128 [label="Gracias, Marie.",shape=box,color=red];
		2128 -> 2130;
	2129 [label="[Permanecer en silencio.]",shape=box,color=red];
		2129 -> 2131;
	2130 [label="+20 Chemistry",color=orange];
		2130 -> 2132;
	2131 [label="+20 Chemistry",color=orange];
		2131 -> 2133;
	2132 [label="De nada. À bientôt.",shape=box,color=blue];
		2132 -> 2134;
	2133 [label="À la revoyure.",shape=box,color=blue];
		2133 -> 2135;
	2134 [label="Chat ends.",color=orange];
	2135 [label="Chat ends.",color=orange];
}