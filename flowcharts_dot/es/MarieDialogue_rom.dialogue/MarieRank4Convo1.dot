		j2767069790 -> j3808812285 [label=true,color=green];
		j2767069790 -> j709490473 [label=false,color=brown];
	j1538816476 [label="Se muerde la pierna y, aunque eso abre la herida y le produce dolor, también le produce alivio.",shape=box,color=blue];
		j1538816476 -> j2930912967;
	j4127695731 [label="¡Ja! Ya es demasiado tarde para eso. Marie, au travail ! Il y a de l'amour dans l'air !",shape=box,color=blue];
		j4127695731 -> "Chat ends.";
	j862070229 [label="Oui ! Y no podrías detenerme, aunque quisieras. ¡Marie, a trabajar!",shape=box,color=blue];
		j862070229 -> "Chat ends.";
	j3509258703 [label="Oui, por supuesto. À bientôt.",shape=box,color=blue];
		j3509258703 -> "Chat ends.";
	j721412917 [label="Oui, por supuesto.",shape=box,color=blue];
		j721412917 -> j399449816;
	j3808812285 [label="Ya sabes cómo empieza mi historia, pero hay una parte que no te conté.",shape=box,color=blue];
		j3808812285 -> j1850519213;
	j709490473 [label="Boolean MarieBackstory1 is now true.",color=orange];
		j709490473 -> j556299622;
	j2930912967 [label="Le hace daño, pero es parte de él, de todos modos. Y si te acercas a él avec colère, de forma brusca, se espantará al tocarlo.",shape=box,color=blue];
		j2930912967 -> j1360940622;
	j1850519213 [label="Te conté que mendigaba en la calle cuando era una jeune fille. Y que me iba bien y tenía muchos amigos.",shape=box,color=blue];
		j1850519213 -> j3015230212;
	j556299622 [label="Nací en una familia rica, lo que puede sorprenderte. La clase burguesa es bastante cercana a los orokin.",shape=box,color=blue];
		j556299622 -> j3032011544;
	j1360940622 [label="Debes ganarte la confianza del perro callejero. Dejar que venga a ti, non ? ¿Eso tiene sentido?",shape=box,color=blue];
		j1360940622 -> j1536245628;
		j1360940622 -> j3740723194;
		j1360940622 -> j3006092262;
	j3015230212 [label="Uno de ellos era un niño mayor llamado Hugo.",shape=box,color=blue];
		j3015230212 -> j1127675244;
	j3032011544 [label="Pero cuando nací así como yo era... deforme, con mes pieds tordus et inutilisables ? Oh, ma mère no podía permitirlo.",shape=box,color=blue];
		j3032011544 -> j4152996642;
	j1536245628 [label="Sí, de hecho. Gracias.",shape=box,color=red];
		j1536245628 -> j2002171588;
	j3740723194 [label="Más de lo que debería, gracias.",shape=box,color=red];
		j3740723194 -> j2350362861;
	j3006092262 [label="Para nada. Pero gracias por intentarlo.",shape=box,color=red];
		j3006092262 -> j3345617823;
	j1127675244 [label="Era un poco el líder de la manada. Y siempre se aseguraba de que nadie se metiera conmigo y de que tuviera todo lo que necesitaba.",shape=box,color=blue];
		j1127675244 -> j1084295922;
	j4152996642 [label="Había apariencias que mantener, oui ? Estándares que mantener.",shape=box,color=blue];
		j4152996642 -> j2769227565;
	j2002171588 [label="Bien ! Tenía miedo de volver a dejar que mis metáforas se salieran de control.",shape=box,color=blue];
		j2002171588 -> j94630493;
	j2350362861 [label="Marie y sus metáforas. Ah, bon.",shape=box,color=blue];
		j2350362861 -> j94630493;
	j3345617823 [label="Mince alors. Creo que exageré con mis métaphores.",shape=box,color=blue];
		j3345617823 -> j94630493;
	j1084295922 [label="Incluso me ayudó a construir des béquilles (podrías llamarlas... ¿eh?... ¿muletas?) con trozos de madera que encontrábamos. Con ellas podía arrastrarme.",shape=box,color=blue];
		j1084295922 -> j3059204435;
	j2769227565 [label="Así que, ¿Qué se tenía que hacer con la pobre mal formada de Marie? Me llevaron a la Cité de la Lumière, donde me dejaron en la calle...",shape=box,color=blue];
		j2769227565 -> j1063536678;
	j94630493 [label="Hm. Pienso que quizás describir a Lyon como un perro callejero no sea la comparación más halagadora...",shape=box,color=blue];
		j94630493 -> j2669767175;
	j3059204435 [label="Una mañana fuimos a despertarlo y lo encontramos...",shape=box,color=blue];
		j3059204435 -> j1582456909;
	j1063536678 [label="Y me abandonaron para morir.",shape=box,color=blue];
		j1063536678 -> j89405063;
		j1063536678 -> j78068138;
	j2669767175 [label="Tal vez no deberías decirle que lo hice, oui...?",shape=box,color=blue];
		j2669767175 -> j1672678032;
	j1582456909 [label="Je... Te ahorraré los detalles... Estoy segura de que puedes adivinarlo.",shape=box,color=blue];
		j1582456909 -> j3007937271;
	j89405063 [label="¿Qué edad tenías?",shape=box,color=red];
		j89405063 -> j2570006180;
	j78068138 [label="¿Tu familia te dio por muerta?",shape=box,color=red];
		j78068138 -> j3924038702;
	j1672678032 [label="Boolean LyonStrayDog is now true.",color=orange];
		j1672678032 -> j2425401193;
		j1672678032 -> j1209798349;
	j3007937271 [label="Pero nos dejó una nota. Era apenas legible. Era el único de los otros niños que sabía escribir y yo tuve que leérsela a los demás. ",shape=box,color=blue];
		j3007937271 -> j1832286638;
	j2570006180 [label="¿Seis? ¿Siete? Ellos sentían que habían hecho todo lo posible por curarme durante muchos años. Tutores para enseñarme a caminar. Aparatos ortopédicos. Calzado.",shape=box,color=blue];
		j2570006180 -> j3982727217;
	j3924038702 [label="Ellos sentían que habían hecho todo lo posible por curarme durante muchos años. Tutores para enseñarme a caminar. Aparatos ortopédicos. Calzado.",shape=box,color=blue];
		j3924038702 -> j3982727217;
	j2425401193 [label="Pienso que es adorable, y él también lo pensará.",shape=box,color=red];
		j2425401193 -> j758510050;
	j1209798349 [label="Tu secreto está a salvo conmigo.",shape=box,color=red];
		j1209798349 -> j171931163;
	j1832286638 [label="Aún recuerdo cómo se me quebró la voz. Pero tuve que ser fuerte. Porque incluso entonces, sabía que tenía un deber con los demás. ",shape=box,color=blue];
		j1832286638 -> j3372241138;
	j3982727217 [label="Estaban hartos de la carga. Así que, cuando apenas era capaz de leer y escribir números y letras, me encontré en la inmundicia.",shape=box,color=blue];
		j3982727217 -> j2339545814;
		j3982727217 -> j4094359445;
	j758510050 [label="Quelle horrible personne ! J'espère que votre chaise va s'effondrer et vous donner plein d'échardes douloureuses !",shape=box,color=blue];
		j758510050 -> "Chat ends.";
	j171931163 [label="Merci ! ¡Qué alivio!",shape=box,color=blue];
		j171931163 -> "Chat ends.";
	j3372241138 [label="Hugo siempre nos había parecido tan feliz, me dijeron. Si joyeux. Siempre afrontando la vida con risa y de forma burlona.",shape=box,color=blue];
		j3372241138 -> j1239573371;
	j2339545814 [label="Eso es horrible.",shape=box,color=red];
		j2339545814 -> j714426695;
	j4094359445 [label="¿Cómo sobreviviste?",shape=box,color=red];
		j4094359445 -> j714426695;
	j1239573371 [label="Incluso cuando nos corrían o lo golpeaban con un palo por robar o merodear, no parecía molestarle.",shape=box,color=blue];
		j1239573371 -> j4278867873;
	j714426695 [label="Check boolean MarieSecretPower",color=orange];
		j714426695 -> j1548658930 [label=true,color=green];
		j714426695 -> j2330896802 [label=false,color=brown];
	j4278867873 [label="Pero nunca sabemos la profundidad del dolor que otros sienten en sus corazones. Y en esa carta, supe que él lloró con Lua.",shape=box,color=blue];
		j4278867873 -> j1312269539;
	j1548658930 [label="Fue como dijiste, non? Todos los inconvenientes traen consigo un poder secreto.",shape=box,color=blue];
		j1548658930 -> j2330896802;
	j2330896802 [label="Lo que me hizo indeseable pour ma mère, me hizo bastante popular entre los demás niños de la calle.",shape=box,color=blue];
		j2330896802 -> j711227409;
	j1312269539 [label="Pero que ahora estaba en paz a su lado. Por un tiempo, le guardé rencor por irse. Porque los demás recurrían a mí en busca de orientación. Y le guardé rencor por abandonarme.",shape=box,color=blue];
		j1312269539 -> j943049265;
	j711227409 [label="¿Qué es más pathétique que un niño sin pieds, oui ? Podría ganar más en un día mendigando de lo que ellos podrían robar en una semana.",shape=box,color=blue];
		j711227409 -> j1742761483;
	j943049265 [label="Pero con el tiempo, llegué a comprender la verdad.",shape=box,color=blue];
		j943049265 -> j4133403546;
	j1742761483 [label="Y siempre estaba dispuesta a compartir. Así que tuve muchos amigos que me cuidaban. Uno de ellos era un niño grande llamado Hugo.",shape=box,color=blue];
		j1742761483 -> j1127675244;
	j4133403546 [label="Solo podemos perdonarnos por ser humanos. Y perdonarnos el dolor de su partida.",shape=box,color=blue];
		j4133403546 -> j1334415218;
	j1334415218 [label="Porque es su ausencia lo que nos duele. Y pensar que no pudimos hacer más para ayudarlos.",shape=box,color=blue];
		j1334415218 -> j4226534471;
	j4226534471 [label="Nunca podemos saber lo que cargan los demás.",shape=box,color=blue];
		j4226534471 -> j1323710253;
	j1323710253 [label="Y esa es una gran tragédie. Pero es lo que significa ser humano.",shape=box,color=blue];
		j1323710253 -> j3223800774;
	j3223800774 [label="No sé si esta historia te ayudó. Pero solo puedo rezar para que así sea. Debo irme, Monsieur Loid me llama.",shape=box,color=blue];
		j3223800774 -> j543864661;
		j3223800774 -> j1371953553;
	j543864661 [label="Gracias, Marie.",shape=box,color=red];
		j543864661 -> j2518160111;
	j1371953553 [label="[Permanecer en silencio.]",shape=box,color=red];
		j1371953553 -> j3386425480;
	j2518160111 [label="+20 Chemistry",color=orange];
		j2518160111 -> j15297147;
	j3386425480 [label="+20 Chemistry",color=orange];
		j3386425480 -> j1123121321;
	j15297147 [label="De nada. À bientôt.",shape=box,color=blue];
		j15297147 -> "Chat ends.";
	j1123121321 [label="À la revoyure.",shape=box,color=blue];
		j1123121321 -> "Chat ends.";
}