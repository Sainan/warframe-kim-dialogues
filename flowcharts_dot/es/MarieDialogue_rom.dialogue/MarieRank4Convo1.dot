	j3201829694 [label="Ah, es como hablar con una statue de marbre, non ? Sé cómo te sientes. Muchas veces le he estado hablado por veinte minutos absorta en una historia solo para darme cuenta de que no me escuchaba.",shape=box,color=blue];
		j3201829694 -> j450314656;
	j1158857845 [label="Sí, lo entiendo. Pero a veces no podemos hacer mucho más que estar ahí para los demás cuando y como ellos lo deseen.",shape=box,color=blue];
		j1158857845 -> j4079073821;
	j946848881 [label="Sé paciente con él, sé amable, et je vous en supplie, no lo lastimes, oui ?",shape=box,color=blue];
		j946848881 -> j464042380;
