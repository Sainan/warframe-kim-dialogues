		636 -> 645;
	637 [label="Add 1 to Thermostat",color=orange];
		637 -> 646;
	635 [label="No puedo imaginar que para la mayoría de la gente que no se rodea de cabezas voladoras y animales parlantes, un elefante no sea motivo de conversación.",shape=box,color=blue];
		635 -> 644;
	651 [label="+5 Chemistry",color=orange];
		651 -> 660;
	652 [label="¿Y asumes que no lo comprendería? No soy tonta; no me he vuelto histérica, a pesar de haber sido transportada y transfigurada.",shape=box,color=blue];
		652 -> 661;
		652 -> 662;
	649 [label="Comprenderlo hasta qué punto, esa es mi preocupación. Pero no necesitas que te dé sermones, no soy tu madre, ni deseo arruinar nuestra amistad en sus inicios...",shape=box,color=blue];
		649 -> 658;
	650 [label="+5 Chemistry",color=orange];
		650 -> 659;
	647 [label="+5 Chemistry",color=orange];
		647 -> 656;
	648 [label="Simplemente te recomiendo tener precaución. Creo que él podría encantar a Lua para que le dé las estrellas del cielo.",shape=box,color=blue];
		648 -> 657;
	645 [label="Comprenderlo hasta qué punto, esa es mi preocupación. Pero no necesitas que te dé sermones.",shape=box,color=blue];
		645 -> 654;
	646 [label="+5 Chemistry",color=orange];
		646 -> 655;
	644 [label="... Sospecho que contesté a mi propia pregunta, ¿no es así?",shape=box,color=blue];
		644 -> 653;
	660 [label="Agradezco la disculpa y la acepto, pero considera que he sido transportada y transfigurada y me encuentro rodeado de l'impossible. ",shape=box,color=blue];
		660 -> 666;
	661 [label="No importa. Iré a hablar con el diablo.",shape=box,color=red];
		661 -> 667;
	662 [label="Lo siento. No pretendía discutir contigo, eso no es lo que quería decir. ",shape=box,color=red];
		662 -> 668;
		662 -> 669;
	658 [label="Simplemente me preocupas. Él es un animal hábil y manipulador... ",shape=box,color=blue];
		658 -> 664;
	659 [label="Y yo te declararía un Santo de Sol por siquiera intentar hacer tal cosa.",shape=box,color=blue];
		659 -> 664;
	656 [label="Oui, la maldición del soldado... Quemar la ciudad para salvar el país. Matar al hombre para salvar a la familia. Pero ¿dónde termina el horror?",shape=box,color=blue];
		656 -> 665;
	657 [label="Recuerda quién y qué es él, al final del día... no un dios, ni siquiera una bestia, sino un hombre. Un hombre que se sobrevalora demasiado.",shape=box,color=blue];
		657 -> 664;
	654 [label="Creo que él podría encantar a Lua para que le diera las estrellas del cielo. Ten cuidado, es todo lo que diré.",shape=box,color=blue];
		654 -> 664;
	655 [label="Entonces eres inteligente al no escuchar sus palabras melosas. Creo que podría hechizar a Lua para que le diera las estrellas del cielo.",shape=box,color=blue];
		655 -> 664;
	653 [label="Así es. Significa \"¿podemos hablar del tema que todos evitamos, como si no estuviéramos hablando del gran elefante en la habitación?\".",shape=box,color=red];
		653 -> 663;
	666 [label="Cuando creas que no puedo comprender o que no puedo sentir simpatía por las historias de otros, por favor reconsidera, oui ?",shape=box,color=blue];
		666 -> 673;
	667 [label="Qu'il en soit ainsi.",shape=box,color=blue];
		667 -> 674;
	668 [label="Es un soldado. Ha tenido que hacer cosas terribles por un \"propósito mayor\". Sé cómo se siente. A veces, ese tipo de vida te transforma... Como a él.",shape=box,color=red];
		668 -> 675;
	669 [label="Ha vivido cientos, si no miles, de años. ¿Quién sabe lo que eso realmente le provoca a una persona? ¿Cuánto dolor, cuánto sufrimiento? Sé cómo se siente.",shape=box,color=red];
		669 -> 676;
	664 [label="Pero querías preguntarme sobre el mismísimo diablo, ¿no? ¿Qué te gustaría saber?",shape=box,color=blue];
		664 -> 670;
		664 -> 671;
		664 -> 672;
	665 [label="Debemos ver la guerra a través de los ojos del estadista, porque si la viéramos a través de los ojos de los caídos, nunca dejaríamos de llorar.",shape=box,color=blue];
		665 -> 664;
	663 [label="Y si se me permites adivinar por segunda vez la naturaleza de este elefante... ¿sería uno de piel azul?",shape=box,color=blue];
		663 -> 618;
	673 [label="Y yo, por mi parte, reconsideraré decirte lo que debes hacer.",shape=box,color=blue];
		673 -> 661;
		673 -> 680;
	674 [label="Chat ends.",color=orange];
	675 [label="+5 Chemistry",color=orange];
		675 -> 681;
	676 [label="+5 Chemistry",color=orange];
		676 -> 682;
	670 [label="¿Por qué te desagrada tanto?",shape=box,color=red];
		670 -> 677;
	671 [label="¿Por qué Entrati lo dejó contigo y Lyon?",shape=box,color=red];
		671 -> 678;
	672 [label="¿Cómo se conocieron?",shape=box,color=red];
		672 -> 679;
	680 [label="De acuerdo.",shape=box,color=red];
		680 -> 687;
	681 [label="Ah, y ahora sí que me siento tonta. Sí, claro, tu sabes lo que es matar en nombre de un \"propósito\", como dijiste... Claro que buscarías comprender a alguien que ha hecho lo mismo.",shape=box,color=blue];
		681 -> 688;
	682 [label="Ah, y ahora sí que me siento tonta. Sí, claro, tú sabes lo que es vivir una y otra vez... Claro que buscarías conocer a alguien que haya hecho lo mismo.",shape=box,color=blue];
		682 -> 688;
	677 [label="¿No es obvio? Su comportamiento es como el de un gran felino que insiste en marcar su territorio y tirar cosas de los estantes.",shape=box,color=blue];
		677 -> 683;
		677 -> 684;
	678 [label="Cuando el Cardinal Dimanche - Entrati - partió por última vez, dejó al diablo en nuestra puerta. Destrozado, sangrando y apenas capaz de recordar su propio nombre.",shape=box,color=blue];
		678 -> 685;
	679 [label="Había una tormenta la noche en que el diablo vino a nosotros. Un trueno terrible sacudió los muros de la Cathédrale.",shape=box,color=blue];
		679 -> 686;
	687 [label="Update boolean MarieRoatheWarning",color=orange];
		687 -> 694;
	688 [label="Hagamos un trato. Cuando creas que no puedo comprender o que no puedo sentir simpatía por las historias de otros, por favor reconsidera, oui ?",shape=box,color=blue];
		688 -> 673;
	683 [label="A mí me gustan bastante los gatos. ",shape=box,color=red];
		683 -> 689;
	684 [label="¿No te gustan los gatos?",shape=box,color=red];
		684 -> 690;
	685 [label="Ahora sé que recién le habían administrado el suero, y la transformación, si no es voluntaria, es... dolorosa.",shape=box,color=blue];
		685 -> 691;
	686 [label="Check boolean MarieLyonVisions",color=orange];
		686 -> 693 [label=true,color=green];
		686 -> 692 [label=false,color=brown];
	694 [label="Magnifique ! Querías preguntarme sobre el mismísimo diablo, ¿no? ¿Qué te gustaría saber?",shape=box,color=blue];
		694 -> 670;
		694 -> 671;
		694 -> 672;
	689 [label="¡Los gatos son maravillosos cuando son realmente gatos! ¡Él es un hombre adulto con muchos años de vida!",shape=box,color=blue];
		689 -> 695;
	690 [label=" ¡Sí, cuando un gato es un gato! ¡Él es un hombre, un hombre adulto, con muchos años de vida!",shape=box,color=blue];
		690 -> 695;
	691 [label="Le Cardinal miró al diablo y dijo: \"Uriel, hereje de Xata, en el destierro, responde: ¿pueden los Orokin ser perdonados?\"",shape=box,color=blue];
		691 -> 696;
	693 [label="Esta vez, si Lyon te cuenta sobre la tormenta que sacudió nuestra casa, él habla de la realidad, la que compartimos.",shape=box,color=blue];
		693 -> 692;
	692 [label="Fue un maravilloso cliché, me parece, que semejante maldad llegara en semejante tempestad.",shape=box,color=blue];
		692 -> 678;
	695 [label="Muchos más años de los que cualquier ser humano, azul o transfigurado hasta ser irreconocible, debería tener.",shape=box,color=blue];
		695 -> 697;
		695 -> 698;
		695 -> 3906;
	696 [label="Y con un estruendo como de trueno, como si los mismos dioses lo estuvieran convocando, le Cardinal simplemente desapareció.",shape=box,color=blue];
		696 -> 699;
	697 [label="Modificar genéticamente tu forma estaba de moda en la época de los Orokin. Pero eran tan humanos como nosotros. O lo eran, supongo.",shape=box,color=red];
		697 -> 700;
	698 [label="A excepción de la cola, honestamente parece... más humano que muchos de los Orokin de antaño.",shape=box,color=red];
		698 -> 701;
	3906 [label="No te preocupes, creo que eres mucho más bonita que él.",shape=box,color=red];
		3906 -> 3907;
	699 [label="Y nos nos dejó con... él. El diablo.",shape=box,color=blue];
		699 -> 702;
	700 [label="Sí, supongo que ya no sé qué soy. Parte Marie, parte... parte \"Wisp\"... lo que sea que son las cosas infestadas que ahora comparten mis venas.",shape=box,color=blue];
		700 -> 703;
	701 [label="Sí, estaba viendo un viejo retrato de le Cardinal, cuando se parecía más al diablo. Me habló de las costumbres orokin, de cómo ellos solían modificarse.",shape=box,color=blue];
		701 -> 704;
	3907 [label="Check boolean DrifterMarie",color=orange];
		3907 -> 3908 [label=true,color=green];
		3907 -> 3909 [label=false,color=brown];
	702 [label="Le Cardinal lo dejó con nosotros para... ¿cuidar de su alma, quizás? O al menos, cuidar de las cadenas que lo atan. Je préférerais le renvoyer en enfer.",shape=box,color=blue];
		702 -> 705;
		702 -> 706;
	703 [label="Una conversación para otro momento, quizás.",shape=box,color=blue];
		703 -> 707;
	704 [label="¡Qué parecido y a la vez tan distinto a cómo las damas de mi época usaban pelucas ostentosas que podían alcanzar el cielo o vestidos que podían albergar un orfanato entero sin mucho esfuerzo!",shape=box,color=blue];
		704 -> 708;
	3908 [label="¡Debes dejar de hacer que me sonroje! ¡Monsieur Loid se preguntará qué hago aquí sentada!",shape=box,color=blue];
		3908 -> 3911;
	3909 [label="Update boolean DrifterMarie",color=orange];
		3909 -> 3910;
	705 [label="¿Crees que al final todos pueden ser perdonados?",shape=box,color=red];
		705 -> 709;
	706 [label="¿Hay algo que te guste de él? ¿Cualquier cosa?",shape=box,color=red];
		706 -> 710;
	707 [label="Update boolean MarieInfestation",color=orange];
		707 -> 711;
	708 [label="Los humanos son lo que siempre serán: infelices con la forma que les dio Sol. Ansiosos por moldear su propia carne como arcilla. Yo no soy la excepción, supongo.",shape=box,color=blue];
		708 -> 712;
	3911 [label="Además, no es tan difícil ser más bonita que el diablo, non ? Sus rasgos son hermosos, pero el azul... ce n'est pas pour moi.",shape=box,color=blue];
		3911 -> 3912;
	3910 [label="¡Ah! ¡Me haces sonrojar! ¿Qué pensará Monsieur Loid si me ve sentada aquí, así?",shape=box,color=blue];
		3910 -> 3911;
	709 [label="¿Lo creo? Oui. Creo que todas las almas son capaces de obtener el perdón por sus transgresiones.",shape=box,color=blue];
		709 -> 713;
	710 [label="Nada. Nada, nunca.",shape=box,color=blue];
		710 -> 714;
		710 -> 715;
	711 [label="Mi problema con él es que tiene todo el ego asesino de un felino sin nada del encanto de ser un pequeño y adorable compañero.",shape=box,color=blue];
		711 -> 716;
	712 [label="Estaba demasiado feliz de tomar el suero que me convirtió en parte Marie, parte... \"Wisp\" y parte... lo que sea que son las cosas infestadas que ahora comparten mis venas.",shape=box,color=blue];
		712 -> 703;
	3912 [label="Acepto tu cumplido, si fue sincero. Simplemente me sobresalté. ¿Podríamos... volver al tema en cuestión?",shape=box,color=blue];
		3912 -> 707;
	713 [label="La pregunta sigue siendo... ¿acaso él siente que lo necesita?",shape=box,color=blue];
		713 -> 717;
	714 [label="Bueno, aprecio tu historia. Entonces, ¿Entrati quiere que lo perdonen? ¿Por qué? ¿Tau? ¿O simplemente por ser Orokin?",shape=box,color=red];
		714 -> 718;
	715 [label="Está bien, te creo. No creo que me mientas.",shape=box,color=red];
		715 -> 719;
	716 [label="Tiene una opinión muy elevada de sí mismo. Toma vidas sin dudarlo. Juega con sus enemigos como si no fueran más que un ratón acorralado.",shape=box,color=blue];
		716 -> 702;
	717 [label="No se puede perdonar a quienes no creen necesitarlo. Sería más adecuado enseñarle a volar a un pez.",shape=box,color=blue];
		717 -> 720;
	718 [label="No lo sé. Y la otra pregunta sigue siendo: ¿acaso siente en verdad que necesita algo como el perdón?",shape=box,color=blue];
		718 -> 717;
	719 [label="Fie ! Muy bien. Hay algo que compartimos... una perversa tentación por los dulces. El diablo solía volver a la Cathédrale tras robar pasteles de las tiendas.",shape=box,color=blue];
		719 -> 721;
	720 [label="Pero tú mismo háblale del tema, si deseas comprender el desafío insuperable que ahora enfrentas si buscas ganar esa guerra.",shape=box,color=blue];
		720 -> 722;
	721 [label="Yo le explicaba que eso era un robo, y él continuaba con un discurso largo y tendido sobre cómo los Orokin pronto gobernarían el sistema solar, por lo que no era un robo en el gran esquema de las cosas...",shape=box,color=blue];
		721 -> 723;
	722 [label="Yo sólo te deseo suerte.",shape=box,color=blue];
		722 -> 724;
	723 [label="Yo le gritaba y Lyon se vería obligado a interceder...",shape=box,color=blue];
		723 -> 725;
		723 -> 726;
	724 [label="+10 Chemistry",color=orange];
		724 -> 727;
	725 [label="¿Y los pasteles...?",shape=box,color=red];
		725 -> 728;
	726 [label="¿Alguna vez te preguntaste si él los traería para que todos ustedes los disfrutaran juntos?",shape=box,color=red];
		726 -> 729;
	727 [label="Chat ends.",color=orange];
	728 [label="No podíamos dejar que se desperdiciaran, ¿verdad? Era pecado comerlos, pero era peor dejar que se pudrieran. Así que los disfrutamos.",shape=box,color=blue];
		728 -> 730;
	729 [label="Si eso es cierto, nunca lo demostró. Pero... puede que tengas razón. En cualquier caso, no podíamos dejar que se desperdiciaran. Era pecado comerlos, pero peor aún dejar que se pudrieran. Así que los disfrutamos.",shape=box,color=blue];
		729 -> 730;
	730 [label="+10 Chemistry",color=orange];
		730 -> 731;
	731 [label="Hm. Quizás, ahora que lo pienso, acostumbraba traer más de lo que podía consumir solo...",shape=box,color=blue];
		731 -> 732;
	732 [label="Update boolean MarieRoathePastry1",color=orange];
		732 -> 733;
	733 [label="Pensaré en esto. Hasta mañana. À la revoyure.",shape=box,color=blue];
		733 -> 734;
	734 [label="Chat ends.",color=orange];
}