	602 [label="¿Puedo preguntarte sobre Roathe? ¿O eso hará que empieces un monólogo?",shape=box,color=red];
		602 -> 605;
	601 [label="¿Puedo preguntarte sobre el elefante en la habitación?",shape=box,color=red];
		601 -> 604;
	600 [label="[Fin]",shape=box,color=red];
		600 -> 603;
	605 [label="Ce diable est un imbécile qui se croit au-dessus de tout reproche ! Je préfèrerais boire un pot de vernis à bois plutôt que de passer une minute de plus à l'écouter s'enorgueillir comme un chat qui se lèche le pelage !",shape=box,color=blue];
		605 -> 607;
		605 -> 608;
	604 [label="Quoi! Où ça? Un éléphant ?!",shape=box,color=blue];
		604 -> 606;
	603 [label="Chat ends.",color=orange];
	607 [label="Eso fue maravillosamente creativo.",shape=box,color=red];
		607 -> 610;
	608 [label="Yo... voy a asumir que nada de eso fue amable.",shape=box,color=red];
		608 -> 611;
	606 [label="Solo veo un pez, un pájaro y... lo que sea que sea que es M'sieur Tagfer. Veo muchas cosas extrañas en este Sanctum, pero ningún elefante. ¿Estás bromeando?",shape=box,color=blue];
		606 -> 609;
	610 [label="+5 Chemistry",color=orange];
		610 -> 614;
	611 [label="+5 Chemistry",color=orange];
		611 -> 615;
	609 [label="¡Ay! Perdón. Es una frase que me enseñaron mis amigos de 1999... ",shape=box,color=red];
		609 -> 612;
		609 -> 613;
	614 [label="Merci. Fue creativo, pero me hiciste una pregunta y no debí haber dirigido mi ira hacia ti, perdóname.",shape=box,color=blue];
		614 -> 618;
	615 [label="No lo fue. Perdón, no debí haberte dicho eso. ",shape=box,color=blue];
		615 -> 618;
	612 [label="No lo decía literalmente.",shape=box,color=red];
		612 -> 616;
	613 [label="Ahora entiendo por qué piensan que es muy lindo cuando me confundo...",shape=box,color=red];
		613 -> 617;
	618 [label="Evaluate expressions",color=orange];
		618 -> 624 [label="MarieRoatheWarning",color=purple];
		618 -> 623 [label="DrifterRoathe",color=purple];
		618 -> 622 [label="MarieRoatheSoldier",color=purple];
		618 -> 621 [label="false",color=purple];
	616 [label="+5 Chemistry",color=orange];
		616 -> 619;
	617 [label="+5 Chemistry",color=orange];
		617 -> 620;
	624 [label="Aunque me sorprende que vuelvas a consultarme para saber qué pienso. Tu advertencia anterior fue clara. No quieres oírme hablar mal de él y de los de su tipo.",shape=box,color=blue];
		624 -> 633;
		624 -> 634;
	623 [label="Lo admito, no sé si debería continuar esta conversación, si te soy sincera. Parece que él te atrae comme un papillon vers une flamme.",shape=box,color=blue];
		623 -> 631;
		623 -> 632;
	622 [label="¿Sigues considerándolo como aliado? Es un juego peligroso añadirlo a tu manada, lobo. Podría desgarrarte la garganta cuando menos te lo esperes.",shape=box,color=blue];
		622 -> 629;
		622 -> 630;
	621 [label="Me sorprende que me preguntes a mí. Es evidente que tengo mala opinión de ese demonio.",shape=box,color=blue];
		621 -> 627;
		621 -> 628;
	619 [label="¡No me sorprendería que hubiera uno! Parece que tenemos todo tipo de animales salvajes aquí.",shape=box,color=blue];
		619 -> 625;
	620 [label="Oui, es encantador, ¿verdad? A menudo le digo algo a Monsieur Loid y me mira como si no tuviera la menor idea de lo que estoy hablando.",shape=box,color=blue];
		620 -> 626;
	633 [label="Respondí con brusquedad y me disculpo. No quiero condenarlo por sus acciones todavía; intento comprenderlo desde todos los ángulos.",shape=box,color=red];
		633 -> 642;
	634 [label="No. Ha tenido una vida difícil de entender. Pero tenía curiosidad por saber si me contarías cómo se conocieron.",shape=box,color=red];
		634 -> 643;
	631 [label="Simplemente intento encontrar la explicación de por qué es como es. Intento comprenderlo.",shape=box,color=red];
		631 -> 640;
	632 [label="Si supiera más sobre él, podría ayudarme a descubrir cómo guiarlo por un camino un poco más benigno.",shape=box,color=red];
		632 -> 641;
	629 [label="Lo sé. Pero no puedo odiarlo por hacer lo que tenía que hacer para servir a su gente. Yo he tenido que hacer lo mismo.",shape=box,color=red];
		629 -> 638;
	630 [label="Es uno de los Orokin más peligrosos que el imperio haya conocido. Sería una tontería rechazar esa ayuda.",shape=box,color=red];
		630 -> 639;
	627 [label="Lo sé, pero tú debes tener una idea más clara sobre él. Estoy tratando de comprenderlo mejor.",shape=box,color=red];
		627 -> 636;
	628 [label="Por eso te pregunto sobre él. Quiero entenderlo y no confío mucho en cómo cuenta su versión de los hechos.",shape=box,color=red];
		628 -> 637;
	625 [label="¿Qué significa esa frase? Si hay un elefante en la habitación, ¿por qué no hablaríamos de ello?",shape=box,color=blue];
		625 -> 635;
	626 [label="Y como se trata de un hombre que podría haber sido el sirviente de la misma reina, me siento orgullosa.",shape=box,color=blue];
		626 -> 625;
	642 [label="Add 1 to Thermostat",color=orange];
		642 -> 651;
