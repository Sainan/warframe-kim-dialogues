		1771 -> 1773;
		1771 -> 1774;
	1772 [label="Lo he visto luchar con el sufrimiento que los dioses han puesto sobre sus hombros. He sabido cuándo guardar silencio a su lado o cuándo ser el muro que puede golpear.",shape=box,color=blue];
