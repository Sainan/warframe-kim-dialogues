		j2411453274 -> j879469138 [label="LyonEntrati3",color=purple];
		j2411453274 -> j2286387014 [label="LyonEntrati3",color=purple];
		j2411453274 -> j2286387014 [label="LyonRell1",color=purple];
		j2411453274 -> j2495652932 [label="false",color=purple];
	j1290219377 [label="Ese es el problema con gente como Entrati. No son simplemente fuerzas del \"Bien\" o del \"Mal\". Son una mezcla.",shape=box,color=red];
		j1290219377 -> j2667504657;
	j3958845037 [label="Dejemos fuera de esta conversación a le Cardinal, oui ? Me preocupa mi hermano del alma.",shape=box,color=blue];
		j3958845037 -> j2814016726;
	j2288906287 [label="Yo tampoco lo creo, pero lo cierto es que lo hizo, oui ? Agradezco tus palabras. Cela dit...",shape=box,color=blue];
		j2288906287 -> j3958845037;
	j1394707845 [label="Boolean DrifterMarie is now true.",color=orange];
		j1394707845 -> j1929574529;
	j3644824159 [label="Lyon está intentando asimilar el hecho de que la Indiferencia no es un dios real.",shape=box,color=red];
		j3644824159 -> j4083287659;
	j2286387014 [label="No creo que sea una sola causa. Creo que está atrapado entre muchas cosas.",shape=box,color=red];
		j2286387014 -> j4144660063;
	j3555620370 [label="Lyon escuchaba la voz de un tenno, un chico llamado Rell. Rell... murió. No creo que esté lidiando bien con esto.",shape=box,color=red];
		j3555620370 -> j58495978;
	j586944412 [label="Roathe le susurra mentiras sobre el Hombre en la Pared.",shape=box,color=red];
		j586944412 -> j3513881411;
	j879469138 [label="No ayuda que Entrati le siguiera susurrando que las voces de sus dioses en realidad provienen del Vacío.",shape=box,color=red];
		j879469138 -> j3475542099;
	j2495652932 [label="Honestamente, no.",shape=box,color=red];
		j2495652932 -> j466455767;
	j2667504657 [label="Dejemos fuera de la conversación a le Cardinal, oui ? Me preocupa mi hermano del alma. Pero... sé que lo que dices... se está convirtiendo cada vez más en la verdad.",shape=box,color=blue];
		j2667504657 -> j3349548438;
	j1929574529 [label="No creas que no veo lo que hiciste, poniéndote en primer lugar, lobo.",shape=box,color=blue];
		j1929574529 -> j2667504657;
	j4083287659 [label="Y no has sido de ayuda en estos asuntos si le hablas así. Aunque digas la verdad, hay que tener cuidado al decirla.",shape=box,color=blue];
		j4083287659 -> j3353249412;
	j4144660063 [label="Oui, él ha sido un refugio en la tormenta para muchos... y ahora él mismo está atrapado en una.",shape=box,color=blue];
		j4144660063 -> j886506319;
	j58495978 [label="Le he oído pronunciar ese nombre, Rell, y me rompe el corazón saber cuál fue el destino de ese niño.",shape=box,color=blue];
		j58495978 -> j901053998;
	j3513881411 [label="¡Ese diablo ha causado más desgracias en su larga vida que muchos otros! Pero no creo que sea la única causa de su conflicto, non ?",shape=box,color=blue];
		j3513881411 -> j1633545453;
	j3475542099 [label="S'il te plaît, no hablemos más de le Cardinal. No niego que sus palabras agraven el conflicto de Lyon, pero no puede ser la única causa.",shape=box,color=blue];
		j3475542099 -> j879507202;
	j466455767 [label="Entonces supongo... que todo lo que podemos hacer es ser pacientes y esperar descubrir qué es lo que le preocupa.",shape=box,color=blue];
		j466455767 -> j980236013;
	j3349548438 [label="Boolean MarieEntrati4a is now true.",color=orange];
		j3349548438 -> j2814016726;
	j3353249412 [label="La cirugía no se realiza mejor con un hacha. Esto no es la Armada Británica.",shape=box,color=blue];
		j3353249412 -> j3086819418;
	j886506319 [label="Desgarrado por todos lados y sin saber qué camino tomar...",shape=box,color=blue];
		j886506319 -> j726072779;
		j886506319 -> j3914991089;
	j901053998 [label="Pero no creo que sea la única causa de su conflicto. Lyon sigue el camino de Lua. La mort est une compagne qui marche à ses côtés",shape=box,color=blue];
		j901053998 -> j3086819418;
	j1633545453 [label="Ha contribuido a su incertidumbre... ¿Pero darle tanta importancia a las palabras de un demonio? Mi Lyon es más sabio que eso. Creo que son muchas las cosas que ahora le pesan.",shape=box,color=blue];
		j1633545453 -> j1109134908;
		j1633545453 -> j2629564971;
	j879507202 [label="Boolean MarieEntrati4b is now true.",color=orange];
		j879507202 -> j1052685024;
	j980236013 [label="+15 Chemistry",color=orange];
		j980236013 -> j3304721408;
	j3086819418 [label="No, creo que son muchas cosas las que ahora le pesan.",shape=box,color=blue];
		j3086819418 -> j1109134908;
		j3086819418 -> j2629564971;
	j726072779 [label="Entonces tenemos que ser su refugio. Un lugar en donde sepa que no le harán daño.",shape=box,color=red];
		j726072779 -> j4292879441;
	j3914991089 [label="Entonces, necesitamos mostrarle el camino de regreso a la seguridad. Ser la luz en la oscuridad.",shape=box,color=red];
		j3914991089 -> j2859797137;
	j1109134908 [label="Supongo que entonces... debemos mostrarle el camino de regreso a la seguridad. Ser la luz en la oscuridad.",shape=box,color=red];
		j1109134908 -> j2859797137;
	j2629564971 [label="Supongo que entonces... solo tenemos que ser su refugio. Un lugar donde sepa que no le harán daño.",shape=box,color=red];
		j2629564971 -> j3879314098;
	j1052685024 [label="No le dio suficiente importancia a las palabras de le Cardinal como para dejar que lo sumieran en tal oscuridad. Creo que son muchas las cosas que ahora lo agobian.",shape=box,color=blue];
		j1052685024 -> j2629564971;
		j1052685024 -> j1109134908;
	j3304721408 [label="Merci. Sé que te esfuerzas. Y por eso, te lo agradezco.",shape=box,color=blue];
		j3304721408 -> "Chat ends.";
	j4292879441 [label="+10 Chemistry",color=orange];
		j4292879441 -> j2165581924;
	j2859797137 [label="¿Cómo ayudas a alguien que no puede oír tu llamado, que no puede ver tu luz? No, Lua lo ha envuelto en esta oscuridad.",shape=box,color=blue];
		j2859797137 -> j218306435;
	j3879314098 [label="+5 Chemistry",color=orange];
		j3879314098 -> j2165581924;
	j2165581924 [label="Sí, supongo que tienes razón. Debemos ser aquellos a quienes pueda recurrir cuando todo lo demás le falle.",shape=box,color=blue];
		j2165581924 -> j940560261;
	j218306435 [label="No creo que ni siquiera la luz de Sol pudiera atravesar el velo.",shape=box,color=blue];
		j218306435 -> j940560261;
	j940560261 [label="Donde su fe sea débil, debemos ser el suelo bajo sus pies. ",shape=box,color=blue];
		j940560261 -> j346493114;
	j346493114 [label="Si todas las voces invisibles se han convertido de fantômes a demonios en las sombras que lo atormentan...",shape=box,color=blue];
		j346493114 -> j1308373428;
	j1308373428 [label="Debemos hacernos cada vez más reales, ¿no?",shape=box,color=blue];
		j1308373428 -> j64880266;
		j1308373428 -> j1541032592;
	j64880266 [label="Seguiré intentándolo.",shape=box,color=red];
		j64880266 -> j178450826;
	j1541032592 [label="Sólo espero que esto no lo destroce.",shape=box,color=red];
		j1541032592 -> j3352201744;
	j178450826 [label="+10 Chemistry",color=orange];
		j178450826 -> j1325525569;
	j3352201744 [label="+5 Chemistry",color=orange];
		j3352201744 -> j1214435650;
	j1325525569 [label="Eso es todo lo que podemos hacer al final.",shape=box,color=blue];
		j1325525569 -> j630723759;
	j1214435650 [label="Oui... yo también. Pero lo único que podemos hacer es permanecer a su lado y rezar, non ?",shape=box,color=blue];
		j1214435650 -> j3240369939;
	j630723759 [label="Inténtalo. Y reza.",shape=box,color=blue];
		j630723759 -> j3886035654;
	j3240369939 [label="Y espero que no sea demasiado tarde.",shape=box,color=blue];
		j3240369939 -> j3886035654;
	j3886035654 [label="Merci... Debo irme. Lamento que esta conversación no haya sido muy útil. Me preocupo cuando no puedo actuar.",shape=box,color=blue];
		j3886035654 -> j1919441388;
		j3886035654 -> j4199453391;
	j1919441388 [label="Me pasa lo mismo. Pero a veces, actuar es la decisión equivocada.",shape=box,color=red];
		j1919441388 -> j2138120600;
	j4199453391 [label="Estará bien. Te lo aseguro.",shape=box,color=red];
		j4199453391 -> j2138120600;
	j2138120600 [label="Rezo para que tengas razón. No sé qué haría sin él.",shape=box,color=blue];
		j2138120600 -> "Chat ends.";
