	1809 [label="Desgarrado por todos lados y sin saber qué camino tomar...",shape=box,color=blue];
		1809 -> 1815;
		1809 -> 1816;
	1811 [label="Pero no creo que sea la única causa de su conflicto. Lyon sigue el camino de Lua. La mort est une compagne qui marche à ses côtés",shape=box,color=blue];
		1811 -> 1813;
	1812 [label="Ha contribuido a su incertidumbre... ¿Pero darle tanta importancia a las palabras de un demonio? Mi Lyon es más sabio que eso. Creo que son muchas las cosas que ahora le pesan.",shape=box,color=blue];
