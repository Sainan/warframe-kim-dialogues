		1777 -> 1781;
	1778 [label="¿Entonces admites que Entrati ha lastimado a Lyon? ¿Y qué piensas de ello?",shape=box,color=red];
		1778 -> 1782;
	1779 [label="Siento que está al borde del abismo. ¿Cómo puedo ayudarlo a recuperarse?",shape=box,color=red];
