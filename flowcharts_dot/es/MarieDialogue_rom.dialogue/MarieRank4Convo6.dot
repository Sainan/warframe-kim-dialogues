		1819 -> 1823;
	1814 [label="No le dio suficiente importancia a las palabras de le Cardinal como para dejar que lo sumieran en tal oscuridad. Creo que son muchas las cosas que ahora lo agobian.",shape=box,color=blue];
		1814 -> 1819;
		1814 -> 1818;
	1817 [label="Merci. Sé que te esfuerzas. Y por eso, te lo agradezco.",shape=box,color=blue];
