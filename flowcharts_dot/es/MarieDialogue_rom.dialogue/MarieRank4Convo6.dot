	1781 [label="Me desconcierta su rabia, su désespoir... evita mi compañía como nunca antes lo había hecho.",shape=box,color=blue];
		1781 -> 1785;
	1782 [label="Pas bien... Pero ¿cómo debo elegir entre mi amor por mi hermano y mi adoración por le Cardinal? ¿Cómo debo elegir entre mi familia?",shape=box,color=blue];
