		j1531216646 -> j2429168889 [label=true,color=green];
		j1531216646 -> j3547097782 [label=false,color=brown];
		j1531216646 -> j827529341 [label=false,color=brown];
		j1531216646 -> j2429168889 [label=false,color=brown];
	j3547097782 [label="Él es un adulto. Puede decidir cuándo quiere hablar.",shape=box,color=red];
		j3547097782 -> j468877676;
	j2318927889 [label="Me parte el corazón verlo pasar por este dolor. No sé cómo ayudarlo.",shape=box,color=red];
		j2318927889 -> j324915398;
	j2429168889 [label="[Fin.]",shape=box,color=red];
		j2429168889 -> "Chat ends.";
	j827529341 [label="No sé cómo ayudarlo.",shape=box,color=red];
		j827529341 -> j1771770347;
	j468877676 [label="Cuando quedaste atrapado en ese mundo que creaste, atrapado en un ciclo interminable de muerte, ¿recibiste ayuda para escapar?",shape=box,color=blue];
		j468877676 -> j273028355;
		j468877676 -> j183878297;
	j324915398 [label="Oui, y es doloroso verlo sufrir... Especialmente ahora que sé que has hecho espacio en tu corazón para él.",shape=box,color=blue];
		j324915398 -> j1771770347;
	j1771770347 [label="Es difícil predecir dónde estarán los límites con él. A menudo cambian de un día para otro.",shape=box,color=blue];
		j1771770347 -> j322330912;
	j273028355 [label="Ninguna ayuda habría valido la pena si yo no hubiese querido que me ayudaran.",shape=box,color=red];
		j273028355 -> j172603772;
		j273028355 -> j1580081385;
	j183878297 [label="Sí, de amigos.",shape=box,color=red];
		j183878297 -> j172603772;
		j183878297 -> j1580081385;
	j322330912 [label="Lo he visto luchar con el sufrimiento que los dioses han puesto sobre sus hombros. He sabido cuándo guardar silencio a su lado o cuándo ser el muro que puede golpear.",shape=box,color=blue];
		j322330912 -> j3381540435;
	j172603772 [label="No creo que Lyon quiera mi ayuda.",shape=box,color=red];
		j172603772 -> j1976787409;
	j1580081385 [label="Estoy intentando estar ahí para él, pero él no está escuchando.",shape=box,color=red];
		j1580081385 -> j3668744646;
	j3381540435 [label="Mais ça ? ¿Esto? Este lugar, las palabras del diablo, la incertidumbre que le Cardinal ha causado... Esto le ha provocado un dolor del que rezo para que pueda recuperarse.",shape=box,color=blue];
		j3381540435 -> j494240278;
		j3381540435 -> j280950802;
	j1976787409 [label="Entonces supongo... que no queda nada por hacer más que tener paciencia, non ?",shape=box,color=blue];
		j1976787409 -> j3058272287;
	j3668744646 [label="Tampoco me escucha a mí, por eso he venido a hablar contigo. Siempre he podido consolarlo...",shape=box,color=blue];
		j3668744646 -> j2814016726;
	j494240278 [label="¿Entonces admites que Entrati ha lastimado a Lyon? ¿Y qué piensas de ello?",shape=box,color=red];
		j494240278 -> j1163637080;
	j280950802 [label="Siento que está al borde del abismo. ¿Cómo puedo ayudarlo a recuperarse?",shape=box,color=red];
		j280950802 -> j1628056809;
	j3058272287 [label="Merci. Lamento desperdiciar tu tiempo.",shape=box,color=blue];
		j3058272287 -> "Chat ends.";
	j2814016726 [label="Me desconcierta su rabia, su désespoir... evita mi compañía como nunca antes lo había hecho.",shape=box,color=blue];
		j2814016726 -> j847596544;
	j1163637080 [label="Pas bien... Pero ¿cómo debo elegir entre mi amor por mi hermano y mi adoración por le Cardinal? ¿Cómo debo elegir entre mi familia?",shape=box,color=blue];
		j1163637080 -> j1015947489;
		j1163637080 -> j2338759781;
		j1163637080 -> j2184926614;
		j1163637080 -> j91895281;
	j1628056809 [label="No lo sé, por eso he venido a hablar de esto contigo. Siempre he podido consolarlo... ",shape=box,color=blue];
		j1628056809 -> j2814016726;
	j847596544 [label="¿Qué lo perturba tanto? ¿Sabes la causa?",shape=box,color=blue];
		j847596544 -> j2411453274;
	j1015947489 [label="No tienes que elegir, Marie. Las personas pueden existir en nuestras vidas de forma complicada.",shape=box,color=red];
		j1015947489 -> j1290219377;
	j2338759781 [label="Yo elegiría a la familia que sigue aquí. No a la que te abandonó.",shape=box,color=red];
		j2338759781 -> j3958845037;
	j2184926614 [label="Te aseguro que Entrati no quería causarle este tipo de dolor a Lyon.",shape=box,color=red];
		j2184926614 -> j2288906287;
	j91895281 [label="Podrías elegir una nueva familia. Como yo. Y quienes te rodean y se preocupan por ti, sin Entrati.",shape=box,color=red];
		j91895281 -> j1394707845;
	j2411453274 [label="Evaluate expressions",color=orange];
		j2411453274 -> j3644824159 [label="DrifterFaithNoMITW",color=purple];
