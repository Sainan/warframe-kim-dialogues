	1795 [label="No creo que sea una sola causa. Creo que está atrapado entre muchas cosas.",shape=box,color=red];
		1795 -> 1802;
	1797 [label="Lyon escuchaba la voz de un tenno, un chico llamado Rell. Rell... murió. No creo que esté lidiando bien con esto.",shape=box,color=red];
		1797 -> 1804;
	1798 [label="Roathe le susurra mentiras sobre el Hombre en la Pared.",shape=box,color=red];
		1798 -> 1805;
	1794 [label="No ayuda que Entrati le siguiera susurrando que las voces de sus dioses en realidad provienen del Vacío.",shape=box,color=red];
