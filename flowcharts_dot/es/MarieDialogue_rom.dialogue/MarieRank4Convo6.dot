	1815 [label="Entonces tenemos que ser su refugio. Un lugar en donde sepa que no le harán daño.",shape=box,color=red];
		1815 -> 1820;
	1816 [label="Entonces, necesitamos mostrarle el camino de regreso a la seguridad. Ser la luz en la oscuridad.",shape=box,color=red];
