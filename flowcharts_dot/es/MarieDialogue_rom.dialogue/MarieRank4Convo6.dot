		1774 -> 1777;
	1775 [label="Mais ça ? ¿Esto? Este lugar, las palabras del diablo, la incertidumbre que le Cardinal ha causado... Esto le ha provocado un dolor del que rezo para que pueda recuperarse.",shape=box,color=blue];
		1775 -> 1778;
		1775 -> 1779;
	1776 [label="Entonces supongo... que no queda nada por hacer más que tener paciencia, non ?",shape=box,color=blue];
