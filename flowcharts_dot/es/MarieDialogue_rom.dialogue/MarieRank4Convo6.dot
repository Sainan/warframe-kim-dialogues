	1820 [label="+10 Chemistry",color=orange];
		1820 -> 1824;
	1821 [label="¿Cómo ayudas a alguien que no puede oír tu llamado, que no puede ver tu luz? No, Lua lo ha envuelto en esta oscuridad.",shape=box,color=blue];
