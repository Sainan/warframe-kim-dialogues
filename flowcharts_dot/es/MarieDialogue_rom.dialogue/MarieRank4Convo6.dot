		1796 -> 1803;
	1799 [label="Dejemos fuera de la conversación a le Cardinal, oui ? Me preocupa mi hermano del alma. Pero... sé que lo que dices... se está convirtiendo cada vez más en la verdad.",shape=box,color=blue];
		1799 -> 1806;
	3963 [label="No creas que no veo lo que hiciste, poniéndote en primer lugar, lobo.",shape=box,color=blue];
		3963 -> 1799;
	1800 [label="Y no has sido de ayuda en estos asuntos si le hablas así. Aunque digas la verdad, hay que tener cuidado al decirla.",shape=box,color=blue];
		1800 -> 1807;
	1802 [label="Oui, él ha sido un refugio en la tormenta para muchos... y ahora él mismo está atrapado en una.",shape=box,color=blue];
		1802 -> 1809;
	1804 [label="Le he oído pronunciar ese nombre, Rell, y me rompe el corazón saber cuál fue el destino de ese niño.",shape=box,color=blue];
		1804 -> 1811;
	1805 [label="¡Ese diablo ha causado más desgracias en su larga vida que muchos otros! Pero no creo que sea la única causa de su conflicto, non ?",shape=box,color=blue];
		1805 -> 1812;
	1801 [label="S'il te plaît, no hablemos más de le Cardinal. No niego que sus palabras agraven el conflicto de Lyon, pero no puede ser la única causa.",shape=box,color=blue];
