digraph {
	3964 [label="MarieRank1Convo5 begins.",color=orange];
		3964 -> 3965;
	3965 [label="Bonjour, bonjour ! Debes ser el Viajero, oui ? Monsieur Loid me ha hablado muchísimo de ti. Me alegra mucho \"conocerte\" en este...",shape=box,color=blue];
		3965 -> 3966;
	3966 [label="Appareil cliquetant, ¡por inteligente que sea!",shape=box,color=blue];
		3966 -> 3967;
	3967 [label="Soy sor Marie Leroux, pero pueden llamarme Marie. Hace poco vine aquí con mi hermano del alma, el padre Lyon Allard, y... bueno, creo que Monsieur Loid te advirtió del diablo, n'est-ce pas ?",shape=box,color=blue];
		3967 -> 3968;
		3967 -> 3969;
		3967 -> 3970;
	3968 [label="Un placer conocerte. Y no lo tomes a mal, eres bienvenida, pero... ¿qué hacen aquí?",shape=box,color=red];
		3968 -> 3972;
	3969 [label="¿El diablo? ¿Te refieres al Orokin?",shape=box,color=red];
		3969 -> 3974;
	3970 [label="[Fin.]",shape=box,color=red];
		3970 -> 3971;
	3972 [label="+5 Chemistry",color=orange];
		3972 -> 3973;
	3974 [label="Oui, ese monstruo irritante de piel azul que nos encomedó el Cardenal. Creo que lo conoces como Albrecht Entrati. Él es la razón por la que estamos aquí. Pero esa es una larga historia, j'en ai bien peur.",shape=box,color=blue];
		3974 -> 3975;
		3974 -> 3976;
	3971 [label="Chat ends.",color=orange];
	3973 [label="Merci ! The what and the how of our being here is a very long story, j'en ai bien peur. We were sent here by le Cardinal. I believe you know him as Albrecht Entrati ? He entrusted us with that blue-skinned monstre irritant.",shape=box,color=blue];
		3973 -> 3975;
		3973 -> 3976;
	3975 [label="Haré lo que pueda para ayudar.",shape=box,color=red];
		3975 -> 3980;
	3976 [label="\"¿Encomendó?\"",shape=box,color=red];
		3976 -> 3977;
	3980 [label="+5 Chemistry",color=orange];
		3980 -> 3981;
	3977 [label="Debemos hacer todo lo posible para guiar su alma, si es posible. Et si ce n'est pas le cas ? Entonces debemos asegurarnos, como mínimo, de que no cause más daño.",shape=box,color=blue];
		3977 -> 3978;
		3977 -> 3979;
	3981 [label="¡Eres tal como lo describieron Monsieur Loid y los Cavia! Creo que seguro que nos haremos buenos amigos.",shape=box,color=blue];
		3981 -> 3983;
	3978 [label="Te ayudaré a intentarlo.",shape=box,color=red];
		3978 -> 3980;
	3979 [label="Es Orokin. La única forma de lograrlo es disparándole una bala entre los ojos.",shape=box,color=red];
		3979 -> 3982;
	3983 [label="¡Ah! Debo irme, perdóname. ¡Espero que volvamos a hablar pronto! À la revoyure !",shape=box,color=blue];
		3983 -> 3984;
	3982 [label="Suenas como Lyon. No perderé la esperanza. Todavía no.",shape=box,color=blue];
		3982 -> 3983;
	3984 [label="Chat ends.",color=orange];
}