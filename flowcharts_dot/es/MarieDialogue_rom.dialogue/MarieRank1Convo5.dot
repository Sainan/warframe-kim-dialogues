digraph {
	"MarieRank1Convo5 begins." [color=orange];
		"MarieRank1Convo5 begins." -> j1222410463;
	j1222410463 [label="Bonjour, bonjour ! Debes ser el Viajero, oui ? Monsieur Loid me ha hablado muchísimo de ti. Me alegra mucho \"conocerte\" en este...",shape=box,color=blue];
		j1222410463 -> j913117378;
	j913117378 [label="Appareil cliquetant, ¡por inteligente que sea!",shape=box,color=blue];
		j913117378 -> j3734090124;
	j3734090124 [label="Soy sor Marie Leroux, pero pueden llamarme Marie. Hace poco vine aquí con mi hermano del alma, el padre Lyon Allard, y... bueno, creo que Monsieur Loid te advirtió del diablo, n'est-ce pas ?",shape=box,color=blue];
		j3734090124 -> j2211823335;
		j3734090124 -> j3982869553;
		j3734090124 -> j2429168889;
	j2211823335 [label="Un placer conocerte. Y no lo tomes a mal, eres bienvenida, pero... ¿qué hacen aquí?",shape=box,color=red];
		j2211823335 -> j2247139894;
	j3982869553 [label="¿El diablo? ¿Te refieres al Orokin?",shape=box,color=red];
		j3982869553 -> j809460030;
	j2429168889 [label="[Fin.]",shape=box,color=red];
		j2429168889 -> "Chat ends.";
	j2247139894 [label="+5 Chemistry",color=orange];
		j2247139894 -> j1784552076;
	j809460030 [label="Oui, ese monstruo irritante de piel azul que nos encomedó el Cardenal. Creo que lo conoces como Albrecht Entrati. Él es la razón por la que estamos aquí. Pero esa es una larga historia, j'en ai bien peur.",shape=box,color=blue];
		j809460030 -> j361029145;
		j809460030 -> j2890379525;
	"Chat ends." [color=orange];
	j1784552076 [label="Merci ! El porqué y el cómo de nuestra llegada es una historia muy larga, j'en ai bien peur. Nos envió le Cardinal. Creo que lo conoces como Albrecht Entrati. Nos encomendó a ese monstre irritant de piel azul.",shape=box,color=blue];
		j1784552076 -> j361029145;
		j1784552076 -> j2890379525;
	j361029145 [label="Haré lo que pueda para ayudar.",shape=box,color=red];
		j361029145 -> j2632344936;
	j2890379525 [label="\"¿Encomendó?\"",shape=box,color=red];
		j2890379525 -> j694745405;
	j2632344936 [label="+5 Chemistry",color=orange];
		j2632344936 -> j2681133444;
	j694745405 [label="Debemos hacer todo lo posible para guiar su alma, si es posible. Et si ce n'est pas le cas ? Entonces debemos asegurarnos, como mínimo, de que no cause más daño.",shape=box,color=blue];
		j694745405 -> j64823738;
		j694745405 -> j2800886881;
	j2681133444 [label="¡Eres tal como lo describieron Monsieur Loid y los Cavia! Creo que seguro que nos haremos buenos amigos.",shape=box,color=blue];
		j2681133444 -> j3928766607;
	j64823738 [label="Te ayudaré a intentarlo.",shape=box,color=red];
		j64823738 -> j2632344936;
	j2800886881 [label="Es Orokin. La única forma de lograrlo es disparándole una bala entre los ojos.",shape=box,color=red];
		j2800886881 -> j4272078051;
	j3928766607 [label="¡Ah! Debo irme, perdóname. ¡Espero que volvamos a hablar pronto! À la revoyure !",shape=box,color=blue];
		j3928766607 -> "Chat ends.";
	j4272078051 [label="Suenas como Lyon. No perderé la esperanza. Todavía no.",shape=box,color=blue];
		j4272078051 -> j3928766607;
}