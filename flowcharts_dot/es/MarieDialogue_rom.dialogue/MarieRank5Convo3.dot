		j685549061 -> j3974766070;
	j324217824 [label="+5 Chemistry",color=orange];
		j324217824 -> j976836334;
	j1378819069 [label="Check boolean MarieSecretPower",color=orange];
		j1378819069 -> j381721622 [label=true,color=green];
		j1378819069 -> j2379221150 [label=false,color=brown];
	j2721882525 [label="+5 Chemistry",color=orange];
		j2721882525 -> j4067141954;
	j3973110078 [label="Oui, lo es. Por ejemplo...",shape=box,color=blue];
		j3973110078 -> j1510472752;
	j3319015256 [label="Pero es como dijiste, ¿no? Todos los inconvenientes como el mío vienen con un poder oculto. Simplemente debemos encontrarlo.",shape=box,color=blue];
		j3319015256 -> j3060077619;
	j49867916 [label="Oui, así es. A veces me sentaba allí y me quedaba mirando un libro arriba de una estantería y pensaba en lo injusto que era no poder alcanzarlo.",shape=box,color=blue];
		j49867916 -> j1822035833;
	j1416029609 [label="El otro día estaba limpiando el polvo de todos los candelabros del Sanctum. Monsieur Loid me suplicó que parara.",shape=box,color=blue];
		j1416029609 -> j2957383924;
	j3974766070 [label="Es difícil de explicar, pero lo intentaré. Mes pieds, oui ? Mis pies. El suero me ha cambiado, me permite volar...",shape=box,color=blue];
		j3974766070 -> j3843223108;
	j206951923 [label="Par les Luminaires, lo siento mucho. Entonces tú entiendes como es, oui ?",shape=box,color=blue];
		j206951923 -> j3955934751;
	j976836334 [label="Oui ! Oh, el otro día estaba limpiando el polvo de todos los candelabros del Sanctum. Monsieur Loid me suplicó que parara.",shape=box,color=blue];
		j976836334 -> j1598007846;
	j381721622 [label="Pero es como dijiste, ¿no? Todos los inconvenientes como los nuestros vienen con un poder oculto. Simplemente debemos encontrarlo.",shape=box,color=blue];
		j381721622 -> j2099107827;
	j2379221150 [label="Oui, entiendo tu frustración. A veces me sentaba allí y me quedaba mirando un libro arriba de una estantería y pensaba en lo injusto que era no poder alcanzarlo.",shape=box,color=blue];
		j2379221150 -> j3072986884;
	j4067141954 [label="Oui !! ¡¡Ah, lo entiendes!! Por ejemplo,",shape=box,color=blue];
		j4067141954 -> j4244645222;
	j1510472752 [label="¿Sabes lo cansado que es tener que flotar todo el tiempo, jour après jour, heure après heure, cuando otros pueden caminar?",shape=box,color=blue];
		j1510472752 -> j3997420262;
	j3060077619 [label="Pero sí, es frustrante. A veces me sentaba allí y me quedaba mirando un libro arriba de una estantería y pensaba en lo injusto que era no poder alcanzarlo.",shape=box,color=blue];
		j3060077619 -> j1822035833;
	j1822035833 [label="Que contuviera conocimiento que sólo a mi me interesaba, ¿por qué me lo negaban? Y entonces aparecía algún alma caritativa que, por lástima, lo tomaba para mí...",shape=box,color=blue];
		j1822035833 -> j1540148406;
	j2957383924 [label="Le dije que necesitaba mantenerme ocupada, que necesitaba tener las manos en movimiento. Creo que no entendió del todo por qué debía mantenerme tan activa.",shape=box,color=blue];
		j2957383924 -> j1249338735;
	j3843223108 [label="Pero todavía los siento, esas cosas retorcidas que amenazaban con consumirme, amenazaban con aplastar toda esperanza y alegría de mi alma.",shape=box,color=blue];
		j3843223108 -> j3279574807;
	j3955934751 [label="Tener un cuerpo que te traiciona, que frena tu espíritu. Incluso ahora, es tan extraño. El suero me ha cambiado, me permite volar...",shape=box,color=blue];
		j3955934751 -> j849612541;
	j1598007846 [label="Le dije que necesitaba mantenerme ocupada, que necesitaba tener las manos en movimiento. Creo que no entendió del todo por qué debía mantenerme tan activa.",shape=box,color=blue];
		j1598007846 -> j1580548430;
	j2099107827 [label="Pero entiendo tu frustración. La conozco bien. A veces me sentaba allí y me quedaba mirando un libro arriba de una estantería y pensaba en lo injusto que era no poder alcanzarlo.",shape=box,color=blue];
		j2099107827 -> j3072986884;
	j3072986884 [label="Que contuviera conocimiento que sólo a mi me interesaba, ¿por qué me lo negaban? Y entonces aparecía algún alma caritativa que, por lástima, lo tomaba para mí...",shape=box,color=blue];
		j3072986884 -> j2698581237;
		j3072986884 -> j4181962234;
	j4244645222 [label="¿Sabes lo cansado que es tener que flotar todo el tiempo, jour après jour, heure après heure, cuando otros pueden caminar?",shape=box,color=blue];
		j4244645222 -> j2859565489;
	j3997420262 [label="Estoy encantada de poderme mover, de poder llegar a donde quiera, no me malinterpretes. ¡Pero aun así es agotador!",shape=box,color=blue];
		j3997420262 -> j1249338735;
	j1540148406 [label="Y no es su culpa, pues están haciendo un acto de bondad; yo necesitaba la ayuda. Y no es culpa suya que yo la necesitara. Pero ¡ay!, qué frustrante es necesitar esa ayuda.",shape=box,color=blue];
		j1540148406 -> j1302868317;
		j1540148406 -> j3139900428;
	j1249338735 [label="Es tan... agradable poder hablar de todo esto. No encuentro las palabras adecuadas. Es tan raro poder hablar de esta plaga invisible y silenciosa.",shape=box,color=blue];
		j1249338735 -> j4104316599;
	j3279574807 [label="Siempre me duelen. Siempre. Incluso ahora, sentada aquí, si pienso en ellos, siento el dolor. Pero no siempre es lo suficiente para notarlo.",shape=box,color=blue];
		j3279574807 -> j254797553;
		j3279574807 -> j158798233;
	j849612541 [label="Pero todavía los siento, esas cosas retorcidas que amenazaban con consumirme, amenazaban con aplastar toda esperanza y alegría de mi alma.",shape=box,color=blue];
		j849612541 -> j2639702498;
	j1580548430 [label="Ah, me alegra saber que alguien aquí comprende lo que se siente. Es tan raro. Esta plaga silenciosa e invisible que nos afecta.",shape=box,color=blue];
		j1580548430 -> j1968258173;
	j2698581237 [label="¿Qué hay de malo en eso?",shape=box,color=red];
		j2698581237 -> j903023616;
	j4181962234 [label="Sí, lo sé. Y no es su culpa.",shape=box,color=red];
		j4181962234 -> j2113001173;
	j2859565489 [label="Estoy encantada de poderme mover, de poder llegar a donde quiera, no me malinterpretes. ¡Pero aun así es agotador!",shape=box,color=blue];
		j2859565489 -> j1580548430;
	j1302868317 [label="Lamento mucho que tengas que soportar todo eso. ",shape=box,color=red];
		j1302868317 -> j1545823927;
	j3139900428 [label="Y ni siquiera puedes expresar esa frustración.",shape=box,color=red];
		j3139900428 -> j1545823927;
	j4104316599 [label="Como una pequeña abeille que se posa en mi hombro y me pica todos los días. No lo suficiente como para destruirme, solo lo suficiente para molestarme.",shape=box,color=blue];
		j4104316599 -> j1035512624;
		j4104316599 -> j4273979420;
	j2639702498 [label="Siempre me duelen. Siempre. Incluso ahora, sentada aquí, si pienso en ellos, siento el dolor. Pero no siempre es lo suficiente para notarlo.",shape=box,color=blue];
		j2639702498 -> j1728137790;
		j2639702498 -> j3890794972;
	j1968258173 [label="Como una pequeña abeille que se posa sobre nosotros y nos pica a diario. No lo suficiente como para destruirnos, solo lo suficiente para molestarnos.",shape=box,color=blue];
		j1968258173 -> j4273979420;
		j1968258173 -> j1035512624;
	j903023616 [label="¡Nada! No pasa nada. Necesitaba ayuda. Pero ahí radica el problema: necesitaba ayuda. Y es, como dijiste... frustrante.",shape=box,color=blue];
		j903023616 -> j2678197323;
	j2113001173 [label="Oui ! No es su culpa, pues están haciendo un acto de bondad; yo necesitaba la ayuda. Y no es culpa suya que yo la necesitara. Pero ¡ay!, qué frustrante es necesitar esa ayuda.",shape=box,color=blue];
		j2113001173 -> j2678197323;
	j1545823927 [label="+10 Chemistry",color=orange];
		j1545823927 -> j1249338735;
	j1035512624 [label="Bueno, ojalá desapareciera...",shape=box,color=red];
		j1035512624 -> j2202409117;
	j4273979420 [label="¿Qué es una \"abeille\"?",shape=box,color=red];
		j4273979420 -> j1966834939;
	j2678197323 [label="+5 Chemistry",color=orange];
		j2678197323 -> j1580548430;
	j2202409117 [label="¡Yo también! Pero al mismo tiempo eso nos hace parte de lo que somos, non ? ¿Quiénes somos nosotros para decir qué partes de nosotros son importantes y cuáles no?",shape=box,color=blue];
		j2202409117 -> j2427033551;
	j1966834939 [label="¡Oh! Una cosita pequeñita, amarilla y negra, con rayas, tiene una aguja en su derrière ... y que produce miel.",shape=box,color=blue];
		j1966834939 -> j4133007970;
		j1966834939 -> j3666808160;
	j2427033551 [label="Evaluate expressions",color=orange];
		j2427033551 -> j3411362682 [label="DrifterFaithStop",color=purple];
		j2427033551 -> j4246308303 [label="DrifterFaithYesSimilar",color=purple];
		j2427033551 -> j2030636273 [label="DrifterFaithYesForeign",color=purple];
		j2427033551 -> j4170598820 [label="DrifterFaithPersonal",color=purple];
		j2427033551 -> j3290894662 [label="DrifterFaithSol",color=purple];
		j2427033551 -> j4178315528 [label="DrifterFaithLua",color=purple];
		j2427033551 -> j11974901 [label="DrifterFaithBalance",color=purple];
		j2427033551 -> j358772139 [label="DrifterFaithAgnostic",color=purple];
		j2427033551 -> j1484724507 [label="DrifterFaithNoFear",color=purple];
		j2427033551 -> j1484724507 [label="DrifterFaithNoMaybe",color=purple];
		j2427033551 -> j1484724507 [label="DrifterFaithNoMITW",color=purple];
		j2427033551 -> j1137310819 [label="false",color=purple];
	j4133007970 [label="¡Ah, una abeja!",shape=box,color=red];
		j4133007970 -> j1923670102;
	j3666808160 [label="No, no sé de qué hablas... continúa.",shape=box,color=red];
		j3666808160 -> j1175917609;
	j3411362682 [label="No hablaré de fe más que para decir que... por imperfectas que parezcan nuestras formas desde esta limitada perspectiva, debemos... estar en paz con lo que somos, non? Es todo lo que tenemos.",shape=box,color=blue];
		j3411362682 -> j2548984291;
	j4246308303 [label="Sé que nuestras creencias son similares, así que diré que... Sol consideró oportuno crearme tal y como soy, y debo tener fe en su creación, non ? Aunque mi perspectiva sea limitada, me pregunto si no podrías considerar lo mismo sobre ti.",shape=box,color=blue];
		j4246308303 -> j2548984291;
	j2030636273 [label="Sé que nuestras creencias son distintas, así que no hablaré de lo que desconozco. Simplemente diré que Sol decidió crearme tal y como soy, y debo tener fe en su creación, non ? Aunque desde mi limitada perspectiva pueda parecer imperfecta. Me pregunto si no podrías considerar lo mismo.",shape=box,color=blue];
		j2030636273 -> j2548984291;
	j4170598820 [label="Sé que tu fe es algo privado y no me entrometeré. Simplemente diré que Sol decidió crearme tal y como soy, y debo tener fe en su creación, non ? Aunque desde mi limitada perspectiva pueda parecer imperfecta. Me pregunto si no podrías considerar lo mismo.",shape=box,color=blue];
		j4170598820 -> j2548984291;
	j3290894662 [label="Sol decidió crearnos a ambos tal y como somos, y debemos tener fe en su creación, non ? Por imperfecta que nos parezca desde nuestra limitada perspectiva.",shape=box,color=blue];
		j3290894662 -> j2548984291;
	j4178315528 [label="Lua estuvo a bien al crearte tal como eres y Sol consideró oportuno crearme tal y como soy. Debemos tener fe en sus creaciones, non? Aunque desde nuestra limitada perspectiva parezcan imperfectas.",shape=box,color=blue];
		j4178315528 -> j2548984291;
	j11974901 [label="Las Luminarias decidieron crearnos como somos. Debemos tener fe en sus creaciones, non? Aunque desde nuestra limitada perspectiva parezcan imperfectas.",shape=box,color=blue];
		j11974901 -> j2548984291;
	j358772139 [label="Sé que crees que ninguno de nosotros puede conocer la verdad sobre el universo y lo respeto y lo aplaudo. Pero simplemente diré que Sol consideró oportuno crearme tal y como soy, y debo tener fe en su creación, non ? Aunque desde mi limitada perspectiva pueda parecerme imperfecta.",shape=box,color=blue];
		j358772139 -> j2548984291;
	j1484724507 [label="Sé que no tienes una fe y lo respeto. Pero simplemente diré que Sol decidió hacerme tal y como soy y debo tener fe en su creación, ¿no? Aunque desde mi limitada perspectiva pueda parecer imperfecta.",shape=box,color=blue];
		j1484724507 -> j2548984291;
	j1137310819 [label="Simplemente diré que Sol decidió hacerme tal y como soy y debo tener fe en su creación, non ? Por imperfecta que me parezca desde mi limitada perspectiva.",shape=box,color=blue];
		j1137310819 -> j2548984291;
	j1923670102 [label="¡Abeja, abeille! ¡Pff, son lo mismo! ¡Ja! ",shape=box,color=blue];
		j1923670102 -> j3515570948;
	j1175917609 [label="Vuela con sus alitas entre las flores... ¡Espera! ¡No! ¡Te estas burlando de mí, lo sé!",shape=box,color=blue];
		j1175917609 -> j3515570948;
