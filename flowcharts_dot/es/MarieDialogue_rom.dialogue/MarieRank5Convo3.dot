	j2465063989 [label="Oh, mon cœur, qué amable pregunta... pero como siempre, me temo que... es solo una cuestión de comparación.",shape=box,color=blue];
		j2465063989 -> j158798233;
		j2465063989 -> j254797553;
	j3983601407 [label="¿Pasa algo malo?",shape=box,color=red];
		j3983601407 -> j3379216819;
	j1328247716 [label="Está bien, si estás segura.",shape=box,color=red];
		j1328247716 -> j2524959644;
	j2043198109 [label="Oh, qué pregunta tan amable... pero como siempre, me temo que es... solo una cuestión de comparación. Pero sabes lo que eso significa, estoy segura, oui ?",shape=box,color=blue];
		j2043198109 -> j3890794972;
		j2043198109 -> j1728137790;
	j204362335 [label="Oh, qué amable pregunta... pero como siempre, me temo que... es solo una cuestión de comparación.",shape=box,color=blue];
		j204362335 -> j158798233;
		j204362335 -> j254797553;
	j3890794972 [label="Lo siento si al preguntarte te causé dolor.",shape=box,color=red];
		j3890794972 -> j1200023802;
	j1728137790 [label="¿Hay algo que pueda hacer para que te sientas mejor o para que te olvides de ello?",shape=box,color=red];
		j1728137790 -> j92097538;
	j158798233 [label="Oh, lo siento... ¿te duele mucho hoy? ",shape=box,color=red];
		j158798233 -> j3174889217;
	j254797553 [label="¿Hay algo que pueda hacer?",shape=box,color=red];
		j254797553 -> j75448018;
	j3379216819 [label="Vraimente gentil de tu parte, pero es un problema viejo, no vale la pena preocuparse. Estaré bien.",shape=box,color=blue];
		j3379216819 -> j3359734167;
	j2524959644 [label="+10 Chemistry",color=orange];
		j2524959644 -> j4114927712;
	j1200023802 [label="+10 Chemistry",color=orange];
		j1200023802 -> j679174796;
	j92097538 [label="+10 Chemistry",color=orange];
		j92097538 -> j3255681136;
	j3174889217 [label="Oui, me temo que sí. La mente es algo verdaderamente maravilloso. Me parece fascinante que duelan siempre, todo el tiempo, y sin embargo he aprendido a simplemente ignorarlas.",shape=box,color=blue];
		j3174889217 -> j879054198;
		j3174889217 -> j888999543;
		j3174889217 -> j3176792280;
	j75448018 [label="Lo estás haciendo ahora mismo hablándome. La mente es algo maravilloso, ¿verdad? Creo que mis pies deben dolerme constantemente, pero he aprendido a ignorarlos.",shape=box,color=blue];
		j75448018 -> j879054198;
		j75448018 -> j888999543;
		j75448018 -> j3176792280;
	j3359734167 [label="Boolean MarieChronicPain is now true.",color=orange];
		j3359734167 -> j4173298386;
		j3359734167 -> j3505691895;
		j3359734167 -> j2432171184;
	j4114927712 [label="Oui, estoy bien, te lo aseguro. Pero gracias. Agradezco tu preocupación.",shape=box,color=blue];
		j4114927712 -> "Chat ends.";
	j679174796 [label="¡Ja! Qué curioso, non ? Tienes razón. No estaba pensando en mis pies, pero ahora sí y me duelen. ",shape=box,color=blue];
		j679174796 -> j1050484754;
	j3255681136 [label="Oui ! Lo estás haciendo ahora mismo hablando conmigo. La mente es algo maravilloso, ¿verdad? Creo que mis pies deben dolerme constantemente, pero he aprendido a ignorarlos.",shape=box,color=blue];
		j3255681136 -> j612284380;
		j3255681136 -> j2377206316;
		j3255681136 -> j1974881390;
	j879054198 [label="Eso suena agotador...",shape=box,color=red];
		j879054198 -> j1484401718;
	j888999543 [label="Eso suena frustrante.",shape=box,color=red];
		j888999543 -> j2716662205;
	j3176792280 [label="¿De verdad no tiene cura? ¿Nunca se detiene?",shape=box,color=red];
		j3176792280 -> j3110267144;
	j4173298386 [label="Está bien si estás segura, pero estoy aquí, si quieres hablar de ello.",shape=box,color=red];
		j4173298386 -> j2243986586;
	j3505691895 [label="Yo... sé cómo es eso. Antes de empezar a hacer \"bucles\", me lastimé bastante en Duviri. Sané, pero todavía me duele muchísimo de vez en cuando. Intento disimular mi dolor cuando aparece.",shape=box,color=red];
		j3505691895 -> j1297783518;
	j2432171184 [label="Los viejos problemas persistentes pueden ser tan problemáticos como los nuevos. Que aparezcan y desaparezcan, y que puedan quedarse con nosotros, no significa que no valga la pena hablar de ellos.",shape=box,color=red];
		j2432171184 -> j685549061;
	j1050484754 [label="La mente es algo verdaderamente maravilloso. Me parece fascinante que duelan siempre, todo el tiempo, y sin embargo he aprendido a simplemente ignorarlas.",shape=box,color=blue];
		j1050484754 -> j612284380;
		j1050484754 -> j2377206316;
		j1050484754 -> j1974881390;
	j612284380 [label="A mí me pasa igual. En cuanto me concentro en algo... sí, ahí está el dolor. A veces me pregunto si por eso intento mantenerme tan ocupada.",shape=box,color=red];
		j612284380 -> j324217824;
	j2377206316 [label="A veces me enfado al pensar en todo lo que podría hacer si no estuviera distraída por el dolor todo el tiempo.",shape=box,color=red];
		j2377206316 -> j1378819069;
	j1974881390 [label="¿Tú también estás siempre cansada? A veces me pregunto si será por eso me agoto tanto. Siempre siento que el dolor aunque sea en el fondo.",shape=box,color=red];
		j1974881390 -> j2721882525;
	j1484401718 [label="+10 Chemistry",color=orange];
		j1484401718 -> j3973110078;
	j2716662205 [label="Check boolean MarieSecretPower",color=orange];
		j2716662205 -> j3319015256 [label=true,color=green];
		j2716662205 -> j49867916 [label=false,color=brown];
	j3110267144 [label="No... nunca se detiene. Solo puedo distraerme, por ejemplo, en conversaciones como esta. O manteniéndome ocupada.",shape=box,color=blue];
		j3110267144 -> j1416029609;
	j2243986586 [label="Eres muy amable, y... bueno. Estoy siendo la pequeña testaruda Marie otra vez.",shape=box,color=blue];
		j2243986586 -> j3974766070;
	j1297783518 [label="Boolean DrifterChronicPain is now true.",color=orange];
