		j1707336315 -> j3983601407;
		j1707336315 -> j1328247716;
	j4162556790 [label="Oh, mon cœur, qué pregunta tan amable... pero como siempre, me temo que es... solo una cuestión de comparación. Pero sabes lo que eso significa, estoy segura, oui ?",shape=box,color=blue];
		j4162556790 -> j3890794972;
