	2382 [label="Update boolean MarieEntratiFan1",color=orange];
		2382 -> 2389;
	2383 [label="¿Y cuándo Entrati vio lo que había hecho? ¿Cuándo se dio cuenta de lo que había creado? ¿Estos pobres animales, hablando en lengua del Vacío, enfermos por la exposición?",shape=box,color=red];
		2383 -> 2390;
