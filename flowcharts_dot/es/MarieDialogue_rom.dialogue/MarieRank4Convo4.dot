		2308 -> 2310 [label="false",color=purple];
		2308 -> 2312 [label="false",color=purple];
	2310 [label="No necesitaba decírmelo, lo podía adivinar. Entrati.",shape=box,color=red];
		2310 -> 2314;
	2311 [label="Lo hizo. Aunque parecía más preocupado por ti que por cualquier otra cosa.",shape=box,color=red];
		2311 -> 2315;
	2309 [label="Sí. Está preocupado por la situación porque creo que siente algo por los Cavia. ",shape=box,color=red];
		2309 -> 2313;
	2312 [label="No, en serio. Sólo dijo que pasara a ver cómo estabas.",shape=box,color=red];
		2312 -> 2316;
	2314 [label="Oui. M'sieur Tagfer estaba discutiendo sobre el tema de le Cardinal.",shape=box,color=blue];
		2314 -> 2318;
		2314 -> 2319;
	2315 [label="No sé por qué el diablo querría que creyeras tal cosa. Ni para qué le serviría.",shape=box,color=blue];
		2315 -> 2320;
	2313 [label="El diablo ve tres animales heridos y sabe que puede utilizar fácilmente su carisma para lograr que lo adulen.",shape=box,color=blue];
		2313 -> 2317;
	2316 [label="No sé por qué el diablo querría que hicieras tal cosa. Ni para qué cree que le serviría.",shape=box,color=blue];
		2316 -> 2321;
	2318 [label="Tagfer no es el mayor fanático de Entrati, no.",shape=box,color=red];
		2318 -> 2323;
	2319 [label="Supongo que la discusión fue intensa.",shape=box,color=red];
		2319 -> 2324;
	2320 [label="Todos los actos de supuesta bondad del diablo hacia mí tienen por objetivo ponerme en contra de le Cardinal. Lo sé. ",shape=box,color=blue];
		2320 -> 2322;
	2317 [label="Hace esto para volver la situación en mi contra. Quiere corromperme y ponerme en contra de le Cardinal. Para que le de la espalda. Lo sé.",shape=box,color=blue];
		2317 -> 2322;
	2321 [label="Pero... no es eso lo que estás aquí para discutir. La pelea fue por le Cardinal. ",shape=box,color=blue];
		2321 -> 2318;
		2321 -> 2319;
	2323 [label="¡Y no lo entiendo! ¡Mira lo que les han dado!",shape=box,color=blue];
		2323 -> 2325;
		2323 -> 2326;
	2324 [label="Oui ! Me llamó stupide. Me dijo que no soy más que una niña.",shape=box,color=blue];
		2324 -> 2327;
		2324 -> 2325;
	2322 [label="Y era el tema de le Cardinal lo que discutía con M'sieur Tagfer.",shape=box,color=blue];
		2322 -> 2318;
		2322 -> 2319;
	2325 [label="Por favor, empieza desde el principio. ¿Cómo empezó toda esta pelea?",shape=box,color=red];
		2325 -> 2328;
	2326 [label="Puedo empezar a imaginarme por qué ocurrió esta pelea.",shape=box,color=red];
		2326 -> 2328;
	2327 [label="¿En serio te llamó estúpida y niña?",shape=box,color=red];
		2327 -> 2329;
	2328 [label="Oui. Mencioné a le Cardinal, ni siquiera sé qué más. ",shape=box,color=blue];
		2328 -> 2330;
	2329 [label="Peor, tal vez.",shape=box,color=blue];
		2329 -> 2331;
	2330 [label="M'sieur Tagfer puso los ojos en blanco y resopló. Le pedí que explicara su gesto.",shape=box,color=blue];
		2330 -> 2332;
	2331 [label="\"¡Eres una cría, Marie! Inocente. Dependiente de los demás toda tu vida. ¡Acurrucada en tu pequeño nido de fe ciega!\"",shape=box,color=blue];
		2331 -> 2333;
	2332 [label="\"¡Albrecht es un sucio y apestoso mentiroso!\"",shape=box,color=blue];
		2332 -> 2334;
	2333 [label="\"¡Sobrevives con lo que tus mayores masticaron y escupieron en tu crédula y abierta boca!\"",shape=box,color=blue];
		2333 -> 2335;
	2334 [label="Et j'ai répondu: \"Mira los dones que se te dieron: los dones del pensamiento, del lenguaje, ¡del Ser!\"",shape=box,color=blue];
		2334 -> 2336;
	2335 [label="Update boolean MarieEntrati3",color=orange];
		2335 -> 2337;
		2335 -> 2338;
		2335 -> 2339;
	2336 [label="\"Deberías estar agradecido con le Cardinal por todas las bendiciones que te ha dado.\"",shape=box,color=blue];
		2336 -> 2340;
		2336 -> 2341;
	2337 [label="Tagfer solo conoce su versión de los hechos. Las verdaderas motivaciones u opiniones de Entrati no fueron... explicadas con claridad.",shape=box,color=red];
		2337 -> 2342;
	2338 [label="Sé cómo te sientes acerca de ser \"dependiente\" de otros y lamento que te haya dicho esas cosas.",shape=box,color=red];
		2338 -> 2343;
	2339 [label="Tagfer tiene buenas razones para sentirse como se siente.",shape=box,color=red];
		2339 -> 2344;
