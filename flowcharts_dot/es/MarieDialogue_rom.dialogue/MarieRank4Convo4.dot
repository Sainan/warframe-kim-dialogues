		2396 -> 2399;
	2397 [label="Usados en un experimento del Vacío. Supervivientes de una larga lista de animales muertos. Nunca se pretendió que existieran.",shape=box,color=red];
		2397 -> 2400;
	2398 [label="Chat ends.",color=orange];
	2399 [label="El último de su especie. Etiquetado para desechar. ¿Su pareja? ¿Minn? ¿El único otro que quedaba? Murió en el experimento.",shape=box,color=red];
		2399 -> 2401;
	2400 [label="Es solo gracias a Loid que siguen vivos. Los preservó porque no pudo decidirse a sacrificarlos \"por orden de Entrati\".",shape=box,color=red];
		2400 -> 2402;
	2401 [label="Por eso estaba enojado, Marie. Por eso odia a Entrati. Y probablemente siempre lo hará.",shape=box,color=red];
		2401 -> 2403;
