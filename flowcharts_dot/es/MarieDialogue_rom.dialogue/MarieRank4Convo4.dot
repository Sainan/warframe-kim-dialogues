		2374 -> 2382;
	2375 [label="Los Cavia fueron accidentes creados a partir de experimentos. Animales de laboratorio que nunca estuvieron destinados a existir. El Vacío les dio inteligencia.",shape=box,color=red];
		2375 -> 2383;
	2377 [label="Tú misma dijiste: \"Es la máxima crueldad carecer de nombre.\" Entrati nunca se molestó en nombrarlos; ni ese valor tenían.",shape=box,color=red];
		2377 -> 2385;
	2378 [label="Me contaste la historia de cómo creciste en la calle. Cómo tu familia te echó porque no eras lo suficientemente buena para ellos.",shape=box,color=red];
		2378 -> 2386;
	2379 [label="Piensa en cómo te habrías sentido si simplemente te hubieran convertido en un protoframe contra tu voluntad y luego te hubieran abandonado.",shape=box,color=red];
		2379 -> 2387;
