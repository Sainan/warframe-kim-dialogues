	"Chat ends." [color=orange];
	j634884049 [label="Oui, aunque siento que ya sé de qué se trata... Me porté mal. ¿Quién te lo dijo?",shape=box,color=blue];
		j634884049 -> j2731913545;
		j634884049 -> j3307361815;
		j634884049 -> j850896271;
	j1616181986 [label="Bien sûr, ce salaud de diable ouvre sa bouche et vous raconte tout ! Il ne cherche qu'à m'embarrasser !",shape=box,color=blue];
		j1616181986 -> j2091869655;
	j2731913545 [label="Eso no importa.",shape=box,color=red];
		j2731913545 -> j2360094194;
	j3307361815 [label="Loid. ",shape=box,color=red];
		j3307361815 -> j3784986680;
	j850896271 [label="Roathe.",shape=box,color=red];
		j850896271 -> j1616181986;
	j2091869655 [label="Si je le pouvais, je prendrais ce couteau qu'il aime tant utiliser pour agacer les autres et je le fourrerais là où seule Lua peut le voir !",shape=box,color=blue];
		j2091869655 -> j4216867111;
	j2360094194 [label="Creo que sí, pero pienso que no quieres arruinar mi ánimo. Así que... no te presionaré para que me cuentes más.",shape=box,color=blue];
		j2360094194 -> j2935233738;
	j3784986680 [label="Creo que estás mintiendo para no molestarme, así que... no te presionaré.",shape=box,color=blue];
		j3784986680 -> j2935233738;
	j4216867111 [label="Perdóname. Eso fue... inapropiado. Soy una Sœur de Sol y no debo perder los estribos ni hablar de esa manera.",shape=box,color=blue];
		j4216867111 -> j2712392429;
	j2935233738 [label="+5 Chemistry",color=orange];
		j2935233738 -> j2210604928;
	j2712392429 [label="+5 Chemistry",color=orange];
		j2712392429 -> j338889678;
	j2210604928 [label="Deseo conservar la poca dignidad que se me permita en esta conversación.",shape=box,color=blue];
		j2210604928 -> j2298727353;
	j338889678 [label="Mi enojo no va dirigido a ti. Y siempre agradezco tu honestidad.",shape=box,color=blue];
		j338889678 -> j29227975;
	j2298727353 [label="Si vienes a hablar conmigo sobre la discusión que tuve con M'sieur Tagfer, no negaré que ocurrió.",shape=box,color=blue];
		j2298727353 -> j29227975;
	j29227975 [label="¿Supongo que el diablo te dijo de qué se trataba la pelea?",shape=box,color=blue];
		j29227975 -> j370765590;
	j370765590 [label="Evaluate expressions",color=orange];
		j370765590 -> j3449009020 [label="MarieTagferFight2a",color=purple];
		j370765590 -> j3921209712 [label="MarieTagferFight2a",color=purple];
		j370765590 -> j4263947365 [label="MarieTagferFight2b",color=purple];
		j370765590 -> j3449009020 [label="MarieTagferFight2b",color=purple];
		j370765590 -> j3449009020 [label="false",color=purple];
		j370765590 -> j962732487 [label="false",color=purple];
	j3449009020 [label="No necesitaba decírmelo, lo podía adivinar. Entrati.",shape=box,color=red];
		j3449009020 -> j1689428959;
	j3921209712 [label="Lo hizo. Aunque parecía más preocupado por ti que por cualquier otra cosa.",shape=box,color=red];
		j3921209712 -> j1551596119;
	j4263947365 [label="Sí. Está preocupado por la situación porque creo que siente algo por los Cavia. ",shape=box,color=red];
		j4263947365 -> j2982061760;
	j962732487 [label="No, en serio. Sólo dijo que pasara a ver cómo estabas.",shape=box,color=red];
		j962732487 -> j2389338259;
	j1689428959 [label="Oui. M'sieur Tagfer estaba discutiendo sobre el tema de le Cardinal.",shape=box,color=blue];
		j1689428959 -> j2226993640;
		j1689428959 -> j265029062;
	j1551596119 [label="No sé por qué el diablo querría que creyeras tal cosa. Ni para qué le serviría.",shape=box,color=blue];
		j1551596119 -> j2103952217;
	j2982061760 [label="El diablo ve tres animales heridos y sabe que puede utilizar fácilmente su carisma para lograr que lo adulen.",shape=box,color=blue];
		j2982061760 -> j3114164768;
	j2389338259 [label="No sé por qué el diablo querría que hicieras tal cosa. Ni para qué cree que le serviría.",shape=box,color=blue];
		j2389338259 -> j1652874890;
	j2226993640 [label="Tagfer no es el mayor fanático de Entrati, no.",shape=box,color=red];
		j2226993640 -> j3796192281;
	j265029062 [label="Supongo que la discusión fue intensa.",shape=box,color=red];
		j265029062 -> j4003744340;
	j2103952217 [label="Todos los actos de supuesta bondad del diablo hacia mí tienen por objetivo ponerme en contra de le Cardinal. Lo sé. ",shape=box,color=blue];
		j2103952217 -> j2616519392;
	j3114164768 [label="Hace esto para volver la situación en mi contra. Quiere corromperme y ponerme en contra de le Cardinal. Para que le de la espalda. Lo sé.",shape=box,color=blue];
		j3114164768 -> j2616519392;
	j1652874890 [label="Pero... no es eso lo que estás aquí para discutir. La pelea fue por le Cardinal. ",shape=box,color=blue];
		j1652874890 -> j2226993640;
		j1652874890 -> j265029062;
	j3796192281 [label="¡Y no lo entiendo! ¡Mira lo que les han dado!",shape=box,color=blue];
		j3796192281 -> j2699194490;
		j3796192281 -> j2991332478;
	j4003744340 [label="Oui ! Me llamó stupide. Me dijo que no soy más que una niña.",shape=box,color=blue];
		j4003744340 -> j501523484;
		j4003744340 -> j2699194490;
	j2616519392 [label="Y era el tema de le Cardinal lo que discutía con M'sieur Tagfer.",shape=box,color=blue];
		j2616519392 -> j2226993640;
		j2616519392 -> j265029062;
	j2699194490 [label="Por favor, empieza desde el principio. ¿Cómo empezó toda esta pelea?",shape=box,color=red];
		j2699194490 -> j151912054;
	j2991332478 [label="Puedo empezar a imaginarme por qué ocurrió esta pelea.",shape=box,color=red];
		j2991332478 -> j151912054;
	j501523484 [label="¿En serio te llamó estúpida y niña?",shape=box,color=red];
		j501523484 -> j500068270;
	j151912054 [label="Oui. Mencioné a le Cardinal, ni siquiera sé qué más. ",shape=box,color=blue];
		j151912054 -> j555259945;
	j500068270 [label="Peor, tal vez.",shape=box,color=blue];
		j500068270 -> j22240173;
	j555259945 [label="M'sieur Tagfer puso los ojos en blanco y resopló. Le pedí que explicara su gesto.",shape=box,color=blue];
		j555259945 -> j3701819195;
	j22240173 [label="\"¡Eres una cría, Marie! Inocente. Dependiente de los demás toda tu vida. ¡Acurrucada en tu pequeño nido de fe ciega!\"",shape=box,color=blue];
		j22240173 -> j655667079;
	j3701819195 [label="\"¡Albrecht es un sucio y apestoso mentiroso!\"",shape=box,color=blue];
		j3701819195 -> j365379240;
	j655667079 [label="\"¡Sobrevives con lo que tus mayores masticaron y escupieron en tu crédula y abierta boca!\"",shape=box,color=blue];
		j655667079 -> j471012429;
	j365379240 [label="Et j'ai répondu: \"Mira los dones que se te dieron: los dones del pensamiento, del lenguaje, ¡del Ser!\"",shape=box,color=blue];
		j365379240 -> j2081503903;
	j471012429 [label="Boolean MarieEntrati3 is now true.",color=orange];
		j471012429 -> j2849042893;
		j471012429 -> j1279453955;
		j471012429 -> j643373448;
	j2081503903 [label="\"Deberías estar agradecido con le Cardinal por todas las bendiciones que te ha dado.\"",shape=box,color=blue];
		j2081503903 -> j2665857396;
		j2081503903 -> j1927234516;
	j2849042893 [label="Tagfer solo conoce su versión de los hechos. Las verdaderas motivaciones u opiniones de Entrati no fueron... explicadas con claridad.",shape=box,color=red];
		j2849042893 -> j2832880435;
	j1279453955 [label="Sé cómo te sientes acerca de ser \"dependiente\" de otros y lamento que te haya dicho esas cosas.",shape=box,color=red];
		j1279453955 -> j1845472885;
	j643373448 [label="Tagfer tiene buenas razones para sentirse como se siente.",shape=box,color=red];
		j643373448 -> j946548047;
	j2665857396 [label="¿Y cómo lo tomó?",shape=box,color=red];
		j2665857396 -> j22240173;
	j1927234516 [label="Oh, no...",shape=box,color=red];
		j1927234516 -> j22240173;
	j2832880435 [label="+5 Chemistry",color=orange];
		j2832880435 -> j1429852767;
	j1845472885 [label="+5 Chemistry",color=orange];
		j1845472885 -> j2464249836;
	j946548047 [label="Evaluate expressions",color=orange];
		j946548047 -> j3985335736 [label="MarieEntratiFamily",color=purple];
		j946548047 -> j2813887017 [label="MarieEntratiMonster1",color=purple];
		j946548047 -> j2813887017 [label="MarieEntratiMonster2",color=purple];
		j946548047 -> j4168165696 [label="MarieEntratiFan1",color=purple];
		j946548047 -> j4168165696 [label="MarieEntratiFan2",color=purple];
		j946548047 -> j2129025758 [label="MarieEntratiNeutral",color=purple];
		j946548047 -> j2820969652 [label="false",color=purple];
	j1429852767 [label="¡Aún así, eso no le da el derecho! No sé si se da cuenta de lo mucho que me hirieron sus palabras. En outre -",shape=box,color=blue];
		j1429852767 -> j946548047;
	j2464249836 [label="Merci, no sé si él sabe cuanto me lastimaron sus palabras.",shape=box,color=blue];
		j2464249836 -> j3460712993;
		j2464249836 -> j1518535895;
		j2464249836 -> j2115893523;
	j3985335736 [label="Si esta es la bienvenida que le espera a le Cardinal a su regreso, ¡no es de extrañar que se mantenga alejado!",shape=box,color=blue];
		j3985335736 -> j1596527909;
		j3985335736 -> j3632603418;
	j2813887017 [label="Y estoy segura de que estás del lado de M'sieur Tagfer en todo esto, non ? Crees que le Cardinal es un monstruo igual que la bestia.",shape=box,color=blue];
		j2813887017 -> j1596527909;
		j2813887017 -> j299871322;
	j4168165696 [label="Estoy sorprendida, je pensais que tu étais de mon côté ! ¿No estabas de mi lado para defender la causa de le Cardinal hace un momento?",shape=box,color=blue];
		j4168165696 -> j482428488;
	j2129025758 [label="Como dijiste antes: ¿qué importa? Debemos servirle en sus obras y juzgarlo después. Esta pelea no tiene sentido, non ?",shape=box,color=blue];
		j2129025758 -> j4212965838;
		j2129025758 -> j4160562209;
	j2820969652 [label="Sé que fueron creados por el Vacío a manos de le Cardinal. Todos hemos recibido dones de le Cardinal que son una maldición si los vemos con el corazón roto.",shape=box,color=blue];
		j2820969652 -> j1531515522;
	j3460712993 [label="¿Y tú sabes qué tanto lo heriste? ¿Conoces toda su historia?",shape=box,color=red];
		j3460712993 -> j2820969652;
	j1518535895 [label="Y lo que dijiste lo lastimó igual.",shape=box,color=red];
		j1518535895 -> j1234278562;
	j2115893523 [label="Sinceramente estoy de tu lado, pero... tenemos que intentar mantener la paz, Marie.",shape=box,color=red];
		j2115893523 -> j1020634956;
		j2115893523 -> j3176062434;
	j1596527909 [label="Marie, por favor. No intento pelear. Solo intento que entiendas por lo que han pasado.",shape=box,color=red];
		j1596527909 -> j2522307790;
	j3632603418 [label="Si Entrati se hubiera quedado para ayudar a limpiar sus propios desastres, tendría más amigos en este mundo.",shape=box,color=red];
		j3632603418 -> j4003142025;
	j299871322 [label="Sí, me pongo de su lado. Porque no estás escuchando razones. Tienes que entender que \"le Cardinal\" no es lo que parece.",shape=box,color=red];
		j299871322 -> j2522307790;
	j482428488 [label="¿Ha sido esto un gran engaño? ¿Has estado jugando un jeu con la pequeña Marie?",shape=box,color=blue];
		j482428488 -> j3833127883;
		j482428488 -> j1179127599;
	j4212965838 [label="Importa si no queda nadie a nuestro alrededor cuando estemos al otro lado de esto. Han pasado por mucho.",shape=box,color=red];
		j4212965838 -> j2522307790;
	j4160562209 [label="Te aseguro que lo olvidará. Y sé que tú también.",shape=box,color=red];
		j4160562209 -> j3384704132;
	j1531515522 [label="¡Nos abandonó a todos! Dime, ¿cómo es que a ellos les hizo tanto daño que debo tolerar tal odio?",shape=box,color=blue];
		j1531515522 -> j1639327012;
	j1234278562 [label="Oui ?! ¡Entonces dime por qué!",shape=box,color=blue];
		j1234278562 -> j2820969652;
	j1020634956 [label="La situación por la que han pasado los Cavia ha sido... dura.",shape=box,color=red];
		j1020634956 -> j2820969652;
	j3176062434 [label="Son animales, aunque se les haya dado inteligencia, siguen siendo animales. Tienen un límite en su capacidad.",shape=box,color=red];
		j3176062434 -> j986361977;
	j2522307790 [label="Oui ? ¡Entonces interpreta el papel de La Lumière Sacrée de Sol y acaba con la oscuridad! ¡Ilumina a la pequeña ingenua Marie!",shape=box,color=blue];
		j2522307790 -> j2820969652;
	j4003142025 [label="Oui ! Sí, no basta con que intente salvar el universo conocido de un dios del Vacío, non ?",shape=box,color=blue];
		j4003142025 -> j1812282610;
	j3833127883 [label="No, no miento. Estoy de tu lado. Solo digo que su situación ha sido... difícil.",shape=box,color=red];
		j3833127883 -> j2522307790;
	j1179127599 [label="No, no es un juego, exactamente... No se puede confiar en Entrati, y no sé cómo convencerte más que fingiendo estar de tu lado.",shape=box,color=red];
		j1179127599 -> j2719961087;
	j3384704132 [label="Non ! Tú iniciaste esta conversación y la continuarás. Explique !",shape=box,color=blue];
		j3384704132 -> j2820969652;
	j1639327012 [label="Evaluate expressions",color=orange];
		j1639327012 -> j2752265735 [label="MarieFamily2",color=purple];
		j1639327012 -> j3538595557 [label="MarieFamily2",color=purple];
