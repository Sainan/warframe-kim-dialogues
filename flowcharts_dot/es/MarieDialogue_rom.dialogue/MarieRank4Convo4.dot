		j1639327012 -> j2348505941 [label="MarieInfestation",color=purple];
		j1639327012 -> j2752265735 [label="MarieLyonSuffering2",color=purple];
		j1639327012 -> j3667856792 [label="MarieLyonSuffering2",color=purple];
		j1639327012 -> j2752265735 [label="MarrieLyonSuffering3",color=purple];
		j1639327012 -> j2752265735 [label="false",color=purple];
	j986361977 [label="Si intentas inspirarme para que, en cambio, simpatice con ellos y dirija mi ira hacia ti, de repente me siento tentada.",shape=box,color=blue];
		j986361977 -> j1812282610;
	j1812282610 [label="Quizás sea mejor que lo dejemos aquí. Antes de que los ánimos se salgan de control.",shape=box,color=blue];
		j1812282610 -> "Chat ends.";
	j2719961087 [label="Oui ? Bueno, me alegra decirte que has fracasado.",shape=box,color=blue];
		j2719961087 -> j1509439757;
	j2752265735 [label="Los Cavia fueron accidentes creados a partir de experimentos. Animales de laboratorio que nunca estuvieron destinados a existir. El Vacío les dio inteligencia.",shape=box,color=red];
		j2752265735 -> j2228617336;
	j3538595557 [label="Tú misma dijiste: \"Es la máxima crueldad carecer de nombre.\" Entrati nunca se molestó en nombrarlos; ni ese valor tenían.",shape=box,color=red];
		j3538595557 -> j3356380360;
	j3266168732 [label="Me contaste la historia de cómo creciste en la calle. Cómo tu familia te echó porque no eras lo suficientemente buena para ellos.",shape=box,color=red];
		j3266168732 -> j1810339774;
	j2348505941 [label="Piensa en cómo te habrías sentido si simplemente te hubieran convertido en un protoframe contra tu voluntad y luego te hubieran abandonado.",shape=box,color=red];
		j2348505941 -> j2204175468;
	j3667856792 [label="¿Te imaginas cómo te sentirías si Entrati apareciera de repente, convirtiera a Lyon en un protoframe y lo abandonara?",shape=box,color=red];
		j3667856792 -> j186660358;
	j1509439757 [label="Boolean MarieEntratiFan1 is now false.",color=orange];
		j1509439757 -> j2631316640;
	j2228617336 [label="¿Y cuándo Entrati vio lo que había hecho? ¿Cuándo se dio cuenta de lo que había creado? ¿Estos pobres animales, hablando en lengua del Vacío, enfermos por la exposición?",shape=box,color=red];
		j2228617336 -> j1469652705;
	j3356380360 [label="Para él, solo eran cosas. Cosas para usar y tirar. \"¿Tagfer?\" Significa \"Etiquetar para desechar\".",shape=box,color=red];
		j3356380360 -> j404413823;
	j1810339774 [label="Tu familia pensaba que no valías nada.",shape=box,color=red];
		j1810339774 -> j676653293;
	j2204175468 [label="¿Te imaginas cómo habrías sido tener la Infestación en la sangre, sufrir y que a nadie le importara?",shape=box,color=red];
		j2204175468 -> j1088016135;
	j186660358 [label="¿Si lo hubiera usado como un experimento científico barato y luego se deshiciera de él? Ustedes se tenían el uno al otro como apoyo antes y después de cambiar. Los Cavia no.",shape=box,color=red];
		j186660358 -> j590911298;
	j2631316640 [label="Boolean MarieEntratiFan2 is now false.",color=orange];
		j2631316640 -> j1508231473;
	j1469652705 [label="No le importó. ",shape=box,color=red];
		j1469652705 -> j1476939141;
	j404413823 [label="¿Bird 3? Es un pájaro con un número como nombre. Fibonacci se nombró a sí mismo.",shape=box,color=red];
		j404413823 -> j4178850601;
	j676653293 [label="Eso era lo que los Cavia eran para Entrati. Animales de laboratorio desechables. \"¿Tagfer?\" Significa \"Etiqueta para desechar\".",shape=box,color=red];
		j676653293 -> j404413823;
	j1088016135 [label="¿Que tu sufrimiento ni siquiera importara? Los Cavia eran, son, inútiles para Entrati. Animales de laboratorio desechables. \"¿Tagfer?\" Significa \"Etiquetar para desechar\".",shape=box,color=red];
		j1088016135 -> j404413823;
	j590911298 [label="Para Entrati, los Cavia eran solo animales de laboratorio desechables. Inútiles. \"¿Tagfer?\" Significa \"Etiquetar para desechar\".",shape=box,color=red];
		j590911298 -> j404413823;
	j1508231473 [label="Boolean MarieNoDate is now true.",color=orange];
		j1508231473 -> "Chat ends.";
	j1476939141 [label="Eso era lo que los Cavia eran para Entrati. Desechables. \"¿Tagfer?\" Significa \"Etiqueta para desechar\".",shape=box,color=red];
		j1476939141 -> j2064360543;
	j4178850601 [label="Usados en un experimento del Vacío. Supervivientes de una larga lista de animales muertos. Nunca se pretendió que existieran.",shape=box,color=red];
		j4178850601 -> j652394286;
	j2064360543 [label="El último de su especie. Etiquetado para desechar. ¿Su pareja? ¿Minn? ¿El único otro que quedaba? Murió en el experimento.",shape=box,color=red];
		j2064360543 -> j720859170;
	j652394286 [label="Es solo gracias a Loid que siguen vivos. Los preservó porque no pudo decidirse a sacrificarlos \"por orden de Entrati\".",shape=box,color=red];
		j652394286 -> j2095830843;
	j720859170 [label="Por eso estaba enojado, Marie. Por eso odia a Entrati. Y probablemente siempre lo hará.",shape=box,color=red];
		j720859170 -> j2433363310;
	j2095830843 [label="Ah, ¿y Tagfer? Es el último de su especie. ¿Su compañera, Minn? ¿La única otra que quedaba? Murió en el experimento.",shape=box,color=red];
		j2095830843 -> j2112091047;
	j2433363310 [label="Boolean MarieEntrati3b is now true.",color=orange];
		j2433363310 -> j828779566;
		j2433363310 -> j2473152857;
	j2112091047 [label="Por eso estaba enojado, Marie. Por eso odia a Entrati. Y probablemente siempre lo hará.",shape=box,color=red];
		j2112091047 -> j2070717389;
	j828779566 [label="Sé que crees que está haciendo lo que piensa que debe hacer. Y sé que crees en el perdón. Yo también. Pero tienes que entender por qué para algunas personas no es posible. Al menos no todavía.",shape=box,color=red];
		j828779566 -> j4004690457;
