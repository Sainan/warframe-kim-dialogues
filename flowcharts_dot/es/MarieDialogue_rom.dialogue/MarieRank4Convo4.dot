		2344 -> 2350 [label="false",color=purple];
	2345 [label="¡Aún así, eso no le da el derecho! No sé si se da cuenta de lo mucho que me hirieron sus palabras. En outre -",shape=box,color=blue];
		2345 -> 2344;
	2346 [label="Merci, no sé si él sabe cuanto me lastimaron sus palabras.",shape=box,color=blue];
		2346 -> 2352;
		2346 -> 2353;
		2346 -> 2354;
	2347 [label="Si esta es la bienvenida que le espera a le Cardinal a su regreso, ¡no es de extrañar que se mantenga alejado!",shape=box,color=blue];
		2347 -> 2355;
		2347 -> 2356;
	2348 [label="Y estoy segura de que estás del lado de M'sieur Tagfer en todo esto, non ? Crees que le Cardinal es un monstruo igual que la bestia.",shape=box,color=blue];
		2348 -> 2357;
		2348 -> 2358;
	2349 [label="Estoy sorprendida, je pensais que tu étais de mon côté ! ¿No estabas de mi lado para defender la causa de le Cardinal hace un momento?",shape=box,color=blue];
		2349 -> 2359;
	2351 [label="Como dijiste antes: ¿qué importa? Debemos servirle en sus obras y juzgarlo después. Esta pelea no tiene sentido, non ?",shape=box,color=blue];
		2351 -> 2361;
		2351 -> 2362;
	2350 [label="Sé que fueron creados por el Vacío a manos de le Cardinal. Todos hemos recibido dones de le Cardinal que son una maldición si los vemos con el corazón roto.",shape=box,color=blue];
		2350 -> 2360;
	2352 [label="¿Y tú sabes qué tanto lo heriste? ¿Conoces toda su historia?",shape=box,color=red];
		2352 -> 2350;
	2353 [label="Y lo que dijiste lo lastimó igual.",shape=box,color=red];
		2353 -> 2363;
	2354 [label="Sinceramente estoy de tu lado, pero... tenemos que intentar mantener la paz, Marie.",shape=box,color=red];
		2354 -> 2364;
		2354 -> 2365;
	2355 [label="Marie, por favor. No intento pelear. Solo intento que entiendas por lo que han pasado.",shape=box,color=red];
		2355 -> 2366;
	2356 [label="Si Entrati se hubiera quedado para ayudar a limpiar sus propios desastres, tendría más amigos en este mundo.",shape=box,color=red];
		2356 -> 2367;
	2357 [label="Marie, por favor. No intento pelear. Solo intento que entiendas por lo que han pasado.",shape=box,color=red];
		2357 -> 2366;
	2358 [label="Sí, me pongo de su lado. Porque no estás escuchando razones. Tienes que entender que \"le Cardinal\" no es lo que parece.",shape=box,color=red];
		2358 -> 2366;
	2359 [label="¿Ha sido esto un gran engaño? ¿Has estado jugando un jeu con la pequeña Marie?",shape=box,color=blue];
		2359 -> 2368;
		2359 -> 2369;
	2361 [label="Importa si no queda nadie a nuestro alrededor cuando estemos al otro lado de esto. Han pasado por mucho.",shape=box,color=red];
		2361 -> 2366;
	2362 [label="Te aseguro que lo olvidará. Y sé que tú también.",shape=box,color=red];
		2362 -> 2371;
	2360 [label="¡Nos abandonó a todos! Dime, ¿cómo es que a ellos les hizo tanto daño que debo tolerar tal odio?",shape=box,color=blue];
		2360 -> 2370;
	2363 [label="Oui ?! ¡Entonces dime por qué!",shape=box,color=blue];
		2363 -> 2350;
	2364 [label="La situación por la que han pasado los Cavia ha sido... dura.",shape=box,color=red];
		2364 -> 2350;
	2365 [label="Son animales, aunque se les haya dado inteligencia, siguen siendo animales. Tienen un límite en su capacidad.",shape=box,color=red];
		2365 -> 2372;
	2366 [label="Oui ? ¡Entonces interpreta el papel de La Lumière Sacrée de Sol y acaba con la oscuridad! ¡Ilumina a la pequeña ingenua Marie!",shape=box,color=blue];
		2366 -> 2350;
	2367 [label="Oui ! Sí, no basta con que intente salvar el universo conocido de un dios del Vacío, non ?",shape=box,color=blue];
		2367 -> 2373;
