	2297 [label="Roathe.",shape=box,color=red];
		2297 -> 2293;
	2298 [label="Si je le pouvais, je prendrais ce couteau qu'il aime tant utiliser pour agacer les autres et je le fourrerais là où seule Lua peut le voir !",shape=box,color=blue];
		2298 -> 2301;
	2299 [label="Creo que sí, pero pienso que no quieres arruinar mi ánimo. Así que... no te presionaré para que me cuentes más.",shape=box,color=blue];
		2299 -> 2302;
	2300 [label="Creo que estás mintiendo para no molestarme, así que... no te presionaré.",shape=box,color=blue];
		2300 -> 2302;
	2301 [label="Perdóname. Eso fue... inapropiado. Soy una Sœur de Sol y no debo perder los estribos ni hablar de esa manera.",shape=box,color=blue];
		2301 -> 2303;
	2302 [label="+5 Chemistry",color=orange];
		2302 -> 2304;
	2303 [label="+5 Chemistry",color=orange];
		2303 -> 2305;
	2304 [label="Deseo conservar la poca dignidad que se me permita en esta conversación.",shape=box,color=blue];
		2304 -> 2306;
	2305 [label="Mi enojo no va dirigido a ti. Y siempre agradezco tu honestidad.",shape=box,color=blue];
		2305 -> 2307;
	2306 [label="Si vienes a hablar conmigo sobre la discusión que tuve con M'sieur Tagfer, no negaré que ocurrió.",shape=box,color=blue];
		2306 -> 2307;
	2307 [label="¿Supongo que el diablo te dijo de qué se trataba la pelea?",shape=box,color=blue];
