		3690 -> 3701;
	3689 [label="Merci, merci, merci, mon coeur !",shape=box,color=blue];
		3689 -> 3700;
	3688 [label="Merci, merci, merci !",shape=box,color=blue];
		3688 -> 3700;
	3687 [label="¡Bueno! Cuando llegue el momento, estaré lista y esperando. Hasta entonces, merci, mon cœur.",shape=box,color=blue];
		3687 -> 3699;
	3686 [label="¡Bueno! Cuando llegue el momento, estaré lista y esperando. Hasta entonces, merci.",shape=box,color=blue];
		3686 -> 3699;
	3697 [label="Simplemente me alegra que seas feliz. Y si el diablo tiene dónde enfocar sus... esfuerzos... mejor aún, non ?",shape=box,color=blue];
		3697 -> 3708;
	3698 [label="Jamás insinuaría que, puesto que el diablo te favorece, quizá te escuche a ti aunque ignore a todos los demás.",shape=box,color=blue];
		3698 -> 3709;
	3692 [label="Todos en su vida han intentado convertirlo en una especie de monstruo. Supongo que soy la primera persona que no lo ha hecho.",shape=box,color=red];
		3692 -> 3703;
	3693 [label="Hay muchas cosas de él que simplemente no sabe cómo mostrar. No es realmente una armadura, sino que no confía en que la gente no le haga daño.",shape=box,color=red];
		3693 -> 3704;
	3695 [label="Él... ha sufrido mucho en su vida. Simplemente le quedaron cicatrices.",shape=box,color=red];
		3695 -> 3706;
	3696 [label="Supongo que puedo comprender la cantidad de años que ha vivido. He visto la misma cantidad de muerte que él.",shape=box,color=red];
		3696 -> 3707;
	3694 [label="Siempre intentó hacer lo correcto. Quizás de la manera equivocada, claro, pero intentaba salvar el Sistema Origen de los Orokin.",shape=box,color=red];
		3694 -> 3705;
	3691 [label="Me gusta su humor irónico. Es inteligente, cuando logras superar su ego.",shape=box,color=red];
		3691 -> 3702;
	3701 [label="Chat ends.",color=orange];
	3700 [label="¡Bueno! Cuando llegue el momento, estaré lista y esperando. ¡Hasta entonces!",shape=box,color=blue];
		3700 -> 3711;
	3699 [label="Update boolean MarieFamilySuccess",color=orange];
		3699 -> 3710;
	3708 [label="Será mejor para nosotros si actúas como un pequeño ángel de la guarda sobre su hombro para calmarlo.",shape=box,color=blue];
		3708 -> 3716;
		3708 -> 3717;
	3709 [label="Y nunca durante momentos privados. Non. Jamais.",shape=box,color=blue];
		3709 -> 3718;
		3709 -> 3719;
	3703 [label="Y supongo que últimamente estoy en lo más alto de esa lista, non ? Supongo que debería... considerar sus razones, para entender por qué es como es. La condena no salva almas.",shape=box,color=blue];
		3703 -> 3713;
	3704 [label="Siempre hay un dolor que ocultamos a quienes nos rodean. Algo que buscamos proteger, por temor a que otros lo utilicen en nuestra contra. Supongo que debería esforzarme por ser más amable con él, si lo que dices es cierto.",shape=box,color=blue];
		3704 -> 3713;
	3706 [label="No puedo imaginar la cantidad de amor y pérdida que uno debe sufrir en todos esos años. Parece tan irreal, incluso después de todo lo que he visto.",shape=box,color=blue];
		3706 -> 3714;
	3707 [label="A veces, cuando hablo con él, olvido cuántos siglos ha vivido. Parece tan irreal, incluso después de todo lo que he visto.",shape=box,color=blue];
		3707 -> 3715;
	3705 [label="Siempre hay... matices, oui ? Siempre hay razones para actuar de una forma u otra. Supongo que debería esforzarme por ser más amable con él, si lo que dices es cierto.",shape=box,color=blue];
		3705 -> 3713;
	3702 [label="Nadie jamás ha negado el ingenio del diablo.",shape=box,color=blue];
		3702 -> 3712;
	3711 [label="Update boolean MarieFamilySuccess",color=orange];
		3711 -> 3721;
	3710 [label="Update boolean MarieRank5Convo4Complete",color=orange];
		3710 -> 3720;
	3716 [label="¿Quién dice que estoy intentando calmarlo?",shape=box,color=red];
		3716 -> 3723;
	3717 [label="No puedo prometer nada.",shape=box,color=red];
		3717 -> 3724;
	3718 [label="Nunca imaginé que tuvieras este lado.",shape=box,color=red];
		3718 -> 3684;
	3719 [label="Me sorprendes. Es impresionante. ",shape=box,color=red];
		3719 -> 3684;
	3713 [label="+10 Chemistry",color=orange];
		3713 -> 3722;
	3714 [label="Oui, ¿qué daño podría causar eso a un alma? Entiendo por qué querrías encontrar a alguien que te comprendiera. Y él, a ti.",shape=box,color=blue];
		3714 -> 3713;
	3715 [label="Haber vivido tanto tiempo, haber visto tanta muerte y haber pagado un costo tan alto.",shape=box,color=blue];
		3715 -> 3714;
	3712 [label="+5 Chemistry",color=orange];
		3712 -> 3722;
	3721 [label="Update boolean MarieRank5Convo4Complete",color=orange];
		3721 -> 3725;
	3720 [label="Chat ends.",color=orange];
	3723 [label="Add -1 to Thermostat",color=orange];
		3723 -> 3726;
	3724 [label="Add 1 to Thermostat",color=orange];
		3724 -> 3727;
	3722 [label="Simplemente me alegra que el diablo tenga con quién hablar, alguien que intente calmarlo. Un ángel sobre su hombro.",shape=box,color=blue];
		3722 -> 3716;
		3722 -> 3717;
	3725 [label="Chat ends.",color=orange];
	3726 [label="+10 Chemistry",color=orange];
		3726 -> 3728;
	3727 [label="+10 Chemistry",color=orange];
		3727 -> 3729;
	3728 [label="Quizás tengas razón... ¿qué es un ángel sin su diablo? Nos recuerda a todos lo que debemos esforzarnos por evitar.",shape=box,color=blue];
		3728 -> 3730;
	3729 [label="Sí, me temo que hay en él una maldad que no se puede curar del todo. La disfruta demasiado.",shape=box,color=blue];
		3729 -> 3730;
	3730 [label="¡Bien! Si algún día convences al diablo de que nos ayude en nuestra misión, estaré lista y esperando. ¡Hasta entonces!",shape=box,color=blue];
