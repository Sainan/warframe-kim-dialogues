	3665 [label="He juzgado muy mal a nuestro demonio...",shape=box,color=blue];
		3665 -> 3673;
	3663 [label="Oui. Al menos estás aquí para asegurarnos de que no dé rienda suelta a sus... instintos más bajos.",shape=box,color=blue];
