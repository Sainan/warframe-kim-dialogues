		j148501058 -> j2484394348 [label="false",color=purple];
	j474528237 [label="He estado pensando en cómo convencer a Loid de que suba esas escaleras para hablar finalmente con la familia, y... tengo una idea, pero no creo que te guste.",shape=box,color=red];
		j474528237 -> j3431982611;
	j3072611880 [label="¿Has pensado más en cómo convencer a Loid de que hable con la familia Entrati de arriba?",shape=box,color=red];
		j3072611880 -> j2607534784;
	j2113743668 [label="En cuanto al tema de intentar que Loid y la familia Entrati hablen, me preguntaba... ¿si has reconsiderado la participación de Roathe?",shape=box,color=red];
		j2113743668 -> j1903226774;
	j2400065303 [label="Marie, ¿todavía estás dispuesta a... tal vez intentar convencer a Loid de que hable con los \"vecinos de arriba\"? Sé que dejamos eso en una nota extraña.",shape=box,color=red];
		j2400065303 -> j1903226774;
	j2484394348 [label="He estado pensando en cómo Monsieur Loid tiene tanto miedo de hablar con la familia de le Cardinal.",shape=box,color=blue];
		j2484394348 -> j4111421653;
	j3431982611 [label="Check boolean MarieDating",color=orange];
		j3431982611 -> j3636034966 [label=true,color=green];
		j3431982611 -> j3312190531 [label=false,color=brown];
	j2607534784 [label="Check boolean MarieDating",color=orange];
		j2607534784 -> j1474900941 [label=true,color=green];
		j2607534784 -> j1474900941 [label=false,color=brown];
	j1903226774 [label="Check boolean MarieDating",color=orange];
		j1903226774 -> j3829674571 [label=true,color=green];
		j1903226774 -> j1667025322 [label=false,color=brown];
	j4111421653 [label="Y cómo debemos superar este estancamiento. Este purgatorio en el que estamos atrapados no debería persistir. Parece tan innecesariamente doloroso.",shape=box,color=blue];
		j4111421653 -> j1700491260;
	j3636034966 [label="Bonjour, mon cœur ! ¿Y qué es lo que piensas que no me gustará?",shape=box,color=blue];
		j3636034966 -> j184283923;
	j3312190531 [label="Bonjour ! ¿Oh? ¿Y qué es lo que piensas que no me gustará?",shape=box,color=blue];
		j3312190531 -> j184283923;
	j1474900941 [label="Bonjour mon cœur ! Lo he pensado, oui... y verdaderamente me cuesta admitirlo. No me complace decirlo.",shape=box,color=blue];
		j1474900941 -> j1862102624;
	j3829674571 [label="Bonjour, bonjour, mon cœur ! Lo he pensado, oui... y verdaderamente me cuesta admitirlo. No me complace decirlo.",shape=box,color=blue];
		j3829674571 -> j1260043248;
	j1667025322 [label="Bonjour. Lo he pensado, oui... y verdaderamente me cuesta admitirlo. No me complace decirlo.",shape=box,color=blue];
		j1667025322 -> j1260043248;
	j1700491260 [label="Pero siento que necesitamos... algún tipo de bastión, non ? ¿Tienes alguna idea?",shape=box,color=blue];
		j1700491260 -> j2008842742;
		j1700491260 -> j184283923;
	j184283923 [label="Creo que quizá necesitemos la ayuda de Roathe para convencer a Loid de que hable con la familia Entrati. No creo que lo haga de otra manera, sin garantías de que la familia, y él mismo, estén protegidos.",shape=box,color=red];
		j184283923 -> j2513533464;
	j1862102624 [label="Pero creo... creo —ay, Sol, perdóname— que quizá necesitemos la ayuda del diablo. No creo que Monsieur Loid nos escuche de otra manera.",shape=box,color=blue];
		j1862102624 -> j3930214259;
	j1260043248 [label="Creo que tienes razón. El diablo podría ser la pieza que nos falta. ¡Ay, me duele incluso escribir estas palabras! ",shape=box,color=blue];
		j1260043248 -> j636489540;
	j2008842742 [label="Realmente no se me ocurre nada que no implique la ayuda de recursos terribles. Recursos que podrían meternos en serios problemas más adelante. Es decir, Roathe.",shape=box,color=red];
		j2008842742 -> j2031645241;
	j2513533464 [label="Odio admitirlo, pero creo que puede que tengas razón... Sol, perdóname.",shape=box,color=blue];
		j2513533464 -> j636489540;
	j3930214259 [label="El diablo es poderoso y podría ser útil si las cosas salen mal, non ?",shape=box,color=blue];
		j3930214259 -> j2518674894;
		j3930214259 -> j1744657155;
	j636489540 [label="Evaluate expressions",color=orange];
		j636489540 -> j3083964327 [label="RoatheFamilyFail",color=purple];
		j636489540 -> j1110785586 [label="RoatheRedeemed, RoatheFamilyDelay
",color=purple];
		j636489540 -> j1110785586 [label="RoatheRedeemed, RoatheFamilySuccess
",color=purple];
		j636489540 -> j2152938383 [label="RoatheVillain, RoatheFamilyDelay
",color=purple];
		j636489540 -> j2152938383 [label="RoatheVillain, RoatheFamilySuccess",color=purple];
		j636489540 -> j2282133876 [label="false",color=purple];
	j2031645241 [label="¿Lo piensas realmente? Si yo puedo dejar de lado mis diferencias con el diablo, tú también puedes, non ?",shape=box,color=blue];
		j2031645241 -> j3135274573;
		j2031645241 -> j3857671190;
	j2518674894 [label="No, tiene que haber otra manera. Me niego a pedirle ayuda.",shape=box,color=red];
		j2518674894 -> j2031645241;
	j1744657155 [label="Tienes razón. No pensé que aceptarías. Tenía miedo de preguntar.",shape=box,color=red];
		j1744657155 -> j636489540;
	j3083964327 [label="¿Nos ayudará con esta situación?",shape=box,color=blue];
		j3083964327 -> j3821290996;
	j1110785586 [label="¿Nos ayudará con esta situación?",shape=box,color=blue];
		j1110785586 -> j2625985474;
	j2152938383 [label="¿Nos ayudará con esta situación?",shape=box,color=blue];
		j2152938383 -> j238511382;
	j2282133876 [label="¿Crees que podrás convencerlo para que nos ayude?",shape=box,color=blue];
		j2282133876 -> j3182756623;
		j2282133876 -> j3929125867;
	j3135274573 [label="No, lo siento. ",shape=box,color=red];
		j3135274573 -> j2808156989;
	j3857671190 [label="De acuerdo. Si a ti te parece bien, a mí también.",shape=box,color=red];
		j3857671190 -> j2227718521;
	j3821290996 [label="No, desafortunadamente... creo que eso no tendrá solución. ¿Crees que haya otra manera?",shape=box,color=red];
		j3821290996 -> j975296399;
	j2625985474 [label="Lo hará. Lo convencí para que ayude a reunirlos y aunque no lo creas, pienso que es para que pueda proteger a la familia Entrati. Al fin y al cabo, son todo lo que queda de los Orokin.",shape=box,color=red];
		j2625985474 -> j4012337532;
	j238511382 [label="Lo hará. Lo convencí para que ayude a reunirlos, y esto no te sorprenderá, creo que es principalmente para fastidiar a Albrecht en su ausencia.",shape=box,color=red];
		j238511382 -> j1580987424;
	j3182756623 [label="Todavía no hay nada decidido. Él es... bueno, ya sabes cómo es.",shape=box,color=red];
		j3182756623 -> j2913252443;
	j3929125867 [label="Todavía estoy trabajando en ello, pero creo que sí.",shape=box,color=red];
		j3929125867 -> j1104176810;
	j2808156989 [label="+20 Chemistry",color=orange];
		j2808156989 -> j3473852989;
	j2227718521 [label="Sí, no tengo por qué disfrutarlo, pero supongo que es un mal que debemos soportar.",shape=box,color=blue];
		j2227718521 -> j636489540;
	j975296399 [label="¡Oh! Qué lástima... No sé, no lo creo... ¿Se te ocurre otra forma de lidiar con el diablo? ¿O alguna manera de intentarlo de nuevo?",shape=box,color=blue];
		j975296399 -> j654849689;
	j4012337532 [label="Está ayudando a proteger a la familia del hombre que lo convirtió en protoframe contra su voluntad y lo envió al pasado, robándole sus recuerdos...",shape=box,color=blue];
		j4012337532 -> j1466639960;
	j1580987424 [label="Tienes razón, no me sorprende.",shape=box,color=blue];
		j1580987424 -> j1733464408;
		j1580987424 -> j4258772158;
	j2913252443 [label="Check boolean RoatheDating",color=orange];
		j2913252443 -> j2647196305 [label=true,color=green];
		j2913252443 -> j2861059051 [label=false,color=brown];
	j1104176810 [label="Check boolean RoatheDating",color=orange];
		j1104176810 -> j2268300534 [label=true,color=green];
		j1104176810 -> j161290397 [label=false,color=brown];
	j3473852989 [label="Entonces, yo también apoyaré tu decisión.",shape=box,color=blue];
		j3473852989 -> j1179567760;
	j654849689 [label="Mientras tanto hablaré con Lyon, pero no tengo muchas esperanzas.",shape=box,color=blue];
		j654849689 -> j2417620378;
	j1466639960 [label="+20 Chemistry",color=orange];
		j1466639960 -> j2419117094;
	j1733464408 [label="Al menos ayudará. Y me aseguraré de que no cumpla sus amenazas.",shape=box,color=red];
		j1733464408 -> j636403627;
	j4258772158 [label="Creo que es solo una excusa para ocultar sus intenciones.",shape=box,color=red];
		j4258772158 -> j188352885;
	j2647196305 [label="Oui, lo sé. Creo que tienes una manera especial de convencerlo, aunque todos los demás han fracasado, non ?",shape=box,color=blue];
		j2647196305 -> j396875364;
		j2647196305 -> j1393850422;
	j2861059051 [label="Oui, lo sé. Ese diablo puede ser muy obstinado incluso en el mejor de los casos. ¡A veces creo que simplemente disfruta llevando la contraria!",shape=box,color=blue];
		j2861059051 -> j4023744638;
		j2861059051 -> j652837614;
	j2268300534 [label="Creo que tienes una manera especial de convencerlo, aunque todos los demás han fracasado, non ?",shape=box,color=blue];
		j2268300534 -> j396875364;
		j2268300534 -> j1393850422;
	j161290397 [label="Te deseo mucha suerte. Ese diablo puede ser muy obstinado incluso en el mejor de los casos. ¡A veces creo que simplemente disfruta llevar la contraria!",shape=box,color=blue];
		j161290397 -> j4023744638;
		j161290397 -> j652837614;
	j1179567760 [label="Boolean MarieFamilyFail is now true.",color=orange];
		j1179567760 -> j2605366984;
	j2417620378 [label="+20 Chemistry",color=orange];
		j2417620378 -> j3871220579;
	j2419117094 [label="He juzgado muy mal a nuestro demonio...",shape=box,color=blue];
		j2419117094 -> j2305704706;
	j636403627 [label="Oui. Al menos estás aquí para asegurarnos de que no dé rienda suelta a sus... instintos más bajos.",shape=box,color=blue];
		j636403627 -> j2198758823;
	j188352885 [label="Oui, espero que tengas razón.",shape=box,color=blue];
		j188352885 -> j2198758823;
	j396875364 [label="No quisiera utilizar mi relación con él como herramienta de negociación.",shape=box,color=red];
		j396875364 -> j1577599300;
	j1393850422 [label="¿Qué estás insinuando, Marie?",shape=box,color=red];
		j1393850422 -> j1925523537;
	j4023744638 [label="La verdad es que lo disfruto, por raro que parezca. Nos llevamos bien.",shape=box,color=red];
		j4023744638 -> j3664330993;
	j652837614 [label="Puede serlo, pero creo que mucho de eso es solo una fachada.",shape=box,color=red];
		j652837614 -> j3704129857;
	j2605366984 [label="Boolean MarieRank5Convo4Complete is now true.",color=orange];
		j2605366984 -> "Chat ends.";
	j3871220579 [label="¡El diablo es caprichoso! C'est la vie, como se dice!",shape=box,color=blue];
		j3871220579 -> j3569999725;
	j2305704706 [label="¡Y no soy una tonta como para no ver el rol que has tenido para que todo esto sucediera!",shape=box,color=blue];
		j2305704706 -> j3242583483;
	j2198758823 [label="Check boolean MarieDating",color=orange];
		j2198758823 -> j427037956 [label=true,color=green];
		j2198758823 -> j845597665 [label=false,color=brown];
	j1577599300 [label="¡Oh! ¡Eso no es lo que quería decir, pardonne-moi! Simplemente que pareces agradarle, ya que te presta atención aunque ignora a todos los demás.",shape=box,color=blue];
		j1577599300 -> j2669218704;
	j1925523537 [label="+5 Chemistry",color=orange];
		j1925523537 -> j1978258435;
	j3664330993 [label="Oui, sin duda parece que le agradas. ¿Será porque comparten tiempo y lugar, mientras que nosotros no? ¿Si no por qué?",shape=box,color=blue];
		j3664330993 -> j3822691405;
	j3704129857 [label="Oui ? ¿Qué quieres decir?",shape=box,color=blue];
		j3704129857 -> j3822691405;
	j3569999725 [label="Boolean MarieFamilySuccess is now true.",color=orange];
		j3569999725 -> j2605366984;
	j3242583483 [label="Check boolean MarieDating",color=orange];
		j3242583483 -> j3236627167 [label=true,color=green];
		j3242583483 -> j2834210961 [label=false,color=brown];
	j427037956 [label="+10 Chemistry",color=orange];
		j427037956 -> j3579142258;
	j845597665 [label="+10 Chemistry",color=orange];
		j845597665 -> j3710286165;
	j2669218704 [label="+5 Chemistry",color=orange];
		j2669218704 -> j2821983886;
	j1978258435 [label="¡Por supuesto que no tengo ni idea de a qué te refieres! No estoy insinuando nada en absoluto. Soy una inocente Sœur de Sol.",shape=box,color=blue];
		j1978258435 -> j792753276;
	j3822691405 [label="Evaluate expressions",color=orange];
		j3822691405 -> j3673930557 [label="RoatheVillain",color=purple];
		j3822691405 -> j1965027151 [label="RoatheRedeemed",color=purple];
		j3822691405 -> j3993725918 [label="RoatheUnloved3",color=purple];
		j3822691405 -> j253001896 [label="RoatheTraitor2",color=purple];
		j3822691405 -> j1880283365 [label="RoatheExecutor2",color=purple];
		j3822691405 -> j3788454587 [label="false",color=purple];
	j3236627167 [label="Merci, merci, merci, mon coeur !",shape=box,color=blue];
		j3236627167 -> j1749359336;
	j2834210961 [label="Merci, merci, merci !",shape=box,color=blue];
		j2834210961 -> j1749359336;
	j3579142258 [label="¡Bueno! Cuando llegue el momento, estaré lista y esperando. Hasta entonces, merci, mon cœur.",shape=box,color=blue];
		j3579142258 -> j3569999725;
	j3710286165 [label="¡Bueno! Cuando llegue el momento, estaré lista y esperando. Hasta entonces, merci.",shape=box,color=blue];
		j3710286165 -> j3569999725;
	j2821983886 [label="Simplemente me alegra que seas feliz. Y si el diablo tiene dónde enfocar sus... esfuerzos... mejor aún, non ?",shape=box,color=blue];
		j2821983886 -> j4023628031;
	j792753276 [label="Jamás insinuaría que, puesto que el diablo te favorece, quizá te escuche a ti aunque ignore a todos los demás.",shape=box,color=blue];
		j792753276 -> j272452530;
	j3673930557 [label="Todos en su vida han intentado convertirlo en una especie de monstruo. Supongo que soy la primera persona que no lo ha hecho.",shape=box,color=red];
		j3673930557 -> j1746298954;
	j1965027151 [label="Hay muchas cosas de él que simplemente no sabe cómo mostrar. No es realmente una armadura, sino que no confía en que la gente no le haga daño.",shape=box,color=red];
		j1965027151 -> j2540826560;
	j3993725918 [label="Él... ha sufrido mucho en su vida. Simplemente le quedaron cicatrices.",shape=box,color=red];
		j3993725918 -> j2932609704;
	j253001896 [label="Supongo que puedo comprender la cantidad de años que ha vivido. He visto la misma cantidad de muerte que él.",shape=box,color=red];
		j253001896 -> j227837107;
	j1880283365 [label="Siempre intentó hacer lo correcto. Quizás de la manera equivocada, claro, pero intentaba salvar el Sistema Origen de los Orokin.",shape=box,color=red];
		j1880283365 -> j3007094852;
	j3788454587 [label="Me gusta su humor irónico. Es inteligente, cuando logras superar su ego.",shape=box,color=red];
		j3788454587 -> j2681921868;
	j1749359336 [label="¡Bueno! Cuando llegue el momento, estaré lista y esperando. ¡Hasta entonces!",shape=box,color=blue];
		j1749359336 -> j3569999725;
	j4023628031 [label="Será mejor para nosotros si actúas como un pequeño ángel de la guarda sobre su hombro para calmarlo.",shape=box,color=blue];
		j4023628031 -> j3421355450;
		j4023628031 -> j551528546;
	j272452530 [label="Y nunca durante momentos privados. Non. Jamais.",shape=box,color=blue];
		j272452530 -> j4021288292;
		j272452530 -> j3321125614;
	j1746298954 [label="Y supongo que últimamente estoy en lo más alto de esa lista, non ? Supongo que debería... considerar sus razones, para entender por qué es como es. La condena no salva almas.",shape=box,color=blue];
		j1746298954 -> j3846539787;
	j2540826560 [label="Siempre hay un dolor que ocultamos a quienes nos rodean. Algo que buscamos proteger, por temor a que otros lo utilicen en nuestra contra. Supongo que debería esforzarme por ser más amable con él, si lo que dices es cierto.",shape=box,color=blue];
		j2540826560 -> j3846539787;
	j2932609704 [label="No puedo imaginar la cantidad de amor y pérdida que uno debe sufrir en todos esos años. Parece tan irreal, incluso después de todo lo que he visto.",shape=box,color=blue];
		j2932609704 -> j2833524527;
	j227837107 [label="A veces, cuando hablo con él, olvido cuántos siglos ha vivido. Parece tan irreal, incluso después de todo lo que he visto.",shape=box,color=blue];
		j227837107 -> j2378532225;
	j3007094852 [label="Siempre hay... matices, oui ? Siempre hay razones para actuar de una forma u otra. Supongo que debería esforzarme por ser más amable con él, si lo que dices es cierto.",shape=box,color=blue];
		j3007094852 -> j3846539787;
	j2681921868 [label="Nadie jamás ha negado el ingenio del diablo.",shape=box,color=blue];
		j2681921868 -> j132291245;
	j3421355450 [label="¿Quién dice que estoy intentando calmarlo?",shape=box,color=red];
		j3421355450 -> j471057229;
	j551528546 [label="No puedo prometer nada.",shape=box,color=red];
		j551528546 -> j3807763526;
	j4021288292 [label="Nunca imaginé que tuvieras este lado.",shape=box,color=red];
		j4021288292 -> j2669218704;
	j3321125614 [label="Me sorprendes. Es impresionante. ",shape=box,color=red];
		j3321125614 -> j2669218704;
	j3846539787 [label="+10 Chemistry",color=orange];
		j3846539787 -> j2890404668;
	j2833524527 [label="Oui, ¿qué daño podría causar eso a un alma? Entiendo por qué querrías encontrar a alguien que te comprendiera. Y él, a ti.",shape=box,color=blue];
		j2833524527 -> j3846539787;
	j2378532225 [label="Haber vivido tanto tiempo, haber visto tanta muerte y haber pagado un costo tan alto.",shape=box,color=blue];
		j2378532225 -> j2833524527;
	j132291245 [label="+5 Chemistry",color=orange];
		j132291245 -> j2890404668;
	j471057229 [label="Add -1 to Thermostat counter",color=orange];
		j471057229 -> j789136727;
	j3807763526 [label="Add 1 to Thermostat counter",color=orange];
		j3807763526 -> j3087528819;
	j2890404668 [label="Simplemente me alegra que el diablo tenga con quién hablar, alguien que intente calmarlo. Un ángel sobre su hombro.",shape=box,color=blue];
		j2890404668 -> j3421355450;
		j2890404668 -> j551528546;
	j789136727 [label="+10 Chemistry",color=orange];
		j789136727 -> j11689489;
	j3087528819 [label="+10 Chemistry",color=orange];
		j3087528819 -> j3262873294;
	j11689489 [label="Quizás tengas razón... ¿qué es un ángel sin su diablo? Nos recuerda a todos lo que debemos esforzarnos por evitar.",shape=box,color=blue];
		j11689489 -> j2865339209;
	j3262873294 [label="Sí, me temo que hay en él una maldad que no se puede curar del todo. La disfruta demasiado.",shape=box,color=blue];
		j3262873294 -> j2865339209;
	j2865339209 [label="¡Bien! Si algún día convences al diablo de que nos ayude en nuestra misión, estaré lista y esperando. ¡Hasta entonces!",shape=box,color=blue];
		j2865339209 -> j3569999725;
}