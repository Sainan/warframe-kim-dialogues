		3631 -> 3639 [label="false",color=purple];
	3628 [label="¿Lo piensas realmente? Si yo puedo dejar de lado mis diferencias con el diablo, tú también puedes, non ?",shape=box,color=blue];
		3628 -> 3632;
		3628 -> 3633;
	3634 [label="No, tiene que haber otra manera. Me niego a pedirle ayuda.",shape=box,color=red];
		3634 -> 3628;
	3635 [label="Tienes razón. No pensé que aceptarías. Tenía miedo de preguntar.",shape=box,color=red];
		3635 -> 3631;
	3638 [label="/Lotus/Language/1999Texting/MarieRomance/Marie_MarieRank6Convo3_3118 begins.",shape=box,color=blue];
		3638 -> 3644;
	3637 [label="¿Nos ayudará con esta situación?",shape=box,color=blue];
		3637 -> 3643;
	3636 [label="¿Nos ayudará con esta situación?",shape=box,color=blue];
		3636 -> 3642;
	3639 [label="¿Crees que podrás convencerlo para que nos ayude?",shape=box,color=blue];
		3639 -> 3645;
		3639 -> 3646;
	3632 [label="No, lo siento. ",shape=box,color=red];
		3632 -> 3640;
	3633 [label="De acuerdo. Si a ti te parece bien, a mí también.",shape=box,color=red];
		3633 -> 3641;
	3644 [label="No, desafortunadamente... creo que eso no tendrá solución. ¿Crees que haya otra manera?",shape=box,color=red];
		3644 -> 3650;
	3643 [label="Lo hará. Lo convencí para que ayude a reunirlos y aunque no lo creas, pienso que es para que pueda proteger a la familia Entrati. Al fin y al cabo, son todo lo que queda de los Orokin.",shape=box,color=red];
		3643 -> 3649;
	3642 [label="Lo hará. Lo convencí para que ayude a reunirlos, y esto no te sorprenderá, creo que es principalmente para fastidiar a Albrecht en su ausencia.",shape=box,color=red];
		3642 -> 3648;
	3645 [label="Todavía no hay nada decidido. Él es... bueno, ya sabes cómo es.",shape=box,color=red];
		3645 -> 3651;
	3646 [label="Todavía estoy trabajando en ello, pero creo que sí.",shape=box,color=red];
		3646 -> 3652;
	3640 [label="+20 Chemistry",color=orange];
		3640 -> 3647;
	3641 [label="Sí, no tengo por qué disfrutarlo, pero supongo que es un mal que debemos soportar.",shape=box,color=blue];
		3641 -> 3631;
	3650 [label="¡Oh! Qué lástima... No sé, no lo creo... ¿Se te ocurre otra forma de lidiar con el diablo? ¿O alguna manera de intentarlo de nuevo?",shape=box,color=blue];
		3650 -> 3657;
	3649 [label="Está ayudando a proteger a la familia del hombre que lo convirtió en protoframe contra su voluntad y lo envió al pasado, robándole sus recuerdos...",shape=box,color=blue];
