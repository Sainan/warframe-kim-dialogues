	3659 [label="Oui, lo sé. Creo que tienes una manera especial de convencerlo, aunque todos los demás han fracasado, non ?",shape=box,color=blue];
		3659 -> 3669;
		3659 -> 3670;
	3658 [label="Oui, lo sé. Ese diablo puede ser muy obstinado incluso en el mejor de los casos. ¡A veces creo que simplemente disfruta llevando la contraria!",shape=box,color=blue];
