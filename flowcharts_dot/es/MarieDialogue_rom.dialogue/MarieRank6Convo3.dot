	3672 [label="Check boolean MarieDating",color=orange];
		3672 -> 3680 [label=true,color=green];
		3672 -> 3679 [label=false,color=brown];
	3677 [label="¡Oh! ¡Eso no es lo que quería decir, pardonne-moi! Simplemente que pareces agradarle, ya que te presta atención aunque ignora a todos los demás.",shape=box,color=blue];
		3677 -> 3684;
	3678 [label="+5 Chemistry",color=orange];
		3678 -> 3685;
	3675 [label="Oui, sin duda parece que le agradas. ¿Será porque comparten tiempo y lugar, mientras que nosotros no? ¿Si no por qué?",shape=box,color=blue];
