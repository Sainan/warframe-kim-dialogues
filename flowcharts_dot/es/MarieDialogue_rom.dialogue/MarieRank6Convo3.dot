		3616 -> 3623 [label=true,color=green];
		3616 -> 3622 [label=false,color=brown];
	3613 [label="Y cómo debemos superar este estancamiento. Este purgatorio en el que estamos atrapados no debería persistir. Parece tan innecesariamente doloroso.",shape=box,color=blue];
		3613 -> 3617;
	3619 [label="Bonjour, mon cœur ! ¿Y qué es lo que piensas que no me gustará?",shape=box,color=blue];
		3619 -> 3625;
	3618 [label="Bonjour ! ¿Oh? ¿Y qué es lo que piensas que no me gustará?",shape=box,color=blue];
		3618 -> 3625;
	3621 [label="Bonjour mon cœur ! Lo he pensado, oui... y verdaderamente me cuesta admitirlo. No me complace decirlo.",shape=box,color=blue];
		3621 -> 3626;
	3620 [label="Bonjour mon cœur ! Lo he pensado, oui... y verdaderamente me cuesta admitirlo. No me complace decirlo.",shape=box,color=blue];
		3620 -> 3626;
	3623 [label="Bonjour, bonjour, mon cœur ! Lo he pensado, oui... y verdaderamente me cuesta admitirlo. No me complace decirlo.",shape=box,color=blue];
		3623 -> 3627;
	3622 [label="Bonjour. Lo he pensado, oui... y verdaderamente me cuesta admitirlo. No me complace decirlo.",shape=box,color=blue];
		3622 -> 3627;
	3617 [label="Pero siento que necesitamos... algún tipo de bastión, non ? ¿Tienes alguna idea?",shape=box,color=blue];
		3617 -> 3624;
		3617 -> 3625;
	3625 [label="Creo que quizá necesitemos la ayuda de Roathe para convencer a Loid de que hable con la familia Entrati. No creo que lo haga de otra manera, sin garantías de que la familia, y él mismo, estén protegidos.",shape=box,color=red];
		3625 -> 3629;
	3626 [label="Pero creo... creo —ay, Sol, perdóname— que quizá necesitemos la ayuda del diablo. No creo que Monsieur Loid nos escuche de otra manera.",shape=box,color=blue];
		3626 -> 3630;
	3627 [label="Creo que tienes razón. El diablo podría ser la pieza que nos falta. ¡Ay, me duele incluso escribir estas palabras! ",shape=box,color=blue];
		3627 -> 3631;
	3624 [label="Realmente no se me ocurre nada que no implique la ayuda de recursos terribles. Recursos que podrían meternos en serios problemas más adelante. Es decir, Roathe.",shape=box,color=red];
		3624 -> 3628;
	3629 [label="Odio admitirlo, pero creo que puede que tengas razón... Sol, perdóname.",shape=box,color=blue];
		3629 -> 3631;
	3630 [label="El diablo es poderoso y podría ser útil si las cosas salen mal, non ?",shape=box,color=blue];
		3630 -> 3634;
		3630 -> 3635;
	3631 [label="Evaluate expressions",color=orange];
