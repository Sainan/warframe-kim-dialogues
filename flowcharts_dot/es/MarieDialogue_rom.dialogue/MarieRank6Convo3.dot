	3609 [label="He estado pensando en cómo convencer a Loid de que suba esas escaleras para hablar finalmente con la familia, y... tengo una idea, pero no creo que te guste.",shape=box,color=red];
		3609 -> 3614;
	3610 [label="¿Has pensado más en cómo convencer a Loid de que hable con la familia Entrati de arriba?",shape=box,color=red];
		3610 -> 3615;
	3611 [label="En cuanto al tema de intentar que Loid y la familia Entrati hablen, me preguntaba... ¿si has reconsiderado la participación de Roathe?",shape=box,color=red];
		3611 -> 3616;
	3612 [label="Marie, ¿todavía estás dispuesta a... tal vez intentar convencer a Loid de que hable con los \"vecinos de arriba\"? Sé que dejamos eso en una nota extraña.",shape=box,color=red];
		3612 -> 3616;
	3608 [label="He estado pensando en cómo Monsieur Loid tiene tanto miedo de hablar con la familia de le Cardinal.",shape=box,color=blue];
