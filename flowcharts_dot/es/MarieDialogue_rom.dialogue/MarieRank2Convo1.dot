	405 [label="¡Mis celos abundan! Me consumiría. Me encantaría hablarte de esto otra vez, si me lo permites. No quiero sermonear ni entrometerme. No quiero causarte molestias.",shape=box,color=blue];
		405 -> 409;
	406 [label="Entonces sé que mi Sol te sonríe, ya sea que le reces o no, porque has encontrado el único camino que necesitas.",shape=box,color=blue];
		406 -> 410;
	407 [label="Ah, pardonne-moi ! La pequeña Marie está predicando, ¡qué vergüenza! No vine a sermonearte como una maestra de escuela.",shape=box,color=blue];
		407 -> 382;
	408 [label="Me conmueve profundamente tu honestidad, viajero. Me encantaría volver a hablarte de esto, si me lo permites. No pretendo sermonear ni entrometerme. No quiero causarte molestias.",shape=box,color=blue];
		408 -> 409;
	409 [label="Solo tengo curiosidad y deseo ayudarte si puedo. Por favor, solo di que no y no volveremos a hablar de esto.",shape=box,color=blue];
		409 -> 411;
		409 -> 412;
	410 [label="¿Me pregunto si podríamos hablar de esto otra vez? Tengo muchísima curiosidad por saber más.",shape=box,color=blue];
		410 -> 411;
		410 -> 412;
	411 [label="No, gracias.",shape=box,color=red];
		411 -> 413;
	412 [label="Por supuesto.",shape=box,color=red];
