		351 -> 364;
	352 [label="Todos morimos. Temerle a eso es una tontería. Nos toca a todos. O al menos... debería.",shape=box,color=red];
		352 -> 365;
	353 [label="He muerto suficientes veces. No temo lo que venga después. Lo anhelo.",shape=box,color=red];
		353 -> 366;
	354 [label="+5 Chemistry",color=orange];
		354 -> 367;
	348 [label="Me sorprende un poco que estés abierta a que la gente no crea en tu fe.",shape=box,color=red];
		348 -> 361;
	349 [label="De eso se trata exactamente. No quiero decir que una tiene razón y otra no.",shape=box,color=red];
