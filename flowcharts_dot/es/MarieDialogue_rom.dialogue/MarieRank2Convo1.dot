	373 [label="Se sabe que cambian de forma para complacer a sus seguidores en otras sectas. Pero esa es mi fe, no la tuya.",shape=box,color=blue];
		373 -> 386;
	371 [label="Eso me gustaría.",shape=box,color=red];
		371 -> 384;
	372 [label="Me sorprende que estés abierta a la idea de otras religiones. ",shape=box,color=red];
		372 -> 385;
	368 [label="¡Un viajero parecido a mí! Me haces sonreír. Espero que no mientas para halagarme.",shape=box,color=blue];
		368 -> 382;
	369 [label="Ah, el viajero sigue el camino de la noche como mi querido Lyon. Cuando esté listo, deberías hablarle de las costumbres de su dama oscura; se alegrará muchísimo.",shape=box,color=blue];
		369 -> 382;
	370 [label="Equilibrio sin indecisión. ¿Recorrer la vida sabiendo cuándo debe salir el sol y cuándo debe responder la luna, pero sin caer jamás en la duda?",shape=box,color=blue];
