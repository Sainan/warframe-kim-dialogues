		309 -> 314;
	3904 [label="¡Pero intentas distraerme! Aunque no me opongo, es demasiado pronto para esas cosas, n'est pas ?",shape=box,color=blue];
		3904 -> 3905;
	318 [label="+5 Chemistry",color=orange];
		318 -> 326;
	317 [label="La fe, sin importar su nombre, me parece hermosa. Dime, ¿es nueva? ¿Antigua? ¿La reconocería?",shape=box,color=blue];
		317 -> 324;
		317 -> 325;
	316 [label="¡Lo crees! Oh, comme c'est fascinant ! Pensar que alguien tiene esta fe en el futuro tan lejano, cela remplit mon coeur de joie. Me llena de alegría. Aunque creo que tu pasado pudo haber tenido algo que ver, ¿no? Ah, no importa.",shape=box,color=blue];
		316 -> 323;
	315 [label="Respeto tu respuesta. Pero debo preguntarte: ¿cómo puedes tener tanta certeza? ¿No es eso una especie de fe? ¿Y qué es esta... Indifférence tuya, si no un dios?",shape=box,color=blue];
		315 -> 320;
		315 -> 321;
		315 -> 322;
	314 [label="+10 Chemistry",color=orange];
		314 -> 319;
	3905 [label="Yo... aún quisiera una respuesta a mi pregunta, s'il vous plait, si no te importa. ¡Aunque ahora me haces sonrojar!",shape=box,color=blue];
		3905 -> 308;
		3905 -> 307;
		3905 -> 306;
		3905 -> 305;
		3905 -> 304;
	326 [label="Ah, oui. Un viajero, eso es lo que eres. Has visto muchas culturas, muchas religiones, muchos mundos. Cela est très spirituel, non ? Recolectas partes de ellas como conchas marinas.",shape=box,color=blue];
		326 -> 336;
		326 -> 337;
	324 [label="No creo que pudieras reconocerla en absoluto.",shape=box,color=red];
		324 -> 334;
	325 [label="Quizás reconocerías algunas partes, pero otras te resultarían totalmente desconocidas.",shape=box,color=red];
		325 -> 335;
	323 [label="Me pregunto, ¿eres más devoto de alguno? ¿O buscas el equilibrio?",shape=box,color=blue];
		323 -> 331;
		323 -> 332;
		323 -> 333;
	320 [label="No puedo asegurar que tengo la razón, nadie puede tenerla. Pero personalmente, sigo sin creer en dioses.",shape=box,color=red];
		320 -> 328;
	321 [label="Creo que la religión existe para llenar un vacío en la vida de las personas provocado por el miedo a la muerte y a lo desconocido.",shape=box,color=red];
		321 -> 329;
	322 [label="No sé qué es la Indiferencia, pero no es un dios. Solo necesitamos llegar al fondo del asunto. ",shape=box,color=red];
		322 -> 330;
	319 [label="Ah, ¡quizás la respuesta más sabia de todas! Pues ¿quiénes somos nosotros, simples mortales —si aún podemos afirmar serlo—, para pretender descifrar el designio de los dioses?",shape=box,color=blue];
		319 -> 327;
	336 [label="Creo que también hay algo más antiguo, más verdadero y más profundo que nos habla a todos. Una especie de tejido conectivo.",shape=box,color=red];
		336 -> 347;
	337 [label="Exacto. Veo algo hermoso en todas ellas, no sé si alguna tiene la razón o no.",shape=box,color=red];
		337 -> 347;
