		413 -> 415;
	414 [label="Merci, merci ! Hay mucha confianza en lo que me acabas de dar. No la desperdiciaré. Hasta entonces.",shape=box,color=blue];
		414 -> 416;
	415 [label="Lo entiendo perfectamente y no me ofendo. Gracias por escucharme y te agradezco lo que has compartido. Deberíamos hablar de otros temas, ¡Sol sabe que tenemos mucho que decir!",shape=box,color=blue];
		415 -> 417;
