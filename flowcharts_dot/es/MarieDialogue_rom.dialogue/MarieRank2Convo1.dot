	339 [label="Oui, je vois... ¿Quizás necesitas tu propia \"prueba\" para estar seguro? ¿No ha sucedido nada en tu vida que te provoque una emoción como la que da la fe y el fervor?",shape=box,color=blue];
		339 -> 350;
		339 -> 351;
	340 [label="Oui, c'est vrai, es cierto. La fe responde muchas preguntas para muchas almas. ¿No temes lo que pueda venir después de la muerte?",shape=box,color=blue];
		340 -> 352;
		340 -> 353;
	341 [label="Comme c'est fascinant... y ahora hay dos, quienes repiten las mismas palabras... el diablo ha susurrado lo mismo.",shape=box,color=blue];
		341 -> 354;
	338 [label="Tenían mucha curiosidad por nuestra fe, pero no querían decir \"sí, sí, esta es la verdad\". Solo espero haberles dado algo de nuestra alegría para que la llevaran con ellos.",shape=box,color=blue];
		338 -> 348;
		338 -> 349;
	360 [label="Je comprends et c'est magnifique. Muchas veces me he preguntado si las Luminarias no tenían otras caras. Otros nombres.",shape=box,color=blue];
		360 -> 373;
	358 [label="Oh, comme c'est fascinant ! Me encantaría aprender sobre tu fe algún día. Escuchar sobre tus rituales.",shape=box,color=blue];
		358 -> 371;
		358 -> 372;
	359 [label="Oh, comme c'est fascinant ! Me encantaría escuchar algún día cómo es similar y, a la vez, tan diferente.",shape=box,color=blue];
