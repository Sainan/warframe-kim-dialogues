	367 [label="Me duele el corazón de darle algo de crédito, pero sobre esto... Quizás deberías hablar con él. Simplemente ten cuidado. El diablo juega un juego peligroso.",shape=box,color=blue];
		367 -> 380;
		367 -> 381;
	361 [label="Supongo que podría sorprenderte encontrar a alguien que usa el hábito y no es estricto con sus expectativas sobre los demás. Creo que predicar a quienes no buscan consuelo no genera mucho amor.",shape=box,color=blue];
		361 -> 374;
	362 [label="+5 Chemistry",color=orange];
