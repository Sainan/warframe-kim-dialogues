	386 [label="Simplemente espero que tu fe te traiga paz.",shape=box,color=blue];
		386 -> 394;
		386 -> 395;
		386 -> 396;
	384 [label="Ô joie ! Tengo mucho que aprender. Muchas veces me he preguntado si las Luminarias no tenían otras caras. Otros nombres.",shape=box,color=blue];
		384 -> 398;
	385 [label="Supongo que podría sorprenderte encontrar a alguien que usa el hábito y no es estricto con sus expectativas sobre los demás. Creo que predicar a quienes no buscan consuelo no genera mucho amor.",shape=box,color=blue];
		385 -> 399;
	382 [label="Simplemente me pregunto, ¿nuestra fe te da paz?",shape=box,color=blue];
		382 -> 394;
		382 -> 395;
		382 -> 396;
	383 [label="Ese es un don raro... y espero que lo domines. Me temo que demorarse demasiado en esa encrucijada te termina consumiendo por el conflicto.",shape=box,color=blue];
		383 -> 397;
	376 [label="Debe ser una vida más sencilla. No vivir según las reglas de los dioses e iglesias. Admito que estoy un poco celosa.",shape=box,color=blue];
		376 -> 389;
	377 [label="¡Entonces te envidio, viajero! ¡Vivir tantos siglos sin necesidad de conocer a los dioses!",shape=box,color=blue];
		377 -> 389;
	378 [label="Suenas como un discípulo de Lua, y lo digo sin ofender. Sí, la Anciana viene por todos nosotros y derrama sus lágrimas plateadas. Pero tus palabras me hacen reflexionar...",shape=box,color=blue];
		378 -> 390;
	379 [label="Oui, eso me hace pensar. Te miro a ti, al niño, al diablo, incluso a Monsieur Loid, o le Cardinal... tantos siglos se extienden tras ustedes.",shape=box,color=blue];
		379 -> 391;
	380 [label="¿Qué clase de juego peligroso?",shape=box,color=red];
		380 -> 392;
	381 [label="¿Tampoco cree que el Hombre en la Pared es real?",shape=box,color=red];
		381 -> 393;
	374 [label="+5 Chemistry",color=orange];
		374 -> 387;
	375 [label="Tu sabiduría y amabilidad hacia las creencias de los demás me hacen sonreír.",shape=box,color=blue];
		375 -> 388;
	394 [label="No lo hace.",shape=box,color=red];
		394 -> 400;
	395 [label="Honestamente no pienso mucho en ello.",shape=box,color=red];
		395 -> 401;
	396 [label="Así es.",shape=box,color=red];
		396 -> 402;
	398 [label="Se sabe que cambian de forma para complacer a sus seguidores de otras sectas. Pero esa es mi fe, no la tuya. No predicaré a quienes no buscan consuelo. Me parece que eso no despierta mucho amor.",shape=box,color=blue];
		398 -> 399;
	399 [label="No, mi fe es mía, y la tuya es tuya. Solo espero que te traiga paz.",shape=box,color=blue];
		399 -> 394;
		399 -> 395;
		399 -> 396;
	397 [label="Al final, todos debemos elegir un camino. Pero la encrucijada es en donde todos debemos comenzar. El equilibrio es la base de todas las estructuras.",shape=box,color=blue];
		397 -> 403;
	389 [label="Pero, me pregunto… ¿no creer te da paz?",shape=box,color=blue];
		389 -> 394;
		389 -> 395;
		389 -> 396;
	390 [label="¿De quién hablas cuando dices que \"debería\" tocarle a todos? Te miro a ti, al niño, al diablo, incluso a Monsieur Loid, o a le Cardinal.. tantos siglos se extienden tras ustedes.",shape=box,color=blue];
		390 -> 391;
	391 [label="Me pregunto cuántos siglos nos esperan ahora, antes de que Lua venga por nosotros. Y me pregunto con cuánta ilusión la abrazaré cuando llegue ese día. Pero esa es mi fe, no la tuya.",shape=box,color=blue];
		391 -> 389;
	392 [label="Aún no lo sé. Se guarda sus planes para sí mismo, como un buen demonio. Pero no cree en ningún dios. Salvo, quizás, en sí mismo.",shape=box,color=blue];
		392 -> 389;
	393 [label="Non, no lo cree. Es muy parecido a ti: no cree en ningún dios. Salvo, quizás, en sí mismo.",shape=box,color=blue];
		393 -> 389;
	387 [label="Non, cualquiera que venga con la mente abierta será recibido con los brazos abiertos.",shape=box,color=blue];
		387 -> 388;
	388 [label="Simplemente me pregunto, ¿esto te da paz?",shape=box,color=blue];
