digraph {
	302 [label="MarieRank2Convo1 begins.",color=orange];
		302 -> 303;
	303 [label="Espero que no te ofenda la pregunta, pero tengo muchísima curiosidad. ¿Eres creyente? ¿Crees en las Luminarias o en algo más?",shape=box,color=blue];
		303 -> 3898;
		303 -> 3899;
		303 -> 3900;
	3898 [label="¿Y si dijera que me interesas más? ¿Sería una blasfemia?",shape=box,color=red];
