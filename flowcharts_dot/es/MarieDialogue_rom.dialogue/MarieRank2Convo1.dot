	308 [label="Es... complicado. Creo que hay algo ahí fuera, pero no tengo una fe definida.",shape=box,color=red];
		308 -> 313;
	307 [label="Sí, soy creyente. Tengo una fe en la que creo, aunque no es una que conozcas.",shape=box,color=red];
		307 -> 312;
	306 [label="Creo en las Luminarias, como tú.",shape=box,color=red];
		306 -> 311;
	305 [label="No, no creo en dioses. Solo en ciencia que aún no entendemos.",shape=box,color=red];
		305 -> 310;
	304 [label="No lo sé, honestamente. Creo que el mundo es demasiado complicado como para tener una respuesta.",shape=box,color=red];
		304 -> 309;
	3901 [label="Chat ends.",color=orange];
	3903 [label="Ah, oui ? ¿Qué es esto? Quelle audace, ¡debo decir que me sorprendes! No me lo esperaba...",shape=box,color=blue];
