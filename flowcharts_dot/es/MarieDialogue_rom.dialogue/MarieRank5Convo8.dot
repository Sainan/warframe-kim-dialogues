	"Chat ends." [color=orange];
	j1855396616 [label="Oui, qu'est-ce qu'il y a ?",shape=box,color=blue];
		j1855396616 -> j3624714455;
	j560138440 [label="Me temo que ahora debo llamarlo \"nuestro\" diablo, non ? Porque no se irá pronto. ¡Ja!",shape=box,color=blue];
		j560138440 -> j261058499;
	j2179251788 [label="Siento que yo debería hacerte esa pregunta, non ? ¡Eres tú quien ahora está retozando con él!",shape=box,color=blue];
		j2179251788 -> j1602408976;
	j1702172208 [label="No sé cómo lo lograste pero nos contó la verdad sobre haber recibido el suero.",shape=box,color=blue];
		j1702172208 -> j1271881717;
	j3759081015 [label="No sé cómo lo lograste. Pero nos ha contado la verdad sobre tomar el suero.",shape=box,color=blue];
	j3954135016 [label="Me preocupa. Creo que se hace más daño del que nos muestra, n'est-ce pas?",shape=box,color=blue];
		j3954135016 -> j3063859433;
	j3624714455 [label="Perdón si parece que esto sale de la nada, pero no sabía cómo decírtelo antes.",shape=box,color=red];
		j3624714455 -> j2371886489;
	j261058499 [label="Hiciste bien en conseguir su ayuda con Monsieur Loid. No pensé que fuera posible.",shape=box,color=blue];
		j261058499 -> j492060219;
	j1602408976 [label="Me resisto a la tentación de pedirte toutes sortes de commérages.",shape=box,color=blue];
		j1602408976 -> j492060219;
	j1271881717 [label="Sol, me rompió el corazón. Su voz no tembló al hablar. Mais je l'ai vu dans ses yeux.",shape=box,color=blue];
		j1271881717 -> j492060219;
	j3063859433 [label="Me rompe el corazón. Espero que el suyo no se destruya algún día. No sé si sobrevivirá. No sé si alguno de nosotros lo hará.",shape=box,color=blue];
		j3063859433 -> "Chat ends.";
	j2371886489 [label="Te adoro. Simplemente te adoro.",shape=box,color=red];
		j2371886489 -> j2180806395;
	j492060219 [label="Ha habido un cambio en él. Sutil, pero está ahí. ",shape=box,color=blue];
		j492060219 -> j1749705182;
	j2180806395 [label="Bueno, me preguntaba... si te gustaría, bueno... ¿que seamos una pareja?",shape=box,color=red];
		j2180806395 -> j2298753926;
	j1749705182 [label="+5 Chemistry",color=orange];
		j1749705182 -> j3735702384;
	j2298753926 [label="Evaluate expressions",color=orange];
		j2298753926 -> j837872475 [label="MarieNoDate",color=purple];
		j2298753926 -> j3104863483 [label="MarieWillDate",color=purple];
		j2298753926 -> j837872475 [label="false",color=purple];
	j3735702384 [label="Sé que tenemos que agradecerte por eso.",shape=box,color=blue];
		j3735702384 -> j230546789;
	j837872475 [label="¡Ay! ¡Ay, Viajero! No sé cómo decirlo, así que lo diré sin rodeos. ",shape=box,color=blue];
		j837872475 -> j617350017;
	j3104863483 [label="¡Oh, siento lo mismo! Mais je ne sais pas comment te l'écrire, je n'ose pas taper les mots ! ¡Me consideré una tonta por siquiera pensar en eso!",shape=box,color=blue];
		j3104863483 -> j1384619770;
	j230546789 [label="No sé si lo aceptará, pero siempre tendrá mi amistad.",shape=box,color=blue];
		j230546789 -> j1139304592;
	j617350017 [label="Non.",shape=box,color=blue];
		j617350017 -> "Chat ends.";
	j1384619770 [label="¡Ah! ¡Me has hecho tan feliz!",shape=box,color=blue];
		j1384619770 -> j3397843036;
	j1139304592 [label="¡Aunque creo que nunca me cansaré de gritarle!",shape=box,color=blue];
		j1139304592 -> j2301613205;
		j1139304592 -> j3704333999;
	j3397843036 [label="Si lo que buscas es una relación más... formal, entonces ¡oui! ¡Oui! Me gustaría.",shape=box,color=blue];
		j3397843036 -> j2125302112;
		j3397843036 -> j1013807563;
	j2301613205 [label="Creo que, de todas formas, disfruta demasiado molestándote.",shape=box,color=red];
		j2301613205 -> j1859425534;
	j3704333999 [label="Me alegro de que hayas encontrado algún tipo de vínculo.",shape=box,color=red];
		j3704333999 -> j3773991333;
	j2125302112 [label="Definitivamente no te estoy proponiendo matrimonio, todavía no. ",shape=box,color=red];
		j2125302112 -> j183228920;
	j1013807563 [label="Las cosas han evolucionado un poco. No diría que son más \"formales\", pero me alegra mucho... poder mostrarte.",shape=box,color=red];
		j1013807563 -> j2314636164;
	j1859425534 [label="Comme un gros chat de gouttière. Me he acostumbrado a él.",shape=box,color=blue];
		j1859425534 -> j2388046496;
	j3773991333 [label="Oui ! Yo también. Cada día es menos insoportable.",shape=box,color=blue];
		j3773991333 -> j1859425534;
	j183228920 [label="Ahora soy yo la que bromea, no te preocupes. Pero, de cualquier forma, je suis ravie! Y deseando aprender estas nuevas... costumbres románticas.",shape=box,color=blue];
		j183228920 -> j1912346125;
	j2314636164 [label="¡Ja! Sé cuándo te estás portando mal. Bueno, lo espero con ansias.",shape=box,color=blue];
		j2314636164 -> j1912346125;
	j2388046496 [label="Creo que estaría triste si él se fuera.",shape=box,color=blue];
		j2388046496 -> "Chat ends.";
	j1912346125 [label="+10 Chemistry",color=orange];
		j1912346125 -> j2362269950;
	j2362269950 [label="¿Hasta entonces? À la revoyure, mon coeur.",shape=box,color=blue];
