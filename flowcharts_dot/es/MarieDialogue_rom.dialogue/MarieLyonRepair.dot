	j3236791843 [label="Realmente desearía que nos ayudaras, Marie. ",shape=box,color=red];
		j3236791843 -> j1576226048;
	j2727656598 [label="Te necesitamos, Marie. Sin ti, no tiene caso. Por favor. ¿Puedes perdonarme?",shape=box,color=red];
		j2727656598 -> j760261854;
	j3462871351 [label="Lamento haberte molestado. Pero, por favor, no te desquites con Loid. Ni con la familia de arriba.",shape=box,color=red];
		j3462871351 -> j1881663238;
	j1576226048 [label="Simplemente vine a decirte que no debes utilizar la bondad de Lyon para compensar tus propios fracasos.",shape=box,color=blue];
		j1576226048 -> "Chat ends.";
	j760261854 [label="Oui... Puedo. Estar enojada contigo no debería afectar a otros.",shape=box,color=blue];
		j760261854 -> j515710933;
	j1881663238 [label="Sí. En esto tienes razón. Estar enojada contigo en este momento no debería afectar a otros.",shape=box,color=blue];
		j1881663238 -> j97763850;
	j515710933 [label="Entonces, muy bien. Tendrás mi ayuda. Tu auras mon aide.",shape=box,color=blue];
		j515710933 -> j3151953893;
