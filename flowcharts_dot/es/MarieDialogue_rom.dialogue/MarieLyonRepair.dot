	3874 [label="Chat ends.",color=orange];
	3875 [label="Realmente desearía que nos ayudaras, Marie. ",shape=box,color=red];
		3875 -> 3878;
	3876 [label="Te necesitamos, Marie. Sin ti, no tiene caso. Por favor. ¿Puedes perdonarme?",shape=box,color=red];
		3876 -> 3879;
	3877 [label="Lamento haberte molestado. Pero, por favor, no te desquites con Loid. Ni con la familia de arriba.",shape=box,color=red];
		3877 -> 3880;
	3878 [label="Simplemente vine a decirte que no debes utilizar la bondad de Lyon para compensar tus propios fracasos.",shape=box,color=blue];
		3878 -> 3881;
	3879 [label="Oui... Puedo. Estar enojada contigo no debería afectar a otros.",shape=box,color=blue];
		3879 -> 3882;
	3880 [label="Sí. En esto tienes razón. Estar enojada contigo en este momento no debería afectar a otros.",shape=box,color=blue];
		3880 -> 3883;
	3881 [label="Chat ends.",color=orange];
	3882 [label="Entonces, muy bien. Tendrás mi ayuda. Tu auras mon aide.",shape=box,color=blue];
		3882 -> 3884;
