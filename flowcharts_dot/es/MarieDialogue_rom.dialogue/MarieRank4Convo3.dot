digraph {
	"MarieRank4Convo3 begins." [color=orange];
		"MarieRank4Convo3 begins." -> j2756286636;
		"MarieRank4Convo3 begins." -> j2429168889;
	j2756286636 [label="¿Cómo estás hoy, Marie?",shape=box,color=red];
		j2756286636 -> j1605020498;
	j2429168889 [label="[Fin.]",shape=box,color=red];
		j2429168889 -> "Chat ends.";
	j1605020498 [label="No muy bien. Quizás quieras volver a hablar conmigo mañana. Hoy no seré la mejor compañía.",shape=box,color=blue];
		j1605020498 -> j2685683989;
		j1605020498 -> j1473243;
		j1605020498 -> j3841261251;
	"Chat ends." [color=orange];
	j2685683989 [label="Me iré si quieres, pero si quieres hablar, con gusto te escucharé.",shape=box,color=red];
		j2685683989 -> j665688724;
	j1473243 [label="Está bien, lo entiendo.",shape=box,color=red];
		j1473243 -> "Chat ends.";
	j3841261251 [label="¿Puedo preguntar qué pasa...?",shape=box,color=red];
		j3841261251 -> j665688724;
	j665688724 [label="C'est vraiment gentil, pero es un problema viejo... nada que con lo que valga la pena molestarte. Estaré bien.",shape=box,color=blue];
		j665688724 -> j3096270068;
	j3096270068 [label="Boolean MarieChronicPain is now true.",color=orange];
		j3096270068 -> j1396929322;
		j3096270068 -> j3957863402;
		j3096270068 -> j2085124083;
	j1396929322 [label="Está bien si estás segura, pero estoy aquí, si quieres hablar de ello.",shape=box,color=red];
		j1396929322 -> j3545527600;
	j3957863402 [label="Yo... sé cómo es eso. Antes de empezar a hacer \"bucles\", me lastimé bastante en Duviri. Sané, pero todavía me duele muchísimo de vez en cuando. Intento disimular mi dolor cuando aparece.",shape=box,color=red];
		j3957863402 -> j2118932999;
	j2085124083 [label="Los viejos problemas persistentes pueden ser tan problemáticos como los nuevos. Que aparezcan y desaparezcan, y que puedan quedarse con nosotros, no significa que no valga la pena hablar de ellos.",shape=box,color=red];
		j2085124083 -> j3456088595;
	j3545527600 [label="Eres muy amable, y... bueno. Estoy siendo la pequeña testaruda Marie otra vez.",shape=box,color=blue];
		j3545527600 -> j1360805957;
	j2118932999 [label="Boolean DrifterChronicPain is now true.",color=orange];
		j2118932999 -> j35183494;
	j3456088595 [label="Oui, tu as raison. Estoy siendo la pequeña testaruda Marie otra vez.",shape=box,color=blue];
		j3456088595 -> j1360805957;
	j1360805957 [label="Es difícil de explicar, pero lo intentaré. Mes pieds, oui ? Mis pies. El suero me ha cambiado, me permite volar...",shape=box,color=blue];
		j1360805957 -> j2497156147;
	j35183494 [label="Par les Luminaires, lo siento mucho. Entonces tú entiendes como es, oui ?",shape=box,color=blue];
		j35183494 -> j1035353267;
	j2497156147 [label="Pero todavía los siento, esas cosas retorcidas que amenazaban con consumirme, amenazaban con aplastar toda esperanza y alegría de mi alma.",shape=box,color=blue];
		j2497156147 -> j479083711;
	j1035353267 [label="Tener un cuerpo que te traiciona, que frena tu espíritu. Incluso ahora, es tan extraño. El suero me ha cambiado, me permite volar...",shape=box,color=blue];
		j1035353267 -> j2497156147;
	j479083711 [label="Siempre me duelen. Siempre. Incluso ahora, sentada aquí, si pienso en ellos, siento el dolor. Pero no siempre es el suficiente para notarlo.",shape=box,color=blue];
		j479083711 -> j1204716152;
	j1204716152 [label="Aún ahora me despiertan en la noche del dolor. Y me pregunto: Sol, pourquoi ? ¿Por qué debo seguir sintiendo esta... agonie interminable ?",shape=box,color=blue];
		j1204716152 -> j1632463391;
	j1632463391 [label="¿Cuál es el propósito? Ah, pero entonces llega la mañana, y me río, y me digo: \"Cállate, Marie, eres bendecida. Mira todo lo que tienes, todo lo que puedes hacer.\"",shape=box,color=blue];
		j1632463391 -> j1032532393;
	j1032532393 [label="En la Cathédrale decían: \"Puedes leer, puedes escribir, puedes comer, puedes dormir. Puedes moverte con facilidad. Tienes ojos para ver y lengua para hablar. Manos para escribir. Personas que te cuidan.\" ¡Y ahora puedo volar! Puedo proteger el futuro del mismísimo Vacío. De l'Indifférence !",shape=box,color=blue];
		j1032532393 -> j1721474079;
	j1721474079 [label="\"Llora ahora, niña tonta, este dolor constante te hará fuerte ante lo que venga\", me digo. Y el día da paso a otro y no es tan malo cuando llega el siguiente.",shape=box,color=blue];
		j1721474079 -> j830269311;
	j830269311 [label="Check boolean DrifterChronicPain",color=orange];
		j830269311 -> j2395123829 [label=true,color=green];
		j830269311 -> j3850152884 [label=true,color=green];
		j830269311 -> j526603197 [label=false,color=brown];
		j830269311 -> j1437819313 [label=false,color=brown];
	j2395123829 [label="Si hay algo que nos ha dado, supongo que es tolerancia al dolor.",shape=box,color=red];
		j2395123829 -> j679987079;
	j3850152884 [label="A veces, sin embargo... me despierto y siento que va a ser el día en que me romperé.",shape=box,color=red];
		j3850152884 -> j679987079;
	j526603197 [label="¿De verdad... nunca deja de doler? Lo siento muchísimo, Marie...",shape=box,color=red];
		j526603197 -> j3165574018;
	j1437819313 [label="¿Y no hay algún medicamento? ¿No hay tratamiento?",shape=box,color=red];
		j1437819313 -> j2475986918;
	j679987079 [label="Un feligrés me preguntó una vez: \"¿Te duele? ¿Siempre?\". A lo que respondí: \"\"Oui, monsieur. Je le suis.\" Su expresión de asombro estaba mezclada con horror.",shape=box,color=blue];
		j679987079 -> j4088689305;
	j3165574018 [label="A veces, me sentaba a pensar en todo lo que podría hacer si no estuviera sufriendo tanto, oui ? Si no estuviera tan... atrapada en la jaula de mi cuerpo que se empeñaba en obstaculizarme a cada paso.",shape=box,color=blue];
		j3165574018 -> j55500735;
	j2475986918 [label="Ojalá lo hubiera. Pero no, no lo hay. No en mi época, y me temo que probablemente tampoco en esta.",shape=box,color=blue];
		j2475986918 -> j2335254646;
	j4088689305 [label="\"¿Cómo lo haces?\", fue su siguiente pregunta. Y recuerdo que le sonreí y le respondí: \"¿Qué otra opción tengo, Monsieur...?\"",shape=box,color=blue];
		j4088689305 -> j3591775272;
		j4088689305 -> j339133848;
	j55500735 [label="¡Qué furiosa me ponía! ¡Qué celosa me ponía de aquellos cuyos cuerpos no los traicionaban! Pero ¿de qué sirve al final, à part rendre nos vies plus amères ? ¿Estar más amargada?",shape=box,color=blue];
		j55500735 -> j3297342862;
	j2335254646 [label="Algunas enfermedades están más allá de las curas del hombre, de la ciencia y de la fe.",shape=box,color=blue];
		j2335254646 -> j3165574018;
	j3591775272 [label="He tenido esa misma conversación tantas veces...",shape=box,color=red];
		j3591775272 -> j3165574018;
	j339133848 [label="Exactamente. Lo siento mucho.",shape=box,color=red];
		j339133848 -> j2793725113;
	j3297342862 [label="Aucun. Soy como soy y perseveraré.",shape=box,color=blue];
		j3297342862 -> j2980398560;
	j2793725113 [label="Non, simplemente lamento que hayas compartido una agonía tan similar. ",shape=box,color=blue];
		j2793725113 -> j3165574018;
	j2980398560 [label="Check boolean DrifterChronicPain",color=orange];
		j2980398560 -> j4217088536 [label=true,color=green];
		j2980398560 -> j2515769218 [label=false,color=brown];
	j4217088536 [label="Y tú también. Tú también. Tengo fe en eso.",shape=box,color=blue];
		j4217088536 -> j2515769218;
	j2515769218 [label="+20 Chemistry",color=orange];
		j2515769218 -> j3407537837;
	j3407537837 [label="No puedo expresar con palabras lo mucho que esta conversación ha significado para mí. Así que simplemente diré: merci, Viajero.",shape=box,color=blue];
		j3407537837 -> j3563974437;
	j3563974437 [label="Et encore merci.",shape=box,color=blue];
		j3563974437 -> "Chat ends.";
}