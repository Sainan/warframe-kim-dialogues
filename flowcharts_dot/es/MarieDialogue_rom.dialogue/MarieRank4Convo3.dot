digraph {
	2239 [label="MarieRank4Convo3 begins.",color=orange];
		2239 -> 2240;
		2239 -> 2241;
	2240 [label="¿Cómo estás hoy, Marie?",shape=box,color=red];
		2240 -> 2242;
	2241 [label="[Fin.]",shape=box,color=red];
		2241 -> 2243;
	2242 [label="No muy bien. Quizás quieras volver a hablar conmigo mañana. Hoy no seré la mejor compañía.",shape=box,color=blue];
		2242 -> 2244;
		2242 -> 2245;
		2242 -> 2246;
	2243 [label="Chat ends.",color=orange];
	2244 [label="Me iré si quieres, pero si quieres hablar, con gusto te escucharé.",shape=box,color=red];
		2244 -> 2247;
	2245 [label="Está bien, lo entiendo.",shape=box,color=red];
		2245 -> 2248;
	2246 [label="¿Puedo preguntar qué pasa...?",shape=box,color=red];
		2246 -> 2247;
	2247 [label="C'est vraiment gentil, pero es un problema viejo... nada que con lo que valga la pena molestarte. Estaré bien.",shape=box,color=blue];
		2247 -> 2249;
	2248 [label="Chat ends.",color=orange];
	2249 [label="Update boolean MarieChronicPain",color=orange];
		2249 -> 2250;
		2249 -> 2251;
		2249 -> 2252;
	2250 [label="Está bien si estás segura, pero estoy aquí, si quieres hablar de ello.",shape=box,color=red];
		2250 -> 2253;
	2251 [label="Yo... sé cómo es eso. Antes de empezar a hacer \"bucles\", me lastimé bastante en Duviri. Sané, pero todavía me duele muchísimo de vez en cuando. Intento disimular mi dolor cuando aparece.",shape=box,color=red];
		2251 -> 2254;
	2252 [label="Los viejos problemas persistentes pueden ser tan problemáticos como los nuevos. Que aparezcan y desaparezcan, y que puedan quedarse con nosotros, no significa que no valga la pena hablar de ellos.",shape=box,color=red];
		2252 -> 2255;
	2253 [label="Eres muy amable, y... bueno. Estoy siendo la pequeña testaruda Marie otra vez.",shape=box,color=blue];
		2253 -> 2256;
	2254 [label="Update boolean DrifterChronicPain",color=orange];
		2254 -> 2257;
	2255 [label="Oui, tu as raison. Estoy siendo la pequeña testaruda Marie otra vez.",shape=box,color=blue];
		2255 -> 2256;
	2256 [label="Es difícil de explicar, pero lo intentaré. Mes pieds, oui ? Mis pies. El suero me ha cambiado, me permite volar...",shape=box,color=blue];
		2256 -> 2258;
	2257 [label="Par les Luminaires, lo siento mucho. Entonces tú entiendes como es, oui ?",shape=box,color=blue];
		2257 -> 2259;
	2258 [label="Pero todavía los siento, esas cosas retorcidas que amenazaban con consumirme, amenazaban con aplastar toda esperanza y alegría de mi alma.",shape=box,color=blue];
		2258 -> 2260;
	2259 [label="Tener un cuerpo que te traiciona, que frena tu espíritu. Incluso ahora, es tan extraño. El suero me ha cambiado, me permite volar...",shape=box,color=blue];
		2259 -> 2258;
	2260 [label="Siempre me duelen. Siempre. Incluso ahora, sentada aquí, si pienso en ellos, siento el dolor. Pero no siempre es el suficiente para notarlo.",shape=box,color=blue];
		2260 -> 2261;
	2261 [label="Aún ahora me despiertan en la noche del dolor. Y me pregunto: Sol, pourquoi ? ¿Por qué debo seguir sintiendo esta... agonie interminable ?",shape=box,color=blue];
		2261 -> 2262;
	2262 [label="¿Cuál es el propósito? Ah, pero entonces llega la mañana, y me río, y me digo: \"Cállate, Marie, eres bendecida. Mira todo lo que tienes, todo lo que puedes hacer.\"",shape=box,color=blue];
		2262 -> 2263;
	2263 [label="En la Cathédrale decían: \"Puedes leer, puedes escribir, puedes comer, puedes dormir. Puedes moverte con facilidad. Tienes ojos para ver y lengua para hablar. Manos para escribir. Personas que te cuidan.\" ¡Y ahora puedo volar! Puedo proteger el futuro del mismísimo Vacío. De l'Indifférence !",shape=box,color=blue];
		2263 -> 2264;
	2264 [label="\"Llora ahora, niña tonta, este dolor constante te hará fuerte ante lo que venga\", me digo. Y el día da paso a otro y no es tan malo cuando llega el siguiente.",shape=box,color=blue];
		2264 -> 2265;
	2265 [label="Check boolean DrifterChronicPain",color=orange];
		2265 -> 2266 [label=true,color=green];
		2265 -> 2269 [label=true,color=green];
		2265 -> 2267 [label=false,color=brown];
		2265 -> 2268 [label=false,color=brown];
	2266 [label="Si hay algo que nos ha dado, supongo que es tolerancia al dolor.",shape=box,color=red];
		2266 -> 2270;
	2269 [label="A veces, sin embargo... me despierto y siento que va a ser el día en que me romperé.",shape=box,color=red];
		2269 -> 2270;
	2267 [label="¿De verdad... nunca deja de doler? Lo siento muchísimo, Marie...",shape=box,color=red];
		2267 -> 2271;
	2268 [label="¿Y no hay algún medicamento? ¿No hay tratamiento?",shape=box,color=red];
		2268 -> 2272;
	2270 [label="Un feligrés me preguntó una vez: \"¿Te duele? ¿Siempre?\". A lo que respondí: \"\"Oui, monsieur. Je le suis.\" Su expresión de asombro estaba mezclada con horror.",shape=box,color=blue];
		2270 -> 2273;
	2271 [label="A veces, me sentaba a pensar en todo lo que podría hacer si no estuviera sufriendo tanto, oui ? Si no estuviera tan... atrapada en la jaula de mi cuerpo que se empeñaba en obstaculizarme a cada paso.",shape=box,color=blue];
		2271 -> 2274;
	2272 [label="Ojalá lo hubiera. Pero no, no lo hay. No en mi época, y me temo que probablemente tampoco en esta.",shape=box,color=blue];
		2272 -> 2275;
	2273 [label="\"¿Cómo lo haces?\", fue su siguiente pregunta. Y recuerdo que le sonreí y le respondí: \"¿Qué otra opción tengo, Monsieur...?\"",shape=box,color=blue];
		2273 -> 2276;
		2273 -> 2277;
	2274 [label="¡Qué furiosa me ponía! ¡Qué celosa me ponía de aquellos cuyos cuerpos no los traicionaban! Pero ¿de qué sirve al final, à part rendre nos vies plus amères ? ¿Estar más amargada?",shape=box,color=blue];
		2274 -> 2278;
	2275 [label="Algunas enfermedades están más allá de las curas del hombre, de la ciencia y de la fe.",shape=box,color=blue];
		2275 -> 2271;
	2276 [label="He tenido esa misma conversación tantas veces...",shape=box,color=red];
		2276 -> 2271;
	2277 [label="Exactamente. Lo siento mucho.",shape=box,color=red];
		2277 -> 2279;
	2278 [label="Aucun. Soy como soy y perseveraré.",shape=box,color=blue];
		2278 -> 2280;
	2279 [label="Non, simplemente lamento que hayas compartido una agonía tan similar. ",shape=box,color=blue];
		2279 -> 2271;
	2280 [label="Check boolean DrifterChronicPain",color=orange];
		2280 -> 2281 [label=true,color=green];
		2280 -> 2282 [label=false,color=brown];
	2281 [label="Y tú también. Tú también. Tengo fe en eso.",shape=box,color=blue];
		2281 -> 2282;
	2282 [label="+20 Chemistry",color=orange];
		2282 -> 2283;
	2283 [label="No puedo expresar con palabras lo mucho que esta conversación ha significado para mí. Así que simplemente diré: merci, Viajero.",shape=box,color=blue];
		2283 -> 2284;
	2284 [label="Et encore merci.",shape=box,color=blue];
		2284 -> 2285;
	2285 [label="Chat ends.",color=orange];
}