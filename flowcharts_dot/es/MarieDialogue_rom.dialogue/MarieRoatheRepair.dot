	j2737891827 [label="Boolean MarieEntratiCompleteB is now false.",color=orange];
		j2737891827 -> j3065315887;
	j3919750887 [label="Pero me temo que ya estás en las garras del diablo, non ? No me meteré en sus asuntos.",shape=box,color=blue];
		j3919750887 -> j2368741371;
	j1288450573 [label="Pero me temo que ya le has entregado tu corazón al hermano de mi alma. No puedo quitárselo.",shape=box,color=blue];
		j1288450573 -> j2368741371;
	j457697767 [label="Te lo habría dado si me lo hubieras pedido. Ya tienes un lugar en mi corazón, ¿sabes?",shape=box,color=blue];
		j457697767 -> j1440109248;
		j457697767 -> j1901722506;
	j3065315887 [label="Boolean MarieEntratiCompleteC is now false.",color=orange];
		j3065315887 -> "Chat ends.";
	j2368741371 [label="Te perdonaré tus errores pasados, pero deberás tomar una decisión con respecto a tus otras relaciones.",shape=box,color=blue];
		j2368741371 -> j3109689423;
	j1440109248 [label="¿Sí?",shape=box,color=red];
		j1440109248 -> j4048909001;
	j1901722506 [label="Pero pasé por tantos problemas...",shape=box,color=red];
		j1901722506 -> j3693870004;
	j3109689423 [label="Por supuesto que lo entiendes, n'est pas ?",shape=box,color=blue];
		j3109689423 -> j3947636400;
	j4048909001 [label="Oui ! Y si quieres estar conmigo, también me gustaría.",shape=box,color=blue];
		j4048909001 -> j1171704713;
		j4048909001 -> j1258975811;
	j3693870004 [label="¡Y es culpa tuya, no mía! Pero si quieres estar conmigo, también me gustaría.",shape=box,color=blue];
