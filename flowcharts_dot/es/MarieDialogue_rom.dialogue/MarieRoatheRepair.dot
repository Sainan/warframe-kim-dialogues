		j4217867269 -> "Chat ends." [label="false",color=purple];
	j4224020165 [label="Viajero. El diablo me persigue. ¡Me molesta muchísimo con esos diablillos! ¡Todo en tu nombre! Dice que simplemente quieres disculparte de rodillas.",shape=box,color=blue];
		j4224020165 -> j1401023307;
		j4224020165 -> j31417422;
	j2607690739 [label="El diablo me persigue. ¡Me molesta muchísimo con esos diablillos! ¡Todo en tu nombre! ¿Dice que quieres hablar sobre cómo puedo ayudar para que Monsieur Loid suba?",shape=box,color=blue];
		j2607690739 -> j2007739860;
		j2607690739 -> j31417422;
	j450386456 [label="El diablo me persigue. ¡Me molesta muchísimo con esos diablillos! ¡Todo en tu nombre! ¿Dice que quieres hablar de mi compromiso con le Cardinal una vez más?",shape=box,color=blue];
		j450386456 -> j2784833758;
		j450386456 -> j31417422;
	"Chat ends." [color=orange];
	j1401023307 [label="Sí.",shape=box,color=red];
		j1401023307 -> j2499172404;
	j31417422 [label="¿Lo hizo?",shape=box,color=red];
		j31417422 -> j4177712951;
	j2007739860 [label="Sí.",shape=box,color=red];
		j2007739860 -> j4247013059;
	j2784833758 [label="Sí.",shape=box,color=red];
		j2784833758 -> j1795269517;
	j2499172404 [label="Lo siento mucho. Sé que te ofendí. Y no fue mi intención. Era lo último que quería hacer, créeme.",shape=box,color=red];
		j2499172404 -> j1570967176;
	j4177712951 [label="Je vais le tuer ! Je savais que ce démon était rempli de la pire merde qui soit ! Je vais renvoyer ses conscrits d'où ils viennent par la peau des fesses !",shape=box,color=blue];
		j4177712951 -> "Chat ends.";
	j4247013059 [label="No me extenderé mucho, pues ya me convenció bastante en tu ausencia. Y, como suele ser el diablo, lo argumentó bastante bien.",shape=box,color=blue];
		j4247013059 -> j3410053883;
	j1795269517 [label="No me extenderé mucho, pues ya me convenció bastante en tu ausencia. Y, como suele ser el diablo, lo argumentó bastante bien.",shape=box,color=blue];
		j1795269517 -> j2318392541;
	j1570967176 [label="¿Y eso por qué?",shape=box,color=blue];
		j1570967176 -> j1354219818;
		j1570967176 -> j3586080040;
	j3410053883 [label="Y admito que estoy... bastante cansada de estar atrapada aquí sans recours.",shape=box,color=blue];
		j3410053883 -> j21120083;
	j2318392541 [label="Pero no fueron sus palabras, sino su inteligencia lo que debes agradecer. Hizo que me sentara con Monsieur Loid.",shape=box,color=blue];
		j2318392541 -> j1064985577;
		j2318392541 -> j1390337761;
	j1354219818 [label="[Confesar tus sentimientos.] Porque me importas mucho, Marie. Te adoro.",shape=box,color=red];
		j1354219818 -> j13801581;
	j3586080040 [label="No importa. Esto claramente fue un error.",shape=box,color=red];
		j3586080040 -> j1390500441;
	j21120083 [label="Entonces, muy bien. Tendrás mi ayuda.",shape=box,color=blue];
		j21120083 -> j3151953893;
	j1064985577 [label="¿Oh?",shape=box,color=red];
		j1064985577 -> j783064338;
	j1390337761 [label="Pero Loid ama a Albrecht, ¿no?",shape=box,color=red];
		j1390337761 -> j2700243098;
	j13801581 [label="Sabía que iba a meter la pata. Y vaya que lo hice.",shape=box,color=red];
		j13801581 -> j2300539940;
	j1390500441 [label="Eres tan malo como él.",shape=box,color=blue];
		j1390500441 -> "Chat ends.";
	j3151953893 [label="Boolean MarieFamilySuccess is now true.",color=orange];
		j3151953893 -> j2529015854;
	j783064338 [label="Fue la claridad de Loid lo que me permitió ver a través de mi propio vidrio empañado. Porque Loid ama a Le Cardinal —su Albrecht—, pero aun así lo ve con todos sus defectos.",shape=box,color=blue];
		j783064338 -> j2712003942;
	j2700243098 [label="Sí. Lo hace. Y aun así, puedo verlo con todos sus defectos. Y fue esa claridad de visión la que me permitió ver a través de mi propio cristal empañado.",shape=box,color=blue];
		j2700243098 -> j2712003942;
	j2300539940 [label="Lamento mucho haber recurrido a Roathe para llamar tu atención, pero no sabía a quién más hacerlo.",shape=box,color=red];
		j2300539940 -> j1666008551;
	j2529015854 [label="Boolean MarieFamilyFail is now false.",color=orange];
		j2529015854 -> "Chat ends.";
	j2712003942 [label="¿Qué significa, pues, amar a otro sino aceptarlo tal como es, en lo mejor y en lo peor, después de todo?",shape=box,color=blue];
		j2712003942 -> j3722403271;
	j1666008551 [label="Ay, Viajero... mi pobre Viajero. No tenías que esforzarte tanto para obtener mi perdón. ",shape=box,color=blue];
		j1666008551 -> j3076732245;
	j3722403271 [label="Boolean MarieEntratiCompleteA is now true.",color=orange];
		j3722403271 -> j2737891827;
