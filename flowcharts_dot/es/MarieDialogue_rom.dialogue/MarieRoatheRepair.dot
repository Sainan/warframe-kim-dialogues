		3822 -> 3828;
	3823 [label="Sí.",shape=box,color=red];
		3823 -> 3829;
	3824 [label="¿Lo hizo?",shape=box,color=red];
		3824 -> 3828;
	3825 [label="Sí.",shape=box,color=red];
		3825 -> 3830;
	3826 [label="¿Lo hizo?",shape=box,color=red];
		3826 -> 3828;
	3827 [label="Lo siento mucho. Sé que te ofendí. Y no fue mi intención. Era lo último que quería hacer, créeme.",shape=box,color=red];
		3827 -> 3831;
	3828 [label="Je vais le tuer ! Je savais que ce démon était rempli de la pire merde qui soit ! Je vais renvoyer ses conscrits d'où ils viennent par la peau des fesses !",shape=box,color=blue];
		3828 -> 3832;
	3829 [label="No me extenderé mucho, pues ya me convenció bastante en tu ausencia. Y, como suele ser el diablo, lo argumentó bastante bien.",shape=box,color=blue];
		3829 -> 3833;
	3830 [label="No me extenderé mucho, pues ya me convenció bastante en tu ausencia. Y, como suele ser el diablo, lo argumentó bastante bien.",shape=box,color=blue];
		3830 -> 3834;
	3831 [label="¿Y eso por qué?",shape=box,color=blue];
		3831 -> 3835;
		3831 -> 3836;
	3832 [label="Chat ends.",color=orange];
	3833 [label="Y admito que estoy... bastante cansada de estar atrapada aquí sans recours.",shape=box,color=blue];
		3833 -> 3837;
	3834 [label="Pero no fueron sus palabras, sino su inteligencia lo que debes agradecer. Hizo que me sentara con Monsieur Loid.",shape=box,color=blue];
		3834 -> 3838;
		3834 -> 3839;
	3835 [label="[Confesar tus sentimientos.] Porque me importas mucho, Marie. Te adoro.",shape=box,color=red];
		3835 -> 3840;
	3836 [label="No importa. Esto claramente fue un error.",shape=box,color=red];
		3836 -> 3841;
	3837 [label="Entonces, muy bien. Tendrás mi ayuda.",shape=box,color=blue];
		3837 -> 3842;
	3838 [label="¿Oh?",shape=box,color=red];
		3838 -> 3843;
	3839 [label="Pero Loid ama a Albrecht, ¿no?",shape=box,color=red];
		3839 -> 3844;
	3840 [label="Sabía que iba a meter la pata. Y vaya que lo hice.",shape=box,color=red];
		3840 -> 3845;
	3841 [label="Eres tan malo como él.",shape=box,color=blue];
		3841 -> 3846;
	3842 [label="Update boolean MarieFamilySuccess",color=orange];
		3842 -> 3847;
	3843 [label="Fue la claridad de Loid lo que me permitió ver a través de mi propio vidrio empañado. Porque Loid ama a Le Cardinal —su Albrecht—, pero aun así lo ve con todos sus defectos.",shape=box,color=blue];
		3843 -> 3848;
	3844 [label="Sí. Lo hace. Y aun así, puedo verlo con todos sus defectos. Y fue esa claridad de visión la que me permitió ver a través de mi propio cristal empañado.",shape=box,color=blue];
		3844 -> 3848;
	3845 [label="Lamento mucho haber recurrido a Roathe para llamar tu atención, pero no sabía a quién más hacerlo.",shape=box,color=red];
		3845 -> 3849;
	3846 [label="Chat ends.",color=orange];
	3847 [label="Update boolean MarieFamilyFail",color=orange];
		3847 -> 3850;
	3848 [label="¿Qué significa, pues, amar a otro sino aceptarlo tal como es, en lo mejor y en lo peor, después de todo?",shape=box,color=blue];
		3848 -> 3851;
	3849 [label="Ay, Viajero... mi pobre Viajero. No tenías que esforzarte tanto para obtener mi perdón. ",shape=box,color=blue];
		3849 -> 3852;
	3850 [label="Chat ends.",color=orange];
	3851 [label="Update boolean MarieEntratiCompleteA",color=orange];
		3851 -> 3853;
	3852 [label="Te lo habría dado si me lo hubieras pedido. Ya tienes un lugar en mi corazón, ¿sabes?",shape=box,color=blue];
