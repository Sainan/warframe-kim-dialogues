		3816 -> 3820 [label="false",color=purple];
	3817 [label="Viajero. El diablo me persigue. ¡Me molesta muchísimo con esos diablillos! ¡Todo en tu nombre! Dice que simplemente quieres disculparte de rodillas.",shape=box,color=blue];
		3817 -> 3821;
		3817 -> 3822;
	3818 [label="El diablo me persigue. ¡Me molesta muchísimo con esos diablillos! ¡Todo en tu nombre! ¿Dice que quieres hablar sobre cómo puedo ayudar para que Monsieur Loid suba?",shape=box,color=blue];
		3818 -> 3823;
		3818 -> 3824;
	3819 [label="El diablo me persigue. ¡Me molesta muchísimo con esos diablillos! ¡Todo en tu nombre! ¿Dice que quieres hablar de mi compromiso con el Cardenal una vez más?",shape=box,color=blue];
		3819 -> 3825;
		3819 -> 3826;
