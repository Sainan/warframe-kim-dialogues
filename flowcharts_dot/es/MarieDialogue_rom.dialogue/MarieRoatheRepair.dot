	3856 [label="Update boolean MarieEntratiCompleteC",color=orange];
		3856 -> 3859;
	3857 [label="Oui ! Y si quieres estar conmigo, también me gustaría.",shape=box,color=blue];
		3857 -> 3860;
		3857 -> 3861;
	3858 [label="¡Y es culpa tuya, no mía! Pero si quieres estar conmigo, también me gustaría.",shape=box,color=blue];
