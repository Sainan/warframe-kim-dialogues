		j4190999030 -> j3125130024 [label="RoatheMariePastry1",color=purple];
		j4190999030 -> j662098506 [label="false",color=purple];
		j4190999030 -> j1379537582 [label="false",color=purple];
		j4190999030 -> j3125130024 [label="false",color=purple];
	j662098506 [label="¿Puedo hacer algo para animarte? Podríamos ir a molestar a Roathe.",shape=box,color=red];
		j662098506 -> j3537423958;
	j2112648055 [label="¿Puedo hacer algo para animarte? ¿Quizás robar unos pasteles?",shape=box,color=red];
		j2112648055 -> j2687957527;
	j1379537582 [label="A veces los dioses son crueles, Marie. Así es la vida.",shape=box,color=red];
		j1379537582 -> j4096073072;
	j3125130024 [label="Está bien. Tienes todo el derecho a estarlo.",shape=box,color=red];
		j3125130024 -> j2612018153;
	j3537423958 [label="+15 Chemistry",color=orange];
		j3537423958 -> j1224089679;
	j2687957527 [label="+20 Chemistry",color=orange];
		j2687957527 -> j1224089679;
	j4096073072 [label="+5 Chemistry",color=orange];
		j4096073072 -> j3295371043;
	j2612018153 [label="+20 Chemistry",color=orange];
		j2612018153 -> j2746571955;
	j1224089679 [label="¡Ja! Merci. Eso seguro que calma mis lágrimas. Sabes cómo animar a la pequeña y tonta Marie, non ?",shape=box,color=blue];
		j1224089679 -> j3986319915;
		j1224089679 -> j2394133670;
	j3295371043 [label="Oui. Tienes razón. Lo son. El mundo está lleno de historias como la de Monsieur Otak, y muchas peores que la suya. No debería lamentarme por una sola. ",shape=box,color=blue];
		j3295371043 -> j943628840;
	j2746571955 [label="Merci. Bueno, ya no quiero estarlo. ¡Voy a hacer algo más alegre! Creo que el tanque de M'sieur Fibonacci necesita una buena limpieza.",shape=box,color=blue];
		j2746571955 -> j2425134241;
	j3986319915 [label="No estás siendo para nada tonta. Yo siento lo mismo.",shape=box,color=red];
		j3986319915 -> j2235898819;
	j2394133670 [label="Es lo mínimo que puedo hacer por ti.",shape=box,color=red];
		j2394133670 -> j2235898819;
	j943628840 [label="Y aquí estoy, haciendo precisamente eso. Gracias por hacerme ver que es una tontería. Fie ! La ingenua Marie. Bueno... creo que el tanque de M'sieur Fibonacci necesita una buena limpieza.",shape=box,color=blue];
		j943628840 -> j2425134241;
	j2425134241 [label="Check boolean MarieDating",color=orange];
		j2425134241 -> j1994877025 [label=true,color=green];
