		3186 -> 3187 [label="false",color=purple];
	3190 [label="¡Oh, Luminarias! ¿Qué clase de infierno le han preparado para mantener su alma atrapada en esa jaula de ciencia y luces parpadeantes?",shape=box,color=blue];
		3190 -> 3194;
	3189 [label="Solo puedo rezar a las Luminarias para que tengas razón y que dentro de esa cáscara no quede nada más que... ciencia y luces parpadeantes.",shape=box,color=blue];
		3189 -> 3193;
	3188 [label="Sé que no estás seguro de si los cefalones contienen almas, pero solo puedo rezar a los Luminarias para que... el pobre Otak no sufra.",shape=box,color=blue];
		3188 -> 3192;
	3187 [label="Solo puedo rezar a las Luminarias para que todo lo que quede dentro de ese caparazón no sea más que... ciencia y luces parpadeantes.",shape=box,color=blue];
		3187 -> 3191;
	3194 [label="¿Por qué dejarlo allí, destrozado, esperando a que le permitan morir para encontrar la paz? Solo puedo rezar... para que si hay algún tipo de presencia allí...",shape=box,color=blue];
		3194 -> 3197;
	3193 [label="Y que ningún alma esté atrapada dentro de esa cosa rota, esperando hasta que finalmente se le permita morir para encontrar la paz.",shape=box,color=blue];
		3193 -> 3196;
	3192 [label="Que ningún alma esté atrapada dentro de esa cosa rota, esperando hasta que finalmente se le permita morir para encontrar la paz.",shape=box,color=blue];
		3192 -> 3195;
	3191 [label="Y que ningún alma esté atrapada dentro de esa cosa rota, esperando hasta que finalmente se le permita morir para encontrar la paz.",shape=box,color=blue];
		3191 -> 3195;
	3197 [label="Sea porque permanece allí por elección propia, en una especie de vigilia solitaria...",shape=box,color=blue];
		3197 -> 3200;
	3196 [label="Porque si te equivocas, ¿qué tal si hay un alma dentro de esa jaula contra su voluntad?",shape=box,color=blue];
		3196 -> 3199;
	3195 [label="O si hay algún tipo de presencia allí, es porque él permanece por elección propia, en una especie de vigilia solitaria.",shape=box,color=blue];
		3195 -> 3198;
	3200 [label="Pensar lo contrario es suficiente para poner en duda la bondad de los dioses, non ?",shape=box,color=blue];
