	3139 [label="¡Lobo! ¡Mi lobito! ¡He conocido a Otak! ¡Por fin lo he conocido!",shape=box,color=blue];
		3139 -> 3143;
		3139 -> 3144;
	3140 [label="¡He conocido a Otak! ¡Por fin lo he conocido!",shape=box,color=blue];
		3140 -> 3143;
		3140 -> 3144;
	3142 [label="¡Lobo! ¡Mi lobito! ¡El rostro en la espalda de Monsieur Necraloid! ¡Por fin lo conozco!",shape=box,color=blue];
		3142 -> 3145;
		3142 -> 3146;
		3142 -> 3147;
	3141 [label="¡El rostro en la espalda de Monsieur Necraloid! ¡Por fin lo conozco!",shape=box,color=blue];
		3141 -> 3145;
		3141 -> 3146;
		3141 -> 3147;
	3143 [label="¿Cómo fue tu conversación con él?",shape=box,color=red];
		3143 -> 3148;
	3144 [label="¿Disfrutaste hablando con él?",shape=box,color=red];
		3144 -> 3149;
	3145 [label="¿Conociste a Otak? Vaya... ¿Cómo te fue?",shape=box,color=red];
		3145 -> 3150;
	3146 [label="Me alegra que por fin se hayan conocido. Otak puede ser un poco difícil de explicar.",shape=box,color=red];
		3146 -> 3151;
	3147 [label="Pobre Otak... ¿Cómo les fue?",shape=box,color=red];
		3147 -> 3152;
	3148 [label="Él... se presentó tres veces en la misma conversación, como si nunca nos hubiéramos conocido.",shape=box,color=blue];
		3148 -> 3153;
	3149 [label="Sí, lo hice. Aunque tal vez hizo que me dieran ganas de llorar. Porque se presentó tres veces en la misma conversación, como si nunca nos hubiéramos conocido.",shape=box,color=blue];
		3149 -> 3153;
	3150 [label="¿Por qué no parece agradarte que lo haya conocido?",shape=box,color=blue];
		3150 -> 3154;
		3150 -> 3155;
		3150 -> 3156;
	3151 [label="Sí, supongo que sí. El garabato de un niño en la parte trasera de un autómata. ¡Me pareció dulce y encantador!",shape=box,color=blue];
		3151 -> 3157;
	3152 [label="¡Me pareció dulce y encantador! Pero detrás de su humor, sentí una gran tristeza.",shape=box,color=blue];
		3152 -> 3158;
	3153 [label="Me saludó con la misma forma alegre y segura todas las veces. ¡Pero él sabía que era una Sœur de Sol! ",shape=box,color=blue];
		3153 -> 3159;
	3154 [label="Lo siento. A veces puede molestar a los demás. No es culpa suya.",shape=box,color=red];
		3154 -> 3160;
	3155 [label="No era mi intención. Simplemente puede resultar un poco... desagradable para algunas personas.",shape=box,color=red];
		3155 -> 3160;
	3156 [label="A veces me desespera, eso es todo. ",shape=box,color=red];
		3156 -> 3161;
	3157 [label="Pero detrás de su humor, se esconde una gran tristeza.",shape=box,color=blue];
		3157 -> 3158;
	3158 [label="¿Me contarías la historia del pobre Monsieur Otak?",shape=box,color=blue];
		3158 -> 3162;
	3159 [label="En efecto, ¡sabía mucho sobre las Luminarias! Hablamos largamente de las \"Religiones Antiguas\", como él las llamaba, en los \"días anteriores al Imperio Orokin\".",shape=box,color=blue];
		3159 -> 3163;
	3160 [label="Y espero que sean amables y pacientes con él. Mais par la grâce de Sol.",shape=box,color=blue];
		3160 -> 3164;
	3161 [label="Espero que intentes ser más amable con alguien que está claramente enfermo. En nombre de la gracia de Sol.",shape=box,color=blue];
		3161 -> 3164;
	3162 [label="Otak era un arquimediano, un científico y académico orokin. Lo que le ocurrió no es precisamente una historia feliz.",shape=box,color=red];
		3162 -> 3165;
	3163 [label="Aunque dijo que gran parte de ese conocimiento se había perdido en lo más profundo de los archivos y que estaba estrictamente prohibido. Me hizo jurar guardar el secreto.",shape=box,color=blue];
		3163 -> 3166;
	3164 [label="A todos podría esperarnos un destino parecido. Incluso a ti.",shape=box,color=blue];
		3164 -> 3167;
		3164 -> 3168;
	3165 [label="Todo indica que era un genio y la mente detrás del aprovechamiento de los cristales de argón.",shape=box,color=red];
		3165 -> 3169;
	3166 [label="Me dijo que le preocupaba profundamente que el ejecutor Ballas —quienquiera que fuese— pudiera descubrir mi secta de herejes y me ejecutara.",shape=box,color=blue];
		3166 -> 3170;
		3166 -> 3171;
	3167 [label="Lo siento, simplemente no tengo tiempo para él.",shape=box,color=red];
		3167 -> 3172;
	3168 [label="Tienes razón, lo siento. No debí decir eso.",shape=box,color=red];
		3168 -> 3158;
	3169 [label="Que se extraen del Vacío. Son la razón por la que podemos crear muchos de los poderosos warframes y armas que fabricamos.",shape=box,color=red];
		3169 -> 3173;
	3170 [label="Eso... no va a pasar. Continúa.",shape=box,color=red];
		3170 -> 3174;
	3171 [label="Ballas está muerto... continúa.",shape=box,color=red];
		3171 -> 3174;
	3172 [label="Entonces, lamento haberte hecho desperdiciar aún más.",shape=box,color=blue];
		3172 -> 3175;
	3173 [label="Se especializó en cristalografía. Y sus trabajos se archivaron aquí, en los laboratorios.",shape=box,color=red];
		3173 -> 3176;
	3174 [label="+5 Chemistry",color=orange];
		3174 -> 3177;
	3175 [label="Update boolean MarieOtakComplete",color=orange];
		3175 -> 3178;
	3176 [label="Por alguna razón, no sé por qué, lo convirtieron en un céfalon y le dieron su propio caparazón necraloide.",shape=box,color=red];
		3176 -> 3179;
	3177 [label="Lo sospechaba... Bueno, me preguntó de dónde era, y cuando se lo dije, se rió y dijo: \"¡No, eso es imposible! Y yo debería saberlo, soy...\"",shape=box,color=blue];
		3177 -> 3180;
	3178 [label="Chat ends.",color=orange];
	3179 [label="No todos los cefalones fueron creados como castigo. Pero aquí en Deimos, las cosas salieron... mal, y él resultó gravemente dañado.",shape=box,color=red];
		3179 -> 3181;
	3180 [label="Y entonces... se presentó de nuevo. Y me preguntó si venía de las llanuras con muestras de minerales...",shape=box,color=blue];
		3180 -> 3182;
		3180 -> 3183;
	3181 [label="Pauvre petit...",shape=box,color=blue];
		3181 -> 3184;
	3182 [label="Oh, Marie. Lo siento mucho...",shape=box,color=red];
		3182 -> 3185;
	3183 [label="Sí... ese es Otak.",shape=box,color=red];
		3183 -> 3185;
	3184 [label="Update boolean MarieOtak1",color=orange];
		3184 -> 3143;
		3184 -> 3144;
	3185 [label="Me destroza pensar que no hay nada que se pueda hacer por él.",shape=box,color=blue];
