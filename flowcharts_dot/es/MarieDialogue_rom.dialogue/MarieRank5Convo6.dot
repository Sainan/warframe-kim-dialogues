	3212 [label="¡Ja! Merci. Eso seguro que calma mis lágrimas. Sabes cómo animar a la pequeña y tonta Marie, non ?",shape=box,color=blue];
		3212 -> 3215;
		3212 -> 3216;
	3213 [label="Oui. Tienes razón. Lo son. El mundo está lleno de historias como la de Monsieur Otak, y muchas peores que la suya. No debería lamentarme por una sola. ",shape=box,color=blue];
		3213 -> 3217;
	3214 [label="Merci. Bueno, ya no quiero estarlo. ¡Voy a hacer algo más alegre! Creo que el tanque de M'sieur Fibonacci necesita una buena limpieza.",shape=box,color=blue];
		3214 -> 3218;
	3215 [label="No estás siendo para nada tonta. Yo siento lo mismo.",shape=box,color=red];
