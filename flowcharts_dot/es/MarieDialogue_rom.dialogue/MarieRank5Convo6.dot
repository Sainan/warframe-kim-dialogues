	j3097375491 [label="Check boolean MarieDating",color=orange];
		j3097375491 -> j2878068369 [label=true,color=green];
		j3097375491 -> j1629047035 [label=false,color=brown];
	j472954622 [label="¡Lobo! ¡Mi lobito! ¡He conocido a Otak! ¡Por fin lo he conocido!",shape=box,color=blue];
		j472954622 -> j3315081086;
		j472954622 -> j3576293767;
	j1112319604 [label="¡He conocido a Otak! ¡Por fin lo he conocido!",shape=box,color=blue];
		j1112319604 -> j3315081086;
		j1112319604 -> j3576293767;
	j2878068369 [label="¡Lobo! ¡Mi lobito! ¡El rostro en la espalda de Monsieur Necraloid! ¡Por fin lo conozco!",shape=box,color=blue];
		j2878068369 -> j3195716131;
		j2878068369 -> j2639228187;
		j2878068369 -> j2801198300;
	j1629047035 [label="¡El rostro en la espalda de Monsieur Necraloid! ¡Por fin lo conozco!",shape=box,color=blue];
		j1629047035 -> j3195716131;
		j1629047035 -> j2639228187;
		j1629047035 -> j2801198300;
	j3315081086 [label="¿Cómo fue tu conversación con él?",shape=box,color=red];
		j3315081086 -> j3127598210;
	j3576293767 [label="¿Disfrutaste hablando con él?",shape=box,color=red];
		j3576293767 -> j384266565;
	j3195716131 [label="¿Conociste a Otak? Vaya... ¿Cómo te fue?",shape=box,color=red];
		j3195716131 -> j3953133731;
	j2639228187 [label="Me alegra que por fin se hayan conocido. Otak puede ser un poco difícil de explicar.",shape=box,color=red];
		j2639228187 -> j4121887892;
	j2801198300 [label="Pobre Otak... ¿Cómo les fue?",shape=box,color=red];
		j2801198300 -> j2946196721;
	j3127598210 [label="Él... se presentó tres veces en la misma conversación, como si nunca nos hubiéramos conocido.",shape=box,color=blue];
		j3127598210 -> j1487435666;
	j384266565 [label="Sí, lo hice. Aunque tal vez hizo que me dieran ganas de llorar. Porque se presentó tres veces en la misma conversación, como si nunca nos hubiéramos conocido.",shape=box,color=blue];
		j384266565 -> j1487435666;
	j3953133731 [label="¿Por qué no parece agradarte que lo haya conocido?",shape=box,color=blue];
		j3953133731 -> j3958282074;
		j3953133731 -> j792188294;
		j3953133731 -> j1409711072;
	j4121887892 [label="Sí, supongo que sí. El garabato de un niño en la parte trasera de un autómata. ¡Me pareció dulce y encantador!",shape=box,color=blue];
		j4121887892 -> j3946135046;
	j2946196721 [label="¡Me pareció dulce y encantador! Pero detrás de su humor, sentí una gran tristeza.",shape=box,color=blue];
		j2946196721 -> j1051761504;
	j1487435666 [label="Me saludó con la misma forma alegre y segura todas las veces. ¡Pero él sabía que era una Sœur de Sol! ",shape=box,color=blue];
		j1487435666 -> j2313995638;
	j3958282074 [label="Lo siento. A veces puede molestar a los demás. No es culpa suya.",shape=box,color=red];
		j3958282074 -> j1130487107;
	j792188294 [label="No era mi intención. Simplemente puede resultar un poco... desagradable para algunas personas.",shape=box,color=red];
		j792188294 -> j1130487107;
	j1409711072 [label="A veces me desespera, eso es todo. ",shape=box,color=red];
		j1409711072 -> j2877348955;
	j3946135046 [label="Pero detrás de su humor, se esconde una gran tristeza.",shape=box,color=blue];
		j3946135046 -> j1051761504;
	j1051761504 [label="¿Me contarías la historia del pobre Monsieur Otak?",shape=box,color=blue];
		j1051761504 -> j3527254589;
	j2313995638 [label="En efecto, ¡sabía mucho sobre las Luminarias! Hablamos largamente de las \"Religiones Antiguas\", como él las llamaba, en los \"días anteriores al Imperio Orokin\".",shape=box,color=blue];
		j2313995638 -> j2022568242;
	j1130487107 [label="Y espero que sean amables y pacientes con él. Mais par la grâce de Sol.",shape=box,color=blue];
		j1130487107 -> j1641465205;
	j2877348955 [label="Espero que intentes ser más amable con alguien que está claramente enfermo. En nombre de la gracia de Sol.",shape=box,color=blue];
		j2877348955 -> j1641465205;
	j3527254589 [label="Otak era un arquimediano, un científico y académico orokin. Lo que le ocurrió no es precisamente una historia feliz.",shape=box,color=red];
		j3527254589 -> j3624167203;
	j2022568242 [label="Aunque dijo que gran parte de ese conocimiento se había perdido en lo más profundo de los archivos y que estaba estrictamente prohibido. Me hizo jurar guardar el secreto.",shape=box,color=blue];
		j2022568242 -> j590453369;
	j1641465205 [label="A todos podría esperarnos un destino parecido. Incluso a ti.",shape=box,color=blue];
		j1641465205 -> j452714239;
		j1641465205 -> j534364032;
	j3624167203 [label="Todo indica que era un genio y la mente detrás del aprovechamiento de los cristales de argón.",shape=box,color=red];
		j3624167203 -> j641890579;
	j590453369 [label="Me dijo que le preocupaba profundamente que el ejecutor Ballas —quienquiera que fuese— pudiera descubrir mi secta de herejes y me ejecutara.",shape=box,color=blue];
		j590453369 -> j1807040981;
		j590453369 -> j304061223;
	j452714239 [label="Lo siento, simplemente no tengo tiempo para él.",shape=box,color=red];
		j452714239 -> j636267791;
	j534364032 [label="Tienes razón, lo siento. No debí decir eso.",shape=box,color=red];
		j534364032 -> j1051761504;
	j641890579 [label="Que se extraen del Vacío. Son la razón por la que podemos crear muchos de los poderosos warframes y armas que fabricamos.",shape=box,color=red];
		j641890579 -> j516439942;
	j1807040981 [label="Eso... no va a pasar. Continúa.",shape=box,color=red];
		j1807040981 -> j262455787;
	j304061223 [label="Ballas está muerto... continúa.",shape=box,color=red];
		j304061223 -> j262455787;
	j636267791 [label="Entonces, lamento haberte hecho desperdiciar aún más.",shape=box,color=blue];
		j636267791 -> j3007723528;
	j516439942 [label="Se especializó en cristalografía. Y sus trabajos se archivaron aquí, en los laboratorios.",shape=box,color=red];
		j516439942 -> j2744745683;
	j262455787 [label="+5 Chemistry",color=orange];
		j262455787 -> j3901596324;
	j3007723528 [label="Boolean MarieOtakComplete is now true.",color=orange];
		j3007723528 -> "Chat ends.";
	j2744745683 [label="Por alguna razón, no sé por qué, lo convirtieron en un céfalon y le dieron su propio caparazón necraloide.",shape=box,color=red];
		j2744745683 -> j3096727211;
	j3901596324 [label="Lo sospechaba... Bueno, me preguntó de dónde era, y cuando se lo dije, se rió y dijo: \"¡No, eso es imposible! Y yo debería saberlo, soy...\"",shape=box,color=blue];
		j3901596324 -> j2411021430;
	j3096727211 [label="No todos los cefalones fueron creados como castigo. Pero aquí en Deimos, las cosas salieron... mal, y él resultó gravemente dañado.",shape=box,color=red];
		j3096727211 -> j646397063;
	j2411021430 [label="Y entonces... se presentó de nuevo. Y me preguntó si venía de las llanuras con muestras de minerales...",shape=box,color=blue];
		j2411021430 -> j3733527207;
		j2411021430 -> j3625448284;
	j646397063 [label="Pauvre petit...",shape=box,color=blue];
		j646397063 -> j1698645168;
	j3733527207 [label="Oh, Marie. Lo siento mucho...",shape=box,color=red];
		j3733527207 -> j1738116175;
	j3625448284 [label="Sí... ese es Otak.",shape=box,color=red];
		j3625448284 -> j1738116175;
	j1698645168 [label="Boolean MarieOtak1 is now true.",color=orange];
		j1698645168 -> j3315081086;
		j1698645168 -> j3576293767;
	j1738116175 [label="Me destroza pensar que no hay nada que se pueda hacer por él.",shape=box,color=blue];
		j1738116175 -> j1970966774;
	j1970966774 [label="Evaluate expressions",color=orange];
		j1970966774 -> j3868814356 [label="MarieCephalonSoul",color=purple];
		j1970966774 -> j3452886177 [label="MarieCephalonNoSoul",color=purple];
		j1970966774 -> j3222145164 [label="MarieCephalonUnsure",color=purple];
		j1970966774 -> j3804265977 [label="false",color=purple];
	j3868814356 [label="¡Oh, Luminarias! ¿Qué clase de infierno le han preparado para mantener su alma atrapada en esa jaula de ciencia y luces parpadeantes?",shape=box,color=blue];
		j3868814356 -> j3285022818;
	j3452886177 [label="Solo puedo rezar a las Luminarias para que tengas razón y que dentro de esa cáscara no quede nada más que... ciencia y luces parpadeantes.",shape=box,color=blue];
		j3452886177 -> j19541524;
	j3222145164 [label="Sé que no estás seguro de si los cefalones contienen almas, pero solo puedo rezar a los Luminarias para que... el pobre Otak no sufra.",shape=box,color=blue];
		j3222145164 -> j1738459260;
	j3804265977 [label="Solo puedo rezar a las Luminarias para que todo lo que quede dentro de ese caparazón no sea más que... ciencia y luces parpadeantes.",shape=box,color=blue];
		j3804265977 -> j1938764461;
	j3285022818 [label="¿Por qué dejarlo allí, destrozado, esperando a que le permitan morir para encontrar la paz? Solo puedo rezar... para que si hay algún tipo de presencia allí...",shape=box,color=blue];
		j3285022818 -> j3924230889;
	j19541524 [label="Y que ningún alma esté atrapada dentro de esa cosa rota, esperando hasta que finalmente se le permita morir para encontrar la paz.",shape=box,color=blue];
		j19541524 -> j539209518;
	j1738459260 [label="Que ningún alma esté atrapada dentro de esa cosa rota, esperando hasta que finalmente se le permita morir para encontrar la paz.",shape=box,color=blue];
		j1738459260 -> j235204122;
	j1938764461 [label="Y que ningún alma esté atrapada dentro de esa cosa rota, esperando hasta que finalmente se le permita morir para encontrar la paz.",shape=box,color=blue];
		j1938764461 -> j235204122;
	j3924230889 [label="Sea porque permanece allí por elección propia, en una especie de vigilia solitaria...",shape=box,color=blue];
		j3924230889 -> j2053175697;
	j539209518 [label="Porque si te equivocas, ¿qué tal si hay un alma dentro de esa jaula contra su voluntad?",shape=box,color=blue];
		j539209518 -> j3947995352;
	j235204122 [label="O si hay algún tipo de presencia allí, es porque él permanece por elección propia, en una especie de vigilia solitaria.",shape=box,color=blue];
		j235204122 -> j2053175697;
	j2053175697 [label="Pensar lo contrario es suficiente para poner en duda la bondad de los dioses, non ?",shape=box,color=blue];
		j2053175697 -> j141329864;
	j3947995352 [label="Es suficiente para poner en duda la bondad de los dioses, non ?",shape=box,color=blue];
		j3947995352 -> j141329864;
	j141329864 [label="¿Y eso en dónde me dejaría?",shape=box,color=blue];
		j141329864 -> j4112851034;
	j4112851034 [label="Perdóname... je suis mélancolique aujourd'hui.",shape=box,color=blue];
		j4112851034 -> j4190999030;
	j4190999030 [label="Evaluate expressions",color=orange];
		j4190999030 -> j662098506 [label="MarieRoathePastry1",color=purple];
		j4190999030 -> j2112648055 [label="MarieRoathePastry1",color=purple];
