digraph {
	"MarieRank3Convo2 begins." [color=orange];
		"MarieRank3Convo2 begins." -> j3102612293;
	j3102612293 [label="Boolean MarieLyonAvailable is now true.",color=orange];
		j3102612293 -> j369807617;
	j369807617 [label="Check boolean LoidFamilyComplete",color=orange];
		j369807617 -> j3253850962 [label=true,color=green];
		j369807617 -> j1668831657 [label=false,color=brown];
	j3253850962 [label="Espero que no pienses que estoy enferma... pero a veces tengo una sensación muy extraña, como si ya hubiera hecho esto antes.",shape=box,color=blue];
		j3253850962 -> j3610622736;
	j1668831657 [label="Check boolean MarieFamily1",color=orange];
		j1668831657 -> j996692354 [label=true,color=green];
		j1668831657 -> j2413701185 [label=false,color=brown];
	j3610622736 [label="Tuve estas conversaciones... conocí a estas personas... aunque es imposible, ¿non?",shape=box,color=blue];
		j3610622736 -> j904747097;
	j996692354 [label="Me contarás más sobre la famile du Cardinal ? Estoy fascinada por saber de su pasado.",shape=box,color=blue];
		j996692354 -> j2941153087;
		j996692354 -> j3550887668;
		j996692354 -> j202800200;
	j2413701185 [label="Me contarás sobre la famile de le Cardinal ? Estoy fascinada por saber de su pasado.",shape=box,color=blue];
		j2413701185 -> j2941153087;
		j2413701185 -> j3550887668;
		j2413701185 -> j202800200;
	j904747097 [label="+20 Chemistry",color=orange];
		j904747097 -> j2567688268;
	j2941153087 [label="Te diré todo lo que sé, pero me temo que no sé tanto como tú crees.",shape=box,color=red];
		j2941153087 -> j2511272639;
	j3550887668 [label="Oh. Claro, pero... ¿No sería Loid la mejor persona con quien hablar?",shape=box,color=red];
		j3550887668 -> j54489465;
	j202800200 [label="[Fin]",shape=box,color=red];
		j202800200 -> "Chat ends.";
	j2567688268 [label="Lo llamamos déjà vu. Debe ser por el suero y el viaje en el tiempo. C'est la vie!",shape=box,color=blue];
		j2567688268 -> "Chat ends.";
	j2511272639 [label="Lo que sea que me puedas contar, lo atesoraré. Promis !",shape=box,color=blue];
		j2511272639 -> j3075788809;
	j54489465 [label="Hablando de le Cardinal... parace ser que eso lastima profundamente a Monsieur Loid. No quiero hablarlo tanto con él.",shape=box,color=blue];
		j54489465 -> j3075788809;
	"Chat ends." [color=orange];
	j3075788809 [label="Especialmente por como lo hago avec une certaine joie, algo que nadie más parece hacer.",shape=box,color=blue];
		j3075788809 -> j2416893739;
		j3075788809 -> j917608427;
	j2416893739 [label="¿De quién quieres saber?",shape=box,color=red];
		j2416893739 -> j3585492744;
	j917608427 [label="Bueno, arriba están Madre, Padre, Hijo, Hija y Abuela.",shape=box,color=red];
		j917608427 -> j3585492744;
	j3585492744 [label="Acordemos una cosa primero, ¿está bien? El demonio se ríe de mí cada vez que pregunto, como si fuera un chiste local. Grand-mère. Abuela.",shape=box,color=blue];
		j3585492744 -> j1437951975;
	j1437951975 [label="Esa no es la esposa de le Cardinal, non ?",shape=box,color=blue];
		j1437951975 -> j2446265877;
	j2446265877 [label="No, esa es la madre de Padre. La suegra de Madre.",shape=box,color=red];
		j2446265877 -> j49350844;
	j49350844 [label="Je... vois. Y... ¿Por qué no se llaman por sus nombres? Ne serait-ce pas plus simple ?",shape=box,color=blue];
		j49350844 -> j543890670;
		j49350844 -> j2820118809;
	j543890670 [label="¿Quieres la versión larga?",shape=box,color=red];
		j543890670 -> j2086190767;
	j2820118809 [label="Te contaré la versión corta.",shape=box,color=red];
		j2820118809 -> j4161788082;
	j2086190767 [label="Oui ! No tengo otro lugar donde estar por un tiempo.",shape=box,color=blue];
		j2086190767 -> j3907726625;
	j4161788082 [label="La familia que está arriba fue atrapada aquí cuando el imperio Orokin colapso. Hijo, el nieto de Entrati, dejó que entrara la Infestación.",shape=box,color=red];
		j4161788082 -> j1155464355;
	j3907726625 [label="Bueno, estamos en la luna llamada Deimos. Y la bomba biológica fue detonada aquí, tiempo atrás, en un intento desesperado de repeler a los Conscientes.",shape=box,color=red];
		j3907726625 -> j1952883984;
	j1155464355 [label="Par Sol ! ¿A propósito?",shape=box,color=blue];
		j1155464355 -> j385755729;
	j1952883984 [label="¿Aquellos con los que los orokin estuvieron en guerra hace tiempo? Aquellos que vemos en la Oscuridad Refractaria con el diablo, oui ?",shape=box,color=blue];
		j1952883984 -> j428926501;
	j385755729 [label="Check /Lotus/Scripts/1999/DialogueScriptNodes.lua:IsSyndicateRank",color=orange];
		j385755729 -> j1082171053 [label=true,color=green];
		j385755729 -> j4081707093 [label=true,color=green];
		j385755729 -> j4081707093 [label=false,color=brown];
		j385755729 -> j109498399 [label=false,color=brown];
	j428926501 [label="Sí. Ellos intentaron aprovecharse de la Infestación para pelar contra los Conscientes. Pero Deimos fue invadido. Se encerraron en el Necralisk, el cual está arriba de nosotros, para refugiarse.",shape=box,color=red];
		j428926501 -> j2113581076;
	j1082171053 [label=" No, creo que fue un accidente. Me imagino que tenía buenas intenciones.",shape=box,color=red];
		j1082171053 -> j4013176919;
	j4081707093 [label="Aún no sé la verdad, pero me reservo mi juicio hasta saber más.",shape=box,color=red];
		j4081707093 -> j4013176919;
	j109498399 [label="Aún no sé la verdad, pero es arrogante, es lo que te puedo decir.",shape=box,color=red];
		j109498399 -> j17203796;
	j2113581076 [label="Sin embargo, Hijo, el nieto de Entrati, tenía la intención de intentar preservar y estudiar los animales infestados.",shape=box,color=red];
		j2113581076 -> j635350016;
	j4013176919 [label="+10 Chemistry",color=orange];
		j4013176919 -> j580246137;
	j17203796 [label="Qué pena. Espero que eso no sea verdad, por su bien y el nuestro. Por favor continua.",shape=box,color=blue];
		j17203796 -> j2007405887;
	j635350016 [label="Oh, Sol... ¿Tenía buenas intenciones ?",shape=box,color=blue];
		j635350016 -> j240603373;
	j580246137 [label="Muy amable de tu parte. Continuez, s'il vous plaît.",shape=box,color=blue];
		j580246137 -> j2007405887;
	j2007405887 [label="Bueno, atrapado en el Necralisk, y consumido por su dolor y sin el imperio Orokin para rescatarlo, y ahora con la Infestación filtrándose...",shape=box,color=red];
		j2007405887 -> j1078716431;
	j240603373 [label="Check /Lotus/Scripts/1999/DialogueScriptNodes.lua:IsSyndicateRank",color=orange];
		j240603373 -> j3014482536 [label=true,color=green];
		j240603373 -> j4184312206 [label=true,color=green];
		j240603373 -> j3645661683 [label=true,color=green];
		j240603373 -> j3014482536 [label=false,color=brown];
		j240603373 -> j4184312206 [label=false,color=brown];
		j240603373 -> j1028439186 [label=false,color=brown];
	j1078716431 [label="Se atacaron entre sí. Se destrozaron los unos a los otros desde el interior. Y la Infestación hizo el resto. Quitándoles sus nombres. ",shape=box,color=red];
		j1078716431 -> j3573862577;
	j3014482536 [label="Sí, creo que lo hizo. Me imagino que realmente le importan las criaturas.",shape=box,color=red];
		j3014482536 -> j4049916463;
	j4184312206 [label="Tristemente, no importó, el imprudente daño ya estaba hecho.",shape=box,color=red];
		j4184312206 -> j2579215165;
	j3645661683 [label="No, fue la arrogancia la que lo inspiró. Aunque afirme que fue un accidente.",shape=box,color=red];
		j3645661683 -> j17203796;
	j1028439186 [label="Aún no sé la verdad, pero es arrogante, es lo que te puedo decir.",shape=box,color=red];
		j1028439186 -> j17203796;
	j3573862577 [label="Es la forma máxima de crueldad, carecer de un nombre...",shape=box,color=blue];
		j3573862577 -> j482800561;
	j4049916463 [label="+10 Chemistry",color=orange];
		j4049916463 -> j2289072063;
	j2579215165 [label="+5 Chemistry",color=orange];
		j2579215165 -> j3446944131;
	j482800561 [label="Boolean MarieFamily2 is now true.",color=orange];
		j482800561 -> j805264214;
		j482800561 -> j4269785273;
		j482800561 -> j1433839958;
	j2289072063 [label="Me pregunto qué pensaría de los Cavia... es una lástima que no pueda conocerlos...",shape=box,color=blue];
		j2289072063 -> j2449564927;
		j2289072063 -> j3189342745;
	j3446944131 [label="Si solo la pureza de las intenciones de uno fueran todo lo que importara, el mundo sería un hermoso lugar, non ? C'est la vie.",shape=box,color=blue];
		j3446944131 -> j2523045346;
	j805264214 [label="A menos que renuncies a él, como lo hizo Abuela.",shape=box,color=red];
		j805264214 -> j159151844;
	j4269785273 [label="La verdad no es tan malo, te acostumbras.",shape=box,color=red];
		j4269785273 -> j2747078256;
	j1433839958 [label="Los animales no tienen nombres, y parece que están perfectamente bien con eso. Les damos nombres simplemente por nuestro propio bien.",shape=box,color=red];
		j1433839958 -> j1993280414;
	j2449564927 [label="Me da gracia la idea. Pero no creo que sea prudente.",shape=box,color=red];
		j2449564927 -> j3339742247;
	j3189342745 [label="Espero que eso pase algún día. De verdad eso espero.",shape=box,color=red];
		j3189342745 -> j1526667533;
	j2523045346 [label="Et ensuite ?",shape=box,color=blue];
		j2523045346 -> j2007405887;
	j159151844 [label="+5 Chemistry",color=orange];
		j159151844 -> j836472000;
	j2747078256 [label="¡Aaah! Quelle horreur ! ¡No fue mi intención! ¡Oh, estoy mortificada! Lo siento, perdóname, no fue mi intención, ¡oh, soy una tonta!",shape=box,color=blue];
		j2747078256 -> j2674560805;
		j2747078256 -> j426573333;
	j1993280414 [label="+5 Chemistry",color=orange];
		j1993280414 -> j840503392;
	j3339742247 [label="¿Y por qué no?",shape=box,color=blue];
		j3339742247 -> j3699665510;
		j3339742247 -> j2626712440;
	j1526667533 [label="Add 1 to Family counter",color=orange];
		j1526667533 -> j788680427;
	j836472000 [label="Ahora suena como una dama que me encantaría conocer... ",shape=box,color=blue];
		j836472000 -> j1236075871;
	j2674560805 [label="¿Cómo me lo compensarás?",shape=box,color=red];
		j2674560805 -> j2771636711;
	j426573333 [label="Está bien, solo te estoy molestando. No estoy enojado.",shape=box,color=red];
		j426573333 -> j2331207027;
	j840503392 [label="¡Es cierto! Nunca lo pensé de esa manera. Y puedes escoger el que tú quieras. Qué liberador, en cierto sentido.",shape=box,color=blue];
		j840503392 -> j1236075871;
	j3699665510 [label="Me temo que una mitad vería a la otra mitad como \"la otra familia\".",shape=box,color=red];
		j3699665510 -> j1148210988;
	j2626712440 [label="La situación allá arriba es... frágil en el mejor de los días. No quiero molestarlos.",shape=box,color=red];
		j2626712440 -> j1167163944;
	j788680427 [label="Check /Lotus/Scripts/1999/DialogueScriptNodes.lua:IsSyndicateRank",color=orange];
		j788680427 -> j2551043753 [label=true,color=green];
		j788680427 -> j104660717 [label=false,color=brown];
	j1236075871 [label="Esta ha sido una conversación maravillosa, pero me temo que es mi turno de servir la merienda. ¡Monsieur Loid me está enseñando a su manera como servir apropiadamente el té!",shape=box,color=blue];
		j1236075871 -> "Chat ends.";
	j2771636711 [label="Maintenant, vous parlez aussi mal que le diable. No, no voy a caer en tus trucos.",shape=box,color=blue];
		j2771636711 -> "Chat ends.";
	j2331207027 [label="+5 Chemistry",color=orange];
		j2331207027 -> j2250880590;
	j1148210988 [label="Add 1 to Family counter",color=orange];
		j1148210988 -> j717607568;
	j1167163944 [label="Estarías sorprendido de que tan resiliente es el alma. Y aquellos que ahora me rodean son muy viejos, magullados por el tiempo.",shape=box,color=blue];
		j1167163944 -> j265673264;
	j2551043753 [label="Eso se puede arreglar. Más fácil de lo que tal vez te puedas imaginar. Solo debemos de pensar en como hacerlo. ",shape=box,color=blue];
		j2551043753 -> j388237097;
		j2551043753 -> j2626712440;
	j104660717 [label="Oui ? ¿Y cómo es que tú y tu copia minúscula funcionan con la famile de arriba?",shape=box,color=blue];
		j104660717 -> j524159983;
		j104660717 -> j2626712440;
	j2250880590 [label="Oh, loué soit Sol ! Pero esto me hace preguntarme... ¿Sabes cómo es que recibiste tu apodo? ¿\"Le Viajero\"?",shape=box,color=blue];
		j2250880590 -> j824281877;
		j2250880590 -> j1772803383;
	j717607568 [label="+5 Chemistry",color=orange];
		j717607568 -> j2252406451;
	j265673264 [label="+5 Chemistry",color=orange];
		j265673264 -> j1940066740;
	j388237097 [label="Sólo tenemos que ser cuidadosos. Me temo que una mitad vería a la otra mitad como \"la otra familia\".",shape=box,color=red];
		j388237097 -> j1148210988;
	j524159983 [label="Lentamente. Con mucho cuidado. Me temo que una mitad vería a la otra mitad como \"la otra familia\".",shape=box,color=red];
		j524159983 -> j1148210988;
	j824281877 [label="Espero haberlo escogido yo.",shape=box,color=red];
		j824281877 -> j4098450095;
	j1772803383 [label="La verdad no me acuerdo.",shape=box,color=red];
		j1772803383 -> j1595556780;
	j2252406451 [label="Oh... ¡Par Sol, parece ser que lo resolviste!",shape=box,color=blue];
		j2252406451 -> j3341298965;
	j1940066740 [label="Los has sorprendido tantas veces. Déjalos que te sorprendan esta vez.",shape=box,color=blue];
		j1940066740 -> j2259225933;
	j4098450095 [label="Qué liberador sería eso ! Escoger mi propio nombre. En la Cathédrale, no podía ni siquiera elegir mi propia ropa. Ja !",shape=box,color=blue];
		j4098450095 -> j1236075871;
	j1595556780 [label="¡Traes muchos mystères contigo! ",shape=box,color=blue];
		j1595556780 -> j1236075871;
	j3341298965 [label="Boolean MarieFamilyOther is now true.",color=orange];
		j3341298965 -> j3586995920;
	j2259225933 [label="Pero por favor, por favor, s'il vous plaît, continua con tu historia. Tu pequeña loba Marie debe conocer a su presa antes de cazar como es debido, non ?",shape=box,color=blue];
		j2259225933 -> j3281634099;
		j2259225933 -> j1396425181;
		j2259225933 -> j851298644;
	j3586995920 [label="Estoy fuera de mí de tanta emoción - je suis assise ici, remuant sur ma chaise !",shape=box,color=blue];
		j3586995920 -> j2259225933;
	j3281634099 [label="¿Dónde estaba?",shape=box,color=red];
		j3281634099 -> j4099053778;
	j1396425181 [label="Eso fue un poco malvado de tu parte, ¿no?",shape=box,color=red];
		j1396425181 -> j1311007057;
	j851298644 [label="Quizás desearía que me cazaras...",shape=box,color=red];
		j851298644 -> j2276008143;
	j4099053778 [label="Hijo había invitado a los Animaux Infestés a acercarse demasiado.",shape=box,color=blue];
		j4099053778 -> j2007405887;
	j1311007057 [label="Peut-être ! ¿Pero qué hay de malo en un poco de crueldad por un bien, hm?",shape=box,color=blue];
		j1311007057 -> j3761602922;
		j1311007057 -> j2194852073;
	j2276008143 [label="Boolean DrifterMarie is now true.",color=orange];
		j2276008143 -> j2993521512;
	j3761602922 [label="Cierto... de todos modos, regresando a la historia.",shape=box,color=red];
		j3761602922 -> j2007405887;
	j2194852073 [label="No lo tomes a mal. Lo disfruté.",shape=box,color=red];
		j2194852073 -> j61035793;
	j2993521512 [label="¡Me arruinarás! Acabo de gritar y Monsieur Loid me preguntó si estaba bien. Tuve que mentir y decir que vi un ratón, ¡solo para que me dijera que no hay ratones en este tiempo!",shape=box,color=blue];
		j2993521512 -> j2616478708;
	j61035793 [label="¡Ja! Sabía que lo disfrutarías. Bueno, suficiente de tus tonterías, y regresa a la historia. Hijo había invitado a los Animaux Infestés a acercarse demasiado, oui ?",shape=box,color=blue];
		j61035793 -> j2007405887;
	j2616478708 [label="+5 Chemistry",color=orange];
		j2616478708 -> j2189726668;
	j2189726668 [label="Quelle méchanceté, tu es terrible ! Je te déteste et tu me fais rougir maintenant !",shape=box,color=blue];
		j2189726668 -> j3106048025;
		j2189726668 -> j3761602922;
	j3106048025 [label="¿Estás enojada conmigo?",shape=box,color=red];
		j3106048025 -> j1826661451;
	j1826661451 [label="¡No! ¡Simplemente continúa tu historia!",shape=box,color=blue];
		j1826661451 -> j2007405887;
}