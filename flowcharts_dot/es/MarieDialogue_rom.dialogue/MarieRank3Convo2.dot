		2923 -> 1016 [label=false,color=brown];
	2924 [label="Espero que no pienses que estoy enferma... pero a veces tengo una sensación muy extraña, como si ya hubiera hecho esto antes.",shape=box,color=blue];
		2924 -> 2925;
	1016 [label="Check boolean MarieFamily1",color=orange];
		1016 -> 1017 [label=true,color=green];
		1016 -> 1018 [label=false,color=brown];
	2925 [label="Tuve estas conversaciones... conocí a estas personas... aunque es imposible, ¿non?",shape=box,color=blue];
		2925 -> 2926;
	1017 [label="Me contarás más sobre la famile du Cardinal ? Estoy fascinada por saber de su pasado.",shape=box,color=blue];
		1017 -> 1020;
		1017 -> 1021;
		1017 -> 1019;
	1018 [label="Me contarás sobre la famile de le Cardinal ? Estoy fascinada por saber de su pasado.",shape=box,color=blue];
		1018 -> 1020;
		1018 -> 1021;
		1018 -> 1019;
	2926 [label="+20 Chemistry",color=orange];
		2926 -> 2927;
	1020 [label="Te diré todo lo que sé, pero me temo que no sé tanto como tú crees.",shape=box,color=red];
		1020 -> 1023;
	1021 [label="Oh. Claro, pero... ¿No sería Loid la mejor persona con quien hablar?",shape=box,color=red];
		1021 -> 1024;
	1019 [label="[Fin]",shape=box,color=red];
		1019 -> 1022;
	2927 [label="Lo llamamos déjà vu. Debe ser por el suero y el viaje en el tiempo. C'est la vie!",shape=box,color=blue];
		2927 -> 2928;
	1023 [label="Lo que sea que me puedas contar, lo atesoraré. Promis !",shape=box,color=blue];
		1023 -> 1025;
	1024 [label="Hablando de le Cardinal... parace ser que eso lastima profundamente a Monsieur Loid. No quiero hablarlo tanto con él.",shape=box,color=blue];
		1024 -> 1025;
	1022 [label="Chat ends.",color=orange];
	2928 [label="Chat ends.",color=orange];
	1025 [label="Especialmente por como lo hago avec une certaine joie, algo que nadie más parece hacer.",shape=box,color=blue];
		1025 -> 1026;
		1025 -> 1027;
	1026 [label="¿De quién quieres saber?",shape=box,color=red];
		1026 -> 1028;
	1027 [label="Bueno, arriba están Madre, Padre, Hijo, Hija y Abuela.",shape=box,color=red];
		1027 -> 1028;
	1028 [label="Acordemos una cosa primero, ¿está bien? El demonio se ríe de mí cada vez que pregunto, como si fuera un chiste local. Grand-mère. Abuela.",shape=box,color=blue];
		1028 -> 1029;
	1029 [label="Esa no es la esposa de le Cardinal, non ?",shape=box,color=blue];
		1029 -> 1030;
	1030 [label="No, esa es la madre de Padre. La suegra de Madre.",shape=box,color=red];
		1030 -> 1031;
	1031 [label="Je... vois. Y... ¿Por qué no se llaman por sus nombres? Ne serait-ce pas plus simple ?",shape=box,color=blue];
		1031 -> 1032;
		1031 -> 1033;
	1032 [label="¿Quieres la versión larga?",shape=box,color=red];
		1032 -> 1034;
	1033 [label="Te contaré la versión corta.",shape=box,color=red];
		1033 -> 1035;
	1034 [label="Oui ! No tengo otro lugar donde estar por un tiempo.",shape=box,color=blue];
		1034 -> 1036;
	1035 [label="La familia que está arriba fue atrapada aquí cuando el imperio Orokin colapso. Hijo, el nieto de Entrati, dejó que entrara la Infestación.",shape=box,color=red];
		1035 -> 1037;
	1036 [label="Bueno, estamos en la luna llamada Deimos. Y la bomba biológica fue detonada aquí, tiempo atrás, en un intento desesperado de repeler a los Conscientes.",shape=box,color=red];
		1036 -> 1038;
	1037 [label="Par Sol ! ¿A propósito?",shape=box,color=blue];
		1037 -> 1039;
	1038 [label="¿Aquellos con los que los orokin estuvieron en guerra hace tiempo? Aquellos que vemos en la Oscuridad Refractaria con el diablo, oui ?",shape=box,color=blue];
		1038 -> 1040;
	1039 [label="Check /Lotus/Scripts/1999/DialogueScriptNodes.lua:IsSyndicateRank",color=orange];
		1039 -> 1041 [label=true,color=green];
		1039 -> 1042 [label=true,color=green];
		1039 -> 1042 [label=false,color=brown];
		1039 -> 1043 [label=false,color=brown];
	1040 [label="Sí. Ellos intentaron aprovecharse de la Infestación para pelar contra los Conscientes. Pero Deimos fue invadido. Se encerraron en el Necralisk, el cual está arriba de nosotros, para refugiarse.",shape=box,color=red];
		1040 -> 1044;
	1041 [label=" No, creo que fue un accidente. Me imagino que tenía buenas intenciones.",shape=box,color=red];
		1041 -> 1045;
	1042 [label="Aún no sé la verdad, pero me reservo mi juicio hasta saber más.",shape=box,color=red];
		1042 -> 1045;
	1043 [label="Aún no sé la verdad, pero es arrogante, es lo que te puedo decir.",shape=box,color=red];
		1043 -> 1046;
	1044 [label="Sin embargo, Hijo, el nieto de Entrati, tenía la intención de intentar preservar y estudiar los animales infestados.",shape=box,color=red];
		1044 -> 1047;
	1045 [label="+10 Chemistry",color=orange];
		1045 -> 1048;
	1046 [label="Qué pena. Espero que eso no sea verdad, por su bien y el nuestro. Por favor continua.",shape=box,color=blue];
		1046 -> 1049;
	1047 [label="Oh, Sol... ¿Tenía buenas intenciones ?",shape=box,color=blue];
		1047 -> 1076;
	1048 [label="Muy amable de tu parte. Continuez, s'il vous plaît.",shape=box,color=blue];
		1048 -> 1049;
	1049 [label="Bueno, atrapado en el Necralisk, y consumido por su dolor y sin el imperio Orokin para rescatarlo, y ahora con la Infestación filtrándose...",shape=box,color=red];
		1049 -> 1053;
	1076 [label="Check /Lotus/Scripts/1999/DialogueScriptNodes.lua:IsSyndicateRank",color=orange];
		1076 -> 1051 [label=true,color=green];
		1076 -> 1052 [label=true,color=green];
		1076 -> 1055 [label=true,color=green];
		1076 -> 1051 [label=false,color=brown];
		1076 -> 1052 [label=false,color=brown];
		1076 -> 1054 [label=false,color=brown];
	1053 [label="Se atacaron entre sí. Se destrozaron los unos a los otros desde el interior. Y la Infestación hizo el resto. Quitándoles sus nombres. ",shape=box,color=red];
		1053 -> 1058;
	1051 [label="Sí, creo que lo hizo. Me imagino que realmente le importan las criaturas.",shape=box,color=red];
		1051 -> 1056;
	1052 [label="Tristemente, no importó, el imprudente daño ya estaba hecho.",shape=box,color=red];
		1052 -> 1057;
	1055 [label="No, fue la arrogancia la que lo inspiró. Aunque afirme que fue un accidente.",shape=box,color=red];
		1055 -> 1059;
	1054 [label="Aún no sé la verdad, pero es arrogante, es lo que te puedo decir.",shape=box,color=red];
		1054 -> 1059;
	1058 [label="Es la forma máxima de crueldad, carecer de un nombre...",shape=box,color=blue];
		1058 -> 1062;
	1056 [label="+10 Chemistry",color=orange];
		1056 -> 1060;
	1057 [label="+5 Chemistry",color=orange];
		1057 -> 1061;
	1059 [label="Qué pena. Espero que eso no sea verdad, por su bien y el nuestro. Por favor continua.",shape=box,color=blue];
		1059 -> 1049;
	1062 [label="Update boolean MarieFamily2",color=orange];
		1062 -> 1066;
		1062 -> 1067;
		1062 -> 1068;
	1060 [label="Me pregunto qué pensaría de los Cavia... es una lástima que no pueda conocerlos...",shape=box,color=blue];
		1060 -> 1063;
		1060 -> 1064;
	1061 [label="Si solo la pureza de las intenciones de uno fueran todo lo que importara, el mundo sería un hermoso lugar, non ? C'est la vie.",shape=box,color=blue];
		1061 -> 1065;
	1066 [label="A menos que renuncies a él, como lo hizo Abuela.",shape=box,color=red];
		1066 -> 1071;
	1067 [label="La verdad no es tan malo, te acostumbras.",shape=box,color=red];
		1067 -> 1072;
	1068 [label="Los animales no tienen nombres, y parece que están perfectamente bien con eso. Les damos nombres simplemente por nuestro propio bien.",shape=box,color=red];
		1068 -> 1073;
	1063 [label="Me da gracia la idea. Pero no creo que sea prudente.",shape=box,color=red];
		1063 -> 1069;
	1064 [label="Espero que eso pase algún día. De verdad eso espero.",shape=box,color=red];
		1064 -> 1070;
	1065 [label="Et ensuite ?",shape=box,color=blue];
		1065 -> 1049;
	1071 [label="+5 Chemistry",color=orange];
		1071 -> 1077;
	1072 [label="¡Aaah! Quelle horreur ! ¡No fue mi intención! ¡Oh, estoy mortificada! Lo siento, perdóname, no fue mi intención, ¡oh, soy una tonta!",shape=box,color=blue];
		1072 -> 1078;
		1072 -> 1079;
	1073 [label="+5 Chemistry",color=orange];
		1073 -> 1080;
	1069 [label="¿Y por qué no?",shape=box,color=blue];
		1069 -> 1074;
		1069 -> 1075;
	1070 [label="Add 1 to Family",color=orange];
		1070 -> 1050;
	1077 [label="Ahora suena como una dama que me encantaría conocer... ",shape=box,color=blue];
		1077 -> 1085;
	1078 [label="¿Cómo me lo compensarás?",shape=box,color=red];
		1078 -> 1086;
	1079 [label="Está bien, solo te estoy molestando. No estoy enojado.",shape=box,color=red];
		1079 -> 1087;
	1080 [label="¡Es cierto! Nunca lo pensé de esa manera. Y puedes escoger el que tú quieras. Qué liberador, en cierto sentido.",shape=box,color=blue];
		1080 -> 1085;
	1074 [label="Me temo que una mitad vería a la otra mitad como \"la otra familia\".",shape=box,color=red];
		1074 -> 1081;
	1075 [label="La situación allá arriba es... frágil en el mejor de los días. No quiero molestarlos.",shape=box,color=red];
		1075 -> 1082;
	1050 [label="Check /Lotus/Scripts/1999/DialogueScriptNodes.lua:IsSyndicateRank",color=orange];
		1050 -> 1083 [label=true,color=green];
		1050 -> 1084 [label=false,color=brown];
	1085 [label="Esta ha sido una conversación maravillosa, pero me temo que es mi turno de servir la merienda. ¡Monsieur Loid me está enseñando a su manera como servir apropiadamente el té!",shape=box,color=blue];
		1085 -> 1094;
	1086 [label="Maintenant, vous parlez aussi mal que le diable. No, no voy a caer en tus trucos.",shape=box,color=blue];
		1086 -> 1095;
	1087 [label="+5 Chemistry",color=orange];
		1087 -> 1096;
	1081 [label="Add 1 to Family",color=orange];
		1081 -> 1088;
	1082 [label="Estarías sorprendido de que tan resiliente es el alma. Y aquellos que ahora me rodean son muy viejos, magullados por el tiempo.",shape=box,color=blue];
		1082 -> 1089;
	1083 [label="Eso se puede arreglar. Más fácil de lo que tal vez te puedas imaginar. Solo debemos de pensar en como hacerlo. ",shape=box,color=blue];
		1083 -> 1090;
		1083 -> 1091;
	1084 [label="Oui ? ¿Y cómo es que tú y tu copia minúscula funcionan con la famile de arriba?",shape=box,color=blue];
		1084 -> 1092;
		1084 -> 1093;
	1094 [label="Chat ends.",color=orange];
	1095 [label="Chat ends.",color=orange];
	1096 [label="Oh, loué soit Sol ! Pero esto me hace preguntarme... ¿Sabes cómo es que recibiste tu apodo? ¿\"Le Viajero\"?",shape=box,color=blue];
		1096 -> 1099;
		1096 -> 1100;
	1088 [label="+5 Chemistry",color=orange];
		1088 -> 1097;
	1089 [label="+5 Chemistry",color=orange];
		1089 -> 1098;
	1090 [label="Sólo tenemos que ser cuidadosos. Me temo que una mitad vería a la otra mitad como \"la otra familia\".",shape=box,color=red];
		1090 -> 1081;
	1091 [label="La situación allá arriba es... frágil en el mejor de los días. No quiero molestarlos.",shape=box,color=red];
		1091 -> 1082;
	1092 [label="Lentamente. Con mucho cuidado. Me temo que una mitad vería a la otra mitad como \"la otra familia\".",shape=box,color=red];
		1092 -> 1081;
	1093 [label="La situación allá arriba es... frágil en el mejor de los días. No quiero molestarlos.",shape=box,color=red];
		1093 -> 1082;
	1099 [label="Espero haberlo escogido yo.",shape=box,color=red];
		1099 -> 1103;
	1100 [label="La verdad no me acuerdo.",shape=box,color=red];
		1100 -> 1104;
	1097 [label="Oh... ¡Par Sol, parece ser que lo resolviste!",shape=box,color=blue];
		1097 -> 1101;
	1098 [label="Los has sorprendido tantas veces. Déjalos que te sorprendan esta vez.",shape=box,color=blue];
		1098 -> 1102;
	1103 [label="Qué liberador sería eso ! Escoger mi propio nombre. En la Cathédrale, no podía ni siquiera elegir mi propia ropa. Ja !",shape=box,color=blue];
		1103 -> 1085;
	1104 [label="¡Traes muchos mystères contigo! ",shape=box,color=blue];
		1104 -> 1085;
	1101 [label="Update boolean MarieFamilyOther",color=orange];
		1101 -> 1105;
	1102 [label="Pero por favor, por favor, s'il vous plaît, continua con tu historia. Tu pequeña loba Marie debe conocer a su presa antes de cazar como es debido, non ?",shape=box,color=blue];
		1102 -> 1106;
		1102 -> 1107;
		1102 -> 3914;
	1105 [label="Estoy fuera de mí de tanta emoción - je suis assise ici, remuant sur ma chaise !",shape=box,color=blue];
		1105 -> 1102;
	1106 [label="¿Dónde estaba?",shape=box,color=red];
		1106 -> 1108;
	1107 [label="Eso fue un poco malvado de tu parte, ¿no?",shape=box,color=red];
		1107 -> 1109;
	3914 [label="Quizás desearía que me cazaras...",shape=box,color=red];
		3914 -> 3915;
	1108 [label="Hijo había invitado a los Animaux Infestés a acercarse demasiado.",shape=box,color=blue];
		1108 -> 1049;
	1109 [label="Peut-être ! ¿Pero qué hay de malo en un poco de crueldad por un bien, hm?",shape=box,color=blue];
		1109 -> 1110;
		1109 -> 1111;
	3915 [label="Update boolean DrifterMarie",color=orange];
		3915 -> 3913;
	1110 [label="Cierto... de todos modos, regresando a la historia.",shape=box,color=red];
		1110 -> 1049;
	1111 [label="No lo tomes a mal. Lo disfruté.",shape=box,color=red];
		1111 -> 1112;
	3913 [label="¡Me arruinarás! Acabo de gritar y Monsieur Loid me preguntó si estaba bien. Tuve que mentir y decir que vi un ratón, ¡solo para que me dijera que no hay ratones en este tiempo!",shape=box,color=blue];
		3913 -> 3916;
	1112 [label="¡Ja! Sabía que lo disfrutarías. Bueno, suficiente de tus tonterías, y regresa a la historia. Hijo había invitado a los Animaux Infestés a acercarse demasiado, oui ?",shape=box,color=blue];
		1112 -> 1049;
	3916 [label="+5 Chemistry",color=orange];
		3916 -> 3917;
