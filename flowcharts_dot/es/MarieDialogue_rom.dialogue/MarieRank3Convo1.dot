	898 [label="Sí, es verdad. ¡Ahora soy un arma y el Murmullo lo sabe muy bien! Pero busco seguir el camino que le Cardinal me ha indicado, bendito sea.",shape=box,color=blue];
		898 -> 905;
		898 -> 906;
	899 [label="Como le Cardinal. Él era un Orokin, non ? Y ciertamente no es alguien a quien yo condenaría. Sin él, no sería lo que soy ahora. Bendecida.",shape=box,color=blue];
		899 -> 907;
		899 -> 908;
	901 [label="Los warframes fueron hechos... no de la manera más amigable. Solo espero que no esté atrapada dentro de la infestación.",shape=box,color=red];
		901 -> 910;
	902 [label="Creo que quien haya sido Wisp, hubiera estado feliz de conocerte.",shape=box,color=red];
		902 -> 911;
	903 [label="Espero que sus almas hayan podido seguir adelante y descansar, pero creo que una parte de sus recuerdos permanecen.",shape=box,color=red];
		903 -> 912;
	904 [label="Para nada. Creo que una parte de las personas quienes fueron convertidas en warframes permanecen en el interior del corazón de sus esquemas.",shape=box,color=red];
		904 -> 913;
	900 [label="[Fin]",shape=box,color=red];
		900 -> 909;
	905 [label="Le podría discutir muchas cosas, pero debo decir que parece tener un buen instinto para saber a quién darle el suero de protoframe. Aun cuando no sé por qué lo hace.",shape=box,color=red];
		905 -> 914;
	906 [label="Desería que no confiaras en Entrati tanto como lo haces. No sabemos por qué hace lo que hace, y sus motivos no son claros.",shape=box,color=red];
		906 -> 915;
	907 [label="Tenemos que mantenernos cerca de Entrati. Creo que solo tenemos que seguirlo a donde vaya. Es nuestra única oportunidad de detener a la Indiferencia.",shape=box,color=red];
		907 -> 916;
