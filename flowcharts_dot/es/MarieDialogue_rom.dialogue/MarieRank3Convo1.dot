		897 -> 903;
		897 -> 904;
	896 [label="Oui, bien sûr ! Nadie desea ser sermoneado, y menos por una monja. Entiendo. Merci, no me hubiera gustado hacer el ridículo.",shape=box,color=blue];
		896 -> 868;
		896 -> 867;
