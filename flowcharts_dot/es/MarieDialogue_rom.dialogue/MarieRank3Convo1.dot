		j795201040 -> j1531491194;
	j3305440278 [label="Rezo para que al final lo hagamos. Rezo para que al final todos sobrevivamos para verlo. Pero por ahora, veo a la familie al rededor de mí, y rezo para que encuentren el perdón en sus corazones. Por su propia felicidad.",shape=box,color=blue];
