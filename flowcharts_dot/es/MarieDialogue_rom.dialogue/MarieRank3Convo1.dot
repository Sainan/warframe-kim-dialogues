		960 -> 970 [label="false",color=purple];
	961 [label="Oui, estás en lo correcto. Creo que la culpa lo persigue por todo lo que hizo. Creo que se aleja de otros a propósito.",shape=box,color=blue];
		961 -> 973;
	962 [label="Oui, es una pena terrible, un dolor atroz. El saber que alguien sigue... vivo, ¿y que aparentemente elige no estar a tu lado?",shape=box,color=blue];
		962 -> 973;
	964 [label="Mon cœur se brise dans la tragédie - No creo poder soportar esa tristeza... y aún así, ¿no lo va a perdonar?",shape=box,color=blue];
		964 -> 975;
		964 -> 976;
	965 [label="¿Sabes por qué se fue?",shape=box,color=blue];
		965 -> 975;
		965 -> 977;
	966 [label="¿Qué quieres decir? ",shape=box,color=blue];
		966 -> 978;
		966 -> 979;
	968 [label="Es cierto, si los rumores hacia los Cavia son ciertos, vous y avez vraiment trouvé beaucoup de joie, non ?",shape=box,color=blue];
		968 -> 967;
	967 [label="Non, le Cardinal ha hecho cosas mucho peores a muchos otros, simplemente estás molesto por el inconveniente que te causo.",shape=box,color=blue];
		967 -> 917;
	963 [label="Update boolean MarieNoDate",color=orange];
		963 -> 974;
	969 [label="Sólo deseo... que todos los que rodean a Entrati pudieran dejar de culparse por lo que pasó.",shape=box,color=red];
		969 -> 980;
	971 [label="No sé si alguna vez diría que es una bendición.",shape=box,color=red];
		971 -> 982;
	972 [label="Sería más fácil perdonar a Entrati por sus fechorías si pudiera entenderlas.",shape=box,color=red];
		972 -> 983;
	970 [label="Haré lo que necesita que haga, para resolver este problema. Y es entonces que lo juzgaré, cuando todo se haya dicho y hecho.",shape=box,color=red];
		970 -> 981;
	973 [label="Il inflige la douleur dans le cœur des autres, car la douleur vaut mieux que rien du tout. Porque el sufrimiento es mejor que el vacío, non ?",shape=box,color=blue];
		973 -> 984;
	975 [label="Me temo que cuando él no se explica, todo lo que podemos hacer es llegar a nuestras propias conclusiones.",shape=box,color=red];
		975 -> 985;
	976 [label="Ese no es el punto. Él me dejo allí. Vió a alguien abandonado en el Vacío y me dejó allí.",shape=box,color=red];
		976 -> 986;
	977 [label="No. Sólo sé que me dejó allí. Vió a alguien abandonado en el Vacío y sólo... me dejó allí.",shape=box,color=red];
		977 -> 985;
	978 [label="Me dejó allí. Llegó, en algún momento que no recuerdo, y vió a alguien abandonado en el Vacío y... me dejó allí.",shape=box,color=red];
		978 -> 986;
	979 [label="Al final la Indiferencia vino por Duviri. (Aunque obtuvo ayuda inesperada. Pero eso no viene al caso).",shape=box,color=red];
		979 -> 987;
	974 [label="Chat ends.",color=orange];
	980 [label="Update boolean MarieEntratiFamily",color=orange];
		980 -> 988;
	982 [label="Entonces es posible que continuemos en estar de acuerdo con lo que no estamos de acuerdo, supongo.",shape=box,color=blue];
		982 -> 990;
	983 [label="Rezo para que al final lo hagamos. Rezo para que al final todos sobrevivamos para verlo. Pero por ahora, veo a la familie al rededor de mí, y rezo para que encuentren el perdón en sus corazones. Por su propia felicidad.",shape=box,color=blue];
		983 -> 991;
	981 [label="+10 Chemistry",color=orange];
		981 -> 989;
	984 [label="Eso es una lección que mi querido Lyon sabe más que nadie... Me alegra que te esté hablado ahora. Pero hablemos de le Cardenal este día.",shape=box,color=blue];
		984 -> 992;
	985 [label="Sólo puedo asumir que eso pasó antes del... asesinato infinito.",shape=box,color=red];
		985 -> 993;
	986 [label="¿Y no sabes por qué te dejó allí?",shape=box,color=blue];
		986 -> 994;
		986 -> 985;
		986 -> 995;
	987 [label="Non. Espera. L'Indifférence tiene... ¿un aliado?",shape=box,color=blue];
		987 -> 996;
		987 -> 997;
	988 [label="Add 1 to Family",color=orange];
		988 -> 998;
	990 [label="Update boolean MarieEntratiMonster2",color=orange];
		990 -> 1000;
	991 [label="Update boolean MarieEntratiFan2",color=orange];
		991 -> 1000;
	989 [label="Oui, c'est raisonnable, y justo, dado por todo lo que has visto y sabes. No te puedo pedir más que eso.",shape=box,color=blue];
		989 -> 999;
	992 [label="Update boolean MarieLyonSuffering3",color=orange];
		992 -> 917;
	993 [label="Entonces te debo pedir que no asumas lo peor de él, pues eso podría amargar tu corazón. ",shape=box,color=blue];
		993 -> 1001;
	994 [label="Sólo puedo esperar a que tuviera una buena razón.",shape=box,color=red];
		994 -> 1002;
	995 [label="No, y no importa. Me pudo haber salvado. Y no lo hizo.",shape=box,color=red];
		995 -> 1003;
	996 [label="Sólo está usando otra cara.",shape=box,color=red];
		996 -> 1004;
	997 [label="¿Tal vez? O es un rehén. O simplemente está usando otra cara. Realmente no lo sabemos.",shape=box,color=red];
		997 -> 1004;
	998 [label="+10 Chemistry",color=orange];
		998 -> 1005;
	1000 [label="Ah, Lyon me está llamando. À la revoyure !",shape=box,color=blue];
		1000 -> 1006;
	999 [label="Update boolean MarieEntratiNeutral",color=orange];
		999 -> 1000;
	1001 [label="Tal vez aún no querías abandonar Duviri. Quizás aún no se convertía en algo desagradable para ti. ¿Puede ser que aún no estabas listo para dejar a tus amigos?",shape=box,color=blue];
		1001 -> 1007;
	1002 [label="+5 Chemistry",color=orange];
		1002 -> 1008;
	1003 [label="¿Puedes decir que no hay manera posible, en la realidad que fuera, en la cual pudieras ver una razón del porque él pudo haberte dejado? ",shape=box,color=blue];
		1003 -> 1001;
	1004 [label="Update boolean MarieNeci",color=orange];
