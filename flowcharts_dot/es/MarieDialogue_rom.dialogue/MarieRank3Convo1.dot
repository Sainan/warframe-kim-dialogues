		j1591510439 -> j2285766650 [label="DrifterFaithLua",color=purple];
		j1591510439 -> j3289127025 [label="DrifterFaithBalance",color=purple];
		j1591510439 -> j2147521707 [label="false",color=purple];
	j3124105502 [label="Solo me han contado sobre la infestación, sé un poco de eso... pero te creo. Y si lo que siento es verdad, y rezo porque así sea, no creo que ella esté atrapada.",shape=box,color=blue];
		j3124105502 -> j2059503922;
	j3351682081 [label="Es muy lindo que digas eso. Si lo que siento es verdad, y rezo porque ella lo sea, entonces oui, creo que estás en lo correcto. No creo que esté atrapada.",shape=box,color=blue];
		j3351682081 -> j2059503922;
	j62928002 [label="Si lo que siento es verdad, y rezo porque así sea, entonces non, no creo que esté atrapada.",shape=box,color=blue];
		j62928002 -> j2059503922;
	j1044571303 [label="Si lo que siento es verdad, y rezo porque así sea, entonces oui, estás en lo correcto. Y que se queden a ayudarnos. No creo que esté atrapada.",shape=box,color=blue];
		j1044571303 -> j2059503922;
	j2469180321 [label="Oui, he sido bendecida por le Cardinal... pero sé que mi amor por él es único, pues no está manchado por el dolor, odio o resentimiento.",shape=box,color=blue];
		j2469180321 -> j358998092;
	j812374882 [label="Sé que crees que es algún tipo de monstruo horrible. Pero debo de preguntarte, ¿qué es lo que te hace desconfiar tanto de él?",shape=box,color=blue];
		j812374882 -> j3091079010;
		j812374882 -> j4089397754;
		j812374882 -> j877227369;
	j1699410929 [label="¿Creí que creías en él? ¿Por qué cambiaste de opinión tan de repente? ¿Eres así de indeciso? ",shape=box,color=blue];
		j1699410929 -> j2133428130;
		j1699410929 -> j743050121;
	j4270707355 [label="¿Por qué desconfías tanto de él?",shape=box,color=blue];
		j4270707355 -> j3091079010;
		j4270707355 -> j877227369;
		j4270707355 -> j4089397754;
	j835011334 [label="Oui, ¿y cambiaste tan rápido de opinión ? Mientes. Con qué fin, no lo sé. Et je ne veux pas le savoir.",shape=box,color=blue];
		j835011334 -> j1508231473;
	j2218320801 [label="+5 Chemistry",color=orange];
		j2218320801 -> j608349526;
	j499280394 [label="Boolean MarieEntratiFan1 is now true.",color=orange];
		j499280394 -> j608349526;
	j3726053548 [label="Para los que seguimos el camino del Sol, debemos ser siempre la luz que guía a quienes buscan caminar desde las encrucijadas, non ? ",shape=box,color=blue];
		j3726053548 -> j3620287807;
	j2285766650 [label="Eres un seguidor de Lua, deberías de saber que enseñamos que algunos deben de caminar solos en las sombras, oui ?",shape=box,color=blue];
		j2285766650 -> j3620287807;
	j3289127025 [label="Eres seguidor de las Luminarias, deberías de saber que enseñamos que algunos caminan solos los caminos desconocidos, oui ?",shape=box,color=blue];
		j3289127025 -> j3620287807;
	j2147521707 [label="En mi fe, conocemos a aquellos que recorren los caminos de la vida y se encuentran en la encrucijada donde Lua y Sol se encuentran. ",shape=box,color=blue];
		j2147521707 -> j3620287807;
	j2059503922 [label="De ella, solo siento la calidez de la sonrisa de Sol sobre mí. Le Cardinal era sabio, creo, en su elección. Me siento honrada de llevarla entre mis venas.",shape=box,color=blue];
		j2059503922 -> j3362242433;
		j2059503922 -> j1878245678;
		j2059503922 -> j1880567180;
		j2059503922 -> j3704938902;
	j358998092 [label="Le perdono que nos haya dejado. No creo que nadie más lo haga...",shape=box,color=blue];
		j358998092 -> j306598602;
		j358998092 -> j2329315186;
		j358998092 -> j3091079010;
		j358998092 -> j877227369;
	j3091079010 [label="Él... vino de Duviri. Hace mucho tiempo...",shape=box,color=red];
		j3091079010 -> j1376857873;
	j4089397754 [label="Bueno, para empezar, me disparó en el pecho y me dio por muerto.",shape=box,color=red];
		j4089397754 -> j2257677121;
	j877227369 [label="No deja nada más que dolor, muerte y abandono a su paso.",shape=box,color=red];
		j877227369 -> j1591510439;
	j2133428130 [label="Nunca confíe en él. Sólo no quería asustarte.",shape=box,color=red];
		j2133428130 -> j3992737367;
	j743050121 [label="No quise mentir antes, sólo no sé cómo abordar el tema. Es obvio que lo adoras...",shape=box,color=red];
		j743050121 -> j2595537096;
	j1508231473 [label="Boolean MarieNoDate is now true.",color=orange];
		j1508231473 -> "Chat ends.";
	j608349526 [label="¡Sí, debemos mantenernos fuertes! Braves contre les ténèbres, pour toujours et à jamais !",shape=box,color=blue];
		j608349526 -> j3488022318;
	j3620287807 [label="Boolean DrifterCrossroads is now true.",color=orange];
		j3620287807 -> j4047167077;
	j306598602 [label="Ha lastimado y abandonado a mucha gente, tienes razón. Y creo que él siente que lo tenía que hacer.",shape=box,color=red];
		j306598602 -> j1026852964;
	j2329315186 [label="Es difícil, cuando alguien que significa tanto para ti, a quien amas y confías, se va. Especialmente si no sabes por qué. O si no vuelve.",shape=box,color=red];
		j2329315186 -> j4120647208;
	j1376857873 [label="¡Sol! Este mundo que creaste, invocado desde el libro que su hija escribió, oui ? Monsieur Loid hablo de ello... ¿Le Cardinal estaba ahí? ¿Por qué? ",shape=box,color=blue];
		j1376857873 -> j1709153787;
		j1376857873 -> j2607465086;
		j1376857873 -> j1272103964;
	j2257677121 [label="Et pourtant, vous êtes toujours en vie ! Estás vivo, ¿no es así? ¿Y bien? Y prosperando, si las historias de Monsieur Loid de tus aventuras en el pasado-futuro son para creerse.",shape=box,color=blue];
		j2257677121 -> j4231093281;
	j3992737367 [label="Ah, je vois ! Je suis une idiote, c'est ça ?! Juste une petite invalide venue d'un passé lointain, incapable de penser par elle-même ?! Mieux vaut l'approcher comme un faon dans les bois, de peur de l'effrayer !",shape=box,color=blue];
		j3992737367 -> j2523403966;
	j2595537096 [label="Ah, oui... No te la he puesto fácil para hablar con la verdad, n'est-ce pas ?",shape=box,color=blue];
		j2595537096 -> j711949656;
	j3488022318 [label="Le he perdonado que nos haya dejado. No creo que nadie más lo perdone...",shape=box,color=blue];
		j3488022318 -> j306598602;
		j3488022318 -> j2329315186;
	j4047167077 [label="Le Cardinal debe encontrar su camino para regresar con nosotros. Solo podemos hacer lo que podamos para ayudarlo cuando nos llame, y obedecer lo que nos ordenen esos quienes han sido bendecidos por él.",shape=box,color=blue];
		j4047167077 -> j989297039;
	j1026852964 [label="+5 Chemistry",color=orange];
		j1026852964 -> j2918624400;
	j4120647208 [label="+5 Chemistry",color=orange];
		j4120647208 -> j1523492770;
	j1709153787 [label="Creo que al principio, una parte de sí mismo estaba buscando un poco a su hija que dejó atrás. Pero en vez de eso, encontró la manera de pelear contra la Indiferencia, con sus emociones de las cuales él buscaba distanciarse.",shape=box,color=red];
		j1709153787 -> j2451570296;
	j2607465086 [label="Sus notas cuentan una historia autocomplaciente y muy desagradable de cómo fue a estudiar la encarnación conceptual y en lugar de eso regresó aprendiendo el valor de pelear contra la Indiferencia.",shape=box,color=red];
		j2607465086 -> j1219014321;
	j1272103964 [label="Si sus notas son verdad, él estaba ahí para enseñarle a Duviri, y por consiguiente a mí, cómo defenderse de la Indiferencia. Al final, qué tuvo de bueno eso.",shape=box,color=red];
		j1272103964 -> j2337074955;
	j4231093281 [label="Check boolean IsDating",color=orange];
		j4231093281 -> j3807732893 [label=true,color=green];
		j4231093281 -> j1688782695 [label=false,color=brown];
	j2523403966 [label="Va t'asseoir sur une ruche.",shape=box,color=blue];
		j2523403966 -> j1508231473;
	j711949656 [label="Entonces dime la verdad, lobo. ¿Por qué crees que no es de fiar? E intentaré controlar mi temperamento.",shape=box,color=blue];
		j711949656 -> j2329315186;
		j711949656 -> j3091079010;
		j711949656 -> j877227369;
		j711949656 -> j4089397754;
	j989297039 [label="Evaluate expressions",color=orange];
		j989297039 -> j3240142252 [label="MarieEntratiMonster1",color=purple];
		j989297039 -> j3738753036 [label="MarieEntratiMonster1",color=purple];
		j989297039 -> j3240142252 [label="MarieEntratiFan1",color=purple];
		j989297039 -> j328056461 [label="MarieEntratiFan1",color=purple];
		j989297039 -> j3240142252 [label="false",color=purple];
		j989297039 -> j3738753036 [label="false",color=purple];
		j989297039 -> j328056461 [label="false",color=purple];
		j989297039 -> j1505548913 [label="false",color=purple];
	j2918624400 [label="Oui, estás en lo correcto. Creo que la culpa lo persigue por todo lo que hizo. Creo que se aleja de otros a propósito.",shape=box,color=blue];
		j2918624400 -> j3490207456;
	j1523492770 [label="Oui, es una pena terrible, un dolor atroz. El saber que alguien sigue... vivo, ¿y que aparentemente elige no estar a tu lado?",shape=box,color=blue];
		j1523492770 -> j3490207456;
	j2451570296 [label="Mon cœur se brise dans la tragédie - No creo poder soportar esa tristeza... y aún así, ¿no lo va a perdonar?",shape=box,color=blue];
		j2451570296 -> j3775881385;
		j2451570296 -> j1044851729;
	j1219014321 [label="¿Sabes por qué se fue?",shape=box,color=blue];
		j1219014321 -> j3775881385;
		j1219014321 -> j2608622596;
	j2337074955 [label="¿Qué quieres decir? ",shape=box,color=blue];
		j2337074955 -> j2171168311;
		j2337074955 -> j2603600298;
	j3807732893 [label="Es cierto, si los rumores hacia los Cavia son ciertos, vous y avez vraiment trouvé beaucoup de joie, non ?",shape=box,color=blue];
		j3807732893 -> j1688782695;
	j1688782695 [label="Non, le Cardinal ha hecho cosas mucho peores a muchos otros, simplemente estás molesto por el inconveniente que te causo.",shape=box,color=blue];
		j1688782695 -> j1591510439;
	j3240142252 [label="Sólo deseo... que todos los que rodean a Entrati pudieran dejar de culparse por lo que pasó.",shape=box,color=red];
		j3240142252 -> j403338496;
	j3738753036 [label="No sé si alguna vez diría que es una bendición.",shape=box,color=red];
		j3738753036 -> j795201040;
	j328056461 [label="Sería más fácil perdonar a Entrati por sus fechorías si pudiera entenderlas.",shape=box,color=red];
		j328056461 -> j3305440278;
	j1505548913 [label="Haré lo que necesita que haga, para resolver este problema. Y es entonces que lo juzgaré, cuando todo se haya dicho y hecho.",shape=box,color=red];
		j1505548913 -> j3852107659;
	j3490207456 [label="Il inflige la douleur dans le cœur des autres, car la douleur vaut mieux que rien du tout. Porque el sufrimiento es mejor que el vacío, non ?",shape=box,color=blue];
		j3490207456 -> j951940512;
	j3775881385 [label="Me temo que cuando él no se explica, todo lo que podemos hacer es llegar a nuestras propias conclusiones.",shape=box,color=red];
		j3775881385 -> j2797744578;
	j1044851729 [label="Ese no es el punto. Él me dejo allí. Vió a alguien abandonado en el Vacío y me dejó allí.",shape=box,color=red];
		j1044851729 -> j1830006294;
