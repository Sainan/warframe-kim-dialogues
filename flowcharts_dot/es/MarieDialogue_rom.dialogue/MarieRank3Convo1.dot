	930 [label="Para los que seguimos el camino del Sol, debemos ser siempre la luz que guía a quienes buscan caminar desde las encrucijadas, non ? ",shape=box,color=blue];
		930 -> 942;
	932 [label="Eres un seguidor de Lua, deberías de saber que enseñamos que algunos deben de caminar solos en las sombras, oui ?",shape=box,color=blue];
		932 -> 942;
	931 [label="Eres seguidor de las Luminarias, deberías de saber que enseñamos que algunos caminan solos los caminos desconocidos, oui ?",shape=box,color=blue];
		931 -> 942;
	929 [label="En mi fe, conocemos a aquellos que recorren los caminos de la vida y se encuentran en la encrucijada donde Lua y Sol se encuentran. ",shape=box,color=blue];
		929 -> 942;
	933 [label="De ella, solo siento la calidez de la sonrisa de Sol sobre mí. Le Cardinal era sabio, creo, en su elección. Me siento honrada de llevarla entre mis venas.",shape=box,color=blue];
		933 -> 908;
		933 -> 907;
