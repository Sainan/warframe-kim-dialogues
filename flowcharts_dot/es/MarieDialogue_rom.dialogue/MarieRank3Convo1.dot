		j661331194 -> j4217253030;
	j2172827150 [label="Vraiment ? ¿Los registros se perdieron con el tiempo, o sospechas que simplemente se consideró que no eran lo suficientemente importantes para recordarlos?",shape=box,color=blue];
		j2172827150 -> j4277760760;
		j2172827150 -> j742420689;
		j2172827150 -> j2893713838;
	j4211132216 [label="Me temo que no sabemos mucho sobre las personas que fueron convertidas en los warframes originales.",shape=box,color=red];
		j4211132216 -> j4256788026;
	j1388379387 [label="Me temo que no se sabe mucho acerca de la Wisp original.",shape=box,color=red];
		j1388379387 -> j4256788026;
	j4217253030 [label="¿Te molesta hablar de almas? Lo entiendo si es así y podemos limitarnos a cosas más prácticas. No quiero incomodarte.",shape=box,color=blue];
		j4217253030 -> j3734389237;
		j4217253030 -> j3964307348;
		j4217253030 -> j202800200;
	j4277760760 [label="Creo que no eran lo suficientemente importantes para recordarlos.",shape=box,color=red];
		j4277760760 -> j21848643;
	j742420689 [label="Creo que se perdieron con el tiempo.",shape=box,color=red];
		j742420689 -> j21848643;
	j2893713838 [label="Un poco de ambos. Para su creador principal, ellos eran... parte arma, parte arte.",shape=box,color=red];
		j2893713838 -> j2524236827;
	j4256788026 [label="Vraiment ? Pues siento que la conozco como si fuera mi hermana, de mi propia sangre, no de la Cathédrale.",shape=box,color=blue];
		j4256788026 -> j960518486;
	j3734389237 [label="Está bien, podemos hablar sobre almas.",shape=box,color=red];
		j3734389237 -> j4211132216;
		j3734389237 -> j1388379387;
		j3734389237 -> j202800200;
	j3964307348 [label="La verdad yo no creo en las almas, así que deberíamos limitarnos a los hechos concretos, si eso es posible.",shape=box,color=red];
		j3964307348 -> j2079348613;
	j202800200 [label="[Fin]",shape=box,color=red];
		j202800200 -> "Chat ends.";
	j21848643 [label="¿Ves? Ces Orokin son demonios.",shape=box,color=blue];
		j21848643 -> j2998433496;
		j21848643 -> j3902381209;
	j2524236827 [label="+5 Chemistry",color=orange];
		j2524236827 -> j2789763183;
	j960518486 [label="No la escucho, no en la manera que Lyon escucha a los dioses y sus espíritus protectores. No la veo. Simplemente la siento, junto a mí.",shape=box,color=blue];
		j960518486 -> j3911140837;
	j2079348613 [label="Boolean DrifterFaithStop is now true.",color=orange];
		j2079348613 -> j3219170477;
	"Chat ends." [color=orange];
	j2998433496 [label="Las armas pueden usarse tanto para proteger como para dañar. No nos gusta necesitarlas, pero... las necesitamos.",shape=box,color=red];
		j2998433496 -> j2288420526;
	j3902381209 [label="No todos. ¿Pero ese? Sí. Y hay otros por ahí que no condenaría de inmediato.",shape=box,color=red];
		j3902381209 -> j1203644146;
	j2789763183 [label="Une horrible toile d'os peinte avec du sang... ¿Ves? Ces Orokin son demonios.",shape=box,color=blue];
		j2789763183 -> j2998433496;
		j2789763183 -> j3902381209;
	j3911140837 [label="Como una vieja amiga, tal vez. Sé lo que le gustaba, sé como se movía. Recuerdo el sonido de su risa en el viento...",shape=box,color=blue];
		j3911140837 -> j1183036668;
	j3219170477 [label="+5 Chemistry",color=orange];
		j3219170477 -> j3097990986;
	j2288420526 [label="Add -1 to Thermostat counter",color=orange];
		j2288420526 -> j3166960285;
	j1203644146 [label="Add 1 to Thermostat counter",color=orange];
		j1203644146 -> j3065271678;
	j1183036668 [label="¡Debo sonar como una loca para ti! Lo siento.",shape=box,color=blue];
		j1183036668 -> j1255765581;
		j1183036668 -> j1949813945;
		j1183036668 -> j2526129419;
		j1183036668 -> j1555802673;
	j3097990986 [label="Oui, bien sûr ! Nadie desea ser sermoneado, y menos por una monja. Entiendo. Merci, no me hubiera gustado hacer el ridículo.",shape=box,color=blue];
		j3097990986 -> j1058601846;
		j3097990986 -> j3064845441;
		j3097990986 -> j202800200;
	j3166960285 [label="Sí, es verdad. ¡Ahora soy un arma y el Murmullo lo sabe muy bien! Pero busco seguir el camino que le Cardinal me ha indicado, bendito sea.",shape=box,color=blue];
		j3166960285 -> j1880567180;
		j3166960285 -> j3704938902;
	j3065271678 [label="Como le Cardinal. Él era un Orokin, non ? Y ciertamente no es alguien a quien yo condenaría. Sin él, no sería lo que soy ahora. Bendecida.",shape=box,color=blue];
		j3065271678 -> j1878245678;
		j3065271678 -> j3362242433;
	j1255765581 [label="Los warframes fueron hechos... no de la manera más amigable. Solo espero que no esté atrapada dentro de la infestación.",shape=box,color=red];
		j1255765581 -> j1356443025;
	j1949813945 [label="Creo que quien haya sido Wisp, hubiera estado feliz de conocerte.",shape=box,color=red];
		j1949813945 -> j449115536;
	j2526129419 [label="Espero que sus almas hayan podido seguir adelante y descansar, pero creo que una parte de sus recuerdos permanecen.",shape=box,color=red];
		j2526129419 -> j495730297;
	j1555802673 [label="Para nada. Creo que una parte de las personas quienes fueron convertidas en warframes permanecen en el interior del corazón de sus esquemas.",shape=box,color=red];
		j1555802673 -> j3852515908;
	j1880567180 [label="Le podría discutir muchas cosas, pero debo decir que parece tener un buen instinto para saber a quién darle el suero de protoframe. Aun cuando no sé por qué lo hace.",shape=box,color=red];
		j1880567180 -> j919286546;
	j3704938902 [label="Desería que no confiaras en Entrati tanto como lo haces. No sabemos por qué hace lo que hace, y sus motivos no son claros.",shape=box,color=red];
		j3704938902 -> j1722407835;
	j1878245678 [label="Tenemos que mantenernos cerca de Entrati. Creo que solo tenemos que seguirlo a donde vaya. Es nuestra única oportunidad de detener a la Indiferencia.",shape=box,color=red];
		j1878245678 -> j737842484;
	j3362242433 [label="Es un mentiroso, Marie. Abandona y lastima a todos en su vida. Ya te abandono a ti ¿Qué no lo ves? ",shape=box,color=red];
		j3362242433 -> j1591510439;
