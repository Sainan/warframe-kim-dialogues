		876 -> 882;
	877 [label="Un poco de ambos. Para su creador principal, ellos eran... parte arma, parte arte.",shape=box,color=red];
		877 -> 883;
	881 [label="Vraiment ? Pues siento que la conozco como si fuera mi hermana, de mi propia sangre, no de la Cathédrale.",shape=box,color=blue];
