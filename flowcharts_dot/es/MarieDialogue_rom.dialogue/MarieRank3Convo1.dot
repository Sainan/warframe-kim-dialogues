		952 -> 961;
	953 [label="+5 Chemistry",color=orange];
		953 -> 962;
	956 [label="Creo que al principio, una parte de sí mismo estaba buscando un poco a su hija que dejó atrás. Pero en vez de eso, encontró la manera de pelear contra la Indiferencia, con sus emociones de las cuales él buscaba distanciarse.",shape=box,color=red];
		956 -> 964;
	957 [label="Sus notas cuentan una historia autocomplaciente y muy desagradable de cómo fue a estudiar la encarnación conceptual y en lugar de eso regresó aprendiendo el valor de pelear contra la Indiferencia.",shape=box,color=red];
		957 -> 965;
	958 [label="Si sus notas son verdad, él estaba ahí para enseñarle a Duviri, y por consiguiente a mí, cómo defenderse de la Indiferencia. Al final, qué tuvo de bueno eso.",shape=box,color=red];
		958 -> 966;
