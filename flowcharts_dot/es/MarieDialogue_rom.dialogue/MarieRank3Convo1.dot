	1005 [label="Ooh, qué buena idea. ¡Creo que es una causa que vale la pena defender!",shape=box,color=blue];
		1005 -> 1010;
	1006 [label="Chat ends.",color=orange];
	1007 [label="Tal vez él no sabía que podría sacarte de ella, por miedo a que colapse en un estado frágil. Quizás él pensó que l'Indifférence lo reclamaría si te ibas. Peut-être, peut-être, peut-être.",shape=box,color=blue];
		1007 -> 917;
	1008 [label="Merci, merci, esto es lo que más valoro. Que no debemos asumir lo peor, pues hace que se amarguen nuestros corazones.",shape=box,color=blue];
		1008 -> 1011;
	1009 [label="No sé que pensar sobre esto... pero es bastante curioso... ",shape=box,color=blue];
		1009 -> 986;
	1010 [label="Check /Lotus/Scripts/1999/DialogueScriptNodes.lua:IsSyndicateRank",color=orange];
		1010 -> 1013 [label=true,color=green];
		1010 -> 1012 [label=false,color=brown];
	1011 [label="Tal vez aún no querías abandonar Duviri. Quizás aún no se convertía en algo desagradable para ti. ¿Puede ser que aún no estabas listo para dejar a tus amigos?",shape=box,color=blue];
		1011 -> 1014;
	1013 [label="Tú y la copia minúscula ya lo hicieron muy bien con su famile... Mmm, ¡ahora me tienes intrigada!",shape=box,color=blue];
		1013 -> 1000;
	1012 [label="Mmm... ¡Ahora me tienes intrigada! Sin embargo primero, debes de continuar con tu trabajo con su famile arriba. Tú o la copia minúscula.",shape=box,color=blue];
		1012 -> 1000;
	1014 [label="Tal vez él no sabía que podría sacarte de ella, por miedo a que colapse en un estado frágil. Quizás él pensó que l'Indifférence lo reclamaría si te ibas. Peut-être, peut-être, peut-être.",shape=box,color=blue];
