		936 -> 946;
	941 [label="Update boolean MarieNoDate",color=orange];
		941 -> 950;
	940 [label="¡Sí, debemos mantenernos fuertes! Braves contre les ténèbres, pour toujours et à jamais !",shape=box,color=blue];
		940 -> 949;
	942 [label="Update boolean DrifterCrossroads",color=orange];
		942 -> 951;
	943 [label="Ha lastimado y abandonado a mucha gente, tienes razón. Y creo que él siente que lo tenía que hacer.",shape=box,color=red];
		943 -> 952;
	944 [label="Es difícil, cuando alguien que significa tanto para ti, a quien amas y confías, se va. Especialmente si no sabes por qué. O si no vuelve.",shape=box,color=red];
		944 -> 953;
	947 [label="¡Sol! Este mundo que creaste, invocado desde el libro que su hija escribió, oui ? Monsieur Loid hablo de ello... ¿Le Cardinal estaba ahí? ¿Por qué? ",shape=box,color=blue];
		947 -> 956;
		947 -> 957;
		947 -> 958;
	948 [label="Et pourtant, vous êtes toujours en vie ! Estás vivo, ¿no es así? ¿Y bien? Y prosperando, si las historias de Monsieur Loid de tus aventuras en el pasado-futuro son para creerse.",shape=box,color=blue];
		948 -> 959;
	945 [label="Ah, je vois ! Je suis une idiote, c'est ça ?! Juste une petite invalide venue d'un passé lointain, incapable de penser par elle-même ?! Mieux vaut l'approcher comme un faon dans les bois, de peur de l'effrayer !",shape=box,color=blue];
		945 -> 954;
	946 [label="Ah, oui... No te la he puesto fácil para hablar con la verdad, n'est-ce pas ?",shape=box,color=blue];
		946 -> 955;
	950 [label="Chat ends.",color=orange];
	949 [label="Le he perdonado que nos haya dejado. No creo que nadie más lo perdone...",shape=box,color=blue];
		949 -> 943;
		949 -> 944;
	951 [label="Le Cardinal debe encontrar su camino para regresar con nosotros. Solo podemos hacer lo que podamos para ayudarlo cuando nos llame, y obedecer lo que nos ordenen esos quienes han sido bendecidos por él.",shape=box,color=blue];
		951 -> 960;
