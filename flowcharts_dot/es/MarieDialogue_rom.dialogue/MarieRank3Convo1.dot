	918 [label="Solo me han contado sobre la infestación, sé un poco de eso... pero te creo. Y si lo que siento es verdad, y rezo porque así sea, no creo que ella esté atrapada.",shape=box,color=blue];
		918 -> 933;
	919 [label="Es muy lindo que digas eso. Si lo que siento es verdad, y rezo porque ella lo sea, entonces oui, creo que estás en lo correcto. No creo que esté atrapada.",shape=box,color=blue];
		919 -> 933;
	920 [label="Si lo que siento es verdad, y rezo porque así sea, entonces non, no creo que esté atrapada.",shape=box,color=blue];
		920 -> 933;
	921 [label="Si lo que siento es verdad, y rezo porque así sea, entonces oui, estás en lo correcto. Y que se queden a ayudarnos. No creo que esté atrapada.",shape=box,color=blue];
		921 -> 933;
	922 [label="Oui, he sido bendecida por le Cardinal... pero sé que mi amor por él es único, pues no está manchado por el dolor, odio o resentimiento.",shape=box,color=blue];
		922 -> 934;
	925 [label="Sé que crees que es algún tipo de monstruo horrible. Pero debo de preguntarte, ¿qué es lo que te hace desconfiar tanto de él?",shape=box,color=blue];
		925 -> 937;
		925 -> 939;
		925 -> 938;
	923 [label="¿Creí que creías en él? ¿Por qué cambiaste de opinión tan de repente? ¿Eres así de indeciso? ",shape=box,color=blue];
		923 -> 935;
		923 -> 936;
	924 [label="¿Por qué desconfías tanto de él?",shape=box,color=blue];
		924 -> 937;
		924 -> 938;
		924 -> 939;
