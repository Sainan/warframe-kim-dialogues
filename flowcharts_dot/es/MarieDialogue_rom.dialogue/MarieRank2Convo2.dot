		419 -> 422;
	424 [label="Lo conocía como el Cardinal Dimanche. Quizás te sorprenda la cantidad de años que pasó en la iglesia, predicando a nuestra congregación.",shape=box,color=blue];
		424 -> 426;
		424 -> 427;
	423 [label="+5 Chemistry",color=orange];
