	426 [label="¿Crees que todo fue mentira? ¿O piensas que lo creía?",shape=box,color=red];
		426 -> 429;
	427 [label="No me sorprende. Es un buen mentiroso.",shape=box,color=red];
		427 -> 430;
	425 [label="Ah, una pregunta muy amable que esconde una respuesta muy desafiante, formulada de manera bastante inteligente, debo admitirlo.",shape=box,color=blue];
		425 -> 428;
	429 [label="Hablaba del perdón, de la familia y de la empatía con tanto fervor y dedicación que no sé cómo podía ser una mentira.",shape=box,color=blue];
		429 -> 434;
	430 [label="Entiendo que tus experiencias con él no son iguales que las mías. Pero también debes entender que, para mí, era una persona amable y cariñosa.",shape=box,color=blue];
		430 -> 435;
	428 [label="Siento lo mismo que el primer día que lo vi predicar desde el púlpito a nuestros paroissiens. Bendecida de haber estado en su présence.",shape=box,color=blue];
		428 -> 431;
		428 -> 432;
		428 -> 433;
	434 [label="¿Él practica la fe de las Luminarias? ¿De Sol y Lua? Eso ya no lo sé, sabiendo ahora de dónde y cuándo proviene. Peu importe.",shape=box,color=blue];
		434 -> 437;
	435 [label="¿Acaso tus verdades invalidan las mías, o cuáles debo creer? ¿Debo condenar cada acto de misericordia, cada acto de gentileza que mostró durante sus años en la parroquia?",shape=box,color=blue];
		435 -> 438;
	431 [label="Me alegra escucharlo, sinceramente. Creo que todos se apresuran a condenarlo.",shape=box,color=red];
		431 -> 436;
	432 [label="¿Crees que engañaba a la gente? ¿O piensas que lo creía?",shape=box,color=red];
		432 -> 429;
	433 [label="Lamento... que hayas caído en sus trucos.",shape=box,color=red];
		433 -> 430;
	437 [label="¿Qué importancia tiene el nombre de los dioses a quienes rezas, si llevas su amor en tu corazón? Ninguna, digo yo.",shape=box,color=blue];
