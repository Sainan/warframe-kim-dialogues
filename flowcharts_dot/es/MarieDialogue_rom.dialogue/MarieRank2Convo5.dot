digraph {
	735 [label="MarieRank2Convo5 begins.",color=orange];
		735 -> 736;
	736 [label="Evaluate expressions",color=orange];
		736 -> 739 [label="MarieOtak1",color=purple];
		736 -> 738 [label="MarieFamily1",color=purple];
		736 -> 737 [label="false",color=purple];
	739 [label="He estado pensando en lo que me dijiste sobre Monsieur Otak.",shape=box,color=blue];
		739 -> 743;
	738 [label="He estado pensando en lo que me dijiste sobre la familia de le Cardinal.",shape=box,color=blue];
		738 -> 742;
	737 [label="Vengo nuevamente con una pregunta sobre Monsieur \"Necraloid\", si me lo permites.",shape=box,color=blue];
		737 -> 741;
		737 -> 740;
	743 [label="Me preguntaba si tal vez se parece a una historia mía. ¿Puedo contártela si tienes tiempo?",shape=box,color=blue];
		743 -> 749;
		743 -> 748;
	742 [label="Me preguntaba si me contarías la historia de Otak, la cara infantil en la parte posterior del cráneo del Necraloid.",shape=box,color=blue];
		742 -> 747;
		742 -> 746;
	741 [label="Si, claro ¿qué pasa?",shape=box,color=red];
		741 -> 745;
	740 [label="[Fin]",shape=box,color=red];
		740 -> 744;
	749 [label="Adelante.",shape=box,color=red];
		749 -> 754;
	748 [label="[Fin]",shape=box,color=red];
		748 -> 753;
	747 [label="Claro.",shape=box,color=red];
		747 -> 752;
	746 [label="Quizás más tarde. [Fin]",shape=box,color=red];
		746 -> 751;
	745 [label="Me pregunto por qué hay otra cara en su espalda que parece un garabato de un niño.",shape=box,color=blue];
		745 -> 750;
	744 [label="Chat ends.",color=orange];
	754 [label="Había una hermana en la Cathédrale que se perdió en los pasillos de su pasado. Sor Cécilia.",shape=box,color=blue];
		754 -> 757;
	753 [label="Chat ends.",color=orange];
	752 [label="Todo indica que era un genio y la mente detrás del aprovechamiento de los cristales de argón.",shape=box,color=red];
		752 -> 756;
	751 [label="Chat ends.",color=orange];
	750 [label="Le pregunté a Monsieur Necraloid y a Monsieur Loid, y ninguno quiso hablar del tema; solo me dieron un nombre: Otak. Y lo pronunciaron con gran tristeza.",shape=box,color=blue];
		750 -> 755;
	757 [label="Ella se paraba frente al gran reloj del vestíbulo y proclamaba que eran las dos de la tarde, pero no sabía qué hora era.",shape=box,color=blue];
		757 -> 761;
	756 [label="Que se aprovechan a partir del Vacío: son la razón por la que podemos crear muchos de los poderosos warframes y armas que fabricamos.",shape=box,color=red];
		756 -> 760;
	755 [label="Así que aquí estoy, hablando contigo, esperando que puedas ayudarme.",shape=box,color=blue];
		755 -> 758;
		755 -> 759;
	761 [label="Encontrábamos todos los cuadros en los pasillos puestos al revés y ella decía que ellos le susurraban historias terribles.",shape=box,color=blue];
		761 -> 766;
	760 [label="Se especializó en cristalografía. Y sus trabajos se archivaron aquí, en los laboratorios.",shape=box,color=red];
		760 -> 765;
	758 [label="¿Quieres saber sobre Otak? ¿O sobre por qué no puedes hablar con él?",shape=box,color=red];
		758 -> 762;
	759 [label="Otak es... difícil de explicar...",shape=box,color=red];
		759 -> 2919;
	766 [label="Nos enteramos de que ella simplemente escuchaba las conversaciones de otras habitaciones y pensaba que eran las pinturas las que hablaban...",shape=box,color=blue];
		766 -> 770;
	765 [label="Por alguna razón, no sé por qué, lo convirtieron en un céfalon y le dieron su propio caparazón necraloide.",shape=box,color=red];
		765 -> 769;
	762 [label="Creo que con el tiempo me gustaría saber ambas cosas, pero te dejo decidir por dónde empezar. Après tout, no sé cuál es más importante.",shape=box,color=blue];
		762 -> 2919;
	2919 [label="Check boolean LoidFamilyComplete",color=orange];
		2919 -> 764 [label=true,color=green];
		2919 -> 764 [label=false,color=brown];
		2919 -> 763 [label=false,color=brown];
	770 [label="Una vez, confundió todos los cojines de una sala con niños y los invitó a todos a tomar el té...",shape=box,color=blue];
		770 -> 774;
	769 [label="No todos los céfalones fueron creados como castigo. Pero las cosas salieron... mal aquí en Deimos, y él resultó gravemente dañado.",shape=box,color=red];
		769 -> 773;
	764 [label="Otak era un arquimediano, un científico y académico orokin. Lo que le ocurrió no es precisamente una historia feliz.",shape=box,color=red];
		764 -> 768;
	763 [label="Bueno... en resumen, algunos miembros de la familia Entrati están arriba, y... no saben que estamos aquí abajo.",shape=box,color=red];
		763 -> 767;
	774 [label="Cuando entré en la habitación, ella me miró y dijo: \"¡Oh, Hermana Odette, ahí estás! Los niños del orfanato están aquí, ¿quieres acompañarme?\"",shape=box,color=blue];
		774 -> 777;
		774 -> 778;
	773 [label="+5 Chemistry",color=orange];
		773 -> 776;
	768 [label="Update boolean MarieOtak1",color=orange];
		768 -> 772;
	767 [label="Update boolean MarieFamily1",color=orange];
		767 -> 771;
	777 [label="¿Qué hiciste?",shape=box,color=red];
		777 -> 781;
	778 [label="¿Quién era la Hermana Odette?",shape=box,color=red];
		778 -> 782;
	776 [label="Pauvre petit...",shape=box,color=blue];
		776 -> 780;
	772 [label="Par les Luminaires... por favor, continúa.",shape=box,color=blue];
		772 -> 752;
	771 [label="Par les Luminaires... ¿Quieres decir que todos estamos aquí abajo en secreto? ¿Es por eso que no podemos salir de aquí? Mais pourquoi ?!",shape=box,color=blue];
		771 -> 775;
	781 [label="Acerqué mi silla a un lugar vacío en la mesa y tomé té con ella y los cojines, ¿qué mas podía hacer?",shape=box,color=blue];
		781 -> 787;
	782 [label="Me temo que la Hermana Odette lleva muerta treinta años.",shape=box,color=blue];
		782 -> 788;
	780 [label="Así quie lo transfirieron al necraloid principal, el único Necraloid que queda, y está... ¿bien? Es difícil de explicar.",shape=box,color=red];
		780 -> 784;
		780 -> 785;
		780 -> 786;
	775 [label="Su hija, Euleria, conocida como Madre, y su familia han estado cuidando Deimos durante todo este tiempo.",shape=box,color=red];
		775 -> 779;
	787 [label="Cómo nos reímos juntas mientras me contaba historias de su pasado. Historias que la Hermana Cécilia nunca le había contado a nadie, al menos que yo sepa.",shape=box,color=blue];
		787 -> 791;
	788 [label="Acerqué mi silla a un lugar vacío en la mesa y tomé té con ella y los cojines.",shape=box,color=blue];
		788 -> 787;
	784 [label="Ojalá pudiéramos arreglarlo, de verdad. Traer de vuelta al verdadero Otak.",shape=box,color=red];
		784 -> 754;
	785 [label="Me hace sonreír. Es gracioso, pero esconde algo trágico y roto.",shape=box,color=red];
		785 -> 754;
	786 [label="Lamentablemente, no tiene arreglo. Y creo que irrita a muchas personas. ",shape=box,color=red];
		786 -> 754;
	779 [label="Velando por este lugar y por el corazón que bombea energía del Vacío al Sistema Origen, manteniéndonos a todos... utilizables, realmente, desde que Entrati se fue.",shape=box,color=red];
		779 -> 783;
	791 [label="Sus ojos brillaban por momentos, pero estaban apagados en otros, como la muñeca de una niña...",shape=box,color=blue];
		791 -> 794;
		791 -> 795;
		791 -> 796;
		791 -> 797;
	783 [label="Check /Lotus/Scripts/1999/DialogueScriptNodes.lua:IsSyndicateRank",color=orange];
		783 -> 789 [label=true,color=green];
		783 -> 790 [label=false,color=brown];
	794 [label="¿Por qué te sentaste con ella?",shape=box,color=red];
		794 -> 800;
	795 [label="¿Qué pasó con la Hermana Cécilia?",shape=box,color=red];
		795 -> 801;
	796 [label="Espero que haya significado algo para ella que estuvieras ahí.",shape=box,color=red];
		796 -> 802;
	797 [label="Fue muy amable de tu parte sentarte con ella.",shape=box,color=red];
		797 -> 803;
	789 [label="Ella ha aceptado su ausencia y han hecho las paces, pero fue algo que les costó mucho trabajo.",shape=box,color=red];
		789 -> 792;
	790 [label="Ella no ha podido aceptar su ausencia y están peleados.",shape=box,color=red];
		790 -> 793;
	800 [label="+15 Chemistry",color=orange];
		800 -> 806;
	801 [label="Lo que le pasa a todos aquellos en su condición. Ella continuó desvaneciéndose, como un cuadro al sol, hasta que no quedó nada. ",shape=box,color=blue];
		801 -> 807;
	802 [label="+10 Chemistry",color=orange];
		802 -> 808;
	803 [label="+5 Chemistry",color=orange];
		803 -> 809;
	792 [label="Saber que él todavía está ahí afuera, en cualquier parte, y que no le ha dicho ni una palabra, ni le ha enviado una carta...?",shape=box,color=red];
		792 -> 798;
	793 [label="¿Saber que él todavía está ahí afuera, suelto, y que no le ha dicho ni una palabra, ni le ha enviado una carta...?",shape=box,color=red];
		793 -> 799;
	806 [label="Una pregunta sabia. Una pregunta muy sabia. Creo que varias razones me inspiraron. Me gustaría pensar que fue la amabilidad lo que me llevó a su mesa.",shape=box,color=blue];
		806 -> 812;
	807 [label="Después ella nos dejó y celebramos una vigilia en su memoria. Ojalá pudiera recordar, al final, a quienes fueron realmente amables con ella. ",shape=box,color=blue];
		807 -> 813;
	808 [label="Me gustaría creer que ella lo entendió, en el fondo.",shape=box,color=blue];
		808 -> 813;
	809 [label="¿Fue bondad? ¿O fue culpa lo que me inspiró a hacerlo? Ah, pero tú solo estás siendo amable al decirlo. ",shape=box,color=blue];
		809 -> 813;
	798 [label="No puedo imaginar lo doloroso que debe ser esto para ella. Para ellos.",shape=box,color=red];
		798 -> 804;
	799 [label="Eso destruiría cualquier pequeña posibilidad de reconciliación que pudieran tener.",shape=box,color=red];
		799 -> 805;
	812 [label="Pero creo que era culpa, quizás, en el fondo. Que si no lo hacía, la estaría descuidando. Como se descuida a un niño.",shape=box,color=blue];
		812 -> 813;
	813 [label="Me gustaría creer que tu Otak conoce a personas que son amables y pacientes con él. Pero, claro, él no está realmente ahí, ¿verdad?",shape=box,color=blue];
		813 -> 817;
	804 [label="Aunque puedo ver la lógica detrás de la decisión de protegerlos del dolor que le Cardinal ha causado con su necesaria partida...",shape=box,color=blue];
		804 -> 810;
	805 [label="+10 Chemistry",color=orange];
		805 -> 811;
	817 [label="Estoy hablando de una pieza de tecnología muy elaborada, diseñada para parecerse a un hombre, ¿no? Un fonógrafo, muchísimo más complejo. Al igual que el Necraloid, no tiene alma.",shape=box,color=blue];
		817 -> 822;
		817 -> 823;
		817 -> 824;
		817 -> 825;
		817 -> 826;
	810 [label="Me parece innecesariamente cruel, ¿no crees ? Podrían pensar que está muerto. ¡O peor! Y nosotros, viviendo aquí comme des rats d'égout ?",shape=box,color=blue];
		810 -> 814;
		810 -> 815;
	811 [label="Oui... Ya veo la lógica. Yo trabajaría para recomponer a su familia, si es posible, non ? Parece ser la única esperanza que tenemos para salir de aquí. ",shape=box,color=blue];
		811 -> 816;
	822 [label="Puede que el Necraloid no tenga alma, pero es único. Otros céfalones, como Otak, sí la tienen. Fueron destruidos en su proceso de creación.",shape=box,color=red];
		822 -> 831;
	823 [label="Tienes razón. ¿Qué sugieres que haga al respecto?",shape=box,color=red];
		823 -> 832;
	824 [label="Tienes razón. No la tienen. Pero eso no significa que podamos tratarlos mal.",shape=box,color=red];
		824 -> 833;
	825 [label="No sé si tienes razón. Pero aún pueden pensar y sentir, y no podemos tratarlos como cosas.",shape=box,color=red];
		825 -> 834;
	826 [label="El Necraloid tiene alma. Todos los céfalones la tienen.",shape=box,color=red];
		826 -> 835;
	814 [label="En realidad esa decisión no depende de mí.",shape=box,color=red];
		814 -> 818;
	815 [label="De hecho tengo una amiga que adora las ratas. Me parecen adorables.",shape=box,color=red];
		815 -> 819;
	816 [label="O pasaremos el resto de nuestras vidas viviendo aquí atrapados, comme des rats d'égout. ",shape=box,color=blue];
		816 -> 820;
		816 -> 821;
	831 [label="Update boolean MarieCephalonSoul",color=orange];
		831 -> 839;
	832 [label="Update boolean MarieCephalonNoSoul",color=orange];
		832 -> 840;
	833 [label="Update boolean MarieCephalonNoSoul",color=orange];
		833 -> 841;
	834 [label="Update boolean MarieCephalonUnsure",color=orange];
		834 -> 842;
	835 [label="Update boolean MarieCephalonSoul",color=orange];
		835 -> 843;
	818 [label="Lo sé. Es decisión de Monsieur Loid, y de todos los demás, darse a conocer.",shape=box,color=blue];
		818 -> 827;
	819 [label="+15 Chemistry",color=orange];
		819 -> 828;
	820 [label="He sido negligente. Tienes razón. Me pondré a trabajar.",shape=box,color=red];
		820 -> 829;
	821 [label="De hecho tengo una amiga que adora las ratas. Me parecen adorables. ",shape=box,color=red];
		821 -> 830;
	839 [label="+5 Chemistry",color=orange];
		839 -> 845;
	840 [label="¡Oh, no creas que pretendo que seas cruel! ¡No! Atesóralos, porque son preciosos, y no es culpa suya ser como son.",shape=box,color=blue];
		840 -> 846;
	841 [label="+5 Chemistry",color=orange];
		841 -> 840;
	842 [label="+5 Chemistry",color=orange];
		842 -> 847;
	843 [label="+5 Chemistry",color=orange];
		843 -> 848;
	827 [label="Yo diría que es la culpa, no la nobleza, lo que nos mantiene aquí.",shape=box,color=blue];
		827 -> 836;
	828 [label="Y me encantaría conocerla algún día, pero ese no es precisamente el punto, lobito tonto.",shape=box,color=blue];
		828 -> 827;
	829 [label="+5 Chemistry",color=orange];
		829 -> 837;
	830 [label="+5 Chemistry",color=orange];
		830 -> 838;
	845 [label="Más pruebas de que el diablo y sus semejantes debían ser condenados. Pero quizás tengas razón sobre Otak y los de su clase, o quizás te tranquilice creerlo.",shape=box,color=blue];
		845 -> 850;
	846 [label="Mi corazón se rompe solo por los cuerpos destrozados que dejaron los demonios Orokin. No eran dioses, sino devoradores de todo a su paso. Tan sólo mira al que viaja con nosotros como prueba.",shape=box,color=blue];
		846 -> 851;
	847 [label="Quizás tengas razón, pero no creo que los demonios Orokin supieran más del funcionamiento del alma que nosotros. No eran grandes dioses.",shape=box,color=blue];
		847 -> 852;
	848 [label="Quizás tengas razón, o quizás te dé paz creerlo.",shape=box,color=blue];
		848 -> 851;
	836 [label="Que estamos escondiendo algún gran y terrible pecado.",shape=box,color=blue];
		836 -> 844;
	837 [label="Gracias. No sé si puedas hacerlo, pero a veces lo único que podemos hacer es intentarlo.",shape=box,color=blue];
		837 -> 827;
	838 [label="Y me encantaría conocerla algún día, pero ese no es precisamente el punto, lobito tonto.",shape=box,color=blue];
		838 -> 827;
	850 [label="De cualquier manera, elijo creer que el Otak que murió hace mucho tiempo te sonreiría ahora, al ser amable con lo que sea que viva en su memoria.",shape=box,color=blue];
		850 -> 2920;
	851 [label="Simplemente es difícil para mí decir que el Necraloid tiene alma cuando Loid está parado justo a su lado, oui ?",shape=box,color=blue];
		851 -> 850;
	852 [label="Tecnología, quizá; ciencia, sí, ¿pero el alma? ¡Apenas podían controlar sus propios corazones! Si necesitas más pruebas, mira al diablo con el que viajamos.",shape=box,color=blue];
		852 -> 851;
	844 [label="Y es ese pecado el que debe ser perdonado.",shape=box,color=blue];
		844 -> 849;
	2920 [label="Check boolean LoidFamilyComplete",color=orange];
		2920 -> 2921 [label=true,color=green];
		2920 -> 854 [label=false,color=brown];
	849 [label="Gracias, me has dado mucho en que pensar. À la revoyure.",shape=box,color=blue];
		849 -> 853;
	2921 [label="Tengo que irme. Pero, gracias. Tengo mucho en qué pensar.",shape=box,color=blue];
		2921 -> 2922;
	854 [label="Simplemente espero poder conocer a ese extraño fac-similé que sigue vivo cuando Monsieur Necraloid vuelva a subir las escaleras algún día.",shape=box,color=blue];
		854 -> 855;
		854 -> 856;
	853 [label="Chat ends.",color=orange];
	2922 [label="Chat ends.",color=orange];
	855 [label="No sé si sea prudente entrometerse en los asuntos de otras personas.",shape=box,color=red];
		855 -> 857;
	856 [label="Espero que algún día podamos decirle la verdad a la familia Entrati. Y cuanto antes, mejor. ",shape=box,color=red];
		856 -> 857;
	857 [label="Check boolean MarieFamily1",color=orange];
		857 -> 858 [label=true,color=green];
		857 -> 859 [label=false,color=brown];
	858 [label="Ya veremos, quiero que me cuentes más detalles sobre por qué debemos quedarnos.",shape=box,color=blue];
		858 -> 860;
	859 [label="Hay una historia que creo que no me estás contando. Pero creo que ya fueron suficientes historias por hoy, oui ?",shape=box,color=blue];
		859 -> 860;
	860 [label="Muy pronto volveremos a hablar de la familia Entrati.",shape=box,color=blue];
		860 -> 147;
	147 [label="Chat ends.",color=orange];
