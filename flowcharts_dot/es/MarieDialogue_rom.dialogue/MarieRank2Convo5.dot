digraph {
	"MarieRank2Convo5 begins." [color=orange];
		"MarieRank2Convo5 begins." -> j1631090094;
	j1631090094 [label="Evaluate expressions",color=orange];
		j1631090094 -> j3047467719 [label="MarieOtak1",color=purple];
		j1631090094 -> j445485931 [label="MarieFamily1",color=purple];
		j1631090094 -> j521240272 [label="false",color=purple];
	j3047467719 [label="He estado pensando en lo que me dijiste sobre Monsieur Otak.",shape=box,color=blue];
		j3047467719 -> j799296044;
	j445485931 [label="He estado pensando en lo que me dijiste sobre la familia de le Cardinal.",shape=box,color=blue];
		j445485931 -> j1248336068;
	j521240272 [label="Vengo nuevamente con una pregunta sobre Monsieur \"Necraloid\", si me lo permites.",shape=box,color=blue];
		j521240272 -> j2883016583;
		j521240272 -> j202800200;
	j799296044 [label="Me preguntaba si tal vez se parece a una historia mía. ¿Puedo contártela si tienes tiempo?",shape=box,color=blue];
		j799296044 -> j3357989521;
		j799296044 -> j202800200;
	j1248336068 [label="Me preguntaba si me contarías la historia de Otak, la cara infantil en la parte posterior del cráneo del Necraloid.",shape=box,color=blue];
		j1248336068 -> j90965126;
		j1248336068 -> j3595788694;
	j2883016583 [label="Si, claro ¿qué pasa?",shape=box,color=red];
		j2883016583 -> j1100371547;
	j202800200 [label="[Fin]",shape=box,color=red];
		j202800200 -> "Chat ends.";
	j3357989521 [label="Adelante.",shape=box,color=red];
		j3357989521 -> j1549147822;
	j90965126 [label="Claro.",shape=box,color=red];
		j90965126 -> j4151141769;
	j3595788694 [label="Quizás más tarde. [Fin]",shape=box,color=red];
		j3595788694 -> "Chat ends.";
	j1100371547 [label="Me pregunto por qué hay otra cara en su espalda que parece un garabato de un niño.",shape=box,color=blue];
		j1100371547 -> j3581519639;
	"Chat ends." [color=orange];
	j1549147822 [label="Había una hermana en la Cathédrale que se perdió en los pasillos de su pasado. Sor Cécilia.",shape=box,color=blue];
		j1549147822 -> j381850523;
	j4151141769 [label="Todo indica que era un genio y la mente detrás del aprovechamiento de los cristales de argón.",shape=box,color=red];
		j4151141769 -> j268424667;
	j3581519639 [label="Le pregunté a Monsieur Necraloid y a Monsieur Loid, y ninguno quiso hablar del tema; solo me dieron un nombre: Otak. Y lo pronunciaron con gran tristeza.",shape=box,color=blue];
		j3581519639 -> j244050032;
	j381850523 [label="Ella se paraba frente al gran reloj del vestíbulo y proclamaba que eran las dos de la tarde, pero no sabía qué hora era.",shape=box,color=blue];
		j381850523 -> j3372765413;
	j268424667 [label="Que se aprovechan a partir del Vacío: son la razón por la que podemos crear muchos de los poderosos warframes y armas que fabricamos.",shape=box,color=red];
		j268424667 -> j718059836;
	j244050032 [label="Así que aquí estoy, hablando contigo, esperando que puedas ayudarme.",shape=box,color=blue];
		j244050032 -> j1288660780;
		j244050032 -> j1118825634;
	j3372765413 [label="Encontrábamos todos los cuadros en los pasillos puestos al revés y ella decía que ellos le susurraban historias terribles.",shape=box,color=blue];
		j3372765413 -> j3529629466;
	j718059836 [label="Se especializó en cristalografía. Y sus trabajos se archivaron aquí, en los laboratorios.",shape=box,color=red];
		j718059836 -> j1723921243;
	j1288660780 [label="¿Quieres saber sobre Otak? ¿O sobre por qué no puedes hablar con él?",shape=box,color=red];
		j1288660780 -> j1527012106;
	j1118825634 [label="Otak es... difícil de explicar...",shape=box,color=red];
		j1118825634 -> j2100059297;
	j3529629466 [label="Nos enteramos de que ella simplemente escuchaba las conversaciones de otras habitaciones y pensaba que eran las pinturas las que hablaban...",shape=box,color=blue];
		j3529629466 -> j84139013;
	j1723921243 [label="Por alguna razón, no sé por qué, lo convirtieron en un céfalon y le dieron su propio caparazón necraloide.",shape=box,color=red];
		j1723921243 -> j31192865;
	j1527012106 [label="Creo que con el tiempo me gustaría saber ambas cosas, pero te dejo decidir por dónde empezar. Après tout, no sé cuál es más importante.",shape=box,color=blue];
		j1527012106 -> j2100059297;
	j2100059297 [label="Check boolean LoidFamilyComplete",color=orange];
		j2100059297 -> j3474721494 [label=true,color=green];
		j2100059297 -> j3474721494 [label=false,color=brown];
		j2100059297 -> j4054142154 [label=false,color=brown];
	j84139013 [label="Una vez, confundió todos los cojines de una sala con niños y los invitó a todos a tomar el té...",shape=box,color=blue];
		j84139013 -> j1046066328;
	j31192865 [label="No todos los céfalones fueron creados como castigo. Pero las cosas salieron... mal aquí en Deimos, y él resultó gravemente dañado.",shape=box,color=red];
		j31192865 -> j1495646161;
	j3474721494 [label="Otak era un arquimediano, un científico y académico orokin. Lo que le ocurrió no es precisamente una historia feliz.",shape=box,color=red];
		j3474721494 -> j4208335088;
	j4054142154 [label="Bueno... en resumen, algunos miembros de la familia Entrati están arriba, y... no saben que estamos aquí abajo.",shape=box,color=red];
		j4054142154 -> j2470485345;
	j1046066328 [label="Cuando entré en la habitación, ella me miró y dijo: \"¡Oh, Hermana Odette, ahí estás! Los niños del orfanato están aquí, ¿quieres acompañarme?\"",shape=box,color=blue];
		j1046066328 -> j475882139;
		j1046066328 -> j4159652611;
	j1495646161 [label="+5 Chemistry",color=orange];
		j1495646161 -> j1978657312;
	j4208335088 [label="Boolean MarieOtak1 is now true.",color=orange];
		j4208335088 -> j1480292773;
	j2470485345 [label="Boolean MarieFamily1 is now true.",color=orange];
		j2470485345 -> j1009494574;
	j475882139 [label="¿Qué hiciste?",shape=box,color=red];
		j475882139 -> j3042986068;
	j4159652611 [label="¿Quién era la Hermana Odette?",shape=box,color=red];
		j4159652611 -> j740745918;
	j1978657312 [label="Pauvre petit...",shape=box,color=blue];
		j1978657312 -> j3910371824;
	j1480292773 [label="Par les Luminaires... por favor, continúa.",shape=box,color=blue];
		j1480292773 -> j4151141769;
	j1009494574 [label="Par les Luminaires... ¿Quieres decir que todos estamos aquí abajo en secreto? ¿Es por eso que no podemos salir de aquí? Mais pourquoi ?!",shape=box,color=blue];
		j1009494574 -> j2086407064;
	j3042986068 [label="Acerqué mi silla a un lugar vacío en la mesa y tomé té con ella y los cojines, ¿qué mas podía hacer?",shape=box,color=blue];
		j3042986068 -> j48757760;
	j740745918 [label="Me temo que la Hermana Odette lleva muerta treinta años.",shape=box,color=blue];
		j740745918 -> j962954319;
	j3910371824 [label="Así quie lo transfirieron al necraloid principal, el único Necraloid que queda, y está... ¿bien? Es difícil de explicar.",shape=box,color=red];
		j3910371824 -> j1944226078;
		j3910371824 -> j130389921;
		j3910371824 -> j2586408521;
	j2086407064 [label="Su hija, Euleria, conocida como Madre, y su familia han estado cuidando Deimos durante todo este tiempo.",shape=box,color=red];
		j2086407064 -> j1713206101;
	j48757760 [label="Cómo nos reímos juntas mientras me contaba historias de su pasado. Historias que la Hermana Cécilia nunca le había contado a nadie, al menos que yo sepa.",shape=box,color=blue];
		j48757760 -> j4280526760;
	j962954319 [label="Acerqué mi silla a un lugar vacío en la mesa y tomé té con ella y los cojines.",shape=box,color=blue];
		j962954319 -> j48757760;
	j1944226078 [label="Ojalá pudiéramos arreglarlo, de verdad. Traer de vuelta al verdadero Otak.",shape=box,color=red];
		j1944226078 -> j1549147822;
	j130389921 [label="Me hace sonreír. Es gracioso, pero esconde algo trágico y roto.",shape=box,color=red];
		j130389921 -> j1549147822;
	j2586408521 [label="Lamentablemente, no tiene arreglo. Y creo que irrita a muchas personas. ",shape=box,color=red];
		j2586408521 -> j1549147822;
	j1713206101 [label="Velando por este lugar y por el corazón que bombea energía del Vacío al Sistema Origen, manteniéndonos a todos... utilizables, realmente, desde que Entrati se fue.",shape=box,color=red];
		j1713206101 -> j3382079857;
	j4280526760 [label="Sus ojos brillaban por momentos, pero estaban apagados en otros, como la muñeca de una niña...",shape=box,color=blue];
		j4280526760 -> j828357592;
		j4280526760 -> j2093019985;
		j4280526760 -> j2223282611;
		j4280526760 -> j3007028662;
	j3382079857 [label="Check /Lotus/Scripts/1999/DialogueScriptNodes.lua:IsSyndicateRank(syndicate=EntratiSyndicate, syndicateRank=5)",color=orange];
		j3382079857 -> j2215884040 [label=true,color=green];
		j3382079857 -> j1980571544 [label=false,color=brown];
	j828357592 [label="¿Por qué te sentaste con ella?",shape=box,color=red];
		j828357592 -> j1491793595;
	j2093019985 [label="¿Qué pasó con la Hermana Cécilia?",shape=box,color=red];
		j2093019985 -> j2807779645;
	j2223282611 [label="Espero que haya significado algo para ella que estuvieras ahí.",shape=box,color=red];
		j2223282611 -> j2350361125;
	j3007028662 [label="Fue muy amable de tu parte sentarte con ella.",shape=box,color=red];
		j3007028662 -> j749384034;
	j2215884040 [label="Ella ha aceptado su ausencia y han hecho las paces, pero fue algo que les costó mucho trabajo.",shape=box,color=red];
		j2215884040 -> j1534235016;
	j1980571544 [label="Check boolean MarieSyndicateMaxRank",color=orange];
		j1980571544 -> j2215884040 [label=true,color=green];
		j1980571544 -> j2657181239 [label=false,color=brown];
	j1491793595 [label="+15 Chemistry",color=orange];
		j1491793595 -> j3828099538;
	j2807779645 [label="Lo que le pasa a todos aquellos en su condición. Ella continuó desvaneciéndose, como un cuadro al sol, hasta que no quedó nada. ",shape=box,color=blue];
		j2807779645 -> j2029306274;
	j2350361125 [label="+10 Chemistry",color=orange];
		j2350361125 -> j1127256180;
	j749384034 [label="+5 Chemistry",color=orange];
		j749384034 -> j401143088;
	j1534235016 [label="Saber que él todavía está ahí afuera, en cualquier parte, y que no le ha dicho ni una palabra, ni le ha enviado una carta...?",shape=box,color=red];
		j1534235016 -> j174835114;
	j2657181239 [label="Ella no ha podido aceptar su ausencia y están peleados.",shape=box,color=red];
		j2657181239 -> j2034193720;
	j3828099538 [label="Una pregunta sabia. Una pregunta muy sabia. Creo que varias razones me inspiraron. Me gustaría pensar que fue la amabilidad lo que me llevó a su mesa.",shape=box,color=blue];
		j3828099538 -> j3778665817;
	j2029306274 [label="Después ella nos dejó y celebramos una vigilia en su memoria. Ojalá pudiera recordar, al final, a quienes fueron realmente amables con ella. ",shape=box,color=blue];
		j2029306274 -> j3273789921;
	j1127256180 [label="Me gustaría creer que ella lo entendió, en el fondo.",shape=box,color=blue];
		j1127256180 -> j3273789921;
	j401143088 [label="¿Fue bondad? ¿O fue culpa lo que me inspiró a hacerlo? Ah, pero tú solo estás siendo amable al decirlo. ",shape=box,color=blue];
		j401143088 -> j3273789921;
	j174835114 [label="No puedo imaginar lo doloroso que debe ser esto para ella. Para ellos.",shape=box,color=red];
		j174835114 -> j2869806604;
	j2034193720 [label="¿Saber que él todavía está ahí afuera, suelto, y que no le ha dicho ni una palabra, ni le ha enviado una carta...?",shape=box,color=red];
		j2034193720 -> j1396886294;
	j3778665817 [label="Pero creo que era culpa, quizás, en el fondo. Que si no lo hacía, la estaría descuidando. Como se descuida a un niño.",shape=box,color=blue];
		j3778665817 -> j3273789921;
	j3273789921 [label="Me gustaría creer que tu Otak conoce a personas que son amables y pacientes con él. Pero, claro, él no está realmente ahí, ¿verdad?",shape=box,color=blue];
		j3273789921 -> j1138233920;
	j2869806604 [label="Aunque puedo ver la lógica detrás de la decisión de protegerlos del dolor que le Cardinal ha causado con su necesaria partida...",shape=box,color=blue];
		j2869806604 -> j3690882654;
	j1396886294 [label="Eso destruiría cualquier pequeña posibilidad de reconciliación que pudieran tener.",shape=box,color=red];
		j1396886294 -> j1870826449;
	j1138233920 [label="Estoy hablando de una pieza de tecnología muy elaborada, diseñada para parecerse a un hombre, ¿no? Un fonógrafo, muchísimo más complejo. Al igual que el Necraloid, no tiene alma.",shape=box,color=blue];
		j1138233920 -> j980993877;
		j1138233920 -> j246706354;
		j1138233920 -> j1900413448;
		j1138233920 -> j519328216;
		j1138233920 -> j3823107452;
	j3690882654 [label="Me parece innecesariamente cruel, ¿no crees ? Podrían pensar que está muerto. ¡O peor! Y nosotros, viviendo aquí comme des rats d'égout ?",shape=box,color=blue];
		j3690882654 -> j3200399740;
		j3690882654 -> j2018060179;
	j1870826449 [label="+10 Chemistry",color=orange];
		j1870826449 -> j1833496012;
	j980993877 [label="Puede que el Necraloid no tenga alma, pero es único. Otros céfalones, como Otak, sí la tienen. Fueron destruidos en su proceso de creación.",shape=box,color=red];
		j980993877 -> j99210526;
	j246706354 [label="Tienes razón. ¿Qué sugieres que haga al respecto?",shape=box,color=red];
		j246706354 -> j1301709090;
	j1900413448 [label="Tienes razón. No la tienen. Pero eso no significa que podamos tratarlos mal.",shape=box,color=red];
		j1900413448 -> j3924223061;
	j519328216 [label="No sé si tienes razón. Pero aún pueden pensar y sentir, y no podemos tratarlos como cosas.",shape=box,color=red];
		j519328216 -> j4037036143;
	j3823107452 [label="El Necraloid tiene alma. Todos los céfalones la tienen.",shape=box,color=red];
		j3823107452 -> j2535165805;
	j3200399740 [label="En realidad esa decisión no depende de mí.",shape=box,color=red];
		j3200399740 -> j1413078532;
	j2018060179 [label="De hecho tengo una amiga que adora las ratas. Me parecen adorables.",shape=box,color=red];
		j2018060179 -> j1631253291;
	j1833496012 [label="Oui... Ya veo la lógica. Yo trabajaría para recomponer a su familia, si es posible, non ? Parece ser la única esperanza que tenemos para salir de aquí. ",shape=box,color=blue];
		j1833496012 -> j1602727218;
	j99210526 [label="Boolean MarieCephalonSoul is now true.",color=orange];
		j99210526 -> j3348590796;
	j1301709090 [label="Boolean MarieCephalonNoSoul is now true.",color=orange];
		j1301709090 -> j3671918238;
	j3924223061 [label="Boolean MarieCephalonNoSoul is now true.",color=orange];
		j3924223061 -> j3928855926;
	j4037036143 [label="Boolean MarieCephalonUnsure is now true.",color=orange];
		j4037036143 -> j1712917844;
	j2535165805 [label="Boolean MarieCephalonSoul is now true.",color=orange];
		j2535165805 -> j4237324358;
	j1413078532 [label="Lo sé. Es decisión de Monsieur Loid, y de todos los demás, darse a conocer.",shape=box,color=blue];
		j1413078532 -> j569088105;
	j1631253291 [label="+15 Chemistry",color=orange];
		j1631253291 -> j3513977182;
	j1602727218 [label="O pasaremos el resto de nuestras vidas viviendo aquí atrapados, comme des rats d'égout. ",shape=box,color=blue];
		j1602727218 -> j497049910;
		j1602727218 -> j3754495807;
	j3348590796 [label="+5 Chemistry",color=orange];
		j3348590796 -> j3285362751;
	j3671918238 [label="¡Oh, no creas que pretendo que seas cruel! ¡No! Atesóralos, porque son preciosos, y no es culpa suya ser como son.",shape=box,color=blue];
		j3671918238 -> j3705891797;
	j3928855926 [label="+5 Chemistry",color=orange];
		j3928855926 -> j3671918238;
	j1712917844 [label="+5 Chemistry",color=orange];
		j1712917844 -> j391858357;
	j4237324358 [label="+5 Chemistry",color=orange];
		j4237324358 -> j1553229388;
	j569088105 [label="Yo diría que es la culpa, no la nobleza, lo que nos mantiene aquí.",shape=box,color=blue];
		j569088105 -> j3332096260;
	j3513977182 [label="Y me encantaría conocerla algún día, pero ese no es precisamente el punto, lobito tonto.",shape=box,color=blue];
		j3513977182 -> j569088105;
	j497049910 [label="He sido negligente. Tienes razón. Me pondré a trabajar.",shape=box,color=red];
		j497049910 -> j3069403452;
	j3754495807 [label="De hecho tengo una amiga que adora las ratas. Me parecen adorables. ",shape=box,color=red];
		j3754495807 -> j2268639111;
	j3285362751 [label="Más pruebas de que el diablo y sus semejantes debían ser condenados. Pero quizás tengas razón sobre Otak y los de su clase, o quizás te tranquilice creerlo.",shape=box,color=blue];
		j3285362751 -> j2924865356;
	j3705891797 [label="Mi corazón se rompe solo por los cuerpos destrozados que dejaron los demonios Orokin. No eran dioses, sino devoradores de todo a su paso. Tan sólo mira al que viaja con nosotros como prueba.",shape=box,color=blue];
		j3705891797 -> j1618946474;
	j391858357 [label="Quizás tengas razón, pero no creo que los demonios Orokin supieran más del funcionamiento del alma que nosotros. No eran grandes dioses.",shape=box,color=blue];
		j391858357 -> j2337591416;
	j1553229388 [label="Quizás tengas razón, o quizás te dé paz creerlo.",shape=box,color=blue];
		j1553229388 -> j1618946474;
	j3332096260 [label="Que estamos escondiendo algún gran y terrible pecado.",shape=box,color=blue];
		j3332096260 -> j385348175;
	j3069403452 [label="+5 Chemistry",color=orange];
		j3069403452 -> j216920945;
	j2268639111 [label="+5 Chemistry",color=orange];
		j2268639111 -> j3513977182;
	j2924865356 [label="De cualquier manera, elijo creer que el Otak que murió hace mucho tiempo te sonreiría ahora, al ser amable con lo que sea que viva en su memoria.",shape=box,color=blue];
		j2924865356 -> j1531393501;
	j1618946474 [label="Simplemente es difícil para mí decir que el Necraloid tiene alma cuando Loid está parado justo a su lado, oui ?",shape=box,color=blue];
		j1618946474 -> j2924865356;
	j2337591416 [label="Tecnología, quizá; ciencia, sí, ¿pero el alma? ¡Apenas podían controlar sus propios corazones! Si necesitas más pruebas, mira al diablo con el que viajamos.",shape=box,color=blue];
		j2337591416 -> j1618946474;
	j385348175 [label="Y es ese pecado el que debe ser perdonado.",shape=box,color=blue];
		j385348175 -> j3844029672;
	j216920945 [label="Gracias. No sé si puedas hacerlo, pero a veces lo único que podemos hacer es intentarlo.",shape=box,color=blue];
		j216920945 -> j569088105;
	j1531393501 [label="Check boolean LoidFamilyComplete",color=orange];
		j1531393501 -> j2822594695 [label=true,color=green];
		j1531393501 -> j735053515 [label=false,color=brown];
	j3844029672 [label="Gracias, me has dado mucho en que pensar. À la revoyure.",shape=box,color=blue];
		j3844029672 -> "Chat ends.";
	j2822594695 [label="Tengo que irme. Pero, gracias. Tengo mucho en qué pensar.",shape=box,color=blue];
		j2822594695 -> "Chat ends.";
	j735053515 [label="Simplemente espero poder conocer a ese extraño fac-similé que sigue vivo cuando Monsieur Necraloid vuelva a subir las escaleras algún día.",shape=box,color=blue];
		j735053515 -> j4113354553;
		j735053515 -> j2808131112;
	j4113354553 [label="No sé si sea prudente entrometerse en los asuntos de otras personas.",shape=box,color=red];
		j4113354553 -> j3351551251;
	j2808131112 [label="Espero que algún día podamos decirle la verdad a la familia Entrati. Y cuanto antes, mejor. ",shape=box,color=red];
		j2808131112 -> j3580143893;
	j3351551251 [label="Check boolean MarieFamily1",color=orange];
		j3351551251 -> j1312878895 [label=true,color=green];
		j3351551251 -> j2147818057 [label=false,color=brown];
	j3580143893 [label="Check boolean MarieFamily1",color=orange];
		j3580143893 -> j2860080891 [label=true,color=green];
		j3580143893 -> j3415529383 [label=false,color=brown];
	j1312878895 [label="Ya veremos, quiero que me cuentes más detalles sobre por qué debemos quedarnos.",shape=box,color=blue];
		j1312878895 -> j3828262056;
	j2147818057 [label="Hay una historia que creo que no me estás contando. Pero creo que ya fueron suficientes historias por hoy, oui ?",shape=box,color=blue];
		j2147818057 -> j3828262056;
	j2860080891 [label="Yo también, pero creo que todavía quedan muchos detalles por aprender que hacen que esto sea difícil, oui ?",shape=box,color=blue];
		j2860080891 -> j3828262056;
	j3415529383 [label="Yo también, pero creo que hay muchas cosas que lo dificultan, oui?  Lamentablemente, creo que ya hemos tenido suficientes historias por hoy.",shape=box,color=blue];
		j3415529383 -> j3828262056;
	j3828262056 [label="Muy pronto volveremos a hablar de la familia Entrati.",shape=box,color=blue];
		j3828262056 -> "Chat ends.";
}