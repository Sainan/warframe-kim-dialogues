	3484 [label="¡He conocido a Otak! ¡Por fin lo he conocido!",shape=box,color=blue];
		3484 -> 3487;
		3484 -> 3488;
	3485 [label="¡Lobo! ¡Mi lobito! ¡El rostro en la espalda de Monsieur Necraloid! ¡Por fin lo conozco!",shape=box,color=blue];
		3485 -> 3489;
		3485 -> 3490;
		3485 -> 3491;
	3486 [label="¡El rostro en la espalda de Monsieur Necraloid! ¡Por fin lo conozco!",shape=box,color=blue];
		3486 -> 3489;
		3486 -> 3490;
		3486 -> 3491;
	3487 [label="¿Disfrutaste hablando con él?",shape=box,color=red];
		3487 -> 3492;
	3488 [label="¿Cómo fue tu conversación con él?",shape=box,color=red];
		3488 -> 3493;
	3489 [label="Pobre Otak... ¿Cómo les fue?",shape=box,color=red];
		3489 -> 3494;
	3490 [label="Me alegra que por fin se hayan conocido. Otak puede ser un poco difícil de explicar.",shape=box,color=red];
		3490 -> 3495;
	3491 [label="¿Conociste a Otak? Vaya... ¿Cómo te fue?",shape=box,color=red];
		3491 -> 3496;
	3492 [label="Sí, lo hice. Aunque tal vez hizo que me dieran ganas de llorar. Porque se presentó tres veces en la misma conversación, como si nunca nos hubiéramos conocido.",shape=box,color=blue];
		3492 -> 3497;
	3493 [label="Él... se presentó tres veces en la misma conversación, como si nunca nos hubiéramos conocido.",shape=box,color=blue];
		3493 -> 3497;
	3494 [label="¡Me pareció dulce y encantador! Pero detrás de su humor, sentí una gran tristeza.",shape=box,color=blue];
		3494 -> 3498;
	3495 [label="Sí, supongo que sí. El garabato de un niño en la parte trasera de un autómata. ¡Me pareció dulce y encantador!",shape=box,color=blue];
		3495 -> 3499;
	3496 [label="¿Por qué no parece agradarte que lo haya conocido?",shape=box,color=blue];
		3496 -> 3500;
		3496 -> 3501;
		3496 -> 3502;
	3497 [label="Me saludó con la misma forma alegre y segura todas las veces. ¡Pero él sabía que era una Sœur de Sol! ",shape=box,color=blue];
		3497 -> 3503;
	3498 [label="¿Me contarías la historia del pobre Monsieur Otak?",shape=box,color=blue];
		3498 -> 3504;
	3499 [label="Pero detrás de su humor, se esconde una gran tristeza.",shape=box,color=blue];
		3499 -> 3498;
	3500 [label="A veces me desespera, eso es todo. ",shape=box,color=red];
		3500 -> 3505;
	3501 [label="No era mi intención. Simplemente puede resultar un poco... desagradable para algunas personas.",shape=box,color=red];
		3501 -> 3506;
	3502 [label="Lo siento. A veces puede molestar a los demás. No es culpa suya.",shape=box,color=red];
		3502 -> 3506;
	3503 [label="En efecto, ¡sabía mucho sobre las Luminarias! Hablamos largamente de las \"Religiones Antiguas\", como él las llamaba, en los \"días anteriores al Imperio Orokin\".",shape=box,color=blue];
		3503 -> 3507;
	3504 [label="Otak era un arquimediano, un científico y académico orokin. Lo que le ocurrió no es precisamente una historia feliz.",shape=box,color=red];
		3504 -> 3508;
	3505 [label="Espero que intentes ser más amable con alguien que claramente está enfermo. Mais par la grâce de Sol, vamos todos.",shape=box,color=blue];
		3505 -> 3509;
	3506 [label="Y espero que sean amables y pacientes con él. Mais par la grâce de Sol, vamos todos.",shape=box,color=blue];
		3506 -> 3509;
	3507 [label="Aunque dijo que gran parte de ese conocimiento se había perdido en lo más profundo de los archivos y que estaba estrictamente prohibido. Me hizo jurar guardar el secreto.",shape=box,color=blue];
		3507 -> 3510;
	3508 [label="Todo indica que era un genio y la mente detrás del aprovechamiento de los cristales de argón.",shape=box,color=red];
		3508 -> 3511;
	3509 [label="A todos podría esperarnos un destino parecido. Incluso a ti.",shape=box,color=blue];
		3509 -> 3512;
		3509 -> 3513;
	3510 [label="Me dijo que le preocupaba profundamente que el ejecutor Ballas —quienquiera que fuese— pudiera descubrir mi secta de herejes y me ejecutara.",shape=box,color=blue];
		3510 -> 3514;
		3510 -> 3515;
	3511 [label="Que se extraen del Vacío. Son la razón por la que podemos crear muchos de los poderosos warframes y armas que fabricamos.",shape=box,color=red];
		3511 -> 3516;
	3512 [label="Tienes razón, lo siento. No debí decir eso.",shape=box,color=red];
		3512 -> 3498;
	3513 [label="Lo siento, simplemente no tengo tiempo para él.",shape=box,color=red];
		3513 -> 3517;
	3514 [label="Ballas está muerto... continúa.",shape=box,color=red];
		3514 -> 3518;
	3515 [label="Eso... no va a pasar. Continúa.",shape=box,color=red];
		3515 -> 3518;
	3516 [label="Se especializó en cristalografía. Y sus trabajos se archivaron aquí, en los laboratorios.",shape=box,color=red];
		3516 -> 3519;
	3517 [label="Entonces, lamento haberte hecho desperdiciar aún más.",shape=box,color=blue];
		3517 -> 3520;
	3518 [label="+5 Chemistry",color=orange];
		3518 -> 3521;
	3519 [label="Por alguna razón, no sé por qué, lo convirtieron en un céfalon y le dieron su propio caparazón necraloide.",shape=box,color=red];
		3519 -> 3522;
	3520 [label="Update boolean MarieOtakComplete",color=orange];
		3520 -> 3523;
	3521 [label="Lo sospechaba... Bueno, me preguntó de dónde era, y cuando se lo dije, se rió y dijo: \"¡No, eso es imposible! Y yo debería saberlo, soy...\"",shape=box,color=blue];
		3521 -> 3524;
	3522 [label="No todos los cefalones fueron creados como castigo. Pero aquí en Deimos, las cosas salieron... mal, y él resultó gravemente dañado.",shape=box,color=red];
		3522 -> 3525;
	3523 [label="Chat ends.",color=orange];
	3524 [label="Y entonces... se presentó de nuevo. Y me preguntó si venía de las llanuras con muestras de minerales...",shape=box,color=blue];
		3524 -> 3526;
		3524 -> 3527;
	3525 [label="Pauvre petit...",shape=box,color=blue];
		3525 -> 3528;
	3526 [label="Sí... ese es Otak.",shape=box,color=red];
		3526 -> 3529;
	3527 [label="Oh, Marie. Lo siento mucho...",shape=box,color=red];
		3527 -> 3529;
