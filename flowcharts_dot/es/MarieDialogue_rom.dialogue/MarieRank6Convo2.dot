	j1976151696 [label="¡Lobo! ¡Mi lobito! ¡He conocido a Otak! ¡Por fin lo he conocido!",shape=box,color=blue];
		j1976151696 -> j2350568116;
		j1976151696 -> j438252005;
	j705851157 [label="¡He conocido a Otak! ¡Por fin lo he conocido!",shape=box,color=blue];
		j705851157 -> j2350568116;
		j705851157 -> j438252005;
	j707607381 [label="¡Lobo! ¡Mi lobito! ¡El rostro en la espalda de Monsieur Necraloid! ¡Por fin lo conozco!",shape=box,color=blue];
		j707607381 -> j155782573;
		j707607381 -> j2392778111;
		j707607381 -> j2910536850;
	j917991269 [label="¡El rostro en la espalda de Monsieur Necraloid! ¡Por fin lo conozco!",shape=box,color=blue];
		j917991269 -> j155782573;
		j917991269 -> j2392778111;
		j917991269 -> j2910536850;
	j2350568116 [label="¿Disfrutaste hablando con él?",shape=box,color=red];
		j2350568116 -> j4170543176;
	j438252005 [label="¿Cómo fue tu conversación con él?",shape=box,color=red];
		j438252005 -> j500328140;
	j155782573 [label="Pobre Otak... ¿Cómo les fue?",shape=box,color=red];
		j155782573 -> j727874361;
	j2392778111 [label="Me alegra que por fin se hayan conocido. Otak puede ser un poco difícil de explicar.",shape=box,color=red];
		j2392778111 -> j3466423363;
	j2910536850 [label="¿Conociste a Otak? Vaya... ¿Cómo te fue?",shape=box,color=red];
		j2910536850 -> j4038967735;
	j4170543176 [label="Sí, lo hice. Aunque tal vez hizo que me dieran ganas de llorar. Porque se presentó tres veces en la misma conversación, como si nunca nos hubiéramos conocido.",shape=box,color=blue];
		j4170543176 -> j3645334381;
	j500328140 [label="Él... se presentó tres veces en la misma conversación, como si nunca nos hubiéramos conocido.",shape=box,color=blue];
		j500328140 -> j3645334381;
	j727874361 [label="¡Me pareció dulce y encantador! Pero detrás de su humor, sentí una gran tristeza.",shape=box,color=blue];
		j727874361 -> j4278608988;
	j3466423363 [label="Sí, supongo que sí. El garabato de un niño en la parte trasera de un autómata. ¡Me pareció dulce y encantador!",shape=box,color=blue];
		j3466423363 -> j4241385611;
	j4038967735 [label="¿Por qué no parece agradarte que lo haya conocido?",shape=box,color=blue];
		j4038967735 -> j1465094930;
		j4038967735 -> j563664414;
		j4038967735 -> j3492146903;
	j3645334381 [label="Me saludó con la misma forma alegre y segura todas las veces. ¡Pero él sabía que era una Sœur de Sol! ",shape=box,color=blue];
		j3645334381 -> j2794736692;
	j4278608988 [label="¿Me contarías la historia del pobre Monsieur Otak?",shape=box,color=blue];
		j4278608988 -> j1560958683;
	j4241385611 [label="Pero detrás de su humor, se esconde una gran tristeza.",shape=box,color=blue];
		j4241385611 -> j4278608988;
	j1465094930 [label="A veces me desespera, eso es todo. ",shape=box,color=red];
		j1465094930 -> j1765690857;
	j563664414 [label="No era mi intención. Simplemente puede resultar un poco... desagradable para algunas personas.",shape=box,color=red];
		j563664414 -> j1321324713;
	j3492146903 [label="Lo siento. A veces puede molestar a los demás. No es culpa suya.",shape=box,color=red];
		j3492146903 -> j1321324713;
	j2794736692 [label="En efecto, ¡sabía mucho sobre las Luminarias! Hablamos largamente de las \"Religiones Antiguas\", como él las llamaba, en los \"días anteriores al Imperio Orokin\".",shape=box,color=blue];
		j2794736692 -> j319785667;
	j1560958683 [label="Otak era un arquimediano, un científico y académico orokin. Lo que le ocurrió no es precisamente una historia feliz.",shape=box,color=red];
		j1560958683 -> j76193023;
	j1765690857 [label="Espero que intentes ser más amable con alguien que claramente está enfermo. Mais par la grâce de Sol, vamos todos.",shape=box,color=blue];
		j1765690857 -> j660485631;
	j1321324713 [label="Y espero que sean amables y pacientes con él. Mais par la grâce de Sol, vamos todos.",shape=box,color=blue];
		j1321324713 -> j660485631;
	j319785667 [label="Aunque dijo que gran parte de ese conocimiento se había perdido en lo más profundo de los archivos y que estaba estrictamente prohibido. Me hizo jurar guardar el secreto.",shape=box,color=blue];
		j319785667 -> j3265564402;
	j76193023 [label="Todo indica que era un genio y la mente detrás del aprovechamiento de los cristales de argón.",shape=box,color=red];
		j76193023 -> j2478079106;
	j660485631 [label="A todos podría esperarnos un destino parecido. Incluso a ti.",shape=box,color=blue];
		j660485631 -> j3525076377;
		j660485631 -> j452714239;
	j3265564402 [label="Me dijo que le preocupaba profundamente que el ejecutor Ballas —quienquiera que fuese— pudiera descubrir mi secta de herejes y me ejecutara.",shape=box,color=blue];
		j3265564402 -> j3200554986;
		j3265564402 -> j3057376023;
	j2478079106 [label="Que se extraen del Vacío. Son la razón por la que podemos crear muchos de los poderosos warframes y armas que fabricamos.",shape=box,color=red];
		j2478079106 -> j2136928924;
	j3525076377 [label="Tienes razón, lo siento. No debí decir eso.",shape=box,color=red];
		j3525076377 -> j4278608988;
	j452714239 [label="Lo siento, simplemente no tengo tiempo para él.",shape=box,color=red];
		j452714239 -> j636267791;
	j3200554986 [label="Ballas está muerto... continúa.",shape=box,color=red];
		j3200554986 -> j2505679308;
	j3057376023 [label="Eso... no va a pasar. Continúa.",shape=box,color=red];
		j3057376023 -> j2505679308;
	j2136928924 [label="Se especializó en cristalografía. Y sus trabajos se archivaron aquí, en los laboratorios.",shape=box,color=red];
		j2136928924 -> j668595922;
	j636267791 [label="Entonces, lamento haberte hecho desperdiciar aún más.",shape=box,color=blue];
		j636267791 -> j3007723528;
	j2505679308 [label="+5 Chemistry",color=orange];
		j2505679308 -> j3501159179;
	j668595922 [label="Por alguna razón, no sé por qué, lo convirtieron en un céfalon y le dieron su propio caparazón necraloide.",shape=box,color=red];
		j668595922 -> j887107229;
	j3007723528 [label="Boolean MarieOtakComplete is now true.",color=orange];
		j3007723528 -> "Chat ends.";
	j3501159179 [label="Lo sospechaba... Bueno, me preguntó de dónde era, y cuando se lo dije, se rió y dijo: \"¡No, eso es imposible! Y yo debería saberlo, soy...\"",shape=box,color=blue];
		j3501159179 -> j1108766554;
	j887107229 [label="No todos los cefalones fueron creados como castigo. Pero aquí en Deimos, las cosas salieron... mal, y él resultó gravemente dañado.",shape=box,color=red];
		j887107229 -> j2105349457;
	j1108766554 [label="Y entonces... se presentó de nuevo. Y me preguntó si venía de las llanuras con muestras de minerales...",shape=box,color=blue];
		j1108766554 -> j261431934;
		j1108766554 -> j2831369977;
	j2105349457 [label="Pauvre petit...",shape=box,color=blue];
		j2105349457 -> j253530729;
	j261431934 [label="Sí... ese es Otak.",shape=box,color=red];
		j261431934 -> j3909961541;
	j2831369977 [label="Oh, Marie. Lo siento mucho...",shape=box,color=red];
		j2831369977 -> j3909961541;
	j253530729 [label="Boolean MarieOtak1 is now true.",color=orange];
		j253530729 -> j2350568116;
		j253530729 -> j438252005;
	j3909961541 [label="Me destroza pensar que no hay nada que se pueda hacer por él.",shape=box,color=blue];
		j3909961541 -> j457335464;
	j457335464 [label="Evaluate expressions",color=orange];
		j457335464 -> j1779791368 [label="MarieCephalonSoul",color=purple];
		j457335464 -> j2845787662 [label="MarieCephalonNoSoul",color=purple];
		j457335464 -> j1204347982 [label="MarieCephalonUnsure",color=purple];
		j457335464 -> j132103122 [label="false",color=purple];
	j1779791368 [label="¡Oh, Luminarias! ¿Qué clase de infierno le han preparado para mantener su alma atrapada en esa jaula de ciencia y luces parpadeantes?",shape=box,color=blue];
		j1779791368 -> j2761270809;
	j2845787662 [label="Solo puedo rezar a las Luminarias para que tengas razón y que dentro de esa cáscara no quede nada más que... ciencia y luces parpadeantes.",shape=box,color=blue];
		j2845787662 -> j1849132827;
	j1204347982 [label="Sé que no estás seguro de si los cefalones contienen almas, pero solo puedo rezar a los Luminarias para que... el pobre Otak no sufra.",shape=box,color=blue];
		j1204347982 -> j2822268058;
	j132103122 [label="Solo puedo rezar a las Luminarias para que todo lo que quede dentro de ese caparazón no sea más que... ciencia y luces parpadeantes.",shape=box,color=blue];
		j132103122 -> j3099153804;
	j2761270809 [label="¿Por qué dejarlo allí, destrozado, esperando a que le permitan morir para encontrar la paz? Solo puedo rezar... para que si hay algún tipo de presencia allí...",shape=box,color=blue];
		j2761270809 -> j278759048;
	j1849132827 [label="Y que ningún alma esté atrapada dentro de esa cosa rota, esperando hasta que finalmente se le permita morir para encontrar la paz.",shape=box,color=blue];
		j1849132827 -> j2548618864;
	j2822268058 [label="Que ningún alma esté atrapada dentro de esa cosa rota, esperando hasta que finalmente se le permita morir para encontrar la paz.",shape=box,color=blue];
		j2822268058 -> j826191572;
	j3099153804 [label="Y que ningún alma esté atrapada dentro de esa cosa rota, esperando hasta que finalmente se le permita morir para encontrar la paz.",shape=box,color=blue];
		j3099153804 -> j826191572;
	j278759048 [label="Sea porque permanece allí por elección propia, en una especie de vigilia solitaria...",shape=box,color=blue];
		j278759048 -> j1696101396;
	j2548618864 [label="Porque si te equivocas, ¿qué tal si hay un alma dentro de esa jaula contra su voluntad?",shape=box,color=blue];
		j2548618864 -> j1937242486;
	j826191572 [label="O si hay algún tipo de presencia allí, es porque él permanece por elección propia, en una especie de vigilia solitaria.",shape=box,color=blue];
		j826191572 -> j1696101396;
	j1696101396 [label="Pensar lo contrario es suficiente para poner en duda la bondad de los dioses, non ?",shape=box,color=blue];
		j1696101396 -> j4248073660;
	j1937242486 [label="Es suficiente para poner en duda la bondad de los dioses, non ?",shape=box,color=blue];
		j1937242486 -> j4248073660;
	j4248073660 [label="¿Y eso en dónde me dejaría?",shape=box,color=blue];
		j4248073660 -> j756363323;
	j756363323 [label="Perdóname, estoy... estoy melancólica hoy. ",shape=box,color=blue];
		j756363323 -> j3251038745;
	j3251038745 [label="Evaluate expressions",color=orange];
		j3251038745 -> j2096312041 [label="MarieRoathePastry1",color=purple];
		j3251038745 -> j1484804092 [label="MarieRoathePastry1",color=purple];
		j3251038745 -> j3935795978 [label="MarieRoathePastry1",color=purple];
		j3251038745 -> j1741894828 [label="MarieRoathePastry1",color=purple];
		j3251038745 -> j2096312041 [label="RoatheMariePastry1",color=purple];
		j3251038745 -> j1484804092 [label="RoatheMariePastry1",color=purple];
		j3251038745 -> j3935795978 [label="RoatheMariePastry1",color=purple];
		j3251038745 -> j1741894828 [label="RoatheMariePastry1",color=purple];
		j3251038745 -> j2096312041 [label="false",color=purple];
		j3251038745 -> j1484804092 [label="false",color=purple];
		j3251038745 -> j1741894828 [label="false",color=purple];
	j2096312041 [label="Está bien. Tienes todo el derecho a estarlo.",shape=box,color=red];
		j2096312041 -> j332477788;
	j1484804092 [label="¿Puedo hacer algo para animarte? Podríamos ir a molestar a Roathe.",shape=box,color=red];
		j1484804092 -> j2414176638;
	j3935795978 [label="¿Puedo hacer algo para animarte? ¿Quizás robar unos pasteles?",shape=box,color=red];
		j3935795978 -> j1319940612;
	j1741894828 [label="A veces los dioses son crueles, Marie. Así es la vida.",shape=box,color=red];
		j1741894828 -> j2654728969;
	j332477788 [label="+20 Chemistry",color=orange];
		j332477788 -> j650033952;
	j2414176638 [label="+15 Chemistry",color=orange];
		j2414176638 -> j3685931101;
	j1319940612 [label="+20 Chemistry",color=orange];
		j1319940612 -> j3685931101;
	j2654728969 [label="+5 Chemistry",color=orange];
		j2654728969 -> j3185585229;
	j650033952 [label="Merci. Bueno, ya no quiero estarlo. ¡Voy a hacer algo más alegre! Creo que el tanque de M'sieur Fibonacci necesita una buena limpieza.",shape=box,color=blue];
		j650033952 -> j2486340526;
	j3685931101 [label="¡Ja! Merci. Eso seguro que calma mis lágrimas. Sabes cómo animar a la pequeña y tonta Marie, non ?",shape=box,color=blue];
		j3685931101 -> j2598691060;
		j3685931101 -> j3435587540;
	j3185585229 [label="Oui. Tienes razón. Lo son. El mundo está lleno de historias como la de Monsieur Otak, y muchas peores que la suya. No debería lamentarme por una sola. ",shape=box,color=blue];
		j3185585229 -> j1508044648;
	j2486340526 [label="Check boolean MarieDating",color=orange];
		j2486340526 -> j1994877025 [label=true,color=green];
		j2486340526 -> j1783435543 [label=false,color=brown];
	j2598691060 [label="Es lo mínimo que puedo hacer por ti.",shape=box,color=red];
		j2598691060 -> j1350233930;
	j3435587540 [label="No estás siendo para nada tonta. Yo siento lo mismo.",shape=box,color=red];
		j3435587540 -> j1350233930;
	j1508044648 [label="Y aquí estoy, haciendo precisamente eso. Gracias por hacerme ver que es una tontería. Fie ! La ingenua Marie. Bueno... creo que el tanque de M'sieur Fibonacci necesita una buena limpieza.",shape=box,color=blue];
		j1508044648 -> j2486340526;
	j1994877025 [label="À la revoyure, mi lobito.",shape=box,color=blue];
		j1994877025 -> j3007723528;
	j1783435543 [label="À la revoyure !",shape=box,color=blue];
		j1783435543 -> j3007723528;
	j1350233930 [label="+5 Chemistry",color=orange];
		j1350233930 -> j4058209286;
	j4058209286 [label="Check boolean MarieDating",color=orange];
		j4058209286 -> j1568314589 [label=true,color=green];
		j4058209286 -> j75570141 [label=false,color=brown];
	j1568314589 [label="Merci, merci, merci, mi lobito. Vayamos, pues, a hacer travesuras. ",shape=box,color=blue];
		j1568314589 -> j3007723528;
