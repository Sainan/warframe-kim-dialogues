	3531 [label="¡Oh, Luminarias! ¿Qué clase de infierno le han preparado para mantener su alma atrapada en esa jaula de ciencia y luces parpadeantes?",shape=box,color=blue];
		3531 -> 3535;
	3532 [label="Solo puedo rezar a las Luminarias para que tengas razón y que dentro de esa cáscara no quede nada más que... ciencia y luces parpadeantes.",shape=box,color=blue];
		3532 -> 3536;
	3533 [label="Sé que no estás seguro de si los cefalones contienen almas, pero solo puedo rezar a los Luminarias para que... el pobre Otak no sufra.",shape=box,color=blue];
		3533 -> 3537;
	3534 [label="Solo puedo rezar a las Luminarias para que todo lo que quede dentro de ese caparazón no sea más que... ciencia y luces parpadeantes.",shape=box,color=blue];
		3534 -> 3538;
	3535 [label="¿Por qué dejarlo allí, destrozado, esperando a que le permitan morir para encontrar la paz? Solo puedo rezar... para que si hay algún tipo de presencia allí...",shape=box,color=blue];
		3535 -> 3539;
	3536 [label="Y que ningún alma esté atrapada dentro de esa cosa rota, esperando hasta que finalmente se le permita morir para encontrar la paz.",shape=box,color=blue];
		3536 -> 3540;
	3537 [label="Que ningún alma esté atrapada dentro de esa cosa rota, esperando hasta que finalmente se le permita morir para encontrar la paz.",shape=box,color=blue];
		3537 -> 3541;
	3538 [label="Y que ningún alma esté atrapada dentro de esa cosa rota, esperando hasta que finalmente se le permita morir para encontrar la paz.",shape=box,color=blue];
		3538 -> 3541;
	3539 [label="Sea porque permanece allí por elección propia, en una especie de vigilia solitaria...",shape=box,color=blue];
		3539 -> 3542;
	3540 [label="Porque si te equivocas, ¿qué tal si hay un alma dentro de esa jaula contra su voluntad?",shape=box,color=blue];
		3540 -> 3543;
	3541 [label="O si hay algún tipo de presencia allí, es porque él permanece por elección propia, en una especie de vigilia solitaria.",shape=box,color=blue];
		3541 -> 3544;
	3542 [label="Pensar lo contrario es suficiente para poner en duda la bondad de los dioses, non ?",shape=box,color=blue];
