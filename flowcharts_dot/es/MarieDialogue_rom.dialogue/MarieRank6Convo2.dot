		3555 -> 3558;
	3556 [label="Merci. Bueno, ya no quiero estarlo. ¡Voy a hacer algo más alegre! Creo que el tanque de M'sieur Fibonacci necesita una buena limpieza.",shape=box,color=blue];
		3556 -> 3559;
	3557 [label="¡Ja! Merci. Eso seguro que calma mis lágrimas. Sabes cómo animar a la pequeña y tonta Marie, non ?",shape=box,color=blue];
		3557 -> 3560;
		3557 -> 3561;
	3558 [label="Oui. Tienes razón. Lo son. El mundo está lleno de historias como la de Monsieur Otak, y muchas peores que la suya. No debería lamentarme por una sola. ",shape=box,color=blue];
