		j1134465740 -> j1985950621 [label=true,color=green];
		j1134465740 -> "Chat ends." [label=false,color=brown];
	j4038571033 [label="Mon coeur, ¿podemos hablar? Solo un momento. ",shape=box,color=blue];
		j4038571033 -> j3217677781;
		j4038571033 -> j3699219359;
	j3217677781 [label="Hola, claro. ¿Qué pasa?",shape=box,color=red];
		j3217677781 -> j2743078190;
	j3699219359 [label="[Fin]",shape=box,color=red];
		j3699219359 -> j952339130;
	j2743078190 [label="Solo quería decir que... sé que tu corazón también pertenece a otra persona. Y aunque no la conozco, mi corazón se alegra por ello.",shape=box,color=blue];
		j2743078190 -> j3087941966;
	j952339130 [label="Boolean MarieConsentComplete is now true.",color=orange];
		j952339130 -> "Chat ends.";
	j3087941966 [label="Confío en ti, y si esa persona ocupa un lugar en tu alma, entonces estaré feliz de compartirlo.",shape=box,color=blue];
		j3087941966 -> j1401951884;
	j1401951884 [label="Solo espero tener la oportunidad de conocer a esa persona algún día, ¿sí? El amante de mi amante debe, por lo tanto, ser mío también...",shape=box,color=blue];
		j1401951884 -> j1589266035;
	j1589266035 [label="Es decir, si crees que esa persona estaría dispuesta.",shape=box,color=blue];
		j1589266035 -> j1332806149;
		j1589266035 -> j1275538768;
		j1589266035 -> j2520725238;
	j1332806149 [label="Honestamente, quizás no seas su tipo.",shape=box,color=red];
		j1332806149 -> j3034846715;
	j1275538768 [label="Te adoraría, Marie. Como yo.",shape=box,color=red];
		j1275538768 -> j2651686105;
	j2520725238 [label="Realmente no creo que pudieran resistirse.",shape=box,color=red];
		j2520725238 -> j2651686105;
	j3034846715 [label="¡Pff! Eres terrible, mi lobo. Déjame soñar. Hasta entonces, te tendré cuando te tenga, ¡supongo!",shape=box,color=blue];
		j3034846715 -> j394780201;
	j2651686105 [label="Hasta entonces, te tendré cuando te tenga. Y estaré feliz de compartirte con quienes han llegado a quererte como yo lo he hecho.",shape=box,color=blue];
		j2651686105 -> j394780201;
	j394780201 [label="¡Después de todo, alguien tiene que estar en guardia contra el Murmullo mientras tú estás deambulando y divirtiéndote!",shape=box,color=blue];
		j394780201 -> j3658127123;
	j3658127123 [label="Y hablando de eso, el deber llama. À la revoyure !",shape=box,color=blue];
		j3658127123 -> j952339130;
}