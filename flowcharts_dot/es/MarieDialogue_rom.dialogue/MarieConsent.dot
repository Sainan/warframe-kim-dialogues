	3579 [label="[Fin]",shape=box,color=red];
		3579 -> 3581;
	3582 [label="Solo quería decir que... sé que tu corazón también pertenece a otra persona. Y aunque no la conozco, mi corazón se alegra por ello.",shape=box,color=blue];
		3582 -> 3584;
	3581 [label="Update boolean MarieConsentComplete",color=orange];
		3581 -> 3583;
	3584 [label="Confío en ti, y si esa persona ocupa un lugar en tu alma, entonces estaré feliz de compartirlo.",shape=box,color=blue];
		3584 -> 3585;
	3583 [label="Chat ends.",color=orange];
	3585 [label="Solo espero tener la oportunidad de conocer a esa persona algún día, ¿sí? El amante de mi amante debe, por lo tanto, ser mío también...",shape=box,color=blue];
		3585 -> 3586;
	3586 [label="Es decir, si crees que esa persona estaría dispuesta.",shape=box,color=blue];
		3586 -> 3587;
		3586 -> 3588;
		3586 -> 3589;
	3587 [label="Honestamente, quizás no seas su tipo.",shape=box,color=red];
		3587 -> 3590;
	3588 [label="Te adoraría, Marie. Como yo.",shape=box,color=red];
		3588 -> 3591;
	3589 [label="Realmente no creo que pudieran resistirse.",shape=box,color=red];
		3589 -> 3591;
	3590 [label="¡Pff! Eres terrible, mi lobo. Déjame soñar. Hasta entonces, te tendré cuando te tenga, ¡supongo!",shape=box,color=blue];
		3590 -> 3592;
	3591 [label="Hasta entonces, te tendré cuando te tenga. Y estaré feliz de compartirte con quienes han llegado a quererte como yo lo he hecho.",shape=box,color=blue];
		3591 -> 3592;
	3592 [label="¡Después de todo, alguien tiene que estar en guardia contra el Murmullo mientras tú estás deambulando y divirtiéndote!",shape=box,color=blue];
