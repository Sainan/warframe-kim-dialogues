		j3686017390 -> j3624079615;
	j1265131016 [label="¿Te preguntas qué me da esa certeza? ¿Mientras tú piensas que no podemos conocer el universo?",shape=box,color=blue];
		j1265131016 -> j640011751;
	j3079980623 [label="Para alguien que no sigue ninguna fe, puedo entender por qué eso podría parecer extraño.",shape=box,color=blue];
		j3079980623 -> j481619445;
	j415128230 [label="¿Te preguntas qué me da certeza? ",shape=box,color=blue];
		j415128230 -> j640011751;
	j3949239381 [label="¡¿Sabes lo que significa esto?!",shape=box,color=blue];
		j3949239381 -> j2961707577;
		j3949239381 -> j1854171752;
	j996250847 [label="Oui ! No me gustan las flores cortadas. Si quieres regalarme algo, rezo para que no sean rosas en un jarrón.",shape=box,color=blue];
		j996250847 -> j841036119;
		j996250847 -> j1304034041;
	j3648719684 [label="Pour toi ? Bien sûr.",shape=box,color=blue];
		j3648719684 -> j818479150;
		j3648719684 -> j2429168889;
	j656247873 [label="Supongo que siento la obligación de hacerlo.",shape=box,color=red];
		j656247873 -> j3222404579;
	j261338601 [label="Mi respuesta no fue realmente honesta.",shape=box,color=red];
		j261338601 -> j2935320415;
	j606229895 [label="Tuve una experiencia que cambió mi vida.",shape=box,color=red];
		j606229895 -> j797023256;
	j2724742508 [label="Nunca pasó algo en particular, es solo algo que siento. Me ha guiado.",shape=box,color=red];
		j2724742508 -> j3997203720;
	j3624079615 [label="Quiero creer. Por lo tanto, lo hago.",shape=box,color=red];
		j3624079615 -> j3080931226;
	j640011751 [label="Temo que mi respuesta te decepcione, lobo. No ha habido ningún gran milagro. Ni rayos del cielo que me iluminaran.",shape=box,color=blue];
		j640011751 -> j3546804071;
	j481619445 [label="\"¿Por qué esta joven sensata cree en cosas que yo no creo que sean reales y me parecen una tontería?\", non ?",shape=box,color=blue];
		j481619445 -> j3720154542;
		j481619445 -> j4154699657;
	j2961707577 [label="¿No?",shape=box,color=red];
		j2961707577 -> j1040397647;
	j1854171752 [label="¿Debería de preocuparme?",shape=box,color=red];
		j1854171752 -> j2796401260;
	j841036119 [label="¿Cómo adivinaste que era eso lo que iba a preguntar? ¡Increíble!",shape=box,color=red];
		j841036119 -> j1959549273;
	j1304034041 [label="Eso... no era lo que iba a preguntar, pero lo tendré en cuenta, ¡gracias!",shape=box,color=red];
		j1304034041 -> j2519351446;
	j818479150 [label="¿Por qué crees en Sol?",shape=box,color=red];
		j818479150 -> j2563733639;
