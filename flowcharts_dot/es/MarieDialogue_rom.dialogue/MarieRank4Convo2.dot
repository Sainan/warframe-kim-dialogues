		j2303770414 -> j261338601;
	j3686017390 [label="¿Por qué Sol, en particular? ¿En vez de Lua o en vez del equilibrio que tú defiendes? Muy buena pregunta. ¿Por qué crees tú?",shape=box,color=blue];
