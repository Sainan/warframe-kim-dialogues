		j3222404579 -> j4056295553 [label=true,color=green];
		j3222404579 -> j822245986 [label=false,color=brown];
	j2935320415 [label="Oui ? Tengo curiosidad, ¿por qué mentiste?",shape=box,color=blue];
		j2935320415 -> j2523253181;
		j2935320415 -> j1102010156;
	j797023256 [label="¡Entonces te tengo envidia! La mayoría no tiene la suerte de tener un evento que pueda identificar y que sean tan ferme, oui ?",shape=box,color=blue];
		j797023256 -> j792342646;
	j3997203720 [label="Ah, entonces nuestras respuestas son iguales. Nunca he experimentado un milagro, salvo quizás la llegada de le Cardinal a la Cathédrale.",shape=box,color=blue];
		j3997203720 -> j3339048122;
	j3080931226 [label="Check boolean DrifterFaithNoPeace",color=orange];
		j3080931226 -> j202908858 [label=true,color=green];
		j3080931226 -> j3940415697 [label=false,color=brown];
	j3546804071 [label="Non, siempre he sentido simplemente que ha habido una présence en mi vida que ha estado ahí para guiarme. Un benefactor que sonríe y me dirige cuando llego a una encrucijada, nada más.",shape=box,color=blue];
		j3546804071 -> j3159238882;
		j3546804071 -> j3189690852;
	j3720154542 [label="¿Honestamente? Sí, más o menos. Aunque no quería expresarlo así.",shape=box,color=red];
		j3720154542 -> j2252127697;
	j4154699657 [label="Más bien me preguntaba si hubo un acontecimiento o... un momento que te condujo a ello.",shape=box,color=red];
		j4154699657 -> j640011751;
	j1040397647 [label="¡Yo tampoco! ¡Pero ahora las posibilidades son infinitas!",shape=box,color=blue];
		j1040397647 -> j3908540322;
	j2796401260 [label="Peut-être ! ¡Porque las posibilidades ahora son infinitas!",shape=box,color=blue];
		j2796401260 -> j3908540322;
	j1959549273 [label="Porque el diablo me dijo que lo harías.",shape=box,color=blue];
		j1959549273 -> j3159863232;
	j2519351446 [label="¡Oh! ¡Oh, perdóname! Lo siento. ¿Qué querías preguntar? Et maintenant, je suis mortifiée...",shape=box,color=blue];
		j2519351446 -> j818479150;
		j2519351446 -> j2429168889;
	j4056295553 [label="Y dices que no te trae mucha paz... esto me rompe el corazón.",shape=box,color=blue];
		j4056295553 -> j822245986;
	j822245986 [label="No te diré qué hacer. Ni te diré qué caminos buscar.",shape=box,color=blue];
		j822245986 -> j719102481;
	j2523253181 [label="No lo sé, sinceramente. Fue impulsivo.",shape=box,color=red];
		j2523253181 -> j2448153066;
	j1102010156 [label="Pensé que podría ser una manera de conocerte mejor...",shape=box,color=red];
		j1102010156 -> j1177127668;
	j792342646 [label="Pero tu pregunta era sobre por qué creo, y fui bastante grosera al volverla hacia ti, je m'excuse.",shape=box,color=blue];
		j792342646 -> j640011751;
	j3339048122 [label="Incluso eso fue un acto del hombre y la ciencia, no de las Luminarias, non ? Este suero que me dio el don de volar...",shape=box,color=blue];
		j3339048122 -> j221719625;
	j202908858 [label="¿Pero dices que no te trae mucha paz? Me rompe el corazón...",shape=box,color=blue];
		j202908858 -> j3381308908;
	j3940415697 [label="Pienso que tu fe puede ser la más fuerte de todas, non ?",shape=box,color=blue];
		j3940415697 -> j447141467;
	j3159238882 [label="¿No llamarías al suero de Entrati un milagro?",shape=box,color=red];
		j3159238882 -> j3339048122;
	j3189690852 [label="¿Ni siquiera las voces de Lyon? ¿O la Indiferencia?",shape=box,color=red];
		j3189690852 -> j4289105731;
	j2252127697 [label="Oh, pensar que soy una tonta por creer en las Luminarias es una de las cosas más amables que se pueden pensar sobre alguien que tiene una fe diferente.",shape=box,color=blue];
		j2252127697 -> j738112170;
	j3908540322 [label="¡El diablo debería tener mucho miedo! ¡Cuidado, malvado! ¡La luz te golpeará desde arriba!",shape=box,color=blue];
		j3908540322 -> j135298275;
	j3159863232 [label="No, no, no... No me ibas a preguntar eso, ¿verdad? Ah !! Je vais lui faire bouffer un de ces livres !",shape=box,color=blue];
		j3159863232 -> j350160279;
	j719102481 [label="Porque soy un pobre refugio en esta tormenta del Vacío en la que te encuentras.",shape=box,color=blue];
		j719102481 -> j2015824715;
	j2448153066 [label="No sé qué instinto te impulsó a decirme esas cosas. Pero me alegra que ahora hayas dicho la verdad.",shape=box,color=blue];
		j2448153066 -> j2047360521;
	j1177127668 [label="Oh... no hacía falta que me dijeras esas cosas para conocerme.",shape=box,color=blue];
		j1177127668 -> j2047360521;
	j221719625 [label="Es obra de un hombre. Pero creo que fue Sol quien guió nuestros caminos para unirnos.",shape=box,color=blue];
		j221719625 -> j942337619;
	j3381308908 [label="Suena como si estuvieras vagando por el bosque, buscando desesperadamente un sendero que te gustaría encontrar.",shape=box,color=blue];
		j3381308908 -> j761188390;
	j447141467 [label="¿Caminar por el sendero del bosque simplemente con la esperanza de que tu corazón marque el camino?",shape=box,color=blue];
		j447141467 -> j1021501332;
	j4289105731 [label="Podría ser, no lo sé. Quizás el diablo tenga razón y todo sea producto de una ciencia que aún no comprendemos. Ambas no son excluyentes, non ?",shape=box,color=blue];
		j4289105731 -> j942337619;
	j738112170 [label="No me ofende en absoluto y siempre me alegra tu honestidad. ",shape=box,color=blue];
		j738112170 -> j640011751;
	j135298275 [label="+20 Chemistry",color=orange];
		j135298275 -> j3488523684;
	j350160279 [label="¿Qué es lo que querías preguntar? Et maintenant, je suis mortifiée...",shape=box,color=blue];
		j350160279 -> j818479150;
		j350160279 -> j2429168889;
	j2015824715 [label="Pero me pregunto si no te encuentras en una encrucijada y deseas pensar qué camino tomar, non ?",shape=box,color=blue];
		j2015824715 -> j2448993907;
	j2047360521 [label="Un alma es más que la fe que uno tiene. Soy une Sœur de Sol, pero esperaría que vieras más que eso en mí, non ?",shape=box,color=blue];
		j2047360521 -> j4141746318;
	j942337619 [label="Por eso creo. Siento a Sol a mi lado cuando estoy más insegura. Cierro los ojos et il est là, para guiarme.",shape=box,color=blue];
		j942337619 -> j4190085832;
		j942337619 -> j1056637807;
		j942337619 -> j2748324285;
	j761188390 [label="No sé si algún día lo encontrarás, pero rezo para que así sea. Porque lo que puedas descubrir allí será un milagro. ",shape=box,color=blue];
		j761188390 -> j792342646;
	j1021501332 [label="Eso es hermoso...",shape=box,color=blue];
		j1021501332 -> j792342646;
	j3488523684 [label="Sainte Mère Sol, vous avez béni votre fille aujourd'hui ! JA-JA !!",shape=box,color=blue];
		j3488523684 -> "Chat ends.";
	j2448993907 [label="La obligación no es motivo para creer. Solo genera dudas, en el mejor de los casos, y un desprecio vacío, en el peor.",shape=box,color=blue];
		j2448993907 -> j1114385501;
	j4141746318 [label="¡Hay tantos temas como estrellas en el cielo para elegir!",shape=box,color=blue];
		j4141746318 -> j3207516051;
		j4141746318 -> j2849835242;
	j4190085832 [label="Eso es hermoso.",shape=box,color=red];
		j4190085832 -> j310211143;
	j1056637807 [label="¿Alguna vez ha fallado al guiarte?",shape=box,color=red];
		j1056637807 -> j3404224696;
	j2748324285 [label="Desearía tener eso...",shape=box,color=red];
		j2748324285 -> j142541915;
	j1114385501 [label="La fe debería ser un bálsamo para el alma. No un pretexto ni una excusa.",shape=box,color=blue];
		j1114385501 -> j2259570344;
	j3207516051 [label="Entonces, ¿me perdonas?",shape=box,color=red];
		j3207516051 -> j4035432937;
	j2849835242 [label="Lo siento, fue una tontería hacerlo.",shape=box,color=red];
		j2849835242 -> j3614010279;
	j310211143 [label="Oui y sé que tengo suerte. Y es una paz que es fácil intentar imponer a los demás, ya sea que quieran o no tenerla.",shape=box,color=blue];
		j310211143 -> j1810342407;
	j3404224696 [label="Oui, muchas veces. Y en esos momentos, reflexiono sobre el porqué. Quizás debo simplemente encontrar mi propio camino, non ? Ou peut-être que je suis une folle après tout, ja ! No siempre estamos destinados a saber.",shape=box,color=blue];
		j3404224696 -> j1810342407;
	j142541915 [label="Oui y rezo para que lo tengas algún día. Pero no es algo que se pueda dar ni enseñar, es algo que hay que encontrar.",shape=box,color=blue];
		j142541915 -> j2689807039;
	j2259570344 [label="Boolean DrifterCrossroads is now true.",color=orange];
		j2259570344 -> j792342646;
	j4035432937 [label="Oui, te perdono. Si fueras como Lyon, te diría que te mereces diez latigazos.",shape=box,color=blue];
		j4035432937 -> j2499513127;
	j3614010279 [label="Oui, ¡y si fueras como Lyon, te diría que te mereces diez latigazos! Pero no lo eres. Y estás perdonado.",shape=box,color=blue];
		j3614010279 -> j2499513127;
	j1810342407 [label="Pero mientras no haga daño a nadie con mis creencias, no veo ningún problema en mantenerlas, oui ?",shape=box,color=blue];
		j1810342407 -> j4196359459;
	j2689807039 [label="Dentro o fuera, el lugar donde se encuentra es diferente para cada persona.",shape=box,color=blue];
