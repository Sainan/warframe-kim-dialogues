		156 -> 163;
	154 [label="Por alguna razón, no sé por qué, lo convirtieron en un céfalon y le dieron su propio caparazón necraloide.",shape=box,color=red];
		154 -> 159;
	152 [label="Ella ha aceptado su ausencia y han hecho las paces, pero fue algo que les costó mucho trabajo.",shape=box,color=red];
		152 -> 157;
	153 [label="Ella no ha podido aceptar su ausencia y siguen en desacuerdo.",shape=box,color=red];
		153 -> 158;
	160 [label="Intento pensar en las discapacidades como algo que nos cambia. Nos limitan en algunos aspectos, sí, pero pueden darnos fortalezas que otros no tienen.",shape=box,color=red];
		160 -> 167;
	161 [label="¿Nunca has visto tu condición como un problema?",shape=box,color=red];
