	183 [label="Tienes razón. Ojalá pudiéramos hacer algo.",shape=box,color=red];
		183 -> 194;
	184 [label="En realidad, esa decisión no depende de mí.",shape=box,color=red];
		184 -> 195;
	185 [label="De hecho, tengo una amiga que adora las ratas. Me parecen adorables.",shape=box,color=red];
		185 -> 196;
	186 [label="Para que no pasemos el resto de nuestras vidas atrapados aquí, comme des rats d'égout. ",shape=box,color=blue];
		186 -> 197;
		186 -> 198;
	202 [label="Ojalá mi querido Lyon pudiera ver el mundo como tú. Que todos los inconvenientes vienen con un poder secreto, como dices.",shape=box,color=blue];
		202 -> 213;
	203 [label="Agradezco tu amabilidad, Viajero. Lo dejaré así, para no exceder las cargas que podría imponerte... ",shape=box,color=blue];
		203 -> 214;
	204 [label="No estás solo, Viajero. Lyon es como de la familia para mí, y a veces todavía me pregunto si lo conozco mejor que las estatuas de los santos de la catedral.",shape=box,color=blue];
		204 -> 215;
