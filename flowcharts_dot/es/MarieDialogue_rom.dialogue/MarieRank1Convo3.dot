	187 [label="Ojalá pudiéramos arreglarlo, de verdad. Traer de vuelta al verdadero Otak.",shape=box,color=red];
		187 -> 199;
	188 [label="Me hace sonreír. Es gracioso, pero esconde algo trágico y roto.",shape=box,color=red];
		188 -> 200;
	189 [label="Lamentablemente, no tiene arreglo. Y creo que irrita a muchas personas. ",shape=box,color=red];
