digraph {
	graph [fontname="Roboto Condensed"];
	node [fontname="Roboto Condensed"];
	edge [fontname="Roboto Condensed"];

	"MarieRank1Convo3 begins." [color=orange];
		"MarieRank1Convo3 begins." -> j3674993814;
	j3674993814 [label="Il y a un crâne volant ! Keksekça ?! Hay una calavera que habla y vuela y todos siguen con sus vidas como si nada pasara. Necesito que alguien reconozca que su existencia es toda una rareza.",shape=box,color=blue];
		j3674993814 -> j458125912;
		j3674993814 -> j1099812474;
		j3674993814 -> j202800200;
	j458125912 [label="Ah, es Necraloide. Bueno, un necraloide. Es complicado.",shape=box,color=red];
		j458125912 -> j571514883;
	j1099812474 [label="Es Necraloide. Es un céfalon, no te lastimará.",shape=box,color=red];
		j1099812474 -> j922625829;
	j202800200 [label="[Fin]",shape=box,color=red];
		j202800200 -> "Chat ends.";
	j571514883 [label="Pardon... ¿eso es un nombre o un objeto?",shape=box,color=blue];
		j571514883 -> j452888997;
		j571514883 -> j3842953690;
	j922625829 [label="¡No lo veo como una amenaza! No me asusta.",shape=box,color=blue];
		j922625829 -> j2721153327;
	"Chat ends." [color=orange];
	j452888997 [label="Yo... realmente no lo sé.",shape=box,color=red];
		j452888997 -> j2523088701;
	j3842953690 [label="Sí.",shape=box,color=red];
		j3842953690 -> j620539667;
	j2721153327 [label="De hecho, lo encuentro sumamente encantador, aunque algo rígido al conversar. No muy diferente de su inspiración viviente. Pero dada la naturaleza de mi compañero de viaje preferido, eso no me molesta mucho.",shape=box,color=blue];
		j2721153327 -> j520532481;
	j2523088701 [label="Para empezar, ¿quién diseñó a estos \"Necraloides\"? ¿Será un nombre y quizás también una... designación?",shape=box,color=blue];
		j2523088701 -> j133953029;
		j2523088701 -> j3642177927;
	j620539667 [label="No... no lo entiendo. ¿Y qué papel tiene Loid en todo esto?",shape=box,color=blue];
		j620539667 -> j2523088701;
	j520532481 [label="No, lo que pueda parecerte grotesco en su rostro no es el problema que me preocupa en este momento, eso te lo aseguro.",shape=box,color=blue];
		j520532481 -> j2771668503;
		j520532481 -> j2747079896;
	j133953029 [label="Tu Cardinal Dimanche. Entrati.",shape=box,color=red];
		j133953029 -> j3512913895;
	j3642177927 [label="A ese lo hizo Entrati. Pero el concepto de lo que son, de los cefalones, fue inventado por los orokin.",shape=box,color=red];
		j3642177927 -> j3512913895;
	j2771668503 [label="Me sorprende que el cráneo no te moleste.",shape=box,color=red];
		j2771668503 -> j1824863268;
	j2747079896 [label="Admito que... fuera de contexto, debe ser extraño. Pero ¿cuál es el verdadero problema?",shape=box,color=red];
		j2747079896 -> j244510843;
	j3512913895 [label="Excusez-moi... ¿Quieres decir que le Cardinal creó un sirviente en forma de cráneo volador a imagen de su compañero y le dio ese nombre?",shape=box,color=blue];
		j3512913895 -> j2738645929;
	j1824863268 [label="Sabes poco de mí y no es culpa tuya. He pasado gran parte de mi vida cuidando a los muertos y sus lugares de descanso. ",shape=box,color=blue];
		j1824863268 -> j3331126688;
	j244510843 [label="Tengo curiosidad de saber por qué hay otra cara en su espalda que parece un garabato de un niño.",shape=box,color=blue];
		j244510843 -> j834779218;
	j2738645929 [label="Entonces, ¿por qué no hay más de estos necraloides?",shape=box,color=blue];
		j2738645929 -> j2541339136;
		j2738645929 -> j1059639162;
		j2738645929 -> j340127933;
	j3331126688 [label="De hecho, he pasado la mayor parte de mi vida con ellos, como si fueran mis compañeros de viaje. Están deseosos de escuchar mis problemas cotidianos.",shape=box,color=blue];
		j3331126688 -> j4063127048;
	j834779218 [label="Le pregunté a Monsieur Necraloide y a Monsieur Loid, pero ninguno quiso hablar del tema. Sólo me dijeron un nombre: Otak. Y lo dijeron con gran tristeza.",shape=box,color=blue];
		j834779218 -> j639706210;
	j2541339136 [label="Tal vez se dio cuenta de lo horrible que es crear una copia digital de tu propio amante.",shape=box,color=red];
		j2541339136 -> j2928726291;
	j1059639162 [label="Quizás sólo tenía intención de hacer uno.",shape=box,color=red];
		j1059639162 -> j3248826973;
	j340127933 [label="No lo sé. ¿Quizás nunca tuvo tiempo de hacer más?",shape=box,color=red];
		j340127933 -> j174943810;
	j4063127048 [label="Boolean MarieGraveyard1 is now true.",color=orange];
		j4063127048 -> j1071542932;
		j4063127048 -> j3543758004;
	j639706210 [label="Así que heme aquí, hablando contigo, esperando que puedas ayudarme.",shape=box,color=blue];
		j639706210 -> j3095244857;
		j639706210 -> j3560607673;
	j2928726291 [label="Ou bien... un homenaje a su amor y respeto, porque no creía que ese extraño laboratorio pudiera seguir funcionando sin Monsieur Loid.",shape=box,color=blue];
		j2928726291 -> j4211637450;
		j2928726291 -> j1359096728;
	j3248826973 [label="+5 Chemistry",color=orange];
		j3248826973 -> j1075683686;
	j174943810 [label="Piénsalo... ¡un grupo de calaveras voladoras con una eficiencia perfecta y casual!",shape=box,color=blue];
		j174943810 -> j1359096728;
		j174943810 -> j3713025280;
	j1071542932 [label="¿Te gustaba cuidar cementerios?",shape=box,color=red];
		j1071542932 -> j994816176;
	j3543758004 [label="¿Alguna vez te respondieron?",shape=box,color=red];
		j3543758004 -> j2082295197;
	j3095244857 [label="¿Quieres saber sobre Otak o el porqué no puedes hablar con él?",shape=box,color=red];
		j3095244857 -> j131445934;
	j3560607673 [label="Otak es... difícil de explicar...",shape=box,color=red];
		j3560607673 -> j3287217001;
	j4211637450 [label="Yo diría que es un gesto raro pero romántico, aunque no soy la mejor persona para hablar de ello.",shape=box,color=red];
		j4211637450 -> j2603378155;
	j1359096728 [label="Honestamente, no me importaría tener un Necraloide zumbando alrededor de mi casa.",shape=box,color=red];
		j1359096728 -> j3702393476;
	j1075683686 [label="Trágico y hermoso, a su manera, non ? Un homenaje a su amor y respeto, porque no creía que ese extraño laboratorio pudiera seguir funcionando sin Monsieur Loid.",shape=box,color=blue];
		j1075683686 -> j3061246222;
		j1075683686 -> j4211637450;
	j3713025280 [label="Honestamente, me alegro de que sólo haya uno. No creo que el mundo esté preparado para algo así.",shape=box,color=red];
		j3713025280 -> j376816103;
	j994816176 [label="Y mausoleos y cryptes, sí. Pero admito que prefería los espacios al aire libre, aunque fueran un reto para mi silla. No más que las escaleras, me temo.",shape=box,color=blue];
		j994816176 -> j2427967412;
	j2082295197 [label="¡Ah! Por suerte, no. No hasta que tu \"Necraloide\" de cara macabra me respondió. Desconozco si hablar con los muertos es uno de los dones otorgados por las Luminarias.",shape=box,color=blue];
		j2082295197 -> j3890385695;
	j131445934 [label="Creo que con el tiempo me gustaría saber ambas cosas, pero te dejo decidir por dónde empezar. Après tout, no sé cuál es más importante.",shape=box,color=blue];
		j131445934 -> j3287217001;
	j3287217001 [label="Check boolean LoidFamilyComplete",color=orange];
		j3287217001 -> j1506419698 [label=true,color=green];
		j3287217001 -> j1506419698 [label=false,color=brown];
		j3287217001 -> j1784031745 [label=false,color=brown];
	j2603378155 [label="Y ahora tengo curiosidad, pero esto parece una historia para otro momento. Cela dit...",shape=box,color=blue];
		j2603378155 -> j244510843;
	j3702393476 [label="Entonces estoy completamente segura de que quizá necesites compañía, tenerlo todo ordenado o ambas cosas. Pero ese es un tema para otra ocasión.",shape=box,color=blue];
		j3702393476 -> j244510843;
	j3061246222 [label="Creo que tenía más que ver con asegurarse de que este lugar no se derrumbara.",shape=box,color=red];
		j3061246222 -> j3973173345;
	j376816103 [label="¡Yo también! Y esto me lleva a mi siguiente pregunta.",shape=box,color=blue];
		j376816103 -> j244510843;
	j2427967412 [label="Boolean MarieSerum1 is now true.",color=orange];
		j2427967412 -> j339173325;
		j2427967412 -> j792688036;
	j3890385695 [label="No, oír espíritus y voces está más al alcance de mi querido Lyon que de mí. Aunque me pregunto si Monsieur Necraloide no estará embrujado, a juzgar por el garabato del chico en su nuca.",shape=box,color=blue];
		j3890385695 -> j1519887330;
	j1506419698 [label="Otak era un arquimediano, un científico y académico orokin. Lo que le ocurrió no es precisamente una historia feliz.",shape=box,color=red];
		j1506419698 -> j2679860855;
	j1784031745 [label="Bueno... en resumen, algunos miembros de la familia Entrati están arriba, y... no saben que estamos aquí abajo.",shape=box,color=red];
		j1784031745 -> j4201409646;
	j3973173345 [label="Y puede que tengas razón. La amalgama voladora parece estar perdiendo gran parte de la razón de ser y la esencia del verdadero Monsieur Loid. Cela dit...",shape=box,color=blue];
		j3973173345 -> j244510843;
	j339173325 [label="No sabía si era apropiado preguntarte si el suero había cambiado tus pies...",shape=box,color=red];
		j339173325 -> j1677132276;
	j792688036 [label="¿Tu silla?",shape=box,color=red];
		j792688036 -> j2610064986;
	j1519887330 [label="En realidad, de eso quería hablarte, si no te importa.",shape=box,color=blue];
		j1519887330 -> j834779218;
	j2679860855 [label="Boolean MarieOtak1 is now true.",color=orange];
		j2679860855 -> j2578938287;
	j4201409646 [label="Boolean MarieFamily1 is now true.",color=orange];
		j4201409646 -> j2768198879;
	j1677132276 [label="+10 Chemistry",color=orange];
		j1677132276 -> j3226737495;
	j2610064986 [label="No sé cómo la llamarías... un fauteuil roulant o... quizás un término que detesto profundamente, un fauteuil pour invalide.",shape=box,color=blue];
		j2610064986 -> j1133086170;
	j2578938287 [label="Par les Luminaires... por favor, continúa.",shape=box,color=blue];
		j2578938287 -> j1325778333;
	j2768198879 [label="Por las Luminarias... ¿Quieres decir que estamos aquí en secreto? ¿Es por eso que no podemos salir de aquí? Mais pourquoi ?!",shape=box,color=blue];
		j2768198879 -> j859153287;
	j3226737495 [label="Oh ! Oh, pobre de ti. Ahí estás, preguntándote si le Cardinal me quitó mes pieds ! Non, non, non, nada de eso.",shape=box,color=blue];
		j3226737495 -> j472132845;
	j1133086170 [label="Como la que usamos ahora, con estos adorables dispositivos para comunicarse. Pero con ruedas a los lados para movernos. Una silla con ruedas, por así decirlo.",shape=box,color=blue];
		j1133086170 -> j2514267053;
		j1133086170 -> j1387884634;
	j1325778333 [label="Todo indica que era un genio y la mente detrás del aprovechamiento de los cristales de argón.",shape=box,color=red];
		j1325778333 -> j844436671;
	j859153287 [label="Su hija, Euleria, conocida como Madre, y su familia han estado cuidando Deimos durante todo este tiempo.",shape=box,color=red];
		j859153287 -> j3323965612;
	j472132845 [label="Sol consideró apropiado incluir en mi vida la incomodidad de haber nacido con pies tradicionalmente inmanejables. No podía caminar. ",shape=box,color=blue];
		j472132845 -> j3702790698;
	j2514267053 [label="¿Estabas discapacitada antes de convertirte en protoframe?",shape=box,color=red];
		j2514267053 -> j2030779792;
	j1387884634 [label="Lo creas o no, las llamamos sillas de ruedas.",shape=box,color=red];
		j1387884634 -> j1152735118;
	j844436671 [label="Que se extraen del Vacío. Son la razón por la que podemos crear muchos de los poderosos warframes y armas que fabricamos.",shape=box,color=red];
		j844436671 -> j1961665565;
	j3323965612 [label="Velando por este lugar y por el corazón que bombea energía del Vacío al Sistema Origen, manteniéndonos a todos... utilizables, realmente, desde que Entrati se fue.",shape=box,color=red];
		j3323965612 -> j3173460060;
	j3702790698 [label="Pero fue simplemente eso: un inconveniente.",shape=box,color=blue];
		j3702790698 -> j591160916;
	j2030779792 [label="Non. No lo estaba.",shape=box,color=blue];
		j2030779792 -> j3350176257;
	j1152735118 [label="¡Ja! ¡Me río de mí misma por ser tan tonta! Sí, supongo que las llamarías sillas de ruedas, ya que son sillas con ruedas. Cómo no lo pensé.",shape=box,color=blue];
		j1152735118 -> j591160916;
	j1961665565 [label="Se especializó en cristalografía. Y sus trabajos se archivaron aquí, en los laboratorios.",shape=box,color=red];
		j1961665565 -> j3790998537;
	j3173460060 [label="Check /Lotus/Scripts/1999/DialogueScriptNodes.lua:CheckDuviriMitwCollectibles",color=orange];
		j3173460060 -> j1857683016 [label=true,color=green];
		j3173460060 -> j2362593335 [label=false,color=brown];
	j591160916 [label="Pero no echo de menos tener que empujar la silla para desplazarme. Y supongo que Lyon tampoco. ¡Volar es pura libertad!",shape=box,color=blue];
		j591160916 -> j2323373852;
		j591160916 -> j2100195203;
		j591160916 -> j324746717;
	j3350176257 [label="Boolean MarieInvalid is now true.",color=orange];
		j3350176257 -> "Chat ends.";
	j3790998537 [label="Por alguna razón, no sé por qué, lo convirtieron en un céfalon y le dieron su propio caparazón necraloide.",shape=box,color=red];
		j3790998537 -> j48114158;
	j1857683016 [label="Ella ha aceptado su ausencia y han hecho las paces, pero fue algo que les costó mucho trabajo.",shape=box,color=red];
		j1857683016 -> j3168529593;
	j2362593335 [label="Check boolean MarieSyndicateMaxRank",color=orange];
		j2362593335 -> j1857683016 [label=true,color=green];
		j2362593335 -> j3574096265 [label=false,color=brown];
	j2323373852 [label="Intento pensar en las discapacidades como algo que nos cambia. Nos limitan en algunos aspectos, sí, pero pueden darnos fortalezas que otros no tienen.",shape=box,color=red];
		j2323373852 -> j3095886786;
	j2100195203 [label="¿Nunca has visto tu condición como un problema?",shape=box,color=red];
		j2100195203 -> j1600693512;
	j324746717 [label="¿Sabías que el suero de protoframe te haría esto?",shape=box,color=red];
		j324746717 -> j3172872650;
	j48114158 [label="No todos los cefalones fueron creados como castigo. Pero aquí en Deimos, las cosas salieron... mal, y él resultó gravemente dañado.",shape=box,color=red];
		j48114158 -> j3634426298;
	j3168529593 [label="¿Saber que él todavía está ahí afuera, suelto, y que no le ha dicho ni una palabra, ni le ha enviado una carta...?",shape=box,color=red];
		j3168529593 -> j1664191158;
	j3574096265 [label="Ella no ha podido aceptar su ausencia y siguen en desacuerdo.",shape=box,color=red];
		j3574096265 -> j820438492;
	j3095886786 [label="+5 Chemistry",color=orange];
		j3095886786 -> j2633694585;
	j1600693512 [label="Nunca le he visto sentido a quejarme. Sin embargo, te diré que me encanta poder alcanzar objetos de estantes altos sin ayuda.",shape=box,color=blue];
		j1600693512 -> j605633494;
	j3172872650 [label="Oui, le Cardinal nos contó a Lyon y a mí todo lo que sucedería con los sueros que nos cambiarían la forma. Sabíamos lo que harían.",shape=box,color=blue];
		j3172872650 -> j2649041473;
	j3634426298 [label="+5 Chemistry",color=orange];
		j3634426298 -> j3180543780;
	j1664191158 [label="No puedo imaginar lo doloroso que debe ser esto para ella. Para ellos.",shape=box,color=red];
		j1664191158 -> j834033877;
	j820438492 [label="¿Saber que él todavía está ahí afuera, suelto, y que no le ha dicho ni una palabra, ni le ha enviado una carta...?",shape=box,color=red];
		j820438492 -> j3798118639;
	j2633694585 [label="Boolean MarieSecretPower is now true.",color=orange];
		j2633694585 -> j336729539;
	j605633494 [label="Ce qui est fait est fait. No podía pedirle a Sol un milagro cuando tanta gente sufría a mi alrededor, cuando tantos lo necesitaban más. Las Luminarias ya me habían dado tanto.",shape=box,color=blue];
		j605633494 -> j2362488599;
	j2649041473 [label="Pero como todas las cosas, yo tomé la mía con gusto, y Lyon tomó la suya... oh, me temo que ando revelando cosas sobre él y no debería hacerlo.",shape=box,color=blue];
		j2649041473 -> j403573150;
		j2649041473 -> j3817009752;
	j3180543780 [label="Pauvre petit...",shape=box,color=blue];
		j3180543780 -> j18091472;
	j834033877 [label="Si bien entiendo la lógica detrás de la decisión de protegerlos del dolor que le Cardinal causó con su necesaria partida...",shape=box,color=blue];
		j834033877 -> j87604612;
	j3798118639 [label="Eso destruiría cualquier pequeña posibilidad de reconciliación que pudieran tener.",shape=box,color=red];
		j3798118639 -> j4116782889;
	j336729539 [label="Oui ! Tú lo entiendes. Vi el mundo desde otra perspectiva. Mis brazos estaban más fuertes. Soy más paciente. Sé lo que significa disfrutar el momento.",shape=box,color=blue];
		j336729539 -> j3869426139;
	j2362488599 [label="Me tengo que ir. Gracias por esta maravillosa distracción. ",shape=box,color=blue];
		j2362488599 -> "Chat ends.";
	j403573150 [label="No hay problema. No me digas nada más de lo que te resulte cómodo.",shape=box,color=red];
		j403573150 -> j604034799;
	j3817009752 [label="Por favor, continúa. Tengo problemas para comunicarme con él.",shape=box,color=red];
		j3817009752 -> j3661911309;
	j18091472 [label="Así que lo transfirieron al Necraloide principal, el único Necraloide que quedaba, y está... ¿bien? Es difícil de explicar.",shape=box,color=red];
		j18091472 -> j2153216932;
		j18091472 -> j320475788;
		j18091472 -> j3400071275;
	j87604612 [label="Me parece innecesariamente cruel, ¿no crees ? Podrían pensar que está muerto. ¡O peor! Y nosotros, viviendo aquí comme des rats d'égout ?",shape=box,color=blue];
		j87604612 -> j717930214;
		j87604612 -> j2527168461;
		j87604612 -> j1206084543;
	j4116782889 [label="+10 Chemistry",color=orange];
		j4116782889 -> j2701746075;
	j3869426139 [label="Cuando llego a mi destino, saboreo el momento. No corro de un lado a otro como insecto de mil patitas.",shape=box,color=blue];
		j3869426139 -> j1232117267;
	j604034799 [label="+5 Chemistry",color=orange];
		j604034799 -> j3724565143;
	j3661911309 [label="+5 Chemistry",color=orange];
		j3661911309 -> j3359703747;
	j2153216932 [label="Ojalá pudiéramos arreglarlo, de verdad. Traer de vuelta al verdadero Otak.",shape=box,color=red];
		j2153216932 -> j3079480543;
	j320475788 [label="Me hace sonreír. Es gracioso, pero esconde algo trágico y roto.",shape=box,color=red];
		j320475788 -> j3651816684;
	j3400071275 [label="Lamentablemente, no tiene arreglo. Y creo que irrita a muchas personas. ",shape=box,color=red];
		j3400071275 -> j3787578039;
	j717930214 [label="Tienes razón. Ojalá pudiéramos hacer algo.",shape=box,color=red];
		j717930214 -> j2028319584;
	j2527168461 [label="En realidad, esa decisión no depende de mí.",shape=box,color=red];
		j2527168461 -> j3356001356;
	j1206084543 [label="De hecho, tengo una amiga que adora las ratas. Me parecen adorables.",shape=box,color=red];
		j1206084543 -> j443502111;
	j2701746075 [label="Oui... Ya veo la lógica. Yo trabajaría para recomponer a su familia, si es posible, non ? Parece ser la única esperanza que tenemos para salir de aquí. ",shape=box,color=blue];
		j2701746075 -> j1944685917;
	j1232117267 [label="Ojalá mi querido Lyon pudiera ver el mundo como tú. Que todos los inconvenientes vienen con un poder secreto, como dices.",shape=box,color=blue];
		j1232117267 -> j4123238161;
	j3724565143 [label="Agradezco tu amabilidad, Viajero. Lo dejaré así, para no exceder las cargas que podría imponerte... ",shape=box,color=blue];
		j3724565143 -> j2842993760;
	j3359703747 [label="No estás solo, Viajero. Lyon es como de la familia para mí, y a veces todavía me pregunto si lo conozco mejor que las estatuas de los santos de la catedral.",shape=box,color=blue];
		j3359703747 -> j873274315;
	j3079480543 [label="+15 Chemistry",color=orange];
		j3079480543 -> j1222071237;
	j3651816684 [label="+15 Chemistry",color=orange];
		j3651816684 -> j2211537374;
	j3787578039 [label="+15 Chemistry",color=orange];
		j3787578039 -> j4108530359;
	j2028319584 [label="Add 1 to Family counter",color=orange];
		j2028319584 -> j4245998931;
	j3356001356 [label="Lo sé. Darse a conocer es decisión de Monsieur Loid y de todos los demás.",shape=box,color=blue];
		j3356001356 -> j569088105;
	j443502111 [label="+10 Chemistry",color=orange];
		j443502111 -> j3513977182;
	j1944685917 [label="Para que no pasemos el resto de nuestras vidas atrapados aquí, comme des rats d'égout. ",shape=box,color=blue];
		j1944685917 -> j3265817068;
		j1944685917 -> j427808035;
	j4123238161 [label="Oh, me temo que estoy difundiendo cosas sobre él que no debería.",shape=box,color=blue];
