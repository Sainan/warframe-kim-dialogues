	167 [label="+5 Chemistry",color=orange];
		167 -> 173;
	168 [label="Nunca le he visto sentido a quejarme. Sin embargo, te diré que me encanta poder alcanzar objetos de estantes altos sin ayuda.",shape=box,color=blue];
		168 -> 174;
	169 [label="Oui, le Cardinal nos contó a Lyon y a mí todo lo que sucedería con los sueros que nos cambiarían la forma. Sabíamos lo que harían.",shape=box,color=blue];
		169 -> 175;
	166 [label="+5 Chemistry",color=orange];
		166 -> 172;
	164 [label="No puedo imaginar lo doloroso que debe ser esto para ella. Para ellos.",shape=box,color=red];
		164 -> 170;
