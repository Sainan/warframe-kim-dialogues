digraph {
	77 [label="MarieRank1Convo3 begins.",color=orange];
		77 -> 78;
	78 [label="Il y a un crâne volant ! Keksekça ?! Hay una calavera que habla y vuela y todos siguen con sus vidas como si nada pasara. Necesito que alguien reconozca que su existencia es toda una rareza.",shape=box,color=blue];
		78 -> 79;
		78 -> 81;
		78 -> 80;
	79 [label="Ah, es Necraloide. Bueno, un necraloide. Es complicado.",shape=box,color=red];
		79 -> 82;
	81 [label="Es Necraloide. Es un céfalon, no te lastimará.",shape=box,color=red];
		81 -> 84;
	80 [label="[Fin]",shape=box,color=red];
		80 -> 83;
	82 [label="Pardon... ¿eso es un nombre o un objeto?",shape=box,color=blue];
		82 -> 85;
		82 -> 86;
	84 [label="¡No lo veo como una amenaza! No me asusta.",shape=box,color=blue];
		84 -> 87;
	83 [label="Chat ends.",color=orange];
	85 [label="Yo... realmente no lo sé.",shape=box,color=red];
		85 -> 88;
	86 [label="Sí.",shape=box,color=red];
		86 -> 89;
	87 [label="De hecho, lo encuentro sumamente encantador, aunque algo rígido al conversar. No muy diferente de su inspiración viviente. Pero dada la naturaleza de mi compañero de viaje preferido, eso no me molesta mucho.",shape=box,color=blue];
		87 -> 90;
	88 [label="Para empezar, ¿quién diseñó a estos \"Necraloides\"? ¿Será un nombre y quizás también una... designación?",shape=box,color=blue];
		88 -> 91;
		88 -> 92;
	89 [label="No... no lo entiendo. ¿Y qué papel tiene Loid en todo esto?",shape=box,color=blue];
		89 -> 88;
	90 [label="No, lo que pueda parecerte grotesco en su rostro no es el problema que me preocupa en este momento, eso te lo aseguro.",shape=box,color=blue];
		90 -> 93;
		90 -> 94;
	91 [label="Tu Cardinal Dimanche. Entrati.",shape=box,color=red];
		91 -> 95;
	92 [label="A ese lo hizo Entrati. Pero el concepto de lo que son, de los cefalones, fue inventado por los orokin.",shape=box,color=red];
		92 -> 95;
	93 [label="Me sorprende que el cráneo no te moleste.",shape=box,color=red];
		93 -> 96;
	94 [label="Admito que... fuera de contexto, debe ser extraño. Pero ¿cuál es el verdadero problema?",shape=box,color=red];
		94 -> 97;
	95 [label="Excusez-moi... ¿Quieres decir que le Cardinal creó un sirviente en forma de cráneo volador a imagen de su compañero y le dio ese nombre?",shape=box,color=blue];
		95 -> 98;
	96 [label="Sabes poco de mí y no es culpa tuya. He pasado gran parte de mi vida cuidando a los muertos y sus lugares de descanso. ",shape=box,color=blue];
		96 -> 99;
	97 [label="Tengo curiosidad de saber por qué hay otra cara en su espalda que parece un garabato de un niño.",shape=box,color=blue];
		97 -> 100;
	98 [label="Entonces, ¿por qué no hay más de estos necraloides?",shape=box,color=blue];
		98 -> 101;
		98 -> 102;
		98 -> 103;
	99 [label="De hecho, he pasado la mayor parte de mi vida con ellos, como si fueran mis compañeros de viaje. Están deseosos de escuchar mis problemas cotidianos.",shape=box,color=blue];
		99 -> 104;
	100 [label="Le pregunté a Monsieur Necraloide y a Monsieur Loid, pero ninguno quiso hablar del tema. Sólo me dijeron un nombre: Otak. Y lo dijeron con gran tristeza.",shape=box,color=blue];
		100 -> 105;
	101 [label="Tal vez se dio cuenta de lo horrible que es crear una copia digital de tu propio amante.",shape=box,color=red];
		101 -> 106;
	102 [label="Quizás sólo tenía intención de hacer uno.",shape=box,color=red];
		102 -> 107;
	103 [label="No lo sé. ¿Quizás nunca tuvo tiempo de hacer más?",shape=box,color=red];
		103 -> 108;
	104 [label="Update boolean MarieGraveyard1",color=orange];
		104 -> 109;
		104 -> 110;
	105 [label="Así que heme aquí, hablando contigo, esperando que puedas ayudarme.",shape=box,color=blue];
		105 -> 111;
		105 -> 112;
	106 [label="Ou bien... un homenaje a su amor y respeto, porque no creía que ese extraño laboratorio pudiera seguir funcionando sin Monsieur Loid.",shape=box,color=blue];
		106 -> 113;
		106 -> 114;
	107 [label="+5 Chemistry",color=orange];
		107 -> 115;
	108 [label="Piénsalo... ¡un grupo de calaveras voladoras con una eficiencia perfecta y casual!",shape=box,color=blue];
		108 -> 114;
		108 -> 116;
	109 [label="¿Te gustaba cuidar cementerios?",shape=box,color=red];
		109 -> 117;
	110 [label="¿Alguna vez te respondieron?",shape=box,color=red];
		110 -> 118;
	111 [label="¿Quieres saber sobre Otak o el porqué no puedes hablar con él?",shape=box,color=red];
		111 -> 119;
	112 [label="Otak es... difícil de explicar...",shape=box,color=red];
		112 -> 2918;
	113 [label="Yo diría que es un gesto raro pero romántico, aunque no soy la mejor persona para hablar de ello.",shape=box,color=red];
		113 -> 122;
	114 [label="Honestamente, no me importaría tener un Necraloide zumbando alrededor de mi casa.",shape=box,color=red];
		114 -> 123;
	115 [label="Trágico y hermoso, a su manera, non ? Un homenaje a su amor y respeto, porque no creía que ese extraño laboratorio pudiera seguir funcionando sin Monsieur Loid.",shape=box,color=blue];
		115 -> 124;
		115 -> 113;
	116 [label="Honestamente, me alegro de que sólo haya uno. No creo que el mundo esté preparado para algo así.",shape=box,color=red];
		116 -> 125;
	117 [label="Y mausoleos y cryptes, sí. Pero admito que prefería los espacios al aire libre, aunque fueran un reto para mi silla. No más que las escaleras, me temo.",shape=box,color=blue];
		117 -> 126;
	118 [label="¡Ah! Por suerte, no. No hasta que tu \"Necraloide\" de cara macabra me respondió. Desconozco si hablar con los muertos es uno de los dones otorgados por las Luminarias.",shape=box,color=blue];
		118 -> 127;
	119 [label="Creo que con el tiempo me gustaría saber ambas cosas, pero te dejo decidir por dónde empezar. Après tout, no sé cuál es más importante.",shape=box,color=blue];
		119 -> 2918;
	2918 [label="Check boolean LoidFamilyComplete",color=orange];
		2918 -> 121 [label=true,color=green];
		2918 -> 121 [label=false,color=brown];
		2918 -> 120 [label=false,color=brown];
	122 [label="Y ahora tengo curiosidad, pero esto parece una historia para otro momento. Cela dit...",shape=box,color=blue];
		122 -> 97;
	123 [label="Entonces estoy completamente segura de que quizá necesites compañía, tenerlo todo ordenado o ambas cosas. Pero ese es un tema para otra ocasión.",shape=box,color=blue];
		123 -> 97;
	124 [label="Creo que tenía más que ver con asegurarse de que este lugar no se derrumbara.",shape=box,color=red];
		124 -> 130;
	125 [label="¡Yo también! Y esto me lleva a mi siguiente pregunta.",shape=box,color=blue];
		125 -> 97;
	126 [label="Update boolean MarieSerum1",color=orange];
		126 -> 131;
		126 -> 132;
	127 [label="No, oír espíritus y voces está más al alcance de mi querido Lyon que de mí. Aunque me pregunto si Monsieur Necraloide no estará embrujado, a juzgar por el garabato del chico en su nuca.",shape=box,color=blue];
		127 -> 133;
	121 [label="Otak era un arquimediano, un científico y académico orokin. Lo que le ocurrió no es precisamente una historia feliz.",shape=box,color=red];
		121 -> 129;
	120 [label="Bueno... en resumen, algunos miembros de la familia Entrati están arriba, y... no saben que estamos aquí abajo.",shape=box,color=red];
		120 -> 128;
	130 [label="Y puede que tengas razón. La amalgama voladora parece estar perdiendo gran parte de la razón de ser y la esencia del verdadero Monsieur Loid. Cela dit...",shape=box,color=blue];
		130 -> 97;
	131 [label="No sabía si era apropiado preguntarte si el suero había cambiado tus pies...",shape=box,color=red];
		131 -> 136;
	132 [label="¿Tu silla?",shape=box,color=red];
		132 -> 137;
	133 [label="En realidad, de eso quería hablarte, si no te importa.",shape=box,color=blue];
		133 -> 100;
	129 [label="Update boolean MarieOtak1",color=orange];
		129 -> 135;
	128 [label="Update boolean MarieFamily1",color=orange];
		128 -> 134;
	136 [label="+10 Chemistry",color=orange];
		136 -> 140;
	137 [label="No sé cómo la llamarías... un fauteuil roulant o... quizás un término que detesto profundamente, un fauteuil pour invalide.",shape=box,color=blue];
		137 -> 141;
	135 [label="Par les Luminaires... por favor, continúa.",shape=box,color=blue];
		135 -> 139;
	134 [label="Por las Luminarias... ¿Quieres decir que estamos aquí en secreto? ¿Es por eso que no podemos salir de aquí? Mais pourquoi ?!",shape=box,color=blue];
		134 -> 138;
	140 [label="Oh ! Oh, pobre de ti. Ahí estás, preguntándote si le Cardinal me quitó mes pieds ! Non, non, non, nada de eso.",shape=box,color=blue];
		140 -> 144;
	141 [label="Como la que usamos ahora, con estos adorables dispositivos para comunicarse. Pero con ruedas a los lados para movernos. Una silla con ruedas, por así decirlo.",shape=box,color=blue];
		141 -> 145;
		141 -> 146;
	139 [label="Todo indica que era un genio y la mente detrás del aprovechamiento de los cristales de argón.",shape=box,color=red];
		139 -> 143;
	138 [label="Su hija, Euleria, conocida como Madre, y su familia han estado cuidando Deimos durante todo este tiempo.",shape=box,color=red];
		138 -> 142;
	144 [label="Sol consideró apropiado incluir en mi vida la incomodidad de haber nacido con pies tradicionalmente inmanejables. No podía caminar. ",shape=box,color=blue];
		144 -> 149;
	145 [label="¿Estabas discapacitada antes de convertirte en protoframe?",shape=box,color=red];
		145 -> 150;
	146 [label="Lo creas o no, las llamamos sillas de ruedas.",shape=box,color=red];
		146 -> 151;
	143 [label="Que se extraen del Vacío. Son la razón por la que podemos crear muchos de los poderosos warframes y armas que fabricamos.",shape=box,color=red];
		143 -> 148;
	142 [label="Velando por este lugar y por el corazón que bombea energía del Vacío al Sistema Origen, manteniéndonos a todos... utilizables, realmente, desde que Entrati se fue.",shape=box,color=red];
		142 -> 861;
	149 [label="Pero fue simplemente eso: un inconveniente.",shape=box,color=blue];
		149 -> 155;
	150 [label="Non. No lo estaba.",shape=box,color=blue];
		150 -> 156;
	151 [label="¡Ja! ¡Me río de mí misma por ser tan tonta! Sí, supongo que las llamarías sillas de ruedas, ya que son sillas con ruedas. Cómo no lo pensé.",shape=box,color=blue];
		151 -> 155;
	148 [label="Se especializó en cristalografía. Y sus trabajos se archivaron aquí, en los laboratorios.",shape=box,color=red];
		148 -> 154;
	861 [label="Check /Lotus/Scripts/1999/DialogueScriptNodes.lua:IsSyndicateRank",color=orange];
