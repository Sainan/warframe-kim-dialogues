		165 -> 171;
	173 [label="Update boolean MarieSecretPower",color=orange];
		173 -> 179;
	174 [label="Ce qui est fait est fait. No podía pedirle a Sol un milagro cuando tanta gente sufría a mi alrededor, cuando tantos lo necesitaban más. Las Luminarias ya me habían dado tanto.",shape=box,color=blue];
		174 -> 180;
	175 [label="Pero como todas las cosas, yo tomé la mía con gusto, y Lyon tomó la suya... oh, me temo que ando revelando cosas sobre él y no debería hacerlo.",shape=box,color=blue];
		175 -> 181;
		175 -> 182;
	172 [label="Pauvre petit...",shape=box,color=blue];
		172 -> 178;
	170 [label="Si bien entiendo la lógica detrás de la decisión de protegerlos del dolor que le Cardinal causó con su necesaria partida...",shape=box,color=blue];
		170 -> 176;
	171 [label="+10 Chemistry",color=orange];
		171 -> 177;
	179 [label="Oui ! Tú lo entiendes. Vi el mundo desde otra perspectiva. Mis brazos estaban más fuertes. Soy más paciente. Sé lo que significa disfrutar el momento.",shape=box,color=blue];
		179 -> 190;
	180 [label="Me tengo que ir. Gracias por esta maravillosa distracción. ",shape=box,color=blue];
		180 -> 191;
	181 [label="No hay problema. No me digas nada más de lo que te resulte cómodo.",shape=box,color=red];
		181 -> 192;
	182 [label="Por favor, continúa. Tengo problemas para comunicarme con él.",shape=box,color=red];
		182 -> 193;
	178 [label="Así que lo transfirieron al Necraloide principal, el único Necraloide que quedaba, y está... ¿bien? Es difícil de explicar.",shape=box,color=red];
		178 -> 187;
		178 -> 188;
		178 -> 189;
	176 [label="Me parece innecesariamente cruel, ¿no crees ? Podrían pensar que está muerto. ¡O peor! Y nosotros, viviendo aquí comme des rats d'égout ?",shape=box,color=blue];
		176 -> 183;
		176 -> 184;
		176 -> 185;
	177 [label="Oui... Ya veo la lógica. Yo trabajaría para recomponer a su familia, si es posible, non ? Parece ser la única esperanza que tenemos para salir de aquí. ",shape=box,color=blue];
		177 -> 186;
	190 [label="Cuando llego a mi destino, saboreo el momento. No corro de un lado a otro como insecto de mil patitas.",shape=box,color=blue];
		190 -> 202;
	191 [label="Chat ends.",color=orange];
	192 [label="+5 Chemistry",color=orange];
		192 -> 203;
	193 [label="+5 Chemistry",color=orange];
