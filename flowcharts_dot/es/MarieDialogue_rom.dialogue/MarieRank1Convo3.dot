		861 -> 153 [label=false,color=brown];
	155 [label="Pero no echo de menos tener que empujar la silla para desplazarme. Y supongo que Lyon tampoco. ¡Volar es pura libertad!",shape=box,color=blue];
		155 -> 160;
		155 -> 161;
		155 -> 162;
