		j3844703164 -> j978197602 [label="MarieFamilySuccess",color=purple];
		j3844703164 -> j978197602 [label="false",color=purple];
	j2771710394 [label="Esto... me hace reconsiderar mi decisión de trabajar contigo para reconciliar a Monsieur Loid con la familia de arriba.",shape=box,color=blue];
		j2771710394 -> j3909390361;
		j2771710394 -> j3724519672;
	j583876017 [label="Me hace darme cuenta de la tragédie que es que el diablo se niegue a ayudarnos en nuestros esfuerzos por reconciliar a Monsieur Loid y la familia de arriba... Me pregunto si no habrá algo que se pueda hacer al respecto.",shape=box,color=blue];
		j583876017 -> j3713642951;
		j583876017 -> j1880273163;
	j978197602 [label="¡Esto me anima aún más a reconciliar a Monsieur Loid con la familia de arriba! ¡Manos a la obra y démosle prisa!",shape=box,color=blue];
		j978197602 -> "Chat ends.";
	j3909390361 [label="Yo... realmente no creí que pudiera conseguir tu ayuda.",shape=box,color=red];
		j3909390361 -> j3209740166;
	j3724519672 [label="¿En serio? ¿Estás cambiando de opinión al respecto?",shape=box,color=red];
		j3724519672 -> j3209740166;
	j3713642951 [label="¿Estás segura de que quieres enfrentarte a él por eso?",shape=box,color=red];
		j3713642951 -> j2409105650;
	j1880273163 [label="¿En serio? ¿Discutirías con Roathe por mi?",shape=box,color=red];
		j1880273163 -> j2409105650;
	j3209740166 [label="Por todo lo que has hecho para ayudar a mi hermano del alma, aunque no estemos de acuerdo en otros asuntos —y quizás nunca lleguemos a estarlo— haré esto por ti.",shape=box,color=blue];
		j3209740166 -> j2948328528;
	j2409105650 [label="¡Ja! He peleado con el diablo por mucho menos. ¿Y por todo lo que has hecho por ayudar a mi hermano del alma? Lo haría con joie. ",shape=box,color=blue];
		j2409105650 -> j4238222837;
	j2948328528 [label="Boolean MarieFamilySuccess is now true.",color=orange];
		j2948328528 -> j766507246;
