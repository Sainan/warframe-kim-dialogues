	"Chat ends." [color=orange];
	j441241288 [label="Dice que ya te lo ha contado todo, oui ? Me dan ganas de llorar solo de pensarlo...",shape=box,color=blue];
		j441241288 -> j3682931513;
		j441241288 -> j928173071;
		j441241288 -> j1761284775;
		j441241288 -> j202800200;
	j3909587016 [label="Dijo que ya te había contado algunas cosas, oui ? Me da gusto que haya empezado a abrirse contigo...",shape=box,color=blue];
		j3909587016 -> j928173071;
		j3909587016 -> j3682931513;
		j3909587016 -> j202800200;
	j3682931513 [label="Creo que está bien, de verdad. Es solo que... ha soportado demasiado.",shape=box,color=red];
		j3682931513 -> j2427541036;
	j928173071 [label="Me rompió el corazón... Ojalá hubiera podido hacer más para ayudarlo...",shape=box,color=red];
		j928173071 -> j1025668190;
	j1761284775 [label="Me alegra que... finalmente confiara en mí lo suficiente como para contarme toda su historia...",shape=box,color=red];
		j1761284775 -> j1306370326;
	j202800200 [label="[Fin]",shape=box,color=red];
		j202800200 -> "Chat ends.";
	j2427541036 [label="+5 Chemistry",color=orange];
		j2427541036 -> j2302064225;
	j1025668190 [label="Haces mucho simplemente escuchando. Estando ahí cuando se siente capaz de hablar. No está roto; las grietas en él no son tan profundas como para destruir sus cimientos. Son cicatrices superficiales.",shape=box,color=blue];
		j1025668190 -> j326868827;
	j1306370326 [label="+5 Chemistry",color=orange];
		j1306370326 -> j3759924094;
	j2302064225 [label="Oui, lo entiendes. No es una cosa rota ni vacía. Sus grietas no destruyen sus cimientos. Son cicatrices superficiales.",shape=box,color=blue];
		j2302064225 -> j326868827;
	j326868827 [label="¿Sabes que ayer lo encontré sentado leyéndole un libro de filosofía antigua a M'sieur Fibonacci?",shape=box,color=blue];
		j326868827 -> j3416564642;
	j3759924094 [label="Oui. Haces mucho con solo escuchar. Él no es una cosa rota ni vacía. Sus grietas no destruyen sus cimientos. Son cicatrices superficiales.",shape=box,color=blue];
		j3759924094 -> j326868827;
	j3416564642 [label="M'sieur Fibonacci llevaba siglos suplicando que alguien se lo leyera, ¡pero todos se negaban! ¡No querían darle municiones, ja!",shape=box,color=blue];
		j3416564642 -> j2486207884;
	j2486207884 [label="Evaluate expressions",color=orange];
		j2486207884 -> j2168133059 [label="LyonDating",color=purple];
		j2486207884 -> j3532915198 [label="MarieDating",color=purple];
		j2486207884 -> j4200549790 [label="false",color=purple];
	j2168133059 [label="Nuestro dulce Lyon jamás habría imaginado hacer algo así. Hablarle de esa manera a los demás. Se estaba divirtiendo.",shape=box,color=blue];
		j2168133059 -> j3864128004;
	j3532915198 [label="Lyon jamás habría imaginado hacer algo así. Hablarle de esa manera a los demás. Se estaba divirtiendo, mon cœur.",shape=box,color=blue];
		j3532915198 -> j3864128004;
	j4200549790 [label="Lyon jamás habría imaginado hacer algo así. Hablarle de esa manera a los demás. Se estaba divirtiendo.",shape=box,color=blue];
		j4200549790 -> j3864128004;
	j3864128004 [label="Y sé que no es a ninguna de las Luminarias a quienes debo agradecer en mis oraciones vespertinas. Es a ti.",shape=box,color=blue];
		j3864128004 -> j3123960711;
	j3123960711 [label="Check boolean LyonDating",color=orange];
