		j3123960711 -> j2015177750 [label=false,color=brown];
		j3123960711 -> j2448471015 [label=false,color=brown];
	j1288165872 [label="Me importa más de lo que puedo expresar. Me hace feliz que se sienta seguro.",shape=box,color=red];
		j1288165872 -> j3069156522;
	j2015177750 [label="Me alegra haber ayudado de cualquier forma.",shape=box,color=red];
		j2015177750 -> j3069156522;
	j2448471015 [label="Se merece un lugar donde pueda sentirse seguro. Amigos. Familia.",shape=box,color=red];
		j2448471015 -> j3069156522;
	j3069156522 [label="+15 Chemistry",color=orange];
		j3069156522 -> j3564964352;
	j3564964352 [label="Oui ! Y es una prueba más de que estamos donde debemos estar. Aquí. Contigo. En este Sanctum. Y juntos.",shape=box,color=blue];
		j3564964352 -> j3844703164;
	j3844703164 [label="Evaluate expressions",color=orange];
