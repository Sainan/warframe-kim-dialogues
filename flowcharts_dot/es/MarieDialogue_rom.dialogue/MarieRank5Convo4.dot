	2980 [label="Pero siento que necesitamos... algún tipo de bastión, non ? ¿Tienes alguna idea?",shape=box,color=blue];
		2980 -> 2984;
		2980 -> 2983;
	2982 [label="Pero creo... creo —ay, Sol, perdóname— que quizá necesitemos la ayuda del diablo. No creo que Monsieur Loid nos escuche de otra manera.",shape=box,color=blue];
		2982 -> 2986;
	2983 [label="Creo que quizá necesitemos la ayuda de Roathe para convencer a Loid de que hable con la familia Entrati. No creo que lo haga de otra manera, sin garantías de que la familia, y él mismo, estén protegidos.",shape=box,color=red];
		2983 -> 2987;
	2981 [label="Creo que tienes razón. El diablo podría ser la pieza que nos falta. ¡Ay, me duele incluso escribir estas palabras! ",shape=box,color=blue];
