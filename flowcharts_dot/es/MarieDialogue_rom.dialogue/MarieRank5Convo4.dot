	j3473852989 [label="Entonces, yo también apoyaré tu decisión.",shape=box,color=blue];
		j3473852989 -> j1179567760;
	j654849689 [label="Mientras tanto hablaré con Lyon, pero no tengo muchas esperanzas.",shape=box,color=blue];
		j654849689 -> j2417620378;
	j3511354670 [label="+20 Chemistry",color=orange];
		j3511354670 -> j428399634;
	j3307708947 [label="Creo que es solo una excusa para ocultar sus intenciones.",shape=box,color=red];
		j3307708947 -> j2524819110;
	j424216580 [label="Al menos ayudará. Y me aseguraré de que no cumpla sus amenazas.",shape=box,color=red];
		j424216580 -> j3089737988;
	j4230750117 [label="Creo que tienes una manera especial de convencerlo, aunque todos los demás han fracasado, non ?",shape=box,color=blue];
		j4230750117 -> j1559125057;
		j4230750117 -> j410051218;
	j805076654 [label="Te deseo mucha suerte. Ese diablo puede ser muy obstinado incluso en el mejor de los casos. ¡A veces creo que simplemente disfruta llevar la contraria!",shape=box,color=blue];
		j805076654 -> j986455410;
		j805076654 -> j4227419221;
	j2384712049 [label="Oui, lo sé. Creo que tienes una manera especial de convencerlo, aunque todos los demás han fracasado, non ?",shape=box,color=blue];
		j2384712049 -> j1559125057;
		j2384712049 -> j410051218;
	j1830105441 [label="Oui, lo sé. Ese diablo puede ser muy obstinado incluso en el mejor de los casos. ¡A veces creo que simplemente disfruta llevando la contraria!",shape=box,color=blue];
		j1830105441 -> j986455410;
