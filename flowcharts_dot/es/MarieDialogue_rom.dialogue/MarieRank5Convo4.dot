	j2213698827 [label="S'il te plaît, haz que pare. Pronto me estaré riendo de sus chistes. ¡Entonces sabré que estoy verdaderamente perdida!",shape=box,color=blue];
		j2213698827 -> j758933647;
	j291119019 [label="¿Has pensado más en cómo convencer a Loid de que hable con la familia Entrati de arriba?",shape=box,color=red];
		j291119019 -> j3487613436;
	j3569663738 [label="He estado pensando en cómo convencer a Loid de que suba esas escaleras para hablar finalmente con la familia, y... tengo una idea, pero no creo que te guste.",shape=box,color=red];
		j3569663738 -> j668862974;
	j209392074 [label="Marie, ¿todavía estás dispuesta a... tal vez intentar convencer a Loid de que hable con los \"vecinos de arriba\"? Sé que dejamos eso en una nota extraña.",shape=box,color=red];
		j209392074 -> j374072022;
	j1785941835 [label="En cuanto al tema de intentar que Loid y la familia Entrati hablen, me preguntaba... ¿si has reconsiderado la participación de Roathe?",shape=box,color=red];
		j1785941835 -> j374072022;
	j3138623981 [label="He estado pensando en cómo Monsieur Loid tiene tanto miedo de hablar con la familia de le Cardinal.",shape=box,color=blue];
