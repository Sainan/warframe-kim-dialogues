	j3331399529 [label="Bonjour mon cœur ! Lo he pensado... y verdaderamente me cuesta admitirlo. No me complace decirlo.",shape=box,color=blue];
		j3331399529 -> j2647387044;
	j2256942267 [label="Bonjour ! Lo he pensado... y verdaderamente me cuesta admitirlo. No me complace decirlo.",shape=box,color=blue];
		j2256942267 -> j2647387044;
	j1090145264 [label="Bonjour, mon cœur ! ¿Y qué es lo que piensas que no me gustará?",shape=box,color=blue];
		j1090145264 -> j1914475993;
	j2728127413 [label="Bonjour ! ¿Oh? ¿Y qué piensas que no me gustará?",shape=box,color=blue];
		j2728127413 -> j1914475993;
	j526480890 [label="Bonjour, bonjour, mon cœur ! Lo he pensado... y verdaderamente me cuesta admitirlo. No me complace decirlo.",shape=box,color=blue];
		j526480890 -> j2211050761;
	j2144837490 [label="Bonjour. Lo he pensado... y verdaderamente me cuesta admitirlo. No me complace decirlo.",shape=box,color=blue];
		j2144837490 -> j2211050761;
	j1587825130 [label="Pero siento que necesitamos... algún tipo de bastión, non ? ¿Tienes alguna idea?",shape=box,color=blue];
		j1587825130 -> j592854944;
		j1587825130 -> j1914475993;
	j2647387044 [label="Pero creo... creo —ay, Sol, perdóname— que quizá necesitemos la ayuda del diablo. No creo que Monsieur Loid nos escuche de otra manera.",shape=box,color=blue];
		j2647387044 -> j469196312;
	j1914475993 [label="Creo que quizá necesitemos la ayuda de Roathe para convencer a Loid de que hable con la familia Entrati. No creo que lo haga de otra manera, sin garantías de que la familia, y él mismo, estén protegidos.",shape=box,color=red];
		j1914475993 -> j2078160731;
	j2211050761 [label="Creo que tienes razón. El diablo podría ser la pieza que nos falta. ¡Ay, me duele incluso escribir estas palabras! ",shape=box,color=blue];
		j2211050761 -> j409794056;
	j592854944 [label="Realmente no se me ocurre nada que no implique la ayuda de recursos terribles. Recursos que podrían meternos en serios problemas más adelante. Es decir, Roathe.",shape=box,color=red];
		j592854944 -> j3230488332;
	j469196312 [label="El diablo es poderoso y podría ser útil si las cosas salen mal, non ?",shape=box,color=blue];
		j469196312 -> j1571250266;
		j469196312 -> j4538266;
	j2078160731 [label="Odio admitirlo, pero creo que puede que tengas razón... Sol, perdóname.",shape=box,color=blue];
		j2078160731 -> j409794056;
	j409794056 [label="Evaluate expressions",color=orange];
		j409794056 -> j3083964327 [label="RoatheFamilyFail",color=purple];
		j409794056 -> j4094847784 [label="RoatheRedeemed, RoatheFamilyDelay
",color=purple];
		j409794056 -> j3680491058 [label="RoatheVillain, RoatheFamilyDelay",color=purple];
		j409794056 -> j3027601702 [label="false",color=purple];
	j3230488332 [label="¿Lo piensas realmente? Si yo puedo dejar de lado mis diferencias con el diablo, tú también puedes, non ?",shape=box,color=blue];
		j3230488332 -> j1500915091;
		j3230488332 -> j3135274573;
	j1571250266 [label="Tienes razón. No pensé que aceptarías. Tenía miedo de preguntar.",shape=box,color=red];
		j1571250266 -> j409794056;
	j4538266 [label="No, tiene que haber otra manera. Me niego a pedirle ayuda.",shape=box,color=red];
		j4538266 -> j3230488332;
	j3083964327 [label="¿Nos ayudará con esta situación?",shape=box,color=blue];
		j3083964327 -> j3821290996;
	j4094847784 [label="¿Nos ayudará con esta situación?",shape=box,color=blue];
		j4094847784 -> j1242187115;
	j3680491058 [label="¿Nos ayudará con esta situación?",shape=box,color=blue];
		j3680491058 -> j839259594;
	j3027601702 [label="¿Crees que podrás convencerlo para que nos ayude?",shape=box,color=blue];
		j3027601702 -> j2439882050;
		j3027601702 -> j1888944370;
	j1500915091 [label="De acuerdo. Si a ti te parece bien, a mí también.",shape=box,color=red];
		j1500915091 -> j1383515171;
	j3135274573 [label="No, lo siento. ",shape=box,color=red];
		j3135274573 -> j2808156989;
	j3821290996 [label="No, desafortunadamente... creo que eso no tendrá solución. ¿Crees que haya otra manera?",shape=box,color=red];
		j3821290996 -> j975296399;
	j1242187115 [label="Lo hará. Lo convencí para que ayude a reunirlos y aunque no lo creas, pienso que es para que pueda proteger a la familia Entrati. Al fin y al cabo, son todo lo que queda de los Orokin.",shape=box,color=red];
		j1242187115 -> j4252615382;
	j839259594 [label="Lo hará. Lo convencí para que ayude a reunirlos, y esto no te sorprenderá, creo que es principalmente para fastidiar a Albrecht en su ausencia.",shape=box,color=red];
		j839259594 -> j1383729731;
	j2439882050 [label="Todavía estoy trabajando en ello, pero creo que sí.",shape=box,color=red];
		j2439882050 -> j961489522;
	j1888944370 [label="Todavía no hay nada decidido. Él es... bueno, ya sabes cómo es.",shape=box,color=red];
		j1888944370 -> j3827853471;
	j1383515171 [label="Sí, no tengo por qué disfrutarlo, pero supongo que es un mal que debemos soportar.",shape=box,color=blue];
		j1383515171 -> j409794056;
	j2808156989 [label="+20 Chemistry",color=orange];
		j2808156989 -> j3473852989;
	j975296399 [label="¡Oh! Qué lástima... No sé, no lo creo... ¿Se te ocurre otra forma de lidiar con el diablo? ¿O alguna manera de intentarlo de nuevo?",shape=box,color=blue];
		j975296399 -> j654849689;
	j4252615382 [label="Está ayudando a proteger a la familia del hombre que lo convirtió en protoframe contra su voluntad y lo envió al pasado, robándole sus recuerdos...",shape=box,color=blue];
		j4252615382 -> j3511354670;
	j1383729731 [label="Tienes razón, no me sorprende.",shape=box,color=blue];
		j1383729731 -> j3307708947;
		j1383729731 -> j424216580;
