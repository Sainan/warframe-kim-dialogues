	3066 [label="Update boolean MarieFamilySuccess",color=orange];
		3066 -> 3076;
	3062 [label="Y nunca durante momentos privados. Non. Jamais.",shape=box,color=blue];
		3062 -> 3071;
		3062 -> 3072;
	3063 [label="Será mejor para nosotros si actúas como un pequeño ángel de la guarda sobre su hombro para calmarlo.",shape=box,color=blue];
		3063 -> 3073;
		3063 -> 3074;
	3058 [label="Y supongo que últimamente estoy en lo más alto de esa lista, non ? Supongo que debería... considerar sus razones, para entender por qué es como es. La condena no salva almas.",shape=box,color=blue];
		3058 -> 3067;
	3057 [label="Siempre hay un dolor que ocultamos a quienes nos rodean. Algo que buscamos proteger, por temor a que otros lo utilicen en nuestra contra. Supongo que debería esforzarme por ser más amable con él, si lo que dices es cierto.",shape=box,color=blue];
		3057 -> 3067;
	3060 [label="No puedo imaginar la cantidad de amor y pérdida que uno debe sufrir en todos esos años. Parece tan irreal, incluso después de todo lo que he visto.",shape=box,color=blue];
		3060 -> 3069;
	3061 [label="A veces, cuando hablo con él, olvido cuántos siglos ha vivido. Parece tan irreal, incluso después de todo lo que he visto.",shape=box,color=blue];
		3061 -> 3070;
	3056 [label="Siempre hay... matices, oui ? Siempre hay razones para actuar de una forma u otra. Supongo que debería esforzarme por ser más amable con él, si lo que dices es cierto.",shape=box,color=blue];
		3056 -> 3067;
	3059 [label="Nadie jamás ha negado el ingenio del diablo.",shape=box,color=blue];
		3059 -> 3068;
