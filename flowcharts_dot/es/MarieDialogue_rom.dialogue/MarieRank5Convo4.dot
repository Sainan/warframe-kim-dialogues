		3055 -> 3066;
	3049 [label="Jamás insinuaría que, puesto que el diablo te favorece, quizá te escuche a ti aunque ignore a todos los demás.",shape=box,color=blue];
		3049 -> 3062;
	3050 [label="Simplemente me alegra que seas feliz. Y si el diablo tiene dónde enfocar sus... esfuerzos... mejor aún, non ?",shape=box,color=blue];
		3050 -> 3063;
	3045 [label="Todos en su vida han intentado convertirlo en una especie de monstruo. Supongo que soy la primera persona que no lo ha hecho.",shape=box,color=red];
		3045 -> 3058;
	3044 [label="Hay muchas cosas de él que simplemente no sabe cómo mostrar. No es realmente una armadura, sino que no confía en que la gente no le haga daño.",shape=box,color=red];
		3044 -> 3057;
	3047 [label="Él... ha sufrido mucho en su vida. Simplemente le quedaron cicatrices.",shape=box,color=red];
		3047 -> 3060;
	3048 [label="Supongo que puedo comprender la cantidad de años que ha vivido. He visto la misma cantidad de muerte que él.",shape=box,color=red];
		3048 -> 3061;
	3043 [label="Siempre intentó hacer lo correcto. Quizás de la manera equivocada, claro, pero intentaba salvar el Sistema Origen de los Orokin.",shape=box,color=red];
		3043 -> 3056;
	3046 [label="Me gusta su humor irónico. Es inteligente, cuando logras superar su ego.",shape=box,color=red];
