	j1179567760 [label="Boolean MarieFamilyFail is now true.",color=orange];
		j1179567760 -> j2605366984;
	j2417620378 [label="+20 Chemistry",color=orange];
		j2417620378 -> j3871220579;
	j428399634 [label="He juzgado muy mal a nuestro demonio...",shape=box,color=blue];
		j428399634 -> j2877551927;
	j2524819110 [label="Oui, espero que tengas razón.",shape=box,color=blue];
		j2524819110 -> j70687620;
	j3089737988 [label="Oui. Al menos estás aquí para asegurarnos de que no dé rienda suelta a sus... instintos más bajos.",shape=box,color=blue];
		j3089737988 -> j70687620;
	j1559125057 [label="¿Qué estás insinuando, Marie?",shape=box,color=red];
		j1559125057 -> j775848288;
	j410051218 [label="No quisiera utilizar mi relación con él como herramienta de negociación.",shape=box,color=red];
		j410051218 -> j1611491450;
	j986455410 [label="Puede serlo, pero creo que mucho de eso es solo una fachada.",shape=box,color=red];
		j986455410 -> j3142691678;
	j4227419221 [label="La verdad es que lo disfruto, por raro que parezca. Nos llevamos bien.",shape=box,color=red];
		j4227419221 -> j953591353;
	j2605366984 [label="Boolean MarieRank5Convo4Complete is now true.",color=orange];
		j2605366984 -> "Chat ends.";
	j3871220579 [label="¡El diablo es caprichoso! C'est la vie, como se dice!",shape=box,color=blue];
		j3871220579 -> j3569999725;
	j2877551927 [label="¡Y no soy una tonta como para no ver el rol que has tenido para que todo esto sucediera!",shape=box,color=blue];
		j2877551927 -> j1263896752;
	j70687620 [label="Check boolean MarieDating",color=orange];
		j70687620 -> j427037956 [label=true,color=green];
		j70687620 -> j845597665 [label=false,color=brown];
	j775848288 [label="+5 Chemistry",color=orange];
		j775848288 -> j1398297453;
	j1611491450 [label="¡Oh! ¡Eso no es lo que quería decir, pardonne-moi! Simplemente que pareces agradarle, ya que te presta atención aunque ignora a todos los demás.",shape=box,color=blue];
		j1611491450 -> j1094935421;
	j3142691678 [label="Oui ? ¿Qué quieres decir?",shape=box,color=blue];
		j3142691678 -> j1155893159;
	j953591353 [label="Oui, sin duda parece que le agradas. ¿Será porque comparten tiempo y lugar, mientras que nosotros no? ¿Si no por qué?",shape=box,color=blue];
		j953591353 -> j1155893159;
	j3569999725 [label="Boolean MarieFamilySuccess is now true.",color=orange];
		j3569999725 -> j2605366984;
	j1263896752 [label="Check boolean MarieDating",color=orange];
		j1263896752 -> j3236627167 [label=true,color=green];
		j1263896752 -> j2834210961 [label=false,color=brown];
	j427037956 [label="+10 Chemistry",color=orange];
		j427037956 -> j3579142258;
	j845597665 [label="+10 Chemistry",color=orange];
		j845597665 -> j3710286165;
	j1398297453 [label="¡Por supuesto que no tengo ni idea de a qué te refieres! No estoy insinuando nada en absoluto. Soy una inocente Sœur de Sol.",shape=box,color=blue];
		j1398297453 -> j415250333;
	j1094935421 [label="+5 Chemistry",color=orange];
		j1094935421 -> j4274077611;
	j1155893159 [label="Evaluate expressions",color=orange];
		j1155893159 -> j3850736018 [label="RoatheVillain",color=purple];
		j1155893159 -> j3480592909 [label="RoatheRedeemed",color=purple];
		j1155893159 -> j2585373226 [label="RoatheUnloved3",color=purple];
		j1155893159 -> j1799569045 [label="RoatheTraitor2",color=purple];
		j1155893159 -> j1777942322 [label="RoatheExecutor2",color=purple];
		j1155893159 -> j2515422988 [label="false",color=purple];
	j3236627167 [label="Merci, merci, merci, mon coeur !",shape=box,color=blue];
		j3236627167 -> j1749359336;
	j2834210961 [label="Merci, merci, merci !",shape=box,color=blue];
		j2834210961 -> j1749359336;
	j3579142258 [label="¡Bueno! Cuando llegue el momento, estaré lista y esperando. Hasta entonces, merci, mon cœur.",shape=box,color=blue];
		j3579142258 -> j3569999725;
	j3710286165 [label="¡Bueno! Cuando llegue el momento, estaré lista y esperando. Hasta entonces, merci.",shape=box,color=blue];
		j3710286165 -> j3569999725;
	j415250333 [label="Jamás insinuaría que, puesto que el diablo te favorece, quizá te escuche a ti aunque ignore a todos los demás.",shape=box,color=blue];
		j415250333 -> j631819285;
	j4274077611 [label="Simplemente me alegra que seas feliz. Y si el diablo tiene dónde enfocar sus... esfuerzos... mejor aún, non ?",shape=box,color=blue];
		j4274077611 -> j10151237;
	j3850736018 [label="Todos en su vida han intentado convertirlo en una especie de monstruo. Supongo que soy la primera persona que no lo ha hecho.",shape=box,color=red];
		j3850736018 -> j1716735303;
	j3480592909 [label="Hay muchas cosas de él que simplemente no sabe cómo mostrar. No es realmente una armadura, sino que no confía en que la gente no le haga daño.",shape=box,color=red];
		j3480592909 -> j3651681460;
	j2585373226 [label="Él... ha sufrido mucho en su vida. Simplemente le quedaron cicatrices.",shape=box,color=red];
		j2585373226 -> j777158728;
	j1799569045 [label="Supongo que puedo comprender la cantidad de años que ha vivido. He visto la misma cantidad de muerte que él.",shape=box,color=red];
		j1799569045 -> j1732591235;
	j1777942322 [label="Siempre intentó hacer lo correcto. Quizás de la manera equivocada, claro, pero intentaba salvar el Sistema Origen de los Orokin.",shape=box,color=red];
		j1777942322 -> j803332996;
	j2515422988 [label="Me gusta su humor irónico. Es inteligente, cuando logras superar su ego.",shape=box,color=red];
		j2515422988 -> j732892587;
	j1749359336 [label="¡Bueno! Cuando llegue el momento, estaré lista y esperando. ¡Hasta entonces!",shape=box,color=blue];
		j1749359336 -> j3569999725;
	j631819285 [label="Y nunca durante momentos privados. Non. Jamais.",shape=box,color=blue];
		j631819285 -> j2410706231;
		j631819285 -> j1307919468;
	j10151237 [label="Será mejor para nosotros si actúas como un pequeño ángel de la guarda sobre su hombro para calmarlo.",shape=box,color=blue];
		j10151237 -> j2604811764;
		j10151237 -> j3421355450;
	j1716735303 [label="Y supongo que últimamente estoy en lo más alto de esa lista, non ? Supongo que debería... considerar sus razones, para entender por qué es como es. La condena no salva almas.",shape=box,color=blue];
		j1716735303 -> j45334591;
	j3651681460 [label="Siempre hay un dolor que ocultamos a quienes nos rodean. Algo que buscamos proteger, por temor a que otros lo utilicen en nuestra contra. Supongo que debería esforzarme por ser más amable con él, si lo que dices es cierto.",shape=box,color=blue];
		j3651681460 -> j45334591;
	j777158728 [label="No puedo imaginar la cantidad de amor y pérdida que uno debe sufrir en todos esos años. Parece tan irreal, incluso después de todo lo que he visto.",shape=box,color=blue];
		j777158728 -> j3440274428;
	j1732591235 [label="A veces, cuando hablo con él, olvido cuántos siglos ha vivido. Parece tan irreal, incluso después de todo lo que he visto.",shape=box,color=blue];
		j1732591235 -> j2054661120;
	j803332996 [label="Siempre hay... matices, oui ? Siempre hay razones para actuar de una forma u otra. Supongo que debería esforzarme por ser más amable con él, si lo que dices es cierto.",shape=box,color=blue];
		j803332996 -> j45334591;
	j732892587 [label="Nadie jamás ha negado el ingenio del diablo.",shape=box,color=blue];
		j732892587 -> j3130741097;
	j2410706231 [label="Me sorprendes. Estoy impresionado. ",shape=box,color=red];
		j2410706231 -> j1094935421;
	j1307919468 [label="Nunca imaginé que tuvieras este lado.",shape=box,color=red];
		j1307919468 -> j1094935421;
	j2604811764 [label="No puedo prometer nada.",shape=box,color=red];
		j2604811764 -> j3655406844;
	j3421355450 [label="¿Quién dice que estoy intentando calmarlo?",shape=box,color=red];
		j3421355450 -> j471057229;
	j45334591 [label="+10 Chemistry",color=orange];
		j45334591 -> j426073436;
	j3440274428 [label="Oui, ¿qué daño podría causar eso a un alma? Entiendo por qué querrías encontrar a alguien que te comprendiera. Y él, a ti.",shape=box,color=blue];
		j3440274428 -> j45334591;
	j2054661120 [label="Haber vivido tanto tiempo, haber visto tanta muerte y haber pagado un costo tan alto.",shape=box,color=blue];
		j2054661120 -> j3440274428;
	j3130741097 [label="+5 Chemistry",color=orange];
		j3130741097 -> j426073436;
	j3655406844 [label="Add 1 to Thermostat counter",color=orange];
		j3655406844 -> j1359094155;
