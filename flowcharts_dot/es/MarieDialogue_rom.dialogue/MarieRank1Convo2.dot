	72 [label="+15 Chemistry",color=orange];
		72 -> 74;
	73 [label="Non, non, non, no es por ti. Lyon tiene... mucho ruido en la cabeza. Es muy cuidadoso con quién lo comparte.",shape=box,color=blue];
