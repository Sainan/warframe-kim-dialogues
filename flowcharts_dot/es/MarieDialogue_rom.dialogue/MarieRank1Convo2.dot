		64 -> 67;
	65 [label="¡Ja! De mis conocidos, es uno de los que aprenden más rápido, Viajero. Si fuera tú, tendría cuidado de retarlo a apuestas que incluyan dinero.",shape=box,color=blue];
		65 -> 67;
	66 [label="Non, se le dan bien las cosas nuevas. No me sorprendería que ya haya estudiado las machines ambulantes que deambulan por las cuevas de allá abajo y que pronto diseñe las suyas.",shape=box,color=blue];
		66 -> 67;
	67 [label="Simplemente no te conoce. Lyon no es... sociable, ni siquiera en las mejores circunstancias. No pretende ofenderte.",shape=box,color=blue];
		67 -> 68;
		67 -> 69;
	68 [label="¿Hay algo que puedas hacer?",shape=box,color=red];
		68 -> 70;
	69 [label="Qué bueno que no es mi culpa...",shape=box,color=red];
		69 -> 71;
	70 [label="Lyon tiene... mucho ruido en la cabeza. Es muy cuidadoso con quién lo comparte.",shape=box,color=blue];
		70 -> 72;
