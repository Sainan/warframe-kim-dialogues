	j513858972 [label="¿Es tecnofóbico?",shape=box,color=red];
		j513858972 -> j2154232166;
	j1532501729 [label="Sí. Pensé que como tú y Roathe ya estaban aquí...",shape=box,color=red];
		j1532501729 -> j1609401083;
	j1630302313 [label="¡Ja! De mis conocidos, es uno de los que aprenden más rápido, Viajero. Si fuera tú, tendría cuidado de retarlo a apuestas que incluyan dinero.",shape=box,color=blue];
		j1630302313 -> j1609401083;
	j2154232166 [label="Non, se le dan bien las cosas nuevas. No me sorprendería que ya haya estudiado las machines ambulantes que deambulan por las cuevas de allá abajo y que pronto diseñe las suyas.",shape=box,color=blue];
		j2154232166 -> j1609401083;
	j1609401083 [label="Simplemente no te conoce. Lyon no es... sociable, ni siquiera en las mejores circunstancias. No pretende ofenderte.",shape=box,color=blue];
		j1609401083 -> j1918724385;
		j1609401083 -> j3983551842;
	j1918724385 [label="¿Hay algo que puedas hacer?",shape=box,color=red];
