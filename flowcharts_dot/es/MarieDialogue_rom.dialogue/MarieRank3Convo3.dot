		1114 -> 1116 [label=false,color=brown];
		1114 -> 1117 [label=false,color=brown];
		1114 -> 1118 [label=false,color=brown];
	1115 [label="¿Podrías contarme más sobre como era vivir en la catedral? ¿Antes de que llegara Entrati?",shape=box,color=red];
		1115 -> 1119;
	1117 [label="¿En dónde creciste Marie?",shape=box,color=red];
		1117 -> 2425;
	1118 [label="[Fin]",shape=box,color=red];
		1118 -> 1122;
	1116 [label="¿Cómo era tu vida en la catedral antes de que apareciera Entrati?",shape=box,color=red];
		1116 -> 1120;
	1119 [label="La verdad es que era algo solitario, supongo. Tenía a Lyon, pero ya sabes como puede ser a veces. (¡Oh! ¡Me alegra tanto que tú y él ya se hablen!)",shape=box,color=blue];
		1119 -> 1123;
	2425 [label="Update boolean MarieBackstory1",color=orange];
		2425 -> 1121;
	1122 [label="Chat ends.",color=orange];
	1120 [label="Oh, no sé si eso te podría interesar tanto, pero te diré de todos modos si es que tienes tanta curiosidad. ",shape=box,color=blue];
		1120 -> 1124;
	1123 [label="Update boolean MarieGraveyard2",color=orange];
		1123 -> 1126;
	1121 [label="Habría pensado que mi idioma te hubiera dado una pista, pero entonces recordé que tú no eres del mundo que yo conocí, ja !",shape=box,color=blue];
		1121 -> 1125;
	1124 [label="La viví haciendo mis tareas como hermana del Sol. Puliendo los utensilios de comunión, preparando las ofrendas votivas para los feligreses. ",shape=box,color=blue];
		1124 -> 1127;
	1126 [label="Pero no es por eso que pasé tanto tiempo hablando con los muertos.",shape=box,color=blue];
		1126 -> 1129;
	1125 [label="Soy de la Cité de la Lumière, la ciudad del capitolio de un país llamado Gaule. En el gran esquema mundial, no está muy lejos de Höllvania en un mapa.",shape=box,color=blue];
		1125 -> 1128;
	1127 [label="Atender la cripta y el cementerio. Eran mis tareas favoritas.",shape=box,color=blue];
		1127 -> 1130;
		1127 -> 1131;
	1129 [label="Update boolean MarieGraveyard2",color=orange];
		1129 -> 1134;
	1128 [label="¿Me pregunto si mi Cathédrale aún exisite en 1999? ¡Qué idea tan interesante!",shape=box,color=blue];
		1128 -> 1132;
		1128 -> 1133;
	1130 [label="¿Por qué era tu favorito?",shape=box,color=red];
		1130 -> 1135;
	1131 [label="Lo siento. ¿Qué hay de la última parte?",shape=box,color=red];
		1131 -> 1136;
	1134 [label="Hay belleza en esos lugares, una tranquillité. Son tan tranquilos. Pacíficos.",shape=box,color=blue];
		1134 -> 1139;
	1132 [label="Te gusta divagar, ¿verdad?",shape=box,color=red];
		1132 -> 1137;
	1133 [label="Le podría preguntar a dos de mis amigos, ellos han viajado bastante. Creo que hasta han mencionado esa ciudad.",shape=box,color=red];
		1133 -> 1138;
	1135 [label="Disfrutaba bastante de hablar con aquellos que yacen descansando. Ellos escuchaban mis preocupaciones sin juzgarme.",shape=box,color=blue];
		1135 -> 1140;
	1136 [label="Era mi deber atender a los muertos de la Cathédrale. Barría el polvo del piso de la cripta, y retiraba la hierba mala del patio.",shape=box,color=blue];
		1136 -> 1135;
	1139 [label="Creo que me gusta decirles mis problemas et les activités des autres porque ya no tienen preocupaciones, oui ?",shape=box,color=blue];
		1139 -> 1143;
	1137 [label="+5 Chemistry",color=orange];
		1137 -> 1141;
	1138 [label="+5 Chemistry",color=orange];
		1138 -> 1142;
	1140 [label="Bueno, no tienen nada que decir, mais cela me convenait tout à fait ! Prefiero que se queden así en silencio.",shape=box,color=blue];
		1140 -> 1144;
	1143 [label="Todo se debe de ver insignificante para ellos, y eso me reconforta a mí.",shape=box,color=blue];
		1143 -> 1146;
		1143 -> 1147;
		1143 -> 1148;
	1141 [label="No lo has notado, oui ? Lyon me molesta todo el tiempo diciendome que soy una mota de polvo en un rayo de sol, flotando a donde me lleve la brisa. (¡Me alegra tanto que tú y él ya se hablen!)",shape=box,color=blue];
		1141 -> 1145;
	1142 [label="Oh, no los molestes, es solamente una tonta idea. No sé que tan triste estaría al pensar que ya no está.",shape=box,color=blue];
		1142 -> 1145;
	1144 [label="+5 Chemistry",color=orange];
		1144 -> 1149;
	1146 [label="No sé, me da... miedo morir de verdad, nunca me ha gustado estar cerca de la muerte.",shape=box,color=red];
		1146 -> 1151;
	1147 [label="Nunca lo había pensado de esa forma.",shape=box,color=red];
		1147 -> 1152;
	1148 [label="He encontrado esa misma paz al estar en los cementerios. Te entiendo completamente.",shape=box,color=red];
		1148 -> 1153;
	1145 [label="Solo me da curiosidad, non ? Quiero saber tout ce qui existe, todo lo que hay, para saber. Creo que es por eso que le Cardinal y yo estábamos destinados a conocernos.",shape=box,color=blue];
		1145 -> 1150;
	1149 [label="¿Te imaginas? Calaveras que hablan, ¿como tus necraloid? ¡Ja!",shape=box,color=blue];
		1149 -> 1154;
		1149 -> 1155;
	1151 [label="Lo sé, pequeña morbide Marie ! Es tan extraño. Pero cada quien con lo suyo, non ?",shape=box,color=blue];
		1151 -> 1157;
	1152 [label="No eres el único. No nos gusta gastar mucho de nuestro tiempo, pensando en qué es lo que viene después. No hasta que lo vemos cerca.",shape=box,color=blue];
		1152 -> 1158;
	1153 [label="¡Me alegro tanto de que lo entiendas!",shape=box,color=blue];
		1153 -> 1158;
	1150 [label="Où en étais-je ? Ah ! Oui. Mi historia.",shape=box,color=blue];
		1150 -> 1156;
	1154 [label="Esa no pudo haber sido la tarea más fácil, por lo de tu silla de ruedas.",shape=box,color=red];
		1154 -> 1159;
	1155 [label="¿No tenías otros amigos con quienes platicar?",shape=box,color=red];
		1155 -> 1160;
	1157 [label="Alguien debe ver por ellos. Y yo estoy más que feliz de hacerlo.",shape=box,color=blue];
		1157 -> 1158;
	1158 [label="Lyon bromea con que estoy muy cerca del suelo, es por eso que pienso tanto en la sepultura.",shape=box,color=blue];
		1158 -> 1162;
	1156 [label="Nací en una familia con dinero, lo cual puede que te sorprenda. La clase burguesa, la más cercana a los orokin que los demás.",shape=box,color=blue];
		1156 -> 1161;
	1159 [label="No, no lo era. Pero Lyon me ayudó a subir y bajar las escaleras dentro de la cripta cuando era necesario, el resto yo pude lograrlo con el tiempo.",shape=box,color=blue];
		1159 -> 1163;
	1160 [label="Update boolean MarieGraveyard1",color=orange];
		1160 -> 1164;
	1162 [label=" Le pregunté si su cabeza estaba vacía, que si por eso está llena de fantasmas.",shape=box,color=blue];
		1162 -> 1166;
	1161 [label="Pero cuando nací como si fuera... deforme, con mes pieds tordus et inutilisables ? Oh, ma mère no podía permitirlo.",shape=box,color=blue];
		1161 -> 1165;
	1163 [label="Es impresionante lo que se puede hacer cuando uno es terco, oui ?",shape=box,color=blue];
		1163 -> 1167;
	1164 [label="Tenía a Lyon, por supuesto. Pero puedes ver que tan bien va eso, algunos días.",shape=box,color=blue];
		1164 -> 1129;
	1166 [label="Luego trato de empujarme colina abajo, y yo amenazaba con llenar su sotana con ortigas.",shape=box,color=blue];
		1166 -> 1169;
	1165 [label="Había apariencias que mantener, oui ? Estándares que mantener.",shape=box,color=blue];
		1165 -> 1168;
	1167 [label="Bueno. Terquedad y fuerza en la parte de arriba del cuerpo, ¡ja!",shape=box,color=blue];
		1167 -> 1170;
	1169 [label="La famille.",shape=box,color=blue];
		1169 -> 1172;
		1169 -> 1173;
		1169 -> 1174;
		1169 -> 3921;
	1168 [label="Así que, ¿Qué se tenía que hacer con la pobre mal formada de Marie? Me llevaron a la Cité de la Lumière, donde me dejaron en la calle...",shape=box,color=blue];
		1168 -> 1171;
	1170 [label="Update boolean MarieGraveyard1",color=orange];
		1170 -> 1129;
	1172 [label="Siento que Entrati haya arruinado lo que tenías.",shape=box,color=red];
		1172 -> 1177;
	1173 [label="Me alegra que se hayan tenido el uno al otro.",shape=box,color=red];
		1173 -> 1178;
	1174 [label="Ustedes dos me hacen sonreír.",shape=box,color=red];
		1174 -> 1179;
	3921 [label="Entonces tú y él... ¿nunca han tenido nada romántico?",shape=box,color=red];
		3921 -> 3922;
	1171 [label="Y abandonada para morir.",shape=box,color=blue];
		1171 -> 1175;
		1171 -> 1176;
	1177 [label="+10 Chemistry",color=orange];
		1177 -> 1182;
	1178 [label="+20 Chemistry",color=orange];
		1178 -> 1183;
	1179 [label="+20 Chemistry",color=orange];
		1179 -> 1184;
	3922 [label="¡Por Sol! ¡No! Es como un hermano para mí en todo, excepto en la sangre. ¡Me siento complètement dégoûtée con solo pensarlo!",shape=box,color=blue];
		3922 -> 3923;
		3922 -> 3924;
	1175 [label="¿Tu familia te dio por muerta?",shape=box,color=red];
		1175 -> 1180;
	1176 [label="¿Qué edad tenías?",shape=box,color=red];
		1176 -> 1181;
	1182 [label="Entrari no arruino nada. Lyon y yo somos tan fuertes como siempre lo hemos sido. Simplemente las cosas cambian, non ?",shape=box,color=blue];
		1182 -> 1186;
	1183 [label="No estaría en ningún lado. Excepto, tal vez, cuesta abajo ¡Ja!",shape=box,color=blue];
		1183 -> 1187;
	1184 [label="Me hace reír de maneras extrañas. Pero me doy cuenta de que tu también, lobo. Me siento cada vez más feliz de estar aquí.",shape=box,color=blue];
		1184 -> 1188;
	3923 [label="Solo tenía curiosidad.",shape=box,color=red];
		3923 -> 3925;
	3924 [label="Admito que me alivia un poco.",shape=box,color=red];
		3924 -> 3931;
	1180 [label="Ellos sentían que habían hecho todo lo posible por curarme durante muchos años. Tutores para enseñarme a caminar. Aparatos ortopédicos. Calzado.",shape=box,color=blue];
		1180 -> 1185;
	1181 [label="¿Seis? ¿Siete? Ellos sentían que habían hecho todo lo posible por curarme durante muchos años. Tutores para enseñarme a caminar. Aparatos ortopédicos. Calzado.",shape=box,color=blue];
		1181 -> 1185;
	1186 [label="Lua está en constante evolución. Incluso Sol, a pesar de su constante presencia, se ve influenciado por sus órbitas.",shape=box,color=blue];
		1186 -> 1191;
	1187 [label="Él realmente es mi hermano del alma. Me siento cada vez más feliz de estar aquí.",shape=box,color=blue];
		1187 -> 1188;
	1188 [label="Solo espero que pronto descubra lo mismo... pero el diablo lo persigue con sus susurros y mentiras.",shape=box,color=blue];
		1188 -> 1192;
	3925 [label="+10 Chemistry",color=orange];
		3925 -> 3926;
	3931 [label="Check boolean DrifterMarie",color=orange];
		3931 -> 3932 [label=true,color=green];
		3931 -> 3933 [label=false,color=brown];
	1185 [label="Estaban hartos de la carga. Así que, cuando apenas era capaz de leer y escribir números y letras, me encontré en la inmundicia.",shape=box,color=blue];
		1185 -> 1189;
		1185 -> 1190;
	1191 [label="No debemos ser rígidos en nuestras costumbres, o nos destrozarán, lobo. Además, me siento cada vez más feliz de estar aquí.",shape=box,color=blue];
		1191 -> 1188;
	1192 [label="¡Ja! Hablo sobre él y me llama. Debo irme.",shape=box,color=blue];
		1192 -> 1194;
	3926 [label="Check boolean DrifterMarie",color=orange];
		3926 -> 3927 [label=true,color=green];
		3926 -> 3928 [label=false,color=brown];
	3932 [label="Oui, has manifestado tus intenciones. Debo advertirte que no lo abandonaré. Conozco a Lyon desde hace mucho más tiempo que a ti.",shape=box,color=blue];
		3932 -> 3928;
	3933 [label="Oui ? ¿Y a cuál de nosotros... cazas?",shape=box,color=blue];
		3933 -> 3934;
		3933 -> 3935;
	1189 [label="¿Cómo sobreviviste?",shape=box,color=red];
		1189 -> 1193;
	1190 [label="Eso es horrible.",shape=box,color=red];
		1190 -> 1193;
	1194 [label="Chat ends.",color=orange];
	3927 [label="Oui. Simple \"curiosidad\". No me engañas. Debo advertirte que no lo abandonaré. Conozco a Lyon desde hace mucho más tiempo que a ti.",shape=box,color=blue];
		3927 -> 3928;
	3928 [label="+20 Chemistry",color=orange];
		3928 -> 3929;
	3934 [label="A ti.",shape=box,color=red];
		3934 -> 3936;
	3935 [label="Lyon.",shape=box,color=red];
		3935 -> 3941;
	1193 [label="Check boolean MarieSecretPower",color=orange];
		1193 -> 1196 [label=true,color=green];
		1193 -> 1195 [label=false,color=brown];
	3929 [label="No estaría en ningún lado. Excepto, tal vez, cuesta abajo ¡Ja!",shape=box,color=blue];
		3929 -> 3930;
	3936 [label="Update boolean DrifterMarie",color=orange];
		3936 -> 3937;
	3941 [label="Vraiment ?!",shape=box,color=blue];
		3941 -> 3942;
	1196 [label="Fue como dijiste, non? Todos los inconvenientes traen consigo un poder secreto.",shape=box,color=blue];
		1196 -> 1195;
	1195 [label="Lo que me hizo une indeseable pour ma mère, me hizo bastante popular entre los demás niños de la calle.",shape=box,color=blue];
		1195 -> 1197;
	3930 [label="Aun así, me intrigas, lobito. Cada vez me siento más feliz de estar aquí.",shape=box,color=blue];
		3930 -> 1188;
	3937 [label="+10 Chemistry",color=orange];
		3937 -> 3938;
	3942 [label="+10 Chemistry",color=orange];
		3942 -> 3943;
	1197 [label="¿Qué es más pathétique que un niño sin pieds, oui ? Podría ganar más en un día mendigando de lo que ellos podrían robar en una semana.",shape=box,color=blue];
		1197 -> 1198;
	3938 [label="¡Oh! Por Sol. Me tomas por sorpresa, debo admitirlo. Y ahora estoy aquí sentada, ruborizada, escondiendo mi cara de Monsieur Loid...",shape=box,color=blue];
		3938 -> 3939;
	3943 [label="No sabes lo feliz que me hace esto, pero por favor, piensa en lo que dices.",shape=box,color=blue];
		3943 -> 3944;
	1198 [label="Fue esto lo que llevó a que una de les Sœurs de Sol me encontrara en la calle. Me ofrecieron acogerme.",shape=box,color=blue];
		1198 -> 1199;
		1198 -> 1200;
	3939 [label="Debo advertirte que no lo abandonaré. Conozco a Lyon desde hace mucho más tiempo que a ti.",shape=box,color=blue];
		3939 -> 3940;
	3944 [label="Update boolean DrifterLyon",color=orange];
		3944 -> 3945;
	1199 [label="¿Qué pasó con los otros niños?",shape=box,color=red];
		1199 -> 1201;
	1200 [label="Obviamente dijiste que sí.",shape=box,color=red];
		1200 -> 1202;
	3940 [label="+10 Chemistry",color=orange];
		3940 -> 1188;
	3945 [label="Lyon es mi hermano. Lo quiero más de lo que imaginas, pero es un hombre atormentado. Piensa bien tus palabras antes de cortejarlo, n'est-ce pas ?",shape=box,color=blue];
		3945 -> 3946;
	1201 [label="+5 Chemistry",color=orange];
		1201 -> 1203;
	1202 [label="Oui, ¿qué podría hacer? Era solo cuestión de tiempo antes de que me enfermara. Lo sabía aún siendo un enfant.",shape=box,color=blue];
		1202 -> 1204;
		1202 -> 1205;
	3946 [label="Creo que volveremos a hablar de esto pronto. No me malinterpretes, ¡los estoy animando! Simplemente quiero que lo pienses bien.",shape=box,color=blue];
		3946 -> 3940;
	1203 [label="Tienes un corazón muy bondadoso. Obviamente, no podían acoger a todos... pero no olvidé a mis amigos.",shape=box,color=blue];
		1203 -> 1206;
	1204 [label="¿Cómo eran las hermanas?",shape=box,color=red];
		1204 -> 1207;
	1205 [label="¿Cómo te adaptaste a tu vida en la catedral?",shape=box,color=red];
		1205 -> 1208;
	1206 [label="Regresaba cada semana con mi salario, y cualquier resto que pudiera juntar de la cocina o de otros.",shape=box,color=blue];
		1206 -> 1209;
	1207 [label="¡Les Sœurs fueron tan amables conmigo! Pero sé por qué has de pensar lo contrario, non ?",shape=box,color=blue];
		1207 -> 1210;
	1208 [label="¡Cuánto me encantó! Pero sé por qué has de pensar lo contrario, non ?",shape=box,color=blue];
		1208 -> 1210;
	1209 [label="Los cuidé lo mejor que pude, mientras mis amigos estuvieran allí. Muchos murieron de variole ou tuberculose...",shape=box,color=blue];
		1209 -> 1211;
	1210 [label="Tres comidas, una cama caliente, un techo sobre mi cabeza. No me necesitaba preocupar de que me golpearan, robaran o algo peor.",shape=box,color=blue];
		1210 -> 1212;
	1211 [label="Muchos se mudaron, algunos murieron peleando o en la violencia. Muchos encontraron un trabajo honesto y crecieron. Criaron a su propia famille.",shape=box,color=blue];
		1211 -> 1213;
	1212 [label="Recibí una buena educación. Me enseñaron los evangelios de Sol y Lua. Me dijeron que encontrara el camino a mi fe. Pude haberme ido, si eso hubiera querido.",shape=box,color=blue];
		1212 -> 1214;
	1213 [label="Algunos incluso pasaban por la Cathédrale para verme. Eso me alegraba el corazón.",shape=box,color=blue];
		1213 -> 1214;
	1214 [label="Me sentí culpable por mucho tiempo de que yo pude salir de las calles cuando otros no. Algunos días aún lo siento.",shape=box,color=blue];
		1214 -> 1215;
		1214 -> 1216;
	1215 [label="Cuando me acuerdo de todos los que han muerto a mi alrededor, cuando soy yo quien sobrevivió. Siento lo mismo. Pero no podemos hacernos eso a nosotros mismos. Tenemos que seguir peleando para mejorar las cosas cuando podamos.",shape=box,color=red];
		1215 -> 1217;
	1216 [label="Hiciste lo mejor que pudiste para ayudar a otros con lo que te fue dado. Algunos otros te ayudaron a levantarte, y tu intentas ayudar a otros a levantarse ahora que se te ha dado la oportunidad.",shape=box,color=red];
		1216 -> 1218;
	1217 [label="¿Es que esto será así por siempre? ¿Una pelea? ¿Una guerra en contra de la marea que busca ahogarnos?",shape=box,color=blue];
		1217 -> 1219;
	1218 [label="Add 1 to Thermostat",color=orange];
		1218 -> 1220;
	1219 [label="Add -1 to Thermostat",color=orange];
		1219 -> 1221;
	1220 [label="+10 Chemistry",color=orange];
		1220 -> 1222;
	1221 [label="+10 Chemistry",color=orange];
		1221 -> 1223;
	1222 [label="Oui, eso es precisamente. Me han rescatado subiéndome a la balsa, y ahora debo hacer lo mismo por los otros. ",shape=box,color=blue];
		1222 -> 1224;
	1223 [label="Pero sé a qué te refieres. Escencialmente lo que dices es que no me rinda. Que he recibido estos dones para ser un escudo y ayudar a los demás.",shape=box,color=blue];
		1223 -> 1224;
	1224 [label="Merci. Pero por ahora debo irme.",shape=box,color=blue];
		1224 -> 1225;
	1225 [label="Chat ends.",color=orange];
}