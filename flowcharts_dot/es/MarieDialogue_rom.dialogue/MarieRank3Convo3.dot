digraph {
	graph [fontname="Roboto Condensed"];
	node [fontname="Roboto Condensed"];
	edge [fontname="Roboto Condensed"];

	"MarieRank3Convo3 begins." [color=orange];
		"MarieRank3Convo3 begins." -> j336195646;
	j336195646 [label="Boolean MarieLyonAvailable is now true.",color=orange];
		j336195646 -> j971302504;
	j971302504 [label="Check boolean MarieGraveyard1",color=orange];
		j971302504 -> j145771084 [label=true,color=green];
		j971302504 -> j1555809799 [label=true,color=green];
		j971302504 -> j202800200 [label=true,color=green];
		j971302504 -> j3894757185 [label=false,color=brown];
		j971302504 -> j1555809799 [label=false,color=brown];
		j971302504 -> j202800200 [label=false,color=brown];
	j145771084 [label="¿Podrías contarme más sobre como era vivir en la catedral? ¿Antes de que llegara Entrati?",shape=box,color=red];
		j145771084 -> j1956666410;
	j1555809799 [label="¿En dónde creciste Marie?",shape=box,color=red];
		j1555809799 -> j2464373891;
	j202800200 [label="[Fin]",shape=box,color=red];
		j202800200 -> "Chat ends.";
	j3894757185 [label="¿Cómo era tu vida en la catedral antes de que apareciera Entrati?",shape=box,color=red];
		j3894757185 -> j46326512;
	j1956666410 [label="La verdad es que era algo solitario, supongo. Tenía a Lyon, pero ya sabes como puede ser a veces. (¡Oh! ¡Me alegra tanto que tú y él ya se hablen!)",shape=box,color=blue];
		j1956666410 -> j2949465944;
	j2464373891 [label="Boolean MarieBackstory1 is now true.",color=orange];
		j2464373891 -> j1484530546;
	"Chat ends." [color=orange];
	j46326512 [label="Oh, no sé si eso te podría interesar tanto, pero te diré de todos modos si es que tienes tanta curiosidad. ",shape=box,color=blue];
		j46326512 -> j1587978321;
	j2949465944 [label="Boolean MarieGraveyard2 is now true.",color=orange];
		j2949465944 -> j1070957624;
	j1484530546 [label="Habría pensado que mi idioma te hubiera dado una pista, pero entonces recordé que tú no eres del mundo que yo conocí, ja !",shape=box,color=blue];
		j1484530546 -> j762289543;
	j1587978321 [label="La viví haciendo mis tareas como hermana del Sol. Puliendo los utensilios de comunión, preparando las ofrendas votivas para los feligreses. ",shape=box,color=blue];
		j1587978321 -> j890958693;
	j1070957624 [label="Pero no es por eso que pasé tanto tiempo hablando con los muertos.",shape=box,color=blue];
		j1070957624 -> j1579989516;
	j762289543 [label="Soy de la Cité de la Lumière, la capital de un país llamado Gaule. En el gran esquema mundial, no está muy lejos de Höllvania en un mapa.",shape=box,color=blue];
		j762289543 -> j809128652;
	j890958693 [label="Atender la cripta y el cementerio. Eran mis tareas favoritas.",shape=box,color=blue];
		j890958693 -> j3445051731;
		j890958693 -> j1668104377;
	j1579989516 [label="Boolean MarieGraveyard2 is now true.",color=orange];
		j1579989516 -> j251028995;
	j809128652 [label="¿Me pregunto si mi Cathédrale aún exisite en 1999? ¡Qué idea tan interesante!",shape=box,color=blue];
		j809128652 -> j3469323176;
		j809128652 -> j519728444;
	j3445051731 [label="¿Por qué era tu favorito?",shape=box,color=red];
		j3445051731 -> j3627642276;
	j1668104377 [label="Lo siento. ¿Qué hay de la última parte?",shape=box,color=red];
		j1668104377 -> j4236085412;
	j251028995 [label="Hay belleza en esos lugares, una tranquillité. Son tan tranquilos. Pacíficos.",shape=box,color=blue];
		j251028995 -> j2664456049;
	j3469323176 [label="Te gusta divagar, ¿verdad?",shape=box,color=red];
		j3469323176 -> j3140077316;
	j519728444 [label="Le podría preguntar a dos de mis amigos, ellos han viajado bastante. Creo que hasta han mencionado esa ciudad.",shape=box,color=red];
		j519728444 -> j4158907336;
	j3627642276 [label="Disfrutaba bastante de hablar con aquellos que yacen descansando. Ellos escuchaban mis preocupaciones sin juzgarme.",shape=box,color=blue];
		j3627642276 -> j3856933664;
	j4236085412 [label="Era mi deber atender a los muertos de la Cathédrale. Barría el polvo del piso de la cripta, y retiraba la hierba mala del patio.",shape=box,color=blue];
		j4236085412 -> j3627642276;
	j2664456049 [label="Creo que me gusta decirles mis problemas et les activités des autres porque ya no tienen preocupaciones, oui ?",shape=box,color=blue];
		j2664456049 -> j390604065;
	j3140077316 [label="+5 Chemistry",color=orange];
		j3140077316 -> j1892360531;
	j4158907336 [label="+5 Chemistry",color=orange];
		j4158907336 -> j2157044661;
	j3856933664 [label="Bueno, no tienen nada que decir, mais cela me convenait tout à fait ! Prefiero que se queden así en silencio.",shape=box,color=blue];
		j3856933664 -> j2724839070;
	j390604065 [label="Todo se debe de ver insignificante para ellos, y eso me reconforta a mí.",shape=box,color=blue];
		j390604065 -> j3694775106;
		j390604065 -> j4171698750;
		j390604065 -> j3014346187;
	j1892360531 [label="No lo has notado, oui ? Lyon me molesta todo el tiempo diciendome que soy una mota de polvo en un rayo de sol, flotando a donde me lleve la brisa. (¡Me alegra tanto que tú y él ya se hablen!)",shape=box,color=blue];
		j1892360531 -> j102457234;
	j2157044661 [label="Oh, no los molestes, es solamente una tonta idea. No sé que tan triste estaría al pensar que ya no está.",shape=box,color=blue];
		j2157044661 -> j102457234;
	j2724839070 [label="+5 Chemistry",color=orange];
		j2724839070 -> j1081698631;
	j3694775106 [label="No sé, me da... miedo morir de verdad, nunca me ha gustado estar cerca de la muerte.",shape=box,color=red];
		j3694775106 -> j300005501;
	j4171698750 [label="Nunca lo había pensado de esa forma.",shape=box,color=red];
		j4171698750 -> j2306069228;
	j3014346187 [label="He encontrado esa misma paz al estar en los cementerios. Te entiendo completamente.",shape=box,color=red];
		j3014346187 -> j2097375608;
	j102457234 [label="Solo me da curiosidad, non ? Quiero saber tout ce qui existe, todo lo que hay, para saber. Creo que es por eso que le Cardinal y yo estábamos destinados a conocernos.",shape=box,color=blue];
		j102457234 -> j3696509838;
	j1081698631 [label="¿Te imaginas? Calaveras que hablan, ¿como tus necraloid? ¡Ja!",shape=box,color=blue];
		j1081698631 -> j3568686241;
		j1081698631 -> j1282467395;
	j300005501 [label="Lo sé, pequeña morbide Marie ! Es tan extraño. Pero cada quien con lo suyo, non ?",shape=box,color=blue];
		j300005501 -> j1755469116;
	j2306069228 [label="No eres el único. No nos gusta gastar mucho de nuestro tiempo, pensando en qué es lo que viene después. No hasta que lo vemos cerca.",shape=box,color=blue];
		j2306069228 -> j4001757854;
	j2097375608 [label="¡Me alegro tanto de que lo entiendas!",shape=box,color=blue];
		j2097375608 -> j4001757854;
	j3696509838 [label="Où en étais-je ? Ah ! Oui. Mi historia.",shape=box,color=blue];
		j3696509838 -> j1392929904;
	j3568686241 [label="Esa no pudo haber sido la tarea más fácil, por lo de tu silla de ruedas.",shape=box,color=red];
		j3568686241 -> j162419527;
	j1282467395 [label="¿No tenías otros amigos con quienes platicar?",shape=box,color=red];
		j1282467395 -> j4199109025;
	j1755469116 [label="Alguien debe ver por ellos. Y yo estoy más que feliz de hacerlo.",shape=box,color=blue];
		j1755469116 -> j4001757854;
	j4001757854 [label="Lyon bromea con que estoy muy cerca del suelo, es por eso que pienso tanto en la sepultura.",shape=box,color=blue];
		j4001757854 -> j2105275923;
	j1392929904 [label="Nací en una familia con dinero, lo cual puede que te sorprenda. La clase burguesa, la más cercana a los orokin que los demás.",shape=box,color=blue];
		j1392929904 -> j3608895302;
	j162419527 [label="No, no lo era. Pero Lyon me ayudó a subir y bajar las escaleras dentro de la cripta cuando era necesario, el resto yo pude lograrlo con el tiempo.",shape=box,color=blue];
		j162419527 -> j3900170412;
	j4199109025 [label="Boolean MarieGraveyard1 is now true.",color=orange];
		j4199109025 -> j515224104;
	j2105275923 [label=" Le pregunté si su cabeza estaba vacía, que si por eso está llena de fantasmas.",shape=box,color=blue];
		j2105275923 -> j3810890334;
	j3608895302 [label="Pero cuando nací como si fuera... deforme, con mes pieds tordus et inutilisables ? Oh, ma mère no podía permitirlo.",shape=box,color=blue];
		j3608895302 -> j1914413736;
	j3900170412 [label="Es impresionante lo que se puede hacer cuando uno es terco, oui ?",shape=box,color=blue];
		j3900170412 -> j2090900392;
	j515224104 [label="Tenía a Lyon, por supuesto. Pero puedes ver que tan bien va eso, algunos días.",shape=box,color=blue];
		j515224104 -> j1579989516;
	j3810890334 [label="Luego trato de empujarme colina abajo, y yo amenazaba con llenar su sotana con ortigas.",shape=box,color=blue];
		j3810890334 -> j1118776134;
	j1914413736 [label="Había apariencias que mantener, oui ? Estándares que mantener.",shape=box,color=blue];
		j1914413736 -> j2086441149;
	j2090900392 [label="Bueno. Terquedad y fuerza en la parte de arriba del cuerpo, ¡ja!",shape=box,color=blue];
		j2090900392 -> j143929881;
	j1118776134 [label="La famille.",shape=box,color=blue];
		j1118776134 -> j3367664385;
		j1118776134 -> j1174386419;
		j1118776134 -> j987131075;
		j1118776134 -> j57668002;
	j2086441149 [label="Así que, ¿qué más se podía hacer con la pobre y deforme Marie? Me llevaron a la Cité de la Lumière, donde seguramente moriría en la calle...",shape=box,color=blue];
		j2086441149 -> j3568777528;
	j143929881 [label="Boolean MarieGraveyard1 is now true.",color=orange];
		j143929881 -> j1579989516;
	j3367664385 [label="Siento que Entrati haya arruinado lo que tenías.",shape=box,color=red];
		j3367664385 -> j482685801;
	j1174386419 [label="Me alegra que se hayan tenido el uno al otro.",shape=box,color=red];
		j1174386419 -> j1671108212;
	j987131075 [label="Ustedes dos me hacen sonreír.",shape=box,color=red];
		j987131075 -> j1305196608;
	j57668002 [label="Entonces tú y él... ¿nunca han tenido nada romántico?",shape=box,color=red];
		j57668002 -> j210814180;
	j3568777528 [label="Y abandonada para morir.",shape=box,color=blue];
		j3568777528 -> j2117766904;
		j3568777528 -> j2171516377;
	j482685801 [label="+10 Chemistry",color=orange];
		j482685801 -> j1050390980;
	j1671108212 [label="+20 Chemistry",color=orange];
		j1671108212 -> j4104713860;
	j1305196608 [label="+20 Chemistry",color=orange];
		j1305196608 -> j3419881413;
	j210814180 [label="¡Por Sol! ¡No! Es como un hermano para mí en todo, excepto en la sangre. ¡Me siento complètement dégoûtée con solo pensarlo!",shape=box,color=blue];
		j210814180 -> j1337869438;
		j210814180 -> j3905462783;
	j2117766904 [label="¿Tu familia te dio por muerta?",shape=box,color=red];
		j2117766904 -> j1674657819;
	j2171516377 [label="¿Qué edad tenías?",shape=box,color=red];
		j2171516377 -> j1726977715;
	j1050390980 [label="Entrari no arruino nada. Lyon y yo somos tan fuertes como siempre lo hemos sido. Simplemente las cosas cambian, non ?",shape=box,color=blue];
		j1050390980 -> j4280471610;
	j4104713860 [label="No estaría en ningún lado. Excepto, tal vez, cuesta abajo ¡Ja!",shape=box,color=blue];
		j4104713860 -> j859260985;
	j3419881413 [label="Me hace reír de maneras extrañas. Pero me doy cuenta de que tu también, lobo. Me siento cada vez más feliz de estar aquí.",shape=box,color=blue];
		j3419881413 -> j2822250194;
	j1337869438 [label="Solo tenía curiosidad.",shape=box,color=red];
		j1337869438 -> j3385888755;
	j3905462783 [label="Admito que me alivia un poco.",shape=box,color=red];
		j3905462783 -> j1335227973;
	j1674657819 [label="Ellos sentían que habían hecho todo lo posible por curarme durante muchos años. Tutores para enseñarme a caminar. Aparatos ortopédicos. Calzado.",shape=box,color=blue];
		j1674657819 -> j239405841;
	j1726977715 [label="¿Seis? ¿Siete? Ellos sentían que habían hecho todo lo posible por curarme durante muchos años. Tutores para enseñarme a caminar. Aparatos ortopédicos. Calzado.",shape=box,color=blue];
		j1726977715 -> j239405841;
	j4280471610 [label="Lua está en constante evolución. Incluso Sol, a pesar de su constante presencia, se ve influenciado por sus órbitas.",shape=box,color=blue];
		j4280471610 -> j1190190995;
	j859260985 [label="Él realmente es mi hermano del alma. Me siento cada vez más feliz de estar aquí.",shape=box,color=blue];
		j859260985 -> j2822250194;
	j2822250194 [label="Solo espero que pronto descubra lo mismo... pero el diablo lo persigue con sus susurros y mentiras.",shape=box,color=blue];
		j2822250194 -> j524205500;
	j3385888755 [label="+10 Chemistry",color=orange];
		j3385888755 -> j1930259134;
	j1335227973 [label="Check boolean DrifterMarie",color=orange];
		j1335227973 -> j1022092762 [label=true,color=green];
		j1335227973 -> j760594120 [label=false,color=brown];
	j239405841 [label="Estaban hartos de la carga. Así que, cuando apenas era capaz de leer y escribir números y letras, me encontré en la inmundicia.",shape=box,color=blue];
		j239405841 -> j2476590075;
		j239405841 -> j42619915;
	j1190190995 [label="No debemos ser rígidos en nuestras costumbres, o nos destrozarán, lobo. Además, me siento cada vez más feliz de estar aquí.",shape=box,color=blue];
		j1190190995 -> j2822250194;
	j524205500 [label="¡Ja! Hablo sobre él y me llama. Debo irme.",shape=box,color=blue];
		j524205500 -> "Chat ends.";
	j1930259134 [label="Check boolean DrifterMarie",color=orange];
		j1930259134 -> j751985097 [label=true,color=green];
		j1930259134 -> j2381767197 [label=false,color=brown];
	j1022092762 [label="Oui, has manifestado tus intenciones. Debo advertirte que no lo abandonaré. Conozco a Lyon desde hace mucho más tiempo que a ti.",shape=box,color=blue];
		j1022092762 -> j2381767197;
	j760594120 [label="Oui ? ¿Y a cuál de nosotros... cazas?",shape=box,color=blue];
		j760594120 -> j148136397;
		j760594120 -> j1513776458;
	j2476590075 [label="¿Cómo sobreviviste?",shape=box,color=red];
		j2476590075 -> j251854413;
	j42619915 [label="Eso es horrible.",shape=box,color=red];
		j42619915 -> j251854413;
	j751985097 [label="Oui. Simple \"curiosidad\". No me engañas. Debo advertirte que no lo abandonaré. Conozco a Lyon desde hace mucho más tiempo que a ti.",shape=box,color=blue];
		j751985097 -> j2381767197;
	j2381767197 [label="+20 Chemistry",color=orange];
		j2381767197 -> j3825521336;
	j148136397 [label="A ti.",shape=box,color=red];
		j148136397 -> j970935623;
	j1513776458 [label="Lyon.",shape=box,color=red];
		j1513776458 -> j1484890516;
	j251854413 [label="Check boolean MarieSecretPower",color=orange];
		j251854413 -> j3908370509 [label=true,color=green];
		j251854413 -> j2195142086 [label=false,color=brown];
	j3825521336 [label="No estaría en ningún lado. Excepto, tal vez, cuesta abajo ¡Ja!",shape=box,color=blue];
		j3825521336 -> j654958289;
	j970935623 [label="Boolean DrifterMarie is now true.",color=orange];
		j970935623 -> j2203793559;
	j1484890516 [label="Vraiment ?!",shape=box,color=blue];
		j1484890516 -> j2505259350;
	j3908370509 [label="Fue como dijiste, non? Todos los inconvenientes traen consigo un poder secreto.",shape=box,color=blue];
		j3908370509 -> j2195142086;
	j2195142086 [label="Lo que me hizo une indeseable pour ma mère, me hizo bastante popular entre los demás niños de la calle.",shape=box,color=blue];
		j2195142086 -> j2759755000;
	j654958289 [label="Aun así, me intrigas, lobito. Cada vez me siento más feliz de estar aquí.",shape=box,color=blue];
		j654958289 -> j2822250194;
	j2203793559 [label="+10 Chemistry",color=orange];
		j2203793559 -> j2855527753;
	j2505259350 [label="+10 Chemistry",color=orange];
		j2505259350 -> j3159707039;
	j2759755000 [label="¿Qué es más pathétique que un niño sin pieds, oui ? Podría ganar más en un día mendigando de lo que ellos podrían robar en una semana.",shape=box,color=blue];
		j2759755000 -> j1891334258;
	j2855527753 [label="¡Oh! Por Sol. Me tomas por sorpresa, debo admitirlo. Y ahora estoy aquí sentada, ruborizada, escondiendo mi cara de Monsieur Loid...",shape=box,color=blue];
		j2855527753 -> j959610642;
	j3159707039 [label="No sabes lo feliz que me hace esto, pero por favor, piensa en lo que dices.",shape=box,color=blue];
		j3159707039 -> j3554074858;
	j1891334258 [label="Fue esto lo que llevó a que una de les Sœurs de Sol me encontrara en la calle. Me ofrecieron acogerme.",shape=box,color=blue];
		j1891334258 -> j3871805191;
		j1891334258 -> j2549392426;
	j959610642 [label="Debo advertirte que no lo abandonaré. Conozco a Lyon desde hace mucho más tiempo que a ti.",shape=box,color=blue];
		j959610642 -> j3577075966;
	j3554074858 [label="Boolean DrifterLyon is now true.",color=orange];
		j3554074858 -> j1156967940;
	j3871805191 [label="¿Qué pasó con los otros niños?",shape=box,color=red];
		j3871805191 -> j814297194;
	j2549392426 [label="Obviamente dijiste que sí.",shape=box,color=red];
		j2549392426 -> j3003973695;
	j3577075966 [label="+10 Chemistry",color=orange];
		j3577075966 -> j2822250194;
	j1156967940 [label="Lyon es mi hermano. Lo quiero más de lo que imaginas, pero es un hombre atormentado. Piensa bien tus palabras antes de cortejarlo, n'est-ce pas ?",shape=box,color=blue];
		j1156967940 -> j3121949913;
	j814297194 [label="+5 Chemistry",color=orange];
		j814297194 -> j3905345910;
	j3003973695 [label="Oui, ¿qué podría hacer? Era solo cuestión de tiempo antes de que me enfermara. Lo sabía aún siendo un enfant.",shape=box,color=blue];
		j3003973695 -> j2054395209;
		j3003973695 -> j3467359467;
	j3121949913 [label="Creo que volveremos a hablar de esto pronto. No me malinterpretes, ¡los estoy animando! Simplemente quiero que lo pienses bien.",shape=box,color=blue];
		j3121949913 -> j3577075966;
	j3905345910 [label="Tienes un corazón muy bondadoso. Obviamente, no podían acoger a todos... pero no olvidé a mis amigos.",shape=box,color=blue];
		j3905345910 -> j3759876989;
	j2054395209 [label="¿Cómo eran las hermanas?",shape=box,color=red];
		j2054395209 -> j1672392123;
	j3467359467 [label="¿Cómo te adaptaste a tu vida en la catedral?",shape=box,color=red];
		j3467359467 -> j1550447008;
	j3759876989 [label="Regresaba cada semana con mi salario, y cualquier resto que pudiera juntar de la cocina o de otros.",shape=box,color=blue];
		j3759876989 -> j15831328;
	j1672392123 [label="¡Les Sœurs fueron tan amables conmigo! Pero sé por qué has de pensar lo contrario, non ?",shape=box,color=blue];
		j1672392123 -> j2614864024;
	j1550447008 [label="¡Cuánto me encantó! Pero sé por qué has de pensar lo contrario, non ?",shape=box,color=blue];
		j1550447008 -> j2614864024;
	j15831328 [label="Los cuidé lo mejor que pude, mientras mis amigos estuvieran allí. Muchos murieron de variole ou tuberculose...",shape=box,color=blue];
		j15831328 -> j1049880142;
	j2614864024 [label="Tres comidas, una cama caliente, un techo sobre mi cabeza. No me necesitaba preocupar de que me golpearan, robaran o algo peor.",shape=box,color=blue];
		j2614864024 -> j3986971565;
	j1049880142 [label="Muchos se mudaron, algunos murieron peleando o por la violencia. Muchos encontraron un trabajo honesto y crecieron. Criaron a sus propias familles.",shape=box,color=blue];
		j1049880142 -> j867812015;
	j3986971565 [label="Recibí una buena educación. Me enseñaron los evangelios de Sol y Lua. Me dijeron que encontrara el camino a mi fe. Pude haberme ido, si eso hubiera querido.",shape=box,color=blue];
		j3986971565 -> j953566095;
	j867812015 [label="Algunos incluso pasaban por la Cathédrale para verme. Eso me alegraba el corazón.",shape=box,color=blue];
		j867812015 -> j953566095;
	j953566095 [label="Me sentí culpable por mucho tiempo de que yo pude salir de las calles cuando otros no. Algunos días aún lo siento.",shape=box,color=blue];
		j953566095 -> j1988826040;
		j953566095 -> j2259372921;
	j1988826040 [label="Cuando me acuerdo de todos los que han muerto a mi alrededor, cuando soy yo quien sobrevivió. Siento lo mismo. Pero no podemos hacernos eso a nosotros mismos. Tenemos que seguir peleando para mejorar las cosas cuando podamos.",shape=box,color=red];
		j1988826040 -> j2505264849;
	j2259372921 [label="Hiciste lo mejor que pudiste para ayudar a otros con lo que te fue dado. Algunos otros te ayudaron a levantarte, y tu intentas ayudar a otros a levantarse ahora que se te ha dado la oportunidad.",shape=box,color=red];
		j2259372921 -> j1342710507;
	j2505264849 [label="¿Es que esto será así por siempre? ¿Una pelea? ¿Una guerra en contra de la marea que busca ahogarnos?",shape=box,color=blue];
