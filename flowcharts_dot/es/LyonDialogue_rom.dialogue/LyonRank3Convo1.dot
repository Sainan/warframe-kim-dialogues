	"LyonRank3Convo1 begins." [color=orange];
		"LyonRank3Convo1 begins." -> j3425226104;
	j3425226104 [label="Saludos, Viajero.",shape=box,color=blue];
		j3425226104 -> j2675761844;
	j2675761844 [label="Me he enterado de que deseas hablar conmigo.",shape=box,color=blue];
		j2675761844 -> j3766707124;
		j2675761844 -> j2349824148;
		j2675761844 -> j3640000037;
	j3766707124 [label="Es un placer hablar contigo aquí, Lyon, gracias.",shape=box,color=red];
		j3766707124 -> j582706729;
	j2349824148 [label="¿Marie finalmente te convenció de que yo no iba a ser una amenaza?",shape=box,color=red];
		j2349824148 -> j3849541642;
	j3640000037 [label="¡Oh! Hola, Lyon. Sinceramente, no creí que te convencería. Me alegra que hayas cambiado de opinión.",shape=box,color=red];
		j3640000037 -> j4144878911;
	j582706729 [label="Puede que al final te arrepientas de haber tenido tantas ganas de hacerlo, pero bueno. De nada.",shape=box,color=blue];
		j582706729 -> j812823033;
		j582706729 -> j3054426431;
	j3849541642 [label="No me inspires a encontrar tan rápidamente razones para cambiar de rumbo.",shape=box,color=blue];
		j3849541642 -> j1933300832;
	j4144878911 [label="Sí, bueno. Puede que al final no te alegres tanto.",shape=box,color=blue];
		j4144878911 -> j812823033;
		j4144878911 -> j3054426431;
	j812823033 [label="Por lo que he oído de los demás, tienes asuntos que deberíamos diiscutir. ¿Puedo ayudarte en algo?",shape=box,color=red];
		j812823033 -> j3140423491;
	j3054426431 [label="¿Pasa algo malo?",shape=box,color=red];
		j3054426431 -> j32766786;
	j1933300832 [label="+10 Chemistry",color=orange];
		j1933300832 -> "Chat ends.";
	j3140423491 [label="Tal vez con el tiempo. Pero apenas hemos comenzado nuestra conversación. Simplemente he venido a... decirte que he cedido a la insistencia de Marie de que podemos confiar en ti en lo que respecta a la conversación.",shape=box,color=blue];
		j3140423491 -> j2777944732;
	j32766786 [label="Qué pregunta tan ridículamente insuficiente, que ni siquiera intentaré responder, pues apenas hemos comenzado nuestra conversación. Simplemente he venido aquí a... decirte que he cedido a la insistencia de Marie de que podemos confiar en ti en lo que respecta a la conversación.",shape=box,color=blue];
		j32766786 -> j2777944732;
	"Chat ends." [color=orange];
	j2777944732 [label="Evaluate expressions on HellKeyPlayed counter",color=orange];
		j2777944732 -> j1135655414 [label="x > 0",color=purple];
		j2777944732 -> j3231015361 [label="x <= 0",color=purple];
		j2777944732 -> j3231015361 [label="false",color=purple];
	j1135655414 [label="Y ya que ahora colaboramos en este esfuerzo que Roathe está empeñado en llevar a cabo, parece prudente que nos conozcamos mejor. Este parece ser el medio que prefieres para hacerlo. Por lo tanto, aquí estoy.",shape=box,color=blue];
		j1135655414 -> j2131412550;
		j1135655414 -> j187303094;
	j3231015361 [label="Y dado que quizá no terminemos colaborando para siempre en este esfuerzo que Roathe está empeñado en llevar a cabo, parece prudente que nos conozcamos mejor. Este parece ser el medio que prefieres. Por lo tanto, aquí estoy.",shape=box,color=blue];
		j3231015361 -> j2131412550;
		j3231015361 -> j187303094;
	j2131412550 [label="De alguna manera siento que ya he empezado esto todo mal.",shape=box,color=red];
		j2131412550 -> j4142354695;
	j187303094 [label="¿Hay... otra manera que prefieras?",shape=box,color=red];
		j187303094 -> j801375899;
	j4142354695 [label="No. No lo has hecho. Simplemente, es probable que no sea el tipo de persona con la que sueles conversar. Por eso, has tenido suerte hasta ahora, aunque los locos como yo son difíciles de encontrar.",shape=box,color=blue];
		j4142354695 -> j3041934208;
	j801375899 [label="No. Esto es aceptable. De hecho, me permite disponer del tiempo necesario para ordenar mis ideas como quiero. Entiendo por qué este dispositivo resulta atractivo.",shape=box,color=blue];
		j801375899 -> j2572282676;
	j3041934208 [label="Me desvío del tema. Me temo que no vine aquí para pasar mucho tiempo \"escribiendo\", lo cual sin duda te decepcionará. Simplemente quería informarte de mi rendición.",shape=box,color=blue];
		j3041934208 -> j3410614185;
		j3041934208 -> j1473612857;
	j2572282676 [label="Sin embargo, me temo que no vine aquí para pasar mucho tiempo \"escribiendo\", lo cual sin duda te decepcionará. Simplemente deseaba informarte de mi rendición.",shape=box,color=blue];
		j2572282676 -> j1473612857;
		j2572282676 -> j3410614185;
	j3410614185 [label="Marie es más peligrosa de lo que parece, ¿verdad?",shape=box,color=red];
		j3410614185 -> j69307339;
	j1473612857 [label="Una vez más, simplemente diré gracias.",shape=box,color=red];
		j1473612857 -> j3650035048;
	j69307339 [label="+20 Chemistry",color=orange];
		j69307339 -> j2198832041;
	j3650035048 [label="+15 Chemistry",color=orange];
		j3650035048 -> j2391665155;
	j2198832041 [label="Apenas te imaginas la profundidad de esas aguas.",shape=box,color=blue];
		j2198832041 -> j2084492712;
	j2391665155 [label="Y... si sirve de algo, un placer.",shape=box,color=blue];
		j2391665155 -> j2084492712;
	j2084492712 [label="Padre Lyon Allard",shape=box,color=blue];
		j2084492712 -> "Chat ends.";
}