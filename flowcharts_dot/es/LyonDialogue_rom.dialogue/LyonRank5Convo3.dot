		j410090499 -> j2087737306 [label="LyonRell2a",color=purple];
		j410090499 -> j2087737306 [label="LyonRell2b",color=purple];
		j410090499 -> j2087737306 [label="LyonRell1",color=purple];
		j410090499 -> "Chat ends." [label="false",color=purple];
	j4243954261 [label="Esto no me enorgullece, pero me he tomado una botella entera de vino y ahora estoy listo para decirte el resto de lo que he intentado desesperadamente no decir, mon miracle...",shape=box,color=blue];
		j4243954261 -> j310717096;
	j2087737306 [label="Esto no me enorgullece, pero me he tomado una botella entera de vino y ahora estoy listo para decirte el resto de lo que he intentado desesperadamente no decir...",shape=box,color=blue];
		j2087737306 -> j310717096;
	"Chat ends." [color=orange];
	j310717096 [label="Si lo que había en esa botella era efectivamente vino, porque la etiqueta no es clara... y M. Loid no estaba del todo seguro de que lo que teníamos en mi época y lo que él llama vino fueran la misma cosa.",shape=box,color=blue];
		j310717096 -> j280577159;
	j280577159 [label="En mi defensa, no tenía planeado beberme toda la botella... pero estaba intentando discernir si en realidad era la misma sustancia y se acabó...",shape=box,color=blue];
		j280577159 -> j3176808810;
		j280577159 -> j1331296121;
		j280577159 -> j3488717750;
	j3176808810 [label="No, esto no está bien.",shape=box,color=red];
		j3176808810 -> j3798804706;
	j1331296121 [label="¿Sabe igual?",shape=box,color=red];
		j1331296121 -> j2035640039;
	j3488717750 [label="¿Estás borracho?",shape=box,color=red];
		j3488717750 -> j365606843;
	j3798804706 [label="Ojalá pudiera escapar tan fácilmente. No te culpo.",shape=box,color=blue];
		j3798804706 -> j3856020424;
	j2035640039 [label="¡No lo sé! ¡Esa fue la parte más frustrante de todo! Pero ese no es el punto. El objetivo era embriagarme. Y ni siquiera sé si lo estoy. Pero, ciertamente no estoy sobrio...",shape=box,color=blue];
		j2035640039 -> j3418831460;
	j365606843 [label="Potencialmente. Ciertamente no soy lo que considerarían sobrio, de ninguna manera.",shape=box,color=blue];
		j365606843 -> j1390517423;
	j3856020424 [label="Boolean LyonConfessionFail is now true.",color=orange];
		j3856020424 -> "Chat ends.";
	j3418831460 [label="Así que supongo que eso tendrá que ser suficiente.",shape=box,color=blue];
		j3418831460 -> j3884630073;
		j3418831460 -> j1399088774;
	j1390517423 [label="Lo cual era precisamente el propósito de todo este esfuerzo. Así que supongo que eso tendrá que ser suficiente.",shape=box,color=blue];
		j1390517423 -> j3884630073;
		j1390517423 -> j1399088774;
	j3884630073 [label="¿Qué es lo que es tan terrible como para que te tengas que emborrachar para decirme?",shape=box,color=red];
		j3884630073 -> j3375269506;
	j1399088774 [label="Estoy listo cuando tu lo estés...",shape=box,color=red];
		j1399088774 -> j3375269506;
	j3375269506 [label="Rap... tap... tap...",shape=box,color=blue];
		j3375269506 -> j2480766194;
		j3375269506 -> j1392679964;
	j2480766194 [label="... Oh.",shape=box,color=red];
		j2480766194 -> j3389233727;
	j1392679964 [label="Ahora lo entiendo.",shape=box,color=red];
		j1392679964 -> j3389233727;
	j3389233727 [label="Ahora sé con certeza que no estuvieron dentro de mi cabeza toda mi vida. El tenno lo conoce como Rell y su guardián Harrow. No es posible que estuvieran dentro de las paredes de la casa de mi infancia.",shape=box,color=blue];
		j3389233727 -> j505650070;
	j505650070 [label="Es imposible que resonaran dentro de mi cabeza con los susurros confusos de esas voces en mis visiones a lo largo de todos estos años. Sin embargo las veo ahí, lo escuché ahí, en mis recuerdos.",shape=box,color=blue];
		j505650070 -> j252073137;
	j252073137 [label="Check boolean LyonTime1",color=orange];
		j252073137 -> j477263224 [label=true,color=green];
		j252073137 -> j2605043528 [label=false,color=brown];
	j477263224 [label="Entendí todo lo que dijo Entrati de como la energía podía existir en el tiempo en varios lugares al mismo tiempo en una manera filosófica. Pero no lo entendía emocionalmente hasta que... me inyecté el suero.",shape=box,color=blue];
		j477263224 -> j2969990337;
	j2605043528 [label="Es como si en el momento en el que me inyecté el suero... todo se volviera uno. Cuando Entrati se reveló así mismo y toda la verdad de su existencia... ",shape=box,color=blue];
		j2605043528 -> j3703058936;
	j2969990337 [label="A veces veo en el ojo de mi mente un gran y tranquilo lago que se extiende en todas direcciones. Negro y liso, como un espejo de ónice.",shape=box,color=blue];
		j2969990337 -> j1380531870;
	j3703058936 [label="Me expuso todo lo que sabía del \"entrelazamiento cuántico\", \"superposición\", \"eternalismo\" y otros temas.",shape=box,color=blue];
		j3703058936 -> j1800508558;
	j1380531870 [label="Un inmenso lago negro que fluye hacia el infinito. Imposible de comprender.",shape=box,color=blue];
		j1380531870 -> j1513213178;
	j1800508558 [label="Lo entendí todo en un sentido científico, en vez de uno filosófico. Pero no lo entendí de manera emocional hasta que... me inyecté el suero.",shape=box,color=blue];
		j1800508558 -> j2969990337;
	j1513213178 [label="Y ahí es donde los encontraría. Ahí es donde los conocería. Y ahí es donde sentiría a ellos también...",shape=box,color=blue];
		j1513213178 -> j4193963285;
	j4193963285 [label="¿Ellos?",shape=box,color=red];
		j4193963285 -> j2470322546;
	j2470322546 [label="Los otros Harrows... Estatuas vacías de cosas, los ecos de los ecos de los ecos... Ellos siguen y siguen por toda la eternidad en todas direcciones...",shape=box,color=blue];
		j2470322546 -> j874605368;
	j874605368 [label="Rell se metió en uno. Se perdió a sí mismo dentro de él. Y al hacerlo, se perdió en todos ellos...",shape=box,color=blue];
		j874605368 -> j1744792675;
	j1744792675 [label="Incluyéndome. Incluyendo al Harrow que estaba en el suero que me creó.",shape=box,color=blue];
		j1744792675 -> j1431695025;
		j1744792675 -> j3751263335;
	j1431695025 [label="Por el Vacío... no me di cuenta...",shape=box,color=red];
		j1431695025 -> j2387932923;
	j3751263335 [label="Oh, no...",shape=box,color=red];
		j3751263335 -> j2387932923;
	j2387932923 [label="Estaban ahí conmigo, en mi mente... Rell y su Harrow, muy parecido a mí, y aún así tan diferente.",shape=box,color=blue];
		j2387932923 -> j1595057369;
	j1595057369 [label="Él no tenía miedo. Estaba muy seguro. Dos cosas que yo no compartía.",shape=box,color=blue];
		j1595057369 -> j3674874004;
	j3674874004 [label="Se impuso rápidamente en contra de la Indiferencia, no le importó que era o que no era. Simplemente sabía que se necesitaba hacer.",shape=box,color=blue];
		j3674874004 -> j3512507291;
	j3512507291 [label="Incluso después de toda la crueldad que soportó. Por todos esos años, en el \"ahora\" y en el \"entonces\" de esa eternidad, del momento en el cual me inyecté... del \"antes\" y del \"después\", él estaba ahí.",shape=box,color=blue];
		j3512507291 -> j3186406989;
	j3186406989 [label="Era mi amigo. Era mi hermano.",shape=box,color=blue];
		j3186406989 -> j2088987845;
	j2088987845 [label="¿En el entonces? ¿En el ahora?",shape=box,color=blue];
		j2088987845 -> j2130023222;
	j2130023222 [label="Ya no puedo sentirlo.",shape=box,color=blue];
		j2130023222 -> j4058541718;
		j2130023222 -> j1834177835;
	j4058541718 [label="Él... está dormido, ahora, Lyon... está en paz.",shape=box,color=red];
		j4058541718 -> j3439076154;
	j1834177835 [label="Oh, Lyon...",shape=box,color=red];
		j1834177835 -> j588870188;
	j3439076154 [label="Lo sé. Sentí cuando se fue. Lloré. Lo extraño mucho. Sé que aún resuena... de algún modo, manera, aunque no entienda del todo cómo.",shape=box,color=blue];
		j3439076154 -> j441022526;
		j3439076154 -> j335038812;
	j588870188 [label="Lo extraño mucho. Sé que aún resuena... de algún modo, manera, aunque no entienda del todo cómo.",shape=box,color=blue];
		j588870188 -> j441022526;
		j588870188 -> j335038812;
	j441022526 [label="Rell era el más fuerte de todos nosotros. Me alegra que hayas tenido la oportunidad de conocerlo.",shape=box,color=red];
		j441022526 -> j1269207607;
	j335038812 [label="Rell fue marginado por la ignorancia y crueldad de los niños… no merecía lo que le pasó.",shape=box,color=red];
		j335038812 -> j1631213885;
	j1269207607 [label="Me alegro de haberlo conocido también. ¿En cuanto a su fuerza? Tal vez, tal vez no. Al final, él simplemente sabía que se necesitaba y fue lo suficientemente fuerte para lograrlo.",shape=box,color=blue];
		j1269207607 -> j3737609402;
	j1631213885 [label="Tal vez. Pero al final, él simplemente sabía que se necesitaba y fue lo suficientemente fuerte para lograrlo.",shape=box,color=blue];
		j1631213885 -> j3737609402;
	j3737609402 [label="En momentos como estos, creo que por lo único que podemos pedir en oración es por \"fuerza suficiente\".",shape=box,color=blue];
		j3737609402 -> j3906374408;
	j3906374408 [label="Lamentablemente, no se puede decir lo mismo de este vino... el cual estaba muy fuerte, sólo tardó en hacer efecto.",shape=box,color=blue];
		j3906374408 -> j961906994;
	j961906994 [label="Debería irme antes de... ",shape=box,color=blue];
		j961906994 -> j1994621250;
	j1994621250 [label="Me debo ir.",shape=box,color=blue];
		j1994621250 -> j111445917;
	j111445917 [label="Check boolean LyonDating",color=orange];
		j111445917 -> j280897925 [label=true,color=green];
		j111445917 -> j1787822316 [label=false,color=brown];
	j280897925 [label="+20 Chemistry",color=orange];
		j280897925 -> j1891643052;
	j1787822316 [label="+20 Chemistry",color=orange];
		j1787822316 -> j2955834268;
	j1891643052 [label="Gracias, mi amor.",shape=box,color=blue];
		j1891643052 -> j453656990;
	j2955834268 [label="Gracias, amigo mío.",shape=box,color=blue];
		j2955834268 -> j453656990;
	j453656990 [label="Lyon",shape=box,color=blue];
		j453656990 -> j561186479;
	j561186479 [label="Boolean LyonConfession2 is now true.",color=orange];
		j561186479 -> j4275890424;
