	"Chat ends." [color=orange];
	j3834970328 [label="¿Te das cuenta de lo ridículo que suena eso, no?",shape=box,color=blue];
		j3834970328 -> j2474203257;
		j3834970328 -> j1096606553;
	j2669251922 [label="No quiero perder más tiempo del que ya he perdido escuchando su argumento. Simplemente diré que está muy bien.",shape=box,color=blue];
		j2669251922 -> j2169173578;
	j755423609 [label="El problema, corrígeme si me equivoco, era que no querías ahondar en mi pasado. ¿Ahora parece que has cambiado de opinión?",shape=box,color=blue];
		j755423609 -> j830456428;
	j2474203257 [label="No sabía que había dicho que me disculparía.",shape=box,color=red];
		j2474203257 -> j1821592168;
	j1096606553 [label="No sabía qué más hacer. Ahora que lo pienso, suena ridículo.",shape=box,color=red];
		j1096606553 -> j1582661413;
	j2169173578 [label="Check boolean MarieFamilyFail",color=orange];
		j2169173578 -> j2223193534 [label=true,color=green];
		j2169173578 -> j4253118074 [label=false,color=brown];
	j830456428 [label="No lo entiendo. No podemos volver atrás. Esas aguas no se pueden volver a cruzar.",shape=box,color=blue];
		j830456428 -> j3081634886;
		j830456428 -> j2126087585;
	j1821592168 [label="Ya veo.",shape=box,color=blue];
		j1821592168 -> "Chat ends.";
	j1582661413 [label="Admito que lo cómico de la situación es en parte lo que me impulsó a venir a investigar. ¿Es realmente tan profunda tu desesperación? No puedo imaginar que mi ausencia en tu vida te resulte tan dolorosa.",shape=box,color=blue];
		j1582661413 -> j2083082007;
	j2223193534 [label="Te ayudaré como me pides. Me da miedo lo que tu demonio le hará a Marie a continuación.",shape=box,color=blue];
		j2223193534 -> j92487004;
	j4253118074 [label="Te ayudaré como me pides. Ahora, por favor, para tu ataque, diablo.",shape=box,color=blue];
		j4253118074 -> j770168571;
	j3081634886 [label="Ah. Bueno, fue una enorme pérdida de tiempo entonces, ¿no?",shape=box,color=red];
		j3081634886 -> "Chat ends.";
	j2126087585 [label="Supongo que... simplemente diré que lo siento, entonces. Por no escucharte.",shape=box,color=red];
		j2126087585 -> j1054493682;
	j2083082007 [label="Sí, Lyon. Me importas. Mucho. Y sé que me equivoqué terriblemente contigo.",shape=box,color=red];
		j2083082007 -> j3410582428;
	j92487004 [label="Boolean LyonFamilySuccess is now true.",color=orange];
		j92487004 -> j547953661;
	j770168571 [label="Boolean LyonFamilySuccess is now true.",color=orange];
		j770168571 -> j3711686580;
	j1054493682 [label="¿Puedo preguntar por qué no lo hiciste? ¿Te daba miedo el tema? ¿Quizás te aburría? ¿O creías que no tenías la fuerza para afrontarlo?",shape=box,color=blue];
		j1054493682 -> j339680830;
		j1054493682 -> j1096246325;
		j1054493682 -> j3933940005;
	j3410582428 [label="Y lo siento mucho, de verdad.",shape=box,color=red];
		j3410582428 -> j1848892736;
	j547953661 [label="Boolean LyonFamilyFail is now false.",color=orange];
		j547953661 -> "Initiate conversation MarieLyonRepair in /Lotus/Types/Gameplay/1999Wf/Dialogue/MarieDialogue_rom.dialogue";
	j3711686580 [label="Boolean LyonFamilyFail is now false.",color=orange];
		j3711686580 -> "Chat ends.";
	j339680830 [label="Tenía miedo.",shape=box,color=red];
		j339680830 -> j1347420913;
	j1096246325 [label="No pensé que fuera lo suficientemente fuerte para asumirlo.",shape=box,color=red];
		j1096246325 -> j1347420913;
	j3933940005 [label="En ese momento no me importaba. Pero ahora sí.",shape=box,color=red];
		j3933940005 -> j381010832;
	j1848892736 [label="No sabía qué más hacer excepto recurrir a Roathe en busca de ayuda.",shape=box,color=red];
		j1848892736 -> j613343346;
	"Initiate conversation MarieLyonRepair in /Lotus/Types/Gameplay/1999Wf/Dialogue/MarieDialogue_rom.dialogue" [label="Initiate conversation MarieLyonRepair in /Lotus/Types/Gameplay/1999Wf/Dialogue/MarieDialogue_rom.dialogue",color=orange];
		"Initiate conversation MarieLyonRepair in /Lotus/Types/Gameplay/1999Wf/Dialogue/MarieDialogue_rom.dialogue" -> "Chat ends.";
	j1347420913 [label="Entonces no tengo más remedio que perdonarte. ",shape=box,color=blue];
		j1347420913 -> j106665696;
	j381010832 [label="¿Y qué ha cambiado que hace que de repente te importe, cuando antes no te importaba?",shape=box,color=blue];
		j381010832 -> j4234339031;
		j381010832 -> j2928812205;
	j613343346 [label="No me queda otra opción que perdonarte, claro. No sé por qué querrías que algo tan roto como yo ocupe tus espacios.",shape=box,color=blue];
		j613343346 -> j1403867419;
	j106665696 [label="Boolean LyonConfessionFail is now false.",color=orange];
		j106665696 -> "Chat ends.";
	j4234339031 [label="Cambié de opinión sobre ti.",shape=box,color=red];
		j4234339031 -> j1347420913;
	j2928812205 [label="Siento que escuchar sus historias podría desbloquear algún progreso.",shape=box,color=red];
		j2928812205 -> j3336865462;
	j1403867419 [label="Pero encuentro que mi enojo por tus palabras se está desvaneciendo ahora que veo los extremos absolutamente extraños a los que estás dispuesto a llegar para tenerme de tu lado.",shape=box,color=blue];
		j1403867419 -> j2398113586;
