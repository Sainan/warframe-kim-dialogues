		j2854503722 -> j1722753670;
	j3173776678 [label="+5 Chemistry",color=orange];
		j3173776678 -> j1672272432;
	j2796237841 [label="¿Ya has elegido un camino? ¿O quizás estás más nervioso que yo?",shape=box,color=blue];
		j2796237841 -> j3341675988;
		j2796237841 -> j3681356598;
	j2694733218 [label="+5 Chemistry",color=orange];
		j2694733218 -> j155436911;
	j1528763581 [label="No siempre estoy seguro de cómo responder adecuadamente en situaciones como la simple curiosidad por mi historia, o incluso ante expresiones benignas de amistad.",shape=box,color=blue];
		j1528763581 -> j2269277489;
	j777501651 [label="+5 Chemistry",color=orange];
		j777501651 -> j1722753670;
	j1672272432 [label="Sí, y es este... sentimiento el que me inquieta cada vez más, debo admitirlo. Para mi tranquilidad, simplemente confirma que dices lo que cada vez me asusta más.",shape=box,color=blue];
		j1672272432 -> j680829608;
		j1672272432 -> j1655708132;
	j3341675988 [label="Perdón por ignorarte antes...",shape=box,color=red];
		j3341675988 -> j416332109;
	j3681356598 [label="¿Qué quieres decir...?",shape=box,color=red];
		j3681356598 -> j416332109;
	j155436911 [label="Debo admitir que tu elección de palabras me inquieta. Aunque no sé si las interpretas como yo.",shape=box,color=blue];
		j155436911 -> j680829608;
		j155436911 -> j1655708132;
	j2269277489 [label="De todas formas, me preguntabas sobre mi pasado, ¿no?",shape=box,color=blue];
		j2269277489 -> j1251821402;
	j680829608 [label="Entonces te tranquilizaré: no siento nada por ti.",shape=box,color=red];
		j680829608 -> j417948081;
	j1655708132 [label="¿Es tan difícil para ti creer que pueda sentir algo por ti, Lyon?",shape=box,color=red];
		j1655708132 -> j2116334841;
	j416332109 [label="Abandonaste la conquista con el mismo fervor con el que la iniciaste. Supuse que habías decidido con razón que era una mala decisión.",shape=box,color=blue];
		j416332109 -> j577015019;
		j416332109 -> j1896993796;
	j1251821402 [label="Probablemente ya te habrás dado cuenta de que tengo... visiones. Esto ha formado parte de mi vida desde que era niño.",shape=box,color=blue];
		j1251821402 -> j484298128;
	j417948081 [label="No quise ofenderte, pero es bueno dejar las cosas en claro. Me disculpo por lo mal que estoy manejando todo esto.",shape=box,color=blue];
		j417948081 -> j1528763581;
	j2116334841 [label="Boolean DrifterLyon is now true.",color=orange];
		j2116334841 -> j4022136388;
	j577015019 [label="Tienes razón, todo esto es un error.",shape=box,color=red];
		j577015019 -> j1780690430;
	j1896993796 [label="Simplemente no sabía si mis avances serían bien recibidos. ",shape=box,color=red];
		j1896993796 -> j1984281822;
	j484298128 [label="Estas visiones no han sido siempre agradables, por decir lo menos.",shape=box,color=blue];
		j484298128 -> j3308007644;
		j484298128 -> j2329846328;
		j484298128 -> j2717308723;
	j4022136388 [label="¿En pocas palabras? Pues, sí. No pretendo menospreciar tus esfuerzos. Simplemente no estoy acostumbrado al cariño, Viajero. De ningún tipo.",shape=box,color=blue];
		j4022136388 -> j3873131308;
	j1780690430 [label="Ya me lo imaginaba. Así que simplemente te deseo que tengas un buen día.",shape=box,color=blue];
		j1780690430 -> "Chat ends.";
	j1984281822 [label="+5 Chemistry",color=orange];
		j1984281822 -> j173921048;
	j3308007644 [label="¿Y crees que las visiones vinieron de Lua?",shape=box,color=red];
		j3308007644 -> j159412264;
	j2329846328 [label="¿Qué implicaban?",shape=box,color=red];
		j2329846328 -> j159412264;
	j2717308723 [label="¿Te asustaron?",shape=box,color=red];
		j2717308723 -> j1618820134;
	j3873131308 [label="Si estás decidido a emprender este camino, no te detendré y me resulta tan inestable y... extraño como a ti.",shape=box,color=blue];
		j3873131308 -> j1859932681;
	j173921048 [label="En sí, no son... indeseables. Simplemente son... desconcertantes, por el mero hecho de existir.",shape=box,color=blue];
		j173921048 -> j3823219613;
		j173921048 -> j1655708132;
	j159412264 [label="Una vez me desperté en mitad de la noche y vi el rostro de una anciana sentada a los pies de mi cama.",shape=box,color=blue];
		j159412264 -> j3821646778;
	j1618820134 [label="Una vez me desperté en mitad de la noche y vi el rostro de una anciana sentada a los pies de mi cama.",shape=box,color=blue];
		j1618820134 -> j4124827956;
	j1859932681 [label="+5 Chemistry",color=orange];
		j1859932681 -> j2114017324;
	j3823219613 [label="¿Prefieres que pare?",shape=box,color=red];
		j3823219613 -> j622583817;
	j3821646778 [label="Tan delgada y frágil que parecía que ya había estado muerta y enterrada durante años, su piel se aferraba a sus huesos con tanta fuerza que podía ver los espacios entre ellos.",shape=box,color=blue];
		j3821646778 -> j595686809;
	j4124827956 [label="Tan delgada y frágil que parecía que ya había estado muerta y enterrada durante años, su piel se aferraba a sus huesos con tanta fuerza que podía ver los espacios entre ellos.",shape=box,color=blue];
		j4124827956 -> j2566311330;
	j2114017324 [label="Quizás tengo cierta esperanza de ver adónde me lleva este nuevo camino. Sin embargo, me preguntabas por mi pasado, ¿no?",shape=box,color=blue];
		j2114017324 -> j2102928304;
	j622583817 [label="No pretendo menospreciar tus esfuerzos. Simplemente no estoy acostumbrado al cariño, Viajero. De ningún tipo.",shape=box,color=blue];
		j622583817 -> j3873131308;
	j595686809 [label="Su cabello eran unos cuantos mechones blancos que colgaban de su cabeza. Pero fueron sus ojos lo que más recordaré. ",shape=box,color=blue];
		j595686809 -> j557702755;
	j2566311330 [label="Su cabello eran unos cuantos mechones blancos que colgaban de su cabeza. Pero fueron sus ojos lo que más recordaré. ",shape=box,color=blue];
		j2566311330 -> j1421773980;
	j2102928304 [label="Boolean LyonFlirt2 is now true.",color=orange];
		j2102928304 -> j1251821402;
	j557702755 [label="Porque no tenía.",shape=box,color=blue];
		j557702755 -> j1463276941;
	j1421773980 [label="Porque no tenía.",shape=box,color=blue];
		j1421773980 -> j181869086;
	j1463276941 [label="Tres meses después, una mujer del pueblo fue encontrada muerta en su casa. Sus ojos habían sido devorados por ratas.",shape=box,color=blue];
		j1463276941 -> j2803865592;
	j181869086 [label="Tres meses después, una mujer del pueblo fue encontrada muerta en su casa. Sus ojos habían sido devorados por ratas.",shape=box,color=blue];
		j181869086 -> j1820249692;
	j2803865592 [label="Le conté a mi madre lo que había visto la noche en que la visión me despertó. Ella recordó lo que había visto, igual que yo.",shape=box,color=blue];
		j2803865592 -> j3650977919;
		j2803865592 -> j3686369728;
	j1820249692 [label="Sí, Viajero. Las visiones me asustaban.",shape=box,color=blue];
		j1820249692 -> j2803865592;
	j3650977919 [label="¿Qué hizo ella?",shape=box,color=red];
		j3650977919 -> j1987803058;
	j3686369728 [label="¿Pensó que era una coincidencia o una señal?",shape=box,color=red];
		j3686369728 -> j948888098;
	j1987803058 [label="Me golpeó con una vara hasta que no pude mantenerme en pie. Mi espalda sangraba tanto que debía dormir boca abajo. Todavía recuerdo sus gritos mientras me golpeaba. \"Diable ! Sorcier !\"",shape=box,color=blue];
		j1987803058 -> j2137317388;
		j1987803058 -> j3511924702;
		j1987803058 -> j2898667954;
		j1987803058 -> j278523896;
	j948888098 [label="No lo sé. Sólo sé que me golpeó con una vara hasta que no pude mantenerme en pie. Mi espalda sangraba tanto que debía dormir boca abajo. Todavía recuerdo sus gritos mientras me golpeaba. \"Diable ! Sorcier !\"",shape=box,color=blue];
		j948888098 -> j2137317388;
		j948888098 -> j3511924702;
		j948888098 -> j2898667954;
		j948888098 -> j278523896;
	j2137317388 [label="¿Qué edad tenías?",shape=box,color=red];
		j2137317388 -> j2186201788;
	j3511924702 [label="Oh, Lyon... Lo siento muchísimo...",shape=box,color=red];
		j3511924702 -> j2342015748;
	j2898667954 [label="Eso es terrible...",shape=box,color=red];
		j2898667954 -> j2342015748;
	j278523896 [label="Ella era una ignorante. No sabía qué hacer.",shape=box,color=red];
		j278523896 -> j2342015748;
	j2186201788 [label="Cuatro, quizás. Seis, como máximo. No lo sé. No contábamos nuestros años con la misma vehemencia que ahora.",shape=box,color=blue];
		j2186201788 -> j2698478763;
	j2342015748 [label="+5 Chemistry",color=orange];
		j2342015748 -> j3405679900;
	j2698478763 [label="Check boolean LyonPainOff",color=orange];
		j2698478763 -> j3909612246 [label=true,color=green];
		j2698478763 -> j4129976140 [label=false,color=brown];
		j2698478763 -> j3909612246 [label=false,color=brown];
	j3405679900 [label="Mi madre ya había muerto cuando nos fuimos para venir aquí. Y ahora, no es más que polvo. Vivió una vida de miseria... y estaba condenada a propagarla.",shape=box,color=blue];
		j3405679900 -> j3260249826;
	j3909612246 [label="Lastimar a un niño... es imperdonable.",shape=box,color=red];
		j3909612246 -> j2342015748;
	j4129976140 [label="¿Es por eso que...?",shape=box,color=red];
		j4129976140 -> j2933368378;
	j3260249826 [label="Estaba asustada. Cualquier cosa que me afligiera, ya fuera una carga de los dioses, la locura, una maldición, ella no estaba preparada para manejarla.",shape=box,color=blue];
		j3260249826 -> j650593806;
	j2933368378 [label="Check boolean LyonLecture2",color=orange];
		j2933368378 -> j969435929 [label=true,color=green];
		j2933368378 -> j2902694868 [label=false,color=brown];
	j650593806 [label="De todas formas, por muy cruel que fuera mi madre, mi padre fue peor. Te ahorraré los detalles.",shape=box,color=blue];
		j650593806 -> j1125274219;
	j969435929 [label="Quizás. A menudo me he preguntado si no formaba parte de la compulsión. Pero como ya te dije, también es un método de Lua.",shape=box,color=blue];
		j969435929 -> j2460896681;
	j2902694868 [label="Quizás. A menudo me he preguntado si no formaba parte de la compulsión. Pero es un método de Lua, de las Luminarias. No soy el único que lo practica.",shape=box,color=blue];
		j2902694868 -> j3052281218;
	j1125274219 [label="A medida que crecí, las visiones se convirtieron en voces. Susurros que me llegaban a todas horas. Despierto y soñando. Mi trabajo en la granja se vio afectado por ello, y yo también.",shape=box,color=blue];
		j1125274219 -> j2312256347;
		j1125274219 -> j3124847109;
	j2460896681 [label="+5 Chemistry",color=orange];
		j2460896681 -> j2666321978;
	j3052281218 [label="+5 Chemistry",color=orange];
		j3052281218 -> j2269669376;
	j2312256347 [label="¿Qué te llevó a la iglesia?",shape=box,color=red];
		j2312256347 -> j4013567020;
	j3124847109 [label="Algunas personas no merecen ser padres.",shape=box,color=red];
		j3124847109 -> j1543675599;
	j2666321978 [label="Insisto en que me aporta un poco de paz, aunque sé que aún debe parecerte extraño que así sea.",shape=box,color=blue];
		j2666321978 -> j650593806;
	j2269669376 [label="Me lo enseñó uno de los otros padres de la Catedral para ayudarme a... despejar la mente. Quienes son elegidos por Lua suelen ser \"bendecidos\" con \"visiones\".",shape=box,color=blue];
		j2269669376 -> j3705675074;
	j4013567020 [label="Check boolean LyonPainOff",color=orange];
		j4013567020 -> j1329665091 [label=true,color=green];
		j4013567020 -> j2664564600 [label=false,color=brown];
	j1543675599 [label="Aprecio el sentimiento, pero tampoco puedo subestimar lo difícil que fue lidiar conmigo como hijo, especialmente cuando me volví más alto y más fuerte que ellos.",shape=box,color=blue];
		j1543675599 -> j4013567020;
	j3705675074 [label="Boolean LyonLecture2 is now true.",color=orange];
		j3705675074 -> j650593806;
	j1329665091 [label="Mis visiones y las voces a menudo me provocaban ataques violentos, Viajero. Torturarme era a menudo la única manera de despertar de lo que veía.",shape=box,color=blue];
		j1329665091 -> j776682803;
	j2664564600 [label="Mis visiones y las voces a menudo me provocaban ataques violentos, Viajero. A menudo usaba un cuchillo para desgarrarme la carne, pues el dolor era lo único que me despertaba.",shape=box,color=blue];
		j2664564600 -> j776682803;
	j776682803 [label="Pero fue cuando las voces me indicaron que...",shape=box,color=blue];
		j776682803 -> j1142913021;
	j1142913021 [label="No... no puedo. Simplemente no puedo. Perdóname. Me tiemblan las manos mientras escribo esto. Debo parar por ahora.",shape=box,color=blue];
		j1142913021 -> j39766328;
		j1142913021 -> j2918843945;
	j39766328 [label="Por supuesto. No pasa nada. No hay prisa. Estaré aquí cuando quieras.",shape=box,color=red];
		j39766328 -> j3072906663;
	j2918843945 [label="Entiendo, esto ya ha sido demasiado. Descansa, ¿sí? Y... gracias. Esto significa mucho para mí.",shape=box,color=red];
		j2918843945 -> j3730839499;
	j3072906663 [label="+10 Chemistry",color=orange];
		j3072906663 -> j3874142181;
	j3730839499 [label="+15 Chemistry",color=orange];
		j3730839499 -> j2719805832;
	j3874142181 [label="Gracias. Hablaré contigo pronto.",shape=box,color=blue];
		j3874142181 -> j286102906;
	j2719805832 [label="También para mí. Más de lo que imaginas, creo. Gracias de vuelta. Hablaré contigo pronto.",shape=box,color=blue];
		j2719805832 -> j3964134755;
	j286102906 [label="Boolean LyonBackstory3b is now true.",color=orange];
		j286102906 -> j2084492712;
