	j1584197471 [label="Evaluate expressions",color=orange];
		j1584197471 -> j3173776678 [label="LyonFirstFlirt",color=purple];
		j1584197471 -> j2796237841 [label="LyonFlirtIgnored",color=purple];
		j1584197471 -> j2694733218 [label="false",color=purple];
	j1722753670 [label="No, perdóname. Yo... me disculpo por lo mal que estoy manejando todo esto.",shape=box,color=blue];
		j1722753670 -> j1528763581;
	j1083147468 [label="Lyon, si prefieres que me vaya, por favor dímelo.",shape=box,color=red];
		j1083147468 -> j777501651;
