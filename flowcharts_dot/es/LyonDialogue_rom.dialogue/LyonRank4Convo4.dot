	j2472123779 [label="¿Por qué creerías que es una pérdida de tiempo?",shape=box,color=red];
		j2472123779 -> j797338974;
	j3946659541 [label="No es tiempo perdido para mí, Lyon. Me encantaría conocerte mejor.",shape=box,color=red];
		j3946659541 -> j1584197471;
	j3096768110 [label="No importa entonces. Si prefieres no hacerlo.",shape=box,color=red];
		j3096768110 -> j1722753670;
	j797338974 [label="Simplemente creo que hay mejores maneras de usar tus energías. Como defender algún bastión contra un grupo enemigo invasor, descubrir conocimiento desconocido... o guardar ropa.",shape=box,color=blue];
