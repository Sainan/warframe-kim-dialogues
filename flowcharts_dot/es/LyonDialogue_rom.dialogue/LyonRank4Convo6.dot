	2232 [label="+20 Chemistry",color=orange];
		2232 -> 2231;
	1186 [label="Lyon, I was speaking with Marie, about your... habits, and I was wondering if we could talk?",shape=box,color=red];
		1186 -> 1192;
	1183 [label="[Disable conversations about self-harm. No loss of chemistry with Lyon or any other character will be incurred by doing so.]",shape=box,color=red];
		1183 -> 1189;
	1182 [label="[End.]",shape=box,color=red];
		1182 -> 1188;
	1185 [label="Lyon? Can we talk about something that might be a bit... uncomfortable for you?",shape=box,color=red];
		1185 -> 1191;
	1184 [label="Lyon, I was wondering if I could talk to you about why you - um... well, hurt yourself, if that's all right?",shape=box,color=red];
		1184 -> 1190;
	2231 [label="[Conversation skipped due to previous setting of trigger warning.]",shape=box,color=blue];
		2231 -> 1057;
	1192 [label="She alerted me that you two had spoken - yes, of course. You might be surprised at how little it troubles me to speak of this particular trait of mine.",shape=box,color=blue];
		1192 -> 1197;
	1189 [label="Update boolean LyonPainOff",color=orange];
		1189 -> 1194;
	1188 [label="Chat ends.",color=orange];
	1191 [label="You may ask, though I reserve the right to go no farther in the conversation if I feel it treads into an area of discussion I am no longer willing to partake in. ",shape=box,color=blue];
		1191 -> 1196;
	1190 [label="Mm. I am honestly surprised it took this long for you to enquire about this particular trait of mine. It is usually that which most find cause to remark upon most readily.",shape=box,color=blue];
		1190 -> 1195;
	1057 [label="Chat ends.",color=orange];
	1197 [label="It is usually that which most find cause to remark upon most readily. Either for reasons of concern, disgust, or the morbid curiosity.",shape=box,color=blue];
		1197 -> 1204;
	1194 [label="If you were to consider yourself a coward for this choice, I beseech you - do not. For this is a pain that is not yours to face. It is mine. You did not ask to bear this moment.",shape=box,color=blue];
		1194 -> 1198;
	1196 [label="It's about the fact that you hurt yourself, sometimes. I wanted to be careful in how I broached the subject with you, is all.",shape=box,color=red];
		1196 -> 1203;
	1195 [label="Either for reasons of concern, disgust, or the morbid curiosity that might drive someone to peer through the bars of a lunatic's cage. I wonder, which are you?",shape=box,color=blue];
		1195 -> 1199;
		1195 -> 1200;
		1195 -> 1201;
		1195 -> 1202;
	1204 [label="Evaluate expressions",color=orange];
		1204 -> 1199 [label="LyonBackstory3a",color=purple];
		1204 -> 1210 [label="LyonBackstory3a",color=purple];
		1204 -> 1199 [label="LyonBackstory3b",color=purple];
		1204 -> 1210 [label="LyonBackstory3b",color=purple];
		1204 -> 1199 [label="DrifterHarmHelp",color=purple];
		1204 -> 1201 [label="DrifterHarmHelp",color=purple];
		1204 -> 1199 [label="DrifterHarmStop",color=purple];
		1204 -> 1202 [label="DrifterHarmStop",color=purple];
		1204 -> 1199 [label="DrifterHarmLoss",color=purple];
		1204 -> 1200 [label="DrifterHarmLoss",color=purple];
		1204 -> 1199 [label="false",color=purple];
	1198 [label="This mechanical contraption at which we sit creates an impression of veiled impersonality. That we are somehow sheltered from whatever harm another might cause us through whatever words they type to us upon it.",shape=box,color=blue];
		1198 -> 1205;
	1203 [label="+5 Chemistry",color=orange];
		1203 -> 1209;
	1199 [label="Lo siento, pensándolo bien, no puedo hacer esto. [Fin.]",shape=box,color=red];
		1199 -> 1194;
	1200 [label="[Warning: Discussion of suicide.] I... lost someone to this kind of \"habit\" once and I...",shape=box,color=red];
		1200 -> 1206;
	1201 [label="I just want to help you. To make sure you're all right. That's all.",shape=box,color=red];
		1201 -> 1207;
	1202 [label="I just feel like this isn't healthy - that it's something that should stop. ",shape=box,color=red];
		1202 -> 1208;
	1210 [label="I know you said you used to hurt yourself before the serum, but... I can't imagine it's made it any better.",shape=box,color=red];
		1210 -> 1215;
	1205 [label="I would argue instead the opposite - that free of the armor we don in our more mundane social interactions, we are stripped of that which might protect us.",shape=box,color=blue];
		1205 -> 1211;
	1209 [label="I... appreciate the delicate nature in which you are treating this, Drifter. Thank you. But I am quite used to this being a topic of discussion. Either for reasons of concern, disgust, or morbid curiosity - though I think you have already proven it to be the former.",shape=box,color=blue];
		1209 -> 1199;
		1209 -> 1200;
		1209 -> 1201;
		1209 -> 1202;
	1206 [label="Update boolean DrifterHarmLoss",color=orange];
		1206 -> 1212;
	1207 [label="Update boolean DrifterHarmHelp",color=orange];
		1207 -> 1213;
	1208 [label="Update boolean DrifterHarmStop",color=orange];
		1208 -> 1214;
	1215 [label="No, I fear it has not. It has taken something that was... a requirement to clear my mind of the visions that plagued me, and turned it into a requirement to wield the \"gifts\" of this serum.",shape=box,color=blue];
		1215 -> 1221;
	1211 [label="Therefore, in situations like these... I am well aware that I let loose an arrow that might find not the battle-ready soldier, but the unsuspecting jugular of a deer in the woods.",shape=box,color=blue];
		1211 -> 1216;
	1212 [label="Oh, my friend... there are no words that I can put down that will adequately express my sympathy for what you have endured.",shape=box,color=blue];
		1212 -> 1217;
	1213 [label="Check boolean LyonAllRight",color=orange];
		1213 -> 1219 [label=true,color=green];
		1213 -> 1218 [label=false,color=brown];
	1214 [label="I believe you are several years and one protoframe serum too late to put an end to this particular compulsion of mine - indeed, I fear it is now more of a required action, is it not?",shape=box,color=blue];
		1214 -> 1220;
	1221 [label="+5 Chemistry",color=orange];
		1221 -> 1226;
	1216 [label="So I shall, therefore, leave you with this:",shape=box,color=blue];
		1216 -> 1222;
	1217 [label="Language seems paltry when moments like these come to pass. We scramble to wield them as best we can, yet they always seem to fail us.",shape=box,color=blue];
		1217 -> 1223;
	1219 [label="I once more am attempting not to chuckle at the notion of my ever approaching the concept of \"all right.\" But I very much appreciate the sentiment, Drifter.",shape=box,color=blue];
		1219 -> 1224;
	1218 [label="I am attempting not to chuckle at the notion of my ever approaching the concept of \"all right.\" But I very much appreciate the sentiment, Drifter.",shape=box,color=blue];
		1218 -> 1224;
	1220 [label="+5 Chemistry",color=orange];
		1220 -> 1225;
	1226 [label="If the ability to cure my compulsion to harm myself were within my grasp prior to injecting the serum, I believe joining with the \"Harrow\" Warframe has made it quite impossible now.",shape=box,color=blue];
		1226 -> 1231;
	1222 [label="We must remind ourselves how to find the strength to pull another to their feet, even when we cannot find the will to stand.",shape=box,color=blue];
		1222 -> 1227;
	1223 [label="There are three things I might do, if you would indulge me, in light of your confession.",shape=box,color=blue];
		1223 -> 1228;
	1224 [label="+5 Chemistry",color=orange];
		1224 -> 1229;
		1224 -> 1230;
	1225 [label="But I do not mean to be so flippant over what I believe is an expression of concern over my physical and mental well-being, forgive me. I simply do not think it is within my ability to cease.",shape=box,color=blue];
		1225 -> 1229;
		1225 -> 1230;
	1231 [label="If I might be quite crass, Drifter, I do not think I am capable of causing myself any real permanent harm in such a fashion any longer.",shape=box,color=blue];
		1231 -> 1235;
	1227 [label="That is the true purpose of story.",shape=box,color=blue];
		1227 -> 1232;
	1228 [label="First; is that I am quick to assure you that I am in no danger. If you believe there is some deep and terrible self-loathing that drives my desire to harm myself, I would be quite eager to put those fears to rest.",shape=box,color=blue];
		1228 -> 1233;
	1229 [label="May I ask why you do it?",shape=box,color=red];
		1229 -> 1234;
	1230 [label="I'm just worried you're going to go too far.",shape=box,color=red];
		1230 -> 1231;
	1235 [label="While I am not capable of the hubris required to think myself impervious, such an act seems... shall we say... part of the design.",shape=box,color=blue];
		1235 -> 1241;
	1232 [label="+20 Chemistry",color=orange];
		1232 -> 1236;
	1233 [label="While I... know that great melancholy, it does not inspire my thurible. (Marie would never allow it, for one. She is liable to feed it to me before she would let me near one ever again.)",shape=box,color=blue];
		1233 -> 1237;
	1234 [label="Evaluate expressions",color=orange];
		1234 -> 1240 [label="LyonBackstory3a, LyonLecture2",color=purple];
		1234 -> 1240 [label="LyonBackstory3b, LyonLecture2",color=purple];
		1234 -> 1239 [label="LyonBackstory3a",color=purple];
		1234 -> 1239 [label="LyonBackstory3b",color=purple];
		1234 -> 1238 [label="false",color=purple];
	1241 [label="+5 Chemistry",color=orange];
		1241 -> 1246;
	1236 [label="Be well, Drifter. We shall speak again soon.",shape=box,color=blue];
		1236 -> 1242;
	1237 [label="But such deep pains have never whispered to me in the night, my friend. This, I can vow to you. This, I pledge to you, on all that I hold dear.",shape=box,color=blue];
		1237 -> 1243;
	1240 [label="I have spoken you the truth of what inspires me to act - the pain clears my mind of the visions that plague me. And the practice is not so shamed amongst the Brothers of Lua as it might be in your culture. I can vow upon all I hold dear there is no hidden secret I am withholding.",shape=box,color=blue];
		1240 -> 1245;
	1239 [label="That is a complicated topic, as the reasons behind my rending my own flesh are not singular. I have told you of the visions that plague me, and that the pain clears my mind. But the act itself is not so taboo as you might believe.",shape=box,color=blue];
		1239 -> 1244;
	1238 [label="That is a complicated topic, as the reasons behind my rending my own flesh are not singular. I must start by saying that the matter is not nearly as taboo as it may seem to you in this day and age.",shape=box,color=blue];
		1238 -> 1244;
	1246 [label="I do not think what I do is \"right.\" I do not think what I do should be practiced by others. I do not think what I do is enviable.",shape=box,color=blue];
		1246 -> 1251;
	1242 [label="-F. Lyon Allard",shape=box,color=blue];
		1242 -> 1247;
	1243 [label="Second; I must commend you on your bravery to send these words to me. It would have been easier to avoid them. You did not.",shape=box,color=blue];
		1243 -> 1248;
	1245 [label="If you believe there is some deep and terrible self-loathing that drives my desire to harm myself, I would be quite eager to put those fears to rest.",shape=box,color=blue];
		1245 -> 1250;
	1244 [label="Amongst the Brothers of Lua, there is an ancient practice of flagellation. It is rare, and even in my day it was seen as archaic and used by those who were \"blessed by her visions.\"",shape=box,color=blue];
		1244 -> 1249;
	1251 [label="However it is not - in my incredibly unique and rather \"supernatural\" in the most literal sense of the word, state - strictly dangerous for me, either.",shape=box,color=blue];
		1251 -> 1256;
	1247 [label="Update boolean LyonSpeech",color=orange];
		1247 -> 1252;
	1248 [label="Third; I do not, nor shall I never comprehend the context of what your companion suffered. And, in a way, no one but they themselves ever shall.",shape=box,color=blue];
		1248 -> 1253;
	1250 [label="While I... know that great melancholy, it does not inspire my thurible. Marie would never allow it, for one.",shape=box,color=blue];
		1250 -> 1255;
	1249 [label="One of the Fathers at the Cathedral taught it to me, not long after I arrived, when he saw that I was similarly... \"blessed,\" and saw fit to aid me. ",shape=box,color=blue];
		1249 -> 1254;
	1256 [label="Indeed, I have often wondered if there were not some modern miracle of science that could aid me with my afflictions. Would that I be in such a condition to accept any such help, I would take it. I doubt my physiology would allow for it, now.",shape=box,color=blue];
		1256 -> 1261;
	1252 [label="Chat ends.",color=orange];
	1253 [label="To suffer in such a way that is so all-consuming is, by its definition, a solitary thing.",shape=box,color=blue];
		1253 -> 1257;
	1255 [label="Update boolean LyonSNo",color=orange];
		1255 -> 1260;
		1255 -> 1259;
		1255 -> 1258;
	1254 [label="Update boolean LyonLecture2",color=orange];
		1254 -> 1258;
		1254 -> 1259;
		1254 -> 1260;
	1261 [label="Regardless, I assure you - I will not die of this. It is an burden I have carried with me since I was a child. And it is a symptom I have decided is better than the underlying festering wound, should I leave the scab un-picked.",shape=box,color=blue];
		1261 -> 1264;
	1257 [label="I simply pray to my god, and yours, and theirs, that you do not hold guilt in your heart. For if anything in this world or any other is to be forgiven, it is the kindness of knowing someone who has suffered so.",shape=box,color=blue];
		1257 -> 1262;
	1260 [label="And you're certain you're never going to... take it too far?",shape=box,color=red];
		1260 -> 1231;
	1259 [label="I'm struck by how odd religious practices can be, sometimes.",shape=box,color=red];
		1259 -> 1263;
	1258 [label="That makes me feel a little better, I suppose.",shape=box,color=red];
		1258 -> 1231;
	1264 [label="Check boolean LyonSNo",color=orange];
		1264 -> 1267 [label=true,color=green];
		1264 -> 1268 [label=false,color=brown];
	1262 [label="+15 Chemistry",color=orange];
		1262 -> 1265;
	1263 [label="I will not find cause to argue with you there. I am fascinated by the differences in religious ceremonies. I deeply enjoy studying all documentation of them.",shape=box,color=blue];
		1263 -> 1266;
	1267 [label="+10 Chemistry",color=orange];
		1267 -> 1271;
	1268 [label="If you believe there is some deep and terrible self-loathing that drives my desire to harm myself, I would be quite eager to put those fears to rest.",shape=box,color=blue];
		1268 -> 1272;
	1265 [label="Be well, Drifter. We shall speak again soon.",shape=box,color=blue];
		1265 -> 1269;
	1266 [label="Religious anthropology is a subject near and dear to me. There is much you can learn from a society and a people by studying their rituals. ",shape=box,color=blue];
		1266 -> 1270;
	1271 [label="I will promise you this, however - should I ever truly fear that it comes to a moment that I can no longer trust myself, I will speak the words.",shape=box,color=blue];
		1271 -> 1275;
	1272 [label="While I... know that great melancholy, it does not inspire my thurible. Marie would never allow it, for one.",shape=box,color=blue];
		1272 -> 1267;
	1269 [label="-F. Lyon Allard",shape=box,color=blue];
		1269 -> 1273;
	1270 [label="There is a Luminary sect in the far frozen north who worship a corpse they unearthed from a receding glacier. It was perfectly preserved, and no one is certain how old it is. But the brass disk it wore around its neck was stamped with the image of a sun.",shape=box,color=blue];
		1270 -> 1274;
	1275 [label="To Marie, to you, to M. Loid, even to Roathe, it will not matter. I will speak the words. This, I vow.",shape=box,color=blue];
		1275 -> 1277;
		1275 -> 1278;
	1273 [label="Chat ends.",color=orange];
	1274 [label="They believe the mummified body to be that of Sol himself. And they believe that someday he will return to life and rise again. Every hundred years, they prepare for \"The Great Eve\" and many of their followers drink poisoned wine the night before.",shape=box,color=blue];
		1274 -> 1276;
	1277 [label="That's the most I could ask for. Thank you, Lyon.",shape=box,color=red];
		1277 -> 1280;
	1278 [label="I trust you. I just wanted to walk through it with you.",shape=box,color=red];
		1278 -> 1280;
	1276 [label="Needless to say, when their mummified body has failed to return come the morning, they have a perfectly good reason as to why their calculations had been wrong, and the date is shifted another century or so.",shape=box,color=blue];
		1276 -> 1279;
	1280 [label="And I deeply appreciate your desire to know that I am not acting out of some unfettered drive to destroy myself.",shape=box,color=blue];
		1280 -> 1281;
	1279 [label="But I have digressed quite far from the topic at hand.",shape=box,color=blue];
		1279 -> 1241;
	1281 [label="I am not accustomed to having such companions in my life.",shape=box,color=blue];
		1281 -> 1282;
	1282 [label="Be well, Drifter. We shall speak again soon.",shape=box,color=blue];
		1282 -> 1283;
	1283 [label="-F. Lyon Allard",shape=box,color=blue];
		1283 -> 1284;
	1284 [label="Chat ends.",color=orange];
}