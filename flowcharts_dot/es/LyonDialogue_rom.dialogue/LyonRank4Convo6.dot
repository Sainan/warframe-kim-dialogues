	j1869492061 [label="+20 Chemistry",color=orange];
		j1869492061 -> j3560881597;
	j579561817 [label="Lyon, estaba hablando con Marie, sobre tus... hábitos, y me preguntaba si podríamos hablar.",shape=box,color=red];
		j579561817 -> j3899529944;
	j824094163 [label="[Desactivar conversaciones sobre autolesiones. Esto no afectará la química con Lyon ni con ningún otro personaje]",shape=box,color=red];
		j824094163 -> j2592777234;
	j202800200 [label="[Fin]",shape=box,color=red];
		j202800200 -> "Chat ends.";
	j3443816762 [label="¿Lyon? ¿Podemos hablar de algo que podría resultarte un poco incómodo?",shape=box,color=red];
		j3443816762 -> j972788794;
	j392924235 [label="Lyon, me preguntaba si podría hablar contigo sobre por qué... eh... bueno, te lastimas, ¿te parece bien?",shape=box,color=red];
		j392924235 -> j2752577058;
	j3560881597 [label="[Conversación omitida debido a una advertencia previamente establecida]",shape=box,color=blue];
		j3560881597 -> "Chat ends.";
	j3899529944 [label="Ella me avisó de que habían hablado. Sí, claro. Te sorprendería lo poco que me molesta hablar de este rasgo mío.",shape=box,color=blue];
		j3899529944 -> j2208364799;
	j2592777234 [label="Boolean LyonPainOff is now true.",color=orange];
		j2592777234 -> j4148048601;
	"Chat ends." [color=orange];
	j972788794 [label="Puedes preguntar, aunque me reservo el derecho de no avanzar más en la conversación si siento que se acerca a un área en la que no estoy dispuesto a participar. ",shape=box,color=blue];
		j972788794 -> j3446068507;
	j2752577058 [label="Mm. Me sorprende sinceramente que hayas tardado tanto en preguntar por este rasgo particular. Suele ser lo que más se comenta.",shape=box,color=blue];
		j2752577058 -> j2922009474;
	j2208364799 [label="Eso suele ser aquello que la mayoría considera motivo de observación, ya sea por preocupación, disgusto o curiosidad morbosa.",shape=box,color=blue];
		j2208364799 -> j897187574;
	j4148048601 [label="Si te consideras cobarde por esta decisión, te lo suplico: no lo hagas. Porque este dolor no te corresponde afrontarlo. Es mío. No pediste soportar este momento.",shape=box,color=blue];
		j4148048601 -> j3399714391;
	j3446068507 [label="Se trata de que a veces te haces daño. Quería tener cuidado al abordar el tema contigo, eso es todo.",shape=box,color=red];
		j3446068507 -> j3825844572;
	j2922009474 [label="Ya sea por preocupación, asco o la curiosidad morbosa que podría llevar a alguien a mirar a través de los barrotes de la jaula de un lunático. Me pregunto, ¿cuál de los dos eres tú?",shape=box,color=blue];
		j2922009474 -> j2959299057;
		j2922009474 -> j2771609096;
		j2922009474 -> j1415446121;
		j2922009474 -> j16635825;
	j897187574 [label="Evaluate expressions",color=orange];
		j897187574 -> j2959299057 [label="LyonBackstory3a",color=purple];
		j897187574 -> j1046467373 [label="LyonBackstory3a",color=purple];
		j897187574 -> j2959299057 [label="LyonBackstory3b",color=purple];
		j897187574 -> j1046467373 [label="LyonBackstory3b",color=purple];
		j897187574 -> j2959299057 [label="DrifterHarmHelp",color=purple];
		j897187574 -> j1415446121 [label="DrifterHarmHelp",color=purple];
		j897187574 -> j2959299057 [label="DrifterHarmStop",color=purple];
		j897187574 -> j16635825 [label="DrifterHarmStop",color=purple];
		j897187574 -> j2959299057 [label="DrifterHarmLoss",color=purple];
		j897187574 -> j2771609096 [label="DrifterHarmLoss",color=purple];
		j897187574 -> j2959299057 [label="false",color=purple];
	j3399714391 [label="Este aparato mecánico en el que nos sentamos crea una impresión de impersonalidad velada. Que de alguna manera estamos protegidos de cualquier daño que el otro pueda causarnos a través de las palabras escritas.",shape=box,color=blue];
		j3399714391 -> j2348751249;
	j3825844572 [label="+5 Chemistry",color=orange];
		j3825844572 -> j4161051891;
	j2959299057 [label="Lo siento, pensándolo bien, no puedo hacer esto. [Fin.]",shape=box,color=red];
		j2959299057 -> j4148048601;
	j2771609096 [label="[Advertencia: Discusión sobre suicidio] Yo... perdí a alguien por este tipo de \"hábito\" una vez y yo...",shape=box,color=red];
		j2771609096 -> j4238867689;
	j1415446121 [label="Solo quiero ayudarte. Asegurarme de que estés bien. Eso es todo.",shape=box,color=red];
		j1415446121 -> j4278740242;
	j16635825 [label="Siento que esto no es saludable y que es algo que debería parar. ",shape=box,color=red];
		j16635825 -> j1136794289;
	j1046467373 [label="Sé que dijiste que solías lastimarte antes del suero, pero... no puedo imaginar que ahora sea mejor.",shape=box,color=red];
		j1046467373 -> j1927009475;
	j2348751249 [label="Yo diría más bien lo contrario: que, libres de la armadura que usamos en nuestras interacciones sociales más comunes, estamos despojados de aquello que podría protegernos.",shape=box,color=blue];
		j2348751249 -> j1381332314;
	j4161051891 [label="Aprecio la delicadeza con la que tratas esto, Viajero. Gracias. Pero estoy bastante acostumbrado a que esto sea tema de discusión. Ya sea por preocupación, disgusto o curiosidad morbosa, aunque creo que ya has demostrado que es lo primero.",shape=box,color=blue];
		j4161051891 -> j2959299057;
		j4161051891 -> j2771609096;
		j4161051891 -> j1415446121;
		j4161051891 -> j16635825;
	j4238867689 [label="Boolean DrifterHarmLoss is now true.",color=orange];
		j4238867689 -> j1229537891;
	j4278740242 [label="Boolean DrifterHarmHelp is now true.",color=orange];
		j4278740242 -> j4131174356;
	j1136794289 [label="Boolean DrifterHarmStop is now true.",color=orange];
		j1136794289 -> j2823434854;
	j1927009475 [label="No, me temo que no. Ha tomado algo que era... un requisito para despejar mi mente de las visiones que me atormentaban, y lo ha convertido en un requisito para ejercer los \"dones\" de este suero.",shape=box,color=blue];
		j1927009475 -> j2596638317;
	j1381332314 [label="Por eso, en situaciones como estas... soy muy consciente de que disparo una flecha que podría no encontrar al soldado listo para la batalla, sino la yugular desprevenida de un ciervo en el bosque.",shape=box,color=blue];
		j1381332314 -> j1300590728;
	j1229537891 [label="Ay, mi amigo... no hay palabras que pueda escribir para expresar adecuadamente mi simpatía por lo que has soportado.",shape=box,color=blue];
		j1229537891 -> j2922395339;
	j4131174356 [label="Check boolean LyonAllRight",color=orange];
		j4131174356 -> j74151309 [label=true,color=green];
		j4131174356 -> j3004946073 [label=false,color=brown];
	j2823434854 [label="Creo que después de tantos años y un suero de protoframe ya no puedo poner fin a esta particular compulsión mía; de hecho, me temo que ahora es más bien una acción requerida, ¿no es así?",shape=box,color=blue];
		j2823434854 -> j3030088796;
	j2596638317 [label="+5 Chemistry",color=orange];
		j2596638317 -> j2612121962;
	j1300590728 [label="Así que te dejo con esto:",shape=box,color=blue];
		j1300590728 -> j2571147305;
	j2922395339 [label="El lenguaje parece insignificante en momentos como estos. Nos esforzamos por utilizarlo lo mejor posible, pero siempre parece fallarnos.",shape=box,color=blue];
		j2922395339 -> j3789769646;
	j74151309 [label="Una vez más, intento no reírme de la idea de que alguna vez pueda acercarme al concepto de \"estar bien\". Pero aprecio mucho tu opinión, Viajero.",shape=box,color=blue];
		j74151309 -> j833720367;
	j3004946073 [label="Intento no reírme de la idea de que alguna vez pueda acercarme al concepto de \"estar bien\". Pero aprecio mucho tu opinión, Viajero.",shape=box,color=blue];
		j3004946073 -> j833720367;
	j3030088796 [label="+5 Chemistry",color=orange];
		j3030088796 -> j1869699103;
	j2612121962 [label="Si la capacidad de curar mi compulsión de hacerme daño estaba a mi alcance antes de inyectarme el suero, creo que al unirme al warframe \"Harrow\" se ha vuelto completamente imposible.",shape=box,color=blue];
		j2612121962 -> j2416395672;
	j2571147305 [label="Debemos recordarnos cómo encontrar la fuerza para ayudar a otro a ponerse de pie, incluso cuando no podemos encontrar la voluntad para hacerlo nosotros.",shape=box,color=blue];
		j2571147305 -> j1038518273;
	j3789769646 [label="Hay tres cosas que podría hacer, si me lo permitieras, a la luz de tu confesión.",shape=box,color=blue];
		j3789769646 -> j1363968716;
	j833720367 [label="+5 Chemistry",color=orange];
		j833720367 -> j1991288112;
		j833720367 -> j328281608;
	j1869699103 [label="Pero no pretendo ser tan frívolo con lo que considero una expresión de preocupación por mi bienestar físico y mental, perdóname. Simplemente no creo que esté dentro de mis posibilidades dejar de hacerlo.",shape=box,color=blue];
		j1869699103 -> j1991288112;
		j1869699103 -> j328281608;
	j2416395672 [label="Si me permites ser directo, Viajero, no creo que sea capaz de causarme a mí mismo ningún daño real y permanente de esa manera.",shape=box,color=blue];
		j2416395672 -> j1984249476;
	j1038518273 [label="Ese es el verdadero propósito de la historia.",shape=box,color=blue];
		j1038518273 -> j3476898260;
	j1363968716 [label="Primero, te aseguro que no corro ningún peligro. Si crees que hay un profundo y terrible autodesprecio que impulsa mi deseo de hacerme daño, estaría dispuesto a disipar esos temores.",shape=box,color=blue];
		j1363968716 -> j1489424496;
	j1991288112 [label="¿Puedo preguntar por qué lo haces?",shape=box,color=red];
		j1991288112 -> j3106172300;
	j328281608 [label="Sólo me preocupa que vayas demasiado lejos.",shape=box,color=red];
		j328281608 -> j2416395672;
	j1984249476 [label="Si bien no soy capaz de la arrogancia necesaria para creerme inmune, tal acto parece... digamos... parte del plan.",shape=box,color=blue];
		j1984249476 -> j3521196206;
	j3476898260 [label="+20 Chemistry",color=orange];
		j3476898260 -> j3152219453;
	j1489424496 [label="Aunque... conozco esa gran melancolía, no inspira mi incensario. (Marie jamás lo permitiría, por ejemplo. Ella probablemente tomaría mi lugar antes de permitirme acercarme a uno de nuevo).",shape=box,color=blue];
		j1489424496 -> j2509544266;
	j3106172300 [label="Evaluate expressions",color=orange];
		j3106172300 -> j4220333375 [label="LyonBackstory3a, LyonLecture2",color=purple];
		j3106172300 -> j4220333375 [label="LyonBackstory3b, LyonLecture2",color=purple];
		j3106172300 -> j2483723884 [label="LyonBackstory3a",color=purple];
		j3106172300 -> j2483723884 [label="LyonBackstory3b",color=purple];
		j3106172300 -> j3183367550 [label="false",color=purple];
	j3521196206 [label="+5 Chemistry",color=orange];
		j3521196206 -> j3359877899;
	j3152219453 [label="Que estés bien, Viajero. Hablamos pronto.",shape=box,color=blue];
		j3152219453 -> j1683210245;
	j2509544266 [label="Pero dolores tan profundos nunca me han susurrado en la noche, amigo mío. Lo juro. Te lo prometo, por todo lo que aprecio.",shape=box,color=blue];
		j2509544266 -> j2243655674;
	j4220333375 [label="Te he dicho la verdad sobre lo que me inspira a hacerlo: el dolor despeja mi mente de las visiones que me atormentan. Y esta práctica no es tan vergonzosa entre los Hermanos de Lua como podría serlo en tu cultura. Te juro por todo lo que aprecio que no estoy ocultando ningún secreto.",shape=box,color=blue];
		j4220333375 -> j1424419454;
	j2483723884 [label="Ese es un tema complejo, ya que las razones por las que me lastimo no son únicas. Te he contado sobre las visiones que me atormentan, y que el dolor me despeja la mente. Pero el acto en sí no es tan tabú como podrías creer.",shape=box,color=blue];
		j2483723884 -> j655342765;
	j3183367550 [label="Es un tema complicado, ya que las razones por las que me lastimé no son únicas. Debo empezar diciendo que el asunto no es tan tabú como podría parecerles hoy en día.",shape=box,color=blue];
		j3183367550 -> j655342765;
	j3359877899 [label="No creo que lo que hago sea \"correcto\". No creo que lo que hago deba ser practicado por otros. No creo que lo que hago sea envidiable.",shape=box,color=blue];
		j3359877899 -> j91572608;
	j1683210245 [label="Padre Lyon Allard",shape=box,color=blue];
		j1683210245 -> j3787621160;
	j2243655674 [label="En segundo lugar, debo felicitarte por tu valentía al enviarme estas palabras. Habría sido más fácil evitarlas. No lo hiciste.",shape=box,color=blue];
		j2243655674 -> j3819917114;
	j1424419454 [label="Si crees que tengo un profundo y terrible odio hacia mí mismo que impulsa mi deseo de hacerme daño, me gustaría mucho decirte que no es así.",shape=box,color=blue];
		j1424419454 -> j2261272838;
	j655342765 [label="Entre los Hermanos de Lua, existe una antigua práctica de flagelación. Es poco común, e incluso en mi época se consideraba arcaica y la utilizaban quienes eran \"bendecidos por sus visiones\".",shape=box,color=blue];
		j655342765 -> j1940124819;
	j91572608 [label="Sin embargo, en mi estado increíblemente único y bastante \"sobrenatural\" en el sentido más literal de la palabra, tampoco es estrictamente peligroso para mí.",shape=box,color=blue];
		j91572608 -> j3437702546;
	j3787621160 [label="Boolean LyonSpeech is now true.",color=orange];
		j3787621160 -> "Chat ends.";
	j3819917114 [label="En tercer lugar, no comprendo ni comprenderé jamás el contexto de lo que sufrió tu compañero. Y, en cierto modo, nadie más que él lo comprenderá jamás.",shape=box,color=blue];
		j3819917114 -> j2168291746;
	j2261272838 [label="Aunque... conozco esa gran melancolía, no inspira mi incensario. Marie jamás lo permitiría, por ejemplo.",shape=box,color=blue];
		j2261272838 -> j1956864042;
	j1940124819 [label="Uno de los padres de la Catedral me lo enseñó, no mucho después de mi llegada, cuando vio que yo era igualmente... \"bendecido\", y creyó conveniente ayudarme. ",shape=box,color=blue];
		j1940124819 -> j2632916461;
	j3437702546 [label="De hecho, a menudo me he preguntado si no existiría algún milagro de la ciencia moderna que pudiera ayudarme con mis aflicciones. Si estuviera en condiciones de aceptar tal ayuda, lo haría. Dudo que mi fisiología me lo permitiera ahora.",shape=box,color=blue];
		j3437702546 -> j1431352780;
	j2168291746 [label="Sufrir de una manera tan absorbente es, por definición, algo solitario.",shape=box,color=blue];
		j2168291746 -> j968479737;
	j1956864042 [label="Boolean LyonSNo is now true.",color=orange];
		j1956864042 -> j1936634345;
		j1956864042 -> j3723861714;
		j1956864042 -> j2048518392;
	j2632916461 [label="Boolean LyonLecture2 is now true.",color=orange];
		j2632916461 -> j2048518392;
		j2632916461 -> j3723861714;
		j2632916461 -> j1936634345;
	j1431352780 [label="De todas formas, te aseguro que no moriré de esto. Es una carga que llevo conmigo desde niño. Y es un síntoma que he decidido que es mejor que la herida subyacente, si dejo la costra intacta.",shape=box,color=blue];
		j1431352780 -> j1511931022;
	j968479737 [label="Simplemente le ruego a mi dios, al tuyo y al de ellos, que no guardes culpa en tu corazón. Porque si algo en este mundo o en cualquier otro debe ser perdonado, es la bondad de saber que alguien ha sufrido tanto.",shape=box,color=blue];
		j968479737 -> j2167713234;
	j1936634345 [label="¿Y estás seguro de que nunca vas a... llegar demasiado lejos?",shape=box,color=red];
		j1936634345 -> j2416395672;
	j3723861714 [label="Me sorprende lo extrañas que pueden ser a veces las prácticas religiosas.",shape=box,color=red];
		j3723861714 -> j251585881;
	j2048518392 [label="Eso me hace sentir un poco mejor, supongo.",shape=box,color=red];
		j2048518392 -> j2416395672;
	j1511931022 [label="Check boolean LyonSNo",color=orange];
		j1511931022 -> j617814988 [label=true,color=green];
		j1511931022 -> j617916085 [label=false,color=brown];
	j2167713234 [label="+15 Chemistry",color=orange];
		j2167713234 -> j3000555929;
	j251585881 [label="No tengo motivos para discutir contigo. Me fascinan las diferencias en las ceremonias religiosas. Disfruto muchísimo estudiando toda la documentación sobre ellas.",shape=box,color=blue];
		j251585881 -> j4067570260;
	j617814988 [label="+10 Chemistry",color=orange];
		j617814988 -> j526992773;
	j617916085 [label="Si crees que tengo un profundo y terrible odio hacia mí mismo que impulsa mi deseo de hacerme daño, me gustaría mucho decirte que no es así.",shape=box,color=blue];
		j617916085 -> j160027864;
	j3000555929 [label="Que estés bien, Viajero. Hablamos pronto.",shape=box,color=blue];
		j3000555929 -> j2084492712;
	j4067570260 [label="La antropología religiosa es un tema muy cercano y querido para mí. Se puede aprender mucho de una sociedad y un pueblo estudiando sus rituales. ",shape=box,color=blue];
		j4067570260 -> j2313619806;
	j526992773 [label="Sin embargo, te prometo esto: si alguna vez realmente temo que llegue un momento en que ya no pueda confiar en mí mismo, te lo diré.",shape=box,color=blue];
		j526992773 -> j852235329;
	j160027864 [label="Aunque... conozco esa gran melancolía, no inspira mi incensario. Marie jamás lo permitiría, por ejemplo.",shape=box,color=blue];
		j160027864 -> j617814988;
	j2084492712 [label="Padre Lyon Allard",shape=box,color=blue];
		j2084492712 -> "Chat ends.";
	j2313619806 [label="Existe una secta Luminaria en el lejano y gélido norte que venera un cadáver que desenterraron de un glaciar. Estaba perfectamente conservado, y nadie sabe con certeza su antigüedad. Pero el disco de latón que llevaba alrededor del cuello tenía la imagen de un sol estampada.",shape=box,color=blue];
		j2313619806 -> j1549098867;
	j852235329 [label="A Marie, a ti, a M. Loid, incluso a Roathe, no importa. Lo diré. Lo juro.",shape=box,color=blue];
		j852235329 -> j3199530417;
		j852235329 -> j591528706;
	j1549098867 [label="Creen que el cuerpo momificado es el del mismísimo Sol. Y creen que algún día resucitará. Cada cien años, se preparan para la \"Gran Víspera\" y muchos de sus seguidores beben vino envenenado la noche anterior.",shape=box,color=blue];
		j1549098867 -> j3539654761;
	j3199530417 [label="Eso es todo lo que podría pedir. Gracias, Lyon.",shape=box,color=red];
		j3199530417 -> j1296717585;
	j591528706 [label="Confío en ti. Solo quería discutirlo contigo.",shape=box,color=red];
		j591528706 -> j1296717585;
	j3539654761 [label="No hace falta decir que, cuando su cuerpo momificado no ha regresado a la mañana siguiente, tienen una razón perfectamente válida para explicar por qué sus cálculos habían sido erróneos y la fecha se desplaza otro siglo más o menos.",shape=box,color=blue];
		j3539654761 -> j4232960862;
	j1296717585 [label="Y aprecio profundamente tu deseo de saber que no estoy actuando movido por algún impulso desenfrenado de destruirme a mí mismo.",shape=box,color=blue];
		j1296717585 -> j1545895185;
	j4232960862 [label="Pero me he desviado bastante del tema.",shape=box,color=blue];
		j4232960862 -> j3521196206;
	j1545895185 [label="No estoy acostumbrado a tener este tipo de compañeros en mi vida.",shape=box,color=blue];
		j1545895185 -> j3000555929;
}