		j95631369 -> j2102282974;
	j2211143052 [label="Ahora me encuentro rodeado de extraños y bestias parlantes en un mundo de locura fantástica y de matanza aparentemente interminable y desenfrenada.",shape=box,color=blue];
		j2211143052 -> j455151132;
	j982913826 [label="+20 Chemistry",color=orange];
		j982913826 -> j1282052417;
	j1398209508 [label="Aprecio tu facilidad para admitir una mentira. Y aprecio el hecho de que no soy... la persona más afable con la que te relacionas.",shape=box,color=blue];
		j1398209508 -> j2321902587;
	j4152073411 [label="Es un asunto personal, Viajero. Agradezco tu intento de conversar conmigo. Y aprecio el hecho de que no soy... la persona más afable con la que te relacionas.",shape=box,color=blue];
		j4152073411 -> j2321902587;
	j2102282974 [label="Boolean LyonFaithHeadache is now true.",color=orange];
		j2102282974 -> j3978143613;
	j455151132 [label="Todo lo que conocía ha sido arrasado por los brillantes rayos de la \"Luz de Jade\", \"el Imperio Orokin\" y \"el Vacío\", y se ve amenazado por \"el Murmullo\".",shape=box,color=blue];
		j455151132 -> j3646650489;
	j1282052417 [label="Como puedes ver, estoy completamente recuperado. Ahora debes preocuparte por ti mismo. Ve a buscar un lugar oscuro para recuperarte.",shape=box,color=blue];
		j1282052417 -> j221705282;
	j2321902587 [label="¿Puedo ser directo y preguntarte por qué intentas socializar conmigo?",shape=box,color=blue];
		j2321902587 -> j3371543900;
		j2321902587 -> j969779198;
		j2321902587 -> j369277503;
		j2321902587 -> j312636846;
	j3646650489 [label="Así que, me disculparás si esta oferta de... camaradería me parece extrañamente ridícula por su ingenuidad. No te conozco ni confío en ti. De hecho, lo único que se es lo que otros me han dicho.",shape=box,color=blue];
		j3646650489 -> j740545619;
	j221705282 [label="¡Vete, Viajero! Antes de que te encuentre y te obligue a descansar. Y a ninguno de nosotros nos gustará eso.",shape=box,color=blue];
		j221705282 -> j4254387752;
		j221705282 -> j2973896890;
	j3371543900 [label="Sinceramente, desde que nos conocimos no he podido dejar de pensar en ti.",shape=box,color=red];
		j3371543900 -> j2905931503;
	j969779198 [label="Entrati los convirtió en protoframes y ahora están aquí, sin preparación, sin nada. Si puedo ayudarlos a adaptarse de alguna manera, quiero hacerlo.",shape=box,color=red];
		j969779198 -> j3978143613;
	j369277503 [label="Bueno... Me pareces fascinante. Quiero conocerte mejor.",shape=box,color=red];
		j369277503 -> j3978143613;
	j740545619 [label="Lo que otros a quienes ni conozco ni en quienes confío todavía me han dicho. Todo esto se nos viene encima, sin mencionar las cargas que no se ven.",shape=box,color=blue];
		j740545619 -> j396075398;
	j4254387752 [label="Está bien, está bien. Me voy.",shape=box,color=red];
		j4254387752 -> j894054493;
	j2973896890 [label="Bueno... puede que lo disfrute más de lo que piensas.",shape=box,color=red];
		j2973896890 -> j719613752;
	j2905931503 [label="+20 Chemistry",color=orange];
		j2905931503 -> j719613752;
	j396075398 [label="Agradezco tu amabilidad y te pido disculpas por mi falta de la misma. Sé lo que intentas hacer y te lo agradezco. Espero que, si llega el momento en que necesite tu ayuda, la oferta siga en pie.",shape=box,color=blue];
		j396075398 -> j641910507;
		j396075398 -> j3678203079;
