		j1464580814 -> j3699648562;
	j232900247 [label="¿Eso por qué?",shape=box,color=red];
		j232900247 -> j602418384;
	j1656970729 [label="Ella dijo que no estabas bien solo porque estaba preocupada por ti.",shape=box,color=red];
		j1656970729 -> j779403792;
	j3699648562 [label="Surgió de pasada. Ella no me pidió que revisara como estabas.",shape=box,color=red];
		j3699648562 -> j779403792;
	j3818964242 [label="Estoy bien, muchas gracias por preguntar. ¿Cómo estás?",shape=box,color=blue];
		j3818964242 -> j9112577;
	j602418384 [label="Probablemente no te sorprenda que prefiera que mis asuntos permanezcan privados.",shape=box,color=blue];
		j602418384 -> j3793588528;
	j779403792 [label="Por supuesto. Marie curaría al mundo con todos los rayos del Sol si pudiera. Pero probablemente no te sorprenda que prefiera que mis asuntos permanezcan en privado.",shape=box,color=blue];
