	j737790733 [label="Estoy bien. Solo quería saber cómo estabas, me enteré de que ayer no te encontrabas bien.",shape=box,color=red];
		j737790733 -> j820777503;
	j2290580111 [label="Personalmente, estoy luchando contra una especie de hemicránea.",shape=box,color=red];
		j2290580111 -> j2100224615;
	j2078943810 [label="Personalmente, estoy lidiando con una leve migraña.",shape=box,color=red];
		j2078943810 -> j3381460688;
	j3209577531 [label="Personalmente, estoy lidiando con un pequeño dolor de cabeza.",shape=box,color=red];
		j3209577531 -> j1884211796;
	j312636846 [label="Por experiencia propia sé que a veces los momentos en que menos queremos aceptar la ayuda de los demás son precisamente los momentos en que más la necesitamos.",shape=box,color=red];
		j312636846 -> j2003869527;
	j1201008220 [label="Lo respeto. No insistiré si no quieres hablar. Pero estoy aquí para escucharte si quieres.",shape=box,color=red];
		j1201008220 -> j2003869527;
	j1694159750 [label="Ella insinuaba que tenías teorías sobre por qué te dan esos dolores de cabeza.",shape=box,color=red];
		j1694159750 -> j1524413049;
	j1253805724 [label="Marie cree que estás intentando cargar con todo esto tú solo. Quería que supieras que estoy aquí.",shape=box,color=red];
		j1253805724 -> j3978143613;
	j2506493648 [label="Marie cree que estás sufriendo innecesariamente por toda esta situación. Me preguntaba si podría ayudarte.",shape=box,color=red];
		j2506493648 -> j3978143613;
	j820777503 [label="Ah, ya veo. Me siento mucho mejor hoy, gracias por preguntar. Aunque no sé si disfruto mucho que Marie te haya contado sobre mi dolencia.",shape=box,color=blue];
		j820777503 -> j232900247;
		j820777503 -> j1656970729;
		j820777503 -> j3699648562;
	j2100224615 [label="Boolean LyonSuspicious is now true.",color=orange];
		j2100224615 -> j1529114933;
	j3381460688 [label="Imagino que esa es la palabra que se usa hoy en día para referirse a los fuertes dolores de cabeza que también padezco. No creo que mirar fijamente el brillo de este aparato ayude. Deberías ir a acostarte.",shape=box,color=blue];
		j3381460688 -> j2866545667;
		j3381460688 -> j3114377361;
		j3381460688 -> j3670304504;
	j1884211796 [label="Yo también sufro de eso. No me imagino que mirar fijamente el brillo de este aparato pueda ayudar. Deberías ir a acostarte.",shape=box,color=blue];
		j1884211796 -> j2866545667;
		j1884211796 -> j3114377361;
		j1884211796 -> j3670304504;
	j2003869527 [label="No digo que este sea el momento. Pero si llega ese momento, aquí estoy.",shape=box,color=red];
		j2003869527 -> j1517294788;
	j1524413049 [label="Y tales teorías, lamentablemente, han sido relegadas definitivamente al \"Vacío\".",shape=box,color=blue];
		j1524413049 -> j2544305581;
		j1524413049 -> j95631369;
	j3978143613 [label="Perdóname, Viajero, cuando digo esto:",shape=box,color=blue];
		j3978143613 -> j2211143052;
	j1529114933 [label="Mm. Yo también sufro de eso. No me imagino que mirar fijamente el brillo de este aparato pueda ayudar. Deberías ir a acostarte.",shape=box,color=blue];
		j1529114933 -> j2866545667;
		j1529114933 -> j3114377361;
		j1529114933 -> j3670304504;
	j2866545667 [label="Tienes razón. Iré. Solo quería ver cómo estabas primero.",shape=box,color=red];
		j2866545667 -> j982913826;
	j3114377361 [label="Me atrapaste. Es que no sé de qué otra manera... conectar contigo.",shape=box,color=red];
		j3114377361 -> j1398209508;
	j3670304504 [label="Estaré bien por un rato más. ¿Cuánto tiempo llevas sufriendo este tipo de dolores de cabeza?",shape=box,color=red];
		j3670304504 -> j4152073411;
	j1517294788 [label="Boolean LyonOffer is now true.",color=orange];
		j1517294788 -> j3978143613;
