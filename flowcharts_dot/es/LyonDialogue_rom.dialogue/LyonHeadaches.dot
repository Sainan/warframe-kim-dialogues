	"Chat ends." [color=orange];
	j1464580814 [label="Ya veo, esa debe ser la palabra de esta época para mis fuertes dolores de cabeza. Sí, los tenía. Hoy me siento mucho mejor, gracias por preguntar. Aunque no sé si disfruto mucho que Marie te haya contado sobre mi dolencia.",shape=box,color=blue];
		j1464580814 -> j232900247;
