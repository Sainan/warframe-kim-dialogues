	"Chat ends." [color=orange];
	j1700264553 [label="Mon miracle, yo... debo asegurarme de que entiendas algo antes de decirte mi siguiente anécdota. ",shape=box,color=blue];
		j1700264553 -> j338173525;
	j3901411230 [label="No me sorprende que Marie haya atrapado tu corazón en sus manos como a una mariposa. Ella es... algo especial.",shape=box,color=blue];
		j3901411230 -> j2183298434;
