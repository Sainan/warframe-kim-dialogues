		j1243665097 -> j915141294 [label="false",color=purple];
	j2448490406 [label="¿Cómo estás hoy, Lyon?",shape=box,color=red];
		j2448490406 -> j3689936431;
	j1051701303 [label="[Confesar sentimientos] ¿Lyon? Me preguntaba si podríamos hablar de algo.",shape=box,color=red];
		j1051701303 -> j2708204765;
	j202800200 [label="[Fin]",shape=box,color=red];
		j202800200 -> "Chat ends.";
	j338173525 [label="Es muy importante que pongas mucha atención a las siguientes palabras que mande. ¿Entiendes?",shape=box,color=blue];
		j338173525 -> j4268513366;
		j338173525 -> j1996769293;
	j2183298434 [label="Check boolean LyonHasDated",color=orange];
		j2183298434 -> j1277071208 [label=true,color=green];
		j2183298434 -> j1446912986 [label=true,color=green];
		j2183298434 -> j401782900 [label=true,color=green];
		j2183298434 -> j1446912986 [label=false,color=brown];
		j2183298434 -> j401782900 [label=false,color=brown];
	j1823806089 [label="Me alegra que haya alguien que encuentre la fuerza de pasar a través de las agujas de la personalidad de Roathe para ver lo roto que hay en su interior.",shape=box,color=blue];
		j1823806089 -> j1882781179;
	j915141294 [label="¿Puedo preguntarte lo que me temo pueda ser una pregunta algo delicada, amigo mío?",shape=box,color=blue];
		j915141294 -> j719708453;
		j915141294 -> j3469667581;
	j3689936431 [label="Qué pregunta tan maravillosamente bondadosa y encantadoramente mundana. No me la hacen a menudo.",shape=box,color=blue];
		j3689936431 -> j1909580841;
	j2708204765 [label="Sí, ¿qué es? ¿Pasa algo?",shape=box,color=blue];
		j2708204765 -> j2357751299;
		j2708204765 -> j790289601;
	j4268513366 [label="Me estás poniendo nervioso. ¿Pasa algo malo?",shape=box,color=red];
		j4268513366 -> j1265035637;
	j1996769293 [label="Sí, aquí estoy. Adelante.",shape=box,color=red];
		j1996769293 -> j228097918;
	j1277071208 [label="No sabía cómo te irías a sentir, dado que...",shape=box,color=red];
		j1277071208 -> j751092556;
	j1446912986 [label="Estoy un poco... asombrado por ella.",shape=box,color=red];
		j1446912986 -> j282369784;
	j401782900 [label="¿Esta es la conversación en la que acabarás amenazándome? ¿O qué?",shape=box,color=red];
		j401782900 -> j907115738;
	j1882781179 [label="Sé que, aunque lo niegue enérgicamente, él cree que es un cobarde. Yo no lo etiquetaría como tal.",shape=box,color=blue];
		j1882781179 -> j3672353905;
	j719708453 [label="Por supuesto, ya te lo he preguntado.",shape=box,color=red];
		j719708453 -> j1471463250;
	j3469667581 [label="¿Por qué estoy saliendo con Roathe?",shape=box,color=red];
		j3469667581 -> j903601633;
	j1909580841 [label="Estoy... bastante bien, gracias.",shape=box,color=blue];
		j1909580841 -> j3765543636;
	j2357751299 [label="No importa. Lo siento. La verdad, olvidé lo que iba a decir.",shape=box,color=red];
		j2357751299 -> j969683804;
	j790289601 [label="No sé cómo decirlo de la mejor manera, así que lo haré directamente... siento algo por ti.",shape=box,color=red];
		j790289601 -> j1949588422;
	j1265035637 [label="Nada malo... de hecho todo lo contrario. Eso es precisamente lo que es crucial que entiendas: las terribles consecuencias de las que deseo liberarte, si das por sentado que podrían sobrevenirte.",shape=box,color=blue];
		j1265035637 -> j828047204;
		j1265035637 -> j3311649397;
		j1265035637 -> j2028599143;
	j228097918 [label="+5 Chemistry",color=orange];
		j228097918 -> j1403708618;
	j751092556 [label="Ja. ¿Crees que me sorprende? Estoy en la sombra de su luz y siempre lo estaré. No, amigo mío... no estoy amargado ni celoso sobre esto, te lo juro.",shape=box,color=blue];
		j751092556 -> j1016617530;
	j282369784 [label="Como todos. Mi hermana del alma nunca deja de asombrarme. Estoy feliz por ustedes dos, más allá de lo que puedo expresar con palabras.",shape=box,color=blue];
		j282369784 -> j3872128029;
	j907115738 [label="¿Mm? No. No sería tan insolente como para andar por ahí pretendiendo ser su guardián. Ella es totalmente capaz de romperte los huesos si decide que no eres digno.",shape=box,color=blue];
		j907115738 -> j2902409627;
	j3672353905 [label="Entrati le dijo que él necesitaría salvar el futuro que desconocía. Uno en el cual no tenía autoridad, ni gente que se postrara a sus pies, ni sirvientes que lo adoraran.",shape=box,color=blue];
		j3672353905 -> j2630515755;
	j1471463250 [label="¿Qué es... lo que ves en Roathe que los ha llevado a ustedes dos a tener una... relación?",shape=box,color=blue];
		j1471463250 -> j1194113231;
		j1471463250 -> j171594272;
		j1471463250 -> j1677479005;
	j903601633 [label="Veo que ya has enfrentado dicha línea de cuestionamiento, o ya estabas esperándola. Sí, precisamente eso. ¿Qué... ves en él?",shape=box,color=blue];
		j903601633 -> j1194113231;
		j903601633 -> j171594272;
		j903601633 -> j1677479005;
	j3765543636 [label="+20 Chemistry",color=orange];
		j3765543636 -> j2782823492;
	j969683804 [label="Me pasa con frecuencia. A menudo cuando paso a través de las puertas. Frecuentemente me he preguntado el por qué.",shape=box,color=blue];
		j969683804 -> j3903338672;
	j1949588422 [label="Yo... tu estás... ¿Seguro? ¿Te encuentras bien? ¿No te has golpeado la cabeza recientemente, verdad?",shape=box,color=blue];
		j1949588422 -> j2732771462;
		j1949588422 -> j4032281000;
	j828047204 [label="Estoy escuchando.",shape=box,color=red];
		j828047204 -> j668181930;
	j3311649397 [label="No tiene mucho sentido lo que dices.",shape=box,color=red];
		j3311649397 -> j2281980798;
	j2028599143 [label="Las terribles consecuencias de... ¿qué?",shape=box,color=red];
		j2028599143 -> j918131254;
	j1403708618 [label="Gracias. Antes de comenzar quiero asegurarte de que no pasa nada malo... sin embargo, ahí residen quizás las terribles consecuencias de las que deseo liberarte, si das por sentado que podrían sobrevenirte.",shape=box,color=blue];
		j1403708618 -> j828047204;
		j1403708618 -> j3311649397;
		j1403708618 -> j2028599143;
	j1016617530 [label="No guardo resentimiento sobre lo que ha pasado entre nosotros, sólo puedo agradecer por el tiempo que pasamos juntos.",shape=box,color=blue];
		j1016617530 -> j675119677;
	j3872128029 [label="Hay tanta alegría en sus ojos cuando habla de ti. Se llena de emoción cada vez que cree que podrías pasar por aquí.",shape=box,color=blue];
		j3872128029 -> j3075710762;
	j2902409627 [label="Solo quería decirte que su felicidad es contagiosa, y me hace sonreír al pensarlo. Así que, por eso, también debo agradecerte.",shape=box,color=blue];
		j2902409627 -> j3700048672;
	j2630515755 [label="Puede que piense que es un acto de miedo, como una rata huyendo de un barco que se hunde... tomar el suero y olvidar las acciones que lo llevaron a ello. ",shape=box,color=blue];
		j2630515755 -> j313957555;
	j1194113231 [label="Para decirlo sin rodeos, ¿lo has visto?",shape=box,color=red];
		j1194113231 -> j3992408537;
	j171594272 [label="Creo que hay dolor en él, en algún lugar debajo de todo ese... humor y personalidad.",shape=box,color=red];
		j171594272 -> j935249145;
	j1677479005 [label="No puedo... evitarlo. Hay oscuridad y peligro en él y encuentro eso atractivo. Me atrae.",shape=box,color=red];
		j1677479005 -> j2986060709;
	j2782823492 [label="Sí, creo que hoy me encuentro bastante bien, de hecho.",shape=box,color=blue];
		j2782823492 -> j568884972;
	j3903338672 [label="+5 Chemistry",color=orange];
		j3903338672 -> j257022756;
	j2732771462 [label="¿Por qué es tan difícil de creer?",shape=box,color=red];
		j2732771462 -> j511628650;
	j4032281000 [label="Sí, Lyon. Y no tengo una contusión.",shape=box,color=red];
		j4032281000 -> j511628650;
	j668181930 [label="+5 Chemistry",color=orange];
		j668181930 -> j4263090076;
	j2281980798 [label="Sí. Estoy dolorosamente consciente de ello.",shape=box,color=blue];
		j2281980798 -> j918131254;
	j918131254 [label="Permíteme comenzar de nuevo.",shape=box,color=blue];
		j918131254 -> j4263090076;
	j675119677 [label="+10 Chemistry",color=orange];
		j675119677 -> j1079606387;
	j3075710762 [label="+10 Chemistry",color=orange];
		j3075710762 -> j2902409627;
	j3700048672 [label="Lyon",shape=box,color=blue];
		j3700048672 -> "Chat ends.";
	j313957555 [label="Lo veo como un hombre que vió el campo de batalla y supo cuando abandonar la nave ya perdida. Por una guerra que aún no había terminado.",shape=box,color=blue];
		j313957555 -> j1494212890;
	j3992408537 [label="Lejos de mí está el condenarte.",shape=box,color=blue];
		j3992408537 -> j461891861;
	j935249145 [label="+5 Chemistry",color=orange];
		j935249145 -> j930030524;
	j2986060709 [label="Puedo entender la atracción. No negaré que lo entiendo. Sin embargo, espero por tu bien que no dejes que te consuma.",shape=box,color=blue];
		j2986060709 -> j567900109;
	j568884972 [label="Que tengas un lindo día.\nLyon",shape=box,color=blue];
		j568884972 -> "Chat ends.";
	j257022756 [label="Que tengas un lindo día. Lyon",shape=box,color=blue];
		j257022756 -> "Chat ends.";
	j511628650 [label="Bueno, para ser sincero... cuando tienes tantas otras opciones ante ti... Marie o Roathe o... alguien más en el universo...",shape=box,color=blue];
		j511628650 -> j3304810909;
	j4263090076 [label="Soy consciente de que muchos pueden percibirme como… enfermo, y que en realidad, probablemente lo esté. Como mínimo, no estoy del todo cuerdo.",shape=box,color=blue];
		j4263090076 -> j162325511;
	j1079606387 [label="Ahora me alegra pasar tiempo con ella. Me trae alegría, donde yo solo puedo traer tristeza. Sé feliz con ella. Tienes todas mis bendiciones.",shape=box,color=blue];
		j1079606387 -> j3700048672;
	j1494212890 [label="Evaluate expressions",color=orange];
		j1494212890 -> j3841919144 [label="RoatheVillian",color=purple];
		j1494212890 -> j3918469032 [label="RoatheVillian",color=purple];
		j1494212890 -> j2151859088 [label="RoatheVillian",color=purple];
		j1494212890 -> j3841919144 [label="RoatheRedeemed",color=purple];
		j1494212890 -> j3918469032 [label="RoatheRedeemed",color=purple];
		j1494212890 -> j969094965 [label="RoatheRedeemed",color=purple];
		j1494212890 -> j2151859088 [label="RoatheRedeemed",color=purple];
		j1494212890 -> j3841919144 [label="false",color=purple];
		j1494212890 -> j3918469032 [label="false",color=purple];
	j461891861 [label="Aunque, por tu bien, espero que esta manía pase pronto y no se convierta en una adicción. He visto cosas así destruir a otros.",shape=box,color=blue];
		j461891861 -> j4027387164;
	j930030524 [label="Sí, lo he visto. Enterrado muy adentro. Pero puede que no le gusten tus intentos de andar husmeando. Creo que disfruta en lo que se ha convertido.",shape=box,color=blue];
		j930030524 -> j4027387164;
	j567900109 [label="Tales acuerdos deberían basarse en algo más que... simple oscuridad. Sin embargo, no debería sermonearte.",shape=box,color=blue];
		j567900109 -> j4027387164;
	j3304810909 [label="Me cuesta creer que decidas entretenerte con un vitral roto como lo soy yo... a menos que estés gravemente enfermo.",shape=box,color=blue];
		j3304810909 -> j2286788886;
		j3304810909 -> j1558032385;
	j162325511 [label="Hace tiempo que estoy en paz con esto. Ya no me preocupa. Las visiones que me atormentan, las voces... he encontrado la manera de vivir con ellas sin miedo ni odio.",shape=box,color=blue];
		j162325511 -> j1188945785;
	j3841919144 [label="Estoy feliz de estar aquí para él, de cualquier manera que pueda.",shape=box,color=red];
		j3841919144 -> j1041603918;
	j3918469032 [label="Lo que le pasó a él es... complicado. Creo que le va a llevar tiempo procesarlo.",shape=box,color=red];
		j3918469032 -> j1041603918;
	j2151859088 [label="Exacto. Lo hizo para ganar la guerra... y a veces eso significa perder algunas batallas.",shape=box,color=red];
		j2151859088 -> j1041603918;
	j969094965 [label="Se perdonará con el tiempo. Pero no creo que su exterior vaya realmente a cambiar.",shape=box,color=red];
		j969094965 -> j1041603918;
	j4027387164 [label="Conoces tu propia mente y sus limitantes. Les deseo lo mejor a ambos.",shape=box,color=blue];
		j4027387164 -> j752839209;
	j2286788886 [label="¿Lyon? Tengo sentimientos por ti. Me importas. Me gustaría estar contigo, si es que te gustaría estar conmigo.",shape=box,color=red];
		j2286788886 -> j3446246680;
	j1558032385 [label="Si estás diciendo que no es mutuo...",shape=box,color=red];
		j1558032385 -> j3691377107;
	j1188945785 [label="(Últimamente, creo que un poco por despecho, si soy sincero, pero no importa).",shape=box,color=blue];
		j1188945785 -> j3724764834;
	j1041603918 [label="+10 Chemistry",color=orange];
		j1041603918 -> j1338750298;
	j752839209 [label="+10 Chemistry",color=orange];
		j752839209 -> j3558964789;
	j3446246680 [label="Perdóname, por favor, perdóname... simplemente... pensé que era imposible, esto no es... algo que yo... hubiera podido imaginar...",shape=box,color=blue];
		j3446246680 -> j924386806;
	j3691377107 [label="¡No es eso! ¡No era lo que quería insinuar! Muy, muy lejos de eso, de hecho, simplemente... pensé que era algo imposible, esto es... algo que no... hubiera podido... imaginar...",shape=box,color=blue];
		j3691377107 -> j924386806;
	j3724764834 [label="Pero quiero que entiendas que si pusieras fin a lo que existe entre nosotros, a este vínculo que hasta ahora creía imposible entre yo y otra persona...",shape=box,color=blue];
		j3724764834 -> j1788284046;
	j1338750298 [label="A lo cual les deseo absolutamente la mejor de la suerte a ambos.",shape=box,color=blue];
		j1338750298 -> j3558964789;
	j3558964789 [label="Además, ahora parece que tiene una \"necesidad por algo\", ya ha dejado de entrar en conflicto con Marie.",shape=box,color=blue];
		j3558964789 -> j1277122509;
	j924386806 [label="+20 Chemistry",color=orange];
		j924386806 -> j2693582636;
	j1788284046 [label="¿Qué pasaría si alguna vez dejaras que tu corazón se alejara del mío? ",shape=box,color=blue];
		j1788284046 -> j2656474423;
	j1277122509 [label="Bueno. Al menos no tan frecuentemente. Adiós, por ahora.",shape=box,color=blue];
		j1277122509 -> j3311435967;
	j2693582636 [label="Eres realmente mon miracle...",shape=box,color=blue];
		j2693582636 -> j1374158912;
	j2656474423 [label="Resistiré, mon miracle.",shape=box,color=blue];
		j2656474423 -> j3814810891;
	j3311435967 [label="- Lyon",shape=box,color=blue];
		j3311435967 -> "Chat ends.";
	j1374158912 [label="Boolean LyonDating is now true.",color=orange];
		j1374158912 -> j4115967391;
	j3814810891 [label="No seré consumido por aquello que me ha plagado. ",shape=box,color=blue];
		j3814810891 -> j1697539566;
	j4115967391 [label="Boolean IsDating is now true.",color=orange];
		j4115967391 -> j3642226382;
	j1697539566 [label="Check boolean LyonAllRight",color=orange];
		j1697539566 -> j3780373777 [label=true,color=green];
		j1697539566 -> j3070495967 [label=false,color=brown];
	j3642226382 [label="Boolean LyonHasDated is now true.",color=orange];
		j3642226382 -> "Chat ends.";
	j3780373777 [label="Estaré, por usar tu coloquialismo, \"bien\". Encontraré motivos para sonreír y reír una vez más.",shape=box,color=blue];
		j3780373777 -> j3354112501;
		j3780373777 -> j82922714;
	j3070495967 [label="Sobreviviré. Estaré bien. Encontraré motivos para sonreír y reír una vez más.",shape=box,color=blue];
		j3070495967 -> j3354112501;
		j3070495967 -> j82922714;
	j3354112501 [label="Ah, Lyon... no eres una carga para mí.",shape=box,color=red];
		j3354112501 -> j4105298300;
	j82922714 [label="¿Estás diciendo que... quieres terminar las cosas entre nosotros?",shape=box,color=red];
		j82922714 -> j2711291108;
	j4105298300 [label="Simplemente estoy intentando liberarte de cualquier dificultad que puedas estar enfrentando por mi culpa...",shape=box,color=blue];
		j4105298300 -> j3983487490;
		j4105298300 -> j3561722943;
		j4105298300 -> j602320261;
	j2711291108 [label="¡No! ¡Para nada! Simplemente estoy intentando liberarte de cualquier dificultad que puedas estar enfrentando por mi culpa.",shape=box,color=blue];
		j2711291108 -> j3983487490;
		j2711291108 -> j3561722943;
		j2711291108 -> j602320261;
	j3983487490 [label="Tu dolor... se asemeja al mío. Nunca me costaría nada ayudarte a superarlo.",shape=box,color=red];
		j3983487490 -> j1282332697;
	j3561722943 [label="No sé cómo describir lo que me atrae de ti. Pero nunca serás un deber ni una carga.",shape=box,color=red];
		j3561722943 -> j1397213100;
	j602320261 [label="[Terminar la relación] Todo esto se ha vuelto demasiado para mí, lo siento. Quizás sea mejor terminar aquí.",shape=box,color=red];
		j602320261 -> j526748005;
	j1282332697 [label="No puedo expresar cuánto me duele el corazón por ti. Pero estoy eternamente agradecido de que nuestros solitarios fantasmas del dolor se hayan encontrado.",shape=box,color=blue];
		j1282332697 -> j4143746413;
	j1397213100 [label="Por eso no puedo expresar plenamente mi gratitud y no creo que las palabras puedan hacerle justicia.",shape=box,color=blue];
		j1397213100 -> j4143746413;
	j526748005 [label="Sí. Por supuesto. Sería... hipócrita aceptar otra respuesta en este momento... ",shape=box,color=blue];
		j526748005 -> j2424554967;
	j4143746413 [label="Pero ahora que me he tomado grandes molestias para repasar lo que ha sido un preámbulo espectacularmente autocomplaciente...",shape=box,color=blue];
		j4143746413 -> j2947813205;
		j4143746413 -> j2961676537;
		j4143746413 -> j143325070;
	j2424554967 [label="Lo entiendo perfectamente. Te deseo lo mejor. Y atesoraré todos los momentos que hemos pasado juntos.",shape=box,color=blue];
		j2424554967 -> j908445648;
	j2947813205 [label="Para alguien que empezó siendo silencioso, realmente te ha llegado el gusto por hablar.",shape=box,color=red];
		j2947813205 -> j3355407706;
	j2961676537 [label="Fue interesante, no te preocupes.",shape=box,color=red];
		j2961676537 -> j1984158521;
	j143325070 [label="Podrías haber dicho simplemente: \"¿Sabes? Estaré bien, aunque vayamos por caminos distintos\".",shape=box,color=red];
		j143325070 -> j103792573;
	j908445648 [label="Los guardaré en mi alma, aunque desaparezcan de mi memoria. Adiós.",shape=box,color=blue];
		j908445648 -> j3994460333;
	j3355407706 [label="+5 Chemistry",color=orange];
		j3355407706 -> j718502488;
	j1984158521 [label="+5 Chemistry",color=orange];
		j1984158521 -> j2345995810;
	j103792573 [label="+5 Chemistry",color=orange];
		j103792573 -> j1353357067;
	j3994460333 [label="Boolean LyonDating is now false.",color=orange];
		j3994460333 -> j4254443866;
	j718502488 [label="¡Bah! Si no quieres estar al tanto de lo que pasa en mi mente, no deberías de estar husmeando. Tú eres el único culpable.",shape=box,color=blue];
		j718502488 -> j770471868;
	j2345995810 [label="Me alegra que disfrutes de mis andanzas. Esto es precisamente por qué escogí no hablar tanto contigo. ¿Puedes imaginar tener que soportar esto en persona? Marie me habría acabado hace años como a un perro rabioso.",shape=box,color=blue];
		j2345995810 -> j770471868;
	j1353357067 [label="Hay una cierta cantidad de irreverencia y sarcasmo que naturalmente prevalece la cual yo jamás esperaría alcanzar. Te lo dejo a ti.",shape=box,color=blue];
		j1353357067 -> j770471868;
	j4254443866 [label="Boolean IsDating is now false.",color=orange];
		j4254443866 -> j3311435967;
	j770471868 [label="Aun así, todo esto sirvió como pretexto a una historia que ahora parece ser corta en comparación al resto...",shape=box,color=blue];
		j770471868 -> j1065436683;
	j1065436683 [label="Me desperté anoche por una pesadilla. Cuando lo hice, las sombras me estaban rodeando. Esto no es nada extraño o nuevo dado mi estado mental. Se acercaban sobre mi cama, y no se disipaban.",shape=box,color=blue];
		j1065436683 -> j2776075288;
	j2776075288 [label="No les tenía miedo, pues sabía que no podían lastimarme. Sin embargo, tampoco se iban de mi mente. Sabía que solo había una de la cual me tenía que deshacer.",shape=box,color=blue];
		j2776075288 -> j1222869710;
	j1222869710 [label="Me levanté de la cama, me vestí lo mejor que pude, tambaleándome por la visión borrosa de mi constante pesadilla. Agarré mi incensario y caí de rodillas en medio del piso, y me preparé para... bueno. ",shape=box,color=blue];
		j1222869710 -> j2725901284;
	j2725901284 [label="Me preparé para \"aclarar mi mente\". Dejémoslo así.",shape=box,color=blue];
		j2725901284 -> j2689025901;
	j2689025901 [label="Pero cerré mis ojos, mi mente divagaba. Mis pensamientos se dirigieron hacia... ti, mon miracle...",shape=box,color=blue];
		j2689025901 -> j2084326540;
	j2084326540 [label="El sonido de tu voz. El roce de tu mano sobre mi hombro... ",shape=box,color=blue];
		j2084326540 -> j3613272300;
	j3613272300 [label="Y las visiones... se fueron. Abandonaron su puesto, perseguidas por un extraño fantasma... que eras tú.",shape=box,color=blue];
		j3613272300 -> j2256120312;
	j2256120312 [label="Me... quedé parado. Puse mi incensario en la mesa de noche y... opté por caminar a través de la arena del santuario...",shape=box,color=blue];
		j2256120312 -> j1802410314;
		j2256120312 -> j403416528;
	j1802410314 [label="Ahora puedo entender el por qué sentiste la necesidad de un preámbulo.",shape=box,color=red];
		j1802410314 -> j1401420557;
	j403416528 [label="No sé qué decir...",shape=box,color=red];
		j403416528 -> j1831240829;
	j1401420557 [label="Sí. Bueno. Durante mi caminata... comprendí de inmediato el oscuro peligro de un momento así. Que podrías... llegar a verlo como una responsabilidad, a verme como cadenas que te agobian.",shape=box,color=blue];
		j1401420557 -> j3676068593;
	j1831240829 [label="+5 Chemistry",color=orange];
		j1831240829 -> j2766692890;
	j3676068593 [label="Ruego por ti... Rezo, a cualquier dios o dioses, superiores o inferiores... eso que nunca haces. Este es un regalo que me has dado, y cada vez que lo renueve lo atesoraré.",shape=box,color=blue];
		j3676068593 -> j555930844;
	j2766692890 [label="No hacen falta palabras, mon miracle... ",shape=box,color=blue];
		j2766692890 -> j1781037046;
	j555930844 [label="Júrame, mon miracle, que si llega el momento en que me convierta en una jaula vacía para ti... te liberarás de mí...",shape=box,color=blue];
		j555930844 -> j2996445145;
	j1781037046 [label="Durante mi caminata... comprendí de inmediato el oscuro peligro de un momento así. Que podrías... llegar a verlo como una responsabilidad, a verme como cadenas que te agobian.",shape=box,color=blue];
		j1781037046 -> j3676068593;
	j2996445145 [label="No seré una prisión vacía para quienes amo. Ni para ti. Ni para Marie.",shape=box,color=blue];
		j2996445145 -> j1453733076;
		j2996445145 -> j432506055;
	j1453733076 [label="[Terminar la relación] No... no puedo. No puedo prometer eso, lo siento.",shape=box,color=red];
		j1453733076 -> j3490581274;
	j432506055 [label="Te lo juro. ",shape=box,color=red];
		j432506055 -> j1392848439;
	j3490581274 [label="+10 Chemistry",color=orange];
		j3490581274 -> j763620609;
	j1392848439 [label="+10 Chemistry",color=orange];
		j1392848439 -> j3836817784;
	j763620609 [label="Gracias. Gracias, mon miracle, por tu honestidad. Esto requirió valentía en este momento y te felicito por ello.",shape=box,color=blue];
		j763620609 -> j4144842478;
	j3836817784 [label="Gracias. Gracias, mon miracle...",shape=box,color=blue];
		j3836817784 -> j4236602330;
	j4144842478 [label="Atesoraré todos los momentos que hemos pasado juntos. Más de lo que puedas imaginar.",shape=box,color=blue];
		j4144842478 -> j908445648;
	j4236602330 [label="De repente me siento muy cansado, como si... me hubieran quitado un gran peso de encima. Creo que debo recostarme.",shape=box,color=blue];
		j4236602330 -> j21916968;
	j21916968 [label="- Lyon",shape=box,color=blue];
		j21916968 -> j3446510588;
	j3446510588 [label="Boolean LyonDatingConfession is now true.",color=orange];
		j3446510588 -> "Chat ends.";
