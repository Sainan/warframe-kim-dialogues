	j1316396836 [label="Check boolean LyonPolyamorySuccess",color=orange];
		j1316396836 -> j1181132753 [label=true,color=green];
		j1316396836 -> "Chat ends." [label=false,color=brown];
	j3024028920 [label="Me gustaría, si se me permite, comentar brevemente algo que creo que nos tranquilizará a ambos, mon miracle.",shape=box,color=blue];
		j3024028920 -> j1227094533;
		j3024028920 -> j2202510826;
	j1227094533 [label="[Fin.]",shape=box,color=red];
		j1227094533 -> j3944516755;
	j2202510826 [label="¿Pasa algo malo, Lyon?",shape=box,color=red];
		j2202510826 -> j3529451489;
	j3944516755 [label="Boolean LyonConsentComplete is now true.",color=orange];
		j3944516755 -> "Chat ends.";
	j3529451489 [label="No, no pasa nada. Sólo quería decirte que sé que pasas tiempo con otra persona de forma... amorosa, cuando no estás conmigo.",shape=box,color=blue];
		j3529451489 -> j2244808960;
	j2244808960 [label="Y simplemente quería asegurarte que esto no me preocupa ni me inquieta. Tu presencia en mi vida me ha traído paz, alegría...",shape=box,color=blue];
		j2244808960 -> j547921120;
	j547921120 [label="¿Y cómo podría negarle a alguien más un regalo así?",shape=box,color=blue];
		j547921120 -> j2512217622;
		j547921120 -> j547483508;
	j2512217622 [label="Creo que esa persona te adoraría, debo decir.",shape=box,color=red];
		j2512217622 -> j3843532043;
	j547483508 [label="Gracias. Eso significa mucho para mí.",shape=box,color=red];
		j547483508 -> j1143854344;
	j3843532043 [label="Pensarlo me hace sonreír. Y quién sabe, quizá en otra vida, o en otro día, nos encontremos. ",shape=box,color=blue];
		j3843532043 -> j534917355;
	j1143854344 [label="Tal como somos, tal como soy, con todo lo que me has traído, con todo lo que representamos... estoy contento. No, soy... feliz. Por primera vez en muchísimo tiempo.",shape=box,color=blue];
		j1143854344 -> j2157888640;
	j534917355 [label="Pero en este caso, estoy contento con lo que somos. No, soy... feliz. Por primera vez en muchísimo tiempo.",shape=box,color=blue];
		j534917355 -> j2157888640;
	j2157888640 [label="Y te lo agradezco. Por ahora, sin embargo, me despido.",shape=box,color=blue];
		j2157888640 -> j1695334888;
	j1695334888 [label="Lyon",shape=box,color=blue];
		j1695334888 -> j3944516755;
