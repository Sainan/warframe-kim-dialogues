digraph {
	graph [fontname="Roboto Condensed"];
	node [fontname="Roboto Condensed"];
	edge [fontname="Roboto Condensed"];

	"LyonRank4Convo5 begins." [color=orange];
		"LyonRank4Convo5 begins." -> j3425926750;
	j3425926750 [label="Check boolean LyonSerum1",color=orange];
		j3425926750 -> j4231608802 [label=true,color=green];
		j3425926750 -> j202800200 [label=true,color=green];
		j3425926750 -> j1230157643 [label=false,color=brown];
		j3425926750 -> j202800200 [label=false,color=brown];
	j4231608802 [label="Lyon, me preguntaba si podría escuchar el resto de la historia de cómo Roathe llegó a la Catedral contigo y Marie.",shape=box,color=red];
		j4231608802 -> j1789065210;
	j202800200 [label="[Fin]",shape=box,color=red];
		j202800200 -> "Chat ends.";
	j1230157643 [label="Lyon, me preguntaba si podría escuchar la historia de cómo Roathe llegó a la Catedral contigo y Marie.",shape=box,color=red];
		j1230157643 -> j3782760325;
	j1789065210 [label="Como desees. Sin embargo, no es una historia muy agradable. Lo dejaron en nuestra puerta como un gato salvaje herido.",shape=box,color=blue];
		j1789065210 -> j3769319211;
	"Chat ends." [color=orange];
	j3782760325 [label="Como desees. Lo abandonaron en nuestra puerta como un gato salvaje herido. La historia no es precisamente agradable.",shape=box,color=blue];
		j3782760325 -> j3769319211;
	j3769319211 [label="Evaluate expressions",color=orange];
		j3769319211 -> j863395097 [label="LyonStray",color=purple];
		j3769319211 -> j747720932 [label="RoatheSerum1",color=purple];
		j3769319211 -> j3103954853 [label="false",color=purple];
	j863395097 [label="Tenía razón, esa historia se trataba sobre Roathe.",shape=box,color=red];
		j863395097 -> j2592631530;
	j747720932 [label="Según él, tenía todos los motivos para ser un poco... salvaje cuando apareció.",shape=box,color=red];
		j747720932 -> j2127385065;
	j3103954853 [label="Está bien, continúa.",shape=box,color=red];
		j3103954853 -> j2266356665;
	j2592631530 [label="Era una historia sobre un gato callejero que solía visitar la Catedral. Lo que tú entiendas de su significado, o el motivo por el que se la cuento, es enteramente tu responsabilidad. Soy sacerdote, ¿no?",shape=box,color=blue];
		j2592631530 -> j2266356665;
	j2127385065 [label="Se esperaría que alguien de tu estatus y disposición se sintiera perjudicado por las acciones que Entrati tomó en su contra. Sinceramente, me sorprendería mucho más si lo manejaras con amabilidad.",shape=box,color=blue];
		j2127385065 -> j2266356665;
	j2266356665 [label="Evaluate expressions",color=orange];
		j2266356665 -> j3581656208 [label="LyonSerum1",color=purple];
		j2266356665 -> j1248750901 [label="false",color=purple];
	j3581656208 [label="Creo que donde nos quedamos, Entrati había regresado recientemente de su desaparición con Roathe, tal como lo vemos ahora, ya transformado. Entrati nos reveló todas las mentiras que había dicho durante más de tres años.",shape=box,color=blue];
		j3581656208 -> j1528133490;
	j1248750901 [label="Intentaré resumir los acontecimientos que condujeron a ese momento, de lo contrario podría parecer... absurdo en el mejor de los casos.",shape=box,color=blue];
		j1248750901 -> j233192625;
	j1528133490 [label="Nos ofreció los \"sueros protoframe\" que nos convirtieron en lo que somos ahora, y una vez que los aceptamos... inmediatamente nos abandonó una vez más.",shape=box,color=blue];
		j1528133490 -> j1072152320;
	j233192625 [label="Durante tres años, dos meses y once días, sirvió como Cardinal Dimanche en nuestra catedral. Y durante todo ese tiempo, Marie y yo le servimos sin saber lo que planeaba para nosotros.",shape=box,color=blue];
		j233192625 -> j2185010052;
	j1072152320 [label="Y allí permanecimos, como amalgamas huérfanas, con cuerpos y almas rehechos en creaciones que apenas podíamos comprender y mucho menos reclamar como propias.",shape=box,color=blue];
		j1072152320 -> j369080249;
	j2185010052 [label="Conozco tus preguntas antes de que las hagas. ¿Qué tramaba? ¿Infectó la ciudad, como dicen que hizo con Höllvania? ¿Cuáles eran sus planes? ¿Sus descubrimientos?",shape=box,color=blue];
		j2185010052 -> j2638601202;
	j369080249 [label="Atrapados en una ciudad que era nuestro hogar, pero que ya no era amigable con nosotros. Nos vimos obligados a... escondernos.",shape=box,color=blue];
		j369080249 -> j1625298529;
		j369080249 -> j1007437871;
	j2638601202 [label="Les diré que se decepcionarán. Él predicó. Estudió. Descansó. Y oró. Entonces, una noche, desapareció en medio de una terrible tormenta. La misma en la que apareció.",shape=box,color=blue];
		j2638601202 -> j2575044127;
	j1625298529 [label="¿Por tu apariencia?",shape=box,color=red];
		j1625298529 -> j1539157815;
	j1007437871 [label="¿La Catedral los rechazó?",shape=box,color=red];
		j1007437871 -> j1812024125;
	j2575044127 [label="Check boolean MarieLyonVisions",color=orange];
		j2575044127 -> j3028501315 [label=true,color=green];
		j2575044127 -> j3794885750 [label=false,color=brown];
	j1539157815 [label="No sé si lo has notado, pero Marie puede volar y Roathe es... azul, entre otros problemas.",shape=box,color=blue];
		j1539157815 -> j3214452543;
	j1812024125 [label="No... precisamente. Nos obligaron a abandonar la vida pública. Pero nuestros hermanos y hermanas no nos exiliaron a las calles ni nos quemaron en la hoguera. \"Cardinal Dimanche\" los convenció de que nuestros cambios eran... obra de las Luminarias.",shape=box,color=blue];
		j1812024125 -> j2316104928;
	j3028501315 [label="Aunque soy muy consciente de que los demás no vieron la tormenta, a mí me pareció muy vívida.",shape=box,color=blue];
		j3028501315 -> j3794885750;
	j3794885750 [label="Un año después, reapareció una última vez, con... Roathe, tal como lo ves ahora, desplomado e inconsciente a sus pies.",shape=box,color=blue];
		j3794885750 -> j3917013835;
	j3214452543 [label="Sé que pasas tus días conviviendo con animales parlantes y calaveras y reflexionando sobre la cuestión del Vacío cósmico, pero eso no es algo común para la mayoría de los humanos.",shape=box,color=blue];
		j3214452543 -> j603396333;
	j2316104928 [label="Nos escondieron en las criptas y nos mantuvieron fuera de la vista. Nuestros antiguos hermanos, aunque nos tenían miedo, nos traían provisiones.",shape=box,color=blue];
		j2316104928 -> j3810442599;
	j3917013835 [label="Un demonio en carne y hueso, o eso parecía. Fue entonces cuando Entrati nos reveló la verdad sobre quién era, de donde venía y la verdadera tarea que tenía para nosotros\". Que nos había elegido para su más \"sagrada misión\".",shape=box,color=blue];
		j3917013835 -> j3304747684;
	j603396333 [label="De hecho, entre los tres, soy yo quien podría tal vez vagar entre la multitud si me cubriera lo suficientemente bien. ",shape=box,color=blue];
		j603396333 -> j2463927870;
		j603396333 -> j2477748550;
	j3810442599 [label="Ellos... insistían en interactuar sólo con Marie, a pesar de sus abruptas apariciones fantasmales en las escaleras para saludarlos. ",shape=box,color=blue];
		j3810442599 -> j1227630843;
		j3810442599 -> j3735139000;
	j3304747684 [label="Marie aceptó el suero de buena gana. Claro que sí. ¿Cómo no iba a hacerlo? ¿Y cómo no iba yo a seguirla? ¿Cómo no iba a buscar la verdad, adondequiera que me llevara?",shape=box,color=blue];
		j3304747684 -> j249472217;
	j2463927870 [label="¿Dónde te quedaste?",shape=box,color=red];
		j2463927870 -> j548646979;
	j2477748550 [label="¿Cómo llegaron todos aquí?",shape=box,color=red];
		j2477748550 -> j635194162;
	j1227630843 [label="Puedo entender que evitaran a Roathe, pero... ¿preferían eso a hablar contigo?",shape=box,color=red];
		j1227630843 -> j2365700794;
	j3735139000 [label="Ella es muy dulce...",shape=box,color=red];
		j3735139000 -> j3211903046;
	j249472217 [label="Boolean LyonSerum1 is now true.",color=orange];
		j249472217 -> j3384930507;
		j249472217 -> j421425298;
		j249472217 -> j2634450455;
	j548646979 [label="Nuestros hermanos y hermanas no nos exiliaron a las calles ni nos quemaron en la hoguera. \"Cardinal Dimanche\" los convenció de que nuestros cambios eran... obra de las Luminarias.",shape=box,color=blue];
		j548646979 -> j1381139196;
	j635194162 [label="Roathe sabrá los detalles exactos de \"cómo\", pero después de... muchos años de trabajo, creó un \"Helminto\" a partir de muestras de nuestra sangre.",shape=box,color=blue];
		j635194162 -> j1173507301;
	j2365700794 [label="Creo que ya nos conocemos, ¿no es así?",shape=box,color=blue];
		j2365700794 -> j2772673124;
	j3211903046 [label="Precisamente.",shape=box,color=blue];
		j3211903046 -> j4102029113;
	j3384930507 [label="Creo que ella todavía adora demasiado a Entrati.",shape=box,color=red];
		j3384930507 -> j633686302;
	j421425298 [label="¿Qué pasó después?",shape=box,color=red];
		j421425298 -> j1621211797;
	j2634450455 [label="¿Te arrepientes?",shape=box,color=red];
		j2634450455 -> j2106695702;
	j1381139196 [label="Nos escondieron en las criptas y nos mantuvieron fuera de la vista. Nuestros antiguos hermanos, aunque nos tenían miedo, nos traían provisiones.",shape=box,color=blue];
		j1381139196 -> j352363441;
	j1173507301 [label="Creo que la Infestación está conectada a sí misma a través del... tiempo... de alguna manera... aunque los detalles se me escapan.",shape=box,color=blue];
		j1173507301 -> j3513259799;
		j1173507301 -> j448909221;
	j2772673124 [label="¿Cuánto tiempo estuvieron atrapados allí abajo?",shape=box,color=red];
		j2772673124 -> j812991267;
	j4102029113 [label="Entonces... ¿los mantuvieron a todos en el sótano?",shape=box,color=red];
		j4102029113 -> j918969940;
	j633686302 [label="Boolean LyonMarieEntrati is now true.",color=orange];
		j633686302 -> j169284774;
	j1621211797 [label="Roathe despertó. Al principio, apenas recordaba su nombre. Entrati le dijo una frase de despedida al bastardo. \"Uriel, Hereje de Xata, en destierro, responde: ¿podrán los orokin ser perdonados alguna vez?\"",shape=box,color=blue];
		j1621211797 -> j3243785607;
	j2106695702 [label="Me arrepiento de todo, Viajero. Sí, claro que sí. ¿Pero lo volvería a hacer? Sí, claro que sí. No puedo dejar sola a Marie.",shape=box,color=blue];
		j2106695702 -> j3158505934;
	j352363441 [label="Ellos... insistían en interactuar sólo con Marie, a pesar de sus abruptas apariciones fantasmales en las escaleras para saludarlos. ",shape=box,color=blue];
		j352363441 -> j1987235671;
		j352363441 -> j1558183346;
	j3513259799 [label="¿Creó un Helminto con ingeniería reversa? ¿Cuánto se tardó?",shape=box,color=red];
		j3513259799 -> j623369343;
	j448909221 [label="No creo que nadie lo entienda. Es un nuevo descubrimiento.",shape=box,color=red];
		j448909221 -> j1937889483;
	j812991267 [label="Quizás no sea yo a quien deberías preguntar sobre cuántos años pasaron desde que nos convertimos en amalgamas infestadas parlantes. Mi comprensión del paso del tiempo desde entonces ha sido... confusa.",shape=box,color=blue];
		j812991267 -> j4106105536;
		j812991267 -> j1397899440;
	j918969940 [label="Quizás suene más duro de lo que parece. No había otro lugar donde ponernos. El campanario estaba demasiado abierto, demasiado expuesto a las inclemencias del tiempo. La cripta estaba resguardada y era cálida.",shape=box,color=blue];
		j918969940 -> j2344039976;
	j169284774 [label="En esto estamos de acuerdo. Pero tampoco puedo culparla por ello. Dale tiempo. Lo entenderá. Es muy inteligente, Viajero. No la trates como una tonta.",shape=box,color=blue];
		j169284774 -> j3158505934;
	j3243785607 [label="Entrati partió entonces por última vez. Y abandonó a Roathe con nosotros, ahora transformado en lo que ven ahora, más capaz de enfrentarse al temperamental diablo.",shape=box,color=blue];
		j3243785607 -> j1072152320;
	j3158505934 [label="Para continuar el relato... Entrati partió entonces por última vez. Y abandonó a Roathe con nosotros, recién transformados en lo que ves ahora, más capaces de enfrentarnos al temperamental diablo.",shape=box,color=blue];
		j3158505934 -> j1072152320;
	j1987235671 [label="Puedo entender que evitaran a Roathe, pero... ¿preferían eso a hablar contigo?",shape=box,color=red];
		j1987235671 -> j3306216103;
	j1558183346 [label="Ella es muy dulce...",shape=box,color=red];
		j1558183346 -> j1035594408;
	j623369343 [label="Boolean LyonRoatheHelminth is now true.",color=orange];
		j623369343 -> j244669316;
	j1937889483 [label="No sé si es reconfortante o desalentador saberlo, gracias. Es bastante extraño saberlo ahora que la Infestación puede hablar.",shape=box,color=blue];
		j1937889483 -> j103047279;
		j1937889483 -> j1155290938;
	j4106105536 [label="¿Confuso, cómo?",shape=box,color=red];
		j4106105536 -> j2875954389;
	j1397899440 [label="No sé si debería decirte que la Infestación también puede hablar...",shape=box,color=red];
		j1397899440 -> j3929330146;
	j2344039976 [label="Y, desafortunadamente, descubrimos que tenía salidas que Roathe podía usar para... vagar.",shape=box,color=blue];
		j2344039976 -> j845860967;
	j3306216103 [label="Creo que ya nos conocemos, ¿no es así?",shape=box,color=blue];
		j3306216103 -> j2772673124;
		j3306216103 -> j4102029113;
	j1035594408 [label="Precisamente.",shape=box,color=blue];
		j1035594408 -> j4102029113;
		j1035594408 -> j2772673124;
	j244669316 [label="Quizás no sea yo a quien deberías preguntar. Mi comprensión del paso del tiempo desde entonces se ha vuelto... confusa. Aunque quizá sea más preciso decir \"más confusa\". Como si esto no pudiera ser más aterrador...",shape=box,color=blue];
		j244669316 -> j4106105536;
		j244669316 -> j1397899440;
	j103047279 [label="No todos los objetos de la casa. Las sillas a veces pueden ser... bueno... no importa, sigue.",shape=box,color=red];
		j103047279 -> j2140365563;
	j1155290938 [label="No te contaré sobre la guitarra.",shape=box,color=red];
		j1155290938 -> j697849306;
	j2875954389 [label="Boolean LyonTime1 is now true.",color=orange];
		j2875954389 -> j4065697136;
	j3929330146 [label="Créeme, lo sé. Y es desconcertante, gracias. Aunque parece que cualquier objeto doméstico de este lugar habla.",shape=box,color=blue];
		j3929330146 -> j103047279;
		j3929330146 -> j1155290938;
	j845860967 [label="Evaluate expressions",color=orange];
		j845860967 -> j2967434945 [label="MarieRoathePastry1",color=purple];
		j845860967 -> j2967434945 [label="RoatheMariePastry1",color=purple];
		j845860967 -> j2318518160 [label="false",color=purple];
	j2140365563 [label="Si la palabra que ibas a decir era \"ocupado\", yo también lo he visto, Viajero. Ese que susurró. El que está dentro del muro. Oí el tap, tap ...",shape=box,color=blue];
		j2140365563 -> j3316184018;
	j697849306 [label="Por favor. Aunque creo que me resultaría mucho más reconfortante que un instrumento musical fuera un semidiós que... cualquier otra cosa que me ha atormentado y abandonado. ¿Es extraño que yo... desde que él...?",shape=box,color=blue];
		j697849306 -> j894796985;
	j4065697136 [label="No sé si es simplemente por mi sensibilidad única hacia el asunto, o debido a... las circunstancias individuales de mi creación o... a él...",shape=box,color=blue];
		j4065697136 -> j3114958384;
	j2967434945 [label="Eso he oído.",shape=box,color=red];
		j2967434945 -> j4008451296;
	j2318518160 [label="¿Oh?",shape=box,color=red];
		j2318518160 -> j85794401;
	j3316184018 [label="Hay una voz que me ha llamado la atención y que sé que no he escuchado en toda mi vida, pero que se extiende hasta mi pasado y hasta mi futuro...",shape=box,color=blue];
		j3316184018 -> j1728503791;
	j894796985 [label="¿Él?",shape=box,color=red];
		j894796985 -> j3316184018;
	j3114958384 [label="Y sé que pensarás que estoy loco cuando digo esto, pero no experimento el tiempo de una manera... puramente... lineal.",shape=box,color=blue];
		j3114958384 -> j2249721982;
		j3114958384 -> j433793938;
	j4008451296 [label="Creo que es una de sus pocas virtudes. No el robo, claro está. El razonamiento detrás. Mi teoría es que consiguió los bienes ilícitos para incitar a Marie a conversar con él.",shape=box,color=blue];
		j4008451296 -> j2644612865;
	j85794401 [label="No es una cosa, ni otra.",shape=box,color=blue];
		j85794401 -> j1883718845;
		j85794401 -> j1107171696;
	j1728503791 [label="No es posible que siempre haya estado ahí. Sin embargo, ahora lo recuerdo, tan claro como la luz plateada de Lua, tras el muro de la casa de mi infancia. La voz de un joven. La presencia de otro a su lado... \"Rap, tap, tap...\"",shape=box,color=blue];
		j1728503791 -> j796875472;
	j2249721982 [label="\"¿Él?\" ¿Quién es \"él\"?",shape=box,color=red];
		j2249721982 -> j3316184018;
	j433793938 [label="Experimenté el tiempo durante un número incalculable de siglos en forma de bucles, Lyon.",shape=box,color=red];
		j433793938 -> j803664080;
	j2644612865 [label="Y, quizás, porque la hacían sonreír, cuando creía que él no la veía. Una vez, me dijo: \"Es gran culpa del destino que la hayan privado tanto de la vida\".",shape=box,color=blue];
		j2644612865 -> j3733610902;
	j1883718845 [label="¿Cuánto tiempo les tomó a todos regresar a... bueno, ahora?",shape=box,color=red];
		j1883718845 -> j2283444852;
	j1107171696 [label="¿Qué pasó después?",shape=box,color=red];
		j1107171696 -> j635194162;
	j796875472 [label="Yo... perdóname. Debo irme. No puedo hablar de esto todavía. Lo... lo siento. No me vuelvas a preguntar sobre esto.",shape=box,color=blue];
		j796875472 -> j3996252780;
	j803664080 [label="¿Qué dices entonces, cuando hablo de una voz que me ha llamado más allá de mi propia mente racional? Sé que no la he escuchado toda mi vida. No es posible que siempre haya estado ahí.",shape=box,color=blue];
		j803664080 -> j3258773977;
	j3733610902 [label="Boolean LyonRoathePastry is now true.",color=orange];
		j3733610902 -> j971204568;
		j3733610902 -> j1883718845;
	j2283444852 [label="Quizás no sea yo a quien deberías preguntar sobre cuántos años pasaron desde que nos convertimos en amalgamas infestadas parlantes. Mi comprensión del paso del tiempo desde entonces ha sido... confusa.",shape=box,color=blue];
		j2283444852 -> j1397899440;
		j2283444852 -> j4106105536;
	j3996252780 [label="Lyon, ¡espera!",shape=box,color=red];
		j3996252780 -> j777162605;
	j3258773977 [label="Sin embargo, ahora lo recuerdo, tan claro como la luz plateada de Lua, tras el muro de mi casa de la infancia. La voz de un joven... \"Rap, tap, tap...\"",shape=box,color=blue];
		j3258773977 -> j796875472;
	j971204568 [label="Eso casi resulta adorable para él, tienes razón. ¿Qué pasó después?",shape=box,color=red];
		j971204568 -> j635194162;
	j777162605 [label="Boolean LyonRell1 is now true.",color=orange];
		j777162605 -> j367054140;
	j367054140 [label="+20 Chemistry",color=orange];
		j367054140 -> "Chat ends.";
}