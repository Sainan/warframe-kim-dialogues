	j1199475704 [label="He estado considerando la naturaleza de nuestra conversación de ayer. Y lo que significa la presencia de Rell y Harrow tan implacable en mi vida...",shape=box,color=blue];
		j1199475704 -> j4243709577;
	j2895326262 [label="He estado considerando la naturaleza de nuestra conversación de ayer. Y lo que significa la presencia de Rell y Harrow tan implacable en mi vida...",shape=box,color=blue];
		j2895326262 -> j3299235874;
	j3084842725 [label="He estado considerando la naturaleza de nuestra conversación de ayer. Y lo que significa la presencia de Rell y Harrow tan implacable en mi vida...",shape=box,color=blue];
		j3084842725 -> j2026172824;
	j1931038495 [label="Hay algo que he querido hablar contigo, y solo ahora tengo la oportunidad de hacerlo. Cuando... Rell, Harrow y yo nos convertimos en uno, el cómo y por qué de eso no es importante...",shape=box,color=blue];
		j1931038495 -> j2427434554;
	"Chat ends." [color=orange];
	j4243709577 [label="Solo para que su presencia se me fuera arrebatada del alma una vez más, solo para que se quedara como una memoria. Y cómo eso pudo haber sido un regalo de Lua...",shape=box,color=blue];
		j4243709577 -> j1772128539;
	j3299235874 [label="Solo para que su presencia se me fuera arrebatada del alma una vez más, solo para que se quedara como una memoria. Y estás en lo correcto. Puede que signifique que no hay dioses en este mundo.",shape=box,color=blue];
		j3299235874 -> j303845449;
	j2026172824 [label="Solo para que su presencia se me fuera arrebatada del alma una vez más, solo para que se quedara como una memoria. Y no sé si eso signifique que haya o no dioses en este mundo.",shape=box,color=blue];
		j2026172824 -> j1054643274;
	j2427434554 [label="Me vi envuelto en el pasado de ambos de la misma forma en la que se envolvieron en la mía. Vi todo lo de la Zariman Diez Cero, los recuerdos de la Antigua Guerra, y de la misma manera, ellos vieron mi pasado.",shape=box,color=blue];
		j2427434554 -> j2504980226;
	j1772128539 [label="Me he dado cuenta que nuestra dama plateada sería capaz de dar una bendición trágica como esa. Ella no querría borrar la memoria del dolor, como ocurrió con Roathe.",shape=box,color=blue];
		j1772128539 -> j1792999842;
	j303845449 [label="Pero eso no cambia, eso creo, los años que pasamos en servicio para la organización que, en esencia, buscaba hacer el bien en este mundo.",shape=box,color=blue];
		j303845449 -> j3827930211;
	j1054643274 [label="Como lo dijiste, puede que nunca lo sepamos. Y tal vez no nos corresponda saberlo. Pero eso no cambia, eso creo, los años que pasamos en servicio para la organización que, en esencia, buscaba hacer el bien en este mundo.",shape=box,color=blue];
		j1054643274 -> j3827930211;
	j2504980226 [label="Me hizo... cuestionarme muchas cosas, en concreto... mi fe. Se arrugó y desmoronó, como papel carbonizado... que se volvió cenizas. Me aborrezco a mi mismo por esta debilidad...",shape=box,color=blue];
		j2504980226 -> j3287457751;
	j1792999842 [label="Tampoco le quitaría a mi cuerpo el ardor del látigo. Ciertamente no sería la manera en la que me protegería del dolor de su muerte.",shape=box,color=blue];
		j1792999842 -> j2091567951;
	j3827930211 [label="Para ayudar a esos que desean aliviar el dolor de sus vidas en los momentos donde se ahogarían en él.",shape=box,color=blue];
		j3827930211 -> j1067957847;
	j3287457751 [label="Evaluate expressions",color=orange];
		j3287457751 -> j1961131909 [label="LyonDating",color=purple];
		j3287457751 -> j3256699196 [label="DrifterFaithYesSimilar",color=purple];
		j3287457751 -> j3256699196 [label="DrifterFaithYesForeign",color=purple];
		j3287457751 -> j3256699196 [label="DrifterFaithPersonal",color=purple];
		j3287457751 -> j3777057196 [label="DrifterFaithSol",color=purple];
		j3287457751 -> j3777057196 [label="DrifterFaithLua",color=purple];
		j3287457751 -> j3777057196 [label="DrifterFaithBalance",color=purple];
		j3287457751 -> j1772506819 [label="DrifterFaithAgnostic",color=purple];
		j3287457751 -> j1990860493 [label="DrifterFaithNoFear",color=purple];
		j3287457751 -> j74570887 [label="DrifterFaithNoMITW",color=purple];
		j3287457751 -> j1990860493 [label="DrifterFaithNoMaybe",color=purple];
		j3287457751 -> j2664951435 [label="false",color=purple];
	j2091567951 [label="En donde Sol haría desaparecer el dolor como un cuchillo caliente para cauterizar una herida... Lua me haría aceptar el calor del dolor que su ausencia podría traerme.",shape=box,color=blue];
		j2091567951 -> j2463937124;
	j1067957847 [label="Y sé que si aún fuera capaz de encontrar la presencia de Rell y Harrow, ellos no querrían que agonizara su perdida. Se encuentran en paz.",shape=box,color=blue];
		j1067957847 -> j1512199848;
	j1961131909 [label="Ay, Lyon... has pasado por tanto. La duda no es señal de debilidad, sino del dolor.",shape=box,color=red];
		j1961131909 -> j499798907;
		j1961131909 -> j2746493179;
		j1961131909 -> j3663887241;
		j1961131909 -> j699255263;
		j1961131909 -> j898377626;
	j3256699196 [label="La fe no necesita ser constante... y tampoco se espera que lo tenga que ser. ¿Cuántas historias se cuentan a quienes pierden la fe, solo para encontrarla de nuevo?",shape=box,color=red];
		j3256699196 -> j499798907;
		j3256699196 -> j2746493179;
		j3256699196 -> j3663887241;
	j3777057196 [label="Dedicaste tu vida a nuestras Luminarias, Lyon. ¿Crees que te darían la espalda por algo así?",shape=box,color=red];
		j3777057196 -> j499798907;
		j3777057196 -> j2746493179;
		j3777057196 -> j3663887241;
	j1772506819 [label="No sé si hay dioses o no, Lyon... No creo que nosotros lo vayamos a saber con certeza. Pero lo que sí sé es que has pasado por mucho.",shape=box,color=red];
		j1772506819 -> j499798907;
		j1772506819 -> j3663887241;
		j1772506819 -> j699255263;
	j1990860493 [label="Mientras personalmente no creo que haya dioses en este mundo, sé lo importante que ha sido para ti en tu vida. No quiero menospreciarlo.",shape=box,color=red];
		j1990860493 -> j3663887241;
		j1990860493 -> j898377626;
	j74570887 [label="La Indiferencia fue hecha por nosotros... no es un dios, Lyon. No dejes que el error de Entrati te destruya. ¿Y tu fe?",shape=box,color=red];
		j74570887 -> j3663887241;
		j74570887 -> j898377626;
	j2664951435 [label="Odio verte así, atrapado en medio de todas las cosas sin sentido de los demás. No merecías esto.",shape=box,color=red];
		j2664951435 -> j499798907;
		j2664951435 -> j2746493179;
		j2664951435 -> j3663887241;
		j2664951435 -> j699255263;
		j2664951435 -> j898377626;
	j2463937124 [label="Porque es la ausencia de dolor lo que amenaza con destruirnos, tanto como una abundancia de él podría ahogarnos.",shape=box,color=blue];
		j2463937124 -> j1377965316;
		j2463937124 -> j1443013499;
		j2463937124 -> j152570860;
	j1512199848 [label="No es que crea que todo mi sufrimiento haya sido en vano. Eso no invalida todo lo que soporté.",shape=box,color=blue];
		j1512199848 -> j1327369913;
	j499798907 [label="No estoy diciendo que necesites encontrar tu fe de nuevo. Estoy diciendo que si tu quieres... si sientes que lo necesitas... no es algo que se pierde para siempre.",shape=box,color=red];
		j499798907 -> j3916347831;
	j2746493179 [label="Seguramente Lua puede ver por lo que has pasado. Lo que has soportado en su nombre. ",shape=box,color=red];
		j2746493179 -> j64894144;
	j3663887241 [label="Yo creo que lo que necesitas es concentrarte en encontrar algún tipo de paz dentro de ti... sin embargo eres tú el que necesita encontrarla.",shape=box,color=red];
		j3663887241 -> j3916347831;
	j699255263 [label="Si es que hay un dios, si es que Lua existe... seguramente ella puede ver por lo que has pasado. Lo que has soportado en su nombre. Debe de significar algo para ella.",shape=box,color=red];
		j699255263 -> j64894144;
	j898377626 [label="Creo que necesitas dejar de lado cualquier noción de que si existen o no los dioses y concentrarte en sanarte a ti mismo primero.",shape=box,color=red];
		j898377626 -> j3734995674;
	j1377965316 [label="Créeme... sé lo peligrosa que puede ser la apatía.",shape=box,color=red];
		j1377965316 -> j3547575002;
	j1443013499 [label="¿Eso significa que has encontrado tu fe de nuevo?",shape=box,color=red];
		j1443013499 -> j407219657;
	j152570860 [label="[Fin]",shape=box,color=red];
		j152570860 -> j3856020424;
	j1327369913 [label="Porque es la ausencia de dolor lo que amenaza con destruirnos, tanto como una abundancia de él podría ahogarnos.",shape=box,color=blue];
		j1327369913 -> j1377965316;
		j1327369913 -> j130106744;
		j1327369913 -> j152570860;
	j3916347831 [label="Boolean LyonFaith3Maybe is now true.",color=orange];
		j3916347831 -> j1393743379;
	j64894144 [label="Boolean LyonFaith3Yes is now true.",color=orange];
		j64894144 -> j3625429823;
	j3734995674 [label="Boolean LyonFaith3No is now true.",color=orange];
		j3734995674 -> j763915350;
	j3547575002 [label="Eso parece. ",shape=box,color=blue];
		j3547575002 -> j3948437999;
	j407219657 [label="Es difícil decirlo. No sé si algo así es algo que alguien como yo realmente haya \"encontrado\" o \"perdido\", sino que siempre está buscando. Siempre cuestionando, siempre en busca de respuestas.",shape=box,color=blue];
		j407219657 -> j468873248;
	j3856020424 [label="Boolean LyonConfessionFail is now true.",color=orange];
		j3856020424 -> "Chat ends.";
	j130106744 [label="¿Eso significa que has renunciado a tu fe?",shape=box,color=red];
		j130106744 -> j407219657;
	j1393743379 [label="Pienso en que significa tener a Rell y Harrow tan inexorablemente dentro de mi vida...",shape=box,color=blue];
		j1393743379 -> j3177380907;
	j3625429823 [label="Pienso en todos los años que pasé en servicio para la organización que, en esencia, buscaba hacer el bien en este mundo... lo que significa tener la presencia de Rell y Harrow tan inexorablemente en mi vida...",shape=box,color=blue];
		j3625429823 -> j3045622291;
	j763915350 [label="Pienso en que significa tener a Rell y Harrow tan inexorablemente dentro de mi vida...",shape=box,color=blue];
		j763915350 -> j3817518067;
	j3948437999 [label="No sé si algo como la fe es algo que alguien como yo realmente haya \"encontrado\" o \"perdido\", sino que siempre la está buscando. Siempre cuestionando... siempre en busca de respuestas.",shape=box,color=blue];
		j3948437999 -> j468873248;
	j468873248 [label="Pero creo que hay que lograr, como en el dolor, un balance para asegurarte de no ahogarte dentro del mismo o que se convierta tan habitual como para hacerte inmune e insensible.",shape=box,color=blue];
		j468873248 -> j1286686499;
	j3177380907 [label="Solo para que su presencia se me fuera arrebatada del alma una vez más, solo para que se quedara como una memoria. Y no sé si eso signifique que haya o no dioses en este mundo.",shape=box,color=blue];
		j3177380907 -> j1054643274;
	j3045622291 [label="Solo para que su presencia se me fuera arrebatada del alma una vez más, solo para que se quedara como una memoria. Y cómo eso pudo haber sido un regalo de Lua...",shape=box,color=blue];
		j3045622291 -> j2567847047;
	j3817518067 [label="Solo para que su presencia se me fuera arrebatada del alma una vez más, solo para que se quedara como una memoria. Y estás en lo correcto. Puede que signifique que no hay dioses en este mundo.",shape=box,color=blue];
		j3817518067 -> j303845449;
	j1286686499 [label="Check boolean DrifterFaithNoMITW",color=orange];
		j1286686499 -> j2368787266 [label=true,color=green];
		j1286686499 -> j877877349 [label=true,color=green];
		j1286686499 -> j1208228161 [label=false,color=brown];
		j1286686499 -> j877877349 [label=false,color=brown];
	j2567847047 [label="Tal vez estés en lo correcto. Quizás nuestra dama plateada sería capaz de dar una bendición trágica como esa. Ella no querría borrar la memoria del dolor, como ocurrió con Roathe.",shape=box,color=blue];
		j2567847047 -> j1792999842;
	j2368787266 [label="¿Estás de acuerdo con Roathe y conmigo en que el Hombre en la Pared no es un dios verdadero?",shape=box,color=red];
		j2368787266 -> j4196404484;
	j877877349 [label="¿Dónde crees que recae la Indiferencia en esto?",shape=box,color=red];
		j877877349 -> j977769180;
	j1208228161 [label="¿Estás del lado de Roathe en pensar que la Indiferencia es un verdadero dios o no?",shape=box,color=red];
		j1208228161 -> j4196404484;
	j4196404484 [label="No sé cuál es mi postura al respecto. No tengo suficiente evidencia para tomar una decisión. Pero supongo que no cambia mucho ¿no es así?",shape=box,color=blue];
		j4196404484 -> j3065822597;
		j4196404484 -> j1992671298;
	j977769180 [label="Sea o no la Indiferencia un dios, no sé cuál es mi postura al respecto. No tengo suficiente evidencia para tomar una decisión. Pero supongo que no cambia mucho ¿no es así?",shape=box,color=blue];
		j977769180 -> j3065822597;
		j977769180 -> j1992671298;
	j3065822597 [label="Creo que eso cambia las cosas. Si no hay un dios real... entonces lo ha creado la gente. Eso significa que puede ser derrotado por la gente.",shape=box,color=red];
		j3065822597 -> j1838117210;
	j1992671298 [label="¿Qué quieres decir?",shape=box,color=red];
		j1992671298 -> j1660253750;
	j1838117210 [label="Si no tenías la esperanza de que pudiera ser derrotado con nuestros esfuerzos, ¿por qué molestarse en oponerse a ello en primer lugar? De verdad, eres una criatura incomprensible.",shape=box,color=blue];
		j1838117210 -> j2433506423;
	j1660253750 [label="El método de su llegada a nuestro universo no cambia los métodos por los cuales podríamos derrotarlo.",shape=box,color=blue];
		j1660253750 -> j212196727;
	j2433506423 [label="No es posible que esas palabras las digas en serio. ¿Acaso simplemente \"te dejas llevar\" por las acciones de otros? ¿Pelear contra ello por no tener algo mejor que hacer con tu tiempo?",shape=box,color=blue];
		j2433506423 -> j2496743067;
	j212196727 [label="He aquí un dios de nuestra creación, cosido a partir de la tela de nuestro propio vacío.",shape=box,color=blue];
		j212196727 -> j191497090;
	j2496743067 [label="Seguramente podrías pensar en un pasatiempo mejor.",shape=box,color=blue];
		j2496743067 -> j1670889130;
		j2496743067 -> j1917808772;
	j191497090 [label="Una muñeca de trapo que podríamos llenar con tristeza, nuestra pena, nuestro dolor, nuestra rabia, nuestra agonía, hasta que sus costuras amenacen con estallar.",shape=box,color=blue];
		j191497090 -> j1980257664;
	j1670889130 [label="No, no creí que fuera inútil... eso no es lo que quise decir.",shape=box,color=red];
		j1670889130 -> j437802445;
	j1917808772 [label="Lo que quise decir era que esto cambia en cómo podemos pensar en matarlo. Entendiéndolo.",shape=box,color=red];
		j1917808772 -> j3872159817;
	j1980257664 [label="Perdóname, pero eso me llena de terror mucho más que si fuera un dios antes de que llegáramos. ",shape=box,color=blue];
		j1980257664 -> j3005333492;
	j437802445 [label="Pensar antes de decir algo no es un requisito. Tampoco lo es para las balas. ",shape=box,color=blue];
		j437802445 -> j212196727;
	j3872159817 [label="No creo que eso sea verdad. Más bien diría que ahora entendemos solo un poco sobre sus motivaciones como si fuera solo \"un gran y misterioso dios\".",shape=box,color=blue];
		j3872159817 -> j212196727;
	j3005333492 [label="Sí, de hecho, creo que prefiero eso.",shape=box,color=blue];
		j3005333492 -> j1596471639;
	j1596471639 [label="Podría haber alguna esperanza de que pudiera ser más inteligente que la humanidad en general.",shape=box,color=blue];
		j1596471639 -> j3770563694;
	j3770563694 [label="Con ese... completamente lúgubre pensamiento, creo que debería de irme por hoy.",shape=box,color=blue];
		j3770563694 -> j742749064;
