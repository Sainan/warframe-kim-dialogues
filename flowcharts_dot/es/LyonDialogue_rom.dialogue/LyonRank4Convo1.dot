	700 [label="Update boolean LyonSuspicious",color=orange];
		700 -> 710;
	701 [label="Me pregunto que tanto de nuestras creencias se vieron influenciadas entre sí, intencionalmente o sin intención, según sea el caso.",shape=box,color=blue];
		701 -> 704;
	698 [label="¡Fascinante! Como estudioso de la materia, espero que tengamos tiempo para aprender extensamente unos de otros sobre nuestras respectivas creencias.",shape=box,color=blue];
		698 -> 704;
	695 [label="Es una larga historia. ",shape=box,color=red];
		695 -> 707;
	696 [label="Estudié varias religiones diferentes, y ninguna encajaba conmigo. Termine con una extraña mezcla en mi humanidad.",shape=box,color=red];
		696 -> 708;
	697 [label="Creo en lo que siento. Y no necesito un edificio ni un libro que me lo diga.",shape=box,color=red];
		697 -> 709;
	690 [label="¿De verdad? Estoy... sorprendido. Sorprendido, pero complacido. Y no me extraña que tengas curiosidad, entonces. Nuestras enseñanzas deben ser muy ajenas a lo que sabes. Ha pasado tanto tiempo.",shape=box,color=blue];
		690 -> 704;
	691 [label="Respeto eso. Hay honor en reconocer lo que no podemos saber, en ver la pequeñez de la condición humana.",shape=box,color=blue];
		691 -> 704;
	692 [label="Créeme, no me ofendo. En muchos casos, tienes toda la razón.",shape=box,color=blue];
		692 -> 705;
		692 -> 706;
	693 [label="Admito que siento envidia de que no encuentres motivos para preocuparte por lo que nos espera más allá del velo. Si más personas lo hicieran, nuestro mundo habría conocido más paz en sus días.",shape=box,color=blue];
		693 -> 704;
	694 [label="Ese es un tema sobre el que deseo hablar contigo extensamente. Simplemente no ahora, en un momento en el que no estoy preparado para tal discusión.",shape=box,color=blue];
		694 -> 704;
	688 [label="Es un buen punto de partida. Conocer una cultura por sus festividades es conocer su esencia. Porque la forma en que un pueblo celebra es como será recordado. Porque esos momentos son los más apreciados por quienes los comparten.",shape=box,color=blue];
		688 -> 702;
	689 [label="Por supuesto. Empecemos con lo que quizás ya sepas: Sol y Lua, el sol y la luna. Son deidades eternamente transmutables en sus aspectos.",shape=box,color=blue];
		689 -> 703;
	710 [label="Mmm. Permíteme responder a tu curiosidad. Para no aburrirte demasiado, ¿por dónde te gustaría empezar?",shape=box,color=blue];
		710 -> 665;
		710 -> 664;
	704 [label="Y me sigo equivocando al no mantenerme en el tema. Me temo que me he desviado bastante sobre lo que estábamos hablando.",shape=box,color=blue];
		704 -> 714;
	707 [label="+20 Chemistry",color=orange];
		707 -> 717;
	708 [label="+20 Chemistry",color=orange];
		708 -> 718;
	709 [label="+20 Chemistry",color=orange];
		709 -> 719;
	705 [label="Sin embargo, eso no significa que no me interese aprender.",shape=box,color=red];
		705 -> 715;
	706 [label="¿Y en tu caso qué?",shape=box,color=red];
		706 -> 716;
	702 [label="Nuestras festividades más comunes son la del solsticio de invierno y verano que marcan los días más largos y cortos del año.",shape=box,color=blue];
		702 -> 711;
	703 [label="Apareciendo en muchas formas a lo largo de los siglos para muchos creyentes. A veces siendo un hombre, a veces siendo una mujer. Pero siempre como Sol, el astro, y Lua, como la luna.",shape=box,color=blue];
		703 -> 712;
		703 -> 713;
	714 [label="Querías saber sobre la Ortodoxia Luminaria, ¿verdad? Para no aburrirte, ¿por dónde te gustaría empezar?",shape=box,color=blue];
		714 -> 665;
		714 -> 664;
	717 [label="Mm. Y es mejor contárselo a un amigo de confianza. Lo entiendo perfectamente. Además, tú viniste a mí en busca de información, no al revés.",shape=box,color=blue];
		717 -> 704;
	718 [label="Un vitral del alma. Se rompe al desmontarlo, pero qué hermosa imagen muestra al ser ensamblado.",shape=box,color=blue];
		718 -> 704;
	719 [label="El mundo sería un lugar mejor si compartiera tu fe.",shape=box,color=blue];
		719 -> 704;
	715 [label="Y por eso alabo tu curiosidad y tu naturaleza académica. ",shape=box,color=blue];
		715 -> 704;
	716 [label="Mi caso es... complejo. Pero no te mentiré y diré que no he estado exento de miedo. Aunque la religión ha traído un torrente de temor a mi vida, este nunca se ha ido por completo.",shape=box,color=blue];
		716 -> 704;
	711 [label="Ambas festividades se caracterizan por tener grandes festines, aunque estos se definen según con quién se compartan. Mientras que el solsticio de invierno es para compartir con familiares y amigos cercanos, el solsticio de verano es para los desconocidos.",shape=box,color=blue];
		711 -> 720;
		711 -> 721;
	712 [label="Oh, eso tiene mucho más sentido ahora.",shape=box,color=red];
		712 -> 722;
	713 [label="[Dejarlo continuar]",shape=box,color=red];
		713 -> 723;
	720 [label="¿En serio? Cuéntame más sobre el solsticio de verano.",shape=box,color=red];
		720 -> 724;
	721 [label="Cuéntame más sobre el solsticio de invierno.",shape=box,color=red];
		721 -> 725;
	722 [label="Sí, algunas sectas pueden ser un poco estrictas en su elección de iconografía, declarando que Sol \"debe\" ser de una manera o \"debe\" ser de otra, pero la ortodoxia no reconoce esto como un hecho.",shape=box,color=blue];
		722 -> 726;
	723 [label="Cada una de las Luminarias alberga múltiples aspectos. Cada aspecto puede considerarse una función del todo. Lua, por ejemplo, es la madre, la doncella, la anciana.",shape=box,color=blue];
		723 -> 731;
	724 [label="El solsticio de verano es para compartir grandes riquezas y reunir a desconocidos que nunca se han visto. Te reunirías en un campo, trayendo comida y productos de tu propia elaboración, sin importar nada.",shape=box,color=blue];
		724 -> 728;
	725 [label="El solsticio de invierno es para protegernos del frío y abrigar a quienes nos abrigan en los momentos más oscuros. Decoras un árbol con velas, una luz por cada uno de los que nos precedieron y que nos guían como las estrellas en el cielo.",shape=box,color=blue];
		725 -> 729;
	726 [label="Supongo que todo lo que ha sobrevivido hasta este lejano futuro ha terminado siendo... un poco confuso en su documentación de mi religión.",shape=box,color=blue];
		726 -> 730;
	731 [label="Pero Lua también puede ser aquella que guía las almas por el río de lágrimas hacia la noche eterna. La muerte misma. El presagio y heraldo.",shape=box,color=blue];
		731 -> 734;
	728 [label="Velas, o pan, o ropa, o pinturas. O libros de poesía. O coronas de flores. Incluso llegar con las manos vacías pero \"con buenas noticias\" es considerado como una bendición.",shape=box,color=blue];
		728 -> 732;
	729 [label="Y encima, el mismísimo Sol, sufriendo en la cima del árbol estelar en la oscuridad. Atenuado, pero no olvidado. Porque este es el tiempo de Lua. Y la celebramos en este tiempo de sombra.",shape=box,color=blue];
		729 -> 733;
	730 [label="Me considero una reliquia arqueológica viviente. Qué deprimente. Pero estoy divagando.",shape=box,color=blue];
		730 -> 723;
	734 [label="Y en otras sectas, la muerte es una anciana con velo. Es diferente. Pero habla del mismo espíritu que nos alcanza a todos. La mano plateada que desea guiarnos en ese último momento.",shape=box,color=blue];
		734 -> 737;
	732 [label="Una celebración de la vida, de la risa, de la música, del compartir todas esas cosas, comenzaría durante los días más largos de Sol. ",shape=box,color=blue];
		732 -> 735;
	733 [label="Y al acercarnos, y deleitarnos con un ave asada, tubérculos y todo lo que no crece fresco en la tierra helada, abrazamos a quienes amamos. Y contamos historias de los que se han ido.",shape=box,color=blue];
		733 -> 736;
	737 [label="La luna que se desliza sobre el sol durante el eclipse, guiándonos en la encrucijada en ese momento donde todo está perdido.",shape=box,color=blue];
		737 -> 739;
	735 [label="Todos fueron bienvenidos a hacer nuevos amigos con desconocidos y a llevar a casa a aquellos que lo necesitaban.",shape=box,color=blue];
		735 -> 738;
	736 [label="Recordamos, en la noche más larga de Lua, que ella nos guiará a nosotros y a nuestra familia hasta el final.",shape=box,color=blue];
		736 -> 738;
	739 [label="Update boolean DrifterEclipse",color=orange];
		739 -> 741;
	738 [label="Pero la festividad más sagrada para las Luminarias es el Summum Bonum. Es un evento excepcional, cuando Sol y Lua se alinean en un eclipse perfecto.",shape=box,color=blue];
		738 -> 740;
	741 [label="Check boolean VelimirEclipse",color=orange];
		741 -> 744 [label=true,color=green];
		741 -> 743 [label=false,color=brown];
	740 [label="Es una ocasión maravillosa y sagrada, donde toda la naturaleza responde. ¿Has tenido la suerte de presenciarlo?",shape=box,color=blue];
		740 -> 742;
	744 [label="Espera...",shape=box,color=red];
