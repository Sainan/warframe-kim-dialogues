	746 [label="He tenido la suerte de presenciarlo dos veces. Y en ambas ocasiones, lo encontré... transformativo. Si pudiera quedarme en ese breve instante, suspendido allí para siempre, lo haría.",shape=box,color=blue];
		746 -> 754;
