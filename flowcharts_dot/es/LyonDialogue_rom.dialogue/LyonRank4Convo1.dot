	675 [label="No, tengo más curiosidad que cualquier otra cosa.",shape=box,color=red];
		675 -> 686;
	676 [label="Soy religioso. Es similar a la tuya, aunque no la reconocerías.",shape=box,color=red];
		676 -> 687;
	674 [label="Soy religioso. Aunque no reconocerías ninguna de nuestras prácticas.",shape=box,color=red];
		674 -> 685;
	673 [label="Soy religioso. Es una creencia personal, no tiene nombre.",shape=box,color=red];
		673 -> 684;
	672 [label="Sigo el camino de Sol, como Marie.",shape=box,color=red];
		672 -> 679;
	671 [label="Soy como tú, sigo el camino de Lua.",shape=box,color=red];
		671 -> 679;
	666 [label="Sigo a las Luminarias, pero trato de mantener un camino equilibrado.",shape=box,color=red];
		666 -> 679;
	667 [label="Creo que hay algo ahí fuera, pero no creo que la gente realmente pueda saber las respuestas al final del día.",shape=box,color=red];
		667 -> 680;
	668 [label="No soy religioso. Tiendo a pensar que la religión es una muleta para los temerosos... lo digo sin ánimo de ofender.",shape=box,color=red];
		668 -> 681;
	669 [label="No soy religioso. No digo que no pueda haber algo ahí fuera, pero no es algo que me preocupe.",shape=box,color=red];
		669 -> 682;
	670 [label="No soy religioso. Creo que todos los dioses, incluso la Indiferencia, son producto de nuestra imaginación. Lo digo sin el ánimo de ofender.",shape=box,color=red];
		670 -> 683;
