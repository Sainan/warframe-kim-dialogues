digraph {
	"LyonRoatheFail begins." [color=orange];
		"LyonRoatheFail begins." -> j3811700180;
		"LyonRoatheFail begins." -> j2429168889;
	j3811700180 [label="Lyon, I need your help with Roathe.",shape=box,color=red];
		j3811700180 -> j421763245;
	j2429168889 [label="[Fin.]",shape=box,color=red];
		j2429168889 -> "Chat ends.";
	j421763245 [label="Check boolean LyonDating",color=orange];
		j421763245 -> j2450350182 [label=true,color=green];
		j421763245 -> j803209359 [label=false,color=brown];
	"Chat ends." [color=orange];
	j2450350182 [label="If there is anything I can do to be of assistance, I will do it, mon miracle. What appears to have gone awry between you two?",shape=box,color=blue];
		j2450350182 -> j1618578127;
	j803209359 [label="If there is anything I can do to be of assistance, I will do it, my friend. What appears to have gone awry between you two?",shape=box,color=blue];
		j803209359 -> j1618578127;
	j1618578127 [label="Evaluate expressions",color=orange];
		j1618578127 -> j3981134767 [label="RoatheFail",color=purple];
		j1618578127 -> j3981134767 [label="RoatheFailStall",color=purple];
		j1618578127 -> j3523981627 [label="RoatheFailUltimate",color=purple];
		j1618578127 -> j1238303185 [label="RoatheFailNot21",color=purple];
		j1618578127 -> j819897697 [label="RoatheFailUnloved",color=purple];
	j3981134767 [label="Roathe has been facing down the truth of his... well... taking the serum. And I don't know how, but I think I did a poor job of helping him through it.",shape=box,color=red];
		j3981134767 -> j4187378277;
	j3523981627 [label="I'm not sure. I think I said something I shouldn't have.",shape=box,color=red];
		j3523981627 -> j1911796329;
	j1238303185 [label="He told me not to go any farther into his memories. So I haven't. And now we seem... stuck?",shape=box,color=red];
		j1238303185 -> j1477786492;
	j819897697 [label="I told him I was only with him for casual companionship, and even though he didn't seem to have a problem with it, now I feel like we've regressed.",shape=box,color=red];
		j819897697 -> j1911796329;
	j4187378277 [label="I see. It can be a difficult thing, to reconcile one's past actions when they are painted in a new light. I curse Entrati for forcing him, and us, into this despicable situation.",shape=box,color=blue];
		j4187378277 -> j2659468035;
	j1911796329 [label="I see. I fear I must tell you there is little I can do in this matter, as you are experiencing the aftermath of \"reaping what one has sewn\" in this regard.",shape=box,color=blue];
		j1911796329 -> j2619567436;
	j1477786492 [label="I see. Sometimes, acting in one's best wishes is not the same as following their wishes to the letter of their request.",shape=box,color=blue];
		j1477786492 -> j2372933807;
	j2659468035 [label="I will do what I can to convince him to listen to you. But I must council you to have better arguments prepared as to why he should reinterpret his actions as anything other than cowardice.",shape=box,color=blue];
		j2659468035 -> j1240437235;
	j2619567436 [label="Acting with callous disregard in such a fashion is bound to result in behavior that responds in kind. Particularly when you are dealing with one such as Roathe.",shape=box,color=blue];
		j2619567436 -> j2141444974;
	j2372933807 [label="It is a terrible act we must do, to disobey someone's desires, especially in such a deed as rifling through their private memories and thoughts.",shape=box,color=blue];
		j2372933807 -> j835408696;
	j1240437235 [label="For I know that is what eats him whole from the inside out.",shape=box,color=blue];
		j1240437235 -> j634859459;
	j2141444974 [label="I do not know what recourse you have to correct matters. But I do not believe you will find a path through Marie nor myself, forgive me.",shape=box,color=blue];
		j2141444974 -> j968280525;
	j835408696 [label="I curse Entrati for forcing him, and ourselves, into such a despicable position.",shape=box,color=blue];
		j835408696 -> j575540560;
	j634859459 [label="I know we will also need Marie's assistance in this matter. She may be harder to convince, as you know there is little love lost between those two.",shape=box,color=blue];
		j634859459 -> j2692406010;
	j968280525 [label="Perhaps it is best to pursue other options at this point.",shape=box,color=blue];
		j968280525 -> "Chat ends.";
	j575540560 [label="But it seems to me as though the only way to help him is, unfortunately, to do exactly that. And to continue to explore the Descendia until there is no memory left undiscovered.",shape=box,color=blue];
		j575540560 -> j777792757;
	j2692406010 [label="Boolean LyonRoatheFailFix is now true.",color=orange];
		j2692406010 -> j3308004919;
	j777792757 [label="No matter how the devil might protest.",shape=box,color=blue];
		j777792757 -> "Chat ends.";
	j3308004919 [label="Lua guide you.",shape=box,color=blue];
		j3308004919 -> "Initiate conversation MarieRoatheFail in /Lotus/Types/Gameplay/1999Wf/Dialogue/MarieDialogue_rom.dialogue";
	"Initiate conversation MarieRoatheFail in /Lotus/Types/Gameplay/1999Wf/Dialogue/MarieDialogue_rom.dialogue" [label="Initiate conversation MarieRoatheFail in /Lotus/Types/Gameplay/1999Wf/Dialogue/MarieDialogue_rom.dialogue",color=orange];
		"Initiate conversation MarieRoatheFail in /Lotus/Types/Gameplay/1999Wf/Dialogue/MarieDialogue_rom.dialogue" -> "Chat ends.";
}