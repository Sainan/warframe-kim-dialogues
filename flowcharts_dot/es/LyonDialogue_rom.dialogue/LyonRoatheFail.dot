	j421763245 [label="Check boolean LyonDating",color=orange];
		j421763245 -> j2244585912 [label=true,color=green];
		j421763245 -> j2530111231 [label=false,color=brown];
	"Chat ends." [color=orange];
	j2244585912 [label="Si puedo ayudar en algo, lo haré, mon miracle. ¿Qué parece haber salido mal entre ustedes dos?",shape=box,color=blue];
		j2244585912 -> j572992334;
	j2530111231 [label="Si puedo ayudar en algo, lo haré, amigo mío. ¿Qué parece haber salido mal entre ustedes dos?",shape=box,color=blue];
		j2530111231 -> j572992334;
	j572992334 [label="Evaluate expressions",color=orange];
		j572992334 -> j3549115674 [label="RoatheFail",color=purple];
		j572992334 -> j3549115674 [label="RoatheFailStall",color=purple];
		j572992334 -> j337465873 [label="RoatheFailUltimate",color=purple];
		j572992334 -> j1334443020 [label="RoatheFailNot21",color=purple];
		j572992334 -> j3334762648 [label="RoatheFailUnloved",color=purple];
		j572992334 -> j3549115674 [label="RoatheRepair1",color=purple];
	j3549115674 [label="Roathe ha estado afrontando la verdad sobre... bueno... haber tomado el suero. Y no sé cómo, pero creo que no le ayudé a superarlo.",shape=box,color=red];
		j3549115674 -> j2041355097;
	j337465873 [label="No sé bien pero creo que dije algo que no debía.",shape=box,color=red];
		j337465873 -> j2402228755;
	j1334443020 [label="Me dijo que no profundizara más en sus recuerdos. Así que no lo hice. Y ahora parecemos... ¿atrapados?",shape=box,color=red];
		j1334443020 -> j3372133188;
	j3334762648 [label="Le dije que sólo estaba con él de manera casual y aunque no parecía tener problema con ello, ahora siento que hemos retrocedido en la relación.",shape=box,color=red];
		j3334762648 -> j2402228755;
	j2041355097 [label="Ya veo. Puede ser difícil reconciliarse con las acciones pasadas cuando se presentan bajo una nueva luz. Maldigo a Entrati por obligarlo a él y a nosotros a esta situación despreciable.",shape=box,color=blue];
		j2041355097 -> j3446674196;
	j2402228755 [label="Ya veo. Me temo que debo decirte que poco puedo hacer al respecto, ya que estás experimentando las consecuencias de \"cosechar lo que se ha sembrado\".",shape=box,color=blue];
		j2402228755 -> j2447777155;
	j3372133188 [label="Ya veo. A veces, actuar según los deseos de alguien no significa seguirlos al pie de la letra.",shape=box,color=blue];
		j3372133188 -> j487572398;
	j3446674196 [label="Haré lo que pueda para convencerlo de que te escuche. Pero debo aconsejarte que tengas mejores argumentos preparados para justificar por qué debería reinterpretar sus acciones como algo más que cobardía.",shape=box,color=blue];
		j3446674196 -> j688959966;
	j2447777155 [label="Actuar con tanto desprecio y desdén sólo puede provocar una reacción igualmente violenta. Sobre todo al tratar con alguien como Roathe.",shape=box,color=blue];
		j2447777155 -> j668620901;
	j487572398 [label="Es un acto terrible que debemos realizar, desobedecer los deseos de alguien, especialmente en un acto como hurgar en sus recuerdos y pensamientos privados.",shape=box,color=blue];
		j487572398 -> j1795569348;
	j688959966 [label="Porque sé que eso es lo que lo devora por dentro y por fuera.",shape=box,color=blue];
		j688959966 -> j3276605175;
	j668620901 [label="No sé qué recurso tienes para corregir la situación. Pero no creo que encuentres un camino ni a través de Marie ni de mí, perdóname.",shape=box,color=blue];
		j668620901 -> j4094675000;
	j1795569348 [label="Maldigo a Entrati por obligarlo a él y a nosotros a una posición tan despreciable.",shape=box,color=blue];
		j1795569348 -> j3483479636;
	j3276605175 [label="Sé que también necesitaremos la ayuda de Marie en este asunto. Puede que sea más difícil convencerla, ya que, como sabes, no hay mucho cariño entre ellos dos.",shape=box,color=blue];
		j3276605175 -> j894830841;
	j4094675000 [label="Quizás sea mejor buscar otras opciones en este momento.",shape=box,color=blue];
		j4094675000 -> "Chat ends.";
	j3483479636 [label="Pero me parece que la única manera de ayudarlo es, por desgracia, hacer precisamente eso. Y seguir explorando Descendia hasta que no queden más recuerdos por descubrir.",shape=box,color=blue];
		j3483479636 -> j4100012628;
	j894830841 [label="Boolean LyonRoatheFailFix is now true.",color=orange];
		j894830841 -> j3881829030;
	j4100012628 [label="Sin importar cuánto proteste el diablo.",shape=box,color=blue];
		j4100012628 -> "Chat ends.";
	j3881829030 [label="Que Lua te guíe.",shape=box,color=blue];
		j3881829030 -> "Initiate conversation MarieRoatheFail in /Lotus/Types/Gameplay/1999Wf/Dialogue/MarieDialogue_rom.dialogue";
	"Initiate conversation MarieRoatheFail in /Lotus/Types/Gameplay/1999Wf/Dialogue/MarieDialogue_rom.dialogue" [label="Initiate conversation MarieRoatheFail in /Lotus/Types/Gameplay/1999Wf/Dialogue/MarieDialogue_rom.dialogue",color=orange];
		"Initiate conversation MarieRoatheFail in /Lotus/Types/Gameplay/1999Wf/Dialogue/MarieDialogue_rom.dialogue" -> "Chat ends.";
