digraph {
	"LyonFlirt begins." [color=orange];
		"LyonFlirt begins." -> j1963592935;
		"LyonFlirt begins." -> j2230659102;
		"LyonFlirt begins." -> j382729048;
	j1963592935 [label="¿Lyon? ¿Podemos hablar? ",shape=box,color=red];
		j1963592935 -> j109345073;
	j2230659102 [label="¿Lyon? Lo siento muchísimo si lo que dije te incomodó. No era mi intención.",shape=box,color=red];
		j2230659102 -> j2604074275;
	j382729048 [label="[Fin.]",shape=box,color=red];
		j382729048 -> j2883342425;
	j109345073 [label="¿De qué te gustaría hablar, Viajero?",shape=box,color=blue];
		j109345073 -> j1480673115;
	j2604074275 [label="Supongo entonces que simplemente me queda preguntarme: si no estabas coqueteando conmigo para incomodarme y divertirte... ¿por qué estabas coqueteando en primer lugar?",shape=box,color=blue];
		j2604074275 -> j596368088;
		j2604074275 -> j3246945231;
		j2604074275 -> j1889826551;
	j2883342425 [label="Boolean LyonFlirtIgnored is now true.",color=orange];
		j2883342425 -> "Chat ends.";
	j1480673115 [label="¿De tus comentarios coquetos que son solo para tu propio entretenimiento? ¿O prefieres pasar a otros temas?",shape=box,color=blue];
		j1480673115 -> j127867764;
		j1480673115 -> j2256932090;
		j1480673115 -> j1889826551;
	j596368088 [label="Me interesas, Lyon. Es así de simple.",shape=box,color=red];
		j596368088 -> j2581614565;
	j3246945231 [label="No sé qué me pasó, Lyon. Claramente todo esto fue un error. Lo siento mucho.",shape=box,color=red];
		j3246945231 -> j3147282384;
	j1889826551 [label="Lo que dije... lo decía en serio. Pero todo esto va demasiado rápido, lo entiendo.",shape=box,color=red];
		j1889826551 -> j3147282384;
	"Chat ends." [color=orange];
	j127867764 [label="No estaba coqueteando contigo para divertirme, Lyon. Lamento si pensaste que era así.",shape=box,color=red];
		j127867764 -> j3147282384;
	j2256932090 [label="No quería ofenderte, solo estaba bromeando. Lo siento.",shape=box,color=red];
		j2256932090 -> j1821592168;
	j2581614565 [label="Y no es mutuo. Es así de simple.",shape=box,color=blue];
		j2581614565 -> "Chat ends.";
	j3147282384 [label="Yo... Perdóname, Viajero.",shape=box,color=blue];
		j3147282384 -> j3754480367;
	j1821592168 [label="Ya veo.",shape=box,color=blue];
		j1821592168 -> "Chat ends.";
	j3754480367 [label="Y perdona mi franqueza una vez más cuando expreso todo lo que ha llegado a abrumar mi mente últimamente:",shape=box,color=blue];
		j3754480367 -> j2589805534;
	j2589805534 [label="Ahora me encuentro rodeado de extraños y bestias parlantes en un mundo de locura fantástica y una matanza aparentemente interminable y desenfrenada.",shape=box,color=blue];
		j2589805534 -> j47749457;
	j47749457 [label="Todo lo que conocía ha sido arrasado por los brillantes rayos de \"Luz de Jade\", \"el Imperio Orokin\" y \"el Vacío\", y se ve amenazado por \"el Murmullo\".",shape=box,color=blue];
		j47749457 -> j2613626613;
	j2613626613 [label="Así que, discúlpame si encuentro esta... propuesta de seducción tuya extrañamente ridícula por su ingenuidad. No te conozco ni confío en ti. De hecho, lo único que sé es lo que otros me han dicho.",shape=box,color=blue];
		j2613626613 -> j359753335;
	j359753335 [label="Lo que otros a quienes ni conozco ni en quienes confío todavía me han dicho.",shape=box,color=blue];
		j359753335 -> j740210860;
	j740210860 [label="Todo esto, mientras tanto, no son más que las fuerzas externas que se acumulan ante Marie y ante mí, por no hablar de todo lo demás con lo que lidio y que tú no puedes ver.",shape=box,color=blue];
		j740210860 -> j3176921210;
	j3176921210 [label="Agradezco tu sinceridad. Sé lo que intentas y te felicito por ello. Espero que si llega el momento en que... reconsidere tu oferta, siga en pie.",shape=box,color=blue];
		j3176921210 -> j1332603149;
		j3176921210 -> j2853455418;
		j3176921210 -> j929389896;
	j1332603149 [label="No prometo nada, sacerdote.",shape=box,color=red];
		j1332603149 -> j1585341157;
	j2853455418 [label="En palabras de un querido amigo: \"Soy terco, compa\".",shape=box,color=red];
		j2853455418 -> j2905472926;
	j929389896 [label="Lo estará.",shape=box,color=red];
		j929389896 -> j2840550909;
	j1585341157 [label="Por supuesto. No se esperaba.",shape=box,color=blue];
		j1585341157 -> j970393242;
	j2905472926 [label="Boolean LyonFlirtOffer is now true.",color=orange];
		j2905472926 -> j1695554335;
	j2840550909 [label="Boolean LyonFlirtOffer is now true.",color=orange];
		j2840550909 -> j2922465597;
