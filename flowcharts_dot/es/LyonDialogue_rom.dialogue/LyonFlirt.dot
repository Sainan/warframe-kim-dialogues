		j1695554335 -> j809638730;
	j2922465597 [label="Boolean DrifterLyon is now true.",color=orange];
		j2922465597 -> j3242576980;
	j1818414167 [label="Hasta luego.",shape=box,color=blue];
		j1818414167 -> j944546954;
	j809638730 [label="Yo... bueno... entonces...",shape=box,color=blue];
