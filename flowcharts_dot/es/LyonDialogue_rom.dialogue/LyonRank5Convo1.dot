		j1242024200 -> j652232906 [label="false",color=purple];
	j1689996124 [label="Pero... eso... no es quien soy. Y no es quien debería ser. Debo permanecer como esto... un bastión roto, este escudo fragmentado...",shape=box,color=blue];
		j1689996124 -> j2278873373;
	j3437244848 [label="Ya te he atrapado en una mentira. Aunque no sé el propósito de esta, me temo que ya has roto mi habilidad para confiar en ti.",shape=box,color=blue];
		j3437244848 -> j2646185400;
	j2666748520 [label="Lo cual sé que no es del todo raro en mí, sin embargo, siento que debería responder a esto de una manera...",shape=box,color=blue];
