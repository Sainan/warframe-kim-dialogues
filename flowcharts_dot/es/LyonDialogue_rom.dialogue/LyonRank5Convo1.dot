		j3626627435 -> j202800200 [label="false",color=purple];
	j2911826579 [label="Antes mencionaste que querías hablar sobre el hecho de que realmente no creo que la Indiferencia sea un \"dios real\". ¿Es ahora un buen momento?",shape=box,color=red];
		j2911826579 -> j2015269407;
	j202800200 [label="[Fin]",shape=box,color=red];
		j202800200 -> "Chat ends.";
	j4072869206 [label="El otro día me preguntaste sobre la encarnación conceptual y sobre la Indiferencia. ¿Hay algo que te preocupe?",shape=box,color=red];
		j4072869206 -> j819317208;
	j342426813 [label="Roathe está convencido de que el Hombre en la Pared no es un dios real. Que es producto de una \"corporización conceptual\". ¿Qué opinas?",shape=box,color=red];
		j342426813 -> j3315578324;
	j1013080835 [label="Lyon, ¿Qué es lo que pasa entre Roathe y tú? Sólo he averiguado algo de información sobre ello.",shape=box,color=red];
		j1013080835 -> j2904364031;
	j2015269407 [label="No estoy seguro si cualquier momento es un \"buen\" momento para discutir lo que me ha casuado este tangible problema, Viajero.",shape=box,color=blue];
		j2015269407 -> j846454708;
	"Chat ends." [color=orange];
	j819317208 [label="Hay muchas cosas que me molestan en demasía, Viajero. El tema de la Indiferencia y la Encarnación Conceptual, me temo, es solo una de ellas.",shape=box,color=blue];
		j819317208 -> j3512688910;
	j3315578324 [label="El problema, Viajero, es que no lo sé. Si supiera la respuesta, no me estaría destrozando con tal debate interno.",shape=box,color=blue];
		j3315578324 -> j169012143;
	j2904364031 [label="Te lo resumiré, aunque me sorprende que hayas evitado sus quejas en el tema. Se emociona demasiado al compartirlas cada que se le presenta la oportunidad.",shape=box,color=blue];
		j2904364031 -> j3798895154;
	j846454708 [label="Pero, por lo tanto, es un \"buen\" momento como cualquier otro. Me intrigó que parece que estás del lado de Roathe en que crees que la Indiferencia no era un dios verdadero.",shape=box,color=blue];
		j846454708 -> j169012143;
	j3512688910 [label="O potencialmente dos, dependiendo en como quieras interpretar la situación. Aunque supongo que es ese el meollo del asunto.",shape=box,color=blue];
		j3512688910 -> j169012143;
	j169012143 [label="Sin embargo, debería... empezar desde el principio. No vas a entender bien el por qué este tema es tan importante para mí si no tienes el contexto...",shape=box,color=blue];
		j169012143 -> j1237434771;
	j3798895154 [label="Él cree que la Indiferencia no es un dios del Vacío, en ningún sentido de la palabra, y que era un hecho fabricado por Entrati y todos aquellos con quienes interactuaron después...",shape=box,color=blue];
		j3798895154 -> j1024512176;
	j1237434771 [label="Soy un hermano de Lua. He dedicado mi vida a venerarla. Toda mi vida, he creído en esto.",shape=box,color=blue];
		j1237434771 -> j3586951683;
	j1024512176 [label="Fue creada desde el Vacío por medio de lo que tu conoces como \"Encarnación Conceptual\". ",shape=box,color=blue];
		j1024512176 -> j2465521159;
	j3586951683 [label="Y a lo largo de todos mis años desde que llegué a la iglesia, me he mantenido firme a mi fe, seguro de que mi sufrimiento, dolor y visiones...",shape=box,color=blue];
		j3586951683 -> j64242591;
	j2465521159 [label="Creo que de la misma manera en la que creaste Duviri.",shape=box,color=blue];
		j2465521159 -> j169012143;
	j64242591 [label="Han estado a su servicio. Que han sido en su nombre. Y que le han servido a ella.",shape=box,color=blue];
		j64242591 -> j1852254106;
	j1852254106 [label="Eso fue hasta que... el \"Cardinal Dimanche\" reveló ser Albrecht Entrati.",shape=box,color=blue];
		j1852254106 -> j2742806842;
	j2742806842 [label="Y nos dijo la verdad de quién era, la historia de sus fechorías con el Vacío, y todo lo que conllevaba. Específicamente... todo lo que resultó de ello.",shape=box,color=blue];
		j2742806842 -> j3208852753;
		j2742806842 -> j767407225;
	j3208852753 [label="La Indiferencia.",shape=box,color=red];
		j3208852753 -> j1041967864;
	j767407225 [label="¿Y?",shape=box,color=red];
		j767407225 -> j4205394173;
	j1041967864 [label="Es correcto. Nos contó sobre el desdeñoso ser que lo recibió, de los dedos que recuperó de ese lugar que parecía su laboratorio.",shape=box,color=blue];
		j1041967864 -> j2249540345;
	j4205394173 [label="Nos habló de su descenso al vacío en la campana de seriglás. Del lugar que parecía su laboratorio. ",shape=box,color=blue];
		j4205394173 -> j2249540345;
	j2249540345 [label="Además, nos dijo del gran terror que sintió, sabiendo que tenía un desatado ser que no podía seguirlo a través del espacio, sino a través del tiempo.",shape=box,color=blue];
		j2249540345 -> j3125847637;
	j3125847637 [label="Un dios de la nada. Un ser que debió ser contenido. Una criatura de la cual él tenía piezas, que rasguñaría paredes para liberarse.",shape=box,color=blue];
		j3125847637 -> j964010503;
	j964010503 [label="Un terrible e incontenible dios que estaba, y que también no estaba, ya libre.",shape=box,color=blue];
		j964010503 -> j1454170960;
		j964010503 -> j2466506002;
	j1454170960 [label="¿Qué quieres decir?",shape=box,color=red];
		j1454170960 -> j3826452011;
	j2466506002 [label="¿Con qué \"estaba\" y que también \"no estaba\" ya libre?",shape=box,color=red];
		j2466506002 -> j3826452011;
	j3826452011 [label="Check boolean LyonRell1",color=orange];
		j3826452011 -> j1575015823 [label=true,color=green];
		j3826452011 -> j48447413 [label=false,color=brown];
	j1575015823 [label="El tiempo está... enredado, para alguien como yo, en el estado en el que estoy ahora. Es difícil de describir. Intente explicarlo, y he fallado miserablemente.",shape=box,color=blue];
		j1575015823 -> j934928254;
	j48447413 [label="El tiempo está... enredado, para alguien como yo, en el estado en el que estoy ahora. Es difícil de describir, y lo estoy haciendo muy mal.",shape=box,color=blue];
		j48447413 -> j934928254;
	j934928254 [label="Preferiría explicar los detalles en otro momento, ya que ese no es el punto de lo que trato de abordar hoy.",shape=box,color=blue];
		j934928254 -> j366078008;
	j366078008 [label="Check boolean LyonRell1",color=orange];
		j366078008 -> j2402186271 [label=true,color=green];
		j366078008 -> j2090224568 [label=true,color=green];
		j366078008 -> j2164315782 [label=true,color=green];
		j366078008 -> j2090224568 [label=false,color=brown];
		j366078008 -> j2164315782 [label=false,color=brown];
	j2402186271 [label="Pero si estás escuchando, o escuchaste, Rell... quiero hablar sobre ello.",shape=box,color=red];
		j2402186271 -> j563527034;
	j2090224568 [label="Está bien. Estás a cargo.",shape=box,color=red];
		j2090224568 -> j272566948;
	j2164315782 [label="Yo si quisiera profundizar en el tema...",shape=box,color=red];
		j2164315782 -> j1215915516;
	j563527034 [label="Lo sé. Y yo he estado evitando el tema. Sólo su nombre...",shape=box,color=blue];
		j563527034 -> j1462850542;
	j272566948 [label="Ya sé que he estado evitando el tema y me disculpo. Pero es que es probable que eso me lleve a tener una visión de la cual no estoy seguro si me podré recuperar fácilmente.",shape=box,color=blue];
		j272566948 -> j1671569574;
	j1215915516 [label="Te aseguro que lo abordaremos. Ya sé que he estado evitando el tema y me disculpo. Pero es que es probable que eso me lleve a tener una visión de la cual no estoy seguro si me podré recuperar fácilmente.",shape=box,color=blue];
		j1215915516 -> j1671569574;
	j1462850542 [label="amenaza con...",shape=box,color=blue];
		j1462850542 -> j1286811534;
	j1671569574 [label="No quiero tener que, una vez más, interrumpir esta conversación porque no soy capaz de continuar debido a mis propias dolencias.",shape=box,color=blue];
		j1671569574 -> j747735126;
		j1671569574 -> j3778143140;
		j1671569574 -> j2645841850;
	j1286811534 [label="trae consigo imágenes de un hombre encadenado...",shape=box,color=blue];
		j1286811534 -> j3668978757;
	j747735126 [label="No creo que llamaría \"débil\" a alguien que ha tenido que soportar lo que tú, Lyon.",shape=box,color=red];
		j747735126 -> j3503803353;
	j3778143140 [label="Débil es una terrible manera de decir \"maldecido con visiones que no pidió tener\". Pero como quieras.",shape=box,color=red];
		j3778143140 -> j3503803353;
	j2645841850 [label="Tú sabes de lo que eres capaz, yo te seguiré.",shape=box,color=red];
		j2645841850 -> j824315387;
	j3668978757 [label="cubierto de sangre...",shape=box,color=blue];
		j3668978757 -> j1521935921;
	j3503803353 [label="Aprecio el sentimiento. Pero sé que no soy más que un vitral hecho pedazos, en el mejor de los casos. Y aquí me preguntó a donde se habrán ido todos esos fragmentos.",shape=box,color=blue];
		j3503803353 -> j2286488688;
	j824315387 [label="Gracias. Me maravilla tu paciencia. Pero sé que no soy más que un vitral hecho pedazos, en el mejor de los casos. Y aquí me preguntó a donde se habrán ido todos esos fragmentos.",shape=box,color=blue];
		j824315387 -> j2286488688;
	j1521935921 [label="sus tendones y carne cortados...",shape=box,color=blue];
		j1521935921 -> j3494968873;
	j2286488688 [label="Cada vez que encuentro uno de los que he perdido, tengo más probabilidades de cortarme con los bordes que de lograr ponerlo de nuevo en su lugar.",shape=box,color=blue];
		j2286488688 -> j2445891695;
	j3494968873 [label="por favor haz que se detenga...",shape=box,color=blue];
		j3494968873 -> j549519579;
	j2445891695 [label="A veces me preguntó si sería mejor convertirme en uno de esos Harrows con mirada vacía que veo en el ojo de mi mente, extendiéndose tan lejos como mis pesadillas lo permitan.",shape=box,color=blue];
		j2445891695 -> j3090338735;
	j549519579 [label="sus rostros\nmiles... incontables\nvacíos y rotos\nencerrados en silencio\npor siempre en una oración destrozada\nen lo que me convertiré",shape=box,color=blue];
		j549519579 -> j733604128;
		j549519579 -> j1925449241;
