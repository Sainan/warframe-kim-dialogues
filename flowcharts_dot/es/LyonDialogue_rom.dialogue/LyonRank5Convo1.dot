		j3090338735 -> j3125955458 [label="false",color=purple];
	j733604128 [label="Respira, Lyon. Respira. No están realmente ahí.",shape=box,color=red];
		j733604128 -> j4207784050;
	j1925449241 [label="Lo... lo siento, Lyon. Enfócate en la pantalla. Aquí estoy.",shape=box,color=red];
		j1925449241 -> j3844201540;
	j1175894762 [label="Sé que esto es una horrible carga que se te encomendó llevar. Y tal vez no esté bien. Pero no conozco la salida.",shape=box,color=red];
		j1175894762 -> j1033591462;
	j3822332918 [label="Tú significas el mundo para Marie. Te has convertido en un gran amigo para mí. Creo que hasta Roathe te extrañaría, aunque él no lo admitiría.",shape=box,color=red];
		j3822332918 -> j1101840853;
	j3125955458 [label="[Confesar sentimientos] Me rompería el corazón si dejaras que eso te pasé a ti, Lyon. Tú... tú me importas.",shape=box,color=red];
		j3125955458 -> j670503274;
	j4207784050 [label="ahí es donde estás mal\nestán ahí\ny jamás me dejarán\nnunca más\nentrati se encargó de eso\nperdóname",shape=box,color=blue];
		j4207784050 -> j2862131335;
	j3844201540 [label="destrozándome \ndesgarrándome hasta los huesos\n¿por qué? ¿con qué fin?\n¿de quién es el hambre que esto alimenta?",shape=box,color=blue];
		j3844201540 -> j375946656;
		j3844201540 -> j2195964979;
	j1033591462 [label="No sin recurrir a... lo impensable. O a eso.",shape=box,color=red];
		j1033591462 -> j413674915;
	j1101840853 [label="Eres querido. Eres amado. Tienes familia y amigos. Aunque no lo sientas así todo el tiempo.",shape=box,color=red];
		j1101840853 -> j3333937555;
	j670503274 [label="Estoy seguro de que bromeas. No puede ser que lo digas en serio, ¿después de todo lo que has presenciado? O has perdido la razón o tu compasión ha superado tus sentidos.",shape=box,color=blue];
		j670503274 -> j2851318896;
		j670503274 -> j4072895122;
	j2862131335 [label="+10 Chemistry",color=orange];
		j2862131335 -> j4006363057;
	j375946656 [label="La de nadie. Ya no tienes por qué sufrir de esta manera. Déjalo ir.",shape=box,color=red];
		j375946656 -> j3133978802;
	j2195964979 [label="Lo sé. Sé que duele. Lo siento. En verdad lo siento. Sal de la habitación.",shape=box,color=red];
		j2195964979 -> j1348389548;
	j413674915 [label="+10 Chemistry",color=orange];
		j413674915 -> j2082622805;
	j3333937555 [label="No estás solo, Lyon. Y se te extrañaría.",shape=box,color=red];
		j3333937555 -> j3747686737;
	j2851318896 [label="No, Lyon. Lo digo en serio. Significas el mundo para mí, y lo que quiero es que de alguna manera me puedas creer.",shape=box,color=red];
		j2851318896 -> j1449270038;
	j4072895122 [label="Puede... que tengas razón. Tal vez este no es el momento.",shape=box,color=red];
		j4072895122 -> j694737307;
	j4006363057 [label="Boolean LyonRell2b is now true.",color=orange];
		j4006363057 -> "Chat ends.";
	j3133978802 [label="si tan solo fuera tan simple\nesas cadenas han sido mías por tanto tiempo\npor tanto tiempo como el de un lenguaje\npor tanto tiempo como mi propio nombre\nperdóname",shape=box,color=blue];
		j3133978802 -> j2862131335;
	j1348389548 [label="Date la vuelta, camina y salte de la habitación en tu mente.",shape=box,color=red];
		j1348389548 -> j2521320704;
	j2082622805 [label="Veo a M. Necraloid y escucho historias sobre M. Ordis y M. Otak. Pienso en los warframes vacíos con sus pensamientos arrancados de sus cráneos.",shape=box,color=blue];
		j2082622805 -> j798816541;
	j3747686737 [label="+10 Chemistry",color=orange];
		j3747686737 -> j1992869092;
	j1449270038 [label="Yo.",shape=box,color=blue];
		j1449270038 -> j2228720352;
	j694737307 [label="Bien. Me alegro de que hayas reaccionado a tu propia locura momentánea. Debe ser contagioso después de todo. Tal vez deberíamos tomarnos un descanso de este dispositivo, me temo que ha empezado a podrir tu mente.",shape=box,color=blue];
		j694737307 -> "Chat ends.";
	j2521320704 [label="sí\nestarán ahí en otro momento\nesta habitación de sangre y cadenas\nde espera\nde una espera interminable",shape=box,color=blue];
		j2521320704 -> j2137503795;
	j798816541 [label="Check boolean LyonPainOff",color=orange];
		j798816541 -> j2112753164 [label=true,color=green];
		j798816541 -> j264321332 [label=false,color=brown];
	j1992869092 [label="Gracias... pero me pregunto, ¿por cuánto tiempo, antes de que el dolor se convierta en otra carga más fácil de soportar con el tiempo?",shape=box,color=blue];
		j1992869092 -> j2082622805;
	j2228720352 [label="Evaluate expressions",color=orange];
