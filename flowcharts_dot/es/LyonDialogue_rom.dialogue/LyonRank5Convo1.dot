		j1417292961 -> j1416794785;
	j3522764704 [label="Estoy bien, podemos continuar, gracias. Ya ha pasado, como siempre. Estas... visiones son como nubes que pasan sobre Lua. Pueden ser totalmente oscuras pero usualmente son breves.",shape=box,color=blue];
