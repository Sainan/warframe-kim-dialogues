		j2228720352 -> j749818869 [label="false",color=purple];
	j2137503795 [label="Debo pedir tu perdón. Hay momentos en donde mi lucidez me falla y detesto cuando otros son testigos de ello.",shape=box,color=blue];
		j2137503795 -> j1242024200;
	j2112753164 [label="Sería tan fácil rendirse. Claudicar. Depositar mi agonía en el altar del sufrimiento y no decir nada más.",shape=box,color=blue];
		j2112753164 -> j1689996124;
	j264321332 [label="Sería tan fácil rendirse. Claudicar. Depositar mi agonía en el altar del sufrimiento y no decir nada más. O hacer algo mucho peor, hacer lo que muchos temen que pueda hacer con una espada en la gran oscuridad de la noche.",shape=box,color=blue];
		j264321332 -> j1689996124;
	j1540415985 [label="Sólo hay un problema, Viajero ¿Cómo puedo tomar tus palabras como verdaderas cuando sé que has mentido?",shape=box,color=blue];
		j1540415985 -> j3437244848;
	j2141867474 [label="Aunque me siento halagado, me temo que mi respuesta es simple e inequívocamente no.",shape=box,color=blue];
