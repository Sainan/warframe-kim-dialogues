digraph {
	"LyonRank4Convo2 begins." [color=orange];
		"LyonRank4Convo2 begins." -> j3611551588;
		"LyonRank4Convo2 begins." -> j76612824;
		"LyonRank4Convo2 begins." -> j2429168889;
	j3611551588 [label="¿Cómo es posible que tú y Marie puedan conciliar el ser sacerdote y monja, pero también… cometer actos de violencia?",shape=box,color=red];
		j3611551588 -> j134232138;
		j3611551588 -> j3366660597;
		j3611551588 -> j1117948502;
	j76612824 [label="¿Puedo hacerte una pregunta un poco extraña, Lyon?",shape=box,color=red];
		j76612824 -> j679635720;
	j2429168889 [label="[Fin.]",shape=box,color=red];
		j2429168889 -> "Chat ends.";
	j134232138 [label="Oigo a Marie gritar \"¡païens!\" y lanzarse a la pelea, y... aun así, me cuesta creer que sea el tipo de persona que condena a alguien por tener creencias diferentes. Me imagino que tú tampoco eres muy diferente. Está claro que te tiene en muy alta estima.",shape=box,color=red];
		j134232138 -> j2773893676;
	j3366660597 [label="¿Cómo se sentiría tu iglesia con lo que tú y Marie están haciendo aquí? ¿Con respecto a lo que se les pide que hagan en su nombre?",shape=box,color=red];
		j3366660597 -> j3683999620;
	j1117948502 [label="Los miro a ti y a Marie en el campo de batalla, y luego hablo con ella en privado, y los veo leyendo libros tranquilamente... y supongo que me está costando alinear a esos individuos en mi mente.",shape=box,color=red];
	j679635720 [label="Si te parece que describir nuestra situación actual es simplemente \"extraña\", me impresiona tu fortaleza o me consterna tu falta de vocabulario. Sin embargo, sospecho que es lo primero.",shape=box,color=blue];
		j679635720 -> j350982998;
	"Chat ends." [color=orange];
	j2773893676 [label="Tienes toda la razón. Marie no es de las que condenan a alguien por albergar en su corazón a un antiguo dios de los árboles; en cambio, buscaría descubrir qué creencias compartía con ellos.",shape=box,color=blue];
		j2773893676 -> j2282161637;
	j3683999620 [label="En su época se libraron muchas guerras santas en nombre de Sol o Lua. Sangrientas \"cruzadas\" para expulsar a los paganos, \"tomar tierra santa\" o cualquier razonamiento artificioso que prevaleciera en la época.",shape=box,color=blue];
		j3683999620 -> j3946875054;
	j350982998 [label="+5 Chemistry",color=orange];
		j350982998 -> j3946634030;
	j2282161637 [label="¿Es acaso que el árbol no se nutre de la luz de Sol? ¿No hay un punto en común donde pueda compartir el pan con ellos? Es más propensa a sentarse y escuchar sus historias que a intentar perjudicarlos por su fe.",shape=box,color=blue];
		j2282161637 -> j2545650760;
	j3946875054 [label="La Ortodoxia Luminaria no tiene ejército ni libra guerras. No impiden que quienes pertenecen a su orden actúen ni protejan a otros.",shape=box,color=blue];
		j3946875054 -> j1343091325;
	j3946634030 [label="Es decir, sí, adelante. No puedes hacerme sentir más extraño preguntándome lo que te intriga.",shape=box,color=blue];
		j3946634030 -> j134232138;
		j3946634030 -> j3366660597;
		j3946634030 -> j1117948502;
	j2545650760 [label="Cuando ella se enfrenta a su enemigo en el campo de batalla, creo que es una de dos cosas: o se está divirtiendo un poco, actuando como una antigua defensora, imaginándose a sí misma con una brillante armadura de un caballero del Sol -",shape=box,color=blue];
		j2545650760 -> j3475282207;
	j1343091325 [label="When Marie engages with her foes upon the battlefield, I believe it is one of two things: either, she is having a bit of fun, play-acting as an ancient crusader, imagining herself in the shining armor of a Knight of Sol -",shape=box,color=blue];
		j1343091325 -> j3475282207;
	j3475282207 [label="O, lo más probable, está recordando a Ástafor 8:23: \"Solas son las almas que buscan entrar en mi casa por la fuerza, porque son los expulsados de la luz de Sol\".",shape=box,color=blue];
		j3475282207 -> j3409153392;
	j3409153392 [label="En sus ojos, la violencia que comete es justa en el nombre de un bien mayor, como lo harías tú, como lo harían aquellos junto a quienes luchan, supongo. ",shape=box,color=blue];
		j3409153392 -> j2221641561;
	j2221641561 [label="Y por eso, aquellos contra quienes ella lucha, independientemente de su religión, son expulsados ​​por el Sol. Incluso si llevan las vestiduras sagradas de su propia orden, a los ojos de ella, son paganos.",shape=box,color=blue];
		j2221641561 -> j4168579113;
		j2221641561 -> j1716069413;
	j4168579113 [label="He notado que te has alejado de esto. ¿Cómo te sientes con todo esto de las batallas?",shape=box,color=red];
		j4168579113 -> j4262846589;
	j1716069413 [label="Eso tiene sentido. Gracias.",shape=box,color=red];
		j1716069413 -> j1369771221;
	j4262846589 [label="Estoy siendo intencionadamente elusivo, Viajero.",shape=box,color=blue];
		j4262846589 -> j2918064125;
		j4262846589 -> j1962264807;
	j1369771221 [label="+5 Chemistry",color=orange];
		j1369771221 -> j1230560288;
	j2918064125 [label="Y estoy siendo muy persistente, sacerdote.",shape=box,color=red];
		j2918064125 -> j2573534659;
	j1962264807 [label="Está bien. Hoy tomaré lo que pueda conseguir.",shape=box,color=red];
		j1962264807 -> j1369771221;
	j1230560288 [label="Por si sirve de algo, Marie... me ha dicho que tienes buenas intenciones. Y le creo a ella, incluso cuando yo no lo puedo creer.",shape=box,color=blue];
		j1230560288 -> j615979826;
	j2573534659 [label="+10 Chemistry",color=orange];
		j2573534659 -> j3371672424;
	j615979826 [label="Al final, solo puedo pedirte paciencia. Lua sabe que casi siempre me falta.",shape=box,color=blue];
		j615979826 -> j944546954;
	j3371672424 [label="Muy bien. Si no te dejas disuadir, ¿y tienes tanta curiosidad? No me preocupa tanto la muerte que causo como... tal vez podrías esperar.",shape=box,color=blue];
		j3371672424 -> j520204221;
	j944546954 [label="-F. Lyon Allard",shape=box,color=blue];
		j944546954 -> "Chat ends.";
	j520204221 [label="Or that one might feel is \"proper\" for a man of the cloth and a scholar such as I.",shape=box,color=blue];
		j520204221 -> j2169526290;
		j520204221 -> j3056551528;
	j2169526290 [label="I've known more war than peace in my life, Lyon. If I let it trouble me, I don't think I would still be here. But that isn't to say it doesn't still come with a real burden - a real cost.",shape=box,color=red];
		j2169526290 -> j3467249208;
	j3056551528 [label="I'm sure the others have told you who I am. What I am. Where I've come from. The death that follows me - the death I've come from. The death that defines me. Do you think anything you feel will surprise me?",shape=box,color=red];
		j3056551528 -> j158781669;
	j3467249208 [label="Add 1 to Thermostat counter",color=orange];
		j3467249208 -> j2911912479;
	j158781669 [label="Add -1 to Thermostat counter",color=orange];
		j158781669 -> j1894648924;
	j2911912479 [label="Yes, it does.",shape=box,color=blue];
		j2911912479 -> j1484276980;
		j2911912479 -> j3688443965;
	j1894648924 [label="Yes, I do.",shape=box,color=blue];
		j1894648924 -> j1484276980;
		j1894648924 -> j3688443965;
	j1484276980 [label="I'm sorry. I feel I've upset you. That wasn't my intention.",shape=box,color=red];
		j1484276980 -> j2509781752;
	j3688443965 [label="Do you... care to elaborate?",shape=box,color=red];
		j3688443965 -> j1586803457;
	j2509781752 [label="You are not to blame, Drifter. I am, as our brothers and sisters from Libertatia might say, a \"hard nut to crack.\"",shape=box,color=blue];
		j2509781752 -> j2868871722;
	j1586803457 [label="The horrors that echo within my mind seem to know no boundaries. I witness chains of human sinew that once oozed with fresh crimson, turned brittle and blackened.",shape=box,color=blue];
		j1586803457 -> j619593295;
	j2868871722 [label="I am merely a besieged individual. I hold the wall. To open the gate is to threaten the integrity of the defenses.",shape=box,color=blue];
		j2868871722 -> j3292120761;
		j2868871722 -> j1360228141;
	j619593295 [label="I see a hundred thousand visages of my own self, similar but foreign. Hollowed caskets, corpses of twisted, broken human flesh, suspended in the veil between life and death.",shape=box,color=blue];
		j619593295 -> j3728128003;
	j3292120761 [label="I understand. When you're ready, we can talk.",shape=box,color=red];
		j3292120761 -> j292431206;
	j1360228141 [label="How do you mean?",shape=box,color=red];
		j1360228141 -> j1586803457;
	j3728128003 [label="Expressions locked in a mask of empty repose. But in the flickering remains of their souls, embers that linger and do not die, I hear them screaming. Endlessly howling for retribution. For freedom.",shape=box,color=blue];
		j3728128003 -> j2666648367;
	j292431206 [label="I am starting to come to the distinct impression that I do not have a choice in this matter.",shape=box,color=blue];
		j292431206 -> j988178368;
	j2666648367 [label="For death.",shape=box,color=blue];
		j2666648367 -> j2593910760;
	j988178368 [label="+15 Chemistry",color=orange];
		j988178368 -> j887683045;
	j2593910760 [label="These visions haunt my waking hours. My dreams. I have no nightmares, for that is all I experience - all I have become.",shape=box,color=blue];
		j2593910760 -> j1274675553;
	j887683045 [label="But, for what it is worth, Marie... has told me you mean well. And I believe her, even when I do not believe myself.",shape=box,color=blue];
		j887683045 -> j1407668417;
	j1274675553 [label="Check boolean LyonPainOff",color=orange];
		j1274675553 -> j1935970551 [label=true,color=green];
		j1274675553 -> j241308745 [label=false,color=brown];
	j1407668417 [label="All I may do is beg your patience, in the end. Lua knows I run short of it with myself most days.",shape=box,color=blue];
		j1407668417 -> j3869357206;
	j1935970551 [label="Only when I sacrifice to the whispers that echo within my soul, is the world reflected to me in a manner similar to that which you might find familiar.",shape=box,color=blue];
		j1935970551 -> j3769690399;
	j241308745 [label="Only when I rend the flesh from my body as a sacrifice to the whispers that echo within my soul, is the world reflected to me in a manner similar to that which you might find familiar.",shape=box,color=blue];
		j241308745 -> j3769690399;
	j3869357206 [label="-F. Lyon Allard",shape=box,color=blue];
		j3869357206 -> j2522325746;
	j3769690399 [label="Kindly do not pretend to know of what I \"feel,\" Drifter. I fear you have only begun to understand.",shape=box,color=blue];
		j3769690399 -> j4043560303;
		j3769690399 -> j1287152803;
		j3769690399 -> j2255755756;
	j2522325746 [label="Boolean LyonVisions2d is now true.",color=orange];
		j2522325746 -> "Chat ends.";
	j4043560303 [label="I - I'm sorry. No, I didn't know.",shape=box,color=red];
		j4043560303 -> j2902539613;
	j1287152803 [label="And there is a lot of horror and pain that I have seen that you do not understand either, Lyon.",shape=box,color=red];
		j1287152803 -> j945946918;
	j2255755756 [label="I'm sorry if you feel I spoke out of turn. But I want to understand. These visions of yours...",shape=box,color=red];
		j2255755756 -> j102031654;
	j2902539613 [label="Yes. Well. I have survived these long years. I will hold strong a few more, I am certain. You needn't worry over much.",shape=box,color=blue];
		j2902539613 -> j4270520825;
	j945946918 [label="I am most certain you have, seeing some of it reflected in the imagery of this place. But do you think yourself paramount? Supreme Knower of All Horrors and All Suffering?",shape=box,color=blue];
		j945946918 -> j3253682639;
		j945946918 -> j39295631;
	j102031654 [label="Yes. Well. I have withstood them all my years. I will hold strong a few more, I am certain. You needn't worry over much.",shape=box,color=blue];
		j102031654 -> j4270520825;
	j4270520825 [label="Boolean LyonVisions2a is now true.",color=orange];
		j4270520825 -> j431200296;
		j4270520825 -> j288742428;
	j3253682639 [label="I'm saying I might be able to sympathize more with what you're experiencing than you think.",shape=box,color=red];
		j3253682639 -> j1622300909;
	j39295631 [label="I'm saying I've been through a lot of death and horror, Lyon. So I don't enjoy being spoken down to over it.",shape=box,color=red];
		j39295631 -> j2031743382;
	j431200296 [label="What you're describing, Lyon... did that vision start before or after you were a protoframe?",shape=box,color=red];
		j431200296 -> j746167634;
	j288742428 [label="Can we talk about this again? Please?",shape=box,color=red];
		j288742428 -> j2546419310;
	j1622300909 [label="Boolean LyonVisions2b is now true.",color=orange];
		j1622300909 -> j1011438956;
	j2031743382 [label="Boolean LyonVisions2c is now true.",color=orange];
		j2031743382 -> j3316146926;
	j746167634 [label="Were that as simple a question as you believe it to be. Regardless, it is not one I am willing to answer today. I feel a headache coming on.",shape=box,color=blue];
		j746167634 -> j3814614150;
	j2546419310 [label="I am starting to come to the distinct impression that I do not have a choice in this matter.",shape=box,color=blue];
		j2546419310 -> j3814614150;
	j1011438956 [label="It may seem strange to you that I am not in search of sympathy, Drifter. Answers are what I seek. Surety. Firmament, when all is illusion and lies.",shape=box,color=blue];
		j1011438956 -> j2351368684;
		j1011438956 -> j3520552128;
	j3316146926 [label="Than allow me to bow down at your feet. Praise you for all you have endured. Wonder how you are still sane for all you have witnessed.",shape=box,color=blue];
		j3316146926 -> j1653090935;
	j3814614150 [label="+10 Chemistry",color=orange];
		j3814614150 -> j1096335261;
	j2351368684 [label="I'll do what I can.",shape=box,color=red];
		j2351368684 -> j3971191360;
	j3520552128 [label="Then, maybe I can help you with that. Can we talk about this again? Please?",shape=box,color=red];
		j3520552128 -> j2546419310;
	j1653090935 [label="And marvel over how you still spare time for all the rest of us who you view so far beneath your vaulted status.",shape=box,color=blue];
		j1653090935 -> "Chat ends.";
	j1096335261 [label="But, for what it is worth, Marie... has told me you mean well. And I believe her, even when I do not believe myself.",shape=box,color=blue];
		j1096335261 -> j2959315451;
	j3971191360 [label="+5 Chemistry",color=orange];
		j3971191360 -> j497522596;
	j2959315451 [label="All I may do is beg your patience, in the end. Lua knows I run short of it with myself most days.",shape=box,color=blue];
		j2959315451 -> j944546954;
	j497522596 [label="That is all one can ask for, is it not?",shape=box,color=blue];
		j497522596 -> "Chat ends.";
}