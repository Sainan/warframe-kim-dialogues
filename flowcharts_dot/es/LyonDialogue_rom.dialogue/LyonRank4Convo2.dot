digraph {
	graph [fontname="Roboto Condensed"];
	node [fontname="Roboto Condensed"];
	edge [fontname="Roboto Condensed"];

	"LyonRank4Convo2 begins." [color=orange];
		"LyonRank4Convo2 begins." -> j3611551588;
		"LyonRank4Convo2 begins." -> j76612824;
		"LyonRank4Convo2 begins." -> j2429168889;
	j3611551588 [label="¿Cómo es posible que tú y Marie puedan conciliar el ser sacerdote y monja, pero también… cometer actos de violencia?",shape=box,color=red];
		j3611551588 -> j134232138;
		j3611551588 -> j3454768542;
		j3611551588 -> j206780970;
	j76612824 [label="¿Puedo hacerte una pregunta un poco extraña, Lyon?",shape=box,color=red];
		j76612824 -> j679635720;
	j2429168889 [label="[Fin.]",shape=box,color=red];
		j2429168889 -> "Chat ends.";
	j134232138 [label="Oigo a Marie gritar \"¡païens!\" y lanzarse a la pelea, y... aun así, me cuesta creer que sea el tipo de persona que condena a alguien por tener creencias diferentes. Me imagino que tú tampoco eres muy diferente. Está claro que te tiene en muy alta estima.",shape=box,color=red];
		j134232138 -> j2773893676;
	j3454768542 [label="¿Cómo se sentiría tu iglesia con lo que tú y Marie están haciendo aquí? ¿Con respecto a lo que se les pide que hagan en su nombre?",shape=box,color=red];
		j3454768542 -> j1697581881;
	j206780970 [label="Los miro a ti y a Marie en el campo de batalla, y luego hablo con ella en privado, y los veo leyendo libros tranquilamente... y supongo que me está costando alinear a esos individuos en mi mente.",shape=box,color=red];
		j206780970 -> j3784464177;
	j679635720 [label="Si te parece que describir nuestra situación actual es simplemente \"extraña\", me impresiona tu fortaleza o me consterna tu falta de vocabulario. Sin embargo, sospecho que es lo primero.",shape=box,color=blue];
		j679635720 -> j350982998;
	"Chat ends." [color=orange];
	j2773893676 [label="Tienes toda la razón. Marie no es de las que condenan a alguien por albergar en su corazón a un antiguo dios de los árboles; en cambio, buscaría descubrir qué creencias compartía con ellos.",shape=box,color=blue];
		j2773893676 -> j2282161637;
	j1697581881 [label="En su época se libraron muchas guerras santas en nombre de Sol o Lua. Sangrientas \"cruzadas\" para expulsar a los paganos, \"tomar tierra santa\" o cualquier razonamiento artificioso que prevaleciera en la época.",shape=box,color=blue];
		j1697581881 -> j3894258571;
	j3784464177 [label="Tienes toda la razón. Cuando Marie se enfrenta a sus enemigos en el campo de batalla, creo que es una de dos cosas: o se está divirtiendo un poco, actuando como una antigua defensora, imaginándose a sí misma con una brillante armadura de un caballero del Sol -",shape=box,color=blue];
		j3784464177 -> j3475282207;
	j350982998 [label="+5 Chemistry",color=orange];
		j350982998 -> j3946634030;
	j2282161637 [label="¿Es acaso que el árbol no se nutre de la luz de Sol? ¿No hay un punto en común donde pueda compartir el pan con ellos? Es más propensa a sentarse y escuchar sus historias que a intentar perjudicarlos por su fe.",shape=box,color=blue];
		j2282161637 -> j2545650760;
	j3894258571 [label="La Ortodoxia Luminaria no tiene ejército ni libra guerras. No impiden que quienes pertenecen a su orden actúen ni protejan a otros.",shape=box,color=blue];
		j3894258571 -> j35218409;
	j3475282207 [label="O, lo más probable, está recordando a Ástafor 8:23: \"Solas son las almas que buscan entrar en mi casa por la fuerza, porque son los expulsados de la luz de Sol\".",shape=box,color=blue];
		j3475282207 -> j3409153392;
	j3946634030 [label="Es decir, sí, adelante. No puedes hacerme sentir más extraño preguntándome lo que te intriga.",shape=box,color=blue];
		j3946634030 -> j134232138;
		j3946634030 -> j3454768542;
		j3946634030 -> j206780970;
	j2545650760 [label="Cuando ella se enfrenta a su enemigo en el campo de batalla, creo que es una de dos cosas: o se está divirtiendo un poco, actuando como una antigua defensora, imaginándose a sí misma con una brillante armadura de un caballero del Sol -",shape=box,color=blue];
		j2545650760 -> j3475282207;
	j35218409 [label="Cuando Marie se enfrenta a sus enemigos en el campo de batalla, creo que es una de dos cosas: o se está divirtiendo un poco, actuando como una antigua defensora, imaginándose a sí misma con una brillante armadura de un caballero de Sol...",shape=box,color=blue];
		j35218409 -> j3475282207;
	j3409153392 [label="En sus ojos, la violencia que comete es justa en el nombre de un bien mayor, como lo harías tú, como lo harían aquellos junto a quienes luchan, supongo. ",shape=box,color=blue];
		j3409153392 -> j2221641561;
	j2221641561 [label="Y por eso, aquellos contra quienes ella lucha, independientemente de su religión, son expulsados ​​por el Sol. Incluso si llevan las vestiduras sagradas de su propia orden, a los ojos de ella, son paganos.",shape=box,color=blue];
		j2221641561 -> j4168579113;
		j2221641561 -> j645322434;
	j4168579113 [label="He notado que te has alejado de esto. ¿Cómo te sientes con todo esto de las batallas?",shape=box,color=red];
		j4168579113 -> j4262846589;
	j645322434 [label="Eso tiene sentido. Gracias.",shape=box,color=red];
		j645322434 -> j2777889133;
	j4262846589 [label="Estoy siendo intencionadamente elusivo, Viajero.",shape=box,color=blue];
		j4262846589 -> j843318962;
		j4262846589 -> j1326786024;
	j2777889133 [label="+5 Chemistry",color=orange];
		j2777889133 -> j1727320699;
	j843318962 [label="Y estoy siendo muy persistente, sacerdote.",shape=box,color=red];
		j843318962 -> j1506590259;
	j1326786024 [label="Está bien. Hoy tomaré lo que pueda conseguir.",shape=box,color=red];
		j1326786024 -> j2777889133;
	j1727320699 [label="Por si sirve de algo, Marie... me ha dicho que tienes buenas intenciones. Y le creo a ella, incluso cuando yo no lo puedo creer.",shape=box,color=blue];
		j1727320699 -> j3325628293;
	j1506590259 [label="+10 Chemistry",color=orange];
		j1506590259 -> j575409882;
	j3325628293 [label="Al final, solo puedo pedirte paciencia. Lua sabe que casi siempre me falta.",shape=box,color=blue];
		j3325628293 -> j2084492712;
	j575409882 [label="Muy bien. Si no te dejas disuadir, ¿y tienes tanta curiosidad? No me preocupa tanto la muerte que causo como... tal vez podrías esperar.",shape=box,color=blue];
		j575409882 -> j2558171734;
	j2084492712 [label="Padre Lyon Allard",shape=box,color=blue];
		j2084492712 -> "Chat ends.";
	j2558171734 [label="O que uno podría sentir que es \"apropiado\" para un hombre de la iglesia y erudito como yo.",shape=box,color=blue];
		j2558171734 -> j4248326837;
		j2558171734 -> j257046909;
	j4248326837 [label="He experimentado más la guerra que la paz en mi vida, Lyon. Si hubiera dejado que me afectara, no creo que aún estuviera aquí. Pero eso no significa que no siga siendo una carga, un costo real.",shape=box,color=red];
		j4248326837 -> j4200576988;
	j257046909 [label="Me imagino que los demás te han dicho quién soy. Qué soy. De dónde vengo. La muerte que me persigue, la muerte de la que vengo. La muerte que me define. ¿Crees que algo de lo que sientas me sorprenderá?",shape=box,color=red];
		j257046909 -> j2763243129;
	j4200576988 [label="Add 1 to Thermostat counter",color=orange];
		j4200576988 -> j447966335;
	j2763243129 [label="Add -1 to Thermostat counter",color=orange];
		j2763243129 -> j3500520974;
	j447966335 [label="Sí, en efecto.",shape=box,color=blue];
		j447966335 -> j3216849117;
		j447966335 -> j3195648800;
	j3500520974 [label="Sí, lo creo.",shape=box,color=blue];
		j3500520974 -> j3216849117;
		j3500520974 -> j3195648800;
	j3216849117 [label="Lo siento. Siento haberte molestado. No era mi intención.",shape=box,color=red];
		j3216849117 -> j1776285693;
	j3195648800 [label="¿Podrías... profundizar?",shape=box,color=red];
		j3195648800 -> j3635764660;
	j1776285693 [label="No tienes la culpa, Viajero. Soy, como dirían nuestros hermanos y hermanas de Libertatia, un \"hueso duro de roer\".",shape=box,color=blue];
		j1776285693 -> j498033613;
	j3635764660 [label="Los horrores que resuenan en mi mente parecen no tener límites. Veo cadenas de tendones humanos que una vez emanaban carmesí fresco, se volvieron quebradizos y ennegrecidos.",shape=box,color=blue];
		j3635764660 -> j113364467;
	j498033613 [label="Soy solo un individuo asediado. Defiendo la muralla. Abrir la puerta es amenazar la integridad de las defensas.",shape=box,color=blue];
		j498033613 -> j3817343381;
		j498033613 -> j2466168734;
	j113364467 [label="Veo cien mil rostros de mí mismo, similares pero ajenos. Ataúdes vacíos, cadáveres de carne humana retorcida y rota, suspendidos en el velo entre la vida y la muerte.",shape=box,color=blue];
		j113364467 -> j3135296201;
	j3817343381 [label="Entiendo. Cuando estés listo, podemos hablar.",shape=box,color=red];
		j3817343381 -> j1824841344;
	j2466168734 [label="¿Qué quieres decir?",shape=box,color=red];
		j2466168734 -> j3635764660;
	j3135296201 [label="Expresiones atrapadas en una máscara de reposo vacío. Pero en los restos destellantes de sus almas, brasas que persisten y no se extinguen, los oigo gritar. Aullando sin cesar por venganza. Por libertad.",shape=box,color=blue];
		j3135296201 -> j2123917889;
	j1824841344 [label="Estoy empezando a tener la clara impresión de que no tengo elección en este asunto.",shape=box,color=blue];
		j1824841344 -> j2861926473;
	j2123917889 [label="Por la muerte.",shape=box,color=blue];
		j2123917889 -> j3718656290;
	j2861926473 [label="+15 Chemistry",color=orange];
		j2861926473 -> j107394716;
	j3718656290 [label="Estas visiones me persiguen durante el día. Mis sueños. No tengo pesadillas, porque eso es todo lo que experimento, en lo que me he convertido.",shape=box,color=blue];
		j3718656290 -> j1274675553;
	j107394716 [label="Pero, por si sirve de algo, Marie... me ha dicho que tienes buenas intenciones. Y le creo a ella, incluso cuando yo no lo puedo creer.",shape=box,color=blue];
		j107394716 -> j3103715293;
	j1274675553 [label="Check boolean LyonPainOff",color=orange];
		j1274675553 -> j2308692474 [label=true,color=green];
		j1274675553 -> j1885287784 [label=false,color=brown];
	j3103715293 [label="Al final, solo puedo pedirte paciencia. Lua sabe que casi siempre me falta.",shape=box,color=blue];
		j3103715293 -> j3588563806;
	j2308692474 [label="Sólo cuando me sacrifico ante los susurros que resuenan dentro de mi alma, el mundo se refleja en mí de una manera similar a aquella que te puede resultar familiar.",shape=box,color=blue];
		j2308692474 -> j1481790491;
	j1885287784 [label="Sólo cuando uso la carne de mi cuerpo como sacrificio para los susurros que resuenan dentro de mi alma, el mundo se refleja ante mí de una manera similar a la que quizás te resulte familiar.",shape=box,color=blue];
		j1885287784 -> j1481790491;
	j3588563806 [label="Padre Lyon Allard",shape=box,color=blue];
		j3588563806 -> j2522325746;
	j1481790491 [label="Por favor, no finjas que sabes lo que \"siento\", Viajero. Me temo que apenas has empezado a comprender.",shape=box,color=blue];
		j1481790491 -> j1634130657;
		j1481790491 -> j2138603350;
		j1481790491 -> j3301479113;
	j2522325746 [label="Boolean LyonVisions2d is now true.",color=orange];
		j2522325746 -> "Chat ends.";
	j1634130657 [label="Yo... lo siento. No, no lo sabía.",shape=box,color=red];
		j1634130657 -> j2812940163;
	j2138603350 [label="Y hay mucho horror y dolor que yo he visto y que tú tampoco entiendes, Lyon.",shape=box,color=red];
		j2138603350 -> j2827890364;
	j3301479113 [label="Lamento si sientes que dije algo fuera de lugar. Pero quiero entender. Estas visiones tuyas...",shape=box,color=red];
		j3301479113 -> j4081483844;
	j2812940163 [label="Sí. Bueno. He sobrevivido estos largos años. Aguantaré unos cuantos más, estoy seguro. No tienes por qué preocuparte demasiado.",shape=box,color=blue];
		j2812940163 -> j4270520825;
	j2827890364 [label="Estoy casi seguro de que sí, al verlo reflejado en las imágenes de este lugar. Pero ¿te consideras superior? ¿El Conocedor Supremo de Todos los Horrores y Todo el Sufrimiento?",shape=box,color=blue];
		j2827890364 -> j168535059;
		j2827890364 -> j4104363395;
	j4081483844 [label="Sí. Bueno. Los he soportado todos mis años. Aguantaré unos cuantos más, estoy seguro. No tienes que preocuparte demasiado.",shape=box,color=blue];
		j4081483844 -> j4270520825;
	j4270520825 [label="Boolean LyonVisions2a is now true.",color=orange];
		j4270520825 -> j2405314857;
		j4270520825 -> j3703955424;
	j168535059 [label="Estoy diciendo que tal vez pueda simpatizar más con lo que estás experimentando de lo que crees.",shape=box,color=red];
		j168535059 -> j2475455766;
	j4104363395 [label="Digo que he vivido mucha muerte y horror, Lyon. Así que no me gusta que me traten con condescendencia por ello.",shape=box,color=red];
		j4104363395 -> j2518629056;
	j2405314857 [label="Eso que describes, Lyon… ¿esa visión empezó antes o después de que fueras un protoframe?",shape=box,color=red];
		j2405314857 -> j1029557763;
	j3703955424 [label="¿Podemos hablar de esto otra vez? ¿Por favor?",shape=box,color=red];
		j3703955424 -> j1742498038;
	j2475455766 [label="Boolean LyonVisions2b is now true.",color=orange];
		j2475455766 -> j847335341;
	j2518629056 [label="Boolean LyonVisions2c is now true.",color=orange];
		j2518629056 -> j4050648090;
	j1029557763 [label="Ojalá fuera una pregunta tan simple como crees. De todas formas, no estoy dispuesto a responderla hoy. Siento que me va a doler la cabeza.",shape=box,color=blue];
		j1029557763 -> j674552727;
	j1742498038 [label="Estoy empezando a tener la clara impresión de que no tengo elección en este asunto.",shape=box,color=blue];
		j1742498038 -> j674552727;
	j847335341 [label="Puede que te parezca extraño que no busque compasión, Viajero. Lo que busco son respuestas. Seguridad. Firmeza, cuando todo es ilusión y mentiras.",shape=box,color=blue];
		j847335341 -> j2356340964;
		j847335341 -> j3213612180;
	j4050648090 [label="Entonces permíteme inclinarme a tus pies. Te alabo por todo lo que has soportado. Me pregunto cómo sigues cuerdo a pesar de todo lo que has presenciado.",shape=box,color=blue];
		j4050648090 -> j3760887877;
	j674552727 [label="+10 Chemistry",color=orange];
		j674552727 -> j1290904458;
	j2356340964 [label="Haré lo que pueda.",shape=box,color=red];
		j2356340964 -> j2512198787;
	j3213612180 [label="Entonces, quizás pueda ayudarte con eso. ¿Podemos hablar de esto otra vez? ¿Por favor?",shape=box,color=red];
		j3213612180 -> j1742498038;
	j3760887877 [label="Y me maravillo de cómo aún dedicas tiempo a todos los demás, a quienes consideras tan por debajo de tu elevado estatus.",shape=box,color=blue];
		j3760887877 -> "Chat ends.";
	j1290904458 [label="Pero, por si sirve de algo, Marie... me ha dicho que tienes buenas intenciones. Y le creo a ella, incluso cuando yo no lo puedo creer.",shape=box,color=blue];
		j1290904458 -> j3325628293;
	j2512198787 [label="+5 Chemistry",color=orange];
		j2512198787 -> j2217707011;
	j2217707011 [label="Eso es todo lo que se puede pedir ¿no?",shape=box,color=blue];
		j2217707011 -> "Chat ends.";
}