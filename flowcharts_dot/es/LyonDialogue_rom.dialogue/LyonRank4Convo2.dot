digraph {
	781 [label="LyonRank4Convo2 begins.",color=orange];
		781 -> 782;
		781 -> 783;
		781 -> 784;
	782 [label="How is it that you and Marie can reconcile being a priest and a nun, but also... committing acts of violence?",shape=box,color=red];
		782 -> 785;
		782 -> 786;
		782 -> 787;
	783 [label="Can I ask you a bit of an odd question, Lyon?",shape=box,color=red];
		783 -> 788;
	784 [label="[End.]",shape=box,color=red];
		784 -> 789;
	785 [label="I hear Marie shout \"païens!\" and rush off into the fight, and... yet I have a hard time thinking her the kind of person to condemn someone for differing beliefs. I can't imagine you must be much different, either. She clearly thinks so highly of you.",shape=box,color=red];
		785 -> 790;
	786 [label="How would your church feel about what you and Marie are here doing? About... what you're being asked to do in their name?",shape=box,color=red];
		786 -> 791;
	787 [label="I watch you and Marie on the battlefield, and then I speak to her in private, and I see you quietly reading books... and I suppose I am having a hard time making those individuals line up in my mind.",shape=box,color=red];
	788 [label="If you find the ability to describe our current predicament as simply \"odd\" I am either impressed by your fortitude or dismayed by your lack of vocabulary. I suspect, however, it is the former.",shape=box,color=blue];
		788 -> 793;
	789 [label="Chat ends.",color=orange];
	790 [label="You are quite right. Marie is not the kind to condemn another for holding in their hearts an ancient god of trees - instead, she would seek to find what beliefs she held in common with them.",shape=box,color=blue];
		790 -> 794;
	791 [label="Many a holy war was waged in its day in the name of Sol or Lua. Bloody \"crusades\" to drive back \"heathens\" or to \"take holy land\" or whatever contrived reasoning was the favorite of the day.",shape=box,color=blue];
		791 -> 795;
	793 [label="+5 Chemistry",color=orange];
		793 -> 797;
	794 [label="Is the tree not nourished by the light of Sol, perhaps? Is there not a common ground on which she could break bread with them? She is more apt to sit and listen to their stories, than seek to harm them for their faith.",shape=box,color=blue];
		794 -> 798;
	795 [label="La Ortodoxia Luminaria no tiene ejército ni libra guerras. No impiden que quienes pertenecen a su orden actúen ni protejan a otros.",shape=box,color=blue];
		795 -> 727;
	797 [label="Es decir, sí, adelante. No puedes hacerme sentir más extraño preguntándome lo que te intriga.",shape=box,color=blue];
		797 -> 785;
		797 -> 786;
		797 -> 787;
	798 [label="When she engages with her foe upon the battlefield, I believe it is one of two things: either, she is having a bit of fun, play-acting as an ancient crusader, imagining herself in the shining armor of a Knight of Sol -",shape=box,color=blue];
		798 -> 796;
	727 [label="When Marie engages with her foes upon the battlefield, I believe it is one of two things: either, she is having a bit of fun, play-acting as an ancient crusader, imagining herself in the shining armor of a Knight of Sol -",shape=box,color=blue];
		727 -> 796;
	796 [label="Or, most likely, she is remembering Astaphor 8:23 \"Lonely are the souls who seek to enter my house by violence, for they are the ones cast from the light of Sol.\"",shape=box,color=blue];
		796 -> 799;
	799 [label="In her eyes, the violence she commits is righteous in the name of defending a greater good - as would you, as would those you fight beside, I assume. ",shape=box,color=blue];
		799 -> 800;
	800 [label="And, therefore, those she fights - regardless of their religion - are cast from Sol. Even if they were to wear the holy cloth of her own order, they are in her eyes, heathens.",shape=box,color=blue];
		800 -> 801;
		800 -> 802;
	801 [label="I notice you left yourself out of this. How do you feel about all the fighting?",shape=box,color=red];
		801 -> 803;
	802 [label="That makes sense. Thank you.",shape=box,color=red];
		802 -> 804;
	803 [label="I am being intentionally elusive, Drifter.",shape=box,color=blue];
		803 -> 805;
		803 -> 806;
	804 [label="+5 Chemistry",color=orange];
		804 -> 807;
	805 [label="And I am being pointedly persistent, Priest.",shape=box,color=red];
		805 -> 808;
	806 [label="Fair enough. I'll take what I can get today.",shape=box,color=red];
		806 -> 804;
	807 [label="For what it is worth, Marie... has told me you mean well. And I believe her, even when I do not believe myself.",shape=box,color=blue];
		807 -> 809;
	808 [label="+10 Chemistry",color=orange];
		808 -> 810;
	809 [label="All I may do is beg your patience, in the end. Lua knows I run short of it with myself most days.",shape=box,color=blue];
		809 -> 811;
	810 [label="Very well. If you will not be dissuaded, and you are so curious? I am not as troubled by the death I cause as... perhaps you might expect.",shape=box,color=blue];
		810 -> 812;
	811 [label="-F. Lyon Allard",shape=box,color=blue];
		811 -> 813;
	812 [label="Or that one might feel is \"proper\" for a man of the cloth and a scholar such as I.",shape=box,color=blue];
		812 -> 814;
		812 -> 815;
	813 [label="Chat ends.",color=orange];
	814 [label="I've known more war than peace in my life, Lyon. If I let it trouble me, I don't think I would still be here. But that isn't to say it doesn't still come with a real burden - a real cost.",shape=box,color=red];
		814 -> 816;
	815 [label="I'm sure the others have told you who I am. What I am. Where I've come from. The death that follows me - the death I've come from. The death that defines me. Do you think anything you feel will surprise me?",shape=box,color=red];
		815 -> 817;
	816 [label="Add 1 to Thermostat",color=orange];
		816 -> 818;
	817 [label="Add -1 to Thermostat",color=orange];
		817 -> 819;
	818 [label="Yes, it does.",shape=box,color=blue];
		818 -> 820;
		818 -> 821;
	819 [label="Yes, I do.",shape=box,color=blue];
		819 -> 820;
		819 -> 821;
	820 [label="I'm sorry. I feel I've upset you. That wasn't my intention.",shape=box,color=red];
		820 -> 822;
	821 [label="Do you... care to elaborate?",shape=box,color=red];
		821 -> 823;
	822 [label="You are not to blame, Drifter. I am, as our brothers and sisters from Libertatia might say, a \"hard nut to crack.\"",shape=box,color=blue];
		822 -> 824;
	823 [label="The horrors that echo within my mind seem to know no boundaries. I witness chains of human sinew that once oozed with fresh crimson, turned brittle and blackened.",shape=box,color=blue];
		823 -> 825;
	824 [label="I am merely a besieged individual. I hold the wall. To open the gate is to threaten the integrity of the defenses.",shape=box,color=blue];
		824 -> 826;
		824 -> 827;
	825 [label="I see a hundred thousand visages of my own self, similar but foreign. Hollowed caskets, corpses of twisted, broken human flesh, suspended in the veil between life and death.",shape=box,color=blue];
		825 -> 828;
	826 [label="I understand. When you're ready, we can talk.",shape=box,color=red];
		826 -> 829;
	827 [label="How do you mean?",shape=box,color=red];
		827 -> 823;
	828 [label="Expressions locked in a mask of empty repose. But in the flickering remains of their souls, embers that linger and do not die, I hear them screaming. Endlessly howling for retribution. For freedom.",shape=box,color=blue];
		828 -> 830;
	829 [label="I am starting to come to the distinct impression that I do not have a choice in this matter.",shape=box,color=blue];
		829 -> 831;
	830 [label="For death.",shape=box,color=blue];
		830 -> 832;
	831 [label="+15 Chemistry",color=orange];
		831 -> 833;
	832 [label="These visions haunt my waking hours. My dreams. I have no nightmares, for that is all I experience - all I have become.",shape=box,color=blue];
		832 -> 834;
	833 [label="But, for what it is worth, Marie... has told me you mean well. And I believe her, even when I do not believe myself.",shape=box,color=blue];
		833 -> 835;
	834 [label="Check boolean LyonPainOff",color=orange];
		834 -> 836 [label=true,color=green];
		834 -> 837 [label=false,color=brown];
	835 [label="All I may do is beg your patience, in the end. Lua knows I run short of it with myself most days.",shape=box,color=blue];
		835 -> 838;
	836 [label="Only when I sacrifice to the whispers that echo within my soul, is the world reflected to me in a manner similar to that which you might find familiar.",shape=box,color=blue];
		836 -> 839;
	837 [label="Only when I rend the flesh from my body as a sacrifice to the whispers that echo within my soul, is the world reflected to me in a manner similar to that which you might find familiar.",shape=box,color=blue];
		837 -> 839;
	838 [label="-F. Lyon Allard",shape=box,color=blue];
		838 -> 840;
	839 [label="Kindly do not pretend to know of what I \"feel,\" Drifter. I fear you have only begun to understand.",shape=box,color=blue];
		839 -> 841;
		839 -> 842;
		839 -> 843;
	840 [label="Update boolean LyonVisions2d",color=orange];
		840 -> 844;
	841 [label="I - I'm sorry. No, I didn't know.",shape=box,color=red];
		841 -> 845;
	842 [label="And there is a lot of horror and pain that I have seen that you do not understand either, Lyon.",shape=box,color=red];
		842 -> 846;
	843 [label="I'm sorry if you feel I spoke out of turn. But I want to understand. These visions of yours...",shape=box,color=red];
		843 -> 847;
	844 [label="Chat ends.",color=orange];
	845 [label="Yes. Well. I have survived these long years. I will hold strong a few more, I am certain. You needn't worry over much.",shape=box,color=blue];
		845 -> 848;
	846 [label="I am most certain you have, seeing some of it reflected in the imagery of this place. But do you think yourself paramount? Supreme Knower of All Horrors and All Suffering?",shape=box,color=blue];
		846 -> 849;
		846 -> 850;
	847 [label="Yes. Well. I have withstood them all my years. I will hold strong a few more, I am certain. You needn't worry over much.",shape=box,color=blue];
		847 -> 848;
	848 [label="Update boolean LyonVisions2a",color=orange];
		848 -> 851;
		848 -> 852;
	849 [label="I'm saying I might be able to sympathize more with what you're experiencing than you think.",shape=box,color=red];
		849 -> 853;
	850 [label="I'm saying I've been through a lot of death and horror, Lyon. So I don't enjoy being spoken down to over it.",shape=box,color=red];
		850 -> 854;
	851 [label="What you're describing, Lyon... did that vision start before or after you were a protoframe?",shape=box,color=red];
		851 -> 855;
	852 [label="Can we talk about this again? Please?",shape=box,color=red];
		852 -> 856;
	853 [label="Update boolean LyonVisions2b",color=orange];
		853 -> 857;
	854 [label="Update boolean LyonVisions2c",color=orange];
		854 -> 858;
	855 [label="Were that as simple a question as you believe it to be. Regardless, it is not one I am willing to answer today. I feel a headache coming on.",shape=box,color=blue];
		855 -> 859;
	856 [label="I am starting to come to the distinct impression that I do not have a choice in this matter.",shape=box,color=blue];
		856 -> 859;
	857 [label="It may seem strange to you that I am not in search of sympathy, Drifter. Answers are what I seek. Surety. Firmament, when all is illusion and lies.",shape=box,color=blue];
		857 -> 860;
		857 -> 861;
	858 [label="Than allow me to bow down at your feet. Praise you for all you have endured. Wonder how you are still sane for all you have witnessed.",shape=box,color=blue];
		858 -> 862;
	859 [label="+10 Chemistry",color=orange];
		859 -> 863;
	860 [label="I'll do what I can.",shape=box,color=red];
		860 -> 864;
	861 [label="Then, maybe I can help you with that. Can we talk about this again? Please?",shape=box,color=red];
		861 -> 856;
	862 [label="And marvel over how you still spare time for all the rest of us who you view so far beneath your vaulted status.",shape=box,color=blue];
		862 -> 865;
	863 [label="But, for what it is worth, Marie... has told me you mean well. And I believe her, even when I do not believe myself.",shape=box,color=blue];
		863 -> 866;
	864 [label="+5 Chemistry",color=orange];
		864 -> 867;
	865 [label="Chat ends.",color=orange];
	866 [label="All I may do is beg your patience, in the end. Lua knows I run short of it with myself most days.",shape=box,color=blue];
		866 -> 868;
	867 [label="That is all one can ask for, is it not?",shape=box,color=blue];
		867 -> 869;
	868 [label="-F. Lyon Allard",shape=box,color=blue];
		868 -> 870;
	869 [label="Chat ends.",color=orange];
	870 [label="Chat ends.",color=orange];
}