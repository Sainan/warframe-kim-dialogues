	"LyonRank5Convo2 begins." [color=orange];
		"LyonRank5Convo2 begins." -> j680575522;
	j680575522 [label="Evaluate expressions",color=orange];
		j680575522 -> j1123500703 [label="LyonPainOff",color=purple];
		j680575522 -> j2598778965 [label="LyonBackstory3a",color=purple];
		j680575522 -> j684698034 [label="LyonBackstory3b",color=purple];
		j680575522 -> j1449261982 [label="LyonBackstory2",color=purple];
		j680575522 -> j1449261982 [label="LyonBackstory1",color=purple];
		j680575522 -> j1283557778 [label="false",color=purple];
	j1123500703 [label="+20 Chemistry",color=orange];
		j1123500703 -> j1769839591;
	j2598778965 [label="Amigo mío, has sido paciente conmigo y más amable de lo que debías. Sé que debiste haber sentido curiosidad después de esta parte de mi historia... sobre aquella noche en la que Lua estaba en su punto más oscuro.",shape=box,color=blue];
		j2598778965 -> j388710151;
	j684698034 [label="Amigo mío, has sido paciente conmigo. Sé que debiste haber sentido curiosidad después de esta parte de mi historia... sobre aquella noche en la que Lua estaba en su punto más oscuro.",shape=box,color=blue];
		j684698034 -> j388710151;
	j1449261982 [label="Amigo mío, te has preguntado sobre mi pasado. Y sé que debiste haber sentido curiosidad después de esta parte de mi historia... sobre aquella noche en la que Lua estaba en su punto más oscuro.",shape=box,color=blue];
		j1449261982 -> j388710151;
	j1283557778 [label="Amigo mío, sé que debiste de haber sentido curiosidad después de mi historia y sobre aquella noche en la que Lua estaba en su punto más oscuro.",shape=box,color=blue];
		j1283557778 -> j388710151;
	j1769839591 [label="[Conversación omitida debido a una advertencia previamente establecida]",shape=box,color=blue];
		j1769839591 -> j370687875;
	j388710151 [label="Es una historia que juré jamás contarla. Solo Marie sabe de ello, pues ella lee mis diarios. Y ahora, deberé compartirla contigo.",shape=box,color=blue];
		j388710151 -> j516965625;
	j370687875 [label="Boolean LyonConfession1 is now true.",color=orange];
		j370687875 -> "Chat ends.";
	j516965625 [label="Una vez que empiezo no me puedo detener, por lo que no seré capaz de empezar de nuevo. Así que deberás de perdonarme si no te dejo hacerme preguntas.",shape=box,color=blue];
		j516965625 -> j179068932;
		j516965625 -> j1995135729;
		j516965625 -> j27318349;
		j516965625 -> j152570860;
	"Chat ends." [color=orange];
	j179068932 [label="Por supuesto.",shape=box,color=red];
		j179068932 -> j552228942;
	j1995135729 [label="[Dejarlo continuar]",shape=box,color=red];
		j1995135729 -> j3058998653;
	j27318349 [label="[Advertencia: Discusión sobre autolesiones y maltrato infantil. Haz clic aquí para terminar la conversación. No perderás niveles de química con Lyon]",shape=box,color=red];
		j27318349 -> j784838610;
	j152570860 [label="[Fin]",shape=box,color=red];
		j152570860 -> j3856020424;
	j552228942 [label="Gracias.",shape=box,color=blue];
		j552228942 -> j141195667;
	j3058998653 [label="+5 Chemistry",color=orange];
		j3058998653 -> j552228942;
	j784838610 [label="Check boolean LyonSpeech",color=orange];
		j784838610 -> j3342655806 [label=true,color=green];
		j784838610 -> j2792971980 [label=false,color=brown];
	j3856020424 [label="Boolean LyonConfessionFail is now true.",color=orange];
		j3856020424 -> "Chat ends.";
	j141195667 [label="Evaluate expressions",color=orange];
		j141195667 -> j1663174914 [label="LyonBackstory3a",color=purple];
		j141195667 -> j1663174914 [label="LyonBackstory3b",color=purple];
		j141195667 -> j1984097837 [label="false",color=purple];
	j3342655806 [label="+20 Chemistry",color=orange];
		j3342655806 -> j370687875;
	j2792971980 [label="Si te consideras cobarde por esta decisión, te lo suplico: no lo hagas. Porque este dolor no te corresponde afrontarlo. Es mío. No pediste soportar este momento.",shape=box,color=blue];
		j2792971980 -> j1684496688;
	j1663174914 [label="Hablamos de mi familia. En los tiempos en la granja donde crecí. De las visiones que me han atormentado y llevado a la violencia.",shape=box,color=blue];
		j1663174914 -> j1190698316;
	j1984097837 [label="Sé que no te he contado tanto sobre quiénes me criaron. Me temo que hay una buena razón para ello.",shape=box,color=blue];
		j1984097837 -> j2717611637;
	j1684496688 [label="Este aparato mecánico en el que nos sentamos crea una impresión de impersonalidad velada. Que de alguna manera estamos protegidos de cualquier daño que el otro pueda causarnos a través de las palabras escritas.",shape=box,color=blue];
		j1684496688 -> j1136812524;
	j1190698316 [label="Te conté sobre las voces que oía, que me susurraban, llamándome desde otras habitaciones. A veces parecía que decían mi nombre...",shape=box,color=blue];
		j1190698316 -> j2636738241;
	j2717611637 [label="Mi madre... interpretó mis visiones como obra del diablo. Y trató de quitármelas a punta de golpes con una vara. Muchas veces hasta que ya no me podía parar.",shape=box,color=blue];
		j2717611637 -> j469685017;
	j1136812524 [label="Yo diría más bien lo contrario: que, libres de la armadura que usamos en nuestras interacciones sociales más comunes, estamos despojados de aquello que podría protegernos.",shape=box,color=blue];
		j1136812524 -> j2705465206;
	j2636738241 [label="Otras veces, no sonaban como algo reconocible. Cosas sin sentido, o el lenguaje de los demonios.",shape=box,color=blue];
		j2636738241 -> j3990568060;
	j469685017 [label="¿Y mi padre? Bueno. A pesar de la crueldad de mi madre, la de mi padre era peor. No entraré en detalles.",shape=box,color=blue];
		j469685017 -> j2241092864;
	j2705465206 [label="Por eso, en situaciones como estas... soy muy consciente de que disparo una flecha que podría no encontrar al soldado listo para la batalla, sino la yugular desprevenida de un ciervo en el bosque.",shape=box,color=blue];
		j2705465206 -> j3886706356;
	j3990568060 [label="Al principio, los delirios sin sentido de las palabras me aterraban. Les suplicaba que tuvieran sentido. Le rezaba a Lua para que sus espíritus me dijeran que querían de mí.",shape=box,color=blue];
		j3990568060 -> j2290408576;
	j2241092864 [label="Pero su violencia no se comparaba en nada con la mía. Mis visiones a veces me dificultaban lidiar con ello... particularmente cuando crecí, más alto y fuerte que mi padre.",shape=box,color=blue];
		j2241092864 -> j1107943674;
	j3886706356 [label="Así que te dejo con esto:",shape=box,color=blue];
		j3886706356 -> j3185142547;
	j2290408576 [label="Pero cuando empecé a descifrar que es lo que querían... Me arrepentí de lo que había orado con tanta desesperación. Y en ese momento, sabía qué acciones me pedían hacer en sus nombres.",shape=box,color=blue];
		j2290408576 -> j691208806;
	j1107943674 [label="Y estas visiones seguido tomaban forma de voces. A veces parecía que decían mi nombre...",shape=box,color=blue];
		j1107943674 -> j2636738241;
	j3185142547 [label="Debemos recordarnos cómo encontrar la fuerza para ayudar a otro a ponerse de pie, incluso cuando no podemos encontrar la voluntad para hacerlo nosotros.",shape=box,color=blue];
		j3185142547 -> j2259521513;
	j691208806 [label="Ah y qué precio tan horrible habrían pagado.",shape=box,color=blue];
		j691208806 -> j3708653657;
	j2259521513 [label="Ése es el verdadero propósito de la historia.",shape=box,color=blue];
		j2259521513 -> j2843991541;
	j3708653657 [label="No me malinterpretes. Mi padre no me amaba y tampoco mi madre. Cualquier tipo de lealtad familiar que pude haber sentido por ellos se había desvanecido bajo una letanía de moretones y cicatrices.",shape=box,color=blue];
		j3708653657 -> j3071698058;
	j2843991541 [label="+20 Chemistry",color=orange];
		j2843991541 -> j412126007;
	j3071698058 [label="Pero, ¿qué es lo que me suplicaban que hiciera por ellos...? ¿Y qué me obligaron a hacer en aquellas noches tan oscuras...?",shape=box,color=blue];
		j3071698058 -> j495777403;
	j412126007 [label="Que estés bien, Viajero. Hablamos pronto.",shape=box,color=blue];
		j412126007 -> j397992588;
	j495777403 [label="Apenas era más que un niño... difícilmente era un hombre. ¿Tal vez tenía dieciséis? ¿Dieciocho? Al principio, pensé que era otra terrible pesadilla... un retorcido sueño.",shape=box,color=blue];
		j495777403 -> j1529676475;
	j397992588 [label="Padre Lyon Allard",shape=box,color=blue];
		j397992588 -> j370687875;
	j1529676475 [label="Alrededor de mí había figuras, manifestaciones demacradas y retorcidas, hechas meramente de malicia y oscuridad.",shape=box,color=blue];
		j1529676475 -> j1623400405;
	j1623400405 [label="Burlándose de mí, pidiéndome que hiciera lo que debía hacerse... que si esos que decían amarme deseaban mi carne... entonces yo, a cambio, debía tener la de ellos...",shape=box,color=blue];
		j1623400405 -> j25489539;
	j25489539 [label="Cuando desperté de la pesadilla... o tal vez, siempre estuve despierto, no lo sé con exactitud, tenía un cuchillo de cazador en mi mano. Y me paré en la puerta de la habitación de mis padres.",shape=box,color=blue];
		j25489539 -> j3013620994;
	j3013620994 [label="Era luna nueva. Y las nubes eran espesas. No había ni un rayo de luz con el cual ver. La oscuridad era absoluta. ",shape=box,color=blue];
		j3013620994 -> j3523360402;
	j3523360402 [label="Lua me había abandonado.",shape=box,color=blue];
		j3523360402 -> j3047305555;
	j3047305555 [label="No pude responder el llamado de las voces. No les pude dar las almas de mi madre y padre.",shape=box,color=blue];
		j3047305555 -> j3363330746;
	j3363330746 [label="Huí hacia la vacuidad de la noche. En las profundidades del bosque, las ramas rasgaban mi piel, dolor el cual no podía importarme menos.",shape=box,color=blue];
		j3363330746 -> j4161382109;
	j4161382109 [label="Corrí hasta que mis piernas colapsaron, sin poder ir más lejos. Quizás estaba llorando, no lo sé.",shape=box,color=blue];
		j4161382109 -> j3313872562;
	j3313872562 [label="Pero las manifestaciones me siguieron. Y aún susurraban pidiendo sangre.",shape=box,color=blue];
		j3313872562 -> j1453128831;
	j1453128831 [label="Esperaba que si no podía verlas, tal vez se irían... es cuando me clavé ese cuchillo en la cuenca de mi ojo...",shape=box,color=blue];
		j1453128831 -> j3671215563;
	j3671215563 [label="Una lástima que me haya desmayado y no pude completar mi tarea. Ahora, nunca lo sabré.",shape=box,color=blue];
		j3671215563 -> j3118748775;
	j3118748775 [label="Cuando desperté, estaba en la parroquia local de Lua. Un hermano me encontró y vendó mis heridas. Me preguntó de qué había escapado.",shape=box,color=blue];
		j3118748775 -> j512222244;
	j512222244 [label="Estaba alterado. No le podía mentir. Le confesé todo... las visiones, lo que me dijeron que hiciera. Yo solo esperaba que me condenara.",shape=box,color=blue];
		j512222244 -> j2498365573;
	j2498365573 [label="Cuando terminé, él simplemente me sonrió con tristeza, y me colocó un amuleto de Lua en la palma de mi mano. \"Ella es una bendición y una maldición, hijo mío\".",shape=box,color=blue];
		j2498365573 -> j380134848;
	j380134848 [label="Me envió a la catedral en la Cité de la Lumière. Y ahí estuve hasta que Entrati me encontró...",shape=box,color=blue];
		j380134848 -> j3046292047;
	j3046292047 [label="Ahí está... ya lo sabes.",shape=box,color=blue];
		j3046292047 -> j580505155;
	j580505155 [label="Y ahora... debo irme.",shape=box,color=blue];
		j580505155 -> j1459869009;
	j1459869009 [label="Boolean LyonConfession1 is now true.",color=orange];
		j1459869009 -> j1355094112;
	j1355094112 [label="+20 Chemistry",color=orange];
		j1355094112 -> j3700048672;
	j3700048672 [label="Lyon",shape=box,color=blue];
		j3700048672 -> "Chat ends.";
}