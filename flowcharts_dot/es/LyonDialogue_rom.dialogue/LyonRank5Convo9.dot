digraph {
	graph [fontname="Roboto Condensed"];
	node [fontname="Roboto Condensed"];
	edge [fontname="Roboto Condensed"];

	"LyonRank5Convo9 begins." [color=orange];
		"LyonRank5Convo9 begins." -> j3594191379;
	j3594191379 [label="Evaluate expressions",color=orange];
		j3594191379 -> "Chat ends." [label="LyonDating & LyonDatingConfession",color=purple];
		j3594191379 -> j1561587705 [label="LyonDating",color=purple];
		j3594191379 -> "Chat ends." [label="false",color=purple];
	"Chat ends." [color=orange];
	j1561587705 [label="Mon miracle, yo... debo asegurarme de que entiendas algo antes de contarte mi siguiente anécdota. ",shape=box,color=blue];
		j1561587705 -> j692063708;
	j692063708 [label="Es muy importante que pongas mucha atención a las siguientes palabras que mande. ¿Entiendes?",shape=box,color=blue];
		j692063708 -> j750657070;
		j692063708 -> j2213291337;
	j750657070 [label="Me estás asustando. ¿Pasa algo malo?",shape=box,color=red];
		j750657070 -> j2760648555;
	j2213291337 [label="Sí, aquí estoy. Adelante.",shape=box,color=red];
		j2213291337 -> j4033935453;
	j2760648555 [label="Nada malo... de hecho todo lo contrario. Eso es precisamente lo que es crucial que entiendas: las terribles consecuencias de las que deseo liberarte, si das por sentado que podrían sobrevenirte.",shape=box,color=blue];
		j2760648555 -> j4176137494;
		j2760648555 -> j996291235;
		j2760648555 -> j3566893629;
	j4033935453 [label="+5 Chemistry",color=orange];
		j4033935453 -> j2539859070;
	j4176137494 [label="Estoy escuchando.",shape=box,color=red];
		j4176137494 -> j2385030905;
	j996291235 [label="No tiene mucho sentido lo que dices.",shape=box,color=red];
		j996291235 -> j3503836053;
	j3566893629 [label="Las terribles consecuencias de... ¿qué?",shape=box,color=red];
		j3566893629 -> j3882430679;
	j2539859070 [label="Gracias. Antes de comenzar quiero asegurarte de que no pasa nada malo... sin embargo, ahí residen quizás las terribles consecuencias de las que deseo liberarte, si das por sentado que podrían sobrevenirte.",shape=box,color=blue];
		j2539859070 -> j4176137494;
		j2539859070 -> j996291235;
		j2539859070 -> j3566893629;
	j2385030905 [label="+5 Chemistry",color=orange];
		j2385030905 -> j1014807935;
	j3503836053 [label="Sí. Estoy dolorosamente consciente de ello.",shape=box,color=blue];
		j3503836053 -> j3882430679;
	j3882430679 [label="Permíteme comenzar de nuevo.",shape=box,color=blue];
		j3882430679 -> j1014807935;
	j1014807935 [label="Soy consciente de que muchos pueden percibirme como… enfermo, y que en realidad, probablemente lo esté. Como mínimo, no estoy del todo cuerdo.",shape=box,color=blue];
		j1014807935 -> j622265942;
	j622265942 [label="Hace tiempo que estoy en paz con esto. Ya no me preocupa. Las visiones que me atormentan, las voces... he encontrado la manera de vivir con ellas sin miedo ni odio.",shape=box,color=blue];
		j622265942 -> j1652729707;
	j1652729707 [label="(Últimamente, creo que un poco por despecho, si soy sincero, pero no importa).",shape=box,color=blue];
		j1652729707 -> j1167875672;
	j1167875672 [label="Pero quiero que entiendas que si pusieras fin a lo que existe entre nosotros, a este vínculo que hasta ahora creía imposible entre yo y otra persona...",shape=box,color=blue];
		j1167875672 -> j1053217326;
	j1053217326 [label="¿Qué pasaría si alguna vez dejaras que tu corazón se alejara del mío? ",shape=box,color=blue];
		j1053217326 -> j2634791722;
	j2634791722 [label="Resistiré, mon miracle.",shape=box,color=blue];
		j2634791722 -> j1144257479;
	j1144257479 [label="No seré consumido por aquello que me ha plagado. ",shape=box,color=blue];
		j1144257479 -> j2851720794;
	j2851720794 [label="Check boolean LyonAllRight",color=orange];
		j2851720794 -> j4010584755 [label=true,color=green];
		j2851720794 -> j91943191 [label=false,color=brown];
	j4010584755 [label="Estaré, por usar tu coloquialismo, \"bien\". Encontraré motivos para sonreír y reír una vez más.",shape=box,color=blue];
		j4010584755 -> j2166610337;
		j4010584755 -> j3282885619;
	j91943191 [label="Sobreviviré. Estaré bien. Encontraré motivos para sonreír y reír una vez más.",shape=box,color=blue];
		j91943191 -> j2166610337;
		j91943191 -> j3282885619;
	j2166610337 [label="Ah, Lyon... no eres una carga para mí.",shape=box,color=red];
		j2166610337 -> j737827840;
	j3282885619 [label="¿Estás diciendo que... quieres terminar las cosas entre nosotros?",shape=box,color=red];
		j3282885619 -> j1583485895;
	j737827840 [label="Simplemente estoy intentando liberarte de cualquier dificultad que puedas estar enfrentando por mi culpa...",shape=box,color=blue];
		j737827840 -> j3829414424;
		j737827840 -> j3546236887;
		j737827840 -> j1980879449;
	j1583485895 [label="¡No! ¡Para nada! Simplemente estoy intentando liberarte de cualquier dificultad que puedas estar enfrentando por mi culpa.",shape=box,color=blue];
		j1583485895 -> j3829414424;
		j1583485895 -> j3546236887;
		j1583485895 -> j1980879449;
	j3829414424 [label="Tu dolor... se asemeja al mío. Nunca me costaría nada ayudarte a superarlo.",shape=box,color=red];
		j3829414424 -> j2653902126;
	j3546236887 [label="No sé cómo describir lo que me atrae de ti. Pero nunca serás un deber ni una carga.",shape=box,color=red];
		j3546236887 -> j3733548278;
	j1980879449 [label="[Terminar la relación] Todo esto se ha vuelto demasiado para mí, lo siento. Quizás sea mejor terminar aquí.",shape=box,color=red];
		j1980879449 -> j4160822572;
	j2653902126 [label="No puedo expresar cuánto me duele el corazón por ti. Pero estoy eternamente agradecido de que nuestros solitarios fantasmas del dolor se hayan encontrado.",shape=box,color=blue];
		j2653902126 -> j536024012;
	j3733548278 [label="Por eso no puedo expresar plenamente mi gratitud y no creo que las palabras puedan hacerle justicia.",shape=box,color=blue];
		j3733548278 -> j536024012;
	j4160822572 [label="Sí. Por supuesto. Sería... hipócrita aceptar otra respuesta en este momento... ",shape=box,color=blue];
		j4160822572 -> j3481653470;
	j536024012 [label="Pero ahora que me he tomado grandes molestias para repasar lo que ha sido un preámbulo espectacularmente autocomplaciente...",shape=box,color=blue];
		j536024012 -> j2377257581;
		j536024012 -> j2716516550;
		j536024012 -> j3644468618;
	j3481653470 [label="Lo entiendo perfectamente. Te deseo lo mejor. Y atesoraré todos los momentos que hemos pasado juntos.",shape=box,color=blue];
		j3481653470 -> j3882345790;
	j2377257581 [label="Para alguien que empezó siendo silencioso, realmente te ha llegado el gusto por hablar.",shape=box,color=red];
		j2377257581 -> j3418543521;
	j2716516550 [label="Fue interesante, no te preocupes.",shape=box,color=red];
		j2716516550 -> j2647817027;
	j3644468618 [label="Podrías haber dicho simplemente: \"¿Sabes? Estaré bien, aunque vayamos por caminos distintos\".",shape=box,color=red];
		j3644468618 -> j338694407;
	j3882345790 [label="Los guardaré en mi alma, aunque desaparezcan de mi memoria. Adiós.",shape=box,color=blue];
		j3882345790 -> j2903665959;
	j3418543521 [label="+5 Chemistry",color=orange];
		j3418543521 -> j3771671992;
	j2647817027 [label="+5 Chemistry",color=orange];
		j2647817027 -> j3882560743;
	j338694407 [label="+5 Chemistry",color=orange];
		j338694407 -> j2598655604;
	j2903665959 [label="Boolean LyonDating is now false.",color=orange];
		j2903665959 -> j540498926;
	j3771671992 [label="¡Bah! Si no quieres estar al tanto de lo que pasa en mi mente, no deberías de estar husmeando. Tú eres el único culpable.",shape=box,color=blue];
		j3771671992 -> j3083162557;
	j3882560743 [label="Me alegra que disfrutes de mis andanzas. Esto es precisamente por qué escogí no hablar tanto contigo. ¿Puedes imaginar tener que soportar esto en persona? Marie me habría acabado hace años como a un perro rabioso.",shape=box,color=blue];
		j3882560743 -> j3083162557;
	j2598655604 [label="Hay una cierta cantidad de irreverencia y sarcasmo que naturalmente prevalece la cual yo jamás esperaría alcanzar. Te lo dejo a ti.",shape=box,color=blue];
		j2598655604 -> j3083162557;
	j540498926 [label="Boolean IsDating is now false.",color=orange];
		j540498926 -> j3700048672;
	j3083162557 [label="Aun así, todo esto sirvió como pretexto a una historia que ahora parece ser corta en comparación al resto...",shape=box,color=blue];
		j3083162557 -> j4080863650;
	j3700048672 [label="Lyon",shape=box,color=blue];
		j3700048672 -> "Chat ends.";
	j4080863650 [label="Me desperté anoche por una pesadilla. Cuando lo hice, las sombras me estaban rodeando. Esto no es nada extraño o nuevo dado mi estado mental. Se acercaban sobre mi cama, y no se disipaban.",shape=box,color=blue];
		j4080863650 -> j3575352577;
	j3575352577 [label="No les tenía miedo, pues sabía que no podían lastimarme. Sin embargo, tampoco se iban de mi mente. Sabía que solo había una de la cual me tenía que deshacer.",shape=box,color=blue];
		j3575352577 -> j3582309801;
	j3582309801 [label="Me levanté de la cama, me vestí lo mejor que pude, tambaleándome por la visión borrosa de mi constante pesadilla. Agarré mi incensario y caí de rodillas en medio del piso, y me preparé para... bueno. ",shape=box,color=blue];
		j3582309801 -> j1881501247;
	j1881501247 [label="Me preparé para \"aclarar mi mente\". Dejémoslo así.",shape=box,color=blue];
		j1881501247 -> j1374536131;
	j1374536131 [label="Pero cerré mis ojos, mi mente divagaba. Mis pensamientos se dirigieron hacia... ti, mon miracle...",shape=box,color=blue];
		j1374536131 -> j1407272816;
	j1407272816 [label="El sonido de tu voz. El roce de tu mano sobre mi hombro... ",shape=box,color=blue];
		j1407272816 -> j3570190520;
	j3570190520 [label="Y las visiones... se fueron. Abandonaron su puesto, perseguidas por un extraño fantasma... que eras tú.",shape=box,color=blue];
		j3570190520 -> j569505602;
	j569505602 [label="Me... quedé parado. Puse mi incensario en la mesa de noche y... opté por caminar a través de la arena del santuario...",shape=box,color=blue];
		j569505602 -> j1278639146;
		j569505602 -> j3474245826;
	j1278639146 [label="Ahora puedo entender el por qué sentiste la necesidad de un preámbulo.",shape=box,color=red];
		j1278639146 -> j1757232078;
	j3474245826 [label="No sé qué decir...",shape=box,color=red];
		j3474245826 -> j3931556724;
	j1757232078 [label="Sí. Bueno. Durante mi caminata... comprendí de inmediato el oscuro peligro de un momento así. Que podrías... llegar a verlo como una responsabilidad, a verme como cadenas que te agobian.",shape=box,color=blue];
		j1757232078 -> j1109813756;
	j3931556724 [label="+5 Chemistry",color=orange];
		j3931556724 -> j2842588409;
	j1109813756 [label="Ruego por ti... Rezo, a cualquier dios o dioses, superiores o inferiores... eso que nunca haces. Este es un regalo que me has dado, y cada vez que lo renueve lo atesoraré.",shape=box,color=blue];
		j1109813756 -> j1757442677;
	j2842588409 [label="No hacen falta palabras, mon miracle... ",shape=box,color=blue];
		j2842588409 -> j3167297846;
	j1757442677 [label="Júrame, mon miracle, que si llega el momento en que me convierta en una jaula vacía para ti... te liberarás de mí...",shape=box,color=blue];
		j1757442677 -> j2594205689;
	j3167297846 [label="Durante mi caminata... comprendí de inmediato el oscuro peligro de un momento así. Que podrías... llegar a verlo como una responsabilidad, a verme como cadenas que te agobian.",shape=box,color=blue];
		j3167297846 -> j1109813756;
	j2594205689 [label="No seré una prisión vacía para quienes amo. Ni para ti. Ni para Marie.",shape=box,color=blue];
		j2594205689 -> j1863087722;
		j2594205689 -> j1299546786;
	j1863087722 [label="[Terminar la relación] No... no puedo. No puedo prometer eso, lo siento.",shape=box,color=red];
		j1863087722 -> j283322985;
	j1299546786 [label="Te lo juro. ",shape=box,color=red];
		j1299546786 -> j3862371687;
	j283322985 [label="+10 Chemistry",color=orange];
		j283322985 -> j1299446498;
	j3862371687 [label="+10 Chemistry",color=orange];
		j3862371687 -> j2455766194;
	j1299446498 [label="Gracias. Gracias, mon miracle, por tu honestidad. Esto requirió valentía en este momento y te felicito por ello.",shape=box,color=blue];
		j1299446498 -> j3654571896;
	j2455766194 [label="Gracias. Gracias, mon miracle...",shape=box,color=blue];
		j2455766194 -> j3445589583;
	j3654571896 [label="Atesoraré todos los momentos que hemos pasado juntos. Más de lo que puedas imaginar.",shape=box,color=blue];
		j3654571896 -> j3882345790;
	j3445589583 [label="De repente me siento muy cansado, como si... me hubieran quitado un gran peso de encima. Creo que debo recostarme.",shape=box,color=blue];
		j3445589583 -> j1852714091;
	j1852714091 [label="Lyon",shape=box,color=blue];
		j1852714091 -> j3446510588;
	j3446510588 [label="Boolean LyonDatingConfession is now true.",color=orange];
		j3446510588 -> "Chat ends.";
}