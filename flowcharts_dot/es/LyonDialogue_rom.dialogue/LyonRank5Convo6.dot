		1916 -> 1922;
	1920 [label="I will do what I can, mon miracle. She is my sister. But there is only so much I can do. I will ensure she speaks to you again, but after that, you must do the rest.",shape=box,color=blue];
		1920 -> 1924;
	1919 [label="I will do what I can, my friend. She is my sister. But there is only so much I can do. I will ensure she speaks to you again, but after that, you must do the rest.",shape=box,color=blue];
