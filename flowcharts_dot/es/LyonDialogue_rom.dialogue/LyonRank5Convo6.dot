		j3203510524 -> j2037196522 [label="MarieEntratiCompleteC",color=purple];
		j3203510524 -> "Chat ends." [label="false",color=purple];
	j1910288795 [label="Viajero. Tengo un pedido, si me lo permites.",shape=box,color=blue];
		j1910288795 -> j2601658474;
		j1910288795 -> j202800200;
	j1381282276 [label="¿Puedo tomarme un momento para felicitarte por algo que antes creía imposible con respecto a Marie? Me enteré de lo que pasó entre ustedes dos...",shape=box,color=blue];
		j1381282276 -> j2520325090;
		j1381282276 -> j3760292425;
		j1381282276 -> j202800200;
	j2059789768 [label="Debo enviarte mis condolencias por tu noble aunque trágicamente breve esfuerzo cuando se trata de Marie y el tema de \"le Cardinal.\"",shape=box,color=blue];
		j2059789768 -> j3760292425;
		j2059789768 -> j2520325090;
		j2059789768 -> j202800200;
	j2037196522 [label="Lamento que Marie y tú no hayan llegado a un acuerdo en cuanto a \"le Cardinal\". Pero me alegra que al menos que no haya llegado a mayores.",shape=box,color=blue];
		j2037196522 -> j3760292425;
		j2037196522 -> j2520325090;
		j2037196522 -> j202800200;
	"Chat ends." [color=orange];
	j2601658474 [label="¿Qué se te ofrece?",shape=box,color=red];
		j2601658474 -> j1579254130;
	j202800200 [label="[Fin]",shape=box,color=red];
		j202800200 -> "Chat ends.";
	j2520325090 [label="No estoy exactamente orgulloso de algunas cosas que dije, pero... ",shape=box,color=red];
		j2520325090 -> j3673425487;
	j3760292425 [label="Ella te dijo eso, ¿verdad?",shape=box,color=red];
		j3760292425 -> j2982406626;
	j1579254130 [label="Por favor convence a Marie de que deje de usar a los necramitos para replicar muebles. No sé que hacer con todas estas sillas.",shape=box,color=blue];
		j1579254130 -> j2207193681;
	j3673425487 [label="Después de todo hay una razón del por qué el término \"crimen de pasión\" fue inventado. Yo creo que si nosotros como criaturas no fuéramos fieles a nuestras creencias, la vida sería terriblemente aburrida.",shape=box,color=blue];
		j3673425487 -> j2190554917;
	j2982406626 [label="Sí, lo hizo. Hablamos todas las noches sobre como nos fue en el día. Y después de tu conversación, ella rápidamente vino a mi lado a decirme todo lo que pensaba sobre ello.",shape=box,color=blue];
		j2982406626 -> j831326800;
		j2982406626 -> j4162983418;
	j2207193681 [label="+20 Chemistry",color=orange];
		j2207193681 -> j1686668293;
	j2190554917 [label="Ciertamente más callada. Más pacífica. Pero aburrida. Y seguramente no habría arte del cual hablar.",shape=box,color=blue];
		j2190554917 -> j3113415849;
	j831326800 [label="¿Qué es lo que te dijo?",shape=box,color=red];
		j831326800 -> j3495933037;
	j4162983418 [label="... ¿Y?",shape=box,color=red];
		j4162983418 -> j3495933037;
	j1686668293 [label="Y me rehúso a tomar en cuenta sus... coloridas sugerencias sobre en qué lugar deberían ser guardadas dentro de la anatomía de Roathe.",shape=box,color=blue];
		j1686668293 -> "Chat ends.";
	j3113415849 [label="Pero me estoy desviando. Me preguntaba... en mis conversaciones con ella, parece que tus palabras fueron conmovedoras. Tengo que preguntar... ¿Te quedaste satisfecho en cómo dejaste las cosas entre ustedes?",shape=box,color=blue];
		j3113415849 -> j1424199455;
	j3495933037 [label="Check boolean LyonDating",color=orange];
		j3495933037 -> j4005678108 [label=true,color=green];
		j3495933037 -> j2744393521 [label=false,color=brown];
	j1424199455 [label="Evaluate expressions",color=orange];
		j1424199455 -> j607745377 [label="MarieDating & MarieFamilyFail",color=purple];
		j1424199455 -> j3326306197 [label="MarieDating & MarieFamilyFail",color=purple];
		j1424199455 -> j1139699858 [label="MarieFamilyFail",color=purple];
		j1424199455 -> j2294131056 [label="MarieFamilyFail",color=purple];
		j1424199455 -> j607745377 [label="MarieFamilySuccess",color=purple];
		j1424199455 -> j1336202491 [label="MarieEntratiCompleteA",color=purple];
		j1424199455 -> j1889499462 [label="MarieEntratiCompleteB",color=purple];
		j1424199455 -> j3021857993 [label="MarieEntratiCompleteB",color=purple];
		j1424199455 -> j380443068 [label="MarieEntratiCompleteC",color=purple];
		j1424199455 -> j3397362270 [label="false",color=purple];
	j4005678108 [label="¡Ja! Como si fuera a traicionar su confianza contigo. No importa que tan valioso seas para mí, mon miracle... ella ha sido mi alma hermana por muchos, muchos años.",shape=box,color=blue];
		j4005678108 -> j462462886;
	j2744393521 [label="¡Ja! Como si fuera a traicionar su confianza contigo. No importa que tan valioso seas para mí, amigo mío... ella ha sido mi alma hermana por muchos, muchos años.",shape=box,color=blue];
		j2744393521 -> j462462886;
	j607745377 [label="Lo estoy. Creo que es importante tener su ayuda para enmendar las cosas entre Loid y la familia de allá arriba. Eso es... extraordinario, Lyon. No creo poder explicar que tan increíble es eso.",shape=box,color=red];
		j607745377 -> j1660220181;
	j3326306197 [label="No, la verdad, por la manera en que las cosas quedaron entre nosotros, siento que he arruinado cualquier oportunidad de poder tener su ayuda para enmendar las cosas entre Loid y la familia que está allá arriba.",shape=box,color=red];
		j3326306197 -> j769561529;
	j1139699858 [label="No, la verdad, por la manera en que las cosas quedaron entre nosotros, siento que he arruinado cualquier oportunidad de poder tener su ayuda para enmendar las cosas entre Loid y la familia que está allá arriba.",shape=box,color=red];
		j1139699858 -> j3935613021;
	j2294131056 [label="Lo estoy. Ella no me ayudará en enmendar las cosas con Loid y la familia de allá arriba, y por mí, eso está bien.",shape=box,color=red];
		j2294131056 -> j2388272796;
	j1336202491 [label="Lo estoy. Me alegra que haya logrado ver que Entrati no es meramente \"bueno\", y... bueno, él no es estrictamente \"malo\" tampoco, ¿no?",shape=box,color=red];
		j1336202491 -> j426166388;
	j1889499462 [label="Estoy feliz con como quedaron las cosas. Honestamente, entre más lo pienso, estoy de su lado en cuanto a Entrati.",shape=box,color=red];
		j1889499462 -> j2388272796;
	j3021857993 [label="No estábamos de acuerdo en cuanto a Entrati. Fracasé en convencerla y... Ojalá lo hubiera hecho mejor.",shape=box,color=red];
		j3021857993 -> j2611221527;
	j380443068 [label="\"Acordamos no estar de acuerdo\" en cuanto a Entrati, y creo que eso es lo más lejos que podemos llegar sobre ese tema. No creo que seguir hablando ayude a mejorar las cosas.",shape=box,color=red];
		j380443068 -> j632911863;
	j3397362270 [label="La verdad, está bien así. No creo que vaya a mejorar o ponerse peor a estas alturas.",shape=box,color=red];
		j3397362270 -> j632911863;
	j462462886 [label="No, me temo que lo que me dijo debe ser guardado como un secreto. Pero la conmovieron. Aunque me pregunto, ¿te quedaste satisfecho en cómo dejaste las cosas entre ustedes?",shape=box,color=blue];
		j462462886 -> j1424199455;
	j1660220181 [label="Creo poder comprender su grandeza, si no es que su magnitud. Me siento... muy honrado de formar parte de ello, aunque sea un poco.",shape=box,color=blue];
		j1660220181 -> j2764365409;
		j1660220181 -> j1755183024;
	j769561529 [label="Fascinante... Bueno, eres su amor ahora, ¿no es así? Si alguien aquí tuviera el poder para convencerla... ese serías tú, ¿no?",shape=box,color=blue];
		j769561529 -> j2027320135;
	j3935613021 [label="Fascinante... Bueno, he sabido que tengo algo de... influencia sobre ella, por limitada que sea. ¿Crees que enmendar las relaciones entre M. Loid y la familia distanciada de Entrati sea importante?",shape=box,color=blue];
		j3935613021 -> j1763419931;
		j3935613021 -> j3783996176;
	j2388272796 [label="No sé si ese tono es el del enojo, arrogancia, ignorancia o apatía. Por lo tanto, optaré a que es una mezcla de las cuatro y seguiré adelante con mi día.",shape=box,color=blue];
		j2388272796 -> j3188054291;
	j426166388 [label="Por supuesto. Pienso igual que tú. No creo que sea de una manera o la otra, sino una mezcla de sus motivaciones.",shape=box,color=blue];
		j426166388 -> j753343971;
	j2611221527 [label="Hm. Bueno, desafortunadamente, eso llega en un momento en que todo debe dejarse de lado. Una masa puede trabajarse demasiado. Un artista puede agregar mucho a sus pinturas y un argumento puede volverse estresante.",shape=box,color=blue];
		j2611221527 -> j882896853;
	j632911863 [label="Sí, tal vez deberíamos pasar a temas más interesantes.",shape=box,color=blue];
		j632911863 -> j4172094119;
	j2764365409 [label="No creí que fueras a brindarme tu ayuda.",shape=box,color=red];
		j2764365409 -> j234807826;
	j1755183024 [label="¿Eso significa que me ayudarás a convencer a Loid en subir para hablar con ellos?",shape=box,color=red];
		j1755183024 -> j142021336;
	j2027320135 [label="Simplemente espero que no hayas hecho algún tipo de sacrificio cuando hablaste con ella... poniendo una cosa como prioridad sobre otra en un intento de cortejarla.",shape=box,color=blue];
		j2027320135 -> j994187602;
	j1763419931 [label="Hay mucha soledad en este mundo, Lyon. Tanta tristeza. ¿Por qué no acabar con ello mientras aún podemos? ",shape=box,color=red];
		j1763419931 -> j3095086449;
	j3783996176 [label="No estoy seguro, es un instinto... un presentimiento. Siento que ustedes tres fueron traídos aquí por Entrati, a este momento por una razón.",shape=box,color=red];
		j3783996176 -> j2892371165;
	j3188054291 [label="Es una lástima.",shape=box,color=blue];
		j3188054291 -> j3497962379;
	j753343971 [label="Se dejó llevar por la soberbia. Una sed por conocimiento. Ahora, quizás, un afán de perdón. ¿Quién sabe? Me pregunto si lo sabe.",shape=box,color=blue];
		j753343971 -> j3611010879;
	j882896853 [label="Supongo que simplemente elegiría dejarlo pasar. Y esperar que algún día ella pueda tener la oportunidad de ver a Entrati tal y como lo conocemos... como alguien complicado, en el mejor de los casos.",shape=box,color=blue];
		j882896853 -> j3611010879;
	j4172094119 [label="Yo, por mi parte, estoy dispuesto a dejar que se alejen de las interminables conversaciones sobre el maravilloso e impecable, \"le Cardinal\".",shape=box,color=blue];
		j4172094119 -> j3611010879;
	j234807826 [label="Sé que no soy muy amable, pero tampoco soy un demonio. Si quieres mi ayuda, la tendrás.",shape=box,color=blue];
		j234807826 -> j2800191596;
	j142021336 [label="Por supuesto. Si quieres mi asistencia, la tendrás.",shape=box,color=blue];
		j142021336 -> j2800191596;
	j994187602 [label="Qué lamentable situación sería.",shape=box,color=blue];
		j994187602 -> j1203977689;
	j3095086449 [label="Mm. ¿Y qué pasa con el posible dolor que una reintroducción podría causar entre las partes involucradas cuando se hacen tales revelaciones?",shape=box,color=blue];
		j3095086449 -> j1002165443;
		j3095086449 -> j1878914854;
	j2892371165 [label="¿Y te dedicas a hacer lo que Entrati te dice bajo la influencia de un \"presentimiento\"?",shape=box,color=blue];
		j2892371165 -> j3773961093;
		j2892371165 -> j866251013;
	j3497962379 [label="Boolean LyonFamilyFail is now true.",color=orange];
		j3497962379 -> "Chat ends.";
	j3611010879 [label="No sé que ocurrirá entre M. Loid y la familia distancia de Entrati. Solo quiero decir que si necesitas mi asistencia, la tendrás.",shape=box,color=blue];
		j3611010879 -> j2800191596;
	j2800191596 [label="Evaluate expressions",color=orange];
		j2800191596 -> j2111988831 [label="RoatheFamilyDelay",color=purple];
		j2800191596 -> j2683122638 [label="RoatheFamilyFail",color=purple];
		j2800191596 -> j1371815268 [label="false",color=purple];
	j1203977689 [label="Tendrás mi ayuda, por muy poco que te sirva.",shape=box,color=blue];
		j1203977689 -> j2024794676;
	j1002165443 [label="Va a doler al principio, por supuesto. Como cuando atiendes un hueso roto. Pero es la única manera de que algo como esto pueda sanar apropiadamente.",shape=box,color=red];
		j1002165443 -> j298253220;
	j1878914854 [label="Creo que lo que todos podemos ganar al estar juntos es mayor que lo que podemos perder al estar separados.",shape=box,color=red];
		j1878914854 -> j298253220;
	j3773961093 [label="No, pero me dedico a proteger a la gente que lo necesita. Y no puedo protegerlos, y a este lugar, del Murmullo y de la Infestación por siempre. Pero ustedes dos... y tal vez Roathe... puedan.",shape=box,color=red];
		j3773961093 -> j298253220;
	j866251013 [label="No confío en él, necesariamente... pero aún creo que no es nuestro enemigo. Siento que una guerra está por venir, y que nos están colocando en donde necesitamos estar. Y aquí es donde pertenecemos.",shape=box,color=red];
		j866251013 -> j3241247334;
	j2111988831 [label="Aunque creo que ya has completado lo que era la tarea más pesada... convencer a Roathe.",shape=box,color=blue];
		j2111988831 -> j266976019;
	j2683122638 [label="Aunque necesitaré sentarme a pensar en cómo convencer a Roathe a cambiar de opinión... lo cual no estoy seguro de lograrlo. Y sin él, puede que sea una causa perdida.",shape=box,color=blue];
		j2683122638 -> j88427221;
		j2683122638 -> j3816764591;
	j1371815268 [label="Aunque lo más difícil es convencerlo, me da miedo considerar que probablemente es el más importante... Roathe.",shape=box,color=blue];
		j1371815268 -> j88427221;
		j1371815268 -> j3816764591;
	j2024794676 [label="Boolean LyonFamilySuccess is now true.",color=orange];
		j2024794676 -> j4197617815;
	j298253220 [label="+20 Chemistry",color=orange];
		j298253220 -> j1224479686;
	j3241247334 [label="Mm. Quizás. Pero no somos piezas de ajedrez y me rehúso a ser tratado como una. Si Entrati quiere hacer semejante petición, puede mandarme una maldita carta.",shape=box,color=blue];
		j3241247334 -> j3166355022;
	j266976019 [label="Ese maldito bastardo... por mucho que me gustaría encontrar la manera de cerrarle la boca... es útil.",shape=box,color=blue];
		j266976019 -> j3941867773;
	j88427221 [label="Sí...",shape=box,color=red];
		j88427221 -> j266976019;
	j3816764591 [label="¿Por qué es Roathe tan importante para todo esto?",shape=box,color=red];
		j3816764591 -> j3826789522;
	j4197617815 [label="Lyon",shape=box,color=blue];
		j4197617815 -> j1933300832;
	j1224479686 [label="Es cierto. Sabias palabras. Muy bien. Hablaré con ella. Veré si es que puedo convencerla de hablar contigo de nuevo sobre esto.",shape=box,color=blue];
		j1224479686 -> j577168214;
		j1224479686 -> j462295935;
	j3166355022 [label="De esta manera, me temo que me uno a las quejas de M. Loid. Puede que cuente con mi asistencia para convencerlo, pero no creo que llegue muy lejos sin Marie.",shape=box,color=blue];
		j3166355022 -> j774461686;
	j3941867773 [label="Check boolean RoatheDating",color=orange];
		j3941867773 -> j57492123 [label=true,color=green];
		j3941867773 -> j2764894915 [label=false,color=brown];
	j3826789522 [label="Marie y yo somos forasteros. Roathe, Loid, Entrati y la hija de Entrati son todos contemporáneos. Sin mencionar, que él tiene un conocimiento que puede utilizar para protegerlos si las cosas salen mal.",shape=box,color=blue];
		j3826789522 -> j2830907857;
	j1933300832 [label="+10 Chemistry",color=orange];
		j1933300832 -> "Chat ends.";
	j577168214 [label="Espera... ¿La vas a... convencer para ayudar con la familia de Entrati por mí?",shape=box,color=red];
		j577168214 -> j1339652253;
	j462295935 [label="Yo... tú... ¿Lo harás?",shape=box,color=red];
		j462295935 -> j1339652253;
	j774461686 [label="Boolean LyonFamilySuccess is now true.",color=orange];
		j774461686 -> j3761320020;
	j57492123 [label="Sin ofender.",shape=box,color=blue];
		j57492123 -> j3297790563;
		j57492123 -> j2527454760;
	j2764894915 [label="Una vez más, me estoy desviando. Como dije antes, cuando llegue el momento. Y, hablando de tiempo, es hora de que me vaya.",shape=box,color=blue];
		j2764894915 -> j3085226709;
	j2830907857 [label="Aunque odie admitirlo, Marie y yo seguiríamos torpemente intentando discernir en cómo utilizar la mitad de las cosas que hay en este lugar, mientras que él lo manejaría con facilidad.",shape=box,color=blue];
		j2830907857 -> j266976019;
	j1339652253 [label="Check boolean LyonDating",color=orange];
		j1339652253 -> j3702529182 [label=true,color=green];
		j1339652253 -> j841271398 [label=false,color=brown];
	j3761320020 [label="Te deseo suerte. Adiós, por ahora.",shape=box,color=blue];
		j3761320020 -> j3700048672;
	j3297790563 [label="Más para mí.",shape=box,color=red];
		j3297790563 -> j4209433328;
	j2527454760 [label="No te preocupes. Sé que no a todos les agrada Roathe.",shape=box,color=red];
		j2527454760 -> j4209433328;
	j3085226709 [label="+20 Chemistry",color=orange];
		j3085226709 -> j2872949966;
	j3702529182 [label="Haré lo que pueda, mon miracle. Es mi hermana. Pero no puedo hacer mucho. Me aseguraré de que te hable de nuevo, pero después de eso, te deberás de encargar del resto.",shape=box,color=blue];
		j3702529182 -> j4022582828;
	j841271398 [label="Haré lo que pueda, amigo mío. Es mi hermana. Pero no puedo hacer mucho. Me aseguraré de que te hable de nuevo, pero después de eso, te deberás de encargar del resto.",shape=box,color=blue];
		j841271398 -> j4022582828;
	j3700048672 [label="Lyon",shape=box,color=blue];
		j3700048672 -> "Chat ends.";
	j4209433328 [label="Mmm. Te daré mi asistencia, como dije antes, cuando llegue el momento. Y, hablando de tiempo, es hora de que me vaya.",shape=box,color=blue];
		j4209433328 -> j3085226709;
	j2872949966 [label="Adiós,\nLyon",shape=box,color=blue];
