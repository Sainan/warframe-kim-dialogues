		1830 -> 1834;
		1830 -> 1833;
		1830 -> 1835;
	1829 [label="I must send my condolences to you for your noble yet tragically short-lived endeavors when it comes to Marie and the matter of \"le Cardinal.\"",shape=box,color=blue];
		1829 -> 1833;
		1829 -> 1834;
		1829 -> 1835;
	1828 [label="I am sorry you and Marie have not come to see eye to eye when it comes to matters of \"le Cardinal.\" But I am at least happy it has not come to blows.",shape=box,color=blue];
		1828 -> 1833;
		1828 -> 1834;
		1828 -> 1835;
	1827 [label="Chat ends.",color=orange];
	1832 [label="What is it?",shape=box,color=red];
		1832 -> 1837;
	1831 [label="[Fin.]",shape=box,color=red];
		1831 -> 1836;
	1834 [label="I'm not exactly proud of a few of the things I said, but... ",shape=box,color=red];
		1834 -> 1839;
	1833 [label="She told you all that, did she?",shape=box,color=red];
		1833 -> 1838;
	1835 [label="[Fin.]",shape=box,color=red];
		1835 -> 1840;
	1837 [label="Please convince Marie to stop using the necramites to replicate furniture. I do not know what to do with all of these chairs as it is.",shape=box,color=blue];
		1837 -> 1841;
	1836 [label="Chat ends.",color=orange];
	1839 [label="There is a reason why the term \"crime of passion\" was invented, after all. If we as creatures were not adhered to our beliefs, life would be terribly dull, I think.",shape=box,color=blue];
		1839 -> 1844;
	1838 [label="She did. We speak nightly of the goings-on of the day. And after your conversation, she was quick to rush to my side to tell me all she thought of it.",shape=box,color=blue];
		1838 -> 1842;
		1838 -> 1843;
	1840 [label="Chat ends.",color=orange];
	1841 [label="+20 Chemistry",color=orange];
		1841 -> 1845;
	1844 [label="Certainly quieter. More peaceful. But dull. There certainly would be no art to speak of.",shape=box,color=blue];
		1844 -> 1847;
	1842 [label="What did she tell you?",shape=box,color=red];
		1842 -> 1846;
	1843 [label="... And?",shape=box,color=red];
		1843 -> 1846;
	1845 [label="And I refuse to take her... colorful suggestions as to where inside Roathe's anatomy they are intended to be stored.",shape=box,color=blue];
		1845 -> 1848;
	1847 [label="But I digress. I wonder - in my conversations with her, it sounds as though your words were moving. I have to ask - were you pleased with how you left matters between you?",shape=box,color=blue];
