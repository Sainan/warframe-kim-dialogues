		1901 -> 1906;
	1902 [label="Indeed. Wise words. Very well. I will speak to her. I will see if I can convince her to talk to you again regarding this.",shape=box,color=blue];
		1902 -> 1907;
		1902 -> 1908;
	1903 [label="In this way, I fear I side with the complaints of M. Loid. You may have my assistance in convincing him, but I do not think you will get far without Marie.",shape=box,color=blue];
