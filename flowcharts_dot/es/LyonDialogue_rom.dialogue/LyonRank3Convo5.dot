		554 -> 559;
	555 [label="Bien. Asegúrate de eso. No me gustaría tener que hacerte entrar en razón a golpes. Pareces de los que regresan el golpe.",shape=box,color=blue];
		555 -> 560;
	556 [label="Update boolean LyonFaith1",color=orange];
		556 -> 561;
	557 [label="Gracias. No es que no crea que seas sincero en lo que escribes. Es simplemente que mi experiencia me ha enseñado lo contrario.",shape=box,color=blue];
		557 -> 559;
	558 [label="No es que no crea que seas sincero en lo que escribes. Es simplemente que mi experiencia me ha enseñado lo contrario. ",shape=box,color=blue];
		558 -> 559;
	559 [label="Mientras tanto tendré que pedir perdón y más de tu paciencia. ",shape=box,color=blue];
