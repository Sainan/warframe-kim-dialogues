digraph {
	445 [label="LyonRank3Convo5 begins.",color=orange];
		445 -> 446;
	446 [label="La noche en que nos visitó el \"Cardinal Dimanche\" había una tormenta eléctrica. Permaneció en el santuario de la iglesia, ajeno a la tempestad que azotaba el exterior.",shape=box,color=blue];
		446 -> 447;
	447 [label="Eso debería haberme preocupado en primer lugar. En vez de eso, incliné la cabeza ante él y lo saludé como a cualquier otro enviado de la Santísima Madre.",shape=box,color=blue];
		447 -> 448;
	448 [label="Después de todo, esperábamos un nuevo cardenal ya que el anterior había fallecido varios meses antes debido a una enfermedad.",shape=box,color=blue];
		448 -> 449;
	449 [label="Dimanche me saludó con una cálida sonrisa y un firme apretón de manos. Le pregunté si su viaje había sido largo. Jamás olvidaré su respuesta.",shape=box,color=blue];
		449 -> 450;
	450 [label="\"Fue difícil... pero no duró mucho.\"",shape=box,color=blue];
		450 -> 451;
	451 [label="En aquel momento me intrigó, al igual que el hecho de que su abrigo estuviera completamente seco. Pero no le di importancia, como solemos hacer todos ante lo inusual.",shape=box,color=blue];
		451 -> 452;
	452 [label="Y no tuve tiempo de considerarlo, ya que Marie, con su impaciencia, llegó un instante después.",shape=box,color=blue];
		452 -> 453;
	453 [label="Se arrodilló para saludarla a su altura, sentada en su silla, y tomó sus manos entre las suyas. Debí haber reconocido la manipulación.",shape=box,color=blue];
		453 -> 454;
	454 [label="Después de todo, no fue el único demonio que llegó a nuestra puerta en medio de una tormenta.",shape=box,color=blue];
		454 -> 455;
	455 [label="Update boolean LyonEntrati1",color=orange];
		455 -> 456;
	456 [label="Check boolean MarieEntrati1",color=orange];
		456 -> 457 [label=true,color=green];
		456 -> 459 [label=true,color=green];
		456 -> 460 [label=true,color=green];
		456 -> 458 [label=false,color=brown];
		456 -> 457 [label=false,color=brown];
	457 [label="¿El otro demonio era Roathe?",shape=box,color=red];
		457 -> 461;
	459 [label="Ella cuenta esta historia de forma muy diferente.",shape=box,color=red];
		459 -> 463;
	460 [label="Ella aún cree en sus buenas intenciones. ¿Y tú?",shape=box,color=red];
		460 -> 464;
	458 [label="Supongo que no eres aliado de Entrati, ¿verdad?",shape=box,color=red];
		458 -> 462;
	461 [label="Sí. Pero esa es otra historia. Si empiezo a hablar de él, mi ya de por sí mal humor empeorará... ",shape=box,color=blue];
		461 -> 465;
	463 [label="Sí. Ella lo haría.",shape=box,color=blue];
		463 -> 467;
		463 -> 468;
	464 [label="+5 Chemistry",color=orange];
		464 -> 469;
	462 [label="Después de soportar sus mentiras y traición, y mientras seguimos sufriendo su manipulación de Marie, ¿quieres que lo sea? No, desde luego que no.",shape=box,color=blue];
		462 -> 466;
	465 [label="...insostenible. Si no te importa, preferiría centrar mi estado de ánimo actual en las fechorías de Entrati.",shape=box,color=blue];
		465 -> 470;
	467 [label="Ella me dice que a veces ves cosas que otros no ven.",shape=box,color=red];
		467 -> 472;
	468 [label="¿Y? ",shape=box,color=red];
		468 -> 473;
	469 [label="Marie cree en lo mejor de todas las almas. Es una habilidad que ha cultivado, perfeccionado y pulido como un escudo contra el mundo que la rodea.",shape=box,color=blue];
		469 -> 474;
		469 -> 475;
	466 [label="+5 Chemistry",color=orange];
		466 -> 471;
	470 [label="Check boolean RoatheSerum1",color=orange];
		470 -> 476 [label=true,color=green];
		470 -> 477 [label=true,color=green];
		470 -> 476 [label=false,color=brown];
		470 -> 478 [label=false,color=brown];
	472 [label="¿Y qué pensarías de esa afirmación, si fuera cierta, Viajero?",shape=box,color=blue];
		472 -> 480;
	473 [label="\"Y\" nada más. Te he contado de como presencié el suceso, tal como la verdad de lo que viví. Nada más.",shape=box,color=blue];
		473 -> 469;
	474 [label="Marie desconoce todos los detalles sobre lo que Entrati es realmente capaz de hacer, y todas las cosas horribles que ha hecho en nombre del \"progreso\" y ahora de la \"redención\".",shape=box,color=red];
		474 -> 481;
	475 [label="Marie es una mujer adulta. Si bien admiro tu deseo de protegerla, ella puede tomar sus propias decisiones sobre en qué cree y en quién deposita su fe.",shape=box,color=red];
		475 -> 482;
	471 [label="Manchar nuestros cuerpos, destruir nuestros futuros, corromper nuestros pasados... todo esto, tal vez podría perdonarlo.",shape=box,color=blue];
		471 -> 479;
	476 [label="Entrati quizá no tenga los mejores modales, pero está intentando salvar el universo.",shape=box,color=red];
		476 -> 471;
	477 [label="¿Te obligó a convertirte en un protoframe como a Roathe?",shape=box,color=red];
		477 -> 483;
	478 [label="Por supuesto. ¿Por qué estás molesto con Entrati?",shape=box,color=red];
		478 -> 484;
	480 [label="Check boolean LyonVisions1",color=orange];
		480 -> 486 [label=true,color=green];
		480 -> 488 [label=true,color=green];
		480 -> 489 [label=true,color=green];
		480 -> 486 [label=false,color=brown];
		480 -> 487 [label=false,color=brown];
		480 -> 488 [label=false,color=brown];
	481 [label="La confianza es como un vitral. Delicado en su creación. Hermoso en su esplendor. Trágico cuando se rompe. Y peligroso una vez destruido.",shape=box,color=blue];
		481 -> 496;
	482 [label="La confianza es como un vitral. Delicado en su creación. Hermoso en su esplendor. Trágico cuando se rompe. Y peligroso una vez destruido.",shape=box,color=blue];
		482 -> 491;
	479 [label="Pero, ¿cómo ha manipulado a Marie...? ¿Cómo ha utilizado su fe en la bondad de los demás para sus propios fines?",shape=box,color=blue];
		479 -> 485;
	483 [label="No. Tenía mis razones para aceptar el elixir. Sabía en qué criatura retorcida me convertiría. Igual que Marie.",shape=box,color=blue];
		483 -> 492;
	484 [label="+5 Chemistry",color=orange];
		484 -> 471;
	486 [label="Supongo que me da igual, ¿no?",shape=box,color=red];
		486 -> 493;
	488 [label="Mi única pregunta es, si ves cosas, ¿no te molestan esas visiones?",shape=box,color=red];
		488 -> 495;
	489 [label="Lo que dijiste el otro día... me hizo preguntarme si estás bien, eso es todo.",shape=box,color=red];
		489 -> 494;
	487 [label="Sólo quería saber si estabas bien, eso es todo.",shape=box,color=red];
		487 -> 494;
	496 [label="+15 Chemistry",color=orange];
		496 -> 502;
	491 [label="Bajo la cálida luz de Sol, ella se deleita en su resplandor, incapaz de ver las imperfecciones que se forman en su superficie. Incapaz de oír las grietas que se profundizan.",shape=box,color=blue];
		491 -> 497;
	485 [label="Eso... jamás lo perdonaré. Eso... quiero arrancarle de la carne con mi incensario hasta que implore por la salvación.",shape=box,color=blue];
		485 -> 474;
		485 -> 475;
	492 [label="No nos... quebraron a la fuerza, como al diablo. Siento mucha pena por Roathe y por todo lo que ha sufrido.",shape=box,color=blue];
		492 -> 498;
	493 [label="Entonces no veo necesidad de continuar esta conversación.",shape=box,color=blue];
		493 -> 499;
	495 [label="Voy a ser muy franco al decir que no sé cómo responder a eso, Viajero.",shape=box,color=blue];
		495 -> 501;
	494 [label="Update boolean LyonAllRight",color=orange];
		494 -> 500;
	502 [label="Ojalá pudiera arrebatarle la corrupción que él sembró en su mente. Solo puedo rezar para que tú tengas éxito donde yo he fracasado.",shape=box,color=blue];
		502 -> 507;
	497 [label="Sin saber que los fragmentos de su propia obra maestra pronto se volverían en su contra. Prefirió cegarse ante lo que inevitablemente sucedería.",shape=box,color=blue];
		497 -> 503;
	498 [label="Entonces él abre la boca para hablar.",shape=box,color=blue];
		498 -> 504;
		498 -> 505;
	499 [label="Chat ends.",color=orange];
	501 [label="Durante toda mi vida, he presenciado horrores que harían que otros fueran internados en un manicomio. Y, aún más trágico, de vez en cuando mis visiones se hacían realidad.",shape=box,color=blue];
		501 -> 506;
	500 [label="\"¿Estoy bien?\" Seré muy sincero al decir que no sé cómo responder a eso, Viajero.",shape=box,color=blue];
		500 -> 501;
	507 [label="-F. Lyon Allard",shape=box,color=blue];
		507 -> 513;
	503 [label="Ojalá pudiera soportar ese sufrimiento en su lugar. Con qué gusto me lo tatuaría en mi alma. Pero esto es por ella, y sólo por ella.",shape=box,color=blue];
		503 -> 508;
	504 [label="Hay que recordar cómo él se crió. El entorno en el que tuvo que aprender a sobrevivir. Era —es— Orokin.",shape=box,color=red];
		504 -> 509;
		504 -> 510;
	505 [label="Sinceramente, no me parece tan malo. Me está empezando a caer bien.",shape=box,color=red];
		505 -> 511;
	506 [label="Update boolean LyonVisions1",color=orange];
		506 -> 512;
	513 [label="Chat ends.",color=orange];
	508 [label="Así pues, intentaré evitar este dolor, Viajero. ",shape=box,color=blue];
		508 -> 514;
	509 [label="No lo justifica, pero podría ayudarte a aprender a ceder un poco más.",shape=box,color=red];
		509 -> 515;
	510 [label="Está haciendo lo que cree que debe hacer.",shape=box,color=red];
		510 -> 516;
	511 [label="Yo consultaría con M. Loid para que me recetara una crema para esa dolencia, para evitar que se extienda.",shape=box,color=blue];
		511 -> 517;
		511 -> 518;
	512 [label="Update boolean LyonBackstory1",color=orange];
		512 -> 519;
	514 [label="¿Y si ves en ese acto algún intento de que se sienta insignificante?",shape=box,color=blue];
		514 -> 520;
	515 [label="Add 1 to Thermostat",color=orange];
		515 -> 521;
	516 [label="Add -1 to Thermostat",color=orange];
		516 -> 522;
	517 [label="El diablo siempre tiene cierto encanto.",shape=box,color=red];
		517 -> 523;
	518 [label="No te preocupes, no me dejaré seducir por su encanto.",shape=box,color=red];
		518 -> 524;
	519 [label="Y por eso, pensé que eran la guía de Lua. Que Las Luminarias me habían elegido para llevar tal carga. O al menos así lo creí entonces. Por eso quise ingresar al sacerdocio.",shape=box,color=blue];
		519 -> 525;
		519 -> 526;
		519 -> 527;
	520 [label="Que Lua se apiade de tu alma.",shape=box,color=blue];
		520 -> 528;
	521 [label="En nuestras escrituras, no se negocia con los demonios, sino que se les expulsa. Pero no nos prepararon para esta situación en particular.",shape=box,color=blue];
		521 -> 529;
	522 [label="Tal vez. Aún no estoy seguro de que no haya duda en el corazón de esa criatura.",shape=box,color=blue];
		522 -> 529;
	523 [label="Add -1 to Thermostat",color=orange];
		523 -> 530;
	524 [label="Add 1 to Thermostat",color=orange];
		524 -> 531;
	525 [label="¿Creías que las visiones provenían de Lua? ¿Ya no lo crees?",shape=box,color=red];
		525 -> 532;
	526 [label="¿Qué clase de horrores...?",shape=box,color=red];
		526 -> 533;
	527 [label="¿Y qué opinas ahora?",shape=box,color=red];
		527 -> 534;
	528 [label="-F. Lyon Allard",shape=box,color=blue];
		528 -> 535;
	529 [label="Ya veremos qué camino elige recorrer ese demonio en particular, ¿no?",shape=box,color=blue];
		529 -> 536;
	530 [label="Y eso es lo que me preocupa. El diablo sonríe y dice cosas sensatas cuando todos los demás enloquecen. ",shape=box,color=blue];
		530 -> 537;
	531 [label="+20 Chemistry",color=orange];
		531 -> 538;
	532 [label="Lo que creo se ha vuelto... complicado últimamente debido a la introducción de nueva información.",shape=box,color=blue];
		532 -> 534;
	533 [label="Apenas hemos comenzado a hablar de estas cosas, Viajero. No es que no crea que lo hayas presenciado, de primera mano, el sufrimiento más terrible, ni que crea que necesites protección ante las escasas descripciones que pueda evocar.",shape=box,color=blue];
		533 -> 539;
	534 [label="Sencillamente, Viajero, sería honesto decir que no sé qué creer.",shape=box,color=blue];
		534 -> 540;
	535 [label="Chat ends.",color=orange];
	536 [label="-F. Lyon Allard",shape=box,color=blue];
		536 -> 541;
	537 [label="Nos encontró sin avisar, cuando éramos más vulnerables. Cuando estábamos débiles. Cuando estábamos necesitados de respuestas.",shape=box,color=blue];
		537 -> 542;
		537 -> 543;
	538 [label="Bien. Asegúrate de que no sea así. No me gustaría tener que hacerte entrar en razón a golpes. Pareces de los que regresan el golpe.",shape=box,color=blue];
		538 -> 544;
	539 [label="Me agota hablar de estas cosas con alguien que acabo de conocer, solo para que nunca más vuelva a acercarse a mí. Preferiría que esto no sucediera en una situación en la que parecemos estar obligados a trabajar juntos, al menos a corto plazo.",shape=box,color=blue];
		539 -> 545;
		539 -> 546;
	540 [label="Update boolean LyonFaith1",color=orange];
		540 -> 547;
	541 [label="+20 Chemistry",color=orange];
		541 -> 548;
	542 [label="Puedo cuidarme solo. Prometo que no dejaré que se me meta en la cabeza.",shape=box,color=red];
		542 -> 549;
	543 [label="Parece que hablas por experiencia. ¿Qué respuestas te dio?",shape=box,color=red];
		543 -> 550;
	544 [label="¿Y entonces en qué extraño estado nos encontraríamos?",shape=box,color=blue];
		544 -> 551;
	545 [label="Si quieres esperar hasta confiar más en mí, lo entiendo.",shape=box,color=red];
		545 -> 552;
	546 [label="No me voy a ir ningún lado, Lyon. Puedes confiar en mí.",shape=box,color=red];
		546 -> 553;
	547 [label="Pero me temo que todo eso es un tema para otro día.",shape=box,color=blue];
		547 -> 554;
	548 [label="Chat ends.",color=orange];
	549 [label="+20 Chemistry",color=orange];
		549 -> 555;
	550 [label="Respuestas que me temo... han puesto en duda muchas cosas. Pero me temo que todo eso es un tema para otro día.",shape=box,color=blue];
		550 -> 556;
	551 [label="Chat ends.",color=orange];
