	328 [label="Intriguing. I had assumed you believed your Indifference to be a deity, much in the same manner as Lua or Sol. Was I incorrect?",shape=box,color=blue];
		328 -> 337;
		328 -> 338;
	333 [label="No. But I think it gives me a kind of peace to think I can guess at what the Indifference is doing, at the end of the day.",shape=box,color=red];
		333 -> 342;
	334 [label="No, I suppose I'm not, at the end of the day. But I've had enough interactions with it, that I feel like I'm justified in trying to figure it out.",shape=box,color=red];
		334 -> 343;
	335 [label="What else could they be? The Indifference seems to be taking each part of the human body and trying to work out its purpose, one at a time.",shape=box,color=red];
		335 -> 344;
	336 [label="As that is what they devolve into once slain. We have all proven that many times over.",shape=box,color=blue];
		336 -> 345;
