digraph {
	"LyonRank3Convo3 begins." [color=orange];
		"LyonRank3Convo3 begins." -> j2379008195;
	j2379008195 [label="Estaba ayudando a M. Loid en su biblioteca, recolocando libros en los estantes, aunque él insistía en que esos extraños artilugios voladores... podían hacer el trabajo en su lugar...",shape=box,color=blue];
		j2379008195 -> j3625903686;
	j3625903686 [label="Y me encontré con un curioso volumen que detalla cuentos infantiles, ambientados en un mundo ficticio escrito por una tal Euleria Entrati.",shape=box,color=blue];
		j3625903686 -> j2801945214;
	j2801945214 [label="Al percatarme de que el autor compartía apellido con el verdadero nombre de nuestro \"Cardenal Dimanche\", inmediatamente aparté el libro para mí.",shape=box,color=blue];
		j2801945214 -> j3029844997;
		j2801945214 -> j100871475;
		j2801945214 -> j1678137900;
	j3029844997 [label="Creo saber a qué libro te refieres...",shape=box,color=red];
		j3029844997 -> j2615697118;
	j100871475 [label="¿Podemos saltarnos el preámbulo, por favor? Pregúntame lo que quieras saber.",shape=box,color=red];
		j100871475 -> j1384016083;
	j1678137900 [label="[Ignorar]",shape=box,color=red];
		j1678137900 -> "Chat ends.";
	j2615697118 [label="+5 Chemistry",color=orange];
		j2615697118 -> j2152303341;
	j1384016083 [label="Boolean LyonMITW1 is now true.",color=orange];
		j1384016083 -> j3016338605;
	"Chat ends." [color=orange];
	j2152303341 [label="Sospecho... a juzgar por la mirada de horror que me dirigió M. Loid y su insistencia en que dejara el libro inmediatamente, \"para no molestarte\"... que sabes algo al respecto.",shape=box,color=blue];
		j2152303341 -> j120965864;
	j3016338605 [label="Mi pregunta está relacionada con la naturaleza de la \"Encarnación Conceptual\". Tras leerla, entendí que el libro tenía como objetivo enseñar a los niños a evitar que sus emociones interactuaran con el Vacío.",shape=box,color=blue];
		j3016338605 -> j3662049819;
		j3016338605 -> j4074563776;
	j120965864 [label="\"Los cuentos de Duviri\". Si bien recibí una explicación bastante... exhaustiva y prolongada de M. Loid sobre lo que sufriste, hay un asunto en particular sobre el cual quisiera preguntar.",shape=box,color=blue];
		j120965864 -> j3469098136;
	j3662049819 [label="Para lo poco que sirvió. Especialmente en mi caso.",shape=box,color=red];
		j3662049819 -> j457915699;
	j4074563776 [label="Las emociones intensas que interactúan con el Vacío pueden causar... graves problemas.",shape=box,color=red];
		j4074563776 -> j3925862842;
	j3469098136 [label="Si, por supuesto, ¿no es demasiado problemático hacerlo?",shape=box,color=blue];
		j3469098136 -> j12291081;
		j3469098136 -> j1193421145;
	j457915699 [label="¿Cuántas cosas de nuestra vida nos han sido presentadas por otros como hechos, solo para resultar inútiles al ser puestas a prueba?",shape=box,color=blue];
		j457915699 -> j202541476;
	j3925862842 [label="Así parece. He conocido a los Cavia. Me han hablado de los Ángeles del Vacío. He visto al Murmullo con mis propios ojos. ",shape=box,color=blue];
		j3925862842 -> j899364883;
	j12291081 [label="No. Adelante.",shape=box,color=red];
		j12291081 -> j1384016083;
	j1193421145 [label="Depende totalmente de los detalles, supongo. No tengo ni idea de lo que me vas a preguntar.",shape=box,color=red];
		j1193421145 -> j3402791256;
	j202541476 [label="Boolean LyonFaith1 is now true.",color=orange];
		j202541476 -> j3375503000;
	j899364883 [label="Y esa es la naturaleza de mi curiosidad. Me lo pregunto en voz alta para ver si podrías explicarlo. Cuando el Vacío cobra forma, ¿lo que surge de él... es real?",shape=box,color=blue];
		j899364883 -> j2078640286;
		j899364883 -> j1328378816;
		j899364883 -> j3478676976;
	j3402791256 [label="+5 Chemistry",color=orange];
		j3402791256 -> j1873470301;
	j3375503000 [label="A menudo me pregunto por qué llenan las cabezas de los demás con mentiras tan inútiles. ¿Acaso buscan poder? ¿Influencia? ¿O crees que realmente se creen sus propias palabras y desconocen sus propias mentiras?",shape=box,color=blue];
		j3375503000 -> j3687730875;
		j3375503000 -> j667183079;
	j2078640286 [label="No, creo que todo lo creado por el Vacío es simplemente... temporal. Un fragmento de quien o lo que sea que lo creó. Un fantasma de un recuerdo.",shape=box,color=red];
		j2078640286 -> j1692984826;
	j1328378816 [label="Sí, creo que sí. Como una pintura hecha por un artista, puede que haya surgido de la mente de alguien, pero es real una vez que está hecha.",shape=box,color=red];
		j1328378816 -> j506597763;
	j3478676976 [label="Eso depende enteramente de tu definición de \"real\".",shape=box,color=red];
		j3478676976 -> j436640455;
	j1873470301 [label="Sí, discúlpame. No soy muy hábil para... conversar de forma directa. Sobre todo de una manera tan extraña como esta. Pero intentaré hacerlo ahora.",shape=box,color=blue];
		j1873470301 -> j1384016083;
	j3687730875 [label="En este caso, creo que Euleria Entrati pretendía que lo que escribió fuera útil. Simplemente no me sirvió cuando lo necesitaba.",shape=box,color=red];
		j3687730875 -> j75224698;
	j667183079 [label="No lo sé. ¿De qué mentiras te habían llenado la cabeza, Lyon?",shape=box,color=red];
		j667183079 -> j2652230610;
	j1692984826 [label="¿Acaso no son los efectos causados por tales elementos del Vacío \"reales\"?",shape=box,color=blue];
		j1692984826 -> j1676481561;
	j506597763 [label="Pero la analogía que usas no es del todo precisa, ¿verdad? La materia recuperada del Vacío regresa al Vacío, ¿no es así?",shape=box,color=blue];
		j506597763 -> j28768887;
	j436640455 [label="+5 Chemistry",color=orange];
		j436640455 -> j4109964775;
	j75224698 [label="En su defensa, mi exposición al Vacío fue mucho más prolongada de lo que ella pretendía en el libro.",shape=box,color=red];
		j75224698 -> j3248284699;
	j2652230610 [label="Ninguna que haya venido a discutir contigo.",shape=box,color=blue];
		j2652230610 -> "Chat ends.";
	j1676481561 [label="Muchos recuerdos han llevado a un hombre al alcoholismo o lo han inspirado a quitarse la vida. ¿Acaso esos recuerdos no son \"reales\"?",shape=box,color=blue];
		j1676481561 -> j425545660;
	j28768887 [label="Muy bien, una reflexión. Un poema o una canción existen aunque no estén escritos.",shape=box,color=red];
		j28768887 -> j99338979;
	j4109964775 [label="¿Podrías dar más detalles?",shape=box,color=blue];
		j4109964775 -> j1819208503;
	j3248284699 [label="+5 Chemistry",color=orange];
		j3248284699 -> j127824749;
	j425545660 [label="Pero esas eran fuerzas internas que el hombre dejó que actuaran sobre él, ese es mi punto. No externas.",shape=box,color=red];
		j425545660 -> j2824237655;
	j99338979 [label="Pero si se olvida, deja de existir. Una historia perdida en el tiempo se pierde para siempre.",shape=box,color=blue];
		j99338979 -> j3537999934;
	j1819208503 [label="¿Cómo se mide la \"realidad\"?",shape=box,color=red];
		j1819208503 -> j2973296979;
		j1819208503 -> j3960745798;
		j1819208503 -> j1038534473;
	j127824749 [label="La ignorancia, por desgracia, es lo mejor que cualquiera de nosotros puede esperar que cause la maldad en otros.",shape=box,color=blue];
		j127824749 -> j1573695981;
	j2824237655 [label="Pero, ¿cuál es la diferencia?, me pregunto. Si el resultado final es el mismo, ¿importa?",shape=box,color=blue];
		j2824237655 -> j3173864690;
		j2824237655 -> j3021287362;
		j2824237655 -> j722592463;
	j3537999934 [label="Una revolución arrancada de las mentes de quienes la empuñan es, en verdad, una espada sin filo.",shape=box,color=blue];
		j3537999934 -> j3173864690;
		j3537999934 -> j3021287362;
		j3537999934 -> j722592463;
	j2973296979 [label="¿Por permanencia física? ¿Peso y masa? Lo que proviene del Vacío solo está aquí temporalmente.",shape=box,color=red];
		j2973296979 -> j357991603;
	j3960745798 [label="¿Por su efecto en los acontecimientos? Lo que surgió del Vacío ha cambiado el curso de la historia.",shape=box,color=red];
		j3960745798 -> j4211747750;
	j1038534473 [label="¿Por su efecto en los demás? Ciertamente, la influencia de las \"cosas\" que provienen del Vacío ha tenido ese efecto.",shape=box,color=red];
		j1038534473 -> j54987525;
	j1573695981 [label="Sin embargo, mi curiosidad no se centra en el libro ni en su utilidad. Perdona que me ponga un poco poético.",shape=box,color=blue];
		j1573695981 -> j3681935686;
	j3173864690 [label="No estás preguntando si son \"reales\", sino si son \"válidos\". Si deberían descartarse o no.",shape=box,color=red];
		j3173864690 -> j179404643;
	j3021287362 [label="También me gustaría preguntar si tus Luminarias son \"reales\" simplemente porque no puedes estrechar la mano de Sol o Lua.",shape=box,color=red];
		j3021287362 -> j3704894359;
	j722592463 [label="Estás preguntando, de forma indirecta, si todas las \"cosas\" del Vacío están aquí solo porque nosotros las hemos traído a la existencia.",shape=box,color=red];
		j722592463 -> j319463564;
	j357991603 [label="¿Estás diciendo que todo lo que proviene del Vacío debe regresar a él? Pero, ¿acaso el Vacío no está, por definición, compuesto de la nada?",shape=box,color=blue];
		j357991603 -> j1034307130;
	j4211747750 [label="Es un punto válido. ¿Acaso una revolución no es \"real\" simplemente porque no se puede meter en una cesta y pesarla?",shape=box,color=blue];
		j4211747750 -> j54987525;
	j54987525 [label="Sin duda, costó la vida a muchos. Defenderían su validez con vehemencia. Sin embargo, considera lo siguiente:",shape=box,color=blue];
		j54987525 -> j4007123572;
	j3681935686 [label="Me lo pregunto en voz alta para ver si podrías explicarlo. Cuando el Vacío cobra forma, ¿lo que surge de él... es real?",shape=box,color=blue];
		j3681935686 -> j2078640286;
		j3681935686 -> j3478676976;
		j3681935686 -> j1328378816;
	j179404643 [label="+5 Chemistry",color=orange];
		j179404643 -> j3173036913;
	j3704894359 [label="No estamos hablando de Las Luminarias. Estamos hablando del Vacío.",shape=box,color=blue];
		j3704894359 -> j1790842530;
		j3704894359 -> j1465571377;
		j3704894359 -> j2151926276;
		j3704894359 -> j897251929;
	j319463564 [label="+5 Chemistry",color=orange];
		j319463564 -> j2763844351;
	j1034307130 [label="¿Supongo? Las partes del Vacío con las que he interactuado tienden a estar ya marcadas por nuestra naturaleza. Ya les hemos dado algún tipo de forma o figura. O hemos difuminado demasiado la línea entre las realidades.",shape=box,color=red];
		j1034307130 -> j744401611;
		j1034307130 -> j185886733;
	j4007123572 [label="Una revolución solo adquiere validez por su existencia en la mente de quienes la impulsan.",shape=box,color=blue];
		j4007123572 -> j3658774875;
	j3173036913 [label="Sí, supongo que podrías plantearlo así. ¿Debemos ignorar los fantasmas que rondan nuestros pasillos o al prestarles atención, los estamos reforzando?",shape=box,color=blue];
		j3173036913 -> j1790842530;
		j3173036913 -> j1465571377;
		j3173036913 -> j2151926276;
		j3173036913 -> j897251929;
	j1790842530 [label="Creo que los desafíos que enfrentamos ahora mismo son peligrosos. Extremadamente peligrosos. Y debemos tratarlos como tales.",shape=box,color=red];
		j1790842530 -> j4074465031;
	j1465571377 [label="Los fantasmas son lo suficientemente reales como para causarnos dolor. Pero no se les puede sanar con una bala. Al menos no con una que yo haya encontrado.",shape=box,color=red];
		j1465571377 -> j656720646;
	j2151926276 [label="¿De qué se trata todo esto en realidad, Lyon?",shape=box,color=red];
		j2151926276 -> j2029577705;
	j897251929 [label="Yo... sinceramente no lo sé, Lyon. Y ojalá lo supiera.",shape=box,color=red];
		j897251929 -> j4260821153;
	j2763844351 [label="Sí, supongo que podrías plantearlo así. ¿Cómo podemos estar seguros de que no hemos... manifestado nuestros propios demonios?",shape=box,color=blue];
		j2763844351 -> j1790842530;
		j2763844351 -> j1465571377;
		j2763844351 -> j2151926276;
		j2763844351 -> j897251929;
	j744401611 [label="Estructuras enteras, incluso la misma Lua, han sido colocadas en el Vacío y recuperadas. Por lo tanto, no consume materia simplemente por existir en su interior.",shape=box,color=red];
		j744401611 -> j231746846;
	j185886733 [label="Lo que sugieres es la existencia de un Vacío \"más profundo\" donde nada puede existir, y honestamente no puedo opinar al respecto.",shape=box,color=red];
		j185886733 -> j2250600187;
	j3658774875 [label="Si se borrara de la mente de todos los que nos rodean, dejaría de existir, ¿no es así?",shape=box,color=blue];
		j3658774875 -> j3021287362;
		j3658774875 -> j3173864690;
		j3658774875 -> j722592463;
	j4074465031 [label="Boolean LyonReal1 is now true.",color=orange];
		j4074465031 -> j1202705381;
	j656720646 [label="Boolean LyonFake1 is now true.",color=orange];
		j656720646 -> j1279732257;
	j2029577705 [label="Boolean LyonFaith1 is now true.",color=orange];
		j2029577705 -> j2274886046;
	j4260821153 [label="Tu honestidad al admitir lo que desconoces es admirable. Ojalá más personas tuvieran ese don.",shape=box,color=blue];
		j4260821153 -> j1093949558;
	j231746846 [label="No me interesa la materia que se deposita en el Vacío y luego se recupera. Me interesa lo que se ha inventado a partir del Vacío.",shape=box,color=blue];
		j231746846 -> j3173864690;
		j231746846 -> j3021287362;
		j231746846 -> j722592463;
	j2250600187 [label="Agradezco la franqueza. Supongo que me interesa menos lo que no puede existir y más lo que sí existe.",shape=box,color=blue];
		j2250600187 -> j3173864690;
		j2250600187 -> j3021287362;
		j2250600187 -> j722592463;
	j1202705381 [label="Sí, supongo que sabrás qué puede ser destruido del Vacío con fuerza y qué no se puede...",shape=box,color=blue];
		j1202705381 -> j1396222713;
	j1279732257 [label="Quizás por eso tantos recurren al exceso... para detener el sangrado de una herida, invisible pero dolorosa. Curable. Pero con la fuerza del alma, no con armas.",shape=box,color=blue];
		j1279732257 -> j1396222713;
	j2274886046 [label="Claramente, lo he hecho todo mal. Hablaremos de esto en otro momento. Disculpa mi intromisión.",shape=box,color=blue];
		j2274886046 -> j2084492712;
	j1093949558 [label="No obstante, mis ideas al respecto siguen sin estar del todo claras.",shape=box,color=blue];
		j1093949558 -> j2274886046;
	j1396222713 [label="Aunque, como siempre, me asaltan las dudas. Disculpa la intromisión. Gracias por tu tiempo, Viajero.",shape=box,color=blue];
		j1396222713 -> j2084492712;
	j2084492712 [label="Padre Lyon Allard",shape=box,color=blue];
		j2084492712 -> "Chat ends.";
}