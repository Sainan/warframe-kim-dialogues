digraph {
	114 [label="LyonRank3Convo3 begins.",color=orange];
		114 -> 115;
	115 [label="Estaba ayudando a M. Loid en su biblioteca, recolocando libros en los estantes, aunque él insistía en que esos extraños artilugios voladores... podían hacer el trabajo en su lugar...",shape=box,color=blue];
		115 -> 116;
	116 [label="Y me encontré con un curioso volumen que detalla cuentos infantiles, ambientados en un mundo ficticio escrito por una tal Euleria Entrati.",shape=box,color=blue];
		116 -> 117;
	117 [label="Al percatarme de que el autor compartía apellido con el verdadero nombre de nuestro \"Cardenal Dimanche\", inmediatamente aparté el libro para mí.",shape=box,color=blue];
		117 -> 120;
		117 -> 119;
		117 -> 118;
	120 [label="Creo saber a qué libro te refieres...",shape=box,color=red];
		120 -> 123;
	119 [label="¿Podemos saltarnos el preámbulo, por favor? Pregúntame lo que quieras saber.",shape=box,color=red];
		119 -> 122;
	118 [label="[Ignorar]",shape=box,color=red];
		118 -> 121;
	123 [label="+5 Chemistry",color=orange];
		123 -> 125;
	122 [label="Update boolean LyonMITW1",color=orange];
		122 -> 124;
	121 [label="Chat ends.",color=orange];
	125 [label="Sospecho... a juzgar por la mirada de horror que me dirigió M. Loid y su insistencia en que dejara el libro inmediatamente, \"para no molestarte\"... que sabes algo al respecto.",shape=box,color=blue];
		125 -> 128;
	124 [label="Mi pregunta está relacionada con la naturaleza de la \"Encarnación Conceptual\". Tras leerla, entendí que el libro tenía como objetivo enseñar a los niños a evitar que sus emociones interactuaran con el Vacío.",shape=box,color=blue];
		124 -> 126;
		124 -> 127;
	128 [label="\"Los cuentos de Duviri\". Si bien recibí una explicación bastante... exhaustiva y prolongada de M. Loid sobre lo que sufriste, hay un asunto en particular sobre el cual quisiera preguntar.",shape=box,color=blue];
		128 -> 131;
	126 [label="Para lo poco que sirvió. Especialmente en mi caso.",shape=box,color=red];
		126 -> 129;
	127 [label="Las emociones intensas que interactúan con el Vacío pueden causar... graves problemas.",shape=box,color=red];
		127 -> 130;
	131 [label="Si, por supuesto, ¿no es demasiado problemático hacerlo?",shape=box,color=blue];
		131 -> 134;
		131 -> 135;
	129 [label="¿Cuántas cosas de nuestra vida nos han sido presentadas por otros como hechos, solo para resultar inútiles al ser puestas a prueba?",shape=box,color=blue];
		129 -> 132;
	130 [label="Así parece. He conocido a los Cavia. Me han hablado de los Ángeles del Vacío. He visto murmullo con mis propios ojos. ",shape=box,color=blue];
		130 -> 133;
	134 [label="No. Adelante.",shape=box,color=red];
		134 -> 122;
	135 [label="Depende totalmente de los detalles, supongo. No tengo ni idea de lo que me vas a preguntar.",shape=box,color=red];
		135 -> 140;
	132 [label="Update boolean LyonFaith1",color=orange];
		132 -> 136;
	133 [label="Y esa es la naturaleza de mi curiosidad. Me lo pregunto en voz alta para ver si podrías explicarlo. Cuando el Vacío cobra forma, ¿lo que surge de él... es real?",shape=box,color=blue];
		133 -> 137;
		133 -> 138;
		133 -> 139;
	140 [label="+5 Chemistry",color=orange];
		140 -> 146;
	136 [label="A menudo me pregunto por qué llenan las cabezas de los demás con mentiras tan inútiles. ¿Acaso buscan poder? ¿Influencia? ¿O crees que realmente se creen sus propias palabras y desconocen sus propias mentiras?",shape=box,color=blue];
		136 -> 142;
		136 -> 141;
	137 [label="No, creo que todo lo creado por el Vacío es simplemente... temporal. Un fragmento de quien o lo que sea que lo creó. Un fantasma de un recuerdo.",shape=box,color=red];
		137 -> 143;
	138 [label="Sí, creo que sí. Como una pintura hecha por un artista, puede que haya surgido de la mente de alguien, pero es real una vez que está hecha.",shape=box,color=red];
		138 -> 144;
	139 [label="Eso depende enteramente de tu definición de \"real\".",shape=box,color=red];
		139 -> 145;
	146 [label="Sí, discúlpame. No soy muy hábil para... conversar de forma directa. Sobre todo de una manera tan extraña como esta. Pero intentaré hacerlo ahora.",shape=box,color=blue];
		146 -> 122;
	142 [label="En este caso, creo que Euleria Entrati pretendía que lo que escribió fuera útil. Simplemente no me sirvió cuando lo necesitaba.",shape=box,color=red];
		142 -> 148;
	141 [label="No lo sé. ¿De qué mentiras te habían llenado la cabeza, Lyon?",shape=box,color=red];
		141 -> 147;
	143 [label="¿Acaso no son los efectos causados por tales elementos del Vacío \"reales\"?",shape=box,color=blue];
		143 -> 149;
	144 [label="Pero la analogía que usas no es del todo precisa, ¿verdad? La materia recuperada del Vacío regresa al Vacío, ¿no es así?",shape=box,color=blue];
		144 -> 150;
	145 [label="+5 Chemistry",color=orange];
		145 -> 151;
	148 [label="En su defensa, mi exposición al Vacío fue mucho más prolongada de lo que ella pretendía en el libro.",shape=box,color=red];
		148 -> 153;
	147 [label="Ninguna que haya venido a discutir contigo.",shape=box,color=blue];
		147 -> 152;
	149 [label="Muchos recuerdos han llevado a un hombre al alcoholismo o lo han inspirado a quitarse la vida. ¿Acaso esos recuerdos no son \"reales\"?",shape=box,color=blue];
		149 -> 154;
	150 [label="Muy bien, una reflexión. Un poema o una canción existen aunque no estén escritos.",shape=box,color=red];
		150 -> 155;
	151 [label="¿Podrías dar más detalles?",shape=box,color=blue];
		151 -> 156;
	153 [label="+5 Chemistry",color=orange];
		153 -> 157;
	152 [label="Chat ends.",color=orange];
	154 [label="Pero esas eran fuerzas internas que el hombre dejó que actuaran sobre él, ese es mi punto. No externas.",shape=box,color=red];
		154 -> 158;
	155 [label="Pero si se olvida, deja de existir. Una historia perdida en el tiempo se pierde para siempre.",shape=box,color=blue];
		155 -> 159;
	156 [label="¿Cómo se mide la \"realidad\"?",shape=box,color=red];
		156 -> 160;
		156 -> 161;
		156 -> 162;
	157 [label="La ignorancia, por desgracia, es lo mejor que cualquiera de nosotros puede esperar que cause la maldad en otros.",shape=box,color=blue];
		157 -> 163;
	158 [label="Pero, ¿cuál es la diferencia?, me pregunto. Si el resultado final es el mismo, ¿importa?",shape=box,color=blue];
		158 -> 164;
		158 -> 165;
		158 -> 166;
	159 [label="Una revolución arrancada de las mentes de quienes la empuñan es, en verdad, una espada sin filo.",shape=box,color=blue];
		159 -> 164;
		159 -> 165;
		159 -> 166;
	160 [label="¿Por permanencia física? ¿Peso y masa? Lo que proviene del Vacío solo está aquí temporalmente.",shape=box,color=red];
		160 -> 167;
	161 [label="¿Por su efecto en los acontecimientos? Lo que surgió del Vacío ha cambiado el curso de la historia.",shape=box,color=red];
		161 -> 168;
	162 [label="¿Por su efecto en los demás? Ciertamente, la influencia de las \"cosas\" que provienen del Vacío ha tenido ese efecto.",shape=box,color=red];
		162 -> 169;
	163 [label="Sin embargo, mi curiosidad no se centra en el libro ni en su utilidad. Perdona que me ponga un poco poético.",shape=box,color=blue];
		163 -> 170;
	164 [label="No estás preguntando si son \"reales\", sino si son \"válidos\". Si deberían descartarse o no.",shape=box,color=red];
		164 -> 171;
	165 [label="También me gustaría preguntar si tus Luminarias son \"reales\" simplemente porque no puedes estrechar la mano de Sol o Lua.",shape=box,color=red];
		165 -> 172;
	166 [label="Estás preguntando, de forma indirecta, si todas las \"cosas\" del Vacío están aquí solo porque nosotros las hemos traído a la existencia.",shape=box,color=red];
		166 -> 173;
	167 [label="¿Estás diciendo que todo lo que proviene del Vacío debe regresar a él? Pero, ¿acaso el Vacío no está, por definición, compuesto de la nada?",shape=box,color=blue];
		167 -> 174;
	168 [label="Es un punto válido. ¿Acaso una revolución no es \"real\" simplemente porque no se puede meter en una cesta y pesarla?",shape=box,color=blue];
		168 -> 169;
	169 [label="Sin duda, costó la vida a muchos. Defenderían su validez con vehemencia. Sin embargo, considera lo siguiente:",shape=box,color=blue];
		169 -> 175;
	170 [label="Me lo pregunto en voz alta para ver si podrías explicarlo. Cuando el Vacío cobra forma, ¿lo que surge de él... es real?",shape=box,color=blue];
		170 -> 137;
		170 -> 139;
		170 -> 138;
	171 [label="+5 Chemistry",color=orange];
		171 -> 176;
	172 [label="No estamos hablando de Las Luminarias. Estamos hablando del Vacío.",shape=box,color=blue];
		172 -> 177;
		172 -> 178;
		172 -> 179;
		172 -> 180;
	173 [label="+5 Chemistry",color=orange];
		173 -> 181;
	174 [label="¿Supongo? Las partes del Vacío con las que he interactuado tienden a estar ya marcadas por nuestra naturaleza. Ya les hemos dado algún tipo de forma o figura. O hemos difuminado demasiado la línea entre las realidades.",shape=box,color=red];
		174 -> 182;
		174 -> 183;
	175 [label="Una revolución solo adquiere validez por su existencia en la mente de quienes la impulsan.",shape=box,color=blue];
		175 -> 184;
	176 [label="Sí, supongo que podrías plantearlo así. ¿Debemos ignorar los fantasmas que rondan nuestros pasillos o al prestarles atención, los estamos reforzando?",shape=box,color=blue];
		176 -> 177;
		176 -> 178;
		176 -> 179;
		176 -> 180;
	177 [label="Creo que los desafíos que enfrentamos ahora mismo son peligrosos. Extremadamente peligrosos. Y debemos tratarlos como tales.",shape=box,color=red];
		177 -> 185;
	178 [label="Los fantasmas son lo suficientemente reales como para causarnos dolor. Pero no se les puede sanar con una bala. Al menos no con una que yo haya encontrado.",shape=box,color=red];
		178 -> 186;
	179 [label="¿De qué se trata todo esto en realidad, Lyon?",shape=box,color=red];
		179 -> 187;
	180 [label="Yo... sinceramente no lo sé, Lyon. Y ojalá lo supiera.",shape=box,color=red];
		180 -> 188;
	181 [label="Sí, supongo que podrías plantearlo así. ¿Cómo podemos estar seguros de que no hemos... manifestado nuestros propios demonios?",shape=box,color=blue];
		181 -> 177;
		181 -> 178;
		181 -> 179;
		181 -> 180;
	182 [label="Estructuras enteras, incluso la misma Lua, han sido colocadas en el Vacío y recuperadas. Por lo tanto, no consume materia simplemente por existir en su interior.",shape=box,color=red];
		182 -> 189;
	183 [label="Lo que sugieres es la existencia de un Vacío \"más profundo\" donde nada puede existir, y honestamente no puedo opinar al respecto.",shape=box,color=red];
		183 -> 190;
	184 [label="Si se borrara de la mente de todos los que nos rodean, dejaría de existir, ¿no es así?",shape=box,color=blue];
		184 -> 165;
		184 -> 164;
		184 -> 166;
	185 [label="Update boolean LyonReal1",color=orange];
		185 -> 191;
	186 [label="Update boolean LyonFake1",color=orange];
		186 -> 192;
	187 [label="Update boolean LyonFaith1",color=orange];
		187 -> 193;
	188 [label="Tu honestidad al admitir lo que desconoces es admirable. Ojalá más personas tuvieran ese don.",shape=box,color=blue];
		188 -> 194;
	189 [label="No me interesa la materia que se deposita en el Vacío y luego se recupera. Me interesa lo que se ha inventado a partir del Vacío.",shape=box,color=blue];
		189 -> 164;
		189 -> 165;
		189 -> 166;
	190 [label="Agradezco la franqueza. Supongo que me interesa menos lo que no puede existir y más lo que sí existe.",shape=box,color=blue];
		190 -> 164;
		190 -> 165;
		190 -> 166;
	191 [label="Sí, supongo que sabrás qué puede ser destruido del Vacío con fuerza y qué no se puede...",shape=box,color=blue];
		191 -> 195;
	192 [label="Quizás por eso tantos recurren al exceso... para detener el sangrado de una herida, invisible pero dolorosa. Curable. Pero con la fuerza del alma, no con armas.",shape=box,color=blue];
		192 -> 195;
	193 [label="Claramente, lo he hecho todo mal. Hablaremos de esto en otro momento. Disculpa mi intromisión.",shape=box,color=blue];
		193 -> 196;
	194 [label="No obstante, mis ideas al respecto siguen sin estar del todo claras.",shape=box,color=blue];
		194 -> 193;
	195 [label="Aunque, como siempre, me asaltan las dudas. Disculpa la intromisión. Gracias por tu tiempo, Viajero.",shape=box,color=blue];
		195 -> 196;
	196 [label="-F. Lyon Allard",shape=box,color=blue];
		196 -> 197;
	197 [label="Chat ends.",color=orange];
}