digraph {
	568 [label="LyonRank3Convo6 begins.",color=orange];
		568 -> 570;
		568 -> 569;
	570 [label="¿Cuánto tiempo estuvo Entrati contigo en la catedral antes de que llegara Roathe?",shape=box,color=red];
		570 -> 572;
	569 [label="[Fin.]",shape=box,color=red];
		569 -> 571;
	572 [label="¿Por qué me haces esta pregunta?",shape=box,color=blue];
		572 -> 573;
	571 [label="Chat ends.",color=orange];
	573 [label="Evaluate expressions",color=orange];
		573 -> 577 [label="MarieLyonVisions",color=purple];
		573 -> 574 [label="MarieLyonVisions",color=purple];
		573 -> 575 [label="MarieLyonVisions",color=purple];
		573 -> 576 [label="MarieLyonVisions",color=purple];
		573 -> 574 [label="LyonVisions1",color=purple];
		573 -> 575 [label="LyonVisions1",color=purple];
		573 -> 576 [label="LyonVisions1",color=purple];
		573 -> 577 [label="LyonVisions1",color=purple];
		573 -> 574 [label="false",color=purple];
		573 -> 575 [label="false",color=purple];
	577 [label="Me han advertido que quizá no veas las cosas como nosotros. Pero no me preocupa. Me interesa lo que sabes.",shape=box,color=red];
		577 -> 581;
	574 [label="Marie parece obsesionada con \"le Cardinal\". Y Roathe claramente lo odia. Busco una persona neutral. Eres lo más parecido que he podido encontrar.",shape=box,color=red];
		574 -> 578;
	575 [label="Yo... ¿no sé qué más preguntarte?",shape=box,color=red];
		575 -> 579;
	576 [label="Me han advertido que quizá no veas las cosas como nosotros. Pero creo que podrías ver la verdad donde otros no la ven.",shape=box,color=red];
		576 -> 580;
	581 [label="Mmm. ¿No te molesta mancharte con locos y lunáticos? Qué curioso. Aunque pareces relacionarte con animales parlantes y... criaturas de otro tiempo. Supongo que no soy ni más ni menos extravagante que el resto de tu colección.",shape=box,color=blue];
		581 -> 582;
	578 [label="Qué escasez de opciones sensatas te has encontrado, cuando un loco y un lunático es tu única fuente de opinión \"neutral\". No entiendo por qué te molestas en hablar conmigo.",shape=box,color=blue];
		578 -> 582;
	579 [label="¿Por qué insistes en hablar conmigo? No lo necesitas, ¿te has dado cuenta?. Si deseas hacerte amigo de Marie, o incluso cortejarla, hazlo, no soy su guardián ni su padre. Y sean cuales sean tus intenciones con ese bastardo de Roathe, me importa poco más allá de las respuestas que me debe.",shape=box,color=blue];
		579 -> 582;
	580 [label="\"Verdad.\" Ojalá entendieras lo ridículo que me ha resultado últimamente. ¿No te molesta ensuciarte con locos y lunáticos? Curioso. Aunque pareces relacionarte con animales parlantes y... criaturas de otro tiempo. Supongo que no soy ni más ni menos extravagante que el resto de tu colección.",shape=box,color=blue];
		580 -> 582;
	582 [label="Evaluate expressions",color=orange];
		582 -> 585 [label="LyonFirstFlirt",color=purple];
		582 -> 585 [label="DrifterLyon",color=purple];
		582 -> 584 [label="LyonOffer",color=purple];
		582 -> 583 [label="false",color=purple];
	585 [label="Y, por favor, ahórranos otro penoso... momento, ¿quieres? Sé que lo que has dicho son tus razones para hablarme. Y aunque me parecen halagadoras, también las encuentro ridículamente falsas.",shape=box,color=blue];
		585 -> 586;
		585 -> 587;
		585 -> 588;
	584 [label="Y, por favor, ahórranos otro sermón sobre cómo quieres \"ayudarme\", ¿quieres? Estoy seguro de que quieres ser amable, pero me molesta tu ridícula falta de sinceridad.",shape=box,color=blue];
		584 -> 586;
		584 -> 587;
		584 -> 588;
	583 [label="Y, por favor, ahórranos el sermón sobre cómo quieres \"ayudarme\" o \"ser mi amigo\". Estoy seguro de que quieres ser amable, pero me molesta tu ridícula falta de sinceridad.",shape=box,color=blue];
		583 -> 586;
		583 -> 587;
		583 -> 588;
	586 [label="¿Falsas porque crees que no lo digo en serio, o falsas porque tú crees que no lo digo en serio?",shape=box,color=red];
		586 -> 589;
	587 [label="Sacerdote, solo quería saber por cuánto tiempo Entrati se hizo pasar por un cardenal. Eso es todo.",shape=box,color=red];
		587 -> 590;
	588 [label="¿Qué quieres decir con \"falsas\"? ¿Me estás llamando mentiroso?",shape=box,color=red];
		588 -> 591;
	589 [label="Ninguno. Tus palabras son una caridad que no necesito ni quiero.",shape=box,color=blue];
		589 -> 592;
		589 -> 593;
	590 [label="Así es. Durante tres años, dos meses y once días, sirvió como el Cardinal Dimanche en nuestra catedral. Y durante todo ese tiempo, Marie y yo le servimos sin saber lo que planeaba para nosotros.",shape=box,color=blue];
		590 -> 594;
	591 [label="Evaluate expressions",color=orange];
		591 -> 597 [label="DrifterLiar",color=purple];
		591 -> 596 [label="LyonSuspicious",color=purple];
		591 -> 595 [label="false",color=purple];
	592 [label="¿Cómo soporta Marie esto...?",shape=box,color=red];
		592 -> 598;
	593 [label="¿Crees que cualquiera que elija socializar contigo está realizando un acto de caridad?",shape=box,color=red];
		593 -> 599;
	594 [label="Conozco tus preguntas antes de que las hagas. ¿Qué tramaba? ¿Infectó la ciudad, como dicen que hizo con Höllvania? ¿Cuáles eran sus planes? ¿Sus descubrimientos?",shape=box,color=blue];
		594 -> 600;
	597 [label="¿Tienes algo que quieras confesar, Viajero? ¿Hay alguna penitencia que quieras pagar?",shape=box,color=blue];
		597 -> 601;
	596 [label="Mmm. No. Todavía no, quizás.",shape=box,color=blue];
		596 -> 595;
	595 [label="Tu falsedad no es una mentira. Es caridad. Caridad que no necesito ni quiero. ",shape=box,color=blue];
		595 -> 592;
		595 -> 593;
	598 [label="Lo mejor es que se lo preguntes tú mismo. Yo me lo he preguntado muchas veces.",shape=box,color=blue];
		598 -> 602;
	599 [label="¿Siendo sincero? Sí.",shape=box,color=blue];
		599 -> 603;
	600 [label="A esas te diré que te decepcionarás. ¿Por esos tres años, dos meses y once días? Él predicó. Estudió. Descansó. Y rezó.",shape=box,color=blue];
		600 -> 604;
		600 -> 605;
		600 -> 606;
	601 [label="No viene al caso. No viniste a esta conversación buscando el perdón, ni tus mentiras pasadas son las mismas que tus falsedades actuales.",shape=box,color=blue];
		601 -> 607;
	602 [label="Chat ends.",color=orange];
	603 [label="Update boolean LyonHate1",color=orange];
		603 -> 608;
		603 -> 609;
		603 -> 610;
	604 [label="¿Cuándo los convirtió en protoframes?",shape=box,color=red];
		604 -> 611;
	605 [label="Me resulta muy difícil imaginar a Entrati rezando.",shape=box,color=red];
		605 -> 612;
	606 [label="Entonces él estaba... ¡¿de sabático?!",shape=box,color=red];
		606 -> 613;
	607 [label="Lo que dices ahora es mera caridad. La caridad que no necesito ni quiero.",shape=box,color=blue];
		607 -> 592;
		607 -> 593;
	608 [label="Algo para profundizar otro día. Puedo sentir que esta conversación se está saliendo de control.",shape=box,color=red];
		608 -> 614;
	609 [label="¿Y qué hay de Marie...?",shape=box,color=red];
		609 -> 615;
	610 [label="Debes pensar muy mal de ti mismo.",shape=box,color=red];
		610 -> 616;
	611 [label="Después de esos tres años y algunos días, desapareció en medio de una terrible tormenta. La misma en la que apareció.",shape=box,color=blue];
		611 -> 617;
	612 [label="Es imposible conocer el funcionamiento interno de la mente ajena. Se arrodilló ante el altar con la cabeza inclinada. ¿Estaba rezando? ¿O simplemente estaba absorto en sus pensamientos? No lo sé.",shape=box,color=blue];
		612 -> 611;
	613 [label="+5 Chemistry",color=orange];
		613 -> 618;
	614 [label="+5 Chemistry",color=orange];
		614 -> 619;
	615 [label="Marie acunaría a un oso rabioso en su regazo y dejaría que le desgarrara la garganta si pensara que eso le daría al animal un momento de paz.",shape=box,color=blue];
		615 -> 620;
	616 [label="Yo lo consideraría una dedicación firme al pragmatismo, pero defínelo como quieras.",shape=box,color=blue];
		616 -> 621;
	617 [label="Evaluate expressions",color=orange];
		617 -> 622 [label="MarieLyonVisions",color=purple];
		617 -> 622 [label="LyonVisions1",color=purple];
		617 -> 623 [label="false",color=purple];
	618 [label="Je. No lo había pensado así, pero sí, quizá lo estaba. Qué indignante para todos ustedes. Parece encajar con lo poco que sabemos de él.",shape=box,color=blue];
		618 -> 611;
	619 [label="Esa probablemente sea una buena decisión. Preguntaste sobre el \"Cardenal Dimanche\" y su gestión en la catedral.",shape=box,color=blue];
		619 -> 624;
	620 [label="Ella es un alma singularmente hermosa, una que protegeré hasta mi último aliento.",shape=box,color=blue];
		620 -> 621;
	621 [label="+5 Chemistry",color=orange];
		621 -> 625;
	622 [label="Aunque soy muy consciente de que a los demás no vieron la tormenta, a mí me pareció muy vívido.",shape=box,color=blue];
		622 -> 623;
	623 [label="Un año después, reapareció una última vez, con... Roathe, tal como lo ves ahora, desplomado e inconsciente a sus pies.",shape=box,color=blue];
		623 -> 626;
	624 [label="Durante tres años, dos meses y once días, sirvió como Cardenal Dimanche en nuestra catedral. Y durante todo ese tiempo, Marie y yo le servimos sin saber lo que planeaba para nosotros.",shape=box,color=blue];
		624 -> 594;
	625 [label="Pero esto es lo que debes esperar, hacerle una pregunta simple a un loco suele ser un camino errático. Permíteme redirigirnos a tu tema original y alejarnos del mío.",shape=box,color=blue];
		625 -> 624;
	626 [label="Un demonio en carne y hueso, o eso parecía. Fue entonces cuando Entrati nos reveló la verdad sobre quién era, de donde venía y la verdadera tarea que tenía para nosotros.",shape=box,color=blue];
		626 -> 627;
	627 [label="Que nos había elegido a ambos para una \"misión sumamente sagrada\".",shape=box,color=blue];
		627 -> 628;
		627 -> 629;
	628 [label="¿Por qué las comillas?",shape=box,color=red];
		628 -> 630;
	629 [label="Suena a que no le crees.",shape=box,color=red];
		629 -> 630;
	630 [label="He aprendido tanto que me hace cuestionarme la adición de Entrati a cualquier cosa sacrosanta, a cualquier tipo de naturaleza o dios de cualquier tipo... si es que tal cosa existe...",shape=box,color=blue];
		630 -> 631;
		630 -> 632;
	631 [label="¿Si tal cosa existe? ¿a qué te refieres, Lyon?",shape=box,color=red];
		631 -> 633;
	632 [label="Continúa.",shape=box,color=red];
		632 -> 634;
	633 [label="Update boolean LyonFaith2",color=orange];
		633 -> 635;
	634 [label="Marie aceptó el suero de buena gana. Claro que sí. ¿Cómo no iba a hacerlo? ¿Y cómo no iba yo a seguirla? ¿Cómo no iba a buscar la verdad, adondequiera que me llevara?",shape=box,color=blue];
		634 -> 636;
	635 [label="Un asunto para otra ocasión, por favor.",shape=box,color=blue];
		635 -> 634;
	636 [label="Update boolean LyonSerum1",color=orange];
		636 -> 637;
		636 -> 638;
		636 -> 639;
	637 [label="Creo que ella todavía adora demasiado a Entrati.",shape=box,color=red];
		637 -> 640;
	638 [label="¿Qué pasó después?",shape=box,color=red];
		638 -> 641;
	639 [label="¿Te arrepientes?",shape=box,color=red];
		639 -> 642;
	640 [label="Update boolean LyonMarieEntrati",color=orange];
		640 -> 643;
	641 [label="Roathe despertó. Al principio, apenas recordaba su nombre. Entrati le dijo una frase de despedida al bastardo: \"Uriel, Hereje de Xata, en destierro, responde: ¿podrán los orokin ser perdonados alguna vez?\".",shape=box,color=blue];
		641 -> 644;
	642 [label="Me arrepiento de todo, Viajero. Sí, claro que sí. ¿Pero lo volvería a hacer? Sí, claro que sí. No puedo dejar sola a Marie.",shape=box,color=blue];
		642 -> 645;
	643 [label="En esto estamos de acuerdo. Pero tampoco puedo culparla por ello. Dale tiempo. Lo entenderá. Es muy inteligente, Viajero. No la trates como una tonta.",shape=box,color=blue];
		643 -> 645;
	644 [label="Entrati partió entonces por última vez. Y abandonó a Roathe con nosotros, ahora transformado en lo que ven ahora, más capaz de enfrentarse al temperamental diablo.",shape=box,color=blue];
		644 -> 646;
	645 [label="Para terminar el relato... Entrati partió entonces por última vez. Y abandonó a Roathe con nosotros, ahora transformado en lo que ven ahora, más capaz de enfrentarse al temperamental diablo.",shape=box,color=blue];
		645 -> 646;
	646 [label="El resto, me temo, es una historia que tendrá que esperar. El Sr. Loid necesita usar el POM-2 y estoy ansioso por cedérselo. Espero que esto haya ayudado a responder al menos algunas de tus preguntas.",shape=box,color=blue];
		646 -> 647;
		646 -> 648;
	647 [label="Y recaudó el doble de preguntas nuevas.",shape=box,color=red];
		647 -> 649;
	648 [label="Así es, gracias.",shape=box,color=red];
		648 -> 650;
	649 [label="+15 Chemistry",color=orange];
		649 -> 651;
	650 [label="+10 Chemistry",color=orange];
		650 -> 652;
	651 [label="Entonces he cumplido con mi deber como sacerdote. Te deseo buenas noches.",shape=box,color=blue];
		651 -> 653;
	652 [label="Entonces te desearé buenas noches.",shape=box,color=blue];
		652 -> 653;
	653 [label="-F. Lyon Allard",shape=box,color=blue];
		653 -> 654;
	654 [label="Chat ends.",color=orange];
}