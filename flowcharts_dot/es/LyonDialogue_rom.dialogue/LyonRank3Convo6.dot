		j4196769031 -> j3925136146 [label="false",color=purple];
		j4196769031 -> j2685339120 [label="false",color=purple];
	j278459094 [label="Me han advertido que quizá no veas las cosas como nosotros. Pero no me preocupa. Me interesa lo que sabes.",shape=box,color=red];
		j278459094 -> j741685435;
	j3925136146 [label="Marie parece obsesionada con \"le Cardinal\". Y Roathe claramente lo odia. Busco una persona neutral. Eres lo más parecido que he podido encontrar.",shape=box,color=red];
		j3925136146 -> j409565673;
	j2685339120 [label="Yo... ¿no sé qué más preguntarte?",shape=box,color=red];
		j2685339120 -> j3587561401;
	j542564485 [label="Me han advertido que quizá no veas las cosas como nosotros. Pero creo que podrías ver la verdad donde otros no la ven.",shape=box,color=red];
		j542564485 -> j3542915041;
	j741685435 [label="Mmm. ¿No te molesta mancharte con locos y lunáticos? Qué curioso. Aunque pareces relacionarte con animales parlantes y... criaturas de otro tiempo. Supongo que no soy ni más ni menos extravagante que el resto de tu colección.",shape=box,color=blue];
		j741685435 -> j2845885253;
	j409565673 [label="Qué escasez de opciones sensatas te has encontrado, cuando un loco y un lunático es tu única fuente de opinión \"neutral\". No entiendo por qué te molestas en hablar conmigo.",shape=box,color=blue];
		j409565673 -> j2845885253;
	j3587561401 [label="¿Por qué insistes en hablar conmigo? No lo necesitas, ¿te has dado cuenta?. Si deseas hacerte amigo de Marie, o incluso cortejarla, hazlo, no soy su guardián ni su padre. Y sean cuales sean tus intenciones con ese bastardo de Roathe, me importa poco más allá de las respuestas que me debe.",shape=box,color=blue];
		j3587561401 -> j2845885253;
	j3542915041 [label="\"Verdad.\" Ojalá entendieras lo ridículo que me ha resultado últimamente. ¿No te molesta ensuciarte con locos y lunáticos? Curioso. Aunque pareces relacionarte con animales parlantes y... criaturas de otro tiempo. Supongo que no soy ni más ni menos extravagante que el resto de tu colección.",shape=box,color=blue];
		j3542915041 -> j2845885253;
	j2845885253 [label="Evaluate expressions",color=orange];
		j2845885253 -> j2603948552 [label="LyonFirstFlirt",color=purple];
		j2845885253 -> j2603948552 [label="DrifterLyon",color=purple];
		j2845885253 -> j2212168197 [label="LyonOffer",color=purple];
		j2845885253 -> j3431956566 [label="false",color=purple];
	j2603948552 [label="Y, por favor, ahórranos otro penoso... momento, ¿quieres? Sé que lo que has dicho son tus razones para hablarme. Y aunque me parecen halagadoras, también las encuentro ridículamente falsas.",shape=box,color=blue];
		j2603948552 -> j253585785;
		j2603948552 -> j193769197;
		j2603948552 -> j2782385997;
	j2212168197 [label="Y, por favor, ahórranos otro sermón sobre cómo quieres \"ayudarme\", ¿quieres? Estoy seguro de que quieres ser amable, pero me molesta tu ridícula falta de sinceridad.",shape=box,color=blue];
		j2212168197 -> j253585785;
		j2212168197 -> j193769197;
		j2212168197 -> j2782385997;
	j3431956566 [label="Y, por favor, ahórranos el sermón sobre cómo quieres \"ayudarme\" o \"ser mi amigo\". Estoy seguro de que quieres ser amable, pero me molesta tu ridícula falta de sinceridad.",shape=box,color=blue];
		j3431956566 -> j253585785;
		j3431956566 -> j193769197;
		j3431956566 -> j2782385997;
	j253585785 [label="¿Falsas porque crees que no lo digo en serio, o falsas porque tú crees que no lo digo en serio?",shape=box,color=red];
		j253585785 -> j4006512234;
	j193769197 [label="Sacerdote, solo quería saber por cuánto tiempo Entrati se hizo pasar por un cardenal. Eso es todo.",shape=box,color=red];
		j193769197 -> j1523506051;
	j2782385997 [label="¿Qué quieres decir con \"falsas\"? ¿Me estás llamando mentiroso?",shape=box,color=red];
		j2782385997 -> j5625625;
	j4006512234 [label="Ninguno. Tus palabras son una caridad que no necesito ni quiero.",shape=box,color=blue];
		j4006512234 -> j31810357;
		j4006512234 -> j888508306;
	j1523506051 [label="Así es. Durante tres años, dos meses y once días, sirvió como el Cardinal Dimanche en nuestra catedral. Y durante todo ese tiempo, Marie y yo le servimos sin saber lo que planeaba para nosotros.",shape=box,color=blue];
		j1523506051 -> j3386171897;
	j5625625 [label="Evaluate expressions",color=orange];
		j5625625 -> j887582782 [label="DrifterLiar",color=purple];
		j5625625 -> j3389253052 [label="LyonSuspicious",color=purple];
		j5625625 -> j1782958136 [label="false",color=purple];
	j31810357 [label="¿Cómo soporta Marie esto...?",shape=box,color=red];
		j31810357 -> j4824384;
	j888508306 [label="¿Crees que cualquiera que elija socializar contigo está realizando un acto de caridad?",shape=box,color=red];
		j888508306 -> j680898647;
	j3386171897 [label="Conozco tus preguntas antes de que las hagas. ¿Qué tramaba? ¿Infectó la ciudad, como dicen que hizo con Höllvania? ¿Cuáles eran sus planes? ¿Sus descubrimientos?",shape=box,color=blue];
		j3386171897 -> j938528149;
	j887582782 [label="¿Tienes algo que quieras confesar, Viajero? ¿Hay alguna penitencia que quieras pagar?",shape=box,color=blue];
		j887582782 -> j2565378503;
	j3389253052 [label="Mmm. No. Todavía no, quizás.",shape=box,color=blue];
		j3389253052 -> j1782958136;
	j1782958136 [label="Tu falsedad no es una mentira. Es caridad. Caridad que no necesito ni quiero. ",shape=box,color=blue];
		j1782958136 -> j31810357;
		j1782958136 -> j888508306;
	j4824384 [label="Lo mejor es que se lo preguntes tú mismo. Yo me lo he preguntado muchas veces.",shape=box,color=blue];
		j4824384 -> "Chat ends.";
	j680898647 [label="¿Siendo sincero? Sí.",shape=box,color=blue];
		j680898647 -> j3994772085;
	j938528149 [label="A esas te diré que te decepcionarás. ¿Por esos tres años, dos meses y once días? Él predicó. Estudió. Descansó. Y rezó.",shape=box,color=blue];
		j938528149 -> j23723265;
		j938528149 -> j4254968865;
		j938528149 -> j4010551378;
	j2565378503 [label="No viene al caso. No viniste a esta conversación buscando el perdón, ni tus mentiras pasadas son las mismas que tus falsedades actuales.",shape=box,color=blue];
		j2565378503 -> j3307582379;
	j3994772085 [label="Boolean LyonHate1 is now true.",color=orange];
		j3994772085 -> j2613816741;
		j3994772085 -> j1152401838;
		j3994772085 -> j2750340078;
	j23723265 [label="¿Cuándo los convirtió en protoframes?",shape=box,color=red];
		j23723265 -> j3643113567;
	j4254968865 [label="Me resulta muy difícil imaginar a Entrati rezando.",shape=box,color=red];
		j4254968865 -> j62889071;
	j4010551378 [label="Entonces él estaba... ¡¿de sabático?!",shape=box,color=red];
		j4010551378 -> j3468800371;
	j3307582379 [label="Lo que dices ahora es mera caridad. La caridad que no necesito ni quiero.",shape=box,color=blue];
		j3307582379 -> j31810357;
		j3307582379 -> j888508306;
	j2613816741 [label="Algo para profundizar otro día. Puedo sentir que esta conversación se está saliendo de control.",shape=box,color=red];
		j2613816741 -> j655570472;
	j1152401838 [label="¿Y qué hay de Marie...?",shape=box,color=red];
		j1152401838 -> j3462416468;
	j2750340078 [label="Debes pensar muy mal de ti mismo.",shape=box,color=red];
		j2750340078 -> j2945028798;
	j3643113567 [label="Después de esos tres años y algunos días, desapareció en medio de una terrible tormenta. La misma en la que apareció.",shape=box,color=blue];
		j3643113567 -> j3307858394;
	j62889071 [label="Es imposible conocer el funcionamiento interno de la mente ajena. Se arrodilló ante el altar con la cabeza inclinada. ¿Estaba rezando? ¿O simplemente estaba absorto en sus pensamientos? No lo sé.",shape=box,color=blue];
		j62889071 -> j3643113567;
	j3468800371 [label="+5 Chemistry",color=orange];
		j3468800371 -> j200668505;
	j655570472 [label="+5 Chemistry",color=orange];
		j655570472 -> j3884123778;
	j3462416468 [label="Marie acunaría a un oso rabioso en su regazo y dejaría que le desgarrara la garganta si pensara que eso le daría al animal un momento de paz.",shape=box,color=blue];
		j3462416468 -> j177855555;
	j2945028798 [label="Yo lo consideraría una dedicación firme al pragmatismo, pero defínelo como quieras.",shape=box,color=blue];
		j2945028798 -> j3691723472;
	j3307858394 [label="Evaluate expressions",color=orange];
		j3307858394 -> j1598791082 [label="MarieLyonVisions",color=purple];
		j3307858394 -> j1598791082 [label="LyonVisions1",color=purple];
		j3307858394 -> j2352999082 [label="false",color=purple];
	j200668505 [label="Je. No lo había pensado así, pero sí, quizá lo estaba. Qué indignante para todos ustedes. Parece encajar con lo poco que sabemos de él.",shape=box,color=blue];
		j200668505 -> j3643113567;
	j3884123778 [label="Esa probablemente sea una buena decisión. Preguntaste sobre el \"Cardenal Dimanche\" y su gestión en la catedral.",shape=box,color=blue];
		j3884123778 -> j525175706;
	j177855555 [label="Ella es un alma singularmente hermosa, una que protegeré hasta mi último aliento.",shape=box,color=blue];
		j177855555 -> j3691723472;
	j3691723472 [label="+5 Chemistry",color=orange];
		j3691723472 -> j1089207276;
	j1598791082 [label="Aunque soy muy consciente de que los demás no vieron la tormenta, a mí me pareció muy vívida.",shape=box,color=blue];
		j1598791082 -> j2352999082;
	j2352999082 [label="Un año después, reapareció una última vez, con... Roathe, tal como lo ves ahora, desplomado e inconsciente a sus pies.",shape=box,color=blue];
		j2352999082 -> j1291876236;
	j525175706 [label="Durante tres años, dos meses y once días, sirvió como Cardenal Dimanche en nuestra catedral. Y durante todo ese tiempo, Marie y yo le servimos sin saber lo que planeaba para nosotros.",shape=box,color=blue];
		j525175706 -> j3386171897;
	j1089207276 [label="Pero esto es lo que debes esperar, hacerle una pregunta simple a un loco suele ser un camino errático. Permíteme redirigirnos a tu tema original y alejarnos del mío.",shape=box,color=blue];
		j1089207276 -> j525175706;
	j1291876236 [label="Un demonio en carne y hueso, o eso parecía. Fue entonces cuando Entrati nos reveló la verdad sobre quién era, de donde venía y la verdadera tarea que tenía para nosotros.",shape=box,color=blue];
		j1291876236 -> j824535865;
	j824535865 [label="Que nos había elegido a ambos para una \"misión sumamente sagrada\".",shape=box,color=blue];
		j824535865 -> j2492168762;
		j824535865 -> j782969578;
	j2492168762 [label="¿Por qué las comillas?",shape=box,color=red];
		j2492168762 -> j2925655918;
	j782969578 [label="Suena a que no le crees.",shape=box,color=red];
		j782969578 -> j2925655918;
	j2925655918 [label="He aprendido tanto que me hace cuestionarme la adición de Entrati a cualquier cosa sacrosanta, a cualquier tipo de naturaleza o dios de cualquier tipo... si es que tal cosa existe...",shape=box,color=blue];
		j2925655918 -> j2525728775;
		j2925655918 -> j1767140204;
	j2525728775 [label="¿Si tal cosa existe? ¿a qué te refieres, Lyon?",shape=box,color=red];
		j2525728775 -> j1715061108;
	j1767140204 [label="Continúa.",shape=box,color=red];
		j1767140204 -> j1259576713;
	j1715061108 [label="Boolean LyonFaith2 is now true.",color=orange];
		j1715061108 -> j381174012;
	j1259576713 [label="Marie aceptó el suero de buena gana. Claro que sí. ¿Cómo no iba a hacerlo? ¿Y cómo no iba yo a seguirla? ¿Cómo no iba a buscar la verdad, adondequiera que me llevara?",shape=box,color=blue];
		j1259576713 -> j1813802388;
	j381174012 [label="Un asunto para otra ocasión, por favor.",shape=box,color=blue];
		j381174012 -> j1259576713;
	j1813802388 [label="Boolean LyonSerum1 is now true.",color=orange];
		j1813802388 -> j939891658;
		j1813802388 -> j1443334049;
		j1813802388 -> j3320648068;
	j939891658 [label="Creo que ella todavía adora demasiado a Entrati.",shape=box,color=red];
		j939891658 -> j917609611;
	j1443334049 [label="¿Qué pasó después?",shape=box,color=red];
		j1443334049 -> j1111467773;
	j3320648068 [label="¿Te arrepientes?",shape=box,color=red];
		j3320648068 -> j212338168;
	j917609611 [label="Boolean LyonMarieEntrati is now true.",color=orange];
		j917609611 -> j3061887043;
	j1111467773 [label="Roathe despertó. Al principio, apenas recordaba su nombre. Entrati le dijo una frase de despedida al bastardo: \"Uriel, Hereje de Xata, en destierro, responde: ¿podrán los orokin ser perdonados alguna vez?\".",shape=box,color=blue];
		j1111467773 -> j2545346118;
	j212338168 [label="Me arrepiento de todo, Viajero. Sí, claro que sí. ¿Pero lo volvería a hacer? Sí, claro que sí. No puedo dejar sola a Marie.",shape=box,color=blue];
		j212338168 -> j403079327;
	j3061887043 [label="En esto estamos de acuerdo. Pero tampoco puedo culparla por ello. Dale tiempo. Lo entenderá. Es muy inteligente, Viajero. No la trates como una tonta.",shape=box,color=blue];
		j3061887043 -> j403079327;
	j2545346118 [label="Entrati partió entonces por última vez. Y abandonó a Roathe con nosotros, ahora transformado en lo que ven ahora, más capaz de enfrentarse al temperamental diablo.",shape=box,color=blue];
		j2545346118 -> j1803392880;
	j403079327 [label="Para terminar el relato... Entrati partió entonces por última vez. Y abandonó a Roathe con nosotros, ahora transformado en lo que ven ahora, más capaz de enfrentarse al temperamental diablo.",shape=box,color=blue];
		j403079327 -> j1803392880;
	j1803392880 [label="El resto, me temo, es una historia que tendrá que esperar. El Sr. Loid necesita usar el POM-2 y estoy ansioso por cedérselo. Espero que esto haya ayudado a responder al menos algunas de tus preguntas.",shape=box,color=blue];
		j1803392880 -> j2952941346;
		j1803392880 -> j2270864236;
	j2952941346 [label="Y recaudó el doble de preguntas nuevas.",shape=box,color=red];
		j2952941346 -> j381660910;
	j2270864236 [label="Así es, gracias.",shape=box,color=red];
		j2270864236 -> j3719411259;
	j381660910 [label="+15 Chemistry",color=orange];
		j381660910 -> j2440806302;
	j3719411259 [label="+10 Chemistry",color=orange];
		j3719411259 -> j615737244;
	j2440806302 [label="Entonces he cumplido con mi deber como sacerdote. Te deseo buenas noches.",shape=box,color=blue];
		j2440806302 -> j2084492712;
	j615737244 [label="Entonces te desearé buenas noches.",shape=box,color=blue];
		j615737244 -> j2084492712;
	j2084492712 [label="Padre Lyon Allard",shape=box,color=blue];
		j2084492712 -> "Chat ends.";
}