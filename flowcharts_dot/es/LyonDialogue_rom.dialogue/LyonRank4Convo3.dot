		"LyonRank4Convo3 begins." -> j2128812849;
		"LyonRank4Convo3 begins." -> j202800200;
	j2982788940 [label="¿Cómo te llevas con los Cavia?",shape=box,color=red];
		j2982788940 -> j3386459886;
	j2128812849 [label="¿Qué opinas de Loid?",shape=box,color=red];
		j2128812849 -> j3433890693;
	j202800200 [label="[Fin]",shape=box,color=red];
		j202800200 -> "Chat ends.";
	j3386459886 [label="Disfruto mucho escuchando sus bromas, aunque, como puedes imaginar, yo no participo. Tengo poco que añadir a su discurso.",shape=box,color=blue];
		j3386459886 -> j3673855466;
	j3433890693 [label="Lo encuentro muy agradable. De hecho, de mis nuevos compañeros, es con él con quien más disfruto pasar el tiempo.",shape=box,color=blue];
		j3433890693 -> j3181501107;
	"Chat ends." [color=orange];
	j3673855466 [label="Sin embargo, me preocupa ver a Roathe conversando largamente con Bird 3. No sé qué pretende con eso.",shape=box,color=blue];
		j3673855466 -> j2507757158;
	j3181501107 [label="Aunque supongo que eso no le sorprende a nadie. A primera vista, tenemos un carácter muy similar.",shape=box,color=blue];
		j3181501107 -> j3635160276;
	j2507757158 [label="Boolean LyonRoatheCavia1 is now true.",color=orange];
		j2507757158 -> j3242927416;
		j2507757158 -> j1121428855;
	j3635160276 [label="Es el joven Operador el que me parece más extraño... y a la que llaman Lotus. Y cómo nos mantienen a distancia de ellos.",shape=box,color=blue];
		j3635160276 -> j467668502;
	j3242927416 [label="Mmm. Le preguntaré sobre eso.",shape=box,color=red];
		j3242927416 -> j1051911101;
	j1121428855 [label="¿Por qué crees que busca algo?",shape=box,color=red];
		j1121428855 -> j439108976;
	j467668502 [label="Se nos permite interactuar, claro. Pero no así. No aquí. ¿Por qué?",shape=box,color=blue];
		j467668502 -> j4148164264;
		j467668502 -> j2264102703;
	j1051911101 [label="Quizás sea prudente. Odiaría verlo manipular a esas criaturas para que sean más útiles de lo que ya son.",shape=box,color=blue];
		j1051911101 -> j3635160276;
	j439108976 [label="Roathe siempre tiene un motivo en mente cuando conversa con alguien. Odiaría verlo manipular a esas criaturas para que sean más útiles de lo que ya lo son.",shape=box,color=blue];
		j439108976 -> j1613825659;
	j4148164264 [label="La criatura... está pasando por sus propios problemas. No podemos pedirle más. No está bien.",shape=box,color=red];
		j4148164264 -> j3466398414;
	j2264102703 [label="Yo... ¿supongo que es porque tengo \"experiencia previa\" con los protoframes?",shape=box,color=red];
		j2264102703 -> j3260070664;
	j1613825659 [label="Quizás valga la pena investigarlo, si tienes tiempo. Aunque eso es totalmente tu decisión.",shape=box,color=blue];
		j1613825659 -> j3635160276;
	j3466398414 [label="Sí. He oído rumores de lo que se han visto obligados a soportar. Historias de guerra y... amistades rotas, destrozadas.",shape=box,color=blue];
		j3466398414 -> j3154599326;
	j3260070664 [label="Check boolean IsDating",color=orange];
		j3260070664 -> j1246500700 [label=true,color=green];
		j3260070664 -> j2287806855 [label=false,color=brown];
	j3154599326 [label="Me rompe el corazón lo que se destruye en la guerra. Y aún me resulta más extraño lo que puede crearse con ella.",shape=box,color=blue];
		j3154599326 -> j2287806855;
	j1246500700 [label="Mmm. ¿Así lo llaman ahora? ¿\"Experiencia previa\"? ¡Qué buen gusto! Aunque Entrati parece haber complicado todo, me alegra que hayas... encontrado una forma de entretenerte.",shape=box,color=blue];
		j1246500700 -> j4097390601;
		j1246500700 -> j1802894754;
		j1246500700 -> j3804794196;
	j2287806855 [label="M. Loid me ha contado tu \"desventura\" en la Höllvania de tu pasado, nuestro futuro. Entrati ciertamente ha causado un gran lío.",shape=box,color=blue];
		j2287806855 -> j2201991784;
		j2287806855 -> j3779578037;
	j4097390601 [label="¿Hice algo mal aquí?",shape=box,color=red];
		j4097390601 -> j3487893497;
	j1802894754 [label="Ten cuidado, o si no, podría pensar que te estás preguntando si el pasto es un poco más verde al otro lado de la valla, sacerdote.",shape=box,color=red];
		j1802894754 -> j619519124;
	j3804794196 [label="Lo haces sonar como si fuera solo una aventura, Lyon. Por favor, no me insultes así.",shape=box,color=red];
		j3804794196 -> j1331458418;
	j2201991784 [label="Podría haber ido mucho peor, créeme.",shape=box,color=red];
		j2201991784 -> j2251965788;
	j3779578037 [label="Son buenos amigos míos, esos protoframes. Se han convertido en mi familia.",shape=box,color=red];
		j3779578037 -> j3984354701;
	j3487893497 [label="Check boolean LyonFirstFlirt",color=orange];
		j3487893497 -> j3211131408 [label=true,color=green];
		j3487893497 -> j2633902627 [label=false,color=brown];
	j619519124 [label="Check boolean LyonFirstFlirt",color=orange];
		j619519124 -> j3211131408 [label=true,color=green];
		j619519124 -> j2602415255 [label=false,color=brown];
	j1331458418 [label="Check boolean LyonFirstFlirt",color=orange];
		j1331458418 -> j3211131408 [label=true,color=green];
		j1331458418 -> j2903481532 [label=false,color=brown];
	j2251965788 [label="Y estoy seguro de que todo esto fue fruto del grandioso y magistral plan de Entrati: confiarte el destino del futuro a ti y a una banda de inadaptados.",shape=box,color=blue];
		j2251965788 -> j1018192017;
	j3984354701 [label="Mis abuelos se conocieron durante la Revolución Gaullique. La guerra y la muerte siempre han sido compañeras que dan lugar a la camaradería de las maneras más curiosas.",shape=box,color=blue];
		j3984354701 -> j3628502303;
	j3211131408 [label="Perdóname. Me parece que la última vez que hablamos, tú... ",shape=box,color=blue];
		j3211131408 -> j2591365900;
	j2633902627 [label="Perdóname. No conozco tu corazón ni el de los demás. Lo que hagas en tu tiempo libre con los demás es asunto exclusivamente tuyo.",shape=box,color=blue];
		j2633902627 -> j3223721710;
		j2633902627 -> j460638781;
	j2602415255 [label="Perdóname. No, tienes razón. No quiero sonar celoso ni provocador. Lo que hagas en tu tiempo libre con los demás es asunto exclusivamente tuyo.",shape=box,color=blue];
		j2602415255 -> j3223721710;
		j2602415255 -> j460638781;
	j2903481532 [label="Por supuesto. Perdóname. No conozco tu corazón ni el de los demás. Lo que hagas en tu tiempo libre con los demás es asunto exclusivamente tuyo.",shape=box,color=blue];
		j2903481532 -> j3223721710;
		j2903481532 -> j460638781;
	j1018192017 [label="Yo... Viajero, sé que no soy la persona más... afable con la que te ves obligado a interactuar, y por eso me disculpo.",shape=box,color=blue];
		j1018192017 -> j3030892921;
	j3628502303 [label="Boolean LyonBackstory2 is now true.",color=orange];
		j3628502303 -> j3993939395;
		j3628502303 -> j4286372569;
	j2591365900 [label="No importa... No debería sorprenderme que los corazones sean volubles e inestables. Sobre todo cuando estoy involucrado.",shape=box,color=blue];
		j2591365900 -> j2646540690;
		j2591365900 -> j2149027381;
	j3223721710 [label="Pasé por muchas cosas con ellos. Eso suele unir a la gente.",shape=box,color=red];
		j3223721710 -> j192473108;
	j460638781 [label="[Confesar tus sentimientos] Honestamente, he estado tratando de encontrar la manera de hablar sobre esto contigo en algún momento, de todos modos.",shape=box,color=red];
		j460638781 -> j32377795;
	j3030892921 [label="Simplemente soy así y no sé cómo cambiar. De hecho, no creo ser capaz de reparar el daño que los condenados que me atormentarme han provocado a mi alma.",shape=box,color=blue];
		j3030892921 -> j2346057784;
	j3993939395 [label="Realmente parece ser así, en todas partes a lo largo de la historia.",shape=box,color=red];
		j3993939395 -> j3885708197;
	j4286372569 [label="Me encantaría saber más sobre tu familia.",shape=box,color=red];
		j4286372569 -> j3592905151;
	j2646540690 [label="Espera. Te estás equivocando. No te engañé. Las cosas son... bueno, complicadas.",shape=box,color=red];
		j2646540690 -> j2070536179;
	j2149027381 [label="Me imaginé que no te interesaba.",shape=box,color=red];
		j2149027381 -> j3075082946;
	j192473108 [label="Mis abuelos se conocieron durante la Revolución Gaullique. La guerra y la muerte siempre han sido compañeras en una danza que se convierte en pasión y amor de las maneras más extrañas.",shape=box,color=blue];
		j192473108 -> j3628502303;
	j32377795 [label="Y ahora estoy profundamente nervioso... ¿Me atrevo a preguntar por qué?",shape=box,color=blue];
		j32377795 -> j846512630;
		j32377795 -> j4049393939;
	j2346057784 [label="Lo que se esconde bajo esta superficie de vidrio fracturado es...",shape=box,color=blue];
		j2346057784 -> j2767288585;
		j2346057784 -> j4294122256;
	j3885708197 [label="En efecto. Supongo que no debería resentir ningún aspecto positivo que pueda surgir de la oscuridad y la destrucción de la guerra.",shape=box,color=blue];
		j3885708197 -> j466130094;
		j3885708197 -> j1141431173;
	j3592905151 [label="No es una historia que me guste contar. A nadie. Así que me perdonarás si no estoy demasiado ansioso por compartirla. Quizás en otra ocasión.",shape=box,color=blue];
		j3592905151 -> j336563143;
		j3592905151 -> j2893188275;
	j2070536179 [label="Por favor, continúa.",shape=box,color=blue];
		j2070536179 -> j846512630;
		j2070536179 -> j4049393939;
	j3075082946 [label="Con todo respeto, no te conozco. Y con todo lo que estoy viviendo, una aventura romántica con un desconocido no es mi prioridad.",shape=box,color=blue];
		j3075082946 -> j2397917161;
	j846512630 [label="Lo intentaremos de nuevo en otra ocasión, lo siento. ",shape=box,color=red];
		j846512630 -> j2288660060;
	j4049393939 [label="No sé si a ti te resulta fácil comprenderlo o si te parece una locura, pero yo... puedo tener sentimientos por más de una persona al mismo tiempo.",shape=box,color=red];
		j4049393939 -> j3174303495;
	j2767288585 [label="Está bien, Lyon. Ya llegaremos allí. No tengo prisa, créeme.",shape=box,color=red];
		j2767288585 -> j1799886295;
	j4294122256 [label="¿Qué es?",shape=box,color=red];
		j4294122256 -> j1116044446;
	j466130094 [label="¿Qué quieres decir?",shape=box,color=red];
		j466130094 -> j2604214309;
	j1141431173 [label="¿Lo resientes?",shape=box,color=red];
		j1141431173 -> j3190934904;
	j336563143 [label="Aquí estaré.",shape=box,color=red];
		j336563143 -> j1667037778;
	j2893188275 [label="Por supuesto. Cuando estés listo, Lyon.",shape=box,color=red];
		j2893188275 -> j628806119;
	j2397917161 [label="Estoy seguro de que hay otras personas que encontrarían alivio en los brazos de alguien en momentos como este, pero yo no soy una de esas almas afortunadas.",shape=box,color=blue];
		j2397917161 -> j513344732;
	j2288660060 [label="+20 Chemistry",color=orange];
		j2288660060 -> j3575144122;
	j3174303495 [label="Siento algo por ti. Pero también por ellos. Y para mí, ambos son verdaderos.",shape=box,color=red];
		j3174303495 -> j639362930;
	j1799886295 [label="+20 Chemistry",color=orange];
		j1799886295 -> j2021649880;
	j1116044446 [label="+10 Chemistry",color=orange];
		j1116044446 -> j601757205;
	j2604214309 [label="Discúlpame. No es una historia que me guste contar. A nadie. Así que me perdonarás si no estoy demasiado ansioso por compartirla. Quizás en otra ocasión.",shape=box,color=blue];
		j2604214309 -> j336563143;
		j2604214309 -> j2893188275;
	j3190934904 [label="No la existencia del amor, sino quizás su ausencia en mi propia vida familiar. Perdóname. No es una historia que me guste contar. A nadie. Así que me perdonarás si no estoy muy ansioso por compartirla. Quizás en otra ocasión.",shape=box,color=blue];
		j3190934904 -> j336563143;
		j3190934904 -> j2893188275;
	j1667037778 [label="+15 Chemistry",color=orange];
		j1667037778 -> j1338217;
	j628806119 [label="+20 Chemistry",color=orange];
		j628806119 -> j4149934695;
	j513344732 [label="Por favor, inténtalo con alguno de ellos. Buen día.",shape=box,color=blue];
		j513344732 -> j2084492712;
	j3575144122 [label="Muy bien. Podemos hablar de esto en otro momento, si así lo prefieres. Hasta entonces, volveré a mis tareas del día.",shape=box,color=blue];
		j3575144122 -> j2084492712;
	j639362930 [label="Tal concepto no me resulta tan ajeno como podría parecer. De hecho, no es la noción lo que me inquieta, sino las partes implicadas, sin ánimo de ofender.",shape=box,color=blue];
		j639362930 -> j127354362;
	j2021649880 [label="Boolean LyonVisions3 is now true.",color=orange];
		j2021649880 -> j795120297;
	j601757205 [label="Es demasiado para la mayoría. Y te agradezco que sigas intentándolo. Eso es todo.",shape=box,color=blue];
		j601757205 -> j2084492712;
	j1338217 [label="Estoy llegando a esa conclusión inevitable, sí. Buen día.",shape=box,color=blue];
		j1338217 -> j2084492712;
	j4149934695 [label="Gracias. Hasta que volvamos a hablar, te deseo un buen día.",shape=box,color=blue];
		j4149934695 -> j2084492712;
	j2084492712 [label="Padre Lyon Allard",shape=box,color=blue];
		j2084492712 -> "Chat ends.";
	j127354362 [label="Y tal vez lo cerca de nuestro nuevo \"hogar\" que tu flecha quiera volar.",shape=box,color=blue];
		j127354362 -> j1168699892;
		j127354362 -> j1302407528;
	j795120297 [label="Gracias...",shape=box,color=blue];
		j795120297 -> j2084492712;
	j1168699892 [label="Para ser justos, no decía \"ahora\". Solo me estaba explicando.",shape=box,color=red];
		j1168699892 -> j2604268725;
	j1302407528 [label="Entonces... ¿lo que estás diciendo es que hay una posibilidad?",shape=box,color=red];
		j1302407528 -> j3400980739;
	j2604268725 [label="+20 Chemistry",color=orange];
		j2604268725 -> j1802206384;
	j3400980739 [label="+20 Chemistry",color=orange];
		j3400980739 -> j416953800;
	j1802206384 [label="Sí, bueno... Si cuando lleguemos a ese punto he decidido que no te detesto, quizá volvamos a discutirlo entonces.",shape=box,color=blue];
		j1802206384 -> j3212630031;
	j416953800 [label="Sí... quizás. Si he decidido que no te odio para cuando lleguemos a ese punto. Y eso está por verse, Viajero.",shape=box,color=blue];
		j416953800 -> j3212630031;
	j3212630031 [label="Hasta entonces, debo retomar mis tareas del día. Aprecio esta... interesante conversación. Creo.",shape=box,color=blue];
