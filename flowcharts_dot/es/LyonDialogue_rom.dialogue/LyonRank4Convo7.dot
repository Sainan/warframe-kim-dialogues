	j2888706719 [label="¿Viajero? ¿Puedo disculparme contigo por algo?",shape=box,color=blue];
		j2888706719 -> j389864613;
		j2888706719 -> j357614481;
		j2888706719 -> j202800200;
	j389864613 [label="¿Seguro? ¿Por qué?",shape=box,color=red];
		j389864613 -> j2747927596;
	j357614481 [label="No necesitas hacerlo, Lyon. No has hecho nada malo.",shape=box,color=red];
		j357614481 -> j1074482181;
	j202800200 [label="[Fin]",shape=box,color=red];
		j202800200 -> "Chat ends.";
	j2747927596 [label="+5 Chemistry",color=orange];
		j2747927596 -> j3331961031;
	j1074482181 [label="Aunque lo aprecio, siento que, de todos modos, te lo debo. Haré todo lo posible por ser breve y no sobrecargarme con erudición innecesaria.",shape=box,color=blue];
		j1074482181 -> j3946915010;
	"Chat ends." [color=orange];
	j3331961031 [label="Gracias. Haré todo lo posible por ser breve y no sobrecargarme con erudición innecesaria.",shape=box,color=blue];
		j3331961031 -> j3946915010;
	j3946915010 [label="Las conversaciones me resultan difíciles. Mucho más en encuentros íntimos que en estos encuentros impersonales y mecánicos o por correo.",shape=box,color=blue];
		j3946915010 -> j4161023817;
	j4161023817 [label="No sé cómo describirlo, salvo que es como si estuviera tratando de alcanzar algo y sólo puedo ver polvo deslizarse entre mis dedos. ",shape=box,color=blue];
		j4161023817 -> j1013208427;
	j1013208427 [label="A menudo me siento como si fuera un lienzo vacío, manchado con pintura al óleo, intentando inútilmente crear la sombra de una imagen que puedo ver con mi mente.",shape=box,color=blue];
		j1013208427 -> j2356131030;
	j2356131030 [label="Pero cuanto más trabajo, más desesperanzador me parece.",shape=box,color=blue];
		j2356131030 -> j1596113444;
	j1596113444 [label="Cuanto más lo intento, más se me escapa. Así que he aprendido a no intentarlo en absoluto.",shape=box,color=blue];
		j1596113444 -> j3420673235;
	j3420673235 [label="Por eso te evité al principio. Y por eso todavía soy... propenso a los episodios de soledad. No encuentro las palabras.",shape=box,color=blue];
		j3420673235 -> j2673522909;
		j3420673235 -> j3118245863;
		j3420673235 -> j4149105066;
	j2673522909 [label="Siempre seré feliz de tenerte a mi lado en silencio.",shape=box,color=red];
		j2673522909 -> j1531557995;
	j3118245863 [label="A veces suelo ser igual. No pasa nada.",shape=box,color=red];
		j3118245863 -> j3624590165;
	j4149105066 [label="Disculpa aceptada.",shape=box,color=red];
		j4149105066 -> j2376250798;
	j1531557995 [label="+15 Chemistry",color=orange];
		j1531557995 -> j2957828064;
	j3624590165 [label="+15 Chemistry",color=orange];
		j3624590165 -> j2483426569;
	j2376250798 [label="+10 Chemistry",color=orange];
		j2376250798 -> j949150696;
	j2957828064 [label="Lo recordaré. Gracias, Viajero.",shape=box,color=blue];
		j2957828064 -> j2084492712;
	j2483426569 [label="No me había dado cuenta. Recordaré que no debo asumir que estoy solo en este mundo... Gracias, Viajero.",shape=box,color=blue];
		j2483426569 -> j2084492712;
	j949150696 [label="Por supuesto. Gracias, Viajero.",shape=box,color=blue];
