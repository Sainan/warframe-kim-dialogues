	edge [fontname="Roboto Condensed"];

	"LyonRank5Convo4 begins." [color=orange];
		"LyonRank5Convo4 begins." -> j3539407545;
	j3539407545 [label="Check boolean LyonPainOff",color=orange];
		j3539407545 -> j3788596445 [label=true,color=green];
		j3539407545 -> j2793227429 [label=false,color=brown];
	j3788596445 [label="+20 Chemistry",color=orange];
		j3788596445 -> j2255444926;
	j2793227429 [label="Evaluate expressions",color=orange];
		j2793227429 -> j891060959 [label="LyonDating, LyonConfession1, LyonConfession2",color=purple];
		j2793227429 -> j1050683044 [label="LyonConfession1, LyonConfession2",color=purple];
		j2793227429 -> "Chat ends." [label="false",color=purple];
	j2255444926 [label="[Conversación omitida debido a una advertencia previamente establecida]",shape=box,color=blue];
		j2255444926 -> j1028404978;
	j891060959 [label="Creo que no te puedo describir adecuadamente que tan extraño fue el momento en el que me inyecté, mon miracle.",shape=box,color=blue];
		j891060959 -> j3956347940;
		j891060959 -> j3379537956;
		j891060959 -> j1156810670;
		j891060959 -> j152570860;
	j1050683044 [label="Creo que no te puedo describir adecuadamente que tan extraño fue el momento en el que me inyecté, amigo mío.",shape=box,color=blue];
		j1050683044 -> j3956347940;
		j1050683044 -> j3379537956;
		j1050683044 -> j1156810670;
		j1050683044 -> j152570860;
	"Chat ends." [color=orange];
	j1028404978 [label="Boolean LyonRell3 is now true.",color=orange];
		j1028404978 -> j4075781927;
	j3956347940 [label="He escuchado que es increíblemente doloroso.",shape=box,color=red];
		j3956347940 -> j3379202099;
	j3379537956 [label="No me lo puedo imaginar. ",shape=box,color=red];
		j3379537956 -> j3412848768;
	j1156810670 [label="[Advertencia: Breves menciones sobre autolesiones y maltrato infantil. Haz clic aquí para terminar la conversación. No perderás niveles de química con Lyon]",shape=box,color=red];
		j1156810670 -> j1843578849;
	j152570860 [label="[Fin]",shape=box,color=red];
		j152570860 -> j3856020424;
	j4075781927 [label="Boolean LyonWillDate is now true.",color=orange];
		j4075781927 -> "Chat ends. Next chat will be Lyon5FaithDay2.";
	j3379202099 [label="Supongo que sí. Aunque creo que he tenido años de práctica en ese aspecto y por lo tanto, las advertencias de Entrati lo hicieron mucho más impresionante de lo que era realmente.",shape=box,color=blue];
		j3379202099 -> j3412848768;
	j3412848768 [label="Marie y yo decidimos tomar nuestros sueros en privado. Le pregunté si me dejaba hacerlo primero, experimentar el cambio, así le ayudaría guiándola con el suyo... pero ella, por supuesto, se negó rotundamente.",shape=box,color=blue];
		j3412848768 -> j3159434489;
	j1843578849 [label="+20 Chemistry",color=orange];
		j1843578849 -> j2698387260;
	j3856020424 [label="Boolean LyonConfessionFail is now true.",color=orange];
		j3856020424 -> "Chat ends.";
	"Chat ends. Next chat will be Lyon5FaithDay2." [color=orange];
	j3159434489 [label="Burlándose de la mera idea de que me iría a algún lado o haría algo sin ella firmemente plantada a mi lado, así ella se fue a su habitación.",shape=box,color=blue];
		j3159434489 -> j3540517677;
	j2698387260 [label="Boolean LyonFamilySuccess is now true.",color=orange];
		j2698387260 -> j2559080857;
	j3540517677 [label="Me encerré en mi habitación, me desnudé, me senté en medio del piso, tan lejos como pude de cualquier objeto, antes de clavarme la aguja a mi costado.",shape=box,color=blue];
		j3540517677 -> j2003506721;
	j2559080857 [label="Boolean LyonRell3 is now true.",color=orange];
		j2559080857 -> j4008758555;
	j2003506721 [label="Había visto lo que la infestación había hecho con Roathe, retorciendo su cuerpo con lo que fuera que estuviera usando en ese momento... no tenía el deseo de ser una víctima del mismo destino.",shape=box,color=blue];
		j2003506721 -> j479221937;
	j4008758555 [label="Boolean LyonFaith3Unknown is now true.",color=orange];
		j4008758555 -> "Chat ends. Next chat will be Lyon5FaithDay2.";
	j479221937 [label="Cuando la agonía había terminado, la visión que estaba sufriendo estaba... borrosa. De alguna manera... ¿Sobrepasándola... al doble? Como si pudiera ver no una, sino dos veces.",shape=box,color=blue];
		j479221937 -> j695400609;
	j695400609 [label="Estoy orgulloso de mi resiliencia, por cómo logré cubrirme antes de vomitar y caer inconsciente.",shape=box,color=blue];
		j695400609 -> j1415829082;
	j1415829082 [label="Cuando desperté, no estaba solo. Sin embargo no estaba en el piso de mi habitación. Estaba sentado en la habitación de mi niñez, sobre el viejo y crujiente piso que conocía tan bien.",shape=box,color=blue];
		j1415829082 -> j845000620;
	j845000620 [label="Y sentado a mi lado había un joven. Y junto a él había una figura que ahora conozco como Harrow. El joven estaba sosteniendo una pequeña figura de madera en sus manos. Tenía extremidades articuladas... la pintura se veía desgastada, salvo quizás en sus pliegues y grietas. Le había pertenecido a mi padre. Quien fue un soldado.",shape=box,color=blue];
		j845000620 -> j300800399;
	j300800399 [label="Era el único juguete que podía considerar como mío cuando era un niño.",shape=box,color=blue];
		j300800399 -> j1711541877;
		j300800399 -> j16462846;
	j1711541877 [label="Tenía una figura similar en mi niñez. Era uno de mis juguetes favoritos.",shape=box,color=red];
		j1711541877 -> j2956371871;
	j16462846 [label="¿Rell?",shape=box,color=red];
		j16462846 -> j1505961794;
	j2956371871 [label="Eso he escuchado. Creo que el mío probó ser más benigno al final.",shape=box,color=blue];
		j2956371871 -> j984951342;
		j2956371871 -> j1947419414;
		j2956371871 -> j1990409458;
	j1505961794 [label="En efecto.",shape=box,color=blue];
		j1505961794 -> j1953645535;
	j984951342 [label="Thrax es un tema complicado. Preferiría no entrar en detalles.",shape=box,color=red];
		j984951342 -> j3896169990;
	j1947419414 [label="Realmente no fue su culpa. Él era justo quien necesitaba que fuera en ese momento.",shape=box,color=red];
		j1947419414 -> j4216837379;
	j1990409458 [label="Está bien, está progresando lentamente. De alguna manera lo aparentemente imposible puede cambiar.",shape=box,color=red];
		j1990409458 -> j3426334215;
	j1953645535 [label="El joven y su silencioso guardián que me visitaba en mis sueños, en mi mente... eran todos al mismo tiempo extraños para mí, pero conocidos como si hubiéramos crecido juntos como hermanos.",shape=box,color=blue];
		j1953645535 -> j3668833496;
	j3896169990 [label="Es cierto. Podríamos quedarnos aquí por horas, debatiendo las implicaciones morales y teológicas de Duviri.",shape=box,color=blue];
		j3896169990 -> j1953645535;
	j4216837379 [label="Cuando pienso siquiera en la más mínima idea de lo que habría conjurado en su lugar, me invade un horror inmenso. Pero podríamos quedarnos aquí por horas discutiendo tal cosa.",shape=box,color=blue];
		j4216837379 -> j1953645535;
	j3426334215 [label="Si está mostrando signos de cambio, y él es producto de sus emociones, tal vez ese es el indicativo de algo más. Pero quizás eso es una discusión para otro día.",shape=box,color=blue];
		j3426334215 -> j1953645535;
	j3668833496 [label="Discúlpame por la metáfora exagerada, pero era como si fuéramos tres árboles cuyas raíces crecían juntas para volverse indistinguibles entre sí...",shape=box,color=blue];
		j3668833496 -> j3198610597;
	j3198610597 [label="Habían aparecido de la nada, en el estado en que se encontraban. Podía recordar mi vida sin Rell y Harrow. Y, sin embargo, allí estaban. En cada momento, en cada instante... a mi lado.",shape=box,color=blue];
		j3198610597 -> j4260792313;
	j4260792313 [label="Por cierto... quisiera poder hablar con Entrati, estoy desesperado por saber qué tipo de ciencia está en la raíz de esto (sin intención de hacer un juego de palabras), pero cuando finalmente nos recuperamos de nuestro cambio, Entrati ya se había ido.",shape=box,color=blue];
		j4260792313 -> j1937133691;
	j1937133691 [label="Check boolean LoidFamilyComplete",color=orange];
		j1937133691 -> j3710356844 [label=true,color=green];
		j1937133691 -> j3282830786 [label=false,color=brown];
		j1937133691 -> j3710356844 [label=false,color=brown];
	j3710356844 [label="Lo poco que sé de la infestación y cómo funciona parece estar como... tal vez... no sé, ¿a destiempo?",shape=box,color=red];
		j3710356844 -> j2231692304;
	j3282830786 [label="La hija de Entrati está allá arriba. Estudió y trabajó a su lado. Puede que ella te pueda ayudar.",shape=box,color=red];
		j3282830786 -> j790426362;
	j2231692304 [label="Hay una... guitarra... es muy difícil de explicar, y ambos hemos viajado a través del tiempo por medio del Helminto...",shape=box,color=red];
		j2231692304 -> j4220279705;
	j790426362 [label="Boolean LyonFamilySuccess is now true.",color=orange];
		j790426362 -> j1223992918;
	j4220279705 [label="Lo cual es un proceso que creo perdurará en mis pesadillas por un largo tiempo. En cualquier caso, desconozco los detalles de cómo es que Rell, Harrow y yo nos enlazamos a un nivel... molecular.",shape=box,color=blue];
		j4220279705 -> j1871815409;
	j1223992918 [label="Add 1 to Family counter",color=orange];
		j1223992918 -> j2360575383;
	j1871815409 [label="Pero la encrucijada era de doble sentido. Donde ellos estaban en mi vida, y yo en la de ellos. Vi la Indiferencia. Entendí contra qué se defendía. Vi a Harrow y al hombre que una vez fue.",shape=box,color=blue];
		j1871815409 -> j3609477613;
	j2360575383 [label="Ojalá fuéramos capaces de hablar con ella. Me temo que ya hay planes en marcha. Si es así, puedes contar conmigo... para ayudar. Puedo ser muy convincente cuando se necesita.",shape=box,color=blue];
		j2360575383 -> j1002670756;
	j3609477613 [label="Pero la presión de la Indiferencia tomó el control de lo que podía sentir allí... escucharla como ellos lo hacían, golpeando las paredes. Rap... tap... tap...",shape=box,color=blue];
		j3609477613 -> j969444523;
	j1002670756 [label="En cualquier caso, desconozco los detalles de cómo es que Rell, Harrow y yo nos enlazamos a un nivel... molecular.",shape=box,color=blue];
		j1002670756 -> j1871815409;
	j969444523 [label="Todas las visiones de mi juventud, todos los horrores que había visto... ¿Eran solamente la Indiferencia? ¿Estaba recordándolo mal? ¿O de hecho había sido \"bendecido\" por Lua?",shape=box,color=blue];
		j969444523 -> j1391450866;
	j1391450866 [label="La fe dentro de mí... se desmoronó y se desvaneció. Nada más que papel quemado, reducido a cenizas. Ay... cómo me aborrezco por mi debilidad...",shape=box,color=blue];
		j1391450866 -> j2547210604;
	j2547210604 [label="Evaluate expressions",color=orange];
		j2547210604 -> j813195242 [label="LyonDating",color=purple];
		j2547210604 -> j1700685220 [label="DrifterFaithYesSimilar",color=purple];
		j2547210604 -> j1700685220 [label="DrifterFaithYesForeign",color=purple];
		j2547210604 -> j1700685220 [label="DrifterFaithPersonal",color=purple];
		j2547210604 -> j1271704028 [label="DrifterFaithSol",color=purple];
		j2547210604 -> j1271704028 [label="DrifterFaithLua",color=purple];
		j2547210604 -> j1271704028 [label="DrifterFaithBalance",color=purple];
		j2547210604 -> j1877533248 [label="DrifterFaithAgnostic",color=purple];
		j2547210604 -> j485944594 [label="DrifterFaithNoFear",color=purple];
		j2547210604 -> j1043574482 [label="DrifterFaithNoMITW",color=purple];
		j2547210604 -> j485944594 [label="DrifterFaithNoMaybe",color=purple];
		j2547210604 -> j2274696605 [label="false",color=purple];
	j813195242 [label="Ay, Lyon... has pasado por tanto. La duda no es señal de debilidad, sino del dolor.",shape=box,color=red];
		j813195242 -> j840436570;
		j813195242 -> j28445568;
		j813195242 -> j1514067662;
		j813195242 -> j1247010381;
		j813195242 -> j766307475;
	j1700685220 [label="La fe no necesita ser constante... y tampoco se espera que lo tenga que ser. ¿Cuántas historias se cuentan a quienes pierden la fe, solo para encontrarla de nuevo?",shape=box,color=red];
		j1700685220 -> j840436570;
		j1700685220 -> j28445568;
		j1700685220 -> j1514067662;
	j1271704028 [label="Dedicaste tu vida a nuestras Luminarias, Lyon. ¿Crees que te darían la espalda por algo así?",shape=box,color=red];
		j1271704028 -> j840436570;
		j1271704028 -> j28445568;
		j1271704028 -> j1514067662;
	j1877533248 [label="No sé si hay dioses o no, Lyon... No creo que ninguno de nosotros lo vaya a saber con certeza. Pero lo que sí sé es que has pasado por mucho.",shape=box,color=red];
		j1877533248 -> j840436570;
		j1877533248 -> j1514067662;
		j1877533248 -> j1247010381;
	j485944594 [label="Mientras personalmente no creo que haya dioses en este mundo, sé lo importante que ha sido para ti en tu vida. No quiero menospreciarlo.",shape=box,color=red];
		j485944594 -> j1514067662;
		j485944594 -> j766307475;
	j1043574482 [label="La Indiferencia fue hecha por nosotros... no es un dios, Lyon. No dejes que el error de Entrati te destruya. ¿Y tu fe?",shape=box,color=red];
		j1043574482 -> j1514067662;
		j1043574482 -> j766307475;
	j2274696605 [label="Odio verte así, atrapado en medio de todas las cosas sin sentido de los demás. No merecías esto.",shape=box,color=red];
		j2274696605 -> j840436570;
		j2274696605 -> j28445568;
		j2274696605 -> j1514067662;
		j2274696605 -> j1247010381;
		j2274696605 -> j766307475;
	j840436570 [label="No estoy diciendo que necesites encontrar tu fe de nuevo. Estoy diciendo que si tu quieres... si sientes que lo necesitas... no es algo que se pierde para siempre.",shape=box,color=red];
		j840436570 -> j3975500690;
	j28445568 [label="Seguramente Lua puede ver por lo que has pasado. Lo que has soportado en su nombre. ",shape=box,color=red];
		j28445568 -> j1978907365;
	j1514067662 [label="Yo creo que lo que necesitas es concentrarte en encontrar algún tipo de paz dentro de ti... sin embargo eres tú el que necesita encontrarla.",shape=box,color=red];
		j1514067662 -> j3975500690;
	j1247010381 [label="Si es que hay un dios, si es que Lua existe... seguramente ella puede ver por lo que has pasado. Lo que has soportado en su nombre. Debe de significar algo para ella.",shape=box,color=red];
		j1247010381 -> j1978907365;
	j766307475 [label="Creo que necesitas dejar de lado cualquier noción de que si existen o no los dioses y concentrarte en sanarte a ti mismo primero.",shape=box,color=red];
		j766307475 -> j2339079804;
	j3975500690 [label="Boolean LyonFaith3Maybe is now true.",color=orange];
		j3975500690 -> j3522072354;
	j1978907365 [label="Boolean LyonFaith3Yes is now true.",color=orange];
		j1978907365 -> j3522072354;
	j2339079804 [label="Boolean LyonFaith3No is now true.",color=orange];
		j2339079804 -> j3522072354;
	j3522072354 [label="Quizás estés en lo correcto... y mi triste historia de dudas no era el punto. Pero consideraré tus palabras. Debemos discutir esto en más detalle mañana.",shape=box,color=blue];
		j3522072354 -> j2942832150;
	j2942832150 [label="Vi la vida de Rell abordo de la Zariman Diez Cero, y todo lo que soportó después de eso. Vi la vida de Harrow siendo un soldado, desvaneciéndose por la Infestación. Así como ellos también vieron mi vida en Gaule y todo lo que sufrí.",shape=box,color=blue];
		j2942832150 -> j4122409877;
	j4122409877 [label="Puede que sea extraño para ti saber que ninguno de nosotros cruzamos palabras. Nunca encontramos la necesidad. Simplemente había un... entendimiento entre nosotros.",shape=box,color=blue];
		j4122409877 -> j434170536;
		j4122409877 -> j1677107543;
	j434170536 [label="¿En serio? ¿Nunca?",shape=box,color=red];
		j434170536 -> j629009472;
	j1677107543 [label="Sí... lo entiendo.",shape=box,color=red];
		j1677107543 -> j3898604413;
	j629009472 [label="Podía escuchar sus voces... Me sabía todas las palabras que en sus vidas habían usado. Pero nunca dirigidas hacia mí.",shape=box,color=blue];
		j629009472 -> j3898604413;
	j3898604413 [label="¿Una sonrisa necesita palabras? ¿Una mueca de enojo? ¿Necesitas escuchar a un niño sollozar para saber que está sufriendo o que está asustado? No, simplemente sabíamos lo qué pasaba entre nosotros.",shape=box,color=blue];
		j3898604413 -> j2319450189;
	j2319450189 [label="Hasta que... Hasta que ya no supimos.",shape=box,color=blue];
		j2319450189 -> j944777217;
	j944777217 [label="Check boolean LyonDating",color=orange];
		j944777217 -> j1505630921 [label=true,color=green];
		j944777217 -> j2849891278 [label=false,color=brown];
	j1505630921 [label="No se han ido, mon miracle... sólo están muertos.",shape=box,color=blue];
		j1505630921 -> j4254867016;
	j2849891278 [label="No se han ido, amigo mío... sólo están muertos.",shape=box,color=blue];
		j2849891278 -> j4254867016;
	j4254867016 [label="Ya no puedo escuchar esas partes de ellos las cuales estaban determinadas. Ahora, creo, que sólo puedo escuchar esa parte de ellos que fue.",shape=box,color=blue];
		j4254867016 -> j541422773;
		j4254867016 -> j1281804491;
	j541422773 [label="Disculpa... ¿determinadas?",shape=box,color=red];
		j541422773 -> j520294005;
	j1281804491 [label="¿Cuándo es que... dejaste de escucharlos?",shape=box,color=red];
		j1281804491 -> j2963301344;
	j520294005 [label="No lo puedo explicar más de lo que ya lo hice. Sé que no puedo por ahora. Lo lamento.",shape=box,color=blue];
		j520294005 -> j2963301344;
	j2963301344 [label="En el momento cuando pasamos a través del Helminto con Roathe y llegué aquí, al Sanctum. No sé... por qué o cómo.",shape=box,color=blue];
		j2963301344 -> j3307348249;
	j3307348249 [label="Pero al pasar a través por ese velo del tiempo, mis amigos, mis hermanos... los árboles cuyas raíces se entrelazaron tan estrechamente en mi alma... se marchitaron y murieron a mi lado.",shape=box,color=blue];
		j3307348249 -> j2129972985;
	j2129972985 [label="Ahora solo hay un vacío. Pudriéndose. La memoria de ellos sigue corrompiendo la mía. Pero no la abandonaría si tuviera la oportunidad...",shape=box,color=blue];
		j2129972985 -> j770123145;
		j2129972985 -> j3502242390;
	j770123145 [label="¿Eh?",shape=box,color=red];
		j770123145 -> j3653328976;
	j3502242390 [label="¿Por qué no?",shape=box,color=red];
		j3502242390 -> j3653328976;
	j3653328976 [label="Puedo recordar la primera vez que mi madre me golpeó. Lo recuerdo de dos maneras, tan claro como la luz brillante de Sol y sé que todas las versiones son verdaderas.",shape=box,color=blue];
		j3653328976 -> j568455737;
	j568455737 [label="En una... lloraba solo en la oscuridad de mi habitación. En otra, dos figuras permanecían a mi lado en las sombras.",shape=box,color=blue];
		j568455737 -> j1326565314;
	j1326565314 [label="Recuerdo dos versiones de la primera vez que me lastimé con el cuchillo para disipar las voces de mi mente. En una, el cuarto está vacío.",shape=box,color=blue];
		j1326565314 -> j1864505298;
	j1864505298 [label="Y en la otra, escucho un tarareo atrás de mí. Siento la presencia silenciosa de un estoico guardián.",shape=box,color=blue];
		j1864505298 -> j3081450461;
	j3081450461 [label="Si he perdido mi fe en mi diosa de Lua y he ganado su guía a cambio... es un trato el cual estoy dispuesto a hacer.",shape=box,color=blue];
		j3081450461 -> j2400849994;
	j2400849994 [label="Evaluate expressions",color=orange];
		j2400849994 -> j3105219197 [label="LyonDating",color=purple];
		j2400849994 -> j2795601273 [label="LyonDating",color=purple];
		j2400849994 -> j3105219197 [label="DrifterFaithYesSimilar",color=purple];
		j2400849994 -> j2249165716 [label="DrifterFaithYesSimilar",color=purple];
		j2400849994 -> j3105219197 [label="DrifterFaithYesForeign",color=purple];
		j2400849994 -> j2249165716 [label="DrifterFaithYesForeign",color=purple];
		j2400849994 -> j3105219197 [label="DrifterFaithPersonal",color=purple];
		j2400849994 -> j2249165716 [label="DrifterFaithPersonal",color=purple];
		j2400849994 -> j3105219197 [label="DrifterFaithSol",color=purple];
		j2400849994 -> j3466282273 [label="DrifterFaithSol",color=purple];
		j2400849994 -> j3105219197 [label="DrifterFaithLua",color=purple];
		j2400849994 -> j3466282273 [label="DrifterFaithLua",color=purple];
		j2400849994 -> j3105219197 [label="DrifterFaithBalance",color=purple];
		j2400849994 -> j3466282273 [label="DrifterFaithBalance",color=purple];
		j2400849994 -> j3105219197 [label="DrifterFaithAgnostic",color=purple];
		j2400849994 -> j2318046499 [label="DrifterFaithAgnostic",color=purple];
		j2400849994 -> j3105219197 [label="DrifterFaithNoFear",color=purple];
		j2400849994 -> j4194591185 [label="DrifterFaithNoFear",color=purple];
		j2400849994 -> j3105219197 [label="DrifterFaithNoMITW",color=purple];
		j2400849994 -> j4194591185 [label="DrifterFaithNoMITW",color=purple];
