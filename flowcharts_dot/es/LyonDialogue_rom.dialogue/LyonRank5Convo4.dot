	j2793227429 [label="Evaluate expressions",color=orange];
		j2793227429 -> j1575799791 [label="LyonDating, LyonConfession1, LyonConfession2",color=purple];
		j2793227429 -> j2090321328 [label="LyonConfession1, LyonConfession2",color=purple];
		j2793227429 -> "Chat ends." [label="false",color=purple];
	j338465623 [label="[Conversation skipped due to previous setting of trigger warning.]",shape=box,color=blue];
		j338465623 -> j1028404978;
	j1575799791 [label="I do not think I can adequately describe to you how strange a moment it was to inject the serum, mon miracle.",shape=box,color=blue];
		j1575799791 -> j3480757021;
		j1575799791 -> j2064507072;
		j1575799791 -> j1133628288;
		j1575799791 -> j1840947816;
	j2090321328 [label="I do not think I can adequately describe to you how strange a moment it was to inject the serum, my friend.",shape=box,color=blue];
		j2090321328 -> j3480757021;
		j2090321328 -> j2064507072;
		j2090321328 -> j1133628288;
		j2090321328 -> j1840947816;
	"Chat ends." [color=orange];
	j1028404978 [label="Boolean LyonRell3 is now true.",color=orange];
		j1028404978 -> j4075781927;
	j3480757021 [label="I've heard it's incredibly painful.",shape=box,color=red];
		j3480757021 -> j477445651;
	j2064507072 [label="I can't possibly imagine. ",shape=box,color=red];
		j2064507072 -> j2231872233;
	j1133628288 [label="[Warning: Brief mentions of self-harm and child abuse. Click here to end. No loss of Chemistry with Lyon will be incurred.]",shape=box,color=red];
		j1133628288 -> j1843578849;
	j1840947816 [label="[Fin.]",shape=box,color=red];
		j1840947816 -> j3856020424;
	j4075781927 [label="Boolean LyonWillDate is now true.",color=orange];
		j4075781927 -> "Chat ends. Next chat will be Lyon5FaithDay2.";
	j477445651 [label="I suppose so. Though I do believe that I have had years of practice in that regard and, therefore, Entrati's warnings made it to be far more impressive than it was in actuality.",shape=box,color=blue];
		j477445651 -> j2231872233;
	j2231872233 [label="Marie and I decided to take our serums in private. I asked her to allow me to go first, experience the change, and then to help guide her through her own - but she, of course, steadfastly refused.",shape=box,color=blue];
		j2231872233 -> j3397592238;
	j1843578849 [label="+20 Chemistry",color=orange];
		j1843578849 -> j2698387260;
	j3856020424 [label="Boolean LyonConfessionFail is now true.",color=orange];
		j3856020424 -> "Chat ends.";
	"Chat ends. Next chat will be Lyon5FaithDay2." [color=orange];
	j3397592238 [label="Scoffing at the mere notion that I would go anywhere or do anything without her firmly planted at my side, she headed off to her own chambers.",shape=box,color=blue];
		j3397592238 -> j2038319619;
	j2698387260 [label="Boolean LyonFamilySuccess is now true.",color=orange];
		j2698387260 -> j2559080857;
	j2038319619 [label="I locked my door, stripped, and sat in the middle of my floor, as far away from any objects as I could, before I drove the needle into my side.",shape=box,color=blue];
		j2038319619 -> j222758957;
	j2559080857 [label="Boolean LyonRell3 is now true.",color=orange];
		j2559080857 -> j4008758555;
	j222758957 [label="I had seen what the Infestation had done to Roathe, twisting his flesh with whatever he must have been wearing at the time - I had no desire to fall victim of the same fate.",shape=box,color=blue];
		j222758957 -> j3500730294;
	j4008758555 [label="Boolean LyonFaith3Unknown is now true.",color=orange];
		j4008758555 -> "Chat ends. Next chat will be Lyon5FaithDay2.";
	j3500730294 [label="When the agony was over, my already suffering vision was... blurred. Overtaken in... double, somehow? As though I could see not once, but twice.",shape=box,color=blue];
		j3500730294 -> j2489265345;
	j2489265345 [label="I am quite proud of my resilience, however, that I managed to don my britches before I retched and unconsciousness took me.",shape=box,color=blue];
		j2489265345 -> j4235948116;
	j4235948116 [label="When I awoke, I was not alone. Nor, however, was I on the floor of my chambers. I was sitting in my childhood bedroom upon the creaky old floors I knew so well.",shape=box,color=blue];
		j4235948116 -> j836425301;
	j836425301 [label="And sitting beside me was a young man. Beside him stood a figure I now know as Harrow. The young man was holding a small wooden figurine in his hands. It was jointed at the limbs - the paint long worn away, save perhaps in the creases and cracks. It had belonged to my father. It was of a soldier.",shape=box,color=blue];
		j836425301 -> j3212008715;
	j3212008715 [label="It was the only toy I could claim as my own, as a child.",shape=box,color=blue];
		j3212008715 -> j2645404915;
		j3212008715 -> j1631219762;
	j2645404915 [label="I had a similar figurine, growing up. It was one of my favorite toys.",shape=box,color=red];
		j2645404915 -> j3902846273;
	j1631219762 [label="Rell?",shape=box,color=red];
		j1631219762 -> j3620206392;
	j3902846273 [label="So I have heard. I believe mine proved to be more benign, in the end.",shape=box,color=blue];
		j3902846273 -> j3373639179;
		j3902846273 -> j4253532521;
		j3902846273 -> j325421531;
	j3620206392 [label="Indeed.",shape=box,color=blue];
		j3620206392 -> j3635917176;
	j3373639179 [label="Thrax is a complicated topic. I'd rather not get into it here.",shape=box,color=red];
		j3373639179 -> j4276712307;
	j4253532521 [label="It wasn't his fault, really. He was just who I needed him to be in that moment in time.",shape=box,color=red];
		j4253532521 -> j458911878;
	j325421531 [label="It's okay. He's progressing. Slowly. Somehow. The seemingly impossible can change.",shape=box,color=red];
		j325421531 -> j2747438730;
	j3635917176 [label="The young man and his silent guardian who visited me inside my dream- inside my mind - were all at once strangers to me and yet known to me like we had grown up together as siblings.",shape=box,color=blue];
		j3635917176 -> j2864445148;
	j4276712307 [label="Quite right. We could be lost here for hours, debating the moral and theological implications of Duviri.",shape=box,color=blue];
		j4276712307 -> j3635917176;
	j458911878 [label="When I ponder even the smallest notion of what I would have conjured in your stead, I am overcome with waves of horror. But we could be lost here for hours, discussing such a thing.",shape=box,color=blue];
		j458911878 -> j3635917176;
	j2747438730 [label="If he is showing signs of change, and he is a product of your emotions, perhaps that is indicative of something else. But a debate for another day, perhaps.",shape=box,color=blue];
		j2747438730 -> j3635917176;
	j2864445148 [label="Forgive me for an overwrought metaphor, but it was as though we were three trees whose roots were so grown together as to become indistinguishable from one another -",shape=box,color=blue];
		j2864445148 -> j1079986156;
	j1079986156 [label="who had merely been blinked into existence in such a state. I could remember my life without Rell and Harrow. And yet, there they were. In every moment - in every instance - beside me.",shape=box,color=blue];
		j1079986156 -> j4227795077;
	j4227795077 [label="As an aside, I wish I could speak to Entrati about this, I am desperate to know what manner of science is at the - no pun intended - root of this, but when we finally recovered from our change, Entrati was gone.",shape=box,color=blue];
		j4227795077 -> j1937133691;
	j1937133691 [label="Check boolean LoidFamilyComplete",color=orange];
		j1937133691 -> j3116301787 [label=true,color=green];
		j1937133691 -> j1378396093 [label=false,color=brown];
		j1937133691 -> j3116301787 [label=false,color=brown];
	j3116301787 [label="What little I know of the Infestation and how it works, it seems to be kind of... maybe... I don't know, outside time?",shape=box,color=red];
		j3116301787 -> j1571057733;
	j1378396093 [label="Entrati's daughter is upstairs. She studied and worked beside him. She might be able to help.",shape=box,color=red];
		j1378396093 -> j122481226;
	j1571057733 [label="There's a... guitar... it's all very hard to explain, and we've both traveled through time via Helminth...",shape=box,color=red];
		j1571057733 -> j3137520430;
	j122481226 [label="Boolean LyonFamilySuccess is now true.",color=orange];
		j122481226 -> j538400272;
	j3137520430 [label="Which was a process I believe will linger in my nightmares for a very long time. Regardless, the specifics of how it is that Rell, Harrow, and I became bonded at such a... molecular, spiritual level, I do not know.",shape=box,color=blue];
		j3137520430 -> j3333162315;
	j538400272 [label="Add 1 to Family counter",color=orange];
		j538400272 -> j3224449827;
	j3333162315 [label="But the crossroads went both ways. Where they were in my life, I was in theirs. I saw the Indifference. I understood what they were standing guard against. I saw glimpses of Harrow, and the man he once was.",shape=box,color=blue];
		j3333162315 -> j2426564199;
	j3224449827 [label="Now if only we were allowed to speak to her. I suspect there are schemes to that effect already in play. If so, you may count on me to... assist. I can be convincing when need be.",shape=box,color=blue];
		j3224449827 -> j2502653121;
	j2426564199 [label="But the press of the Indifference took over I could feel it there - hear it as they did, tapping against the walls. Rap... tap... tap...",shape=box,color=blue];
		j2426564199 -> j1858108996;
	j2502653121 [label="Regardless, the specifics of how it is that Rell, Harrow, and I became bonded at such a... molecular, spiritual level, I do not know.",shape=box,color=blue];
		j2502653121 -> j3333162315;
	j1858108996 [label="All the visions of my youth, all the horrors that I had seen - were they only ever the Indifference? Was I now mis-remembering? Or had I indeed been \"blessed\" by Lua?",shape=box,color=blue];
		j1858108996 -> j623392025;
	j623392025 [label="My faith inside of me... it crumpled and fell away. Nothing more than charred paper, turned to dust. And oh, how I loathe myself for my weakness...",shape=box,color=blue];
		j623392025 -> j2547210604;
	j2547210604 [label="Evaluate expressions",color=orange];
		j2547210604 -> j1450013210 [label="LyonDating",color=purple];
		j2547210604 -> j910090015 [label="DrifterFaithYesSimilar",color=purple];
		j2547210604 -> j910090015 [label="DrifterFaithYesForeign",color=purple];
		j2547210604 -> j910090015 [label="DrifterFaithPersonal",color=purple];
		j2547210604 -> j2333831460 [label="DrifterFaithSol",color=purple];
		j2547210604 -> j2333831460 [label="DrifterFaithLua",color=purple];
		j2547210604 -> j2333831460 [label="DrifterFaithBalance",color=purple];
		j2547210604 -> j928692881 [label="DrifterFaithAgnostic",color=purple];
		j2547210604 -> j4183919341 [label="DrifterFaithNoFear",color=purple];
		j2547210604 -> j1209849483 [label="DrifterFaithNoMITW",color=purple];
		j2547210604 -> j4183919341 [label="DrifterFaithNoMaybe",color=purple];
		j2547210604 -> j3738305794 [label="false",color=purple];
	j1450013210 [label="Oh, Lyon... you've been through so much. Doubt isn't the result of weakness - doubt is the result of pain.",shape=box,color=red];
		j1450013210 -> j3946494602;
		j1450013210 -> j1790536478;
		j1450013210 -> j1655976617;
		j1450013210 -> j2817354629;
		j1450013210 -> j637121358;
	j910090015 [label="Faith doesn't need to be constant - nor is it expected to be. How many tales are told of those who lose their faith, only to find it again?",shape=box,color=red];
		j910090015 -> j3946494602;
		j910090015 -> j1790536478;
		j910090015 -> j1655976617;
	j2333831460 [label="You spent your life in dedication to our Luminaries, Lyon. Do you think they would turn away from you for something like this?",shape=box,color=red];
		j2333831460 -> j3946494602;
		j2333831460 -> j1790536478;
		j2333831460 -> j1655976617;
	j928692881 [label="I don't know if there are gods or not, Lyon - I don't think any of us can ever truly know. But what I do know, is that you've been through a great deal.",shape=box,color=red];
		j928692881 -> j3946494602;
		j928692881 -> j1655976617;
		j928692881 -> j2817354629;
	j4183919341 [label="While I personally don't believe there are gods in this world, I know how important that has been to you in your life. I don't want to belittle that.",shape=box,color=red];
		j4183919341 -> j1655976617;
		j4183919341 -> j637121358;
	j1209849483 [label="The Indifference was made by us - he isn't a god, Lyon. Don't let Entrati's mistake destroy you. As for your faith?",shape=box,color=red];
		j1209849483 -> j1655976617;
		j1209849483 -> j637121358;
	j3738305794 [label="I hate to see you like this, caught in the middle of everyone's nonsense. You didn't deserve this.",shape=box,color=red];
		j3738305794 -> j3946494602;
		j3738305794 -> j1790536478;
		j3738305794 -> j1655976617;
		j3738305794 -> j2817354629;
		j3738305794 -> j637121358;
	j3946494602 [label="I'm not saying you need to find your faith again. I'm saying if you want to - if you feel you need to - it's not something that's forever lost.",shape=box,color=red];
		j3946494602 -> j4235733650;
	j1790536478 [label="Surely, Lua can see what you've been put through. What you've endured in her name. ",shape=box,color=red];
		j1790536478 -> j188402280;
	j1655976617 [label="What I think is that you need to focus on is finding some kind of peace within yourself - however it is you need to find it.",shape=box,color=red];
		j1655976617 -> j4235733650;
	j2817354629 [label="If there is a god, if your Lua does exist - surely she can see what you've been through. What you've endured in her name. It must mean something to her.",shape=box,color=red];
		j2817354629 -> j188402280;
	j637121358 [label="I think you need to let go of any notion of whether or not there are gods, and focus on healing yourself, first.",shape=box,color=red];
		j637121358 -> j683185276;
	j4235733650 [label="Boolean LyonFaith3Maybe is now true.",color=orange];
		j4235733650 -> j3511376472;
	j188402280 [label="Boolean LyonFaith3Yes is now true.",color=orange];
		j188402280 -> j3511376472;
	j683185276 [label="Boolean LyonFaith3No is now true.",color=orange];
		j683185276 -> j3511376472;
	j3511376472 [label="Perhaps you are right... And my sad tale of doubt was hardly the point. But I shall consider your words. We shall discuss this in more detail tomorrow.",shape=box,color=blue];
		j3511376472 -> j1576450928;
	j1576450928 [label="I saw Rell's life aboard the Zariman Ten Zero, and all that he endured after it. I saw Harrow's life as a soldier, faded as it was through the Infestation. Just as they saw my life in Gaule and all I suffered.",shape=box,color=blue];
		j1576450928 -> j2158651767;
	j2158651767 [label="It may be strange to you to know that none of us ever once exchanged a word. We never found the need. There was simply between us an... understanding.",shape=box,color=blue];
		j2158651767 -> j1483766189;
		j2158651767 -> j1829119266;
	j1483766189 [label="Really? Never?",shape=box,color=red];
		j1483766189 -> j3624410421;
	j1829119266 [label="Yeah... I can see that.",shape=box,color=red];
		j1829119266 -> j1889145319;
	j3624410421 [label="I could hear their voices - I knew all the words in their lives they had ever spoken. But they were never directed to me.",shape=box,color=blue];
		j3624410421 -> j1889145319;
	j1889145319 [label="Does a smile need a speech? Does a frown? Do you need to hear a child weeping to know he is in pain or frightened? No, we merely knew what was passed between us.",shape=box,color=blue];
		j1889145319 -> j2276490866;
	j2276490866 [label="Until it... until it no longer was.",shape=box,color=blue];
		j2276490866 -> j944777217;
	j944777217 [label="Check boolean LyonDating",color=orange];
		j944777217 -> j321595824 [label=true,color=green];
		j944777217 -> j3922430130 [label=false,color=brown];
	j321595824 [label="They are not gone, mon miracle... only dead.",shape=box,color=blue];
		j321595824 -> j427780658;
	j3922430130 [label="They are not gone, my friend... only dead.",shape=box,color=blue];
		j3922430130 -> j427780658;
	j427780658 [label="I can no longer hear those parts of them which were undetermined. Now, I believe, I can only hear that part of them which were.",shape=box,color=blue];
		j427780658 -> j2172462837;
		j427780658 -> j2128846340;
	j2172462837 [label="I'm sorry, determined?",shape=box,color=red];
		j2172462837 -> j390834133;
	j2128846340 [label="When did you... stop hearing him?",shape=box,color=red];
		j2128846340 -> j2831203698;
	j390834133 [label="I cannot explain it any more than I already have. I know not how. Forgive me.",shape=box,color=blue];
		j390834133 -> j2831203698;
	j2831203698 [label="The moment we passed through the Helminth with Roathe and came here, to the Sanctum. I do not know... why. Or how.",shape=box,color=blue];
		j2831203698 -> j1200649692;
	j1200649692 [label="But in passing through that veil of time, my friends, my brothers.. the trees whose roots wove through my soul so closely... withered and died beside me.",shape=box,color=blue];
		j1200649692 -> j3073340071;
	j3073340071 [label="Now an emptiness is there. Rotting. The memory of them still corrupting my own. But I would not give it away if I had the chance...",shape=box,color=blue];
		j3073340071 -> j2539057934;
		j3073340071 -> j1710257358;
	j2539057934 [label="Oh?",shape=box,color=red];
		j2539057934 -> j1466462965;
	j1710257358 [label="Why not?",shape=box,color=red];
		j1710257358 -> j1466462965;
	j1466462965 [label="I can recall the memory of the first time my mother struck me. I remember it two ways, clear as Sol's brightest light, and I know all versions are true.",shape=box,color=blue];
		j1466462965 -> j3137497417;
	j3137497417 [label="In one... I weep alone in the darkness of my room. In another, two figures stand beside me in the shadows.",shape=box,color=blue];
		j3137497417 -> j3990130693;
	j3990130693 [label="I remember twice the first time I took a blade to my skin to clear the voices from my mind. In one, the room is empty.",shape=box,color=blue];
		j3990130693 -> j672011164;
	j672011164 [label="In another, I hear a humming from behind me. I feel the silent presence of a stoic guardian.",shape=box,color=blue];
		j672011164 -> j3314496750;
	j3314496750 [label="If I have lost my faith in my goddess of Lua and have gained their guidance in return... it may be a trade I would be willing to give.",shape=box,color=blue];
		j3314496750 -> j2400849994;
	j2400849994 [label="Evaluate expressions",color=orange];
		j2400849994 -> j2266721226 [label="LyonDating",color=purple];
		j2400849994 -> j420251458 [label="LyonDating",color=purple];
		j2400849994 -> j2266721226 [label="DrifterFaithYesSimilar",color=purple];
		j2400849994 -> j848706734 [label="DrifterFaithYesSimilar",color=purple];
		j2400849994 -> j2266721226 [label="DrifterFaithYesForeign",color=purple];
		j2400849994 -> j848706734 [label="DrifterFaithYesForeign",color=purple];
		j2400849994 -> j2266721226 [label="DrifterFaithPersonal",color=purple];
		j2400849994 -> j848706734 [label="DrifterFaithPersonal",color=purple];
		j2400849994 -> j2266721226 [label="DrifterFaithSol",color=purple];
		j2400849994 -> j3642227627 [label="DrifterFaithSol",color=purple];
		j2400849994 -> j2266721226 [label="DrifterFaithLua",color=purple];
		j2400849994 -> j3642227627 [label="DrifterFaithLua",color=purple];
		j2400849994 -> j2266721226 [label="DrifterFaithBalance",color=purple];
		j2400849994 -> j3642227627 [label="DrifterFaithBalance",color=purple];
		j2400849994 -> j2266721226 [label="DrifterFaithAgnostic",color=purple];
		j2400849994 -> j1744839659 [label="DrifterFaithAgnostic",color=purple];
		j2400849994 -> j2266721226 [label="DrifterFaithNoFear",color=purple];
		j2400849994 -> j791721280 [label="DrifterFaithNoFear",color=purple];
		j2400849994 -> j2266721226 [label="DrifterFaithNoMITW",color=purple];
		j2400849994 -> j791721280 [label="DrifterFaithNoMITW",color=purple];
		j2400849994 -> j2266721226 [label="DrifterFaithNoMaybe",color=purple];
		j2400849994 -> j791721280 [label="DrifterFaithNoMaybe",color=purple];
		j2400849994 -> j2266721226 [label="false",color=purple];
		j2400849994 -> j791721280 [label="false",color=purple];
	j2266721226 [label="I'm just - I'm just so sorry for what both of you have had to go through.",shape=box,color=red];
		j2266721226 -> j787127047;
	j420251458 [label="I'm just... so glad Rell and Harrow could be there with you, Lyon... even if it was in memories.",shape=box,color=red];
		j420251458 -> j2779457497;
	j848706734 [label="Could you consider the possibility that... maybe this is all the work of a god or gods? To comfort you?",shape=box,color=red];
		j848706734 -> j3086494386;
	j3642227627 [label="Could you consider the possibility that... maybe this is all the work of Lua? To comfort you?",shape=box,color=red];
		j3642227627 -> j3086494386;
	j1744839659 [label="I don't know as the two have to be mutually exclusive, but... I don't know. I don't know as we ever will.",shape=box,color=red];
		j1744839659 -> j510677876;
	j791721280 [label="I'm just... so glad Rell and Harrow could be there with you, Lyon... even if it was in memories.",shape=box,color=red];
		j791721280 -> j787127047;
	j787127047 [label="Thank you. I miss their presence. But I... am learning that in this place, there are more who might understand my pain than not.",shape=box,color=blue];
		j787127047 -> j3848321264;
	j2779457497 [label="Thank you. I miss their presence. But I am... no longer alone, am I, mon miracle?",shape=box,color=blue];
		j2779457497 -> j3848321264;
	j3086494386 [label="Yes. Do not think I have not considered it. I am not sure if my faith will be so easily mended, but... it is a comfort to ponder, all the same.",shape=box,color=blue];
		j3086494386 -> j3848321264;
	j510677876 [label="Indeed. Do not think I have not considered whether or not Rell and Harrow were sent by the Luminaries to comfort me. But as you said, such is not for us to know.",shape=box,color=blue];
		j510677876 -> j3848321264;
	j3848321264 [label="+20 Chemistry",color=orange];
