digraph {
	32 [label="LyonRank3Convo2 begins.",color=orange];
		32 -> 33;
	33 [label="Si me lo permites, quisiera contarte la historia de un gato callejero que solía pasar por la parte trasera de la iglesia.",shape=box,color=blue];
		33 -> 36;
		33 -> 35;
		33 -> 34;
	36 [label="Adelante.",shape=box,color=red];
		36 -> 39;
	35 [label="¿Por qué?",shape=box,color=red];
		35 -> 38;
	34 [label="[Ignorar]",shape=box,color=red];
		34 -> 37;
	39 [label="Gracias.",shape=box,color=blue];
		39 -> 41;
	38 [label="Me temo que explicarlo requeriría más esfuerzo del que merecería la pena.",shape=box,color=blue];
		38 -> 40;
	37 [label="Chat ends.",color=orange];
	41 [label="Aunque sospecho que esta historia no es exclusiva de este viejo gato desaliñado, y que mis interacciones con él no parecen dignas de mención, vale la pena contarla de todos modos.",shape=box,color=blue];
		41 -> 43;
	40 [label="Olvídalo.",shape=box,color=blue];
		40 -> 42;
	43 [label="Todos los días venía a mendigar sobras y las escasas muestras de cariño que pudiera obtener de mí o de los otros hermanos y hermanas que lo adoraban.",shape=box,color=blue];
		43 -> 44;
	42 [label="Chat ends.",color=orange];
	44 [label="Era un ser andrajoso, cojeaba de una pierna y le faltaba parte de una oreja. ",shape=box,color=blue];
		44 -> 45;
	45 [label="Cuando no apareció durante unos días, Marie estaba muy preocupada. Pero ¿qué se puede hacer por un viejo gato callejero que ha encontrado su fin, sino rezarle a Lua?",shape=box,color=blue];
		45 -> 46;
	46 [label="Update boolean LyonStray",color=orange];
		46 -> 47;
		46 -> 48;
		46 -> 49;
	47 [label="[Dejarlo continuar]",shape=box,color=red];
		47 -> 50;
	48 [label="¿Está permitido eso en tu religión? Me refiero a rezar por los animales.",shape=box,color=red];
		48 -> 51;
	49 [label="¿Rezarías por el alma de un gato callejero fallecido?",shape=box,color=red];
		49 -> 52;
	50 [label="De todos modos, imagina mi sorpresa cuando, al ir a comprar pan al mercado, vi al viejo gato sentado junto al dueño del puesto.",shape=box,color=blue];
		50 -> 53;
	51 [label="+10 Chemistry",color=orange];
		51 -> 54;
	52 [label="Por supuesto. Algunas de las almas más puras y brillantes que he conocido estaban atrapadas en el cuerpo de una bestia. No me corresponde juzgar cómo las Luminarias las han encaminado por sus sendas.",shape=box,color=blue];
		52 -> 55;
	53 [label="Me saludó con un maullido ronco, como siempre, y saltó para frotarse contra mi pierna.",shape=box,color=blue];
		53 -> 56;
	54 [label="Buena pregunta. En algunas sectas, no. Se consideraría herejía. Pero en la nuestra, sí. Reconocemos que los animales tienen alma.",shape=box,color=blue];
		54 -> 55;
	55 [label="Santa Isabel la Sabia era conocida por su caridad hacia los animales, aunque muchas tradiciones no reconocen a los santos como apóstoles de las Luminarias.",shape=box,color=blue];
		55 -> 57;
	56 [label="Y quisiera señalar, Viajero, que lo hizo sin cojear.",shape=box,color=blue];
		56 -> 58;
	57 [label="Me pregunto si alguna influencia de nuestra orden ha sobrevivido tanto tiempo... pero ese no era el tema de la conversación.",shape=box,color=blue];
		57 -> 59;
	58 [label="\"Ah, eres una de las víctimas del viejo Devereaux.\" El hombre se rió mientras guardaba mi pan en una bolsa.",shape=box,color=blue];
		58 -> 60;
	59 [label="Update boolean LyonLecture1",color=orange];
		59 -> 50;
	60 [label="Resulta que el viejo gato nos estaba tomando el pelo, a nosotros y a varios vecinos. No estaba hambriento, ni enfermo, ni descuidado de ninguna manera.",shape=box,color=blue];
		60 -> 61;
	61 [label="De hecho, si se creía en las palabras del hombre, era un auténtico asesino en lo que respecta a la población local de aves.",shape=box,color=blue];
		61 -> 62;
		61 -> 63;
		61 -> 64;
	62 [label="¿Dejaste de alimentar al viejo Devereaux cuando volvió?",shape=box,color=red];
		62 -> 65;
	63 [label="¿Estás intentando advertirme sobre Roathe?",shape=box,color=red];
		63 -> 66;
	64 [label="¿Eres tú el gato callejero de esta historia?",shape=box,color=red];
		64 -> 67;
	65 [label="+10 Chemistry",color=orange];
		65 -> 68;
	66 [label="Hay muchísimas advertencias sobre el demonio que el \"Cardenal Dimanche\" nos trajo. Quizás esta sea una de ellas. Quizás no.",shape=box,color=blue];
		66 -> 69;
	67 [label="Las Luminarias saben que últimamente he estado bastante desgastado. ¿Pero acaso esto pretende ser una advertencia sobre mí mismo? Tal vez. Tal vez no.",shape=box,color=blue];
		67 -> 69;
	68 [label="No, no lo hicimos. De hecho, Marie lo recibió con aún más cariño por ello, bromeando con él por ser \"su pequeño diablillo\".",shape=box,color=blue];
		68 -> 70;
	69 [label="Es simplemente una historia para decir que a veces, cuando una criatura parece estar necesitada...",shape=box,color=blue];
		69 -> 71;
	70 [label="Pero ya no nos preocupábamos por él. Sabíamos que el viejo Devereaux podía cuidarse perfectamente solo. No nos necesitaba.",shape=box,color=blue];
		70 -> 72;
		70 -> 73;
	71 [label="+15 Chemistry",color=orange];
		71 -> 74;
	72 [label="¿Sabes qué le pasó al viejo Devereaux?",shape=box,color=red];
		72 -> 75;
	73 [label="¿Qué crees que motivó la visita del viejo Devereaux, si no era por necesidad?",shape=box,color=red];
		73 -> 76;
	74 [label="debes comprobar lo afiladas que pueden ser sus garras.",shape=box,color=blue];
		74 -> 77;
	75 [label="Su siguiente desaparición, dos años después, se volvió permanente.",shape=box,color=blue];
		75 -> 78;
		75 -> 79;
	76 [label="La respuesta cínica que daría sería \"avaricia\". Porque si uno puede tener un festín, ¿por qué no dos? ¿Por qué no diez?",shape=box,color=blue];
		76 -> 80;
		76 -> 81;
	77 [label="Chat ends.",color=orange];
	78 [label="¿Rezaste por él?",shape=box,color=red];
		78 -> 82;
	79 [label="Espero que haya dejado este mundo tranquilo y amado.",shape=box,color=red];
		79 -> 83;
	80 [label="¿Cuál sería la respuesta no cínica?",shape=box,color=red];
		80 -> 84;
	81 [label="¿Sigue siendo igual si solo buscaba caricias?",shape=box,color=red];
		81 -> 85;
	82 [label="Encendí una vela por él la noche que supe de su muerte y recé a Lua para que guiara su alma a... dondequiera que ella guiara a un pequeño diablillo como él.",shape=box,color=blue];
		82 -> 86;
	83 [label="¿Puedo preguntar por qué?",shape=box,color=blue];
		83 -> 87;
		83 -> 88;
	84 [label="+10 Chemistry",color=orange];
		84 -> 89;
	85 [label="Un deseo avaricioso de afecto sigue siendo gula, aunque no sea un hambre que se alimenta con carne y vino. ¿Y buscarlo con semejantes pretextos falsos?",shape=box,color=blue];
		85 -> 90;
		85 -> 91;
	86 [label="Y agradecí al viejo Devereaux por toda la alegría que le brindaba a Marie a cambio de todos esos codiciados trozos de cartílago de pollo y caricias en la cabeza.",shape=box,color=blue];
		86 -> 92;
	87 [label="Era un animal. Simplemente buscaba satisfacción: comida, refugio, amor; no lo motivaban las mismas cosas que a las personas. No mentía, cazaba con otras herramientas.",shape=box,color=red];
		87 -> 93;
	88 [label="He visto mucha violencia, Lyon. Mucha de ella la he provocado yo. He llegado a desear que todos, sin importar quiénes sean ni lo que hayan hecho, puedan tener una muerte pacífica rodeados de sus seres queridos.",shape=box,color=red];
		88 -> 94;
	89 [label="Me encontré de una manera extraña... respetando al gato, por el lugar que había encontrado en el mundo.",shape=box,color=blue];
		89 -> 95;
	90 [label="Era un gato, Lyon. Apenas sabía lo que hacía.",shape=box,color=red];
		90 -> 96;
	91 [label="Seguimos hablando de un gato, ¿verdad?",shape=box,color=red];
		91 -> 97;
	92 [label="Gracias. No te molestaré más en este día.",shape=box,color=blue];
		92 -> 98;
	93 [label="Al convertirlos a todos en sus \"tontos\", no les estaba negando nada a los demás. En todo caso... parece que todos ustedes se enriquecían con sus visitas.",shape=box,color=red];
		93 -> 99;
	94 [label="Fascinante. Esperarúa que despreciaras a tus enemigos. Pero ese es mi propio error: suponer que sé cómo se comportaría alguien en estos tiempos.",shape=box,color=blue];
		94 -> 100;
	95 [label="He aquí una criatura que había aprendido a utilizar su condición —su apariencia, su edad, sus cicatrices— como un arma contra \"los tontos\" que lo rodeaban y que no se daban cuenta de su engaño.",shape=box,color=blue];
		95 -> 101;
	96 [label="Sabía perfectamente que debía fingir una cojera. ",shape=box,color=blue];
		96 -> 84;
	97 [label="Saca tus propias conclusiones de esta conversación, Viajero.",shape=box,color=blue];
		97 -> 84;
	98 [label="-F. Lyon Allard",shape=box,color=blue];
		98 -> 102;
	99 [label="Add -1 to Thermostat",color=orange];
		99 -> 103;
	100 [label="Add 1 to Thermostat",color=orange];
		100 -> 104;
	101 [label="Era un diablillo de pelaje enmarañado, sin duda. Aun así, lo acariciaba cuando venía de visita.",shape=box,color=blue];
		101 -> 105;
	102 [label="Chat ends.",color=orange];
	103 [label="Sí. Supongo que eso fue lo que pasó. Y no nos faltaban trocitos de cartílago y pedazos de pollo.",shape=box,color=blue];
		103 -> 106;
	104 [label="Y mucho menos alguien con tu fascinante historia de infancia. ",shape=box,color=blue];
		104 -> 107;
	105 [label="Y quedé igualmente desconsolado cuando, dos años después, su siguiente desaparición fue definitiva.",shape=box,color=blue];
		105 -> 78;
		105 -> 79;
	106 [label="Quizás por eso encendí una vela por él y le recé a Lua para que se llevara su alma y la guiara a... dondequiera que ella llevara a un pequeño diablillo como él.",shape=box,color=blue];
		106 -> 108;
	107 [label="+5 Chemistry",color=orange];
		107 -> 109;
	108 [label="+5 Chemistry",color=orange];
		108 -> 110;
	109 [label="Gracias. No te molestaré más. Ha sido una conversación muy interesante. Hasta la próxima.",shape=box,color=blue];
		109 -> 111;
	110 [label="Y por eso, aquella noche, al rezar, le di las gracias al viejo Devereaux por toda la alegría que le había brindado a Marie.",shape=box,color=blue];
		110 -> 112;
	111 [label="-F. Lyon Allard",shape=box,color=blue];
		111 -> 113;
	112 [label="Quizás su pequeña villanía tuvo algún beneficio indirecto.",shape=box,color=blue];
		112 -> 109;
	113 [label="Chat ends.",color=orange];
}