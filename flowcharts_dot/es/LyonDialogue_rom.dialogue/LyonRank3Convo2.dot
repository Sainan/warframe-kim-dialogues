digraph {
	"LyonRank3Convo2 begins." [color=orange];
		"LyonRank3Convo2 begins." -> j3538280110;
	j3538280110 [label="Si me lo permites, quisiera contarte la historia de un gato callejero que solía pasar por la parte trasera de la iglesia.",shape=box,color=blue];
		j3538280110 -> j2365101297;
		j3538280110 -> j1085496453;
		j3538280110 -> j1678137900;
	j2365101297 [label="Adelante.",shape=box,color=red];
		j2365101297 -> j1331785450;
	j1085496453 [label="¿Por qué?",shape=box,color=red];
		j1085496453 -> j1024249006;
	j1678137900 [label="[Ignorar]",shape=box,color=red];
		j1678137900 -> "Chat ends.";
	j1331785450 [label="Gracias.",shape=box,color=blue];
		j1331785450 -> j267390665;
	j1024249006 [label="Me temo que explicarlo requeriría más esfuerzo del que merecería la pena.",shape=box,color=blue];
		j1024249006 -> j4224787981;
	"Chat ends." [color=orange];
	j267390665 [label="Aunque sospecho que esta historia no es exclusiva de este viejo gato desaliñado, y que mis interacciones con él no parecen dignas de mención, vale la pena contarla de todos modos.",shape=box,color=blue];
		j267390665 -> j147503823;
	j4224787981 [label="Olvídalo.",shape=box,color=blue];
		j4224787981 -> "Chat ends.";
	j147503823 [label="Todos los días venía a mendigar sobras y las escasas muestras de cariño que pudiera obtener de mí o de los otros hermanos y hermanas que lo adoraban.",shape=box,color=blue];
		j147503823 -> j2502434795;
	j2502434795 [label="Era un ser andrajoso, cojeaba de una pierna y le faltaba parte de una oreja. ",shape=box,color=blue];
		j2502434795 -> j2697488989;
	j2697488989 [label="Cuando no apareció durante unos días, Marie estaba muy preocupada. Pero ¿qué se puede hacer por un viejo gato callejero que ha encontrado su fin, sino rezarle a Lua?",shape=box,color=blue];
		j2697488989 -> j3437213928;
	j3437213928 [label="Boolean LyonStray is now true.",color=orange];
		j3437213928 -> j426953947;
		j3437213928 -> j2564375618;
		j3437213928 -> j2476744024;
	j426953947 [label="[Dejarlo continuar]",shape=box,color=red];
		j426953947 -> j54282269;
	j2564375618 [label="¿Está permitido eso en tu religión? Me refiero a rezar por los animales.",shape=box,color=red];
		j2564375618 -> j318786634;
	j2476744024 [label="¿Rezarías por el alma de un gato callejero fallecido?",shape=box,color=red];
		j2476744024 -> j1302718935;
	j54282269 [label="De todos modos, imagina mi sorpresa cuando, al ir a comprar pan al mercado, vi al viejo gato sentado junto al dueño del puesto.",shape=box,color=blue];
		j54282269 -> j67024861;
	j318786634 [label="+10 Chemistry",color=orange];
		j318786634 -> j1214016675;
	j1302718935 [label="Por supuesto. Algunas de las almas más puras y brillantes que he conocido estaban atrapadas en el cuerpo de una bestia. No me corresponde juzgar cómo las Luminarias las han encaminado por sus sendas.",shape=box,color=blue];
		j1302718935 -> j508022467;
	j67024861 [label="Me saludó con un maullido ronco, como siempre, y saltó para frotarse contra mi pierna.",shape=box,color=blue];
		j67024861 -> j626962009;
	j1214016675 [label="Buena pregunta. En algunas sectas, no. Se consideraría herejía. Pero en la nuestra, sí. Reconocemos que los animales tienen alma.",shape=box,color=blue];
		j1214016675 -> j508022467;
	j508022467 [label="Santa Isabel la Sabia era conocida por su caridad hacia los animales, aunque muchas tradiciones no reconocen a los santos como apóstoles de las Luminarias.",shape=box,color=blue];
		j508022467 -> j1145416440;
	j626962009 [label="Y quisiera señalar, Viajero, que lo hizo sin cojear.",shape=box,color=blue];
		j626962009 -> j1635357896;
	j1145416440 [label="Me pregunto si alguna influencia de nuestra orden ha sobrevivido tanto tiempo... pero ese no era el tema de la conversación.",shape=box,color=blue];
		j1145416440 -> j2300601958;
	j1635357896 [label="\"Ah, eres una de las víctimas del viejo Devereaux.\" El hombre se rió mientras guardaba mi pan en una bolsa.",shape=box,color=blue];
		j1635357896 -> j432297868;
	j2300601958 [label="Boolean LyonLecture1 is now true.",color=orange];
		j2300601958 -> j54282269;
	j432297868 [label="Resulta que el viejo gato nos estaba tomando el pelo, a nosotros y a varios vecinos. No estaba hambriento, ni enfermo, ni descuidado de ninguna manera.",shape=box,color=blue];
		j432297868 -> j1922277207;
	j1922277207 [label="De hecho, si se creía en las palabras del hombre, era un auténtico asesino en lo que respecta a la población local de aves.",shape=box,color=blue];
		j1922277207 -> j4262393797;
		j1922277207 -> j2890686484;
		j1922277207 -> j4015906959;
	j4262393797 [label="¿Dejaste de alimentar al viejo Devereaux cuando volvió?",shape=box,color=red];
		j4262393797 -> j842563384;
	j2890686484 [label="¿Estás intentando advertirme sobre Roathe?",shape=box,color=red];
		j2890686484 -> j3472030979;
	j4015906959 [label="¿Eres tú el gato callejero de esta historia?",shape=box,color=red];
		j4015906959 -> j2764380898;
	j842563384 [label="+10 Chemistry",color=orange];
		j842563384 -> j2228700899;
	j3472030979 [label="Hay muchísimas advertencias sobre el demonio que el \"Cardenal Dimanche\" nos trajo. Quizás esta sea una de ellas. Quizás no.",shape=box,color=blue];
		j3472030979 -> j1039148654;
	j2764380898 [label="Las Luminarias saben que últimamente he estado bastante desgastado. ¿Pero acaso esto pretende ser una advertencia sobre mí mismo? Tal vez. Tal vez no.",shape=box,color=blue];
		j2764380898 -> j1039148654;
	j2228700899 [label="No, no lo hicimos. De hecho, Marie lo recibió con aún más cariño por ello, bromeando con él por ser \"su pequeño diablillo\".",shape=box,color=blue];
		j2228700899 -> j3306197226;
	j1039148654 [label="Es simplemente una historia para decir que a veces, cuando una criatura parece estar necesitada...",shape=box,color=blue];
		j1039148654 -> j156805958;
	j3306197226 [label="Pero ya no nos preocupábamos por él. Sabíamos que el viejo Devereaux podía cuidarse perfectamente solo. No nos necesitaba.",shape=box,color=blue];
		j3306197226 -> j766954545;
		j3306197226 -> j4143707405;
	j156805958 [label="+15 Chemistry",color=orange];
		j156805958 -> j3280240264;
	j766954545 [label="¿Sabes qué le pasó al viejo Devereaux?",shape=box,color=red];
		j766954545 -> j286603837;
	j4143707405 [label="¿Qué crees que motivó la visita del viejo Devereaux, si no era por necesidad?",shape=box,color=red];
		j4143707405 -> j438964544;
	j3280240264 [label="debes comprobar lo afiladas que pueden ser sus garras.",shape=box,color=blue];
		j3280240264 -> "Chat ends.";
	j286603837 [label="Su siguiente desaparición, dos años después, se volvió permanente.",shape=box,color=blue];
		j286603837 -> j3404008906;
		j286603837 -> j3163238899;
	j438964544 [label="La respuesta cínica que daría sería \"avaricia\". Porque si uno puede tener un festín, ¿por qué no dos? ¿Por qué no diez?",shape=box,color=blue];
		j438964544 -> j983570774;
		j438964544 -> j126400593;
	j3404008906 [label="¿Rezaste por él?",shape=box,color=red];
		j3404008906 -> j135358381;
	j3163238899 [label="Espero que haya dejado este mundo tranquilo y amado.",shape=box,color=red];
		j3163238899 -> j2870939167;
	j983570774 [label="¿Cuál sería la respuesta no cínica?",shape=box,color=red];
		j983570774 -> j1789199915;
	j126400593 [label="¿Sigue siendo igual si solo buscaba caricias?",shape=box,color=red];
		j126400593 -> j122588141;
	j135358381 [label="Encendí una vela por él la noche que supe de su muerte y recé a Lua para que guiara su alma a... dondequiera que ella guiara a un pequeño diablillo como él.",shape=box,color=blue];
		j135358381 -> j913483689;
	j2870939167 [label="¿Puedo preguntar por qué?",shape=box,color=blue];
		j2870939167 -> j1187217811;
		j2870939167 -> j1065874169;
	j1789199915 [label="+10 Chemistry",color=orange];
		j1789199915 -> j2063478804;
	j122588141 [label="Un deseo avaricioso de afecto sigue siendo gula, aunque no sea un hambre que se alimenta con carne y vino. ¿Y buscarlo con semejantes pretextos falsos?",shape=box,color=blue];
		j122588141 -> j2816859200;
		j122588141 -> j4146907387;
	j913483689 [label="Y agradecí al viejo Devereaux por toda la alegría que le brindaba a Marie a cambio de todos esos codiciados trozos de cartílago de pollo y caricias en la cabeza.",shape=box,color=blue];
		j913483689 -> j1682347540;
	j1187217811 [label="Era un animal. Simplemente buscaba satisfacción: comida, refugio, amor; no lo motivaban las mismas cosas que a las personas. No mentía, cazaba con otras herramientas.",shape=box,color=red];
		j1187217811 -> j1094773485;
	j1065874169 [label="He visto mucha violencia, Lyon. Mucha de ella la he provocado yo. He llegado a desear que todos, sin importar quiénes sean ni lo que hayan hecho, puedan tener una muerte pacífica rodeados de sus seres queridos.",shape=box,color=red];
		j1065874169 -> j2726728824;
	j2063478804 [label="Me encontré de una manera extraña... respetando al gato, por el lugar que había encontrado en el mundo.",shape=box,color=blue];
		j2063478804 -> j653560252;
	j2816859200 [label="Era un gato, Lyon. Apenas sabía lo que hacía.",shape=box,color=red];
		j2816859200 -> j1261573336;
	j4146907387 [label="Seguimos hablando de un gato, ¿verdad?",shape=box,color=red];
		j4146907387 -> j2316296874;
	j1682347540 [label="Gracias. No te molestaré más en este día.",shape=box,color=blue];
		j1682347540 -> j944546954;
	j1094773485 [label="Al convertirlos a todos en sus \"tontos\", no les estaba negando nada a los demás. En todo caso... parece que todos ustedes se enriquecían con sus visitas.",shape=box,color=red];
		j1094773485 -> j2412014537;
	j2726728824 [label="Fascinante. Esperarúa que despreciaras a tus enemigos. Pero ese es mi propio error: suponer que sé cómo se comportaría alguien en estos tiempos.",shape=box,color=blue];
		j2726728824 -> j2194911687;
	j653560252 [label="He aquí una criatura que había aprendido a utilizar su condición —su apariencia, su edad, sus cicatrices— como un arma contra \"los tontos\" que lo rodeaban y que no se daban cuenta de su engaño.",shape=box,color=blue];
		j653560252 -> j2462705183;
	j1261573336 [label="Sabía perfectamente que debía fingir una cojera. ",shape=box,color=blue];
		j1261573336 -> j1789199915;
	j2316296874 [label="Saca tus propias conclusiones de esta conversación, Viajero.",shape=box,color=blue];
		j2316296874 -> j1789199915;
	j944546954 [label="-F. Lyon Allard",shape=box,color=blue];
		j944546954 -> "Chat ends.";
	j2412014537 [label="Add -1 to Thermostat counter",color=orange];
		j2412014537 -> j1511034264;
	j2194911687 [label="Add 1 to Thermostat counter",color=orange];
		j2194911687 -> j607928439;
	j2462705183 [label="Era un diablillo de pelaje enmarañado, sin duda. Aun así, lo acariciaba cuando venía de visita.",shape=box,color=blue];
		j2462705183 -> j2912394649;
	j1511034264 [label="Sí. Supongo que eso fue lo que pasó. Y no nos faltaban trocitos de cartílago y pedazos de pollo.",shape=box,color=blue];
		j1511034264 -> j241499021;
	j607928439 [label="Y mucho menos alguien con tu fascinante historia de infancia. ",shape=box,color=blue];
		j607928439 -> j2725204633;
	j2912394649 [label="Y quedé igualmente desconsolado cuando, dos años después, su siguiente desaparición fue definitiva.",shape=box,color=blue];
		j2912394649 -> j3404008906;
		j2912394649 -> j3163238899;
	j241499021 [label="Quizás por eso encendí una vela por él y le recé a Lua para que se llevara su alma y la guiara a... dondequiera que ella llevara a un pequeño diablillo como él.",shape=box,color=blue];
		j241499021 -> j2522756185;
	j2725204633 [label="+5 Chemistry",color=orange];
		j2725204633 -> j4146886359;
	j2522756185 [label="+5 Chemistry",color=orange];
		j2522756185 -> j1489461473;
	j4146886359 [label="Gracias. No te molestaré más. Ha sido una conversación muy interesante. Hasta la próxima.",shape=box,color=blue];
		j4146886359 -> j944546954;
	j1489461473 [label="Y por eso, aquella noche, al rezar, le di las gracias al viejo Devereaux por toda la alegría que le había brindado a Marie.",shape=box,color=blue];
		j1489461473 -> j4038702203;
	j4038702203 [label="Quizás su pequeña villanía tuvo algún beneficio indirecto.",shape=box,color=blue];
		j4038702203 -> j4146886359;
}