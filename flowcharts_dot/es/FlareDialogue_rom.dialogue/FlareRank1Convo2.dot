		j658644551 -> j1777330832;
	j2313138060 [label="el pajarito decidió que tendría su espectáculo. de una forma u otra. ¿pero esta vez? no sería un concierto",shape=box,color=blue];
		j2313138060 -> j898158848;
	j1777330832 [label="no pude detenerlos. eran demasiados. ¿todos contra mi? veo que los masticas como si fueran caramelos...",shape=box,color=blue];
		j1777330832 -> j678362548;
	j898158848 [label="es el tipo de espectáculo que sólo puedes hacer una vez...",shape=box,color=blue];
		j898158848 -> j1777330832;
