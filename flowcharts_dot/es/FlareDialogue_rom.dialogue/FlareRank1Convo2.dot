	j2189853903 [label="etcétera, etcétera, etcétera.",shape=box,color=blue];
		j2189853903 -> j2464425853;
	j2464425853 [label="¿ese idiota quería un concierto? bueno, lo consiguió. mi personaje en el escenario siempre ha sido un poco... intenso",shape=box,color=blue];
		j2464425853 -> j3957119500;
	j3957119500 [label="siempre he sido yo con el volumen al máximo ",shape=box,color=blue];
		j3957119500 -> j3690795633;
	j3690795633 [label="¿pero ahora? *¿ahora?* era como si estuviera corriendo más alto que las nubes, corriendo con algún tipo de energía que ni siquiera sabía que *existía*",shape=box,color=blue];
		j3690795633 -> j455720379;
		j3690795633 -> j4040828741;
	j455720379 [label="¿Y después?",shape=box,color=red];
		j455720379 -> j1668851360;
	j4040828741 [label="El Vacío es una gran droga.",shape=box,color=red];
		j4040828741 -> j2665894388;
	j1668851360 [label="estando de pie en ese escenario, mi nuevo yo, se sentía con... vida. sentía que realmente vivía. jamás había sentido tanto mi propio ser. fue glorioso. liberador. sentí que volaba",shape=box,color=blue];
		j1668851360 -> j2334489203;
	j2665894388 [label="¿qué?",shape=box,color=blue];
		j2665894388 -> j3185576709;
