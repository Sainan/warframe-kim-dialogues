		j1391271865 -> j2398848097;
	j2683166911 [label="A veces me despierto y siento que hay otra versión de mí viviendo en la piel de un extraño. Que no coincido con lo que hay en la superficie. Como si fuera una mentira.",shape=box,color=red];
		j2683166911 -> j3418416007;
	j2169436200 [label="Algunos días me despierto con tanto dolor que quiero meterme en un agujero y deseo que el día pase rápido. Intentarlo de nuevo mañana. Pero sé que siempre volverá.",shape=box,color=red];
