		j843969546 -> j1646697545;
		j843969546 -> j2953343786;
	j2021435138 [label="puedo *platicar* con los otros protoframes, ¿sabes?",shape=box,color=blue];
		j2021435138 -> j1005531593;
	j1018464004 [label="¿Qué te da derecho a decirme que debo debo mandar todo al diablo?",shape=box,color=red];
		j1018464004 -> j252948575;
		j1018464004 -> j3713104122;
		j1018464004 -> j588981011;
	j1646697545 [label="Tal vez. Tal vez, no.",shape=box,color=red];
		j1646697545 -> j252948575;
		j1646697545 -> j3713104122;
		j1646697545 -> j588981011;
	j2953343786 [label="Estás simplificando demasiado la situación. Duviri fue -y *es*- mucho más que un simple \"lugar\".",shape=box,color=red];
		j2953343786 -> j252948575;
		j2953343786 -> j3713104122;
		j2953343786 -> j588981011;
	j1005531593 [label="y me han contado todo sobre el extraño y pequeño mundo salvaje en el que vivías",shape=box,color=blue];
		j1005531593 -> j843969546;
	j252948575 [label="Nunca has estado allí. No has pasado siglos allí. No has vivido ni muerto allí.",shape=box,color=red];
		j252948575 -> j1879100256;
		j252948575 -> j1062201783;
		j252948575 -> j2816880696;
	j3713104122 [label="Para ir al grano, Flare, ese lugar es... un reflejo de mí y del libro de cuentos en el que está basado.",shape=box,color=red];
		j3713104122 -> j1879100256;
		j3713104122 -> j1062201783;
		j3713104122 -> j2816880696;
	j588981011 [label="Aunque mis sentimientos al respecto no son exactamente… positivos… no puedo simplemente arrojarle la infestación y marcharme.",shape=box,color=red];
		j588981011 -> j1879100256;
		j588981011 -> j2816880696;
		j588981011 -> j1062201783;
	j1879100256 [label="Y por mucho que a veces me guste volver allí y golpear repetidamente a la gente en la cara... No es mi contenedor de basura.",shape=box,color=red];
		j1879100256 -> j1272233619;
	j1062201783 [label="Me guste o no... de alguna manera, estúpidamente, soy la persona responsable de ese lugar.",shape=box,color=red];
		j1062201783 -> j2750309964;
	j2816880696 [label="Tengo recuerdos tanto agradables como dolorosos.",shape=box,color=red];
		j2816880696 -> j2820478032;
	j1272233619 [label="Así que tampoco es tu contenedor de basura.",shape=box,color=red];
		j1272233619 -> j2894537455;
		j1272233619 -> j4272254868;
		j1272233619 -> j228828137;
	j2750309964 [label="Así que tengo que estar ahí para protegerlo cuando está en peligro.",shape=box,color=red];
		j2750309964 -> j228828137;
		j2750309964 -> j4272254868;
		j2750309964 -> j2894537455;
	j2820478032 [label="Y sólo porque quiero liberarme de él, no significa que quiera que sufra.",shape=box,color=red];
