	j3970236340 [label="supongamos que ese es el caso",shape=box,color=blue];
		j3970236340 -> j427630442;
	j427630442 [label="pero por lo que puedo deducir de los otros encantadores fenómenos...",shape=box,color=blue];
		j427630442 -> j3212510845;
	j3212510845 [label="hay un lugar donde la infestación *no está*",shape=box,color=blue];
		j3212510845 -> j3012530429;
	j3012530429 [label="un lugar donde podríamos encerrarla, y de donde *no podría* escapar…",shape=box,color=blue];
		j3012530429 -> j72055639;
		j3012530429 -> j1232373083;
	j72055639 [label="La verdad no me está gustando hacia donde está yendo esto, Flare... ¿De qué estás hablando?",shape=box,color=red];
		j72055639 -> j3595205820;
	j1232373083 [label="Si lo que estás diciendo es que la tiremos al Vacío... la respuesta es no.",shape=box,color=red];
		j1232373083 -> j2556301002;
	j3595205820 [label="no estoy hablando del vacío",shape=box,color=blue];
		j3595205820 -> j4131898690;
	j2556301002 [label="No sé qué tipo de presencia tiene la infestación en el Vacío, y no voy a hacer que eso empeore.",shape=box,color=red];
		j2556301002 -> j3595205820;
	j4131898690 [label="estoy hablando de duviri",shape=box,color=blue];
		j4131898690 -> j4287996927;
		j4131898690 -> j3868123126;
		j4131898690 -> j816796806;
	j4287996927 [label="Supongo que eso le *enseñaría* una lección a Thrax...",shape=box,color=red];
		j4287996927 -> j843969546;
	j3868123126 [label="QUÉ. ¡NO! ¡Absolutamente, no!",shape=box,color=red];
		j3868123126 -> j843969546;
	j816796806 [label="Yo... ¡¿cómo es que sabes sobre Duviri?!",shape=box,color=red];
		j816796806 -> j2021435138;
	j843969546 [label="parece que no le debes ningún favor después de lo que te hizo",shape=box,color=blue];
