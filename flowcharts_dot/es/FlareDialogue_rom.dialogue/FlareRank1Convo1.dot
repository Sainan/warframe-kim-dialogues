digraph {
	"FlareRank1Convo1 begins." [color=orange];
		"FlareRank1Convo1 begins." -> j1137491997;
	j1137491997 [label="ey, viajero espacial",shape=box,color=blue];
		j1137491997 -> j4011689550;
		j1137491997 -> j2130225830;
	j4011689550 [label="Ah, hola. ¿Flare, verdad?",shape=box,color=red];
		j4011689550 -> j1960511719;
	j2130225830 [label="Ey, ¿qué haces?",shape=box,color=red];
		j2130225830 -> j1381602049;
	j1960511719 [label="eres de quien me han estado hablando los otros experimentos científicos, ¿verdad?",shape=box,color=blue];
		j1960511719 -> j2495668439;
		j1960511719 -> j4143093789;
	j1381602049 [label="estoy aquí, sin nada mejor que hacer, y con un montón de preguntas para ti, si tienes tiempo",shape=box,color=blue];
		j1381602049 -> j1675937187;
		j1381602049 -> j849243738;
		j1381602049 -> j1842238070;
	j2495668439 [label="Cuesta pensar que haya dos como yo por aquí, pero... bueno... es una larga historia. En fin.",shape=box,color=red];
		j2495668439 -> j2858421623;
	j4143093789 [label="Depende de qué hayan dicho, pero... probablemente sí.",shape=box,color=red];
		j4143093789 -> j2124863460;
	j1675937187 [label="No tenías nada mejor que hacer, así que decidiste venir de visita al zoológico. Qué bien.",shape=box,color=red];
		j1675937187 -> j1145579833;
	j849243738 [label="¿En serio? ¿Nada mejor que hacer? Me halagas. Ja, ja, ja.",shape=box,color=red];
		j849243738 -> j3336910629;
	j1842238070 [label="Si quieres preguntarme algo, aquí estoy. Pregunta lo que quieras.",shape=box,color=red];
		j1842238070 -> j2821419722;
	j2858421623 [label="sí. bueno. me contaron lo básico.",shape=box,color=blue];
		j2858421623 -> j1786813800;
	j2124863460 [label="okey...",shape=box,color=blue];
		j2124863460 -> j3264390760;
		j2124863460 -> j1363842369;
	j1145579833 [label="+5 Chemistry",color=orange];
		j1145579833 -> j1039486249;
	j3336910629 [label="je, lo siento. eso sonó mal.",shape=box,color=blue];
		j3336910629 -> j1324015093;
	j2821419722 [label="genial",shape=box,color=blue];
		j2821419722 -> j1324015093;
	j1786813800 [label="amir tenía... algunos detalles que comunicar... bastante rápido.",shape=box,color=blue];
		j1786813800 -> j1679849820;
	j3264390760 [label="¿Has venido a tocar el vidrio del zoológico?",shape=box,color=red];
		j3264390760 -> j739741794;
	j1363842369 [label="¿Qué puedo hacer por ti?",shape=box,color=red];
		j1363842369 -> j1324015093;
	j1039486249 [label="oh, por Sol, nunca. lamento dar esa impresión. aunque supongo que tienes razón. los protoframes no somos los únicos experimentos científicos en la ciudad, ¿verdad?",shape=box,color=blue];
		j1039486249 -> j2318634101;
		j1039486249 -> j2672728911;
		j1039486249 -> j4231772671;
	j1324015093 [label="la infestación. esta podredumbre. esta cosa que está envenenando mi sangre. necesito saber todo lo que sabes",shape=box,color=blue];
		j1324015093 -> j3651895753;
	j1679849820 [label="muy... muy rápido...",shape=box,color=blue];
		j1679849820 -> j2850897917;
	j739741794 [label="+5 Chemistry",color=orange];
		j739741794 -> j3811924761;
	j2318634101 [label="Podría ser peor.",shape=box,color=red];
		j2318634101 -> j2093469328;
	j2672728911 [label="Supongo que es algo con lo que se aprende a vivir con el tiempo.",shape=box,color=red];
		j2672728911 -> j1957769530;
	j4231772671 [label="Nop.",shape=box,color=red];
		j4231772671 -> j891189291;
	j3651895753 [label="empezando desde el principio. si pudieras. por favor. *ahora*.",shape=box,color=blue];
		j3651895753 -> j2988955069;
	j2850897917 [label="Check boolean QuincySpaceTrauma",color=orange];
		j2850897917 -> j778654429 [label=true,color=green];
		j2850897917 -> j1268002507 [label=false,color=brown];
	j3811924761 [label="oh, por Sol, nunca. lamento dar esa impresión. aunque supongo que tienes razón. los protoframes no somos los únicos experimentos en la ciudad, ¿verdad?",shape=box,color=blue];
		j3811924761 -> j2318634101;
		j3811924761 -> j2672728911;
		j3811924761 -> j4231772671;
	j2093469328 [label="me *encantaría* saber exactamente cómo crees que podría ponerse peor que esto",shape=box,color=blue];
		j2093469328 -> j1138980363;
	j1957769530 [label="de eso quería hablarte, en realidad...",shape=box,color=blue];
		j1957769530 -> j1324015093;
	j891189291 [label="entonces, dime",shape=box,color=blue];
		j891189291 -> j4293204837;
	j2988955069 [label="Boolean FlareInfestation1 is now true.",color=orange];
		j2988955069 -> j697594315;
		j2988955069 -> j3869636066;
		j2988955069 -> j659868226;
	j778654429 [label="y el otro decía algo sobre el... ¿\"trauma espacial\", creo?",shape=box,color=blue];
		j778654429 -> j1268002507;
		j778654429 -> j1665856429;
	j1268002507 [label="Lol. Bueno, al menos podemos saltarnos las presentaciones.",shape=box,color=red];
		j1268002507 -> j3264390760;
		j1268002507 -> j1363842369;
	j1138980363 [label="ilumíname",shape=box,color=blue];
		j1138980363 -> j1465192194;
	j4293204837 [label="¿adónde fue? ¿entrati? los demás dicen que no lo saben. que tú tampoco lo sabes",shape=box,color=blue];
		j4293204837 -> j4044237323;
	j697594315 [label="No sé si me gusta tu actitud...",shape=box,color=red];
		j697594315 -> j242746134;
	j3869636066 [label="Eh... Eso va a llevar un tiempo y no creo que te dé las respuestas que quieres.",shape=box,color=red];
		j3869636066 -> j1378271826;
	j659868226 [label="Ey, espera. Retrocede. ¿Estás bien?",shape=box,color=red];
		j659868226 -> j3651979021;
	j1665856429 [label="Ah. Ese sería Quincy.",shape=box,color=red];
		j1665856429 -> j3264390760;
		j1665856429 -> j1363842369;
	j1465192194 [label="porque... por lo que sé, tengo un veneno en mi sangre que poco a poco está haciéndome perder la cabeza y corrompiendo mi cuerpo",shape=box,color=blue];
		j1465192194 -> j809201008;
	j4044237323 [label="yo digo que esas son tonterías",shape=box,color=blue];
		j4044237323 -> j2118634638;
	j242746134 [label="yo... me disculpo. normalmente no me gusta actuar así. sin embargo, estoy en una situación que es... muy difícil de describir",shape=box,color=blue];
		j242746134 -> j2066201251;
	j1378271826 [label="no se trata de que quiera respuestas, querido viajero espacial. se trata de que *necesito* respuestas",shape=box,color=blue];
		j1378271826 -> j3838810703;
	j3651979021 [label="no creo que pueda expresar con palabras qué tan mal estoy",shape=box,color=blue];
		j3651979021 -> j2066201251;
	j809201008 [label="y el único hombre que podía darme respuestas, el único hombre que podía explicármelo o deshacerse de ella... se ha *ido*",shape=box,color=blue];
		j809201008 -> j1702964281;
	j2118634638 [label="entonces me gustaría saber todo lo que sabes sobre él, si no te importa",shape=box,color=blue];
		j2118634638 -> j3254217347;
	j2066201251 [label="y te recuerdo que mi trabajo literalmente es poner mis sentimientos en palabras",shape=box,color=blue];
		j2066201251 -> j2532495665;
	j3838810703 [label="y no creo poder expresar con palabras cuán diferente es mi situación de la de los demás y cuánto *necesito* deshacerme de ella *inmediatamente*",shape=box,color=blue];
		j3838810703 -> j2494476293;
		j3838810703 -> j141755852;
		j3838810703 -> j2171549922;
		j3838810703 -> j2051007061;
