		j3254217347 -> j659868226;
		j3254217347 -> j3869636066;
	j2532495665 [label="así que simplemente lo diré como es: cometí un error al ponerme esta extraña inyección",shape=box,color=blue];
		j2532495665 -> j3644614686;
	j2494476293 [label="¿Ella?",shape=box,color=red];
		j2494476293 -> j1325581109;
	j141755852 [label="Lo que estás viviendo no es diferente a lo que vivieron los Hex. No te ha pasado sólo a ti.",shape=box,color=red];
		j141755852 -> j2810822471;
	j2171549922 [label="Entiendo por lo que estás pasando. Puedo ayudarte.",shape=box,color=red];
		j2171549922 -> j2667360821;
	j2051007061 [label="Sé que lo que ha pasado es aterrador: convertirse en un protoframe, la situación aquí en Höllvania...",shape=box,color=red];
		j2051007061 -> j957836184;
	j3601344302 [label="Quise decir que hay cosas peores en el mundo que ser visto como un fenómeno. ¡Pfff!",shape=box,color=red];
		j3601344302 -> j1102206608;
	j3644614686 [label="no sé qué ayuda necesitas, qué sobornos, qué favores debo hacerte, pero *necesito* deshacerme de ella *ahora*",shape=box,color=blue];
