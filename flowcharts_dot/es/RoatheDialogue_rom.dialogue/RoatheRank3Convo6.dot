		j2539663690 -> j2923599089 [label=true,color=green];
		j2539663690 -> j3550965979 [label=false,color=brown];
	j3144522459 [label="Quizás haya esperanza en lo que dices. O quizás me estoy engañando y se trata sólo de un respiro.",shape=box,color=blue];
		j3144522459 -> j172570375;
	j3941693471 [label="Sí, lo fue. O al menos, lo que recuerdo. ¿O es eso lo que me arrebataste, Usurpador? ¿Que éramos amantes, que te confesé mi amor y que tú no sentías lo mismo?",shape=box,color=blue];
		j3941693471 -> j2593473403;
	j2961284552 [label="Admito que sí. Al menos lo que recuerdo. ¿Te sorprendería saber que nunca he estado enamorado? Al menos no de forma mutua. Creo. Después de todo, probablemente ya hemos pasado por todo esto.",shape=box,color=blue];
		j2961284552 -> j1660274166;
	j2254854213 [label="Lo fue. Larga y solitaria. Pero es culpa mía, Usurpador. No estoy aquí para ganarme tu compasión ni tu lástima.",shape=box,color=blue];
		j2254854213 -> j3615745997;
	j2628666130 [label="Admito que sí. Al menos lo que recuerdo. ¿Te sorprendería saber que nunca he estado enamorado? Pero es culpa mía, Usurpador. No estoy aquí para ganarme tu compasión ni tu lástima.",shape=box,color=blue];
		j2628666130 -> j1890507746;
	j2923599089 [label="¿Quién sabe? Quizás tenía amigos y no los recuerdo porque éramos amigos antes de que terminaras con todo eso, ¿eh?",shape=box,color=blue];
		j2923599089 -> j3242585699;
	j3550965979 [label="¿Quién sabe? Quizás tenía amigos y simplemente no los recuerdo porque Entrati se metió en mi cabeza y me robó los recuerdos.",shape=box,color=blue];
		j3550965979 -> j3242585699;
	j2593473403 [label="¿O fue al revés? Te enamoraste perdidamente del mismísimo Diablo, pero su corazón permaneció frío contigo. Y en tu desesperación, hiciste lo único que podías hacer: ¡destrozarle la mente!",shape=box,color=blue];
