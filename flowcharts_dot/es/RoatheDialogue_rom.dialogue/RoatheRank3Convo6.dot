	j4104667645 [label="¿Por qué pasas tanto tiempo con los Cavia, Roathe?",shape=box,color=red];
		j4104667645 -> j918605615;
	j898033943 [label="Aléjate de los Cavia, Roathe. Me pongo nervioso.",shape=box,color=red];
		j898033943 -> j4231897262;
	j202800200 [label="[Fin]",shape=box,color=red];
		j202800200 -> "Chat ends.";
	j918605615 [label="¿Hm? Bueno, me parecen de las creaciones más tristes y patéticas que he conocido en todo el maldito Sistema Origen. ",shape=box,color=blue];
		j918605615 -> j558099869;
	j4231897262 [label="Para evitar malentendidos en esta situación, evitaré mi verbosidad habitual y simplemente diré esto: ",shape=box,color=blue];
		j4231897262 -> j532529743;
	"Chat ends." [color=orange];
	j558099869 [label="Son animales de laboratorio. ¡Animales de laboratorio, Albrecht! Arrojaste animales al maldito Vacío y luego, cuando salieron parloteando en tu idioma infantil inventado, ¡le dijiste a tu mayordomo que los sacrificara!",shape=box,color=blue];
		j558099869 -> j1418477582;
	j532529743 [label="No.",shape=box,color=blue];
		j532529743 -> "Chat ends.";
	j1418477582 [label="Siempre dejando que los demás hagan su trabajo sucio. Pero me estoy desviando. Me preguntas por qué me siento a hablar con ellos. Sobre todo con el pájaro. Es simple. Pero creo que me gustaría que lo adivinaras. Quiero ver si podrías descubrirlo.",shape=box,color=blue];
		j1418477582 -> j3096789829;
		j1418477582 -> j2442767184;
		j1418477582 -> j908439853;
		j1418477582 -> j3034937943;
		j1418477582 -> j451463120;
	j3096789829 [label="Él no sabe quién eres.",shape=box,color=red];
		j3096789829 -> j3970738674;
	j2442767184 [label="Bird 3 ama a todos.",shape=box,color=red];
		j2442767184 -> j33152535;
	j908439853 [label="Te gusta rodearte de personas que te hagan sentir inteligente.",shape=box,color=red];
		j908439853 -> j2016538453;
	j3034937943 [label="Tiene un agudo sentido de observación de las personas que le rodean.",shape=box,color=red];
		j3034937943 -> j21846930;
	j451463120 [label="Es fácil de manipular.",shape=box,color=red];
		j451463120 -> j2016538453;
	j3970738674 [label="Sí. En cierto modo, es precisamente eso. No sabe quién soy. No sabe nada del \"Diablo de Tau\". Y además... no le importa.",shape=box,color=blue];
		j3970738674 -> j1920012210;
	j33152535 [label="Sí. Es encantador en su inocencia despreocupada. Pero lo que dices, de forma un poco más amable y directa, es que nadie más podría amarme, ¿es eso?",shape=box,color=blue];
		j33152535 -> j1392627921;
	j2016538453 [label="Ojalá entendieras que te equivocas. Que tu flecha se desvió mucho del objetivo... pero no sólo tú piensas así de mí.",shape=box,color=blue];
		j2016538453 -> j1435820307;
	j21846930 [label="Así es. Y sus observaciones son muy útiles, pero nada que yo no hubiera podido lograr en unos pocos minutos.",shape=box,color=blue];
		j21846930 -> j2020727658;
	j1920012210 [label="+10 Chemistry",color=orange];
		j1920012210 -> j1348962465;
	j1392627921 [label="¿Así que tengo que conformarme con la compañía de ese pájaro idiota? Pero estás bastante cerca de la verdad, así que supongo que te daré... un diez, aprobado.",shape=box,color=blue];
		j1392627921 -> j1348962465;
	j1435820307 [label="No sólo tú.",shape=box,color=blue];
		j1435820307 -> j3705997063;
	j2020727658 [label="Lo que dices, de forma un poco más amable y directa, es que crees que estoy usando al pájaro parlante para mis propios fines. ¿Es eso?",shape=box,color=blue];
		j2020727658 -> j391014873;
	j1348962465 [label="Para él, no soy Roathe. No soy orokin. No soy un criminal. Ni un traidor. Ni un cobarde. Puedo ser simplemente... yo mismo.",shape=box,color=blue];
		j1348962465 -> j884869370;
	j3705997063 [label="Boolean RoatheAlone1 is now true.",color=orange];
		j3705997063 -> j4081414586;
	j391014873 [label="No. Pero no eres el único que opina eso de mí. No sólo eres tú.",shape=box,color=blue];
		j391014873 -> j3705997063;
	j884869370 [label="No creo poder describir qué alivio tan sencillo y raro es...",shape=box,color=blue];
		j884869370 -> j1449844381;
		j884869370 -> j2676495794;
		j884869370 -> j1517885677;
	j4081414586 [label="+5 Chemistry",color=orange];
		j4081414586 -> "Chat ends.";
	j1449844381 [label="Puedes dejarlo todo, ¿sabes? Puedes cambiar. Incluso aquí, incluso ahora.",shape=box,color=red];
		j1449844381 -> j2812310792;
	j2676495794 [label="Debe ser una carga terrible lidiar con las expectativas sobre tu reputación dondequiera que vayas, incluso aquí.",shape=box,color=red];
		j2676495794 -> j2904933092;
	j1517885677 [label="¿Estás insinuando que el resto de esto es algún tipo de espectáculo que montas?",shape=box,color=red];
		j1517885677 -> j1052642503;
	j2812310792 [label="Add 2 to Thermostat counter",color=orange];
		j2812310792 -> j3282545824;
	j2904933092 [label="Add -1 to Thermostat counter",color=orange];
		j2904933092 -> j4700842;
	j1052642503 [label="¡Ojalá fuera tan simple y que todo esto fuera una gran fachada que pudiera cambiar como una máscara! No, Usurpador. Esto es lo que soy, hasta la médula.",shape=box,color=blue];
		j1052642503 -> j1361773660;
	j3282545824 [label="Ojalá fuera tan sencillo, Usurpador. Lo haces parecer tan tentador. ¿Puedo? Quizás... quizás no sea demasiado tarde, ni siquiera para un demonio triste y trágico como yo.",shape=box,color=blue];
		j3282545824 -> j1214472380;
	j4700842 [label="+10 Chemistry",color=orange];
		j4700842 -> j3848507187;
	j1361773660 [label="Pero eso no significa que no aprecie la oportunidad de relajarme durante una hora y simplemente disfrute de una conversación con alguien que no sabe nada sobre todos los terribles crímenes que he cometido en mi vida.",shape=box,color=blue];
		j1361773660 -> j172570375;
	j1214472380 [label="+10 Chemistry",color=orange];
		j1214472380 -> j567656927;
	j3848507187 [label="Es agotador, Usurpador. Ojalá pudiera despojarme de esta personalidad como de una máscara que uno se quita para no volver a ponérsela. Pero esto es lo que soy, hasta la médula de mis podridos huesos.",shape=box,color=blue];
		j3848507187 -> j1361773660;
	j172570375 [label="Boolean RoatheBirdThree is now true.",color=orange];
		j172570375 -> j1951100654;
		j172570375 -> j3135993305;
	j567656927 [label="¿Es sólo una fachada o está enterrado en lo más profundo de mi ser? Aún no lo sé. Sólo puedo decir que aprecio la oportunidad de desconectarme por una hora cada que tengo la oportunidad.",shape=box,color=blue];
		j567656927 -> j3358641532;
	j1951100654 [label="Perdón si esto parece grosero pero... suena a que has tenido una vida solitaria.",shape=box,color=red];
		j1951100654 -> j2902082429;
	j3135993305 [label="No estás acostumbrado a tener muchos amigos ¿verdad?",shape=box,color=red];
		j3135993305 -> j2539663690;
	j3358641532 [label="Dejé la carga a un lado y me senté con alguien que no sabía nada de mis terribles crímenes y conversé con el pájaro gigante, encantador y tonto, y me encontré... en paz. Por primera vez en mucho tiempo.",shape=box,color=blue];
		j3358641532 -> j3144522459;
	j2902082429 [label="Evaluate expressions",color=orange];
		j2902082429 -> j3941693471 [label="RoatheUnloved1, RoatheKnowsReset2",color=purple];
