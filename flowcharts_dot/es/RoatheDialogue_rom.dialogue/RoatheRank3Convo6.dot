	j2723469035 [label="Me pregunto, ¿eso es lo que me arrebataste, Usurpador? ¿Que éramos amantes, que te confesé mi amor y que tú no sentías lo mismo?",shape=box,color=blue];
		j2723469035 -> j2593473403;
	j3605304817 [label="Merezco cualquier mala opinión que tengas de mí. Y ciertamente no sólo tú la tienes. No sólo tú.",shape=box,color=blue];
		j3605304817 -> "Chat ends.";
	j3816602685 [label="Qué trágico, en verdad... Casi quiero conocer todos los detalles, pero siento que eso es saltar al final del libro antes de que estemos listos.",shape=box,color=blue];
		j3816602685 -> j2212759805;
	j2840056053 [label="¡¿Pero a quién engaño?! Sabemos por qué lo hiciste, ¿no? Y no fue por amor a mí. Fue por amor a alguien más. Simplemente estoy hablando poéticamente.",shape=box,color=blue];
