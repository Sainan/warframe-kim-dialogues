	1607 [label="You are. I just don't trust you.",shape=box,color=red];
		1607 -> 1621;
	1608 [label="No. I am what I am. I am who I am. I walk the path I have chosen and I am past the point of wishing to apologize for myself. I will not change what I am to suit the opinions of others.",shape=box,color=blue];
		1608 -> 1622;
	1609 [label="This was a trait I saw in many of the poorest of the Executors and the Emperors - blind faith in only their own faultless and guiltless selves. I despised them for it and vowed I would never share such egotistical hubris.",shape=box,color=blue];
		1609 -> 1622;
	1610 [label="I only ever truly dabbled with partners of the physical sense, Drifter. I never had emotional ones. None that were ever mutual, at any rate.",shape=box,color=blue];
		1610 -> 1623;
		1610 -> 1624;
	1611 [label="+5 Chemistry",color=orange];
		1611 -> 1625;
	1612 [label="I'll take that to heart.",shape=box,color=red];
		1612 -> 1626;
	1613 [label="I wasn't planning on it, but thank you for the advice.",shape=box,color=red];
		1613 -> 1627;
	1614 [label="The fact that you have never experienced such a thing makes you exceedingly lucky, Usurper. I do not recommend finding yourself in such an arrangement, it usually ends in murder for one or both of you.",shape=box,color=blue];
		1614 -> 1628;
