	1507 [label="Si hubiéramos fracasado espectacularmente, simplemente habría comido un pedazo de Lex y fin del asunto.",shape=box,color=blue];
		1507 -> 1511;
	1508 [label="Y para cada uno, había definido un resultado. Y para cada uno, sabía lo que pretendía hacer. Muchos eran similares en líneas generales, pero diferían en los detalles.",shape=box,color=blue];
		1508 -> 1512;
	1510 [label="¿Qué te he contado ya sobre esto? Porque me doy cuenta de que aún no confío lo suficiente en ti como para decírtelo abiertamente.",shape=box,color=blue];
		1510 -> 1515;
		1510 -> 1516;
