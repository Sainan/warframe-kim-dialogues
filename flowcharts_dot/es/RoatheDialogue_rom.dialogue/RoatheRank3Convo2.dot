		1482 -> 1488;
	1484 [label="Lo único que lamento es que nunca se hiciera realidad. Lamento el tiempo perdido.",shape=box,color=blue];
		1484 -> 1490;
	1485 [label="¡Y vaya obra maestra, Usurpador!",shape=box,color=blue];
		1485 -> 1490;
	1486 [label="Práctico. Pero la mayoría de los lugares donde \"escondí\" mis provisiones probablemente... se han perdido con el paso de los años.",shape=box,color=blue];
		1486 -> 1491;
	1489 [label="Sí, sí. Supongo que deberíamos continuar esta absurda conversación donde volvemos una y otra vez a nuestras discusiones anteriores.",shape=box,color=blue];
		1489 -> 1493;
	1487 [label="+5 Chemistry",color=orange];
		1487 -> 1492;
	1488 [label="Sí, probablemente pensaste que tus acciones quedarían impunes. En fin, sigamos con esta conversación inútil sobre nosotros mismos y luego pasemos a otra cosa.",shape=box,color=blue];
		1488 -> 1493;
	1490 [label="+5 Chemistry",color=orange];
		1490 -> 1494;
	1491 [label="And many of the locations were secret even to me. The plan was beyond intricate. Layers upon layers upon layers deep.",shape=box,color=blue];
		1491 -> 1495;
	1493 [label="What was your question again? Ah! Yes. \"How was I planning on overthrowing the Executors?\" ",shape=box,color=blue];
		1493 -> 1496;
	1492 [label="By retreading the same pointless conversations about why I wanted to murder people who are long since dead and dust? At least it is the pragmatic approach.",shape=box,color=blue];
		1492 -> 1493;
	1494 [label="The plan was beyond intricate. Layers upon layers upon layers deep. Assassins who would kill the assassins of other assassins should the first assassin fail.",shape=box,color=blue];
		1494 -> 1497;
	1495 [label="Assassins who would kill the assassins of other assassins should the first assassin fail.",shape=box,color=blue];
