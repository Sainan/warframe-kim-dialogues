		1562 -> 1565;
		1562 -> 1566;
	1563 [label="Pero sí. Se podría decir que Nitokh y yo teníamos una relación... compleja.",shape=box,color=blue];
		1563 -> 1569;
		1563 -> 1568;
		1563 -> 1567;
		1563 -> 1565;
		1563 -> 1566;
	1565 [label="¿Te importaba ella?",shape=box,color=red];
		1565 -> 1570;
	1566 [label="¿La amabas?",shape=box,color=red];
		1566 -> 1571;
	1567 [label="¿Confiabas en ella?",shape=box,color=red];
		1567 -> 1572;
	1568 [label="No te arrepientas de lo que hiciste. Tomaste tus decisiones. No hay vuelta atrás. Sólo puedes ir hacia adelante.",shape=box,color=red];
		1568 -> 1573;
	1569 [label="Lo único que podemos hacer para compensar lo que hicimos antes es mirar hacia adelante con lucidez.",shape=box,color=red];
		1569 -> 1574;
	1564 [label="Después de todo, ella era la Gran Nitokh. Una ejecutora.",shape=box,color=blue];
		1564 -> 1561;
	1570 [label="¡Por el Vacío, no! Si se hubiera ido borracha una tarde por una esclusa de aire, habría resuelto muchos de mis malditos problemas.",shape=box,color=blue];
		1570 -> 1575;
	1571 [label="+5 Chemistry",color=orange];
		1571 -> 1576;
	1572 [label="¡Por el Vacío, no! Nunca confíes en un orokin, Viajero. Incluyéndome a mí. ¡Sobre todo a mí! Ámanos, ódianos, adóranos, desprécianos, pero jamás confíes en nosotros.",shape=box,color=blue];
		1572 -> 1577;
	1573 [label="Add -1 to Thermostat",color=orange];
		1573 -> 1578;
	1574 [label="Add 1 to Thermostat",color=orange];
		1574 -> 1579;
	1575 [label="La despreciaba total y absolutamente, y no había nada que me hubiera gustado más que pelar esa piel suya con cuidado, con delicadeza, lentamente... usando mis propias manos.",shape=box,color=blue];
		1575 -> 1580;
		1575 -> 1581;
	1576 [label="¡Qué pregunta tan impertinente! Creo que te adoro por hacerla. Sabes, creo que sí la amaba, sólo un poquito. Honestamente, hasta ahora, jamás había pensado en eso.",shape=box,color=blue];
		1576 -> 1582;
