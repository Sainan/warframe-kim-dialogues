	1603 [label="Mm, although, it will never be a problem with you, will it? You have your eye set far closer to home with that mad priest, don't you?",shape=box,color=blue];
		1603 -> 1616;
	1605 [label="+5 Chemistry",color=orange];
		1605 -> 1619;
	1606 [label="No. Sorry. You aren't my type.",shape=box,color=red];
