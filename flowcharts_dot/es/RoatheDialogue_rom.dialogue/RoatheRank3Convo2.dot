		1567 -> 1572;
	1568 [label="Don't regret what you did. You made your choices. There's no going back. Only forward.",shape=box,color=red];
		1568 -> 1573;
	1569 [label="The only thing we can do is make up for what we've done before is to look ahead with clear eyes.",shape=box,color=red];
		1569 -> 1574;
	1564 [label="She was the Great Nitokh after all. An Executor.",shape=box,color=blue];
		1564 -> 1561;
	1570 [label="Void, no! If she drunkenly wandered out an airlock one afternoon it would have solved a great deal of my damnable problems.",shape=box,color=blue];
		1570 -> 1575;
	1571 [label="+5 Chemistry",color=orange];
		1571 -> 1576;
	1572 [label="Void, no! Never trust an Orokin, Drifter. Including me. Especially me! Love us, hate us, adore us, despise us - but never, ever trust us.",shape=box,color=blue];
		1572 -> 1577;
	1573 [label="Add -1 to Thermostat",color=orange];
		1573 -> 1578;
	1574 [label="Add 1 to Thermostat",color=orange];
		1574 -> 1579;
	1575 [label="I absolutely, positively despised her, and I would have adored nothing more than to slowly, carefully, gently peel her blue skin off her body with my bare hands.",shape=box,color=blue];
		1575 -> 1580;
		1575 -> 1581;
	1576 [label="What an impertinent question! I think I adore you for asking it. You know, I think I did love her, just a little. I have honestly not even stopped to ponder that until right this moment.",shape=box,color=blue];
		1576 -> 1582;
