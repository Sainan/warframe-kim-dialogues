	1549 [label="Difícilmente. Pero algo que debes entender sobre los orokin es que siempre hemos conspirado unos contra otros. ",shape=box,color=blue];
		1549 -> 1550;
	1550 [label="Sabía que Nitokh me mataría sin dudarlo en cualquier momento si eso pudiera ayudarle aunque sea un poco a lograr sus objetivos.",shape=box,color=blue];
		1550 -> 1558;
	1551 [label="Creo que disfrutó del desafío, Usurpador. La sensación de peligro. La emoción de saber que se acostaba con alguien que la quería muerta.",shape=box,color=blue];
		1551 -> 1559;
	1552 [label="Me gustaría decir que fuimos los primeros orokin en encontrarnos en tal situación, pero en realidad ni siquiera era raro.",shape=box,color=blue];
		1552 -> 1559;
	1554 [label="¡Exactamente! Es casi como si ya lo hubieras oído antes. Pero no tenía nada de sorprendente. Ella me provocaba con ello frecuentemente.",shape=box,color=blue];
		1554 -> 1543;
		1554 -> 1544;
	1553 [label="¡Exactamente! Pero no tenía nada de sorprendente. Ella lo había previsto y me provocaba con ello frecuentemente.",shape=box,color=blue];
		1553 -> 1543;
		1553 -> 1544;
	1557 [label="Obviamente no nos consideraba iguales. Ella era una ejecutora. La Gran Nitokh. Pero yo me veía como el primero entre sus subordinados.",shape=box,color=blue];
		1557 -> 1561;
	1555 [label="Eres adorable. Sí, en cierto modo, éramos socios comerciales. Pero también lo éramos en muchos otros aspectos más importantes.",shape=box,color=blue];
		1555 -> 1556;
	1556 [label="En la guerra. En la política. En la intriga. En la cama.",shape=box,color=blue];
		1556 -> 1560;
	1558 [label="Sin embargo, ella sabía que yo afilaba mis cuchillos a sus espaldas y que esperaba ansiosamente el momento en que le separaría la cabeza de los hombros.",shape=box,color=blue];
		1558 -> 1562;
	1559 [label="Cuanto más vivo, más me doy cuenta de que tal vez no hayamos sido una especie diseñada para la inmortalidad.",shape=box,color=blue];
		1559 -> 1563;
