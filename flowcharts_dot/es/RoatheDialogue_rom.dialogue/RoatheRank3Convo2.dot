		1472 -> 1476 [label=false,color=brown];
	1473 [label="Me pregunto si te arrepientes de algo, sinceramente. Si querrías volver atrás y cambiar algo de tus planes.",shape=box,color=red];
		1473 -> 1478;
	1474 [label="Me fascina la idea de cómo debió ser diseñar un plan como ese. Debió ser una obra maestra.",shape=box,color=red];
