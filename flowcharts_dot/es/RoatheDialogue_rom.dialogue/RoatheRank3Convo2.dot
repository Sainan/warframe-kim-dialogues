		1561 -> 1565;
		1561 -> 1566;
		1561 -> 1567;
		1561 -> 1568;
		1561 -> 1569;
	1560 [label="Pero me pregunto si lo estaré recordando bien. Me pregunto si \"socio\" no será una exageración para describir lo que realmente éramos. ",shape=box,color=blue];
		1560 -> 1564;
	1562 [label="Podríamos decir que teníamos una relación… compleja.",shape=box,color=blue];
		1562 -> 1569;
