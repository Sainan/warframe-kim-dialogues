		1590 -> 1605 [label="false",color=purple];
	1591 [label="Mm, yes. I get the sense I am not precisely winning you over with my \"devilish charm,\" am I?",shape=box,color=blue];
		1591 -> 1606;
		1591 -> 1607;
	1592 [label="What point is there, reliving our past deeds, our past failures and regrets? We cannot change them - even with this gift of time travel, it is only a path to madness to attempt to \"redo\" that which has been \"done.\"",shape=box,color=blue];
		1592 -> 1608;
	1593 [label="But neither can we forget the misdeeds of our former selves, for we risk becoming nothing but madmen and despots, belligerent creatures who see no fault within ourselves and only within others.",shape=box,color=blue];
		1593 -> 1609;
	1594 [label="Do you have those thoughts about all your lovers? or just her?",shape=box,color=red];
		1594 -> 1610;
	1595 [label="No apology necessary. I'm just still shocked at how much you hated your own people.",shape=box,color=red];
		1595 -> 1611;
	1596 [label="I simply recommend that you do not make such relationships a permanent affair. It becomes wildly unhealthy for both parties. It usually ends in murder for one or both of you.",shape=box,color=blue];
		1596 -> 1594;
		1596 -> 1612;
		1596 -> 1613;
	1597 [label="How can both of those things be true at the same time?",shape=box,color=red];
