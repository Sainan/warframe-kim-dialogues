		1584 -> 1591;
	1585 [label="Puede que tengas razón. Vivir en el pasado es peligroso, pues cargamos con el arrepentimiento, la vergüenza y nada más. ",shape=box,color=blue];
		1585 -> 1592;
	1586 [label="Puede que tengas razón. Vivir en el pasado es peligroso, pues cargamos con el arrepentimiento, la vergüenza y nada más. ",shape=box,color=blue];
		1586 -> 1593;
	1587 [label="Imaginarlo fue lo único que me permitió soportar muchas de mis... noches obligatorias en su cama. Me disculpo.",shape=box,color=blue];
		1587 -> 1594;
		1587 -> 1595;
	1588 [label="El hecho de que creas que ambas cosas son mutuamente excluyentes es realmente adorable. Espero que algún día tengas la oportunidad de pasar una velada con un \"conocido\" así, es realmente mágico.",shape=box,color=blue];
		1588 -> 1596;
	1589 [label="Debes entender que también estaba ensombrecido por un odio profundo y abrumador. La despreciaba al mismo tiempo y no había nada que me hubiera gustado más que pelar esa piel suya con cuidado, con delicadeza, lentamente... usando mis propias manos.",shape=box,color=blue];
		1589 -> 1597;
		1589 -> 1598;
	1590 [label="Evaluate expressions",color=orange];
