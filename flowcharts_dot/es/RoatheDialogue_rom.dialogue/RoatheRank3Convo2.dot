		1582 -> 1589;
	1583 [label="Noted.",shape=box,color=red];
		1583 -> 1590;
	1584 [label="That wasn't going to be a problem.",shape=box,color=red];
		1584 -> 1591;
	1585 [label="You may be right. Living in the past is dangerous, for we saddle ourselves with regret and shame and nothing else. ",shape=box,color=blue];
		1585 -> 1592;
	1586 [label="You may be right. Living in the past is dangerous, for we saddle ourselves with regret and shame and nothing else. ",shape=box,color=blue];
		1586 -> 1593;
	1587 [label="Picturing it in my mind was the only thing that allowed me to suffer through many of my... mandatory evenings in her bed. I apologize.",shape=box,color=blue];
		1587 -> 1594;
		1587 -> 1595;
	1588 [label="The fact that you believe those two things are mutually exclusive is positively adorable. I hope you have the opportunity to experience an evening with such an \"acquaintance\" someday, it is fairly magical.",shape=box,color=blue];
		1588 -> 1596;
	1589 [label="You must understand, it was also clouded over with the deepest and most extremely overwhelming hatred as well. I despised her in the same breath and I would have adored nothing more than to slowly, carefully, gently peel her blue skin off her body with my bare hands.",shape=box,color=blue];
