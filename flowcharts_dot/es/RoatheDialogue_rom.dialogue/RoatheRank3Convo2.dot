		1598 -> 1615;
	1601 [label="Sólo pensé en avisarte, dado nuestro pequeño... arreglo.",shape=box,color=blue];
		1601 -> 1618;
	1600 [label="Mmm, pero eso nunca será un problema para ti, ¿verdad? Tienes la mirada puesta en Marie, de ahí nuestro pequeño \"arreglo\".",shape=box,color=blue];
		1600 -> 1617;
	1599 [label="Mm, aunque nunca será un problema contigo, ¿verdad? Tienes la mirada puesta en ese sacerdote loco, ¿verdad?",shape=box,color=blue];
		1599 -> 1616;
	1602 [label="Sólo pensé en avisarte, ya que ya has dejado en claro tus... intereses.",shape=box,color=blue];
		1602 -> 1618;
	1604 [label="Mm, aunque nunca será un problema contigo, ¿verdad? Tienes la mirada puesta en Marie, ¿verdad?",shape=box,color=blue];
