		1598 -> 1615;
	1601 [label="I simply thought I should give you the fair warning, seeing as we have our little... arrangement.",shape=box,color=blue];
		1601 -> 1618;
	1600 [label="Mm, although, it will never be a problem with you, will it? You have your eye set far closer to home with Marie in our little \"arrangement.\"",shape=box,color=blue];
