		1481 -> 1487;
	1482 [label="Aún me arrepiento de haber traicionado tu confianza, Roathe. Aunque no lo creas, esa no era mi intención.",shape=box,color=red];
		1482 -> 1488;
	1484 [label="Lo único que lamento es que nunca se hiciera realidad. Lamento el tiempo perdido.",shape=box,color=blue];
		1484 -> 1490;
	1485 [label="¡Y vaya obra maestra, Usurpador!",shape=box,color=blue];
		1485 -> 1490;
	1486 [label="Práctico. Pero la mayoría de los lugares donde \"escondí\" mis provisiones probablemente... se han perdido con el paso de los años.",shape=box,color=blue];
		1486 -> 1491;
	1489 [label="Sí, sí. Supongo que deberíamos continuar esta absurda conversación donde volvemos una y otra vez a nuestras discusiones anteriores.",shape=box,color=blue];
		1489 -> 1493;
	1487 [label="+5 Chemistry",color=orange];
		1487 -> 1492;
	1488 [label="Sí, probablemente pensaste que tus acciones quedarían impunes. En fin, sigamos con esta conversación inútil sobre nosotros mismos y luego pasemos a otra cosa.",shape=box,color=blue];
		1488 -> 1493;
	1490 [label="+5 Chemistry",color=orange];
		1490 -> 1494;
	1491 [label="Y muchas de las ubicaciones eran secretas incluso para mí. El plan era sumamente complejo. Muchas facetas, unas más profundas que otras.",shape=box,color=blue];
		1491 -> 1495;
	1493 [label="¿Cuál era tu pregunta? ¡Ah! Sí. \"¿Cómo planeaba derrocar a los ejecutores?\" ",shape=box,color=blue];
		1493 -> 1496;
	1492 [label="¿Repitiendo las mismas conversaciones inútiles sobre por qué quería asesinar a personas que murieron hace mucho tiempo y que se convirtieron en polvo? Al menos ese es un enfoque pragmático.",shape=box,color=blue];
		1492 -> 1493;
	1494 [label="El plan era extremadamente complejo. Tenía múltiples facetas. Los asesinos debían eliminar a los asesinos de otros asesinos si el primero fallaba.",shape=box,color=blue];
		1494 -> 1497;
	1495 [label="Los asesinos debían eliminar a los asesinos de otros asesinos si el primero fallaba.",shape=box,color=blue];
