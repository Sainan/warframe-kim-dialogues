		1506 -> 1510 [label=true,color=green];
		1506 -> 1509 [label=false,color=brown];
	1507 [label="If we failed spectacularly, I would have simply eaten the end of a Lex and called it a day.",shape=box,color=blue];
		1507 -> 1511;
	1508 [label="And for each one, I had laid out a result. And for each one, I knew what I intended to do. Many were similar in the broad strokes of things, but were dissimilar in the details.",shape=box,color=blue];
		1508 -> 1512;
	1510 [label="What have I told you before about it? Because I find I do not yet trust you enough to tell you outright.",shape=box,color=blue];
		1510 -> 1515;
		1510 -> 1516;
	1509 [label="It was a complex matter of some... great negotiation between us.",shape=box,color=blue];
		1509 -> 1513;
		1509 -> 1514;
