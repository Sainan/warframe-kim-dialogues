	1518 [label="¿Habrías aceptado simplemente la muerte?",shape=box,color=red];
		1518 -> 1525;
	1519 [label="Si el éxito era moderado, que era lo más probable, habría sido necesaria una limpieza para asegurar que todos los hilos sueltos se \"arreglaran\". Naturalmente, yo era uno de ellos. Y había tomado medidas para garantizar que seguiría siendo lo suficientemente valioso a corto plazo como para no ser eliminado junto con los demás.",shape=box,color=blue];
		1519 -> 1526;
