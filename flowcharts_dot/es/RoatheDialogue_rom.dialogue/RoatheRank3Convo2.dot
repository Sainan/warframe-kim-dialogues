	1468 [label="¿Por qué me preguntas esto? ¿Qué intentas averiguar, Viajero? Desde luego, no intentas averiguar dónde está la munición.",shape=box,color=blue];
		1468 -> 1470;
	1469 [label="¿Por qué? ¿Planeas viajar en el tiempo y batir tu propio récord de joven? ¿Necesitas consejos para derrocar un gobierno totalitario? ¿Buscas la ubicación de municiones enterradas que podrían destruir planetas enteros?",shape=box,color=blue];
