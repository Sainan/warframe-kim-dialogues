	1608 [label="No. Soy lo que soy. Soy quien soy. Camino por el camino que he elegido y ya no quiero disculparme. No cambiaré lo que soy para adaptarme a las opiniones de los demás.",shape=box,color=blue];
		1608 -> 1622;
	1609 [label="Observé este rasgo en muchos de los más desdichados ejecutores y emperadores: una fe ciega en sí mismos, considerándose irreprochables e inocentes. Los desprecié por ello y juré no compartir jamás un orgullo tan desmedido.",shape=box,color=blue];
