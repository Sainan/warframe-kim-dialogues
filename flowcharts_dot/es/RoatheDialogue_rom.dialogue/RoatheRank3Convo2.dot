		1496 -> 1474;
		1496 -> 1475;
	1497 [label="Bombs laid in multiple buildings, whole ships and an entire moon rigged to detonate with stolen explosives. A solar rail ready to fall out of orbit.",shape=box,color=blue];
		1497 -> 1498;
	1498 [label="And all of it rigged to look like a \"Great Sentient Disaster\" when the time came. Nitokh and I would declare the Empire in a state of emergency once the Executors and Emperors were... dealt with.",shape=box,color=blue];
