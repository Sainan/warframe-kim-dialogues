	1602 [label="I simply thought I should give you the fair warning, seeing as you have made your... interests known.",shape=box,color=blue];
		1602 -> 1618;
	1604 [label="Mm, although, it will never be a problem with you, will it? You have your eye set far closer to home with Marie, don't you?",shape=box,color=blue];
