		1496 -> 1475;
	1497 [label="Bombas ocultas en varios edificios, naves espaciales y una luna llena cargada con explosivos robados. Un raíl solar listo para salir de órbita.",shape=box,color=blue];
		1497 -> 1498;
	1498 [label="Y todo esto se hizo de forma maquiavélica para crear la ilusión de una \"gran catástrofe consciente\" cuando llegara el momento. Nitokh y yo habríamos declarado el estado de emergencia en el imperio una vez que los ejecutores y los emperadores... fueran neutralizados.",shape=box,color=blue];
