	1591 [label="Mm, sí. Tengo la sensación de que no te estoy conquistando precisamente con mi \"encanto diabólico\", ¿o sí?",shape=box,color=blue];
		1591 -> 1606;
		1591 -> 1607;
	1592 [label="¿Qué sentido tiene revivir nuestras acciones, nuestros fracasos y arrepentimientos pasados? No podemos cambiarlos, incluso con este don de viajar en el tiempo, intentar \"rehacer\" lo que ya está \"hecho\" sólo lleva a la locura.",shape=box,color=blue];
		1592 -> 1608;
	1593 [label="Pero tampoco podemos olvidar las malas acciones de nuestro pasado, pues corremos el riesgo de convertirnos en nada más que locos y déspotas, criaturas beligerantes que no ven faltas en sí mismos pero sí en los demás.",shape=box,color=blue];
		1593 -> 1609;
	1594 [label="¿Tienes esos pensamientos sobre todos tus amantes o sólo sobre ella?",shape=box,color=red];
		1594 -> 1610;
	1595 [label="No hace falta disculparse. Todavía me sorprende lo mucho que odiabas a tu propia gente.",shape=box,color=red];
		1595 -> 1611;
	1596 [label="Simplemente recomiendo no hacer de este tipo de relaciones una relación permanente. Se vuelve muy perjudicial para ambas partes. Suele acabar con la muerte de uno o ambos.",shape=box,color=blue];
		1596 -> 1594;
		1596 -> 1612;
		1596 -> 1613;
	1597 [label="¿Cómo pueden ser ciertas ambas cosas al mismo tiempo?",shape=box,color=red];
