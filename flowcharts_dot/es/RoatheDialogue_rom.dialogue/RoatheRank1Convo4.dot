digraph {
	graph [fontname="Roboto Condensed"];
	node [fontname="Roboto Condensed"];
	edge [fontname="Roboto Condensed"];

	"RoatheRank1Convo4 begins." [color=orange];
		"RoatheRank1Convo4 begins." -> j86368880;
	j86368880 [label="Check boolean LoidFamilyComplete",color=orange];
		j86368880 -> j424039479 [label=true,color=green];
		j86368880 -> j3073090712 [label=false,color=brown];
	j424039479 [label="Es casi trágico en qué se han convertido Euleria y Petros. Nunca fuimos amigos, ojo. Pero seguían siendo orokin. Y ahora quedamos muy pocos. Aunque supongo que debería tener cuidado con lo que digo; quién sabe en qué podría convertirme con el tiempo.",shape=box,color=blue];
		j424039479 -> j4104752354;
	j3073090712 [label="Me resulta hilarante que Euleria y Petros no tengan ni idea de que estamos aquí abajo. Como ratas, correteando a sus pies. ¿Cómo has conseguido mantener todo esto en secreto con los peques durante tanto tiempo?",shape=box,color=blue];
		j3073090712 -> j348115237;
	j4104752354 [label="El que menos me sorprende que haya sobrevivido es \"Abuela\". (Imagínense, regalar un nombre tan bueno como Dagath).",shape=box,color=blue];
		j4104752354 -> j3558439169;
		j4104752354 -> j238529768;
	j348115237 [label="Evaluate expressions on HellStory counter",color=orange];
		j348115237 -> j696736950 [label="x >= 21",color=purple];
		j348115237 -> j64875156 [label="x < 21",color=purple];
		j348115237 -> j64875156 [label="false",color=purple];
	j3558439169 [label="¿Petros?",shape=box,color=red];
		j3558439169 -> j3728709011;
	j238529768 [label="¿Qué opinas de los niños?",shape=box,color=red];
		j238529768 -> j1222410370;
	j696736950 [label="Aunque, sinceramente, me sorprende mucho más que ·\"Abuela\" no lo haya deducido (¡imagínate, deshacerte de un nombre tan bueno como Dagath!). Pensaba que era más inteligente.",shape=box,color=blue];
		j696736950 -> j3217211917;
	j64875156 [label="Aunque, sinceramente, me sorprende mucho más que \"Abuela\" no lo haya deducido (¡imagínate, deshacerte de un nombre tan bueno como Dagath!). Pensaba que era más inteligente.",shape=box,color=blue];
		j64875156 -> j3649900895;
		j64875156 -> j2945295478;
	j3728709011 [label="¿Hm? Ah. El necroloide me informó que tú o el niño anduvieron por ahí ayudándoles a inventarse nombres falsos, pues habían olvidado los suyos. Lo conoces como \"Vilcor\".",shape=box,color=blue];
		j3728709011 -> j3596279376;
	j1222410370 [label="El chico es caprichoso, irritante y egocéntrico. Un orokin perfecto. A \"Kaelli\", como prefiere que la llamen ahora, la encuentro extraordinariamente inteligente y casi digna de soportar.",shape=box,color=blue];
		j1222410370 -> j278567672;
	j3217211917 [label="Esto es absurdo. Sé que ya hemos hablado de esto antes. Y ya lo hemos comentado. Lo cual sigue siendo un asunto profundamente preocupante.",shape=box,color=blue];
		j3217211917 -> j2782860910;
	j3649900895 [label="Tienen sus propios... problemas en los que centrarse.",shape=box,color=red];
		j3649900895 -> j1185426142;
	j2945295478 [label="¿Petros?",shape=box,color=red];
		j2945295478 -> j3688976473;
	j3596279376 [label="Pero yo lo conocía como Petros Vorten, el orgulloso inventor de la Flota Necramech. Es extraño pensar en cuánto tiempo ha pasado para él y lo poco que ha pasado —relativamente hablando— para mí.",shape=box,color=blue];
		j3596279376 -> j278567672;
	j278567672 [label="Pero ¿cómo es que no lo sabes ya? ¿Acaso me estás tomando el pelo, Usurpador? Ciertamente, no somos más que... ¿repitiendo lo mismo de siempre?",shape=box,color=blue];
		j278567672 -> j139011919;
	j2782860910 [label="Evaluate expressions",color=orange];
		j2782860910 -> j150325788 [label="RoatheDatingDeal",color=purple];
		j2782860910 -> j150325788 [label="RoatheMarieDatingDeal",color=purple];
		j2782860910 -> j150325788 [label="RoatheLyonDatingDeal",color=purple];
		j2782860910 -> j150325788 [label="RoatheSerumDeal",color=purple];
		j2782860910 -> j1501761534 [label="RoatheFamilyDeal",color=purple];
		j2782860910 -> j150325788 [label="RoatheMarieEntratiDeal",color=purple];
		j2782860910 -> j150325788 [label="RoatheLyonConfessionDeal",color=purple];
		j2782860910 -> j2275697993 [label="false",color=purple];
	j1185426142 [label="Check /Lotus/Scripts/1999/DialogueScriptNodes.lua:IsSyndicateRank(syndicate=EntratiSyndicate, syndicateRank=5)",color=orange];
		j1185426142 -> j2239409922 [label=true,color=green];
		j1185426142 -> j1194664916 [label=false,color=brown];
	j3688976473 [label="Check /Lotus/Scripts/1999/DialogueScriptNodes.lua:IsSyndicateRank(syndicate=EntratiSyndicate, syndicateRank=5)",color=orange];
		j3688976473 -> j1214623644 [label=true,color=green];
		j3688976473 -> j3824864723 [label=false,color=brown];
	j139011919 [label="Boolean RoatheKnowsReset is now true.",color=orange];
		j139011919 -> j3631368127;
		j139011919 -> j202544429;
		j139011919 -> j2504380799;
	j150325788 [label="Aquí estoy, listo para lanzar una disertación crepuscular y divagante sobre la sociedad Orokin, pensando que podría resultarte vagamente interesante. Pero luego recuerdo: no estás aquí para eso, ¿verdad, Viajero? Tienes otro juego que jugar...",shape=box,color=blue];
		j150325788 -> j139011919;
	j1501761534 [label="Aquí estoy, listo para lanzarme a una disertación crepuscular y divagante sobre la sociedad Orokin, pensando que tal vez te interese vagamente. Y entonces recuerdo: Seguramente ya has oído todo esto, ¿verdad?",shape=box,color=blue];
		j1501761534 -> j139011919;
	j2275697993 [label="¿Prefieres que simplemente te siga la corriente? ¿O... persigues algún objetivo concreto con esto? Me desconcierta por completo qué esperas ganar jugando a este juego tan cruel.",shape=box,color=blue];
		j2275697993 -> j743150560;
	j2239409922 [label="Sí, eso me ha comentado el necraloide. Aunque parece que tienen menos desde que tú o el niño trabajaron para resolverlo. Al menos ya no se están autolesionando —literalmente—.",shape=box,color=blue];
		j2239409922 -> j3572873736;
	j1194664916 [label="Check boolean RoatheSyndicateMaxRank",color=orange];
		j1194664916 -> j2239409922 [label=true,color=green];
		j1194664916 -> j788583566 [label=false,color=brown];
	j1214623644 [label="¿Hm? Ah. El necraloide me informó que tú o el niño anduvieron por ahí ayudándoles a inventarse nombres falsos, pues habían olvidado los suyos. Tú lo conoces como \"Vilcor\". Pero yo lo conocía como Petros Vorten, el orgulloso inventor de la Flota Necramech.",shape=box,color=blue];
		j1214623644 -> j3572873736;
	j3824864723 [label="Check boolean RoatheSyndicateMaxRank",color=orange];
		j3824864723 -> j1214623644 [label=true,color=green];
		j3824864723 -> j3697850355 [label=false,color=brown];
	j3631368127 [label="No, no he oído esto antes. Por favor, continúa.",shape=box,color=red];
		j3631368127 -> j1868504535;
	j202544429 [label="Te hablo a ti, Roathe... porque quiero hablar contigo.",shape=box,color=red];
		j202544429 -> j862518501;
	j2504380799 [label="Sí, ya lo he oído antes. Pero por favor, repítelo de todos modos.",shape=box,color=red];
		j2504380799 -> j2935813232;
	j743150560 [label="Boolean RoatheKnowsReset is now true.",color=orange];
		j743150560 -> j3142175076;
	j3572873736 [label="Evaluate expressions",color=orange];
		j3572873736 -> j2074465988 [label="RoatheDeal",color=purple];
		j3572873736 -> j3248870218 [label="RoatheNoDeal",color=purple];
		j3572873736 -> j3248870218 [label="false",color=purple];
	j788583566 [label="Sí, eso me ha contado el necraloide. Parece que siguen empeñados en autodestruirse.",shape=box,color=blue];
		j788583566 -> j3930011928;
	j3697850355 [label="¿Hm? Ah. Lo conocía como Petros Vorten, el orgulloso inventor de la Flota Necramech. Pero el necraloide me informó que han olvidado sus nombres. Quizás aún lo conozcas solo como \"Padre\".",shape=box,color=blue];
		j3697850355 -> j3930011928;
	j1868504535 [label="+5 Chemistry",color=orange];
		j1868504535 -> j722200526;
	j862518501 [label="Check boolean DrifterRoathe",color=orange];
		j862518501 -> j1721494804 [label=true,color=green];
		j862518501 -> j2948576598 [label=false,color=brown];
	j2935813232 [label="Así que admites que me haces perder el tiempo. ¡Qué maravilla! No soy un viejo cascarrabias que cuenta una única saga bélica porque no recuerda ninguna otra.",shape=box,color=blue];
		j2935813232 -> j487141875;
	j3142175076 [label="Aquí estoy, listo para lanzarme a una disertación crepuscular y divagante sobre la sociedad Orokin, pensando que tal vez te interese vagamente. Y entonces recuerdo: Seguramente ya has oído todo esto, ¿verdad?",shape=box,color=blue];
		j3142175076 -> j3631368127;
		j3142175076 -> j202544429;
		j3142175076 -> j2504380799;
	j2074465988 [label="Lo cual es bueno, ya que no habríamos avanzado mucho sin que usted o el niño completaran ese paso primero. Me temo que, de lo contrario, el mayordomo habría acabado hecho picadillo en cuanto lo hubiéramos mandado subir esas escaleras.",shape=box,color=blue];
		j2074465988 -> j1323321622;
	j3248870218 [label="Por cierto, ¿has reconsiderado mi propuesta? ¿Que me quede aquí sentado en silencio a cambio de ayudarte a reconciliar al mayordomo con los marginados orokin infestados y abandonados del piso de arriba?",shape=box,color=blue];
		j3248870218 -> j1790706524;
		j3248870218 -> j1440247416;
	j3930011928 [label="Evaluate expressions",color=orange];
		j3930011928 -> j440786749 [label="RoatheDeal",color=purple];
		j3930011928 -> j3024160822 [label="RoatheNoDeal",color=purple];
		j3930011928 -> j3024160822 [label="false",color=purple];
	j722200526 [label="Has pedido hablar a un orokin. No sabes lo que has hecho. Si no tienes cuidado, estarás aquí toda una hora.",shape=box,color=blue];
		j722200526 -> j2338953051;
	j1721494804 [label="+5 Chemistry",color=orange];
		j1721494804 -> j3084806755;
	j2948576598 [label="¿Ah, sí? Y, por favor, dime, ¿por qué?",shape=box,color=blue];
		j2948576598 -> j195255110;
		j2948576598 -> j1973018533;
		j2948576598 -> j2106311276;
		j2948576598 -> j3058488918;
	j487141875 [label="¡La razón por la que no puedo recordar esta conversación está en tu maldito espejo!",shape=box,color=blue];
		j487141875 -> "Chat ends.";
	j1323321622 [label="Una cosa que debes comprender es que el mayordomo y la familia Entrati, por muy alejados que estén, siguen siendo orokin. Nacieron y se criaron en esa sociedad, con todos sus... muchos defectos.",shape=box,color=blue];
		j1323321622 -> j3952652643;
	j1790706524 [label="No, no voy a cambiar de opinión, Roathe. No es tan importante.",shape=box,color=red];
		j1790706524 -> j1737931792;
	j1440247416 [label="Lo he hecho. Yo... Estoy de acuerdo.",shape=box,color=red];
		j1440247416 -> j1789785021;
	j440786749 [label="Lo cual quizás quieras resolver primero, antes de que intentemos subir al mayordomo por esas escaleras. No vaya a ser que acabe hecho picadillo en el intento.",shape=box,color=blue];
		j440786749 -> j1323321622;
	j3024160822 [label="Por cierto, ¿has reconsiderado mi propuesta? ¿Que me quede aquí sentado en silencio a cambio de ayudarte a reconciliar al mayordomo con los marginados orokin infestados y abandonados del piso de arriba? Reconciliar a la familia sería el primer paso, pero...",shape=box,color=blue];
		j3024160822 -> j1790706524;
		j3024160822 -> j1440247416;
	j2338953051 [label="Aunque supongo que no has tenido muchas oportunidades de interactuar con los orokin, ¿verdad, Viajero? El niño vivió una vida muy diferente.",shape=box,color=blue];
		j2338953051 -> j1564967828;
	j3084806755 [label="Mm. Así es. Y ambos sabemos por qué, ¿verdad? Pero tendrás que tener paciencia.",shape=box,color=blue];
		j3084806755 -> j1137325571;
	j195255110 [label="[Confesar sentimientos.] Creo que ya lo sabes.",shape=box,color=red];
		j195255110 -> j2480783049;
	j1973018533 [label="Me resultas fascinante.",shape=box,color=red];
		j1973018533 -> j1753333810;
	j2106311276 [label="Nunca tuve muchas oportunidades de interactuar con un orokin. Cuando... no estaba luchando contra ellos, claro. Eres fascinante.",shape=box,color=red];
		j2106311276 -> j1479991327;
	j3058488918 [label="No importa. [Fin]",shape=box,color=red];
		j3058488918 -> j854620543;
	"Chat ends." [color=orange];
	j3952652643 [label="Y a pesar de todos sus graves pecados, el rango y el orden jamás se cuestionaron. Ni en el ámbito militar ni en la estructura social. Los arquimedianos obedecían a los orokin. Los orokin obedecían a los Ejecutores. Los Ejecutores obedecían a los Emperadores... bueno, al menos de nombre.",shape=box,color=blue];
		j3952652643 -> j502201242;
	j1737931792 [label="Haz lo que quieras. La puerta no permanecerá abierta por mucho tiempo.",shape=box,color=blue];
		j1737931792 -> "Chat ends.";
	j1789785021 [label="Boolean RoatheNoDeal is now false.",color=orange];
		j1789785021 -> j189594155;
	j1564967828 [label="Por lo que he oído decir, te desviaste justo en el momento de la tragedia de la Zariman Diez-Cero.",shape=box,color=blue];
		j1564967828 -> j2271282089;
		j1564967828 -> j1571455516;
		j1564967828 -> j2905014886;
	j1137325571 [label="Mientras tanto, si deseas \"escuchar\", con gusto lo haré. Solo una advertencia: le has pedido a un orokin que hable.",shape=box,color=blue];
		j1137325571 -> j4144646899;
	j2480783049 [label="+5 Chemistry",color=orange];
		j2480783049 -> j1553894509;
	j1753333810 [label="+5 Chemistry",color=orange];
		j1753333810 -> j4247813699;
	j1479991327 [label="¿Conocer al enemigo, entonces? ¿O tal vez solo curiosidad por sentarse al otro lado de la mesa, en un plano de imposibilidad? ",shape=box,color=blue];
		j1479991327 -> j1329738443;
	j854620543 [label="Retuércete todo lo que quieras, pez. Tú nadaste hacia mí.",shape=box,color=blue];
		j854620543 -> "Chat ends.";
	j502201242 [label="Y si aún no crees que, de alguna manera, incluso después de tanto tiempo, las tradiciones puedan inspirar a Loid a escucharme, considera que puedo ser... profundamente convincente. Al fin y al cabo, fui la mano derecha del peor de los Ejecutores.",shape=box,color=blue];
		j502201242 -> j3075094918;
		j502201242 -> j749922228;
		j502201242 -> j2744624384;
	j189594155 [label="Boolean RoatheDeal is now true.",color=orange];
		j189594155 -> j4098246064;
	j2271282089 [label="No. Nunca tuve mucho trato con los orokin antes de la Zariman, y después... bueno... seguro que ya oyes lo esencial.",shape=box,color=red];
		j2271282089 -> j1464587368;
	j1571455516 [label="He tenido suficientes tratos con los orokin como para saber que no debo confiar en ellos ni un pelo.",shape=box,color=red];
		j1571455516 -> j2965708004;
	j2905014886 [label="Lamento decirlo, pero no siento más cariño por gente como tú que el peque.",shape=box,color=red];
		j2905014886 -> j2965708004;
	j4144646899 [label="No sabes lo que has hecho. Si no tienes cuidado, estarás aquí toda una hora.",shape=box,color=blue];
		j4144646899 -> j2338953051;
	j1553894509 [label="Sí, lo creo. Y yo que pensaba que me ibas a hacer el honor de dejármelo ver por escrito. En fin...",shape=box,color=blue];
		j1553894509 -> j2900687707;
	j4247813699 [label="¿En serio? Hm. Ya veremos cuánto tiempo puedo mantener este pez en el arpón.",shape=box,color=blue];
		j4247813699 -> j1137325571;
	j1329738443 [label="+5 Chemistry",color=orange];
		j1329738443 -> j3158971502;
	j3075094918 [label="El peor de los Ejecutores fue Ballas.",shape=box,color=red];
		j3075094918 -> j2637654664;
	j749922228 [label="¿Cuál serviste?",shape=box,color=red];
		j749922228 -> j3317686772;
	j2744624384 [label="¿Cómo?",shape=box,color=red];
		j2744624384 -> j2154683933;
	j4098246064 [label="+5 Chemistry",color=orange];
		j4098246064 -> j691980365;
	j1464587368 [label="Sí, lo he hecho. Ah, Ballas. Quizá te sorprenda saber que no era el peor de ellos.",shape=box,color=blue];
		j1464587368 -> j471689273;
		j1464587368 -> j2074951238;
	j2965708004 [label="Tampoco creo culparte. Pensé que se podían recuperar. Fundir, por así decirlo, reformar, refundir, como el oro.",shape=box,color=blue];
		j2965708004 -> j3009704094;
	j2900687707 [label="En otra ocasión, tal vez. Como tú, Usurpador, debes aprender a saborear estos momentos.",shape=box,color=blue];
		j2900687707 -> j1673080089;
	j3158971502 [label="Respetable. Incluso sabio. Si hubiera tenido la oportunidad de entrevistar, y tal vez hasta entablar amistad, con un Consciente, habría hecho lo mismo. ",shape=box,color=blue];
		j3158971502 -> j4291164034;
	j2637654664 [label="Respeto tu opinión y no te la reprocho. Ballas era un cretino y un ejemplo de depravación; no voy a discutir contigo sobre eso.",shape=box,color=blue];
		j2637654664 -> j1510068736;
	j3317686772 [label="Evaluate expressions on HellStory counter",color=orange];
		j3317686772 -> j3101193377 [label="x >= 1",color=purple];
		j3317686772 -> j308058876 [label="x <= 1",color=purple];
		j3317686772 -> j308058876 [label="false",color=purple];
	j2154683933 [label="Entiendo que has tenido tratos personales con Ballas, y no te culpo por creer que era lo peor que los Siete Señores Dorados podían ofrecer. Y era un campeón entre los depravados, no voy a discutirlo contigo.",shape=box,color=blue];
		j2154683933 -> j3062874800;
	j691980365 [label="¡Maravilloso! Me alegra que por fin hayas entrado en razón. Ahora sí podemos avanzar.",shape=box,color=blue];
		j691980365 -> j1323321622;
	j471689273 [label="¿En serio?",shape=box,color=red];
		j471689273 -> j3625316289;
	j2074951238 [label="Te costaría mucho hacerme creer eso.",shape=box,color=red];
		j2074951238 -> j3625316289;
	j3009704094 [label="Bueno. Aparte de los Ejecutores. Eran un caso perdido. Quizás les sorprenda saber que Ballas no era el peor de ellos.",shape=box,color=blue];
		j3009704094 -> j2074951238;
		j3009704094 -> j471689273;
	j1673080089 [label="Boolean DrifterRoathe is now true.",color=orange];
		j1673080089 -> j1137325571;
	j4291164034 [label="Proporciona una ventaja psicológica en caso de que alguna vez te encuentres con uno, o incluso con tu antiguo aliado, en el campo de batalla.",shape=box,color=blue];
		j4291164034 -> j3467131873;
	j1510068736 [label="Y, de hecho, no presencié el horror de este asunto \"Narmer\" del que me enteré por el mayordomo y que he podido deducir de los registros de esta máquina POM-2.",shape=box,color=blue];
		j1510068736 -> j510670433;
	j3101193377 [label="Ya me habéis oído hablar de ella. Y, lo que es más importante, insinuar lo que planeábamos. Pero esa es otra historia. La Ejecutora Nitokh. La Gran Regente Ejecutora Nitokh, para ser exactos. Comandante de todas nuestras fuerzas militares, y el más cruel y letal de los Siete Señores Dorados.",shape=box,color=blue];
		j3101193377 -> j102703647;
	j308058876 [label="Ejecutora Nitokh. Gran Regente Ejecutora Nitokh, para ser precisos. Comandante de todas las fuerzas militares del Imperio Orokin. Y la más cruel y letal de los Siete Señores Dorados.",shape=box,color=blue];
		j308058876 -> j102703647;
	j3062874800 [label="Incluso es muy posible que haya superado a los antiguos Ejecutores durante este... asunto de \"Narmer\" del que he oído hablar al mayordomo y del que he leído en este POM-2.",shape=box,color=blue];
		j3062874800 -> j510670433;
	j3625316289 [label="No digo que fuera un santo. Digo que el peor de los demonios solo fue superado ligeramente por sus iguales. Es una distinción mínima, Usurpador.",shape=box,color=blue];
		j3625316289 -> j3514650235;
	j3467131873 [label="Bueno, si deseas \"escuchar\", con gusto lo haré. Simplemente, una advertencia: le has pedido a un orokin que hable.",shape=box,color=blue];
		j3467131873 -> j4144646899;
	j510670433 [label="Sin embargo, también sugeriría que esta impresión se debe a tu proximidad personal a Ballas y a tus interacciones muy limitadas con los otros seis Señores Dorados.",shape=box,color=blue];
		j510670433 -> j102703647;
	j102703647 [label="Los Siete Dorados. Bah. ¿Sabes qué es lo mejor del oro, Viajero? Que se puede fundir una y otra vez y transformar en algo mejor.",shape=box,color=blue];
		j102703647 -> j3218935322;
	j3514650235 [label="Pero ¿fue Ballas el peor? Para ti, tal vez. Y quizá sus crímenes en esta época superaron a los de los antiguos Ejecutores.",shape=box,color=blue];
		j3514650235 -> j228705034;
	j3218935322 [label="Creía —y en cierto modo, aún creo— que los orokin eran rescatables. Que podríamos haber salvado al Imperio. ¿Pero los Ejecutores? No. Había que detenerlos. Eran, en mayor o menor medida, lo peor que la humanidad podía ofrecer.",shape=box,color=blue];
		j3218935322 -> j3656133930;
	j228705034 [label="Pero si hubieras contemplado los lagos carmesí y los campos de cadáveres deformados y fragmentados, como tantos juguetes infantiles desechados...",shape=box,color=blue];
		j228705034 -> j2915506062;
	j3656133930 [label="Y esto lo digo yo, Usurpador. Permítanme, pues, que yo, este mismísimo Diablo de Tau, les asegure —como experto que soy— que Ballas no era el peor de todos.",shape=box,color=blue];
		j3656133930 -> j581353866;
	j2915506062 [label="Si hubieras visto la devastación que Nitokh podía causar con apenas pensarlo un instante... ",shape=box,color=blue];
		j2915506062 -> j4263310856;
	j581353866 [label="Check boolean RoatheUsurper",color=orange];
		j581353866 -> j3547926363 [label=true,color=green];
		j581353866 -> j2830288282 [label=true,color=green];
		j581353866 -> j3582346654 [label=false,color=brown];
		j581353866 -> j3547926363 [label=false,color=brown];
		j581353866 -> j2830288282 [label=false,color=brown];
	j4263310856 [label="Pero tales horrores son difíciles de comprender a menos que se presencien. Una tragedia así no se entiende con cifras. Podría extenderme sobre lo que he visto, pero para ustedes, simplemente serán eso: historias.",shape=box,color=blue];
		j4263310856 -> j946829142;
	j3547926363 [label="Te costaría mucho hacerme creer eso.",shape=box,color=red];
		j3547926363 -> j3262787111;
	j2830288282 [label="¿En serio?",shape=box,color=red];
		j2830288282 -> j3262787111;
	j3582346654 [label="¿Por qué sigues llamándome \"Usurpador\"?",shape=box,color=red];
		j3582346654 -> j416674931;
	j946829142 [label="Para ti, Ballas siempre será el malhechor mucho más presente y aterrador. Y así es de esperar.",shape=box,color=blue];
		j946829142 -> j1120328501;
	j3262787111 [label="Si hubieras contemplado los lagos carmesí y los campos de cadáveres deformados y fragmentados, como tantos juguetes infantiles desechados...",shape=box,color=blue];
		j3262787111 -> j2915506062;
	j416674931 [label="¡Ah! Eso es lo que eres, ¿verdad? Los tenno usurparon el Sistema Origen de los orokin. Y tú, como un pequeño impostor en el nido, te has colado en este mundo desde el tuyo.",shape=box,color=blue];
		j416674931 -> j1775089552;
	j1120328501 [label="Pero hay mucho de él que desconoces. Ya se ha dicho demasiado sobre ese cretino. Y me temo que aún queda mucho por decir.",shape=box,color=blue];
		j1120328501 -> j2402721562;
		j1120328501 -> j2670575345;
	j1775089552 [label="Y eso te convierte, al menos por dos razones, en un usurpador a mi juicio. (Y quizás por una tercera, si contamos lo que el mayordomo me ha contado de Duviri, pero ese es un debate para otro momento).",shape=box,color=blue];
		j1775089552 -> j1815114264;
	j2402721562 [label="¿Cómo qué?",shape=box,color=red];
		j2402721562 -> j540177881;
	j2670575345 [label="No me interesa escuchar nada sobre la vida de Ballas.",shape=box,color=red];
		j2670575345 -> j1399205834;
	j1815114264 [label="No me distraigas, Usurpador. Entiendo que te cueste creerme, pero si hubieras contemplado los lagos carmesí y los campos de cadáveres deformados y fragmentados, como tantos juguetes infantiles desechados...",shape=box,color=blue];
		j1815114264 -> j4093618383;
	j540177881 [label="Boolean RoatheBallas1 is now true.",color=orange];
		j540177881 -> j3190729990;
	j1399205834 [label="Sí, claro. Bueno, supongo que tendrán que aguantar historias de mi vida. Qué gracioso.",shape=box,color=blue];
		j1399205834 -> j82261769;
	j4093618383 [label="Boolean RoatheUsurper is now true.",color=orange];
		j4093618383 -> j2915506062;
	j3190729990 [label="Es una historia muy larga. Una para la que no tengo tiempo ahora mismo. El mayordomo me vigila. Y detesto que me vigilen.",shape=box,color=blue];
		j3190729990 -> j2453448816;
	j82261769 [label="+5 Chemistry",color=orange];
