	609 [label="Me resulta terriblemente fascinante que conspiraras conmigo para... forjar mi propio camino. El diablo, por así decirlo, se las ingenia para manipularme.",shape=box,color=blue];
		609 -> 619;
	608 [label="¿Cómo va el progreso por tu parte, mi Usurpador? Afanosamente muevo los hilos y las palancas a tu favor, aunque mi influencia sea invisible e imperceptible hasta ahora.",shape=box,color=blue];
		608 -> 619;
	610 [label="Dime que has cambiado de opinión sobre mi oferta. Donde antes quizá te ofrecía resistencia, respecto a tus... ¿ambientes románticos? Ahora seré tan dócil como un terrisco de nieve. Mmm. A menos que eso no sea lo que deseas. Tú decides.",shape=box,color=blue];
		610 -> 620;
	611 [label="Dime si has cambiado de opinión sobre mi oferta. Puedo resolver este problema con Marie. Asegúrate de que alcances tus metas románticas con ella fácilmente.",shape=box,color=blue];
		611 -> 620;
	612 [label="Dime que has cambiado de opinión sobre mi oferta. Puedo resolver este problema de Lyon. Asegúrate de que logres tus objetivos románticos con él sin problemas.",shape=box,color=blue];
		612 -> 620;
	613 [label="Dime que has cambiado de opinión sobre mi oferta. Donde antes podría haber sido una barrera de resistencia, con respecto a mi... ¿toma del suero? Seré tan dócil como un terrisco de nieve.",shape=box,color=blue];
		613 -> 620;
	614 [label="Dime que has cambiado de opinión sobre mi oferta. Donde antes podría haber sido una barrera de resistencia, reuniendo al mayordomo y a su familia, seré tan dócil como un terrisco de nieve.",shape=box,color=blue];
		614 -> 620;
	615 [label="Dime si has cambiado de opinión sobre mi oferta... puedo resolver este problema con Marie. Asegurar que puedas navegar tus conversaciones con ella fácilmente.",shape=box,color=blue];
		615 -> 620;
	616 [label="Dime si has cambiado de opinión sobre mi oferta... puedo resolver este problema con Lyon. Asegurar que puedas navegar tus conversaciones con el fácilmente.",shape=box,color=blue];
		616 -> 620;
	617 [label="No puedo evitar pensar que te quedas en estas conversaciones por algo, Usurpador. Y que quizás pueda ayudarte en algo.",shape=box,color=blue];
