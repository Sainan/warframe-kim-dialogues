		737 -> 752;
	739 [label="Ah, sí, de hecho. Lo ofendiste mortalmente en cuanto entraste aquí. Simplemente no he tenido el valor de decírtelo.",shape=box,color=blue];
		739 -> 754;
		739 -> 755;
