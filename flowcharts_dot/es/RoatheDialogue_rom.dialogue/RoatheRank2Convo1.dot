	640 [label="Espero de verdad que no me hagas arrepentirme de esto, Roathe. Bien. De acuerdo.",shape=box,color=red];
		640 -> 664;
	644 [label="\"Hasta ahora.\" Intrigante. ¿Y de verdad todos estamos volviendo sobre nuestros pasos, como cortesanos que repiten los pasos de un baile? ¿Una y otra vez, condenados a repetirnos?",shape=box,color=blue];
		644 -> 668;
		644 -> 669;
	645 [label="Supongo que lo sabrías, ¿no? Es curioso que sea tan predecible. Es bueno saber que incluso con alguien tan destrozado como él, todavía se puede contar con él de vez en cuando.",shape=box,color=blue];
		645 -> 670;
	646 [label="¿No lo sabes ya? Mmm. Quizás no llegaste tan lejos. O no se te ocurrió preguntar la primera o la vigésima milésima vez en este pequeño reto.",shape=box,color=blue];
		646 -> 670;
	647 [label="Ah. ¿Y una cosa más, antes de que me olvide?",shape=box,color=blue];
		647 -> 671;
	649 [label="¿Cómo le vendiste tu alma al diablo dos veces... y te aseguraste de que te llevara a mi cama? ¿O me buscas el corazón, Usurpador? Mm. Ya veremos. Pero con el tiempo.",shape=box,color=blue];
		649 -> 672;
	650 [label="Cuando llegue el momento, me aseguraré de que tengas el camino libre para cortejar a nuestro pequeño adulador flotante, el Usurpador. Considéralo resuelto.",shape=box,color=blue];
		650 -> 673;
	651 [label="Cuando llegue el momento, me aseguraré de que tu camino esté despejado para cortejar al pobre sacerdote destrozado, Usurpador. Considéralo resuelto.",shape=box,color=blue];
		651 -> 674;
	652 [label="Cuando llegue el momento, recordaré esto. Si volvemos a discrepar sobre mis recuerdos, no repetiremos tus errores anteriores.",shape=box,color=blue];
		652 -> 675;
	655 [label="Cuando llegue el momento, me aseguraré de que el pequeño mayordomo suba esas escaleras. Considérelo resuelto.",shape=box,color=blue];
		655 -> 678;
	654 [label="Considera que tu problema con Marie y su adoración aduladora hacia Entrati ya está resuelto. Cuando llegue el momento, me encargaré de ello.",shape=box,color=blue];
		654 -> 677;
	653 [label="Considera tu problema con Lyon y sus horrores resuelto, Usurpador. Cuando llegue el momento, me encargaré de ello.",shape=box,color=blue];
		653 -> 676;
	648 [label="Parece que... he olvidado qué buscabas. La culpa es de que te entrometieras en mis recuerdos. ¿Qué era?",shape=box,color=blue];
		648 -> 626;
	656 [label="Yo aconsejaría simplemente tener paciencia, pero... lejos de mí está aconsejarte que uses un cincel cuando tienes un pico láser al lado.",shape=box,color=blue];
		656 -> 679;
	657 [label="Mmm. Ya veo. Una empresa noble, a decir verdad. Una que yo mismo he intentado muchísimas veces. Y en la que he fracasado igualmente.",shape=box,color=blue];
		657 -> 680;
	658 [label="Mm.",shape=box,color=blue];
