	740 [label="Precisamente. No estoy seguro de si uno de esos kaithes primitivos le dio una patada en la cabeza cuando era niña, o si realmente le faltan figuras paternas, no lo sé.",shape=box,color=blue];
		740 -> 757;
	741 [label="Como una especie de figura paterna, quizás. O una figura sagrada. No estoy seguro de si alguno de esos kaithes primitivos de su época le dio una patada en la cabeza de niña, o si carecía de mentores, lo ignoro.",shape=box,color=blue];
		741 -> 757;
