	662 [label="Ya veo. Te ofrecí un trato, y por alguna razón no pudiste cumplirlo, así que viste cómo tu premio se desvanecía.",shape=box,color=blue];
		662 -> 685;
	665 [label="Cuando habla, generalmente lo hace en dos categorías: terriblemente estúpido o terriblemente loco.",shape=box,color=blue];
		665 -> 688;
	666 [label="¿Mmm? ¿Has escapado ya? Te envidio muchísimo. No tardarás en verte atrapado en el radio de la explosión, así que mejor que estés avisado.",shape=box,color=blue];
		666 -> 689;
	667 [label="Mi pobre Viajero. ¿Has olvidado cuán estrictamente los orokin rechazábamos cualquier idea de deidades sagradas? Lo único que adorábamos era a nosotros mismos.",shape=box,color=blue];
		667 -> 690;
	663 [label="Como quieras. Te advierto que esta decisión tuya no se puede deshacer sin consecuencias.",shape=box,color=blue];
		663 -> 686;
	664 [label="¿Te portas bien y me ayudas a que Loid suba y se reconcilie con la familia? Y yo te ayudaré a ordenar tus recuerdos.",shape=box,color=red];
		664 -> 687;
	668 [label="No significa que te falte iniciativa. Solo significa que algunas cosas requieren un poco más de esfuerzo.",shape=box,color=red];
		668 -> 691;
	669 [label="Espero que no te moleste.",shape=box,color=red];
