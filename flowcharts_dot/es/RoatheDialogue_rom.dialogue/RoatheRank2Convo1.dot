	679 [label="Creo que también empiezo a entender por qué nos has borrado la memoria. Viendo todos tus intentos y esfuerzos fallidos... ¿por qué no golpear el tablero e intentarlo de nuevo?",shape=box,color=blue];
		679 -> 701;
	680 [label="Al ver con frustración que ya no podías convencerla de la simple verdad de las cosas, recurriste a lo que era: usar este... don tuyo.",shape=box,color=blue];
		680 -> 702;
	681 [label="No me gusta que me ensucies la mente para corregir tus errores, Viajero. Sin embargo, que intentes hacerlo por mí... supongo que es, de alguna manera, aceptable.",shape=box,color=blue];
