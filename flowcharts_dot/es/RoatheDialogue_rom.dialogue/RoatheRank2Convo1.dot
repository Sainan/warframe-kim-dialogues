	628 [label="¿Cómo va tu progreso con nuestra pequeña aduladora flotante? Supongo que el sacerdote sigue sin hablarte.",shape=box,color=blue];
		628 -> 641;
		628 -> 642;
		628 -> 643;
	627 [label="Dime, ¿has cambiado de opinión sobre mi oferta? Esta será tu última oportunidad, Usurpador. Soy un demonio paciente, pero no me gusta que me dejen a la deriva, como un tonto que sostiene la puerta abierta.",shape=box,color=blue];
		627 -> 639;
		627 -> 640;
