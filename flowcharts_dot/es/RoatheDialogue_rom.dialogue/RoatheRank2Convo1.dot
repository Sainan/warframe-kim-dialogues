		633 -> 648 [label="false",color=purple];
	634 [label="Lyon tiene... está lidiando con tantas cosas. Y no sé cómo ayudarlo a superarlo todo.",shape=box,color=red];
		634 -> 656;
	635 [label="Marie no verá al Entrati como realmente es. Y no puedo lograr que vea la verdad, haga lo que haga.",shape=box,color=red];
		635 -> 657;
	636 [label="Bueno, verás, está todo este asunto de por qué tomaste el suero, y yo... dije las cosas equivocadas en los momentos equivocados.",shape=box,color=red];
		636 -> 658;
	637 [label="Puede que sea un poco vergonzoso, pero... tengo sentimientos por uno de ustedes tres.",shape=box,color=red];
		637 -> 659;
		637 -> 660;
		637 -> 661;
	638 [label="Estoy intentando que tú y los demás me ayuden a reunir a Loid con su familia de arriba y... yo... no pude...",shape=box,color=red];
		638 -> 662;
	641 [label="No, Lyon... no parece hablar mucho.",shape=box,color=red];
		641 -> 665;
	642 [label="Me llevo bien con Marie. ¿Por qué la llamas aduladora?",shape=box,color=red];
		642 -> 666;
	643 [label="Parece que no te gustan mucho. ¿Por qué?",shape=box,color=red];
		643 -> 667;
