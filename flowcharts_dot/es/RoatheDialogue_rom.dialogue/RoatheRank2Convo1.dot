		618 -> 622 [label="false",color=purple];
	619 [label="Es un desafío extraño desde mi perspectiva, operar solo con una parte de mis recuerdos intactos y saber que tienes la otra mitad de la baraja en tu mano.",shape=box,color=blue];
		619 -> 623;
	620 [label="Pero ¿todo este... vagar en tu mente sin rumbo? Es solo una pérdida de tiempo. Así que ven. Di la palabra. Y tu problema se resolverá.",shape=box,color=blue];
		620 -> 624;
		620 -> 625;
	621 [label="Dime qué buscas y lleguemos a un acuerdo. Todo este... dar vueltas es solo una pérdida de tiempo.",shape=box,color=blue];
