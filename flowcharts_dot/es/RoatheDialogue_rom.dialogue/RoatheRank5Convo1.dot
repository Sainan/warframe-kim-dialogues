		j3591612755 -> j1934009866 [label="false",color=purple];
	j3487290865 [label="Al principio, supuse que era Uriel. ¿Por qué no? Otra mente, otra alma destrozada, rota y abandonada. Condenada por actos que no eligió cometer.",shape=box,color=blue];
