	j2863236475 [label="Difamados, incomprendidos, anatema. Arrojados del cielo y abandonados a su suerte. ¡Almas gemelas, sin duda!",shape=box,color=blue];
		j2863236475 -> j3718171373;
	j1200173385 [label="Sé que no es la primera vez que pasamos por esto. Recuerdo haber estado aquí una vez. Y puede que no sea la última. Constantemente les pido que se detengan aquí y comiencen de nuevo, y significa muchísimo para mí que lo hagan.",shape=box,color=blue];
		j1200173385 -> j2555502153;
	j134623244 [label="Sé que no es la primera vez que pasamos por esto. Recuerdo haber estado aquí una vez. Y puede que no sea la última. Constantemente les pido que se detengan aquí y comiencen de nuevo, y significa muchísimo para mí que lo hagan.",shape=box,color=blue];
		j134623244 -> j3582207753;
	j3483090899 [label="Sé que no es la primera vez que pasamos por esto. Recuerdo haber estado aquí una vez. Y puede que no sea la última. Constantemente les pido que se detengan aquí y comiencen de nuevo, y significa muchísimo para mí que lo hagan.",shape=box,color=blue];
		j3483090899 -> j2993533887;
	j3406193853 [label="Debo felicitarte, Usurpador, por hacer lo que te pedí y no adentrarte más en la Oscuridad Refractaria y mis recuerdos en Descendia. A pesar de no haber promesa entre nosotros.",shape=box,color=blue];
		j3406193853 -> j3373160280;
	j4067712920 [label="Cariño, debo felicitarte por cumplir tu palabra y no avanzar más en Descendia y la Oscuridad Refractaria, y no recuperar mis últimos recuerdos. Significa muchísimo para mí.",shape=box,color=blue];
		j4067712920 -> j1411598990;
	j3974158550 [label="Cariño, debo felicitarte por hacer lo que te pedí y no adentrarte más en la Oscuridad Refractaria y mis recuerdos en Descendia. Significa muchísimo para mí.",shape=box,color=blue];
		j3974158550 -> j1411598990;
	j1633763191 [label="Debo felicitarte, Usurpador, por cumplir tu palabra y no ir más allá en Descendia y la Oscuridad Refractaria y no recuperar mis últimos recuerdos.",shape=box,color=blue];
		j1633763191 -> j321057116;
	j2238937740 [label="Debo felicitarte, Usurpador, por hacer lo que te pedí y no adentrarte más en la Oscuridad Refractaria y mis recuerdos en Descendia. A pesar de no haber promesa entre nosotros.",shape=box,color=blue];
		j2238937740 -> j321057116;
	j3718171373 [label="Cuando llegaron los conscriptos, tres energías se entrelazaron con la mía, la cuarta ya no me sorprendió tanto. Esta cosa horrible que ansiaba desgarrarme como una corteza planetaria que se dispersa.",shape=box,color=blue];
		j3718171373 -> j3276755894;
	j2555502153 [label="Recuerdo la promesa que me hiciste. ¿Y haberme ganado un lugar tan especial en tu corazón que me mantienes en este estado de purgatorio? Gracias, cariño. Gracias.",shape=box,color=blue];
		j2555502153 -> j1411598990;
	j3582207753 [label="¿Será posible que me haya ganado un lugar tan especial en tu corazón que me mantengas en este estado de purgatorio? Gracias, mi amor. Gracias.",shape=box,color=blue];
		j3582207753 -> j1411598990;
	j2993533887 [label="Recuerdo tu promesa. ¿Y que haya encontrado tal amistad contigo y que me mantengas en este estado de purgatorio? Gracias.",shape=box,color=blue];
		j2993533887 -> j321057116;
	j3373160280 [label="¿Y que haya encontrado tal amistad contigo y que me mantengas en este estado de purgatorio? Gracias.",shape=box,color=blue];
		j3373160280 -> j321057116;
	j1411598990 [label="Aunque todavía lo siento carcomiéndome la mente, es como un kubrow ladrando al final de una correa. Manejable. Entrenable.",shape=box,color=blue];
		j1411598990 -> j57645116;
	j321057116 [label="Aunque todavía lo siento carcomiéndome la mente, es como un kubrow ladrando al final de una correa. Manejable. Entrenable.",shape=box,color=blue];
