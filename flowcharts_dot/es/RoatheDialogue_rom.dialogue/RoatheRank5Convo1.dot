		j1703668840 -> j1911314697;
	j2945656121 [label="Si deseas buscar el perdón, puedes. Pero necesitas desearlo. Necesitas elegir ese camino. Nadie más puede.",shape=box,color=red];
		j2945656121 -> j2783205049;
	j2857976534 [label="¿Quién soy yo...?",shape=box,color=blue];
		j2857976534 -> j3065502366;
	j3618348410 [label="¿Quién soy yo...?",shape=box,color=blue];
		j3618348410 -> j3843897188;
	j3003481976 [label="Y, por lo tanto, nuestro apego al tiempo. Te pido ahora. No, te suplico, que lo uses ahora en mi nombre. Aleja de mí estos pensamientos. Aleja de mí estos recuerdos.",shape=box,color=blue];
		j3003481976 -> j1301990179;
	j2583102933 [label="Pues muy bien. Que así sea. No te lo pediré ahora. Pero ¿y si nunca lo has hecho por diversión, curiosidad o para intentar corregir errores cometidos en el trato con los demás?",shape=box,color=blue];
		j2583102933 -> j1301990179;
	j2162430865 [label="Es mi decisión, por tanto, pasar el resto de mis días eligiendo corregir todos los errores que mis miserables pueblos han considerado oportuno cometer en este sistema desde el principio de los tiempos. ",shape=box,color=blue];
		j2162430865 -> j2455835493;
	j3768387410 [label="Mis planes y designios de poder son pura y exclusivamente míos. Y tú, mi querido y dulce Viajero, serás quien los gobierne... si así lo decides.",shape=box,color=blue];
		j3768387410 -> j3012754781;
	j2972037581 [label="¡Tengo dos palabras para ti que quizá no olvides, porque he oído que te resultan bastante familiares!",shape=box,color=blue];
		j2972037581 -> j2200069551;
	j1435852269 [label="¡Bueno! ¡Permíteme dejar que vuelvas a lo que estabas haciendo! ¡Disculpa por haberte interrumpido!",shape=box,color=blue];
