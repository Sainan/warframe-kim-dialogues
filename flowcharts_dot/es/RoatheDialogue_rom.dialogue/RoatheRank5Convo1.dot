	"Chat ends." [color=orange];
	j1594011433 [label="Y ahora lo recuerdo, querido Viajero. Recuerdo con cuánta desesperación te rogué que te liberaras de ellos. Y cómo juraste que lo harías. Y lo hiciste.",shape=box,color=blue];
		j1594011433 -> j3729337947;
	j2035133218 [label="Y ahora lo recuerdo, querido Viajero. Ahora recuerdo lo que te pedí y lo que te negaste a hacer. Te pedí que limpiaras mi mente de estos pensamientos, y dijiste que no. Y aquí estamos, a pesar de todo. ¿No es así?",shape=box,color=blue];
		j2035133218 -> j1008319998;
