	j835812938 [label="Lo olvidé. ¡Lo siento!",shape=box,color=red];
		j835812938 -> j222551171;
	j658499182 [label="No quise mentirte, sólo no me di cuenta de que era algo tan importante.",shape=box,color=red];
		j658499182 -> j3571991539;
	j2298349862 [label="Sé que rompí mi promesa. Lo siento. Pero podemos afrontar esto juntos.",shape=box,color=red];
		j2298349862 -> j3055959764;
	j416049835 [label="¡¿Qué?! Tranquilo. Hablemos de esto.",shape=box,color=red];
		j416049835 -> j429518244;
	j829418207 [label="¡Te juro que no lo sabía! Y aunque lo supiera, no cambia lo que siento por ti, Roathe.",shape=box,color=red];
		j829418207 -> j2277868250;
	j1231912136 [label="Ódiame si quieres. Pero no haré nada hasta que resolvamos esto primero.",shape=box,color=red];
