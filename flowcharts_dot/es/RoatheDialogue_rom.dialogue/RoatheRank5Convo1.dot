		j2040473388 -> j3263226866;
	j1777159463 [label="Querido Viajero, te lo ruego. Si alguna vez te importé, si alguna vez sentiste la verdad en esas palabras que una vez dijiste, entonces te pido que hagas una última cosa por mí. Y esta petición que te hago ahora es por tu propio bien.",shape=box,color=blue];
		j1777159463 -> j3668675703;
