		j2425077418 -> j1131328541;
	j1474463426 [label="Ah, ya sé... aquí está. Reanudar la espiral. Retroceder el tiempo. \"Comenzar de nuevo\", por así decirlo, ¿sí? Acabar con esta agonía. Volver a empezar.",shape=box,color=blue];
		j1474463426 -> j1597215442;
