		j3893478545 -> j4162653135;
	j2936027108 [label="Sé lo que es intentar escapar siempre de algo de lo que sientes que nunca podrás librarte. Intentar huir de algo que siempre te seguirá, sin importar lo lejos que vayas.",shape=box,color=red];
		j2936027108 -> j3807921026;
	j823761220 [label="¿Cuánto tiempo de tu vida has pasado ocultándote de tu verdadero yo, Roathe? ¿Cuánto tiempo de tu vida has pasado ocultándote tras una máscara, esta fachada?",shape=box,color=red];
		j823761220 -> j4003594436;
	j2892203771 [label="Evaluate expressions on Thermostat counter",color=orange];
