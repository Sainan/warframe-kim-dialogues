	j3486226879 [label="Me diste tu palabra. ¡Tu palabra! ¡Pero ahora descubro que eran puras mentiras!",shape=box,color=blue];
		j3486226879 -> j3626945012;
		j3486226879 -> j3170776623;
	j2244136322 [label="Debí haberlo sabido. ¡Debí haber sabido que no debía confiar en ti, anomalía nacida del Vacío! ¿Sabías lo que me aguardaba allí? ¿Acaso sabías la verdad cuando yo no?",shape=box,color=blue];
		j2244136322 -> j877469787;
		j2244136322 -> j4179420375;
	j3729337947 [label="Y aquí estamos, una vez más, de vuelta al punto de partida. Pisando de nuevo los cadáveres de nuestro pasado. No mejor que donde estábamos antes.",shape=box,color=blue];
		j3729337947 -> j3767305968;
	j1008319998 [label="¡Parece que por razones que no me incumben en absoluto! Aun así, recuerdo la agonía de mi decisión de tomar ese suero.",shape=box,color=blue];
		j1008319998 -> j3767305968;
	j2354121053 [label="Y aquí estamos, una vez más, de vuelta al punto de partida. Pisando de nuevo los cadáveres de nuestro pasado. No mejor que donde estábamos antes.",shape=box,color=blue];
		j2354121053 -> j1013951300;
	j1077051709 [label="¡Parece que por razones que no me incumben en absoluto! Aun así, recuerdo la agonía de mi decisión de tomar ese suero.",shape=box,color=blue];
		j1077051709 -> j1013951300;
	j2331190944 [label="Una vez me dijiste palabras que no sabía que pudieran ser reales. Repíteme una vez más que eran ciertas. Dímelas. Por favor. Las necesito ahora. Más que nunca.",shape=box,color=blue];
		j2331190944 -> j3145919458;
		j2331190944 -> j369783330;
	j793252438 [label="Me diste tu palabra. ¡Tu palabra! Y las endulzaste tan maravillosamente con palabras de cariño. ¡Pero ahora descubro que eran puras mentiras!",shape=box,color=blue];
		j793252438 -> j1130062018;
		j793252438 -> j1299143595;
	j2362725374 [label="¿Lo sabías? ¿Lo sabías? ¿Y llegaste a mi lado, susurrándome palabras de cariño, con la esperanza de suavizar el golpe que vendría después?",shape=box,color=blue];
		j2362725374 -> j1222198235;
		j2362725374 -> j2091804824;
	j3626945012 [label="Espera un segundo.",shape=box,color=red];
