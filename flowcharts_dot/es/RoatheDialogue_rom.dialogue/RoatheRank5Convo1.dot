	j1861184466 [label="No lo sé, Usurpador. Y ahí radica el mayor problema.",shape=box,color=blue];
		j1861184466 -> j2710717104;
	j1911314697 [label="No te definen las opiniones de quienes te rodean ni lo que piensan de tus acciones. Sólo te define lo que piensas de ti mismo y de tus decisiones.",shape=box,color=red];
		j1911314697 -> j971462889;
	j2783205049 [label="Tu pasado no te define, Roathe. Te define tu futuro. Y aún tienes un futuro por delante, a diferencia de todos los orokin que murieron en la Noche de los Tambores Naga.",shape=box,color=red];
		j2783205049 -> j2960725012;
	j3065502366 [label="Cuando todos los recuerdos se hayan ido, cuando todos los recuerdos regresen, cuando todo se haya quemado y todo haya regresado a mí...",shape=box,color=blue];
		j3065502366 -> j3983350488;
	j3843897188 [label="Cuando todos los recuerdos se hayan ido, cuando todos los recuerdos regresen, cuando todo se haya quemado y todo haya regresado a mí...",shape=box,color=blue];
		j3843897188 -> j14041514;
	j1301990179 [label="Tengo que olvidarme de haber tomado el suero de Entrati. Y encima de eso, ¿del dolor de tus palabras de amor revocadas? Tengo tanto dolor que quisiera olvidar... Por favor.",shape=box,color=blue];
		j1301990179 -> j2851978094;
		j1301990179 -> j2089048178;
		j1301990179 -> j878997429;
	j2455835493 [label="Hemos derramado demasiada sangre. Hemos matado a demasiadas personas. Hemos robado demasiadas vidas. Hemos esparcido mucho mal. Y es lo único que puedo hacer para compensar lo poco que puedo.",shape=box,color=blue];
		j2455835493 -> j3516789427;
