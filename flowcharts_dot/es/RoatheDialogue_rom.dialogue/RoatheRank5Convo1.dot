	j2761237153 [label="¿Y eso sería...? ",shape=box,color=red];
		j2761237153 -> j1317450115;
	j3054861701 [label="No. Sé lo que vas a preguntar y la respuesta es no.",shape=box,color=red];
		j3054861701 -> j1709184121;
	j2651249253 [label="Me desprendo de estas cadenas de vergüenza y cobardía pasada. Me desprendo de estos grilletes de rango y servidumbre.",shape=box,color=blue];
