	j1732832341 [label="Tú.",shape=box,color=blue];
		j1732832341 -> j2366571948;
	j3660839117 [label="No fue...",shape=box,color=blue];
		j3660839117 -> j2866976788;
	j29073625 [label="Ah, sí, \"acéptalo\". ¡Como hice cuando tomé el suero de Entrati y huí de mi destino como un cobarde!",shape=box,color=blue];
		j29073625 -> j2482260180;
		j29073625 -> j3432766707;
	j1167035199 [label="Disculpa si me cuesta creerlo. Nos definen los momentos de nuestra vida. Somos simplemente una serie de recuerdos que nos conducen al siguiente. Por eso los recuerdos son, y eran, tan sagrados para los orokin.",shape=box,color=blue];
		j1167035199 -> j2861229035;
	j1137464648 [label="¡No te atrevas! ¡No te atrevas a decirme que me \"calme\"! ¿No crees que tengo todo el derecho a sentirme como si me estuvieran partiendo en dos?",shape=box,color=blue];
