	j3179674777 [label="Debajo de los recuerdos, debajo del exterior orokin, debajo de esta... piel azul e Infestación, debajo de Uriel y esta máscara del vicerregente Gran Carnus Roathe que llevo...",shape=box,color=blue];
		j3179674777 -> j2857976534;
	j3394442803 [label="Debajo de los recuerdos, debajo del exterior orokin, debajo de esta... piel azul e Infestación, debajo de Uriel y esta máscara del vicerregente Gran Carnus Roathe que llevo...",shape=box,color=blue];
		j3394442803 -> j3618348410;
	j1317450115 [label="Tienes un don. Un don que puede deshacer el tiempo. Hacerlo espiral, o incluso bucle. Y esto tiene... un efecto interesante en las mentes de los protoframes, por su apego a la Infestación y su apego al tiempo. ",shape=box,color=blue];
		j1317450115 -> j3003481976;
	j1709184121 [label="Si puedes decirme que nunca has usado tus dones para jugar con las mentes de los protoframes a quienes llamas amigos y amantes, ¿puedes decirlo sin mentira en tu alma?",shape=box,color=blue];
		j1709184121 -> j2583102933;
	j4253885164 [label="Soy el último de los orokin. Estoy coronado entre ellos hasta que alguien se levante para desafiarme. Y seré el capitán de todos mis asuntos hasta el día en que mi vida sea extinguida.",shape=box,color=blue];
		j4253885164 -> j2162430865;
	j1808453434 [label="Soy el último de los orokin. Estoy coronado entre ellos hasta que alguien se levante para desafiarme. Y seré el capitán de todos mis asuntos hasta el día en que mi vida sea extinguida.",shape=box,color=blue];
