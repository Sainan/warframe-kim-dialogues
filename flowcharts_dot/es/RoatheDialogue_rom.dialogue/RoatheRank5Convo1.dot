	j2861229035 [label="Y esa definición de mí mismo ha sido reescrita por completo recientemente. La tengo impresa en mi psique con tinta.",shape=box,color=blue];
		j2861229035 -> j3634416661;
	j3809157899 [label="Siento como si la comprensión de mí mismo, la base misma de mis cimientos, se hubiera agrietado y desgarrado como la maldita Lua misma. Reescrito con tinta. ¡Cobarde!",shape=box,color=blue];
		j3809157899 -> j917326890;
	j2121529040 [label="Puedes odiarme todo lo que quieras, Roathe. Pero hice lo que hice porque tenía que pasar. Ya no podías esconderte de esto.",shape=box,color=red];
		j2121529040 -> j3065322651;
	j3684624143 [label="Piensa de mí lo que quieras. Pero reconozco una espiral cuando la veo.",shape=box,color=red];
