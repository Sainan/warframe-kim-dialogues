	j2091804824 [label="Roathe, espera.",shape=box,color=red];
		j2091804824 -> j1255744226;
	j661641593 [label="¡Te dije que dejaras de indagar en mi mente antes de que fuera demasiado tarde! Te dije que detuvieras tu trabajo, y aun así... ¡aun así!",shape=box,color=blue];
		j661641593 -> j3383193432;
	j2158168533 [label="¿Me ocultaste esto para revelarlo ahora? ¿Acaso todo esto fue un juego enfermizo para ti? ¿Alimentar esa cosa que se escondía dentro de mí, sabiendo lo que me esperaba?",shape=box,color=blue];
		j2158168533 -> j2425077418;
	j4174234296 [label="¿Y ahora qué, cariño? ¿Ahora qué...? Me siento al límite. ¡Al menos antes, tenía el refugio de mi indignidad!",shape=box,color=blue];
		j4174234296 -> j1474463426;
	j3336535106 [label="¿Y ahora qué, Usurpador? ¿Ahora qué...? Me siento al límite. ¡Al menos antes tenía el refugio de mi indignidad!",shape=box,color=blue];
		j3336535106 -> j580214784;
	j984513242 [label="Lo entiendo. Créeme, más que tú. Lo entiendo.",shape=box,color=blue];
		j984513242 -> j32151383;
	j1232798923 [label="Te amo de verdad. Sea cual sea tu forma. Quienquiera que elijas ser. Te amo.",shape=box,color=red];
