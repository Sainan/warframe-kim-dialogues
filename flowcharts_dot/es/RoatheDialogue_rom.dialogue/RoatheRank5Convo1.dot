		j2892203771 -> j774648485 [label="false",color=purple];
	j2590043773 [label="Estás dejando que esa ira te desgarre por dentro. Podrías usarla para ayudarte a luchar contra quienes siguen destruyendo este mundo hoy. Aquí. Ahora.",shape=box,color=red];
		j2590043773 -> j1676116237;
	j4190428718 [label="Lo estás dirigiendo a ti mismo. Deberías dirigirlo al mundo que te culpa por hacer todo lo posible para salvarlo del Imperio orokin.",shape=box,color=red];
		j4190428718 -> j2970650263;
	j1750837579 [label="Ojalá supiera cómo ayudarte. Ojalá supiera qué decir. Sientes que estás dividido en dos direcciones. ¿Qué camino quieres tomar?",shape=box,color=red];
		j1750837579 -> j12820974;
