	j933714158 [label="¿Hm? ¿Qué pasa, cariño?",shape=box,color=blue];
		j933714158 -> j1184157357;
	j604242687 [label="Boolean RoatheConsentComplete is now true.",color=orange];
		j604242687 -> "Chat ends.";
	j1184157357 [label="Quiero hablar contigo sobre algo y quiero asegurarme de que estés de acuerdo.",shape=box,color=red];
		j1184157357 -> j1148025547;
	j1148025547 [label="Para mí es importante que no sientas que te estoy mintiendo o que no hablo con total honestidad.",shape=box,color=red];
		j1148025547 -> j423597308;
	j423597308 [label="Te escucho. Parece que va a ser bastante bueno.",shape=box,color=blue];
		j423597308 -> j500683887;
	j500683887 [label="No quiero ponerte en una situación incómoda. Así que si no estás de acuerdo, no hay problema. Quiero que lo sepas.",shape=box,color=red];
		j500683887 -> j1157986917;
	j1157986917 [label="Lo que tenemos es importante para mí, muy importante, y es real. No quiero que lo dudes.",shape=box,color=red];
		j1157986917 -> j2777186047;
	j2777186047 [label="Espera. Por el Vacío, ¿estás tratando de evitar decirme que tienes otra pareja?",shape=box,color=blue];
		j2777186047 -> j97265196;
	j97265196 [label="¿Me crees tan tonto? ¡Ya lo sabía, querido Viajero!",shape=box,color=blue];
		j97265196 -> j965451741;
		j97265196 -> j3421946608;
	j965451741 [label="Entonces, ¿puedo asumir que no te importa?",shape=box,color=red];
		j965451741 -> j689323368;
	j3421946608 [label="Tú... ¿sabías?",shape=box,color=red];
		j3421946608 -> j3823778772;
	j689323368 [label="Ojalá pudieras oírme reír en el Sanctum ahora mismo. Viajero, cariño. Mi dulce Viajero. Soy un orokin. Claro que no me importa.",shape=box,color=blue];
		j689323368 -> j3180655459;
	j3823778772 [label="Ojalá pudieras oírme reír en el Sanctum ahora mismo. Viajero, cariño. Mi dulce Viajero.",shape=box,color=blue];
		j3823778772 -> j3011681542;
	j3180655459 [label="Independientemente de lo que pienses de mi sociedad y de nuestra tendencia a disfrutar de la compañía de los demás de una manera que podrías considerar despreciable y degradante, también sabíamos lo que significaba amar.",shape=box,color=blue];
		j3180655459 -> j1210985856;
	j3011681542 [label="Lo supe en el momento en que ocurrió. Tengo mis métodos. Y no, no me importa en lo más mínimo. Soy un orokin.",shape=box,color=blue];
		j3011681542 -> j3180655459;
	j1210985856 [label="Nadie entendía el amor como los orokin. Y sabíamos que en el corazón podía haber espacio para más de una persona. ",shape=box,color=blue];
		j1210985856 -> j3747046996;
	j3747046996 [label="Simplemente me desilusiona que los fanáticos probablemente sean demasiado cerrados de mente como para sumarse a la diversión.",shape=box,color=blue];
		j3747046996 -> j3266403353;
	j3266403353 [label="Bah. Pensándolo bien, probablemente sea lo mejor. ¿Te imaginas el sinsentido que causaría?",shape=box,color=blue];
		j3266403353 -> j1346956172;
	j1346956172 [label="Boolean RoatheConsentComplete is now true.",color=orange];
		j1346956172 -> j295302818;
	j295302818 [label="Bueno, da igual. Si esa persona te hace feliz, entonces disfrútalo. Pero cuando estés conmigo...",shape=box,color=blue];
		j295302818 -> j3650986836;
	j3650986836 [label="+5 Chemistry",color=orange];
		j3650986836 -> j320234672;
	j320234672 [label="Sólo me perteneces a mí.",shape=box,color=blue];
		j320234672 -> "Chat ends.";
