	"RoatheRank4Convo4 begins." [color=orange];
		"RoatheRank4Convo4 begins." -> j2540491456;
	j2540491456 [label=" Tengo una pregunta filosófica para ti, Usurpador. Y antes de que saques conclusiones precipitadas sobre a quién me refiero, ya sea a mí mismo, a Ballas o, que el Vacío no lo quiera, a Albrecht, es puramente un experimento mental. ¿Jugamos?",shape=box,color=blue];
		j2540491456 -> j2903353014;
		j2540491456 -> j2782352499;
		j2540491456 -> j1211839437;
	j2903353014 [label="Ya siento curiosidad.",shape=box,color=red];
		j2903353014 -> j289728066;
	j2782352499 [label="Claro. Pregunta lo que quieras.",shape=box,color=red];
		j2782352499 -> j2391386743;
	j1211839437 [label="No estoy de humor. [Fin]",shape=box,color=red];
		j1211839437 -> j4086521246;
	j289728066 [label="+5 Chemistry",color=orange];
		j289728066 -> j1095823058;
	j2391386743 [label="La pregunta es sencilla, pero amplia: ¿crees que todos merecen ser amados?",shape=box,color=blue];
		j2391386743 -> j821815412;
	j4086521246 [label="Lástima.",shape=box,color=blue];
		j4086521246 -> "Chat ends.";
	j1095823058 [label="¡Bien! La pregunta es sencilla, pero amplia: ¿crees que todos merecen ser amados?",shape=box,color=blue];
		j1095823058 -> j821815412;
	j821815412 [label="Evaluate expressions",color=orange];
		j821815412 -> j1492382841 [label="RoatheMargulis1",color=purple];
		j821815412 -> j3591307751 [label="RoatheMargulis1",color=purple];
		j821815412 -> j3162069166 [label="RoatheMargulis1",color=purple];
