		j821815412 -> j3591307751 [label="RoatheUnloved1",color=purple];
		j821815412 -> j3162069166 [label="RoatheUnloved1",color=purple];
		j821815412 -> j1168528294 [label="RoatheExecutor1",color=purple];
		j821815412 -> j1168528294 [label="RoatheTraitor1",color=purple];
		j821815412 -> j3591307751 [label="RoatheTraitor1",color=purple];
		j821815412 -> j3162069166 [label="RoatheTraitor1",color=purple];
		j821815412 -> j3591307751 [label="false",color=purple];
		j821815412 -> j3162069166 [label="false",color=purple];
		j821815412 -> j4290340553 [label="false",color=purple];
	"Chat ends." [color=orange];
	j1492382841 [label="¿Me preguntas eso después de haberme contado aquella historia sobre Ballas y Margulis, y no se trata de él?",shape=box,color=red];
		j1492382841 -> j1179974654;
	j3591307751 [label="Después de lo que Albrecht te hizo y todo este asunto de \"¿puede un orokin ser redimido?\", ¿y no se trata de él?",shape=box,color=red];
		j3591307751 -> j1179974654;
	j3162069166 [label="Okey, seguiré la corriente. ¿Que si creo que \"todos merecen ser amados\"? Claramente, esta es una cuestión de moralidad y valores.",shape=box,color=red];
		j3162069166 -> j315891735;
	j3555473488 [label="El orokin que me dijo que nunca había conocido el amor me hace esa pregunta... ¿y no se trata de él?",shape=box,color=red];
		j3555473488 -> j1179974654;
	j1168528294 [label="El orokin que sirvió a una ejecutora como su concubino pero luego planeó traicionarla me pregunta esto, ¿y no se trata de él?",shape=box,color=red];
		j1168528294 -> j1179974654;
	j4290340553 [label="¿De verdad esperas que crea que esto es sólo una cuestión filosófica?",shape=box,color=red];
		j4290340553 -> j1179974654;
	j1179974654 [label="No quiero quedar atrapado en detalles. Sólo complica las cosas. \"Bueno, mira, esta persona hizo esto y esa otra hizo aquello, lo cual niega esto\", y entonces todos terminamos estancados en el estrado de los testigos.",shape=box,color=blue];
		j1179974654 -> j787497807;
		j1179974654 -> j2101590567;
	j315891735 [label="+5 Chemistry",color=orange];
		j315891735 -> j875366829;
	j787497807 [label="Habla claro o no hables. Si no me vas a decir de quién se trata realmente, no voy a perder el tiempo hablando contigo.",shape=box,color=red];
		j787497807 -> j1564934140;
	j2101590567 [label="Bien. Juguemos tu jueguito proverbial.",shape=box,color=red];
		j2101590567 -> j1081144980;
	j875366829 [label="¡Gracias! Quitar los nombres en este breve ejercicio facilita mucho la comprensión. De lo contrario, te pierdes en los detalles y no puedes avanzar.",shape=box,color=blue];
		j875366829 -> j1059925731;
	j1564934140 [label="Yo tampoco, así de simple.",shape=box,color=blue];
		j1564934140 -> j155006797;
	j1081144980 [label="Bien. La pregunta es, como ya la planteé: ¿todos merecen ser amados?",shape=box,color=blue];
		j1081144980 -> j3830743815;
	j1059925731 [label="Y sí, precisamente. Nadie cuestiona si el héroe justo merece amar y ser amado. Eso nunca se debate en nuestras grandes fábulas, ¿no es así?",shape=box,color=blue];
		j1059925731 -> j1762462607;
	j155006797 [label="Boolean RoatheNoDate is now true.",color=orange];
		j155006797 -> "Chat ends.";
	j3830743815 [label="Nadie cuestiona si el héroe justo merece amar y ser amado. Eso nunca se debate en nuestras grandes fábulas, ¿no es así?",shape=box,color=blue];
		j3830743815 -> j1762462607;
	j1762462607 [label="Sólo el canalla. El villano. El monstruo. El destructor de mundos, carente de moral",shape=box,color=blue];
		j1762462607 -> j890885766;
		j1762462607 -> j772204393;
	j890885766 [label="[Dejarlo continuar]",shape=box,color=red];
		j890885766 -> j2419479725;
	j772204393 [label="¿El Diablo?",shape=box,color=red];
		j772204393 -> j3205067412;
	j2419479725 [label="Add 1 to Thermostat counter",color=orange];
		j2419479725 -> j224935320;
	j3205067412 [label="Sigue el juego, Usurpador.",shape=box,color=blue];
		j3205067412 -> j1817221348;
	j224935320 [label="Propongo la siguiente afirmación: lo único que hace que estas criaturas sean moralmente marginadas es que tienen otros que las marginan moralmente.",shape=box,color=blue];
		j224935320 -> j4211427064;
	j1817221348 [label="Add -1 to Thermostat counter",color=orange];
		j1817221348 -> j691072482;
		j1817221348 -> j3934620259;
	j4211427064 [label="Si un individuo cometiera \"actos malvados\" de forma aislada, solo, sin nadie alrededor que lo juzgue, nadie lo juzgaría como malvado, ¿no es así?",shape=box,color=blue];
		j4211427064 -> j1265605121;
	j691072482 [label="Es decir...",shape=box,color=red];
		j691072482 -> j74026131;
	j3934620259 [label="Lo siento.",shape=box,color=red];
		j3934620259 -> j74026131;
	j1265605121 [label="Si un bastardo incendia un bosque y nadie lo oye, ¿hace algún ruido? La única medida que tenemos para juzgar las \"buenas\" y las \"malas\" acciones son las acciones de los demás.",shape=box,color=blue];
		j1265605121 -> j713702701;
		j1265605121 -> j3985445592;
		j1265605121 -> j4136882884;
	j74026131 [label="Pero sí, ya que insististes en mencionarlo, ¡el Diablo! ¡El colmo de todos los males!",shape=box,color=blue];
		j74026131 -> j224935320;
	j713702701 [label="Tiene que haber acciones que sean malas por sí mismas.",shape=box,color=red];
		j713702701 -> j2808194407;
	j3985445592 [label="¿Estás diciendo que una persona necesita a alguien más para ser \"malvada\"?",shape=box,color=red];
		j3985445592 -> j4249955057;
	j4136882884 [label="No sé si estoy de acuerdo con eso.",shape=box,color=red];
		j4136882884 -> j2808194407;
	j2808194407 [label="Todos los actos más horrendos que una persona puede cometer requieren al menos que otra persona los haga. Una sola persona, aislada, no puede hacer nada condenable. ¿Destruir un planeta deshabitado? Uy, qué horror.",shape=box,color=blue];
		j2808194407 -> j2755215683;
	j4249955057 [label="Sí. Piénsalo. Todos los actos más horrendos que una persona puede cometer requieren al menos que otra persona los haga. Una sola persona, aislada, no puede hacer nada condenable. ¿Destruir un planeta deshabitado? Uy, qué horror.",shape=box,color=blue];
		j4249955057 -> j2755215683;
	j2755215683 [label="Y sin una sociedad que les señale con el dedo y les diga \"no debieron haber cometido ese acto terrible\", ¿cómo sabríamos, desde el principio, que ese acto fue tan horrible? No lo sabríamos.",shape=box,color=blue];
		j2755215683 -> j3824790509;
	j3824790509 [label="Es simplemente un criterio usado por la sociedad para juzgar tus acciones en comparación con las de los demás, como dije.",shape=box,color=blue];
		j3824790509 -> j1386424637;
		j3824790509 -> j2047949117;
	j1386424637 [label="Digamos que tienes razón. Que me has convencido y que el bien y el mal son sólo... construcciones sociales. ¿Y luego qué?",shape=box,color=red];
		j1386424637 -> j2895788623;
	j2047949117 [label="Creo que las acciones pueden ser buenas o malas fuera de su contexto social. De lo contrario, ¿por qué habría tantas similitudes en sociedades tan distintas?",shape=box,color=red];
		j2047949117 -> j597069442;
	j2895788623 [label="Add -1 to Thermostat counter",color=orange];
		j2895788623 -> j2743122494;
	j597069442 [label="Add 1 to Thermostat counter",color=orange];
		j597069442 -> j1252764084;
		j597069442 -> j370566360;
	j2743122494 [label="+5 Chemistry",color=orange];
		j2743122494 -> j3057816494;
	j1252764084 [label="Pero para los efectos de la demostración, continuemos. ",shape=box,color=red];
		j1252764084 -> j2743122494;
	j370566360 [label="Será mejor que paremos aquí. No creo que esto vaya a terminar bien. [Fin]",shape=box,color=red];
		j370566360 -> j2198371653;
	j3057816494 [label="Muy bien. Si podemos decir que el \"mal\" no es un estado del ser, sino una construcción social, entonces podemos estar de acuerdo en que todos los cuentos de grandes villanías son, a su vez, construcciones sociales. Fábulas.",shape=box,color=blue];
		j3057816494 -> j3680408040;
	j2198371653 [label="Como gustes.",shape=box,color=blue];
		j2198371653 -> "Chat ends.";
	j3680408040 [label="¿Por qué entonces, en todas las grandes fábulas, quienes cometen las peores atrocidades son abandonados a su suerte?",shape=box,color=blue];
		j3680408040 -> j1680531738;
		j3680408040 -> j4263154808;
		j3680408040 -> j4002072448;
		j3680408040 -> j2638895;
	j1680531738 [label="¿Porque son incapaces de amar?",shape=box,color=red];
		j1680531738 -> j3531800099;
	j4263154808 [label="¿Porque no tienen espacio en su corazón para el amor?",shape=box,color=red];
		j4263154808 -> j630698533;
	j4002072448 [label="¿Porque no merecen ser amados?",shape=box,color=red];
		j4002072448 -> j2185530405;
	j2638895 [label="¿Porque estamos tratando de dar una lección?",shape=box,color=red];
		j2638895 -> j1463435208;
	j3531800099 [label="A veces, sí, se les representa como una especie de maldad inhumana, incapaz de amar. Pero ¿por qué? Diría que todos los grandes cuentos de hadas existen para dar una lección, ¿no?",shape=box,color=blue];
		j3531800099 -> j1013186413;
	j630698533 [label="A veces, sí, se les muestra demasiado preocupados por sus grandes males como para menospreciarse con esas supuestas \"cosas triviales\". Pero, ¿por qué? Todas las grandes fábulas existen para enseñar una lección, ¿no es así?",shape=box,color=blue];
		j630698533 -> j1013186413;
	j2185530405 [label="Mm, ahora simplemente me estás repitiendo lo mismo, Usurpador. Ya hemos decidido que \"merecer\" es algo relativo. Piénsalo. Todas las grandes fábulas existen para dar una lección, ¿no?",shape=box,color=blue];
		j2185530405 -> j1013186413;
	j1463435208 [label="+5 Chemistry",color=orange];
		j1463435208 -> j2065124295;
	j1013186413 [label="Y si mostráramos a un malvado viviendo en paz, feliz y maravillosamente enamorado... bueno... ¿qué clase de lección enseñaría eso?",shape=box,color=blue];
		j1013186413 -> j207725308;
		j1013186413 -> j1075368051;
		j1013186413 -> j4107502679;
	j2065124295 [label="¡Esa sería mi teoría, sí! Todas las grandes fábulas existen para enseñar una lección, ¿no?",shape=box,color=blue];
		j2065124295 -> j1013186413;
	j207725308 [label="Es difícil conciliar el hecho de que alguien sea \"malvado\" y también capaz de amar.",shape=box,color=red];
		j207725308 -> j362925635;
	j1075368051 [label="¿Que tal vez sus \"malas acciones\" aún podrían ser redimidas a través del amor?",shape=box,color=red];
		j1075368051 -> j3019969038;
	j4107502679 [label="¿Que quienes hacen \"cosas malas\" aún podrían tener valor para alguien más en este mundo y, por lo tanto, no son \"pura maldad\"?",shape=box,color=red];
		j4107502679 -> j1985099814;
	j362925635 [label="Check boolean RoatheMargulis1",color=orange];
		j362925635 -> j749347166 [label=true,color=green];
		j362925635 -> j1305080994 [label=false,color=brown];
	j3019969038 [label="Add 1 to Thermostat counter",color=orange];
		j3019969038 -> j3102398274;
	j1985099814 [label="Add -1 to Thermostat counter",color=orange];
		j1985099814 -> j3656661786;
	j749347166 [label="+5 Chemistry",color=orange];
		j749347166 -> j73816374;
	j1305080994 [label="+5 Chemistry",color=orange];
		j1305080994 -> j1958982053;
	j3102398274 [label="Suenas como los fanáticos. \"Redención\". Pero estás llamando a la puerta de la verdad. Porque insinúas que ambos no pueden coexistir en nuestro mundo, y es cierto, ¿no? No se puede permitir que el amor y el mal coexistan en la sociedad.",shape=box,color=blue];
		j3102398274 -> j603738447;
	j3656661786 [label="Estás cerca, pero no del todo. Sí, pero ve un paso más allá. ¿Qué significaría si una persona capaz de hacer el mal fuera amada por otra? ¿Qué consecuencias tendría eso para la sociedad?",shape=box,color=blue];
		j3656661786 -> j603738447;
	j73816374 [label="¡Exactamente! Estas dos cosas no quieren convivir en nuestras mentes, ¿verdad? Cuando te conté la historia de Ballas y Margulis, fue difícil aceptar que su amor mutuo alguna vez fue real, ¿verdad?",shape=box,color=blue];
		j73816374 -> j3835638881;
	j1958982053 [label="¡Exactamente! Estas dos cosas no quieren convivir en nuestras mentes, ¿verdad? Si te dijera que Ballas y Margulis estuvieron muy enamorados antes de que todo saliera mal, ¿me creerías?",shape=box,color=blue];
		j1958982053 -> j3835638881;
	j603738447 [label="Check boolean RoatheMargulis1",color=orange];
		j603738447 -> j95886384 [label=true,color=green];
		j603738447 -> j654649897 [label=false,color=brown];
	j3835638881 [label="Sin entrar en detalles ni alejarme demasiado de mi propia regla de mantener las cosas puramente filosóficas, son un punto de referencia común para nosotros.",shape=box,color=blue];
		j3835638881 -> j1224445247;
	j95886384 [label="Cuando te conté la historia de Ballas y Margulis, fue difícil aceptar que su amor mutuo alguna vez fue real, ¿verdad?",shape=box,color=blue];
		j95886384 -> j3835638881;
	j654649897 [label="Si te dijera que Ballas y Margulis estuvieron muy enamorados antes de que todo saliera mal, ¿me creerías?",shape=box,color=blue];
		j654649897 -> j3835638881;
	j1224445247 [label="No cabe duda de que Ballas era capaz de algunas de las formas más puras de crueldad que la humanidad haya conocido. Sin embargo, conocía el amor. Amor mutuo. ",shape=box,color=blue];
		j1224445247 -> j1661045183;
	j1661045183 [label="Es un hecho, aunque ahora quieras negarlo, Ballas y Margulis se amaban profundamente. Simplemente, todo salió terriblemente mal.",shape=box,color=blue];
		j1661045183 -> j1147162328;
	j1147162328 [label="Boolean RoatheMargulis1 is now true.",color=orange];
		j1147162328 -> j2971061082;
	j2971061082 [label="Pero debemos borrar el amor de esa historia. Debemos decir que no existió. Debemos decir que no fue real, que fue una falacia. ¿Por qué?",shape=box,color=blue];
		j2971061082 -> j1920782915;
		j2971061082 -> j2726712006;
		j2971061082 -> j615265271;
	j1920782915 [label="No lo sé.",shape=box,color=red];
		j1920782915 -> j4095659815;
	j2726712006 [label="Porque el amor es la emoción humana por excelencia, y si nos permitimos pensar que alguien puede ser amado, lo humanizamos.",shape=box,color=red];
		j2726712006 -> j2060826134;
	j615265271 [label="Porque el mal tiene que mirarse al espejo y esforzarse por cambiar. Tiene que ser castigado. Y amar y ser amado es la recompensa máxima.",shape=box,color=red];
		j615265271 -> j1786668948;
	j4095659815 [label="Y he hecho todo este trabajo para nada. Qué decepción.",shape=box,color=blue];
		j4095659815 -> "Chat ends.";
	j2060826134 [label="Add -2 to Thermostat counter",color=orange];
		j2060826134 -> j534816435;
	j1786668948 [label="Add 2 to Thermostat counter",color=orange];
		j1786668948 -> j1298977752;
	j534816435 [label="Muy bien, Usurpador. Muy bien. Exactamente. El gran mal siempre debe ser \"otro\" y jamás debemos sentir compasión por él. ¿Si le permitiéramos amar y ser amado? Creo que el mundo entero se derrumbaría a nuestro alrededor.",shape=box,color=blue];
		j534816435 -> j2916153754;
	j1298977752 [label="Muy bien, Usurpador. Muy bien. Exactamente. Debemos controlar al gran mal. ¿Y si permitimos que sienta amor y sea amado? Creo que el mundo entero se derrumbaría a nuestro alrededor.",shape=box,color=blue];
		j1298977752 -> j2916153754;
	j2916153754 [label="Boolean RoatheUnloved3 is now true.",color=orange];
		j2916153754 -> j3254090594;
	j3254090594 [label="¿Y dónde estaríamos entonces?",shape=box,color=blue];
		j3254090594 -> "Chat ends.";
}