digraph {
	1042 [label="RoatheRank2Convo3 begins.",color=orange];
		1042 -> 1043;
	1043 [label="Check boolean RoatheRank2Convo1Complete",color=orange];
		1043 -> 1044 [label=true,color=green];
		1043 -> 1045 [label=false,color=brown];
	1044 [label="Check boolean RoatheKnowsReset2",color=orange];
		1044 -> 1046 [label=true,color=green];
		1044 -> 1047 [label=false,color=brown];
	1045 [label="Chat ends.",color=orange];
	1046 [label="Sé que probablemente ya has oído esto antes, y hoy me doy cuenta de que no me importa... no tengo paciencia.",shape=box,color=blue];
		1046 -> 1047;
	1047 [label="Creo que lo que causó la caída del Imperio Orokin fueron demasiadas capas de vidrio.",shape=box,color=blue];
		1047 -> 1048;
		1047 -> 1049;
		1047 -> 1050;
	1048 [label="¿Por qué piensas eso?",shape=box,color=red];
		1048 -> 1051;
	1049 [label="¿Demasiado impersonal?",shape=box,color=red];
		1049 -> 1052;
	1050 [label="[Fin]",shape=box,color=red];
		1050 -> 1053;
	1051 [label="Imagina una sociedad construida sobre la certeza de que estás, a todos los efectos, siempre a salvo. Protegido. Incluso del gran espectro de la muerte.",shape=box,color=blue];
		1051 -> 1054;
	1052 [label="+5 Chemistry",color=orange];
		1052 -> 1055;
	1053 [label="Chat ends.",color=orange];
	1054 [label="Donde nada te puede hacer daño.",shape=box,color=blue];
		1054 -> 1056;
	1055 [label="Precisamente. Demasiado alejado del peligro y la realidad del asunto.",shape=box,color=blue];
		1055 -> 1051;
	1056 [label="Conduce a una especie de tedio que empieza a inventar su propio peligro: el Usurpador. La política. La intriga cortesana. De repente, estábamos inventando nuevas y magistrales formas de ponernos en peligro, ya que habíamos reemplazado lo antiguo.",shape=box,color=blue];
		1056 -> 1057;
		1056 -> 1058;
	1057 [label="¿Qué trae esto a colación?",shape=box,color=red];
		1057 -> 1059;
	1058 [label="¿Qué es peor? ¿Que te disparen o tener que cuidarte las espaldas?",shape=box,color=red];
		1058 -> 1060;
	1059 [label="Hubo muy pocos detalles interesantes o agradables en mi... obligada estancia en \"Gaule\". La comida fue uno de ellos. El segundo, sin embargo... fueron las tormentas.",shape=box,color=blue];
		1059 -> 1061;
	1060 [label="¡Ja! No estoy seguro de tener una preferencia, ya que estoy completamente familiarizado con ambos, me temo. ¿Tú con cuál te quedas?",shape=box,color=blue];
		1060 -> 1062;
		1060 -> 1063;
	1061 [label="Tormentas eléctricas como nunca había presenciado en todos mis años como orokin. Sacudían la tierra, retumbaban los cristales de madera de las ventanas. Podía oírlas incluso en la polvorienta cripta donde nos tenían encerrados.",shape=box,color=blue];
		1061 -> 1064;
	1062 [label="Me gusta saber quiénes son mis enemigos, así de simple. Que me ataquen con todas sus armas.",shape=box,color=red];
		1062 -> 1065;
	1063 [label="Que me disparen. Prefiero poder mover los hilos para hacer el trabajo. Puedo tomarme mi tiempo.",shape=box,color=red];
		1063 -> 1066;
	1064 [label="Cuando pasaban por la ciudad, subía al campanario para acercarme lo más posible. Deseaba sentir la electricidad en el aire, la lluvia torrencial en mi piel.",shape=box,color=blue];
		1064 -> 1067;
		1064 -> 1068;
		1064 -> 1069;
	1065 [label="Add 1 to Thermostat",color=orange];
		1065 -> 1070;
	1066 [label="Add -1 to Thermostat",color=orange];
		1066 -> 1071;
	1067 [label="¿No fue eso un poco peligroso?",shape=box,color=red];
		1067 -> 1072;
	1068 [label="Eso suena increíble.",shape=box,color=red];
		1068 -> 1073;
	1069 [label="¿Cómo se sintieron Marie y Lyon al saber que te escapaste?",shape=box,color=red];
		1069 -> 1074;
	1070 [label="Entiendo tu punto, y coincido en que hay cierta simplicidad en ello. Es difícil confundir a un enemigo con otra cosa cuando te apunta a la cara con un arma.",shape=box,color=blue];
		1070 -> 1075;
	1071 [label="Mm, delicioso, ¿verdad? Un plan meticuloso, ingeniosamente diseñado, que da sus frutos. Ver cómo todas las piezas encajan... es divertidísimo.",shape=box,color=blue];
		1071 -> 1075;
	1072 [label="¡Ese era precisamente el propósito de la empresa! No puedo describir lo que sentí al sentir semejante poder puro. No, era más que eso; era poder real. Miré hacia arriba, hacia esas nubes oscuras y arremolinadas, destellando con furiosos relámpagos, y vi lo que mis antepasados habían buscado con tanta desesperación.",shape=box,color=blue];
		1072 -> 1076;
	1073 [label="+5 Chemistry",color=orange];
		1073 -> 1077;
	1074 [label="Escribes esas palabras como si les hubiera dedicado el más mínimo pensamiento. No me siguieron, si es eso lo que preguntas. Al Sacerdote le importó poco si me mataba con un rayo, estoy seguro. ¿Y Marie? Probablemente estaba demasiado ocupada adorando a sus falsos ídolos. Sol o Albrecht, tú eliges.",shape=box,color=blue];
		1074 -> 1078;
	1075 [label="+5 Chemistry",color=orange];
		1075 -> 1079;
	1076 [label="Además, sabía que mi presencia allí también podría matarme, y que no habría ningún Kuva cerca para reanimarme. Y aún más, que el Kuva sagrado no actuaría sobre mi forma deformada y retorcida. ",shape=box,color=blue];
		1076 -> 1080;
	1077 [label="¡Lo fue! No puedo describir lo que sentí al sentir semejante poder puro. No, era más que eso; era poder real. Miré hacia arriba, hacia esas nubes oscuras y arremolinadas que brillaban con furiosos relámpagos, y vi lo que mis antepasados habían buscado con tanta desesperación.",shape=box,color=blue];
		1077 -> 1076;
	1078 [label="¿Pero sentir semejante poder puro? No, era más que eso; era poder real. Miré hacia arriba, hacia esas nubes oscuras y arremolinadas que brillaban con furiosos relámpagos, y vi lo que mis antepasados habían buscado con tanta desesperación.",shape=box,color=blue];
		1078 -> 1076;
	1079 [label="Sin embargo, creo que, como en todo en la vida, la moderación y una combinación de ambas son la clave del éxito. Atiborrarse de una puede llevar a abandonar la otra.",shape=box,color=blue];
		1079 -> 1081;
	1080 [label="Me aterrorizó. Sentí miedo, Viajero. Miedo. Por primera vez en... siglos, ¿quizás?",shape=box,color=blue];
		1080 -> 1082;
		1080 -> 1083;
	1081 [label="Así es como creamos criaturas como Ballas y Nitokh, me temo. El Manipulador y la Reina Sangrienta. Bah.",shape=box,color=blue];
		1081 -> 1084;
	1082 [label="¿Tienes miedo de morir?",shape=box,color=red];
		1082 -> 1085;
	1083 [label="¿Qué hiciste?",shape=box,color=red];
		1083 -> 1086;
	1084 [label="Pero vine aquí a hablar de tormentas.",shape=box,color=blue];
		1084 -> 1059;
	1085 [label="¡Sí, así parece! Bastante, debo añadir. Y esto fue un descubrimiento para mí en ese momento. No temo lo que viene después de la muerte, Viajero. Simplemente aún no deseo que mi vida termine. No he terminado de vivirla.",shape=box,color=blue];
		1085 -> 1087;
	1086 [label="Subí a la balaustrada de piedra junto a la gárgola nudosa y extendí los brazos a los costados, y... reí. Reí en medio de la tormenta.",shape=box,color=blue];
		1086 -> 1088;
	1087 [label="Lo cual fue toda una revelación. Subí al balaustre de piedra junto a la gárgola nudosa y extendí los brazos a los costados, y... reí. Reí en medio de la tormenta.",shape=box,color=blue];
		1087 -> 1089;
	1088 [label="Porque de repente supe que no temo lo que viene después de la muerte, Viajero. Simplemente aún no deseo que mi vida termine. No he terminado de vivirla.",shape=box,color=blue];
		1088 -> 1089;
	1089 [label="A pesar de todo. A pesar de la desolación de Tau. A pesar de la destrucción del Imperio Orokin que sabía que era inevitable. A pesar de la perversión de mi cuerpo en... este desastre. A pesar de haber sido arrojado al pasado y abandonado a mi suerte.",shape=box,color=blue];
		1089 -> 1090;
	1090 [label="Sabía que encontraría la manera de volver aquí. A este tiempo. A este lugar. A donde Albrecht había dejado todas sus cosas más preciadas.",shape=box,color=blue];
		1090 -> 1091;
	1091 [label="+5 Chemistry",color=orange];
		1091 -> 1092;
	1092 [label="Porque aún no he terminado mi vida. Pero, por Dios, me aseguraré de que él termine la suya.",shape=box,color=blue];
		1092 -> 1093;
	1093 [label="Update boolean RoatheEntrati1",color=orange];
		1093 -> 1094;
	1094 [label="Chat ends.",color=orange];
}