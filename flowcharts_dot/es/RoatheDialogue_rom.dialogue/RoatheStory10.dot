	"Chat ends." [color=orange];
	j1657357631 [label="VM: PUNISHMENT",shape=box,color=blue];
		j1657357631 -> j3904075398;
	j3904075398 [label="Transcripción: Fue Scarne, irascible, cerebral y cáustico, quien propuso el plan en los días previos a la guerra. \"Debemos abandonar el nido, porque el nido está en llamas\".",shape=box,color=blue];
		j3904075398 -> j2746210180;
	j2746210180 [label="A través de la sobreexplotación y la experimentación imprudente, habíamos contaminado el Sistema hasta dejarlo sin esperanza de regeneración.",shape=box,color=blue];
		j2746210180 -> j732158652;
	j732158652 [label="Expandirnos hacia nuevos horizontes era ahora nuestra única opción. ",shape=box,color=blue];
		j732158652 -> j2971339485;
	j2971339485 [label="He, too, inaugurated the cowardly Towers in the Void.",shape=box,color=blue];
		j2971339485 -> j3895842785;
	j3895842785 [label="Su miedo al regreso de los conscientes era tal que sólo podía imaginar retirarse a las islas del Mar del Vacío.",shape=box,color=blue];
		j3895842785 -> j1078327309;
	j1078327309 [label="How little credit we gave the Sentients for courage.",shape=box,color=blue];
		j1078327309 -> j1060071859;
	j1060071859 [label="They willingly endured the Void’s scalding fire purely for the chance to punish us.",shape=box,color=blue];
		j1060071859 -> j921430358;
	j921430358 [label="Add 1 to HellStory counter",color=orange];
		j921430358 -> "Chat ends.";
}