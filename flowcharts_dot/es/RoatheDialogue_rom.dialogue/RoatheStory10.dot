	j1955784272 [label="MV: CASTIGO",shape=box,color=blue];
		j1955784272 -> j2392839924;
	j2392839924 [label="Transcripción: Fue Scarne, irascible, cerebral y cáustico, quien propuso el plan en los días previos a la guerra. \"Debemos abandonar el nido, porque el nido está en llamas\".",shape=box,color=blue];
		j2392839924 -> j884793638;
	j884793638 [label="A través de la sobreexplotación y la experimentación imprudente, habíamos contaminado el Sistema hasta dejarlo sin esperanza de regeneración.",shape=box,color=blue];
		j884793638 -> j3365933944;
	j3365933944 [label="Expandirnos hacia nuevos horizontes era ahora nuestra única opción. ",shape=box,color=blue];
		j3365933944 -> j2608089418;
	j2608089418 [label="Él también inauguró las cobardes torres en el Vacío.",shape=box,color=blue];
		j2608089418 -> j1373857210;
	j1373857210 [label="Su miedo al regreso de los conscientes era tal que sólo podía imaginar retirarse a las islas del Mar del Vacío.",shape=box,color=blue];
		j1373857210 -> j4096551496;
	j4096551496 [label="¡Qué poco crédito dimos a los conscientes por su valentía!",shape=box,color=blue];
		j4096551496 -> j1519407726;
	j1519407726 [label="Ellos soportaron voluntariamente el fuego abrasador del Vacío únicamente para tener la oportunidad de castigarnos.",shape=box,color=blue];
		j1519407726 -> j921430358;
	j921430358 [label="Add 1 to HellStory counter",color=orange];
		j921430358 -> "Chat ends.";
}