digraph {
	"RoatheRank4Convo5 begins." [color=orange];
		"RoatheRank4Convo5 begins." -> j4129374649;
	j4129374649 [label="¿Qué recuerdas de tu tiempo en el imperio, Usurpador? Mis recuerdos son, como mínimo, fragmentarios. Pero no estoy en condiciones de juzgar.",shape=box,color=blue];
		j4129374649 -> j2758311029;
		j4129374649 -> j3487296469;
		j4129374649 -> j1112016479;
		j4129374649 -> j202800200;
	j2758311029 [label="Suficiente para saber que todos merecían arder.",shape=box,color=red];
		j2758311029 -> j1530949272;
	j3487296469 [label="Pedazos y fragmentos. ¿Por qué?",shape=box,color=red];
		j3487296469 -> j703792934;
	j1112016479 [label="Era muy joven cuando nos subieron a la Zariman. Y después de eso... bueno.",shape=box,color=red];
		j1112016479 -> j703792934;
	j202800200 [label="[Fin]",shape=box,color=red];
		j202800200 -> "Chat ends.";
	j1530949272 [label="Es bastante justo. Sin embargo, te estás perdiendo grandes partes de nuestra historia y de nuestros registros culturales. Sé que nos tenían poco cariño después de la caída, pero...",shape=box,color=blue];
		j1530949272 -> j3399153940;
	j703792934 [label="Hm. Me parece extraño que existan tan pocos registros completos de nuestra sociedad y nuestra cultura. Sé que hubo poco amor por nosotros después de la caída, pero...",shape=box,color=blue];
		j703792934 -> j673867129;
	"Chat ends." [color=orange];
	j3399153940 [label="¿Ni siquiera se menciona qué pasó con los crioleums?",shape=box,color=blue];
		j3399153940 -> j525893182;
		j3399153940 -> j1317200644;
	j673867129 [label="¿Ni siquiera se menciona qué pasó con los crioleums?",shape=box,color=blue];
		j673867129 -> j2469245454;
		j673867129 -> j1997222008;
	j525893182 [label="¿Esto terminará siendo alguna terrible forma de tortura orokin?",shape=box,color=red];
		j525893182 -> j1004140690;
	j1317200644 [label="Siento que recordaría esa palabra si la hubiera escuchado antes.",shape=box,color=red];
		j1317200644 -> j957164744;
	j2469245454 [label="Los... ¿qué?",shape=box,color=red];
		j2469245454 -> j2566448037;
	j1997222008 [label="Siento que recordaría esa palabra si la hubiera escuchado antes.",shape=box,color=red];
		j1997222008 -> j2566448037;
	j1004140690 [label="¿Sorprendente? No. Quizás sea porque últimamente he pasado... demasiados años encerrado en una cripta con estos dos fanáticos, pero me sorprende que ningún documento sobre cómo los orokin trataban a sus muertos haya sobrevivido a través de los milenios.",shape=box,color=blue];
		j1004140690 -> j602095504;
		j1004140690 -> j4090581871;
	j957164744 [label="Quizás sea porque últimamente he pasado... demasiados años encerrado en una cripta con estos dos fanáticos, pero me sorprende que ningún documento sobre cómo los orokin trataban a sus muertos haya sobrevivido a través de los milenios.",shape=box,color=blue];
		j957164744 -> j3330344137;
		j957164744 -> j294278562;
	j2566448037 [label="Quizás sea porque últimamente he pasado... demasiados años encerrado en una cripta con estos dos fanáticos, pero me sorprende que ningún documento sobre cómo los orokin trataban a sus muertos haya sobrevivido a través de los milenios.",shape=box,color=blue];
		j2566448037 -> j4019082095;
		j2566448037 -> j1441578270;
	j602095504 [label="No pensé que hubieras muerto. Sólo robabas cuerpos nuevos en el teatro Yuvan.",shape=box,color=red];
		j602095504 -> j2228828047;
	j4090581871 [label="Creí que habías robado humanos para resolver ese problema. Sólo fingías estar muerto.",shape=box,color=red];
		j4090581871 -> j1331947679;
	j3330344137 [label="No pensé que hubieras muerto. Sólo robabas cuerpos nuevos en el teatro Yuvan.",shape=box,color=red];
		j3330344137 -> j2228828047;
	j294278562 [label="Continúa.",shape=box,color=red];
		j294278562 -> j1749605917;
	j4019082095 [label="No pensé que hubieras muerto. Sólo robabas cuerpos nuevos en el teatro Yuvan.",shape=box,color=red];
		j4019082095 -> j1376604664;
	j1441578270 [label="Continúa.",shape=box,color=red];
		j1441578270 -> j1302276298;
	j2228828047 [label="Yes, but what about everyone else who were \"close\" but \"not quite important enough?\" The Archimedeans? Or the lower-ranked Orokin? There were always tiers within tiers. Even if the ceilings were glass, they existed. Believe me.",shape=box,color=blue];
		j2228828047 -> j3810945145;
	j1331947679 [label="Indeed we did. At every possible turn. But not all were spared, were they? What about those who were \"close\" but \"not important enough?\" The Archimedeans? The lesser-ranked Orokin?",shape=box,color=blue];
		j1331947679 -> j3244054906;
	j1749605917 [label="Consider all those who were \"close\" but \"not quite important enough.\" The Archimedeans. The lower-ranked Orokin. There were always tiers within tiers. Even if the ceilings were glass, they existed. Believe me.",shape=box,color=blue];
		j1749605917 -> j3810945145;
	j1376604664 [label="Yes, but what about everyone else who were \"close\" but \"not quite important enough?\" The Archimedeans? Or the lower-ranked Orokin? There were always tiers within tiers. Even if the ceilings were glass, they existed. Believe me.",shape=box,color=blue];
		j1376604664 -> j3386554659;
	j1302276298 [label="Consider all those who were \"close\" but \"not quite important enough.\" The Archimedeans. The lower-ranked Orokin. There were always tiers within tiers. Even if the ceilings were glass, they existed. Believe me.",shape=box,color=blue];
		j1302276298 -> j3386554659;
	j3810945145 [label="Not all were so lucky as to be gifted new flesh each time their old form burned low. But I am certain you find the Yuvan Theatre a disgusting practice, don't you?",shape=box,color=blue];
		j3810945145 -> j3201520987;
		j3810945145 -> j3213692862;
	j3244054906 [label="Not all were so lucky as to be gifted new flesh each time their old form burned low. Clearly, you believe the Yuvan Theatre a disgusting practice.",shape=box,color=blue];
		j3244054906 -> j4067593492;
		j3244054906 -> j3213692862;
	j3386554659 [label="Not all were so lucky as to be gifted new flesh each time their old form burned low. But I am certain you find the Yuvan Theatre a disgusting practice, don't you?",shape=box,color=blue];
		j3386554659 -> j1665998416;
		j3386554659 -> j2060000293;
	j3201520987 [label="I don't know enough about the practice to make a judgement call.",shape=box,color=red];
		j3201520987 -> j2489545060;
	j3213692862 [label="I do. I think it's disgusting what you all did. Everything written about the Yuvan Theatre says you stole children and wiped out their minds.",shape=box,color=red];
		j3213692862 -> j3235289059;
	j4067593492 [label="How could I not? You abducted children from their homes and wiped out their minds to replace them with their own!",shape=box,color=red];
		j4067593492 -> j1245956621;
	j1665998416 [label="I don't know enough about the practice to make a judgement call.",shape=box,color=red];
		j1665998416 -> j2009118751;
	j2060000293 [label="I do. I think it's disgusting what you all did. Everything written about the Yuvan Theatre says you stole children and wiped out their minds.",shape=box,color=red];
		j2060000293 -> j300578784;
	j2489545060 [label="+5 Chemistry",color=orange];
		j2489545060 -> j602899289;
	j3235289059 [label="\"Everything written about the Yuvan Theatre says.\" Where are all these things recorded? More importantly, who has written all these things?",shape=box,color=blue];
		j3235289059 -> j40588251;
	j1245956621 [label="And how do you know all this? Did you witness a Yuvan Theatre yourself?",shape=box,color=blue];
		j1245956621 -> j2666037334;
		j1245956621 -> j3590819762;
		j1245956621 -> j684981455;
	j2009118751 [label="+5 Chemistry",color=orange];
		j2009118751 -> j602899289;
	j300578784 [label="Yet you just said only shards of our history and cultural records remain. And where are all these things recorded? More importantly, who has written all these things?",shape=box,color=blue];
		j300578784 -> j40588251;
	j602899289 [label="Withholding judgement until you have all the information? Egads, Usurper! You sound intelligent! What a rarity!",shape=box,color=blue];
		j602899289 -> j1955809779;
	j40588251 [label="They are stories told by those who have a distinct interest in rendering every aspect of the Orokin in as disastrous and evil a light as possible.",shape=box,color=blue];
		j40588251 -> j3684004845;
	j2666037334 [label="No.",shape=box,color=red];
		j2666037334 -> j4219092973;
	j3590819762 [label="Yes.",shape=box,color=red];
		j3590819762 -> j3425881201;
	j684981455 [label="It doesn't matter if I did or didn't, the accounts are clear.",shape=box,color=red];
		j684981455 -> j3240383241;
	j1955809779 [label="Allow me to shift the lens of history for you then, if I may. Consider where the accounts of the Yuvan Theatre that you may have heard originate.",shape=box,color=blue];
		j1955809779 -> j40588251;
	j3684004845 [label="For those who tear down all the support structures of the very society of the Origin System and send it reeling into utter chaos must give those who rely upon that society a good reason for doing so.",shape=box,color=blue];
		j3684004845 -> j4190190754;
	j4219092973 [label="Then you are relying on second-hand stories. Consider where are these accounts are written. More importantly, consider who has written them.",shape=box,color=blue];
		j4219092973 -> j40588251;
	j3425881201 [label="Ha! Liar. ",shape=box,color=blue];
		j3425881201 -> j2508129281;
	j3240383241 [label="Are they? Consider where are these accounts are written. More importantly, consider who has written all these accounts.",shape=box,color=blue];
		j3240383241 -> j40588251;
	j4190190754 [label="Consider life for the average human on a relay, Usurper. One far away from the trials and tribulations of the Tenno. One who cared nothing for the Great War.",shape=box,color=blue];
		j4190190754 -> j2246635666;
	j2508129281 [label="You are relying on second-hand stories. Consider where are these accounts are written. More importantly, consider who has written them.",shape=box,color=blue];
		j2508129281 -> j40588251;
	j2246635666 [label="When the Orokin fell, their lives were pitched into pure hell in the power vacuum that followed. Explanations had to be concocted. Effigies had to be made and burned. We had to be made the monsters in the dark.",shape=box,color=blue];
		j2246635666 -> j3353434062;
		j2246635666 -> j2560386247;
	j3353434062 [label="Are you telling me that you didn't abduct children for the Yuvan Theatre against their will?",shape=box,color=red];
		j3353434062 -> j1470343056;
	j2560386247 [label="So what really happened at the Yuvan Theatre?",shape=box,color=red];
		j2560386247 -> j841010804;
	j1470343056 [label="No, that is entirely correct.",shape=box,color=blue];
		j1470343056 -> j371106761;
	j841010804 [label="+5 Chemistry",color=orange];
		j841010804 -> j3305857468;
	j371106761 [label="I just want you to consider your sources, is all.",shape=box,color=blue];
		j371106761 -> j3737657197;
	j3305857468 [label="To say that we did not take sacrifices against their will is incorrect. We did. But it is not the whole truth. These things are rarely so simple and they are never so black and white.",shape=box,color=blue];
		j3305857468 -> j2788565059;
	j3737657197 [label="Because it is not the whole truth. These things are rarely so simple and never so black and white. The world is grey, Usurper. Lines are not so easily drawn. ",shape=box,color=blue];
		j3737657197 -> j4083287195;
	j2788565059 [label="The world is grey, Usurper. Lines are not so easily drawn.",shape=box,color=blue];
		j2788565059 -> j4083287195;
	j4083287195 [label="The practice did not start in such a shameful way. It was seen as the highest honor, at first. To give yourself up so that the Empire would continue unbroken. Unbent. So that the work could continue.",shape=box,color=blue];
		j4083287195 -> j3218645114;
	j3218645114 [label="Nor did it start with the young. It started with those who simply had more years to spend. But then those who offered themselves became... younger and younger. Devotion is a powerful drug.",shape=box,color=blue];
		j3218645114 -> j3987274366;
	j3987274366 [label="I saw something similar with those signing up for the war. Lying about their age on paperwork to \"fight the good fight.\" Little did they know they were setting a dangerous precedent for those who would unwillingly come after.",shape=box,color=blue];
		j3987274366 -> j3782643319;
	j3782643319 [label="As somewhere along the line, some Executor realized that it could be used as a... punitive measure. That certain cities or... whole planets could be kept in line if the threat of the Yuvan Theatre were used. If the collection of sacrifice were wielded in a particularly heavy-handed way.",shape=box,color=blue];
		j3782643319 -> j1575407642;
		j3782643319 -> j3565369713;
	j1575407642 [label="And how do you feel about this?",shape=box,color=red];
		j1575407642 -> j3825981622;
	j3565369713 [label="Have you ever partaken in an unwilling sacrifice?",shape=box,color=red];
		j3565369713 -> j1720676332;
	j3825981622 [label="+5 Chemistry",color=orange];
		j3825981622 -> j2838576366;
	j1720676332 [label="I will not lie to you. I have. And you can think me a monster for it all you like. But when your entire society is built upon   hundreds of years of the normalization of something, it is very hard to turn your back to it.",shape=box,color=blue];
		j1720676332 -> j3451896292;
	j2838576366 [label="Hm. Mixed. On one hand, I have partaken in the Theatre many times myself. I would be the ultimate hypocrite to condemn it. When your entire society is built upon hundreds of years of the normalization of something, it is very hard to turn your back to it.",shape=box,color=blue];
		j2838576366 -> j4073975224;
	j3451896292 [label="Even when in retrospect, or in a moment of clarity, it is so very clear. ",shape=box,color=blue];
		j3451896292 -> j2312338648;
	j4073975224 [label="On the other hand, in a vacuum, or in retrospect, the horror of the deed becomes quite clear.",shape=box,color=blue];
		j4073975224 -> j2312338648;
	j2312338648 [label="+5 Chemistry",color=orange];
		j2312338648 -> j2686348960;
	j2686348960 [label="No one should live forever, Usurper. And the Theatre is proof of why.",shape=box,color=blue];
		j2686348960 -> "Chat ends.";
}