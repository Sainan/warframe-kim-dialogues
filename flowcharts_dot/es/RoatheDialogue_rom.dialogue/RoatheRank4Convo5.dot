digraph {
	graph [fontname="Roboto Condensed"];
	node [fontname="Roboto Condensed"];
	edge [fontname="Roboto Condensed"];

	"RoatheRank4Convo5 begins." [color=orange];
		"RoatheRank4Convo5 begins." -> j4129374649;
	j4129374649 [label="¿Qué recuerdas de tu tiempo en el imperio, Usurpador? Mis recuerdos son, como mínimo, fragmentarios. Pero no estoy en condiciones de juzgar.",shape=box,color=blue];
		j4129374649 -> j2758311029;
		j4129374649 -> j3487296469;
		j4129374649 -> j1112016479;
		j4129374649 -> j202800200;
	j2758311029 [label="Suficiente para saber que todos merecían arder.",shape=box,color=red];
		j2758311029 -> j1530949272;
	j3487296469 [label="Pedazos y fragmentos. ¿Por qué?",shape=box,color=red];
		j3487296469 -> j703792934;
	j1112016479 [label="Era muy joven cuando nos subieron a la Zariman. Y después de eso... bueno.",shape=box,color=red];
		j1112016479 -> j703792934;
	j202800200 [label="[Fin]",shape=box,color=red];
		j202800200 -> "Chat ends.";
	j1530949272 [label="Es bastante justo. Sin embargo, te estás perdiendo grandes partes de nuestra historia y de nuestros registros culturales. Sé que nos tenían poco cariño después de la caída, pero...",shape=box,color=blue];
		j1530949272 -> j3399153940;
	j703792934 [label="Hm. Me parece extraño que existan tan pocos registros completos de nuestra sociedad y nuestra cultura. Sé que hubo poco amor por nosotros después de la caída, pero...",shape=box,color=blue];
		j703792934 -> j673867129;
	"Chat ends." [color=orange];
	j3399153940 [label="¿Ni siquiera se menciona qué pasó con los crioleums?",shape=box,color=blue];
		j3399153940 -> j525893182;
		j3399153940 -> j1317200644;
	j673867129 [label="¿Ni siquiera se menciona qué pasó con los crioleums?",shape=box,color=blue];
		j673867129 -> j2469245454;
		j673867129 -> j1997222008;
	j525893182 [label="¿Esto terminará siendo alguna terrible forma de tortura orokin?",shape=box,color=red];
		j525893182 -> j1004140690;
	j1317200644 [label="Siento que recordaría esa palabra si la hubiera escuchado antes.",shape=box,color=red];
		j1317200644 -> j957164744;
	j2469245454 [label="Los... ¿qué?",shape=box,color=red];
		j2469245454 -> j2566448037;
	j1997222008 [label="Siento que recordaría esa palabra si la hubiera escuchado antes.",shape=box,color=red];
		j1997222008 -> j2566448037;
	j1004140690 [label="¿Sorprendente? No. Quizás sea porque últimamente he pasado... demasiados años encerrado en una cripta con estos dos fanáticos, pero me sorprende que ningún documento sobre cómo los orokin trataban a sus muertos haya sobrevivido a través de los milenios.",shape=box,color=blue];
		j1004140690 -> j1723374838;
		j1004140690 -> j986765847;
	j957164744 [label="Quizás sea porque últimamente he pasado... demasiados años encerrado en una cripta con estos dos fanáticos, pero me sorprende que ningún documento sobre cómo los orokin trataban a sus muertos haya sobrevivido a través de los milenios.",shape=box,color=blue];
		j957164744 -> j4231415791;
		j957164744 -> j805817706;
	j2566448037 [label="Quizás sea porque últimamente he pasado... demasiados años encerrado en una cripta con estos dos fanáticos, pero me sorprende que ningún documento sobre cómo los orokin trataban a sus muertos haya sobrevivido a través de los milenios.",shape=box,color=blue];
		j2566448037 -> j3749842939;
		j2566448037 -> j426647359;
	j1723374838 [label="No pensé que hubieras muerto. Sólo robabas cuerpos nuevos en el teatro Yuvan.",shape=box,color=red];
		j1723374838 -> j2370400494;
	j986765847 [label="Creí que habías robado humanos para resolver ese problema. Sólo fingías estar muerto.",shape=box,color=red];
		j986765847 -> j2262876924;
	j4231415791 [label="No pensé que hubieras muerto. Sólo robabas cuerpos nuevos en el teatro Yuvan.",shape=box,color=red];
		j4231415791 -> j2370400494;
	j805817706 [label="Continúa.",shape=box,color=red];
		j805817706 -> j2473390520;
	j3749842939 [label="No pensé que hubieras muerto. Sólo robabas cuerpos nuevos en el teatro Yuvan.",shape=box,color=red];
		j3749842939 -> j520623209;
	j426647359 [label="Continúa.",shape=box,color=red];
		j426647359 -> j3380174276;
	j2370400494 [label="Sí, pero ¿qué pasa con todos los demás que eran \"cercanos\" pero \"no lo suficientemente importantes\"? ¿Los arquimedianos? ¿O los orokin de menor rango? Siempre había niveles dentro de los niveles. Incluso si los techos eran de cristal, existían. Créeme.",shape=box,color=blue];
		j2370400494 -> j3492109996;
	j2262876924 [label="Así fue. En cada oportunidad. Pero no todos se salvaron, ¿verdad? ¿Y qué hay de aquellos que eran \"cercanos\" pero \"no lo suficientemente importantes\"? ¿Los arquimedianos? ¿Los orokin de menor rango?",shape=box,color=blue];
		j2262876924 -> j228251714;
	j2473390520 [label="Piensa en todos los que eran \"cercanos\" pero \"no lo suficientemente importantes\". Los arquimedianos. Los orokin de menor rango. Siempre había niveles dentro de los niveles. Incluso si los techos eran de cristal, existían. Créeme.",shape=box,color=blue];
		j2473390520 -> j3492109996;
	j520623209 [label="Sí, pero ¿qué pasa con todos los demás que eran \"cercanos\" pero \"no lo suficientemente importantes\"? ¿Los arquimedianos? ¿O los orokin de menor rango? Siempre había niveles dentro de los niveles. Incluso si los techos eran de cristal, existían. Créeme.",shape=box,color=blue];
		j520623209 -> j2942706535;
	j3380174276 [label="Piensa en todos los que eran \"cercanos\" pero \"no lo suficientemente importantes\". Los arquimedianos. Los orokin de menor rango. Siempre había niveles dentro de los niveles. Incluso si los techos eran de cristal, existían. Créeme.",shape=box,color=blue];
		j3380174276 -> j2942706535;
	j3492109996 [label="No todos tuvieron la suerte de recibir nueva carne cada vez que su antigua forma se consumía. Pero estoy seguro de que el teatro Yuvan te parece una práctica repugnante, ¿no es así?",shape=box,color=blue];
		j3492109996 -> j3115341864;
		j3492109996 -> j1216093202;
	j228251714 [label="No todos tuvieron la suerte de recibir carne nueva cada vez que su antigua forma se consumía. Claramente, crees que el teatro Yuvan es una práctica repugnante.",shape=box,color=blue];
		j228251714 -> j1416400269;
		j228251714 -> j1216093202;
	j2942706535 [label="No todos tuvieron la suerte de recibir nueva carne cada vez que su antigua forma se consumía. Pero estoy seguro de que el teatro Yuvan te parece una práctica repugnante, ¿no es así?",shape=box,color=blue];
		j2942706535 -> j794411901;
		j2942706535 -> j2801671396;
	j3115341864 [label="No sé lo suficiente sobre la práctica como para poder emitir un juicio al respecto.",shape=box,color=red];
		j3115341864 -> j2605193313;
	j1216093202 [label="Sí. Me parece repugnante lo que hicieron. Todo lo que se ha escrito sobre el teatro Yuvan dice que robaron niños y les borraron la mente.",shape=box,color=red];
		j1216093202 -> j2940101557;
	j1416400269 [label="¿Cómo podría no pensar eso? ¡Sacaste a niños de sus hogares y borraste sus recuerdos para reemplazarlos con los tuyos!",shape=box,color=red];
		j1416400269 -> j2221120325;
	j794411901 [label="No sé lo suficiente sobre la práctica como para poder emitir un juicio al respecto.",shape=box,color=red];
		j794411901 -> j3086275002;
	j2801671396 [label="Sí. Me parece repugnante lo que hicieron. Todo lo que se ha escrito sobre el teatro Yuvan dice que robaron niños y les borraron la mente.",shape=box,color=red];
		j2801671396 -> j3936900875;
	j2605193313 [label="+5 Chemistry",color=orange];
		j2605193313 -> j157528282;
	j2940101557 [label="Todo lo escrito sobre el teatro Yuvan dice: \"¿dónde se registra todo esto?\". Y lo que es más importante, ¿quién lo escribió?",shape=box,color=blue];
		j2940101557 -> j615240149;
	j2221120325 [label="¿Y cómo sabes todo esto? ¿Viste tú mismo un teatro Yuvan?",shape=box,color=blue];
		j2221120325 -> j2013235216;
		j2221120325 -> j2241972054;
		j2221120325 -> j540960272;
	j3086275002 [label="+5 Chemistry",color=orange];
		j3086275002 -> j157528282;
	j3936900875 [label="Sin embargo, acabas de decir que sólo quedan fragmentos de nuestra historia y registros culturales. ¿Y dónde están registrados todos estos datos? Y, lo que es más importante, ¿quién los escribió?",shape=box,color=blue];
		j3936900875 -> j615240149;
	j157528282 [label="¿Retener tu juicio hasta tener toda la información? ¡Caramba, Usurpador! ¡Te viste inteligente! ¡Qué raro!",shape=box,color=blue];
		j157528282 -> j2838863763;
	j615240149 [label="Son historias contadas por aquellos que tienen un interés particular en presentar cada aspecto de los orokin bajo la luz más desastrosa y malvada posible.",shape=box,color=blue];
		j615240149 -> j3447992521;
	j2013235216 [label="No.",shape=box,color=red];
		j2013235216 -> j2871588871;
	j2241972054 [label="Sí.",shape=box,color=red];
		j2241972054 -> j3171785668;
	j540960272 [label="No importa si lo hice o no, las cuentas están claras.",shape=box,color=red];
		j540960272 -> j356542951;
	j2838863763 [label="Permíteme entonces cambiar el enfoque de la historia. Considera de dónde provienen los relatos del teatro Yuvan que quizás hayas escuchado.",shape=box,color=blue];
		j2838863763 -> j615240149;
	j3447992521 [label="Quienes derriban todas las estructuras de apoyo de la sociedad misma del Sistema Origen y la envían tambaleándose hacia el caos más absoluto deben darles a quienes dependen de esa sociedad una buena razón para hacerlo.",shape=box,color=blue];
		j3447992521 -> j2174630501;
	j2871588871 [label="Entonces estás confiando en historias de segunda mano. Considera dónde se escribieron estos relatos. Y, más importante aún, considera quién los escribió.",shape=box,color=blue];
		j2871588871 -> j615240149;
	j3171785668 [label="¡Ja! Mentira. ",shape=box,color=blue];
		j3171785668 -> j1014790556;
	j356542951 [label="¿Lo son? Considera dónde se escribieron estos relatos. Y, más importante aún, considera quién los escribió.",shape=box,color=blue];
		j356542951 -> j615240149;
	j2174630501 [label="Imagina la vida del humano promedio en un repetidor, Usurpador. Uno alejado de las tribulaciones de los tenno. Uno a quien la Gran Guerra le daba igual.",shape=box,color=blue];
		j2174630501 -> j1032940398;
	j1014790556 [label="Estás confiando en historias de segunda mano. Considera dónde se escribieron estos relatos. Y, más importante aún, considera quién los escribió.",shape=box,color=blue];
		j1014790556 -> j615240149;
	j1032940398 [label="Cuando los orokin cayeron, sus vidas se convirtieron en un infierno en el vacío de poder que siguió. Hubo que inventar explicaciones. Hubo que crear efigies y quemarlas. Tuvimos que convertirnos en los monstruos de la oscuridad.",shape=box,color=blue];
		j1032940398 -> j1705242020;
		j1032940398 -> j2267158195;
	j1705242020 [label="¿Me estás diciendo que no secuestraste a niños para el teatro Yuvan contra su voluntad?",shape=box,color=red];
		j1705242020 -> j3830638223;
	j2267158195 [label="Entonces, ¿qué pasó realmente en el teatro Yuvan?",shape=box,color=red];
		j2267158195 -> j1393275372;
	j3830638223 [label="No, eso es completamente correcto.",shape=box,color=blue];
		j3830638223 -> j400703394;
	j1393275372 [label="+5 Chemistry",color=orange];
		j1393275372 -> j2001098714;
	j400703394 [label="Sólo quiero que consideres tus fuentes, eso es todo.",shape=box,color=blue];
		j400703394 -> j2013085352;
	j2001098714 [label="Decir que no hicimos sacrificios contra su voluntad es incorrecto. Lo hicimos. Pero no es toda la verdad. Estas cosas rara vez son tan simples y nunca son tan claras.",shape=box,color=blue];
		j2001098714 -> j3438818485;
	j2013085352 [label="Porque esa no es toda la verdad. Las cosas rara vez son tan simples, nunca tan claras. El mundo es gris, Usurpador. Los límites no se trazan tan fácilmente.",shape=box,color=blue];
		j2013085352 -> j1565522121;
	j3438818485 [label="El mundo es gris, Usurpador. Los límites no se trazan tan fácilmente.",shape=box,color=blue];
		j3438818485 -> j1565522121;
	j1565522121 [label="La práctica no comenzó de forma tan vergonzosa. Al principio, se consideraba el mayor honor. Entregarse para que el imperio continuara inquebrantable. Inflexible. Para que la obra pudiera continuar.",shape=box,color=blue];
		j1565522121 -> j1859808730;
	j1859808730 [label="Y no empezó con los jóvenes. Empezó con quienes simplemente tenían más años por delante. Pero luego, los que se ofrecían eran... cada vez más jóvenes. La devoción es una droga poderosa.",shape=box,color=blue];
		j1859808730 -> j1272588376;
	j1272588376 [label="Vi algo similar con quienes se alistaban para la guerra. Mentían sobre su edad en los documentos para \"luchar por el bien\". No sabían que estaban sentando un precedente peligroso para quienes, sin querer, vendrían después.",shape=box,color=blue];
		j1272588376 -> j1085025133;
	j1085025133 [label="En algún momento, algún ejecutor se dio cuenta de que podría usarse como medida punitiva. Que ciertas ciudades o planetas enteros podrían mantenerse a raya si se usaba la amenaza del teatro Yuvan. Si la recolección de sacrificios se usaba con especial dureza.",shape=box,color=blue];
		j1085025133 -> j54378058;
		j1085025133 -> j3750655947;
	j54378058 [label="¿Y tú qué opinas sobre esto?",shape=box,color=red];
		j54378058 -> j1280189717;
	j3750655947 [label="¿Alguna vez has participado en un sacrificio involuntario?",shape=box,color=red];
		j3750655947 -> j111808577;
	j1280189717 [label="+5 Chemistry",color=orange];
		j1280189717 -> j3668091842;
	j111808577 [label="No te voy a mentir. Sí. Y podrás pensar que soy un monstruo, pero cuando tu sociedad entera se basa en cientos de años de normalizar algo, es muy difícil darle la espalda.",shape=box,color=blue];
		j111808577 -> j153874030;
	j3668091842 [label="Hm. Una mezcla. Por un lado, yo mismo he participado en el teatro muchas veces. Sería el colmo de la hipocresía condenarlo. Cuando toda una sociedad se basa en siglos de normalizar algo, es muy difícil darle la espalda.",shape=box,color=blue];
		j3668091842 -> j3829111625;
	j153874030 [label="Incluso en retrospectiva o en un momento de claridad, es muy claro. ",shape=box,color=blue];
		j153874030 -> j3500402510;
	j3829111625 [label="Por otra parte, en aislamiento o en retrospectiva, el horror del acto es bastante claro.",shape=box,color=blue];
		j3829111625 -> j3500402510;
	j3500402510 [label="+5 Chemistry",color=orange];
		j3500402510 -> j3766204944;
	j3766204944 [label="Nadie debería vivir para siempre, Usurpador. Y el teatro es prueba de ello.",shape=box,color=blue];
		j3766204944 -> "Chat ends.";
}