	j343797025 [label="Transcripción: Después de la primera invasión consciente del Sistema y la desastrosa respuesta orokin, reinó un curioso silencio.",shape=box,color=blue];
		j343797025 -> j4035343200;
	j4035343200 [label="No teníamos noticias de nuestra gente varada en Tau, y no había manera de saber si sus señales estaban siendo bloqueadas o si habían sido completamente destruidas.",shape=box,color=blue];
		j4035343200 -> j4087875114;
	j4087875114 [label="Me pidieron opiniones. Como estratega, se esperaba que comprendiera al enemigo.",shape=box,color=blue];
		j4087875114 -> j452560659;
	j452560659 [label="Los conscientes podrían haber destruido la terminal del raíl solar sobre Tau en cualquier momento y aún así el raíl seguiría operativo.",shape=box,color=blue];
		j452560659 -> j498835509;
	j498835509 [label="¿Por qué? ¿Qué ganaron dejando la puerta abierta?",shape=box,color=blue];
		j498835509 -> j784948629;
	j784948629 [label="¿Estaban unidos en su agresión o algunos aún esperaban una coexistencia pacífica?",shape=box,color=blue];
