		j313480356 -> j3136897973;
	j3136897973 [label="Check boolean LoidFamilyComplete",color=orange];
		j3136897973 -> "Chat ends." [label=true,color=green];
		j3136897973 -> j2677024412 [label=false,color=brown];
	j2677024412 [label="Ahora, creo que podemos pasar a nuestra siguiente batalla en la guerra, ¿no? El mayordomo.",shape=box,color=blue];
		j2677024412 -> j711690619;
	j711690619 [label="Yo, por mi parte, no puedo esperar.",shape=box,color=blue];
		j711690619 -> j1288719760;
