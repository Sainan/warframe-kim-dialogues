digraph {
	graph [fontname="Roboto Condensed"];
	node [fontname="Roboto Condensed"];
	edge [fontname="Roboto Condensed"];

	"RoatheRepair begins." [color=orange];
		"RoatheRepair begins." -> j2688688654;
	j2688688654 [label="Evaluate expressions",color=orange];
		j2688688654 -> j4058747650 [label="LyonRoatheFailFix, MarieRoatheFailFix",color=purple];
		j2688688654 -> "Chat ends." [label="false",color=purple];
	j4058747650 [label="¡Basta! Basta. ¡Me rindo! Paren el ataque, fanáticos. ¡Son peores que un kubrodon rabioso! Malditas criaturas, me siguen a todas partes. ¡Ni siquiera puedo dormir!",shape=box,color=blue];
		j4058747650 -> j583881079;
	"Chat ends." [color=orange];
	j583881079 [label="¡¿Qué?! ¡¿Qué es lo que quieres?!",shape=box,color=blue];
		j583881079 -> j3395208647;
		j583881079 -> j1533676131;
		j583881079 -> j2376556277;
	j3395208647 [label="Otra oportunidad para hablar contigo sobre el suero. Roathe, es hora de dejar de correr. ",shape=box,color=red];
		j3395208647 -> j1979205857;
	j1533676131 [label="Roathe. Tomar el suero no te convierte en un cobarde. Te convierte en el único orokin en pie. Acéptalo.",shape=box,color=red];
		j1533676131 -> j1420398166;
	j2376556277 [label="Roathe. Tomar el suero no te vuelve un cobarde. Te da otra oportunidad en vida. De marcar una verdadera diferencia.",shape=box,color=red];
		j2376556277 -> j62611055;
	j1979205857 [label="Evaluate expressions on Thermostat counter",color=orange];
		j1979205857 -> j3314301400 [label="x >= 5",color=purple];
		j1979205857 -> j3483848278 [label="x <= 0",color=purple];
		j1979205857 -> j3874493566 [label="x > 0 && x < 5",color=purple];
		j1979205857 -> j3874493566 [label="false",color=purple];
	j1420398166 [label="Add -5 to Thermostat counter",color=orange];
		j1420398166 -> j1979205857;
	j62611055 [label="Add 5 to Thermostat counter",color=orange];
		j62611055 -> j1979205857;
	j3314301400 [label="Estás dejando que esa ira te desgarre por dentro. Podrías usarla para ayudarte a luchar contra quienes siguen destruyendo este mundo hoy. Aquí. Ahora.",shape=box,color=red];
		j3314301400 -> j4077107194;
	j3483848278 [label="Lo estás dirigiendo a ti mismo. Deberías dirigirlo al mundo que te culpa por hacer todo lo posible para salvarlo del Imperio orokin.",shape=box,color=red];
		j3483848278 -> j272772416;
	j3874493566 [label="¿Por eso los convenciste de que me molestaran día y noche? ¿Para eso? ¿Un último intento desesperado por convencerme de escuchar tu patético argumento?",shape=box,color=blue];
		j3874493566 -> j3574470448;
	j4077107194 [label="Tu pasado no te define, Roathe. Te define tu futuro. Y aún tienes un futuro por delante, a diferencia de todos los orokin que murieron en la Noche de los Tambores Naga.",shape=box,color=red];
		j4077107194 -> j1153691145;
	j272772416 [label="No te definen las opiniones de quienes te rodean ni lo que piensan de tus acciones. Sólo te define lo que piensas de ti mismo y de tus decisiones.",shape=box,color=red];
		j272772416 -> j1543395;
	j3574470448 [label="No.",shape=box,color=blue];
		j3574470448 -> j1596339778;
	j1153691145 [label="Eso es lo único que te define ahora. Puedes cambiar. Y puedes cambiar el mundo que te rodea. Supongo que mi única pregunta es: ¿al menos lo intentarás?",shape=box,color=red];
		j1153691145 -> j2181204613;
	j1543395 [label="Y la simple verdad es que eres uno de los pocos orokin que conocemos que sobrevivió a la Noche de los Tambores Naga. Desde mi punto de vista, fue una retirada estratégica.",shape=box,color=red];
		j1543395 -> j53226823;
	j1596339778 [label="Tu fracaso es patético. No una vez, sino dos veces.",shape=box,color=blue];
		j1596339778 -> j1746150695;
	j2181204613 [label="Intenta perdonarte a ti mismo y ¿sigue adelante?",shape=box,color=red];
		j2181204613 -> j3252383931;
	j53226823 [label="Nada más. Nada menos.",shape=box,color=red];
		j53226823 -> j1142399194;
	j1746150695 [label="No te recomendaría postularte para un cargo público.",shape=box,color=blue];
		j1746150695 -> "Chat ends.";
	j3252383931 [label="Boolean RoatheRedeemed is now true.",color=orange];
		j3252383931 -> j2903276302;
	j1142399194 [label="Boolean RoatheVillain is now true.",color=orange];
		j1142399194 -> j1402461415;
	j2903276302 [label="+20 Chemistry",color=orange];
		j2903276302 -> j764496372;
	j1402461415 [label="+20 Chemistry",color=orange];
		j1402461415 -> j2242278510;
	j764496372 [label="¿Perdonarme por lo que he hecho? ¿Y avanzar hacia el futuro? Mmm.",shape=box,color=blue];
		j764496372 -> j2576195924;
	j2242278510 [label="Una retirada para ganar la guerra. Hm. ",shape=box,color=blue];
		j2242278510 -> j1090571152;
	j2576195924 [label="Aunque dudo un poco de tu replanteamiento de la situación, estoy... demasiado tentado por este nuevo futuro y lo que podría significar para mí como para resistirlo, querido Viajero.",shape=box,color=blue];
		j2576195924 -> j1419077085;
	j1090571152 [label="Aunque soy... ligeramente escéptico de tu interpretación de los acontecimientos como una retirada táctica, confieso que... a pesar de eso, estoy a favor de ella, querido Viajero.",shape=box,color=blue];
		j1090571152 -> j3236930111;
	j1419077085 [label="Esta \"nueva oportunidad\" en mi vida. Muy bien. Concuerdo y acepto tu argumento. Aunque haya llegado tarde, fue... efectivo.",shape=box,color=blue];
		j1419077085 -> j2258580904;
	j3236930111 [label="Muy bien. Concuerdo y acepto tu argumento. Aunque haya llegado tarde, fue... efectivo.",shape=box,color=blue];
		j3236930111 -> j2258580904;
	j2258580904 [label="Te lo agradezco. Más de lo que te imaginas.",shape=box,color=blue];
		j2258580904 -> j757561088;
	j757561088 [label="Boolean RoatheFail is now false.",color=orange];
		j757561088 -> j2141078128;
	j2141078128 [label="Boolean RoatheFamilyFail is now false.",color=orange];
		j2141078128 -> j313480356;
