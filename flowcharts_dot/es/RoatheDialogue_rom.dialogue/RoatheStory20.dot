	"Chat ends." [color=orange];
	j3000022333 [label="VM: SUBMISSION",shape=box,color=blue];
		j3000022333 -> j1200599396;
	j1200599396 [label="Transcript: I understood from the start - both on the battlefield and in the bedchamber - the path to victory through seeming submission.",shape=box,color=blue];
		j1200599396 -> j3842930526;
	j3842930526 [label="Where the enemy finds you yielding, there you can be sure he will push; and so you may easily trip him.",shape=box,color=blue];
		j3842930526 -> j2361522726;
	j2361522726 [label="“Lackey,” they called me. “Lapdog.” Nitokh thought herself in control. How subtly I guided her. ",shape=box,color=blue];
		j2361522726 -> j2066068126;
	j2066068126 [label="Roathe the bloody-handed. Roathe the ogre fattened on the bodies of his men. Spendthrift of lives.",shape=box,color=blue];
		j2066068126 -> j1862571462;
	j1862571462 [label="As if I battled only for the battle’s sake! No. The Orokin Empire must end.",shape=box,color=blue];
		j1862571462 -> j1227825750;
	j1227825750 [label="For that to happen, the war must continue. Only defeat, absolute and irrevocable, would topple those seven golden gargoyles.",shape=box,color=blue];
		j1227825750 -> j1413313184;
	j1413313184 [label="Not even Nitokh knew my true heart. She thought I aspired to rule alongside her",shape=box,color=blue];
		j1413313184 -> j921430358;
	j921430358 [label="Add 1 to HellStory counter",color=orange];
		j921430358 -> "Chat ends.";
}