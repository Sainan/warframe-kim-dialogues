	2312 [label="VM: SUBMISSION",shape=box,color=blue];
		2312 -> 2311;
	2315 [label="Chat ends.",color=orange];
	2311 [label="Transcript: I understood from the start - both on the battlefield and in the bedchamber - the path to victory through seeming submission.",shape=box,color=blue];
		2311 -> 5722;
	5722 [label="Where the enemy finds you yielding, there you can be sure he will push; and so you may easily trip him.",shape=box,color=blue];
		5722 -> 5723;
	5723 [label="“Lackey,” they called me. “Lapdog.” Nitokh thought herself in control. How subtly I guided her. ",shape=box,color=blue];
		5723 -> 2310;
	2310 [label="Roathe the bloody-handed. Roathe the ogre fattened on the bodies of his men. Spendthrift of lives.",shape=box,color=blue];
		2310 -> 2314;
	2314 [label="As if I battled only for the battle’s sake! No. The Orokin Empire must end.",shape=box,color=blue];
		2314 -> 5724;
	5724 [label="For that to happen, the war must continue. Only defeat, absolute and irrevocable, would topple those seven golden gargoyles.",shape=box,color=blue];
		5724 -> 2316;
	2316 [label="Not even Nitokh knew my true heart. She thought I aspired to rule alongside her",shape=box,color=blue];
		2316 -> 2309;
	2309 [label="Add 1 to HellStory",color=orange];
		2309 -> 2347;
	2347 [label="{\"Id\":2347,\"Incoming\":[2309],\"Outgoing\":[2313],\"GraphPos\":[4758,-3705],\"CompletionType\":1}",color=orange];
