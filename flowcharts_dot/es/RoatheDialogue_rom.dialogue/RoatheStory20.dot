	"Chat ends." [color=orange];
	j3762165209 [label="MV: ENVÍO",shape=box,color=blue];
		j3762165209 -> j1842974421;
	j1842974421 [label="Transcripción: Comprendí desde el principio que, tanto en el campo de batalla como en el dormitorio, la victoria llega a través de una sumisión fingida.",shape=box,color=blue];
		j1842974421 -> j1479060334;
	j1479060334 [label="Allí donde el enemigo te encuentre cediendo, puedes estar seguro de que te empujará, y así podrás hacerle tropezar fácilmente.",shape=box,color=blue];
		j1479060334 -> j1130042123;
	j1130042123 [label="\"Lacayo\", me llamaban. \"Perro faldero\". Nitokh creía tener el control. Con qué sutileza la guié. ",shape=box,color=blue];
		j1130042123 -> j4206487754;
	j4206487754 [label="Roathe, el de las manos ensangrentadas. Roathe, el ogro, engordado con los cuerpos de sus hombres. Despilfarrador de vidas.",shape=box,color=blue];
		j4206487754 -> j2291088182;
	j2291088182 [label="¡Como si solo luchara por luchar! No. El Imperio orokin debe terminar.",shape=box,color=blue];
		j2291088182 -> j3365981873;
	j3365981873 [label="Para que eso suceda, la guerra debe continuar. Sólo una derrota absoluta e irrevocable derribaría a esas siete gárgolas doradas.",shape=box,color=blue];
		j3365981873 -> j270664176;
	j270664176 [label="Ni siquiera Nitokh conocía mis verdaderas intenciones. Creía que aspiraba a gobernar junto a ella.",shape=box,color=blue];
		j270664176 -> j921430358;
	j921430358 [label="Add 1 to HellStory counter",color=orange];
		j921430358 -> "Chat ends.";
}