	"Chat ends." [color=orange];
	j2039378985 [label="MV: OROKIN",shape=box,color=blue];
		j2039378985 -> j652812959;
	j652812959 [label="Transcripción: Durante mucho tiempo, el Imperio orokin no tuvo enemigos. Su ejército sólo existía para satisfacer pequeñas rencillas, casa contra casa, ejecutor contra ejecutor.",shape=box,color=blue];
		j652812959 -> j1647562646;
	j1647562646 [label="Cuando los conscientes atacaron, descubrimos una unidad que nos había sido negada durante mucho tiempo. Los Dax desenvainaron sus espadas contra algo mucho más que un granjero desafiante o un comerciante ladrón.",shape=box,color=blue];
		j1647562646 -> j968198011;
	j968198011 [label="Los Emperadores, los gobernantes inmortales del imperio, cuyo poder residía en los ejecutores, despertaron tambaleándose en sus polvorientos tronos dorados.",shape=box,color=blue];
		j968198011 -> j2829795363;
	j2829795363 [label="¡Guerra, magnífica guerra! Por fin, el imperio significaba algo. Definido por una extinción más inminente que la muerte definitiva del Sol, bebimos profundamente del néctar de la vida.",shape=box,color=blue];
		j2829795363 -> j921430358;
	j921430358 [label="Add 1 to HellStory counter",color=orange];
		j921430358 -> "Chat ends.";
