	2150 [label="Transcripción: Durante mucho tiempo, el Imperio orokin no tuvo enemigos. Su ejército sólo existía para satisfacer pequeñas rencillas, casa contra casa, ejecutor contra ejecutor.",shape=box,color=blue];
		2150 -> 2153;
	2153 [label="Cuando los conscientes atacaron, descubrimos una unidad que nos había sido negada durante mucho tiempo. Los Dax desenvainaron sus espadas contra algo mucho más que un granjero desafiante o un comerciante ladrón.",shape=box,color=blue];
		2153 -> 2154;
	2154 [label="Los Emperadores, los gobernantes inmortales del imperio, cuyo poder residía en los ejecutores, despertaron tambaleándose en sus polvorientos tronos dorados.",shape=box,color=blue];
		2154 -> 5683;
	5683 [label="¡Guerra, magnífica guerra! Por fin, el imperio significaba algo. Definido por una extinción más inminente que la muerte definitiva del Sol, bebimos profundamente del néctar de la vida.",shape=box,color=blue];
