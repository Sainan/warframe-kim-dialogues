		"Initiate conversation LyonRoatheRepair in /Lotus/Types/Gameplay/1999Wf/Dialogue/LyonDialogue_rom.dialogue" -> "Chat ends.";
	j2084410280 [label="Es por el pasado que siento curiosidad por saber qué fue de ella. Quiero saber cómo terminó su historia, sólo eso. Si es que terminó.",shape=box,color=blue];
		j2084410280 -> j1169038958;
	j4108734261 [label="Perdóname, fuiste tú quien la mencionó. En verdad desconciertas, querido Viajero.",shape=box,color=blue];
		j4108734261 -> "Chat ends.";
	j3792942513 [label="Entonces podrás comprender por qué tengo curiosidad por saber qué fue de ella. Simplemente porque quiero saber cómo terminó su historia. Si es que terminó.",shape=box,color=blue];
		j3792942513 -> j1169038958;
	j1169038958 [label="Es difícil dejar ir a aquellos que han sido actores clave en tu historia, sin importar cuán venenosos sean.",shape=box,color=blue];
