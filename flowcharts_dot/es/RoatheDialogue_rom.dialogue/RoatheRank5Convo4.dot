	j430831646 [label="+5 Chemistry",color=orange];
		j430831646 -> j3792942513;
	j3819232530 [label="Eso no es del todo cierto. Ya no la amo. Ya no me importa si ella muere brutalmente por mi propia mano. Pero tengo una curiosidad irresistible por saber cómo terminó su historia.",shape=box,color=blue];
		j3819232530 -> j1169038958;
	j2108954412 [label="Es difícil creer que alguien con tanto gusto por la sangre y la muerte haya podido permanecer tan silencioso durante todos estos siglos.",shape=box,color=blue];
		j2108954412 -> j2855085812;
	"Initiate conversation MarieRoatheRepair in /Lotus/Types/Gameplay/1999Wf/Dialogue/MarieDialogue_rom.dialogue" [label="Initiate conversation MarieRoatheRepair in /Lotus/Types/Gameplay/1999Wf/Dialogue/MarieDialogue_rom.dialogue",color=orange];
