		j4089149034 -> j1518501701;
	j3154775284 [label="Espero que esto no te provoque celos. No es mi intención. Simplemente intento explicarte cuánto daño me causó.",shape=box,color=blue];
		j3154775284 -> j2428194111;
	j1558690021 [label="Sin ella, no sería lo que soy. Todo lo que sé, lo aprendí de ella. Ella le dio forma a la arcilla.",shape=box,color=blue];
