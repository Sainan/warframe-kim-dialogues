	j1518501701 [label="+5 Chemistry",color=orange];
		j1518501701 -> j1077416877;
	j2428194111 [label="Sin embargo, cuánto le debo, al mismo tiempo. Sin ella, no sería lo que soy. Todo lo que sé, lo aprendí de ella. Ella le dio forma a la arcilla.",shape=box,color=blue];
