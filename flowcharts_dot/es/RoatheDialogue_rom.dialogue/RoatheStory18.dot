	j216560091 [label="MV: TRAICIÓN",shape=box,color=blue];
		j216560091 -> j2391054016;
	j2391054016 [label="Transcripción: \"¿Paz?\"",shape=box,color=blue];
		j2391054016 -> j1043362153;
	j1043362153 [label="Su voz era como un cristal roto que rechinaba en mis oídos.",shape=box,color=blue];
		j1043362153 -> j1723786169;
	j1723786169 [label="La ejecutora Nitokh estaba disgustada. Había esperado una gloriosa escalada, batalla tras batalla, que culminaría en el éxtasis culminante de la muerte de los orokin.",shape=box,color=blue];
		j1723786169 -> j3287740110;
	j3287740110 [label="Después de lo cual saldría de su escondite y… bueno, ahí me queda especular. Quizás esperaba que la invitaran a compartir la confianza de los conscientes.",shape=box,color=blue];
		j3287740110 -> j2534024286;
	j2534024286 [label="O tal vez pensó que abandonarían los restos quemados y contaminados del Sistema Origen y la dejarían a ella para que creara su propio nuevo reino.",shape=box,color=blue];
		j2534024286 -> j4119668561;
	j4119668561 [label="De todas formas, la paz no se toleraría. Así que nos pusimos manos a la obra para socavarla.",shape=box,color=blue];
		j4119668561 -> j921430358;
	j921430358 [label="Add 1 to HellStory counter",color=orange];
		j921430358 -> "Chat ends.";
}