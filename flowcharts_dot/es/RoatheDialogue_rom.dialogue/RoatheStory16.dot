	"Chat ends." [color=orange];
	j1121782893 [label="MV: SACRIFICIO",shape=box,color=blue];
		j1121782893 -> j3293209189;
	j3293209189 [label="Transcripción: Traivon. Te vi arrojar tu Railjack a las fauces de Praghasa. Distraída, alimentándose con avidez de ti y de tus hombres, no se dio cuenta de que mi nave se alejaba a toda velocidad.",shape=box,color=blue];
		j3293209189 -> j954450999;
	j954450999 [label="Diste la vida por tu superior. Sentí tu altruismo como una bofetada.",shape=box,color=blue];
		j954450999 -> j1268210928;
	j1268210928 [label="Maryna. Me diste tu cuerpo. Juntos, en esa trinchera, bebimos Kuva. Me temblaban las manos y mi garganta herida supuraba, pero contuve suficientes gotas para que aguantara.",shape=box,color=blue];
		j1268210928 -> j3196178403;
	j3196178403 [label="Recuerdo tu último saludo. El desvanecimiento. Entonces, al abrir los ojos que habían sido tuyos, vi mi cadáver destripado, muerto en el barro.",shape=box,color=blue];
		j3196178403 -> j1708930454;
	j1708930454 [label="Rostig. Dijeron que hubo un problema durante la clonación. ¿Qué podría hacer que un grineer se quedara en su torreta mientras se quemaba vivo? ¡Hasta una rata tiene instinto de supervivencia!",shape=box,color=blue];
		j1708930454 -> j3162334861;
	j3162334861 [label="No. Tu \"defecto\" te colocó por encima de ellos.",shape=box,color=blue];
		j3162334861 -> j921430358;
	j921430358 [label="Add 1 to HellStory counter",color=orange];
		j921430358 -> "Chat ends.";
}