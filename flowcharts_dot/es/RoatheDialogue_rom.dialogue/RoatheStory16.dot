	2274 [label="Chat ends.",color=orange];
	2275 [label="Transcript: Traivon. I watched you hurl your Railjack into Praghasa’s maw. Distracted, feeding greedily on you and your men, she never noticed my own ship speeding away.",shape=box,color=blue];
		2275 -> 5713;
	5713 [label="You laid down your life for your superior officer. I felt your selflessness like a slap in the face.",shape=box,color=blue];
		5713 -> 5714;
	5714 [label="Maryna. You gave me your body. Together, in that trench, we drank Kuva. My hands shook and my gashed throat leaked, but I kept enough drops down for it to take.",shape=box,color=blue];
		5714 -> 2278;
	2278 [label="I remember your last salute. The fading. Then I blinked open the eyes that had been yours, and saw my gutted corpse dead in the mud.",shape=box,color=blue];
		2278 -> 2272;
	2272 [label="Rostig. Something wrong in the cloning process, they said. What else could make a Grineer stay at his turret while burning alive? Even a rat understands self-preservation!",shape=box,color=blue];
		2272 -> 2279;
	2279 [label="No. Your “defect” placed you above them.",shape=box,color=blue];
		2279 -> 2271;
	2271 [label="Add 1 to HellStory",color=orange];
		2271 -> 2343;
