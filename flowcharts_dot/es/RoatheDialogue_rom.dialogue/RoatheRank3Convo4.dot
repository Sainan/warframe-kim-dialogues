		1937 -> 1939;
	1936 [label="You, who has powers that I have never heard of being possessed by another being? Looping time itself. Creating pocket dimensions. Yet you are here... mending relationships.",shape=box,color=blue];
		1936 -> 1939;
	1938 [label="I am simply flabbergasted. I cannot comprehend it. Why? Why, when by all rights you could be ruling some universe somewhere?",shape=box,color=blue];
		1938 -> 1940;
