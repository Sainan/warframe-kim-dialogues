		1933 -> 1936 [label=false,color=brown];
	1935 [label="You, who has powers that I have never heard of being possessed by another being? Looping time itself. Creating pocket dimensions. Yet you are here... mending relationships. (And collecting a few of your own.)",shape=box,color=blue];
		1935 -> 1938;
	1934 [label="You, who has powers that I have never heard of being possessed by another being? Looping time itself. Creating pocket dimensions. Yet you are here... mending relationships.",shape=box,color=blue];
