	j3540963012 [label="Dime. ",shape=box,color=red];
		j3540963012 -> j1512712339;
	j471949743 [label="¿Qué podría estar molestándote?",shape=box,color=red];
		j471949743 -> j4109735845;
	j202800200 [label="[Fin]",shape=box,color=red];
		j202800200 -> "Chat ends.";
	j1512712339 [label="¿Por qué haces todo esto?",shape=box,color=blue];
		j1512712339 -> j3524964328;
	j4109735845 [label="Podría recitar la lista, pero me temo que estaríamos aquí toda la tarde. No, mi línea de preguntas al respecto se centra en un tema en particular. Al menos por hoy.",shape=box,color=blue];
		j4109735845 -> j1512712339;
	"Chat ends." [color=orange];
	j3524964328 [label="Check boolean RoatheKnowsReset2",color=orange];
		j3524964328 -> j2959399763 [label=true,color=green];
		j3524964328 -> j2768280751 [label=false,color=brown];
	j2959399763 [label="Y no me refiero a que te entrometas en mis recuerdos. Me refiero a \"todo esto\" en un sentido más amplio.",shape=box,color=blue];
		j2959399763 -> j2768280751;
	j2768280751 [label="Check boolean LoidFamilyComplete",color=orange];
		j2768280751 -> j1541648434 [label=true,color=green];
		j2768280751 -> j1944457222 [label=false,color=brown];
	j1541648434 [label="Te empeñas en recorrer este universo detrás de Albrecht con un cubo de fregar. Mira tu trabajo con su mayordomo. ",shape=box,color=blue];
		j1541648434 -> j2476974658;
	j1944457222 [label="Te empeñas en recorrer este universo detrás de Albrecht con un cubo de fregar.",shape=box,color=blue];
		j1944457222 -> j2476974658;
	j2476974658 [label="Check boolean IsDating",color=orange];
		j2476974658 -> j3902929326 [label=true,color=green];
		j2476974658 -> j1727803672 [label=false,color=brown];
	j3902929326 [label="Parece que tienes tus propias curiosidades por satisfacer mientras tanto, y te aplaudo por ello, no te estoy juzgando. Simplemente me parece extraño que alguien tan... maravillosa y tremendamente perverso sea tan obediente. ",shape=box,color=blue];
		j3902929326 -> j1430756039;
		j3902929326 -> j2437050974;
		j3902929326 -> j1445835587;
	j1727803672 [label="Simplemente me parece extraño que alguien tan... maravillosa y tremendamente perverso sea tan obediente. ",shape=box,color=blue];
		j1727803672 -> j1430756039;
		j1727803672 -> j2437050974;
		j1727803672 -> j1445835587;
	j1430756039 [label="Dejar que la Indiferencia destruya el Sistema Origen, o cualquier otro lugar, no ayuda a nadie.",shape=box,color=red];
		j1430756039 -> j39007351;
	j2437050974 [label="Yo no obedezco a Entrati.",shape=box,color=red];
		j2437050974 -> j267883034;
	j1445835587 [label="Tengo mis propias razones. Y son sólo mías.",shape=box,color=red];
		j1445835587 -> j1085112859;
	j39007351 [label="Ah, ya veo. Es solo un servicio temporal que prestas hasta que se resuelva la situación con \"la Indiferencia\". ¿Y qué planeas hacer después?",shape=box,color=blue];
		j39007351 -> j2473349945;
		j39007351 -> j95968681;
		j39007351 -> j4164089794;
		j39007351 -> j4146803381;
		j39007351 -> j2401331539;
	j267883034 [label="¿De verdad? Desde donde estoy, eso parece. Él chasquea los dedos y tú te sientas a sus pies como un kubrow entrenado. Incluso susurra el nombre \"Tau\" y todos se esfuerzan por recordar cada detalle del lugar que han perdido.",shape=box,color=blue];
		j267883034 -> j1565079792;
		j267883034 -> j187195131;
	j1085112859 [label="¡Tan misterioso, tan inescrutable! Qué montón de tonterías. Si no quieres simplemente admitir que estás a su entera disposición, que así sea.",shape=box,color=blue];
		j1085112859 -> j4237192154;
	j2473349945 [label="¿Por qué insistes en esto? ¿Qué intentas preguntarme?",shape=box,color=red];
		j2473349945 -> j860129927;
	j95968681 [label="Honestamente, no he pensado tan a futuro.",shape=box,color=red];
		j95968681 -> j2210649174;
	j4164089794 [label="Le haré pagar por haber causado semejante desastre. Tiene mucho que expiar. ",shape=box,color=red];
		j4164089794 -> j1640349298;
	j4146803381 [label="Suponiendo que sobreviva, ¿verdad?",shape=box,color=red];
		j4146803381 -> j3012110623;
	j2401331539 [label="Voy donde me necesitan, como siempre. Los problemas suelen encontrarme.",shape=box,color=red];
		j2401331539 -> j3849075511;
	j1565079792 [label="¿Por qué te esfuerzas por hacerme enojar?",shape=box,color=red];
		j1565079792 -> j739872027;
	j187195131 [label="Sólo estoy haciendo lo que tengo que hacer para ayudar a las personas a salir de las situaciones miserables en las que se encuentran.",shape=box,color=red];
		j187195131 -> j3415886665;
	j4237192154 [label="Porque desde donde estoy, pareciera que él chasquea los dedos y tú te sientas a sus pies como un kubrow entrenado. Incluso susurra el nombre \"Tau\" y todos se esfuerzan por recordar cada detalle del lugar que han perdido.",shape=box,color=blue];
		j4237192154 -> j1565079792;
		j4237192154 -> j187195131;
	j860129927 [label="+5 Chemistry",color=orange];
		j860129927 -> j2032290046;
	j2210649174 [label="¡Ah! ¡Admites que eres un idiota! Qué refrescante. Me encanta cuando los tontos dejan al descubierto su falta de ingenio, me facilita mucho la tarea de manipularlos.",shape=box,color=blue];
		j2210649174 -> j3213282679;
	j1640349298 [label="¡Ah! ¡Así que buscas una venganza vil y primitiva! Glorioso. Un animal rabioso, dispuesto a roer los huesos de quienes te han hecho daño.",shape=box,color=blue];
		j1640349298 -> j3207686325;
	j3012110623 [label="+5 Chemistry",color=orange];
		j3012110623 -> j3576283942;
	j3849075511 [label="Ah, ya veo. Apatía disfrazada de nobleza. No sabes dónde perteneces, dónde deberías estar, así que te disfrazas de \"sacrificio justo\" y obedeces a los demás.",shape=box,color=blue];
		j3849075511 -> j3355693915;
	j739872027 [label="Porque no puedo, en absoluto, comprender por qué tú, una entidad que, hasta donde puedo imaginar, proviene de una versión completamente distinta de la realidad, estás decidido a correr como un loco a través del tiempo y el espacio, \"jugando a ser terapeuta\".",shape=box,color=blue];
		j739872027 -> j2339109333;
	j3415886665 [label="Sí, ¡y eso nos lleva al meollo del asunto! ¿Por qué insistes en vagar por el tiempo y el espacio \"jugando a ser terapeuta\"? Tú, que eres una entidad que, por lo que puedo imaginar, proviene de una versión completamente distinta de la realidad. ",shape=box,color=blue];
		j3415886665 -> j2339109333;
	j2032290046 [label="Perspicaz. Sí, muy bien, iré al grano, seré directo. Intentaba hacerte enojar para ver si eso provocaba una respuesta más sincera.",shape=box,color=blue];
		j2032290046 -> j4098363841;
	j3213282679 [label="Eres como un kubrow que por fin ha atrapado un kaithe. No sabes qué hacer ahora que le has clavado los dientes en la pata.",shape=box,color=blue];
		j3213282679 -> j187195131;
		j3213282679 -> j1565079792;
	j3207686325 [label="Una de las motivaciones humanas más simples y antiguas. Y, por lo tanto, una de las más fáciles de comprender.",shape=box,color=blue];
		j3207686325 -> j187195131;
	j3576283942 [label="Nunca fuiste oficialmente un soldado y, sin embargo, oigo en tu voz el cansancio del más experimentado de todos.",shape=box,color=blue];
		j3576283942 -> j3810677706;
	j3355693915 [label="Qué tragedia.",shape=box,color=blue];
		j3355693915 -> j3108029706;
		j3355693915 -> j2357461612;
	j2339109333 [label="Si yo fuera tú, estaría de vuelta en Duviri intentando descubrir qué otros agujeros en el Vacío podría atravesar. ¡Imagina las posibilidades! ¡Imagina mundos que están listos para ser conquistados!",shape=box,color=blue];
		j2339109333 -> j3165034171;
		j2339109333 -> j1978818801;
	j4098363841 [label="Pero supongo que esto tendrá que bastar.",shape=box,color=blue];
		j4098363841 -> j1910315407;
	j3810677706 [label="Muy bien. De uno a otro, por respeto, iré al grano, seré directo. Intentaba hacerte enojar para ver si eso provocaba una respuesta más sincera.",shape=box,color=blue];
		j3810677706 -> j1910315407;
	j3108029706 [label="Tengo un lugar al que pertenezco.",shape=box,color=red];
		j3108029706 -> j4215323415;
	j2357461612 [label="No sabes de lo que estás hablando.",shape=box,color=red];
		j2357461612 -> j2411917921;
	j3165034171 [label="No eres diferente a Albrecht. Él viaja a través del tiempo causando todos estos problemas. ¿Y quieres hacerle eso a dimensiones enteras?",shape=box,color=red];
		j3165034171 -> j1097681717;
	j1978818801 [label="Ese es el problema con ustedes, orokin. Creen que mundos enteros son solo suyos para hacer con ellos lo que quieran. ",shape=box,color=red];
		j1978818801 -> j3544203175;
	j1910315407 [label="+5 Chemistry",color=orange];
		j1910315407 -> j2816289691;
	j4215323415 [label="¡Cuéntanos! ¿Es Höllvania? ¿O quizás Duviri? ¿O quizás tu orbitador estrellado en lo que queda de la Tierra?",shape=box,color=blue];
		j4215323415 -> j187195131;
		j4215323415 -> j1565079792;
	j2411917921 [label="¡Entonces dime dónde está tu hogar! ¿Es Höllvania? ¿O quizás Duviri? ¿O quizás tu orbitador estrellado en lo que queda de la Tierra?",shape=box,color=blue];
		j2411917921 -> j187195131;
		j2411917921 -> j1565079792;
	j1097681717 [label="¿Y por qué no deberíamos? Somos creaciones superiores, ¿no? Albrecht hace lo que quiere, ¡y tú no tienes problema en ir por ahí limpiando lo que deja! ¿Por qué no debería yo tener derecho a hacer lo mismo? ¿Qué hace que su búsqueda esté \"justificada\" y la mía no?",shape=box,color=blue];
		j1097681717 -> j4120657827;
	j3544203175 [label="¿Y por qué no deberíamos? Somos creaciones superiores, ¿no? Albrecht hace lo que quiere, arrasando el tiempo, infectando a la población con una enfermedad que apenas comprende, todo en nombre de \"derrotar a un supuesto dios\".",shape=box,color=blue];
		j3544203175 -> j4120657827;
	j2816289691 [label="No puedo, en absoluto, comprender por qué tú, una entidad que, hasta donde puedo imaginar, proviene de una versión completamente distinta de la realidad, estás decidido a correr como un loco a través del tiempo y el espacio, \"jugando a ser terapeuta\".",shape=box,color=blue];
		j2816289691 -> j3956801596;
	j4120657827 [label="¡Pero mírate! ",shape=box,color=blue];
		j4120657827 -> j965779903;
	j3956801596 [label="Check boolean IsDating",color=orange];
		j3956801596 -> j3982769662 [label=true,color=green];
		j3956801596 -> j2377485140 [label=false,color=brown];
	j965779903 [label="Check boolean IsDating",color=orange];
		j965779903 -> j3181534843 [label=true,color=green];
		j965779903 -> j2670669383 [label=false,color=brown];
	j3982769662 [label="Tú, que posees poderes que jamás he visto en ningún otro ser. Dominando el tiempo mismo. Creando dimensiones paralelas. Y, sin embargo, aquí estás... recomponiendo relaciones. (Y sumando unas para ti).",shape=box,color=blue];
		j3982769662 -> j122443587;
	j2377485140 [label="Tú, que posees poderes que jamás he visto en ningún otro ser. Dominando el tiempo mismo. Creando dimensiones paralelas. Y, sin embargo, aquí estás... recomponiendo relaciones.",shape=box,color=blue];
		j2377485140 -> j122443587;
	j3181534843 [label="Tú, que posees poderes que jamás he visto en ningún otro ser. Dominando el tiempo mismo. Creando dimensiones paralelas. Y, sin embargo, aquí estás... recomponiendo relaciones. (Y sumando unas para ti).",shape=box,color=blue];
		j3181534843 -> j1705074330;
	j2670669383 [label="Tú, que posees poderes que jamás he visto en ningún otro ser. Dominando el tiempo mismo. Creando dimensiones paralelas. Y, sin embargo, aquí estás... recomponiendo relaciones.",shape=box,color=blue];
		j2670669383 -> j1705074330;
	j122443587 [label="Estoy simplemente atónito. No lo puedo comprender. ¿Por qué? ¿Por qué, cuando con todo derecho podrías estar gobernando algún universo en algún lugar?",shape=box,color=blue];
		j122443587 -> j618668179;
		j122443587 -> j2820209603;
		j122443587 -> j3351905914;
	j1705074330 [label="Estoy simplemente atónito. No lo puedo comprender. ¿Por qué? ¿Por qué, cuando con todo derecho podrías estar gobernando algún universo en algún lugar?",shape=box,color=blue];
		j1705074330 -> j1230694792;
		j1705074330 -> j358635092;
		j1705074330 -> j3896592256;
	j618668179 [label="Estoy feliz con lo que hago. Ayudo a la gente como quiero.",shape=box,color=red];
		j618668179 -> j736843044;
	j2820209603 [label="No sé bien si puedes entender esto, pero inténtalo: No quiero gobernar un universo.",shape=box,color=red];
		j2820209603 -> j274681683;
	j3351905914 [label="No me haría mejor que Albrecht. O los orokin. Desatando el mundo a mi imagen y semejanza. No me interesa.",shape=box,color=red];
		j3351905914 -> j274681683;
	j1230694792 [label="Estoy feliz con lo que hago. Ayudo a la gente como quiero.",shape=box,color=red];
		j1230694792 -> j736843044;
	j358635092 [label="No sé bien si puedes entender esto, pero inténtalo: No quiero gobernar un universo.",shape=box,color=red];
		j358635092 -> j879971632;
	j3896592256 [label="No me haría mejor que Albrecht. O los orokin. Desatando el mundo a mi imagen y semejanza. No me interesa.",shape=box,color=red];
		j3896592256 -> j879971632;
	j736843044 [label="¿Pero por qué? Eso es lo que no entiendo.",shape=box,color=blue];
		j736843044 -> j1990388149;
	j274681683 [label="Entonces preferirías ser... ¿qué? ¿alguien insignificante?",shape=box,color=blue];
		j274681683 -> j258622057;
		j274681683 -> j3582392226;
	j879971632 [label="Entonces preferirías ser... ¿qué? ¿alguien insignificante?",shape=box,color=blue];
		j879971632 -> j3582392226;
		j879971632 -> j258622057;
	j1990388149 [label="Check boolean RoatheUnloved1",color=orange];
		j1990388149 -> j390474413 [label=true,color=green];
		j1990388149 -> j1385032937 [label=true,color=green];
		j1990388149 -> j1282390794 [label=true,color=green];
		j1990388149 -> j390474413 [label=false,color=brown];
		j1990388149 -> j1385032937 [label=false,color=brown];
		j1990388149 -> j35002173 [label=false,color=brown];
	j258622057 [label="Si crees que es poco hacer lo que yo hago, claro. Esa es tu opinión. Lo que he hecho ha reescrito la historia.",shape=box,color=red];
		j258622057 -> j2792212958;
	j3582392226 [label="Insignificante no. Invisible. Que todos corran por ahí llamando la atención. Yo me mantendré en las sombras.",shape=box,color=red];
		j3582392226 -> j1002015553;
	j390474413 [label="Porque ayudando a la gente cuando lo necesita es la manera en que vamos a salir de este lío al final.",shape=box,color=red];
		j390474413 -> j3258232255;
	j1385032937 [label="Porque hago lo que hay que hacer. Nada más y nada menos.",shape=box,color=red];
		j1385032937 -> j407942407;
	j1282390794 [label="Dijiste que nunca supiste lo que es ser amado. No creo que entiendas lo poderoso que puede ser para cambiar el funcionamiento del mundo que te rodea.",shape=box,color=red];
		j1282390794 -> j3891284984;
	j35002173 [label="¿Alguna vez te has enamorado, Roathe? ¿O te has preocupado tanto por alguien que quemarías el universo por esa persona?",shape=box,color=red];
		j35002173 -> j3883354572;
	j2792212958 [label="¡Ese es precisamente mi punto! ¡Vamos a reescribir la historia, entonces! ¡No nos quedemos aquí sentados intentando convencer a todos de tomarnos de la mano y empezar a cantar!",shape=box,color=blue];
		j2792212958 -> j3660021470;
		j2792212958 -> j4115250000;
		j2792212958 -> j1709835045;
	j1002015553 [label="Ah, ya veo, prefieres ser el asesino silencioso entre las sombras, ¿no? ¿Atacar cuando menos sospechen de ti? No. No lo creo. Creo que sólo estás perdiendo el tiempo.",shape=box,color=blue];
		j1002015553 -> j1413597701;
	j3258232255 [label="Mmm. ¿Hacer recados para desconocidos hasta que te adoren como a un héroe local? ¿O convencerlos a todos de tomarse de la mano y cantar canciones? Disculpa, voy a vomitar en el tanque de Fibonacci.",shape=box,color=blue];
		j3258232255 -> j119104589;
		j3258232255 -> j1551378436;
	j407942407 [label="Y lo que estás \"haciendo\" parece ser correr por ahí, convenciendo a todos de tomarse de la mano y cantar canciones entre espectáculos de increíble violencia. La violencia tiene sentido. El resto es nauseabundo. ",shape=box,color=blue];
		j407942407 -> j119104589;
		j407942407 -> j1551378436;
	j3891284984 [label="Si vas a insistir en que vamos a salvar al universo de esta \"Indiferencia\" tomándonos de la mano y cantando canciones, dame un minuto, voy a vomitar en el tanque de Fibonacci.",shape=box,color=blue];
		j3891284984 -> j405877857;
		j3891284984 -> j119104589;
		j3891284984 -> j1551378436;
	j3883354572 [label="Boolean RoatheUnloved1 is now true.",color=orange];
		j3883354572 -> j489170101;
	j3660021470 [label="Ten paciencia. Primero tenemos que lidiar con la Indiferencia.",shape=box,color=red];
		j3660021470 -> j1197418217;
	j4115250000 [label="Quizás, cuando todo esto pase. Pero no ahora.",shape=box,color=red];
		j4115250000 -> j1657870772;
	j1709835045 [label="¿Y crees que te elegiría para hacerlo juntos? No me hagas reír.",shape=box,color=red];
		j1709835045 -> j2419814799;
	j1413597701 [label="No sabes lo que haces ni por qué lo haces, simplemente haces lo que te ordenan. Otro secuaz engreído de un orokin engreído. Qué vergüenza.",shape=box,color=blue];
		j1413597701 -> "Chat ends.";
	j119104589 [label="Sólo digo que parece que en verdad te molesta la idea de que la gente ya no sea miserable. Y parece que te lo tomas muy a pecho.",shape=box,color=red];
		j119104589 -> j3716090167;
	j1551378436 [label="Lo que estaba tratando de plantear era simplemente que si \"la Indiferencia\" se alimenta de una falta de emociones, tenerlas podría ser la clave para derrotarla.",shape=box,color=red];
		j1551378436 -> j2572253886;
	j405877857 [label="¿Crees que es imposible que alguien te ame? ¿O crees que no eres capaz de amar a alguien más? ¿O crees que simplemente aún no ha sucedido?",shape=box,color=red];
		j405877857 -> j2664031001;
	j489170101 [label="No. Y si vas a insistir en que vamos a salvar al universo de esta \"Indiferencia\" tomándonos de la mano y cantando canciones, dame un minuto, voy a vomitar en el tanque de Fibonacci.",shape=box,color=blue];
		j489170101 -> j405877857;
		j489170101 -> j119104589;
		j489170101 -> j1551378436;
	j1197418217 [label="+5 Chemistry",color=orange];
		j1197418217 -> j1657870772;
	j1657870772 [label="Bien. ¡Bien! Esperaré el momento oportuno, como dices. Jugaré estos... juegos tontos.",shape=box,color=blue];
		j1657870772 -> j2553052332;
	j2419814799 [label="Boolean RoatheInsulted is now true.",color=orange];
		j2419814799 -> j145132244;
	j3716090167 [label="¿Porque la miseria busca compañía? Quizás. O simplemente porque me confunde que estés perdiendo el tiempo cuando hay trabajo de verdad que podríamos estar haciendo.",shape=box,color=blue];
		j3716090167 -> j2728694145;
	j2572253886 [label="¡Más pruebas de que esto es producto de tu imaginación! ¿Qué clase de dios o \"antidios\" real sería derrotado por la \"bondad de las emociones humanas\"? ¡Ja! ",shape=box,color=blue];
		j2572253886 -> j1666997846;
	j2664031001 [label="Boolean RoatheUnloved2 is now true.",color=orange];
		j2664031001 -> j3267798420;
	j2553052332 [label="Supongo que aún tenemos trabajo por hacer, como dices. Simplemente no puedo comprender que cosas tan... infantiles tengan un propósito. Pero, claro, aquí estoy, y eres tú quien tiene las llaves del universo.",shape=box,color=blue];
		j2553052332 -> j1417905547;
	j145132244 [label="Buen punto. ¿Por qué elegirías a alguien tan detestable como el Diablo de Tau?",shape=box,color=blue];
		j145132244 -> "Chat ends.";
	j2728694145 [label="Pero ahora estoy convencido de que no sabes lo que haces ni por qué lo haces, y de que simplemente haces lo que te ordenan. Otro secuaz engreído de un orokin engreído. Qué vergüenza.",shape=box,color=blue];
		j2728694145 -> "Chat ends.";
	j1666997846 [label="+5 Chemistry",color=orange];
		j1666997846 -> j634621593;
	j3267798420 [label="Deja de hablar de temas de los que no sabes absolutamente nada, Viajero.",shape=box,color=blue];
		j3267798420 -> j367054140;
	j1417905547 [label="Hasta entonces, volveré a molestar a la mosca flotante. ",shape=box,color=blue];
		j1417905547 -> j3607771851;
	j634621593 [label="De verdad, cuanto más me cuentan sus locas teorías, más me convencen de que tengo razón. Todos han construido una marioneta de su propia locura, y esto sólo alimenta sus inseguridades.",shape=box,color=blue];
		j634621593 -> j3005725646;
	j367054140 [label="+20 Chemistry",color=orange];
		j367054140 -> "Chat ends.";
