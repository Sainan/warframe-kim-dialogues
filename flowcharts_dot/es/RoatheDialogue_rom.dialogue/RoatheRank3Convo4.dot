digraph {
	1875 [label="RoatheRank3Convo4 begins.",color=orange];
		1875 -> 1876;
	1876 [label="Can you answer a question for me, Usurper? It has been troubling me for some time.",shape=box,color=blue];
		1876 -> 1879;
		1876 -> 1878;
		1876 -> 1877;
	1879 [label="Ask away. ",shape=box,color=red];
		1879 -> 1882;
	1878 [label="What could possibly be troubling you?",shape=box,color=red];
		1878 -> 1881;
	1877 [label="[Fin]",shape=box,color=red];
		1877 -> 1880;
	1882 [label="Why are you doing all this?",shape=box,color=blue];
		1882 -> 1883;
	1881 [label="I could rattle off the list, but I fear we would be here all afternoon. No, my line of questioning in this regard is over one particular topic specifically. Today, at least.",shape=box,color=blue];
		1881 -> 1882;
	1880 [label="Chat ends.",color=orange];
	1883 [label="Check boolean RoatheKnowsReset2",color=orange];
		1883 -> 1885 [label=true,color=green];
		1883 -> 1884 [label=false,color=brown];
	1885 [label="And I am not speaking about you meddling with my memories. I mean \"all this\" in a broader sense.",shape=box,color=blue];
		1885 -> 1888;
	1884 [label="Check boolean LoidFamilyComplete",color=orange];
		1884 -> 1886 [label=true,color=green];
		1884 -> 1887 [label=false,color=brown];
	1888 [label="Check boolean LoidFamilyComplete",color=orange];
		1888 -> 1886 [label=true,color=green];
		1888 -> 1887 [label=false,color=brown];
	1886 [label="You seem to be set upon running about this universe behind Albrecht with a mop bucket. Look at your work with his butler. ",shape=box,color=blue];
		1886 -> 1889;
	1887 [label="You seem to be set upon running about this universe behind Albrecht with a mop bucket.",shape=box,color=blue];
		1887 -> 1889;
	1889 [label="Check boolean IsDating",color=orange];
		1889 -> 1891 [label=true,color=green];
		1889 -> 1890 [label=false,color=brown];
	1891 [label="It does seem that you have your own itches to scratch in the meanwhile - and I applaud you for it, I am hardly judging you. It just strikes me as odd that someone so otherwise... wondrously and wildly malapert would be so otherwise obedient. ",shape=box,color=blue];
		1891 -> 1892;
		1891 -> 1893;
		1891 -> 1894;
	1890 [label="It just strikes me as odd that someone so otherwise... wondrously and wildly malapert would be so otherwise obedient. ",shape=box,color=blue];
		1890 -> 1892;
		1890 -> 1893;
		1890 -> 1894;
	1892 [label="Letting the Indifference destroy the Origin System - or anywhere else - doesn't help anyone.",shape=box,color=red];
		1892 -> 1895;
	1893 [label="I don't obey Entrati.",shape=box,color=red];
		1893 -> 1896;
	1894 [label="I have my own reasons. And they're mine to keep.",shape=box,color=red];
		1894 -> 1897;
	1895 [label="Ah, I see. Simply a temporary service you are providing until the situation with \"the Indifference\" is dealt with. And what do you plan to do then?",shape=box,color=blue];
		1895 -> 1898;
		1895 -> 1899;
		1895 -> 1900;
		1895 -> 1901;
		1895 -> 1902;
	1896 [label="Truly? It seems that from where I sit. He snaps his fingers and you heel and sit at his ankles like a trained kubrow. He even whispers the name \"Tau\" and you lot scramble to recall every possible detail of the place that you have lost.",shape=box,color=blue];
		1896 -> 1903;
		1896 -> 1904;
	1897 [label="So mysterious, so inscrutable! And such a load of drover shit. If you do not simply wish to admit the fact that you are at his beck and call, so be it.",shape=box,color=blue];
		1897 -> 1905;
	1898 [label="Why are you picking at this? What are you really trying to ask me?",shape=box,color=red];
		1898 -> 1906;
	1899 [label="I haven't really thought that far in advance, to be honest.",shape=box,color=red];
		1899 -> 1907;
	1900 [label="I intend to make him pay for making such a mess. He has a lot to atone for. ",shape=box,color=red];
		1900 -> 1908;
	1901 [label="Assuming I survive, you mean?",shape=box,color=red];
		1901 -> 1909;
	1902 [label="Go where I'm needed, like I always do. Problems tend to find me.",shape=box,color=red];
		1902 -> 1910;
	1903 [label="Why are you trying so hard to make me angry?",shape=box,color=red];
		1903 -> 1911;
	1904 [label="I'm just doing what I have to do to help people get out of the miserable situations they're in.",shape=box,color=red];
		1904 -> 1912;
	1905 [label="Because from where I sit, it seems he snaps his fingers and you heel and sit at his ankles like a trained kubrow. He even whispers the name \"Tau\" and you lot scramble to recall every possible detail of the place that you have lost.",shape=box,color=blue];
		1905 -> 1903;
		1905 -> 1904;
	1906 [label="+5 Chemistry",color=orange];
		1906 -> 1913;
	1907 [label="Ah! So you admit you are an idiot! How refreshing. I adore when fools place their lack of wit right out in the open, it makes my task of manipulating them all the easier.",shape=box,color=blue];
		1907 -> 1914;
	1908 [label="Ah! So it is base, primal revenge you are after! Glorious. A rabid animal, ready to gnaw at the bones of those who have wronged you.",shape=box,color=blue];
		1908 -> 1915;
	1909 [label="+5 Chemistry",color=orange];
		1909 -> 1916;
	1910 [label="Ah, I see. Listlessness masked with nobility. You do not know where you belong, where you should stay, so you cloak yourself in this veneer of \"righteousness sacrifice\" and do the bidding of others?",shape=box,color=blue];
		1910 -> 1917;
	1911 [label="Because I cannot for the life of me fathom why you, an entity that has, as near as I can figure, come from another version of reality entirely, is set upon running amok through time and space, \"Playing Therapist.\"",shape=box,color=blue];
		1911 -> 1918;
	1912 [label="Yes, which gets to the meat of it! Why do you insist on wandering about time and space \"Playing Therapist?\" You, who are an entity that has, near as I can figure, come from another version of reality entirely, ",shape=box,color=blue];
		1912 -> 1918;
	1913 [label="Astute. Yes, very well, I will get to the heart of what I am asking more directly. I was attempting to goad you into anger to see if it would prompt a more honest response.",shape=box,color=blue];
		1913 -> 1919;
	1914 [label="You are like a kubrow who has finally caught a kaithe. You do not know what to do now you have your teeth in its leg.",shape=box,color=blue];
		1914 -> 1904;
		1914 -> 1903;
	1915 [label="One of the simplest and oldest of all human motivations. And, therefore, one of the easiest to understand.",shape=box,color=blue];
		1915 -> 1904;
	1916 [label="Never officially a soldier, yet in your tone I hear the weariness of the most battle-hardened of them all.",shape=box,color=blue];
		1916 -> 1920;
	1917 [label="How utterly tragic.",shape=box,color=blue];
		1917 -> 1921;
		1917 -> 1922;
	1918 [label="If I were you, I would be back in Duviri attempting to discover what other holes in the fabric of the Void I could punch through! Imagine the possibilities! Imagine the worlds, ripe for the taking!",shape=box,color=blue];
		1918 -> 1923;
		1918 -> 1924;
	1919 [label="But I suppose this will have to do.",shape=box,color=blue];
		1919 -> 1925;
	1920 [label="Very well. From one to another, out of respect, I will get to the heart of what I am asking more directly. I was attempting to goad you into anger to see if it would prompt a more honest response.",shape=box,color=blue];
		1920 -> 1925;
	1921 [label="I have a place where I belong.",shape=box,color=red];
		1921 -> 1926;
	1922 [label="You don't know what you're talking about.",shape=box,color=red];
		1922 -> 1927;
	1923 [label="You're no different than Albrecht. He's going through time causing all these problems. And you want to do that to whole dimensions?!",shape=box,color=red];
		1923 -> 1928;
	1924 [label="That's the problem with you Orokin. You think whole worlds are just yours to do with as you please. ",shape=box,color=red];
		1924 -> 1929;
	1925 [label="+5 Chemistry",color=orange];
		1925 -> 1930;
	1926 [label="Do tell! Is it this Höllvania? Or perhaps Duviri? Or perhaps your crashed Orbiter on what remains of Earth?",shape=box,color=blue];
		1926 -> 1904;
		1926 -> 1903;
	1927 [label="Then tell me all about where your home is! Is it this Höllvania? Or perhaps Duviri? Or perhaps your crashed Orbiter on what remains of Earth?",shape=box,color=blue];
		1927 -> 1904;
		1927 -> 1903;
	1928 [label="And why shouldn't we? We are the superior creations, are we not? Albrecht is doing as he likes, and you have no problem going around cleaning up after him! Why shouldn't I have the right to do the same? What makes his quest \"justified\" and mine not?",shape=box,color=blue];
		1928 -> 1931;
	1929 [label="And why shouldn't we? We are the superior creations, are we not? Albrecht is doing as he likes, rampaging through time, infecting mass populi with a disease he barely understands, all in the name of \"defeating a so-called god.\"",shape=box,color=blue];
		1929 -> 1931;
	1930 [label="I cannot for the life of me fathom why you, an entity that has, as near as I can figure, come from another version of reality entirely, is set upon running amok through time and space, \"Playing Therapist.\"",shape=box,color=blue];
