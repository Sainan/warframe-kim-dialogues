		1938 -> 1942;
	1939 [label="I am simply flabbergasted. I cannot comprehend it. Why? Why, when by all rights you could be ruling some universe somewhere?",shape=box,color=blue];
		1939 -> 1943;
		1939 -> 1944;
		1939 -> 1945;
	1940 [label="I'm happy what I'm doing. I'm helping people the way I want to be helping people.",shape=box,color=red];
		1940 -> 1946;
	1941 [label="I'm not sure if you can wrap your head around this, but try: I don't want to rule a universe.",shape=box,color=red];
		1941 -> 1947;
	1942 [label="It would make me no better than Albrecht. Or the Orokin. Rampaging around remaking the world in my image. I'm not interested in that.",shape=box,color=red];
