digraph {
	"RoatheRank2Convo5 begins." [color=orange];
		"RoatheRank2Convo5 begins." -> j2554321341;
	j2554321341 [label="Check boolean RoatheRank2Convo1Complete",color=orange];
		j2554321341 -> j364889355 [label=true,color=green];
		j2554321341 -> "Chat ends." [label=false,color=brown];
	j364889355 [label="Check boolean RoatheKnowsReset2",color=orange];
		j364889355 -> j854304666 [label=true,color=green];
		j364889355 -> j1918363296 [label=false,color=brown];
	"Chat ends." [color=orange];
	j854304666 [label="¿Cuánto te contó el pasado Roathe sobre sus tratos con la Ejecutora Nitokh? Bah. Intentando reconciliar todo esto: que mi antiguo yo te confió información tan personal... ¿solo para que me la borraras de la mente?",shape=box,color=blue];
		j854304666 -> j652372537;
	j1918363296 [label="Evaluate expressions on HellStory counter",color=orange];
		j1918363296 -> j3158315280 [label="x >= 1",color=purple];
		j1918363296 -> "Chat ends." [label="x <= 1",color=purple];
		j1918363296 -> "Chat ends." [label="false",color=purple];
	j652372537 [label="Me quema por dentro. Que pudiera haberte contado todo, absolutamente todo, haberte desnudado hasta lo más profundo de mí, y tú... lo hubieras limpiado todo de nuevo. Como si no fuera más que un juguete para ti.",shape=box,color=blue];
		j652372537 -> j1436244674;
	j3158315280 [label="Ya me has oído mencionar a la Ejecutora Nitokh. Y mis... tratos con ella. Debes intentar comprender que el Imperio Orokin no era del todo malvado.",shape=box,color=blue];
		j3158315280 -> j122824570;
	j1436244674 [label="Supongo que es justo. Así es como los orokin tratábamos a la humanidad, ¿no? ¿En el Teatro Yuvan? Exhibiendo carne hermosa y eligiendo nuestro nuevo yo a voluntad, torturándonos unos a otros con juegos de diversión enfermiza a nuestro antojo...",shape=box,color=blue];
		j1436244674 -> j4072012336;
	j122824570 [label="Me rompe el corazón que solo se recuerde por su devastación y depravación. Sí, hubo mucha, no lo discuto. ",shape=box,color=blue];
		j122824570 -> j1830707068;
	j4072012336 [label="Lo odio. Lo odio muchísimo.",shape=box,color=blue];
		j4072012336 -> j2685558530;
		j4072012336 -> j4024240312;
		j4072012336 -> j202800200;
	j1830707068 [label="Pero también era capaz de tanta belleza. De tanta alegría. De tanto amor. De tantos avances científicos y artísticos. ¡Mira lo que fuimos capaces de lograr! ",shape=box,color=blue];
		j1830707068 -> j1055682073;
	j2685558530 [label="Si bien no fue mi intención lastimarte de esta manera, y lamento haberlo hecho, si esto te enseñó cómo era estar del otro lado del Imperio Orokin, es una lección valiosa.",shape=box,color=red];
		j2685558530 -> j621842949;
	j4024240312 [label="Nunca quise que esto te hiciera tanto daño. No deberías tener que disculparte por cómo funcionaba la sociedad Orokin; tú no la construiste. Intentabas salvarla.",shape=box,color=red];
		j4024240312 -> j1767089138;
	j202800200 [label="[Fin]",shape=box,color=red];
		j202800200 -> "Chat ends.";
	j1055682073 [label="Entonces, cuando Nitokh me llamó a su lado y me dijo que quería asesinar a todos los orokin, acepté de inmediato. Quería cortarle la cabeza a la serpiente envenenada. Quería reemplazarla con un sistema más benigno. Un gobernante más benigno.",shape=box,color=blue];
		j1055682073 -> j1530657600;
		j1055682073 -> j354561888;
		j1055682073 -> j202800200;
	j621842949 [label="Add 3 to Thermostat counter",color=orange];
		j621842949 -> j328928944;
	j1767089138 [label="Add -3 to Thermostat counter",color=orange];
		j1767089138 -> j1801473984;
	j1530657600 [label="Quieres decir que querías reemplazar a los Emperadores y a los Ejecutores contigo mismo.",shape=box,color=red];
		j1530657600 -> j1035975;
	j354561888 [label="¿Y quién sería ese gobernante?",shape=box,color=red];
		j354561888 -> j2058854781;
	j328928944 [label="El Imperio Orokin no fue del todo malvado. Me desgarra que solo se lo recuerde por su devastación y depravación. Sí, hubo mucha, no lo discuto.",shape=box,color=blue];
		j328928944 -> j3310326345;
	j1801473984 [label="Ojalá los demás lo hubieran visto así. Ojalá Nitokh lo hubiera visto así. ",shape=box,color=blue];
		j1801473984 -> j328928944;
	j1035975 [label="¡Por supuesto que sí!",shape=box,color=blue];
		j1035975 -> j3623784124;
	j2058854781 [label="Yo mismo, por supuesto.",shape=box,color=blue];
		j2058854781 -> j3623784124;
	j3310326345 [label="Pero también era capaz de tanta belleza. De tanta alegría. De tanto amor. De tantos avances científicos y artísticos. ¡Mira lo que fuimos capaces de lograr! ",shape=box,color=blue];
		j3310326345 -> j3864845015;
	j3623784124 [label="Me aseguraría de que todos los Ejecutores y los Emperadores fueran... removidos, y yo tomaría el cargo de Ejecutor Interino hasta que se pudiera implementar un nuevo sistema.",shape=box,color=blue];
		j3623784124 -> j1679109189;
	j3864845015 [label="Entonces, cuando Nitokh me llamó a su lado y me dijo que quería asesinar a todos los orokin, acepté de inmediato. Quería cortarle la cabeza a la serpiente envenenada. Quería reemplazarla con un sistema más benigno. Un gobernante más benigno.",shape=box,color=blue];
		j3864845015 -> j3971058333;
		j3864845015 -> j2826200077;
	j1679109189 [label="No sé cuánto tiempo tomaría eso, pero sería mejor que lo que siguió a la Gran Guerra, ¿no?",shape=box,color=blue];
		j1679109189 -> j3851362952;
		j1679109189 -> j4162712485;
		j1679109189 -> j702996734;
	j3971058333 [label="Quieres decir que querías reemplazar a los Emperadores y a los Ejecutores contigo mismo.",shape=box,color=red];
		j3971058333 -> j2894080856;
	j2826200077 [label="¿Y quién sería ese gobernante?",shape=box,color=red];
		j2826200077 -> j3618546572;
	j3851362952 [label="¿Gran Guerra?",shape=box,color=red];
		j3851362952 -> j895771230;
	j4162712485 [label="Sé honesto contigo mismo, ¿crees que alguna vez habrías renunciado al poder?",shape=box,color=red];
		j4162712485 -> j34314426;
	j702996734 [label="No creo que alguna vez hubieras renunciado al poder, Roathe.",shape=box,color=red];
		j702996734 -> j2514340032;
	j2894080856 [label="¡Claro que sí! Y no finjas que no lo has oído antes, estoy seguro de que sí. ",shape=box,color=blue];
		j2894080856 -> j1142324062;
	j3618546572 [label="Yo, por supuesto. Y no finjas que no lo has oído antes, estoy seguro de que sí.",shape=box,color=blue];
		j3618546572 -> j1142324062;
	j895771230 [label="Ahora la llaman la \"Antigua Guerra\". Para mí, no es \"antigua\", solo ocurrió hace unos años, según me recuerdo.",shape=box,color=blue];
		j895771230 -> j3693022112;
	j34314426 [label="Mm. No lo sé. Ya casi no importa, ¿verdad? Pero en aquel momento, estaba completamente convencido de que sí.",shape=box,color=blue];
		j34314426 -> j3711204557;
	j2514340032 [label="+5 Chemistry",color=orange];
		j2514340032 -> j1829443362;
	j1142324062 [label="Me aseguraría de que todos los Ejecutores y los Emperadores fueran... removidos, y yo tomaría el cargo de Ejecutor Interino hasta que se pudiera implementar un nuevo sistema.",shape=box,color=blue];
		j1142324062 -> j123128236;
	j3693022112 [label="Los viajes en el tiempo son así de divertidos.",shape=box,color=blue];
		j3693022112 -> j433722689;
	j3711204557 [label="Me esforcé tanto para regresar aquí sólo para darme cuenta de que... mi gente ahora está muerta. Me habrían ejecutado con el resto de ellos.",shape=box,color=blue];
		j3711204557 -> j494635422;
	j1829443362 [label="Tú cállate.",shape=box,color=blue];
		j1829443362 -> j2446248584;
	j123128236 [label="No sé cuánto tiempo tomaría eso, pero sería mejor que lo que siguió a la Gran Guerra, ¿no?",shape=box,color=blue];
		j123128236 -> j4162712485;
		j123128236 -> j702996734;
		j123128236 -> j3851362952;
	j433722689 [label="En sólo unos pocos años, desde mi percepción, miles han pasado en la \"realidad\": el Imperio ha caído y mi gente ha muerto. ",shape=box,color=blue];
		j433722689 -> j256383374;
	j494635422 [label="Los tenno me habrían masacrado junto con los demás la noche de los Tambores Naga. Probablemente habría muerto intentando salvar la vida de Nitokh.",shape=box,color=blue];
		j494635422 -> j3303931631;
	j2446248584 [label="En aquel momento, estaba completamente convencido de que lo haría. Pero ahora, da igual, ¿verdad?",shape=box,color=blue];
		j2446248584 -> j3711204557;
	j256383374 [label="He llegado a comprender que no importa si hubiera entregado el poder o no, aunque en su momento estuve convencido de que lo haría.",shape=box,color=blue];
		j256383374 -> j494635422;
	j3303931631 [label="Me pregunto qué fue de ella. Los registros ni siquiera mencionan su nombre... todos los horrores cometidos en su nombre, todas las muertes, todas las farsas... y puede ser que yo sea el único que los conozca.",shape=box,color=blue];
		j3303931631 -> j2062778531;
	j2062778531 [label="Bueno. Eso y lo que se pueda desbloquear en el futuro de la cabeza del tenno mediante ese Refractario Oscuro. Pero ese no es mi problema para resolver.",shape=box,color=blue];
		j2062778531 -> j2592905979;
		j2062778531 -> j3938841579;
		j2062778531 -> j3439567541;
	j2592905979 [label="Pareces un poco intimidado por el peque.",shape=box,color=red];
		j2592905979 -> j1094659567;
	j3938841579 [label="¿Qué pasó entre tú y Nitokh?",shape=box,color=red];
		j3938841579 -> j914305711;
	j3439567541 [label="¿Entonces estabas planeando traicionar a los orokin?",shape=box,color=red];
		j3439567541 -> j1518228069;
	j1094659567 [label="Observé a un grupo de niños en edad escolar, devastados por el Vacío, pilotear de forma remota máquinas de guerra infestadas que alguna vez fueron soldados y que ahora se habían reconvertido en obras de arte grotescas, hermosas y asesinas, y que destruían batallones enteros de soldados. ",shape=box,color=blue];
		j1094659567 -> j1001155274;
	j914305711 [label="Todo.",shape=box,color=blue];
		j914305711 -> j939261963;
	j1518228069 [label="Sí. Ambos lo estábamos. Aunque creo que Nitokh planeaba traicionarme, y yo también planeaba traicionarla. Ya sabes cómo son las cosas con nosotros, los orokin.",shape=box,color=blue];
		j1518228069 -> j1424762308;
	j1001155274 [label="He descubierto que destruyeron mi Imperio. Un Imperio que gobernaba todo el Sistema Origen. Y que estaba a punto de acabar con la rebelión en Tau.",shape=box,color=blue];
		j1001155274 -> j2336970935;
	j939261963 [label="Todo pasó entre Nitokh y yo.",shape=box,color=blue];
		j939261963 -> j1228941507;
	j1424762308 [label="Todos siempre conspirando contra los demás. Un día más de la semana, en realidad.",shape=box,color=blue];
		j1424762308 -> j1391383070;
	j2336970935 [label="Y lo hicieron en una noche.",shape=box,color=blue];
		j2336970935 -> j1835682948;
	j1228941507 [label="Todo y más.",shape=box,color=blue];
		j1228941507 -> j3459541048;
	j1391383070 [label="Las traiciones entre un orokin y otro eran bastante comunes. ¿Pero traicionar a todo el Imperio? Esa clase de traición merecía no solo la ejecución de la Luz de Jade, sino también del Programa Céfalon.",shape=box,color=blue];
		j1391383070 -> j1500183088;
	j1835682948 [label="¡¿No lo estarías?!",shape=box,color=blue];
		j1835682948 -> j2440124231;
	j3459541048 [label="Y eso es todo lo que deseo decir sobre este tema por ahora.",shape=box,color=blue];
		j3459541048 -> j2232513579;
	j1500183088 [label="Boolean RoatheTraitor1 is now true.",color=orange];
		j1500183088 -> j2566941522;
		j1500183088 -> j1502605933;
	j2440124231 [label="No puedo expresar lo que estábamos arriesgando al intentar asesinar a los Ejecutores, y mucho menos a todos los orokin, Usurpador.",shape=box,color=blue];
		j2440124231 -> j1391383070;
	j2232513579 [label="Boolean RoatheExecutor1 is now true.",color=orange];
		j2232513579 -> j2440124231;
	j2566941522 [label="¿Cuál consideras que es peor que el otro?",shape=box,color=red];
		j2566941522 -> j1078404772;
	j1502605933 [label="¿Entonces ese tipo de plan no era normal?",shape=box,color=red];
		j1502605933 -> j3240994228;
	j1078404772 [label="El Programa Céfalon de Nihil, sin duda. Las creaciones del vidriero son...",shape=box,color=blue];
		j1078404772 -> j916239577;
	j3240994228 [label="La existencia del Imperio Orokin pendía de la hoja de una daga, Usurpador. Zumbaba al borde de la destrucción en todo momento. Solo una cosa lo mantenía operativo:",shape=box,color=blue];
		j3240994228 -> j3743256926;
	j916239577 [label="La Luz de Jade ataca rápidamente a quienes no tienen armadura ni escudo para sobrevivir a una sola explosión. Es una muerte misericordiosa.",shape=box,color=blue];
		j916239577 -> j450146344;
	j3743256926 [label="Normas sociales.",shape=box,color=blue];
		j3743256926 -> j1503790219;
	j450146344 [label="Los céfalones, al ser convertidos por un sujeto voluntario, pueden ser indoloros e incluso se realizan de forma no destructiva. Sin embargo... ¿cuando se usan con fines punitivos?",shape=box,color=blue];
		j450146344 -> j858598222;
	j1503790219 [label="¡Uno simplemente no se levanta en contra y asesina a todos los orokin! ¡Eso no se hice, Viajero! ¡Impensable! ¡Una auténtica grosería!",shape=box,color=blue];
		j1503790219 -> j3231390188;
	j858598222 [label="Los recuerdos son sagrados para los orokin, Viajero. Son todo lo que somos, al fin y al cabo. Nuestros cuerpos son temporales. Nuestros rostros, nuestras voces, nuestra sangre, todo es mutable. Todo puede cambiar, como la moda.",shape=box,color=blue];
		j858598222 -> j4186474857;
	j3231390188 [label="Lo que también lo hizo cómicamente fácil de hacer, al final. Como seguro que tu tenno duplicado aprendió. ",shape=box,color=blue];
		j3231390188 -> j254100731;
		j3231390188 -> j1291535993;
	j4186474857 [label="Check boolean RoatheKnowsReset2",color=orange];
		j4186474857 -> j596392071 [label=true,color=green];
		j4186474857 -> j254100731 [label=false,color=brown];
		j4186474857 -> j1291535993 [label=false,color=brown];
	j254100731 [label="Pero claramente nunca llegaste lo suficientemente lejos como para intentarlo.",shape=box,color=red];
		j254100731 -> j2745098065;
	j1291535993 [label="¿Qué pasó con tu plan?",shape=box,color=red];
		j1291535993 -> j652053828;
	j596392071 [label="Lo cual probablemente sea, dicho sea de paso, el motivo por el cual estoy tan profunda y absolutamente irritado contigo por entrometerte con ellos. ",shape=box,color=blue];
		j596392071 -> j254100731;
		j596392071 -> j1291535993;
	j2745098065 [label="Evaluate expressions on HellStory counter",color=orange];
		j2745098065 -> j192769850 [label="x >= 21",color=purple];
		j2745098065 -> j751956384 [label="x < 21",color=purple];
		j2745098065 -> j751956384 [label="false",color=purple];
	j652053828 [label="Evaluate expressions on HellStory counter",color=orange];
		j652053828 -> j846263733 [label="x >= 21",color=purple];
		j652053828 -> j1097202801 [label="x < 21",color=purple];
		j652053828 -> j1097202801 [label="false",color=purple];
	j192769850 [label="¡Tienes razón, obviamente! Albrecht me encontró en ese pasillo antes de que Nitokh y yo tuviéramos tiempo de activar nuestra trampa para los Ejecutores.",shape=box,color=blue];
		j192769850 -> j3075339113;
	j751956384 [label="No, claramente no. Albrecht me convirtió a la fuerza en esta... cosa antes de que Nitokh y yo tuviéramos tiempo de prepararles la trampa a los Ejecutores.",shape=box,color=blue];
		j751956384 -> j3004783099;
	j846263733 [label="Sabes perfectamente qué pasó con nuestro plan, ¿verdad? Albrecht me encontró en ese pasillo antes de que Nitokh y yo tuviéramos tiempo de activar nuestra trampa para los Ejecutores.",shape=box,color=blue];
		j846263733 -> j349779136;
	j1097202801 [label="Albrecht me convirtió a la fuerza en esta... cosa antes de que Nitokh y yo tuviéramos tiempo de prepararles la trampa a los ejecutores.",shape=box,color=blue];
		j1097202801 -> j3004783099;
	j3075339113 [label="Y me ofreció el suero protoframe. Y... bueno... ambos sabemos lo que pasó después.",shape=box,color=blue];
		j3075339113 -> j197215337;
	j3004783099 [label="En un momento, recuerdo estar parado en un gran pasillo dorado, y al siguiente, gritando de agonía en algún lugar infernal de la \"Gaule\".",shape=box,color=blue];
		j3004783099 -> j463718533;
	j349779136 [label="¡Me ofreció el suero protoframe y ambos sabemos lo que pasó después!",shape=box,color=blue];
		j349779136 -> j197215337;
	j197215337 [label="Un asunto por el que sigo furioso. Yo... ¿Por qué? ¿Por qué te confesé esto? ¿Por qué lo sabes? ",shape=box,color=blue];
		j197215337 -> j1228735410;
	j463718533 [label="Nitokh debió abandonar el plan tras mi desaparición. Probablemente, me echó la culpa de todo el asunto de la traición como chivo expiatorio conveniente.",shape=box,color=blue];
		j463718533 -> j3328747192;
	j1228735410 [label="¡Bah! No. No importa. Me voy ahora, antes de que rompa esta maldita computadora en un ataque de ira.",shape=box,color=blue];
		j1228735410 -> j1933300832;
	j3328747192 [label="Eso explica todos los registros que encuentro donde me llaman \"cobarde\". Claro que pensarían que soy un cobarde; ¡creen que huí! ¡Bah!",shape=box,color=blue];
		j3328747192 -> j1829989387;
	j1933300832 [label="+10 Chemistry",color=orange];
		j1933300832 -> "Chat ends.";
	j1829989387 [label="+10 Chemistry",color=orange];
		j1829989387 -> j2785026648;
	j2785026648 [label="Es bueno saber que fui tan crucial para el plan, sin embargo, tuvo que ser desechado por completo cuando me fui.",shape=box,color=blue];
		j2785026648 -> j2769854587;
		j2785026648 -> j1556495195;
	j2769854587 [label="No estoy seguro de si esa es la conclusión que deberías sacar de todo esto.",shape=box,color=red];
		j2769854587 -> j3011130104;
	j1556495195 [label="Es agradable sentirse necesario.",shape=box,color=red];
		j1556495195 -> j3550859699;
	j3011130104 [label="Add 1 to Thermostat counter",color=orange];
		j3011130104 -> j1580634968;
	j3550859699 [label="+5 Chemistry",color=orange];
		j3550859699 -> j2956597902;
	j1580634968 [label="Encuentra tu valor donde quieras, Viajero, y déjame encontrar el mío.",shape=box,color=blue];
		j1580634968 -> "Chat ends.";
	j2956597902 [label="Add -1 to Thermostat counter",color=orange];
		j2956597902 -> j837309790;
