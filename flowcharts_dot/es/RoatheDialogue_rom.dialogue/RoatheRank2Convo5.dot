digraph {
	1224 [label="RoatheRank2Convo5 begins.",color=orange];
		1224 -> 1225;
	1225 [label="Check boolean RoatheRank2Convo1Complete",color=orange];
		1225 -> 1226 [label=true,color=green];
		1225 -> 1227 [label=false,color=brown];
	1226 [label="Check boolean RoatheKnowsReset2",color=orange];
		1226 -> 1229 [label=true,color=green];
		1226 -> 1228 [label=false,color=brown];
	1227 [label="Chat ends.",color=orange];
	1229 [label="¿Cuánto te contó el pasado Roathe sobre sus tratos con la Ejecutora Nitokh? Bah. Intentando reconciliar todo esto: que mi antiguo yo te confió información tan personal... ¿solo para que me la borraras de la mente?",shape=box,color=blue];
		1229 -> 1232;
	1228 [label="Evaluate expressions on HellStory",color=orange];
		1228 -> 1231 [label="x >= 1",color=purple];
		1228 -> 1230 [label="x <= 1",color=purple];
		1228 -> 1230 [label="false",color=purple];
	1232 [label="Me quema por dentro. Que pudiera haberte contado todo, absolutamente todo, haberte desnudado hasta lo más profundo de mí, y tú... lo hubieras limpiado todo de nuevo. Como si no fuera más que un juguete para ti.",shape=box,color=blue];
		1232 -> 1234;
	1231 [label="Ya me has oído mencionar a la Ejecutora Nitokh. Y mis... tratos con ella. Debes intentar comprender que el Imperio Orokin no era del todo malvado.",shape=box,color=blue];
		1231 -> 1233;
	1230 [label="Chat ends.",color=orange];
	1234 [label="Supongo que es justo. Así es como los orokin tratábamos a la humanidad, ¿no? ¿En el Teatro Yuvan? Exhibiendo carne hermosa y eligiendo nuestro nuevo yo a voluntad, torturándonos unos a otros con juegos de diversión enfermiza a nuestro antojo...",shape=box,color=blue];
		1234 -> 1236;
	1233 [label="Me rompe el corazón que solo se recuerde por su devastación y depravación. Sí, hubo mucha, no lo discuto. ",shape=box,color=blue];
		1233 -> 1235;
	1236 [label="Lo odio. Lo odio muchísimo.",shape=box,color=blue];
		1236 -> 1239;
		1236 -> 1240;
		1236 -> 1238;
	1235 [label="Pero también era capaz de tanta belleza. De tanta alegría. De tanto amor. De tantos avances científicos y artísticos. ¡Mira lo que fuimos capaces de lograr! ",shape=box,color=blue];
		1235 -> 1237;
	1239 [label="Si bien no fue mi intención lastimarte de esta manera, y lamento haberlo hecho, si esto te enseñó cómo era estar del otro lado del Imperio Orokin, es una lección valiosa.",shape=box,color=red];
		1239 -> 1245;
	1240 [label="Nunca quise que esto te hiciera tanto daño. No deberías tener que disculparte por cómo funcionaba la sociedad Orokin; tú no la construiste. Intentabas salvarla.",shape=box,color=red];
		1240 -> 1246;
	1238 [label="[Fin]",shape=box,color=red];
		1238 -> 1244;
	1237 [label="Entonces, cuando Nitokh me llamó a su lado y me dijo que quería asesinar a todos los orokin, acepté de inmediato. Quería cortarle la cabeza a la serpiente envenenada. Quería reemplazarla con un sistema más benigno. Un gobernante más benigno.",shape=box,color=blue];
		1237 -> 1241;
		1237 -> 1242;
		1237 -> 1243;
	1245 [label="Add 3 to Thermostat",color=orange];
		1245 -> 1250;
	1246 [label="Add -3 to Thermostat",color=orange];
		1246 -> 1251;
	1244 [label="Chat ends.",color=orange];
	1241 [label="Quieres decir que querías reemplazar a los Emperadores y a los Ejecutores contigo mismo.",shape=box,color=red];
		1241 -> 1247;
	1242 [label="¿Y quién sería ese gobernante?",shape=box,color=red];
		1242 -> 1248;
	1243 [label="[Fin]",shape=box,color=red];
		1243 -> 1249;
	1250 [label="El Imperio Orokin no fue del todo malvado. Me desgarra que solo se lo recuerde por su devastación y depravación. Sí, hubo mucha, no lo discuto.",shape=box,color=blue];
		1250 -> 1253;
	1251 [label="Ojalá los demás lo hubieran visto así. Ojalá Nitokh lo hubiera visto así. ",shape=box,color=blue];
		1251 -> 1254;
	1247 [label="¡Por supuesto que sí!",shape=box,color=blue];
		1247 -> 1252;
	1248 [label="Yo mismo, por supuesto.",shape=box,color=blue];
		1248 -> 1252;
	1249 [label="Chat ends.",color=orange];
	1253 [label="Pero también era capaz de tanta belleza. De tanta alegría. De tanto amor. De tantos avances científicos y artísticos. ¡Mira lo que fuimos capaces de lograr! ",shape=box,color=blue];
		1253 -> 1256;
	1254 [label="El Imperio Orokin no fue del todo malvado. Me desgarra que solo se lo recuerde por su devastación y depravación. Sí, hubo mucha, no lo discuto.",shape=box,color=blue];
		1254 -> 1253;
	1252 [label="Me aseguraría de que todos los Ejecutores y los Emperadores fueran... removidos, y yo tomaría el cargo de Ejecutor Interino hasta que se pudiera implementar un nuevo sistema.",shape=box,color=blue];
		1252 -> 1255;
	1256 [label="Entonces, cuando Nitokh me llamó a su lado y me dijo que quería asesinar a todos los orokin, acepté de inmediato. Quería cortarle la cabeza a la serpiente envenenada. Quería reemplazarla con un sistema más benigno. Un gobernante más benigno.",shape=box,color=blue];
		1256 -> 1260;
		1256 -> 1261;
	1255 [label="No sé cuánto tiempo tomaría eso, pero sería mejor que lo que siguió a la Gran Guerra, ¿no?",shape=box,color=blue];
		1255 -> 1257;
		1255 -> 1258;
		1255 -> 1259;
	1260 [label="Quieres decir que querías reemplazar a los Emperadores y a los Ejecutores contigo mismo.",shape=box,color=red];
		1260 -> 1265;
	1261 [label="¿Y quién sería ese gobernante?",shape=box,color=red];
		1261 -> 1266;
	1257 [label="¿Gran Guerra?",shape=box,color=red];
		1257 -> 1262;
	1258 [label="Sé honesto contigo mismo, ¿crees que alguna vez habrías renunciado al poder?",shape=box,color=red];
		1258 -> 1263;
	1259 [label="No creo que alguna vez hubieras renunciado al poder, Roathe.",shape=box,color=red];
		1259 -> 1264;
	1265 [label="¡Claro que sí! Y no finjas que no lo has oído antes, estoy seguro de que sí. ",shape=box,color=blue];
		1265 -> 1270;
	1266 [label="Yo, por supuesto. Y no finjas que no lo has oído antes, estoy seguro de que sí.",shape=box,color=blue];
		1266 -> 1270;
	1262 [label="Ahora la llaman la \"Antigua Guerra\". Para mí, no es \"antigua\", solo ocurrió hace unos años, según me recuerdo.",shape=box,color=blue];
		1262 -> 1267;
	1263 [label="Mm. No lo sé. Ya casi no importa, ¿verdad? Pero en aquel momento, estaba completamente convencido de que sí.",shape=box,color=blue];
		1263 -> 1268;
	1264 [label="+5 Chemistry",color=orange];
		1264 -> 1269;
	1270 [label="Me aseguraría de que todos los Ejecutores y los Emperadores fueran... removidos, y yo tomaría el cargo de Ejecutor Interino hasta que se pudiera implementar un nuevo sistema.",shape=box,color=blue];
		1270 -> 1274;
	1267 [label="Los viajes en el tiempo son así de divertidos.",shape=box,color=blue];
		1267 -> 1271;
	1268 [label="Me esforcé tanto para regresar aquí sólo para darme cuenta de que... mi gente ahora está muerta. Me habrían ejecutado con el resto de ellos.",shape=box,color=blue];
		1268 -> 1272;
	1269 [label="Tú cállate.",shape=box,color=blue];
		1269 -> 1273;
	1274 [label="No sé cuánto tiempo tomaría eso, pero sería mejor que lo que siguió a la Gran Guerra, ¿no?",shape=box,color=blue];
		1274 -> 1258;
		1274 -> 1259;
		1274 -> 1257;
	1271 [label="En sólo unos pocos años, desde mi percepción, miles han pasado en la \"realidad\": el Imperio ha caído y mi gente ha muerto. ",shape=box,color=blue];
		1271 -> 5775;
	1272 [label="Los tenno me habrían masacrado junto con los demás la noche de los Tambores Naga. Probablemente habría muerto intentando salvar la vida de Nitokh.",shape=box,color=blue];
		1272 -> 1275;
	1273 [label="En aquel momento, estaba completamente convencido de que lo haría. Pero ahora, da igual, ¿verdad?",shape=box,color=blue];
		1273 -> 1268;
	5775 [label="He llegado a comprender que no importa si hubiera entregado el poder o no, aunque en su momento estuve convencido de que lo haría.",shape=box,color=blue];
		5775 -> 1272;
	1275 [label="Me pregunto qué fue de ella. Los registros ni siquiera mencionan su nombre... todos los horrores cometidos en su nombre, todas las muertes, todas las farsas... y puede ser que yo sea el único que los conozca.",shape=box,color=blue];
		1275 -> 1276;
	1276 [label="Bueno. Eso y lo que se pueda desbloquear en el futuro de la cabeza del tenno mediante ese Refractario Oscuro. Pero ese no es mi problema para resolver.",shape=box,color=blue];
		1276 -> 1277;
		1276 -> 1278;
		1276 -> 1279;
	1277 [label="Pareces un poco intimidado por el peque.",shape=box,color=red];
		1277 -> 1280;
	1278 [label="¿Qué pasó entre tú y Nitokh?",shape=box,color=red];
		1278 -> 1281;
	1279 [label="¿Entonces estabas planeando traicionar a los orokin?",shape=box,color=red];
		1279 -> 1282;
	1280 [label="Observé a un grupo de niños en edad escolar, devastados por el Vacío, pilotear de forma remota máquinas de guerra infestadas que alguna vez fueron soldados y que ahora se habían reconvertido en obras de arte grotescas, hermosas y asesinas, y que destruían batallones enteros de soldados. ",shape=box,color=blue];
		1280 -> 1283;
	1281 [label="Todo.",shape=box,color=blue];
		1281 -> 1284;
	1282 [label="Sí. Ambos lo estábamos. Aunque creo que Nitokh planeaba traicionarme, y yo también planeaba traicionarla. Ya sabes cómo son las cosas con nosotros, los orokin.",shape=box,color=blue];
		1282 -> 1285;
	1283 [label="He descubierto que destruyeron mi Imperio. Un Imperio que gobernaba todo el Sistema Origen. Y que estaba a punto de acabar con la rebelión en Tau.",shape=box,color=blue];
		1283 -> 1286;
	1284 [label="Todo pasó entre Nitokh y yo.",shape=box,color=blue];
		1284 -> 1287;
	1285 [label="Todos siempre conspirando contra los demás. Un día más de la semana, en realidad.",shape=box,color=blue];
		1285 -> 1288;
	1286 [label="Y lo hicieron en una noche.",shape=box,color=blue];
		1286 -> 1289;
	1287 [label="Todo y más.",shape=box,color=blue];
		1287 -> 1290;
	1288 [label="Las traiciones entre un orokin y otro eran bastante comunes. ¿Pero traicionar a todo el Imperio? Esa clase de traición merecía no solo la ejecución de la Luz de Jade, sino también del Programa Céfalon.",shape=box,color=blue];
		1288 -> 1291;
	1289 [label="¡¿No lo estarías?!",shape=box,color=blue];
		1289 -> 1292;
	1290 [label="Y eso es todo lo que deseo decir sobre este tema por ahora.",shape=box,color=blue];
		1290 -> 1293;
	1291 [label="Update boolean RoatheTraitor1",color=orange];
		1291 -> 1294;
		1291 -> 1295;
	1292 [label="No puedo expresar lo que estábamos arriesgando al intentar asesinar a los Ejecutores, y mucho menos a todos los orokin, Usurpador.",shape=box,color=blue];
		1292 -> 1288;
	1293 [label="Update boolean RoatheExecutor1",color=orange];
		1293 -> 1292;
	1294 [label="¿Cuál consideras que es peor que el otro?",shape=box,color=red];
		1294 -> 1296;
	1295 [label="¿Entonces ese tipo de plan no era normal?",shape=box,color=red];
		1295 -> 1297;
	1296 [label="El Programa Céfalon de Nihil, sin duda. Las creaciones del vidriero son...",shape=box,color=blue];
		1296 -> 1298;
	1297 [label="La existencia del Imperio Orokin pendía de la hoja de una daga, Usurpador. Zumbaba al borde de la destrucción en todo momento. Solo una cosa lo mantenía operativo:",shape=box,color=blue];
		1297 -> 1299;
	1298 [label="La Luz de Jade ataca rápidamente a quienes no tienen armadura ni escudo para sobrevivir a una sola explosión. Es una muerte misericordiosa.",shape=box,color=blue];
		1298 -> 1300;
	1299 [label="Normas sociales.",shape=box,color=blue];
		1299 -> 1301;
	1300 [label="Los céfalones, al ser convertidos por un sujeto voluntario, pueden ser indoloros e incluso se realizan de forma no destructiva. Sin embargo... ¿cuando se usan con fines punitivos?",shape=box,color=blue];
		1300 -> 1302;
	1301 [label="¡Uno simplemente no se levanta en contra y asesina a todos los orokin! ¡Eso no se hice, Viajero! ¡Impensable! ¡Una auténtica grosería!",shape=box,color=blue];
		1301 -> 1303;
	1302 [label="Los recuerdos son sagrados para los orokin, Viajero. Son todo lo que somos, al fin y al cabo. Nuestros cuerpos son temporales. Nuestros rostros, nuestras voces, nuestra sangre, todo es mutable. Todo puede cambiar, como la moda.",shape=box,color=blue];
		1302 -> 1304;
	1303 [label="Lo que también lo hizo cómicamente fácil de hacer, al final. Como seguro que tu tenno duplicado aprendió. ",shape=box,color=blue];
		1303 -> 1305;
		1303 -> 1306;
	1304 [label="Check boolean RoatheKnowsReset2",color=orange];
		1304 -> 1307 [label=true,color=green];
		1304 -> 1305 [label=false,color=brown];
		1304 -> 1306 [label=false,color=brown];
	1305 [label="Pero claramente nunca llegaste lo suficientemente lejos como para intentarlo.",shape=box,color=red];
		1305 -> 1308;
	1306 [label="¿Qué pasó con tu plan?",shape=box,color=red];
		1306 -> 1309;
	1307 [label="Lo cual probablemente sea, dicho sea de paso, el motivo por el cual estoy tan profunda y absolutamente irritado contigo por entrometerte con ellos. ",shape=box,color=blue];
		1307 -> 1305;
		1307 -> 1306;
	1308 [label="Evaluate expressions on HellStory",color=orange];
		1308 -> 1310 [label="x >= 21",color=purple];
		1308 -> 1311 [label="x < 21",color=purple];
		1308 -> 1311 [label="false",color=purple];
	1309 [label="Evaluate expressions on HellStory",color=orange];
		1309 -> 1312 [label="x >= 21",color=purple];
		1309 -> 5777 [label="x < 21",color=purple];
		1309 -> 5777 [label="false",color=purple];
	1310 [label="¡Tienes razón, obviamente! Albrecht me encontró en ese pasillo antes de que Nitokh y yo tuviéramos tiempo de activar nuestra trampa para los Ejecutores.",shape=box,color=blue];
		1310 -> 1313;
	1311 [label="No, claramente no. Albrecht me convirtió a la fuerza en esta... cosa antes de que Nitokh y yo tuviéramos tiempo de prepararles la trampa a los Ejecutores.",shape=box,color=blue];
		1311 -> 1314;
	1312 [label="Sabes perfectamente qué pasó con nuestro plan, ¿verdad? Albrecht me encontró en ese pasillo antes de que Nitokh y yo tuviéramos tiempo de activar nuestra trampa para los Ejecutores.",shape=box,color=blue];
		1312 -> 1315;
	5777 [label="Albrecht me convirtió a la fuerza en esta... cosa antes de que Nitokh y yo tuviéramos tiempo de prepararles la trampa a los ejecutores.",shape=box,color=blue];
		5777 -> 1314;
	1313 [label="Y me ofreció el suero protoframe. Y... bueno... ambos sabemos lo que pasó después.",shape=box,color=blue];
		1313 -> 1316;
	1314 [label="En un momento, recuerdo estar parado en un gran pasillo dorado, y al siguiente, gritando de agonía en algún lugar infernal de la \"Gaule\".",shape=box,color=blue];
		1314 -> 1317;
	1315 [label="¡Me ofreció el suero protoframe y ambos sabemos lo que pasó después!",shape=box,color=blue];
		1315 -> 1316;
	1316 [label="Un asunto por el que sigo furioso. Yo... ¿Por qué? ¿Por qué te confesé esto? ¿Por qué lo sabes? ",shape=box,color=blue];
		1316 -> 1318;
	1317 [label="Nitokh debió abandonar el plan tras mi desaparición. Probablemente, me echó la culpa de todo el asunto de la traición como chivo expiatorio conveniente.",shape=box,color=blue];
		1317 -> 1319;
	1318 [label="¡Bah! No. No importa. Me voy ahora, antes de que rompa esta maldita computadora en un ataque de ira.",shape=box,color=blue];
		1318 -> 1320;
	1319 [label="Eso explica todos los registros que encuentro donde me llaman \"cobarde\". Claro que pensarían que soy un cobarde; ¡creen que huí! ¡Bah!",shape=box,color=blue];
		1319 -> 1321;
	1320 [label="+10 Chemistry",color=orange];
		1320 -> 1322;
	1321 [label="+10 Chemistry",color=orange];
		1321 -> 1323;
	1322 [label="Chat ends.",color=orange];
	1323 [label="Es bueno saber que fui tan crucial para el plan, sin embargo, tuvo que ser desechado por completo cuando me fui.",shape=box,color=blue];
		1323 -> 1324;
		1323 -> 1325;
	1324 [label="No estoy seguro de si esa es la conclusión que deberías sacar de todo esto.",shape=box,color=red];
		1324 -> 1326;
	1325 [label="Es agradable sentirse necesario.",shape=box,color=red];
		1325 -> 1327;
	1326 [label="Add 1 to Thermostat",color=orange];
		1326 -> 1328;
	1327 [label="+5 Chemistry",color=orange];
		1327 -> 1329;
	1328 [label="Encuentra tu valor donde quieras, Viajero, y déjame encontrar el mío.",shape=box,color=blue];
		1328 -> 1330;
	1329 [label="Add -1 to Thermostat",color=orange];
		1329 -> 1331;
	1330 [label="Chat ends.",color=orange];
	1331 [label="¿Lo ves? Lo entiendes.",shape=box,color=blue];
		1331 -> 1332;
	1332 [label="Chat ends.",color=orange];
