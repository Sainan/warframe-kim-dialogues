digraph {
	graph [fontname="Roboto Condensed"];
	node [fontname="Roboto Condensed"];
	edge [fontname="Roboto Condensed"];

	"RoatheRank4Convo6 begins." [color=orange];
		"RoatheRank4Convo6 begins." -> j4257843254;
	j4257843254 [label="¿Cuál es tu forma favorita de matar, Usurpador?",shape=box,color=blue];
		j4257843254 -> j3398541526;
		j4257843254 -> j25240923;
		j4257843254 -> j202800200;
	j3398541526 [label="¿Disculpa?",shape=box,color=red];
		j3398541526 -> j1828689029;
	j25240923 [label="¿Preguntas porque quieres descubrirlo?",shape=box,color=red];
		j25240923 -> j2101943800;
	j202800200 [label="[Fin]",shape=box,color=red];
		j202800200 -> "Chat ends.";
	j1828689029 [label="Últimamente me encuentro filosofando y simplemente tengo curiosidad.",shape=box,color=blue];
		j1828689029 -> j1010485787;
	j2101943800 [label="¡Ja! Para nada. Aunque... jugar unas rondas contigo sería bastante divertido. No, últimamente me encuentro filosofando y simplemente tengo curiosidad.",shape=box,color=blue];
		j2101943800 -> j1010485787;
	"Chat ends." [color=orange];
	j1010485787 [label="En cuanto a los números, creo que tú y yo estamos probablemente igualados. Letalidad, mm... No quisiera apostar, ni me interesa especialmente una competición de medición de espadas.",shape=box,color=blue];
		j1010485787 -> j2919249342;
	j2919249342 [label="De asesino a asesino. ¿Qué prefieres? ¿Algo cercano y personal? ¿O prefieres el sigilo o el caos del campo de batalla?",shape=box,color=blue];
		j2919249342 -> j3650782197;
		j2919249342 -> j3716988195;
		j2919249342 -> j501102068;
		j2919249342 -> j1019809082;
	j3650782197 [label="Prefiero el caos. Explosiones. Disparos. Ruidos fuertes. Cuanto más haya, mejor.",shape=box,color=red];
		j3650782197 -> j1367122687;
	j3716988195 [label="Sigilo. Prefiero eliminar a mi enemigo antes de que siquiera sepa que estoy ahí. Lo haría donde duerme si pudiera.",shape=box,color=red];
		j3716988195 -> j2839511302;
	j501102068 [label="Odio pelear. Ojalá nunca tuviera que hacerlo.",shape=box,color=red];
		j501102068 -> j2818690203;
	j1019809082 [label="Esta es una charla enfermiza.",shape=box,color=red];
		j1019809082 -> j3481831506;
	j1367122687 [label="Boolean RoatheSoldier is now true.",color=orange];
		j1367122687 -> j800246211;
	j2839511302 [label="Boolean RoatheAssassin is now true.",color=orange];
		j2839511302 -> j744079650;
	j2818690203 [label="Oh, pobre, pobre Usurpador, si tan sólo hubieras escuchado mi risa...",shape=box,color=blue];
		j2818690203 -> j2269736088;
	j3481831506 [label="Entonces, vete.",shape=box,color=blue];
		j3481831506 -> "Chat ends.";
	j800246211 [label="Un soldado curtido en la batalla como yo. No me sorprende, dado lo que sé de tu historial. Tanta sangre te sigue dondequiera que vayas. Primero Duviri, luego \"Narmer\", luego Höllvania. Y ahora, todo este asunto.",shape=box,color=blue];
		j800246211 -> j2513202157;
	j744079650 [label="¡Ah, un asesino entre nosotros! Tan útil, pero tan poco apreciado. Siempre he comparado a los asesinos con mayordomos talentosos.",shape=box,color=blue];
		j744079650 -> j2244127290;
	j2269736088 [label="¡Miserable criatura! Por tu bien, espero que estés mintiendo.",shape=box,color=blue];
		j2269736088 -> j2962050502;
	j2513202157 [label="Quién sabe qué más o desde cuándo o qué habrás olvidado en ese tiempo. La muerte es tu arte y pintas los mundos en ella.",shape=box,color=blue];
		j2513202157 -> j2943933144;
	j2244127290 [label="Cuando hacen su trabajo excepcionalmente bien, siempre pasan desapercibidos.",shape=box,color=blue];
		j2244127290 -> j257996220;
	j2962050502 [label="+20 Chemistry",color=orange];
		j2962050502 -> j509482966;
	j2943933144 [label="Entonces, ¿cuál es tu pincel favorito? Hablemos más a detalle.",shape=box,color=blue];
		j2943933144 -> j1474287274;
		j2943933144 -> j667374592;
		j2943933144 -> j3677824226;
		j2943933144 -> j3785958185;
	j257996220 [label="Entonces... ¿Daga? ¿Veneno? ¿Arco?",shape=box,color=blue];
		j257996220 -> j2544136605;
		j257996220 -> j1989431814;
		j257996220 -> j501837955;
		j257996220 -> j583196885;
		j257996220 -> j4158551902;
	j509482966 [label="De lo contrario, podría ser la cosa más triste que haya escuchado en todos mis años.",shape=box,color=blue];
		j509482966 -> j2927459171;
	j1474287274 [label="Me las arreglo con lo que haya, la verdad. Me gusta improvisar.",shape=box,color=red];
		j1474287274 -> j1138409210;
	j667374592 [label="Un arco. Elegante y mortal.",shape=box,color=red];
		j667374592 -> j1391722646;
	j3677824226 [label="Una espada. Me gusta acercarme.",shape=box,color=red];
		j3677824226 -> j277547387;
	j3785958185 [label="Rifles y pistolas. Son ruidosos, pero cumplen su función.",shape=box,color=red];
		j3785958185 -> j1522229323;
	j2544136605 [label="Me las arreglo con lo que haya, la verdad. Me gusta improvisar.",shape=box,color=red];
		j2544136605 -> j4092536821;
	j1989431814 [label="Arco. Elegante y silencioso.",shape=box,color=red];
		j1989431814 -> j2147769493;
	j501837955 [label="Rifle de francotirador. Un disparo, una muerte.",shape=box,color=red];
		j501837955 -> j3134660526;
	j583196885 [label="Veneno. Me voy antes de que sepan que están muertos.",shape=box,color=red];
		j583196885 -> j3114427218;
	j4158551902 [label="Daga. Me gusta la intimidad.",shape=box,color=red];
		j4158551902 -> j3091871787;
	j2927459171 [label="Boolean RoatheWeaponNone is now true.",color=orange];
		j2927459171 -> "Chat ends.";
	j1138409210 [label="Estoy aquí sentado, imaginándote arrasando el campo de batalla con una camilla médica. Aplastando a los soldados con un neumático atado a un tubo doblado.",shape=box,color=blue];
		j1138409210 -> j1122435291;
	j1391722646 [label="Para manejar un arco en el fragor de la batalla se necesita una determinación y una claridad mental que pocos pueden reunir. Y, por supuesto, manos firmes.",shape=box,color=blue];
		j1391722646 -> j1250640681;
	j277547387 [label="Mm, cuidado. Haces que me emocione, Usurpador. Cómo me encantaría verte bailar por el campo de batalla, arma en mano, salpicando sangre como los pétalos de una flor que va abriéndose...",shape=box,color=blue];
		j277547387 -> j390361178;
	j1522229323 [label="Han sido el caballo de batalla de cualquier guerra desde su invención, por una razón, Usurpador. Sin embargo, es difícil negar que, cuando alcanzan su objetivo, lo cumplen.",shape=box,color=blue];
		j1522229323 -> j3551932956;
	j4092536821 [label="Estoy aquí sentado, imaginándote asesinando a alguien con un cubierto o la pata de una silla. Apagando la vida de alguien con el alzapaño de una cortina.",shape=box,color=blue];
		j4092536821 -> j1034286681;
	j2147769493 [label="El método del cazador. Ingenuo, pero elegante en su simplicidad. A veces, los métodos más sencillos y antiguos son, en el fondo, los más efectivos.",shape=box,color=blue];
		j2147769493 -> j296079711;
	j3134660526 [label="Un poco impersonal y clínico para mi gusto, pero no puedo juzgar su eficacia. Hay algo que decir sobre la calma.",shape=box,color=blue];
		j3134660526 -> j3135981793;
	j3114427218 [label="¿El siniestro boticario, eh? ¿Preparando tinturas y vertiendo viales en los vasos de los desprevenidos? ¿O impregnando cuchillos y balas con veneno para que el más leve golpe de refilón en el campo de batalla sea fatal?",shape=box,color=blue];
		j3114427218 -> j1612834111;
	j3091871787 [label="Mm, cuidado. Haces que me emocione, Usurpador. Qué interesante... la imagen de despertar una noche contigo acechando en las sombras, con daga en mano a punto de atacar...",shape=box,color=blue];
		j3091871787 -> j835766212;
	j1122435291 [label="+10 Chemistry",color=orange];
		j1122435291 -> j814253494;
	j1250640681 [label="Cabe apreciar el silencio en todo eso. Colocar la flecha, tensar la cuerda, anticipar el disparo... y luego la dulce, dulce muerte cuando da en el blanco.",shape=box,color=blue];
		j1250640681 -> j1337246537;
	j390361178 [label="Aprecio el deseo de un toque personal. Ver cómo las extremidades de tu víctima se desmoronan al acabar con su vida. Ver sus cuerpos sin vida desplomarse ante ti. Saber que fuiste tú quien lo hizo, y nadie más.",shape=box,color=blue];
		j390361178 -> j791419291;
	j3551932956 [label="Desordenado, ruidoso, carísimo. Pero muy, muy bueno matando.",shape=box,color=blue];
		j3551932956 -> j1941419440;
	j1034286681 [label="+10 Chemistry",color=orange];
		j1034286681 -> j1198893339;
	j296079711 [label="Cabe apreciar el silencio en todo eso. Colocar la flecha, tensar la cuerda, anticipar el disparo... y luego la dulce, dulce muerte cuando da en el blanco.",shape=box,color=blue];
		j296079711 -> j346148124;
	j3135981793 [label="En el clamor aparentemente implacable del campo de batalla, el francotirador debe recuperar el aliento como la marea del océano. Inhala, exhala y arrebata una vida.",shape=box,color=blue];
		j3135981793 -> j2670264351;
	j1612834111 [label="He visto batallones enteros reducidos a lodo por un solo corte en el brazo de un solo soldado. Una toxina que se propaga de la sangre a los pulmones de otro puede destruir países.",shape=box,color=blue];
		j1612834111 -> j1371929412;
	j835766212 [label="Aprecio el deseo de un toque personal. Mirar fijamente a los ojos de otra persona y ver cómo se van apagando a medida que la luz se desvanece y el calor abandona su cuerpo.",shape=box,color=blue];
		j835766212 -> j973975498;
	j814253494 [label="Yo... no sé si eso te hace más o menos aterrador, Usurpador. Creo que me quedaré con \"más\". Como sea, lo encuentro divertido y sorprendente a la vez.",shape=box,color=blue];
		j814253494 -> j777855750;
	j1337246537 [label="+10 Chemistry",color=orange];
		j1337246537 -> j3004190403;
	j791419291 [label="+10 Chemistry",color=orange];
		j791419291 -> j1855148114;
	j1941419440 [label="+10 Chemistry",color=orange];
		j1941419440 -> j801373284;
	j1198893339 [label="Yo... no sé si eso te hace más o menos aterrador, Usurpador. Creo que me quedaré con \"más\". Como sea, lo encuentro divertido y sorprendente a la vez.",shape=box,color=blue];
		j1198893339 -> j777855750;
	j346148124 [label="+10 Chemistry",color=orange];
		j346148124 -> j3365075424;
	j2670264351 [label="+10 Chemistry",color=orange];
		j2670264351 -> j3654900172;
	j1371929412 [label="+10 Chemistry",color=orange];
		j1371929412 -> j1913397067;
	j973975498 [label="+10 Chemistry",color=orange];
		j973975498 -> j678904855;
	j777855750 [label="Boolean RoatheWeaponImprov is now true.",color=orange];
		j777855750 -> j2067071206;
		j777855750 -> j3304571284;
		j777855750 -> j1099467350;
	j3004190403 [label="Hermoso.",shape=box,color=blue];
		j3004190403 -> j2888608214;
	j1855148114 [label="Qué momento tan bello.",shape=box,color=blue];
		j1855148114 -> j918012326;
	j801373284 [label="Hay un cierto tipo de belleza en ello.",shape=box,color=blue];
		j801373284 -> j4290874667;
	j3365075424 [label="Hermoso.",shape=box,color=blue];
		j3365075424 -> j2888608214;
	j3654900172 [label="Hay belleza en ello.",shape=box,color=blue];
		j3654900172 -> j4290874667;
	j1913397067 [label="¿Muerte a tal escala? Hay belleza en ello.",shape=box,color=blue];
		j1913397067 -> j3609398078;
	j678904855 [label="Qué momento tan bello.",shape=box,color=blue];
		j678904855 -> j918012326;
	j2067071206 [label="Estás haciendo que esto suene como si fuera algún tipo de... arte.",shape=box,color=red];
		j2067071206 -> j3807061296;
	j3304571284 [label="No me gusta tener que matar gente, Roathe. ",shape=box,color=red];
		j3304571284 -> j2913375358;
	j1099467350 [label="¿Y cuál es tu favorito?",shape=box,color=red];
		j1099467350 -> j1399268980;
	j2888608214 [label="Boolean RoatheWeaponBow is now true.",color=orange];
		j2888608214 -> j2067071206;
		j2888608214 -> j3304571284;
		j2888608214 -> j1099467350;
	j918012326 [label="Boolean RoatheWeaponDagger is now true.",color=orange];
		j918012326 -> j2067071206;
		j918012326 -> j3304571284;
		j918012326 -> j1099467350;
	j4290874667 [label="Boolean RoatheWeaponSniper is now true.",color=orange];
		j4290874667 -> j2067071206;
		j4290874667 -> j3304571284;
		j4290874667 -> j1099467350;
	j3609398078 [label="Boolean RoatheWeaponPoison is now true.",color=orange];
		j3609398078 -> j2067071206;
		j3609398078 -> j3304571284;
		j3609398078 -> j1099467350;
	j3807061296 [label="Porque es verdad. Y lo sabes. De hecho, ¡la mitad de tu existencia se basa literalmente en el concepto del arte de matar!",shape=box,color=blue];
		j3807061296 -> j3802751582;
	j2913375358 [label="Ah, ¿en serio? Analicemos eso un momento.",shape=box,color=blue];
		j2913375358 -> j410136386;
	j1399268980 [label="Ha cambiado últimamente. Y eso me molesta muchísimo.",shape=box,color=blue];
		j1399268980 -> j2639557436;
		j1399268980 -> j2719373994;
	j3802751582 [label="Veo estas \"escuelas\" que usan los tenno y que tú tomas prestadas indirectamente. Sin mencionar las enseñanzas de los Dax. Cómo hablaban sin parar por los canales de comunicación, sin importar cuántas veces les dijéramos que era un canal restringido.",shape=box,color=blue];
		j3802751582 -> j3124395427;
	j410136386 [label="Dime algo y, por favor, respóndeme con sinceridad. Porque mentir en este momento nos perjudica a ambos, pero sobre todo a ti.",shape=box,color=blue];
		j410136386 -> j776215256;
	j2639557436 [label="¿Cambió? ¿Cómo?",shape=box,color=red];
		j2639557436 -> j3665995285;
	j2719373994 [label="¿Por Uriel?",shape=box,color=red];
		j2719373994 -> j4171896779;
	j3124395427 [label="Si nunca más escucho a uno de ellos decirme que \"soy una espada\" y que \"existo para atacar\", moriré feliz, Usurpador.",shape=box,color=blue];
		j3124395427 -> j1064897225;
	j776215256 [label="¿Alguna vez has buscado equiparte con un arma o un warframe personalizado a tu gusto? ¿Quizás con una pintura única o con un aspecto que te guste más?",shape=box,color=blue];
		j776215256 -> j898091950;
		j776215256 -> j1739982092;
		j776215256 -> j727288331;
	j3665995285 [label="Solía preferir la espada como arma. Elegante. Rápida. Podía moverme por el campo de batalla y cortar a mis enemigos a quemarropa. El carmesí de una hoja plateada que brillaba con el resplandor de una estrella azul.",shape=box,color=blue];
		j3665995285 -> j4051043554;
	j4171896779 [label="Supongo que sí. O quizás sea por la falta de memoria. No sé qué otras razones podrían ser la causa.",shape=box,color=blue];
		j4171896779 -> j3665995285;
	j1064897225 [label="La humanidad siempre ha considerado el \"asesinato\" como un pecado, pero \"matar\" como un arte. ¿Nunca te ha parecido extraño? Blandir una espada y abatir a un enemigo en combate es algo casi trascendente.",shape=box,color=blue];
		j1064897225 -> j4056427061;
	j898091950 [label=" Yo... ¿y eso qué tiene que ver?",shape=box,color=red];
		j898091950 -> j1003006044;
	j1739982092 [label="No. Nunca.",shape=box,color=red];
		j1739982092 -> j3831599877;
	j727288331 [label="No jugaré este juego. [Fin]",shape=box,color=red];
		j727288331 -> j3878373915;
	j4051043554 [label="¿Pero ahora? Ahora quiero saborear la sangre en mis dientes. Sentirla brotar bajo mis garras. Quiero hundir mis dedos en la carne y el hueso y hacerlos pedazos.",shape=box,color=blue];
		j4051043554 -> j593561348;
	j4056427061 [label="Matar a un hombre con un trozo de metal afilado en un callejón es un acto que realiza un cobarde y un degenerado. ",shape=box,color=blue];
		j4056427061 -> j3181942906;
	j1003006044 [label="Aprecio tu honestidad. Ahora bien, no voy a negar que probablemente no disfrutas asesinar a sangre fría y que matar a un inocente no es algo que te deleite (aunque quizás sí y tu declaración anterior fue una mentira... y qué delicioso sería revelarla, pero no estamos aquí para hablar de eso).",shape=box,color=blue];
		j1003006044 -> j2074315634;
	j3831599877 [label="Te pediré que reflexiones un momento. He visto a tus amigos tenno sembrando el caos en este lugar, como si fueran pesadillas multicolores de circo. Como si un animal salvaje hubiera caído en los botes de pintura de un artista. ",shape=box,color=blue];
		j3831599877 -> j266828321;
	j3878373915 [label="Muy bien.",shape=box,color=blue];
		j3878373915 -> "Chat ends.";
	j593561348 [label="Quiero beber el icor a sorbos mientras rompo tendones y siento el cuerpo desgarrarse abajo de mí, dejando sólo fragmentos sangrientos. Pelarlo como una fruta dulce, mientras la médula fluye.",shape=box,color=blue];
		j593561348 -> j949996497;
		j593561348 -> j1837754089;
	j3181942906 [label="¿Cuál es la diferencia? ¿\"Honor\"? ¿Quién decide qué es honorable y qué no? ¿El perdedor o el ganador? ¿O simplemente la existencia de una tradición que declara qué es honorable y qué no?",shape=box,color=blue];
		j3181942906 -> j1727845415;
		j3181942906 -> j1467442008;
		j3181942906 -> j1216278797;
	j2074315634 [label="Sin embargo, suponiendo que ese no sea el caso y que simplemente estás matando porque \"tienes que hacerlo\", como dijiste, entonces ¿por qué, dime, perderías el tiempo equipando tus armas mortales de manera personalizada?",shape=box,color=blue];
		j2074315634 -> j3758920240;
	j266828321 [label="¿Nunca te has sentido obligado a hacer lo mismo? ¿Ni una sola vez? Te juro que no te menospreciaré por admitirlo.",shape=box,color=blue];
		j266828321 -> j4264350461;
		j266828321 -> j266828778;
	j949996497 [label="¿Roathe?",shape=box,color=red];
		j949996497 -> j2287112144;
	j1837754089 [label="¿Y eso... no es normal para ti?",shape=box,color=red];
		j1837754089 -> j2954644701;
	j1727845415 [label="Entiendo tu punto. La línea es borrosa. ",shape=box,color=red];
		j1727845415 -> j2536024583;
	j1467442008 [label="Uno requiere práctica y dedicación. El otro sólo... brutalidad.",shape=box,color=red];
		j1467442008 -> j3765787544;
	j1216278797 [label="No voy a tener esta conversación. [Fin]",shape=box,color=red];
		j1216278797 -> j3878373915;
	j3758920240 [label="¿Por qué preocuparse por cómo te verán los demás en el campo de la muerte? Ciertamente no para que otros identifiquen tu cadáver. No hay forma de confundirte en ninguna parte. No, porque si tienes que ser un asesino, mi querido Usurpador, apuesto a que deseas hacerlo con estilo.",shape=box,color=blue];
		j3758920240 -> j4186532242;
	j4264350461 [label="No.",shape=box,color=red];
		j4264350461 -> j3878373915;
	j266828778 [label="Está bien. Sí. ¿Por qué?",shape=box,color=red];
		j266828778 -> j1003006044;
	j2287112144 [label="¡Sí, lo sé! Lo sé. No voy a hacer nada de esto, ¿entiendes? Tampoco voy a quemar todo este lugar a mi alrededor aunque muera de ganas de hacerlo.",shape=box,color=blue];
		j2287112144 -> j2507430462;
	j2954644701 [label="¡No! ¡No lo es! ¡Y no es normal que se me haga agua la boca pensar en reducir este lugar a cenizas!",shape=box,color=blue];
		j2954644701 -> j2507430462;
	j2536024583 [label="Todas estas líneas se trazan arbitrariamente. Y cuanto antes lo entendamos, más rápido podremos ponernos de acuerdo sobre cuáles batallas son importantes y cuáles no.",shape=box,color=blue];
		j2536024583 -> j3445946025;
	j3765787544 [label="Muy bien, sigamos esa línea de razonamiento hasta el final. ¿Matar con suficiente práctica lo hace honorable? Entonces, ¿dices que si soy como el Dax y simplemente enmascaro mi asesinato con suficiente pompa y solemnidad, eso lo convierte en arte?",shape=box,color=blue];
		j3765787544 -> j2510862208;
	j4186532242 [label="¿Y qué es esto, pregunto, sino el placer del acto mismo?",shape=box,color=blue];
		j4186532242 -> j3710936273;
	j2507430462 [label="Uriel debe ser el culpable. Aunque admito que antes tenía inclinaciones hacia pensamientos destructivos y sanguinarios, no eran ni de lejos tan catastróficos.",shape=box,color=blue];
		j2507430462 -> j3858917001;
	j3445946025 [label="Decidir si un asesinato se cometió con honor es como intentar decidir qué es peor, morir en el fuego o ahogado. Ambas son formas miserables de morir.",shape=box,color=blue];
		j3445946025 -> j1431941234;
	j2510862208 [label="Ahora estamos siguiendo la línea del ritual y la religión.",shape=box,color=blue];
		j2510862208 -> j2039826425;
	j3710936273 [label="¡No me malinterpretes! No te estoy juzgando. ¡Estás sacando el máximo provecho de tu situación! La muerte te ha convertido en su compañera de baile en esta gran farsa de la vida y sólo te queda escuchar su llamado.",shape=box,color=blue];
		j3710936273 -> j2800348528;
	j3858917001 [label="Y ciertamente no tan... apocalíptico.",shape=box,color=blue];
		j3858917001 -> "Chat ends.";
	j1431941234 [label="Y todos los caminos llevan a la tumba, así que ¿para qué ser quisquilloso? Tenemos problemas mucho más importantes que resolver.",shape=box,color=blue];
		j1431941234 -> "Chat ends.";
	j2039826425 [label="Al menos hay honestidad en una puñalada por la espalda, una muerte fácil y simple. No hay nada piadoso en ella. Nada ostentoso ni excesivo. Simplemente sucede.",shape=box,color=blue];
		j2039826425 -> j4146711876;
	j2800348528 [label="¿Habrías depuesto las armas? Me pregunto cuántos otros habrían muerto contigo. No, ¿por qué no enorgullecerte de tu trabajo? ¿Disfrutar del arte que lo rodea? Te pregunto, ¿cuál es la alternativa? ¿La locura? ¿El olvido?",shape=box,color=blue];
		j2800348528 -> j3992542986;
	j4146711876 [label="¿No hay arte en eso?",shape=box,color=blue];
		j4146711876 -> "Chat ends.";
	j3992542986 [label="He visto a muchos ir por ese camino y encontrar el final de una soga esperándolos. No. Te digo, haz lo que quieras, Usurpador. Porque la vida sin duda ha hecho lo que ha querido contigo.",shape=box,color=blue];
		j3992542986 -> "Chat ends.";
