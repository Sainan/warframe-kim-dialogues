		j1172864870 -> j1694442906 [label="false",color=purple];
	j2813753334 [label="Evaluate expressions",color=orange];
		j2813753334 -> j3971063715 [label="RoatheVillain",color=purple];
		j2813753334 -> j4013054563 [label="RoatheRedeemed",color=purple];
		j2813753334 -> j3153752388 [label="false",color=purple];
	j3461680118 [label="¿Que qué opino de Marie? ¿Además de intentar convencerte de que la dejes pasar una o dos noches con nosotros, querido Viajero? (Es broma, es broma)",shape=box,color=blue];
		j3461680118 -> j2225832919;
	j406748478 [label="¿Que qué opino de Marie? ¿Además de intentar convencerte de que me dejes pasar una o dos noches con ustedes? (Es broma, es broma)",shape=box,color=blue];
		j406748478 -> j860849882;
	j2699028029 [label="¿Cómo lograste convencerla de cambiar de opinión sobre la pureza de Albrecht? Eres todo un \"hacedor de milagros\". Quizás no deberían adorar a Sol y Lua, sino a ti.",shape=box,color=blue];
		j2699028029 -> j1120232751;
	j3678263303 [label="Nunca supe que todavía sufría a diario. Lo ocultaba como si no existiera. No habló de ello hasta que te lo contó. Has acortado la distancia entre nosotros.",shape=box,color=blue];
		j3678263303 -> j256519583;
	j292294703 [label="Hasta hace poco, no sabía nada de su historia. Nunca me la había contado hasta que te la contó a ti. De alguna manera, has acortado la distancia entre nosotros.",shape=box,color=blue];
		j292294703 -> j2275524926;
	j4273997037 [label="Lo mismo de siempre. Paso cada momento despierto intentando no arrancarme la cara con las garras por el desesperado deseo de ahogarla.",shape=box,color=blue];
		j4273997037 -> "Chat ends.";
	j2294573025 [label="Mejor ahora que tengo a alguien con quien desahogarme. Pero hablando en serio, la tensión entre nosotros ha disminuido bastante.",shape=box,color=blue];
		j2294573025 -> j2384888382;
	j1749936565 [label="No soy yo quien se \"lleva bien\" con Lyon, ¿cierto? ¡Ja! Perdona la broma. No puedo evitarlo, y me lo pusiste demasiado fácil.",shape=box,color=blue];
		j1749936565 -> j3020974330;
	j1904713877 [label="Mejor de lo que parece ir su relación. ¿Cómo causaste este lío con él? Sólo necesitaba que alguien lo escuchara.",shape=box,color=blue];
		j1904713877 -> j2376634581;
	j2382511326 [label="Las tensiones entre nosotros han disminuido bastante, sobre todo desde que le diste confianza para hablar de lo que le ha estado aquejando.",shape=box,color=blue];
		j2382511326 -> j3510581228;
	j3928761771 [label="Las tensiones entre nosotros han disminuido bastante, sobre todo desde que le diste confianza para hablar de lo que le ha estado aquejando.",shape=box,color=blue];
		j3928761771 -> j2602110962;
	j1694442906 [label="Lo mismo de siempre. Paso cada momento despierto intentando no arrancarme la cara con las garras por el desesperado deseo de ahogarlo.",shape=box,color=blue];
		j1694442906 -> "Chat ends.";
	j3971063715 [label="Admito que, poco a poco, los estoy encontrando un poco más tolerables. Creo que se debe principalmente a que, poco a poco, me han dejado tranquilo.",shape=box,color=blue];
		j3971063715 -> j4048388354;
	j4013054563 [label="Admito que, poco a poco, los encuentro un poco más tolerables. Creo que mis recientes revelaciones podrían tener algo que ver con eso.",shape=box,color=blue];
		j4013054563 -> j1973607540;
	j3153752388 [label="Siempre me pregunto si, aunque no pueda usar la Oscuridad Refractaria para recuperar mis recuerdos, ya que ahora soy un protoframe...",shape=box,color=blue];
		j3153752388 -> j2564010345;
	j2225832919 [label="¿Me pregunto si se dará cuenta de que mi provocación ha pasado de ser una molestia sincera a una broma juguetona?",shape=box,color=blue];
		j2225832919 -> j1721483009;
	j860849882 [label="Debo admitir que no te culpo en lo más mínimo. Y no sólo porque sea guapísima. Tengo ojos. Esa mujer tiene más compasión de la que hubiera esperado para llegar a su edad.",shape=box,color=blue];
		j860849882 -> j2225832919;
	j1120232751 [label="Bah. Ese tipo de lenguaje fue el que condujo al surgimiento del Imperio orokin. Es un error que este Sistema no debería cometer dos veces.",shape=box,color=blue];
		j1120232751 -> j2225832919;
	j256519583 [label="Admito que soy uno de esos tontos de los que ella habla, que no pueden comprender cómo es vivir de esa manera, día tras día.",shape=box,color=blue];
		j256519583 -> j503431952;
	j2275524926 [label="Y pensar que su familia la echó a la calle. A ella. Marie. Esa Marie. ¡La que tenía más compasión de la que debería!",shape=box,color=blue];
		j2275524926 -> j990450062;
	j2384888382 [label="Saben mi... secreto. La verdad del porqué tomé el suero voluntariamente.",shape=box,color=blue];
		j2384888382 -> j1254258912;
		j2384888382 -> j204932354;
	j3020974330 [label="Te felicito por enfrentar a ese pobre loco. Necesita compañía. Y compasión.",shape=box,color=blue];
		j3020974330 -> j4029208307;
	j2376634581 [label="Aun así lo dejaste fuera. Qué vergüenza.",shape=box,color=blue];
		j2376634581 -> "Chat ends.";
	j3510581228 [label="Me habló del niño tenno al que había estado escuchando. Y de cómo ya no lo escucha.",shape=box,color=blue];
		j3510581228 -> j2056194504;
	j2602110962 [label="Sabía sorprendentemente poco de lo que le habían hecho. No fue hasta que te lo contó que tuvo la disposición de contármelo. ",shape=box,color=blue];
		j2602110962 -> j854635713;
	j4048388354 [label="Es broma. Es raro pero les estoy tomando cariño, a pesar de mi renovado compromiso de ignorar sus críticas a mis decisiones de vida.",shape=box,color=blue];
		j4048388354 -> j3489806326;
		j4048388354 -> j2434864130;
	j1973607540 [label="Esperaba que recibieran mi penitencia con burla, con mofas de \"por fin ve la luz\" o \"te lo dijimos\". Todo lo contrario. Apenas lo han mencionado.",shape=box,color=blue];
		j1973607540 -> j3499202411;
	j2564010345 [label="... si eso no evita que me ahogue ahí.",shape=box,color=blue];
		j2564010345 -> "Chat ends.";
	j1721483009 [label="Eso espero. Es muy divertido molestarla. Verla enojarse y gritarme en su lengua materna es mi nuevo deporte favorito.",shape=box,color=blue];
		j1721483009 -> j2259022051;
	j503431952 [label="¿Cómo puede mantener tanta compostura? Y ni hablemos de compasión. Creo que, en su lugar, me habría vuelto igual de loco que el sacerdote.",shape=box,color=blue];
		j503431952 -> j2225832919;
	j990450062 [label="No puedo ni empezar a describirte cuánto desearía usar un Helminto para viajar en el tiempo y asesinar a toda su familia. Lentamente. Pero ella probablemente se opondría. ",shape=box,color=blue];
		j990450062 -> j3475873802;
	j1254258912 [label="No les dije.",shape=box,color=red];
		j1254258912 -> j3089399729;
	j204932354 [label="¿Cómo se enteraron?",shape=box,color=red];
		j204932354 -> j4146626370;
	j4029208307 [label="Pero hablando en serio, la tensión entre nosotros ha disminuido bastante.",shape=box,color=blue];
		j4029208307 -> j2384888382;
	j2056194504 [label="Supongo que la voz lo perseguirá en sus pesadillas. Ese pobre hombre siempre cuestionará la línea entre la realidad y la ficción.",shape=box,color=blue];
		j2056194504 -> j4065498907;
	j854635713 [label="No puedo ni empezar a describirte cuánto desearía usar un Helminto para viajar en el tiempo y asesinar a sus padres. Muy lentamente. Pero temo que se oponga.",shape=box,color=blue];
		j854635713 -> j923199005;
	j3489806326 [label="De todas formas, ustedes tres están atrapados juntos. Entrati se encargó de eso. Así que no hay problema en aprovecharlo al máximo.",shape=box,color=red];
		j3489806326 -> j3494507004;
	j2434864130 [label="Me alegro. Creo que realmente se preocupan por ti.",shape=box,color=red];
		j2434864130 -> j2224278967;
	j3499202411 [label="Me alegro de que no lo hayan hecho. No quiero que me lo restrieguen en la nariz como a un cachorro que ha ensuciado la alfombra. Ya tengo bastante en qué pensar.",shape=box,color=blue];
		j3499202411 -> j3489806326;
		j3499202411 -> j2434864130;
	j2259022051 [label="¿Otra razón por la que las cosas han mejorado entre nosotros? Saben mi secreto. La verdad del porqué tomé el suero voluntariamente.",shape=box,color=blue];
		j2259022051 -> j1558822958;
		j2259022051 -> j300632902;
	j3475873802 [label="Los asesinatos por venganza probablemente sean mal vistos por Sol, etcétera, etcétera. ",shape=box,color=blue];
		j3475873802 -> j2225832919;
	j3089399729 [label="Tampoco afirmaba que lo habías hecho, querido Viajero. Se los dije.",shape=box,color=blue];
		j3089399729 -> j1806500125;
	j4146626370 [label="Yo les dije, querido Viajero.",shape=box,color=blue];
		j4146626370 -> j1806500125;
	j4065498907 [label="¿Otra razón por la que las cosas han mejorado entre nosotros?",shape=box,color=blue];
		j4065498907 -> j2384888382;
	j923199005 [label="Los asesinatos por venganza probablemente sean mal vistos por Lua, etcétera, etcétera. ",shape=box,color=blue];
		j923199005 -> j943370644;
	j3494507004 [label="Exactamente. No hay necesidad de llevarte mal con tus nuevos compañeros de piso. Precisamente por eso les llevaba pastelillos a escondidas en Gaule.",shape=box,color=blue];
		j3494507004 -> j480100102;
	j2224278967 [label="A pesar de todos mis esfuerzos, sí. Y es incomprensible. Sin embargo, aquí estamos.",shape=box,color=blue];
		j2224278967 -> j4021745093;
	j1558822958 [label="¿Cómo se enteraron?",shape=box,color=red];
		j1558822958 -> j2590064329;
	j300632902 [label="No les dije.",shape=box,color=red];
		j300632902 -> j1813457607;
