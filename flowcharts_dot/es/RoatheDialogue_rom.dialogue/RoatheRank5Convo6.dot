		j3363163209 -> j685122875;
		j3363163209 -> j1278608763;
	j3348738900 [label="Esperaba que se burlaran de mi vergüenza, con burlas como \"por fin, el diablo ha sido humillado\". En cambio, apenas lo mencionaron.",shape=box,color=blue];
		j3348738900 -> j2413998037;
	j873793282 [label="No fue como lo esperaba. Una tarde, días después, mientras leía en silencio, se acercó solo.",shape=box,color=blue];
		j873793282 -> j3263953492;
	j685122875 [label="¿Ha cambiado algo debido a esto?",shape=box,color=red];
		j685122875 -> j158972022;
	j1278608763 [label="¿Cómo reaccionó Marie?",shape=box,color=red];
		j1278608763 -> j735927810;
	j2413998037 [label="Lyon en particular. Creo que entiende la dificultad de lidiar con el pasado y las decisiones que hemos tomado.",shape=box,color=blue];
		j2413998037 -> j32725969;
	j3263953492 [label="Se sentó a mi lado y me contó cómo ha cuestionado su fe desde que Entrati le dio el suero. Cuánto se avergonzaba de cuestionarlo. Cuánto se arrepentía de haberlo tomado.",shape=box,color=blue];
		j3263953492 -> j1546734926;
	j158972022 [label="Esperaba que se burlaran de mi vergüenza, con burlas como \"por fin, el diablo ha sido humillado\". En cambio, apenas lo mencionaron.",shape=box,color=blue];
		j158972022 -> j1529697638;
	j735927810 [label="No fue como lo esperaba. No dijo nada. En cambio, simplemente... me abrazó. ",shape=box,color=blue];
		j735927810 -> j598317519;
	j32725969 [label="Check boolean LyonConfession2",color=orange];
		j32725969 -> j3845507160 [label=true,color=green];
		j32725969 -> j1365899340 [label=true,color=green];
		j32725969 -> j1365899340 [label=false,color=brown];
	j1546734926 [label="Y lo más importante, cuánto deseaba poder olvidarlo todo. Y que quizás, en un nivel más profundo, no éramos todos iguales, los tres.",shape=box,color=blue];
		j1546734926 -> j3665611748;
		j1546734926 -> j3628981567;
	j1529697638 [label="En particular, Marie. Creo que entiende que confrontarme constantemente por asuntos del pasado no servirá de nada.",shape=box,color=blue];
		j1529697638 -> j3137425038;
	j598317519 [label="Evaluate expressions",color=orange];
		j598317519 -> j871793701 [label="RoatheRedeemed",color=purple];
		j598317519 -> j3359119098 [label="RoatheVillain",color=purple];
		j598317519 -> j3254742354 [label="false",color=purple];
	j3845507160 [label="Creo que también sabe lo que es ser producto de tu sociedad y tu contexto. Quizás simpatice más con tu pasado de lo que crees.",shape=box,color=red];
		j3845507160 -> j3038863232;
	j1365899340 [label="Me alegra mucho que hayan encontrado algún tipo de amistad. Aunque sólo sea un alto al fuego. ",shape=box,color=red];
		j1365899340 -> j1500379599;
	j3665611748 [label="¿Qué hiciste?",shape=box,color=red];
		j3665611748 -> j3662581290;
	j3628981567 [label="¿Y qué hay de Marie?",shape=box,color=red];
		j3628981567 -> j802102498;
	j3137425038 [label="Check boolean MarieEntratiCompleteA",color=orange];
		j3137425038 -> j2651066742 [label=true,color=green];
		j3137425038 -> j2556373395 [label=true,color=green];
		j3137425038 -> j2556373395 [label=false,color=brown];
	j871793701 [label="El Roathe de antaño habría aprovechado la oportunidad para extraerle los riñones del cuerpo, pero descubrí que ya no tenía deseos de hacerlo. ",shape=box,color=blue];
		j871793701 -> j3022851795;
	j3359119098 [label="Tuve que recurrir a toda mi fuerza de voluntad para no extirparle los riñones. Pero ella sólo pretendía ofrecerme un simple consuelo.",shape=box,color=blue];
		j3359119098 -> j265353392;
	j3254742354 [label="Ella sólo quería ofrecerme un simple consuelo.",shape=box,color=blue];
		j3254742354 -> j2416223260;
		j3254742354 -> j2344386083;
	j3038863232 [label="+10 Chemistry",color=orange];
		j3038863232 -> j1811608871;
	j1500379599 [label="+5 Chemistry",color=orange];
		j1500379599 -> j2347876192;
	j3662581290 [label="Estreché la mano y le di las gracias como amigo. Soy un orokin, pero no un monstruo.",shape=box,color=blue];
		j3662581290 -> j3181915651;
	j802102498 [label="Cuando le conté la verdad de la que nos enteramos, no dijo nada. En vez de eso, sólo... me abrazó.",shape=box,color=blue];
		j802102498 -> j1093047434;
	j2651066742 [label="En especial después de todo lo que supo sobre Entrati. Sabe que las personas pueden ser más complejas que el simple blanco y negro.",shape=box,color=red];
		j2651066742 -> j2206284025;
	j2556373395 [label="Me alegra mucho que hayan encontrado algún tipo de amistad. Aunque sólo sea un alto al fuego.",shape=box,color=red];
		j2556373395 -> j2703104173;
	j3022851795 [label="Por una vez en mi miserable vida, acepté la simple oferta de consuelo por lo que era.",shape=box,color=blue];
		j3022851795 -> j265353392;
	j265353392 [label="Fue una forma sencilla de decirme que quizá no le importaba tanto como a mí. Y que lamentaba todo el dolor que me había causado.",shape=box,color=blue];
		j265353392 -> j2416223260;
		j265353392 -> j2344386083;
	j2416223260 [label="¿Y Lyon?",shape=box,color=red];
		j2416223260 -> j1039394994;
	j2344386083 [label="¿Qué hiciste?",shape=box,color=red];
		j2344386083 -> j956306374;
	j1811608871 [label="Me temo que tienes razón. El destino ha sido implacable con él, y él ha hecho todo lo posible por resistirlo.",shape=box,color=blue];
		j1811608871 -> j3920448217;
	j2347876192 [label="Creo que al final será mucho más que eso. Aunque detesto la idea. Después de todo, no puedo evitar quedar atrapado con ellos.",shape=box,color=blue];
		j2347876192 -> j3920448217;
	j3181915651 [label="¿Y desde entonces?",shape=box,color=blue];
		j3181915651 -> j3912764117;
	j1093047434 [label="Evaluate expressions",color=orange];
		j1093047434 -> j529975008 [label="RoatheRedeemed",color=purple];
		j1093047434 -> j3784143232 [label="RoatheVillain",color=purple];
		j1093047434 -> j1894845537 [label="false",color=purple];
	j2206284025 [label="+10 Chemistry",color=orange];
		j2206284025 -> j787409426;
	j2703104173 [label="+5 Chemistry",color=orange];
		j2703104173 -> j377479299;
	j1039394994 [label="Una tarde, días después, mientras leía en silencio, se acercó solo.",shape=box,color=blue];
		j1039394994 -> j140586009;
	j956306374 [label="Por supuesto, le devolví el abrazo. Soy un orokin, pero no un monstruo.",shape=box,color=blue];
		j956306374 -> j2207806055;
	j3920448217 [label="Ese sacerdote. Si tuviera que concluir con una sola nota, sería esta: su resiliencia es, de alguna manera, tan infinita como el tiempo mismo.",shape=box,color=blue];
		j3920448217 -> j283795794;
	j3912764117 [label="Apenas lo ha mencionado y le estoy profundamente agradecido por ello. Esperaba burlas y mofas. \"¡Por fin, el diablo ha sido derrotado!\" Todo lo contrario. Siguieron como si nada.",shape=box,color=blue];
		j3912764117 -> j2413998037;
	j529975008 [label="El Roathe de antaño habría aprovechado la oportunidad para extraerle los riñones del cuerpo, pero descubrí que ya no tenía deseos de hacerlo. ",shape=box,color=blue];
		j529975008 -> j3940779719;
	j3784143232 [label="Tuve que recurrir a toda mi fuerza de voluntad para no extirparle los riñones. Pero ella sólo pretendía ofrecerme un simple consuelo.",shape=box,color=blue];
		j3784143232 -> j2529263418;
	j1894845537 [label="Ella sólo quería ofrecerme un simple consuelo.",shape=box,color=blue];
		j1894845537 -> j453920870;
	j787409426 [label="En efecto. Y te lo debo a ti, ¿no?",shape=box,color=blue];
		j787409426 -> j1114274629;
	j377479299 [label="Creo que al final será mucho más que eso. Aunque detesto la idea. Después de todo, no puedo evitar quedar atrapado con ellos.",shape=box,color=blue];
		j377479299 -> j1114274629;
	j140586009 [label="Se sentó a mi lado y me contó cómo ha cuestionado su fe desde que Entrati le dio el suero. Cuánto se avergonzaba de cuestionarlo. Cuánto se arrepentía de haberlo tomado.",shape=box,color=blue];
		j140586009 -> j3929865921;
	j2207806055 [label="¿Y desde entonces?",shape=box,color=blue];
		j2207806055 -> j3662332908;
	j283795794 [label="Para un hombre que se ha hecho añicos, aún no se ha desmoronado.",shape=box,color=blue];
		j283795794 -> j1622505995;
	j3940779719 [label="Por una vez en mi miserable vida, acepté la simple oferta de consuelo por lo que era.",shape=box,color=blue];
		j3940779719 -> j2529263418;
	j2529263418 [label="Fue una forma sencilla de decirme que quizá no le importaba tanto como a mí. Y que lamentaba todo el dolor que me había causado.",shape=box,color=blue];
		j2529263418 -> j453920870;
	j453920870 [label="¿Y desde entonces?",shape=box,color=blue];
		j453920870 -> j1507848605;
	j1114274629 [label="Esa Hermana de Sol. Si tuviera que concluir con una sola nota, sería esta: su amabilidad es, de alguna manera, tan infinita como el tiempo mismo.",shape=box,color=blue];
		j1114274629 -> j1903460966;
	j3929865921 [label="Y lo más importante, cuánto deseaba poder olvidarlo todo. Y que quizás, en un nivel más profundo, no éramos todos iguales, los tres.",shape=box,color=blue];
		j3929865921 -> j2207806055;
	j3662332908 [label="Apenas lo han mencionado, y les estoy profundamente agradecido por ello. Esperaba burlas y mofas. \"¡Por fin, el diablo ha sido derrotado!\" Todo lo contrario. Siguieron como si nada.",shape=box,color=blue];
		j3662332908 -> j1529697638;
