		j1011297847 -> j735593045;
		j1011297847 -> j4210864871;
	j3748742902 [label="+10 Chemistry",color=orange];
		j3748742902 -> j929328735;
	j2844619073 [label="Haré lo que pueda para no arruinarte todo, ¿eh? Bueno. No es que no tenga arreglo. No puedo hacerte los días demasiado aburridos, podrías volverte loco como el sacerdote.",shape=box,color=blue];
		j2844619073 -> "Chat ends.";
