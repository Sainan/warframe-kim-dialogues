	j943370644 [label="¿Otra razón por la que las cosas hayan mejorado entre nosotros?",shape=box,color=blue];
		j943370644 -> j2384888382;
	j480100102 [label="Mmm. Quizás intente replicar la receta aquí. Pero, sea como sea, haré lo que pueda para mantener la paz. Bueno, casi.",shape=box,color=blue];
		j480100102 -> j3748742902;
	j4021745093 [label="+10 Chemistry",color=orange];
		j4021745093 -> j2844619073;
	j2590064329 [label="Yo les dije, querido Viajero.",shape=box,color=blue];
		j2590064329 -> j4131114853;
	j1813457607 [label="Tampoco afirmaba que lo habías hecho, querido Viajero. Se los dije.",shape=box,color=blue];
		j1813457607 -> j4131114853;
	j1323832396 [label="Es sólo otra cosa por la que debo enmendar mi error. De todas formas, tarde o temprano descubrirán la verdad. Mejor que la escuchen de mis propios labios.",shape=box,color=blue];
		j1323832396 -> j735593045;
		j1323832396 -> j4210864871;
	j1803471576 [label="No tengo nada de qué avergonzarme. Me pareció inútil ocultarlo. Pronto descubrirían la verdad de alguna manera. Mejor que la escuchen de mis propios labios.",shape=box,color=blue];
		j1803471576 -> j735593045;
		j1803471576 -> j4210864871;
