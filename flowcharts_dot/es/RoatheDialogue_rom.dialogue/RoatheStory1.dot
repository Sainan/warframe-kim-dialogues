	2132 [label="Transcripción: Su locura era seductora porque era evidente.",shape=box,color=blue];
		2132 -> 5636;
	5636 [label="Con ella siempre supimos qué esperar, al borde del abismo de sus insondables profundidades.",shape=box,color=blue];
		5636 -> 5635;
	5635 [label="\"Sumérgete\", parecían decir sus ojos, brillando con la alegría de una broma cósmica colosal.",shape=box,color=blue];
		5635 -> 5637;
	5637 [label="A través de sus visiones dementes, escapé del largo y lúgubre estancamiento de la existencia orokin.",shape=box,color=blue];
		5637 -> 2136;
	2136 [label="Todos nuestros sentidos habían estado entumecidos durante siglos. Sin embargo, a su manera, ella se mantenía fresca.",shape=box,color=blue];
		2136 -> 5638;
	5638 [label="Eterna. Insaciable en su sed. Una noche, me llamó mientras se bañaba. Crucé los charcos de agua perfumada y sangre y me puse en posición de firmes.",shape=box,color=blue];
		5638 -> 5639;
	5639 [label="\"Estoy aburrida, Roathe. Matemos a todos los demás orokin y tomemos el control\".",shape=box,color=blue];
