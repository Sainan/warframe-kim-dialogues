	j1392520912 [label="MV: NITOKH",shape=box,color=blue];
		j1392520912 -> j4173312770;
	j4173312770 [label="Transcripción: Su locura era seductora porque era evidente.",shape=box,color=blue];
		j4173312770 -> j2152165754;
	j2152165754 [label="Con ella siempre supimos qué esperar, al borde del abismo de sus insondables profundidades.",shape=box,color=blue];
		j2152165754 -> j4041758619;
	j4041758619 [label="\"Sumérgete\", parecían decir sus ojos, brillando con la alegría de una broma cósmica colosal.",shape=box,color=blue];
		j4041758619 -> j3376645221;
	j3376645221 [label="A través de sus visiones dementes, escapé del largo y lúgubre estancamiento de la existencia orokin.",shape=box,color=blue];
		j3376645221 -> j4291999975;
	j4291999975 [label="Todos nuestros sentidos habían estado entumecidos durante siglos. Sin embargo, a su manera, ella se mantenía fresca.",shape=box,color=blue];
		j4291999975 -> j3445694520;
	j3445694520 [label="Eterna. Insaciable en su sed. Una noche, me llamó mientras se bañaba. Crucé los charcos de agua perfumada y sangre y me puse en posición de firmes.",shape=box,color=blue];
		j3445694520 -> j1739925846;
	j1739925846 [label="\"Estoy aburrida, Roathe. Matemos a todos los demás orokin y tomemos el control\".",shape=box,color=blue];
		j1739925846 -> j921430358;
	j921430358 [label="Add 1 to HellStory counter",color=orange];
		j921430358 -> "Chat ends.";
}