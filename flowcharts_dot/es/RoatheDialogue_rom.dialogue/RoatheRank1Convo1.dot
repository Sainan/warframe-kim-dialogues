digraph {
	graph [fontname="Roboto Condensed"];
	node [fontname="Roboto Condensed"];
	edge [fontname="Roboto Condensed"];

	"RoatheRank1Convo1 begins." [color=orange];
		"RoatheRank1Convo1 begins." -> j3998890108;
	j3998890108 [label="Evaluate expressions on HellStory counter",color=orange];
		j3998890108 -> j2466025120 [label="x >= 21",color=purple];
		j3998890108 -> j2036338784 [label="x >= 6",color=purple];
		j3998890108 -> j2521449452 [label="x < 6",color=purple];
		j3998890108 -> j2521449452 [label="false",color=purple];
	j2466025120 [label="¡Debo felicitarte por tu audacia! ¿De verdad estás seguro de que no eres un orokin disfrazado? ¡¿Quizás ocultas tu piel azul celeste para no alertar a los demás?!",shape=box,color=blue];
		j2466025120 -> j2356459291;
		j2466025120 -> j3664635308;
		j2466025120 -> j1863019055;
	j2036338784 [label="Boolean RoatheResetEdgeCase is now true.",color=orange];
		j2036338784 -> j2521449452;
	j2521449452 [label="La anomalía nacida del Vacío. \"El Viajero\". El Usurpador. Por fin hablamos. Ven. El Diablo tiene una propuesta que hacer...",shape=box,color=blue];
		j2521449452 -> j2516252918;
		j2521449452 -> j1477968008;
		j2521449452 -> j2953520881;
		j2521449452 -> j2566819235;
	j2356459291 [label="Hola, Roathe.",shape=box,color=red];
		j2356459291 -> j1764865194;
	j3664635308 [label="¿De qué me acusas exactamente?",shape=box,color=red];
		j3664635308 -> j555357402;
	j1863019055 [label="¿Disculpa?",shape=box,color=red];
		j1863019055 -> j555357402;
	j2516252918 [label="¿Usurpador?",shape=box,color=red];
		j2516252918 -> j3050506482;
	j1477968008 [label="¿Qué... clase de trato?",shape=box,color=red];
		j1477968008 -> j2267936320;
	j2953520881 [label="¿Qué tipo de propuesta podría tener para mí \"el Diablo de Tau\"?",shape=box,color=red];
		j2953520881 -> j1645713061;
	j2566819235 [label="Hola, Roathe.",shape=box,color=red];
		j2566819235 -> j1707057543;
	j1764865194 [label="¡Ah, bien! ¡Sí que sabes mi nombre! Estaba seguro de que se te había pasado por alto, ¡ya que estabas demasiado ocupado masacrándome repetidamente!",shape=box,color=blue];
		j1764865194 -> j109045943;
	j555357402 [label="¡¿De verdad no tienes nada más productivo que hacer?! ¿O es que jugar ronda tras ronda de \"ponerle el cuerno al Yaznak\" es realmente la mejor manera de emplear tu tiempo?",shape=box,color=blue];
		j555357402 -> j109045943;
	j3050506482 [label="Boolean RoatheUsurper is now true.",color=orange];
		j3050506482 -> j3832612368;
	j2267936320 [label="Mmm, no hay motivo de preocupación... ni de emoción. Todavía no. Se trata simplemente de un acuerdo de negocios entre dos personas que se beneficiarán mutuamente de manera significativa.",shape=box,color=blue];
		j2267936320 -> j1707057543;
	j1645713061 [label="+5 Chemistry",color=orange];
		j1645713061 -> j4062785555;
	j1707057543 [label="Ahora, escucha con atención. Esos dos fanáticos han sido terriblemente monótonos y repetitivos en sus insultos contra mí. Espero que puedas superar esa actitud tan paternalista.",shape=box,color=blue];
		j1707057543 -> j1878828597;
		j1707057543 -> j3342777529;
	j109045943 [label="Me resulta muy difícil creer que todo esto, toda esta injusticia que he sufrido a tus manos, todo este desmoronamiento de mi psique, ¡no haya sido puramente por despecho a tu instancias!",shape=box,color=blue];
		j109045943 -> j1538800536;
		j109045943 -> j2938410307;
		j109045943 -> j2814467111;
	j3832612368 [label="+5 Chemistry",color=orange];
		j3832612368 -> j1775020736;
	j4062785555 [label="Veo que mi reputación me precede. Bien. Nos ahorrará tiempo.",shape=box,color=blue];
		j4062785555 -> j3275343182;
	j1878828597 [label="Yo no recibo órdenes tuyas.",shape=box,color=red];
		j1878828597 -> j4026548805;
	j3342777529 [label="Veré qué puedo hacer.",shape=box,color=red];
		j3342777529 -> j168243474;
	j1538800536 [label="¿No parecía una prioridad?",shape=box,color=red];
		j1538800536 -> j1501572150;
	j2938410307 [label="Yo... simplemente no tuve tiempo de hacerlo antes.",shape=box,color=red];
		j2938410307 -> j1394988711;
	j2814467111 [label="No te acuerdas... pero ya hemos pasado por esto antes.",shape=box,color=red];
		j2814467111 -> j2222914336;
	j1775020736 [label="¡Ah! Eso es lo que eres, ¿verdad? Los tenno usurparon el Sistema Origen de los orokin. Y tú, como un pequeño impostor en el nido, te has colado en este mundo desde el tuyo.",shape=box,color=blue];
		j1775020736 -> j3809446381;
	j3275343182 [label="Y no hay motivo de preocupación ni de entusiasmo... todavía. Se trata simplemente de un acuerdo comercial entre dos personas que se beneficiarán mutuamente de manera significativa.",shape=box,color=blue];
		j3275343182 -> j1707057543;
	j4026548805 [label="Evaluate expressions on HellKeyPlayed counter",color=orange];
		j4026548805 -> j2746229773 [label="x >= 21",color=purple];
		j4026548805 -> j3980526836 [label="x >= 1",color=purple];
		j4026548805 -> j39327438 [label="x <= 0",color=purple];
		j4026548805 -> j39327438 [label="false",color=purple];
	j168243474 [label="Asegúrate de hacerlo.",shape=box,color=blue];
		j168243474 -> j1446781277;
	j1501572150 [label="No parecía...",shape=box,color=blue];
		j1501572150 -> j1187424949;
	j1394988711 [label="¡Oh! Siento muchísimo haberle causado molestias, ¡no me había dado cuenta de que los espacios en tu programa de baile ya estaban reservados!",shape=box,color=blue];
		j1394988711 -> j2021485462;
	j2222914336 [label="+5 Chemistry",color=orange];
		j2222914336 -> j3319504931;
	j3809446381 [label="Y eso te convierte, al menos por dos razones, en un usurpador a mi juicio. (Y quizás por una tercera, si contamos lo que el mayordomo me ha contado de Duviri, pero ese es un debate para otro momento).",shape=box,color=blue];
		j3809446381 -> j1707057543;
	j2746229773 [label="Lo has dejado repetidamente y con toda claridad, gracias.",shape=box,color=blue];
		j2746229773 -> j1446781277;
	j3980526836 [label="Lo has dejado bastante claro.",shape=box,color=blue];
		j3980526836 -> j1446781277;
	j39327438 [label="Ya veremos.",shape=box,color=blue];
		j39327438 -> j1446781277;
	j1446781277 [label="Ahora bien, el trato es sencillo, mi nuevo \"amigo\", encantadoramente resbaladizo y vaporoso.",shape=box,color=blue];
		j1446781277 -> j1071362491;
	j1187424949 [label="¡¿No parecía una prioridad?!",shape=box,color=blue];
		j1187424949 -> j2907802827;
	j2021485462 [label="De verdad. Estoy asombrado. Tus modales son absolutamente atroces, Viajero.",shape=box,color=blue];
		j2021485462 -> j3618745088;
	j3319504931 [label="¿Perdón? ¿Y cómo es que he llegado a olvidarte hurgando en mi mente como el cuenco de Malium en una fiesta de Naberus?",shape=box,color=blue];
		j3319504931 -> j2011889802;
		j3319504931 -> j3512662409;
	j1071362491 [label="Evaluate expressions on HellKeyPlayed counter",color=orange];
		j1071362491 -> j3686451666 [label="x >= 21",color=purple];
		j1071362491 -> j940879810 [label="x >= 1",color=purple];
		j1071362491 -> j2177138022 [label="x <= 0",color=purple];
		j1071362491 -> j2177138022 [label="false",color=purple];
	j2907802827 [label="¡¿Sueles dedicarte a hurgar en la memoria de otros, destrozando sus representaciones, sin siquiera aprovechar la oportunidad de conocerlos primero?!",shape=box,color=blue];
		j2907802827 -> j407000096;
	j3618745088 [label="Pero supongo que ya no hay nada que hacer al respecto. Sabes la verdad. Me expongo ante ti en toda mi aborrecible cobardía.",shape=box,color=blue];
		j3618745088 -> j2977705204;
	j2011889802 [label="En resumen, existe... la infestación que parece extenderse a los sueros Protoframe...",shape=box,color=red];
		j2011889802 -> j4055684053;
	j3512662409 [label="Ah. Bueno. Entonces... tengo la capacidad de poner en bucle el tiempo.",shape=box,color=red];
		j3512662409 -> j4055684053;
	j3686451666 [label="Puesto que llevas tiempo dando vueltas en mi cabeza como un razaliorn borracho en el taller de un vidriero, necesito tu ayuda para intentar descifrar qué significa todo esto.",shape=box,color=blue];
		j3686451666 -> j897979088;
	j940879810 [label="Tú y los dos fanáticos ya habéis empezado a trastear con mi mente como un razaliorn borracho en un taller de cristalería. Necesito tu ayuda para descifrar qué significa todo esto.",shape=box,color=blue];
		j940879810 -> j897979088;
	j2177138022 [label="Cuando Albrecht me clavó la jeringa en el cuello y me convirtió en esta... cosa, también hizo algo más. Los juegos entre los orokin son una cosa. ¿Esto? Esto es otra muy distinta.",shape=box,color=blue];
		j2177138022 -> j17881050;
	j407000096 [label="¡Tus modales son absolutamente atroces!",shape=box,color=blue];
		j407000096 -> j3618745088;
	j2977705204 [label="Supongo que has venido aquí simplemente para burlarte de mí. Te pido que termines ya para que podamos pasar a otro tema sin interrupciones.",shape=box,color=blue];
		j2977705204 -> j1235560255;
	j4055684053 [label="Y yo pensaba que funcionaba en los protoframes de 1999 debido al bucle del año, pero no es así. ",shape=box,color=red];
		j4055684053 -> j2709138367;
	j897979088 [label="No solo necesito tu ayuda para recuperar mis recuerdos, sino que, para colmo de males, ¡parece que ni siquiera puedo encontrar los medios para discernir la verdad de mis recuerdos por mí mismo!",shape=box,color=blue];
		j897979088 -> j1227994905;
		j897979088 -> j3826565430;
	j17881050 [label="Me robó gran parte de mis recuerdos. Veo esa pequeña... versión tuya, corriendo por ahí con todos tus amigos tenno traumatizados. Veo lo que Lotus le está ayudando a esa cosa recuperar.",shape=box,color=blue];
		j17881050 -> j2745995533;
		j17881050 -> j3732978915;
	j1235560255 [label="Preferiría no tener que lidiar continuamente con esto bajo mis pies como el kubrow ladrador criado ornamentalmente por alguna diva.",shape=box,color=blue];
		j1235560255 -> j696270811;
		j1235560255 -> j3262646843;
	j2709138367 [label="Creo que... tiene más que ver con la propia Infestación. Hay una guitarra parlante que daba a entender algo al respecto. Y viajaste hasta aquí en un Helminto, ¿verdad?",shape=box,color=red];
		j2709138367 -> j3712514680;
	j1227994905 [label="Entonces dices que... ¿solo necesitas hablar con alguien?",shape=box,color=red];
		j1227994905 -> j1475882129;
	j3826565430 [label="Con gusto te ayudaré si puedo, solo que no sé muy bien cómo.",shape=box,color=red];
		j3826565430 -> j3497113173;
	j2745995533 [label="Entonces... ¿por qué no entras tú solo en la Oscuridad Refractaria?",shape=box,color=red];
		j2745995533 -> j1841690863;
	j3732978915 [label="El chiqui no es una \"cosa\".",shape=box,color=red];
		j3732978915 -> j3967948495;
	j696270811 [label="Huiste. Pero mucha gente huye. Se trata de afrontar lo que pasó.",shape=box,color=red];
		j696270811 -> j2206066857;
	j3262646843 [label="No voy a burlarme de ti. Tú elegiste seguir luchando otro día.",shape=box,color=red];
		j3262646843 -> j776971673;
	j3712514680 [label="Pareces alarmantemente inseguro sobre toda esta conversación, Viajero. Especialmente en lo que respecta al contenido de mi cráneo.",shape=box,color=blue];
		j3712514680 -> j1220656384;
	j1475882129 [label="Oh, no hagas que esto suene como si simplemente necesitara tumbarme en un sofá reclinable y hablar a través de mis \"sentimientos\".",shape=box,color=blue];
		j1475882129 -> j3497113173;
	j3497113173 [label="Necesito que alguien opere la máquina a mi solicitud, ya que actualmente soy incapaz de hacerlo yo mismo. ",shape=box,color=blue];
		j3497113173 -> j3214306085;
	j1841690863 [label="Lo haría yo mismo, créeme, ¡pero no puedo! ¡El maldito suero de protoframe con el que me envenenó Albrecht me quitó toda capacidad de manejar por mi cuenta ese maldito aparato!",shape=box,color=blue];
		j1841690863 -> j385218439;
	j3967948495 [label="Te aseguro que el chiqui sí es una \"cosa\".",shape=box,color=blue];
		j3967948495 -> j2337110483;
	j2206066857 [label="Add 1 to Thermostat counter",color=orange];
		j2206066857 -> j4028193113;
	j776971673 [label="Add -1 to Thermostat counter",color=orange];
		j776971673 -> j2248288303;
	j1220656384 [label="Sí, llegué aquí a través de un Helminto. Uno que yo mismo críe y formé, gracias. Ahora bien, ¿me estás diciendo que has... borrado mis recuerdos? ¿De qué? ¿De nuestras conversaciones? ",shape=box,color=blue];
		j1220656384 -> j2873291786;
	j3214306085 [label="También necesito a alguien que me ayude a registrar mis recuerdos y a reconciliarlos. Una especie de asistente temporal.",shape=box,color=blue];
		j3214306085 -> j621645005;
	j385218439 [label="Y además, no solo necesito su ayuda para recuperar mis recuerdos, sino que, para colmo de males, ¡parece que ni siquiera puedo encontrar los medios para discernir su verdad por mí mismo!",shape=box,color=blue];
		j385218439 -> j1227994905;
		j385218439 -> j3826565430;
	j2337110483 [label="Y yo haría yo mismo, créeme, ¡pero no puedo! ¡El maldito suero de protoframe con el que me envenenó Albrecht me quitó toda capacidad de manejar por mi cuenta ese maldito aparato!",shape=box,color=blue];
		j2337110483 -> j385218439;
	j4028193113 [label="¡Fantástico! ¿Otra mosca molesta que revolotea alrededor de mis oídos para decirme que necesito reflexionar y arrepentirme?",shape=box,color=blue];
		j4028193113 -> j152974961;
	j2248288303 [label="+5 Chemistry",color=orange];
		j2248288303 -> j3073620569;
	j2873291786 [label="Porque, desde luego, guardo recuerdos muy \"agradables\" de cuando me convertiste en picadillo para tu propio y sangriento entretenimiento. ¿Qué sentido tiene eso?",shape=box,color=blue];
		j2873291786 -> j2274107705;
		j2873291786 -> j1907698911;
	j621645005 [label="Y a cambio, te prometo solemnemente que me sentaré aquí... en paz. No representaré ninguna amenaza para nadie, de lo cual les aseguro que soy perfectamente capaz. No haré daño a los fanáticos. Ni al mayordomo. Ni a los animales corrompidos por el Vacío de Albrecht.",shape=box,color=blue];
		j621645005 -> j123841778;
	j152974961 [label="Qué suerte tengo.",shape=box,color=blue];
		j152974961 -> j3145430642;
	j3073620569 [label="Actualmente, lo que hago parece ser \"pudrirme en una cripta con un par de fanáticos imbéciles y repartir baratijas a niños traumatizados por la guerra\".",shape=box,color=blue];
		j3073620569 -> j1938313359;
	j2274107705 [label="No lo sé, y la verdad es que no estoy aquí para seguir aguantando tus insultos, Roathe. No hice el bucle a todo el mundo solo para que me critiques por ello.",shape=box,color=red];
		j2274107705 -> j4200888978;
	j1907698911 [label="Por lo que puedo deducir, nuestras conversaciones no son profundas. Son recuerdos superficiales. Lo que descubrimos de tu pasado... supongo que formaba parte de tus recuerdos más íntimos.",shape=box,color=red];
		j1907698911 -> j3371436556;
	j123841778 [label="Y lo que es más importante, no haré daño a la retorcida familia de Albrecht, que se sienta a nuestro alrededor como una flora mutada, sin saberlo, a pesar de nuestra presencia.",shape=box,color=blue];
		j123841778 -> j677738423;
		j123841778 -> j2144830649;
		j123841778 -> j1980606546;
	j3145430642 [label="Pienso seguir con mis asuntos, Viajero, pero lo cierto es que sabes demasiado sobre mi pasado y lo que he hecho. Y tendremos que... simplemente aceptar esta situación.",shape=box,color=blue];
		j3145430642 -> j2576663735;
	j1938313359 [label="Pero supongo que así es como lo llaman ahora.",shape=box,color=blue];
		j1938313359 -> j3145430642;
	j4200888978 [label="Sí. Podría aventurar una suposición sobre por qué has invocado tus dones del Vacío para borrar de nuestra memoria los acontecimientos recientes. Qué predecible.",shape=box,color=blue];
		j4200888978 -> j3258588258;
	j3371436556 [label="Fantástico. Absolutamente maravilloso. ¡Ahora estoy en manos de un lunático que tiene la capacidad de borrarme la memoria a su antojo! Qué adorable.",shape=box,color=blue];
		j3371436556 -> j3258588258;
	j677738423 [label="Creía que esto era un trato. ¿Ahora me estás amenazando?",shape=box,color=red];
		j677738423 -> j3569078399;
	j2144830649 [label="¿Roathe? Por favor, detente y escúchame un segundo.",shape=box,color=red];
		j2144830649 -> j2529230274;
	j1980606546 [label="¿Qué necesitas que haga?",shape=box,color=red];
		j1980606546 -> j4132143341;
	j2576663735 [label="Intenta no hacerme sentir demasiado incómodo y te prometo que intentaré hacer lo mismo a cambio.",shape=box,color=blue];
		j2576663735 -> j1399979968;
		j2576663735 -> j2220804340;
	j3258588258 [label="Bueno. Si lo que dices es cierto... y supongo que esta historia es lo suficientemente descabellada como para ser real... intentaré no reprochártelo por conocer esta profunda y terrible verdad sobre mí.",shape=box,color=blue];
		j3258588258 -> j1673688135;
	j3569078399 [label="¿No estabas prestando atención? Vaya, la comprensión lectora hoy en día... No te estaba amenazando, Usurpador. Ni a nadie más.",shape=box,color=blue];
		j3569078399 -> j1925576329;
	j2529230274 [label="Esto promete ser grandioso. Por favor, adelante; el escenario es tuyo.",shape=box,color=blue];
		j2529230274 -> j2919291428;
		j2529230274 -> j2396124196;
		j2529230274 -> j650036703;
	j4132143341 [label="¿No estabas prestando atención? Vaya, la comprensión lectora hoy en día... Intento llegar a un acuerdo contigo, Usurpador. Me cuesta creer que no puedas seguirme.",shape=box,color=blue];
		j4132143341 -> j3885341762;
	j1399979968 [label="No.",shape=box,color=red];
		j1399979968 -> j2436404839;
	j2220804340 [label="Creo que es justo.",shape=box,color=red];
		j2220804340 -> j3537151980;
	j1673688135 [label="Aunque te pediría, si me lo permites, que se harten de burlarse de mí para que podamos pasar página sin interrupciones.",shape=box,color=blue];
		j1673688135 -> j1235560255;
	j1925576329 [label="Simplemente estaba afirmando que, si llegamos a un punto en el que no pueda alcanzar mis objetivos finales, quizá ya no tenga motivos para permanecer en silencio.",shape=box,color=blue];
		j1925576329 -> j3885341762;
	j2919291428 [label="Yo soy la razón por la que Ballas está muerto. No me obligues a despejar mi agenda.",shape=box,color=red];
		j2919291428 -> j1499579876;
	j2396124196 [label="Si quieres mi ayuda, esta no es la mejor manera de conseguirla.",shape=box,color=red];
		j2396124196 -> j1946205979;
	j650036703 [label="Sé que tú y yo no tenemos mucha experiencia juntos, la verdad. Pero estoy aquí para ayudarte.",shape=box,color=red];
		j650036703 -> j2502881243;
	j3885341762 [label="Si mi propuesta no cumple con sus expectativas, ¿debería mejorarla?",shape=box,color=blue];
		j3885341762 -> j363021567;
	j2436404839 [label="+5 Chemistry",color=orange];
		j2436404839 -> j3580145700;
	j3537151980 [label="+15 Chemistry",color=orange];
		j3537151980 -> j1397972701;
	j1499579876 [label="+5 Chemistry",color=orange];
		j1499579876 -> j3447680424;
	j1946205979 [label="Y si quieres el mío, entonces sugiero... como ya dije... que lleguemos a un acuerdo.",shape=box,color=blue];
		j1946205979 -> j3885341762;
	j2502881243 [label="¿Y? Ah, ya veo. ¿Te molesta mi \"tono\"? Lo siento muchísimo. No sabía que te ofendías con tanta facilidad.",shape=box,color=blue];
		j2502881243 -> j3885341762;
	j363021567 [label="Me he percatado de que existen muchos asuntos relacionados con Deimos en los que mi ayuda podría considerarse no solo viable, sino, me atrevo a decir, crucial.",shape=box,color=blue];
		j363021567 -> j2767984217;
	j3580145700 [label="¡Ja! Al menos tengo que respetar tu honestidad.",shape=box,color=blue];
		j3580145700 -> j640215234;
	j1397972701 [label="Maravilloso. Es bueno saber que al menos... puedes ceder.",shape=box,color=blue];
		j1397972701 -> j640215234;
	j3447680424 [label="¡Si hubieras podido oírme reír! Gracias Viajero, ¡por no ser nada pesado!",shape=box,color=blue];
		j3447680424 -> j485346031;
	j2767984217 [label="Incluyendo, pero no limitándose a, la reconciliación de un mayordomo enamorado y dicha familia distanciada que vive en el piso de arriba.",shape=box,color=blue];
		j2767984217 -> j3490496344;
	j640215234 [label="Boolean RoatheKnowsReset is now true.",color=orange];
		j640215234 -> j2126893709;
	j485346031 [label="Add -1 to Thermostat counter",color=orange];
		j485346031 -> j673808921;
	j3490496344 [label="Una familia que, como ya he dicho, no tiene ni idea de que estamos aquí abajo. Y que ignora que Albrecht sigue vivo, ¿verdad?",shape=box,color=blue];
		j3490496344 -> j2938950010;
		j3490496344 -> j1506883648;
		j3490496344 -> j1761933953;
	j2126893709 [label="Al menos esto será interesante.",shape=box,color=blue];
		j2126893709 -> "Chat ends.";
	j673808921 [label="¡Qué delicia! Creo que sin duda seremos amigos. Fue maravilloso.",shape=box,color=blue];
