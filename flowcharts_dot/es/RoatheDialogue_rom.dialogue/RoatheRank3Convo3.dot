	1791 [label="No parecen nada agradables. ",shape=box,color=red];
		1791 -> 1798;
	1792 [label="No parecen nada agradables. ¿Seguro que debemos continuar?",shape=box,color=red];
		1792 -> 1799;
	1790 [label="[Fin]",shape=box,color=red];
		1790 -> 1797;
	1789 [label="Honestamente, he tenido algunas dificultades... Sigo muriendo sin importar cuánto lo intente.",shape=box,color=red];
		1789 -> 1796;
	1787 [label="Yo no recibo órdenes tuyas, Roathe.",shape=box,color=red];
		1787 -> 1794;
	1788 [label="He tenido cosas que hacer. Me encargaré de ello.",shape=box,color=red];
		1788 -> 1795;
	1801 [label="No sólo te he perdonado por haberme quitado esos recuerdos...",shape=box,color=blue];
		1801 -> 1807;
	1800 [label="No sólo estoy empezando a perdonarte por haberme quitado esos recuerdos...",shape=box,color=blue];
		1800 -> 1807;
	1798 [label="No. No lo son. ¿Qué esperabas del \"Diablo de Tau\", recuerdos de una tarde soleada en el parque, recostado sobre una manta y comiendo uvas en una bandeja?",shape=box,color=blue];
		1798 -> 1805;
	1799 [label="No sabré qué me arrebató hasta que lo recupere todo. ¡Claro que debemos seguir! Esos recuerdos son míos, Viajero. Forman quién soy, quién era. Son la esencia misma de mi ser.",shape=box,color=blue];
		1799 -> 1806;
	1797 [label="Chat ends.",color=orange];
	1796 [label="Update boolean RoatheStrugglebus",color=orange];
		1796 -> 1804;
	1794 [label="No, claro que no. Y lo que hagas con tu día no es asunto mío. Sólo digo que si quieres que ese mayordomo flacucho suba esas escaleras, tienes trabajo que hacer.",shape=box,color=blue];
		1794 -> 1802;
	1795 [label="Asegúrate de hacerlo. No me importa lo que hagas con tu día. Sólo digo que si quieres que ese mayordomo flacucho suba esas escaleras, tienes trabajo que hacer.",shape=box,color=blue];
		1795 -> 1803;
	1807 [label="Pero empiezo a desear volver a confiar en ti. ¡Otra vez! Sabiendo perfectamente lo que has hecho. ¡Sabiendo que podrías traicionarme una vez más!",shape=box,color=blue];
		1807 -> 1815;
	1805 [label="Pobre Usurpador mío, temo que lo que encontraremos enterrado en los anales de mi mente no será más que sangre, vísceras y fracaso.",shape=box,color=blue];
		1805 -> 1811;
		1805 -> 1812;
	1806 [label="Por lo que he podido saber de los demás respecto a tu estancia en Duviri, tú también sufriste un destino similar, ¿no es así?",shape=box,color=blue];
		1806 -> 1813;
		1806 -> 1814;
	1804 [label="Sólo escucho historias de ti venciendo a Narmer. Derrotando hordas de soldados grineer. Derrotando oleadas de murmullos a cada paso. ¿Y aun así he logrado confundirte?",shape=box,color=blue];
		1804 -> 1810;
	1802 [label="Si a ti no te importa, a mí tampoco. Tengo mis propios asuntos que atender.",shape=box,color=blue];
		1802 -> 1808;
	1803 [label="Si a ti no te importa, a mí tampoco. Tengo mis propios asuntos que atender.",shape=box,color=blue];
		1803 -> 1809;
	1815 [label="But I find myself sitting in that crypt and I stand from that chair and I think to myself \"I wonder if Drifter is about and if they wish to speak.\"",shape=box,color=blue];
		1815 -> 1822;
	1811 [label="Tú pilotas esta nave. Si quieres seguir navegando hacia el agujero negro, ve a toda velocidad.",shape=box,color=red];
		1811 -> 1818;
	1812 [label="Entonces, ¿seguro que deseas continuar?",shape=box,color=red];
		1812 -> 1819;
	1813 [label="Somos personas muy diferentes, Roathe.",shape=box,color=red];
		1813 -> 1820;
	1814 [label="Lo era. Recuerdo y apatía. Todavía no puedo recordar... fragmentos enteros de tiempo.",shape=box,color=red];
		1814 -> 1821;
	1810 [label="+20 Chemistry",color=orange];
		1810 -> 1817;
	1808 [label="Chat ends.",color=orange];
	1809 [label="+10 Chemistry",color=orange];
		1809 -> 1816;
	1822 [label="How utterly pathetic is that? How low have I been brought? Me?! An Orokin?! Roathe! The Devil of Tau! So restless, so intellectually starved, so desperate for any kind of stimulation that I am here, speaking with you!",shape=box,color=blue];
		1822 -> 1831;
		1822 -> 1830;
		1822 -> 1829;
		1822 -> 1828;
	1818 [label="+10 Chemistry",color=orange];
		1818 -> 1824;
	1819 [label="I will not know what he took from me until I have it all back. Of course we should keep going! Those memories are mine, Drifter. They make up who I am, who I was. They are they very fabric of my being.",shape=box,color=blue];
		1819 -> 1825;
		1819 -> 1826;
	1820 [label="That may be, but it was hardly the point I was making. Which you are avoiding having to concede. Very well. If, in theory, you had lost memories - would you seek to regain them if you could?",shape=box,color=blue];
		1820 -> 1825;
		1820 -> 1826;
	1821 [label="If you had the opportunity to regain your lost memories, would you?",shape=box,color=blue];
		1821 -> 1827;
		1821 -> 1825;
		1821 -> 1826;
	1817 [label="Assuming that you are not lying to me? I admit that is rather flattering. Adorable. Extremly sad. But flattering.",shape=box,color=blue];
		1817 -> 1823;
	1816 [label="Chat ends.",color=orange];
	1831 [label="I look forward to our conversations, whether you do or not.",shape=box,color=red];
		1831 -> 1838;
	1830 [label="I'll try not to take that personally.",shape=box,color=red];
		1830 -> 1837;
	1829 [label="Or, you just enjoy talking to me?",shape=box,color=red];
		1829 -> 1836;
	1828 [label="[Fin]",shape=box,color=red];
		1828 -> 1835;
	1824 [label="Well said, Drifter. I will not know the magnitude of what was taken from me until I have it all back. Those memories make up who I am, who I was. They are they very fabric of my being.",shape=box,color=blue];
		1824 -> 1827;
		1824 -> 1825;
		1824 -> 1826;
	1825 [label="I think it's better to know than to not know, but... we have to be prepared for it.",shape=box,color=red];
		1825 -> 1832;
	1826 [label="Sometimes I think things should stay buried for a reason.",shape=box,color=red];
		1826 -> 1833;
	1827 [label="It's yours. It's time for us to go get it. How bad could it be? You're an Orokin, you've done worse things, certainly.",shape=box,color=red];
		1827 -> 1834;
	1823 [label="Chat ends.",color=orange];
	1838 [label="Then I am so terribly glad I was not rendered unto a drooling idiot when you muddled about in my skull with a fork.",shape=box,color=blue];
		1838 -> 1842;
	1837 [label="Perhaps you should. You were the one who muddled about in my skull with a fork, after all.",shape=box,color=blue];
		1837 -> 1842;
	1836 [label="Perhaps I would, if I did not know you had muddled about in my skull with a fork.",shape=box,color=blue];
		1836 -> 1842;
	1835 [label="Chat ends.",color=orange];
	1832 [label="Prepared, precisely, how? Do you believe I will collapse like some feeble house of cards once I learn the terrible truth of some grotesque war crime?",shape=box,color=blue];
		1832 -> 1839;
	1833 [label="Are we not then doomed to repeat our previous mistakes? Never learning, never evolving, forever living in blissful ignorance of our former selves?",shape=box,color=blue];
		1833 -> 1840;
	1834 [label="+10 Chemistry",color=orange];
		1834 -> 1841;
	1842 [label="Check boolean RoatheResetForgiven",color=orange];
		1842 -> 1846 [label=true,color=green];
		1842 -> 1847 [label=false,color=brown];
	1839 [label="Believe me, I can imagine every possible thing I could have done to the Sentients, Orokin, or any combination thereof and there is little that would render me shocked or horrified.",shape=box,color=blue];
		1839 -> 1843;
	1840 [label="Hm. I may have just made a case against my own argument for most people, I realize.",shape=box,color=blue];
		1840 -> 1844;
	1841 [label="Hear, hear! I will hardly collapse like some feeble house of cards once I learn the terrible truth of some grotesque war crime.",shape=box,color=blue];
		1841 -> 1845;
	1846 [label="I said I forgave you. And I am attempting to adhere to that which I promised you. It is simply that words do not sometimes make a thing true. And saying one forgives someone is very nice in theory but sometimes emotions have a hard time following fact.",shape=box,color=blue];
		1846 -> 1851;
		1846 -> 1852;
	1847 [label="Really, this is all quite irritating. I want to converse with you. But I also want to throttle you for having befouled my mind.",shape=box,color=blue];
		1847 -> 1853;
		1847 -> 1854;
	1843 [label="Add 1 to Thermostat",color=orange];
		1843 -> 1848;
	1844 [label="Add -1 to Thermostat",color=orange];
		1844 -> 1849;
	1845 [label="Add -2 to Thermostat",color=orange];
		1845 -> 1850;
	1851 [label="I understand. It's a hard thing to accept, and you might want to, but can't.",shape=box,color=red];
		1851 -> 1857;
	1852 [label="So you... don't forgive me?",shape=box,color=red];
		1852 -> 1857;
	1853 [label="You're going to just have to accept what happened and move on, Roathe.",shape=box,color=red];
		1853 -> 1858;
	1854 [label="Do you think you can ever forgive me?",shape=box,color=red];
		1854 -> 1859;
	1848 [label="I can remember enough to know that I could ask for \"forgiveness\" at the altar of the Luminaries for the next two thousand years and have it never granted. ",shape=box,color=blue];
		1848 -> 1855;
	1849 [label="I would prefer to learn all the facts myself and judge the situation from there.",shape=box,color=blue];
		1849 -> 1855;
	1850 [label="I can imagine every possible thing I could have done to the Sentients, Orokin, or any combination thereof and there is little that would render me shocked or horrified.",shape=box,color=blue];
		1850 -> 1856;
	1857 [label="I am trying my damnable and level best, Usurper. For there is something about you that has captured my attention. You are fascinating. And that is a rare thing in my world.",shape=box,color=blue];
		1857 -> 1862;
	1858 [label="Mmhm.",shape=box,color=blue];
		1858 -> 1863;
	1859 [label="Update boolean RoatheResetForgiven",color=orange];
		1859 -> 1857;
	1855 [label="No, what is waiting for me at the bottom of my mind does not scare me. I merely wish to reclaim that which was wrongfully taken from me.",shape=box,color=blue];
		1855 -> 1860;
	1856 [label="No, what is waiting for me at the bottom of my mind does not scare me. I merely wish to reclaim that which was wrongfully taken from me.",shape=box,color=blue];
		1856 -> 1861;
	1862 [label="So be patient with me, if you can, while I try to reconcile all this.",shape=box,color=blue];
		1862 -> 1866;
		1862 -> 1867;
	1863 [label="Chat ends.",color=orange];
	1860 [label="+10 Chemistry",color=orange];
		1860 -> 1864;
	1861 [label="As you said. It is time for us to retake that which is mine.",shape=box,color=blue];
		1861 -> 1865;
	1866 [label="I will.",shape=box,color=red];
		1866 -> 1869;
	1867 [label="I'm the one who should be asking for patience from you, Roathe. Not the other way around.",shape=box,color=red];
		1867 -> 1870;
	1864 [label="But I appreciate the concern, nonetheless.",shape=box,color=blue];
		1864 -> 1868;
	1865 [label="Chat ends.",color=orange];
	1869 [label="How kind of you.",shape=box,color=blue];
