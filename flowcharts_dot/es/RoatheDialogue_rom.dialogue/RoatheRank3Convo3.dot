		j1787026705 -> j2308043178 [label=false,color=brown];
	j2665862667 [label="No parecen nada agradables. ",shape=box,color=red];
		j2665862667 -> j487060481;
	j3782580649 [label="No parecen nada agradables. ¿Seguro que debemos continuar?",shape=box,color=red];
		j3782580649 -> j2521337271;
	j202800200 [label="[Fin]",shape=box,color=red];
		j202800200 -> "Chat ends.";
	j2136058832 [label="Honestamente, he tenido algunas dificultades... Sigo muriendo sin importar cuánto lo intente.",shape=box,color=red];
		j2136058832 -> j938372166;
	j3623176044 [label="Yo no recibo órdenes tuyas, Roathe.",shape=box,color=red];
		j3623176044 -> j3768038051;
	j4000301541 [label="He tenido cosas que hacer. Me encargaré de ello.",shape=box,color=red];
		j4000301541 -> j874429209;
	j3815441841 [label="No sólo te he perdonado por haberme quitado esos recuerdos...",shape=box,color=blue];
		j3815441841 -> j1181298240;
	j2308043178 [label="No sólo estoy empezando a perdonarte por haberme quitado esos recuerdos...",shape=box,color=blue];
		j2308043178 -> j1181298240;
	j487060481 [label="No. No lo son. ¿Qué esperabas del \"Diablo de Tau\", recuerdos de una tarde soleada en el parque, recostado sobre una manta y comiendo uvas en una bandeja?",shape=box,color=blue];
		j487060481 -> j2223122846;
	j2521337271 [label="No sabré qué me arrebató hasta que lo recupere todo. ¡Claro que debemos seguir! Esos recuerdos son míos, Viajero. Forman quién soy, quién era. Son la esencia misma de mi ser.",shape=box,color=blue];
		j2521337271 -> j3286946455;
	"Chat ends." [color=orange];
	j938372166 [label="Boolean RoatheStrugglebus is now true.",color=orange];
		j938372166 -> j1050961777;
	j3768038051 [label="No, claro que no. Y lo que hagas con tu día no es asunto mío. Sólo digo que si quieres que ese mayordomo flacucho suba esas escaleras, tienes trabajo que hacer.",shape=box,color=blue];
		j3768038051 -> j2323512884;
	j874429209 [label="Asegúrate de hacerlo. No me importa lo que hagas con tu día. Sólo digo que si quieres que ese mayordomo flacucho suba esas escaleras, tienes trabajo que hacer.",shape=box,color=blue];
		j874429209 -> j332316378;
	j1181298240 [label="Pero empiezo a desear volver a confiar en ti. ¡Otra vez! Sabiendo perfectamente lo que has hecho. ¡Sabiendo que podrías traicionarme una vez más!",shape=box,color=blue];
		j1181298240 -> j3529758160;
	j2223122846 [label="Pobre Usurpador mío, temo que lo que encontraremos enterrado en los anales de mi mente no será más que sangre, vísceras y fracaso.",shape=box,color=blue];
		j2223122846 -> j1491681261;
		j2223122846 -> j2110469127;
	j3286946455 [label="Por lo que he podido saber de los demás respecto a tu estancia en Duviri, tú también sufriste un destino similar, ¿no es así?",shape=box,color=blue];
		j3286946455 -> j909864806;
		j3286946455 -> j3886126381;
	j1050961777 [label="Sólo escucho historias de ti venciendo a Narmer. Derrotando hordas de soldados grineer. Derrotando oleadas de murmullos a cada paso. ¿Y aun así he logrado confundirte?",shape=box,color=blue];
		j1050961777 -> j3701033689;
	j2323512884 [label="Si a ti no te importa, a mí tampoco. Tengo mis propios asuntos que atender.",shape=box,color=blue];
		j2323512884 -> "Chat ends.";
	j332316378 [label="Si a ti no te importa, a mí tampoco. Tengo mis propios asuntos que atender.",shape=box,color=blue];
		j332316378 -> j1933300832;
	j3529758160 [label="Pero me encuentro sentado en esa cripta y me levanto de la silla y pienso: \"¿estará por aquí el Viajero y querrá platicar?\"",shape=box,color=blue];
		j3529758160 -> j2793709630;
	j1491681261 [label="Tú pilotas esta nave. Si quieres seguir navegando hacia el agujero negro, ve a toda velocidad.",shape=box,color=red];
		j1491681261 -> j1741772967;
	j2110469127 [label="Entonces, ¿seguro que deseas continuar?",shape=box,color=red];
		j2110469127 -> j3895175528;
	j909864806 [label="Somos personas muy diferentes, Roathe.",shape=box,color=red];
		j909864806 -> j3820275204;
	j3886126381 [label="Lo era. Recuerdo y apatía. Todavía no puedo recordar... fragmentos enteros de tiempo.",shape=box,color=red];
		j3886126381 -> j4196085599;
	j3701033689 [label="+20 Chemistry",color=orange];
		j3701033689 -> j259295681;
	j1933300832 [label="+10 Chemistry",color=orange];
		j1933300832 -> "Chat ends.";
	j2793709630 [label="¡Qué patético! ¿Hasta dónde he llegado? ¡¿Yo?! ¡¿Un orokin?! ¡Roathe! ¡El Diablo de Tau! ¡Heme aquí, hablando contigo, inquieto, hambriento de conocimiento, desesperado por cualquier tipo de estímulo!",shape=box,color=blue];
		j2793709630 -> j3297679287;
		j2793709630 -> j3743907054;
		j2793709630 -> j2408045455;
		j2793709630 -> j202800200;
	j1741772967 [label="+10 Chemistry",color=orange];
		j1741772967 -> j4035653680;
	j3895175528 [label="No sabré qué me arrebató hasta que lo recupere todo. ¡Claro que debemos seguir! Esos recuerdos son míos, Viajero. Forman quién soy, quién era. Son la esencia misma de mi ser.",shape=box,color=blue];
		j3895175528 -> j2575710894;
		j3895175528 -> j830782205;
	j3820275204 [label="Puede ser, pero ese no era el punto que quería plantear, mismo que estás evitando admitir. Muy bien. Si, en teoría, hubieras perdido la memoria, ¿intentarías recuperarla si pudieras?",shape=box,color=blue];
		j3820275204 -> j2575710894;
		j3820275204 -> j830782205;
	j4196085599 [label="Si tuvieras la oportunidad de recuperar tus recuerdos perdidos, ¿lo harías?",shape=box,color=blue];
		j4196085599 -> j2066556694;
		j4196085599 -> j2575710894;
		j4196085599 -> j830782205;
	j259295681 [label="Suponiendo que no me mientes, admito que es bastante halagador. Adorable. Extremadamente triste, pero halagador.",shape=box,color=blue];
		j259295681 -> "Chat ends.";
	j3297679287 [label="No sé si te pasa lo mismo, pero yo espero con ansias nuestras conversaciones.",shape=box,color=red];
		j3297679287 -> j2911521148;
	j3743907054 [label="Intentaré no tomarlo como algo personal.",shape=box,color=red];
		j3743907054 -> j293261180;
	j2408045455 [label="¿O simplemente disfrutas hablar conmigo?",shape=box,color=red];
		j2408045455 -> j1178691001;
	j4035653680 [label="Bien dicho, Viajero. No sabré la magnitud de lo que me arrebataron hasta que lo recupere todo. Esos recuerdos conforman quién soy, quién era. Son la esencia misma de mi ser.",shape=box,color=blue];
		j4035653680 -> j2066556694;
		j4035653680 -> j2575710894;
		j4035653680 -> j830782205;
	j2575710894 [label="Creo que es mejor saber que no saber, pero... debemos estar preparados.",shape=box,color=red];
		j2575710894 -> j2616274497;
	j830782205 [label="A veces pienso que las cosas deberían permanecer enterradas por alguna razón.",shape=box,color=red];
		j830782205 -> j129002970;
	j2066556694 [label="Es tuyo. Es hora de que vayamos a buscarlo. ¿Qué tan malo puede ser? Eres un orokin, has hecho cosas peores, sin duda.",shape=box,color=red];
		j2066556694 -> j1691950574;
	j2911521148 [label="Entonces me alegro muchísimo de no haberme convertido en un idiota babeante cuando te metiste en mi cráneo con un tenedor.",shape=box,color=blue];
		j2911521148 -> j3284677091;
	j293261180 [label="Quizás deberías. Después de todo, fuiste tú quien me revolvió el cerebro con un tenedor.",shape=box,color=blue];
		j293261180 -> j3284677091;
	j1178691001 [label="Tal vez lo haría si no supiera que has estado jugando con un tenedor en mi cráneo.",shape=box,color=blue];
		j1178691001 -> j3284677091;
	j2616274497 [label="¿Preparado, precisamente, cómo? ¿Crees que me derrumbaré como un castillo de naipes endeble cuando descubra la terrible verdad de algún grotesco crimen de guerra?",shape=box,color=blue];
		j2616274497 -> j2724163101;
	j129002970 [label="¿No estamos entonces condenados a repetir nuestros errores anteriores? ¿Sin aprender nunca, sin evolucionar jamás, viviendo eternamente en la dichosa ignorancia de nuestro pasado?",shape=box,color=blue];
		j129002970 -> j621659488;
	j1691950574 [label="+10 Chemistry",color=orange];
		j1691950574 -> j3049638296;
	j3284677091 [label="Check boolean RoatheResetForgiven",color=orange];
		j3284677091 -> j1527632535 [label=true,color=green];
		j3284677091 -> j492887550 [label=false,color=brown];
	j2724163101 [label="Créeme, puedo imaginar todo lo que podría haberle hecho a los conscientes, a los orokin o a cualquier combinación de ellos y hay poco que me dejaría horrorizado o en shock.",shape=box,color=blue];
		j2724163101 -> j47969571;
	j621659488 [label="Hm. Me doy cuenta de que quizá acabo de presentar un caso en contra de mi propio argumento para la mayoría de las personas.",shape=box,color=blue];
		j621659488 -> j1879974062;
	j3049638296 [label="¡Exacto! Es poco probable que me derrumbe como un castillo de naipes al descubrir la terrible verdad sobre algún grotesco crimen de guerra.",shape=box,color=blue];
		j3049638296 -> j2188073821;
	j1527632535 [label="Dije que te perdoné. Y estoy intentando cumplir lo que te prometí. Es que a veces las palabras no hacen que algo sea cierto. Decir que uno perdona a alguien es muy bonito en teoría, pero a veces las emociones no siguen los hechos.",shape=box,color=blue];
		j1527632535 -> j3874776866;
		j1527632535 -> j1262455899;
	j492887550 [label="De verdad, todo esto es bastante irritante. Quiero conversar contigo. Pero también quiero estrangularte por haberme ensuciado la mente.",shape=box,color=blue];
		j492887550 -> j2962846410;
		j492887550 -> j3677030389;
	j47969571 [label="Add 1 to Thermostat counter",color=orange];
		j47969571 -> j2626794437;
	j1879974062 [label="Add -1 to Thermostat counter",color=orange];
		j1879974062 -> j2790426425;
	j2188073821 [label="Add -2 to Thermostat counter",color=orange];
		j2188073821 -> j3585589889;
	j3874776866 [label="Lo entiendo. Es difícil aceptarlo, y quizá quieras, pero no puedes.",shape=box,color=red];
		j3874776866 -> j382723367;
	j1262455899 [label="Entonces... ¿no me perdonas?",shape=box,color=red];
		j1262455899 -> j382723367;
	j2962846410 [label="Vas a tener que aceptar lo que pasó y seguir adelante, Roathe.",shape=box,color=red];
		j2962846410 -> j1671606992;
	j3677030389 [label="¿Crees que algún día podrás perdonarme?",shape=box,color=red];
		j3677030389 -> j2233190179;
	j2626794437 [label="Puedo recordar lo suficiente para saber que podría pedir \"perdón\" en el altar de las Luminarias durante los próximos dos mil años y nunca me lo concederían. ",shape=box,color=blue];
		j2626794437 -> j4162910914;
	j2790426425 [label="Preferiría conocer todos los hechos por mí mismo y juzgar la situación desde allí.",shape=box,color=blue];
		j2790426425 -> j4162910914;
	j3585589889 [label="Puedo imaginar todo lo que podría haberle hecho a los conscientes, a los orokin o a cualquier combinación de ellos y hay poco que me dejaría horrorizado o en shock.",shape=box,color=blue];
		j3585589889 -> j2121719938;
	j382723367 [label="Estoy haciendo mi mejor esfuerzo, Usurpador. Porque hay algo en ti que ha captado mi atención. Eres fascinante. Y eso es algo raro en mi mundo.",shape=box,color=blue];
		j382723367 -> j2961874808;
	j1671606992 [label="Mmhm.",shape=box,color=blue];
		j1671606992 -> "Chat ends.";
	j2233190179 [label="Boolean RoatheResetForgiven is now true.",color=orange];
		j2233190179 -> j382723367;
	j4162910914 [label="No, lo que me espera en el fondo de mi mente no me asusta. Sólo deseo recuperar lo que me arrebataron injustamente.",shape=box,color=blue];
		j4162910914 -> j4271735995;
	j2121719938 [label="No, lo que me espera en el fondo de mi mente no me asusta. Sólo deseo recuperar lo que me arrebataron injustamente.",shape=box,color=blue];
		j2121719938 -> j3363853983;
	j2961874808 [label="Así que ten paciencia conmigo, si puedes, mientras trato de reconciliar todo esto.",shape=box,color=blue];
		j2961874808 -> j1341857572;
		j2961874808 -> j4162807349;
	j4271735995 [label="+10 Chemistry",color=orange];
		j4271735995 -> j311982880;
	j3363853983 [label="Como dijiste, es hora de que recuperemos lo que es mío.",shape=box,color=blue];
		j3363853983 -> "Chat ends.";
	j1341857572 [label="Lo haré.",shape=box,color=red];
		j1341857572 -> j1384035844;
	j4162807349 [label="Soy yo quien debería pedirte paciencia, Roathe. No al revés.",shape=box,color=red];
		j4162807349 -> j2082622910;
	j311982880 [label="Pero de todos modos aprecio la preocupación.",shape=box,color=blue];
