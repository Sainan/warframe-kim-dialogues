digraph {
	"RoatheRank3Convo3 begins." [color=orange];
		"RoatheRank3Convo3 begins." -> j3791167673;
	j3791167673 [label="Evaluate expressions on HellStory counter",color=orange];
		j3791167673 -> j250505479 [label="x >= 21",color=purple];
		j3791167673 -> j2572941901 [label="x >= 13",color=purple];
		j3791167673 -> j3917908585 [label="x < 13 && x > 1",color=purple];
		j3791167673 -> j805971215 [label="x == 0",color=purple];
		j3791167673 -> j805971215 [label="false",color=purple];
	j250505479 [label="Me atormenta día y noche. Esta persistente sensación de que no sólo te confié mis secretos más profundos, sino que traicionaste esa confianza y me lo quitaste todo, y ahora ni siquiera recuerdo por qué...",shape=box,color=blue];
		j250505479 -> j1787026705;
	j2572941901 [label="Estamos avanzando a buen ritmo para eliminar estos bloqueos de mi mente. Albrecht me dejó fatal al inyectarme ese suero.",shape=box,color=blue];
		j2572941901 -> j2665862667;
		j2572941901 -> j3782580649;
		j2572941901 -> j202800200;
	j3917908585 [label="Tu progreso para ayudarme a recuperar la memoria es insuficiente. Si deseas cumplir tu promesa, espero que continúes tu trabajo en Descendia.",shape=box,color=blue];
		j3917908585 -> j1549948188;
		j3917908585 -> j3623176044;
		j3917908585 -> j4000301541;
		j3917908585 -> j202800200;
	j805971215 [label="No has avanzado en Descendia para desenterrar mis recuerdos. Si quieres que cumpla mi promesa, tendrás que esforzarte por cumplir la tuya.",shape=box,color=blue];
		j805971215 -> j3623176044;
		j805971215 -> j4000301541;
		j805971215 -> j1549948188;
		j805971215 -> j202800200;
	j1787026705 [label="Check boolean RoatheResetForgiven",color=orange];
		j1787026705 -> j2913989719 [label=true,color=green];
		j1787026705 -> j551638376 [label=false,color=brown];
	j2665862667 [label="No parecen nada agradables. ",shape=box,color=red];
		j2665862667 -> j487060481;
	j3782580649 [label="No parecen nada agradables. ¿Seguro que debemos continuar?",shape=box,color=red];
		j3782580649 -> j2521337271;
	j202800200 [label="[Fin]",shape=box,color=red];
		j202800200 -> "Chat ends.";
	j1549948188 [label="Honestamente, he tenido algunas dificultades... Sigo muriendo sin importar cuánto lo intente.",shape=box,color=red];
		j1549948188 -> j3936490328;
	j3623176044 [label="Yo no recibo órdenes tuyas, Roathe.",shape=box,color=red];
		j3623176044 -> j3768038051;
	j4000301541 [label="He tenido cosas que hacer. Me encargaré de ello.",shape=box,color=red];
		j4000301541 -> j874429209;
	j2913989719 [label="No sólo te he perdonado por haberme quitado esos recuerdos...",shape=box,color=blue];
		j2913989719 -> j3906489017;
	j551638376 [label="No sólo estoy empezando a perdonarte por haberme quitado esos recuerdos...",shape=box,color=blue];
		j551638376 -> j3906489017;
	j487060481 [label="No. No lo son. ¿Qué esperabas del \"Diablo de Tau\", recuerdos de una tarde soleada en el parque, recostado sobre una manta y comiendo uvas en una bandeja?",shape=box,color=blue];
		j487060481 -> j2223122846;
	j2521337271 [label="No sabré qué me arrebató hasta que lo recupere todo. ¡Claro que debemos seguir! Esos recuerdos son míos, Viajero. Forman quién soy, quién era. Son la esencia misma de mi ser.",shape=box,color=blue];
		j2521337271 -> j3286946455;
	"Chat ends." [color=orange];
	j3936490328 [label="Boolean RoatheStrugglebus is now true.",color=orange];
		j3936490328 -> j3141769412;
	j3768038051 [label="No, claro que no. Y lo que hagas con tu día no es asunto mío. Sólo digo que si quieres que ese mayordomo flacucho suba esas escaleras, tienes trabajo que hacer.",shape=box,color=blue];
		j3768038051 -> j2323512884;
	j874429209 [label="Asegúrate de hacerlo. No me importa lo que hagas con tu día. Sólo digo que si quieres que ese mayordomo flacucho suba esas escaleras, tienes trabajo que hacer.",shape=box,color=blue];
		j874429209 -> j332316378;
	j3906489017 [label="Pero empiezo a desear volver a confiar en ti. ¡Otra vez! Sabiendo perfectamente lo que has hecho. ¡Sabiendo que podrías traicionarme una vez más!",shape=box,color=blue];
		j3906489017 -> j4292793347;
	j2223122846 [label="Pobre Usurpador mío, temo que lo que encontraremos enterrado en los anales de mi mente no será más que sangre, vísceras y fracaso.",shape=box,color=blue];
		j2223122846 -> j3040500147;
		j2223122846 -> j1020889874;
	j3286946455 [label="Por lo que he podido saber de los demás respecto a tu estancia en Duviri, tú también sufriste un destino similar, ¿no es así?",shape=box,color=blue];
		j3286946455 -> j3918285331;
		j3286946455 -> j1537472587;
	j3141769412 [label="Sólo escucho historias de ti venciendo a Narmer. Derrotando hordas de soldados grineer. Derrotando oleadas de murmullos a cada paso. ¿Y aun así he logrado confundirte?",shape=box,color=blue];
		j3141769412 -> j371775718;
	j2323512884 [label="Si a ti no te importa, a mí tampoco. Tengo mis propios asuntos que atender.",shape=box,color=blue];
		j2323512884 -> "Chat ends.";
	j332316378 [label="Si a ti no te importa, a mí tampoco. Tengo mis propios asuntos que atender.",shape=box,color=blue];
		j332316378 -> j1933300832;
	j4292793347 [label="But I find myself sitting in that crypt and I stand from that chair and I think to myself \"I wonder if Drifter is about and if they wish to speak.\"",shape=box,color=blue];
		j4292793347 -> j431736655;
	j3040500147 [label="Tú pilotas esta nave. Si quieres seguir navegando hacia el agujero negro, ve a toda velocidad.",shape=box,color=red];
		j3040500147 -> j1113702865;
	j1020889874 [label="Entonces, ¿seguro que deseas continuar?",shape=box,color=red];
		j1020889874 -> j84953046;
	j3918285331 [label="Somos personas muy diferentes, Roathe.",shape=box,color=red];
		j3918285331 -> j1848582429;
	j1537472587 [label="Lo era. Recuerdo y apatía. Todavía no puedo recordar... fragmentos enteros de tiempo.",shape=box,color=red];
		j1537472587 -> j2779576909;
	j371775718 [label="+20 Chemistry",color=orange];
		j371775718 -> j3112693341;
	j1933300832 [label="+10 Chemistry",color=orange];
		j1933300832 -> "Chat ends.";
	j431736655 [label="How utterly pathetic is that? How low have I been brought? Me?! An Orokin?! Roathe! The Devil of Tau! So restless, so intellectually starved, so desperate for any kind of stimulation that I am here, speaking with you!",shape=box,color=blue];
		j431736655 -> j3503329849;
		j431736655 -> j708943315;
		j431736655 -> j2392392227;
		j431736655 -> j202800200;
	j1113702865 [label="+10 Chemistry",color=orange];
		j1113702865 -> j4005040582;
	j84953046 [label="I will not know what he took from me until I have it all back. Of course we should keep going! Those memories are mine, Drifter. They make up who I am, who I was. They are they very fabric of my being.",shape=box,color=blue];
		j84953046 -> j3849144227;
		j84953046 -> j3191988413;
	j1848582429 [label="That may be, but it was hardly the point I was making. Which you are avoiding having to concede. Very well. If, in theory, you had lost memories - would you seek to regain them if you could?",shape=box,color=blue];
		j1848582429 -> j3849144227;
		j1848582429 -> j3191988413;
	j2779576909 [label="If you had the opportunity to regain your lost memories, would you?",shape=box,color=blue];
		j2779576909 -> j1119482623;
		j2779576909 -> j3849144227;
		j2779576909 -> j3191988413;
	j3112693341 [label="Assuming that you are not lying to me? I admit that is rather flattering. Adorable. Extremly sad. But flattering.",shape=box,color=blue];
		j3112693341 -> "Chat ends.";
	j3503329849 [label="I look forward to our conversations, whether you do or not.",shape=box,color=red];
		j3503329849 -> j3742122688;
	j708943315 [label="I'll try not to take that personally.",shape=box,color=red];
		j708943315 -> j4163732577;
	j2392392227 [label="Or, you just enjoy talking to me?",shape=box,color=red];
		j2392392227 -> j1733946112;
	j4005040582 [label="Well said, Drifter. I will not know the magnitude of what was taken from me until I have it all back. Those memories make up who I am, who I was. They are they very fabric of my being.",shape=box,color=blue];
		j4005040582 -> j1119482623;
		j4005040582 -> j3849144227;
		j4005040582 -> j3191988413;
	j3849144227 [label="I think it's better to know than to not know, but... we have to be prepared for it.",shape=box,color=red];
		j3849144227 -> j357416102;
	j3191988413 [label="Sometimes I think things should stay buried for a reason.",shape=box,color=red];
		j3191988413 -> j1236212642;
	j1119482623 [label="It's yours. It's time for us to go get it. How bad could it be? You're an Orokin, you've done worse things, certainly.",shape=box,color=red];
		j1119482623 -> j2544281724;
	j3742122688 [label="Then I am so terribly glad I was not rendered unto a drooling idiot when you muddled about in my skull with a fork.",shape=box,color=blue];
		j3742122688 -> j3284677091;
	j4163732577 [label="Perhaps you should. You were the one who muddled about in my skull with a fork, after all.",shape=box,color=blue];
		j4163732577 -> j3284677091;
	j1733946112 [label="Perhaps I would, if I did not know you had muddled about in my skull with a fork.",shape=box,color=blue];
		j1733946112 -> j3284677091;
	j357416102 [label="Prepared, precisely, how? Do you believe I will collapse like some feeble house of cards once I learn the terrible truth of some grotesque war crime?",shape=box,color=blue];
		j357416102 -> j3522054777;
	j1236212642 [label="Are we not then doomed to repeat our previous mistakes? Never learning, never evolving, forever living in blissful ignorance of our former selves?",shape=box,color=blue];
		j1236212642 -> j927250906;
	j2544281724 [label="+10 Chemistry",color=orange];
		j2544281724 -> j4122235045;
	j3284677091 [label="Check boolean RoatheResetForgiven",color=orange];
		j3284677091 -> j1543845048 [label=true,color=green];
		j3284677091 -> j2379146107 [label=false,color=brown];
	j3522054777 [label="Believe me, I can imagine every possible thing I could have done to the Sentients, Orokin, or any combination thereof and there is little that would render me shocked or horrified.",shape=box,color=blue];
		j3522054777 -> j3899333187;
	j927250906 [label="Hm. I may have just made a case against my own argument for most people, I realize.",shape=box,color=blue];
		j927250906 -> j3686421624;
	j4122235045 [label="Hear, hear! I will hardly collapse like some feeble house of cards once I learn the terrible truth of some grotesque war crime.",shape=box,color=blue];
		j4122235045 -> j2180341279;
	j1543845048 [label="I said I forgave you. And I am attempting to adhere to that which I promised you. It is simply that words do not sometimes make a thing true. And saying one forgives someone is very nice in theory but sometimes emotions have a hard time following fact.",shape=box,color=blue];
		j1543845048 -> j941062748;
		j1543845048 -> j647070326;
	j2379146107 [label="Really, this is all quite irritating. I want to converse with you. But I also want to throttle you for having befouled my mind.",shape=box,color=blue];
		j2379146107 -> j2249224829;
		j2379146107 -> j2021831508;
	j3899333187 [label="Add 1 to Thermostat counter",color=orange];
		j3899333187 -> j3813322698;
	j3686421624 [label="Add -1 to Thermostat counter",color=orange];
		j3686421624 -> j3051867445;
	j2180341279 [label="Add -2 to Thermostat counter",color=orange];
		j2180341279 -> j3761865398;
	j941062748 [label="I understand. It's a hard thing to accept, and you might want to, but can't.",shape=box,color=red];
		j941062748 -> j579865239;
	j647070326 [label="So you... don't forgive me?",shape=box,color=red];
		j647070326 -> j579865239;
	j2249224829 [label="You're going to just have to accept what happened and move on, Roathe.",shape=box,color=red];
		j2249224829 -> j1671606992;
	j2021831508 [label="Do you think you can ever forgive me?",shape=box,color=red];
		j2021831508 -> j2455035813;
	j3813322698 [label="I can remember enough to know that I could ask for \"forgiveness\" at the altar of the Luminaries for the next two thousand years and have it never granted. ",shape=box,color=blue];
		j3813322698 -> j3112137732;
	j3051867445 [label="I would prefer to learn all the facts myself and judge the situation from there.",shape=box,color=blue];
		j3051867445 -> j3112137732;
	j3761865398 [label="I can imagine every possible thing I could have done to the Sentients, Orokin, or any combination thereof and there is little that would render me shocked or horrified.",shape=box,color=blue];
		j3761865398 -> j3890496142;
	j579865239 [label="I am trying my damnable and level best, Usurper. For there is something about you that has captured my attention. You are fascinating. And that is a rare thing in my world.",shape=box,color=blue];
		j579865239 -> j2530781974;
	j1671606992 [label="Mmhm.",shape=box,color=blue];
		j1671606992 -> "Chat ends.";
	j2455035813 [label="Boolean RoatheResetForgiven is now true.",color=orange];
		j2455035813 -> j579865239;
	j3112137732 [label="No, what is waiting for me at the bottom of my mind does not scare me. I merely wish to reclaim that which was wrongfully taken from me.",shape=box,color=blue];
		j3112137732 -> j362494054;
	j3890496142 [label="No, what is waiting for me at the bottom of my mind does not scare me. I merely wish to reclaim that which was wrongfully taken from me.",shape=box,color=blue];
		j3890496142 -> j509609570;
	j2530781974 [label="So be patient with me, if you can, while I try to reconcile all this.",shape=box,color=blue];
		j2530781974 -> j3172473025;
		j2530781974 -> j2307305705;
	j362494054 [label="+10 Chemistry",color=orange];
		j362494054 -> j2865491717;
	j509609570 [label="As you said. It is time for us to retake that which is mine.",shape=box,color=blue];
		j509609570 -> "Chat ends.";
	j3172473025 [label="I will.",shape=box,color=red];
		j3172473025 -> j2462580690;
	j2307305705 [label="I'm the one who should be asking for patience from you, Roathe. Not the other way around.",shape=box,color=red];
		j2307305705 -> j608565229;
	j2865491717 [label="But I appreciate the concern, nonetheless.",shape=box,color=blue];
		j2865491717 -> "Chat ends.";
	j2462580690 [label="How kind of you.",shape=box,color=blue];
		j2462580690 -> j4081414586;
	j608565229 [label="+20 Chemistry",color=orange];
		j608565229 -> j4073329753;
	j4081414586 [label="+5 Chemistry",color=orange];
		j4081414586 -> "Chat ends.";
	j4073329753 [label="That recognition is appreciated.",shape=box,color=blue];
		j4073329753 -> "Chat ends.";
}