		1782 -> 1783 [label="false",color=purple];
	1786 [label="Me atormenta día y noche. Esta persistente sensación de que no sólo te confié mis secretos más profundos, sino que traicionaste esa confianza y me lo quitaste todo, y ahora ni siquiera recuerdo por qué...",shape=box,color=blue];
		1786 -> 1793;
	1785 [label="Estamos avanzando a buen ritmo para eliminar estos bloqueos de mi mente. Albrecht me dejó fatal al inyectarme ese suero.",shape=box,color=blue];
		1785 -> 1791;
		1785 -> 1792;
		1785 -> 1790;
	1784 [label="Tu progreso para ayudarme a recuperar la memoria es insuficiente. Si deseas cumplir tu promesa, espero que continúes tu trabajo en Descendia.",shape=box,color=blue];
		1784 -> 1789;
		1784 -> 1787;
		1784 -> 1788;
		1784 -> 1790;
	1783 [label="No has avanzado en Descendia para desenterrar mis recuerdos. Si quieres que cumpla mi promesa, tendrás que esforzarte por cumplir la tuya.",shape=box,color=blue];
		1783 -> 1787;
		1783 -> 1788;
		1783 -> 1789;
		1783 -> 1790;
	1793 [label="Check boolean RoatheResetForgiven",color=orange];
		1793 -> 1801 [label=true,color=green];
