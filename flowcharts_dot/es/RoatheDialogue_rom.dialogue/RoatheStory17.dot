	"Chat ends." [color=orange];
	j856336325 [label="MV: WARFRAMES",shape=box,color=blue];
		j856336325 -> j3227332393;
	j3227332393 [label="Transcripción: Al principio, los warframes parecían más una declaración artística que un arma legítima.",shape=box,color=blue];
		j3227332393 -> j3034956565;
	j3034956565 [label="La guerra estaba prácticamente perdida; los conscientes eran invencibles; creemos, entonces, estos guerreros extraños y surrealistas y armémoslos con armas de un linaje ancestral.",shape=box,color=blue];
		j3034956565 -> j1933360628;
	j1933360628 [label="Al menos nuestra derrota será bella. Memorable.",shape=box,color=blue];
		j1933360628 -> j1907983438;
	j1907983438 [label="Pero contra todo pronóstico, triunfaron. Pronto, historias de un heroísmo escandalosamente improbable comenzaron a filtrarse desde el frente.",shape=box,color=blue];
		j1907983438 -> j2726001395;
	j2726001395 [label="Los warframes habían aparecido del cielo, con forma de ángeles, liberando cautivos y devastando fortalezas conscientes. Solos, eran milagros, y en grupos, eran dioses.",shape=box,color=blue];
		j2726001395 -> j1774657184;
	j1774657184 [label="No es de extrañar, entonces, que se les considerara mera propaganda.",shape=box,color=blue];
		j1774657184 -> j921430358;
	j921430358 [label="Add 1 to HellStory counter",color=orange];
		j921430358 -> "Chat ends.";
}