	234 [label="¡Me abandonó allí, en un año horriblemente antiguo, en un rincón perdido del Sistema Origen! ¿Sabes que esa \"Cathédrale\" olvidada por el Vacío ni siquiera tenía electricidad todavía? ¡Electricidad!",shape=box,color=blue];
