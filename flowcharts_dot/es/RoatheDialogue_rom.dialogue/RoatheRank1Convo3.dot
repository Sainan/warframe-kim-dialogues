		5741 -> 5742;
	288 [label="Segundo: ¡¿Qué tan inepto debes ser?! Estoy bastante seguro de que si simplemente intentaras alimentar y dar de beber al sacerdote una vez al día, tendrías su amor y adoración eternos.",shape=box,color=blue];
		288 -> 296;
	289 [label="Segundo: ¿Intentaste cojear frente a ella? ¿Fingir alguna enfermedad? ¿Hacerle seducción? ¿Simplemente decirle que se veía bien? No parece muy difícil conquistarla.",shape=box,color=blue];
		289 -> 297;
	290 [label="Estoy aquí sentado y dos cosas me llaman la atención inmediatamente al confirmarse mi sospecha:",shape=box,color=blue];
		290 -> 298;
	287 [label="Pero esa es una conversación para otro día. Porque tengo una propuesta para ti. Una que creo que te interesará mucho más.",shape=box,color=blue];
		287 -> 295;
	291 [label="Mi cuerpo estaba siendo destrozado y reconstruido. A la fuerza. Yo no elegí esto. No sé si a los demás les pasó lo mismo.",shape=box,color=blue];
		291 -> 299;
	292 [label="Utilicé muestras de mi propia sangre para replicar un Helminto mediante ingeniería inversa, a base de ensayo y error. No fue tarea fácil, ya que no tenía acceso a ningún equipo Orokin. Ni a ningún otro equipo, en realidad, salvo lo que pude robar de...",shape=box,color=blue];
		292 -> 300;
