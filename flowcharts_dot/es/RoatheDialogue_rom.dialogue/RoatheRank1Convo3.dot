	341 [label="Si hubiera estado consciente en el momento en que lo dijo, me habría reído en su cara. Es decir, porque no soy yo quien claramente busca el perdón, ¿verdad?",shape=box,color=blue];
		341 -> 350;
	342 [label="Tenía razón. Aunque el proceso de crear uno fue... laborioso y minucioso, por decir lo menos. ¡Usé muestras de mi propia sangre para hacer ingeniería inversa de un Helminto, a base de prueba y error!",shape=box,color=blue];
		342 -> 351;
	343 [label="Pero tengo destellos. Fragmentos de un pasillo dorado. Una voz que reconocí, pero no un rostro. Era Albrecht, pero no el que yo conocía.",shape=box,color=blue];
		343 -> 352;
	344 [label="Y, lo que es más importante, me aseguraré de que esta vez logres tu objetivo de ayudar a Lyon a superar su dolor, pase lo que pase.",shape=box,color=blue];
