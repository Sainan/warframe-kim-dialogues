		194 -> 198 [label="false",color=purple];
	196 [label="Eres tan despreciable como Albrecht, manipulando las mentes de quienes te rodean, ¡como si fueran tus juguetes! Así que dime. ¿Para qué preguntar si ya tienes las respuestas?",shape=box,color=blue];
		196 -> 201;
		196 -> 202;
	195 [label="Dime. ¿Acaso tengo la razón en decir que ya tienes las respuestas que buscas? Ya sabes cómo regresé aquí con los fanáticos... de dónde venimos exactamente. Y probablemente mucho más que eso, ¿verdad?",shape=box,color=blue];
		195 -> 199;
		195 -> 200;
	197 [label="Entendí que Albrecht no te puso ahí por voluntad propia.",shape=box,color=red];
		197 -> 203;
	198 [label="Ah. Así que no te pusieron en el pasado por elección propia.",shape=box,color=red];
		198 -> 203;
	201 [label="Estoy intentando guiarlos a todos en este proceso, y la última vez lo hice fatal. Lo voy a intentar de nuevo. Desde cero, por así decirlo.",shape=box,color=red];
		201 -> 206;
	202 [label="No sé muy bien cómo explicar esto. No pedí este poder para borrar sus mentes, y estoy intentando aprender a manejarlo lo mejor posible.",shape=box,color=red];
		202 -> 207;
	199 [label="No. No lo sé.",shape=box,color=red];
		199 -> 204;
	200 [label="Yo... admito que sí lo sé.",shape=box,color=red];
		200 -> 205;
	203 [label="No. Para nada. Ahora bien, hay algo que debes entender sobre los orokin: jugamos... bien, quiero decir que jugábamos juegos entre nosotros con frecuencia. Juegos de todo tipo. Políticos, psicológicos, sexuales. Daba igual.",shape=box,color=blue];
		203 -> 208;
	206 [label="+5 Chemistry",color=orange];
		206 -> 211;
