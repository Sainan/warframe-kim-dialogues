		267 -> 275;
	268 [label="¡Sí! ¡Precisamente! ¡Con muestras de mi propia sangre, nada menos! ¡No empecé el mismo año que nos fuimos, te lo aseguro! Por el Vacío, le arrancaré la carne con estas nuevas garras en cuanto vea su estúpida y engreída cara...",shape=box,color=blue];
		268 -> 276;
