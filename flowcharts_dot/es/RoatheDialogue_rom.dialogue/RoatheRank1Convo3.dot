		224 -> 231;
	227 [label="Pero hay límites que no cruzamos. Acciones que no llevamos a cabo. Podría extenderme en detalles, pero no lo haré. Simplemente diré que Albrecht los quebrantó todos.",shape=box,color=blue];
		227 -> 234;
