		346 -> 355;
		346 -> 356;
	350 [label="¡Él es quien huye de su familia, de su amante, de la lucha que ha comenzado con ese falso dios suyo! ¡Yo no soy el maldito cobarde que se interpone entre nosotros!",shape=box,color=blue];
		350 -> 360;
	351 [label="Update boolean RoatheHelminth1",color=orange];
		351 -> 361;
	352 [label="Un dolor abrasador, insoportable. Como ningún otro que hubiera conocido antes. Y un cuerpo anterior mío perdió un brazo y una pierna en una explosión durante la guerra, Viajero. He sufrido quemaduras tan graves que no me habría recuperado de no ser por Kuva. He conocido la agonía.",shape=box,color=blue];
		352 -> 362;
	353 [label="Pero recuerda mis palabras, Viajero.",shape=box,color=blue];
		353 -> 363;
	354 [label="Y, lo que es más importante, me aseguraré que esta vez logres tu objetivo de que Marie \"vea la luz\" sobre Entrati, pase lo que pase.",shape=box,color=blue];
