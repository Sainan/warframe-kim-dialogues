	332 [label="Sé lo que les dijo a los dos fanáticos, aunque no tenga mucha importancia. «Uriel, hereje de Xata, en el destierro, responde: ¿podrán los orokin ser perdonados alguna vez?»",shape=box,color=blue];
		332 -> 341;
	333 [label="Un Helminto. Desconozco cómo había crecido, pues debía estar allí antes de nuestra llegada. Se marchitó y murió en el proceso; supuse que podríamos usar otro para un próximo viaje.",shape=box,color=blue];
		333 -> 342;
	334 [label="Desconozco los detalles, ya que esos recuerdos se han borrado de mi mente junto con muchos otros debido a la transformación a la que me sometió.",shape=box,color=blue];
		334 -> 343;
	335 [label="Haré como que no sé nada delante de los fanáticos por ti...",shape=box,color=blue];
		335 -> 344;
	336 [label="Pero esa es una conversación para otro día. Porque tengo una propuesta para ti. Una que creo que te interesará mucho más.",shape=box,color=blue];
		336 -> 345;
	5746 [label="Ni hoy. Ni mañana.",shape=box,color=blue];
		5746 -> 5745;
	338 [label="¿Por qué?",shape=box,color=blue];
		338 -> 347;
