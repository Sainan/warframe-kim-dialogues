		219 -> 220;
	220 [label="Mi argumento era este: estoy acostumbrado, bastante acostumbrado de hecho, a las maquinaciones y los planes que los orokin nos urdimos entre nosotros para divertirnos. Es simplemente nuestra forma de pasar el tiempo.",shape=box,color=blue];
