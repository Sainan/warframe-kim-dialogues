	191 [label="¿Por qué sospecho que ya conoces perfectamente la respuesta, mi Usurpador? ¿A qué juegas preguntando por tales trivialidades, si ya has hurgado en mis pensamientos?",shape=box,color=blue];
		191 -> 193;
	192 [label="¡Sí, puedes preguntar! Me brinda la oportunidad de explayarme sobre mi propia brillantez y quejarme de la profunda habilidad de Albrecht para ser a la vez un completo zoquete y un cobarde supremo, ¡todo al mismo tiempo!",shape=box,color=blue];
		192 -> 194;
