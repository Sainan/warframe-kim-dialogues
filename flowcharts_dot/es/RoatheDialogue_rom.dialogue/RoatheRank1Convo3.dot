		295 -> 303;
	299 [label="Recuerdo las frías escaleras bajo mis pies, cuando aparecí sobre ellas. Ahora sé que eran las escaleras de una catedral, pues Lyon y Marie me lo han contado según sus recuerdos.",shape=box,color=blue];
		299 -> 307;
	300 [label="No les haré el favor de llamar los hospitales \"rudimentarios\". Albrecht había usado un Helminto para transportarnos al pasado. Desconozco cómo había crecido allí, pues debía estar presente antes de nuestra llegada. Se marchitó y murió en el proceso; sospechaba que otro podría usarse para un viaje de regreso.",shape=box,color=blue];
		300 -> 308;
	301 [label="En segundo lugar, me sorprende la furia y la ira inmediatas al saber que mi mente ha sido manipulada no una, sino dos veces en la historia reciente. Pero hay otra emoción que vence a la ira. Una que aún no comprendo del todo.",shape=box,color=blue];
