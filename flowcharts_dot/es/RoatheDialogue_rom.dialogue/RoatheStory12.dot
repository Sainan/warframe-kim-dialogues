	j431699851 [label="MV: FUEGO",shape=box,color=blue];
		j431699851 -> j2457509319;
	j2457509319 [label="Transcripción: La monstruosidad y el exceso nos habían sido admirables en el pasado. Se esperaba que los usara como tácticas de guerra.",shape=box,color=blue];
		j2457509319 -> j1296289052;
	j1296289052 [label="¿Cómo controlamos la Infestación en tiempos de nuestros antepasados? ¡Abriendo el corazón del átomo como un capullo de rosa, por supuesto!",shape=box,color=blue];
		j1296289052 -> j877781693;
	j877781693 [label="Como uno solo, los Siete me ordenaron convertirme en un diablo con un tridente de ojivas, un sembrador con una bolsa de radiación desenfrenada.",shape=box,color=blue];
		j877781693 -> j119862410;
	j119862410 [label="Ese fue el día en que supimos que los conscientes no sólo eran capaces de anular nuestra tecnología, sino también de apoderarse de ella.",shape=box,color=blue];
		j119862410 -> j2862798161;
	j2862798161 [label="Los enjambres de desagradables y pequeños drones niveladores que habíamos enviado regresaron volando felices, todavía cargados con bombas, cacareando sílabas desconocidas, explotando en medio de las mismas naves nodrizas que los habían enviado.",shape=box,color=blue];
		j2862798161 -> j921430358;
	j921430358 [label="Add 1 to HellStory counter",color=orange];
		j921430358 -> "Chat ends.";
