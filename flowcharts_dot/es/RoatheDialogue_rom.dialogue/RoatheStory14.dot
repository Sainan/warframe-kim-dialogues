	"Chat ends." [color=orange];
	j846337120 [label="MV: ADAPTACIÓN",shape=box,color=blue];
		j846337120 -> j2667822270;
	j2667822270 [label="Transcripción: Muchos conscientes evolucionaron entre encuentros, por lo que nunca podíamos estar seguros de enfrentarnos al mismo enemigo dos veces. Pero otros se mantuvieron en forma constante, como si hubieran alcanzado un punto hace mucho tiempo.",shape=box,color=blue];
		j2667822270 -> j3947995437;
	j3947995437 [label="Asesinos perfectos, inspiraban el mismo horror escalofriante que un tiburón.",shape=box,color=blue];
		j3947995437 -> j3078916612;
	j3078916612 [label="Era una locura. ¿Cómo podía planear estrategias para contrarrestar el comportamiento de las naves conscientes, si apenas había perfeccionado mis tácticas y ya estaban reemplazando sus naves por naves gusano?",shape=box,color=blue];
		j3078916612 -> j4258960529;
	j4258960529 [label="¿Y cuánto tiempo pasaría antes de que esas naves gusano fueran reemplazadas por alguna nueva monstruosidad?",shape=box,color=blue];
		j4258960529 -> j1415868190;
	j1415868190 [label="Todo lo que podíamos hacer era retroceder. El progreso había sido fatal. Las viejas tradiciones, los caminos consagrados por el tiempo, de honor y disciplina, merecían su merecido.",shape=box,color=blue];
		j1415868190 -> j921430358;
	j921430358 [label="Add 1 to HellStory counter",color=orange];
		j921430358 -> "Chat ends.";
}