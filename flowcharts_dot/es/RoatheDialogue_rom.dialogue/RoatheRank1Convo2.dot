digraph {
	135 [label="RoatheRank1Convo2 begins.",color=orange];
		135 -> 136;
	136 [label="Te das cuenta de que tu supuesta \"indiferencia\" no es un \"dios\" real, ¿verdad?",shape=box,color=blue];
		136 -> 139;
		136 -> 138;
		136 -> 137;
	139 [label="Está bastante cerca de ser uno.",shape=box,color=red];
		139 -> 142;
	138 [label="¿Y qué te hace estar tan seguro?",shape=box,color=red];
		138 -> 141;
	137 [label="[Fin]",shape=box,color=red];
		137 -> 140;
	142 [label="Todos con los que hablo en este manicomio están completamente convencidos de que este \"Hombre en la Pared\" es una especie de dios literal y ridículo. Un dios de verdad. ¡Incluso esos dos fanáticos parecen estar considerando la idea!",shape=box,color=blue];
		142 -> 144;
		142 -> 145;
		142 -> 146;
	141 [label="Bueno, dejando de lado la dura realidad de que cualquier creencia en un dios o dioses proviene de idiotas que se aferran a: Primero, una necesidad imperiosa de aferrarse a un peluche cuando se enfrentan al horror brutal de la finalidad de su alma al llegar la muerte,",shape=box,color=blue];
		141 -> 143;
	140 [label="Chat ends.",color=orange];
	144 [label="¿No crees que sea real?",shape=box,color=red];
		144 -> 148;
	145 [label="Y si no crees que es un dios, ¿qué crees que es?",shape=box,color=red];
		145 -> 149;
	146 [label="¿Y tú no?",shape=box,color=red];
		146 -> 150;
	143 [label="Dos, la ansiedad que uno sufre al darse cuenta de que no existe un \"Poder Superior\" que dirija nuestras vidas y, por lo tanto, simplemente somos responsables de nuestros propios actos y, por extensión,",shape=box,color=blue];
		143 -> 147;
	148 [label="Ahora bien, ¿acaso dije esas palabras? No me apresures a poner palabras en mi boca, oh Usurpador Transitorio. No negué que la Indiferencia fuera \"real\". Negué que fuera un dios.",shape=box,color=blue];
		148 -> 152;
		148 -> 153;
	149 [label="Puedo desenmascarar a esta falsa deidad para ti en dos sencillas palabras que deberías conocer y comprender muy bien:",shape=box,color=blue];
		149 -> 154;
	150 [label="¡Por supuesto que no! Primero, no existen dioses, la idea es absurda. Segundo, ¿pensar que Albrecht liberó a un dios del Vacío? ¡Aún más ridículo!",shape=box,color=blue];
		150 -> 155;
	147 [label="En tercer lugar, la justa ira que acompaña a la ansiedad y el horror, cuando todo esto conduce a la epifanía de que no hay un \"infierno\" esperando a los demonios, ni un \"cielo\" esperando a los ángeles.",shape=box,color=blue];
		147 -> 151;
	152 [label="Esa cosa es más poderosa que cualquier cosa a la que me haya enfrentado jamás.",shape=box,color=red];
		152 -> 156;
	153 [label="¿Qué crees que es entonces?",shape=box,color=red];
		153 -> 149;
	154 [label="Encarnación conceptual.",shape=box,color=blue];
		154 -> 157;
		154 -> 158;
		154 -> 159;
	155 [label="En el Vacío no hay nada. ¡Por eso se llama el Vacío! ",shape=box,color=blue];
		155 -> 160;
		155 -> 161;
	151 [label="Parto de la base de que no eres un fanático baboso aferrado a la ira, el horror o la ansiedad. Partiendo de esta premisa, voy a presentar el segundo argumento que deseo exponerte para despojar a la \"Indiferencia\" de su supuesta divinidad:",shape=box,color=blue];
		151 -> 154;
	156 [label="¿Y cuándo lo he negado? De hecho, parece que todos ustedes se han enredado en una tribulación bastante histérica e innecesariamente exagerada.",shape=box,color=blue];
		156 -> 162;
		156 -> 163;
	157 [label="El Vacío y lo que podemos crear con él es peligroso y poderoso; créeme, lo sé. Pero tiene límites. ¿De verdad crees que es capaz de manifestar algo así? ¿Qué puede crear lenguajes enteros, dedos que impulsan naves que saltan a través del Vacío?",shape=box,color=red];
		157 -> 164;
	158 [label="Es... muy tentador creer que solo es un monstruo debajo de nuestra cama, Roathe. Pero yo he visto a esa cosa, cara a cara, y no sé cómo algo así puede surgir de nuestra mente.",shape=box,color=red];
		158 -> 165;
	159 [label="La encarnación conceptual no puede hacer lo que el Hombre en la Pared es capaz de hacer. Si bien Entrati pudo haber manifestado eso —y es responsable de traerlo aquí— no creo que sea su fuente original.",shape=box,color=red];
		159 -> 166;
	160 [label="No. He visto cosas que vienen del Vacío. Ángeles. Cantando. Fantasmas.",shape=box,color=red];
		160 -> 167;
	161 [label="Yo... ",shape=box,color=red];
		161 -> 167;
	162 [label="¿Qué estás diciendo?",shape=box,color=red];
		162 -> 168;
	163 [label="Un momento. ¿Cómo podemos tener la culpa de esto? La culpa es de Albrecht, él lo desató.",shape=box,color=red];
		163 -> 169;
	164 [label="La humanidad, sin duda, es creativa en la amplitud y magnitud de las nuevas formas de sufrimiento que puede idearse a sí misma, ¿no es así? Tú mismo has sido testigo de muchas formas de crueldad que estoy seguro de que nadie podría haber imaginado posibles en la época de nuestros queridos fanáticos.",shape=box,color=blue];
		164 -> 170;
	165 [label="Ah, estás tan cerca de la verdad y, sin embargo, la descartas con tanta facilidad. ¿Crees que es \"tentador\" pensar que es una creación de tu propia mente, ya que así sería más fácil descartarla? No, creo que es mucho más peligroso enfrentarse a una creación nuestra que a un dios.",shape=box,color=blue];
		165 -> 171;
	166 [label="Si bien aprecio tu humildad, cuestiono tu limitada comprensión de la capacidad de la creatividad humana, especialmente en lo que respecta a cómo puede idear nuevas formas de sufrimiento. ¿Acaso no eres tú, por tu cuenta, el responsable de haber creado tu propio universo de la nada?",shape=box,color=blue];
		166 -> 172;
	167 [label="Lo único que proviene del Vacío es lo que depositamos en él, y lo que regresa de él. Transforma la materia y la energía, pero no puede crearlas.",shape=box,color=blue];
		167 -> 173;
	168 [label="Lo que digo es esto: pueda que Albrecht fuera quien originalmente vio reflejada su propia arrogancia como el rostro de un dios de la destrucción sonriente, sí.",shape=box,color=blue];
		168 -> 174;
	169 [label="Pueda que Albrecht fuera quien originalmente vio reflejada su propia arrogancia como el rostro de un dios de la destrucción sonriente, sí.",shape=box,color=blue];
		169 -> 174;
	170 [label="+15 Chemistry",color=orange];
		170 -> 175;
	171 [label="A un enemigo externo se le puede comprender, manipular, derrotar e incluso negociar con él, si fuera necesario. Tiene debilidades que se pueden aprovechar. ¿Pero un enemigo interno? ¿Uno que nosotros mismos hemos creado? Ese es, sin duda, mucho más insidioso.",shape=box,color=blue];
		171 -> 176;
	172 [label="Tú mismo has sido testigo de muchas formas de crueldad que estoy seguro de que nadie podría haber imaginado posibles en la época de nuestros queridos fanáticos. ",shape=box,color=blue];
		172 -> 177;
	173 [label="Piensa, Viajero. Esos \"Ángeles del Vacío\" de los que hablas. Esos fantasmas. ¿Acaso fueron creados de aquellos que ya se perdieron en el Vacío?",shape=box,color=blue];
		173 -> 178;
	174 [label="Pero todos somos igualmente culpables por seguir haciendo rodar este excremento de bicho juba cuesta abajo durante tanto tiempo, ¡haciéndolo cada vez más grande con cada pedacito de excremento que recoge por el camino!",shape=box,color=blue];
		174 -> 179;
	175 [label="Como especie, somos bastante asombrosos en nuestra capacidad de alimentar nuestros miedos con nuevas formas de autodestruirnos.",shape=box,color=blue];
		175 -> 180;
	176 [label="+20 Chemistry",color=orange];
		176 -> 181;
	177 [label="+10 Chemistry",color=orange];
		177 -> 175;
	178 [label="No eran más que ecos de energía regurgitada como un colorido kutak para alimentar a sus hijos.",shape=box,color=blue];
		178 -> 179;
	179 [label="Permíteme simplificar la discusión. Puedo desenmascarar a esta falsa deidad en dos sencillas palabras que deberías conocer y comprender muy bien:",shape=box,color=blue];
		179 -> 154;
	180 [label="Mm. Me temo que debo irme. Te dejo un tiempo para que reflexiones sobre mis palabras.",shape=box,color=blue];
		180 -> 182;
		180 -> 183;
	181 [label="Porque entonces debemos luchar contra nuestros propios demonios. Y la humanidad... nunca gana esas guerras, ¿verdad?",shape=box,color=blue];
		181 -> 180;
	182 [label="Lo haré. Gracias.",shape=box,color=red];
		182 -> 184;
	183 [label="Piensa sobre lo que yo te dije, puede que acabes queriendo creer mis palabras cuando te enfrentes a un antidios.",shape=box,color=red];
		183 -> 184;
	184 [label="Update boolean RoatheMITW1",color=orange];
		184 -> 185;
	185 [label="Chat ends.",color=orange];
}