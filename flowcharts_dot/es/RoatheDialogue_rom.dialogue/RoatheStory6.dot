	"Chat ends." [color=orange];
	j2493581173 [label="MV: CONCIENCIA",shape=box,color=blue];
		j2493581173 -> j2141283779;
	j2141283779 [label="Transcripción: No pensábamos en los conscientes como un \"alguien\" sino como un \"algo\". ",shape=box,color=blue];
		j2141283779 -> j3719545299;
	j3719545299 [label="Nos enfrentamos a legiones lanzadas contra nosotros sin más respeto por sus vidas individuales que el que tienen los corpúsculos.",shape=box,color=blue];
		j3719545299 -> j3981126693;
	j3981126693 [label="Eran células en el cuerpo de una masa extensa y malévola.",shape=box,color=blue];
		j3981126693 -> j2983324283;
	j2983324283 [label="Creo que estábamos demasiado condicionados por nuestras experiencias con la infestación, una mente colmena de un tipo completamente diferente.",shape=box,color=blue];
		j2983324283 -> j2644320468;
	j2644320468 [label="A los conscientes se les había dado el mandato de evolucionar y su único modelo para el punto final de dicha evolución éramos nosotros.",shape=box,color=blue];
		j2644320468 -> j3924161359;
	j3924161359 [label="Regresaban al Sistema Origen no sólo para aniquilar a los orokin, sino para reemplazarlos y, en última instancia… perfeccionarlos.",shape=box,color=blue];
		j3924161359 -> j921430358;
	j921430358 [label="Add 1 to HellStory counter",color=orange];
		j921430358 -> "Chat ends.";
}