	"Chat ends." [color=orange];
	j2563790480 [label="MV: COMANDANTES",shape=box,color=blue];
		j2563790480 -> j249908332;
	j249908332 [label="Transcripción: Ahora los recuerdo. Grupos de jóvenes orokin risueños.",shape=box,color=blue];
		j249908332 -> j703421874;
	j703421874 [label="Nobleza con sus vestiduras de mando todavía inmaculadas.",shape=box,color=blue];
		j703421874 -> j1275242909;
	j1275242909 [label="Amigos de la infancia, ahora a cargo de legiones de Dax, grineer, células de materia nula, carcinadores autorreplicantes, biodrones arácnidos primitivos, contenedores de tropas rudimentarias.",shape=box,color=blue];
		j1275242909 -> j2405777349;
	j2405777349 [label="Niños y niñas dorados con demonios voraces a su disposición.",shape=box,color=blue];
		j2405777349 -> j737656283;
	j737656283 [label="Su arrogancia gotea en mi mente como un sudor punzante. Bebían y cantaban, alardeando de los tiempos venideros.",shape=box,color=blue];
		j737656283 -> j4085211854;
	j4085211854 [label="Se harían un nombre. Criarían a sus familias en un lugar de honor.",shape=box,color=blue];
		j4085211854 -> j4132451638;
	j4132451638 [label="Cayeron muchos. Ni siquiera sus cuerpos fueron devueltos.",shape=box,color=blue];
		j4132451638 -> j2129638950;
	j2129638950 [label="Para evitar que el enemigo descubriera nuestros secretos, fueron sometidos a una descarga de Kuva para que se licuaran al morir.",shape=box,color=blue];
		j2129638950 -> j1425076840;
	j1425076840 [label="La esperanza de una generación se convirtió en un charco aceitoso, atravesado por botas grineer.",shape=box,color=blue];
		j1425076840 -> j921430358;
	j921430358 [label="Add 1 to HellStory counter",color=orange];
		j921430358 -> "Chat ends.";
}