		"Initiate conversation LyonRoatheFail in /Lotus/Types/Gameplay/1999Wf/Dialogue/LyonDialogue_rom.dialogue" -> "Chat ends.";
	j2989953447 [label="Boolean RoatheFailStall is now false.",color=orange];
		j2989953447 -> "Chat ends.";
	j547790704 [label="Típico.",shape=box,color=red];
		j547790704 -> j2344741554;
	j2508242578 [label="Espera. ¡¿Por qué?!",shape=box,color=red];
		j2508242578 -> j2430049095;
	j3902721596 [label="Dijiste que me ayudarías si te ayudaba a recuperar la memoria. Y lo hice. ¡Ese fue nuestro acuerdo!",shape=box,color=red];
		j3902721596 -> j182232729;
	j2008308343 [label="Espera. ¿Por qué no me ayudas?",shape=box,color=red];
		j2008308343 -> j182232729;
	j4083106162 [label="Nada.",shape=box,color=blue];
		j4083106162 -> "Chat ends.";
	j2878012652 [label="Estoy seguro de que me enojaré muchísimo contigo cuando me dé cuenta de que has alterado mis recuerdos, claro. Y te recomiendo que no me digas que fue por petición mía, cariño.",shape=box,color=blue];
		j2878012652 -> j1905752380;
	j4081414586 [label="+5 Chemistry",color=orange];
		j4081414586 -> "Chat ends.";
	j1466456391 [label="Check boolean RoatheKnowsReset2",color=orange];
		j1466456391 -> j3815039644 [label=true,color=green];
		j1466456391 -> j666876724 [label=false,color=brown];
	j1811152323 [label="Boolean IsDating is now false.",color=orange];
		j1811152323 -> j2294644753;
	j2344741554 [label="No te amargues tanto sólo porque ahora te das cuenta de que te han superado. Te ofrecí los términos del contrato sin explicarte mi parte. ¿O es que no te diste cuenta?",shape=box,color=blue];
		j2344741554 -> j943137137;
	j2430049095 [label="Te ofrecí los términos del contrato sin explicarte mi parte. ¿O es que no te diste cuenta?",shape=box,color=blue];
		j2430049095 -> j943137137;
	j182232729 [label="\"Necesito a alguien que me ayude a registrar mis recuerdos y a reconciliarlos. Una especie de asistente temporal\".",shape=box,color=blue];
		j182232729 -> j1992479331;
	j1905752380 [label="Simplemente diré que estás mintiendo y probablemente eso dañará mi opinión sobre ti.",shape=box,color=blue];
		j1905752380 -> j4078449123;
		j1905752380 -> j3139285717;
	j3815039644 [label="Cada vez que hablamos, no puedo evitar preguntarme si las costas que pisamos te resultan familiares o desconocidas. Si sólo estoy repitiendo lo que dije o si guardo alguna sorpresa nueva.",shape=box,color=blue];
		j3815039644 -> j2957421565;
	j666876724 [label="Cumpliste con tu parte del contrato. Hemos llegado al penúltimo punto, donde debemos concretar los detalles de nuestro método de ataque.",shape=box,color=blue];
		j666876724 -> j3061068487;
	j2294644753 [label="Boolean RoatheDating is now false.",color=orange];
		j2294644753 -> j1382079867;
	j943137137 [label="Simplemente te dije lo que obtendrías de este acuerdo. Nunca te dije qué tenías que hacer ni por qué para lograrlo. Y aceptaste sin pensarlo.",shape=box,color=blue];
		j943137137 -> j1570969196;
	j1992479331 [label="Si bien cumpliste con el primer criterio, \"registrar mis recuerdos\", fallaste espectacularmente en el segundo, \"ayudarme a reconciliarlos\".",shape=box,color=blue];
		j1992479331 -> j1513509038;
	j4078449123 [label="No. No puedo. No lo haré. Tenemos que afrontar esta situación juntos. ¿No podemos simplemente hablar de esto?",shape=box,color=red];
		j4078449123 -> j3188850266;
	j3139285717 [label="Yo... ¿realmente no hay otra manera?",shape=box,color=red];
		j3139285717 -> j3188850266;
	j2957421565 [label="De cualquier manera, prefiero que no me lo digas. Detesto ser demasiado predecible. En cualquier caso, me has ayudado a resolver un asunto muy importante para mí. ",shape=box,color=blue];
		j2957421565 -> j2014024258;
	j3061068487 [label="Esta batalla debe librarse en tres frentes. Todos deben trabajar en conjunto para ganar esta guerra.",shape=box,color=blue];
		j3061068487 -> j401164927;
		j3061068487 -> j4113169285;
	j1382079867 [label="Bueno, lo que sea que quieras de mí, no lo conseguirás ahora. Será mejor que desistas y borres esta farsa de mi memoria, \"querido Viajero\".",shape=box,color=blue];
		j1382079867 -> j3914091547;
	j1570969196 [label="Esto es lo que antiguamente se llamaba un \"cheque en blanco\", ¿no? Y lo firmaste de buena gana.",shape=box,color=blue];
		j1570969196 -> j648188977;
		j1570969196 -> j2712444273;
	j1513509038 [label="Yo no diría que están reconciliados, ¿y tú?",shape=box,color=blue];
		j1513509038 -> j1301802309;
	j3188850266 [label="No. ¿Quieres que el mayordomo suba? Bórrame todas estas tonterías, como te lo pedí. ¿Y si no te importa? Haz lo que quieras. A mí me da igual.",shape=box,color=blue];
		j3188850266 -> j2879767754;
	j2014024258 [label="Anoche dormí mejor que en mucho tiempo. Diría \"más de lo que recuerdo\", pero sería un mal chiste.",shape=box,color=blue];
		j2014024258 -> j607233045;
	j401164927 [label="¿Disculpa?",shape=box,color=red];
		j401164927 -> j4114782065;
	j4113169285 [label="¿Estamos hablando de Loid?",shape=box,color=red];
		j4113169285 -> j1877437138;
	j648188977 [label="¿Hay alguna manera de hacerte cambiar de opinión?",shape=box,color=red];
		j648188977 -> j5697017;
	j2712444273 [label="¿Cómo salgo de esto?",shape=box,color=red];
		j2712444273 -> j1046499631;
	j1301802309 [label="Tú no cumpliste tu parte del trato, así que yo no cumpliré la mía.",shape=box,color=blue];
		j1301802309 -> j648188977;
		j1301802309 -> j535447703;
	j2879767754 [label="Eso, y, claro, nuestra amistad personal es mi única ventaja en esta situación. Así de simple.",shape=box,color=blue];
		j2879767754 -> j2495340241;
	j607233045 [label="Así que ahora te ayudaré. El mayordomo. ¿Aún deseas reunirlo con la familia de Albrecht allá arriba?",shape=box,color=blue];
		j607233045 -> j744968765;
	j4114782065 [label="El mayordomo. Reuniéndolo con la familia de Albrecht. ¿Aún quieres hacer esto?",shape=box,color=blue];
		j4114782065 -> j1949841813;
	j1877437138 [label="Sí. Trata de seguir el ritmo. Supongo que aún quieres reunir a la familia de Albrecht allá arriba, ¿no?",shape=box,color=blue];
