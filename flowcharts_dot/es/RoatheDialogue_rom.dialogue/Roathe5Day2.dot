		j2304643196 -> j527101896 [label="false",color=purple];
	j3217888496 [label="Y aquí estamos, sin hacer nada. O no tienes nada mejor que hacer, Usurpador, o tienes todo lo que quieres de mí. ¿Cuál es?",shape=box,color=blue];
		j3217888496 -> j1261499089;
		j3217888496 -> j1435671718;
		j3217888496 -> j3802580300;
	j617454213 [label="Evaluate expressions on HellStory counter",color=orange];
		j617454213 -> j1471529079 [label="x >= 21",color=purple];
		j617454213 -> "Chat ends." [label="x <= 21",color=purple];
		j617454213 -> "Chat ends." [label="false",color=purple];
	j2627711076 [label="Amanece un nuevo día y me encuentro planeando el futuro por primera vez en... mucho tiempo. Pensando en cómo podría transformar este mundo que me rodea. En cómo podría usar lo que sé. Lo que soy. Cómo podría aprovecharlo mejor.",shape=box,color=blue];
		j2627711076 -> j3984658869;
	j3879032397 [label="Amanece un nuevo día y me encuentro planeando el futuro por primera vez en... mucho tiempo. Reflexionando sobre lo que esto significa para mí, sobre lo que quiero, sobre cómo deseo adaptar mi entorno a mis necesidades.",shape=box,color=blue];
		j3879032397 -> j2558396776;
	j3084262344 [label="¿Puedo preguntarte qué esperas exactamente? Estoy aquí sentado con el recuerdo de los acontecimientos aún intacto. Me prometiste que los borrarías de mi mente.",shape=box,color=blue];
		j3084262344 -> j2304586566;
		j3084262344 -> j1269964166;
		j3084262344 -> j1813514751;
	j2409542374 [label="¿Ya te decidiste? Soy un demonio paciente, pero tengo mis límites. ¿Vas a borrar estos recuerdos de mi mente o prefieres dejarme aquí, atrapado en ellos?",shape=box,color=blue];
		j2409542374 -> j3903635885;
		j2409542374 -> j1326347737;
	j527101896 [label="Aquí estamos y aquí nos quedaremos. En este purgatorio. Espero que lo disfrutes, pues no creo que podamos avanzar más.",shape=box,color=blue];
		j527101896 -> j2171950327;
	j1261499089 [label="¿Qué quieres decir?",shape=box,color=red];
		j1261499089 -> j1337635753;
	j1435671718 [label="¿Un poco de la columna A, un poco de la columna B?",shape=box,color=red];
		j1435671718 -> j426645261;
	j3802580300 [label="Esto no tiene nada que ver contigo, Roathe. Nunca lo ha tenido.",shape=box,color=red];
		j3802580300 -> j903052351;
	j1471529079 [label="¡Idiota! ¿Qué has hecho? ¿Por qué, por qué te adentras en cavernas donde no eres bienvenido?",shape=box,color=blue];
		j1471529079 -> j3198627698;
	"Chat ends." [color=orange];
	j3984658869 [label="Check boolean RoatheDating",color=orange];
