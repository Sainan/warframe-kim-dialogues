		j385939529 -> j3843826241;
		j385939529 -> j1359418523;
	j2785698550 [label="Mm. Muy bien. Soy un demonio paciente, pero las aguas de ese pozo se secan con el tiempo, créeme.",shape=box,color=blue];
		j2785698550 -> "Chat ends.";
	j977646696 [label="Ya veo. Así de simple, ¿no?",shape=box,color=blue];
		j977646696 -> j431793363;
	j2795958498 [label="Mm. Asegúrate de hacerlo. Soy un demonio paciente, pero las aguas de ese pozo se secan con el tiempo, créeme.",shape=box,color=blue];
		j2795958498 -> "Chat ends.";
	j846207457 [label="¿Aunque eso signifique quedar atrapado en este punto muerto para siempre? Pobre, pobre Usurpador... muy bien. El purgatorio es mejor que el infierno para un demonio, ¿no?",shape=box,color=blue];
		j846207457 -> j2292722168;
	j935542570 [label="Bien. Ponte a trabajar. Estoy harto de vivir con esto en la cabeza.",shape=box,color=blue];
		j935542570 -> j378811769;
	j3805607510 [label="¿Pero qué más te da? Tienes todo lo que quieres arrancar de mi cadáver vacío. Mis costillas están desnudas y descoloridas.",shape=box,color=blue];
		j3805607510 -> j1776100240;
	j778077023 [label="Trágico, ¿verdad? ¿Saber que la escoria de la familia Entrati nunca sabrá que el mayordomo se pudre aquí, retorciéndose las manos de dolor? ¿Completamente solo?",shape=box,color=blue];
		j778077023 -> j1776100240;
	j3914091547 [label="Será tu única salida, si eso es lo que buscas. Si a ti no te importa, a mí tampoco. Haz lo que quieras.",shape=box,color=blue];
		j3914091547 -> j1022482413;
	j1500439384 [label="Líbrame de esto. Líbrame de esta plaga. Limpia mi mente de esos recuerdos. Sé que puedes. Usa este don que tienes y acaba con todo. Ahora.",shape=box,color=blue];
		j1500439384 -> j2596177082;
		j1500439384 -> j1493479983;
		j1500439384 -> j1482930318;
