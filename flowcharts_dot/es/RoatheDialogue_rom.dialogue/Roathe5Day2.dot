		j2171950327 -> j3805607510 [label=true,color=green];
		j2171950327 -> j778077023 [label=false,color=brown];
	j1337635753 [label="Lo que sea que quieras de mí, no lo conseguirás ahora. Será mejor que desistas y borres esta farsa de mi memoria.",shape=box,color=blue];
		j1337635753 -> j3914091547;
	j426645261 [label="Bueno, lo que sea que quieras de mí, no lo conseguirás ahora. Será mejor que desistas y borres esta farsa de mi memoria.",shape=box,color=blue];
		j426645261 -> j3914091547;
	j903052351 [label="Eso está bastante claro, no tienes por qué preocuparte.",shape=box,color=blue];
		j903052351 -> "Chat ends.";
	j3198627698 [label="Exijo que arregles esto. Es tu culpa. Puedo sentirlo, arañándome, desgarrándome... como una gran bestia.",shape=box,color=blue];
		j3198627698 -> j1500439384;
	j2836945802 [label="Sería de mala educación no reconocer que esto se debe a ti, cariño. Gracias.",shape=box,color=blue];
		j2836945802 -> j3810519479;
		j2836945802 -> j4033019482;
