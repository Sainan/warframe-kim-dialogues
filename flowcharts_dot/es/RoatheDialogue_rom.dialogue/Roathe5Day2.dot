	j3223352794 [label="También puedes despedirte de nuestro otro contrato.",shape=box,color=blue];
		j3223352794 -> j547790704;
		j3223352794 -> j2508242578;
	j1911579283 [label="Tenía muchas ganas de verlo temblar de terror mientras subía las escaleras avergonzado.",shape=box,color=blue];
		j1911579283 -> j3902721596;
		j1911579283 -> j2008308343;
	j563460298 [label="¿Y por qué te importa?",shape=box,color=blue];
		j563460298 -> j4083106162;
	j4147639545 [label="Puede ser. Probablemente tengas razón. Pero no tengo otra opción, ¿verdad? Vale la pena intentarlo.",shape=box,color=blue];
		j4147639545 -> j2878012652;
	j310086377 [label="Y si ese es el caso, puedes simplemente repetir la acción. Es como si tuvieras un don inagotable, ¿no?",shape=box,color=blue];
		j310086377 -> j2878012652;
	j4113919005 [label="Es muy probable. Ataré los cabos y te culparé por hacer algo que no te pedí. Estoy seguro de que capearás el temporal.",shape=box,color=blue];
		j4113919005 -> j2878012652;
	j1426733655 [label="Mm, sí, bueno. Sé cuánto disfrutas mi \"cola puntiaguda\". ",shape=box,color=blue];
		j1426733655 -> j2665556245;
	j854691263 [label="Simplemente quería expresar mi gratitud. No quería extenderme en el tema.",shape=box,color=blue];
