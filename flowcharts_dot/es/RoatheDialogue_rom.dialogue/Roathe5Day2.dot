	j2304586566 [label="Lo sé. Pero estas cosas llevan tiempo y hay que esperar.",shape=box,color=red];
		j2304586566 -> j2785698550;
	j1269964166 [label="Cambié de opinión. Lo siento.",shape=box,color=red];
		j1269964166 -> j977646696;
