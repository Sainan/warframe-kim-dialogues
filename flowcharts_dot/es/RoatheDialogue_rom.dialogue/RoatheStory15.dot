	j2592364220 [label="MV: MENTIRAS",shape=box,color=blue];
		j2592364220 -> j754215139;
	j754215139 [label="Transcripción: Yo era un experto en el manejo de muchas de nuestras armas, pero sobresalía en el uso de una: la mentira.",shape=box,color=blue];
		j754215139 -> j4134260904;
	j4134260904 [label="Lo usé con más frecuencia contra mis propias tropas. Los torturé hasta la médula con mentiras sobre el deber y la disciplina.",shape=box,color=blue];
		j4134260904 -> j2664774339;
	j2664774339 [label="Los sofoqué con la mentira de que la guerra podía ganarse. Los atravesé con la mentira de mi favor, mi más preciado aprecio por ellos.",shape=box,color=blue];
		j2664774339 -> j758304233;
	j758304233 [label="A solas, en privado, usé esa arma contra mí. Ah, cómo sangré.",shape=box,color=blue];
		j758304233 -> j1648694156;
	j1648694156 [label="Add 1 to HellStory counter",color=orange];
		j1648694156 -> "Chat ends. Next chat will be RoatheStory16.";
	"Chat ends. Next chat will be RoatheStory16." [color=orange];
