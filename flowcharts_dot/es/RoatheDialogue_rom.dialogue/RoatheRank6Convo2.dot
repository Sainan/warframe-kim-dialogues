		5588 -> 5591;
	5586 [label="I am certain there is a degree of something unfeigned to what you say. Or at the very least, I believe you do not know your own self-delusion.",shape=box,color=blue];
		5586 -> 5589;
	5590 [label="Honesty is a wonderful thing, Drifter dear. Do you think I would shame you for enjoying yourself? Hardly.",shape=box,color=blue];
