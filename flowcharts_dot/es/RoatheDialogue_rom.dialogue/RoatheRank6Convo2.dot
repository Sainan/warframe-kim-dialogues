		j535862451 -> j4018831723;
	j2994492678 [label="Por contrato, estoy obligado a perdonarte, pero no dice nada sobre dejar tu cara pegada a tu cráneo. Así que te aconsejo que tengas cuidado con tus palabras a medida que avanzamos.",shape=box,color=blue];
		j2994492678 -> j4056655655;
