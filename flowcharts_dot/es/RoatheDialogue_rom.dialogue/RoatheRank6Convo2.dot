	5591 [label="No. Surely you jest?",shape=box,color=blue];
		5591 -> 5594;
	5589 [label="I believe the greatest achievement of the Orokin Empire was its ability to convince those within it to believe their own conceits.",shape=box,color=blue];
		5589 -> 5592;
	5593 [label="Here is to a relationship of mutual satisfaction.",shape=box,color=blue];
		5593 -> 5596;
	5594 [label="But why make such an arrangement, unless...?",shape=box,color=blue];
		5594 -> 5597;
		5594 -> 5598;
	5592 [label="In fact, perhaps that is the true connective tissue of the human race: our masterful ability to look in the mirror and deceive ourselves.",shape=box,color=blue];
