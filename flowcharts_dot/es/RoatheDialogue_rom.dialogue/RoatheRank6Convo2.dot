	5614 [label="You must also understand that, until now, my love was a commodity that no one had sought to claim. Not in any meaningful way.",shape=box,color=blue];
		5614 -> 5615;
	5615 [label="So you seemed willing to sell your soul for a single bit of salvage. You can imagine my confusion. How baffled I was.",shape=box,color=blue];
		5615 -> 5616;
	5616 [label="Now? Now that I know the truth? Drifter, my Drifter... I could not be more glad that you did.",shape=box,color=blue];
		5616 -> 5617;
	5617 [label="Evaluate expressions",color=orange];
		5617 -> 5620 [label="RoatheVillain",color=purple];
		5617 -> 5619 [label="RoatheRedeemed",color=purple];
		5617 -> 5618 [label="false",color=purple];
	5620 [label="+10 Chemistry",color=orange];
		5620 -> 5623;
	5619 [label="+10 Chemistry",color=orange];
		5619 -> 5622;
	5618 [label="+5 Chemistry",color=orange];
		5618 -> 5621;
	5623 [label="For I cannot wait to see what we might together wreak upon this Origin System... and countless others.",shape=box,color=blue];
		5623 -> 3973;
	5622 [label="For together, what we are capable of boggles the mind, doesn't it?",shape=box,color=blue];
		5622 -> 3908;
	5621 [label="The future awaits us.",shape=box,color=blue];
		5621 -> 5624;
