	j1215105158 [label="Lo único más peligroso que un diablo... es un diablo con amigos como tú que le deben algo. Ahora, si me disculpas, tengo una \"Hermana de Sol\" flotante a quien molestar.",shape=box,color=blue];
		j1215105158 -> "Initiate conversation MarieRoatheRepair in /Lotus/Types/Gameplay/1999Wf/Dialogue/MarieDialogue_rom.dialogue";
	j2921080565 [label="Lo único más peligroso que un diablo... es un diablo con amigos como tú que le deben algo. Ahora, si me disculpas, tengo que molestar a un sacerdote loco.",shape=box,color=blue];
		j2921080565 -> "Initiate conversation LyonRoatheRepair in /Lotus/Types/Gameplay/1999Wf/Dialogue/LyonDialogue_rom.dialogue";
	j640950742 [label="Debo preguntar, sin embargo. ¿Por qué? ¿Por qué hacer un trato tan escandaloso? ¿Tanta curiosidad tienes por probar la carne orokin después de tantos siglos?",shape=box,color=blue];
		j640950742 -> j3857720484;
	j3857720484 [label="Evaluate expressions",color=orange];
		j3857720484 -> j328701487 [label="RoatheUnloved3",color=purple];
		j3857720484 -> j3979714372 [label="RoatheUnloved3",color=purple];
