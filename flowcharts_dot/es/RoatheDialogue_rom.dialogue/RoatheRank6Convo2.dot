		j3390208823 -> j4238361143;
	j2463141460 [label="Parece que lo has echado todo a perder, ¿verdad? ¡Madre mía, qué risa! Bueno, te aseguro que cuentas con mi colaboración, por muy reticente que sea.",shape=box,color=blue];
		j2463141460 -> j3702077246;
	j1626492499 [label="¿Cómo has podido fastidiarlos a ambos? Muy bien. Supongo que no tiene sentido quejarse ahora.",shape=box,color=blue];
		j1626492499 -> j3998619394;
	j3825156721 [label="Has logrado fastidiarnos a Marie y a mí. ¡Fantástico! Bueno, te aseguro que cuentas con mi cooperación, por reticente que sea.",shape=box,color=blue];
		j3825156721 -> j3273150160;
	j841115039 [label="Has logrado meter la pata conmigo y con Lyon. ¡Genial! Bueno, te aseguro que cuentas con mi cooperación, por reticente que sea.",shape=box,color=blue];
		j841115039 -> j575842520;
	j3522859284 [label="¿Parece que soy el único que se resiste? Bueno, eso lo simplifica bastante. Puedo asegurarle que cuenta con mi cooperación, por reticente que sea.",shape=box,color=blue];
		j3522859284 -> j2985115440;
