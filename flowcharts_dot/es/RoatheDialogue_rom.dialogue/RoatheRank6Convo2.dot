	j631673681 [label="Boolean RoatheVillain is now false.",color=orange];
		j631673681 -> "Chat ends.";
	j2071632080 [label="Entregaste tu alma al mismísimo diablo porque... sin saberlo, él ya tenía en sus manos tu corazón roto.",shape=box,color=blue];
		j2071632080 -> j1090457086;
	j1462622492 [label="No es que sepa nada sobre el tema.",shape=box,color=blue];
		j1462622492 -> j4081414586;
	j3305948067 [label="Como sabes, soy casi un experto en la materia.",shape=box,color=blue];
		j3305948067 -> j4081414586;
	j1090457086 [label="Viajero... mi pobre y dulce Viajero...",shape=box,color=blue];
		j1090457086 -> j2999940927;
	j4081414586 [label="+5 Chemistry",color=orange];
		j4081414586 -> "Chat ends.";
	j2999940927 [label="Perdóname. Por favor, perdóname. No lo sabía.",shape=box,color=blue];
		j2999940927 -> j778969851;
	j778969851 [label="También debes entender que, hasta ahora, mi amor era un bien que nadie había buscado reclamar. De ninguna manera significativa.",shape=box,color=blue];
		j778969851 -> j2095034835;
	j2095034835 [label="Así que te habías decidido a vender tu alma por un simple rescate. Puedes imaginar mi confusión. Lo desconcertado que estaba.",shape=box,color=blue];
		j2095034835 -> j1348271184;
	j1348271184 [label="¿Ahora? ¿Ahora que sé la verdad? Viajero, mi Viajero... Me alegro muchísimo de que lo supieras.",shape=box,color=blue];
		j1348271184 -> j2907313479;
