		j3857720484 -> j4069101319 [label="false",color=purple];
		j3857720484 -> j328701487 [label="false",color=purple];
	j328701487 [label="No quiero sonar superficial y vulgar pero… ¿te has visto en el espejo últimamente?",shape=box,color=red];
		j328701487 -> j482147058;
	j3979714372 [label="Roathe. Puede que no me creas, pero yo... te amo.",shape=box,color=red];
		j3979714372 -> j357364445;
	j4069101319 [label="Puede que no me creas, pero me preocupo por ti.",shape=box,color=red];
		j4069101319 -> j3895623411;
	j482147058 [label="+10 Chemistry",color=orange];
		j482147058 -> j744930979;
	j357364445 [label="¿Disculpa?",shape=box,color=blue];
		j357364445 -> j1539164955;
	j3895623411 [label="Estoy seguro de que hay algo de sinceridad en lo que dices. O, al menos, creo que desconoces tu propio engaño.",shape=box,color=blue];
		j3895623411 -> j2440573998;
	j744930979 [label="La honestidad es maravillosa, querido Viajero. ¿Crees que te juzgaría por divertirte? ¡Claro que no!",shape=box,color=blue];
		j744930979 -> j3810292756;
	j1539164955 [label="No. ¿Seguro que estás bromeando?",shape=box,color=blue];
		j1539164955 -> j1912734018;
	j2440573998 [label="Creo que el mayor logro del Imperio orokin fue su capacidad de convencer a quienes estaban dentro de él a creer en sus propias ideas.",shape=box,color=blue];
		j2440573998 -> j213418573;
	j3810292756 [label="Aquí se trata de una relación de satisfacción mutua.",shape=box,color=blue];
		j3810292756 -> j3921499284;
	j1912734018 [label="Pero ¿por qué hacer tal arreglo? A menos que...",shape=box,color=blue];
		j1912734018 -> j1859032634;
		j1912734018 -> j1705238029;
	j213418573 [label="De hecho, tal vez ese sea el verdadero tejido conectivo de la raza humana: nuestra magistral capacidad de mirarnos al espejo y engañarnos a nosotros mismos.",shape=box,color=blue];
		j213418573 -> j2387989230;
	j3921499284 [label="Boolean RoatheUnloved4 is now true.",color=orange];
		j3921499284 -> j2965571546;
	j1859032634 [label="La última vez lo arruiné. No podía volver a correr ese riesgo.",shape=box,color=red];
		j1859032634 -> j3637900096;
	j1705238029 [label="Hice el trato por desesperación, porque quería hacerlo bien. ",shape=box,color=red];
		j1705238029 -> j3637900096;
	j2387989230 [label="Todo en nombre de evitar la terrible vergüenza de admitir que necesitamos cambiar.",shape=box,color=blue];
		j2387989230 -> j3699244152;
