	"Chat ends." [color=orange];
	j552048827 [label="MV: COMISIÓN",shape=box,color=blue];
		j552048827 -> j3200163095;
	j3200163095 [label="Transcripción: Entre los Siete, yo era (o eso me dijeron) considerado juguete y concubino de Nitokh.",shape=box,color=blue];
		j3200163095 -> j861819981;
	j861819981 [label="En los primeros días de la guerra, me nombraron vicerregente Gran Carnus por provocación suya, pensando que era una broma.",shape=box,color=blue];
		j861819981 -> j742451612;
	j742451612 [label="¡Cuán rápido se convirtió su risa en aplausos solemnes mientras llevaba a casa la noticia de una victoria tras otra!",shape=box,color=blue];
		j742451612 -> j3861893807;
	j3861893807 [label="La sangre de hombres mejores me manchó como si fueran medallas. En secreto, acumulé armas para Nitokh.",shape=box,color=blue];
		j3861893807 -> j441925432;
	j441925432 [label="Fue fácil. Yo era una figura demasiado gloriosa como para que sospecharan de mí.",shape=box,color=blue];
		j441925432 -> j921430358;
	j921430358 [label="Add 1 to HellStory counter",color=orange];
		j921430358 -> "Chat ends.";
