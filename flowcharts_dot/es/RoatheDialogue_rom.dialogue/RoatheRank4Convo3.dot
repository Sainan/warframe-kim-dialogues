digraph {
	graph [fontname="Roboto Condensed"];
	node [fontname="Roboto Condensed"];
	edge [fontname="Roboto Condensed"];

	"RoatheRank4Convo3 begins." [color=orange];
		"RoatheRank4Convo3 begins." -> j1792271220;
	j1792271220 [label="Responde a esto, Usurpador: si la situación lo requiriera, ¿crees que podrías derrotar a tu homólogo tenno en una pelea a muerte?",shape=box,color=blue];
		j1792271220 -> j1904467837;
		j1792271220 -> j690021007;
		j1792271220 -> j202800200;
	j1904467837 [label="¿Qué? ¿Por qué...?",shape=box,color=red];
		j1904467837 -> j1375557882;
	j690021007 [label="No voy a tener esta conversación.",shape=box,color=red];
		j690021007 -> j3118155833;
	j202800200 [label="[Fin]",shape=box,color=red];
		j202800200 -> "Chat ends.";
	j1375557882 [label="Porque no sé si te habrás dado cuenta, pero \"Lotus\" no sólo es un consciente (y responsable de poner a Lua en el Vacío, cabe agregar), sino que también ha perdido cuantificablemente el control de sus circuitos.",shape=box,color=blue];
		j1375557882 -> j2052163928;
		j1375557882 -> j2471531630;
		j1375557882 -> j1869805459;
		j1375557882 -> j1844434369;
		j1375557882 -> j3312965737;
	j3118155833 [label="No pretendo ser grosero. Lo digo en serio, ¿sabes? Esta es una conversación puramente pragmática. ",shape=box,color=blue];
		j3118155833 -> j1375557882;
	"Chat ends." [color=orange];
	j2052163928 [label="Ella está bien. No sabes lo que dices.",shape=box,color=red];
		j2052163928 -> j2421742036;
	j2471531630 [label="¿Perdió el control de sus circuitos? ¿A qué te refieres?",shape=box,color=red];
		j2471531630 -> j2793498501;
	j1869805459 [label="No. No haré esto. Lotus me salvó la vida. Ha salvado la vida de los tenno incontables veces. Se lo debemos todo.",shape=box,color=red];
		j1869805459 -> j3760160696;
	j1844434369 [label="Cállate, Roathe, no voy a hacer esto. [Fin]",shape=box,color=red];
		j1844434369 -> j1440328869;
	j3312965737 [label="Lo sé, también me preocupa. Pero ella ha hecho tanto por nosotros y no puedo darle la espalda. Tengo que apoyarla.",shape=box,color=red];
		j3312965737 -> j1159363290;
	j2421742036 [label="¿Ah, no? ¡Presta atención! ¡Mira a tu alrededor! ¿Cuántos meses pasó al borde de un precipicio, con un localizador anticuado en la mano, tarareando para sí misma? ¿Con la mirada perdida en el Vacío?",shape=box,color=blue];
		j2421742036 -> j3115099686;
	j2793498501 [label="¿Cuántos meses pasó al borde de un precipicio, con un localizador anticuado en la mano, tarareando para sí misma? ¿Con la mirada perdida en el Vacío?",shape=box,color=blue];
		j2793498501 -> j3115099686;
	j3760160696 [label="No soy insensible. Entiendo cómo es. Le debes mucho. No te digo que la mates, te digo que dejes de permitir que influya en quienes te rodean.",shape=box,color=blue];
		j3760160696 -> j2793498501;
	j1440328869 [label="Como quieras. Pero cuando todo esto se derrumbe a tu alrededor, no vengas arrastrándote a pedirme ayuda.",shape=box,color=blue];
		j1440328869 -> "Chat ends.";
	j1159363290 [label="+5 Chemistry",color=orange];
		j1159363290 -> j1971652178;
	j3115099686 [label="¿Y ahora ella simplemente... acecha en la oscuridad? ¿Enviando a tu yo infantil cada vez más profundo a sus recuerdos, para qué? ¿Un camino a casa simplemente porque Albrecht chasqueó los dedos y susurró la palabra mágica?",shape=box,color=blue];
		j3115099686 -> j2109093481;
	j1971652178 [label="No soy insensible. Entiendo cómo es. Le debes mucho. No te digo que la mates, te digo que dejes de permitir que influya en quienes te rodean.",shape=box,color=blue];
		j1971652178 -> j3754146051;
	j2109093481 [label="¿No te parece sospechoso? ¿Peligroso? Es una trampa. Está siendo manipulada. Ya sea por Albrecht o por esta supuesta \"Indiferencia\". Es un programa defectuoso. Sus preceptos fallan.",shape=box,color=blue];
		j2109093481 -> j1123550629;
	j3754146051 [label="Cuando estaba allí, al borde del precipicio, con un localizador anticuado en la mano, tarareando para sí misma... mirando al Vacío... ¿No pensaste que iba a saltar?",shape=box,color=blue];
		j3754146051 -> j3115099686;
	j1123550629 [label="No creo que quiera hacerte daño. Creo que simplemente la están utilizando. Pero cuando llegue el momento, quizá tengas que defenderte. O quizá tengas que acabar con ellos.",shape=box,color=blue];
		j1123550629 -> j2175215093;
	j2175215093 [label="Y aunque es (espero) probable que veas la sensatez de evitar que una segunda ronda de Lotus se vuelva problemática, su ejército de niños salvajes no lo hará. Así que pregunto de nuevo:",shape=box,color=blue];
		j2175215093 -> j1457306947;
	j1457306947 [label="¿Quién crees que ganaría si llegara el terrible día y tuvieras que luchar con todos tus recursos? ¿Tú y todo lo que tienes contra todos los tenno y Lotus?",shape=box,color=blue];
		j1457306947 -> j3002635426;
		j1457306947 -> j368172743;
		j1457306947 -> j3850201970;
	j3002635426 [label="Esto es absurdo. No.",shape=box,color=red];
		j3002635426 -> j3323420095;
	j368172743 [label="Hay como... no sé, cien. Y uno de mí, Roathe.",shape=box,color=red];
		j368172743 -> j1495704407;
	j3850201970 [label="Ni siquiera sé por dónde empezar.",shape=box,color=red];
		j3850201970 -> j4249016355;
	j3323420095 [label="¡Considéralo un juego tonto si quieres! Un juego teórico para niños. ",shape=box,color=blue];
		j3323420095 -> j76282459;
		j3323420095 -> j3851213584;
	j1495704407 [label="+5 Chemistry",color=orange];
		j1495704407 -> j3302082831;
	j4249016355 [label="Entonces es muy bueno que estés hablando con el \"Diablo de Tau\". Hay una razón por la que se me conoce como estratega. Empecemos por lo básico: los números. Estás terriblemente superado en ese campo. ",shape=box,color=blue];
		j4249016355 -> j4181059854;
	j76282459 [label="Esto no es un juego.",shape=box,color=red];
		j76282459 -> j313533955;
	j3851213584 [label="¿Por última vez? No. [Fin]",shape=box,color=red];
		j3851213584 -> "Chat ends.";
	j3302082831 [label="Perfecto. Hemos establecido la primera regla para definir el campo de batalla: la cantidad. Obviamente, el número te supera con creces.",shape=box,color=blue];
		j3302082831 -> j4181059854;
	j4181059854 [label="Check boolean IsDating",color=orange];
		j4181059854 -> j2007492178 [label=true,color=green];
		j4181059854 -> j1275232376 [label=false,color=brown];
	j313533955 [label="Tienes razón. No lo es. Y algún día podría ser cuestión de vida o muerte. Tú contra tu... versión en miniatura. Y su manada de compañeros salvajes.",shape=box,color=blue];
		j313533955 -> j4068762356;
	j2007492178 [label="Sin embargo, si los rumores sobre tus \"actividades personales\" y tus amantes protoframes de otras líneas temporales pudieran ser... explotados, quizás esos recursos podrían ser invocados de alguna manera. El Helminto tendrá que ser estudiado y criado específicamente para este propósito...",shape=box,color=blue];
		j2007492178 -> j857366019;
	j1275232376 [label="He oído hablar de tus interacciones con otros protoframes en otras líneas temporales. Quizás esos recursos podrían invocarse de alguna manera. Habrá que investigar y criar Helmintos específicamente para este propósito...",shape=box,color=blue];
		j1275232376 -> j857366019;
	j4068762356 [label="Compañeros salvajes que, por cierto, ya han demostrado ser violentos, rebeldes y conocidos por expulsar cruelmente a los suyos por diferir demasiado de sus propias opiniones sobre la normalidad.",shape=box,color=blue];
		j4068762356 -> j820413516;
		j4068762356 -> j3604853039;
		j4068762356 -> j406267569;
	j857366019 [label="Ni siquiera sé si eso sea posible, pero nos proporcionó el pasaje hasta aquí, así que no veo por qué no...",shape=box,color=blue];
		j857366019 -> j2315403892;
		j857366019 -> j3514730446;
		j857366019 -> j2203113066;
	j820413516 [label="¿Ahora estás insinuando que los tenno son malvados?",shape=box,color=red];
		j820413516 -> j89897153;
	j3604853039 [label="¿Qué estás diciendo?",shape=box,color=red];
		j3604853039 -> j4239575303;
	j406267569 [label="No. Ya terminé. [Fin]",shape=box,color=red];
		j406267569 -> j2257592451;
	j2315403892 [label="¿Roathe? Vete al infierno.",shape=box,color=red];
		j2315403892 -> j1842348497;
	j3514730446 [label="No pienso arrastrarlos a este lío también.",shape=box,color=red];
		j3514730446 -> j1405083246;
	j2203113066 [label="Me preocupa ver cuánto has pensado sobre esto.",shape=box,color=red];
		j2203113066 -> j1539716981;
	j89897153 [label="No, malvados no. No creo en el \"mal\", Usurpador. Nunca lo he creído y nunca lo haré. Creo que los tenno son maravillosamente humanos, como todos los demás. Simplemente humanos. ¿Y además? Son niños.",shape=box,color=blue];
		j89897153 -> j1766705939;
	j4239575303 [label="Puede que llegue un momento, un día terrible, en el que tengas que estar preparado para hacer lo impensable.",shape=box,color=blue];
		j4239575303 -> j3797933675;
	j2257592451 [label="Huye de la conversación si quieres, pero sabes que cada palabra es verdad. Simplemente no quieres aceptarla.",shape=box,color=blue];
		j2257592451 -> "Chat ends.";
	j1842348497 [label="+5 Chemistry",color=orange];
		j1842348497 -> j2164270116;
	j1405083246 [label="¡Ah! Así que admites que hay un desastre. Eso es un avance. ¿Puedo al menos presentar mi argumento?",shape=box,color=blue];
		j1405083246 -> j508631979;
		j1405083246 -> j1076730004;
	j1539716981 [label="Y me alarma que no lo hayas hecho. ¿Puedo al menos explicar mi punto?",shape=box,color=blue];
		j1539716981 -> j508631979;
		j1539716981 -> j1076730004;
	j1766705939 [label="Niños a quienes se les ha encomendado la tarea de enfrentarse a horrores y cometer atrocidades similares a las que he visto, quebrantan a guerreros orokin adultos y endurecidos cuyas vidas han durado cientos de años.",shape=box,color=blue];
		j1766705939 -> j2985433458;
	j3797933675 [label="Los tenno son maravillosamente humanos, como todos los demás. Simplemente humanos. ¿Y además? Son niños.",shape=box,color=blue];
		j3797933675 -> j1766705939;
	j2164270116 [label="Ya estoy ahí, Usurpador. Ya estoy ahí.",shape=box,color=blue];
		j2164270116 -> j155006797;
	j508631979 [label="Okey. Claro. Adelante. Te escucho.",shape=box,color=red];
		j508631979 -> j3470110542;
	j1076730004 [label="No. Ya terminé.",shape=box,color=red];
		j1076730004 -> j2563882934;
	j2985433458 [label="He visto Dax, dorados, de élite, arrojar sus sagradas espadas doradas y huir del campo de batalla al que los tenno se habían apresurado con sus warframes.",shape=box,color=blue];
		j2985433458 -> j563460461;
	j155006797 [label="Boolean RoatheNoDate is now true.",color=orange];
		j155006797 -> "Chat ends.";
	j3470110542 [label="+5 Chemistry",color=orange];
		j3470110542 -> j2395061861;
	j2563882934 [label="Yo también.",shape=box,color=blue];
		j2563882934 -> "Chat ends.";
	j563460461 [label="Su aparente refugio infestado protegía sus cuerpos, pero no sus mentes. No tienen la culpa de ser como son.",shape=box,color=blue];
		j563460461 -> j634301672;
	j2395061861 [label="Gracias. Puede que llegue un momento, un día terrible, en el que tengas que estar preparado para hacer lo impensable.",shape=box,color=blue];
		j2395061861 -> j3797933675;
	j634301672 [label="Atormentados por el Vacío... obligados a asesinar o presenciar la muerte de sus propios padres... sometidos a la guerra... con sus recuerdos robados... perdidos en criosueño por siglos...",shape=box,color=blue];
		j634301672 -> j352011735;
	j352011735 [label="Que no sean unos lunáticos delirantes es un milagro, Usurpador. No digo que vaya a salir mal. Sólo digo que podría. Y que debes tener un plan por si ese día llega.",shape=box,color=blue];
		j352011735 -> j3587647392;
	j3587647392 [label="No hay nada de malo en estar preparado para lo peor. Lo peor sería no estarlo.",shape=box,color=blue];
		j3587647392 -> j3630601984;
		j3587647392 -> j3310842978;
		j3587647392 -> j3611817376;
		j3587647392 -> j3342466527;
	j3630601984 [label="Estaré... pendiente de todo. ¿De acuerdo? Pero no voy a actuar a espaldas de nadie.",shape=box,color=red];
		j3630601984 -> j3753352643;
	j3310842978 [label="Realmente detesto estar de acuerdo contigo en esto.",shape=box,color=red];
		j3310842978 -> j2936793178;
	j3611817376 [label="¿Te das cuenta de que sufrí tanto como los tenno, verdad?",shape=box,color=red];
		j3611817376 -> j894114478;
	j3342466527 [label="No estoy traicionando su confianza.",shape=box,color=red];
		j3342466527 -> j2564966063;
	j3753352643 [label="+5 Chemistry",color=orange];
		j3753352643 -> j3854849544;
	j2936793178 [label="+5 Chemistry",color=orange];
		j2936793178 -> j694235429;
	j894114478 [label="¿Y quién dice que no estoy teniendo estas mismas conversaciones con ellos?",shape=box,color=blue];
		j894114478 -> j2387523286;
	j2564966063 [label="Tampoco estaba sugiriendo que hicieras lo contrario.",shape=box,color=blue];
		j2564966063 -> j346357367;
	j3854849544 [label="¡Claro! Eso es todo lo que un diablo podría pedir, gracias.",shape=box,color=blue];
		j3854849544 -> j346357367;
	j694235429 [label="Mm. Sólo es la sensación de que la cordura regresa a tu cerebro después de todos estos años. Ya te acostumbrarás.",shape=box,color=blue];
		j694235429 -> j321621700;
	j2387523286 [label="Duerme bien, Usurpador. ",shape=box,color=blue];
		j2387523286 -> j321621700;
	j346357367 [label="Add 1 to Thermostat counter",color=orange];
		j346357367 -> "Chat ends.";
	j321621700 [label="Add -1 to Thermostat counter",color=orange];
		j321621700 -> "Chat ends.";
}