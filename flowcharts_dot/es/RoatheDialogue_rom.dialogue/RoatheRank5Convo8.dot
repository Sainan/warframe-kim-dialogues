	j3541711576 [label="Dentro de mí hay una bestia rabiosa impetuosa que me devora la caja torácica desde adentro.",shape=box,color=blue];
		j3541711576 -> j3660629763;
	j567076929 [label="Boolean RoatheRedeemed is now true.",color=orange];
		j567076929 -> j3713072624;
