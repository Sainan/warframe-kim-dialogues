	j1036844004 [label="Eso es lo único que te define ahora. Puedes cambiar. Y puedes cambiar el mundo que te rodea. Supongo que mi única pregunta es: ¿al menos lo intentarás?",shape=box,color=red];
		j1036844004 -> j4045051675;
	j2397981583 [label="Y la simple verdad es que eres uno de los pocos orokin que conocemos que sobrevivió a la Noche de los Tambores Naga. Desde mi punto de vista, fue una retirada estratégica.",shape=box,color=red];
		j2397981583 -> j1793018151;
	j2376480983 [label="Intenta perdonarte a ti mismo y... ¿sigue adelante?",shape=box,color=red];
		j2376480983 -> j1175207215;
	j65240790 [label="Y la simple verdad es que eres uno de los pocos orokin que conocemos que sobrevivió a la Noche de los Tambores Naga. Desde mi punto de vista, fue una retirada estratégica.",shape=box,color=red];
		j65240790 -> j2164316237;
