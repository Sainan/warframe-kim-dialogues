digraph {
	5151 [label="RoatheRank5Convo8 begins.",color=orange];
		5151 -> 5152;
	5152 [label="Check boolean RoatheFailNot21",color=orange];
		5152 -> 5154 [label=true,color=green];
		5152 -> 5153 [label=false,color=brown];
	5154 [label="Evaluate expressions on HellStory",color=orange];
		5154 -> 5155 [label="x >= 21",color=purple];
		5154 -> 5156 [label="x <= 21",color=purple];
		5154 -> 5156 [label="false",color=purple];
	5153 [label="Chat ends.",color=orange];
	5155 [label="You fool! What have you done?! Why, why go and delve into caverns where you are not welcome?!",shape=box,color=blue];
		5155 -> 5157;
	5156 [label="Chat ends.",color=orange];
	5157 [label="I demand you fix this. This is your fault. I can feel it, clawing at me, tearing at me. Like some great beast.",shape=box,color=blue];
		5157 -> 5158;
	5158 [label="Rid me of this. Rid me of this plague. Clear my mind of these memories. I know you can. Use this gift that you have and end it all. Now.",shape=box,color=blue];
		5158 -> 5159;
		5158 -> 5160;
		5158 -> 5161;
	5159 [label="Are you sure? But... you're smart, I get the feeling you'll figure something is up.",shape=box,color=red];
		5159 -> 5162;
	5160 [label="Those are a different kind of memory, Roathe. It won't work on them. They are buried deeper in your psyche.",shape=box,color=red];
		5160 -> 5163;
	5161 [label="Running and hiding from the truth won't work. We'll just wind up right back where we started. ",shape=box,color=red];
		5161 -> 5164;
	5162 [label="Very likely. I will put two and two together and blame you for doing something I did not ask you to do. I am sure you will weather the storm.",shape=box,color=blue];
		5162 -> 5165;
	5163 [label="That may be. You are very likely right. But I do not have any other options to try, now do I? It is worth the attempt.",shape=box,color=blue];
		5163 -> 5165;
	5164 [label="And if that is the case, then you can simply do the deed again. It is like you have an inexhaustible gift, isn't it?",shape=box,color=blue];
		5164 -> 5165;
	5165 [label="I am certain I will be hideously angry at you once I realize you have altered my memories, of course. And I recommend not telling me it was by my request, darling.",shape=box,color=blue];
		5165 -> 5166;
	5166 [label="I will simply claim you are lying, and it will likely damage my opinion of you beyond repair.",shape=box,color=blue];
		5166 -> 5167;
		5166 -> 5168;
	5167 [label="No. I can't do this. I won't do this. We have to face down this situation together. Can't we just talk about this?",shape=box,color=red];
		5167 -> 5169;
	5168 [label="I... there's really no other way?",shape=box,color=red];
		5168 -> 5169;
	5169 [label="No. If you want the butler to go upstairs? You wipe my mind of all of this nonsense as I have asked. If you do not care? Then do as you wish. It matters not to me.",shape=box,color=blue];
		5169 -> 5170;
	5170 [label="That, and, well, of course, our personal friendship is the only leverage I own in this situation. It is that simple.",shape=box,color=blue];
		5170 -> 5171;
	5171 [label="What say you?",shape=box,color=blue];
		5171 -> 5172;
		5171 -> 5173;
	5172 [label="Okay. I'll... I'll do it. I'll wipe your mind. Even if it'll take Marie and Lyon's with it.",shape=box,color=red];
		5172 -> 5174;
	5173 [label="No. I refuse. I'll find another way to convince you to move forward.",shape=box,color=red];
		5173 -> 5175;
	5174 [label="+10 Chemistry",color=orange];
		5174 -> 5176;
	5175 [label="I wish you the best of luck.",shape=box,color=blue];
		5175 -> 5179;
	5176 [label="Good. Get to it. ",shape=box,color=blue];
		5176 -> 5178;
	5179 [label="Update boolean LyonRoatheRepair",color=orange];
		5179 -> 5177;
	5178 [label="Add 1 to Promise",color=orange];
		5178 -> 5180;
	5177 [label="Chat ends.",color=orange];
	5180 [label="Update boolean RoatheWillReset",color=orange];
		5180 -> 5181;
