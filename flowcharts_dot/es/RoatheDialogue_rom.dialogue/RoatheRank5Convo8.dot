	"RoatheRank5Convo8 begins." [color=orange];
		"RoatheRank5Convo8 begins." -> j4125803273;
	j4125803273 [label="Check boolean RoatheFailNot21",color=orange];
		j4125803273 -> j1758133089 [label=true,color=green];
		j4125803273 -> "Chat ends." [label=false,color=brown];
	j1758133089 [label="Evaluate expressions on HellStory counter",color=orange];
		j1758133089 -> j1952503442 [label="x >= 21",color=purple];
		j1758133089 -> "Chat ends." [label="x <= 21",color=purple];
		j1758133089 -> "Chat ends." [label="false",color=purple];
	"Chat ends." [color=orange];
	j1952503442 [label="¡Idiota! ¿Qué has hecho? ¿Por qué, por qué te adentras en cavernas donde no eres bienvenido?",shape=box,color=blue];
		j1952503442 -> j3499107407;
	j3499107407 [label="Exijo que arregles esto. Es tu culpa. Puedo sentirlo, arañándome, desgarrándome... como una gran bestia.",shape=box,color=blue];
		j3499107407 -> j2760621283;
	j2760621283 [label="Líbrame de esto. Líbrame de esta plaga. Limpia mi mente de esos recuerdos. Sé que puedes. Usa este don que tienes y acaba con todo. Ahora.",shape=box,color=blue];
		j2760621283 -> j3141573534;
		j2760621283 -> j3929823144;
		j2760621283 -> j1322307255;
	j3141573534 [label="¿Estás seguro? Pero... eres listo, me da la impresión de que te darás cuenta de que algo pasa.",shape=box,color=red];
		j3141573534 -> j2121291338;
	j3929823144 [label="Esos son recuerdos diferentes, Roathe. No funcionará con ellos. Están enterrados más profundamente en tu psique.",shape=box,color=red];
		j3929823144 -> j2664503061;
	j1322307255 [label="Huir y esconderse de la verdad no funcionará. Volveremos al punto de partida. ",shape=box,color=red];
		j1322307255 -> j816620179;
	j2121291338 [label="Es muy probable. Ataré los cabos y te culparé por hacer algo que no te pedí. Estoy seguro de que capearás el temporal.",shape=box,color=blue];
		j2121291338 -> j459319827;
	j2664503061 [label="Puede ser. Probablemente tengas razón. Pero no tengo otra opción, ¿verdad? Vale la pena intentarlo.",shape=box,color=blue];
		j2664503061 -> j459319827;
	j816620179 [label="Y si ese es el caso, puedes simplemente repetir la acción. Es como si tuvieras un don inagotable, ¿no?",shape=box,color=blue];
		j816620179 -> j459319827;
	j459319827 [label="Estoy seguro de que me enojaré muchísimo contigo cuando me dé cuenta de que has alterado mis recuerdos, claro. Y te recomiendo que no me digas que fue por petición mía, cariño.",shape=box,color=blue];
		j459319827 -> j1642058663;
	j1642058663 [label="Simplemente diré que estás mintiendo y probablemente eso dañará mi opinión sobre ti.",shape=box,color=blue];
		j1642058663 -> j2297530927;
		j1642058663 -> j2164733868;
	j2297530927 [label="No. No puedo. No lo haré. Tenemos que afrontar esta situación juntos. ¿No podemos simplemente hablar de esto?",shape=box,color=red];
		j2297530927 -> j1856649007;
	j2164733868 [label="Yo... ¿realmente no hay otra manera?",shape=box,color=red];
		j2164733868 -> j1856649007;
	j1856649007 [label="No. ¿Quieres que el mayordomo suba? Bórrame todas estas tonterías, como te lo pedí. ¿Y si no te importa? Haz lo que quieras. A mí me da igual.",shape=box,color=blue];
		j1856649007 -> j2239581184;
	j2239581184 [label="Eso, y, claro, nuestra amistad personal es mi única ventaja en esta situación. Así de simple.",shape=box,color=blue];
		j2239581184 -> j386342223;
	j386342223 [label="¿Qué dices?",shape=box,color=blue];
		j386342223 -> j1238798982;
		j386342223 -> j2406066284;
	j1238798982 [label="Está bien. Lo haré. Te borraré la memoria. Aunque eso también se lleve a Marie y a Lyon.",shape=box,color=red];
		j1238798982 -> j3323283154;
	j2406066284 [label="No. Me niego. Encontraré otra forma de convencerte de seguir adelante.",shape=box,color=red];
		j2406066284 -> j2890529995;
	j3323283154 [label="+10 Chemistry",color=orange];
		j3323283154 -> j2469508792;
	j2890529995 [label="Te deseo mucha suerte.",shape=box,color=blue];
		j2890529995 -> "Initiate conversation LyonRoatheFail in /Lotus/Types/Gameplay/1999Wf/Dialogue/LyonDialogue_rom.dialogue";
	j2469508792 [label="Bien. Adelante. ",shape=box,color=blue];
		j2469508792 -> j4072107213;
	"Initiate conversation LyonRoatheFail in /Lotus/Types/Gameplay/1999Wf/Dialogue/LyonDialogue_rom.dialogue" [label="Initiate conversation LyonRoatheFail in /Lotus/Types/Gameplay/1999Wf/Dialogue/LyonDialogue_rom.dialogue",color=orange];
		"Initiate conversation LyonRoatheFail in /Lotus/Types/Gameplay/1999Wf/Dialogue/LyonDialogue_rom.dialogue" -> "Chat ends.";
	j4072107213 [label="Add 1 to Promise counter",color=orange];
		j4072107213 -> j302033967;
	j302033967 [label="Boolean RoatheWillReset is now true.",color=orange];
		j302033967 -> "Chat ends.";
}