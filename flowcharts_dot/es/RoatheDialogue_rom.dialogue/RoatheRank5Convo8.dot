	"Chat ends." [color=orange];
	j187269235 [label="¡Idiota! ¿Qué has hecho? ¿Por qué, por qué te adentras en cavernas donde no eres bienvenido?",shape=box,color=blue];
		j187269235 -> j2547357836;
	j2547357836 [label="Boolean RoatheFailNot21 is now false.",color=orange];
		j2547357836 -> j3499107407;
	j3499107407 [label="Exijo que arregles esto. Es tu culpa. Puedo sentirlo, arañándome, desgarrándome... como una gran bestia.",shape=box,color=blue];
		j3499107407 -> j2760621283;
	j2760621283 [label="Líbrame de esto. Líbrame de esta plaga. Limpia mi mente de esos recuerdos. Sé que puedes. Usa este don que tienes y acaba con todo. Ahora.",shape=box,color=blue];
		j2760621283 -> j3141573534;
		j2760621283 -> j3929823144;
		j2760621283 -> j1322307255;
	j3141573534 [label="¿Estás seguro? Pero... eres listo, me da la impresión de que te darás cuenta de que algo pasa.",shape=box,color=red];
		j3141573534 -> j2121291338;
	j3929823144 [label="Esos son recuerdos diferentes, Roathe. No funcionará con ellos. Están enterrados más profundamente en tu psique.",shape=box,color=red];
		j3929823144 -> j2664503061;
	j1322307255 [label="Huir y esconderse de la verdad no funcionará. Volveremos al punto de partida. ",shape=box,color=red];
		j1322307255 -> j816620179;
	j2121291338 [label="Es muy probable. Ataré los cabos y te culparé por hacer algo que no te pedí. Estoy seguro de que capearás el temporal.",shape=box,color=blue];
		j2121291338 -> j459319827;
	j2664503061 [label="Puede ser. Probablemente tengas razón. Pero no tengo otra opción, ¿verdad? Vale la pena intentarlo.",shape=box,color=blue];
		j2664503061 -> j459319827;
	j816620179 [label="Y si ese es el caso, puedes simplemente repetir la acción. Es como si tuvieras un don inagotable, ¿no?",shape=box,color=blue];
		j816620179 -> j459319827;
	j459319827 [label="Estoy seguro de que me enojaré muchísimo contigo cuando me dé cuenta de que has alterado mis recuerdos, claro. Y te recomiendo que no me digas que fue por petición mía, cariño.",shape=box,color=blue];
		j459319827 -> j1642058663;
	j1642058663 [label="Simplemente diré que estás mintiendo y probablemente eso dañará mi opinión sobre ti.",shape=box,color=blue];
		j1642058663 -> j2297530927;
		j1642058663 -> j2164733868;
	j2297530927 [label="No. No puedo. No lo haré. Tenemos que afrontar esta situación juntos. ¿No podemos simplemente hablar de esto?",shape=box,color=red];
		j2297530927 -> j1856649007;
	j2164733868 [label="Yo... ¿realmente no hay otra manera?",shape=box,color=red];
		j2164733868 -> j1856649007;
	j1856649007 [label="No. ¿Quieres que el mayordomo suba? Bórrame todas estas tonterías, como te lo pedí. ¿Y si no te importa? Haz lo que quieras. A mí me da igual.",shape=box,color=blue];
		j1856649007 -> j2239581184;
	j2239581184 [label="Eso, y, claro, nuestra amistad personal es mi única ventaja en esta situación. Así de simple.",shape=box,color=blue];
		j2239581184 -> j386342223;
	j386342223 [label="¿Qué dices?",shape=box,color=blue];
		j386342223 -> j1238798982;
		j386342223 -> j3305976933;
	j1238798982 [label="Está bien. Lo haré. Te borraré la memoria. Aunque eso también se lleve a Marie y a Lyon.",shape=box,color=red];
		j1238798982 -> j3323283154;
	j3305976933 [label="No. Me niego. Lo siento. Tenemos que afrontarlo.",shape=box,color=red];
		j3305976933 -> j1526608263;
		j3305976933 -> j4020372137;
	j3323283154 [label="+10 Chemistry",color=orange];
		j3323283154 -> j2469508792;
	j1526608263 [label="Hablemos de esto.",shape=box,color=red];
		j1526608263 -> j3202040798;
	j4020372137 [label="Ódiame si quieres. Pero no haré nada hasta que resolvamos esto primero.",shape=box,color=red];
		j4020372137 -> j3583683519;
	j2469508792 [label="Bien. Adelante. ",shape=box,color=blue];
		j2469508792 -> j4072107213;
	j3202040798 [label="¡No te atrevas! ¡No te atrevas a decirme que me \"calme\"! ¿No crees que tengo todo el derecho a sentirme como si me estuvieran partiendo en dos?",shape=box,color=blue];
		j3202040798 -> j208828236;
	j3583683519 [label="Fascinante. Fascinante e inesperado. Explícate.",shape=box,color=blue];
		j3583683519 -> j1711861270;
		j3583683519 -> j1616206432;
	j4072107213 [label="Add 1 to Promise counter",color=orange];
		j4072107213 -> j302033967;
	j208828236 [label="Siento como si la comprensión de mí mismo, la base misma de mis cimientos, se hubiera agrietado y desgarrado como la maldita Lua misma. Reescrito con tinta. ¡Cobarde!",shape=box,color=blue];
		j208828236 -> j751973187;
	j1711861270 [label="Hice lo que hice porque tenía que pasar. Ya no podías esconderte de esto.",shape=box,color=red];
		j1711861270 -> j1830055178;
	j1616206432 [label="Piensa de mí lo que quieras. Pero reconozco una espiral cuando la veo.",shape=box,color=red];
		j1616206432 -> j2238929766;
	j302033967 [label="Boolean RoatheWillReset is now true.",color=orange];
		j302033967 -> "Chat ends.";
	j751973187 [label="¿Y te atreves a decirme que me \"calme\"?",shape=box,color=blue];
		j751973187 -> j1830055178;
	j1830055178 [label="Evaluate expressions",color=orange];
		j1830055178 -> j2226333508 [label="RoatheForgivenessShortcut",color=purple];
		j1830055178 -> j1590484746 [label="RoatheVillainyShortcut",color=purple];
		j1830055178 -> j2318547072 [label="false",color=purple];
	j2238929766 [label="Sí, creo que sabes de esas cosas, ¿verdad? Adelante.",shape=box,color=blue];
		j2238929766 -> j14178037;
		j2238929766 -> j1778453237;
	j2226333508 [label="Enojarse no solucionará nada, Roathe. Estás enojado porque tienes miedo de enfrentar lo que hiciste. Y en lo que te has convertido.",shape=box,color=red];
		j2226333508 -> j2178340925;
	j1590484746 [label="Bien. Enójate. Pero usa esa ira para algo que valga la pena. Úsala para liberarte de todo ese odio que llevas dentro y que proyectas en la dirección equivocada.",shape=box,color=red];
		j1590484746 -> j2997316551;
	j2318547072 [label="Evaluate expressions on Thermostat counter",color=orange];
		j2318547072 -> j2226333508 [label="x >= 5",color=purple];
		j2318547072 -> j1590484746 [label="x <= 0",color=purple];
		j2318547072 -> j881423997 [label="x > 0 && x < 5",color=purple];
		j2318547072 -> j881423997 [label="false",color=purple];
	j14178037 [label="Si deseas buscar el perdón, puedes hacerlo. Pero necesitas desearlo. Necesitas elegir ese camino. Nadie más puede hacerlo por ti.",shape=box,color=red];
		j14178037 -> j4225900087;
	j1778453237 [label="Si quieres elegir abrirte un camino por tu cuenta para ti mismo, hazlo. No te disculpes. Pero esa elección es tuya, de nadie más.",shape=box,color=red];
		j1778453237 -> j1310727024;
	j2178340925 [label="Estás dejando que esa ira te desgarre por dentro. Podrías usarla para ayudarte a luchar contra quienes siguen destruyendo este mundo hoy. Aquí. Ahora.",shape=box,color=red];
		j2178340925 -> j1127541082;
	j2997316551 [label="Lo estás dirigiendo a ti mismo. Deberías dirigirlo al mundo que te culpa por hacer todo lo posible para salvarlo del Imperio orokin.",shape=box,color=red];
		j2997316551 -> j3301415669;
	j881423997 [label="Ojalá supiera cómo ayudarte. Ojalá supiera qué decir. Parece que estás dividido en dos direcciones. ¿Qué camino quieres tomar?",shape=box,color=red];
		j881423997 -> j1704424119;
	j4225900087 [label="Tu pasado no te define, Roathe. Te define tu futuro. Y aún tienes un futuro por delante, a diferencia de todos los orokin que murieron en la Noche de los Tambores Naga.",shape=box,color=red];
		j4225900087 -> j1036844004;
	j1310727024 [label="No te definen las opiniones de quienes te rodean ni lo que piensan de tus acciones. Sólo te define lo que piensas de ti mismo y de tus decisiones.",shape=box,color=red];
		j1310727024 -> j2397981583;
	j1127541082 [label="Eso es lo único que te define ahora. Puedes cambiar. Y puedes cambiar el mundo que te rodea. Supongo que mi única pregunta es: ¿al menos lo intentarás?",shape=box,color=red];
		j1127541082 -> j2376480983;
	j3301415669 [label="No te definen las opiniones de quienes te rodean ni lo que piensan de tus acciones. Sólo te define lo que piensas de ti mismo y de tus decisiones.",shape=box,color=red];
		j3301415669 -> j65240790;
