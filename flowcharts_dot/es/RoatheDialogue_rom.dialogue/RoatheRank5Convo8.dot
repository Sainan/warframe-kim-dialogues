	j3533573292 [label="No. Sé lo que vas a preguntar y la respuesta es no.",shape=box,color=red];
		j3533573292 -> j3289994442;
	"Chat ends. Next chat will be Roathe5Day2." [color=orange];
	j773714109 [label="Tienes un don. Un don que puede deshacer el tiempo. Volverlo espiral o incluso un bucle. Y esto tiene... un efecto interesante en las mentes de los protoframes, por su apego a la Infestación y su apego al tiempo.",shape=box,color=blue];
		j773714109 -> j2353677252;
	j3289994442 [label="Si puedes decirme que nunca has usado tus dones para jugar con las mentes de los protoframes a quienes llamas amigos y amantes, ¿puedes decirlo sin mentira en tu alma?",shape=box,color=blue];
		j3289994442 -> j2122115014;
	j2353677252 [label="Y, por lo tanto, nuestro apego al tiempo. Te pido ahora. No, te suplico, que lo uses ahora en mi nombre. Aleja de mí estos pensamientos. Aleja de mí estos recuerdos.",shape=box,color=blue];
		j2353677252 -> j3723067394;
	j2122115014 [label="Pues muy bien. Que así sea. No te lo pediré ahora. Pero ¿y si nunca lo has hecho por diversión, curiosidad o para intentar corregir errores cometidos en el trato con los demás?",shape=box,color=blue];
		j2122115014 -> j3723067394;
