	j1858452237 [label="+20 Chemistry",color=orange];
		j1858452237 -> j1476437434;
	j202526979 [label="Pero hay una solución, ¿no? Tienes el poder de arreglar esto... esta horrible agonía que siento en mi mente.",shape=box,color=blue];
		j202526979 -> j3112379578;
	j2171699315 [label="Muy bien. Acepto tu argumento. Gracias, Viajero, por... convencerme de no caer en esta trampa.",shape=box,color=blue];
		j2171699315 -> j2333310991;
	j1580210292 [label="Aunque dudo un poco de tu replanteamiento de la situación, estoy... demasiado tentado por este nuevo futuro y lo que podría significar para mí como para resistirlo, Usurpador. Viajero.",shape=box,color=blue];
		j1580210292 -> j510526787;
	j1476437434 [label="Una retirada para ganar la guerra. Hm.",shape=box,color=blue];
		j1476437434 -> j1953930833;
	j3112379578 [label="Usurpador. Viajero. Te lo ruego. De hecho, creo que es la única manera de avanzar, ¿no? También es por tu propio bien.",shape=box,color=blue];
		j3112379578 -> j674747643;
	j2333310991 [label="Te lo agradezco. Más de lo que te imaginas.",shape=box,color=blue];
		j2333310991 -> j3413053419;
	j510526787 [label="Esta \"nueva oportunidad\" en mi vida. Muy bien. Acepto tu argumento. Gracias, Viajero, por... disuadirme de correr este riesgo.",shape=box,color=blue];
		j510526787 -> j2333310991;
	j1953930833 [label="Aunque tengo algunas dudas sobre tu reformulación de los acontecimientos como una retirada táctica, admito que estoy a favor, de todos modos, Usurpador. Viajero.",shape=box,color=blue];
		j1953930833 -> j2171699315;
	j674747643 [label="Si alguna vez deseas que el mayordomo suba y se reconcilie con la familia Entrati, debes hacer lo que te digo. Debes hacerlo.",shape=box,color=blue];
		j674747643 -> j983963037;
		j674747643 -> j3533573292;
	j3413053419 [label="Debo irme. Tengo ganas de beber mucho alcohol y mirar fijamente hacia el horizonte.",shape=box,color=blue];
		j3413053419 -> "Chat ends. Next chat will be Roathe5Day2.";
	j983963037 [label="¿Y eso sería...? ",shape=box,color=red];
