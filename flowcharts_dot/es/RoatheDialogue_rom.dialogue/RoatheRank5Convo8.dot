	j84115808 [label="+20 Chemistry",color=orange];
		j84115808 -> j526640782;
	j741418441 [label="Boolean RoatheVillain is now true.",color=orange];
		j741418441 -> j1858452237;
	j3660629763 [label="Y no sé cómo saciarlo. No sé si puedo. Esperaba que estas conversaciones me mostraran la manera, pero ahora veo que es inútil.",shape=box,color=blue];
		j3660629763 -> j202526979;
	j3713072624 [label="+20 Chemistry",color=orange];
		j3713072624 -> j2171699315;
