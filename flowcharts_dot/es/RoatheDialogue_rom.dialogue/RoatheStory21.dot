	j3169134751 [label="MV: OLVIDO",shape=box,color=blue];
		j3169134751 -> j3506534434;
	j3506534434 [label="Transcripción: Cobarde.",shape=box,color=blue];
		j3506534434 -> j840118200;
	j840118200 [label="Así me llamaban, ¿verdad? He leído los libros de historia esparcidos por este polvoriento salón. Mentira. No sabían la verdad. Que me arrebataron de mi tiempo antes de poder completar mi obra.",shape=box,color=blue];
		j840118200 -> j2002790687;
	j2002790687 [label="Cobarde.",shape=box,color=blue];
		j2002790687 -> j2510675519;
	j2510675519 [label="Ahora lo recuerdo. Se me acercó en los Salones Dorados. Tenía un rostro que no conocía. Pero eso no es tan inusual en nuestra especie. Conocía su voz. Conocía su forma de moverse.",shape=box,color=blue];
		j2510675519 -> j55232055;
	j55232055 [label="¡Cobarde!",shape=box,color=blue];
		j55232055 -> j348777703;
	j348777703 [label="Me hizo una sola pregunta. Que si en verdad creía que algún día me perdonarían por reducirlo todo a cenizas.",shape=box,color=blue];
		j348777703 -> j458125535;
	j458125535 [label="¡COBARDE!",shape=box,color=blue];
		j458125535 -> j3980027663;
	j3980027663 [label="Una jeringa… en esa mano pálida y extendida. Brillando con libertad… otra oportunidad… otra vida.",shape=box,color=blue];
		j3980027663 -> j3406720846;
	j3406720846 [label="Lo tomé.",shape=box,color=blue];
		j3406720846 -> j2096166664;
	j2096166664 [label="¡COBARDE!",shape=box,color=blue];
		j2096166664 -> j921430358;
	j921430358 [label="Add 1 to HellStory counter",color=orange];
