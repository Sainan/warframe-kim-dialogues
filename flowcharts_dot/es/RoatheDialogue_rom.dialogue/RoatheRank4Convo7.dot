	j4023896373 [label="Usurpador, me complace decirte que tu trabajo en la Oscuridad Refractaria ha terminado y puedes dejar de desenterrar mis recuerdos.",shape=box,color=blue];
		j4023896373 -> j1900808369;
	j551719261 [label="Usurpador, aunque todavía queda algo de trabajo por hacer en la Oscuridad Refractaria en lo que respecta a recuperar mis recuerdos, me complace anunciar que creo que he terminado con todo este maldito asunto.",shape=box,color=blue];
		j551719261 -> j3125828806;
	j688512968 [label="Usurpador, aunque honestamente has sido... negligente al comenzar cualquier trabajo en la Oscuridad Refractaria, me complace anunciar que creo que he terminado con todo este maldito asunto.",shape=box,color=blue];
		j688512968 -> j2688954163;
	j2933993397 [label="Si bien puedes sentir que se te debe tanto un agradecimiento como una disculpa por lo sucedido, mi pedido de borrar mis recuerdos y comenzar de nuevo, creo que nos deja \"a mano\" por todo el dolor que he sufrido como resultado.",shape=box,color=blue];
		j2933993397 -> j1113319252;
		j2933993397 -> j540894459;
	j2002674407 [label="Se siente tan vacío, todo este afán desesperado. Supongo que solo tú lo sabrías. Bueno. Veamos el proceso, ¿sí?",shape=box,color=blue];
		j2002674407 -> j1113319252;
		j2002674407 -> j876978650;
	j2665987957 [label="Usurpador, tengo una petición difícil para ti. Una petición que no me complace. Sé que al menos me deseas, y espero que haya un lugar para mí en tu corazón...",shape=box,color=blue];
		j2665987957 -> j3247285180;
		j2665987957 -> j3381746263;
		j2665987957 -> j206698634;
	j1658077194 [label="Usurpador, tengo una petición difícil para ti. Una petición que no me complace. Pero primero, preguntaré... ¿nos hemos hecho amigos? ¿Hay algún lugar en tu corazón que haya llegado a pensar en mí con cariño?",shape=box,color=blue];
		j1658077194 -> j2622509578;
		j1658077194 -> j661678738;
		j1658077194 -> j1367161436;
	j1900808369 [label="Podemos dejar de obsesionarnos con mi mente y someternos a esta flagelación ficticia, ¿no? (Aunque al sacerdote le gusten ese tipo de cosas).",shape=box,color=blue];
		j1900808369 -> j745110122;
	j3125828806 [label="Podemos dejar de perder el tiempo en mi mente y someternos a esta flagelación ficticia, ¿no? (Aunque al sacerdote le gusten ese tipo de cosas).",shape=box,color=blue];
		j3125828806 -> j745110122;
	j2688954163 [label="Olvídate de todo. Seguro que tienes mejores cosas que hacer que esa flagelación ficticia, ¿no? (Aunque al sacerdote le gusten ese tipo de cosas).",shape=box,color=blue];
		j2688954163 -> j3077456970;
	j1113319252 [label="Vamos a superar esto. ",shape=box,color=red];
		j1113319252 -> j3836410337;
	j540894459 [label="Sólo lo hice porque me lo pediste, Roathe. Me advertiste que te enojarías. ",shape=box,color=red];
		j540894459 -> j1103460231;
	j876978650 [label="Ya casi estamos allí, como dijiste.",shape=box,color=red];
		j876978650 -> j2093146739;
	j3247285180 [label="Me importas, Roathe. Si debería o no, es discutible.",shape=box,color=red];
		j3247285180 -> j2800477776;
	j3381746263 [label="Cambié de opinión sobre todo eso después de conocerte mejor. No te soporto.",shape=box,color=red];
		j3381746263 -> j282197638;
	j206698634 [label="Me importas mucho, Roathe. De verdad. No sé si debería, pero... creo que me estoy enamorando de ti.",shape=box,color=red];
		j206698634 -> j2595047833;
	j2622509578 [label="Es... un poco más que eso. [Confiesa tus sentimientos]",shape=box,color=red];
		j2622509578 -> j134191374;
	j661678738 [label="Me gustaría pensar que somos amigos. Al menos desde mi perspectiva.",shape=box,color=red];
		j661678738 -> j1335501090;
	j1367161436 [label="Honestamente, Roathe... no te soporto.",shape=box,color=red];
		j1367161436 -> j4018598654;
	j745110122 [label="De hecho, insistiría firmemente en que lo hiciéramos.",shape=box,color=blue];
		j745110122 -> j3703058924;
