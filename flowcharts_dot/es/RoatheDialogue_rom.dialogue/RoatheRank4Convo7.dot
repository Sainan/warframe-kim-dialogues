		j3836410337 -> j298080266;
	j1103460231 [label="Sí. Supongo que sí. Y supongo que tenía razón. Bueno, mañana será otro día y quizá se sienta como si fuera ayer.",shape=box,color=blue];
		j1103460231 -> j298080266;
	j2093146739 [label="Sí. Hay una sensación de pavor tan abrumadora que lo acompaña. Bueno. Mañana será otro día y tal vez se sienta como si fuera ayer.",shape=box,color=blue];
		j2093146739 -> j298080266;
