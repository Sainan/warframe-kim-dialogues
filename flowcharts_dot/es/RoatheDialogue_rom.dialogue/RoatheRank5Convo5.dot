		j2437796628 -> j2376009537;
	j422684404 [label="No. No lo creo. Persistencia de la materia y todo eso.",shape=box,color=red];
		j422684404 -> j619596353;
	j2281046658 [label="Sí, creo que sí. Si no, nos invadirían, ¿no?",shape=box,color=red];
