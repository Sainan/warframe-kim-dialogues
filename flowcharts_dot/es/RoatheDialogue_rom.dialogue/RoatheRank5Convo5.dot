		j210978704 -> j1790301177;
	j1154428728 [label="¿Y esta Indiferencia tuya es una entidad o criatura suprema? ¿Ejerce poder sobre algún aspecto de... la Indiferencia? ¿De la insensibilidad?",shape=box,color=blue];
		j1154428728 -> j554796816;
		j1154428728 -> j448643662;
	j2411085319 [label="Ah, ya veo. Ahí está el problema. Sí, nuestras definiciones no coincidían. ¿En qué medida esta \"Indiferencia\" es una entidad tal como la describes? Sí. Estamos de acuerdo.",shape=box,color=blue];
		j2411085319 -> j1627181890;
	j3435730546 [label="Decepcionante. Te creí más inteligente. Pero permíteme ir directo al grano y preguntarte esto:",shape=box,color=blue];
		j3435730546 -> j3503165550;
	j128307166 [label="Decepcionante. Pero permíteme ir directo al grano y preguntarte esto:",shape=box,color=blue];
		j128307166 -> j3503165550;
	j1559166037 [label="Pacifistas. ¿Por qué siempre tiene que haber un pacifista?",shape=box,color=blue];
		j1559166037 -> j3037449284;
	j2376009537 [label="Por eso, en tu modesta ignorancia, insinuas que todos andamos a tientas en la oscuridad.",shape=box,color=blue];
		j2376009537 -> j1666745977;
	j619596353 [label="Aah, maravilloso. ¡Crees que los \"dioses\" no pueden morir!",shape=box,color=blue];
		j619596353 -> j3037449284;
	j2826823046 [label="¿Y tu lógica es... que los dioses pueden morir porque... los \"dioses\" son como los pobbers?",shape=box,color=blue];
		j2826823046 -> j429895282;
	j1471066974 [label="Bueno, sí, eso es obvio, pero quédate conmigo, Viajero. Necesito que te concentres.",shape=box,color=blue];
		j1471066974 -> j429895282;
	j1153637223 [label="Honestamente, ni idea.",shape=box,color=red];
		j1153637223 -> j3778238292;
	j4236656188 [label="Todo puede morir. Incluso la Indiferencia. De alguna manera.",shape=box,color=red];
		j4236656188 -> j928965269;
	j3489567636 [label="Puede que no podamos matarlo, pero eso no significa que no podamos detenerlo.",shape=box,color=red];
		j3489567636 -> j735987252;
	j554796816 [label="Sí. Creo que sí.",shape=box,color=red];
		j554796816 -> j1841702757;
	j448643662 [label="No lo sé.",shape=box,color=red];
		j448643662 -> j1841702757;
	j1627181890 [label="Simplemente teníamos una discrepancia en la terminología abreviada. Qué gracioso.",shape=box,color=blue];
		j1627181890 -> j2392093812;
	j3037449284 [label="Sólo tienes dos opciones: o crees que esta cosa puede morir y, por lo tanto, no es un \"dios\",",shape=box,color=blue];
		j3037449284 -> j3596628486;
