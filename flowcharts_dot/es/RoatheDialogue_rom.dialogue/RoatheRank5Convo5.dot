		j1738110225 -> j1790301177;
	j3122473570 [label="Tienes razón. ¿Cómo definirías a un \"dios\"?",shape=box,color=blue];
		j3122473570 -> j1564632568;
		j3122473570 -> j3471940824;
		j3122473570 -> j2400381783;
	j853037196 [label="No lo sé.",shape=box,color=red];
		j853037196 -> j4012260393;
	j198730565 [label="Sí. Creo que sí.",shape=box,color=red];
		j198730565 -> j3323216182;
	j3503165550 [label="¿Crees que un \"dios\" puede morir?",shape=box,color=blue];
		j3503165550 -> j289182357;
		j3503165550 -> j2437796628;
		j3503165550 -> j422684404;
		j3503165550 -> j2281046658;
		j3503165550 -> j274664323;
	j3018745482 [label="¿De qué nos sirve? ¡Todo lo bueno del mundo! Claro, tú eres quien siempre ha luchado en solitario. Nunca se te sometió a las tácticas de un ejército.",shape=box,color=blue];
		j3018745482 -> j69887464;
	j2367628887 [label="¿Por qué preocuparse por ello? Pobre. Claro, tú eres quien siempre ha luchado en solitario. Nunca se te sometió a las tácticas de un ejército.",shape=box,color=blue];
		j2367628887 -> j69887464;
	j1790301177 [label="¿Puede un \"dios\", por alguna manera, dejar de existir?",shape=box,color=blue];
		j1790301177 -> j3503165550;
	j1564632568 [label="No sé bien. Tú primero.",shape=box,color=red];
		j1564632568 -> j210978704;
	j3471940824 [label="Una entidad o criatura sobrehumana que tiene poder sobre un aspecto particular de la creación o la fortuna humana.",shape=box,color=red];
		j3471940824 -> j1154428728;
	j2400381783 [label="Una entidad que escapa a nuestra comprensión. Una criatura que existe en una dimensión externa a la nuestra y, por lo tanto, no existe \"como nosotros\".",shape=box,color=red];
		j2400381783 -> j2411085319;
