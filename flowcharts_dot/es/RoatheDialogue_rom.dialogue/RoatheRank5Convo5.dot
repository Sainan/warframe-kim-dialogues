	"Chat ends." [color=orange];
	j3483983246 [label="¿Has pensado más en mi argumento con respecto a tu \"Indiferencia\"?",shape=box,color=blue];
		j3483983246 -> j1286935484;
		j3483983246 -> j502188699;
		j3483983246 -> j3530215218;
		j3483983246 -> j2006109188;
	j1286935484 [label="Sí. Creo que lo que Entrati liberó del Vacío era un dios sin forma que estaba allí en el éter antes de que llegáramos.",shape=box,color=red];
		j1286935484 -> j1196910026;
	j502188699 [label="Sí. Creo que estás diciendo muchas tonterías.",shape=box,color=red];
		j502188699 -> j4099310853;
	j3530215218 [label="Sí. Creo que tienes razón. No creo que existiera antes de que Entrati interactuara con él. Quería encontrar un dios, así que... el Vacío escupió algo que fingía serlo.",shape=box,color=red];
		j3530215218 -> j845642928;
	j2006109188 [label="Sí. Creo que la respuesta está en un punto intermedio. Quizás antes no era una deidad, pero ahora sí lo es. Creo que Entrati lo creó cuando abrió el Vacío.",shape=box,color=red];
		j2006109188 -> j30521660;
	j1196910026 [label="Simplemente no puede comprender lo que somos. ",shape=box,color=red];
		j1196910026 -> j2874459500;
	j4099310853 [label="Check boolean RoatheDating",color=orange];
		j4099310853 -> j1279457445 [label=true,color=green];
		j4099310853 -> j799229745 [label=false,color=brown];
	j845642928 [label="Y desde entonces hemos estado alimentando ese miedo.",shape=box,color=red];
		j845642928 -> j3738157163;
	j30521660 [label="Así como Rell existe y no existe ahora, la Indiferencia nunca ha sido un dios y, sin embargo, siempre lo ha sido.",shape=box,color=red];
		j30521660 -> j2446784601;
	j2874459500 [label="¿Puedo convencerte de que reconsideres mi postura o tus opiniones sobre el tema son inmutables?",shape=box,color=blue];
		j2874459500 -> j3492700890;
		j2874459500 -> j136928682;
	j1279457445 [label="No esperaba que fueras tan sensible, querido Viajero. Pero, como dicen los fanáticos, \"c'est la vie.\"",shape=box,color=blue];
		j1279457445 -> j650387292;
	j799229745 [label="Como dicen los fanáticos, \"c'est la vie.\"",shape=box,color=blue];
		j799229745 -> "Chat ends.";
	j3738157163 [label="Boolean DrifterMITWNotGod is now true.",color=orange];
		j3738157163 -> j1763696950;
	j2446784601 [label="Odio a los del eternalismo. Lo usan como excusa para todo. En cuanto un arquimediano cree entenderlo, se va.",shape=box,color=blue];
		j2446784601 -> j1775907712;
	j3492700890 [label="Puedes intentarlo.",shape=box,color=red];
		j3492700890 -> j1238499627;
	j136928682 [label="Es inútil.",shape=box,color=red];
		j136928682 -> j799229745;
	j650387292 [label="Boolean RoatheNoDate is now true.",color=orange];
		j650387292 -> j776748929;
	j1763696950 [label="+5 Chemistry",color=orange];
		j1763696950 -> j4042384604;
	j1775907712 [label="\"No me olvidé de regar la planta de tu oficina como prometí, simplemente está experimentando una rama diferente del eternalismo paralela a la nuestra\".",shape=box,color=blue];
		j1775907712 -> j3625956505;
	j1238499627 [label="Hoy no suenas muy filosófico, pero lo intentaré de todos modos.",shape=box,color=blue];
		j1238499627 -> j1827584886;
	j776748929 [label="Boolean RoatheDating is now false.",color=orange];
		j776748929 -> j178902881;
	j4042384604 [label="¡Maravilloso! Por fin avanzamos. ¡Que suenen las trompetas, que suenen las campanas, que por fin alguien entra en razón!",shape=box,color=blue];
		j4042384604 -> j4290145;
	j3625956505 [label="Me dan ganas de gritar. ¿Puedes comprometerte con algo por una vez en tu miserable vida?",shape=box,color=blue];
		j3625956505 -> j1634316281;
		j3625956505 -> j2739649107;
	j1827584886 [label="No es como si tuviera algo mejor que hacer con mi tiempo.",shape=box,color=blue];
		j1827584886 -> j3251112819;
	j178902881 [label="Boolean IsDating is now false.",color=orange];
		j178902881 -> "Chat ends.";
	j4290145 [label="Check boolean RoatheDating",color=orange];
		j4290145 -> j2466222045 [label=true,color=green];
		j4290145 -> j1226359525 [label=false,color=brown];
	j1634316281 [label="Lo que quiero decir es que antes no era un dios, pero ahora lo es.",shape=box,color=red];
		j1634316281 -> j91087200;
	j2739649107 [label="Olvídalo.",shape=box,color=red];
		j2739649107 -> j1035455590;
	j3251112819 [label="Empecemos por el principio, ¿de acuerdo? ¿Cómo definirías qué es un \"dios\"?",shape=box,color=blue];
		j3251112819 -> j2232142398;
		j3251112819 -> j3571216633;
		j3251112819 -> j3385524071;
	j2466222045 [label="Aunque no tenía ninguna duda de que cambiarías de opinión, querido Viajero, porque habías demostrado que eras de gustos refinados.",shape=box,color=blue];
		j2466222045 -> j2431600442;
	j1226359525 [label="Aunque no tenía ninguna duda de que cambiarías de opinión, Viajero. Soy bastante convincente. ",shape=box,color=blue];
		j1226359525 -> j2431600442;
	j91087200 [label="Ya veo. Albrecht lo convirtió en un \"dios\" del Vacío. Y ahora tenemos un \"dios\" suelto. Qué encantador.",shape=box,color=blue];
		j91087200 -> j1936517657;
		j91087200 -> j894123109;
	j1035455590 [label="En efecto.",shape=box,color=blue];
		j1035455590 -> "Chat ends.";
	j2232142398 [label="Un ser supremo. Algo que tiene autoridad o poder total e incuestionable. ",shape=box,color=red];
		j2232142398 -> j3109774397;
	j3571216633 [label="Una entidad o criatura sobrehumana que tiene poder sobre un aspecto particular de la creación o la fortuna humana.",shape=box,color=red];
		j3571216633 -> j2652261832;
	j3385524071 [label="No sé bien. Tú primero.",shape=box,color=red];
		j3385524071 -> j2148070347;
	j2431600442 [label="Ahora, si tan solo pudiéramos encontrar una manera de convencer a todos los demás lunáticos del asilo...",shape=box,color=blue];
		j2431600442 -> j528265564;
		j2431600442 -> j3456191804;
	j1936517657 [label="Sí, correcto.",shape=box,color=red];
		j1936517657 -> j1738110225;
	j894123109 [label="Sí, pero creo que ambos estamos perdiendo de vista nuestra definición de lo que es una \"deidad\".",shape=box,color=red];
		j894123109 -> j3122473570;
	j3109774397 [label="¿Y crees que tu Indiferencia es uno de esos seres supremos?",shape=box,color=blue];
		j3109774397 -> j853037196;
		j3109774397 -> j198730565;
	j2652261832 [label="¿Y esta Indiferencia tuya es una entidad o criatura suprema? ¿Ejerce poder sobre algún aspecto de... la Indiferencia? ¿De la insensibilidad?",shape=box,color=blue];
		j2652261832 -> j198730565;
		j2652261832 -> j853037196;
	j2148070347 [label="¿Quién es un cobarde ahora, eh? Muy bien. Permíteme simplificar las cosas e ir directo al grano:",shape=box,color=blue];
		j2148070347 -> j3503165550;
	j528265564 [label="Lo que no entiendo es ¿qué bien nos aporta esto?",shape=box,color=red];
