	925 [label="Ah, ya veo... estoy acostumbrado a hacer esto sin consecuencias. Bueno, probablemente no hayas tenido que lidiar con otro protoframe cuyos recuerdos están... fragmentados, como los míos. En ese sentido, supongo que soy un poco comprensivo. Y todo en nombre del \"amor\".",shape=box,color=blue];
