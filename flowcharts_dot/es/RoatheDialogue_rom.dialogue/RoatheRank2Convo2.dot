	958 [label="+10 Chemistry",color=orange];
		958 -> 968;
	959 [label="O intentas apelar a mi ego, lo cual te felicito, o simplemente tu día no te ha inspirado en absoluto. Algo con lo que, como alguien que ha disfrutado de innumerables ciclos de vida, casi me solidarizo.",shape=box,color=blue];
		959 -> 969;
	960 [label="Fascinante. O mientes, o aún me quedan piedras por remover. Quizás por eso estás aquí una vez más, releyendo campos ya arados.",shape=box,color=blue];
		960 -> 970;
	961 [label="Mm, poco a poco, casi me estás convenciendo de perdonarte por este lío que has creado.",shape=box,color=blue];
		961 -> 971;
	965 [label="Mucho antes de que se lanzara la Zariman Diez Cero, y los tenno fueran siquiera un punto en la pantalla proverbial, Margulis el Arquímedes y Ballas se conocieron durante la inauguración de un nuevo invernadero abovedado.",shape=box,color=blue];
		965 -> 975;
	973 [label="Hasta donde me han dicho (y no es del todo fiable, así que tómatelo con pinzas), las cepas de Infestación de cada uno de los lotes de protoframes se pueden influenciar individualmente.",shape=box,color=red];
		973 -> 981;
	974 [label="Ya... veo.",shape=box,color=blue];
		974 -> 982;
	972 [label="Chat ends.",color=orange];
	966 [label="Como cada uno vive en su propia \"continuidad\" o tiempo, todas las cepas de la infestación están conectadas, pero viven en... nódulos. Es muy complicado.",shape=box,color=red];
		966 -> 976;
	967 [label="El universo ciertamente se ha vuelto más extraño desde que lo dejé...",shape=box,color=blue];
		967 -> 977;
		967 -> 978;
	968 [label="Entonces no te cansaré contándote la saga una vez más, y te dejaré que encuentres otras diversiones con el resto del día.",shape=box,color=blue];
		968 -> 979;
	969 [label="Si no fuera yo el motivo de tu diversión.",shape=box,color=blue];
		969 -> 970;
	970 [label="Pero... No importa. ",shape=box,color=blue];
		970 -> 980;
	971 [label="Update boolean RoatheResetForgiven",color=orange];
		971 -> 970;
	975 [label="Ballas estaba allí para mantener la ceremonia (nos encanta la pompa y la solemnidad, por supuesto) y Margulis intentaba desesperadamente pasar desapercibida.",shape=box,color=blue];
		975 -> 983;
	981 [label="Como cada uno vive en su propia \"continuidad\" o tiempo, todas las cepas de la infestación están conectadas, pero viven en... nódulos. Es muy complicado.",shape=box,color=red];
		981 -> 987;
	982 [label="El universo ciertamente se ha vuelto más extraño desde que lo dejé...",shape=box,color=blue];
		982 -> 988;
		982 -> 989;
	976 [label="Entonces, ya que puedo repetir el tiempo, puedo repetir los \"lotes\" de infestación de manera limitada.",shape=box,color=red];
		976 -> 984;
	977 [label="No tienes idea.",shape=box,color=red];
		977 -> 985;
	978 [label="Ella se lleva el pastel. Bueno... no importa.",shape=box,color=red];
		978 -> 985;
	979 [label="Update boolean RoatheMargulis1",color=orange];
		979 -> 986;
	980 [label="Ballas y Margulis.",shape=box,color=blue];
		980 -> 965;
	983 [label="Algo que debes entender, mi Usurpador, es que Ballas no tenía ningún motivo para relacionarse con ella. Ningún motivo en absoluto, a menos que su fascinación fuera genuina.",shape=box,color=blue];
		983 -> 990;
	987 [label="Entonces, ya que puedo repetir el tiempo, puedo repetir los \"lotes\" de infestación de manera limitada.",shape=box,color=red];
		987 -> 993;
	988 [label="No tienes idea.",shape=box,color=red];
		988 -> 994;
	989 [label="Ella se lleva el pastel. Bueno... no importa.",shape=box,color=red];
		989 -> 994;
	984 [label="¿Y \"ella\" es?",shape=box,color=blue];
		984 -> 991;
		984 -> 992;
	985 [label="Te castigaría por lo que has hecho en nombre de conseguir lo que quieres, pero me sorprende que se sepa que los orokin han hecho cosas mucho peores, si no más creativas.",shape=box,color=blue];
		985 -> 931;
	986 [label="Chat ends.",color=orange];
	990 [label="No era solo lujuria, pues podía tener a quien quisiera, y lo hacía, con bastante frecuencia. Si la deseaba, podría haberla tenido y olvidarse de ella.",shape=box,color=blue];
		990 -> 995;
	993 [label="¿Y \"ella\" es?",shape=box,color=blue];
		993 -> 996;
		993 -> 997;
	994 [label="De todas formas. ¿Todo esto en nombre del \"amor\"?",shape=box,color=blue];
		994 -> 998;
	991 [label="Lizzie, ella te amaría.",shape=box,color=red];
		991 -> 957;
	992 [label="Una guitarra parlante.",shape=box,color=red];
		992 -> 957;
	995 [label="Era un Ejecutor. Uno de los más poderosos de los Siete, de hecho. Podría haberla convocado a sus aposentos y ella habría acudido sin pensárselo dos veces.",shape=box,color=blue];
		995 -> 999;
	996 [label="Lizzie, ella te amaría.",shape=box,color=red];
		996 -> 974;
	997 [label="Una guitarra parlante.",shape=box,color=red];
		997 -> 974;
	998 [label="Te castigaría por lo que has hecho en nombre del llamado \"amor\", pero me sorprende que se sepa que los orokin han hecho cosas mucho peores, si no más creativas.",shape=box,color=blue];
		998 -> 931;
	999 [label="Pero no fue eso lo que hizo. Ballas la miró esa noche y... quedó fascinado, Viajero. Totalmente fuera de sí.",shape=box,color=blue];
		999 -> 1000;
	1000 [label="Nunca había visto nada igual. Era como si no existiera nadie más en la habitación, salvo Margulis. Parecía incluso... demasiado tímido para hablarle. ¡Él! ¡Ballas!",shape=box,color=blue];
		1000 -> 1001;
		1000 -> 1002;
	1001 [label="¿En serio?",shape=box,color=red];
		1001 -> 1003;
	1002 [label="Te lo estás inventando.",shape=box,color=red];
		1002 -> 1004;
	1003 [label="¡Lo juro por lo que me queda de honor! ¿Y qué razón tendría para mentir? ¿Qué me importa tu opinión sobre la validez de su relación?",shape=box,color=blue];
		1003 -> 1005;
	1004 [label="¡Juro por lo que me queda de honor que no lo estoy inventando! ¿Y qué razón tendría para mentir? ¿Qué me importa tu opinión sobre la validez de su relación?",shape=box,color=blue];
		1004 -> 1005;
	1005 [label="Simplemente me entristece que ustedes simplifiquen tan rápidamente algo que es decididamente mucho más complicado de lo que ustedes quisieran.",shape=box,color=blue];
		1005 -> 1006;
	1006 [label="Estaban enamorados, lo creas o no. Ballas se saltó todas las reglas de clase y la tradición para tomar como amante —y única compañera romántica— a una arquimediana. ",shape=box,color=blue];
		1006 -> 1007;
	1007 [label="Solo el amor verdadero pudo haber vuelto a un hombre tan espectacularmente loco como lo volvió a él, cuando todo salió tan mal...",shape=box,color=blue];
		1007 -> 1008;
		1007 -> 1009;
	1008 [label="¿Cómo lo crees? ¿No fue él el responsable de la muerte de ella?",shape=box,color=red];
		1008 -> 1010;
	1009 [label="Ballas fue quien la mandó a ejecutar.",shape=box,color=red];
		1009 -> 1010;
	1010 [label="Primero, supongamos que todo lo que sabe es correcto y que sus acciones allí fueron puramente voluntarias. Supongamos que no hubo otras maniobras políticas, chantajes ni nada más entre bastidores que pudiera haberlo forzado a actuar.",shape=box,color=blue];
		1010 -> 1011;
	1011 [label="Incluso si ese fuera el caso, y Ballas pidiera su ejecución sin ninguna influencia, considere que ya era demasiado tarde. La traición que sentía ya lo había dividido en dos.",shape=box,color=blue];
		1011 -> 1012;
	1012 [label="Su corazón y su mente ya estaban rotos.",shape=box,color=blue];
		1012 -> 1013;
		1012 -> 1014;
	1013 [label="No voy a empezar a sentir lástima por él, si eso es lo que me estás pidiendo que haga.",shape=box,color=red];
		1013 -> 1015;
	1014 [label="¿Por los tenno? ¿O por lo que le hicieron a ella?",shape=box,color=red];
		1014 -> 1016;
	1015 [label="¡No te pido nada parecido! Ballas se lo merece todo, menos la orina que puedas gastar en donde enterraste su cadáver, si es que tiene una tumba.",shape=box,color=blue];
		1015 -> 1017;
	1016 [label="En cierto modo, ambas cosas. Y en cierto modo, ninguna. Ese día, al pedir su ejecución, se volvió loco. De hecho, no me sorprendería que una parte de él no recordara del todo haber cometido el crimen.",shape=box,color=blue];
		1016 -> 1018;
	1017 [label="Solo afirmo que el día que ordenó su ejecución, estaba loco. No me sorprendería que, después, alguna parte de él no recordara del todo haber cometido el crimen.",shape=box,color=blue];
		1017 -> 1018;
	1018 [label="Ballas amaba a Margulis. Con toda su alma, completamente entregado a ella. Lo habría sacrificado todo por ella. Su alma, su cuerpo, el Imperio Orokin. Cualquier cosa que pudieras soñar.",shape=box,color=blue];
		1018 -> 1019;
	1019 [label="Ningún precio era demasiado alto. Ninguna moral valía la pena sacrificar. Si le hubieras entregado un bebé recién nacido y le hubieras dicho que Margulis deseaba que le estrellaran los sesos contra las rocas, habría muerto antes de que cumplieras tu condena.",shape=box,color=blue];
		1019 -> 1020;
	1020 [label="Él habría quemado el Sistema Origen hasta las cenizas y lo habría reconstruido a su imagen, Usurpador... pero aquí radica la tragedia.",shape=box,color=blue];
		1020 -> 1021;
	1021 [label="¿Margulis? Ah, Margulis. Mi querida Margulis... aún tenía conciencia.",shape=box,color=blue];
		1021 -> 1022;
	1022 [label="Y cuando vio a los pobres tenno, a los pobres niños desgarrados por el Vacío... ",shape=box,color=blue];
		1022 -> 1023;
	1023 [label="Había algo en su vida más importante que Ballas. Había algo en su vida por lo que valía la pena sacrificarla... y no era él.",shape=box,color=blue];
		1023 -> 1024;
	1024 [label="Ese no era su amor por él.",shape=box,color=blue];
		1024 -> 1025;
	1025 [label="Y él lo sabía, mi dulce Viajero. Lo supo desde el momento en que los vio. Y quedó claro cuando sus \"animales rabiosos\" se aseguraron de que fueran lo último que ella viera. O al menos eso decían los rumores entre nosotros, los orokin.",shape=box,color=blue];
		1025 -> 1026;
	1026 [label="¿Te imaginas la alegría de los orokin? ¿Al ver a los preciosos mocosos rabiosos y destrozados por el Vacío de la Arquimediana de Ballas quemarle los ojos?",shape=box,color=blue];
		1026 -> 1027;
	1027 [label="Pero creo que fue antes de eso, en el preciso momento en que Margulis luchaba por salvar a los tenno, que el corazón de Ballas se rompió en mil pedazos y nunca se recuperó.",shape=box,color=blue];
		1027 -> 1028;
	1028 [label="Porque él sabía que había sido suplantado por ella.",shape=box,color=blue];
		1028 -> 1029;
	1029 [label="Supongo que por eso lo compadecí. ¿Pero qué siguió? Una historia de amor para la historia... y cómo terminó en una tragedia tan desgarradora. ",shape=box,color=blue];
		1029 -> 1030;
	1030 [label="Ojalá hubieras podido ver cómo se sonreían el uno al otro...",shape=box,color=blue];
		1030 -> 1031;
		1030 -> 1032;
	1031 [label="Se puede idealizar lo que tenían, pero eso no justifica quién era. A Ballas no se le puede perdonar todo lo que hizo.",shape=box,color=red];
		1031 -> 1033;
	1032 [label="Me alegra que su amor fuera real. Que él fuera... complicado en aquel entonces. Y que no jugaran con Margulis todo el tiempo.",shape=box,color=red];
		1032 -> 1034;
	1033 [label="Add 1 to Thermostat",color=orange];
		1033 -> 1035;
	1034 [label="Add -1 to Thermostat",color=orange];
		1034 -> 1036;
	1035 [label="+10 Chemistry",color=orange];
		1035 -> 1037;
	1036 [label="+10 Chemistry",color=orange];
		1036 -> 1038;
	1037 [label="No intentaba equipararlos, Usurpador. Simplemente afirmaba que un hombre podía ser amado, pero también capaz de cosas terribles. En fin... No hay esperanza para los demás, depravados, supongo...",shape=box,color=blue];
		1037 -> 1039;
	1038 [label="En efecto. A veces me tranquiliza pensar que si incluso ese señor de la depravación puede encontrar un compañero, hay esperanza para el resto de nosotros, ¿eh? ¡Ja!",shape=box,color=blue];
		1038 -> 1039;
	1039 [label="Update boolean RoatheMargulis1",color=orange];
		1039 -> 1040;
	1040 [label="Pero ya te he quitado suficiente tiempo por hoy. ¡Ya vete! ",shape=box,color=blue];
		1040 -> 1041;
	1041 [label="Chat ends.",color=orange];
}