	962 [label="[Fin]",shape=box,color=red];
		962 -> 972;
	956 [label="Hasta donde me han dicho (y no es del todo fiable, así que tómatelo con pinzas), las cepas de Infestación de cada uno de los lotes de protoframes se pueden influenciar individualmente.",shape=box,color=red];
		956 -> 966;
	957 [label="Ya... veo.",shape=box,color=blue];
		957 -> 967;
