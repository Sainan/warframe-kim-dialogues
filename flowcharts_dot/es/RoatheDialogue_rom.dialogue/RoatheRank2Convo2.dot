	886 [label="[Fin]",shape=box,color=red];
		886 -> 891;
	890 [label="Supongo que es extrañamente romántico, si bien un poco... distópico, llegar a tales extremos para ganar el corazón (y/o el cuerpo) de tu pareja.",shape=box,color=blue];
		890 -> 895;
	889 [label="¿O es aún peor, y simplemente tenías curiosidad por ver qué pasaría? ¿Y simplemente estás ahí sentado, arrancándoles las patas a los insectos? Ya hemos descubierto el \"qué\" detrás de tus acciones. Ahora intento preguntarme el \"por qué\".",shape=box,color=blue];
		889 -> 894;
