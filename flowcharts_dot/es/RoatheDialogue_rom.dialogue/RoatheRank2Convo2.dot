	926 [label="Mm, sí. Bueno, probablemente no hayas tenido que lidiar con otro protoframe cuyos recuerdos están... fragmentados, como los míos. De esa manera, supongo que soy un poco comprensivo. Y todo en nombre del \"amor\".",shape=box,color=blue];
		926 -> 936;
	921 [label="Y así, estoy empezando a entender cómo llegaste a \"meter la pata\" en primer lugar, Usurpador.",shape=box,color=blue];
		921 -> 920;
	919 [label="+5 Chemistry",color=orange];
