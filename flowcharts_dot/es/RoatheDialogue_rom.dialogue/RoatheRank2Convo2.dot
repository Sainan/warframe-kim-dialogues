	918 [label="+5 Chemistry",color=orange];
		918 -> 929;
	920 [label="Te castigaría por lo que has hecho en nombre de conseguir lo que quieres, pero me sorprende que se sepa que los orokin han hecho cosas mucho peores, si no más creativas.",shape=box,color=blue];
		920 -> 931;
	927 [label="Claro que sí. O mejor dicho, los niños. Los tenno. A veces me pregunto si era inevitable lo que pasó. O si lo habrían convencido de cambiar de rumbo.",shape=box,color=blue];
		927 -> 937;
	928 [label="Quizás tengas razón. O quizás todos seamos, al fin y al cabo, joyas en bruto. Tenemos nuestros defectos, nuestras características. Venas por aquí, imperfecciones por allá.",shape=box,color=blue];
		928 -> 938;
	935 [label="Y así, empiezo a entender cómo cometiste ese error, Usurpador. Me cuesta creer que lo hayas hecho en nombre del amor.",shape=box,color=blue];
		935 -> 934;
	933 [label="+5 Chemistry",color=orange];
		933 -> 943;
	932 [label="+5 Chemistry",color=orange];
		932 -> 942;
	934 [label="Pero los orokin siempre han tenido una forma extraña de expresar sus emociones, supongo.",shape=box,color=blue];
		934 -> 931;
	936 [label="Te castigaría por lo que has hecho en nombre del llamado \"amor\", pero me sorprende que se sepa que los orokin han hecho cosas mucho peores, si no más creativas.",shape=box,color=blue];
		936 -> 931;
	930 [label="Yo aconsejaría sentarme tranquilamente con mis errores y aceptar la derrota como lo que es, pero eso me convertiría en un hipócrita bastante furioso, ¿no?",shape=box,color=blue];
		930 -> 940;
	929 [label="Yo aconsejaría aceptar mis errores con calma y aceptar la derrota como lo que es, personalmente. Pero no tengo el don del Vacío de absorber el tiempo y borrar las mentes.",shape=box,color=blue];
		929 -> 939;
	931 [label="¿Te he contado la historia de Ballas y Margulis? Confío en que seas sincero conmigo, pues de otra manera no tengo forma de saber la verdad.",shape=box,color=blue];
		931 -> 941;
	937 [label="Me gusta creer que, al fin y al cabo, todos somos joyas en bruto. Tenemos nuestros defectos, nuestras características. Venas por aquí, imperfecciones por allá.",shape=box,color=blue];
		937 -> 938;
	938 [label="Y podemos ser tallados de ciertas maneras para captar la luz y convertirnos en elaboradas obras de arte... o afilarnos como armas... o hacernos añicos y convertirnos en polvo.",shape=box,color=blue];
		938 -> 944;
	943 [label="Yo aconsejaría sentarme tranquilamente con mis errores y aceptar la derrota como lo que es, pero eso me convertiría en un hipócrita bastante furioso, ¿no?",shape=box,color=blue];
		943 -> 953;
	942 [label="Yo aconsejaría aceptar mis errores con calma y aceptar la derrota como lo que es, personalmente. Pero no tengo el don del Vacío de absorber el tiempo y borrar las mentes.",shape=box,color=blue];
		942 -> 952;
	940 [label="¿Y quién puede decir que no habría hecho buen uso del don otorgado por el Vacío de recorrer espacios de tiempo y borrar mentes?",shape=box,color=blue];
		940 -> 939;
	939 [label="¿Cómo... exactamente funciona esto?",shape=box,color=blue];
		939 -> 946;
		939 -> 947;
		939 -> 945;
	941 [label="Y déjame decírtelo, cuánto desprecio eso.",shape=box,color=blue];
		941 -> 948;
		941 -> 949;
		941 -> 950;
		941 -> 951;
	944 [label="Quizás sea una creencia ingenua, y todos somos inmutables. Tú lo sabrías mejor que yo, o eso he oído.",shape=box,color=blue];
		944 -> 954;
	953 [label="¿Y quién puede decir que no habría hecho buen uso del don otorgado por el Vacío de recorrer espacios de tiempo y borrar mentes?",shape=box,color=blue];
		953 -> 952;
	952 [label="¿Cómo... exactamente funciona esto?",shape=box,color=blue];
		952 -> 963;
		952 -> 964;
		952 -> 962;
	946 [label="Ahora estás infestado. Y compartes una conexión con las cepas infestadas que se usaron para crear todos los lotes de suero protoframe.",shape=box,color=red];
		946 -> 956;
	947 [label="Una guitarra parlante me debe algunos favores.",shape=box,color=red];
		947 -> 957;
	945 [label="[Fin]",shape=box,color=red];
		945 -> 955;
	948 [label="Lo he oído.",shape=box,color=red];
		948 -> 958;
	949 [label="Lo he oído, pero, por favor, continúa.",shape=box,color=red];
		949 -> 959;
	950 [label="La verdad es que no lo he oído.",shape=box,color=red];
		950 -> 960;
	951 [label="No, no he oído la historia, que... de hecho, es parte de la razón por la que estamos aquí. Sé que perdí oportunidades la primera vez.",shape=box,color=red];
		951 -> 961;
	954 [label="Pero me tienes contándote todo esto fuera de orden. Permíteme empezar como es debido.",shape=box,color=blue];
		954 -> 965;
	963 [label="Ahora estás infestado. Y compartes una conexión con las cepas infestadas que se usaron para crear todos los lotes de suero protoframe.",shape=box,color=red];
		963 -> 973;
