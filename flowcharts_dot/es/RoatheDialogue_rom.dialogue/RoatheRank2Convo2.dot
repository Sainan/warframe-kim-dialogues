	883 [label="Sabes... ellos alguna vez estuvieron enamorados.",shape=box,color=blue];
		883 -> 888;
		883 -> 887;
		883 -> 886;
	885 [label="Entrometerse con nuestras mentes... ¿todo por lujuria? ¿Amor? ¿Qué es? ¿Cómo lo llamarías? Supongo que simplemente me pregunto si valió la pena. O supongo que aún no lo sabes, ya que tus dividendos aún no se han pagado.",shape=box,color=blue];
		885 -> 890;
	884 [label="Interferir con nuestras mentes... ¿todo para qué? ¿Para completar una lista de tareas invisible? ¿O todo esto en nombre de derrotar a tu supuesto \"dios\" conjurado?",shape=box,color=blue];
