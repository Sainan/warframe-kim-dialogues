	j3222016813 [label="Tienes los medios. Tienes la fuerza. Has expresado con suficiente claridad tu disgusto por tu situación.",shape=box,color=red];
		j3222016813 -> j2961442479;
	j3807975614 [label="No entiendo por qué \"El Diablo de Tau\" se conforma con sentarse en una cripta y holgazanear. Incluso con nuestro acuerdo.",shape=box,color=red];
		j3807975614 -> j2206556128;
	j1774025972 [label="Eres orokin. Claramente odias a todos los que te rodean. ¿Qué te detiene?",shape=box,color=red];
		j1774025972 -> j588937226;
	j1434196202 [label="No entiendo por qué \"El Diablo de Tau\" se conforma con quedarse en una cripta sin hacer nada. Sobre todo porque no tenemos ningún trato.",shape=box,color=red];
		j1434196202 -> j3657429577;
	j2961442479 [label="+5 Chemistry",color=orange];
		j2961442479 -> j423899375;
	j2206556128 [label="Check boolean RoatheKnowsReset2",color=orange];
		j2206556128 -> j913375499 [label=true,color=green];
		j2206556128 -> j3499526428 [label=false,color=brown];
	j588937226 [label="Disculpa, tomaré un momento para ordenar mis pensamientos antes de comenzar esta conversación desde un lugar alimentado enteramente por la rabia y el rencor.",shape=box,color=blue];
		j588937226 -> j3076550111;
	j3657429577 [label="Check boolean RoatheKnowsReset2",color=orange];
		j3657429577 -> j913375499 [label=true,color=green];
		j3657429577 -> j632077327 [label=false,color=brown];
	j423899375 [label="Y me alegra que reconozcas que tengo a mi alcance la capacidad de convertir este lugar en un matadero con bastante facilidad.",shape=box,color=blue];
		j423899375 -> j728892966;
	j913375499 [label="Porque aún queda el misterio de por qué confié lo suficiente en ti como para contarte tanto, sólo para que traicionaras esa confianza, Usurpador.",shape=box,color=blue];
		j913375499 -> j873107542;
	j3499526428 [label="Aún queda trabajo por hacer, Usurpador. No puedo contar con tu ayuda para recuperar todos mis recuerdos si me pongo a asesinar a todos los que están cerca, ¿verdad?",shape=box,color=blue];
		j3499526428 -> j2612459248;
	j3076550111 [label="Porque me esfuerzo mucho para no demostrar inmediatamente que tienes razón.",shape=box,color=blue];
		j3076550111 -> j1170544527;
	j632077327 [label="Quizás espero que te espabiles y cambies de opinión. Y las probabilidades de que eso ocurra disminuyen drásticamente si he estado masacrando a todos los que están cerca, ¿no?",shape=box,color=blue];
		j632077327 -> j2612459248;
	j728892966 [label="Pero no serviría de nada, ¿verdad? Si algo aprendemos de la guerra, es que el asesinato, al final, no sirve de mucho.",shape=box,color=blue];
		j728892966 -> j2472990850;
	j873107542 [label="Y las posibilidades de que eso ocurra se reducen drásticamente si empiezo a masacrar a todos los que me rodean, ¿no? Si algo aprendemos de la guerra, es que el asesinato, al final, no sirve de mucho.",shape=box,color=blue];
		j873107542 -> j1558551457;
	j2612459248 [label="Además, no serviría de nada, ¿verdad? Si algo aprendemos de la guerra, es que el asesinato, al final, no sirve de mucho.",shape=box,color=blue];
		j2612459248 -> j1558551457;
	j1170544527 [label="Comprendo tu odio hacia los orokin. Créeme. La mayoría de los orokin despreciaban a los orokin. Y no ignoro nuestros crímenes. Las atrocidades que hemos cometido. ",shape=box,color=blue];
		j1170544527 -> j1320660993;
	j2472990850 [label="Por muy agradable que sea tener ganas de hacerlo un poco de vez en cuando.",shape=box,color=blue];
		j2472990850 -> j1080825500;
		j2472990850 -> j2339381696;
		j2472990850 -> j3462507778;
	j1558551457 [label="Por muy agradable que sea tener ganas de hacerlo un poco de vez en cuando.",shape=box,color=blue];
		j1558551457 -> j3462507778;
		j1558551457 -> j2339381696;
		j1558551457 -> j1080825500;
	j1320660993 [label="El teatro Yuvan por sí solo sería motivo suficiente para arrasar nuestra sociedad. ¡Pero condenas a todo un pueblo, del cual fuiste producto, debo añadir, mi Usurpador, de un solo golpe!",shape=box,color=blue];
		j1320660993 -> j679663362;
	j1080825500 [label="Entonces, ¿la única razón por la que dejaste vivir a todos es porque no tendría sentido matarlos?",shape=box,color=red];
		j1080825500 -> j1873623603;
	j2339381696 [label="¿No hay otra razón para dejar que todos vivan?",shape=box,color=red];
		j2339381696 -> j784989442;
	j3462507778 [label="¿También Marie y Lyon?",shape=box,color=red];
		j3462507778 -> j4293973776;
	j679663362 [label="No sabes nada de todas las almas bondadosas que trabajaron y murieron entre esos muros dorados. Las sagas escritas de esas vidas que se han perdido en el tiempo.",shape=box,color=blue];
		j679663362 -> j1841337460;
	j1873623603 [label="Sería inútil matarlos, ¿verdad? ¿Intentas convencerme de lo contrario? Usurpador, estoy impresionado. ¡Nunca pensé que fueras un monstruo tan astuto!",shape=box,color=blue];
		j1873623603 -> j3173253245;
		j1873623603 -> j329157483;
	j784989442 [label="Si vas a hacer alguna insinuación disimuladamente, Usurpador, sólo dilo.",shape=box,color=blue];
		j784989442 -> j3173253245;
		j784989442 -> j329157483;
	j4293973776 [label="Estoy bastante seguro de que si bajaras a la cripta y encontraras dos manchas de sangre en el lugar donde solían estar los fanáticos, me darías una buena reprimenda por ello, ¿no crees?",shape=box,color=blue];
		j4293973776 -> j2987833276;
	j1841337460 [label="Los ríos de lágrimas que se han derramado por tragedias que quedarán en el olvido, simplemente porque te son desconocidas.",shape=box,color=blue];
		j1841337460 -> j2798913112;
	j3173253245 [label="Está bien admitir que disfrutas de la compañía. Las personas pueden hacer más que simplemente cumplir un propósito utilitario.",shape=box,color=red];
		j3173253245 -> j796436421;
	j329157483 [label="Está bien admitir que evitamos la soledad, incluso si te molestamos.",shape=box,color=red];
		j329157483 -> j134072315;
	j2987833276 [label="De ti o del mayordomo o del tenno o de la terrible \"Madre\" del tenno. Ay. Esa. Esa me molesta. Pero ese es otro tema.",shape=box,color=blue];
		j2987833276 -> j329157483;
		j2987833276 -> j3173253245;
	j2798913112 [label="Oigo a tu pequeña réplica gritar el nombre de Adis. ",shape=box,color=blue];
		j2798913112 -> j587181610;
