		j2753102884 -> j2962172166;
	j818027935 [label="Al fin y al cabo, es ella quien ha visto a la mayoría de nuestros semejantes.",shape=box,color=blue];
		j818027935 -> j155006797;
	j2962172166 [label="Todavía no he visto la conclusión del pequeño drama entre nuestro querido mayordomo y la familia de Albrecht allá arriba.",shape=box,color=blue];
