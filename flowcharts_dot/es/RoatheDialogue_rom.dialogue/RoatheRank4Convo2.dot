	j44286058 [label="¿Quieres exterminar a todos los orokin? Sube las escaleras. Tienes algunos sobrevivientes que no pueden escapar de tu ira. Empieza con \"Abuela\".",shape=box,color=blue];
		j44286058 -> j818027935;
	j1933300832 [label="+10 Chemistry",color=orange];
		j1933300832 -> "Chat ends.";
