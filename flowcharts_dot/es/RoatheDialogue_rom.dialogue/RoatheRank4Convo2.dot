	j1921369168 [label="Su nombre es único para ti.",shape=box,color=blue];
		j1921369168 -> j650294876;
	j3941027476 [label="No tientes al destino, Usurpador. \"Agradable\" es un poco exagerado. Más bien es que mis sentimientos... están empezando a crecer. Como el moho.",shape=box,color=blue];
		j3941027476 -> j1328807703;
	j2675851313 [label="¿\"Alegría\"? ¿Es eso? Nunca me di cuenta de que era tan masoquista. Mmm. ¿O es simplemente la sensación de que mi cuerpo se pudre y de que mis sentimientos... \"empiezan a crecer\"?",shape=box,color=blue];
		j2675851313 -> j3230001125;
	j2614691081 [label="Es algo agradable tener a alguien con quien hablar. Aunque, como dijiste, a veces son irritantes.",shape=box,color=blue];
		j2614691081 -> j2021621401;
	j3524138392 [label="¿Soledad? Bah. Lo único que evitas es cualquier cosa que intente volver a mi cordura. Si intentas insinuar que me estás gustando, ¿sabes qué más significa eso?",shape=box,color=blue];
		j3524138392 -> j2036684411;
	j650294876 [label="Pero no a las estrellas.",shape=box,color=blue];
		j650294876 -> j1762295557;
