		j2021621401 -> j3699948404;
	j2036684411 [label="Moho.",shape=box,color=blue];
		j2036684411 -> j689414758;
	j1762295557 [label="Pinta a mi gente de carmesí todo lo que quieras. Funde oro orokin y llámanos monstruos. Merecemos todo el odio que puedas reunir.",shape=box,color=blue];
		j1762295557 -> j2531188528;
	j689414758 [label="Boolean RoatheAlone2 is now true.",color=orange];
		j689414758 -> j1654361623;
	j3699948404 [label="Lo admito, mis sentimientos están... empezando a crecer. Como el moho.",shape=box,color=blue];
		j3699948404 -> j689414758;
	j2531188528 [label="Pero no pienses ni por un segundo que eso era todo lo que podíamos hacer.",shape=box,color=blue];
		j2531188528 -> j44286058;
