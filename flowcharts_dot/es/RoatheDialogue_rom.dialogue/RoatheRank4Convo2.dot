	2446 [label="Their name is unique to you.",shape=box,color=blue];
		2446 -> 2451;
	2448 [label="Do not press your luck, Usurper. \"Enjoyable\" is a bit of a stretch. It is more that you are growing on me. Like Mould.",shape=box,color=blue];
		2448 -> 2453;
	2447 [label="\"Joy?\" Is that what this is? I never realized I was such a masochist. Hm. Or is it simply the sensation of my body rotting away, and the feeling of you all \"growing on me?\"",shape=box,color=blue];
		2447 -> 2452;
	2449 [label="It is somewhat enjoyable to have someone to talk to. Even if you lot are, as you said, grating from time to time.",shape=box,color=blue];
		2449 -> 2454;
	2450 [label="Loneliness? Bah. The only thing you stave off is whatever sanity is attempting to return to my life. If you are attempting to imply that you lot are \"growing on me\" do you know what else does that?",shape=box,color=blue];
		2450 -> 2455;
	2451 [label="But not to the stars.",shape=box,color=blue];
		2451 -> 2456;
	2453 [label="+5 Chemistry",color=orange];
		2453 -> 2457;
	2452 [label="Like mould.",shape=box,color=blue];
		2452 -> 2457;
	2454 [label="+5 Chemistry",color=orange];
		2454 -> 2458;
	2455 [label="Mould.",shape=box,color=blue];
		2455 -> 2457;
	2456 [label="Paint my kind in crimson all you wish. Melt Orokin gold and call us monsters. We deserve every ounce of vitriol you can spare for us.",shape=box,color=blue];
		2456 -> 2459;
	2457 [label="Update boolean RoatheAlone2",color=orange];
