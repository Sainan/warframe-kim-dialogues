		j155006797 -> "Chat ends.";
	j435402801 [label="Tengo un interés personal en todo esto, no lo olvides, tengamos o no un acuerdo. Quiero asegurarme de que cuando Albrecht ponga un pie en este Sanctum, el primer rostro que vea...",shape=box,color=blue];
		j435402801 -> j2903374086;
