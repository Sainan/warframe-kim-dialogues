	j2693150438 [label="Cumples sus órdenes, reconstruyendo familias rotas y corazones vacíos dondequiera que vayas. Si no supiera cómo te sientes de verdad, pensaría que estás recibiendo tu pago en carne. Mi carne, específicamente.",shape=box,color=blue];
		j2693150438 -> j2492865885;
	j2676936986 [label="Cumples sus órdenes, reconstruyendo familias rotas y corazones vacíos dondequiera que vayas. Pero recibes una parte para ti, ¿verdad? En carne y hueso. Mi carne.",shape=box,color=blue];
