	j3555529150 [label="MV: INVENCIÓN",shape=box,color=blue];
		j3555529150 -> j2078773819;
	j2078773819 [label="Transcripción: Ahora bien, recuerdo que los desarrollos de la Arquimedea marcial fueron, al principio, presentados como entretenimiento. ",shape=box,color=blue];
		j2078773819 -> j3681123810;
	j3681123810 [label="Como libertinos depravados que observan la ejecución de criminales en una arena de circo.",shape=box,color=blue];
		j3681123810 -> j1172949346;
	j1172949346 [label="Creímos que habíamos encontrado formas nuevas y cautivadoras de derrotar a un enemigo muy inferior.",shape=box,color=blue];
		j1172949346 -> j1631350926;
	j1631350926 [label="¡Cuánto nos halagábamos! En realidad, innovamos desesperadamente, sabiendo que nuestros proteicos enemigos nos superaban.",shape=box,color=blue];
		j1631350926 -> j1426430918;
	j1426430918 [label="Nos atravesaron como si fueran criaturas que devoraran a su madre hinchada.",shape=box,color=blue];
		j1426430918 -> j4057950475;
	j4057950475 [label="Deshidratados, aplastados entre las páginas del tiempo, simplemente habíamos sido superados en la evolución.",shape=box,color=blue];
		j4057950475 -> j921430358;
	j921430358 [label="Add 1 to HellStory counter",color=orange];
		j921430358 -> "Chat ends.";
