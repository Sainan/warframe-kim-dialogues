	j3969553544 [label="MV: CONEXIÓN",shape=box,color=blue];
		j3969553544 -> j1332082179;
	j1332082179 [label="Transcripción: Cuando los conscientes completaron el raíl solar a Tau, no hubo una gran ceremonia. Simplemente empezó a funcionar.",shape=box,color=blue];
		j1332082179 -> j2987870477;
	j2987870477 [label="Por supuesto, se improvisó una ceremonia a toda prisa, porque ningún verdadero orokin se sonaría la nariz sin un mínimo de pompa y solemnidad.",shape=box,color=blue];
		j2987870477 -> j474473248;
	j474473248 [label="Se produjo una gran conmoción en torno al primer transporte que haría la travesía.",shape=box,color=blue];
		j474473248 -> j2595647382;
	j2595647382 [label="Era el enorme crucero del ejecutor Tormis, y en su elección de Tormis como su fuerza expedicionaria se podría leer una reprimenda colectiva al ejecutor Tuvul por el grotesco incidente de la Zariman Diez Cero. ",shape=box,color=blue];
		j2595647382 -> j4269989487;
	j4269989487 [label="Tormis se fue y regresó con maravillosos recuerdos de un nuevo sistema y nuevos mundos para colonizar. ",shape=box,color=blue];
		j4269989487 -> j2840138533;
	j2840138533 [label="En cuestión de días, una flotilla de naves colonizadoras partió, ansiosa por poner pie en la costa virgen.",shape=box,color=blue];
		j2840138533 -> j575619004;
	j575619004 [label="El ataque de los conscientes que siguió arruinó el ambiente.",shape=box,color=blue];
		j575619004 -> j921430358;
	j921430358 [label="Add 1 to HellStory counter",color=orange];
		j921430358 -> "Chat ends.";
}