digraph {
	1095 [label="RoatheRank2Convo4 begins.",color=orange];
		1095 -> 1096;
	1096 [label="Check boolean RoatheRank2Convo1Complete",color=orange];
		1096 -> 1097 [label=true,color=green];
		1096 -> 1098 [label=false,color=brown];
	1097 [label="Check boolean RoatheKnowsReset2",color=orange];
		1097 -> 1099 [label=true,color=green];
		1097 -> 1100 [label=false,color=brown];
	1098 [label="Chat ends.",color=orange];
	1099 [label="Dime. ¿Conseguí convencerte la última vez que hicimos esto de que tu \"Indiferencia\" es solo un montón de juguetes improvisados, o terminaste todo esto creyendo que es una \"gran entidad incognoscible del Vacío\"?",shape=box,color=blue];
		1099 -> 1101;
	1100 [label="Check boolean RoatheMITW1",color=orange];
		1100 -> 1102 [label=true,color=green];
		1100 -> 1103 [label=false,color=brown];
	1101 [label="Si hay algo en este mundo que desprecio, es perseguir mi cola. Y me acabo de dar cuenta que esa metáfora solía ser mucho más proverbial que ahora.",shape=box,color=blue];
		1101 -> 1104;
		1101 -> 1105;
		1101 -> 1106;
	1102 [label="Antes de continuar, me gustaría asegurarme de que todo está claro. ¿Crees que la Indiferencia es una entidad horrible e incognoscible del Vacío, que se filtra en nuestra realidad debido a los errores de Albrecht?",shape=box,color=blue];
		1102 -> 1107;
	1103 [label="Todos con los que hablo en este manicomio están completamente convencidos de que este \"Hombre en la Pared\" es una especie de dios literal y ridículo. Un dios de verdad. ¡Incluso esos dos fanáticos parecen estar considerando la idea!",shape=box,color=blue];
		1103 -> 1108;
		1103 -> 1109;
		1103 -> 1110;
	1104 [label="No lo hiciste, no. Lo siento. ",shape=box,color=red];
		1104 -> 1111;
	1105 [label="En realidad, sí.",shape=box,color=red];
		1105 -> 1112;
	1106 [label="Nunca llegamos a decidirnos por uno u otro lado.",shape=box,color=red];
		1106 -> 1113;
	1107 [label="Permítanme formular mi pregunta así, antes de que nos demos vueltas y nos encontremos otra vez dando vueltas. Es una metáfora que, ahora que me doy cuenta, solía ser mucho más proverbial que ahora, pero me estoy desviando del tema.",shape=box,color=blue];
		1107 -> 1114;
	1108 [label="¿No crees que sea real?",shape=box,color=red];
		1108 -> 1115;
	1109 [label="Y si no crees que es un dios, ¿qué crees que es?",shape=box,color=red];
		1109 -> 1116;
	1110 [label="¿Y tú no?",shape=box,color=red];
		1110 -> 1117;
	1111 [label="Update boolean RoatheMITWSkip",color=orange];
		1111 -> 1118;
	1112 [label="Update boolean RoatheMITWSkip",color=orange];
		1112 -> 1119;
	1113 [label="¡Ah! Bueno, entonces parece que todavía tengo trabajo por hacer.",shape=box,color=blue];
		1113 -> 1120;
	1114 [label="¿Crees que la entidad que ahora llamas la Indiferencia existía antes de que Albrecht la tratara? ¿O crees que la creó al interactuar por primera vez con el Vacío?",shape=box,color=blue];
		1114 -> 1121;
		1114 -> 1122;
		1114 -> 1123;
		1114 -> 1124;
	1115 [label="Ahora bien, ¿acaso dije esas palabras? No me apresures a poner palabras en mi boca, oh Usurpador Transitorio. No negué que la Indiferencia fuera \"real\". Negué que fuera un dios.",shape=box,color=blue];
		1115 -> 1125;
		1115 -> 1126;
	1116 [label="Puedo desenmascarar a esta falsa deidad para ti en dos sencillas palabras que deberías conocer y comprender muy bien:",shape=box,color=blue];
		1116 -> 1127;
	1117 [label="¡Por supuesto que no! Primero, no existen dioses, la idea es absurda. Segundo, ¿pensar que Albrecht liberó a un dios del Vacío? ¡Aún más ridículo!",shape=box,color=blue];
		1117 -> 1128;
	1118 [label="Update boolean RoatheMITW5Real",color=orange];
		1118 -> 1129;
	1119 [label="Update boolean RoatheMITW5Fake",color=orange];
		1119 -> 1130;
	1120 [label="Update boolean RoatheMITW1",color=orange];
		1120 -> 1131;
	1121 [label="No lo sé. Y creo que tú tampoco puedes.",shape=box,color=red];
		1121 -> 1132;
	1122 [label="Creo que era una entidad que existía antes de que Entrati interactuara con ella. Simplemente le dio forma mediante la Encarnación Conceptual.",shape=box,color=red];
		1122 -> 1133;
	1123 [label="Honestamente... no lo sé.",shape=box,color=red];
		1123 -> 1134;
	1124 [label="¿De verdad crees que Entrati creó un dios maligno del Vacío de la nada?",shape=box,color=red];
		1124 -> 1135;
	1125 [label="Esa cosa es más poderosa que cualquier cosa a la que me haya enfrentado jamás.",shape=box,color=red];
		1125 -> 1136;
	1126 [label="¿Qué crees que es entonces?",shape=box,color=red];
		1126 -> 1116;
	1127 [label="Encarnación conceptual.",shape=box,color=blue];
		1127 -> 1137;
		1127 -> 1138;
		1127 -> 1139;
	1128 [label="En el Vacío no hay nada. ¡Por eso se llama el Vacío! ",shape=box,color=blue];
		1128 -> 1140;
		1128 -> 1141;
	1129 [label="+10 Chemistry",color=orange];
		1129 -> 1142;
	1130 [label="+20 Chemistry",color=orange];
		1130 -> 5772;
	1131 [label="Pero, antes de continuar, me gustaría asegurarme de que todo está claro. ¿Crees que la Indiferencia es una entidad horrible e incognoscible del Vacío, que se filtra en nuestra realidad debido a los errores de Albrecht?",shape=box,color=blue];
		1131 -> 1107;
	1132 [label="¡Sí! ¡Puedo! Es tan dolorosamente obvio lo que está pasando, y tan absolutamente ridículo, que todos se han convencido de que hay una bestia enorme arañando la ventana, cuando en realidad no es más que una rama de árbol al viento.",shape=box,color=blue];
		1132 -> 1143;
	1133 [label="Por favor tú no. Tenía tantas esperanzas. Es tan dolorosamente obvio lo que está pasando, y tan absolutamente ridículo, que todos se han convencido de que hay una bestia enorme arañando la ventana, cuando no es más que una rama de árbol al viento.",shape=box,color=blue];
		1133 -> 1143;
	1134 [label="Es tan dolorosamente obvio lo que está sucediendo, y tan absolutamente risible, que todos ustedes se han convencido de que hay una gran bestia arañando la ventana, cuando en realidad no es más que una rama de árbol en el viento.",shape=box,color=blue];
		1134 -> 1143;
	1135 [label="¡Sí! ¡Lo sé! Es tan dolorosamente obvio y tan ridículo que todos se han convencido de que hay una bestia enorme arañando la ventana, cuando en realidad no es más que una rama de árbol al viento.",shape=box,color=blue];
		1135 -> 1143;
	1136 [label="¿Y cuándo lo he negado? De hecho, parece que todos ustedes se han enredado en una tribulación bastante histérica e innecesariamente exagerada.",shape=box,color=blue];
		1136 -> 1144;
		1136 -> 1145;
	1137 [label="El Vacío y lo que podemos crear con él es peligroso y poderoso; créeme, lo sé. Pero tiene límites. ¿De verdad crees que es capaz de manifestar algo así? ¿Qué puede crear lenguajes enteros, dedos que impulsan naves que saltan a través del Vacío?",shape=box,color=red];
		1137 -> 1146;
	1138 [label="Es... muy tentador creer que solo es un monstruo debajo de nuestra cama, Roathe. Pero yo he visto a esa cosa, cara a cara, y no sé cómo algo así puede surgir de nuestra mente.",shape=box,color=red];
		1138 -> 1147;
	1139 [label="La encarnación conceptual no puede hacer lo que el Hombre en la Pared es capaz de hacer. Si bien Entrati pudo haber manifestado eso —y es responsable de traerlo aquí— no creo que sea su fuente original.",shape=box,color=red];
		1139 -> 1148;
	1140 [label="Yo... ",shape=box,color=red];
		1140 -> 1149;
	1141 [label="No. He visto cosas que vienen del Vacío. Ángeles. Cantando. Fantasmas.",shape=box,color=red];
		1141 -> 1149;
	1142 [label="Aunque me decepciona que te mantuvieras firme, tu honestidad me resulta sumamente refrescante. Y me alegra no estar perdiendo el tiempo a medida que avanzamos. Estoy seguro de que encontraremos otras maneras de divertirnos.",shape=box,color=blue];
		1142 -> 1150;
	5772 [label="Fantástico. Me alegra que mi yo anterior fuera tan convincente. Y espero que seas sincero y no me mientas para callarme. Pero no tengo más remedio que creerte.",shape=box,color=blue];
		5772 -> 5773;
	1143 [label="Solo que ahora, debido a la influencia del Vacío, todos le han infundido tanto miedo y poder que, como un bucle de retroalimentación, se ha convertido en esta... Cosa. Este Hombre en la Pared.",shape=box,color=blue];
		1143 -> 1151;
	1144 [label="¿Qué estás diciendo?",shape=box,color=red];
		1144 -> 1152;
	1145 [label="Un momento. ¿Cómo podemos tener la culpa de esto? La culpa es de Albrecht, él lo desató.",shape=box,color=red];
		1145 -> 1153;
	1146 [label="La humanidad, sin duda, es creativa en la amplitud y magnitud de las nuevas formas de sufrimiento que puede idearse a sí misma, ¿no es así? Tú mismo has sido testigo de muchas formas de crueldad que estoy seguro de que nadie podría haber imaginado posibles en la época de nuestros queridos fanáticos.",shape=box,color=blue];
		1146 -> 1154;
	1147 [label="Ah, estás tan cerca de la verdad y, sin embargo, la descartas con tanta facilidad. ¿Crees que es \"tentador\" pensar que es una creación de tu propia mente, ya que así sería más fácil descartarla? No, creo que es mucho más peligroso enfrentarse a una creación nuestra que a un dios.",shape=box,color=blue];
		1147 -> 1155;
	1148 [label="Si bien aprecio tu humildad, cuestiono tu limitada comprensión de la capacidad de la creatividad humana, especialmente en lo que respecta a cómo puede idear nuevas formas de sufrimiento. ¿Acaso no eres tú, por tu cuenta, el responsable de haber creado tu propio universo de la nada?",shape=box,color=blue];
		1148 -> 1156;
	1149 [label="Lo único que proviene del Vacío es lo que depositamos en él, y lo que regresa de él. Transforma la materia y la energía, pero no puede crearlas.",shape=box,color=blue];
		1149 -> 1157;
	1150 [label="Yo, por mi parte, agradezco haberme ahorrado una segunda ronda de debates errantes y circulares sobre los puntos más finos de la Encarnación Conceptual.",shape=box,color=blue];
		1150 -> 1158;
	5773 [label="De cualquier manera, estoy seguro de que encontraremos otras formas de divertirnos en lugar de perdernos en debates errantes y circulares sobre los puntos más finos de la Encarnación Conceptual.",shape=box,color=blue];
		5773 -> 5774;
	1151 [label="Puede que Albrecht haya empezado este disparate, pero todos ustedes son responsables de avivar el fuego hasta que se convirtió en un infierno. La Indiferencia nunca existió. Hasta que, de repente, existió. ",shape=box,color=blue];
		1151 -> 1159;
	1152 [label="Lo que digo es esto: pueda que Albrecht fuera quien originalmente vio reflejada su propia arrogancia como el rostro de un dios de la destrucción sonriente, sí.",shape=box,color=blue];
		1152 -> 1160;
	1153 [label="Pueda que Albrecht fuera quien originalmente vio reflejada su propia arrogancia como el rostro de un dios de la destrucción sonriente, sí.",shape=box,color=blue];
		1153 -> 1160;
	1154 [label="+5 Chemistry",color=orange];
		1154 -> 1161;
	1155 [label="A un enemigo externo se le puede comprender, manipular, derrotar e incluso negociar con él, si fuera necesario. Tiene debilidades que se pueden aprovechar. ¿Pero un enemigo interno? ¿Uno que nosotros mismos hemos creado? Ese es, sin duda, mucho más insidioso.",shape=box,color=blue];
		1155 -> 1162;
	1156 [label="Tú mismo has sido testigo de muchas formas de crueldad que estoy seguro de que nadie podría haber imaginado posibles en la época de nuestros queridos fanáticos. ",shape=box,color=blue];
		1156 -> 1163;
	1157 [label="Piensa, Viajero. Esos \"Ángeles del Vacío\" de los que hablas. Esos fantasmas. ¿Acaso fueron creados de aquellos que ya se perdieron en el Vacío?",shape=box,color=blue];
		1157 -> 1164;
	1158 [label="Aunque eso significa más tiempo para que los fanáticos nos prediquen... ¡bah! Decisiones, decisiones, decisiones...",shape=box,color=blue];
		1158 -> 1165;
	5774 [label="Yo, por mi parte, estoy agradecido de que me hayan evitado una segunda ronda.",shape=box,color=blue];
		5774 -> 1158;
	1159 [label="Y todos ustedes tienen la culpa de ello.",shape=box,color=blue];
		1159 -> 1166;
		1159 -> 1167;
		1159 -> 1168;
	1160 [label="Pero todos somos igualmente culpables por seguir haciendo rodar este excremento de bicho juba cuesta abajo durante tanto tiempo, ¡haciéndolo cada vez más grande con cada pedacito de excremento que recoge por el camino!",shape=box,color=blue];
		1160 -> 1169;
	1161 [label="Como especie, somos bastante asombrosos en nuestra capacidad de alimentar nuestros miedos con nuevas formas de autodestruirnos.",shape=box,color=blue];
		1161 -> 1170;
	1162 [label="+5 Chemistry",color=orange];
		1162 -> 1171;
	1163 [label="+5 Chemistry",color=orange];
		1163 -> 1161;
	1164 [label="No eran más que ecos de energía regurgitada como un colorido kutak para alimentar a sus hijos.",shape=box,color=blue];
		1164 -> 1169;
	1165 [label="Chat ends.",color=orange];
	1166 [label="No podemos crear cosas así, Roathe, te lo dije. La encarnación conceptual tiene sus límites.",shape=box,color=red];
		1166 -> 1172;
	1167 [label="No nos culpen por esto. No tenemos la culpa del daño que eso ha causado.",shape=box,color=red];
		1167 -> 1173;
	1168 [label="Explícame tu razonamiento sobre cómo funcionaría esto. La mayoría de las cosas creadas mediante la Encarnación Conceptual desde el Vacío no pueden abandonarlo, al menos no por mucho tiempo.",shape=box,color=red];
		1168 -> 1174;
	1169 [label="Permíteme simplificar la discusión. Puedo desenmascarar a esta falsa deidad en dos sencillas palabras que deberías conocer y comprender muy bien:",shape=box,color=blue];
		1169 -> 1127;
	1170 [label="Update boolean RoatheMITW1",color=orange];
		1170 -> 1107;
	1171 [label="Porque entonces debemos luchar contra nuestros propios demonios. Y la humanidad... nunca gana esas guerras, ¿verdad?",shape=box,color=blue];
		1171 -> 1170;
	1172 [label="¿Lo dice quien creó una dimensión alternativa entera él solo? Por favor, Viajero... usa tu imaginación como lo hiciste hace tanto tiempo.",shape=box,color=blue];
		1172 -> 1174;
	1173 [label="¡No te estoy reprendiendo! Esto ya llevaba tiempo gestándose antes de que aparecieras. Albrecht se encargó de ello.",shape=box,color=blue];
		1173 -> 1175;
	1174 [label="La Encarnación Conceptual funciona así: al interactuar con el Vacío, o en su proximidad, emociones y pensamientos poderosos pueden manifestarse físicamente. Ambos lo sabemos.",shape=box,color=blue];
		1174 -> 1176;
		1174 -> 1177;
		1174 -> 1178;
	1175 [label="Vio su propio reflejo y conoció el verdadero miedo. Y así surgió la primera chispa que encendió el fuego que amenaza con quemarlo todo. Ustedes simplemente siguen echándole más leña.",shape=box,color=blue];
		1175 -> 1174;
	1176 [label="Correcto. Al igual que Duviri, comparte una conexión con este mundo a través de Zariman. ",shape=box,color=red];
		1176 -> 1179;
	1177 [label="Como la Zariman, los Inquebrantables y los Ángeles del Vacío. El Vacío está por todas partes en esa nave.",shape=box,color=red];
		1177 -> 1179;
	1178 [label="Sí. ¿Y?",shape=box,color=red];
		1178 -> 1180;
	1179 [label="Precisamente. Donde va el Vacío, la Encarnación Conceptual puede seguirlo. Y solo allí.",shape=box,color=blue];
		1179 -> 1181;
		1179 -> 1182;
	1180 [label="Donde va el Vacío, la Encarnación Conceptual puede seguirlo. Y solo allí.",shape=box,color=blue];
		1180 -> 1181;
		1180 -> 1182;
	1181 [label="Pero ya llegó a 1999. Ha seguido a Albrecht a todas partes. Y a mí también.",shape=box,color=red];
		1181 -> 1183;
	1182 [label="Espera...",shape=box,color=red];
		1182 -> 1184;
	1183 [label="Los malditos dedos. Tomamos esos malditos dedos en un intento desesperado y desquiciado por alcanzar a Tau, y nosotros, los orokin, encontramos la manera de replicarlos, ¿no?",shape=box,color=blue];
		1183 -> 1185;
	1184 [label="Sí. Ahora lo ves. Los malditos dedos. Tomamos esos malditos dedos en un intento desesperado y desquiciado por alcanzar a Tau, y nosotros, los orokin, encontramos la manera de replicarlos, ¿no?",shape=box,color=blue];
		1184 -> 1185;
	1185 [label="Pequeños fragmentos del Vacío, por dondequiera que vayas... Una red de trincheras y túneles para que esa cosa aparezca donde quiera. ¿Y peor aún?",shape=box,color=blue];
		1185 -> 1186;
	1186 [label="Los tenno. Y tú. Todos ustedes, tocados por el Vacío. Y todos ustedes, atormentados por esa cosa, pues dondequiera que vayan, puede seguirlos.",shape=box,color=blue];
		1186 -> 1187;
	1187 [label="Y probablemente cualquiera que haya interactuado con él durante algún tiempo. El propio Entrati. Su mayordomo. Los Cavia. Yo mismo, los fanáticos, por nuestra proximidad a este Santuario. La lista continúa.",shape=box,color=blue];
		1187 -> 1188;
		1187 -> 1189;
	1188 [label="¿Entonces estás postulando que cualquiera con suficiente exposición al Vacío, o cualquiera que sea una \"batería\", se convierte en otra ventana para que el Hombre en la Pared mire a través de ella?",shape=box,color=red];
		1188 -> 1190;
	1189 [label="Pero, ¿cómo llegó a Rusalka?, me pregunto.",shape=box,color=red];
		1189 -> 1191;
	1190 [label="Precisamente. ",shape=box,color=blue];
		1190 -> 1192;
	1191 [label="¿Quién?",shape=box,color=blue];
		1191 -> 1193;
		1191 -> 1194;
	1192 [label="Lo cual explicaría por qué no puede mostrar su propia cara, ¿no? Solo puede aparecer como aquellos a quienes atormenta, ante aquellos a quienes intenta atormentar.",shape=box,color=blue];
		1192 -> 1195;
	1193 [label="Mayor Neci Rusalka. Estuvo al mando de la fuerza militar conocida como Scaldra en 1999, en Höllvania.",shape=box,color=red];
		1193 -> 1196;
	1194 [label="En resumen, nunca, jamás, debería permitir que ustedes dos se conozcan.",shape=box,color=red];
		1194 -> 1197;
	1195 [label="De hecho, solo parece revestir el rostro de la arquitectura cuando lucha por mostrarse como algo más grande y diferente, cuando busca desesperadamente apelar a algún sentido de grandiosidad y divinidad.",shape=box,color=blue];
		1195 -> 1198;
		1195 -> 1199;
	1196 [label="Estaba, o está, poseída por la Indiferencia. Está compartiendo su mente, usándola como una marioneta. O ella lo dejó entrar. No lo sabemos. Tampoco sabemos si realmente ha recuperado el control.",shape=box,color=red];
		1196 -> 1200;
	1197 [label="No eres nada divertido, Usurpador. Pero ¿cómo involucra nuestra... indiferencia, precisamente?",shape=box,color=blue];
		1197 -> 1196;
	1198 [label="¿Entonces crees que lleva todas las caras de la gente con la que entra en contacto... porque no tiene una propia?",shape=box,color=red];
		1198 -> 1201;
	1199 [label="Creo que el Hombre en la Pared elige usar nuestras caras porque no puede comprender lo que significa ser humano. De lo contrario, es demasiado \"grande\".",shape=box,color=red];
		1199 -> 1202;
	1200 [label="Parece una persona maravillosamente formidable. Y un encanto absoluto. Pero eso no viene al caso por ahora. ¿Dices que la indiferencia se ha apoderado de su mente? ¿Y esto empezó en tu pequeño viaje al pasado?",shape=box,color=blue];
		1200 -> 1203;
	1201 [label="No, qué tontería. Porque solo imita a quien lo creó. No es una entidad completa; es solo un juguete hecho con piezas dispares de los miedos, temores y sufrimientos que le han inculcado. ",shape=box,color=blue];
		1201 -> 1204;
	1202 [label="No, tontín. Solo imita a quien lo creó. No es una entidad completa; es solo un juguete hecho con piezas dispares de los miedos, temores y sufrimientos que le han inculcado.",shape=box,color=blue];
		1202 -> 1204;
	1203 [label="Bueno, si lo que sabemos del Vacío es cierto, entonces ocurrió una de dos cosas: o bien, ella se topó con alguna instancia del Vacío en 1999 por su propia voluntad (lo cual encuentro profundamente improbable, pero no imposible), o...",shape=box,color=blue];
		1203 -> 1205;
	1204 [label="Bah. Veo que no voy a avanzar nada hoy. No pasa nada, estás profundamente arraigado en la propaganda que te han inculcado. Me temo que Albrecht es un líder de culto muy convincente.",shape=box,color=blue];
		1204 -> 1206;
	1205 [label="Nuestro querido Albrecht estaba entrometiéndose otra vez.",shape=box,color=blue];
		1205 -> 1207;
		1205 -> 1208;
		1205 -> 1209;
	1206 [label="+10 Chemistry",color=orange];
		1206 -> 1210;
	1207 [label="¿Estás insinuando que Albrecht convirtió a Neci en el títere de la Indiferencia a propósito?",shape=box,color=red];
		1207 -> 1211;
	1208 [label="No sabemos si nada de esto es cierto. Nada de eso. Todo esto es pura especulación. Todo esto podría ser pura mentira.",shape=box,color=red];
		1208 -> 1212;
	1209 [label="Si abrió un agujero en el Vacío en 1999 y lo dejó entrar a propósito... eso explicaría por qué los warframes funcionaron allí en primer lugar... lo mismo con tu época... sin el corazón de Deimos, claro está.",shape=box,color=red];
		1209 -> 1213;
	1210 [label="Update boolean RoatheMITW2",color=orange];
		1210 -> 1214;
	1211 [label="Simplemente estoy aquí sentado leyendo hojas de té con los mejores, Usurpador. Lejos de mí insinuar que Albrecht abrió a propósito un agujero en el Vacío en Höllvania y dejó entrar la Indiferencia para darle un avatar propio...",shape=box,color=blue];
		1211 -> 1215;
	1212 [label="¡Claro! Simplemente estoy aquí sentado leyendo hojas de té con los mejores, Usurpador. Lejos de mí insinuar que Albrecht abrió a propósito un agujero en el Vacío en Höllvania y dejó entrar la Indiferencia para darle un avatar propio...",shape=box,color=blue];
		1212 -> 1215;
	1213 [label="¿Lo ves? Nunca confíes en un científico. Están dispuestos a hacer cualquier cosa con tal de perder el tiempo. Pero claro, estoy aquí sentado, leyendo las hojas de té con los mejores, Usurpador. Todo esto es pura postulación.",shape=box,color=blue];
		1213 -> 1216;
	1214 [label="Espero haberte dado al menos algo en qué pensar. Pero por ahora, debo irme.",shape=box,color=blue];
		1214 -> 1217;
	1215 [label="A mí, como estratega y hombre acostumbrado a elaborar estrategias para la guerra...",shape=box,color=blue];
		1215 -> 1218;
	1216 [label="Lejos de mí insinuar que Albrecht abrió a propósito un agujero en el Vacío de Höllvania y dejó entrar a la Indiferencia para darle un avatar propio. Simplemente me parece, como estratega y hombre acostumbrado a la estrategia de guerra...",shape=box,color=blue];
		1216 -> 1218;
