digraph {
	1333 [label="RoatheRank3Convo1 begins.",color=orange];
		1333 -> 1334;
	1334 [label="¿Por fin hablas con nuestro querido Lyon? ¿O sigue ignorándote? Sinceramente, sería mejor que mantuvieras la distancia.",shape=box,color=blue];
		1334 -> 1337;
		1334 -> 1336;
		1334 -> 1335;
	1337 [label="¿No te llevas bien con él?",shape=box,color=red];
		1337 -> 1340;
	1336 [label="Si fueras un poco más amable con Marie y Lyon, ellos podrían ser más amables contigo.",shape=box,color=red];
		1336 -> 1339;
	1335 [label="[Fin]",shape=box,color=red];
		1335 -> 1338;
	1340 [label="Me llevaría mejor con él si se esforzara por comprender un poco más sobre quién soy y de dónde vengo. Soy lo que soy. Y lo he sido durante siglos. No espero cambiar sólo porque me lo exijan ahora.",shape=box,color=blue];
		1340 -> 1341;
	1339 [label="¿Y qué hay de su bondad hacia mí, Usurpador? Soy lo que soy. Y lo he sido durante siglos. No espero cambiar sólo porque me lo exijan ahora.",shape=box,color=blue];
		1339 -> 1341;
	1338 [label="Chat ends.",color=orange];
	1341 [label="Evaluate expressions on HellStory",color=orange];
		1341 -> 1343 [label="x >= 21",color=purple];
		1341 -> 1342 [label="x < 21",color=purple];
		1341 -> 1342 [label="false",color=purple];
	1343 [label="Puede que haya tomado ese suero voluntariamente, pero sé que no me apunté para que esos dos ingratos me acosaran a todas horas.  ",shape=box,color=blue];
		1343 -> 1344;
	1342 [label="¡Estoy así por culpa de Albrecht! Por su culpa estoy atrapado aquí con ellos, ¡no es culpa mía! ¡No tuve nada que ver con este horrible arreglo!",shape=box,color=blue];
		1342 -> 1344;
	1344 [label="Pueden presentar sus quejas ante su preciado \"Cardinal\", no ante mí.",shape=box,color=blue];
		1344 -> 1345;
		1344 -> 1346;
		1344 -> 1347;
	1345 [label="Tienen buenas intenciones, aunque no lo hagan de la mejor manera.",shape=box,color=red];
		1345 -> 1348;
	1346 [label="¿No sientes que necesitas ser perdonado por las cosas que has hecho?",shape=box,color=red];
		1346 -> 1349;
	1347 [label="Sólo están tratando de ayudarte.",shape=box,color=red];
		1347 -> 1350;
	1348 [label="Add -1 to Thermostat",color=orange];
		1348 -> 1351;
	1349 [label="Add 1 to Thermostat",color=orange];
		1349 -> 1352;
	1350 [label="\"Ayudar\". Sí. \"Ayudar\". Disculpa que su forma de \"ayudar\" me parezca completamente \"inútil\".",shape=box,color=blue];
		1350 -> 1353;
	1351 [label="Sí, eso es lo trágico. De verdad creen que intentan hacer el bien.",shape=box,color=blue];
		1351 -> 1354;
	1352 [label="¿Perdonado por quién? ¿Por ti? ¿Por ellos? ¿Por el mayordomo? ¿Por Albrecht? O... ¿por \"los dioses\"?",shape=box,color=blue];
		1352 -> 1355;
		1352 -> 1356;
		1352 -> 1357;
	1353 [label="De hecho, me resultaría más \"útil\" si cambiaran mi vino por un astringente cáustico, Usurpador.",shape=box,color=blue];
		1353 -> 1358;
	1354 [label="¿Y tú qué opinas? ¿Crees que necesito una \"gran redención\"? ¿Un \"santo perdón\"?",shape=box,color=blue];
		1354 -> 1359;
	1355 [label="Estás dejando un punto importante fuera de esa lista.",shape=box,color=red];
		1355 -> 1360;
	1356 [label="Eres un orokin. Has cometido atrocidades en la guerra y, por la naturaleza de tu sociedad, tienes mucho que expiar.",shape=box,color=red];
		1356 -> 1361;
	1357 [label="¿No reconoces al menos que has hecho cosas terribles en tu vida?",shape=box,color=red];
		1357 -> 1362;
	1358 [label="Al menos sería más eficiente.",shape=box,color=blue];
		1358 -> 1363;
	1359 [label="Evaluate expressions",color=orange];
		1359 -> 1364 [label="RoatheTraitor2",color=purple];
		1359 -> 1365 [label="RoatheTraitor2",color=purple];
		1359 -> 1366 [label="RoatheTraitor2",color=purple];
		1359 -> 1367 [label="RoatheTraitor2",color=purple];
		1359 -> 1364 [label="RoatheTraitor1",color=purple];
		1359 -> 1365 [label="RoatheTraitor1",color=purple];
		1359 -> 1366 [label="RoatheTraitor1",color=purple];
		1359 -> 1367 [label="RoatheTraitor1",color=purple];
		1359 -> 1364 [label="RoatheExecutor2",color=purple];
		1359 -> 1365 [label="RoatheExecutor2",color=purple];
		1359 -> 1366 [label="RoatheExecutor2",color=purple];
		1359 -> 1367 [label="RoatheExecutor2",color=purple];
		1359 -> 1364 [label="false",color=purple];
		1359 -> 1365 [label="false",color=purple];
		1359 -> 1366 [label="false",color=purple];
	1360 [label="Por favor, dímelo. ",shape=box,color=blue];
		1360 -> 1368;
		1360 -> 1369;
		1360 -> 1370;
	1361 [label="No me disculparé por la sociedad orokin, pues no fui su creador. Sólo fui un habitante. Y si culparas a todos los que participan en un sistema cuya única culpa es haber nacido en él, condenarías a miles de millones de personas en tu altiva hipocresía. ¿Y qué hay del resto?",shape=box,color=blue];
		1361 -> 1371;
	1362 [label="¿Y si ya lo hice? No puedo cambiarlo ahora. ¿De qué sirve sentirme culpable?",shape=box,color=blue];
		1362 -> 1372;
		1362 -> 1373;
	1363 [label="Aunque, de los dos, prefiero al sacerdote, debo admitirlo. Él atiende a razones. Quizás con el tiempo admita que la Indiferencia no es un dios real.",shape=box,color=blue];
		1363 -> 1374;
	1364 [label="Creo que vale la pena reflexionar sobre nuestras acciones que han dañado a la gente e intentar comprender cómo remediarlas. Pero no creo que esos dos lo estén haciendo bien en absoluto.",shape=box,color=red];
		1364 -> 1375;
	1365 [label="En definitiva, no creo que debas perdonar a nadie más que a ti mismo. Si estás en paz con tus acciones, mucho mejor.",shape=box,color=red];
		1365 -> 1376;
	1366 [label="Naciste en una sociedad donde muchos comportamientos orokin eran simplemente... normales. Esperados. No eran \"incorrectos\" para ti. No digo que eso los haga aceptables, sólo comprensibles.",shape=box,color=red];
		1366 -> 1377;
	1367 [label="Querías derrocar a los orokin. Sabías que eran corruptos y tratabas de arreglarlos.",shape=box,color=red];
		1367 -> 1378;
	1368 [label="Tú mismo.",shape=box,color=red];
		1368 -> 1379;
	1369 [label="Tu propia gente, a quien estabas a punto de traicionar.",shape=box,color=red];
		1369 -> 1380;
	1370 [label="Los conscientes que masacraste.",shape=box,color=red];
		1370 -> 1371;
	1371 [label="Era una guerra. Y es propio de la guerra matar en masa a quienes combates. ¿Lloras por los grineer o por los \"corpus\" que matas?",shape=box,color=blue];
		1371 -> 1381;
		1371 -> 1382;
		1371 -> 1383;
	1372 [label="El perdón de los demás es importante.",shape=box,color=red];
		1372 -> 1384;
	1373 [label="Puedes cambiar tu comportamiento futuro.",shape=box,color=red];
		1373 -> 1385;
	1374 [label="De hecho, incluso podría convencerlo de que desmantelara toda su religión. ¡Ah, sí! Un hombre que ve las alucinaciones tan extravagantes como sangrientas, pero que también posee sentido común y lógica. ¡Qué raro!",shape=box,color=blue];
		1374 -> 1386;
		1374 -> 1387;
	1375 [label="Mm. Ya veo. No es la acción, sino el método lo que te molesta. Por lo tanto, retiro mi aprobación anterior y la reemplazo por consternación.",shape=box,color=blue];
		1375 -> 1388;
	1376 [label="Update boolean RoatheVillainSelf",color=orange];
		1376 -> 1389;
	1377 [label="Update boolean RoatheVillainOrokin",color=orange];
		1377 -> 1389;
	1378 [label="Así que creo que incluso si hubieras planeado remodelar el imperio a tu imagen, sabías que tenía que cambiar.",shape=box,color=red];
		1378 -> 1390;
		1378 -> 1391;
	1379 [label="Check boolean RoatheKnowsReset2",color=orange];
		1379 -> 1392 [label=true,color=green];
		1379 -> 1393 [label=false,color=brown];
	1380 [label="Nunca he perdido el sueño por la culpa de traicionar a mi pueblo, Usurpador. Créeme.",shape=box,color=blue];
		1380 -> 1394;
	1381 [label="No. Pero los conscientes son una historia diferente.",shape=box,color=red];
		1381 -> 1395;
	1382 [label="Sí.",shape=box,color=red];
		1382 -> 1396;
	1383 [label="Lo que siento sobre las vidas que tengo que quitar no es asunto tuyo. Estamos hablando de ti.",shape=box,color=red];
		1383 -> 1397;
	1384 [label="¿Por qué? ¿Para que me dejen en paz? ¿Para no convertirme en una especie de... paria? ¿Un marginado social? ",shape=box,color=blue];
		1384 -> 1398;
	1385 [label="Aprender de los propios errores es esencial, sin duda. Pero no es necesario sentirse culpable para comprender el fracaso.",shape=box,color=blue];
		1385 -> 1399;
	1386 [label="Parece que Lyon ya tiene suficientes problemas que afrontar, ¿no crees?",shape=box,color=red];
		1386 -> 1400;
	1387 [label="Disculpa, ¿que haces qué?",shape=box,color=red];
		1387 -> 1401;
	1388 [label="Chat ends.",color=orange];
	1389 [label="Tu contexto era diferente al nuestro. Y lo que nosotros consideramos cruel y terrible, a ti te criaron para percibirlo como una simple realidad del mundo.",shape=box,color=red];
		1389 -> 1402;
	1390 [label="Esto no justifica todo lo que has hecho, las tragedias son tragedias y los horrores son horrores. Pero lo intentabas.",shape=box,color=red];
		1390 -> 1403;
	1391 [label="Desde mi perspectiva, estabas en guerra, intentando desenvolverte en una sociedad de sociópatas, mientras conspirabas para derrocarlos. Y por eso, te etiquetaron como un demonio. No me parece justo.",shape=box,color=red];
		1391 -> 1404;
	1392 [label="Por haber huido.",shape=box,color=red];
		1392 -> 1405;
	1393 [label="Por haber fallado.",shape=box,color=red];
		1393 -> 1405;
	1394 [label="No pediré perdón por el Imperio orokin, pues no soy su creador, sino simplemente un habitante. Pero tampoco asumiré la culpa por conspirar para destruirlo a mi alrededor. Nos merecíamos lo que nos pasó, y aún peor.",shape=box,color=blue];
		1394 -> 1406;
	1395 [label="Cada situación es diferente, Usurpador. El contexto siempre es la clave. Y simplemente estás mirando la \"Antigua Guerra\" con la claridad que da la retrospectiva.",shape=box,color=blue];
		1395 -> 1407;
	1396 [label="Entonces, siento una inmensa compasión por ti, Usurpador, y te sugiero que aceptes lo que se te ha encomendado hacer o que te retires de esta vida y te dediques a la agricultura.",shape=box,color=blue];
		1396 -> 1408;
	1397 [label="Mm. Me encanta cuando demuestras tan claramente que te he provocado, es simplemente delicioso. Desvías la conversación con torpeza.",shape=box,color=blue];
		1397 -> 1409;
	1398 [label="Mírame, Usurpador. Mira lo que soy. Un orokin, expulsado de su imperio.",shape=box,color=blue];
		1398 -> 1410;
	1399 [label="¿Y qué sentido tiene el perdón, al fin y al cabo? ¿De quién debo esforzarme por ser perdonado? ¿De los demás? ¿Para no ser algún tipo de anatema?",shape=box,color=blue];
		1399 -> 1398;
	1400 [label="¡Y eso es precisamente lo que buscaba para ayudarlo! Sólo intento ayudarlo a superar algunas de sus dudas sobre la Indiferencia y lo que Entrati le dijo.",shape=box,color=blue];
		1400 -> 1411;
	1401 [label="Absolutamente nada malo, independientemente de lo que te diga ese molesto mosquito. Sólo intento ayudarlo a superar la incertidumbre sobre lo que le dijeron la Indiferencia y Entrati.",shape=box,color=blue];
		1401 -> 1411;
	1402 [label="+10 Chemistry",color=orange];
		1402 -> 1412;
	1403 [label="Update boolean RoatheVillainOrokin",color=orange];
		1403 -> 1402;
	1404 [label="Update boolean RoatheVillainShortcut",color=orange];
		1404 -> 1413;
	1405 [label="Update boolean RoatheForgivenessShortcut",color=orange];
		1405 -> 1414;
	1406 [label="Si de algo me siento culpable, es de que los tenno fueran los responsables de quemarlo todo, y no yo.",shape=box,color=blue];
		1406 -> 1415;
	1407 [label="Si juzgas las acciones pasadas de las personas con toda la información que tienes sobre el futuro, te perjudicarás constantemente.",shape=box,color=blue];
		1407 -> 1416;
	1408 [label="Sin embargo, sería una pena. Es divertidísimo verte trabajar. No es que seas muy eficiente, pero sí maravillosamente llamativo.",shape=box,color=blue];
		1408 -> 1417;
	1409 [label="Sin embargo, supongo que pasar siglos en aislamiento, sin nadie con quién hablar salvo las creaciones imaginarias del cuento de hadas en tu mente, limita las posibilidades de perfeccionar las habilidades sociales.",shape=box,color=blue];
		1409 -> 1418;
	1410 [label="Fui \"el Diablo de Tau\" en mi época. Y aquí, soy \"el diablo\" para todos los que me conocen.",shape=box,color=blue];
		1410 -> 1419;
	1411 [label="Entrati le dijo que sus \"visiones\" no eran obra de Lua, sino de la Indiferencia. Esto lo hunde en una especie de \"crisis de fe\".",shape=box,color=blue];
		1411 -> 1420;
	1412 [label="Es bueno saber que los conceptos de matiz y sutileza no está tan olvidados después de todo. Sí, tienes toda la razón. Son producto de otra época, de otra sociedad.",shape=box,color=blue];
		1412 -> 1421;
	1413 [label="+20 Chemistry",color=orange];
		1413 -> 1422;
	1414 [label="+10 Chemistry",color=orange];
		1414 -> 1423;
	1415 [label="Update boolean RoatheForgivenessNoGuilt",color=orange];
		1415 -> 1424;
	1416 [label="Acepta el pasado y sigue adelante.",shape=box,color=blue];
		1416 -> 1425;
	1417 [label="Al menos haces que el campo de batalla sea \"divertido\". ",shape=box,color=blue];
		1417 -> 1425;
	1418 [label="Ve a entrenar con el sacerdote, ambos necesitan práctica. ",shape=box,color=blue];
		1418 -> 1426;
	1419 [label="Albrecht pensó que sería mejor asegurarse de que el apodo fuera permanente. ",shape=box,color=blue];
		1419 -> 1425;
	1420 [label="Sin embargo, intento convencerlo de que no es así y de que ningún \"dios\" los envió, porque los \"dioses\" no existen. Él simplemente no está bien.",shape=box,color=blue];
		1420 -> 1427;
		1420 -> 1428;
	1421 [label="Sin embargo, pude reconocer la crueldad y las atrocidades cometidas por mi pueblo tal como eran. Hubo horrores perpetrados por muchos de los míos que ni siquiera yo pude soportar.",shape=box,color=blue];
		1421 -> 1429;
	1422 [label="Sabía que te amaba por algo, Usurpador. ¡Por fin! ¡Alguien que me aprecia! Y sólo llevó... ¡¿cuántos siglos fueron?!",shape=box,color=blue];
		1422 -> 1430;
	1423 [label="Chat ends.",color=orange];
	1424 [label="+10 Chemistry",color=orange];
		1424 -> 1431;
	1425 [label="Mi consejo: erradica toda culpa de tu corazón, como hice yo. Dale con la espada hasta que muera.",shape=box,color=blue];
		1425 -> 1432;
	1426 [label="+5 Chemistry",color=orange];
		1426 -> 1433;
	1427 [label="¿Te pidió ayuda Lyon?",shape=box,color=red];
		1427 -> 1434;
	1428 [label="¿Y crees que eso mejora su situación?",shape=box,color=red];
		1428 -> 1435;
	1429 [label="Pero estas preguntas son… complejas. Y me alegra que lo entiendas. Bah. El mayordomo me mira fijamente. Tengo que terminar esta conversación. Nos vemos luego.",shape=box,color=blue];
		1429 -> 1436;
	1430 [label="Bah. El mayordomo me mira fijamente. Tengo que terminar esta conversación. Hablamos pronto.",shape=box,color=blue];
		1430 -> 1437;
	1431 [label="Chat ends.",color=orange];
	1432 [label="La culpa no es más que un traidor que acecha en las sombras, robándote todo lo que amas. Sólo te daña.",shape=box,color=blue];
		1432 -> 1438;
	1433 [label="Chat ends.",color=orange];
	1434 [label="No se negó a escuchar. No me dijo que me callara. Lo haría si me lo pidiera.",shape=box,color=blue];
		1434 -> 1439;
	1435 [label="¿Es mejor dejar que personas con inclinaciones religiosas lo manipulen simplemente porque pueden? ¿Apuntar con el dedo a sus alucinaciones y etiquetarlas como \"visiones\" en lugar de ayudarlo?",shape=box,color=blue];
		1435 -> 1440;
	1436 [label="Chat ends.",color=orange];
	1437 [label="Chat ends.",color=orange];
	1438 [label="Update boolean RoatheForgivenessNoGuilt",color=orange];
		1438 -> 1441;
	1439 [label="Me indigna ver cómo quienes rodean a Lyon lo usan y lo manipulan, sin darse cuenta o no. Y todo en nombre de la \"religión\" y las \"creencias\".",shape=box,color=blue];
		1439 -> 1440;
	1440 [label="He estado leyendo los relatos de lo sucedido. Ese... \"Velo Rojo\" pudo haber intentado rescatar a ese tenno, prisionero en su Harrow durante todos esos siglos. Pero no lo hicieron. Lo dejaron marchitarse y morir.",shape=box,color=blue];
		1440 -> 1442;
	1441 [label="+10 Chemistry",color=orange];
		1441 -> 1443;
	1442 [label="¿Por qué? Para protegerse de un... hipotético \"Dios del Vacío\".",shape=box,color=blue];
		1442 -> 1444;
		1442 -> 1445;
	1443 [label="Chat ends.",color=orange];
	1444 [label="¿Crees que el sacrificio de Rell fue en vano?",shape=box,color=red];
		1444 -> 1446;
	1445 [label="Rell fue lo único que le detuvo durante todos esos años.",shape=box,color=red];
		1445 -> 1447;
	1446 [label="No. Nos estaba protegiendo de algo. Pero ¿quién sabe cuánto empeoró la situación? ¿Quién sabe cuánto alimentó esa situación con su propio miedo y ansiedad, todos esos siglos después?",shape=box,color=blue];
		1446 -> 1448;
	1447 [label="O quizás fue él el único que lo alimentó durante todos esos años.",shape=box,color=blue];
		1447 -> 1448;
	1448 [label="La Encarnación Conceptual sólo manifiesta lo que se le da. Y el Vacío sólo puede funcionar con la materia que se le ofrece.",shape=box,color=blue];
		1448 -> 1449;
	1449 [label="Me pregunto cuánto invirtió este tenno en su propia existencia. Era un verdadero festín de agonía, dolor, traición, tristeza... y soledad...",shape=box,color=blue];
		1449 -> 1450;
	1450 [label="Y el entumecimiento que debe acompañar los miles de años pasados ​​en soledad en este lugar, hablando al Vacío. ¿Qué resulta de ello, sino indiferencia?",shape=box,color=blue];
		1450 -> 1451;
		1450 -> 1452;
	1451 [label="Es posible que lo que dices sea cierto. No sé si lo sea... pero tampoco sé si no lo es.",shape=box,color=red];
		1451 -> 1453;
	1452 [label="Tenía mucho poder incluso antes de llegar a Rell. Él no se habría sacrificado así sin una buena razón.",shape=box,color=red];
		1452 -> 1454;
	1453 [label="+10 Chemistry",color=orange];
		1453 -> 1455;
	1454 [label="Como con las pesadillas infantiles. Para un niño de seis años, son las criaturas más poderosas del universo. Pero para un adulto, son sólo una nube de polvo atrapada en un respiradero, flotando demasiado cerca de la luz.",shape=box,color=blue];
		1454 -> 1456;
	1455 [label="No creo que pueda pedirles más que simplemente admitir que no saben con certeza a qué nos enfrentamos.",shape=box,color=blue];
		1455 -> 1457;
	1456 [label="Hacemos montañas de un grano de arena simplemente porque necesitamos una razón para ser infelices y autodestruirnos.",shape=box,color=blue];
		1456 -> 1458;
	1457 [label="Es un punto de partida fantástico. Y una cualidad admirable en cualquier persona: la simple capacidad de decir... \"no lo sé\".",shape=box,color=blue];
		1457 -> 1459;
	1458 [label="La humanidad de un vistazo.",shape=box,color=blue];
		1458 -> 1460;
	1459 [label="Si los orokin hubiéramos podido demostrarlo de vez en cuando, podríamos haber sobrevivido.",shape=box,color=blue];
		1459 -> 1460;
	1460 [label="Update boolean RoatheMITW3",color=orange];
		1460 -> 1461;
	1461 [label="+10 Chemistry",color=orange];
		1461 -> 1462;
	1462 [label="Chat ends.",color=orange];
}