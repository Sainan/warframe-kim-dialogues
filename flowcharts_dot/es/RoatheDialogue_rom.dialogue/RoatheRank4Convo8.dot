digraph {
	graph [fontname="Roboto Condensed"];
	node [fontname="Roboto Condensed"];
	edge [fontname="Roboto Condensed"];

	"RoatheRank4Convo8 begins." [color=orange];
		"RoatheRank4Convo8 begins." -> j3145706349;
		"RoatheRank4Convo8 begins." -> j202800200;
	j3145706349 [label="¿Cómo fue tu infancia, Roathe?",shape=box,color=red];
		j3145706349 -> j879619091;
	j202800200 [label="[Fin]",shape=box,color=red];
		j202800200 -> "Chat ends.";
	j879619091 [label="¿Hm? Una pregunta interesante. ¿Que cómo fue? Sinceramente, no recuerdo mucho. Y supongo que las estrellas y esculturas que contenían esos recuerdos ya se han convertido en polvo o se han convertido en Endo.",shape=box,color=blue];
		j879619091 -> j1747837577;
	"Chat ends." [color=orange];
	j1747837577 [label="Me temo que sólo recuerdo breves imágenes, pues fue hace tanto tiempo. Me pregunto si no habrá sido un sueño o si estuviera atribuyendo imágenes a los acontecimientos que he leído en un libro de historia.",shape=box,color=blue];
		j1747837577 -> j1118707672;
	j1118707672 [label="Por lo tanto, lo que recuerdo probablemente es muy poco fiable, lo admito. ¿Por qué lo preguntas?",shape=box,color=blue];
		j1118707672 -> j1331021516;
		j1118707672 -> j3555337424;
		j1118707672 -> j3194349255;
	j1331021516 [label="Aunque las historias sean falsas, siguen siendo lo que te cuentas a ti mismo sobre tus años de formación. Aun así, vale la pena conocerlas.",shape=box,color=red];
		j1331021516 -> j2387320886;
	j3555337424 [label="Tengo curiosidad por saber cómo fue crecer como noble orokin.",shape=box,color=red];
		j3555337424 -> j135900194;
	j3194349255 [label="Me pregunto qué te hizo ser así. Cómo llegaste a ser así.",shape=box,color=red];
		j3194349255 -> j3327843933;
	j2387320886 [label="+5 Chemistry",color=orange];
		j2387320886 -> j343365644;
	j135900194 [label="Me enviaron a lo que los fanáticos llamarían un \"internado\" a temprana edad, como a todos los jóvenes orokin destinados a la grandeza. Allí me pusieron a prueba y me entrenaron para desarrollar mis inclinaciones y aptitudes.",shape=box,color=blue];
		j135900194 -> j1486310637;
		j135900194 -> j1991846655;
	j3327843933 [label="+5 Chemistry",color=orange];
		j3327843933 -> j3366793408;
	j343365644 [label="Estoy de acuerdo, las mentiras que nos decimos a nosotros mismos suelen ser más importantes que la verdad. Una reflexión maravillosa, Usurpador.",shape=box,color=blue];
		j343365644 -> j2888551047;
	j1486310637 [label="¿Tus padres simplemente te enviaron lejos? ¿Por cuánto tiempo?",shape=box,color=red];
		j1486310637 -> j1329461794;
	j1991846655 [label="¿Cómo era allí?",shape=box,color=red];
		j1991846655 -> j3038080066;
	j3366793408 [label="¿Intentas adivinar dónde me desvié del camino? ¡Ya veo! Qué gracioso. No lo sé, porque encontrarás muchas cosas en mi infancia que te darán las respuestas que buscas.",shape=box,color=blue];
		j3366793408 -> j116816225;
	j2888551047 [label="Add -1 to Thermostat counter",color=orange];
		j2888551047 -> j135900194;
	j1329461794 [label="Toda mi juventud. No creo haber vuelto a ver a los dos que me engendraron. ¿O quizás en la ceremonia en la que me anunciaron como el mejor de la clase?",shape=box,color=blue];
		j1329461794 -> j2974934136;
	j3038080066 [label="Creo que la opinión variaría enormemente según con quién hablaras. Cuando llegué, las palizas que recibí de los chicos mayores eran rápidas y las lecciones, brutalmente eficaces.",shape=box,color=blue];
		j3038080066 -> j4072355973;
	j116816225 [label="Add 1 to Thermostat counter",color=orange];
		j116816225 -> j135900194;
	j2974934136 [label="Creo que esa fue la primera vez que consideraron oportuno reclamarme. No le presto mucha atención.",shape=box,color=blue];
		j2974934136 -> j129677189;
	j4072355973 [label="Pero aprendo rápido, para todo. Y aprendí que, si quería sobresalir en esa rama particular de los arquimedianos, mejor aplicaba técnicas creativas para no quedarme atrás.",shape=box,color=blue];
		j4072355973 -> j2684787711;
		j4072355973 -> j618713002;
	j129677189 [label="No recuerdo mucho de mis padres. Mientras que algunos orokin deseaban criar a sus propios descendientes, los míos no. Estaban ansiosos por librarse de mí y seguir adelante con sus vidas.",shape=box,color=blue];
		j129677189 -> j648102132;
		j129677189 -> j2421945387;
	j2684787711 [label="¿Los arquimedianos permitieron que esto sucediera?",shape=box,color=red];
		j2684787711 -> j2636762166;
	j618713002 [label="Eso es... horrible.",shape=box,color=red];
		j618713002 -> j2163794088;
	j648102132 [label="No parece haberte afectado de ninguna manera en la vida.",shape=box,color=red];
		j648102132 -> j126129961;
	j2421945387 [label="Lo siento. Parece una forma triste de ser.",shape=box,color=red];
		j2421945387 -> j126129961;
	j2636762166 [label="Mi pobre Usurpador, fue el propio director quien trajo una botella de Kuva y uno de los sirvientes cuando las cosas fueron demasiado lejos con uno de los nuevos iniciados una noche.",shape=box,color=blue];
		j2636762166 -> j3067167912;
	j2163794088 [label="La tradición es una herramienta poderosa, Usurpador. Una herramienta poderosa y peligrosa que puede usarse para mantener a muchos hombres cuerdos atrapados en formas de pensar descabelladas.",shape=box,color=blue];
		j2163794088 -> j4265494759;
	j126129961 [label="Todo lo contrario. Debido a mi falta de vínculos familiares, tuve más tiempo para dedicarme a las estrategias militaristas que a mis compañeros les parecían arcaicas y anticuadas. ",shape=box,color=blue];
		j126129961 -> j3640239453;
	j3067167912 [label="La tradición es una herramienta poderosa. Una herramienta poderosa y peligrosa que puede usarse para mantener a muchos hombres cuerdos atrapados en formas de pensar descabelladas.",shape=box,color=blue];
		j3067167912 -> j234697802;
		j3067167912 -> j1466382369;
	j4265494759 [label="Fue el propio director quien trajo una botella de Kuva y uno de los sirvientes cuando las cosas fueron demasiado lejos con uno de los nuevos iniciados una noche.",shape=box,color=blue];
		j4265494759 -> j234697802;
		j4265494759 -> j1466382369;
	j3640239453 [label="Lo que no sabían era lo mucho que eso me ayudaría en el futuro.",shape=box,color=blue];
		j3640239453 -> j2269730131;
		j3640239453 -> j4064605594;
	j234697802 [label="¿Y tus padres?",shape=box,color=red];
		j234697802 -> j129677189;
	j1466382369 [label="¿Tenías amigos allí?",shape=box,color=red];
		j1466382369 -> j3822728331;
	j2269730131 [label="¿Crees que valió la pena?",shape=box,color=red];
		j2269730131 -> j1291789265;
	j4064605594 [label="Sin embargo, parece como si hubieras vivido una vida solitaria.",shape=box,color=red];
		j4064605594 -> j3936625857;
	j3822728331 [label="No. Me lo guardé para mí. Aprendí que el miedo es fácil de despertar y manipular en los demás, pero que es como un delicado hielo que se derrite al más mínimo contacto con la luz.",shape=box,color=blue];
		j3822728331 -> j2487836370;
	j1291789265 [label="Mis colegas no tenían ni idea de cuánto me ayudarían estos estudios en el futuro. Pero ¿preguntas si al final fue una ganancia o una pérdida?",shape=box,color=blue];
		j1291789265 -> j2740042986;
	j3936625857 [label="Sí, lo admito. Pero así son las cosas cuando vives como un demonio, ¿no? Incluso entonces, me veían como una víctima indefensa y un concubino o como un caudillo sangriento y monstruo desenfrenado.",shape=box,color=blue];
		j3936625857 -> j1060934061;
	j2487836370 [label="Hay que mantener a los monstruos en la oscuridad. Y si quería mantener un aura de peligro a mi alrededor, tendría que quedarme solo.",shape=box,color=blue];
		j2487836370 -> j648102132;
		j2487836370 -> j2421945387;
	j2740042986 [label="Hm. No lo sé.",shape=box,color=blue];
		j2740042986 -> j1136480256;
		j2740042986 -> j1000969238;
	j1060934061 [label="Nunca fui bien recibido ni por encima ni por debajo de mi posición social. Y no tenía iguales con quienes hablar.",shape=box,color=blue];
		j1060934061 -> j299591844;
	j1136480256 [label="Tienes otra oportunidad para compensar lo que has hecho. Ellos no. ",shape=box,color=red];
		j1136480256 -> j3953160341;
	j1000969238 [label="Bueno, ellos están muertos y tú no. Así que supongo que sí.",shape=box,color=red];
		j1000969238 -> j3211136420;
	j299591844 [label="Boolean RoatheUnloved2 is now true.",color=orange];
		j299591844 -> j2254643307;
		j299591844 -> j1635569646;
	j3953160341 [label="Add 1 to Thermostat counter",color=orange];
		j3953160341 -> j1461258597;
	j3211136420 [label="Add -1 to Thermostat counter",color=orange];
		j3211136420 -> j1461258597;
	j2254643307 [label="Tienes otra oportunidad para compensar lo que has hecho. Ellos no.",shape=box,color=red];
		j2254643307 -> j3953160341;
	j1635569646 [label="Bueno, al menos tienes el resto de tu futuro para decidir cómo quieres vivirlo. Ellos no.",shape=box,color=red];
		j1635569646 -> j3211136420;
	j1461258597 [label="+5 Chemistry",color=orange];
		j1461258597 -> j4063562850;
	j4063562850 [label="Supongo que ya lo veremos, ¿no?",shape=box,color=blue];
		j4063562850 -> "Chat ends.";
}