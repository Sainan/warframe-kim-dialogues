		j2928235740 -> j703967810;
	j849968970 [label="Sólo digo que es un poco gracioso que lo digas como un insulto, cuando eres culpable de lo mismo.",shape=box,color=red];
		j849968970 -> j2601356692;
	j4019276788 [label="Sólo estoy tratando de entender por qué sigues usándolo como título para mí.",shape=box,color=red];
		j4019276788 -> j3933854117;
	j2915550790 [label="¡Ja! ¡Para nada! Eres extremadamente paciente si crees que llevo días insultándote en la cara con tanta naturalidad. ",shape=box,color=blue];
		j2915550790 -> j2389195802;
	j703967810 [label="Bueno, es lo que eres, ¿no? Los tenno usurparon el Sistema Origen de los orokin. Y tú, como un pequeño impostor en el nido, te has colado en este mundo desde el tuyo.",shape=box,color=blue];
		j703967810 -> j4115588501;
	j2601356692 [label="¡Ja! ¿Un insulto? Eres muy paciente si crees que llevo días burlándome de ti con tanta naturalidad.",shape=box,color=blue];
		j2601356692 -> j1583718725;
	j3933854117 [label="+5 Chemistry",color=orange];
		j3933854117 -> j1421700276;
	j2389195802 [label="Check boolean RoatheKnowsReset2",color=orange];
		j2389195802 -> j2043575402 [label=true,color=green];
		j2389195802 -> j1145738916 [label=false,color=brown];
	j4115588501 [label="Y eso te convierte, al menos por dos razones, en un usurpador a mi juicio. (Y quizás por una tercera, si contamos lo que el mayordomo me ha contado de Duviri, pero ese es un debate para otro momento).",shape=box,color=blue];
		j4115588501 -> j3487740023;
		j4115588501 -> j4145826956;
	j1583718725 [label="Check boolean RoatheKnowsReset2",color=orange];
		j1583718725 -> j2005590645 [label=true,color=green];
		j1583718725 -> j3468935624 [label=false,color=brown];
	j1421700276 [label="Porque eso es lo que es: un título. Un honorífico. Has logrado lo que yo anhelaba. ",shape=box,color=blue];
		j1421700276 -> j3189792644;
	j2043575402 [label="En particular cuando es tan evidente que tienes mucho poder en esta situación que difícilmente es unilateral, ¿eh?",shape=box,color=blue];
		j2043575402 -> j3787788472;
	j1145738916 [label="Especialmente cuando sé que podrías simplemente usar tus poderes del Vacío para atravesar una pared y ponerme unas cuantas balas en la nuca en cualquier momento.",shape=box,color=blue];
		j1145738916 -> j3787788472;
	j3487740023 [label="Entonces... me estás insultando.",shape=box,color=red];
		j3487740023 -> j2601356692;
	j4145826956 [label="Okey. Entonces, ¿por qué seguir usándolo como título?",shape=box,color=red];
		j4145826956 -> j3933854117;
	j2005590645 [label="En particular cuando es tan evidente que tienes mucho poder en esta situación que difícilmente es unilateral, ¿eh?",shape=box,color=blue];
		j2005590645 -> j3850385529;
	j3468935624 [label="Especialmente cuando sé que podrías simplemente usar tus poderes del Vacío para atravesar una pared y ponerme unas cuantas balas en la nuca en cualquier momento.",shape=box,color=blue];
		j3468935624 -> j3850385529;
	j3189792644 [label="El título es solo una expresión de mi leve admiración. Aunque sea lo suficientemente sarcástico para mis necesidades, sí, lo admito.",shape=box,color=blue];
		j3189792644 -> j3921242061;
		j3189792644 -> j1558434211;
		j3189792644 -> j3685513049;
		j3189792644 -> j2505741822;
	j3787788472 [label="No estoy de humor para convertirte en mi enemigo, Usurpador. No. No es un insulto. Es por tu propia falta de diligencia que no te has dado cuenta de que gran parte de mi pasado coincide con el tuyo.",shape=box,color=blue];
		j3787788472 -> j532386590;
	j3850385529 [label="No estoy de humor para convertirte en mi enemigo, Usurpador. No. En todo caso, es un honorífico. Has hecho lo que yo aspiraba. Nada más.",shape=box,color=blue];
		j3850385529 -> j3189792644;
	j3921242061 [label="¿Todos los orokin eran como tú?",shape=box,color=red];
		j3921242061 -> j2178684721;
	j1558434211 [label="Si te pidiera amablemente que me llamaras de otra manera, ¿lo harías?",shape=box,color=red];
		j1558434211 -> j560727726;
	j3685513049 [label="Puedo manejarlo.",shape=box,color=red];
		j3685513049 -> j3260481604;
	j2505741822 [label="Deja de llamarme Usurpador.",shape=box,color=red];
		j2505741822 -> j117259008;
	j532386590 [label="Estaba decidido a derrocar a los orokin, igual que tu réplica tenno y sus semejantes. La línea temporal me detuvo antes de que tuviera la oportunidad.",shape=box,color=blue];
		j532386590 -> j765362173;
