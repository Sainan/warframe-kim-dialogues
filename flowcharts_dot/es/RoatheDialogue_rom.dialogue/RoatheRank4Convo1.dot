		j765362173 -> j3189792644;
	j987487314 [label="¡Ja! Casi pude oír el suspiro del Sanctum. ¿Que si eran todos como yo? No. Eran muy inferiores. Y mucho más exasperantes, me temo.",shape=box,color=blue];
		j987487314 -> j2717213005;
