digraph {
	graph [fontname="Roboto Condensed"];
	node [fontname="Roboto Condensed"];
	edge [fontname="Roboto Condensed"];

	"RoatheRank3Convo5 begins." [color=orange];
		"RoatheRank3Convo5 begins." -> j1302637858;
	j1302637858 [label="Albrecht siempre fue un problema desde el principio. Él y todo este asunto del Vacío. Creo que le dieron a Gerivaine con la esperanza de que formar una familia simplemente lo ayudara a asentarse.",shape=box,color=blue];
		j1302637858 -> j2950560006;
	j2950560006 [label="Creo que, en cambio, simplemente empeoró las cosas. Una vez que tuvo hijos, los consideró como un par de manos extra. Cómplices de sus locos experimentos.",shape=box,color=blue];
		j2950560006 -> j3603396322;
	j3603396322 [label="Prescindibles. Como todas las cosas en su vida.",shape=box,color=blue];
		j3603396322 -> j1187536647;
		j3603396322 -> j2601335807;
		j3603396322 -> j202800200;
	j1187536647 [label="¿Gerivaine?",shape=box,color=red];
		j1187536647 -> j1079247192;
	j2601335807 [label="Él ve a las personas como algo más que simples objetos desechables.",shape=box,color=red];
		j2601335807 -> j998438824;
	j202800200 [label="[Fin]",shape=box,color=red];
		j202800200 -> "Chat ends.";
	j1079247192 [label="Un nombre que quizá se haya perdido en los anales del tiempo... La esposa de Albrecht Entrati, Usurpador. La madre de sus hijos.",shape=box,color=blue];
		j1079247192 -> j4103666644;
	j998438824 [label="Muy bien, admito que asesinará a cualquiera y a cualquier cosa en su vida con la frialdad de cualquier ejecutor. Pero no lo hará sin un propósito.",shape=box,color=blue];
		j998438824 -> j3456571108;
	"Chat ends." [color=orange];
	j4103666644 [label="Check boolean LoidFamilyComplete",color=orange];
		j4103666644 -> j1786740865 [label=true,color=green];
		j4103666644 -> j3557771911 [label=false,color=brown];
	j3456571108 [label="Sabes, ahora que lo pienso, fue su naturaleza desapasionada lo que lo hizo tan peligroso en nuestra época. Era capaz de sacrificarlo todo con tal de ver cumplidos sus objetivos. Cualquier cosa.",shape=box,color=blue];
		j3456571108 -> j81082849;
		j3456571108 -> j2002675689;
	j1786740865 [label="Pero ahí estás, probablemente tomándome el pelo otra vez, ya que hay muchas probabilidades de que ya supieras esta información, ahora que el mayordomo se ha vuelto a conectar con ellos.",shape=box,color=blue];
		j1786740865 -> j1042590148;
	j3557771911 [label="Aquellos que permanecen tan ajenos a nuestra existencia en este Sanctum en ruinas. Algo que, para mí, sigue siendo absolutamente invaluable.",shape=box,color=blue];
		j3557771911 -> j3456571108;
	j81082849 [label="Creí que los orokin no dudaban en sacrificar lo que más apreciaban. Todos parecían extremadamente despiadados entre sí.",shape=box,color=red];
		j81082849 -> j3734027443;
	j2002675689 [label="¿Cómo lo sabes?",shape=box,color=red];
		j2002675689 -> j2633477689;
	j1042590148 [label="Pero no voy a discutir más sobre esto contigo. No estoy de humor.",shape=box,color=blue];
		j1042590148 -> j3456571108;
	j3734027443 [label="Estás muy ansioso por asumir muchas cosas de las cuales no sabes nada, Viajero.",shape=box,color=blue];
		j3734027443 -> j270706239;
	j2633477689 [label="+10 Chemistry",color=orange];
		j2633477689 -> j4068964826;
	j270706239 [label="¿O tienes una mancha azul en la piel que no vi? ¿Eras un orokin? Si es así, te pido disculpas. ",shape=box,color=blue];
		j270706239 -> j2793427346;
		j270706239 -> j2111210236;
	j4068964826 [label="Quizás sea un error común pensar que los orokin sólo nos apuñalamos por la espalda y nos asesinamos. Había mucho de eso, no me malinterpretes. Éramos casi inmortales, no teníamos mucho más que hacer.",shape=box,color=blue];
		j4068964826 -> j4208710600;
	j2793427346 [label="Lo siento. No quise ofenderte. Honestamente, no recuerdo mucho de la sociedad orokin. Yo observaba desde afuera.",shape=box,color=red];
		j2793427346 -> j3308788072;
	j2111210236 [label="Disculpa si mis recuerdos de la sociedad orokin no son perfectos. Consistían principalmente en declaraciones grabadas y órdenes gritadas por altavoces. Eso fue antes de que terminara en el Vacío...",shape=box,color=red];
		j2111210236 -> j796313753;
	j4208710600 [label="Pero también éramos un pueblo profundamente apasionado. Nadie creaba arte como los orokin. Nadie componía música, teatro o poesía como nosotros.",shape=box,color=blue];
		j4208710600 -> j4105980551;
	j3308788072 [label="Disculpa aceptada. Por esta vez. Ya soporto bastantes faltas de respeto por parte de los de aquí. Por fascinante que seas, no soy el alfiletero de todos. Tengo mejores maneras de pasar el tiempo.",shape=box,color=blue];
		j3308788072 -> j3311377064;
	j796313753 [label="Boolean RoatheInsulted is now true.",color=orange];
		j796313753 -> j3514488747;
	j4105980551 [label="Y nadie amó tan profundamente como nosotros, cuando nuestros corazones se enamoraron de alguien más.",shape=box,color=blue];
		j4105980551 -> j2244723948;
	j3311377064 [label="¿Dónde iba? Ah, sí. Nuestro impasible Entrati.",shape=box,color=blue];
		j3311377064 -> j4068964826;
	j3514488747 [label="Una advertencia. Ya soporto bastantes faltas de respeto por parte de los de aquí. Por fascinante que seas, no soy el alfiletero de todos. Tengo mejores maneras de pasar el tiempo.",shape=box,color=blue];
		j3514488747 -> j3311377064;
	j2244723948 [label="Todos excepto Albrecht. Todo lo que hacía, todas las personas con las que interactuaba, era como si las viera a través de una sección de su querida serigrafía.",shape=box,color=blue];
		j2244723948 -> j3313155533;
	j3313155533 [label="Alejado. Desconectado. Indiferente. Desinteresado. Incluso cuando Gerivaine murió y se encontró criando a su hija solo.",shape=box,color=blue];
		j3313155533 -> j1969269467;
	j1969269467 [label="Check boolean LoidFamilyComplete",color=orange];
		j1969269467 -> j1792151948 [label=true,color=green];
		j1969269467 -> j3573463808 [label=false,color=brown];
	j1792151948 [label="Quien, por derecho propio, probablemente estaba destinada a lograr más de lo que él jamás hizo. Si no terminaba infestada y clavada en el suelo. Qué desperdicio.",shape=box,color=blue];
		j1792151948 -> j2850231699;
		j1792151948 -> j1305287001;
	j3573463808 [label="Quien, por derecho propio, probablemente estaba destinada a lograr más de lo que él jamás hizo. Estoy deseando ver qué será de ella y del resto de los Entrati. En toda su... gloria infestada.",shape=box,color=blue];
		j3573463808 -> j3649841201;
		j3573463808 -> j4276316748;
	j2850231699 [label="Me alegro de que hayamos conseguido convencer a Loid de subir.",shape=box,color=red];
		j2850231699 -> j2175890228;
	j1305287001 [label="Sé que no puedes recordar por qué lo hicimos, pero fue bueno que pudiéramos llevar a Loid arriba.",shape=box,color=red];
		j1305287001 -> j565685525;
	j3649841201 [label="Todavía me pregunto si esta será la mejor idea...",shape=box,color=red];
		j3649841201 -> j4156710113;
	j4276316748 [label="Si logramos convencer a Loid de subir, ¿qué planeas hacer después?",shape=box,color=red];
		j4276316748 -> j3742877410;
	j2175890228 [label="Eso dices. Y aún así me quedo ahí parado como un tonto, vigilándolos, escuchándolos hablar del reencuentro como si lo recordara. ¡¿Sabes lo incómodo que es?!",shape=box,color=blue];
		j2175890228 -> j2917740237;
	j565685525 [label="¿Sabes lo incómodo que es tener que estar ahí de pie, fingiendo que recuerdo la reunión cuando ni siquiera puedo recordarla?",shape=box,color=blue];
		j565685525 -> j2917740237;
	j4156710113 [label="Mmm, probablemente no. Tenía curiosidad, ¿tienes la dirección de Albrecht?",shape=box,color=blue];
		j4156710113 -> j1970012062;
	j3742877410 [label="Aún no lo he decidido. Quizás empiece a cortarles las extremidades y a conservarlas en líquido. De casualidad, ¿no tendrás la dirección de Albrecht?",shape=box,color=blue];
		j3742877410 -> j3425936251;
	j2917740237 [label="Es como estar en una gala cuando alguien se acerca a ti y sabe claramente quién eres, pero no tienes el más mínimo recuerdo de esa persona y te ves obligado a continuar la conversación como si la conocieras.",shape=box,color=blue];
		j2917740237 -> j3988921314;
	j1970012062 [label="No, ¿por qué?",shape=box,color=red];
		j1970012062 -> j4183735633;
	j3425936251 [label="¡¿Qué?!",shape=box,color=red];
		j3425936251 -> j3460484835;
	j3988921314 [label="¿Acaso tienes la más mínima idea del infierno en el que me has metido? ¡¿Alguna?! ¡Es una miseria estar ahí arriba y todo por tu culpa! ",shape=box,color=blue];
		j3988921314 -> j3549008288;
	j4183735633 [label="Estaba pensando que cuando estuviera arriba, empezaría a cortar las extremidades de su familia y luego se las enviaría por correo en frascos, una por una.",shape=box,color=blue];
		j4183735633 -> j3425936251;
	j3460484835 [label="+10 Chemistry",color=orange];
		j3460484835 -> j894700676;
	j3549008288 [label="Bah, ya basta. Necesito un trago.",shape=box,color=blue];
		j3549008288 -> j1933300832;
	j894700676 [label="¡Tranquilo! ¿Ya nadie aguanta una broma?",shape=box,color=blue];
		j894700676 -> j2697406261;
	j1933300832 [label="+10 Chemistry",color=orange];
		j1933300832 -> "Chat ends.";
	j2697406261 [label="De todas formas, ¿quién me los enviaría?",shape=box,color=blue];
		j2697406261 -> "Chat ends.";
}