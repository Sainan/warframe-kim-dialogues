	j1913061480 [label="MV: DIPLOMACIA",shape=box,color=blue];
		j1913061480 -> j1501617373;
	j1501617373 [label="Transcripción: Entre los Siete Ejecutores, Ballas se había proclamado el primero entre iguales. ",shape=box,color=blue];
		j1501617373 -> j601827630;
	j601827630 [label="Siempre diplomático, siempre persuasivo con una voz melosa, resolvía los rencores y las disputas de los demás.",shape=box,color=blue];
		j601827630 -> j968758878;
	j968758878 [label="Descubrí, para mi total alegría, que ahora él era la rosa atrapada entre dos matorrales de espinas. ",shape=box,color=blue];
		j968758878 -> j486838718;
	j486838718 [label="La facción belicista, liderada por Nitokh, disparó desde un lado. Los pacifistas, bajo el liderazgo de Scarne, dispararon desde el otro.",shape=box,color=blue];
		j486838718 -> j3078068233;
	j3078068233 [label="Ballas se vio obligado a decidir y ganarse la enemistad mordaz de cualquier grupo con el que no se aliara.",shape=box,color=blue];
		j3078068233 -> j732121206;
	j732121206 [label="Por razones que no puedo adivinar, eligió la paz; eran cuatro contra tres, y así los voraces conscientes de repente se convirtieron en aliados y amigos.",shape=box,color=blue];
		j732121206 -> j2452024131;
	j2452024131 [label="\"De una forma u otra, terminará uniéndosenos\", prometió Nitokh, incluso cuando me enviaron a buscar a los malcontentos entre la guarnición de Dax.",shape=box,color=blue];
		j2452024131 -> j921430358;
	j921430358 [label="Add 1 to HellStory counter",color=orange];
		j921430358 -> "Chat ends.";
}