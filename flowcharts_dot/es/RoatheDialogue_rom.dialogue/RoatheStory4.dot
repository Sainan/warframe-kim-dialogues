		j4022762081 -> j1466966364;
	j1466966364 [label="Transcripción: No esperábamos perder. ",shape=box,color=blue];
		j1466966364 -> j3113574471;
	j3113574471 [label="Después de la primera incursión expedicionaria de los conscientes, habíamos preparado un contraataque punitivo.",shape=box,color=blue];
		j3113574471 -> j2359507160;
	j2359507160 [label="La Hechicera Auricristalina emergió de la niebla de Ceres con alas mortales, un galeón cargado de drones y mirmidones de armadura plateada.",shape=box,color=blue];
		j2359507160 -> j3463058367;
	j3463058367 [label="Los circuitos, finos como la bruma, formaban un delicado encaje debajo de su revestimiento translúcido. ",shape=box,color=blue];
		j3463058367 -> j1312117384;
	j1312117384 [label="Era tan grande que apenas sobrepasaba los bordes del raíl solar.",shape=box,color=blue];
		j1312117384 -> j2709908484;
	j2709908484 [label="Los conscientes se aseguraron de captar nuestra atención. Ellos cantaron y nuestra tecnología falló. Nuestros guerreros forcejearon y se asfixiaron dentro de sus relucientes armaduras.",shape=box,color=blue];
		j2709908484 -> j1592829578;
	j1592829578 [label="La tripulación de la Hechicera Auricristalina pereció quemada viva al precipitarse sin motor hacia el cielo de Tau, en un complejo y costoso espectáculo de fuegos artificiales.",shape=box,color=blue];
		j1592829578 -> j921430358;
	j921430358 [label="Add 1 to HellStory counter",color=orange];
		j921430358 -> "Chat ends.";
