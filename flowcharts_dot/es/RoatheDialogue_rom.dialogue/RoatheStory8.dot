		2203 -> 5731;
	5731 [label="Siempre fueron sus formas las que llamaron mi atención entre las demás, aunque sus cuerpos mutilados no eran diferentes de todos los demás.",shape=box,color=blue];
		5731 -> 2195;
	2195 [label="Siempre fue el estandarte que seguían llevando, brillando con su oro orokin y teñido de carmesí moteado.",shape=box,color=blue];
