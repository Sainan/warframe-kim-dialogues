	2198 [label="Transcripción: Nada expresa tan sucintamente la pompa con que nosotros, como criaturas, tratamos la carnicería de la guerra como abanderados.",shape=box,color=blue];
		2198 -> 5694;
	5694 [label="Aquellos que deben ser protegidos a toda costa y seguidos sin vacilación.",shape=box,color=blue];
		5694 -> 5695;
	5695 [label="¿Y a quién se puede amenazar, debo añadir, con llevar a cabo órdenes que ningún soldado en su sano juicio llevaría a cabo jamás, por miedo a acabar sufriendo de algún modo un destino aún más terrible? ",shape=box,color=blue];
		5695 -> 2203;
