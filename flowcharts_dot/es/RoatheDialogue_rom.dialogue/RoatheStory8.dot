	"Chat ends." [color=orange];
	j3743555069 [label="MV: ESTANDARTE",shape=box,color=blue];
		j3743555069 -> j2570830983;
	j2570830983 [label="Transcripción: Nada expresa tan sucintamente la pompa con que nosotros, como criaturas, tratamos la carnicería de la guerra como abanderados.",shape=box,color=blue];
		j2570830983 -> j1156439685;
	j1156439685 [label="Aquellos que deben ser protegidos a toda costa y seguidos sin vacilación.",shape=box,color=blue];
		j1156439685 -> j2104610931;
	j2104610931 [label="¿Y a quién se puede amenazar, debo añadir, con llevar a cabo órdenes que ningún soldado en su sano juicio llevaría a cabo jamás, por miedo a acabar sufriendo de algún modo un destino aún más terrible? ",shape=box,color=blue];
		j2104610931 -> j4266440109;
	j4266440109 [label="Por ridículo que parezca.",shape=box,color=blue];
		j4266440109 -> j3170601838;
	j3170601838 [label="Siempre fueron sus formas las que llamaron mi atención entre las demás, aunque sus cuerpos mutilados no eran diferentes de todos los demás.",shape=box,color=blue];
		j3170601838 -> j2621585037;
	j2621585037 [label="Siempre fue el estandarte que seguían llevando, brillando con su oro orokin y teñido de carmesí moteado.",shape=box,color=blue];
		j2621585037 -> j3753098183;
	j3753098183 [label="Siempre me aseguré de que estuviera en pie, con orgullo, en el campo de batalla antes de irme.",shape=box,color=blue];
		j3753098183 -> j921430358;
	j921430358 [label="Add 1 to HellStory counter",color=orange];
		j921430358 -> "Chat ends.";
}