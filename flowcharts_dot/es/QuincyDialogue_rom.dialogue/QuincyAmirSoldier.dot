digraph {
	1845 [label="QuincyAmirSoldier begins.",color=orange];
		1845 -> 1846;
	1846 [label="ey",shape=box,color=blue];
		1846 -> 1847;
	1847 [label="hablé con el pequeño velocista como dijiste",shape=box,color=blue];
		1847 -> 1850;
		1847 -> 1848;
		1847 -> 1853;
	1850 [label="¿Cómo les fue?",shape=box,color=red];
		1850 -> 1849;
	1848 [label="Vaya. ¿En serio me escuchaste?",shape=box,color=red];
		1848 -> 1851;
	1853 [label="Estoy en medio de algo, lo siento. [Fin]",shape=box,color=red];
		1853 -> 1852;
	1849 [label="primero pensó que le iba a dar un puñetazo en la cara, lmao. pero lo llevé al techo, nos sentamos y hablamos",shape=box,color=blue];
		1849 -> 1854;
	1851 [label="cierra la boca y déjame hablar, ¿quieres?",shape=box,color=blue];
		1851 -> 1849;
	1852 [label="Chat ends.",color=orange];
	1854 [label="le conté sobre cuando me uní al ejército y cómo me convertí en francotirador",shape=box,color=blue];
		1854 -> 1856;
		1854 -> 1855;
	1856 [label="¿Cómo *te* convertiste en francotirador, por cierto?",shape=box,color=red];
		1856 -> 1857;
	1855 [label="¿Y?",shape=box,color=red];
		1855 -> 1858;
	1857 [label="no es importante ahora",shape=box,color=blue];
		1857 -> 1858;
	1858 [label="le conté sobre la primera vez que tuve que matar a alguien",shape=box,color=blue];
		1858 -> 1859;
	1859 [label="sobre la primera vez que apuntar con la mira y tomar una vida",shape=box,color=blue];
		1859 -> 1860;
	1860 [label="una cosa es cuando estás en la batalla... algún matón viene hacia ti con un arma o un cuchillo o lo que sea...",shape=box,color=blue];
		1860 -> 1861;
	1861 [label="otra cosa completamente distinta es que estés en un tejado a 300 metros de distancia y ni siquiera sepan que estás ahí...",shape=box,color=blue];
		1861 -> 1864;
	1864 [label="y tienes tiempo para *pensar* en ellos. ¿quiénes son? ¿xq están allí? ¿tienen familia? ¿hijos?",shape=box,color=blue];
		1864 -> 1862;
	1862 [label="y... entonces aprietas el gatillo. BUUM",shape=box,color=blue];
		1862 -> 1863;
	1863 [label="no importa ya",shape=box,color=blue];
		1863 -> 1865;
	1865 [label="están muertos y yo tomé esa vida",shape=box,color=blue];
		1865 -> 1866;
	1866 [label="y esa cara vive en mi cabeza",shape=box,color=blue];
		1866 -> 1867;
	1867 [label="y lo mismo ocurre con cada uno de los siguientes",shape=box,color=blue];
		1867 -> 1868;
		1867 -> 1869;
	1868 [label="¿Cómo reaccionó...?",shape=box,color=red];
		1868 -> 1871;
	1869 [label="Suena... alentador.",shape=box,color=red];
		1869 -> 1871;
	1871 [label="no dijo nada durante mucho tiempo. simplemente nos sentamos allí en silencio",shape=box,color=blue];
		1871 -> 1877;
	1877 [label="luego él... me contó sobre las pesadillas que ha estado teniendo",shape=box,color=blue];
		1877 -> 1874;
	1874 [label="y cómo sé siente como si no fuera realmente parte del grupo xq no es un soldado",shape=box,color=blue];
		1874 -> 1872;
	1872 [label="entonces le conté lo horrible que fue para mí cuando tuve que matar x primera vez como soldado",shape=box,color=blue];
		1872 -> 1873;
	1873 [label="y cómo solía tener pesadillas x eso, peores que las que tenía cuando era pequeño",shape=box,color=blue];
		1873 -> 1875;
	1875 [label="pero le pedí perdón por haberme portado como un imbécil con él durante todo este tiempo",shape=box,color=blue];
		1875 -> 1876;
	1876 [label="y le dije que él pertenecía con nosotros tanto como cualquiera. y que cada uno de nosotros tenemos nuestra forma de ser, simplemente somos quienes somos, ¿sabes?",shape=box,color=blue];
		1876 -> 1870;
	1870 [label=".... ¿entonces sabes lo que dijo...?",shape=box,color=blue];
		1870 -> 1878;
		1870 -> 1879;
	1878 [label="¿Qué?",shape=box,color=red];
		1878 -> 1882;
	1879 [label="¿No?",shape=box,color=red];
		1879 -> 1882;
	1882 [label="\"tienes razón, eres un idiota\"",shape=box,color=blue];
		1882 -> 1884;
	1884 [label="pero justo cuando estaba a punto de empujarlo desde el techo",shape=box,color=blue];
		1884 -> 1883;
	1883 [label="me abrazó. mierda, me abrazó. y me dijo: \"pero también eres mi hermano mayor\"",shape=box,color=blue];
		1883 -> 1881;
	1881 [label="¿qué carajo?",shape=box,color=blue];
		1881 -> 1880;
	1880 [label="pero... nah. vale la pena. creo que significó algo para él, realmente... y... significó algo para mí, también, supongo",shape=box,color=blue];
		1880 -> 1886;
	1886 [label="+20 Chemistry",color=orange];
		1886 -> 1885;
	1885 [label="así que... gracias",shape=box,color=blue];
		1885 -> 1887;
	1887 [label="Chat ends.",color=orange];
}