	1893 [label="una cosa es cuando estás en la batalla... algún matón viene hacia ti con un arma o un cuchillo o lo que sea...",shape=box,color=blue];
		1893 -> 1913;
	1913 [label="otra cosa completamente distinta es que estés en un tejado a 300 metros de distancia y ni siquiera sepan que estás ahí...",shape=box,color=blue];
		1913 -> 1914;
