		1499 -> 1503;
	1498 [label="[Devam etmesini bekle.]",shape=box,color=red];
		1498 -> 1502;
	1497 [label="[Uyarı: Kendine zarar verme ve çocuk istismarı tartışması. Sonlandırmak için buraya tıklayın. Lyon ile Samimiyetinizde herhangi bir kayıp yaşanmayacaktır.]",shape=box,color=red];
		1497 -> 1501;
	1496 [label="[Son.]",shape=box,color=red];
