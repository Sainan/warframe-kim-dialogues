		1507 -> 1511 [label="LyonBackstory3b",color=purple];
		1507 -> 1510 [label="false",color=purple];
	1505 [label="+20 Chemistry",color=orange];
		1505 -> 1508;
	1506 [label="Eğer bu seçiminiz yüzünden kendinizi korkak olarak görüyorsanız, yalvarırım görmeyin. Çünkü bu, sizin yüzleşmeniz gereken bir acı değil. Bu benim acım. Bu anı yaşamayı siz istemediniz.",shape=box,color=blue];
		1506 -> 1509;
	1504 [label="Chat ends.",color=orange];
	1511 [label="Ailemden bahsettik. Büyüdüğüm çiftlikteki zamanımdan. Beni rahatsız eden ve beni şiddete sürükleyen vizyonlardan.",shape=box,color=blue];
		1511 -> 1515;
	1510 [label="Beni yetiştirenler hakkında size pek bir şey anlatmadığımı biliyorum. Korkarım ki bunun da haklı bir sebebi var.",shape=box,color=blue];
		1510 -> 1514;
	1508 [label="Update boolean LyonConfession1",color=orange];
		1508 -> 1512;
	1509 [label="Yazıştığımız bu mekanik düzenek, örtülü bir tarafsızlık izlenimi yaratıyor. Sanki başkalarının üzerine yazdıkları kelimelerle bize verebilecekleri her türlü zarardan bir şekilde korunuyoruz.",shape=box,color=blue];
		1509 -> 1513;
	1515 [label="Size, diğer odalardan bana fısıldayan, beni çağıran seslerden bahsetmiştim. Bazen sanki adımı söylüyorlarmış gibi geliyorlardı -",shape=box,color=blue];
		1515 -> 1518;
	1514 [label="Annem... vizyonlarımı şeytanın işi sanıyordu. Ve onları bir sopayla benden söküp atmaya çalışıyordu. Çoğu zaman ayakta duramayacak hale gelene kadar.",shape=box,color=blue];
		1514 -> 1517;
	1512 [label="Chat ends.",color=orange];
	1513 [label="Ben bunun tam tersini savunuyorum; sıradan sosyal etkileşimlerimizde kuşandığımız zırhlardan kurtulduğumuzda, bizi koruyabilecek şeylerden de mahrum kalıyoruz.",shape=box,color=blue];
		1513 -> 1516;
	1518 [label="Bazen de hiçbir şey ifade etmiyorlardı. Anlamsız saçmalıklar, ya da şeytanın vesveselerine benziyordu.",shape=box,color=blue];
		1518 -> 1521;
	1517 [label="Babam mı? Eh, annemin tüm acımasızlığına rağmen babam ondan da beterdi. Ayrıntıları size bırakıyorum.",shape=box,color=blue];
		1517 -> 1520;
	1516 [label="Dolayısıyla, böyle durumlarda... Savaşa hazır askeri değil, ormandaki bir geyiğin şüphesiz şah damarını hedef alabilecek bir ok attığımın gayet iyi farkındayım.",shape=box,color=blue];
		1516 -> 1519;
	1521 [label="İlk başta, kelimelerin saçma sapan sayıklamaları beni dehşete düşürüyordu. Bir anlam ifade etmeleri onlara yalvarırdım. Lua'ya, ruhlarının bana ne istediklerini söylemesi için dua ederdim.",shape=box,color=blue];
		1521 -> 1524;
	1520 [label="Ama onların şiddeti benimkinden de bir farksız değildi. Vizyonlarım çoğu zaman benimle başa çıkılmasını zorlaştırıyordu; özellikle de büyüdüğümde ve babamdan bile daha uzun ve güçlü hale geldiğimde.",shape=box,color=blue];
		1520 -> 1523;
	1519 [label="O halde sizi şu sözlerle baş başa bırakıyorum:",shape=box,color=blue];
		1519 -> 1522;
	1524 [label="Ama ne istediklerini anlamaya başladığımda, bu kadar çok dua ettiğim şeyden pişman oldum. Artık, onlar adına yapmamı istedikleri işleri biliyordum.",shape=box,color=blue];
		1524 -> 1526;
	1523 [label="Ve bu vizyonlar çoğu zaman sesler şeklindeydi. Bazen sanki adımı söylüyorlardı -",shape=box,color=blue];
		1523 -> 1518;
	1522 [label="Ayakta duracak iradeyi kendimizde bulamasak bile, başkalarını ayağa kaldıracak gücü nasıl bulacağımızı kendimize hatırlatmalıyız.",shape=box,color=blue];
		1522 -> 1525;
	1526 [label="Ve bunun bedeli korkunçtu.",shape=box,color=blue];
		1526 -> 1528;
	1525 [label="Hikayenin asıl amacı budur.",shape=box,color=blue];
		1525 -> 1527;
	1528 [label="Beni yanlış anlamayın. Ne babama ne de anneme karşı sevgim vardı. Onlara karşı hissettiğim ailevi sadakat, çoktan bir dizi yara ve çürük ile yitip gitmişti.",shape=box,color=blue];
		1528 -> 1530;
	1527 [label="+20 Chemistry",color=orange];
		1527 -> 1529;
	1530 [label="Fakat benden yapmamı istedikleri şey neydi...? Ve o en karanlık gecede beni yapmaya zorladıkları şey neydi...?",shape=box,color=blue];
		1530 -> 1532;
	1529 [label="Hoşça kal Gezgin. Yakında tekrar konuşuruz.",shape=box,color=blue];
		1529 -> 1531;
	1532 [label="Daha bir çocuktum - tam reşit bile olmamıştım. Ya on altı? En fazla on sekiz yaşındaydım? İlk başta, bunların hepsinin korkunç bir kabus, çarpık bir rüya olduğunu düşündüm.",shape=box,color=blue];
		1532 -> 1534;
	1531 [label="-P. Lyon Allard",shape=box,color=blue];
		1531 -> 1533;
	1534 [label="Etrafımda, sadece kötülük ve gölgeden oluşan, zayıf ve çarpık görünümlü figürler duruyordu.",shape=box,color=blue];
		1534 -> 1536;
	1533 [label="Update boolean LyonConfession1",color=orange];
		1533 -> 1535;
	1536 [label="Bana sataşıp yapılması gerekeni yapmamı istiyorlardı – beni sevdiğini iddia edenler benim bedenimi istiyorsa... o zaman ben de onlarınkini istemeliydim...",shape=box,color=blue];
		1536 -> 1537;
	1535 [label="Chat ends.",color=orange];
	1537 [label="Kâbustan uyandığımda -ya da belki de hep uyanıktım, tam olarak bilmiyorum- elimde bir av bıçağı vardı. Ve annemle babamın odasının kapısında duruyordum.",shape=box,color=blue];
		1537 -> 1538;
	1538 [label="Ay yeni doğmuştu. Bulutlar da yoğundu. Görülebilecek en ufak bir ışık yoktu. Zifiri bir karanlığın içindeydik. ",shape=box,color=blue];
		1538 -> 1539;
	1539 [label="Lua beni terk etmişti.",shape=box,color=blue];
		1539 -> 1540;
	1540 [label="Seslerin çağrısına cevap veremedim. Annemin ve babamın ruhlarını onlara veremedim.",shape=box,color=blue];
		1540 -> 1541;
	1541 [label="Gecenin karanlığına kaçtım. Ormanın derinliklerine doğru... Dallar çıplak tenimi yırtıyordu, ama acıyı hiç umursamıyordum.",shape=box,color=blue];
		1541 -> 1542;
	1542 [label="Bacaklarım beni daha fazla taşıyamayacak hale gelene kadar koştum. Belki de ağlıyordum, bilmiyorum.",shape=box,color=blue];
		1542 -> 1543;
	1543 [label="Ama gördükleri peşimi bırakmıyordu. Ve hâlâ kan dökülmesi için fısıldıyorlardı.",shape=box,color=blue];
		1543 -> 1544;
	1544 [label="Onları göremezsem belki giderler diye umuyordum... işte böylece bıçağı göz çukuruma sapladım...",shape=box,color=blue];
		1544 -> 1545;
	1545 [label="Ne yazık ki, bayıldım ve görevimi tamamlayamadım. Artık bunu asla bilemeyeceğim.",shape=box,color=blue];
		1545 -> 1546;
	1546 [label="Uyandığımda, Lua'nın yerel ibadethanesindeydim. Bir Kardeş beni bulmuş ve yaralarımı sarmıştı. Bana neyden kaçtığımı sordu.",shape=box,color=blue];
		1546 -> 1547;
	1547 [label="Çok gergindim. Ona yalan söyleyemezdim. Her şeyi itiraf ettim - vizyonları, bana yapmamı söyledikleri şeyleri. Kınanmayı bekliyordum.",shape=box,color=blue];
		1547 -> 1548;
	1548 [label="Bitirdiğimde, o kadar bilindik bir hüzünle gülümsedi ki, avucuma bir Lua muskası koydu. \"O bir lütuf ve bir lanet, oğlum.\" dedi.",shape=box,color=blue];
		1548 -> 1549;
	1549 [label="Beni Cité de la Lumière Katedrali'ne gönderdi. Entrati beni bulana kadar orada kaldım...",shape=box,color=blue];
		1549 -> 1550;
	1550 [label="İşte... artık biliyorsunuz.",shape=box,color=blue];
		1550 -> 1551;
	1551 [label="Şimdi... gitmem gerek.",shape=box,color=blue];
		1551 -> 1552;
	1552 [label="Update boolean LyonConfession1",color=orange];
		1552 -> 1553;
	1553 [label="+20 Chemistry",color=orange];
		1553 -> 1554;
	1554 [label="- Lyon",shape=box,color=blue];
		1554 -> 1555;
	1555 [label="Chat ends.",color=orange];
