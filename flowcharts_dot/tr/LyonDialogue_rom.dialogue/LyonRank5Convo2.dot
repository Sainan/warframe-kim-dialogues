	1487 [label="+20 Chemistry",color=orange];
		1487 -> 490;
	1491 [label="Dostum, bana karşı sabırlı ve hak ettiğimden çok daha nazik davrandınız. Hikayemin bu kısmından sonra, Lua'nın en karanlık olduğu gece hakkında merakınızın arttığının farkındayım.",shape=box,color=blue];
		1491 -> 1493;
	1490 [label="Dostum, bana karşı sabırlı davrandınız. Hikayemin bu kısmından sonra - Lua'nın en karanlık olduğu gece hakkında merakınızın arttığını biliyorum.",shape=box,color=blue];
		1490 -> 1493;
	1489 [label="Dostum, geçmişimi merak ediyordunuz. Ve hikayemin bu kısmını, Lua'nın en karanlık zamanlarında olduğu geceyi merak ettiğinizi biliyorum.",shape=box,color=blue];
		1489 -> 1493;
	1488 [label="Dostum, hikayemi dinledikten sonra Lua'nın en karanlık gecesi hakkında merakınızın arttığının farkındayım.",shape=box,color=blue];
