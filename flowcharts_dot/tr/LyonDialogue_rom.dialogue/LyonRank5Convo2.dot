	j141195667 [label="Evaluate expressions",color=orange];
		j141195667 -> j1576574914 [label="LyonBackstory3a",color=purple];
		j141195667 -> j1576574914 [label="LyonBackstory3b",color=purple];
		j141195667 -> j885635356 [label="false",color=purple];
	j3342655806 [label="+20 Chemistry",color=orange];
		j3342655806 -> j370687875;
	j3793282398 [label="Eğer bu seçiminiz yüzünden kendinizi korkak olarak görüyorsanız, yalvarırım görmeyin. Çünkü bu, sizin yüzleşmeniz gereken bir acı değil. Bu benim acım. Bu anı yaşamayı siz istemediniz.",shape=box,color=blue];
		j3793282398 -> j1802339816;
	j1576574914 [label="Ailemden bahsettik. Büyüdüğüm çiftlikteki zamanımdan. Beni rahatsız eden ve beni şiddete sürükleyen vizyonlardan.",shape=box,color=blue];
		j1576574914 -> j3422963185;
	j885635356 [label="Beni yetiştirenler hakkında size pek bir şey anlatmadığımı biliyorum. Korkarım ki bunun da haklı bir sebebi var.",shape=box,color=blue];
		j885635356 -> j3807140644;
	j1802339816 [label="Yazıştığımız bu mekanik düzenek, örtülü bir tarafsızlık izlenimi yaratıyor. Sanki başkalarının üzerine yazdıkları kelimelerle bize verebilecekleri her türlü zarardan bir şekilde korunuyoruz.",shape=box,color=blue];
		j1802339816 -> j1787984690;
	j3422963185 [label="Size, diğer odalardan bana fısıldayan, beni çağıran seslerden bahsetmiştim. Bazen sanki adımı söylüyorlarmış gibi geliyorlardı -",shape=box,color=blue];
		j3422963185 -> j1066132495;
	j3807140644 [label="Annem... vizyonlarımı şeytanın işi sanıyordu. Ve onları bir sopayla benden söküp atmaya çalışıyordu. Çoğu zaman ayakta duramayacak hale gelene kadar.",shape=box,color=blue];
		j3807140644 -> j635258458;
	j1787984690 [label="Ben bunun tam tersini savunuyorum; sıradan sosyal etkileşimlerimizde kuşandığımız zırhlardan kurtulduğumuzda, bizi koruyabilecek şeylerden de mahrum kalıyoruz.",shape=box,color=blue];
		j1787984690 -> j1938027053;
	j1066132495 [label="Bazen de hiçbir şey ifade etmiyorlardı. Anlamsız saçmalıklar, ya da şeytanın vesveselerine benziyordu.",shape=box,color=blue];
		j1066132495 -> j728192222;
	j635258458 [label="Babam mı? Eh, annemin tüm acımasızlığına rağmen babam ondan da beterdi. Ayrıntıları size bırakıyorum.",shape=box,color=blue];
		j635258458 -> j2727487531;
	j1938027053 [label="Dolayısıyla, böyle durumlarda... Savaşa hazır askeri değil, ormandaki bir geyiğin şüphesiz şah damarını hedef alabilecek bir ok attığımın gayet iyi farkındayım.",shape=box,color=blue];
		j1938027053 -> j674313567;
	j728192222 [label="İlk başta, kelimelerin saçma sapan sayıklamaları beni dehşete düşürüyordu. Bir anlam ifade etmeleri onlara yalvarırdım. Lua'ya, ruhlarının bana ne istediklerini söylemesi için dua ederdim.",shape=box,color=blue];
		j728192222 -> j1059177779;
	j2727487531 [label="Ama onların şiddeti benimkinden de bir farksız değildi. Vizyonlarım çoğu zaman benimle başa çıkılmasını zorlaştırıyordu; özellikle de büyüdüğümde ve babamdan bile daha uzun ve güçlü hale geldiğimde.",shape=box,color=blue];
		j2727487531 -> j3667333319;
	j674313567 [label="O halde sizi şu sözlerle baş başa bırakıyorum:",shape=box,color=blue];
		j674313567 -> j2347301863;
	j1059177779 [label="Ama ne istediklerini anlamaya başladığımda, bu kadar çok dua ettiğim şeyden pişman oldum. Artık, onlar adına yapmamı istedikleri işleri biliyordum.",shape=box,color=blue];
		j1059177779 -> j1702772796;
	j3667333319 [label="Ve bu vizyonlar çoğu zaman sesler şeklindeydi. Bazen sanki adımı söylüyorlardı -",shape=box,color=blue];
		j3667333319 -> j1066132495;
	j2347301863 [label="Ayakta duracak iradeyi kendimizde bulamasak bile, başkalarını ayağa kaldıracak gücü nasıl bulacağımızı kendimize hatırlatmalıyız.",shape=box,color=blue];
		j2347301863 -> j1916238867;
	j1702772796 [label="Ve bunun bedeli korkunçtu.",shape=box,color=blue];
		j1702772796 -> j3337795948;
	j1916238867 [label="Hikayenin asıl amacı budur.",shape=box,color=blue];
		j1916238867 -> j2693839251;
	j3337795948 [label="Beni yanlış anlamayın. Ne babama ne de anneme karşı sevgim vardı. Onlara karşı hissettiğim ailevi sadakat, çoktan bir dizi yara ve çürük ile yitip gitmişti.",shape=box,color=blue];
		j3337795948 -> j669407774;
	j2693839251 [label="+20 Chemistry",color=orange];
		j2693839251 -> j2757623518;
	j669407774 [label="Fakat benden yapmamı istedikleri şey neydi...? Ve o en karanlık gecede beni yapmaya zorladıkları şey neydi...?",shape=box,color=blue];
		j669407774 -> j1416307480;
	j2757623518 [label="Hoşça kal Gezgin. Yakında tekrar konuşuruz.",shape=box,color=blue];
		j2757623518 -> j3215434994;
	j1416307480 [label="Daha bir çocuktum - tam reşit bile olmamıştım. Ya on altı? En fazla on sekiz yaşındaydım? İlk başta, bunların hepsinin korkunç bir kabus, çarpık bir rüya olduğunu düşündüm.",shape=box,color=blue];
		j1416307480 -> j3208466132;
	j3215434994 [label="-P. Lyon Allard",shape=box,color=blue];
		j3215434994 -> j370687875;
	j3208466132 [label="Etrafımda, sadece kötülük ve gölgeden oluşan, zayıf ve çarpık görünümlü figürler duruyordu.",shape=box,color=blue];
		j3208466132 -> j2534900639;
	j2534900639 [label="Bana sataşıp yapılması gerekeni yapmamı istiyorlardı – beni sevdiğini iddia edenler benim bedenimi istiyorsa... o zaman ben de onlarınkini istemeliydim...",shape=box,color=blue];
		j2534900639 -> j151582373;
	j151582373 [label="Kâbustan uyandığımda -ya da belki de hep uyanıktım, tam olarak bilmiyorum- elimde bir av bıçağı vardı. Ve annemle babamın odasının kapısında duruyordum.",shape=box,color=blue];
		j151582373 -> j2270407012;
	j2270407012 [label="Ay yeni doğmuştu. Bulutlar da yoğundu. Görülebilecek en ufak bir ışık yoktu. Zifiri bir karanlığın içindeydik. ",shape=box,color=blue];
		j2270407012 -> j1441453841;
	j1441453841 [label="Lua beni terk etmişti.",shape=box,color=blue];
		j1441453841 -> j3828124228;
	j3828124228 [label="Seslerin çağrısına cevap veremedim. Annemin ve babamın ruhlarını onlara veremedim.",shape=box,color=blue];
		j3828124228 -> j3781252084;
	j3781252084 [label="Gecenin karanlığına kaçtım. Ormanın derinliklerine doğru... Dallar çıplak tenimi yırtıyordu, ama acıyı hiç umursamıyordum.",shape=box,color=blue];
		j3781252084 -> j3552011341;
	j3552011341 [label="Bacaklarım beni daha fazla taşıyamayacak hale gelene kadar koştum. Belki de ağlıyordum, bilmiyorum.",shape=box,color=blue];
		j3552011341 -> j2707955748;
	j2707955748 [label="Ama gördükleri peşimi bırakmıyordu. Ve hâlâ kan dökülmesi için fısıldıyorlardı.",shape=box,color=blue];
		j2707955748 -> j1330974327;
	j1330974327 [label="Onları göremezsem belki giderler diye umuyordum... işte böylece bıçağı göz çukuruma sapladım...",shape=box,color=blue];
		j1330974327 -> j1112619783;
	j1112619783 [label="Ne yazık ki, bayıldım ve görevimi tamamlayamadım. Artık bunu asla bilemeyeceğim.",shape=box,color=blue];
		j1112619783 -> j3293973733;
	j3293973733 [label="Uyandığımda, Lua'nın yerel ibadethanesindeydim. Bir Kardeş beni bulmuş ve yaralarımı sarmıştı. Bana neyden kaçtığımı sordu.",shape=box,color=blue];
		j3293973733 -> j668683959;
	j668683959 [label="Çok gergindim. Ona yalan söyleyemezdim. Her şeyi itiraf ettim - vizyonları, bana yapmamı söyledikleri şeyleri. Kınanmayı bekliyordum.",shape=box,color=blue];
		j668683959 -> j568870407;
	j568870407 [label="Bitirdiğimde, o kadar bilindik bir hüzünle gülümsedi ki, avucuma bir Lua muskası koydu. \"O bir lütuf ve bir lanet, oğlum.\" dedi.",shape=box,color=blue];
		j568870407 -> j2113300818;
	j2113300818 [label="Beni Cité de la Lumière Katedrali'ne gönderdi. Entrati beni bulana kadar orada kaldım...",shape=box,color=blue];
		j2113300818 -> j1772532272;
	j1772532272 [label="İşte... artık biliyorsunuz.",shape=box,color=blue];
		j1772532272 -> j352875849;
	j352875849 [label="Şimdi... gitmem gerek.",shape=box,color=blue];
		j352875849 -> j899759413;
	j899759413 [label="Boolean LyonConfession1 is now true.",color=orange];
		j899759413 -> j60939596;
	j60939596 [label="+20 Chemistry",color=orange];
		j60939596 -> j3311435967;
