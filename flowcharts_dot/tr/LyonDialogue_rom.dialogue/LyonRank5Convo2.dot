	490 [label="[Önceki travma uyarısı tercihinizden ötürü bu konuşma atlandı.]",shape=box,color=blue];
		490 -> 1492;
	1493 [label="Bu, asla anlatmayacağıma yemin ettiğim bir hikâyeydi. Sadece Marie biliyor, çünkü günlüklerimden okumuş. Şimdi de sizin için burada paylaşıyorum.",shape=box,color=blue];
		1493 -> 1495;
	1492 [label="Update boolean LyonConfession1",color=orange];
		1492 -> 1494;
