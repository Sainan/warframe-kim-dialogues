	j2315033898 [label="+20 Chemistry",color=orange];
		j2315033898 -> j2232574525;
	j1594684884 [label="Dostum, bana karşı sabırlı ve hak ettiğimden çok daha nazik davrandınız. Hikayemin bu kısmından sonra, Lua'nın en karanlık olduğu gece hakkında merakınızın arttığının farkındayım.",shape=box,color=blue];
		j1594684884 -> j2182515158;
	j1758866590 [label="Dostum, bana karşı sabırlı davrandınız. Hikayemin bu kısmından sonra - Lua'nın en karanlık olduğu gece hakkında merakınızın arttığını biliyorum.",shape=box,color=blue];
		j1758866590 -> j2182515158;
	j894925164 [label="Dostum, geçmişimi merak ediyordunuz. Ve hikayemin bu kısmını, Lua'nın en karanlık zamanlarında olduğu geceyi merak ettiğinizi biliyorum.",shape=box,color=blue];
		j894925164 -> j2182515158;
	j1031168770 [label="Dostum, hikayemi dinledikten sonra Lua'nın en karanlık gecesi hakkında merakınızın arttığının farkındayım.",shape=box,color=blue];
		j1031168770 -> j2182515158;
	j2232574525 [label="[Önceki travma uyarısı tercihinizden ötürü bu konuşma atlandı.]",shape=box,color=blue];
		j2232574525 -> j370687875;
	j2182515158 [label="Bu, asla anlatmayacağıma yemin ettiğim bir hikâyeydi. Sadece Marie biliyor, çünkü günlüklerimden okumuş. Şimdi de sizin için burada paylaşıyorum.",shape=box,color=blue];
