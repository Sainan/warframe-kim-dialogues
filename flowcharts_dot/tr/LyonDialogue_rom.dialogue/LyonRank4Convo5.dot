	j1890765166 [label="Söyleyeceğin kelime \"meşgul\" ise, ben de gördüm, Gezgin. Biri fısıldıyor. Duvarın içindeki. Tıkırtıyı duydum...",shape=box,color=blue];
		j1890765166 -> j405665846;
	j3886839952 [label="Evet, lütfen. Aslında, bir müzik aletinin geçici bir yarı tanrı olması, zihnimi meşgul eden ve terk eden başka herhangi bir şeyden çok daha rahatlatıcı olurdu. Acaba garip mi... onun...",shape=box,color=blue];
		j3886839952 -> j3940802394;
	j3453464816 [label="Bunun sadece konuya karşı olan özel hassasiyetimden mi, yoksa... benim yarattığım bireysel koşullardan mı, yoksa... ondan mı kaynaklandığından emin değilim -",shape=box,color=blue];
		j3453464816 -> j3040124549;
	j1562125759 [label="Ben de öyle duydum.",shape=box,color=red];
