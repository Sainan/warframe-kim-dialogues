	j3545863467 [label="Ah?",shape=box,color=red];
		j3545863467 -> j1103324093;
	j405665846 [label="Hayatım boyunca duymadığımı bildiğim bir ses beni yönlendiriyor, ama bu ses geçmişime ve geleceğime kadar uzanıyor...",shape=box,color=blue];
		j405665846 -> j3753284218;
	j3940802394 [label="O?",shape=box,color=red];
		j3940802394 -> j405665846;
	j3040124549 [label="Ve bunu söylediğim için benim delirdiğimi sanacağınızı biliyorum, ama ben zamanı... salt... doğrusal bir biçimde deneyimlemiyorum.",shape=box,color=blue];
		j3040124549 -> j2682248269;
		j3040124549 -> j453666327;
	j606173718 [label="Bence bu, onun az sayıdaki kurtarıcı özelliğinden biri. Hırsızlık değil, akıl. Bunun ardındaki mantık. Benim teorim, Marie'yi kendisiyle konuşmaya teşvik etmek için yasadışı malları temin ettiği yönünde.",shape=box,color=blue];
		j606173718 -> j3043215507;
	j1103324093 [label="Ne burada ne de orada.",shape=box,color=blue];
		j1103324093 -> j844141320;
		j1103324093 -> j1318164367;
	j3753284218 [label="Bunun hep orada olması imkansız. Yine de şimdi hatırlıyorum, çocukluğumun geçtiği evin duvarının arkasında, Lua'nın gümüş rengi ışığı kadar net bir şekilde. Genç bir adamın sesi. Yanında başka birinin varlığını hissedebiliyorum... ''Rap tap tap...''",shape=box,color=blue];
		j3753284218 -> j3875785453;
	j2682248269 [label="\"O?\" \"O\" dediğin kim?",shape=box,color=red];
		j2682248269 -> j405665846;
