		j453666327 -> j3765448630;
	j3043215507 [label="Ve belki de, onun bakmadığını sandığı zamanlarda onu gülümsettiği için. Bir keresinde bana \"Hayatından bu kadar mahrum kalması kaderin büyük bir hatası,\" demişti.",shape=box,color=blue];
		j3043215507 -> j3733610902;
