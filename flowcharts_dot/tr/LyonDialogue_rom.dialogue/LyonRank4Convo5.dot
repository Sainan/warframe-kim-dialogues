		j1609424557 -> j2740422378;
	j4037656101 [label="Belki de sormanız gereken kişi ben değilim. O zamandan beri geçen zamanın nasıl geçtiğini kavrayışım... karmaşıklaştı. Belki de \"daha karmaşık\" demek daha doğru olur. Sanki bundan daha korkunç bir şey olamazmış gibi...",shape=box,color=blue];
		j4037656101 -> j3375965293;
		j4037656101 -> j3705949835;
