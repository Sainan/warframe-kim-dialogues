	j2781085245 [label="Haklıydım, o hikaye Roathe hakkındaydı.",shape=box,color=red];
		j2781085245 -> j3622425035;
	j1474672271 [label="Anlattığına göre, ortaya çıktığında biraz... vahşi olmak için her türlü sebebi varmış.",shape=box,color=red];
		j1474672271 -> j318765472;
	j675400038 [label="Tamam, devam et.",shape=box,color=red];
		j675400038 -> j2266356665;
	j3622425035 [label="O, Katedral'i ziyaret eden başıboş bir kediyle ilgili bir hikâyeydi. Anlamının ardındaki çıkarım veya size anlatma sebebim tamamen sizin sorumluluğunuzdadır. Ben bir rahibim, değil mi?",shape=box,color=blue];
		j3622425035 -> j2266356665;
	j318765472 [label="Onun statüsünde ve mizacında birinin, Entrati'nin kendisine karşı yaptığı eylemlerden dolayı haksızlığa uğradığını hissetmesini beklerdim. Dürüst olmak gerekirse, durumu nezaketle karşılasaydı çok daha fazla şaşırırdım.",shape=box,color=blue];
		j318765472 -> j2266356665;
	j2266356665 [label="Evaluate expressions",color=orange];
		j2266356665 -> j2141320531 [label="LyonSerum1",color=purple];
		j2266356665 -> j2713868027 [label="false",color=purple];
	j2141320531 [label="Sanırım en son, Entratinin, Roathe ile kaybolmasından kısa süre sonra döndüğünü ve artık onu gördüğümüz gibi değiştiğini anlatmıştım. Entrati, üç yıldan uzun süredir söylediği tüm yalanları bize ifşa etti.",shape=box,color=blue];
		j2141320531 -> j3186601587;
	j2713868027 [label="O ana kadar olan olayları özetlemeye çalışacağım, aksi takdirde... saçma görünebilir.",shape=box,color=blue];
		j2713868027 -> j13034649;
	j3186601587 [label="Bizi bugünkü halimize dönüştüren ''Protoframe serumlarını'' bize sundu ve biz bunları kabul ettikten sonra... hemen bir kez daha bizi terk etti.",shape=box,color=blue];
		j3186601587 -> j4054364410;
	j13034649 [label="Üç yıl, iki ay ve on bir gün boyunca, katedralimizde Kardinal Dimanche olarak görev yaptı. Ve tüm bu süre boyunca, Marie ve ben, onun bize ne hazırladığından habersiz olarak ona hizmet ettik.",shape=box,color=blue];
		j13034649 -> j2712503945;
	j4054364410 [label="Ve orada, yeni yetim kalmış karışımlar olarak kaldık; bedenlerimiz ve ruhlarımız, idrak etmekten çok uzak olduğumuz, hatta üzerlerinde hakimiyet iddiasında bile bulunamadığımız yaratıklara dönüştürülmüştü.",shape=box,color=blue];
		j4054364410 -> j3489287655;
	j2712503945 [label="Sorularınızı sormadan önce biliyorum. Ne planlıyordu? Höllvania'ya yaptığını duyduğum gibi şehri de enfekte mi etti? Planları neydi? Keşifleri nelerdi?",shape=box,color=blue];
		j2712503945 -> j1985892721;
	j3489287655 [label="Evimiz olan ama artık bize dost olmayan bir şehirde mahsur kalmıştık. Saklanmak zorundaydık.",shape=box,color=blue];
		j3489287655 -> j2816988770;
		j3489287655 -> j2852037434;
	j1985892721 [label="Bu sorular için şunu söyleyeceğim: Hayal kırıklığına uğrayacaksınız. Vaaz verdi. Çalıştı. Dinlendi. Ve dua etti. Sonra bir gece, korkunç bir fırtınanın ortasında kayboldu. Tıpkı ortaya çıktığı gibi.",shape=box,color=blue];
		j1985892721 -> j2575044127;
	j2816988770 [label="Görünüşünüz yüzünden mi?",shape=box,color=red];
		j2816988770 -> j3581396624;
	j2852037434 [label="Katedral size sırtını mı çevirdi?",shape=box,color=red];
		j2852037434 -> j2760681290;
	j2575044127 [label="Check boolean MarieLyonVisions",color=orange];
		j2575044127 -> j2440718548 [label=true,color=green];
		j2575044127 -> j1411951272 [label=false,color=brown];
	j3581396624 [label="Dikkatinizden kaçmış olabilir mi bilmiyorum ama Marie uçabiliyor ve Roathe... mavi ve daha birçok sorunun yanı sıra.",shape=box,color=blue];
		j3581396624 -> j1837723354;
	j2760681290 [label="Tam olarak değil. Kamu hayatından zorla uzaklaştırıldık. Ama Kardeşlerimiz ve Rahibeler bizi sokağa atmadı veya kazığa oturtmadılar. \"Kardinal Dimanche\", değişimlerimizin... Aydınlığın işi olduğuna onları ikna etti.",shape=box,color=blue];
		j2760681290 -> j1594958333;
	j2440718548 [label="Fırtınanın başkalarının başına gelmediğinin farkında olsam da, benim duyularım için oldukça canlıydı.",shape=box,color=blue];
		j2440718548 -> j1411951272;
	j1411951272 [label="Tam bir yıl sonra, son kez yeniden ortaya çıktı, yanında... Roathe, şimdi gördüğünüz gibi, ayaklarının dibinde baygın bir şekilde yatıyordu.",shape=box,color=blue];
		j1411951272 -> j574018881;
	j1837723354 [label="Günlerinizi hayvanlarla ve kafataslarıyla konuşarak ve kozmik Void gizemini düşünerek geçirdiğinizi biliyorum, ancak bu çoğu insan için standart bir konu değil.",shape=box,color=blue];
		j1837723354 -> j3128484864;
	j1594958333 [label="Mahzenlerin içine saklanıp gözlerden uzak tutuluyorduk. Eski kardeşlerimiz, bizden korkmalarına rağmen, bize erzak getiriyorlardı.",shape=box,color=blue];
		j1594958333 -> j1562540092;
	j574018881 [label="Görünüşe göre, o bir şeytandı. O anda Entrati, kim olduğunu ve bize yüklemeyi planladığı gerçek görevini açıkladı. İkimizi de çok \"kutsal bir görev\" için seçmişti.",shape=box,color=blue];
		j574018881 -> j2892960842;
	j3128484864 [label="Aslında, kendimi yeterince iyi gizleyebilseydim kalabalığın arasında dolaşabilecek üç kişiden biri belki de ben olurdum. ",shape=box,color=blue];
		j3128484864 -> j2514023430;
		j3128484864 -> j3905668152;
	j1562540092 [label="Marie'nin merdivenlerde aniden hayalet gibi belirmesine rağmen, onlar sadece Marie ile etkileşime girmekte ısrar ediyorlardı. ",shape=box,color=blue];
		j1562540092 -> j3996597618;
		j1562540092 -> j531995614;
	j2892960842 [label="Marie serumu hemen kabul etti. Elbette kabul etti. Nasıl kabul etmesin ki? Ve ben nasıl onun peşinden gitmeyebilirdim ki? Gerçeği, nereye götürürse götürsün, nasıl aramaktan vazgeçebilirdim?",shape=box,color=blue];
