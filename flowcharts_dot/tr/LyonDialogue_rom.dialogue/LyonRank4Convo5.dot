		j494315779 -> j1663373382;
	j540454878 [label="Tersine mühendislik ile bir Helminth mi oluşturdu?! Bu ne kadar sürdü?!",shape=box,color=red];
		j540454878 -> j1411333562;
	j3810986364 [label="Kimsenin anladığını sanmıyorum. Yeni bir keşif.",shape=box,color=red];
		j3810986364 -> j4078335228;
	j2635777503 [label="Konuşan Infested amalgamlara dönüştüğümüzden bu yana kaç yıl geçtiğini sormanız gereken kişi ben olmayabilirim. O zamandan beri geçen zamanın akışına dair kavrayışım... karmaşıktı.",shape=box,color=blue];
		j2635777503 -> j3375965293;
		j2635777503 -> j3705949835;
	j4230356385 [label="Kulağa göründüğünden daha sert geliyor olabilir. Bizi koyacak başka yer yoktu. Çan kulesi çok açıktı, sert hava koşullarına çok açıktı. Mahzenler korunaklı ve sıcaktı.",shape=box,color=blue];
		j4230356385 -> j2174938848;
	j1224836343 [label="Bu konuda hemfikiriz. Ama onu bu konuda da suçlayamam. Ona zaman verin. Anlayacaktır. O çok zeki Gezgin. Ona aptal muamelesi yapmayın.",shape=box,color=blue];
		j1224836343 -> j1761995515;
	j585151881 [label="Entrati son kez ayrıldı. Ve Roathe'ı yanımıza bıraktı, şimdi gördüğünüz şeye dönüşmüştü - huysuz şeytanla daha iyi başa çıkabilecek durumdaydı.",shape=box,color=blue];
		j585151881 -> j4054364410;
