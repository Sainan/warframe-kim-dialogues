		j844141320 -> j2625011057;
	j1318164367 [label="Sonra ne oldu?",shape=box,color=red];
		j1318164367 -> j658031769;
	j3875785453 [label="Ben - affedersiniz. Gitmeliyim. Henüz bu konuda konuşamam. Ben... Üzgünüm. Bana bir daha bu konuyu sormayın.",shape=box,color=blue];
		j3875785453 -> j1413449326;
	j3765448630 [label="Peki, kendi rasyonel zihnimin ötesinde bana işaret eden bir sesten bahsettiğimde ne dersiniz? Hayatım boyunca bu sesi hiç duymadığımı biliyorum. Bu sesin her zaman orada olması mümkün değil.",shape=box,color=blue];
		j3765448630 -> j2292042796;
