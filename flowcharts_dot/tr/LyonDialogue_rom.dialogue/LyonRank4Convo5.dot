		j2902092500 -> j1224836343;
	j6051194 [label="Roathe uyandı. İlk başta adını bile zar zor hatırlayabiliyordu. Entrati, o namussuza son bir cümle söyledi. \"Xata'nın Kafiri, sürgündeki Uriel, cevap ver - Orokin affedilebilir mi?\"",shape=box,color=blue];
		j6051194 -> j585151881;
	j1177002900 [label="Her şeyden pişmanım Gezgin. Evet, elbette pişmanım. Ama tekrar yapar mıyım? Evet, elbette yaparım. Marie'yi yalnız bırakamam.",shape=box,color=blue];
