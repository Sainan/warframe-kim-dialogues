		j212877744 -> j3453464816;
	j3888320125 [label="İnanın bana, bunu biliyorum. Ve bu rahatsız edici, teşekkür ederim. Her ne kadar buradaki her rastgele ev eşyası konuşabiliyor gibi görünse de.",shape=box,color=blue];
		j3888320125 -> j2150473747;
