		j4032284956 -> j3399008535;
	j3399008535 [label="Konuşmak benim için zor. Samimi ilişkilerde, bu tür kişisel olmayan, mekanik veya posta yoluyla yapılanlardan çok daha zor.",shape=box,color=blue];
		j3399008535 -> j3447876595;
	j3447876595 [label="Bunu nasıl anlatacağımı bilmiyorum - sadece şöyle bir şey... sanki bir şeye uzanmaya çalışıyorum, ama parmaklarımın arasından toz parçacıkları kayıp gidiyor. ",shape=box,color=blue];
		j3447876595 -> j1724565635;
	j1724565635 [label="Kendimi çoğu zaman boş bir tuval parçası gibi hissediyorum, yüzeyine yağlı boya sürüyorum - hayalimdeki bir görüntünün gölgesini beyhude bir çabayla yaratmaya çalışıyorum.",shape=box,color=blue];
		j1724565635 -> j2116440497;
	j2116440497 [label="Ama ne kadar çok çalışırsam, durum o kadar umutsuzlaşıyor.",shape=box,color=blue];
		j2116440497 -> j3734963531;
	j3734963531 [label="Ne kadar uğraşırsam uğraşayım, o kadar başarısız oluyorum. Bu yüzden öğrendim ki... hiç denememeliyim.",shape=box,color=blue];
		j3734963531 -> j952397066;
	j952397066 [label="İşte bu yüzden ilk başta sizden uzak durdum. Ve bu yüzden hâlâ... yalnızlık nöbetlerine meyilliyim. Kelimeler ağzımdan kaçıyor.",shape=box,color=blue];
