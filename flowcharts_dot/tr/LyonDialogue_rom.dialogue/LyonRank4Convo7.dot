	1291 [label="Bunu takdir etmekle birlikte, yine de size bir özür borcum olduğunu hissediyorum. Bunu kısa tutmaya ve gereksiz bilgilerle kendimi fazla yormamaya gayret edeceğim.",shape=box,color=blue];
