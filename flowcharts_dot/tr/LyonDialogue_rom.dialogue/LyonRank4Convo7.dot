		1298 -> 1299;
	1299 [label="İşte bu yüzden ilk başta sizden uzak durdum. Ve bu yüzden hâlâ... yalnızlık nöbetlerine meyilliyim. Kelimeler ağzımdan kaçıyor.",shape=box,color=blue];
