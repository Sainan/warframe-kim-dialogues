		1293 -> 1294;
	1294 [label="Konuşmak benim için zor. Samimi ilişkilerde, bu tür kişisel olmayan, mekanik veya posta yoluyla yapılanlardan çok daha zor.",shape=box,color=blue];
		1294 -> 1295;
	1295 [label="Bunu nasıl anlatacağımı bilmiyorum - sadece şöyle bir şey... sanki bir şeye uzanmaya çalışıyorum, ama parmaklarımın arasından toz parçacıkları kayıp gidiyor. ",shape=box,color=blue];
		1295 -> 1296;
	1296 [label="Kendimi çoğu zaman boş bir tuval parçası gibi hissediyorum, yüzeyine yağlı boya sürüyorum - hayalimdeki bir görüntünün gölgesini beyhude bir çabayla yaratmaya çalışıyorum.",shape=box,color=blue];
