		701 -> 704;
	698 [label="Enfes! Bir din alimi olarak, birbirimizin inançlarını detaylı olarak öğrenmek için zamanımızın olacağını umuyorum.",shape=box,color=blue];
		698 -> 704;
	695 [label="Bu uzun bir hikaye. ",shape=box,color=red];
		695 -> 707;
	696 [label="Birkaç din inceledim ama hiçbiri bana tam olarak uymuyordu. Sonunda kendimi, insanlığın unsurlarının heterojen bir karışımıyla karşı karşıya buldum.",shape=box,color=red];
		696 -> 708;
	697 [label="Ne hissediyorsam ona inanıyorum. Ve bunu bana söylemesi için bir binaya ya da kitaba ihtiyacım yok.",shape=box,color=red];
		697 -> 709;
	690 [label="Gerçekten mi? Şaşırdım. Şaşırdım ama memnun da oldum. O zaman merak etmenize şaşmamalı. Öğretilerimiz bildiklerinize oldukça yabancı olmalı. Çok zaman geçti.",shape=box,color=blue];
		690 -> 704;
	691 [label="Buna saygı duyuyorum. Bilemeyeceğimiz şeyleri fark etmekte, insanlık durumunun küçüklüğünü kavramakta onur vardır.",shape=box,color=blue];
		691 -> 704;
	692 [label="Merak etme, alınmıyorum, zira çoğu durumda haksız da sayılmazsınız.",shape=box,color=blue];
		692 -> 705;
		692 -> 706;
	693 [label="Perdenin ardında bizi neyin beklediğini düşünmemenizi kıskandığımı itiraf etmeliyim. Keşke daha fazla insan sizin gibi olsaydı, dünyamız daha huzurlu olurdu.",shape=box,color=blue];
		693 -> 704;
	694 [label="Bu konuyu sizinle daha detaylı konuşmak istiyorum. Ama şu an değil, çünkü böyle bir tartışmaya hazır değilim.",shape=box,color=blue];
		694 -> 704;
	688 [label="Başlamak için mükemmel bir nokta. Bir kültürü bayramlarıyla tanımak, özünü anlamak demektir. Bir halk nasıl kutluyorsa, öyle hatırlanır. Bu anlar, onları paylaşanlar tarafından en çok değer verilen anlardır.",shape=box,color=blue];
		688 -> 702;
	689 [label="Elbette. Zaten bildiğiniz bir şeyle başlayalım: Sol ve Lua, güneş ve ay. Bunlar, görünümleri bakımından sonsuza dek dönüşebilen tanrılardır.",shape=box,color=blue];
		689 -> 703;
	710 [label="Hmm. Merakınızı gidereyim. Sizi sıkmamak için nereden başlamak istersiniz?",shape=box,color=blue];
		710 -> 665;
		710 -> 664;
	704 [label="Ve konudan saptığım için pişmanım. Korkarım ki konudan çok uzaklaştım.",shape=box,color=blue];
		704 -> 714;
