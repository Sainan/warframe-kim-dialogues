	675 [label="Hayır, ama dizginleyemediğim bir merakım var.",shape=box,color=red];
		675 -> 686;
	676 [label="Ben dindarım. Sizinkine benziyor ama bilebileceğin bir şey değil.",shape=box,color=red];
		676 -> 687;
	674 [label="Dindarım. Ama bizim ritüellerimize aşina değilsindir.",shape=box,color=red];
