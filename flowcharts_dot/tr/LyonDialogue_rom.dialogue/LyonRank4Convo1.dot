	662 [label="Korkarım ki, uzun uzun tartışabileceğim birçok konu var. Ama beni yanlış anlamayın, memnuniyetle yaparım, sadece sizi sıkmak istemiyorum. Nereden başlamak istersiniz?",shape=box,color=blue];
		662 -> 664;
