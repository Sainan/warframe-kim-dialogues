	705 [label="Ama bu, öğrenmeye ilgim olmadığı anlamına gelmiyor.",shape=box,color=red];
		705 -> 715;
	706 [label="Peki ya senin durumun?",shape=box,color=red];
		706 -> 716;
	702 [label="Başlıca, en yaygın bayramlarımız, yılın en kısa ve en uzun günlerinin yaşandığı Kış ve Yaz Gündönümleridir.",shape=box,color=blue];
		702 -> 711;
	703 [label="Yüzyıllar boyunca birçok inananın karşısına farklı biçimlerde çıktı. Bazen eril, bazen dişil. Ama her zaman Sol, Güneş ve Lua, Ay olarak.",shape=box,color=blue];
		703 -> 712;
		703 -> 713;
	714 [label="Adınlık Ortodoksluğu hakkında daha fazla bilgi edinmek istediniz, değil mi? Sıkıcı olmaması için nereden başlamak istersiniz?",shape=box,color=blue];
		714 -> 665;
		714 -> 664;
	717 [label="Hmm. Ve en iyisi bu tür şeyleri yakın bir arkadaşa anlatmaktır. Sizi çok iyi anlıyorum. Ayrıca, benden bilgi isteyen sizsiniz, tersi değil.",shape=box,color=blue];
		717 -> 704;
	718 [label="Ruhun vitray penceresi. Parçalara ayrılınca dağılıyor ama bir araya gelince çok güzel bir görüntü çiziyor.",shape=box,color=blue];
		718 -> 704;
	719 [label="Dünya, sizin inancınızı paylaşsaydı daha iyi bir yer olurdu.",shape=box,color=blue];
		719 -> 704;
	715 [label="Ve bu yüzden merakınızı ve bilgili ruhunuzu takdir ediyorum. ",shape=box,color=blue];
		715 -> 704;
	716 [label="Benim durumum... karmaşık. Ama yalan söyleyip korkmadığımı iddia etmeyeceğim. Din hayatıma bir korku seli getirmiş olsa da, onu asla ortadan kaldıramadı.",shape=box,color=blue];
		716 -> 704;
	711 [label="Bu iki bayram, kutlandıkları kişilere göre farklılık gösteren büyük şölenlerle kutlanır. Kış Gündönümü aile ve yakın arkadaşlarla kutlanırken, Yaz Gündönümü yabancılarla paylaşılır.",shape=box,color=blue];
		711 -> 720;
		711 -> 721;
	712 [label="Ah, şimdi çok daha mantıklı geliyor.",shape=box,color=red];
		712 -> 722;
	713 [label="[Devam etmesini bekle.]",shape=box,color=red];
		713 -> 723;
	720 [label="Gerçekten mi? Yaz Gündönümü hakkında bana biraz daha bilgi verir misin?",shape=box,color=red];
		720 -> 724;
	721 [label="Bana Kış Gündönümü'nü biraz daha anlatır mısın.",shape=box,color=red];
		721 -> 725;
	722 [label="Evet, bazı mezhepler ikonografi seçiminde biraz katı davranabiliyor, Güneş'in bir şekilde \"olması\" gerektiğini ya da başka bir şekilde \"olması\" gerektiğini iddia edebiliyorlar ancak Ortodoksluk bunu bir gerçek olarak kabul etmiyor.",shape=box,color=blue];
		722 -> 726;
	723 [label="Her bir Aydınlık birden fazla özellik içerir. Her özellik, bütünün bir işlevi olarak algılanabilir. Örneğin Lua, aynı anda hem anne, hem genç kız hem de yaşlı kadındır.",shape=box,color=blue];
		723 -> 731;
	724 [label="Yaz Gündönümü, büyük nimetleri paylaşmak ve hiç tanışmamış yabancıları bir araya getirmek içindir. Bir tarlada toplanır, ne olursa olsun kendi yaptığınız yiyecekleri ve eşyaları getirirsiniz.",shape=box,color=blue];
		724 -> 728;
	725 [label="Kış Gündönümü, soğuğa karşı kendimizi korumak ve en karanlık zamanlarda bizi ısıtanları anmak içindir. Bir ağacı mumlarla süslersiniz; gökyüzündeki yıldızlar gibi yol gösteren, bizden önce gelenlerin her biri için bir ışık yakarsınız.",shape=box,color=blue];
		725 -> 729;
	726 [label="Sanırım o uzak geleceğe kadar hayatta kalan her şey, dinimin belgelenmesi konusunda biraz... karışıklığa yol açtı.",shape=box,color=blue];
		726 -> 730;
	731 [label="Ama Lua aynı zamanda ruhları gözyaşı nehri boyunca sonsuz geceye doğru yönlendiren de olabilir. Ölümün ta kendisi. Müjdeci ve haberci.",shape=box,color=blue];
		731 -> 734;
	728 [label="Mumlar, ekmekler, kıyafetler, resimler. Ya da şiir kitapları. Ya da çiçek çelenkleri. Eli boş gelinse dahi \"müjdeli haberlerle\" gelmek de bir lütuf olarak görülür.",shape=box,color=blue];
		728 -> 732;
	729 [label="Ve onun tepesinde, karanlıkta yıldız ağacının tepesinde acı çeken Sol'un ta kendisidir. Soluklaşmış, ama unutulmamış. Çünkü bu Lua'nın zamanıdır. Ve biz onu bu gölge zamanında kutlarız.",shape=box,color=blue];
		729 -> 733;
	730 [label="Kendimi canlı bir arkeolojik kalıntı olarak görüyorum. Ne kadar da iç karartıcı. Ah yine konudan uzaklaşıyorum.",shape=box,color=blue];
		730 -> 723;
	734 [label="Diğer mezheplerde Ölüm, peçeli yaşlı bir kadın olarak tasvir edilir. Temsili farklılık gösterir, ancak her birimize ulaşan aynı ruhu, yani kader anında bize rehberlik etmek isteyen gümüş eli ifade eder.",shape=box,color=blue];
		734 -> 737;
	732 [label="Güneş'in en uzun günü yaşam, kahkaha ve müzik kutlanır ve her şey paylaşılır. ",shape=box,color=blue];
		732 -> 735;
	733 [label="Ve yaklaştıkça, kızarmış bir kuş, kök sebzeler ve donmuş toprakta taze olarak yetişmeyen her şeyle ziyafet çekerken, sevdiklerimiz yanımızda olur. Ve aramızdan göçenlerin hikayelerini anlatırız.",shape=box,color=blue];
		733 -> 736;
	737 [label="Güneş tutulması sırasında Güneş'in önüne geçen ay, her şeyin kaybolduğu o anda bizi yol ayrımına yönlendirir.",shape=box,color=blue];
		737 -> 739;
	735 [label="Herkes yabancılarla yeni arkadaşlıklar kurabilir ve ihtiyaç duyduğu şeyleri evine götürebilir.",shape=box,color=blue];
		735 -> 738;
	736 [label="Lua'nın en uzun gecesinde, onun nihayetinde bizi ve ailemizi bu zorlu geceden çıkaracağınızı hatırlarız.",shape=box,color=blue];
		736 -> 738;
