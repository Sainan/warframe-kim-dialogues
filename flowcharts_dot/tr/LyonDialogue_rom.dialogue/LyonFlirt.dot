	j4268961924 [label="Ve son zamanlarda aklımı meşgul eden her şeyi açıkça ifade ettiğim için bir kez daha özür dilerim:",shape=box,color=blue];
		j4268961924 -> j3656035392;
	j3656035392 [label="Şu an kendimi, çılgın bir fantezi dünyasında, görünüşte sonsuz ve kontrolsüz katliamların yaşandığı, yabancılar ve konuşan canavarlarla çevrili buluyorum.",shape=box,color=blue];
		j3656035392 -> j925864610;
	j925864610 [label="Tanıdığım her şey, ''Yeşim Işığı'', ''Orokin İmparatorluğu'' ve ''Void''in ışınlarıyla silinip süpürüldü ve ''Murmur'' tarafından tehdit ediliyor.",shape=box,color=blue];
		j925864610 -> j2656183678;
	j2656183678 [label="Bu yüzden, sizin bu teklifinizi, naifliği nedeniyle tuhaf bir şekilde gülünç bulduğum için beni bağışlayın. Sizi tanımıyorum ve size güvenmiyorum. Aslında, elimde sadece başkalarının söyledikleri var.",shape=box,color=blue];
		j2656183678 -> j1514882984;
