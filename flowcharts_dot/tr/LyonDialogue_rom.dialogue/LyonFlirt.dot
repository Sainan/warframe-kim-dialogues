	"Chat ends." [color=orange];
	j1225784476 [label="Lyon, seninle eğlenmek için flört etmiyordum. Eğer meselenin bu olduğunu düşünüyorsan özür dilerim.",shape=box,color=red];
		j1225784476 -> j784474986;
