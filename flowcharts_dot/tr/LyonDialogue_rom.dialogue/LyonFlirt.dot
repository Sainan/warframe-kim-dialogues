	j633499043 [label="Bütün bunlar, Marie ve benim önümüze yığılmış dış güçlerden başka bir şey değil - sizin göremediğiniz diğer tüm mücadelelerimden bahsetmiyorum bile.",shape=box,color=blue];
		j633499043 -> j1571097452;
