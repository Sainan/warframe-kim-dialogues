		727 -> 796;
	796 [label="Ya da büyük ihtimalle Astafor 8:23'ü hatırlıyordur: \"Evime zorla girmeye çalışan ruhlar yalnızdır, çünkü onlar Sol'un ışığından kovulmuş olanlardır.\"",shape=box,color=blue];
		796 -> 799;
