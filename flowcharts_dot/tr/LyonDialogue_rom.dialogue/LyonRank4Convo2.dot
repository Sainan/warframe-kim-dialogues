	814 [label="Hayatım boyunca barıştan çok savaş gördüm Lyon. Eğer beni rahatsız etmesine izin verseydim, sanırım hâlâ burada olmazdım. Ama bu, gerçek bir yük - gerçek bir bedel - getirmediği anlamına gelmiyor.",shape=box,color=red];
		814 -> 816;
