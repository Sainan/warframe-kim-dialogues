		784 -> 789;
	785 [label="Mary'nin \"païens!\" diye bağırdığını ve kendini kavgaya attığını duyuyorum, ama yine de farklı inançları yüzünden birini kınadığını hayal etmekte zorlanıyorum. Sanırım sen de pek farklı değilsin. Senin hakkında çok iyi fikirleri olduğu açık.",shape=box,color=red];
		785 -> 790;
	786 [label="Kiliseniz, senin ve Marie'nin burada yaptıklarını nasıl değerlendirir? Onun adına yapmanız gerekenler düşünülünce?",shape=box,color=red];
		786 -> 791;
	787 [label="Seni ve Marie'yi savaş meydanında izliyorum, sonra onunla özel olarak konuşuyorum ve seni sessizce kitap okurken görüyorum... ve itiraf etmeliyim ki bu kişileri zihnimde bir araya getirmekte zorlanıyorum.",shape=box,color=red];
	788 [label="Mevcut durumumuzu sadece \"tuhaf\" buluyorsanız, ya cesaretinizden etkileniyorum ya da sınırlı kelime dağarcığınızdan dehşete düşüyorum. Ancak, sanırım ilki.",shape=box,color=blue];
		788 -> 793;
	789 [label="Chat ends.",color=orange];
	790 [label="Haklısınız. Marie, kalbinde kadim bir ağaç tanrısı taşıdığı için başkalarını kınayacak biri değil; aksine, onlarla hangi inançlara sahip olduğunu bulmaya çalışır.",shape=box,color=blue];
		790 -> 794;
	791 [label="O zamanlar Sol veya Lua adına birçok kutsal savaş yapıldı. ''Kâfirleri'' geri püskürtmek veya ''kutsal toprakları geri almak'' ya da o anda popüler olan başka bir uydurma gerekçeyle kanlı ''haçlı seferleri'' düzenlendi.",shape=box,color=blue];
		791 -> 795;
	793 [label="+5 Chemistry",color=orange];
		793 -> 797;
	794 [label="Ağaç, Sol'un ışığıyla beslenmiyor mu acaba? Ekmeği bölüşmek için ortak bir nokta yok mu? İnançları yüzünden birine zarar vermektense oturup dinlemeye daha istekli.",shape=box,color=blue];
		794 -> 798;
	795 [label="Aydınlık Ortodoksluğunun ordusu yoktur ve savaş açmaz. Kendilerine bağlı olanların eylemde bulunmasını veya başkalarını korumasını engellemezler.",shape=box,color=blue];
		795 -> 727;
	797 [label="Yani, evet, devam edin demek istiyorum. Bana merak ettiğiniz bir soruyu sorarak durumu benim için daha da tuhaf hale getiremezsiniz.",shape=box,color=blue];
		797 -> 785;
