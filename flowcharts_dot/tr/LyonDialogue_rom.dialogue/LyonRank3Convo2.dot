		j2088796465 -> j3711756016;
	j655551099 [label="Elbette. Karşılaştığım en saf, en parlak ruhların bazıları bir canavarın etine bürünmüştü. Aydınlığın onları nasıl doğru yola soktuğunu yargılamak bana düşmez.",shape=box,color=blue];
		j655551099 -> j2758881676;
	j1183388429 [label="Her zaman yaptığı gibi hırıltılı bir miyavlamayla beni selamladı ve aşağı atlayıp bacağıma sürtündü.",shape=box,color=blue];
		j1183388429 -> j2409157375;
	j3711756016 [label="Güzel bir soru. Bazı mezheplerde hayır. Sapkınlık olarak görülür. Ama bizimkinde evet. Hayvanların ruhları olduğunu kabul ediyoruz.",shape=box,color=blue];
		j3711756016 -> j2758881676;
