		87 -> 93;
	88 [label="Çok fazla şiddet gördüm, Lyon. Çoğuna ben neden oldum. Artık herkesin, kim olursa olsun, ne yapmış olursa olsun, sevdikleri insanlarla çevrili huzurlu bir şekilde ölebileceğini umut ediyorum.",shape=box,color=red];
