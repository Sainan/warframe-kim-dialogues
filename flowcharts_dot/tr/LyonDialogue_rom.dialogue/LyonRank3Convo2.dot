		j2860566647 -> j4126283842;
	j482618779 [label="O bir hayvandı. Sadece tatmin olmak için arayış içindeydi - yiyecek, barınak, sevgi - insanlarla aynı motivasyonlarla hareket etmiyordu. ''Yalan söylemiyordu'', sadece farklı araçlarla avlanıyordu.",shape=box,color=red];
		j482618779 -> j2516259150;
