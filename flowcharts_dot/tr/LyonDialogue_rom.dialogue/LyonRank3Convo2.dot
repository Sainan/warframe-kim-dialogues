		53 -> 56;
	54 [label="Güzel bir soru. Bazı mezheplerde hayır. Sapkınlık olarak görülür. Ama bizimkinde evet. Hayvanların ruhları olduğunu kabul ediyoruz.",shape=box,color=blue];
		54 -> 55;
