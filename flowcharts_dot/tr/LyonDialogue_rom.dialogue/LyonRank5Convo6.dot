		1861 -> 1865;
	1852 [label="Hayır, korkarım ki benimle paylaştıklarını sizden gizlemeliyim. Ama yine de onu çok etkilemişti. Yine de merak ediyorum, aranızdaki meselelerin çözülme şeklinden memnun kaldınız mı?",shape=box,color=blue];
		1852 -> 1851;
	1862 [label="Olanların büyüklüğünü, hatta ihtişamını kavrayabildiğime inanıyorum. Küçük de olsa bir parçası olmaktan büyük onur duyuyorum.",shape=box,color=blue];
		1862 -> 1869;
		1862 -> 1870;
