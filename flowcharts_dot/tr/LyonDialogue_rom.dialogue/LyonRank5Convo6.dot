		1849 -> 1852;
	1853 [label="Evet. Sanırım Loid ile üst kattaki aile arasındaki sorunları çözmesine yardım etmesi... benim için çok önemliydi. Ne kadar önemli olduğunu anlatamam.",shape=box,color=red];
		1853 -> 1862;
