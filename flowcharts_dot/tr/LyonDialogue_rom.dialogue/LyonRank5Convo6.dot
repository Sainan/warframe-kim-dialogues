		1868 -> 1877;
	1864 [label="Hm. Ne yazık ki, her şeyin bir kenara bırakılması gereken zaman elbet gelir. Bir hamur fazla yoğurulabilir. Bir sanatçı, resmine gereğinden fazla şey katabilir. Ve bir tartışma kesinlikle aşırıya kaçabilir.",shape=box,color=blue];
