		1863 -> 1871;
	1866 [label="Büyüleyici... Şey, onun üzerinde bir miktar... etkim olduğu bariz, ne kadar sınırlı da olsa. Bay Loid ile Entrati'nin yabancılaşmış ailesi arasındaki ilişkilerin düzeltilmesinin önemli olduğunu mu düşünüyorsunuz?",shape=box,color=blue];
		1866 -> 1874;
		1866 -> 1875;
