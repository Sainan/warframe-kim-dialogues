		j2431945058 -> j3153357260;
	j1340502888 [label="Rüyamda, zihnimde beni ziyaret eden genç adam ve sessiz bekçisi, bana hem yabancı hem de tanıdık geliyordu, sanki kardeş gibi birlikte büyümüşüz.",shape=box,color=blue];
		j1340502888 -> j4072187279;
	j232997738 [label="Kesinlikle haklısınız. Duviri'nin ahlaki ve teolojik çıkarımlarını saatlerce tartışarak burada kaybolabiliriz.",shape=box,color=blue];
		j232997738 -> j1340502888;
	j1705331020 [label="Sizin yerinizde olsaydım neler hayal edebilirdim diye en ufak bir düşünce bile aklıma gelince dehşete kapılıyorum. Ama bu tür şeyleri saatlerce tartışabiliriz.",shape=box,color=blue];
		j1705331020 -> j1340502888;
	j3153357260 [label="Eğer değişim belirtileri gösteriyorsa ve o sizin duygularınızın bir ürünü ise, belki de bu başka bir şeyin göstergesidir. Ama belki de bu konuyu başka bir gün tartışırız.",shape=box,color=blue];
		j3153357260 -> j1340502888;
	j4072187279 [label="Abartılı bir metafor kullandığım için beni bağışlayınız, ama sanki kökleri o kadar birbirine yakınlaşmış üç ağaçtık ki, artık birbirimizden ayırt edilemez hale gelmiştik -",shape=box,color=blue];
		j4072187279 -> j475914422;
	j475914422 [label="- sanki birdenbire, bu halde ortaya çıkmışlar gibi. Rell ve Harrow'un olmadığı hayatımı hatırlıyordum. Ama yine de oradaydılar. Her an, her zaman, yanımdaydılar.",shape=box,color=blue];
		j475914422 -> j65162237;
	j65162237 [label="Bu arada, keşke bu konu hakkında Entrati ile konuşabilseydim, bunun özünde - kasıtlı olarak söylemiyorum - nasıl bir bilim olduğunu merak ediyorum, ama nihayetinde değişimimizden iyileştiğimizde Entrati çoktan gitmişti.",shape=box,color=blue];
