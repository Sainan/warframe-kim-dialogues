		j647994495 -> j2969866210;
	j94892651 [label="Gençliğimin tüm hayalleri, gördüğüm tüm o korkunç şeyler – hepsi sadece Kayıtsızlık'tan mı ibaretti? Yanlış mı hatırlıyordum? Yoksa gerçekten Lua tarafından ''kutsanmış'' mıydım?",shape=box,color=blue];
		j94892651 -> j3344386000;
