		j3484149296 -> j1960194104;
	j2969866210 [label="Ama bu karşılıklıydı. Onlar benim hayatımda yer alırken, ben de onların hayatında yer alıyordum. Kayıtsızlığı gördüm. Neye karşı çıktıklarını anladım. Harrow'u ve onun eskiden nasıl bir adam olduğunu gördüm.",shape=box,color=blue];
		j2969866210 -> j2896710759;
