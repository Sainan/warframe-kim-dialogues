		j4008758555 -> "Chat ends. Next chat will be Lyon5FaithDay2.";
	j1460969585 [label="Acı bittiğinde, zaten kötü olan görüşüm... bulanıklaştı. Bir şekilde... iki katına mı çıktı? Sanki bir değil, iki kez görebiliyormuşum gibi.",shape=box,color=blue];
		j1460969585 -> j4200796250;
	j4200796250 [label="Ancak, kusmadan ve bayılmadan önce pantolonumu giymeyi başardığım için dayanıklılığımla oldukça gurur duyuyorum.",shape=box,color=blue];
		j4200796250 -> j2711074188;
	j2711074188 [label="Uyandığımda yalnız değildim. Ancak odamın zemininde de değildim. Çocukluğumdan kalma yatak odamda, çok iyi bildiğim gıcırdayan eski zeminin üzerinde oturuyordum.",shape=box,color=blue];
		j2711074188 -> j3646579409;
	j3646579409 [label="Yanımda oturan genç bir adam vardı. Onun yanında, bugün Harrow olarak tanıdığım bir siluet duruyordu. Genç adam elinde küçük, tahta bir figür tutuyordu. Eklemli bir figür, kıvrımlar ve çatlaklar hariç, tüm boyasını kaybetmişti. Bu figür babama aitti. Bir askerin figürüydü.",shape=box,color=blue];
		j3646579409 -> j3357416985;
	j3357416985 [label="Çocukluğumda sahiplenebildiğim tek oyuncak oydu.",shape=box,color=blue];
		j3357416985 -> j4067597317;
		j3357416985 -> j89066518;
	j4067597317 [label="Benim de çocukluğumda buna benzer bir oyuncağım vardı. En sevdiğim oyuncaklarımdan biriydi.",shape=box,color=red];
