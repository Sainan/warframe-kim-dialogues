	j1316396836 [label="Check boolean LyonPolyamorySuccess",color=orange];
		j1316396836 -> j1181132753 [label=true,color=green];
		j1316396836 -> "Chat ends." [label=false,color=brown];
	j4190667171 [label="Müsaadenizle, ikimizin de içini rahatlatacağını düşündüğüm bir konuyu kısaca tartışmak istiyorum, mon miracle.",shape=box,color=blue];
		j4190667171 -> j3263862246;
		j4190667171 -> j3593587886;
	j3263862246 [label="[Son.]",shape=box,color=red];
		j3263862246 -> j3944516755;
	j3593587886 [label="Lyon, bir sorun mu var?",shape=box,color=red];
		j3593587886 -> j2960280560;
	j3944516755 [label="Boolean LyonConsentComplete is now true.",color=orange];
		j3944516755 -> "Chat ends.";
	j2960280560 [label="Hayır, sorun yok. Sadece, benimle olmadığınız zamanlarda başka biriyle... aşk dolu bir şekilde vakit geçirdiğinizi bildiğimi söylemek istedim.",shape=box,color=blue];
		j2960280560 -> j372576978;
	j372576978 [label="Ve sadece şunu temin etmek isterim ki, bu durum beni ne duraklattı ne de tedirgin etti. Hayatımda olmanız bana sadece huzur, ve neşe getirdi...",shape=box,color=blue];
		j372576978 -> j654290488;
	j654290488 [label="Ve ben böyle bir armağanın bir başkasına bahşedilmesini nasıl reddedebilirim?",shape=box,color=blue];
		j654290488 -> j1339627188;
		j654290488 -> j2713556883;
	j1339627188 [label="Bence ne olursa olsun o da seni çok severlerdi.",shape=box,color=red];
		j1339627188 -> j1488902001;
	j2713556883 [label="Teşekkür ederim. Bu benim için çok şey ifade ediyor.",shape=box,color=red];
		j2713556883 -> j1581910021;
	j1488902001 [label="Düşüncesi bile beni gülümsetiyor. Kim bilir, belki başka bir hayatta, başka bir günde karşılaşırız. ",shape=box,color=blue];
		j1488902001 -> j2044975168;
	j1581910021 [label="Biz olduğumuz gibi - ben olduğum gibi, bana sunduğunuz her şeyle, temsil ettiğimiz her şeyle... memnunum. Hatta memnuniyetten de fazlası; mutluyum. Çok, çok uzun zamandır ilk kez mutluyum.",shape=box,color=blue];
		j1581910021 -> j1174098522;
	j2044975168 [label="Ama bu sefer, içinde bulunduğumuz halden memnunum. Hatta memnuniyetten de fazlası; mutluyum. Çok, çok uzun zamandır ilk kez mutluyum.",shape=box,color=blue];
		j2044975168 -> j1174098522;
	j1174098522 [label="Ve bunun için size teşekkür borçluyum. Ancak şimdilik veda etmem gerek.",shape=box,color=blue];
		j1174098522 -> j698039068;
	j698039068 [label="- Lyon",shape=box,color=blue];
		j698039068 -> j3944516755;
}