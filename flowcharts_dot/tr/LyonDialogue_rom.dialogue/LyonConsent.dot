	2216 [label="Müsaadenizle, ikimizin de içini rahatlatacağını düşündüğüm bir konuyu kısaca tartışmak istiyorum, mon miracle.",shape=box,color=blue];
		2216 -> 2217;
		2216 -> 2218;
	2214 [label="Chat ends.",color=orange];
	2217 [label="[Son.]",shape=box,color=red];
		2217 -> 2219;
	2218 [label="Lyon, bir sorun mu var?",shape=box,color=red];
		2218 -> 2220;
	2219 [label="Update boolean LyonConsentComplete",color=orange];
		2219 -> 2221;
	2220 [label="Hayır, sorun yok. Sadece, benimle olmadığınız zamanlarda başka biriyle... aşk dolu bir şekilde vakit geçirdiğinizi bildiğimi söylemek istedim.",shape=box,color=blue];
		2220 -> 2222;
	2221 [label="Chat ends.",color=orange];
	2222 [label="Ve sadece şunu temin etmek isterim ki, bu durum beni ne duraklattı ne de tedirgin etti. Hayatımda olmanız bana sadece huzur, ve neşe getirdi...",shape=box,color=blue];
		2222 -> 2223;
	2223 [label="Ve ben böyle bir armağanın bir başkasına bahşedilmesini nasıl reddedebilirim?",shape=box,color=blue];
		2223 -> 2224;
		2223 -> 2225;
	2224 [label="Bence ne olursa olsun o da seni çok severlerdi.",shape=box,color=red];
		2224 -> 2226;
	2225 [label="Teşekkür ederim. Bu benim için çok şey ifade ediyor.",shape=box,color=red];
		2225 -> 2227;
	2226 [label="Düşüncesi bile beni gülümsetiyor. Kim bilir, belki başka bir hayatta, başka bir günde karşılaşırız. ",shape=box,color=blue];
		2226 -> 2228;
	2227 [label="Biz olduğumuz gibi - ben olduğum gibi, bana sunduğunuz her şeyle, temsil ettiğimiz her şeyle... memnunum. Hatta memnuniyetten de fazlası; mutluyum. Çok, çok uzun zamandır ilk kez mutluyum.",shape=box,color=blue];
		2227 -> 2229;
	2228 [label="Ama bu sefer, içinde bulunduğumuz halden memnunum. Hatta memnuniyetten de fazlası; mutluyum. Çok, çok uzun zamandır ilk kez mutluyum.",shape=box,color=blue];
		2228 -> 2229;
	2229 [label="Ve bunun için size teşekkür borçluyum. Ancak şimdilik veda etmem gerek.",shape=box,color=blue];
		2229 -> 2230;
	2230 [label="- Lyon",shape=box,color=blue];
		2230 -> 1193;
	1193 [label="Update boolean LyonConsentComplete",color=orange];
		1193 -> 1187;
	1187 [label="Chat ends.",color=orange];
