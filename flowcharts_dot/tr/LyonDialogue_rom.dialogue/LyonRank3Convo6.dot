		622 -> 623;
	623 [label="Tam bir yıl sonra, son kez yeniden ortaya çıktı, yanında... Roathe, şimdi gördüğünüz gibi, ayaklarının dibinde baygın bir şekilde yatıyordu.",shape=box,color=blue];
		623 -> 626;
	624 [label="Üç yıl, iki ay ve on bir gün boyunca, katedralimizde Kardinal Dimanche olarak görev yaptı. Ve tüm bu süre boyunca, Marie ve ben, onun bize ne hazırladığından habersiz olarak ona hizmet ettik.",shape=box,color=blue];
		624 -> 594;
	625 [label="Ama bu beklenen bir şey; bir deliye basit bir soru sormak çoğu zaman beyhude bir çabadır. İzin verin, sizin ilk konunuza geri dönelim ve benim konudan uzaklaşalım.",shape=box,color=blue];
		625 -> 624;
	626 [label="Görünüşe göre, o bir şeytandı. O anda Entrati, kim olduğunu ve bize yüklemeyi planladığı gerçek görevini açıkladı.",shape=box,color=blue];
