		617 -> 623 [label="false",color=purple];
	618 [label="Heh. Ben böyle düşünmemiştim ama evet - belki de öyleydi. Geri kalanlarınız için ne kadar sinir bozucu bir durum. Onun gerçek kişiliği hakkında bildiğimiz kısıtlı şey ile uyumlu görünüyor.",shape=box,color=blue];
