	643 [label="Bu konuda hemfikiriz. Ama onu bu konuda da suçlayamam. Ona zaman verin. Anlayacaktır. O çok zeki Gezgin. Ona aptal muamelesi yapmayın.",shape=box,color=blue];
		643 -> 645;
	644 [label="Entrati son kez ayrıldı. Ve Roathe'ı yanımıza bıraktı, şimdi gördüğünüz şeye dönüşmüştü - huysuz şeytanla daha iyi başa çıkabilecek durumdaydı.",shape=box,color=blue];
		644 -> 646;
