	646 [label="Hikayenin geri kalanı için maalesef ki beklemek zorundayız. Bay Loid'un POM-2'ye ihtiyacı var ve ben de ona geri vermek için sabırsızlanıyorum. Umarım bu, bazı sorularınızı cevaplamıştır.",shape=box,color=blue];
