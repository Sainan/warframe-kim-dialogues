		611 -> 617;
	612 [label="Başkalarının düşüncelerini okumak imkansızdır. Başı eğik bir şekilde sunak önünde diz çökmüştü. Dua mı ediyordu? Yoksa sadece düşüncelerine mi dalmıştı? Bilmiyorum.",shape=box,color=blue];
