	599 [label="Kısacası. Evet.",shape=box,color=blue];
		599 -> 603;
	600 [label="O zaman şunu söyleyeceğim, hayal kırıklığına hazır olun. Bu üç yıl, iki ay ve on bir gün boyunca ne yaptı? Vaaz verdi. Çalıştı. Dinlendi. Ve dua etti.",shape=box,color=blue];
