		593 -> 599;
	594 [label="Sorularınızı sormadan önce biliyorum. Ne planlıyordu? Höllvania'ya yaptığını duyduğum gibi şehri de enfekte mi etti? Planları neydi? Keşifleri nelerdi?",shape=box,color=blue];
		594 -> 600;
	597 [label="İtiraf etmek istediğiniz bir şey mi var Gezgin? Ödemek istediğiniz bir kefaret mi var?",shape=box,color=blue];
		597 -> 601;
	596 [label="Hımm. Hayır. Henüz değil belki.",shape=box,color=blue];
		596 -> 595;
	595 [label="Samimiyetsizliğiniz bir yalandan gelmiyor. Bu bir sadaka gibi. Sadakaya ne ihtiyacım var ne de isteğim. ",shape=box,color=blue];
		595 -> 592;
		595 -> 593;
	598 [label="En iyisi bunu ona kendiniz sorun. Ben de sık sık aynı şeyi düşünüyorum.",shape=box,color=blue];
