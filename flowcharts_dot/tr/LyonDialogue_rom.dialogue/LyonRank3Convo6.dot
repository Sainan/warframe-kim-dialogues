	577 [label="Bana, bizim gibi düşünmeyebileceğini söylediler. Ama bu beni rahatsız etmiyor. Beni ilgilendiren, bildikleriniz.",shape=box,color=red];
		577 -> 581;
	574 [label="Marie, \"le Cardinal\"e takıntılı gibi görünüyor. Roathe ise ondan açıkça nefret ediyor. Ben tarafsız birini arıyorum. Sen bana en yakın olansın.",shape=box,color=red];
		574 -> 578;
	575 [label="Ben... başka ne soracağımı bilmiyorum?",shape=box,color=red];
		575 -> 579;
	576 [label="Bana, olaylara bizim gibi bakmayabileceğin konusunda uyarıda bulunuldu. Ama bence sen başkalarının göremediği gerçeği görebilirsin.",shape=box,color=red];
		576 -> 580;
	581 [label="Hmm. Deli ve çılgınlarla birlikte olmak sizi rahatsız etmiyor mu? İlginç. Gerçi siz konuşan hayvanlarla ve... zamanın dışındaki yaratıklarla arkadaşlık ediyor gibisiniz. Sanırım ben de sizin koleksiyonunuzdaki diğerlerinden daha fazla ya da daha az tuhaf değilimdir.",shape=box,color=blue];
		581 -> 582;
	578 [label="\"Tarafsız\" bir görüş için tek kaynağınız bir deli ve akıl hastasıyken, ne kadar da mantıklı seçeneklerle karşı karşıyasınız. Neden benimle konuşma zahmetine girdiğinizi anlayamıyorum.",shape=box,color=blue];
		578 -> 582;
	579 [label="Neden benimle konuşmakta ısrar ediyorsunuz ki? Buna ihtiyacınız yok, farkındasınız. Marie ile arkadaş olmak -hatta kur yapmak- istiyorsanız, ben onun koruyucusu ya da babası değilim. Ve o namussuz Roathe ile ilgili niyetiniz ne olursa olsun, bana borçlu olduğu cevapların dışında kendisi pek umurumda değil.",shape=box,color=blue];
		579 -> 582;
	580 [label="''Gerçek.'' Son zamanlarda bunun benim için ne kadar gülünç olduğunu keşke anlasaydınız. Deli ve çılgınlarla birlikte olmak sizi rahatsız etmiyor mu? İlginç. Siz konuşan hayvanlarla ve... zamanın dışındaki yaratıklarla arkadaşlık ediyor gibi görünüyorsunuz. Sanırım ben de koleksiyonunuzdaki diğerlerinden daha fazla ya da daha az tuhaf değilimdir.",shape=box,color=blue];
		580 -> 582;
	582 [label="Evaluate expressions",color=orange];
		582 -> 585 [label="LyonFirstFlirt",color=purple];
		582 -> 585 [label="DrifterLyon",color=purple];
		582 -> 584 [label="LyonOffer",color=purple];
		582 -> 583 [label="false",color=purple];
	585 [label="Ve lütfen, bizi başka bir utanç verici andan kurtarır mısınız? Bana söylemek için öne sürdüğünüz nedenlerin gurur verici olduğunu biliyorum, ama aynı zamanda son derece ikiyüzlü olduğunu da biliyorum.",shape=box,color=blue];
		585 -> 586;
		585 -> 587;
		585 -> 588;
	584 [label="Ve lütfen, ikimize de ''bana yardım etmek'' istediğinizle ilgili başka bir konuşma yapmayın, olur mu? Niyetinizin iyi olduğundan eminim, ama bu saçma ikiyüzlülük çok sinir bozucu.",shape=box,color=blue];
		584 -> 586;
		584 -> 587;
		584 -> 588;
	583 [label="Ve lütfen, bana ''yardım etmek'' ya da ''arkadaşlığınızı sunmak'' istediğinizle ilgili uzun uzun konuşmalar yapmayın. Niyetinizin iyi olduğundan eminim, ama bu saçma ikiyüzlülük çok sinir bozucu.",shape=box,color=blue];
		583 -> 586;
		583 -> 587;
		583 -> 588;
	586 [label="Söylediklerimi kastetmediğimi düşündüğün için mi; yoksa senin hakkında söylediklerimi kastetmediğimi düşündüğün için mi samimiyetsiz?",shape=box,color=red];
		586 -> 589;
	587 [label="Ben sadece Entrati'nin ne kadar süredir Kardinal gibi davrandığının hikayesini duymak istiyordum Rahip. Hepsi bu.",shape=box,color=red];
		587 -> 590;
	588 [label="\"Samimiyetsiz\" derken neyi kastediyorsun? Bana yalancı mı diyorsun?",shape=box,color=red];
		588 -> 591;
	589 [label="İkisi de değil. Sözleriniz benim ne ihtiyacım olan ne de talep ettiğim bir sadakadır.",shape=box,color=blue];
		589 -> 592;
		589 -> 593;
	590 [label="Çok iyi. Üç yıl, iki ay ve on bir gün boyunca, katedralimizde Kardinal Dimanche olarak görev yaptı. Ve tüm bu süre boyunca, Marie ve ben, onun bize ne hazırladığından habersiz olarak ona hizmet ettik.",shape=box,color=blue];
		590 -> 594;
