	1195 [label="Ya endişeden, ya iğrenmeden ya da bir delinin kafesinin parmaklıklarından içeri bakmaya itebilecek hastalıklı bir meraktan. Acaba siz bunlardan hangisisiniz?",shape=box,color=blue];
