	1197 [label="Genellikle herkesin en kolay yorum yaptığı şey budur. Ya endişe, ya tiksinti ya da hastalıklı merak nedeniyle.",shape=box,color=blue];
		1197 -> 1204;
	1194 [label="Eğer bu seçiminiz yüzünden kendinizi korkak olarak görüyorsanız, yalvarırım görmeyin. Çünkü bu, sizin yüzleşmeniz gereken bir acı değil. Bu benim acım. Bu anı yaşamayı siz istemediniz.",shape=box,color=blue];
