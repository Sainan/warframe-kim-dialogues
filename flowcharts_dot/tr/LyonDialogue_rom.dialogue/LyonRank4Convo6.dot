	1215 [label="Hayır, korkarım ki öyle olmadı. Beni rahatsız eden görüntülerden zihnimi arındırmak için gerekli olan bir şeyi aldı ve onu bu serumun ''hediyelerini'' kullanmak için gerekli bir şeye dönüştürdü.",shape=box,color=blue];
