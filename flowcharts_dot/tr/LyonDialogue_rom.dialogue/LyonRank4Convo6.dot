		1210 -> 1215;
	1205 [label="Ben bunun tam tersini savunuyorum; sıradan sosyal etkileşimlerimizde kuşandığımız zırhlardan kurtulduğumuzda, bizi koruyabilecek şeylerden de mahrum kalıyoruz.",shape=box,color=blue];
		1205 -> 1211;
	1209 [label="Ben... bu konuyu ele alış biçimini takdir ediyorum, Gezgin. Teşekkür ederim. Ama ben bu konunun tartışılmasına oldukça alışkınım. İster endişe, ister tiksinti, ister hastalıklı bir merak olsun - gerçi siz zaten ilk gruba girdiğinizi kanıtladınız sanırım.",shape=box,color=blue];
