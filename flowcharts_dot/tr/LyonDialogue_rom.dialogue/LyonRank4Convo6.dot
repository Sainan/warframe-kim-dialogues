		1191 -> 1196;
	1190 [label="Mm. Açıkçası, benim bu özel özelliğim hakkında bilgi edinmenizin bu kadar uzun sürmesine şaşırdım. Genellikle çoğu kişinin en kolay yorum yaptığı şey budur.",shape=box,color=blue];
		1190 -> 1195;
