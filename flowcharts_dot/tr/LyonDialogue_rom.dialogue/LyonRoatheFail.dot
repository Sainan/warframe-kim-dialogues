		j1618578127 -> j2698450341 [label="RoatheFailNot21",color=purple];
		j1618578127 -> j3789931140 [label="RoatheFailUnloved",color=purple];
	j1502552824 [label="Roathe, işin sonunda serumu almasının gerçeğiyle yüzleşiyor. Nasıl olduğunu bilmiyorum ama sanırım ona bu süreçte yardımcı olmakta pek başarılı olamadım.",shape=box,color=red];
		j1502552824 -> j1554209855;
	j127024223 [label="Emin değilim. Sanırım söylememem gereken bir şey söyledim.",shape=box,color=red];
		j127024223 -> j2765870000;
	j2698450341 [label="Bana anılarının derinliklerini daha fazla kurcalamamamı söyledi. Ben de kurcalamadım. Şimdi de sanki... ilerleme kaydedilmiyor gibi görünüyor.",shape=box,color=red];
		j2698450341 -> j1809482379;
	j3789931140 [label="Ona 'sadece arada sırada birlikte takıldığım birisi' olduğunu söyledim ve o bunu sorun etmiyor gibi görünse de şimdi aramızda bir gerileme olduğunu hissediyorum.",shape=box,color=red];
		j3789931140 -> j3910747912;
	j1554209855 [label="Anlıyorum. Geçmişteki eylemleriyle yeni bir bakış açısıyla yüzleşmek zor olabiliyor. Onu ve bizi bu iğrenç duruma zorladığı için Entrati'ye lanet ediyorum.",shape=box,color=blue];
		j1554209855 -> j1123445626;
	j2765870000 [label="Anlıyorum. Korkarım bu konuda yapabileceğim pek bir şey yok, çünkü bu konuda \"ektiğinizi biçmenin\" sonuçlarını yaşıyorsunuz.",shape=box,color=blue];
		j2765870000 -> j3774958556;
	j1809482379 [label="Anlıyorum. Bazen birinin iyiliğini isteyerek hareket etmek, isteklerini harfiyen yerine getirmekle aynı şey değildir.",shape=box,color=blue];
		j1809482379 -> j2847254568;
	j3910747912 [label="Anlıyorum. Korkarım bu konuda yapabileceğim pek bir şey yok, çünkü bu konuda \"ektiğini biçmenin\" sonuçlarını yaşıyorsunuz.",shape=box,color=blue];
		j3910747912 -> j3774958556;
	j1123445626 [label="Sizi dinlemeye ikna etmek için elimden geleni yapacağım. Ama eylemlerini korkaklıktan ziyade başka bir şey olarak yorumlayabilmesi için daha iyi argümanlar hazırlamanızı tavsiye etmeliyim.",shape=box,color=blue];
		j1123445626 -> j116975699;
	j3774958556 [label="Bu şekilde duyarsız ve umursamaz davranmak, aynı şekilde karşılık bulan bir davranışla sonuçlanacaktır. Özellikle de Roathe gibi biriyle karşı karşıyaysanız.",shape=box,color=blue];
		j3774958556 -> j4223870659;
	j2847254568 [label="Birinin arzularına karşı gelmek, özellikle de özel anılarını ve düşüncelerini karıştırmak korkunç bir davranış.",shape=box,color=blue];
		j2847254568 -> j2924900106;
	j116975699 [label="Çünkü biliyorum ki onu içten içe kemiren şey tam olarak bu.",shape=box,color=blue];
		j116975699 -> j3202598127;
	j4223870659 [label="Durumu düzeltmek için hangi yola başvuracağınızı bilmiyorum. Ama affınıza sığınarak söylüyorum ki; Marie ve benim aracılığımla bir yol bulabileceğinizi sanmıyorum.",shape=box,color=blue];
		j4223870659 -> j96809028;
	j2924900106 [label="Entrati'yi, onu ve bizi böylesine aşağılık bir duruma zorladığı için lanetliyorum.",shape=box,color=blue];
		j2924900106 -> j2273593256;
	j3202598127 [label="Bu konuda Marie'nin de yardımına ihtiyacımız olacağını biliyorum. Onu ikna etmek daha zor olabilir, çünkü biliyorsun ki ikisi arasında pek sevgi yok.",shape=box,color=blue];
		j3202598127 -> j1844071738;
	j96809028 [label="Belki de bu noktada başka seçenekleri değerlendirmek en iyisi olacaktır.",shape=box,color=blue];
		j96809028 -> "Chat ends.";
	j2273593256 [label="Ama bana öyle geliyor ki, ona yardım etmenin tek yolu maalesef tam da bunu yapmak. Ve Descendia'yı, keşfedilmemiş hiçbir anı kalmayana kadar keşfetmeye devam etmek.",shape=box,color=blue];
		j2273593256 -> j471309980;
