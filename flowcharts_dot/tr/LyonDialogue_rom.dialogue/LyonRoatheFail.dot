	"Chat ends." [color=orange];
	j3094814265 [label="Yardımcı olabileceğim bir şey varsa yaparım, mon miracle. İkinizin arasında ne terslik var ki?",shape=box,color=blue];
		j3094814265 -> j477154082;
	j3814552948 [label="Yardımcı olabileceğim bir şey varsa yaparım, dostum. İkinizin arasında ne terslik var ki?",shape=box,color=blue];
		j3814552948 -> j477154082;
	j477154082 [label="Evaluate expressions",color=orange];
		j477154082 -> j3556929584 [label="RoatheFail",color=purple];
		j477154082 -> j3556929584 [label="RoatheFailStall",color=purple];
		j477154082 -> j127024223 [label="RoatheFailUltimate",color=purple];
		j477154082 -> j2698450341 [label="RoatheFailNot21",color=purple];
		j477154082 -> j945846171 [label="RoatheFailUnloved",color=purple];
		j477154082 -> j3556929584 [label="RoatheRepair1",color=purple];
		j477154082 -> j3556929584 [label="false",color=purple];
	j3556929584 [label="Roathe, işin sonunda serumu almasının gerçeğiyle yüzleşiyor. Nasıl olduğunu bilmiyorum ama sanırım ona bu süreçte yardımcı olmakta pek başarılı olamadım.",shape=box,color=red];
		j3556929584 -> j2450441188;
	j127024223 [label="Emin değilim. Sanırım söylememem gereken bir şey söyledim.",shape=box,color=red];
		j127024223 -> j2765870000;
	j2698450341 [label="Bana anılarının derinliklerini daha fazla kurcalamamamı söyledi. Ben de kurcalamadım. Şimdi de sanki... ilerleme kaydedilmiyor gibi görünüyor.",shape=box,color=red];
		j2698450341 -> j1809482379;
	j945846171 [label="Ona 'sadece arada sırada birlikte takıldığım birisi' olduğunu söyledim ve o bunu sorun etmiyor gibi görünse de şimdi aramızda bir gerileme olduğunu hissediyorum.",shape=box,color=red];
		j945846171 -> j2765870000;
	j2450441188 [label="Anlıyorum. Geçmişteki eylemleriyle yeni bir bakış açısıyla yüzleşmek zor olabiliyor. Onu ve bizi bu iğrenç duruma zorladığı için Entrati'ye lanet ediyorum.",shape=box,color=blue];
		j2450441188 -> j3207678669;
	j2765870000 [label="Anlıyorum. Korkarım bu konuda yapabileceğim pek bir şey yok, çünkü bu konuda \"ektiğinizi biçmenin\" sonuçlarını yaşıyorsunuz.",shape=box,color=blue];
		j2765870000 -> j3774958556;
	j1809482379 [label="Anlıyorum. Bazen birinin iyiliğini isteyerek hareket etmek, isteklerini harfiyen yerine getirmekle aynı şey değildir.",shape=box,color=blue];
		j1809482379 -> j2847254568;
	j3207678669 [label="Sizi dinlemeye ikna etmek için elimden geleni yapacağım. Ama eylemlerini korkaklıktan ziyade başka bir şey olarak yorumlayabilmesi için daha iyi argümanlar hazırlamanızı tavsiye etmeliyim.",shape=box,color=blue];
		j3207678669 -> j806453865;
	j3774958556 [label="Bu şekilde duyarsız ve umursamaz davranmak, aynı şekilde karşılık bulan bir davranışla sonuçlanacaktır. Özellikle de Roathe gibi biriyle karşı karşıyaysanız.",shape=box,color=blue];
		j3774958556 -> j4223870659;
	j2847254568 [label="Birinin arzularına karşı gelmek, özellikle de özel anılarını ve düşüncelerini karıştırmak korkunç bir davranış.",shape=box,color=blue];
		j2847254568 -> j2924900106;
	j806453865 [label="Çünkü biliyorum ki onu içten içe kemiren şey tam olarak bu.",shape=box,color=blue];
		j806453865 -> j558081994;
	j4223870659 [label="Durumu düzeltmek için hangi yola başvuracağınızı bilmiyorum. Ama affınıza sığınarak söylüyorum ki; Marie ve benim aracılığımla bir yol bulabileceğinizi sanmıyorum.",shape=box,color=blue];
		j4223870659 -> j96809028;
	j2924900106 [label="Entrati'yi, onu ve bizi böylesine aşağılık bir duruma zorladığı için lanetliyorum.",shape=box,color=blue];
		j2924900106 -> j2273593256;
	j558081994 [label="Boolean LyonRoatheFailFix is now true.",color=orange];
		j558081994 -> j618688711;
	j96809028 [label="Belki de bu noktada başka seçenekleri değerlendirmek en iyisi olacaktır.",shape=box,color=blue];
		j96809028 -> "Chat ends.";
	j2273593256 [label="Ama bana öyle geliyor ki, ona yardım etmenin tek yolu maalesef tam da bunu yapmak. Ve Descendia'yı, keşfedilmemiş hiçbir anı kalmayana kadar keşfetmeye devam etmek.",shape=box,color=blue];
		j2273593256 -> j471309980;
	j618688711 [label="Check boolean MarieRoatheFailFix",color=orange];
		j618688711 -> j4240038799 [label=true,color=green];
		j618688711 -> j493852586 [label=false,color=brown];
	j471309980 [label="Şeytan ne kadar itiraz ederse etsin.",shape=box,color=blue];
		j471309980 -> "Chat ends.";
	j4240038799 [label="Onu ikna etmek için Marie'nin yardımını almışsınız gibi görünüyor. Etkilendim. Malumunuz, ikisi arasında pek sevgi bağı yok.",shape=box,color=blue];
		j4240038799 -> j3267604607;
	j493852586 [label="Bu konuda Marie'nin de yardımına ihtiyacımız olacağını biliyorum. Onu ikna etmek daha zor olabilir, çünkü biliyorsun ki ikisi arasında pek sevgi yok.",shape=box,color=blue];
		j493852586 -> j3118502722;
	j3267604607 [label="O halde, sanırım başlayabiliriz.",shape=box,color=blue];
		j3267604607 -> "Initiate conversation RoatheRepair in /Lotus/Types/Gameplay/1999Wf/Dialogue/RoatheDialogue_rom.dialogue";
	j3118502722 [label="Lua sana rehberlik etsin.",shape=box,color=blue];
		j3118502722 -> "Initiate conversation MarieRoatheFail in /Lotus/Types/Gameplay/1999Wf/Dialogue/MarieDialogue_rom.dialogue";
	"Initiate conversation RoatheRepair in /Lotus/Types/Gameplay/1999Wf/Dialogue/RoatheDialogue_rom.dialogue" [label="Initiate conversation RoatheRepair in /Lotus/Types/Gameplay/1999Wf/Dialogue/RoatheDialogue_rom.dialogue",color=orange];
		"Initiate conversation RoatheRepair in /Lotus/Types/Gameplay/1999Wf/Dialogue/RoatheDialogue_rom.dialogue" -> "Chat ends.";
	"Initiate conversation MarieRoatheFail in /Lotus/Types/Gameplay/1999Wf/Dialogue/MarieDialogue_rom.dialogue" [label="Initiate conversation MarieRoatheFail in /Lotus/Types/Gameplay/1999Wf/Dialogue/MarieDialogue_rom.dialogue",color=orange];
		"Initiate conversation MarieRoatheFail in /Lotus/Types/Gameplay/1999Wf/Dialogue/MarieDialogue_rom.dialogue" -> "Chat ends.";
