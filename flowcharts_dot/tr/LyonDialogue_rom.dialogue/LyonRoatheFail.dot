	2273 [label="Roathe, işin sonunda serumu almasının gerçeğiyle yüzleşiyor. Nasıl olduğunu bilmiyorum ama sanırım ona bu süreçte yardımcı olmakta pek başarılı olamadım.",shape=box,color=red];
		2273 -> 2277;
	2272 [label="Emin değilim. Sanırım söylememem gereken bir şey söyledim.",shape=box,color=red];
		2272 -> 2276;
	2271 [label="Bana anılarının derinliklerini daha fazla kurcalamamamı söyledi. Ben de kurcalamadım. Şimdi de sanki... ilerleme kaydedilmiyor gibi görünüyor.",shape=box,color=red];
		2271 -> 2275;
	2270 [label="Ona 'sadece arada sırada birlikte takıldığım birisi' olduğunu söyledim ve o bunu sorun etmiyor gibi görünse de şimdi aramızda bir gerileme olduğunu hissediyorum.",shape=box,color=red];
		2270 -> 2274;
	2277 [label="Anlıyorum. Geçmişteki eylemleriyle yeni bir bakış açısıyla yüzleşmek zor olabiliyor. Onu ve bizi bu iğrenç duruma zorladığı için Entrati'ye lanet ediyorum.",shape=box,color=blue];
		2277 -> 2280;
	2276 [label="Anlıyorum. Korkarım bu konuda yapabileceğim pek bir şey yok, çünkü bu konuda \"ektiğinizi biçmenin\" sonuçlarını yaşıyorsunuz.",shape=box,color=blue];
		2276 -> 2278;
	2275 [label="Anlıyorum. Bazen birinin iyiliğini isteyerek hareket etmek, isteklerini harfiyen yerine getirmekle aynı şey değildir.",shape=box,color=blue];
		2275 -> 2279;
	2274 [label="Anlıyorum. Korkarım bu konuda yapabileceğim pek bir şey yok, çünkü bu konuda \"ektiğini biçmenin\" sonuçlarını yaşıyorsunuz.",shape=box,color=blue];
		2274 -> 2278;
	2280 [label="Sizi dinlemeye ikna etmek için elimden geleni yapacağım. Ama eylemlerini korkaklıktan ziyade başka bir şey olarak yorumlayabilmesi için daha iyi argümanlar hazırlamanızı tavsiye etmeliyim.",shape=box,color=blue];
		2280 -> 2282;
	2278 [label="Bu şekilde duyarsız ve umursamaz davranmak, aynı şekilde karşılık bulan bir davranışla sonuçlanacaktır. Özellikle de Roathe gibi biriyle karşı karşıyaysanız.",shape=box,color=blue];
		2278 -> 2281;
	2279 [label="Birinin arzularına karşı gelmek, özellikle de özel anılarını ve düşüncelerini karıştırmak korkunç bir davranış.",shape=box,color=blue];
		2279 -> 2341;
	2282 [label="Çünkü biliyorum ki onu içten içe kemiren şey tam olarak bu.",shape=box,color=blue];
		2282 -> 2284;
	2281 [label="Durumu düzeltmek için hangi yola başvuracağınızı bilmiyorum. Ama affınıza sığınarak söylüyorum ki; Marie ve benim aracılığımla bir yol bulabileceğinizi sanmıyorum.",shape=box,color=blue];
		2281 -> 2283;
