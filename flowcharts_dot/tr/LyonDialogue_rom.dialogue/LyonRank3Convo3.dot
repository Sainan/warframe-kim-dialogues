		135 -> 140;
	132 [label="Update boolean LyonFaith1",color=orange];
		132 -> 136;
	133 [label="Ve merakım doğal olarak beni buraya sürüklüyor. Bu soruyu \"yüksek sesle\" soruyorum, belki siz bana bir cevap verebilirsiniz. Void şekil aldığında, ortaya ne çıkar - bu ''gerçek'' midir?",shape=box,color=blue];
		133 -> 137;
		133 -> 138;
		133 -> 139;
	140 [label="+5 Chemistry",color=orange];
		140 -> 146;
	136 [label="Başkalarının kafalarını neden bu kadar işe yaramaz yalanlarla doldurduklarını sık sık kendime sorarım. Güç mü arıyorlar? Etki mi? Yoksa kendi sözlerine gerçekten inanıp kendi yalanlarından habersiz olduklarını mı düşünüyorsunuz?",shape=box,color=blue];
		136 -> 142;
		136 -> 141;
	137 [label="Hayır, bence Void'in yarattığı her şey... geçici. Onu yaratan her kimse veya her neyse onun bir parçası. Bir hatıranın hayaleti.",shape=box,color=red];
		137 -> 143;
	138 [label="Evet, öyle olduğuna inanıyorum. Bir sanatçının yaptığı bir resim gibi, birinin hayal gücünden doğmuş olabilir, ama yaratıldığında gerçek hale gelir.",shape=box,color=red];
		138 -> 144;
	139 [label="Bu tamamen sizin \"gerçek\" tanımınıza bağlı.",shape=box,color=red];
		139 -> 145;
	146 [label="Evet, özür dilerim. Doğrudan konuşmak konusunda pek rahat değilim, özellikle de bu kadar özel bir konuda. Ama çaba göstereceğim.",shape=box,color=blue];
		146 -> 122;
	142 [label="Bu durumda, Euleria Entrati'nin yazdıklarının yararlı olmasını amaçladığını düşünüyorum. Ancak ihtiyacım olduğunda bana hiçbir faydası olmadı.",shape=box,color=red];
		142 -> 148;
	141 [label="Bilmiyorum. Kafan hangi yalanlarla doluydu, Lyon?",shape=box,color=red];
		141 -> 147;
	143 [label="Peki, Void'in bu unsurlarının neden olduğu etkiler \"gerçek\" değil mi?",shape=box,color=blue];
		143 -> 149;
	144 [label="Ama kullandığınız benzetme tam olarak doğru değil, değil mi? Void'den geri kazanılan madde yine Void'e geri dönüyor, değil mi?",shape=box,color=blue];
		144 -> 150;
	145 [label="+5 Chemistry",color=orange];
