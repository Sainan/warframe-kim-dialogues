		j2940201053 -> j4138471410;
	j271418774 [label="Size anlatacağım bir konuda değil.",shape=box,color=blue];
		j271418774 -> "Chat ends.";
	j4232264123 [label="Birçok anı, bir adamı alkole ya da intihara sürüklemiştir. Bu anılar ''gerçek'' değil mi?",shape=box,color=blue];
		j4232264123 -> j3795084761;
