	174 [label="Sanırım? Etkileşimde bulunduğum Void parçaları zaten üzerlerine kazınmış durumda. Ona zaten bir şekil veya form verdik. Ya da gerçeklikler arasındaki çizgiyi fazla bulanıklaştırdık.",shape=box,color=red];
