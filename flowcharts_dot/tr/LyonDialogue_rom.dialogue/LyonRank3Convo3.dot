	182 [label="Bütün yapılar, hatta Lua'nın kendisi bile Void'e yerleştirilmiş ve geri alınmıştır. Dolayısıyla, içinde var olmak maddeyi tüketmez.",shape=box,color=red];
		182 -> 189;
	183 [label="Kastettiğin şey, hiçbir şeyin var olamayacağı \"daha derin\" bir Void'in varlığıdır ve dürüst olmak gerekirse bu konuda bir şey söyleyemem.",shape=box,color=red];
