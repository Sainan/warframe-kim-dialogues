	j265913985 [label="Bay Loid'un bana attığı dehşet dolu bakıştan ve ''sizi üzmek istemediğini'' söyleyerek kitabı hemen yerine koymam konusunda ısrar etmesine bakılırsa, evet, bu konuda bir şeyler bildiğinizi tahmin ediyorum.",shape=box,color=blue];
		j265913985 -> j2483064420;
	j2366712845 [label="Sorum, ''Kavramsal Somutlaşma''nın doğasıyla ilgili. Kitabı okuduktan sonra, kitabın çocuklara duygularının Void ile etkileşime girmesini önlemeyi öğretmek olduğunu fark ettim.",shape=box,color=blue];
		j2366712845 -> j2036520352;
		j2366712845 -> j2655852111;
	j2483064420 [label="\"Duviri Masalları.\" Bay Loid'den, sizin yaşadıklarınıza ilişkin oldukça yorucu ve uzun bir açıklama aldım, ancak sormak istediğim özel bir konu var.",shape=box,color=blue];
		j2483064420 -> j2039942287;
	j2036520352 [label="Çok da faydası olmadı. Özellikle benim durumumda.",shape=box,color=red];
		j2036520352 -> j2162289451;
	j2655852111 [label="Void ile güçlü duyguların etkileşime girmesi... ciddi sorunlara yol açabilir.",shape=box,color=red];
		j2655852111 -> j2725437896;
	j2039942287 [label="Tabii, bu sizin için bir sorun olmayacaksa?",shape=box,color=blue];
		j2039942287 -> j339711060;
		j2039942287 -> j3732569953;
	j2162289451 [label="Hayatımızın ne kadarı başkaları tarafından bize bir gerçekmiş gibi sunuldu, ancak test edildiğinde işe yaramaz olduğu kanıtlandı?",shape=box,color=blue];
		j2162289451 -> j1175009516;
	j2725437896 [label="Öyle görünüyor. Cavia ile tanıştım. Void Melekleri'nden bahsedildi. Murmur'u bizzat gördüm. ",shape=box,color=blue];
		j2725437896 -> j1901765862;
	j339711060 [label="Hayır. Devam et.",shape=box,color=red];
		j339711060 -> j461153125;
	j3732569953 [label="Sanırım bu tamamen ayrıntılara bağlı. Bana ne soracağınızı hakkında hiçbir fikrim yok.",shape=box,color=red];
		j3732569953 -> j3907630897;
	j1175009516 [label="Boolean LyonFaith1 is now true.",color=orange];
		j1175009516 -> j3041727606;
	j1901765862 [label="Ve merakım doğal olarak beni buraya sürüklüyor. Bu soruyu \"yüksek sesle\" soruyorum, belki siz bana bir cevap verebilirsiniz. Void şekil aldığında, ortaya ne çıkar - bu ''gerçek'' midir?",shape=box,color=blue];
		j1901765862 -> j3798387880;
		j1901765862 -> j2445785377;
		j1901765862 -> j3912610233;
	j3907630897 [label="+5 Chemistry",color=orange];
		j3907630897 -> j2235041038;
	j3041727606 [label="Başkalarının kafalarını neden bu kadar işe yaramaz yalanlarla doldurduklarını sık sık kendime sorarım. Güç mü arıyorlar? Etki mi? Yoksa kendi sözlerine gerçekten inanıp kendi yalanlarından habersiz olduklarını mı düşünüyorsunuz?",shape=box,color=blue];
		j3041727606 -> j2034047314;
		j3041727606 -> j1108626823;
	j3798387880 [label="Hayır, bence Void'in yarattığı her şey... geçici. Onu yaratan her kimse veya her neyse onun bir parçası. Bir hatıranın hayaleti.",shape=box,color=red];
		j3798387880 -> j3300852715;
	j2445785377 [label="Evet, öyle olduğuna inanıyorum. Bir sanatçının yaptığı bir resim gibi, birinin hayal gücünden doğmuş olabilir, ama yaratıldığında gerçek hale gelir.",shape=box,color=red];
		j2445785377 -> j2661648430;
	j3912610233 [label="Bu tamamen sizin \"gerçek\" tanımınıza bağlı.",shape=box,color=red];
		j3912610233 -> j1547782763;
	j2235041038 [label="Evet, özür dilerim. Doğrudan konuşmak konusunda pek rahat değilim, özellikle de bu kadar özel bir konuda. Ama çaba göstereceğim.",shape=box,color=blue];
		j2235041038 -> j461153125;
	j2034047314 [label="Bu durumda, Euleria Entrati'nin yazdıklarının yararlı olmasını amaçladığını düşünüyorum. Ancak ihtiyacım olduğunda bana hiçbir faydası olmadı.",shape=box,color=red];
		j2034047314 -> j2940201053;
	j1108626823 [label="Bilmiyorum. Kafan hangi yalanlarla doluydu, Lyon?",shape=box,color=red];
		j1108626823 -> j271418774;
	j3300852715 [label="Peki, Void'in bu unsurlarının neden olduğu etkiler \"gerçek\" değil mi?",shape=box,color=blue];
		j3300852715 -> j4232264123;
	j2661648430 [label="Ama kullandığınız benzetme tam olarak doğru değil, değil mi? Void'den geri kazanılan madde yine Void'e geri dönüyor, değil mi?",shape=box,color=blue];
		j2661648430 -> j972495004;
	j1547782763 [label="+5 Chemistry",color=orange];
		j1547782763 -> j2685220579;
