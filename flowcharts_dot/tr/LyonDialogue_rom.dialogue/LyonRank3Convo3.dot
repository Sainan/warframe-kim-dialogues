		175 -> 184;
	176 [label="Evet, sanırım bu şekilde ifade edilebilir. Salonlarımızı rahatsız eden hayaletleri görmezden mi gelmeliyiz, yoksa onlara biraz olsun kulak vererek onları güçlendirmeli miyiz?",shape=box,color=blue];
		176 -> 177;
		176 -> 178;
