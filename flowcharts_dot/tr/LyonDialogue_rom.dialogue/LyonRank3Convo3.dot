	177 [label="Şu anda karşı karşıya olduğumuz zorlukların tehlikeli olduğuna inanıyorum. Hem de son derece tehlikeli. Ve onları bu şekilde ele almalıyız.",shape=box,color=red];
		177 -> 185;
	178 [label="Hayaletler bize acı verecek kadar gerçektir. Ama kurşunla bu sorun çözülemez. En azından bana denk gelen bir tane olmadı.",shape=box,color=red];
		178 -> 186;
	179 [label="Lyon, bütün bunlar ne anlama geliyor? Gerçekten?",shape=box,color=red];
		179 -> 187;
	180 [label="Ben... doğrusunu söylemek gerekirse bilmiyorum Lyon. Keşke bilseydim.",shape=box,color=red];
		180 -> 188;
	181 [label="Evet, sanırım bu şekilde ifade edilebilir. Kendi şeytanlarımızı açığa çıkarmadığımızdan nasıl emin olabiliriz?",shape=box,color=blue];
		181 -> 177;
		181 -> 178;
