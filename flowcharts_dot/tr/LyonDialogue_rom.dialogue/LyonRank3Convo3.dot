		j4120289088 -> j1759345489;
	j1570205456 [label="Bunların \"gerçek\" olup olmadığını sormuyorsun, \"geçerli\" olup olmadığını soruyorsun. Bunların reddedilmesi gerekip gerekmediğini soruyorsun.",shape=box,color=red];
		j1570205456 -> j2412427347;
