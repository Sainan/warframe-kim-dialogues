	j3307237889 [label="Bay Loid'e kütüphanesinde yardım ediyordum, kitapları raflara geri diziyordum, ama o, o tuhaf uçan... aletlerin bu işi yapabileceğini ısrarla söylüyordu -",shape=box,color=blue];
