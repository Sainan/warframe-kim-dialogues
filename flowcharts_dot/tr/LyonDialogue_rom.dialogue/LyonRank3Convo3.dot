	115 [label="Bay Loid'e kütüphanesinde yardım ediyordum, kitapları raflara geri diziyordum, ama o, o tuhaf uçan... aletlerin bu işi yapabileceğini ısrarla söylüyordu -",shape=box,color=blue];
		115 -> 116;
	116 [label="Sonra Euleria Entrati tarafından yazılmış, kurgusal bir dünyada geçen çocuk masallarını anlatan ilginç bir kitapla karşılaştım.",shape=box,color=blue];
		116 -> 117;
	117 [label="Yazarın soyadının bizim \"Kardinal Dimanche\"ın gerçek adıyla aynı olduğunu fark edince, kopyayı hemen kendime ayırdım.",shape=box,color=blue];
		117 -> 120;
