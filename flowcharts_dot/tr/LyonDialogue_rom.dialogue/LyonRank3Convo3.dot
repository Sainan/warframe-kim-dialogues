		191 -> 195;
	192 [label="Belki de bu yüzden pek çok insan aşırılığa yöneliyor... görünmez ama acı veren, açık bir yarayı sarmak için. İyileştirilebilir bir yara. Ama silahlarla değil, ruhun gücüyle.",shape=box,color=blue];
		192 -> 195;
	193 [label="Bu konuda açıkça yanlış yaptım. Bunu başka bir zaman konuşuruz. Rahatsız ettiğim için kusura bakmayın.",shape=box,color=blue];
