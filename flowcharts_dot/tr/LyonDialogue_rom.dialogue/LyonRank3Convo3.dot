		162 -> 169;
	163 [label="Ancak benim merakım ne kitapla ne de onun yararlılığıyla ilgili. Bir an için şiirsel bir dil kullandığım için beni bağışlayın.",shape=box,color=blue];
		163 -> 170;
	164 [label="Bunların \"gerçek\" olup olmadığını sormuyorsun, \"geçerli\" olup olmadığını soruyorsun. Bunların reddedilmesi gerekip gerekmediğini soruyorsun.",shape=box,color=red];
		164 -> 171;
