	j1736740999 [label="\"Kardinal Dimanche\" bize geldiğinde gece gök gürültülü bir fırtına vardı. Kilisenin sunağında, dışarıdaki şiddetli fırtınadan etkilenmeden öylece duruyordu.",shape=box,color=blue];
