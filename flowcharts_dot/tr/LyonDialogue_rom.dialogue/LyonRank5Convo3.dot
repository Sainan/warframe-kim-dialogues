		1557 -> 1558 [label="false",color=purple];
	1559 [label="Bununla gurur duymuyorum ama bir şişe şarabı tek başına içtim ve şimdi sana anlatmaya çalıştığım diğer şeyleri anlatmaya hazırım, mon miracle...",shape=box,color=blue];
		1559 -> 1561;
	1560 [label="Bununla gurur duymuyorum ama bir şişe şarabı tek başına içtim ve şimdi sana anlatmaya çalıştığım diğer şeyleri anlatmaya hazırım...",shape=box,color=blue];
		1560 -> 1561;
	1558 [label="Chat ends.",color=orange];
	1561 [label="Bu şişe de gerçekten şarapsa, üstünde doğru etiket yoktu - ve Bay. Loid, benim zamanımda içtiğimiz şeyle onun şarap olarak bildiği şeyin aynı şey olduğundan tam olarak emin değildi.",shape=box,color=blue];
		1561 -> 1562;
	1562 [label="Kendimi savunmak gerekirse, şişenin tamamını içmeyi planlamamıştım... ama bu aynı içki mi diye anlamaya çalışırken bitivermiş...",shape=box,color=blue];
		1562 -> 1563;
		1562 -> 1564;
		1562 -> 1565;
	1563 [label="Hayır, bunu yapmayacağım.",shape=box,color=red];
		1563 -> 1566;
	1564 [label="Tadı aynı mı?",shape=box,color=red];
		1564 -> 1567;
	1565 [label="Sarhoş musun?",shape=box,color=red];
		1565 -> 1568;
	1566 [label="Keşke ben de bu kadar kolay kaçabilseydim. Seni suçlamıyorum.",shape=box,color=blue];
		1566 -> 1569;
	1567 [label="Bilmem! Tüm meselenin en sinir bozucu kısmı da buydu! Ama mesele bu değil. Mesele sarhoş olmak. Hatta öyle olup olmadığımı bile bilmiyorum. Kesinlikle ayık değilim, fakat -",shape=box,color=blue];
		1567 -> 1570;
	1568 [label="Büyük ihtimalle. Kesinlikle ayık sayılabilecek seviyede değilim.",shape=box,color=blue];
		1568 -> 1571;
	1569 [label="Update boolean LyonConfessionFail",color=orange];
		1569 -> 1572;
	1570 [label="Sanırım tam kıvama geldim.",shape=box,color=blue];
		1570 -> 1573;
		1570 -> 1574;
	1571 [label="Asıl amacım da buydu zaten. Tam kıvamındayım.",shape=box,color=blue];
		1571 -> 1573;
		1571 -> 1574;
	1572 [label="Chat ends.",color=orange];
	1573 [label="Bana anlatabilmek için sarhoş olmanı gerektirecek kadar korkunç olan ne?",shape=box,color=red];
		1573 -> 1575;
	1574 [label="Ne zaman başlamak istersen...",shape=box,color=red];
		1574 -> 1575;
	1575 [label="Rap... tap... tap...",shape=box,color=blue];
		1575 -> 1576;
		1575 -> 1577;
	1576 [label="... Off.",shape=box,color=red];
		1576 -> 1578;
	1577 [label="Bu yeterli olur.",shape=box,color=red];
		1577 -> 1578;
	1578 [label="Onların benim zihnimde hiç yer almadıklarından eminim. Rell diye bilinen Tenno ve onun koruyucusu Harrow. Onların çocukluğumun geçtiği evde olmaları imkansız.",shape=box,color=blue];
		1578 -> 1579;
	1579 [label="Yıllar boyunca zihnimde fısıldanıp, anlaşılmaz seslerle yankılanmaları mümkün değil. Yine de, onları burada, anılarımdaki gibi görüyor ve duyuyorum.",shape=box,color=blue];
		1579 -> 1580;
	1580 [label="Check boolean LyonTime1",color=orange];
		1580 -> 1581 [label=true,color=green];
		1580 -> 1582 [label=false,color=brown];
	1581 [label="Entrati'nin enerjinin zaman içinde aynı anda birden fazla yerde var olma olasılığı hakkında söylediklerini felsefi açıdan anladım. Ancak bunu duygusal olarak ancak... serum enjeksiyonunu aldıktan sonra anlayabildim.",shape=box,color=blue];
		1581 -> 1583;
	1582 [label="Sanki serumu enjekte ettiğim anda her şey bütünleşti. Entrati kendini ve varoluşunun tüm gerçeğini ortaya koyduğunda - ",shape=box,color=blue];
		1582 -> 1584;
	1583 [label="Bazen hayalimdeki imgelerde her yöne doğru uzanan büyük ve sığ, durgun bir göl görüyorum. Siyah ve pürüzsüz, oniks bir ayna gibi.",shape=box,color=blue];
		1583 -> 1585;
	1584 [label="Bana \"kuantum dolanıklığı\", \"süperpozisyon\", \"ebediyetçilik\" ve benzeri konularda bildiği her şeyi anlattı.",shape=box,color=blue];
		1584 -> 1586;
	1585 [label="Sonsuzluğa doğru akan büyük, kara bir gölet. Anlamak imkânsız.",shape=box,color=blue];
		1585 -> 1587;
	1586 [label="Her şeyi bilimsel, hatta felsefi anlamda anladım. Ama duygusal olarak anlamam ancak... serumu enjekte edene kadar mümkün oldu.",shape=box,color=blue];
		1586 -> 1583;
	1587 [label="Ve onları orada bulurdum. Orada buluşurduk. Ve onları orada hissederdim...",shape=box,color=blue];
		1587 -> 1588;
	1588 [label="Onlar mı?",shape=box,color=red];
		1588 -> 1589;
	1589 [label="Diğer Harrow'lar... Boş heykeller, yankıların yankılarının yankıları... Sonsuza dek her yöne doğru uzanıp devam ediyorlar...",shape=box,color=blue];
		1589 -> 1590;
	1590 [label="Rell kendini birinin içine yerleştirdi. Kendini onun içinde kaybetti. Ve bunu yaparak, hepsinin içinde kayboldu...",shape=box,color=blue];
		1590 -> 1591;
	1591 [label="Ben de dahil. Beni yaratan serumun içindeki Harrow da dahil.",shape=box,color=blue];
		1591 -> 1592;
		1591 -> 1593;
	1592 [label="Void, farkına bile varmadım...",shape=box,color=red];
		1592 -> 1594;
	1593 [label="Ah olamaz -",shape=box,color=red];
		1593 -> 1594;
	1594 [label="Onlar benimleydi, zihnimdeydi - Rell ve onun Harrow'u, bana çok benziyorlardı ama yine de çok farklılardı.",shape=box,color=blue];
		1594 -> 1595;
	1595 [label="Hiç korkmuyordu. Çok emindi. Benim sahip olmadığım iki şey.",shape=box,color=blue];
		1595 -> 1596;
	1596 [label="O, Kayıtsızlığa karşı kararlı bir şekilde direndi, bunun ne olduğu ya da ne olmadığıyla ilgilenmedi. Sadece ne yapılması gerektiğini biliyordu.",shape=box,color=blue];
		1596 -> 1597;
	1597 [label="Çektiği onca zulme rağmen. Tüm o yıllar boyunca, bu sonsuzluğun ''şimdi''si ve ''o zaman''ında, serumu enjekte ettiğim anda... ''öncesi'' ve ''sonrası''nda, o oradaydı.",shape=box,color=blue];
		1597 -> 1598;
	1598 [label="O benim arkadaşımdı. O benim kardeşimdi.",shape=box,color=blue];
		1598 -> 1599;
	1599 [label="Artık o zaman mı? Şimdi mi?",shape=box,color=blue];
		1599 -> 1600;
	1600 [label="Artık onu hissedemiyorum.",shape=box,color=blue];
		1600 -> 1601;
		1600 -> 1602;
	1601 [label="O... o artık huzur içinde, Lyon... huzura kavuştu.",shape=box,color=red];
		1601 -> 1603;
	1602 [label="Ah, Lyon...",shape=box,color=red];
		1602 -> 1604;
	1603 [label="Biliyorum. Gittiğinde hissettim. Ve ağladım. Onu çok özlüyorum. Sesinin bir şekilde hala içimde yankılandığını biliyorum, ama bunun nasıl olduğunu tam olarak anlayamıyorum.",shape=box,color=blue];
		1603 -> 1605;
		1603 -> 1606;
	1604 [label="Onu çok özlüyorum. Sesinin bir şekilde hala içimde yankılandığını biliyorum, ama bunun nasıl olduğunu tam olarak anlayamıyorum.",shape=box,color=blue];
		1604 -> 1605;
		1604 -> 1606;
	1605 [label="Rell hepimizin en güçlüsüydü. Onu tanıma fırsatı bulduğuna sevindim.",shape=box,color=red];
		1605 -> 1607;
	1606 [label="Rell, çocukların cehaleti ve acımasızlığı yüzünden dışlandı... başına gelenleri hak etmemişti.",shape=box,color=red];
		1606 -> 1608;
	1607 [label="Onu tanıdığım için de mutluyum. Gücüne gelince? Belki, belki de değil. Sonuçta, neyin gerekli olduğunu biliyordu ve bunu gerçekleştirecek kadar güçlüydü.",shape=box,color=blue];
		1607 -> 1609;
	1608 [label="Belki de. Ama sonunda, yapılması gerekeni yaptı. Ve bunu başaracak kadar güçlüydü.",shape=box,color=blue];
		1608 -> 1609;
	1609 [label="Böyle zamanlarda, ''yeterince güçlü'' olmak, dua edebileceğimiz tek şey olduğunu düşünüyorum.",shape=box,color=blue];
		1609 -> 1610;
	1610 [label="Ancak ne yazık ki bu şarap için aynı şey söylenemez... çünkü çok sertti, sadece etkisi yavaştı.",shape=box,color=blue];
		1610 -> 1611;
	1611 [label="Gitmem gerek... ",shape=box,color=blue];
		1611 -> 1612;
	1612 [label="Gitmeliyim.",shape=box,color=blue];
		1612 -> 1613;
