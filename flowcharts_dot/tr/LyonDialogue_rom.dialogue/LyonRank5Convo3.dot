	j2699661253 [label="Bununla gurur duymuyorum ama bir şişe şarabı tek başına içtim ve şimdi sana anlatmaya çalıştığım diğer şeyleri anlatmaya hazırım, mon miracle...",shape=box,color=blue];
		j2699661253 -> j3278124584;
	j947913803 [label="Bununla gurur duymuyorum ama bir şişe şarabı tek başına içtim ve şimdi sana anlatmaya çalıştığım diğer şeyleri anlatmaya hazırım...",shape=box,color=blue];
		j947913803 -> j3278124584;
	"Chat ends." [color=orange];
	j3278124584 [label="Bu şişe de gerçekten şarapsa, üstünde doğru etiket yoktu - ve Bay. Loid, benim zamanımda içtiğimiz şeyle onun şarap olarak bildiği şeyin aynı şey olduğundan tam olarak emin değildi.",shape=box,color=blue];
		j3278124584 -> j1222251904;
	j1222251904 [label="Kendimi savunmak gerekirse, şişenin tamamını içmeyi planlamamıştım... ama bu aynı içki mi diye anlamaya çalışırken bitivermiş...",shape=box,color=blue];
		j1222251904 -> j1326238077;
		j1222251904 -> j3059813548;
		j1222251904 -> j1467302647;
	j1326238077 [label="Hayır, bunu yapmayacağım.",shape=box,color=red];
		j1326238077 -> j1793125434;
	j3059813548 [label="Tadı aynı mı?",shape=box,color=red];
		j3059813548 -> j2742178469;
	j1467302647 [label="Sarhoş musun?",shape=box,color=red];
		j1467302647 -> j1698782851;
	j1793125434 [label="Keşke ben de bu kadar kolay kaçabilseydim. Seni suçlamıyorum.",shape=box,color=blue];
		j1793125434 -> j3856020424;
	j2742178469 [label="Bilmem! Tüm meselenin en sinir bozucu kısmı da buydu! Ama mesele bu değil. Mesele sarhoş olmak. Hatta öyle olup olmadığımı bile bilmiyorum. Kesinlikle ayık değilim, fakat -",shape=box,color=blue];
		j2742178469 -> j3047327249;
	j1698782851 [label="Büyük ihtimalle. Kesinlikle ayık sayılabilecek seviyede değilim.",shape=box,color=blue];
		j1698782851 -> j1387916704;
	j3856020424 [label="Boolean LyonConfessionFail is now true.",color=orange];
		j3856020424 -> "Chat ends.";
	j3047327249 [label="Sanırım tam kıvama geldim.",shape=box,color=blue];
		j3047327249 -> j70364208;
		j3047327249 -> j1524272487;
	j1387916704 [label="Asıl amacım da buydu zaten. Tam kıvamındayım.",shape=box,color=blue];
		j1387916704 -> j70364208;
		j1387916704 -> j1524272487;
	j70364208 [label="Bana anlatabilmek için sarhoş olmanı gerektirecek kadar korkunç olan ne?",shape=box,color=red];
		j70364208 -> j3375269506;
	j1524272487 [label="Ne zaman başlamak istersen...",shape=box,color=red];
		j1524272487 -> j3375269506;
	j3375269506 [label="Rap... tap... tap...",shape=box,color=blue];
		j3375269506 -> j1474585205;
		j3375269506 -> j3948458003;
	j1474585205 [label="... Off.",shape=box,color=red];
		j1474585205 -> j887613076;
	j3948458003 [label="Bu yeterli olur.",shape=box,color=red];
		j3948458003 -> j887613076;
	j887613076 [label="Onların benim zihnimde hiç yer almadıklarından eminim. Rell diye bilinen Tenno ve onun koruyucusu Harrow. Onların çocukluğumun geçtiği evde olmaları imkansız.",shape=box,color=blue];
		j887613076 -> j1711356831;
	j1711356831 [label="Yıllar boyunca zihnimde fısıldanıp, anlaşılmaz seslerle yankılanmaları mümkün değil. Yine de, onları burada, anılarımdaki gibi görüyor ve duyuyorum.",shape=box,color=blue];
		j1711356831 -> j252073137;
	j252073137 [label="Check boolean LyonTime1",color=orange];
		j252073137 -> j3070242054 [label=true,color=green];
		j252073137 -> j1302194799 [label=false,color=brown];
	j3070242054 [label="Entrati'nin enerjinin zaman içinde aynı anda birden fazla yerde var olma olasılığı hakkında söylediklerini felsefi açıdan anladım. Ancak bunu duygusal olarak ancak... serum enjeksiyonunu aldıktan sonra anlayabildim.",shape=box,color=blue];
		j3070242054 -> j604343676;
	j1302194799 [label="Sanki serumu enjekte ettiğim anda her şey bütünleşti. Entrati kendini ve varoluşunun tüm gerçeğini ortaya koyduğunda - ",shape=box,color=blue];
		j1302194799 -> j1935318424;
	j604343676 [label="Bazen hayalimdeki imgelerde her yöne doğru uzanan büyük ve sığ, durgun bir göl görüyorum. Siyah ve pürüzsüz, oniks bir ayna gibi.",shape=box,color=blue];
		j604343676 -> j1311519062;
	j1935318424 [label="Bana \"kuantum dolanıklığı\", \"süperpozisyon\", \"ebediyetçilik\" ve benzeri konularda bildiği her şeyi anlattı.",shape=box,color=blue];
		j1935318424 -> j877600993;
	j1311519062 [label="Sonsuzluğa doğru akan büyük, kara bir gölet. Anlamak imkânsız.",shape=box,color=blue];
		j1311519062 -> j2534075977;
	j877600993 [label="Her şeyi bilimsel, hatta felsefi anlamda anladım. Ama duygusal olarak anlamam ancak... serumu enjekte edene kadar mümkün oldu.",shape=box,color=blue];
		j877600993 -> j604343676;
	j2534075977 [label="Ve onları orada bulurdum. Orada buluşurduk. Ve onları orada hissederdim...",shape=box,color=blue];
		j2534075977 -> j4058434999;
	j4058434999 [label="Onlar mı?",shape=box,color=red];
		j4058434999 -> j4224803985;
	j4224803985 [label="Diğer Harrow'lar... Boş heykeller, yankıların yankılarının yankıları... Sonsuza dek her yöne doğru uzanıp devam ediyorlar...",shape=box,color=blue];
		j4224803985 -> j1785412767;
	j1785412767 [label="Rell kendini birinin içine yerleştirdi. Kendini onun içinde kaybetti. Ve bunu yaparak, hepsinin içinde kayboldu...",shape=box,color=blue];
		j1785412767 -> j3531171352;
	j3531171352 [label="Ben de dahil. Beni yaratan serumun içindeki Harrow da dahil.",shape=box,color=blue];
		j3531171352 -> j1085530237;
		j3531171352 -> j2269827829;
	j1085530237 [label="Void, farkına bile varmadım...",shape=box,color=red];
		j1085530237 -> j3361744401;
	j2269827829 [label="Ah olamaz -",shape=box,color=red];
		j2269827829 -> j3361744401;
	j3361744401 [label="Onlar benimleydi, zihnimdeydi - Rell ve onun Harrow'u, bana çok benziyorlardı ama yine de çok farklılardı.",shape=box,color=blue];
		j3361744401 -> j1983081387;
	j1983081387 [label="Hiç korkmuyordu. Çok emindi. Benim sahip olmadığım iki şey.",shape=box,color=blue];
		j1983081387 -> j4219431506;
	j4219431506 [label="O, Kayıtsızlığa karşı kararlı bir şekilde direndi, bunun ne olduğu ya da ne olmadığıyla ilgilenmedi. Sadece ne yapılması gerektiğini biliyordu.",shape=box,color=blue];
		j4219431506 -> j2694818769;
	j2694818769 [label="Çektiği onca zulme rağmen. Tüm o yıllar boyunca, bu sonsuzluğun ''şimdi''si ve ''o zaman''ında, serumu enjekte ettiğim anda... ''öncesi'' ve ''sonrası''nda, o oradaydı.",shape=box,color=blue];
		j2694818769 -> j295109160;
	j295109160 [label="O benim arkadaşımdı. O benim kardeşimdi.",shape=box,color=blue];
		j295109160 -> j1306779166;
	j1306779166 [label="Artık o zaman mı? Şimdi mi?",shape=box,color=blue];
		j1306779166 -> j3331969599;
	j3331969599 [label="Artık onu hissedemiyorum.",shape=box,color=blue];
		j3331969599 -> j19800938;
		j3331969599 -> j191291637;
	j19800938 [label="O... o artık huzur içinde, Lyon... huzura kavuştu.",shape=box,color=red];
		j19800938 -> j470077936;
	j191291637 [label="Ah, Lyon...",shape=box,color=red];
		j191291637 -> j1787563742;
	j470077936 [label="Biliyorum. Gittiğinde hissettim. Ve ağladım. Onu çok özlüyorum. Sesinin bir şekilde hala içimde yankılandığını biliyorum, ama bunun nasıl olduğunu tam olarak anlayamıyorum.",shape=box,color=blue];
		j470077936 -> j55846881;
		j470077936 -> j362132333;
	j1787563742 [label="Onu çok özlüyorum. Sesinin bir şekilde hala içimde yankılandığını biliyorum, ama bunun nasıl olduğunu tam olarak anlayamıyorum.",shape=box,color=blue];
		j1787563742 -> j55846881;
		j1787563742 -> j362132333;
	j55846881 [label="Rell hepimizin en güçlüsüydü. Onu tanıma fırsatı bulduğuna sevindim.",shape=box,color=red];
		j55846881 -> j799808498;
	j362132333 [label="Rell, çocukların cehaleti ve acımasızlığı yüzünden dışlandı... başına gelenleri hak etmemişti.",shape=box,color=red];
		j362132333 -> j1636198802;
	j799808498 [label="Onu tanıdığım için de mutluyum. Gücüne gelince? Belki, belki de değil. Sonuçta, neyin gerekli olduğunu biliyordu ve bunu gerçekleştirecek kadar güçlüydü.",shape=box,color=blue];
		j799808498 -> j2561477603;
	j1636198802 [label="Belki de. Ama sonunda, yapılması gerekeni yaptı. Ve bunu başaracak kadar güçlüydü.",shape=box,color=blue];
		j1636198802 -> j2561477603;
	j2561477603 [label="Böyle zamanlarda, ''yeterince güçlü'' olmak, dua edebileceğimiz tek şey olduğunu düşünüyorum.",shape=box,color=blue];
		j2561477603 -> j1175464701;
	j1175464701 [label="Ancak ne yazık ki bu şarap için aynı şey söylenemez... çünkü çok sertti, sadece etkisi yavaştı.",shape=box,color=blue];
