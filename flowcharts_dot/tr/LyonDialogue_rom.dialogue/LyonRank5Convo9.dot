		j2530876912 -> j2605876133;
	j1513414097 [label="Senin acın... benimkine benziyor. Sana yardım etmek benim için hiç zor olmaz.",shape=box,color=red];
		j1513414097 -> j3275964714;
	j206858908 [label="Sana olan ilgimi tarif edemem. Ama sen asla bir görev veya yük olmayacaksın.",shape=box,color=red];
		j206858908 -> j3899402156;
	j2605876133 [label="[Ayrıl.] Bütün bunlar benim için çok fazla olmaya başladı, üzgünüm. Her şeyi burada bitirmek en iyisi olabilir.",shape=box,color=red];
		j2605876133 -> j4066121670;
	j3275964714 [label="Sizin için ne kadar üzüldüğümü kelimelerle ifade edemem. Ama yalnız ruhlarımızın birbirini bulmuş olmasına sonsuz minnettarım.",shape=box,color=blue];
		j3275964714 -> j191167065;
