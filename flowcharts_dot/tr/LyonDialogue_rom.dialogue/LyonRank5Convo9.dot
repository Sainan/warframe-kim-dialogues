		j2851720794 -> j3788149535 [label=true,color=green];
		j2851720794 -> j458184518 [label=false,color=brown];
	j3788149535 [label="Sizin deyiminizle \"iyi\" olacağım. Bir kez daha gülümseyip kahkaha atacak bir sebep bulacağım.",shape=box,color=blue];
		j3788149535 -> j4202861724;
		j3788149535 -> j2291997400;
	j458184518 [label="Hayatta kalacağım. İyi olacağım. Gülümsemek ve tekrar kahkaha atmak için bir sebep bulacağım.",shape=box,color=blue];
		j458184518 -> j4202861724;
