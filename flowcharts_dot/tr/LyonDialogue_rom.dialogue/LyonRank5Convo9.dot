		j2195741817 -> j2000748220;
	j190338199 [label="Neyin... korkunç sonuçları?",shape=box,color=red];
		j190338199 -> j990625360;
	j1908573616 [label="Teşekkür ederim. Başlamadan önce, size hiçbir sorun olmadığını temin etmek isterim - ancak, burada belki de sizi kurtarmak istediğim korkunç sonuçlar yatmaktadır, eğer bunların ortaya çıkabileceğini düşünüyorsanız.",shape=box,color=blue];
