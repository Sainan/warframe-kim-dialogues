		j1481772862 -> j1471424578;
	j490064100 [label="Gezintilerimden keyif aldığınıza çok sevindim. İşte bu yüzden mümkün olduğunca az konuşmayı tercih ediyorum. Bunu yüz yüze katlanabileceğinizi hayal edebiliyor musunuz? Marie beni yıllar önce kuduz köpek gibi yere sererdi.",shape=box,color=blue];
		j490064100 -> j1471424578;
