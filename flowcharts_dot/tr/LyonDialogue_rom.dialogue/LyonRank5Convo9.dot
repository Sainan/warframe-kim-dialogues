		2154 -> 2155;
	2155 [label="Yataktan doğrulup elimden geldiğince giyindim, devam eden kabusun bulanık görüntüsünde sendeleye sendeleye ilerledim. Buhurdanlığımı kaptım ve odanın ortasına dizlerimin üzerine çöktüm ve... hazırlanmaya başladım. ",shape=box,color=blue];
