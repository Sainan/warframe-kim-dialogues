		j1471424578 -> j2038641275;
	j3311435967 [label="- Lyon",shape=box,color=blue];
		j3311435967 -> "Chat ends.";
	j2038641275 [label="Dün gece bir kâbustan uyandım. Uyandığımda etrafımı gölgeler sardı. Bu benim zihnimde yabancı ya da yeni bir şey değil. Yatağımın üzerinde beliriyorlardı ve kaybolmuyorlardı.",shape=box,color=blue];
		j2038641275 -> j124129808;
	j124129808 [label="Onlardan korkmuyordum, çünkü bana zarar veremeyeceklerini biliyordum. Ama aklımdan da çıkmıyorlardı. Onlardan kurtulabileceğimi bildiğim tek bir kişi vardı.",shape=box,color=blue];
		j124129808 -> j373641308;
	j373641308 [label="Yataktan doğrulup elimden geldiğince giyindim, devam eden kabusun bulanık görüntüsünde sendeleye sendeleye ilerledim. Buhurdanlığımı kaptım ve odanın ortasına dizlerimin üzerine çöktüm ve... hazırlanmaya başladım. ",shape=box,color=blue];
		j373641308 -> j196098855;
