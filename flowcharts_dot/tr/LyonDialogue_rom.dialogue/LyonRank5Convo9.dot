		j1390172892 -> j2605876133;
	j2530876912 [label="Hayır! Öyle bir şey yok! Ben sadece sizin benim yüzümden hissedebileceğiniz herhangi bir zorluktan sizi kurtarmaya çalışıyorum.",shape=box,color=blue];
