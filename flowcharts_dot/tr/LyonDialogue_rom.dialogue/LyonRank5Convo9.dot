	j1163382203 [label="Mon miracle, ben... size bir sonraki anekdotumu anlatmadan önce bir şeyi çok iyi anladığınızdan emin olmalıyım. ",shape=box,color=blue];
		j1163382203 -> j4000462246;
	j4000462246 [label="Size göndereceğim şu sözlere çok dikkat etmeniz benim için önemli. Anlıyor musunuz?",shape=box,color=blue];
		j4000462246 -> j3519413298;
		j4000462246 -> j1224310374;
	j3519413298 [label="Beni endişelendiriyorsun, Sorun ne?",shape=box,color=red];
		j3519413298 -> j1298047419;
	j1224310374 [label="Evet, buradayım. Devam et.",shape=box,color=red];
		j1224310374 -> j2237484114;
	j1298047419 [label="Hiçbir şey yanlış değil - tam tersi. Anlamanız gereken şey tam da bu - Sizi kurtarmak istediğim korkunç sonuçlar, eğer bunların gerçekleşebileceğini düşünüyorsanız.",shape=box,color=blue];
		j1298047419 -> j2669809851;
