	j2496974630 [label="+5 Chemistry",color=orange];
		j2496974630 -> j3380252482;
	j2000748220 [label="Evet. Bunun acı bir şekilde farkındayım.",shape=box,color=blue];
		j2000748220 -> j990625360;
	j990625360 [label="Tekrar başlamama izin verin.",shape=box,color=blue];
		j990625360 -> j3380252482;
	j3380252482 [label="Birçok kişi tarafından, ve aslında gerçekte de... sağlıksız olarak yorumlanabileceğimin farkındayım. En azından, tamamen aklı başında değilim.",shape=box,color=blue];
		j3380252482 -> j3609121003;
	j3609121003 [label="Uzun zaman önce bununla barıştım. Artık beni rahatsız etmiyor. Beni rahatsız eden görüntülerle - seslerle - korku veya nefret duymadan yaşamanın yollarını buldum.",shape=box,color=blue];
		j3609121003 -> j2152675526;
	j2152675526 [label="(Son zamanlarda, dürüst olmak gerekirse, biraz inat olsun diye böyle düşünüyorum, ama bu konuyla ilgisi yok.)",shape=box,color=blue];
		j2152675526 -> j1802826663;
	j1802826663 [label="Ama şunu anlamanızı isterim ki, eğer aramızdaki bu bağı bitirirseniz - daha önce kendimle bir başkası arasında imkansız olduğunu düşündüğüm bu bağı -",shape=box,color=blue];
		j1802826663 -> j1448169043;
	j1448169043 [label="Eğer bir gün kalbinizi benimkinden uzaklaştırırsanız? ",shape=box,color=blue];
		j1448169043 -> j309726665;
	j309726665 [label="Dayanacağım, mon miracle.",shape=box,color=blue];
		j309726665 -> j3473039905;
	j3473039905 [label="Beni rahatsız eden şeylerin beni tüketmesine izin vermeyeceğim. ",shape=box,color=blue];
