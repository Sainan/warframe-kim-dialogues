		2115 -> 2116;
	2116 [label="Birçok kişi tarafından, ve aslında gerçekte de... sağlıksız olarak yorumlanabileceğimin farkındayım. En azından, tamamen aklı başında değilim.",shape=box,color=blue];
		2116 -> 2117;
