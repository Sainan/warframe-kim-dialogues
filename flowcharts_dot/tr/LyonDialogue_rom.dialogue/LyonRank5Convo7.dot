	2071 [label="Ama gözlerimi kapattığımda aklım başka yerlere gitti. Düşüncelerim... sana, mon miracle'ıma kaydı...",shape=box,color=blue];
		2071 -> 2072;
	2072 [label="Sesinizin tınısı. Omzuma dokunan eli... ",shape=box,color=blue];
		2072 -> 2073;
	2073 [label="Ve vizyonlar... kaçtılar. Görev yerlerini terk ettiler, sizin daha güçlü hayaletiniz... tarafından kovalandılar.",shape=box,color=blue];
		2073 -> 2074;
	2074 [label="Ben... ayağa kalktım. Buhurdanımı komodinin üzerine koydum ve... bunun yerine Sanctum'un kumlarında yürümeyi tercih ettim...",shape=box,color=blue];
		2074 -> 2075;
		2074 -> 2076;
	2075 [label="Şimdi bir bahaneye ihtiyaç duyulduğunu anlayabiliyorum.",shape=box,color=red];
		2075 -> 2077;
	2076 [label="Ne diyeceğimi bilemiyorum...",shape=box,color=red];
		2076 -> 2078;
	2077 [label="Evet. Şey. Yürüyüşüm sırasında... o anın karanlık tehlikesini anında fark ettim. Sizin... bunu bir sorumluluk olarak görmeye başlayabileceğinizi, beni sizi aşağı çeken zincirler olarak görmeye başlayabileceğinizi.",shape=box,color=blue];
		2077 -> 2079;
	2078 [label="+5 Chemistry",color=orange];
		2078 -> 2080;
	2079 [label="Sizden, yüce veya aşağıdaki herhangi bir tanrıya ya da tanrılara yalvarıyorum ki, bunu asla yapmayın. Bu bana verdiğiniz bir hediye ve her seferinde onun yeniliğini takdir edeceğim.",shape=box,color=blue];
		2079 -> 2081;
	2080 [label="Söze gerek yok, mon miracle... ",shape=box,color=blue];
		2080 -> 2082;
	2081 [label="Bana yemin edin, mon miracle - eğer sizin için boş bir kafes olursam... benden kurtulacaksınız.",shape=box,color=blue];
		2081 -> 2083;
	2082 [label="Yürüyüşüm sırasında... o anın karanlık tehlikesini anında fark ettim. Sizin... bunu bir sorumluluk olarak görmeye başlayabileceğinizi, beni sizi aşağı çeken zincirler olarak görmeye başlayabileceğinizi.",shape=box,color=blue];
		2082 -> 2079;
	2083 [label="Sevdiklerim için boş bir hapishane olmayacağım. Sizin için değil. Marie için de değil.",shape=box,color=blue];
		2083 -> 2084;
		2083 -> 2085;
	2084 [label="[Ayrıl.] Ben - ben yapamayacağım. Bunu söz veremem, üzgünüm.",shape=box,color=red];
		2084 -> 2086;
	2085 [label="Yemin ederim. ",shape=box,color=red];
