	2090 [label="Birlikte geçirdiğimiz tüm anları özenle saklayacağım. Bunu, hayal edebileceğinizden çok daha fazla önemsiyorum.",shape=box,color=blue];
		2090 -> 2092;
	2091 [label="Birdenbire kendimi çok yorgun hissettim, sanki... omuzlarımdan büyük bir yük kalkmış gibi. Korkarım biraz uzanmam gerek.",shape=box,color=blue];
