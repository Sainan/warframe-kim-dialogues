	2087 [label="+10 Chemistry",color=orange];
		2087 -> 2089;
	2088 [label="Teşekkür ederim. Dürüstlüğünüz için teşekkür ederim, mon miracle. Bu, şu anda cesaret gerektiriyordu ve sizi bunun için takdir ediyorum.",shape=box,color=blue];
		2088 -> 2090;
	2089 [label="Teşekkür ederim. Teşekkür ederim, mon miracle...",shape=box,color=blue];
