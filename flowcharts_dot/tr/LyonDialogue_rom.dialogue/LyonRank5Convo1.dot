		j2507300598 -> j521164929;
	j521164929 [label="Ve bize kim olduğu gerçeğini, Void ile yaptığı kötülüklerin öyküsünü ve bunların sonucunda ortaya çıkan her şeyi anlattı. Daha doğrusu... bunların sonucunda ortaya çıkan her şeyi.",shape=box,color=blue];
