	1315 [label="Daha önce, Kayıtsızlık'ın \"gerçek bir tanrı\" olduğuna inanmadığım gerçeğinden bahsetmek istediğini söylemiştin. Şimdi bunun için uygun bir zaman mı?",shape=box,color=red];
		1315 -> 1320;
	1313 [label="[Son.]",shape=box,color=red];
		1313 -> 1318;
