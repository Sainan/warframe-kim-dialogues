	j3561099649 [label="Geçen gün bana kavramsal bütünlük ve Kayıtsızlık hakkında sorular soruyordun. Seni rahatsız eden bir şey mi var?",shape=box,color=red];
		j3561099649 -> j3023768697;
	j3600857236 [label="Roathe, Duvardaki Adam'ın gerçek bir tanrı olmadığına inanıyor. \"Kavramsal bütünlüğün\" bir ürünü olduğuna inanıyor. Sen ne düşünüyorsun?",shape=box,color=red];
