		1314 -> 1319;
	1317 [label="Roathe, Duvardaki Adam'ın gerçek bir tanrı olmadığına inanıyor. \"Kavramsal bütünlüğün\" bir ürünü olduğuna inanıyor. Sen ne düşünüyorsun?",shape=box,color=red];
		1317 -> 1322;
	1316 [label="Lyon, seninle Roathe arasında neler oluyor? Sadece ufak tefek şeyler öğrendim.",shape=box,color=red];
		1316 -> 1321;
	1320 [label="Bunun bana neden olduğu somut sorunu tartışmak için hangi zamanın ''uygun'' olup olmadığını bilemiyorum, Gezgin.",shape=box,color=blue];
		1320 -> 1324;
	1318 [label="Chat ends.",color=orange];
	1319 [label="Beni rahatsız eden pek çok şey var Gezgin. Kayıtsızlık ve kavramsal bütünlük konusu, korkarım ki, bunlardan sadece biri.",shape=box,color=blue];
		1319 -> 1323;
	1322 [label="Asıl mesele şu ki, Gezgin, bunu bilmiyorum. Cevabı bilseydim, böyle bir iç tartışmayla kendimi parçalamazdım.",shape=box,color=blue];
		1322 -> 1326;
	1321 [label="Özetleyeceğim, ancak bu konudaki nutuklarından kaçınmanıza şaşırdım. Bunları her fırsatta paylaşmak konusunda fazlasıyla istekli.",shape=box,color=blue];
		1321 -> 1325;
	1324 [label="Ama bu durumda, şu an, her zamankinden daha \"uygun\" bir zaman. Kayıtsızlık'ın gerçek bir tanrı olmadığına dair inancınızda Roathe ile aynı tarafta olmanız ilgimi çekti.",shape=box,color=blue];
		1324 -> 1326;
	1323 [label="Ya da durumu nasıl yorumlamak istediğinize bağlı olarak iki tane. Sanırım ikilemimin özü de bu.",shape=box,color=blue];
		1323 -> 1326;
	1326 [label="Ancak, en baştan başlamalıyım. Elinizde bir bağlam yoksa, bu konunun benim için neden bu kadar önemli olduğunu tam olarak anlayamazsınız...",shape=box,color=blue];
		1326 -> 1328;
	1325 [label="Kayıtsızlığın, hiçbir şekilde Void'in tanrısı olmadığına ve aslında Entrati ve sonrasında onunla etkileşime giren herkes tarafından yaratıldığına inanıyor -",shape=box,color=blue];
		1325 -> 1327;
	1328 [label="Ben bir Lua Kardeşiyim. Hayatımı ona ibadet etmeye adadım. Hayatım boyunca buna inandım.",shape=box,color=blue];
		1328 -> 1330;
	1327 [label="- onu \"kavramsal bütünlük\" olarak bildiğiniz şey aracılığıyla Void ile yarattı. ",shape=box,color=blue];
		1327 -> 1329;
	1330 [label="Ve kiliseye geldiğimden beri geçen tüm yıllar boyunca, inancımı sıkı sıkıya korudum - acılarımın, ağrılarımın ve vizyonlarımın kesin bilgisi -",shape=box,color=blue];
		1330 -> 1331;
	1329 [label="Duviri'yi yarattığınız gibi, sanırım.",shape=box,color=blue];
		1329 -> 1326;
	1331 [label="- onun hizmetindeydiler. Onun adına var oldular. Ve onun amacına hizmet ettiler.",shape=box,color=blue];
		1331 -> 1332;
	1332 [label="Ta ki \"Kardinal Dimanche\"ın Albrecht Entrati olduğu ortaya çıkana kadar.",shape=box,color=blue];
		1332 -> 1333;
	1333 [label="Ve bize kim olduğu gerçeğini, Void ile yaptığı kötülüklerin öyküsünü ve bunların sonucunda ortaya çıkan her şeyi anlattı. Daha doğrusu... bunların sonucunda ortaya çıkan her şeyi.",shape=box,color=blue];
		1333 -> 1334;
