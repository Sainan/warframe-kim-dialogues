		j3988367366 -> j407016287;
	j407016287 [label="Üstelik, kendisini yalnızca uzayda değil, zamanda da takip edebilecek bir şeyi serbest bıraktığını bilmenin verdiği büyük korkuyu da anlattı.",shape=box,color=blue];
