	j1088855480 [label="Daha önce, Kayıtsızlık'ın \"gerçek bir tanrı\" olduğuna inanmadığım gerçeğinden bahsetmek istediğini söylemiştin. Şimdi bunun için uygun bir zaman mı?",shape=box,color=red];
