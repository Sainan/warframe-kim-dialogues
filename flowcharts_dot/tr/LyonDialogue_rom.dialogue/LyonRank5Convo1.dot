		j2076634310 -> j1409243621;
	j329610473 [label="Bunun bana neden olduğu somut sorunu tartışmak için hangi zamanın ''uygun'' olup olmadığını bilemiyorum, Gezgin.",shape=box,color=blue];
		j329610473 -> j597009778;
	"Chat ends." [color=orange];
	j3023768697 [label="Beni rahatsız eden pek çok şey var Gezgin. Kayıtsızlık ve kavramsal bütünlük konusu, korkarım ki, bunlardan sadece biri.",shape=box,color=blue];
		j3023768697 -> j2645428475;
	j1148181806 [label="Asıl mesele şu ki, Gezgin, bunu bilmiyorum. Cevabı bilseydim, böyle bir iç tartışmayla kendimi parçalamazdım.",shape=box,color=blue];
		j1148181806 -> j2352281655;
	j1409243621 [label="Özetleyeceğim, ancak bu konudaki nutuklarından kaçınmanıza şaşırdım. Bunları her fırsatta paylaşmak konusunda fazlasıyla istekli.",shape=box,color=blue];
		j1409243621 -> j1784354804;
	j597009778 [label="Ama bu durumda, şu an, her zamankinden daha \"uygun\" bir zaman. Kayıtsızlık'ın gerçek bir tanrı olmadığına dair inancınızda Roathe ile aynı tarafta olmanız ilgimi çekti.",shape=box,color=blue];
		j597009778 -> j2352281655;
	j2645428475 [label="Ya da durumu nasıl yorumlamak istediğinize bağlı olarak iki tane. Sanırım ikilemimin özü de bu.",shape=box,color=blue];
		j2645428475 -> j2352281655;
	j2352281655 [label="Ancak, en baştan başlamalıyım. Elinizde bir bağlam yoksa, bu konunun benim için neden bu kadar önemli olduğunu tam olarak anlayamazsınız...",shape=box,color=blue];
		j2352281655 -> j4063486840;
	j1784354804 [label="Kayıtsızlığın, hiçbir şekilde Void'in tanrısı olmadığına ve aslında Entrati ve sonrasında onunla etkileşime giren herkes tarafından yaratıldığına inanıyor -",shape=box,color=blue];
		j1784354804 -> j3717538930;
	j4063486840 [label="Ben bir Lua Kardeşiyim. Hayatımı ona ibadet etmeye adadım. Hayatım boyunca buna inandım.",shape=box,color=blue];
		j4063486840 -> j3493904071;
	j3717538930 [label="- onu \"kavramsal bütünlük\" olarak bildiğiniz şey aracılığıyla Void ile yarattı. ",shape=box,color=blue];
		j3717538930 -> j3458402214;
	j3493904071 [label="Ve kiliseye geldiğimden beri geçen tüm yıllar boyunca, inancımı sıkı sıkıya korudum - acılarımın, ağrılarımın ve vizyonlarımın kesin bilgisi -",shape=box,color=blue];
		j3493904071 -> j4072652774;
	j3458402214 [label="Duviri'yi yarattığınız gibi, sanırım.",shape=box,color=blue];
		j3458402214 -> j2352281655;
