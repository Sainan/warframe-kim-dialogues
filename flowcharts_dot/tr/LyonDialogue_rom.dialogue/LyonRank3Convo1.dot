	11 [label="+10 Chemistry",color=orange];
		11 -> 14;
	12 [label="Zamanla olabilir. Ama konuşmaya daha yeni başladık. Buraya sadece... Marie'nin, konuşmak için sana güvenebileceğim konusundaki ısrarına boyun eğdiğimi söylemek için geldim.",shape=box,color=blue];
		12 -> 15;
	13 [label="Konuşmamıza daha yeni başladığımız için cevaplamaya bile kalkışmayacağım, neredeyse komik derecede yetersiz bir soru. Buraya sadece... Marie'nin, konuşmak için size güvenilebileceğim konusundaki ısrarına boyun eğdiğimi söylemek için geldim.",shape=box,color=blue];
		13 -> 15;
	14 [label="Chat ends.",color=orange];
	15 [label="Evaluate expressions on HellKeyPlayed",color=orange];
		15 -> 16 [label="x > 0",color=purple];
		15 -> 17 [label="x <= 0",color=purple];
		15 -> 17 [label="false",color=purple];
	16 [label="Ve Roathe'in “cehennem” kararlığında peşinde olduğu bu uğraşta artık ortak olduğumuza göre, birbirimizi iyice tanımamız akıllıca olur diye düşünüyorum. Bu, sizin tercih ettiğiniz yol gibi görünüyor. Bu nedenle, buradayım.",shape=box,color=blue];
		16 -> 18;
		16 -> 19;
	17 [label="Roathe'nin \"cehennem\" kararlılığında peşinde koştuğu bu uğraşta sonsuza dek ortak olup olmayacağımızı bilemesek de, birbirimizi doğru düzgün tanımamız akıllıca olur. Bu, sizin tercih ettiğiniz yol gibi görünüyor. Bu nedenle, buradayım.",shape=box,color=blue];
		17 -> 18;
		17 -> 19;
	18 [label="Nedense, bu işe yanlış bir başlangıç yaptığımı hissediyorum.",shape=box,color=red];
		18 -> 20;
	19 [label="Tercih ettiğiniz başka bir yol var mı?",shape=box,color=red];
		19 -> 21;
	20 [label="Hayır. Yapmadın. Muhtemelen senin konuşmaya alışık olduğun türden bir insan değilim. Bunun için, şimdiye kadar şanslıydın, ancak benim kalibremdeki deliler nadir bulunur.",shape=box,color=blue];
		20 -> 22;
	21 [label="Hayır. Bu kabul edilebilir. Hatta düşüncelerimi istediğim gibi şekillendirmem için bana zaman tanıyor. Bu cihazın neden çekici olduğunu anlayabiliyorum.",shape=box,color=blue];
		21 -> 23;
	22 [label="Konudan saptım. Korkarım ki buraya çok fazla \"yazmak\" için gelmedim, ki bu da sizi hayal kırıklığına uğratacaktır. Sadece teslim olduğumu bildirmek istedim.",shape=box,color=blue];
		22 -> 24;
		22 -> 25;
	23 [label="Ancak, buraya “yazmak” için çok zaman ayıramayacağımdan dolayı sizi hayal kırıklığına uğratacağımdan korkuyorum. Sadece teslim olduğumu size bildirmek istedim.",shape=box,color=blue];
		23 -> 25;
		23 -> 24;
	24 [label="Marie göründüğünden daha tehlikeli, değil mi?",shape=box,color=red];
		24 -> 26;
	25 [label="Tekrardan teşekkür etmek istiyorum.",shape=box,color=red];
