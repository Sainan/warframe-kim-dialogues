		j3531794123 -> j1056823501;
	j3028056432 [label="+15 Chemistry",color=orange];
		j3028056432 -> j3958068707;
	j1056823501 [label="Suyun aslında ne kadar derinlere gittiğini yeni yeni fark etmeye başlıyorsun.",shape=box,color=blue];
		j1056823501 -> j2895678923;
	j3958068707 [label="Ve siz de, her ne olursa olsun, hoş geldiniz.",shape=box,color=blue];
		j3958068707 -> j2895678923;
