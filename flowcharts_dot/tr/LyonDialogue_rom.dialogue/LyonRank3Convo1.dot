	j3349833213 [label="Merhabalar Gezgin.",shape=box,color=blue];
		j3349833213 -> j3016289754;
	j3016289754 [label="Benimle konuşmak istediğinizi duydum.",shape=box,color=blue];
		j3016289754 -> j665461303;
		j3016289754 -> j2319577402;
		j3016289754 -> j1330027949;
	j665461303 [label="Seninle burada konuşmak bir zevk, Lyon - teşekkür ederim.",shape=box,color=red];
		j665461303 -> j635016090;
	j2319577402 [label="Marie sonunda seni benim bir tehdit olmadığım konusunda ikna etti mi?",shape=box,color=red];
		j2319577402 -> j2644919521;
	j1330027949 [label="Ah! Merhaba Lyon. Açıkçası ikna olacağını düşünmemiştim. Fikrini değiştirmene sevindim.",shape=box,color=red];
		j1330027949 -> j3624486772;
	j635016090 [label="Sonunda keşke bu kadar hevesli olmasaydın diyebilirsiniz, ama olsun. Rica ederim.",shape=box,color=blue];
		j635016090 -> j3524394831;
		j635016090 -> j3578824344;
	j2644919521 [label="Beni bu kadar hızlı geri adım atmaya zorlayacak sebepler aramaya itmeyin.",shape=box,color=blue];
		j2644919521 -> j1933300832;
	j3624486772 [label="Evet, doğru. Lakin her şey bittiğinde pek de memnun kalmayabilirsiniz.",shape=box,color=blue];
		j3624486772 -> j3524394831;
		j3624486772 -> j3578824344;
	j3524394831 [label="Başkalarından öğrendiğim kadarıyla, konuşmamız gereken konular var. Yardımcı olabileceğim bir konu var mı?",shape=box,color=red];
		j3524394831 -> j1007718333;
	j3578824344 [label="Bir sorun mu var?",shape=box,color=red];
		j3578824344 -> j2146255127;
	j1933300832 [label="+10 Chemistry",color=orange];
		j1933300832 -> "Chat ends.";
	j1007718333 [label="Zamanla olabilir. Ama konuşmaya daha yeni başladık. Buraya sadece... Marie'nin, konuşmak için sana güvenebileceğim konusundaki ısrarına boyun eğdiğimi söylemek için geldim.",shape=box,color=blue];
		j1007718333 -> j2777944732;
	j2146255127 [label="Konuşmamıza daha yeni başladığımız için cevaplamaya bile kalkışmayacağım, neredeyse komik derecede yetersiz bir soru. Buraya sadece... Marie'nin, konuşmak için size güvenilebileceğim konusundaki ısrarına boyun eğdiğimi söylemek için geldim.",shape=box,color=blue];
		j2146255127 -> j2777944732;
	"Chat ends." [color=orange];
	j2777944732 [label="Evaluate expressions on HellKeyPlayed counter",color=orange];
		j2777944732 -> j1685815324 [label="x > 0",color=purple];
		j2777944732 -> j2617290754 [label="x <= 0",color=purple];
		j2777944732 -> j2617290754 [label="false",color=purple];
	j1685815324 [label="Ve Roathe'in “cehennem” kararlığında peşinde olduğu bu uğraşta artık ortak olduğumuza göre, birbirimizi iyice tanımamız akıllıca olur diye düşünüyorum. Bu, sizin tercih ettiğiniz yol gibi görünüyor. Bu nedenle, buradayım.",shape=box,color=blue];
		j1685815324 -> j2918640916;
		j1685815324 -> j2235754665;
	j2617290754 [label="Roathe'nin \"cehennem\" kararlılığında peşinde koştuğu bu uğraşta sonsuza dek ortak olup olmayacağımızı bilemesek de, birbirimizi doğru düzgün tanımamız akıllıca olur. Bu, sizin tercih ettiğiniz yol gibi görünüyor. Bu nedenle, buradayım.",shape=box,color=blue];
		j2617290754 -> j2918640916;
		j2617290754 -> j2235754665;
	j2918640916 [label="Nedense, bu işe yanlış bir başlangıç yaptığımı hissediyorum.",shape=box,color=red];
		j2918640916 -> j2021101421;
	j2235754665 [label="Tercih ettiğiniz başka bir yol var mı?",shape=box,color=red];
		j2235754665 -> j973828140;
	j2021101421 [label="Hayır. Yapmadın. Muhtemelen senin konuşmaya alışık olduğun türden bir insan değilim. Bunun için, şimdiye kadar şanslıydın, ancak benim kalibremdeki deliler nadir bulunur.",shape=box,color=blue];
		j2021101421 -> j1375468976;
	j973828140 [label="Hayır. Bu kabul edilebilir. Hatta düşüncelerimi istediğim gibi şekillendirmem için bana zaman tanıyor. Bu cihazın neden çekici olduğunu anlayabiliyorum.",shape=box,color=blue];
		j973828140 -> j3850907589;
	j1375468976 [label="Konudan saptım. Korkarım ki buraya çok fazla \"yazmak\" için gelmedim, ki bu da sizi hayal kırıklığına uğratacaktır. Sadece teslim olduğumu bildirmek istedim.",shape=box,color=blue];
		j1375468976 -> j1049152906;
		j1375468976 -> j644057944;
	j3850907589 [label="Ancak, buraya “yazmak” için çok zaman ayıramayacağımdan dolayı sizi hayal kırıklığına uğratacağımdan korkuyorum. Sadece teslim olduğumu size bildirmek istedim.",shape=box,color=blue];
		j3850907589 -> j644057944;
		j3850907589 -> j1049152906;
	j1049152906 [label="Marie göründüğünden daha tehlikeli, değil mi?",shape=box,color=red];
		j1049152906 -> j3531794123;
	j644057944 [label="Tekrardan teşekkür etmek istiyorum.",shape=box,color=red];
		j644057944 -> j3028056432;
