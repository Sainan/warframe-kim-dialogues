	5 [label="Ah! Merhaba Lyon. Açıkçası ikna olacağını düşünmemiştim. Fikrini değiştirmene sevindim.",shape=box,color=red];
		5 -> 8;
	6 [label="Sonunda keşke bu kadar hevesli olmasaydın diyebilirsiniz, ama olsun. Rica ederim.",shape=box,color=blue];
