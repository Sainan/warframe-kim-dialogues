	7 [label="Beni bu kadar hızlı geri adım atmaya zorlayacak sebepler aramaya itmeyin.",shape=box,color=blue];
		7 -> 11;
	8 [label="Evet, doğru. Lakin her şey bittiğinde pek de memnun kalmayabilirsiniz.",shape=box,color=blue];
		8 -> 9;
		8 -> 10;
	9 [label="Başkalarından öğrendiğim kadarıyla, konuşmamız gereken konular var. Yardımcı olabileceğim bir konu var mı?",shape=box,color=red];
		9 -> 12;
	10 [label="Bir sorun mu var?",shape=box,color=red];
