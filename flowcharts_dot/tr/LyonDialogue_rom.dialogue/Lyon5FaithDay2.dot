		j665103117 -> j2726792332;
	j3032180331 [label="Ancak bu, benim için, özünde bu dünyada iyilik yapmak amacıyla kurulmuş bir kuruluşta geçirdiğim yılların değerini değiştirmez.",shape=box,color=blue];
		j3032180331 -> j506528466;
	j240447430 [label="Sizin de belirttiğiniz gibi, biz... bunu asla bilemeyebiliriz. Ve belki de bunu bilmemiz gerekmiyordur. Hayatın gerçeği budur. Ancak bu, benim için, özünde bu dünyada iyilik yapmak amacıyla kurulmuş bir kuruluşta geçirdiğim yılların değerini değiştirmez.",shape=box,color=blue];
		j240447430 -> j506528466;
	j3420887216 [label="Bu... benim için pek çok şeyi sorgulamama neden oldu, yani... inancımı. Yanmış kağıt gibi buruşup düştü, toza dönüştü. Bu zayıflığımdan dolayı kendimden nefret ediyorum...",shape=box,color=blue];
		j3420887216 -> j3287457751;
