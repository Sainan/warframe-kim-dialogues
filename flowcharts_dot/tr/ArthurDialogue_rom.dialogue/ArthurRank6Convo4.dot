	j152267262 [label="Amir'i oyunlarından birini oynarken izliyordum. ",shape=box,color=blue];
		j152267262 -> j446857184;
	j941379372 [label="Kültürlerimiz arasındaki tüm farklılıklara rağmen, çocukların hâlâ oturup kendi hallerinde oyuncaklarla oynayabildiğini bilmek oldukça rahatlatıcı.",shape=box,color=blue];
		j941379372 -> j3376527660;
