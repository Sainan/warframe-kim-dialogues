	3471 [label="Benim hayatım malum Void olayı yüzünden biraz daha sorunlu hale geldi...",shape=box,color=red];
		3471 -> 3450;
	3472 [label="Doğru bir noktaya değindin. Hayaller gerçeğin yerini almaya başladığında bu bir sorun olur. Demek istediğim o değildi.",shape=box,color=blue];
		3472 -> 3474;
	3473 [label="Haklısın. Ve umarım bu, içinde bulunduğumuz her neyse, birlikte ilerledikçe hatırlayacağımız bir şey olur.",shape=box,color=blue];
		3473 -> 3474;
	3474 [label="Biliyor musun, Eleanor, Velimir, Aoi ve Amir'i Flare ve Lizzie ile saklambaç oynarken gördüm. (Quincy onun oynamasına izin verilmediğini söyledi çünkü o pislik hile yapıyordu ve dürbününü duvarların arkasını görmek için kullanıyordu.)",shape=box,color=blue];
		3474 -> 3475;
	3475 [label="Hepsi bana bakıyordu, üzüleceğimden endişe ediyorlardı. Çünkü onları yararlı bir şey yapmaları gerektiği yerde şakalaşırken yakalamıştım.",shape=box,color=blue];
		3475 -> 3476;
	3476 [label="Halbuki ben daha çok davet edilmediğim için üzülüyordum. Heh. Ama huysuz lider suratını takınmak ve görev yerlerinde olmadıkları için sinirlenmiş gibi davranmak zorunda kaldım.",shape=box,color=blue];
		3476 -> 3477;
	3477 [label="Ama Amir'in oyunları var. Aoi'nin On-lyne'i var. Kaya'nın bile çıkartmaları ve Jinymon'u var, dünya onu çok erken yetişkinliğe zorlamış olsa bile.",shape=box,color=blue];
		3477 -> 3478;
