		j2876358713 -> j3061264867;
		j2876358713 -> j3583450516;
	j446857184 [label="Ve kendi kendime düşündüm - hayatımda tekrar böyle bir neşeye sahip olmak için neler vermezdim.",shape=box,color=blue];
		j446857184 -> j321037042;
	j3376527660 [label="Bir aksiyon figürüm vardı. İsmi Action Angus ve o bir askerdi. Ne sürpriz ama, değil mi?",shape=box,color=blue];
		j3376527660 -> j3487854417;
	j3061264867 [label="Her çeşit figür, peluş hayvanlar ve bloklar. Tipik çocuk eşyaları. ",shape=box,color=red];
		j3061264867 -> j941379372;
	j3583450516 [label="Benimde bir tane vardı - sanırım buna figür de denilebilir - hani şu Dax çocuğu gibi olan. Adını da bir kitaptaki karakterden esinlenerek koymuştum. Dominus Thrax.",shape=box,color=red];
		j3583450516 -> j488306044;
	j321037042 [label="Aoi'ye, Amir'e, hatta Kaya'ya bile \"çocuksu\" şeylerde eğlence buldukları için asla burun kıvırmadım. Bu beni hiç rahatsız etmedi.",shape=box,color=blue];
		j321037042 -> j2094594135;
	j3487854417 [label="Bir gündönümü şenliği sırasında, büyük çocuklardan birkaçı diğer oyuncaklarımla birlikte onu da benden çaldı ve...",shape=box,color=blue];
		j3487854417 -> j980580813;
	j488306044 [label="Ah, lanet olsun. Bilmem gerekirdi. Bu konuyu açtığım için özür dilerim.",shape=box,color=blue];
		j488306044 -> j282043144;
		j488306044 -> j872635325;
	j2094594135 [label="Ama bazen bunu hissedebilen yanımın uzun zaman önce ölmüş olmasından korkuyorum.",shape=box,color=blue];
		j2094594135 -> j2456243219;
	j980580813 [label="Bu uzun bir hikaye. Özetlemek gerekirse; Oyuncaklarla oynamak için \"çok büyük\" olduğumu söylediler. O gün, oyuncaklarla oynadığım son günümdü.",shape=box,color=blue];
		j980580813 -> j227108555;
	j282043144 [label="Bu, üzerine konuşmak için istekli olduğum bir konu değil.",shape=box,color=red];
		j282043144 -> j3388072574;
	j872635325 [label="Önemli değil. Bu senin hatan değil.",shape=box,color=red];
		j872635325 -> j3555230685;
	j2456243219 [label="Sence de üzücü değil mi? Çocuklara bir şeyi sevmelerini söyleyip, sonra \"olgunlaştıklarında\" ondan vazgeçmelerini söylüyoruz.",shape=box,color=blue];
		j2456243219 -> j3441066081;
		j2456243219 -> j2721431928;
	j227108555 [label="Geçen gün Amir'i oyunlarından birini oynarken izliyordum. Ona ne kadar bağlı, ne kadar mutlu olduğu belliydi. Benim hayatımda böyle bir şey olmadığı için biraz kıskandığımı söyleyebilirim.",shape=box,color=blue];
		j227108555 -> j2456243219;
	j3388072574 [label="Şimdi kendimi tam bir aptal gibi hissediyorum.",shape=box,color=blue];
		j3388072574 -> "Chat ends.";
	j3555230685 [label="Sanırım tüm normal oyuncaklardan vardı. Bloklar, peluş hayvanlar, figürler, oyuncak bebekler.",shape=box,color=red];
		j3555230685 -> j1448943262;
	j3441066081 [label="Bilemiyorum. Hepimiz bir gün büyümek zorundayız. Kendimizi hayallerin arkasına saklayamayız. Bunu zor yoldan öğrendim.",shape=box,color=red];
		j3441066081 -> j4261062048;
	j2721431928 [label="Bence hayat çirkin, acı verici ve kısa olabilir. Bu yüzden elimizdeki zamanı bulabildiğimiz kadar çok eğlence, kahkaha ve sevgiyle doldurmalıyız.",shape=box,color=red];
		j2721431928 -> j1601172362;
	j1448943262 [label="Benim hayatım malum Void olayı yüzünden biraz daha sorunlu hale geldi...",shape=box,color=red];
		j1448943262 -> j941379372;
	j4261062048 [label="Doğru bir noktaya değindin. Hayaller gerçeğin yerini almaya başladığında bu bir sorun olur. Demek istediğim o değildi.",shape=box,color=blue];
		j4261062048 -> j3745268028;
	j1601172362 [label="Haklısın. Ve umarım bu, içinde bulunduğumuz her neyse, birlikte ilerledikçe hatırlayacağımız bir şey olur.",shape=box,color=blue];
		j1601172362 -> j3745268028;
	j3745268028 [label="Biliyor musun, Eleanor, Velimir, Aoi ve Amir'i Flare ve Lizzie ile saklambaç oynarken gördüm. (Quincy onun oynamasına izin verilmediğini söyledi çünkü o pislik hile yapıyordu ve dürbününü duvarların arkasını görmek için kullanıyordu.)",shape=box,color=blue];
		j3745268028 -> j256489649;
	j256489649 [label="Hepsi bana bakıyordu, üzüleceğimden endişe ediyorlardı. Çünkü onları yararlı bir şey yapmaları gerektiği yerde şakalaşırken yakalamıştım.",shape=box,color=blue];
		j256489649 -> j1736645587;
	j1736645587 [label="Halbuki ben daha çok davet edilmediğim için üzülüyordum. Heh. Ama huysuz lider suratını takınmak ve görev yerlerinde olmadıkları için sinirlenmiş gibi davranmak zorunda kaldım.",shape=box,color=blue];
		j1736645587 -> j2253485214;
	j2253485214 [label="Ama Amir'in oyunları var. Aoi'nin On-lyne'i var. Kaya'nın bile çıkartmaları ve Jinymon'u var, dünya onu çok erken yetişkinliğe zorlamış olsa bile.",shape=box,color=blue];
		j2253485214 -> j1026484571;
		j2253485214 -> j1159102836;
	j1026484571 [label="Değinmek istediğin nokta nedir?",shape=box,color=red];
		j1026484571 -> j93316898;
	j1159102836 [label="Bence oyuncaklarda ve oyunlarda neşe bulmak tekrar edinilebilecek bir duygu.",shape=box,color=red];
		j1159102836 -> j3411601086;
	j93316898 [label="Doğruyu söylemek gerekirse emin değilim. Sadece çok uzun zamandır hayatımda olmayan bir şeyi özlediğimi hissediyorum.",shape=box,color=blue];
		j93316898 -> j4215687554;
	j3411601086 [label="Şimdiden kahkahaları duyabiliyorum. Ama sanırım beni geri tutan şey de bu, değil mi? Utanç duygusu.",shape=box,color=blue];
		j3411601086 -> j3411441876;
	j4215687554 [label="Bu duygulara yeniden kavuşabileceğimden, ya da bunun için çok geç olup olmadığından emin değilim. Ama kim bilir. Yeterli zaman olursa, belki her şey mümkün olabilir.",shape=box,color=blue];
		j4215687554 -> "Chat ends.";
	j3411441876 [label="Anlık utancımı bastırabilsem bile bu duyguları geri getirmenin mümkün olduğundan emin değilim. Ama kim bilir. Yeterince döngü ile belki de her şey mümkündür.",shape=box,color=blue];
		j3411441876 -> "Chat ends.";
}