		j2001874731 -> j1417240750;
	j3222400994 [label="AH, SOL aşkına. Kastettiğim bu değildi ve bunu sen de biliyorsun!",shape=box,color=blue];
		j3222400994 -> j634847489;
	j1417240750 [label="Binlerce yıl sonraki bilmem kaçıncı bilmem neyi hayal etmek zor,",shape=box,color=blue];
		j1417240750 -> j4147480345;
	j634847489 [label="Yani çocuk oyuncakları. Oyuncak Bebekler. Aksiyon figürleri. Bu tarz şeyler.",shape=box,color=blue];
