		3479 -> 3481;
	3480 [label="Doğruyu söylemek gerekirse emin değilim. Sadece çok uzun zamandır hayatımda olmayan bir şeyi özlediğimi hissediyorum.",shape=box,color=blue];
		3480 -> 3482;
	3481 [label="Şimdiden kahkahaları duyabiliyorum. Ama sanırım beni geri tutan şey de bu, değil mi? Utanç duygusu.",shape=box,color=blue];
		3481 -> 3483;
	3482 [label="Bu duygulara yeniden kavuşabileceğimden, ya da bunun için çok geç olup olmadığından emin değilim. Ama kim bilir. Yeterli zaman olursa, belki her şey mümkün olabilir.",shape=box,color=blue];
		3482 -> 3484;
