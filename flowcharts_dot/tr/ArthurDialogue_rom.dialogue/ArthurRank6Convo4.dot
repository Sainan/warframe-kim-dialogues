		3453 -> 3457;
	3454 [label="Bir aksiyon figürüm vardı. İsmi Action Angus ve o bir askerdi. Ne sürpriz ama, değil mi?",shape=box,color=blue];
		3454 -> 3458;
	3455 [label="Her çeşit figür, peluş hayvanlar ve bloklar. Tipik çocuk eşyaları. ",shape=box,color=red];
		3455 -> 3450;
	3456 [label="Benimde bir tane vardı - sanırım buna figür de denilebilir - hani şu Dax çocuğu gibi olan. Adını da bir kitaptaki karakterden esinlenerek koymuştum. Dominus Thrax.",shape=box,color=red];
		3456 -> 3459;
	3457 [label="Aoi'ye, Amir'e, hatta Kaya'ya bile \"çocuksu\" şeylerde eğlence buldukları için asla burun kıvırmadım. Bu beni hiç rahatsız etmedi.",shape=box,color=blue];
		3457 -> 3460;
	3458 [label="Bir gündönümü şenliği sırasında, büyük çocuklardan birkaçı diğer oyuncaklarımla birlikte onu da benden çaldı ve...",shape=box,color=blue];
		3458 -> 3461;
	3459 [label="Ah, lanet olsun. Bilmem gerekirdi. Bu konuyu açtığım için özür dilerim.",shape=box,color=blue];
		3459 -> 3462;
		3459 -> 3463;
	3460 [label="Ama bazen bunu hissedebilen yanımın uzun zaman önce ölmüş olmasından korkuyorum.",shape=box,color=blue];
		3460 -> 3464;
	3461 [label="Bu uzun bir hikaye. Özetlemek gerekirse; Oyuncaklarla oynamak için \"çok büyük\" olduğumu söylediler. O gün, oyuncaklarla oynadığım son günümdü.",shape=box,color=blue];
		3461 -> 3465;
