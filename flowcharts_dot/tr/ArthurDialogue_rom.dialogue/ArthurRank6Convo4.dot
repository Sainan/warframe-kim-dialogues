		3462 -> 3466;
	3463 [label="Önemli değil. Bu senin hatan değil.",shape=box,color=red];
		3463 -> 3467;
	3464 [label="Sence de üzücü değil mi? Çocuklara bir şeyi sevmelerini söyleyip, sonra \"olgunlaştıklarında\" ondan vazgeçmelerini söylüyoruz.",shape=box,color=blue];
		3464 -> 3468;
		3464 -> 3469;
	3465 [label="Geçen gün Amir'i oyunlarından birini oynarken izliyordum. Ona ne kadar bağlı, ne kadar mutlu olduğu belliydi. Benim hayatımda böyle bir şey olmadığı için biraz kıskandığımı söyleyebilirim.",shape=box,color=blue];
		3465 -> 3464;
	3466 [label="Şimdi kendimi tam bir aptal gibi hissediyorum.",shape=box,color=blue];
		3466 -> 3470;
	3467 [label="Sanırım tüm normal oyuncaklardan vardı. Bloklar, peluş hayvanlar, figürler, oyuncak bebekler.",shape=box,color=red];
		3467 -> 3471;
	3468 [label="Bilemiyorum. Hepimiz bir gün büyümek zorundayız. Kendimizi hayallerin arkasına saklayamayız. Bunu zor yoldan öğrendim.",shape=box,color=red];
		3468 -> 3472;
	3469 [label="Bence hayat çirkin, acı verici ve kısa olabilir. Bu yüzden elimizdeki zamanı bulabildiğimiz kadar çok eğlence, kahkaha ve sevgiyle doldurmalıyız.",shape=box,color=red];
		3469 -> 3473;
