		j108935537 -> j3690329326;
	j3690329326 [label="Bunu anlamıyorum. Mühimmatlarının nereden geldiği konusunda da fazla düşünmek istemiyorum. Ya da ilk etapta nelerden oluştuğunu.",shape=box,color=blue];
