		j3418499849 -> j671838945;
	j652286304 [label="İlk başta, diğerlerinin Helminth'den geçmemesi ihtimaline karşı beni \"yedek\" warframe olarak yaptığını düşünmüştüm. Şimdi ise o kadar emin değilim.",shape=box,color=red];
		j652286304 -> j468132890;
