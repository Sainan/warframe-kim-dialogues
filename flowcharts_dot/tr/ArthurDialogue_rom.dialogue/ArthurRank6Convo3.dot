		j1318175504 -> j3988362380;
	j1424547019 [label="Bunun bir anlamı olup olmadığından emin değilim. Onları tanıyorum, onlara güveniyorum, sadece onlarla *bir cehenneme gidip gelmediğim kaldı*.",shape=box,color=blue];
		j1424547019 -> j3710788613;
