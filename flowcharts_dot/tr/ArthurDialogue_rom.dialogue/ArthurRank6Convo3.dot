		j3510192547 -> j566667152;
	j3016030022 [label="Sol aşkına. Aynen öyle. Başta Libertatianlar hakkında ne yapacağımı bilmiyordum. Ama şimdi? Burada olmalarından oldukça memnunum.",shape=box,color=blue];
