	3612 [label="Chat ends.",color=orange];
	3613 [label="Arthur, konuşabilir miyiz? [Birden fazla ilişki partneri için onay iste.]",shape=box,color=red];
		3613 -> 3615;
	3611 [label="[Son.]",shape=box,color=red];
		3611 -> 3614;
	3610 [label="Chat ends.",color=orange];
	3615 [label="Her zaman. Bir sorun mu var?",shape=box,color=blue];
		3615 -> 3617;
	3614 [label="Update boolean ArthurConsentComplete",color=orange];
		3614 -> 3616;
	3617 [label="Hayır, sorun yok. Sadece senin için rahatsız edici olup olmayacağını merak ettiğim bir konu hakkında konuşmak istedim.",shape=box,color=red];
		3617 -> 3618;
	3616 [label="Chat ends.",color=orange];
	3618 [label="Seni istemeyeceğin bir duruma sokmak istemiyorum. Bunun daha önce konuşmadığımız bir konu olduğunu biliyorum. Yani hayır dersen sorun değil. Sadece bilmeni istiyorum.",shape=box,color=red];
		3618 -> 3619;
	3619 [label="Yaşadığımız şey benim için önemli - çok önemli - ve hislerim gerçek. Bundan şüphe duymanı istemiyorum.",shape=box,color=red];
		3619 -> 3620;
	3620 [label="Ah. Konunun nereye varacağını az çok anladım. Başka birine karşı da hislerin var, değil mi?",shape=box,color=blue];
		3620 -> 3621;
		3620 -> 3622;
	3621 [label="Evet. Anlaması zor olabilir ama bu sana karşı daha az şey hissettiğim anlamına gelmiyor.",shape=box,color=red];
		3621 -> 3623;
	3622 [label="Evet. Ama şimdi düşününce, sanırım her şeyi burada bitirmeliyiz. [Ayrıl.]",shape=box,color=red];
		3622 -> 3624;
	3623 [label="Hayatım, orduda bu kadar yıl geçirmiş biri olarak her türlü ilişki şeklini az çok görmediğimi mi düşünüyorsun?",shape=box,color=blue];
		3623 -> 3625;
	3624 [label="Eğer gerçekten istediğin buysa...",shape=box,color=blue];
		3624 -> 3626;
	3625 [label="Hayatının büyük bir kısmını neredeyse ölmek üzere olduğun anlarla geçirdiğinde, hayatta neyin önemli ve neyin önemsiz olduğunu takdir etmeyi öğreniyorsun.",shape=box,color=blue];
		3625 -> 3627;
	3626 [label="Update boolean IsDating",color=orange];
		3626 -> 3628;
	3627 [label="Çizilen çizgileri sorgulamayı artık bıraktın. Seni çok iyi anlıyorum.",shape=box,color=blue];
		3627 -> 3629;
	3628 [label="Update boolean ArthurDating",color=orange];
		3628 -> 3630;
	3629 [label="Gerçek şu ki, sen benim için önemlisin. Ve eğer diğer kişi de senin için önemliyse, benim için de önemlidir.",shape=box,color=blue];
		3629 -> 3631;
	3630 [label="Chat ends.",color=orange];
	3631 [label="Sadece... Hex'den birisi olmasın. Tamam mı? \"Aile\" içinde olsaydı, sanırım bunu kaldıramazdım.",shape=box,color=blue];
		3631 -> 3632;
	3632 [label="Düşüncesi bile kabus gibi.",shape=box,color=blue];
		3632 -> 3634;
		3632 -> 3633;
	3634 [label="Haha. Sana sözüm olsun.",shape=box,color=red];
		3634 -> 3636;
	3633 [label="Aslında, onu gerçekten beğeneceğini düşünüyorum.",shape=box,color=red];
		3633 -> 3635;
	3636 [label="Teşekkür ederim. Ve umarım bir gün onunla tanışırım. Yani... kişisel sebepler için.",shape=box,color=blue];
		3636 -> 3637;
	3635 [label="Ve umarım bir gün onunla tanışırım. Yani... kişisel sebepler için.",shape=box,color=blue];
		3635 -> 3637;
	3637 [label="+20 Chemistry",color=orange];
		3637 -> 3638;
	3638 [label="Sen sadece kendine iyi bak, aşkım.",shape=box,color=blue];
		3638 -> 3639;
	3639 [label="Update boolean ArthurConsentComplete",color=orange];
		3639 -> 3640;
	3640 [label="Chat ends.",color=orange];
}