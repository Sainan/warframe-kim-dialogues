	"Chat ends." [color=orange];
	j1569221931 [label="Check boolean ArthurConsentComplete",color=orange];
		j1569221931 -> "Chat ends." [label=true,color=green];
		j1569221931 -> j1475679392 [label=false,color=brown];
		j1569221931 -> j4165596767 [label=false,color=brown];
	j972778441 [label="Check boolean ArthurPolyamorySuccess",color=orange];
		j972778441 -> j1569221931 [label=true,color=green];
		j972778441 -> "Chat ends." [label=false,color=brown];
	j1475679392 [label="Arthur, konuşabilir miyiz? [Birden fazla ilişki partneri için onay iste.]",shape=box,color=red];
		j1475679392 -> j4078143820;
	j4165596767 [label="[Son.]",shape=box,color=red];
		j4165596767 -> j3652224286;
	j4078143820 [label="Her zaman. Bir sorun mu var?",shape=box,color=blue];
		j4078143820 -> j4241954197;
	j3652224286 [label="Boolean ArthurConsentComplete is now true.",color=orange];
		j3652224286 -> "Chat ends.";
	j4241954197 [label="Hayır, sorun yok. Sadece senin için rahatsız edici olup olmayacağını merak ettiğim bir konu hakkında konuşmak istedim.",shape=box,color=red];
		j4241954197 -> j1586931508;
	j1586931508 [label="Seni istemeyeceğin bir duruma sokmak istemiyorum. Bunun daha önce konuşmadığımız bir konu olduğunu biliyorum. Yani hayır dersen sorun değil. Sadece bilmeni istiyorum.",shape=box,color=red];
		j1586931508 -> j190662211;
	j190662211 [label="Yaşadığımız şey benim için önemli - çok önemli - ve hislerim gerçek. Bundan şüphe duymanı istemiyorum.",shape=box,color=red];
		j190662211 -> j2824674092;
	j2824674092 [label="Ah. Konunun nereye varacağını az çok anladım. Başka birine karşı da hislerin var, değil mi?",shape=box,color=blue];
		j2824674092 -> j2363455504;
		j2824674092 -> j3884965428;
	j2363455504 [label="Evet. Anlaması zor olabilir ama bu sana karşı daha az şey hissettiğim anlamına gelmiyor.",shape=box,color=red];
		j2363455504 -> j740030320;
	j3884965428 [label="Evet. Ama şimdi düşününce, sanırım her şeyi burada bitirmeliyiz. [Ayrıl.]",shape=box,color=red];
		j3884965428 -> j1846167400;
	j740030320 [label="Hayatım, orduda bu kadar yıl geçirmiş biri olarak her türlü ilişki şeklini az çok görmediğimi mi düşünüyorsun?",shape=box,color=blue];
		j740030320 -> j3191950808;
	j1846167400 [label="Eğer gerçekten istediğin buysa...",shape=box,color=blue];
		j1846167400 -> j3701883258;
	j3191950808 [label="Hayatının büyük bir kısmını neredeyse ölmek üzere olduğun anlarla geçirdiğinde, hayatta neyin önemli ve neyin önemsiz olduğunu takdir etmeyi öğreniyorsun.",shape=box,color=blue];
		j3191950808 -> j342452469;
	j3701883258 [label="Boolean IsDating is now false.",color=orange];
		j3701883258 -> j913620630;
	j342452469 [label="Çizilen çizgileri sorgulamayı artık bıraktın. Seni çok iyi anlıyorum.",shape=box,color=blue];
		j342452469 -> j1308253790;
	j913620630 [label="Boolean ArthurDating is now false.",color=orange];
		j913620630 -> "Chat ends.";
	j1308253790 [label="Gerçek şu ki, sen benim için önemlisin. Ve eğer diğer kişi de senin için önemliyse, benim için de önemlidir.",shape=box,color=blue];
		j1308253790 -> j3653224070;
	j3653224070 [label="Sadece... Hex'den birisi olmasın. Tamam mı? \"Aile\" içinde olsaydı, sanırım bunu kaldıramazdım.",shape=box,color=blue];
		j3653224070 -> j2122648637;
	j2122648637 [label="Düşüncesi bile kabus gibi.",shape=box,color=blue];
		j2122648637 -> j1950867371;
		j2122648637 -> j3200292302;
	j1950867371 [label="Haha. Sana sözüm olsun.",shape=box,color=red];
		j1950867371 -> j1098964091;
	j3200292302 [label="Aslında, onu gerçekten beğeneceğini düşünüyorum.",shape=box,color=red];
		j3200292302 -> j1997842513;
	j1098964091 [label="Teşekkür ederim. Ve umarım bir gün onunla tanışırım. Yani... kişisel sebepler için.",shape=box,color=blue];
		j1098964091 -> j2207751290;
	j1997842513 [label="Ve umarım bir gün onunla tanışırım. Yani... kişisel sebepler için.",shape=box,color=blue];
		j1997842513 -> j2207751290;
	j2207751290 [label="+20 Chemistry",color=orange];
		j2207751290 -> j1971981948;
	j1971981948 [label="Sen sadece kendine iyi bak, aşkım.",shape=box,color=blue];
		j1971981948 -> j3652224286;
}