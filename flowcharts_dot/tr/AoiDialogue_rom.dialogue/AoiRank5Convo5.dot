digraph {
	3513 [label="AoiRank5Convo5 begins.",color=orange];
		3513 -> 3514;
		3513 -> 3515;
	3514 [label="Sende gerçekten hayran olduğum bir şey, daha iyi bir dünya inşa etmeye olan sarsılmaz bağlılığın. Bu nereden geliyor?",shape=box,color=red];
		3514 -> 3516;
	3515 [label="Etkileyici bir cesaretin var. İçindeki bu ateşi yakan şey nedir?",shape=box,color=red];
		3515 -> 3516;
	3516 [label="vay canına bunu söylediğin için teşekkür ederim. şey... hımm. aslında hayatımın gidişatını belirleyen belirleyici veya benzer bir şey olmadı.",shape=box,color=blue];
		3516 -> 3517;
	3517 [label="bildiğim kadarıyla bu bana ailemden miras kaldı. onlar pratik insanlardı ama aynı zamanda hayalperestlerdi de",shape=box,color=blue];
		3517 -> 3518;
	3518 [label="Demek istediğim, eğer bir hayalperest değilsen uzayı keşfetmek için roket inşa etmezsin.",shape=box,color=blue];
		3518 -> 3519;
		3518 -> 3520;
		3518 -> 3521;
	3519 [label="Bekle. Ailen roket mi inşa etti?",shape=box,color=red];
		3519 -> 3522;
	3520 [label="Bu tam bir aile işi. Görünüşe göre çıtayı çok yükseğe koymuşlar.",shape=box,color=red];
		3520 -> 3523;
	3521 [label="Pek de yaygın bir aile mirası sayılmaz. Onlara ilham veren şeylerden hiç bahsettiler mi?",shape=box,color=red];
		3521 -> 3524;
	3522 [label="eh, babam yaptı. annem de yapmayı biliyordu.",shape=box,color=blue];
		3522 -> 3525;
	3523 [label="evet... ve asker olduğumda, benim için umdukları hayatın tam olarak bu olmadığını bana açıkça belirttiler.",shape=box,color=blue];
		3523 -> 3525;
	3524 [label="pek değil. hayallerini yüksek sesle paylaşmaya pek meraklı değillerdi. sanırım dünyaya yaptıkları katkıların onlar adına konuşacağına inanıyorlardı.",shape=box,color=blue];
		3524 -> 3525;
	3525 [label="babam havacılık ve uzay mühendisiydi. annem, öğrenciyken tanıştıkları üniversitede uzay sistemleri tasarımı dersi veriyordu.",shape=box,color=blue];
		3525 -> 3527;
		3525 -> 3526;
		3525 -> 3528;
	3527 [label="Vay canına, eviniz bir yandan araştırma kuruluşu, bir yandan da fırlatma rampasıymış.",shape=box,color=red];
		3527 -> 3530;
	3526 [label="Onlarla konuşmak çok büyüleyici olmalı.",shape=box,color=red];
		3526 -> 3529;
	3528 [label="Zeki insanlara benziyorlar. O ortamda büyümek inanılmaz olmalı.",shape=box,color=red];
		3528 -> 3529;
	3530 [label="haha pek sayılmaz. çoğunlukla, sadece sessizdi.",shape=box,color=blue];
		3530 -> 3531;
	3529 [label="evet, sanırım öyle",shape=box,color=blue];
		3529 -> 3532;
	3531 [label="konuşmalarımla konuşmalarımızın çoğu \"merhaba tatlım\" ve \"merhaba\" şeklindeydi. sonra geç saatlere kadar çalışmak için ofise giderken dışarıda yemek yerdik ya da onun gibi bir şey",shape=box,color=blue];
		3531 -> 3533;
	3532 [label="ama mutfakta birbirimizin yanından geçerken konuşmalarımızın çoğu sadece \"merhaba tatlım\" ve \"merhaba\"dan ibaretti. hemen bir şeyler atıştırıp ofislerine geri döner ve geç saatlere kadar çalışırlardı",shape=box,color=blue];
		3532 -> 3533;
	3533 [label="meşguldüler",shape=box,color=blue];
		3533 -> 3534;
	3534 [label="başım belaya sokmadığım sürece, benim için endişelenecekleri bir şey yoktu. ve içimdeki tüm ateşe rağmen, başımı belaya sokmamakta gerçekten iyiydim.",shape=box,color=blue];
		3534 -> 3535;
		3534 -> 3536;
		3534 -> 3537;
	3535 [label="Anlıyorum. Annem ve babam da her zaman meşguldü. Zariman gemisini işletmek herkes için tam zamanlı bir işti. Yine de, en azından birlikte yemek yemek için her zaman vakit bulurduk.",shape=box,color=red];
		3535 -> 3538;
	3536 [label="Mantıklı. İş seni bu kadar zorladığında geriye pek fazla zaman kalmıyor ama eminim ki seni sürekli düşünüyorlardır.",shape=box,color=red];
		3536 -> 3539;
	3537 [label="Onları suçlayamam. Kendi deneyimlerimden biliyorum ki uzay yolculuğu sana boş zaman için pek yer bırakmıyor. Görünüşe göre dikkat çekmeyerek onların hayatını kolaylaştırmışsın.",shape=box,color=red];
		3537 -> 3540;
