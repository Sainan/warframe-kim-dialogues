	3563 [label="Tamamdır. Ama şimdi bu konuda kendini kötü hissederek fazla zaman kaybetme. Onlar seçimlerini yaptı ve sen de seçimini yaptın. Sana verdiklerine bakılırsa iyi gidiyorsun.",shape=box,color=red];
		3563 -> 3564;
