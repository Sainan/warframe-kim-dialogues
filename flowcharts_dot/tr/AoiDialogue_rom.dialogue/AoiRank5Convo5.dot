		3543 -> 3546;
	3544 [label="aslında evet, sanırım öyle:)",shape=box,color=blue];
		3544 -> 3546;
	3546 [label="Ailemin neden işlerine bu kadar odaklandıklarını anlıyorum. kendilerince, sevgilerini gösterme biçimleriydi. bana destek olmak ve insanlığın daha iyi bir geleceğe sahip olmasına yardımcı olabilecek teknolojiyi geliştirmek istiyorlardı",shape=box,color=blue];
