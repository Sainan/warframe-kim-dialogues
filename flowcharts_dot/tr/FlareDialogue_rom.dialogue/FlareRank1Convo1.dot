		18 -> 20;
	19 [label="ah, sol aşkına, asla. bu izlenimi verdiğim için üzgünüm. yine de sanırım haklısın. biz protoframeler şehirdeki tek bilim deneyi değiliz, değil mi?",shape=box,color=blue];
