digraph {
	0 [label="LoidRank1Convo1 begins.",color=orange];
		0 -> 1;
	1 [label="Gezgin. Sizi böyle rahatsız ettiğim için beni mazur görün, bu cihazı kullanarak sizinle iletişime geçmek istemezdim. Ama bu acil bir durum ve başka kime başvurabileceğimi bilmiyordum.",shape=box,color=blue];
