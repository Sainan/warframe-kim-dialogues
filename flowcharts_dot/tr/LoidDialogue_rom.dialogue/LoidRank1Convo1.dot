	2 [label="POM2_LAB1?",shape=box,color=red];
		2 -> 4;
	3 [label="Kimsiniz...?",shape=box,color=red];
		3 -> 4;
	4 [label="Ah, evet. Profil halen daha varsayılan ayarlarda. Ben Loid. Aslında... bunu ilk mesajımda belirtmem gerekirdi ama Sanctum Anatomica'daki işler son zamanlarda iyice kaotik bir hal aldı.",shape=box,color=blue];
		4 -> 5;
	5 [label="İşte bu yüzden sizinle iletişime geçiyorum. Yardımınıza ihtiyacım var. Benim zamanıma, Sanctum'a üç protoframe geldi. Ve bunlar daha önce bildiğimiz türden değiller.",shape=box,color=blue];
		5 -> 6;
	6 [label="Onlardan birisi",shape=box,color=blue];
		6 -> 7;
	7 [label="Affınıza sığınıyorum",shape=box,color=blue];
		7 -> 8;
	8 [label="Gezgin, onların birisi Orokin.",shape=box,color=blue];
		8 -> 9;
		8 -> 10;
		8 -> 11;
	9 [label="Lotus nerede?",shape=box,color=red];
		9 -> 12;
	10 [label="Eyvah... ",shape=box,color=red];
		10 -> 13;
	11 [label="Ne?!",shape=box,color=red];
		11 -> 13;
	12 [label="Lotus ve Operatör'ün ilgilenmesi gereken başka meseleler var, bana inanın. Zaten sınırlarına kadar yeterince zorlandılar. Bu konuda başvuracak başka birisi olsaydı sizi rahatsız etmezdim, ancak yardım edebilecek bir tek siz varsınız.",shape=box,color=blue];
		12 -> 14;
	13 [label="Bu konuda başvuracak başka birisi olsaydı sizi rahatsız etmezdim, ancak yardım edebilecek bir tek siz varsınız. Tanıdıklarım arasında siz... bu konuda uzmanlığa sahip tek kişisiniz.",shape=box,color=blue];
		13 -> 15;
	14 [label="Tanıdıklarım arasında siz... bu konuda uzmanlığa sahip tek kişisiniz.",shape=box,color=blue];
		14 -> 15;
	15 [label="Onları nasıl tarif edeceğimi bilemiyorum. Ama Sanctum'a gelirseniz, onları fark etmemeniz zor olacaktır. İkisi sizinle POM-2 aracılığıyla konuşmayı kabul etti. Diğerinin ise bu konu için ikna edilmesi gerekebilir.",shape=box,color=blue];
		15 -> 16;
	16 [label="Size inanıyorum... başarılı olacaksınızdır.",shape=box,color=blue];
