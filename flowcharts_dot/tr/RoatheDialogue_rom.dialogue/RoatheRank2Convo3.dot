		j334573780 -> j4200478065;
	j1998508722 [label="İşte çabanın amacı tam da buydu! Böylesine saf bir gücü hissetmenin nasıl bir şey olduğunu tarif edemem. Hayır, bundan daha fazlasıydı; gerçek bir güçtü. O dönen, karanlık bulutlara baktım ve atalarımın çaresizce elde etmeye çalıştığı şeyi gördüm.",shape=box,color=blue];
		j1998508722 -> j2363233194;
