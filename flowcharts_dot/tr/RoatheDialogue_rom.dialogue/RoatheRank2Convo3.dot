	j2322002420 [label="Kendi tehlikesini yaratmaya başlayan bir tür can sıkıntısına yol açar: Gaspçı. Politika. Saray entrikası. Birdenbire, eskileri değiştirdiğimiz için kendimizi tehlikeye atmanın ustaca yeni yollarını icat etmeye başladık.",shape=box,color=blue];
