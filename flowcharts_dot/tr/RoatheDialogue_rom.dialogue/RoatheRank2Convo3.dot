		j3854543037 -> j1661719052;
	j1692250820 [label="“Gaule”daki istem dışı kalışımın ilginç veya hoş yanları çok azdı. Yemekler bunlardan biriydi. İkincisi ise fırtınalardı.",shape=box,color=blue];
		j1692250820 -> j1480662695;
