		j2264919397 -> j21824964;
	j2566861793 [label="Sanki ben bu kelimeleri en ufak bir düşünce bile harcamamışım gibi yazıyorsun. Eğer sorduğun buysa, onlar beni takip etmediler. Rahip, yıldırım çarpmasıyla kendimi öldürmemi pek umursamadı, eminim. Peki ya Marie? Muhtemelen sahte putlarına tapmakla çok meşguldü. Sol veya Albrecht, hangisini istersen.",shape=box,color=blue];
