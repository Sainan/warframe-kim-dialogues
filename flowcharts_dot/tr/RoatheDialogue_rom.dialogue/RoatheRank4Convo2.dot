		j1787427475 -> j1133827026;
	j3089770746 [label="Onları öldürmenin bir anlamı olmazdı. Değil mi? Beni aksi yönde mi ikna etmeye çalışıyorsun? Gaspçı, etkilendim - senin bu kadar sinsi bir canavar olduğunu hiç düşünmemiştim!",shape=box,color=blue];
