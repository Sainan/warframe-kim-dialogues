		j2463710150 -> j270198538;
	j752607963 [label="Belki de akıllanıp fikrini değiştirmeni umuyorum. Ve eğer çevrede herkesi katletmiş olursam, bunun olasılığı önemli ölçüde azalır, değil mi?",shape=box,color=blue];
		j752607963 -> j988330965;
	j2368888935 [label="Zaten bunu yapmak hiçbir işe yaramaz, değil mi? Savaştan öğrenebileceğin tek bir şey varsa, o da cinayetin sonunda şaşırtıcı derecede az şey başardığıdır.",shape=box,color=blue];
		j2368888935 -> j3253758545;
	j4156010719 [label="Ve eğer civardaki herkesi katletmeye kalkışırsam, bunun olasılığı önemli ölçüde azalır, değil mi? Savaştan öğrenebileceğin tek bir şey varsa, o da cinayetin sonunda şaşırtıcı derecede az şey başardığıdır.",shape=box,color=blue];
