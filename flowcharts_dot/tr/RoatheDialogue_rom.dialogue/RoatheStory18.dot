	j739961370 [label="SM: İHANET",shape=box,color=blue];
		j739961370 -> j3068392347;
	j3068392347 [label="Transkript: “Barış mı?”",shape=box,color=blue];
		j3068392347 -> j10158564;
	j10158564 [label="Sesi kulaklarımda kırık cam gıcırdamaları gibiydi.",shape=box,color=blue];
		j10158564 -> j1142921896;
	j1142921896 [label="İnfazcı Nitokh hoşnutsuzdu. Savaş üstüne savaş, görkemli bir tırmanış ve doruk noktasındaki coşkuda Orokin'in ölümüyle sonuçlanacak bir şeyi bekliyordu.",shape=box,color=blue];
		j1142921896 -> j898877396;
	j898877396 [label="Ardından saklandığı yerden çıkacak ve… eh, bu noktadan sonrası tamamen spekülasyona kalıyor. Belki de Sentient'lerin yanına davet edilmeyi bekliyordu.",shape=box,color=blue];
		j898877396 -> j1175665575;
	j1175665575 [label="Ya da belki de Origin Sistemi'nin kavrulmuş, kirlenmiş kalıntılarını terk edip, kendi krallığını kurmasına izin vereceklerini düşünmüştü.",shape=box,color=blue];
		j1175665575 -> j1577518639;
	j1577518639 [label="Ne olursa olsun barışa tahammül edilemezdi. Bu yüzden onu baltalamak için çalışmaya koyulduk.",shape=box,color=blue];
		j1577518639 -> j921430358;
	j921430358 [label="Add 1 to HellStory counter",color=orange];
		j921430358 -> "Chat ends.";
}