	j3202598268 [label="Neden bunun cevabını zaten çok iyi bildiğini düşünüyorum, Gaspçım? Zihnimin parçalarını zaten didik didik ettiysen, bu kadar önemsiz şeyleri sorarak ne tür oyunlar oynuyorsun?",shape=box,color=blue];
