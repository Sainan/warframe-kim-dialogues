	j2749159337 [label="Sen de Albrecht kadar iğrençsin, etrafındakilerin zihinlerine karışıyorsun - onları oyuncak sanıyorsun! Söyle bakalım. Zaten cevapların varsa neden soruyorsun, ha?",shape=box,color=blue];
