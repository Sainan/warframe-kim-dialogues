		j3667261100 -> j326247480;
	j3800091968 [label="Hayır. Hayır, kesinlikle kendi isteğimle değildi. Şimdi, Orokin hakkında anlaman gereken bir şey var: Biz oyun oynarız... daha doğrusu, eskiden sık sık birbirimizle oyun oynardık. Her türden oyun. Politik, psikolojik, cinsel. Ne olduğu önemli değildi.",shape=box,color=blue];
