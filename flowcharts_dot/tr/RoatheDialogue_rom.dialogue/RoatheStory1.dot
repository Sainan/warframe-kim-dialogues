		j2331276866 -> j1318875346;
	j1318875346 [label="Onunla birlikteyken insan her zaman nerede durduğunu bilirdi - büyük uçurumun tam kenarında.",shape=box,color=blue];
		j1318875346 -> j706031837;
	j706031837 [label="Atla, dedi bana gözleri, devasa bir kozmik şakanın sevinciyle parlayarak.",shape=box,color=blue];
		j706031837 -> j4221573175;
	j4221573175 [label="Onun çılgın vizyonları sayesinde Orokin varoluşunun uzun, kasvetli durgunluğundan kaçabiliyordum.",shape=box,color=blue];
		j4221573175 -> j731793528;
	j731793528 [label="Yüzyıllar önce tüm duyularımız körelmişti. Ama o, hâlâ, kendi çapında, tazeydi.",shape=box,color=blue];
		j731793528 -> j2615108523;
	j2615108523 [label="Sonsuz. Açlığı sınırsız. Bir akşam beni banyosuna çağırdı. Parfümlü su ve kanın karıştığı su birikintilerinin üzerinden geçtim ve görev bilinciyle hazır ol pozisyonuna geçtim.",shape=box,color=blue];
		j2615108523 -> j985668433;
	j985668433 [label="\"Sıkıldım Roathe. Hadi diğer tüm Orokinleri öldürüp kontrolü ele geçirelim.\"",shape=box,color=blue];
		j985668433 -> j921430358;
