		j3591837742 -> j3312507277;
	j3312507277 [label="Transkript: Onun deliliği, bariz olduğu için baştan çıkarıcıydı.",shape=box,color=blue];
		j3312507277 -> j2669211230;
	j2669211230 [label="Onunla birlikteyken insan her zaman nerede durduğunu bilirdi - büyük uçurumun tam kenarında.",shape=box,color=blue];
		j2669211230 -> j608963817;
	j608963817 [label="Atla, dedi bana gözleri, devasa bir kozmik şakanın sevinciyle parlayarak.",shape=box,color=blue];
		j608963817 -> j431053206;
	j431053206 [label="Onun çılgın vizyonları sayesinde Orokin varoluşunun uzun, kasvetli durgunluğundan kaçabiliyordum.",shape=box,color=blue];
		j431053206 -> j608210486;
	j608210486 [label="Yüzyıllar önce tüm duyularımız körelmişti. Ama o, hâlâ, kendi çapında, tazeydi.",shape=box,color=blue];
		j608210486 -> j2337002419;
	j2337002419 [label="Sonsuz. Açlığı sınırsız. Bir akşam beni banyosuna çağırdı. Parfümlü su ve kanın karıştığı su birikintilerinin üzerinden geçtim ve görev bilinciyle hazır ol pozisyonuna geçtim.",shape=box,color=blue];
		j2337002419 -> j2918441811;
	j2918441811 [label="\"Sıkıldım Roathe. Hadi diğer tüm Orokin'leri öldürüp kontrolü ele geçirelim.\"",shape=box,color=blue];
		j2918441811 -> j921430358;
	j921430358 [label="Add 1 to HellStory counter",color=orange];
		j921430358 -> "Chat ends.";
