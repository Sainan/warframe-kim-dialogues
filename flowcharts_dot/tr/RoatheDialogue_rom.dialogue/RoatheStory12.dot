	j2855770722 [label="SM: ATEŞ",shape=box,color=blue];
		j2855770722 -> j2182341531;
	j2182341531 [label="Transkript: Ucubelik ve aşırılık geçmişte bize çok iyi hizmet etmişti. Bunları savaş taktiği olarak uygulamam bekleniyordu.",shape=box,color=blue];
		j2182341531 -> j4125432858;
	j4125432858 [label="Atalarımız zamanında istilayı nasıl kontrol altına almıştık? Elbette, atomun kalbini bir gül goncası gibi parçalayarak!",shape=box,color=blue];
		j4125432858 -> j3641839793;
	j3641839793 [label="Yedi'ler bir olarak, bana savaş başlıklı üç çatallı mızrağı olan bir şeytan, yaygın radyasyon dolu bir çantası olan bir tohum ekici olmamı emrettiler.",shape=box,color=blue];
		j3641839793 -> j240280540;
	j240280540 [label="İşte o gün, Sentient'lerin teknolojimizi sadece etkisiz hale getirmekle kalmayıp, aynı zamanda ele geçirebileceklerini de öğrendik.",shape=box,color=blue];
		j240280540 -> j1957950588;
	j1957950588 [label="Düşmana gönderdiğimiz dron sürüsü, hâlâ bombalarla dolu bir şekilde bilinmeyen hecelerle kıkırdayarak bize geri döndü ve onları gönderen ana gemilerin içinde patladı.",shape=box,color=blue];
		j1957950588 -> j921430358;
	j921430358 [label="Add 1 to HellStory counter",color=orange];
		j921430358 -> "Chat ends.";
}