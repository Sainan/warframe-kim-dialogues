	j3559508854 [label="SM: ATEŞ",shape=box,color=blue];
		j3559508854 -> j1144378091;
	j1144378091 [label="Transkript: Ucubelik ve aşırılık geçmişte bize çok iyi hizmet etmişti. Bunları savaş taktiği olarak uygulamam bekleniyordu.",shape=box,color=blue];
		j1144378091 -> j3883029436;
	j3883029436 [label="Atalarımız zamanında istilayı nasıl kontrol altına almıştık? Elbette, atomun kalbini bir gül goncası gibi parçalayarak!",shape=box,color=blue];
		j3883029436 -> j3029789850;
	j3029789850 [label="Yedi'ler bir olarak, bana savaş başlıklı üç çatallı mızrağı olan bir şeytan, yaygın radyasyon dolu bir çantası olan bir tohum ekici olmamı emrettiler.",shape=box,color=blue];
		j3029789850 -> j1812437993;
	j1812437993 [label="İşte o gün, Sentientlerin teknolojimizi sadece etkisiz hale getirmekle kalmayıp, aynı zamanda ele geçirebileceklerini de öğrendik.",shape=box,color=blue];
		j1812437993 -> j1957950588;
	j1957950588 [label="Düşmana gönderdiğimiz dron sürüsü, hâlâ bombalarla dolu bir şekilde bilinmeyen hecelerle kıkırdayarak bize geri döndü ve onları gönderen ana gemilerin içinde patladı.",shape=box,color=blue];
		j1957950588 -> j921430358;
	j921430358 [label="Add 1 to HellStory counter",color=orange];
		j921430358 -> "Chat ends.";
