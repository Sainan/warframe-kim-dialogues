	j3710899225 [label="SM: WARFRAMELER",shape=box,color=blue];
		j3710899225 -> j2745336231;
	j2745336231 [label="Transkript: İlk başta Warframeler meşru bir silahtan ziyade sanatsal bir ifade gibi görünüyordu.",shape=box,color=blue];
		j2745336231 -> j1108881670;
	j1108881670 [label="Savaş neredeyse kaybedilmişti; Sentientler yenilmezdi; o halde, bu tuhaf ve gerçeküstü savaşçıları yaratalım ve onları kadim kökenli silahlarla donatalım.",shape=box,color=blue];
		j1108881670 -> j1408522965;
	j1408522965 [label="En azından yenilgimiz güzel olsun. Unutulmaz olsun.",shape=box,color=blue];
		j1408522965 -> j4038499487;
	j4038499487 [label="Ancak tüm beklentilerin aksine, onlar galip geldi. Kısa süre sonra, cepheden inanılmaz derecede imkansız kahramanlık hikayeleri gelmeye başladı.",shape=box,color=blue];
		j4038499487 -> j432199228;
	j432199228 [label="Warframeler gökyüzünden belirmiş, melek gibi tutsakları kurtarıyor ve Sentient kalelerini yerle bir ediyordu. Tek başlarına bile mucizeydiler; gruplar halindeyse hepsi birer tanrıydı.",shape=box,color=blue];
		j432199228 -> j2933809940;
	j2933809940 [label="Bu halleriyle salt propaganda olarak görülmelerine şaşmamak gerek.",shape=box,color=blue];
		j2933809940 -> j921430358;
	j921430358 [label="Add 1 to HellStory counter",color=orange];
		j921430358 -> "Chat ends.";
