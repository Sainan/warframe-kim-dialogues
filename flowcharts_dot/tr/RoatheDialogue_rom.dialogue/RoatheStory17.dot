		j1494304099 -> j4011389081;
	j4011389081 [label="Transkript: İlk başta Warframe'ler meşru bir silahtan ziyade sanatsal bir ifade gibi görünüyordu.",shape=box,color=blue];
		j4011389081 -> j3952356277;
	j3952356277 [label="Savaş neredeyse kaybedilmişti; Sentient'ler yenilmezdi; o halde, bu tuhaf ve gerçeküstü savaşçıları yaratalım ve onları kadim kökenli silahlarla donatalım.",shape=box,color=blue];
		j3952356277 -> j3380065668;
	j3380065668 [label="En azından yenilgimiz güzel olsun. Unutulmaz olsun.",shape=box,color=blue];
		j3380065668 -> j2998873750;
	j2998873750 [label="Ancak tüm beklentilerin aksine, onlar galip geldi. Kısa süre sonra, cepheden inanılmaz derecede imkansız kahramanlık hikayeleri gelmeye başladı.",shape=box,color=blue];
		j2998873750 -> j2611404875;
	j2611404875 [label="Warframe'ler gökyüzünden belirmiş, melek gibi tutsakları kurtarıyor ve Sentient kalelerini yerle bir ediyordu. Tek başlarına bile mucizeydiler; gruplar halindeyse hepsi birer tanrıydı.",shape=box,color=blue];
		j2611404875 -> j2933809940;
	j2933809940 [label="Bu halleriyle salt propaganda olarak görülmelerine şaşmamak gerek.",shape=box,color=blue];
		j2933809940 -> j921430358;
	j921430358 [label="Add 1 to HellStory counter",color=orange];
		j921430358 -> "Chat ends.";
