		42 -> 48;
	43 [label="Albrecht şırıngayı boynuma saplayıp beni bu şeye dönüştürdüğünde başka bir şey daha yaptı. Orokinler arasındaki oyunlar bir şey. Ama bu? Bu tamamen bambaşka bir şey.",shape=box,color=blue];
