		j2794247209 -> j419288430;
		j2794247209 -> j458448127;
	j241535534 [label="Kararını verdin mi? Ben sabırlı bir şeytanım ama benim de sınırlarım var. Zihnimi bu anılardan temizleyecek misin, yoksa beni bu halde mi bırakacaksın?",shape=box,color=blue];
		j241535534 -> j1207475819;
		j241535534 -> j2955094433;
	j4041941772 [label="İşte buradayız ve burada kalacağız. Bu Araf'ta. Umarım burada olmaktan mutlusundur, çünkü bir adım daha ileriye gidebileceğimizi sanmıyorum.",shape=box,color=blue];
