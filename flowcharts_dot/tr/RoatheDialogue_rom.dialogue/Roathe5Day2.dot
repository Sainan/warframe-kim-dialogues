	j1630065469 [label="Yeni bir gün doğuyor ve kendimi uzun zamandır ilk kez... geleceğimi planlarken buluyorum. Etrafımdaki bu dünyayı nasıl yeniden şekillendirebileceğimi düşünüyorum. Bildiklerimi nasıl kullanabileceğimi. Olduğum kişiyi. Onu nasıl daha iyi kullanabileceğimi düşünüyorum.",shape=box,color=blue];
		j1630065469 -> j3984658869;
	j4156261449 [label="Yeni bir gün doğuyor ve kendimi uzun zamandır ilk kez... gelecek için plan yaparken buluyorum. Bunun benim için ne anlama geldiğini, ne istediğimi, çevremi kendime göre nasıl yeniden şekillendirmek istediğimi düşünüyorum.",shape=box,color=blue];
		j4156261449 -> j2558396776;
	j2794247209 [label="Tam olarak neyi beklediğini sorabilir miyim? Olayların hatıraları hâlâ eksiksiz bir şekilde aklımda, öylece burada oturuyorum. Onları zihnimden sileceğine dair bana söz vermiştin.",shape=box,color=blue];
