	j2730033718 [label="SM: TESLİMİYET",shape=box,color=blue];
		j2730033718 -> j1716147044;
	j1716147044 [label="Transkript: Hem savaş meydanında hem de yatak odasında zafere giden yolun görünüşte teslimiyetten geçtiğini en başından beri anlamıştım.",shape=box,color=blue];
		j1716147044 -> j1154490427;
	j1154490427 [label="Düşmanının bir sonraki baskısının, teslim olmana sebep olan zayıflıktan geleceğine emin olabilirsin; bu davranışı bilerek düşmanını kolayca tökezletebilirsin.",shape=box,color=blue];
		j1154490427 -> j1436381567;
	j1436381567 [label="Bana \"Yalaka,\" derlerdi. \"Kucak köpeği.\" Nitokh kontrolün kendisinde olduğunu düşünürdü. Ah, onu ne kadar da ustaca yönlendirmiştim.",shape=box,color=blue];
		j1436381567 -> j60839141;
	j60839141 [label="Kanlı elleriyle Roathe. Adamlarının cesetleriyle beslenen canavar Roathe. Hayatları israf eden Roathe.",shape=box,color=blue];
		j60839141 -> j110344528;
	j110344528 [label="Sanki sadece savaşmak için savaşmışım gibi! Hayır. Orokin İmparatorluğu sona ermeli.",shape=box,color=blue];
		j110344528 -> j1949351997;
	j1949351997 [label="Bunun olması için savaş devam etmeli. Sadece mutlak ve geri dönülmez bir yenilgi, altın yedili denen canavarı devirebilirdi.",shape=box,color=blue];
		j1949351997 -> j1880747681;
	j1880747681 [label="Nitokh bile benim gerçek duygularımı bilmiyordu. Onunla birlikte hüküm sürmeyi arzuladığımı sanıyordu",shape=box,color=blue];
		j1880747681 -> j921430358;
	j921430358 [label="Add 1 to HellStory counter",color=orange];
		j921430358 -> "Chat ends.";
}