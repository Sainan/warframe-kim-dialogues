	j2255948816 [label="SM: TESLİMİYET",shape=box,color=blue];
		j2255948816 -> j3775059645;
	j3775059645 [label="Transkript: Hem savaş meydanında hem de yatak odasında zafere giden yolun görünüşte teslimiyetten geçtiğini en başından beri anlamıştım.",shape=box,color=blue];
		j3775059645 -> j3756051039;
	j3756051039 [label="Düşmanının bir sonraki baskısının, teslim olmana sebep olan zayıflıktan geleceğine emin olabilirsin; bu davranışı bilerek düşmanını kolayca tökezletebilirsin.",shape=box,color=blue];
		j3756051039 -> j2833428928;
	j2833428928 [label="Bana \"Yalaka,\" derlerdi. \"Kucak köpeği.\" Nitokh kontrolün kendisinde olduğunu düşünürdü. Ah, onu ne kadar da ustaca yönlendirmiştim.",shape=box,color=blue];
		j2833428928 -> j3972159826;
	j3972159826 [label="Kanlı elleriyle Roathe. Adamlarının cesetleriyle beslenen canavar Roathe. Hayatları israf eden Roathe.",shape=box,color=blue];
		j3972159826 -> j1846681701;
	j1846681701 [label="Sanki sadece savaşmak için savaşmışım gibi! Hayır. Orokin İmparatorluğu sona ermeli.",shape=box,color=blue];
		j1846681701 -> j1700905056;
	j1700905056 [label="Bunun olması için savaş devam etmeli. Sadece mutlak ve geri dönülmez bir yenilgi, altın yedili denen canavarı devirebilirdi.",shape=box,color=blue];
		j1700905056 -> j3218408048;
	j3218408048 [label="Nitokh bile benim gerçek duygularımı bilmiyordu. Onunla birlikte hüküm sürmeyi arzuladığımı sanıyordu.",shape=box,color=blue];
		j3218408048 -> j921430358;
	j921430358 [label="Add 1 to HellStory counter",color=orange];
		j921430358 -> "Chat ends.";
}