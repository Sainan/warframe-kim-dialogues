	5722 [label="Düşmanının bir sonraki baskısının, teslim olmana sebep olan zayıflıktan geleceğine emin olabilirsin; bu davranışı bilerek düşmanını kolayca tökezletebilirsin.",shape=box,color=blue];
		5722 -> 5723;
	5723 [label="Bana \"Yalaka,\" derlerdi. \"Kucak köpeği.\" Nitokh kontrolün kendisinde olduğunu düşünürdü. Ah, onu ne kadar da ustaca yönlendirmiştim.",shape=box,color=blue];
		5723 -> 2310;
	2310 [label="Kanlı elleriyle Roathe. Adamlarının cesetleriyle beslenen canavar Roathe. Hayatları israf eden Roathe.",shape=box,color=blue];
		2310 -> 2314;
	2314 [label="Sanki sadece savaşmak için savaşmışım gibi! Hayır. Orokin İmparatorluğu sona ermeli.",shape=box,color=blue];
		2314 -> 5724;
	5724 [label="Bunun olması için savaş devam etmeli. Sadece mutlak ve geri dönülmez bir yenilgi, altın yedili denen canavarı devirebilirdi.",shape=box,color=blue];
		5724 -> 2316;
	2316 [label="Nitokh bile benim gerçek duygularımı bilmiyordu. Onunla birlikte hüküm sürmeyi arzuladığımı sanıyordu",shape=box,color=blue];
		2316 -> 2309;
