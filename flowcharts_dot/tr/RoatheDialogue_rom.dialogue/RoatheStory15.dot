		j367741909 -> j2157243455;
	j2157243455 [label="Transkript: Birçok silahımızda ustalıkla kullandım ama bir tanesini kullanmakta çok iyiydim: yalan söylemek.",shape=box,color=blue];
		j2157243455 -> j2494520033;
	j2494520033 [label="Bunu en çok kendi askerlerime karşı kullanıyordum. Görev ve disiplin yalanlarıyla onları iliklerine kadar şekillendiriyorum.",shape=box,color=blue];
		j2494520033 -> j518629070;
	j518629070 [label="Savaşı kazanabileceğimiz hakkında yalanlarla onları boğuyordum. Onlara olan tavrımın, en derin saygımın süslediği yalanlarla akıllarına sızdım.",shape=box,color=blue];
		j518629070 -> j2332566255;
	j2332566255 [label="Yalnız başıma, gizlice, o silahı kendime doğrulttum. Ah, nasıl da kanadım.",shape=box,color=blue];
