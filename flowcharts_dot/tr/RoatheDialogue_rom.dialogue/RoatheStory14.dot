	j2756120614 [label="SM: ADAPTASYON",shape=box,color=blue];
		j2756120614 -> j956007808;
	j956007808 [label="Transkript: Sentient'lerin çoğu karşılaşmalar arasında evrim geçirdi, bu yüzden aynı düşmanla iki kez karşılaşacağımızdan asla emin olamazdık. Ancak diğerleri, sanki uzun zaman önce bir platoya ulaşmışlar gibi, aynı formda kaldılar.",shape=box,color=blue];
		j956007808 -> j465474410;
	j465474410 [label="Mükemmel katiller olarak, bir köpekbalığının verdiği aynı soğuk dehşeti getirdiler.",shape=box,color=blue];
		j465474410 -> j975814136;
	j975814136 [label="Bu delilikti. Taktiklerimi mükemmelleştirir mükemmelleştirmez, yengeç gemileri solucan gemileriyle değiştirildiğinde, Sentient yengeç gemilerinin davranışlarına göre nasıl strateji geliştirebilirdim ki?",shape=box,color=blue];
		j975814136 -> j3008471348;
	j3008471348 [label="Peki bu solucan gemilerinin yerini ne kadar sürede yeni bir canavar alacaktı?",shape=box,color=blue];
		j3008471348 -> j3826861343;
	j3826861343 [label="Tek yapabildiğimiz geri çekilmekti. İlerlemek ölümcül bir hal almıştı. Eski gelenekler, zamanın kutsadığı onur ve disiplinin yolları, hak ettiğini bir şekilde elde etmeliydi.",shape=box,color=blue];
		j3826861343 -> j921430358;
	j921430358 [label="Add 1 to HellStory counter",color=orange];
		j921430358 -> "Chat ends.";
}