digraph {
	1995 [label="RoatheRank3Convo5 begins.",color=orange];
		1995 -> 1996;
	1996 [label="Albrecht en başından beri hep sorunluydu. O ve Void'le olan tüm bu meseleler. Sanırım ona Gerivaine verildi, çünkü bir aile kurmasının onu sakinleştireceği umuluyordu.",shape=box,color=blue];
		1996 -> 1997;
	1997 [label="Bence bu, işleri daha da kötüleştirdi. Çocuk sahibi olduktan sonra onları fazladan bir çift el olarak gördü. Çılgın deneylerinin suç ortakları olarak.",shape=box,color=blue];
		1997 -> 1998;
	1998 [label="Harcanabilir. Hayatındaki her şey gibi.",shape=box,color=blue];
		1998 -> 2001;
		1998 -> 2000;
		1998 -> 1999;
	2001 [label="Gerivaine mi?",shape=box,color=red];
		2001 -> 2004;
	2000 [label="İnsanları sadece harcanabilir varlıklar olarak görmüyor.",shape=box,color=red];
		2000 -> 2003;
	1999 [label="[Son.]",shape=box,color=red];
		1999 -> 2002;
	2004 [label="Zamanın kayıtlarında kaybolmuş bir isim... Albrecht Entrati'nin karısı, Gaspçı. Çocuklarının annesi.",shape=box,color=blue];
		2004 -> 2006;
	2003 [label="Tamam, hayatındaki herkesi ve her şeyi, herhangi bir İnfazcı'nın soğukluğuyla öldüreceğini kabul ediyorum. Ama bunu amaçsızca yapmayacak.",shape=box,color=blue];
		2003 -> 2005;
	2002 [label="Chat ends.",color=orange];
	2006 [label="Check boolean LoidFamilyComplete",color=orange];
		2006 -> 2009 [label=true,color=green];
		2006 -> 2010 [label=false,color=brown];
	2005 [label="Biliyor musun, şimdi düşününce, onu çağımızda bu kadar tehlikeli kılan şey, tarafsız yapısıydı. Hedeflerine ulaşmak uğruna her şeyi feda edebilirdi. Hem de her şeyi.",shape=box,color=blue];
		2005 -> 2007;
		2005 -> 2008;
	2009 [label="Ama işte yine beni aptal yerine koyuyorsun - çünkü bu bilgiyi zaten biliyor olma ihtimalin oldukça yüksek, çünkü uşak onlarla yeniden bağlantı kurdu.",shape=box,color=blue];
		2009 -> 2013;
	2010 [label="Bu çürüyen Sanctum'da varlığımızdan habersiz, mutlu bir şekilde oturanlar. Ki ben bunu hâlâ paha biçilmez buluyorum.",shape=box,color=blue];
		2010 -> 2005;
	2007 [label="Orokin'in değer verdiği şeyleri feda etmekten çekinmeyeceğini düşündüm. Hepiniz birbirinize karşı son derece acımasız görünüyordunuz.",shape=box,color=red];
		2007 -> 2011;
	2008 [label="Nasıl anlıyorsun?",shape=box,color=red];
		2008 -> 2012;
	2013 [label="Ama seninle bu konuda bir tartışmaya daha girmeyeceğim. Havamda değilim.",shape=box,color=blue];
		2013 -> 2005;
	2011 [label="Hiçbir şey bilmediğin bir konuda çok fazla varsayımda bulunmaya çok heveslisin, Gezgin.",shape=box,color=blue];
		2011 -> 2014;
	2012 [label="+10 Chemistry",color=orange];
		2012 -> 2015;
	2014 [label="Yoksa cildinde benim gözden kaçırdığım mavi bir leke mi var? Orokin miydin? Öyleyse, en içten ve samimi özürlerimi sunarım! ",shape=box,color=blue];
		2014 -> 2016;
		2014 -> 2017;
	2015 [label="Orokin'lerin tek yaptığı birbirlerini sırtından bıçaklamak ve öldürmek olduğu yönündeki yaygın kanı yanlış olabilir. Yanlış anlama, bu tür olaylar çok sık yaşanıyordu. Neredeyse ölümsüzdük, yapacak başka bir şeyimiz yoktu.",shape=box,color=blue];
		2015 -> 2018;
	2016 [label="Özür dilerim. Seni kırmak istememiştim. Dürüst olmak gerekirse, Orokin toplumuna dair pek bir şey hatırlamıyorum - dışarıda kalmıştım, sadece izliyordum.",shape=box,color=red];
		2016 -> 2019;
	2017 [label="Orokin toplumuyla ilgili hatırladıklarım pek iyi değilse özür dilerim. Çoğunlukla hoparlörlerden bana emirler yağdıran kaydedilmiş ifadeler. Bunlar, Void'de mahsur kalmadan önceydi...",shape=box,color=red];
		2017 -> 2020;
	2018 [label="Ama aynı zamanda son derece tutkulu bir halktık. Kimse Orokinler gibi sanat yapmıyordu. Kimse bizim gibi müzik, tiyatro veya şiir bestelemedi.",shape=box,color=blue];
		2018 -> 2021;
	2019 [label="Özrün kabul edildi. Bu seferlik. Etraftaki herkesten bu tür saygısızlıklarla yeterince uğraşıyorum. Ne kadar büyüleyici olsan da, herkesin iğne yastığı değilim. Zamanımı geçirmenin daha iyi yolları var.",shape=box,color=blue];
		2019 -> 2022;
	2020 [label="Update boolean RoatheInsulted",color=orange];
		2020 -> 2023;
	2021 [label="Ve hiç kimse, kalplerimiz bir başkasına aşık olduğunda bizim kadar derinden sevmedi.",shape=box,color=blue];
		2021 -> 2024;
	2022 [label="Nerede kalmıştım? Ah evet. Duygusuz Entrati'miz.",shape=box,color=blue];
		2022 -> 2015;
	2023 [label="Bu bir uyarı. Etraftaki herkesten bu tür saygısızlıklarla yeterince uğraşıyorum. Ne kadar büyüleyici olsan da, herkesin iğne yastığı değilim. Zamanımı geçirmenin daha iyi yolları var.",shape=box,color=blue];
		2023 -> 2022;
	2024 [label="Albrecht hariç herkes. Yaptığı her şey, etkileşimde bulunduğu herkes, sanki sevgili seriglass'ının bir parçası aracılığıyla görüyormuş gibiydi.",shape=box,color=blue];
		2024 -> 2025;
	2025 [label="Uzaklaştırılmış. Kopuk. İlgisiz. Etkilenmemiş. Gerivaine öldüğünde ve küçük kızını tek başına büyütmek zorunda kaldığında bile.",shape=box,color=blue];
		2025 -> 2026;
	2026 [label="Check boolean LoidFamilyComplete",color=orange];
		2026 -> 2028 [label=true,color=green];
		2026 -> 2027 [label=false,color=brown];
	2028 [label="Haklı olarak, muhtemelen kendisinden çok daha fazlasını başarmaya mahkûmdu. Eğer o, infested olduğu yere kök salmasaydı. Ne büyük israf.",shape=box,color=blue];
		2028 -> 2031;
		2028 -> 2032;
	2027 [label="Haklı olarak, muhtemelen şimdiye kadar başardığından çok daha fazlasını başarmaya mahkûmdu. Onun ve Entrati soyunun geri kalanının başına neler geleceğini görmek için sabırsızlanıyorum. Tüm... Infested ihtişamlarıyla.",shape=box,color=blue];
		2027 -> 2029;
		2027 -> 2030;
	2031 [label="Loid'i yukarı çıkmaya ikna edebildiğimize sevindim.",shape=box,color=red];
		2031 -> 2035;
	2032 [label="Bunu neden yaptığımızı hatırlayamadığını biliyorum ama Loid'i yukarı çıkarabilmemiz iyi bir şeydi.",shape=box,color=red];
		2032 -> 2036;
	2029 [label="Hala bunun en iyi fikir olup olmadığını merak ediyorum...",shape=box,color=red];
		2029 -> 2033;
	2030 [label="Eğer Loid'i yukarı çıkmaya ikna edebilirsek, o zaman ne yapmayı planlıyorsun?",shape=box,color=red];
		2030 -> 2034;
	2035 [label="Öyle diyorsun. Yine de orada aptal gibi durup onları koruyor, sanki olanları hatırlıyormuşum gibi yeniden bir araya gelme konusunda konuşmalarını dinliyorum. Bunun ne kadar tuhaf olduğunu biliyor musun?!",shape=box,color=blue];
		2035 -> 2039;
	2036 [label="Orada durup, o buluşmayı hatırlıyormuş gibi davranmak zorunda kalmanın ne kadar garip olduğunu biliyor musun? Hayatım boyunca bunu hatırlayamadığım halde?!",shape=box,color=blue];
		2036 -> 2039;
	2033 [label="Mm, büyük olasılıkla hayır. Merak ettim, Albrecht'in yeni adresi var mı acaba?",shape=box,color=blue];
		2033 -> 2037;
	2034 [label="Henüz karar vermedim. Belki de uzuvlarını kesip sıvı içinde saklamaya başlarım. Albrecht'in yeni adresi sizde yoktur, değil mi?",shape=box,color=blue];
		2034 -> 2038;
	2039 [label="Sanki bir galada duruyorsun ve yanına biri geliyor ve seni çok iyi tanıyor, ama sen onları en ufak bir şekilde hatırlamıyorsun, sanki hatırlıyormuşsun gibi konuşmaya devam etmek zorunda kalıyorsun!",shape=box,color=blue];
		2039 -> 2042;
	2037 [label="Hayır, neden?",shape=box,color=red];
		2037 -> 2040;
	2038 [label="Ne?!",shape=box,color=red];
		2038 -> 2041;
	2042 [label="Beni içine attığın cehennemin farkında mısın?! Hiç farkında mısın?! Orada ayakta durmak tam bir işkence ve hepsi senin suçun! ",shape=box,color=blue];
		2042 -> 2044;
	2040 [label="Yukarı çıktığımda, ailesinin uzuvlarını kesip, tek tek kavanozlara koyarak ona postayla göndermeye başlayacağımı düşünüyordum.",shape=box,color=blue];
		2040 -> 5776;
	2041 [label="+10 Chemistry",color=orange];
		2041 -> 2043;
	2044 [label="Bah, yeter artık. Bir içkiye ihtiyacım var.",shape=box,color=blue];
		2044 -> 2046;
	5776 [label="Ne?!",shape=box,color=red];
		5776 -> 2041;
	2043 [label="Sakin ol! Burada şaka kaldırabilen kimse yok mu?",shape=box,color=blue];
		2043 -> 2045;
	2046 [label="+10 Chemistry",color=orange];
		2046 -> 2048;
	2045 [label="Zaten kim benim için onları postayla gönderir ki?",shape=box,color=blue];
