	"RoatheRank3Convo5 begins." [color=orange];
		"RoatheRank3Convo5 begins." -> j214574241;
	j214574241 [label="Albrecht en başından beri hep sorunluydu. O ve Void'le olan tüm bu meseleler. Sanırım ona Gerivaine verildi, çünkü bir aile kurmasının onu sakinleştireceği umuluyordu.",shape=box,color=blue];
		j214574241 -> j1283945746;
	j1283945746 [label="Bence bu, işleri daha da kötüleştirdi. Çocuk sahibi olduktan sonra onları fazladan bir çift el olarak gördü. Çılgın deneylerinin suç ortakları olarak.",shape=box,color=blue];
		j1283945746 -> j1133437645;
	j1133437645 [label="Harcanabilir. Hayatındaki her şey gibi.",shape=box,color=blue];
		j1133437645 -> j2224023482;
		j1133437645 -> j3492810583;
		j1133437645 -> j2025973576;
	j2224023482 [label="Gerivaine mi?",shape=box,color=red];
		j2224023482 -> j486071965;
	j3492810583 [label="İnsanları sadece harcanabilir varlıklar olarak görmüyor.",shape=box,color=red];
		j3492810583 -> j986028955;
	j2025973576 [label="[Son.]",shape=box,color=red];
		j2025973576 -> "Chat ends.";
	j486071965 [label="Zamanın kayıtlarında kaybolmuş bir isim... Albrecht Entrati'nin karısı, Gaspçı. Çocuklarının annesi.",shape=box,color=blue];
		j486071965 -> j4103666644;
	j986028955 [label="Tamam, hayatındaki herkesi ve her şeyi, herhangi bir İnfazcı'nın soğukluğuyla öldüreceğini kabul ediyorum. Ama bunu amaçsızca yapmayacak.",shape=box,color=blue];
		j986028955 -> j2096231468;
	"Chat ends." [color=orange];
	j4103666644 [label="Check boolean LoidFamilyComplete",color=orange];
		j4103666644 -> j2250974512 [label=true,color=green];
		j4103666644 -> j3109743210 [label=false,color=brown];
	j2096231468 [label="Biliyor musun, şimdi düşününce, onu çağımızda bu kadar tehlikeli kılan şey, tarafsız yapısıydı. Hedeflerine ulaşmak uğruna her şeyi feda edebilirdi. Hem de her şeyi.",shape=box,color=blue];
		j2096231468 -> j4087325053;
		j2096231468 -> j3185772652;
	j2250974512 [label="Ama işte yine beni aptal yerine koyuyorsun - çünkü bu bilgiyi zaten biliyor olma ihtimalin oldukça yüksek, çünkü uşak onlarla yeniden bağlantı kurdu.",shape=box,color=blue];
		j2250974512 -> j7229386;
	j3109743210 [label="Bu çürüyen Sanctum'da varlığımızdan habersiz, mutlu bir şekilde oturanlar. Ki ben bunu hâlâ paha biçilmez buluyorum.",shape=box,color=blue];
		j3109743210 -> j2096231468;
	j4087325053 [label="Orokin'in değer verdiği şeyleri feda etmekten çekinmeyeceğini düşündüm. Hepiniz birbirinize karşı son derece acımasız görünüyordunuz.",shape=box,color=red];
		j4087325053 -> j1229782471;
	j3185772652 [label="Nasıl anlıyorsun?",shape=box,color=red];
		j3185772652 -> j1279817460;
	j7229386 [label="Ama seninle bu konuda bir tartışmaya daha girmeyeceğim. Havamda değilim.",shape=box,color=blue];
		j7229386 -> j2096231468;
	j1229782471 [label="Hiçbir şey bilmediğin bir konuda çok fazla varsayımda bulunmaya çok heveslisin, Gezgin.",shape=box,color=blue];
		j1229782471 -> j3522440339;
	j1279817460 [label="+10 Chemistry",color=orange];
		j1279817460 -> j3280828678;
	j3522440339 [label="Yoksa cildinde benim gözden kaçırdığım mavi bir leke mi var? Orokin miydin? Öyleyse, en içten ve samimi özürlerimi sunarım! ",shape=box,color=blue];
		j3522440339 -> j365996586;
		j3522440339 -> j1632284615;
	j3280828678 [label="Orokin'lerin tek yaptığı birbirlerini sırtından bıçaklamak ve öldürmek olduğu yönündeki yaygın kanı yanlış olabilir. Yanlış anlama, bu tür olaylar çok sık yaşanıyordu. Neredeyse ölümsüzdük, yapacak başka bir şeyimiz yoktu.",shape=box,color=blue];
		j3280828678 -> j2882906065;
	j365996586 [label="Özür dilerim. Seni kırmak istememiştim. Dürüst olmak gerekirse, Orokin toplumuna dair pek bir şey hatırlamıyorum - dışarıda kalmıştım, sadece izliyordum.",shape=box,color=red];
		j365996586 -> j414512347;
	j1632284615 [label="Orokin toplumuyla ilgili hatırladıklarım pek iyi değilse özür dilerim. Çoğunlukla hoparlörlerden bana emirler yağdıran kaydedilmiş ifadeler. Bunlar, Void'de mahsur kalmadan önceydi...",shape=box,color=red];
		j1632284615 -> j681828699;
	j2882906065 [label="Ama aynı zamanda son derece tutkulu bir halktık. Kimse Orokinler gibi sanat yapmıyordu. Kimse bizim gibi müzik, tiyatro veya şiir bestelemedi.",shape=box,color=blue];
		j2882906065 -> j3391365121;
	j414512347 [label="Özrün kabul edildi. Bu seferlik. Etraftaki herkesten bu tür saygısızlıklarla yeterince uğraşıyorum. Ne kadar büyüleyici olsan da, herkesin iğne yastığı değilim. Zamanımı geçirmenin daha iyi yolları var.",shape=box,color=blue];
		j414512347 -> j1326791467;
	j681828699 [label="Boolean RoatheInsulted is now true.",color=orange];
		j681828699 -> j628676738;
	j3391365121 [label="Ve hiç kimse, kalplerimiz bir başkasına aşık olduğunda bizim kadar derinden sevmedi.",shape=box,color=blue];
		j3391365121 -> j3156395553;
	j1326791467 [label="Nerede kalmıştım? Ah evet. Duygusuz Entrati'miz.",shape=box,color=blue];
		j1326791467 -> j3280828678;
	j628676738 [label="Bu bir uyarı. Etraftaki herkesten bu tür saygısızlıklarla yeterince uğraşıyorum. Ne kadar büyüleyici olsan da, herkesin iğne yastığı değilim. Zamanımı geçirmenin daha iyi yolları var.",shape=box,color=blue];
		j628676738 -> j1326791467;
	j3156395553 [label="Albrecht hariç herkes. Yaptığı her şey, etkileşimde bulunduğu herkes, sanki sevgili seriglass'ının bir parçası aracılığıyla görüyormuş gibiydi.",shape=box,color=blue];
		j3156395553 -> j1418234595;
	j1418234595 [label="Uzaklaştırılmış. Kopuk. İlgisiz. Etkilenmemiş. Gerivaine öldüğünde ve küçük kızını tek başına büyütmek zorunda kaldığında bile.",shape=box,color=blue];
		j1418234595 -> j1969269467;
	j1969269467 [label="Check boolean LoidFamilyComplete",color=orange];
		j1969269467 -> j1132016036 [label=true,color=green];
		j1969269467 -> j1547246345 [label=false,color=brown];
	j1132016036 [label="Haklı olarak, muhtemelen kendisinden çok daha fazlasını başarmaya mahkûmdu. Eğer o, infested olduğu yere kök salmasaydı. Ne büyük israf.",shape=box,color=blue];
		j1132016036 -> j1582364052;
		j1132016036 -> j1273473441;
	j1547246345 [label="Haklı olarak, muhtemelen şimdiye kadar başardığından çok daha fazlasını başarmaya mahkûmdu. Onun ve Entrati soyunun geri kalanının başına neler geleceğini görmek için sabırsızlanıyorum. Tüm... Infested ihtişamlarıyla.",shape=box,color=blue];
		j1547246345 -> j4212699320;
		j1547246345 -> j2711945639;
	j1582364052 [label="Loid'i yukarı çıkmaya ikna edebildiğimize sevindim.",shape=box,color=red];
		j1582364052 -> j906518588;
	j1273473441 [label="Bunu neden yaptığımızı hatırlayamadığını biliyorum ama Loid'i yukarı çıkarabilmemiz iyi bir şeydi.",shape=box,color=red];
		j1273473441 -> j4108834258;
	j4212699320 [label="Hala bunun en iyi fikir olup olmadığını merak ediyorum...",shape=box,color=red];
		j4212699320 -> j3170176234;
	j2711945639 [label="Eğer Loid'i yukarı çıkmaya ikna edebilirsek, o zaman ne yapmayı planlıyorsun?",shape=box,color=red];
		j2711945639 -> j3915123083;
	j906518588 [label="Öyle diyorsun. Yine de orada aptal gibi durup onları koruyor, sanki olanları hatırlıyormuşum gibi yeniden bir araya gelme konusunda konuşmalarını dinliyorum. Bunun ne kadar tuhaf olduğunu biliyor musun?!",shape=box,color=blue];
		j906518588 -> j272014778;
	j4108834258 [label="Orada durup, o buluşmayı hatırlıyormuş gibi davranmak zorunda kalmanın ne kadar garip olduğunu biliyor musun? Hayatım boyunca bunu hatırlayamadığım halde?!",shape=box,color=blue];
		j4108834258 -> j272014778;
	j3170176234 [label="Mm, büyük olasılıkla hayır. Merak ettim, Albrecht'in yeni adresi var mı acaba?",shape=box,color=blue];
		j3170176234 -> j449433314;
	j3915123083 [label="Henüz karar vermedim. Belki de uzuvlarını kesip sıvı içinde saklamaya başlarım. Albrecht'in yeni adresi sizde yoktur, değil mi?",shape=box,color=blue];
		j3915123083 -> j2950177152;
	j272014778 [label="Sanki bir galada duruyorsun ve yanına biri geliyor ve seni çok iyi tanıyor, ama sen onları en ufak bir şekilde hatırlamıyorsun, sanki hatırlıyormuşsun gibi konuşmaya devam etmek zorunda kalıyorsun!",shape=box,color=blue];
		j272014778 -> j1124310946;
	j449433314 [label="Hayır, neden?",shape=box,color=red];
		j449433314 -> j3267811840;
	j2950177152 [label="Ne?!",shape=box,color=red];
		j2950177152 -> j2812183497;
	j1124310946 [label="Beni içine attığın cehennemin farkında mısın?! Hiç farkında mısın?! Orada ayakta durmak tam bir işkence ve hepsi senin suçun! ",shape=box,color=blue];
		j1124310946 -> j3859426602;
	j3267811840 [label="Yukarı çıktığımda, ailesinin uzuvlarını kesip, tek tek kavanozlara koyarak ona postayla göndermeye başlayacağımı düşünüyordum.",shape=box,color=blue];
		j3267811840 -> j2950177152;
	j2812183497 [label="+10 Chemistry",color=orange];
		j2812183497 -> j521957921;
	j3859426602 [label="Bah, yeter artık. Bir içkiye ihtiyacım var.",shape=box,color=blue];
		j3859426602 -> j1933300832;
	j521957921 [label="Sakin ol! Burada şaka kaldırabilen kimse yok mu?",shape=box,color=blue];
		j521957921 -> j2612603862;
	j1933300832 [label="+10 Chemistry",color=orange];
		j1933300832 -> "Chat ends.";
	j2612603862 [label="Zaten kim benim için onları postayla gönderir ki?",shape=box,color=blue];
		j2612603862 -> "Chat ends.";
