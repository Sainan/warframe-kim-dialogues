	1343 [label="O serumu isteyerek almış olabilirim - ama o iki nankörün her saat başı bana nutuk atması için anlaşma yapmadığımı biliyorum.  ",shape=box,color=blue];
		1343 -> 1344;
	1342 [label="Böyle olmamın suçlusu Albrecht! Burada onlarla sıkışıp kalmamın suçlusu benim değil, onun suçu! Bu iğrenç düzende benim hiçbir suçum yok!",shape=box,color=blue];
		1342 -> 1344;
