		1410 -> 1419;
	1411 [label="Entrati, ona \"vizyonlarının\" Lua'nın değil, Kayıtsızlık'ın ürünü olduğunu söyledi. Bu da onu bir tür \"inanç krizine\" sürüklüyor.",shape=box,color=blue];
		1411 -> 1420;
