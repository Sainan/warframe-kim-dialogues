	1389 [label="Senin bağlamın bizimkinden farklıydı. Ve bizim acımasız ve korkunç olarak gördüğümüz şeyleri, sen dünyanın işleyişinin bir parçası olarak görmeye alışmıştın.",shape=box,color=red];
		1389 -> 1402;
	1390 [label="Yine de yaptığın her şeyi mazur göstermez - trajediler trajedidir, dehşetler dehşettir. Ama sen çabaladın.",shape=box,color=red];
		1390 -> 1403;
	1391 [label="Benim bakış açımdan, sen bir savaşın içindeydin ve bir yandan tüm sistemi yıkmayı planlarken, diğer yandan sosyopatlardan oluşan bir toplumda yolunu bulmaya çalışıyordun. Ve onlar bunun için sana şeytan damgası vurdular. Bence bu adil değil.",shape=box,color=red];
		1391 -> 1404;
