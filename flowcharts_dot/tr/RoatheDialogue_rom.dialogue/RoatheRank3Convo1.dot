		1392 -> 1405;
	1393 [label="Başarısız olduğun için.",shape=box,color=red];
		1393 -> 1405;
	1394 [label="Orokin İmparatorluğu için özür dilemeyeceğim, çünkü ben onun yaratıcısı değil, sadece bir sakiniydim. Ama etrafımdakileri yıkmayı planladığım için de kendimi suçlamayacağım. Başımıza gelenleri, hatta daha kötüsünü hak ettik.",shape=box,color=blue];
		1394 -> 1406;
	1395 [label="Her durum \"farklı bir durumdur\", Gaspçı. Bağlam her zaman belirleyicidir. Ve sen \"Eski Savaş\"ı sadece geriye dönüp bakmanın netliğiyle değerlendiriyorsun.",shape=box,color=blue];
		1395 -> 1407;
	1396 [label="O zaman sana çok acıyorum, Gaspçı, ve sana ya üzerine düşen görevi kabul etmeni ya da bu hayattan çekilip çiftçilikle uğraşmanı öneriyorum.",shape=box,color=blue];
		1396 -> 1408;
	1397 [label="Mm. Tuşlarına basıp seni sinirlendirdiğimi bu kadar net bir şekilde göstermeni seviyorum, bu çok harika ve lezzetli. Konuşmayı kötü saptırıyorsun.",shape=box,color=blue];
		1397 -> 1409;
	1398 [label="Bana bak, Gaspçı. Ne olduğumu gör. İmparatorluğundan uzaklaştırılmış bir Orokin.",shape=box,color=blue];
		1398 -> 1410;
	1399 [label="Ve sonunda affetmenin ne anlamı var ki? Kimden affedilmeye çalışmalıyım? Diğerlerinden mi? Bir tür lanet olmaktan kurtulmak için mi?",shape=box,color=blue];
		1399 -> 1398;
	1400 [label="Ve ben de tam olarak ona yardım etmeye çalışıyordum! Sadece Kayıtsızlık ve Entrati'nin ona söyledikleriyle ilgili yaşadığı belirsizlik konusunda ona yardımcı olmaya çalışıyorum.",shape=box,color=blue];
		1400 -> 1411;
	1401 [label="Sinir bozucu uçan sivrisinek sana ne derse desin, kesinlikle hiçbir zararı yoktur. Ben sadece Kayıtsızlık ve Entrati'nin ona söyledikleriyle ilgili yaşadığı belirsizlik konusunda ona yardımcı olmaya çalışıyorum.",shape=box,color=blue];
