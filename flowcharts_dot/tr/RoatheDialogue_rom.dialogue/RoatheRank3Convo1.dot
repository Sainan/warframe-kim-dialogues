	1337 [label="Onunla anlaşamıyor musun?",shape=box,color=red];
		1337 -> 1340;
	1336 [label="Marie ve Lyon'a biraz daha nazik davransaydın, onlar da sana daha nazik davranabilirlerdi.",shape=box,color=red];
		1336 -> 1339;
	1335 [label="[Son.]",shape=box,color=red];
		1335 -> 1338;
	1340 [label="O, benim kim olduğumu ve nereden geldiğimi biraz daha anlamaya çalışsaydı, onunla daha iyi “anlaşabilirdim”. Ben neysem oyum. Ve yüzyıllardır da öyleyim. Sırf onlar şimdi bunu istiyor diye değişmeyi beklemiyorum.",shape=box,color=blue];
		1340 -> 1341;
	1339 [label="Peki ya bana karşı gösterdikleri nezaket, Gaspçı? Ben neysem oyum. Yüzyıllardır da öyleyim. Şimdi onlar talep ettikleri için değişmeyi beklemiyorum.",shape=box,color=blue];
