	1428 [label="Ve bunun onun için işleri daha iyi hale getireceğini mi düşünüyorsun?",shape=box,color=red];
		1428 -> 1435;
	1429 [label="Ama bu tür meseleler... karmaşıktır. Bunu görebilmeni takdir ediyorum. Bah. Uşak bana bakıyor. Bu konuşmayı bitirmem gerek. Yakında tekrar konuşuruz.",shape=box,color=blue];
