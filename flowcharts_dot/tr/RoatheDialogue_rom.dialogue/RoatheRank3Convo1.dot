		1438 -> 1441;
	1439 [label="Lyon'un çevresindeki insanların onu kullanıp manipüle etmelerini görmek beni öfkelendiriyor, bunu yaptıklarının farkında olsunlar ya da olmasınlar. Hepsi ''din'' ve ''inanç'' adına.",shape=box,color=blue];
		1439 -> 1440;
	1440 [label="Olan bitenin kayıtlarını okudum. Bu... \"Red Veil\", yüzyıllar boyunca Harrow'un içinde mahsur kalan o Tenno'yu çıkarmaya çalışabilirdi. Ama yapmadılar. Onu çürümeye ve ölmeye bıraktılar.",shape=box,color=blue];
		1440 -> 1442;
