digraph {
	1333 [label="RoatheRank3Convo1 begins.",color=orange];
		1333 -> 1334;
	1334 [label="Sonunda sevgili Lyon'la konuşuyor musun? Yoksa hala sana soğuk mu davranıyor? Dürüst olmak gerekirse, güvenli bir mesafe bırakman daha iyi olabilir.",shape=box,color=blue];
