		1349 -> 1352;
	1350 [label="''Yardım.'' Evet. ''Yardım.'' Onların ''yardım'' tarzını son derece ''yararsız'' bulduğum için özür dilerim.",shape=box,color=blue];
		1350 -> 1353;
	1351 [label="Evet, işin trajedisi de bu. Gerçekten de \"iyilik\" yapmaya çalıştıklarına inanıyorlar.",shape=box,color=blue];
		1351 -> 1354;
	1352 [label="Kim tarafından affedilmek? Sen mi? Onlar mı? Uşak mı? Albrecht mi? Yoksa \"tanrılar mı?\"",shape=box,color=blue];
