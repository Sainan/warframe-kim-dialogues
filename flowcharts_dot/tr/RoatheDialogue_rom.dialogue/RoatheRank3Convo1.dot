		1442 -> 1444;
		1442 -> 1445;
	1443 [label="Chat ends.",color=orange];
	1444 [label="Rell'in fedakarlığının boşa gittiğini mi düşünüyorsun?",shape=box,color=red];
		1444 -> 1446;
	1445 [label="Rell, tüm bu yıllar boyunca bu şeyin önündeki tek engeldi.",shape=box,color=red];
		1445 -> 1447;
	1446 [label="Hayır. O bir şeye karşı kendini koruyordu. Ama durumu ne kadar kötüleştirdiğini kim bilebilir? Bunca yüzyıl boyunca kendi korku ve endişesiyle bu şeyi ne kadar beslediğini kim bilebilir?",shape=box,color=blue];
		1446 -> 1448;
	1447 [label="Ya da onu besleyen tek şey oydu, bütün o yıllar boyunca.",shape=box,color=blue];
		1447 -> 1448;
	1448 [label="Kavramsal bütünlük, yalnızca yaratması için kendisine verilen şeyi tezahür ettirir. Void ise yalnızca dikmesi için kendisine verilen kumaşla çalışabilir.",shape=box,color=blue];
		1448 -> 1449;
	1449 [label="Bu Tenno, bu varoluşa tek başına ne kadar çok şey katmış olabilir? O, ıstırap, acı, ihanet, keder ve yalnızlığın gerçek bir simgesiydi...",shape=box,color=blue];
		1449 -> 1450;
	1450 [label="Ve o yerde binlerce yıl yalnız başına geçirdiği, Hiçliğe seslendiği zamanlarda hissettiği uyuşukluk. Bunun ardından gelen şey, Kayıtsızlık değilse nedir?",shape=box,color=blue];
		1450 -> 1451;
		1450 -> 1452;
