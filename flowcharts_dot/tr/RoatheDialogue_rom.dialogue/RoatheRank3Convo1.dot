		1408 -> 1417;
	1409 [label="Yine de, yüzyıllar boyunca tek başına, hikaye kitabındaki hayali karakterlerden başka konuşacak kimsesi olmayan birinin sosyal becerilerini geliştirme fırsatları sınırlı kalır diye düşünüyorum.",shape=box,color=blue];
		1409 -> 1418;
