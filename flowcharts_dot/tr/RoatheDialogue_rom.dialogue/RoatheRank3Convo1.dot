	1360 [label="Söyler misin lütfen. ",shape=box,color=blue];
		1360 -> 1368;
		1360 -> 1369;
		1360 -> 1370;
	1361 [label="Orokin toplumu için özür dilemeyeceğim, çünkü yaratıcısı ben değildim. Sadece bir sakiniydim. Ve eğer sadece içine doğdukları bir sistemde yer alan herkesi suçlayacaksan, kibirli ve kendini beğenmiş tavrınla milyarlarca insanı mahkûm etmiş olursun. Peki ya geri kalanı?",shape=box,color=blue];
		1361 -> 1371;
	1362 [label="Peki ya öyleysem? Artık onları değiştiremem. Suçluluk duymak neye yarar?",shape=box,color=blue];
		1362 -> 1372;
		1362 -> 1373;
	1363 [label="İkisi arasında rahibi tercih ettiğimi itiraf etmeliyim. Mantığını dinliyor. Kayıtsızlığın gerçek bir tanrı olmadığı gerçeğini anlayabilir.",shape=box,color=blue];
		1363 -> 1374;
	1364 [label="İnsanlara zarar veren eylemlerimiz üzerinde düşünmeye ve bunları nasıl düzeltebileceğimizi anlamaya çalışmanın değerli olduğunu düşünüyorum. Ama bence bu ikisi hiç de doğru yoldan gitmiyorlar.",shape=box,color=red];
		1364 -> 1375;
	1365 [label="Sonuçta, kendinden başka kimseyi affetmene gerek olduğuna inanmıyorum. Yaptığın işlerden memnunsan, gerisi önemli değil.",shape=box,color=red];
		1365 -> 1376;
	1366 [label="Orokin davranışlarının çoğunun... normal, beklenen bir şey olduğu bir toplumda doğdun. Senin için \"yanlış\" değildi. Bunun normal olduğunu söylemiyorum, sadece anlaşılabilir olduğunu düşünüyorum.",shape=box,color=red];
		1366 -> 1377;
	1367 [label="Orokin'i devirmeyi planlıyordun. Yozlaşmış olduklarını biliyordun ve onları düzeltmeye çalışıyordun.",shape=box,color=red];
		1367 -> 1378;
	1368 [label="Kendin.",shape=box,color=red];
		1368 -> 1379;
	1369 [label="İhanet etmek üzere olduğun kendi halkın.",shape=box,color=red];
