	1431 [label="Chat ends.",color=orange];
	1432 [label="Suçluluk duygusu, gece vakti gelip seni değer verdiğin her şeyden mahrum bırakacak bir haindir. Sana sadece zarar verir.",shape=box,color=blue];
		1432 -> 1438;
	1433 [label="Chat ends.",color=orange];
	1434 [label="Dinlemeyi reddetmedi. Bana susmamı söylemedi. Bana susmamı söyleseydi, susardım.",shape=box,color=blue];
		1434 -> 1439;
	1435 [label="Dindarların onu sadece yapabildikleri için manipüle etmeleri mi daha iyi? Ona yardım etmek yerine, halüsinasyonlarını işaret edip ''vizyonlar'' olarak adlandırmaları mı daha iyi?",shape=box,color=blue];
