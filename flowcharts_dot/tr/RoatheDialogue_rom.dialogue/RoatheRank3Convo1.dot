		1370 -> 1371;
	1371 [label="Bu bir savaştı. Ve savaşın doğası gereği, savaştığın düşmanları büyük sayılarda öldürmek gerekir. Öldürdüğün Grineer veya ''Corpus'' için ağlıyor musun yoksa?",shape=box,color=blue];
