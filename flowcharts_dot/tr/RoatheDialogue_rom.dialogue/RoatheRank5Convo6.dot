		j2541262298 -> j117538377;
	j4073561125 [label="Ailesinin onu sokağa attığını düşününce. O. Marie. O Marie. İnsanın sahip olabileceğinden daha fazla şefkate sahip olan Marie?!",shape=box,color=blue];
		j4073561125 -> j951327018;
