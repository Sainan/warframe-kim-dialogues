	j2750466622 [label="Marie hakkında ne mi düşünüyorum? Seni, onun bir veya iki gece bizimle kalması için ikna etmeye çalıştığım dışında mı sevgili Gezgin? (Şaka. Şaka.)",shape=box,color=blue];
		j2750466622 -> j2935097801;
	j19714629 [label="Marie hakkında ne mi düşünüyorum? Bir ya da iki gece size eşlik edeceğime sizi ikna etmeye çalışmam dışında mı? (Şaka. Şaka.)",shape=box,color=blue];
		j19714629 -> j2416310072;
	j4213514697 [label="Albrecht'in iyi niyetli olmadığı konusunda fikrini değiştirmesini sağladın mı? Sen gerçekten bir \"mucize'sin\". Belki de Sol ve Lua'ya değil, de sana tapınmaları gerekir.",shape=box,color=blue];
		j4213514697 -> j2809467304;
	j228914582 [label="Onun hala her gün acı çektiğini bilmiyordum. Sanki yokmuş gibi saklıyor. Sana söyleyene kadar bundan bahsetmedi. Aramızdaki bir tür boşluğu doldurdun.",shape=box,color=blue];
		j228914582 -> j2541262298;
	j3288305992 [label="Yakın zamana kadar onun çocukluğundan haberdar değildim. Sana anlatana kadar bana hikayesini hiç anlatmamıştı. Aramızdaki bir boşluğu doldurdun.",shape=box,color=blue];
		j3288305992 -> j4073561125;
	j3865442610 [label="Her zamanki gibi. Onu boğmak için çaresiz bir arzuyla, uyanık olduğum her anı yüzümü pençelerimle parçalamamak için uğraşarak geçiriyorum.",shape=box,color=blue];
		j3865442610 -> "Chat ends.";
	j2279313131 [label="Artık hayal kırıklıklarımı paylaşabileceğim biri olduğu için daha iyiyim. Ama cidden, aramızdaki gerginlikler çok azaldı.",shape=box,color=blue];
		j2279313131 -> j2374922143;
	j1304813809 [label="Lyon ile “iyi geçinen” kişi ben değilim, değil mi? Haha! Kötü şaka için özür dilerim. Kendimi tutamıyorum, sen de bunu çok kolaylaştırdın.",shape=box,color=blue];
		j1304813809 -> j3268986498;
	j851907907 [label="Seninle onun arasındaki ilişkiden daha iyi görünüyor. Onunla ilişkini nasıl mahvettin? O sadece dinleyecek birine ihtiyaç duyuyordu. ",shape=box,color=blue];
		j851907907 -> j3505204756;
	j507240344 [label="Aramızdaki gerginlik çok azaldı, özellikle de ona kendisini rahatsız eden şeyleri konuşacak özgüveni verdiğinden beri.",shape=box,color=blue];
		j507240344 -> j960232797;
