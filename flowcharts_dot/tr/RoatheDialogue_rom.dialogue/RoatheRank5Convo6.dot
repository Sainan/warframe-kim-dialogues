		j2511680780 -> j936067299;
	j1707713604 [label="Onları yavaş yavaş biraz daha tolere edilebilir bulduğumu itiraf etmeliyim. Bunun nedeni büyük ölçüde, yavaş yavaş benden vazgeçiyor olmaları.",shape=box,color=blue];
		j1707713604 -> j3324447381;
	j3511280082 [label="Onları yavaş yavaş biraz daha tolere edilebilir bulduğumu itiraf etmeliyim. Sanırım son zamanlarda edindiğim bilgilerin bununla bir ilgisi olabilir.",shape=box,color=blue];
		j3511280082 -> j3552976814;
	j2774117465 [label="Kendimi, Karanlık Refraktörü kullanarak anılarımı geri kazanamayacağımı, çünkü artık bir Protoframe olduğumu giderek daha fazla düşünürken buluyorum...",shape=box,color=blue];
		j2774117465 -> j4248418055;
	j2935097801 [label="Acaba benim onu kışkırtmamın, samimi bir rahatsızlıktan eğlenceli bir alaycılığa dönüştüğünü fark etmiş midir?",shape=box,color=blue];
		j2935097801 -> j3107707926;
	j2416310072 [label="İtiraf etmeliyim ki, seni hiçbir şekilde suçlamıyorum. Ve bunun sebebi sadece onun muhteşem görünmesi değil. Benim de gözlerim var. Bu kadın, onun yaşında benim mümkün olduğunu düşündüğümden daha fazla şefkat sahibi.",shape=box,color=blue];
		j2416310072 -> j2935097801;
	j2809467304 [label="Bah. Orokin İmparatorluğu'nun yükselişine yol açan da bu tür bir dil kullanımıydı. Bu, Sistem'in asla tekrarlamaması gereken bir hata.",shape=box,color=blue];
		j2809467304 -> j2935097801;
