digraph {
	5151 [label="RoatheRank5Convo8 begins.",color=orange];
		5151 -> 5152;
	5152 [label="Check boolean RoatheFailNot21",color=orange];
		5152 -> 5154 [label=true,color=green];
		5152 -> 5153 [label=false,color=brown];
	5154 [label="Evaluate expressions on HellStory",color=orange];
		5154 -> 5155 [label="x >= 21",color=purple];
		5154 -> 5156 [label="x <= 21",color=purple];
		5154 -> 5156 [label="false",color=purple];
	5153 [label="Chat ends.",color=orange];
	5155 [label="Seni ahmak! Ne yaptın sen?! Neden, neden istenmediğin mağaralara girip dalıyorsun?!",shape=box,color=blue];
		5155 -> 5157;
	5156 [label="Chat ends.",color=orange];
	5157 [label="Bunu düzeltmeni istiyorum. Bu senin hatan. Bunu hissedebiliyorum, beni tırmalıyor, parçalıyor. Büyük bir canavar gibi.",shape=box,color=blue];
		5157 -> 5158;
	5158 [label="Kurtar beni bundan. Kurtar beni bu beladan. Zihnimi bu anılardan temizle. Yapabileceğini biliyorum. Sahip olduğun bu yeteneği kullan ve her şeye son ver. Hemen.",shape=box,color=blue];
		5158 -> 5159;
		5158 -> 5160;
		5158 -> 5161;
	5159 [label="Emin misin? Ama... sen zekisin, bir şeylerin döndüğünü anlayacağın hissine kapılıyorum.",shape=box,color=red];
		5159 -> 5162;
	5160 [label="Onlar farklı türden birer anı, Roathe. Onlara işe yaramaz. Onlar ruhunun daha derinlerinde gömülü.",shape=box,color=red];
		5160 -> 5163;
	5161 [label="Gerçeklerden kaçıp saklanmak işe yaramayacak. Başladığımız yere geri döneceğiz. ",shape=box,color=red];
		5161 -> 5164;
	5162 [label="Büyük olasılıkla. İki ile ikiyi toplayıp, senden istemediğim bir şeyi yaptığın için seni suçlayacağım. Eminim bu fırtınayı atlatacaksın.",shape=box,color=blue];
		5162 -> 5165;
	5163 [label="Olabilir. Çok büyük ihtimalle haklısın. Ama deneyebileceğim başka seçeneğim yok, değil mi? Denemeye değer.",shape=box,color=blue];
		5163 -> 5165;
	5164 [label="Ve eğer durum buysa, o zaman aynı şeyi tekrar yapabilirsin. Sanki tükenmez bir yeteneğe sahipmişsin gibi, değil mi?",shape=box,color=blue];
		5164 -> 5165;
	5165 [label="Elbette, anılarımı değiştirdiğini fark ettiğimde sana çok kızacağımdan eminim. Ve bana bunun benim isteğim olduğunu söylememeni tavsiye ederim, canım.",shape=box,color=blue];
		5165 -> 5166;
	5166 [label="Sadece yalan söylediğini iddia edeceğim ve bu muhtemelen senin hakkındaki görüşümü onarılamayacak şekilde zedeleyecektir.",shape=box,color=blue];
		5166 -> 5167;
		5166 -> 5168;
	5167 [label="Hayır. Bunu yapamam. Bunu yapmayacağım. Bu durumla birlikte yüzleşmeliyiz. Bunu konuşsak olmaz mı?",shape=box,color=red];
		5167 -> 5169;
	5168 [label="Ben... başka yolu yok mu gerçekten?",shape=box,color=red];
		5168 -> 5169;
	5169 [label="Hayır. Uşağın yukarı çıkmasını istiyorsan? İstediğim gibi tüm bu saçmalıkları aklımdan sil. Umursamıyor musun? O zaman istediğini yap. Benim için fark etmez.",shape=box,color=blue];
		5169 -> 5170;
	5170 [label="Ve tabii ki kişisel dostluğumuz, bu durumda sahip olduğum tek koz. Bu kadar basit.",shape=box,color=blue];
		5170 -> 5171;
	5171 [label="Ne dersin?",shape=box,color=blue];
		5171 -> 5172;
		5171 -> 5173;
	5172 [label="Tamam. Yapacağım... Yapacağım. Zihnini sileceğim. Marie ve Lyon'un zihinleri de silinse bile.",shape=box,color=red];
		5172 -> 5174;
	5173 [label="Hayır, reddediyorum. Seni ilerlemeye ikna etmenin başka bir yolunu bulacağım.",shape=box,color=red];
		5173 -> 5175;
	5174 [label="+10 Chemistry",color=orange];
		5174 -> 5176;
	5175 [label="Sana bol şans diliyorum.",shape=box,color=blue];
		5175 -> 5179;
	5176 [label="Güzel. İşe başla. ",shape=box,color=blue];
		5176 -> 5178;
	5179 [label="Update boolean LyonRoatheRepair",color=orange];
		5179 -> 5177;
	5178 [label="Add 1 to Promise",color=orange];
		5178 -> 5180;
	5177 [label="Chat ends.",color=orange];
	5180 [label="Update boolean RoatheWillReset",color=orange];
		5180 -> 5181;
	5181 [label="Chat ends.",color=orange];
}