		j2195023799 -> j2111076353;
	j1270512225 [label="Kendi yolunu kendin mi çizmek istiyorsun? Kendin için mi? O zaman yap. Özür dileme. Ama bu senin seçmen gereken bir yol, başkasının değil.",shape=box,color=red];
		j1270512225 -> j770288698;
	j3674343813 [label="O öfkenin seni içten içe parçalamasına izin veriyorsun. Onu, bugün hâlâ bu dünyayı mahveden insanlarla savaşmana yardımcı olmak için kullanabilirsin. Hemen. Ve şimdi.",shape=box,color=red];
