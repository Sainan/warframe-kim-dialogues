	edge [fontname="Roboto Condensed"];

	"RoatheRank5Convo8 begins." [color=orange];
		"RoatheRank5Convo8 begins." -> j4125803273;
	j4125803273 [label="Check boolean RoatheFailNot21",color=orange];
		j4125803273 -> j1758133089 [label=true,color=green];
		j4125803273 -> "Chat ends." [label=false,color=brown];
	j1758133089 [label="Evaluate expressions on HellStory counter",color=orange];
		j1758133089 -> j2573741536 [label="x >= 21",color=purple];
		j1758133089 -> "Chat ends." [label="x <= 21",color=purple];
		j1758133089 -> "Chat ends." [label="false",color=purple];
	"Chat ends." [color=orange];
	j2573741536 [label="Seni ahmak! Ne yaptın sen?! Neden, neden istenmediğin mağaralara girip dalıyorsun?!",shape=box,color=blue];
		j2573741536 -> j2425428898;
	j2425428898 [label="Bunu düzeltmeni istiyorum. Bu senin hatan. Bunu hissedebiliyorum, beni tırmalıyor, parçalıyor. Büyük bir canavar gibi.",shape=box,color=blue];
		j2425428898 -> j3687413371;
	j3687413371 [label="Kurtar beni bundan. Kurtar beni bu beladan. Zihnimi bu anılardan temizle. Yapabileceğini biliyorum. Sahip olduğun bu yeteneği kullan ve her şeye son ver. Hemen.",shape=box,color=blue];
		j3687413371 -> j2497447698;
		j3687413371 -> j2688262228;
		j3687413371 -> j3900980940;
	j2497447698 [label="Emin misin? Ama... sen zekisin, bir şeylerin döndüğünü anlayacağın hissine kapılıyorum.",shape=box,color=red];
		j2497447698 -> j3766674736;
	j2688262228 [label="Onlar farklı türden birer anı, Roathe. Onlara işe yaramaz. Onlar ruhunun daha derinlerinde gömülü.",shape=box,color=red];
		j2688262228 -> j3341967711;
	j3900980940 [label="Gerçeklerden kaçıp saklanmak işe yaramayacak. Başladığımız yere geri döneceğiz. ",shape=box,color=red];
		j3900980940 -> j3452093887;
	j3766674736 [label="Büyük olasılıkla. İki ile ikiyi toplayıp, senden istemediğim bir şeyi yaptığın için seni suçlayacağım. Eminim bu fırtınayı atlatacaksın.",shape=box,color=blue];
		j3766674736 -> j846332798;
	j3341967711 [label="Olabilir. Çok büyük ihtimalle haklısın. Ama deneyebileceğim başka seçeneğim yok, değil mi? Denemeye değer.",shape=box,color=blue];
		j3341967711 -> j846332798;
	j3452093887 [label="Ve eğer durum buysa, o zaman aynı şeyi tekrar yapabilirsin. Sanki tükenmez bir yeteneğe sahipmişsin gibi, değil mi?",shape=box,color=blue];
		j3452093887 -> j846332798;
	j846332798 [label="Elbette, anılarımı değiştirdiğini fark ettiğimde sana çok kızacağımdan eminim. Ve bana bunun benim isteğim olduğunu söylememeni tavsiye ederim, canım.",shape=box,color=blue];
		j846332798 -> j3750898080;
	j3750898080 [label="Sadece yalan söylediğini iddia edeceğim ve bu muhtemelen senin hakkındaki görüşümü onarılamayacak şekilde zedeleyecektir.",shape=box,color=blue];
		j3750898080 -> j3520622377;
		j3750898080 -> j3988435204;
	j3520622377 [label="Hayır. Bunu yapamam. Bunu yapmayacağım. Bu durumla birlikte yüzleşmeliyiz. Bunu konuşsak olmaz mı?",shape=box,color=red];
		j3520622377 -> j2232999336;
	j3988435204 [label="Ben... başka yolu yok mu gerçekten?",shape=box,color=red];
		j3988435204 -> j2232999336;
	j2232999336 [label="Hayır. Uşağın yukarı çıkmasını istiyorsan? İstediğim gibi tüm bu saçmalıkları aklımdan sil. Umursamıyor musun? O zaman istediğini yap. Benim için fark etmez.",shape=box,color=blue];
		j2232999336 -> j2092207529;
	j2092207529 [label="Ve tabii ki kişisel dostluğumuz, bu durumda sahip olduğum tek koz. Bu kadar basit.",shape=box,color=blue];
		j2092207529 -> j663106655;
	j663106655 [label="Ne dersin?",shape=box,color=blue];
		j663106655 -> j574988017;
		j663106655 -> j3107827784;
	j574988017 [label="Tamam. Yapacağım... Yapacağım. Zihnini sileceğim. Marie ve Lyon'un zihinleri de silinse bile.",shape=box,color=red];
		j574988017 -> j3322293377;
	j3107827784 [label="Hayır, reddediyorum. Seni ilerlemeye ikna etmenin başka bir yolunu bulacağım.",shape=box,color=red];
		j3107827784 -> j2263963715;
	j3322293377 [label="+10 Chemistry",color=orange];
		j3322293377 -> j2179359518;
	j2263963715 [label="Sana bol şans diliyorum.",shape=box,color=blue];
		j2263963715 -> "Initiate conversation LyonRoatheFail in /Lotus/Types/Gameplay/1999Wf/Dialogue/LyonDialogue_rom.dialogue";
	j2179359518 [label="Güzel. İşe başla. ",shape=box,color=blue];
		j2179359518 -> j4072107213;
	"Initiate conversation LyonRoatheFail in /Lotus/Types/Gameplay/1999Wf/Dialogue/LyonDialogue_rom.dialogue" [label="Initiate conversation LyonRoatheFail in /Lotus/Types/Gameplay/1999Wf/Dialogue/LyonDialogue_rom.dialogue",color=orange];
		"Initiate conversation LyonRoatheFail in /Lotus/Types/Gameplay/1999Wf/Dialogue/LyonDialogue_rom.dialogue" -> "Chat ends.";
	j4072107213 [label="Add 1 to Promise counter",color=orange];
		j4072107213 -> j302033967;
	j302033967 [label="Boolean RoatheWillReset is now true.",color=orange];
		j302033967 -> "Chat ends.";
}