digraph {
	1095 [label="RoatheRank2Convo4 begins.",color=orange];
		1095 -> 1096;
	1096 [label="Check boolean RoatheRank2Convo1Complete",color=orange];
		1096 -> 1097 [label=true,color=green];
		1096 -> 1098 [label=false,color=brown];
	1097 [label="Check boolean RoatheKnowsReset2",color=orange];
		1097 -> 1099 [label=true,color=green];
		1097 -> 1100 [label=false,color=brown];
	1098 [label="Chat ends.",color=orange];
	1099 [label="Hm. Söyle bakalım. Geçen sefer bunu yaptığımızda seni \"Kayıtsızlığın\" sadece bir araya getirilmiş çocuk oyuncakları koleksiyonu olduğuna ikna etmeyi başardım mı, yoksa tüm bunları onun \"Void'den gelen büyük, bilinmez bir varlık\" olduğuna inanarak mı bitirdin.",shape=box,color=blue];
		1099 -> 1101;
	1100 [label="Check boolean RoatheMITW1",color=orange];
		1100 -> 1102 [label=true,color=green];
		1100 -> 1103 [label=false,color=brown];
	1101 [label="Bu dünyada nefret ettiğim bir şey varsa, o da kendi kuyruğumu kovalamaktır. Ve bu metafor eskiden şimdi olduğundan çok daha atasözü gibiydi, şimdi fark ettim.",shape=box,color=blue];
		1101 -> 1104;
		1101 -> 1105;
		1101 -> 1106;
	1102 [label="Devam etmeden önce, her şeyi doğru anladığımdan emin olmak istiyorum. Kayıtsızlığın, Albrecht'in hataları yüzünden gerçekliğimize sızan, Void'den gelen Korkunç ve Bilinmez bir Varlık olduğuna mı inanıyorsun?",shape=box,color=blue];
		1102 -> 1107;
	1103 [label="Bu tımarhanede konuştuğum herkes, bu \"Duvardaki Adam\"ın gerçek ve gülünç bir tanrı olduğuna tamamen ikna olmuş durumda. Hem de gerçek bir tanrı. Hatta o iki fanatik bile bu fikri eğlenceli buluyor gibi görünüyor!",shape=box,color=blue];
		1103 -> 1108;
		1103 -> 1109;
		1103 -> 1110;
	1104 [label="Yapmadın, hayır. Üzgünüm. ",shape=box,color=red];
		1104 -> 1111;
	1105 [label="Aslında yaptın.",shape=box,color=red];
		1105 -> 1112;
	1106 [label="Hiçbir zaman tam olarak her iki tarafta da karar kılamadık.",shape=box,color=red];
		1106 -> 1113;
	1107 [label="Sorumu şöyle ifade edeyim, kendi etrafımızda dönüp dolaşıp yine kendi kuyruğumuzun peşinden koşmaya başlamayalım. Ki bu... eskiden şimdi olduğundan çok daha atasözü haline gelmiş bir metafor, ama konudan uzaklaşıyorum.",shape=box,color=blue];
		1107 -> 1114;
	1108 [label="Onun gerçek olduğunu düşünmüyor musun?",shape=box,color=red];
		1108 -> 1115;
	1109 [label="Peki ya onun bir tanrı olduğunu düşünmüyorsan, o zaman ne olduğunu düşünüyorsun?",shape=box,color=red];
		1109 -> 1116;
	1110 [label="Sen bunu eğlenceli bulmuyor musun?",shape=box,color=red];
		1110 -> 1117;
	1111 [label="Update boolean RoatheMITWSkip",color=orange];
		1111 -> 1118;
	1112 [label="Update boolean RoatheMITWSkip",color=orange];
		1112 -> 1119;
	1113 [label="Ah! O zaman hâlâ yapmam gereken işler var gibi görünüyor.",shape=box,color=blue];
		1113 -> 1120;
	1114 [label="Şimdi Kayıtsızlık dediğin varlığın, Albrecht'in onunla etkileşime girmesinden önce de var olduğuna mı inanıyorsun? Yoksa Void ile ilk etkileşime girdiğinde onu yarattığına mı inanıyorsun?",shape=box,color=blue];
		1114 -> 1121;
		1114 -> 1122;
		1114 -> 1123;
		1114 -> 1124;
	1115 [label="Şimdi, bu sözleri ben mi söyledim? Sözlerimi ağzıma tıkmakta bu kadar acele etme, Ey Geçici Gaspçı. Kayıtsızlığın \"gerçek\" olduğunu inkâr etmedim. Onun bir Tanrı olduğunu inkâr ettim.",shape=box,color=blue];
		1115 -> 1125;
		1115 -> 1126;
	1116 [label="Bu sahte tanrıyı, senin için, bilmen ve çok iyi anlaman gereken iki basit kelimeyle ortaya çıkarabilirim:",shape=box,color=blue];
		1116 -> 1127;
	1117 [label="Kesinlikle hayır! Birincisi, tanrı veya tanrılar diye bir şey yok, bu fikir saçma. İkincisi, Albrecht'in bir Void tanrısını serbest bıraktığını düşünmek? Daha da gülünç!",shape=box,color=blue];
		1117 -> 1128;
	1118 [label="Update boolean RoatheMITW5Real",color=orange];
		1118 -> 1129;
	1119 [label="Update boolean RoatheMITW5Fake",color=orange];
		1119 -> 1130;
	1120 [label="Update boolean RoatheMITW1",color=orange];
		1120 -> 1131;
	1121 [label="Bilmiyorum. Ve senin de bunu yapabileceğini sanmıyorum.",shape=box,color=red];
		1121 -> 1132;
	1122 [label="Sanırım Entrati onunla etkileşime girmeden önce de var olan bir varlıktı. O, ona sadece Kavramsal Bütünlük yoluyla şekil ve biçim vermişti.",shape=box,color=red];
		1122 -> 1133;
	1123 [label="Açıkçası... bilmiyorum.",shape=box,color=red];
		1123 -> 1134;
	1124 [label="Gerçekten Entrati'nin tamamen kötü niyetli bir Void tanrısı yarattığını mı düşünüyorsun?",shape=box,color=red];
		1124 -> 1135;
	1125 [label="O şey şimdiye kadar karşılaştığım her şeyden daha güçlü.",shape=box,color=red];
		1125 -> 1136;
	1126 [label="Peki sen onun ne olduğunu düşünüyorsun?",shape=box,color=red];
		1126 -> 1116;
	1127 [label="Kavramsal Bütünlük.",shape=box,color=blue];
		1127 -> 1137;
		1127 -> 1138;
		1127 -> 1139;
	1128 [label="Void'de hiçbir şey yoktur. Bu yüzden ona Void denir! ",shape=box,color=blue];
		1128 -> 1140;
		1128 -> 1141;
	1129 [label="+10 Chemistry",color=orange];
		1129 -> 1142;
	1130 [label="+20 Chemistry",color=orange];
		1130 -> 5772;
	1131 [label="Ama, devam etmeden önce, her şeyi doğru anladığımdan emin olmak istiyorum. Kayıtsızlığın, Albrecht'in hataları yüzünden gerçekliğimize sızan, Void'den gelen Korkunç ve Bilinmez bir Varlık olduğuna mı inanıyorsun?",shape=box,color=blue];
		1131 -> 1107;
	1132 [label="Evet! Yapabilirim! Neler olduğu çok acı verici bir şekilde ortada ve o kadar gülünç ki, hepiniz kendinizi, pencereyi tırmalayan büyük bir canavar olduğuna ikna etmişsiniz, oysa o sadece rüzgarda sallanan bir ağaç dalı.",shape=box,color=blue];
		1132 -> 1143;
	1133 [label="Sen de mi? Çok büyük umutlarım vardı. Neler olduğu çok acı verici bir şekilde ortada ve o kadar gülünç ki, hepiniz kendinizi, pencereyi tırmalayan büyük bir canavar olduğuna ikna etmişsiniz, oysa o sadece rüzgarda sallanan bir ağaç dalı.",shape=box,color=blue];
		1133 -> 1143;
	1134 [label="Neler olduğu çok acı verici bir şekilde ortada ve o kadar gülünç ki, hepiniz kendinizi, pencereyi tırmalayan büyük bir canavar olduğuna ikna etmişsiniz, oysa o sadece rüzgarda sallanan bir ağaç dalı.",shape=box,color=blue];
		1134 -> 1143;
	1135 [label="Evet! Yapıyorum! Neler olduğu çok acı verici bir şekilde ortada ve o kadar gülünç ki, hepiniz kendinizi, pencereyi tırmalayan büyük bir canavar olduğuna ikna etmişsiniz, oysa o sadece rüzgarda sallanan bir ağaç dalı.",shape=box,color=blue];
		1135 -> 1143;
	1136 [label="Peki ben bunu ne zaman inkar ettim ki? Aslında, görünüşe göre hepiniz kendinizi oldukça histerik ve gereksiz yere aşırı bir sıkıntıya sokmayı başarmışsınız.",shape=box,color=blue];
		1136 -> 1144;
		1136 -> 1145;
	1137 [label="Void ve ondan yararlanabileceğimiz şeyler tehlikeli ve güçlüdür - inan bana, biliyorum. Ama sınırları vardır. Gerçekten böyle bir şeyi ortaya çıkarabileceğini mi düşünüyorsun? Bütün dilleri yaratabilecek, Void'de atlayabilen gemilere güç verebilecek parmakları yaratabilecek bir şeyi?",shape=box,color=red];
		1137 -> 1146;
	1138 [label="Yatağımızın altında bir canavar olduğuna inanmak çok cazip geliyor, Roathe. Ama ben bunu yüz yüze gördüm ve böyle bir şeyin nasıl aklımıza gelebildiğini anlayamıyorum.",shape=box,color=red];
		1138 -> 1147;
	1139 [label="Kavramsal Bütünlük, Duvardaki Adam'ın yapabildiği şeyi yapamaz. Entrati o şeyi tezahür ettirmiş ve buraya getirmekten sorumlu olsa da, onun orijinal kaynak olduğuna inanmıyorum.",shape=box,color=red];
		1139 -> 1148;
	1140 [label="Ben... ",shape=box,color=red];
		1140 -> 1149;
	1141 [label="Hayır. Void'den gelen şeyler gördüm. Melekler. Şarkı söyleyenler. Hayaletler.",shape=box,color=red];
		1141 -> 1149;
	1142 [label="Kararından dolayı hayal kırıklığına uğramış olsam da, dürüstlüğünü son derece sevimli buluyorum. Ve ilerledikçe zamanımı boşa harcamadığım için mutluyum. Kendimizi eğlendirmenin başka yollarını bulacağımızdan eminim.",shape=box,color=blue];
		1142 -> 1150;
	5772 [label="Mükemmel. Eski halimin bu kadar ikna edici olmasına sevindim. Umarım dürüstsündür ve beni \"susturmak\" için yalan söylemiyorsundur. Ama sana inanmaktan başka çarem yok.",shape=box,color=blue];
		5772 -> 5773;
	1143 [label="Ancak şimdi, Void'in etkisiyle, hepiniz ona o kadar çok korku ve güç verdiniz ki, bir geri besleme döngüsü gibi, kendini şu... Şeye, Duvardaki Adam'a dönüştürdü.",shape=box,color=blue];
		1143 -> 1151;
	1144 [label="Ne diyorsun sen?",shape=box,color=red];
		1144 -> 1152;
	1145 [label="Dur bakalım. Bunun sorumlusu biz miyiz? Asıl suçlu Albrecht, her şeyi o başlattı.",shape=box,color=red];
		1145 -> 1153;
	1146 [label="İnsanlık, kendisi için yaratabileceği yeni acı biçimlerinin genişliği ve büyüklüğü konusunda yaratıcı olmasaydı, kesinlikle hiçbir şey olmazdı, değil mi? Siz de, sevgili fanatiklerimizin zamanında kimsenin hayal bile edemeyeceği birçok zulüm biçimine tanık oldunuz.",shape=box,color=blue];
		1146 -> 1154;
	1147 [label="Ah, gerçeğe bu kadar yakınsın ama yine de onu reddetmekte bu kadar acelecisin. Kendi zihninin bir ürünü olduğuna inanmanın \"cazip\" olduğunu mu düşünüyorsun, çünkü öyle olsaydı reddetmek daha kolay olurdu? Hayır, bence kendi yarattığımız bir şeyle yüzleşmek, bir tanrıyla yüzleşmekten çok daha tehlikeli.",shape=box,color=blue];
		1147 -> 1155;
	1148 [label="Alçakgönüllülüğü takdir etmekle birlikte, insan yaratıcılığının kapasitesine dair sınırlı anlayışına - özellikle de yeni acı biçimleri yaratma yeteneğine - meydan okuyorum. Aslında kendi evrenini sıfırdan yaratmaktan tek başına sorumlu değil misin?",shape=box,color=blue];
		1148 -> 1156;
	1149 [label="Void'den gelen tek şey, içine yerleştirdiklerimiz ve ondan geri dönenlerdir. Maddeyi ve enerjiyi değiştirir, ama yaratamaz.",shape=box,color=blue];
		1149 -> 1157;
	1150 [label="Ben şahsen, Kavramsal Bütünlük'ün ince noktalarından bahseden ikinci bir tur dolambaçlı tartışmalardan kurtulduğum için minnettarım.",shape=box,color=blue];
		1150 -> 1158;
	5773 [label="Her halükarda, Kavramsal Bütünlüğün ince noktalarını tartışarak kaybolmak yerine, kendimizi eğlendirecek başka yollar bulacağımızdan eminim.",shape=box,color=blue];
		5773 -> 5774;
	1151 [label="Bu saçmalığı Albrecht başlatmış olabilir, ama hepiniz bu ateşi bir cehenneme dönüşene kadar körüklemekten sorumlusunuz. Kayıtsızlık hiç var olmadı. Ta ki, birdenbire, var olana kadar. ",shape=box,color=blue];
		1151 -> 1159;
	1152 [label="Demek istediğim şu: Albrecht, kendi kibirinin, sırıtan bir yıkım tanrısının yüzünde kendisine bakan kişi olduğunu ilk fark eden kişi olabilir, evet.",shape=box,color=blue];
		1152 -> 1160;
	1153 [label="Albrecht, kendi kibirinin, sırıtan bir yıkım tanrısının yüzünde kendisine bakan kişi olduğunu ilk fark eden kişi olabilir, evet.",shape=box,color=blue];
		1153 -> 1160;
	1154 [label="+5 Chemistry",color=orange];
		1154 -> 1161;
	1155 [label="Dışarıdaki bir düşman anlaşılabilir. Manipüle edilebilir. Yenilebilir. Hatta belki de pazarlık konusu bile olabilir, eğer iş oraya gelirse. Kullanılabilecek zayıflıkları vardır. Peki ya içerideki bir düşman? Kendi yarattığımız biri? Bu gerçekten çok daha sinsi.",shape=box,color=blue];
		1155 -> 1162;
	1156 [label="Siz de, sevgili fanatiklerimizin zamanında kimsenin hayal bile edemeyeceği birçok zulüm biçimine tanık oldunuz. ",shape=box,color=blue];
		1156 -> 1163;
	1157 [label="Düşün Gezgin. Bahsettiğin şu \"Void Melekleri\". Bu hayaletler. Bunlar, zaten Void'de kaybolmuş olanlardan mı yaratıldı?",shape=box,color=blue];
		1157 -> 1164;
	1158 [label="Bu, fanatiklerin vaazlarına daha fazla zaman ayırmak anlamına geliyor... bah. Seçimler, seçimler, seçimler...",shape=box,color=blue];
		1158 -> 1165;
	5774 [label="Ben, şahsen, ikinci turdan kurtulduğum için minnettarım.",shape=box,color=blue];
		5774 -> 1158;
	1159 [label="Ve bunun suçlusu hepinizsiniz.",shape=box,color=blue];
		1159 -> 1166;
		1159 -> 1167;
		1159 -> 1168;
	1160 [label="Ama sizler de, bu juba böceği pisliğini bu kadar uzun süre yokuş aşağı yuvarlamaya devam ederek, yol boyunca topladığı her pislik parçasıyla daha da büyütmekten eşit derecede sorumlusunuz!",shape=box,color=blue];
		1160 -> 1169;
	1161 [label="Bir tür olarak, kendimizi yok etmek için korkularımıza yeni yollar bulma yeteneğimizle oldukça şaşırtıcıyız.",shape=box,color=blue];
		1161 -> 1170;
	1162 [label="+5 Chemistry",color=orange];
		1162 -> 1171;
	1163 [label="+5 Chemistry",color=orange];
		1163 -> 1161;
	1164 [label="Onlar, çocuklarını beslemek için renkli bir kutak gibi kusulan enerjinin yankılarıydı.",shape=box,color=blue];
		1164 -> 1169;
	1165 [label="Chat ends.",color=orange];
	1166 [label="Biz böyle şeyler yaratamayız, Roathe - sana söylemiştim. Kavramsal Bütünlüğün sınırları var.",shape=box,color=red];
		1166 -> 1172;
	1167 [label="Bunun için bizi suçlamayın. O şeyin yol açtığı hasardan biz sorumlu değiliz.",shape=box,color=red];
		1167 -> 1173;
	1168 [label="Bunun nasıl işleyeceğine dair mantığını bana anlat. Void'de Kavramsal Bütünlük yoluyla yaratılan çoğu şey oradan çıkamaz - en azından uzun süre.",shape=box,color=red];
		1168 -> 1174;
	1169 [label="Tartışmayı senin için basitleştirmeme izin ver. Bu sahte tanrıyı, senin için, bilmen ve çok iyi anlaman gereken iki basit kelimeyle ortaya çıkarabilirim:",shape=box,color=blue];
		1169 -> 1127;
	1170 [label="Update boolean RoatheMITW1",color=orange];
		1170 -> 1107;
	1171 [label="Çünkü o zaman kendi şeytanlarımızla savaşmak zorunda kalırız. Ve insanlık... böyle savaşları asla kazanamaz, değil mi?",shape=box,color=blue];
		1171 -> 1170;
	1172 [label="Bunu, tek başına alternatif bir boyut yaratan kişi mi söylüyor? Lütfen Gezgin... çok uzun zaman önce yaptığın gibi hayal gücünü kullan.",shape=box,color=blue];
		1172 -> 1174;
	1173 [label="Seni azarlamıyorum! Bu iş, sen daha sahneye çıkmadan çok önce başlamıştı. Albrecht bunu halletti.",shape=box,color=blue];
		1173 -> 1175;
	1174 [label="Kavramsal Bütünlük şu şekilde işler: Void ile etkileşime girdiğinde veya Void'e yakın olduğunda, güçlü duygular ve düşünceler fiziksel olarak tezahür edebilir. Bunu ikimiz de biliyoruz.",shape=box,color=blue];
		1174 -> 1176;
		1174 -> 1177;
		1174 -> 1178;
	1175 [label="Kendi yansımasını gördü ve gerçek korkuyu tanıdı. Ve böylece her şeyi yakıp kül edecek ateşi tutuşturan ilk kıvılcımı çaktı. Hepiniz sadece ateşe daha fazla odun atıyorsunuz.",shape=box,color=blue];
		1175 -> 1174;
	1176 [label="Doğru. Duviri gibi, Zariman aracılığıyla bu dünyayla bir bağlantısı var. ",shape=box,color=red];
		1176 -> 1179;
	1177 [label="Zariman, Holdfast ve Void Melekleri gibi. Void o geminin her yerinde.",shape=box,color=red];
		1177 -> 1179;
	1178 [label="Evet. Sonra?",shape=box,color=red];
		1178 -> 1180;
	1179 [label="Tam olarak öyle. Void nereye giderse, Kavramsal Bütünlük de oraya gidebilir. Ve sadece orada.",shape=box,color=blue];
		1179 -> 1181;
		1179 -> 1182;
	1180 [label="Void nereye giderse, Kavramsal Bütünlük de oraya gidebilir. Ve sadece oraya.",shape=box,color=blue];
		1180 -> 1181;
		1180 -> 1182;
	1181 [label="Ama 1999 yılına kadar sürdü. Albrecht'i her yerde takip etti. Beni de.",shape=box,color=red];
		1181 -> 1183;
	1182 [label="Bir dakika...",shape=box,color=red];
		1182 -> 1184;
	1183 [label="Lanet olası parmaklar. Tau'ya ulaşmak için çaresiz ve çılgın bir girişimde bulunarak o lanet parmakları aldık ve biz Orokinler onları taklit etmenin bir yolunu bulduk, değil mi?",shape=box,color=blue];
		1183 -> 1185;
	1184 [label="Evet. Şimdi anlıyorsun. Lanet olası parmaklar. Tau'ya ulaşmak için çaresiz ve çılgın bir girişimle o lanet parmakları aldık ve biz Orokinler onları taklit etmenin bir yolunu bulduk, değil mi?",shape=box,color=blue];
		1184 -> 1185;
	1185 [label="Gittiğin her yerde, Void'in küçük parçaları... O şeyin istediği yerde ortaya çıkabilmesi için bir hendek ve tünel ağı. Daha da kötüsü ne?",shape=box,color=blue];
		1185 -> 1186;
	1186 [label="Tenno. Ve sen. Hepiniz, Void'in dokunuşuyla. Ve hepiniz, o şey tarafından rahatsız ediliyorsunuz, çünkü nereye giderseniz gidin sizi takip edebilir.",shape=box,color=blue];
		1186 -> 1187;
	1187 [label="Ve muhtemelen onunla uzun süredir etkileşimde bulunan herkes. Entrati'nin kendisi. Uşağı. Cavia. Ben, fanatikler, bu Sanctum'a yakınlığımızdan dolayı. Liste böylece uzayıp gidiyor.",shape=box,color=blue];
		1187 -> 1188;
		1187 -> 1189;
	1188 [label="Yani, Void'e yeterince maruz kalan veya \"pil\" olan herkesin Duvardaki Adam'ın bakabileceği başka bir pencere haline geldiğini mi öne sürüyorsun?",shape=box,color=red];
		1188 -> 1190;
	1189 [label="Peki Rusalka'ya nasıl girdi acaba?",shape=box,color=red];
		1189 -> 1191;
	1190 [label="Kesinlikle. ",shape=box,color=blue];
		1190 -> 1192;
	1191 [label="Kim?",shape=box,color=blue];
		1191 -> 1193;
		1191 -> 1194;
	1192 [label="Bu, neden kendi yüzünü gösteremediğini açıklıyor, değil mi? Sadece işkence ettiği veya etmeye çalıştıklarına görünebilir.",shape=box,color=blue];
		1192 -> 1195;
	1193 [label="Binbaşı Neci Rusalka. 1999 yılında Höllvania'da Scaldra olarak bilinen askeri gücün komutanıydı.",shape=box,color=red];
		1193 -> 1196;
	1194 [label="Uzun lafın kısası, ikinizin asla görüşmesine izin vermemeliyim.",shape=box,color=red];
		1194 -> 1197;
	1195 [label="Aslında, mimari, kendisini daha Büyük ve Farklı bir şey olarak göstermeye çalıştığında mimari görünür. Büyüklük ve Tanrısallık hissine ulaşmak için çaresizce çabaladığında.",shape=box,color=blue];
		1195 -> 1198;
		1195 -> 1199;
	1196 [label="Kayıtsızlık tarafından ele geçirilmişti - ya da geçiriliyordu. Zihnini paylaşıyor, onu bir kukla gibi kullanıyor. Ya da o, zihnini ele geçirdi. Bilmiyoruz. Gerçekten tekrar kontrolü ele geçirip geçirmediğini de bilmiyoruz.",shape=box,color=red];
		1196 -> 1200;
	1197 [label="Hiç eğlenceli değilsin, Gaspçı. Peki o bizim... Kayıtsızlığımızı nasıl etkiliyor? Tam olarak?",shape=box,color=blue];
		1197 -> 1196;
	1198 [label="Yani temas ettiği tüm insanların yüzlerini taktığını mı düşünüyorsun... çünkü kendine ait bir yüzü yok mu?",shape=box,color=red];
		1198 -> 1201;
	1199 [label="Duvardaki Adam'ın insan olmanın nasıl bir şey olduğunu anlayamadığı için yüzlerimizi takmayı seçtiğine inanıyorum. Aksi takdirde bu onun için çok ''büyük'' bir şey olur.",shape=box,color=red];
		1199 -> 1202;
	1200 [label="O gerçekten de çok etkileyici birine benziyor. Ve çok hoş birine. Ama şu anda bunun bir önemi yok. Onun zihnini Kayıtsızlığın ele geçirdiğini mi söylüyorsun? Ve bu, senin geçmişe yaptığın küçük yolculukla mı başladı?",shape=box,color=blue];
		1200 -> 1203;
	1201 [label="Hayır, aptalca bir şey. Çünkü sadece onu yaratanı taklit ediyor. Bütünsel bir varlık değil; sadece beslendiği korku, dehşet ve acının uyumsuz parçalarından yapılmış bir oyuncak. ",shape=box,color=blue];
		1201 -> 1204;
	1202 [label="Hayır, aptalca bir şey. Sadece onu yaratanı taklit ediyor. Bütünsel bir varlık değil; beslendiği korku, dehşet ve acının uyumsuz parçalarından yapılmış bir oyuncak sadece.",shape=box,color=blue];
		1202 -> 1204;
	1203 [label="Peki, Void hakkında bildiklerimiz doğruysa, o zaman iki şeyden biri gerçekleşmiş demektir: Ya 1999 yılında kendi yaptığı bir şeyin sonucu olarak Void'e girmiştir (ki bunun çok düşük bir ihtimal olduğunu düşünüyorum, ama imkânsız da değil) ya da...",shape=box,color=blue];
		1203 -> 1205;
	1204 [label="Bah. Bugün hiçbir ilerleme kaydedemeyeceğimi görüyorum. Sorun değil, sana sunulan bu propagandaya iyice saplanmış durumdasın. Korkarım Albrecht son derece ikna edici bir tarikat lideri.",shape=box,color=blue];
		1204 -> 1206;
	1205 [label="Sevgili Albrecht yine karışmış.",shape=box,color=blue];
		1205 -> 1207;
		1205 -> 1208;
		1205 -> 1209;
	1206 [label="+10 Chemistry",color=orange];
		1206 -> 1210;
	1207 [label="Albrecht'in Neci'yi bilerek Kayıtsızlık'ın kuklası yaptığını mı ima ediyorsun?",shape=box,color=red];
		1207 -> 1211;
	1208 [label="Bunların hiçbirinin doğru olup olmadığını bilmiyoruz. Hiçbirinin. Bunların hepsi sadece spekülasyon. Bunların hepsi tamamen yalan olabilir.",shape=box,color=red];
		1208 -> 1212;
	1209 [label="Eğer 1999'da Void'e bir delik açtıysa ve bunu bilerek içeri aldıysa... bu, Warframe'lerin ilk başta orada çalışmasının nedenini açıklar... aynı şey sizin zamanınızda da geçerliydi - tabii Deimos'un kalbi olmadan.",shape=box,color=red];
		1209 -> 1213;
	1210 [label="Update boolean RoatheMITW2",color=orange];
		1210 -> 1214;
	1211 [label="Ben burada oturmuş, en iyilerinden Gaspçı ile kahve falı bakıyorum. Albrecht'in Höllvania'daki Void'e bilerek bir delik açıp Kayıtsızlığı içeri aldığını ve ona kendine özgü bir görünüm kazandırdığını ima etmek bana düşmez...",shape=box,color=blue];
		1211 -> 1215;
	1212 [label="Elbette! Ben sadece burada oturmuş, en iyileriyle, Gaspçı'yla kahve falı bakıyorum. Albrecht'in Höllvania'daki Void'e bilerek bir delik açıp Kayıtsızlık'ı içeri aldığını ve ona kendine özgü bir görünüm kazandırdığını ima etmek bana düşmez...",shape=box,color=blue];
		1212 -> 1215;
	1213 [label="Gördün mü? Bir bilim insanına asla güvenme. Boş boş dolaşmak uğruna her şeyi yapmaya hazırlar. Ama yine de, ben burada oturmuş, en iyileriyle birlikte kahve falı bakıyorum, Gaspçı. Bunların hepsi basit varsayımlar.",shape=box,color=blue];
		1213 -> 1216;
	1214 [label="Umarım en azından üzerinde düşünmen için bir fikir verebilmişimdir. Ama şimdilik gitmeliyim.",shape=box,color=blue];
		1214 -> 1217;
	1215 [label="Bana öyle geliyor ki, bir taktikçi ve savaş stratejilerine oldukça alışkın bir adam olarak...",shape=box,color=blue];
		1215 -> 1218;
	1216 [label="Albrecht'in Höllvania'daki Void'e bilerek bir delik açıp Kayıtsızlık'ı içeri alarak ona kendine özgü bir görünüm kazandırdığını ima etmek bana düşmez! Bana öyle geliyor ki, bir taktikçi ve savaş stratejileri geliştirmeye oldukça alışkın bir adam olarak...",shape=box,color=blue];
		1216 -> 1218;
	1217 [label="Chat ends.",color=orange];
	1218 [label="Her yerde, her kişide ve her zaman olabilen, kimliği belirsiz bir rakibi yenmenin ilk adımı, seçenekleri mümkün olduğunca azaltmaktır...",shape=box,color=blue];
		1218 -> 1219;
