	j1182792422 [label="SM: OROKIN",shape=box,color=blue];
		j1182792422 -> j341259930;
	j341259930 [label="Transkript: Orokin İmparatorluğu uzun süre boyunca düşmanı yoktu. Ordusu sadece küçük kinleri, hanedanlar arası, İnfazcılar arası hesaplaşmaları sürdürmek için vardı.",shape=box,color=blue];
		j341259930 -> j4198238239;
	j4198238239 [label="Sentientler saldırdığında, uzun zamandır bizden esirgenen bir birliğin farkındaydık. Daxlar kılıçlarını küstah bir köylüye veya hırsız bir tüccara değil, başka bir şeye karşı çektiler.",shape=box,color=blue];
		j4198238239 -> j2662130782;
	j2662130782 [label="İmparatorluğun ölümsüz, unvan sahibi yöneticileri olan ve gücü İnfazcıların elinde olan İmparatorlar, tozlu altın tahtlarında sendeleyerek uyandılar.",shape=box,color=blue];
		j2662130782 -> j1145554812;
	j1145554812 [label="Savaş, muhteşem savaş! Sonunda İmparatorluk bir anlam kazandı. Güneş'in nihai ölümünden daha yakın bir yok oluşla tanımlanan bizler, hayatın nektarını sonuna kadar içtik.",shape=box,color=blue];
		j1145554812 -> j921430358;
	j921430358 [label="Add 1 to HellStory counter",color=orange];
		j921430358 -> "Chat ends.";
