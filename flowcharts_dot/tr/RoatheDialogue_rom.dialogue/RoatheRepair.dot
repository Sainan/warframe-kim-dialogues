digraph {
	5182 [label="RoatheRepair begins.",color=orange];
		5182 -> 5183;
	5183 [label="Evaluate expressions",color=orange];
		5183 -> 5185 [label="LyonRoatheFailFix, MarieRoatheFailFix",color=purple];
		5183 -> 5184 [label="false",color=purple];
	5185 [label="Yeter! Yeter. Pes ediyorum! Onlar kuduz kubrodonlardan bile beter! Lanet olası yaratıklar nereye gidersem peşimden geliyorlar. Uyuyamıyorum bile!",shape=box,color=blue];
		5185 -> 5186;
	5184 [label="Chat ends.",color=orange];
	5186 [label="Ne?! Ne istiyorsun?!",shape=box,color=blue];
		5186 -> 5188;
		5186 -> 5187;
		5186 -> 5189;
	5188 [label="Serumu alman hakkında seninle konuşmak için bir fırsat daha. Roathe, kaçmayı bırakmanın zamanı geldi. ",shape=box,color=red];
		5188 -> 5191;
	5187 [label="Roathe. Serumu almak seni korkak yapmaz. Seni ayakta kalan tek Orokin yapar. Bunu kabullen.",shape=box,color=red];
		5187 -> 5190;
	5189 [label="Roathe. Serumu almak seni korkak yapmaz. Sana yaşamak için bir şans daha verir. Gerçek bir fark yaratmak için.",shape=box,color=red];
		5189 -> 5192;
	5191 [label="Evaluate expressions on Thermostat",color=orange];
		5191 -> 5195 [label="x >= 5",color=purple];
		5191 -> 5194 [label="x <= 0",color=purple];
		5191 -> 5193 [label="x > 0 && x < 5",color=purple];
		5191 -> 5193 [label="false",color=purple];
	5190 [label="Add -5 to Thermostat",color=orange];
		5190 -> 5191;
	5192 [label="Add 5 to Thermostat",color=orange];
		5192 -> 5191;
	5195 [label="O öfkenin seni içten içe parçalamasına izin veriyorsun. Onu, bugün hâlâ bu dünyayı mahveden insanlarla savaşmana yardımcı olmak için kullanabilirsin. Burada. Şimdi.",shape=box,color=red];
		5195 -> 5198;
	5194 [label="Onu kendine doğrultuyorsun. Orokin İmparatorluğu'ndan kurtarmak için elinden gelenin en iyisini yaptığın halde seni suçlayan dünyaya doğrultmalısın.",shape=box,color=red];
		5194 -> 5197;
	5193 [label="Bu yüzden mi onları gece gündüz beni rahatsız etmeleri için ikna ettin? Bunun için mi? Beni zavallı argümanını dinlemeye ikna etmek için son bir çaba mı?",shape=box,color=blue];
		5193 -> 5196;
	5198 [label="Geçmişin seni tanımlamıyor, Roathe. Geleceğin seni tanımlıyor. Ve Naga Davulları Gecesi'nde ölen tüm Orokinlerin aksine, senin hâlâ yaşayabileceğin bir geleceğin var.",shape=box,color=red];
		5198 -> 5201;
	5197 [label="Seni tanımlayan şey, etrafındakilerin fikirleri veya eylemlerin hakkındaki düşünceleri değildir. Seni tanımlayan tek şey, kendine ve seçimlerine olan inancındır.",shape=box,color=red];
		5197 -> 5200;
	5196 [label="Hayır.",shape=box,color=blue];
		5196 -> 5199;
	5201 [label="Artık seni tanımlayan tek şey bu. Değişebilirsin. Ve etrafındaki dünyayı da değiştirebilirsin. Sanırım tek sorum şu: En azından deneyecek misin?",shape=box,color=red];
		5201 -> 5204;
	5200 [label="Ve meselenin aslı şu ki? Naga Davulları Gecesi'nden sağ kurtulan bildiğimiz çok az Orokin'den birisin. Benim bakış açıma göre mi? Bu stratejik bir geri çekilmeydi.",shape=box,color=red];
		5200 -> 5203;
	5199 [label="Başarısızlığın acınası bir durum. Bir kez değil, iki kez.",shape=box,color=blue];
		5199 -> 5202;
	5204 [label="Kendini affetmeyi ve ilerlemeyi dene?",shape=box,color=red];
		5204 -> 5207;
	5203 [label="Ne bir fazlası ne bir eksiği.",shape=box,color=red];
		5203 -> 5206;
	5202 [label="Kamu görevine aday olmayı tavsiye etmiyorum.",shape=box,color=blue];
		5202 -> 5205;
	5207 [label="Update boolean RoatheRedeemed",color=orange];
		5207 -> 5209;
	5206 [label="Update boolean RoatheVillain",color=orange];
		5206 -> 5208;
	5205 [label="Chat ends.",color=orange];
	5209 [label="+20 Chemistry",color=orange];
		5209 -> 5211;
	5208 [label="+20 Chemistry",color=orange];
		5208 -> 5210;
	5211 [label="Yaptıklarım için kendimi affetmek mi? Ve geleceğe doğru ilerlemek mi? Hm.",shape=box,color=blue];
		5211 -> 5213;
	5210 [label="Savaşı kazanmak için geri çekilme. Hım. ",shape=box,color=blue];
		5210 -> 5212;
	5213 [label="Durumu yeniden çerçevelendirmen konusunda biraz şüpheliyim, ama bu yeni gelecek ve bunun benim için ne anlama gelebileceği beni çok cezbediyor, sevgili Gezgin.",shape=box,color=blue];
		5213 -> 5215;
	5212 [label="Senin olayları taktiksel bir geri çekilme olarak yeniden çerçevelendirmen konusunda biraz şüpheliyim, ama yine de bunu desteklediğimi itiraf etmeliyim, sevgili Gezgin.",shape=box,color=blue];
		5212 -> 5214;
	5215 [label="Hayatımdaki bu ''yeni başlangıç''. Tamam. Senin argümanını kabul ediyorum ve onaylıyorum. Geç de olsa, yine de... etkili oldu.",shape=box,color=blue];
		5215 -> 5216;
	5214 [label="Tamam. Senin argümanını kabul ediyorum ve onaylıyorum. Geç de olsa, yine de... etkili oldu.",shape=box,color=blue];
		5214 -> 5216;
	5216 [label="Teşekkür ederim. Tahmin ettiğinden çok daha fazla.",shape=box,color=blue];
		5216 -> 5217;
	5217 [label="Update boolean RoatheFail",color=orange];
		5217 -> 5218;
	5218 [label="Update boolean RoatheFamilyFail",color=orange];
		5218 -> 5793;
