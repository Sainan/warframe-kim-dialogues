		j2698800356 -> j348640837;
	j1939624287 [label="Serumu alman hakkında seninle konuşmak için bir fırsat daha. Roathe, kaçmayı bırakmanın zamanı geldi. ",shape=box,color=red];
		j1939624287 -> j1979205857;
	j1453376107 [label="Roathe. Serumu almak seni korkak yapmaz. Seni ayakta kalan tek Orokin yapar. Bunu kabullen.",shape=box,color=red];
		j1453376107 -> j1420398166;
