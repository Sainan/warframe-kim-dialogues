		5795 -> 5794 [label=false,color=brown];
	5796 [label="Chat ends.",color=orange];
	5794 [label="Şimdi, sanırım savaştaki bir sonraki çatışmamıza geçebiliriz, değil mi? Uşak.",shape=box,color=blue];
		5794 -> 5797;
	5797 [label="Ben, şahsen, sabırsızlanıyorum.",shape=box,color=blue];
