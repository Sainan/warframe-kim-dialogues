		j2233853046 -> j712834697;
	j2664476126 [label="Yaptıklarım için kendimi affetmek mi? Ve geleceğe doğru ilerlemek mi? Hm.",shape=box,color=blue];
		j2664476126 -> j556682766;
	j712834697 [label="Savaşı kazanmak için geri çekilme. Hım. ",shape=box,color=blue];
		j712834697 -> j3776064932;
	j556682766 [label="Durumu yeniden çerçevelendirmen konusunda biraz şüpheliyim, ama bu yeni gelecek ve bunun benim için ne anlama gelebileceği beni çok cezbediyor, sevgili Gezgin.",shape=box,color=blue];
		j556682766 -> j3951029200;
	j3776064932 [label="Senin olayları taktiksel bir geri çekilme olarak yeniden çerçevelendirmen konusunda biraz şüpheliyim, ama yine de bunu desteklediğimi itiraf etmeliyim, sevgili Gezgin.",shape=box,color=blue];
		j3776064932 -> j3345769138;
	j3951029200 [label="Hayatımdaki bu ''yeni başlangıç''. Tamam. Senin argümanını kabul ediyorum ve onaylıyorum. Geç de olsa, yine de... etkili oldu.",shape=box,color=blue];
