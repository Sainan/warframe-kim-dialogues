		j1420398166 -> j1979205857;
	j62611055 [label="Add 5 to Thermostat counter",color=orange];
		j62611055 -> j1979205857;
	j646898078 [label="O öfkenin seni içten içe parçalamasına izin veriyorsun. Onu, bugün hâlâ bu dünyayı mahveden insanlarla savaşmana yardımcı olmak için kullanabilirsin. Burada. Şimdi.",shape=box,color=red];
		j646898078 -> j4062290232;
	j3220051715 [label="Onu kendine doğrultuyorsun. Orokin İmparatorluğu'ndan kurtarmak için elinden gelenin en iyisini yaptığın halde seni suçlayan dünyaya doğrultmalısın.",shape=box,color=red];
		j3220051715 -> j1248817457;
	j3121421008 [label="Bu yüzden mi onları gece gündüz beni rahatsız etmeleri için ikna ettin? Bunun için mi? Beni zavallı argümanını dinlemeye ikna etmek için son bir çaba mı?",shape=box,color=blue];
		j3121421008 -> j536690451;
	j4062290232 [label="Geçmişin seni tanımlamıyor, Roathe. Geleceğin seni tanımlıyor. Ve Naga Davulları Gecesi'nde ölen tüm Orokinlerin aksine, senin hâlâ yaşayabileceğin bir geleceğin var.",shape=box,color=red];
		j4062290232 -> j3743031294;
	j1248817457 [label="Seni tanımlayan şey, etrafındakilerin fikirleri veya eylemlerin hakkındaki düşünceleri değildir. Seni tanımlayan tek şey, kendine ve seçimlerine olan inancındır.",shape=box,color=red];
		j1248817457 -> j3589662284;
	j536690451 [label="Hayır.",shape=box,color=blue];
		j536690451 -> j2735610392;
	j3743031294 [label="Artık seni tanımlayan tek şey bu. Değişebilirsin. Ve etrafındaki dünyayı da değiştirebilirsin. Sanırım tek sorum şu: En azından deneyecek misin?",shape=box,color=red];
		j3743031294 -> j486954315;
	j3589662284 [label="Ve meselenin aslı şu ki? Naga Davulları Gecesi'nden sağ kurtulan bildiğimiz çok az Orokin'den birisin. Benim bakış açıma göre mi? Bu stratejik bir geri çekilmeydi.",shape=box,color=red];
		j3589662284 -> j2501531870;
	j2735610392 [label="Başarısızlığın acınası bir durum. Bir kez değil, iki kez.",shape=box,color=blue];
		j2735610392 -> j2530848153;
	j486954315 [label="Kendini affetmeyi ve ilerlemeyi dene?",shape=box,color=red];
		j486954315 -> j1773589413;
	j2501531870 [label="Ne bir fazlası ne bir eksiği.",shape=box,color=red];
		j2501531870 -> j1487128850;
