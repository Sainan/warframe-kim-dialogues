		j1420398166 -> j1979205857;
	j62611055 [label="Add 5 to Thermostat counter",color=orange];
		j62611055 -> j1979205857;
	j2756863539 [label="O öfkenin seni içten içe parçalamasına izin veriyorsun. Onu, bugün hâlâ bu dünyayı mahveden insanlarla savaşmana yardımcı olmak için kullanabilirsin. Hemen. Ve şimdi.",shape=box,color=red];
		j2756863539 -> j1505741463;
	j2091175610 [label="Öfkeni kendine yöneltiyorsun. Bu öfkeyi, Orokin İmparatorluğundan kurtarmak için elinden gelenin en iyisini yapmana rağmen seni suçlayan dünyaya doğrultmalısın.",shape=box,color=red];
		j2091175610 -> j8255612;
	j3121421008 [label="Bu yüzden mi onları gece gündüz beni rahatsız etmeleri için ikna ettin? Bunun için mi? Beni zavallı argümanını dinlemeye ikna etmek için son bir çaba mı?",shape=box,color=blue];
		j3121421008 -> j536690451;
	j1505741463 [label="Seni geçmişin değil, geleceğin tanımlamıyor Roathe. Naga Davulları Gecesinde ölen tüm Orokinlerin aksine, senin hâlâ yaşayabileceğin bir geleceğin var.",shape=box,color=red];
		j1505741463 -> j3786098031;
	j8255612 [label="Seni tanımlayan şey, etrafındakilerin fikirleri veya eylemlerin hakkındaki düşünceleri değildir. Seni tanımlayan tek şey, kendine ve seçimlerine olan inancındır.",shape=box,color=red];
		j8255612 -> j2096765221;
	j536690451 [label="Hayır.",shape=box,color=blue];
		j536690451 -> j2735610392;
	j3786098031 [label="Artık seni tanımlayan tek şey bu. Değişebilirsin. Ve etrafındaki dünyayı da değiştirebilirsin. Sanırım tek sorum şu: Bunu deneyecek misin?",shape=box,color=red];
		j3786098031 -> j1840501487;
	j2096765221 [label="Ve asıl mesele ne biliyor musun? Naga Davulları Gecesinden sağ kurtulan bildiğimiz çok az Orokin'den birisin. Benim bakış açımı soracak olursan bu stratejik bir geri çekilmeydi.",shape=box,color=red];
		j2096765221 -> j2359289214;
	j2735610392 [label="Başarısızlığın acınası bir durum. Bir kez değil, iki kez.",shape=box,color=blue];
		j2735610392 -> j2530848153;
	j1840501487 [label="Kendini affetmeyi ve ilerlemeyi dene?",shape=box,color=red];
		j1840501487 -> j841728641;
	j2359289214 [label="Ne bir fazlası ne bir eksiği.",shape=box,color=red];
