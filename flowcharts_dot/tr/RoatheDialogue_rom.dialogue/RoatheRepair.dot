		j177009984 -> j4285359654;
	j3614831486 [label="Yaptıklarım için kendimi affetmek, ve geleceğe doğru ilerlemek mi? Hm.",shape=box,color=blue];
		j3614831486 -> j3798954036;
	j4285359654 [label="Savaşı kazanmak için geri çekilmek. Hm. ",shape=box,color=blue];
		j4285359654 -> j124501663;
	j3798954036 [label="Durumu yeniden çerçevelendirmen konusunda biraz şüpheliyim, ama bu yeni gelecek ve bunun benim için ne anlama gelebileceği beni çok cezbediyor, sevgili Gezgin.",shape=box,color=blue];
		j3798954036 -> j1835611587;
	j124501663 [label="Senin olayları taktiksel bir geri çekilme olarak yeniden çerçevelendirmen konusunda biraz şüpheliyim, ama yine de bunu desteklediğimi itiraf etmeliyim, sevgili Gezgin.",shape=box,color=blue];
		j124501663 -> j387739880;
	j1835611587 [label="Hayatımın ''yeni başlangıcı''. Tamam. Argümanını kabul ediyorum. Geç de olsa, yine de... etkili oldu.",shape=box,color=blue];
