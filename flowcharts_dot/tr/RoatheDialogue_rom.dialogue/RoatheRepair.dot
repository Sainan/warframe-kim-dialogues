	j500165011 [label="Yeter! Yeter. Pes ediyorum! Onlar kuduz kubrodonlardan bile beter! Lanet olası yaratıklar nereye gidersem peşimden geliyorlar. Uyuyamıyorum bile!",shape=box,color=blue];
