	j1004649806 [label="Evet. Bir düşün; Bir insanın işleyebileceği en korkunç şeylerin bile, en azından ikinci bir kişinin yargılaması gerekir. Boşlukta tek başına bir kişi, kınanacak hiçbir şey yapamaz. Issız bir gezegeni yok mu etti? Aman ne kayıp.",shape=box,color=blue];
