	j2837230501 [label="+5 Chemistry",color=orange];
		j2837230501 -> j726481646;
	j3088353774 [label="Ya açıkça konuş ya da hiç konuşma. Eğer bunun gerçekte kiminle ilgili olduğunu bana söylemeyeceksen, seninle konuşarak vaktimi boşa harcamayacağım.",shape=box,color=red];
