	j2010240133 [label="Bazen, evet. Genellikle insan olma kapasitesi olmayan, şeytani, sevgiden yoksun olarak tasvir edilir. Ama neden? Bana soracak olursan, tüm bunlar masalların ardında yatan mesajı ve öğrenilecek dersi anlatmaktır. Değil mi?",shape=box,color=blue];
		j2010240133 -> j333937010;
	j3574800613 [label="Evet, bazen. Büyük Kötülükleriyle meşgul olduklarını, sözde \"Önemsiz Şeyler\" ile kendilerini küçümsemedikleri gösteriliyor. Peki neden? Sonuçta tüm büyük masallar bir ders vermek için var, değil mi?",shape=box,color=blue];
		j3574800613 -> j333937010;
