	j1195879061 [label="Ayrıntılara takılmak istemiyorum. Ayrıntıya girmek tüm konuşmayı rayından çıkarıyor. \"Görüyorsun, bu kişi şunu yaptı, şu kişi bunu yaptı, bu da bunu geçersiz kılıyor,\" ve sonuç olarak hepimiz bu konuda bir sonuca varamadan öylece dururuz.",shape=box,color=blue];
