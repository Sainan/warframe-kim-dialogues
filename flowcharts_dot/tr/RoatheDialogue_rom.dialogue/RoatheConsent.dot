	j3832072091 [label="Hey Roathe? Bir saniyen var mı? [Birden fazla ilişki partneri için onay iste.]",shape=box,color=red];
		j3832072091 -> j924500604;
	j890544564 [label="[Son.]",shape=box,color=red];
		j890544564 -> j604242687;
	j924500604 [label="Hm? Ne oldu canım?",shape=box,color=blue];
		j924500604 -> j2003016782;
	j604242687 [label="Boolean RoatheConsentComplete is now true.",color=orange];
		j604242687 -> "Chat ends.";
	j2003016782 [label="Seninle bir konu hakkında konuşmak istiyorum ve bunun senin için uygun olduğundan emin olmak istiyorum.",shape=box,color=red];
		j2003016782 -> j2884438673;
	j2884438673 [label="Sana yalan söylediğimi veya sana karşı dürüst olmadığımı hissetmeni istemem.",shape=box,color=red];
		j2884438673 -> j1947062874;
	j1947062874 [label="Devam et. Kulağa oldukça iyi bir şey gibi geliyor.",shape=box,color=blue];
		j1947062874 -> j3411553588;
	j3411553588 [label="Seni istemeyeceğin bir duruma sokmak istemiyorum. Yani hayır dersen sorun değil. Sadece bilmeni istiyorum.",shape=box,color=red];
		j3411553588 -> j3368006312;
	j3368006312 [label="Yaşadığımız şey benim için önemli - çok önemli - ve hislerim gerçek. Bundan şüphe duymanı istemiyorum.",shape=box,color=red];
		j3368006312 -> j2005746470;
	j2005746470 [label="Dur bakalım. Void aşkına, başka bir partnerin olduğu haberini güzelleştirerek söylemeye mi çalışıyorsun?",shape=box,color=blue];
		j2005746470 -> j3345048626;
	j3345048626 [label="Beni aptal mı sanıyordun? Zaten biliyorum, canım Gezginim!",shape=box,color=blue];
		j3345048626 -> j2581366179;
		j3345048626 -> j244497112;
	j2581366179 [label="Sanırım bu konu senin için sorun değil?",shape=box,color=red];
		j2581366179 -> j735254641;
	j244497112 [label="Biliyor muydun?",shape=box,color=red];
		j244497112 -> j554083989;
	j735254641 [label="Keşke şu anda Sanctum nasıl güldüğümü duyabilseydin. Canım Gezginim. Sevgili tatlı Gezgin. Ben Orokin'im. Tabii ki aldırış etmem.",shape=box,color=blue];
		j735254641 -> j2354425020;
	j554083989 [label="Keşke şu anda Sanctum nasıl güldüğümü duyabilseydin. Canım Gezginim. Sevgili tatlı Gezgin.",shape=box,color=blue];
		j554083989 -> j2440034922;
	j2354425020 [label="Toplumumun ve türümün kurduğu birlikteliklerden küçümseyici ve aşağılayıcı bir şekilde keyif alma eğilimi olarak düşünüyor olabilirsin. Ancak bizler sevginin ne olduğunu bilirdik.",shape=box,color=blue];
		j2354425020 -> j3027590905;
	j2440034922 [label="Başladığı anda anladım. Anlamamı sağlayacak yöntemlerim var. Ve hayır, hiç umursamıyorum. Ben Orokin'im.",shape=box,color=blue];
		j2440034922 -> j2354425020;
	j3027590905 [label="Hiç kimse aşkı Orokin'den daha iyi anlayamamıştı. Ve biliyorduk ki, bir insanın kalbinde birden fazlasına yer olabilirdi. ",shape=box,color=blue];
		j3027590905 -> j4032786386;
	j4032786386 [label="Sadece fanatiklerin eğlenceye katılmak için fazla dar görüşlü olmalarından ötürü hayal kırıklığına uğradım.",shape=box,color=blue];
		j4032786386 -> j2755715202;
	j2755715202 [label="Peh. Bir daha düşününce, bu muhtemelen en iyisi. Bunun ne kadar saçmalığa yol açacağını hayal edebiliyor musun?",shape=box,color=blue];
		j2755715202 -> j4187170964;
	j4187170964 [label="Boolean RoatheConsentComplete is now true.",color=orange];
		j4187170964 -> j3416455553;
	j3416455553 [label="Önemli değil. Seni mutlu ediyorlarsa, tadını çıkar. Ama benim yanımdayken...",shape=box,color=blue];
		j3416455553 -> j4054178166;
	j4054178166 [label="+5 Chemistry",color=orange];
		j4054178166 -> j1557850588;
	j1557850588 [label="Yalnızca benimsin.",shape=box,color=blue];
		j1557850588 -> "Chat ends.";
}