	5410 [label="Hm? Ne oldu canım?",shape=box,color=blue];
		5410 -> 5412;
	5409 [label="Update boolean RoatheConsentComplete",color=orange];
		5409 -> 5411;
	5412 [label="Seninle bir konu hakkında konuşmak istiyorum ve bunun senin için uygun olduğundan emin olmak istiyorum.",shape=box,color=red];
		5412 -> 5413;
	5411 [label="Chat ends.",color=orange];
	5413 [label="Sana yalan söylediğimi veya sana karşı dürüst olmadığımı hissetmeni istemem.",shape=box,color=red];
		5413 -> 5414;
	5414 [label="Devam et. Kulağa oldukça iyi bir şey gibi geliyor.",shape=box,color=blue];
		5414 -> 5415;
	5415 [label="Seni istemeyeceğin bir duruma sokmak istemiyorum. Yani hayır dersen sorun değil. Sadece bilmeni istiyorum.",shape=box,color=red];
		5415 -> 5416;
	5416 [label="Yaşadığımız şey benim için önemli - çok önemli - ve hislerim gerçek. Bundan şüphe duymanı istemiyorum.",shape=box,color=red];
		5416 -> 5417;
	5417 [label="Dur bakalım. Void aşkına, başka bir partnerin olduğu haberini güzelleştirerek söylemeye mi çalışıyorsun?",shape=box,color=blue];
		5417 -> 5418;
	5418 [label="Beni aptal mı sanıyordun? Zaten biliyorum, canım Gezginim!",shape=box,color=blue];
		5418 -> 5419;
		5418 -> 5420;
	5419 [label="Sanırım bu konu senin için sorun değil?",shape=box,color=red];
		5419 -> 5421;
	5420 [label="Biliyor muydun?",shape=box,color=red];
		5420 -> 5422;
	5421 [label="Keşke şu anda Sanctum nasıl güldüğümü duyabilseydin. Canım Gezginim. Sevgili tatlı Gezgin. Ben Orokin'im. Tabii ki aldırış etmem.",shape=box,color=blue];
		5421 -> 5423;
	5422 [label="Keşke şu anda Sanctum nasıl güldüğümü duyabilseydin. Canım Gezginim. Sevgili tatlı Gezgin.",shape=box,color=blue];
		5422 -> 5424;
	5423 [label="Toplumumun ve türümün kurduğu birlikteliklerden küçümseyici ve aşağılayıcı bir şekilde keyif alma eğilimi olarak düşünüyor olabilirsin. Ancak bizler sevginin ne olduğunu bilirdik.",shape=box,color=blue];
		5423 -> 5425;
	5424 [label="Başladığı anda anladım. Anlamamı sağlayacak yöntemlerim var. Ve hayır, hiç umursamıyorum. Ben Orokin'im.",shape=box,color=blue];
		5424 -> 5423;
	5425 [label="Hiç kimse aşkı Orokin'den daha iyi anlayamamıştı. Ve biliyorduk ki, bir insanın kalbinde birden fazlasına yer olabilirdi. ",shape=box,color=blue];
		5425 -> 5426;
	5426 [label="Sadece fanatiklerin eğlenceye katılmak için fazla dar görüşlü olmalarından ötürü hayal kırıklığına uğradım.",shape=box,color=blue];
		5426 -> 5427;
	5427 [label="Peh. Bir daha düşününce, bu muhtemelen en iyisi. Bunun ne kadar saçmalığa yol açacağını hayal edebiliyor musun?",shape=box,color=blue];
		5427 -> 5428;
	5428 [label="Update boolean RoatheConsentComplete",color=orange];
		5428 -> 5429;
	5429 [label="Önemli değil. Seni mutlu ediyorlarsa, tadını çıkar. Ama benim yanımdayken...",shape=box,color=blue];
		5429 -> 5430;
	5430 [label="+5 Chemistry",color=orange];
		5430 -> 5431;
	5431 [label="Yalnızca benimsin.",shape=box,color=blue];
		5431 -> 5432;
