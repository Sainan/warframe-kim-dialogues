	j2620963742 [label="Camlaştırıcı Kalyon, Ceres sisinin içinden ölümcül kanatlarıyla yükseldi; ağır dronlar ve gümüş zırhlı myrmidon'larla dolu bir kalyon.",shape=box,color=blue];
