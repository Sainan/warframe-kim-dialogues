		j3513846686 -> j206618821;
	j206618821 [label="O kadar büyüktü ki, Solar Rayının kenarlarını ancak aşabiliyordu.",shape=box,color=blue];
		j206618821 -> j3009180168;
	j3009180168 [label="Sentient'ler sonucu görmemizi sağladılar. Şarkı söylediler ve teknolojimiz başarısız oldu. Savaşçılarımız parlak kıyafetlerinin içinde çırpınıp boğuldular.",shape=box,color=blue];
