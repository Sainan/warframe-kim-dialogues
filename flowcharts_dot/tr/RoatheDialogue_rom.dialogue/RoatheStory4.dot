		j4220514576 -> j1347721091;
	j1347721091 [label="Sentientlerin ilk keşif saldırısından sonra, biz de cezalandırıcı bir karşı saldırı hazırlamıştık.",shape=box,color=blue];
		j1347721091 -> j3600041276;
	j3600041276 [label="Camlaştırıcı Kalyon, Ceres sisinin içinden ölümcül kanatlarıyla yükseldi; ağır dronlar ve gümüş zırhlı myrmidon'larla dolu bir kalyon.",shape=box,color=blue];
		j3600041276 -> j320465301;
	j320465301 [label="Devreler, sis kadar ince, yarı saydam kaplamalarının altında narin bir dantel oluşturuyordu. ",shape=box,color=blue];
		j320465301 -> j145633187;
	j145633187 [label="O kadar büyüktü ki, Solar Rayının kenarlarını ancak aşabiliyordu.",shape=box,color=blue];
		j145633187 -> j4211936226;
	j4211936226 [label="Sentientler sonucu görmemizi sağladılar. Şarkı söylediler ve teknolojimiz başarısız oldu. Savaşçılarımız parlak kıyafetlerinin içinde çırpınıp boğuldular.",shape=box,color=blue];
		j4211936226 -> j1594487003;
	j1594487003 [label="Camlaştırıcı Kalyon adlı karmaşık ve maliyetli havai fişek gemisinin mürettebatı, Tau semalarında motorsuz bir şekilde kuğu gibi süzülürken canlı canlı yandı.",shape=box,color=blue];
		j1594487003 -> j921430358;
