	j2448398406 [label="Gaspçı, Karanlık Refraktör'de hafızamı geri kazanmak için hâlâ yapılacak işler olsa da, tüm bu lanet işin bittiğini duyurmaktan mutluluk duyuyorum.",shape=box,color=blue];
