		j2370712299 -> j1279989010;
	j3000450222 [label="Hafızamı silmeni ve yeniden başlamanı istemem sonrası yaşananlar için hem teşekkür hem de özür borçlu olduğumu düşünüyor olabilirsin. Benim sadece çektiğim tüm acılara rağmen bizi \"eşit\" kılıyor diye düşünüyorum.",shape=box,color=blue];
