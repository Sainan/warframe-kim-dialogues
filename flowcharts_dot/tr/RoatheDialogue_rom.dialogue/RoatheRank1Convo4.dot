	510 [label="Yani vaktimi boşa harcadığını kabul ediyorsun. Ne kadar harika! Ben, başka hiçbir şeyi hatırlayamadığı için tek bir savaş öyküsünü anlatan, yaşlı ve titrek bir adam değilim.",shape=box,color=blue];
		510 -> 519;
	515 [label="İşte buradayım, Orokin toplumu hakkında alacakaranlıkta ve başıboş bir nutuk atmaya hazırlanıyorum, belki ilginizi çeker diye düşünüyorum. Ve sonra kendime hatırlatıyorum, Bunların hepsini daha önce duymuşsundur, değil mi?",shape=box,color=blue];
		515 -> 500;
		515 -> 501;
		515 -> 502;
	514 [label="Bu iyi, çünkü sen veya çocuk o adımı tamamlamasaydınız pek ilerleme kaydedemezdik. Aksi takdirde, uşağı merdivenlerden yukarı gönderdiğimiz anda kıyma yemeye gitmek zorunda kalacağından korkuyorum.",shape=box,color=blue];
		514 -> 522;
	513 [label="Bu arada, teklifimi yeniden değerlendirdin mi? Uşakla yukarıdaki terk edilmiş Orokin infestedlarını barıştırmana yardım etmem karşılığında burada sessizce oturmamı mı bekliyorsun?",shape=box,color=blue];
		513 -> 520;
		513 -> 521;
	512 [label="Uşağı yukarı göndermeye çalışmadan önce, ilk önce bu sorunu çözmeye çalışsan iyi olur. Yoksa bu süreçte kıyma haline gelebilir.",shape=box,color=blue];
		512 -> 522;
	511 [label="Bu arada, teklifimi yeniden değerlendirdin mi? Uşakla yukarıdaki terk edilmiş Orokin infestedlarını barıştırmana yardım etmem karşılığında burada sessizce oturmamı mı bekliyorsun? Aileyi barıştırmak ilk adım olurdu, ama...",shape=box,color=blue];
		511 -> 520;
		511 -> 521;
	516 [label="Bir Orokin'den konuşmasını istedin. Ne yaptığın hakkında bir fikrin yok. Dikkatli olmazsan bir saat burada kalacaksın.",shape=box,color=blue];
		516 -> 523;
	517 [label="+5 Chemistry",color=orange];
		517 -> 524;
	518 [label="Ha? Ve \"lütfen\" söyle, neden?",shape=box,color=blue];
		518 -> 528;
		518 -> 527;
		518 -> 525;
		518 -> 526;
	519 [label="Bu konuşmayı hatırlayamamanın sebebi senin lanet olası aynanda yatıyor!",shape=box,color=blue];
		519 -> 529;
	522 [label="Anlaman gereken bir şey var ki, uşak ve Entrati ailesi, ne kadar uzakta olurlarsa olsunlar, hâlâ Orokin'dir. Onlar, tüm... kusurlarına rağmen, o toplumun içinde doğup, büyütüldüler.",shape=box,color=blue];
		522 -> 532;
	520 [label="Hayır, fikrimi değiştirmiyorum Roathe. O kadar da önemli değil.",shape=box,color=red];
		520 -> 530;
	521 [label="Evet. Ben... kabul ediyorum.",shape=box,color=red];
		521 -> 531;
	523 [label="Sanırım Orokin'le pek etkileşime girme fırsatın olmamış olabilir, değil mi Gezgin? Çocuk çok farklı bir hayat yaşadı.",shape=box,color=blue];
		523 -> 533;
	524 [label="Hmm. Doğru. İkimiz de bunun nedenini biliyoruz, değil mi? Ama sabırlı olacaksın.",shape=box,color=blue];
		524 -> 534;
	528 [label="[Duygularını itiraf et.] Sanırım biliyorsun.",shape=box,color=red];
		528 -> 538;
	527 [label="Seni ilgi çekici buluyorum.",shape=box,color=red];
		527 -> 537;
	525 [label="Bir Orokin'le etkileşime girme fırsatım pek olmadı. Tabii... Onlarla savaşmadığım zamanlarda. Sen çok etkileyicisin.",shape=box,color=red];
		525 -> 535;
	526 [label="Neyse boşver. [Son.]",shape=box,color=red];
		526 -> 536;
	529 [label="Chat ends.",color=orange];
	532 [label="Ve tüm bu ağır günahlarına rağmen, rütbe ve düzen asla sorgulanmadı. Ne orduda ne de sosyal yapıda. Arşimet'liler Orokin'e itaat etti. Orokin'ler İnfazcılar'a itaat etti. İnfazcılar da İmparatorlara itaat etti... en azından isim olarak.",shape=box,color=blue];
		532 -> 541;
	530 [label="Sen bilirsin. Kapı uzun süre açık kalmayacak ona göre.",shape=box,color=blue];
		530 -> 539;
	531 [label="Update boolean RoatheNoDeal",color=orange];
		531 -> 540;
	533 [label="Duyduğuma göre Zariman Ten Zero'nun trajedisinin yaşandığı o noktada yön değiştirmişsin.",shape=box,color=blue];
		533 -> 542;
		533 -> 543;
		533 -> 544;
	534 [label="Bu arada, \"dinlemek\" istersen, memnuniyetle dinlerim. Sadece bu adil bir uyarı. Bir Orokin'den konuşmasını istedin.",shape=box,color=blue];
		534 -> 545;
	538 [label="+5 Chemistry",color=orange];
		538 -> 549;
	537 [label="+5 Chemistry",color=orange];
		537 -> 548;
	535 [label="Düşmanını tanı, öyle mi? Yoksa sadece, imkânsız denilenle aynı masada oturmanın merakı mı? ",shape=box,color=blue];
		535 -> 546;
	536 [label="İstediğin kadar kıpırda balık. Bana doğru yüzdün.",shape=box,color=blue];
		536 -> 547;
	541 [label="Ve hatta bunca zamandan sonra bile, geleneklerin Loid'i beni dinlemeye teşvik edebileceğine inanmasan bile mi? Şunu düşünün ki... son derece ikna edici olabilirim. Ne de olsa, en kötü İnfazcıların sağ koluydum.",shape=box,color=blue];
		541 -> 551;
		541 -> 552;
		541 -> 553;
	539 [label="Chat ends.",color=orange];
	540 [label="Update boolean RoatheDeal",color=orange];
		540 -> 550;
	542 [label="Hayır. Zariman'dan önce ve sonra Orokin'le pek fazla muhatap olmadım, eh... eminim ki ana fikri duymuşsundur.",shape=box,color=red];
		542 -> 554;
	543 [label="Orokin'le yeterince etkileşimim oldu ve onlara güvenmemem gerektiğini biliyorum.",shape=box,color=red];
		543 -> 555;
	544 [label="Üzgünüm ama senin gibilere karşı o çocuktan daha fazla sevgim yok.",shape=box,color=red];
		544 -> 555;
	545 [label="Ne yaptığın hakkında bir fikrin yok. Dikkatli olmazsan bir saat burada kalacaksın.",shape=box,color=blue];
		545 -> 523;
	549 [label="Mm. Evet. Ben de bana yazılı olarak gösterme şerefini bahşedeceğini sanmıştım. Ah, neyse...",shape=box,color=blue];
		549 -> 557;
	548 [label="Öyle mi? Hm. Bakalım bu balığı zıpkında ne kadar tutabileceğim.",shape=box,color=blue];
		548 -> 534;
	546 [label="+5 Chemistry",color=orange];
		546 -> 556;
	547 [label="Chat ends.",color=orange];
	551 [label="İnfazcıların en kötüsü Ballas'tı.",shape=box,color=red];
		551 -> 559;
	552 [label="Sen hangisine hizmet ettin?",shape=box,color=red];
		552 -> 560;
	553 [label="How so?",shape=box,color=red];
		553 -> 561;
	550 [label="+5 Chemistry",color=orange];
		550 -> 558;
	554 [label="Gerçekten de öyle. Ah, Ballas. Onun içlerinde en kötüsü olmadığını bilmek seni şaşırtabilir.",shape=box,color=blue];
		554 -> 562;
		554 -> 563;
	555 [label="Seni suçladığımı da sanmıyorum. Kurtarılabileceklerini düşünmüştüm. Bir nevi eritilip yeniden şekillendirilebilirlerdi, altın gibi.",shape=box,color=blue];
		555 -> 564;
	557 [label="Başka bir zaman belki. Gaspçı, sen de bu anların tadını çıkarmayı öğrenmelisin.",shape=box,color=blue];
		557 -> 566;
	556 [label="Saygın. Hatta bilge. Bir Bilgeyle röportaj yapabilme ve hatta belki de arkadaş olabilme fırsatım olsaydı, ben de aynısını yapardım. ",shape=box,color=blue];
		556 -> 565;
	559 [label="Fikrine saygı duyuyorum ve seni bu konuda suçlamıyorum. Ballas bir aptaldı ve sapkınların şampiyonuydu, bu konuda seninle tartışmayacağım.",shape=box,color=blue];
		559 -> 567;
	560 [label="Evaluate expressions on HellStory",color=orange];
		560 -> 569 [label="x >= 1",color=purple];
		560 -> 568 [label="x <= 1",color=purple];
		560 -> 568 [label="false",color=purple];
	561 [label="Ballas'la kişisel ilişkilerin olduğunu biliyorum ve muhtemelen onu Yedi Altın Lord'un sunabileceği en kötü kişi olarak görmeni de suçlamıyorum. Ve o, sapkınlar arasında bir şampiyondu, bu konuda seninle tartışmayacağım.",shape=box,color=blue];
		561 -> 570;
	558 [label="Harika! Sonunda aklını başına toplamana sevindim. Artık biraz ilerleme kaydedebiliriz.",shape=box,color=blue];
		558 -> 522;
	562 [label="Gerçekten mi?",shape=box,color=red];
		562 -> 571;
	563 [label="Beni ikna etmek senin için zor olacak.",shape=box,color=red];
		563 -> 571;
	564 [label="Peki. İnfazcıları kurtar. Onlar umutsuz vakalardı. Ballas'ın içlerinde en kötüsü olmadığını bilmek seni şaşırtabilir.",shape=box,color=blue];
		564 -> 563;
		564 -> 562;
	566 [label="Update boolean DrifterRoathe",color=orange];
		566 -> 534;
	565 [label="Savaş alanında bunlardan biriyle -veya eski müttefikinle- karşılaşman durumunda psikolojik fayda sağlar.",shape=box,color=blue];
		565 -> 572;
	567 [label="Ve aslında, uşaktan öğrendiğim ve buradaki POM-2 makinesindeki kayıtlardan topladığım bu \"Narmer\" olayının dehşetine tanık olmadım.",shape=box,color=blue];
		567 -> 573;
	569 [label="Ondan daha önce bahsettiğimi duydun. Ve daha da önemlisi, planladığımız şeye dair bir ipucu. Ama bu başka bir günün konusu. İnfazcı Nitokh. Daha doğrusu, Yüce Naip İnfazcı Nitokh. Tüm askeri güçlerimizin komutanı ve Yedi Altın Lord'un en gaddar ve ölümcül olanı.",shape=box,color=blue];
		569 -> 574;
	568 [label="İnfazcı Nitokh. Daha doğrusu, Yüce Naip İnfazcı Nitokh. Orokin İmparatorluğu'nun tüm askeri kuvvetlerinin komutanı. Ve Yedi Altın Lord'un en gaddar ve ölümcül olanı.",shape=box,color=blue];
		568 -> 574;
	570 [label="Hatta bu... \"Narmer\" meselesinde, uşaklardan duyduğum ve burada POM-2'de okuduğum eski İnfazcıları bile geride bırakmış olması oldukça mümkün.",shape=box,color=blue];
		570 -> 573;
	571 [label="Onun bir aziz olduğunu söylemiyorum. Sana söylüyorum ki, en kötü şeytanlar bile onun akranlarından biraz daha üstündü. Gaspçı ben sadece kılı kırk yararak bir şey söyledim.",shape=box,color=blue];
		571 -> 575;
	572 [label="Peki, \"dinlemek\" istersen, memnuniyetle dinlerim. Sadece bu adil bir uyarı. Bir Orokin'den konuşmasını istedin.",shape=box,color=blue];
		572 -> 545;
	573 [label="Ancak, aynı zamanda, Ballas'a olan kişisel yakınlığını ve diğer altı Altın Lord'la olan sınırlı etkileşimlerin sana bu izlenimi verdiğini de öne sürüyorum.",shape=box,color=blue];
		573 -> 574;
	574 [label="Altın Yedili. Bah. Altının en güzel yanı ne biliyor musun, Gezgin? Sonsuza dek eritilip daha iyi bir şeye dönüştürülebilir.",shape=box,color=blue];
		574 -> 576;
	575 [label="Peki Ballas en kötüsü müydü? Belki de sana göre öyle. Ve belki de bu dönemdeki suçları eski İnfazcıları geride bırakmıştı.",shape=box,color=blue];
		575 -> 577;
	576 [label="Orokin'lerin kurtarılabilir olduğuna inanıyordum - ve bir bakıma hâlâ inanıyorum. İmparatorluğu tersine çevirebileceğimize. Peki ya İnfazcılar? Hayır. Durdurulmaları gerekiyordu. Onlar, insanlığın sunabileceği en kötü şeydi, küçük bir farkla.",shape=box,color=blue];
		576 -> 578;
	577 [label="Ama eğer kızıl göllere ve bükülmüş ve parçalanmış ceset tarlalarına baksaydın, tıpkı atılmış çocuk oyuncakları gibi -",shape=box,color=blue];
		577 -> 579;
	578 [label="Ve bu benden geliyor, Gaspçı. Öyleyse, Tau'nun Şeytanı olarak, bir uzman olarak size şunu temin edeyim: Ballas, aralarındaki en kötüsü değildi.",shape=box,color=blue];
		578 -> 580;
	579 [label="Nitokh'un bir anlık düşünceyle yaratabileceği saf yıkımı görseydin... ",shape=box,color=blue];
		579 -> 581;
	580 [label="Check boolean RoatheUsurper",color=orange];
		580 -> 583 [label=true,color=green];
		580 -> 584 [label=true,color=green];
		580 -> 582 [label=false,color=brown];
		580 -> 583 [label=false,color=brown];
		580 -> 584 [label=false,color=brown];
	581 [label="Ama böyle dehşetleri, bizzat tanık olmadan hissetmek zordur. Böyle bir trajedi sayılarla anlatılamaz. Gördüklerimi uzun uzun anlatabilirim, ama senin için bunlar sadece hikâye olarak kalacaktır.",shape=box,color=blue];
		581 -> 585;
	583 [label="Beni ikna etmek senin için zor olacak.",shape=box,color=red];
		583 -> 587;
	584 [label="Gerçekten mi?",shape=box,color=red];
		584 -> 587;
