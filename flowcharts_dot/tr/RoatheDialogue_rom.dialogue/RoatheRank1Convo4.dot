	498 [label="İşte buradayım, Orokin toplumu hakkında alacakaranlıkta ve başıboş bir nutuk atmaya hazırlanıyorum, belki ilginizi çeker diye düşünüyorum. Ve sonra kendime hatırlatıyorum, burada olma sebebin bu değil, değil mi Gezgin? Oynayacağın başka bir oyun daha var...",shape=box,color=blue];
		498 -> 506;
	497 [label="İşte buradayım, Orokin toplumu hakkında alacakaranlıkta ve başıboş bir nutuk atmaya hazırlanıyorum, belki ilginizi çeker diye düşünüyorum. Ve sonra kendime hatırlatıyorum, Bunların hepsini daha önce duymuşsundur, değil mi?",shape=box,color=blue];
		497 -> 505;
	499 [label="Sadece oyuna katılmamı mı tercih edersin? Yoksa... bunu yaparak belirli bir amaca mı ulaşmaya çalışıyorsun? Bu acımasız oyunu oynayarak ne elde etmeyi umduğunu anlamakta epeyce güçlük çekiyorum.",shape=box,color=blue];
		499 -> 507;
	494 [label="Evet, nekraloidden duydum. Ama sen veya çocuk onları çözmek için çalıştığından beri sayıları azalmış gibi görünüyor. En azından artık birbirlerini -kelimenin tam anlamıyla- parçalamıyorlar.",shape=box,color=blue];
		494 -> 504;
	493 [label="Evet, nekraloidden duydum. Hâlâ birbirlerini parçalamaya niyetli görünüyorlar.",shape=box,color=blue];
		493 -> 503;
	496 [label="Hımm? Ah. Nekraloid bana, senin veya çocuğun, orijinal isimlerini unuttuktan sonra kendilerine sahte isimler uydurmalarına yardım ettiğinizi söyledi. Onu \"Vilcor\" olarak tanıyorsunuz. Ama ben onu Petros Vorten olarak tanıyordum. Nekramech Filosu'nun gururlu mucidi.",shape=box,color=blue];
		496 -> 504;
	495 [label="Hımm? Ah. Onu Petros Vorten olarak tanıyordum. Nekramech Filosu'nun gururlu mucidi. Ama nekraloid bana isimlerini unuttuklarını söyledi. Onu hâlâ sadece \"Baba\" olarak biliyor olabilirsiniz.",shape=box,color=blue];
		495 -> 503;
	500 [label="Hayır, bunu daha önce duymamıştım. Lütfen devam et.",shape=box,color=red];
