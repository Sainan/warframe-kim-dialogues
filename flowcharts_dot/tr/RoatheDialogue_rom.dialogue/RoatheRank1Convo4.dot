	474 [label="Euleria ve Petros'un başına gelenler neredeyse trajik. Asla arkadaş olmadık. Ama onlar yine de Orokin'di. Ve şimdi bizden çok azı kaldı. Yine de ne söylediğime dikkat etmeliyim sanırım - yeterince zaman geçerse, neye dönüşeceğimi kim bilir.",shape=box,color=blue];
		474 -> 476;
	475 [label="Euleria ve Petros'un burada olduğumuzdan en ufak bir haberleri olmaması bana biraz komik geliyor. Sıçanlar gibi, ayaklarının altında koşturuyorlar. Sen ve çocuklar tüm bunları bu kadar uzun süre nasıl gizli tutmayı başardınız?",shape=box,color=blue];
		475 -> 477;
	476 [label="Hayatta kalmasına en az şaşırdığım isim ise \"Büyükanne\" oldu. (Dagath gibi mükemmel bir ismi başkasına vermek gibi bir şeyi hayal edin.)",shape=box,color=blue];
		476 -> 478;
		476 -> 479;
