		478 -> 482;
	479 [label="Çocuklar hakkında ne düşünüyorsun?",shape=box,color=red];
		479 -> 483;
	481 [label="Dürüst olmak gerekirse, \"Büyükanne\"nin bunu becerememiş olmasına çok şaşırdım. (Dagath gibi mükemmel bir ismi başkasına vermek gibi bir şeyi hayal edin.) Onun bundan daha mantıklı bir insan olduğunu düşünmüştüm.",shape=box,color=blue];
		481 -> 486;
	480 [label="Dürüst olmak gerekirse, \"Büyükanne\"nin bunu becerememiş olmasına çok şaşırdım. (Dagath gibi mükemmel bir ismi başkasına vermek gibi bir şeyi hayal edin.) Onun bundan daha fazla zekâya sahip olduğunu düşünmüştüm.",shape=box,color=blue];
		480 -> 484;
		480 -> 485;
	482 [label="Hımm? Ah. Nekraloid bana, senin veya çocuğun, orijinal isimlerini unuttuktan sonra kendilerine sahte isimler uydurmalarına yardım ettiğinizi söyledi. Onu \"Vilcor\" olarak tanıyorsunuz.",shape=box,color=blue];
		482 -> 487;
	483 [label="Çocuk huysuz, sinir bozucu ve benmerkezci. Mükemmel bir Orokin. \"Kaelli\" (artık böyle hitap edilmeyi tercih ediyor) diye adlandırmayı tercih ettiğini söylediği bu çocuğu son derece zeki buluyorum ve neredeyse varlığına katlanmaya değer buluyorum.",shape=box,color=blue];
		483 -> 488;
	486 [label="Ben. Bu saçmalık. Tüm bunları daha önce yaşadığımızı biliyorum. Ve bundan daha önce de bahsetmiştik. Bu, benim hâlâ derinden rahatsız olduğum bir konu.",shape=box,color=blue];
		486 -> 491;
	484 [label="Onların da odaklanmaları gereken kendi... sorunları var.",shape=box,color=red];
		484 -> 489;
	485 [label="Petros mu?",shape=box,color=red];
		485 -> 490;
	487 [label="Ama ben onu Petros Vorten olarak tanıyordum. Necramech Filosu'nun gururlu mucidi. Onun için ne kadar zaman geçtiğini, benim içinse -nispeten- ne kadar az zaman geçtiğini düşünmek oldukça tuhaf.",shape=box,color=blue];
		487 -> 488;
	488 [label="Ama bunu nasıl bilmiyorsun? Beni aptal yerine mi koyuyorsun, Gaspçı? Elbette... eski bir konuyu tekrar gündeme getiriyoruz, değil mi?",shape=box,color=blue];
		488 -> 492;
