	j842147052 [label="Bu oldukça adil. Ancak tarihimizin ve kültürel kayıtlarımızın büyük bir kısmını kaçırıyorsun. Düşüşten sonra bize karşı pek sevgi olmadığını biliyorum ama...",shape=box,color=blue];
