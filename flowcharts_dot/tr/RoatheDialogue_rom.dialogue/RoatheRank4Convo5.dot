		j2792688034 -> j3154566547;
	j1325544804 [label="Şaşırtıcı mı? Hayır. Belki de son... çok uzun yıllarımı bu iki fanatikle birlikte bir mezarda geçirdiğim içindir, ama Orokinlerin ölüleriyle nasıl başa çıktıklarına dair hiçbir kayıt binlerce yıl boyunca günümüze ulaşmamış olması beni çok şaşırtıyor.",shape=box,color=blue];
