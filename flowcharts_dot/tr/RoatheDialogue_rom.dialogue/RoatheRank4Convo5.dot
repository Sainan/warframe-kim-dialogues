	j648832052 [label="Öldüğünü sanmıyordum. Yuvan Tiyatrosu'ndan yeni bedenler çaldın sadece.",shape=box,color=red];
		j648832052 -> j309526059;
	j807053086 [label="Devam et.",shape=box,color=red];
		j807053086 -> j3554540904;
	j3012051031 [label="Evet, peki, ''yakın'' ama ''yeterince önemli olmayan'' diğerleri ne olacak? Arşimetçiler? Ya da daha düşük rütbeli Orokinler? Her zaman kademeler içinde kademeler vardı. Tavanlar camdan olsa bile, onlar vardı. İnan bana.",shape=box,color=blue];
		j3012051031 -> j2247974348;
	j1396582215 [label="Gerçekten de öyle yaptık. Mümkün olan her fırsatta. Ama hepsi kurtulamadı, değil mi? Peki ya ''yakın'' ama ''yeterince önemli olmayan'' diğerleri ne olacak? Arşimetçiler? Ya da daha düşük rütbeli Orokinler?",shape=box,color=blue];
		j1396582215 -> j225386532;
	j801027368 [label="''Yakın'' ama ''yeterince önemli olmayan'' tüm kişileri düşün. Arşimetçiler. Düşük rütbeli Orokinler. Her zaman kademeler içinde kademeler vardı. Tavanlar camdan olsa bile, onlar vardı. İnanın bana.",shape=box,color=blue];
		j801027368 -> j2247974348;
	j309526059 [label="Evet, peki, ''yakın'' ama ''yeterince önemli olmayan'' diğerleri ne olacak? Arşimetçiler? Ya da daha düşük rütbeli Orokinler? Her zaman kademeler içinde kademeler vardı. Tavanlar camdan olsa bile, onlar vardı. İnan bana.",shape=box,color=blue];
		j309526059 -> j1115977806;
	j3554540904 [label="''Yakın'' ama ''yeterince önemli olmayan'' tüm kişileri düşün. Arşimetçiler. Düşük rütbeli Orokinler. Her zaman kademeler içinde kademeler vardı. Tavanlar camdan olsa bile, onlar vardı. İnanın bana.",shape=box,color=blue];
		j3554540904 -> j1115977806;
	j2247974348 [label="Eski bedenleri her yandığında yeni bir bedenle ödüllendirilecek kadar şanslı olanlar yoktu. Ama eminim ki Yuvan Tiyatrosu'nu iğrenç bir uygulama olarak görüyorsun, değil mi?",shape=box,color=blue];
		j2247974348 -> j343121611;
		j2247974348 -> j243577454;
	j225386532 [label="Eski bedenleri her yandığında yeni bir bedenle ödüllendirilecek kadar şanslı olanlar yoktu. Belli ki Yuvan Tiyatrosu'nun iğrenç bir uygulama olduğuna inanıyorsun.",shape=box,color=blue];
		j225386532 -> j3788762947;
		j225386532 -> j243577454;
	j1115977806 [label="Eski bedenleri her yandığında yeni bir bedenle ödüllendirilecek kadar şanslı olanlar yoktu. Ama eminim ki Yuvan Tiyatrosu'nu iğrenç bir uygulama olarak görüyorsun, değil mi?",shape=box,color=blue];
		j1115977806 -> j1881462316;
		j1115977806 -> j2327128435;
	j343121611 [label="Uygulama hakkında bir yargıya varacak kadar bilgim yok.",shape=box,color=red];
		j343121611 -> j3202662661;
	j243577454 [label="Evet. Hepinizin yaptığının iğrenç olduğunu düşünüyorum. Yuvan Tiyatrosu hakkında yazılan her şey, çocukları çalıp zihinlerini sildiğinizi söylüyor.",shape=box,color=red];
		j243577454 -> j1269370527;
	j3788762947 [label="Nasıl yapmayayım ki? Çocukları evlerinden kaçırdınız ve zihinlerini yok edip yerine kendi zihinlerini koydunuz!",shape=box,color=red];
		j3788762947 -> j3252774860;
	j1881462316 [label="Uygulama hakkında bir yargıya varacak kadar bilgim yok.",shape=box,color=red];
		j1881462316 -> j3784836715;
	j2327128435 [label="Evet. Hepinizin yaptığının iğrenç olduğunu düşünüyorum. Yuvan Tiyatrosu hakkında yazılan her şey, çocukları çalıp zihinlerini sildiğinizi söylüyor.",shape=box,color=red];
		j2327128435 -> j2346772388;
	j3202662661 [label="+5 Chemistry",color=orange];
		j3202662661 -> j1850705371;
	j1269370527 [label="\"Yuvan Tiyatrosu hakkında yazılan her şey şunu söylüyor: Bütün bunlar nerede kayıtlı? Daha da önemlisi, bütün bunları kim yazdı?",shape=box,color=blue];
		j1269370527 -> j2823835178;
	j3252774860 [label="Peki tüm bunları nereden biliyorsun? Yuvan Tiyatrosu'nu kendi gözlerinle mi gördün?",shape=box,color=blue];
		j3252774860 -> j2472960175;
		j3252774860 -> j3632905145;
		j3252774860 -> j3641796028;
	j3784836715 [label="+5 Chemistry",color=orange];
		j3784836715 -> j1850705371;
	j2346772388 [label="Oysa az önce tarihimizin ve kültürel kayıtlarımızın sadece kırıntılarının kaldığını söyledin. Peki tüm bunlar nerede kayıtlı? Daha da önemlisi, tüm bunları kim yazdı?",shape=box,color=blue];
		j2346772388 -> j2823835178;
	j1850705371 [label="Tüm bilgileri elde edene kadar yargılamak istemiyorsun? Hayret, Gaspçı! Akıllı konuşuyorsun! Ne kadar nadir bir durum!",shape=box,color=blue];
		j1850705371 -> j3981360719;
	j2823835178 [label="Bunlar, Orokin'in her yönünü olabildiğince felaket ve kötülük dolu bir ışıkta göstermeye özel bir ilgi duyanlar tarafından anlatılan hikayelerdir.",shape=box,color=blue];
		j2823835178 -> j3965867450;
	j2472960175 [label="Hayır.",shape=box,color=red];
		j2472960175 -> j3555471819;
	j3632905145 [label="Evet.",shape=box,color=red];
		j3632905145 -> j1265260614;
	j3641796028 [label="Orada bulunmuş olmamın bir önemi yok, gerçekler ortada.",shape=box,color=red];
		j3641796028 -> j225477321;
	j3981360719 [label="O zaman, izin verirsen, tarihe bir göz atalım. Yuvan Tiyatrosu'yla ilgili duymuş olabileceğin anlatıların nereden kaynaklandığını düşün.",shape=box,color=blue];
		j3981360719 -> j2823835178;
	j3965867450 [label="Origin Sistemi toplumunun tüm destekleyici yapılarını yıkıp onu tam bir kaosa sürükleyenler, o topluma güvenenlere bunu yapmaları için geçerli bir sebep vermelidirler.",shape=box,color=blue];
		j3965867450 -> j1175203922;
	j3555471819 [label="O zaman ikinci el hikayelere güveniyorsun. Bu hikayelerin nerede yazıldığını düşün. Daha da önemlisi, bunları kimin yazdığını düşün.",shape=box,color=blue];
		j3555471819 -> j2823835178;
	j1265260614 [label="Ha! Yalancı. ",shape=box,color=blue];
		j1265260614 -> j3145640659;
	j225477321 [label="Öyle mi? Bu hesapların nerede yazıldığını düşün. Daha da önemlisi, tüm bu hesapları kimin yazdığını düşün.",shape=box,color=blue];
		j225477321 -> j2823835178;
	j1175203922 [label="Bayrak yarışındaki sıradan bir insanın hayatını düşün, Gaspçı. Tenno'nun sıkıntılarından ve zorluklarından çok uzakta olan biri. Büyük Savaş'ı hiç umursamayan biri.",shape=box,color=blue];
		j1175203922 -> j899209197;
	j3145640659 [label="İkinci el hikayelere güveniyorsun. Bu hikayelerin nerede yazıldığını düşün. Daha da önemlisi, bunları kimin yazdığını düşün.",shape=box,color=blue];
		j3145640659 -> j2823835178;
	j899209197 [label="Orokin düştüğünde, hayatları, ardından gelen iktidar boşluğunda tam bir cehenneme dönüştü. Açıklamalar uydurulmalıydı. Heykeller yapılmalı ve yakılmalıydı. Bizler karanlıkta canavarlar haline getirilmeliydik.",shape=box,color=blue];
		j899209197 -> j3037371497;
		j899209197 -> j3556677419;
	j3037371497 [label="Bana Yuvan Tiyatrosu için çocukları zorla kaçırmadığını mı söylüyorsun?",shape=box,color=red];
		j3037371497 -> j239869688;
	j3556677419 [label="Peki Yuvan Tiyatrosu’nda gerçekte ne yaşandı?",shape=box,color=red];
		j3556677419 -> j3434640695;
	j239869688 [label="Hayır, bu tamamen doğru.",shape=box,color=blue];
		j239869688 -> j859592877;
	j3434640695 [label="+5 Chemistry",color=orange];
		j3434640695 -> j1633222913;
	j859592877 [label="Sadece kaynaklarını göz önünde bulundurmanı istiyorum, hepsi bu.",shape=box,color=blue];
		j859592877 -> j3815952728;
	j1633222913 [label="Onların iradesine karşı fedakarlık yapmadığımızı söylemek yanlış. Yaptık. Ama gerçek bu değil. Bu işler nadiren bu kadar basittir ve asla bu kadar net değildir.",shape=box,color=blue];
		j1633222913 -> j340425081;
	j3815952728 [label="Çünkü gerçeğin tamamı bu değil. Bu şeyler nadiren bu kadar basit ve asla bu kadar siyah beyaz değildir. Dünya gri, Gaspçı. Çizgiler o kadar kolay çizilmez. ",shape=box,color=blue];
		j3815952728 -> j2526507296;
	j340425081 [label="Dünya gri, Gaspçı. Çizgiler o kadar kolay çizilmez.",shape=box,color=blue];
		j340425081 -> j2526507296;
	j2526507296 [label="Bu uygulama bu kadar utanç verici bir şekilde başlamamıştı. Başlangıçta en büyük onur olarak görülüyordu. İmparatorluğun bozulmadan devam etmesi için kendini feda etmek. Boyun eğmemek. Böylece işlerin devam edebilmesi için.",shape=box,color=blue];
		j2526507296 -> j3910734206;
	j3910734206 [label="Bu, gençlerle de başlamadı. Sadece daha uzun yıllar yaşayacak olanlarla başladı. Ama sonra kendilerini sunanlar... gittikçe daha genç hale geldi. Bağlılık güçlü bir uyuşturucudur.",shape=box,color=blue];
		j3910734206 -> j2641484583;
	j2641484583 [label="Savaşa kaydolanlarda da benzer bir şey gördüm. \"İyi mücadeleyi\" sürdürmek için evraklarda yaşları hakkında yalan söylüyorlardı. İstemeden peşlerinden gelecekler için tehlikeli bir emsal oluşturduklarının farkında bile değillerdi.",shape=box,color=blue];
		j2641484583 -> j3382308120;
	j3382308120 [label="Bir noktada, bazı İnfazcılar bunun bir... cezai önlem olarak kullanılabileceğini fark etti. Yuvan Tiyatrosu'nun tehdidi kullanılırsa, belirli şehirler veya... tüm gezegenler kontrol altında tutulabilirdi. Eğer kurbanlar özellikle sert bir şekilde toplanırsa.",shape=box,color=blue];
		j3382308120 -> j585958730;
		j3382308120 -> j3106164469;
	j585958730 [label="Peki sen bu konuda ne düşünüyorsun?",shape=box,color=red];
		j585958730 -> j2325416010;
	j3106164469 [label="Hiç istemeyerek bir fedakarlıkta bulundun mu?",shape=box,color=red];
		j3106164469 -> j4034447286;
	j2325416010 [label="+5 Chemistry",color=orange];
		j2325416010 -> j2386624151;
	j4034447286 [label="Sana yalan söylemeyeceğim. Yaptım. Ve bunun için beni istediğin kadar canavar olarak görebilirsin. Ama tüm toplumun yüzlerce yıldır bir şeyi normalleştirerek inşa edilmişse, ona sırtını dönmek çok zordur.",shape=box,color=blue];
		j4034447286 -> j2423149259;
	j2386624151 [label="Hm. Karışık. Bir yandan, ben de birçok kez tiyatroya katıldım. Bunu kınamakla büyük bir ikiyüzlülük etmiş olurum. Tüm toplumunuz yüzlerce yıldır bir şeyin normalleşmesi üzerine kurulmuşsa, ona sırtınızı dönmek çok zordur.",shape=box,color=blue];
		j2386624151 -> j726702927;
	j2423149259 [label="Geriye dönüp baktığımızda ya da bir aydınlanma anında bile, her şey çok açık. ",shape=box,color=blue];
		j2423149259 -> j1463633153;
	j726702927 [label="Ancak, tek başına veya geriye dönük olarak bakıldığında, bu eylemin dehşeti açıkça ortaya çıkmaktadır.",shape=box,color=blue];
		j726702927 -> j1463633153;
	j1463633153 [label="+5 Chemistry",color=orange];
		j1463633153 -> j3788886002;
	j3788886002 [label="Hiç kimse sonsuza kadar yaşamamalı, Gaspçı. Ve Tiyatro bunun nedenini kanıtlıyor.",shape=box,color=blue];
		j3788886002 -> "Chat ends.";
}