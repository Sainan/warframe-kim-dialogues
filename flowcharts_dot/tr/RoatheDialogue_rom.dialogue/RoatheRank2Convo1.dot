	627 [label="Söyle bakalım, teklifim hakkında fikrini mi değiştirdin? Bu senin son şansın, Gaspçı. Sabırlı bir şeytanım ama aptal gibi sonsuza kadar beklemek zorunda kalmaktan hoşlanmam.",shape=box,color=blue];
