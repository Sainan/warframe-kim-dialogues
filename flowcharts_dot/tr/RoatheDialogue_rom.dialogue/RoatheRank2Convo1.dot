		j3722349011 -> j1803853993;
	j2947862933 [label="Onlardan pek hoşlanmıyorsun sanırım. Neden?",shape=box,color=red];
		j2947862933 -> j922132905;
	j1197119662 [label="Nasıl istersen. Baştan uyarayım, bu son fırsatındı. Artık kendi başınasın.",shape=box,color=blue];
