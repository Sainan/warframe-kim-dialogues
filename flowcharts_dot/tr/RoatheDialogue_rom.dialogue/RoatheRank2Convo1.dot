		j858328021 -> j1512694042;
	j1564495478 [label="Hangisinin geleceği her zaman yazı tura atmak gibidir ve ben hangisini daha çok tercih ettiğime asla karar veremiyorum.",shape=box,color=blue];
		j1564495478 -> j3346163290;
	j3759808409 [label="O kadın, Albrecht'e olan sarsılmaz ve takıntılı bağlılığında bitmek bilmeyen bir kararlılığa sahip. Uşağın endişelenmesi gerektiğini düşünüyorum ama dürüst olmak gerekirse, bunun masum bir bağlılık olduğuna kesinlikle inanıyorum. Ve bu da benden geliyor.",shape=box,color=blue];
		j3759808409 -> j1948537453;
