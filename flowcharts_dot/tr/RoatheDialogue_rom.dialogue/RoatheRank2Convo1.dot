	j2964478661 [label="Lyon'un... başa çıkması gereken çok şey var. Ve ben bunların üstesinden nasıl geleceğimi bilmiyorum.",shape=box,color=red];
		j2964478661 -> j824851644;
	j3614997815 [label="Marie, Entrati'nin gerçek yüzünü göremeyecek. Ve ne yaparsam yapayım, ona gerçeği gösteremiyorum.",shape=box,color=red];
		j3614997815 -> j654231128;
	j3717830128 [label="Bak, serumu neden aldığınla ilgili bir... şey var ve ben... yanlış zamanlarda yanlış şeyler söyledim.",shape=box,color=red];
		j3717830128 -> j3578978584;
	j3029149704 [label="Biraz utanç verici olabilir ama... Üçünüzden birine karşı hislerim var.",shape=box,color=red];
		j3029149704 -> j2294616187;
		j3029149704 -> j1258700462;
		j3029149704 -> j2418441564;
	j1805921259 [label="Senden ve diğerlerinden Loid'i yukarıdaki aileyle yeniden bir araya getirmeme yardım etmelerini istiyorum ve... Ben... bunu yapamadım...",shape=box,color=red];
		j1805921259 -> j167454368;
	j2596681501 [label="Hayır, Lyon... pek konuşkan birine benzemiyor.",shape=box,color=red];
		j2596681501 -> j2913104011;
	j722749537 [label="Marie ile aram gayet iyi. Neden ona yalaka diyorsun?",shape=box,color=red];
		j722749537 -> j3167762560;
	j2384205169 [label="Onlardan pek hoşlanmıyorsun sanırım. Neden?",shape=box,color=red];
		j2384205169 -> j3144442654;
	j2919962586 [label="Hayır. Üzgünüm. Orokin'le anlaşma yapmam. Ne o zaman, ne şimdi, ne de sonsuza dek.",shape=box,color=red];
		j2919962586 -> j4016599250;
	j1262572599 [label="Umarım beni pişman etmezsin Roathe. Tamam. Anlaştık.",shape=box,color=red];
		j1262572599 -> j3466471617;
	j2542221613 [label="\"Şimdilik.\" İlginç. Ve biz gerçekten de sadece adımlarımızı geri izliyoruz, sanki saraylıların bir dansın hareketlerini taklit etmesi gibi? Tekrar tekrar, kendimizi tekrarlamaya mahkûm muyuz?",shape=box,color=blue];
		j2542221613 -> j4129658744;
		j2542221613 -> j3158793363;
	j1803853993 [label="Sanırım bunu sen daha iyi bilirsin, değil mi? Bu kadar tahmin edilebilir olması ilginç. Onun kadar paramparça olmuş birinin bile ara sıra güvenebileceğini bilmek güzel.",shape=box,color=blue];
		j1803853993 -> j150880069;
	j922132905 [label="Zaten bilmiyor musun? Mm. Belki de o kadar ileri gitmedin. Ya da bu küçük macerada ilk ya da yirmi bininci seferde sormayı düşünmedin.",shape=box,color=blue];
		j922132905 -> j150880069;
	j3047021577 [label="Ha. Ve unutmadan bir şey daha?",shape=box,color=blue];
		j3047021577 -> j3338421168;
	j1199283943 [label="Ruhunu şeytana nasıl sattın, hem de iki kere... beni yatağıma çekmek için bir anlaşma mı yaptın? Yoksa kalbimin peşinde misin Gaspçı? Mm. Göreceğiz. Ama zamanla.",shape=box,color=blue];
		j1199283943 -> j540354765;
	j1018928785 [label="Zamanı geldiğinde, küçük yalakamız Gaspçı'yı baştan çıkarmak için yolunun açık olmasını sağlayacağım. Halloldu say.",shape=box,color=blue];
		j1018928785 -> j540354765;
	j4147558268 [label="Zamanı geldiğinde, zavallı perişan rahip Gaspçı'yı baştan çıkarmak için yolunun açık olmasını sağlayacağım. Halloldu say.",shape=box,color=blue];
		j4147558268 -> j1578886117;
	j609334317 [label="Zamanı gelince bunu hatırlayacağım. Anılarım konusunda bir anlaşmazlık daha yaşarsak, senin daha önceki hatalarını tekrarlamayız.",shape=box,color=blue];
		j609334317 -> j2733383514;
	j286697103 [label="Zamanı geldiğinde, o küçük uşağın o merdivenlerden çıkmasını sağlayacağım. Halledilmiş say.",shape=box,color=blue];
		j286697103 -> j540354765;
	j31276347 [label="Marie ile olan meseleni ve onun Entrati'ye olan yalaka hayranlığını bir düşün. Zamanı gelince, ben hallederim.",shape=box,color=blue];
		j31276347 -> j2928406140;
	j4106837365 [label="Lyon'la olan meseleni ve onun dehşetini bir düşün, Gaspçı. Zamanı gelince, ben hallederim.",shape=box,color=blue];
		j4106837365 -> j976164344;
	j3893818997 [label="Ben... sanırım neyin peşinde olduğunu unuttum. Anılarımla oynadığın için seni suçluyorum. Bu neydi şimdi?",shape=box,color=blue];
		j3893818997 -> j2953660143;
	j824851644 [label="Bunun yerine sabırlı olmanı tavsiye ederim, ama... yanındaki lazer kazma dururken sana keski kullanmanı söylemek bana düşmez.",shape=box,color=blue];
		j824851644 -> j647329172;
	j654231128 [label="Hm. Anlıyorum. Dürüst olmak gerekirse, bu, asil bir çaba. Ben de birçok kez denedim. Ve aynı şekilde başarısız oldum.",shape=box,color=blue];
		j654231128 -> j2586084119;
	j3578978584 [label="Hm.",shape=box,color=blue];
		j3578978584 -> j4014211041;
	j2294616187 [label="Lyon.",shape=box,color=red];
