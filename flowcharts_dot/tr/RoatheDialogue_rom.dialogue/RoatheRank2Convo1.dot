	662 [label="Hm. Anlıyorum. Sana bir anlaşma teklif ettim ve sen bir şekilde anlaşmanın kendi payına düşen kısmını yerine getiremedin, bu yüzden ödülünün gözden kaybolduğunu gördün.",shape=box,color=blue];
		662 -> 685;
	665 [label="Konuştuğunda ise genelde iki kategoriye ayrılıyor: korkunç derecede saçma ya da korkunç derecede delice.",shape=box,color=blue];
		665 -> 688;
	666 [label="Hımm? Şimdiye kadar kurtulabildin mi? Sana çok imreniyorum. Ancak patlama alanına yakalanman uzun sürmeyecek, bu yüzden önceden haberinin olması en iyisi.",shape=box,color=blue];
		666 -> 689;
	667 [label="Zavallı, Gezgin. Orokinlerin kutsal tanrılara dair her türlü düşünceyi ne kadar katı bir şekilde reddettiğini unuttun mu? Tapındığımız tek şey kendimizdi.",shape=box,color=blue];
		667 -> 690;
