		622 -> 627 [label="false",color=purple];
	623 [label="Öyleyse, yapacak daha iyi bir şey olmadığı için devam edeceğim. \"Bu arada, bizim küçük yalakayla aran nasıl? Sanırım rahip hâlâ seninle konuşmuyor.\" Bah. Ne saçmalık.",shape=box,color=blue];
		623 -> 629;
