	609 [label="Kendi kaderimi şekillendirmek için benimle iş çevirmiş olmanı inanılmaz derecede ilginç buluyorum. Ne de olsa şeytan, kendi bedeniyle pazarlık eder.",shape=box,color=blue];
		609 -> 619;
	608 [label="Senin tarafında ilerlemeler nasıl gidiyor, Gaspçım? Senin lehine ipleri ve kaldıraçları çekmekle meşgulüm, her ne kadar etkim şimdiye kadar görülmese ve hissedilmese de.",shape=box,color=blue];
		608 -> 619;
	610 [label="Teklifim hakkında fikrini değiştirdiğini söyle bana. Daha önce serumu alma konusunda bir engel teşkil etmiş olabilir miyim? Artık bir kar terriski kadar uysal olacağım.",shape=box,color=blue];
		610 -> 620;
	611 [label="Teklifim hakkında fikrini değiştirdiğini söyle bana. Bu Marie sorununu senin için çözebilirim. Onunla romantik hedeflerine kolayca ulaşmanı sağlayacağım.",shape=box,color=blue];
		611 -> 620;
	612 [label="Teklifim hakkında fikrini değiştirdiğini söyle bana. Lyon sorununu senin için çözebilirim. Onunla romantik hedeflerine kolayca ulaşmanı sağlayacağım.",shape=box,color=blue];
		612 -> 620;
	613 [label="Teklifim hakkında fikrini değiştirdiğini söyle bana. Daha önce serumu alma konusunda bir engel teşkil etmiş olabilir miyim? Artık bir kar terriski kadar uysal olacağım.",shape=box,color=blue];
		613 -> 620;
	614 [label="Teklifim hakkında fikrini değiştirdiğini söyle bana. Uşak ve ailesini yeniden bir araya getirirken bir engel teşkil etmiş olabilir miyim? Artık bir kar terriski kadar uysal olacağım.",shape=box,color=blue];
		614 -> 620;
	615 [label="Teklifim hakkında fikrini değiştirdiğini söyle bana - Bu Marie sorununu senin için çözebilirim. Onunla yapacağın görüşmelerde rahat olmanı sağlayacağım.",shape=box,color=blue];
		615 -> 620;
	616 [label="Teklifim hakkında fikrini değiştirdiğini söyle bana - Bu Lyon sorununu senin için çözebilirim. Onunla yapacağın görüşmelerde rahat olmanı sağlayacağım.",shape=box,color=blue];
		616 -> 620;
	617 [label="Senin bu konuşmalarımızda bir nedenden dolayı oyalanıp durduğunu düşünmeden edemiyorum, Gaspçı. Ve bu konuda sana yardımcı olabileceğim bir şey olabilir.",shape=box,color=blue];
		617 -> 621;
