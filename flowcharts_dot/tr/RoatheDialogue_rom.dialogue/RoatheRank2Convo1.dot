	j1258700462 [label="... Sen.",shape=box,color=red];
		j1258700462 -> j1232633125;
	j2418441564 [label="Marie.",shape=box,color=red];
		j2418441564 -> j1172085354;
	j167454368 [label="Hm. Anlıyorum. Sana bir anlaşma teklif ettim ve sen bir şekilde anlaşmanın kendi payına düşen kısmını yerine getiremedin, bu yüzden ödülünün gözden kaybolduğunu gördün.",shape=box,color=blue];
		j167454368 -> j858328021;
	j2913104011 [label="Konuştuğunda ise genelde iki kategoriye ayrılıyor: korkunç derecede saçma ya da korkunç derecede delice.",shape=box,color=blue];
		j2913104011 -> j1564495478;
	j3167762560 [label="Hm? Şimdiye kadar kurtulabildin mi? Sana çok imreniyorum. Ancak patlama alanına yakalanman uzun sürmeyecek, bu yüzden önceden haberinin olması en iyisi.",shape=box,color=blue];
		j3167762560 -> j3759808409;
	j3144442654 [label="Zavallı, Gezgin. Orokinlerin kutsal tanrılara dair her türlü düşünceyi ne kadar katı bir şekilde reddettiğini unuttun mu? Tapındığımız tek şey kendimizdi.",shape=box,color=blue];
		j3144442654 -> j1592562624;
	j4016599250 [label="Nasıl istersen. Seni uyarıyorum, bu kararının sonuçlarına katlanmadan geri alınamaz.",shape=box,color=blue];
		j4016599250 -> j3427451096;
	j3466471617 [label="Uslu durup Loid'i yukarı çıkarıp ailesiyle barıştırmaya yardım eder misin? Ben de anılarını toparlamana yardım edeyim.",shape=box,color=red];
		j3466471617 -> j3913667545;
	j4129658744 [label="Bu, iradenin olmadığı anlamına gelmiyor. Sadece bazı şeylerin birkaç deneme daha gerektirmesi anlamına geliyor.",shape=box,color=red];
		j4129658744 -> j2706452163;
	j3158793363 [label="Umarım bu seni üzmüyordur.",shape=box,color=red];
		j3158793363 -> j1001961017;
