	j2483282091 [label="Benim açımdan bakıldığında, anılarımın yalnızca bir kısmı sağlamken, diğer yarısının senin elinde olduğunu bilmek biraz tuhaf.",shape=box,color=blue];
		j2483282091 -> j3188247103;
	j1809263470 [label="Ama bütün bunlar... oyalanmak mı? Sadece zaman kaybı mı? Hadi, hemen söyle. Sorun çözülecek.",shape=box,color=blue];
		j1809263470 -> j1318922719;
		j1809263470 -> j1289360451;
	j1785267423 [label="Ne istediğini söyle, anlaşalım. Bütün bu... oyalanmalar zaman kaybından başka bir şey değil.",shape=box,color=blue];
