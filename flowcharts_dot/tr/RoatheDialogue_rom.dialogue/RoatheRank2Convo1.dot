	644 [label="\"Şimdilik.\" İlginç. Ve biz gerçekten de sadece adımlarımızı geri izliyoruz, sanki saraylıların bir dansın hareketlerini taklit etmesi gibi? Tekrar tekrar, kendimizi tekrarlamaya mahkûm muyuz?",shape=box,color=blue];
		644 -> 668;
		644 -> 669;
	645 [label="Sanırım bunu sen daha iyi bilirsin, değil mi? Bu kadar tahmin edilebilir olması ilginç. Onun kadar paramparça olmuş birinin bile ara sıra güvenebileceğini bilmek güzel.",shape=box,color=blue];
		645 -> 670;
	646 [label="Zaten bilmiyor musun? Mm. Belki de o kadar ileri gitmedin. Ya da bu küçük macerada ilk ya da yirmi bininci seferde sormayı düşünmedin.",shape=box,color=blue];
		646 -> 670;
	647 [label="Ha. Ve unutmadan bir şey daha?",shape=box,color=blue];
		647 -> 671;
	649 [label="Ruhunu şeytana nasıl sattın, hem de iki kere... beni yatağıma çekmek için bir anlaşma mı yaptın? Yoksa kalbimin peşinde misin Gaspçı? Mm. Göreceğiz. Ama zamanla.",shape=box,color=blue];
		649 -> 672;
	650 [label="Zamanı geldiğinde, küçük yalakamız Gaspçı'yı baştan çıkarmak için yolunun açık olmasını sağlayacağım. Halloldu say.",shape=box,color=blue];
		650 -> 673;
	651 [label="Zamanı geldiğinde, zavallı perişan rahip Gaspçı'yı baştan çıkarmak için yolunun açık olmasını sağlayacağım. Halloldu say.",shape=box,color=blue];
		651 -> 674;
	652 [label="Zamanı gelince bunu hatırlayacağım. Anılarım konusunda bir anlaşmazlık daha yaşarsak, senin daha önceki hatalarını tekrarlamayız.",shape=box,color=blue];
		652 -> 675;
	655 [label="Zamanı geldiğinde, o küçük uşağın o merdivenlerden çıkmasını sağlayacağım. Halledilmiş say.",shape=box,color=blue];
		655 -> 678;
	654 [label="Marie ile olan meseleni ve onun Entrati'ye olan yalaka hayranlığını bir düşün. Zamanı gelince, ben hallederim.",shape=box,color=blue];
		654 -> 677;
	653 [label="Lyon'la olan meseleni ve onun dehşetini bir düşün, Gaspçı. Zamanı gelince, ben hallederim.",shape=box,color=blue];
		653 -> 676;
	648 [label="Ben... sanırım neyin peşinde olduğunu unuttum. Anılarımla oynadığın için seni suçluyorum. Bu neydi şimdi?",shape=box,color=blue];
		648 -> 626;
	656 [label="Bunun yerine sabırlı olmanı tavsiye ederim, ama... yanındaki lazer kazma dururken sana keski kullanmanı söylemek bana düşmez.",shape=box,color=blue];
		656 -> 679;
	657 [label="Hm. Anlıyorum. Dürüst olmak gerekirse, bu, asil bir çaba. Ben de birçok kez denedim. Ve aynı şekilde başarısız oldum.",shape=box,color=blue];
