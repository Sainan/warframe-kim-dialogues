	634 [label="Lyon'un... başa çıkması gereken çok şey var. Ve ben bunların üstesinden nasıl geleceğimi bilmiyorum.",shape=box,color=red];
		634 -> 656;
	635 [label="Marie, Entrati'nin gerçek yüzünü göremeyecek. Ve ne yaparsam yapayım, ona gerçeği gösteremiyorum.",shape=box,color=red];
		635 -> 657;
	636 [label="Bak, serumu neden aldığınla ilgili bir... şey var ve ben... yanlış zamanlarda yanlış şeyler söyledim.",shape=box,color=red];
		636 -> 658;
