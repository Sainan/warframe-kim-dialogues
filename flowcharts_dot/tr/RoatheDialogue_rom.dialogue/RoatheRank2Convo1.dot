	j4081965056 [label="Kendi kaderimi şekillendirmek için benimle iş çevirmiş olmanı inanılmaz derecede ilginç buluyorum. Ne de olsa şeytan, kendi bedeniyle pazarlık eder.",shape=box,color=blue];
		j4081965056 -> j2483282091;
	j3621265373 [label="Senin tarafında ilerlemeler nasıl gidiyor, Gaspçım? Senin lehine ipleri ve kaldıraçları çekmekle meşgulüm, her ne kadar etkim şimdiye kadar görülmese ve hissedilmese de.",shape=box,color=blue];
		j3621265373 -> j2483282091;
	j3401019103 [label="Teklifim hakkında fikrini değiştirdiğini söyle bana. Daha önce serumu alma konusunda bir engel teşkil etmiş olabilir miyim? Artık bir kar terriski kadar uysal olacağım.",shape=box,color=blue];
		j3401019103 -> j1809263470;
	j3414411955 [label="Teklifim hakkında fikrini değiştirdiğini söyle bana. Bu Marie sorununu senin için çözebilirim. Onunla romantik hedeflerine kolayca ulaşmanı sağlayacağım.",shape=box,color=blue];
		j3414411955 -> j1809263470;
	j709782624 [label="Teklifim hakkında fikrini değiştirdiğini söyle bana. Lyon sorununu senin için çözebilirim. Onunla romantik hedeflerine kolayca ulaşmanı sağlayacağım.",shape=box,color=blue];
		j709782624 -> j1809263470;
	j786489421 [label="Teklifim hakkında fikrini değiştirdiğini söyle bana. Uşak ve ailesini yeniden bir araya getirirken bir engel teşkil etmiş olabilir miyim? Artık bir kar terriski kadar uysal olacağım.",shape=box,color=blue];
		j786489421 -> j1809263470;
	j641020115 [label="Teklifim hakkında fikrini değiştirdiğini söyle bana - Bu Marie sorununu senin için çözebilirim. Onunla yapacağın görüşmelerde rahat olmanı sağlayacağım.",shape=box,color=blue];
		j641020115 -> j1809263470;
	j678754541 [label="Teklifim hakkında fikrini değiştirdiğini söyle bana - Bu Lyon sorununu senin için çözebilirim. Onunla yapacağın görüşmelerde rahat olmanı sağlayacağım.",shape=box,color=blue];
		j678754541 -> j1809263470;
	j616784985 [label="Senin bu konuşmalarımızda bir nedenden dolayı oyalanıp durduğunu düşünmeden edemiyorum, Gaspçı. Ve bu konuda sana yardımcı olabileceğim bir şey olabilir.",shape=box,color=blue];
		j616784985 -> j1785267423;
