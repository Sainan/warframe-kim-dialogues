		j647329172 -> j2142734474;
	j2586084119 [label="Onu basit gerçeklerle ikna edemeyeceğini görünce, hayal kırıklığına uğrayarak, senin bu... yeteneğini kullanmaya karar verdin.",shape=box,color=blue];
		j2586084119 -> j3261825001;
	j4014211041 [label="Hatalarını düzeltmek için zihnimi bulandırmanı hoş karşılamıyorum, Gezgin. Ancak bunu benim iyiliğim için yapmaya çalışman... sanırım, bir şekilde, kabul edilebilir.",shape=box,color=blue];
