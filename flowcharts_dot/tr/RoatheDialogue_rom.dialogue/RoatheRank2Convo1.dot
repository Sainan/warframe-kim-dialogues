		j2075111951 -> j2297940785 [label="false",color=purple];
	j3188247103 [label="Öyleyse, yapacak daha iyi bir şey olmadığı için devam edeceğim. \"Bu arada, bizim küçük yalakayla aran nasıl? Sanırım rahip hâlâ seninle konuşmuyor.\" Bah. Ne saçmalık.",shape=box,color=blue];
