	619 [label="Benim açımdan bakıldığında, anılarımın yalnızca bir kısmı sağlamken, diğer yarısının senin elinde olduğunu bilmek biraz tuhaf.",shape=box,color=blue];
		619 -> 623;
	620 [label="Ama bütün bunlar... oyalanmak mı? Sadece zaman kaybı mı? Hadi, hemen söyle. Sorun çözülecek.",shape=box,color=blue];
		620 -> 624;
		620 -> 625;
	621 [label="Ne istediğini söyle, anlaşalım. Bütün bu... oyalanmalar zaman kaybından başka bir şey değil.",shape=box,color=blue];
