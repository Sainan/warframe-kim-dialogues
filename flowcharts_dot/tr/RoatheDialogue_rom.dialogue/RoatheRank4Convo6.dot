digraph {
	2743 [label="RoatheRank4Convo6 begins.",color=orange];
		2743 -> 2744;
	2744 [label="Gaspçı, en sevdiğin öldürme şekli hangisi?",shape=box,color=blue];
		2744 -> 2746;
		2744 -> 2747;
		2744 -> 2745;
	2746 [label="Pardon?",shape=box,color=red];
		2746 -> 2749;
	2747 [label="Öğrenmek mi istiyorsun?",shape=box,color=red];
		2747 -> 2750;
	2745 [label="[Son.]",shape=box,color=red];
		2745 -> 2748;
	2749 [label="Son zamanlarda kendimi felsefi düşüncelere dalmış buluyorum ve sadece merak ediyorum.",shape=box,color=blue];
		2749 -> 2751;
	2750 [label="Ha! Pek sayılmaz. Yine de... sana karşı birkaç raunt oldukça eğlenceli olurdu. Hayır, son zamanlarda kendimi felsefi düşüncelere dalmış buluyorum ve sadece merak ediyorum.",shape=box,color=blue];
		2750 -> 2751;
	2748 [label="Chat ends.",color=orange];
	2751 [label="Konu sayılara geldiğinde, sanırım sen ve ben öldürme konusunda eşitiz. Mm... Bu konuda bahse girmek istemem, ayrıca malum kılıç kıyaslama yarışmasıyla da ilgilenmiyorum.",shape=box,color=blue];
		2751 -> 2752;
	2752 [label="Katilden katile. Hangisini tercih ediyorsun? Yakın ve kişisel mi? Gizlice mi, yoksa savaş alanının kaosunu mu seviyorsun?",shape=box,color=blue];
		2752 -> 2753;
		2752 -> 2754;
		2752 -> 2755;
		2752 -> 2756;
	2753 [label="Kaosu tercih ederim. Patlamalar. Silah sesleri. Yüksek sesler. Ne kadar çok olursa o kadar iyi.",shape=box,color=red];
		2753 -> 2757;
	2754 [label="Gizlilik. Düşmanımı, orada olduğumu anlamadan önce alt etmeyi tercih ederim. Eğer yapabilseydim, uyudukları yerde yapardım.",shape=box,color=red];
		2754 -> 2758;
	2755 [label="Savaşlardan nefret ediyorum. Keşke hiç savaşmak zorunda kalmasaydım.",shape=box,color=red];
		2755 -> 2759;
	2756 [label="Bu iğrenç bir konu.",shape=box,color=red];
		2756 -> 2760;
	2757 [label="Update boolean RoatheSoldier",color=orange];
		2757 -> 2761;
	2758 [label="Update boolean RoatheAssassin",color=orange];
		2758 -> 2762;
	2759 [label="Ah zavallı, zavallı Gaspçım, keşke beni gülerken duyabilseydin...",shape=box,color=blue];
		2759 -> 2763;
	2760 [label="O zaman gidebilirsin.",shape=box,color=blue];
		2760 -> 2764;
	2761 [label="Tıpkı benim gibi savaş yorgunu bir askersin. Sicilin hakkında bildiklerim göz önüne alındığında buna şaşırmak zor. Nereye gidersen git ardında kanlı bir iz bırakıyorsun. Önce Duviri, sonra \"Narmer\", sonra da Höllvania. Şimdi de bu meseledesin.",shape=box,color=blue];
		2761 -> 2765;
	2762 [label="Ah, aramızda bir suikastçı var! Çok faydalı bir meslektir, ama bir o kadar da takdirden yoksun. Suikastçıları hep yetenekli uşaklara benzetmişimdir.",shape=box,color=blue];
		2762 -> 2766;
	2763 [label="Seni zavallı, yoksul yaratık. Umarım kendi iyiliğin için bana yalan söylüyorsundur.",shape=box,color=blue];
		2763 -> 2767;
	2764 [label="Chat ends.",color=orange];
	2765 [label="Kim bilir bu süreçte daha neler oldu, neler unuttun. Ölüm senin sanatın ve sen dünyaları ölümle resmediyorsun.",shape=box,color=blue];
		2765 -> 2768;
	2766 [label="İşlerini çok iyi yaptıklarında bile çoğu zaman emekleri fark edilmez.",shape=box,color=blue];
		2766 -> 2769;
	2767 [label="+20 Chemistry",color=orange];
		2767 -> 2770;
	2768 [label="Eee! Sanatını konuşturmak için hangi fırçayı kullanıyorsun? Hadi biraz detaylara inelim.",shape=box,color=blue];
		2768 -> 2771;
		2768 -> 2772;
		2768 -> 2773;
		2768 -> 2774;
	2769 [label="Hangisini kullanıyorsun; Hançer? Zehir? Yay?",shape=box,color=blue];
		2769 -> 2775;
		2769 -> 2776;
		2769 -> 2777;
		2769 -> 2778;
		2769 -> 2779;
	2770 [label="Aksi takdirde bu, hayatım boyunca duyduğum en üzücü şey olabilir.",shape=box,color=blue];
		2770 -> 2780;
	2771 [label="Açıkçası elimde ne varsa ona uyum sağlarım. Doğaçlamayı severim.",shape=box,color=red];
		2771 -> 2781;
	2772 [label="Yay. Zarif ve ölümcül.",shape=box,color=red];
		2772 -> 2782;
	2773 [label="Kılıç. İşleri bizzat halletmeyi severim.",shape=box,color=red];
		2773 -> 2783;
	2774 [label="Tüfekler ve ateşli silahlar. Gürültülü, ama iş görüyor.",shape=box,color=red];
		2774 -> 2784;
	2775 [label="Açıkçası elimde ne varsa ona uyum sağlarım. Doğaçlamayı severim.",shape=box,color=red];
		2775 -> 2785;
	2776 [label="Yay. Zarif ve sessiz.",shape=box,color=red];
		2776 -> 2786;
	2777 [label="Keskin nişancı tüfeği. Bir atış, bir ölü.",shape=box,color=red];
		2777 -> 2787;
	2778 [label="Zehir. Öldüklerini anlamadan çoktan gitmiş olurum.",shape=box,color=red];
		2778 -> 2788;
	2779 [label="Hançer. Yakınlığın verdiği samimiyeti seviyorum.",shape=box,color=red];
		2779 -> 2789;
	2780 [label="Update boolean RoatheWeaponNone",color=orange];
		2780 -> 2790;
	2781 [label="Burada oturmuş, seni savaş meydanında bir sedye ile çılgınca dövüşerek ilerlediğimi, eğik bir boru parçasına araç lastiği bağladığını, ve askerleri parçaladığını hayal ediyorum.",shape=box,color=blue];
		2781 -> 2791;
	2782 [label="Savaşın hararetinde yay kullanmak, çok az kişinin sahip olabileceği bir azim, zihin berraklığı ve tabii ki sağlam eller gerektirir.",shape=box,color=blue];
		2782 -> 2792;
	2783 [label="Mm, dikkatli ol. Beni fazla heyecanlandırma Gaspçı. Savaş meydanında, kan fışkırarak açan bir çiçeğin yaprakları gibi dans etmeni görmeyi ne kadar isterdim anlatamam...",shape=box,color=blue];
		2783 -> 2793;
	2784 [label="İcat edildikleri andan itibaren her savaşın temel taşı oldular. Bunun bir sebebi var, Gaspçı. Ancak, amaçlanan hedefe vurduğunda işi kesin olarak bitirmesi garantili.",shape=box,color=blue];
		2784 -> 2794;
	2785 [label="Burada oturmuş, birini bir çatal bıçak parçasıyla ya da bir sandalye ayağıyla öldürdüğünü, birinin hayatını bir perde bağıyla söndürdüğünü hayal ediyorum.",shape=box,color=blue];
		2785 -> 2795;
	2786 [label="Avcının yolu. İlkel, ama sadeliğiyle zarif. Bazen en kolay ve en eski yöntemler, özünde en etkili olanlardır.",shape=box,color=blue];
		2786 -> 2796;
	2787 [label="Benim zevkime göre biraz mesafeli ve fazla klinik, ama etkililiğini yargılayamam. Sakinliği bile kendi başına bir işaret.",shape=box,color=blue];
		2787 -> 2797;
	2788 [label="Uğursuz bir ceza yöntemi gibi, ha? Tentürler hazırlayıp, şüphelenmeyen kurbanının kadehine mi katıyorsun? Yoksa bıçaklarına ve mermilerine zehir katarak, sahadaki en ufak bir darbeyi ölümcül hale mi getiriyorsun?",shape=box,color=blue];
		2788 -> 2798;
	2789 [label="Mm, dikkatli ol. Beni fazla heyecanlandırma Gaspçı. Ne kadar da ilgi çekici. Bir hayal etsene, bir gece uyandığında gölgelerde gizlenmiş, hançerini saplamaya hazır bir şekilde bekleyen birini görüyorsun...",shape=box,color=blue];
		2789 -> 2799;
	2790 [label="Chat ends.",color=orange];
	2791 [label="+10 Chemistry",color=orange];
		2791 -> 2800;
	2792 [label="Mutlak sessizlik takdire şayan. Bir okun takılması, gerilişi, serbest bırakılmanın beklentisi... ve ardından hedefini bulduğunda gelen tatlı ölüm.",shape=box,color=blue];
		2792 -> 2801;
	2793 [label="Kişisel temas arzunu takdir ediyorum. Kurbanının hayatını sonlandırırken uzuvlarının çaresizce düşüşünü izlemek. Cansız bedenlerinin önünde nasıl parçalandığını görmek. Bunu yapanın sen olduğunu, başka hiç kimse olmadığını bilmek... gerçekten farklı.",shape=box,color=blue];
		2793 -> 2802;
	2794 [label="Dağınık, gürültülü, aşırı pahalı. Ama öldürme konusunda çok iyi.",shape=box,color=blue];
		2794 -> 2803;
	2795 [label="+10 Chemistry",color=orange];
		2795 -> 2804;
	2796 [label="Mutlak sessizlik takdire şayan. Bir okun takılması, gerilişi, serbest bırakılmanın beklentisi... ve ardından hedefini bulduğunda gelen tatlı ölüm.",shape=box,color=blue];
		2796 -> 2805;
	2797 [label="Savaş alanının amansız gürültüsünde, keskin nişancı okyanusun gelgiti gibi nefesini bulmalıdır. Nefes al, nefes ver ve bir can al.",shape=box,color=blue];
		2797 -> 2806;
	2798 [label="Tek bir askerin kolundaki basit bir kesik yüzünden koca taburların yitip gittiğini gördüm. Kandan akciğerlere, oradan da başka bir diğerinin akciğerlerine yayılan bir toksin. Bu şey koca ülkeleri mahvedebilir.",shape=box,color=blue];
		2798 -> 2807;
	2799 [label="Kişisel dokunuş arzunu takdir ediyorum. Başkasının gözlerindeki ışın sönmesi ve vücudunun yavaşça soğuması sırasındaki o donuk bakışları izlemek çok farklıdır.",shape=box,color=blue];
		2799 -> 2808;
	2800 [label="Ben... bunun seni daha mı az, yoksa daha mı korkutucu yaptığına karar veremiyorum, Gaspçı. Sanırım daha fazla diyebilirim. Her iki durumda da, kendi başına eğlenceli ve çarpıcı buluyorum.",shape=box,color=blue];
