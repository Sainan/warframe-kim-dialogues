		2827 -> 2818;
		2827 -> 2819;
		2827 -> 2820;
	2828 [label="Çünkü öyle. Ve sen de bunu biliyorsun. Aslında, varoluşunun yarısı kelimenin tam anlamıyla öldürmeyi bir sanat formu olarak görme kavramına dayanıyor!",shape=box,color=blue];
		2828 -> 2831;
	2829 [label="Ha? Gerçekten mi? İstersen biraz durup bunu inceleyelim.",shape=box,color=blue];
		2829 -> 2832;
	2830 [label="Son zamanlarda değişti. Ve bu beni çok rahatsız ediyor.",shape=box,color=blue];
		2830 -> 2833;
		2830 -> 2834;
	2831 [label="Tenno'ların kullandığı ve senin de vekaleten ödünç aldığın şu \"okullardan\" bahsediyorum. Hele ki Dax öğretilerini hiç saymıyorum. İletişim kanallarının kısıtlı olduğunu her ne kadar söylesek de durmadan bu konuda konuşup duruyorlardı.",shape=box,color=blue];
		2831 -> 2835;
	2832 [label="Bana şunu söyle, ve lütfen dürüstçe cevap ver. Çünkü şu anda yalan söylemek ikimize de, özellikle de kendine zarar veriyor:",shape=box,color=blue];
		2832 -> 2836;
	2833 [label="Nasıl değişti?",shape=box,color=red];
		2833 -> 2837;
	2834 [label="Uriel yüzünden mi?",shape=box,color=red];
		2834 -> 2838;
	2835 [label="Eğer bir daha \"Ben bir silahım\" ve \"Ben öldürmek için varım\" diyen birini duymazsam huzur içinde öleceğimden emin olabilirsin, Gaspçı.",shape=box,color=blue];
		2835 -> 2839;
	2836 [label="Hiç kişisel zevkine göre özelleştirilmiş bir silah veya Warframe ile kendini donatmayı denedin mi? Belki de özgün bir şekilde boyanmış veya ruh haline daha uygun bir görünüme sahip bir tanesi?",shape=box,color=blue];
		2836 -> 2840;
		2836 -> 2842;
		2836 -> 2841;
	2837 [label="Eskiden silah olarak kılıcı tercih ederdim. Zarif ve çevik. Savaş alanında hızlı bir şekilde hareket edebilir ve düşmanlarımı kol mesafesinden kesebilirdim. Gümüş bir kılıcın üzerindeki kızıl renk, mavi bir yıldızın parıltısı altında harika parlıyordu.",shape=box,color=blue];
		2837 -> 2843;
	2838 [label="Öyle olduğunu varsayıyorum. Ya da belki de hafıza kaybımdan. Başka hangi sebeplerden olabileceği konusunda çok emin değilim.",shape=box,color=blue];
		2838 -> 2837;
	2839 [label="İnsanlık her zaman \"cinayeti\" bir günah olarak, \"öldürmeyi\" ise bir sanat olarak görmüştür. Bunu hiç tuhaf bulmadın mı? Kılıç kullanarak bir düşmanı savaşta devirmek, neredeyse yüce bir varlık olarak görülmek demektir.",shape=box,color=blue];
		2839 -> 2844;
	2840 [label="İyi de... bu neyi değiştirecek ki?",shape=box,color=red];
		2840 -> 2845;
	2842 [label="Hayır. Asla.",shape=box,color=red];
		2842 -> 2847;
	2841 [label="Bu oyunu oynamıyorum. [Son.]",shape=box,color=red];
		2841 -> 2846;
	2843 [label="Ama şimdi? Şimdi dişlerimdeki kanın tadına bakmak istiyorum. Pençelerimin altından fışkırdığını hissetmek istiyorum. Parmaklarımı ete ve kemiğe batırıp onları parçalara ayırmak istiyorum.",shape=box,color=blue];
		2843 -> 2848;
	2844 [label="Birisini dar bir sokakta sivriltilmiş bir metal parçasıyla öldürmek korkaklık ve yozlaşmışlıktır. ",shape=box,color=blue];
		2844 -> 2849;
	2845 [label="Dürüstlüğünü takdir ediyorum. Şimdi, soğukkanlılıkla cinayet işlemekten büyük ihtimalle hoşlanmadığını ve masum bir canın katledilmesinin hoşuna giden bir şey olmadığını iddia etmeyeceğim (belki de hoşlanıyorsundur ve önceki ifaden bir yalandı... bunu ortaya çıkarmak ne kadar da hoş olurdu, ancak burada tartışmak istediğimiz bu değil).",shape=box,color=blue];
		2845 -> 2850;
	2847 [label="Derin düşüncelere uzunca dalmanı rica edeceğim. Tenno arkadaşlarının burada rengarenk sirk kabuslarına yakışır şekilde ortalığı kasıp kavurduğunu gördüm. Sanki bir sanatçının boyalarına bulanmış vahşi bir hayvan gibi. ",shape=box,color=blue];
		2847 -> 2852;
	2846 [label="Pekâlâ.",shape=box,color=blue];
		2846 -> 2851;
	2848 [label="Kaslar parçalanırken ve vücudumun kanlı bir şarapnele dönüştüğü hissine kapılırken, o irinleri içime çekmek istiyorum. İlik akarken tatlı bir meyve gibi onu parçalamak istiyorum.",shape=box,color=blue];
		2848 -> 2853;
		2848 -> 2854;
	2849 [label="Aradaki fark nedir? \"Onur mu?\" Neyin onurlu, neyin onursuz olduğuna kim karar veriyor? Kaybeden mi? Yoksa kazanan mı? Yoksa onurlu ve onursuzu belirleyen şey belirli bir gelenek mi?",shape=box,color=blue];
		2849 -> 2857;
		2849 -> 2855;
		2849 -> 2856;
	2850 [label="Ancak durumun böyle olmadığını ve sadece \"zorunda olduğunuz için\" öldürdüğünüzü varsayarsak, o zaman neden ölüm silahlarınızı kişiselleştirilmiş bir şekilde donatmak için zaman harcıyoruz?",shape=box,color=blue];
		2850 -> 2858;
	2852 [label="Bir kez bile olsa hiç aynı şeyi yapmak zorunda kaldığını hissetmedin mi? Yemin edebilirim ki, gerçeği itiraf edersen için seni küçümsemeyeceğim.",shape=box,color=blue];
		2852 -> 2859;
		2852 -> 2860;
	2851 [label="Chat ends.",color=orange];
	2853 [label="Roathe?",shape=box,color=red];
		2853 -> 2861;
	2854 [label="Ve bu... senin için normal değil mi?",shape=box,color=red];
		2854 -> 2862;
	2857 [label="Demek istediğini anlıyorum. Aradaki çizgi belirsiz. ",shape=box,color=red];
		2857 -> 2865;
	2855 [label="Biri pratik ve özveri gerektirir. Diğeri ise sadece... vahşettir.",shape=box,color=red];
		2855 -> 2863;
	2856 [label="Bu konuşmayı yapmayacağım. [Son.]",shape=box,color=red];
		2856 -> 2864;
	2858 [label="Ölüm meydanında başkalarına nasıl görüneceğin neden umurunda olsun ki? Cesedinizi başkalarının teşhis etmesi için olmadığı kesin. Her yerde ayırt edilebilmen için. Evet, çünkü eğer bir katil olman gerekiyorsa, sevgili Gaspçı, eminim bunu şık bir şekilde yapmak isteyeceksin.",shape=box,color=blue];
		2858 -> 2866;
	2859 [label="Hayır.",shape=box,color=red];
		2859 -> 2846;
	2860 [label="Tamam. Yapmışlığım var. Neden?",shape=box,color=red];
		2860 -> 2845;
	2861 [label="Evet, farkındayım! Farkındayım. Bunların hiçbirini yapmayacağım, endişelenme. Haberin olsun, burayı yakıp yıkmak gibi ağzımı sulandıran fikirlerim de yok.",shape=box,color=blue];
		2861 -> 2867;
	2862 [label="Hayır! Hayır değil! Etrafımdaki her yeri yakıp yıkmak gibi ağzımı sulandıran fikirlerim de normal değil!",shape=box,color=blue];
		2862 -> 2867;
	2865 [label="Tüm bu çizgiler keyfi olarak çizilmiştir. Ve bunu ne kadar çabuk anlarsak, hangi savaşların önemli, hangilerinin önemsiz olduğu konusunda o kadar çabuk fikir birliğine varabiliriz.",shape=box,color=blue];
		2865 -> 2870;
	2863 [label="Peki, bu mantığı sonuna kadar takip edelim. Yeterince pratik yaparak öldürmek, bu eylemi onurlu mu kılıyor? Yani, Dax gibiysem ve cinayetimi yeterince ihtişam ve gösterişle örtbas edersem, bu Sanat mı oluyor?",shape=box,color=blue];
		2863 -> 2868;
	2864 [label="Pekâlâ.",shape=box,color=blue];
		2864 -> 2869;
	2866 [label="Peki bu, fiilin zevki değilse nedir? Sorum bu.",shape=box,color=blue];
		2866 -> 2871;
	2867 [label="Bu konuda Uriel suçlanmalı. Daha önce de bu tür yıkıcı ve kana susamış düşüncelere meyilli olduğumu kabul etsem de, bu düşünceler asla bunlar kadar korkunç değildi.",shape=box,color=blue];
		2867 -> 2872;
	2870 [label="Bir cinayetin onurlu bir şekilde işlenip işlenmediğine karar vermek, ateşte ölmenin mi yoksa boğularak ölmenin mi daha kötü olduğuna karar vermeye çalışmak gibidir. İkisi de sefil bir ölüm şeklidir.",shape=box,color=blue];
		2870 -> 2874;
	2868 [label="Artık ritüel ve inanca dayalı bir çizgide ilerliyoruz.",shape=box,color=blue];
		2868 -> 2873;
	2869 [label="Chat ends.",color=orange];
	2871 [label="Beni yanlış anlama! Seni yargılamıyorum. İçinde bulunduğun anın tadını çıkarıyorsun! Ölüm, seni hayatın bu büyük oyununda dans partneri yaptı ve senin de onun çağrısına kulak vermekten başka çaren yok.",shape=box,color=blue];
		2871 -> 2875;
	2872 [label="Ve kesinlikle o kadar da... kıyametvari değil.",shape=box,color=blue];
		2872 -> 2876;
	2874 [label="İşin sonunda bütün yollar mezara çıkar. Öyleyse çözülmesi gereken daha önemli sorunlar varken kusur bulmanın ne anlamı var?",shape=box,color=blue];
		2874 -> 2878;
	2873 [label="En azından sırtından bıçaklanarak basit ve kolay bir şekilde ölmenin bir dürüstlüğü var. Bunda inanca dayalı hiçbir şey yok. Gösterişli veya abartılı bir şey de yok. Oldu ve bitti.",shape=box,color=blue];
		2873 -> 2877;
	2875 [label="Acaba silahlarını bıraksaydın, kaç kişinin ölmesine neden olurdun? Demek istediğim, neden işinle biraz gurur duymuyorsun? Yaptığın sanattan biraz da olsa keyif almıyor musun? Sana soruyorum, bunun alternatifi ne? Delilik mi? Yok oluş mu?",shape=box,color=blue];
		2875 -> 2879;
	2876 [label="Chat ends.",color=orange];
	2878 [label="Chat ends.",color=orange];
	2877 [label="Sence bu da bir sanat değil mi?",shape=box,color=blue];
		2877 -> 2880;
	2879 [label="Bu yolda giden çok fazla insan gördüm ve onları bekleyen sonu gördüm. Demek istediğim şu ki; istediğini yap, Gaspçı. Çünkü hayat sana istediğini yaptı.",shape=box,color=blue];
