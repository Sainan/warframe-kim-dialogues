		1235 -> 1237;
	1239 [label="Seni bu şekilde incitmek istememiştim ve bunu yaptığım için üzgünüm, ancak eğer bu sana Orokin İmparatorluğu'nun diğer tarafında olmanın nasıl bir şey olduğunu öğrettiyse, bu değerli bir ders olmuştur.",shape=box,color=red];
		1239 -> 1245;
	1240 [label="Bunun seni bu şekilde incitmesini hiç istemedim. Orokin toplumunun işleyiş şekli için özür dilemene gerek yok - onu sen kurmadın. Onu kurtarmaya çalışıyordun.",shape=box,color=red];
