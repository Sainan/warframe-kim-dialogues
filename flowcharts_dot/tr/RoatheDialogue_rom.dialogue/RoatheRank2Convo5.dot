	1227 [label="Chat ends.",color=orange];
	1229 [label="Geçmiş Roathe, İnfazcı Nitokh ile olan ilişkilerinin ne kadarını anlattı sana? Bah. Tüm bunları uzlaştırmaya çalışırken: Eski ben sana böyle kişisel bilgiler vermiş... ama sen bunları aklımdan sildin mi?",shape=box,color=blue];
