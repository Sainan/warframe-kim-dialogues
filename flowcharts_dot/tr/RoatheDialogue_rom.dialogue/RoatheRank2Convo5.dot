		1228 -> 1230 [label="false",color=purple];
	1232 [label="İçimde bir yara var. Sana her şeyi, her şeyi anlatabilirdim - her şeyi, en ince ayrıntısına kadar, tüm çıplaklığıyla ortaya dökebilirdim ve sen... hepsini tekrar temizledin. Sanki senin için küçük bir oyuncaktan başka bir şey değilmişim gibi.",shape=box,color=blue];
		1232 -> 1234;
	1231 [label="İnfazcı Nitokh'tan daha önce bahsetmiştim. Ve onunla olan... ilişkilerimden. Orokin İmparatorluğu'nun tamamen kötü olmadığını anlamaya çalışmalısın.",shape=box,color=blue];
		1231 -> 1233;
	1230 [label="Chat ends.",color=orange];
	1234 [label="Sanırım bu adil bir şey. Orokin'ler insanlığa böyle davranmıştı, değil mi? Yuvan Tiyatrosu mu? Güzel bedenlerimizi sergileyip istediğimiz gibi yeni benliklerimizi seçiyor, uygun gördüğümüzde hastalıklı eğlenceler için birbirimize işkence ediyorduk...",shape=box,color=blue];
		1234 -> 1236;
	1233 [label="Onun yıkımı ve ahlaksızlığıyla hatırlanacak olması beni çok üzüyor. Evet, bunlardan bolca vardı, bunu inkar etmiyorum. ",shape=box,color=blue];
		1233 -> 1235;
	1236 [label="Ondan nefret ediyorum. Ondan inanılmaz derecede nefret ediyorum.",shape=box,color=blue];
		1236 -> 1239;
		1236 -> 1240;
		1236 -> 1238;
