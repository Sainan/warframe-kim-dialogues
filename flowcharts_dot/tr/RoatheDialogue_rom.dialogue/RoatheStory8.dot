	j2735420290 [label="SM: STANDART",shape=box,color=blue];
		j2735420290 -> j3793429674;
	j3793429674 [label="Transkript: Biz yaratıkların savaşın katliamına karşı sergilediği kibirli tavrı, sancaktarlarınki kadar özlü bir şekilde ifade eden başka bir şey yoktur.",shape=box,color=blue];
		j3793429674 -> j2789269081;
	j2789269081 [label="Her ne pahasına olursa olsun korunması gerekenler ve sorgusuz sualsiz takip edilmesi gerekenler.",shape=box,color=blue];
		j2789269081 -> j3245500660;
	j3245500660 [label="Ve eklemeliyim ki, aklı başında hiçbir askerin asla yerine getirmeyeceği emirlere uymak zorunda kalabilecekler, aksi takdirde daha da korkunç bir kadere maruz kalabilirler. ",shape=box,color=blue];
		j3245500660 -> j3795333100;
	j3795333100 [label="Gülünç olsa da.",shape=box,color=blue];
		j3795333100 -> j3643915259;
	j3643915259 [label="Diğerlerinin arasında her zaman gözüm onların şekillerine takılırdı, ancak parçalanmış bedenleri diğerlerinden hiçbir farkı yoktu. ",shape=box,color=blue];
		j3643915259 -> j164833731;
	j164833731 [label="Bu, her zaman taşıdıkları, Orokin altınıyla parıldayan ve benekli kızılla lekelenmiş bayraktı.",shape=box,color=blue];
		j164833731 -> j21767073;
	j21767073 [label="Ayrılmadan önce her zaman sahada gururla durduğundan emin olurdum.",shape=box,color=blue];
		j21767073 -> j921430358;
	j921430358 [label="Add 1 to HellStory counter",color=orange];
		j921430358 -> "Chat ends.";
