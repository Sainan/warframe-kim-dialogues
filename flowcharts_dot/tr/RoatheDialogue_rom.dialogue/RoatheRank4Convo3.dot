		j1614575609 -> j3422096517;
	j3409053951 [label="Hayır, kötülüğe değil. \"Kötülüğe\" inanmıyorum, Gaspçı. Hiç inanmadım ve inanmayacağım da. Tennoların, tıpkı herkes gibi, harika ve güzel bir şekilde insan olduğuna inanıyorum. Sadece insan. Dahası? Onlar çocuk.",shape=box,color=blue];
		j3409053951 -> j3872342809;
