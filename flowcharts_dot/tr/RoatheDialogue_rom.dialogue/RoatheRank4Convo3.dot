	j348771334 [label="Kaba olmaya çalışmıyorum. Oldukça ciddiyim, farkındasındır. Bu tamamen pragmatik bir konuşma. ",shape=box,color=blue];
		j348771334 -> j1312258869;
	"Chat ends." [color=orange];
	j119733839 [label="O iyi. Sanırım ne hakkında konuştuğunu bilmiyorsun.",shape=box,color=red];
		j119733839 -> j483604424;
	j747204304 [label="Devrelerinin kontrolünü mü kaybetti? Ne demek istiyorsun?",shape=box,color=red];
		j747204304 -> j2507945079;
	j1690326886 [label="Hayır. Bunu yapmayacağım. Lotus hayatımı kurtardı. Tennoların hayatını sayısız kez kurtardı. Her şeyimizi ona borçluyuz.",shape=box,color=red];
		j1690326886 -> j3366617423;
	j3488484807 [label="Kapa çeneni Roathe, bunu yapmayacağım. [Son.]",shape=box,color=red];
		j3488484807 -> j1767695047;
	j479117473 [label="Biliyorum, ben de endişeleniyorum. Ama o bizim için çok şey yaptı ve ben ona sırtımı dönemem. Onu desteklemeliyim.",shape=box,color=red];
		j479117473 -> j3128074815;
	j483604424 [label="Öyle değil mi? Dikkat et! Etrafına bak! Kaç ayını bir uçurumun kenarında durup, elinde antika bir çağrı cihazıyla kendi kendine mırıldanarak geçirdi? Void'e mi bakıyordu?",shape=box,color=blue];
		j483604424 -> j4090666113;
	j2507945079 [label="Kaç ayını bir uçurumun kenarında durup, elinde antika bir çağrı cihazıyla kendi kendine mırıldanarak geçirdi? Void'e mi bakıyordu?",shape=box,color=blue];
		j2507945079 -> j4090666113;
	j3366617423 [label="Anlayışsız değilim. Nasıl bir şey olduğunu anlıyorum. Ona çok şey borçlusun. Onu öldürmeni söylemiyorum, etrafındakileri etkilemesine izin vermemeni söylüyorum.",shape=box,color=blue];
		j3366617423 -> j2507945079;
	j1767695047 [label="Nasıl istersen. Ama her şey başına yıkıldığında? Sürünerek yardım istemeye gelme.",shape=box,color=blue];
		j1767695047 -> "Chat ends.";
	j3128074815 [label="+5 Chemistry",color=orange];
		j3128074815 -> j3743887748;
	j4090666113 [label="Ve şimdi o sadece... karanlıkta beliriyor mu? Çocukluğunun anılarına doğru gittikçe daha da derine iniyor, ne için? Albrecht parmaklarını şıklattı ve sihirli kelimeyi fısıldadı için mi eve dönüyor.",shape=box,color=blue];
		j4090666113 -> j2564527394;
	j3743887748 [label="Anlayışsız değilim. Nasıl bir şey olduğunu anlıyorum. Ona çok şey borçlusun. Onu öldürmeni söylemiyorum, etrafındakileri etkilemesine izin vermemeni söylüyorum.",shape=box,color=blue];
		j3743887748 -> j4251631806;
	j2564527394 [label="Şüpheli bulmuyor musun? Tehlikeli bulmuyor musun? Bu bir tuzak. Manipüle ediliyor. Ya Albrecht tarafından ya da bu sözde \"Kayıtsızlık\" tarafından. O bozuk bir program. İlkeleri arızalı.",shape=box,color=blue];
		j2564527394 -> j1014971884;
	j4251631806 [label="Uçurumun kenarında, elinde antika bir çağrı cihazıyla durup kendi kendine mırıldanırken mi? Void'e mi bakıyordu? Atlayacağını düşünmedin mi?",shape=box,color=blue];
		j4251631806 -> j4090666113;
	j1014971884 [label="Sana zarar vermek istediğini sanmıyorum. Sadece kullanıldığını düşünüyorum. Ama zamanı geldiğinde kendini savunman gerekebilir. Ya da onları alt etmen gerekebilir.",shape=box,color=blue];
		j1014971884 -> j141686739;
	j141686739 [label="Ve (umarım ki) Lotus ile ilgili sorunların ikinci dalgasını önlemenin önemini anlıyor olsan da, onun vahşi çocuk ordusu bunu anlamayacaktır. Bu yüzden sorumu tekrar ediyorum:",shape=box,color=blue];
		j141686739 -> j2750075774;
	j2750075774 [label="Sence o korkunç gün geldiğinde ve tüm kaynaklarınızla savaşmak zorunda kaldığınızda kim kazanırdı? Sen ve sahip olduğun her şey, tüm Tennolar ve Lotus'a karşı?",shape=box,color=blue];
		j2750075774 -> j2889762696;
		j2750075774 -> j16014632;
		j2750075774 -> j3758145554;
	j2889762696 [label="Bu saçmalık. Hayır.",shape=box,color=red];
		j2889762696 -> j3476740353;
	j16014632 [label="Onlardan yüz tane falan var. Ve bir tane de ben, Roathe.",shape=box,color=red];
		j16014632 -> j3112321861;
	j3758145554 [label="Nereden başlayacağımı bilmiyorum.",shape=box,color=red];
		j3758145554 -> j3708063197;
	j3476740353 [label="O zaman bunu aptalca bir oyun olarak kabul et! Çocukların oynadığı teorik bir oyun. ",shape=box,color=blue];
