	j348771334 [label="Kaba olmaya çalışmıyorum. Oldukça ciddiyim, farkındasındır. Bu tamamen pragmatik bir konuşma. ",shape=box,color=blue];
		j348771334 -> j1312258869;
	"Chat ends." [color=orange];
	j2323443136 [label="O iyi. Sanırım ne hakkında konuştuğunu bilmiyorsun.",shape=box,color=red];
		j2323443136 -> j1435631462;
	j3472706531 [label="Devrelerinin kontrolünü mü kaybetti? Ne demek istiyorsun?",shape=box,color=red];
		j3472706531 -> j3779989440;
	j265153507 [label="Hayır. Bunu yapmayacağım. Lotus hayatımı kurtardı. Tenno'ların hayatını sayısız kez kurtardı. Her şeyimizi ona borçluyuz.",shape=box,color=red];
		j265153507 -> j1419321922;
	j3488484807 [label="Kapa çeneni Roathe, bunu yapmayacağım. [Son.]",shape=box,color=red];
		j3488484807 -> j1767695047;
	j2148702508 [label="Biliyorum, ben de endişeleniyorum. Ama o bizim için çok şey yaptı ve ben ona sırtımı dönemem. Onu desteklemeliyim.",shape=box,color=red];
		j2148702508 -> j606937945;
	j1435631462 [label="Öyle değil mi? Dikkat et! Etrafına bak! Kaç ayını bir uçurumun kenarında durup, elinde antika bir çağrı cihazıyla kendi kendine mırıldanarak geçirdi? Void'e mi bakıyordu?",shape=box,color=blue];
		j1435631462 -> j2902403392;
	j3779989440 [label="Kaç ayını bir uçurumun kenarında durup, elinde antika bir çağrı cihazıyla kendi kendine mırıldanarak geçirdi? Void'e mi bakıyordu?",shape=box,color=blue];
		j3779989440 -> j2902403392;
	j1419321922 [label="Anlayışsız değilim. Nasıl bir şey olduğunu anlıyorum. Ona çok şey borçlusun. Onu öldürmeni söylemiyorum, etrafındakileri etkilemesine izin vermemeni söylüyorum.",shape=box,color=blue];
		j1419321922 -> j3779989440;
	j1767695047 [label="Nasıl istersen. Ama her şey başına yıkıldığında? Sürünerek yardım istemeye gelme.",shape=box,color=blue];
		j1767695047 -> "Chat ends.";
	j606937945 [label="+5 Chemistry",color=orange];
		j606937945 -> j561374089;
	j2902403392 [label="Ve şimdi o sadece... karanlıkta beliriyor mu? Çocukluğunun anılarına doğru gittikçe daha da derine iniyor, ne için? Albrecht parmaklarını şıklattı ve sihirli kelimeyi fısıldadı için mi eve dönüyor.",shape=box,color=blue];
		j2902403392 -> j328009205;
	j561374089 [label="Anlayışsız değilim. Nasıl bir şey olduğunu anlıyorum. Ona çok şey borçlusun. Onu öldürmeni söylemiyorum, etrafındakileri etkilemesine izin vermemeni söylüyorum.",shape=box,color=blue];
		j561374089 -> j485496578;
	j328009205 [label="Şüpheli bulmuyor musun? Tehlikeli bulmuyor musun? Bu bir tuzak. Manipüle ediliyor. Ya Albrecht tarafından ya da bu sözde \"Kayıtsızlık\" tarafından. O bozuk bir program. İlkeleri arızalı.",shape=box,color=blue];
		j328009205 -> j2346657444;
	j485496578 [label="Uçurumun kenarında, elinde antika bir çağrı cihazıyla durup kendi kendine mırıldanırken mi? Void'e mi bakıyordu? Atlayacağını düşünmedin mi?",shape=box,color=blue];
		j485496578 -> j2902403392;
	j2346657444 [label="Sana zarar vermek istediğini sanmıyorum. Sadece kullanıldığını düşünüyorum. Ama zamanı geldiğinde kendini savunman gerekebilir. Ya da onları alt etmen gerekebilir.",shape=box,color=blue];
		j2346657444 -> j2581990927;
	j2581990927 [label="Ve (umarım ki) Lotus ile ilgili sorunların ikinci dalgasını önlemenin önemini anlıyor olsan da, onun vahşi çocuk ordusu bunu anlamayacaktır. Bu yüzden sorumu tekrar ediyorum:",shape=box,color=blue];
		j2581990927 -> j1494958601;
	j1494958601 [label="Sence o korkunç gün geldiğinde ve tüm kaynaklarınızla savaşmak zorunda kaldığınızda kim kazanırdı? Sen ve sahip olduğun her şey, tüm Tenno'lar ve Lotus'a karşı?",shape=box,color=blue];
		j1494958601 -> j2889762696;
		j1494958601 -> j16014632;
		j1494958601 -> j3758145554;
	j2889762696 [label="Bu saçmalık. Hayır.",shape=box,color=red];
		j2889762696 -> j3476740353;
	j16014632 [label="Onlardan yüz tane falan var. Ve bir tane de ben, Roathe.",shape=box,color=red];
		j16014632 -> j3112321861;
	j3758145554 [label="Nereden başlayacağımı bilmiyorum.",shape=box,color=red];
		j3758145554 -> j3708063197;
	j3476740353 [label="O zaman bunu aptalca bir oyun olarak kabul et! Çocukların oynadığı teorik bir oyun. ",shape=box,color=blue];
		j3476740353 -> j1117058811;
		j3476740353 -> j3264219199;
	j3112321861 [label="+5 Chemistry",color=orange];
		j3112321861 -> j2027808059;
	j3708063197 [label="O zaman \"Tau Şeytanı\"yla konuşman çok iyi olmuş. Stratejist olarak tanınmamın bir sebebi var. En baştan başlayalım: Sayılar. Bu alanda korkunç derecede geridesin. ",shape=box,color=blue];
		j3708063197 -> j4181059854;
	j1117058811 [label="Bu bir oyun değil.",shape=box,color=red];
		j1117058811 -> j1510293021;
	j3264219199 [label="Son kez mi? Hayır. [Son.]",shape=box,color=red];
		j3264219199 -> "Chat ends.";
	j2027808059 [label="Mükemmel. Savaş alanını düzenlemenin ilk kuralını belirledik: sayı. Açıkçası, sayıca çok az olduğunuz için korkunç bir şekilde geride kalıyorsunuz.",shape=box,color=blue];
		j2027808059 -> j4181059854;
	j4181059854 [label="Check boolean IsDating",color=orange];
		j4181059854 -> j2192222890 [label=true,color=green];
		j4181059854 -> j4025525256 [label=false,color=brown];
	j1510293021 [label="Haklısın. Öyle değil. Ve bir gün bu, ölüm kalım meselesi haline gelebilir. Sen ve senin küçük... minyatür versiyonun. Ve onların vahşi arkadaşları.",shape=box,color=blue];
		j1510293021 -> j15047951;
	j2192222890 [label="Ancak, diğer zaman çizgileri arasındaki Protoframe'ler arasında dolaşan ''kişisel faaliyetlerin'' ve sevgilin hakkındaki söylentiler... değerlendirilebilirse, belki bu kaynaklar bir şekilde çağrılabilir. Bu amaçla Helminthlerin özel olarak araştırılması ve yetiştirilmesi gerekecektir...",shape=box,color=blue];
		j2192222890 -> j4262868213;
	j4025525256 [label="Başka zaman çizelgelerindeki diğer protoframe'larle etkileşimlerinden bahsedildiğini duydum. Belki de bu kaynaklar bir şekilde çağrılabilir. Bu amaçla Helminthlerin özel olarak araştırılıp yetiştirilmesi gerekecek...",shape=box,color=blue];
		j4025525256 -> j4262868213;
	j15047951 [label="Bu arada, şiddet eğilimli, asi oldukları kanıtlanmış ve kendi normallik anlayışlarından çok uzaklaştıkları için kendi türlerini acımasızca dışladıkları bilinen vahşi yoldaşlar.",shape=box,color=blue];
		j15047951 -> j2296669497;
		j15047951 -> j58685292;
		j15047951 -> j1006187310;
	j4262868213 [label="Bunun mümkün olup olmadığını bile bilmiyorum ama bize buraya geçiş imkânı sağladı, bu yüzden neden olmasın ki...",shape=box,color=blue];
