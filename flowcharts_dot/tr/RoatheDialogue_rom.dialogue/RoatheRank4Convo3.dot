digraph {
	2475 [label="RoatheRank4Convo3 begins.",color=orange];
		2475 -> 2476;
	2476 [label="Bu bilmeceyi çöz, Gaspçı: İş o noktaya gelirse, ölümcül bir savaşta Tenno rakibini yenebileceğini düşünüyor musun?",shape=box,color=blue];
		2476 -> 2478;
		2476 -> 2477;
		2476 -> 2479;
	2478 [label="Ne? Neden...?",shape=box,color=red];
		2478 -> 2481;
	2477 [label="Ben bu konuşmayı yapmayacağım.",shape=box,color=red];
		2477 -> 2480;
	2479 [label="[Son.]",shape=box,color=red];
		2479 -> 2482;
	2481 [label="Çünkü fark ettin mi bilmiyorum ama \"Lotus\" sadece bir Sentient değil - Lua'yı Void'e koyan da o - aynı zamanda devrelerinin kontrolünü de ölçülebilir bir şekilde kaybetmiş.",shape=box,color=blue];
		2481 -> 2483;
		2481 -> 2484;
		2481 -> 2485;
		2481 -> 2486;
		2481 -> 2487;
	2480 [label="Kaba olmaya çalışmıyorum. Oldukça ciddiyim, farkındasındır. Bu tamamen pragmatik bir konuşma. ",shape=box,color=blue];
		2480 -> 2481;
	2482 [label="Chat ends.",color=orange];
	2483 [label="O iyi. Sanırım ne hakkında konuştuğunu bilmiyorsun.",shape=box,color=red];
		2483 -> 2488;
	2484 [label="Devrelerinin kontrolünü mü kaybetti? Ne demek istiyorsun?",shape=box,color=red];
		2484 -> 2489;
	2485 [label="Hayır. Bunu yapmayacağım. Lotus hayatımı kurtardı. Tenno'ların hayatını sayısız kez kurtardı. Her şeyimizi ona borçluyuz.",shape=box,color=red];
		2485 -> 2490;
	2486 [label="Kapa çeneni Roathe, bunu yapmayacağım. [Son.]",shape=box,color=red];
		2486 -> 2491;
	2487 [label="Biliyorum, ben de endişeleniyorum. Ama o bizim için çok şey yaptı ve ben ona sırtımı dönemem. Onu desteklemeliyim.",shape=box,color=red];
		2487 -> 2492;
	2488 [label="Öyle değil mi? Dikkat et! Etrafına bak! Kaç ayını bir uçurumun kenarında durup, elinde antika bir çağrı cihazıyla kendi kendine mırıldanarak geçirdi? Void'e mi bakıyordu?",shape=box,color=blue];
		2488 -> 2493;
	2489 [label="Kaç ayını bir uçurumun kenarında durup, elinde antika bir çağrı cihazıyla kendi kendine mırıldanarak geçirdi? Void'e mi bakıyordu?",shape=box,color=blue];
		2489 -> 2493;
	2490 [label="Anlayışsız değilim. Nasıl bir şey olduğunu anlıyorum. Ona çok şey borçlusun. Onu öldürmeni söylemiyorum, etrafındakileri etkilemesine izin vermemeni söylüyorum.",shape=box,color=blue];
		2490 -> 2489;
	2491 [label="Nasıl istersen. Ama her şey başına yıkıldığında? Sürünerek yardım istemeye gelme.",shape=box,color=blue];
		2491 -> 2494;
	2492 [label="+5 Chemistry",color=orange];
		2492 -> 2495;
	2493 [label="Ve şimdi o sadece... karanlıkta beliriyor mu? Çocukluğunun anılarına doğru gittikçe daha da derine iniyor, ne için? Albrecht parmaklarını şıklattı ve sihirli kelimeyi fısıldadı için mi eve dönüyor.",shape=box,color=blue];
		2493 -> 2496;
	2494 [label="Chat ends.",color=orange];
	2495 [label="Anlayışsız değilim. Nasıl bir şey olduğunu anlıyorum. Ona çok şey borçlusun. Onu öldürmeni söylemiyorum, etrafındakileri etkilemesine izin vermemeni söylüyorum.",shape=box,color=blue];
		2495 -> 2497;
	2496 [label="Şüpheli bulmuyor musun? Tehlikeli bulmuyor musun? Bu bir tuzak. Manipüle ediliyor. Ya Albrecht tarafından ya da bu sözde \"Kayıtsızlık\" tarafından. O bozuk bir program. İlkeleri arızalı.",shape=box,color=blue];
		2496 -> 2498;
	2497 [label="Uçurumun kenarında, elinde antika bir çağrı cihazıyla durup kendi kendine mırıldanırken mi? Void'e mi bakıyordu? Atlayacağını düşünmedin mi?",shape=box,color=blue];
		2497 -> 2493;
	2498 [label="Sana zarar vermek istediğini sanmıyorum. Sadece kullanıldığını düşünüyorum. Ama zamanı geldiğinde kendini savunman gerekebilir. Ya da onları alt etmen gerekebilir.",shape=box,color=blue];
		2498 -> 2499;
	2499 [label="Ve (umarım ki) Lotus ile ilgili sorunların ikinci dalgasını önlemenin önemini anlıyor olsan da, onun vahşi çocuk ordusu bunu anlamayacaktır. Bu yüzden sorumu tekrar ediyorum:",shape=box,color=blue];
		2499 -> 2500;
	2500 [label="Sence o korkunç gün geldiğinde ve tüm kaynaklarınızla savaşmak zorunda kaldığınızda kim kazanırdı? Sen ve sahip olduğun her şey, tüm Tennolar ve Lotus'a karşı?",shape=box,color=blue];
		2500 -> 2501;
		2500 -> 2502;
		2500 -> 2503;
	2501 [label="Bu saçmalık. Hayır.",shape=box,color=red];
		2501 -> 2504;
	2502 [label="Onlardan yüz tane falan var. Ve bir tane de ben, Roathe.",shape=box,color=red];
		2502 -> 2505;
	2503 [label="Nereden başlayacağımı bilmiyorum.",shape=box,color=red];
		2503 -> 2506;
	2504 [label="O zaman bunu aptalca bir oyun olarak kabul et! Çocukların oynadığı teorik bir oyun. ",shape=box,color=blue];
		2504 -> 2507;
		2504 -> 2508;
	2505 [label="+5 Chemistry",color=orange];
		2505 -> 2509;
	2506 [label="O zaman \"Tau Şeytanı\"yla konuşman çok iyi olmuş. Stratejist olarak tanınmamın bir sebebi var. En baştan başlayalım: Sayılar. Bu alanda korkunç derecede geridesin. ",shape=box,color=blue];
		2506 -> 2510;
	2507 [label="Bu bir oyun değil.",shape=box,color=red];
		2507 -> 2511;
	2508 [label="Son kez mi? Hayır. [Son.]",shape=box,color=red];
		2508 -> 2512;
	2509 [label="Mükemmel. Savaş alanını düzenlemenin ilk kuralını belirledik: sayı. Açıkçası, sayıca çok az olduğunuz için korkunç bir şekilde geride kalıyorsunuz.",shape=box,color=blue];
		2509 -> 2510;
	2510 [label="Check boolean IsDating",color=orange];
		2510 -> 2513 [label=true,color=green];
		2510 -> 2514 [label=false,color=brown];
	2511 [label="Haklısın. Öyle değil. Ve bir gün bu, ölüm kalım meselesi haline gelebilir. Sen ve senin küçük... minyatür versiyonun. Ve onların vahşi arkadaşları.",shape=box,color=blue];
		2511 -> 2515;
	2512 [label="Chat ends.",color=orange];
	2513 [label="Ancak, diğer zaman çizgileri arasındaki protoframe'ler arasında dolaşan ''kişisel faaliyetlerin'' ve sevgilin hakkındaki söylentiler... değerlendirilebilirse, belki bu kaynaklar bir şekilde çağrılabilir. Bu amaçla Helminth'lerin özel olarak araştırılması ve yetiştirilmesi gerekecektir...",shape=box,color=blue];
		2513 -> 2516;
	2514 [label="Başka zaman çizelgelerindeki diğer protoframe'larle etkileşimlerinden bahsedildiğini duydum. Belki de bu kaynaklar bir şekilde çağrılabilir. Bu amaçla Helminth'lerin özel olarak araştırılıp yetiştirilmesi gerekecek...",shape=box,color=blue];
		2514 -> 2516;
	2515 [label="Bu arada, şiddet eğilimli, asi oldukları kanıtlanmış ve kendi normallik anlayışlarından çok uzaklaştıkları için kendi türlerini acımasızca dışladıkları bilinen vahşi yoldaşlar.",shape=box,color=blue];
		2515 -> 2517;
		2515 -> 2518;
		2515 -> 2519;
	2516 [label="Bunun mümkün olup olmadığını bile bilmiyorum ama bize buraya geçiş imkânı sağladı, bu yüzden neden olmasın ki...",shape=box,color=blue];
		2516 -> 2520;
		2516 -> 2521;
		2516 -> 2522;
	2517 [label="Şimdi Tenno'ların kötü olduğunu mu ima ediyorsun?",shape=box,color=red];
		2517 -> 2523;
	2518 [label="Ne diyorsun sen?",shape=box,color=red];
		2518 -> 2524;
	2519 [label="Hayır. Benden bu kadar. [Son.]",shape=box,color=red];
		2519 -> 2525;
	2520 [label="Roathe? Cehenneme git.",shape=box,color=red];
		2520 -> 2526;
	2521 [label="Onları bu karmaşaya çekmeyeceğim.",shape=box,color=red];
		2521 -> 2527;
	2522 [label="Bunu ne kadar çok düşündüğünü görünce endişelendim.",shape=box,color=red];
		2522 -> 2528;
	2523 [label="Hayır, kötülüğe değil. \"Kötülüğe\" inanmıyorum, Gaspçı. Hiç inanmadım ve inanmayacağım da. Tenno'ların, tıpkı herkes gibi, harika ve güzel bir şekilde insan olduğuna inanıyorum. Sadece insan. Dahası? Onlar çocuk.",shape=box,color=blue];
		2523 -> 2529;
	2524 [label="O korkunç gün geldiğinde, düşünülmez olanı yapmaya hazırlıklı olmalısın.",shape=box,color=blue];
		2524 -> 2530;
	2525 [label="İstersen sohbetten kaç, ama bunun her kelimesinin gerçek olduğunu biliyorsun. Kabul etmek istemiyorsun.",shape=box,color=blue];
		2525 -> 2531;
	2526 [label="+5 Chemistry",color=orange];
		2526 -> 2532;
	2527 [label="Ah! Yani bir karmaşa olduğunu kabul ediyorsun. Bu bir ilerleme. En azından iddiamı açıklayabilir miyim?",shape=box,color=blue];
		2527 -> 2533;
		2527 -> 2534;
	2528 [label="Ve senin açıkça anlamadığın şeylerden çok endişeliyim. En azından düşüncelerimi açıklayabilir miyim?",shape=box,color=blue];
		2528 -> 2533;
		2528 -> 2534;
	2529 [label="Çocuklar, benim tanık olduğum gibi korkunç şeylerle yüzleşmek ve zulümler işlemekle görevlendirildiler. Yüzlerce yıllık geçmişi olan sert Orokin savaşçılarını alt ettiler.",shape=box,color=blue];
		2529 -> 2535;
	2530 [label="Tenno'ların, tıpkı herkes gibi, harika ve güzel bir şekilde insan olduğuna inanıyorum. Sadece insan. Dahası? Onlar çocuk.",shape=box,color=blue];
		2530 -> 2529;
	2531 [label="Chat ends.",color=orange];
	2532 [label="Ben zaten oradayım, Gaspçı. Ben zaten oradayım.",shape=box,color=blue];
		2532 -> 2536;
	2533 [label="Tamam. Tabii. Devam et. Dinleyeceğim.",shape=box,color=red];
		2533 -> 2537;
	2534 [label="Hayır. Benden bu kadar.",shape=box,color=red];
		2534 -> 2538;
	2535 [label="Dax'ı gördüm - Altın, Elit Dax! - kutsal, yaldızlı kılıçlarını düşürüp Tenno'nun Warframe'leriyle girdikleri savaş alanından kaçtılar.",shape=box,color=blue];
		2535 -> 2539;
	2536 [label="Update boolean RoatheNoDate",color=orange];
		2536 -> 2540;
	2537 [label="+5 Chemistry",color=orange];
		2537 -> 2541;
	2538 [label="Ben de öyle.",shape=box,color=blue];
		2538 -> 2540;
	2539 [label="Onların hayali Infested sığınakları, bedenlerini koruyordu ama zihinlerini korumuyordu. Onlar kendi durumlarından sorumlu değiller.",shape=box,color=blue];
		2539 -> 2542;
	2540 [label="Chat ends.",color=orange];
	2541 [label="Teşekkür ederim. O korkunç gün geldiğinde, düşünülmez olanı yapmaya hazırlıklı olmalısın.",shape=box,color=blue];
		2541 -> 2530;
	2542 [label="Void tarafından işkenceye maruz bırakılmışlar... kendi ebeveynlerini öldürmeye veya onların ölümüne tanıklık etmeye zorlanmışlar... savaşa maruz kalmışlar... anıları çalınmış... yüzyıllardır uyku kapsülünde kaybolmuşlar...",shape=box,color=blue];
		2542 -> 2543;
	2543 [label="Onların tamamen çılgın deliler olmamaları bir mucize, Gaspçı. Her şeyin ters gideceğini söylemiyorum. Sadece ters gidebileceğini söylüyorum. Ve o gün gelirse diye bir planın olması gerektiğini söylüyorum.",shape=box,color=blue];
		2543 -> 2544;
	2544 [label="En kötüsüne hazırlıklı olmanın hiçbir zararı yoktur. Hazırlıklı olmamak ise dünyadaki tüm zararların kaynağıdır.",shape=box,color=blue];
		2544 -> 2545;
		2544 -> 2546;
		2544 -> 2547;
		2544 -> 2548;
	2545 [label="Durumu gözlemleyeceğim. Tamam mı? Ama kimsenin arkasından iş çevirmem.",shape=box,color=red];
		2545 -> 2549;
	2546 [label="Burada seninle aynı fikirde olmak gerçekten çok hoşuma gitmiyor.",shape=box,color=red];
		2546 -> 2550;
	2547 [label="Benim de Tenno kadar acı çektiğimi biliyorsun, değil mi?",shape=box,color=red];
		2547 -> 2551;
	2548 [label="Onların güvenini boşa çıkarmıyorum.",shape=box,color=red];
		2548 -> 2552;
	2549 [label="+5 Chemistry",color=orange];
		2549 -> 2553;
	2550 [label="+5 Chemistry",color=orange];
		2550 -> 2554;
	2551 [label="Ve kim benim onlarla aynı konuşmaları yapmadığımı söyleyebilir ki, hım?",shape=box,color=blue];
		2551 -> 2555;
	2552 [label="Ben de sana aksini önermiyorum.",shape=box,color=blue];
		2552 -> 2556;
	2553 [label="Tabii ki! Bir şeytanın isteyebileceği tek şey bu, teşekkürler.",shape=box,color=blue];
		2553 -> 2557;
	2554 [label="Hım. Bu sadece yıllar sonra beyninin tekrar akıl sağlığına kavuşması hissi. Alışacaksın.",shape=box,color=blue];
		2554 -> 2558;
	2555 [label="İyi uykular, Gaspçı. ",shape=box,color=blue];
