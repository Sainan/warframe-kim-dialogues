		j2029040650 -> j2232913421;
	j3865293330 [label="Void tarafından işkenceye maruz bırakılmışlar... kendi ebeveynlerini öldürmeye veya onların ölümüne tanıklık etmeye zorlanmışlar... savaşa maruz kalmışlar... anıları çalınmış... yüzyıllardır uyku kapsülünde kaybolmuşlar...",shape=box,color=blue];
		j3865293330 -> j476539957;
	j476539957 [label="Onların tamamen çılgın deliler olmamaları bir mucize, Gaspçı. Her şeyin ters gideceğini söylemiyorum. Sadece ters gidebileceğini söylüyorum. Ve o gün gelirse diye bir planın olması gerektiğini söylüyorum.",shape=box,color=blue];
		j476539957 -> j2701859577;
