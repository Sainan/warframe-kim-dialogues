		j2733840684 -> j2232913421;
	j1320305486 [label="İstersen sohbetten kaç, ama bunun her kelimesinin gerçek olduğunu biliyorsun. Kabul etmek istemiyorsun.",shape=box,color=blue];
		j1320305486 -> "Chat ends.";
	j2048548518 [label="+5 Chemistry",color=orange];
		j2048548518 -> j2710125398;
	j4287292879 [label="Ah! Yani bir karmaşa olduğunu kabul ediyorsun. Bu bir ilerleme. En azından iddiamı açıklayabilir miyim?",shape=box,color=blue];
		j4287292879 -> j2850145359;
