	j1312258869 [label="Çünkü fark ettin mi bilmiyorum ama \"Lotus\" sadece bir Sentient değil - Lua'yı Void'e koyan da o - aynı zamanda devrelerinin kontrolünü de ölçülebilir bir şekilde kaybetmiş.",shape=box,color=blue];
