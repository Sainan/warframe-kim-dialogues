		j2032046965 -> j4287292879;
	j1614575609 [label="Bunu ne kadar çok düşündüğünü görünce endişelendim.",shape=box,color=red];
		j1614575609 -> j3422096517;
	j3191532997 [label="Hayır, kötülüğe değil. \"Kötülüğe\" inanmıyorum, Gaspçı. Hiç inanmadım ve inanmayacağım da. Tenno'ların, tıpkı herkes gibi, harika ve güzel bir şekilde insan olduğuna inanıyorum. Sadece insan. Dahası? Onlar çocuk.",shape=box,color=blue];
		j3191532997 -> j3415614492;
	j420743509 [label="O korkunç gün geldiğinde, düşünülmez olanı yapmaya hazırlıklı olmalısın.",shape=box,color=blue];
		j420743509 -> j64947794;
	j1320305486 [label="İstersen sohbetten kaç, ama bunun her kelimesinin gerçek olduğunu biliyorsun. Kabul etmek istemiyorsun.",shape=box,color=blue];
		j1320305486 -> "Chat ends.";
	j2048548518 [label="+5 Chemistry",color=orange];
		j2048548518 -> j2710125398;
	j4287292879 [label="Ah! Yani bir karmaşa olduğunu kabul ediyorsun. Bu bir ilerleme. En azından iddiamı açıklayabilir miyim?",shape=box,color=blue];
		j4287292879 -> j3044529295;
		j4287292879 -> j2178656698;
	j3422096517 [label="Ve senin açıkça anlamadığın şeylerden çok endişeliyim. En azından düşüncelerimi açıklayabilir miyim?",shape=box,color=blue];
		j3422096517 -> j3044529295;
		j3422096517 -> j2178656698;
	j3415614492 [label="Çocuklar, benim tanık olduğum gibi korkunç şeylerle yüzleşmek ve zulümler işlemekle görevlendirildiler. Yüzlerce yıllık geçmişi olan sert Orokin savaşçılarını alt ettiler.",shape=box,color=blue];
		j3415614492 -> j56882426;
	j64947794 [label="Tenno'ların, tıpkı herkes gibi, harika ve güzel bir şekilde insan olduğuna inanıyorum. Sadece insan. Dahası? Onlar çocuk.",shape=box,color=blue];
		j64947794 -> j3415614492;
