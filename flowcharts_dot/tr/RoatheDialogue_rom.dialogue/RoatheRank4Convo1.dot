		j393023050 -> j3662431133;
	j1662964684 [label="Ha! Hiç de bile! Günlerdir yüzüne karşı bu kadar rahatça hakaret ettiğimi düşünüyorsan, sen çok sabırlı birisin. ",shape=box,color=blue];
		j1662964684 -> j2389195802;
	j3544745388 [label="Ah, sen de öylesin, değil mi? Tenno, Origin Sistemi'ni Orokin'den gasp etti. Ve sen, yuvadaki küçük bir sahtekâr gibi, kendi dünyandan bu dünyaya sızdın.",shape=box,color=blue];
		j3544745388 -> j788981971;
