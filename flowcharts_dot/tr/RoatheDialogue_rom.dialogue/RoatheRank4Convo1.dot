		j4251719401 -> j2682122952;
	j353026998 [label="Seni kendime düşman edecek havada değilim, Gaspçı. Hayır. Bu bir hakaret değil. Geçmişimin büyük bir kısmının seninle örtüştüğünü fark edememen, sadece senin gerekli özeni göstermemen yüzünden.",shape=box,color=blue];
		j353026998 -> j3755477252;
	j4251624204 [label="Seni kendime düşman edecek havada değilim, Gaspçı. Hayır. Aksine, bu bir onursal ünvan. Sen benim arzuladığım şeyi yaptın. Başka bir şey değil.",shape=box,color=blue];
