	2382 [label="Seni kendime düşman edecek havada değilim, Gaspçı. Hayır. Bu bir hakaret değil. Geçmişimin büyük bir kısmının seninle örtüştüğünü fark edememen, sadece senin gerekli özeni göstermemen yüzünden.",shape=box,color=blue];
