	j1398305428 [label="SM: KOMUTANLAR",shape=box,color=blue];
		j1398305428 -> j1631777068;
	j1631777068 [label="Transkript: Şimdi onları hatırlıyorum. Gülen Orokin gençliğinden oluşan gruplar.",shape=box,color=blue];
		j1631777068 -> j889872944;
	j889872944 [label="Henüz bozulmamış komuta kıyafetleri giymiş soylular.",shape=box,color=blue];
		j889872944 -> j3759909329;
	j3759909329 [label="Çocukluk arkadaşları artık Dax lejyonları, Grineer, sıfır madde hücreleri, kendi kendini kopyalayan kanserleştiriciler, ilkel biyodron örümcekler ve ilkel asker konteynırlarından oluşan orduların başında.",shape=box,color=blue];
		j3759909329 -> j1747186770;
	j1747186770 [label="Emrinde aç şeytanlar olan altın oğlanlar ve kızlar.",shape=box,color=blue];
		j1747186770 -> j1711554777;
	j1711554777 [label="Onların kibirleri, zihnime acı bir ter gibi damlıyor. İçip şarkı söylediler, gelecek zamanları övündüler.",shape=box,color=blue];
		j1711554777 -> j3304613353;
	j3304613353 [label="Kendilerine isim yapacaklardı. Ailelerini yücelteceklerdi.",shape=box,color=blue];
		j3304613353 -> j307695079;
	j307695079 [label="Birçoğu öldü. Cesetleri bile geri getirilmedi.",shape=box,color=blue];
		j307695079 -> j1237671336;
	j1237671336 [label="Düşmanın sırlarımızı öğrenmesini önlemek için, ölüm anında sıvılaştırılmak üzere Kuva şokuyla sarsıldılar.",shape=box,color=blue];
		j1237671336 -> j3216535787;
	j3216535787 [label="Bir neslin umudu, Grineer botlarının çiğnediği yağlı bir su birikintisine dönüştü.",shape=box,color=blue];
		j3216535787 -> j921430358;
	j921430358 [label="Add 1 to HellStory counter",color=orange];
		j921430358 -> "Chat ends.";
