	j1769975539 [label="SM: BAĞLANTI",shape=box,color=blue];
		j1769975539 -> j476702336;
	j476702336 [label="Transkript: Sentient'ler, Tau'ya giden Solay Ray'ı tamamladığında, büyük bir tören yapılmadı. Solar Ray sadece çalışmaya başladı.",shape=box,color=blue];
		j476702336 -> j3149602085;
	j3149602085 [label="Tören elbette aceleyle düzenlendi, çünkü gerçek bir Orokin, görkemli bir törene katılmadan burnunu silemezdi.",shape=box,color=blue];
		j3149602085 -> j1185517198;
	j1185517198 [label="İlk Geçişi gerçekleştirecek olan İlk Nakliye için büyük bir heyecan yaşandı.",shape=box,color=blue];
		j1185517198 -> j1174493223;
	j1174493223 [label="Bu, İnfazcı Tormis'in görkemli kruvazörüydü ve Tormis'in keşif gemisi olarak seçilmesi, Zariman Ten Zero'nun korkunç kazası nedeniyle İnfazcı Tuvul'a yönelik toplu bir kınama olarak yorumlanabilirdi. ",shape=box,color=blue];
		j1174493223 -> j2443212109;
	j2443212109 [label="Tormis gitti ve Tormis geri geldi, yeni bir Sistemin ve yerleşilecek yeni dünyaların harikulade mücevherlerle süslü anılarını taşıyarak. ",shape=box,color=blue];
		j2443212109 -> j3646270066;
	j3646270066 [label="Birkaç gün içinde sömürgeci gemilerden oluşan bir filo, bakir kıyıya ayak basmak için can atarak yola çıktı.",shape=box,color=blue];
		j3646270066 -> j4074216757;
	j4074216757 [label="Ardından gelen Sentient saldırısı ise havayı biraz bozdu.",shape=box,color=blue];
		j4074216757 -> j921430358;
	j921430358 [label="Add 1 to HellStory counter",color=orange];
		j921430358 -> "Chat ends.";
