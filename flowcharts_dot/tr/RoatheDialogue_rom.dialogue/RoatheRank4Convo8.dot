		j1543079369 -> j29979454;
	j2025973576 [label="[Son.]",shape=box,color=red];
		j2025973576 -> "Chat ends.";
	j29979454 [label="Hımm? İlginç bir soru. ''Nasıl''dı? Açıkçası pek hatırlamıyorum. Ve o anıları barındıran yıldızlar ve heykeller muhtemelen çoktan toza dönüşmüş veya Endo'ya dönüşmüştür, sanırım.",shape=box,color=blue];
		j29979454 -> j2414237436;
	"Chat ends." [color=orange];
	j2414237436 [label="Çok uzun zaman önce olduğu için, sadece çok kısa görüntüleri hatırlayabiliyorum. Çoğunu bir rüyada hayal etmiş miyim, yoksa tarih kitabında okuduğum olaylara kendi hayal gücümü katmış mıyım diye merak ediyorum.",shape=box,color=blue];
		j2414237436 -> j2117900232;
	j2117900232 [label="Dolayısıyla, hatırlayabildiklerim büyük olasılıkla son derece güvenilmez, kabul ediyorum. Neden soruyorsun?",shape=box,color=blue];
		j2117900232 -> j1820853205;
		j2117900232 -> j844269988;
		j2117900232 -> j811664911;
	j1820853205 [label="Hikayeler yalan olsa bile, bunlar yine de çocukluk yılların hakkında kendine anlattığın hikayelerdir. Yine de bilmeye değer.",shape=box,color=red];
		j1820853205 -> j3044519188;
	j844269988 [label="Orokin soyluları arasında büyümenin nasıl bir şey olduğunu merak ediyorum.",shape=box,color=red];
		j844269988 -> j271869389;
	j811664911 [label="\"Seni\" bu hale getiren neydi merak ediyorum. Nasıl oldu da böyle oldun?",shape=box,color=red];
		j811664911 -> j2492163054;
	j3044519188 [label="+5 Chemistry",color=orange];
		j3044519188 -> j2021208901;
	j271869389 [label="Tüm Orokin gençleri gibi, ben de genç yaşta, fanatiklerin \"yatılı okul\" dediği bir yere gönderildim. Orada, eğilimlerim ve yeteneklerim test edildi ve eğitildim.",shape=box,color=blue];
		j271869389 -> j2832441741;
		j271869389 -> j463273507;
	j2492163054 [label="+5 Chemistry",color=orange];
		j2492163054 -> j743156874;
	j2021208901 [label="Katılıyorum, kendimize söylediğimiz yalanlar çoğu zaman gerçeklerden daha önemlidir. Harika bir bakış açısı, Gaspçı.",shape=box,color=blue];
		j2021208901 -> j851297134;
	j2832441741 [label="Ailen seni öylece gönderdi mi? Ne kadar süreliğine?",shape=box,color=red];
		j2832441741 -> j3014474603;
	j463273507 [label="Orası nasıldı?",shape=box,color=red];
		j463273507 -> j2336706212;
	j743156874 [label="Nerede “yanlış” yola saptığımı bulmaya mı çalışıyorsun değil mi? Anlıyorum! Ne kadar eğlenceli. Çocukluğumda aradığın cevapları bulabileceğini sanmıyorum.",shape=box,color=blue];
		j743156874 -> j3189823118;
	j851297134 [label="Add -1 to Thermostat counter",color=orange];
		j851297134 -> j271869389;
	j3014474603 [label="Tüm gençlik hayatım boyunca. Beni dünyaya getiren ikisini bir daha hiç görmedim sanırım. Belki de sınıf birincisi olduğum tören sırasında?",shape=box,color=blue];
		j3014474603 -> j3121330562;
	j2336706212 [label="Sanırım kiminle konuştuğuna bağlı olarak görüşler büyük ölçüde değişecektir. İlk geldiğimde, büyük çocuklardan aldığım dayaklar hızlıydı ve dersler acımasızca etkiliydi.",shape=box,color=blue];
		j2336706212 -> j3691676894;
	j3189823118 [label="Add 1 to Thermostat counter",color=orange];
		j3189823118 -> j271869389;
	j3121330562 [label="Sanırım ilk defa bana sahip çıkmayı uygun gördüler. Pek umursamıyorum.",shape=box,color=blue];
		j3121330562 -> j668153385;
	j3691676894 [label="Ama ben her zaman hızlı öğrenen biri oldum. Ve bu özel alanda Arşimet'te öne çıkmak istiyorsam, en iyisi yaratıcı teknikler kullanarak en kötülerle birlikte batmamayı öğrenmem gerektiğini anladım.",shape=box,color=blue];
		j3691676894 -> j4035779758;
		j3691676894 -> j792033480;
	j668153385 [label="Ailemi pek hatırlamıyorum. Bazı Orokin'ler kendi çocuklarını yetiştirmeye hevesliyken, benimkiler öyle değildi. Benden kurtulup kendi hayatlarına devam etmek için can atıyorlardı.",shape=box,color=blue];
		j668153385 -> j2715903508;
		j668153385 -> j2051301380;
	j4035779758 [label="Arşimet'liler buna izin mi verdi?",shape=box,color=red];
		j4035779758 -> j4253342649;
	j792033480 [label="Bu... korkunç.",shape=box,color=red];
		j792033480 -> j2204501602;
	j2715903508 [label="Bu, hayatında seni hiç engellemiş gibi görünmüyordu.",shape=box,color=red];
		j2715903508 -> j3714896051;
	j2051301380 [label="Üzgünüm. Bu çok üzücü bir durum gibi görünüyor.",shape=box,color=red];
		j2051301380 -> j3714896051;
	j4253342649 [label="Zavallı Gaspçım, bir akşam yeni üyelerden ikisi için işler çok ileri gittiğinde, bir şişe Kuva ve bir hizmetçi çocuğu getiren bizzat okul müdürüydü.",shape=box,color=blue];
		j4253342649 -> j2708419511;
	j2204501602 [label="Gelenek güçlü bir araçtır, Gaspçı. Birçok aklı başında insanı çılgınca düşüncelere hapsetmek için kullanılabilecek güçlü ve tehlikeli bir araç.",shape=box,color=blue];
		j2204501602 -> j1200558556;
	j3714896051 [label="Tam tersi. Ailevi bağlarımın olmaması nedeniyle, akranlarıma arkaik ve çağdışı gelen militarist stratejilere daha fazla zaman ayırabiliyordum. ",shape=box,color=blue];
		j3714896051 -> j3528342254;
	j2708419511 [label="Gelenek güçlü bir araçtır. Birçok aklı başında insanı çılgınca düşüncelere hapsetmek için kullanılabilecek güçlü ve tehlikeli bir araç.",shape=box,color=blue];
		j2708419511 -> j3551885890;
		j2708419511 -> j3694321066;
	j1200558556 [label="Bir akşam yeni üyelerden ikisi için işler çok ileri gittiğinde, bir şişe Kuva ve bir hizmetçi çocuğu getiren bizzat okul müdürüydü.",shape=box,color=blue];
		j1200558556 -> j3551885890;
		j1200558556 -> j3694321066;
	j3528342254 [label="Bunun ileride bana ne kadar faydası olacağını bilmiyorlardı.",shape=box,color=blue];
		j3528342254 -> j75966461;
		j3528342254 -> j2747499140;
	j3551885890 [label="Peki ya ailen?",shape=box,color=red];
		j3551885890 -> j668153385;
	j3694321066 [label="Orada hiç arkadaşın var mıydı?",shape=box,color=red];
		j3694321066 -> j2214734079;
	j75966461 [label="Değdi mi sence?",shape=box,color=red];
		j75966461 -> j2031430618;
	j2747499140 [label="Ama sanki yalnız bir hayat yaşamışsın gibi görünüyor.",shape=box,color=red];
		j2747499140 -> j2958346316;
	j2214734079 [label="Hayır. Kendi kendime kaldım. Korkunun başkalarında yaratılması ve kullanılması kolay bir şey olduğunu öğrendim, ancak ışığa maruz kaldığında eriyen narin bir dantel gibi.",shape=box,color=blue];
		j2214734079 -> j3361549586;
	j2031430618 [label="Arkadaşlarım, bu çalışmaların gelecekte bana ne kadar fayda sağlayacağını bilmiyorlardı. Peki, net kazanç mı, kayıp mı diye soruyorsan?",shape=box,color=blue];
		j2031430618 -> j1270549667;
	j2958346316 [label="Evet, gördüm. Ama şeytan gibi bir hayat yaşıyorsan işler böyle yürür, değil mi? O zaman bile, ya güçsüz bir ikinci adam ve metresi ya da kanlı bir savaş lordu ve azgın bir canavar olarak görülüyordu.",shape=box,color=blue];
		j2958346316 -> j4243424067;
	j3361549586 [label="Canavarlar karanlıkta tutulmalı. Ve eğer etrafımda bir tehlike havası yaratacaksam, o zaman yalnız kalmam gerekirdi.",shape=box,color=blue];
		j3361549586 -> j2715903508;
		j3361549586 -> j2051301380;
	j1270549667 [label="Hımm. Bilmiyorum.",shape=box,color=blue];
		j1270549667 -> j1868332826;
		j1270549667 -> j3051052934;
	j4243424067 [label="Ne benden üstte olanlar, ne de benden altta olanlar tarafından asla hoş karşılanmadım. Ve benim konuşabileceğim akranlarım yoktu.",shape=box,color=blue];
		j4243424067 -> j299591844;
