	3121 [label="Çocukluğun nasıldı, Roathe?",shape=box,color=red];
		3121 -> 3123;
	3122 [label="[Son.]",shape=box,color=red];
		3122 -> 3124;
	3123 [label="Hımm? İlginç bir soru. ''Nasıl''dı? Açıkçası pek hatırlamıyorum. Ve o anıları barındıran yıldızlar ve heykeller muhtemelen çoktan toza dönüşmüş veya Endo'ya dönüşmüştür, sanırım.",shape=box,color=blue];
		3123 -> 3125;
	3124 [label="Chat ends.",color=orange];
	3125 [label="Çok uzun zaman önce olduğu için, sadece çok kısa görüntüleri hatırlayabiliyorum. Çoğunu bir rüyada hayal etmiş miyim, yoksa tarih kitabında okuduğum olaylara kendi hayal gücümü katmış mıyım diye merak ediyorum.",shape=box,color=blue];
		3125 -> 3126;
	3126 [label="Dolayısıyla, hatırlayabildiklerim büyük olasılıkla son derece güvenilmez, kabul ediyorum. Neden soruyorsun?",shape=box,color=blue];
		3126 -> 3127;
		3126 -> 3128;
		3126 -> 3129;
	3127 [label="Hikayeler yalan olsa bile, bunlar yine de çocukluk yılların hakkında kendine anlattığın hikayelerdir. Yine de bilmeye değer.",shape=box,color=red];
		3127 -> 3130;
	3128 [label="Orokin soyluları arasında büyümenin nasıl bir şey olduğunu merak ediyorum.",shape=box,color=red];
		3128 -> 3131;
	3129 [label="\"Seni\" bu hale getiren neydi merak ediyorum. Nasıl oldu da böyle oldun?",shape=box,color=red];
		3129 -> 3132;
	3130 [label="+5 Chemistry",color=orange];
		3130 -> 3133;
	3131 [label="Tüm Orokin gençleri gibi, ben de genç yaşta, fanatiklerin \"yatılı okul\" dediği bir yere gönderildim. Orada, eğilimlerim ve yeteneklerim test edildi ve eğitildim.",shape=box,color=blue];
		3131 -> 3134;
		3131 -> 3135;
	3132 [label="+5 Chemistry",color=orange];
		3132 -> 3136;
	3133 [label="Katılıyorum, kendimize söylediğimiz yalanlar çoğu zaman gerçeklerden daha önemlidir. Harika bir bakış açısı, Gaspçı.",shape=box,color=blue];
		3133 -> 3137;
	3134 [label="Ailen seni öylece gönderdi mi? Ne kadar süreliğine?",shape=box,color=red];
		3134 -> 3138;
	3135 [label="Orası nasıldı?",shape=box,color=red];
		3135 -> 3139;
	3136 [label="Nerede “yanlış” yola saptığımı bulmaya mı çalışıyorsun değil mi? Anlıyorum! Ne kadar eğlenceli. Çocukluğumda aradığın cevapları bulabileceğini sanmıyorum.",shape=box,color=blue];
		3136 -> 3140;
	3137 [label="Add -1 to Thermostat",color=orange];
		3137 -> 3131;
	3138 [label="Tüm gençlik hayatım boyunca. Beni dünyaya getiren ikisini bir daha hiç görmedim sanırım. Belki de sınıf birincisi olduğum tören sırasında?",shape=box,color=blue];
		3138 -> 3141;
	3139 [label="Sanırım kiminle konuştuğuna bağlı olarak görüşler büyük ölçüde değişecektir. İlk geldiğimde, büyük çocuklardan aldığım dayaklar hızlıydı ve dersler acımasızca etkiliydi.",shape=box,color=blue];
		3139 -> 3142;
	3140 [label="Add 1 to Thermostat",color=orange];
		3140 -> 3131;
	3141 [label="Sanırım ilk defa bana sahip çıkmayı uygun gördüler. Pek umursamıyorum.",shape=box,color=blue];
		3141 -> 3143;
	3142 [label="Ama ben her zaman hızlı öğrenen biri oldum. Ve bu özel alanda Arşimet'te öne çıkmak istiyorsam, en iyisi yaratıcı teknikler kullanarak en kötülerle birlikte batmamayı öğrenmem gerektiğini anladım.",shape=box,color=blue];
		3142 -> 3144;
		3142 -> 3145;
	3143 [label="Ailemi pek hatırlamıyorum. Bazı Orokinler kendi çocuklarını yetiştirmeye hevesliyken, benimkiler öyle değildi. Benden kurtulup kendi hayatlarına devam etmek için can atıyorlardı.",shape=box,color=blue];
		3143 -> 3146;
		3143 -> 3147;
	3144 [label="Arşimet'liler buna izin mi verdi?",shape=box,color=red];
		3144 -> 3148;
	3145 [label="Bu... korkunç.",shape=box,color=red];
		3145 -> 3149;
	3146 [label="Bu, hayatında seni hiç engellemiş gibi görünmüyordu.",shape=box,color=red];
		3146 -> 3150;
	3147 [label="Üzgünüm. Bu çok üzücü bir durum gibi görünüyor.",shape=box,color=red];
		3147 -> 3150;
	3148 [label="Zavallı Gaspçım, bir akşam yeni üyelerden ikisi için işler çok ileri gittiğinde, bir şişe Kuva ve bir hizmetçi çocuğu getiren bizzat okul müdürüydü.",shape=box,color=blue];
		3148 -> 3151;
	3149 [label="Gelenek güçlü bir araçtır, Gaspçı. Birçok aklı başında insanı çılgınca düşüncelere hapsetmek için kullanılabilecek güçlü ve tehlikeli bir araç.",shape=box,color=blue];
		3149 -> 3152;
	3150 [label="Tam tersi. Ailevi bağlarımın olmaması nedeniyle, akranlarıma arkaik ve çağdışı gelen militarist stratejilere daha fazla zaman ayırabiliyordum. ",shape=box,color=blue];
		3150 -> 3153;
	3151 [label="Gelenek güçlü bir araçtır. Birçok aklı başında insanı çılgınca düşüncelere hapsetmek için kullanılabilecek güçlü ve tehlikeli bir araç.",shape=box,color=blue];
		3151 -> 3154;
		3151 -> 3155;
	3152 [label="Bir akşam yeni üyelerden ikisi için işler çok ileri gittiğinde, bir şişe Kuva ve bir hizmetçi çocuğu getiren bizzat okul müdürüydü.",shape=box,color=blue];
		3152 -> 3154;
		3152 -> 3155;
	3153 [label="Bunun ileride bana ne kadar faydası olacağını bilmiyorlardı.",shape=box,color=blue];
		3153 -> 3156;
		3153 -> 3157;
	3154 [label="Peki ya ailen?",shape=box,color=red];
		3154 -> 3143;
	3155 [label="Orada hiç arkadaşın var mıydı?",shape=box,color=red];
		3155 -> 3158;
	3156 [label="Değdi mi sence?",shape=box,color=red];
		3156 -> 3159;
	3157 [label="Ama sanki yalnız bir hayat yaşamışsın gibi görünüyor.",shape=box,color=red];
		3157 -> 3160;
	3158 [label="Hayır. Kendi kendime kaldım. Korkunun başkalarında yaratılması ve kullanılması kolay bir şey olduğunu öğrendim, ancak ışığa maruz kaldığında eriyen narin bir dantel gibi.",shape=box,color=blue];
		3158 -> 3161;
	3159 [label="Arkadaşlarım, bu çalışmaların gelecekte bana ne kadar fayda sağlayacağını bilmiyorlardı. Peki, net kazanç mı, kayıp mı diye soruyorsan?",shape=box,color=blue];
		3159 -> 3162;
	3160 [label="Evet, gördüm. Ama şeytan gibi bir hayat yaşıyorsan işler böyle yürür, değil mi? O zaman bile, ya güçsüz bir ikinci adam ve metresi ya da kanlı bir savaş lordu ve azgın bir canavar olarak görülüyordu.",shape=box,color=blue];
		3160 -> 3163;
	3161 [label="Canavarlar karanlıkta tutulmalı. Ve eğer etrafımda bir tehlike havası yaratacaksam, o zaman yalnız kalmam gerekirdi.",shape=box,color=blue];
		3161 -> 3146;
		3161 -> 3147;
	3162 [label="Hımm. Bilmiyorum.",shape=box,color=blue];
		3162 -> 3164;
		3162 -> 3165;
	3163 [label="Ne benden üstte olanlar, ne de benden altta olanlar tarafından asla hoş karşılanmadım. Ve benim konuşabileceğim akranlarım yoktu.",shape=box,color=blue];
		3163 -> 3166;
	3164 [label="Yaptıklarını telafi etmek için bir şansın daha var. Onların yok. ",shape=box,color=red];
		3164 -> 3167;
	3165 [label="Eh, onlar öldü ama sen ölmedin. Yani sanırım evet, öyle oldu.",shape=box,color=red];
