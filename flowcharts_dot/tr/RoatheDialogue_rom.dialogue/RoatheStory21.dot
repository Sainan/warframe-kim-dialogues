		5726 -> 5727;
	5727 [label="Şimdi hatırlıyorum. Altın Salonlarda bana yaklaştı. Tanımadığım bir yüzü vardı. Ama bu durum bizim türümüz için çok da alışılmadık bir şey değildi. Kesin olarak tanıdığım şey sesiydi. Hareketleriydi.",shape=box,color=blue];
		5727 -> 5728;
