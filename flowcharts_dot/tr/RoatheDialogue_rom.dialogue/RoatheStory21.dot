		2321 -> 5725;
	5725 [label="Bana öyle diyorlardı, değil mi? Bu tozlu salonda etrafa saçılmış tarih kitaplarını okudum. Bir yalanı. Gerçeği bilmiyorlardı. İşimi tamamlayamadan zamanımdan koparıldığımı bilmiyorlardı.",shape=box,color=blue];
