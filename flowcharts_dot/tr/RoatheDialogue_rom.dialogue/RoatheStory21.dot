		j3473638090 -> j932356507;
	j932356507 [label="Bana öyle diyorlardı, değil mi? Bu tozlu salonda etrafa saçılmış tarih kitaplarını okudum. Bir yalanı. Gerçeği bilmiyorlardı. İşimi tamamlayamadan zamanımdan koparıldığımı bilmiyorlardı.",shape=box,color=blue];
		j932356507 -> j2897824955;
	j2897824955 [label="Korkak.",shape=box,color=blue];
		j2897824955 -> j2845392226;
	j2845392226 [label="Şimdi hatırlıyorum. Altın Salonlarda bana yaklaştı. Tanımadığım bir yüzü vardı. Ama bu durum bizim türümüz için çok da alışılmadık bir şey değildi. Kesin olarak tanıdığım şey sesiydi. Hareketleriydi.",shape=box,color=blue];
		j2845392226 -> j3880659299;
	j3880659299 [label="Korkak!",shape=box,color=blue];
		j3880659299 -> j1666867362;
	j1666867362 [label="Bana tek bir soru sordu. Her şeyi küle çevirdiğim için affedilebileceğime gerçekten inanıyor muydum?",shape=box,color=blue];
		j1666867362 -> j3180260880;
	j3180260880 [label="KORKAK!",shape=box,color=blue];
		j3180260880 -> j2980425781;
	j2980425781 [label="O soluk, uzanmış elinde bir şırınga…. Özgürlükle parıldayan… başka bir şansla… başka bir hayatla.",shape=box,color=blue];
		j2980425781 -> j3980612720;
