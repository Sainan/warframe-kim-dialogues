		j3935365602 -> j3700732538;
	j3700732538 [label="Transkript: Sistemin ilk Sentinent istilası ve Orokin'in felaketle sonuçlanan cevabından sonra, tuhaf bir sessizlik hüküm sürdü.",shape=box,color=blue];
		j3700732538 -> j2702651652;
	j2702651652 [label="Tau'da mahsur kalan halkımızdan hiçbir haber alamadık ve sinyallerinin mi karıştırıldığını yoksa tamamen mi yok edildiğini bilmemizin bir yolu yoktu.",shape=box,color=blue];
		j2702651652 -> j1820170182;
	j1820170182 [label="Kendimi fikirlerim için ricada bulunurken buldum. Stratejist olarak, düşmanı anlamam bekleniyordu.",shape=box,color=blue];
		j1820170182 -> j3498283360;
	j3498283360 [label="Sentient'ler, Tau'nun üzerindeki Solar Raylı Terminali'ni her an yok edebilirlerdi, ancak Ray hala aktifti.",shape=box,color=blue];
		j3498283360 -> j1627220331;
	j1627220331 [label="Neden? Geçidi açık bırakarak ne kazandılar?",shape=box,color=blue];
		j1627220331 -> j3393842444;
	j3393842444 [label="Saldırganlıklarında tek bir yürek mi olmuşlardı? Yoksa bazıları hâlâ barış içinde bir arada yaşamayı mı umuyordu?",shape=box,color=blue];
		j3393842444 -> j921430358;
