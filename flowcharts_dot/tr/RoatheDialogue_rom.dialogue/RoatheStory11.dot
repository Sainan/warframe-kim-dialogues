	j397251883 [label="Transkript: Sistemin ilk Sentinent istilası ve Orokin'in felaketle sonuçlanan cevabından sonra, tuhaf bir sessizlik hüküm sürdü.",shape=box,color=blue];
		j397251883 -> j1696289101;
	j1696289101 [label="Tau'da mahsur kalan halkımızdan hiçbir haber alamadık ve sinyallerinin mi karıştırıldığını yoksa tamamen mi yok edildiğini bilmemizin bir yolu yoktu.",shape=box,color=blue];
		j1696289101 -> j2948266723;
	j2948266723 [label="Kendimi fikirlerim için ricada bulunurken buldum. Stratejist olarak, düşmanı anlamam bekleniyordu.",shape=box,color=blue];
		j2948266723 -> j4008077678;
	j4008077678 [label="Sentientler, Tau'nun üzerindeki Solar Raylı Terminali'ni her an yok edebilirlerdi, ancak Ray hala aktifti.",shape=box,color=blue];
		j4008077678 -> j1627220331;
	j1627220331 [label="Neden? Geçidi açık bırakarak ne kazandılar?",shape=box,color=blue];
