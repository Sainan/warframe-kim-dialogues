	999 [label="Ama o bunu yapmadı. Ballas o akşam ona bir bakış attı ve... yıldırım çarpmışa döndü Gezgin. Tam anlamıyla kendinden geçmişti.",shape=box,color=blue];
		999 -> 1000;
	1000 [label="Böyle bir şeyi daha önce hiç yaşamamıştım. Sanki Margulis dışında odada kimse yokmuş gibiydik. Hatta... onunla konuşmaya bile çekiniyor gibiydi. O! Ballas!",shape=box,color=blue];
		1000 -> 1001;
		1000 -> 1002;
	1001 [label="Gerçekten mi?",shape=box,color=red];
		1001 -> 1003;
	1002 [label="Bunu sen uyduruyorsun.",shape=box,color=red];
		1002 -> 1004;
	1003 [label="Namusum üzerine yemin ederim! Hem yalan söylemek için ne gibi bir sebebim olabilir ki? Onların ilişkilerinin geçerliliği hakkındaki görüşün beni neden ilgilendirsin ki?",shape=box,color=blue];
		1003 -> 1005;
	1004 [label="Namusum üzerine yemin ederim ki uydurmuyorum! Hem yalan söylemek için ne gibi bir sebebim olabilir ki? Onların ilişkilerinin geçerliliği hakkındaki görüşün beni neden ilgilendirsin ki?",shape=box,color=blue];
		1004 -> 1005;
	1005 [label="Çok daha karmaşık bir şeyi bu kadar çabuk basitleştirmen beni gerçekten üzüyor.",shape=box,color=blue];
		1005 -> 1006;
	1006 [label="İster inan ister inanma, birbirlerine aşıktılar. Ballas, tüm sınıf kurallarını ve gelenekleri bir kenara bırakarak sevgilisi ve tek romantik yoldaşı olarak bir Arşimet'i seçti. ",shape=box,color=blue];
		1006 -> 1007;
	1007 [label="Sadece gerçek aşk, her şey çok ters gittiğinde onu bu kadar çılgına çevirebilirdi...",shape=box,color=blue];
		1007 -> 1008;
		1007 -> 1009;
	1008 [label="Nasıl yani? Ölümünden o sorumlu değil miydi?",shape=box,color=red];
		1008 -> 1010;
	1009 [label="Onu idam ettiren Ballas'tı.",shape=box,color=red];
		1009 -> 1010;
	1010 [label="Öncelikle, bildiğin her şeyin doğru olduğunu ve oradaki eylemlerin tamamen kendi isteğiyle gerçekleştiğini varsayalım. Perde arkasında onu zorlayabilecek başka bir siyasi manevra, şantaj veya başka bir şey yapılmadığını varsayalım.",shape=box,color=blue];
		1010 -> 1011;
	1011 [label="Öyle olsa ve Ballas hiçbir etki altında kalmadan onun idamını istese bile, artık çok geçti. Hissettiği ihanet onu çoktan ikiye bölmüştü.",shape=box,color=blue];
		1011 -> 1012;
	1012 [label="Kalbi ve aklı çoktan paramparça olmuştu.",shape=box,color=blue];
		1012 -> 1013;
		1012 -> 1014;
	1013 [label="Eğer benden ona acımamı bekliyorsan, bunu yapmayacağım.",shape=box,color=red];
		1013 -> 1015;
	1014 [label="Tenno yüzünden mi? Yoksa ona yaptıkları yüzünden mi?",shape=box,color=red];
		1014 -> 1016;
	1015 [label="Senden böyle bir şey istemiyorum! Ballas, cesedini gömdüğün yere pislemekten başka bir şeyi hak etmiyor - tabii bir mezarı varsa.",shape=box,color=blue];
		1015 -> 1017;
	1016 [label="Bir bakıma ikisi de. Bir bakıma ikisi de değil. O gün, onun idamını istediğinde deliye dönmüştü. Aslında, bir parçası bu olayı tam olarak hatırlayamıyor olsa da buna hiç şaşırmazdım.",shape=box,color=blue];
		1016 -> 1018;
	1017 [label="Sadece, onun idamını emrettiği gün deliye döndüğünü söylüyorum. İşin sonunda, içindeki bir parçanın bu eylemi tam olarak hatırlamamasına şaşırmam.",shape=box,color=blue];
		1017 -> 1018;
	1018 [label="Ballas, Margulis'i seviyordu. Tüm benliğiyle, tamamen, bütün benliğiyle ona adanmıştı. Onun için her şeyi feda edebilirdi. Ruhunu, bedenini, Orokin İmparatorluğu'nu. Hayal edebileceğin her şeyi.",shape=box,color=blue];
		1018 -> 1019;
	1019 [label="Hiçbir bedel yeterince büyük değildi. Uğrunda feda edilmeyecek herhangi bir ahlak kuralı vardı. Kucağına yeni doğmuş bir bebek verip Margulis'in beyninin kayalıklara çarparak parçalanmasını istediğini söyleseydin, cümleni bitirmeden onu öldürmüş olurdu.",shape=box,color=blue];
		1019 -> 1020;
	1020 [label="Origin Sistemi'ni küle çevirip kendi bildiğince yeniden inşa edecekti, Gaspçı... ama trajedi burada yatıyor.",shape=box,color=blue];
		1020 -> 1021;
	1021 [label="Margulis mi? Ah, Margulis. Canım, tatlı, sevgili Margulis... hâlâ vicdanı vardı.",shape=box,color=blue];
		1021 -> 1022;
	1022 [label="Ve zavallı Tenno'yu, Void'in parçaladığı o zavallı çocukları gördüğünde... ",shape=box,color=blue];
		1022 -> 1023;
	1023 [label="Hayatında Ballas'tan daha önemli bir şey vardı. Hayatında hayatını feda etmeye değer bir şey vardı... o da Ballas değildi.",shape=box,color=blue];
		1023 -> 1024;
	1024 [label="Bu onun ona olan aşkı değildi.",shape=box,color=blue];
		1024 -> 1025;
	1025 [label="Ve bunu biliyordu, sevgili Gezgin. Bunu, onları gördüğü andan itibaren biliyordu. Ve \"çılgın hayvanları\" onun gördüğü son şey olmasını sağladığında, bu gerçek iyice anlaşılmış oldu. En azından Orokin'ler arasında dolaşan söylentiler böyleydi.",shape=box,color=blue];
		1025 -> 1026;
	1026 [label="Orokin'in sevincini hayal edebiliyor musun? Ballas'ın değerli Arşimet'inin Void tarafından parçalanmış, kuduz veletlerinin onun gözlerini yakmasını görmeyi?",shape=box,color=blue];
		1026 -> 1027;
	1027 [label="Ama sanırım, tam da Margulis'in Tenno'yu kurtarmak için mücadele ettiği anda Ballas'ın kalbi bin parçaya bölündü ve bir daha asla toparlanamadı.",shape=box,color=blue];
		1027 -> 1028;
	1028 [label="Çünkü o, onun kalbinde yerini başkasına kaptırdığını biliyordu.",shape=box,color=blue];
		1028 -> 1029;
	1029 [label="Sanırım bu yüzden ona acıyordum. Peki ya sonrası? Çağlar boyu sürecek bir aşk hikâyesi... ve nasıl böylesine üzücü bir trajediyle son buldu. ",shape=box,color=blue];
		1029 -> 1030;
	1030 [label="Keşke birbirlerine nasıl gülümsediklerini görebilseydin...",shape=box,color=blue];
		1030 -> 1031;
		1030 -> 1032;
	1031 [label="Onların yaşadıklarını romantikleştirebilirsin ama bu onun kim olduğunu asla mazur göstermez. Ballas'ın yaptıkları affedilemez.",shape=box,color=red];
		1031 -> 1033;
	1032 [label="Aşklarının gerçek olmasına sevindim. O zamanlar onun... karmaşık bir insan olmasına. Ve Margulis'in tüm bu süre boyunca sadece oyuncak olarak kullanılmamış olmasına.",shape=box,color=red];
		1032 -> 1034;
	1033 [label="Add 1 to Thermostat",color=orange];
		1033 -> 1035;
	1034 [label="Add -1 to Thermostat",color=orange];
		1034 -> 1036;
	1035 [label="+10 Chemistry",color=orange];
		1035 -> 1037;
	1036 [label="+10 Chemistry",color=orange];
		1036 -> 1038;
	1037 [label="İkisini eşitlemeye çalışmıyordum, Gaspçı. Sadece bir adamın sevilebileceğini ama aynı zamanda korkunç şeyler de yapabileceğini söylüyordum. Ah, neyse... Sanırım geri kalanımız, ahlaksız aptallar için hiçbir umut yok...",shape=box,color=blue];
		1037 -> 1039;
	1038 [label="Gerçekten de öyle. Bazen, o sapkınlığın efendisi bile kendine bir yoldaş bulabildiyse, geri kalanımız için umut var demektir düşüncesi bana huzur veriyor, ne dersin? Ha!",shape=box,color=blue];
		1038 -> 1039;
	1039 [label="Update boolean RoatheMargulis1",color=orange];
		1039 -> 1040;
	1040 [label="Ama bugünlük yeteri kadar vaktini aldım. Hadi bakalım, şimdi gidebilirsin. ",shape=box,color=blue];
		1040 -> 1041;
	1041 [label="Chat ends.",color=orange];
}