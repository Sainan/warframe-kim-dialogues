		j2361151873 -> j1590059941;
	j1590059941 [label="Bize saldıran ordularla karşı karşıya kaldık, onların bireysel yaşamlarına, kan hücrelerinin yaşamlarına gösterilen saygıdan daha fazla saygı gösterilmiyordu.",shape=box,color=blue];
