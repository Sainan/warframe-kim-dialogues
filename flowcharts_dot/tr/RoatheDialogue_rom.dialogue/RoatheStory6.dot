		j1407783246 -> j2144905828;
	j2144905828 [label="Sanırım, Infested ile yaşadığımız deneyimlerden çok etkilenmiştik - bu, oldukça farklı bir türden bir kovan zihin idi.",shape=box,color=blue];
		j2144905828 -> j382283958;
