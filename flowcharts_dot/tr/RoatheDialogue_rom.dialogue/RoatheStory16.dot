	j2821991788 [label="SM: FEDAKARLIK",shape=box,color=blue];
		j2821991788 -> j21027648;
	j21027648 [label="Transkript: Traivon. Railjack'ini Praghasa'nın ağzına fırlattığını gördüm. Dikkati dağılmış, seni ve adamlarını açgözlülükle yiyip bitiren o, benim hızla uzaklaşan gemimi hiç fark etmedi.",shape=box,color=blue];
		j21027648 -> j3853199460;
	j3853199460 [label="Üstün için canını feda ettin. Özverililiğini yüzüme atılmış bir tokat gibi hissettim.",shape=box,color=blue];
		j3853199460 -> j941799831;
	j941799831 [label="Maryna. Bana bedenini verdin. Birlikte, o hendekte Kuva içtik. Ellerim titriyordu ve kesik boğazım sızdırıyordu ama kendime yetecek kadarını içebildim.",shape=box,color=blue];
		j941799831 -> j1819931916;
	j1819931916 [label="Son selamını hatırlıyorum. Sönüp gidişini. Sonra sana ait olan gözlerimi kırpıştırarak açtım ve içi parçalanmış cesedimin çamurda cansız yattığını gördüm.",shape=box,color=blue];
		j1819931916 -> j168794277;
	j168794277 [label="Rostig. Klonlama sürecinde bir sorun olmuş, dediler. Grineer'ın canlı canlı yanarken kulede kalmasına başka ne sebep olabilir ki? Bir fare bile kendini koruma içgüdüsüne sahiptir!",shape=box,color=blue];
		j168794277 -> j1407031944;
	j1407031944 [label="Hayır. Senin \"kusurun\" seni onların üstünde tuttu.",shape=box,color=blue];
		j1407031944 -> j921430358;
	j921430358 [label="Add 1 to HellStory counter",color=orange];
		j921430358 -> "Chat ends.";
}