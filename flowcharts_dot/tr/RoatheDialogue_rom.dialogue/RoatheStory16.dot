	2275 [label="Transkript: Traivon. Railjack'ini Praghasa'nın ağzına fırlattığını gördüm. Dikkati dağılmış, seni ve adamlarını açgözlülükle yiyip bitiren o, benim hızla uzaklaşan gemimi hiç fark etmedi.",shape=box,color=blue];
