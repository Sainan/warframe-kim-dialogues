	5714 [label="Maryna. Bana bedenini verdin. Birlikte, o hendekte Kuva içtik. Ellerim titriyordu ve kesik boğazım sızdırıyordu ama kendime yetecek kadarını içebildim.",shape=box,color=blue];
		5714 -> 2278;
	2278 [label="Son selamını hatırlıyorum. Sönüp gidişini. Sonra sana ait olan gözlerimi kırpıştırarak açtım ve içi parçalanmış cesedimin çamurda cansız yattığını gördüm.",shape=box,color=blue];
		2278 -> 2272;
	2272 [label="Rostig. Klonlama sürecinde bir sorun olmuş, dediler. Grineer'ın canlı canlı yanarken kulede kalmasına başka ne sebep olabilir ki? Bir fare bile kendini koruma içgüdüsüne sahiptir!",shape=box,color=blue];
		2272 -> 2279;
