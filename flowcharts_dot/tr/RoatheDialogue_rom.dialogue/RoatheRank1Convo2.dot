		j4025920765 -> j3265617040;
	j2025973576 [label="[Son.]",shape=box,color=red];
		j2025973576 -> "Chat ends.";
	j3602494225 [label="Bu tımarhanede konuştuğum herkes, bu \"Duvardaki Adam\"ın gerçek ve gülünç bir tanrı olduğuna tamamen ikna olmuş durumda. Hem de gerçek bir tanrı. Hatta o iki fanatik bile bu fikri eğlenceli buluyor gibi görünüyor!",shape=box,color=blue];
		j3602494225 -> j1988416469;
		j3602494225 -> j4292860054;
		j3602494225 -> j200492662;
	j3265617040 [label="Peki, bir tanrıya veya tanrılara olan inancın, ilk olarak ölüm anında ruhunun sonunun geldiği gerçeğiyle yüzleştiğinde bir peluş hayvana sıkıca sarılma ihtiyacı hisseden aptallardan kaynaklanan acı bir gerçek olduğunu kenara bırakıyorum,",shape=box,color=blue];
		j3265617040 -> j3719380740;
	"Chat ends." [color=orange];
	j1988416469 [label="Onun gerçek olduğunu düşünmüyor musun?",shape=box,color=red];
		j1988416469 -> j619882964;
	j4292860054 [label="Peki eğer onun bir tanrı olduğunu düşünmüyorsan, o zaman ne olduğunu düşünüyorsun?",shape=box,color=red];
		j4292860054 -> j833088624;
	j200492662 [label="Peki sen bunu eğlenceli bulmuyor musun?",shape=box,color=red];
		j200492662 -> j1633062233;
	j3719380740 [label="İkinci olarak, hayatımızda yolumuzu çizen bir “Yüce Güç”ün olmadığını ve dolayısıyla kendi eylemlerimizden sadece kendimizin sorumlu olduğunu anladığımızda yaşanan kaygı, ve buna bağlı,",shape=box,color=blue];
		j3719380740 -> j389860053;
	j619882964 [label="Şimdi, bu sözleri ben mi söyledim? Sözlerimi ağzıma tıkmakta bu kadar acele etme, Ey Geçici Gaspçı. Kayıtsızlığın \"gerçek\" olduğunu inkâr etmedim. Onun bir Tanrı olduğunu inkâr ettim.",shape=box,color=blue];
		j619882964 -> j2781795619;
		j619882964 -> j708970598;
	j833088624 [label="Bu sahte tanrıyı, kavrayıp ve çok iyi anlaman için iki basit kelimeyle ortaya çıkarabilirim:",shape=box,color=blue];
		j833088624 -> j3283484446;
	j1633062233 [label="Kesinlikle hayır! Birincisi, tanrı veya tanrılar diye bir şey yok, bu fikir saçma. İkincisi, Albrecht'in bir Void tanrısını serbest bıraktığını düşünmek? Daha da gülünç!",shape=box,color=blue];
		j1633062233 -> j2881930763;
	j389860053 [label="Üçüncü olarak da, tüm bunlar şeytanları bekleyen bir ''Cehennem''in, melekleri bekleyen bir ''Cennet''in olmadığı gerçeğinin farkına varılmasıyla birlikte gelen endişe ve dehşete eşlik eden haklı öfkedir.",shape=box,color=blue];
		j389860053 -> j379906694;
	j2781795619 [label="O şey şimdiye kadar karşılaştığım her şeyden daha güçlü.",shape=box,color=red];
		j2781795619 -> j1321255231;
	j708970598 [label="Peki sen onun ne olduğunu düşünüyorsun?",shape=box,color=red];
		j708970598 -> j833088624;
	j3283484446 [label="Kavramsal Bütünlük.",shape=box,color=blue];
		j3283484446 -> j1249022437;
		j3283484446 -> j1267817875;
		j3283484446 -> j3465052709;
	j2881930763 [label="Void'de hiçbir şey yoktur. Bu yüzden ona Void denir! ",shape=box,color=blue];
		j2881930763 -> j3063967923;
		j2881930763 -> j724580509;
	j379906694 [label="Öfkeye, dehşete veya kaygıya tutunan, ağzı sulanan bir fanatik olmadığını varsayıyorum. Bu varsayımdan yola çıkarak, \"Kayıtsızlık\"ın Tanrısallığının ortadan kaldırılması için sana sunmak istediğim ikinci argümana geçeceğim:",shape=box,color=blue];
		j379906694 -> j3283484446;
	j1321255231 [label="Peki ben bunu ne zaman inkar ettim ki? Aslında, görünüşe göre hepiniz kendinizi oldukça histerik ve gereksiz yere aşırı bir sıkıntıya sokmayı başarmışsınız.",shape=box,color=blue];
		j1321255231 -> j1016189840;
		j1321255231 -> j3841505242;
	j1249022437 [label="Void ve ondan yararlanabileceğimiz şeyler tehlikeli ve güçlüdür - inan bana, biliyorum. Ama sınırları vardır. Gerçekten böyle bir şeyi ortaya çıkarabileceğini mi düşünüyorsun? Bütün dilleri yaratabilecek, Void'de atlayabilen gemilere güç verebilecek parmakları yaratabilecek bir şeyi?",shape=box,color=red];
		j1249022437 -> j1940839141;
	j1267817875 [label="Yatağımızın altında bir canavar olduğuna inanmak çok cazip geliyor, Roathe. Ama ben bunu yüz yüze gördüm ve böyle bir şeyin nasıl aklımıza gelebildiğini anlayamıyorum.",shape=box,color=red];
		j1267817875 -> j850778614;
	j3465052709 [label="Kavramsal Bütünlük, Duvardaki Adam'ın yapabildiği şeyi yapamaz. Entrati o şeyi tezahür ettirmiş ve buraya getirmekten sorumlu olsa da, onun orijinal kaynak olduğuna inanmıyorum.",shape=box,color=red];
		j3465052709 -> j601065664;
	j3063967923 [label="Hayır. Void'den gelen şeyler gördüm. Melekler. Şarkı söyleyen. Hayaletler.",shape=box,color=red];
		j3063967923 -> j2779116286;
	j724580509 [label="Ben... ",shape=box,color=red];
		j724580509 -> j2779116286;
	j1016189840 [label="Ne diyorsun sen?",shape=box,color=red];
		j1016189840 -> j2299079744;
	j3841505242 [label="Dur bakalım. Bunun sorumlusu biz miyiz? Asıl suçlu Albrecht, her şeyi o başlattı.",shape=box,color=red];
		j3841505242 -> j3690547785;
	j1940839141 [label="İnsanlık, kendisi için yaratabileceği yeni acı biçimlerinin genişliği ve büyüklüğü konusunda yaratıcı olmasaydı, kesinlikle hiçbir şey olmazdı, değil mi? Siz de, sevgili fanatiklerimizin zamanında kimsenin hayal bile edemeyeceği birçok zulüm biçimine tanık oldunuz.",shape=box,color=blue];
		j1940839141 -> j3161553394;
	j850778614 [label="Ah, gerçeğe bu kadar yakınsın ama yine de onu reddetmekte bu kadar acelecisin. Kendi zihninin bir ürünü olduğuna inanmanın \"cazip\" olduğunu mu düşünüyorsun, çünkü öyle olsaydı reddetmek daha kolay olurdu? Hayır, bence kendi yarattığımız bir şeyle yüzleşmek, bir tanrıyla yüzleşmekten çok daha tehlikeli.",shape=box,color=blue];
		j850778614 -> j3603863772;
	j601065664 [label="Alçakgönüllülüğü takdir etmekle birlikte, insan yaratıcılığının kapasitesine dair sınırlı anlayışına - özellikle de yeni acı biçimleri yaratma yeteneğine - meydan okuyorum. Aslında kendi evrenini sıfırdan yaratmaktan tek başına sorumlu değil misin?",shape=box,color=blue];
		j601065664 -> j3022768423;
	j2779116286 [label="Void'den gelen tek şey, içine yerleştirdiklerimiz ve ondan geri dönenlerdir. Maddeyi ve enerjiyi değiştirir, ama yaratamaz.",shape=box,color=blue];
		j2779116286 -> j233594065;
	j2299079744 [label="Demek istediğim şu: Albrecht, kendi kibirinin, sırıtan bir yıkım tanrısının yüzünde kendisine bakan kişi olduğunu ilk fark eden kişi olabilir, evet.",shape=box,color=blue];
		j2299079744 -> j4257357800;
	j3690547785 [label="Albrecht, kendi kibirinin, sırıtan bir yıkım tanrısının yüzünde kendisine bakan kişi olduğunu ilk fark eden kişi olabilir, evet.",shape=box,color=blue];
		j3690547785 -> j4257357800;
	j3161553394 [label="+15 Chemistry",color=orange];
		j3161553394 -> j975318695;
	j3603863772 [label="Dışarıdaki bir düşman anlaşılabilir. Manipüle edilebilir. Yenilebilir. Hatta belki de pazarlık konusu bile olabilir, eğer iş oraya gelirse. Kullanılabilecek zayıflıkları vardır. Peki ya içerideki bir düşman? Kendi yarattığımız biri? Bu gerçekten çok daha sinsi.",shape=box,color=blue];
		j3603863772 -> j2660950359;
	j3022768423 [label="Siz de, sevgili fanatiklerimizin zamanında kimsenin hayal bile edemeyeceği birçok zulüm biçimine tanık oldunuz. ",shape=box,color=blue];
		j3022768423 -> j3423134816;
	j233594065 [label="Düşün Gezgin. Bahsettiğin şu \"Void Melekleri\". Bu hayaletler. Bunlar, zaten Void'de kaybolmuş olanlardan mı yaratıldı?",shape=box,color=blue];
		j233594065 -> j1013323048;
	j4257357800 [label="Ama sizler de, bu juba böceği pisliğini bu kadar uzun süre yokuş aşağı yuvarlamaya devam ederek, yol boyunca topladığı her pislik parçasıyla daha da büyütmekten eşit derecede sorumlusunuz!",shape=box,color=blue];
		j4257357800 -> j1066305912;
	j975318695 [label="Bir tür olarak, kendimizi yok etmek için korkularımıza yeni yollar bulma yeteneğimizle oldukça şaşırtıcıyız.",shape=box,color=blue];
		j975318695 -> j643719949;
	j2660950359 [label="+20 Chemistry",color=orange];
		j2660950359 -> j2762943358;
	j3423134816 [label="+10 Chemistry",color=orange];
		j3423134816 -> j975318695;
	j1013323048 [label="Onlar, çocuklarını beslemek için renkli bir kutak gibi kusulan enerjinin yankılarıydı.",shape=box,color=blue];
		j1013323048 -> j1066305912;
	j1066305912 [label="Tartışmayı senin için basitleştirmeme izin ver. Bu sahte tanrıyı, senin için, bilmen ve çok iyi anlaman gereken iki basit kelimeyle ortaya çıkarabilirim:",shape=box,color=blue];
		j1066305912 -> j3283484446;
	j643719949 [label="Mm. Korkarım ki gitmem gerek. Bir süre oturup sözlerimi düşünmene izin vereceğim.",shape=box,color=blue];
		j643719949 -> j1286026178;
		j643719949 -> j3741679097;
	j2762943358 [label="Çünkü o zaman kendi şeytanlarımızla savaşmak zorunda kalırız. Ve insanlık... böyle savaşları asla kazanamaz, değil mi?",shape=box,color=blue];
		j2762943358 -> j643719949;
	j1286026178 [label="Öyle yapacağım. Teşekkürler.",shape=box,color=red];
		j1286026178 -> j3819439049;
	j3741679097 [label="Benimkini düşün, bir anti-tanrı ile karşı karşıya kaldığında onlara inanmak isteyebilirsin.",shape=box,color=red];
		j3741679097 -> j3819439049;
