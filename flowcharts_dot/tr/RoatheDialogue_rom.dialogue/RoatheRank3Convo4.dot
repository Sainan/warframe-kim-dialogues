	j2895428426 [label="Çünkü, benim anlayabildiğim kadarıyla, tamamen başka bir gerçeklik versiyonundan gelen bir varlık olan senin, neden zaman ve uzayda çılgınca koşuşturup ''terapistlik oynadığını'' bir türlü anlayamıyorum.",shape=box,color=blue];
		j2895428426 -> j2010899105;
	j2628843372 [label="Evet, işte asıl mesele bu! Neden zaman ve mekanda \"Terapistlik\" oynamakta ısrar ediyorsun? Anladığım kadarıyla, gerçekliğin tamamen farklı bir versiyonundan gelen bir varlık olan sen, ",shape=box,color=blue];
		j2628843372 -> j2010899105;
