	j2010148036 [label="Hmm. Yabancılar için ayak işleri yapıp onları yerel bir kahraman gibi sana tapmaya mı zorluyorsun? Yoksa hepsini el ele tutuşup şarkı söylemeye mi ikna ediyorsun? Affedersin, Fibonacci'nin tankına kusmaya gidiyorum.",shape=box,color=blue];
