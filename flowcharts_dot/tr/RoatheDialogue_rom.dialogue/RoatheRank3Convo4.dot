	j3591090730 [label="Ah! Demek aptal olduğunu kabul ediyorsun! Ne kadar da aydınlatıcı. Aptalların zekâ eksikliklerini açıkça ortaya koymalarına bayılıyorum, onları manipüle etme görevimi daha da kolaylaştırıyor.",shape=box,color=blue];
