		j2706616494 -> j3533723967;
	j3533723967 [label="Transkript: Şimdi, Arşimet'in savaş alanındaki gelişmelerinin ilk başta eğlence amaçlı sunulduğunu hatırlıyorum. ",shape=box,color=blue];
		j3533723967 -> j1832149296;
	j1832149296 [label="Ahlaksız serseriler gibi, suçluların arenada-sirkte idam edilmesini izliyorlar.",shape=box,color=blue];
		j1832149296 -> j1379116224;
	j1379116224 [label="Biz, çok daha zayıf bir düşmanı ortadan kaldırmak için yeni ve heyecan verici yöntemler bulduğumuzu hayal ediyorduk.",shape=box,color=blue];
		j1379116224 -> j2219061396;
	j2219061396 [label="Kendimizi nasıl da pohpohladık. Aslında, değişken düşmanlarımızın bizi alt ettiğini bilerek, umutsuzca yenilikler yaptık.",shape=box,color=blue];
		j2219061396 -> j707094970;
	j707094970 [label="Şişkin annelerini yiyip bitiren çocuk sürüsü gibi üzerimize çullandılar.",shape=box,color=blue];
		j707094970 -> j880170259;
	j880170259 [label="Zamanın sayfaları arasında kurumuş, ezilmiş, evrimleşmemiş bir haldeydik.",shape=box,color=blue];
		j880170259 -> j921430358;
	j921430358 [label="Add 1 to HellStory counter",color=orange];
		j921430358 -> "Chat ends.";
