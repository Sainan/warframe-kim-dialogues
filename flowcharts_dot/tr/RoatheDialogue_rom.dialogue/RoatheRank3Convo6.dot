	2061 [label="Kuş 3 herkesi sever.",shape=box,color=red];
		2061 -> 2066;
	2062 [label="Seni akıllı hissettiren insanlarla çevrili olmayı seviyorsun.",shape=box,color=red];
		2062 -> 2067;
	2063 [label="Çevresindeki insanları çok iyi gözlemler.",shape=box,color=red];
		2063 -> 2068;
	2064 [label="Manipüle edilmesi kolaydır.",shape=box,color=red];
		2064 -> 2069;
	2065 [label="Evet. Bir bakıma tam olarak öyle. Kim olduğumu bilmiyor. \"Tau Şeytanı\" hakkında hiçbir şey bilmiyor. Ve... dahası, umursamıyor da.",shape=box,color=blue];
		2065 -> 2070;
	2066 [label="Öyle. Aptalca masumiyetiyle oldukça çekici. Ama biraz daha nazik ve dolaylı bir şekilde söylediğin şey, başka hiç kimsenin beni sevemeyeceği, öyle mi?",shape=box,color=blue];
		2066 -> 2071;
	2067 [label="Keşke ne kadar yanıldığını anlasaydın. Okunun hedeften ne kadar uzaklara uçtuğunu... ama benim hakkımdaki fikrinde yalnız değilsin.",shape=box,color=blue];
		2067 -> 2072;
	2068 [label="Evet öyle. Ve gözlemleri oldukça faydalı, ama bunların hiçbirine kendi başıma birkaç dakika içinde ulaşamazdım.",shape=box,color=blue];
		2068 -> 2073;
	2069 [label="Keşke ne kadar yanıldığını anlasaydın. Okunun hedeften ne kadar uzaklara uçtuğunu... ama benim hakkımdaki fikrinde yalnız değilsin.",shape=box,color=blue];
		2069 -> 2074;
	2070 [label="+10 Chemistry",color=orange];
		2070 -> 2075;
	2071 [label="Yani aptal bir kuşa mı güvenmeliyim? Ama gerçeğe yeterince yakınsın, sanırım sana... geçer not vereceğim.",shape=box,color=blue];
		2071 -> 2075;
	2072 [label="Hem de hiç.",shape=box,color=blue];
		2072 -> 2076;
	2073 [label="Biraz daha nazik ve dolaylı bir şekilde, benim büyük konuşan kuşu kendi amaçlarım için kullandığımı düşündüğünü mü söylüyorsun? Öyle mi?",shape=box,color=blue];
		2073 -> 2077;
	2074 [label="Hem de hiç.",shape=box,color=blue];
		2074 -> 2078;
	2075 [label="Ona göre ben Roathe değilim. Orokin değilim. Suçlu da değilim. Hain de değilim. Korkak da değilim. Sadece... kendim olabilirim.",shape=box,color=blue];
		2075 -> 2079;
