		2051 -> 2054;
	2055 [label="Hımm? Evet, onları Void'in lanetlediği Origin Sistemi'nde şimdiye kadar karşılaştığım açıkcası en üzüntülü ve acınası yaratıklardan bazıları olarak görüyorum. ",shape=box,color=blue];
		2055 -> 2057;
	2053 [label="Bu durumda olası yanlış anlaşılmaları önlemek için, her zamanki laf kalabalığımı bir kenara bırakıp şunu söyleyeceğim: ",shape=box,color=blue];
		2053 -> 2056;
	2054 [label="Chat ends.",color=orange];
	2057 [label="Laboratuvar hayvanları. Laboratuvar hayvanları, Albrecht! Hayvanları lanet olası Void'e attın ve sonra senin uydurduğun çocuk dilinde gevezelik ederek çıktıklarında, uşağına onları uyutmasını mı söyledin?!",shape=box,color=blue];
		2057 -> 2059;
	2056 [label="Hayır.",shape=box,color=blue];
		2056 -> 2058;
	2059 [label="O her zaman pis işleri başkalarına yaptırır. Ama konudan sapıyorum. Neden onlarla konuştuğumu soruyorsun. Özellikle de kuşla. Sebebi basit. Ama senin tahmin etmeni isterim. Cevabı bulabilecek misin, görmek istiyorum.",shape=box,color=blue];
		2059 -> 2060;
		2059 -> 2061;
		2059 -> 2062;
		2059 -> 2063;
