	2088 [label="Add -1 to Thermostat",color=orange];
		2088 -> 2091;
	2089 [label="Keşke bu kadar basit olsaydı ve tüm bunlar, bir maskeli balo sonrası maskemi çıkardığım gibi bitseydi! Hayır, Gaspçı. Ben böyleyim, çürümüş kemiklerime kadar.",shape=box,color=blue];
		2089 -> 2092;
	2090 [label="Keşke bu kadar basit olsaydı, Gaspçı. Her şeyi çok cazip kılıyorsun. Yapabilir miyim? Belki... Belki de benim gibi hüzünlü, trajik bir şeytan için bile çok geç değildir.",shape=box,color=blue];
		2090 -> 2093;
	2091 [label="+10 Chemistry",color=orange];
		2091 -> 2094;
	2092 [label="Ama bu, her şeyimi bir kenara bırakıp, zamanında işlediğim tüm korkunç suçlardan haberi olmayan biriyle sohbet etmenin keyfini çıkarma fırsatını sevmediğim anlamına gelmiyor.",shape=box,color=blue];
		2092 -> 2095;
	2093 [label="+10 Chemistry",color=orange];
		2093 -> 2096;
	2094 [label="Çok yorucu, Gaspçı. Keşke o kişiliği bir maskeli balo maskesi gibi bırakıp bir daha asla elime almasam. Ama ben buyum, her çürümüş kemiklerime kadar.",shape=box,color=blue];
