		2097 -> 2100;
	2098 [label="Çok fazla arkadaşa sahip olmaya alışkın değilsin sanırım, değil mi?",shape=box,color=red];
		2098 -> 2101;
	2099 [label="Yükü bir kenara bırakıp, korkunç suçlarımdan habersiz birinin yanına oturuyorum ve devasa, sevimli, ahmak kuşla konuşuyorum ve kendimi... huzur içinde buluyorum. Uzun zamandır ilk kez.",shape=box,color=blue];
