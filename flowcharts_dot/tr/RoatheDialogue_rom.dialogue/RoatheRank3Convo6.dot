		2124 -> 2125;
	2123 [label="Ama kimi kandırıyorum?! Bunu neden yaptığını biliyoruz, değil mi? Ve bu bana olan aşkından değildi. Başkasına olan aşkındandı. Sadece şiirsel bir dille anlatıyorum.",shape=box,color=blue];
