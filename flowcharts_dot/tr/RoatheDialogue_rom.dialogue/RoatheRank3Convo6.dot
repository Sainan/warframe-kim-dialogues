		2095 -> 2097;
		2095 -> 2098;
	2096 [label="Bu, taktığım büyük bir maskeden başka bir şey değil mi? Yoksa çürümüş kemiklerimin derinliklerine mi işlemiş? Henüz bilmiyorum. Tek söyleyebileceğim, fırsat buldukça her şeyi bir saatliğine ortaya dökme fırsatını hâlâ sevdiğim.",shape=box,color=blue];
		2096 -> 2099;
