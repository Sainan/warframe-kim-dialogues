		2102 -> 2109;
	2106 [label="Evet, öyleydi. Ya da en azından hatırlayabildiğim kadarıyla. Yoksa benden aldığın bu muydu, Gaspçı? Sevgili olduğumuz, sana aşkımı itiraf ettiğim ve senin aynı şeyi hissetmediğin?",shape=box,color=blue];
		2106 -> 2113;
	2105 [label="Öyle olduğunu kabul ediyorum. En azından hatırladığım kadarıyla. Hiç aşık olmadığımı bilmek seni şaşırtır mı? En azından karşılıklı olarak. Belki de şaşırtmaz. Sonuçta, muhtemelen tüm bunları daha önce yaşadık.",shape=box,color=blue];
		2105 -> 2112;
	2104 [label="Öyleydi. Uzun ve yalnız. Ama hepsi benim seçimimdi, Gaspçı Buraya senin sempatini ya da acımanı kazanmak için gelmedim.",shape=box,color=blue];
		2104 -> 2111;
	2103 [label="Öyle olduğunu kabul ediyorum. En azından hatırladığım kadarıyla. Hiç aşık olmadığımı bilmek seni şaşırtır mı? Ama bu tamamen benim seçimim, Gaspçı. Buraya senin sempatini veya acımanı kazanmak için gelmedim.",shape=box,color=blue];
		2103 -> 2110;
	2108 [label="Kim bilir? Belki de arkadaşlarım vardı da onları hatırlayamıyorum çünkü sen ve ben, sen buna son vermeden önce arkadaştık, değil mi?",shape=box,color=blue];
		2108 -> 2114;
	2107 [label="Kim bilir? Belki de arkadaşlarım vardı da onları hatırlayamıyorum çünkü Entrati kafamda karışıklık yaratıp onlara dair anılarımı elimden aldı.",shape=box,color=blue];
