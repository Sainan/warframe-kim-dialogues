		1036 -> 1038;
	1037 [label="Tıraş. Bu yumrulu parçalar sürekli olarak çıkıp duruyor. Sanırım eskiden tat tomurcuklarıydı. Eğer onları kesmezsem, gerçekten uzuyor ve kıvrılıyorlar. Deniz lalesi gibi.",shape=box,color=blue];
