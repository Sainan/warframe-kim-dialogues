	1112 [label="Beni çıkarmak için arabayı kesmek zorunda kaldılar. Çığlıklarımı durduramadım. Bu öyle bir acıydı ki sizi kaçacak bir yer bırakmıyordu. Var olduğun için cezalandırılıyorsun.",shape=box,color=blue];
