	2042 [label="Chat ends.",color=orange];
	2045 [label="Hey Eleanor? Amir'in hazırladığı şu masa oyununu hatırlıyor musun? Masallar ve Mesafeler?",shape=box,color=red];
		2045 -> 2044;
	2046 [label="Hey Eleanor? Sen ve Amir arkadaşsınız, değil mi?",shape=box,color=red];
		2046 -> 2048;
	2047 [label="Masa oyunlarını seviyorsun, değil mi?",shape=box,color=red];
		2047 -> 2049;
	2044 [label="Evet. Zaman kaybı olduğunu ve sadece acıdığın için onunla oynadığını söylediğin kişi, değil mi?",shape=box,color=blue];
		2044 -> 2050;
		2044 -> 2052;
		2044 -> 2053;
	2048 [label="O sevimli küçük bir şeytan. Neden sordun?",shape=box,color=blue];
		2048 -> 2055;
		2048 -> 2056;
	2049 [label="Sanırım herkes kadar. Neden sordun?",shape=box,color=blue];
		2049 -> 2055;
		2049 -> 2056;
	2050 [label="Vay canına. Tamam. Hala kızgınsın. Notumu aldım.",shape=box,color=red];
		2050 -> 2051;
	2052 [label="O zaman senin “bunun için fazla havalı” olduğunu düşünüyordum ve ben de öyleymişim gibi davranmaya çalışıyordum. Şimdi bunu daha iyi biliyorum.",shape=box,color=red];
		2052 -> 2054;
	2053 [label="Evet ben... ben sadece bunun için özür dilemek istedim, ben... söylediklerimi kastetmedim. Sadece hayır diyeceğinden korkmuştum.",shape=box,color=red];
		2053 -> 2062;
	2055 [label="Amir, Masallar & Mesafeler adlı oyunu oynamak için takımı bir araya getirmeye çalışıyor ve ben de ona yardım edeceğimi söyledim.",shape=box,color=red];
		2055 -> 2057;
	2056 [label="Amir herkesle Masallar & Mesafeler oynamak istiyor. Sen de katılır mısın?",shape=box,color=red];
		2056 -> 2057;
	2051 [label="Chat ends.",color=orange];
	2054 [label="Cidden hangimiz artık oyun için \"fazla havalı\" değiliz ki? Sen mi ben mi?",shape=box,color=blue];
		2054 -> 2058;
		2054 -> 2059;
		2054 -> 2060;
	2062 [label="Hepimiz hayatımızın bir döneminde bunu yaşamışızdır. Birini etkilemek için maske takmaya çalışmak ve nereye gittiğimizi göremediğimiz için yüzüstü düşmek. Ve sen bunu sorduğunda ikimiz daha yeni tanışmıştık. Neyse. Affedildin.",shape=box,color=blue];
		2062 -> 2067;
	2057 [label="Ah. Anladım. Sen Yıldırım Kralının, güzel Eleanor'u yanına almak için gönderdiği seçilmiş habercisin. Şüphesiz ki beni bir tür bela bekliyor. Saçmalıklar ve ötesi.",shape=box,color=blue];
		2057 -> 2063;
		2057 -> 2064;
	2058 [label="Sen. Ben hala bunun aptalca bir oyun olduğunu düşünüyorum ama neyse.",shape=box,color=red];
		2058 -> 2061;
	2059 [label="Ben. Kesinlikle ben. Oyun için hala fazla havalısın. Ama ben tam bir budalayım, ya da Quincy'ye göre öyle.",shape=box,color=red];
		2059 -> 2062;
	2060 [label="...İkimiz de?",shape=box,color=red];
		2060 -> 2062;
	2067 [label="Dürüst olmak gerekirse, aptalca bir ses tonu takınıp birkaç saat oyunculuk yapmak kulağa hoş geliyor. Ben varım.",shape=box,color=blue];
		2067 -> 2068;
	2063 [label="Açıkçası eğlenceli olacağını düşünüyorum. Ve onun için çok şey ifade ediyor gibi görünüyor.",shape=box,color=red];
		2063 -> 2067;
	2064 [label="Evet, bunun tamamen zaman kaybı olacağını düşünüyorum ama nazik olmaya çalışıyorum.",shape=box,color=red];
		2064 -> 2065;
	2061 [label="Chat ends.",color=orange];
	2068 [label="Ah! Bir büyücü olmak isterdim. Ya da belki bir ozan. Ya da belki ikisi birden? İkisi de olmak mümkün mü?",shape=box,color=blue];
		2068 -> 2069;
	2065 [label="Sana bir iyilik yapacağım ve bu sözlerini ona iletmeyeceğim. Bilge olanın söylediği gibi: Bir dahaki sefere benim huzurumda ona daha fazla saygı göster.",shape=box,color=blue];
		2065 -> 2066;
	2069 [label="Ya da bataklık cadısı olabilirim! Yeter ki dar bir korse giyeyim, aklında bulunsun. Annemiz Mossytits senin kemiklerini yiyecek, küçük kukla.",shape=box,color=blue];
		2069 -> 2077;
