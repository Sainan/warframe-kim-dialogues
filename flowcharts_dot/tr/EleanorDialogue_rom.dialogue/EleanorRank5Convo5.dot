	2520 [label="Seni almasına izin vermeyeceğim. *Hepsini kül edeceğim*.",shape=box,color=red];
		2520 -> 2524;
	2521 [label="Seni asla buna teslim etmeyeceğim, Eleanor. Sen benim arkadaşımsın.",shape=box,color=red];
		2521 -> 2525;
	2522 [label="Sen benim için aile gibisin. Seni ele geçirmesine izin vermeyeceğim.",shape=box,color=red];
