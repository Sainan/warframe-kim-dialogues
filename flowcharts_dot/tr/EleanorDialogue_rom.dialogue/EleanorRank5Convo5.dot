		2474 -> 2477;
	2480 [label="Kolay kolay rahatsız olduğunu sanmıyorum.",shape=box,color=red];
		2480 -> 2483;
	2481 [label="Sonsuz bir merdivenden aşağı mı düşüyordun?",shape=box,color=red];
		2481 -> 2484;
	2482 [label="Önemli olabilir. Senin yeteneğinle bir rüya sadece bir rüya olmayabilir.",shape=box,color=red];
		2482 -> 2485;
	2475 [label="Bu tuhaf olmazdı.",shape=box,color=blue];
		2475 -> 2478;
	2476 [label="Tanrım, keşke. Korkarım ki böyle hoş bir şey değil.",shape=box,color=blue];
