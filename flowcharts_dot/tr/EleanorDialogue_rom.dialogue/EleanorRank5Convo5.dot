		2469 -> 2471 [label=false,color=brown];
	2470 [label="Ama birlikte olduğumuzdan beri, başka bir şey oldu. Aslında biraz tuhaf. Uzun zamandır seninle bu konu hakkında konuşmak istiyordum ama bir türlü uygun zamanı bulamıyordum.",shape=box,color=blue];
		2470 -> 2472;
		2470 -> 2473;
		2470 -> 2474;
	2471 [label="Ama bu BAŞKA rüyalar görmediğim anlamına gelmiyor. Daha çok, rahatsız edici olanlar.",shape=box,color=blue];
		2471 -> 2480;
		2471 -> 2481;
