	2496 [label="Akıl almaz bir şekilde beni kendi malı olarak görüyor. Onun damızlık adayı olmam gerekiyordu. Legasit'ler beni düşman kraliçe olarak görüyor, biliyorsun.",shape=box,color=blue];
