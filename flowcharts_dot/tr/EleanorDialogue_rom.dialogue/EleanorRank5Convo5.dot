	2525 [label="Biliyorum. Sanırım o da biliyor, bu yüzden bu kadar öfkeli. Rekabet edemiyor.",shape=box,color=blue];
		2525 -> 2528;
	2526 [label="Arkamı kolladığını bildiğim için artık daha rahat uyuyacağım.",shape=box,color=blue];
		2526 -> 2529;
	2530 [label="Endişelenme tatlım. Seni, içinde yetim teknoloji parçaları yüzen iltihaplı bir et yığını için terk etmeyeceğim.",shape=box,color=blue];
