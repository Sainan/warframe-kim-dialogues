	2498 [label="Warframe'ler böyle işlemiyor. İçlerindeki Infested ehlileştirilmiş ve uykudadır. Nidus hariç, sanırım, ama o ayrı bir vaka.",shape=box,color=red];
		2498 -> 2503;
	2499 [label="Yani Techrot seni ondan çaldığımı mı düşünüyor ve şimdi seni geri mi istiyor?",shape=box,color=red];
		2499 -> 2504;
	2500 [label="Warframe'ler böyle işlemiyor. İçlerindeki Infested ehlileştirilmiş ve uykudadır. Nidus hariç, sanırım, ama o ayrı bir vaka.",shape=box,color=red];
		2500 -> 2502;
	2501 [label="Yani Techrot benim seni ona geri dönmekten alıkoyduğumu mu düşünüyor?",shape=box,color=red];
		2501 -> 2505;
	2503 [label="Eğer tam bir Warframe olsaydım, Techrot beni bu şekilde görmeyebilirdi. Hücrelerim hala fokurduyor ve o beni kendinden bir parça olarak görüyor.",shape=box,color=blue];
		2503 -> 2506;
	2504 [label="Garip değil mi? Terk edilmiş eski sevgili!",shape=box,color=blue];
		2504 -> 2506;
	2502 [label="Eğer tam bir Warframe olsaydım, Techrot beni bu şekilde görmeyebilirdi. Hücrelerim hala fokurduyor ve o beni kendinden bir parça olarak görüyor.",shape=box,color=blue];
		2502 -> 2507;
	2505 [label="Evet. Beni tekrar çetesine katmak istiyor.",shape=box,color=blue];
		2505 -> 2507;
	2506 [label="Benim geldiğim yerde, böyle durumlarda yerel bir süpermarketin arkasında kavga edilirdi. Senin zamanında işler nasıl yürüyor bilmiyorum.",shape=box,color=blue];
		2506 -> 2508;
	2507 [label="Bu senin GERÇEK ailen, diye fısıldıyor. Tekrar bizim parçamız ol, koparılmış kız kardeşim. Bize katıl.",shape=box,color=blue];
		2507 -> 2508;
	2508 [label="Bekle bir dakika. Techrot'un böyle hissettiğini nereden biliyorsun?",shape=box,color=red];
		2508 -> 2509;
	2509 [label="Aman Tanrım, işte bu çok garip bir durum.",shape=box,color=blue];
		2509 -> 2510;
	2510 [label="Daha önce bahsettiğim rüyalar vardı ya? Techrot'un onları gönderdiğinden eminim.",shape=box,color=blue];
		2510 -> 2511;
	2511 [label="O şey her ne ise zihnime işliyor, ve her zaman benimkiyle bağlantı kurmayı başarıyor. Gönderdiği düşünceler her zaman o kadar kaba ve zayıf ki, onları kolayca savuşturabiliyorum.",shape=box,color=blue];
		2511 -> 2512;
	2512 [label="Çoğu zaman kafatasımın arkasında çılgınca bir kaşınma hissediyorum, tıpkı banyodayken bir kedinin kapıyı tırmalaması gibi.",shape=box,color=blue];
		2512 -> 2513;
		2512 -> 2514;
	2513 [label="Ama uyurken durum farklı, değil mi?",shape=box,color=red];
		2513 -> 2515;
	2514 [label="Sanırım bunun nereye gittiğini anladım.",shape=box,color=red];
		2514 -> 2515;
	2515 [label="Doğru. Savunma mekanizmam kapalı ve bana ulaşabilir durumda.",shape=box,color=blue];
		2515 -> 2516;
	2516 [label="Bana en ilkel seviyeden vuruyor, ne demek istediğimi anladıysan. Beni geri istiyor. Bana daha önce hiç tatmadığım bir coşku yaşatacağına söz veriyor.",shape=box,color=blue];
		2516 -> 2517;
	2517 [label="Bedenime yeni yaşamın iltihaplı kistlerini ekecek, çünkü istediğimin bu olduğunu düşünüyor, anlıyor musun.",shape=box,color=blue];
		2517 -> 2518;
