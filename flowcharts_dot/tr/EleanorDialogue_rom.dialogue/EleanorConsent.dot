	3318 [label="Chat ends.",color=orange];
	3319 [label="Sanırım bu konuda tek can sıkıcı şey, henüz aklındakileri paylaşamadan olup biteni zihninde görmem oldu.",shape=box,color=blue];
		3319 -> 3320;
	3317 [label="Chat ends.",color=orange];
	3320 [label="Kibarca izin istemeye gelmeyeceğini bilmediğimden değil. Merhaba.",shape=box,color=blue];
		3320 -> 3321;
	3321 [label="Cevabım, çok somurtkan ve kollarımı kavuşturmuş bir şekilde 'evet elbette'dir. Aynı zamanda burada oturmuş, aklından geçen fantezilerinde gördüğüm o güzel şeyleri düşünmemeye çalışıyorum.",shape=box,color=blue];
		3321 -> 3322;
	3322 [label="Bunlar artık BENİM fantezilerim, çünkü ben bu zamanda ve mekanda sıkışıp kaldım, bunun içi sana çok teşekkür ederim!",shape=box,color=blue];
		3322 -> 3323;
	3323 [label="Özür dilerim. Gerçekten iznini almaya gelmiştim. Bunun daha önce konuştuğumuz bir konu olmadığını biliyorum. Senin için bir sakıncası olup olmayacağından emin olmak istedim.",shape=box,color=red];
		3323 -> 3324;
	3324 [label="Elbette sorun olmaz! Onu zihnin sayesinde gözümün önünde canlandırabiliyorum. Ve eğer sen ona güveniyorsan, ben de güvenirim.",shape=box,color=blue];
		3324 -> 3325;
	3325 [label="Sadece eğlenceye katılamayacağım için üzülüyorum o kadar.",shape=box,color=blue];
		3325 -> 3326;
	3326 [label="+20 Chemistry",color=orange];
		3326 -> 3327;
	3327 [label="Ama belki senin aracılığınla dolaylı olarak bunu başarabilirim, işte bu güzel bir fikir.",shape=box,color=blue];
		3327 -> 3328;
	3328 [label="Update boolean EleanorConsentComplete",color=orange];
		3328 -> 3329;
