	j3528729371 [label="Check boolean EleanorPolyamorySuccess",color=orange];
		j3528729371 -> j3364311394 [label=true,color=green];
		j3528729371 -> "Chat ends." [label=false,color=brown];
	j3883679609 [label="Sanırım bu konuda tek can sıkıcı şey, henüz aklındakileri paylaşamadan olup biteni zihninde görmem oldu.",shape=box,color=blue];
		j3883679609 -> j3230143255;
	j3230143255 [label="Kibarca izin istemeye gelmeyeceğini bilmediğimden değil. Merhaba.",shape=box,color=blue];
		j3230143255 -> j2747826841;
	j2747826841 [label="Cevabım, çok somurtkan ve kollarımı kavuşturmuş bir şekilde 'evet elbette'dir. Aynı zamanda burada oturmuş, aklından geçen fantezilerinde gördüğüm o güzel şeyleri düşünmemeye çalışıyorum.",shape=box,color=blue];
		j2747826841 -> j258973853;
	j258973853 [label="Bunlar artık BENİM fantezilerim, çünkü ben bu zamanda ve mekanda sıkışıp kaldım, bunun içi sana çok teşekkür ederim!",shape=box,color=blue];
		j258973853 -> j348351099;
	j348351099 [label="Özür dilerim. Gerçekten iznini almaya gelmiştim. Bunun daha önce konuştuğumuz bir konu olmadığını biliyorum. Senin için bir sakıncası olup olmayacağından emin olmak istedim.",shape=box,color=red];
		j348351099 -> j2822604366;
	j2822604366 [label="Elbette sorun olmaz! Onu zihnin sayesinde gözümün önünde canlandırabiliyorum. Ve eğer sen ona güveniyorsan, ben de güvenirim.",shape=box,color=blue];
		j2822604366 -> j630612070;
	j630612070 [label="Sadece eğlenceye katılamayacağım için üzülüyorum o kadar.",shape=box,color=blue];
		j630612070 -> j1143986619;
	j1143986619 [label="+20 Chemistry",color=orange];
		j1143986619 -> j2825637570;
	j2825637570 [label="Ama belki senin aracılığınla dolaylı olarak bunu başarabilirim, işte bu güzel bir fikir.",shape=box,color=blue];
		j2825637570 -> j298331240;
	j298331240 [label="Boolean EleanorConsentComplete is now true.",color=orange];
		j298331240 -> "Chat ends.";
}