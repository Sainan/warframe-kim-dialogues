		2665 -> 2667 [label=true,color=green];
		2665 -> 2666 [label=false,color=brown];
	2664 [label="Chat ends.",color=orange];
	2667 [label="Christopher hakkında.",shape=box,color=blue];
		2667 -> 2675;
	2666 [label="Check boolean EleanorChristopher1",color=orange];
		2666 -> 2671 [label=true,color=green];
		2666 -> 2668 [label=false,color=brown];
	2675 [label="Yıllardır ona tutunuyordum. Tıpkı Arthur'un yaptığı gibi. Her yıl onun anısına bir ritüel düzenleriz. Ama bu yıl yapmadık. Buna dayanamadım.",shape=box,color=blue];
		2675 -> 2676;
	2671 [label="Uzun ve trajik bir hikayeyi özetlemek gerekirse... Christopher biz evlenmeden önce yol kenarına yerleştirilen bir bombanın patlaması sonucu öldü.",shape=box,color=blue];
		2671 -> 2672;
	2668 [label="Christopher'dan bahsetmemin zamanı geldi.",shape=box,color=blue];
		2668 -> 2669;
	2676 [label="Hayaletlerin var olup olmadığını bilmiyorum ama olabilirler, çünkü onun hayalet olmasına izin verdim.",shape=box,color=blue];
		2676 -> 2677;
	2672 [label="Belki sana bütün hikayeyi başka bir gün anlatırım. Belki de anlatmam.",shape=box,color=blue];
		2672 -> 2673;
	2669 [label="Arthur'un en iyi arkadaşı. Nişanlıydık. Ona aşık olduğumu sanıyordum.",shape=box,color=blue];
		2669 -> 2670;
	2677 [label="Kendine bu kadar yüklenme. O adama aşıktın.",shape=box,color=red];
		2677 -> 2678;
	2673 [label="Bunları sana şimdi anlatıyorum çünkü...",shape=box,color=blue];
		2673 -> 2674;
	2670 [label="Update boolean EleanorChristopher1",color=orange];
		2670 -> 2671;
	2678 [label="Ah dostum. Ben de öyle DÜŞÜNÜYORDUM. Onu seviyordum ama ona aşık OLUP olmadığımı bile bilmiyordum.",shape=box,color=blue];
		2678 -> 2679;
	2674 [label="Update boolean EleanorChristopher2",color=orange];
		2674 -> 2675;
	2679 [label="Bu kulağa korkunç geliyor, değil mi? Ama doğru. O zamanlar, önemli görünmüyordu. Sonra öldü ve hikayemizin konusu bu oldu.",shape=box,color=blue];
		2679 -> 2680;
	2680 [label="Onun hakkında hayran olduğum her şey onun ölümünün gölgesinde kaldı. Midemde bir düğüm oluşmadan onu düşünemiyorum.",shape=box,color=blue];
		2680 -> 2681;
	2681 [label="Bu ONUN İÇİN adil değil. Bundan daha iyisini hak ediyordu.",shape=box,color=blue];
		2681 -> 2682;
		2681 -> 2683;
	2682 [label="Anlıyorum. Kesinlikle. Ben, ailemi hak ettikleri şekilde hatırlamayı seçmiştim.",shape=box,color=red];
		2682 -> 2684;
	2683 [label="Olanlar korkunçtu. Bunun etrafından dolanmanın bir yolu yok. Ama bunun tutunduğumuz tek şey olmasına da izin veremeyiz.",shape=box,color=red];
		2683 -> 2684;
	2684 [label="Peki neden kendimi bu kadar suçlu hissediyorum?",shape=box,color=blue];
		2684 -> 2685;
	2685 [label="Neden ona veda etmenin onu çöpe atmakla aynı şey olduğunu hissediyorum?",shape=box,color=blue];
		2685 -> 2686;
		2685 -> 2688;
	2686 [label="Çünkü onu o kadar uzun süre taşıdın ki, artık ona nasıl veda edeceğini bilmiyorsun.",shape=box,color=red];
		2686 -> 2687;
	2688 [label="Çünkü başka hiç kimsenin seni sevemeyeceğinden endişeleniyorsun.",shape=box,color=red];
		2688 -> 2689;
	2687 [label="Tanrım. Kesinlikle haklısın, evet.",shape=box,color=blue];
		2687 -> 2692;
	2689 [label="Check boolean EleanorDating",color=orange];
		2689 -> 2690 [label=true,color=green];
		2689 -> 2691 [label=false,color=brown];
	2692 [label="Bununla başa çıkmakta beceriksiziz, en azında ben. Her şeyi içimize atıyoruz. Cesur bir yüz takınıp siperlerde ıslık çalıyoruz. Kendimizi idare ediyoruz, tıpkı ebeveynlerimizin yaptığı gibi. Ama nasıl duracağımızı bilmiyoruz.",shape=box,color=blue];
		2692 -> 2693;
	2690 [label="Bu mu? Yani ben bu kadar sığ mıyım?",shape=box,color=blue];
		2690 -> 2694;
	2691 [label="Şu anki durumumla Christopher'ın bile beni seveceğinden şüpheliyim.",shape=box,color=blue];
		2691 -> 2696;
	2693 [label="Ne yapmalıyım? Onu nasıl bırakabilirim?",shape=box,color=blue];
		2693 -> 2698;
	2694 [label="Şu anda İKİNİZİ de hak ettiğimi düşünmüyorum",shape=box,color=blue];
		2694 -> 2695;
	2696 [label="... hayır. Bu adil değil. Ona karşı hiç adil davranmıyorum, değil mi?",shape=box,color=blue];
		2696 -> 2697;
	2698 [label="Check boolean LettieDiasdeMuertos",color=orange];
		2698 -> 2699 [label=true,color=green];
		2698 -> 2700 [label=true,color=green];
		2698 -> 2701 [label=true,color=green];
		2698 -> 2700 [label=false,color=brown];
		2698 -> 2701 [label=false,color=brown];
	2695 [label="Sanırım... TÜMÜYLE senin olmak istiyorum. Sonsuz bir yas halinde kendimin bir parçasını ardımda tutamıyorum.",shape=box,color=blue];
		2695 -> 2698;
	2697 [label="Mutluluğumun önünde durmak istemezdi. O nazikti.",shape=box,color=blue];
		2697 -> 2698;
	2699 [label="Açıkçası Lettie'nin yardımcı olabileceğini düşünüyorum.",shape=box,color=red];
		2699 -> 2702;
	2700 [label="Ona bir mektup yazabilirsin.",shape=box,color=red];
		2700 -> 2703;
	2701 [label="Belki de Arthur'la konuşmalısın. Bu acıyı başından beri seninle yaşadı.",shape=box,color=red];
		2701 -> 2704;
	2702 [label="Lettie mi?",shape=box,color=blue];
		2702 -> 2705;
	2703 [label="Bir parçam bunun aptalca bir fikir olduğunu düşünüyor. Bunu okumayacak. O öldü. Ama...",shape=box,color=blue];
		2703 -> 2706;
	2704 [label="Evet yaşadı. Belki sorunun bir parçası da budur. Bu yıl küçük anma törenimizi yapmadığım için üzgün olduğunu biliyorum.",shape=box,color=blue];
		2704 -> 2707;
	2705 [label="Neden o?",shape=box,color=blue];
		2705 -> 2708;
	2706 [label="... bunu ne kadar çok düşünürsem, o kadar az aptalca geliyor.",shape=box,color=blue];
		2706 -> 2710;
	2707 [label="Benim sadece... bu sefer Christopher'a KENDİ yöntemimle veda etmem gerekiyor. Bir kez ve son kez.",shape=box,color=blue];
		2707 -> 2711;
	2708 [label="Bu alanda çok fazla deneyimi var. Ölüleri anmakla ilgili her şeyi biliyor.",shape=box,color=red];
		2708 -> 2709;
	2710 [label="Evet. Bunu yapacağım. Ona söylemem gereken şeyler var. Hayattayken asla söylemediğim şeyler. Belki o zaman ruhu şad olabilir.",shape=box,color=blue];
		2710 -> 2712;
	2711 [label="Arthur için o her zaman kayıp bir kardeş, düşmüş bir asker olarak kalacak. Onun bildiği ve anladığı acı budur. Ama benimki böyle değil.",shape=box,color=blue];
		2711 -> 2713;
	2709 [label="Eğer ona saygılı bir şekilde tavsiyesini sorarsan, seni geri çevirmeyeceğine eminim.",shape=box,color=red];
		2709 -> 2720;
	2712 [label="Dinlediğin ve tavsiyelerin için teşekkür ederim.",shape=box,color=blue];
		2712 -> 2714;
	2713 [label="Artık bunu Arthur'un yöntemiyle yapamam. Sanırım... eğer ona söylersem anlayacaktır.",shape=box,color=blue];
		2713 -> 2718;
	2720 [label="…",shape=box,color=blue];
