digraph {
	2659 [label="EleanorRank5Convo8 begins.",color=orange];
		2659 -> 2660;
	2660 [label="Düşünüyordum da. Yapmam gereken bir şey var.",shape=box,color=blue];
		2660 -> 2661;
	2661 [label="Bunun için yardıma ihtiyacım olacak.",shape=box,color=blue];
		2661 -> 2662;
		2661 -> 2663;
	2662 [label="Her zaman senin için buradayım. Aklında ne var?",shape=box,color=red];
		2662 -> 2665;
