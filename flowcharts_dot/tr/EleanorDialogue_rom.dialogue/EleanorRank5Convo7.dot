digraph {
	2607 [label="EleanorRank5Convo7 begins.",color=orange];
		2607 -> 2608;
	2608 [label="'Kayıtsızlık' OLDUĞU şey mi, yoksa İSTEDİĞİ şey mi?",shape=box,color=blue];
		2608 -> 2609;
		2608 -> 2610;
		2608 -> 2611;
	2609 [label="Sen ve Lettie ikiniz de aynı şeyi yapıyorsunuz. Sizde \"merhaba\" demek yok.",shape=box,color=red];
		2609 -> 2613;
	2610 [label="Çoğu insan \"merhaba\" ile başlar.",shape=box,color=red];
		2610 -> 2614;
	2611 [label="[Görmezden gel.]",shape=box,color=red];
		2611 -> 2612;
	2613 [label="Paylaştığımız tek şeyi buldun, tebrikler. Ve üzgünüm. Bu daha önemli.",shape=box,color=blue];
		2613 -> 2615;
	2614 [label="Üzgünüm. Bu daha önemli.",shape=box,color=blue];
		2614 -> 2615;
	2612 [label="Chat ends.",color=orange];
	2615 [label="Sanırım 'Büyük Kayıtsızlık' bir şekilde aramıza girmeye çalışacak.",shape=box,color=blue];
		2615 -> 2616;
	2616 [label="Gülme. Bunu iliğimin derinliklerinde hissedebiliyorum. Rusalka'daki şey birbirimizi parçaladığımızı görmek istiyor.",shape=box,color=blue];
		2616 -> 2617;
	2617 [label="Nedenini bilmiyorum. Sadece biliyorum.",shape=box,color=blue];
		2617 -> 2618;
		2617 -> 2619;
	2618 [label="Evet. Sanırım haklısın.",shape=box,color=red];
		2618 -> 2620;
	2619 [label="Belki de Entrati'nin ailesinin başına gelen de buydu. Yıllardır laboratuvarının tam tepesinde yaşıyorlardı, bilmeden. Çocuk onları bulduğunda, birbirlerinden uzaklaşmışlardı, inatla debeleniyorlardı.",shape=box,color=red];
		2619 -> 2620;
	2620 [label="Bunu senin zihninde gördüm. Albrecht ve Loid. Anne ve Baba. Sen ve ailen. Bildiğimiz kadarıyla Rusalka ve Viktor. Ve tabii ki altımız.",shape=box,color=blue];
		2620 -> 2621;
	2621 [label="Bu şeyin yaptığı şey çok soğuk. Sapkın. Ama bunun arkasında bir yerlerde bir motivasyon var.",shape=box,color=blue];
		2621 -> 2622;
		2621 -> 2623;
	2622 [label="Sanırım haklısın. Zariman'da aklını ilk kaybeden ebeveynler oldu. Belki de Holdfast'lerin bu kadar uzun süre dayanabilmeleri çocuklarının olmamasından kaynaklanıyordu.",shape=box,color=red];
		2622 -> 2627;
	2623 [label="Temelde *tanrı* olan yaratıkları anlıyormuş gibi davranmayı sevmiyorum. Bu şey duyguları anlamaya çalışıyor. Ama oyuncaklarıyla çok fena oynuyor.",shape=box,color=red];
		2623 -> 2624;
	2627 [label="Bırak da aramıza girmeye çalışsın. Bana yardım et Sol, bunu bitireceğim. Bir yolunu bulacağım.",shape=box,color=blue];
		2627 -> 2628;
	2624 [label="Takdire şayan bir teori ama bunu BİLMİYORUZ, değil mi?",shape=box,color=blue];
		2624 -> 2625;
	2628 [label="Evrende hiçbir şeyin karşı koyamayacağı güçler vardır. Buna her vücudumdaki her zerremle inanıyorum.",shape=box,color=blue];
		2628 -> 2629;
	2625 [label="Eğer haklıysan bu kimsenin suçu olmaz. Neredeyse çocukça. Bu bildiklerimizle uyuşmuyor. Bu tamamen art niyetli.",shape=box,color=blue];
		2625 -> 2626;
	2629 [label="Eğer beni bütünüyle yutarsa boğazına takılıp onu boğacağım.",shape=box,color=blue];
		2629 -> 2630;
		2629 -> 2631;
	2626 [label="Chat ends.",color=orange];
	2630 [label="Ölmek için şahane bir yöntem.",shape=box,color=red];
		2630 -> 2632;
	2631 [label="Bunu nasıl yapacağımı henüz bilmiyorum ama seninleyim. Kazanmalıyız.",shape=box,color=red];
		2631 -> 2635;
	2632 [label="Bu senaryoda ben zaten ölüyüm.",shape=box,color=blue];
		2632 -> 2633;
	2635 [label="Eğer bu bir hikaye olsaydı, akıllıca bir numara düşünürdün. Devin taş kalbini çıkarıp bir kuğu tüyüyle parçalayabilir ya da kendisini bir uçurumdan attırabilirsin.",shape=box,color=blue];
		2635 -> 2636;
	2633 [label="Ama en azından onun gözüne tükürebilirim.",shape=box,color=blue];
		2633 -> 2634;
	2636 [label="'Gazeteci' olduğunu söylemiştin. Bu anlatmaya alışık olduğun türden bir hikaye değil, değil mi? Ne kadar çirkin olursa olsun sen hep gerçeği söyledin.",shape=box,color=red];
		2636 -> 2637;
	2634 [label="Chat ends.",color=orange];
	2637 [label="Eğer bu eski hikayeler doğruyu söylemeseydi, insanlar bunları dile getirmeye devam etmezdi.",shape=box,color=blue];
		2637 -> 2638;
	2638 [label="Devlerin gerçek olduğunu söylemiyorum. Sadece eski hikayelerin farklı bir tür gerçeği anlattığını söylüyorum.",shape=box,color=blue];
		2638 -> 2639;
		2638 -> 2640;
	2639 [label="Bu zor dönemi atlatmak için, ne kadar ilham verici olursa olsun, masallardan daha fazlasına ihtiyacımız olacak.",shape=box,color=red];
		2639 -> 2641;
	2640 [label="Hikayelerden oluşan bir krallıkta yaşadım. Onların ne kadar güçlü olabileceğini biliyorum.",shape=box,color=red];
		2640 -> 2643;
	2641 [label="Biliyorum. Keşke devam etmek için içgüdüden daha fazlasına sahip olsaydım.",shape=box,color=blue];
		2641 -> 2642;
	2643 [label="Bence tüm bu dev katil hikayelerinin ortak bir noktası var: Her şey kuralları öğrenmek ve onları ustaca nasıl uygulayacağını bulmakla alakalı.",shape=box,color=blue];
		2643 -> 2644;
	2642 [label="Çok büyük, korkutucu ve idrakimizin ötesinde bir şeyle karşı karşıyayız. Normalde bu sadece çocuklar için mümkün. Peri masalları bunun için var.",shape=box,color=blue];
		2642 -> 2645;
		2642 -> 2646;
	2644 [label="Bazı canavarlar aptaldır. Bazıları gerçekçi olmaya zorlanır. Bazılarının sırları vardır. Ancak canavarın bağlı olduğu kuralları öğrenene kadar kazanamazsın.",shape=box,color=blue];
		2644 -> 2645;
		2644 -> 2646;
	2645 [label="Bu ise Duvara sıkışmış. Duvarın ne olduğunu bile bilmiyorum.",shape=box,color=red];
		2645 -> 2647;
	2646 [label="Kayıtsızlığın herhangi bir kurala bağlı olduğunu düşünmüyorum.",shape=box,color=red];
		2646 -> 2649;
	2647 [label="Bunun önemi yok. Eğer gerçekten sıkışmışsa bundan iki şey çıkarabiliriz, değil mi?",shape=box,color=blue];
		2647 -> 2651;
	2649 [label="Olmak zorunda! Tanrıların bile kuralları vardır! Kayıtsızlık ne kadar güçlü görünürse görünsün, o bir Tanrı değil.",shape=box,color=blue];
		2649 -> 2650;
	2651 [label="İlki, o tuzağa düşebilir. Hatta hapsedilebilir.",shape=box,color=blue];
		2651 -> 2653;
	2650 [label="Thrax'ı yendin. Kaç kez başarısız olup kıçının üstüne düştüğün önemli değil. KAZANDIN. Neden Duvardaki Adam'ı da yenemeyesin ki?",shape=box,color=blue];
		2650 -> 2648;
	2653 [label="+15 Chemistry",color=orange];
		2653 -> 2652;
	2648 [label="Ne zamandan beri bundan korkmayı bıraktın Eleanor?",shape=box,color=red];
		2648 -> 2655;
	2652 [label="Ve ikincisi, o bir şey İSTİYOR. Dışarı çıkmak istiyor. Ne istediğini bilirsek, ondan bir adım öndeyiz demektir.",shape=box,color=blue];
		2652 -> 2654;
	2655 [label="Bırakmadım.",shape=box,color=blue];
		2655 -> 2657;
	2654 [label="Chat ends.",color=orange];
	2657 [label="+20 Chemistry",color=orange];
		2657 -> 2656;
	2656 [label="Seni kaybetmekten daha çok korkuyorum, tamam mı?",shape=box,color=blue];
		2656 -> 2658;
	2658 [label="Chat ends.",color=orange];
}