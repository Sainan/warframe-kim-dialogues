	j2752312562 [label="Selam. Seninle birkaç fikir alışverişinde bulunmam gerek.",shape=box,color=blue];
		j2752312562 -> j2663486446;
	j2663486446 [label="Fiendsnight'ı düşünüyorum. Yıllardır bunun için giyinmemiştim ama Amir'in çizgi romanlarından birini karıştırıyordum ve birden aklıma geldi ve kendi kendime dedim ki - aslında, ben Kontes olabilirim! Hatta dişlerim bile benziyor!",shape=box,color=blue];
