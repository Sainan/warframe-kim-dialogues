		2854 -> 2857;
	2855 [label="Dandy Damage, Temple ve Rippers'ın var olabilmesi için savaştı. O her annenin kabusu ve her gencin korkulu rüyasıydı.",shape=box,color=blue];
		2855 -> 2858;
	2856 [label="Hele o miğferi. O bir miğfer mi? Yoksa onun bir parçası mı? Gözlerini kaplamasına rağmen nasıl görebiliyor?",shape=box,color=blue];
		2856 -> 2859;
	2857 [label="Fiendsnight, Sol'un dünya üzerindeki etkisinin azalmasını kutluyor.",shape=box,color=blue];
		2857 -> 2860;
	2858 [label="Bir sopa böceği gibi yapılı, sessiz bir film kraliçesi gibi yapılmış. Ağzı şeker gibi. İnce çizgili, deri ve köpek zinciri. Elmacık kemikleri bir iskeletin kalçaları gibi.",shape=box,color=blue];
		2858 -> 2861;
		2858 -> 2862;
	2859 [label="Her neyse, bir bedende ondan üç tane var. Birini asla diğerlerine tercih edemem.",shape=box,color=blue];
		2859 -> 2861;
		2859 -> 2862;
	2860 [label="Bu da ilk bakışta pek mantıklı gelmiyor. Neden yükselen karanlığı kutlayalım ki? Neden kanunsuzluğa ve anarşiye sevinelim?",shape=box,color=blue];
		2860 -> 2863;
	2861 [label="Kostüm giymek mi? Parti mi? Savaş bölgesinde mi? Bunun gerçekten olacağını düşünüyor musun?",shape=box,color=red];
		2861 -> 2864;
	2862 [label="Biliyor musun, Fiendsnight kulağa Naberus gibi geliyor. İnsanlar onun için de giyinmeyi seviyor.",shape=box,color=red];
		2862 -> 2864;
	2863 [label="Sanırım bu bir aşılama gibi bir şey. Bizi güçlendirmek için korktuğumuz şeyden küçük bir parçayı benimsiyoruz. Ya da belki de şeytanın maskesini takıp ortalığı ayağa kaldırmak için bir bahanedir.",shape=box,color=blue];
		2863 -> 2861;
