		j3696893025 -> j2186529490;
	j1022456311 [label="Aman Tanrım hayır. Onu kafanda gördüm. Onun hakkını asla veremem.",shape=box,color=blue];
		j1022456311 -> j2206750379;
	j174250886 [label="Mmm. Bazen dışardan gelen masum biri olduğunu unutuyorum. ",shape=box,color=blue];
		j174250886 -> j3045687093;
	j2186529490 [label="Dandy Damage, Temple ve Rippers'ın var olabilmesi için savaştı. O her annenin kabusu ve her gencin korkulu rüyasıydı.",shape=box,color=blue];
		j2186529490 -> j2767028859;
	j2206750379 [label="Hele o miğferi. O bir miğfer mi? Yoksa onun bir parçası mı? Gözlerini kaplamasına rağmen nasıl görebiliyor?",shape=box,color=blue];
		j2206750379 -> j2196656969;
	j3045687093 [label="Fiendsnight, Sol'un dünya üzerindeki etkisinin azalmasını kutluyor.",shape=box,color=blue];
		j3045687093 -> j1838960853;
	j2767028859 [label="Bir sopa böceği gibi yapılı, sessiz bir film kraliçesi gibi yapılmış. Ağzı şeker gibi. İnce çizgili, deri ve köpek zinciri. Elmacık kemikleri bir iskeletin kalçaları gibi.",shape=box,color=blue];
		j2767028859 -> j773734505;
		j2767028859 -> j3221462705;
	j2196656969 [label="Her neyse, bir bedende ondan üç tane var. Birini asla diğerlerine tercih edemem.",shape=box,color=blue];
		j2196656969 -> j773734505;
		j2196656969 -> j3221462705;
	j1838960853 [label="Bu da ilk bakışta pek mantıklı gelmiyor. Neden yükselen karanlığı kutlayalım ki? Neden kanunsuzluğa ve anarşiye sevinelim?",shape=box,color=blue];
		j1838960853 -> j1270444817;
	j773734505 [label="Kostüm giymek mi? Parti mi? Savaş bölgesinde mi? Bunun gerçekten olacağını düşünüyor musun?",shape=box,color=red];
		j773734505 -> j3069953141;
	j3221462705 [label="Biliyor musun, Fiendsnight kulağa Naberus gibi geliyor. İnsanlar onun için de giyinmeyi seviyor.",shape=box,color=red];
		j3221462705 -> j3069953141;
	j1270444817 [label="Sanırım bu bir aşılama gibi bir şey. Bizi güçlendirmek için korktuğumuz şeyden küçük bir parçayı benimsiyoruz. Ya da belki de şeytanın maskesini takıp ortalığı ayağa kaldırmak için bir bahanedir.",shape=box,color=blue];
		j1270444817 -> j773734505;
		j1270444817 -> j3221462705;
