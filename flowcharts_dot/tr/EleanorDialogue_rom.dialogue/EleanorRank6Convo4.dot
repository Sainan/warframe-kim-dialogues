		j1361539880 -> j2510128155;
	j1645378937 [label="Hayatın o kadar fantastik derecede saçma ki, Tanrı'nın gerçekliği senin için pizza malzemelerinin göreceli değerleri kadar doğal bir spekülasyon",shape=box,color=blue];
		j1645378937 -> j626407111;
	j2429722432 [label="Gerçek Tanrılar köy kuyuları ve açık hava tuvaletleri gibidir. Bunlar insanların BİR ZAMANLAR ihtiyaç duyduğu şeylerdi. ",shape=box,color=blue];
		j2429722432 -> j3710797257;
	j2510128155 [label="Bildiğin her şeyin, işlerin böyle yürümesinden sorumlu olan kişilerin elinde olduğunu düşün. Hak ettikleri için değil, öyle olması gerektiği için bu ölümsüz pisliklerin her şeyi elinde tuttuğunu hayal et",shape=box,color=blue];
		j2510128155 -> j205624129;
