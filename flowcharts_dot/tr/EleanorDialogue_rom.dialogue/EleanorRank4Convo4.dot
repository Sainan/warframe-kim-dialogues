	1701 [label="Lettie ile arkadaş mıydınız?",shape=box,color=red];
		1701 -> 1704;
	1702 [label="Burası birbirine oldukça bağlı bir grup. Aranızda hiç Hex'ten başka biriyle çıkan oldu mu?",shape=box,color=red];
		1702 -> 1705;
	1703 [label="Arthur'un biriyle romantik bir ilişki yaşamasını nasıl karşılarsın?",shape=box,color=red];
		1703 -> 1706;
	1704 [label="Aman Tanrım, evet. Bir ara çok yakındık.",shape=box,color=blue];
		1704 -> 1707;
	1705 [label="Bu biraz kişisel, dostum, ama buna izin vereceğim. Bir süredir bizimle birliktesin. Neyin ne olduğunu bilmeyi hak ediyorsun.",shape=box,color=blue];
		1705 -> 1708;
	1706 [label="Milyonlarca kilometre uzakta olmayan birini mi kastediyorsun?",shape=box,color=blue];
		1706 -> 1709;
	1707 [label="Elbette bu Entrati'den önceydi.",shape=box,color=blue];
		1707 -> 1710;
	1708 [label="Arthur ve Aoi'nin flörtü dışında mı? Hayır. Bildiğim kadarıyla yok... olsa BİLİRDİM.",shape=box,color=blue];
		1708 -> 1711;
	1709 [label="Buna cevap verme.",shape=box,color=blue];
		1709 -> 1712;
	1710 [label="Şimdi farklı biriymişim gibi davranıyor. İşine öyle geliyor. Eğer gerçekten Eleanor değilsem o zaman bana karşı istediği kadar kırıcı olabilir çünkü tanıdığı kişiye zarar vermiyor. Bence bu korkakça.",shape=box,color=blue];
		1710 -> 1715;
	1711 [label="Ve herhangi birimize yakınlaşmayı düşünüyorsan...",shape=box,color=blue];
		1711 -> 1713;
	1712 [label="Eğer o kişinin ne yaptığını bildiğine ve o adama karşı gerçek hisler beslediğine ikna olsaydım, çok heyecanlanırdım. Tabii ki heyecanlanırdım.",shape=box,color=blue];
		1712 -> 1714;
	1715 [label="Yine de iyileşmeni istiyor, değil mi?",shape=box,color=red];
		1715 -> 1723;
	1713 [label="... Quincy'nin güvenini kazanmaktan daha kötüsünü yapabilirsin. O çok şey görüyor. Belki not alabilirsin.",shape=box,color=blue];
		1713 -> 1716;
	1714 [label="Ama ben olsam onu incitmenin ne kadar kolay olduğunu bilmesini sağlardım.",shape=box,color=blue];
		1714 -> 1719;
	1723 [label="Hadi ama. BU olmadan önce, kanatlarım ve kuyruğum çıkacak.",shape=box,color=blue];
		1723 -> 1724;
	1716 [label="+5 Chemistry",color=orange];
		1716 -> 1717;
	1719 [label="Dışı zırhla kaplı ama içi yumuşak ve süngerimsi organik maddelerden oluşan bu robotlara ne deniyordu?",shape=box,color=blue];
		1719 -> 1718;
		1719 -> 1720;
		1719 -> 1721;
	1724 [label="Entrati kaçtı. Duşta şarkı söyleyen ve sokaktaki çocuklara gülümseyen eski Eleanor'u geri kazanma umudu varsa bile, bu umut onunla birlikte yok oldu.",shape=box,color=blue];
		1724 -> 1728;
		1724 -> 1729;
	1717 [label="Chat ends.",color=orange];
	1718 [label="Solaris mi?",shape=box,color=red];
		1718 -> 1722;
	1720 [label="Nox mu?",shape=box,color=red];
		1720 -> 1722;
	1721 [label="Sentient'ler mi?",shape=box,color=red];
		1721 -> 1722;
	1728 [label="Lettie aynaya bakmalı ve kendisinin de insanlığını kaybetmekten sadece birkaç kötü gün uzakta olduğunu fark etmeli.",shape=box,color=red];
		1728 -> 1730;
	1729 [label="Arthur hala onun kız kardeşi olduğunu düşünüyorsa, bu Lettie için yeterli olmalı.",shape=box,color=red];
		1729 -> 1731;
	1722 [label="Her neyse. Asıl mesele Arthur'un da onlardan biri olması.",shape=box,color=blue];
		1722 -> 1725;
	1730 [label="Benimle iyi geçinmeye mi çalışıyorsun?",shape=box,color=blue];
		1730 -> 1732;
	1731 [label="SEN ÖYLE SAN.",shape=box,color=blue];
		1731 -> 1733;
