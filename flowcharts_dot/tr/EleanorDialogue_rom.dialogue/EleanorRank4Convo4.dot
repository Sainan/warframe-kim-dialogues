	1784 [label="Tanrım, bir gün bir barı devralmaktan bile bahsetti. Zihnimde canlandırabiliyorum, küçük müdavim kalabalığıyla birlikte bira içiyor, Pazar menüleri hazırlıyor ve zor kazanılmış bilgelikle dolu.",shape=box,color=blue];
