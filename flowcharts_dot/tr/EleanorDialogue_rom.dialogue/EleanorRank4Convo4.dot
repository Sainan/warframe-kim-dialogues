	1769 [label="Sadece açıklığa kavuşturalım: Arthur'u kışkırtmak BENİM ayrıcalığımdır. Ve eğer ona bilerek zalimce davranırsan, seni öldürürüm. Bir şey daha...",shape=box,color=blue];
