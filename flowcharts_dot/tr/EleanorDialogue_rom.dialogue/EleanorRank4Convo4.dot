		1725 -> 1726;
	1732 [label="Yani, evet. Öyle olmalı.",shape=box,color=blue];
		1732 -> 1734;
	1733 [label="Lettie Arthur'a tapıyor. O, onun hiç sahip olmadığı abisi. Eğer Arthur orada olmasaydı, ağzımda bir kloroform beziyle uyanır ve kendimi nehrin dibinde bulurdum.",shape=box,color=blue];
		1733 -> 1735;
	1726 [label="+5 Chemistry",color=orange];
		1726 -> 1727;
	1734 [label="Şehrin yanması gerektiğini söylediğinden beri onu hala affetmedim.",shape=box,color=blue];
		1734 -> 1736;
	1735 [label="Onun gerçeklikten kopuk olduğunu ve geçmişe bağlı kaldığını düşünüyor. Ama adamı seviyor ve iyi bir asker, bu yüzden asla ona karşı gelmez.",shape=box,color=blue];
		1735 -> 1737;
		1735 -> 1738;
	1727 [label="Chat ends.",color=orange];
	1736 [label="Aoi bile şok olmuştu. İnsan gerçek canavarların kim olduğunu merak ediyor, değil mi?",shape=box,color=blue];
		1736 -> 1737;
		1736 -> 1738;
	1737 [label="Neden senden bu kadar nefret ediyor ki?",shape=box,color=red];
		1737 -> 1739;
	1738 [label="Cidden onu korkutan sadece dil olayı mı? Yoksa zihin okuma olayı mı?",shape=box,color=red];
		1738 -> 1739;
	1739 [label="Bu biraz karışık. Birden fazla sebebi var.",shape=box,color=blue];
		1739 -> 1740;
	1740 [label="Yüzüme karşı onun kafasının içini kurcalamaya iznim olmadığını söyledi. Eğer kabul etmezsem, Hex'ten ayrılacak ve şansını kendi başına deneyecekti. Tam bir delilik.",shape=box,color=blue];
		1740 -> 1741;
	1741 [label="Yani bunun bir kısmı, onun ergenlik günlüğünü okuyacağımdan korkması. En utanç verici sırlarına bakacağım ve kahkahalarla güleceğim ve o sonsuza dek aşağılanacak.",shape=box,color=blue];
		1741 -> 1742;
	1742 [label="Gerçek şu ki, o kadar da meraklı değilim. Benden sakladığı küçük sır her neyse, güvende.",shape=box,color=blue];
		1742 -> 1743;
		1742 -> 1744;
	1743 [label="İkinizin hiç... romantik bir geçmişi oldu mu?",shape=box,color=red];
		1743 -> 1745;
	1744 [label="Peki sence senden HOŞLANIYOR olabilir mi?",shape=box,color=red];
		1744 -> 1746;
	1745 [label="Sence bunu söyler miyim?",shape=box,color=blue];
		1745 -> 1747;
	1746 [label="Aklımdan geçmedi değil.",shape=box,color=blue];
		1746 -> 1748;
	1747 [label="Hayır. Öyle bir geçmişimiz olmadı.",shape=box,color=blue];
		1747 -> 1749;
	1748 [label="Sanırım bunu yapmaya istekli olurdum. Arkadaşlar arasında öpüşüp koklaşmanın yanlış bir tarafı yok, özellikle de Arthur toplantıda duygularımızın işimizi yapmamıza engel olmaması gerektiğine dair utanç verici bir konuşma yaptıktan sonra.",shape=box,color=blue];
		1748 -> 1750;
	1749 [label="Ve bu iyi bir şey. Aksi takdirde aramızın ne kadar garip olacağını hayal edebiliyor musun?",shape=box,color=blue];
		1749 -> 1751;
	1750 [label="Rahatlatıcı, moral için iyi ve ucuz.",shape=box,color=blue];
		1750 -> 1752;
	1751 [label="Yani... Hayır demezdim. Sadece hiç gündeme gelmedi.",shape=box,color=blue];
		1751 -> 1755;
	1752 [label="Ama Bayan Garcia'nın sakladığı her neyse, ona zarar vermek için kullanılabilir. Yani ben bir tehdidim çünkü bunu onun zihninde görebiliyorum.",shape=box,color=blue];
		1752 -> 1754;
	1755 [label="+10 Chemistry",color=orange];
		1755 -> 1753;
	1754 [label="Bekle, Arthur ve Aoi bir çift değil miydi?",shape=box,color=red];
		1754 -> 1757;
	1753 [label="Eğer ondan etkileniyorsan, devam et! Ben kenardan desteklerim! Lua biliyor ki, Lettie'nin kasvetli ve sevgisiz hayatında biraz neşeye ihtiyacı var.",shape=box,color=blue];
		1753 -> 1756;
	1757 [label="Neden? Kardeşime göz mü koydun? Ya da Aoi'ye?",shape=box,color=blue];
