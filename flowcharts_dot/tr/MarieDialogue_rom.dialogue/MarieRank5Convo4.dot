		j535829035 -> j4249175720;
	j3166759762 [label="Sanırım haklısınız. Şeytan belki de ihtiyacımız olan eksik parçadır. Ah, bu kelimeleri yazmak bile bana acı veriyor ! ",shape=box,color=blue];
		j3166759762 -> j409794056;
	j2136422878 [label="Şüpheli kaynakların yardımına ihtiyaç duymayan iyi fikirlerim pek yok. Bu kaynaklar daha sonra bizi daha da büyük zorluklara sokabilir. Örneğin Roathe gibi.",shape=box,color=red];
