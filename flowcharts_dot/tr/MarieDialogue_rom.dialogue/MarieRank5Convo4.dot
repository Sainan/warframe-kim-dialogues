		2983 -> 2987;
	2981 [label="Sanırım haklısınız. Şeytan belki de ihtiyacımız olan eksik parçadır. Ah, bu kelimeleri yazmak bile bana acı veriyor ! ",shape=box,color=blue];
		2981 -> 2985;
