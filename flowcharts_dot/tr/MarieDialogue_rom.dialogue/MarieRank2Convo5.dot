		811 -> 816;
	822 [label="Necraloid'in ruhu olmayabilir, ama onun eşi benzeri yoktur. Otak gibi diğer Cephalonlar ruha sahiptir. Onlar, yaratılış biçimleriyle yok olmuşlardı.",shape=box,color=red];
