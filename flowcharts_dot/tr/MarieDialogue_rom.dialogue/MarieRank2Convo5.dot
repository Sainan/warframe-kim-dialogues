	810 [label="Bence bu gereksiz bir zulüm, sizce de öyle değil mi ? Onun öldüğünü düşünebilirler. Ya da daha kötüsünü ! Peki ya biz, burada yaşayan bizler, comme des rats d'égout ?",shape=box,color=blue];
		810 -> 814;
		810 -> 815;
