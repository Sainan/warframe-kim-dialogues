	j1260213540 [label="Akıllıca bir soru. Çok akıllıca bir soru. Sanırım bana ilham veren birçok sebep var. Beni masasına oturtanın nezaket olduğunu düşünmek isterim.",shape=box,color=blue];
		j1260213540 -> j2222544903;
