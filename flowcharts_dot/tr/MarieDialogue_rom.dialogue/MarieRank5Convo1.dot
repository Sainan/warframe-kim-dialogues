		j3592099107 -> j1270675612;
		j3592099107 -> j3718987536;
		j3592099107 -> j508234885;
	j1467203151 [label="Merci, bu mücadelede bana sadık bir yoldaş oldunuz ! Korkarım ki bu konuda yalnızız - Mösyö Loid bile böyle bir kin besliyor...",shape=box,color=blue];
		j1467203151 -> j3564378616;
	j1057277276 [label="Merci, bunu duyduğuma çok sevindim ! Korkarım ki bu konuda yalnızız - Mösyö Loid bile böyle bir kin besliyor...",shape=box,color=blue];
		j1057277276 -> j3564378616;
	j1830286235 [label="Bence sorun, başkalarının senden ne istediğinden çok, senin başkalarından ne istediğinde yatıyor. Ya da Entrati'den.",shape=box,color=red];
		j1830286235 -> j1782453694;
