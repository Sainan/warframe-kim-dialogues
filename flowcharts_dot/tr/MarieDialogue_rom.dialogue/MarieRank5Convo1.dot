	2463 [label="Ve bizim yapmamızı önerdiğiniz şey bu mu ? le Cardinal'i dışlamak mı ? Bence o bunu kendine kendisine yaptı, non ?",shape=box,color=blue];
		2463 -> 2474;
		2463 -> 2467;
	2464 [label="Lyon'un birçok rahatsızlığı olduğunu düşünüyorum, bunların çoğu da kendine ve zihnine duyduğu şüphelerden kaynaklanıyor. Le Cardinal'in işleri daha da hızlandırdığı anlaşılıyor.",shape=box,color=blue];
		2464 -> 2475;
		2464 -> 2467;
	2465 [label="Ne yapmamı istiyorsunuz ? Le Cardinal'in bir kuklasını yakıp sonra ona sırtımı mı döneyim ? Onu Void'e mahkum edip, Mösyö Tagfer gibi ona zarar gelmesini mi dileyeyim ?",shape=box,color=blue];
		2465 -> 2474;
		2465 -> 2467;
	2466 [label="Mesele bu, Marie. Başkalarından ne istediğin önemli. Onların senden ne istediği değil. Ya da Entrati'den.",shape=box,color=red];
		2466 -> 2476;
	2467 [label="Entrati gittiği her yerde acılı insanlar bırakıyor. Benim tek amacım, bu insanlara hayatlarını yeniden düzene sokmaları için yardım etmek. Onun durumunda ''iyi'' ya da ''kötü'' kavramları beni pek ilgilendirmiyor.",shape=box,color=red];
		2467 -> 2477;
	2469 [label="Oui, ve siz ona karşı nefretinizde çok ısrarcısınız ! Söylediklerimin hiçbiri sizi le Cardinal'e karşı yumuşatmadı mı ?",shape=box,color=blue];
		2469 -> 2482;
	2468 [label="Bana, tıpkı benim gibi, Entrati'yi nasıl kayırdığından bahsetmiyor muydunuz ? Şimdi fikrinizi ne değiştirdi ?",shape=box,color=blue];
		2468 -> 2478;
		2468 -> 2479;
		2468 -> 2480;
		2468 -> 2481;
	2470 [label="Oui, Entrati'yi tam bir canavar olarak görüyorsunuz ! Onun nezaketini hemen reddediyorsunuz !",shape=box,color=blue];
		2470 -> 2482;
	2473 [label="Az önce bana Entrati'nin monstruosité'sinden bahsetmiyor muydunuz ? Şimdi fikrinizi ne değiştirdi ?",shape=box,color=blue];
		2473 -> 2478;
		2473 -> 2479;
		2473 -> 2480;
		2473 -> 2481;
	2471 [label="Merci, bu mücadelede bana sadık bir yoldaş oldunuz ! Korkarım ki bu konuda yalnızız - Mösyö Loid bile böyle bir kin besliyor...",shape=box,color=blue];
		2471 -> 2483;
	2472 [label="Merci, bunu duyduğuma çok sevindim ! Korkarım ki bu konuda yalnızız - Mösyö Loid bile böyle bir kin besliyor...",shape=box,color=blue];
		2472 -> 2483;
	2474 [label="Bence sorun, başkalarının senden ne istediğinden çok, senin başkalarından ne istediğinde yatıyor. Ya da Entrati'den.",shape=box,color=red];
		2474 -> 2476;
	2475 [label="Ve bu seni rahatsız etmiyor mu?",shape=box,color=red];
		2475 -> 2484;
	2476 [label="Peki başkalarından bu kadar iğrenç ne istiyorum ? Kalplerine bağışlanmayı kabul etmelerini mi ?",shape=box,color=blue];
		2476 -> 2485;
		2476 -> 2486;
	2477 [label="Zaman ve uzayda seyahat ederek hoşnutsuzlara yardım etmek asil bir davranış, ama aynı zamanda yorucu da, non ? Ona kızgın olmalısınız...",shape=box,color=blue];
		2477 -> 2487;
		2477 -> 2488;
	2482 [label="Bu konuşma bir hataydı...",shape=box,color=blue];
		2482 -> 2493;
		2482 -> 2494;
	2478 [label="Dürüst olmak gerekirse, bu konuyu seninle tartışmakta zorlanıyorum. Çok acı verici bir şekilde. Şahsen ben onun... ne iyi ne de kötü olduğunu düşünüyorum. Ama ikisinin karışımı.",shape=box,color=red];
		2478 -> 2489;
	2479 [label="Fikrimi değiştirdim. Onun tarafındayım. Ve senin tarafındayım. Beni ikna ettin.",shape=box,color=red];
		2479 -> 2490;
	2480 [label="[Duygularını itiraf et.] Korkarım ki, sadece senin gözüne girmek için elimden geleni yapmaya çalışıyordum. Sana karşı hislerim var. Gösterdiğimden daha fazlası.",shape=box,color=red];
		2480 -> 2491;
	2481 [label="Fikrimi değiştirdim ve onun bir canavar olduğuna karar verdim. Sonsuza dek.",shape=box,color=red];
		2481 -> 2492;
	2483 [label="Belki birlikte, onun iyi işlerini lekelemek isteyenlere karşı kendimizi savunabiliriz, , oui ? Ama merak ediyorum, etrafınızdaki her şeye karşı... neden benim tarafımı tutuyorsunuz ?",shape=box,color=blue];
