		j1782453694 -> j601045610;
		j1782453694 -> j1358469577;
	j322670456 [label="Zaman ve uzayda seyahat ederek hoşnutsuzlara yardım etmek asil bir davranış, ama aynı zamanda yorucu da, non ? Ona kızgın olmalısınız...",shape=box,color=blue];
		j322670456 -> j457111226;
