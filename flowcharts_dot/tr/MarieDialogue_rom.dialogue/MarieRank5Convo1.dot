		2529 -> 2542;
	2530 [label="Marie, o bir tanrı değil. O sadece bir insan. Roathe kadar kibirli ve tehlikeli. Aynı toplumdan geliyor ve aynı sorunlardan muzdarip.",shape=box,color=red];
		2530 -> 2543;
	2531 [label="Sana karşı nazik olduğunu biliyorum. Sana karşı belki de birçok insana davrandığından farklı davrandığını biliyorum. Hatta belki sana kızı gibi davrandı... Ama lütfen daha büyük resme bak.",shape=box,color=red];
		2531 -> 2544;
	2536 [label="Ben - Ben bu haberi nasıl karşılayacağımı bilmiyorum, şu anki konuşmamız göz önüne alındığında. Bu beni... oldukça şaşırttı. ",shape=box,color=blue];
