	2435 [label="Le Cardinal hakkında söylenmemiş çok şey olduğunu hissediyorum. Diğerleri benim etrafımda yumurta kabuğu üzerinde yürür gibi davranıyor, ondan bahsetmekten korkuyorlar gibi görünüyor.",shape=box,color=blue];
