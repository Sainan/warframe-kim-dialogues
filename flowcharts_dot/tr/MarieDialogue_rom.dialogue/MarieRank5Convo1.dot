		2500 -> 2516;
		2500 -> 2517;
	2505 [label="[Duygularını itiraf et.] Seni önemsiyorum. Gösterdiğimden daha fazla. Ve ben... Sert davrandığım için özür dilerim, ama onun seni incitmesine izin veremem. Diğerlerini incittiği gibi.",shape=box,color=red];
		2505 -> 2523;
	2506 [label="Entrati'nin tek yaptığının, önemsediği herkesi yakmak olduğunu gördüm. Sevdiğini sandığı herkesi. Sana da aynısını yapmasını istemiyorum...",shape=box,color=red];
		2506 -> 2524;
	2507 [label="Kendimi ifade etmekte pek iyi değilimdir ve bunun için üzgünüm. Ama o... Seni kullanıyor ve nezaketini kullanarak seni manipüle ediyor. Hepsi bu.",shape=box,color=red];
		2507 -> 2525;
	2508 [label="Sen Entrati'yi bir kurtarıcı olarak görebilirsin, ama ben onu cevapları arayan yaşlı ve korkmuş bir adam olarak görüyorum. Belki de cevap ikisinin arasında bir yerdedir.",shape=box,color=red];
		2508 -> 2498;
