	j3978104746 [label="Ve bizim yapmamızı önerdiğiniz şey bu mu ? le Cardinal'i dışlamak mı ? Bence o bunu kendine kendisine yaptı, non ?",shape=box,color=blue];
		j3978104746 -> j1830286235;
		j3978104746 -> j987974809;
	j594262908 [label="Lyon'un birçok rahatsızlığı olduğunu düşünüyorum, bunların çoğu da kendine ve zihnine duyduğu şüphelerden kaynaklanıyor. Le Cardinal'in işleri daha da hızlandırdığı anlaşılıyor.",shape=box,color=blue];
		j594262908 -> j1209140567;
		j594262908 -> j987974809;
	j1513098778 [label="Ne yapmamı istiyorsunuz ? Le Cardinal'in bir kuklasını yakıp sonra ona sırtımı mı döneyim ? Onu Void'e mahkum edip, Mösyö Tagfer gibi ona zarar gelmesini mi dileyeyim ?",shape=box,color=blue];
		j1513098778 -> j1830286235;
		j1513098778 -> j987974809;
	j2171141533 [label="Mesele bu, Marie. Başkalarından ne istediğin önemli. Onların senden ne istediği değil. Ya da Entrati'den.",shape=box,color=red];
		j2171141533 -> j1782453694;
	j987974809 [label="Entrati gittiği her yerde acılı insanlar bırakıyor. Benim tek amacım, bu insanlara hayatlarını yeniden düzene sokmaları için yardım etmek. Onun durumunda ''iyi'' ya da ''kötü'' kavramları beni pek ilgilendirmiyor.",shape=box,color=red];
		j987974809 -> j322670456;
	j1534768998 [label="Oui, ve siz ona karşı nefretinizde çok ısrarcısınız ! Söylediklerimin hiçbiri sizi le Cardinal'e karşı yumuşatmadı mı ?",shape=box,color=blue];
		j1534768998 -> j4103661800;
	j1987321038 [label="Bana, tıpkı benim gibi, Entrati'yi nasıl kayırdığından bahsetmiyor muydunuz ? Şimdi fikrinizi ne değiştirdi ?",shape=box,color=blue];
		j1987321038 -> j3215458242;
