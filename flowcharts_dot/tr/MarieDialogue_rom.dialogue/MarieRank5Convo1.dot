		j3252444403 -> j2005719631;
	j1673741991 [label="Onun kalbinizde bir yer bulduğunu biliyorum ve bunun için gerçekten minnettarım - belki sonunda onun için endişelenmeyi bırakabilirim ve tüm bu kavgalar yakında anlamsız hale gelir -",shape=box,color=blue];
		j1673741991 -> j387733482;
	j387733482 [label="Ama tabii ki bu beni rahatsız ediyor. O benim ruh ikizim ! Lyon benim için bu dünyadaki en değerli şey ve onun acı çektiğini görmek, sanki onun acısı benim acımmış gibi göğsümde bir sızı yaratıyor.",shape=box,color=blue];
		j387733482 -> j2416360226;
	j1110901401 [label="Sözlerine dikkat et, Gezgin.",shape=box,color=blue];
		j1110901401 -> j3282404360;
