		2511 -> 2528;
	2512 [label="Entrati'ye inanıyorum. Gerçekten. Bence bunu çözmek için bir planı var ve tüm bunlar nihai iyilik için oldu.",shape=box,color=red];
		2512 -> 2529;
	2513 [label="Ama inancınızdan düşmesi le Cardinal'in işi değil. Temeldeki çatlaklar zaten oradaydı. Sadece daha fazla baskı uygulandı, oui ?",shape=box,color=blue];
		2513 -> 2500;
	2514 [label="Update boolean MarieWarning",color=orange];
		2514 -> 2499;
	2515 [label="Le Cardinal hem Lua hem de Sol - aydınlık ve karanlık - iyi ve kötü - olduğunun gayet farkındayım. İkisi de değil, ikisi de; hem iyilik hem de zulüm yapabilir.",shape=box,color=blue];
		2515 -> 2530;
		2515 -> 2531;
	2516 [label="Bu yüzden diğerleri onun hakkında konuştuğunda sinirleniyorlar. Onları inciten her şeyi görmezden gelip, aptallar gibi hiçbir şey olmamış gibi davranıyorsunuz.",shape=box,color=red];
		2516 -> 2498;
	2517 [label="Marie, dur. Tüm bunları sırf iyi bir adam olduğu için yapmadığını kabul etmelisin. İyi bir adam değil. O bundan çok daha karmaşık.",shape=box,color=red];
