		2496 -> 2497;
	2497 [label="Ama tabii ki bu beni rahatsız ediyor. O benim ruh ikizim ! Lyon benim için bu dünyadaki en değerli şey ve onun acı çektiğini görmek, sanki onun acısı benim acımmış gibi göğsümde bir sızı yaratıyor.",shape=box,color=blue];
