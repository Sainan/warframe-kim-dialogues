		j1987321038 -> j3718987536;
		j1987321038 -> j508234885;
	j3200928748 [label="Oui, Entrati'yi tam bir canavar olarak görüyorsunuz ! Onun nezaketini hemen reddediyorsunuz !",shape=box,color=blue];
		j3200928748 -> j4103661800;
	j3592099107 [label="Az önce bana Entrati'nin monstruosité'sinden bahsetmiyor muydunuz ? Şimdi fikrinizi ne değiştirdi ?",shape=box,color=blue];
