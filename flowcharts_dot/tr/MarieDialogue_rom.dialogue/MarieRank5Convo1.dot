		j3462123852 -> j759203666;
	j1287158933 [label="Belki de sadece vücudun iyileşmesi için bir zehir kullanıyordur ve bunların hepsi sadece gerekli bir zulümdür.",shape=box,color=blue];
		j1287158933 -> j3209415944;
		j1287158933 -> j2172978696;
