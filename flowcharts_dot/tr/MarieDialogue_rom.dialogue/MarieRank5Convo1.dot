		j601045610 -> j1110901401;
	j1358469577 [label="Bence sen onlardan Entrati'yi affetmelerinden daha fazlasını istiyorsun. Onlardan Entrati'nin yaptıklarının hiçbirinin suç sayılmayacakmış gibi davranmalarını istediğini düşünüyorum.",shape=box,color=red];
		j1358469577 -> j3462123852;
	j457111226 [label="Elbette. Ama aynı zamanda kurduğum en önemli ilişkiler ve dostlukların bir kısmı için de ona \"teşekkür\" etmeliyim.",shape=box,color=red];
		j457111226 -> j1287158933;
	j3018334728 [label="Hayır, pek sayılmaz. Bunu yapmamı istiyor, o yüzden yapacağım. Her şey bittiğinde onu yargılayacağım.",shape=box,color=red];
		j3018334728 -> j1287158933;
