		j508234885 -> j2258789461;
	j3564378616 [label="Belki birlikte, onun iyi işlerini lekelemek isteyenlere karşı kendimizi savunabiliriz, , oui ? Ama merak ediyorum, etrafınızdaki her şeye karşı... neden benim tarafımı tutuyorsunuz ?",shape=box,color=blue];
