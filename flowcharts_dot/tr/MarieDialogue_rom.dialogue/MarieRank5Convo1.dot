	j4103661800 [label="Bu konuşma bir hataydı...",shape=box,color=blue];
		j4103661800 -> j2412720519;
		j4103661800 -> j2701405806;
	j3215458242 [label="Dürüst olmak gerekirse, bu konuyu seninle tartışmakta zorlanıyorum. Çok acı verici bir şekilde. Şahsen ben onun... ne iyi ne de kötü olduğunu düşünüyorum. Ama ikisinin karışımı.",shape=box,color=red];
		j3215458242 -> j373947564;
	j1270675612 [label="Fikrimi değiştirdim. Onun tarafındayım. Ve senin tarafındayım. Beni ikna ettin.",shape=box,color=red];
		j1270675612 -> j3985497495;
	j3718987536 [label="[Duygularını itiraf et.] Korkarım ki, sadece senin gözüne girmek için elimden geleni yapmaya çalışıyordum. Sana karşı hislerim var. Gösterdiğimden daha fazlası.",shape=box,color=red];
		j3718987536 -> j3638505903;
