		960 -> 970 [label="false",color=purple];
	961 [label="Oui, haklısın. Sanırım yaptıklarından dolayı suçluluk duygusu onu rahatsız ediyor. Sanırım kendini başkalarından kasıtlı olarak uzaklaştırıyor.",shape=box,color=blue];
		961 -> 973;
	962 [label="Oui, bu korkunç bir keder, korkunç bir acı. Birinin... hâlâ hayatta olduğunu ve görünüşe göre sizin yanınızda olmayı seçmediğini bilmek ?",shape=box,color=blue];
		962 -> 973;
	964 [label="Mon cœur se brise dans la tragédie - Bunun üzüntüsüyle başa çıkabileceğimi sanmıyorum... ve yine de onu affetmeyecek mi ?",shape=box,color=blue];
		964 -> 975;
		964 -> 976;
