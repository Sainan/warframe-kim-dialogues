		929 -> 942;
	933 [label="Ondan, sadece Sol'un gülümsemesinin sıcaklığını hissediyorum. Le Cardinal'in bu seçimi akıllıcaydı bence. Onu damarlarımda taşımaktan onur duyuyorum.",shape=box,color=blue];
