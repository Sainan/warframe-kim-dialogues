		j1802412219 -> j2542534175;
	j892926054 [label="Et pourtant, vous êtes toujours en vie ! Hayattasınız, değil mi ? Ve iyisiniz? Ve eğer Mösyö Loid'in geçmiş-gelecekteki maceralarınıza dair anlattığı hikâyelere inanacak olursak, oldukça başarılısınız.",shape=box,color=blue];
		j892926054 -> j4231093281;
	j3992737367 [label="Ah, je vois ! Je suis une idiote, c'est ça ?! Juste une petite invalide venue d'un passé lointain, incapable de penser par elle-même ?! Mieux vaut l'approcher comme un faon dans les bois, de peur de l'effrayer !",shape=box,color=blue];
