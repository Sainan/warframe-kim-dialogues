	966 [label="Ne demek istiyorsunuz ? ",shape=box,color=blue];
		966 -> 978;
		966 -> 979;
	968 [label="Gerçekten de, eğer Cavia'lar arasındaki söylentiler doğruysa, vous y avez vraiment trouvé beaucoup de joie, non ?",shape=box,color=blue];
		968 -> 967;
	967 [label="Non, le Cardinal birçok kişiye çok daha kötü şeyler yaptı, siz sadece işler istediğiniz gibi gitmediği için sinirli olmalısınız.",shape=box,color=blue];
		967 -> 917;
