	j2363986226 [label="Gerçekten de, eğer Cavialar arasındaki söylentiler doğruysa, vous y avez vraiment trouvé beaucoup de joie, non ?",shape=box,color=blue];
		j2363986226 -> j2809078396;
	j2809078396 [label="Non, le Cardinal birçok kişiye çok daha kötü şeyler yaptı, siz sadece işler istediğiniz gibi gitmediği için sinirli olmalısınız.",shape=box,color=blue];
		j2809078396 -> j1591510439;
