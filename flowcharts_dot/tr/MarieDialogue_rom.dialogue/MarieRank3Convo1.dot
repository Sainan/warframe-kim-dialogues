	918 [label="Bana sadece Infested'dan bahsedildi, hakkında çok az şey biliyorum... ama size inanıyorum. Hissettiklerim doğruysa, ki öyle olmasını umuyorum, bence tuzağa düşmedi.",shape=box,color=blue];
