		j3820433870 -> j1969970464;
	j1802412219 [label="Sol aşkına ! Kızının yazdığı kitaptan esinlenerek bu dünyayı mı yarattı, oui ? Mösyö Loid bundan bahsetmişti... Le Cardinal orada mıydı ? Neden ? ",shape=box,color=blue];
