	956 [label="Sanırım ilk başta, onun bir parçası geride bıraktığı kızını arıyordu. Ama bunun yerine, Kayıtsızlıkla -kendini uzaklaştırmaya çalıştığı duygularla- savaşmanın bir yolunu buldu.",shape=box,color=red];
		956 -> 964;
	957 [label="Notları, kavramsal bedenselliği incelemek için gittiği ve bunun yerine Kayıtsızlıkla savaşmanın değerini öğrendiği son derece itici bir şekilde kendini pohpohlayan bir hikayeyi anlatıyor.",shape=box,color=red];
		957 -> 965;
	958 [label="Notlarına inanacak olursak, o Duviri'ye - ve dolayısıyla bana - Kayıtsızlık'a karşı nasıl savunma yapılacağını öğretmek için oradaydı. Sonuçta ne işe yaradığını da.",shape=box,color=red];
