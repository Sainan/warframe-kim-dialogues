	943 [label="Haklısın, çok sayıda insanı incitmiş ve terk etmiş. Ve sanırım bunu yapmak zorundaymış gibi hissediyor.",shape=box,color=red];
		943 -> 952;
	944 [label="Senin için bu kadar önemli olan, sevdiğin ve güvendiğin birinin gitmesi zordur. Özellikle de nedenini bilmiyorsan. Ya da geri dönüp dönmeyeceğini bilmiyorsan.",shape=box,color=red];
		944 -> 953;
	947 [label="Sol aşkına ! Kızının yazdığı kitaptan esinlenerek bu dünyayı mı yarattı, oui ? Mösyö Loid bundan bahsetmişti... Le Cardinal orada mıydı ? Neden ? ",shape=box,color=blue];
		947 -> 956;
		947 -> 957;
		947 -> 958;
	948 [label="Et pourtant, vous êtes toujours en vie ! Hayattasınız, değil mi ? Ve iyisiniz? Ve eğer Mösyö Loid'in geçmiş-gelecekteki maceralarınıza dair anlattığı hikâyelere inanacak olursak, oldukça başarılısınız.",shape=box,color=blue];
		948 -> 959;
	945 [label="Ah, je vois ! Je suis une idiote, c'est ça ?! Juste une petite invalide venue d'un passé lointain, incapable de penser par elle-même ?! Mieux vaut l'approcher comme un faon dans les bois, de peur de l'effrayer !",shape=box,color=blue];
		945 -> 954;
	946 [label="Ah, oui... Gerçeği söylemenizi hiç de kolaylaştırmadım, n'est-ce pas ?",shape=box,color=blue];
		946 -> 955;
	950 [label="Chat ends.",color=orange];
	949 [label="Bizi terk ettiği için onu affettim. Başka kimsenin affedeceğini sanmıyorum...",shape=box,color=blue];
		949 -> 943;
		949 -> 944;
	951 [label="Le Cardinal bize geri dönmenin bir yolunu bulmalı. Bizler, çağırdığında ona yardım etmek için elimizden geleni yapabilir ve onun gibi kutsanmış olanların bize emrettiği gibi davranabiliriz.",shape=box,color=blue];
		951 -> 960;
