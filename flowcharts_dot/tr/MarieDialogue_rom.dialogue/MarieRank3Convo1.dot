		969 -> 980;
	971 [label="Onu kutsal olarak adlandırır mıyım, bilmiyorum.",shape=box,color=red];
		971 -> 982;
	972 [label="Eğer anlayabilseydim, Entrati'nin yaptığı kötülükleri affetmem çok daha kolay olurdu.",shape=box,color=red];
		972 -> 983;
	970 [label="Bu sorunu çözmek için benden istediğini yapacağım. Ve tüm bunlar sona erdiğinde, ancak o zaman onu yargılayacağım.",shape=box,color=red];
		970 -> 981;
	973 [label="Il inflige la douleur dans le cœur des autres, car la douleur vaut mieux que rien du tout. Çünkü acı çekmek boşluktan daha iyidir, non ?",shape=box,color=blue];
		973 -> 984;
