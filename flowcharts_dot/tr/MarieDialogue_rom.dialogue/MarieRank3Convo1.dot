		j3173205443 -> j889075205;
	j2516735299 [label="Bu sorunu çözmek için benden istediğini yapacağım. Ve tüm bunlar sona erdiğinde, ancak o zaman onu yargılayacağım.",shape=box,color=red];
		j2516735299 -> j3862572328;
	j781992942 [label="Il inflige la douleur dans le cœur des autres, car la douleur vaut mieux que rien du tout. Çünkü acı çekmek boşluktan daha iyidir, non ?",shape=box,color=blue];
		j781992942 -> j953884456;
