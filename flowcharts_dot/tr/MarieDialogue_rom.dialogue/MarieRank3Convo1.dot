	j1835808211 [label="Oui, haklısın. Sanırım yaptıklarından dolayı suçluluk duygusu onu rahatsız ediyor ve kendini başkalarından kasıtlı olarak uzaklaştırıyor.",shape=box,color=blue];
		j1835808211 -> j781992942;
	j1322314302 [label="Oui, bu korkunç bir keder, korkunç bir acı. Birinin... hâlâ hayatta olduğunu ve görünüşe göre sizin yanınızda olmayı seçmediğini bilmek ?",shape=box,color=blue];
		j1322314302 -> j781992942;
	j3171879249 [label="Mon cœur se brise dans la tragédie - Bunun üzüntüsüyle başa çıkabileceğimi sanmıyorum... ve yine de onu affetmeyecek mi ?",shape=box,color=blue];
		j3171879249 -> j345091367;
		j3171879249 -> j1495185892;
	j2421770130 [label="Neden terk ettiğini biliyor musunuz ?",shape=box,color=blue];
