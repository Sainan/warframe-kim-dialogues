		j1495185892 -> j819512968;
	j449273835 [label="Hayır. Sadece beni orada bıraktığını biliyorum. Void'de terk edilmiş birini gördü ve beni orada bıraktı.",shape=box,color=red];
		j449273835 -> j1624304285;
