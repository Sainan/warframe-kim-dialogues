	"Chat ends." [color=orange];
	j4047891046 [label="Şey... şu büyük başlı konuşan balık da sizin başınızı ağrıtıyor mu ? Fibonacci ?",shape=box,color=blue];
		j4047891046 -> j952102133;
		j4047891046 -> j2560413453;
		j4047891046 -> j2634304013;
	j1760275748 [label="Teşekkür ederim, sağ olun.",shape=box,color=blue];
		j1760275748 -> j4047891046;
	j952102133 [label="Evet. Evet, kesinlikle. Teşekkürler.",shape=box,color=red];
		j952102133 -> j2519509961;
	j2560413453 [label="Fibonacci'ye gıcık olman inanılmaz derecede sevimli.",shape=box,color=red];
		j2560413453 -> j1054660763;
	j2634304013 [label="Hayır. Hatta kendisini severim.",shape=box,color=red];
		j2634304013 -> j2199427466;
	j2519509961 [label="O zaman yalnız olmadığıma sevindim. Ama dürüst olmak gerekirse, bunu ona hakaret etmek için söylemiyorum. Eğer içinde olduğum durum gereği kendimi kötü hissediyorsam, sanırım o da benim gibi elinden gelenin en iyisini yapmaya çalışıyordur.",shape=box,color=blue];
		j2519509961 -> j2128112247;
	j1054660763 [label="Ah ? Nasıl yani ? Sanırım buna sevindim ama nedenini anlayamıyorum. Baş ağrım kesinlikle o kadar da sevimli değil.",shape=box,color=blue];
		j1054660763 -> j4135249457;
		j1054660763 -> j874878745;
	j2199427466 [label="O zaman affınızı diliyorum. Bunu ona hakaret etmek için söylemiyorum. Eğer içinde olduğum durum gereği kendimi kötü hissediyorsam, sanırım o da benim gibi elinden gelenin en iyisini yapmaya çalışıyordur.",shape=box,color=blue];
		j2199427466 -> j4166604659;
	j2128112247 [label="Ama her ne kadar uğraşsa da buna uzun süre maruz kaldığımda düşüncelerim çelişiyor, hepsi bu.",shape=box,color=blue];
		j2128112247 -> j1991217897;
	j4135249457 [label="Zamanımın çoğunu hayatım için mücadele ederek geçiriyorum. Bizi biz yapan insanlığın bu gibi küçük hatırlatıcıları... benim için bir nevi yaşam sebebi.",shape=box,color=red];
		j4135249457 -> j3543598044;
	j874878745 [label="Sanırım ara sıra bir adım geri çekilip her şeyin ne kadar saçma olduğunu düşünmem gerekiyor. Bir Norg, ve bir Sol rahibesi...",shape=box,color=red];
		j874878745 -> j2802303249;
	j4166604659 [label="Ama her ne kadar uğraşsa da buna uzun süre maruz kaldığımda düşüncelerim çelişiyor, hepsi bu.",shape=box,color=blue];
		j4166604659 -> j1991217897;
	j1991217897 [label="Bah. Bu konuda sesimi çıkarmamam gerekirdi. Bu akşam Lyon'a yemeğini götürmeliyim, yine korkunç bir megrim sancısı çekiyor.",shape=box,color=blue];
		j1991217897 -> j4245277669;
		j1991217897 -> j1981702710;
	j3543598044 [label="+5 Chemistry",color=orange];
		j3543598044 -> j2322713216;
	j2802303249 [label="+5 Chemistry",color=orange];
		j2802303249 -> j673912000;
	j4245277669 [label="Bunu sık sık yaşıyor mu?",shape=box,color=red];
		j4245277669 -> j2041530847;
	j1981702710 [label="Anlamadım... ne oldu dedin?",shape=box,color=red];
		j1981702710 -> j4085534094;
	j2322713216 [label="İçindeki o parçayı asla kaybetme, Gezgin. Hayatındaki kıvılcımlarını arayan o parçayı asla bırakma.",shape=box,color=blue];
		j2322713216 -> j468867810;
	j673912000 [label="Aman Tanrım, böyle söyleyince olup bitene şaşmamak gerek. Kulağa sanki çocukça şakalardan birisiymiş gibi geliyor, n'est-ce pas ?",shape=box,color=blue];
		j673912000 -> j2370598158;
	j2041530847 [label="Oui, oui. Belki birkaç haftada bir ? Ya da iki ayda bir ? Bunu yaşamadığı en uzun süre aralığı sanırım altı ay kadardı.",shape=box,color=blue];
		j2041530847 -> j547018639;
	j4085534094 [label="Ah ! Aman Tanrım. Hm. Bir baş ağrısı düşünün, ama çok daha şiddetli. Bazılarının buna 'huysuz baş ağrısı' dediğini duydum. Kadınlarda daha yaygın olan bir tür.",shape=box,color=blue];
		j4085534094 -> j733187560;
		j4085534094 -> j3332376734;
	j468867810 [label="Dünya karanlık ve ciddi bir yer olmaya fazlasıyla hevesli. Her fırsatta bize acı çektirmeye hazır.",shape=box,color=blue];
		j468867810 -> j1548213652;
	j2370598158 [label="Bir Rahibe, bir Rahip ve geleceğe, ardından geçmişe gönderilmiş bir şeytan... ve onları karşılayan bir balık, bir geyik-imsi şey, dev bir kuş, ve bir uşak...",shape=box,color=blue];
		j2370598158 -> j599866606;
	j547018639 [label="Check boolean Megrim",color=orange];
		j547018639 -> j1682874323 [label=true,color=green];
		j547018639 -> j507543659 [label=true,color=green];
		j547018639 -> j1270728074 [label=true,color=green];
		j547018639 -> j1682874323 [label=false,color=brown];
		j547018639 -> j507543659 [label=false,color=brown];
		j547018639 -> j4070711928 [label=false,color=brown];
	j733187560 [label="Sanırım biz bunlara artık \"migren\" diyoruz.",shape=box,color=red];
		j733187560 -> j1131057153;
	j3332376734 [label="Hmm. Megrim yani. Açıkladığın için sağ ol.",shape=box,color=red];
		j3332376734 -> j1594649322;
	j1548213652 [label="Tünelin sonundaki ışığı, mümkün olan her türlü iyiliği aramalıyız, hatta gerekirse çocukça davranmamız gerekse bile.",shape=box,color=blue];
		j1548213652 -> j527031353;
	j599866606 [label="Gerçekten de gülünesi, çok haklısınız !",shape=box,color=blue];
		j599866606 -> j345829098;
	j1682874323 [label="Acaba bunlara ne sebep oluyor?",shape=box,color=red];
		j1682874323 -> j318560893;
	j507543659 [label="Kulağa korkunç geliyor...",shape=box,color=red];
		j507543659 -> j1948148287;
	j1270728074 [label="Megrim benim de başıma geliyor. Bazen çok kötü olabiliyor.",shape=box,color=red];
		j1270728074 -> j3061193616;
	j4070711928 [label="Ben de aynı tür baş ağrıları çekiyorum. Bazen çok kötü olabiliyor.",shape=box,color=red];
		j4070711928 -> j3061193616;
	j1131057153 [label="Başka hangi büyüleyici tarihi ayrıntıları keşfedeceğimizi merak ediyorum ! Heyecan verici. Yeni şeyler öğrenmeyi çok severim. \"Migren.\" Çıktığımız bu yolculuk açıkça görüldüğü üzere çok da uzaklarda değilmiş.",shape=box,color=blue];
		j1131057153 -> j1517279406;
	j1594649322 [label="Boolean Megrim is now true.",color=orange];
		j1594649322 -> j281150245;
	j527031353 [label="Keşke Lyon da aynı şekilde düşünebilseydi.",shape=box,color=blue];
		j527031353 -> j3483406111;
	j345829098 [label="Keşke sevgili Lyon'um da içindeki parlaklığı aynı şekilde görebilseydi.",shape=box,color=blue];
		j345829098 -> j3483406111;
	j318560893 [label="Bu konuda teorileri var. ",shape=box,color=blue];
		j318560893 -> j1925584158;
	j1948148287 [label="Eğer sempatinizi onunla paylaşmak isterseniz eminim ki bunu hoş karşılayacaktır. Ve nasıl görünürse görünsün, arkadaşlığınızdan memnun kalacaktır.",shape=box,color=blue];
		j1948148287 -> j288026158;
	j3061193616 [label="Gerçekten mi ? Bunu Lyon'a söylemelisiniz. Başkalarının da benzer şekilde acı çekebileceğini bilmesi gerek.",shape=box,color=blue];
		j3061193616 -> j1399874499;
	j1517279406 [label="Boolean Migraine is now true.",color=orange];
		j1517279406 -> j281150245;
	j281150245 [label="Adı ne olursa olsun, yaşadığı bir ağrı Lyon'u perişan etti ve muhtemelen sabaha kadar da öyle kalacak. Zavallı adam, bulanık bir görüntüden başka hiç bir şey göremiyor, ellerini ve ayaklarını hissedemiyor. Ve bana acının dayanılmaz olduğunu söylüyor.",shape=box,color=blue];
		j281150245 -> j547018639;
	j3483406111 [label="Boolean MarieLyonSuffering1 is now true.",color=orange];
		j3483406111 -> j1987744375;
	j1925584158 [label="Gerçi, 'son zamanlara kadar onun da teorileri vardı' demek daha doğru olabilir.",shape=box,color=blue];
		j1925584158 -> j1381706548;
	j288026158 [label="Davranışları caydırıcı görünse de, güçlü durmanızı rica ediyorum Gezgin. Soğuk ve taş gibi görünen dış görünüşünün ardında yardıma muhtaç birisi yatıyor.",shape=box,color=blue];
		j288026158 -> j2981962656;
		j288026158 -> j1007638299;
		j288026158 -> j1059311328;
	j1399874499 [label="+5 Chemistry",color=orange];
		j1399874499 -> j894979590;
	j1987744375 [label="Ah, bu arada. Baş ağrılarından şikayetçi olduğum için kendimi çok kötü hissediyorum. Bu akşam Lyon'a yemeğini götürmeliyim, yine korkunç bir megrim sancısı çekiyor.",shape=box,color=blue];
		j1987744375 -> j1981702710;
		j1987744375 -> j4245277669;
	j1381706548 [label="Boolean MarieLyonFaith1 is now true.",color=orange];
		j1381706548 -> j288026158;
	j2981962656 [label="Aşırı inatçı birisi olabilirim. Merak etme.",shape=box,color=red];
		j2981962656 -> j3164365222;
	j1007638299 [label="Zaten Duvardaki Adam'a aşinayım... ikincisi sorun olmaz.",shape=box,color=red];
		j1007638299 -> j41611273;
	j1059311328 [label="O artık yetişkin bir adam. Eğer konuşmak isterse konuşur.",shape=box,color=red];
		j1059311328 -> j309419359;
	j894979590 [label="Aydınlık gerçeği biliyor, ancak konuşacak birisi olmazsa bu acıyı çeken tek kişi olduğuna inanacak...",shape=box,color=blue];
		j894979590 -> j1984798988;
	j3164365222 [label="+5 Chemistry",color=orange];
		j3164365222 -> j476061488;
	j41611273 [label="Benimle böyle şakalaşabilirsiniz, ama ona sakın böyle sözler söylemeyin. Sizin bildiğiniz Kayıtsızlık onun için oldukça hassas bir konu.",shape=box,color=blue];
		j41611273 -> j3399032433;
	j309419359 [label="Yetişkin, evet. Artık olgun birisi, doğru. Yine de konuşmak istediğine inanıyorum. Ama konuşup konuşamayacağınızı sormak ne kadar doğru olacaktır ?",shape=box,color=blue];
		j309419359 -> j4056873775;
	j1984798988 [label="Boolean MarieLyonSuffering2 is now true.",color=orange];
		j1984798988 -> j288026158;
	j476061488 [label="Korkarım bu konuda inatçılığınızı sergilemeniz gerekecek. Teşekkür ederim Gezgin. O benim en yakın arkadaşım ve kardeşim gibi. Onu böylesine acı içinde görmek yüreğimi parçalıyor.",shape=box,color=blue];
		j476061488 -> j744705997;
	j3399032433 [label="Kararlı, sabırlı, ve nazik olun. O benim için bir kardeş gibidir ve en yakın arkadaşımdır, Gezgin. Onu böylesine acı içinde görmek yüreğimi parçalıyor.",shape=box,color=blue];
		j3399032433 -> j744705997;
	j4056873775 [label="Hepimiz aynı ayrıcalıklara sahip değiliz, ve buna hakkımız olduğunu da düşünmüyoruz. O acı çekiyor ve bu acıyı kaderinin bir parçası olarak görüyor.",shape=box,color=blue];
		j4056873775 -> j2409971254;
	j744705997 [label="Yakında tekrar konuşuruz. Par la grâce de Sol.",shape=box,color=blue];
		j744705997 -> "Initiate conversation LyonHeadaches in /Lotus/Types/Gameplay/1999Wf/Dialogue/LyonDialogue_rom.dialogue";
	j2409971254 [label="O benim kardeşim gibidir ve en yakın arkadaşımdır. Onu bu halde görünce kalbim paramparça oluyor. Bu yüzden sizden tek isteğim... elinizden geldiğince sabırlı ve nazik olmanızdır.",shape=box,color=blue];
		j2409971254 -> j744705997;
	"Initiate conversation LyonHeadaches in /Lotus/Types/Gameplay/1999Wf/Dialogue/LyonDialogue_rom.dialogue" [label="Initiate conversation LyonHeadaches in /Lotus/Types/Gameplay/1999Wf/Dialogue/LyonDialogue_rom.dialogue",color=orange];
