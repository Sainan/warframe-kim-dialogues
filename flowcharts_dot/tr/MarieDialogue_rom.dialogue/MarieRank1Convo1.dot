		j1137868283 -> j2076313645;
	j3634807214 [label="Bence bu sefer daha ölümcül. Bizi öldürmeye çalışan ne kadar güçlü düşmanlarımız var, değil mi?",shape=box,color=red];
		j3634807214 -> j2630197873;
	j1358904116 [label="Şimdiki zamanın daha az tehlikeli olduğuna inanıyorum. Onlar sadece birbirlerini öldürmenin yeni yollarını keşfediyorlar. Bizim yöntemlerimiz belki de biraz daha heyecan verici görünüyor.",shape=box,color=red];
