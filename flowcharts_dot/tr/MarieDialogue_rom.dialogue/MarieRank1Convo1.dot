		j13927320 -> j2113004400;
	j4110102477 [label="Ah ! İşte tanıdığım bir saatin sesi, ama o lanet şeyin nerede olduğunu hâlâ bulamıyorum. Kusura bakmayın ama çıkmam gerek. Bu oldukça keyifliydi. Tekrar \"buluşana\" kadar ! Aux Dieux !",shape=box,color=blue];
