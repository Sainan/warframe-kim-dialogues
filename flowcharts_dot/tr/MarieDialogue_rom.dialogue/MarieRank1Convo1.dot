digraph {
	0 [label="MarieRank1Convo1 begins.",color=orange];
		0 -> 1;
	1 [label="Bonjour, bonjour, Gezgin! Bu güzel günde nasılsınız acaba ? Veya akşamda. Burada saatin kaç olduğunu gerçekten anlayamıyorum.",shape=box,color=blue];
		1 -> 2;
	2 [label="Mösyö Loid'in etraftaki biblolarından birinin saat olduğuna eminim, ama hangisi olduğunu bir türlü çıkaramıyorum.",shape=box,color=blue];
		2 -> 3;
	3 [label="Bu tuhaf sığınaktaki cihazlara dokunmaktan korkuyorum. Kendimi uzak bir zamana ışınlama olasılığımın bir fincan çay demlemekten daha yüksek olduğunu düşünüyorum.",shape=box,color=blue];
		3 -> 5;
		3 -> 6;
		3 -> 4;
	5 [label="Emin olmadığın hiçbir tuşa basmaman en doğrusu olacaktır. ",shape=box,color=red];
		5 -> 8;
	6 [label="Bir sıkıntı yaşamayacağına eminim.",shape=box,color=red];
		6 -> 9;
	4 [label="[Son.]",shape=box,color=red];
		4 -> 7;
	8 [label="Gerçekten çok iyi bir tavsiye. Mösyö Loid'den sizin de bir aventure temporelle macerası yaşadığınızı duydum. Merak ediyorum da -",shape=box,color=blue];
		8 -> 10;
	9 [label="C'est très gentil de votre part, ama... bambaşka bir yere fırlatılan siz değilsiniz... ah. Gerçi. Doğru !",shape=box,color=blue];
		9 -> 11;
	7 [label="Chat ends.",color=orange];
	10 [label="Acaba şimdiki kadar tehlikeli miydi ?",shape=box,color=blue];
		10 -> 12;
		10 -> 13;
	11 [label="Bunu siz daha iyi bilirsiniz değil mi. Beni bağışlayın. Kişisel maceranız da bu kadar tehlikeli miydi ?",shape=box,color=blue];
		11 -> 12;
		11 -> 13;
	12 [label="O zaman dilimi mi? Yoksa orada geçirdiğim zaman mı?",shape=box,color=red];
		12 -> 14;
	13 [label="Farklıydı ama burada güvende olduğuna söz veriyorum.",shape=box,color=red];
		13 -> 15;
	14 [label="+10 Chemistry",color=orange];
		14 -> 16;
	15 [label="Güven oyunuz için çok teşekkür ederim, ancak ben sizinle aynı fikirde değilim. Özellikle de zamanı kavramakta bu kadar zorlanırken.",shape=box,color=blue];
		15 -> 17;
	16 [label="Bu ayrımı yapmanız güzel. Geçmişle ilgili deneyiminizin genel standartlara göre \"normal\" olup olmadığından emin değilim. Anlatılanlara göre, umarım öyle değildir.",shape=box,color=blue];
		16 -> 18;
	17 [label="Burada, bu... \"ekranın\" köşesinde bir tane olmasını beklersiniz, ama yok ! Bana sorarsanız bu mauvaise qualité.",shape=box,color=blue];
		17 -> 19;
	18 [label="\"Zaman dilimi\"nin kendisinden bahsediyordum. Tekrar ifade etmem gerekirse -",shape=box,color=blue];
		18 -> 20;
	19 [label="Neyse, sorumdan epey uzaklaştık !",shape=box,color=blue];
		19 -> 20;
	20 [label="Benim geldiğim \"daha uzak geçmişe\" daha yakın olan şu seyahat ettiğiniz \"geçmiş\" mi tehlikeliydi; yoksa, şu anda içinde bulunduğumuz zaman mı görece daha çok tehlikeli ?",shape=box,color=blue];
		20 -> 21;
	21 [label="(Aman Tanrım ! Bunu çok sevdim, hatta kutsal kaselerin tozunu almaktan bile daha ilginç olduğunu söylemeliyim.)",shape=box,color=blue];
		21 -> 22;
		21 -> 23;
		21 -> 24;
		21 -> 25;
	22 [label="Bence ikisi de aynı düzeyde. Silahlar farklı ve henüz neyle karşı karşıya olduklarını bilmiyor olabilirler, ama savaş savaştır ve ölüm ölümdür.",shape=box,color=red];
		22 -> 26;
	23 [label="Bu zaman daha az tehlikeli. Karşılaştığımız zorluklarla başa çıkma becerimiz daha fazla. Daha yeni başlıyorlar.",shape=box,color=red];
		23 -> 27;
	24 [label="Bence bu zaman daha tehlikeli. Infested ortak düşmanımız olsa da, onlar önceden çok daha ilkel silahlarla savaşıyorlardı.",shape=box,color=red];
		24 -> 27;
	25 [label="Açıkçası, keyif almana sevindim. Her şeye aynı anda uyum sağlamak zor olabilir.",shape=box,color=red];
		25 -> 28;
	26 [label="+5 Chemistry",color=orange];
		26 -> 29;
	27 [label="Haklı olabilirsiniz. Bunu dikkate alacağım. Teşekkürler.",shape=box,color=blue];
		27 -> 30;
	28 [label="+5 Chemistry",color=orange];
		28 -> 31;
	29 [label="Her şey gibi, sanırım bu da göreceli bir konu, non ? Şimdi bizi öldüren avcı, o zamanlar peşimizde olan kadar ölümcül. Sadece dişlerini keskinleştirmiş.",shape=box,color=blue];
		29 -> 32;
		29 -> 33;
	30 [label="Chat ends.",color=orange];
	31 [label="Le Cardinal Dimanche - sizin Albrecht Entrati'niz - beni buna hazırlamıştı. Sevgili Lyon'umun aksine, onun sözlerini gerçek olarak ele aldım. Ve Lyon'un aksine, bunu bir yük olarak değil, büyük bir macera olarak görüyorum.",shape=box,color=blue];
		31 -> 34;
	32 [label="Teoride olmasa da pratikte ölümden kaçınmanın bir yolunu bulan Orokin değilsen, farklı tabii.",shape=box,color=red];
		32 -> 35;
	33 [label="Geleceğe iyi uyum sağlamana da sevindim.",shape=box,color=red];
		33 -> 36;
	34 [label="Aydınlığa hizmet etmek, acı çekmek anlamına gelmez. Bu konuda her zaman farklıydık.",shape=box,color=blue];
		34 -> 37;
	35 [label="Ve bence şeytan, Lua’nın bize verdiği en büyük armağanın neden ölüm olduğunu en iyi şekilde gösteren örnektir.",shape=box,color=blue];
		35 -> 38;
	36 [label="+5 Chemistry",color=orange];
		36 -> 39;
	37 [label="Update boolean MarieLyonSuffering1",color=orange];
		37 -> 40;
	38 [label="Update boolean MarieRoathe1",color=orange];
		38 -> 41;
	39 [label="Le Cardinal Dimanche - sizin Albrecht Entrati'niz - beni buna hazırlamıştı. Sevgili Lyon'umun aksine, onun sözlerini gerçek olarak ele aldım. Ve Lyon'un aksine, bunu bir yük olarak değil, büyük bir macera olarak görüyorum.",shape=box,color=blue];
		39 -> 42;
	40 [label="Ve lütfen şapşallık yapıp da sorumu atlamaya çalışmayın ! Sizce hangisi daha tehlikeli ?",shape=box,color=blue];
		40 -> 43;
		40 -> 44;
		40 -> 45;
	41 [label="Ah ! İşte tanıdığım bir saatin sesi, ama o lanet şeyin nerede olduğunu hâlâ bulamıyorum. Kusura bakmayın ama çıkmam gerek. Bu oldukça keyifliydi. Tekrar \"buluşana\" kadar ! Aux Dieux !",shape=box,color=blue];
		41 -> 46;
	42 [label="Aydınlığa hizmet etmek, acı çekmek anlamına gelmez. Bu konuda her zaman farklıydık.",shape=box,color=blue];
		42 -> 47;
	43 [label="Bence bu sefer daha ölümcül. Bizi öldürmeye çalışan ne kadar güçlü düşmanlarımız var, değil mi?",shape=box,color=red];
		43 -> 48;
	44 [label="Şimdiki zamanın daha az tehlikeli olduğuna inanıyorum. Onlar sadece birbirlerini öldürmenin yeni yollarını keşfediyorlar. Bizim yöntemlerimiz belki de biraz daha heyecan verici görünüyor.",shape=box,color=red];
		44 -> 48;
	45 [label="Sanırım sonunda hepsi aynı anlama geliyor. Ölüm ölümdür, değil mi?",shape=box,color=red];
		45 -> 49;
	46 [label="Chat ends.",color=orange];
	47 [label="Update boolean MarieLyonSuffering1",color=orange];
		47 -> 41;
	48 [label="Haklı olabilirsiniz. Bunu dikkate alacağım. Teşekkürler.",shape=box,color=blue];
		48 -> 50;
	49 [label="+5 Chemistry",color=orange];
		49 -> 51;
	50 [label="Chat ends.",color=orange];
	51 [label="Her şey gibi, sanırım bu da göreceli bir konu, non ? Şimdi bizi öldüren avcı, o zamanlar peşimizdekiler kadar ölümcül. Sadece dişlerini keskinleştirmiş.",shape=box,color=blue];
		51 -> 52;
		51 -> 53;
	52 [label="Kurta karşı kendini savunmaya çalışan biri olarak, çoğu zaman kendimi bu durumdan yılmış hissediyorum.",shape=box,color=red];
		52 -> 54;
	53 [label="Teoride olmasa da pratikte ölümden kaçınmanın bir yolunu bulan Orokin değilsen, orası ayrı tabii.",shape=box,color=red];
		53 -> 55;
	54 [label="Sevgili Gezgin, bence kurt sürüsüne karşı nöbet tutmaktansa koşup onlara katılmayı tercih edeceğini düşünüyorum. Bunu bir iltifat olarak söylüyorum.",shape=box,color=blue];
		54 -> 41;
	55 [label="Ve bence şeytan, Lua’nın bize verdiği en büyük armağanın neden ölüm olduğunu en iyi şekilde gösteren örnektir.",shape=box,color=blue];
		55 -> 56;
	56 [label="Update boolean MarieRoathe1",color=orange];
		56 -> 41;
}