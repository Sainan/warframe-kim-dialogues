		j106502847 -> j1137868283;
	j13927320 [label="Ve lütfen şapşallık yapıp da sorumu atlamaya çalışmayın ! Sizce hangisi daha tehlikeli ?",shape=box,color=blue];
		j13927320 -> j3634807214;
