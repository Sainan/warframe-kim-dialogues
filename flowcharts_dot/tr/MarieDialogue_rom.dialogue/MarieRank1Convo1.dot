	"MarieRank1Convo1 begins." [color=orange];
		"MarieRank1Convo1 begins." -> j3295087359;
	j3295087359 [label="Bonjour, bonjour, Gezgin! Bu güzel günde nasılsınız acaba ? Veya akşamda. Burada saatin kaç olduğunu gerçekten anlayamıyorum.",shape=box,color=blue];
		j3295087359 -> j4190419076;
	j4190419076 [label="Mösyö Loid'in etraftaki biblolarından birinin saat olduğuna eminim, ama hangisi olduğunu bir türlü çıkaramıyorum.",shape=box,color=blue];
		j4190419076 -> j384418451;
	j384418451 [label="Bu tuhaf sığınaktaki cihazlara dokunmaktan korkuyorum. Kendimi uzak bir zamana ışınlama olasılığımın bir fincan çay demlemekten daha yüksek olduğunu düşünüyorum.",shape=box,color=blue];
		j384418451 -> j1221604633;
		j384418451 -> j613378507;
		j384418451 -> j2025973576;
	j1221604633 [label="Emin olmadığın hiçbir tuşa basmaman en doğrusu olacaktır. ",shape=box,color=red];
		j1221604633 -> j3531269008;
	j613378507 [label="Bir sıkıntı yaşamayacağına eminim.",shape=box,color=red];
		j613378507 -> j3768081481;
	j2025973576 [label="[Son.]",shape=box,color=red];
		j2025973576 -> "Chat ends.";
	j3531269008 [label="Gerçekten çok iyi bir tavsiye. Mösyö Loid'den sizin de bir aventure temporelle macerası yaşadığınızı duydum. Merak ediyorum da -",shape=box,color=blue];
		j3531269008 -> j512214844;
	j3768081481 [label="C'est très gentil de votre part, ama... bambaşka bir yere fırlatılan siz değilsiniz... ah. Gerçi. Doğru !",shape=box,color=blue];
		j3768081481 -> j2529096527;
	"Chat ends." [color=orange];
	j512214844 [label="Acaba şimdiki kadar tehlikeli miydi ?",shape=box,color=blue];
		j512214844 -> j2382431338;
		j512214844 -> j2425492469;
	j2529096527 [label="Bunu siz daha iyi bilirsiniz değil mi. Beni bağışlayın. Kişisel maceranız da bu kadar tehlikeli miydi ?",shape=box,color=blue];
		j2529096527 -> j2382431338;
		j2529096527 -> j2425492469;
	j2382431338 [label="O zaman dilimi mi? Yoksa orada geçirdiğim zaman mı?",shape=box,color=red];
		j2382431338 -> j359005309;
	j2425492469 [label="Farklıydı ama burada güvende olduğuna söz veriyorum.",shape=box,color=red];
		j2425492469 -> j3357447046;
	j359005309 [label="+10 Chemistry",color=orange];
		j359005309 -> j3411609368;
	j3357447046 [label="Güven oyunuz için çok teşekkür ederim, ancak ben sizinle aynı fikirde değilim. Özellikle de zamanı kavramakta bu kadar zorlanırken.",shape=box,color=blue];
		j3357447046 -> j4000640450;
	j3411609368 [label="Bu ayrımı yapmanız güzel. Geçmişle ilgili deneyiminizin genel standartlara göre \"normal\" olup olmadığından emin değilim. Anlatılanlara göre, umarım öyle değildir.",shape=box,color=blue];
		j3411609368 -> j3494268543;
	j4000640450 [label="Burada, bu... \"ekranın\" köşesinde bir tane olmasını beklersiniz, ama yok ! Bana sorarsanız bu mauvaise qualité.",shape=box,color=blue];
		j4000640450 -> j3224950655;
	j3494268543 [label="\"Zaman dilimi\"nin kendisinden bahsediyordum. Tekrar ifade etmem gerekirse -",shape=box,color=blue];
		j3494268543 -> j3515927471;
	j3224950655 [label="Neyse, sorumdan epey uzaklaştık !",shape=box,color=blue];
		j3224950655 -> j3515927471;
	j3515927471 [label="Benim geldiğim \"daha uzak geçmişe\" daha yakın olan şu seyahat ettiğiniz \"geçmiş\" mi tehlikeliydi; yoksa, şu anda içinde bulunduğumuz zaman mı görece daha çok tehlikeli ?",shape=box,color=blue];
		j3515927471 -> j795517845;
	j795517845 [label="(Aman Tanrım ! Bunu çok sevdim, hatta kutsal kaselerin tozunu almaktan bile daha ilginç olduğunu söylemeliyim.)",shape=box,color=blue];
		j795517845 -> j1985511111;
		j795517845 -> j311507640;
		j795517845 -> j105574147;
		j795517845 -> j4256262158;
	j1985511111 [label="Bence ikisi de aynı düzeyde. Silahlar farklı ve henüz neyle karşı karşıya olduklarını bilmiyor olabilirler, ama savaş savaştır ve ölüm ölümdür.",shape=box,color=red];
		j1985511111 -> j963040182;
	j311507640 [label="Bu zaman daha az tehlikeli. Karşılaştığımız zorluklarla başa çıkma becerimiz daha fazla. Daha yeni başlıyorlar.",shape=box,color=red];
		j311507640 -> j2630197873;
	j105574147 [label="Bence bu zaman daha tehlikeli. Infested ortak düşmanımız olsa da, onlar önceden çok daha ilkel silahlarla savaşıyorlardı.",shape=box,color=red];
		j105574147 -> j2630197873;
	j4256262158 [label="Açıkçası, keyif almana sevindim. Her şeye aynı anda uyum sağlamak zor olabilir.",shape=box,color=red];
		j4256262158 -> j3148924521;
	j963040182 [label="+5 Chemistry",color=orange];
		j963040182 -> j31956679;
	j2630197873 [label="Haklı olabilirsiniz. Bunu dikkate alacağım. Teşekkürler.",shape=box,color=blue];
		j2630197873 -> "Chat ends.";
	j3148924521 [label="+5 Chemistry",color=orange];
		j3148924521 -> j3994814741;
	j31956679 [label="Her şey gibi, sanırım bu da göreceli bir konu, non ? Şimdi bizi öldüren avcı, o zamanlar peşimizde olan kadar ölümcül. Sadece dişlerini keskinleştirmiş.",shape=box,color=blue];
		j31956679 -> j4078619321;
		j31956679 -> j1652236586;
	j3994814741 [label="Le Cardinal Dimanche - sizin Albrecht Entrati'niz - beni buna hazırlamıştı. Sevgili Lyon'umun aksine, onun sözlerini gerçek olarak ele aldım. Ve Lyon'un aksine, bunu bir yük olarak değil, büyük bir macera olarak görüyorum.",shape=box,color=blue];
		j3994814741 -> j300218404;
	j4078619321 [label="Teoride olmasa da pratikte ölümden kaçınmanın bir yolunu bulan Orokin değilsen, farklı tabii.",shape=box,color=red];
		j4078619321 -> j2905534812;
