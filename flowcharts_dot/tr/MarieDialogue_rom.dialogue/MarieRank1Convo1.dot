		j300218404 -> j3426718155;
	j2905534812 [label="Ve bence şeytan, Lua'nın bize verdiği en büyük armağanın neden ölüm olduğunu en iyi şekilde gösteren örnektir.",shape=box,color=blue];
		j2905534812 -> j983814619;
