		j2780940043 -> j1057726496;
	j2316908382 [label="Sonunda tanıştığına sevindim. Otak'ı anlatmak biraz zor olabiliyor.",shape=box,color=red];
		j2316908382 -> j2714163041;
	j4287194768 [label="Otak ile tanıştın mı? Vay canına... Nasıl geçti?",shape=box,color=red];
		j4287194768 -> j2260671198;
	j2432045186 [label="Evet keyifliydi. Belki de bunun için ağlamak istiyordum. Çünkü aynı konuşmada kendini bana üç kez tanıttı, sanki hiç tanışmamışız gibi.",shape=box,color=blue];
		j2432045186 -> j541205121;
	j2580530129 [label="Aynı konuşma sırasında bana üç kez kendini tanıttı, sanki daha önce hiç tanışmamışız gibi.",shape=box,color=blue];
		j2580530129 -> j541205121;
	j1057726496 [label="Onu son derece tatlı ve çekici buldum ! Ama bir mizah katmanının altında, büyük bir kalp kırıklığı hissettim.",shape=box,color=blue];
		j1057726496 -> j557185827;
	j2714163041 [label="Evet, tahmin edebiliyorum. Otomatın arkasına yazılmış bir çocuk karalaması gibi. Onu son derece sevimli ve çekici buldum !",shape=box,color=blue];
		j2714163041 -> j2723601645;
	j2260671198 [label="Onunla tanışmamdan hoşnut olmadınız mı ?",shape=box,color=blue];
		j2260671198 -> j2194677403;
		j2260671198 -> j737467238;
		j2260671198 -> j2421399846;
	j541205121 [label="Beni daha önceki seferlerde olduğu gibi aynı kararlı ve neşeli tavırla karşıladı. Ama beni bir Sœur de Sol olarak biliyordu ! ",shape=box,color=blue];
		j541205121 -> j1903829410;
	j557185827 [label="Bana zavallı Mösyö Otak'ın hikayesini anlatır mısınız ?",shape=box,color=blue];
		j557185827 -> j965198168;
	j2723601645 [label="Ama mizahının altında büyük bir kalp acısı taşıyor.",shape=box,color=blue];
		j2723601645 -> j557185827;
	j2194677403 [label="Bazen sinirlerime dokunabiliyor, hepsi bu. ",shape=box,color=red];
		j2194677403 -> j3278124674;
	j737467238 [label="Öyle demek istemedim. Bazı insanlar için biraz... itici olabilir.",shape=box,color=red];
		j737467238 -> j2448803195;
	j2421399846 [label="Üzgünüm. Bazen insanların sinirlerini bozabiliyor. Bu onun suçu değil.",shape=box,color=red];
		j2421399846 -> j2448803195;
	j1903829410 [label="Aslında, Aydınlık'ı çok iyi tanıyordu ! ''Eski dinler'' olarak adlandırdığı, ''Orokin İmparatorluğu'ndan önceki dönem'' hakkında uzun uzun konuştuk.",shape=box,color=blue];
		j1903829410 -> j905042824;
	j965198168 [label="Otak eski Arşimetçi, bir Orokin bilim insanı ve akademisyendi. Başına gelenler pek de mutlu bir hikaye sayılmaz.",shape=box,color=red];
		j965198168 -> j2218117175;
	j3278124674 [label="Umarım dertleri olan birine karşı daha şefkatli davranırsınız. Mais par la grâce de Sol, yolumuzu aydınlat.",shape=box,color=blue];
		j3278124674 -> j4091996739;
	j2448803195 [label="Ve umarım ona şefkat ve sabır gösterirler. Mais par la grâce de Sol, yolumuzu aydınlat.",shape=box,color=blue];
		j2448803195 -> j4091996739;
	j905042824 [label="Ancak, bu bilginin büyük bir kısmının artık kaybolduğunu, arşivlerin derinliklerinde gömülü olduğunu ve resmi olarak yasaklandığını söyledi. Bana gizlilik yemini ettirdi.",shape=box,color=blue];
		j905042824 -> j7485657;
	j2218117175 [label="Genel kanı, onun bir dahi olduğu ve argon kristallerinin işlenmesinin arkasındaki beyin olduğu yönündeydi.",shape=box,color=red];
		j2218117175 -> j2192108570;
	j4091996739 [label="Böyle bir kader hepimizi bekliyor olabilir. Sizi bile.",shape=box,color=blue];
		j4091996739 -> j933469641;
		j4091996739 -> j3989781222;
	j7485657 [label="Bana, İnfazcı Ballas'ın - o kimse - benim sapkın mezhebimi keşfedip beni idam ettireceğinden ciddi olarak korktuğunu söyledi.",shape=box,color=blue];
		j7485657 -> j2898329729;
		j7485657 -> j1986779402;
	j2192108570 [label="Void'den çıkarılanlar ile - güçlü warframe'leri ve silahların çoğunu yaratabilmemizi sağlıyor.",shape=box,color=red];
		j2192108570 -> j1567812586;
