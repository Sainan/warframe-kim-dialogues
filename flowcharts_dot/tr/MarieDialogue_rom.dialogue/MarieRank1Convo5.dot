digraph {
	3964 [label="MarieRank1Convo5 begins.",color=orange];
		3964 -> 3965;
	3965 [label="Bonjour, bonjour ! Siz Gezgin olmalısınız, oui ? Mösyö Loid bana sizden çok bahsetti. Sizi bu şekilde ''tanımaktan'' gerçekten çok mutluyum...",shape=box,color=blue];
		3965 -> 3966;
	3966 [label="Zekice olsa da, un appareil cliquetant !",shape=box,color=blue];
		3966 -> 3967;
	3967 [label="Ben Sœur Marie Leroux, ama siz bana Marie diyebilirsiniz. Yakın zamanda ruh ikizim Peder Lyon Allard ile buraya geldim ve... sanırım Mösyö Loid sizi şeytan konusunda uyarmış olabilir, n'est-ce pas ?",shape=box,color=blue];
		3967 -> 3968;
		3967 -> 3969;
		3967 -> 3970;
	3968 [label="Sizinle tanıştığıma memnun oldum. Lütfen yanlış anlama, buraya hoş geldiniz, ama... burada ne yapıyorsunuz?",shape=box,color=red];
		3968 -> 3972;
	3969 [label="Şeytan mı? Orokin'den mi bahsediyorsun?",shape=box,color=red];
		3969 -> 3974;
	3970 [label="[Son.]",shape=box,color=red];
		3970 -> 3971;
	3972 [label="+5 Chemistry",color=orange];
		3972 -> 3973;
	3974 [label="Oui, le Cardinal'in bize emanet ettiği, monstre irritant à la peau bleue. Sanırım onu Albrecht Entrati olarak tanıyorsunuz. O, bizim burada olmamızın sebebi. Ama bu çok uzun bir hikaye, j'en ai bien peur.",shape=box,color=blue];
		3974 -> 3975;
		3974 -> 3976;
	3971 [label="Chat ends.",color=orange];
	3973 [label="Merci ! The what and the how of our being here is a very long story, j'en ai bien peur. We were sent here by le Cardinal. I believe you know him as Albrecht Entrati ? He entrusted us with that blue-skinned monstre irritant.",shape=box,color=blue];
		3973 -> 3975;
		3973 -> 3976;
	3975 [label="Yardımcı olmak için elimden geleni yapacağım.",shape=box,color=red];
		3975 -> 3980;
	3976 [label="\"Emanet ettiği mi?\"",shape=box,color=red];
		3976 -> 3977;
	3980 [label="+5 Chemistry",color=orange];
		3980 -> 3981;
	3977 [label="Mümkünse, onun ruhuna rehberlik etmek için elimizden geleni yapmalıyız. Et si ce n'est pas le cas ? O zaman en azından daha fazla zarar vermemesini sağlamalıyız.",shape=box,color=blue];
		3977 -> 3978;
		3977 -> 3979;
	3981 [label="Tıpkı Mösyö Loid ve Cavia'nın anlattığı gibisiniz ! Sanırım iyi arkadaş olacağız.",shape=box,color=blue];
		3981 -> 3983;
	3978 [label="Denemenize yardımcı olmaya hazırım.",shape=box,color=red];
		3978 -> 3980;
	3979 [label="O Orokin soyundan. Bunu yapmanın tek yolu, kaşlarının arasına bir kurşun sıkmak.",shape=box,color=red];
		3979 -> 3982;
	3983 [label="Ah ! Gitmeliyim, beni affedin. Umarım yakında tekrar konuşuruz ! À la revoyure !",shape=box,color=blue];
		3983 -> 3984;
	3982 [label="Lyon gibi konuşuyorsunuz. Ama umudumu kaybetmiyorum. Henüz değil.",shape=box,color=blue];
		3982 -> 3983;
	3984 [label="Chat ends.",color=orange];
}