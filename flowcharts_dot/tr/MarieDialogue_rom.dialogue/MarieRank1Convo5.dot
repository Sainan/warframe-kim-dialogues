digraph {
	graph [fontname="Roboto Condensed"];
	node [fontname="Roboto Condensed"];
	edge [fontname="Roboto Condensed"];

	"MarieRank1Convo5 begins." [color=orange];
		"MarieRank1Convo5 begins." -> j4183064137;
	j4183064137 [label="Bonjour, bonjour ! Siz Gezgin olmalısınız, oui ? Mösyö Loid bana sizden çok bahsetti. Sizi bu şekilde ''tanımaktan'' gerçekten çok mutluyum...",shape=box,color=blue];
		j4183064137 -> j1966333130;
	j1966333130 [label="Zekice olsa da, un appareil cliquetant !",shape=box,color=blue];
		j1966333130 -> j524035645;
	j524035645 [label="Ben Sœur Marie Leroux, ama siz bana Marie diyebilirsiniz. Yakın zamanda ruh ikizim Peder Lyon Allard ile buraya geldim ve... sanırım Mösyö Loid sizi şeytan konusunda uyarmış olabilir, n'est-ce pas ?",shape=box,color=blue];
		j524035645 -> j3282764130;
		j524035645 -> j2380435494;
		j524035645 -> j2025973576;
	j3282764130 [label="Sizinle tanıştığıma memnun oldum. Lütfen yanlış anlama, buraya hoş geldiniz, ama... burada ne yapıyorsunuz?",shape=box,color=red];
		j3282764130 -> j465779370;
	j2380435494 [label="Şeytan mı? Orokin'den mi bahsediyorsun?",shape=box,color=red];
		j2380435494 -> j2436397407;
	j2025973576 [label="[Son.]",shape=box,color=red];
		j2025973576 -> "Chat ends.";
	j465779370 [label="+5 Chemistry",color=orange];
		j465779370 -> j733158097;
	j2436397407 [label="Oui, le Cardinal'in bize emanet ettiği, monstre irritant à la peau bleue. Sanırım onu Albrecht Entrati olarak tanıyorsunuz. O, bizim burada olmamızın sebebi. Ama bu çok uzun bir hikaye, j'en ai bien peur.",shape=box,color=blue];
		j2436397407 -> j1005666632;
		j2436397407 -> j3801180256;
	"Chat ends." [color=orange];
	j733158097 [label="Merci ! Burada olmamızın nasıl ve neden olduğu çok uzun bir hikaye, j'en ai bien peur. Bizi buraya le Cardinal gönderdi. Sanırım onu Albrecht Entrati olarak tanıyorsunuz. Bize o mavi tenli, monstre irritant emanet etti.",shape=box,color=blue];
		j733158097 -> j1005666632;
		j733158097 -> j3801180256;
	j1005666632 [label="Yardımcı olmak için elimden geleni yapacağım.",shape=box,color=red];
		j1005666632 -> j4206336657;
	j3801180256 [label="\"Emanet ettiği mi?\"",shape=box,color=red];
		j3801180256 -> j440547036;
	j4206336657 [label="+5 Chemistry",color=orange];
		j4206336657 -> j3246019256;
	j440547036 [label="Mümkünse, onun ruhuna rehberlik etmek için elimizden geleni yapmalıyız. Et si ce n'est pas le cas ? O zaman en azından daha fazla zarar vermemesini sağlamalıyız.",shape=box,color=blue];
		j440547036 -> j2433201200;
		j440547036 -> j2338635708;
	j3246019256 [label="Tıpkı Mösyö Loid ve Cavia'nın anlattığı gibisiniz ! Sanırım iyi arkadaş olacağız.",shape=box,color=blue];
		j3246019256 -> j4178797788;
	j2433201200 [label="Denemenize yardımcı olmaya hazırım.",shape=box,color=red];
		j2433201200 -> j4206336657;
	j2338635708 [label="O Orokin soyundan. Bunu yapmanın tek yolu, kaşlarının arasına bir kurşun sıkmak.",shape=box,color=red];
		j2338635708 -> j2798698503;
	j4178797788 [label="Ah ! Gitmeliyim, beni affedin. Umarım yakında tekrar konuşuruz ! À la revoyure !",shape=box,color=blue];
		j4178797788 -> "Chat ends.";
	j2798698503 [label="Lyon gibi konuşuyorsunuz. Ama umudumu kaybetmiyorum. Henüz değil.",shape=box,color=blue];
		j2798698503 -> j4178797788;
}