	3657 [label="Bu arada Lyon ile konuşacağım, ama pek umudum yok.",shape=box,color=blue];
		3657 -> 3666;
	3656 [label="+20 Chemistry",color=orange];
		3656 -> 3665;
	3654 [label="En azından yardım edecektir. Ve ben de onun tehditlerini gerçekleştirmesine izin vermeyeceğim.",shape=box,color=red];
		3654 -> 3663;
	3655 [label="Bu sadece onun bahane olarak kullandığı bir mazeret.",shape=box,color=red];
		3655 -> 3664;
	3659 [label="Oui, biliyorum. Diğer tüm yöntemler başarısız olduğunda, onu ikna etmenin bir yolunu biliyorsunuz, non ?",shape=box,color=blue];
		3659 -> 3669;
		3659 -> 3670;
	3658 [label="Oui, elbette biliyorum. En iyi zamanlarda bile şeytan inatçıdır. Bazen onun sadece inatçı olmaktan zevk aldığını düşünüyorum !",shape=box,color=blue];
		3658 -> 3667;
		3658 -> 3668;
	3660 [label="Diğer tüm yöntemler başarısız olduğunda, onu ikna etmenin bir yolunu biliyorsunuz, non ?",shape=box,color=blue];
		3660 -> 3669;
		3660 -> 3670;
	3661 [label="Size iyi şanslar diliyorum. Bu şeytan inatçı olabilir ve bu az bir şey değil. Bazen, sadece provokasyon yapmaktan zevk aldığını düşünüyorum !",shape=box,color=blue];
