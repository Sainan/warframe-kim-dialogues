	3609 [label="Loid'i bu merdivenleri çıkıp sonunda aileyle konuşmaya ikna etmek için ne yapabilirim diye düşündüm ve... bir fikrim var ama hoşuna gideceğini sanmıyorum.",shape=box,color=red];
		3609 -> 3614;
	3610 [label="Loid'i üst kattaki Entrati ailesiyle konuşmaya nasıl ikna edeceğini hiç düşündün mü?",shape=box,color=red];
		3610 -> 3615;
	3611 [label="Loid ve Entrati ailesini konuşturma konusuna gelince, Roathe'nin olaya dahil olma ihtimalini yeniden değerlendirip değerlendirmediğini merak ediyorum?",shape=box,color=red];
		3611 -> 3616;
	3612 [label="Marie, hala Loid'i \"üst kat komşularıyla\" konuşmaya ikna etmeye çalışıyor musun? Bunu biraz garip bir noktada bıraktığımızı biliyorum.",shape=box,color=red];
		3612 -> 3616;
	3608 [label="Mösyö Loid'in le Cardinal'in ailesiyle konuşmaktan neden bu kadar korktuğunu düşünüyordum.",shape=box,color=blue];
		3608 -> 3613;
