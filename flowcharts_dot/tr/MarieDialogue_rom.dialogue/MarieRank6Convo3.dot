		j3822691405 -> j2339380349 [label="RoatheExecutor2",color=purple];
		j3822691405 -> j3305518157 [label="false",color=purple];
	j752011415 [label="Merci, merci, merci, mon cœur !",shape=box,color=blue];
		j752011415 -> j439816066;
	j3544735442 [label="Merci, merci, merci !",shape=box,color=blue];
		j3544735442 -> j439816066;
	j798739367 [label="Peki ! Zamanı geldiğinde hazır olacağım ve bekleyeceğim ! O zamana kadar görüşmek üzere, merci, mon cœur.",shape=box,color=blue];
		j798739367 -> j3569999725;
	j30686853 [label="Peki ! Zamanı geldiğinde hazır olacağım ve bekleyeceğim ! O zamana kadar görüşmek üzere, merci.",shape=box,color=blue];
		j30686853 -> j3569999725;
	j2620999322 [label="Sizin mutluluğunuz beni de mutlu ediyor. Ve şeytan nerede gücünü kullanacağını biliyorsa... ne ala, non ?",shape=box,color=blue];
		j2620999322 -> j3354011292;
	j3516175796 [label="Asla böyle bir şeyi ima etmek istemem. Ancak şeytan, herkesi görmezden gelmesine rağmen sizi dinlemeye razı gibi görünüyor.",shape=box,color=blue];
		j3516175796 -> j1277836478;
	j3157247588 [label="Onunla tanışan herkes onu bir canavar gibi göstermeye çalıştı. Sanırım bunu yapmayan ilk kişi benim.",shape=box,color=red];
		j3157247588 -> j3830179450;
	j2004405595 [label="Onun gösteremediği pek çok şey var. Bu doğrudan bir zırh değil, ama insanların ona zarar vermeyeceğine güvenmeyin.",shape=box,color=red];
		j2004405595 -> j400673841;
	j1143069440 [label="O... uzun hayatı boyunca gerçek kalp kırıklıkları yaşadı. Sadece yaralarını sardı ve üzerlerini dikenlerle kapattı, hepsi bu.",shape=box,color=red];
		j1143069440 -> j3698844872;
	j4151132811 [label="Onun kaç yıl yaşadığını anlayabileceğimi düşünüyorum. Onun gördüğü kadar çok ölüm gördüm.",shape=box,color=red];
		j4151132811 -> j3163848481;
	j2339380349 [label="O her zaman doğru olanı yapmaya çalıştı. Belki doğru şekilde yapamadı, ama Orokin'lerin Origin Sistemini kurtarmaya çalışıyordu.",shape=box,color=red];
		j2339380349 -> j3658224670;
	j3305518157 [label="Onun alaycı mizah anlayışını seviyorum. Egosu bir kenara bırakılırsa, çok zeki biridir.",shape=box,color=red];
		j3305518157 -> j1572803672;
	j439816066 [label="Peki ! Zamanı geldiğinde hazır olacağım ve bekleyeceğim ! O zamana kadar görüşmek üzere !",shape=box,color=blue];
		j439816066 -> j3569999725;
	j3354011292 [label="Onu sakinleştirmek için omzunda un ange gibi durursan, bu hepimiz için daha da iyi olur.",shape=box,color=blue];
		j3354011292 -> j1660016656;
		j3354011292 -> j44531171;
	j1277836478 [label="Ve asla özel anlarda. Non. Jamais.",shape=box,color=blue];
		j1277836478 -> j1284851268;
		j1277836478 -> j530192710;
	j3830179450 [label="Son zamanlarda bu listenin en başında ben varım, non ? Sanırım onun neden böyle olduğunu düşünmeliyim. Yargılamak hiçbir ruhu kurtarmaz.",shape=box,color=blue];
		j3830179450 -> j2512943208;
	j400673841 [label="Çevremizdekilerden sakladığımız bir acı her zaman vardır. Başkalarının onu kullanmasından korktuğumuz için korumaya çalıştığımız bir şey. Eğer söyledikleriniz doğruysa, ona karşı daha nazik olmaya çalışmalıyım sanırım.",shape=box,color=blue];
		j400673841 -> j2512943208;
	j3698844872 [label="Tüm bu yıllar boyunca yaşanan sevgi ve kaybın boyutunu hayal bile edemiyorum. Gördüklerime rağmen, bu bana hala gerçek dışı geliyor.",shape=box,color=blue];
