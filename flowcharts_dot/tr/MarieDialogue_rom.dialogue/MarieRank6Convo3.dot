		j3989358122 -> j2620999322;
	j1584971314 [label="Ne demek istediğinizi hiç anlamadım ! Hiçbir şey ima etmiyorum. Ben tamamen innocente bir Sœur de Sol'um.",shape=box,color=blue];
		j1584971314 -> j3516175796;
	j3822691405 [label="Evaluate expressions",color=orange];
