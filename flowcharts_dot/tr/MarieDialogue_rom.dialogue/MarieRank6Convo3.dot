		j2198758823 -> j4044213262 [label=true,color=green];
		j2198758823 -> j231136866 [label=false,color=brown];
	j3381997418 [label="Oh ! Pardonne-moi, demek istediğim bu değildi ! Sadece sizi tercih ediyor gibi görünüyor. Diğerlerini görmezden gelirken size kulak veriyor gibi geliyor bana.",shape=box,color=blue];
		j3381997418 -> j3989358122;
	j4008607136 [label="+5 Chemistry",color=orange];
		j4008607136 -> j1584971314;
	j583994556 [label="Oui, seni çok seviyor gibi görünüyor. Belki de bizim aksine, aynı dönemi ve aynı yeri paylaşıyorsunuzdur ? Yoksa neden böyle olsun ki ?",shape=box,color=blue];
		j583994556 -> j3822691405;
	j244567725 [label="Oui ? Ne demek istiyorsunuz ?",shape=box,color=blue];
		j244567725 -> j3822691405;
