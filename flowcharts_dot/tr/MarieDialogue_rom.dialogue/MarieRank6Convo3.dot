		j1903226774 -> j1085109210 [label=true,color=green];
		j1903226774 -> j731960146 [label=false,color=brown];
	j1942153869 [label="Ve bu çıkmazı nasıl kırmamız gerektiğini. İçine hapsolduğumuz bu arafta kalmamalıyız. Çok gereksiz yere acı verici görünüyor.",shape=box,color=blue];
		j1942153869 -> j1571200658;
	j4255933614 [label="Bonjour, mon cœur ! Ve neyi sevmeyeceğimi düşünüyorsunuz ?",shape=box,color=blue];
		j4255933614 -> j431666622;
	j1576475688 [label="Bounjour ! Peki neyi beğenmeyeceğimden korkuyorsunuz ?",shape=box,color=blue];
		j1576475688 -> j431666622;
	j1928401365 [label="Bonjour mon cœur ! Düşündüm de, oui... ve bunu kabul etmekte gerçekten zorlanıyorum. Bunu söylemekten hoşlanmıyorum.",shape=box,color=blue];
		j1928401365 -> j3391192377;
	j1085109210 [label="Bonjour, bonjour, mon cœur ! Düşündüm, oui... ve bunu kabul etmekte gerçekten zorlanıyorum. Bunu söylemekten hoşlanmıyorum.",shape=box,color=blue];
		j1085109210 -> j3476442647;
	j731960146 [label="Bonjour - Düşündüm de, oui... ve bunu kabul etmekte gerçekten zorlandım. Bunu söylemekten hoşlanmıyorum.",shape=box,color=blue];
		j731960146 -> j3476442647;
	j1571200658 [label="Ama bence bize... bir tür kaleye ihtiyacımız var gibi, non ? Bir fikrin var mı ?",shape=box,color=blue];
		j1571200658 -> j1278348933;
		j1571200658 -> j431666622;
	j431666622 [label="Sanırım Loid'i Entrati ailesiyle konuşmaya ikna etmek için Roathe'nin yardımına ihtiyacımız olacak. Aksi takdirde bunu yapacağını sanmıyorum. Ailenin ve kendisinin korunacağına dair güvence olmadan.",shape=box,color=red];
		j431666622 -> j2645554631;
	j3391192377 [label="Ama sanırım... sanırım - ah, Sol, beni affetsin – belki de şeytana başvurmamız gerekecek. Aksi takdirde Bay Loid bizi dinlemeyecektir.",shape=box,color=blue];
		j3391192377 -> j2447821203;
	j3476442647 [label="Sanırım haklısınız. Şeytan belki de ihtiyacımız olan eksik parçadır. Ah, bu kelimeleri yazmak bile bana acı veriyor ! ",shape=box,color=blue];
		j3476442647 -> j636489540;
	j1278348933 [label="Şüpheli kaynakların yardımına ihtiyaç duymayan iyi fikirlerim pek yok. Bu kaynaklar daha sonra bizi daha da büyük zorluklara sokabilir. Örneğin Roathe gibi.",shape=box,color=red];
		j1278348933 -> j1193661177;
	j2645554631 [label="Bunu... kabul etmek istemiyorum ama sanırım haklısın... Sol, beni affet.",shape=box,color=blue];
		j2645554631 -> j636489540;
	j2447821203 [label="Şeytan güçlüdür ve işler ters gittiğinde faydalı olabilir, non ?",shape=box,color=blue];
		j2447821203 -> j1595212505;
		j2447821203 -> j189937364;
	j636489540 [label="Evaluate expressions",color=orange];
