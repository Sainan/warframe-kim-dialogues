		j636489540 -> j788220820 [label="false",color=purple];
	j1193661177 [label="Gerçekten öyle mi düşünüyorsun ? Ben şeytanla olan anlaşmazlıklarımı bir kenara bırakabiliyorsam, siz de bırakabilirsiniz, non ?",shape=box,color=blue];
		j1193661177 -> j3574703228;
		j1193661177 -> j4103964271;
	j1595212505 [label="Hayır, başka bir yol olmalı. Onun yardımını istemeyi reddediyorum.",shape=box,color=red];
		j1595212505 -> j1193661177;
	j189937364 [label="Haklısın. Kabul edeceğini düşünmemiştim. Bu yüzden sormaya çekindim.",shape=box,color=red];
		j189937364 -> j636489540;
	j1017844221 [label="Bu konuda bize yardım edecek mi ?",shape=box,color=blue];
		j1017844221 -> j3310576862;
	j2887483144 [label="Bu konuda bize yardım edecek mi ?",shape=box,color=blue];
		j2887483144 -> j3886841125;
	j2667820427 [label="Bu konuda bize yardım edecek mi ?",shape=box,color=blue];
		j2667820427 -> j2975638238;
	j788220820 [label="Peki onu bize yardım etmeye ikna edebilecek misiniz ?",shape=box,color=blue];
		j788220820 -> j1565362617;
		j788220820 -> j2666392951;
	j3574703228 [label="Hayır, üzgünüm. ",shape=box,color=red];
		j3574703228 -> j3015197257;
	j4103964271 [label="Tamam. Senin için sorun yoksa, benim için de sorun yok.",shape=box,color=red];
		j4103964271 -> j4177340162;
	j3310576862 [label="Maalesef hayır... Onunla bu konuda bir çıkmaza girdiğimizi düşünüyorum. Başka bir yol olduğunu mu düşünüyorsun?",shape=box,color=red];
		j3310576862 -> j3052576961;
	j3886841125 [label="Edecek. Onu onları yeniden bir araya getirmeye ikna ettim - ve buna inanamayacaksın - sanırım bunun sebebi Entrati'nin ailesini koruyabilmesi. Sonuçta Orokin'den geriye kalan tek şey onlar.",shape=box,color=red];
		j3886841125 -> j1073634832;
	j2975638238 [label="Edecek. Onları bir araya getirmeleri için ikna ettim – ve bu seni şaşırtmayacaktır – bunu özellikle Albrecht'in yokluğunda ona inat etmek için yaptığını düşünüyorum.",shape=box,color=red];
		j2975638238 -> j1151120715;
	j1565362617 [label="Henüz hiçbir şey kesinleşmedi. Onun... yani, nasıl olabileceğini biliyorsun.",shape=box,color=red];
		j1565362617 -> j2913252443;
	j2666392951 [label="Hala üzerinde çalışıyorum ama öyle düşünüyorum.",shape=box,color=red];
		j2666392951 -> j1104176810;
	j3015197257 [label="+20 Chemistry",color=orange];
		j3015197257 -> j1150780971;
	j4177340162 [label="Oui, hoşuma gitmese de sanırım bu bizim yutmamız gereken bir médicament.",shape=box,color=blue];
		j4177340162 -> j636489540;
	j3052576961 [label="Oh ! Bu... talihsiz bir durum. Bilmiyorum ? Sanmıyorum... Şeytanla başka bir yaklaşım düşünebilir misiniz ? Ya da tekrar denemek için bir yol ?",shape=box,color=blue];
		j3052576961 -> j3624431724;
	j1073634832 [label="Onu kendi rızası dışında protoframe'e dönüştüren ve geçmişe gönderen, anılarını elinden alan adamın ailesini korumaya yardım ediyoruz...",shape=box,color=blue];
		j1073634832 -> j598802282;
	j1151120715 [label="Haklısınız, ben... şaşırmadım.",shape=box,color=blue];
		j1151120715 -> j3901274553;
