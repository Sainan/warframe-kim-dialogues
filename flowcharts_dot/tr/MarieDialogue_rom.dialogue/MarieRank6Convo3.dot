		3690 -> 3701;
	3689 [label="Merci, merci, merci, mon cœur !",shape=box,color=blue];
		3689 -> 3700;
	3688 [label="Merci, merci, merci !",shape=box,color=blue];
		3688 -> 3700;
	3687 [label="Peki ! Zamanı geldiğinde hazır olacağım ve bekleyeceğim ! O zamana kadar görüşmek üzere, merci, mon cœur.",shape=box,color=blue];
		3687 -> 3699;
	3686 [label="Peki ! Zamanı geldiğinde hazır olacağım ve bekleyeceğim ! O zamana kadar görüşmek üzere, merci.",shape=box,color=blue];
		3686 -> 3699;
	3697 [label="Sizin mutluluğunuz beni de mutlu ediyor. Ve şeytan nerede gücünü kullanacağını biliyorsa... ne ala, non ?",shape=box,color=blue];
		3697 -> 3708;
	3698 [label="Şeytan sizi seviyor gibi göründüğü için, herkesi görmezden geliyor gibi görünse de sizi dinleyeceğini ima etmek istemem.",shape=box,color=blue];
		3698 -> 3709;
	3692 [label="Onunla tanışan herkes onu bir canavar gibi göstermeye çalıştı. Sanırım bunu yapmayan ilk kişi benim.",shape=box,color=red];
		3692 -> 3703;
	3693 [label="Onun gösteremediği pek çok şey var. Bu doğrudan bir zırh değil, ama insanların ona zarar vermeyeceğine güvenmeyin.",shape=box,color=red];
		3693 -> 3704;
	3695 [label="O... uzun hayatı boyunca gerçek kalp kırıklıkları yaşadı. Sadece yaralarını sardı ve üzerlerini dikenlerle kapattı, hepsi bu.",shape=box,color=red];
		3695 -> 3706;
	3696 [label="Onun kaç yıl yaşadığını anlayabileceğimi düşünüyorum. Onun gördüğü kadar çok ölüm gördüm.",shape=box,color=red];
		3696 -> 3707;
	3694 [label="O her zaman doğru olanı yapmaya çalıştı. Belki doğru şekilde yapamadı, ama Orokin'lerin Origin Sistemini kurtarmaya çalışıyordu.",shape=box,color=red];
		3694 -> 3705;
	3691 [label="Onun alaycı mizah anlayışını seviyorum. Egosu bir kenara bırakılırsa, çok zeki biridir.",shape=box,color=red];
		3691 -> 3702;
	3701 [label="Chat ends.",color=orange];
	3700 [label="Peki ! Zamanı geldiğinde hazır olacağım ve bekleyeceğim ! O zamana kadar görüşmek üzere !",shape=box,color=blue];
		3700 -> 3711;
	3699 [label="Update boolean MarieFamilySuccess",color=orange];
		3699 -> 3710;
	3708 [label="Onu sakinleştirmek için omzunda un ange gibi durursan, bu hepimiz için daha da iyi olur.",shape=box,color=blue];
		3708 -> 3716;
		3708 -> 3717;
	3709 [label="Ve asla özel anlarda. Non. Jamais.",shape=box,color=blue];
		3709 -> 3718;
		3709 -> 3719;
	3703 [label="Son zamanlarda bu listenin en başında ben varım, non ? Sanırım onun neden böyle olduğunu düşünmeliyim. Yargılamak hiçbir ruhu kurtarmaz.",shape=box,color=blue];
		3703 -> 3713;
	3704 [label="Çevremizdekilerden sakladığımız bir acı her zaman vardır. Başkalarının onu kullanmasından korktuğumuz için korumaya çalıştığımız bir şey. Eğer söyledikleriniz doğruysa, ona karşı daha nazik olmaya çalışmalıyım sanırım.",shape=box,color=blue];
		3704 -> 3713;
	3706 [label="Tüm bu yıllar boyunca yaşanan sevgi ve kaybın boyutunu hayal bile edemiyorum. Gördüklerime rağmen, bu bana hala gerçek dışı geliyor.",shape=box,color=blue];
		3706 -> 3714;
	3707 [label="Bazen onunla konuşurken, kaç yüzyıl geçirdiğini unutuyorum. Gördüğüm onca şeye rağmen, bu bana çok gerçek dışı geliyor.",shape=box,color=blue];
		3707 -> 3715;
	3705 [label="Her zaman nüanslar vardır, oui ? Her zaman bir şekilde davranmak için nedenler vardır. Eğer söyledikleriniz doğruysa, ona karşı daha nazik olmaya çalışmalıyım sanırım.",shape=box,color=blue];
		3705 -> 3713;
	3702 [label="Kimse şeytanın zeki olmadığını iddia etmedi.",shape=box,color=blue];
		3702 -> 3712;
