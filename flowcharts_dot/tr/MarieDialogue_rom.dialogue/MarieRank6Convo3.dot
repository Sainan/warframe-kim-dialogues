	3672 [label="Check boolean MarieDating",color=orange];
		3672 -> 3680 [label=true,color=green];
		3672 -> 3679 [label=false,color=brown];
	3677 [label="Oh ! Pardonne-moi, demek istediğim bu değildi ! Sadece sizi tercih ediyor gibi görünüyor. Diğerlerini görmezden gelirken size kulak veriyor gibi geliyor bana.",shape=box,color=blue];
		3677 -> 3684;
	3678 [label="+5 Chemistry",color=orange];
		3678 -> 3685;
