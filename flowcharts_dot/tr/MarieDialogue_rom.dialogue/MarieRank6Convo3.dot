	j4246292241 [label="Loid'i bu merdivenleri çıkıp sonunda aileyle konuşmaya ikna etmek için ne yapabilirim diye düşündüm ve... bir fikrim var ama hoşuna gideceğini sanmıyorum.",shape=box,color=red];
		j4246292241 -> j3431982611;
	j2837201793 [label="Loid'i üst kattaki Entrati ailesiyle konuşmaya nasıl ikna edeceğini hiç düşündün mü?",shape=box,color=red];
		j2837201793 -> j2607534784;
	j2451307717 [label="Loid ve Entrati ailesini konuşturma konusuna gelince, Roathe'nin olaya dahil olma ihtimalini yeniden değerlendirip değerlendirmediğini merak ediyorum?",shape=box,color=red];
		j2451307717 -> j1903226774;
	j1004346003 [label="Marie, hala Loid'i \"üst kat komşularıyla\" konuşmaya ikna etmeye çalışıyor musun? Bunu biraz garip bir noktada bıraktığımızı biliyorum.",shape=box,color=red];
		j1004346003 -> j1903226774;
	j1363446826 [label="Mösyö Loid'in le Cardinal'in ailesiyle konuşmaktan neden bu kadar korktuğunu düşünüyordum.",shape=box,color=blue];
		j1363446826 -> j1942153869;
	j3431982611 [label="Check boolean MarieDating",color=orange];
