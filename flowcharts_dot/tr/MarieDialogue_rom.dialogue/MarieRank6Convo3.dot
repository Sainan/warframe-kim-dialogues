		j749661018 -> j4017979286;
		j749661018 -> j121771168;
	j2218274764 [label="Size iyi şanslar diliyorum. Bu şeytan inatçı olabilir ve bu az bir şey değil. Bazen, sadece provokasyon yapmaktan zevk aldığını düşünüyorum !",shape=box,color=blue];
		j2218274764 -> j833824549;
