		3616 -> 3622 [label=false,color=brown];
	3613 [label="Ve bu çıkmazı nasıl kırmamız gerektiğini. İçine hapsolduğumuz bu arafta kalmamalıyız. Çok gereksiz yere acı verici görünüyor.",shape=box,color=blue];
		3613 -> 3617;
	3619 [label="Bonjour, mon cœur ! Ve neyi sevmeyeceğimi düşünüyorsunuz ?",shape=box,color=blue];
		3619 -> 3625;
	3618 [label="Bounjour ! Peki neyi beğenmeyeceğimden korkuyorsunuz ?",shape=box,color=blue];
		3618 -> 3625;
	3621 [label="Bonjour mon cœur ! Düşündüm de, oui... ve bunu kabul etmekte gerçekten zorlanıyorum. Bunu söylemekten hoşlanmıyorum.",shape=box,color=blue];
		3621 -> 3626;
	3620 [label="Bonjour mon cœur ! Düşündüm de, oui... ve bunu kabul etmekte gerçekten zorlanıyorum. Bunu söylemekten hoşlanmıyorum.",shape=box,color=blue];
		3620 -> 3626;
	3623 [label="Bonjour, bonjour, mon cœur ! Düşündüm, oui... ve bunu kabul etmekte gerçekten zorlanıyorum. Bunu söylemekten hoşlanmıyorum.",shape=box,color=blue];
		3623 -> 3627;
	3622 [label="Bonjour - Düşündüm de, oui... ve bunu kabul etmekte gerçekten zorlandım. Bunu söylemekten hoşlanmıyorum.",shape=box,color=blue];
		3622 -> 3627;
	3617 [label="Ama bence bize... bir tür kaleye ihtiyacımız var gibi, non ? Bir fikrin var mı ?",shape=box,color=blue];
		3617 -> 3624;
		3617 -> 3625;
	3625 [label="Sanırım Loid'i Entrati ailesiyle konuşmaya ikna etmek için Roathe'nin yardımına ihtiyacımız olacak. Aksi takdirde bunu yapacağını sanmıyorum. Ailenin ve kendisinin korunacağına dair güvence olmadan.",shape=box,color=red];
		3625 -> 3629;
	3626 [label="Ama sanırım... sanırım - ah, Sol, beni affetsin – belki de şeytana başvurmamız gerekecek. Aksi takdirde Bay Loid bizi dinlemeyecektir.",shape=box,color=blue];
		3626 -> 3630;
	3627 [label="Sanırım haklısınız. Şeytan belki de ihtiyacımız olan eksik parçadır. Ah, bu kelimeleri yazmak bile bana acı veriyor ! ",shape=box,color=blue];
		3627 -> 3631;
	3624 [label="Şüpheli kaynakların yardımına ihtiyaç duymayan iyi fikirlerim pek yok. Bu kaynaklar daha sonra bizi daha da büyük zorluklara sokabilir. Örneğin Roathe gibi.",shape=box,color=red];
		3624 -> 3628;
	3629 [label="Bunu... kabul etmek istemiyorum ama sanırım haklısın... Sol, beni affet.",shape=box,color=blue];
		3629 -> 3631;
	3630 [label="Şeytan güçlüdür ve işler ters gittiğinde faydalı olabilir, non ?",shape=box,color=blue];
		3630 -> 3634;
		3630 -> 3635;
	3631 [label="Evaluate expressions",color=orange];
		3631 -> 3638 [label="RoatheFamilyFail",color=purple];
