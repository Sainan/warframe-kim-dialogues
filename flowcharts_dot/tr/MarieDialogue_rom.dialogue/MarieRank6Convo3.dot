",color=purple];
		3631 -> 3636 [label="RoatheVillain, RoatheFamilySuccess",color=purple];
		3631 -> 3639 [label="false",color=purple];
	3628 [label="Gerçekten öyle mi düşünüyorsun ? Ben şeytanla olan anlaşmazlıklarımı bir kenara bırakabiliyorsam, siz de bırakabilirsiniz, non ?",shape=box,color=blue];
		3628 -> 3632;
		3628 -> 3633;
	3634 [label="Hayır, başka bir yol olmalı. Onun yardımını istemeyi reddediyorum.",shape=box,color=red];
		3634 -> 3628;
	3635 [label="Haklısın. Kabul edeceğini düşünmemiştim. Bu yüzden sormaya çekindim.",shape=box,color=red];
		3635 -> 3631;
	3638 [label="/Lotus/Language/1999Texting/MarieRomance/Marie_MarieRank6Convo3_3118 begins.",shape=box,color=blue];
		3638 -> 3644;
	3637 [label="Bu konuda bize yardım edecek mi ?",shape=box,color=blue];
		3637 -> 3643;
	3636 [label="Bu konuda bize yardım edecek mi ?",shape=box,color=blue];
		3636 -> 3642;
	3639 [label="Peki onu bize yardım etmeye ikna edebilecek misiniz ?",shape=box,color=blue];
		3639 -> 3645;
		3639 -> 3646;
	3632 [label="Hayır, üzgünüm. ",shape=box,color=red];
		3632 -> 3640;
	3633 [label="Tamam. Senin için sorun yoksa, benim için de sorun yok.",shape=box,color=red];
		3633 -> 3641;
	3644 [label="Maalesef hayır... Onunla bu konuda bir çıkmaza girdiğimizi düşünüyorum. Başka bir yol olduğunu mu düşünüyorsun?",shape=box,color=red];
		3644 -> 3650;
	3643 [label="Edecek. Onu onları yeniden bir araya getirmeye ikna ettim - ve buna inanamayacaksın - sanırım bunun sebebi Entrati'nin ailesini koruyabilmesi. Sonuçta Orokin'den geriye kalan tek şey onlar.",shape=box,color=red];
		3643 -> 3649;
	3642 [label="Edecek. Onları bir araya getirmeleri için ikna ettim – ve bu seni şaşırtmayacaktır – bunu özellikle Albrecht'in yokluğunda ona inat etmek için yaptığını düşünüyorum.",shape=box,color=red];
		3642 -> 3648;
	3645 [label="Henüz hiçbir şey kesinleşmedi. Onun... yani, nasıl olabileceğini biliyorsun.",shape=box,color=red];
		3645 -> 3651;
	3646 [label="Hala üzerinde çalışıyorum ama öyle düşünüyorum.",shape=box,color=red];
		3646 -> 3652;
	3640 [label="+20 Chemistry",color=orange];
		3640 -> 3647;
	3641 [label="Oui, hoşuma gitmese de sanırım bu bizim yutmamız gereken bir médicament.",shape=box,color=blue];
		3641 -> 3631;
	3650 [label="Oh ! Bu... talihsiz bir durum. Bilmiyorum ? Sanmıyorum... Şeytanla başka bir yaklaşım düşünebilir misiniz ? Ya da tekrar denemek için bir yol ?",shape=box,color=blue];
		3650 -> 3657;
	3649 [label="Onu kendi rızası dışında protoframe'e dönüştüren ve geçmişe gönderen, anılarını elinden alan adamın ailesini korumaya yardım ediyoruz...",shape=box,color=blue];
		3649 -> 3656;
