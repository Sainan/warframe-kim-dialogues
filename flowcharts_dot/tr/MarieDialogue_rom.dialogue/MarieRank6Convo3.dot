		3670 -> 3678;
	3667 [label="Aslında, ne kadar tuhaf görünse de, bunu seviyorum. İyi anlaşıyoruz.",shape=box,color=red];
		3667 -> 3675;
	3668 [label="Belki de öyle ama bence bunların çoğu sadece gösteriş için.",shape=box,color=red];
		3668 -> 3676;
	3662 [label="Update boolean MarieRank5Convo4Complete",color=orange];
		3662 -> 3671;
	3674 [label="Şeytan kaprislidir ! C'est la vie, dedikleri gibi !",shape=box,color=blue];
		3674 -> 3682;
