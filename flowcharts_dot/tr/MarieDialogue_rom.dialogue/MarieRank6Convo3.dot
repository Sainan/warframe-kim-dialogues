		j3901274553 -> j1098679032;
	j1602806196 [label="Bu sadece onun bahane olarak kullandığı bir mazeret.",shape=box,color=red];
		j1602806196 -> j853870120;
	j2537403082 [label="Oui, biliyorum. Diğer tüm yöntemler başarısız olduğunda, onu ikna etmenin bir yolunu biliyorsunuz, non ?",shape=box,color=blue];
		j2537403082 -> j4017979286;
		j2537403082 -> j121771168;
	j2369637720 [label="Oui, elbette biliyorum. En iyi zamanlarda bile şeytan inatçıdır. Bazen onun sadece inatçı olmaktan zevk aldığını düşünüyorum !",shape=box,color=blue];
		j2369637720 -> j833824549;
		j2369637720 -> j1962736719;
