		2892 -> 2901;
	2891 [label="İnançlarımızın benzer olduğunu biliyorum, bu yüzden şunu söyleyeceğim... Sol beni olduğum gibi yaratmayı uygun gördü ve ben onun tasarımına güvenmeliyim, non ? Benim sınırlı bakış açımdan durumum ne kadar kusurlu görünse de, sizin de kendi düzeyinizde aynısını yapabileceğinizi merak ediyorum.",shape=box,color=blue];
		2891 -> 2901;
	2893 [label="İnançlarımızın farklı olduğunu biliyorum, bu yüzden hakim olmadığım bir konu hakkında konuşmaktan kaçınacağım. Sadece Sol'un beni olduğum gibi yaratmayı uygun gördüğünü ve onun tasarımına güvenmem gerektiğini söyleyeceğim, non ? Benim sınırlı bakış açımdan durumum ne kadar kusurlu görünse de, sizin de kendi düzeyinizde aynısını yapıp yapamayacağınızı merak ediyorum.",shape=box,color=blue];
