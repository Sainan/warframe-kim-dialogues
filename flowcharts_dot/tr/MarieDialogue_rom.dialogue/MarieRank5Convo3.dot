	j1420918296 [label="İnançlarımızın benzer olduğunu biliyorum, bu yüzden şunu söyleyeceğim... Sol beni olduğum gibi yaratmayı uygun gördü ve ben onun tasarımına güvenmeliyim, non ? Benim sınırlı bakış açımdan durumum ne kadar kusurlu görünse de, sizin de kendi düzeyinizde aynısını yapabileceğinizi merak ediyorum.",shape=box,color=blue];
		j1420918296 -> j2548984291;
	j261554707 [label="İnançlarımızın farklı olduğunu biliyorum, bu yüzden hakim olmadığım bir konu hakkında konuşmaktan kaçınacağım. Sadece Sol'un beni olduğum gibi yaratmayı uygun gördüğünü ve onun tasarımına güvenmem gerektiğini söyleyeceğim, non ? Benim sınırlı bakış açımdan durumum ne kadar kusurlu görünse de, sizin de kendi düzeyinizde aynısını yapıp yapamayacağınızı merak ediyorum.",shape=box,color=blue];
		j261554707 -> j2548984291;
	j766061928 [label="İnancının kişisel bir mesele olduğunu biliyorum, bu yüzden sormuyorum. Ama Sol beni olduğum gibi yarattı ve ben onun tasarımına güvenmek zorundayım, non ? Benim sınırlı bakış açımdan ne kadar hatalı görünse de. Sizin inancınız açısından da benzer bir şey olmalı.",shape=box,color=blue];
		j766061928 -> j2548984291;
	j671206380 [label="Sol bizi olduğumuz gibi yarattı ve biz de onun tasarımına güvenmeliyiz, non ? Sınırlı bakış açımızdan ne kadar kusurlu görünseler de.",shape=box,color=blue];
		j671206380 -> j2548984291;
	j2204177208 [label="Lua seni olduğun gibi yarattı, Sol da beni olduğum gibi yarattı. Onların tasarımlarına güvenmeliyiz, non ? Sınırlı bakış açımızdan ne kadar kusurlu görünseler de.",shape=box,color=blue];
		j2204177208 -> j2548984291;
	j1539824044 [label="Aydınlık bizi olduğumuz gibi yarattı. Onların tasarımına güvenmemiz gerekmez mi, non ? Sınırlı bakış açımızdan ne kadar kusurlu görünseler de.",shape=box,color=blue];
		j1539824044 -> j2548984291;
	j3678094920 [label="Hiçbirimizin, evrenin gerçek cevabını bilemeyeceğine inandığınızı biliyorum ve bunu takdir ediyor ve saygı duyuyorum. Ama ben sadece Sol'un beni olduğum gibi yaratmayı uygun gördüğünü ve onun tasarımına inanmam gerektiğini söyleyeceğim, non ? Sınırlı bakış açımdan bakıldığında kusurlu olduğunu düşünsem de.",shape=box,color=blue];
		j3678094920 -> j2548984291;
	j3383690952 [label="Sizin inançlı olmadığınızı biliyorum ve buna saygı duyuyorum. Ama Sol beni olduğum gibi yarattı ve ben onun yarattığına güvenmek zorundayım, non ? Benim sınırlı bakış açımdan ne kadar hatalı görünse de.",shape=box,color=blue];
		j3383690952 -> j2548984291;
