		168 -> 174;
	169 [label="Oui, le Cardinal, Lyon'a ve bana formumuzu değiştiren sérum'ları almanın nelere yol açacağını anlattı. Neler olacağını biliyorduk.",shape=box,color=blue];
		169 -> 175;
