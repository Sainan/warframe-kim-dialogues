	202 [label="Keşke sevgili Lyon'um da dünyayı sizin gibi görebilseydi. Dediğiniz gibi, bütün bu zorluklar birer gizli bir güç olabilir.",shape=box,color=blue];
		202 -> 213;
	203 [label="Nazik davranışınızı takdir ediyorum, Gezgin. Sabrınızı zorlamamak için bu konuyu burada kapatacağım. ",shape=box,color=blue];
		203 -> 214;
	204 [label="Bu konuda yalnız değilsiniz, Gezgin. Lyon benim için aile gibidir ve bazen onu katedraldeki aziz heykellerinden daha fazla tanıyıp tanımadığımı merak ediyorum.",shape=box,color=blue];
