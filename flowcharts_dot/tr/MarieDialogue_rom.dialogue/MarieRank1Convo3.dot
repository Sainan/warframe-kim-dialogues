	159 [label="Cephalon'ların hepsi ceza olarak yaratılmamıştı. Ama Deimos'ta işler... kötü gitti ve ağır hasar gördü.",shape=box,color=red];
		159 -> 166;
	157 [label="Onun hala dışarıda olduğunu, kontrolden çıkmış bir şekilde dolaştığını, ona tek kelime etmediğini, hatta mektup bile göndermediğini bilmek...?",shape=box,color=red];
		157 -> 164;
