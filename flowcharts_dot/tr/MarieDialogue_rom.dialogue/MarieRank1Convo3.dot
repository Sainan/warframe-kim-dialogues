	187 [label="Keşke onu düzeltebilsek, gerçekten. Gerçek Otak'ı geri getirebilsek.",shape=box,color=red];
		187 -> 199;
	188 [label="O beni güldürüyor. Komik biri ama bu komikliğinin arkasında trajik ve acı dolu bir şeyler saklı.",shape=box,color=red];
		188 -> 200;
	189 [label="Ne yazık ki, bu durum düzeltilebilir değil. Ve bence oldukça sinir bozucu. ",shape=box,color=red];
