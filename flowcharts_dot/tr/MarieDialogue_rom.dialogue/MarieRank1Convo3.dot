		153 -> 158;
	160 [label="Engelleri bizi değiştiren bir şey olarak görmeye çalışıyorum. Bizi kısıtlıyorlar, evet, ama aynı zamanda başkalarına sahip olmayan güçler de veriyorlar.",shape=box,color=red];
		160 -> 167;
	161 [label="Durumunu hiç sorun olarak görmedin mi?",shape=box,color=red];
