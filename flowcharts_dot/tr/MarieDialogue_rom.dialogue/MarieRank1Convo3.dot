digraph {
	77 [label="MarieRank1Convo3 begins.",color=orange];
		77 -> 78;
	78 [label="Il y a un crâne volant ! Keksekça ?! Etrafta uçarak konuşan bir kafatası var ve herkes sanki hiçbir şey olmamış gibi hayatlarına devam ediyor ve birinin bu tuhaflığın normal olup olmadığını açıklamasına ihtiyacım var.",shape=box,color=blue];
		78 -> 79;
		78 -> 81;
		78 -> 80;
	79 [label="O sadece Necraloid. Şey, bir necraloid. Karmaşık bir konu.",shape=box,color=red];
		79 -> 82;
	81 [label="O Necraloid. O bir Cephalon, sana zarar vermez.",shape=box,color=red];
		81 -> 84;
	80 [label="[Son.]",shape=box,color=red];
		80 -> 83;
	82 [label="Pardon, bu bir isim mi yoksa bir nesne mi ?",shape=box,color=blue];
		82 -> 85;
		82 -> 86;
	84 [label="Onun bir tehdit olduğunu düşünmüyorum ! Beni korkutmuyor.",shape=box,color=blue];
		84 -> 87;
	83 [label="Chat ends.",color=orange];
	85 [label="Ben... tam olarak bilmiyorum.",shape=box,color=red];
		85 -> 88;
	86 [label="Evet.",shape=box,color=red];
		86 -> 89;
	87 [label="Hatta, sohbet ederken biraz katı olsa da, onu son derece sevimli buluyorum. Her ne kadar onun yaşayan ilham kaynağına tam olarak benzemese de.. Ama en sevdiğim seyahat arkadaşımın doğası göz önüne alındığında, bunun beni çok fazla rahatsız etmediğini söyleyebilirim.",shape=box,color=blue];
		87 -> 90;
	88 [label="İlk olarak, bu \"Necraloid'ler'' kimin tasarımı ? Bu ismi ve belki de tanımlamayı onlara veren kim ?",shape=box,color=blue];
		88 -> 91;
		88 -> 92;
	89 [label="Ben... anlamıyorum. Peki Loid 'in bu olaydaki rolü ne ?",shape=box,color=blue];
		89 -> 88;
	90 [label="Hayır, onun yüzünde size grotesque gelen şey, emin olun, şu anda ele aldığım konu değil.",shape=box,color=blue];
		90 -> 93;
		90 -> 94;
	91 [label="Kardinal Dimanche'niz. Entrati.",shape=box,color=red];
		91 -> 95;
	92 [label="Bunu Entrati yaptı. Ama onların -Cephalon'ların- genel konsepti Orokinler tarafından icat edildi.",shape=box,color=red];
		92 -> 95;
	93 [label="Kafatasının seni rahatsız etmemesine şaşırdım.",shape=box,color=red];
		93 -> 96;
	94 [label="Kabul ediyorum, bağlamından koparıldığında tuhaf görünebilir. Ama tam olarak seni rahatsız eden nedir?",shape=box,color=red];
		94 -> 97;
	95 [label="Excusez-moi, le Cardinal'ın kendi arkadaşının ve hizmetkarının suretinde uçan bir kafatası kopyasını yaptığını ve onlara bu ismi verdiğini mi ima ediyorsunuz ?",shape=box,color=blue];
		95 -> 98;
	96 [label="Hakkımda çok az şey biliyorsunuz, bu sizin suçunuz değil. Hayatımın büyük bir bölümünü ölülerle ve onların yattığı yerlerle ilgilenerek geçirdim. ",shape=box,color=blue];
		96 -> 99;
	97 [label="Sırtında neden bir çocuğun karalamasına benzeyen başka bir yüz olduğunu merak ediyorum.",shape=box,color=blue];
		97 -> 100;
	98 [label="Peki neden bu necraloid'lerden daha fazla yok ?",shape=box,color=blue];
		98 -> 101;
		98 -> 102;
		98 -> 103;
	99 [label="Gerçekten de hayatımın büyük bir bölümünü onlarla birlikte, can yoldaşlarım olarak geçirdim. Gün içinde yaşadığım sıkıntıları dinlemekten büyük keyif alırlar.",shape=box,color=blue];
		99 -> 104;
	100 [label="Hem Mösyö Necraloid'e hem de Mösyö Loid'e sordum, ikisi de konuşmak istemedi, bana sadece bir isim söylediler: Otak. Ve bunu söylerken de çok üzüldüler.",shape=box,color=blue];
		100 -> 105;
	101 [label="Belki de sevdiği kişinin dijital bir kopyasını yapmanın ne kadar korkunç olduğunu fark etmiştir.",shape=box,color=red];
		101 -> 106;
	102 [label="Belki de sadece bir tane yapmayı planlamıştı.",shape=box,color=red];
		102 -> 107;
	103 [label="Emin değilim. Belki de daha fazlasını yapmaya fırsatı olmamıştır?",shape=box,color=red];
		103 -> 108;
	104 [label="Update boolean MarieGraveyard1",color=orange];
		104 -> 109;
		104 -> 110;
	105 [label="İşte bu yüzden sizinle konuşmaya karar verdim, umarım bana yardımcı olabilirsiniz.",shape=box,color=blue];
		105 -> 111;
		105 -> 112;
	106 [label="Ou bien, bu tuhaf laboratuvarın Mösyö Loid olmadan çalışmaya devam edemeyeceğini düşünmesi, onun sevgi ve saygısının bir göstergesiydi.",shape=box,color=blue];
		106 -> 113;
		106 -> 114;
	107 [label="+5 Chemistry",color=orange];
		107 -> 115;
	108 [label="Bir düşünsenize, uçan kafataslarından oluşan bir okul, hiç birinin zahmeti yok ve hepsi mükemmel bir verimlilikle çalışıyor !",shape=box,color=blue];
		108 -> 114;
		108 -> 116;
	109 [label="Mezarlıklara bakmayı sever miydin?",shape=box,color=red];
		109 -> 117;
	110 [label="Hiç cevap verdikleri olur mu?",shape=box,color=red];
		110 -> 118;
	111 [label="Otak hakkında bilgi mi edinmek istiyorsun? Ya da neden onunla konuşamadığını mı öğrenmek istiyorsun?",shape=box,color=red];
		111 -> 119;
	112 [label="Otak'ı anlatmak zor...",shape=box,color=red];
		112 -> 2918;
	113 [label="Bunun tuhaf romantik bir hareket olduğunu söyleyebilirim ama bu konuda ben pek konuşkan biri değilimdir.",shape=box,color=red];
		113 -> 122;
	114 [label="Dürüst olmak gerekirse, evimde vızıldayan bir nekraloid'in olmasından rahatsız olmazdım.",shape=box,color=red];
		114 -> 123;
	115 [label="Kendi çapında hem trajik, hem de güzel. Non ? Bu tuhaf laboratuvarın Mösyö Loid olmadan çalışmaya devam edemeyeceğini düşünmesi, onun sevgi ve saygısının bir göstergesiydi.",shape=box,color=blue];
		115 -> 124;
		115 -> 113;
	116 [label="Dürüst olmak gerekirse, ondan sadece bir tane olmasına seviniyorum. Dünyanın buna hazır olacağını sanmıyorum.",shape=box,color=red];
		116 -> 125;
	117 [label="Ve mozoleler ve türbeleri de, evet. Ama itiraf etmeliyim ki, sandalyem ile gezinmek zor olsa da, açık alanları tercih ederim. Merdivenler gibi korkulacak kadar zor değil.",shape=box,color=blue];
		117 -> 126;
	118 [label="Ah ! Şükürler olsun ki hayır. Ta ki sizin o hasta suratlı \"Nekraloid\" bana cevap verene kadar. Ölülerle konuşmak, Aydınlığın bahşettiği yetenekler arasındaysa, benim bilgim dahilinde değil.",shape=box,color=blue];
		118 -> 127;
	119 [label="Sanırım zamanla her ikisini de öğrenmek istiyorum, ama nereden başlayacağınıza siz karar verin. Hangisinin daha önemli olduğunu bilmiyorum, après tout.",shape=box,color=blue];
		119 -> 2918;
	2918 [label="Check boolean LoidFamilyComplete",color=orange];
		2918 -> 121 [label=true,color=green];
		2918 -> 121 [label=false,color=brown];
		2918 -> 120 [label=false,color=brown];
	122 [label="Ve şimdi meraklandım ama bu başka bir zamanın hikayesi gibi görünüyor. Cela dit...",shape=box,color=blue];
		122 -> 97;
	123 [label="O zaman, muhtemelen arkadaşlık ya da organizasyon ihtiyacıyla, ya da her ikisiyle birden boğuşuyor olabileceğinden eminim. Ama bu başka bir zaman konuşulacak bir konu.",shape=box,color=blue];
		123 -> 97;
	124 [label="Bence bu, başka her şeyden çok, bu yerin parçalanıp dağılmamasını sağlamakla ilgiliydi.",shape=box,color=red];
		124 -> 130;
	125 [label="Aynen öyle ! Ben de öyle düşünüyorum. Bu da beni bir sonraki soruya götürüyor.",shape=box,color=blue];
		125 -> 97;
	126 [label="Update boolean MarieSerum1",color=orange];
		126 -> 131;
		126 -> 132;
	127 [label="Hayır, ruhları ve sesleri duymak sevgili Lyon'umun benden çok daha fazla ilgi alanına giriyor. Yine de, çocuğun kafasının arkasındaki karalamalara bakılırsa, Mösyö Necraloid'in de hayaletler tarafından rahatsız edilip edilmediğini merak ediyorum.",shape=box,color=blue];
		127 -> 133;
	121 [label="Otak eski Arşimetçi, bir Orokin bilim insanı ve akademisyendi. Başına gelenler pek de mutlu bir hikaye sayılmaz.",shape=box,color=red];
		121 -> 129;
	120 [label="Şey... kısacası, Entrati'nin ailesinden bazıları yukarıda ve bizim burada olduğumuzun pek farkında değiller.",shape=box,color=red];
		120 -> 128;
	130 [label="Ve haklı da olabilirsiniz. Uçan amalgam, gerçek Mösyö Loid'in raison d'être ve nüanslarından çok yoksun görünüyor. Cela dit...",shape=box,color=blue];
		130 -> 97;
	131 [label="Serumun ayaklarını değiştirip değiştirmediğini sormak uygun olur mu, emin olamadım...",shape=box,color=red];
		131 -> 136;
	132 [label="Sandalyen mi?",shape=box,color=red];
		132 -> 137;
	133 [label="Aslında bu yüzden buraya gelip sizinle konuşmak istedim, eğer sakıncası yoksa.",shape=box,color=blue];
		133 -> 100;
