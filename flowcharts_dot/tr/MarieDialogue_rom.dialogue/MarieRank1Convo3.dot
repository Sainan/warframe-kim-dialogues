		173 -> 179;
	174 [label="Ce qui est fait est fait. Etrafımda bu kadar çok insan acı çekerken, bu kadar çok insan ihtiyaç içindeyken, Sol'a bir mucize için dua edemezdim. Aydınlık bana zaten çok şey vermişti.",shape=box,color=blue];
		174 -> 180;
	175 [label="Ama her şey gibi ben de sevinçle kabul ettim, Lyon da... ah, sanki onu onu ispiyonluyormuşum gibi hissediyorum ve bunu yapmamalıyım.",shape=box,color=blue];
		175 -> 181;
		175 -> 182;
	172 [label="Pauvre petit...",shape=box,color=blue];
		172 -> 178;
	170 [label="Le Cardinal'in zorunlu ayrılışı sonrasında yaşattığı acıları ve bunu onları korumak için yaptığını anlayabiliyorum...",shape=box,color=blue];
		170 -> 176;
	171 [label="+10 Chemistry",color=orange];
		171 -> 177;
	179 [label="Oui ! Anladın işte. Dünyayı başka bir bakış açısıyla görüyordum. Kollarım daha güçlüydü. Daha sabırlıyım. Anın tadını çıkarmanın ne demek olduğunu biliyorum.",shape=box,color=blue];
		179 -> 190;
	180 [label="Gitmeliyim. Bu harika eğlence için teşekkür ederim. ",shape=box,color=blue];
		180 -> 191;
	181 [label="Sorun değil. Kendini rahat hissettiğin kadarını anlat.",shape=box,color=red];
		181 -> 192;
	182 [label="Lütfen devam et. Ona ulaşmakta zorlanıyorum.",shape=box,color=red];
		182 -> 193;
	178 [label="Bu yüzden, ana necraloide - geriye kalan tek Necraloide - transfer edildi ve... şey? Açıklaması zor.",shape=box,color=red];
		178 -> 187;
		178 -> 188;
		178 -> 189;
	176 [label="Bence bu gereksiz bir zulüm, sizce de öyle değil mi ? Onun öldüğünü düşünebilirler. Ya da daha kötüsünü ! Peki ya biz, burada yaşayan bizler, comme des rats d'égout ?",shape=box,color=blue];
		176 -> 183;
		176 -> 184;
		176 -> 185;
	177 [label="Oui... Buradaki mantığı anlıyorum. Eğer yapabilirseniz, ailesini yeniden bir araya getirmek için çalışırım, non ? Görünüşe göre hepimizin buradan çıkmak için tek umudu bu. ",shape=box,color=blue];
		177 -> 186;
	190 [label="Hedefime ulaştığımda, o anın tadını çıkarırım. Milyarlarca küçük bacağı olan bir böcek gibi oradan oraya koşturmam.",shape=box,color=blue];
		190 -> 202;
