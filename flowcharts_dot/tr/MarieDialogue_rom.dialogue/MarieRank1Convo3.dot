	136 [label="+10 Chemistry",color=orange];
		136 -> 140;
	137 [label="Buna ne isim verirdiniz bilmiyorum ? Un fauteuil roulant, ya da... belki de hiç sevmediğim bir terim olan, un fauteuil pour invalide.",shape=box,color=blue];
		137 -> 141;
	135 [label="Par les Luminaires... lütfen devam edin.",shape=box,color=blue];
		135 -> 139;
	134 [label="Par les Luminaires... Yani sizce hepimiz burada gizlice mi bulunuyoruz ?! Bu yüzden mi buradan ayrılmamıza izin verilmiyor ?! Mais pourquoi ?!",shape=box,color=blue];
		134 -> 138;
	140 [label="Ah ! Ah, zavallıcık. Düşünsenize, orada oturmuş, mes pied'lerimin le Cardinal tarafından benden alınıp alınmadığını merak ediyorsunuz ! Non, non, non - öyle bir şey olmadı.",shape=box,color=blue];
		140 -> 144;
	141 [label="Tıpkı şu anda oturduğumuz gibi, iletişim kurmak için bu sevimli küçük cihazların başında oturmak gibi. Ama yanlarında tekerlekler var, hareket etmek için. İsterseniz tekerlekli bir sandalye de diyebilirsiniz.",shape=box,color=blue];
		141 -> 145;
		141 -> 146;
	139 [label="Genel kanı, onun bir dahi olduğu ve argon kristallerinin işlenmesinin arkasındaki beyin olduğu yönündeydi.",shape=box,color=red];
		139 -> 143;
	138 [label="Kızı Euleria -Anne olarak bilinir- ve ailesi, tüm bu zaman boyunca Deimos'a bakıyorlardı.",shape=box,color=red];
		138 -> 142;
	144 [label="Sol, hayatıma kullanılamaz ayaklarla doğmanın dezavantajını eklemeyi uygun görmüş. Yürüyemiyordum. ",shape=box,color=blue];
		144 -> 149;
	145 [label="Protoframe olmadan önce engelli miydin?",shape=box,color=red];
		145 -> 150;
	146 [label="Biz bunlara tekerlekli sandalye diyoruz, inan ya da inanma.",shape=box,color=red];
		146 -> 151;
	143 [label="Void'den çıkarılanlar ile - güçlü warframe'leri ve silahların çoğunu yaratabilmemizi sağlıyor.",shape=box,color=red];
		143 -> 148;
	142 [label="Onlar burayı ve Origin Sistemine Void enerji pompalayan kalbi koruyorlar, Entrati gittiğinden beri hepimizi... gerçekten de kullanışlı tutuyorlar.",shape=box,color=red];
		142 -> 861;
	149 [label="Ama bu sadece bir rahatsızlıktı.",shape=box,color=blue];
		149 -> 155;
	150 [label="Hayır. Hiç de öyle değildim.",shape=box,color=blue];
		150 -> 156;
	151 [label="Hah ! Ah, şimdi burada kendi aptallığıma nasıl da gülüyorum. Evet, tekerlekli sandalye oldukları için onlara tekerlekli sandalye diyebilirsiniz sanırım. Ne aptalım.",shape=box,color=blue];
		151 -> 155;
	148 [label="Kristalografi konusunda uzmanlaşmıştı. Eserleri burada, laboratuvarlarda arşivleniyordu.",shape=box,color=red];
