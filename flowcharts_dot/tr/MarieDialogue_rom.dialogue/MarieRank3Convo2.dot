		j1827137725 -> j309336948 [label=true,color=green];
		j1827137725 -> j3635524273 [label=false,color=brown];
	j4137197227 [label="Bu harika bir sohbetti, ama korkarım luncheon servis etme sırası bende. Mösyö Loid bana kendi usulünce çay servis etmeyi öğretiyor !",shape=box,color=blue];
		j4137197227 -> "Chat ends.";
	j388328001 [label="Maintenant, vous parlez aussi mal que le diable. Hayır, bu numaralarınız bana işlemez.",shape=box,color=blue];
		j388328001 -> "Chat ends.";
