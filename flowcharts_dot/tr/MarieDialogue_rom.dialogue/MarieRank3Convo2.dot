		j4082398669 -> j50885957;
	j1096066250 [label="Kesinlikle doğru ! Hiç böyle düşünmemiştim. Ve sen de kendininkini seçebilirsin. Ne kadar da özgürleştirici bir düşünce.",shape=box,color=blue];
		j1096066250 -> j4137197227;
	j2676163331 [label="Korkarım ki bir yarısı, kalan diğer yarısını \"öteki aile\" olarak görecek.",shape=box,color=red];
		j2676163331 -> j3211735109;
