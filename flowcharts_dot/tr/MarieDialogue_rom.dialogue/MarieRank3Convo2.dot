		j1668831657 -> j1781713472 [label=false,color=brown];
	j332585989 [label="Bu konuşmaları yaptım... bu insanlarla tanıştım... ama bu imkansız, non ?",shape=box,color=blue];
		j332585989 -> j3576941120;
