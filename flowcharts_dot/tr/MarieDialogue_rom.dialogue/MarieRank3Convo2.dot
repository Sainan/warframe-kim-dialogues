		1023 -> 1025;
	1024 [label="Le Cardinal'den bahsetmişken... Sanırım o, Mösyö Loid'i oldukça derinden incitmiş gibi görünüyor. Bu konuya değinerek onu daha fazla üzmek istemiyorum.",shape=box,color=blue];
