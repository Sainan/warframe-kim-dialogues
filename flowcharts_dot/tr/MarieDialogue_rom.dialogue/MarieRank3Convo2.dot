		j1145399417 -> j4051554974;
	j2840084501 [label="Eğer sadece niyetlerin ardındaki düşüncenin saflığı önemli olsaydı, dünya güzel bir yer olurdu, non ? C'est la vie.",shape=box,color=blue];
		j2840084501 -> j1196483453;
	j3121953645 [label="Tabii ismini kendi kararınla bırakmadığın sürece. Tıpkı Büyükanne gibi.",shape=box,color=red];
		j3121953645 -> j728089036;
	j725512464 [label="Aslında o kadar da kötü değil, zamanla alışıyorsun.",shape=box,color=red];
		j725512464 -> j1840637973;
	j2479063559 [label="Hayvanların isimleri yoktur ve isimsizken bile gayet mutludurlar. Biz onlara sadece kendi keyfimiz için isim veririz.",shape=box,color=red];
		j2479063559 -> j3910898388;
	j2409915532 [label="Tebessüm getiren bir fikir. Ama sonuçlarının iyi olacağını düşünmüyorum.",shape=box,color=red];
		j2409915532 -> j2857490805;
	j4051554974 [label="Umarım bir gün öyle olur. Yürekten diliyorum.",shape=box,color=red];
		j4051554974 -> j3948333923;
	j1196483453 [label="Et ensuite ?",shape=box,color=blue];
		j1196483453 -> j3127378114;
	j728089036 [label="+5 Chemistry",color=orange];
		j728089036 -> j2712629500;
	j1840637973 [label="Aaah ! Quelle horreur ! Bunu demek istememiştim ! Ah, çok utandım ! Çok özür dilerim, beni affet, bunu kastetmemiştim - ah, ne aptalım !",shape=box,color=blue];
		j1840637973 -> j875047248;
		j1840637973 -> j4082398669;
