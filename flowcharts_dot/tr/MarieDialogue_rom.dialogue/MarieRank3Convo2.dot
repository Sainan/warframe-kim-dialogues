		1025 -> 1026;
		1025 -> 1027;
	1026 [label="Kimin hakkında bilgi edinmek istiyorsun?",shape=box,color=red];
		1026 -> 1028;
	1027 [label="Üst katta Anne, Baba, Erkek Evlat, Kız Evlat ve Büyükanne var.",shape=box,color=red];
		1027 -> 1028;
	1028 [label="Öncelikle bazı yerleri açıklığa kavuşturalım olur mu ? Grand-mère.. Büyükanne hakkında her sorduğumda o şeytan bana gülüyor, sanki gizli bir şakaymış gibi.",shape=box,color=blue];
		1028 -> 1029;
	1029 [label="O Kardinal'in eşi değil, non ?",shape=box,color=blue];
		1029 -> 1030;
	1030 [label="Hayır, o 'Baba'nın annesi. 'Anne'nin ise kayınvalidesi.",shape=box,color=red];
		1030 -> 1031;
	1031 [label="Je... vois. Eee... peki neden onlara isimleriyle hitap edilmiyor ? Ne serait-ce pas plus simple ?",shape=box,color=blue];
		1031 -> 1032;
		1031 -> 1033;
	1032 [label="Uzun bir hikaye. Vaktin var mı?",shape=box,color=red];
		1032 -> 1034;
