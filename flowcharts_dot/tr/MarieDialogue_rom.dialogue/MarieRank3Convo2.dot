		1039 -> 1043 [label=false,color=brown];
	1040 [label="Evet. Sentient'lerle savaşmak için Infested'i kontrol altına almaya çalıştılar. Fakat Deimos çok geçmeden istila edildi. Sığınak olarak üstümüzdeki Necralisk'e sığındılar.",shape=box,color=red];
		1040 -> 1044;
