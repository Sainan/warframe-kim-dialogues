		j1781713472 -> j2408606911;
		j1781713472 -> j2025973576;
	j3576941120 [label="+20 Chemistry",color=orange];
		j3576941120 -> j2792102384;
	j1385735087 [label="Bildiğim her şeyi sana anlatacağım. Ama sanırım senin umduğun kadarını bilmiyorum.",shape=box,color=red];
		j1385735087 -> j3837521581;
	j2408606911 [label="Ah. Elbette, ama... bu konuyu Loid'le konuşmak daha iyi olmaz mıydı?",shape=box,color=red];
		j2408606911 -> j4252983211;
	j2025973576 [label="[Son.]",shape=box,color=red];
		j2025973576 -> "Chat ends.";
	j2792102384 [label="Buna déjà vu diyoruz. Sérum ve zaman yolculuğu yüzünden olmalı. C'est la vie !",shape=box,color=blue];
		j2792102384 -> "Chat ends.";
	j3837521581 [label="Bana anlatabileceğin her şeye içtenlikle kulak vereceğim. Promis !",shape=box,color=blue];
		j3837521581 -> j4094453257;
	j4252983211 [label="Le Cardinal'den bahsetmişken... Sanırım o, Mösyö Loid'i oldukça derinden incitmiş gibi görünüyor. Bu konuya değinerek onu daha fazla üzmek istemiyorum.",shape=box,color=blue];
		j4252983211 -> j4094453257;
	"Chat ends." [color=orange];
	j4094453257 [label="Özellikle de bunu hiç kimsenin yapmadığı bir şekilde, avec une certaine joie konuştuğumu göz önüne alırsak.",shape=box,color=blue];
		j4094453257 -> j588371030;
		j4094453257 -> j1955233791;
	j588371030 [label="Kimin hakkında bilgi edinmek istiyorsun?",shape=box,color=red];
		j588371030 -> j3352328566;
	j1955233791 [label="Üst katta Anne, Baba, Erkek Evlat, Kız Evlat ve Büyükanne var.",shape=box,color=red];
		j1955233791 -> j3352328566;
	j3352328566 [label="Öncelikle bazı yerleri açıklığa kavuşturalım olur mu ? Grand-mère.. Büyükanne hakkında her sorduğumda o şeytan bana gülüyor, sanki gizli bir şakaymış gibi.",shape=box,color=blue];
		j3352328566 -> j1814820788;
	j1814820788 [label="O Kardinal'in eşi değil, non ?",shape=box,color=blue];
		j1814820788 -> j2619255130;
	j2619255130 [label="Hayır, o 'Baba'nın annesi. 'Anne'nin ise kayınvalidesi.",shape=box,color=red];
		j2619255130 -> j456510224;
	j456510224 [label="Je... vois. Eee... peki neden onlara isimleriyle hitap edilmiyor ? Ne serait-ce pas plus simple ?",shape=box,color=blue];
		j456510224 -> j1982295441;
		j456510224 -> j2285077446;
	j1982295441 [label="Uzun bir hikaye. Vaktin var mı?",shape=box,color=red];
		j1982295441 -> j1104345530;
	j2285077446 [label="O zaman kısaca özetleyeyim.",shape=box,color=red];
		j2285077446 -> j3535382844;
	j1104345530 [label="Oui ! Zaten bir süreliğine yapacak başka bir işim yok.",shape=box,color=blue];
		j1104345530 -> j3782646955;
	j3535382844 [label="Üst taraftaki aile, Orokin İmparatorluğu çöktüğünde burada mahsur kaldılar. Erkek Evlat, Entrati'nin torunu ise Infested'ın içeri girmesine izin verdi.",shape=box,color=red];
		j3535382844 -> j457928018;
	j3782646955 [label="Pekala, Deimos adlı bir ayda yaşıyorlar. Uzun bir zaman önceki savaşta Sentient'leri püskürtmek için çaresiz bir girişimle burada bir biyolojik bomba patlatıldı.",shape=box,color=red];
		j3782646955 -> j3688473139;
	j457928018 [label="Par Sol ! Kasıtlı olarak mı yaptı ?",shape=box,color=blue];
		j457928018 -> j2753523360;
	j3688473139 [label="Orokin'lerin uzun zaman önce savaştığı şeyler mi ? Karanlık Refraktörde şeytanla birlikte gördüklerimiz yani, oui ?",shape=box,color=blue];
		j3688473139 -> j1262804215;
	j2753523360 [label="Check /Lotus/Scripts/1999/DialogueScriptNodes.lua:IsSyndicateRank(syndicate=EntratiSyndicate, syndicateRank=5)",color=orange];
		j2753523360 -> j656010158 [label=true,color=green];
		j2753523360 -> j1666291511 [label=true,color=green];
		j2753523360 -> j1666291511 [label=false,color=brown];
		j2753523360 -> j2363583877 [label=false,color=brown];
	j1262804215 [label="Evet. Sentient'lerle savaşmak için Infested'i kontrol altına almaya çalıştılar. Fakat Deimos çok geçmeden istila edildi. Sığınak olarak üstümüzdeki Necralisk'e sığındılar.",shape=box,color=red];
		j1262804215 -> j3452234274;
	j656010158 [label="Hayır, sanırım bir kazaydı. Bence niyeti kötü değildi.",shape=box,color=red];
		j656010158 -> j2114581977;
	j1666291511 [label="Gerçeği henüz bilmiyorum ama daha fazlasını öğrenene kadar kesin konuşmayacağım.",shape=box,color=red];
		j1666291511 -> j2114581977;
	j2363583877 [label="Gerçeği henüz bilmiyorum. Ama kendisinin oldukça kibirli biri olduğunu söyleyebilirim.",shape=box,color=red];
		j2363583877 -> j3338377791;
	j3452234274 [label="Ancak Erkek Evlat, yani Entrati'nin torunu, Infested'e maruz kalmış hayvanları korumaya ve incelemeye kararlıydı.",shape=box,color=red];
		j3452234274 -> j3598260669;
	j2114581977 [label="+10 Chemistry",color=orange];
		j2114581977 -> j56716907;
	j3338377791 [label="Yazıklar olsun. Umarım bu doğru değildir, hem onun hem de bizim iyiliğimiz için. Lütfen devam edin.",shape=box,color=blue];
		j3338377791 -> j3127378114;
	j3598260669 [label="Ah, Sol aşkına... niyeti iyi miydi ?",shape=box,color=blue];
		j3598260669 -> j2755410679;
	j56716907 [label="Çok naziksiniz. Continuez, s'il vous plaît.",shape=box,color=blue];
		j56716907 -> j3127378114;
	j3127378114 [label="Necralisk'te kapana kısılmış, keder içinde yitip gitmişlerdi. Onları kurtaracak bir Orokin İmparatorluğu yoktu ve şimdi de Infested içeri sızmaya başlamıştı...",shape=box,color=red];
		j3127378114 -> j1116314938;
