	j3633736404 [label="+5 Chemistry",color=orange];
		j3633736404 -> j2213817993;
	j2581660819 [label="Dikkatli olmamız gerek. Korkarım ki bir yarısı, kalan diğer yarısını \"öteki aile\" olarak görecek.",shape=box,color=red];
		j2581660819 -> j3211735109;
	j3901375077 [label="Yavaşça. Dikkatlice. Korkarım ki bir yarısı, kalan diğer yarısını \"öteki aile\" olarak görecek.",shape=box,color=red];
		j3901375077 -> j3211735109;
	j3864553496 [label="Umarım kendi seçimimdir.",shape=box,color=red];
		j3864553496 -> j4247576654;
	j494743204 [label="Gerçekten hatırlamıyorum.",shape=box,color=red];
		j494743204 -> j3511416757;
	j3250841851 [label="Ah... Par Sol, sanırım bu gizemi çözmüşsün !",shape=box,color=blue];
		j3250841851 -> j2050532062;
	j2213817993 [label="Onları birçok kez şaşırttınız. Bu sefer de onlar sizi şaşırtsın.",shape=box,color=blue];
		j2213817993 -> j557404952;
	j4247576654 [label="Kendi adını seçmek ne kadar özgürleştirici olurdu ! Katédralde kendi kıyafetlerimi bile seçemezdim. Hah !",shape=box,color=blue];
		j4247576654 -> j4137197227;
	j3511416757 [label="Görünüşe göre beraberinde çok sayıda gizémi de getirmişsin ! ",shape=box,color=blue];
		j3511416757 -> j4137197227;
	j2050532062 [label="Boolean MarieFamilyOther is now true.",color=orange];
		j2050532062 -> j2391757706;
	j557404952 [label="Ama lütfen, lütfen, s'il vous plaît, hikayenize devam edin. Küçük kurdunuz Marie, avına çıkmadan önce avını tanımalı, değil mi ?",shape=box,color=blue];
		j557404952 -> j2301411578;
		j557404952 -> j1684508770;
		j557404952 -> j1171003151;
	j2391757706 [label="Çok heyecanlıyım - je suis assise ici, remuant sur ma chaise !",shape=box,color=blue];
		j2391757706 -> j557404952;
	j2301411578 [label="Nerede kalmıştım?",shape=box,color=red];
		j2301411578 -> j2241856350;
	j1684508770 [label="Bu sanki senin karakterine yakışmayan bir sözdü, sence de öyle değil mi?",shape=box,color=red];
		j1684508770 -> j2879902194;
	j1171003151 [label="Belki de beni kovalamasını isterdim...",shape=box,color=red];
		j1171003151 -> j2757858406;
	j2241856350 [label="Erkek Evlat, Animaux Infestési yanına almıştı.",shape=box,color=blue];
		j2241856350 -> j3127378114;
	j2879902194 [label="Peut-être ! Ama iyilik adına biraz çılgınlık yapmanın ne zararı olabilir ki, hm ?",shape=box,color=blue];
		j2879902194 -> j2189030565;
		j2879902194 -> j797893513;
	j2757858406 [label="Boolean DrifterMarie is now true.",color=orange];
		j2757858406 -> j4272460047;
	j2189030565 [label="Tamam... Neyse hikayeye dönelim.",shape=box,color=red];
		j2189030565 -> j3127378114;
	j797893513 [label="Yanlış anlama. Sürpriz oldu ama hoşuma gitti.",shape=box,color=red];
		j797893513 -> j925355358;
	j4272460047 [label="Siz benim sonumu getireceksiniz ! Küçük bir çığlık attım ve Mösyö Loid bana iyi olup olmadığımı sordu. Yalan söylemek zorunda kaldım ve bir fare gördüğümü söyledim, ama o bana bu zamanda fare olmadığını söyledi !",shape=box,color=blue];
		j4272460047 -> j2616478708;
	j925355358 [label="Hah ! Hoşunuza gideceğini biliyordum. Şimdi, saçmalıklarımızı bir kenara bırakıp hikâyenize dönelim. Erkek Evladın Animaux Infestési yanına almıştı, değil mi ?",shape=box,color=blue];
		j925355358 -> j3127378114;
	j2616478708 [label="+5 Chemistry",color=orange];
		j2616478708 -> j2189726668;
