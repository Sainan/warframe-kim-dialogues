		1033 -> 1035;
	1034 [label="Oui ! Zaten bir süreliğine yapacak başka bir işim yok.",shape=box,color=blue];
		1034 -> 1036;
	1035 [label="Üst taraftaki aile, Orokin İmparatorluğu çöktüğünde burada mahsur kaldılar. Erkek Evlat, Entrati'nin torunu ise Infested'ın içeri girmesine izin verdi.",shape=box,color=red];
		1035 -> 1037;
	1036 [label="Pekala, Deimos adlı bir ayda yaşıyorlar. Uzun bir zaman önceki savaşta Sentient'leri püskürtmek için çaresiz bir girişimle burada bir biyolojik bomba patlatıldı.",shape=box,color=red];
		1036 -> 1038;
	1037 [label="Par Sol ! Kasıtlı olarak mı yaptı ?",shape=box,color=blue];
		1037 -> 1039;
