		j50885957 -> j1663243008;
	j3211735109 [label="Add 1 to Family counter",color=orange];
		j3211735109 -> j4111363795;
	j1740385913 [label="Ruhun ne kadar dirençli olduğunu bilseniz şaşırırdınız. Çevremdeki ruhlar oldukça yaşlı, zamanın etkisiyle çok yıpranmış durumdalar.",shape=box,color=blue];
		j1740385913 -> j3633736404;
	j309336948 [label="Bu mümkün. Belki de sandığınızdan daha kolaydır. Sadece nasıl yapacağımızı düşünmeliyiz. ",shape=box,color=blue];
		j309336948 -> j2581660819;
		j309336948 -> j4036604219;
	j3635524273 [label="Oui ? Peki siz veya küçük kopyanızın yukarıdaki aileyle çalışmaları nasıl gidiyor ?",shape=box,color=blue];
		j3635524273 -> j3901375077;
		j3635524273 -> j4036604219;
	j1663243008 [label="Oh, loué soit Sol ! Ama bu da şu soruyu akla getiriyor... \"Le Gezgin\" lakabınız nereden geliyor ?",shape=box,color=blue];
		j1663243008 -> j3864553496;
		j1663243008 -> j494743204;
