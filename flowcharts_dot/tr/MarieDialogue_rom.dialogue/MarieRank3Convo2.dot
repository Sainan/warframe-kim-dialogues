		j2755410679 -> j1314000423 [label=false,color=brown];
	j1116314938 [label="Sonrasında birbirlerine düşman oldular. Birbirlerini içten dışa parçaladılar. Ve kalanları da Infested aldı. İsimlerini böyle kaybettiler. ",shape=box,color=red];
		j1116314938 -> j2145885912;
	j2381218020 [label="Evet, öyle olduğuna inanıyorum. Gerçekten o yaratıkları önemsediğini düşünüyorum.",shape=box,color=red];
		j2381218020 -> j237389585;
	j2822570828 [label="Ne yazık ki şu anda bunun bir önemi yok. Artık çok geç.",shape=box,color=red];
		j2822570828 -> j3836990231;
	j161152808 [label="Hayır, bunu yapmasını sağlayan şey onun kibriydi. Kaza olduğunu iddia etse bile aslında bu sadece kibirdi.",shape=box,color=red];
		j161152808 -> j3338377791;
