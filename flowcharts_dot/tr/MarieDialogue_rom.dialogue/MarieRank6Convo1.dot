		3309 -> 3329;
	3310 [label="Ruh İkizime, daha önce hiç sahip olmadığı bir rahatlık ve huzur getirdiniz. Sizin varlığınız onun için ifade edemeyeceği kadar değerliydi.",shape=box,color=blue];
		3310 -> 3329;
	3311 [label="Kayıtsızlığın gerçek doğasını belki de asla bilemeyeceğiz, ama bunun önemi olmadığını biliyoruz. Onu, gerçek bir zorluk olarak kabul etmeli ve bununla yüzleşmeliyiz.",shape=box,color=blue];
		3311 -> 3329;
	3312 [label="Şeytanımızı, Loid Bey ve le Cardinal''in ailesinin barışmasına yardım etmesi için ikna edebileceğimizi düşünmüyordum. Onun nedenlerinin... şüpheli olduğunu biliyorum, belki de, ve ona hala tam olarak güvenmiyorum. ",shape=box,color=blue];
		3312 -> 3330;
