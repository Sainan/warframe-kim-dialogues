		j2314777629 -> j660294463;
	j1456065771 [label="Birbirimizi güldürme yeteneği. Ağlatma yeteneği. Birbirimizi doğru ya da yanlış olduğuna ikna etme yeteneği. Birbirimizin fikrini değiştirme yeteneği. Acı içinde birbirimizi teselli etme yeteneği. Saf delilikle birbirimizi incitme yeteneği.",shape=box,color=blue];
		j1456065771 -> j1339695018;
	j2111232233 [label="Peki ya siz Lyon'a en karanlık saatlerinde rehberlik etmek ve acı ve ızdırap dolu anlarında onu desteklemek için orada olduğunuzda ne fark eder ki ?",shape=box,color=blue];
		j2111232233 -> j3951697458;
