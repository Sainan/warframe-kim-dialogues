		j40426285 -> j1456065771;
	j2534729701 [label="Ruh ikizime büyük bir huzur getirdiniz. Onu, savaşmamız gereken gerçek bir düşmanımız olduğuna ikna ettiniz ve ona yeniden umut verdiniz.",shape=box,color=blue];
		j2534729701 -> j2111232233;
	j1363728280 [label="Ruh İkizime, daha önce hiç sahip olmadığı bir rahatlık ve huzur getirdiniz. Sizin varlığınız onun için ifade edemeyeceği kadar değerliydi.",shape=box,color=blue];
		j1363728280 -> j2111232233;
	j905012649 [label="Kayıtsızlığın gerçek doğasını belki de asla bilemeyeceğiz, ama bunun önemi olmadığını biliyoruz. Onu, gerçek bir zorluk olarak kabul etmeli ve bununla yüzleşmeliyiz.",shape=box,color=blue];
		j905012649 -> j2111232233;
	j1024716035 [label="Şeytanımızı, Loid Bey ve le Cardinal''in ailesinin barışmasına yardım etmesi için ikna edebileceğimizi düşünmüyordum. Onun nedenlerinin... şüpheli olduğunu biliyorum, belki de, ve ona hala tam olarak güvenmiyorum. ",shape=box,color=blue];
		j1024716035 -> j1122850108;
	j2048202590 [label="Şeytanımızın hatalarını anlayabileceğini hiç düşünmemiştim. Aldığı masum hayatlar için en ufak bir pişmanlık duyabileceğini. Siz bana bunun aksini kanıtladınız.",shape=box,color=blue];
		j2048202590 -> j631720795;
	j2994144778 [label="Şeytanımızı hangi zincirlere bağlarsanız bağlayın, onu tasmalı tutuyorlar. Eskiye nazaran... daha sakin görünüyor. Ve bunun için size teşekkür etmeliyiz.",shape=box,color=blue];
		j2994144778 -> j631720795;
