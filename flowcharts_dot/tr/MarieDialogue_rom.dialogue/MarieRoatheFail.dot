	j4281189104 [label="Roathe'ı Loid ve Entrati ailesini yeniden bir araya getirmemize yardım etmesi için ikna etmeye çalışıyorum. Ama serumu alma konusunda inatçı davranıyor. Onunla konuşmak için yardımına ihtiyacım var.",shape=box,color=red];
		j4281189104 -> j2525660442;
	j35329381 [label="Roathe'ye değişme gücünün olduğunu, geçmişteki hatalarını affedebileceğini anlatmaya çalışıyorum. Ve bunu başarmak için senin yardımına ihtiyacım var.",shape=box,color=red];
		j35329381 -> j700781268;
	j3636395879 [label="Roathe yaptıkları yüzünden içten içe kendini yiyor. Ve senin yardımın olmadan, kim olduğunu kabul etmezse kendini mahvetmeye devam edeceğinden endişeleniyorum.",shape=box,color=red];
		j3636395879 -> j2083182219;
	j262422691 [label="Roathe serumla ilgili gerçeği öğrendi. İsteyerek aldığını. Ve bu onu mahvediyor. Onu sakinleştirmen için yardımına ihtiyacım var.",shape=box,color=red];
		j262422691 -> j2525660442;
	j3911537036 [label="Roathe beni deli ediyor. Onunla nasıl konuşacağımı bilmiyorum. Tavsiyen var mı?",shape=box,color=red];
		j3911537036 -> j2525660442;
	j2525660442 [label="Hayır, eğer o şeytanla konuşmakta iyi olsaydım, ona her zaman Gaullique dilinde bağırıyor olur muydum sanıyorsunuz ?",shape=box,color=blue];
