		1688 -> 1686;
	1689 [label="Hayır, bu bir oyun değil. Ama Entrati'ye güvenilmez ve seni ikna etmenin başka bir yolunu bilmiyorum, sadece senin tarafındaymış gibi davranmak istiyorum.",shape=box,color=red];
		1689 -> 1695;
