		j1932961349 -> j4051528022;
	j1773381162 [label="Hayır, bu bir oyun değil. Ama Entrati'ye güvenilmez ve seni ikna etmenin başka bir yolunu bilmiyorum, sadece senin tarafındaymış gibi davranmak istiyorum.",shape=box,color=red];
		j1773381162 -> j1055978724;
