		1729 -> 1728;
	1730 [label="Teşekkür ederim. Başarabilecek misiniz bilmiyorum ama bazen denemekten başka çaremiz olmaz.",shape=box,color=blue];
		1730 -> 1728;
	1731 [label="O bizi çok seviyor, nazik ve kibar. Ama biz yeni gelenleriz onun için étranger konumundayız.",shape=box,color=blue];
