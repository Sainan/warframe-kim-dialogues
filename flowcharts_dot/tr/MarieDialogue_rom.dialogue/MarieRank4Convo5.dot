		j907566170 -> j1203853403;
	j924179434 [label="Le Cardinal'in ruhu için verilen bu savaşta benim yanımda olduğunuzu biliyorum ve bunun için size sonsuza dek minnettar kalacağım.",shape=box,color=blue];
		j924179434 -> j3504894843;
	j3024454658 [label="Onun hakkında bir yargıya varmadığınızı biliyorum, bu yüzden size çok minnettarım.",shape=box,color=blue];
		j3024454658 -> j3504894843;
	j3504894843 [label="Diğerlerinin onu hemen suçladığını biliyorum, ama bir bütün olabileceğimiz halde bölünmemizi ve kan kaybetmemizi istemiyorum.",shape=box,color=blue];
		j3504894843 -> j491492742;
	j2187226856 [label="Oui, ama Mösyö Tagfer'den öğrendiğim kadarıyla, her vakayı aynı kefeye koymamak lazım.",shape=box,color=blue];
		j2187226856 -> j4051528022;
	j808688127 [label="Ve ben de, sizin bana “nazikçe” işaret ettiğiniz gibi, her şeyin aynı derecede olmadığını öğreniyorum, non ?",shape=box,color=blue];
		j808688127 -> j1203853403;
	j734316391 [label="Oui, evet ! Le Cardinal'in ayrılmasından dolayı onu suçlamıyorum, zira onun eseri kutsaldır -",shape=box,color=blue];
		j734316391 -> j3504894843;
	j1832170030 [label="Ve Le Cardinal'in böyle yaralara sebep olduğu için korkunç bir canavar olduğuna inandığını biliyorum.",shape=box,color=blue];
		j1832170030 -> j1203853403;
	j4014099913 [label="Le Cardinal'ın ruhu için verdiğim bu savaşta benim tarafımda olduğunuzu biliyorum ve bunun için size sonsuza kadar minnettar kalacağım.",shape=box,color=blue];
		j4014099913 -> j3504894843;
	j2264949130 [label="Ve diğerleri acılarından dolayı onu suçlarken, ben sadece bizim bölündüğümüzü ve acı çektiğimizi görmek istemiyorum.",shape=box,color=blue];
		j2264949130 -> j491492742;
	j2287473004 [label="Peki dikkatinizi ne dağıtabilir ki ? Oturup insanların mécontents'lerini dinlemekten daha önemli ne olabilir ki ?",shape=box,color=blue];
		j2287473004 -> j1944891080;
	j1751400191 [label="Oturup insanların mécontents'lerini çözümlemenin ne zorluğu olabilir ki ?",shape=box,color=blue];
		j1751400191 -> j1182376660;
	j1176730458 [label="Ah, magnifique !",shape=box,color=blue];
		j1176730458 -> j613337602;
	j750158473 [label="Onlar burayı ve Origin Sistemine Void enerji pompalayan kalbi koruyorlar, Entrati gittiğinden beri hepimizi... gerçekten de kullanışlı tutuyorlar.",shape=box,color=red];
		j750158473 -> j3916832970;
	j4070837741 [label="Bilmiyorum çünkü Entrati'nin sandalyelerine yönelik bir talep olacağından emin değilim...",shape=box,color=red];
		j4070837741 -> j2375680201;
	j3164886075 [label="Sonunda pazarı doyurmuş olmaz mıyız? Onları çok düşük fiyatlara satmak zorunda kalırız...",shape=box,color=red];
		j3164886075 -> j2375680201;
	j2107603588 [label="Harika. Bunda bir sorun görmüyorum.",shape=box,color=red];
		j2107603588 -> j1169732459;
	j1203853403 [label="Ve bu iki konunun birbiriyle kaçınılmaz bir şekilde bağlantılı olduğunu anlasam da, bugün verimli olmanızı rica ediyorum, oui ?",shape=box,color=blue];
		j1203853403 -> j1932961349;
	j2040389385 [label="Bu aldatmacanız da ne oluyor, kurt ? Yoksa küçük Marie sizin için sadece bir oyundan mı ibaret ?",shape=box,color=blue];
		j2040389385 -> j1773381162;
		j2040389385 -> j2233377576;
	j3942890966 [label="Onun eylemlerinin gerekliliği konusunda henüz karar veremedim. Ama onun duyarsızlığı tartışılmaz.",shape=box,color=red];
		j3942890966 -> j1203853403;
	j2233377576 [label="Rol yapmaktan yoruldum, üzgünüm.",shape=box,color=red];
		j2233377576 -> j1827902492;
