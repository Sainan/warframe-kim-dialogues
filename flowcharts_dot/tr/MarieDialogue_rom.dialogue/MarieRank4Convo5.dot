	1713 [label="+5 Chemistry",color=orange];
		1713 -> 1717;
	1714 [label="Non, şeytan olmaz - hem de hiç olmaz. Ama bir şeylerin peşindesiniz. Doğal tercih Mösyö Loid, non ?",shape=box,color=blue];
		1714 -> 1718;
	1715 [label="Bence bu gereksiz bir zulüm, sizce de öyle değil mi ? Onun öldüğünü düşünebilirler. Ya da daha kötüsünü ! Peki ya biz, burada yaşayan bizler, comme des rats d'égout ?",shape=box,color=blue];
		1715 -> 1719;
		1715 -> 1720;
		1715 -> 1721;
	1716 [label="Korkarım ki, hayatımızın geri kalanını burada, lağım fareleri gibi kapana kısılmış şekilde geçireceğiz. ",shape=box,color=blue];
		1716 -> 1722;
		1716 -> 1723;
	1717 [label="Oui, oui ! C'est ça ! Ama onu nasıl ikna edeceğiz ? O, tutumunda kararlıydı, non ?",shape=box,color=blue];
		1717 -> 1724;
		1717 -> 1725;
	1718 [label="Ama onu nasıl ikna edeceğiz ? O, tutumunda kararlıydı, non ?",shape=box,color=blue];
		1718 -> 1725;
		1718 -> 1724;
	1719 [label="Aslında sıçanları seven bir arkadaşım var. Bence çok tatlılar.",shape=box,color=red];
		1719 -> 1726;
	1720 [label="Aslında bu benim verebileceğim bir karar değil.",shape=box,color=red];
		1720 -> 1727;
	1721 [label="Ne yapmamı önerirsin?",shape=box,color=red];
		1721 -> 1728;
	1722 [label="Aslında sıçanları seven bir arkadaşım var. Bence çok tatlılar. ",shape=box,color=red];
		1722 -> 1729;
