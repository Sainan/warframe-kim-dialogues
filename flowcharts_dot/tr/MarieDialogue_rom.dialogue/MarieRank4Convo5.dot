		1710 -> 1715;
	1711 [label="Oui... Buradaki mantığı anlıyorum. Eğer yapabilirseniz, ailesini yeniden bir araya getirmek için çalışırım, non ? Görünüşe göre hepimizin buradan çıkmak için tek umudu bu. ",shape=box,color=blue];
		1711 -> 1716;
