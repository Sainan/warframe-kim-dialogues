		1677 -> 1678;
	1678 [label="Sadece, sorunları çözülmeden onların masasına davet edilmeyi umut edemeyeceğimizden endişeleniyorum. Asıl büyük sorun hala çözümsüz durumda -",shape=box,color=blue];
		1678 -> 1637;
