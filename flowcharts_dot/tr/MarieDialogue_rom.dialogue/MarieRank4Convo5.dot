		1674 -> 1685;
	1676 [label="Şaka yapıyorum, şaka ! Ne kadar meşgul olduğunuzu ve size hangi yerlerde ve hangi zamanlarda ihtiyaç duyulduğunu tahmin bile edemiyorum.",shape=box,color=blue];
		1676 -> 1678;
