		j2375680201 -> j3818453962;
	j1169732459 [label="Senin alaycı tavrını görmezden geleceğim, çünkü bunun değerli bir deney olduğunu düşünüyorum. Belki de şeytanı kitaplıklarla çevrili bir denizde hapsedebiliriz !",shape=box,color=blue];
		j1169732459 -> j3818453962;
