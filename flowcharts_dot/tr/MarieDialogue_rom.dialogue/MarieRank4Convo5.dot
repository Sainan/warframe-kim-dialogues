		j3679940472 -> j750158473;
	j8599124 [label="Mobilyaların hepsini taşısak, ve yerlerine yenilerini koymalarını beklesek, sonra da bunu sürekli tekrarlasak ne olabilir ki ? Biriken fazlalığı satabiliriz ! Bu mobilier étrange işi sayesinde kâr edebiliriz !",shape=box,color=blue];
		j8599124 -> j4070837741;
		j8599124 -> j3164886075;
		j8599124 -> j2107603588;
	j2631971554 [label="Le Cardinal hakkında çözülmemiş anlaşmazlıklarımızın farkındayım. Bu konuşmayı medeni bir şekilde sürdürmeye çalışıyorum.",shape=box,color=blue];
		j2631971554 -> j1203853403;
	j816744599 [label="Suçlu olduğunu düşündüğünüz kişileri işaret etme fırsatı bulmadan anlaşmazlıkları gidermeyi tartışmak istememenizi anlıyorum.",shape=box,color=blue];
		j816744599 -> j1203853403;
	j3748906062 [label="Oui ! Bana sık sık hatırlattığınız gibi, onun bir monstre olduğuna inanıyorsunuz ! Kalbinde sadece kin ve boşluk olduğuna !",shape=box,color=blue];
		j3748906062 -> j1203853403;
	j841817811 [label="Le Cardinal'in ruhu için verilen bu savaşta benim tarafımda olduğunuzu sanıyordum ?",shape=box,color=blue];
		j841817811 -> j2040389385;
	j2070090659 [label="Le Cardinal konusunda kararınızı henüz vermediğinizi sanıyordum ? Yoksa durum şimdi değişti mi ?",shape=box,color=blue];
		j2070090659 -> j3942890966;
		j2070090659 -> j2233377576;
	j3480874669 [label="Oui. Bunu Mösyö Tagfer'den öğreniyorum...",shape=box,color=blue];
		j3480874669 -> j4051528022;
	j1878802976 [label="Bana kabuk bağlamış yaralardan bahsetmeyin kurt. Ben hâlâ Le Cardinal hakkındaki son konuşmamızdan kalan yaralarımı sindirmeye çalışıyorum.",shape=box,color=blue];
		j1878802976 -> j1203853403;
	j4207274571 [label="Oui, ama daha önce de söylediniz - hepimiz bu yaralar için birbirimizi suçlamayı bırakmalıyız.",shape=box,color=blue];
		j4207274571 -> j2282377498;
