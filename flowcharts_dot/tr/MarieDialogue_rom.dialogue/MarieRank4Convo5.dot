		j4051528022 -> j2282377498;
	j2282377498 [label="Ben de Le Cardinal'i suçlamaya katılmıyorum, ama bir bütün olabileceğimiz halde bölünmemizi ve kan kaybetmemizi de istemiyorum.",shape=box,color=blue];
		j2282377498 -> j120629050;
		j2282377498 -> j3305349787;
	j491492742 [label="Hepimiz, kimin nihai olarak hatalı olduğuna bakmaksızın, çektiğimiz bu acılar için birbirimizi suçlamayı bırakmalıyız.",shape=box,color=blue];
		j491492742 -> j120629050;
		j491492742 -> j3305349787;
	j1944891080 [label="Şaka yapıyorum, şaka ! Ne kadar meşgul olduğunuzu ve size hangi yerlerde ve hangi zamanlarda ihtiyaç duyulduğunu tahmin bile edemiyorum.",shape=box,color=blue];
		j1944891080 -> j613337602;
	j1182376660 [label="Şaka yapıyorum, şaka ! Nelere katlandıklarını tahmin bile edemiyorum. Ve bunu çözmenin sizin için ne kadar zor olduğunu da.",shape=box,color=blue];
		j1182376660 -> j613337602;
	j613337602 [label="Sadece, sorunları çözülmeden onların masasına davet edilmeyi umut edemeyeceğimizden endişeleniyorum. Asıl büyük sorun hala çözümsüz durumda -",shape=box,color=blue];
