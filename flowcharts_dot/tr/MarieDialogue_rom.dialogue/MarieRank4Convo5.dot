		1661 -> 1680;
	1657 [label="Oui ! Bana sık sık hatırlattığınız gibi, onun bir monstre olduğuna inanıyorsunuz ! Kalbinde sadece kin ve boşluk olduğuna !",shape=box,color=blue];
		1657 -> 1680;
