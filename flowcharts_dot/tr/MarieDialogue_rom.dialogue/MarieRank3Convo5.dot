		1307 -> 1316;
	1308 [label="Bunun için bir kelimemiz var: ennui. Her şeyi anlamsız kılan bir yorgunluk ve hoşnutsuzluk.",shape=box,color=blue];
		1308 -> 1317;
	1309 [label="Dolacak ve dökülecek. Hatta içindekiler bile dökülecek. Ve her şey tam une catastrophe gibi görünecek. ",shape=box,color=blue];
		1309 -> 1318;
	1312 [label="Bir ruh, taşıdığı inançtan daha fazlasıdır. Ben une Sœur de Sol, ama umarım bende bundan daha fazlasını görüyorsunuzdur, non ?",shape=box,color=blue];
		1312 -> 1322;
	1313 [label="Ama bence komik değil.",shape=box,color=blue];
		1313 -> 1323;
	1314 [label="Umarım bu iyi niyetli bir davranıştır ve benimle dalga geçmek için yapılan acımasız bir şaka değildir. Bu yüzden, Sol'un örneğini takip etmeyi seçeceğim -",shape=box,color=blue];
		1314 -> 1324;
	1319 [label="Ben asker olmak için eğitilmedim. O çocuk gibi değilim. Sen de öyle değilsin.",shape=box,color=red];
		1319 -> 1328;
