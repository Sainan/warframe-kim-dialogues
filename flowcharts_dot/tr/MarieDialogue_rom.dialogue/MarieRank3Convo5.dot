		1320 -> 1329;
	1321 [label="Kafamdaki görüntü beni çileden çıkaracak. Nefes almadan önce söyleyiniz bana - neye atıfta bulunuyorsunuz?",shape=box,color=blue];
		1321 -> 1319;
