		65 -> 67;
	66 [label="Non, o yeni şeylerle başa çıkmakta oldukça iyidir. Aşağıdaki sığınaklarda dolaşan makineleri inceleyip çok geçmeden kendi tasarımlarını yapmış olmasına hiç saşırmam.",shape=box,color=blue];
