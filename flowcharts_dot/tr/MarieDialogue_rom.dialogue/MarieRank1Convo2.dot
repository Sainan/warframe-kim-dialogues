		j815344891 -> j380756243;
	j1803375728 [label="Ha! O tanıdığım en hızlı öğrenenlerdendir, Gezgin! Yerinizde olsam, bulmacalarda parasına bahse girerek ona meydan okumazdım.",shape=box,color=blue];
		j1803375728 -> j380756243;
	j3734265395 [label="Non, o yeni şeylerle başa çıkmakta oldukça iyidir. Aşağıdaki sığınaklarda dolaşan makineleri inceleyip çok geçmeden kendi tasarımlarını yapmış olmasına hiç saşırmam.",shape=box,color=blue];
		j3734265395 -> j380756243;
	j380756243 [label="O, sadece sizi tanımıyor. Lyon en iyi zamanlarında bile... sosyal biri değildir. Bu sizi kırmak için söylenmiş bir şey değil.",shape=box,color=blue];
