	j2361628481 [label="Öyle mi ! Oh, comme c'est fascinant ! Birinin geleceğe bu kadar bağlı olduğunu düşünmek, cela remplit mon cœur de joie. Sevinçten uçuyorum. Gerçi geçmişte geçirdiğiniz zamanınızın buna bir katkısı da olabilir, değil mi ? Ah, her neyse.",shape=box,color=blue];
