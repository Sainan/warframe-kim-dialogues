	j811079253 [label="Cevabınıza saygı duyuyorum. Ama sormam gerek, nasıl bu kadar emin olabiliyorsunuz ? Bu da bir tür inanç değil mi ? Peki bu... Tanrı değilse, Kayıtsızlık dediğiniz şey mi oluyor ?",shape=box,color=blue];
