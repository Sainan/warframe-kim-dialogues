	303 [label="Umarım sorularımı kabalık olarak algılamıyorsunuzdur, fakat oldukça meraklıyım. Bir inancınız var mı ? Aydınlığa veya farklı bir şeye inanıyor musunuz ?",shape=box,color=blue];
