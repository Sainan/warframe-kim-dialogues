	326 [label="Ah, oui. Bir göçebe, bu sizin adınızdan belli. Birçok kültür, birçok inanç, birçok dünya gördünüz. Cela est très spirituel, non ? Bunlardan deniz kabukları gibi parçalar topladınız.",shape=box,color=blue];
		326 -> 336;
		326 -> 337;
