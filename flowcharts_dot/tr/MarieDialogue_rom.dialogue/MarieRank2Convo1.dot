	317 [label="İnancın adı ne olursa olsun, onda bir güzellik bulurum. Söyle bana, yeni mi ? Eski mi ? Biliyor olabilir miyim ?",shape=box,color=blue];
		317 -> 324;
		317 -> 325;
	316 [label="Öyle mi ! Oh, comme c'est fascinant ! Birinin geleceğe bu kadar bağlı olduğunu düşünmek, cela remplit mon cœur de joie. Sevinçten uçuyorum. Gerçi geçmişte geçirdiğiniz zamanınızın buna bir katkısı da olabilir, değil mi ? Ah, her neyse.",shape=box,color=blue];
		316 -> 323;
	315 [label="Cevabınıza saygı duyuyorum. Ama sormam gerek, nasıl bu kadar emin olabiliyorsunuz ? Bu da bir tür inanç değil mi ? Peki bu... Tanrı değilse, Kayıtsızlık dediğiniz şey mi oluyor ?",shape=box,color=blue];
