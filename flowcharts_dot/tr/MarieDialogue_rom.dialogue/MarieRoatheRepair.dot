		j1411497914 -> j2457964748;
		j1411497914 -> j1425009898;
	j4159341884 [label="Ve itiraf ediyorum ki... burada, hiçbir çarem olmadan sıkışıp kalmaktan oldukça yoruluyorum.",shape=box,color=blue];
		j4159341884 -> j512845424;
	j3135061957 [label="Ama onun sözlerine değil, zekasına teşekkür etmelisiniz. Beni Mösyö Loid ile bir araya getirdi.",shape=box,color=blue];
