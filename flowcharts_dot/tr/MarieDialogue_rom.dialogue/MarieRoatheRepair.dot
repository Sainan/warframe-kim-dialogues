	j3151953893 [label="Boolean MarieFamilySuccess is now true.",color=orange];
		j3151953893 -> j2529015854;
	j1795216093 [label="Loid'in berrak zihni, kendi yanılsamalarımın ötesini görmemi sağladı. Çünkü Loid, le Cardinal'i - onun Albrecht'ini - seviyor, ancak onun kusurlarını da biliyor.",shape=box,color=blue];
		j1795216093 -> j1541312226;
	j2570228880 [label="Evet, öyle. Yine de tüm kusurlarına rağmen onu görebiliyorum. Ve bu net görüş, benim bulanık merceklerimin ötesini görmemi sağladı.",shape=box,color=blue];
		j2570228880 -> j1541312226;
