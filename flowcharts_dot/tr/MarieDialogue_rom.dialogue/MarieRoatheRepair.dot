	j306377222 [label="Doğru.",shape=box,color=red];
		j306377222 -> j2814986174;
	j81523925 [label="Çok özür dilerim. Seni kırdığımı biliyorum. Ve bunu istememiştim. İnan bana, yapmak istediğim son şey buydu.",shape=box,color=red];
		j81523925 -> j1411497914;
	j4177712951 [label="Je vais le tuer ! Je savais que ce démon était rempli de la pire merde qui soit ! Je vais renvoyer ses conscrits d'où ils viennent par la peau des fesses !",shape=box,color=blue];
		j4177712951 -> "Chat ends.";
	j2471187589 [label="Siz yokken o zaten ikna edici bir konuşma yaptı, bu yüzden kısa keseceğim. Ve şeytanın doğası gereği, bunun için oldukça iyi argümanlar öne sürdü.",shape=box,color=blue];
		j2471187589 -> j4159341884;
	j2814986174 [label="Siz yokken o zaten ikna edici bir konuşma yaptı, bu yüzden kısa keseceğim. Ve şeytanın doğası gereği, bunun için oldukça iyi argümanlar öne sürdü.",shape=box,color=blue];
		j2814986174 -> j3135061957;
