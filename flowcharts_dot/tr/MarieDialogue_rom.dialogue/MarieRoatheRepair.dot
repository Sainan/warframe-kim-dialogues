	3860 [label="Bunu çok isterim, Marie.",shape=box,color=red];
		3860 -> 3862;
	3861 [label="Tekrar düşündüm de, iyiyim.",shape=box,color=red];
		3861 -> 3863;
	3862 [label="Ah ! Beni çok mutlu ettiniz !",shape=box,color=blue];
