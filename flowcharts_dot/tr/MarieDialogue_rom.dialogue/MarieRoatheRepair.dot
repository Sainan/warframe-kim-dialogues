	j1104200239 [label="Şeytan peşimde. O küçük şeytanlarıyla beni sürekli rahatsız ediyor ! Hepsi sizin için ! Mösyö Loid'i yukarı çıkarmanıza yardım etmemi mi görüşmek istiyorsunuz ?",shape=box,color=blue];
		j1104200239 -> j3265448777;
		j1104200239 -> j2553314169;
	j3438487420 [label="Şeytan peşimde. Küçük canavarlarıyla beni durmadan rahatsız ediyor ! Hepsi sizin için ! Le Cardinal'e olan yükümlülüğümü sizinle yeniden görüşmek istediğini söylüyor.",shape=box,color=blue];
