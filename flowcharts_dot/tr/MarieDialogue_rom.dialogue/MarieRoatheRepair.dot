	j1425009898 [label="Önemli değil. Bu açıkça bir hataydı.",shape=box,color=red];
		j1425009898 -> j1451151336;
	j512845424 [label="Tamam. Size yardım edeceğim. Yardımınızı alacaksınız.",shape=box,color=blue];
