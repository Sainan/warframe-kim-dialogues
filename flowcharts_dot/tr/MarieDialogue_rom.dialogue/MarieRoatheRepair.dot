		3816 -> 3819 [label="RoatheMarieEntratiDeal, MarieEntratiCompleteC",color=purple];
		3816 -> 3820 [label="false",color=purple];
	3817 [label="Gezgin. Şeytan peşimde. Küçük şeytanlarıyla beni sürekli sinirlendiriyor. Hepsi sizin adınıza ! Sizin sadece diz çöküp özür dilemek istediğinizi iddia ediyor.",shape=box,color=blue];
		3817 -> 3821;
		3817 -> 3822;
	3818 [label="Şeytan peşimde. O küçük şeytanlarıyla beni sürekli rahatsız ediyor ! Hepsi sizin için ! Mösyö Loid'i yukarı çıkarmanıza yardım etmemi mi görüşmek istiyorsunuz ?",shape=box,color=blue];
		3818 -> 3823;
		3818 -> 3824;
	3819 [label="Şeytan peşimde. Küçük canavarlarıyla beni durmadan rahatsız ediyor ! Hepsi sizin için ! Le Cardinal'e olan yükümlülüğümü sizinle yeniden görüşmek istediğini söylüyor.",shape=box,color=blue];
		3819 -> 3825;
		3819 -> 3826;
	3820 [label="Chat ends.",color=orange];
	3821 [label="Doğru.",shape=box,color=red];
		3821 -> 3827;
	3822 [label="Öyle mi dedi?",shape=box,color=red];
		3822 -> 3828;
	3823 [label="Doğru.",shape=box,color=red];
		3823 -> 3829;
	3824 [label="Öyle mi dedi?",shape=box,color=red];
		3824 -> 3828;
	3825 [label="Doğru.",shape=box,color=red];
		3825 -> 3830;
	3826 [label="Öyle mi dedi?",shape=box,color=red];
		3826 -> 3828;
	3827 [label="Çok özür dilerim. Seni kırdığımı biliyorum. Ve bunu istememiştim. İnan bana, yapmak istediğim son şey buydu.",shape=box,color=red];
		3827 -> 3831;
	3828 [label="Je vais le tuer ! Je savais que ce démon était rempli de la pire merde qui soit ! Je vais renvoyer ses conscrits d'où ils viennent par la peau des fesses !",shape=box,color=blue];
		3828 -> 3832;
	3829 [label="Siz yokken o zaten ikna edici bir konuşma yaptı, bu yüzden kısa keseceğim. Ve şeytanın doğası gereği, bunun için oldukça iyi argümanlar öne sürdü.",shape=box,color=blue];
		3829 -> 3833;
	3830 [label="Siz yokken o zaten ikna edici bir konuşma yaptı, bu yüzden kısa keseceğim. Ve şeytanın doğası gereği, bunun için oldukça iyi argümanlar öne sürdü.",shape=box,color=blue];
		3830 -> 3834;
	3831 [label="Peki neden ?",shape=box,color=blue];
		3831 -> 3835;
		3831 -> 3836;
	3832 [label="Chat ends.",color=orange];
	3833 [label="Ve itiraf ediyorum ki... burada, hiçbir çarem olmadan sıkışıp kalmaktan oldukça yoruluyorum.",shape=box,color=blue];
		3833 -> 3837;
	3834 [label="Ama onun sözlerine değil, zekasına teşekkür etmelisiniz. Beni Mösyö Loid ile bir araya getirdi.",shape=box,color=blue];
		3834 -> 3838;
		3834 -> 3839;
	3835 [label="[Duygularını itiraf et.] Çünkü sana çok değer veriyorum Marie. Sana hayranım.",shape=box,color=red];
		3835 -> 3840;
	3836 [label="Önemli değil. Bu açıkça bir hataydı.",shape=box,color=red];
		3836 -> 3841;
	3837 [label="Tamam. Size yardım edeceğim. Yardımınızı alacaksınız.",shape=box,color=blue];
		3837 -> 3842;
	3838 [label="Ah?",shape=box,color=red];
		3838 -> 3843;
	3839 [label="Ama Loid Albrecht'i seviyor. Değil mi?",shape=box,color=red];
		3839 -> 3844;
	3840 [label="Ağzımdan laf kaçıracağımı biliyordum. Ve işte, kaçırdım da.",shape=box,color=red];
		3840 -> 3845;
	3841 [label="Siz de onun kadar kötüsünüz.",shape=box,color=blue];
		3841 -> 3846;
	3842 [label="Update boolean MarieFamilySuccess",color=orange];
		3842 -> 3847;
	3843 [label="Loid'in berrak zihni, kendi yanılsamalarımın ötesini görmemi sağladı. Çünkü Loid, le Cardinal'i - onun Albrecht'ini - seviyor, ancak onun kusurlarını da biliyor.",shape=box,color=blue];
		3843 -> 3848;
	3844 [label="Evet, öyle. Yine de tüm kusurlarına rağmen onu görebiliyorum. Ve bu net görüş, benim bulanık merceklerimin ötesini görmemi sağladı.",shape=box,color=blue];
		3844 -> 3848;
	3845 [label="Dikkatini çekmek için Roathe'a başvurduğum için çok üzgünüm, ama başka kime başvuracağımı bilemedim.",shape=box,color=red];
		3845 -> 3849;
	3846 [label="Chat ends.",color=orange];
	3847 [label="Update boolean MarieFamilyFail",color=orange];
		3847 -> 3850;
	3848 [label="Çünkü başka bir insanı sevmek, onun tüm güçlü ve zayıf yönlerini kabul etmekten başka ne anlama gelir ki, après tout ?",shape=box,color=blue];
		3848 -> 3851;
	3849 [label="Ah, Gezgin... zavallı Gezgin'cim. Af dilemek için bu kadar uğraşmanıza gerek yoktu. ",shape=box,color=blue];
		3849 -> 3852;
	3850 [label="Chat ends.",color=orange];
	3851 [label="Update boolean MarieEntratiCompleteA",color=orange];
		3851 -> 3853;
	3852 [label="Bana sorsaydınız, sizi affederdim. Zaten kalbimde bir yeriniz var, anlıyor musunuz ?",shape=box,color=blue];
		3852 -> 3854;
		3852 -> 3855;
	3853 [label="Update boolean MarieEntratiCompleteB",color=orange];
		3853 -> 3856;
	3854 [label="Ben... anlıyor muyum?",shape=box,color=red];
		3854 -> 3857;
	3855 [label="Ama o kadar çok sıkıntı çektim ki...",shape=box,color=red];
		3855 -> 3858;
	3856 [label="Update boolean MarieEntratiCompleteC",color=orange];
		3856 -> 3859;
	3857 [label="Oui ! Eğer benimle birlikte olmak istiyorsanız, bunu da isterim.",shape=box,color=blue];
		3857 -> 3860;
		3857 -> 3861;
	3858 [label="Ve bu benim değil, sizin hatanız ! Ama eğer benimle birlikte olmak istiyorsanız, ben de bunu isterim.",shape=box,color=blue];
		3858 -> 3861;
		3858 -> 3860;
