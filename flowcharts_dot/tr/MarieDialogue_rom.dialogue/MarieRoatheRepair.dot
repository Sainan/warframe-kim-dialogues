	j3014315192 [label="Gezgin. Şeytan peşimde. Küçük şeytanlarıyla beni sürekli sinirlendiriyor. Hepsi sizin adınıza ! Sizin sadece diz çöküp özür dilemek istediğinizi iddia ediyor.",shape=box,color=blue];
