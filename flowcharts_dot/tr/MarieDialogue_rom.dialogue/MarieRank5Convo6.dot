		3167 -> 3172;
	3168 [label="Haklısın, özür dilerim. Öyle demek istememiştim.",shape=box,color=red];
		3168 -> 3158;
	3169 [label="Void'den çıkarılanlar ile - güçlü warframe'leri ve silahların çoğunu yaratabilmemizi sağlıyor.",shape=box,color=red];
