		3150 -> 3154;
		3150 -> 3155;
		3150 -> 3156;
	3151 [label="Evet, tahmin edebiliyorum. Otomatın arkasına yazılmış bir çocuk karalaması gibi. Onu son derece sevimli ve çekici buldum !",shape=box,color=blue];
		3151 -> 3157;
	3152 [label="Onu son derece tatlı ve çekici buldum ! Ama bir mizah katmanının altında, büyük bir kalp kırıklığı hissettim.",shape=box,color=blue];
		3152 -> 3158;
	3153 [label="Beni daha önceki seferlerde olduğu gibi aynı kararlı ve neşeli tavırla karşıladı. Ama beni bir Sœur de Sol olarak biliyordu ! ",shape=box,color=blue];
		3153 -> 3159;
	3154 [label="Üzgünüm. Bazen insanların sinirlerini bozabiliyor. Bu onun suçu değil.",shape=box,color=red];
		3154 -> 3160;
	3155 [label="Öyle demek istemedim. Bazı insanlar için biraz... itici olabilir.",shape=box,color=red];
		3155 -> 3160;
	3156 [label="Bazen sinirlerime dokunabiliyor, hepsi bu. ",shape=box,color=red];
		3156 -> 3161;
	3157 [label="Ama mizahının altında büyük bir kalp acısı taşıyor.",shape=box,color=blue];
		3157 -> 3158;
	3158 [label="Bana zavallı Mösyö Otak'ın hikayesini anlatır mısınız ?",shape=box,color=blue];
		3158 -> 3162;
	3159 [label="Aslında, Aydınlık'ı çok iyi tanıyordu ! ''Eski dinler'' olarak adlandırdığı, ''Orokin İmparatorluğu'ndan önceki dönem'' hakkında uzun uzun konuştuk.",shape=box,color=blue];
		3159 -> 3163;
	3160 [label="Ve umarım ona şefkat ve sabır gösterirler. Mais par la grâce de Sol.",shape=box,color=blue];
		3160 -> 3164;
	3161 [label="Umarım açıkça hasta olan birine karşı daha şefkatli davranırsınız. Sol hepimizi lütfuyla aydınlatsın.",shape=box,color=blue];
		3161 -> 3164;
	3162 [label="Otak eski Arşimetçi, bir Orokin bilim insanı ve akademisyendi. Başına gelenler pek de mutlu bir hikaye sayılmaz.",shape=box,color=red];
		3162 -> 3165;
	3163 [label="Ancak, bu bilginin büyük bir kısmının artık kaybolduğunu, arşivlerin derinliklerinde gömülü olduğunu ve resmi olarak yasaklandığını söyledi. Bana gizlilik yemini ettirdi.",shape=box,color=blue];
		3163 -> 3166;
	3164 [label="Böyle bir kader hepimizi bekliyor olabilir. Sizi bile.",shape=box,color=blue];
		3164 -> 3167;
		3164 -> 3168;
	3165 [label="Genel kanı, onun bir dahi olduğu ve argon kristallerinin işlenmesinin arkasındaki beyin olduğu yönündeydi.",shape=box,color=red];
		3165 -> 3169;
	3166 [label="Bana, İnfazcı Ballas'ın - o kimse - benim sapkın mezhebimi keşfedip beni idam ettireceğinden ciddi olarak korktuğunu söyledi.",shape=box,color=blue];
		3166 -> 3170;
		3166 -> 3171;
