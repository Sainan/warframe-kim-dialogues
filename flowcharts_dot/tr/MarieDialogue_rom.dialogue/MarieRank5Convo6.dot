		j4047828779 -> j2873633769;
	j2903913495 [label="Evet keyifliydi. Belki de bunun için ağlamak istiyordum. Çünkü aynı konuşmada kendini bana üç kez tanıttı, sanki hiç tanışmamışız gibi.",shape=box,color=blue];
		j2903913495 -> j2873633769;
	j3283979430 [label="Onunla tanışmamdan hoşnut olmadınız mı ?",shape=box,color=blue];
		j3283979430 -> j520872398;
		j3283979430 -> j2327284042;
		j3283979430 -> j2097481774;
	j3943921589 [label="Evet, tahmin edebiliyorum. Otomatın arkasına yazılmış bir çocuk karalaması gibi. Onu son derece sevimli ve çekici buldum !",shape=box,color=blue];
		j3943921589 -> j3031607308;
	j3314148395 [label="Onu son derece tatlı ve çekici buldum ! Ama bir mizah katmanının altında, büyük bir kalp kırıklığı hissettim.",shape=box,color=blue];
		j3314148395 -> j2821476245;
	j2873633769 [label="Beni daha önceki seferlerde olduğu gibi aynı kararlı ve neşeli tavırla karşıladı. Ama beni bir Sœur de Sol olarak biliyordu ! ",shape=box,color=blue];
		j2873633769 -> j4258555064;
	j520872398 [label="Üzgünüm. Bazen insanların sinirlerini bozabiliyor. Bu onun suçu değil.",shape=box,color=red];
		j520872398 -> j2471153371;
	j2327284042 [label="Öyle demek istemedim. Sadece o... bazı insanlar için biraz itici olabilir.",shape=box,color=red];
		j2327284042 -> j2471153371;
	j2097481774 [label="Bazen sinirlerime dokunabiliyor, hepsi bu. ",shape=box,color=red];
		j2097481774 -> j3257059589;
	j3031607308 [label="Ama mizahının altında büyük bir kalp acısı taşıyor.",shape=box,color=blue];
		j3031607308 -> j2821476245;
	j2821476245 [label="Bana zavallı Mösyö Otak'ın hikayesini anlatır mısınız ?",shape=box,color=blue];
		j2821476245 -> j1602305115;
	j4258555064 [label="Aslında, Aydınlık'ı çok iyi tanıyordu ! ''Eski dinler'' olarak adlandırdığı, ''Orokin İmparatorluğu'ndan önceki dönem'' hakkında uzun uzun konuştuk.",shape=box,color=blue];
		j4258555064 -> j651703826;
	j2471153371 [label="Ve umarım ona şefkat ve sabır gösterirler. Mais par la grâce de Sol.",shape=box,color=blue];
		j2471153371 -> j3528395753;
	j3257059589 [label="Umarım açıkça hasta olan birine karşı daha şefkatli davranırsınız. Sol hepimizi lütfuyla aydınlatsın.",shape=box,color=blue];
		j3257059589 -> j3528395753;
	j1602305115 [label="Otak eski Arşimetçi, bir Orokin bilim insanı ve akademisyendi. Başına gelenler pek de mutlu bir hikaye sayılmaz.",shape=box,color=red];
		j1602305115 -> j1652866692;
	j651703826 [label="Ancak, bu bilginin büyük bir kısmının artık kaybolduğunu, arşivlerin derinliklerinde gömülü olduğunu ve resmi olarak yasaklandığını söyledi. Bana gizlilik yemini ettirdi.",shape=box,color=blue];
		j651703826 -> j2999795967;
	j3528395753 [label="Böyle bir kader hepimizi bekliyor olabilir. Sizi bile.",shape=box,color=blue];
		j3528395753 -> j3989781222;
		j3528395753 -> j3827249810;
	j1652866692 [label="Genel kanı, onun bir dahi olduğu ve argon kristallerinin işlenmesinin arkasındaki beyin olduğu yönündeydi.",shape=box,color=red];
		j1652866692 -> j3548345836;
	j2999795967 [label="Bana, İnfazcı Ballas'ın - o kimse - benim sapkın mezhebimi keşfedip beni idam ettireceğinden ciddi olarak korktuğunu söyledi.",shape=box,color=blue];
		j2999795967 -> j106525446;
		j2999795967 -> j1985807352;
	j3989781222 [label="Ona ayıracak vaktim yok, üzgünüm.",shape=box,color=red];
		j3989781222 -> j3304748197;
