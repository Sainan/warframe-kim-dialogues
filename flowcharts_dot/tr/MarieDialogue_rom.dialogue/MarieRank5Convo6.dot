		3147 -> 3152;
	3148 [label="Aynı konuşma sırasında bana üç kez kendini tanıttı, sanki daha önce hiç tanışmamışız gibi.",shape=box,color=blue];
		3148 -> 3153;
	3149 [label="Evet keyifliydi. Belki de bunun için ağlamak istiyordum. Çünkü aynı konuşmada kendini bana üç kez tanıttı, sanki hiç tanışmamışız gibi.",shape=box,color=blue];
