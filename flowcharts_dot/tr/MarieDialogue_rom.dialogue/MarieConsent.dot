	"Chat ends." [color=orange];
	j1985950621 [label="Check boolean MarieConsentComplete",color=orange];
		j1985950621 -> "Chat ends." [label=true,color=green];
		j1985950621 -> j1278961342 [label=false,color=brown];
	j1134465740 [label="Check boolean MariePolyamorySuccess",color=orange];
		j1134465740 -> j1985950621 [label=true,color=green];
		j1134465740 -> "Chat ends." [label=false,color=brown];
	j1278961342 [label="Mon cœur, konuşabilir miyiz? Sadece bir dakika. ",shape=box,color=blue];
		j1278961342 -> j6592736;
		j1278961342 -> j1368919486;
	j6592736 [label="Merhaba, tabii ki. Ne haber?",shape=box,color=red];
		j6592736 -> j556592754;
	j1368919486 [label="[Son.]",shape=box,color=red];
		j1368919486 -> j952339130;
	j556592754 [label="Sadece şunu söylemek istiyorum... Kalbinizin başka birine ait olduğunu biliyorum. Ve o kişiyi tanımıyor olsam da, kalbim bunun için seviniyor.",shape=box,color=blue];
		j556592754 -> j448819336;
	j952339130 [label="Boolean MarieConsentComplete is now true.",color=orange];
		j952339130 -> "Chat ends.";
	j448819336 [label="Size güveniyorum ve eğer o kişi ruhunuzda bir yer tutuyorsa, bunu onunla paylaşmaktan mutluluk duyarım.",shape=box,color=blue];
		j448819336 -> j3095156911;
	j3095156911 [label="Sadece bir gün onunla tanışma fırsatı bulmayı umuyorum, oui ? Kurtumun çok sevdiği bu kişiyi ben de seveceğim...",shape=box,color=blue];
		j3095156911 -> j2294329086;
	j2294329086 [label="En azından, onun da kabul edeceğini düşünüyorsanız.",shape=box,color=blue];
		j2294329086 -> j3938235048;
		j2294329086 -> j3290182664;
		j2294329086 -> j1518022968;
	j3938235048 [label="Dürüst olmak gerekirse, sen onun tipi olmayabilirsin.",shape=box,color=red];
		j3938235048 -> j3805739646;
	j3290182664 [label="O seni çok sevecek biri, Marie. Benim kadar.",shape=box,color=red];
		j3290182664 -> j2992839930;
	j1518022968 [label="Sana karşı koyulabileceğini hiç sanmıyorum.",shape=box,color=red];
		j1518022968 -> j2992839930;
	j3805739646 [label="Pöff ! Siz çok korkunçsunuz, benim kurtcuğum. Bırakın da hayallerimi yaşayayım. O zamana kadar siz varsınız sanırım !",shape=box,color=blue];
		j3805739646 -> j608285790;
	j2992839930 [label="O zamana kadar, size sahibim. Ve sizi, benim gibi sizinle ilgilenenler ile paylaşmaktan mutluluk duyacağım.",shape=box,color=blue];
		j2992839930 -> j608285790;
	j608285790 [label="Siz gezip eğlenirken, Murmur'a karşı birisi nöbet tutmalı, sonuçta !",shape=box,color=blue];
		j608285790 -> j8650768;
	j8650768 [label="Ve şimdi beni görev çağırıyor. À la revoyure !",shape=box,color=blue];
		j8650768 -> j952339130;
}