	3580 [label="Merhaba, tabii ki. Ne haber?",shape=box,color=red];
		3580 -> 3582;
	3579 [label="[Son.]",shape=box,color=red];
		3579 -> 3581;
	3582 [label="Sadece şunu söylemek istiyorum... Kalbinizin başka birine ait olduğunu biliyorum. Ve o kişiyi tanımıyor olsam da, kalbim bunun için seviniyor.",shape=box,color=blue];
		3582 -> 3584;
	3581 [label="Update boolean MarieConsentComplete",color=orange];
		3581 -> 3583;
	3584 [label="Size güveniyorum ve eğer o kişi ruhunuzda bir yer tutuyorsa, bunu onunla paylaşmaktan mutluluk duyarım.",shape=box,color=blue];
		3584 -> 3585;
	3583 [label="Chat ends.",color=orange];
	3585 [label="Sadece bir gün onunla tanışma fırsatı bulmayı umuyorum, oui ? Kurtumun çok sevdiği bu kişiyi ben de seveceğim...",shape=box,color=blue];
		3585 -> 3586;
	3586 [label="En azından, onun da kabul edeceğini düşünüyorsanız.",shape=box,color=blue];
		3586 -> 3587;
		3586 -> 3588;
		3586 -> 3589;
	3587 [label="Dürüst olmak gerekirse, sen onun tipi olmayabilirsin.",shape=box,color=red];
		3587 -> 3590;
	3588 [label="O seni çok sevecek biri, Marie. Benim kadar.",shape=box,color=red];
		3588 -> 3591;
	3589 [label="Sana karşı koyulabileceğini hiç sanmıyorum.",shape=box,color=red];
		3589 -> 3591;
	3590 [label="Pöff ! Siz çok korkunçsunuz, benim kurtcuğum. Bırakın da hayallerimi yaşayayım. O zamana kadar siz varsınız sanırım !",shape=box,color=blue];
		3590 -> 3592;
	3591 [label="O zamana kadar, size sahibim. Ve sizi, benim gibi sizinle ilgilenenler ile paylaşmaktan mutluluk duyacağım.",shape=box,color=blue];
		3591 -> 3592;
	3592 [label="Siz gezip eğlenirken, Murmur'a karşı birisi nöbet tutmalı, sonuçta !",shape=box,color=blue];
		3592 -> 3593;
	3593 [label="Ve şimdi beni görev çağırıyor. À la revoyure !",shape=box,color=blue];
		3593 -> 3594;
	3594 [label="Update boolean MarieConsentComplete",color=orange];
		3594 -> 3595;
	3595 [label="Chat ends.",color=orange];
