		2617 -> 2626 [label="MarieEntrati5i",color=purple];
		2617 -> 2627 [label="false",color=purple];
	2618 [label="Dün bana... bıçak gibi bir darbe indirdiniz. Kızgın olduğum için kaçtığımı itiraf ediyorum, evet, ama aynı zamanda tiksindiğim için de. Size karşı değil, kendime karşı.",shape=box,color=blue];
		2618 -> 2628;
	2619 [label="Ancak devam etmeden önce, bir konuyu ele almam gerekiyor - bana karşı kullandığınız üslup. Beni çocuk olarak gördüğünüzü biliyorum. Siz yüzyıllar öncesinden, hatta daha da eskiden geliyorsunuz.",shape=box,color=blue];
		2619 -> 2629;
	2620 [label="Sözleriniz üzerinde çok düşündüm. Bunun kutsal bir savaş olmadığını ve le Cardinal'in yollarının manipülatif olduğunu düşündüm.",shape=box,color=blue];
		2620 -> 2630;
	2621 [label="Sol'un yazılarında masumların feda edilebileceği yazıyor mu diye sorduğunuz soruda elbette haklıydınız. Öyle bir şey yazmıyor.",shape=box,color=blue];
		2621 -> 2631;
	2622 [label="Devam etmeden önce bir noktaya değinmeliyim - Tartışmada benim inancımı bana karşı kullanma eğiliminiz var, oysa siz kendinizi inanç konusunda sorgulamıyorsunuz.",shape=box,color=blue];
		2622 -> 2632;
	2623 [label="Ben... dün konuşmamızı yarıda kestiğim için özür dilerim. Çok fazla gelmişti. Ancak devam etmeden önce şunu bilmem gerekiyor - Sözlerinizde ciddi miydiniz ? Yoksa sadece rahatsız edici bir tartışmadan kaçınmak için duygularımı manipüle etmek mi istediniz ?",shape=box,color=blue];
		2623 -> 2633;
		2623 -> 2634;
	2624 [label="Le Cardinal konusunda bir çıkmaza girmiş gibiyiz, oui ? Siz onu bir canavar olarak görüyorsunuz, ben ise bir aziz.",shape=box,color=blue];
		2624 -> 2635;
	2625 [label="Eğer sakıncası yoksa, sadece benim gözümde değer kazanmak için Entrati'nin tarafına geçme kararınız hakkında sizinle konuşmak istiyorum.",shape=box,color=blue];
		2625 -> 2636;
	2626 [label="Şimdi eğer isterseniz yalanınız hakkında sizinle konuşmak istiyorum.",shape=box,color=blue];
		2626 -> 2636;
	2627 [label="Chat ends.",color=orange];
	2628 [label="Sizin ölümcül vuruşlarınızın bu kadar isabetli olmasına nasıl şaşırmam ? Sözlerimi şeytanın sözleriyle karşılaştırmak gerekirse...",shape=box,color=blue];
		2628 -> 2637;
	2629 [label="Bilinmeyen boyutlarda, Void'de seyahat ettiniz. Tanrılar ve meleklerle savaştınız. Ben sizin için kimim ki, oui ? Sadece küçük, şapşal Marie.",shape=box,color=blue];
		2629 -> 2638;
	2630 [label="Ve bence... oui, haklısınız. Bu kutsal bir savaş değil. Çünkü böyle bir şey yoktur. Savaş asla kutsal, adil veya erdemli değildir. Acı asla rehberimiz olmamalıdır.",shape=box,color=blue];
		2630 -> 2639;
	2631 [label="Savaş asla kutsal, adil veya erdemli değildir. Acı asla rehberimiz olmamalıdır.",shape=box,color=blue];
		2631 -> 2639;
	2632 [label="Bu ikiyüzlü bir davranıştı, Gezgin. Zalimce ve etkisizdi. Bu, bir konuşmayı ''kazanmak'' için yapılan bir girişimdi ve böyle davranılmamalıydı.",shape=box,color=blue];
		2632 -> 2640;
	2633 [label="Sözlerimde ciddiydim. Zamanlamam yanlışsa özür dilerim. Seni çok önemsiyorum Marie...",shape=box,color=red];
		2633 -> 2641;
	2634 [label="Onları kastetmemiştim, sadece... kendimi kaptırdım. Çok, çok üzgünüm. O anın tutkusu.",shape=box,color=red];
		2634 -> 2642;
	2635 [label="Ancak... aramızdaki ilişkinin böyle kalmasını istemiyorum. Siz iyi kalpli birisiniz ve ilişkimizin bozulmasını istemiyorum.",shape=box,color=blue];
		2635 -> 2946;
	2636 [label="Durumu manipüle ederek duygularımı kontrol etmeye çalışmak... ikiyüzlü ve acımasızca. Bunun için sizden nefret etmek istediğimi itiraf ediyorum, Gezgin.",shape=box,color=blue];
		2636 -> 2644;
	2637 [label="Kendimi zihni ve kalbi dünyaya ve içindekilere açık biri olarak görürdüm. Ve siz, kısa ve öz bir şekilde, tek bir dikenli okla beni yanılttınız.",shape=box,color=blue];
		2637 -> 2645;
	2638 [label="Bir yandan bunu anlıyorum. Empati kuruyorum. İkimiz de öfkelenmiştik. Öte yandan, gelecekte bana karşı daha duyarlı ve nazik davranmanızı rica ediyorum.",shape=box,color=blue];
		2638 -> 2646;
	2639 [label="Şu anda yaptığımız şey bile – Murmur'u yok etmek ve sayısız düşmanınla savaşmak – Aydınlık'ın Yolu değildir.",shape=box,color=blue];
		2639 -> 2647;
	2640 [label="İnanç, başkalarına karşı kullanılacak bir silah değildir ve asla öyle olmamalıdır. İnanç bir kalkan, karanlıkta bir ışık, yol gösteren bir sestir.",shape=box,color=blue];
		2640 -> 2648;
	2641 [label="Bu büyük meseleye girmeden önce, lütfen le Cardinal hakkında bir açıklama yapmam gerek.",shape=box,color=blue];
		2641 -> 2649;
	2642 [label="Update boolean DrifterMarie",color=orange];
		2642 -> 2650;
	2946 [label="Check boolean LoidFamilyComplete",color=orange];
		2946 -> 2651 [label=true,color=green];
		2946 -> 2643 [label=false,color=brown];
	2644 [label="Ancak... Aramızdaki her şeyin bu şekilde kalmasını istemiyorum. Aramızda bozulmasını istemediğim çok şey var.",shape=box,color=blue];
		2644 -> 1395;
	2645 [label="Sanırım pour m'excuser buradayım - bu kadar aptalca bir şekilde köşeye sıkıştığım için çok üzgün olduğumu söylemek için. Umarım anlarsınız.",shape=box,color=blue];
		2645 -> 2653;
		2645 -> 2654;
	2646 [label="Çünkü ben sokaklarda yaşadım. Hayatımın her gününü yoğun fiziksel acı içinde geçirdim. Keder, aşk, korku ve reddedilmeyi tattım. Hayatı ve yas tutmayı tattım.",shape=box,color=blue];
		2646 -> 2655;
	2647 [label="Dünyanın yok olmasını önlemek için bazen silaha başvurmak gerekse de, silahları kutsallaştırmamak gerekir. Masum insanların bunun sonuçlarına katlanması ise kesinlikle affedilemez bir durumdur.",shape=box,color=blue];
		2647 -> 2656;
	2648 [label="Peki ya siz, sadece ''kazanmak'' için bunu bana karşı kullanmaya mı çalıştınız? Bu alçakça bir taktikti. Ama ikimiz de sınırı aştık ve siz bana öfkeyle söylediğiniz sözleri affederseniz, ben de sizi affedeceğim.",shape=box,color=blue];
		2648 -> 2657;
		2648 -> 2658;
	2649 [label="Le Cardinal'i savunmayı bırakmak benim için zor... ve onu neden bırakamadığımı anlamam biraz zaman aldı.",shape=box,color=blue];
		2649 -> 2659;
	2650 [label="Non, anlıyorum... ''Tutku cinayetleri'' nedeniyle kaç cinayet işlendi, oui ? Elbette, o anlarda bir o kadar da çocuk yaratıldı.",shape=box,color=blue];
		2650 -> 2660;
	2651 [label="Ve çok kısa sürede benim için çok önemli biri oldunuz... Sohbetlerimizi çok keyifli buluyorum.",shape=box,color=blue];
		2651 -> 2661;
	2643 [label="Aslında, Bay Loid'in öncüllerinin yanına kavuşmasını her zaman diliyorum. Le Cardinal'in ailesinin teselli bulmasını diliyorum ve bu tesellinin anahtarı sizsiniz ! ",shape=box,color=blue];
		2643 -> 2651;
