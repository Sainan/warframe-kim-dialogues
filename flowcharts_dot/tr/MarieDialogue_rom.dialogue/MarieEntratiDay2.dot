		2653 -> 2663;
	2654 [label="Sözlerimin sana ulaşmasına sevindim. Umudumu kaybetmeye başlamıştım.",shape=box,color=red];
		2654 -> 2664;
	2655 [label="Ve eğer gerçekten kendinizi hepimizin çok üstünde görüyorsanız, o zaman içinde kaybolduğunuz bulutlardan başka bir şey görmeyeceksiniz.",shape=box,color=blue];
		2655 -> 2657;
