digraph {
	2615 [label="MarieEntratiDay2 begins.",color=orange];
		2615 -> 2616;
	2616 [label="Gezgin. Düşünmek için kendime zaman ayırdım ve sakinleştim. Öfkeli olduğumda konuşmama konusunda katı bir kuralım var.",shape=box,color=blue];
		2616 -> 2617;
	2617 [label="Evaluate expressions",color=orange];
		2617 -> 2618 [label="MarieEntrati5a",color=purple];
