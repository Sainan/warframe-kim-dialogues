digraph {
	"MarieRank4Convo3 begins." [color=orange];
		"MarieRank4Convo3 begins." -> j2598728896;
		"MarieRank4Convo3 begins." -> j2025973576;
	j2598728896 [label="Bugün nasılsın Marie?",shape=box,color=red];
		j2598728896 -> j736389166;
	j2025973576 [label="[Son.]",shape=box,color=red];
		j2025973576 -> "Chat ends.";
	j736389166 [label="Pek şahane sayılmam. Yarın tekrar gelip benimle konuşmak isteyebilirsiniz. Bugünlük sizin için pek iyi bir arkadaş olmayacağım.",shape=box,color=blue];
		j736389166 -> j638624533;
		j736389166 -> j3831747143;
		j736389166 -> j245952387;
	"Chat ends." [color=orange];
	j638624533 [label="İstersen giderim ama konuşmak istersen de dinlerim.",shape=box,color=red];
		j638624533 -> j2415445638;
	j3831747143 [label="Peki, anlıyorum.",shape=box,color=red];
		j3831747143 -> "Chat ends.";
	j245952387 [label="Ne oldu diye sorabilir miyim...?",shape=box,color=red];
		j245952387 -> j2415445638;
	j2415445638 [label="C'est vraiment gentil, ama bu eski bir problem... Kendinizi yormaya değecek bir şey değil. Ben iyi olacağım.",shape=box,color=blue];
		j2415445638 -> j3096270068;
	j3096270068 [label="Boolean MarieChronicPain is now true.",color=orange];
		j3096270068 -> j346487571;
		j3096270068 -> j3750143004;
		j3096270068 -> j2043860086;
	j346487571 [label="Kararın buysa tamam ama konuşmak istersen de buradayım.",shape=box,color=red];
		j346487571 -> j2979526661;
	j3750143004 [label="Ben... bunun nasıl bir şey olduğunu bilirim. “Döngüye” başlamadan önce, Duviri'de kendimi oldukça kötü yaralamıştım. İyileşti, ama hala zaman zaman çok kötü ağrıyor. Ağrı başladığında yüzümü buruşturmamaya çalışıyorum.",shape=box,color=red];
		j3750143004 -> j3761573255;
	j2043860086 [label="Eski, kalıcı sorunlar bazen yeni sorunlar kadar problem yaratabiliyor. Gelip geçici olmaları ve bizimle kalabilmeleri, bunların konuşulmaya değer olmadığı anlamına gelmez.",shape=box,color=red];
		j2043860086 -> j4083946149;
	j2979526661 [label="Çok naziksiniz ve... çok iyisiniz. Yine biraz inatçı Marie gibi davranıyorum.",shape=box,color=blue];
		j2979526661 -> j2000136574;
	j3761573255 [label="Boolean DrifterChronicPain is now true.",color=orange];
		j3761573255 -> j3828066669;
	j4083946149 [label="Oui, tu as raison. Yine biraz inatçı Marie gibi davranıyorum.",shape=box,color=blue];
		j4083946149 -> j2000136574;
	j2000136574 [label="Açıklaması zor bir şey ama deneyeceğim. Mes pieds, oui ? Ayaklarım. Sérum beni değiştirdi, beni uçurdu -",shape=box,color=blue];
		j2000136574 -> j1165394761;
	j3828066669 [label="Par les Luminaires, duyduğuma çok üzüldüm. O zaman nasıl bir şey olduğunu anlıyorsunuz, oui ?",shape=box,color=blue];
		j3828066669 -> j1695704933;
	j1165394761 [label="Ama hala onları hissediyorum, beni yok etmekle tehdit eden, ruhumdaki tüm umudu ve neşeyi yok etmekle tehdit eden o çarpık şeyleri.",shape=box,color=blue];
		j1165394761 -> j1531487499;
	j1695704933 [label="Sana ihanet eden, ruhunu yavaşlatan bir bedene sahip olmak. Şimdi bile çok garip. Sérum beni değiştirdi, beni uçurdu -",shape=box,color=blue];
		j1695704933 -> j1165394761;
	j1531487499 [label="Bu duygular canımı hep acıtır. Her zaman. Şu anda bile, burada otururken, onları düşündüğümde bile acıyı hissediyorum. Ama her zaman farkında olmuyorum.",shape=box,color=blue];
		j1531487499 -> j2600087211;
	j2600087211 [label="Şimdi bile, beni geceleri ağrıdan uyandırıyorlar. Ve merak ediyorum, Sol, pourquoi ? Neden hâlâ bu agonie interminable... peşimi bırakmıyor ?",shape=box,color=blue];
		j2600087211 -> j1036559352;
	j1036559352 [label="Ne işe yarıyor ki ? Ah, ama sonra sabah oluyor ve ben gülüyorum, kendi kendime \"Sus Marie, ne kadar şanslısın. Sahip olduklarına, başarabileceklerine bak.\" diyorum.",shape=box,color=blue];
		j1036559352 -> j2792606254;
	j2792606254 [label="Cathédrale'de \"Okuyabilirsin, yazabilirsin, yemek yiyebilirsin, uyuyabilirsin. Yeterince iyi hareket edebilirsin. Görecek gözlerin ve konuşacak bir dilin var. Yazacak ellerin var. Seni önemseyenler var.\" Ve şimdi uçabiliyorum! Geleceği, Void'in kendisinden koruyabiliyorum. l'Indifférence'dan!",shape=box,color=blue];
		j2792606254 -> j3422674444;
	j3422674444 [label="\"Şimdi ağla aptal kız, bu sürekli acı seni gelecekte karşılaşacaklarına karşı güçlü kılacak,\" diyorum kendi kendime. Ve gün bir başka güne geçiyor ve bir sonraki gün geldiğinde o kadar da kötü olmuyor.",shape=box,color=blue];
		j3422674444 -> j830269311;
	j830269311 [label="Check boolean DrifterChronicPain",color=orange];
		j830269311 -> j1143573263 [label=true,color=green];
		j830269311 -> j3785099984 [label=true,color=green];
		j830269311 -> j4175596238 [label=false,color=brown];
		j830269311 -> j935996931 [label=false,color=brown];
	j1143573263 [label="Bize bir şey kazandırdıysa o da acıya karşı toleranstır sanırım.",shape=box,color=red];
		j1143573263 -> j1251522175;
	j3785099984 [label="Bazen, uyanıyorum ve... bugün kendimi kaybedeceğim gün olacakmış gibi hissediyorum.",shape=box,color=red];
		j3785099984 -> j1251522175;
	j4175596238 [label="Acı... gerçekten hiç dinmiyor mu? Çok, çok üzgünüm Marie...",shape=box,color=red];
		j4175596238 -> j1582035694;
	j935996931 [label="Peki ilaç yok mu? Tedavisi yok mu?",shape=box,color=red];
		j935996931 -> j42312423;
	j1251522175 [label="Müritlerden biri bir keresinde bana, ''Acı çekiyor musun? Her zaman mı?'' diye sormuştu. Ben de, ''Evet, efendim. Acı çekiyorum'' diye cevap verdim. Şaşkın bakışları dehşetle karışmıştı.",shape=box,color=blue];
		j1251522175 -> j3989235016;
	j1582035694 [label="Bazen oturup, bu kadar acı, çekmiyor olsaydım ne kadar çok şey yapabileceğimi düşünürdüm, oui ? Eğer bu kadar... her adımımda beni engellemeye çalışan bu bedenden kafese hapsolmasaydım.",shape=box,color=blue];
		j1582035694 -> j1428956792;
	j42312423 [label="Keşke olsaydı. Mais non, yok. Benim zamanımda yoktu ve korkarım ki bu zamanda da yoktur.",shape=box,color=blue];
		j42312423 -> j972042872;
	j3989235016 [label="\"Nasıl devam ediyorsun?\" diye sordu bir sonraki sorusunda. Ona gülümsediğimi ve \"Diğer seçeneğim nedir, Mösyö...?\" diye cevap verdiğimi hatırlıyorum.",shape=box,color=blue];
		j3989235016 -> j4125875904;
		j3989235016 -> j2743415449;
	j1428956792 [label="Beni ne kadar öfkelendirirdi ! Bedenleri kendilerine ihanet etmeyenlere ne kadar kıskançlık duyardım. Ama sonuçta bunun bize ne faydası var, à part rendre nos vies plus amères ? Daha acı hale getirmek dışında ?",shape=box,color=blue];
		j1428956792 -> j1183478258;
	j972042872 [label="Bazı rahatsızlıklar insanın, bilimin ve inancın tedavi edemeyeceği türdedir.",shape=box,color=blue];
		j972042872 -> j1582035694;
	j4125875904 [label="Aynı konuşmayı o kadar çok yaptım ki...",shape=box,color=red];
		j4125875904 -> j1582035694;
	j2743415449 [label="Kesinlikle. Çok üzgünüm.",shape=box,color=red];
		j2743415449 -> j872721547;
	j1183478258 [label="Aucun. Ben böyleyim ve böyle devam edeceğim.",shape=box,color=blue];
		j1183478258 -> j2980398560;
	j872721547 [label="Non, sadece benzer bir acıyı paylaştığın için üzgünüm. ",shape=box,color=blue];
		j872721547 -> j1582035694;
	j2980398560 [label="Check boolean DrifterChronicPain",color=orange];
		j2980398560 -> j4263777841 [label=true,color=green];
		j2980398560 -> j1738018440 [label=false,color=brown];
	j4263777841 [label="Ve siz de. Siz de öyle yapacaksınız. Buna inanıyorum.",shape=box,color=blue];
		j4263777841 -> j1738018440;
	j1738018440 [label="+20 Chemistry",color=orange];
		j1738018440 -> j745873436;
	j745873436 [label="Bu konuşmanın benim için ne kadar önemli olduğunu kelimelerle anlatamam. Bu yüzden sadece merci diyeceğim, Gezgin.",shape=box,color=blue];
		j745873436 -> j3563974437;
	j3563974437 [label="Et encore merci.",shape=box,color=blue];
		j3563974437 -> "Chat ends.";
}