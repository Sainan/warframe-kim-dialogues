digraph {
	2239 [label="MarieRank4Convo3 begins.",color=orange];
		2239 -> 2240;
		2239 -> 2241;
	2240 [label="Bugün nasılsın Marie?",shape=box,color=red];
		2240 -> 2242;
	2241 [label="[Son.]",shape=box,color=red];
		2241 -> 2243;
	2242 [label="Pek şahane sayılmam. Yarın tekrar gelip benimle konuşmak isteyebilirsiniz. Bugünlük sizin için pek iyi bir arkadaş olmayacağım.",shape=box,color=blue];
		2242 -> 2244;
		2242 -> 2245;
		2242 -> 2246;
	2243 [label="Chat ends.",color=orange];
	2244 [label="İstersen giderim ama konuşmak istersen de dinlerim.",shape=box,color=red];
		2244 -> 2247;
	2245 [label="Peki, anlıyorum.",shape=box,color=red];
		2245 -> 2248;
	2246 [label="Ne oldu diye sorabilir miyim...?",shape=box,color=red];
		2246 -> 2247;
	2247 [label="C'est vraiment gentil, ama bu eski bir problem... Kendinizi yormaya değecek bir şey değil. Ben iyi olacağım.",shape=box,color=blue];
		2247 -> 2249;
	2248 [label="Chat ends.",color=orange];
	2249 [label="Update boolean MarieChronicPain",color=orange];
		2249 -> 2250;
		2249 -> 2251;
		2249 -> 2252;
	2250 [label="Kararın buysa tamam ama konuşmak istersen de buradayım.",shape=box,color=red];
		2250 -> 2253;
	2251 [label="Ben... bunun nasıl bir şey olduğunu bilirim. “Döngüye” başlamadan önce, Duviri'de kendimi oldukça kötü yaralamıştım. İyileşti, ama hala zaman zaman çok kötü ağrıyor. Ağrı başladığında yüzümü buruşturmamaya çalışıyorum.",shape=box,color=red];
		2251 -> 2254;
	2252 [label="Eski, kalıcı sorunlar bazen yeni sorunlar kadar problem yaratabiliyor. Gelip geçici olmaları ve bizimle kalabilmeleri, bunların konuşulmaya değer olmadığı anlamına gelmez.",shape=box,color=red];
		2252 -> 2255;
	2253 [label="Çok naziksiniz ve... çok iyisiniz. Yine biraz inatçı Marie gibi davranıyorum.",shape=box,color=blue];
		2253 -> 2256;
	2254 [label="Update boolean DrifterChronicPain",color=orange];
		2254 -> 2257;
	2255 [label="Oui, tu as raison. Yine biraz inatçı Marie gibi davranıyorum.",shape=box,color=blue];
		2255 -> 2256;
	2256 [label="Açıklaması zor bir şey ama deneyeceğim. Mes pieds, oui ? Ayaklarım. Sérum beni değiştirdi, beni uçurdu -",shape=box,color=blue];
		2256 -> 2258;
	2257 [label="Par les Luminaires, duyduğuma çok üzüldüm. O zaman nasıl bir şey olduğunu anlıyorsunuz, oui ?",shape=box,color=blue];
		2257 -> 2259;
	2258 [label="Ama hala onları hissediyorum, beni yok etmekle tehdit eden, ruhumdaki tüm umudu ve neşeyi yok etmekle tehdit eden o çarpık şeyleri.",shape=box,color=blue];
		2258 -> 2260;
	2259 [label="Sana ihanet eden, ruhunu yavaşlatan bir bedene sahip olmak. Şimdi bile çok garip. Sérum beni değiştirdi, beni uçurdu -",shape=box,color=blue];
		2259 -> 2258;
	2260 [label="Bu duygular canımı hep acıtır. Her zaman. Şu anda bile, burada otururken, onları düşündüğümde bile acıyı hissediyorum. Ama her zaman farkında olmuyorum.",shape=box,color=blue];
		2260 -> 2261;
	2261 [label="Şimdi bile, beni geceleri ağrıdan uyandırıyorlar. Ve merak ediyorum, Sol, pourquoi ? Neden hâlâ bu agonie interminable... peşimi bırakmıyor ?",shape=box,color=blue];
		2261 -> 2262;
	2262 [label="Ne işe yarıyor ki ? Ah, ama sonra sabah oluyor ve ben gülüyorum, kendi kendime \"Sus Marie, ne kadar şanslısın. Sahip olduklarına, başarabileceklerine bak.\" diyorum.",shape=box,color=blue];
		2262 -> 2263;
	2263 [label="Cathédrale'de \"Okuyabilirsin, yazabilirsin, yemek yiyebilirsin, uyuyabilirsin. Yeterince iyi hareket edebilirsin. Görecek gözlerin ve konuşacak bir dilin var. Yazacak ellerin var. Seni önemseyenler var.\" Ve şimdi uçabiliyorum! Geleceği, Void'in kendisinden koruyabiliyorum. l'Indifférence'dan!",shape=box,color=blue];
		2263 -> 2264;
	2264 [label="\"Şimdi ağla aptal kız, bu sürekli acı seni gelecekte karşılaşacaklarına karşı güçlü kılacak,\" diyorum kendi kendime. Ve gün bir başka güne geçiyor ve bir sonraki gün geldiğinde o kadar da kötü olmuyor.",shape=box,color=blue];
		2264 -> 2265;
	2265 [label="Check boolean DrifterChronicPain",color=orange];
		2265 -> 2266 [label=true,color=green];
		2265 -> 2269 [label=true,color=green];
		2265 -> 2267 [label=false,color=brown];
		2265 -> 2268 [label=false,color=brown];
	2266 [label="Bize bir şey kazandırdıysa o da acıya karşı toleranstır sanırım.",shape=box,color=red];
		2266 -> 2270;
	2269 [label="Bazen, uyanıyorum ve... bugün kendimi kaybedeceğim gün olacakmış gibi hissediyorum.",shape=box,color=red];
		2269 -> 2270;
	2267 [label="Acı... gerçekten hiç dinmiyor mu? Çok, çok üzgünüm Marie...",shape=box,color=red];
		2267 -> 2271;
	2268 [label="Peki ilaç yok mu? Tedavisi yok mu?",shape=box,color=red];
		2268 -> 2272;
	2270 [label="Müritlerden biri bir keresinde bana, ''Acı çekiyor musun? Her zaman mı?'' diye sormuştu. Ben de, ''Evet, efendim. Acı çekiyorum'' diye cevap verdim. Şaşkın bakışları dehşetle karışmıştı.",shape=box,color=blue];
		2270 -> 2273;
	2271 [label="Bazen oturup, bu kadar acı, çekmiyor olsaydım ne kadar çok şey yapabileceğimi düşünürdüm, oui ? Eğer bu kadar... her adımımda beni engellemeye çalışan bu bedenden kafese hapsolmasaydım.",shape=box,color=blue];
		2271 -> 2274;
	2272 [label="Keşke olsaydı. Mais non, yok. Benim zamanımda yoktu ve korkarım ki bu zamanda da yoktur.",shape=box,color=blue];
		2272 -> 2275;
	2273 [label="\"Nasıl devam ediyorsun?\" diye sordu bir sonraki sorusunda. Ona gülümsediğimi ve \"Diğer seçeneğim nedir, Mösyö...?\" diye cevap verdiğimi hatırlıyorum.",shape=box,color=blue];
		2273 -> 2276;
		2273 -> 2277;
	2274 [label="Beni ne kadar öfkelendirirdi ! Bedenleri kendilerine ihanet etmeyenlere ne kadar kıskançlık duyardım. Ama sonuçta bunun bize ne faydası var, à part rendre nos vies plus amères ? Daha acı hale getirmek dışında ?",shape=box,color=blue];
		2274 -> 2278;
	2275 [label="Bazı rahatsızlıklar insanın, bilimin ve inancın tedavi edemeyeceği türdedir.",shape=box,color=blue];
		2275 -> 2271;
	2276 [label="Aynı konuşmayı o kadar çok yaptım ki...",shape=box,color=red];
		2276 -> 2271;
	2277 [label="Kesinlikle. Çok üzgünüm.",shape=box,color=red];
		2277 -> 2279;
	2278 [label="Aucun. Ben böyleyim ve böyle devam edeceğim.",shape=box,color=blue];
		2278 -> 2280;
	2279 [label="Non, sadece benzer bir acıyı paylaştığın için üzgünüm. ",shape=box,color=blue];
		2279 -> 2271;
	2280 [label="Check boolean DrifterChronicPain",color=orange];
		2280 -> 2281 [label=true,color=green];
		2280 -> 2282 [label=false,color=brown];
	2281 [label="Ve siz de. Siz de öyle yapacaksınız. Buna inanıyorum.",shape=box,color=blue];
		2281 -> 2282;
	2282 [label="+20 Chemistry",color=orange];
		2282 -> 2283;
	2283 [label="Bu konuşmanın benim için ne kadar önemli olduğunu kelimelerle anlatamam. Bu yüzden sadece merci diyeceğim, Gezgin.",shape=box,color=blue];
		2283 -> 2284;
	2284 [label="Et encore merci.",shape=box,color=blue];
		2284 -> 2285;
	2285 [label="Chat ends.",color=orange];
}