	"Chat ends." [color=orange];
	j2284259967 [label="Ah, çok ilginizi çeker mi bilmiyorum ama yine de çok merak ediyorsanız anlatayım. ",shape=box,color=blue];
		j2284259967 -> j2774075814;
	j3622409225 [label="Boolean MarieGraveyard2 is now true.",color=orange];
		j3622409225 -> j1720132511;
	j1507820535 [label="Kullandığım dilin bunu ele verdiğini düşünüyordum, ama sonra senin benim bildiğim dünyamdan olmadığını hatırladım, hah !",shape=box,color=blue];
		j1507820535 -> j1721845732;
	j2774075814 [label="Bu zamanı bir Sol Rahibesi olarak görevlerimi yerine getirerek geçirdim. Komünyon kaplarını parlattım, kilise üyeleri için adaklıklar hazırladım. ",shape=box,color=blue];
		j2774075814 -> j730113612;
	j1720132511 [label="Ama ölülerle konuşmaya bu kadar çok zaman harcamamın sebebi bu değil.",shape=box,color=blue];
		j1720132511 -> j3275586200;
	j1721845732 [label="Gaule adlı bir ülkenin başkenti olan La Cité de la Lumière'denim. Dünya haritasında, Höllvania'dan çok da uzakta değil.",shape=box,color=blue];
		j1721845732 -> j2439519867;
	j730113612 [label="Mezarlık ve mezar işleriyle ilgilendim. En sevdiğim iş buydu.",shape=box,color=blue];
		j730113612 -> j2567727994;
		j730113612 -> j2409093789;
	j3275586200 [label="Boolean MarieGraveyard2 is now true.",color=orange];
		j3275586200 -> j1487382530;
	j2439519867 [label="Acaba 1999'da Katedralim hala ayakta mıdır ? Ne ilginç bir düşünce !",shape=box,color=blue];
		j2439519867 -> j4281966391;
		j2439519867 -> j3129282619;
	j2567727994 [label="En sevdiğin neden buydu?",shape=box,color=red];
		j2567727994 -> j171845731;
	j2409093789 [label="Pardon. Son kısımda anlattığın görevin neydi?",shape=box,color=red];
		j2409093789 -> j2039475676;
	j1487382530 [label="Oralarda bir güzellik, bir tranquillité var. Çok sessizler. Huzurlu.",shape=box,color=blue];
		j1487382530 -> j866398166;
	j4281966391 [label="Konudan sapmayı seviyorsun, değil mi?",shape=box,color=red];
		j4281966391 -> j586791278;
	j3129282619 [label="Bu konuyu sorabileceğim iki arkadaşım var, oldukça gezgin insanlardır. Sanırım o şehre gittiklerini de söylemişlerdi.",shape=box,color=red];
		j3129282619 -> j2816939879;
	j171845731 [label="Artık ebedi istirahatlerine kavuşanlar ile konuşmaktan çok keyif alırdım. Onlar, benim dertlerimi yargılamadan dinlerlerdi.",shape=box,color=blue];
		j171845731 -> j3780015256;
	j2039475676 [label="Görevim Katedraldeki ölülerle ilgilenmekti. Mezarların zeminindeki tozu süpürür, avludaki otları temizlerdim.",shape=box,color=blue];
		j2039475676 -> j171845731;
	j866398166 [label="Sanırım onlara dertlerimi et les activités des autres anlatmayı seviyorum çünkü onların dertleri artık bitti, oui ?",shape=box,color=blue];
		j866398166 -> j3737081239;
	j586791278 [label="+5 Chemistry",color=orange];
		j586791278 -> j4106106466;
	j2816939879 [label="+5 Chemistry",color=orange];
		j2816939879 -> j4256319679;
	j3780015256 [label="Eh, onların tek kelime bile cevabı olmazdı, mais cela me convenait tout à fait ! Zaten onların sessiz kalmasını tercih ederdim.",shape=box,color=blue];
		j3780015256 -> j3383868891;
	j3737081239 [label="Artık her şey onlara önemsiz görünüyor olmalı, bu da beni rahatlatıyor.",shape=box,color=blue];
		j3737081239 -> j3967298681;
		j3737081239 -> j3254323333;
		j3737081239 -> j1956057558;
	j4106106466 [label="Fark ettin mi, oui ? Lyon sürekli benim güneş ışığı altındaki bir toz zerresi olduğumu, rüzgârın beni götürdüğü yere sürüklendiğimi söyleyerek benimle dalga geçer. (İkinizin artık konuşması beni çok mutlu etti !)",shape=box,color=blue];
		j4106106466 -> j2747011599;
	j4256319679 [label="Ah, onları rahatsız etmeye değecek bir şey değil, sadece bir kuruntu. Onun yok olduğunu düşünmek beni ne kadar üzerdi, bilemiyorum.",shape=box,color=blue];
		j4256319679 -> j2747011599;
	j3383868891 [label="+5 Chemistry",color=orange];
		j3383868891 -> j1556580924;
	j3967298681 [label="Bilmiyorum, ben... ölmekten gerçekten korkuyorum, ölümün etrafında olmaktan hiç hoşlanmadım.",shape=box,color=red];
		j3967298681 -> j3813365671;
	j3254323333 [label="Hiç bu şekilde düşünmemiştim.",shape=box,color=red];
		j3254323333 -> j1188558056;
	j1956057558 [label="Ben de aynı huzuru mezar ve kabristanlarda bulurdum. O yüzden seni çok iyi anlıyorum.",shape=box,color=red];
		j1956057558 -> j960751483;
	j2747011599 [label="Sadece merak ediyorum, non ? Tout ce qui existe, yani her şeyi bilmek istiyorum. Sanırım le Cardinal ile tanışmamızın kaderimizde olmasının sebebi buydu.",shape=box,color=blue];
		j2747011599 -> j939522212;
	j1556580924 [label="Düşünsenize ? Konuşan kafatasları, tıpkı sizin nekraloidiniz gibi ? Ha !",shape=box,color=blue];
		j1556580924 -> j414907189;
		j1556580924 -> j2717873490;
	j3813365671 [label="Biliyorum, küçük hastalıklı Marie ! Çok tuhaf. Ama herkes şahsına münhasır, non ?",shape=box,color=blue];
		j3813365671 -> j3358370925;
	j1188558056 [label="Yalnız değilsiniz. Zamanımızın çoğunu, sonrasında ne olacağını düşünerek geçirmekten hoşlanmayız. Ta ki o sona yaklaşana kadar.",shape=box,color=blue];
		j1188558056 -> j2798061034;
	j960751483 [label="Anlamanıza çok sevindim!",shape=box,color=blue];
		j960751483 -> j2798061034;
	j939522212 [label="Où en étais-je ? Ah ! Oui. Hikayemde.",shape=box,color=blue];
		j939522212 -> j3744691652;
	j414907189 [label="Tekerlekli sandalyen göz önüne alındığında bu hiç de kolay bir iş olmamıştır.",shape=box,color=red];
		j414907189 -> j2723435351;
	j2717873490 [label="Konuşacak başka arkadaşların yok muydu?",shape=box,color=red];
		j2717873490 -> j2708380286;
	j3358370925 [label="Birisi onlara bakmalı. Ve ben bunu seve seve yaparım.",shape=box,color=blue];
		j3358370925 -> j2798061034;
	j2798061034 [label="Lyon şakayla, yere daha yakın olduğum için mezarı çok düşündüğümü söyler.",shape=box,color=blue];
		j2798061034 -> j852343458;
	j3744691652 [label="Zengin bir famille'de doğdum, bu sizi şaşırtabilir. Orokin'lere çok daha yakın olan bourgeois sınıfından.",shape=box,color=blue];
		j3744691652 -> j3287950305;
	j2723435351 [label="Non, zor değildi. Ama Lyon, ihtiyaç duyduğumda merdivenlerden inip çıkmama yardım ederdi ve gerisini bir şekilde halledebiliyordum.",shape=box,color=blue];
		j2723435351 -> j2987264356;
	j2708380286 [label="Boolean MarieGraveyard1 is now true.",color=orange];
		j2708380286 -> j2977588411;
	j852343458 [label=" Ona kafasının boş olup olmadığını soruyorum, bu yüzden hayaletlerle dolu.",shape=box,color=blue];
		j852343458 -> j1646357350;
	j3287950305 [label="Ama ben doğduğumda, sakat, mes pieds tordus et inutilisables ? Ah, ma mère buna izin veremezdi.",shape=box,color=blue];
		j3287950305 -> j1242093733;
	j2987264356 [label="İnatçılıkla neler yapılabiliyor, hayret verici, oui ?",shape=box,color=blue];
		j2987264356 -> j1200790211;
