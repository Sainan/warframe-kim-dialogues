	1180 [label="Onların gözünde, beni yıllarca iyileştirmek için ellerinden geleni yapmışlardı. Bana yürümeyi öğretecek öğretmenler. Dizlikler. Ayakkabılar.",shape=box,color=blue];
		1180 -> 1185;
	1181 [label="Altı, ya da yedi olabilir. Kendi gözünde beni yıllarca iyileştirmek için ellerinden geleni yapmışlardı. Bana yürümeyi öğretecek öğretmenler tutmuş, dizlikler ve ayakkabılar almışlardı.",shape=box,color=blue];
		1181 -> 1185;
	1186 [label="Lua sürekli değişmekte. Sol bile, ne kadar sabit olursa olsun, yörüngelerinin etkisine maruz kalıyor.",shape=box,color=blue];
		1186 -> 1191;
	1187 [label="Kesinlikle o benim ruh ikizim. Burada olduğum için kendimi giderek daha mutlu hissediyorum.",shape=box,color=blue];
		1187 -> 1188;
	1188 [label="Umarım o da yakında aynı şeyi hisseder... ne var ki, şeytan, vesvese ve yalanlarıyla onun peşini bırakmıyor.",shape=box,color=blue];
