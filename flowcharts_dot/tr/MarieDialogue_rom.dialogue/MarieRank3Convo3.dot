		j2977588411 -> j3275586200;
	j1646357350 [label="Sonra o beni tepeden aşağı itmekle tehdit ederdi, ben de onun cüppesini ısırgan otuyla doldurmakla tehdit ederdim.",shape=box,color=blue];
		j1646357350 -> j1118776134;
	j1242093733 [label="Görünüşlerin korunması gerekiyordu, oui ? Korunması gereken standartlar.",shape=box,color=blue];
		j1242093733 -> j2956464034;
	j1200790211 [label="Eh işte. İnatçılık ve üst vücut kuvveti ile, olduğu kadar !",shape=box,color=blue];
