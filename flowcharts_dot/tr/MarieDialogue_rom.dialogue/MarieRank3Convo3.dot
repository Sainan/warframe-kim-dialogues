		j1868395652 -> j2507206953;
	j4186829557 [label="Onsuz ben kimbilir nerede olurdum. Korusun, belki de, bir uçurumun dibinde. Hah !",shape=box,color=blue];
		j4186829557 -> j2616886882;
	j3842891165 [label="O beni çok fena güldürüyor. Ama sen de öylesin, kurt. Burada olduğum için kendimi giderek daha mutlu hissediyorum.",shape=box,color=blue];
