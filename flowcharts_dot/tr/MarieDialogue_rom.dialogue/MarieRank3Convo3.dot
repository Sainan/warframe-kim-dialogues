	1222 [label="Oui, tam da öyle. Salın üzerine çıkarıldım ve şimdi bunu başkaları için yapmalıyım. ",shape=box,color=blue];
		1222 -> 1224;
	1223 [label="Ama ne demek istediğinizi anlıyorum. Özünde, pes etmemem gerektiğini söylüyorsunuz. Bana bu yeteneklerin, başkaları için bir kalkan görevi görmem için verildiğini söylüyorsunuz.",shape=box,color=blue];
		1223 -> 1224;
	1224 [label="Merci. Ama şimdilik gitmem gerek.",shape=box,color=blue];
		1224 -> 1225;
	1225 [label="Chat ends.",color=orange];
}