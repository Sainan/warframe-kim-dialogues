		3943 -> 3944;
	1198 [label="İşte bu, beni sokaklarda les sœurs de Sol'dan birinin bulmasına sebep oldu. Beni yanlarına almayı teklif ettiler.",shape=box,color=blue];
		1198 -> 1199;
		1198 -> 1200;
