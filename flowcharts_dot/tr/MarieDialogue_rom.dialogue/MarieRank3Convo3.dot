		j2560552395 -> j529925099;
	j2608206783 [label="Altı, ya da yedi olabilir. Kendi gözünde beni yıllarca iyileştirmek için ellerinden geleni yapmışlardı. Bana yürümeyi öğretecek öğretmenler tutmuş, dizlikler ve ayakkabılar almışlardı.",shape=box,color=blue];
		j2608206783 -> j529925099;
	j2507206953 [label="Lua sürekli değişmekte. Sol bile, ne kadar sabit olursa olsun, yörüngelerinin etkisine maruz kalıyor.",shape=box,color=blue];
