	1197 [label="Pieds olmayan bir çocuktan daha acıklı ne olabilir ki, oui ? Ben avuçlarımı açarak bir günde onların bir haftada çalabileceğinden daha fazlasını kazanabilirdim.",shape=box,color=blue];
		1197 -> 1198;
	3938 [label="Ah ! Par Sol. İtiraf ediyorum, beni şaşırttınız. Ve şimdi burada yüzüm kızarmış bir şekilde oturuyorum ve bunu Mösyö Loid'den saklıyorum...",shape=box,color=blue];
		3938 -> 3939;
