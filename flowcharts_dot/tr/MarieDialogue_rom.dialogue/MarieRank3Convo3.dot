		j2015207806 -> j2284259967;
	j2506552406 [label="Yalnızlıkla geçiyordu, sanırım gerçek bu. Lyon'um vardı ama onun bazen nasıl biri olduğunu bilirsin. (Ah ! Şimdi ikinizin konuşuyor olmasına çok seviniyorum !)",shape=box,color=blue];
