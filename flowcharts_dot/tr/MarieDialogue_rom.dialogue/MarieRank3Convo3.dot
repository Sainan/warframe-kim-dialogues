	3940 [label="+10 Chemistry",color=orange];
		3940 -> 1188;
	3945 [label="Lyon benim kardeşim. Onu tahmin edebileceğinizden çok daha fazla seviyorum ama kendisi sorunları olan bir adam. Onunla konuşmadan önce sözlerinizi dikkatlice düşünün, n'est-ce pas ?",shape=box,color=blue];
		3945 -> 3946;
	1201 [label="+5 Chemistry",color=orange];
		1201 -> 1203;
	1202 [label="Oui, ne yapabilirdim ki ? Hastalanmam an meselesiydi. Daha enfant iken bile bunu biliyordum.",shape=box,color=blue];
		1202 -> 1204;
		1202 -> 1205;
	3946 [label="Yakında tekrar konuşuruz, sanırım. Beni yanlış anlamayın, sizi cesaretlendiriyorum ! Sadece tekrar düşünmenizi istiyorum.",shape=box,color=blue];
		3946 -> 3940;
	1203 [label="Çok iyi kalplisin. Hepsini alamayacakları açıktı... ama arkadaşlarımı da unutmadım.",shape=box,color=blue];
		1203 -> 1206;
	1204 [label="Rahibeler nasıldı?",shape=box,color=red];
		1204 -> 1207;
	1205 [label="Katedraldeki hayata nasıl uyum sağladın?",shape=box,color=red];
		1205 -> 1208;
	1206 [label="Her hafta maaşımla ve mutfaktan veya diğerlerinden toplayabildiklerimle geri dönüyordum.",shape=box,color=blue];
		1206 -> 1209;
	1207 [label="Les Sœurs bana karşı çok nazikti ! Ama neden başka türlü düşünmeniz gerektiğini biliyorum, non ?",shape=box,color=blue];
		1207 -> 1210;
	1208 [label="Ne kadar da çok sevmiştim ! Ama neden başka türlü düşünmeniz gerektiğini biliyorum, non ?",shape=box,color=blue];
		1208 -> 1210;
	1209 [label="Arkadaşlarım hayatta olduğu sürece onlara elimden geldiğince iyi baktım. Birçoğu çiçek hastalığı veya veremden öldü...",shape=box,color=blue];
		1209 -> 1211;
	1210 [label="Üç öğün yemek, sıcak bir yatak, başımın üzerinde bir çatı. Dövülmekten, soyulmaktan veya daha kötüsünden endişe etmeme gerek yoktu değil mi ?",shape=box,color=blue];
		1210 -> 1212;
	1211 [label="Birçoğu taşındı, bazıları kavga veya şiddet sonucu öldü. Çoğu dürüst bir iş bulup büyüdü gitti. Kendi famillelerini kurdular.",shape=box,color=blue];
		1211 -> 1213;
	1212 [label="İyi bir eğitim aldım. Sol ve Lua ilkelerini öğrendim. İnançta yolumu bulmam söylendi. İsteseydim ayrılabilirdim.",shape=box,color=blue];
		1212 -> 1214;
	1213 [label="Hatta bazıları beni görmek için Katedral'e bile uğrardı. Bu durum yüreğimi ısıtırdı.",shape=box,color=blue];
		1213 -> 1214;
	1214 [label="Başkaları sokaklarda yatarken benim kurtarılmamdan dolayı uzun süre suçluluk duydum. Bazı günler bunu hâlâ hissederim.",shape=box,color=blue];
		1214 -> 1215;
		1214 -> 1216;
	1215 [label="Etrafımda ölenleri düşündüğümde, hayatta kalanın ben olduğumu fark ettiğimde, aynı şeyi hissediyorum. Ama kendimize bunu yapamayız. Elimizden geldiğince, durumu iyileştirmek için mücadeleye devam etmeliyiz.",shape=box,color=red];
		1215 -> 1217;
	1216 [label="Sana verilenlerle başkalarına yardım etmek için elinden gelenin en iyisini yaptın. Başkaları seni yüceltti ve şimdi bu fırsat sana verildiğinde sen de başkalarını yüceltmeye çalışıyorsun.",shape=box,color=red];
		1216 -> 1218;
	1217 [label="Bu sonsuza kadar böyle mi kalacak ? Bir mücadele şeklinde mi ? Bizi boğmaya çalışan bir akıntıya karşı bir savaş mı ?",shape=box,color=blue];
		1217 -> 1219;
