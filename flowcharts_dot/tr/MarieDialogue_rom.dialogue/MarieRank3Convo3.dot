	1115 [label="Katedralde yaşamak nasıl bir şeydi, biraz daha anlatır mısın? Entrati gelmeden önce?",shape=box,color=red];
		1115 -> 1119;
	1117 [label="Marie, sen nerede büyüdün?",shape=box,color=red];
		1117 -> 2425;
	1118 [label="[Son.]",shape=box,color=red];
		1118 -> 1122;
	1116 [label="Entrati gelmeden önce Katedral'deki hayatın nasıldı?",shape=box,color=red];
		1116 -> 1120;
	1119 [label="Yalnızlıkla geçiyordu, sanırım gerçek bu. Lyon'um vardı ama onun bazen nasıl biri olduğunu bilirsin. (Ah ! Şimdi ikinizin konuşuyor olmasına çok seviniyorum !)",shape=box,color=blue];
		1119 -> 1123;
	2425 [label="Update boolean MarieBackstory1",color=orange];
		2425 -> 1121;
	1122 [label="Chat ends.",color=orange];
	1120 [label="Ah, çok ilginizi çeker mi bilmiyorum ama yine de çok merak ediyorsanız anlatayım. ",shape=box,color=blue];
		1120 -> 1124;
	1123 [label="Update boolean MarieGraveyard2",color=orange];
		1123 -> 1126;
	1121 [label="Kullandığım dilin bunu ele verdiğini düşünüyordum, ama sonra senin benim bildiğim dünyamdan olmadığını hatırladım, hah !",shape=box,color=blue];
		1121 -> 1125;
	1124 [label="Bu zamanı bir Sol Rahibesi olarak görevlerimi yerine getirerek geçirdim. Komünyon kaplarını parlattım, kilise üyeleri için adaklıklar hazırladım. ",shape=box,color=blue];
		1124 -> 1127;
	1126 [label="Ama ölülerle konuşmaya bu kadar çok zaman harcamamın sebebi bu değil.",shape=box,color=blue];
		1126 -> 1129;
	1125 [label="Gaule adlı bir ülkenin başkenti olan La Cité de la Lumière'denim. Dünya haritasında, Höllvania'dan çok da uzakta değil.",shape=box,color=blue];
		1125 -> 1128;
	1127 [label="Mezarlık ve mezar işleriyle ilgilendim. En sevdiğim iş buydu.",shape=box,color=blue];
		1127 -> 1130;
		1127 -> 1131;
	1129 [label="Update boolean MarieGraveyard2",color=orange];
		1129 -> 1134;
	1128 [label="Acaba 1999'da Katedralim hala ayakta mıdır ? Ne ilginç bir düşünce !",shape=box,color=blue];
		1128 -> 1132;
		1128 -> 1133;
	1130 [label="En sevdiğin neden buydu?",shape=box,color=red];
		1130 -> 1135;
	1131 [label="Pardon. Son kısımda anlattığın görevin neydi?",shape=box,color=red];
		1131 -> 1136;
	1134 [label="Oralarda bir güzellik, bir tranquillité var. Çok sessizler. Huzurlu.",shape=box,color=blue];
		1134 -> 1139;
	1132 [label="Konudan sapmayı seviyorsun, değil mi?",shape=box,color=red];
		1132 -> 1137;
	1133 [label="Bu konuyu sorabileceğim iki arkadaşım var, oldukça gezgin insanlardır. Sanırım o şehre gittiklerini de söylemişlerdi.",shape=box,color=red];
		1133 -> 1138;
	1135 [label="Artık ebedi istirahatlerine kavuşanlar ile konuşmaktan çok keyif alırdım. Onlar, benim dertlerimi yargılamadan dinlerlerdi.",shape=box,color=blue];
		1135 -> 1140;
	1136 [label="Görevim Katedraldeki ölülerle ilgilenmekti. Mezarların zeminindeki tozu süpürür, avludaki otları temizlerdim.",shape=box,color=blue];
		1136 -> 1135;
	1139 [label="Sanırım onlara dertlerimi et les activités des autres anlatmayı seviyorum çünkü onların dertleri artık bitti, oui ?",shape=box,color=blue];
		1139 -> 1143;
	1137 [label="+5 Chemistry",color=orange];
		1137 -> 1141;
	1138 [label="+5 Chemistry",color=orange];
		1138 -> 1142;
	1140 [label="Eh, onların tek kelime bile cevabı olmazdı, mais cela me convenait tout à fait ! Zaten onların sessiz kalmasını tercih ederdim.",shape=box,color=blue];
		1140 -> 1144;
	1143 [label="Artık her şey onlara önemsiz görünüyor olmalı, bu da beni rahatlatıyor.",shape=box,color=blue];
		1143 -> 1146;
		1143 -> 1147;
		1143 -> 1148;
	1141 [label="Fark ettin mi, oui ? Lyon sürekli benim güneş ışığı altındaki bir toz zerresi olduğumu, rüzgârın beni götürdüğü yere sürüklendiğimi söyleyerek benimle dalga geçer. (İkinizin artık konuşması beni çok mutlu etti !)",shape=box,color=blue];
		1141 -> 1145;
	1142 [label="Ah, onları rahatsız etmeye değecek bir şey değil, sadece bir kuruntu. Onun yok olduğunu düşünmek beni ne kadar üzerdi, bilemiyorum.",shape=box,color=blue];
		1142 -> 1145;
	1144 [label="+5 Chemistry",color=orange];
		1144 -> 1149;
	1146 [label="Bilmiyorum, ben... ölmekten gerçekten korkuyorum, ölümün etrafında olmaktan hiç hoşlanmadım.",shape=box,color=red];
		1146 -> 1151;
	1147 [label="Hiç bu şekilde düşünmemiştim.",shape=box,color=red];
		1147 -> 1152;
	1148 [label="Ben de aynı huzuru mezar ve kabristanlarda bulurdum. O yüzden seni çok iyi anlıyorum.",shape=box,color=red];
		1148 -> 1153;
	1145 [label="Sadece merak ediyorum, non ? Tout ce qui existe, yani her şeyi bilmek istiyorum. Sanırım le Cardinal ile tanışmamızın kaderimizde olmasının sebebi buydu.",shape=box,color=blue];
		1145 -> 1150;
	1149 [label="Düşünsenize ? Konuşan kafatasları, tıpkı sizin nekraloidiniz gibi ? Ha !",shape=box,color=blue];
		1149 -> 1154;
		1149 -> 1155;
	1151 [label="Biliyorum, küçük hastalıklı Marie ! Çok tuhaf. Ama herkes şahsına münhasır, non ?",shape=box,color=blue];
		1151 -> 1157;
	1152 [label="Yalnız değilsiniz. Zamanımızın çoğunu, sonrasında ne olacağını düşünerek geçirmekten hoşlanmayız. Ta ki o sona yaklaşana kadar.",shape=box,color=blue];
		1152 -> 1158;
	1153 [label="Anlamanıza çok sevindim!",shape=box,color=blue];
		1153 -> 1158;
	1150 [label="Où en étais-je ? Ah ! Oui. Hikayemde.",shape=box,color=blue];
		1150 -> 1156;
	1154 [label="Tekerlekli sandalyen göz önüne alındığında bu hiç de kolay bir iş olmamıştır.",shape=box,color=red];
		1154 -> 1159;
	1155 [label="Konuşacak başka arkadaşların yok muydu?",shape=box,color=red];
		1155 -> 1160;
	1157 [label="Birisi onlara bakmalı. Ve ben bunu seve seve yaparım.",shape=box,color=blue];
		1157 -> 1158;
	1158 [label="Lyon şakayla, yere daha yakın olduğum için mezarı çok düşündüğümü söyler.",shape=box,color=blue];
		1158 -> 1162;
	1156 [label="Zengin bir famille'de doğdum, bu sizi şaşırtabilir. Orokin'lere çok daha yakın olan bourgeois sınıfından.",shape=box,color=blue];
		1156 -> 1161;
	1159 [label="Non, zor değildi. Ama Lyon, ihtiyaç duyduğumda merdivenlerden inip çıkmama yardım ederdi ve gerisini bir şekilde halledebiliyordum.",shape=box,color=blue];
		1159 -> 1163;
	1160 [label="Update boolean MarieGraveyard1",color=orange];
		1160 -> 1164;
	1162 [label=" Ona kafasının boş olup olmadığını soruyorum, bu yüzden hayaletlerle dolu.",shape=box,color=blue];
		1162 -> 1166;
	1161 [label="Ama ben doğduğumda, sakat, mes pieds tordus et inutilisables ? Ah, ma mère buna izin veremezdi.",shape=box,color=blue];
		1161 -> 1165;
	1163 [label="İnatçılıkla neler yapılabiliyor, hayret verici, oui ?",shape=box,color=blue];
		1163 -> 1167;
	1164 [label="Lyon'um vardı tabii. Ama bazı günler onun nasıl olduğunu görebiliyorsunuzdur.",shape=box,color=blue];
		1164 -> 1129;
	1166 [label="Sonra o beni tepeden aşağı itmekle tehdit ederdi, ben de onun cüppesini ısırgan otuyla doldurmakla tehdit ederdim.",shape=box,color=blue];
		1166 -> 1169;
	1165 [label="Görünüşlerin korunması gerekiyordu, oui ? Korunması gereken standartlar.",shape=box,color=blue];
		1165 -> 1168;
	1167 [label="Eh işte. İnatçılık ve üst vücut kuvveti ile, olduğu kadar !",shape=box,color=blue];
