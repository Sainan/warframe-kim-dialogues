	j3268184087 [label="\"Artık özgür olan Zabir ile elektrik laboratuvarının ortasında duruyorsun. Sana bakıyor, 'kaybedecek zaman yok, beni takip et' diyor.\"",shape=box,color=blue];
		j3268184087 -> j1289771563;
	j1289771563 [label="\"Seni koridor koridor gezdiriyor. Bu asteroidi avucunun içi gibi biliyor, her muhafızı ve hareketlerini.\"",shape=box,color=blue];
		j1289771563 -> j2282896998;
		j1289771563 -> j1947170811;
		j1289771563 -> j1619507407;
	j2282896998 [label="Zabir'e sıçanları sor.",shape=box,color=red];
		j2282896998 -> j421884666;
	j1947170811 [label="O da tutsak mı?",shape=box,color=red];
		j1947170811 -> j3304515215;
	j1619507407 [label="Zabir beni nereye götürüyor?",shape=box,color=red];
		j1619507407 -> j1128915687;
	j421884666 [label="\"Zabir şok oldu. 'Seni sıçanlar mı buldu? Bu inanılmaz. İşe yaradı. Şuna bak.' Zabir karmaşık kabartmalı altın bir düdük tutuyor. 'Bunu bana sıçan Kraliçe verdi. Onu bulmalıyız.'\"",shape=box,color=blue];
		j421884666 -> j3113899562;
	j3304515215 [label="\"Zabir'e buraya nasıl geldiğini soruyorsun, ‘Bunun için zaman yok’ diyor, ‘buradan çıkmaya odaklanmalıyız.'\"",shape=box,color=blue];
		j3304515215 -> j2282896998;
		j3304515215 -> j1619507407;
	j1128915687 [label="\"Zabir arkasına bakar, 'Seni hangar bölümüne götürüyorum. Bir gemi çalacağız ve buradan mümkün olduğunca uzağa gideceğiz. Sıçan Kraliçe'yi bulacağız.\"",shape=box,color=blue];
		j1128915687 -> j3113899562;
	j3113899562 [label="SIÇAN KRALİÇESİ Mİ?",shape=box,color=red];
		j3113899562 -> j148059066;
	j148059066 [label="\"'Bana bu düdüğü veren oydu. Sıçanlar onu dinliyor. O benim arkadaşım. Her zaman iyi değildir, ama ona güvenebiliriz'\"",shape=box,color=blue];
		j148059066 -> j3095406908;
		j148059066 -> j1936534238;
	j3095406908 [label="Bunu Lettie'ye göstermiş olma ihtimalin var mı?",shape=box,color=red];
