		j1853730751 -> j2708743865;
	j3037967902 [label="\"Sonra bir çıtırtı sesi duyuyorsun. Çiğneme sesi gibi. Birden sıçanlar hangarın dört bir yanındaki havalandırma deliklerinden dışarı fırlıyor. Grineer muhafızları okul çocukları gibi çığlık atarak ateş açıyorlar. Her yere mermiler yağıyor.\"",shape=box,color=blue];
