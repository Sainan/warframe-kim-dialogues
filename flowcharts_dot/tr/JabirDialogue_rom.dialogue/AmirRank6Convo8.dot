		j1991182254 -> j1853730751;
	j2052571980 [label="\"Zabir düdüğü eline alıyor ve uzun bir nota çalıyor. Nefesten başka bir şey duyulmuyor. Oturup bekliyorsun ama hiçbir şey olmuyor. Ne sıçanlar geliyor, ne de başka bir şey. Zabir omzunu silkeliyor.\"",shape=box,color=blue];
		j2052571980 -> j3037967902;
	j3551934170 [label="\"Kontrol paneline ulaşıyorsun, ama dikkatli bir muhafız seni farkediyor. Teslim olmak için ellerini kaldırmaya çalışıyorsun ama yine de seni vuruyorlar, çünkü Grineer böyle acımasızdır.\"",shape=box,color=blue];
		j3551934170 -> j3803304273;
		j3551934170 -> j2589347809;
	j562522227 [label="\"Gemiye doğru kaçmaya çalışıyorsun ama rampa muhafızı seni fark ediyor ve ateş açıyor. Hayatın acı bir şekilde sona eriyor.\"",shape=box,color=blue];
