		j3211775787 -> j2399658716;
	j3876752708 [label="\"Hangarın ortasına bir Railjack park etmiş durumda. Railjack'e giden rampa bir muhafız tarafından kapatılmış. Hangarın bir tarafında bir düzine Grineer gürültülü bir zar oyunu oynamakla meşgul. Birkaç metre önünde kontrol paneli olan bir masa var.\"",shape=box,color=blue];
