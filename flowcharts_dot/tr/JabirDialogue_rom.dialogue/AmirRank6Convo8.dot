		j1099031578 -> j2117940938;
	j4040888799 [label="gerçek ya da hayali kişilerle olan benzerlikler sadece bir tesadüftür",shape=box,color=blue];
		j4040888799 -> j2117940938;
	j2117940938 [label="\"Zabir'in yardımıyla asteroidin koridorlarında zikzaklar çiziyorsun. Korumaları ve güvenlik kameralarını ustalıkla atlatıyor.\"",shape=box,color=blue];
		j2117940938 -> j327720402;
	j327720402 [label="\"Sonunda büyük bir kapıya geliyorsunuz. Zabir alçalmanızı işaret ediyor. Geminin hangarına gizlice girerken ikiniz de çömeliyorsunuz.\"",shape=box,color=blue];
		j327720402 -> j4210506629;
	j4210506629 [label="\"Bir sütunun gölgesine çömeliyorsun. Yakınlarda Grineer muhafızlarının sesi duyulabiliyor.\"",shape=box,color=blue];
		j4210506629 -> j4017807925;
	j4017807925 [label="\"Ne yaparsın?\"",shape=box,color=blue];
		j4017807925 -> j1265110505;
		j4017807925 -> j1916883050;
	j1265110505 [label="Muhafızlara saldır.",shape=box,color=red];
		j1265110505 -> j1354448193;
	j1916883050 [label="Etrafıma bakınırım.",shape=box,color=red];
		j1916883050 -> j4094507638;
	j1354448193 [label="\"Kendini koruma duygusu olmadan ve önceden düşünmeden açık alana doğru koşuyorsun. Diğer taraftaki bir grup muhafız ateş etmeye başlıyor. Seni anında öldürecek kurşun yağmuruna doğru ileri atılıyorsun. Zabir, senin anlamsız inatçı cesaretin karşısında başını sallıyor.\"",shape=box,color=blue];
		j1354448193 -> j3211775787;
	j4094507638 [label="\"Köşeyi dönüp etrafı kolaçan ediyorsun.\"",shape=box,color=blue];
		j4094507638 -> j3876752708;
	j3211775787 [label="bu sefer kendini öldürtmeden tekrar denemek ister misin?",shape=box,color=blue];
