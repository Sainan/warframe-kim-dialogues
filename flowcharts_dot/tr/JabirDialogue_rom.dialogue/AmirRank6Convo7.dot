		j335676860 -> j316404567;
	j2536004804 [label="“Arkanı dönüp zindana bakıyorsun ve kendi kendine 'oraya geri dönmek aptalca bir fikir' diye düşünüyorsun.”",shape=box,color=blue];
		j2536004804 -> j3171134689;
	j316404567 [label="“Asansöre binip yukarı çıkıyorsun. Açık kafesinden zindanın taş duvarlarının yerini giderek daha gelişmiş bir teknolojinin aldığını görüyorsun. Tekrar, 'ben hangi cehennemdeyim?' diye merak ediyorsun.”",shape=box,color=blue];
		j316404567 -> j2028698570;
	j3171134689 [label="haha... Tamam, asansörü kullan.",shape=box,color=red];
		j3171134689 -> j316404567;
	j2028698570 [label="“Asansör, gürleyen makineler ve dev tüplerden oluşan bir salona çıkıyor. Burası bir çeşit laboratuvar mı?”",shape=box,color=blue];
		j2028698570 -> j3228101269;
	j3228101269 [label="Koridorun sonundaki bir odadan bir adamın acı içinde çığlık attığını duyuyorsun.",shape=box,color=blue];
		j3228101269 -> j3509069236;
		j3228101269 -> j3283322759;
	j3509069236 [label="Çığlıkları duymazdan gel, bir çıkış yolu bul.",shape=box,color=red];
		j3509069236 -> j2146276309;
	j3283322759 [label="Çığlık atan adamın yanına git.",shape=box,color=red];
		j3283322759 -> j3969746185;
	j2146276309 [label="\"Salonda değerli bir şey olup olmadığını araştırıyorsun ama çığlıkları duymazdan gelmek imkânsız hale geliyor. Bu adama doğru çekiliyorsun ve ona yardım etmek istiyorsun.\"",shape=box,color=blue];
		j2146276309 -> j3969746185;
	j3969746185 [label="“Acı veren çığlıkların kaynağını takip ederek koridorda yürüyorsun. Büyük bir mekanik odaya giriyorsun, orada bir adam görüyorsun. Bir makineye bağlanmış, çirkin sayılmayacak tipteki bir adam. Parmaklarından çıkan elektrik akımı dev bir türbini besliyor.”",shape=box,color=blue];
		j3969746185 -> j2708914707;
		j3969746185 -> j1558811427;
	j2708914707 [label="\"N'aber?\" diye sor?",shape=box,color=red];
		j2708914707 -> j1447602356;
	j1558811427 [label="Adamı incele.",shape=box,color=red];
		j1558811427 -> j1447602356;
	j1447602356 [label="\"Adam yükseltilmiş bir platforma bağlanmış, kollarını iki yana açmış. Parmak uçlarına takılı sondalar, dev bir türbine giden ağır bir kabloya dönüşüyor. Ellerinden çıkan elektrik akımı çevik bir şekilde dans ediyor.\"",shape=box,color=blue];
		j1447602356 -> j3626904485;
