	4126 [label="\"Gardiyanın cesedini tekrar arıyorsun ama değerli bir şey bulamıyorsun. Yanındaki küflü bisküviyi yemeyi düşünüyorsun ama o anda burnuna gelen koku kararını yeniden gözden geçirmeni sağlıyor. \"",shape=box,color=blue];
		4126 -> 4130;
