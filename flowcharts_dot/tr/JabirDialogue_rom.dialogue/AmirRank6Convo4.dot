	4124 [label="\"Dikkatlice hücreden dışarı çıkıyorsun. Sağında büyük bir kapı var, bu çıkış. Kapı hafifçe aralık duruyor. Diğer tarafta daha fazla Grineer gardiyanının dolaştığını duyuyorsun. Solunda ise zindan koridoru devam ediyor ama göremeyeceğin kadar karanlık.\"",shape=box,color=blue];
