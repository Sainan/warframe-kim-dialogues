	j2452465204 [label="Merhaba. Entrati'nin zamansal çapraz bağı neden Kinemantik Çevrim İçi Ağı'na aktif bir bağlantı gibi görünen bir şeyi içeriyor?",shape=box,color=blue];
		j2452465204 -> j2404948767;
	j2404948767 [label="Ya da, Merhaba. Zaman yolculuğu için internet gerekli mi?",shape=box,color=blue];
		j2404948767 -> j1337667772;
		j2404948767 -> j1144134040;
	j1337667772 [label="Doğrudan konuya giriyorsun demek, peki. Hayır, 'internet' benim zamanımda yoktu, bu yüzden gerekli olmamalı. Ya da belki de gereklidir. ",shape=box,color=red];
		j1337667772 -> j2751101802;
