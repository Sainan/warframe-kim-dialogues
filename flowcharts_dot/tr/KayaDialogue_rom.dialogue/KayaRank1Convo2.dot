		j1144134040 -> j3005214408;
	j2751101802 [label="Öyleyse istediğin gibi girip çıkmak için internet bağlantısına ihtiyacın yok mu? Peki ya Entrati'nin var mıydı?",shape=box,color=blue];
		j2751101802 -> j3599415545;
	j3005214408 [label="Ahh. İnterneti diyorum? Bir ağın özelliklerini göz önünde bulundurduğumda bunun nasıl gerçekleşebileceğini görebiliyorum..",shape=box,color=blue];
		j3005214408 -> j3599415545;
	j3599415545 [label="Gerçekten hiçbir şeyi kesin olarak bilmiyorum. Sadece bir sekans olduğunu biliyorum, Entrati'nin bir planı vardı ve bu plan beni, burayı, ve şu anı içeriyordu. Buraya gelmem, hepinizle tanışmam gerekiyordu.",shape=box,color=red];
		j3599415545 -> j1041196145;
	j1041196145 [label="Peki, onun notlarının bazılarında neden internet bağlantısının gerekliliği var gibi görünüyor?",shape=box,color=blue];
		j1041196145 -> j2677903353;
