digraph {
	541 [label="KayaRank4Convo1 begins.",color=orange];
		541 -> 542;
	542 [label="Nasıl bir şey olduğunu bilmek ister misin? İnternet karşımıza çıkıyor, bize çok şey vaat ediyor.",shape=box,color=blue];
		542 -> 543;
	543 [label="Diyelim ki bensin. 18 yaşına giriyorsun. İnternete giriyorsun. Ve HER YERDEN yeni arkadaşlarla sohbet etmeye başlıyorsun!",shape=box,color=blue];
		543 -> 544;
	544 [label="Ve benim gibi sözde 'zeki bir kız' olarak, internetteki en aptalca şeyi yapıyorsun. ",shape=box,color=blue];
		544 -> 545;
	545 [label="Karşındaki insana güveniyorsun. ",shape=box,color=blue];
		545 -> 546;
	546 [label="Ve tüm bu yeni teknolojiye bakıyorsun ve insanların hâlâ insan olduğunu unutuyorsun. ",shape=box,color=blue];
		546 -> 547;
	547 [label="Yani Lua'nın bile yüzünün kızarmasına neden olacak çıplak bir fotoğrafını gönderiyorsun. İnternette tanıştığın biriyle bir bağın olduğunu düşünüyorsun. İnternetteki erkek arkadaşına güveniyorsun. ",shape=box,color=blue];
		547 -> 548;
	548 [label="Ve ertesi gün, o fotoğraf her yere yayılıyor. Kampüsteki herkes görüyor. Paylaşılıyor. HOCALARINA gönderiliyor. İNTERNETİN her yerine yayılıyor. Varlığından bile haberdar olmadığın ülkelerde paylaşılıyor.",shape=box,color=blue];
		548 -> 549;
	549 [label="Bu taş parçasında yaşayan en zeki kişi ben olsam da insanlar beni sadece o fotoğrafla hatırlayacak.",shape=box,color=blue];
		549 -> 550;
	550 [label="Yani buradan gideceğim dediğimde ciddiyim. Bu resmin hiçbir şey ifade etmediğini biliyorum, hayat devam etti, insanlar göreceklerini gördü.",shape=box,color=blue];
		550 -> 551;
	551 [label="Ama benim hayatımı mahvetti. İnternetin olmadığı bir gelecekte yaşamak istiyorum. Bundan sonra ilerleyebileceğimi kanıtlamak istiyorum. Geçmişe dönmek ONLARI haklı çıkarıyor, bundan kurtulamayacağımı kesinleştiriyor.",shape=box,color=blue];
		551 -> 552;
	552 [label="O yüzden bekle. Geldiğin yerde beni göreceksin. ",shape=box,color=blue];
		552 -> 553;
	553 [label="Böylece etrafıma baktığımda geçmiş seçimlerimin beni mahvetmediği görebildiğim için yeniden gülümseyebileceğim. Bunların hepsi beni daha zeki yaptı. Buradan çıkmamı sağlayacak kadar zeki.",shape=box,color=blue];
		553 -> 554;
	554 [label="+20 Chemistry",color=orange];
		554 -> 555;
	555 [label="Chat ends. Next chat will be KayaRank4Convo2.",color=orange];
}