digraph {
	graph [fontname="Roboto Condensed"];
	node [fontname="Roboto Condensed"];
	edge [fontname="Roboto Condensed"];

	"KayaRank4Convo1 begins." [color=orange];
		"KayaRank4Convo1 begins." -> j945387208;
	j945387208 [label="Nasıl bir şey olduğunu bilmek ister misin? İnternet karşımıza çıkıyor, bize çok şey vaat ediyor.",shape=box,color=blue];
		j945387208 -> j2151039375;
	j2151039375 [label="Diyelim ki bensin. 18 yaşına giriyorsun. İnternete giriyorsun. Ve HER YERDEN yeni arkadaşlarla sohbet etmeye başlıyorsun!",shape=box,color=blue];
		j2151039375 -> j869959704;
	j869959704 [label="Ve benim gibi sözde 'zeki bir kız' olarak, internetteki en aptalca şeyi yapıyorsun. ",shape=box,color=blue];
		j869959704 -> j2158678215;
	j2158678215 [label="Karşındaki insana güveniyorsun. ",shape=box,color=blue];
		j2158678215 -> j2054885637;
	j2054885637 [label="Ve tüm bu yeni teknolojiye bakıyorsun ve insanların hâlâ insan olduğunu unutuyorsun. ",shape=box,color=blue];
		j2054885637 -> j3953608917;
	j3953608917 [label="Yani Lua'nın bile yüzünün kızarmasına neden olacak çıplak bir fotoğrafını gönderiyorsun. İnternette tanıştığın biriyle bir bağın olduğunu düşünüyorsun. İnternetteki erkek arkadaşına güveniyorsun. ",shape=box,color=blue];
		j3953608917 -> j238328525;
	j238328525 [label="Ve ertesi gün, o fotoğraf her yere yayılıyor. Kampüsteki herkes görüyor. Paylaşılıyor. HOCALARINA gönderiliyor. İNTERNETİN her yerine yayılıyor. Varlığından bile haberdar olmadığın ülkelerde paylaşılıyor.",shape=box,color=blue];
		j238328525 -> j2743681055;
	j2743681055 [label="Bu taş parçasında yaşayan en zeki kişi ben olsam da insanlar beni sadece o fotoğrafla hatırlayacak.",shape=box,color=blue];
		j2743681055 -> j3031782049;
	j3031782049 [label="Yani buradan gideceğim dediğimde ciddiyim. Bu resmin hiçbir şey ifade etmediğini biliyorum, hayat devam etti, insanlar göreceklerini gördü.",shape=box,color=blue];
		j3031782049 -> j3874165780;
	j3874165780 [label="Ama benim hayatımı mahvetti. İnternetin olmadığı bir gelecekte yaşamak istiyorum. Bundan sonra ilerleyebileceğimi kanıtlamak istiyorum. Geçmişe dönmek ONLARI haklı çıkarıyor, bundan kurtulamayacağımı kesinleştiriyor.",shape=box,color=blue];
		j3874165780 -> j1497958787;
	j1497958787 [label="O yüzden bekle. Geldiğin yerde beni göreceksin. ",shape=box,color=blue];
		j1497958787 -> j898951541;
	j898951541 [label="Böylece etrafıma baktığımda geçmiş seçimlerimin beni mahvetmediği görebildiğim için yeniden gülümseyebileceğim. Bunların hepsi beni daha zeki yaptı. Buradan çıkmamı sağlayacak kadar zeki.",shape=box,color=blue];
		j898951541 -> j3258508148;
	j3258508148 [label="+20 Chemistry",color=orange];
		j3258508148 -> "Chat ends. Next chat will be KayaRank4Convo2.";
	"Chat ends. Next chat will be KayaRank4Convo2." [color=orange];
}