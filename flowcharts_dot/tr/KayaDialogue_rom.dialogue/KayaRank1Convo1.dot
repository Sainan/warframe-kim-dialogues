digraph {
	"KayaRank1Convo1 begins." [color=orange];
		"KayaRank1Convo1 begins." -> j2514786221;
	j2514786221 [label="Merhaba. Herkes zaman yolculuğu yapabiliyor mu, yoksa sadece sen mi?",shape=box,color=blue];
		j2514786221 -> j3837155708;
		j2514786221 -> j3496007909;
	j3837155708 [label="Sana da günaydın, dinle evlat, bu iş o kadar basit değil.",shape=box,color=red];
		j3837155708 -> j555243856;
	j3496007909 [label="Merhaba? Kaya? Günün nasıl geçiyor.",shape=box,color=red];
		j3496007909 -> j3962405216;
	j555243856 [label="Bana çocuk muamelesi yapma. Ben 19 yaşındayım.",shape=box,color=blue];
		j555243856 -> j1231848270;
		j555243856 -> j4166625582;
	j3962405216 [label="İyi. ",shape=box,color=blue];
		j3962405216 -> j949342424;
	j1231848270 [label="Peki. Ama yine de bu yeni grubun en genci sensin, evlat.",shape=box,color=red];
		j1231848270 -> j3710132447;
	j4166625582 [label="Evet evet, sadece zaman yolculuğu olayında acele etme. Bu... biraz karmaşık.",shape=box,color=red];
		j4166625582 -> j2260870200;
	j949342424 [label="Yani. Sadece sen mi? Başkaları da var mı? Gelecekte okullarda zaman yolculuğu öğretiliyor mu?",shape=box,color=blue];
		j949342424 -> j2716880322;
	j3710132447 [label="Ah. En genciyim, doğru, ama aynı zamanda cevapları bulmak için bir şeyler yapmaya en çok gayret eden de benim. O yüzden denemeye devam ediyorum: Zaman yolculuğu. Nasıl ve kim yapabilir?",shape=box,color=blue];
		j3710132447 -> j3710255825;
	j2260870200 [label="Ah. Nasıl karmaşık? Formülleri mi? Kimyasal ve atomik elementleri mi? Ben çözerim, bana bir yol göster yeter.",shape=box,color=blue];
		j2260870200 -> j2891548376;
		j2260870200 -> j4183316391;
	j2716880322 [label="Sadece ben varım diyelim. İşleri basit tutalım.",shape=box,color=red];
		j2716880322 -> j717990979;
	j3710255825 [label="Ve neden sen? Bir planın var mı? ",shape=box,color=blue];
		j3710255825 -> j2681641347;
	j2891548376 [label="Sana ne söyleyeceğimi gerçekten bilmiyorum. Bu sadece bilim alanı değil, ya da eğer öyleyse, Entrati'nin bildiği bir bilim.",shape=box,color=red];
		j2891548376 -> j2865147413;
	j4183316391 [label="İşte sana bir yol: Dur [Son.]",shape=box,color=red];
		j4183316391 -> j2938341431;
	j717990979 [label="Okullarda öğretilmesi konusuna gelince, eğer öyle bir şey olduysa da ben o dersleri almadım. Ama belki vardır? ",shape=box,color=red];
		j717990979 -> j361419117;
	j2681641347 [label="Ve eğer yoksa, yeteneklerinle alakalı bilimsel kaynaklara ulaşabilmem için bana ne önerebilirsin?",shape=box,color=blue];
		j2681641347 -> j1707881310;
	j2865147413 [label="Ah o namussuz. Ona daha fazla soru sormam gerektiğini biliyordum. Peki. Eğer bu bilim ise, onu yeniden üretebileceğim anlamına gelir ve sen gelip gidebildiğin için, ben de bunu çözebilirim. Hoşça kal.",shape=box,color=blue];
		j2865147413 -> j2938341431;
	j2938341431 [label="+20 Chemistry",color=orange];
		j2938341431 -> "Initiate conversation HexKayaConvo1 in /Lotus/Types/Gameplay/1999Wf/Dialogue/HexDialogue_rom.dialogue";
	j361419117 [label="Neden sordun, ödev mi istiyorsun? Zaman yolculuğu muhtemelen şimdilik çok ileri seviyede...",shape=box,color=red];
		j361419117 -> j3494182022;
	j1707881310 [label="Çok soru soruyorsun evlat. Sana bunu söylemekten nefret ediyorum ama: Bilmiyorum. Cevapları sadece Entrati biliyor.",shape=box,color=red];
		j1707881310 -> j4171111496;
	"Initiate conversation HexKayaConvo1 in /Lotus/Types/Gameplay/1999Wf/Dialogue/HexDialogue_rom.dialogue" [label="Initiate conversation HexKayaConvo1 in /Lotus/Types/Gameplay/1999Wf/Dialogue/HexDialogue_rom.dialogue",color=orange];
		"Initiate conversation HexKayaConvo1 in /Lotus/Types/Gameplay/1999Wf/Dialogue/HexDialogue_rom.dialogue" -> "Chat ends. Next chat will be KayaRank1Convo2.";
	j3494182022 [label="Aah, ciddi misin?",shape=box,color=blue];
		j3494182022 -> j3211105214;
	j4171111496 [label="Boolean KayaSetKid is now true.",color=orange];
		j4171111496 -> j484990347;
	"Chat ends. Next chat will be KayaRank1Convo2." [color=orange];
	j3211105214 [label="Hex'ten herhangi biri bunu çözebildi mi? Bilgisi olan biri var mı? ",shape=box,color=blue];
		j3211105214 -> j1561907283;
		j3211105214 -> j965143212;
	j484990347 [label="Tmm.",shape=box,color=blue];
		j484990347 -> j2938341431;
	j1561907283 [label="Belki Amir? Muhtemelen zaman yolculuğu temalı oyunlar oynuyordur...",shape=box,color=red];
		j1561907283 -> j3573187614;
	j965143212 [label="Sanmıyorum evlat. Ama eğer faydalı bir şey öğrenmek istiyorsan Lettie'den sağlık konusunda giriş dersi al.",shape=box,color=red];
		j965143212 -> j3774967233;
	j3573187614 [label="Boolean KayaAmirTravel is now true.",color=orange];
		j3573187614 -> j1569578344;
	j3774967233 [label="Boolean KayaLettieHeal is now true.",color=orange];
		j3774967233 -> j3778214359;
	j1569578344 [label="Oyun mu? Benim cevaplara, bir yönlendirmeye, benzer bir şeye ihtiyacım var. Görünüşe göre kendim çözeceğim. Bana YARDIMCI olabilecek bir şey aklına gelirse haber ver.",shape=box,color=blue];
		j1569578344 -> j2938341431;
	j3778214359 [label="Benim tarzım değil. Neyse.",shape=box,color=blue];
		j3778214359 -> j2938341431;
}