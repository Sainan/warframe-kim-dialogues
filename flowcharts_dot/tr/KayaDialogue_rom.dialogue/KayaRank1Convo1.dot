	j3211105214 [label="Hex'ten herhangi biri bunu çözebildi mi? Bilgisi olan biri var mı? ",shape=box,color=blue];
		j3211105214 -> j3511237691;
		j3211105214 -> j2406581556;
	j638483667 [label="Tmm.",shape=box,color=blue];
