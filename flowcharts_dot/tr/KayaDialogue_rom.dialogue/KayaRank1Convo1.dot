digraph {
	"KayaRank1Convo1 begins." [color=orange];
		"KayaRank1Convo1 begins." -> j2514786221;
	j2514786221 [label="Merhaba. Herkes zaman yolculuğu yapabiliyor mu, yoksa sadece sen mi?",shape=box,color=blue];
		j2514786221 -> j3837155708;
		j2514786221 -> j3496007909;
	j3837155708 [label="Sana da günaydın, dinle evlat, bu iş o kadar basit değil.",shape=box,color=red];
		j3837155708 -> j555243856;
	j3496007909 [label="Merhaba? Kaya? Günün nasıl geçiyor.",shape=box,color=red];
		j3496007909 -> j3962405216;
	j555243856 [label="Bana çocuk muamelesi yapma. Ben 19 yaşındayım.",shape=box,color=blue];
		j555243856 -> j3106446175;
		j555243856 -> j4166625582;
	j3962405216 [label="İyi. ",shape=box,color=blue];
		j3962405216 -> j949342424;
	j3106446175 [label="Peki. Ama yine de bu yeni grubun en genci sensin, evlat.",shape=box,color=red];
		j3106446175 -> j117392914;
	j4166625582 [label="Evet evet, sadece zaman yolculuğu olayında acele etme. Bu... biraz karmaşık.",shape=box,color=red];
		j4166625582 -> j2260870200;
	j949342424 [label="Yani. Sadece sen mi? Başkaları da var mı? Gelecekte okullarda zaman yolculuğu öğretiliyor mu?",shape=box,color=blue];
		j949342424 -> j2716880322;
	j117392914 [label="Ah. En genciyim, doğru, ama aynı zamanda cevapları bulmak için bir şeyler yapmaya en çok gayret eden de benim. O yüzden denemeye devam ediyorum: Zaman yolculuğu. Nasıl ve kim yapabilir?",shape=box,color=blue];
		j117392914 -> j3195684916;
	j2260870200 [label="Ah. Nasıl karmaşık? Formülleri mi? Kimyasal ve atomik elementleri mi? Ben çözerim, bana bir yol göster yeter.",shape=box,color=blue];
		j2260870200 -> j3618405149;
		j2260870200 -> j2761537184;
	j2716880322 [label="Sadece ben varım diyelim. İşleri basit tutalım.",shape=box,color=red];
		j2716880322 -> j717990979;
	j3195684916 [label="Ve neden sen? Bir planın var mı? ",shape=box,color=blue];
		j3195684916 -> j3764825167;
	j3618405149 [label="Sana ne söyleyeceğimi gerçekten bilmiyorum. Bu sadece bilim alanı değil, ya da eğer öyleyse, Entrati'nin bildiği bir bilim.",shape=box,color=red];
		j3618405149 -> j3978920598;
	j2761537184 [label="İşte sana bir yol: Dur [Son.]",shape=box,color=red];
	j717990979 [label="Okullarda öğretilmesi konusuna gelince, eğer öyle bir şey olduysa da ben o dersleri almadım. Ama belki vardır? ",shape=box,color=red];
		j717990979 -> j361419117;
	j3764825167 [label="Ve eğer yoksa, yeteneklerinle alakalı bilimsel kaynaklara ulaşabilmem için bana ne önerebilirsin?",shape=box,color=blue];
		j3764825167 -> j3066401448;
	j3978920598 [label="Ah o namussuz. Ona daha fazla soru sormam gerektiğini biliyordum. Peki. Eğer bu bilim ise, onu yeniden üretebileceğim anlamına gelir ve sen gelip gidebildiğin için, ben de bunu çözebilirim. Hoşça kal.",shape=box,color=blue];
		j3978920598 -> j2547432773;
	j361419117 [label="Neden sordun, ödev mi istiyorsun? Zaman yolculuğu muhtemelen şimdilik çok ileri seviyede...",shape=box,color=red];
		j361419117 -> j3494182022;
	j3066401448 [label="Çok soru soruyorsun evlat. Sana bunu söylemekten nefret ediyorum ama: Bilmiyorum. Cevapları sadece Entrati biliyor.",shape=box,color=red];
		j3066401448 -> j458766773;
	j2547432773 [label="+20 Chemistry",color=orange];
		j2547432773 -> "Initiate conversation HexKayaConvo1 in HexDialogue_rom.dialogue";
	j3494182022 [label="Aah, ciddi misin?",shape=box,color=blue];
		j3494182022 -> j3211105214;
	j458766773 [label="Boolean KayaSetKid is now true.",color=orange];
		j458766773 -> j638483667;
