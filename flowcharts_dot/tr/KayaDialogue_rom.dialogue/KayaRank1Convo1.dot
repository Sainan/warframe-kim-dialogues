digraph {
	0 [label="KayaRank1Convo1 begins.",color=orange];
		0 -> 1;
	1 [label="Merhaba. Herkes zaman yolculuğu yapabiliyor mu, yoksa sadece sen mi?",shape=box,color=blue];
		1 -> 2;
		1 -> 3;
	2 [label="Sana da günaydın, dinle evlat, bu iş o kadar basit değil.",shape=box,color=red];
		2 -> 4;
	3 [label="Merhaba? Kaya? Günün nasıl geçiyor.",shape=box,color=red];
		3 -> 5;
	4 [label="Bana çocuk muamelesi yapma. Ben 19 yaşındayım.",shape=box,color=blue];
		4 -> 6;
		4 -> 7;
	5 [label="İyi. ",shape=box,color=blue];
		5 -> 8;
	6 [label="Peki. Ama yine de bu yeni grubun en genci sensin, evlat.",shape=box,color=red];
		6 -> 9;
	7 [label="Evet evet, sadece zaman yolculuğu olayında acele etme. Bu... biraz karmaşık.",shape=box,color=red];
		7 -> 10;
	8 [label="Yani. Sadece sen mi? Başkaları da var mı? Gelecekte okullarda zaman yolculuğu öğretiliyor mu?",shape=box,color=blue];
		8 -> 11;
	9 [label="Ah. En genciyim, doğru, ama aynı zamanda cevapları bulmak için bir şeyler yapmaya en çok gayret eden de benim. O yüzden denemeye devam ediyorum: Zaman yolculuğu. Nasıl ve kim yapabilir?",shape=box,color=blue];
		9 -> 12;
	10 [label="Ah. Nasıl karmaşık? Formülleri mi? Kimyasal ve atomik elementleri mi? Ben çözerim, bana bir yol göster yeter.",shape=box,color=blue];
		10 -> 13;
		10 -> 14;
	11 [label="Sadece ben varım diyelim. İşleri basit tutalım.",shape=box,color=red];
		11 -> 15;
	12 [label="Ve neden sen? Bir planın var mı? ",shape=box,color=blue];
		12 -> 16;
	13 [label="Sana ne söyleyeceğimi gerçekten bilmiyorum. Bu sadece bilim alanı değil, ya da eğer öyleyse, Entrati'nin bildiği bir bilim.",shape=box,color=red];
		13 -> 17;
	14 [label="İşte sana bir yol: Dur [Son.]",shape=box,color=red];
		14 -> 1022;
	15 [label="Okullarda öğretilmesi konusuna gelince, eğer öyle bir şey olduysa da ben o dersleri almadım. Ama belki vardır? ",shape=box,color=red];
		15 -> 18;
	16 [label="Ve eğer yoksa, yeteneklerinle alakalı bilimsel kaynaklara ulaşabilmem için bana ne önerebilirsin?",shape=box,color=blue];
		16 -> 19;
	17 [label="Ah o namussuz. Ona daha fazla soru sormam gerektiğini biliyordum. Peki. Eğer bu bilim ise, onu yeniden üretebileceğim anlamına gelir ve sen gelip gidebildiğin için, ben de bunu çözebilirim. Hoşça kal.",shape=box,color=blue];
		17 -> 20;
	1022 [label="+20 Chemistry",color=orange];
		1022 -> 1018;
	18 [label="Neden sordun, ödev mi istiyorsun? Zaman yolculuğu muhtemelen şimdilik çok ileri seviyede...",shape=box,color=red];
		18 -> 21;
	19 [label="Çok soru soruyorsun evlat. Sana bunu söylemekten nefret ediyorum ama: Bilmiyorum. Cevapları sadece Entrati biliyor.",shape=box,color=red];
		19 -> 22;
	20 [label="+20 Chemistry",color=orange];
		20 -> 1015;
	1018 [label="{\"Id\":1018,\"Incoming\":[1022],\"Outgoing\":[1023],\"GraphPos\":[3236,718],\"CompletionType\":2,\"OtherDialogueInfos\":[{\"Dialogue\":\"/Lotus/Types/Gameplay/1999Wf/Dialogue/HexDialogue_rom.dialogue\",\"Tag\":\"HexKayaConvo1\",\"Value\":0}]}",color=orange];
		1018 -> 1023;
	21 [label="Aah, ciddi misin?",shape=box,color=blue];
		21 -> 24;
	22 [label="Update boolean KayaSetKid",color=orange];
		22 -> 25;
	1015 [label="{\"Id\":1015,\"Incoming\":[20],\"Outgoing\":[23],\"GraphPos\":[3252,817],\"CompletionType\":2,\"OtherDialogueInfos\":[{\"Dialogue\":\"/Lotus/Types/Gameplay/1999Wf/Dialogue/HexDialogue_rom.dialogue\",\"Tag\":\"HexKayaConvo1\",\"Value\":0}]}",color=orange];
		1015 -> 23;
	1023 [label="Chat ends. Next chat will be KayaRank1Convo2.",color=orange];
	24 [label="Hex'ten herhangi biri bunu çözebildi mi? Bilgisi olan biri var mı? ",shape=box,color=blue];
		24 -> 26;
		24 -> 27;
	25 [label="Tmm.",shape=box,color=blue];
		25 -> 28;
	23 [label="Chat ends. Next chat will be KayaRank1Convo2.",color=orange];
	26 [label="Belki Amir? Muhtemelen zaman yolculuğu temalı oyunlar oynuyordur...",shape=box,color=red];
		26 -> 29;
	27 [label="Sanmıyorum evlat. Ama eğer faydalı bir şey öğrenmek istiyorsan Lettie'den sağlık konusunda giriş dersi al.",shape=box,color=red];
		27 -> 30;
	28 [label="+20 Chemistry",color=orange];
		28 -> 996;
	29 [label="Update boolean KayaAmirTravel",color=orange];
		29 -> 32;
	30 [label="Update boolean KayaLettieHeal",color=orange];
		30 -> 33;
	996 [label="{\"Id\":996,\"Incoming\":[28],\"Outgoing\":[31],\"GraphPos\":[4241,541],\"CompletionType\":2,\"OtherDialogueInfos\":[{\"Dialogue\":\"/Lotus/Types/Gameplay/1999Wf/Dialogue/HexDialogue_rom.dialogue\",\"Tag\":\"HexKayaConvo1\",\"Value\":0}]}",color=orange];
		996 -> 31;
	32 [label="Oyun mu? Benim cevaplara, bir yönlendirmeye, benzer bir şeye ihtiyacım var. Görünüşe göre kendim çözeceğim. Bana YARDIMCI olabilecek bir şey aklına gelirse haber ver.",shape=box,color=blue];
		32 -> 34;
	33 [label="Benim tarzım değil. Neyse.",shape=box,color=blue];
		33 -> 35;
	31 [label="Chat ends. Next chat will be KayaRank1Convo2.",color=orange];
	34 [label="+20 Chemistry",color=orange];
		34 -> 998;
	35 [label="+20 Chemistry",color=orange];
		35 -> 997;
	998 [label="{\"Id\":998,\"Incoming\":[34],\"Outgoing\":[36],\"GraphPos\":[5087,255],\"CompletionType\":2,\"OtherDialogueInfos\":[{\"Dialogue\":\"/Lotus/Types/Gameplay/1999Wf/Dialogue/HexDialogue_rom.dialogue\",\"Tag\":\"HexKayaConvo1\",\"Value\":0}]}",color=orange];
		998 -> 36;
	997 [label="{\"Id\":997,\"Incoming\":[35],\"Outgoing\":[37],\"GraphPos\":[4970,380],\"CompletionType\":2,\"OtherDialogueInfos\":[{\"Dialogue\":\"/Lotus/Types/Gameplay/1999Wf/Dialogue/HexDialogue_rom.dialogue\",\"Tag\":\"HexKayaConvo1\",\"Value\":0}]}",color=orange];
		997 -> 37;
