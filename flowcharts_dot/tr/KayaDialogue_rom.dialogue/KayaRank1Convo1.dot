	"Chat ends. Next chat will be KayaRank1Convo2." [color=orange];
	j3511237691 [label="Belki Amir? Muhtemelen zaman yolculuğu temalı oyunlar oynuyordur...",shape=box,color=red];
		j3511237691 -> j127897561;
	j2406581556 [label="Sanmıyorum evlat. Ama eğer faydalı bir şey öğrenmek istiyorsan Lettie'den sağlık konusunda giriş dersi al.",shape=box,color=red];
		j2406581556 -> j3482759349;
