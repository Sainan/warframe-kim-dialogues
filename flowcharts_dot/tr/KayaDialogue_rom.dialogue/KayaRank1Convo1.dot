		j3482759349 -> j3747262063;
	j13864816 [label="Oyun mu? Benim cevaplara, bir yönlendirmeye, benzer bir şeye ihtiyacım var. Görünüşe göre kendim çözeceğim. Bana YARDIMCI olabilecek bir şey aklına gelirse haber ver.",shape=box,color=blue];
		j13864816 -> j2547432773;
	j3747262063 [label="Benim tarzım değil. Neyse.",shape=box,color=blue];
