		j3097012137 -> j1691303159;
	j1594113114 [label="Konuyu saptırmayayım. Her neyse, seninle başlayalım. Kendini daha çok ne gibi görüyorsun? Ejderha, Kartal veya bir Panter gibi mi?",shape=box,color=blue];
