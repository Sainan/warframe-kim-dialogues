		j1594113114 -> j40225942;
	j3489175307 [label="Bu en havalı seçenek gibi görünüyor ama aynı zamanda da biraz zorlayıcı, çünkü çok zayıf başlıyor.",shape=box,color=blue];
		j3489175307 -> j3404149967;
