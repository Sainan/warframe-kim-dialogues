		3976 -> 3977;
	3977 [label="Hayır! Hayır. Arthur yaşıyor. Sadece seninle bir konuyu konuşmak istedim. Bunun senin için rahatsız edici bir durum olup olmayacağını merak ettiğim bir konu hakkında konuşmak istedim.",shape=box,color=red];
