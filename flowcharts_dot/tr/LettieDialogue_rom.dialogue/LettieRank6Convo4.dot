		j2381582635 -> j1459793541;
	j3023009249 [label="Sólo las arañas\nKendilerini tekrar evlerinde hissediyorlar\nGeçip gidecekler",shape=box,color=blue];
		j3023009249 -> j3406406447;
	j1459793541 [label="Hayır, yeni bir şey yok\nSólo las arañas\nKendilerini tekrar evlerinde hissediyorlar\nGeçip gidecekler",shape=box,color=blue];
		j1459793541 -> j3406406447;
	j3406406447 [label="Bazen keşke\nBir sorun kadar kolay olsaydı\nO zaman düzeltebilirdim diyorum, ¿sí?\nKonuş, patakla jajaja",shape=box,color=blue];
		j3406406447 -> j2775012280;
	j2775012280 [label="Sorunlar çözülebilir\nSorunların yanıtları vardır\nLos sentimientos no se arreglan\nİnan bana, denedim",shape=box,color=blue];
		j2775012280 -> j3871537960;
		j2775012280 -> j3449098157;
	j3871537960 [label="Ama sevinecek çok şeyin var.",shape=box,color=red];
		j3871537960 -> j4106929660;
	j3449098157 [label="Duviri'de \"duyguları düzeltmenin\" bazen en kötü seçenek olduğunu zor yoldan öğrendim.",shape=box,color=red];
		j3449098157 -> j904079256;
	j4106929660 [label="Ay, sí, evet var\nVe bunun farkındayım\nVe bazen keşke\nİnsanlar benim o yanımı anlasalar diyorum\nBunu asla içime atmayacağım",shape=box,color=blue];
		j4106929660 -> j2697456946;
	j904079256 [label="Síí...\nGerçi bazen cazip gelse de jajaja\nHer şeyin yok olmasını dilersin\nAma bana tüm hislerin uyuştuğunu söylediğinde\nNe olduğunu anlatmıştın",shape=box,color=blue];
		j904079256 -> j3264522790;
	j2697456946 [label="Keşke farklı olabilseydim\nAma neysem oyum\nVe bunun için özür dilemekten vazgeçtim\nUzun zaman önce",shape=box,color=blue];
		j2697456946 -> "Chat ends.";
	j3264522790 [label="Bunun kimsenin başına gelmesini istemem\nTamam belki Albrecht'in\nPinche güey\nOnun kalbi zaten çok katı",shape=box,color=blue];
		j3264522790 -> j4144362461;
		j3264522790 -> j811072526;
	j4144362461 [label="Kafanı dağıtmak için ne yapabiliriz? Yoksa evde kalmayı mı tercih edersin?",shape=box,color=red];
		j4144362461 -> j2957621439;
	j811072526 [label="Sadece uzun vadeli bir oyun oynadığını umabiliriz.",shape=box,color=red];
		j811072526 -> j2296774131;
	j2957621439 [label="Eeeh, güzel soru\nDürüst olmak gerekirse emin değilim\nBurada kalmak güzel olabilir \nYa da dışarı çıkıp bir şeyler öldürebiliriz\n¿Te quedas?, ¿o vamos a matar cosas? \nKararlar, kararlar...",shape=box,color=blue];
		j2957621439 -> j3307388820;
		j2957621439 -> j2945763484;
	j2296774131 [label="O cabrón'un dahil olduğu yerde tek umudum\nAsansörde uzun bir yolculuk\nBenimle\nVe bir beyzbol sopası",shape=box,color=blue];
		j2296774131 -> j2422454094;
	j3307388820 [label="Ben kalmaktan yanayım.",shape=box,color=red];
		j3307388820 -> j746342740;
