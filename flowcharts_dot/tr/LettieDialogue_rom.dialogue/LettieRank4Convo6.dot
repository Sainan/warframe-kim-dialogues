		j1236130625 -> j1193903509;
	j2433895944 [label="Bu kadar emin misin \nBana cavia'dan bahsetmiştin \nCabrón'un zeka verip terk ettiği o zavallı hayvanlar?!",shape=box,color=blue];
		j2433895944 -> j3650425763;
	j3488178028 [label="Bu kadar emin misin \nEsa gata, bana çok akıllı görünüyor \nBana insan zekasıyla bakıyor \nGelecekte akıllı hayvanlar olacak mı?",shape=box,color=blue];
		j3488178028 -> j1702260745;
		j3488178028 -> j1193903509;
	j1963321435 [label="Cabrón'un zeka verip terk ettiği o zavallı hayvanlar değil mi?! \nOnun da onlardan biri olmadığını nereden biliyorsun?!",shape=box,color=blue];
