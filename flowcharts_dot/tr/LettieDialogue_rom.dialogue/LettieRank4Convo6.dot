	j3651697653 [label="O cabronun canını YAKACAĞIM\nOnu bir daha gördüğümde, o zavallı meleklere yaptığı gibi ben de ona işkence edeceğim \nVe bundan HOŞLANMAYACAK, sana SÖZ veriyorum",shape=box,color=blue];
