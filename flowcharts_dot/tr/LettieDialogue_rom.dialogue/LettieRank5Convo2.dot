		j715483595 -> j3266732487;
	j3785049906 [label="Sí \nBiz \nAma biz ona inanmak istedik ve bu bizi aptallaştırdı\nEğer artık etrafımızda olmak istemezsen, anlarım. \nDiğerleri de anlar",shape=box,color=blue];
