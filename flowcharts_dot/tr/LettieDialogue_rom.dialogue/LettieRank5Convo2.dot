		j1775871294 -> j706898627;
	j706898627 [label="Techrot türünün mutasyona uğradığını ve artık güvende olmadığımızı söylediğinde...",shape=box,color=blue];
		j706898627 -> j1627486966;
	j1627486966 [label="Hemen sıraya girdik \nAkıllı küçük soldaditolar gibi",shape=box,color=blue];
		j1627486966 -> j3610445997;
	j3610445997 [label="Lua, acıttı\nEğlenceli de değildi \nAoi'nin çığlıkları en kötüsüydü \nOna yardım edemedim, ben de ölmekle meşguldüm \nKorku içinde ağlıyordu ve tek yapmak istediğim ona sarılmaktı",shape=box,color=blue];
		j3610445997 -> j3703032511;
	j3703032511 [label="Ona her şeyin yoluna gireceğini söyle \nAcının geçeceğini ve La Flaca'nın onu eve götüreceğini \nÇok korkmuştu ve ona yardım edemedim \nBacaklarım çalışmıyordu...",shape=box,color=blue];
		j3703032511 -> j3009643363;
	j3009643363 [label="Ve o pislik heriften nefret edeceğim \nSonsuz hayatımın her günü\nBu ihanetten ötürü",shape=box,color=blue];
		j3009643363 -> j511110742;
	j511110742 [label="Ya onu bir daha görürsem? \nBeni tutmak için orada olsan iyi olur \nYoksa ona gerçek acının nasıl bir şey olduğunu öğreteceğim",shape=box,color=blue];
		j511110742 -> j3488390113;
