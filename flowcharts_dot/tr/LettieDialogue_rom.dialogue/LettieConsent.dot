	j3928553308 [label="Seninle bir konu hakkında konuşmak istiyorum ve bunun senin için uygun olduğundan emin olmak istiyorum.",shape=box,color=red];
		j3928553308 -> j1759404677;
	j1759404677 [label="Benim için önemli olan, sana yalan söylediğimi veya herhangi bir şekilde sana karşı dürüst olmadığımı hissetmemen.",shape=box,color=red];
		j1759404677 -> j2336016998;
		j1759404677 -> j1535609691;
		j1759404677 -> j2165106545;
	j2336016998 [label="Lütfen beni incitme.",shape=box,color=red];
		j2336016998 -> j1797460027;
	j1535609691 [label="Lütfen kızma.",shape=box,color=red];
		j1535609691 -> j4009559758;
	j2165106545 [label="Umarım beni anlarsın.",shape=box,color=red];
		j2165106545 -> j1329038253;
	j1797460027 [label="Jajajajaj\nBunu konuşmuştuk\nSeni sadece istediğin şekilde incitirim\nŞimdi ne söyleyeceksen söyle",shape=box,color=blue];
		j1797460027 -> j1812702152;
	j4009559758 [label="¿Sí?\nNeye sinirlenmeyecekmişim?",shape=box,color=blue];
		j4009559758 -> j1812702152;
	j1329038253 [label="¿Sí?\nNeyi anlayacakmışım?",shape=box,color=blue];
		j1329038253 -> j1812702152;
	j1812702152 [label="Seni istemeyeceğin bir duruma sokmak istemiyorum. Bunun daha önce konuşmadığımız bir konu olduğunu biliyorum. Yani hayır dersen sorun değil. Sadece bilmeni istiyorum.",shape=box,color=red];
		j1812702152 -> j2592570190;
	j2592570190 [label="Yaşadığımız şey benim için önemli - çok önemli - ve hislerim gerçek. Bundan şüphe duymanı istemiyorum.",shape=box,color=red];
		j2592570190 -> j959171482;
	j959171482 [label="Aah, entiendo...\nSanırım sadece bilmek istiyorum\nO kişi gerçekten bu kadar önemli mi, solecito?\n¿Quiénes son?",shape=box,color=blue];
		j959171482 -> j3169300427;
		j959171482 -> j4078582;
	j3169300427 [label="Önemsediğim birisi, evet. Ama seni de çok önemsiyorum.",shape=box,color=red];
		j3169300427 -> j1865669228;
	j4078582 [label="Olup biteni hemen anlayacağını tahmin etmeliydim.",shape=box,color=red];
		j4078582 -> j2011551037;
	j1865669228 [label="Ay, sí\nBu kadar çok şey gördüğün için\nBu kadar çok seyahat ettiğin için seni suçlamak zor\nBenim için sorun değil",shape=box,color=blue];
		j1865669228 -> j4164854896;
	j2011551037 [label="Hile yaptım\nEleanor önceden söyledi\nJajaja o korkunç bir dedikoducu",shape=box,color=blue];
		j2011551037 -> j1083824142;
	j4164854896 [label="Tek isteğim hex'ten birisi olmaması\nMi familia no, ¿por favor?\nEğer öyleyse temizlenmek için bir hafta boyunca kendimi çiselemem gerekecek",shape=box,color=blue];
		j4164854896 -> j2133714739;
	j1083824142 [label="Bu kadar çok şey gördüğün için\nBu kadar çok seyahat ettiğin için seni suçlamak zor\nBenim için sorun değil",shape=box,color=blue];
		j1083824142 -> j4164854896;
	j2133714739 [label="+20 Chemistry",color=orange];
		j2133714739 -> j1158242054;
	j1158242054 [label="Sen benim için çok önemlisin, solecito\nEğer o kişi sana mutluluk getiriyorsa...\nO zaman bana da getirir\nBu kadar basit",shape=box,color=blue];
		j1158242054 -> j461425979;
	j461425979 [label="Ah\nVe onu bir gün buraya getirmenin bir yolunu bul\nOnunla tanışmak isterim",shape=box,color=blue];
		j461425979 -> j3328050550;
		j461425979 -> j387874708;
	j3328050550 [label="Elbette hanımefendi. :)",shape=box,color=red];
