	j3928553308 [label="Seninle bir konu hakkında konuşmak istiyorum ve bunun senin için uygun olduğundan emin olmak istiyorum.",shape=box,color=red];
		j3928553308 -> j1759404677;
	j1759404677 [label="Benim için önemli olan, sana yalan söylediğimi veya herhangi bir şekilde sana karşı dürüst olmadığımı hissetmemen.",shape=box,color=red];
		j1759404677 -> j1444864259;
		j1759404677 -> j753282393;
		j1759404677 -> j2324720453;
	j1444864259 [label="Lütfen beni incitme.",shape=box,color=red];
		j1444864259 -> j487196614;
	j753282393 [label="Lütfen kızma.",shape=box,color=red];
		j753282393 -> j1209193502;
	j2324720453 [label="Umarım beni anlarsın.",shape=box,color=red];
		j2324720453 -> j2761163670;
	j487196614 [label="Jajajajaj\nBunu konuşmuştuk\nSeni sadece istediğin şekilde incitirim\nŞimdi ne söyleyeceksen söyle",shape=box,color=blue];
		j487196614 -> j559572744;
	j1209193502 [label="¿Sí?\nNeye sinirlenmeyecekmişim?",shape=box,color=blue];
		j1209193502 -> j559572744;
	j2761163670 [label="¿Sí?\nNeyi anlayacakmışım?",shape=box,color=blue];
		j2761163670 -> j559572744;
	j559572744 [label="Seni istemeyeceğin bir duruma sokmak istemiyorum. Bunun daha önce konuşmadığımız bir konu olduğunu biliyorum. Yani hayır dersen sorun değil. Sadece bilmeni istiyorum.",shape=box,color=red];
		j559572744 -> j1545441371;
	j1545441371 [label="Yaşadığımız şey benim için önemli - çok önemli - ve hislerim gerçek. Bundan şüphe duymanı istemiyorum.",shape=box,color=red];
		j1545441371 -> j453792383;
	j453792383 [label="Aah, entiendo...\nBiliyorsun, böyle konuları didiklemeyi sevmem\nAma sanırım sadece bilmek istiyorum\nOnu gerçekten önemsiyor musun, solecito?\n¿Quiénes son?\nOnu gerçekten önemsiyor musun?",shape=box,color=blue];
		j453792383 -> j1551594407;
		j453792383 -> j1135828661;
	j1551594407 [label="Önemsediğim birisi, evet. Ama seni de çok önemsiyorum.",shape=box,color=red];
		j1551594407 -> j2823693211;
	j1135828661 [label="Olup biteni hemen anlayacağını tahmin etmeliydim.",shape=box,color=red];
		j1135828661 -> j2268445771;
	j2823693211 [label="Ay, sí\nBu kadar çok şey gördüğün için\nSayısız yeri seyahat ettiğin için seni suçlamak zor\nKendi başınıza takılırken beni de işin içine karıştırmayın yeter\nGerisi benim için sorun değil",shape=box,color=blue];
		j2823693211 -> j4164854896;
	j2268445771 [label="Hile yaptım\nEleanor önceden söyledi\nJajaja o korkunç bir dedikoducu",shape=box,color=blue];
		j2268445771 -> j3137793306;
	j4164854896 [label="Tek isteğim hex'ten birisi olmaması\nMi familia no, ¿por favor?\nEğer öyleyse temizlenmek için bir hafta boyunca kendimi çiselemem gerekecek",shape=box,color=blue];
		j4164854896 -> j2133714739;
	j3137793306 [label="Bu kadar çok şey gördüğün için\nSayısız yeri seyahat ettiğin için seni suçlamak zor\nKendi başınıza takılırken beni de işin içine karıştırmayın yeter\nGerisi benim için sorun değil",shape=box,color=blue];
		j3137793306 -> j4164854896;
	j2133714739 [label="+20 Chemistry",color=orange];
		j2133714739 -> j1158242054;
	j1158242054 [label="Sen benim için çok önemlisin, solecito\nEğer o kişi sana mutluluk getiriyorsa...\nO zaman bana da getirir\nBu kadar basit",shape=box,color=blue];
		j1158242054 -> j461425979;
	j461425979 [label="Ah\nVe onu bir gün buraya getirmenin bir yolunu bul\nOnunla tanışmak isterim",shape=box,color=blue];
		j461425979 -> j3328050550;
		j461425979 -> j387874708;
	j3328050550 [label="Elbette hanımefendi. :)",shape=box,color=red];
