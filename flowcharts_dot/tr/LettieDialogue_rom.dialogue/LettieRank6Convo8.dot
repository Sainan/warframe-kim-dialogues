		j2942301881 -> j1333015362;
	j912502254 [label="Kaçmak istediği için onu suçlamıyorum\nEğer yapabilseydim, ben de kaçardım\nBüyüdüğünde, bu his de kaybolacak",shape=box,color=blue];
