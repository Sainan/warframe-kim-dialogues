	j4001080862 [label="Işınlanması pek de yardımcı olmuyor\nAmir'i ürkütmesini izlemeyi seviyorum\nHızlı namussuz bunu hak ediyor, bunu bize yeterince yapıyor JAJAJAJA\nUmarım temelli gitmez.",shape=box,color=blue];
