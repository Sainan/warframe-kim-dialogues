	j1333015362 [label="Zamansal Arşimet konusunda yardımcı olabilecek tek kişi o.",shape=box,color=red];
		j1333015362 -> j2375281516;
	j4036312983 [label="Ona yardımcı olamadığım için üzgünüm.",shape=box,color=red];
		j4036312983 -> j3981027440;
	j3792757221 [label="Bu, ona yardım edebileceğin bir şey mi?",shape=box,color=red];
		j3792757221 -> j3981027440;
	j2511117598 [label="JAJAJA bana seni asla acil durum irtibat kişisi olarak kaydetmemeyi hatırlat\nSííí, gezmek için gidiyor ama sonra buraya geri geliyor\nZamansal Arşi-her neyse onun için\nAma aynı zamanda... bizim için de uğraşıyor, sanırım",shape=box,color=blue];
		j2511117598 -> j2679519283;
	j2375281516 [label="Sííí, Zamansal Arşi-her neyse onun için\nAma aynı zamanda... bizim için de uğraşıyor, sanırım",shape=box,color=blue];
		j2375281516 -> j2679519283;
	j3981027440 [label="Bazen sadece zaman alır\nAma eğer yapabilirsem ona yardım etmeye çalışacağım\nLua tıp bilimine karşı yeterince meraklı olduğunu biliyor jajaja\nElla siempre hace preguntas espeluznantes",shape=box,color=blue];
		j3981027440 -> j2094395267;
	j2679519283 [label="Onun burada takılması güzel\nSanırım o da bunu biliyor\nHem bana operasyonlarda yardım etmeyi de seviyor...\nElla siempre hace preguntas espeluznantes",shape=box,color=blue];
		j2679519283 -> j4001080862;
	j2094395267 [label="Işınlanması pek de yardımcı olmuyor\nAmir'i ürkütmesini izlemeyi seviyorum\nHızlı namussuz bunu hak ediyor, bunu bize yeterince yapıyor JAJAJAJA",shape=box,color=blue];
