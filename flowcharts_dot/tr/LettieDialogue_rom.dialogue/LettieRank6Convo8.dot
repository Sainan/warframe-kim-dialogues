		j3763405073 -> j211824645;
	j628857448 [label="Ona, korkan kişi kendisi olduğunu ve tüm dünyanın ona karşı olduğunu hissettirmek istiyorum\nHerkes ona gülsün\nHerkes ona alay etsin istiyorum",shape=box,color=blue];
		j628857448 -> j648861902;
	j211824645 [label="Planın bu olduğunu kim söyledi\nOnun tipini biliyorum\nHepsi korkak, güvenli olduğunu düşündükleri yerden klavye delikanlılığı yapıyorlar",shape=box,color=blue];
		j211824645 -> j628857448;
	j648861902 [label="Benim gibi görünerek büyümenin nasıl bir şey olduğunu biliyor musun?\nBenim gibi konuşarak?\nBenim gibi giyinerek?\nAskeri üslerde benim gibi giyinmeyen insanlarla çevrili olmak nasıl biliyor musun?",shape=box,color=blue];
		j648861902 -> j1792506236;
	j1792506236 [label="Hakkımı savunduğum için genellikle eve çoğunlukla dayak yemiş bir şekilde gelirdim\nAnnem her zaman cık cıklar ve başımı öne eğmem gerektiğini söylerdi\n¿Quedarme callada?\nHadi be oradan",shape=box,color=blue];
		j1792506236 -> j580547789;
