digraph {
	graph [fontname="Roboto Condensed"];
	node [fontname="Roboto Condensed"];
	edge [fontname="Roboto Condensed"];

	"ArthurRank6Convo4 begins." [color=orange];
		"ArthurRank6Convo4 begins." -> j3954810950;
	j3954810950 [label="Є дивне запитання. А в космосі є іграшки?",shape=box,color=blue];
		j3954810950 -> j2680710687;
		j3954810950 -> j3839831730;
	j2680710687 [label="Дитячі чи як? Звісно є.",shape=box,color=red];
		j2680710687 -> j100792174;
	j3839831730 [label="Які саме… іграшки?",shape=box,color=red];
		j3839831730 -> j1405370473;
	j100792174 [label="Так? Серйозно?",shape=box,color=blue];
		j100792174 -> j2545804271;
	j1405370473 [label="ТА СОЛЕ МИЛИЙ. Я не про те геть. Ти ж знаєш!",shape=box,color=blue];
		j1405370473 -> j605167273;
	j2545804271 [label="Складно уявити, як за хтозна-скільки тисяч років у майбутньому",shape=box,color=blue];
		j2545804271 -> j1547774550;
	j605167273 [label="Я про дитячі іграшки. Ляльки. Фігурки. Щось таке.",shape=box,color=blue];
		j605167273 -> j3784966618;
		j605167273 -> j3581070326;
	j1547774550 [label="дітлахи собі сидять і відтворюють якісь байки за допомогою маленьких фігурок, розігруючи ролі «бандитів з лісу» чи «рятівників принцес».",shape=box,color=blue];
		j1547774550 -> j4066796659;
		j1547774550 -> j1955809967;
		j1547774550 -> j544305245;
	j3784966618 [label="Це я ставлю тебе в незручне становище. :Р",shape=box,color=red];
		j3784966618 -> j1691251243;
	j3581070326 [label="Ні, у нас нічого такого нема. [Завершити розмову]",shape=box,color=red];
		j3581070326 -> "Chat ends.";
	j4066796659 [label="Що навело тебе на це питання?",shape=box,color=red];
		j4066796659 -> j3766734549;
	j1955809967 [label="А з якими іграми виріс ти?",shape=box,color=red];
		j1955809967 -> j498364205;
	j544305245 [label="Назви наших ігор точно відрізняються, але іграшки точно є.",shape=box,color=red];
		j544305245 -> j557460944;
	j1691251243 [label="Так, звісно є. ",shape=box,color=red];
		j1691251243 -> j100792174;
	"Chat ends." [color=orange];
	j3766734549 [label="Та я оце дивлюся як Амір вовтузиться зі своїми гральними автоматами. ",shape=box,color=blue];
		j3766734549 -> j408073137;
	j498364205 [label="Знати, що, попри всі відмінності наших культур та часів, діти… лишаються дітьми й граються з іграшками.",shape=box,color=blue];
		j498364205 -> j580120558;
	j557460944 [label="І які?",shape=box,color=blue];
		j557460944 -> j2059096104;
		j557460944 -> j866144343;
	j408073137 [label="І оце подумав собі, що віддав би чимало чого, щоб знову відчувати таку радість у своєму житті.",shape=box,color=blue];
		j408073137 -> j3911433782;
	j580120558 [label="У мене була фігурка. Солдатик, як не дивно. Звався Анґусом.",shape=box,color=blue];
		j580120558 -> j331063252;
	j2059096104 [label="Та різні фігурки, м’які іграшки, кубики. Типове дитяче барахло. ",shape=box,color=red];
		j2059096104 -> j498364205;
	j866144343 [label="У мене була — напевно, можна сказати «лялька» — даксового дитя. А ім’я взято з моєї книжки. Домін Тракс.",shape=box,color=red];
		j866144343 -> j2477014993;
	j3911433782 [label="Я ніколи не зневажав Аой, Аміра чи от зараз Каю за вміння знайти радість у своїх «дитячих розвагах». Це мене ніколи не бентежило.",shape=box,color=blue];
		j3911433782 -> j1883910909;
	j331063252 [label="Під час одного зі святкувань Сонцестояння група старших хлопчаків забрали його й купу інших моїх іграшок і… ну…",shape=box,color=blue];
		j331063252 -> j3980651272;
	j2477014993 [label="Ай, трясця. Я мусив здогадатися. Мені прикро, що витягнув ці спогади.",shape=box,color=blue];
		j2477014993 -> j2457303631;
		j2477014993 -> j2586692162;
	j1883910909 [label="Але іноді стає страшно від думки, що та частина мене, що здатна відчувати подібне… всохла, згорнулася як висохлий листок і давно померла.",shape=box,color=blue];
		j1883910909 -> j3064911001;
	j3980651272 [label="Це довга історія. Якщо скоротити… З їхніх слів я був «занадто дорослий», щоби бавитися з лялечками. Тоді я востаннє грався з іграшками.",shape=box,color=blue];
		j3980651272 -> j3634310169;
	j2457303631 [label="Та… не найліпша тема розмов для мене.",shape=box,color=red];
		j2457303631 -> j3920490751;
	j2586692162 [label="Усе гаразд. Ти не винен.",shape=box,color=red];
		j2586692162 -> j435171455;
	j3064911001 [label="Доволі сумно, чи не так? Бо ми кажемо дітям щось любити й цінувати, а потім кажемо викинути геть, бо вони «подорослішали».",shape=box,color=blue];
		j3064911001 -> j3617280147;
		j3064911001 -> j452239881;
	j3634310169 [label="Якогось дня я спостерігав як грає Амір. Було чітко видно його захоплення й прив’язаність до цього. І скільки щастя й радості це йому дає. І я відчув трішки заздрощів, бо в мене нічого такого подібного нема.",shape=box,color=blue];
		j3634310169 -> j3064911001;
	j3920490751 [label="Тепер я почуваюся капітальним дурбецелом.",shape=box,color=blue];
		j3920490751 -> "Chat ends.";
	j435171455 [label="У нас були всі звичайні іграшки, які б ти, певно, міг уявити. Кубики, м’які, фігурки… ляльки.",shape=box,color=red];
		j435171455 -> j584249327;
	j3617280147 [label="Ну не знаю. Рано чи пізно, але всім нам доводиться подорослішати. Сховати самих себе від життя за допомогою уяви не вийде. Це мені вдалося зрозуміти на власній шкурі.",shape=box,color=red];
		j3617280147 -> j1191432867;
	j452239881 [label="Я вважаю, що життя може бути гидким, болісним і коротким. Тож маємо заповнити його якомога більшою купою веселощів, сміху та любові.",shape=box,color=red];
		j452239881 -> j447180330;
	j584249327 [label="Просто моя почала створювати певні клопоти. Через усі ці «ігри» з Порожнечею.",shape=box,color=red];
		j584249327 -> j498364205;
	j1191432867 [label="Слушне зауваження. Гадаю, коли воно починає замінювати реальні речі, то це стає проблемою. Але я не про те.",shape=box,color=blue];
		j1191432867 -> j1003432850;
	j447180330 [label="Так. Слушна думка. Сподіваюся, що ми це пам’ятатимемо, коли разом рухатимемося далі в… тому, у чому ми є.",shape=box,color=blue];
		j447180330 -> j1003432850;
	j1003432850 [label="Знаєш. Я зненацька натрапив на Елеонору, Велимира, Аой та Аміра, коли вони гралися в хованки з Флер і Ліззі. Квінсі сказав, йому не можна, бо він «гад і шахраює, використовуючи приціл для бачення крізь стіни».",shape=box,color=blue];
		j1003432850 -> j883698916;
	j883698916 [label="Вони всі стривожено дивилися на мене. Думали, я засмучуся, буду кричати й гніватися, що вони бавляться, а не займаються чимось корисним.",shape=box,color=blue];
		j883698916 -> j46691525;
	j46691525 [label="Але я більше засмутився від того, що мене не покликали долучитися. Ха. Але ж я маю бути набундюченим ватажком, який сердитий від того, що на постах ніхто не чергує… ну, ти знаєш.",shape=box,color=blue];
		j46691525 -> j2531735693;
	j2531735693 [label="Але в Аміра є його ігри. В Аой — On-lyne. Навіть у Каї є липучки й карти «Джинімон», попри те, що світ так рано примусив її стати дорослою.",shape=box,color=blue];
		j2531735693 -> j642674898;
		j2531735693 -> j400065550;
	j642674898 [label="Є якась думка, до якої ти намагаєшся вести?",shape=box,color=red];
		j642674898 -> j408726799;
	j400065550 [label="Гадаю, це можна вернути, якщо спробувати. Маю на увазі радість від іграшок та ігор.",shape=box,color=red];
		j400065550 -> j53752804;
	j408726799 [label="Чесно? Я геть не впевнений. Можу окреслити лише те, що я ніби як сумую за чимось, що зникло з мого життя дуже-дуже давно.",shape=box,color=blue];
		j408726799 -> j792264747;
	j53752804 [label="Я вже чую насмішки. Але, певно, це й насправді стримує мене, так? Сором?",shape=box,color=blue];
		j53752804 -> j1305489019;
	j792264747 [label="Я не певен чи зможу щось повернути. Чи вже занадто пізно. Та хто зна. За наявності достатньої кількості часу можливе все.",shape=box,color=blue];
		j792264747 -> "Chat ends.";
	j1305489019 [label="Я не певен, чи можливо щось повернути. Навіть якщо я зможу пройти крізь тимчасову ганьбу. Та хтозна. За достатньої кількості петель можливе все.",shape=box,color=blue];
		j1305489019 -> "Chat ends.";
}