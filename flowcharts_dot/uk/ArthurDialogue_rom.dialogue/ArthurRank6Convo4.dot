digraph {
	3433 [label="ArthurRank6Convo4 begins.",color=orange];
		3433 -> 3434;
	3434 [label="Є дивне запитання. А в космосі є іграшки?",shape=box,color=blue];
		3434 -> 3435;
		3434 -> 3436;
	3435 [label="Дитячі чи як? Звісно є.",shape=box,color=red];
		3435 -> 3437;
	3436 [label="Які саме… іграшки?",shape=box,color=red];
		3436 -> 3438;
	3437 [label="Так? Серйозно?",shape=box,color=blue];
		3437 -> 3439;
	3438 [label="ТА СОЛЕ МИЛИЙ. Я не про те геть. Ти ж знаєш!",shape=box,color=blue];
		3438 -> 3440;
	3439 [label="Складно уявити, як за хтозна-скільки тисяч років у майбутньому",shape=box,color=blue];
		3439 -> 3441;
	3440 [label="Я про дитячі іграшки. Ляльки. Фігурки. Щось таке.",shape=box,color=blue];
		3440 -> 3442;
		3440 -> 3448;
	3441 [label="дітлахи собі сидять і відтворюють якісь байки за допомогою маленьких фігурок, розігруючи ролі «бандитів з лісу» чи «рятівників принцес».",shape=box,color=blue];
		3441 -> 3444;
		3441 -> 3445;
		3441 -> 3446;
	3442 [label="Це я ставлю тебе в незручне становище. :Р",shape=box,color=red];
		3442 -> 3447;
	3448 [label="Ні, у нас нічого такого нема. [Завершити розмову]",shape=box,color=red];
		3448 -> 3452;
	3444 [label="Що навело тебе на це питання?",shape=box,color=red];
		3444 -> 3449;
	3445 [label="А з якими іграми виріс ти?",shape=box,color=red];
		3445 -> 3450;
	3446 [label="Назви наших ігор точно відрізняються, але іграшки точно є.",shape=box,color=red];
		3446 -> 3451;
	3447 [label="Так, звісно є. ",shape=box,color=red];
		3447 -> 3437;
	3452 [label="Chat ends.",color=orange];
	3449 [label="Та я оце дивлюся як Амір вовтузиться зі своїми гральними автоматами. ",shape=box,color=blue];
		3449 -> 3453;
	3450 [label="Знати, що, попри всі відмінності наших культур та часів, діти… лишаються дітьми й граються з іграшками.",shape=box,color=blue];
		3450 -> 3454;
	3451 [label="І які?",shape=box,color=blue];
		3451 -> 3455;
		3451 -> 3456;
	3453 [label="І оце подумав собі, що віддав би чимало чого, щоб знову відчувати таку радість у своєму житті.",shape=box,color=blue];
		3453 -> 3457;
	3454 [label="У мене була фігурка. Солдатик, як не дивно. Звався Анґусом.",shape=box,color=blue];
		3454 -> 3458;
	3455 [label="Та різні фігурки, м’які іграшки, кубики. Типове дитяче барахло. ",shape=box,color=red];
		3455 -> 3450;
	3456 [label="У мене була — напевно, можна сказати «лялька» — даксового дитя. А ім’я взято з моєї книжки. Домін Тракс.",shape=box,color=red];
		3456 -> 3459;
	3457 [label="Я ніколи не зневажав Аой, Аміра чи от зараз Каю за вміння знайти радість у своїх «дитячих розвагах». Це мене ніколи не бентежило.",shape=box,color=blue];
		3457 -> 3460;
	3458 [label="Під час одного зі святкувань Сонцестояння група старших хлопчаків забрали його й купу інших моїх іграшок і… ну…",shape=box,color=blue];
		3458 -> 3461;
	3459 [label="Ай, трясця. Я мусив здогадатися. Мені прикро, що витягнув ці спогади.",shape=box,color=blue];
		3459 -> 3462;
		3459 -> 3463;
	3460 [label="Але іноді стає страшно від думки, що та частина мене, що здатна відчувати подібне… всохла, згорнулася як висохлий листок і давно померла.",shape=box,color=blue];
		3460 -> 3464;
	3461 [label="Це довга історія. Якщо скоротити… З їхніх слів я був «занадто дорослий», щоби бавитися з лялечками. Тоді я востаннє грався з іграшками.",shape=box,color=blue];
		3461 -> 3465;
	3462 [label="Та… не найліпша тема розмов для мене.",shape=box,color=red];
		3462 -> 3466;
	3463 [label="Усе гаразд. Ти не винен.",shape=box,color=red];
		3463 -> 3467;
	3464 [label="Доволі сумно, чи не так? Бо ми кажемо дітям щось любити й цінувати, а потім кажемо викинути геть, бо вони «подорослішали».",shape=box,color=blue];
		3464 -> 3468;
		3464 -> 3469;
	3465 [label="Якогось дня я спостерігав як грає Амір. Було чітко видно його захоплення й прив’язаність до цього. І скільки щастя й радості це йому дає. І я відчув трішки заздрощів, бо в мене нічого такого подібного нема.",shape=box,color=blue];
		3465 -> 3464;
	3466 [label="Тепер я почуваюся капітальним дурбецелом.",shape=box,color=blue];
		3466 -> 3470;
	3467 [label="У нас були всі звичайні іграшки, які б ти, певно, міг уявити. Кубики, м’які, фігурки… ляльки.",shape=box,color=red];
		3467 -> 3471;
	3468 [label="Ну не знаю. Рано чи пізно, але всім нам доводиться подорослішати. Сховати самих себе від життя за допомогою уяви не вийде. Це мені вдалося зрозуміти на власній шкурі.",shape=box,color=red];
		3468 -> 3472;
	3469 [label="Я вважаю, що життя може бути гидким, болісним і коротким. Тож маємо заповнити його якомога більшою купою веселощів, сміху та любові.",shape=box,color=red];
		3469 -> 3473;
	3470 [label="Chat ends.",color=orange];
	3471 [label="Просто моя почала створювати певні клопоти. Через усі ці «ігри» з Порожнечею.",shape=box,color=red];
		3471 -> 3450;
	3472 [label="Слушне зауваження. Гадаю, коли воно починає замінювати реальні речі, то це стає проблемою. Але я не про те.",shape=box,color=blue];
		3472 -> 3474;
	3473 [label="Так. Слушна думка. Сподіваюся, що ми це пам’ятатимемо, коли разом рухатимемося далі в… тому, у чому ми є.",shape=box,color=blue];
		3473 -> 3474;
	3474 [label="Знаєш. Я зненацька натрапив на Елеонору, Велимира, Аой та Аміра, коли вони гралися в хованки з Флер і Ліззі. Квінсі сказав, йому не можна, бо він «гад і шахраює, використовуючи приціл для бачення крізь стіни».",shape=box,color=blue];
		3474 -> 3475;
	3475 [label="Вони всі стривожено дивилися на мене. Думали, я засмучуся, буду кричати й гніватися, що вони бавляться, а не займаються чимось корисним.",shape=box,color=blue];
		3475 -> 3476;
	3476 [label="Але я більше засмутився від того, що мене не покликали долучитися. Ха. Але ж я маю бути набундюченим ватажком, який сердитий від того, що на постах ніхто не чергує… ну, ти знаєш.",shape=box,color=blue];
		3476 -> 3477;
	3477 [label="Але в Аміра є його ігри. В Аой — On-lyne. Навіть у Каї є липучки й карти «Джинімон», попри те, що світ так рано примусив її стати дорослою.",shape=box,color=blue];
		3477 -> 3478;
		3477 -> 3479;
	3478 [label="Є якась думка, до якої ти намагаєшся вести?",shape=box,color=red];
		3478 -> 3480;
	3479 [label="Гадаю, це можна вернути, якщо спробувати. Маю на увазі радість від іграшок та ігор.",shape=box,color=red];
		3479 -> 3481;
	3480 [label="Чесно? Я геть не впевнений. Можу окреслити лише те, що я ніби як сумую за чимось, що зникло з мого життя дуже-дуже давно.",shape=box,color=blue];
		3480 -> 3482;
	3481 [label="Я вже чую насмішки. Але, певно, це й насправді стримує мене, так? Сором?",shape=box,color=blue];
		3481 -> 3483;
	3482 [label="Я не певен чи зможу щось повернути. Чи вже занадто пізно. Та хто зна. За наявності достатньої кількості часу можливе все.",shape=box,color=blue];
		3482 -> 3484;
	3483 [label="Я не певен, чи можливо щось повернути. Навіть якщо я зможу пройти крізь тимчасову ганьбу. Та хтозна. За достатньої кількості петель можливе все.",shape=box,color=blue];
		3483 -> 3485;
	3484 [label="Chat ends.",color=orange];
	3485 [label="Chat ends.",color=orange];
}