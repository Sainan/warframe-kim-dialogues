		1535 -> 1536;
	1531 [label="Ха.",shape=box,color=blue];
		1531 -> 1532;
	1537 [label="Упевнений.",shape=box,color=blue];
		1537 -> 1538;
	1538 [label="Усі йдуть до армії з різних причин. Я пішов заради… честі. Задля мети.",shape=box,color=blue];
		1538 -> 1539;
	1536 [label="Chat ends.",color=orange];
	1539 [label="Я хотів бути героєм, як якийсь проклятий Солом дурень.",shape=box,color=blue];
		1539 -> 1540;
	1540 [label="Річ у тому, що я мав величезні грандіозні думки про те, що значить бути Солдатом.",shape=box,color=blue];
		1540 -> 1541;
	1541 [label="Захищати Принца й Принципи.",shape=box,color=blue];
		1541 -> 1542;
	1542 [label="Але дізнався, яка ж це все маячня насправді.",shape=box,color=blue];
		1542 -> 1543;
		1542 -> 1544;
		1542 -> 1545;
	1543 [label="Що сталося?",shape=box,color=red];
		1543 -> 1547;
	1544 [label="Ох?",shape=box,color=red];
		1544 -> 1547;
	1545 [label="Мені треба йти. [Завершити розмову]",shape=box,color=red];
		1545 -> 1546;
	1547 [label="Як солдат ти не маєш ДУМАТИ. Лише виконувати накази.",shape=box,color=blue];
		1547 -> 1548;
	1546 [label="Chat ends.",color=orange];
	1548 [label="Неважливо які.",shape=box,color=blue];
		1548 -> 1549;
	1549 [label="Отже, коли мене відправили далеко за лінію зіткнення і наказали вбити всіх «потенційних ворожих бійців»…",shape=box,color=blue];
		1549 -> 1550;
	1550 [label="Я зробив те, що робить хороший солдат. Я виконав наказ.",shape=box,color=blue];
		1550 -> 1551;
		1550 -> 1552;
	1551 [label="Гадаю, я розумію куди це все веде…",shape=box,color=red];
		1551 -> 1553;
	1552 [label="О ні…",shape=box,color=red];
		1552 -> 1554;
	1553 [label="Для цього не треба бути генієм.",shape=box,color=blue];
		1553 -> 1555;
	1554 [label="Ага.",shape=box,color=blue];
		1554 -> 1555;
	1555 [label="Я не знаю скільки невинних життів ми тоді забрали.",shape=box,color=blue];
		1555 -> 1556;
	1556 [label="Але їх було забагато.",shape=box,color=blue];
		1556 -> 1557;
	1557 [label="За повернення я вимагав відповідей і причин для кровопролиття невинних, а штабні погрожували звільненням з ганьбою.",shape=box,color=blue];
		1557 -> 1558;
	1558 [label="Стули пельку. Роби свою роботу. Стріляй зі своєї зброї. Убивай, як хороший солдат.",shape=box,color=blue];
		1558 -> 1559;
	1559 [label="Не. Став. Запитань.",shape=box,color=blue];
		1559 -> 1560;
	1560 [label="Їхня була правда. Не варто було ставити запитання. Я кепсько вмію діставатися до суті.",shape=box,color=blue];
		1560 -> 1561;
		1560 -> 1562;
	1561 [label="Але…",shape=box,color=red];
		1561 -> 1563;
	1562 [label="Артуре…",shape=box,color=red];
		1562 -> 1563;
	1563 [label="Ні. Дай завершити. Я кепсько вмію діставатися до суті таємниць. А знаєш хто це добре вміє?",shape=box,color=blue];
		1563 -> 1564;
	1564 [label="І хто журналістка за фахом? І хто має зв’язки у кожному важливому виданні того часу?",shape=box,color=blue];
		1564 -> 3144;
	3144 [label="*Елеонора*.",shape=box,color=blue];
		3144 -> 1565;
	1565 [label="Тож угода уклалася швидко й просто. Мене випускають раніше на пенсію або крани відкриваються і лайно тече. Тоді я не був дуже важливим для них. Мені дали тихо піти.",shape=box,color=blue];
		1565 -> 1566;
	1566 [label="Update boolean ArthurSoldierTold",color=orange];
		1566 -> 1567;
		1566 -> 1568;
	1567 [label="Тож після цього ти приєднався до МРК?",shape=box,color=red];
		1567 -> 1569;
	1568 [label="Це була не твоя провина. Те, що сталося.",shape=box,color=red];
		1568 -> 1570;
	1569 [label="Так. І потрапив у ту саму пастку наївного хлопака. Повірив, що керівництву не байдуже до цивільних.",shape=box,color=blue];
		1569 -> 1571;
	1570 [label="Якби ж мені платили щоразу, як Елеонора говорила це…",shape=box,color=blue];
		1570 -> 1572;
		1570 -> 1573;
	1571 [label="А вони вирішили вбивати всіх потенційно заражених — без різниці правда це чи ні.",shape=box,color=blue];
		1571 -> 1574;
	1572 [label="А ти хоч раз прислухався до неї?",shape=box,color=red];
