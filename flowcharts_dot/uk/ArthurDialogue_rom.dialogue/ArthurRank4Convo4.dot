	1573 [label="О-о, то ми могли би встановити гарячу ванну!",shape=box,color=red];
		1573 -> 1578;
	1574 [label="Я просто… не зміг. Як і решта з «Прокльону». Тому… ми й тут.",shape=box,color=blue];
		1574 -> 1575;
		1574 -> 1576;
	1577 [label="Ну тепер ти точно говориш як вона.",shape=box,color=blue];
