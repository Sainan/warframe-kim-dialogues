	1524 [label="Я вже шкодую про це…",shape=box,color=blue];
		1524 -> 1530;
	1532 [label="Ти доволі терпляче до мене ставишся. Якщо досі прагнеш дізнатися чому я пішов із британської армії… то я вже, певно, маю двічі цю історію розповісти.",shape=box,color=blue];
		1532 -> 1533;
		1532 -> 1534;
		1532 -> 1535;
	1526 [label="Що сталося, Джеймсе?",shape=box,color=red];
		1526 -> 1524;
	1530 [label="Ніяк не втриматися, вибач. :Р То що ти хотів?",shape=box,color=red];
		1530 -> 1531;
	1533 [label="Упевнений?",shape=box,color=red];
		1533 -> 1537;
	1534 [label="Сідаю зручненько, слухаю уважненько.",shape=box,color=red];
		1534 -> 1538;
