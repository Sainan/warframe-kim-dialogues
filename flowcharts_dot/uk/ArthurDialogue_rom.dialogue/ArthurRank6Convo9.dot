digraph {
	3555 [label="ArthurRank6Convo9 begins.",color=orange];
		3555 -> 3556;
	3556 [label="Щось це мене трохи непокоїть… ота вся заражена зброя, яку збирає Елеонора.",shape=box,color=blue];
		3556 -> 3557;
		3556 -> 3558;
	3557 [label="Чому?",shape=box,color=red];
		3557 -> 3559;
	3558 [label="Принаймні жодна з них не балакає.",shape=box,color=red];
		3558 -> 3560;
	3559 [label="Потрібно ще щось, окрім того, що я вважаю, що вона може говорити з ними всіма?",shape=box,color=blue];
		3559 -> 3561;
	3560 [label="З *нами*. Не дуже впевнений, що та зброя не розмовляє з *нею*.",shape=box,color=blue];
		3560 -> 3561;
	3561 [label="Я знаю, що вони балакають із гітарою. І про це не хочеться думати більше, аніж потрібно.",shape=box,color=blue];
		3561 -> 3562;
	3562 [label="Але чи варто нам переживати про те… що ця зброя поширюється? Схоже, вона може розмножуватися.",shape=box,color=blue];
		3562 -> 3563;
	3563 [label="І я не розумію як. І я геть не хочу заглиблюватися в думки звідки беруться набої. Чи, що важливіше, яка будова цієї зброї.",shape=box,color=blue];
		3563 -> 3564;
		3563 -> 3565;
	3564 [label="Принаймні ці заражені речі на нашому боці, так?",shape=box,color=red];
		3564 -> 3566;
	3565 [label="Може, тоді тобі варто користуватися звичнішою зброєю?",shape=box,color=red];
		3565 -> 3567;
	3566 [label="Звісно. *Поки що*.",shape=box,color=blue];
		3566 -> 3568;
	3567 [label="Гадаю, я так і зроблю.",shape=box,color=blue];
		3567 -> 3568;
	3568 [label="Тоді я точно знатиму, що моя відстрелена п’ятка — моя ідіотська провина, а не розумної живої допоміжної зброї.",shape=box,color=blue];
		3568 -> 3569;
	3569 [label="Яка чомусь вирішила поміркувати над екзистенційною кризою, переосмислити відданість чи просто захотіла перекусити опівночі.",shape=box,color=blue];
		3569 -> 3570;
	3570 [label="Chat ends.",color=orange];
}