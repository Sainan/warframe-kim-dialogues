digraph {
	"ArthurRank6Convo9 begins." [color=orange];
		"ArthurRank6Convo9 begins." -> j995548934;
	j995548934 [label="Щось це мене трохи непокоїть… ота вся заражена зброя, яку збирає Елеонора.",shape=box,color=blue];
		j995548934 -> j2569194531;
		j995548934 -> j60909110;
	j2569194531 [label="Чому?",shape=box,color=red];
		j2569194531 -> j3000255687;
	j60909110 [label="Принаймні жодна з них не балакає.",shape=box,color=red];
		j60909110 -> j3299641701;
	j3000255687 [label="Потрібно ще щось, окрім того, що я вважаю, що вона може говорити з ними всіма?",shape=box,color=blue];
		j3000255687 -> j941752015;
	j3299641701 [label="З *нами*. Не дуже впевнений, що та зброя не розмовляє з *нею*.",shape=box,color=blue];
		j3299641701 -> j941752015;
	j941752015 [label="Я знаю, що вони балакають із гітарою. І про це не хочеться думати більше, аніж потрібно.",shape=box,color=blue];
		j941752015 -> j470850632;
	j470850632 [label="Але чи варто нам переживати про те… що ця зброя поширюється? Схоже, вона може розмножуватися.",shape=box,color=blue];
		j470850632 -> j2911460681;
	j2911460681 [label="І я не розумію як. І я геть не хочу заглиблюватися в думки звідки беруться набої. Чи, що важливіше, яка будова цієї зброї.",shape=box,color=blue];
		j2911460681 -> j324712350;
		j2911460681 -> j3489646831;
	j324712350 [label="Принаймні ці заражені речі на нашому боці, так?",shape=box,color=red];
		j324712350 -> j2600251400;
	j3489646831 [label="Може, тоді тобі варто користуватися звичнішою зброєю?",shape=box,color=red];
		j3489646831 -> j209018328;
	j2600251400 [label="Звісно. *Поки що*.",shape=box,color=blue];
		j2600251400 -> j402730185;
	j209018328 [label="Гадаю, я так і зроблю.",shape=box,color=blue];
		j209018328 -> j402730185;
	j402730185 [label="Тоді я точно знатиму, що моя відстрелена п’ятка — моя ідіотська провина, а не розумної живої допоміжної зброї.",shape=box,color=blue];
		j402730185 -> j1002407591;
	j1002407591 [label="Яка чомусь вирішила поміркувати над екзистенційною кризою, переосмислити відданість чи просто захотіла перекусити опівночі.",shape=box,color=blue];
		j1002407591 -> "Chat ends.";
	"Chat ends." [color=orange];
}