		2563 -> 2564;
	2539 [label="Вона ніколи не вірила владі. Але після того, що сталося з нами обома. Уже ніколи й не повірить.",shape=box,color=blue];
		2539 -> 2775;
		2539 -> 2776;
	2547 [label="Так і було.",shape=box,color=blue];
		2547 -> 2548;
	2549 [label="Крістофер потягав за кілька ниток, натиснув там і тут і я потрапив до того ж підрозділу, що й він. 3-й батальйон Багряної Варти.",shape=box,color=blue];
		2549 -> 2550;
