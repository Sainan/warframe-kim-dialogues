		2552 -> 2553;
	2569 [label="Породжені війною, хоча й у різний спосіб. У нас обох були втрати за життя.",shape=box,color=blue];
		2569 -> 2570;
	2553 [label="А я лишався наївним дурнем. Ідіотом, який дуже квапився підібрати залишену ним мантію…",shape=box,color=blue];
