		2548 -> 2549;
	2550 [label="Але за тиждень до мого прибуття… сталася трагедія. Міна на узбіччі.",shape=box,color=blue];
		2550 -> 2551;
	2565 [label="Я… у мене насправді не було нікого, за кого потрібно було битися. Донедавна. Саме тому ти звертаєшся до мене «мандрівниче».",shape=box,color=red];
		2565 -> 2567;
	2566 [label="Слухай, у мене вже скінчилося все уявне пиво. Тепер треба вже справжнє.",shape=box,color=red];
		2566 -> 2568;
	2551 [label="І як велика кількість хороших чоловіків та жінок… хороших солдатів…",shape=box,color=blue];
		2551 -> 2552;
	2567 [label="Навіть не можу сказати кому з нас було гірше. Обидвом. Напевно.",shape=box,color=blue];
