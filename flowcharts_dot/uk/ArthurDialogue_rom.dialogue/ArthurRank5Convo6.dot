		2536 -> 2537;
	2543 [label="Знаєш, мандрівниче… цю частину не я маю розповідати. А Елеонора. Я скажу лише, що від’їзд Крістофера на війну…",shape=box,color=blue];
		2543 -> 2544;
	2561 [label="Але іноді варто вітати старі примари.",shape=box,color=blue];
