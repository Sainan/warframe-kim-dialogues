digraph {
	"ArthurRank6Convo2 begins." [color=orange];
		"ArthurRank6Convo2 begins." -> j2689413099;
	j2689413099 [label="Я тут подумав. На твою думку, чи багато там ще таких, як ми?",shape=box,color=blue];
		j2689413099 -> j1876963055;
		j2689413099 -> j2541873044;
	j1876963055 [label="Ти про 1999 чи взагалі?",shape=box,color=red];
		j1876963055 -> j728397854;
	j2541873044 [label="Тобто як ми?",shape=box,color=red];
		j2541873044 -> j1899990829;
	j728397854 [label="І те й інше, напевно. Тут, зараз, у минулому, у майбутньому.",shape=box,color=blue];
		j728397854 -> j3148050053;
	j1899990829 [label="Протофреймів. Тут чи будь-де. Чи будь-*коли*…",shape=box,color=blue];
		j1899990829 -> j3148050053;
	j3148050053 [label="Нас Ентраті зробив задля чогось. Задля чималої купи чогось. Це стало ясно, коли виявилося, що нас не лише шестеро. ",shape=box,color=blue];
		j3148050053 -> j3471075960;
		j3148050053 -> j1370607639;
	j3471075960 [label="Спершу була думка, що він зробив мені «запасних» ворфреймів на випадок, якщо мої не пройдуть крізь гельмінта. А тепер уже такої впевненості нема.",shape=box,color=red];
		j3471075960 -> j721846326;
	j1370607639 [label="Якби ж то знати, що він запланував. Або яка мотивація насправді ховається за створенням інших протофреймів.",shape=box,color=red];
		j1370607639 -> j2762024384;
	j721846326 [label="Це мало сенс, коли нас було лише шестеро.",shape=box,color=blue];
		j721846326 -> j2762024384;
	j2762024384 [label="Ти насправді вважаєш, що його справжньою мотивацією було зупинити Байдужість?",shape=box,color=blue];
		j2762024384 -> j1042262172;
	j1042262172 [label="Хіба ми можемо *насправді* довіряти йому?",shape=box,color=blue];
		j1042262172 -> j2449909230;
		j1042262172 -> j906367436;
		j1042262172 -> j1075762206;
	j2449909230 [label="Чесно, я не знаю. Я не вірю йому аж настільки, наскільки далеко можна було б його швирогонути. А без ворфрейма моє кидання доволі лайняне.",shape=box,color=red];
		j2449909230 -> j3416342312;
	j906367436 [label="Ні. Його мотивам можна довіряти настільки, наскільки ми можемо довіряти його методам.",shape=box,color=red];
		j906367436 -> j4265558496;
		j906367436 -> j2508283611;
	j1075762206 [label="Ага. Я можу не погоджуватися з його методами. Але ж трясця. Він хоче зупинити ту штуку.",shape=box,color=red];
		j1075762206 -> j2508283611;
		j1075762206 -> j4265558496;
	j3416342312 [label="+5 Chemistry",color=orange];
		j3416342312 -> j2362346008;
	j4265558496 [label="Він намагається запхати джина назад у кляту лампу, якщо це взагалі можливо. І виходить доволі брудно.",shape=box,color=red];
		j4265558496 -> j380225142;
	j2508283611 [label="Та чи є в нас вибір, га? Ми з малою тільки те й робимо, що намагаємося наздогнати, розгрібаючи створений безлад.",shape=box,color=red];
		j2508283611 -> j2271050504;
		j2508283611 -> j2683894727;
	j2362346008 [label="Ха.",shape=box,color=blue];
		j2362346008 -> j4265558496;
		j2362346008 -> j2508283611;
	j380225142 [label="А ми — шкільні наглядачі, які миють за ним підлогу. Прекрасно.",shape=box,color=blue];
		j380225142 -> j2271050504;
		j380225142 -> j2683894727;
	j2271050504 [label="Оскільки Кая розібралася з часовими переміщеннями, то може статися, що стрибки вперед-назад полегшаться для мене.",shape=box,color=red];
		j2271050504 -> j1345173567;
	j2683894727 [label="Але я лишаюся тут, тож тепер усе вирішує маля.",shape=box,color=red];
		j2683894727 -> j161265069;
	j1345173567 [label="Та мала — добряча скалка в сраці… іноді. Але я ціную вашу роботу.",shape=box,color=blue];
		j1345173567 -> j3372692229;
	j161265069 [label="Check boolean ArthurDating",color=orange];
		j161265069 -> j3193642202 [label=true,color=green];
		j161265069 -> j3002081166 [label=false,color=brown];
	j3372692229 [label="Приємно знати, що коли ти виходиш у крамничку… по хліб… то таки повернешся… :/",shape=box,color=blue];
		j3372692229 -> j2613732724;
	j3193642202 [label="Гм. Це ми ще побачимо. Коханнячко, я ж тебе вже добре знаю. Особливо те, що ти не петраєш, коли треба трохи охолонути й нишкнути.",shape=box,color=blue];
		j3193642202 -> j3165683454;
	j3002081166 [label="Гм. Це ми ще побачимо. Мандрівниче, я ж тебе вже добре знаю. Особливо те, що ти не петраєш, коли треба трохи охолонути й нишкнути.",shape=box,color=blue];
		j3002081166 -> j3152590923;
	j2613732724 [label="Check boolean ArthurDating",color=orange];
		j2613732724 -> j3866178502 [label=true,color=green];
		j2613732724 -> j1459529393 [label=false,color=brown];
		j2613732724 -> j1454795482 [label=false,color=brown];
	j3165683454 [label="Це одна з причин, чому я тебе так обожнюю. ;)",shape=box,color=blue];
		j3165683454 -> j1454795482;
	j3152590923 [label="Це одна з причин, чого я терплю тебе поруч. ;)",shape=box,color=blue];
		j3152590923 -> j1459529393;
	j3866178502 [label="Я перед нею у боргу — дає мені щось схоже на душевний спокій. :)",shape=box,color=blue];
		j3866178502 -> j1459529393;
		j3866178502 -> j1454795482;
	j1459529393 [label="Емоційка! :D",shape=box,color=red];
		j1459529393 -> j4130758718;
	j1454795482 [label="Воу-воу, ти полегше трохи.",shape=box,color=red];
		j1454795482 -> j3330289910;
	j4130758718 [label="Так-так. Ти тільки не звикай. Бо це досі дуже дивно.",shape=box,color=blue];
		j4130758718 -> j3395517705;
	j3330289910 [label="М-м, ну ти ж мене знаєш. Хрустка скоринка, м’яка серединка. Як зачерствіла випічка, про яку постійно базікають Амір із Велимиром.",shape=box,color=blue];
		j3330289910 -> j3980394403;
	j3395517705 [label="Ну, це мені лестить.",shape=box,color=red];
		j3395517705 -> j1591443109;
	j3980394403 [label="Твіби?",shape=box,color=blue];
		j3980394403 -> j1591443109;
	j1591443109 [label="Менше з тим, вертаємося до теми. Іноді хочеться піддатися гнітючому відчуттю, що в Ентраті для нас усіх заплановане щось значно більше.",shape=box,color=blue];
		j1591443109 -> j1100198127;
		j1591443109 -> j694011220;
		j1591443109 -> j2510122307;
	j1100198127 [label="Це чого б це?",shape=box,color=red];
		j1100198127 -> j2231347247;
	j694011220 [label="Ага, може воно й так.",shape=box,color=red];
		j694011220 -> j2376483490;
	j2510122307 [label="А може це тобі просто так хочеться?",shape=box,color=red];
		j2510122307 -> j901363870;
	j2231347247 [label="Може купа зусиль, докладена у створення нас як «нас»? І той факт, що таких «нас» не лише шестеро»…",shape=box,color=blue];
		j2231347247 -> j4190343678;
	j2376483490 [label="І що це на твою думку? І чого він чекає тоді?",shape=box,color=blue];
		j2376483490 -> j997328358;
		j2376483490 -> j4213180205;
	j901363870 [label="Ти про що?",shape=box,color=blue];
		j901363870 -> j322564245;
		j901363870 -> j332782302;
	j4190343678 [label="Дружаньо, ти не робиш таку зброю, якщо не знаєш де будеш її застосовувати.",shape=box,color=blue];
		j4190343678 -> j4143516985;
	j997328358 [label="<RETRO_EMOJI_SHRUG>",shape=box,color=red];
		j997328358 -> j1035016018;
	j4213180205 [label="Якби ж то мені знати… на обидва питання.",shape=box,color=red];
		j4213180205 -> j1035016018;
	j322564245 [label="Іноді дуже складно усвідомлювати, що твоя роль уже «не головна».",shape=box,color=red];
		j322564245 -> j3105488284;
	j332782302 [label="Ну, я просто кажу… може ти просто не хочеш почуватися ним покинутим.",shape=box,color=red];
		j332782302 -> j2734816108;
	j4143516985 [label="Хіба що *знаєш*, що буде війна.",shape=box,color=blue];
		j4143516985 -> j140419087;
		j4143516985 -> j2960636383;
		j4143516985 -> j3166747670;
	j1035016018 [label="Може бути, що йому потрібна армія? Може, він намагається знайти «саме те», що здолає Байдужість? А може й так, що це все означає чимало всього.",shape=box,color=red];
		j1035016018 -> j4172721468;
	j3105488284 [label="Ага…",shape=box,color=blue];
		j3105488284 -> "Chat ends.";
	j2734816108 [label="Заради б чого він тут не був, чи що б він не зробив тобі. Усе це має значення. Це досі актуально. Це стало хибою.",shape=box,color=red];
		j2734816108 -> j626620317;
		j2734816108 -> j1989049871;
	j140419087 [label="Тоді все, що в наших силах… це бути готовими, якщо це станеться.",shape=box,color=red];
		j140419087 -> j339263016;
	j2960636383 [label="Можливо. Але Ентраті наче з тих, хто має плани на випадок неврахованих ситуацій. ",shape=box,color=red];
		j2960636383 -> j2562084330;
	j3166747670 [label="Я не знаю. Мінерва з Велимиром розповідали мені про… «Холодну війну»? Наче люди наробили купу всілякої зброї й ніколи її не використовували.",shape=box,color=red];
		j3166747670 -> j136333987;
	j4172721468 [label="Ніяк не відкину думки, що ми — прості набої. Маємо бути використані. Витрачені. І викинуті геть.",shape=box,color=blue];
		j4172721468 -> j106180474;
		j4172721468 -> j1963597068;
	"Chat ends." [color=orange];
	j626620317 [label="І, якщо чесно, ти досі маєш значення.",shape=box,color=red];
		j626620317 -> j2236985347;
		j626620317 -> j3021788985;
		j626620317 -> j2663258351;
	j1989049871 [label="І, якщо чесно, ти досі маєш значення *для мене*. ",shape=box,color=red];
		j1989049871 -> j2236985347;
		j1989049871 -> j3021788985;
		j1989049871 -> j2663258351;
	j339263016 [label="+5 Chemistry",color=orange];
		j339263016 -> j3494516525;
	j2562084330 [label="Можливо.",shape=box,color=blue];
		j2562084330 -> j1090499709;
	j136333987 [label="Слушний контраргумент. Але це було між країнами, включало дипломатію. Це не просто.",shape=box,color=blue];
		j136333987 -> j1566376005;
	j106180474 [label="Якби ж у мене була відповідь. Але зроблю все можливе, щоб завадити такому сценарію.",shape=box,color=red];
		j106180474 -> j2336549584;
	j1963597068 [label="Гадаєш, що з тобою ще не покінчено?",shape=box,color=red];
		j1963597068 -> j803163895;
	j2236985347 [label="Але думати, що твоя історія завершується так, без участі у завершальному акті? Паскудство.",shape=box,color=red];
		j2236985347 -> j3860458856;
	j3021788985 [label="Але може так болить, бо вважаєш, що десь тебе замінив «Артур 2.0»?",shape=box,color=red];
		j3021788985 -> j2325058055;
	j2663258351 [label="Але може тобі просто хочеться, щоб твої жертви мали сенс, але в дещо космічніших масштабах?",shape=box,color=red];
		j2663258351 -> j1361662481;
	j3494516525 [label="Згода.",shape=box,color=blue];
		j3494516525 -> j398241674;
	j1090499709 [label="Частка мене й справді сподівається, що там десь є ще подібні нам. Але якщо вони всі припруться сюди? Тоді зрештою доведеться шукати більший ТЦ.",shape=box,color=blue];
		j1090499709 -> "Chat ends.";
	j1566376005 [label="У нас же ж буквально ситуація з божеством та чуваком, який вважає себе таким же ж.",shape=box,color=blue];
		j1566376005 -> j2542331977;
	j2336549584 [label="Та я знаю. І той день ми зустрінемо пліч-о-пліч. Це вже точно.",shape=box,color=blue];
		j2336549584 -> j2397353713;
	j803163895 [label="Дружаньо, ні. Ти не робиш таку зброю, якщо не знаєш, де будеш її застосовувати.",shape=box,color=blue];
		j803163895 -> j1774197557;
		j803163895 -> j2960636383;
		j803163895 -> j140419087;
	j3860458856 [label="А, може, це частина цього всього? А якщо Байдужість причина мене такого? І я маю пройти через це?",shape=box,color=blue];
		j3860458856 -> j43118152;
	j2325058055 [label="Дружаньо, я був готовий вийти на пенсію, перш ніж мене засмоктало це лайно. Так що це навряд.",shape=box,color=blue];
		j2325058055 -> j810280510;
	j1361662481 [label="Може й так. А може й ні. Знаєш, скільки людських жертв насправді не значать нічого? Більшість із них.",shape=box,color=blue];
		j1361662481 -> j1548829079;
	j398241674 [label="І якщо подібні нам заявляться сюди? Дуже сподіваюся, що зрештою не доведеться шукати більший ТЦ.",shape=box,color=blue];
		j398241674 -> "Chat ends.";
	j2542331977 [label="Ставлю на те, що сутичка неминуча. Не думаю, що їхнє его дозволить якось розійтися миром.",shape=box,color=blue];
		j2542331977 -> j2280600968;
		j2542331977 -> j2435369812;
	j2397353713 [label="+5 Chemistry",color=orange];
		j2397353713 -> j1648722223;
	j1774197557 [label="Я не знаю. Мінерва з Велимиром розповідали мені про… «Холодну війну»? Наче люди наробили купу всілякої зброї й ніколи її не використовували.",shape=box,color=red];
		j1774197557 -> j1446747032;
	j43118152 [label="Мені не завадить допомога, щоб здолати це.",shape=box,color=blue];
		j43118152 -> j746864350;
	j810280510 [label="Я досі в захваті від твоєї зухвалої здібності іноді пірнати в це з головою.",shape=box,color=blue];
		j810280510 -> "Chat ends.";
	j1548829079 [label="Може, мене просто гнітить думка, що таких як ми — ціла армія. Що нас створив божевільний без жодної чіткої причини чому. Або для чого.",shape=box,color=blue];
		j1548829079 -> j1099058272;
	j2280600968 [label="Може й твоя тут правда.",shape=box,color=red];
		j2280600968 -> j3523993614;
	j2435369812 [label="Дуже сподіваюся, що ти помиляєшся.",shape=box,color=red];
		j2435369812 -> j1621031259;
