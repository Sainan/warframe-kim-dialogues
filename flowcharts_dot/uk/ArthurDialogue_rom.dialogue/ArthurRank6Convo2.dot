	j1621031259 [label="+5 Chemistry",color=orange];
		j1621031259 -> j3221639054;
	j4122886011 [label="Дяк, коханнячко.",shape=box,color=blue];
		j4122886011 -> "Chat ends.";
	j909660278 [label="Дяки, мандрівниче.",shape=box,color=blue];
		j909660278 -> "Chat ends.";
	j2729315681 [label="У нас же ж буквально ситуація з божеством та чуваком, який уважає себе таким же ж.",shape=box,color=blue];
		j2729315681 -> j36398169;
	j2364795858 [label="Я не хочу лишатися якоюсь виноскою в літописі. Я хочу взяти свою скану і встромити цій штуці просто в сраку.",shape=box,color=blue];
		j2364795858 -> j562755139;
		j2364795858 -> j191165049;
