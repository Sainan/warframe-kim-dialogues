		j1446747032 -> j2729315681;
	j746864350 [label="+5 Chemistry",color=orange];
		j746864350 -> j2364795858;
	j1099058272 [label="Мені сказали страждати й сказали жертвувати — без жодної причини чому. Або для чого.",shape=box,color=blue];
		j1099058272 -> j4211427106;
