digraph {
	3229 [label="ArthurRank6Convo2 begins.",color=orange];
		3229 -> 3230;
	3230 [label="Я тут подумав. На твою думку, чи багато там ще таких, як ми?",shape=box,color=blue];
		3230 -> 3231;
		3230 -> 3232;
	3231 [label="Ти про 1999 чи взагалі?",shape=box,color=red];
		3231 -> 3233;
	3232 [label="Тобто як ми?",shape=box,color=red];
		3232 -> 3234;
	3233 [label="І те й інше, напевно. Тут, зараз, у минулому, у майбутньому.",shape=box,color=blue];
		3233 -> 3235;
	3234 [label="Протофреймів. Тут чи будь-де. Чи будь-*коли*…",shape=box,color=blue];
		3234 -> 3235;
	3235 [label="Нас Ентраті зробив задля чогось. Задля чималої купи чогось. Це стало ясно, коли виявилося, що нас не лише шестеро. ",shape=box,color=blue];
		3235 -> 3236;
		3235 -> 3237;
	3236 [label="Спершу була думка, що він зробив мені «запасних» ворфреймів на випадок, якщо мої не пройдуть крізь гельмінта. А тепер уже такої впевненості нема.",shape=box,color=red];
		3236 -> 3238;
	3237 [label="Якби ж то знати, що він запланував. Або яка мотивація насправді ховається за створенням інших протофреймів.",shape=box,color=red];
		3237 -> 3239;
	3238 [label="Це мало сенс, коли нас було лише шестеро.",shape=box,color=blue];
		3238 -> 3239;
	3239 [label="Ти насправді вважаєш, що його справжньою мотивацією було зупинити Байдужість?",shape=box,color=blue];
		3239 -> 3240;
	3240 [label="Хіба ми можемо *насправді* довіряти йому?",shape=box,color=blue];
		3240 -> 3241;
		3240 -> 3242;
		3240 -> 3243;
	3241 [label="Чесно, я не знаю. Я не вірю йому аж настільки, наскільки далеко можна було б його швирогонути. А без ворфрейма моє кидання доволі лайняне.",shape=box,color=red];
		3241 -> 3244;
	3242 [label="Ні. Його мотивам можна довіряти настільки, наскільки ми можемо довіряти його методам.",shape=box,color=red];
		3242 -> 3245;
		3242 -> 3246;
	3243 [label="Ага. Я можу не погоджуватися з його методами. Але ж трясця. Він хоче зупинити ту штуку.",shape=box,color=red];
		3243 -> 3246;
		3243 -> 3245;
	3244 [label="+5 Chemistry",color=orange];
		3244 -> 3247;
	3245 [label="Він намагається запхати джина назад у кляту лампу, якщо це взагалі можливо. І виходить доволі брудно.",shape=box,color=red];
		3245 -> 3248;
	3246 [label="Та чи є в нас вибір, га? Ми з малою тільки те й робимо, що намагаємося наздогнати, розгрібаючи створений безлад.",shape=box,color=red];
		3246 -> 3249;
		3246 -> 3250;
	3247 [label="Ха.",shape=box,color=blue];
		3247 -> 3245;
		3247 -> 3246;
	3248 [label="А ми — шкільні наглядачі, які миють за ним підлогу. Прекрасно.",shape=box,color=blue];
		3248 -> 3249;
		3248 -> 3250;
	3249 [label="Оскільки Кая розібралася з часовими переміщеннями, то може статися, що стрибки вперед-назад полегшаться для мене.",shape=box,color=red];
		3249 -> 3251;
	3250 [label="Але я лишаюся тут, тож тепер усе вирішує маля.",shape=box,color=red];
		3250 -> 3254;
	3251 [label="Та мала — добряча скалка в сраці… іноді. Але я ціную вашу роботу.",shape=box,color=blue];
		3251 -> 3253;
	3254 [label="Check boolean ArthurDating",color=orange];
		3254 -> 3603 [label=true,color=green];
		3254 -> 3252 [label=false,color=brown];
	3253 [label="Приємно знати, що коли ти виходиш у крамничку… по хліб… то таки повернешся… :/",shape=box,color=blue];
		3253 -> 3255;
	3603 [label="Гм. Це ми ще побачимо. Коханнячко, я ж тебе вже добре знаю. Особливо те, що ти не петраєш, коли треба трохи охолонути й нишкнути.",shape=box,color=blue];
		3603 -> 3257;
	3252 [label="Гм. Це ми ще побачимо. Мандрівниче, я ж тебе вже добре знаю. Особливо те, що ти не петраєш, коли треба трохи охолонути й нишкнути.",shape=box,color=blue];
		3252 -> 3256;
	3255 [label="Check boolean ArthurDating",color=orange];
		3255 -> 3260 [label=true,color=green];
		3255 -> 3258 [label=false,color=brown];
		3255 -> 3259 [label=false,color=brown];
	3257 [label="Це одна з причин, чому я тебе так обожнюю. ;)",shape=box,color=blue];
		3257 -> 3259;
	3256 [label="Це одна з причин, чого я терплю тебе поруч. ;)",shape=box,color=blue];
		3256 -> 3258;
	3260 [label="Я перед нею у боргу — дає мені щось схоже на душевний спокій. :)",shape=box,color=blue];
		3260 -> 3258;
		3260 -> 3259;
	3258 [label="Емоційка! :D",shape=box,color=red];
		3258 -> 3261;
	3259 [label="Воу-воу, ти полегше трохи.",shape=box,color=red];
		3259 -> 3262;
	3261 [label="Так-так. Ти тільки не звикай. Бо це досі дуже дивно.",shape=box,color=blue];
		3261 -> 3263;
	3262 [label="М-м, ну ти ж мене знаєш. Хрустка скоринка, м’яка серединка. Як зачерствіла випічка, про яку постійно базікають Амір із Велимиром.",shape=box,color=blue];
		3262 -> 3264;
	3263 [label="Ну, це мені лестить.",shape=box,color=red];
		3263 -> 3265;
	3264 [label="Твіби?",shape=box,color=blue];
		3264 -> 3265;
	3265 [label="Менше з тим, вертаємося до теми. Іноді хочеться піддатися гнітючому відчуттю, що в Ентраті для нас усіх заплановане щось значно більше.",shape=box,color=blue];
		3265 -> 3266;
		3265 -> 3267;
		3265 -> 3268;
	3266 [label="Це чого б це?",shape=box,color=red];
		3266 -> 3269;
	3267 [label="Ага, може воно й так.",shape=box,color=red];
		3267 -> 3270;
	3268 [label="А може це тобі просто так хочеться?",shape=box,color=red];
		3268 -> 3271;
	3269 [label="Може купа зусиль, докладена у створення нас як «нас»? І той факт, що таких «нас» не лише шестеро»…",shape=box,color=blue];
		3269 -> 3272;
	3270 [label="І що це на твою думку? І чого він чекає тоді?",shape=box,color=blue];
		3270 -> 3273;
		3270 -> 3274;
	3271 [label="Ти про що?",shape=box,color=blue];
		3271 -> 3275;
		3271 -> 3276;
	3272 [label="Дружаньо, ти не робиш таку зброю, якщо не знаєш де будеш її застосовувати.",shape=box,color=blue];
		3272 -> 3277;
	3273 [label="<RETRO_EMOJI_SHRUG>",shape=box,color=red];
		3273 -> 3278;
	3274 [label="Якби ж то мені знати… на обидва питання.",shape=box,color=red];
		3274 -> 3278;
	3275 [label="Іноді дуже складно усвідомлювати, що твоя роль уже «не головна».",shape=box,color=red];
		3275 -> 3279;
	3276 [label="Ну, я просто кажу… може ти просто не хочеш почуватися ним покинутим.",shape=box,color=red];
		3276 -> 3280;
	3277 [label="Хіба що *знаєш*, що буде війна.",shape=box,color=blue];
		3277 -> 3281;
		3277 -> 3282;
		3277 -> 3283;
	3278 [label="Може бути, що йому потрібна армія? Може, він намагається знайти «саме те», що здолає Байдужість? А може й так, що це все означає чимало всього.",shape=box,color=red];
		3278 -> 3284;
	3279 [label="Ага…",shape=box,color=blue];
		3279 -> 3285;
	3280 [label="Заради б чого він тут не був, чи що б він не зробив тобі. Усе це має значення. Це досі актуально. Це стало хибою.",shape=box,color=red];
		3280 -> 3286;
		3280 -> 3287;
	3281 [label="Тоді все, що в наших силах… це бути готовими, якщо це станеться.",shape=box,color=red];
		3281 -> 3288;
	3282 [label="Можливо. Але Ентраті наче з тих, хто має плани на випадок неврахованих ситуацій. ",shape=box,color=red];
		3282 -> 3289;
	3283 [label="Я не знаю. Мінерва з Велимиром розповідали мені про… «Холодну війну»? Наче люди наробили купу всілякої зброї й ніколи її не використовували.",shape=box,color=red];
		3283 -> 3290;
	3284 [label="Ніяк не відкину думки, що ми — прості набої. Маємо бути використані. Витрачені. І викинуті геть.",shape=box,color=blue];
		3284 -> 3291;
		3284 -> 3292;
	3285 [label="Chat ends.",color=orange];
	3286 [label="І, якщо чесно, ти досі маєш значення.",shape=box,color=red];
		3286 -> 3293;
		3286 -> 3294;
		3286 -> 3295;
	3287 [label="І, якщо чесно, ти досі маєш значення *для мене*. ",shape=box,color=red];
		3287 -> 3293;
		3287 -> 3294;
		3287 -> 3295;
	3288 [label="+5 Chemistry",color=orange];
		3288 -> 3296;
	3289 [label="Можливо.",shape=box,color=blue];
		3289 -> 3297;
	3290 [label="Слушний контраргумент. Але це було між країнами, включало дипломатію. Це не просто.",shape=box,color=blue];
		3290 -> 3298;
	3291 [label="Якби ж у мене була відповідь. Але зроблю все можливе, щоб завадити такому сценарію.",shape=box,color=red];
		3291 -> 3299;
	3292 [label="Гадаєш, що з тобою ще не покінчено?",shape=box,color=red];
		3292 -> 3300;
	3293 [label="Але думати, що твоя історія завершується так, без участі у завершальному акті? Паскудство.",shape=box,color=red];
		3293 -> 3301;
	3294 [label="Але може так болить, бо вважаєш, що десь тебе замінив «Артур 2.0»?",shape=box,color=red];
		3294 -> 3302;
	3295 [label="Але може тобі просто хочеться, щоб твої жертви мали сенс, але в дещо космічніших масштабах?",shape=box,color=red];
		3295 -> 3303;
	3296 [label="Згода.",shape=box,color=blue];
		3296 -> 3304;
	3297 [label="Частка мене й справді сподівається, що там десь є ще подібні нам. Але якщо вони всі припруться сюди? Тоді зрештою доведеться шукати більший ТЦ.",shape=box,color=blue];
		3297 -> 3305;
	3298 [label="У нас же ж буквально ситуація з божеством та чуваком, який вважає себе таким же ж.",shape=box,color=blue];
		3298 -> 3306;
	3299 [label="Та я знаю. І той день ми зустрінемо пліч-о-пліч. Це вже точно.",shape=box,color=blue];
		3299 -> 3307;
	3300 [label="Дружаньо, ні. Ти не робиш таку зброю, якщо не знаєш, де будеш її застосовувати.",shape=box,color=blue];
		3300 -> 3308;
		3300 -> 3309;
		3300 -> 3310;
	3301 [label="А, може, це частина цього всього? А якщо Байдужість причина мене такого? І я маю пройти через це?",shape=box,color=blue];
		3301 -> 3311;
	3302 [label="Дружаньо, я був готовий вийти на пенсію, перш ніж мене засмоктало це лайно. Так що це навряд.",shape=box,color=blue];
		3302 -> 3312;
	3303 [label="Може й так. А може й ні. Знаєш, скільки людських жертв насправді не значать нічого? Більшість із них.",shape=box,color=blue];
		3303 -> 3313;
	3304 [label="І якщо подібні нам заявляться сюди? Дуже сподіваюся, що зрештою не доведеться шукати більший ТЦ.",shape=box,color=blue];
		3304 -> 3314;
