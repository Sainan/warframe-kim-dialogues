digraph {
	1188 [label="ArthurRank3Convo6 begins.",color=orange];
		1188 -> 1189;
	1189 [label="Обміняймося заручницькими фактами.",shape=box,color=blue];
		1189 -> 1190;
		1189 -> 1191;
	1190 [label="ПХА-хА, що?",shape=box,color=red];
		1190 -> 1192;
	1191 [label="Минуле дивне.",shape=box,color=red];
		1191 -> 1192;
	1192 [label="Ха. Отже. Це така гра з часів служби в британській армії.",shape=box,color=blue];
		1192 -> 1193;
	1193 [label="Ти розповідаєш сороміцький факт про себе, а я про себе.",shape=box,color=blue];
		1193 -> 1194;
	1194 [label="І триматимемо їх у вигляді заручників одне одного.",shape=box,color=blue];
		1194 -> 1195;
	1195 [label="Заручницькі факти. Це «вправа на довіру». Я почну першим.",shape=box,color=blue];
		1195 -> 1196;
		1195 -> 1197;
		1195 -> 1198;
	1196 [label="Спочатку подумалося, що треба пройти курс про зав’язування вузлів… але добре.",shape=box,color=red];
		1196 -> 1202;
	1197 [label="Звичайно, чом би й ні.",shape=box,color=red];
		1197 -> 1202;
	1198 [label="Ні. Я в таке не граю.",shape=box,color=red];
		1198 -> 1199;
	1202 [label="Ось мій: у мене є іграшковий ведмедик, на ім’я Себастіан.",shape=box,color=blue];
		1202 -> 1203;
	1199 [label="Як знаєш.",shape=box,color=blue];
		1199 -> 1200;
	1203 [label="І перш ніж ти у своїй голові побачиш картинку, як я до нього притискаюся вночі — то такого нема.",shape=box,color=blue];
		1203 -> 1204;
	1200 [label="Chat ends.",color=orange];
	1204 [label="Я знайшов його під час одного із завдань у розбомбленій будівлі. Чимало років тому.",shape=box,color=blue];
		1204 -> 1205;
	1205 [label="Він на полиці сидить. І коли мені нема з ким поговорити…",shape=box,color=blue];
		1205 -> 1206;
	1206 [label="Я говорю з ним. Старий облізлий друзяка. Утримує мене від повного божевілля.",shape=box,color=blue];
		1206 -> 1201;
		1206 -> 1207;
		1206 -> 1208;
	1201 [label="ПІДСТОЛОМ",shape=box,color=red];
		1201 -> 1214;
	1207 [label="Це… до болю мило.",shape=box,color=red];
		1207 -> 1211;
	1208 [label="А можна буде якось пообіймати Себастіана?",shape=box,color=red];
		1208 -> 1210;
	1214 [label="Так, так.",shape=box,color=blue];
		1214 -> 1213;
	1211 [label="Мені здалося, що на кілька митей завітала смерть.",shape=box,color=red];
		1211 -> 1212;
	1210 [label="+20 Chemistry",color=orange];
		1210 -> 1209;
	1213 [label="Я так голосно сміюся, що аж ледь-ледь не всцюся. Ха-ха",shape=box,color=red];
		1213 -> 1215;
	1212 [label="Артуре, а в тобі чимало несподіванок.",shape=box,color=red];
		1212 -> 1217;
	1209 [label="Не бачу причин для відмови.",shape=box,color=blue];
		1209 -> 1218;
	1215 [label="Ясно. Я зрозумів.",shape=box,color=blue];
		1215 -> 1218;
	1217 [label="+20 Chemistry",color=orange];
		1217 -> 1216;
	1218 [label="Твоя черга.",shape=box,color=blue];
		1218 -> 1219;
		1218 -> 1220;
		1218 -> 1221;
		1218 -> 1222;
	1216 [label="Ха.",shape=box,color=blue];
		1216 -> 1218;
	1219 [label="У Дувірі постійно з’являлася моя дитяча спальня, бо мені хотілося десь сховатися.",shape=box,color=red];
		1219 -> 1227;
	1220 [label="Одного разу, коли Лодун відтяв мені голову, то вона так відлетіла, що втрапила аж на дерево!",shape=box,color=red];
		1220 -> 1226;
	1221 [label="Мені довелося витратити шістсот вісімдесят сім повторень циклів, щоб навчитися їздити на кайті.",shape=box,color=red];
		1221 -> 1225;
	1222 [label="Ні, відмовлюся. Але дякую за розповідь про Себастіана.",shape=box,color=red];
		1222 -> 1223;
	1227 [label="Уже й відлік загубився тим спальням, допоки з’явилося розуміння як звідти вибратися.",shape=box,color=red];
		1227 -> 1228;
	1226 [label="Ти знаєш як довго голова ще жива, як її стяли? Бо я *ЗНАЮ*. МВА-ХА-ХА.",shape=box,color=red];
		1226 -> 1228;
	1225 [label="Навіть довелося створити список з переламаними кістками. Гадаю, він і досі десь є.",shape=box,color=red];
		1225 -> 1228;
	1223 [label="Я мав здогадатися.",shape=box,color=blue];
		1223 -> 1224;
	1228 [label="Убережи мене Сол… Гадаю, що ти трохи не так сприймаєш умови гри.",shape=box,color=blue];
		1228 -> 1229;
	1224 [label="Chat ends.",color=orange];
	1229 [label="Але, ем… дякую за спробу.",shape=box,color=blue];
		1229 -> 978;
	978 [label="Chat ends.",color=orange];
}