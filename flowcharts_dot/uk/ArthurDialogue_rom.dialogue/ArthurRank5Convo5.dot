		2408 -> 2412;
		2408 -> 2413;
	2410 [label="Ніщо так не втамовує гнів, як нищення світу. І ти знаєш, що він увесь час відновлюється.",shape=box,color=red];
		2410 -> 2413;
		2410 -> 2412;
	2411 [label="Тепер. Коли я можу покинути Дувірі… знову відчувається… щось веселе. Я знову можу відшукати радість. Хоч і трохи химерну.",shape=box,color=red];
