	"Chat ends." [color=orange];
	j1569221931 [label="Check boolean ArthurConsentComplete",color=orange];
		j1569221931 -> "Chat ends." [label=true,color=green];
		j1569221931 -> j2506536842 [label=false,color=brown];
		j1569221931 -> j3663123953 [label=false,color=brown];
	j972778441 [label="Check boolean ArthurPolyamorySuccess",color=orange];
		j972778441 -> j1569221931 [label=true,color=green];
		j972778441 -> "Chat ends." [label=false,color=brown];
	j2506536842 [label="Артуре, можна на кілька слів? [Спитати про згоду на кількох партнерів]",shape=box,color=red];
		j2506536842 -> j273461538;
	j3663123953 [label="[Завершити розмову]",shape=box,color=red];
		j3663123953 -> j3652224286;
	j273461538 [label="Аякже. Щось трапилося?",shape=box,color=blue];
		j273461538 -> j1709059054;
	j3652224286 [label="Boolean ArthurConsentComplete is now true.",color=orange];
		j3652224286 -> "Chat ends.";
	j1709059054 [label="Та ні, усе більш-менш. Мені потрібно поговорити з тобою про… сподіваюся, це не буде дуже незручно для тебе.",shape=box,color=red];
		j1709059054 -> j2834063851;
	j2834063851 [label="Не хочу ставити тебе в незручне становище. Ми раніше цього не обговорювали. Тож якщо відмовиш, то це нічого. Просто хочу, щоб ти знала.",shape=box,color=red];
		j2834063851 -> j2142727170;
	j2142727170 [label="Те, що в нас є, важливе для мене. Дуже-дуже. І воно реальне. Я не хочу, щоб ти сумнівався в цьому.",shape=box,color=red];
		j2142727170 -> j2059307056;
	j2059307056 [label="Ага. Я бачу до чого йде. У тебе з’явилися почуття ще до когось?",shape=box,color=blue];
		j2059307056 -> j1725636010;
		j2059307056 -> j1284278752;
	j1725636010 [label="Так. І я знаю, що це складно зрозуміти, але мої почуття до тебе не змінилися.",shape=box,color=red];
		j1725636010 -> j742898472;
	j1284278752 [label="Так. Але знаєш, якщо подумати… то нам варто поставити крапку в стосунках. [Розірвати стосунки]",shape=box,color=red];
		j1284278752 -> j1230442744;
	j742898472 [label="Кохання моє, ти справді вважаєш, що за стільки років на службі я не бачив усіх можливих типів стосунків?",shape=box,color=blue];
		j742898472 -> j2410665885;
	j1230442744 [label="Що ж, якщо це те, чого ти дійсно прагнеш…",shape=box,color=blue];
		j1230442744 -> j3701883258;
	j2410665885 [label="Коли проводиш стільки часу поруч зі смертю, то вчишся розбиратися що є важливим в житті, а що ні.",shape=box,color=blue];
		j2410665885 -> j3238976107;
	j3701883258 [label="Boolean IsDating is now false.",color=orange];
		j3701883258 -> j913620630;
	j3238976107 [label="У такому житті ти перестаєш виводити лінії на піску. Я все розумію.",shape=box,color=blue];
		j3238976107 -> j4175740972;
	j913620630 [label="Boolean ArthurDating is now false.",color=orange];
		j913620630 -> "Chat ends.";
	j4175740972 [label="Знаєш де факти? У твоїй важливості для мене. І якщо хтось важливий для тебе ще, то вони будуть важливими й для мене.",shape=box,color=blue];
		j4175740972 -> j1462627035;
	j1462627035 [label="Лише. Не. Хтось. З «ПРОКЛЬОНУ». Ясно? Не думаю, що мені було би це прийнятно, якби твоя нова пасія була «з родини», так би мовити.",shape=box,color=blue];
		j1462627035 -> j1712504641;
	j1712504641 [label="Думки про це принесуть мені нічні жахіття.",shape=box,color=blue];
		j1712504641 -> j3689083597;
		j1712504641 -> j214294477;
	j3689083597 [label="Хах. Це точно.",shape=box,color=red];
		j3689083597 -> j4184238073;
	j214294477 [label="Якщо це слушно додати, то я справді думаю, що ви б сподобались одне одному.",shape=box,color=red];
		j214294477 -> j332941930;
	j4184238073 [label="Дякую. Я сподіваюся, що коли-небудь познайомлюся з ними. Для… звісно, з особистих причин.",shape=box,color=blue];
		j4184238073 -> j1207477009;
	j332941930 [label="Я сподіваюся, що коли-небудь познайомлюся з ними. Для… звісно, з особистих причин.",shape=box,color=blue];
		j332941930 -> j1207477009;
	j1207477009 [label="+20 Chemistry",color=orange];
		j1207477009 -> j1733330743;
	j1733330743 [label="Ти лише пильнуй там себе, коханнячко.",shape=box,color=blue];
		j1733330743 -> j3652224286;
}