	"ArthurConsent begins." [color=orange];
		"ArthurConsent begins." -> j2345715761;
	j2345715761 [label="Check boolean ArthurDating",color=orange];
		j2345715761 -> j1518184391 [label=true,color=green];
		j2345715761 -> "Chat ends." [label=false,color=brown];
	j1518184391 [label="Check /Lotus/Scripts/1999/DialogueScriptNodes.lua:IsDatingMultiple",color=orange];
		j1518184391 -> j1569221931 [label=true,color=green];
		j1518184391 -> j972778441 [label=false,color=brown];
	"Chat ends." [color=orange];
	j1569221931 [label="Check boolean ArthurConsentComplete",color=orange];
		j1569221931 -> "Chat ends." [label=true,color=green];
		j1569221931 -> j1579874378 [label=false,color=brown];
		j1569221931 -> j3663123953 [label=false,color=brown];
	j972778441 [label="Check boolean ArthurPolyamorySuccess",color=orange];
		j972778441 -> j1569221931 [label=true,color=green];
		j972778441 -> "Chat ends." [label=false,color=brown];
	j1579874378 [label="Артуре, можна на кілька слів? [Спитати про згоду на кількох партнерів]",shape=box,color=red];
		j1579874378 -> j3310752661;
	j3663123953 [label="[Завершити розмову]",shape=box,color=red];
		j3663123953 -> j3652224286;
	j3310752661 [label="Аякже. Щось трапилося?",shape=box,color=blue];
		j3310752661 -> j2740448175;
	j3652224286 [label="Boolean ArthurConsentComplete is now true.",color=orange];
		j3652224286 -> "Chat ends.";
	j2740448175 [label="Та ні, усе більш-менш. Мені потрібно поговорити з тобою про… сподіваюся, це не буде дуже незручно для тебе.",shape=box,color=red];
		j2740448175 -> j3749399125;
	j3749399125 [label="Не хочу ставити тебе в незручне становище. Ми раніше цього не обговорювали. Тож якщо відмовиш, то це нічого. Просто хочу, щоб ти знала.",shape=box,color=red];
		j3749399125 -> j3311568331;
	j3311568331 [label="Те, що в нас є, важливе для мене. Дуже-дуже. І воно реальне. Я не хочу, щоб ти сумнівався в цьому.",shape=box,color=red];
		j3311568331 -> j1680751212;
	j1680751212 [label="Ага. Я бачу до чого йде. У тебе… з’явилися почуття ще до когось, так?",shape=box,color=blue];
		j1680751212 -> j1700760728;
		j1680751212 -> j2448276905;
	j1700760728 [label="Так. І я знаю, що це складно зрозуміти, але мої почуття до тебе не змінилися.",shape=box,color=red];
		j1700760728 -> j1885784930;
	j2448276905 [label="[Розірвати стосунки] Так. Але знаєш, якщо подумати… то нам варто поставити крапку в стосунках.",shape=box,color=red];
		j2448276905 -> j1230442744;
	j1885784930 [label="Кохання моє, ти справді вважаєш, що за стільки років на службі я не бачив усіх можливих типів стосунків?",shape=box,color=blue];
		j1885784930 -> j2080734284;
	j1230442744 [label="Що ж, якщо це те, чого ти дійсно прагнеш…",shape=box,color=blue];
		j1230442744 -> j3701883258;
	j2080734284 [label="Коли проводиш стільки часу поруч зі смертю, то вчишся розбиратися що є важливим в житті, а що ні.",shape=box,color=blue];
		j2080734284 -> j2820793488;
	j3701883258 [label="Boolean IsDating is now false.",color=orange];
		j3701883258 -> j913620630;
	j2820793488 [label="Я не знаю як воно все працюватиме вкупі. Але ризикну й спробую, бо ти — важлива частинка мого життя.",shape=box,color=blue];
		j2820793488 -> j2107830190;
	j913620630 [label="Boolean ArthurDating is now false.",color=orange];
		j913620630 -> "Chat ends.";
	j2107830190 [label="Я переймаюся тобою. І якщо хтось іще тобі небайдужий чи небайдужа… то так само почуватимуся й щодо них.",shape=box,color=blue];
		j2107830190 -> j1596664321;
	j1596664321 [label="Лише. Не тут. НЕ З ТУТЕШНІМИ. Не в ТЦ. Ясно?",shape=box,color=blue];
		j1596664321 -> j171593741;
	j171593741 [label="Тут і так все доволі заплутано.",shape=box,color=blue];
		j171593741 -> j3689083597;
		j171593741 -> j214294477;
	j3689083597 [label="Хах. Це точно.",shape=box,color=red];
		j3689083597 -> j4184238073;
	j214294477 [label="Якщо це слушно додати, то я справді думаю, що ви б сподобались одне одному.",shape=box,color=red];
		j214294477 -> j332941930;
	j4184238073 [label="Дякую. Я сподіваюся, що коли-небудь познайомлюся з ними. Для… звісно, з особистих причин.",shape=box,color=blue];
		j4184238073 -> j1207477009;
	j332941930 [label="Я сподіваюся, що коли-небудь познайомлюся з ними. Для… звісно, з особистих причин.",shape=box,color=blue];
		j332941930 -> j1207477009;
	j1207477009 [label="+20 Chemistry",color=orange];
		j1207477009 -> j1733330743;
	j1733330743 [label="Ти лише пильнуй там себе, коханнячко.",shape=box,color=blue];
		j1733330743 -> j3652224286;
}