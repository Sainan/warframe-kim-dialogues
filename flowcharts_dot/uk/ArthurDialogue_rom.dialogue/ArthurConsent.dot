		3607 -> 3641 [label=false,color=brown];
	3608 [label="Chat ends.",color=orange];
	3609 [label="Check boolean ArthurConsentComplete",color=orange];
		3609 -> 3612 [label=true,color=green];
		3609 -> 3613 [label=false,color=brown];
		3609 -> 3611 [label=false,color=brown];
	3641 [label="Check boolean ArthurPolyamorySuccess",color=orange];
		3641 -> 3609 [label=true,color=green];
		3641 -> 3610 [label=false,color=brown];
	3612 [label="Chat ends.",color=orange];
	3613 [label="Артуре, можна на кілька слів? [Спитати про згоду на кількох партнерів]",shape=box,color=red];
		3613 -> 3615;
	3611 [label="[Завершити розмову]",shape=box,color=red];
		3611 -> 3614;
	3610 [label="Chat ends.",color=orange];
	3615 [label="Аякже. Щось трапилося?",shape=box,color=blue];
		3615 -> 3617;
	3614 [label="Update boolean ArthurConsentComplete",color=orange];
		3614 -> 3616;
	3617 [label="Та ні, усе більш-менш. Мені потрібно поговорити з тобою про… сподіваюся, це не буде дуже незручно для тебе.",shape=box,color=red];
		3617 -> 3618;
	3616 [label="Chat ends.",color=orange];
	3618 [label="Не хочу ставити тебе в незручне становище. Ми раніше цього не обговорювали. Тож якщо відмовиш, то це нічого. Просто хочу, щоб ти знала.",shape=box,color=red];
		3618 -> 3619;
	3619 [label="Те, що в нас є, важливе для мене. Дуже-дуже. І воно реальне. Я не хочу, щоб ти сумнівався в цьому.",shape=box,color=red];
		3619 -> 3620;
	3620 [label="Ага. Я бачу до чого йде. У тебе з’явилися почуття ще до когось?",shape=box,color=blue];
		3620 -> 3621;
		3620 -> 3622;
	3621 [label="Так. І я знаю, що це складно зрозуміти, але мої почуття до тебе не змінилися.",shape=box,color=red];
		3621 -> 3623;
	3622 [label="Так. Але знаєш, якщо подумати… то нам варто поставити крапку в стосунках. [Розірвати стосунки]",shape=box,color=red];
		3622 -> 3624;
	3623 [label="Кохання моє, ти справді вважаєш, що за стільки років на службі я не бачив усіх можливих типів стосунків?",shape=box,color=blue];
		3623 -> 3625;
	3624 [label="Що ж, якщо це те, чого ти дійсно прагнеш…",shape=box,color=blue];
		3624 -> 3626;
	3625 [label="Коли проводиш стільки часу поруч зі смертю, то вчишся розбиратися що є важливим в житті, а що ні.",shape=box,color=blue];
		3625 -> 3627;
	3626 [label="Update boolean IsDating",color=orange];
		3626 -> 3628;
	3627 [label="У такому житті ти перестаєш виводити лінії на піску. Я все розумію.",shape=box,color=blue];
		3627 -> 3629;
	3628 [label="Update boolean ArthurDating",color=orange];
		3628 -> 3630;
	3629 [label="Знаєш де факти? У твоїй важливості для мене. І якщо хтось важливий для тебе ще, то вони будуть важливими й для мене.",shape=box,color=blue];
		3629 -> 3631;
	3630 [label="Chat ends.",color=orange];
	3631 [label="Лише. Не. Хтось. З «ПРОКЛЬОНУ». Ясно? Не думаю, що мені було би це прийнятно, якби твоя нова пасія була «з родини», так би мовити.",shape=box,color=blue];
		3631 -> 3632;
	3632 [label="Думки про це принесуть мені нічні жахіття.",shape=box,color=blue];
		3632 -> 3634;
		3632 -> 3633;
	3634 [label="Хах. Це точно.",shape=box,color=red];
		3634 -> 3636;
	3633 [label="Якщо це слушно додати, то я справді думаю, що ви б сподобались одне одному.",shape=box,color=red];
		3633 -> 3635;
	3636 [label="Дякую. Я сподіваюся, що коли-небудь познайомлюся з ними. Для… звісно, з особистих причин.",shape=box,color=blue];
		3636 -> 3637;
	3635 [label="Я сподіваюся, що коли-небудь познайомлюся з ними. Для… звісно, з особистих причин.",shape=box,color=blue];
		3635 -> 3637;
	3637 [label="+20 Chemistry",color=orange];
		3637 -> 3638;
	3638 [label="Ти лише пильнуй там себе, коханнячко.",shape=box,color=blue];
		3638 -> 3639;
	3639 [label="Update boolean ArthurConsentComplete",color=orange];
		3639 -> 3640;
	3640 [label="Chat ends.",color=orange];
}