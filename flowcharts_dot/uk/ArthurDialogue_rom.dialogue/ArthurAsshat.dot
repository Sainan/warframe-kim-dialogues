	2046 [label="Update boolean ArthurNoDate",color=orange];
		2046 -> 2047;
	2050 [label="Я жив своє життя, перебуваючи однією ногою в могилі. Я завжди був живим мерцем.",shape=box,color=blue];
		2050 -> 2051;
	2047 [label="Chat ends.",color=orange];
	2051 [label="І зараз це як ніколи правдиво. Поглянь на мене. Я маю на увазі буквально — *поглянь на мене*.",shape=box,color=blue];
		2051 -> 2052;
	2052 [label="Я тепер навіть не *людина*.",shape=box,color=blue];
		2052 -> 2053;
	2053 [label="Але… ми мали нагоду пізнати одне одного ліпше. Ми зблизилися, так? Ти… смішиш мене.",shape=box,color=blue];
		2053 -> 2054;
	2054 [label="Я усміхаюся більше, аніж за всі минулі роки.",shape=box,color=blue];
		2054 -> 2055;
