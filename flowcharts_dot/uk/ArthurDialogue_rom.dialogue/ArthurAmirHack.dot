digraph {
	2929 [label="ArthurAmirHack begins.",color=orange];
		2929 -> 2930;
	2930 [label="Привітулі… Артуре… як справи?",shape=box,color=red];
		2930 -> 2927;
	2927 [label="br00dsw0rd: Га? Ох, та нормально. А в тебе?",shape=box,color=blue];
		2927 -> 2931;
		2927 -> 2932;
		2927 -> 2933;
	2931 [label="Чудово… о-от-же-е… які новини?",shape=box,color=red];
		2931 -> 2928;
	2932 [label="Ото погодка у нас, скажи?",shape=box,color=red];
		2932 -> 2934;
	2933 [label="Слухай, а що там ті місцеві спортсмени?",shape=box,color=red];
		2933 -> 2935;
	2928 [label="br00dsw0rd: Слухай, ми ж годину тому спілкувалися про…",shape=box,color=blue];
		2928 -> 2936;
	2934 [label="br00dsw0rd: Ця тема стає менш цікаво, коли воно весь час все одна…",shape=box,color=blue];
		2934 -> 2936;
	2935 [label="br00dsw0rd: Які місцеві спортс…",shape=box,color=blue];
		2935 -> 2936;
	2936 [label="br00dsw0rd: Що відбувається? Ти якось дивно поводишся.",shape=box,color=blue];
		2936 -> 2937;
		2936 -> 2938;
	2937 [label="Нічого не відбувається…",shape=box,color=red];
		2937 -> 2939;
	2938 [label="Аміру знову нудно. Подивися на своє ім’я користувача.",shape=box,color=red];
		2938 -> 2941;
	2939 [label="br00dsw0rd: Я тобі не вірю, я…",shape=box,color=blue];
		2939 -> 2940;
	2941 [label="br00dsw0rd: ПЛАЧ-МЕЧ?! ТО СЛОВО ОЗНАЧАЛО «ПАЛАШ»!",shape=box,color=blue];
		2941 -> 2942;
	2940 [label="br00dsw0rd: Зажди-зажди.",shape=box,color=blue];
		2940 -> 2941;
	2942 [label="br00dsw0rd: Я НІКОЛИ не плачу!",shape=box,color=blue];
		2942 -> 2943;
		2942 -> 2944;
		2942 -> 2945;
	2943 [label=":| Друзяко. Та позначка говорить інше.",shape=box,color=red];
		2943 -> 2946;
	2944 [label="Ага, аякже.",shape=box,color=red];
		2944 -> 2947;
	2945 [label="Ех, він просто дражниться. Ти ж знаєш, що він обожнює тебе. Сміхота.",shape=box,color=red];
		2945 -> 2947;
	2946 [label="br00dsw0rd: Гаразд. Гаразд. Ну може колись і було таке.",shape=box,color=blue];
		2946 -> 2948;
	2947 [label="br00dsw0rd: Ох.",shape=box,color=blue];
		2947 -> 2948;
	2948 [label="br00dsw0rd: Просто… нехай поміняє назад, добре? Перш ніж хтось інший побачить.",shape=box,color=blue];
		2948 -> 2950;
	2950 [label="+20 Chemistry",color=orange];
		2950 -> 2949;
	2949 [label="br00dsw0rd: Клеїти дурня — найточніше визначення діяльності того хлопа… треба якнайшвидше знайти йому більше занять…",shape=box,color=blue];
		2949 -> 241;
	241 [label="{\"Id\":241,\"Incoming\":[2949],\"Outgoing\":[2951],\"GraphPos\":[-26707,51022],\"CompletionType\":2,\"OtherDialogueInfos\":[{\"Dialogue\":\"/Lotus/Types/Gameplay/1999Wf/Dialogue/JabirDialogue_rom.dialogue\",\"Tag\":\"AmirHack2\",\"Value\":0}]}",color=orange];
		241 -> 2951;
	2951 [label="Chat ends.",color=orange];
