digraph {
	3360 [label="ArthurRank6Convo3 begins.",color=orange];
		3360 -> 3361;
	3361 [label="Уяви, піймав себе на тому, що балакаю з гітарою.",shape=box,color=blue];
		3361 -> 3362;
		3361 -> 3363;
	3362 [label="Особисто я не дуже в захваті від цього.",shape=box,color=red];
		3362 -> 3364;
	3363 [label="Ліззі? І як усе пройшло?",shape=box,color=red];
		3363 -> 3365;
	3364 [label="По правді, вона мені наче й подобається. Коли починаєш звикати… до… дивності?",shape=box,color=blue];
		3364 -> 3366;
	3365 [label="Ліпше, аніж я міг уявити. Вона мені наче й подобається.",shape=box,color=blue];
		3365 -> 3366;
	3366 [label="Хіба що тільки,",shape=box,color=blue];
		3366 -> 3367;
	3367 [label="Вони з Елеонорою завжди хихикають над жартами, які ніхто крім них не чує.",shape=box,color=blue];
		3367 -> 3368;
	3368 [label="Мені здалося, що треба піти й представитися як годиться.",shape=box,color=blue];
		3368 -> 3369;
	3369 [label="У неї чимало корисних думок та знань. І Флер нічого так. Знаєш, ота вся зграя в барі — наче ковток свіжого повітря. ",shape=box,color=blue];
		3369 -> 3370;
	3370 [label="Ну. Так би мовити.",shape=box,color=blue];
		3370 -> 3371;
		3370 -> 3372;
		3370 -> 3373;
	3371 [label="Що, набридла проклята шістка?",shape=box,color=red];
		3371 -> 3374;
	3372 [label="І що ж там за думки зі знаннями в неї?",shape=box,color=red];
		3372 -> 3375;
	3373 [label="Щиро радію, що ти починаєш заводити друзів. пхаха. ",shape=box,color=red];
		3373 -> 3376;
	3374 [label="Що?! Ні. Звісно ні.",shape=box,color=blue];
		3374 -> 3377;
	3375 [label="Неймовірні, як-от скільки разів цей рік повторювався.",shape=box,color=blue];
		3375 -> 3378;
	3376 [label="Припускаю, що просто приємно отак взяти й з кимось побалакати. З кимось, з ким пережив усякого не так багато.",shape=box,color=blue];
		3376 -> 3379;
	3377 [label="«Прокльон» — моя родина. Моя команда. Ти ж це знаєш.",shape=box,color=blue];
		3377 -> 3376;
	3378 [label="Скільки разів я забував чи не забував минулі роки. І як це вона живе… у позачассі? І чому ми ні.",shape=box,color=blue];
		3378 -> 3380;
	3379 [label="Не впевнений, чи в цьому взагалі є сенс. Я знаю їх, я довіряю їм. Просто нам ще не довелося *ковтнути лиха* разом.",shape=box,color=blue];
		3379 -> 3381;
	3380 [label="І перш ніж ти будь-що ляпнеш, зупинися. Я не хочу знати. Це не моя справа — знати таке.",shape=box,color=blue];
		3380 -> 3382;
	3381 [label="Так набагато легше підійти й посидіти з ними, хильнути чарку-другу.",shape=box,color=blue];
		3381 -> 3383;
		3381 -> 3384;
		3381 -> 3385;
	3382 [label="Гадаю, я просто хочу сказати — як би й скільки не було… Усе гаразд. Я не триматиму на тебе зла.",shape=box,color=blue];
		3382 -> 3386;
	3383 [label="У мене ніколи не було такої можливості.",shape=box,color=red];
		3383 -> 3387;
	3384 [label="Ага, я розумію.",shape=box,color=red];
		3384 -> 3388;
	3385 [label="Також допомагає, що дехто з них доросліший і має військовий досвід.",shape=box,color=red];
		3385 -> 3389;
	3386 [label="Наша ситуація? НЕНОРМАЛЬНА. Ми не задумувалися для подібного… я маю на увазі «ми — люди».",shape=box,color=blue];
		3386 -> 3390;
	3387 [label="Певно, що так.",shape=box,color=blue];
		3387 -> 3391;
	3388 [label="Немає тієї… ваги. Такого минулого. Амір сказав би «багажа».",shape=box,color=blue];
		3388 -> 3391;
	3389 [label="Соле. Та яка в біса різниця. Я взагалі спершу не знав, куди притулити тих лібертатійців. А тепер? О, я дуже радий, що вони тут.",shape=box,color=blue];
		3389 -> 3391;
	3390 [label="Для такого не пишуть посібників. Що б тобі не довелося вибирати — я вірю, що знайдуться вагомі причини так учинити.",shape=box,color=blue];
		3390 -> 3392;
	3391 [label="Але все це змушує думати.",shape=box,color=blue];
		3391 -> 3393;
		3391 -> 3394;
	3392 [label="Check boolean ArthurDating",color=orange];
		3392 -> 3396 [label=true,color=green];
		3392 -> 3395 [label=false,color=brown];
	3393 [label="Ой-йой.",shape=box,color=red];
		3393 -> 3397;
	3394 [label="Про що?",shape=box,color=red];
		3394 -> 3398;
	3396 [label="Я кохаю тебе. А якщо забуду? Якщо ти обереш інший шлях? Пусте.",shape=box,color=blue];
		3396 -> 3400;
	3395 [label="Я довіряю тобі всім своїм життям. І ніщо цього не змінить. Навіть якщо я на деякий час про це забуду.",shape=box,color=blue];
		3395 -> 3399;
	3397 [label="Ха. Вислухай мене. Бо тебе це теж стосується.",shape=box,color=blue];
		3397 -> 3401;
	3398 [label="Про тебе. ",shape=box,color=blue];
		3398 -> 3401;
	3400 [label="Перед твоєю появою тут я не вважав, що можу прийняти таке. Я був занадто наляканий утратити тебе. Утратити це.",shape=box,color=blue];
		3400 -> 3402;
	3399 [label="Перед твоєю появою тут я не вважав, що можу прийняти таке. Я був занадто наляканий втратити частинку себе.",shape=box,color=blue];
		3399 -> 3402;
	3401 [label="І цього всього… петельночасового зациклення. І моїх думок про те, скільки 1999-х років я не пам’ятаю.",shape=box,color=blue];
		3401 -> 3403;
		3401 -> 3404;
		3401 -> 3405;
	3402 [label="Я чіплявся, як відчайдушно людина чіпляється за пліт у морі. Але може я в цій петлі вже побував достатньо разів або… може це так із тобою… я не знаю.",shape=box,color=blue];
		3402 -> 3406;
	3403 [label="Що б та гітара тобі не сказала… присягаюся, то люта брехня.",shape=box,color=red];
		3403 -> 3407;
	3404 [label="У мене проблеми?",shape=box,color=red];
		3404 -> 3407;
	3405 [label="Я… не думаю, що нам варто в це занурюватися, Артуре.",shape=box,color=red];
		3405 -> 3407;
	3406 [label="Щастя, яке ти мені даєш просто зараз… цей спокій… вартує набагато більше зараз, аніж знання про те, що воно може тривати вічно.",shape=box,color=blue];
		3406 -> 3408;
	3407 [label="Та ти можеш почекати трохи, га? Ти ж знаєш, що я друкую повільніше за тебе.",shape=box,color=blue];
		3407 -> 3409;
	3408 [label="Якщо й можна навчитися чогось розумного солдатом, то це те, що все швидкоплинне.",shape=box,color=blue];
		3408 -> 3410;
	3409 [label="Усе, що я намагаюся сказати, то це…",shape=box,color=blue];
		3409 -> 3411;
	3410 [label="Ось майнула одна секунда і наступної тебе вже нема. Гадаю я просто прийняв це. Раз і навік.",shape=box,color=blue];
		3410 -> 3412;
	3411 [label="Довелося тобі чи ні змушувати мене або інших прокльонівців забути минулі наші стосунки — байдуже. Усе гаразд.",shape=box,color=blue];
		3411 -> 3413;
	3412 [label="Отже, якщо наш час разом добіг кінця, бо тобі захотілося клацнути пальцями й стерти мені пам’ять?",shape=box,color=blue];
		3412 -> 3414;
	3413 [label="Я не триматиму на тебе зла.",shape=box,color=blue];
		3413 -> 3386;
	3414 [label="Або Байдужість тебе таки піймає якось без штанів?",shape=box,color=blue];
		3414 -> 3415;
	3415 [label="Я насолоджуватимуся тими митями, які є наразі. Тут і зараз. Бо це все, що в мене є.",shape=box,color=blue];
		3415 -> 3416;
	3416 [label="І в цьому я точно можу бути впевненим.",shape=box,color=blue];
		3416 -> 3417;
		3416 -> 3418;
		3416 -> 3419;
	3417 [label="Нічого особистого. Здебільшого це відбувається тому, що я раз за разом лажаю у спробах підкотити до твоєї сестри. :Р",shape=box,color=red];
		3417 -> 3420;
	3418 [label="Дякую, Артуре… це значить для мене набагато більше, аніж можу виразити.",shape=box,color=red];
		3418 -> 3421;
	3419 [label="Якби ж мені твою розсудливість іноді. <3",shape=box,color=red];
		3419 -> 3422;
	3420 [label="Ха-ха. Дуже добре, що в тебе є чарівні супер сили, які дозволяють вибратися із ситуації, коли так ефектно розривається твоя трахея, чи не так?",shape=box,color=blue];
		3420 -> 3423;
	3421 [label="Кожні зараз і тоді я намагаюся дістати палку зі сраки й спробувати сказати щось тямке.",shape=box,color=blue];
		3421 -> 3424;
	3422 [label="Це все тому, що на фізичному рівні я не маю іншого вибору, окрім як зціпити зуби. Так воно у нас, британців. ",shape=box,color=blue];
		3422 -> 3425;
	3423 [label="Решті просто треба навчитися спілкуватися. Ще те питаннячко, скажу тобі.",shape=box,color=blue];
		3423 -> 3426;
	3424 [label="Що ж, гадаю, саме час для напоїв. Ти не проти?",shape=box,color=blue];
		3424 -> 3427;
		3424 -> 3428;
	3425 [label="Є такий старий вислів: «Зберігай спокій і продовжуй тиснути».",shape=box,color=blue];
		3425 -> 3424;
	3426 [label="Вона з кожним скиданням знижує свої стандарти чи ні?",shape=box,color=blue];
		3426 -> 3429;
	3427 [label="Може, пізніше.",shape=box,color=red];
		3427 -> 3430;
	3428 [label="Зустрінемося там. :)",shape=box,color=red];
		3428 -> 3431;
	3429 [label="Chat ends.",color=orange];
	3430 [label="Як знаєш.",shape=box,color=blue];
		3430 -> 3432;
	3431 [label="Chat ends.",color=orange];
	3432 [label="Chat ends.",color=orange];
}