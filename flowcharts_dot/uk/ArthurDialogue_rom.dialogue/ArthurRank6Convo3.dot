digraph {
	"ArthurRank6Convo3 begins." [color=orange];
		"ArthurRank6Convo3 begins." -> j1470964578;
	j1470964578 [label="Уяви, піймав себе на тому, що балакаю з гітарою.",shape=box,color=blue];
		j1470964578 -> j3756252144;
		j1470964578 -> j1226634052;
	j3756252144 [label="Особисто я не дуже в захваті від цього.",shape=box,color=red];
		j3756252144 -> j3243063519;
	j1226634052 [label="Ліззі? І як усе пройшло?",shape=box,color=red];
		j1226634052 -> j1180096727;
	j3243063519 [label="По правді, вона мені наче й подобається. Коли починаєш звикати… до… дивності?",shape=box,color=blue];
		j3243063519 -> j2853618337;
	j1180096727 [label="Ліпше, аніж я міг уявити. Вона мені наче й подобається.",shape=box,color=blue];
		j1180096727 -> j2853618337;
	j2853618337 [label="Хіба що тільки,",shape=box,color=blue];
		j2853618337 -> j2848247587;
	j2848247587 [label="Вони з Елеонорою завжди хихикають над жартами, які ніхто крім них не чує.",shape=box,color=blue];
		j2848247587 -> j10480435;
	j10480435 [label="Мені здалося, що треба піти й представитися як годиться.",shape=box,color=blue];
		j10480435 -> j2202154882;
	j2202154882 [label="У неї чимало корисних думок та знань. І Флер нічого так. Знаєш, ота вся зграя в барі — наче ковток свіжого повітря. ",shape=box,color=blue];
		j2202154882 -> j2823423772;
	j2823423772 [label="Ну. Так би мовити.",shape=box,color=blue];
		j2823423772 -> j3574665383;
		j2823423772 -> j2416090780;
		j2823423772 -> j1954079982;
	j3574665383 [label="Що, набридла проклята шістка?",shape=box,color=red];
		j3574665383 -> j31921547;
	j2416090780 [label="І що ж там за думки зі знаннями в неї?",shape=box,color=red];
		j2416090780 -> j2827017218;
	j1954079982 [label="Щиро радію, що ти починаєш заводити друзів. пхаха. ",shape=box,color=red];
		j1954079982 -> j2010312610;
	j31921547 [label="Що?! Ні. Звісно ні.",shape=box,color=blue];
		j31921547 -> j2636942207;
	j2827017218 [label="Неймовірні, як-от скільки разів цей рік повторювався.",shape=box,color=blue];
		j2827017218 -> j4244609676;
	j2010312610 [label="Припускаю, що просто приємно отак взяти й з кимось побалакати. З кимось, з ким пережив усякого не так багато.",shape=box,color=blue];
		j2010312610 -> j1805884944;
	j2636942207 [label="«Прокльон» — моя родина. Моя команда. Ти ж це знаєш.",shape=box,color=blue];
		j2636942207 -> j2010312610;
	j4244609676 [label="Скільки разів я забував чи не забував минулі роки. І як це вона живе… у позачассі? І чому ми ні.",shape=box,color=blue];
		j4244609676 -> j1554126876;
	j1805884944 [label="Не впевнений, чи в цьому взагалі є сенс. Я знаю їх, я довіряю їм. Просто нам ще не довелося *ковтнути лиха* разом.",shape=box,color=blue];
		j1805884944 -> j471483816;
	j1554126876 [label="І перш ніж ти будь-що ляпнеш, зупинися. Я не хочу знати. Це не моя справа — знати таке.",shape=box,color=blue];
		j1554126876 -> j51762600;
	j471483816 [label="Так набагато легше підійти й посидіти з ними, хильнути чарку-другу.",shape=box,color=blue];
		j471483816 -> j1153776667;
		j471483816 -> j135700445;
		j471483816 -> j1705773087;
	j51762600 [label="Гадаю, я просто хочу сказати — як би й скільки не було… Усе гаразд. Я не триматиму на тебе зла.",shape=box,color=blue];
		j51762600 -> j3625898059;
	j1153776667 [label="У мене ніколи не було такої можливості.",shape=box,color=red];
		j1153776667 -> j47970169;
	j135700445 [label="Ага, я розумію.",shape=box,color=red];
		j135700445 -> j3624679503;
	j1705773087 [label="Також допомагає, що дехто з них доросліший і має військовий досвід.",shape=box,color=red];
		j1705773087 -> j61085964;
	j3625898059 [label="Наша ситуація? НЕНОРМАЛЬНА. Ми не задумувалися для подібного… я маю на увазі «ми — люди».",shape=box,color=blue];
		j3625898059 -> j2845652691;
	j47970169 [label="Певно, що так.",shape=box,color=blue];
		j47970169 -> j4196825564;
	j3624679503 [label="Немає тієї… ваги. Такого минулого. Амір сказав би «багажа».",shape=box,color=blue];
		j3624679503 -> j4196825564;
	j61085964 [label="Соле. Та яка в біса різниця. Я взагалі спершу не знав, куди притулити тих лібертатійців. А тепер? О, я дуже радий, що вони тут.",shape=box,color=blue];
		j61085964 -> j4196825564;
	j2845652691 [label="Для такого не пишуть посібників. Що б тобі не довелося вибирати — я вірю, що знайдуться вагомі причини так учинити.",shape=box,color=blue];
		j2845652691 -> j2674809731;
	j4196825564 [label="Але все це змушує думати.",shape=box,color=blue];
		j4196825564 -> j2986658856;
		j4196825564 -> j3084301355;
	j2674809731 [label="Check boolean ArthurDating",color=orange];
		j2674809731 -> j4197395769 [label=true,color=green];
		j2674809731 -> j1428195461 [label=false,color=brown];
	j2986658856 [label="Ой-йой.",shape=box,color=red];
		j2986658856 -> j3020304603;
	j3084301355 [label="Про що?",shape=box,color=red];
		j3084301355 -> j2788925300;
	j4197395769 [label="Я кохаю тебе. А якщо забуду? Якщо ти обереш інший шлях? Пусте.",shape=box,color=blue];
		j4197395769 -> j2405452492;
	j1428195461 [label="Я довіряю тобі всім своїм життям. І ніщо цього не змінить. Навіть якщо я на деякий час про це забуду.",shape=box,color=blue];
		j1428195461 -> j1159729468;
	j3020304603 [label="Ха. Вислухай мене. Бо тебе це теж стосується.",shape=box,color=blue];
		j3020304603 -> j3005971704;
	j2788925300 [label="Про тебе. ",shape=box,color=blue];
		j2788925300 -> j3005971704;
	j2405452492 [label="Перед твоєю появою тут я не вважав, що можу прийняти таке. Я був занадто наляканий утратити тебе. Утратити це.",shape=box,color=blue];
		j2405452492 -> j1143738182;
	j1159729468 [label="Перед твоєю появою тут я не вважав, що можу прийняти таке. Я був занадто наляканий втратити частинку себе.",shape=box,color=blue];
		j1159729468 -> j1143738182;
	j3005971704 [label="І цього всього… петельночасового зациклення. І моїх думок про те, скільки 1999-х років я не пам’ятаю.",shape=box,color=blue];
		j3005971704 -> j1550822198;
		j3005971704 -> j3094573050;
		j3005971704 -> j1826817198;
	j1143738182 [label="Я чіплявся, як відчайдушно людина чіпляється за пліт у морі. Але може я в цій петлі вже побував достатньо разів або… може це так із тобою… я не знаю.",shape=box,color=blue];
		j1143738182 -> j2097939838;
	j1550822198 [label="Що б та гітара тобі не сказала… присягаюся, то люта брехня.",shape=box,color=red];
		j1550822198 -> j922697749;
	j3094573050 [label="У мене проблеми?",shape=box,color=red];
		j3094573050 -> j922697749;
	j1826817198 [label="Я… не думаю, що нам варто в це занурюватися, Артуре.",shape=box,color=red];
		j1826817198 -> j922697749;
	j2097939838 [label="Щастя, яке ти мені даєш просто зараз… цей спокій… вартує набагато більше зараз, аніж знання про те, що воно може тривати вічно.",shape=box,color=blue];
		j2097939838 -> j914853738;
	j922697749 [label="Та ти можеш почекати трохи, га? Ти ж знаєш, що я друкую повільніше за тебе.",shape=box,color=blue];
		j922697749 -> j4257260097;
	j914853738 [label="Якщо й можна навчитися чогось розумного солдатом, то це те, що все швидкоплинне.",shape=box,color=blue];
		j914853738 -> j3467601474;
	j4257260097 [label="Усе, що я намагаюся сказати, то це…",shape=box,color=blue];
		j4257260097 -> j34774437;
	j3467601474 [label="Ось майнула одна секунда і наступної тебе вже нема. Гадаю я просто прийняв це. Раз і навік.",shape=box,color=blue];
		j3467601474 -> j3403519;
	j34774437 [label="Довелося тобі чи ні змушувати мене або інших прокльонівців забути минулі наші стосунки — байдуже. Усе гаразд.",shape=box,color=blue];
		j34774437 -> j4088589892;
	j3403519 [label="Отже, якщо наш час разом добіг кінця, бо тобі захотілося клацнути пальцями й стерти мені пам’ять?",shape=box,color=blue];
		j3403519 -> j1472484420;
	j4088589892 [label="Я не триматиму на тебе зла.",shape=box,color=blue];
		j4088589892 -> j3625898059;
	j1472484420 [label="Або Байдужість тебе таки піймає якось без штанів?",shape=box,color=blue];
		j1472484420 -> j3190590015;
	j3190590015 [label="Я насолоджуватимуся тими митями, які є наразі. Тут і зараз. Бо це все, що в мене є.",shape=box,color=blue];
		j3190590015 -> j3696664267;
	j3696664267 [label="І в цьому я точно можу бути впевненим.",shape=box,color=blue];
		j3696664267 -> j3511163517;
		j3696664267 -> j2689244725;
		j3696664267 -> j2611954225;
	j3511163517 [label="Нічого особистого. Здебільшого це відбувається тому, що я раз за разом лажаю у спробах підкотити до твоєї сестри. :Р",shape=box,color=red];
		j3511163517 -> j2311325419;
	j2689244725 [label="Дякую, Артуре… це значить для мене набагато більше, аніж можу виразити.",shape=box,color=red];
		j2689244725 -> j255870345;
	j2611954225 [label="Якби ж мені твою розсудливість іноді. <3",shape=box,color=red];
		j2611954225 -> j14535261;
	j2311325419 [label="Ха-ха. Дуже добре, що в тебе є чарівні супер сили, які дозволяють вибратися із ситуації, коли так ефектно розривається твоя трахея, чи не так?",shape=box,color=blue];
		j2311325419 -> j1616041832;
	j255870345 [label="Кожні зараз і тоді я намагаюся дістати палку зі сраки й спробувати сказати щось тямке.",shape=box,color=blue];
		j255870345 -> j31167045;
	j14535261 [label="Це все тому, що на фізичному рівні я не маю іншого вибору, окрім як зціпити зуби. Так воно у нас, британців. ",shape=box,color=blue];
		j14535261 -> j921966276;
	j1616041832 [label="Решті просто треба навчитися спілкуватися. Ще те питаннячко, скажу тобі.",shape=box,color=blue];
		j1616041832 -> j1939506288;
	j31167045 [label="Що ж, гадаю, саме час для напоїв. Ти не проти?",shape=box,color=blue];
		j31167045 -> j652651589;
		j31167045 -> j2681838384;
	j921966276 [label="Є такий старий вислів: «Зберігай спокій і продовжуй тиснути».",shape=box,color=blue];
		j921966276 -> j31167045;
	j1939506288 [label="Вона з кожним скиданням знижує свої стандарти чи ні?",shape=box,color=blue];
		j1939506288 -> "Chat ends.";
	j652651589 [label="Може, пізніше.",shape=box,color=red];
		j652651589 -> j1082595733;
	j2681838384 [label="Зустрінемося там. :)",shape=box,color=red];
		j2681838384 -> "Chat ends.";
	"Chat ends." [color=orange];
	j1082595733 [label="Як знаєш.",shape=box,color=blue];
		j1082595733 -> "Chat ends.";
}