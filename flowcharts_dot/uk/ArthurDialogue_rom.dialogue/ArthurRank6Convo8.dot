digraph {
	"ArthurRank6Convo8 begins." [color=orange];
		"ArthurRank6Convo8 begins." -> j594673892;
	j594673892 [label="Знаєш, уранці мені дещо спало на думку, ледь не помер від сміху.",shape=box,color=blue];
		j594673892 -> j2131122546;
		j594673892 -> j1684410796;
	j2131122546 [label="Ану розповідай.",shape=box,color=red];
		j2131122546 -> j1327301098;
	j1684410796 [label="Татишо? І що?",shape=box,color=red];
		j1684410796 -> j1327301098;
	j1327301098 [label="Водяник гадки не має як працює Перенесення. ",shape=box,color=blue];
		j1327301098 -> j1875325655;
	j1875325655 [label="Ти як Кент Кларке і Суперман. Він ніколи не бачив двох твоїх ворфреймів в одному місці.",shape=box,color=blue];
		j1875325655 -> j1186865192;
	j1186865192 [label="У його голові… армія психопатичних супервояків наводить жах разом із прокльонівцями!",shape=box,color=blue];
		j1186865192 -> j869112264;
		j1186865192 -> j1227532772;
	j869112264 [label="Те, чого він не знає, *може* йому зашкодити. Правда ж? <RETRO_EMOJI_COOLARMSUP>",shape=box,color=red];
		j869112264 -> j491012495;
	j1227532772 [label="ПХАХА!!! Ніколи таке в голову не приходило.",shape=box,color=red];
		j1227532772 -> j1958705413;
	j491012495 [label="Саме так. І я не збираюся виправляти його думки.",shape=box,color=blue];
		j491012495 -> j2319005853;
	j1958705413 [label="Я не збираюся виправляти його помилкові думки. Але навіть уявити не можу те, що відбувається в його довбешці.",shape=box,color=blue];
		j1958705413 -> j2319005853;
	j2319005853 [label="Тоді його параноя стосовно нас абсолютно не дивна. Ха! Майже шкода того дрібного виродка.",shape=box,color=blue];
		j2319005853 -> j3220672033;
	j3220672033 [label="Майже.",shape=box,color=blue];
		j3220672033 -> "Chat ends.";
	"Chat ends." [color=orange];
}