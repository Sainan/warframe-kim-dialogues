digraph {
	3541 [label="ArthurRank6Convo8 begins.",color=orange];
		3541 -> 3542;
	3542 [label="Знаєш, уранці мені дещо спало на думку, ледь не помер від сміху.",shape=box,color=blue];
		3542 -> 3543;
		3542 -> 3544;
	3543 [label="Ану розповідай.",shape=box,color=red];
		3543 -> 3545;
	3544 [label="Татишо? І що?",shape=box,color=red];
		3544 -> 3545;
	3545 [label="Водяник гадки не має як працює Перенесення. ",shape=box,color=blue];
		3545 -> 3546;
	3546 [label="Ти як Кент Кларке і Суперман. Він ніколи не бачив двох твоїх ворфреймів в одному місці.",shape=box,color=blue];
		3546 -> 3547;
	3547 [label="У його голові… армія психопатичних супервояків наводить жах разом із прокльонівцями!",shape=box,color=blue];
		3547 -> 3548;
		3547 -> 3549;
	3548 [label="Те, чого він не знає, *може* йому зашкодити. Правда ж? <RETRO_EMOJI_COOLARMSUP>",shape=box,color=red];
		3548 -> 3550;
	3549 [label="ПХАХА!!! Ніколи таке в голову не приходило.",shape=box,color=red];
		3549 -> 3551;
	3550 [label="Саме так. І я не збираюся виправляти його думки.",shape=box,color=blue];
		3550 -> 3552;
	3551 [label="Я не збираюся виправляти його помилкові думки. Але навіть уявити не можу те, що відбувається в його довбешці.",shape=box,color=blue];
		3551 -> 3552;
	3552 [label="Тоді його параноя стосовно нас абсолютно не дивна. Ха! Майже шкода того дрібного виродка.",shape=box,color=blue];
		3552 -> 3553;
	3553 [label="Майже.",shape=box,color=blue];
		3553 -> 3554;
