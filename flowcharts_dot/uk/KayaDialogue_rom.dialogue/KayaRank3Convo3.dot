		j2695138437 -> j3874357939;
	j2848408446 [label="Що б не змусило тебе стати такою, це руйнує твою можливість бути справді щасливою.",shape=box,color=red];
		j2848408446 -> j510495783;
	j3874357939 [label="Вперед. Чим швидше ти підеш, тим менше мені доведеться терпіти таке твоє ставлення.",shape=box,color=red];
		j3874357939 -> j3108157963;
	j510495783 [label="Ти не можеш змусити мене ненавидіти тебе. Ти, звичайно, можеш мене подратувати, але це не ненависть.",shape=box,color=red];
		j510495783 -> j2899690556;
		j510495783 -> j226068047;
	j3108157963 [label="Рада, що ми розуміємося.",shape=box,color=blue];
		j3108157963 -> j1173661291;
	j2899690556 [label="Якщо тобі легше думати, що ти використовуєш нас, то я не проти.",shape=box,color=red];
