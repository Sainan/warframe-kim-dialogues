		j1173661291 -> j3588492270;
	j359289187 [label="Коли ти знайдеш відповіді, а це неодмінно станеться, ми все ще будемо тут.",shape=box,color=red];
		j359289187 -> j1922685852;
	j3551873940 [label="Я просто сподіваюся, що ти скоро зрозумієш, що ми не намагаємося тобі нашкодити.",shape=box,color=red];
		j3551873940 -> j4000378445;
