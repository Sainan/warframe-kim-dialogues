		268 -> 273;
	269 [label="Матінко. Моя. Ти серйозно думаєш, що я не зможу спекти торт?",shape=box,color=blue];
		269 -> 274;
	270 [label="Ти вигадуєш речі, щоб виплеснути свій гнів. Навіщо?",shape=box,color=red];
		270 -> 275;
	271 [label="Ти намагаєшся мене образити?",shape=box,color=red];
		271 -> 275;
	272 [label="Тож я іноді слухаю її передачі. Думаю, ми б порозумілися.",shape=box,color=blue];
		272 -> 276;
	273 [label="Якби не цей ідіотський інтернет. ",shape=box,color=blue];
		273 -> 277;
		273 -> 278;
