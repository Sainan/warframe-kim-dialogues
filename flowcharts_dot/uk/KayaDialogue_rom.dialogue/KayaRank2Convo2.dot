		254 -> 257;
	255 [label="Ти, мабуть, була відмінницею.",shape=box,color=red];
		255 -> 258;
	256 [label="Мені не потрібно бути скромною. У мене була найвища оцінка за всю історію навчання в школі, а на першому курсі університету я мала найкращу успішність за останні сто років.",shape=box,color=blue];
		256 -> 259;
		256 -> 260;
	257 [label="Тобі відомо про Нору Ніч?",shape=box,color=blue];
		257 -> 261;
		257 -> 262;
	258 [label="У мене була найвища оцінка за всю історію навчання в школі, а на першому курсі університету я мала найкращу успішність за останні сто років.",shape=box,color=blue];
		258 -> 263;
	259 [label="Але це не означає, що ти можеш спекти торт. Хіба що ти вчилася пекти?",shape=box,color=red];
		259 -> 264;
	260 [label="Але не вистачило розуму, щоб не прийняти сироватку Ентраті, та?",shape=box,color=red];
		260 -> 265;
	261 [label="Я думаю, що так, але їй точно відомо про мене.",shape=box,color=red];
		261 -> 266;
	262 [label="Ого, так. Вона з мого часу.",shape=box,color=red];
		262 -> 266;
	263 [label="Я була не просто відмінницею. Університети самі кликали мене до себе. Мій перший рік був би ідеальним…",shape=box,color=blue];
		263 -> 267;
		263 -> 268;
	264 [label="Update boolean KayaCake",color=orange];
		264 -> 269;
	265 [label="ЛОЛ? А хто це обізвався? Часом не підлабуза Ентраті? Так, я чула, що всі говорили про тебе.",shape=box,color=blue];
		265 -> 270;
		265 -> 271;
	266 [label="М-м-м, звичайно. Ну, я змогла створити формулу для часового перехоплення, яке може вловлювати звукові хвилі! ",shape=box,color=blue];
		266 -> 272;
	267 [label="Якби не… все це?",shape=box,color=red];
