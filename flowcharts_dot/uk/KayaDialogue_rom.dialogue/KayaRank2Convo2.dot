		274 -> 279;
	275 [label="Знаєш, популярність — це ще не все. Що робити, якщо всі хочуть бачити, як ти зазнаєш невдачі? Коли ти на вершині, то одного разу всі захочуть тебе звідти збити. ",shape=box,color=blue];
		275 -> 280;
		275 -> 281;
	276 [label="Отже, спочатку я можу поєднати свої теорії та, можливо, спробувати перехопити форму матерії, неживу. з міркувань безпеки.",shape=box,color=blue];
