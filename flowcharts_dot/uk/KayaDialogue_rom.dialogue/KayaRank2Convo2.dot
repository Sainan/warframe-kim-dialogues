digraph {
	"KayaRank2Convo2 begins." [color=orange];
		"KayaRank2Convo2 begins." -> j2530070512;
	j2530070512 [label="Вітаю. Можеш дещо для мене перевірити? ",shape=box,color=blue];
		j2530070512 -> j3943040573;
	j3943040573 [label="Ключем до твоєї здібності подорожувати в часі є суміш певної частки техноциту з Порожнечею?",shape=box,color=blue];
		j3943040573 -> j2655535320;
		j3943040573 -> j947326443;
	j2655535320 [label="Суміш? Ми печемо торт?",shape=box,color=red];
		j2655535320 -> j1184847098;
	j947326443 [label="Отже, твоє навчання просувається?",shape=box,color=red];
		j947326443 -> j1070574311;
	j1184847098 [label="Ніколи не пекла, але впевнена, що зроблю смачний.",shape=box,color=blue];
		j1184847098 -> j3162409841;
		j1184847098 -> j2863850417;
	j1070574311 [label="Супер швидко. Я насправді дуже близька. Супер близька.",shape=box,color=blue];
		j1070574311 -> j1423504007;
		j1070574311 -> j2792291403;
	j3162409841 [label="Звідки знаєш?",shape=box,color=red];
		j3162409841 -> j3772880724;
	j2863850417 [label="Ну ти й скромна, Ново.",shape=box,color=red];
		j2863850417 -> j3772880724;
	j1423504007 [label="Як ти можеш бути впевнена?",shape=box,color=red];
		j1423504007 -> j4008213849;
	j2792291403 [label="Ти, мабуть, була відмінницею.",shape=box,color=red];
		j2792291403 -> j105019763;
	j3772880724 [label="Мені не потрібно бути скромною. У мене була найвища оцінка за всю історію навчання в школі, а на першому курсі університету я мала найкращу успішність за останні сто років.",shape=box,color=blue];
		j3772880724 -> j2786760481;
		j3772880724 -> j2524282837;
	j4008213849 [label="Тобі відомо про Нору Ніч?",shape=box,color=blue];
		j4008213849 -> j3639307900;
		j4008213849 -> j3175225361;
	j105019763 [label="У мене була найвища оцінка за всю історію навчання в школі, а на першому курсі університету я мала найкращу успішність за останні сто років.",shape=box,color=blue];
		j105019763 -> j1968173885;
	j2786760481 [label="Але це не означає, що ти можеш спекти торт. Хіба що ти вчилася пекти?",shape=box,color=red];
		j2786760481 -> j201116109;
	j2524282837 [label="Але не вистачило розуму, щоб не прийняти сироватку Ентраті, та?",shape=box,color=red];
		j2524282837 -> j3598632417;
	j3639307900 [label="Я думаю, що так, але їй точно відомо про мене.",shape=box,color=red];
		j3639307900 -> j390473827;
	j3175225361 [label="Ого, так. Вона з мого часу.",shape=box,color=red];
		j3175225361 -> j390473827;
	j1968173885 [label="Я була не просто відмінницею. Університети самі кликали мене до себе. Мій перший рік був би ідеальним…",shape=box,color=blue];
		j1968173885 -> j2958516439;
		j1968173885 -> j258608250;
	j201116109 [label="Boolean KayaCake is now true.",color=orange];
		j201116109 -> j894170036;
	j3598632417 [label="ЛОЛ? А хто це обізвався? Часом не підлабуза Ентраті? Так, я чула, що всі говорили про тебе.",shape=box,color=blue];
		j3598632417 -> j1674343367;
		j3598632417 -> j2826505254;
	j390473827 [label="М-м-м, звичайно. Ну, я змогла створити формулу для часового перехоплення, яке може вловлювати звукові хвилі! ",shape=box,color=blue];
		j390473827 -> j1489372459;
	j2958516439 [label="Якби не… все це?",shape=box,color=red];
		j2958516439 -> j1099217208;
	j258608250 [label="Якби не… Ентраті?",shape=box,color=red];
		j258608250 -> j1099217208;
	j894170036 [label="Матінко. Моя. Ти серйозно думаєш, що я не зможу спекти торт?",shape=box,color=blue];
		j894170036 -> j2635982340;
	j1674343367 [label="Ти вигадуєш речі, щоб виплеснути свій гнів. Навіщо?",shape=box,color=red];
		j1674343367 -> j2073197003;
	j2826505254 [label="Ти намагаєшся мене образити?",shape=box,color=red];
		j2826505254 -> j2073197003;
	j1489372459 [label="Тож я іноді слухаю її передачі. Думаю, ми б порозумілися.",shape=box,color=blue];
		j1489372459 -> j1010723142;
	j1099217208 [label="Якби не цей ідіотський інтернет. ",shape=box,color=blue];
		j1099217208 -> j4044515995;
		j1099217208 -> j831921211;
	j2635982340 [label="Достатньо, щоб відвернути увагу. Почекай.",shape=box,color=blue];
		j2635982340 -> j2906669224;
	j2073197003 [label="Знаєш, популярність — це ще не все. Що робити, якщо всі хочуть бачити, як ти зазнаєш невдачі? Коли ти на вершині, то одного разу всі захочуть тебе звідти збити. ",shape=box,color=blue];
		j2073197003 -> j466102663;
		j2073197003 -> j1904300828;
	j1010723142 [label="Отже, спочатку я можу поєднати свої теорії та, можливо, спробувати перехопити форму матерії, неживу. з міркувань безпеки.",shape=box,color=blue];
		j1010723142 -> j1671726446;
	j4044515995 [label="Інтернет зрештою зникне, не хвилюйся.",shape=box,color=red];
		j4044515995 -> j1503162850;
	j831921211 [label="Отже, в університеті у тебе не склалося через… інтернет.",shape=box,color=red];
		j831921211 -> j896172925;
	j2906669224 [label="+20 Chemistry",color=orange];
		j2906669224 -> "Chat ends. Next chat will be KayaRank2Convo3.";
	j466102663 [label="Це тобі не школа. ",shape=box,color=red];
		j466102663 -> j2176659449;
	j1904300828 [label="Ми не такі, Ново, у нас тут купа справжнього лайна, яке треба розгрібати.",shape=box,color=red];
		j1904300828 -> j2176659449;
	j1671726446 [label="У певному сенсі від тебе залишилися власна кротовина для роботи, тож ти, так би мовити, мій партнер у навчанні. Частина заслуги твоя.",shape=box,color=blue];
		j1671726446 -> j675752113;
		j1671726446 -> j2395668613;
	j1503162850 [label="Можливо, це я допоможу йому зникнути!",shape=box,color=blue];
		j1503162850 -> j342556150;
	j896172925 [label="Я буквально щойно це сказала.",shape=box,color=blue];
		j896172925 -> j2782503493;
	"Chat ends. Next chat will be KayaRank2Convo3." [color=orange];
	j2176659449 [label="Довіра людям завдасть тобі шкоди. А довіра людям з інтернету? Зруйнує твоє життя. ",shape=box,color=blue];
		j2176659449 -> j2906669224;
	j675752113 [label="12 балів для нас обох!",shape=box,color=red];
		j675752113 -> j975320842;
	j2395668613 [label="Приємно, що можу допомогти.",shape=box,color=red];
		j2395668613 -> j533622346;
	j342556150 [label="Лишенько, це справді я?",shape=box,color=blue];
		j342556150 -> j2317949132;
		j342556150 -> j3638707716;
	j2782503493 [label="Я швидко розповім тобі, бо ти, можливо, ще не знаєш, як тут все працює.",shape=box,color=blue];
		j2782503493 -> j1708269584;
	j975320842 [label="Але ти впевнена, що це не моє ввімкнене радіо?",shape=box,color=red];
		j975320842 -> j2258755891;
	j533622346 [label="Навіть якщо я ледве встигаю розуміти.",shape=box,color=red];
		j533622346 -> j4197981490;
	j2317949132 [label="Вибач, але я справді не знаю. ",shape=box,color=red];
		j2317949132 -> j406400858;
	j3638707716 [label="О так, а хто ще. Це всі знають, що Нова знищила інтернет. Ось чому я тут, щоби зупинити тебе.",shape=box,color=red];
		j3638707716 -> j3123048484;
	j1708269584 [label="Але люди БРЕШУТЬ в інтернеті. Вони можуть прикинутися твоїм другом і ШВИДКО поширювати чутки. ",shape=box,color=blue];
		j1708269584 -> j3594247087;
	j2258755891 [label="100 % впевнена. ",shape=box,color=blue];
		j2258755891 -> j2906669224;
	j4197981490 [label="Щось та й розумієш.",shape=box,color=blue];
		j4197981490 -> j2906669224;
	j406400858 [label="Фігово. Ну й нехай.",shape=box,color=blue];
		j406400858 -> "Chat ends. Next chat will be KayaRank2Convo3.";
	j3123048484 [label="Ха. Якби ж то.",shape=box,color=blue];
		j3123048484 -> j1911205825;
	j3594247087 [label="І щойно це станеться, забудь про своє життя. Друзів. Про все. ",shape=box,color=blue];
		j3594247087 -> j3468622054;
	j1911205825 [label="+20 Chemistry",color=orange];
		j1911205825 -> j2684058793;
	j3468622054 [label="Хоча що з того, ти все одно не зрозумієш. Просто залиш мене в спокої. ",shape=box,color=blue];
		j3468622054 -> j3049501756;
		j3468622054 -> j1308779263;
	j2684058793 [label="Як я наважилася ЩОСЬ зробити, то ніхто не може мене зупинити.",shape=box,color=blue];
		j2684058793 -> "Chat ends. Next chat will be KayaRank2Convo3.";
	j3049501756 [label="Як забажаєш.",shape=box,color=red];
		j3049501756 -> j4238923;
	j1308779263 [label="Мені важко зрозуміти, чи засмучую я тебе, і мені шкода через те, що з тобою сталося, але…",shape=box,color=red];
		j1308779263 -> j1536773589;
	j4238923 [label="ОК.",shape=box,color=blue];
		j4238923 -> "Chat ends. Next chat will be KayaRank2Convo3.";
