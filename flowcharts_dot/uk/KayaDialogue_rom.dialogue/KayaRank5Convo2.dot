digraph {
	819 [label="KayaRank5Convo2 begins.",color=orange];
		819 -> 820;
	820 [label="А що, як цього разу я запитаю *тебе* про подорожі в часі?",shape=box,color=red];
		820 -> 821;
	821 [label="Та ні. Поговорімо про щось інше! Добре?",shape=box,color=blue];
		821 -> 822;
	822 [label="Check boolean KayaPromiseRegret",color=orange];
		822 -> 824 [label=true,color=green];
		822 -> 825 [label=false,color=brown];
		822 -> 823 [label=false,color=brown];
	824 [label="Наприклад, про що я найбільше шкодую?",shape=box,color=red];
		824 -> 827;
	825 [label="Про що? Ти обирай.",shape=box,color=red];
		825 -> 828;
	823 [label="Як щодо… Калимос?",shape=box,color=red];
		823 -> 826;
	827 [label="Гм, добре, так, звичайно. Про що? ",shape=box,color=blue];
		827 -> 832;
		827 -> 833;
		827 -> 834;
	828 [label="Ем-м-м, давай… про мого першого домашнього улюбленця? ",shape=box,color=blue];
		828 -> 835;
	826 [label="Ага, вона гарна, хоча мені більше подобаються собаки. У мене був собака в дитинстві. Я мрію побачити його ще раз.",shape=box,color=blue];
		826 -> 829;
		826 -> 830;
		826 -> 831;
	832 [label="Треба було вимагати від Альбрехта більшого.",shape=box,color=red];
		832 -> 838;
	833 [label="Треба було зупинити Балласа раніше.",shape=box,color=red];
		833 -> 839;
	834 [label="Треба було не здаватися.",shape=box,color=red];
		834 -> 840;
	835 [label="Хоча зазвичай це одне з тих питань хакерів в інтернеті, тому не кажи нікому.",shape=box,color=blue];
		835 -> 841;
	829 [label="Мої співчуття. Найкраще закінчити тут. [Кінець]",shape=box,color=red];
		829 -> 836;
	830 [label="Мені прикро, розкажи про нього.",shape=box,color=red];
		830 -> 837;
	831 [label="Мені теж довелося втратити улюбленця. Як звали твого?",shape=box,color=red];
		831 -> 837;
	838 [label="Ніби навіть після всього цього, це з мого дозволу він втік.",shape=box,color=red];
		838 -> 844;
	839 [label="Я не знаю, як це могло б змінити все.",shape=box,color=red];
		839 -> 845;
	840 [label="Неважливо, що б подумали інші. У мене був час, коли ніхто не ненавидів мене більше, ніж я себе.",shape=box,color=red];
		840 -> 846;
	841 [label="Його звали Зило. Він був як твої куброу.",shape=box,color=blue];
		841 -> 847;
	836 [label="+20 Chemistry",color=orange];
		836 -> 842;
	837 [label="Насправді це якось несправедливо. Ентраті може подорожувати в часі зі своєю дивною кицькою?",shape=box,color=blue];
		837 -> 843;
	844 [label="Я знаю, що він думає, що навчає мене чогось, але цей вилупок навіть не усвідомлює, що це зі мною робить.",shape=box,color=red];
		844 -> 849;
	845 [label="Але я знаю, що кожна хвилина моїх вагань вартувала комусь болю.",shape=box,color=red];
		845 -> 850;
	846 [label="Тоді мені навіть не вдавалося померти. А цього дуже хотілося. ",shape=box,color=red];
		846 -> 851;
	847 [label="ВЕЛИЧЕЗНИЙ, найбільший собака, якого тільки можна уявити. Б’юся об заклад, він міг би перекусити пана Волкова навпіл.",shape=box,color=blue];
		847 -> 852;
		847 -> 853;
	842 [label="Chat ends. Next chat will be KayaRank5Convo3.",color=orange];
	843 [label="Якби поруч зі мною був Зило… ця подорож була б набагато легшою.",shape=box,color=blue];
		843 -> 848;
	849 [label="І не ТІЛЬКИ зі мною. Всіма нами. Лойдом, Ґомайтру… це огидно. Не знаю, чи зможу я стриматися, якщо побачу його знову.",shape=box,color=red];
		849 -> 851;
	850 [label="Баллас — це втілення всього, чого я боюся. Він є найбільшим злом у житті. ",shape=box,color=red];
		850 -> 851;
	851 [label="Коли ти це так кажеш… мені здається, що життя та люди іноді просто паскудні, так?",shape=box,color=blue];
		851 -> 855;
	852 [label="Там, звідки я, у нас усе ще водяться великі куброу! ",shape=box,color=red];
		852 -> 856;
	853 [label="Гм, навіть не знаю, пан Волков доволі міцний.",shape=box,color=red];
		853 -> 857;
	848 [label="Знаєш, Зило був першою живою істотою, яка побачила, як я плачу. ",shape=box,color=blue];
		848 -> 854;
	855 [label="Але іноді все здається чудовим.",shape=box,color=blue];
		855 -> 859;
	856 [label="Боже мій… ще одна причина для мене, щоб ДІСТАТИСЯ ТУДИ. Це чудово!",shape=box,color=blue];
		856 -> 860;
	857 [label="Може, ти маєш рацію… але все одно, це був великий страшний Зило. І він люто захищав мене.",shape=box,color=blue];
		857 -> 848;
	854 [label="Мені було десь п’ять років, і скільки я себе пам’ятаю, я відмовлялася плакати.",shape=box,color=blue];
		854 -> 858;
	859 [label="Гадаю, ми не можемо визначати себе тим, про що найбільше шкодуємо. Я відчуваю, що завдяки тобі я подолала свої жалі.",shape=box,color=blue];
		859 -> 862;
	860 [label="Мій Зило завжди люто захищав мене. ",shape=box,color=blue];
		860 -> 848;
	858 [label="Я повернулася додому після свого першого дня в першому класі, і Зило був там.",shape=box,color=blue];
		858 -> 861;
	862 [label="Але я б не змінила того, що це сталося. ",shape=box,color=blue];
		862 -> 865;
	861 [label="І він пішов за мною до моєї кімнати й охороняв двері, поки я плакала.",shape=box,color=blue];
		861 -> 863;
		861 -> 864;
	865 [label="Тому що я не ненавиджу це. Нова? Вона ж найкрутіша у світі.",shape=box,color=blue];
		865 -> 868;
	863 [label="Чому ти була засмучена?",shape=box,color=red];
		863 -> 866;
	864 [label="І ти це пам’ятаєш?",shape=box,color=red];
		864 -> 867;
	868 [label="Тож ти б нічого не змінила?",shape=box,color=red];
		868 -> 871;
	866 [label="Хтось назвав мене товстою.",shape=box,color=blue];
		866 -> 869;
	867 [label="Як таке можна забути?!",shape=box,color=blue];
		867 -> 870;
	871 [label="Нічогісінько. І я сподіваюся, що ти теж цього не зробиш.",shape=box,color=blue];
		871 -> 874;
	869 [label="А це було однією з тих речей, які робили дітей непопулярними, коли я росла.",shape=box,color=blue];
		869 -> 872;
		869 -> 873;
	870 [label="Хтось назвав мене товстою.",shape=box,color=blue];
		870 -> 869;
	874 [label="+20 Chemistry",color=orange];
		874 -> 877;
	872 [label="Діти можуть бути дуже жорстокими.",shape=box,color=red];
		872 -> 875;
	873 [label="Чи так важливо було бути популярною?",shape=box,color=red];
		873 -> 876;
	877 [label="Chat ends. Next chat will be KayaRank5Convo3.",color=orange];
	875 [label="Усі жорстокі.",shape=box,color=blue];
		875 -> 878;
	876 [label="Було… поки все це не сталося. Після всього цього лайна, що сталося, я відчуваю, що стала кращою людиною, ніби тепер я та, ким дійсно хочу бути.",shape=box,color=blue];
		876 -> 879;
	878 [label="Усі хочуть бути крутою дитиною.",shape=box,color=blue];
		878 -> 880;
	879 [label="Мене більше не хвилює те, що про мене думають інші. Я просто… нарешті живу.",shape=box,color=blue];
		879 -> 881;
	880 [label="Але тепер я зрозуміла, що набагато крутіше не заморочуватися про це. Тому в тобі стільки крутості.",shape=box,color=blue];
		880 -> 882;
	881 [label="+20 Chemistry",color=orange];
		881 -> 883;
	882 [label="Після всього цього лайна, що сталося, я відчуваю, що стала кращою людиною, ніби тепер я та, ким дійсно хочу бути.",shape=box,color=blue];
		882 -> 884;
