digraph {
	"KayaRank5Convo2 begins." [color=orange];
		"KayaRank5Convo2 begins." -> j1923726018;
	j1923726018 [label="А що, як цього разу я запитаю *тебе* про подорожі в часі?",shape=box,color=red];
		j1923726018 -> j293619741;
	j293619741 [label="Та ні. Поговорімо про щось інше! Добре?",shape=box,color=blue];
		j293619741 -> j3602582192;
	j3602582192 [label="Check boolean KayaPromiseRegret",color=orange];
		j3602582192 -> j3118080694 [label=true,color=green];
		j3602582192 -> j3608618176 [label=false,color=brown];
		j3602582192 -> j3609676123 [label=false,color=brown];
	j3118080694 [label="Наприклад, про що я найбільше шкодую?",shape=box,color=red];
		j3118080694 -> j3876841040;
	j3608618176 [label="Про що? Ти обирай.",shape=box,color=red];
		j3608618176 -> j3011818389;
	j3609676123 [label="Як щодо… Калимос?",shape=box,color=red];
		j3609676123 -> j2675992346;
	j3876841040 [label="Гм, добре, так, звичайно. Про що? ",shape=box,color=blue];
		j3876841040 -> j3225487397;
		j3876841040 -> j366762021;
		j3876841040 -> j2943329565;
	j3011818389 [label="Ем-м-м, давай… про мого першого домашнього улюбленця? ",shape=box,color=blue];
		j3011818389 -> j3773355975;
	j2675992346 [label="Ага, вона гарна, хоча мені більше подобаються собаки. У мене був собака в дитинстві. Я мрію побачити його ще раз.",shape=box,color=blue];
		j2675992346 -> j3682648595;
		j2675992346 -> j3843101260;
		j2675992346 -> j3920608623;
	j3225487397 [label="Треба було вимагати від Альбрехта більшого.",shape=box,color=red];
		j3225487397 -> j3510147072;
	j366762021 [label="Треба було зупинити Балласа раніше.",shape=box,color=red];
		j366762021 -> j2688331471;
	j2943329565 [label="Треба було не здаватися.",shape=box,color=red];
		j2943329565 -> j1508537090;
	j3773355975 [label="Хоча зазвичай це одне з тих питань хакерів в інтернеті, тому не кажи нікому.",shape=box,color=blue];
		j3773355975 -> j3798885043;
	j3682648595 [label="Мої співчуття. Найкраще закінчити тут. [Кінець]",shape=box,color=red];
		j3682648595 -> j3219460250;
	j3843101260 [label="Мені прикро, розкажи про нього.",shape=box,color=red];
		j3843101260 -> j4196467393;
	j3920608623 [label="Мені теж довелося втратити улюбленця. Як звали твого?",shape=box,color=red];
		j3920608623 -> j4196467393;
	j3510147072 [label="Ніби навіть після всього цього, це з мого дозволу він втік.",shape=box,color=red];
		j3510147072 -> j2117982570;
	j2688331471 [label="Я не знаю, як це могло б змінити все.",shape=box,color=red];
		j2688331471 -> j3435785002;
	j1508537090 [label="Неважливо, що б подумали інші. У мене був час, коли ніхто не ненавидів мене більше, ніж я себе.",shape=box,color=red];
		j1508537090 -> j2055219231;
	j3798885043 [label="Його звали Зило. Він був як твої куброу.",shape=box,color=blue];
		j3798885043 -> j1465788342;
	j3219460250 [label="+20 Chemistry",color=orange];
		j3219460250 -> "Chat ends. Next chat will be KayaRank5Convo3.";
	j4196467393 [label="Насправді це якось несправедливо. Ентраті може подорожувати в часі зі своєю дивною кицькою?",shape=box,color=blue];
		j4196467393 -> j2045413895;
	j2117982570 [label="Я знаю, що він думає, що навчає мене чогось, але цей вилупок навіть не усвідомлює, що це зі мною робить.",shape=box,color=red];
		j2117982570 -> j1829593569;
	j3435785002 [label="Але я знаю, що кожна хвилина моїх вагань вартувала комусь болю.",shape=box,color=red];
		j3435785002 -> j2316249999;
	j2055219231 [label="Тоді мені навіть не вдавалося померти. А цього дуже хотілося. ",shape=box,color=red];
		j2055219231 -> j2795570644;
	j1465788342 [label="ВЕЛИЧЕЗНИЙ, найбільший собака, якого тільки можна уявити. Б’юся об заклад, він міг би перекусити пана Волкова навпіл.",shape=box,color=blue];
		j1465788342 -> j3406559473;
		j1465788342 -> j2548800430;
	"Chat ends. Next chat will be KayaRank5Convo3." [color=orange];
	j2045413895 [label="Якби поруч зі мною був Зило... ця подорож була б набагато легшою.",shape=box,color=blue];
		j2045413895 -> j1017896637;
	j1829593569 [label="І не ТІЛЬКИ зі мною. Всіма нами. Лойдом, Ґомайтру... це огидно. Не знаю, чи зможу я стриматися, якщо побачу його знову.",shape=box,color=red];
		j1829593569 -> j2795570644;
	j2316249999 [label="Баллас — це втілення всього, чого я боюся. Він є найбільшим злом у житті. ",shape=box,color=red];
		j2316249999 -> j2795570644;
	j2795570644 [label="Коли ти це так кажеш.. мені здається, що життя та люди іноді просто паскудні, так?",shape=box,color=blue];
		j2795570644 -> j2586601817;
	j3406559473 [label="Там, звідки я, у нас все ще водяться великі куброу! ",shape=box,color=red];
		j3406559473 -> j696542454;
	j2548800430 [label="Гм, навіть не знаю, пан Волков доволі міцний.",shape=box,color=red];
		j2548800430 -> j4274759998;
	j1017896637 [label="Знаєш, Зило був першою живою істотою, яка побачила, як я плачу. ",shape=box,color=blue];
		j1017896637 -> j1575323031;
	j2586601817 [label="Але іноді все здається чудовим.",shape=box,color=blue];
		j2586601817 -> j817230185;
	j696542454 [label="Боже мій... ще одна причина для мене, щоб ДІСТАТИСЯ ТУДИ. Це чудово!",shape=box,color=blue];
		j696542454 -> j2571465686;
	j4274759998 [label="Може ти маєш рацію... але все одно, це був великий страшний Зило. І він люто захищав мене.",shape=box,color=blue];
		j4274759998 -> j1017896637;
	j1575323031 [label="Мені було десь п’ять років, і скільки я себе пам’ятаю, я відмовлялася плакати.",shape=box,color=blue];
		j1575323031 -> j3300125753;
	j817230185 [label="Гадаю, ми не можемо визначати себе тим, про що найбільше шкодуємо. Я відчуваю, що завдяки тобі я подолала свої жалі.",shape=box,color=blue];
		j817230185 -> j36441449;
	j2571465686 [label="Мій Зило завжди люто захищав мене. ",shape=box,color=blue];
		j2571465686 -> j1017896637;
	j3300125753 [label="Я повернулася додому після свого першого дня в першому класі, і Зило був там.",shape=box,color=blue];
		j3300125753 -> j3578196474;
	j36441449 [label="Але я б не змінила того, що це сталося. ",shape=box,color=blue];
		j36441449 -> j3580390156;
	j3578196474 [label="І він пішов за мною до моєї кімнати й охороняв двері, поки я плакала.",shape=box,color=blue];
		j3578196474 -> j996676426;
		j3578196474 -> j3813117001;
	j3580390156 [label="Тому що я не ненавиджу це. Нова? Вона ж найкрутіша у світі.",shape=box,color=blue];
		j3580390156 -> j529455930;
	j996676426 [label="Чому ти була засмучена?",shape=box,color=red];
		j996676426 -> j2178496377;
	j3813117001 [label="І ти це пам'ятаєш?",shape=box,color=red];
		j3813117001 -> j472921260;
	j529455930 [label="Тож ти б нічого не змінила?",shape=box,color=red];
		j529455930 -> j1236673941;
	j2178496377 [label="Хтось назвав мене товстою.",shape=box,color=blue];
		j2178496377 -> j1760231685;
	j472921260 [label="Як таке можна забути?!",shape=box,color=blue];
		j472921260 -> j2178496377;
	j1236673941 [label="Нічогісінько. І я сподіваюся, що ти теж цього не зробиш.",shape=box,color=blue];
		j1236673941 -> j3219460250;
	j1760231685 [label="А це було однією з тих речей, які робили дітей непопулярними, коли я росла.",shape=box,color=blue];
		j1760231685 -> j1855346867;
		j1760231685 -> j1161082924;
	j1855346867 [label="Діти можуть бути дуже жорстокими.",shape=box,color=red];
		j1855346867 -> j2865721807;
	j1161082924 [label="Чи так важливо було бути популярною?",shape=box,color=red];
		j1161082924 -> j4024085995;
	j2865721807 [label="Усі жорстокі.",shape=box,color=blue];
		j2865721807 -> j2919380465;
	j4024085995 [label="Було... поки все це не сталося. Після всього цього лайна, що сталося, я відчуваю, що стала кращою людиною, ніби тепер я та, ким дійсно хочу бути.",shape=box,color=blue];
		j4024085995 -> j3723378398;
	j2919380465 [label="Усі хочуть бути крутою дитиною.",shape=box,color=blue];
		j2919380465 -> j3964264991;
	j3723378398 [label="Мене більше не хвилює те, що про мене думають інші. Я просто... нарешті живу.",shape=box,color=blue];
		j3723378398 -> j3219460250;
	j3964264991 [label="Але тепер я зрозуміла, що набагато крутіше не заморочуватися про це. Тому в тобі стільки крутості.",shape=box,color=blue];
		j3964264991 -> j3686416820;
	j3686416820 [label="Після всього цього лайна, що сталося, я відчуваю, що стала кращою людиною, ніби тепер я та, ким дійсно хочу бути.",shape=box,color=blue];
		j3686416820 -> j3723378398;
}