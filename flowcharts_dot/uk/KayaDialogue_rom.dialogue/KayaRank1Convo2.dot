	edge [fontname="Roboto Condensed"];

	"KayaRank1Convo2 begins." [color=orange];
		"KayaRank1Convo2 begins." -> j3412402536;
	j3412402536 [label="Вітаю. Чому міжчасове налаштування Ентраті містить те, що мені здається активним з'єднанням із мережею «Кінематик»?",shape=box,color=blue];
		j3412402536 -> j1019727392;
	j1019727392 [label="Або, мабуть, краще так. Вітаю. Чи потрібен інтернет для подорожей у часі?",shape=box,color=blue];
		j1019727392 -> j1997664598;
		j1019727392 -> j2402099055;
	j1997664598 [label="Прямо до справи, гаразд. Ні, «інтернет» не зберігся до мого часу, тому він не може бути потрібним. Хоча, може й так. ",shape=box,color=red];
		j1997664598 -> j3554010968;
	j2402099055 [label="І я тебе теж вітаю, Кає. ",shape=box,color=red];
		j2402099055 -> j2521904406;
	j3554010968 [label="Тож тобі не потрібне з’єднання з інтернетом, щоби приходити та йти, коли заманеться? Ентраті також?",shape=box,color=blue];
		j3554010968 -> j2043265611;
	j2521904406 [label="Ем. Інтернет? Враховуючи властивості мережі, я можу зрозуміти…",shape=box,color=blue];
		j2521904406 -> j2043265611;
	j2043265611 [label="Я не знаю напевно. Я просто знаю, що була послідовність, в Ентраті був план, і я до нього входжу тут і зараз. Мені потрібно було потрапити сюди, щоби зустрітися з вами всіма.",shape=box,color=red];
		j2043265611 -> j3664200300;
	j3664200300 [label="Гаразд, але чому в деяких його нотатках згадується з’єднання з інтернетом, яке здається необхідним?",shape=box,color=blue];
		j3664200300 -> j971289400;
		j3664200300 -> j1018926157;
		j3664200300 -> j3351754844;
	j971289400 [label="Я запитаю його наступного разу, коли побачу.",shape=box,color=red];
		j971289400 -> j3135231552;
	j1018926157 [label="У тебе є його нотатки?",shape=box,color=red];
		j1018926157 -> j25184164;
	j3351754844 [label="Це проблема? Хіба таке дівча, як ти, не любить інтернет? ",shape=box,color=red];
		j3351754844 -> j2322558332;
	j3135231552 [label="?",shape=box,color=blue];
		j3135231552 -> j1102632446;
		j3135231552 -> j2420971445;
	j25184164 [label="Не зовсім. Просто те, що я побачила, коли знайшла його. Він, певне, не очікував, що його знайдуть.",shape=box,color=blue];
		j25184164 -> j448789439;
	j2322558332 [label="Check boolean KayaSetKid",color=orange];
		j2322558332 -> j280596864 [label=true,color=green];
		j2322558332 -> j4245287483 [label=false,color=brown];
	j1102632446 [label="Вибач, я просто жартую… у майбутньому є жарти.",shape=box,color=red];
		j1102632446 -> j380311558;
	j2420971445 [label="Та жартую. Заспокойся.",shape=box,color=red];
		j2420971445 -> j239233004;
	j448789439 [label="Boolean KayaSetFound is now true.",color=orange];
		j448789439 -> j3174834580;
		j448789439 -> j897608477;
	j280596864 [label="Тобі стає легше від того, що ти кличеш мене дівчам? Ти що, не розумієш?",shape=box,color=blue];
		j280596864 -> j1452341046;
	j4245287483 [label="Ти мене зовсім не знаєш.",shape=box,color=blue];
		j4245287483 -> j1557784581;
	j380311558 [label="Ясно.",shape=box,color=blue];
		j380311558 -> j2401539716;
	j239233004 [label="Ні.",shape=box,color=blue];
		j239233004 -> j1557784581;
	j3174834580 [label="ТИ? Ти знайшла Ентраті, коли ніхто інший не зміг?",shape=box,color=red];
		j3174834580 -> j2221364662;
	j897608477 [label="Ти знайшла його? Як?",shape=box,color=red];
		j897608477 -> j2221364662;
	j1452341046 [label="Мені довелося ШВИДКО подорослішати. Усе через тих людей у клятому інтернеті.",shape=box,color=blue];
		j1452341046 -> j1557784581;
	j1557784581 [label="+20 Chemistry",color=orange];
		j1557784581 -> "Chat ends. Next chat will be KayaRank1Convo3.";
	j2401539716 [label="+20 Chemistry",color=orange];
		j2401539716 -> j163568095;
	j2221364662 [label="Я шукала відповіді.",shape=box,color=blue];
		j2221364662 -> j841781133;
	"Chat ends. Next chat will be KayaRank1Convo3." [color=orange];
	j163568095 [label="І ти точно знаєш, що у твоєму майбутньому не буде інтернету? Це точно?",shape=box,color=blue];
		j163568095 -> j3024531225;
	j841781133 [label="+20 Chemistry",color=orange];
		j841781133 -> j3218263501;
	j3024531225 [label="Хоча, забудь, що я щось сказала. Я дізнаюся, коли сама туди потраплю.",shape=box,color=blue];
		j3024531225 -> j1557784581;
	j3218263501 [label="Усе в цій клятій дірі змінилося занадто швидко. Особливо в кулуарах інтернету, де говорили про цього Доктора.",shape=box,color=blue];
		j3218263501 -> j2774581398;
	j2774581398 [label="Тож я знайшла його та здивувала. І о Боже мій. Дідуган Доктор був незадоволений, але я відразу перейшла до справи.",shape=box,color=blue];
		j2774581398 -> j3268800429;
	j3268800429 [label="Я знала, що він із майбутнього. А він знав, що я знаю. Він дав мені вибір і ну все. Тепер я знайшла тебе. ",shape=box,color=blue];
		j3268800429 -> j1249796247;
	j1249796247 [label="І в певному сенсі я теж даю тобі вибір. Допоможи мені або пошкодуєш.",shape=box,color=blue];
		j1249796247 -> j426589832;
		j1249796247 -> j464630818;
	j426589832 [label="Ти сама чарівність. Знаєш, я тобі не ворог.",shape=box,color=red];
		j426589832 -> j3997062525;
	j464630818 [label="Ти всім своїм новим друзям погрожуєш?",shape=box,color=red];
		j464630818 -> j1429482107;
	j3997062525 [label="Поки ні. Люди змінюються. Гадаю, ми ще побачимо.",shape=box,color=blue];
		j3997062525 -> j1557784581;
	j1429482107 [label="Я просто захищаю себе. ",shape=box,color=blue];
		j1429482107 -> j1557784581;
}