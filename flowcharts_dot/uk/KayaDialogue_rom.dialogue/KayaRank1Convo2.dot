digraph {
	38 [label="KayaRank1Convo2 begins.",color=orange];
		38 -> 39;
	39 [label="Вітаю. Чому міжчасове налаштування Ентраті містить те, що мені здається активним з’єднанням із мережею «Кінематик»?",shape=box,color=blue];
		39 -> 40;
	40 [label="Або, мабуть, краще так. Вітаю. Чи потрібен інтернет для подорожей у часі?",shape=box,color=blue];
		40 -> 41;
		40 -> 42;
	41 [label="Прямо до справи, гаразд. Ні, «інтернет» не зберігся до мого часу, тому він не може бути потрібним. Хоча, може й так. ",shape=box,color=red];
		41 -> 43;
	42 [label="І я тебе теж вітаю, Кає. ",shape=box,color=red];
		42 -> 44;
	43 [label="Тож тобі не потрібне з’єднання з інтернетом, щоби приходити та йти, коли заманеться? Ентраті також?",shape=box,color=blue];
		43 -> 45;
	44 [label="Ем. Інтернет? Враховуючи властивості мережі, я можу зрозуміти…",shape=box,color=blue];
		44 -> 45;
	45 [label="Я не знаю напевно. Я просто знаю, що була послідовність, в Ентраті був план, і я до нього входжу тут і зараз. Мені потрібно було потрапити сюди, щоби зустрітися з вами всіма.",shape=box,color=red];
		45 -> 46;
	46 [label="Гаразд, але чому в деяких його нотатках згадується з’єднання з інтернетом, яке здається необхідним?",shape=box,color=blue];
		46 -> 47;
		46 -> 48;
		46 -> 49;
	47 [label="Я запитаю його наступного разу, коли побачу.",shape=box,color=red];
		47 -> 50;
	48 [label="У тебе є його нотатки?",shape=box,color=red];
		48 -> 51;
	49 [label="Це проблема? Хіба таке дівча, як ти, не любить інтернет? ",shape=box,color=red];
		49 -> 52;
	50 [label="?",shape=box,color=blue];
		50 -> 53;
		50 -> 54;
	51 [label="Не зовсім. Просто те, що я побачила, коли знайшла його. Він, певне, не очікував, що його знайдуть.",shape=box,color=blue];
		51 -> 55;
	52 [label="Check boolean KayaSetKid",color=orange];
		52 -> 56 [label=true,color=green];
		52 -> 57 [label=false,color=brown];
	53 [label="Вибач, я просто жартую… у майбутньому є жарти.",shape=box,color=red];
		53 -> 58;
	54 [label="Та жартую. Заспокойся.",shape=box,color=red];
		54 -> 59;
	55 [label="Update boolean KayaSetFound",color=orange];
