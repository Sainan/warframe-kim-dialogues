	74 [label="Усе в цій клятій дірі змінилося занадто швидко. Особливо в кулуарах інтернету, де говорили про цього Доктора.",shape=box,color=blue];
		74 -> 76;
	75 [label="+20 Chemistry",color=orange];
		75 -> 77;
	76 [label="Тож я знайшла його та здивувала. І о Боже мій. Дідуган Доктор був незадоволений, але я відразу перейшла до справи.",shape=box,color=blue];
		76 -> 78;
	77 [label="Chat ends. Next chat will be KayaRank1Convo3.",color=orange];
	78 [label="Я знала, що він із майбутнього. А він знав, що я знаю. Він дав мені вибір і ну все. Тепер я знайшла тебе. ",shape=box,color=blue];
		78 -> 79;
