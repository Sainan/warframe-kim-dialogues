digraph {
	86 [label="KayaRank1Convo3 begins.",color=orange];
		86 -> 87;
	87 [label="Подорожі в часі дорого коштують? Чи витрати рахуються в сировині? Або у ваш час це стало товаром, подібно до деяких речей тут?",shape=box,color=blue];
		87 -> 88;
		87 -> 89;
	88 [label="А що? Хочеш заощадити кілька голарів і підкупити мене?",shape=box,color=red];
		88 -> 90;
	89 [label="Дещо не можна виміряти в голарах. І привіт, до речі. ",shape=box,color=red];
		89 -> 91;
	90 [label="Це спрацювало з Ентраті.",shape=box,color=blue];
		90 -> 92;
		90 -> 93;
	91 [label="Вітаю. Тож я не можу просто заплатити комусь і навчитися цього?",shape=box,color=blue];
		91 -> 94;
		91 -> 95;
		91 -> 96;
	92 [label="Перепрошую?",shape=box,color=red];
		92 -> 97;
	93 [label="Га?",shape=box,color=red];
		93 -> 97;
	94 [label="Ти ж знаєш, що твоя «Нова» не має нічого спільного з подорожами в часі, так?",shape=box,color=red];
		94 -> 98;
	95 [label="Слухай, ти, здається, думаєш лише про одне. Подорожі у часі. Чому?",shape=box,color=red];
		95 -> 99;
	96 [label="Не можеш. [Кінець]",shape=box,color=red];
		96 -> 100;
	97 [label="Check boolean KayaSetFound",color=orange];
		97 -> 102 [label=true,color=green];
		97 -> 101 [label=false,color=brown];
	98 [label="Неважливо, що Нова може чи не може робити.",shape=box,color=blue];
		98 -> 103;
	99 [label="Ти не зрозумієш.",shape=box,color=blue];
		99 -> 104;
		99 -> 105;
	100 [label="+20 Chemistry",color=orange];
		100 -> 106;
	102 [label="Ну, я вже казала тобі. Я знайшла його.",shape=box,color=blue];
		102 -> 108;
	101 [label="Ну слухай.",shape=box,color=blue];
		101 -> 107;
	103 [label="Check boolean KayaAmirTravel",color=orange];
		103 -> 110 [label=true,color=green];
		103 -> 109 [label=false,color=brown];
	104 [label="Ти мене не знаєш. Хоча стривай, хіба не ти завжди так кажеш?",shape=box,color=red];
		104 -> 111;
	105 [label="Повір мені, я зрозумію.",shape=box,color=red];
		105 -> 112;
	106 [label="Chat ends. Next chat will be KayaRank2Convo1.",color=orange];
	108 [label="+5 Chemistry",color=orange];
		108 -> 101;
	107 [label="Він сидів за комп’ютером чи щось таке.",shape=box,color=blue];
		107 -> 113;
	110 [label="Ну, гадаю, ми намагаємося якнайкраще використовувати наші інструменти. Ти говорила з Аміром про свої питання?",shape=box,color=red];
		110 -> 116;
	109 [label="Check boolean KayaLettieHeal",color=orange];
		109 -> 115 [label=true,color=green];
		109 -> 114 [label=false,color=brown];
	111 [label="Так, я тебе не знаю. Я просто знаю, що ти можеш робити. Ось чому ми зараз говоримо. Коротше, зберися.",shape=box,color=blue];
		111 -> 117;
	112 [label="Повірити незнайомій людині в інтернеті. Ти так не жартуй. Ха. Просто скажи мені те, що я хочу знати.",shape=box,color=blue];
		112 -> 118;
	113 [label="І тут я з’явилася, а він аж підскочив із переляку. Він узагалі не очікував, що хтось може з’явиться.",shape=box,color=blue];
		113 -> 119;
		113 -> 120;
	116 [label="Говорила. Ми зійшлися щодо деяких основних положень, але він, схоже, не зацікавлений у конкретній і відтворюваній теоремі подорожі в часі. ",shape=box,color=blue];
		116 -> 123;
	115 [label="Ну, я гадаю, що ми намагаємося якнайкраще використовувати наші інструменти. Ти говорила з Летті? Я думаю, що ти з нею порозумієшся.",shape=box,color=red];
		115 -> 122;
	114 [label="Так, я просто думаю, що було б трохи легше, якби в тебе був доступ до більшої кількості інструментів мого часу.",shape=box,color=red];
		114 -> 121;
	117 [label="Ну добре, зберімося.",shape=box,color=red];
		117 -> 124;
		117 -> 125;
	118 [label="З тобою щось сталося?",shape=box,color=red];
		118 -> 126;
	119 [label="Ого, ти мене вражаєш.",shape=box,color=red];
		119 -> 127;
	120 [label="Ого, невже ти хизуєшся?",shape=box,color=red];
		120 -> 127;
	123 [label="Насправді він переконав мене, що я помилялася в деяких своїх початкових припущеннях, тому це дійсно допомогло, але він нагадав мені, що, можливо, я можу просто заплатити за свій шлях до відповіді або принаймні заплатити, щоби поговорити з кимось іншим із майбутнього, якщо ти мені не допоможеш.",shape=box,color=blue];
		123 -> 130;
		123 -> 131;
	122 [label="Ми дійсно порозумілися. Вона нагадує одну з моїх старих учительок, яка не була гидкою та цінувала мій розум.",shape=box,color=blue];
		122 -> 129;
	121 [label="Це пропозиція? До чого я можу отримати доступ? Будь-що буде корисним.",shape=box,color=blue];
		121 -> 128;
	124 [label="Ти хочеш подорожувати в часі, але куди? Чому?",shape=box,color=red];
		124 -> 132;
	125 [label="Ти дивилася навкруги?",shape=box,color=red];
		125 -> 133;
	126 [label="З усіма нами щось сталося. Просто маякни мені, якщо знайдеш спосіб мені допомогти. ",shape=box,color=blue];
		126 -> 134;
	127 [label="Ем, нагадай, чому я тобі це розповідаю?",shape=box,color=blue];
		127 -> 135;
	130 [label="За 10 голарів я розповім як ти помреш.",shape=box,color=red];
		130 -> 139;
	131 [label="Будь-хто, хто продає тобі таке, бреше. Я спробую допомогти тобі, справді. Без оплати.",shape=box,color=red];
		131 -> 140;
	129 [label="Вона справді дуже чілова. І розумна. Хоча вона сказала мені довіряти тобі по-справжньому, тож, гадаю, ми побачимо.",shape=box,color=blue];
		129 -> 137;
		129 -> 138;
	128 [label="Я подивлюся, що зможу для тебе знайти, якщо ти хочеш розібратися сама.",shape=box,color=red];
		128 -> 136;
	132 [label="Ти хоч ЩОСЬ можеш зрозуміти? Ем.",shape=box,color=blue];
		132 -> 141;
	133 [label="Багато разів. Я це все бачила. Цей чудесний рубіж тисячоліття. Запрошення на та-а-ак багато вечірок, тому що люди хотіли побачити там «ту дівчинку».",shape=box,color=blue];
		133 -> 142;
	134 [label="+20 Chemistry",color=orange];
		134 -> 143;
	135 [label="А краще просто скажи, чи мені треба зібрати грошенят?",shape=box,color=blue];
		135 -> 144;
		135 -> 145;
	139 [label="Ем. Недотепа.",shape=box,color=blue];
		139 -> 149;
	140 [label="Це ми побачимо, чи не так.",shape=box,color=blue];
		140 -> 150;
	137 [label="Я тут не для того, щоб зраджувати твою довіру чи щось на кшталт, і я не посібник для подорожей у часі.",shape=box,color=red];
		137 -> 147;
	138 [label="Запевняю, що ти можеш мені довіряти, я не знаю, чому ти така неприязна.",shape=box,color=red];
		138 -> 148;
	136 [label="Хочу. І розберуся.",shape=box,color=blue];
		136 -> 146;
	141 [label="Хто взагалі захоче тут залишатися? Типу…",shape=box,color=blue];
		141 -> 151;
	142 [label="Це ніколи не припиниться. Дивись уперед. Приходь до мене, коли зможеш допомогти.",shape=box,color=blue];
		142 -> 152;
	143 [label="Chat ends. Next chat will be KayaRank2Convo1.",color=orange];
	144 [label="Кає, я думаю, ти занадто зациклена на цьому. Що, як тобі не вдасться розібратися?",shape=box,color=red];
		144 -> 153;
	145 [label="Гадки не маю. Мене обра-а-а-ал-и-и, Кає. ",shape=box,color=red];
		145 -> 154;
