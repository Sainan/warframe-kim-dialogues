digraph {
	graph [fontname="Roboto Condensed"];
	node [fontname="Roboto Condensed"];
	edge [fontname="Roboto Condensed"];

	"KayaRank1Convo3 begins." [color=orange];
		"KayaRank1Convo3 begins." -> j2261334628;
	j2261334628 [label="Подорожі в часі дорого коштують? Чи витрати рахуються в сировині? Або у ваш час це стало товаром, подібно до деяких речей тут?",shape=box,color=blue];
		j2261334628 -> j984253273;
		j2261334628 -> j1952588799;
	j984253273 [label="А що? Хочеш заощадити кілька голарів і підкупити мене?",shape=box,color=red];
		j984253273 -> j3900919430;
	j1952588799 [label="Дещо не можна виміряти в голарах. І привіт, до речі. ",shape=box,color=red];
		j1952588799 -> j4211401094;
	j3900919430 [label="Це спрацювало з Ентраті.",shape=box,color=blue];
		j3900919430 -> j3241342345;
		j3900919430 -> j1420133039;
	j4211401094 [label="Вітаю. Тож я не можу просто заплатити комусь і навчитися цього?",shape=box,color=blue];
		j4211401094 -> j669764748;
		j4211401094 -> j3806119712;
		j4211401094 -> j563265318;
	j3241342345 [label="Перепрошую?",shape=box,color=red];
		j3241342345 -> j1310704431;
	j1420133039 [label="Га?",shape=box,color=red];
		j1420133039 -> j1310704431;
	j669764748 [label="Ти ж знаєш, що твоя «Нова» не має нічого спільного з подорожами в часі, так?",shape=box,color=red];
		j669764748 -> j1188086282;
	j3806119712 [label="Слухай, ти, здається, думаєш лише про одне. Подорожі у часі. Чому?",shape=box,color=red];
		j3806119712 -> j2524129545;
	j563265318 [label="Не можеш. [Завершити розмову]",shape=box,color=red];
		j563265318 -> j3994434447;
	j1310704431 [label="Check boolean KayaSetFound",color=orange];
		j1310704431 -> j4117081437 [label=true,color=green];
		j1310704431 -> j169995166 [label=false,color=brown];
	j1188086282 [label="Неважливо, що Нова може чи не може робити.",shape=box,color=blue];
		j1188086282 -> j2647674648;
	j2524129545 [label="Ти не зрозумієш.",shape=box,color=blue];
		j2524129545 -> j2323447646;
		j2524129545 -> j246676505;
	j3994434447 [label="+20 Chemistry",color=orange];
		j3994434447 -> "Chat ends. Next chat will be KayaRank2Convo1.";
	j4117081437 [label="Ну, я вже казала тобі. Я знайшла його.",shape=box,color=blue];
		j4117081437 -> j4087683604;
	j169995166 [label="Ну слухай.",shape=box,color=blue];
		j169995166 -> j576190940;
	j2647674648 [label="Check boolean KayaAmirTravel",color=orange];
		j2647674648 -> j570351253 [label=true,color=green];
		j2647674648 -> j368315635 [label=false,color=brown];
	j2323447646 [label="Ти мене не знаєш. Хоча стривай, хіба не ти завжди так кажеш?",shape=box,color=red];
		j2323447646 -> j3824284945;
	j246676505 [label="Повір мені, я зрозумію.",shape=box,color=red];
		j246676505 -> j3610596496;
	"Chat ends. Next chat will be KayaRank2Convo1." [color=orange];
	j4087683604 [label="+5 Chemistry",color=orange];
		j4087683604 -> j169995166;
	j576190940 [label="Він сидів за комп’ютером чи щось таке.",shape=box,color=blue];
		j576190940 -> j349143921;
	j570351253 [label="Ну, гадаю, ми намагаємося якнайкраще використовувати наші інструменти. Ти говорила з Аміром про свої питання?",shape=box,color=red];
		j570351253 -> j2671078018;
	j368315635 [label="Check boolean KayaLettieHeal",color=orange];
		j368315635 -> j1973994782 [label=true,color=green];
		j368315635 -> j190038013 [label=false,color=brown];
	j3824284945 [label="Так, я тебе не знаю. Я просто знаю, що ти можеш робити. Ось чому ми зараз говоримо. Коротше, зберися.",shape=box,color=blue];
		j3824284945 -> j3772040748;
	j3610596496 [label="Повірити незнайомій людині в інтернеті. Ти так не жартуй. Ха. Просто скажи мені те, що я хочу знати.",shape=box,color=blue];
		j3610596496 -> j2764006307;
	j349143921 [label="І тут я з’явилася, а він аж підскочив із переляку. Він узагалі не очікував, що хтось може з’явиться.",shape=box,color=blue];
		j349143921 -> j3104169782;
		j349143921 -> j2233405366;
	j2671078018 [label="Говорила. Ми зійшлися щодо деяких основних положень, але він, схоже, не зацікавлений у конкретній і відтворюваній теоремі подорожі в часі. ",shape=box,color=blue];
		j2671078018 -> j1580375948;
	j1973994782 [label="Ну, я гадаю, що ми намагаємося якнайкраще використовувати наші інструменти. Ти говорила з Летті? Я думаю, що ти з нею порозумієшся.",shape=box,color=red];
		j1973994782 -> j1095066554;
	j190038013 [label="Так, я просто думаю, що було б трохи легше, якби в тебе був доступ до більшої кількості інструментів мого часу.",shape=box,color=red];
		j190038013 -> j643832892;
	j3772040748 [label="Ну добре, зберімося.",shape=box,color=red];
		j3772040748 -> j3793963826;
		j3772040748 -> j299951815;
	j2764006307 [label="З тобою щось сталося?",shape=box,color=red];
		j2764006307 -> j1060924673;
	j3104169782 [label="Ого, ти мене вражаєш.",shape=box,color=red];
		j3104169782 -> j3091457370;
	j2233405366 [label="Ого, невже ти хизуєшся?",shape=box,color=red];
		j2233405366 -> j3091457370;
	j1580375948 [label="Насправді він переконав мене, що я помилялася в деяких своїх початкових припущеннях, тому це дійсно допомогло, але він нагадав мені, що, можливо, я можу просто заплатити за свій шлях до відповіді або принаймні заплатити, щоби поговорити з кимось іншим із майбутнього, якщо ти мені не допоможеш.",shape=box,color=blue];
		j1580375948 -> j3156532258;
		j1580375948 -> j548543909;
	j1095066554 [label="Ми дійсно порозумілися. Вона нагадує одну з моїх старих учительок, яка не була гидкою та цінувала мій розум.",shape=box,color=blue];
		j1095066554 -> j243228348;
	j643832892 [label="Це пропозиція? До чого я можу отримати доступ? Будь-що буде корисним.",shape=box,color=blue];
		j643832892 -> j1707476040;
	j3793963826 [label="Ти хочеш подорожувати в часі, але куди? Чому?",shape=box,color=red];
		j3793963826 -> j1295633574;
	j299951815 [label="Ти дивилася навкруги?",shape=box,color=red];
		j299951815 -> j2090014606;
	j1060924673 [label="З усіма нами щось сталося. Просто маякни мені, якщо знайдеш спосіб мені допомогти. ",shape=box,color=blue];
		j1060924673 -> j3994434447;
	j3091457370 [label="Ем, нагадай, чому я тобі це розповідаю?",shape=box,color=blue];
		j3091457370 -> j1333611052;
	j3156532258 [label="За 10 голарів я розповім як ти помреш.",shape=box,color=red];
		j3156532258 -> j964387171;
	j548543909 [label="Будь-хто, хто продає тобі таке, бреше. Я спробую допомогти тобі, справді. Без оплати.",shape=box,color=red];
		j548543909 -> j3421312412;
	j243228348 [label="Вона справді дуже чілова. І розумна. Хоча вона сказала мені довіряти тобі по-справжньому, тож, гадаю, ми побачимо.",shape=box,color=blue];
		j243228348 -> j991000634;
		j243228348 -> j4201604155;
	j1707476040 [label="Я подивлюся, що зможу для тебе знайти, якщо ти хочеш розібратися сама.",shape=box,color=red];
		j1707476040 -> j119579125;
	j1295633574 [label="Ти хоч ЩОСЬ можеш зрозуміти? Ем.",shape=box,color=blue];
		j1295633574 -> j377858309;
	j2090014606 [label="Багато разів. Я це все бачила. Цей чудесний рубіж тисячоліття. Запрошення на та-а-ак багато вечірок, тому що люди хотіли побачити там «ту дівчинку».",shape=box,color=blue];
		j2090014606 -> j1528575692;
	j1333611052 [label="А краще просто скажи, чи мені треба зібрати грошенят?",shape=box,color=blue];
		j1333611052 -> j1893704998;
		j1333611052 -> j1150751576;
	j964387171 [label="Ем. Недотепа.",shape=box,color=blue];
		j964387171 -> j3994434447;
	j3421312412 [label="Це ми побачимо, чи не так.",shape=box,color=blue];
		j3421312412 -> j3994434447;
	j991000634 [label="Я тут не для того, щоб зраджувати твою довіру чи щось на кшталт, і я не посібник для подорожей у часі.",shape=box,color=red];
		j991000634 -> j281155353;
	j4201604155 [label="Запевняю, що ти можеш мені довіряти, я не знаю, чому ти така неприязна.",shape=box,color=red];
		j4201604155 -> j3828015849;
	j119579125 [label="Хочу. І розберуся.",shape=box,color=blue];
		j119579125 -> j3994434447;
	j377858309 [label="Хто взагалі захоче тут залишатися? Типу…",shape=box,color=blue];
		j377858309 -> j252845703;
	j1528575692 [label="Це ніколи не припиниться. Дивись уперед. Приходь до мене, коли зможеш допомогти.",shape=box,color=blue];
		j1528575692 -> j3994434447;
	j1893704998 [label="Кає, я думаю, ти занадто зациклена на цьому. Що, як тобі не вдасться розібратися?",shape=box,color=red];
		j1893704998 -> j633889727;
	j1150751576 [label="Гадки не маю. Мене обра-а-а-ал-и-и, Кає. ",shape=box,color=red];
		j1150751576 -> j652782598;
	j281155353 [label="Ем. ОК.",shape=box,color=blue];
		j281155353 -> j3994434447;
	j3828015849 [label="У мене є причини.",shape=box,color=blue];
		j3828015849 -> j3994434447;
	j252845703 [label="Я розберуся, я знаю, що зможу, ага. Па-па.",shape=box,color=blue];
		j252845703 -> j3994434447;
	j633889727 [label="Мені вдасться.",shape=box,color=blue];
		j633889727 -> j3994434447;
	j652782598 [label="Ну так, тебе обрали БЛАЗНЮВАТИ",shape=box,color=blue];
		j652782598 -> j3994434447;
}