	j2217210219 [label="Ніхто з нас не судитиме тебе.",shape=box,color=red];
		j2217210219 -> j2712726756;
	j2712726756 [label="Те, що з тобою трапилося, було повним порушенням приватності.",shape=box,color=red];
		j2712726756 -> j3005700156;
	j3005700156 [label="Хтось зрадив твою довіру та намагався тебе принизити.",shape=box,color=red];
		j3005700156 -> j994732181;
	j994732181 [label="Ти була вразливою та цим скористалися.",shape=box,color=red];
		j994732181 -> j1207163106;
	j1207163106 [label="Твій світ вирвали з-під твоїх ніг. ",shape=box,color=red];
		j1207163106 -> j3430480472;
	j3430480472 [label="Люди дивилися на тебе інакше.",shape=box,color=red];
		j3430480472 -> j3566659937;
	j3566659937 [label="Розумієш тепер, чому мені потрібно вшитися?",shape=box,color=blue];
		j3566659937 -> j4272020100;
	j4272020100 [label="Здавалося, що те, що сталося зі мною, ніколи не траплялося НІ З КИМ.",shape=box,color=blue];
		j4272020100 -> j3109648949;
	j3109648949 [label="Це потрапило в заголовки газет. Люди знущалися з мене за те, що я типу прикидалася жертвою, коли сама вирішила поділитися цією фоткою.",shape=box,color=blue];
		j3109648949 -> j1744647419;
	j1744647419 [label="Ти навіть не зможеш знайти моє ім’я в студентських базах даних, щоб люди не подумали про цю «УПР», учительську підлабузу-розпусницю.",shape=box,color=blue];
		j1744647419 -> j45990398;
	j45990398 [label="І ви теж побачивши цю фотку ніколи не подивитеся на мене як раніше. Будь-яка повага… зникне. Назавжди.",shape=box,color=blue];
		j45990398 -> j753373965;
	j753373965 [label="Я маю вшитися та рухатися далі, у час і місце, де я достатньо розумна, щоб залишити все це позаду.",shape=box,color=blue];
		j753373965 -> j2103665661;
		j753373965 -> j1777224075;
		j753373965 -> j992985192;
	j2103665661 [label="Мені більше нічого сказати. Ми всі робили речі, про які шкодуємо. ",shape=box,color=red];
		j2103665661 -> j1730731917;
	j1777224075 [label="Навпаки, тепер я поважаю тебе більше.",shape=box,color=red];
		j1777224075 -> j829617487;
	j992985192 [label="Ніколи та ніхто з нас не судитиме тебе за це.",shape=box,color=red];
		j992985192 -> j3051414897;
	j1730731917 [label="Можливо, колись ти зможеш розповісти мені, про що ти найбільше шкодуєш…",shape=box,color=blue];
		j1730731917 -> j2808290798;
		j1730731917 -> j929078358;
	j829617487 [label="Дідько, не бреши мені.",shape=box,color=blue];
		j829617487 -> j3103116258;
		j829617487 -> j958216058;
	j3051414897 [label="Check boolean KayaEternalismTest",color=orange];
		j3051414897 -> j2420811650 [label=true,color=green];
		j3051414897 -> j2072611246 [label=false,color=brown];
	j2808290798 [label="Можливо й так. Зрештою, у нас багато часу.",shape=box,color=red];
		j2808290798 -> j636956295;
	j929078358 [label="Обіцяю. Ти не сама в цьому світі. Ми всі ризикуємо, коли довіряємо іншим людям.",shape=box,color=red];
		j929078358 -> j3706483799;
	j3103116258 [label="Це не брехня. Просто повір. [Кінець]",shape=box,color=red];
		j3103116258 -> j636956295;
	j958216058 [label="Вислухай мене.",shape=box,color=red];
		j958216058 -> j3051414897;
	j2420811650 [label="Ти, очевидно, зрозуміла етерналізм, можливо, навіть краще за мене.",shape=box,color=red];
		j2420811650 -> j1915927678;
	j2072611246 [label="Check boolean KayaAttitude",color=orange];
		j2072611246 -> j3658354878 [label=true,color=green];
