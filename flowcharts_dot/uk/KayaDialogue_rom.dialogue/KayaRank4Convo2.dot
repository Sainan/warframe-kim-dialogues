		j3953820882 -> j3774138342;
	j3774138342 [label="Ніхто з нас не судитиме тебе.",shape=box,color=red];
		j3774138342 -> j1226183429;
	j1226183429 [label="Те, що з тобою трапилося, було повним порушенням приватності.",shape=box,color=red];
		j1226183429 -> j1355352473;
	j1355352473 [label="Хтось зрадив твою довіру та намагався тебе принизити.",shape=box,color=red];
		j1355352473 -> j3462103811;
	j3462103811 [label="Ти була вразливою та цим скористалися.",shape=box,color=red];
		j3462103811 -> j1257347819;
	j1257347819 [label="Твій світ вирвали з-під твоїх ніг. ",shape=box,color=red];
		j1257347819 -> j3570208716;
	j3570208716 [label="Люди дивилися на тебе інакше.",shape=box,color=red];
		j3570208716 -> j1360332188;
	j1360332188 [label="Розумієш тепер, чому мені потрібно вшитися?",shape=box,color=blue];
		j1360332188 -> j703313975;
	j703313975 [label="Здавалося, що те, що сталося зі мною, ніколи не траплялося НІ З КИМ.",shape=box,color=blue];
		j703313975 -> j1379145101;
	j1379145101 [label="Це потрапило в заголовки газет. Люди знущалися з мене за те, що я типу прикидалася жертвою, коли сама вирішила поділитися цією фоткою.",shape=box,color=blue];
		j1379145101 -> j978598390;
	j978598390 [label="Ти навіть не зможеш знайти моє ім’я в студентських базах даних, щоб люди не подумали про цю «УПР», учительську підлабузу-розпусницю.",shape=box,color=blue];
		j978598390 -> j2219429719;
	j2219429719 [label="І ви теж, побачивши цю фотку, ніколи не подивитеся на мене як раніше. Будь-яка повага… зникне. Назавжди.",shape=box,color=blue];
		j2219429719 -> j753373965;
	j753373965 [label="Я маю вшитися та рухатися далі, у час і місце, де я достатньо розумна, щоб залишити все це позаду.",shape=box,color=blue];
		j753373965 -> j2103665661;
		j753373965 -> j1777224075;
		j753373965 -> j992985192;
	j2103665661 [label="Мені більше нічого сказати. Ми всі робили речі, про які шкодуємо. ",shape=box,color=red];
		j2103665661 -> j1730731917;
	j1777224075 [label="Навпаки, тепер я поважаю тебе більше.",shape=box,color=red];
		j1777224075 -> j829617487;
	j992985192 [label="Ніколи та ніхто з нас не судитиме тебе за це.",shape=box,color=red];
		j992985192 -> j3051414897;
	j1730731917 [label="Можливо, колись ти зможеш розповісти мені, про що ти найбільше шкодуєш…",shape=box,color=blue];
		j1730731917 -> j2808290798;
		j1730731917 -> j929078358;
	j829617487 [label="Дідько, не бреши мені.",shape=box,color=blue];
		j829617487 -> j3372127668;
		j829617487 -> j958216058;
	j3051414897 [label="Check boolean KayaEternalismTest",color=orange];
		j3051414897 -> j2420811650 [label=true,color=green];
		j3051414897 -> j2072611246 [label=false,color=brown];
	j2808290798 [label="Можливо й так. Зрештою, у нас багато часу.",shape=box,color=red];
		j2808290798 -> j636956295;
	j929078358 [label="Обіцяю. Ти не сама в цьому світі. Ми всі ризикуємо, коли довіряємо іншим людям.",shape=box,color=red];
		j929078358 -> j3706483799;
	j3372127668 [label="Це не брехня. Просто повір. [Завершити розмову]",shape=box,color=red];
		j3372127668 -> j636956295;
	j958216058 [label="Вислухай мене.",shape=box,color=red];
		j958216058 -> j3051414897;
	j2420811650 [label="Ти, очевидно, зрозуміла етерналізм, можливо, навіть краще за мене.",shape=box,color=red];
		j2420811650 -> j1915927678;
	j2072611246 [label="Check boolean KayaAttitude",color=orange];
		j2072611246 -> j3658354878 [label=true,color=green];
		j2072611246 -> j3458420025 [label=false,color=brown];
	j636956295 [label="+20 Chemistry",color=orange];
		j636956295 -> "Chat ends. Next chat will be KayaRank4Convo3.";
	j3706483799 [label="Boolean KayaPromiseRegret is now true.",color=orange];
		j3706483799 -> j636956295;
	j1915927678 [label="А це багато про що говорить.",shape=box,color=red];
		j1915927678 -> j2072611246;
	j3658354878 [label="Все те твоє ставлення до мене? Принаймні має сенс, бо ти налякана ТА сердита. Я просто ще одна незнайома людина в інтернеті.",shape=box,color=red];
		j3658354878 -> j3458420025;
	j3458420025 [label="Я не намагатимуся відговорювати тебе покинути 1999. ",shape=box,color=red];
		j3458420025 -> j52392123;
	"Chat ends. Next chat will be KayaRank4Convo3." [color=orange];
	j52392123 [label="Я вірю, що є спосіб. І для тебе важливо поїхати кудись в інше місце, куди завгодно.",shape=box,color=red];
		j52392123 -> j4260887686;
	j4260887686 [label="Я завжди з радістю допоможу. Хоча я, мабуть, кращий слухач, ніж мандрівник у часі. Не соромся.",shape=box,color=red];
