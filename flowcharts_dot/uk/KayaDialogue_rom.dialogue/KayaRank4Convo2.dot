		570 -> 571;
	571 [label="Це потрапило в заголовки газет. Люди знущалися з мене за те, що я типу прикидалася жертвою, коли сама вирішила поділитися цією фоткою.",shape=box,color=blue];
		571 -> 572;
	572 [label="Ти навіть не зможеш знайти моє ім’я в студентських базах даних, щоб люди не подумали про цю «УПР», учительську підлабузу-розпусницю.",shape=box,color=blue];
		572 -> 573;
	573 [label="І ви теж, побачивши цю фотку, ніколи не подивитеся на мене як раніше. Будь-яка повага… зникне. Назавжди.",shape=box,color=blue];
		573 -> 574;
	574 [label="Я маю вшитися та рухатися далі, у час і місце, де я достатньо розумна, щоб залишити все це позаду.",shape=box,color=blue];
		574 -> 575;
		574 -> 576;
		574 -> 577;
	575 [label="Мені більше нічого сказати. Ми всі робили речі, про які шкодуємо. ",shape=box,color=red];
