	422 [label="Хороші оцінки, навіть відмінні. Ще й капітанка групи підтримки. Було дуже складно отримати запрошення на мій День народження.",shape=box,color=blue];
		422 -> 426;
	429 [label="У всякому разі, я побачила цю людину з тортом. Тоді я збентежилася, що мої одногрупники побачать, як мені дарують торт. Бо я тусувала з іншим колом.",shape=box,color=blue];
