digraph {
	"KayaRank3Convo1 begins." [color=orange];
		"KayaRank3Convo1 begins." -> j1417402606;
	j1417402606 [label="Я щойно зрозуміла, кого ти мені нагадуєш. ",shape=box,color=blue];
		j1417402606 -> j2080377619;
	j2080377619 [label="Одну людину, з якою мене посадили в пару на першому курсі універу.",shape=box,color=blue];
		j2080377619 -> j2561229719;
	j2561229719 [label="Check boolean KayaCake",color=orange];
		j2561229719 -> j2063382840 [label=true,color=green];
		j2561229719 -> j1884778478 [label=false,color=brown];
		j2561229719 -> j2621913692 [label=false,color=brown];
	j2063382840 [label="О-о гм. Але в хорошому сенсі?",shape=box,color=red];
		j2063382840 -> j4102532055;
	j1884778478 [label="Неймовірно привабливу та талановиту людину?",shape=box,color=red];
		j1884778478 -> j3663120586;
	j2621913692 [label="Я вже стримуюся, щоб не почати сварку…",shape=box,color=red];
		j2621913692 -> j2087638128;
	j4102532055 [label="Узагалі-то так. ",shape=box,color=blue];
		j4102532055 -> j2965147677;
	j3663120586 [label="Пхе. Не хочу тебе засмучувати, але я не фліртую. Ніколи.",shape=box,color=blue];
		j3663120586 -> j1338212340;
	j2087638128 [label="Перепрошую, ні-ні. Це щасливі спогади.",shape=box,color=blue];
		j2087638128 -> j696121863;
		j2087638128 -> j176229168;
	j2965147677 [label="Я пекла торт, щоби довести твою неправоту.",shape=box,color=blue];
		j2965147677 -> j1013973203;
	j1338212340 [label="ОСОБЛИВО не в інтернеті.",shape=box,color=blue];
		j1338212340 -> j1242880238;
		j1338212340 -> j1225058741;
	j696121863 [label="Як скажеш.",shape=box,color=red];
		j696121863 -> j3253692604;
	j176229168 [label="Здається, у тебе їх небагато.",shape=box,color=red];
		j176229168 -> j2313640729;
	j1013973203 [label="І згадала єдину людину, яка коли-небудь пекла для мене торт, ми разом вчилися.",shape=box,color=blue];
		j1013973203 -> j1884545855;
	j1242880238 [label="Але що, як я захочу?",shape=box,color=red];
		j1242880238 -> j1360391391;
	j1225058741 [label="Йой, вибачай. Вибачай. ",shape=box,color=red];
		j1225058741 -> j913979291;
	j3253692604 [label="Насправді мова про мій день народження, але не про мене. ",shape=box,color=blue];
		j3253692604 -> j2755159317;
	j2313640729 [label="Тоді дозволь поділитися одним із них! ",shape=box,color=blue];
		j2313640729 -> j3253692604;
	j1884545855 [label="Ця людина якимось чином дізналася про мій день народження, хоча ми ніколи не тусили разом.",shape=box,color=blue];
		j1884545855 -> j3764892889;
	j1360391391 [label="Роби це з кимось, але не зі мною.",shape=box,color=blue];
		j1360391391 -> j2013445877;
	j913979291 [label="Навіть не пробуй знову.",shape=box,color=blue];
		j913979291 -> j3368182723;
	j2755159317 [label="Ну, може трошки про мене. Я мушу сказати, що я точно була тою людиною, з якою всі хотіли, щоб їх бачили.",shape=box,color=blue];
		j2755159317 -> j1171535637;
	j3764892889 [label="І принесла мені ванільний торт з ванільною глазур'ю, заввишки в три шари, я клянуся.",shape=box,color=blue];
		j3764892889 -> j4113185479;
	j2013445877 [label="+5 Chemistry",color=orange];
		j2013445877 -> "Chat ends. Next chat will be KayaRank3Convo2.";
	j3368182723 [label="Обіцяю, що більше не буду.",shape=box,color=red];
		j3368182723 -> j2527865689;
	j1171535637 [label="Хороші оцінки, навіть відмінні. Ще й капітанка групи підтримки. Було дуже складно отримати запрошення на мій день народження.",shape=box,color=blue];
		j1171535637 -> j1101345714;
	j4113185479 [label="У всякому разі, я побачила цю людину з тортом. Тоді я збентежилася, що мої одногрупники побачать, як мені дарують торт. Бо я тусувала з іншим колом.",shape=box,color=blue];
		j4113185479 -> j1020326251;
	"Chat ends. Next chat will be KayaRank3Convo2." [color=orange];
	j2527865689 [label="Boolean KayaFlirtPromise is now true.",color=orange];
		j2527865689 -> j4222004300;
	j1101345714 [label="У всякому разі, ця людина спекла мені торт на день народження, але попросила ні з ким не ділитися ним і розрізати його, коли прийду додому.",shape=box,color=blue];
		j1101345714 -> j2719552318;
	j1020326251 [label="У мене були хороші оцінки. Навіть відмінні. Ще й капітанка групи підтримки. Було дуже складно отримати запрошення на мій день народження.",shape=box,color=blue];
		j1020326251 -> j1101345714;
	j4222004300 [label="Гаразд.",shape=box,color=blue];
		j4222004300 -> j1101345714;
	j2719552318 [label="І, чесно кажучи, це мене збентежило, як і ти спочатку. Але коли я розрізала його, мій ніж вдарився об щось тверде.",shape=box,color=blue];
		j2719552318 -> j1291477244;
	j1291477244 [label="Огидно, так? Мега огидно. Але коли я придивилася, я побачила щось схоже на пластикову коробку, заховану під тортом і наповнену запечатаними пачками карток Джинімон. А я їх обожнюю.",shape=box,color=blue];
		j1291477244 -> j1516856298;
	j1516856298 [label="Але таку круту дівчину, як я, ніколи б не ПОБАЧИЛИ з цими картами в школі. Але, ця сором’язлива дитина побачила, якою я є насправді, і підсунула мені справжній подарунок, прикриваючи його тим великим тортом, ніби щоби заробити мою увагу.",shape=box,color=blue];
		j1516856298 -> j2584943106;
		j1516856298 -> j3360445099;
		j1516856298 -> j523912138;
	j2584943106 [label="Я не буду пекти тобі торт.",shape=box,color=red];
		j2584943106 -> j1655790579;
	j3360445099 [label="Для такого геніального дівчати, тобі знадобилося багато часу, щоб висловити думку…",shape=box,color=red];
		j3360445099 -> j4166457644;
	j523912138 [label="І чим саме це нагадує тобі мене?",shape=box,color=red];
		j523912138 -> j2330698262;
	j1655790579 [label="+20 Chemistry",color=orange];
		j1655790579 -> j2269682494;
	j4166457644 [label="А для людини, з великого та натхненного майбутнього, ти, безсумнівно, упускаєш сенс. Картки Джинімон! І Я! Ти можеш в це повірити? ",shape=box,color=blue];
		j4166457644 -> j157625073;
		j4166457644 -> j3384121121;
	j2330698262 [label="Здається, це я так кажу, що довіряю тобі, бо я поділилася, що збираю картки Джинімон. Вони типу для невдах.",shape=box,color=blue];
		j2330698262 -> j3661162008;
	j2269682494 [label="Ха-ха-ха!",shape=box,color=blue];
		j2269682494 -> j3084361647;
	j157625073 [label="Не маю уявлення, що воно таке!",shape=box,color=red];
		j157625073 -> j1811704545;
	j3384121121 [label="Це типу як спеціальні колекційні речі?",shape=box,color=red];
		j3384121121 -> j1811704545;
	j3661162008 [label="Або принаймні я так думала. Але справжніми невдахами були всі інші. ",shape=box,color=blue];
		j3661162008 -> j1260747656;
		j3661162008 -> j3224045056;
		j3661162008 -> j1449513571;
	j3084361647 [label="Він все одно певно був би несмачний.",shape=box,color=blue];
		j3084361647 -> j884666887;
		j3084361647 -> j2907427408;
	j1811704545 [label="Вони як дитяча карткова монстр-гра та в них типу грають повні невдахи, особливо в університеті.",shape=box,color=blue];
		j1811704545 -> j3661162008;
	j1260747656 [label="Покажеш мені колись свої картки Джинімон?",shape=box,color=red];
		j1260747656 -> j2941136387;
	j3224045056 [label="Ого, у нас сталася ціла розмова, яка була НЕ ТІЛЬКИ про подорожі в часі! ",shape=box,color=red];
		j3224045056 -> j2695172804;
	j1449513571 [label="Невже ти відкриваєшся мені? Це приємно!",shape=box,color=red];
		j1449513571 -> j3626373903;
	j884666887 [label="Мабуть твоя правда.",shape=box,color=red];
		j884666887 -> j675357349;
	j2907427408 [label="Ти мене недооцінюєш.",shape=box,color=red];
		j2907427408 -> j675357349;
	j2941136387 [label="Можливо.",shape=box,color=blue];
		j2941136387 -> j1895387827;
	j2695172804 [label="Та-да!",shape=box,color=blue];
		j2695172804 -> j1895387827;
	j3626373903 [label="Не звикай. Можливо. Ем, не знаю. ",shape=box,color=blue];
		j3626373903 -> j1895387827;
	j675357349 [label="О-о-о та-а-а-к! ",shape=box,color=blue];
		j675357349 -> j773941087;
	j1895387827 [label="+20 Chemistry",color=orange];
		j1895387827 -> "Chat ends. Next chat will be KayaRank3Convo2.";
	j773941087 [label="Здається, це я так кажу, що довіряю тобі, бо я поділилася, що збираю картки Джинімон. Вони типу для невдах.",shape=box,color=blue];
		j773941087 -> j2480582430;
	j2480582430 [label="Або принаймні я так думала. Але справжніми невдахами були всі інші. ",shape=box,color=blue];
		j2480582430 -> j1449513571;
