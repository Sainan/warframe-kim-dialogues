digraph {
	graph [fontname="Roboto Condensed"];
	node [fontname="Roboto Condensed"];
	edge [fontname="Roboto Condensed"];

	"KayaRank3Convo1 begins." [color=orange];
		"KayaRank3Convo1 begins." -> j1417402606;
	j1417402606 [label="Я щойно зрозуміла, кого ти мені нагадуєш. ",shape=box,color=blue];
		j1417402606 -> j2080377619;
	j2080377619 [label="Одну людину, з якою мене посадили в пару на першому курсі універу.",shape=box,color=blue];
		j2080377619 -> j2561229719;
	j2561229719 [label="Check boolean KayaCake",color=orange];
		j2561229719 -> j66835320 [label=true,color=green];
		j2561229719 -> j1884778478 [label=false,color=brown];
		j2561229719 -> j2621913692 [label=false,color=brown];
	j66835320 [label="О-о, гм. Але в хорошому сенсі?",shape=box,color=red];
		j66835320 -> j938570605;
	j1884778478 [label="Неймовірно привабливу та талановиту людину?",shape=box,color=red];
		j1884778478 -> j3663120586;
	j2621913692 [label="Я вже стримуюся, щоб не почати сварку…",shape=box,color=red];
		j2621913692 -> j2087638128;
	j938570605 [label="Узагалі-то так. ",shape=box,color=blue];
		j938570605 -> j1708045517;
	j3663120586 [label="Пхе. Не хочу тебе засмучувати, але я не фліртую. Ніколи.",shape=box,color=blue];
		j3663120586 -> j1338212340;
	j2087638128 [label="Перепрошую, ні-ні. Це щасливі спогади.",shape=box,color=blue];
		j2087638128 -> j2771831322;
		j2087638128 -> j144118639;
	j1708045517 [label="Я пекла торт, щоб довести твою неправоту.",shape=box,color=blue];
		j1708045517 -> j1120021639;
	j1338212340 [label="ОСОБЛИВО не в інтернеті.",shape=box,color=blue];
		j1338212340 -> j1242880238;
		j1338212340 -> j4252014847;
	j2771831322 [label="Як скажеш.",shape=box,color=red];
		j2771831322 -> j848826370;
	j144118639 [label="Здається, у тебе їх небагато.",shape=box,color=red];
		j144118639 -> j1540999840;
	j1120021639 [label="І згадала єдину людину, яка коли-небудь пекла для мене торт, ми разом вчилися.",shape=box,color=blue];
		j1120021639 -> j3218934738;
	j1242880238 [label="Але що, як я захочу?",shape=box,color=red];
		j1242880238 -> j1360391391;
	j4252014847 [label="Йой, вибачай. Вибачай. ",shape=box,color=red];
		j4252014847 -> j4067884762;
	j848826370 [label="Насправді мова про мій День народження, але не про мене. ",shape=box,color=blue];
		j848826370 -> j3853123847;
	j1540999840 [label="Тоді дозволь поділитися одним із них! ",shape=box,color=blue];
		j1540999840 -> j848826370;
	j3218934738 [label="Ця людина якимось чином дізналася про мій День народження, хоча ми ніколи не тусили разом.",shape=box,color=blue];
		j3218934738 -> j3292322375;
	j1360391391 [label="Роби це з кимось, але не зі мною.",shape=box,color=blue];
		j1360391391 -> j2013445877;
	j4067884762 [label="Навіть не пробуй знову.",shape=box,color=blue];
		j4067884762 -> j2927440977;
	j3853123847 [label="Ну, може трошки про мене. Я мушу сказати, що я точно була тою людиною, з якою всі хотіли, щоб їх бачили.",shape=box,color=blue];
		j3853123847 -> j651352558;
	j3292322375 [label="І принесла мені ванільний торт із ванільною глазур'ю, заввишки в три шари, клянуся.",shape=box,color=blue];
		j3292322375 -> j2006908120;
	j2013445877 [label="+5 Chemistry",color=orange];
		j2013445877 -> "Chat ends. Next chat will be KayaRank3Convo2.";
	j2927440977 [label="Обіцяю, що більше не буду.",shape=box,color=red];
		j2927440977 -> j1484612614;
	j651352558 [label="Хороші оцінки, навіть відмінні. Ще й капітанка групи підтримки. Було дуже складно отримати запрошення на мій День народження.",shape=box,color=blue];
		j651352558 -> j3592400556;
	j2006908120 [label="У всякому разі, я побачила цю людину з тортом. Тоді я збентежилася, що мої одногрупники побачать, як мені дарують торт. Бо я тусувала з іншим колом.",shape=box,color=blue];
		j2006908120 -> j663418007;
	"Chat ends. Next chat will be KayaRank3Convo2." [color=orange];
	j1484612614 [label="Boolean KayaFlirtPromise is now true.",color=orange];
		j1484612614 -> j1919951858;
	j3592400556 [label="У всякому разі, ця людина спекла мені торт на День народження, але попросила ні з ким не ділитися ним і розрізати його, коли прийду додому. ",shape=box,color=blue];
		j3592400556 -> j618262035;
	j663418007 [label="У мене були хороші оцінки. Навіть відмінні. Ще й капітанка групи підтримки. Було дуже складно отримати запрошення на мій день народження.",shape=box,color=blue];
		j663418007 -> j3592400556;
	j1919951858 [label="Гаразд.",shape=box,color=blue];
		j1919951858 -> j3592400556;
	j618262035 [label="І, чесно кажучи, це мене збентежило, як і ти спочатку. Але коли я розрізала його, мій ніж вдарився об щось тверде.",shape=box,color=blue];
		j618262035 -> j1557723593;
	j1557723593 [label="Огидно, так? Мега огидно. Але коли я придивилася, я побачила щось схоже на пластикову коробку, заховану під тортом і наповнену запечатаними пачками карток «Джинімон». А я їх обожнюю.",shape=box,color=blue];
		j1557723593 -> j67905557;
	j67905557 [label="Але таку круту дівчину, як я, ніколи б не ПОБАЧИЛИ з цими картами в школі. Але ця сором’язлива дитина побачила, якою я є насправді, і підсунула мені справжній подарунок, прикриваючи його тим великим тортом, ніби щоб заробити мою увагу.",shape=box,color=blue];
		j67905557 -> j4284468758;
		j67905557 -> j3417251358;
		j67905557 -> j608103429;
	j4284468758 [label="Я не буду пекти тобі торт.",shape=box,color=red];
		j4284468758 -> j150342445;
	j3417251358 [label="Для такого геніального дівчати, тобі знадобилося багато часу, щоб висловити думку…",shape=box,color=red];
		j3417251358 -> j4224833372;
	j608103429 [label="І чим саме це нагадує тобі мене?",shape=box,color=red];
		j608103429 -> j4290673741;
	j150342445 [label="+20 Chemistry",color=orange];
		j150342445 -> j2288787468;
	j4224833372 [label="А для людини з великого та натхненного майбутнього, ти, безсумнівно, упускаєш сенс. Картки «Джинімон»! І Я! Ти можеш в це повірити? ",shape=box,color=blue];
		j4224833372 -> j85279950;
		j4224833372 -> j1341160037;
	j4290673741 [label="Здається, це я так кажу, що довіряю тобі, бо я поділилася, що збираю картки «Джинімон». Вони типу для невдах.",shape=box,color=blue];
		j4290673741 -> j3661162008;
	j2288787468 [label="Ха-ха-ха!",shape=box,color=blue];
		j2288787468 -> j927291127;
	j85279950 [label="Не маю уявлення, що воно таке!",shape=box,color=red];
		j85279950 -> j2048175859;
	j1341160037 [label="Це типу як спеціальні колекційні речі?",shape=box,color=red];
		j1341160037 -> j2048175859;
	j3661162008 [label="Або принаймні я так думала. Але справжніми невдахами були всі інші. ",shape=box,color=blue];
		j3661162008 -> j1189465131;
		j3661162008 -> j3224045056;
		j3661162008 -> j1449513571;
	j927291127 [label="Він усе одно певно був би несмачний.",shape=box,color=blue];
		j927291127 -> j1106183618;
		j927291127 -> j2530822484;
	j2048175859 [label="Вони як дитяча карткова монстр-гра, та в них типу грають повні невдахи, особливо в університеті.",shape=box,color=blue];
		j2048175859 -> j3661162008;
	j1189465131 [label="Покажеш мені колись свої картки «Джинімон»?",shape=box,color=red];
		j1189465131 -> j2941136387;
	j3224045056 [label="Ого, у нас сталася ціла розмова, яка була НЕ ТІЛЬКИ про подорожі в часі! ",shape=box,color=red];
		j3224045056 -> j2695172804;
	j1449513571 [label="Невже ти відкриваєшся мені? Це приємно!",shape=box,color=red];
		j1449513571 -> j3626373903;
	j1106183618 [label="Мабуть, твоя правда.",shape=box,color=red];
		j1106183618 -> j2447311335;
	j2530822484 [label="Ти мене недооцінюєш.",shape=box,color=red];
		j2530822484 -> j2447311335;
	j2941136387 [label="Можливо.",shape=box,color=blue];
		j2941136387 -> j1895387827;
	j2695172804 [label="Та-да!",shape=box,color=blue];
		j2695172804 -> j1895387827;
	j3626373903 [label="Не звикай. Можливо. Ем, не знаю. ",shape=box,color=blue];
		j3626373903 -> j1895387827;
	j2447311335 [label="О-о-о та-а-а-к! ",shape=box,color=blue];
		j2447311335 -> j950890286;
	j1895387827 [label="+20 Chemistry",color=orange];
		j1895387827 -> "Chat ends. Next chat will be KayaRank3Convo2.";
	j950890286 [label="Здається, це я так кажу, що довіряю тобі, бо я поділилася, що збираю картки «Джинімон». Вони типу для невдах.",shape=box,color=blue];
		j950890286 -> j2480582430;
	j2480582430 [label="Або принаймні я так думала. Але справжніми невдахами були всі інші. ",shape=box,color=blue];
		j2480582430 -> j1449513571;
		j2480582430 -> j3224045056;
		j2480582430 -> j1189465131;
