	418 [label="Ну, може трошки про мене. Я мушу сказати, що я точно була тою людиною, з якою всі хотіли, щоб їх бачили.",shape=box,color=blue];
		418 -> 422;
	425 [label="І принесла мені ванільний торт із ванільною глазур'ю, заввишки в три шари, клянуся.",shape=box,color=blue];
