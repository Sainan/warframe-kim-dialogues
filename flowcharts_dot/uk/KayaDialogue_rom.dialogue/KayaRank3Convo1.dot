	428 [label="Update boolean KayaFlirtPromise",color=orange];
		428 -> 431;
	426 [label="У всякому разі, ця людина спекла мені торт на День народження, але попросила ні з ким не ділитися ним і розрізати його, коли прийду додому. ",shape=box,color=blue];
		426 -> 430;
	432 [label="У мене були хороші оцінки. Навіть відмінні. Ще й капітанка групи підтримки. Було дуже складно отримати запрошення на мій день народження.",shape=box,color=blue];
		432 -> 426;
	431 [label="Гаразд.",shape=box,color=blue];
		431 -> 426;
	430 [label="І, чесно кажучи, це мене збентежило, як і ти спочатку. Але коли я розрізала його, мій ніж вдарився об щось тверде.",shape=box,color=blue];
		430 -> 433;
	433 [label="Огидно, так? Мега огидно. Але коли я придивилася, я побачила щось схоже на пластикову коробку, заховану під тортом і наповнену запечатаними пачками карток «Джинімон». А я їх обожнюю.",shape=box,color=blue];
		433 -> 434;
	434 [label="Але таку круту дівчину, як я, ніколи б не ПОБАЧИЛИ з цими картами в школі. Але ця сором’язлива дитина побачила, якою я є насправді, і підсунула мені справжній подарунок, прикриваючи його тим великим тортом, ніби щоб заробити мою увагу.",shape=box,color=blue];
		434 -> 435;
		434 -> 436;
		434 -> 437;
	435 [label="Я не буду пекти тобі торт.",shape=box,color=red];
		435 -> 438;
	436 [label="Для такого геніального дівчати, тобі знадобилося багато часу, щоб висловити думку…",shape=box,color=red];
		436 -> 439;
	437 [label="І чим саме це нагадує тобі мене?",shape=box,color=red];
		437 -> 440;
	438 [label="+20 Chemistry",color=orange];
		438 -> 441;
	439 [label="А для людини з великого та натхненного майбутнього, ти, безсумнівно, упускаєш сенс. Картки «Джинімон»! І Я! Ти можеш в це повірити? ",shape=box,color=blue];
		439 -> 442;
		439 -> 443;
	440 [label="Здається, це я так кажу, що довіряю тобі, бо я поділилася, що збираю картки «Джинімон». Вони типу для невдах.",shape=box,color=blue];
