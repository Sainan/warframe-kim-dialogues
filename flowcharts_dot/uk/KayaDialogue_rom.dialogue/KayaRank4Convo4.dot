		j2191648484 -> j1347480385;
	j4279939100 [label="Якби «те» можна було пояснити, ми б вирішили багато проблем.",shape=box,color=red];
		j4279939100 -> j1347480385;
	j2181720112 [label="Тобі важко дається філософія?",shape=box,color=red];
		j2181720112 -> j3476852735;
	j1149112592 [label="Попри обставини… якщо до цього дійде, то я передам. ",shape=box,color=red];
