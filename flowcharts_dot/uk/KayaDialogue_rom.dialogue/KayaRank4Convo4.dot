	"KayaRank4Convo4 begins." [color=orange];
		"KayaRank4Convo4 begins." -> j3320380261;
	j3320380261 [label="Здається, у мене є дещо, що може тобі допомогти.",shape=box,color=red];
		j3320380261 -> j369861461;
	j369861461 [label="Я знаю одне місце, я думаю, звідки я насправді. Дувірі.",shape=box,color=red];
		j369861461 -> j1732149752;
	j1732149752 [label="І воно все ще там, хоча мене вже там немає. У Порожнечі.",shape=box,color=red];
		j1732149752 -> j2229035164;
	j2229035164 [label="І система, де є інше дитя, це моє місце.",shape=box,color=red];
		j2229035164 -> j3644050641;
	j3644050641 [label="М-м-м, усі твої сліди справді є ключем до того, куди я можу «безпечно йти».",shape=box,color=blue];
		j3644050641 -> j1156917848;
	j1156917848 [label="Boolean KayaFutureWin1 is now true.",color=orange];
		j1156917848 -> j1876666689;
	j1876666689 [label="Це схоже на великий сяйнистий знак виходу з Порожнечі, коли часточки притягуються до своєї наступної форми.",shape=box,color=blue];
		j1876666689 -> j686204683;
	j686204683 [label="Але вибач, гм, що таке «Дувірі»? Стан матерії? ",shape=box,color=blue];
