	j675032316 [label="Може, я також колись.",shape=box,color=red];
		j675032316 -> j392027042;
	j3314314216 [label="Можливо, але ти ділиш цю планету з іншими, наш вибір впливає на інших, подобається нам це чи ні.",shape=box,color=red];
		j3314314216 -> j3375940257;
	j1367198538 [label="Можливо, саме про це думав Ентраті перед тим, як уперше піти у Порожнечу, а тепер подивись на нас.",shape=box,color=red];
		j1367198538 -> j2441709718;
