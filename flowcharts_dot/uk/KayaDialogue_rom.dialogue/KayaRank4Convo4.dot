	j2236023269 [label="Це я образно, сонця там немає.",shape=box,color=red];
		j2236023269 -> j3666916;
	j64048794 [label="Знатимеш? Існує наукова школа, яка вважає, що спостереження за Дувірі є ключовим фактором до його існування.",shape=box,color=blue];
		j64048794 -> j3608095160;
		j64048794 -> j3946917753;
	j3032855722 [label="Не знаю, скажи щось приємне на моїх похоронах, якщо ти більше ніколи мене не побачиш.",shape=box,color=blue];
		j3032855722 -> j1604408737;
	j3242645381 [label="Ну так, і дай мені знати, якщо можеш допомогти! ",shape=box,color=blue];
