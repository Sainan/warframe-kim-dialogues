		j3946917753 -> j3270229763;
	j1604408737 [label="О, і передай Артуру, що я казала, що він милий, але тільки якщо я зникну назавжди. ",shape=box,color=blue];
		j1604408737 -> j1487584150;
	j1672884174 [label="Я спробую.",shape=box,color=blue];
		j1672884174 -> j392027042;
	j3034421415 [label="Я таких не знаю.",shape=box,color=red];
