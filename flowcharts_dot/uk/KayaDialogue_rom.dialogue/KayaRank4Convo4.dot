	j3666916 [label="Якісь небесні об’єкти?",shape=box,color=blue];
		j3666916 -> j3034421415;
		j3666916 -> j638614414;
	j3608095160 [label="Я не знаю, чи наука може все це пояснити. «Те» є причиною всього цього.",shape=box,color=red];
		j3608095160 -> j169979970;
