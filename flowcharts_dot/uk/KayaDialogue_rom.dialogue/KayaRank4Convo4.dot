	681 [label="Update boolean KayaFutureWin1",color=orange];
		681 -> 682;
	682 [label="Це схоже на великий сяйнистий знак виходу з Порожнечі, коли часточки притягуються до своєї наступної форми.",shape=box,color=blue];
		682 -> 683;
	683 [label="Але вибач, гм, що таке «Дувірі»? Стан матерії? ",shape=box,color=blue];
		683 -> 684;
		683 -> 685;
	684 [label="Це місце, створене мною в Порожнечі.",shape=box,color=red];
		684 -> 686;
	685 [label="Багато в чому це мій справжній дім. Місце… мого зростання.",shape=box,color=red];
