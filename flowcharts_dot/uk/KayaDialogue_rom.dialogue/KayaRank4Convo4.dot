		j4141307779 -> j28748949;
	j3085688253 [label="Коли ми знайдемо Альбрехта, нам доведеться повернути його туди або щось таке. У мене ще немає плану.",shape=box,color=red];
		j3085688253 -> j28748949;
	j1347480385 [label="Що ж, я думаю, було б дуже цікаво відповісти на твою наукову загадк. Сподіваюся, ти знайдеш відповіді.",shape=box,color=blue];
		j1347480385 -> j4018777982;
		j1347480385 -> j675032316;
	j3476852735 [label="Я думаю? Можливо, не зовсім «важко». Тільки кому це цікаво, навіщо чи хто, я просто хочу робити круті речі.",shape=box,color=blue];
		j3476852735 -> j3314314216;
		j3476852735 -> j1367198538;
	j243376796 [label="Дя-а-аки!",shape=box,color=blue];
		j243376796 -> j392027042;
	j3058375404 [label="Та.",shape=box,color=blue];
		j3058375404 -> j243376796;
	j28748949 [label="Ну-у-у, зв’язок, здається, є, але це не в центрі моїх досліджень. Побачимось, якщо побачимось!",shape=box,color=blue];
		j28748949 -> j392027042;
	j4018777982 [label="Я не знаю, чи мені сподобаються відповіді, Ново.",shape=box,color=red];
