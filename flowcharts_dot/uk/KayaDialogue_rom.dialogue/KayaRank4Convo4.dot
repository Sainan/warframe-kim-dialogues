		j686204683 -> j299077913;
	j983359633 [label="Це місце, створене мною в Порожнечі.",shape=box,color=red];
		j983359633 -> j2882225849;
	j299077913 [label="Багато в чому це мій справжній дім. Місце… мого зростання.",shape=box,color=red];
		j299077913 -> j146324364;
	j2882225849 [label="Сповнене втіленнями концепцій, емоцій.",shape=box,color=red];
		j2882225849 -> j2172611339;
	j146324364 [label="Воно в Порожнечі.",shape=box,color=red];
		j146324364 -> j207208915;
	j2172611339 [label="Це, по суті, «підручник», який ожив.",shape=box,color=red];
		j2172611339 -> j37879584;
	j207208915 [label="Проте останнім часом у нас не було багато відвідувачів.",shape=box,color=red];
		j207208915 -> j1826271280;
	j37879584 [label="Ха-ха! Боже. Добре, зрозуміла, і воно точно в Порожнечі?",shape=box,color=blue];
		j37879584 -> j7571913;
	j1826271280 [label="Готуйте червону доріжку, якщо я з’являюся.",shape=box,color=blue];
		j1826271280 -> j3110984164;
		j1826271280 -> j2277675776;
		j1826271280 -> j3653779716;
	j7571913 [label="Так, але воно також тісно пов’язане із «Зарименом».",shape=box,color=red];
		j7571913 -> j2295423707;
	j3110984164 [label="Я не часто туди повертаюся…",shape=box,color=red];
		j3110984164 -> j3408298939;
	j2277675776 [label="Ти справді збираєшся туди?",shape=box,color=red];
		j2277675776 -> j1058958903;
