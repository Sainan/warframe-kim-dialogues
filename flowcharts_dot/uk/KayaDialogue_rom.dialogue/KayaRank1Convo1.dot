digraph {
	0 [label="KayaRank1Convo1 begins.",color=orange];
		0 -> 1;
	1 [label="Вітаю. Чи всі можуть подорожувати в часі, чи тільки ти?",shape=box,color=blue];
		1 -> 2;
		1 -> 3;
	2 [label="І я тебе вітаю. Дивись, дівча, це не так просто.",shape=box,color=red];
		2 -> 4;
	3 [label="Привіт? Кає? Як твій день?",shape=box,color=red];
		3 -> 5;
	4 [label="Я вже не дівча. Мені 19.",shape=box,color=blue];
		4 -> 6;
		4 -> 7;
	5 [label="Нормально. ",shape=box,color=blue];
		5 -> 8;
	6 [label="Гаразд. Але ж ти наймолодша з цієї нової групи, дівча.",shape=box,color=red];
		6 -> 9;
	7 [label="Так-так, але не поспішай копирсатися в подорожах в часі. Це… складно.",shape=box,color=red];
		7 -> 10;
	8 [label="Отже. Тільки ти? Або є інші? Чи вчать подорожі в часі в школах у майбутньому?",shape=box,color=blue];
		8 -> 11;
	9 [label="Ем. Ну так, наймолодша, але також та, хто більше за всіх прагне знайти відповіді. Не відволікайся. Отже: подорожі в часі. Як і хто це робить?",shape=box,color=blue];
		9 -> 12;
	10 [label="Ем. Наскільки складно? Формули? Хімічні та атомні елементи? Я розберусь, тільки вкажи мені напрямок.",shape=box,color=blue];
		10 -> 13;
		10 -> 14;
	11 [label="Скажімо, тільки я. Так буде простіше.",shape=box,color=red];
		11 -> 15;
	12 [label="І чому ти? У тебе є план? ",shape=box,color=blue];
		12 -> 16;
	13 [label="Я справді не знаю, що тобі сказати. Це не просто питання науки. Або, якщо це так, це наука, яку знає Ентраті.",shape=box,color=red];
		13 -> 17;
	14 [label="Ось тобі напрямок: зупинися. [Кінець]",shape=box,color=red];
		14 -> 1022;
	15 [label="Щодо навчань у школі… якщо й так, то я не пам’ятаю. Може і вчать. ",shape=box,color=red];
		15 -> 18;
	16 [label="І якщо ні, що порадиш, щоб я могла знайти будь-які наукові джерела про твої здібності?",shape=box,color=blue];
		16 -> 19;
	17 [label="Ох, той мерзотник. Знала ж, що мала поставити йому більше питань. Добре. Принаймні якщо це наукова проблема, я зможу її відтворити, а оскільки ти можеш приходити та йти, коли заманеться, я зможу з цим розібратися. Бувай.",shape=box,color=blue];
		17 -> 20;
	1022 [label="+20 Chemistry",color=orange];
		1022 -> 1018;
	18 [label="Чого питаєш, хочеш отримати домашку? Тема подорожей у часі, мабуть, буде занадто складна…",shape=box,color=red];
		18 -> 21;
	19 [label="Так багато питань, дівча. Вибачай, але я не знаю. Відповіді є лише в Ентраті.",shape=box,color=red];
		19 -> 22;
	20 [label="+20 Chemistry",color=orange];
		20 -> 1015;
	1018 [label="{\"Id\":1018,\"Incoming\":[1022],\"Outgoing\":[1023],\"GraphPos\":[3236,718],\"CompletionType\":2,\"OtherDialogueInfos\":[{\"Dialogue\":\"/Lotus/Types/Gameplay/1999Wf/Dialogue/HexDialogue_rom.dialogue\",\"Tag\":\"HexKayaConvo1\",\"Value\":0}]}",color=orange];
		1018 -> 1023;
	21 [label="Ем, ти серйозно?",shape=box,color=blue];
		21 -> 24;
	22 [label="Update boolean KayaSetKid",color=orange];
		22 -> 25;
	1015 [label="{\"Id\":1015,\"Incoming\":[20],\"Outgoing\":[23],\"GraphPos\":[3252,817],\"CompletionType\":2,\"OtherDialogueInfos\":[{\"Dialogue\":\"/Lotus/Types/Gameplay/1999Wf/Dialogue/HexDialogue_rom.dialogue\",\"Tag\":\"HexKayaConvo1\",\"Value\":0}]}",color=orange];
		1015 -> 23;
	1023 [label="Chat ends. Next chat will be KayaRank1Convo2.",color=orange];
	24 [label="Хтось із прокльонівців розібрався вже? У них є якась інформація? ",shape=box,color=blue];
		24 -> 26;
		24 -> 27;
	25 [label="Ну ОК.",shape=box,color=blue];
		25 -> 28;
	23 [label="Chat ends. Next chat will be KayaRank1Convo2.",color=orange];
	26 [label="Може, Амір? Він, певне, грав у якісь ігри про подорожі в часі…",shape=box,color=red];
		26 -> 29;
	27 [label="Я не думаю, дівча. Але якщо ти хочеш навчитися чомусь корисному, хай Летті проведе тобі вступне заняття з надання першої допомоги.",shape=box,color=red];
		27 -> 30;
	28 [label="+20 Chemistry",color=orange];
		28 -> 996;
	29 [label="Update boolean KayaAmirTravel",color=orange];
		29 -> 32;
	30 [label="Update boolean KayaLettieHeal",color=orange];
		30 -> 33;
	996 [label="{\"Id\":996,\"Incoming\":[28],\"Outgoing\":[31],\"GraphPos\":[4241,541],\"CompletionType\":2,\"OtherDialogueInfos\":[{\"Dialogue\":\"/Lotus/Types/Gameplay/1999Wf/Dialogue/HexDialogue_rom.dialogue\",\"Tag\":\"HexKayaConvo1\",\"Value\":0}]}",color=orange];
		996 -> 31;
	32 [label="Ігри? Мені просто потрібні відповіді, напрямок, будь-що. Я сама розберусь. Якщо згадаєш щось КОРИСНЕ, знайди мене.",shape=box,color=blue];
		32 -> 34;
	33 [label="То не для мене. Ну й нехай.",shape=box,color=blue];
		33 -> 35;
	31 [label="Chat ends. Next chat will be KayaRank1Convo2.",color=orange];
	34 [label="+20 Chemistry",color=orange];
		34 -> 998;
	35 [label="+20 Chemistry",color=orange];
		35 -> 997;
	998 [label="{\"Id\":998,\"Incoming\":[34],\"Outgoing\":[36],\"GraphPos\":[5087,255],\"CompletionType\":2,\"OtherDialogueInfos\":[{\"Dialogue\":\"/Lotus/Types/Gameplay/1999Wf/Dialogue/HexDialogue_rom.dialogue\",\"Tag\":\"HexKayaConvo1\",\"Value\":0}]}",color=orange];
		998 -> 36;
	997 [label="{\"Id\":997,\"Incoming\":[35],\"Outgoing\":[37],\"GraphPos\":[4970,380],\"CompletionType\":2,\"OtherDialogueInfos\":[{\"Dialogue\":\"/Lotus/Types/Gameplay/1999Wf/Dialogue/HexDialogue_rom.dialogue\",\"Tag\":\"HexKayaConvo1\",\"Value\":0}]}",color=orange];
		997 -> 37;
	36 [label="Chat ends. Next chat will be KayaRank1Convo2.",color=orange];
	37 [label="Chat ends. Next chat will be KayaRank1Convo2.",color=orange];
}