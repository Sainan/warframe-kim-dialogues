digraph {
	"KayaRank1Convo1 begins." [color=orange];
		"KayaRank1Convo1 begins." -> j1990694285;
	j1990694285 [label="Вітаю. Чи всі можуть подорожувати в часі, чи тільки ти?",shape=box,color=blue];
		j1990694285 -> j2486354563;
		j1990694285 -> j2182190913;
	j2486354563 [label="І я тебе вітаю. Дивись, дівча, це не так просто.",shape=box,color=red];
		j2486354563 -> j3356610540;
	j2182190913 [label="Привіт? Кає? Як твій день?",shape=box,color=red];
		j2182190913 -> j2427120614;
	j3356610540 [label="Я вже не дівча. Мені 19.",shape=box,color=blue];
		j3356610540 -> j1295404460;
		j3356610540 -> j35547510;
	j2427120614 [label="Нормально. ",shape=box,color=blue];
		j2427120614 -> j170197270;
	j1295404460 [label="Гаразд. Але ж ти наймолодша з цієї нової групи, дівча.",shape=box,color=red];
		j1295404460 -> j3364831757;
	j35547510 [label="Так-так, але не поспішай копирсатися в подорожах в часі. Це… складно.",shape=box,color=red];
		j35547510 -> j3631190199;
	j170197270 [label="Отже. Тільки ти? Або є інші? Чи вчать подорожі в часі в школах у майбутньому?",shape=box,color=blue];
		j170197270 -> j2604110254;
	j3364831757 [label="Ем. Ну так, наймолодша, але також та, хто більше за всіх прагне знайти відповіді. Не відволікайся. Отже: подорожі в часі. Як і хто це робить?",shape=box,color=blue];
		j3364831757 -> j3108030471;
	j3631190199 [label="Ем. Наскільки складно? Формули? Хімічні та атомні елементи? Я розберусь, тільки вкажи мені напрямок.",shape=box,color=blue];
		j3631190199 -> j1887120336;
		j3631190199 -> j2695564944;
	j2604110254 [label="Скажімо, тільки я. Так буде простіше.",shape=box,color=red];
		j2604110254 -> j2209528834;
	j3108030471 [label="І чому ти? У тебе є план? ",shape=box,color=blue];
		j3108030471 -> j4231645338;
	j1887120336 [label="Я справді не знаю, що тобі сказати. Це не просто питання науки. Або, якщо це так, це наука, яку знає Ентраті.",shape=box,color=red];
		j1887120336 -> j901457991;
	j2695564944 [label="Ось тобі напрямок: зупинися. [Кінець]",shape=box,color=red];
		j2695564944 -> j2938341431;
	j2209528834 [label="Щодо навчань у школі… якщо й так, то я не пам’ятаю. Може і вчать. ",shape=box,color=red];
		j2209528834 -> j2095481971;
	j4231645338 [label="І якщо ні, що порадиш, щоб я могла знайти будь-які наукові джерела про твої здібності?",shape=box,color=blue];
		j4231645338 -> j1104716970;
	j901457991 [label="Ох, той мерзотник. Знала ж, що мала поставити йому більше питань. Добре. Принаймні якщо це наукова проблема, я зможу її відтворити, а оскільки ти можеш приходити та йти, коли заманеться, я зможу з цим розібратися. Бувай.",shape=box,color=blue];
		j901457991 -> j2938341431;
	j2938341431 [label="+20 Chemistry",color=orange];
		j2938341431 -> "Initiate conversation HexKayaConvo1 in /Lotus/Types/Gameplay/1999Wf/Dialogue/HexDialogue_rom.dialogue";
	j2095481971 [label="Чого питаєш, хочеш отримати домашку? Тема подорожей у часі, мабуть, буде занадто складна…",shape=box,color=red];
		j2095481971 -> j2781002264;
	j1104716970 [label="Так багато питань, дівча. Вибачай, але я не знаю. Відповіді є лише в Ентраті.",shape=box,color=red];
		j1104716970 -> j4203413234;
	"Initiate conversation HexKayaConvo1 in /Lotus/Types/Gameplay/1999Wf/Dialogue/HexDialogue_rom.dialogue" [label="Initiate conversation HexKayaConvo1 in /Lotus/Types/Gameplay/1999Wf/Dialogue/HexDialogue_rom.dialogue",color=orange];
		"Initiate conversation HexKayaConvo1 in /Lotus/Types/Gameplay/1999Wf/Dialogue/HexDialogue_rom.dialogue" -> "Chat ends. Next chat will be KayaRank1Convo2.";
	j2781002264 [label="Ем, ти серйозно?",shape=box,color=blue];
		j2781002264 -> j1535428673;
	j4203413234 [label="Boolean KayaSetKid is now true.",color=orange];
		j4203413234 -> j1627568413;
	"Chat ends. Next chat will be KayaRank1Convo2." [color=orange];
	j1535428673 [label="Хтось із прокльонівців розібрався вже? У них є якась інформація? ",shape=box,color=blue];
		j1535428673 -> j1043289048;
		j1535428673 -> j4221863193;
	j1627568413 [label="Ну ОК.",shape=box,color=blue];
		j1627568413 -> j2938341431;
	j1043289048 [label="Може, Амір? Він, певне, грав у якісь ігри про подорожі в часі…",shape=box,color=red];
		j1043289048 -> j3029674864;
	j4221863193 [label="Я не думаю, дівча. Але якщо ти хочеш навчитися чомусь корисному, хай Летті проведе тобі вступне заняття з надання першої допомоги.",shape=box,color=red];
		j4221863193 -> j2994468527;
	j3029674864 [label="Boolean KayaAmirTravel is now true.",color=orange];
		j3029674864 -> j482219388;
	j2994468527 [label="Boolean KayaLettieHeal is now true.",color=orange];
		j2994468527 -> j2352624674;
	j482219388 [label="Ігри? Мені просто потрібні відповіді, напрямок, будь-що. Я сама розберусь. Якщо згадаєш щось КОРИСНЕ, знайди мене.",shape=box,color=blue];
		j482219388 -> j2938341431;
	j2352624674 [label="То не для мене. Ну й нехай.",shape=box,color=blue];
		j2352624674 -> j2938341431;
}