digraph {
	"KayaRank1Convo1 begins." [color=orange];
		"KayaRank1Convo1 begins." -> j1990694285;
	j1990694285 [label="Вітаю. Чи всі можуть подорожувати в часі, чи тільки ти?",shape=box,color=blue];
		j1990694285 -> j2486354563;
		j1990694285 -> j2182190913;
	j2486354563 [label="І я тебе вітаю. Дивись, дівча, це не так просто.",shape=box,color=red];
		j2486354563 -> j3356610540;
	j2182190913 [label="Привіт? Кає? Як твій день?",shape=box,color=red];
		j2182190913 -> j2427120614;
	j3356610540 [label="Я вже не дівча. Мені 19.",shape=box,color=blue];
		j3356610540 -> j3847990286;
		j3356610540 -> j35547510;
	j2427120614 [label="Нормально. ",shape=box,color=blue];
		j2427120614 -> j170197270;
	j3847990286 [label="Гаразд. Але ж ти наймолодша з цієї нової групи, дівча.",shape=box,color=red];
		j3847990286 -> j3036036836;
	j35547510 [label="Так-так, але не поспішай копирсатися в подорожах в часі. Це… складно.",shape=box,color=red];
		j35547510 -> j3631190199;
	j170197270 [label="Отже. Тільки ти? Або є інші? Чи вчать подорожі в часі в школах у майбутньому?",shape=box,color=blue];
		j170197270 -> j2604110254;
	j3036036836 [label="Ем. Ну так, наймолодша, але також та, хто більше за всіх прагне знайти відповіді. Не відволікайся. Отже: подорожі в часі. Як і хто це робить?",shape=box,color=blue];
		j3036036836 -> j1129015066;
	j3631190199 [label="Ем. Наскільки складно? Формули? Хімічні та атомні елементи? Я розберусь, тільки вкажи мені напрямок.",shape=box,color=blue];
		j3631190199 -> j3448318809;
		j3631190199 -> j1865335726;
	j2604110254 [label="Скажімо, тільки я. Так буде простіше.",shape=box,color=red];
		j2604110254 -> j2209528834;
	j1129015066 [label="І чому ти? У тебе є план? ",shape=box,color=blue];
		j1129015066 -> j934660372;
	j3448318809 [label="Я справді не знаю, що тобі сказати. Це не просто питання науки. Або, якщо це так, це наука, яку знає Ентраті.",shape=box,color=red];
		j3448318809 -> j3899260161;
	j1865335726 [label="Ось тобі напрямок: зупинися. [Кінець]",shape=box,color=red];
		j1865335726 -> "Chat ends.";
	j2209528834 [label="Щодо навчань у школі… якщо й так, то я не пам’ятаю. Може і вчать. ",shape=box,color=red];
		j2209528834 -> j2095481971;
	j934660372 [label="І якщо ні, що порадиш, щоб я могла знайти будь-які наукові джерела про твої здібності?",shape=box,color=blue];
		j934660372 -> j3732838856;
	j3899260161 [label="Ох, той мерзотник. Знала ж, що мала поставити йому більше питань. Добре. Принаймні якщо це наукова проблема, я зможу її відтворити, а оскільки ти можеш приходити та йти, коли заманеться, я зможу з цим розібратися. Бувай.",shape=box,color=blue];
		j3899260161 -> j2547432773;
	"Chat ends." [color=orange];
	j2095481971 [label="Чого питаєш, хочеш отримати домашку? Тема подорожей у часі, мабуть, буде занадто складна…",shape=box,color=red];
		j2095481971 -> j2781002264;
	j3732838856 [label="Так багато питань, дівча. Вибачай, але я не знаю. Відповіді є лише в Ентраті.",shape=box,color=red];
		j3732838856 -> j1280640676;
	j2547432773 [label="+20 Chemistry",color=orange];
		j2547432773 -> "Initiate conversation HexKayaConvo1 in HexDialogue_rom.dialogue";
	j2781002264 [label="Ем, ти серйозно?",shape=box,color=blue];
		j2781002264 -> j1535428673;
	j1280640676 [label="Boolean KayaSetKid is now true.",color=orange];
		j1280640676 -> j2789035820;
	"Initiate conversation HexKayaConvo1 in HexDialogue_rom.dialogue" [label="Queue conversation HexKayaConvo1 in HexDialogue_rom.dialogue",color=orange];
		"Initiate conversation HexKayaConvo1 in HexDialogue_rom.dialogue" -> "Chat ends. Next chat will be KayaRank1Convo2.";
	j1535428673 [label="Хтось із прокльонівців розібрався вже? У них є якась інформація? ",shape=box,color=blue];
		j1535428673 -> j3640535818;
		j1535428673 -> j3864890826;
	j2789035820 [label="Ну ОК.",shape=box,color=blue];
		j2789035820 -> j2547432773;
	"Chat ends. Next chat will be KayaRank1Convo2." [color=orange];
	j3640535818 [label="Може, Амір? Він, певне, грав у якісь ігри про подорожі в часі…",shape=box,color=red];
		j3640535818 -> j577790814;
	j3864890826 [label="Я не думаю, дівча. Але якщо ти хочеш навчитися чомусь корисному, хай Летті проведе тобі вступне заняття з надання першої допомоги.",shape=box,color=red];
		j3864890826 -> j2123428324;
	j577790814 [label="Boolean KayaAmirTravel is now true.",color=orange];
		j577790814 -> j3359251398;
	j2123428324 [label="Boolean KayaLettieHeal is now true.",color=orange];
		j2123428324 -> j804572460;
	j3359251398 [label="Ігри? Мені просто потрібні відповіді, напрямок, будь-що. Я сама розберусь. Якщо згадаєш щось КОРИСНЕ, знайди мене.",shape=box,color=blue];
		j3359251398 -> j2547432773;
	j804572460 [label="То не для мене. Ну й нехай.",shape=box,color=blue];
		j804572460 -> j2547432773;
}