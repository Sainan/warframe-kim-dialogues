digraph {
	"KayaRank3Convo2 begins." [color=orange];
		"KayaRank3Convo2 begins." -> j3475518340;
	j3475518340 [label="Видно, тебе дуже цікавлять «подорожі в часі». Насправді ти ніби одержима.",shape=box,color=red];
		j3475518340 -> j3752229493;
	j3752229493 [label="Досі працюю над ними. Але вже близька.",shape=box,color=blue];
		j3752229493 -> j2535758098;
	j2535758098 [label="Після того, як ти розберешся з подорожами у часі, виникне більша проблема. Етерналізм. ",shape=box,color=red];
		j2535758098 -> j1461801830;
	j1461801830 [label="Ем… що?",shape=box,color=blue];
		j1461801830 -> j2391507614;
		j1461801830 -> j3513852988;
	j2391507614 [label="Перевірмо, чи ти достатньо розумна, щоби це зрозуміти. Завдяки етерналізму існує версія цієї розмови, яка тут не закінчується. [Кінець]",shape=box,color=red];
		j2391507614 -> j3655577789;
	j3513852988 [label="Сподіваюся, ти не зайнята, бо це справжня причина, чому я тут.",shape=box,color=red];
		j3513852988 -> j2015416363;
	j3655577789 [label="Boolean KayaEternalismTest is now true.",color=orange];
		j3655577789 -> j2156753723;
	j2015416363 [label="Я не зайнята, поясни, будь ласка. Це може неймовірно допомогти з остаточними теоретичними нюансами щодо часових маніпуляцій.",shape=box,color=blue];
		j2015416363 -> j1150960601;
	j2156753723 [label="+20 Chemistry",color=orange];
		j2156753723 -> "Chat ends. Next chat will be KayaRank3Convo3.";
	j1150960601 [label="Усе це сталося не тому, що якийсь вчений вивів формулу.",shape=box,color=red];
		j1150960601 -> j2159958310;
	"Chat ends. Next chat will be KayaRank3Convo3." [color=orange];
	j2159958310 [label="Ну, гадаю, так все почалося.",shape=box,color=red];
		j2159958310 -> j476911537;
	j476911537 [label="Але все це зараз? Уже значно більше. Все тому, що Альбрехт кудись пішов, щось розбудив, і воно пішло за ним назад. Порожнеча.",shape=box,color=red];
		j476911537 -> j314802014;
		j476911537 -> j1686848084;
	j314802014 [label="Порожнеча і жива, і ні. Це так, але це теж не так. Це парадокс, джерело та причина всього, що сталося з кожним із нас.",shape=box,color=red];
		j314802014 -> j1643173148;
	j1686848084 [label="Немає «періодичної таблиці» чи формули для того, що це.",shape=box,color=red];
		j1686848084 -> j1358402568;
	j1643173148 [label="Hello World.",shape=box,color=blue];
		j1643173148 -> j1667669857;
		j1643173148 -> j3149752903;
	j1358402568 [label="Наука може це пояснити. Воно панує над усім.",shape=box,color=blue];
		j1358402568 -> j3668359530;
	j1667669857 [label="«Прощавай, Альбрехт»",shape=box,color=red];
		j1667669857 -> j2641755675;
	j3149752903 [label="Га?",shape=box,color=red];
		j3149752903 -> j375380201;
	j3668359530 [label="Check boolean KayaVoidTest",color=orange];
		j3668359530 -> j3460595123 [label=true,color=green];
		j3668359530 -> j956458622 [label=false,color=brown];
	j2641755675 [label="+5 Chemistry",color=orange];
		j2641755675 -> j3328718683;
	j375380201 [label="Це була перша фраза, яка з'явилася в інтернеті. Перше повідомлення. Опубліковане творцем інтернету, щоби показати, що це «спрацювало».",shape=box,color=blue];
		j375380201 -> j2507144957;
	j3460595123 [label="Ось чому я кажу тобі бути обережною з Порожнечею.",shape=box,color=red];
		j3460595123 -> j1826093919;
	j956458622 [label="А що, як ні?",shape=box,color=red];
		j956458622 -> j2697069076;
	j3328718683 [label="Ха! Якби ж то. Але чи знаєш ти про «Hello World»?",shape=box,color=blue];
		j3328718683 -> j375380201;
	j2507144957 [label="Тоді й почалося все пекло. Люди БОЖЕВОЛІЛИ. Наука, економіка, технології, розваги.",shape=box,color=blue];
		j2507144957 -> j2710101680;
	j1826093919 [label="Деякі речі не можна контролювати.",shape=box,color=red];
		j1826093919 -> j2928009707;
	j2697069076 [label="Що, як все, що для тебе було сталими правилами…",shape=box,color=red];
		j2697069076 -> j1127575527;
	j2710101680 [label="І через мільярди варіантів, причин і наслідків, одного дня я вийшла в інтернет і… ",shape=box,color=blue];
		j2710101680 -> j2735433858;
	j2928009707 [label="Деякі речі не можна пояснити.",shape=box,color=red];
		j2928009707 -> j2084357525;
	j1127575527 [label="відбулося лише тому, що щось там захотіло цього.",shape=box,color=red];
		j1127575527 -> j2084357525;
	j2735433858 [label="І це був кінець для Нови, точніше Каї. Її майбутнє, її кар'єра, її друзі, все. Через одну помилку. ",shape=box,color=blue];
		j2735433858 -> j905396846;
	j2084357525 [label="Ти хочеш сказати, що в моїх експериментах, тестах, дослідженнях і гіпотезах не вистачає «магії».",shape=box,color=blue];
		j2084357525 -> j1030537592;
		j2084357525 -> j1041293025;
	j905396846 [label="Тож, мабуть, я довіряю Порожнечі більше, ніж людям.",shape=box,color=blue];
		j905396846 -> j2926468934;
		j905396846 -> j3404667505;
		j905396846 -> j328219011;
	j1030537592 [label="Не магія. А просто… Порожнеча. Порожнеча. Енергія звідкись.",shape=box,color=red];
		j1030537592 -> j2970430458;
	j1041293025 [label="Ти бачила, що я можу робити? ",shape=box,color=red];
		j1041293025 -> j172223710;
	j2926468934 [label="Краще не треба. [Кінець]",shape=box,color=red];
		j2926468934 -> j2156753723;
	j3404667505 [label="Як похмуро, Ново.",shape=box,color=red];
		j3404667505 -> j1140919345;
	j328219011 [label="У мене теж була така довіра.",shape=box,color=red];
		j328219011 -> j1140919345;
	j2970430458 [label="З цим я можу працювати.",shape=box,color=blue];
		j2970430458 -> j2485443493;
		j2970430458 -> j379000247;
	j172223710 [label="Бачила. Спостерігала. Робила позначки. Вивчала. Вивчала наново. М-м-м. Це все можна пояснити. Це в чомусь вкорінене. Можливо, це «магія».",shape=box,color=blue];
		j172223710 -> j2970430458;
	j1140919345 [label="Я припускаю, що, можливо, ти не зовсім розумієш. ",shape=box,color=blue];
		j1140919345 -> j1729309388;
	j2485443493 [label="Якщо ти зробиш щось необдумане, це може коштувати тобі всього.",shape=box,color=red];
		j2485443493 -> j1140919345;
	j379000247 [label="Можеш «працювати»?",shape=box,color=red];
		j379000247 -> j1140919345;
	j1729309388 [label="Але я втічу з 1999.",shape=box,color=blue];
		j1729309388 -> j2894028690;
	j2894028690 [label="Мені буквально байдуже, що станеться зі мною на шляху.",shape=box,color=blue];
		j2894028690 -> j1006947482;
	j1006947482 [label="Це єдине, про що я думаю.",shape=box,color=blue];
		j1006947482 -> j3448629326;
	j3448629326 [label="І для мене це добре. ",shape=box,color=blue];
		j3448629326 -> j2156753723;
}