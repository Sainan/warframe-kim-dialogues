digraph {
	460 [label="KayaRank3Convo2 begins.",color=orange];
		460 -> 461;
	461 [label="Видно, тебе дуже цікавлять «подорожі в часі». Насправді ти ніби одержима.",shape=box,color=red];
		461 -> 462;
	462 [label="Досі працюю над ними. Але вже близька.",shape=box,color=blue];
		462 -> 463;
	463 [label="Після того, як ти розберешся з подорожами у часі, виникне більша проблема. Етерналізм. ",shape=box,color=red];
		463 -> 464;
	464 [label="Ем… що?",shape=box,color=blue];
		464 -> 465;
		464 -> 466;
	465 [label="Перевірмо, чи ти достатньо розумна, щоб це зрозуміти. Завдяки етерналізму існує версія цієї розмови, яка тут не закінчується. [Кінець]",shape=box,color=red];
		465 -> 467;
	466 [label="Сподіваюся, ти не зайнята, бо це справжня причина, чому я тут.",shape=box,color=red];
		466 -> 468;
	467 [label="Update boolean KayaEternalismTest",color=orange];
		467 -> 469;
	468 [label="Я не зайнята, поясни, будь ласка. Це може неймовірно допомогти з остаточними теоретичними нюансами щодо часових маніпуляцій.",shape=box,color=blue];
		468 -> 470;
	469 [label="+20 Chemistry",color=orange];
		469 -> 471;
	470 [label="Усе це сталося не тому, що якийсь Учений вивів формулу.",shape=box,color=red];
		470 -> 472;
	471 [label="Chat ends. Next chat will be KayaRank3Convo3.",color=orange];
	472 [label="Ну, гадаю, так усе почалося.",shape=box,color=red];
		472 -> 473;
	473 [label="Але все це зараз? Уже значно більше. Усе тому, що Альбрехт кудись пішов, щось розбудив, і воно пішло за ним назад. Порожнеча.",shape=box,color=red];
		473 -> 474;
		473 -> 475;
	474 [label="Порожнеча і жива, і ні. Це так, але це теж не так. Це парадокс, джерело та причина всього, що сталося з кожним із нас.",shape=box,color=red];
		474 -> 476;
	475 [label="Немає «періодичної таблиці» чи формули для того, що це.",shape=box,color=red];
		475 -> 477;
	476 [label="Hello World.",shape=box,color=blue];
		476 -> 478;
		476 -> 479;
	477 [label="Наука може це пояснити. Вона панує над усім.",shape=box,color=blue];
		477 -> 480;
	478 [label="«Прощавай, Альбрехт».",shape=box,color=red];
		478 -> 481;
	479 [label="Га?",shape=box,color=red];
		479 -> 482;
	480 [label="Check boolean KayaVoidTest",color=orange];
		480 -> 484 [label=true,color=green];
		480 -> 483 [label=false,color=brown];
	481 [label="+5 Chemistry",color=orange];
		481 -> 485;
	482 [label="Це була перша фраза, яка з'явилася в інтернеті. Перше повідомлення. Опубліковане творцем інтернету, щоби показати, що це «спрацювало».",shape=box,color=blue];
		482 -> 486;
	484 [label="Ось чому я кажу тобі бути обережною з Порожнечею.",shape=box,color=red];
		484 -> 488;
	483 [label="А що, як ні?",shape=box,color=red];
		483 -> 487;
	485 [label="Ха! Якби ж то. Але чи знаєш ти про «Hello World»?",shape=box,color=blue];
		485 -> 482;
	486 [label="Тоді й почалося все пекло. Люди БОЖЕВОЛІЛИ. Наука, економіка, технології, розваги.",shape=box,color=blue];
		486 -> 489;
	488 [label="Деякі речі не можна контролювати.",shape=box,color=red];
		488 -> 491;
	487 [label="Що, як усе, що для тебе було сталими правилами…",shape=box,color=red];
		487 -> 490;
	489 [label="І через мільярди варіантів, причин і наслідків, одного дня я вийшла в інтернет і… ",shape=box,color=blue];
		489 -> 492;
	491 [label="Деякі речі не можна пояснити.",shape=box,color=red];
		491 -> 493;
	490 [label="відбулося лише тому, що щось там захотіло цього.",shape=box,color=red];
		490 -> 493;
	492 [label="І це був кінець для Нови, точніше Каї. Її майбутнє, її кар'єра, її друзі, усе. Через одну помилку. ",shape=box,color=blue];
		492 -> 494;
	493 [label="Ти хочеш сказати, що в моїх експериментах, тестах, дослідженнях і гіпотезах не вистачає «чарів».",shape=box,color=blue];
		493 -> 495;
		493 -> 496;
	494 [label="Тож, мабуть, я довіряю Порожнечі більше, ніж людям.",shape=box,color=blue];
		494 -> 497;
		494 -> 498;
		494 -> 499;
	495 [label="Не магія. А просто… Порожнеча. Порожнеча. Енергія звідкись.",shape=box,color=red];
		495 -> 500;
	496 [label="Ти бачила, що я можу робити? ",shape=box,color=red];
		496 -> 501;
	497 [label="Краще не треба. [Кінець]",shape=box,color=red];
		497 -> 502;
	498 [label="Як похмуро, Ново.",shape=box,color=red];
		498 -> 503;
	499 [label="У мене теж була така довіра.",shape=box,color=red];
		499 -> 503;
	500 [label="З цим я можу працювати.",shape=box,color=blue];
		500 -> 504;
		500 -> 505;
	501 [label="Бачила. Спостерігала. Робила позначки. Вивчала. Вивчала наново. М-м-м. Це все можна пояснити. Це в чомусь вкорінене. Можливо, це «чари».",shape=box,color=blue];
		501 -> 506;
	502 [label="+20 Chemistry",color=orange];
		502 -> 507;
	503 [label="Я припускаю, що, можливо, ти не зовсім розумієш. ",shape=box,color=blue];
		503 -> 508;
	504 [label="Якщо ти зробиш щось необдумане, це може коштувати тобі всього.",shape=box,color=red];
		504 -> 503;
	505 [label="Можеш «працювати»?",shape=box,color=red];
		505 -> 503;
	506 [label="З цим я можу працювати.",shape=box,color=blue];
		506 -> 504;
		506 -> 505;
	507 [label="Chat ends. Next chat will be KayaRank3Convo3.",color=orange];
	508 [label="Але я втечу з 1999-го.",shape=box,color=blue];
		508 -> 509;
	509 [label="Мені буквально байдуже, що станеться зі мною на шляху.",shape=box,color=blue];
		509 -> 510;
	510 [label="Це єдине, про що я думаю.",shape=box,color=blue];
		510 -> 511;
	511 [label="І для мене це добре. ",shape=box,color=blue];
		511 -> 512;
	512 [label="+20 Chemistry",color=orange];
		512 -> 513;
	513 [label="Chat ends. Next chat will be KayaRank3Convo3.",color=orange];
}