digraph {
	"KayaRank3Convo2 begins." [color=orange];
		"KayaRank3Convo2 begins." -> j3475518340;
	j3475518340 [label="Видно, тебе дуже цікавлять «подорожі в часі». Насправді ти ніби одержима.",shape=box,color=red];
		j3475518340 -> j3752229493;
	j3752229493 [label="Досі працюю над ними. Але вже близька.",shape=box,color=blue];
		j3752229493 -> j2535758098;
	j2535758098 [label="Після того, як ти розберешся з подорожами у часі, виникне більша проблема. Етерналізм. ",shape=box,color=red];
		j2535758098 -> j1461801830;
	j1461801830 [label="Ем… що?",shape=box,color=blue];
		j1461801830 -> j3171298146;
		j1461801830 -> j3368140780;
	j3171298146 [label="Перевірмо, чи ти достатньо розумна, щоб це зрозуміти. Завдяки етерналізму існує версія цієї розмови, яка тут не закінчується. [Кінець]",shape=box,color=red];
		j3171298146 -> j3655577789;
	j3368140780 [label="Сподіваюся, ти не зайнята, бо це справжня причина, чому я тут.",shape=box,color=red];
		j3368140780 -> j562283435;
	j3655577789 [label="Boolean KayaEternalismTest is now true.",color=orange];
		j3655577789 -> j2156753723;
	j562283435 [label="Я не зайнята, поясни, будь ласка. Це може неймовірно допомогти з остаточними теоретичними нюансами щодо часових маніпуляцій.",shape=box,color=blue];
		j562283435 -> j357490121;
	j2156753723 [label="+20 Chemistry",color=orange];
		j2156753723 -> "Chat ends. Next chat will be KayaRank3Convo3.";
	j357490121 [label="Усе це сталося не тому, що якийсь Учений вивів формулу.",shape=box,color=red];
		j357490121 -> j759351629;
	"Chat ends. Next chat will be KayaRank3Convo3." [color=orange];
	j759351629 [label="Ну, гадаю, так усе почалося.",shape=box,color=red];
		j759351629 -> j2340987325;
	j2340987325 [label="Але все це зараз? Уже значно більше. Усе тому, що Альбрехт кудись пішов, щось розбудив, і воно пішло за ним назад. Порожнеча.",shape=box,color=red];
		j2340987325 -> j314802014;
		j2340987325 -> j1544546970;
	j314802014 [label="Порожнеча і жива, і ні. Це так, але це теж не так. Це парадокс, джерело та причина всього, що сталося з кожним із нас.",shape=box,color=red];
		j314802014 -> j1643173148;
	j1544546970 [label="Немає «періодичної таблиці» чи формули для того, що це.",shape=box,color=red];
		j1544546970 -> j2772819908;
	j1643173148 [label="Hello World.",shape=box,color=blue];
		j1643173148 -> j3062365022;
		j1643173148 -> j3783624804;
	j2772819908 [label="Наука може це пояснити. Вона панує над усім.",shape=box,color=blue];
		j2772819908 -> j3668359530;
	j3062365022 [label="«Прощавай, Альбрехт».",shape=box,color=red];
		j3062365022 -> j1079990579;
	j3783624804 [label="Га?",shape=box,color=red];
		j3783624804 -> j1991240319;
	j3668359530 [label="Check boolean KayaVoidTest",color=orange];
		j3668359530 -> j478292550 [label=true,color=green];
		j3668359530 -> j1645411498 [label=false,color=brown];
	j1079990579 [label="+5 Chemistry",color=orange];
		j1079990579 -> j1477741795;
	j1991240319 [label="Це була перша фраза, яка з'явилася в інтернеті. Перше повідомлення. Опубліковане творцем інтернету, щоби показати, що це «спрацювало».",shape=box,color=blue];
		j1991240319 -> j2348956091;
	j478292550 [label="Ось чому я кажу тобі бути обережною з Порожнечею.",shape=box,color=red];
		j478292550 -> j4243376483;
	j1645411498 [label="А що, як ні?",shape=box,color=red];
		j1645411498 -> j1030014593;
	j1477741795 [label="Ха! Якби ж то. Але чи знаєш ти про «Hello World»?",shape=box,color=blue];
		j1477741795 -> j1991240319;
	j2348956091 [label="Тоді й почалося все пекло. Люди БОЖЕВОЛІЛИ. Наука, економіка, технології, розваги.",shape=box,color=blue];
		j2348956091 -> j871880548;
	j4243376483 [label="Деякі речі не можна контролювати.",shape=box,color=red];
		j4243376483 -> j65956900;
	j1030014593 [label="Що, як усе, що для тебе було сталими правилами…",shape=box,color=red];
		j1030014593 -> j2676726169;
	j871880548 [label="І через мільярди варіантів, причин і наслідків, одного дня я вийшла в інтернет і… ",shape=box,color=blue];
		j871880548 -> j3610109425;
	j65956900 [label="Деякі речі не можна пояснити.",shape=box,color=red];
		j65956900 -> j4123820188;
	j2676726169 [label="відбулося лише тому, що щось там захотіло цього.",shape=box,color=red];
		j2676726169 -> j4123820188;
	j3610109425 [label="І це був кінець для Нови, точніше Каї. Її майбутнє, її кар'єра, її друзі, усе. Через одну помилку. ",shape=box,color=blue];
		j3610109425 -> j905396846;
	j4123820188 [label="Ти хочеш сказати, що в моїх експериментах, тестах, дослідженнях і гіпотезах не вистачає «чарів».",shape=box,color=blue];
		j4123820188 -> j1030537592;
		j4123820188 -> j340962025;
	j905396846 [label="Тож, мабуть, я довіряю Порожнечі більше, ніж людям.",shape=box,color=blue];
		j905396846 -> j2926468934;
		j905396846 -> j1135770349;
		j905396846 -> j186211665;
	j1030537592 [label="Не магія. А просто… Порожнеча. Порожнеча. Енергія звідкись.",shape=box,color=red];
		j1030537592 -> j2970430458;
	j340962025 [label="Ти бачила, що я можу робити? ",shape=box,color=red];
		j340962025 -> j2646486843;
	j2926468934 [label="Краще не треба. [Кінець]",shape=box,color=red];
		j2926468934 -> j2156753723;
	j1135770349 [label="Як похмуро, Ново.",shape=box,color=red];
		j1135770349 -> j3796941947;
	j186211665 [label="У мене теж була така довіра.",shape=box,color=red];
		j186211665 -> j3796941947;
	j2970430458 [label="З цим я можу працювати.",shape=box,color=blue];
		j2970430458 -> j2362918460;
		j2970430458 -> j144561535;
	j2646486843 [label="Бачила. Спостерігала. Робила позначки. Вивчала. Вивчала наново. М-м-м. Це все можна пояснити. Це в чомусь вкорінене. Можливо, це «чари».",shape=box,color=blue];
		j2646486843 -> j2970430458;
	j3796941947 [label="Я припускаю, що, можливо, ти не зовсім розумієш. ",shape=box,color=blue];
		j3796941947 -> j703287314;
	j2362918460 [label="Якщо ти зробиш щось необдумане, це може коштувати тобі всього.",shape=box,color=red];
		j2362918460 -> j3796941947;
	j144561535 [label="Можеш «працювати»?",shape=box,color=red];
		j144561535 -> j3796941947;
	j703287314 [label="Але я втечу з 1999-го.",shape=box,color=blue];
		j703287314 -> j2894028690;
	j2894028690 [label="Мені буквально байдуже, що станеться зі мною на шляху.",shape=box,color=blue];
		j2894028690 -> j1006947482;
	j1006947482 [label="Це єдине, про що я думаю.",shape=box,color=blue];
		j1006947482 -> j3448629326;
	j3448629326 [label="І для мене це добре. ",shape=box,color=blue];
		j3448629326 -> j2156753723;
}