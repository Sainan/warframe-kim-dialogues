digraph {
	"KayaRank5Convo1 begins." [color=orange];
		"KayaRank5Convo1 begins." -> j781199353;
	j781199353 [label="Я постійно знаходжу ці фіолетові припаси, але наступного дня їх уже немає.",shape=box,color=blue];
		j781199353 -> j105662481;
	j105662481 [label="І я думаю, що є якась причина для їхнього розпаду.",shape=box,color=blue];
		j105662481 -> j559834729;
	j559834729 [label="Оскільки їхня матерія не просто розпадається на нові ізотопи.",shape=box,color=blue];
		j559834729 -> j4288893535;
	j4288893535 [label="Воно фактично зникає ЗВІДСИ.",shape=box,color=blue];
		j4288893535 -> j625578590;
		j4288893535 -> j3986148213;
	j625578590 [label="Ти про кріотик?",shape=box,color=red];
		j625578590 -> j3097658256;
	j3986148213 [label="Ти про кристали аргону? ",shape=box,color=red];
		j3986148213 -> j2846395567;
	j3097658256 [label="М-м-м, ні, не про них.",shape=box,color=blue];
		j3097658256 -> j3986148213;
		j3097658256 -> j1638503307;
	j2846395567 [label="Це, мабуть, воно!",shape=box,color=blue];
		j2846395567 -> j2697765520;
	j1638503307 [label="Ти про орокінські акумулятори?",shape=box,color=red];
		j1638503307 -> j3072519970;
	j2697765520 [label="Чи є спосіб зберегти їх там, звідки ти?",shape=box,color=blue];
		j2697765520 -> j1119541190;
		j2697765520 -> j898686230;
	j3072519970 [label="М-м-м, ні, точно не вони.",shape=box,color=blue];
		j3072519970 -> j844040631;
		j3072519970 -> j2467406446;
	j1119541190 [label="Вони завжди зникають, щойно принести їх із Порожнечі.",shape=box,color=red];
		j1119541190 -> j3943809942;
	j898686230 [label="Ніколи, мені завжди думалося, що вони просто розпадаються. ",shape=box,color=red];
		j898686230 -> j3943809942;
	j844040631 [label="Ти про рубедо?",shape=box,color=red];
		j844040631 -> j2803638486;
	j2467406446 [label="Ти про кристали аргону?",shape=box,color=red];
		j2467406446 -> j2846395567;
	j3943809942 [label="Ну, тоді це так — вони інертні в Порожнечі.",shape=box,color=blue];
		j3943809942 -> j3744462968;
	j2803638486 [label="Не думаю. Але якщо ми не знайдемо що це, я, можливо, ніколи не розв'яжу проблему.",shape=box,color=blue];
		j2803638486 -> j4119919965;
		j2803638486 -> j2467406446;
	j3744462968 [label="І як тільки вони залишають Порожнечу, вони повертаються в неї назад. Вони не розпадаються на нову матерію.",shape=box,color=blue];
		j3744462968 -> j3019709127;
	j4119919965 [label="Ти про наноспори?",shape=box,color=red];
		j4119919965 -> j3351974740;
	j3019709127 [label="Вони повертаються назад у Порожнечу. Порожнеча всюди, кличе їх назад до себе.",shape=box,color=blue];
		j3019709127 -> j221969447;
	j3351974740 [label="Е-е, ні, мій останній зразок теж зник. Я… тьху. Я мушу йти.",shape=box,color=blue];
		j3351974740 -> j515357550;
	j221969447 [label="Boolean KayaFutureWin2 is now true.",color=orange];
		j221969447 -> j2774630057;
		j221969447 -> j2374891258;
	j515357550 [label="Не думаю, що впораюся.",shape=box,color=blue];
		j515357550 -> j4123196853;
	j2774630057 [label="Це допоможе тобі драпнути з 1999-го? Плануєш сховатися у Порожнечі? Не рекомендую.",shape=box,color=red];
		j2774630057 -> j3949955977;
	j2374891258 [label="Ця інформація важлива для твоєї роботи?",shape=box,color=red];
		j2374891258 -> j4082839942;
	j4123196853 [label="+20 Chemistry",color=orange];
		j4123196853 -> "Chat ends. Next chat will be KayaRank5Convo2.";
	j3949955977 [label="Це більше про стани матерії та теорію про те, що Порожнеча не є «лінійною», як ми її розуміємо. Тому я можу використовувати її як батут, щоб ефективно слідувати за ТОБОЮ.",shape=box,color=blue];
		j3949955977 -> j778104272;
	j4082839942 [label="Дуже-дуже-дуже! Це означає, що існує зв’язок між матерією в ПОРОЖНЕЧІ та ЦИМ МІСЦЕМ. Атоми, матерія, вони ПОСЛІДОВНІ в обох місцях.",shape=box,color=blue];
		j4082839942 -> j3136457193;
	"Chat ends. Next chat will be KayaRank5Convo2." [color=orange];
	j778104272 [label="Чекай, слідувати за мною? ",shape=box,color=red];
		j778104272 -> j1966090855;
	j3136457193 [label="Порожнеча не є «лінійною», як ми її розуміємо. Тому я можу використовувати її як батут, щоб ефективно слідувати за ТОБОЮ.",shape=box,color=blue];
		j3136457193 -> j778104272;
	j1966090855 [label="Ага, скільки б разів я не тестувала рівняння, мені, так би мовити, завжди бракує «маяка». Стрибку на батуті треба точку приземлення, і якщо ти хоча б один раз повернешся назад, цього має бути достатньо для калібрування. ",shape=box,color=blue];
		j1966090855 -> j3466633774;
		j1966090855 -> j1314326938;
	j3466633774 [label="Сподіваюся, ти можеш робити сальто назад! Наближається один маяк. ",shape=box,color=red];
		j3466633774 -> j1920526186;
	j1314326938 [label="Йой, я не знаю, чи мені це подобається. Що, як ти застрягнеш або загубишся?! ",shape=box,color=red];
		j1314326938 -> j1563919264;
	j1920526186 [label="Я поки не готова. Сім разів відміряй, один раз відріж. А краще, відміряй… 1 000 разів. ",shape=box,color=blue];
		j1920526186 -> j3866412078;
		j1920526186 -> j406449898;
	j1563919264 [label="Я не застрягну.",shape=box,color=blue];
		j1563919264 -> j1419842331;
	j3866412078 [label="Розсудливо, для науки важлива впевненість.",shape=box,color=red];
		j3866412078 -> j278647868;
	j406449898 [label="Спробуймо! Що вагатися, зробімо це зараз! ",shape=box,color=red];
		j406449898 -> j2734382187;
	j1419842331 [label="Усе можливо.",shape=box,color=red];
		j1419842331 -> j3912867764;
	j278647868 [label="А я тебе добре навчила.",shape=box,color=blue];
		j278647868 -> j3197248878;
		j278647868 -> j1594231945;
	j2734382187 [label="Ти що, ні-ні, я не готова! Не можна поспішати!",shape=box,color=blue];
		j2734382187 -> j774372513;
	j3912867764 [label="Та ні.",shape=box,color=blue];
		j3912867764 -> j2511323656;
		j3912867764 -> j1498483421;
	j3197248878 [label="Розмріялася! ",shape=box,color=red];
		j3197248878 -> j4123196853;
	j1594231945 [label="О, звісно, ти чудова вчителька. Хоча єдине, що потрапляло мені в око, це як ти вчила Мінерву новим пияцьким іграм.",shape=box,color=red];
		j1594231945 -> j3857523871;
	j774372513 [label="До-о-обре, здається, ти розумієш, наскільки це може бути небезпечно. Чудово.",shape=box,color=red];
		j774372513 -> j3611912034;
	j2511323656 [label="Йой…",shape=box,color=red];
		j2511323656 -> j222979257;
	j1498483421 [label="Але… це можливо.",shape=box,color=red];
		j1498483421 -> j222979257;
	j3857523871 [label="Мінерва з похмілля небезпечніша за подорожі в часі. ТІКАЙ!",shape=box,color=blue];
		j3857523871 -> j4123196853;
	j3611912034 [label="Мінерва з похмілля набагато небезпечніша. ТІКАЙ!",shape=box,color=blue];
		j3611912034 -> j4123196853;
	j222979257 [label="Ти мене знайдеш.",shape=box,color=blue];
		j222979257 -> j1976486442;
	j1976486442 [label="Не перекладай на мене…",shape=box,color=red];
		j1976486442 -> j1922707496;
	j1922707496 [label="Шляху назад немає!",shape=box,color=blue];
		j1922707496 -> j4123196853;
}