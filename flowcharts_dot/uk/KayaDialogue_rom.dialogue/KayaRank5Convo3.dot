	"KayaRank5Convo3 begins." [color=orange];
		"KayaRank5Convo3 begins." -> j3911963843;
	j3911963843 [label="О-о-о, вітаннячко, чи можу я розповісти трохи про основи КАРТОК ДЖИНІМОН?",shape=box,color=blue];
		j3911963843 -> j1587322418;
	j1587322418 [label="Амір у захваті, що йому нарешті є з ким грати (і кому програвати).",shape=box,color=blue];
		j1587322418 -> j2703255282;
	j2703255282 [label="Але ми обидва подумали, що було б цікаво залучити також і тебе до гри в Джинімон. ",shape=box,color=blue];
		j2703255282 -> j809552131;
		j2703255282 -> j1720824467;
		j2703255282 -> j1917669769;
	j809552131 [label="Ви грайте. У мене багато справ. [Завершити розмову]",shape=box,color=red];
		j809552131 -> j145506587;
	j1720824467 [label="У мене кілька голарів завалялося в кишені, то з чого почнемо?",shape=box,color=red];
		j1720824467 -> j3137935661;
	j1917669769 [label="Нагадай мені… про що ми зараз говоримо?",shape=box,color=red];
		j1917669769 -> j1149063342;
	j145506587 [label="+20 Chemistry",color=orange];
		j145506587 -> "Chat ends. Next chat will be KayaRank5Convo4.";
	j3137935661 [label="О-о-о, ну добре! Що ж. Спочатку почнімо з тебе. Ти бачиш себе більше Драконом, Орлом чи Пантерою?",shape=box,color=blue];
		j3137935661 -> j2409968335;
		j3137935661 -> j3557988426;
		j3137935661 -> j2359947112;
	j1149063342 [label="Лише про НАЙПОПУЛЯРНІШЕ шоу, гру, колекціонку 1999!",shape=box,color=blue];
		j1149063342 -> j2998471072;
	"Chat ends. Next chat will be KayaRank5Convo4." [color=orange];
	j2409968335 [label="Пантерою.",shape=box,color=red];
		j2409968335 -> j1649172476;
	j3557988426 [label="Орлом.",shape=box,color=red];
		j3557988426 -> j3091939091;
	j2359947112 [label="Драконом.",shape=box,color=red];
		j2359947112 -> j2773813177;
	j2998471072 [label="Знаєш, із суперкрутими персонажами й істотами…",shape=box,color=blue];
		j2998471072 -> j3103560677;
	j1649172476 [label="Добре, тоді ти АБСОЛЮТНО точно захочеш почати гру з Тейлали.",shape=box,color=blue];
		j1649172476 -> j3238880413;
	j3091939091 [label="Добре, тоді ти ОБОВ'ЯЗКОВО точно захочеш почати гру з Пламберта.",shape=box,color=blue];
		j3091939091 -> j1054522756;
	j2773813177 [label="Добре, тоді ти МОЖЛИВО захочеш почати гру з Фроґобоґо.",shape=box,color=blue];
		j2773813177 -> j2713355412;
	j3103560677 [label="Але суть не в цьому. Почнімо з тебе. Ти бачиш себе більше Драконом, Орлом чи Пантерою?",shape=box,color=blue];
		j3103560677 -> j2409968335;
		j3103560677 -> j3557988426;
		j3103560677 -> j2359947112;
	j3238880413 [label="Це найкрутіший варіант, але він точно складний і дуже слабкий на початку.",shape=box,color=blue];
		j3238880413 -> j2014538318;
	j1054522756 [label="Трохи складний варіант, але дуже крутий. ",shape=box,color=blue];
		j1054522756 -> j3653948149;
	j2713355412 [label="Що є чудовим вибором для новачків. ",shape=box,color=blue];
		j2713355412 -> j1193031741;
	j2014538318 [label="Але наприкінці? Ти матимеш найрозкішнішу та найвеличнішу пантеру.",shape=box,color=blue];
		j2014538318 -> j2930401109;
	j3653948149 [label="І Пламберт надзвичайно милий, тому що ти можеш погодувати його бульбашковим виноградом, щоб підвищити рівень швидше за всіх.",shape=box,color=blue];
		j3653948149 -> j590240662;
	j1193031741 [label="Тобі доведеться почати з наймилішої жаби, але зрештою, якщо виграєш достатньо битв…",shape=box,color=blue];
		j1193031741 -> j1589416894;
	j2930401109 [label="Абсолютно витончений вибір.",shape=box,color=blue];
		j2930401109 -> j3019583706;
	j590240662 [label="Що розблокує тобі всю систему збору врожаю.",shape=box,color=blue];
		j590240662 -> j3019583706;
	j1589416894 [label="Ти зможеш поліпшити Фроґобоґо в ДРАКОНА.",shape=box,color=blue];
		j1589416894 -> j3019583706;
	j3019583706 [label="Що це взагалі за гра…",shape=box,color=red];
		j3019583706 -> j87169969;
	j87169969 [label="Ах, точно. Отже ти збираєш джинімонів, вони борються за тебе, ви разом вирушаєте в пригоди.",shape=box,color=blue];
		j87169969 -> j877800509;
	j877800509 [label="Але це версія для комп’ютерів. У карткової версії ТИ типу ведеш битви проти когось іншого в реальному житті.",shape=box,color=blue];
		j877800509 -> j4289667435;
	j4289667435 [label="Але ідея така сама. Джинімон джинімон джинімон. ",shape=box,color=blue];
		j4289667435 -> j3302061324;
	j3302061324 [label="Отже, зіграймо твій перший матч?",shape=box,color=blue];
		j3302061324 -> j1508333844;
		j3302061324 -> j1897599342;
		j3302061324 -> j4275881317;
		j3302061324 -> j2540266003;
	j1508333844 [label="Я пас. [Завершити розмову]",shape=box,color=red];
		j1508333844 -> j145506587;
	j1897599342 [label="Звісно, чому б і ні, початківцям завжди щастить.",shape=box,color=red];
		j1897599342 -> j2480218457;
	j4275881317 [label="Ти просто хочеш легкої перемоги. Я пас.",shape=box,color=red];
		j4275881317 -> j1926266905;
	j2540266003 [label="Ні, тепер я взагалі не розумію. Ти нічого не пояснила нормально! ",shape=box,color=red];
		j2540266003 -> j1926266905;
	j2480218457 [label="Клас… тобі потрібно лише вкинути 10 000 голарів для старту…",shape=box,color=blue];
		j2480218457 -> j2165034061;
		j2480218457 -> j2642952138;
	j1926266905 [label="Ой, ну не бійся… я піддамся. Я навіть дозволю Аміру тобі допомогти!",shape=box,color=blue];
		j1926266905 -> j397814889;
	j2165034061 [label="Як скажеш…",shape=box,color=red];
		j2165034061 -> j1837089341;
	j2642952138 [label="Що за лихо! У мене немає таких грошей.",shape=box,color=red];
		j2642952138 -> j1837089341;
	j397814889 [label="І якщо ти виграєш, я дам тобі закриту пачку карток Джинімон!",shape=box,color=blue];
		j397814889 -> j1173997962;
		j397814889 -> j2575376506;
		j397814889 -> j1672794476;
	j1837089341 [label="Це не проблема, просто введи тут свою банківську інформацію…",shape=box,color=blue];
		j1837089341 -> j868721856;
		j1837089341 -> j3167362713;
	j1173997962 [label="Гаразд, добре. Тільки якщо Амір мені допоможе.",shape=box,color=red];
		j1173997962 -> j2480218457;
	j2575376506 [label="Може іншим разом?",shape=box,color=red];
		j2575376506 -> j1815319430;
	j1672794476 [label="У жодному разі! ",shape=box,color=red];
		j1672794476 -> j1815319430;
	j868721856 [label="Я на таке не попадуся!",shape=box,color=red];
		j868721856 -> j3934989734;
	j3167362713 [label="Ну гаразд, 4… 1…",shape=box,color=red];
		j3167362713 -> j2307845718;
	j1815319430 [label="Добре-е-е.",shape=box,color=blue];
		j1815319430 -> j145506587;
	j3934989734 [label="Вітаю з проходженням тесту на безпеку KOL. ",shape=box,color=blue];
		j3934989734 -> j2184882362;
	j2307845718 [label="ЛИШЕНЬКО, НІ! Це був тест, НЕ можна вводити свою банківську інформацію в інтернет-сервісах KOL! ",shape=box,color=blue];
		j2307845718 -> j2876974230;
	j2184882362 [label="Боже, Амір був такий упевнений, що ти на це попадешся.",shape=box,color=blue];
		j2184882362 -> j743412295;
	j2876974230 [label="Тьху, трясця! Я винна Аміру гру. Він сміявся, що ти на таке попадешся.",shape=box,color=blue];
		j2876974230 -> j145506587;
	j743412295 [label="Але так, ми зіграємо іншим разом.",shape=box,color=blue];
		j743412295 -> j145506587;
}