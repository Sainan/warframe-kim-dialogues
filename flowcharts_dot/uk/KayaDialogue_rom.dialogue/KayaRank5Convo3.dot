digraph {
	"KayaRank5Convo3 begins." [color=orange];
		"KayaRank5Convo3 begins." -> j3911963843;
	j3911963843 [label="О-о-о, вітаннячко, чи можу я розповісти трохи про основи КАРТОК ДЖИНІМОН?",shape=box,color=blue];
		j3911963843 -> j1587322418;
	j1587322418 [label="Амір у захваті, що йому нарешті є з ким грати (і кому програвати).",shape=box,color=blue];
		j1587322418 -> j2703255282;
	j2703255282 [label="Але ми обидва подумали, що було б цікаво залучити також і тебе до гри в Джинімон. ",shape=box,color=blue];
		j2703255282 -> j69535727;
		j2703255282 -> j1720824467;
		j2703255282 -> j2918242822;
	j69535727 [label="Ви грайте. У мене багато справ. [Кінець]",shape=box,color=red];
		j69535727 -> j145506587;
	j1720824467 [label="У мене кілька голарів завалялося в кишені, то з чого почнемо?",shape=box,color=red];
		j1720824467 -> j3137935661;
	j2918242822 [label="Нагадай мені... про що ми зараз говоримо?",shape=box,color=red];
		j2918242822 -> j981949785;
	j145506587 [label="+20 Chemistry",color=orange];
		j145506587 -> "Chat ends. Next chat will be KayaRank5Convo4.";
	j3137935661 [label="О-о-о, ну добре! Що ж. Спочатку почнімо з тебе. Ти бачиш себе більше Драконом, Орлом чи Пантерою?",shape=box,color=blue];
		j3137935661 -> j1872415585;
		j3137935661 -> j1704820759;
		j3137935661 -> j2126488706;
	j981949785 [label="Лише про НАЙПОПУЛЯРНІШЕ шоу, гру, колекціонку 1999!",shape=box,color=blue];
		j981949785 -> j545375119;
	"Chat ends. Next chat will be KayaRank5Convo4." [color=orange];
	j1872415585 [label="Пантерою.",shape=box,color=red];
		j1872415585 -> j1682329709;
	j1704820759 [label="Орлом.",shape=box,color=red];
		j1704820759 -> j1050559963;
	j2126488706 [label="Драконом.",shape=box,color=red];
		j2126488706 -> j4016063730;
	j545375119 [label="Знаєш, із суперкрутими персонажами й істотами...",shape=box,color=blue];
		j545375119 -> j3103560677;
	j1682329709 [label="Добре, тоді ти АБСОЛЮТНО точно захочеш почати гру з Тейлали.",shape=box,color=blue];
		j1682329709 -> j3033285510;
	j1050559963 [label="Добре, тоді ти ОБОВ'ЯЗКОВО точно захочеш почати гру з Пламберта.",shape=box,color=blue];
		j1050559963 -> j2113565590;
	j4016063730 [label="Добре, тоді ти МОЖЛИВО захочеш почати гру з Фроґобоґо.",shape=box,color=blue];
		j4016063730 -> j2091695542;
	j3103560677 [label="Але суть не в цьому. Почнімо з тебе. Ти бачиш себе більше Драконом, Орлом чи Пантерою?",shape=box,color=blue];
		j3103560677 -> j1872415585;
		j3103560677 -> j1704820759;
		j3103560677 -> j2126488706;
	j3033285510 [label="Це найкрутіший варіант, але він точно складний і дуже слабкий на початку.",shape=box,color=blue];
		j3033285510 -> j206719171;
	j2113565590 [label="Трохи складний варіант, але дуже крутий. ",shape=box,color=blue];
		j2113565590 -> j2655104939;
	j2091695542 [label="Що є чудовим вибором для новачків. ",shape=box,color=blue];
		j2091695542 -> j1987650935;
	j206719171 [label="Але наприкінці? Ти матимеш найрозкішнішу та найвеличнішу пантеру.",shape=box,color=blue];
		j206719171 -> j1984256798;
	j2655104939 [label="І Пламберт надзвичайно милий, тому що ти можеш погодувати його бульбашковим виноградом, щоб підвищити рівень швидше за всіх.",shape=box,color=blue];
		j2655104939 -> j2653181247;
	j1987650935 [label="Тобі доведеться почати з наймилішої жаби, але зрештою, якщо виграєш достатньо битв...",shape=box,color=blue];
		j1987650935 -> j3330631910;
	j1984256798 [label="Абсолютно витончений вибір.",shape=box,color=blue];
		j1984256798 -> j963037935;
	j2653181247 [label="Що розблокує тобі всю систему збору врожаю.",shape=box,color=blue];
		j2653181247 -> j963037935;
	j3330631910 [label="Ти зможеш поліпшити Фроґобоґо в ДРАКОНА.",shape=box,color=blue];
		j3330631910 -> j963037935;
	j963037935 [label="Що це взагалі за гра...",shape=box,color=red];
		j963037935 -> j3145546386;
	j3145546386 [label="Ах, точно. Отже ти збираєш джинімонів, вони борються за тебе та ви разом вирушаєте в пригоди.",shape=box,color=blue];
		j3145546386 -> j2480546169;
	j2480546169 [label="Але це версія для комп'ютерів. У карткової версії ТИ типу ведеш битви проти когось іншого в реальному житті.",shape=box,color=blue];
		j2480546169 -> j4289667435;
	j4289667435 [label="Але ідея така сама. Джинімон джинімон джинімон. ",shape=box,color=blue];
		j4289667435 -> j3302061324;
	j3302061324 [label="Отже, зіграймо твій перший матч?",shape=box,color=blue];
		j3302061324 -> j3747535234;
		j3302061324 -> j1897599342;
		j3302061324 -> j1984807674;
		j3302061324 -> j4122851851;
	j3747535234 [label="Я пас. [Кінець]",shape=box,color=red];
		j3747535234 -> j145506587;
	j1897599342 [label="Звісно, чому б і ні, початківцям завжди щастить.",shape=box,color=red];
		j1897599342 -> j2480218457;
	j1984807674 [label="Ти просто хочеш легкої перемоги. Я пас.",shape=box,color=red];
		j1984807674 -> j2877525450;
	j4122851851 [label="Ні, тепер я взагалі не розумію. Ти нічого не пояснила нормально! ",shape=box,color=red];
		j4122851851 -> j2877525450;
	j2480218457 [label="Клас… тобі потрібно лише вкинути 10 000 голарів для старту…",shape=box,color=blue];
		j2480218457 -> j3682258936;
		j2480218457 -> j2365082907;
	j2877525450 [label="Ой, ну не бійся... я піддамся. Я навіть дозволю Аміру тобі допомогти!",shape=box,color=blue];
		j2877525450 -> j397814889;
	j3682258936 [label="Як скажеш...",shape=box,color=red];
		j3682258936 -> j2407906786;
	j2365082907 [label="Що за лихо! У мене немає таких грошей.",shape=box,color=red];
		j2365082907 -> j2407906786;
	j397814889 [label="І якщо ти виграєш, я дам тобі закриту пачку карток Джинімон!",shape=box,color=blue];
		j397814889 -> j1173997962;
		j397814889 -> j1183098509;
		j397814889 -> j2061419907;
	j2407906786 [label="Це не проблема, просто введи тут свою банківську інформацію...",shape=box,color=blue];
		j2407906786 -> j222713976;
		j2407906786 -> j1137261022;
	j1173997962 [label="Гаразд, добре. Тільки якщо Амір мені допоможе.",shape=box,color=red];
		j1173997962 -> j2480218457;
	j1183098509 [label="Може іншим разом?",shape=box,color=red];
		j1183098509 -> j3973648737;
	j2061419907 [label="У жодному разі! ",shape=box,color=red];
		j2061419907 -> j3973648737;
	j222713976 [label="Я на таке не попадуся!",shape=box,color=red];
		j222713976 -> j406420290;
	j1137261022 [label="Ну гаразд, 4...1...",shape=box,color=red];
		j1137261022 -> j4082198385;
	j3973648737 [label="Добре-е-е-е.",shape=box,color=blue];
		j3973648737 -> j145506587;
	j406420290 [label="Вітаю з проходженням тесту на безпеку K.O.L. ",shape=box,color=blue];
		j406420290 -> j2248473947;
	j4082198385 [label="ЛИШЕНЬКО, НІ! Це був тест, НЕ можна вводити свою банківську інформацію в інтернет-сервісах K.O.L! ",shape=box,color=blue];
		j4082198385 -> j2876974230;
	j2248473947 [label="Боже, Амір був такий впевнений, що ти на це попадешся.",shape=box,color=blue];
		j2248473947 -> j743412295;
	j2876974230 [label="Тьху, трясця! Я винна Аміру гру. Він сміявся, що ти на таке попадешся.",shape=box,color=blue];
		j2876974230 -> j145506587;
	j743412295 [label="Але так, ми зіграємо іншим разом.",shape=box,color=blue];
		j743412295 -> j145506587;
}