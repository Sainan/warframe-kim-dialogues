		j3137935661 -> j2307178599;
	j981949785 [label="Лише про НАЙПОПУЛЯРНІШЕ шоу, гру, колекціонку 1999!",shape=box,color=blue];
		j981949785 -> j545375119;
	"Chat ends. Next chat will be KayaRank5Convo4." [color=orange];
	j1344071822 [label="Пантерою.",shape=box,color=red];
		j1344071822 -> j784450881;
	j4264197099 [label="Орлом.",shape=box,color=red];
		j4264197099 -> j632269533;
	j2307178599 [label="Драконом.",shape=box,color=red];
		j2307178599 -> j2500549827;
	j545375119 [label="Знаєш, із суперкрутими персонажами й істотами...",shape=box,color=blue];
		j545375119 -> j3103560677;
	j784450881 [label="Добре, тоді ти АБСОЛЮТНО точно захочеш почати гру з Тейлали.",shape=box,color=blue];
		j784450881 -> j134413966;
	j632269533 [label="Добре, тоді ти ОБОВ'ЯЗКОВО точно захочеш почати гру з Пламберта.",shape=box,color=blue];
		j632269533 -> j866346444;
	j2500549827 [label="Добре, тоді ти МОЖЛИВО захочеш почати гру з Фроґобоґо.",shape=box,color=blue];
		j2500549827 -> j2721560179;
	j3103560677 [label="Але суть не в цьому. Почнімо з тебе. Ти бачиш себе більше Драконом, Орлом чи Пантерою?",shape=box,color=blue];
		j3103560677 -> j1344071822;
		j3103560677 -> j4264197099;
		j3103560677 -> j2307178599;
	j134413966 [label="Це найкрутіший варіант, але він точно складний і дуже слабкий на початку.",shape=box,color=blue];
		j134413966 -> j3772501465;
	j866346444 [label="Трохи складний варіант, але дуже крутий. ",shape=box,color=blue];
		j866346444 -> j3067540691;
	j2721560179 [label="Що є чудовим вибором для новачків. ",shape=box,color=blue];
		j2721560179 -> j3102696497;
	j3772501465 [label="Але наприкінці? Ти матимеш найрозкішнішу та найвеличнішу пантеру.",shape=box,color=blue];
		j3772501465 -> j315391851;
	j3067540691 [label="І Пламберт надзвичайно милий, тому що ти можеш погодувати його бульбашковим виноградом, щоб підвищити рівень швидше за всіх.",shape=box,color=blue];
		j3067540691 -> j1895694726;
	j3102696497 [label="Тобі доведеться почати з наймилішої жаби, але зрештою, якщо виграєш достатньо битв...",shape=box,color=blue];
		j3102696497 -> j3878246894;
	j315391851 [label="Абсолютно витончений вибір.",shape=box,color=blue];
		j315391851 -> j4008898089;
	j1895694726 [label="Що розблокує тобі всю систему збору врожаю.",shape=box,color=blue];
		j1895694726 -> j4008898089;
	j3878246894 [label="Ти зможеш поліпшити Фроґобоґо в ДРАКОНА.",shape=box,color=blue];
		j3878246894 -> j4008898089;
	j4008898089 [label="Що це взагалі за гра...",shape=box,color=red];
		j4008898089 -> j87169969;
	j87169969 [label="Ах, точно. Отже ти збираєш джинімонів, вони борються за тебе, ви разом вирушаєте в пригоди.",shape=box,color=blue];
		j87169969 -> j877800509;
	j877800509 [label="Але це версія для комп’ютерів. У карткової версії ТИ типу ведеш битви проти когось іншого в реальному житті.",shape=box,color=blue];
		j877800509 -> j4289667435;
	j4289667435 [label="Але ідея така сама. Джинімон джинімон джинімон. ",shape=box,color=blue];
		j4289667435 -> j3302061324;
	j3302061324 [label="Отже, зіграймо твій перший матч?",shape=box,color=blue];
		j3302061324 -> j3747535234;
		j3302061324 -> j1897599342;
		j3302061324 -> j1984807674;
		j3302061324 -> j4122851851;
	j3747535234 [label="Я пас. [Кінець]",shape=box,color=red];
		j3747535234 -> j145506587;
	j1897599342 [label="Звісно, чому б і ні, початківцям завжди щастить.",shape=box,color=red];
		j1897599342 -> j2480218457;
	j1984807674 [label="Ти просто хочеш легкої перемоги. Я пас.",shape=box,color=red];
		j1984807674 -> j2877525450;
	j4122851851 [label="Ні, тепер я взагалі не розумію. Ти нічого не пояснила нормально! ",shape=box,color=red];
		j4122851851 -> j2877525450;
	j2480218457 [label="Клас… тобі потрібно лише вкинути 10 000 голарів для старту…",shape=box,color=blue];
		j2480218457 -> j3682258936;
		j2480218457 -> j2365082907;
	j2877525450 [label="Ой, ну не бійся... я піддамся. Я навіть дозволю Аміру тобі допомогти!",shape=box,color=blue];
		j2877525450 -> j397814889;
	j3682258936 [label="Як скажеш...",shape=box,color=red];
		j3682258936 -> j2407906786;
	j2365082907 [label="Що за лихо! У мене немає таких грошей.",shape=box,color=red];
		j2365082907 -> j2407906786;
	j397814889 [label="І якщо ти виграєш, я дам тобі закриту пачку карток Джинімон!",shape=box,color=blue];
		j397814889 -> j1173997962;
		j397814889 -> j2575376506;
		j397814889 -> j1672794476;
	j2407906786 [label="Це не проблема, просто введи тут свою банківську інформацію...",shape=box,color=blue];
		j2407906786 -> j868721856;
		j2407906786 -> j1999432694;
	j1173997962 [label="Гаразд, добре. Тільки якщо Амір мені допоможе.",shape=box,color=red];
		j1173997962 -> j2480218457;
	j2575376506 [label="Може іншим разом?",shape=box,color=red];
		j2575376506 -> j1815319430;
	j1672794476 [label="У жодному разі! ",shape=box,color=red];
		j1672794476 -> j1815319430;
	j868721856 [label="Я на таке не попадуся!",shape=box,color=red];
		j868721856 -> j3934989734;
	j1999432694 [label="Ну гаразд, 4... 1...",shape=box,color=red];
		j1999432694 -> j2307845718;
	j1815319430 [label="Добре-е-е.",shape=box,color=blue];
		j1815319430 -> j145506587;
	j3934989734 [label="Вітаю з проходженням тесту на безпеку KOL. ",shape=box,color=blue];
		j3934989734 -> j2184882362;
	j2307845718 [label="ЛИШЕНЬКО, НІ! Це був тест, НЕ можна вводити свою банківську інформацію в інтернет-сервісах KOL! ",shape=box,color=blue];
		j2307845718 -> j2876974230;
	j2184882362 [label="Боже, Амір був такий упевнений, що ти на це попадешся.",shape=box,color=blue];
		j2184882362 -> j743412295;
	j2876974230 [label="Тьху, трясця! Я винна Аміру гру. Він сміявся, що ти на таке попадешся.",shape=box,color=blue];
		j2876974230 -> j145506587;
	j743412295 [label="Але так, ми зіграємо іншим разом.",shape=box,color=blue];
