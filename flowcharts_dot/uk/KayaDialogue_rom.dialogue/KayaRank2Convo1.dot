		183 -> 187;
		183 -> 188;
	184 [label="Гм. Ем. Гм. Комфортніше. Хтось поширює про мене чутки?",shape=box,color=blue];
		184 -> 189;
		184 -> 190;
	185 [label="З тобою щось сталося?",shape=box,color=red];
