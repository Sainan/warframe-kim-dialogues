digraph {
	"KayaRank2Convo1 begins." [color=orange];
		"KayaRank2Convo1 begins." -> j1148240889;
	j1148240889 [label="Привіт, Кає!",shape=box,color=red];
		j1148240889 -> j3679460574;
	j3679460574 [label="Нова. В інтернеті мене звуть Нова.",shape=box,color=blue];
		j3679460574 -> j3920619006;
		j3679460574 -> j3326068745;
	j3920619006 [label="Гаразд, Нова. ",shape=box,color=red];
		j3920619006 -> j1516356405;
	j3326068745 [label="Зрозуміло. Відколи?",shape=box,color=red];
		j3326068745 -> j658182838;
	j1516356405 [label="Дяка, тільки не називай мене Каєю в інтернеті. Можеш називати мене так особисто, але тут: НОВА. Добре?",shape=box,color=blue];
		j1516356405 -> j2327782160;
		j1516356405 -> j3263790237;
	j658182838 [label="Ем, яка різниця? Це інтернет, я не хочу використовувати своє справжнє ім’я.",shape=box,color=blue];
		j658182838 -> j3971331822;
		j658182838 -> j773406149;
	j2327782160 [label="Добре, але я можу запитати чому?",shape=box,color=red];
		j2327782160 -> j3444752102;
	j3263790237 [label="Зрозуміло. Нова. Нова. Добре. Я хочу запитати: чи можу я зробити щось, щоб тобі тут було комфортніше?",shape=box,color=red];
		j3263790237 -> j2083449306;
	j3971331822 [label="Ну так, не хочеться, щоб люди бачили, як часто ти запитуєш мене про подорожі в часі.",shape=box,color=red];
		j3971331822 -> j2334571718;
	j773406149 [label="Га? Гадаю, що Амір досить добре захистив цю мережу, чи я чогось не знаю?",shape=box,color=red];
		j773406149 -> j3060283265;
	j3444752102 [label="Ти запитуєш інших, чи є у них псевдонім, який їм подобається? Просто звикни. ",shape=box,color=blue];
		j3444752102 -> j3263790237;
	j2083449306 [label="Я знаю, що ніхто з нас насправді не хоче «бути тут» у цьому тимчасовому домі, але ми всі намагаємося.",shape=box,color=red];
		j2083449306 -> j3388830358;
	j2334571718 [label="Ти серйозно? Інтернет небезпечний. Насправді.",shape=box,color=blue];
		j2334571718 -> j3039301659;
		j2334571718 -> j3650052406;
	j3060283265 [label="Для мене це важливо. Я не хочу, щоб хтось знову знайшов Каю онлайн.",shape=box,color=blue];
		j3060283265 -> j3468059226;
		j3060283265 -> j3388713659;
	j3388830358 [label="Гм. Ем. Гм. Комфортніше. Хтось поширює про мене чутки?",shape=box,color=blue];
		j3388830358 -> j3509982795;
		j3388830358 -> j3311488296;
	j3039301659 [label="З тобою щось сталося?",shape=box,color=red];
		j3039301659 -> j960515419;
	j3650052406 [label="А подорожі в часі — ні?",shape=box,color=red];
		j3650052406 -> j4294415938;
	j3468059226 [label="Клянуся, поліція часу тебе не спіймає.",shape=box,color=red];
		j3468059226 -> j4221525003;
	j3388713659 [label="Ти потрапила в халепу?",shape=box,color=red];
		j3388713659 -> j2940749010;
	j3509982795 [label="Ну, Аой казала…",shape=box,color=red];
		j3509982795 -> j802189206;
	j3311488296 [label="Зовсім ні. Усі раді, що ти тут.",shape=box,color=red];
		j3311488296 -> j779005226;
	j960515419 [label="Check boolean KayaSetKid",color=orange];
		j960515419 -> j3132053529 [label=true,color=green];
		j960515419 -> j265297747 [label=false,color=brown];
	j4294415938 [label="Check boolean KayaSetKid",color=orange];
		j4294415938 -> j1418284710 [label=true,color=green];
		j4294415938 -> j4082223253 [label=false,color=brown];
	j4221525003 [label="Ем. Не смішно. ",shape=box,color=blue];
		j4221525003 -> j2292283515;
	j2940749010 [label="Я припустилася ТУПОЇ помилки. Лише раз. ",shape=box,color=blue];
		j2940749010 -> j3727085045;
	j802189206 [label="Навіть не жартуй так.",shape=box,color=blue];
		j802189206 -> j2290311823;
	j779005226 [label="Артур і Елеонора безумовно сприймають тебе як молодшу сестру, яка набагато розумніша за них.",shape=box,color=red];
		j779005226 -> j1166177706;
	j3132053529 [label="Це ти кажеш, що я як дівча, що як зі мною дійсно щось трапилося?",shape=box,color=blue];
		j3132053529 -> j1497176040;
	j265297747 [label="Нічого такого, що я можу зараз змінити.",shape=box,color=blue];
		j265297747 -> j3930941858;
	j1418284710 [label="Слухай, я знаю, ти думаєш, що я просто дівча.",shape=box,color=blue];
		j1418284710 -> j2650438698;
	j4082223253 [label="Гаразд. Твоя правда.",shape=box,color=blue];
	j2292283515 [label="+20 Chemistry",color=orange];
		j2292283515 -> "Chat ends. Next chat will be KayaRank2Convo2.";
	j3727085045 [label="А я не припускаюся помилок.",shape=box,color=blue];
		j3727085045 -> j3086939292;
	j2290311823 [label="Це зовсім не смішно. Ви збираєте разом таких дівчат, як ми, і очікуєте, що ми будемо вбивати одна одну.",shape=box,color=blue];
		j2290311823 -> j2298992991;
	j1166177706 [label="Амір і Квінсі одержимі твоєю кротовиною, і я клянусь, вони стрибають через неї, коли ти не бачиш.",shape=box,color=red];
		j1166177706 -> j1244987413;
	j1497176040 [label="Тоді я сподіваюся, що ти побачиш від людей навколо, що ми команда, яка допомагає один одному.",shape=box,color=red];
		j1497176040 -> j1835122856;
	j3930941858 [label="Тому ти хочеш розібратися з цією проблемою подорожей у часі? Щоб щось довести?",shape=box,color=red];
		j3930941858 -> j2711042857;
	j2650438698 [label="But ",shape=box,color=blue];
		j2650438698 -> j2940749010;
	"Chat ends. Next chat will be KayaRank2Convo2." [color=orange];
	j3086939292 [label="So give me just a few more days, maybe a few weeks, and I'll have this whole thing figured out and it's goodbye 1999.",shape=box,color=blue];
		j3086939292 -> j2892505843;
	j2298992991 [label="Jealousy. Comparisons. Ugh. I'm done with that part of my life. Do not try and turn me against the other girls. ",shape=box,color=blue];
		j2298992991 -> j2292283515;
	j1244987413 [label="Aoi and Lettie can't seem to decide if they want to be your best friend or your mother.",shape=box,color=red];
		j1244987413 -> j1209691337;
	j1835122856 [label="Mmm. ",shape=box,color=blue];
		j1835122856 -> j787700223;
	j2711042857 [label="Maybe.",shape=box,color=blue];
		j2711042857 -> j3898456205;
	j2892505843 [label="Bet on it.",shape=box,color=blue];
		j2892505843 -> j2292283515;
	j1209691337 [label="And of course me, I'm happy someone wants to understand how the hell I ended up here.",shape=box,color=red];
		j1209691337 -> j915401444;
	j787700223 [label="You are right. You aren't exactly unpopular.",shape=box,color=blue];
		j787700223 -> j3272885779;
	j3898456205 [label="Why do you care, actually?",shape=box,color=blue];
		j3898456205 -> j1173333211;
		j3898456205 -> j3603946852;
		j3898456205 -> j2673243050;
	j915401444 [label="You guys actually... like me?",shape=box,color=blue];
		j915401444 -> j165978842;
		j915401444 -> j414014320;
	j3272885779 [label="And everyone does seem to trust you, or at least say they do.",shape=box,color=blue];
		j3272885779 -> j2673243050;
		j3272885779 -> j3603946852;
		j3272885779 -> j1173333211;
	j1173333211 [label="Trusting people and working together is what makes us us. ",shape=box,color=red];
		j1173333211 -> j394766465;
	j3603946852 [label="Caring about my friends is a strength. It's a reason to endure all this shit.",shape=box,color=red];
		j3603946852 -> j394766465;
	j2673243050 [label="We all have our shit to deal with. It's hard to do alone.",shape=box,color=red];
		j2673243050 -> j394766465;
	j165978842 [label="We're just waiting for you to feel comfortable around us.",shape=box,color=red];
		j165978842 -> j2546257714;
	j414014320 [label="How could we not? ",shape=box,color=red];
		j414014320 -> j2546257714;
	j394766465 [label="LOL Sounds like something from a sorority slogan.",shape=box,color=blue];
		j394766465 -> j3289129035;
		j394766465 -> j2787354989;
	j2546257714 [label="I... see.",shape=box,color=blue];
		j2546257714 -> j2292283515;
	j3289129035 [label="What exactly is a 'sorority slogan'?",shape=box,color=red];
		j3289129035 -> j768061301;
	j2787354989 [label="Sorority? What's that.",shape=box,color=red];
		j2787354989 -> j768061301;
	j768061301 [label="LOL Really? I really have to go to the future if there's none of those there. Holy shit.",shape=box,color=blue];
		j768061301 -> j1865727437;
	j1865727437 [label="Not following...",shape=box,color=red];
		j1865727437 -> j2437525607;
	j2437525607 [label="In University a bunch of girls call themselves sisters and think it means something. Like a 'club' I guess. ",shape=box,color=blue];
		j2437525607 -> j2377998950;
	j2377998950 [label="Oh, maybe like 'The Sisters of Parvos'?",shape=box,color=red];
		j2377998950 -> j1509924743;
	j1509924743 [label="Sounds lame. Ugh. I freaking HOPE it's not a real sorority.",shape=box,color=blue];
		j1509924743 -> j1655043238;
	j1655043238 [label="Well, they try to kill me. A lot.",shape=box,color=red];
		j1655043238 -> j2617793550;
	j2617793550 [label="Feels like mine tried to kill me too...",shape=box,color=blue];
