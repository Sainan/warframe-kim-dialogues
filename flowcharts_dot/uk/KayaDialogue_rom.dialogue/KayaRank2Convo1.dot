		207 -> 194;
	209 [label="Chat ends. Next chat will be KayaRank2Convo2.",color=orange];
	210 [label="Тож дай мені ще кілька днів, можливо, кілька тижнів, і я розберуся в цьому всьому, і тоді до побачення 1999 рік.",shape=box,color=blue];
		210 -> 215;
	211 [label="Заздрощі. Порівняння. Тьху. Мені вистачило такого життя. Не намагайся налаштовувати мене проти інших дівчат. ",shape=box,color=blue];
		211 -> 216;
