	203 [label="Це зовсім не смішно. Ви збираєте разом таких дівчат, як ми, і очікуєте, що ми будемо вбивати одна одну.",shape=box,color=blue];
		203 -> 211;
	204 [label="Амір і Квінсі одержимі твоєю кротовиною, і я клянусь, вони стрибають через неї, коли ти не бачиш.",shape=box,color=red];
		204 -> 212;
