		173 -> 175;
	174 [label="Дяка, тільки не називай мене Каєю в інтернеті. Можеш називати мене так особисто, але тут: НОВА. Добре?",shape=box,color=blue];
		174 -> 176;
		174 -> 177;
	175 [label="Ем, яка різниця? Це інтернет, я не хочу використовувати своє справжнє ім’я.",shape=box,color=blue];
		175 -> 178;
		175 -> 179;
	176 [label="Добре, але я можу запитати чому?",shape=box,color=red];
		176 -> 180;
	177 [label="Зрозуміло. Нова. Нова. Добре. Я хочу запитати: чи можу я зробити щось, щоб тобі тут було комфортніше?",shape=box,color=red];
		177 -> 181;
	178 [label="Ну так, не хочеться, щоб люди бачили, як часто ти запитуєш мене про подорожі в часі.",shape=box,color=red];
		178 -> 182;
	179 [label="Га? Гадаю, що Амір досить добре захистив цю мережу, чи я чогось не знаю?",shape=box,color=red];
		179 -> 183;
	180 [label="Ти запитуєш інших, чи є у них псевдонім, який їм подобається? Просто звикни. ",shape=box,color=blue];
		180 -> 177;
	181 [label="Я знаю, що ніхто з нас насправді не хоче «бути тут» у цьому тимчасовому домі, але ми всі намагаємося.",shape=box,color=red];
		181 -> 184;
	182 [label="Ти серйозно? Інтернет небезпечний. Насправді.",shape=box,color=blue];
		182 -> 185;
