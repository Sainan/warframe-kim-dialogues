digraph {
	"KayaRank2Convo1 begins." [color=orange];
		"KayaRank2Convo1 begins." -> j1148240889;
	j1148240889 [label="Привіт, Кає!",shape=box,color=red];
		j1148240889 -> j3679460574;
	j3679460574 [label="Нова. В інтернеті мене звуть Нова.",shape=box,color=blue];
		j3679460574 -> j3920619006;
		j3679460574 -> j3326068745;
	j3920619006 [label="Гаразд, Нова. ",shape=box,color=red];
		j3920619006 -> j1516356405;
	j3326068745 [label="Зрозуміло. Відколи?",shape=box,color=red];
		j3326068745 -> j658182838;
	j1516356405 [label="Дяка, тільки не називай мене Каєю в інтернеті. Можеш називати мене так особисто, але тут: НОВА. Добре?",shape=box,color=blue];
		j1516356405 -> j2327782160;
		j1516356405 -> j3263790237;
	j658182838 [label="Ем, яка різниця? Це інтернет, я не хочу використовувати своє справжнє ім’я.",shape=box,color=blue];
		j658182838 -> j3971331822;
		j658182838 -> j773406149;
	j2327782160 [label="Добре, але я можу запитати чому?",shape=box,color=red];
		j2327782160 -> j3444752102;
	j3263790237 [label="Зрозуміло. Нова. Нова. Добре. Я хочу запитати: чи можу я зробити щось, щоб тобі тут було комфортніше?",shape=box,color=red];
		j3263790237 -> j2083449306;
	j3971331822 [label="Ну так, не хочеться, щоб люди бачили, як часто ти запитуєш мене про подорожі в часі.",shape=box,color=red];
		j3971331822 -> j2334571718;
	j773406149 [label="Га? Гадаю, що Амір досить добре захистив цю мережу, чи я чогось не знаю?",shape=box,color=red];
		j773406149 -> j3060283265;
	j3444752102 [label="Ти запитуєш інших, чи є у них псевдонім, який їм подобається? Просто звикни. ",shape=box,color=blue];
		j3444752102 -> j3263790237;
	j2083449306 [label="Я знаю, що ніхто з нас насправді не хоче «бути тут» у цьому тимчасовому домі, але ми всі намагаємося.",shape=box,color=red];
		j2083449306 -> j3388830358;
	j2334571718 [label="Ти серйозно? Інтернет небезпечний. Насправді.",shape=box,color=blue];
		j2334571718 -> j3039301659;
		j2334571718 -> j3650052406;
	j3060283265 [label="Для мене це важливо. Я не хочу, щоб хтось знову знайшов Каю онлайн.",shape=box,color=blue];
		j3060283265 -> j3468059226;
		j3060283265 -> j511468921;
	j3388830358 [label="Гм. Ем. Гм. Комфортніше. Хтось поширює про мене чутки?",shape=box,color=blue];
		j3388830358 -> j2255631771;
		j3388830358 -> j2128058720;
	j3039301659 [label="З тобою щось сталося?",shape=box,color=red];
		j3039301659 -> j960515419;
	j3650052406 [label="А подорожі в часі — ні?",shape=box,color=red];
		j3650052406 -> j4294415938;
	j3468059226 [label="Клянуся, поліція часу тебе не спіймає.",shape=box,color=red];
		j3468059226 -> j4221525003;
	j511468921 [label="Ти потрапила в халепу?",shape=box,color=red];
		j511468921 -> j1640499340;
	j2255631771 [label="Ну, Аой казала…",shape=box,color=red];
		j2255631771 -> j288900036;
	j2128058720 [label="Зовсім ні. Усі раді, що ти тут.",shape=box,color=red];
		j2128058720 -> j2503481172;
	j960515419 [label="Check boolean KayaSetKid",color=orange];
		j960515419 -> j2016632002 [label=true,color=green];
		j960515419 -> j2441551816 [label=false,color=brown];
	j4294415938 [label="Check boolean KayaSetKid",color=orange];
		j4294415938 -> j2300631060 [label=true,color=green];
		j4294415938 -> j2560291760 [label=false,color=brown];
	j4221525003 [label="Ем. Не смішно. ",shape=box,color=blue];
		j4221525003 -> j2292283515;
	j1640499340 [label="Я припустилася ТУПОЇ помилки. Лише раз. ",shape=box,color=blue];
		j1640499340 -> j3603503094;
	j288900036 [label="Навіть не жартуй так.",shape=box,color=blue];
		j288900036 -> j3834543341;
	j2503481172 [label="Артур і Елеонора безумовно сприймають тебе як молодшу сестру, яка набагато розумніша за них.",shape=box,color=red];
		j2503481172 -> j3675927877;
	j2016632002 [label="Це ти кажеш, що я як дівча, що як зі мною дійсно щось трапилося?",shape=box,color=blue];
		j2016632002 -> j3483458498;
	j2441551816 [label="Нічого такого, що я можу зараз змінити.",shape=box,color=blue];
		j2441551816 -> j2544905005;
	j2300631060 [label="Слухай, я знаю, ти думаєш, що я просто дівча.",shape=box,color=blue];
		j2300631060 -> j4187767555;
	j2560291760 [label="Гаразд. Твоя правда.",shape=box,color=blue];
		j2560291760 -> j4180714171;
	j2292283515 [label="+20 Chemistry",color=orange];
		j2292283515 -> "Chat ends. Next chat will be KayaRank2Convo2.";
	j3603503094 [label="А я не припускаюся помилок.",shape=box,color=blue];
		j3603503094 -> j2636092600;
	j3834543341 [label="Це зовсім не смішно. Ви збираєте разом таких дівчат, як ми, і очікуєте, що ми будемо вбивати одна одну.",shape=box,color=blue];
		j3834543341 -> j674560806;
	j3675927877 [label="Амір і Квінсі одержимі твоєю кротовиною, і я клянусь, вони стрибають через неї, коли ти не бачиш.",shape=box,color=red];
		j3675927877 -> j1335223491;
	j3483458498 [label="Тоді я сподіваюся, що ти побачиш від людей навколо, що ми команда, яка допомагає один одному.",shape=box,color=red];
		j3483458498 -> j1634454693;
	j2544905005 [label="Тому ти хочеш розібратися з цією проблемою подорожей у часі? Щоб щось довести?",shape=box,color=red];
		j2544905005 -> j1813855774;
	j4187767555 [label="Але…",shape=box,color=blue];
		j4187767555 -> j1640499340;
	j4180714171 [label="Скоріш за все, це небезпечно. І тому я маю знати, як все правильно зробити. Без помилок.",shape=box,color=blue];
		j4180714171 -> j1640499340;
	"Chat ends. Next chat will be KayaRank2Convo2." [color=orange];
	j2636092600 [label="Тож дай мені ще кілька днів, можливо, кілька тижнів, і я розберуся в цьому всьому, і тоді до побачення 1999 рік.",shape=box,color=blue];
		j2636092600 -> j480546738;
	j674560806 [label="Заздрощі. Порівняння. Тьху. Мені вистачило такого життя. Не намагайся налаштовувати мене проти інших дівчат. ",shape=box,color=blue];
		j674560806 -> j2292283515;
	j1335223491 [label="Аой і Летті, здається, не можуть визначитися, чи хочуть вони стати тобі найкращою подругою чи мамою.",shape=box,color=red];
		j1335223491 -> j3702866472;
	j1634454693 [label="М-м-м. ",shape=box,color=blue];
		j1634454693 -> j3450109798;
	j1813855774 [label="Можливо.",shape=box,color=blue];
		j1813855774 -> j3409667781;
	j480546738 [label="От побачиш.",shape=box,color=blue];
		j480546738 -> j2292283515;
	j3702866472 [label="І, звісно, ​​я. Дуже тішуся, що хтось хоче зрозуміти, як сюди потрапила моя дупа.",shape=box,color=red];
		j3702866472 -> j408326203;
	j3450109798 [label="Маєш рацію. У тебе тут точно гарна репутація.",shape=box,color=blue];
		j3450109798 -> j992617149;
	j3409667781 [label="А тебе чому це хвилює?",shape=box,color=blue];
		j3409667781 -> j3873377679;
		j3409667781 -> j2938483525;
		j3409667781 -> j3140293500;
	j408326203 [label="Я вам справді… подобаюся?",shape=box,color=blue];
		j408326203 -> j2316723825;
		j408326203 -> j3151545935;
	j992617149 [label="І, здається, уі тобі довіряють або принаймні так кажуть.",shape=box,color=blue];
		j992617149 -> j3140293500;
		j992617149 -> j2938483525;
		j992617149 -> j3873377679;
	j3873377679 [label="Довіра до інших і спільна робота – це те, що робить нас тими, ким ми є. ",shape=box,color=red];
		j3873377679 -> j446252391;
	j2938483525 [label="Турбота про моїх друзів дає мені силу. Тому я терплю все це лайно.",shape=box,color=red];
		j2938483525 -> j446252391;
	j3140293500 [label="Усі ми маємо власні проблеми. Важко впоратися з цим поодинці.",shape=box,color=red];
		j3140293500 -> j446252391;
	j2316723825 [label="Ми просто чекаємо, щоб тобі було з нами комфортно.",shape=box,color=red];
		j2316723825 -> j2954202820;
	j3151545935 [label="Ти не можеш не подобатися. ",shape=box,color=red];
		j3151545935 -> j2954202820;
	j446252391 [label="ЛОЛ. Звучить як гасло для жіночого товариства.",shape=box,color=blue];
		j446252391 -> j378647612;
		j446252391 -> j929009807;
	j2954202820 [label="Я… зрозуміла.",shape=box,color=blue];
		j2954202820 -> j2292283515;
	j378647612 [label="Що таке «гасло жіночого товариства»?",shape=box,color=red];
		j378647612 -> j1126989760;
	j929009807 [label="Жіночого товариства? Що це?",shape=box,color=red];
		j929009807 -> j1126989760;
	j1126989760 [label="ЛОЛ. Ти серйозно? Мені справді потрібно в майбутнє, якщо там немає такого. Трясця.",shape=box,color=blue];
		j1126989760 -> j3492790654;
	j3492790654 [label="Не розумію…",shape=box,color=red];
		j3492790654 -> j2998762122;
	j2998762122 [label="В університетах збираються купки дівчат і називають себе сестрами та вдають, що це так. Мабуть, це як «клуб». ",shape=box,color=blue];
		j2998762122 -> j3720335369;
	j3720335369 [label="О, може, як «Сестри Парва»?",shape=box,color=red];
		j3720335369 -> j1520338385;
	j1520338385 [label="Звучить тупо. Тьху. Я трясця СПОДІВАЮСЯ, що це не справжнє жіноче товариство.",shape=box,color=blue];
		j1520338385 -> j917599053;
	j917599053 [label="Ну, вони намагаються мене вбити. Доволі часто.",shape=box,color=red];
		j917599053 -> j2206495199;
	j2206495199 [label="Мені здавалося, що мої теж намагалися вбити мене…",shape=box,color=blue];
		j2206495199 -> j2292283515;
}