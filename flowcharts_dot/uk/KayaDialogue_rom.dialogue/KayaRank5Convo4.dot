		j3919099667 -> j809422206 [label=false,color=brown];
	j809422206 [label="Можливо, я ніколи не виберуся звідси. Я змирилася з цим.",shape=box,color=blue];
		j809422206 -> j3583180210;
	j3606286280 [label="Що ж, перше, тепер ти можеш називати мене Каєю.",shape=box,color=blue];
		j3606286280 -> j3537603705;
	j3583180210 [label="Я вчуся приймати себе та не дозволяти жалю визначати мене.",shape=box,color=blue];
		j3583180210 -> j2248086454;
	j3537603705 [label="Тому що якщо хтось читає це, то це саме КАЯ ВЕЛАСКО знайшла відповіді.",shape=box,color=blue];
		j3537603705 -> j2986055743;
	j2248086454 [label="І якби я знайшла вихід, я ніби б зробила щось погане. Було б надто небезпечно для будь-кого слідувати за мною.",shape=box,color=blue];
		j2248086454 -> j1084906624;
	j2986055743 [label="Якщо шукатимете моє ім’я, знайдіть дві речі: що я РОЗВ'ЯЗАЛА проблему та ПОКИНУЛА 1999.",shape=box,color=blue];
		j2986055743 -> j1176724858;
	j1084906624 [label="Тож, робімо все, що в наших силах! Тут, у 1999.",shape=box,color=blue];
		j1084906624 -> j786640278;
		j1084906624 -> j1288697623;
	j1176724858 [label="І яку б мою фотку ви не знайшли, ця дівчина залишила вас усіх позаду. БУВАЙТЕ!",shape=box,color=blue];
		j1176724858 -> j596598717;
	j786640278 [label="1999 пощастило мати Каю Веласко.",shape=box,color=red];
		j786640278 -> j1491866842;
	j1288697623 [label="Будь-що може статися, я просто радію, що ми всі в цьому разом.",shape=box,color=red];
		j1288697623 -> j1491866842;
	j596598717 [label="Кає? Не може бути. Доведи.",shape=box,color=red];
		j596598717 -> j4174782750;
	j4174782750 [label="Без проблем. Знайди мене на Ларунді. Я буду чекати, милуючись зірками.",shape=box,color=blue];
