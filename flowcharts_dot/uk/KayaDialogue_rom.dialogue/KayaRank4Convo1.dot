digraph {
	541 [label="KayaRank4Convo1 begins.",color=orange];
		541 -> 542;
	542 [label="Хочеш знати, як це? З’являється інтернет, нам обіцяють так багато.",shape=box,color=blue];
		542 -> 543;
	543 [label="Отже, ти — це я. Тобі виповнюється 18. Ти входиш у мережу. Починаєш спілкуватися з новими друзями ЗВІДУСІЛЬ!",shape=box,color=blue];
		543 -> 544;
	544 [label="І ти, така собі відома «розумниця», робиш найдурнішу річ в інтернеті. ",shape=box,color=blue];
		544 -> 545;
	545 [label="Довіряєш людині на протилежному боці. ",shape=box,color=blue];
		545 -> 546;
	546 [label="І ти бачиш усю цю нову технологію та забуваєш, що люди не змінилися.",shape=box,color=blue];
		546 -> 547;
	547 [label="Тож ти надсилаєш свою оголену фотографію, від якої сама Луа почервоніє. Ти довіряєш комусь, кого ти зустріла в інтернеті. Ти ж можеш довіряти своєму онлайн-хлопцю. ",shape=box,color=blue];
		547 -> 548;
	548 [label="А вже наступного дня це фото всюди. Всі в університетському містечку його бачили. Поширили. Надіслали своїм ВИКЛАДАЧАМ. Через весь ІНТЕРНЕТ. Воно навіть у країнах, про які я не чула.",shape=box,color=blue];
		548 -> 549;
	549 [label="Я могла б бути найрозумнішою людиною на цій планеті, але люди пам’ятатимуть мене лише по цій фотографії.",shape=box,color=blue];
		549 -> 550;
	550 [label="Тож коли я кажу, що збираюся вшитися звідси, це факт. Я знаю, що ця фотка НІЧОГО не означає, життя йде, а люди тішаться чимось іншим.",shape=box,color=blue];
		550 -> 551;
	551 [label="Але мені це зруйнувало життя. Я хочу жити в майбутньому без інтернету. Я хочу довести, що можу подолати це. Повернення у минуле доводить ЇХНЮ правду, що я не можу з цим впоратися.",shape=box,color=blue];
		551 -> 552;
	552 [label="Тож чекай. Ти побачиш мене там, звідки ти. ",shape=box,color=blue];
		552 -> 553;
	553 [label="Тоді ми дивитимемося на світ і сміятимемося, що мій вибір мене не знищив. А зробив мене розумніше. Настільки, щоби вибратися.",shape=box,color=blue];
		553 -> 554;
	554 [label="+20 Chemistry",color=orange];
		554 -> 555;
	555 [label="Chat ends. Next chat will be KayaRank4Convo2.",color=orange];
}