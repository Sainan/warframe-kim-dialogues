digraph {
	graph [fontname="Roboto Condensed"];
	node [fontname="Roboto Condensed"];
	edge [fontname="Roboto Condensed"];

	"KayaRank4Convo1 begins." [color=orange];
		"KayaRank4Convo1 begins." -> j1143862553;
	j1143862553 [label="Хочеш знати, як це? З’являється інтернет, нам обіцяють так багато.",shape=box,color=blue];
		j1143862553 -> j2900286026;
	j2900286026 [label="Отже, ти — це я. Тобі виповнюється 18. Ти входиш у мережу. Починаєш спілкуватися з новими друзями ЗВІДУСІЛЬ!",shape=box,color=blue];
		j2900286026 -> j3524992547;
	j3524992547 [label="І ти, така собі відома «розумниця», робиш найдурнішу річ в інтернеті. ",shape=box,color=blue];
		j3524992547 -> j3419016782;
	j3419016782 [label="Довіряєш людині на протилежному боці. ",shape=box,color=blue];
		j3419016782 -> j231795657;
	j231795657 [label="І ти бачиш усю цю нову технологію та забуваєш, що люди не змінилися.",shape=box,color=blue];
		j231795657 -> j2632663942;
	j2632663942 [label="Тож ти надсилаєш свою оголену фотографію, від якої сама Луа почервоніє. Ти довіряєш комусь, кого ти зустріла в інтернеті. Ти ж можеш довіряти своєму онлайн-хлопцю. ",shape=box,color=blue];
		j2632663942 -> j2980041628;
	j2980041628 [label="А вже наступного дня це фото всюди. Всі в університетському містечку його бачили. Поширили. Надіслали своїм ВИКЛАДАЧАМ. Через весь ІНТЕРНЕТ. Воно навіть у країнах, про які я не чула.",shape=box,color=blue];
		j2980041628 -> j2400522276;
	j2400522276 [label="Я могла б бути найрозумнішою людиною на цій планеті, але люди пам’ятатимуть мене лише по цій фотографії.",shape=box,color=blue];
		j2400522276 -> j3887788422;
	j3887788422 [label="Тож коли я кажу, що збираюся вшитися звідси, це факт. Я знаю, що ця фотка НІЧОГО не означає, життя йде, а люди тішаться чимось іншим.",shape=box,color=blue];
		j3887788422 -> j58935223;
	j58935223 [label="Але мені це зруйнувало життя. Я хочу жити в майбутньому без інтернету. Я хочу довести, що можу подолати це. Повернення у минуле доводить ЇХНЮ правду, що я не можу з цим впоратися.",shape=box,color=blue];
		j58935223 -> j2776230875;
	j2776230875 [label="Тож чекай. Ти побачиш мене там, звідки ти. ",shape=box,color=blue];
		j2776230875 -> j128751643;
	j128751643 [label="Тоді ми дивитимемося на світ і сміятимемося, що мій вибір мене не знищив. А зробив мене розумніше. Настільки, щоби вибратися.",shape=box,color=blue];
		j128751643 -> j3258508148;
	j3258508148 [label="+20 Chemistry",color=orange];
		j3258508148 -> "Chat ends. Next chat will be KayaRank4Convo2.";
	"Chat ends. Next chat will be KayaRank4Convo2." [color=orange];
}