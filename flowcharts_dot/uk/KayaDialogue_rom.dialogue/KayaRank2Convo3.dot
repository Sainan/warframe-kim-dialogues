digraph {
	"KayaRank2Convo3 begins." [color=orange];
		"KayaRank2Convo3 begins." -> j3274662311;
	j3274662311 [label="Можеш пояснити механіку «Протеї»? Я знайшла певну інформацію про її кресленики, і мені потрібно підтвердити дещо.",shape=box,color=blue];
		j3274662311 -> j30300504;
		j3274662311 -> j307916536;
		j3274662311 -> j2735066983;
	j30300504 [label="Ні, не можу. [Завершити розмову]",shape=box,color=red];
		j30300504 -> j2189522063;
	j307916536 [label="Пояснити її механіку? Я можу спробувати.",shape=box,color=red];
		j307916536 -> j1413663167;
		j307916536 -> j1841343245;
	j2735066983 [label="Протеї? Вона складна.",shape=box,color=red];
		j2735066983 -> j253528610;
	j2189522063 [label="+20 Chemistry",color=orange];
		j2189522063 -> "Chat ends. Next chat will be KayaRank3Convo1.";
	j1413663167 [label="Кидай.",shape=box,color=red];
		j1413663167 -> j445669477;
	j1841343245 [label="Я припускаю, що ти цікавишся її Часовим якорем?",shape=box,color=red];
		j1841343245 -> j1586770188;
	j253528610 [label="І не лише через те, що вона вміє, а й через те, звідки вона з'явилася.",shape=box,color=red];
		j253528610 -> j4149634031;
		j253528610 -> j1841343245;
	"Chat ends. Next chat will be KayaRank3Convo1." [color=orange];
	j445669477 [label="Кидай?",shape=box,color=blue];
		j445669477 -> j1810384997;
		j445669477 -> j2736444320;
	j1586770188 [label="+5 Chemistry",color=orange];
		j1586770188 -> j231966424;
	j4149634031 [label="Ким би вона не була, тепер вона служить Парву Ґрануму.",shape=box,color=red];
		j4149634031 -> j336099955;
	j1810384997 [label="Кидай, а потім кидай ще.",shape=box,color=red];
		j1810384997 -> j1164013348;
	j2736444320 [label="Ти сама запитала.",shape=box,color=red];
		j2736444320 -> j2697530416;
	j231966424 [label="Ага.",shape=box,color=blue];
		j231966424 -> j2560971768;
	j336099955 [label="Так-так, великий поганець із купою грошей та мізками. Ніщо не змінюється.",shape=box,color=blue];
		j336099955 -> j2433345043;
		j336099955 -> j2201959012;
		j336099955 -> j2241653102;
	j1164013348 [label="Ем. Бувай? Бувай.",shape=box,color=blue];
		j1164013348 -> j2189522063;
	j2697530416 [label="Я запитала в надії почути про її часові здібності, принаймні з тих, що я бачила…",shape=box,color=blue];
		j2697530416 -> j2560971768;
	j2560971768 [label="Точно. Через подорожі в часі або її прояву здібностей маніпулювати часом.",shape=box,color=red];
		j2560971768 -> j2051114642;
	j2433345043 [label="Зустрічала таких?",shape=box,color=red];
		j2433345043 -> j2795177158;
	j2201959012 [label="Не завжди поганець, але ти доволі влучно сказала.",shape=box,color=red];
		j2201959012 -> j2715485210;
	j2241653102 [label="Йому багато за що потрібно відповісти. Занадто багато, щоби перераховувати, але Протея — у цьому списку.",shape=box,color=red];
		j2241653102 -> j3943179314;
	j2051114642 [label="Ага.",shape=box,color=blue];
		j2051114642 -> j358797746;
		j2051114642 -> j4138765182;
	j2795177158 [label="Ага.",shape=box,color=blue];
		j2795177158 -> j114932947;
	j2715485210 [label="Як скажеш.",shape=box,color=blue];
		j2715485210 -> j3943179314;
	j3943179314 [label="Тож мені варто спитати в НЬОГО?",shape=box,color=blue];
		j3943179314 -> j3817899808;
		j3943179314 -> j3970814348;
	j358797746 [label="Тому що чомусь все, про що Нова питає в цього єдиного мандрівника в часі, якого вона знає, це про подорожі в часі.",shape=box,color=red];
		j358797746 -> j3277589859;
	j4138765182 [label="Тому що ти справді не здасися? Не те, що я хочу, щоб ти здалася, але я дійсно не знаю, як тобі допомогти.",shape=box,color=red];
		j4138765182 -> j2882517880;
	j114932947 [label="Декан мого університету був таким самим. Якщо я КОЛИСЬ побачу його знову…",shape=box,color=blue];
		j114932947 -> j3601428848;
	j3817899808 [label="Якщо ти хочеш стати піддослідною пацючкою до кінця свого життя, то звичайно.",shape=box,color=red];
		j3817899808 -> j1079036743;
	j3970814348 [label="Я не думаю, що тобі слід зв’язуватися з ним, навіть якби це було можливо.",shape=box,color=red];
		j3970814348 -> j1285769051;
	j3277589859 [label="+5 Chemistry",color=orange];
		j3277589859 -> j2170249426;
	j2882517880 [label="Протея, подробиці. Наприклад, чи є у неї така, як я? Ну знаєш, така недоробка?",shape=box,color=blue];
		j2882517880 -> j1907317809;
		j2882517880 -> j458879861;
	j3601428848 [label="Я думала, що він стане на мій бік, але…",shape=box,color=blue];
		j3601428848 -> j955834005;
		j3601428848 -> j2647206251;
	j1079036743 [label="Та стати проданою тому, хто запропонує найвищу ціну.",shape=box,color=red];
		j1079036743 -> j4244918732;
	j1285769051 [label="Зупинімося на речах, які допоможуть тобі тут.",shape=box,color=red];
		j1285769051 -> j565544955;
	j2170249426 [label="Ага.",shape=box,color=blue];
		j2170249426 -> j1902764384;
	j1907317809 [label="Саме ця недоробка розв’яже проблему подорожей у часі. Віддай собі належне.",shape=box,color=red];
		j1907317809 -> j444375656;
	j458879861 [label="Протея — це ворфрейм. Це те, що ми знаємо.",shape=box,color=red];
		j458879861 -> j1436312853;
	j955834005 [label="Що ж із тобою сталося в університеті?",shape=box,color=red];
		j955834005 -> j4153546762;
	j2647206251 [label="Стане на твій бік у чому?",shape=box,color=red];
		j2647206251 -> j4153546762;
	j4244918732 [label="Він розумний, а не хороший. Я не думаю, що він буде союзником.",shape=box,color=red];
		j4244918732 -> j678944571;
	j565544955 [label="Часових… речах.",shape=box,color=red];
		j565544955 -> j358797746;
	j1902764384 [label="Я ДУЖЕ рада, що ти нарешті розумієш.",shape=box,color=blue];
		j1902764384 -> j4292297219;
		j1902764384 -> j3775185587;
	j444375656 [label="+5 Chemistry",color=orange];
		j444375656 -> j3676375186;
	j1436312853 [label="Шкода.",shape=box,color=blue];
		j1436312853 -> j597108746;
	j4153546762 [label="Ем, назвемо це «Нова проти інтернету».",shape=box,color=blue];
		j4153546762 -> j417763754;
	j678944571 [label="Думаю.",shape=box,color=blue];
		j678944571 -> j2188621012;
	j4292297219 [label="А що, як у мене є питання про 1999-й до тебе?",shape=box,color=red];
		j4292297219 -> j4002931157;
	j3775185587 [label="А ти мені дозволиш хоч інколи питати в тебе про щось?",shape=box,color=red];
		j3775185587 -> j4002931157;
	j3676375186 [label="Твоя правда.",shape=box,color=blue];
		j3676375186 -> j597108746;
	j597108746 [label="Але…",shape=box,color=blue];
		j597108746 -> j4002931157;
	j417763754 [label="Дурна-дурна Нова.",shape=box,color=blue];
		j417763754 -> j2496792152;
	j2188621012 [label="Гм. Що ж, припустімо, що Протея має найдосконаліше розуміння часу з усіх творінь.",shape=box,color=blue];
		j2188621012 -> j1120494290;
	j4002931157 [label="Справа ось у чому, я тобі все розкажу.",shape=box,color=blue];
		j4002931157 -> j486869844;
	j2496792152 [label="У оцінках немає сенсу, якщо вчителі не пускають тебе на заняття.",shape=box,color=blue];
		j2496792152 -> j1920402975;
		j2496792152 -> j3998592904;
	j1120494290 [label="Це розуміння базується на теорії, науці, вроджених здібностях чи… гм. ",shape=box,color=blue];
		j1120494290 -> j2523111165;
	j486869844 [label="Я подорожуватиму в часі, як ти це робиш.",shape=box,color=blue];
		j486869844 -> j232384710;
	j1920402975 [label="Світ зараз інший.",shape=box,color=red];
		j1920402975 -> j4067290072;
	j3998592904 [label="Якщо ти колись захочеш поговорити про це…",shape=box,color=red];
		j3998592904 -> j4067290072;
	j2523111165 [label="Або, гм. Власне. Скажімо, що Порожнеча має до цього відношення.",shape=box,color=blue];
		j2523111165 -> j94845320;
		j2523111165 -> j3474406692;
	j232384710 [label="І я дістануся туди, звідки ТИ.",shape=box,color=blue];
		j232384710 -> j1852811903;
	j4067290072 [label="Я знаю-ю-ю-ю, знаю-ю-ю…",shape=box,color=blue];
		j4067290072 -> j2799999053;
	j94845320 [label="Не можна просто взяти й «розв’язати» Порожнечу.",shape=box,color=red];
		j94845320 -> j3337767964;
	j3474406692 [label="Порожнеча має відношення до… всього.",shape=box,color=red];
		j3474406692 -> j1295361359;
	j1852811903 [label="І тоді я знатиму, чи це все було брехнею, чи я справді можу тобі довіряти, і я знатиму, що чекає в майбутньому.",shape=box,color=blue];
		j1852811903 -> j1951942213;
	j2799999053 [label="Скажу тобі ось що: щойно я розберуся в «подорожах у часі», я розповім тобі більше. Мені нічого буде втрачати.",shape=box,color=blue];
		j2799999053 -> j2189522063;
	j3337767964 [label="Але я можу нею СКОРИСТАТИСЯ! Ха! Мені треба дещо перевірити.",shape=box,color=blue];
		j3337767964 -> j1111793669;
	j1295361359 [label="А для мене це все може означати початок ще одного тесту. ПА-ПА! ",shape=box,color=blue];
		j1295361359 -> j1111793669;
	j1951942213 [label="Отже, я повертаюся до свого навчання! Дещо про Протею… гм.",shape=box,color=blue];
		j1951942213 -> j2189522063;
	j1111793669 [label="Стривай, обережніше там!",shape=box,color=red];
		j1111793669 -> j4088838641;
	j4088838641 [label="Boolean KayaVoidTest is now true.",color=orange];
		j4088838641 -> j2189522063;
}