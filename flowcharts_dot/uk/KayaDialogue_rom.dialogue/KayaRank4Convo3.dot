	629 [label="Га?",shape=box,color=blue];
		629 -> 636;
	630 [label="Саме так! Звісно, є кілька нюансів. Найнадійніший і безпечний шлях — повернутися ТОЧНО в той час, звідки ти, адже саме там є щось на зразок «відбитка пальця Порожнечі».",shape=box,color=blue];
		630 -> 619;
		630 -> 620;
