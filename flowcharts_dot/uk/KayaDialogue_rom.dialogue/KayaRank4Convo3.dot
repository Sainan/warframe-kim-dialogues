digraph {
	"KayaRank4Convo3 begins." [color=orange];
		"KayaRank4Convo3 begins." -> j1224397646;
	j1224397646 [label="Я тобі довіряю.",shape=box,color=blue];
		j1224397646 -> j3957957814;
	j3957957814 [label="Але це не означає, що я залишаюся тут і не втечу.",shape=box,color=blue];
		j3957957814 -> j1723073833;
		j3957957814 -> j3612887197;
		j3957957814 -> j2791232692;
	j1723073833 [label="Мене дуже тішить, що тепер ми довіряємо одне одному [Кінець]",shape=box,color=red];
		j1723073833 -> j465934596;
	j3612887197 [label="Наскільки ти близька до своєї «втечі»?",shape=box,color=red];
		j3612887197 -> j3636280105;
	j2791232692 [label="Що тебе переконало?",shape=box,color=red];
		j2791232692 -> j2261103371;
	j465934596 [label="+20 Chemistry",color=orange];
		j465934596 -> "Chat ends. Next chat will be KayaRank4Convo4.";
	j3636280105 [label="Г-м-м, можеш запитати мене завтра знову?",shape=box,color=blue];
		j3636280105 -> j2591366070;
	j2261103371 [label="Я знаю, що ми вже да-а-авно не в школі.",shape=box,color=blue];
		j2261103371 -> j683878908;
	"Chat ends. Next chat will be KayaRank4Convo4." [color=orange];
	j2591366070 [label="Може дуже близька, я натрапила на дещо.",shape=box,color=blue];
		j2591366070 -> j3717429290;
		j2591366070 -> j3027893133;
	j683878908 [label="Але не треба бути малою генійкою, щоб побачити, що ти справді дбаєш про нас. І ми всі тебе поважаємо.",shape=box,color=blue];
		j683878908 -> j2894270875;
	j3717429290 [label="Ти близька до втечі з 1999?",shape=box,color=red];
		j3717429290 -> j3551652125;
	j3027893133 [label="Який головний навід?",shape=box,color=red];
		j3027893133 -> j732155524;
	j2894270875 [label="Навіть Артур. По-перше, я від нього шаленію, боже мій.",shape=box,color=blue];
		j2894270875 -> j1211137507;
	j3551652125 [label="Саме так! Звісно, є кілька нюансів. Найнадійніший і безпечний шлях — повернутися ТОЧНО в той час, звідки ти, адже саме там є щось на зразок «відбитка пальця Порожнечі».",shape=box,color=blue];
		j3551652125 -> j1830868369;
		j3551652125 -> j4109270749;
		j3551652125 -> j3387024543;
	j732155524 [label="Ти, звісно.",shape=box,color=blue];
		j732155524 -> j4262868436;
		j732155524 -> j787001389;
	j1211137507 [label="Check boolean ArthurDating",color=orange];
		j1211137507 -> j2023808475 [label=true,color=green];
		j1211137507 -> j4070364993 [label=false,color=brown];
		j1211137507 -> j3426309134 [label=false,color=brown];
	j1830868369 [label="Отже, ти досі впевнена в цьому?",shape=box,color=red];
		j1830868369 -> j2228314110;
	j4109270749 [label="Мій час не набагато кращий, але я принаймні можу допомогти.",shape=box,color=red];
		j4109270749 -> j2486482364;
	j3387024543 [label="Гм, Порожнеча досить серйозно ставиться до пальців.",shape=box,color=red];
		j3387024543 -> j3166560362;
	j4262868436 [label="Певно в мені щось особливе.",shape=box,color=red];
		j4262868436 -> j3551652125;
	j787001389 [label="Я?",shape=box,color=red];
		j787001389 -> j3551652125;
	j2023808475 [label="Ти ж знаєш, що він зі мною, так?",shape=box,color=red];
		j2023808475 -> j2516903324;
	j4070364993 [label="Я замовлю добре слово.",shape=box,color=red];
		j4070364993 -> j8430682;
	j3426309134 [label="Гидота.",shape=box,color=red];
		j3426309134 -> j2000269542;
	j2228314110 [label="Дуже. Це виклик. Що буде, те буде, еге ж? Мовляв, це тримає мене зайнятою, зосередженою…",shape=box,color=blue];
		j2228314110 -> j2916330170;
	j2486482364 [label="Саме так! Спалімо мости! Не озираймося!",shape=box,color=blue];
		j2486482364 -> j465934596;
	j3166560362 [label="Га?",shape=box,color=blue];
		j3166560362 -> j983016044;
	j2516903324 [label="Пф-ф, та знаю, тобі ПОЩАСТИЛО! Менше з тим.",shape=box,color=blue];
		j2516903324 -> j1770992080;
	j8430682 [label="ПФ-Ф. НІ, будь ласка, не треба. Я сказала це поміж нас! Менше з тим…",shape=box,color=blue];
		j8430682 -> j1770992080;
	j2000269542 [label="Га, чи ти не при собі? Це зовсім не гидота. МЕНШЕ З ТИМ!",shape=box,color=blue];
		j2000269542 -> j1770992080;
	j2916330170 [label="Недоліків немає. Або я знайду відповіді, або ні. Побачимося тут або побачимося там. Правильно? Тоді до зустрічі!",shape=box,color=blue];
		j2916330170 -> j465934596;
	j983016044 [label="Усе це, все, що робив Ентраті. Його гонитва за Порожнечею, за суттю… всього цього.",shape=box,color=red];
		j983016044 -> j1823860499;
	j1770992080 [label="У певному сенсі це схоже на школу, де ти всім подобаєшся.",shape=box,color=blue];
		j1770992080 -> j1477924341;
	j1823860499 [label="Зводиться до 1 пальця. Пальця.",shape=box,color=red];
		j1823860499 -> j4154209701;
	j1477924341 [label="І це говорить про щось глибше, ніж просто про популярність.",shape=box,color=blue];
		j1477924341 -> j3010304112;
	j4154209701 [label="Ви хряпнули з Артуром пива? Чому не можна було попередити раніше?",shape=box,color=blue];
		j4154209701 -> j1478849392;
		j4154209701 -> j3918377973;
		j4154209701 -> j624056871;
	j3010304112 [label="Ми тут всі по-своєму схиблені. ",shape=box,color=blue];
		j3010304112 -> j2095886968;
		j3010304112 -> j3491413839;
		j3010304112 -> j1413373629;
	j1478849392 [label="Порожнеча. Про це не пишуть у підручниках.",shape=box,color=red];
		j1478849392 -> j2530170132;
	j3918377973 [label="Кухоль пива, імовірно, допоміг би зрозуміти краще.",shape=box,color=red];
		j3918377973 -> j2530170132;
	j624056871 [label="Це не те, про що ти ось так попереджуєш. Це кінець і початок.",shape=box,color=red];
		j624056871 -> j2530170132;
	j2095886968 [label="Схиблені і зайняті! Вітаємо в команді. [Кінець]",shape=box,color=red];
		j2095886968 -> j465934596;
	j3491413839 [label="Як думаєш, хто з нас схиблений найбільше?",shape=box,color=red];
		j3491413839 -> j3195916533;
	j1413373629 [label="Це комплімент?",shape=box,color=red];
		j1413373629 -> j2538722929;
	j2530170132 [label="Але що ти маєш на увазі під «одним пальцем»?",shape=box,color=blue];
		j2530170132 -> j2414629790;
		j2530170132 -> j2711996354;
	j3195916533 [label="Боже… хочеш попліткувати? Після того, що я щойно сказала? ",shape=box,color=blue];
		j3195916533 -> j1299804368;
	j2538722929 [label="Цілком. 100 %. Бо тут ніхто не змагається.",shape=box,color=blue];
		j2538722929 -> j1283024605;
	j2414629790 [label="У Альбрехта є палець із сутності.",shape=box,color=red];
		j2414629790 -> j1504840793;
	j2711996354 [label="Там є палець із… сутності. У моєму часі. У нашому світі, гадаю.",shape=box,color=red];
		j2711996354 -> j1504840793;
	j1299804368 [label="(Але, очевидно, що це Артур, тому що я розмовляла з ним, і звучить так, ніби він справді з’їхав з глузду після ваших розмов).",shape=box,color=blue];
		j1299804368 -> j2013069196;
	j1283024605 [label="Це найдивніша річ. Ми перетворюємося на монстрів, але саме зараз я почуваюся людиною найбільше.",shape=box,color=blue];
		j1283024605 -> j3889504582;
	j1504840793 [label="Зрозуміла, тож матерія зберігається, дякую!",shape=box,color=blue];
		j1504840793 -> j4290648254;
	j2013069196 [label="Що, до речі, підтвердило мою гіпотезу про твій фізичний зв’язок із 1999-м.",shape=box,color=blue];
		j2013069196 -> j4289380058;
	j3889504582 [label="Тепер я нарешті можу бути собою.",shape=box,color=blue];
		j3889504582 -> j3841455823;
	j4290648254 [label="Це все?",shape=box,color=red];
		j4290648254 -> j2533230716;
	j4289380058 [label="Що актуально, тому що… о! Тестування завершено. Поговорімо пізніше.",shape=box,color=blue];
		j4289380058 -> j465934596;
	j3841455823 [label="Я більше не боюся.",shape=box,color=blue];
		j3841455823 -> j3885277677;
	j2533230716 [label="Не «що це за сутність»? Навіщо їй палець?",shape=box,color=red];
		j2533230716 -> j88849376;
	j3885277677 [label="Тож, дякую?",shape=box,color=blue];
		j3885277677 -> j465934596;
	j88849376 [label="Ти з цим упораєшся. Мені цікавіше перевірити стан збереження матерії. Дякую!",shape=box,color=blue];
		j88849376 -> j465934596;
}