		614 -> 617;
	615 [label="Навіть Артур. По-перше, я від нього шаленію, боже мій.",shape=box,color=blue];
		615 -> 618;
	616 [label="Саме так! Звісно, є кілька нюансів. Найнадійніший і безпечний шлях — повернутися ТОЧНО в той час, звідки ти, адже саме там є щось на зразок «відбитка пальця Порожнечі».",shape=box,color=blue];
