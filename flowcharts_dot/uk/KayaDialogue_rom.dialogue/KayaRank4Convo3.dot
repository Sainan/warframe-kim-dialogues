	633 [label="Пф-ф, та знаю, тобі ПОЩАСТИЛО! Менше з тим.",shape=box,color=blue];
		633 -> 637;
	632 [label="ПФ-Ф. НІ, будь ласка, не треба. Я сказала це поміж нас! Менше з тим…",shape=box,color=blue];
		632 -> 637;
	631 [label="Га, чи ти не при собі? Це зовсім не гидота. МЕНШЕ З ТИМ!",shape=box,color=blue];
		631 -> 637;
	634 [label="Недоліків немає. Або я знайду відповіді, або ні. Побачимося тут або побачимося там. Правильно? Тоді до зустрічі!",shape=box,color=blue];
