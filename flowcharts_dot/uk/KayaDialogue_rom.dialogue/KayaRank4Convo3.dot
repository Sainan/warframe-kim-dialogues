	624 [label="Гидота.",shape=box,color=red];
		624 -> 631;
	627 [label="Дуже. Це виклик. Що буде, те буде, еге ж? Мовляв, це тримає мене зайнятою, зосередженою…",shape=box,color=blue];
		627 -> 634;
	628 [label="Саме так! Спалімо мости! Не озираймося!",shape=box,color=blue];
