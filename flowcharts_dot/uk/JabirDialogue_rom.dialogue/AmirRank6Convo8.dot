		4380 -> 4382;
	4381 [label="не звинувачуватиму тебе, він доволі класнючий",shape=box,color=blue];
		4381 -> 4382;
	4382 [label="отже погнали",shape=box,color=blue];
		4382 -> 4383;
	4383 [label="«Ти посеред електролабораторії, поруч звільнений Замір. Він дивиться на тебе й каже: „Не марнуймо часу, іди за мною”».",shape=box,color=blue];
		4383 -> 4384;
	4384 [label="«Він веде тебе численними коридорами. Таке враження, що знає астероїд як свої 5 пальців — де стоять вартові, як вони патрулюють».",shape=box,color=blue];
		4384 -> 4385;
		4384 -> 4386;
		4384 -> 4387;
	4385 [label="Спитаю в Заміра про пацюків.",shape=box,color=red];
		4385 -> 4388;
	4386 [label="Спитаю, чи Замір теж в’язень.",shape=box,color=red];
		4386 -> 4389;
	4387 [label="Спитаю в Заміра куди він мене веде.",shape=box,color=red];
		4387 -> 4390;
	4388 [label="«Замір шокований: „Пацюки знайшли тебе? Неймовірно. Спрацювало, значить. Поглянь, — він показує золотий свисток із хитромудрим різьбленням на поверхні. — Його дала Королева Пацюків. Треба відшукати її”».",shape=box,color=blue];
		4388 -> 4391;
	4389 [label="«На запитання про те, як Замір сюди потрапив він відмахнувся, бо „нема на такі дурниці часу, треба зосередитися на втечі”».",shape=box,color=blue];
		4389 -> 4385;
		4389 -> 4387;
	4390 [label="«Замір кидає через плече: „Ми йдемо до ангара. Викрадемо зореліт і чкурнемо якнайдалі звідси. Треба відшукати Королеву Пацюків”».",shape=box,color=blue];
		4390 -> 4391;
	4391 [label="«КОРОЛЕВУ ПАЦЮКІВ?»",shape=box,color=red];
		4391 -> 4392;
	4392 [label="«Замір відповідає: „Вона дала мені цей свисток. Пацюки підкоряються йому. Вона — моя подруга. Не завжди приємна, але дбайлива”».",shape=box,color=blue];
		4392 -> 4393;
		4392 -> 4394;
	4393 [label="Ти часом не показував цю частину Летті?",shape=box,color=red];
		4393 -> 4395;
	4394 [label="Щось мені знайомий цей опис.",shape=box,color=red];
		4394 -> 4396;
	4395 [label="я занадто ціную своє життя, щоб так ризикувати",shape=box,color=blue];
		4395 -> 4397;
	4396 [label="будь-яка схожість із людьми або подіями вигаданими чи справжніми абсолютна випадковість",shape=box,color=blue];
		4396 -> 4397;
	4397 [label="«З допомогою Заміра ти пробираєшся численними коридорами астероїда. Він спритно уникає постів вартових та нагляду камер спостереження».",shape=box,color=blue];
		4397 -> 4398;
	4398 [label="«Зрештою ви доходите до великої брами ангара. Замір подає знаки принишкнути. Обоє присідаєте й прокрадаєтеся всередину».",shape=box,color=blue];
		4398 -> 4399;
	4399 [label="«Попереду колонна. Відкидає достатню тінь, щоб сховатися від вартових, які прямують у ваші бік і балакають між собою».",shape=box,color=blue];
		4399 -> 4400;
	4400 [label="«Що ти зробиш?»",shape=box,color=blue];
		4400 -> 4401;
		4400 -> 4402;
	4401 [label="Нападу на вартових.",shape=box,color=red];
		4401 -> 4403;
	4402 [label="Пороззираюся довкола.",shape=box,color=red];
		4402 -> 4404;
	4403 [label="«Жодної тіні сумнівів і роздумів про самозбереження чи прорахунок наслідків — ти кидаєшся на відкритий простір. Патруль відкриває вогонь на звук. Залп різнокаліберних куль миттєво розриває тебе на шматки. Замір хитає головою, спостерігаючи за цим безглуздим проявом беззмістовної хоробрості».",shape=box,color=blue];
		4403 -> 4405;
	4404 [label="«Ти визираєш з-поза колони й оглядаєш місцину».",shape=box,color=blue];
		4404 -> 4406;
	4405 [label="хочеш спробувати ще й не загинути миттєво цього разу?",shape=box,color=blue];
		4405 -> 4407;
		4405 -> 4408;
	4406 [label="«У центрі ангара стоїть рейкоджек. Рампа на борт заблокована вартовим. З іншого боку ангара десяток ґрінерів бурхливо кидають кісточки, гучно радіючи вдалому кидку або лаючись у разі невдачі. За кілька кроків поперед вами панель керування».",shape=box,color=blue];
		4406 -> 4409;
	4407 [label="Аякженько.",shape=box,color=red];
		4407 -> 4410;
	4408 [label="На сьогодні досить. [Завершити розмову]",shape=box,color=red];
		4408 -> 4411;
