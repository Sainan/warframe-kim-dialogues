	j2011642366 [label="Змушу Заміра скористатися пацючим свистком.",shape=box,color=red];
		j2011642366 -> j943820753;
	j4157584278 [label="Скористаюся панеллю керування.",shape=box,color=red];
		j4157584278 -> j4139268779;
	j1474651421 [label="Побіжу до рейкоджека.",shape=box,color=red];
		j1474651421 -> j187760065;
	j777853 [label="Змушу Заміра напасти на вартового рампи.",shape=box,color=red];
		j777853 -> j3161563569;
	j943820753 [label="«Замір підносить свисток до губ і довго висвистує одну ноту. Ти нічого не чуєш, окрім свого дихання. Сидиш, чекаєш, але нічого не відбувається. Ані пацюки, ані щось інше не з’являються. Замір стинає плечима».",shape=box,color=blue];
		j943820753 -> j684001548;
	j4139268779 [label="«Ти дістаєшся до панелі керування, але вартовий тебе бачить. Ти намагаєшся підійняти руки догори й здатися, але ґрінерам усе одно, вони не беруть полонених. Вогневий шквал розриває твою голову на шматки».",shape=box,color=blue];
		j4139268779 -> j2549171065;
		j4139268779 -> j2057577400;
	j187760065 [label="«Ти прожогом кидаєшся до рейкоджека, але вартовий тебе бачить і відкриває вогонь на ураження. Цей день, твоє життя і ця авантюрна спроба закінчуються дуже болісно. Смертельно болісно».",shape=box,color=blue];
		j187760065 -> j2549171065;
		j187760065 -> j657142568;
	j3161563569 [label="ну звісно щойно де яка небезпека так усі посилають аміра",shape=box,color=blue];
		j3161563569 -> j3070939312;
	j684001548 [label="«Але раптом до тебе долинає тихий хрускіт. Наче хтось щось гризе. Несподівано з усіх вентиляційних отворів ангара вириваються незлічимі потоки пацюків. Ґрінери верещать наче школярки й відкривають вогонь з усіх стволів. Кулі, лазери, вогонь, крига, електричні розряди, отруйні хмари й гранати летять навсібіч».",shape=box,color=blue];
		j684001548 -> j1633891563;
	j2549171065 [label="Мені потрібна перерва. [Завершити розмову]",shape=box,color=red];
		j2549171065 -> j118191782;
	j2057577400 [label="Ще раз.",shape=box,color=red];
		j2057577400 -> j318932394;
	j657142568 [label="Знову!",shape=box,color=red];
		j657142568 -> j1595881847;
	j3070939312 [label="ой я мав на увазі заміра",shape=box,color=blue];
		j3070939312 -> j3744686978;
	j1633891563 [label="«Пацюки відвернули увагу вартових на себе. Що далі?»",shape=box,color=blue];
		j1633891563 -> j3778065781;
		j1633891563 -> j1190937725;
	j118191782 [label="ти ще повернешся",shape=box,color=blue];
		j118191782 -> "Chat ends.";
	j318932394 [label="Boolean OneMoreTime is now true.",color=orange];
		j318932394 -> j774369477;
	j1595881847 [label="Boolean Again is now true.",color=orange];
		j1595881847 -> j774369477;
	j3744686978 [label="добренько",shape=box,color=blue];
		j3744686978 -> j2229419300;
	j3778065781 [label="Змушу Заміра вразити вартового струмом!",shape=box,color=red];
		j3778065781 -> j3379644192;
	j1190937725 [label="Відчиню шлюз за допомогою панелі керування.",shape=box,color=red];
		j1190937725 -> j2790691389;
	j2229419300 [label="«Ти кричиш: „Заміре, хапай його!”, вказуючи на вартового рампи».",shape=box,color=blue];
		j2229419300 -> j3275959572;
	j3379644192 [label="«Замір кидається на вартового й знешкоджує його високовольтним електричним розрядом. Бідолаха безсило падає».",shape=box,color=blue];
		j3379644192 -> j3028613594;
	j2790691389 [label="«Ти прокрадаєшся до панелі керування й намагаєшся використати консоль, докладаючи всіх зусиль робити це непомітно. Тобі вдається відчинити браму шлюзу».",shape=box,color=blue];
		j2790691389 -> j2223195969;
	j3275959572 [label="«Попри здоровий ґлузд і наслідки Замір відважно кидається вперед. Але навіть його швидкості забракувало. Вартові почали стріляти й Замір трагічно гине».",shape=box,color=blue];
		j3275959572 -> j3161626927;
	j3028613594 [label="Boolean RampGuardZapped is now true.",color=orange];
		j3028613594 -> j1915017362;
	j2223195969 [label="«Вартові настільки зайняті знищенням гризунів, що нічого не помічають».",shape=box,color=blue];
		j2223195969 -> j256735146;
	j3161626927 [label="ось і все, гру завершено",shape=box,color=blue];
		j3161626927 -> j929268613;
