	j2000069369 [label="«За мить сотні пацюків стрімголов забігають на зореліт. Замір дивиться на вас і кричить: „РУШАЙ!”».",shape=box,color=blue];
		j2000069369 -> j3495226395;
	j3495226395 [label="«Зореліт злітає. Уцілілі ґрінери відкривають вогонь, але звичайна зброя не завдає шкоди величному рейкоджеку, який вилітає у шлюз».",shape=box,color=blue];
		j3495226395 -> j1291668590;
	j1291668590 [label="«Пацюки скупчилися на містку, ти вдивляєшся у безмежжя космосу й упевнено вимовляєш: „РЕЙКОРУШІЇ — ПУСК!”. І рейкоджек мчить у гіперпростір, лишивши яскравий спалах на віддалі».",shape=box,color=blue];
		j1291668590 -> j2048149837;
