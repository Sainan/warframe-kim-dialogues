		4453 -> 4458;
	4459 [label="«Ти дивишся на Заміра й кажеш: „Сподіваюся, що ти знаєш як літати на цій штуці”, а у відповідь лунає: „Я не знаю, але це знаєш ти”».",shape=box,color=blue];
		4459 -> 4462;
