		j1886405399 -> j3302699975;
	j3848902813 [label="«Ти дивишся на Заміра й кажеш: „Сподіваюся, що ти знаєш як літати на цій штуці”, а у відповідь лунає: „Я не знаю, але це знаєш ти”».",shape=box,color=blue];
		j3848902813 -> j3126489616;
	j3530295428 [label="«Замір вказує на вартового рампи».",shape=box,color=blue];
		j3530295428 -> j3778065781;
	j769413847 [label="Boolean KeepZabirAlive is now true.",color=orange];
		j769413847 -> j774369477;
	j3302699975 [label="ти мене просто морально вбиваєш",shape=box,color=blue];
		j3302699975 -> "Chat ends.";
	j3126489616 [label="«Ти запускаєш системи судна й ледь не натискаєш кнопку підняття рампи та зачинення входу, як Замір кричить: „Зажди! Ми не можемо лишити їх тут!”».",shape=box,color=blue];
		j3126489616 -> j2935581247;
		j3126489616 -> j330322691;
	j2935581247 [label="Так, ми повинні врятувати їх.",shape=box,color=red];
		j2935581247 -> j647487831;
	j330322691 [label="Я скажу: «Тільки не це. Нам треба лишити їх тут».",shape=box,color=red];
		j330322691 -> j3491283880;
	j647487831 [label="«Замір дістає свисток і дме в нього».",shape=box,color=blue];
