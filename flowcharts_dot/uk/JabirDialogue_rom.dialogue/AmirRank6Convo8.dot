		4441 -> 4444;
	4442 [label="Відчиню шлюз за допомогою панелі керування.",shape=box,color=red];
		4442 -> 4445;
	4439 [label="Chat ends.",color=orange];
	4440 [label="«Ти кричиш: „Заміре, хапай його!”, вказуючи на вартового рампи».",shape=box,color=blue];
		4440 -> 4443;
	4444 [label="«Замір кидається на вартового й знешкоджує його високовольтним електричним розрядом. Бідолаха безсило падає».",shape=box,color=blue];
		4444 -> 4447;
	4445 [label="«Ти прокрадаєшся до панелі керування й намагаєшся використати консоль, докладаючи всіх зусиль робити це непомітно. Тобі вдається відчинити браму шлюзу».",shape=box,color=blue];
		4445 -> 4448;
	4443 [label="«Попри здоровий ґлузд і наслідки Замір відважно кидається вперед. Але навіть його швидкості забракувало. Вартові почали стріляти й Замір трагічно гине».",shape=box,color=blue];
		4443 -> 4446;
	4447 [label="Update boolean RampGuardZapped",color=orange];
		4447 -> 4450;
	4448 [label="«Вартові настільки зайняті знищенням гризунів, що нічого не помічають».",shape=box,color=blue];
