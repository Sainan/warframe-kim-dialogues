	4457 [label="Update boolean KeepZabirAlive",color=orange];
		4457 -> 4414;
	4458 [label="ти мене просто морально вбиваєш",shape=box,color=blue];
		4458 -> 4461;
	4462 [label="«Ти запускаєш системи судна й ледь не натискаєш кнопку підняття рампи та зачинення входу, як Замір кричить: „Зажди! Ми не можемо лишити їх тут!”».",shape=box,color=blue];
		4462 -> 4463;
		4462 -> 4464;
	4461 [label="Chat ends.",color=orange];
	4463 [label="Я скажу: «Так, ми повинні врятувати їх».",shape=box,color=red];
		4463 -> 4465;
	4464 [label="Я скажу: «Тільки не це. Нам треба лишити їх тут».",shape=box,color=red];
		4464 -> 4466;
	4465 [label="«Замір дістає свисток і дме в нього».",shape=box,color=blue];
		4465 -> 4467;
	4466 [label="«„ПРОПОЗИЦІЮ ВІДХИЛЕНО”, — відповідає Замір».",shape=box,color=blue];
		4466 -> 4465;
	4467 [label="«За мить сотні пацюків стрімголов забігають на зореліт. Замір дивиться на вас і кричить: „РУШАЙ!”».",shape=box,color=blue];
		4467 -> 4468;
	4468 [label="«Зореліт злітає. Уцілілі ґрінери відкривають вогонь, але звичайна зброя не завдає шкоди величному рейкоджеку, який вилітає у шлюз».",shape=box,color=blue];
		4468 -> 4469;
	4469 [label="«Пацюки скупчилися на містку, ти вдивляєшся у безмежжя космосу й упевнено вимовляєш: „РЕЙКОРУШІЇ — ПУСК!”. І рейкоджек мчить у гіперпростір, лишивши яскравий спалах на віддалі».",shape=box,color=blue];
		4469 -> 4470;
	4470 [label="«КІНЕЦЬ».",shape=box,color=blue];
		4470 -> 4471;
	4471 [label="Ого.",shape=box,color=red];
		4471 -> 4472;
	4472 [label="то як тобі завершення? не занадто божевільне?",shape=box,color=blue];
		4472 -> 4473;
		4472 -> 4474;
	4473 [label="У мене просто немає слів.",shape=box,color=red];
		4473 -> 4475;
	4474 [label="Занадто. І це мені до вподоби.",shape=box,color=red];
