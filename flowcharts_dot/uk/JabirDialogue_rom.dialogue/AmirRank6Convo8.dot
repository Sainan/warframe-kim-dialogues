		j256735146 -> j1087431613;
	j929268613 [label="ще одна спроба? спробуєш зберегти життя заміру?",shape=box,color=blue];
		j929268613 -> j2578901914;
		j929268613 -> j1886405399;
	j2870420911 [label="«Ти відчуваєш, що саме час, тож біжиш до рейкоджека».",shape=box,color=blue];
		j2870420911 -> j3848902813;
	j1196094034 [label="«Замір махає, вказуючи на потребу відчиненої брами ангара».",shape=box,color=blue];
