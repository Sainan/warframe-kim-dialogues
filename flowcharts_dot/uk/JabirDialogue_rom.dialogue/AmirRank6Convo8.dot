		j2673831328 -> j1734044093;
	j1734044093 [label="отже погнали",shape=box,color=blue];
		j1734044093 -> j2191969834;
	j2191969834 [label="«Ти посеред електролабораторії, поруч звільнений Замір. Він дивиться на тебе й каже: „Не марнуймо часу, іди за мною”».",shape=box,color=blue];
		j2191969834 -> j1861329511;
	j1861329511 [label="«Він веде тебе численними коридорами. Таке враження, що знає астероїд як свої 5 пальців — де стоять вартові, як вони патрулюють».",shape=box,color=blue];
		j1861329511 -> j309881448;
		j1861329511 -> j3310444874;
		j1861329511 -> j3612956990;
	j309881448 [label="Спитаю в Заміра про пацюків.",shape=box,color=red];
		j309881448 -> j2768106649;
	j3310444874 [label="Спитаю, чи Замір теж в’язень.",shape=box,color=red];
		j3310444874 -> j3591416064;
	j3612956990 [label="Спитаю в Заміра куди він мене веде.",shape=box,color=red];
		j3612956990 -> j1505737047;
	j2768106649 [label="«Замір шокований: „Пацюки знайшли тебе? Неймовірно. Спрацювало, значить. Поглянь, — він показує золотий свисток із хитромудрим різьбленням на поверхні. — Його дала Королева Пацюків. Треба відшукати її”».",shape=box,color=blue];
		j2768106649 -> j2985567316;
	j3591416064 [label="«На запитання про те, як Замір сюди потрапив він відмахнувся, бо „нема на такі дурниці часу, треба зосередитися на втечі”».",shape=box,color=blue];
		j3591416064 -> j309881448;
		j3591416064 -> j3612956990;
	j1505737047 [label="«Замір кидає через плече: „Ми йдемо до ангара. Викрадемо зореліт і чкурнемо якнайдалі звідси. Треба відшукати Королеву Пацюків”».",shape=box,color=blue];
		j1505737047 -> j2985567316;
	j2985567316 [label="«КОРОЛЕВУ ПАЦЮКІВ?»",shape=box,color=red];
		j2985567316 -> j2579606801;
	j2579606801 [label="«Замір відповідає: „Вона дала мені цей свисток. Пацюки підкоряються йому. Вона — моя подруга. Не завжди приємна, але дбайлива”».",shape=box,color=blue];
		j2579606801 -> j3919153225;
		j2579606801 -> j3260352792;
	j3919153225 [label="Ти часом не показував цю частину Летті?",shape=box,color=red];
		j3919153225 -> j3285380667;
	j3260352792 [label="Щось мені знайомий цей опис.",shape=box,color=red];
		j3260352792 -> j92283903;
	j3285380667 [label="я занадто ціную своє життя, щоб так ризикувати",shape=box,color=blue];
		j3285380667 -> j4129117949;
	j92283903 [label="будь-яка схожість із людьми або подіями вигаданими чи справжніми абсолютна випадковість",shape=box,color=blue];
		j92283903 -> j4129117949;
	j4129117949 [label="«З допомогою Заміра ти пробираєшся численними коридорами астероїда. Він спритно уникає постів вартових та нагляду камер спостереження».",shape=box,color=blue];
		j4129117949 -> j2558225974;
	j2558225974 [label="«Зрештою ви доходите до великої брами ангара. Замір подає знаки принишкнути. Обоє присідаєте й прокрадаєтеся всередину».",shape=box,color=blue];
		j2558225974 -> j1078276424;
	j1078276424 [label="«Попереду колонна. Відкидає достатню тінь, щоб сховатися від вартових, які прямують у ваші бік і балакають між собою».",shape=box,color=blue];
		j1078276424 -> j99890393;
	j99890393 [label="«Що ти зробиш?»",shape=box,color=blue];
		j99890393 -> j2380310814;
		j99890393 -> j1810886087;
	j2380310814 [label="Нападу на вартових.",shape=box,color=red];
		j2380310814 -> j23070757;
	j1810886087 [label="Пороззираюся довкола.",shape=box,color=red];
		j1810886087 -> j955943129;
	j23070757 [label="«Жодної тіні сумнівів і роздумів про самозбереження чи прорахунок наслідків — ти кидаєшся на відкритий простір. Патруль відкриває вогонь на звук. Залп різнокаліберних куль миттєво розриває тебе на шматки. Замір хитає головою, спостерігаючи за цим безглуздим проявом беззмістовної хоробрості».",shape=box,color=blue];
		j23070757 -> j1383931084;
	j955943129 [label="«Ти визираєш з-поза колони й оглядаєш місцину».",shape=box,color=blue];
		j955943129 -> j2565453512;
	j1383931084 [label="хочеш спробувати ще й не загинути миттєво цього разу?",shape=box,color=blue];
		j1383931084 -> j2874238695;
		j1383931084 -> j3751968646;
	j2565453512 [label="«У центрі ангара стоїть рейкоджек. Рампа на борт заблокована вартовим. З іншого боку ангара десяток ґрінерів бурхливо кидають кісточки, гучно радіючи вдалому кидку або лаючись у разі невдачі. За кілька кроків поперед вами панель керування».",shape=box,color=blue];
		j2565453512 -> j2416794067;
	j2874238695 [label="Аякженько.",shape=box,color=red];
		j2874238695 -> j3731861519;
	j3751968646 [label="На сьогодні досить. [Завершити розмову]",shape=box,color=red];
		j3751968646 -> "Chat ends.";
	j2416794067 [label="«Замір шепоче: „Щоб вибратися, треба спершу відчинити шлюзову браму ангара”».",shape=box,color=blue];
		j2416794067 -> j2059656784;
