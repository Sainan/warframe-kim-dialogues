	4423 [label="Змушу Заміра скористатися пацючим свистком.",shape=box,color=red];
		4423 -> 4427;
	4421 [label="Скористаюся панеллю керування.",shape=box,color=red];
		4421 -> 4425;
	4424 [label="Побіжу до рейкоджека.",shape=box,color=red];
		4424 -> 4428;
	4422 [label="Змушу Заміра напасти на вартового рампи.",shape=box,color=red];
		4422 -> 4426;
	4427 [label="«Замір підносить свисток до губ і довго висвистує одну ноту. Ти нічого не чуєш, окрім свого дихання. Сидиш, чекаєш, але нічого не відбувається. Ані пацюки, ані щось інше не з’являються. Замір стинає плечима».",shape=box,color=blue];
		4427 -> 4432;
	4425 [label="«Ти дістаєшся до панелі керування, але вартовий тебе бачить. Ти намагаєшся підійняти руки догори й здатися, але ґрінерам усе одно, вони не беруть полонених. Вогневий шквал розриває твою голову на шматки».",shape=box,color=blue];
		4425 -> 4429;
		4425 -> 4430;
	4428 [label="«Ти прожогом кидаєшся до рейкоджека, але вартовий тебе бачить і відкриває вогонь на ураження. Цей день, твоє життя і ця авантюрна спроба закінчуються дуже болісно. Смертельно болісно».",shape=box,color=blue];
		4428 -> 4429;
		4428 -> 4433;
	4426 [label="ну звісно щойно де яка небезпека так усі посилають аміра",shape=box,color=blue];
		4426 -> 4431;
	4432 [label="«Але раптом до тебе долинає тихий хрускіт. Наче хтось щось гризе. Несподівано з усіх вентиляційних отворів ангара вириваються незлічимі потоки пацюків. Ґрінери верещать наче школярки й відкривають вогонь з усіх стволів. Кулі, лазери, вогонь, крига, електричні розряди, отруйні хмари й гранати летять навсібіч».",shape=box,color=blue];
		4432 -> 4437;
	4429 [label="Мені потрібна перерва. [Завершити розмову]",shape=box,color=red];
		4429 -> 4434;
	4430 [label="Ще раз.",shape=box,color=red];
		4430 -> 4435;
	4433 [label="Знову!",shape=box,color=red];
		4433 -> 4438;
	4431 [label="ой я мав на увазі заміра",shape=box,color=blue];
		4431 -> 4436;
	4437 [label="«Пацюки відвернули увагу вартових на себе. Що далі?»",shape=box,color=blue];
		4437 -> 4441;
		4437 -> 4442;
	4434 [label="ти ще повернешся",shape=box,color=blue];
