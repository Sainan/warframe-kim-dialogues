		4218 -> 4220;
	4219 [label="Ти показував цю частину Летті?",shape=box,color=red];
		4219 -> 4221;
	4220 [label="«Пацюки оточили тебе. Ти стоїш прямо, у повній готовності до бою, але вони не нападають. Натомість найбільший схиляє перед тобою голову. Ти бачиш щось на шиї тварини. Срібний ланцюжок ковзає вниз, прикраса падає. Вигляд пацюка ніби говорить: „це тобі”».",shape=box,color=blue];
		4220 -> 4222;
		4220 -> 4223;
	4221 [label="ні та й не збирався",shape=box,color=blue];
		4221 -> 4224;
	4222 [label="Підійму прикрасу.",shape=box,color=red];
