	j1678378329 [label="«Ти у великому порожньому приміщенні. Якийсь підвал? Єдиним цікавим об’єктом є важкі металеві двері».",shape=box,color=blue];
		j1678378329 -> j2896993042;
		j1678378329 -> j2829974852;
	j2896993042 [label="Дай угадаю — двері замкнено?",shape=box,color=red];
		j2896993042 -> j2972407968;
	j2829974852 [label="Я можу відчинити двері?",shape=box,color=red];
		j2829974852 -> j2972407968;
	j2972407968 [label="«Двері замкнено».",shape=box,color=blue];
		j2972407968 -> j1926487112;
	j1926487112 [label="«Ти прислухаєшся й чуєш якийсь тихий звук. Це… писк?».",shape=box,color=blue];
		j1926487112 -> j3839554745;
		j1926487112 -> j87775264;
	j3839554745 [label="Тільки не кажи, що то пацюки.",shape=box,color=red];
		j3839554745 -> j3914690877;
	j87775264 [label="Пацюки, правда ж?",shape=box,color=red];
		j87775264 -> j3914690877;
	j3914690877 [label="це ДОВБАНІ ПАЦЮКИ!!",shape=box,color=blue];
		j3914690877 -> j363565262;
	j363565262 [label="тобто…",shape=box,color=blue];
		j363565262 -> j1755228764;
	j1755228764 [label="«Писк стає гучнішим, його супроводжує приглушене цокання кігтів по каменю. Раптово ти бачиш як світло смолоскипа відкидає тінь. Пацюк розміром із кота… ні… пса… біжить просто на тебе».",shape=box,color=blue];
		j1755228764 -> j2631431357;
	j2631431357 [label="«Але почвара не одна — вони лізуть звідусіль».",shape=box,color=blue];
		j2631431357 -> j3510973856;
		j2631431357 -> j3909580676;
		j2631431357 -> j1753803119;
	j3510973856 [label="Дам пацюку копняка.",shape=box,color=red];
		j3510973856 -> j3514872455;
	j3909580676 [label="Відмахуватимуся смолоскипом.",shape=box,color=red];
		j3909580676 -> j3514872455;
	j1753803119 [label="Ти показував цю частину Летті?",shape=box,color=red];
		j1753803119 -> j2032673211;
	j3514872455 [label="«Пацюки оточили тебе. Ти стоїш прямо, у повній готовності до бою, але вони не нападають. Натомість найбільший схиляє перед тобою голову. Ти бачиш щось на шиї тварини. Срібний ланцюжок ковзає вниз, прикраса падає. Вигляд пацюка ніби говорить: „це тобі”».",shape=box,color=blue];
		j3514872455 -> j3531755452;
		j3514872455 -> j2021726064;
	j2032673211 [label="ні та й не збирався",shape=box,color=blue];
		j2032673211 -> j2087701041;
	j3531755452 [label="Підійму прикрасу.",shape=box,color=red];
		j3531755452 -> j1225111205;
	j2021726064 [label="Спитаю пацюка хто відправник прикраси?",shape=box,color=red];
		j2021726064 -> j2076040833;
	j2087701041 [label="пацюки наближаються, що робитимеш?",shape=box,color=blue];
		j2087701041 -> j3510973856;
		j2087701041 -> j3909580676;
	j1225111205 [label="«Ти підіймаєш прикрасу. На ланцюжку є ключ».",shape=box,color=blue];
		j1225111205 -> j2435497172;
	j2076040833 [label="«Пацюк не відповідає. Зрештою, це ж пацюк».",shape=box,color=blue];
		j2076040833 -> j2435497172;
	j2435497172 [label="«Пацюки розвертаються й розбігаються. Хто б їм не дав того ключа — вони знали, що ти тут унизу. Єдина особа з такою силою… Лотос».",shape=box,color=blue];
		j2435497172 -> j4180408014;
	j4180408014 [label="Ключ? Він відімкне замок дверей?",shape=box,color=red];
		j4180408014 -> j39839037;
	j39839037 [label="«Ти вставляєш ключ у шпаринку, провертаєш… Спрацювало! Ти примружуєшся від болісного яскравого світла, яке сяє по той бік дверей. Ти не віриш своїм очам…».",shape=box,color=blue];
		j39839037 -> j748860972;
	j748860972 [label="і…",shape=box,color=blue];
		j748860972 -> j3258487742;
	j3258487742 [label="на цьому все, бо далі ще не придумав",shape=box,color=blue];
