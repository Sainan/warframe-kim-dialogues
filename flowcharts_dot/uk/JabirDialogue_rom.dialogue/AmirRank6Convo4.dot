		j3402987656 -> j3219476615;
	j1238793814 [label="«Ти береш смолоскип зі сподіваннями, що полум’я не згасне. Ідеш далі коридором. Проходиш повз порожні камери, геть усі однакові».",shape=box,color=blue];
