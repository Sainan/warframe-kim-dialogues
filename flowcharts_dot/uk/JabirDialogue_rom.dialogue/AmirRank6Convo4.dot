	4215 [label="«Писк стає гучнішим, його супроводжує приглушене цокання кігтів по каменю. Раптово ти бачиш як світло смолоскипа відкидає тінь. Пацюк розміром із кота… ні… пса… біжить просто на тебе».",shape=box,color=blue];
		4215 -> 4216;
	4216 [label="«Але почвара не одна — вони лізуть звідусіль».",shape=box,color=blue];
		4216 -> 4217;
