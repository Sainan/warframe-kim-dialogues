	j2124211691 [label="серйозно, оце і є твій хід?",shape=box,color=blue];
		j2124211691 -> j2468684860;
	j221085784 [label="Check boolean FlintTaken",color=orange];
		j221085784 -> j1211355420 [label=true,color=green];
		j221085784 -> j3763095044 [label=false,color=brown];
	j2881502137 [label="«Ти обережно вислизаєш із камери. Праворуч від тебе великі двері — вихід. Двері ледь прочинені, а з-поза них чутно балаканину інших ґрінерських вартових. Коридор ліворуч веде в глибини підземелля, але там занадто темно, щоб щось розгледіти».",shape=box,color=blue];
		j2881502137 -> j1405298677;
	j2468684860 [label="добренько",shape=box,color=blue];
		j2468684860 -> j3874036392;
	j1211355420 [label="«Обшуки тіла вартового не принесли нічого цінного. Майнула думка з’їсти запліснявіле печивко, але підозрілий запах миттєво змусив тебе передумати».",shape=box,color=blue];
		j1211355420 -> j3451620922;
	j3763095044 [label="«Ти оглядаєш тіло та все навкруги в пошуках чогось цінного. Однак нічого немає, окрім запліснявілого печива та кременя. Ти береш кремінь».",shape=box,color=blue];
		j3763095044 -> j3506528764;
	j1405298677 [label="Check boolean TorchTaken",color=orange];
		j1405298677 -> j1222136269 [label=true,color=green];
		j1405298677 -> j3965288434 [label=false,color=brown];
	j3874036392 [label="«Ти зачиняєш двері й чекаєш на допомогу, але ніхто не приходить. Окрім зміни вартових, які дуже розлютилися через смерть свого друга. І тепер вони роблять із тобою усілякі жахливі злі речі, допоки не приходить моторошна беззмістовна смерть».",shape=box,color=blue];
		j3874036392 -> j4106128273;
