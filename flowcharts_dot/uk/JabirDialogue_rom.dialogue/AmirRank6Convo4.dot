		4168 -> 4174;
	4171 [label="«Ти намагаєшся підсвітити крізь щілини. Раптовий вітерець ледь не гасить полум’я. Чутно як по той бік падають краплі… води?».",shape=box,color=blue];
		4171 -> 4166;
