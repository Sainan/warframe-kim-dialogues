	4123 [label="Check boolean FlintTaken",color=orange];
		4123 -> 4126 [label=true,color=green];
		4123 -> 4127 [label=false,color=brown];
	4124 [label="«Ти обережно вислизаєш із камери. Праворуч від тебе великі двері — вихід. Двері ледь прочинені, а з-поза них чутно балаканину інших ґрінерських вартових. Коридор ліворуч веде в глибини підземелля, але там занадто темно, щоб щось розгледіти».",shape=box,color=blue];
		4124 -> 4128;
	4125 [label="добренько",shape=box,color=blue];
		4125 -> 4129;
	4126 [label="«Обшуки тіла вартового не принесли нічого цінного. Майнула думка з’їсти запліснявіле печивко, але підозрілий запах миттєво змусив тебе передумати».",shape=box,color=blue];
		4126 -> 4130;
	4127 [label="«Ти оглядаєш тіло та все навкруги в пошуках чогось цінного. Однак нічого немає, окрім запліснявілого печива та кременя. Ти береш кремінь».",shape=box,color=blue];
