		4197 -> 4202;
	4195 [label="Chat ends.",color=orange];
	4198 [label="«Ти присідаєш і заповзаєш у тунель. Повільне просування створює такий біль, що кілька хвилин видаються вічністю. Шлях холодний, вологий і дуже-дуже брудний».",shape=box,color=blue];
		4198 -> 4203;
	4199 [label="Якщо уперед лише один шлях — я лізу в тунель.",shape=box,color=red];
