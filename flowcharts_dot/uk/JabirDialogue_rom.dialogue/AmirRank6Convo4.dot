		j766049040 -> j3795429303;
	j3925582960 [label="Зачиню двері й чекатиму допомоги, а тим часом завершу проведення переобліку припасів. [Завершити розмову]",shape=box,color=red];
		j3925582960 -> j2124211691;
	j1709318159 [label="Я можу обшукати тіло вартового?",shape=box,color=red];
		j1709318159 -> j221085784;
	j2629035917 [label="Я хочу вийти в коридор.",shape=box,color=red];
