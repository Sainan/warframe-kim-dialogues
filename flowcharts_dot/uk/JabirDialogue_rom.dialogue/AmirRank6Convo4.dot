		j778975496 -> j89327940;
	j3795429303 [label="«Ти стоїш у камері над тілом убитого ґрінера. Ніяк не можеш викинути з голови його останні слова: „Тобі ніколи не знайти свою Лотос”».",shape=box,color=blue];
