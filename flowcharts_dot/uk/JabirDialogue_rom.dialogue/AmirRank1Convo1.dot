	33 [label="Тож давай про свідомих.",shape=box,color=red];
		33 -> 38;
	34 [label="Вони правили Материнською системою. Верхівка мала доступ до вічного життя завдяки ритуалу, на ім’я Безперервність.",shape=box,color=red];
		34 -> 39;
	36 [label="Це така організація роботолюбців і плутократів, одержимих прибутком. Якщо це принесе зайвий кредит, то вони зроблять будь-що.",shape=box,color=red];
		36 -> 40;
	37 [label="Генетично мутовані клони, яких початково створили простими робітниками, а потім внесли в ДНК військовий штам для битви зі свідомими…",shape=box,color=red];
		37 -> 41;
	38 [label="Свідомі — штучна раса, яка не повинна була існувати. Їх створили орокіни дуже-дуже давно у минулому.",shape=box,color=red];
		38 -> 42;
	39 [label="Вони примусово переміщали свою свідомість у чиєсь тіло, використовуючи певну речовину — куву.",shape=box,color=red];
		39 -> 43;
	40 [label="Зараз їх очолює один тип — Парв Ґранум. Він виріс у родині бідного фермера за часів орокінів, але заснував культ прибутку — Корпус.",shape=box,color=red];
		40 -> 44;
	41 [label="Свідомі — це… ем… синтетична раса, яка як зло. Окрім Лотос, яка не зло. Але її зовнішність і частина особистості сформована з Марґуліс, яка була архімедівкою.",shape=box,color=red];
		41 -> 45;
	42 [label="Гадаю, що не у твоєму минулому? Твоєму майбутньому? Неважливо. Ці часові переміщення.",shape=box,color=red];
		42 -> 46;
	43 [label="Але тепер ґрінери самі полюють на куву, бо орокінів майже всіх знищили під час Давньої війни. Зокрема завдяки одному орокіну, який був ще тим мудилом.",shape=box,color=red];
		43 -> 47;
	44 [label="Він мав бути вже давно мертвим. Усі думали, що його вбили. Але дідугану вдалося втекти у «Порожнечу Ґранума». Може там він і збожеволів?",shape=box,color=red];
		44 -> 48;
	45 [label="Орокіни — стара раса, яка створила ґрінерів. Орокіни колись владарювали в Материнській системі. Менше з тим.",shape=box,color=red];
		45 -> 49;
	46 [label="Менше з тим. Штучна раса. Їх послали на Тау, щоби провести процеси тераформування — підготувати планету для орокінів. Однак свідомі вирішили, що орокіни перетворять Тау на пустку, як зробили з Материнською системою, й оголосили своїм творцям війну.",shape=box,color=red];
		46 -> 50;
	47 [label="Його звали Балласом. Він очолював галузь ворфреймів і створив більшість з них. Разом з Ентраті? Може той теж був орокіном? Але той Баллас, як і Марґуліс, теж були ще тими кадрами.",shape=box,color=red];
		47 -> 51;
	48 [label="Одне я знаю точно — він не буде проти вкладання угоди зі свідомими. Інший корпусівець, Алад В, уже зробив це.",shape=box,color=red];
		48 -> 52;
	49 [label="Отже, ґрінери — генетичні клони, які все більше деградують і ще в них є навіжена Королева, і…",shape=box,color=red];
		49 -> 35;
	50 [label="Однак Нату піймали й утримували в ув’язненні на Луа, допоки Баллас не переніс на неї відбиток особистості та зовнішності Марґуліс, щоб мати змогу контролювати тенно.",shape=box,color=red];
		50 -> 54;
	51 [label="Та жінка, на яку схоже Лотос, але то не вона, бо Лотос насправді свідома, а вони — штучна раса, яка по суті зло, але не вона…",shape=box,color=red];
		51 -> 35;
	52 [label="О так, свідомі. Це штучна раса — ти б їх роботами назвав — яка зло по суті, окрім Лотос, яка не зло, але сформована на…",shape=box,color=red];
