		j2381449682 -> j2160505750;
	j1923591244 [label="КГМ",shape=box,color=blue];
		j1923591244 -> j1527708848;
	j2797574448 [label="«Гострогубці швидко перекушують кабелі, під’єднані до чоловіка. Вивільнивши руки, він може зняти кайдани».",shape=box,color=blue];
		j2797574448 -> j1941052427;
	j1627651581 [label="«Ти примірюєшся гострогубцями, щоб якнайбільше кабелів перекусити, але миттєво про це шкодуєш. Електричні розряди перебігають інструментом у твоє тіло й відправляють його в політ на інший бік приміщення».",shape=box,color=blue];
		j1627651581 -> j1784055461;
	j503226976 [label="«Минулого разу все пройшло не дуже добре».",shape=box,color=blue];
