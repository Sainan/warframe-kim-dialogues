	"Chat ends. Next chat will be AmirRank6Convo3." [color=orange];
	"Chat ends. Next chat will be AmirRank6Convo2." [color=orange];
	j231718380 [label="«Ти стоїш перед великим службовим підіймачем. Це якесь не просте підземелля?»",shape=box,color=blue];
		j231718380 -> j845517326;
		j231718380 -> j2214247920;
	j845517326 [label="Повертаюся в підземелля.",shape=box,color=red];
		j845517326 -> j4083915793;
	j2214247920 [label="Використовую підіймач.",shape=box,color=red];
		j2214247920 -> j2619652302;
	j4083915793 [label="«Ти обертаєшся й дивишся у бік підземелля, думаючи, що повертатися туди буде дуже тупо».",shape=box,color=blue];
		j4083915793 -> j4233121259;
	j2619652302 [label="«Підіймач несе тебе вгору. Кабіна без стінок. Ти бачиш, як кам’яні стіни підземелля поступово замінюються набагато технологічнішими поверхнями. Ти знову розмірковуєш де ж це в біса ти є?».",shape=box,color=blue];
		j2619652302 -> j402890442;
	j4233121259 [label="ХА, дуже смішно. Добре, я скористаюся підіймачем.",shape=box,color=red];
		j4233121259 -> j2619652302;
	j402890442 [label="«Вихід із підіймача розташовано у приміщенні з велетенськими колбами та якоюсь булькотливою машинерією. Це якась лабораторія?».",shape=box,color=blue];
		j402890442 -> j2355039794;
	j2355039794 [label="«Десь на віддалі чутно крики людини. Крики болю».",shape=box,color=blue];
		j2355039794 -> j2432141483;
		j2355039794 -> j2574134353;
	j2432141483 [label="Ігнорую верески, шукаю вихід.",shape=box,color=red];
		j2432141483 -> j2818823713;
	j2574134353 [label="Іду на крики.",shape=box,color=red];
		j2574134353 -> j3357626694;
	j2818823713 [label="«Ти оглядаєш приміщення в пошуках чогось цінного, але верески неможливо ігнорувати. Ти йдеш на крики, щоб допомогти».",shape=box,color=blue];
		j2818823713 -> j3357626694;
	j3357626694 [label="«Ти йдеш на крики агонії. Входиш до великої кімнати з механізмами й бачиш чоловіка. Доволі симпатичного хлопця, прив’язаного до машини. З його пальців зриваються електричні розряди, які живлять велетенську турбіну».",shape=box,color=blue];
		j3357626694 -> j3167193346;
		j3357626694 -> j3878589746;
	j3167193346 [label="Я запитую: «Як життя?».",shape=box,color=red];
		j3167193346 -> j3949172425;
	j3878589746 [label="Огляну цього чоловіка.",shape=box,color=red];
		j3878589746 -> j3949172425;
	j3949172425 [label="«Чоловік прив’язаний до платформи на підвищенні — руки розведені в різні сторони. До кінчиків пальців прилаштовані клеми, від яких дроти сходяться у товсті кабелі й під’єднуються до величезної турбіни. Електричні розряди танцюють на його долонях».",shape=box,color=blue];
		j3949172425 -> j1451986951;
	j1451986951 [label="«Між криками та розрядами електрики чоловіку вдається промовити: „ЗУПИНИ… ЦІ… ТУРБІНИ!!!”».",shape=box,color=blue];
		j1451986951 -> j235411521;
	j235411521 [label="Огляну приміщення.",shape=box,color=red];
		j235411521 -> j1156522313;
	j1156522313 [label="«Ти озираєшся довкола в пошуках чогось корисного. На очі трапляється стіл з інструментами. Цвяходер. Величезні гострогубці. О, панель керування».",shape=box,color=blue];
		j1156522313 -> j1571667540;
