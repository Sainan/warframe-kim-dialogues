	j2901879016 [label="«Ти помічаєш його сильні руки, розвинуті м’язи ніг та відсутність зайвого жиру. „Він створений для швидкості”, — з’являється раптова думка, а брова здивовано повзе догори».",shape=box,color=blue];
		j2901879016 -> j1537763015;
