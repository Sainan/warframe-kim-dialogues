		j1941052427 -> j3499241272;
	j1784055461 [label="«Ковзнувши стіною на підлогу й трохи відлежавшись, ти підіймаєшся. Чоловік досі кричить від болю, а кожна волосинка на твоєму тілі стоїть дибки».",shape=box,color=blue];
