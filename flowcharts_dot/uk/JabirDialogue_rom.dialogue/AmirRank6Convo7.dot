	4268 [label="«Ти стоїш перед великим службовим підіймачем. Це якесь не просте підземелля?»",shape=box,color=blue];
		4268 -> 4269;
		4268 -> 4270;
	4269 [label="Повертаюся в підземелля.",shape=box,color=red];
		4269 -> 4271;
	4270 [label="Використовую підіймач.",shape=box,color=red];
		4270 -> 4272;
	4271 [label="«Ти обертаєшся й дивишся у бік підземелля, думаючи, що повертатися туди буде дуже тупо».",shape=box,color=blue];
		4271 -> 4273;
	4272 [label="«Підіймач несе тебе вгору. Кабіна без стінок. Ти бачиш, як кам’яні стіни підземелля поступово замінюються набагато технологічнішими поверхнями. Ти знову розмірковуєш де ж це в біса ти є?».",shape=box,color=blue];
		4272 -> 4274;
	4273 [label="ХА, дуже смішно. Добре, я скористаюся підіймачем.",shape=box,color=red];
		4273 -> 4272;
	4274 [label="«Вихід із підіймача розташовано у приміщенні з велетенськими колбами та якоюсь булькотливою машинерією. Це якась лабораторія?».",shape=box,color=blue];
		4274 -> 4275;
	4275 [label="«Десь на віддалі чутно крики людини. Крики болю».",shape=box,color=blue];
		4275 -> 4276;
		4275 -> 4277;
	4276 [label="Ігнорую верески, шукаю вихід.",shape=box,color=red];
		4276 -> 4278;
	4277 [label="Іду на крики.",shape=box,color=red];
		4277 -> 4279;
	4278 [label="«Ти оглядаєш приміщення в пошуках чогось цінного, але верески неможливо ігнорувати. Ти йдеш на крики, щоб допомогти».",shape=box,color=blue];
		4278 -> 4279;
	4279 [label="«Ти йдеш на крики агонії. Входиш до великої кімнати з механізмами й бачиш чоловіка. Доволі симпатичного хлопця, прив’язаного до машини. З його пальців зриваються електричні розряди, які живлять велетенську турбіну».",shape=box,color=blue];
		4279 -> 4280;
		4279 -> 4281;
	4280 [label="Я запитую: «Як життя?».",shape=box,color=red];
		4280 -> 4282;
	4281 [label="Огляну цього чоловіка.",shape=box,color=red];
		4281 -> 4282;
	4282 [label="«Чоловік прив’язаний до платформи на підвищенні — руки розведені в різні сторони. До кінчиків пальців прилаштовані клеми, від яких дроти сходяться у товсті кабелі й під’єднуються до величезної турбіни. Електричні розряди танцюють на його долонях».",shape=box,color=blue];
		4282 -> 4283;
	4283 [label="«Між криками та розрядами електрики чоловіку вдається промовити: „ЗУПИНИ… ЦІ… ТУРБІНИ!!!”».",shape=box,color=blue];
		4283 -> 4284;
