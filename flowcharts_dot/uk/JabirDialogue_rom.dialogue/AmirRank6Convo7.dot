		4319 -> 4325;
	4320 [label="«Ти примірюєшся гострогубцями, щоб якнайбільше кабелів перекусити, але миттєво про це шкодуєш. Електричні розряди перебігають інструментом у твоє тіло й відправляють його в політ на інший бік приміщення».",shape=box,color=blue];
