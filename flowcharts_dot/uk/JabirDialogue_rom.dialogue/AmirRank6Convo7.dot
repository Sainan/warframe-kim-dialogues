		j2334064620 -> j931614746;
	j3945788346 [label="«Ти намагаєшся скористатися панеллю керування, але вона заблокована протоколами безпеки, який навіть і приблизно тобі не знайомий, а отже — незламний. Приходить розуміння, що доведеться все робити вручну».",shape=box,color=blue];
