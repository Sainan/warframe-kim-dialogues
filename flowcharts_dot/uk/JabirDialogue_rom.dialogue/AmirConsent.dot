	j3316821453 [label="Boolean AmirConsentComplete is now true.",color=orange];
		j3316821453 -> "Chat ends.";
	j3348984560 [label="Хочу обговорити з тобою дещо, дізнатися, чи ти не проти, перш ніж усе зайде занадто далеко.",shape=box,color=red];
		j3348984560 -> j4089831100;
	j4089831100 [label="Ми про це раніше не говорили. Я не хочу, щоб у тебе була думка, що я брешу чи якось нечесно поводжуся.",shape=box,color=red];
		j4089831100 -> j3393293046;
	j3393293046 [label="ааааеешооооооотрапилосявбитокогосьнетогочипомерхтосьхочазаждицебулобнедивномаєбутищосьдивнішеаніжцеТИЗУСТРІЧАЄШСЯЗГІТАРОЮ?ОНІ!!!!!!!!!",shape=box,color=blue];
		j3393293046 -> j3104833422;
		j3393293046 -> j1470802555;
	j3104833422 [label="Я знаю, що це може мати дивний вигляд, але мої почуття до тебе ані на краплину не змінилися.",shape=box,color=red];
		j3104833422 -> j1746990258;
	j1470802555 [label="Ну, щонайменше, це точно не гітара… Дивись, я знаю, що це може мати дивний вигляд, але мої почуття до тебе ані на краплину не змінилися.",shape=box,color=red];
		j1470802555 -> j3086358792;
	j1746990258 [label="звиняймозокзастрягнапоетнційнійможливостітвоїхобіймівзгітароюпобудьтуттребаперезавантажитися",shape=box,color=blue];
		j1746990258 -> j4053010344;
	j3086358792 [label="+5 Chemistry",color=orange];
		j3086358792 -> j1746990258;
	j4053010344 [label="іііііііІІІІІІІІІІІІІІІІІІІІІІІІІІІ ми знову тут. пробач, то про що ти?",shape=box,color=blue];
		j4053010344 -> j326921204;
	j326921204 [label="ти… у тебе є ще ХТОСЬ десь? чи… колись? це ж… не з прокльонівців… так… ні? …… бооооооооцеееееееебууууууулоб дуууууужеееее дикккккккккоооооооооооо",shape=box,color=blue];
		j326921204 -> j328660906;
	j328660906 [label="це наче б ви зустрічалися з моєю двоюрідною лейлою фефефефефеуееуеуеуеефефуее",shape=box,color=blue];
		j328660906 -> j2266427202;
		j328660906 -> j3006171565;
	j2266427202 [label="Ні, це не з «Прокльону». Не гітара. І не твоя двоюрідна сестра. ",shape=box,color=red];
		j2266427202 -> j2615279814;
	j3006171565 [label="Уперше чую, що в тебе є двоюрідна сестра.",shape=box,color=red];
		j3006171565 -> j2742945407;
	j2615279814 [label="АГА ЗНАЧИТЬ В ТЕБЕ ТИПУ ЩЕ ОДНІ СТОСУНКИ!?!?!?!?!?",shape=box,color=blue];
		j2615279814 -> j1013849117;
	j2742945407 [label="ну ха ми про це ніколи й не говорили про мою родину СТІЛЬКИ ВСЯКОГО ІНШОГО ЛАЙНА У НАС Є ДЛЯ РОЗМОВ ЯК ОТ ЩО В ТЕБЕ Є ЩЕ ОДНІ СТОСУНКИ З КИМОСЬ!?!?!?!?!?",shape=box,color=blue];
		j2742945407 -> j1013849117;
	j1013849117 [label="Я розумію, що тобі від цього дуже незручно. І хочу дати тобі зрозуміти ТИ НЕ ЗНАЧИШ для мене менше.",shape=box,color=red];
		j1013849117 -> j4244864260;
	j4244864260 [label="Ця особа не звідси. Я навіть не знаю чи зможу вас познайомити… але. Ви обоє дуже важливі для мене.",shape=box,color=red];
		j4244864260 -> j1383313377;
	j1383313377 [label="Я усвідомлюю, що це може бути важко прийняти. Якщо ти проти, то я це зрозумію. Просто не хотілося, щоби в тебе склалося враження, що я тебе обманюю чи щось приховую.",shape=box,color=red];
		j1383313377 -> j156895922;
	j156895922 [label="бллллллллллллллллллллллллллллллллллллллллллллллллллллллллллллллмхххххххххххххххххххххххввсррррррррррррррррррррркккккккккккккккккккккккккккккк",shape=box,color=blue];
		j156895922 -> j2912177408;
	j2912177408 [label="(якщо-що, це звуки мого короткого замикання)",shape=box,color=blue];
		j2912177408 -> j2972007375;
	j2972007375 [label="ти для мене багато значиш. типу як дуже дуже і мені не хотілося б втрачати це якщо. ну я не знаю. чи я не проти? ох. таак. звісно. я довіряю тобі. і хтось ще важливий для тебе вочевидячки. тож… добре.",shape=box,color=blue];
		j2972007375 -> j1005730529;
	j1005730529 [label="це дуже дииииииииииивно АЛЕ ЧОГО Ж ТОБІ ВСІ РОЗВАГИ ДІСТАЮТЬСЯ А Я ЗАСТРЯГ ТУУУУТ!??!??!",shape=box,color=blue];
