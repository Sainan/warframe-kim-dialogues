	j3316821453 [label="Boolean AmirConsentComplete is now true.",color=orange];
		j3316821453 -> "Chat ends.";
	j3348984560 [label="Хочу обговорити з тобою дещо, дізнатися, чи ти не проти, перш ніж усе зайде занадто далеко.",shape=box,color=red];
		j3348984560 -> j4089831100;
	j4089831100 [label="Ми про це раніше не говорили. Я не хочу, щоб у тебе була думка, що я брешу чи якось нечесно поводжуся.",shape=box,color=red];
		j4089831100 -> j3393293046;
	j3393293046 [label="ааааеешооооооотрапилосявбитокогосьнетогочипомерхтосьхочазаждицебулобнедивномаєбутищосьдивнішеаніжцеТИЗУСТРІЧАЄШСЯЗГІТАРОЮ?ОНІ!!!!!!!!!",shape=box,color=blue];
		j3393293046 -> j3104833422;
		j3393293046 -> j1470802555;
	j3104833422 [label="Я знаю, що це може мати дивний вигляд, але мої почуття до тебе ані на краплину не змінилися.",shape=box,color=red];
		j3104833422 -> j1746990258;
	j1470802555 [label="Ну, щонайменше, це точно не гітара… Дивись, я знаю, що це може мати дивний вигляд, але мої почуття до тебе ані на краплину не змінилися.",shape=box,color=red];
		j1470802555 -> j3086358792;
	j1746990258 [label="звиняймозокзастрягнапоетнційнійможливостітвоїхобіймівзгітароюпобудьтуттребаперезавантажитися",shape=box,color=blue];
		j1746990258 -> j4053010344;
	j3086358792 [label="+5 Chemistry",color=orange];
		j3086358792 -> j1746990258;
	j4053010344 [label="іііііііІІІІІІІІІІІІІІІІІІІІІІІІІІІ ми знову тут. пробач, то про що ти?",shape=box,color=blue];
		j4053010344 -> j326921204;
	j326921204 [label="ти… у тебе є ще ХТОСЬ десь? чи… колись? це ж… не з прокльонівців… так… ні? …… бооооооооцеееееееебууууууулоб дуууууужеееее дикккккккккоооооооооооо",shape=box,color=blue];
		j326921204 -> j328660906;
	j328660906 [label="це наче б ви зустрічалися з моєю двоюрідною лейлою фефефефефеуееуеуеуеефефуее",shape=box,color=blue];
		j328660906 -> j2725240904;
		j328660906 -> j428818569;
	j2725240904 [label="Ні, це не з «Прокльону». Не гітара. І не твоя двоюрідна сестра. ",shape=box,color=red];
		j2725240904 -> j1655426760;
	j428818569 [label="Уперше чую, що в тебе є двоюрідна сестра.",shape=box,color=red];
		j428818569 -> j1672345190;
	j1655426760 [label="АГА ЗНАЧИТЬ В ТЕБЕ ТИПУ ЩЕ ОДНІ СТОСУНКИ!?!?!?!?!?",shape=box,color=blue];
		j1655426760 -> j55647088;
	j1672345190 [label="ну ха ми про це ніколи й не говорили про мою родину СТІЛЬКИ ВСЯКОГО ІНШОГО ЛАЙНА У НАС Є ДЛЯ РОЗМОВ ЯК ОТ ЩО В ТЕБЕ Є ЩЕ ОДНІ СТОСУНКИ З КИМОСЬ!?!?!?!?!?",shape=box,color=blue];
		j1672345190 -> j55647088;
	j55647088 [label="Я розумію, що тобі від цього дуже незручно. І хочу дати тобі зрозуміти ТИ НЕ ЗНАЧИШ для мене менше.",shape=box,color=red];
		j55647088 -> j1675413134;
	j1675413134 [label="Ця особа не звідси. Я навіть не знаю чи зможу вас познайомити… але. Ви обоє дуже важливі для мене.",shape=box,color=red];
		j1675413134 -> j671155169;
	j671155169 [label="Я усвідомлюю, що це може бути важко прийняти. Якщо ти проти, то я це зрозумію. Просто не хотілося, щоби в тебе склалося враження, що я тебе обманюю чи щось приховую.",shape=box,color=red];
		j671155169 -> j1344744972;
	j1344744972 [label="бллллллллллллллллллллллллллллллллллллллллллллллллллллллллллллллмхххххххххххххххххххххххввсррррррррррррррррррррркккккккккккккккккккккккккккккк",shape=box,color=blue];
		j1344744972 -> j4083969157;
	j4083969157 [label="(якщо-що, це звуки мого короткого замикання)",shape=box,color=blue];
		j4083969157 -> j2696088631;
	j2696088631 [label="ти для мене багато значиш. типу як дуже дуже і мені не хотілося б втрачати це якщо хтось ще важливий для тебе то… значить і для мене ця особа буде важливою",shape=box,color=blue];
		j2696088631 -> j337521338;
	j337521338 [label="думаю я капець буду страждати від того що ми не познайомимося ну чогооооо тобі всі веселощі дістаються? довбаний 1999…………………",shape=box,color=blue];
