		j427271942 -> "Chat ends.";
	j623566211 [label="Я…\nХотіла сказати\nPrimero, lo siento\nЯ не мала б поводитися так, як це робила\nSegundo, те, що ти відчуваєш до мене, це правда?",shape=box,color=blue];
