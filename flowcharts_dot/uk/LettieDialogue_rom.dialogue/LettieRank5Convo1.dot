	j1205036979 [label="Ти мені скажи\nСкільки я значу?\nЯ просто бачу людину, яка провела все життя на самоті, а тепер має шанс на те, чого ніколи не мала\nЛюдину, яка не розуміє, у що вплутується",shape=box,color=blue];
