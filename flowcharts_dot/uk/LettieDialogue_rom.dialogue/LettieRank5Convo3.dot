		2026 -> 2030;
	2028 [label="Мені було *так* самотньо… навіть із тими «людьми», з якими можна було поговорити. Цього було недостатньо.",shape=box,color=red];
		2028 -> 2029;
	2030 [label="Я все ще розмовляю з собою, коли забуваюся. І це *справді* турбує інших людей.",shape=box,color=red];
		2030 -> 2031;
	2029 [label="Sí
