	"LettieRank6Convo9 begins." [color=orange];
		"LettieRank6Convo9 begins." -> j2347872725;
	j2347872725 [label="Гей\nЩо то за дивна істота яка за тобою бігає\nНе виглядає нормальною",shape=box,color=blue];
		j2347872725 -> j1603125162;
		j2347872725 -> j1767248690;
	j1603125162 [label="Ти здивуєшся, як мало це звужує коло пошуку.",shape=box,color=red];
		j1603125162 -> j847293455;
	j1767248690 [label="Металева чи жива?",shape=box,color=red];
		j1767248690 -> j1618332049;
	j847293455 [label="Jajaja справедливо\nГаразд у неї на голові були дивні штуки",shape=box,color=blue];
		j847293455 -> j2624846893;
		j847293455 -> j3289585630;
		j847293455 -> j748974991;
		j847293455 -> j3439356869;
	j1618332049 [label="Жива… здається\nВиглядає м'якою, тож мабуть не металева\nВелика з дивними штуками на голові",shape=box,color=blue];
		j1618332049 -> j2624846893;
		j1618332049 -> j3289585630;
		j1618332049 -> j748974991;
		j1618332049 -> j3439356869;
	j2624846893 [label="Не уявляю. Можливо, ти бачила, як за мною ганявся якийсь заражений.",shape=box,color=red];
		j2624846893 -> j4093388285;
	j3289585630 [label="Може вульпафила? Схожа на «лисицю» або худорляву «собаку» з великими довгими вухами та лискучими штуками на них?",shape=box,color=red];
		j3289585630 -> j986402041;
	j748974991 [label="Може смітовий кават? Схожа на Калимос, але з великими загостреними вухами?",shape=box,color=red];
		j748974991 -> j572359935;
	j3439356869 [label="Може предазит-візир? Схожий… на великого кремезного «собаку», у якого світяться штуки на голові? Великі вуха кажана?",shape=box,color=red];
		j3439356869 -> j3063169649;
	j4093388285 [label="No me gusta\nNo me gusta nadita",shape=box,color=blue];
		j4093388285 -> "Chat ends.";
	j986402041 [label="¡¡Sí!!\n¡¿Qué demonios es esa cosa?!",shape=box,color=blue];
		j986402041 -> j3944818780;
		j986402041 -> j1677587192;
		j986402041 -> j3426107593;
		j986402041 -> j2176503795;
	j572359935 [label="Eeeh, ні\nНе зовсім\nНа вухах світилися штуки",shape=box,color=blue];
		j572359935 -> j2995483196;
		j572359935 -> j1392985350;
	j3063169649 [label="Eeeh, ні, але близько\nДовгі та худі вуха",shape=box,color=blue];
		j3063169649 -> j3944818780;
		j3063169649 -> j2176503795;
		j3063169649 -> j3426107593;
		j3063169649 -> j1677587192;
	"Chat ends." [color=orange];
	j3944818780 [label="Так… поняття не маю, вибач.",shape=box,color=red];
		j3944818780 -> j4093388285;
	j1677587192 [label="Це моя підступна вульпафила. Вони походять із Деймосу, зараженої планети. Досить рідко можна побачити таку поза Деймосом. :) Вони не завдадуть шкоди. Ну. Принаймні тобі.",shape=box,color=red];
		j1677587192 -> j4211346452;
	j3426107593 [label="Це моя рогата вульпафила. Вони походять із Деймосу, зараженої планети. Досить рідко можна побачити таку поза Деймосом. :) Вони не завдадуть шкоди. Ну. Принаймні тобі.",shape=box,color=red];
		j3426107593 -> j4211346452;
	j2176503795 [label="Це моя панцирна вульпафила. Вони походять із Деймосу, зараженої планети. :) Вони не завдадуть шкоди. Ну. Принаймні тобі.",shape=box,color=red];
		j2176503795 -> j4211346452;
	j2995483196 [label="Такі великі лискучі вуха кажана?",shape=box,color=red];
		j2995483196 -> j3063169649;
	j1392985350 [label="Довгі, худі та лискучі вуха?",shape=box,color=red];
		j1392985350 -> j986402041;
	j4211346452 [label="Bien…\nБільше заражених…\nСаме те, що нам потрібно…\nПросто тримай її подалі від мене, ¿sí?",shape=box,color=blue];
		j4211346452 -> j3821148862;
		j4211346452 -> j3930864219;
	j3821148862 [label="Вона цілком мирна, точно тобі кажу.",shape=box,color=red];
		j3821148862 -> j2156426082;
	j3930864219 [label="Але це дуже мила заражена тварина, Летті. Ти ж знаєш, що хочеш її погладити.",shape=box,color=red];
		j3930864219 -> j481037479;
	j2156426082 [label="Певна те саме вони казали про техногниль\nПерш ніж вона почала поїдати їхні обличчя",shape=box,color=blue];
		j2156426082 -> "Chat ends.";
	j481037479 [label="+5 Chemistry",color=orange];
