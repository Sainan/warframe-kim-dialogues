		2733 -> 2739;
	2734 [label="Це моя підступна вульпафила. Вони походять із Деймосу, зараженої планети. Досить рідко можна побачити таку поза Деймосом. :) Вони не завдадуть шкоди. Ну. Принаймні тобі.",shape=box,color=red];
		2734 -> 2740;
	2735 [label="Це моя рогата вульпафила. Вони походять із Деймосу, зараженої планети. Досить рідко можна побачити таку поза Деймосом. :) Вони не завдадуть шкоди. Ну. Принаймні тобі.",shape=box,color=red];
		2735 -> 2740;
