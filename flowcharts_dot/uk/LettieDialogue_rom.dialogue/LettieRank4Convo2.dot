	j2583469354 [label="+20 Chemistry",color=orange];
		j2583469354 -> j1969318053;
	j2125643273 [label="Jaja, sí \nЯ це помітила\nЦіную чесність, babas \nЦе здається працює для тебе, тому я не засуджуватиму",shape=box,color=blue];
