		j782139218 -> j944314364;
		j782139218 -> j3799195630;
	"Chat ends." [color=orange];
	j3566619653 [label="Ця істота з Порожнечі, яка приносить в жертву інших і носить їхню шкіру, як це робив стародавній бог з обдертою шкірою Шіпе-Тотек",shape=box,color=blue];
		j3566619653 -> j1942019216;
	j944314364 [label="Ця ІСТОТА вирішила, що буде цікавим експериментом налаштувати батьків проти власних дітей на «Заримені».",shape=box,color=red];
		j944314364 -> j822723362;
	j3799195630 [label="Усе робиться для того, щоб залишити смерть і руйнування після себе. Якими б не були мотиви, це не має значення. Повір мені.",shape=box,color=red];
		j3799195630 -> j2035834479;
	j1942019216 [label="Boolean LettieReligion2 is now true.",color=orange];
		j1942019216 -> j2062884579;
	j822723362 [label="А потім дати дітям магічну силу Порожнечі, щоб вони могли вбити власних батьків, та просто щоби НАВЧИТИСЯ бійні.",shape=box,color=red];
		j822723362 -> j1734881334;
		j822723362 -> j186655681;
	j2035834479 [label="Ні \nЯк я можу повірити, що ти розумієш думки бога \nНе важливо, скільки тобі років \nАбо скільки ти бачиш навколо",shape=box,color=blue];
		j2035834479 -> j2154935428;
	j2062884579 [label="Чого він хоче",shape=box,color=blue];
		j2062884579 -> j3650184036;
		j2062884579 -> j1121803375;
		j2062884579 -> j2274284591;
	j1734881334 [label="Була ж можливість навчитися через любов, жертовність і доброту. Але ні, легше ж ОБРАТИ хаос і вбивства.",shape=box,color=red];
		j1734881334 -> j1374040890;
	j186655681 [label="Навіть якщо це просто малюк, який трощить свої іграшки, щоб зрозуміти навколишній світ, цими іграшками були ми. Його треба зупинити.",shape=box,color=red];
		j186655681 -> j120624458;
	j2154935428 [label="Check boolean LettieEntrati",color=orange];
		j2154935428 -> j2309963263 [label=true,color=green];
		j2154935428 -> j2834367091 [label=false,color=brown];
	j1374040890 [label="Я продовжуватиму сподіватися, що він не ворог, але… це не дає мені багато підстав думати інакше.",shape=box,color=red];
		j1374040890 -> j1617926274;
	j120624458 [label="Я відмовляюся вірити, що він хороший після всього побаченого. Після всього, що він зі мною зробив.",shape=box,color=red];
		j120624458 -> j1617926274;
	j2309963263 [label="Ти не бог, babas\nТому не прикидайся\nУ іншому випадку ти нічим не відрізняєшся від того cabrón Ентраті",shape=box,color=blue];
