	j2102116770 [label="Га? Про що ти говориш?",shape=box,color=red];
		j2102116770 -> j3566619653;
	j1658643420 [label="Ти так думаєш, але не знаєш точно\nЙого мотивація незрозуміла \nАле все ж ти вважаєш його ворогом ¿Por qué?",shape=box,color=blue];
