		j265076893 -> j1384980059;
	j3952540686 [label="Estás bromeando, ¿verdad? \nЯк тільки тебе покличуть, ти побіжиш \nТи мандрівник, солдат, ти підеш рятувати майбутнє, коли це потрібно",shape=box,color=blue];
