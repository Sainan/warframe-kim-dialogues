digraph {
	"LettieRank6Convo8 begins." [color=orange];
		"LettieRank6Convo8 begins." -> j3838706497;
	j3838706497 [label="Я чула про те, що сталося з Каєю
Про те, що з нею зробив той куций comadreja de mierda",shape=box,color=blue];
		j3838706497 -> j3514609240;
		j3838706497 -> j2845370823;
	j3514609240 [label="Гм, ох.",shape=box,color=red];
		j3514609240 -> j2569243115;
	j2845370823 [label="Так…",shape=box,color=red];
		j2845370823 -> j2569243115;
	j2569243115 [label="Я не знаю як
Я не знаю, чи це взагалі можливо
Але ти ламаєш закони часу та простору",shape=box,color=blue];
		j2569243115 -> j835466951;
	j835466951 [label="Я хочу знайти його
І я хочу привести його сюди
І я хочу посадити його перед усіма нами",shape=box,color=blue];
		j835466951 -> j818207120;
		j835466951 -> j671857220;
	j818207120 [label="І що потім?",shape=box,color=red];
		j818207120 -> j743138997;
	j671857220 [label="Ми не можемо кривдити якогось дурного підлітка.",shape=box,color=red];
		j671857220 -> j3524085574;
	j743138997 [label="Я хочу, щоб він відчув наживо, як це — коли він боїться, а весь світ проти нього
Коли всі сміються з нього
Глузують з нього",shape=box,color=blue];
		j743138997 -> j1747636862;
	j3524085574 [label="А хто сказав, що це мій намір
Я знаю таких як він
Боягузи, сміливі лити бруд лише звідти, звідки вони вважають що в безпеці",shape=box,color=blue];
		j3524085574 -> j743138997;
	j1747636862 [label="Чи знаєш ти, як важко було зростати схожою на мене?
Звучати як я?
Одягатися як я?
Бути на військовій базі серед дітей, що відрізнялися?",shape=box,color=blue];
		j1747636862 -> j2876612403;
	j2876612403 [label="Я майже завжди поверталася додому побитою, бо захищалася
Mi mamá завжди прицмокувала та казала, що мені слід було стерпіти
¿Quedarme callada?
З біса",shape=box,color=blue];
		j2876612403 -> j580547789;
	j580547789 [label="Check boolean KayaFutureWin2",color=orange];
		j580547789 -> j2112829742 [label=true,color=green];
		j580547789 -> j873666059 [label=false,color=brown];
	j2112829742 [label="Я не засуджую її за бажання втекти
Якби я могла, я б зробила те саме
Але
Бачиш, що вона повертається?",shape=box,color=blue];
		j2112829742 -> j214059638;
		j2112829742 -> j629065242;
	j873666059 [label="Я не засуджую її за бажання втекти
Якби я могла, я б зробила те саме
Коли вона підросте, це мине",shape=box,color=blue];
		j873666059 -> j3773234922;
		j873666059 -> j2340704466;
	j214059638 [label="Ні?",shape=box,color=red];
		j214059638 -> j2120202490;
	j629065242 [label="Ну, вона єдина, хто може допомогти з часовою архімедією.",shape=box,color=red];
		j629065242 -> j443803702;
	j3773234922 [label="Мені шкода, що я не можу їй із цим допомогти.",shape=box,color=red];
		j3773234922 -> j3026787942;
	j2340704466 [label="Чи можеш ти їй із цим допомогти?",shape=box,color=red];
		j2340704466 -> j3026787942;
	j2120202490 [label="JAJAJA нагадай мені ніколи не встановлювати тебе контактом для екстрених випадків
Sííí, вона іноді іде але потім повертається сюди
Заради часової архі… щось там
Але також і заради… нас, я гадаю",shape=box,color=blue];
		j2120202490 -> j1464682535;
	j443803702 [label="Sííí, заради часової архі… щось там
Але також і заради… нас, я гадаю",shape=box,color=blue];
		j443803702 -> j1464682535;
	j3026787942 [label="Іноді просто потрібен час
Але я спробую їй допомогти якщо зможу
Луа знає що вона достатньо цікавиться медициною jajaja
Ella siempre hace preguntas espeluznantes",shape=box,color=blue];
		j3026787942 -> j1650029040;
	j1464682535 [label="Мені подобається коли вона поруч
Гадаю вона це знає
А їй подобається допомагати мені з операціями, але…
Ella siempre hace preguntas espeluznantes",shape=box,color=blue];
		j1464682535 -> j1959540802;
	j1650029040 [label="Те що вона телепортується не допомагає
Мені подобається дивитися як вона лякає Аміра
Ця швидкісна падлюка заслуговує на це, він постійно так з нами робить JAJAJAJA",shape=box,color=blue];
		j1650029040 -> "Chat ends.";
	j1959540802 [label="Те що вона телепортується не допомагає
Мені подобається дивитися як вона лякає Аміра
Ця швидкісна падлюка заслуговує на це, він постійно так з нами робить JAJAJAJA
Сподіваюся вона ніколи не піде назавжди",shape=box,color=blue];
		j1959540802 -> "Chat ends.";
