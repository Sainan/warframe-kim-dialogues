digraph {
	2667 [label="LettieRank6Convo8 begins.",color=orange];
		2667 -> 2668;
	2668 [label="Я чула про те, що сталося з Каєю
Про те, що з нею зробив той куций comadreja de mierda",shape=box,color=blue];
		2668 -> 2669;
		2668 -> 2670;
	2669 [label="Гм, ох.",shape=box,color=red];
		2669 -> 2671;
	2670 [label="Так…",shape=box,color=red];
		2670 -> 2671;
	2671 [label="Я не знаю як
Я не знаю, чи це взагалі можливо
Але ти ламаєш закони часу та простору",shape=box,color=blue];
		2671 -> 2672;
	2672 [label="Я хочу знайти його
І я хочу привести його сюди
І я хочу посадити його перед усіма нами",shape=box,color=blue];
		2672 -> 2673;
		2672 -> 2674;
	2673 [label="І що потім?",shape=box,color=red];
		2673 -> 2675;
	2674 [label="Ми не можемо кривдити якогось дурного підлітка.",shape=box,color=red];
		2674 -> 2676;
	2675 [label="Я хочу, щоб він відчув наживо, як це — коли він боїться, а весь світ проти нього
Коли всі сміються з нього
Глузують з нього",shape=box,color=blue];
		2675 -> 2677;
	2676 [label="А хто сказав, що це мій намір
Я знаю таких як він
Боягузи, сміливі лити бруд лише звідти, звідки вони вважають що в безпеці",shape=box,color=blue];
		2676 -> 2675;
	2677 [label="Чи знаєш ти, як важко було зростати схожою на мене?
Звучати як я?
Одягатися як я?
Бути на військовій базі серед дітей, що відрізнялися?",shape=box,color=blue];
		2677 -> 2678;
	2678 [label="Я майже завжди поверталася додому побитою, бо захищалася
Mi mamá завжди прицмокувала та казала, що мені слід було стерпіти
¿Quedarme callada?
З біса",shape=box,color=blue];
		2678 -> 2679;
	2679 [label="Check boolean KayaFutureWin2",color=orange];
		2679 -> 2681 [label=true,color=green];
		2679 -> 2680 [label=false,color=brown];
	2681 [label="Я не засуджую її за бажання втекти
Якби я могла, я б зробила те саме
Але
Бачиш, що вона повертається?",shape=box,color=blue];
		2681 -> 2684;
		2681 -> 2685;
	2680 [label="Я не засуджую її за бажання втекти
Якби я могла, я б зробила те саме
Коли вона підросте, це мине",shape=box,color=blue];
		2680 -> 2682;
		2680 -> 2683;
	2684 [label="Ні?",shape=box,color=red];
		2684 -> 2687;
	2685 [label="Ну, вона єдина, хто може допомогти з часовою архімедією.",shape=box,color=red];
		2685 -> 2688;
	2682 [label="Мені шкода, що я не можу їй із цим допомогти.",shape=box,color=red];
		2682 -> 2686;
	2683 [label="Чи можеш ти їй із цим допомогти?",shape=box,color=red];
		2683 -> 2686;
	2687 [label="JAJAJA нагадай мені ніколи не встановлювати тебе контактом для екстрених випадків
Sííí, вона іноді іде але потім повертається сюди
Заради часової архі… щось там
Але також і заради… нас, я гадаю",shape=box,color=blue];
		2687 -> 2690;
	2688 [label="Sííí, заради часової архі… щось там
Але також і заради… нас, я гадаю",shape=box,color=blue];
		2688 -> 2690;
	2686 [label="Іноді просто потрібен час
Але я спробую їй допомогти якщо зможу
Луа знає що вона достатньо цікавиться медициною jajaja
Ella siempre hace preguntas espeluznantes",shape=box,color=blue];
		2686 -> 2689;
	2690 [label="Мені подобається коли вона поруч
Гадаю вона це знає
А їй подобається допомагати мені з операціями, але…
Ella siempre hace preguntas espeluznantes",shape=box,color=blue];
		2690 -> 2692;
	2689 [label="Те що вона телепортується не допомагає
