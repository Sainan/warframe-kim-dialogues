digraph {
	graph [fontname="Roboto Condensed"];
	node [fontname="Roboto Condensed"];
	edge [fontname="Roboto Condensed"];

	"LettieRank6Convo8 begins." [color=orange];
		"LettieRank6Convo8 begins." -> j3838706497;
	j3838706497 [label="Я чула про те, що сталося з Каєю\nПро те, що з нею зробив той куций comadreja de mierda",shape=box,color=blue];
		j3838706497 -> j3514609240;
		j3838706497 -> j2845370823;
	j3514609240 [label="Гм, ох.",shape=box,color=red];
		j3514609240 -> j2569243115;
	j2845370823 [label="Так…",shape=box,color=red];
		j2845370823 -> j2569243115;
	j2569243115 [label="Я не знаю як\nЯ не знаю, чи це взагалі можливо\nАле ти ламаєш закони часу та простору",shape=box,color=blue];
		j2569243115 -> j835466951;
	j835466951 [label="Я хочу знайти його\nІ я хочу привести його сюди\nІ я хочу посадити його перед усіма нами",shape=box,color=blue];
		j835466951 -> j818207120;
		j835466951 -> j671857220;
	j818207120 [label="І що потім?",shape=box,color=red];
		j818207120 -> j743138997;
	j671857220 [label="Ми не можемо кривдити якогось дурного підлітка.",shape=box,color=red];
		j671857220 -> j3524085574;
	j743138997 [label="Я хочу, щоб він відчув наживо, як це — коли він боїться, а весь світ проти нього\nКоли всі сміються з нього\nГлузують з нього",shape=box,color=blue];
		j743138997 -> j1747636862;
	j3524085574 [label="А хто сказав, що це мій намір\nЯ знаю таких як він\nБоягузи, сміливі лити бруд лише звідти, звідки вони вважають що в безпеці",shape=box,color=blue];
		j3524085574 -> j743138997;
	j1747636862 [label="Чи знаєш ти, як важко було зростати схожою на мене?\nЗвучати як я?\nОдягатися як я?\nБути на військовій базі серед дітей, що відрізнялися?",shape=box,color=blue];
		j1747636862 -> j2876612403;
	j2876612403 [label="Я майже завжди поверталася додому побитою, бо захищалася\nMi mamá завжди прицмокувала та казала, що мені слід було стерпіти\n¿Quedarme callada?\nЗ біса",shape=box,color=blue];
		j2876612403 -> j580547789;
	j580547789 [label="Check boolean KayaFutureWin2",color=orange];
		j580547789 -> j2112829742 [label=true,color=green];
		j580547789 -> j873666059 [label=false,color=brown];
	j2112829742 [label="Я не засуджую її за бажання втекти\nЯкби я могла, я б зробила те саме\nАле\nБачиш, що вона повертається?",shape=box,color=blue];
		j2112829742 -> j214059638;
		j2112829742 -> j629065242;
	j873666059 [label="Я не засуджую її за бажання втекти\nЯкби я могла, я б зробила те саме\nКоли вона підросте, це мине",shape=box,color=blue];
		j873666059 -> j3773234922;
		j873666059 -> j2340704466;
	j214059638 [label="Ні?",shape=box,color=red];
		j214059638 -> j2120202490;
	j629065242 [label="Ну, вона єдина, хто може допомогти з часовою архімедією.",shape=box,color=red];
		j629065242 -> j443803702;
	j3773234922 [label="Мені шкода, що я не можу їй із цим допомогти.",shape=box,color=red];
		j3773234922 -> j3026787942;
	j2340704466 [label="Чи можеш ти їй із цим допомогти?",shape=box,color=red];
		j2340704466 -> j3026787942;
	j2120202490 [label="JAJAJA нагадай мені ніколи не встановлювати тебе контактом для екстрених випадків\nSííí, вона іноді іде але потім повертається сюди\nЗаради часової архі… щось там\nАле також і заради… нас, я гадаю",shape=box,color=blue];
		j2120202490 -> j1464682535;
	j443803702 [label="Sííí, заради часової архі… щось там\nАле також і заради… нас, я гадаю",shape=box,color=blue];
		j443803702 -> j1464682535;
	j3026787942 [label="Іноді просто потрібен час\nАле я спробую їй допомогти якщо зможу\nЛуа знає що вона достатньо цікавиться медициною jajaja\nElla siempre hace preguntas espeluznantes",shape=box,color=blue];
		j3026787942 -> j1650029040;
	j1464682535 [label="Мені подобається коли вона поруч\nГадаю вона це знає\nА їй подобається допомагати мені з операціями, але…\nElla siempre hace preguntas espeluznantes",shape=box,color=blue];
		j1464682535 -> j1959540802;
	j1650029040 [label="Те що вона телепортується не допомагає\nМені подобається дивитися як вона лякає Аміра\nЦя швидкісна падлюка заслуговує на це, він постійно так з нами робить JAJAJAJA",shape=box,color=blue];
		j1650029040 -> "Chat ends.";
	j1959540802 [label="Те що вона телепортується не допомагає\nМені подобається дивитися як вона лякає Аміра\nЦя швидкісна падлюка заслуговує на це, він постійно так з нами робить JAJAJAJA\nСподіваюся вона ніколи не піде назавжди",shape=box,color=blue];
		j1959540802 -> "Chat ends.";
	"Chat ends." [color=orange];
}