digraph {
	"LettieRank5Convo7 begins." [color=orange];
		"LettieRank5Convo7 begins." -> j4288606571;
	j4288606571 [label="Check boolean LettieDating",color=orange];
		j4288606571 -> j1943577410 [label=true,color=green];
		j4288606571 -> "Chat ends." [label=false,color=brown];
	j1943577410 [label="Якщо тебе в мене вкрадуть\nКому я маю за це дякувати?\nЩо тебе від мене забере?",shape=box,color=blue];
		j1943577410 -> j1471501805;
		j1943577410 -> j444989698;
	"Chat ends." [color=orange];
	j1471501805 [label="Я скажу це з усією любов’ю та повагою на світі — ти *жахливо* починаєш розмови.",shape=box,color=red];
		j1471501805 -> j764083326;
	j444989698 [label="Вибач, пригальмуй, ти про що питаєш?",shape=box,color=red];
		j444989698 -> j3133064473;
	j764083326 [label="+5 Chemistry",color=orange];
		j764083326 -> j3716321258;
	j3133064473 [label="Мені просто цікаво знати, що коли майбутнє забере тебе від мене\nЯке обличчя воно прийме та чому",shape=box,color=blue];
		j3133064473 -> j1228117015;
		j3133064473 -> j1527525491;
	j3716321258 [label="¡JAJAJA SÍ!\nЦе точно, lo siento\nМені просто цікаво знати, що коли майбутнє забере тебе від мене\nЯке обличчя воно прийме та чому",shape=box,color=blue];
		j3716321258 -> j1228117015;
		j3716321258 -> j1527525491;
	j1228117015 [label="Навіть якби мені довелося піти — хто сказав, що я не повернуся?",shape=box,color=red];
		j1228117015 -> j3162190917;
	j1527525491 [label="Ти терпіти не можеш, коли я роблю припущення про тебе.",shape=box,color=red];
		j1527525491 -> j3010535370;
	j3162190917 [label="Можливо, ти спробуєш\nІ, можливо, тобі навіть вдасться\nТебе дуже важко вбити jaja \nАле я дуже добре знаю солдатів, solecito \nА солдати не завжди повертаються з війни \nТож скажи мені чому",shape=box,color=blue];
		j3162190917 -> j3234434887;
	j3010535370 [label="Sí, це правда\nАле я також дуже добре знаю життя солдатів, solecito\nА ти з цієї категорії, хочеш того чи ні\nКоли солдатів закликають «рятувати світ»\nЦе те, що вони роблять\nТож скажи мені чому",shape=box,color=blue];
		j3010535370 -> j3234434887;
	j3234434887 [label="Check boolean LettieReligion2",color=orange];
		j3234434887 -> j4114617308 [label=true,color=green];
		j3234434887 -> j1784945273 [label=true,color=green];
		j3234434887 -> j455203353 [label=true,color=green];
		j3234434887 -> j6233389 [label=true,color=green];
		j3234434887 -> j4114617308 [label=false,color=brown];
		j3234434887 -> j2419511392 [label=false,color=brown];
		j3234434887 -> j939987708 [label=false,color=brown];
		j3234434887 -> j6233389 [label=false,color=brown];
	j4114617308 [label="Ентраті. Я думаю, що моя гонитва за ним ще не закінчилася.",shape=box,color=red];
		j4114617308 -> j1172456555;
	j1784945273 [label="Мій Шіпе-Тотек. Я, як ніхто інший, знаю, як *важливо* його зупинити.",shape=box,color=red];
		j1784945273 -> j3186228113;
	j455203353 [label="Тау. Якщо саме туди прямує Ентраті, мій Шіпе-Тотек *піде* за ним. Це місце надто важливе, щоби втратити його.",shape=box,color=red];
		j455203353 -> j3204689239;
	j6233389 [label="Я НІКОЛИ не піду. Кінець історії.",shape=box,color=red];
		j6233389 -> j3265711924;
	j2419511392 [label="Людина в стіні. Я, як ніхто інший, знаю, як *важливо* його зупинити.",shape=box,color=red];
		j2419511392 -> j3186228113;
	j939987708 [label="Тау. Якщо саме туди прямує Ентраті, Людина в стіні *піде* за ним. Це місце надто важливе, щоби втратити його.",shape=box,color=red];
		j939987708 -> j3204689239;
	j1172456555 [label="Наче мені потрібна була ще одна причина, щоб ненавидіти цього cabrón\nТи даєш мені ще одну\nАле він знищить більше місць і більше життів\nТак само як він робив раніше",shape=box,color=blue];
		j1172456555 -> j1082814531;
	j3186228113 [label="Твоя історія з богом Порожнечі з обдертою шкірою… sí \nБоюся, що це ще не кінець\nІ хто я така, щоб думати, що я можу стати тобі на заваді",shape=box,color=blue];
		j3186228113 -> j1991588385;
	j3204689239 [label="Check boolean LettieSentients",color=orange];
		j3204689239 -> j1073416071 [label=true,color=green];
		j3204689239 -> j3915490280 [label=false,color=brown];
	j3265711924 [label="Я не думала, що твоя наївність така сильна\nЦі наші стосунки явно були помилкою, babas\nТи ще дитина, щоби бути зі мною\nОсобливо, якщо не можеш зрозуміти реальність усього цього",shape=box,color=blue];
		j3265711924 -> j2548450594;
	j1082814531 [label="Ay, sí\nЯкщо хтось із нас не зможе пригостити його кулею в лоб, то це маєш зробити ти\nІ я сподіваюся, що як тільки ти підеш і змусиш його заплатити\nТи потім повернешся назад до нас\nІ до мене",shape=box,color=blue];
		j1082814531 -> j4219772767;
	j1991588385 [label="Я сподіваюся, що коли ти нарешті переможеш цього свого обдертого бога\nТи не забудеш про нас тут, у цій cuchitril\nТи повернешся до нас\nІ до мене",shape=box,color=blue];
		j1991588385 -> j2035534676;
	j1073416071 [label="Це Тау, це туди відправили… Свідомих ¿no? \nЦю фальшиву расу, створену фальшивими богами орокінами",shape=box,color=blue];
		j1073416071 -> j1507122350;
	j3915490280 [label="Розкажи мені про це Тау\nЩо це таке\nІ чому воно забере тебе від мене",shape=box,color=blue];
		j3915490280 -> j3382533923;
	j2548450594 [label="Boolean LettieDating is now false.",color=orange];
		j2548450594 -> j4086907321;
	j4219772767 [label="Я обіцяю, що ЯКЩО піду, то я повернуся.",shape=box,color=red];
		j4219772767 -> j1172982866;
	j2035534676 [label="Що я можу тобі пообіцяти, так це те, що я докладу всіх зусиль.",shape=box,color=red];
		j2035534676 -> j3287168249;
	j1507122350 [label="Так, але тоді ми б ніколи не зустрілися. І не почали зустрічатися. Отже… маленький плюс?",shape=box,color=red];
		j1507122350 -> j3824964565;
	j3382533923 [label="Тау — це планета в іншій сонячній системі, куди орокіни послали створену ними синтетичну расу, щоб тераформувати планету для нас.",shape=box,color=red];
		j3382533923 -> j1724727120;
	j4086907321 [label="Boolean IsDating is now false.",color=orange];
		j4086907321 -> j2703113057;
	j1172982866 [label="+10 Chemistry",color=orange];
		j1172982866 -> j2409340053;
	j3287168249 [label="+20 Chemistry",color=orange];
		j3287168249 -> j944204283;
	j3824964565 [label="Jajaja sí\nМалесенький плюс\nАле чому?\nЧому це місце таке важливе, що забере тебе від мене",shape=box,color=blue];
		j3824964565 -> j854021224;
		j3824964565 -> j3145546224;
		j3824964565 -> j1723690825;
	j1724727120 [label="Расу називали Свідомими. Але Свідомі обернулися проти орокінів. Вони повернулися сюди та почали з ними війну.",shape=box,color=red];
		j1724727120 -> j1640567784;
	j2703113057 [label="Boolean LettieNoDate is now true.",color=orange];
		j2703113057 -> "Chat ends.";
	j2409340053 [label="Скільки soldaditos давали цю обіцянку\nІ помирали в канаві через годину\nАга, але я знаю, що ти говориш серцем\nЯ знаю, що ти спробуєш",shape=box,color=blue];
		j2409340053 -> "Chat ends.";
	j944204283 [label="Це обіцянка, якій я можу довіряти \nЦе обіцянка, якій я вірю \nGracias, mi corazón",shape=box,color=blue];
		j944204283 -> j1472871842;
	j854021224 [label="Я не знаю. Але якщо Ентраті *і* Людина в стіні прямують туди… це має бути важливо.",shape=box,color=red];
		j854021224 -> j3327490510;
	j3145546224 [label="Це була єдина надія на виживання для людства. І, скоріш за все, досі є.",shape=box,color=red];
		j3145546224 -> j3158609896;
	j1723690825 [label="Я ще не знаю. Але Свідомі говорили багато загадкового про це місце.",shape=box,color=red];
		j1723690825 -> j242778864;
	j1640567784 [label="І саме ця війна змусила орокінів створити зараження — і ворфреймів — в першу чергу. Щоби битися проти Свідомих.",shape=box,color=red];
		j1640567784 -> j689018405;
	j1472871842 [label="Boolean LettieReal is now true.",color=orange];
		j1472871842 -> "Chat ends.";
	j3327490510 [label="Sí \nІ я сподіваюся, що як тільки ти підеш і змусиш його заплатити\nТи потім повернешся до нас\nІ до мене",shape=box,color=blue];
		j3327490510 -> j4219772767;
		j3327490510 -> j2035534676;
	j3158609896 [label="Ay no \nМи зіпсуємо й те місце\nМені здається, я навіть погоджуюся зі Свідомими jajaja\nКрім того, здається, ми добре прижилися в космосі, ¿no?",shape=box,color=blue];
		j3158609896 -> j2101124417;
		j3158609896 -> j2620992592;
	j242778864 [label="¿Cómo qué? \n¿Що саме?",shape=box,color=blue];
		j242778864 -> j660060889;
		j242778864 -> j177494726;
	j689018405 [label="Отже, якби не ця Тау і ці Свідомі\nЦя фальшива раса, створена цими фальшивими богами, орокінами \nНічого з цього pendejadas ніколи не сталося б",shape=box,color=blue];
		j689018405 -> j1507122350;
		j689018405 -> j2149347123;
	j2101124417 [label="Справедливо. ха-ха",shape=box,color=red];
		j2101124417 -> j4285861176;
	j2620992592 [label="Тобі краще почекати та побачити майбутнє, перш ніж так думати.",shape=box,color=red];
		j2620992592 -> j4285861176;
	j660060889 [label="«Тихо все у спокої. Змовклі й порожні небеса».",shape=box,color=red];
		j660060889 -> j3273403220;
	j177494726 [label="«Просто обрамлені. Просто сформовані. Так їх називають. У них не було матері, у них не було батька».",shape=box,color=red];
		j177494726 -> j3273403220;
	j2149347123 [label="Можна сказати так.",shape=box,color=red];
		j2149347123 -> j2040152956;
	j4285861176 [label="+10 Chemistry",color=orange];
		j4285861176 -> j3525093093;
	j3273403220 [label="¡¿QUÉ?! \nЩО Я ЩОЙНО ПОЧУЛА?! \nЧЕКАЙ ЧЕКАЙ ЧЕКАЙ ЧЕКАЙ ЧЕКАЙ ЧЕКАЙ ",shape=box,color=blue];
		j3273403220 -> j1018592383;
	j2040152956 [label="Але чому?\nЧому це місце таке важливе, що забере тебе від мене",shape=box,color=blue];
		j2040152956 -> j854021224;
		j2040152956 -> j3145546224;
		j2040152956 -> j1723690825;
	j3525093093 [label="Треба вертатися до роботи\nЯк завжди\nНі кінця їй не видно, ні краю",shape=box,color=blue];
		j3525093093 -> "Chat ends.";
	j1018592383 [label="¿POR QUÉ? чому істоти з далекого майбутнього цитують ¿a los PUEBLOS ANT|GUOS? \n¿Qué chingados está pasando ahora?",shape=box,color=blue];
		j1018592383 -> j4278811813;
		j1018592383 -> j3641327084;
	j4278811813 [label="Га, стривай, ти про що? Що вони цитують?",shape=box,color=red];
		j4278811813 -> j2995634934;
	j3641327084 [label="Летті, я знову не розумію. Ти про що?",shape=box,color=red];
		j3641327084 -> j2995634934;
	j2995634934 [label="A-А-А-А-А-А ЦЕ НЕМОЖЛИВО\nЦі слова… є словами стародавнього народу з Чичен-Іци. ЗВІДКИ ТИ ЇХ ЗНАЄШ?!",shape=box,color=blue];
		j2995634934 -> j3637697143;
	j3637697143 [label="ЦЕ ЗІ СВЯЩЕННОГО ТЕКСТУ LOS PUEBLOS ANT|GUOS \n\"¡¿CÓMO Y POR QUÉ!?\"",shape=box,color=blue];
		j3637697143 -> j1060191468;
		j3637697143 -> j1858667866;
	j1060191468 [label="Я… я… я поняття не маю. Я можу тільки здогадуватися.",shape=box,color=red];
		j1060191468 -> j2857607416;
	j1858667866 [label="Переміщення в часі?..",shape=box,color=red];
		j1858667866 -> j2857607416;
	j2857607416 [label="+20 Chemistry",color=orange];
		j2857607416 -> j1568471344;
	j1568471344 [label="Я взагалі не п’ю\nАле якщо починати, то зараз був би вдалий час\nА-а-а-а-а-а-а ця нісенітниця стає з кожним днем ​​все гіршою",shape=box,color=blue];
		j1568471344 -> j573350433;
	j573350433 [label="Мені… потрібно присісти, mi corazón\nНе розмовляй зі мною про майбутнє деякий час, ¿Sí?\nДумаю, що мені цього вистачить надовго\nТепер розколюється голова",shape=box,color=blue];
		j573350433 -> j1472871842;
}