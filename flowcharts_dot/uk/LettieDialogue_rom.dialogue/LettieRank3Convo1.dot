	"LettieRank3Convo1 begins." [color=orange];
		"LettieRank3Convo1 begins." -> j1416305916;
	j1416305916 [label="І як ти це робиш, babas \nNo eNT|endo",shape=box,color=blue];
		j1416305916 -> j1919071932;
		j1416305916 -> j589544534;
		j1416305916 -> j3396610524;
	j1919071932 [label="Ти забула додати, про що ти говориш.",shape=box,color=red];
		j1919071932 -> j3136140862;
	j589544534 [label="Роблю що?",shape=box,color=red];
		j589544534 -> j3593758441;
	j3396610524 [label="Це чари.",shape=box,color=red];
		j3396610524 -> j1759475013;
	j3136140862 [label="+5 Chemistry",color=orange];
		j3136140862 -> j4181870785;
	j3593758441 [label="Бути в пастці на століття, без часу\nБез змін, без рухів\nМи всі fantasmas, які бродять у цьому місці",shape=box,color=blue];
		j3593758441 -> j2631015866;
	j1759475013 [label="Ay, equis",shape=box,color=blue];
		j1759475013 -> "Chat ends.";
	j4181870785 [label="Jaja, sí \nLo siento, я занадто багато часу проводжу у своїх думках\nАле останнім часом рідше, через тебе і ту bruja",shape=box,color=blue];
		j4181870785 -> j3593758441;
	j2631015866 [label="Check boolean LettieDuviri",color=orange];
		j2631015866 -> j501459763 [label=true,color=green];
		j2631015866 -> j1452441734 [label=false,color=brown];
	"Chat ends." [color=orange];
	j501459763 [label="Ти кажеш, що це було в Дувірі\nКоролівстві смерті та історії\nYo me habría vuelto loca \nТепер я хвилююся, що божеволію",shape=box,color=blue];
		j501459763 -> j1064590996;
		j501459763 -> j1786961312;
		j501459763 -> j199421623;
	j1452441734 [label="Ти кажеш, що в тебе це було раніше\nНа цій іншій твоїй землі\nYo me habría vuelto loca\nТепер я хвилююся, що божеволію",shape=box,color=blue];
		j1452441734 -> j199421623;
		j1452441734 -> j1786961312;
		j1452441734 -> j1064590996;
	j1064590996 [label="Чесно? Це майже сталося зі мною. Тоді все в мені оніміло, бо краще вже не відчувати.",shape=box,color=red];
		j1064590996 -> j2345165217;
	j1786961312 [label="Мене теж… на деякий час накривало безумством. Я багато чого не пам’ятаю.",shape=box,color=red];
		j1786961312 -> j3060755721;
	j199421623 [label="Те, що зі мною сталося в Дувірі, зовсім не схоже на те, що відбувається тут. Ти не самотня, як я.",shape=box,color=red];
		j199421623 -> j63121097;
	j2345165217 [label="¿Sí? \nОніміла, порожня оболонка \nАле ти виглядаєш жваво, я більше не бачу в тобі порожнечі",shape=box,color=blue];
		j2345165217 -> j3597487918;
		j2345165217 -> j2674526908;
	j3060755721 [label="Я бачила це у солдатів після страшних боїв, це блокується в голові\nРозум робить усе можливе, щоб захистити себе\nЦе на краще, повір мені, babas\nТож, як тобі вдалося вижити?",shape=box,color=blue];
		j3060755721 -> j3597487918;
		j3060755721 -> j2674526908;
	j63121097 [label="Sí, cómo no \nЦе не ті люди, з якими я хотіла б провести вічність, babas \nБез образ, подивись навколо",shape=box,color=blue];
		j63121097 -> j2722267587;
	j3597487918 [label="Коли мені стало зрозуміло, що відбувається, мій внутрішній супротив робив усе, щоб це не поглинуло мене.",shape=box,color=red];
		j3597487918 -> j974559342;
	j2674526908 [label="Мені допомогли друзі, які витягли мене звідти.",shape=box,color=red];
		j2674526908 -> j951961608;
	j2722267587 [label="Я просто була тут, щоб зашивати їхні рани, до того, як ми стали монстрами, \nТепер у нас більше немає вибору \nДумаєш, їм подобається мене тут бачити?",shape=box,color=blue];
		j2722267587 -> j675711362;
		j2722267587 -> j462787943;
		j2722267587 -> j1283028647;
		j2722267587 -> j2929122544;
	j974559342 [label="Але з вічністю не поборотися\nТобі вдалося втекли з того місця\nДля нас я не бачу виходу… а ти?",shape=box,color=blue];
		j974559342 -> j2696365583;
		j974559342 -> j2721601567;
	j951961608 [label="Bueno, значить мені не пощастило \nJaja",shape=box,color=blue];
		j951961608 -> j675711362;
		j951961608 -> j462787943;
		j951961608 -> j1283028647;
		j951961608 -> j2929122544;
	j675711362 [label="Ну, мені *ти* подобаєшся.",shape=box,color=red];
		j675711362 -> j2376879687;
	j462787943 [label="Ти думаєш, що не подобаєшся іншим прокльонівцям?",shape=box,color=red];
		j462787943 -> j3617267929;
	j1283028647 [label="Ну, Летті, до тебе складно знайти підхід.",shape=box,color=red];
		j1283028647 -> j3120999496;
	j2929122544 [label="Можливо, якби ти не була такою стервозною…",shape=box,color=red];
		j2929122544 -> j2454682252;
	j2696365583 [label="Ні… я також не бачу, вибач.",shape=box,color=red];
		j2696365583 -> j430499992;
	j2721601567 [label="Знаєш, я можу забирати тебе звідси ненадовго через Перенесення.",shape=box,color=red];
		j2721601567 -> j1628816520;
	j2376879687 [label="¿Ay, Sí? \nПодивимося, наскільки я тобі подобаюся, babas \nМені дуже цікаво, скільки ти зможеш витримати",shape=box,color=blue];
		j2376879687 -> j506722486;
		j2376879687 -> j3805335412;
		j2376879687 -> j2943924055;
	j3617267929 [label="Ага, вони досить добре мене знають\nАле я не близька ні з ким\nКрім, можливо, Артура",shape=box,color=blue];
		j3617267929 -> j1472439164;
		j3617267929 -> j1406337004;
		j3617267929 -> j252424452;
	j3120999496 [label="Думаєш, я цього не знаю, babas?",shape=box,color=blue];
