	j30108883 [label="Jajaja ні\nАле добре мати більше людей\nОсобливо цю, вона знає як подбати про себе\nДобре мати поруч того кого мені не доведеться зішкрібати з підлоги",shape=box,color=blue];
		j30108883 -> j3804857621;
	j1252551049 [label="JAJAJAJA\nЩо ти маєш на увазі?!\nДобре мати більше людей\nОсобливо цю, вона знає як подбати про себе\nДобре мати поруч того кого мені не доведеться зішкрібати з підлоги",shape=box,color=blue];
		j1252551049 -> j3804857621;
	j3804857621 [label="І цей Велимир змушує мене посміхатися\nЯ ціную чоловіків які точно знають хто вони\nAlguien auténtico y fiel a sí mismo, ¿sí?\nДнями він дозволив Аой фарбувати йому нігті на ногах jajajaja\nПоки він розповідав про свої улюблені «лібертаріанські» м'язисті машини\nЙому було чхати",shape=box,color=blue];
		j3804857621 -> j3981286004;
	j3981286004 [label="Не знаю чи буде більше\nАле вперше за довгий час\nЯ на це сподіваюся",shape=box,color=blue];
		j3981286004 -> "Chat ends.";
	"Chat ends." [color=orange];
