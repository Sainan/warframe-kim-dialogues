		j2165669047 -> j4172583155 [label=false,color=brown];
	"Chat ends." [color=orange];
	j2985555336 [label="Check boolean LettieConsentComplete",color=orange];
		j2985555336 -> "Chat ends." [label=true,color=green];
		j2985555336 -> j2735428637 [label=false,color=brown];
		j2985555336 -> j1759791336 [label=false,color=brown];
	j4172583155 [label="Check boolean LettiePolyamorySuccess",color=orange];
		j4172583155 -> j2985555336 [label=true,color=green];
		j4172583155 -> "Chat ends." [label=false,color=brown];
	j2735428637 [label="Привітик, Летті. Зайнята? [Спитати про згоду на кількох партнерів]",shape=box,color=red];
		j2735428637 -> j1537039889;
	j1759791336 [label="[Завершити розмову]",shape=box,color=red];
		j1759791336 -> j3702107533;
	j1537039889 [label="Завжди\nале не для тебе\n¿Qué?",shape=box,color=blue];
		j1537039889 -> j1633440357;
	j3702107533 [label="Boolean LettieConsentComplete is now true.",color=orange];
		j3702107533 -> "Chat ends.";
	j1633440357 [label="Хочу обговорити з тобою дещо, дізнатися, чи ти не проти.",shape=box,color=red];
		j1633440357 -> j1929151681;
	j1929151681 [label="Я не хочу, щоб у тебе була думка, що я брешу чи якось нечесно поводжуся.",shape=box,color=red];
		j1929151681 -> j3409636707;
		j1929151681 -> j1159669199;
		j1929151681 -> j696144941;
	j3409636707 [label="Тільки не бий.",shape=box,color=red];
		j3409636707 -> j8486771;
	j1159669199 [label="Тільки не казися.",shape=box,color=red];
		j1159669199 -> j3734674029;
	j696144941 [label="Сподіваюся, ти зрозумієш.",shape=box,color=red];
		j696144941 -> j2227540667;
	j8486771 [label="Jajajajaj\nми ж це обговорили\nЯ роблю боляче тільки так, щоб тобі подобалося\nВикладуй, про що ти взагалі",shape=box,color=blue];
		j8486771 -> j1337299854;
	j3734674029 [label="¿Sí?\nІ від чого я маю казитися?",shape=box,color=blue];
		j3734674029 -> j1337299854;
	j2227540667 [label="¿Sí?\nІ що я маю зрозуміти?",shape=box,color=blue];
		j2227540667 -> j1337299854;
	j1337299854 [label="Не хочу ставити тебе в незручне становище. Ми раніше цього не обговорювали. Тож якщо відмовиш, то це нічого. Просто хочу, щоб ти знала.",shape=box,color=red];
		j1337299854 -> j3070640872;
	j3070640872 [label="Те, що в нас є, важливе для мене — дуже-дуже. І воно реальне. Я не хочу, щоб ти сумнівалася в цьому.",shape=box,color=red];
		j3070640872 -> j1241452804;
	j1241452804 [label="Aah, entiendo...\nдумаю маю право спитати\nЦя особа тобі дійсно небайдужа, solecito?\n¿Quiénes son?",shape=box,color=blue];
		j1241452804 -> j953941514;
		j1241452804 -> j2408858143;
	j953941514 [label="Так, але ти мені теж дуже небайдужа.",shape=box,color=red];
		j953941514 -> j2220830141;
	j2408858143 [label="Треба було здогадатися, що ти миттєво зрозумієш що до чого.",shape=box,color=red];
		j2408858143 -> j352991604;
	j2220830141 [label="Ay, sí\nСкладно тебе винити, коли ти стільки різного бачиш\nбуваєш у стількох різних місцях\nмене все влаштовує",shape=box,color=blue];
		j2220830141 -> j1493736253;
	j352991604 [label="Я змахлювала\nЕлеонора попередила мене\nJajaja вона страшенна пліткарка",shape=box,color=blue];
		j352991604 -> j606789921;
	j1493736253 [label="Але це мають бути не прокльонівці\nMi familia no, ¿por favor?\nмені б довелося тиждень до крові витиратися антисептичними серветками",shape=box,color=blue];
		j1493736253 -> j987113152;
	j606789921 [label="Складно тебе винити, коли ти стільки різного бачиш\nбуваєш у стількох різних місцях\nмене все влаштовує",shape=box,color=blue];
		j606789921 -> j1493736253;
	j987113152 [label="+20 Chemistry",color=orange];
		j987113152 -> j3031978167;
	j3031978167 [label="Ти ж знаєш про свою виняткову важливість для мене, solecito\nІ якщо ще хтось додає тобі щастя?\nТо я теж від цього щаслива\nУсе просто",shape=box,color=blue];
		j3031978167 -> j3122847443;
	j3122847443 [label="І ще дещо\nЗнайди спосіб якогось дня звести нас разом\nдуже хочеться познайомитися",shape=box,color=blue];
		j3122847443 -> j558804786;
		j3122847443 -> j120349412;
	j558804786 [label="Так, пані :)",shape=box,color=red];
		j558804786 -> j3702107533;
	j120349412 [label="Подивлюся, що зможу зробити.",shape=box,color=red];
		j120349412 -> j3702107533;
}