	j154311679 [label="Це звучить жахливо… мені прикро.",shape=box,color=red];
		j154311679 -> j2567568177;
	j1859993275 [label="Aaaay babaaas не БУКВАЛЬНО\nЦе дрібнички, які нашіптують мені нісенітницю, у яку я зрештою вірю, бо надто дурна",shape=box,color=blue];
		j1859993275 -> j1082654712;
		j1859993275 -> j154311679;
	j2117403489 [label="¡¿Qué?! Яка чудова ідея\nЯ спробую просто зараз",shape=box,color=blue];
		j2117403489 -> "Chat ends.";
	j825707712 [label="Що я зазнаю невдачі\nЩо я нікому не подобаюся\nЩо я некрасива\nЩо я товста\nЩо в мене немає талантів\nЩо в мене немає навичок\nЩо щастя скоро закінчиться\nЩо я не заслуговую хорошого",shape=box,color=blue];
		j825707712 -> j2311677654;
		j825707712 -> j3389882438;
		j825707712 -> j2370448164;
	j2567568177 [label="М-м\nТаке життя",shape=box,color=blue];
		j2567568177 -> j2440909808;
	j2311677654 [label="Принаймні ти знаєш, що твої павуки брехуни, але… вони звучать як повні мудаки.",shape=box,color=red];
		j2311677654 -> j1613846859;
