		j3389882438 -> j2346895773;
	j2370448164 [label="Ти думала про пігулки чи лікування? Депресія це дуже серйозно.",shape=box,color=red];
		j2370448164 -> j3529572954;
	j2440909808 [label="Повертаюся до роботи\nLo siento, ненавиджу тобі скиглити",shape=box,color=blue];
		j2440909808 -> j1933300832;
	j1613846859 [label="Вони маленькі pinches cabronas\nЦей смуток невеликий, але він може повільно труїти життя, якщо стає надто сильним \nУ mi mamá це було все життя, тож я бачила, як це шкодить",shape=box,color=blue];
		j1613846859 -> j1061690778;
	j2346895773 [label="Тоді ти справді розумієш, як це, mi corazón\nВони маленькі pinches cabronas\nАле вони брехуни, пам’ятай про це завжди\nЦей смуток невеликий, але він може повільно труїти життя, якщо стає надто сильним \nУ mi mamá це було все життя, тож я бачила, як це шкодить",shape=box,color=blue];
		j2346895773 -> j3805517684;
	j3529572954 [label="Ay sí\nУ mi mamá це було все життя\nТож я бачила, якої шкоди це завдає\nНа щастя, мої не такі вже й погані, вони не досягають такого рівня\nЯ пробувала приймати пігулки, але ненавиджу побічні дії від них",shape=box,color=blue];
		j3529572954 -> j3118172969;
	j1933300832 [label="+10 Chemistry",color=orange];
		j1933300832 -> "Chat ends.";
	j1061690778 [label="Але ось чому я називаю їх павуками\nТому що ти можеш згорнути газету в трубочку\nІ РОЗЧАВИТИ ЇХ НЕЮ\nВони маленькі і крихкі",shape=box,color=blue];
		j1061690778 -> j1604297625;
		j1061690778 -> j2645251982;
	j3805517684 [label="Але ось чому я називаю їх павуками\nТому що ти можеш згорнути газету в трубочку\nІ РОЗЧАВИТИ ЇХ НЕЮ\nВони маленькі і крихкі",shape=box,color=blue];
		j3805517684 -> j1900525534;
		j3805517684 -> j2734935978;
	j3118172969 [label="Розслабся, я не хочу танцювати з La Flaca\nІ не бажаю болю, який не приносить задоволення jajaja\nЦе лише маленький смуток, як павучки",shape=box,color=blue];
