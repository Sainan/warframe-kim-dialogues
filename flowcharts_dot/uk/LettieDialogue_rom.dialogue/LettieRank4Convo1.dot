digraph {
	1002 [label="LettieRank4Convo1 begins.",color=orange];
		1002 -> 1003;
		1002 -> 1004;
		1002 -> 1005;
	1003 [label="Отже, я так і не знаю всієї історії про те, як ти познайомилася з Артуром.",shape=box,color=red];
		1003 -> 1011;
	1004 [label="У тебе є хвилинка потеревенити, Летті? Або ти зайнята?",shape=box,color=red];
		1004 -> 1008;
	1005 [label="[Завершити розмову]",shape=box,color=red];
		1005 -> 1006;
	1011 [label="О, це дика історія
Я думала, що ти не хочеш знати кривавих подробиць
Але sí, якщо ти хочеш
То можу розповісти",shape=box,color=blue];
		1011 -> 1012;
	1008 [label="+5 Chemistry",color=orange];
		1008 -> 1009;
	1006 [label="Chat ends.",color=orange];
	1012 [label="Ми були розміщені разом на одній базі
Він у британській армії, а я в лібертатійській
Країни різні, а вороги однакові",shape=box,color=blue];
		1012 -> 1013;
	1009 [label="Завжди зайнята 
Але я можу зробити перерву 
¿Qué onda?",shape=box,color=blue];
		1009 -> 1010;
	1013 [label="Я була польовою медикинею у своєму полку 
Нас відправили на позицію поряд із його 
Те місце стало справжнім cagadero 
У одну мить",shape=box,color=blue];
		1013 -> 1014;
	1010 [label="Та стало цікаво як ти познайомилася з Артуром.",shape=box,color=red];
		1010 -> 1011;
	1014 [label="Більшість моєї команди не вижила 
Так само і його 
Ми трималися разом 
Буквально 
Я зашила його руку, щоб мала гарний вигляд jaja
Коли він пішов у відставку і приєднався до МКР 
Я пішла за ним без питань 
Мені давно набридла вся драма в армії",shape=box,color=blue];
		1014 -> 1015;
	1015 [label="Я сказала йому, що піду за ним усюди й до кінця
Але не уявляла, що кінець заведе мене до Mictlán",shape=box,color=blue];
		1015 -> 1016;
	1016 [label="Тобі, мабуть, здається це дріб’язком
Ще одна дурна історія
Ти борешся з монстрами та богами
La Flaca стільки разів танцювала з тобою",shape=box,color=blue];
		1016 -> 1017;
	1017 [label="Update boolean LettieArthur1",color=orange];
		1017 -> 1018;
		1017 -> 1019;
		1017 -> 1020;
	1018 [label="Те, що мої проблеми трохи видовищні, не означає, що я не можу оцінити, наскільки це жахливо для тебе.",shape=box,color=red];
		1018 -> 1021;
	1019 [label="Кожна війна — лайно та й крапка.",shape=box,color=red];
		1019 -> 1022;
	1020 [label="Ех, маленькі люди, маленькі історії.",shape=box,color=red];
		1020 -> 1023;
	1021 [label="+10 Chemistry",color=orange];
		1021 -> 1024;
	1022 [label="+15 Chemistry",color=orange];
		1022 -> 1025;
	1023 [label="Seguro",shape=box,color=blue];
		1023 -> 1026;
	1024 [label="Ay, sí
Величні та яскраві, або маленькі й особисті
La Flaca зрештою однакова
Принаймні… вона має бути
Але не для los fantasmas",shape=box,color=blue];
		1024 -> 1027;
	1025 [label="Sí, це все одно
Неважливо, наскільки велика чи дурна зброя",shape=box,color=blue];
		1025 -> 1028;
	1026 [label="Update boolean LettieNoDate",color=orange];
		1026 -> 1029;
