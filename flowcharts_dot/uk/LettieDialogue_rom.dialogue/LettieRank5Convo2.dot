	1784 [label="Solecito
Ти тут?
У мене є кілька вільних хвилин, і я хотіла з тобою поговорити",shape=box,color=blue];
		1784 -> 1786;
		1784 -> 1787;
		1784 -> 1788;
	1785 [label="Агов
Ти тут?
У мене є кілька вільних хвилин, і я хотіла з тобою поговорити",shape=box,color=blue];
		1785 -> 1787;
		1785 -> 1788;
	1786 [label="Ти ж не кидаєш мене, правда?",shape=box,color=red];
		1786 -> 1790;
	1787 [label="ТИ хочеш поговорити?.. Усе гаразд? Хтось помер?",shape=box,color=red];
		1787 -> 1791;
	1788 [label="Вибач, зараз не можу. [Завершити розмову]",shape=box,color=red];
		1788 -> 1789;
	1790 [label="¡Ay, no! 
Ні-ні-ні
Я не про це jajaja 
Хоча ТИ можеш змінити СВОЮ думку, коли я закінчу говорити",shape=box,color=blue];
		1790 -> 1792;
		1790 -> 1793;
	1791 [label="Jaja дуже смішно
Тут кожен хоч раз помирав
Ай, ні, що я хочу сказати
Це серйозно
І те, чого я уникала",shape=box,color=blue];
		1791 -> 1793;
		1791 -> 1792;
	1789 [label="Chat ends.",color=orange];
	1792 [label="Добре… тоді про що?",shape=box,color=red];
		1792 -> 1794;
	1793 [label="Гаразд. Я слухаю.",shape=box,color=red];
		1793 -> 1794;
	1794 [label="Check boolean LettieHexAsked",color=orange];
		1794 -> 1795 [label=true,color=green];
		1794 -> 1796 [label=false,color=brown];
	1795 [label="Ти питаєш, як ми стали цими monstruos 
Що з нами зробив той pinche cabrón
Чому я його так ненавиджу
Що той гівнюк змусив нас зробити",shape=box,color=blue];
		1795 -> 1801;
	1796 [label="Check boolean LettieEntrati",color=orange];
		1796 -> 1797 [label=true,color=green];
		1796 -> 1798 [label=false,color=brown];
	1801 [label="Отже 
Я пішла слідом за Артуром до МРК
Мене відправили сюди в цю cuchitril, щоби боротися з якоюсь дивною чумою, яку ніхто раніше не бачив",shape=box,color=blue];
		1801 -> 1802;
	1797 [label="Ти мусиш знати, що з нами зробив той pinche cabrón
Чому я його так ненавиджу
Що той гівнюк змусив нас зробити",shape=box,color=blue];
		1797 -> 1801;
	1798 [label="Check boolean LettieArthur1",color=orange];
		1798 -> 1799 [label=true,color=green];
		1798 -> 1800 [label=false,color=brown];
	1802 [label="Хворобою, що пожирає людей
Перетворює їх на напівмашини
А іноді на щось, що взагалі втрачає все людське, más bien computadoras",shape=box,color=blue];
		1802 -> 1803;
	1799 [label="Я розповідала тобі, як ми з Артуром стали hermanos 
Але не те, як ми перетворилися на цих monstruos 
Ти мусиш знати, що з нами зробив той pinche cabrón
Чому я його так ненавиджу
Що той гівнюк змусив нас зробити",shape=box,color=blue];
		1799 -> 1801;
	1800 [label="Ти багато робиш для нас 
Рятуєш наші життя, залишаєшся з нами… коли можеш піти 
Настав час тобі почути всю історію",shape=box,color=blue];
		1800 -> 1801;
	1803 [label="Нас відправили «розібратися з цим»
Наскільки зможемо
Десь бинтами
А десь кулями",shape=box,color=blue];
		1803 -> 1804;
	1804 [label="Це було на початку 1998 року 
Ще до твоєї появи
Той cabrón Ентраті уже був тут 
Продавав свої MENTIRAS",shape=box,color=blue];
		1804 -> 1805;
	1805 [label="Але найкращі брехні — це ті, в які ти хочеш вірити, ¿verdad?
У нас не було ліків проти цієї хвороби, окрім танцю з La Flaca
І ось тут він з’явився
Доктор П і його чарівний мішок чудес вилікують те, що вас хвилює
Він обіцяв, що зможе все виправити своїми medicina milagrosa",shape=box,color=blue];
		1805 -> 1806;
	1806 [label="І ми купилися на це como una bola de mensos
І коли МРК казав: «Ні, ні, ви не можете допомагати йому розповсюджувати його наркотики», ми повинні були прислухатися
Вакцини роблять вчені, а не старигані в огидних плащах
Продавати брехню, як чудеса старого світу
Поки навколо всюди гинуть люди?
Зрештою ми допомогли йому, тому що хотіли ВРЯТУВАТИ людей",shape=box,color=blue];
		1806 -> 1807;
	1807 [label="Тому ми допомагали йому вводити наркотики людям цього міста
Вишикували їх у наших наметах, і потім ми з тим cabrón один за одним кололи їм отруту
А інші прикривали нас і підтримували операцію",shape=box,color=blue];
		1807 -> 1808;
	1808 [label="NOSOTROS CREÍMOS EN ÉL 
Ми довіряли йому 
¿Y por tan poco? 
Здавалося, це працює 
Люди, які отримали вакцину, не хворіли 
У чому ж тоді проблема?..",shape=box,color=blue];
		1808 -> 1809;
	1809 [label="Захворіли всі навколо НИХ
Ти знаєш, що таке «тихі носії»? 
Одного літа я пішла волонтером у притулок для тварин cuando estaba chiquita 
Там було дуже багато єнотів
Їх не могли відпустити, бо вони могли бути тихими носіями сказу 
ВОНИ виглядали здоровими, здавалися нормальними…",shape=box,color=blue];
		1809 -> 1810;
	1810 [label="Але якби ми їх відпустили? 
Вони заразили б усіх навкруги
Ось що ми робили з тими людьми 
ОСЬ ЩО ВІН ЗМУШУВАВ НАС РОБИТИ З ЛЮДЬМИ 
¡LO HIZO A PROPÓSITO!
Це місце стало околицею Mictlán POR SU CULPA",shape=box,color=blue];
		1810 -> 1811;
	1811 [label="Навіть коли ми почали підозрювати
Ми не могли повірити
Ми перешіптувалися між собою
Але потім хитали головами і казали
Що ні-ні-ні, цього не може бути
Що він би цього не зробив
Не з нами",shape=box,color=blue];
		1811 -> 1812;
	1812 [label="Update boolean LettieHex",color=orange];
		1812 -> 1813;
	1813 [label="Check boolean LettieDating",color=orange];
		1813 -> 1814 [label=true,color=green];
		1813 -> 1815 [label=false,color=brown];
	1814 [label="Ми не хотіли вірити
Що нашою довірою скористалися
Ми… теж поробили щеплення, solecito…
І поширювали чуму навколо…",shape=box,color=blue];
		1814 -> 1816;
	1815 [label="Ми не хотіли вірити
Що нашою довірою скористалися
Ми… теж поробили щеплення…
І поширювали чуму навколо…",shape=box,color=blue];
		1815 -> 1816;
	1816 [label="Тож коли він сказав, що штам техногнилі мутував… і ми більше не в безпеці…",shape=box,color=blue];
		1816 -> 1817;
	1817 [label="Ми вишикувалися 
Як слухняні маленькі soldaditos",shape=box,color=blue];
		1817 -> 1818;
	1818 [label="Клянуся Луа, це було боляче
І це був не хороший біль…
Аой кричала гучніше за всіх
Я не могла їй допомогти, бо сама помирала в муках
Вона плакала від страху, і все, що я хотіла зробити, це обійняти її",shape=box,color=blue];
		1818 -> 1819;
	1819 [label="Сказати їй, що все буде добре 
Що біль мине і La Flaca забере її з собою
Вона так боялася, і я не могла їй допомогти 
Мої ноги не рухалися…",shape=box,color=blue];
		1819 -> 1820;
	1820 [label="Тож я буду ненавидіти цього гівнюка
Усе моє нескінченне життя
За цю зраду",shape=box,color=blue];
		1820 -> 1821;
	1821 [label="А якщо я його ще раз побачу?
Тобі краще бути поруч і тримати мене
Бо я покажу йому, що таке справжній біль",shape=box,color=blue];
		1821 -> 1822;
		1821 -> 1823;
		1821 -> 1824;
		1821 -> 1825;
	1822 [label="Таїти таку образу нездорово, навіть якщо те, що він зробив з вами, було неправильним.",shape=box,color=red];
		1822 -> 1826;
	1823 [label="Хай йому грець… це важко уявити. Мені дуже шкода, що він так вас використав. Я б теж його ненавидів.",shape=box,color=red];
		1823 -> 1827;
	1824 [label="Я… гм… чекай. Тож ви всі частково винні в поширенні техногнилі?",shape=box,color=red];
		1824 -> 1828;
	1825 [label="Вибач, ти мене на хвилинку приспала. Що ти там розповідала?",shape=box,color=red];
		1825 -> 1829;
	1826 [label="Ви тільки послухайте
Уклонімося всі Святому Babas 
Пробачимо ж усі гріхи
Ні
Деякі гріхи не можна пробачити
Зокрема ті, що він зробив з нами
І що ми зробили з людьми цього міста",shape=box,color=blue];
		1826 -> 1833;
		1826 -> 1834;
		1826 -> 1836;
	1827 [label="Sí
Я взагалі не сприймаю зраду
Але ми хотіли вірити йому, і це нас засліпило
Якщо ти захочеш триматися якомога далі від нас, я зрозумію
Інші також",shape=box,color=blue];
		1827 -> 1833;
		1827 -> 1834;
		1827 -> 1836;
	1828 [label="Sí
Ми винні
Але ми хотіли вірити йому, і це нас засліпило
Якщо ти захочеш триматися якомога далі від нас, я зрозумію
Інші також",shape=box,color=blue];
		1828 -> 1833;
		1828 -> 1834;
		1828 -> 1836;
	1829 [label="Update boolean LettieDating",color=orange];
		1829 -> 1830;
	1833 [label="Я тут не для того, щоб казати тобі, що пробачати або ні. Це не те, що я можу робити, і, відверто, я не думаю, що таке МОЖНА пробачити.",shape=box,color=red];
		1833 -> 1839;
	1834 [label="Ентраті прийшов сюди й знайшов саме те, що шукав — корисних, вмілих людей, яких він міг обманом змусити робити те, що він хотів. І які б сліпо йому вірили. Ви потрапили в його пастку, як і багато інших до вас.",shape=box,color=red];
		1834 -> 1837;
	1836 [label="У тому, що сталося, винні не ви. Вас обдурили. Так, звичайно — можливо, ви були трохи сліпими після того, як усе почало йти не так. Але хто може вас звинуватити? Надія - небезпечний наркотик. І він накачав вас ним.",shape=box,color=red];
		1836 -> 1838;
	1830 [label="Update boolean IsDating",color=orange];
		1830 -> 1831;
	1839 [label="Люди загинули. Вони не повернуться. Тому що ви хотіли повірити в чудодійну вакцину, продану якимось «стариганем в огидному плащі».",shape=box,color=red];
		1839 -> 1842;
	1837 [label="Ви хотіли повірити його брехні. І зробили це. Це ваша вина. Люди, які через це захворіли? Теж ваша.",shape=box,color=red];
		1837 -> 1839;
		1837 -> 1840;
	1838 [label="Тож, звичайно, ви пішли на це. Звичайно, ви хотіли вірити, що є шанс.",shape=box,color=red];
		1838 -> 1841;
	1831 [label="Update boolean LettieNoDate",color=orange];
		1831 -> 1832;
	1842 [label="І я не можу звільнити тебе від цього. Вибач.",shape=box,color=red];
		1842 -> 1845;
	1840 [label="Але люди роблять помилки. І беруть на себе відповідальність. І ти тут і намагаєшся це зробити. Отже… я бачу людей, які намагаються зробити те, що правильно, в ім’я того, що вони зробили неправильно.",shape=box,color=red];
		1840 -> 1843;
	1841 [label="Мені б довелося вчинити так само.",shape=box,color=red];
		1841 -> 1835;
	1832 [label="Chat ends.",color=orange];
	1845 [label="Check boolean LettieDating",color=orange];
		1845 -> 1846 [label=true,color=green];
		1845 -> 1847 [label=false,color=brown];
	1843 [label="І я не думаю, що нормальна людина може вимагати чогось більшого. Це не змінює моєї думки про вас. Я бачу людей, які зазнали невдачі. Але не здалися. І я знаю як це. Повір мені.",shape=box,color=red];
		1843 -> 1844;
	1835 [label="¿Sí?
Йой… тоді ми тут усі ідіоти jajaja
Можливо, твоє місце ДІЙСНО з нами
Ох
У мене болять ноги
Mierda, все болить",shape=box,color=blue];
		1835 -> 1844;
	1846 [label="Sí
Маєш рацію
Ми наробили помилок
І я зробила ще одну, коли подумала, що у нас ЩОСЬ може вийти",shape=box,color=blue];
		1846 -> 1852;
	1847 [label="Sí
