		j110647738 -> j3904595501;
	"Chat ends." [color=orange];
	j1350530035 [label="Ги, ну дяка.",shape=box,color=red];
		j1350530035 -> j708793972;
	j4107269020 [label="Ну це так… звичайно, але…",shape=box,color=red];
		j4107269020 -> j708793972;
	j708793972 [label="Потім усе пішло від поганого до гіршого\nВід лайна до ще більшого лайна\nІ кошмар ставав ще темнішим\nІ БУДЬ-ЯКА ЛЮДИНА зі справною макітрою вже б втікла назад у майбутнє",shape=box,color=blue];
		j708793972 -> j940336490;
	j940336490 [label="Але ти тут\nТи залишаєшся з невідомої дурної причини\nТи залишаєшся з нами, борешся та допомагаєш нам згуртуватися",shape=box,color=blue];
		j940336490 -> j1941086285;
	j1941086285 [label="Ay, Луа, salvame \nЯ досі НЕ знаю чому \nУ тебе не було причин залишатися тут для нас, купки незнайомців",shape=box,color=blue];
		j1941086285 -> j1387050652;
	j1387050652 [label="Check boolean LettieReligion2",color=orange];
		j1387050652 -> j2746720782 [label=true,color=green];
		j1387050652 -> j1551587699 [label=false,color=brown];
	j2746720782 [label="Я бачила обличчя твого Шіпе-Тотека, і я б на твоєму місці втікла у найдальший куток і молилася, щоб він не здер моє наступним",shape=box,color=blue];
		j2746720782 -> j1551587699;
	j1551587699 [label="Check boolean LettieCavia",color=orange];
		j1551587699 -> j1029820686 [label=true,color=green];
		j1551587699 -> j466073509 [label=false,color=brown];
	j1029820686 [label="Я б прийняла кавій за свою сім’ю і залишилася з ними\nВони здаються МЕНШ зламаними та набагато більше заслуговують любові",shape=box,color=blue];
		j1029820686 -> j466073509;
	j466073509 [label="Check boolean LettieDating",color=orange];
		j466073509 -> j4125224585 [label=true,color=green];
		j466073509 -> j4251981599 [label=false,color=brown];
	j4125224585 [label="Check boolean LettieReal",color=orange];
		j4125224585 -> j3384910636 [label=true,color=green];
		j4125224585 -> j3742923001 [label=false,color=brown];
	j4251981599 [label="Але ти тут\nІ я знайшла міцну дружбу, якої ніколи не очікувала \nТаку, без якої я навіть не знаю, як я виживала",shape=box,color=blue];
		j4251981599 -> j1914078138;
	j3384910636 [label="Але ти ТУТ\nА для мене… ти набагато більше, ніж це…\nЩо я хочу сказати, mi corazón",shape=box,color=blue];
		j3384910636 -> j1914078138;
	j3742923001 [label="Але ти ТУТ\nІ маєш нахабство казати, що я тобі подобаюся jajaja",shape=box,color=blue];
		j3742923001 -> j1914078138;
	j1914078138 [label="З тобою поряд… ми не fantasmas\nБез тебе ми були б загублені та занедбані\nМи б знову і знову сноходили крізь наші смерті, безглузді та порожні\nНа краю Mictlán",shape=box,color=blue];
		j1914078138 -> j1595476292;
	j1595476292 [label="Check boolean LettieNewFamily",color=orange];
		j1595476292 -> j3775503101 [label=true,color=green];
		j1595476292 -> j3009833502 [label=false,color=brown];
	j3775503101 [label="Але ти робиш нас новою сім’єю\nНавіть la bruja y yo jajaja\nІ зараз я їх люблю понад усе\nІ це все завдяки тобі",shape=box,color=blue];
		j3775503101 -> j2677716896;
	j3009833502 [label="Check boolean LettieKindness",color=orange];
		j3009833502 -> j1315901291 [label=true,color=green];
		j3009833502 -> j2957683688 [label=false,color=brown];
	j2677716896 [label="Терпіти не можу, коли стаю такою сентиментальною\nЦе зводить мене з розуму\nЯ жахлива в цьому\nТому я підсумую свої думки",shape=box,color=blue];
		j2677716896 -> j168342390;
		j2677716896 -> j153304552;
		j2677716896 -> j4035569760;
	j1315901291 [label="Але ти показуєш мені важливість маленьких митей\nЗ доброти та любові, яку ми даруємо одне одному\nОсь чому ми тут \nІ все це завдяки тобі",shape=box,color=blue];
		j1315901291 -> j2677716896;
	j2957683688 [label="Але ти показуєш мені, що справді важливо\nВажлива компанія, а не пункт призначення\nДовіра, любов і доброта, які ми відчуваємо один до одного\nІ це все завдяки тобі",shape=box,color=blue];
		j2957683688 -> j2677716896;
	j168342390 [label="Ха-ха. У тебе чудово виходить.",shape=box,color=red];
		j168342390 -> j407131291;
	j153304552 [label="Навіть не знаю. Мені подобається мила Летті.",shape=box,color=red];
		j153304552 -> j407131291;
	j4035569760 [label="Га? Ти мене знову приспала.",shape=box,color=red];
		j4035569760 -> j3606744485;
	j407131291 [label="Check boolean LettieDating",color=orange];
		j407131291 -> j2969545787 [label=true,color=green];
		j407131291 -> j1692448339 [label=false,color=brown];
	j3606744485 [label="Boolean IsDating is now false.",color=orange];
		j3606744485 -> j2226684218;
	j2969545787 [label="Check boolean LettieReal",color=orange];
		j2969545787 -> j1170466809 [label=true,color=green];
		j2969545787 -> j497283431 [label=false,color=brown];
	j1692448339 [label="Не звикай до цього\nЯ все одно надеру тобі дупу\nРіч у тому, що я вже звикла, що ти плутаєшся під ногами\nМені подобається, що ти поруч",shape=box,color=blue];
		j1692448339 -> j246311840;
	j2226684218 [label="Boolean LettieDating is now false.",color=orange];
		j2226684218 -> j2703113057;
	j1170466809 [label="Не звикай до цього, mi corazón\nЯ ще можу надерти тобі дупку\nAy, так ось…",shape=box,color=blue];
		j1170466809 -> j3979665989;
	j497283431 [label="Не звикай до цього, solecito\nЯ все одно надеру тобі дупу\nРіч у тому, що я вже звикла, що ти плутаєшся під ногами\nМені подобається, що ти поруч",shape=box,color=blue];
		j497283431 -> j3935360480;
	j246311840 [label="Я дуже ціную нашу дружбу\nІ я покладаюся на тебе, як ні на кого\nЯ довіряю тобі, і це не те, що дається мені легко",shape=box,color=blue];
		j246311840 -> j1975772861;
	j2703113057 [label="Boolean LettieNoDate is now true.",color=orange];
		j2703113057 -> "Chat ends.";
	j3979665989 [label="Te amo, mi corazón \nЯ кохаю тебе, моє серденько",shape=box,color=blue];
		j3979665989 -> j706847774;
		j3979665989 -> j2592362410;
	j3935360480 [label="Me importas mucho \nЯ дуже дбаю про тебе\nІ я покладаюся на тебе, як ні на кого\nЯ довіряю тобі, і це не те, що дається мені легко",shape=box,color=blue];
		j3935360480 -> j3335774466;
	j1975772861 [label="За нас, друзяко\nІ за прийдешнє\nНаповнене fantasmas та нескінченним майбутнім, богами та демонами, якими б вони не були\nМи маємо одне одного\nІ для мене цього достатньо",shape=box,color=blue];
		j1975772861 -> "Chat ends.";
	j706847774 [label="Я не відчуваю те саме до тебе, вибач…",shape=box,color=red];
		j706847774 -> j1699380299;
	j2592362410 [label="Я… я теж кохаю тебе, Летті. Мені складно було навіть уявити… в мені стільки щастя.",shape=box,color=red];
		j2592362410 -> j2461529208;
	j3335774466 [label="За нас, solecito\nІ за прийдешнє\nНаповнене fantasmas та нескінченним майбутнім, богами та демонами, якими б вони не були\nМи маємо одне одного\nІ для мене цього достатньо",shape=box,color=blue];
		j3335774466 -> "Chat ends.";
	j1699380299 [label="Ay \nSí \nДобре",shape=box,color=blue];
		j1699380299 -> j2654206738;
	j2461529208 [label="JAJAJA síí\nМене важко зрозуміти, я знаю\nМ-м-м, я теж така щаслива\nВідсвяткуємо сьогодні вночі, ¿mm?",shape=box,color=blue];
		j2461529208 -> j2818163185;
	j2654206738 [label="Ось чому… я не довіряю людям jajaja",shape=box,color=blue];
		j2654206738 -> j638504166;
	j2818163185 [label="Не став мені питань\nНе приховуй своїх фантазій\nЯ хочу побачити, чого ти БАЖАЄШ, ¿entendiste?",shape=box,color=blue];
		j2818163185 -> j3827452618;
		j2818163185 -> j4211762370;
	j638504166 [label="Добре, буває\nЩе одна моя дурна помилка\nТоді нам краще все закінчити\nТи розумієш",shape=box,color=blue];
		j638504166 -> j3606744485;
	j3827452618 [label="Так, паняночко.",shape=box,color=red];
		j3827452618 -> j276918144;
	j4211762370 [label="<RETRO_EMOJI_SNEAKY>",shape=box,color=red];
		j4211762370 -> j276918144;
	j276918144 [label="Я таке люблю\nЗа нас, mi corazón\nІ за прийдешнє\nНаповнене fantasmas та нескінченним майбутнім, богами та демонами, якими б вони не були\nУ нас є наше кохання\nІ для мене цього достатньо",shape=box,color=blue];
