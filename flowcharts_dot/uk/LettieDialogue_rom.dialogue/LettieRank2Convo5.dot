		471 -> 473;
		471 -> 474;
	463 [label="Chat ends.",color=orange];
	472 [label="Навіть якщо вона ніколи не піддасться техногнилі
І якщо такою й залишиться, мені байдуже
Ця bruja надто любить усе це лайно",shape=box,color=blue];
		472 -> 476;
		472 -> 477;
	473 [label="Не присилала. Я тут за власним бажанням.",shape=box,color=red];
		473 -> 477;
		473 -> 476;
	474 [label="Не має значення, вона прислала мене чи ні, я все одно вважаю, що тобі слід бути легше з нею.",shape=box,color=red];
		474 -> 475;
	476 [label="Те, що вона прийняла те, що з нею сталося, не робить її поганою.",shape=box,color=red];
		476 -> 478;
	477 [label="Мені здається, що ти несправедлива з нею, Летті.",shape=box,color=red];
		477 -> 479;
	475 [label="І чого б це? 
Вона може в будь-яку мить піддатися техногнилі
І навіть якщо ні, ця bruja надто всім цим насолоджується 
Ми всі тепер монстри, але різниця в тому, що їй це ПОДОБАЄТЬСЯ",shape=box,color=blue];
		475 -> 477;
		475 -> 476;
	478 [label="Одна справа прийняти це
