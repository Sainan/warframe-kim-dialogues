		479 -> 481;
		479 -> 480;
	480 [label="Вона твоя напарниця, Летті. Подобається тобі це чи ні, ви з нею в цьому разом. Тобі потрібно відпустити образи.",shape=box,color=red];
		480 -> 482;
	481 [label="Вона втратила голос. Змушена весь час слухати думки інших. Вона також бачить дивні речі, яких вона не розуміє.",shape=box,color=red];
		481 -> 483;
		481 -> 484;
	482 [label="Та звичайно 
