		482 -> 486;
	483 [label="І вона найближче за всіх до техногнилі. Можеш собі уявити, як це – постійно чути їхні голоси?",shape=box,color=red];
		483 -> 496;
	484 [label="І після цього ВИ ставитеся до неї як до справжнього монстра. Можеш собі уявити, що вона відчуває?",shape=box,color=red];
