digraph {
	290 [label="LettieRank4Convo6 begins.",color=orange];
		290 -> 253;
	253 [label="Esa gata, та химерна кішка-мутантка
Постійно дивиться голодними очима на моїх panquecitos
Мені це не подобається",shape=box,color=blue];
		253 -> 351;
		253 -> 415;
	351 [label="Ти про Калимос? Я подбаю про те, щоб вона залишила твоїх пацюків у спокої.",shape=box,color=red];
		351 -> 417;
	415 [label="Калимос не скривдить твоїх пацюків.",shape=box,color=red];
		415 -> 426;
	417 [label="Ні 
Це тваринка ентраті, а не твоя
Вона робить те, що він хоче
Вона дивиться на мене так само як і він",shape=box,color=blue];
		417 -> 444;
	426 [label="¿Sí? 
Звідки тобі знати?
Це тваринка ентраті, а не твоя
Вона робить те, що він хоче
Вона дивиться на мене так само як і він",shape=box,color=blue];
		426 -> 454;
	444 [label="І як вона на тебе дивиться?",shape=box,color=red];
		444 -> 455;
	454 [label="Вона каватиця, Летті, а не людина.",shape=box,color=red];
		454 -> 461;
	455 [label="Check boolean LettieCavia",color=orange];
		455 -> 462 [label=true,color=green];
		455 -> 464 [label=false,color=brown];
	461 [label="Check boolean LettieCavia",color=orange];
		461 -> 493 [label=true,color=green];
		461 -> 467 [label=false,color=brown];
	462 [label="Ніби вона думає, як МЕНЕ з’їсти
Як справжня людина
Як одна з тих кавій, про яких ти розповідаєш
Занадто свідомий і розумний погляд за цими очима",shape=box,color=blue];
		462 -> 506;
	464 [label="Як справжня людина
Ніби вона думає, як МЕНЕ з’їсти
Занадто свідомий і розумний погляд за цими очима
Чи в майбутньому є розумні тварини?",shape=box,color=blue];
		464 -> 561;
		464 -> 586;
	493 [label="Звідки стільки впевненості
Ти ж розповідаєш мені про кавій
Тих бідних тварин, яких той cabrón наділив розумом і покинув?!",shape=box,color=blue];
		493 -> 620;
	467 [label="Звідки стільки впевненості
Esa gata здається мені занадто розумною
Дивиться на мене поглядом, за яким криється людський розум
Чи є в майбутньому розумні тварини?",shape=box,color=blue];
		467 -> 561;
		467 -> 586;
	506 [label="Ті бідолашні тварини, яких той cabrón наділив розумом і покинув, пам’ятаєш?!
Звідки ти знаєш, що вона теж не така?!",shape=box,color=blue];
		506 -> 1007;
		506 -> 1030;
	561 [label="Є кавії, які були піддослідними тваринами. Їх відправили в Порожнечу і вони повернулися звідти розумними.",shape=box,color=red];
		561 -> 647;
	586 [label="Так, але… йой, це тебе розлютить, я вже можу вгадати.",shape=box,color=red];
		586 -> 665;
	620 [label="Звідки ти знаєш, що вона теж не така?!",shape=box,color=blue];
		620 -> 1007;
		620 -> 1030;
	1007 [label="Гм-м, вона ніколи нічого не промовляла.",shape=box,color=red];
		1007 -> 1033;
	1030 [label="Здається, я точно не знаю.",shape=box,color=red];
		1030 -> 1082;
	647 [label="ПІДДОСЛІДНІ ТВАРИНИ?!
Дозволь мені вгадати
Їх мучив Ентраті",shape=box,color=blue];
		647 -> 666;
	665 [label="¿Ay, sí? 
Тут замішаний Ентраті?",shape=box,color=blue];
		665 -> 669;
	1033 [label="І що?
Досить розумна, щоб клеїти дурненьку
Але вона шпигує за нами заради нього, я це знаю
Ми не повинні їй довіряти",shape=box,color=blue];
		1033 -> 1123;
		1033 -> 1183;
	1082 [label="Sí 
Вона може шпигувати
Працювати на Ентраті
Ми не повинні їй довіряти",shape=box,color=blue];
		1082 -> 1123;
		1082 -> 1183;
	666 [label="Ага.",shape=box,color=red];
		666 -> 907;
	669 [label="Ти вгадала.",shape=box,color=red];
		669 -> 824;
	1123 [label="Ентраті пішов, а вона залишилася. Я не думаю, що вона досі працює на нього.",shape=box,color=red];
		1123 -> 1202;
	1183 [label="Ти справді думаєш, що вона шпигує за нами для нього? Навіщо?",shape=box,color=red];
		1183 -> 1214;
	907 [label="Я ЗМУШУ того cabrón СТРАЖДАТИ ВІД БОЛЮ
Наступного разу, коли я побачу його, я буду мучити його так само як він мучив тих бідолашних angelitos
І йому це ЗОВСІМ не сподобається, я це ОБІЦЯЮ",shape=box,color=blue];
		907 -> 947;
	824 [label="Тоді маєш рацію
Це мене розлютить
Але все одно розкажи",shape=box,color=blue];
		824 -> 867;
	1202 [label="Ні, дивися 
Ось чому я вважаю, що вона шпигує
Він пішов і йому потрібен хтось, щоб наглядати за нами, ¿no? 
Не знаю чому, але мені це не подобається",shape=box,color=blue];
		1202 -> 1251;
		1202 -> 247;
	1214 [label="¡No sé! 
Не моя робота читати думки божевільний pendejo 
Можливо, він спостерігає за нами
Мені це не подобається",shape=box,color=blue];
		1214 -> 1251;
		1214 -> 247;
	947 [label="Update boolean LettieCavia",color=orange];
		947 -> 1001;
	867 [label="Він взяв цих піддослідних тварин і відправив їх у Порожнечу. Вони повернулися з розумом і свідомістю людей – але це їх мало не вбило. Їх називають кавіями.",shape=box,color=red];
		867 -> 839;
	1251 [label="У будь-якому разі, вона достатньо розумна, щоб зрозуміти, що «якщо торкнешся пацюків Летті, ти будеш спати надворі». Цього тобі буде достатньо?",shape=box,color=red];
		1251 -> 707;
	247 [label="Я її не вижену. Навіть якщо вона працює на Ентраті, це не її провина. Проста тваринка, віддана обожнюваному власнику. Хіба я можу проявити жорстокість до неї?",shape=box,color=red];
		247 -> 809;
	1001 [label="І звідки ти знаєш, що ця gata mutante не одна з цих кавій",shape=box,color=blue];
		1001 -> 1007;
		1001 -> 1030;
	839 [label="ПІДДОСЛІДНИХ ТВАРИН?!",shape=box,color=blue];
