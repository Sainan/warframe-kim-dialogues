digraph {
	graph [fontname="Roboto Condensed"];
	node [fontname="Roboto Condensed"];
	edge [fontname="Roboto Condensed"];

	"LettieRank4Convo6 begins." [color=orange];
		"LettieRank4Convo6 begins." -> j2642636294;
	j2642636294 [label="Esa gata, та химерна кішка-мутантка\nПостійно дивиться голодними очима на моїх panquecitos\nМені це не подобається",shape=box,color=blue];
		j2642636294 -> j380310815;
		j2642636294 -> j4174133468;
	j380310815 [label="Ти про Калимос? Я подбаю про те, щоб вона залишила твоїх пацюків у спокої.",shape=box,color=red];
		j380310815 -> j1980077455;
	j4174133468 [label="Калимос не скривдить твоїх пацюків.",shape=box,color=red];
		j4174133468 -> j608523335;
	j1980077455 [label="Ні \nЦе тваринка ентраті, а не твоя\nВона робить те, що він хоче\nВона дивиться на мене так само як і він",shape=box,color=blue];
		j1980077455 -> j1824495484;
	j608523335 [label="¿Sí? \nЗвідки тобі знати?\nЦе тваринка ентраті, а не твоя\nВона робить те, що він хоче\nВона дивиться на мене так само як і він",shape=box,color=blue];
		j608523335 -> j3646460562;
	j1824495484 [label="І як вона на тебе дивиться?",shape=box,color=red];
		j1824495484 -> j4254769564;
	j3646460562 [label="Вона каватиця, Летті, а не людина.",shape=box,color=red];
		j3646460562 -> j4287006142;
	j4254769564 [label="Check boolean LettieCavia",color=orange];
		j4254769564 -> j3642471677 [label=true,color=green];
		j4254769564 -> j1248169465 [label=false,color=brown];
	j4287006142 [label="Check boolean LettieCavia",color=orange];
		j4287006142 -> j2255536948 [label=true,color=green];
		j4287006142 -> j4230128248 [label=false,color=brown];
	j3642471677 [label="Ніби вона думає, як МЕНЕ з’їсти\nЯк справжня людина\nЯк одна з тих кавій, про яких ти розповідаєш\nЗанадто свідомий і розумний погляд за цими очима",shape=box,color=blue];
		j3642471677 -> j4222172855;
	j1248169465 [label="Як справжня людина\nНіби вона думає, як МЕНЕ з’їсти\nЗанадто свідомий і розумний погляд за цими очима\nЧи в майбутньому є розумні тварини?",shape=box,color=blue];
		j1248169465 -> j1201989802;
		j1248169465 -> j589592675;
	j2255536948 [label="Звідки стільки впевненості\nТи ж розповідаєш мені про кавій\nТих бідних тварин, яких той cabrón наділив розумом і покинув?!",shape=box,color=blue];
		j2255536948 -> j3597796026;
	j4230128248 [label="Звідки стільки впевненості\nEsa gata здається мені занадто розумною\nДивиться на мене поглядом, за яким криється людський розум\nЧи є в майбутньому розумні тварини?",shape=box,color=blue];
		j4230128248 -> j1201989802;
		j4230128248 -> j589592675;
	j4222172855 [label="Ті бідолашні тварини, яких той cabrón наділив розумом і покинув, пам’ятаєш?!\nЗвідки ти знаєш, що вона теж не така?!",shape=box,color=blue];
		j4222172855 -> j3048806462;
		j4222172855 -> j379379965;
	j1201989802 [label="Є кавії, які були піддослідними тваринами. Їх відправили в Порожнечу і вони повернулися звідти розумними.",shape=box,color=red];
		j1201989802 -> j2351479877;
	j589592675 [label="Так, але… йой, це тебе розлютить, я вже можу вгадати.",shape=box,color=red];
		j589592675 -> j1222350718;
	j3597796026 [label="Звідки ти знаєш, що вона теж не така?!",shape=box,color=blue];
		j3597796026 -> j3048806462;
		j3597796026 -> j379379965;
	j3048806462 [label="Гм-м, вона ніколи нічого не промовляла.",shape=box,color=red];
		j3048806462 -> j1554160430;
	j379379965 [label="Здається, я точно не знаю.",shape=box,color=red];
		j379379965 -> j1793078866;
	j2351479877 [label="ПІДДОСЛІДНІ ТВАРИНИ?!\nДозволь мені вгадати\nЇх мучив Ентраті",shape=box,color=blue];
		j2351479877 -> j594836891;
	j1222350718 [label="¿Ay, sí? \nТут замішаний Ентраті?",shape=box,color=blue];
		j1222350718 -> j3675534375;
	j1554160430 [label="І що?\nДосить розумна, щоб клеїти дурненьку\nАле вона шпигує за нами заради нього, я це знаю\nМи не повинні їй довіряти",shape=box,color=blue];
		j1554160430 -> j1527125142;
		j1554160430 -> j2746033023;
	j1793078866 [label="Sí \nВона може шпигувати\nПрацювати на Ентраті\nМи не повинні їй довіряти",shape=box,color=blue];
		j1793078866 -> j1527125142;
		j1793078866 -> j2746033023;
	j594836891 [label="Ага.",shape=box,color=red];
		j594836891 -> j1159325496;
	j3675534375 [label="Ти вгадала.",shape=box,color=red];
		j3675534375 -> j730417308;
	j1527125142 [label="Ентраті пішов, а вона залишилася. Я не думаю, що вона досі працює на нього.",shape=box,color=red];
		j1527125142 -> j1842825185;
	j2746033023 [label="Ти справді думаєш, що вона шпигує за нами для нього? Навіщо?",shape=box,color=red];
		j2746033023 -> j2069249602;
	j1159325496 [label="Я ЗМУШУ того cabrón СТРАЖДАТИ ВІД БОЛЮ\nНаступного разу, коли я побачу його, я буду мучити його так само як він мучив тих бідолашних angelitos\nІ йому це ЗОВСІМ не сподобається, я це ОБІЦЯЮ",shape=box,color=blue];
		j1159325496 -> j2827005111;
	j730417308 [label="Тоді маєш рацію\nЦе мене розлютить\nАле все одно розкажи",shape=box,color=blue];
		j730417308 -> j3218417973;
	j1842825185 [label="Ні, дивися \nОсь чому я вважаю, що вона шпигує\nВін пішов і йому потрібен хтось, щоб наглядати за нами, ¿no? \nНе знаю чому, але мені це не подобається",shape=box,color=blue];
		j1842825185 -> j3883585561;
		j1842825185 -> j1738319924;
	j2069249602 [label="¡No sé! \nНе моя робота читати думки божевільний pendejo \nМожливо, він спостерігає за нами\nМені це не подобається",shape=box,color=blue];
		j2069249602 -> j3883585561;
		j2069249602 -> j1738319924;
	j2827005111 [label="Boolean LettieCavia is now true.",color=orange];
		j2827005111 -> j3883239264;
	j3218417973 [label="Він взяв цих піддослідних тварин і відправив їх у Порожнечу. Вони повернулися з розумом і свідомістю людей – але це їх мало не вбило. Їх називають кавіями.",shape=box,color=red];
		j3218417973 -> j3799523429;
	j3883585561 [label="У будь-якому разі, вона достатньо розумна, щоб зрозуміти, що «якщо торкнешся пацюків Летті, ти будеш спати надворі». Цього тобі буде достатньо?",shape=box,color=red];
		j3883585561 -> j1878858766;
	j1738319924 [label="Я її не вижену. Навіть якщо вона працює на Ентраті, це не її провина. Проста тваринка, віддана обожнюваному власнику. Хіба я можу проявити жорстокість до неї?",shape=box,color=red];
		j1738319924 -> j2934832719;
	j3883239264 [label="І звідки ти знаєш, що ця gata mutante не одна з цих кавій",shape=box,color=blue];
		j3883239264 -> j3048806462;
		j3883239264 -> j379379965;
	j3799523429 [label="ПІДДОСЛІДНИХ ТВАРИН?!",shape=box,color=blue];
		j3799523429 -> j1159325496;
	j1878858766 [label="+15 Chemistry",color=orange];
		j1878858766 -> j4241416251;
	j2934832719 [label="+20 Chemistry",color=orange];
		j2934832719 -> j1376904465;
	j4241416251 [label="Добре, sí \nЦього буде достатньо \nАле якщо вона поранить одного з моїх bebecitos \nЦе означатиме війну",shape=box,color=blue];
		j4241416251 -> "Chat ends.";
	j1376904465 [label="А-А-А-А-А-А\nНавіщо тобі було так це описувати\nAaayyyyyyy babaaaas \nЦе не чесно!",shape=box,color=blue];
		j1376904465 -> j2373853271;
	"Chat ends." [color=orange];
	j2373853271 [label="No me gusta cuando te pasas de listo, babas \nДобре, ДОБРЕ\nАле якщо вона поранить одного з моїх bebecitos \nЦе означатиме війну",shape=box,color=blue];
		j2373853271 -> "Chat ends.";
}