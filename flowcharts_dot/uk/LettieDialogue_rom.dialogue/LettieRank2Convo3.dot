		j4012562515 -> j2559837836;
	j1552277560 [label="Мені от цікаво, чому з’явився той Ентраті\nНавіщо йти сюди та руйнувати нам життя\nЗа кого це pinche güey себе має?!",shape=box,color=blue];
		j1552277560 -> j2313311841;
		j1552277560 -> j4055695072;
		j1552277560 -> j2559837836;
	j3623714549 [label="У певному сенсі. Щось посередині. Вони обожнювали Альбрехт… особлива після його експериментів з Порожнечею. Але Ентраті не забув, як був зневаженим до цього, тому… важко пояснити.",shape=box,color=red];
