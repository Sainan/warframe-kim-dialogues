		j942738461 -> j3868214656;
		j942738461 -> j1027386822;
	j3329705949 [label="Шіпе-Тотек, «той, з обдертою шкірою», носив шкіру своїх ворогів\nЯк і твоя Людина в стіні",shape=box,color=blue];
		j3329705949 -> j831166855;
	j75814111 [label="Тому я тримаю домашніх тварин \nМої пацюки складають мені компанію, коли я самотня \nВони поруч, коли я не можу бачити людей\nНевинні маленькі душі, яка просто хочуть любові",shape=box,color=blue];
