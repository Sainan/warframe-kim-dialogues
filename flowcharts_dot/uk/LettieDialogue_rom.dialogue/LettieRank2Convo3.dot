	j3945218245 [label="Купка мудаків, які вважали себе вищими за всіх інших. Слова зайві.",shape=box,color=red];
		j3945218245 -> j808950296;
	j3328362420 [label="Вони мої друзі. Тварини, яких Ентраті послав у Порожнечу, щоби провести над ними досліди.",shape=box,color=red];
		j3328362420 -> j2783872369;
	j3000006113 [label="+5 Chemistry",color=orange];
		j3000006113 -> j272528181;
	j3543631739 [label="Це зовсім не означає, що він чинить правильно\nPendejos як він, вони усі однакові\nСліпо розв’язують свої проблеми\nУсі інші для них це супутні втрати",shape=box,color=blue];
		j3543631739 -> j1118768010;
	j808950296 [label="Це не вперше люди наряджаються як королі \nІ вважають себе божествами",shape=box,color=blue];
		j808950296 -> j3746222600;
	j2783872369 [label="Ніби мені потрібна була причина НЕНАВИДИТИ його ще більше…\nПІДДОСЛІДНІ ТВАРИНИ?!",shape=box,color=blue];
		j2783872369 -> j437066532;
	j272528181 [label="JAJA \nУсе ти знаєш",shape=box,color=blue];
		j272528181 -> j389403059;
	j1118768010 [label="Йому байдуже, кому та як сильно він завдасть цим шкоди\nУсі для нього лише супутні втрати в ім’я його цілі",shape=box,color=blue];
		j1118768010 -> j3869694459;
	j3746222600 [label="Це пояснює Ентраті\nВін вважає себе богом і поводиться як бог\nPendejos як він, вони усі однакові\nСліпо розв’язують свої проблеми\nУсі інші для них це супутні втрати",shape=box,color=blue];
		j3746222600 -> j1118768010;
	j437066532 [label="Їх відправили в Порожнечу і вони повернулися звідти зі свідомістю.",shape=box,color=red];
		j437066532 -> j1850012965;
	j389403059 [label="Pendejos як він, вони усі однакові\nСліпо розв’язують свої проблеми та всі інші для них це супутні втрати\nЇм байдуже, кому та як сильно вони завдадуть цим шкоди\nВін спалив би цілий всесвіт, щоб домігся свого",shape=box,color=blue];
		j389403059 -> j3869694459;
	j3869694459 [label="Такі, як він, вбивають таких, як ми",shape=box,color=blue];
		j3869694459 -> j1700243245;
	j1850012965 [label="Порожнеча може робити… такі дива.",shape=box,color=red];
		j1850012965 -> j4241279623;
	j1700243245 [label="Ти ніколи не побачиш, як ВІН помирає за свою справу\nВін ніколи не пожертвує СВОЇМ життям\nЩо стосується решти? Нехай гинуть",shape=box,color=blue];
		j1700243245 -> j1725025609;
	j4241279623 [label="Дай вгадаю, а потім він просто покинув їх \nПобачив, що накоїв і зник, тому що вони йому більше не потрібні",shape=box,color=blue];
		j4241279623 -> j854406683;
		j4241279623 -> j2994418709;
	j1725025609 [label="Привід замислитися, хто в підсумку монстр",shape=box,color=blue];
