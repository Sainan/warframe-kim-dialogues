		j1725025609 -> j3439852810;
	j854406683 [label="Так, ти вгадала. Тепер вони… зграя травмованих тварин із людським інтелектом.",shape=box,color=red];
		j854406683 -> j2704689275;
	j2994418709 [label="Він намагається зупинити Людину в стіні. Це важливо.",shape=box,color=red];
		j2994418709 -> j2548819367;
	j834902966 [label="Я розумію, чому він зробив би все, щоб зупинити Людину в стіні.",shape=box,color=red];
		j834902966 -> j2926961198;
	j3439852810 [label="Він нам потрібен щоб зупинити Людину в стіні. Але це не означає, що я йому довіряю. Або що він мені подобається.",shape=box,color=red];
		j3439852810 -> j4084423302;
	j2704689275 [label="Oh, pobres ángeles inocentes \nМаєш рацію, я їх полюблю…\nМи не заслуговуємо на тварин\nЇхня любов до нас чиста і просить лише любові у відповідь",shape=box,color=blue];
		j2704689275 -> j836756315;
		j2704689275 -> j2836571972;
	j2548819367 [label="Я не кажу, що це не важливо\nАле такі pendejos як він, завжди роблять найгірші речі в ім’я вищого блага\nЇм байдуже, хто та як сильно постраждає в процесі, поки вони досягають своїх цілей",shape=box,color=blue];
		j2548819367 -> j3869694459;
	j2926961198 [label="Навіть не прикидайся, що розумієш богів\nВони вище за нас, і нерозумно думати інакше",shape=box,color=blue];
		j2926961198 -> j3201214572;
	j4084423302 [label="+10 Chemistry",color=orange];
		j4084423302 -> j3471887127;
	j836756315 [label="Я всіма силами допомагаю кавіям. Відверто, вони мені подобаються ліпше, ніж більшість людей. ха-ха",shape=box,color=red];
		j836756315 -> j3195375301;
