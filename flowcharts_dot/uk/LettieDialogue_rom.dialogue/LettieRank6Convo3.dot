	j33591065 [label="То для Елеонори",shape=box,color=blue];
		j33591065 -> j1581482482;
		j33591065 -> j3070600337;
		j33591065 -> j3617487630;
	j2650428968 [label="Aaay, не доводь мене до сліз\nЦе дуже мило, що ти думаєш про моїх panquecitos\nGracias\nЯ також думала про дещо інше\nАле… тільки не смійся",shape=box,color=blue];
		j2650428968 -> j33591065;
	j1581482482 [label="Я пам'ятаю, що вона любить рослини. Думаю, їй би це сподобалося.",shape=box,color=red];
		j1581482482 -> j267195496;
	j3070600337 [label="Я тішуся, що ви порозумілися. ",shape=box,color=red];
		j3070600337 -> j2042884735;
	j3617487630 [label="Чому я маю сміятися?",shape=box,color=red];
		j3617487630 -> j3311946495;
	j267195496 [label="Тут так похмуро\nNo necesitamos mantenerlo lúgubre y sucio\nХай краще вона розмовляє з рослинами, ніж…\nЗі… зброєю…",shape=box,color=blue];
		j267195496 -> j666644568;
	j2042884735 [label="Sí\nІноді важко все відпустити\nВизнати, що все може бути інакше\nХай краще вона розмовляє з рослинами, ніж…\nЗі… зброєю…",shape=box,color=blue];
		j2042884735 -> j666644568;
	j3311946495 [label="Ми з нею не завжди були «найкращими подружками»\nІноді важко все відпустити\nВизнати, що все може бути інакше\nХай краще вона розмовляє з рослинами, ніж…\nЗі… зброєю…",shape=box,color=blue];
		j3311946495 -> j666644568;
	j666644568 [label="Але я зрозуміла, що коли вона посміхається\nТо я посміхаюся теж\nМожливо, більше через su onda de bruja jajaja",shape=box,color=blue];
		j666644568 -> j2480135188;
	j2480135188 [label="У будь-якому разі\nБуло б непогано\n«Мертвий торговельний центр» не має бути настільки буквальним",shape=box,color=blue];
