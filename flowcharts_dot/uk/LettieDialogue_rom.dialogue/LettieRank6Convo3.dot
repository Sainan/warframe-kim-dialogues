	j598224062 [label="+5 Chemistry",color=orange];
		j598224062 -> j2650428968;
	j3525309332 [label="Кілька причин\nСвіжа їжа (Si como más pizza voy a gritar)\nЯ можу вирощувати квіти cempasúchil\nАле… тільки не смійся",shape=box,color=blue];
		j3525309332 -> j33591065;
	j973344876 [label="Менше з тим\nNo me distraigas",shape=box,color=blue];
