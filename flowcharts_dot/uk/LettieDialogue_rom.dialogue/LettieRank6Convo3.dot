		j3866738322 -> j1293776243;
	j15870405 [label="Чудово підійде для твоїх panquecitos. :) Трохи часу на сонці, не турбуючись про них.",shape=box,color=red];
		j15870405 -> j598224062;
	j1006289660 [label="Мені подобається ідея! Але чому теплицю?",shape=box,color=red];
		j1006289660 -> j3525309332;
	j685989644 [label="Te perdono\nЯ пробачаю тобі\nАле не змушуй жалкувати про це, eh babas?",shape=box,color=blue];
		j685989644 -> j973344876;
	j1293776243 [label="Sí, sí\nСвіжа їжа (Si como más pizza voy a gritar)\nЯ можу вирощувати квіти cempasúchil\nАле… тільки не смійся",shape=box,color=blue];
