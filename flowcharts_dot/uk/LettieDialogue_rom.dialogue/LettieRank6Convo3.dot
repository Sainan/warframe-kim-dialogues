		j291076402 -> j803764473;
	j257019397 [label="Sí, Sí\nМала б знати\nNo me distraigas",shape=box,color=blue];
		j257019397 -> j803764473;
	j2643751789 [label="…..\nAaaahhhhhgggh mierda\nSíííííí… добре\nЯ не можу продовжувати читати Артуру лекції про те, що треба відпускати\nЯкщо не зроблю те саме",shape=box,color=blue];
		j2643751789 -> j2666715961;
	j1680356495 [label="Так це станеться не сьогодні й не завтра\nМожливо навіть і не скоро\nАле ж думати про це приємно\nqué te parece?",shape=box,color=blue];
