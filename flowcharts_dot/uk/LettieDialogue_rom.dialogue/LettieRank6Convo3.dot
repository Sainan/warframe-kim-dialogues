	j1757195343 [label="Ха, я просто жартую. Не покладай надій.",shape=box,color=red];
		j1757195343 -> j257019397;
	j2151086107 [label="Можна вибачитися? За мої слова, що тебе засмутили. Гадаю, мої слова ненавмисно зіпсували все.",shape=box,color=red];
		j2151086107 -> j2643751789;
	j4254991925 [label="Jajaja ні, хоча можливо\nДуже заманливо\nАле я думала про теплицю",shape=box,color=blue];
