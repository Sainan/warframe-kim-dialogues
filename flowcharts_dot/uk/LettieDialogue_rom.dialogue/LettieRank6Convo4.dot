digraph {
	2632 [label="LettieRank6Convo4 begins.",color=orange];
		2632 -> 2633;
		2632 -> 2634;
	2633 [label="[Завершити розмову]",shape=box,color=red];
		2633 -> 2635;
	2634 [label="Ти тримаєшся?",shape=box,color=red];
		2634 -> 2636;
	2635 [label="Chat ends.",color=orange];
	2636 [label="Eh, así así
Один із тих днів
Це мине, вони завжди минають",shape=box,color=blue];
		2636 -> 2637;
		2636 -> 2638;
	2637 [label=":( Мені шкода.",shape=box,color=red];
		2637 -> 2639;
	2638 [label="Щось сталося?",shape=box,color=red];
		2638 -> 2640;
	2639 [label="Sólo las arañas
Знову почуваюся як вдома
Вони скоро підуть",shape=box,color=blue];
		2639 -> 2641;
	2640 [label="Та ні, нічого нового
Sólo las arañas
Знову почуваюся як вдома
Вони скоро підуть",shape=box,color=blue];
		2640 -> 2641;
	2641 [label="Іноді мені хочеться
Щоб це було так просто, як проблема
Тоді я змогла б це виправити, ¿sí?
Обговорити, луснути кілька разів jajaja",shape=box,color=blue];
		2641 -> 2642;
	2642 [label="Проблеми можна вирішити
Проблеми мають відповіді
Los sentimientos no se arreglan
Повір мені, я намагалася",shape=box,color=blue];
		2642 -> 2643;
		2642 -> 2644;
	2643 [label="Але у тебе є купа причин для радості.",shape=box,color=red];
		2643 -> 2645;
	2644 [label="Я на власному гіркому досвіді з Дувірі знаю, що «поратися з почуттями» іноді є найгіршим вибором.",shape=box,color=red];
		2644 -> 2646;
	2645 [label="Ay, sí, це правда
І я знаю, що так і є
І я іноді бажаю
Щоб люди зрозуміли, що це частина мене
Яку нелегко засвоїти",shape=box,color=blue];
		2645 -> 2647;
	2646 [label="Síí…
Хоча іноді це заманливо jajaja
Просто побажати, щоб усе це закінчилося
Але я пам'ятаю твої слова про те, що станеться
Коли все заціпеніє",shape=box,color=blue];
		2646 -> 2648;
	2647 [label="Мені хотілося б бути іншою
Але я така, яка я є
І я перестала вибачатися за це
Давно",shape=box,color=blue];
		2647 -> 2649;
	2648 [label="Нікому б такого не побажала
Гаразд, можливо, Альбрехту
Pinche güey
Хоча його серце й так крижане",shape=box,color=blue];
		2648 -> 2650;
		2648 -> 2651;
	2649 [label="Chat ends.",color=orange];
	2650 [label="Що ми можемо зробити, щоб відволікти тебе? Чи тебе краще поки залишити тут?",shape=box,color=red];
		2650 -> 2652;
	2651 [label="Залишається лише сподіватися, що це лише початок його гри.",shape=box,color=red];
		2651 -> 2653;
	2652 [label="Е-е-ем хороше питання
Якщо чесно не знаю
Лишитися було б добре
Або можемо піти й когось убити
¿Te quedas?, ¿o vamos a matar cosas? 
Ох же цей вибір…",shape=box,color=blue];
		2652 -> 2654;
		2652 -> 2655;
	2653 [label="Єдине, на що я сподіваюся для цього cabrón
Це на довгу поїздку в ліфті
Зі мною
І бейсбольною битою",shape=box,color=blue];
		2653 -> 2656;
	2654 [label="Я за те, щоб залишитися.",shape=box,color=red];
		2654 -> 2657;
	2655 [label="Я за те, щоб піти когось убити.",shape=box,color=red];
		2655 -> 2658;
	2656 [label="Це образ, який мене підбадьорює
Jajaja",shape=box,color=blue];
		2656 -> 2659;
	2657 [label="Гарний вибір
Посидіти за барною стійкою з М і В
Можливо, зіграти партію в карти
Це може допомогти відволіктися",shape=box,color=blue];
		2657 -> 2659;
	2658 [label="Jajaja гарний вибір
Витягти біль з моїх думок
І перенести його у чужі",shape=box,color=blue];
		2658 -> 2659;
	2659 [label="Check boolean LettieDating",color=orange];
		2659 -> 2661 [label=true,color=green];
		2659 -> 2660 [label=false,color=brown];
	2661 [label="Check boolean LettieReal",color=orange];
		2661 -> 2664 [label=true,color=green];
		2661 -> 2663 [label=false,color=brown];
	2660 [label="Gracias, дружаньо",shape=box,color=blue];
		2660 -> 2662;
	2664 [label="Gracias, corazón",shape=box,color=blue];
		2664 -> 2666;
	2663 [label="Gracias, solecito",shape=box,color=blue];
		2663 -> 2665;
	2662 [label="Chat ends.",color=orange];
	2666 [label="Chat ends.",color=orange];
	2665 [label="Chat ends.",color=orange];
}