	j1294950125 [label="Ти тримаєшся?",shape=box,color=red];
		j1294950125 -> j2968702214;
	"Chat ends." [color=orange];
	j2968702214 [label="Eh, así así
Один із тих днів
Це мине, вони завжди минають",shape=box,color=blue];
		j2968702214 -> j3312798206;
		j2968702214 -> j2832753282;
	j3312798206 [label=":( Мені шкода.",shape=box,color=red];
		j3312798206 -> j4113943823;
	j2832753282 [label="Щось сталося?",shape=box,color=red];
		j2832753282 -> j1528400877;
	j4113943823 [label="Sólo las arañas
Знову почуваюся як вдома
Вони скоро підуть",shape=box,color=blue];
		j4113943823 -> j1091346641;
	j1528400877 [label="Та ні, нічого нового
Sólo las arañas
Знову почуваюся як вдома
Вони скоро підуть",shape=box,color=blue];
		j1528400877 -> j1091346641;
	j1091346641 [label="Іноді мені хочеться
Щоб це було так просто, як проблема
Тоді я змогла б це виправити, ¿sí?
Обговорити, луснути кілька разів jajaja",shape=box,color=blue];
		j1091346641 -> j2466876139;
	j2466876139 [label="Проблеми можна вирішити
Проблеми мають відповіді
Los sentimientos no se arreglan
Повір мені, я намагалася",shape=box,color=blue];
		j2466876139 -> j3221565827;
		j2466876139 -> j4136324387;
	j3221565827 [label="Але у тебе є купа причин для радості.",shape=box,color=red];
		j3221565827 -> j2496528161;
	j4136324387 [label="Я на власному гіркому досвіді з Дувірі знаю, що «поратися з почуттями» іноді є найгіршим вибором.",shape=box,color=red];
		j4136324387 -> j2466635880;
	j2496528161 [label="Ay, sí, це правда
І я знаю, що так і є
І я іноді бажаю
Щоб люди зрозуміли, що це частина мене
Яку нелегко засвоїти",shape=box,color=blue];
		j2496528161 -> j3380543944;
	j2466635880 [label="Síí…
Хоча іноді це заманливо jajaja
Просто побажати, щоб усе це закінчилося
Але я пам'ятаю твої слова про те, що станеться
Коли все заціпеніє",shape=box,color=blue];
		j2466635880 -> j2660361534;
	j3380543944 [label="Мені хотілося б бути іншою
Але я така, яка я є
І я перестала вибачатися за це
Давно",shape=box,color=blue];
		j3380543944 -> "Chat ends.";
	j2660361534 [label="Нікому б такого не побажала
Гаразд, можливо, Альбрехту
Pinche güey
Хоча його серце й так крижане",shape=box,color=blue];
		j2660361534 -> j3520005505;
		j2660361534 -> j1489771573;
	j3520005505 [label="Що ми можемо зробити, щоб відволікти тебе? Чи тебе краще поки залишити тут?",shape=box,color=red];
		j3520005505 -> j3920812622;
	j1489771573 [label="Залишається лише сподіватися, що це лише початок його гри.",shape=box,color=red];
		j1489771573 -> j2469254272;
	j3920812622 [label="Е-е-ем хороше питання
Якщо чесно не знаю
Лишитися було б добре
Або можемо піти й когось убити
¿Te quedas?, ¿o vamos a matar cosas? 
Ох же цей вибір…",shape=box,color=blue];
		j3920812622 -> j354485484;
		j3920812622 -> j2797337629;
	j2469254272 [label="Єдине, на що я сподіваюся для цього cabrón
Це на довгу поїздку в ліфті
Зі мною
І бейсбольною битою",shape=box,color=blue];
		j2469254272 -> j1881271725;
	j354485484 [label="Я за те, щоб залишитися.",shape=box,color=red];
		j354485484 -> j2290717894;
	j2797337629 [label="Я за те, щоб піти когось убити.",shape=box,color=red];
		j2797337629 -> j3604333954;
	j1881271725 [label="Це образ, який мене підбадьорює
Jajaja",shape=box,color=blue];
		j1881271725 -> j3819368348;
	j2290717894 [label="Гарний вибір
Посидіти за барною стійкою з М і В
Можливо, зіграти партію в карти
Це може допомогти відволіктися",shape=box,color=blue];
		j2290717894 -> j3819368348;
	j3604333954 [label="Jajaja гарний вибір
Витягти біль з моїх думок
І перенести його у чужі",shape=box,color=blue];
		j3604333954 -> j3819368348;
