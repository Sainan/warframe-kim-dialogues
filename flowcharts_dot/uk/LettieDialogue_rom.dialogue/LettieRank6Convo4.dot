	j1294950125 [label="Ти тримаєшся?",shape=box,color=red];
		j1294950125 -> j2968702214;
	"Chat ends." [color=orange];
	j2968702214 [label="Eh, así así\nОдин із тих днів\nЦе мине, вони завжди минають",shape=box,color=blue];
		j2968702214 -> j3312798206;
		j2968702214 -> j2832753282;
	j3312798206 [label=":( Мені шкода.",shape=box,color=red];
		j3312798206 -> j4113943823;
	j2832753282 [label="Щось сталося?",shape=box,color=red];
		j2832753282 -> j1528400877;
	j4113943823 [label="Sólo las arañas\nЗнову почуваюся як вдома\nВони скоро підуть",shape=box,color=blue];
		j4113943823 -> j1091346641;
	j1528400877 [label="Та ні, нічого нового\nSólo las arañas\nЗнову почуваюся як вдома\nВони скоро підуть",shape=box,color=blue];
		j1528400877 -> j1091346641;
	j1091346641 [label="Іноді мені хочеться\nЩоб це було так просто, як проблема\nТоді я змогла б це виправити, ¿sí?\nОбговорити, луснути кілька разів jajaja",shape=box,color=blue];
		j1091346641 -> j2466876139;
	j2466876139 [label="Проблеми можна вирішити\nПроблеми мають відповіді\nLos sentimientos no se arreglan\nПовір мені, я намагалася",shape=box,color=blue];
		j2466876139 -> j3221565827;
		j2466876139 -> j4136324387;
	j3221565827 [label="Але у тебе є купа причин для радості.",shape=box,color=red];
		j3221565827 -> j2496528161;
	j4136324387 [label="Я на власному гіркому досвіді з Дувірі знаю, що «поратися з почуттями» іноді є найгіршим вибором.",shape=box,color=red];
		j4136324387 -> j2466635880;
	j2496528161 [label="Ay, sí, це правда\nІ я знаю, що так і є\nІ я іноді бажаю\nЩоб люди зрозуміли, що це частина мене\nЯку нелегко засвоїти",shape=box,color=blue];
		j2496528161 -> j3380543944;
	j2466635880 [label="Síí…\nХоча іноді це заманливо jajaja\nПросто побажати, щоб усе це закінчилося\nАле я пам'ятаю твої слова про те, що станеться\nКоли все заціпеніє",shape=box,color=blue];
		j2466635880 -> j2660361534;
	j3380543944 [label="Мені хотілося б бути іншою\nАле я така, яка я є\nІ я перестала вибачатися за це\nДавно",shape=box,color=blue];
		j3380543944 -> "Chat ends.";
	j2660361534 [label="Нікому б такого не побажала\nГаразд, можливо, Альбрехту\nPinche güey\nХоча його серце й так крижане",shape=box,color=blue];
		j2660361534 -> j3520005505;
		j2660361534 -> j1489771573;
	j3520005505 [label="Що ми можемо зробити, щоб відволікти тебе? Чи тебе краще поки залишити тут?",shape=box,color=red];
		j3520005505 -> j3920812622;
	j1489771573 [label="Залишається лише сподіватися, що це лише початок його гри.",shape=box,color=red];
		j1489771573 -> j2469254272;
	j3920812622 [label="Е-е-ем хороше питання\nЯкщо чесно не знаю\nЛишитися було б добре\nАбо можемо піти й когось убити\n¿Te quedas?, ¿o vamos a matar cosas? \nОх же цей вибір…",shape=box,color=blue];
		j3920812622 -> j354485484;
		j3920812622 -> j2797337629;
	j2469254272 [label="Єдине, на що я сподіваюся для цього cabrón\nЦе на довгу поїздку в ліфті\nЗі мною\nІ бейсбольною битою",shape=box,color=blue];
		j2469254272 -> j1881271725;
	j354485484 [label="Я за те, щоб залишитися.",shape=box,color=red];
		j354485484 -> j2290717894;
	j2797337629 [label="Я за те, щоб піти когось убити.",shape=box,color=red];
		j2797337629 -> j3604333954;
	j1881271725 [label="Це образ, який мене підбадьорює\nJajaja",shape=box,color=blue];
		j1881271725 -> j3819368348;
	j2290717894 [label="Гарний вибір\nПосидіти за барною стійкою з М і В\nМожливо, зіграти партію в карти\nЦе може допомогти відволіктися",shape=box,color=blue];
		j2290717894 -> j3819368348;
	j3604333954 [label="Jajaja гарний вибір\nВитягти біль з моїх думок\nІ перенести його у чужі",shape=box,color=blue];
		j3604333954 -> j3819368348;
	j3819368348 [label="Check boolean LettieDating",color=orange];
		j3819368348 -> j1587771096 [label=true,color=green];
		j3819368348 -> j4206923364 [label=false,color=brown];
	j1587771096 [label="Check boolean LettieReal",color=orange];
		j1587771096 -> j1355625237 [label=true,color=green];
		j1587771096 -> j4256533151 [label=false,color=brown];
	j4206923364 [label="Gracias, дружаньо",shape=box,color=blue];
		j4206923364 -> "Chat ends.";
	j1355625237 [label="Gracias, corazón",shape=box,color=blue];
		j1355625237 -> "Chat ends.";
