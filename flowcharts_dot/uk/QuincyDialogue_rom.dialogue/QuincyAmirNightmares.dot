		1920 -> 1921;
	1921 [label="він мене обійняв. трясця — обійняв. і сказав «а ще ти також мій старший братик»",shape=box,color=blue];
		1921 -> 1923;
	1923 [label="шзнх",shape=box,color=blue];
		1923 -> 1924;
