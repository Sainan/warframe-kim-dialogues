		1904 -> 1903;
	1900 [label="спершу він подумав, шо я дам йому в пику. але я забрав його на дах, ми сиділи й говорили",shape=box,color=blue];
		1900 -> 1905;
	1902 [label="трясця, стулися, й дай дописати, добре?",shape=box,color=blue];
		1902 -> 1900;
	1903 [label="Chat ends.",color=orange];
	1905 [label="розповів йому, шо знаю про його нічні жахіття. шо я знаю, шо з ним не все гаразд",shape=box,color=blue];
		1905 -> 1907;
		1905 -> 1906;
	1907 [label="І?",shape=box,color=red];
		1907 -> 1908;
	1906 [label="І що він відповів?",shape=box,color=red];
		1906 -> 1908;
	1908 [label="спершу нічого",shape=box,color=blue];
		1908 -> 1909;
	1909 [label="сидів такий, засоромлений від себе самого",shape=box,color=blue];
		1909 -> 1910;
	1910 [label="певно думав, шо я з нього сміятимуся",shape=box,color=blue];
		1910 -> 1911;
	1911 [label="між іншим, це було дуже спокуслива думка, бо його вигляд аж просив",shape=box,color=blue];
		1911 -> 1912;
	1912 [label="тож… я розповів про перший раз… як довелося вбити. перший раз, як дивився в приціл і забрав життя",shape=box,color=blue];
		1912 -> 1893;
	1893 [label="коли у пеклі бою… на тебе мчить якийсь посіпака з ножем, чи гвинтівкою, чи байдуже з чим… це одне",shape=box,color=blue];
		1893 -> 1913;
	1913 [label="а геть інше абсолютно, коли ти на даху за 300 метрів від цілі й вони навіть не знають про тебе…",shape=box,color=blue];
		1913 -> 1914;
	1914 [label="у тебе є час *подумати* про них. хто вони. звідки. чи є в них сім’я. діти",shape=box,color=blue];
		1914 -> 1931;
	1931 [label="і… ти тиснеш на гачок. БУМ",shape=box,color=blue];
		1931 -> 1928;
	1928 [label="і вже нічого не має значення",shape=box,color=blue];
		1928 -> 1889;
	1889 [label="вони мертві. ти забрав їхнє життя",shape=box,color=blue];
		1889 -> 1892;
	1892 [label="те обличчя живе в моїй голові",shape=box,color=blue];
		1892 -> 1915;
	1915 [label="як і кожне наступне відтоді",shape=box,color=blue];
		1915 -> 1896;
		1915 -> 1930;
	1896 [label="І як він зреагував?..",shape=box,color=red];
		1896 -> 1916;
	1930 [label="Дуже… підбадьорливо.",shape=box,color=red];
		1930 -> 1916;
	1916 [label="тривалий час сиділи й мовчали. просто сиділи в тиші",shape=box,color=blue];
		1916 -> 1927;
	1927 [label="а потім він… розповів про свої нічні жахіття",shape=box,color=blue];
		1927 -> 1894;
	1894 [label="і про свої почуття, шо він не належить до групи, не частина її, бо не солдат",shape=box,color=blue];
		1894 -> 1890;
	1890 [label="тож я розповів йому про жахіття, які прийшли згодом. такі, як були в дитинстві",shape=box,color=blue];
		1890 -> 1891;
	1891 [label="але я перепросив за те, шо весь час поводився як мудак",shape=box,color=blue];
		1891 -> 1895;
	1895 [label="і шо він один із нас як і всі інші. і те шо я такий як я є, і він такий як він є. просто ми такі як ми є, розумієш?",shape=box,color=blue];
		1895 -> 1929;
