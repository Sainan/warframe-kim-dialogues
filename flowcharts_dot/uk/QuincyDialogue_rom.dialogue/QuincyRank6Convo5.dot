		j3813019061 -> j2364456702;
	j2364456702 [label="ну типу я шарю шо тобі вдалося залагодити ту срань і ми постійно не дохнемо в кожній повторній петлі але",shape=box,color=blue];
		j2364456702 -> j4075579736;
	j4075579736 [label="дружаньо, ми з артуром ніколи не були дружанями",shape=box,color=blue];
		j4075579736 -> j3781727533;
		j4075579736 -> j2632557776;
	j3781727533 [label="Мені… шкода?",shape=box,color=red];
		j3781727533 -> j1814438829;
	j2632557776 [label="До чого ти ведеш?",shape=box,color=red];
		j2632557776 -> j1153893502;
	j1814438829 [label="ну, у цьому ж і суть. я відчуваю, шо це «твоя провина». але я просто НЕДОГАНЯЮ",shape=box,color=blue];
		j1814438829 -> j1153893502;
	j1153893502 [label="скільки петель повторилося? ну, типу, ти хоч знаєш?",shape=box,color=blue];
		j1153893502 -> j942801188;
		j1153893502 -> j3430819217;
	j942801188 [label="Знаю. Чимало. А що?",shape=box,color=red];
		j942801188 -> j213592024;
	j3430819217 [label="Та я вже і не рахую далі.",shape=box,color=red];
		j3430819217 -> j213592024;
	j213592024 [label="я ж не пам’ятаю їх усі, так? забий, не відповідай",shape=box,color=blue];
		j213592024 -> j672213819;
	j672213819 [label="але якшо я навіть і не пам’ятаю, але шось усередині має ВІДЧУВАТИ, так?",shape=box,color=blue];
		j672213819 -> j2782395314;
	j2782395314 [label="бо я ЗНАЮ як я маю почуватися, але НАСПРАВДІ геть інші відчуття",shape=box,color=blue];
		j2782395314 -> j566379113;
	j566379113 [label="і одне шо я можу придумать шо якимось чином… якась наша частинка… ну я гребу… існує поза петлею повторів?",shape=box,color=blue];
		j566379113 -> j1543537042;
	j1543537042 [label="я це пишу й самому гидко, бо ця вся маячня про ароматрави, кришталеві кулі, дим — то все елеонорина парафія",shape=box,color=blue];
		j1543537042 -> j1201787817;
