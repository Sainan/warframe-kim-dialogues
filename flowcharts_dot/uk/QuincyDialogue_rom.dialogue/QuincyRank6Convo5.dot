	j1223960879 [label="у мене є теорія",shape=box,color=blue];
		j1223960879 -> j487604448;
	j487604448 [label="і ти маєш підтвердити або спростувати. мені цікаво",shape=box,color=blue];
		j487604448 -> j4200388702;
	j4200388702 [label="тож я тут «порозмірковую вголос» чи якось так",shape=box,color=blue];
		j4200388702 -> j1952071214;
		j4200388702 -> j3848913937;
	j1952071214 [label="Хто, на мою думку, на кого запав?",shape=box,color=red];
		j1952071214 -> j1708681198;
	j3848913937 [label="Он як? Я в повній бойовій уважності.",shape=box,color=red];
		j3848913937 -> j3055613686;
	j1708681198 [label="пхавахва нє. трясця, та половині команди тра просто вийти за рамки їхніх переконань… якби мене хтось питав",shape=box,color=blue];
		j1708681198 -> j1060922119;
	j3055613686 [label="тож лежу я на даху, фігачу техногниль з нашим босом на пару",shape=box,color=blue];
		j3055613686 -> j720437022;
		j3055613686 -> j1317005483;
		j3055613686 -> j689353529;
		j3055613686 -> j3934198395;
	j1060922119 [label="менше з тим, я тут не для пліток, хоча з них завше монжа добряче пореготати хах",shape=box,color=blue];
		j1060922119 -> j3055613686;
	j720437022 [label="Це… схоже на жорстоке поводження з тваринами…",shape=box,color=red];
		j720437022 -> j1174939594;
	j1317005483 [label="Схоже, я здогадуюся.",shape=box,color=red];
		j1317005483 -> j4237667373;
	j689353529 [label="Босом?",shape=box,color=red];
		j689353529 -> j848783849;
	j3934198395 [label="Фігачу?",shape=box,color=red];
		j3934198395 -> j1327324455;
	j1174939594 [label="умвахахаха",shape=box,color=blue];
		j1174939594 -> j2150365679;
	j4237667373 [label="а ти швидко вчишся хаха",shape=box,color=blue];
		j4237667373 -> j3530478779;
	j848783849 [label="та артур жеж",shape=box,color=blue];
		j848783849 -> j3530478779;
	j1327324455 [label="хаха вбиваю, у цьому випадку — розстрілюю",shape=box,color=blue];
		j1327324455 -> j3530478779;
	j2150365679 [label="тобто, лежу я на даху, розстрілюю техногниль з артуром на пару, ну ти даєш",shape=box,color=blue];
		j2150365679 -> j3530478779;
	j3530478779 [label="ага у нього туго з прицілом, тож я нагорі й ми займаємося зачисткою якихось сраних приблуд",shape=box,color=blue];
		j3530478779 -> j4220248586;
	j4220248586 [label="я йому підказую хто де, прикриваю. ясно? і тут такий хоба",shape=box,color=blue];
		j4220248586 -> j3683326610;
	j3683326610 [label="стопе",shape=box,color=blue];
		j3683326610 -> j4137404188;
