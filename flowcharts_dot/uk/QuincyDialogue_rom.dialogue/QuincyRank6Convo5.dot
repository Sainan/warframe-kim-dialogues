		j1201787817 -> j3656558926;
	j1643134138 [label="Абсолютно ні, вибач.",shape=box,color=red];
		j1643134138 -> j1212670826;
	j2501545467 [label="Я не розумію, як таке може бути можливим. Може… зараження — частина вас? Або Порожнеча… щось утнула?",shape=box,color=red];
