		2985 -> 2995;
	2988 [label="Але тоді я згадую всіх дітлахів, що не змогли зробити цього. Вони лишили їх у клітках на хтозна-який час. Вони дивилися, як ті розривають себе на шматки наче дикі божевільні тварини. Не знаю, що гірше.",shape=box,color=red];
