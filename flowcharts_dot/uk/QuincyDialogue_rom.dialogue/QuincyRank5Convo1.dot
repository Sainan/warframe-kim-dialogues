	2990 [label="Я не знаю чи шкодую, що довелося вбити їх швидко. І навіть не було спроби врятувати їх, як робили інші. Або… дати комусь це зробити замість мене. Іноді думаю, що так.",shape=box,color=red];
		2990 -> 2995;
	2892 [label="Бо зрештою — ти просто маленький наляканий самотній хлопчик, який зміг багато досягти завдяки зовнішності й харизмі.",shape=box,color=red];
		2892 -> 2947;
	2908 [label="Update boolean QuincyDating",color=orange];
		2908 -> 2905;
	2993 [label="Саме тому моє життя присвячене саме тому, чого ти боїшся, Квінсі. Я впускаю людей, а ти закриваєшся від них.",shape=box,color=red];
		2993 -> 2992;
	2947 [label="Занадто переляканий, щоб визнати наявність *справжнього зв’язку* з кимось, бо зробить його *вразливим*.",shape=box,color=red];
		2947 -> 2948;
		2947 -> 2949;
		2947 -> 2950;
	2905 [label="Update boolean IsDating",color=orange];
		2905 -> 2906;
	2992 [label="Через зв’язок? Саме це Байдужість намагається вбити в цьому світі.",shape=box,color=red];
		2992 -> 2991;
	2948 [label="Мені не треба розповідати тобі цілу історію, щоб ти мене ненавидів. Для цього вистачить два слова.",shape=box,color=red];
		2948 -> 2951;
	2949 [label="Я не граю в такі ігри. Мені така срань у житті не треба. З мене досить. [Завершити розмову]",shape=box,color=red];
		2949 -> 2952;
	2950 [label="Хочеш ненавидіти? Хочеш віддалити мене? Гаразд. Я дам тобі причину ненавидіти мене.",shape=box,color=red];
		2950 -> 2958;
	2906 [label="Chat ends.",color=orange];
	2991 [label="Оце вона тоді забрала в мене. І саме за збереження цього я битимуся. По одному ідіоту за раз, якщо доведеться.",shape=box,color=red];
		2991 -> 2997;
		2991 -> 2998;
		2991 -> 2996;
	2951 [label="послухаймо",shape=box,color=blue];
		2951 -> 2954;
	2952 [label="нє. цього разу ні. ти так просто від цього не підеш. а якшо таки йдеш? то ти підеш на завжди, січеш? це все припиниться. ця миловидна текстова срань? ПРИПИНИТЬСЯ",shape=box,color=blue];
		2952 -> 2953;
	2997 [label="То як. Уже ненавидиш мене?",shape=box,color=red];
		2997 -> 2999;
	2998 [label="Ну як тобі? Чи треба ще врізати по яйцях для завершення?",shape=box,color=red];
		2998 -> 2999;
	2996 [label="Та-да.",shape=box,color=red];
		2996 -> 2999;
	2954 [label="Просто. Подорослішай.",shape=box,color=red];
		2954 -> 2955;
	2953 [label="тож або дай шо мені тра, або між нами все скінчено",shape=box,color=blue];
		2953 -> 2956;
		2953 -> 2957;
	2999 [label="ми ще тут не завершили…",shape=box,color=blue];
