	2995 [label="Але ж таке воно життя, чи не так? Ти маєш робити вибір. І завжди міркуватимеш чи він був правильним. Я знаю одне — у жодному зі світів їм не вдалося пережити експеримент Байдужості.",shape=box,color=red];
