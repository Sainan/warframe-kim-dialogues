	2846 [label="Ти всіх відштовхуєш. Навіть зараз, після всього цього, ти на віддалі. Ти робиш це, щоб відштовхнути мене.",shape=box,color=red];
		2846 -> 2878;
	2847 [label="Чесність для тебе важлива, чи не так? Із самого початку було так. Мою чесніть ти бачив. То відкрийся сам натомість.",shape=box,color=red];
		2847 -> 2894;
	2848 [label="У тобі є більше, аніж ти хочеш, щоби бачили інші. Ти хочеш, щоб люди бачили лише твій холод і відстороненість. Але ти не такий.",shape=box,color=red];
