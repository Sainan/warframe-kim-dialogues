		j1997182449 -> j1193862302;
	j3870760305 [label="Boolean QuincyConsentComplete is now true.",color=orange];
		j3870760305 -> "Chat ends.";
	j1193862302 [label="Хочу обговорити з тобою дещо, дізнатися, чи ти не проти.",shape=box,color=red];
		j1193862302 -> j2721204880;
	j2721204880 [label="Я не хочу, щоб у тебе була думка, що я брешу чи якось нечесно поводжуся.",shape=box,color=red];
		j2721204880 -> j2114924611;
	j2114924611 [label="сракамотика шо вже сталося",shape=box,color=blue];
		j2114924611 -> j3057447194;
	j3057447194 [label="хто вмер? його величність у засвітах?",shape=box,color=blue];
		j3057447194 -> j411067406;
	j411067406 [label="Та ні! Ні. Артур живий. Мені потрібно поговорити з тобою про… сподіваюся, це не буде дуже незручно для тебе.",shape=box,color=red];
		j411067406 -> j1189172066;
	j1189172066 [label="Не хочу ставити тебе в незручне становище. Тож якщо відмовиш, то нічого страшного. Просто хочу, щоб ти знав.",shape=box,color=red];
		j1189172066 -> j1303039817;
	j1303039817 [label="Те, що в нас є, важливе для мене. Дуже-дуже. І воно реальне. Я не хочу, щоб ти сумнівався в цьому.",shape=box,color=red];
		j1303039817 -> j1148984836;
	j1148984836 [label="Check boolean QuincyForgiven",color=orange];
		j1148984836 -> j4135006143 [label=true,color=green];
		j1148984836 -> j1136419358 [label=false,color=brown];
	j4135006143 [label="ооо срань крихітко ти тут мені пробуєш впарити шо граєш коханців деінде?",shape=box,color=blue];
		j4135006143 -> j906928993;
	j1136419358 [label="ооо срань криіхтко ти тут мені пробуєш впарити шо крутиш ігри в іншому місті?",shape=box,color=blue];
		j1136419358 -> j3971871852;
	j906928993 [label="Мені хотілося б обговорити це й отримати згоду до того, як усе зайде занадто далеко. Не хочу тебе засмучувати. Ми начебто не обговорювали це раніше.",shape=box,color=red];
		j906928993 -> j2661664848;
	j3971871852 [label="Мені хотілося б обговорити це й отримати згоду до того, як усе зайде занадто далеко. Не хочу тебе засмучувати. Ми начебто не обговорювали це раніше.",shape=box,color=red];
		j3971871852 -> j3732502845;
	j2661664848 [label="а хто сказав, що я засмутився? ніт крихітко я намагаюся придумати як умовить рожевоволоску мене підкинути мвахахах",shape=box,color=blue];
		j2661664848 -> j3530709036;
	j3732502845 [label="та спок усе норм поважаю тих хто може грати",shape=box,color=blue];
		j3732502845 -> j3297971411;
	j3530709036 [label="нє але все ясн. я шарю. я знаю як то воно. іноді ти закохуєшся в одного, а потім ше в когось і се просто серце твоє таке чудить і може. то не сором",shape=box,color=blue];
		j3530709036 -> j1151113500;
	j3297971411 [label="нє але все ясн. я шарю. я знаю як то воно. іноді ти упадаєш за одним а потім за ще кимось і се просто серце твоє таке чудить і може. то не сором",shape=box,color=blue];
		j3297971411 -> j2949353827;
	j1151113500 [label="+20 Chemistry",color=orange];
		j1151113500 -> j4194746065;
	j2949353827 [label="+20 Chemistry",color=orange];
		j2949353827 -> j926347849;
	j4194746065 [label="якшо між нами все досі справжнє як ти кажеш то я вірю",shape=box,color=blue];
		j4194746065 -> j12374003;
	j926347849 [label="якшо між нами все норм як ти кажеш то я вірю",shape=box,color=blue];
		j926347849 -> j12374003;
	j12374003 [label="ти тіко ліпше не май дурної пики коли дивися на когось з прокльонівців чи кругостільців",shape=box,color=blue];
