		3980 -> 3981 [label=false,color=brown];
	3982 [label="ооо срань крихітко ти тут мені пробуєш впарити шо граєш коханців деінде?",shape=box,color=blue];
		3982 -> 3984;
	3981 [label="ооо срань криіхтко ти тут мені пробуєш впарити шо крутиш ігри в іншому місті?",shape=box,color=blue];
		3981 -> 3983;
	3984 [label="Мені хотілося б обговорити це й отримати згоду до того, як усе зайде занадто далеко. Не хочу тебе засмучувати. Ми начебто не обговорювали це раніше.",shape=box,color=red];
		3984 -> 3986;
	3983 [label="Мені хотілося б обговорити це й отримати згоду до того, як усе зайде занадто далеко. Не хочу тебе засмучувати. Ми начебто не обговорювали це раніше.",shape=box,color=red];
		3983 -> 3985;
	3986 [label="а хто сказав, що я засмутився? ніт крихітко я намагаюся придумати як умовить рожевоволоску мене підкинути мвахахах",shape=box,color=blue];
		3986 -> 3988;
	3985 [label="та спок усе норм поважаю тих хто може грати",shape=box,color=blue];
		3985 -> 3987;
	3988 [label="нє але все ясн. я шарю. я знаю як то воно. іноді ти закохуєшся в одного, а потім ше в когось і се просто серце твоє таке чудить і може. то не сором",shape=box,color=blue];
