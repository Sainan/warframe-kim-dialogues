	3972 [label="Chat ends.",color=orange];
	3974 [label="Я не хочу, щоб у тебе була думка, що я брешу чи якось нечесно поводжуся.",shape=box,color=red];
		3974 -> 3975;
	3975 [label="сракамотика шо вже сталося",shape=box,color=blue];
		3975 -> 3976;
	3976 [label="хто вмер? його величність у засвітах?",shape=box,color=blue];
		3976 -> 3977;
	3977 [label="Та ні! Ні. Артур живий. Мені потрібно поговорити з тобою про… сподіваюся, це не буде дуже незручно для тебе.",shape=box,color=red];
		3977 -> 3978;
	3978 [label="Не хочу ставити тебе в незручне становище. Тож якщо відмовиш, то нічого страшного. Просто хочу, щоб ти знав.",shape=box,color=red];
		3978 -> 3979;
	3979 [label="Те, що в нас є, важливе для мене. Дуже-дуже. І воно реальне. Я не хочу, щоб ти сумнівався в цьому.",shape=box,color=red];
