		2342 -> 2346;
		2342 -> 2345;
	2346 [label="Є одна пані, Вала Ґларіос. Початково була його підлеглою. Але ледь не загинула з усіма зорельотами, вибухами й проявами непокори.",shape=box,color=red];
		2346 -> 2347;
	2345 [label="У нього є так зване сестринство, яке він тренує й тримає поруч себе. Можу сказати, що він навіть пишається ними. Вважає їх сім’єю.",shape=box,color=red];
		2345 -> 2349;
	2347 [label="Він відчинив їй прохід у Порожнечу, де… не важливо, це інша й довга історія. Тож він урятував їй життя. Думаю, що він щиро цінує її. Вважає її сестрою.",shape=box,color=red];
		2347 -> 2348;
	2349 [label="Щось трохи на секту чи культ схоже, якщо чесно. Але що поробиш? Так працюють гроші.",shape=box,color=red];
		2349 -> 2351;
	2348 [label="Думаю, що вона натомість вважає його ріднею теж.",shape=box,color=red];
		2348 -> 2353;
	2351 [label="гроші купують відданість, допоки вони в тебе є. і нема жодного культу старішого за золото",shape=box,color=blue];
		2351 -> 2350;
		2351 -> 2352;
	2353 [label="ніхто не буває чистим злом чи добром, знаєш? схоже, що цей тип знає, хто його зграя, січеш?",shape=box,color=blue];
		2353 -> 2354;
	2350 [label="Мені дуже не подобається, коли ти говориш як він. У житті є набагато більше всякого, аніж просто гроші.",shape=box,color=red];
		2350 -> 2361;
	2352 [label="Ви точно би знайшли спільну мову. Аж занадто схожі.",shape=box,color=red];
		2352 -> 2361;
