		1312 -> 1314;
	1313 [label="Мені не самотужки довелося це робити. Навіть вороги, як-от Корпус чи ґрінери усвідомили, що в нас з’явився спільний ворог. Навіть батько Ерри допомагав мені. Його ім’я Ганго.",shape=box,color=red];
		1313 -> 1315;
