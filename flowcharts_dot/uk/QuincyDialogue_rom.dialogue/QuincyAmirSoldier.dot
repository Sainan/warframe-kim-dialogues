digraph {
	1845 [label="QuincyAmirSoldier begins.",color=orange];
		1845 -> 1846;
	1846 [label="гей",shape=box,color=blue];
		1846 -> 1847;
	1847 [label="говорив з малим швидкісником за твоєю порадою",shape=box,color=blue];
		1847 -> 1850;
		1847 -> 1848;
		1847 -> 1853;
	1850 [label="І як усе пройшло?",shape=box,color=red];
		1850 -> 1849;
	1848 [label="Ого. Ти дослухався до мене?",shape=box,color=red];
		1848 -> 1851;
	1853 [label="Я якраз посеред важливої справи. Вибач. [Завершити розмову]",shape=box,color=red];
		1853 -> 1852;
	1849 [label="спершу він подумав, шо я дам йому в пику. але я забрав його на дах, ми сиділи й говорили",shape=box,color=blue];
		1849 -> 1854;
	1851 [label="трясця, стулися, й дай дописати, добре?",shape=box,color=blue];
		1851 -> 1849;
	1852 [label="Chat ends.",color=orange];
	1854 [label="я розповів йому як потрапив до армії та став снайпером",shape=box,color=blue];
		1854 -> 1856;
		1854 -> 1855;
	1856 [label="І *як* ти став снайпером, до речі?",shape=box,color=red];
		1856 -> 1857;
	1855 [label="І?",shape=box,color=red];
		1855 -> 1858;
	1857 [label="зараз це не важливо",shape=box,color=blue];
		1857 -> 1858;
	1858 [label="розповів про перший раз… як довелося вбити",shape=box,color=blue];
		1858 -> 1859;
	1859 [label="про перший раз, як дивився в приціл і забрав життя",shape=box,color=blue];
		1859 -> 1860;
	1860 [label="коли у пеклі бою… на тебе мчить якийсь посіпака з ножем, чи гвинтівкою, чи байдуже з чим… це одне",shape=box,color=blue];
		1860 -> 1861;
	1861 [label="а геть інше абсолютно, коли ти на даху за 300 метрів від цілі й вони навіть не знають про тебе…",shape=box,color=blue];
		1861 -> 1864;
	1864 [label="у тебе є час *подумати* про них. хто вони. звідки. чи є в них сім’я. діти",shape=box,color=blue];
		1864 -> 1862;
	1862 [label="і… ти тиснеш на гачок. БУМ",shape=box,color=blue];
		1862 -> 1863;
	1863 [label="і вже нічого не має значення",shape=box,color=blue];
		1863 -> 1865;
	1865 [label="вони мертві. ти забрав їхнє життя",shape=box,color=blue];
		1865 -> 1866;
	1866 [label="те обличчя живе в моїй голові",shape=box,color=blue];
		1866 -> 1867;
	1867 [label="як і кожне наступне відтоді",shape=box,color=blue];
		1867 -> 1868;
		1867 -> 1869;
	1868 [label="І як він зреагував?..",shape=box,color=red];
		1868 -> 1871;
	1869 [label="Дуже… підбадьорливо.",shape=box,color=red];
		1869 -> 1871;
	1871 [label="тривалий час сиділи й мовчали. просто сиділи в тиші",shape=box,color=blue];
		1871 -> 1877;
	1877 [label="а потім він… розповів про свої нічні жахіття",shape=box,color=blue];
		1877 -> 1874;
	1874 [label="і про свої почуття, шо він не належить до групи, не частина її, бо не солдат",shape=box,color=blue];
		1874 -> 1872;
	1872 [label="тож я розповів йому про те, як жахливо почувавсь, зробивши першу снайперську позначку",shape=box,color=blue];
		1872 -> 1873;
	1873 [label="і як звик до жахіть, шо прийшли згодом. вони були ше страшніші за дитячі",shape=box,color=blue];
		1873 -> 1875;
	1875 [label="але я перепросив за те, шо весь час поводився як мудак",shape=box,color=blue];
		1875 -> 1876;
	1876 [label="і шо він один із нас як і всі інші. і те шо я такий як я є, і він такий як він є. просто ми такі як ми є, розумієш?",shape=box,color=blue];
		1876 -> 1870;
	1870 [label="і знаєш шо він сказав?..",shape=box,color=blue];
		1870 -> 1878;
		1870 -> 1879;
	1878 [label="Що?",shape=box,color=red];
		1878 -> 1882;
	1879 [label="Ні?",shape=box,color=red];
		1879 -> 1882;
	1882 [label="«правду кажеш — ти мудак»",shape=box,color=blue];
		1882 -> 1884;
	1884 [label="але коли я ледь його не скинув із даху… знаєш шо стало?",shape=box,color=blue];
		1884 -> 1883;
	1883 [label="він мене обійняв. трясця — обійняв. і сказав «а ще ти також мій старший братик»",shape=box,color=blue];
		1883 -> 1881;
	1881 [label="шзнх",shape=box,color=blue];
		1881 -> 1880;
	1880 [label="але… так. вартувало того. думаю, шо воно шось значило для нього, насправді. та й для мене теж… гадаю",shape=box,color=blue];
		1880 -> 1886;
	1886 [label="+20 Chemistry",color=orange];
		1886 -> 1885;
	1885 [label="тож… дяк",shape=box,color=blue];
		1885 -> 1887;
	1887 [label="Chat ends.",color=orange];
}