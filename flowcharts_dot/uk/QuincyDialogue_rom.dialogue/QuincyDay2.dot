		3064 -> 3059;
	3059 [label="тож коли він утягнув НАС У КАПІТАЛЬНУ ХАЛЕПУ ЗА КІЛЬКА МІСЯЦІВ ПОТОМУ і готувався рапорт на його ЗВІЛЬНЕННЯ?!",shape=box,color=blue];
		3059 -> 3066;
	3066 [label="Я МАВ ОБИРАТИ. чи набрехати довбаному командуванню. чи кинути його під потяг як я раніше робив. чи ВЧИНИТИ ПРАВИЛЬНО",shape=box,color=blue];
		3066 -> 3057;
	3057 [label="і я вчинив ТРЯСЦЯ ПРАВИЛЬНО БО БУВ У БОРГУ ПЕРЕД НИМ і… і покинув армію разом із ним та… помахав мрії про коледж",shape=box,color=blue];
		3057 -> 3061;
	3061 [label="моя мрія про ліпше життя для себе й рідні — щезла. але артур сказав «нє, дружаньо, усе буде зашибісь»",shape=box,color=blue];
		3061 -> 3060;
	3060 [label="«я знайшов нам нове місце у миротворчій організації. платять більше й наперед. усе буде круто»",shape=box,color=blue];
		3060 -> 3058;
	3058 [label="тож я звільнився і приєднався до МКР разом із ним. НУ НЕ ДОВБАНИЙ ІДІОТ ГА?",shape=box,color=blue];
		3058 -> 3069;
