	3026 [label="я розповів чому пішов у армію. як хтів ліпшого життя для себе та рідні",shape=box,color=blue];
		3026 -> 3119;
	3027 [label="ніколи не розповідав тобі чому пішов у армію. я коротко скажу. усе просто. хтів ліпшого життя для себе й рідні",shape=box,color=blue];
		3027 -> 3028;
	3020 [label="Update boolean QuincyDating",color=orange];
		3020 -> 3019;
	3119 [label="і як все пішло шкереберть перш ніж видалася така можливість",shape=box,color=blue];
		3119 -> 3038;
	3028 [label="там де я ріс? там нема можливостей це отримать задарма. нє, тра вирватися звідти для цього",shape=box,color=blue];
		3028 -> 3029;
	3019 [label="Update boolean IsDating",color=orange];
		3019 -> 3018;
	3038 [label="не треба бути геніями шоби зрозуміть шо його величність і є причина всього кабздеця у моєму житті. тому я й присягнув шо більше ніколи не дозволю такому трапитися",shape=box,color=blue];
		3038 -> 3035;
	3029 [label="а для таких як я найлегше це зробити через армію. і них є стипендія. солдатам. на коледж",shape=box,color=blue];
		3029 -> 3032;
	3018 [label="Chat ends.",color=orange];
	3035 [label="тож",shape=box,color=blue];
		3035 -> 3036;
	3032 [label="тож я вирішив піти повбивати кілька років, а потім здобути освіту в бізнес школі. чи фінансах. може майстром ділового адміністрування стати чи шось таке",shape=box,color=blue];
		3032 -> 3030;
	3036 [label="випадково, волею кидка кубика, я потрапив у підрозділ його величності. 3ій бат багряної варти",shape=box,color=blue];
		3036 -> 3034;
	3030 [label="повернутися домів і влаштувати приємне життя рідні, зробити по іншому",shape=box,color=blue];
		3030 -> 3031;
	3034 [label="він був командувачем, розумієш? а я новачок після академії",shape=box,color=blue];
		3034 -> 3039;
	3031 [label="але все пішло шкереберть перш ніж видалася така можливість",shape=box,color=blue];
		3031 -> 3033;
	3039 [label="і тривалий час я намагався йти за правилами. бути хорошим солдатиком. але далі й далі… я усвідомив, шо колоду тасовано не на мою користь",shape=box,color=blue];
		3039 -> 3037;
	3033 [label="Update boolean QuincyArthur3",color=orange];
		3033 -> 3038;
	3037 [label="життя несправедливе. куди не підеш. кумівство. улюбленці. фанатики. скрізь. люди зверхньо ставилися до мене через походження",shape=box,color=blue];
		3037 -> 3044;
	3044 [label="через те хто я",shape=box,color=blue];
		3044 -> 3041;
	3041 [label="тож я… почав робити дурощі… речі, про які шкодую. почав зриватися на безглузді образи. хотіли забрати в мене? я забирав у них",shape=box,color=blue];
		3041 -> 3042;
	3042 [label="якшо вони не прикривають мене, то чого я повинен прикривати їх? тож я дбав лиш про себе і ЛИШЕ про себе, січеш?",shape=box,color=blue];
		3042 -> 3040;
	3040 [label="я ніц не крав. не порушував статут. я був хорошим солдатиком. але якшо доводилося чуть фразу «зловмисна непокора» то ти розумієш вайб",shape=box,color=blue];
		3040 -> 3045;
	3045 [label="не було ані секунди, яку я міг витратити для когось, ніколи. я хтів дослужити до кінця строку й піти зі своїми чеками",shape=box,color=blue];
		3045 -> 3049;
	3049 [label="а потім сталася халепа. ми були на завданні. я на спостереженні. я бачу шо супротивник раптово починає якось нервово поводитися. вони знали, шо ми тут",shape=box,color=blue];
		3049 -> 3046;
	3046 [label="артур з рештою на бойовищі і в мене є півсекунди рішить. я можу видати себе вистріливши у ворога й попередити його величність і його лицарят про небезпеку",shape=box,color=blue];
		3046 -> 3047;
	3047 [label="але це підстава для мене. гарантовано супротивник швидко примчить і візьме мене за мій тупий зад… тож…",shape=box,color=blue];
		3047 -> 3051;
	3051 [label="я спакував манатки й передав, шо нас виявили… подумавши шо його величності та іншим уже клямка полюбому…",shape=box,color=blue];
		3051 -> 3050;
	3050 [label="я вийшов з позиції де ховався і повернув за ріг… і вперся носом прямо у дуло ворожої гвинтівки",shape=box,color=blue];
		3050 -> 3048;
	3048 [label="нє. вони знали увесь час шо я там. вони вирахували мене із самого початку",shape=box,color=blue];
		3048 -> 3054;
	3054 [label="мене витягли на вулицю, поставили на коліна й притули пістолет до потилиці",shape=box,color=blue];
		3054 -> 3053;
	3053 [label="БАХ-БАХ",shape=box,color=blue];
		3053 -> 3561;
	3561 [label="довбаний артур. довбана срака його величності з’являється нізвідки й рятує мене",shape=box,color=blue];
		3561 -> 3562;
	3562 [label="ЯКЖЕ Ж ТРЯСЦЯ я був злий на нього. підвівся й сказав валити нахрін прямо там",shape=box,color=blue];
		3562 -> 3055;
