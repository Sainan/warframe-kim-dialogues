	3063 [label="ТРЯСЦЯ",shape=box,color=blue];
		3063 -> 3067;
	3067 [label="невже ТИ НЕ РОЗУМІЄШ?! я жив лише для себе та рідні. це мало значення. тілько це єдине мало значення",shape=box,color=blue];
		3067 -> 3065;
	3065 [label="і тепер… і тепер цей довбень ЦЕЙ ДОВБЕНЬ став одним із тих про КОГО Я МУСИВ ДБАТИ АБИ ШО НЕ СТАЛОСЯ",shape=box,color=blue];
		3065 -> 3064;
