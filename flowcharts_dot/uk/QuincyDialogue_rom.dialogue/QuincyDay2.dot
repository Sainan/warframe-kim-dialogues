		3077 -> 3079;
	3078 [label="і ти так «нє, я дбатиму про тебе. навіть якшо ніц нема сенсу в цьому»",shape=box,color=blue];
		3078 -> 3079;
	3079 [label="трясця, шо я мав робить? останнього такого разу… воно спаскудило мені життя…",shape=box,color=blue];
		3079 -> 3081;
		3079 -> 3080;
		3079 -> 3082;
	3081 [label="Мені прикро дізнатися, що тобі довелося пройти крізь таке. Але твоє попереднє життя — не моя провина.",shape=box,color=red];
		3081 -> 3084;
	3080 [label="Я розумію, чому ти почувався так, наче маєш захищатися.",shape=box,color=red];
		3080 -> 3083;
	3082 [label="Очікувалося щось… разючіше. Оце ти порівнюєш з моєю історією?",shape=box,color=red];
		3082 -> 3089;
	3084 [label="я знаю. твоя правда. мені прикро за те. я злякався, шо ті «ми»… шоби воно не значило… знову понівечить мене",shape=box,color=blue];
		3084 -> 3086;
	3083 [label="дяк. це багато значить для мене. це не значить шо воно правильно. мені прикро. я… гадаю десь углибині просто злякався. ну «нас», шоби то «ми» не значили. шо воно знову понівечить мене",shape=box,color=blue];
		3083 -> 3085;
