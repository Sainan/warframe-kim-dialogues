		3153 -> 3161;
		3153 -> 3160;
	3152 [label="Ну, дивись. Те, що я *користуюся* силами Порожнечі, то це не означає, що я знаю як воно *працює*. Ця зброя тягнеться до Порожнечі, щоби перетворюватися.",shape=box,color=red];
