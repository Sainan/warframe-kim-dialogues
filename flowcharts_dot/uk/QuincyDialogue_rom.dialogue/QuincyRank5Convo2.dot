		3160 -> 3163;
	3154 [label="Кабальєро — один із «Паланки», угруповання на «Заримені». Примара, бо ліпшої назви не придумаєш. Доволі специфічний. Доволі крутий та іноді мудило. Тобі би дуже сподобався.",shape=box,color=red];
