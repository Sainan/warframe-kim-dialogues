		2663 -> 2666 [label=false,color=brown];
		2663 -> 2667 [label=false,color=brown];
	2661 [label="Chat ends.",color=orange];
	2665 [label="К., ми зустрічаємося. Очевидно, що ти не хочеш розповідати про те, що сталося. Але ти маєш довіряти мені в подібних речах.",shape=box,color=red];
		2665 -> 2668;
	2666 [label="Я вже довго чекаю на цю розповідь і чекаю терпляче.",shape=box,color=red];
		2666 -> 2672;
	2667 [label="Просто скажи, якщо не хочеш узагалі розповідати. У всіх є таємниці. Щоб не сталося — це стосується лише тебе.",shape=box,color=red];
		2667 -> 2673;
	2664 [label="К., ми друзі. Очевидно, що ти не хочеш розповідати про те, що сталося. Але ти маєш довіряти мені в подібних речах.",shape=box,color=red];
		2664 -> 2670;
	2668 [label="слухай, я зважатиму на те, шо в тебе явно не було багато стосунків у житті, ЯКШО ВЗАГАЛІ БУЛИ",shape=box,color=blue];
		2668 -> 2669;
	2672 [label="справедливо. дуже. вибач. це не те, шо мені хотілося б виносити назовні",shape=box,color=blue];
		2672 -> 2674;
	2673 [label="Не треба водити мене довкола: розповім, а потім не розповідаєш. Ти не любиш ігор. І я теж.",shape=box,color=red];
		2673 -> 2672;
	2670 [label="слухай, я зважатиму на те, шо в тебе явно не було багато друзів у житті",shape=box,color=blue];
		2670 -> 2671;
	2669 [label="але бути з кимось і довіряти найтемніші моменти життя? ХАХ ти таке наївне іноді",shape=box,color=blue];
		2669 -> 2675;
		2669 -> 2676;
	2674 [label="не ображайся",shape=box,color=blue];
		2674 -> 2676;
	2671 [label="але дружити з кимось і довіряти найтемніші моменти життя? ХАХ ти таке наївне іноді",shape=box,color=blue];
		2671 -> 2675;
		2671 -> 2676;
	2675 [label="Хіба це не означає довіру?",shape=box,color=red];
		2675 -> 2677;
	2676 [label="Я розумію. Скажеш, коли будеш готовий. Усе добре. І якщо будеш «готовий» аж «ніколи»? То теж нехай.",shape=box,color=red];
		2676 -> 2680;
	2677 [label="ти таке іноді миле. нє. я з тобою не сваритимуся через це. слухай, я все обміркую і ми повернемося до цього згодом",shape=box,color=blue];
		2677 -> 2678;
	2680 [label="Check boolean QuincyDating",color=orange];
		2680 -> 2681 [label=true,color=green];
		2680 -> 2682 [label=false,color=brown];
	2678 [label="Update boolean QuincySorted",color=orange];
		2678 -> 2679;
	2681 [label="навіть попри те, шо в нас шось є?",shape=box,color=blue];
		2681 -> 2687;
		2681 -> 2688;
		2681 -> 2689;
	2682 [label="дуже сильно з твого боку. гаразд. я все обміркую ще раз у своїй голові. а потім прийду до тебе на розмову, добре?",shape=box,color=blue];
		2682 -> 2683;
	2679 [label="Chat ends.",color=orange];
	2687 [label="Мені все норм, здається. А тобі?",shape=box,color=red];
		2687 -> 2692;
	2688 [label="Просто ми ще не перейшли якусь точку. Але мені нормально, а тобі?",shape=box,color=red];
		2688 -> 2694;
	2689 [label="Я не знаю. Вирішую на ходу. Стосунки мені незвичні. Але я хочу бути з тобою і хочу твоєї довіри. Але також я знаю, що силою не змушу тебе.",shape=box,color=red];
		2689 -> 2696;
	2683 [label="до речі, буде не дуже приємно. а до того часу. бувай",shape=box,color=blue];
		2683 -> 2684;
	2692 [label="+5 Chemistry",color=orange];
		2692 -> 2691;
	2694 [label="+10 Chemistry",color=orange];
