	2696 [label="+20 Chemistry",color=orange];
		2696 -> 2698;
	2684 [label="+20 Chemistry",color=orange];
		2684 -> 2693;
	2691 [label="не знаю. мені треба все обдумати й визначитися в почуттях. схоже, шо це не те, шо я можу витягти",shape=box,color=blue];
		2691 -> 2690;
	2698 [label="може ти розумієш більше, аніж я вважаю. добре. мені треба це обдумати… визначити свої почуття",shape=box,color=blue];
		2698 -> 2690;
	2693 [label="Update boolean QuincySorted",color=orange];
		2693 -> 2685;
	2690 [label="до речі, буде не дуже приємно. до зв’язку, сексі. якшо ти думаєш, шо я дозволю тобі втекти, поки я все обмірковую? то в тебе проблеми з головою",shape=box,color=blue];
		2690 -> 2695;
