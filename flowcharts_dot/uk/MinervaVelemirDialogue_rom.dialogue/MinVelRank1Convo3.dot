		205 -> 208;
		205 -> 209;
		205 -> 210;
	206 [label="Не хочу вас засмучувати, але ми, мабуть, застрягли в очікуванні наступного кроку Людини в стіні.",shape=box,color=red];
		206 -> 211;
	207 [label="PapaPolar: насправді, важливо. і про це не так важко здогадатися. ми не сильно й приховували.",shape=box,color=blue];
		207 -> 212;
	208 [label="Бо тоді я не буду відрізнятися від Байдужості. «Скальдри». Ентраті. Я не ходжу і не вбиваю людей направо й наліво.",shape=box,color=red];
		208 -> 213;
	209 [label="Бо не вона робила той вибір, який привів її до цього. І те, що вона не загинула від моєї руки, не означає, що мені *не байдуже* і я зійду зі свого шляху, щоб урятувати її.",shape=box,color=red];
		209 -> 214;
	210 [label="Бо я не збираюся робити за Ентраті брудну роботу. Якби він хотів убити нову маріонетку Байдужості, він зробив би це сам.",shape=box,color=red];
		210 -> 215;
	211 [label="MomToxicated: І чому це? Ти не можеш відстежити його? Це? Чим би воно не було. Чи ти не знаєш, що воно насправді шукає?",shape=box,color=blue];
		211 -> 216;
		211 -> 217;
	212 [label="PapaPolar: і можливо, просто *можливо*, якби ти довірила більше інформації нашим новим друзям, то вони б охочіше *допомогли нам*",shape=box,color=blue];
		212 -> 218;
	213 [label="З чого випливає, що я вбиваю людей цілеспрямовано. Чого я не роблю. Тобто. Я вбиваю людей. Але це інше. Ти знаєш, що я маю на увазі.",shape=box,color=red];
		213 -> 219;
	214 [label="Я її *не знаю*.",shape=box,color=red];
		214 -> 220;
	215 [label="Але, як я підозрюю, старому покидьку подобається стріляти лише в тих, хто підіймається.",shape=box,color=red];
		215 -> 221;
	216 [label="Не можна причепити маячок до напів-щось-там-бога.",shape=box,color=red];
		216 -> 222;
	217 [label="Наразі ми не зовсім розуміємо його мотивів, так. Але там немає нічого хорошого.",shape=box,color=red];
