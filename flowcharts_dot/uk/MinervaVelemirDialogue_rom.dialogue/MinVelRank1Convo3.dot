		255 -> 257;
	256 [label="PapaPolar: більш-менш. ми були за кордоном, у маленькому містечку за кілька країн на південь звідси. Місцину розірвало на шмаття. знайшли її в будинку, руду та злющу.",shape=box,color=blue];
