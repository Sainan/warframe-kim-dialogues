		197 -> 198;
	198 [label="MomToxicated: Тобі не потрібно допомагати мені заради мене. У нас є спільний ворог. Це «Людина в стіні».",shape=box,color=blue];
		198 -> 199;
	199 [label="MomToxicated: Наскільки я розумію, ми обоє зацікавлені в тому, куди він подівся, що він хоче та чому він обрав саме Русалку.",shape=box,color=blue];
