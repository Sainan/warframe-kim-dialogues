	"MinVelRank1Convo3 begins." [color=orange];
		"MinVelRank1Convo3 begins." -> j3711000787;
	j3711000787 [label="MomToxicated: Мандрівниче. Можемо поговорити?",shape=box,color=blue];
		j3711000787 -> j2586341341;
		j3711000787 -> j1671867806;
		j3711000787 -> j2693159984;
		j3711000787 -> j620101454;
	j2586341341 [label="Доброго ранку, Мінерво. Якщо це твоє справжнє ім’я.",shape=box,color=red];
		j2586341341 -> j2569749142;
	j1671867806 [label="Я бачу, ми відкинули «лапки».",shape=box,color=red];
		j1671867806 -> j2467521149;
	j2693159984 [label="Тепер ти просиш?",shape=box,color=red];
		j2693159984 -> j2467521149;
	j620101454 [label="Що?",shape=box,color=red];
		j620101454 -> j2604604534;
	j2569749142 [label="+5 Chemistry",color=orange];
		j2569749142 -> j3069076165;
	j2467521149 [label="MomToxicated: Мені прочитали лекцію про так звані гарні манери.",shape=box,color=blue];
		j2467521149 -> j1573224096;
	j2604604534 [label="+5 Chemistry",color=orange];
		j2604604534 -> j4253997647;
	j3069076165 [label="MomToxicated: Віриш чи ні, але це так.",shape=box,color=blue];
		j3069076165 -> j2054103966;
	j1573224096 [label="MomToxicated: Що є істерикою, враховуючи всі обставини.",shape=box,color=blue];
		j1573224096 -> j4152155037;
	j4253997647 [label="MomToxicated: Одразу до справи. Гаразд.",shape=box,color=blue];
		j4253997647 -> j4152155037;
	j2054103966 [label="MomToxicated: Але річ не в тім.",shape=box,color=blue];
		j2054103966 -> j4152155037;
	j4152155037 [label="MomToxicated: Ми в Голвенії, тому що маємо проблему, яку потрібно розв’язати. І ти можеш допомогти з цим.",shape=box,color=blue];
		j4152155037 -> j695578589;
	j695578589 [label="MomToxicated: Тож мені потрібна твоя допомога, і я прошу тебе допомогти.",shape=box,color=blue];
		j695578589 -> j3966803275;
		j695578589 -> j2326654394;
		j695578589 -> j940704016;
	j3966803275 [label="Що за проблема?",shape=box,color=red];
		j3966803275 -> j4276837374;
	j2326654394 [label="Чому я маю допомагати?",shape=box,color=red];
		j2326654394 -> j4276837374;
	j940704016 [label="Яке це має відношення до Русалки?",shape=box,color=red];
		j940704016 -> j4276837374;
	j4276837374 [label="MomToxicated: Це дуже гарне питання.",shape=box,color=blue];
		j4276837374 -> j1025925867;
	j1025925867 [label="MomToxicated: Тобі не потрібно допомагати мені заради мене. У нас є спільний ворог. Це «Людина в стіні».",shape=box,color=blue];
		j1025925867 -> j132201735;
	j132201735 [label="MomToxicated: Наскільки я розумію, ми обоє зацікавлені в тому, куди він подівся, що він хоче та чому він обрав саме Русалку.",shape=box,color=blue];
		j132201735 -> j45501799;
	j45501799 [label="MomToxicated: Я правильно оцінюю ситуацію?",shape=box,color=blue];
		j45501799 -> j741518526;
		j45501799 -> j1001675888;
		j45501799 -> j1656532768;
	j741518526 [label="Чи можемо ми перерватися, щоби пояснити мені, чому ви так піклуєтеся про Русалку?",shape=box,color=red];
		j741518526 -> j952824913;
	j1001675888 [label="Перші два пункти — так. Насправді мені абсолютно байдуже, чому він обрав Русалку.",shape=box,color=red];
		j1001675888 -> j3131981058;
	j1656532768 [label="Звісно. Так. Усе правильно.",shape=box,color=red];
		j1656532768 -> j4162747341;
	j952824913 [label="MomToxicated: Чому — не важливо.",shape=box,color=blue];
		j952824913 -> j1608607691;
	j3131981058 [label="MomToxicated: Якщо тебе не хвилює її благополуччя, то навіщо щадити її життя? Ми чули, що сталося.",shape=box,color=blue];
		j3131981058 -> j802254330;
		j3131981058 -> j3741935558;
		j3131981058 -> j174452726;
	j4162747341 [label="Не хочу вас засмучувати, але ми, мабуть, застрягли в очікуванні наступного кроку Людини в стіні.",shape=box,color=red];
		j4162747341 -> j2080124308;
	j1608607691 [label="PapaPolar: насправді, важливо. і про це не так важко здогадатися. ми не сильно й приховували.",shape=box,color=blue];
		j1608607691 -> j2153465192;
	j802254330 [label="Бо тоді я не буду відрізнятися від Байдужості. «Скальдри». Ентраті. Я не ходжу і не вбиваю людей направо й наліво.",shape=box,color=red];
		j802254330 -> j3012979118;
	j3741935558 [label="Бо не вона робила той вибір, який привів її до цього. І те, що вона не загинула від моєї руки, не означає, що мені *не байдуже* і я зійду зі свого шляху, щоб урятувати її.",shape=box,color=red];
		j3741935558 -> j837238564;
	j174452726 [label="Бо я не збираюся робити за Ентраті брудну роботу. Якби він хотів убити нову маріонетку Байдужості, він зробив би це сам.",shape=box,color=red];
		j174452726 -> j1048408933;
	j2080124308 [label="MomToxicated: І чому це? Ти не можеш відстежити його? Це? Чим би воно не було. Чи ти не знаєш, що воно насправді шукає?",shape=box,color=blue];
		j2080124308 -> j3257248499;
		j2080124308 -> j904859761;
	j2153465192 [label="PapaPolar: і можливо, просто *можливо*, якби ти довірила більше інформації нашим новим друзям, то вони б охочіше *допомогли нам*",shape=box,color=blue];
		j2153465192 -> j1545738216;
	j3012979118 [label="З чого випливає, що я вбиваю людей цілеспрямовано. Чого я не роблю. Тобто. Я вбиваю людей. Але це інше. Ти знаєш, що я маю на увазі.",shape=box,color=red];
		j3012979118 -> j1305408890;
	j837238564 [label="Я її *не знаю*.",shape=box,color=red];
		j837238564 -> j79788209;
	j1048408933 [label="Але, як я підозрюю, старому покидьку подобається стріляти лише в тих, хто підіймається.",shape=box,color=red];
		j1048408933 -> j858310153;
	j3257248499 [label="Не можна причепити маячок до напів-щось-там-бога.",shape=box,color=red];
		j3257248499 -> j3081876794;
	j904859761 [label="Наразі ми не зовсім розуміємо його мотивів, так. Але там немає нічого хорошого.",shape=box,color=red];
		j904859761 -> j3081876794;
	j1545738216 [label="PapaPolar: це ж так у людей заведено.",shape=box,color=blue];
		j1545738216 -> j1569372434;
	j1305408890 [label="+5 Chemistry",color=orange];
		j1305408890 -> j2482664032;
	j79788209 [label="PapaPolar: і ми не дуже багато причин даємо, щоби було не байдуже. правда ж, М?",shape=box,color=blue];
		j79788209 -> j1140495570;
	j858310153 [label="PapaPolar: дуже химерне зауваження, але нехай",shape=box,color=blue];
		j858310153 -> j858958826;
		j858310153 -> j3417148830;
	j3081876794 [label="MomToxicated: То ти пропонуєш нам просто сидіти. Та чекати. Щоб воно… що? Висунуло голову? І ми зіграємо в «Крота в норі»?!",shape=box,color=blue];
		j3081876794 -> j3899330278;
	j1569372434 [label="MomToxicated: Яка з цього користь?",shape=box,color=blue];
		j1569372434 -> j1075805632;
	j2482664032 [label="PapaPolar: ти говориш із колишніми спецпризначенцями. ми розуміємо, хех",shape=box,color=blue];
		j2482664032 -> j993189246;
	j1140495570 [label="MomToxicated: Заткнися, Велимире.",shape=box,color=blue];
		j1140495570 -> j952824913;
	j858958826 [label="Усе гаразд. Я часто помираю. Це вже звичка.",shape=box,color=red];
		j858958826 -> j265394510;
	j3417148830 [label="Це не має особливого значення.",shape=box,color=red];
		j3417148830 -> j4162747341;
		j3417148830 -> j2964622253;
	j3899330278 [label="PapaPolar: принаймні тут є хороша компанія і непоганий бар, так?",shape=box,color=blue];
		j3899330278 -> j3474922673;
	j1075805632 [label="PapaPolar: М, не завадить мати друзів у цьому світі.",shape=box,color=blue];
		j1075805632 -> j1757633042;
	j993189246 [label="PapaPolar: часто те, що ми мусимо роботи заради «вищого блага», розмиває межі",shape=box,color=blue];
		j993189246 -> j891001350;
	j265394510 [label="PapaPolar: гараздоньки… як скажеш… звісно…",shape=box,color=blue];
		j265394510 -> j2858704710;
	j2964622253 [label="Чому ви так відчайдушно хочете дізнатися, що сталося з Русалкою?",shape=box,color=red];
		j2964622253 -> j952824913;
	j3474922673 [label="PapaPolar: музика непогана. той артур наче може бути гарним почарківцем",shape=box,color=blue];
		j3474922673 -> j3175084048;
	j1757633042 [label="MomToxicated: Навіщо нам «друзі»?! Ми підемо звідси, щойно дізнаємося, куди нам треба йти, щоб урятувати Несі.",shape=box,color=blue];
		j1757633042 -> j1803393561;
	j891001350 [label="PapaPolar: тому коли ми можемо зробити щось значуще, ми робимо це. тому ми тут намагаємося врятувати несі",shape=box,color=blue];
		j891001350 -> j4162747341;
		j891001350 -> j2964622253;
	j2858704710 [label="PapaPolar: хай там як…",shape=box,color=blue];
		j2858704710 -> j4162747341;
		j2858704710 -> j2964622253;
	j3175084048 [label="MomToxicated: І що, ми так і будемо жити, не знаючи, що з нею насправді сталося?! Чи з нею все гаразд?! Чи вона вже не вона?!",shape=box,color=blue];
		j3175084048 -> j2328378469;
	j1803393561 [label="PapaPolar: про це не певен. схоже, важко буде передбачити кроки того напівбога з порожнечі. прально, дружаньо?",shape=box,color=blue];
		j1803393561 -> j904859761;
		j1803393561 -> j3257248499;
	j2328378469 [label="MomToxicated: Як ти можеш сидіти тут і миритися з цим, Велимире?!",shape=box,color=blue];
		j2328378469 -> j2151860437;
	j2151860437 [label="PapaPolar: я не казав, що мирюся, М! просто я розумію, коли треба сісти й дочекатися свого часу!",shape=box,color=blue];
		j2151860437 -> j3839197205;
	j3839197205 [label="MomToxicated: Я розмовляла з Елеонорою. Вона розповіла мені, що відчула, коли доторкнулася до розуму Несі. Або до того, що від нього лишилося.",shape=box,color=blue];
		j3839197205 -> j3137561814;
	j3137561814 [label="MomToxicated: Від жінки, яку ми виростили. Від жінки, яку ми любили як рідну.",shape=box,color=blue];
		j3137561814 -> j4074736338;
	j4074736338 [label="MomToxicated: Хто знає, що…",shape=box,color=blue];
		j4074736338 -> j1177901824;
	j1177901824 [label="MomToxicated: А ти хочеш поговорити з Артуром про випивку.",shape=box,color=blue];
		j1177901824 -> j3234931622;
	j3234931622 [label="MomToxicated: Ду-те драку, Велимире.",shape=box,color=blue];
		j3234931622 -> j2774280008;
	j2774280008 [label="PapaPolar: і-і-і ось вона пішла…",shape=box,color=blue];
		j2774280008 -> j474210354;
		j2774280008 -> j3251675559;
	j474210354 [label="Що вона сказала?..",shape=box,color=red];
		j474210354 -> j1206888102;
	j3251675559 [label="Гадаю, це була груба лайка.",shape=box,color=red];
		j3251675559 -> j4162126886;
	j1206888102 [label="PapaPolar: радість участі в стількох закордонних спецопераціях — вислуховувати лайку понад сотнею мов",shape=box,color=blue];
		j1206888102 -> j2679693375;
		j1206888102 -> j2030829046;
	j4162126886 [label="PapaPolar: так. радість участі в стількох закордонних спецопераціях — вислуховувати лайку понад сотнею мов",shape=box,color=blue];
		j4162126886 -> j2679693375;
		j4162126886 -> j2030829046;
	j2679693375 [label="Ви двоє… одружені?",shape=box,color=red];
		j2679693375 -> j266448277;
	j2030829046 [label="Ви двоє… виростили… Русалку?",shape=box,color=red];
		j2030829046 -> j3155721901;
	j266448277 [label="Boolean MinervaVelimir1 is now true.",color=orange];
		j266448277 -> j736234783;
	j3155721901 [label="Boolean MinervaNeci3a is now true.",color=orange];
		j3155721901 -> j1600362819;
	j736234783 [label="PapaPolar: м-м-м. щось типу того. уже ні. тільки на папері. десь. у країні, що не існує з 1982-го.",shape=box,color=blue];
		j736234783 -> j89129379;
	j1600362819 [label="PapaPolar: більш-менш. ми були за кордоном, у маленькому містечку за кілька країн на південь звідси. Місцину розірвало на шмаття. знайшли її в будинку, руду та злющу.",shape=box,color=blue];
		j1600362819 -> j4057079773;
	j89129379 [label="PapaPolar: це рахується?",shape=box,color=blue];
		j89129379 -> j769003767;
		j89129379 -> j1241471573;
	j4057079773 [label="PapaPolar: шість разів намагалася заколоти мене ложкою, хахаха. таке миле видовище було.",shape=box,color=blue];
		j4057079773 -> j92674828;
	j769003767 [label="Так, не схоже, що ви досі разом.",shape=box,color=red];
		j769003767 -> j1278218705;
	j1241471573 [label="Гадаю, це пояснює суперечки.",shape=box,color=red];
		j1241471573 -> j3957924213;
	j92674828 [label="PapaPolar: у неї був такий малий плюшевий кролик, вона його не відпускала. М сказала їй, що захищатиме його ціною свого життя.",shape=box,color=blue];
		j92674828 -> j3557640811;
	j1278218705 [label="PapaPolar: що нас видало?",shape=box,color=blue];
		j1278218705 -> j3957924213;
	j3957924213 [label="PapaPolar: коли несі пішла до «скальдри»… між нами все змінилося. гадаю, то була остання крапля.",shape=box,color=blue];
		j3957924213 -> j1838457368;
	j3557640811 [label="PapaPolar: це миттєво завоювало довіру несі. вона підбігла до М і обійняла її. тоді ми пішли зі служби. офіційно. стали «радниками».",shape=box,color=blue];
		j3557640811 -> j261163043;
	j1838457368 [label="PapaPolar: трясця.",shape=box,color=blue];
		j1838457368 -> j2860513951;
	j261163043 [label="PapaPolar: тож… так. можна сказати, ми виростили її.",shape=box,color=blue];
		j261163043 -> j2860513951;
	j2860513951 [label="PapaPolar: гаразд, пішов робити те, у чому я дока.",shape=box,color=blue];
		j2860513951 -> j25694476;
	j25694476 [label="PapaPolar: удаватиму, що вважаю свої слова помилкою і що цього не повториться в майбутньому.",shape=box,color=blue];
		j25694476 -> j2017522426;
	j2017522426 [label="+20 Chemistry",color=orange];
