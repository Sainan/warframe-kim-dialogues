digraph {
	0 [label="MinVelRank1Convo1 begins.",color=orange];
		0 -> 1;
	1 [label="MomToxicated: Що з нею сталося? Мені потрібні відповіді.",shape=box,color=blue];
		1 -> 2;
	2 [label="MomToxicated: Справжні відповіді. І ніякого лайна типу «це важко пояснити», які мені дають інші.",shape=box,color=blue];
		2 -> 3;
		2 -> 4;
		2 -> 5;
		2 -> 6;
	3 [label="Ха.",shape=box,color=red];
		3 -> 7;
	4 [label="Привіт?",shape=box,color=red];
		4 -> 7;
	5 [label="Ем.",shape=box,color=red];
		5 -> 7;
	6 [label="А це?..",shape=box,color=red];
		6 -> 7;
	7 [label="PapaPolar: не треба так. почни з «привіт, як воно?».",shape=box,color=blue];
		7 -> 8;
	8 [label="PapaPolar: вибачай, дружаньо. коли М бачить ціль, вона пре вперед.",shape=box,color=blue];
		8 -> 9;
	9 [label="MomToxicated: І не треба МЕНЕ ганьбити.",shape=box,color=blue];
		9 -> 10;
	10 [label="PapaPolar: так я ж нє?",shape=box,color=blue];
		10 -> 11;
	11 [label="MomToxicated: Ха. Так. Звичайно. Так само як і в Ялчеську.",shape=box,color=blue];
		11 -> 12;
		11 -> 13;
	12 [label="Гадаю, ви Мінерва та Велимир?",shape=box,color=red];
		12 -> 14;
	13 [label="Так… А ми можемо почати спочатку, будь ласка? Що тут відбувається?",shape=box,color=red];
		13 -> 15;
	14 [label="PapaPolar: так. вибач. привіт. мене, мабуть, легко вгадати, еге? хех",shape=box,color=blue];
		14 -> 16;
	15 [label="PapaPolar: хах. вибач, дружаньо. велимир. а ота MomToxicated — мінерва.",shape=box,color=blue];
		15 -> 17;
	16 [label="PapaPolar: ота MomToxicated — мінерва.",shape=box,color=blue];
		16 -> 17;
	17 [label="MomToxicated: ВЕЛИМИРЕ. У чому СЕНС використання цього ресурсу, якщо ТИ ПРОСТО…",shape=box,color=blue];
		17 -> 18;
	18 [label="MomToxicated: ТА ТРЯСЦЯ.",shape=box,color=blue];
		18 -> 19;
	19 [label="PapaPolar: М, заспокойся. процес виключення. скільки таких розумних нас, фріків, може бути в цій системі?",shape=box,color=blue];
		19 -> 20;
		19 -> 21;
		19 -> 22;
	20 [label="У мене таке відчуття, що з часом їх буде ставати дедалі більше.",shape=box,color=red];
		20 -> 23;
	21 [label="Може ви двоє спочатку розберетеся між собою, а *потім* поговорите зі мною?",shape=box,color=red];
		21 -> 24;
	22 [label="Ви мене геть заплутали.",shape=box,color=red];
		22 -> 25;
	23 [label="Update boolean VelimirFamily1",color=orange];
		23 -> 26;
	24 [label="PapaPolar: боюся, довгенько тобі доведеться чекати. хах.",shape=box,color=blue];
		24 -> 27;
	25 [label="PapaPolar: ну, якщо *тебе* заплутали, то нам гайки. хах!",shape=box,color=blue];
		25 -> 28;
	26 [label="+5 Chemistry",color=orange];
		26 -> 29;
	27 [label="PapaPolar: якщо коротко. у М є питання, на які вона хоче відповіді. від тебе.",shape=box,color=blue];
		27 -> 30;
	28 [label="PapaPolar: бо ми саме до тебе прийшли по відповіді.",shape=box,color=blue];
		28 -> 30;
	29 [label="PapaPolar: і я дуже на то сподіваюся. більша купа — більше гупа. як колись казали, секти й релігії відрізняються лише числом, хаха.",shape=box,color=blue];
		29 -> 31;
	30 [label="PapaPolar: ось. М, так ліпше? більше пасує твоїй грі в хорошого й поганого поліцейського?",shape=box,color=blue];
		30 -> 32;
	31 [label="PapaPolar: так же казали? ",shape=box,color=blue];
		31 -> 33;
	32 [label="MomToxicated: Соле всевишній, я зараз закричу…",shape=box,color=blue];
		32 -> 34;
		32 -> 35;
		32 -> 36;
	33 [label="PapaPolar: не знаю. але ти розумієш. водичка хороша, усі всередині, наскільки я бачу. ну, якось так.",shape=box,color=blue];
		33 -> 27;
	34 [label="Чому в мене таке відчуття, наче мене допитують?",shape=box,color=red];
		34 -> 37;
	35 [label="Що ж. Ем. Я не хочу, щоб ви «грали» в розмову зі мною.",shape=box,color=red];
		35 -> 38;
	36 [label="То які у вас питання? Я допоможу, якщо зможу.",shape=box,color=red];
		36 -> 39;
	37 [label="MomToxicated: Ані слова, Велимире.",shape=box,color=blue];
		37 -> 40;
	38 [label="MomToxicated: Це що завгодно, але тільки не гра.",shape=box,color=blue];
		38 -> 41;
	39 [label="MomToxicated: Твоя співпраця була відзначена, «мандрівниче».",shape=box,color=blue];
		39 -> 42;
	40 [label="PapaPolar: :-X",shape=box,color=blue];
		40 -> 43;
	41 [label="MomToxicated: Ти будеш відповідати на мої запитання? Так чи ні?",shape=box,color=blue];
		41 -> 44;
		41 -> 45;
	42 [label="MomToxicated: Якщо це твоє справжнє ім'я.",shape=box,color=blue];
		42 -> 46;
	43 [label="MomToxicated: Це як мати справу з… А, байдуже. Це не має значення.",shape=box,color=blue];
		43 -> 41;
	44 [label="Ні, вибач. Мені не подобається ваше ставлення, пані.",shape=box,color=red];
		44 -> 47;
	45 [label="Добре, згода. То в чому річ?",shape=box,color=red];
		45 -> 39;
	46 [label="PapaPolar: (не думаю, що нам судити.)",shape=box,color=blue];
		46 -> 48;
	47 [label="MomToxicated: Хибна відповідь. Я дам тобі трохи часу подумати та передумати.",shape=box,color=blue];
