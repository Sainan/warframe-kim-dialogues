		j3026709673 -> j2352786840;
		j3026709673 -> j3570960153;
	j2990297480 [label="PapaPolar: ніхто таке не любив хороші погані історії, як вона",shape=box,color=blue];
		j2990297480 -> j4140246709;
	j4140246709 [label="MomToxicated: І ще ми привозили їй якісь дрібнички. Неважливо, що це було.",shape=box,color=blue];
		j4140246709 -> j3451339948;
	j3451339948 [label="MomToxicated: Але для неї це був шматочок історії. Спогад про неї. І вона додавалася до колекції.",shape=box,color=blue];
