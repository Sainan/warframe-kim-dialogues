		j2070971281 -> j4003881081;
	j1682352988 [label="Це твої слова.",shape=box,color=red];
		j1682352988 -> j4003881081;
	j2547296492 [label="MomToxicated: А вона придбала тобі запальничку.",shape=box,color=blue];
		j2547296492 -> j153826141;
	j3905781553 [label="PapaPolar: як гадаєш, чому я стільки історій розповідаю?",shape=box,color=blue];
		j3905781553 -> j4023202994;
	j4003881081 [label="PapaPolar: це вона в маму, точно. але в ній і радості стільки ж.",shape=box,color=blue];
		j4003881081 -> j3905781553;
	j153826141 [label="MomToxicated: Немає нічого смішнішого, ніж маленька 12-річна дівчинка, яка підходить до прилавка, ляскає запальничкою об прилавок і зиркає на касира.",shape=box,color=blue];
		j153826141 -> j1320164492;
	j4023202994 [label="PapaPolar: це з нею стало звичкою. вона обожнювала їх. завжди хотіла знати, чим ми з М займалися",shape=box,color=blue];
		j4023202994 -> j309146982;
	j1320164492 [label="MomToxicated: А потім серйозно вимагала, щоб на ній було вигравіювано саме те, що вона хотіла.",shape=box,color=blue];
		j1320164492 -> j1118839468;
		j1320164492 -> j3643014964;
	j309146982 [label="PapaPolar: але я розповідав їй різне, але не про те, де ми були насправді",shape=box,color=blue];
		j309146982 -> j3315193861;
	j1118839468 [label="Вона взагалі сміялася в дитинстві? Ну, тобто по-справжньому. Не злостивим сміхом.",shape=box,color=red];
		j1118839468 -> j342215670;
	j3643014964 [label="Можу собі уявити.",shape=box,color=red];
		j3643014964 -> j859864621;
	j3315193861 [label="PapaPolar: і наскільки все йшло кепсько",shape=box,color=blue];
		j3315193861 -> j999818707;
	j342215670 [label="PapaPolar: жартуєш? увесь час! несі любила сміятися.",shape=box,color=blue];
		j342215670 -> j3570960153;
		j342215670 -> j2352786840;
	j859864621 [label="PapaPolar: це вона в маму, точно. але в ній і радості стільки ж.",shape=box,color=blue];
		j859864621 -> j3026709673;
	j999818707 [label="PapaPolar: а вона просто сиділа й сміялася",shape=box,color=blue];
		j999818707 -> j2990297480;
