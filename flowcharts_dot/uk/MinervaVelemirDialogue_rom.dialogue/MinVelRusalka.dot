	1919 [label="MomToxicated: «Коли Сол і Луа порівняються, загублені знайдуть шлях додому» — фраза у відповідь.",shape=box,color=blue];
		1919 -> 1920;
	1920 [label="MomToxicated: *Її* половина.",shape=box,color=blue];
		1920 -> 1921;
		1920 -> 1922;
	1921 [label="Але, як ти кажеш, Мінерво, ми не впевнені, що це вона. Байдужість знає все, що вона знає.",shape=box,color=red];
		1921 -> 1923;
