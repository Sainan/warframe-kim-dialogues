		1912 -> 1915;
	1914 [label="PapaPolar: це те, що я просив тебе сказати нашій дівчинці, якщо побачиш її.",shape=box,color=blue];
		1914 -> 1913;
	1915 [label="PapaPolar: ти розумієш…",shape=box,color=blue];
		1915 -> 1916;
	1913 [label="PapaPolar: це була половина кодової фрази. так ми починали телефонну розмову, щоб знати, що лінія захищена і нам безпечно говорити.",shape=box,color=blue];
		1913 -> 1917;
	1916 [label="PapaPolar: ми мали кодову фразу. так ми починали телефонну розмову, щоб знати, що лінія захищена і нам безпечно говорити.",shape=box,color=blue];
		1916 -> 1917;
