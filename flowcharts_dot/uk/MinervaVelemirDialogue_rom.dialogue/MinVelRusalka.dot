		1890 -> 1891;
	1894 [label="MomToxicated: Це де дитина-диктатор постійно тебе вбивала?",shape=box,color=blue];
		1894 -> 1895;
		1894 -> 1896;
	1891 [label="Я… не знаю. Не думаю, що так. Але давайте я розповім що знаю, а ви вирішите.",shape=box,color=red];
		1891 -> 1892;
	1895 [label="Ну, як виявилося, це був для нього процес дорослішання. Але річ не в тім…",shape=box,color=red];
		1895 -> 1897;
	1896 [label="Ага, саме туди.",shape=box,color=red];
		1896 -> 1897;
	1897 [label="Несі… захопила трон. Шепіт — не вдалося підібрати ліпше слово для армії Байдужості — вдерся туди, і Несі перемогла.",shape=box,color=red];
		1897 -> 1898;
	1898 [label="MomToxicated: Хех, моя дівчинка.",shape=box,color=blue];
		1898 -> 1899;
