		1922 -> 1924;
	1923 [label="MomToxicated: Але для чого їй намагатися дати нам промінь надії? Хіба що просто зробити боляче.",shape=box,color=blue];
		1923 -> 1925;
	1924 [label="MomToxicated: Може, для хибної надії? Щоб зробити нам боляче?",shape=box,color=blue];
