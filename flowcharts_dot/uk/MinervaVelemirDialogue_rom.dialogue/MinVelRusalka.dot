		1943 -> 1944;
	1941 [label="PapaPolar: але вона впорається. або її нема, або вони дійшли згоди, або це вже вона тримає його в полоні. хех",shape=box,color=blue];
		1941 -> 1945;
	1945 [label="MomToxicated: Я все ж гадаю, що послання справжнє. І воно від нашої дівчинки. Вона каже… що вона все ще десь там.",shape=box,color=blue];
