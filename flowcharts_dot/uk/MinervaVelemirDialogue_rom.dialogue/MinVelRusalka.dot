		1903 -> 1904;
	1904 [label="MomToxicated: Загадки й дивні повідомлення? Ти тепер з нами на одній хвилі.",shape=box,color=blue];
		1904 -> 1905;
	1905 [label="PapaPolar: 1-800-шпигунська-срань, ви звернулися за адресою",shape=box,color=blue];
		1905 -> 1906;
