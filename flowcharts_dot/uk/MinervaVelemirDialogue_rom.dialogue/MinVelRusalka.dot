	"MinVelRusalka begins." [color=orange];
		"MinVelRusalka begins." -> j1138299529;
	j1138299529 [label="Check boolean VelimirEclipse",color=orange];
		j1138299529 -> j392677634 [label=true,color=green];
		j1138299529 -> "Chat ends." [label=false,color=brown];
	j392677634 [label="Check /Lotus/Scripts/1999/DialogueScriptNodes.lua:CheckDuviriMitwCollectibles(collectibleType=/Lotus/Types/Lore/Fragments/DuviriMITWFragments/DuviriMITWCollectibleDeco)",color=orange];
		j392677634 -> j1140089747 [label=true,color=green];
		j392677634 -> "Chat ends." [label=false,color=brown];
	"Chat ends." [color=orange];
	j1140089747 [label="Ем… народ?",shape=box,color=red];
		j1140089747 -> j2914156129;
	j2914156129 [label="MomToxicated: Так?",shape=box,color=blue];
		j2914156129 -> j338676562;
	j338676562 [label="PapaPolar: що таке, друже?",shape=box,color=blue];
		j338676562 -> j1432477334;
		j338676562 -> j3880853140;
		j338676562 -> j434716221;
	j1432477334 [label="Маю гарні й погані новини. Щодо Несі.",shape=box,color=red];
		j1432477334 -> j1970255439;
	j3880853140 [label="Я хочу, щоб ви не покидали надії. Маю новини про Несі, але вони… двоякі. І непереконливі.",shape=box,color=red];
		j3880853140 -> j289743764;
	j434716221 [label="Це… а, не зважайте. [Завершити розмову]",shape=box,color=red];
		j434716221 -> "Chat ends.";
	j1970255439 [label="PapaPolar: давай по-дорослому. починай із поганих.",shape=box,color=blue];
		j1970255439 -> j718784654;
	j289743764 [label="+5 Chemistry",color=orange];
		j289743764 -> j2189729440;
	j718784654 [label="MomToxicated: Згодна. Ліпше завжди починати з поганих.",shape=box,color=blue];
		j718784654 -> j1148060814;
	j2189729440 [label="MomToxicated: Як і все в цьому життя загалом. Але дякую за попередження.",shape=box,color=blue];
		j2189729440 -> j4106810078;
	j1148060814 [label="Тож… Байдужість пішла в Дувірі… і забрала Несі із собою.",shape=box,color=red];
		j1148060814 -> j52797528;
	j4106810078 [label="+5 Chemistry",color=orange];
		j4106810078 -> j510280537;
	j52797528 [label="PapaPolar: стривай… стривай… у ту книжково-вимірну штуку?",shape=box,color=blue];
		j52797528 -> j3689383108;
	j510280537 [label="PapaPolar: готуюся почути, але схоже… вона принаймні не мертва?",shape=box,color=blue];
		j510280537 -> j2315699559;
	j3689383108 [label="MomToxicated: Це де дитина-диктатор постійно тебе вбивала?",shape=box,color=blue];
		j3689383108 -> j3097180565;
		j3689383108 -> j1900846;
	j2315699559 [label="Я… не знаю. Не думаю, що так. Але давайте я розповім що знаю, а ви вирішите.",shape=box,color=red];
		j2315699559 -> j1148060814;
	j3097180565 [label="Ну, як виявилося, це був для нього процес дорослішання. Але річ не в тім…",shape=box,color=red];
		j3097180565 -> j3139498769;
	j1900846 [label="Ага, саме туди.",shape=box,color=red];
		j1900846 -> j3139498769;
	j3139498769 [label="Несі… захопила трон. Шепіт — не вдалося підібрати ліпше слово для армії Байдужості — вдерся туди, і Несі перемогла.",shape=box,color=red];
		j3139498769 -> j4151106495;
	j4151106495 [label="MomToxicated: Хех, моя дівчинка.",shape=box,color=blue];
		j4151106495 -> j1585591364;
	j1585591364 [label="PapaPolar: а це була вона? чи та штука, тільки з її обличчями?",shape=box,color=blue];
		j1585591364 -> j1622951260;
		j1585591364 -> j1524657037;
	j1622951260 [label="Не знаю.",shape=box,color=red];
		j1622951260 -> j1418107813;
	j1524657037 [label="Саме це й хочу обговорити…",shape=box,color=red];
		j1524657037 -> j1418107813;
	j1418107813 [label="Ось є записи. Спочатку вони розчарували мене. Але потім вдалося скласти їх докупи і… вийшло отримати повідомлення.",shape=box,color=red];
		j1418107813 -> j3533799673;
	j3533799673 [label="Мені цікаво, чи для вас воно має сенс.",shape=box,color=red];
		j3533799673 -> j2210451043;
	j2210451043 [label="MomToxicated: Загадки й дивні повідомлення? Ти тепер з нами на одній хвилі.",shape=box,color=blue];
		j2210451043 -> j1054709201;
	j1054709201 [label="PapaPolar: 1-800-шпигунська-срань, ви звернулися за адресою",shape=box,color=blue];
		j1054709201 -> j1241074383;
	j1241074383 [label="«Коли Сол і Луа порівняються, загублені знайдуть шлях додому».",shape=box,color=red];
		j1241074383 -> j3135347244;
	j3135347244 [label="PapaPolar: … трясця. М. ТРЯСЦЯ.",shape=box,color=blue];
		j3135347244 -> j605519627;
	j605519627 [label="MomToxicated: Не ведись. Якщо ця штука в неї в голові, вона знає все, що знає Несі.",shape=box,color=blue];
		j605519627 -> j4023219929;
		j605519627 -> j1564935720;
	j4023219929 [label="Що? Що це значить?",shape=box,color=red];
		j4023219929 -> j152391431;
	j1564935720 [label="Це друга половина, так?",shape=box,color=red];
		j1564935720 -> j2115654898;
	j152391431 [label="PapaPolar: «На порожньому перехресті затемнення шукай».",shape=box,color=blue];
		j152391431 -> j123005510;
	j2115654898 [label="+5 Chemistry",color=orange];
		j2115654898 -> j1108774680;
	j123005510 [label="PapaPolar: це те, що я просив тебе сказати нашій дівчинці, якщо побачиш її.",shape=box,color=blue];
		j123005510 -> j352498515;
	j1108774680 [label="PapaPolar: ти розумієш…",shape=box,color=blue];
		j1108774680 -> j1862584650;
	j352498515 [label="PapaPolar: це була половина кодової фрази. так ми починали телефонну розмову, щоб знати, що лінія захищена і нам безпечно говорити.",shape=box,color=blue];
		j352498515 -> j3410413185;
	j1862584650 [label="PapaPolar: ми мали кодову фразу. так ми починали телефонну розмову, щоб знати, що лінія захищена і нам безпечно говорити.",shape=box,color=blue];
		j1862584650 -> j3410413185;
	j3410413185 [label="MomToxicated: І що ми… це ми.",shape=box,color=blue];
		j3410413185 -> j462123916;
	j462123916 [label="PapaPolar: «На порожньому перехресті затемнення шукай» — наша половина фрази.",shape=box,color=blue];
		j462123916 -> j3299732777;
	j3299732777 [label="MomToxicated: «Коли Сол і Луа порівняються, загублені знайдуть шлях додому» — фраза у відповідь.",shape=box,color=blue];
		j3299732777 -> j3071741873;
	j3071741873 [label="MomToxicated: *Її* половина.",shape=box,color=blue];
		j3071741873 -> j2151097404;
		j3071741873 -> j2097246132;
	j2151097404 [label="Але, як ти кажеш, Мінерво, ми не впевнені, що це вона. Байдужість знає все, що вона знає.",shape=box,color=red];
		j2151097404 -> j2390809543;
	j2097246132 [label="Не знаю, для чого Байдужості передавати вам таке…",shape=box,color=red];
		j2097246132 -> j2988140390;
	j2390809543 [label="MomToxicated: Але для чого їй намагатися дати нам промінь надії? Хіба що просто зробити боляче.",shape=box,color=blue];
		j2390809543 -> j752520288;
	j2988140390 [label="MomToxicated: Може, для хибної надії? Щоб зробити нам боляче?",shape=box,color=blue];
		j2988140390 -> j1098920282;
	j752520288 [label="PapaPolar: а тобі боляче?",shape=box,color=blue];
		j752520288 -> j1508500427;
	j1098920282 [label="PapaPolar: а вона хибна? і чи тобі боляче?",shape=box,color=blue];
		j1098920282 -> j1508500427;
	j1508500427 [label="PapaPolar: чи це більше схоже на умиротворення? знаючи, що наша дівчинка жива?",shape=box,color=blue];
		j1508500427 -> j2529344545;
	j2529344545 [label="PapaPolar: що попри все, вона все ще надирає зади й здобуває ім’я?",shape=box,color=blue];
		j2529344545 -> j4226262847;
	j4226262847 [label="PapaPolar: навіть якщо не з нами?",shape=box,color=blue];
		j4226262847 -> j1720481291;
	j1720481291 [label="PapaPolar: не знаю, як тобі, але це гріє моє серце.",shape=box,color=blue];
		j1720481291 -> j1025584146;
	j1025584146 [label="PapaPolar: і щось мені підказує, що це не зовсім те, чим та байдужість зазвичай займається",shape=box,color=blue];
		j1025584146 -> j3481843026;
	j3481843026 [label="MomToxicated: Маєш рацію. Чути цю фразу й розуміти, що вона *може* бути десь там — не боляче.",shape=box,color=blue];
		j3481843026 -> j3094571818;
	j3094571818 [label="MomToxicated: Я пишаюся нею.",shape=box,color=blue];
		j3094571818 -> j4112895754;
		j3094571818 -> j3812932477;
		j3094571818 -> j2493142890;
	j4112895754 [label="Навіть якщо вона все ще в полоні Байдужості?",shape=box,color=red];
		j4112895754 -> j1806062461;
	j3812932477 [label="Навіть якщо це вигадка Байдужості?",shape=box,color=red];
		j3812932477 -> j132728319;
	j2493142890 [label="Вона може з власної волі працювати з Байдужістю.",shape=box,color=red];
		j2493142890 -> j2166193876;
	j1806062461 [label="PapaPolar: вона міцна, як цвяхи у величезному блоці з титанового сплаву",shape=box,color=blue];
		j1806062461 -> j4104957899;
	j132728319 [label="MomToxicated: Для чого? Що вона матиме з цього від нас?",shape=box,color=blue];
		j132728319 -> j1422442950;
	j2166193876 [label="MomToxicated: Тоді вона вибрала одного з найліпших союзників у світі. Вона вибрала сторону. Як і ми.",shape=box,color=blue];
		j2166193876 -> j1612099927;
	j4104957899 [label="PapaPolar: і зуб даю, що та «людина в стіні» знала це, і саме тому захопила несі",shape=box,color=blue];
		j4104957899 -> j3887133526;
	j1422442950 [label="PapaPolar: ми для нього дрібна рибка. що зараз для нас найліпше",shape=box,color=blue];
		j1422442950 -> j1533668415;
	j1612099927 [label="MomToxicated: Сподіваюся, ми не дійдемо до прямого двобою. Але якщо так станеться… ми розберемося.",shape=box,color=blue];
		j1612099927 -> j4060268204;
	j3887133526 [label="PapaPolar: але вона впорається. або її нема, або вони дійшли згоди, або це вже вона тримає його в полоні. хех",shape=box,color=blue];
		j3887133526 -> j1533668415;
	j1533668415 [label="MomToxicated: Я все ж гадаю, що послання справжнє. І воно від нашої дівчинки. Вона каже… що вона все ще десь там.",shape=box,color=blue];
		j1533668415 -> j3120262557;
	j4060268204 [label="PapaPolar: вона може про себе подбати. ми її так виховали",shape=box,color=blue];
		j4060268204 -> j1533668415;
	j3120262557 [label="MomToxicated: Певною мірою вона каже, що з нею все гаразд.",shape=box,color=blue];
		j3120262557 -> j2703850406;
	j2703850406 [label="MomToxicated: І що ми можемо не переживати за неї.",shape=box,color=blue];
		j2703850406 -> j584483825;
	j584483825 [label="PapaPolar: хех. навряд це можливо",shape=box,color=blue];
		j584483825 -> j1841545815;
	j1841545815 [label="MomToxicated: Так, це прокляття і благословення батьківства.",shape=box,color=blue];
		j1841545815 -> j1192127338;
	j1192127338 [label="PapaPolar: мандрівниче, а тобі хотілося мати дітей? ем, можеш не відповідати. знову буде якась порожнечна маячня, яку я не хочу чути.",shape=box,color=blue];
		j1192127338 -> j4144499420;
		j1192127338 -> j4158706102;
		j1192127338 -> j2580615333;
	j4144499420 [label="Треба випити? Треба випити.",shape=box,color=red];
		j4144499420 -> j2649580632;
	j4158706102 [label="Гарна спроба.",shape=box,color=red];
		j4158706102 -> j4071550381;
	j2580615333 [label="<RETRO_EMOJI_OHNO>",shape=box,color=red];
		j2580615333 -> j2097489200;
	j2649580632 [label="+5 Chemistry",color=orange];
		j2649580632 -> j700155271;
	j4071550381 [label="PapaPolar: ого, це не схоже на щасливо-щасливу усмішку. радше меланхолійно-щаслива",shape=box,color=blue];
		j4071550381 -> j385798273;
	j2097489200 [label="MomToxicated: Це гарна відповідь. Хех. Може хильнемо трохи, що скажете?",shape=box,color=blue];
		j2097489200 -> j4080968924;
	j700155271 [label="MomToxicated: От тепер ми точно на одній хвилі.",shape=box,color=blue];
		j700155271 -> j385798273;
	j385798273 [label="PapaPolar: я б хильнув чарку-другу й розповів кілька хороших історій про нашу дівчинку",shape=box,color=blue];
		j385798273 -> j1922978638;
	j4080968924 [label="PapaPolar: оце вже діло",shape=box,color=blue];
		j4080968924 -> j385798273;
	j1922978638 [label="MomToxicated: І мандрівниче, слухай… Дякую. Знову. За все, що ти робиш.",shape=box,color=blue];
		j1922978638 -> j3737530381;
	j3737530381 [label="PapaPolar: так, серйозно, дружаньо. не знаю, чи колись ми зможемо віддячити тобі. але якщо буде нагода — ми віддячимо.",shape=box,color=blue];
		j3737530381 -> j110581365;
	j110581365 [label="PapaPolar: ти тепер в нашій родині, подобається це тобі чи ні. 8-)",shape=box,color=blue];
		j110581365 -> "Chat ends.";
}