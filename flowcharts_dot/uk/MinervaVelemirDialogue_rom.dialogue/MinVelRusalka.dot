		1899 -> 1900;
		1899 -> 1901;
	1900 [label="Не знаю.",shape=box,color=red];
		1900 -> 1902;
	1901 [label="Саме це й хочу обговорити…",shape=box,color=red];
		1901 -> 1902;
	1902 [label="Ось є записи. Спочатку вони розчарували мене. Але потім вдалося скласти їх докупи і… вийшло отримати повідомлення.",shape=box,color=red];
		1902 -> 1903;
