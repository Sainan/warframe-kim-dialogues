	1888 [label="MomToxicated: Згодна. Ліпше завжди починати з поганих.",shape=box,color=blue];
		1888 -> 1892;
	1887 [label="MomToxicated: Як і все в цьому життя загалом. Але дякую за попередження.",shape=box,color=blue];
