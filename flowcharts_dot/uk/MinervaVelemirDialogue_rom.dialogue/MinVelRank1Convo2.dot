		j2029846215 -> j1615350431;
	j3222607082 [label="Відповідальність за те, що з нею сталося, лежить на всемогутньому непізнаному богові Порожнечі. Ти хочеш побитися з ним? Будь ласка, ставай у чергу.",shape=box,color=red];
		j3222607082 -> j3465366498;
	j3394568830 [label="І так, і ні. Слухай, їй у голову ніхто не стріляв. Принаймні не я. Ні. Навіть, коли була нагода… Гм… ну, були ракети, але річ не в тім.",shape=box,color=red];
		j3394568830 -> j3465366498;
	j1615350431 [label="Те, що з нею сталося, дуже складно, пані. І мені не подобається твій тон.",shape=box,color=red];
		j1615350431 -> j3465366498;
	j3465366498 [label="Одним словом — я не маю до неї претензій, і я докладаю зусиль, щоб тримати тут усе під контролем.",shape=box,color=red];
		j3465366498 -> j1126834702;
		j3465366498 -> j3408457026;
		j3465366498 -> j940299399;
