		j940299399 -> j1992557261;
	j1992557261 [label="MomToxicated: Якщо ти чекаєш, що я сидітиму рівно з пальцем у сра…",shape=box,color=blue];
		j1992557261 -> j1782017448;
	j1782017448 [label="PapaPolar: агов, М, тихше.",shape=box,color=blue];
		j1782017448 -> j1649833434;
