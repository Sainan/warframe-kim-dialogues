		j2370699354 -> j1052074653;
	j448631868 [label="Я розумію. Проблема подвоюється з військовим минулим.",shape=box,color=red];
		j448631868 -> j1673019420;
	j164253475 [label="Я починаю звикати, що люди на мене кидаються. Нічого страшного.",shape=box,color=red];
		j164253475 -> j2999565522;
	j1052074653 [label="Ну, це не виправдання, щоб так поводитися.",shape=box,color=red];
