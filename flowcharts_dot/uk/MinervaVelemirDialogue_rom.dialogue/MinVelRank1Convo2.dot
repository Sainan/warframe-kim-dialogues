	j1673019420 [label="+5 Chemistry",color=orange];
		j1673019420 -> j3930709758;
	j2999565522 [label="PapaPolar: знову ж, це легко, коли люди налякані. здебільшого люди поводяться як засранчики в цьому світі, і це зводиться до двох речей:",shape=box,color=blue];
		j2999565522 -> j2786812777;
	j1995004859 [label="PapaPolar: ні, ти маєш рацію на 100 %. але люди такі люди, і ми їх любимо все одно. і іноді навіть пробачаємо.",shape=box,color=blue];
