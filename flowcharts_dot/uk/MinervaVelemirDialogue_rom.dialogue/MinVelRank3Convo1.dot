		j1594605981 -> j3189585286;
	j3189585286 [label="PapaPolar: ну, коротше, ось ми.",shape=box,color=blue];
		j3189585286 -> j2622350039;
	j2622350039 [label="PapaPolar: коли раптом [ВИДАЛЕНО] заходить у бар. Він витягує цей НЕРЕАЛЬНО ВЕЛИКИЙ, і я серйозно, то був просто ЗДОРОВЕЗНИЙ [ВИДАЛЕНО]",shape=box,color=blue];
		j2622350039 -> j3061093778;
	j3061093778 [label="PapaPolar: а я такий ЗАБИРАЙТЕСЯ, ПОКИ [ВИДАЛЕНО] НЕ [ВИДАЛЕНО]!!!",shape=box,color=blue];
		j3061093778 -> j301315674;
	j301315674 [label="PapaPolar: [ВИДАЛЕНО] продовжує вилазити. Просто вбік. [ВИДАЛЕНО] скрізь… просто [ВИДАЛЕНО]…",shape=box,color=blue];
		j301315674 -> j1333214506;
