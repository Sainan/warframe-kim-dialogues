		j4179160502 -> j3369948466;
	j1211707571 [label="Чекайте, чекайте, чекайте. У вас є конференції для міжнародних шпигунів?!",shape=box,color=red];
		j1211707571 -> j4157626763;
	j3369948466 [label="PapaPolar: якщо скажу, то доведеться тебе вбити B-)",shape=box,color=blue];
		j3369948466 -> j4195524458;
	j4157626763 [label="MomToxicated: Кожна галузь має конференцію… добре це чи погано. І всі вони однаково нудні, незалежно від сфери діяльності.",shape=box,color=blue];
		j4157626763 -> j3481958950;
	j4195524458 [label="MomToxicated: Тож оскільки Велимир уже порушив протокол, можна зіпсувати й решту. «Міжнародна асоціація культурного лідерства та консалтингу».",shape=box,color=blue];
		j4195524458 -> j328172540;
	j3481958950 [label="MomToxicated: Тож оскільки Велимир уже порушив протокол, можна зіпсувати й решту. «Міжнародна асоціація культурного лідерства та консалтингу».",shape=box,color=blue];
		j3481958950 -> j798654220;
	j328172540 [label="PapaPolar: тобто шпигуни. конференція для шпигунів. нудна до всирачки.",shape=box,color=blue];
		j328172540 -> j3679018672;
