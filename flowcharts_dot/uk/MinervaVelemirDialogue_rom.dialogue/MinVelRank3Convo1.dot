		j2763686907 -> j2301412990;
	j3152033744 [label="PapaPolar: справжня історія нудніша. ми зустрілися на конференції.",shape=box,color=blue];
		j3152033744 -> j2878355583;
	j2878355583 [label="MomToxicated: Якщо ти збираєшся *знову* розголошувати конфіденційну інформацію, Велимире, принаймні не кажи де саме, добре?",shape=box,color=blue];
		j2878355583 -> j2857878076;
	j2857878076 [label="MomToxicated: Оскільки конференція була саме про те, щоб не робити саме цього, і ти можеш видати розташування всіх на ній присутніх.",shape=box,color=blue];
		j2857878076 -> j3477607838;
	j3477607838 [label="PapaPolar: так, так. усе одно це історії ніяк не стосується.",shape=box,color=blue];
		j3477607838 -> j4179160502;
		j3477607838 -> j1211707571;
