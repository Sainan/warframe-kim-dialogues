		j3164596850 -> j1253941154;
	j1253941154 [label="PapaPolar: тож ось я роблю собі КРУТЕЦЬКИЙ старомодний… ну серйозно, хто взагалі кладе коктейльний лід у старомодний. люди, що з вами не так… ",shape=box,color=blue];
		j1253941154 -> j195281249;
