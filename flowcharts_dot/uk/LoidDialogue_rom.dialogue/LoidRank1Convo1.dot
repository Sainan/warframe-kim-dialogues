digraph {
	0 [label="LoidRank1Convo1 begins.",color=orange];
		0 -> 1;
	1 [label="Мандрівниче. Пробачте мені за недоречне втручання, я ніколи б не бажав звертатися до вас за допомогою цього пристрою. Але сталася дещо надзвичайна ситуація, і я не знаю, до кого б можна було звернутися.",shape=box,color=blue];
		1 -> 2;
		1 -> 3;
	2 [label="ПОМ2_ЛАБ1?",shape=box,color=red];
		2 -> 4;
	3 [label="Хто це?..",shape=box,color=red];
		3 -> 4;
	4 [label="О, так, перепрошую. Типові налаштування. Це Лойд. Я мав би… почати з цього, але у святилищі Анатоміка наразі дуже все хаотично.",shape=box,color=blue];
		4 -> 5;
	5 [label="Саме тому я й пишу вам. Мені вкрай потрібна допомога. Сюди прибуло три протофрейма. У святилище. У мій час. І це не ті, про кого ми знали раніше.",shape=box,color=blue];
		5 -> 6;
	6 [label="Один із них…",shape=box,color=blue];
		6 -> 7;
	7 [label="Я перепрошую…",shape=box,color=blue];
		7 -> 8;
	8 [label="Мандрівниче, один із них — орокін.",shape=box,color=blue];
		8 -> 9;
		8 -> 10;
		8 -> 11;
	9 [label="Де Лотос?",shape=box,color=red];
		9 -> 12;
	10 [label="Що, ні… ",shape=box,color=red];
		10 -> 13;
	11 [label="ЩО?!",shape=box,color=red];
		11 -> 13;
	12 [label="Повірте, Лотос з оператором наразі мають інші справи. Вони заклопотані вже на межі можливого. Я не просив би вас про допомогу в цій справі, якби відчував, що можу звернутися ще до когось.",shape=box,color=blue];
		12 -> 14;
	13 [label="Я не просив би вас про допомогу в цій справі, якби відчував, що можу звернутися ще до когось. Бо ви… з усієї наявної мені інформації наразі маєте найвищий рівень експертності в подібному.",shape=box,color=blue];
		13 -> 15;
	14 [label="Бо ви… з усієї наявної мені інформації наразі маєте найвищий рівень експертності в подібному.",shape=box,color=blue];
		14 -> 15;
	15 [label="Я не знаю, як ліпше їх описати вам. Але якщо завітаєте до святилища, то навряд пропустите, не маю сумнівів. Двоє з них погодилися поспілкуватися за допомогою ПОМ-2. Для одного ж доведеться знайти додаткові переконливі аргументи.",shape=box,color=blue];
		15 -> 16;
	16 [label="Я… вірю… у ваш успіх.",shape=box,color=blue];
		16 -> 29;
	29 [label="Update boolean LoidTriadAvailable",color=orange];
		29 -> 17;
	17 [label="Chat ends. Next chat will be LoidFamily.",color=orange];
}