	edge [fontname="Roboto Condensed"];

	"LoidRank1Convo1 begins." [color=orange];
		"LoidRank1Convo1 begins." -> j749868744;
	j749868744 [label="Мандрівниче. Пробачте мені за недоречне втручання, я ніколи б не бажав звертатися до вас за допомогою цього пристрою. Але сталася дещо надзвичайна ситуація, і я не знаю, до кого б можна було звернутися.",shape=box,color=blue];
		j749868744 -> j2610664030;
		j749868744 -> j975559113;
	j2610664030 [label="ПОМ2_ЛАБ1?",shape=box,color=red];
		j2610664030 -> j4084838861;
	j975559113 [label="Хто це?..",shape=box,color=red];
		j975559113 -> j4084838861;
	j4084838861 [label="О, так, перепрошую. Типові налаштування. Це Лойд. Я мав би… почати з цього, але у святилищі Анатоміка наразі дуже все хаотично.",shape=box,color=blue];
		j4084838861 -> j4078122191;
	j4078122191 [label="Саме тому я й пишу вам. Мені вкрай потрібна допомога. Сюди прибуло три протофрейма. У святилище. У мій час. І це не ті, про кого ми знали раніше.",shape=box,color=blue];
		j4078122191 -> j1065538420;
	j1065538420 [label="Один із них…",shape=box,color=blue];
		j1065538420 -> j381549316;
	j381549316 [label="Я перепрошую…",shape=box,color=blue];
		j381549316 -> j401663054;
	j401663054 [label="Мандрівниче, один із них — орокін.",shape=box,color=blue];
		j401663054 -> j3548022175;
		j401663054 -> j992261937;
		j401663054 -> j1522204554;
	j3548022175 [label="Де Лотос?",shape=box,color=red];
		j3548022175 -> j4263509528;
	j992261937 [label="Що, ні… ",shape=box,color=red];
		j992261937 -> j936432005;
	j1522204554 [label="ЩО?!",shape=box,color=red];
		j1522204554 -> j936432005;
	j4263509528 [label="Повірте, Лотос з оператором наразі мають інші справи. Вони заклопотані вже на межі можливого. Я не просив би вас про допомогу в цій справі, якби відчував, що можу звернутися ще до когось.",shape=box,color=blue];
		j4263509528 -> j4281923221;
	j936432005 [label="Я не просив би вас про допомогу в цій справі, якби відчував, що можу звернутися ще до когось. Бо ви… з усієї наявної мені інформації наразі маєте найвищий рівень експертності в подібному.",shape=box,color=blue];
		j936432005 -> j144351507;
	j4281923221 [label="Бо ви… з усієї наявної мені інформації наразі маєте найвищий рівень експертності в подібному.",shape=box,color=blue];
		j4281923221 -> j144351507;
	j144351507 [label="Я не знаю, як ліпше їх описати вам. Але якщо завітаєте до святилища, то навряд пропустите, не маю сумнівів. Двоє з них погодилися поспілкуватися за допомогою ПОМ-2. Для одного ж доведеться знайти додаткові переконливі аргументи.",shape=box,color=blue];
		j144351507 -> j1776630377;
	j1776630377 [label="Я… вірю… у ваш успіх.",shape=box,color=blue];
		j1776630377 -> j3173882;
	j3173882 [label="Boolean LoidTriadAvailable is now true.",color=orange];
		j3173882 -> "Chat ends. Next chat will be LoidFamily.";
	"Chat ends. Next chat will be LoidFamily." [color=orange];
}