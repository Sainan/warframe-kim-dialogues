	j116021835 [label="Мандрівниче. Я більше не можу. Роут, Марі та Ліон переконали мене, що час нарешті настав.",shape=box,color=blue];
		j116021835 -> j1966631050;
	"Chat ends." [color=orange];
	j1966631050 [label="Я боюся подальших дій до тремтіння в найменших кісточках. Гадаю, що мене до них і розберуть, шматок за шматком, у нападі люті, коли Ґомайтру та вся родина довідається, що відбувалося весь цей час у них під ногами.",shape=box,color=blue];
		j1966631050 -> j1607890424;
	j1607890424 [label="Так дивно їх тепер називати за іменами, але так багато всього між нами змінилося. Та невдовзі зміниться ще більше.",shape=box,color=blue];
		j1607890424 -> j43434742;
		j1607890424 -> j1474445688;
	j43434742 [label="Це вже давно треба було зробити. Усе буде добре.",shape=box,color=red];
		j43434742 -> j1674530150;
	j1474445688 [label="Ти впораєшся.",shape=box,color=red];
		j1474445688 -> j1674530150;
	j1674530150 [label="Так, що ж. Чи не була б ваша ласка навідатися й простежити, щоб мої нутрощі не використовувалися як святкове оздоблення Некраліска? Боюся, мені потрібна буде деяка додаткова впевненість після того, що я скажу й зроблю.",shape=box,color=blue];
		j1674530150 -> j937202740;
