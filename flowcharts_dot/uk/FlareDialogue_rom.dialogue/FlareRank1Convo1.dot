		j4063256174 -> j248762792;
		j4063256174 -> j871483591;
	j248762792 [label="О, привіт. Ти ж Флер, так?",shape=box,color=red];
		j248762792 -> j3469485266;
	j871483591 [label="Здоров. Як воно?",shape=box,color=red];
		j871483591 -> j2390898814;
	j3469485266 [label="ти ж той науковий експеримент, про який мені розповідали, так?",shape=box,color=blue];
		j3469485266 -> j1585712801;
		j3469485266 -> j961164625;
	j2390898814 [label="та сиджу собі тут і нема чим більше зайнятися. у мене купа питань, якщо маєш час",shape=box,color=blue];
		j2390898814 -> j961545586;
		j2390898814 -> j651189098;
		j2390898814 -> j3837199450;
	j1585712801 [label="Ну, дуже складно уявити, що тут таких двоє. Але. Ну. Це… Усе одно це довга історія.",shape=box,color=red];
		j1585712801 -> j1910703563;
	j961164625 [label="Залежить від того, що саме розповідали. Але, скоріше за все, так.",shape=box,color=red];
		j961164625 -> j577941663;
	j961545586 [label="Нема чим більше зайнятися, й ти вирішуєш постукати по склу вольєра. Дуже мило.",shape=box,color=red];
		j961545586 -> j3319846382;
	j651189098 [label="Серйозно? Нема чим більше зайнятися? Пха. Мені лестить це.",shape=box,color=red];
		j651189098 -> j1632917525;
	j3837199450 [label="Якщо хочеш щось спитати, то вперед. Питай.",shape=box,color=red];
		j3837199450 -> j2386091314;
	j1910703563 [label="ясно. ну. мені основне коротко пояснили.",shape=box,color=blue];
		j1910703563 -> j3689192451;
	j577941663 [label="звісно…",shape=box,color=blue];
