	j1403538092 [label="Чим можу допомогти?",shape=box,color=red];
		j1403538092 -> j433422219;
	j1629205841 [label="ох, соле милий, ти що. ти вибачай, що таке враження вийшло. припускаю, ти маєш рацію. ми — ну протофрейми — не єдині наукові експерименти тут, чи не так?",shape=box,color=blue];
		j1629205841 -> j12514953;
		j1629205841 -> j3582626411;
		j1629205841 -> j1047346970;
	j433422219 [label="зараження. ця гниль. ця штука, що трує мою кров. я маю знати все, що знаєш ти",shape=box,color=blue];
		j433422219 -> j1858829582;
	j34398822 [label="дуже… дуже швидко…",shape=box,color=blue];
