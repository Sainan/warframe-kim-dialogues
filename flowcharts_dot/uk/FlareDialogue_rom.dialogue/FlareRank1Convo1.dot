	j2386091314 [label="чудово",shape=box,color=blue];
		j2386091314 -> j433422219;
	j3689192451 [label="амір… розповів подробиці, скажімо так. доволі швидко.",shape=box,color=blue];
		j3689192451 -> j34398822;
	j559096229 [label="Хочеш постукати по склу вольєра?",shape=box,color=red];
