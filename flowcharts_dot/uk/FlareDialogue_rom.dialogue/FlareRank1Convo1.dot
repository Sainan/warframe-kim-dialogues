		j3334021833 -> j1403538092;
	j3314571694 [label="просвіти мене",shape=box,color=blue];
		j3314571694 -> j762960519;
	j3586359048 [label="і куди він дівся? ентраті? інші запевняють, що не знають. і що ти теж не в курсі",shape=box,color=blue];
		j3586359048 -> j2614251262;
	j2938845082 [label="Щось мені не до вподоби твоє ставлення?",shape=box,color=red];
		j2938845082 -> j1648355081;
	j2004832870 [label="Ем… Це буде надовго і не маю певності, що зможу дати відповіді, які ти хочеш.",shape=box,color=red];
		j2004832870 -> j1897648636;
	j3643440336 [label="Ого, стопе. Здай назад. Ти в нормі?",shape=box,color=red];
		j3643440336 -> j3824427229;
	j3083778269 [label="Агась. Це Квінсі міг сказати.",shape=box,color=red];
		j3083778269 -> j559096229;
		j3083778269 -> j1403538092;
	j762960519 [label="бо я знаю, що в моїй крові трунок, що повільно зводить мене з розуму й нівечить моє тіло",shape=box,color=blue];
		j762960519 -> j883098656;
	j2614251262 [label="я кажу, що це срань собача",shape=box,color=blue];
		j2614251262 -> j757249636;
	j1648355081 [label="я… ти вибачай. я так зазвичай не поводжуся. але ця ситуація… це складно пояснити",shape=box,color=blue];
		j1648355081 -> j2987106393;
	j1897648636 [label="я не те, щоб жадаю відповідей, любе космомандруле. а радше — відповіді мені *потрібні*",shape=box,color=blue];
		j1897648636 -> j3310260368;
	j3824427229 [label="не думаю, що адекватно можу словами передати наскільки я не в нормі",shape=box,color=blue];
		j3824427229 -> j2987106393;
	j883098656 [label="і єдиний чолов’яга, який міг би дати мені відповіді… єдиний, хто міг би пояснити все або допомогти позбутися її… просто *зник*",shape=box,color=blue];
		j883098656 -> j1702964281;
	j757249636 [label="тож я хочу знати про нього все, що знаєш ти. якщо ти не проти",shape=box,color=blue];
		j757249636 -> j1082911225;
	j2987106393 [label="і нагадаю, що взагалі-то в мене робота така — передавати почуття словами",shape=box,color=blue];
		j2987106393 -> j46051278;
	j3310260368 [label="і не думаю, що можу адекватно пояснити наскільки моя ситуація кардинально відрізняється від інших і як мені *треба* позбутися її *негайно*",shape=box,color=blue];
