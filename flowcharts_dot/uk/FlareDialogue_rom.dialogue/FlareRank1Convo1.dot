		j2988955069 -> j3643440336;
	j2471174278 [label="і якщо не помиляюся, то дехто щось казав про «космотравму»?",shape=box,color=blue];
		j2471174278 -> j3334021833;
		j2471174278 -> j3083778269;
	j3334021833 [label="Пха. Ну принаймні ми можемо пропустити ознайомчий вступ.",shape=box,color=red];
