digraph {
	0 [label="FlareRank1Convo1 begins.",color=orange];
		0 -> 1;
	1 [label="агов, космомандруле",shape=box,color=blue];
		1 -> 2;
		1 -> 3;
	2 [label="О, привіт. Ти ж Флер, так?",shape=box,color=red];
		2 -> 4;
	3 [label="Здоров. Як воно?",shape=box,color=red];
		3 -> 5;
	4 [label="ти ж той науковий експеримент, про який мені розповідали, так?",shape=box,color=blue];
		4 -> 6;
		4 -> 7;
	5 [label="та сиджу собі тут і нема чим більше зайнятися. у мене купа питань, якщо маєш час",shape=box,color=blue];
		5 -> 8;
		5 -> 9;
		5 -> 10;
	6 [label="Ну, дуже складно уявити, що тут таких двоє. Але. Ну. Це… Усе одно це довга історія.",shape=box,color=red];
		6 -> 11;
	7 [label="Залежить від того, що саме розповідали. Але, скоріше за все, так.",shape=box,color=red];
		7 -> 12;
	8 [label="Нема чим більше зайнятися, й ти вирішуєш постукати по склу вольєра. Дуже мило.",shape=box,color=red];
		8 -> 13;
	9 [label="Серйозно? Нема чим більше зайнятися? Пха. Мені лестить це.",shape=box,color=red];
		9 -> 14;
	10 [label="Якщо хочеш щось спитати, то вперед. Питай.",shape=box,color=red];
		10 -> 15;
	11 [label="ясно. ну. мені основне коротко пояснили.",shape=box,color=blue];
		11 -> 16;
	12 [label="звісно…",shape=box,color=blue];
		12 -> 17;
		12 -> 18;
	13 [label="+5 Chemistry",color=orange];
		13 -> 19;
	14 [label="ха. звиняй. по дурному вийшло.",shape=box,color=blue];
		14 -> 20;
	15 [label="чудово",shape=box,color=blue];
		15 -> 20;
	16 [label="амір… розповів подробиці, скажімо так. доволі швидко.",shape=box,color=blue];
		16 -> 21;
	17 [label="Хочеш постукати по склу вольєра?",shape=box,color=red];
		17 -> 22;
	18 [label="Чим можу допомогти?",shape=box,color=red];
		18 -> 20;
	19 [label="ох, соле милий, ти що. ти вибачай, що таке враження вийшло. припускаю, ти маєш рацію. ми — ну протофрейми — не єдині наукові експерименти тут, чи не так?",shape=box,color=blue];
		19 -> 23;
		19 -> 24;
		19 -> 25;
	20 [label="зараження. ця гниль. ця штука, що трує мою кров. я маю знати все, що знаєш ти",shape=box,color=blue];
		20 -> 26;
	21 [label="дуже… дуже швидко…",shape=box,color=blue];
		21 -> 27;
	22 [label="+5 Chemistry",color=orange];
		22 -> 28;
	23 [label="Могло бути гірше.",shape=box,color=red];
		23 -> 29;
	24 [label="Гадаю, це те, з чим зрештою примиришся і живеш далі.",shape=box,color=red];
		24 -> 30;
	25 [label="Ніт.",shape=box,color=red];
		25 -> 31;
	26 [label="почнімо з верхівки. якщо… твоя ласка, то *зараз*",shape=box,color=blue];
		26 -> 32;
	27 [label="Check boolean QuincySpaceTrauma",color=orange];
		27 -> 34 [label=true,color=green];
		27 -> 33 [label=false,color=brown];
	28 [label="ох, соле милий, ти що. ти вибачай, що таке враження вийшло. припускаю, ти маєш рацію. ми — протофрейми — не єдині експерименти тут, чи не так?",shape=box,color=blue];
		28 -> 23;
		28 -> 24;
		28 -> 25;
	29 [label="мені аж *кортить* дізнатися, що саме на твою думку могло би бути гіршим за це",shape=box,color=blue];
		29 -> 35;
	30 [label="і насправді саме про це мені хотілося з тобою побалакати…",shape=box,color=blue];
		30 -> 20;
	31 [label="тож скажи мені",shape=box,color=blue];
		31 -> 36;
	32 [label="Update boolean FlareInfestation1",color=orange];
		32 -> 37;
		32 -> 38;
		32 -> 39;
	34 [label="і якщо не помиляюся, то дехто щось казав про «космотравму»?",shape=box,color=blue];
		34 -> 33;
		34 -> 40;
	33 [label="Пха. Ну принаймні ми можемо пропустити ознайомчий вступ.",shape=box,color=red];
		33 -> 17;
		33 -> 18;
	35 [label="просвіти мене",shape=box,color=blue];
		35 -> 41;
	36 [label="і куди він дівся? ентраті? інші запевняють, що не знають. і що ти теж не в курсі",shape=box,color=blue];
		36 -> 42;
	37 [label="Щось мені не до вподоби твоє ставлення?",shape=box,color=red];
		37 -> 43;
	38 [label="Ем… Це буде надовго і не маю певності, що зможу дати відповіді, які ти хочеш.",shape=box,color=red];
		38 -> 44;
	39 [label="Ого, стопе. Здай назад. Ти в нормі?",shape=box,color=red];
		39 -> 45;
	40 [label="Агась. Це Квінсі міг сказати.",shape=box,color=red];
		40 -> 17;
		40 -> 18;
	41 [label="бо я знаю, що в моїй крові трунок, що повільно зводить мене з розуму й нівечить моє тіло",shape=box,color=blue];
		41 -> 46;
	42 [label="я кажу, що це срань собача",shape=box,color=blue];
		42 -> 47;
	43 [label="я… ти вибачай. я так зазвичай не поводжуся. але ця ситуація… це складно пояснити",shape=box,color=blue];
		43 -> 48;
	44 [label="я не те, щоб жадаю відповідей, любе космомандруле. а радше — відповіді мені *потрібні*",shape=box,color=blue];
		44 -> 49;
	45 [label="не думаю, що адекватно можу словами передати наскільки я не в нормі",shape=box,color=blue];
		45 -> 48;
	46 [label="і єдиний чолов’яга, який міг би дати мені відповіді… єдиний, хто міг би пояснити все або допомогти позбутися її… просто *зник*",shape=box,color=blue];
		46 -> 50;
	47 [label="тож я хочу знати про нього все, що знаєш ти. якщо ти не проти",shape=box,color=blue];
		47 -> 51;
	48 [label="і нагадаю, що взагалі-то в мене робота така — передавати почуття словами",shape=box,color=blue];
		48 -> 52;
	49 [label="і не думаю, що можу адекватно пояснити наскільки моя ситуація кардинально відрізняється від інших і як мені *треба* позбутися її *негайно*",shape=box,color=blue];
		49 -> 53;
