	51 [label="починаючи з самого початку",shape=box,color=blue];
		51 -> 37;
		51 -> 39;
		51 -> 38;
	52 [label="тож розкрию тобі всі карти. так, химерна ін’єкція була помилкою",shape=box,color=blue];
		52 -> 58;
	53 [label="Її?",shape=box,color=red];
		53 -> 59;
	54 [label="Те, крізь що ти проходиш, ніяк не відрізняється від решти прокльонівців. Ти не на самоті.",shape=box,color=red];
		54 -> 60;
	55 [label="Я розумію крізь що ти проходиш. Я можу допомогти.",shape=box,color=red];
		55 -> 61;
	56 [label="Я знаю, що це жахлива трагедія — протофрейми, ситуація в Голвенії…",shape=box,color=red];
		56 -> 62;
	57 [label="Малося на увазі, що у світі є набагато гірші речі, аніж бути химерою. Тьху.",shape=box,color=red];
		57 -> 63;
	58 [label="не знаю що тобі треба, як тебе підкупити, які послуги пообіцяти… але мені *треба* позбутися її *негайно*",shape=box,color=blue];
		58 -> 53;
