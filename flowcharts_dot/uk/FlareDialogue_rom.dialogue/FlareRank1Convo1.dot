		j1304909458 -> j1047346970;
	j2783442055 [label="мені аж *кортить* дізнатися, що саме на твою думку могло би бути гіршим за це",shape=box,color=blue];
		j2783442055 -> j3314571694;
	j3510546143 [label="і насправді саме про це мені хотілося з тобою побалакати…",shape=box,color=blue];
