		1118 -> 1121;
		1118 -> 1122;
	1119 [label="Хоча мої почуття до того місця не дуже… теплі… я не можу просто викинути туди зараження й піти собі.",shape=box,color=red];
		1119 -> 1120;
		1119 -> 1122;
		1119 -> 1121;
	1120 [label="І хоча я час від часу повертаюся туди, щоби кілька разів декому надавати по пиці… це не сміттєзвалище.",shape=box,color=red];
		1120 -> 1123;
	1121 [label="Подобається мені це чи ні… але якось я, по дурному звісно, несу відповідальність за те місце.",shape=box,color=red];
		1121 -> 1124;
	1122 [label="У мене стільки приємних спогадів, хоча й болісних не менше.",shape=box,color=red];
