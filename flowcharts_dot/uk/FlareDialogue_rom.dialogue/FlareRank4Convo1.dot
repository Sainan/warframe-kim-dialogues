	"FlareRank4Convo1 begins." [color=orange];
		"FlareRank4Convo1 begins." -> j1205854648;
	j1205854648 [label="увесь день про це думаю… про свою безглузду ситуацію…",shape=box,color=blue];
		j1205854648 -> j786543917;
	j786543917 [label="і найліпший спосіб рухатися далі",shape=box,color=blue];
		j786543917 -> j2652198905;
	j2652198905 [label="або… відсутність таких",shape=box,color=blue];
		j2652198905 -> j4292155196;
	j4292155196 [label="і все це привело до ідеї",shape=box,color=blue];
		j4292155196 -> j2571695752;
		j4292155196 -> j2289807247;
	j2571695752 [label="Ем, йой.",shape=box,color=red];
		j2571695752 -> j3353741481;
	j2289807247 [label="Якої?",shape=box,color=red];
		j2289807247 -> j1809427975;
	j3353741481 [label="ні-ні, чекай, стеж за рухами рук",shape=box,color=blue];
		j3353741481 -> j2724280297;
	j1809427975 [label="тож",shape=box,color=blue];
		j1809427975 -> j2724280297;
	j2724280297 [label="ліззі каже, що вона «скрізь і будь-коли», отже…",shape=box,color=blue];
		j2724280297 -> j888603717;
	j888603717 [label="якщо ти затягнеш її у дуже-далеке майбутнє, то вона просто проповзе якось назад",shape=box,color=blue];
		j888603717 -> j1474760338;
	j1474760338 [label="так?",shape=box,color=blue];
		j1474760338 -> j757480002;
		j1474760338 -> j1512294162;
	j757480002 [label="Ну, скоріше за все.",shape=box,color=red];
		j757480002 -> j1075967278;
	j1512294162 [label="Гадки не маю.",shape=box,color=red];
		j1512294162 -> j1134765454;
	j1075967278 [label="прекрасно",shape=box,color=blue];
		j1075967278 -> j3440870915;
	j1134765454 [label="припустімо, для чистоти аргументації",shape=box,color=blue];
		j1134765454 -> j3440870915;
	j3440870915 [label="але з того, що мені вдалося взнати від інших місцевих миловидних химер…",shape=box,color=blue];
		j3440870915 -> j2058270824;
	j2058270824 [label="має бути місце, де *неможе* бути зараження",shape=box,color=blue];
		j2058270824 -> j327756498;
	j327756498 [label="десь, де можна ув’язнити її і щоби вона *не приповзла* назад…",shape=box,color=blue];
		j327756498 -> j3023354486;
		j327756498 -> j11321521;
	j3023354486 [label="Флер, щось мені дуже-дуже не подобається такий поворот… про що ти говориш?",shape=box,color=red];
		j3023354486 -> j1050299386;
	j11321521 [label="Якщо ти пропонуєш закинути її у Порожнечу… то моя відповідь — «ні».",shape=box,color=red];
		j11321521 -> j4248296692;
	j1050299386 [label="я не про порожнечу",shape=box,color=blue];
		j1050299386 -> j3473987538;
	j4248296692 [label="Я не знаю як представлене зараження у Порожнечі. Але й погіршувати ситуацію не маю бажання.",shape=box,color=red];
		j4248296692 -> j1050299386;
	j3473987538 [label="я про дувірі",shape=box,color=blue];
		j3473987538 -> j1152854592;
		j3473987538 -> j4114967094;
		j3473987538 -> j1965632509;
	j1152854592 [label="Гадаю, це *точно* провчить Тракса…",shape=box,color=red];
		j1152854592 -> j529267941;
	j4114967094 [label="ЩО. НІ! Аж ніяк ні!",shape=box,color=red];
		j4114967094 -> j529267941;
	j1965632509 [label="Я… звідкіля ти знаєш про Дувірі?!",shape=box,color=red];
		j1965632509 -> j4254171392;
	j529267941 [label="схоже, що після заподіяного у тебе жодних боргів перед тим місцем",shape=box,color=blue];
		j529267941 -> j3360212470;
		j529267941 -> j1970485881;
		j529267941 -> j587769909;
	j4254171392 [label="ну знаєш… я можу *розмовляти* з іншими протофреймами",shape=box,color=blue];
		j4254171392 -> j649643870;
	j3360212470 [label="А що дає тобі право вказувати мені, що я можу відправити його просто в пекло?",shape=box,color=red];
		j3360212470 -> j193107749;
		j3360212470 -> j1432650804;
		j3360212470 -> j1793287497;
	j1970485881 [label="Може. А може й ні.",shape=box,color=red];
		j1970485881 -> j193107749;
		j1970485881 -> j1432650804;
		j1970485881 -> j1793287497;
	j587769909 [label="Ти занадто спрощуєш ситуацію. Дувірі було… і *є*… набагато більшим, аніж просто *місце*.",shape=box,color=red];
		j587769909 -> j193107749;
		j587769909 -> j1432650804;
		j587769909 -> j1793287497;
	j649643870 [label="і вони мене просвітили про дивний маленький світ, у якому тобі довелося жити",shape=box,color=blue];
		j649643870 -> j529267941;
	j193107749 [label="Тебе там не було. Це не тобі довелося провести там століття. Це не тобі довелося жити й помирати багато разів.",shape=box,color=red];
		j193107749 -> j4117897220;
		j193107749 -> j1855059662;
		j193107749 -> j864441709;
	j1432650804 [label="Флер, якщо коротко… Те місце… таке ж моє віддзеркалення, як і та книжка, на якій воно засноване.",shape=box,color=red];
		j1432650804 -> j4117897220;
		j1432650804 -> j1855059662;
		j1432650804 -> j864441709;
	j1793287497 [label="Хоча мої почуття до того місця не дуже… теплі… я не можу просто викинути туди зараження й піти собі.",shape=box,color=red];
		j1793287497 -> j4117897220;
		j1793287497 -> j864441709;
		j1793287497 -> j1855059662;
	j4117897220 [label="І хоча я час від часу повертаюся туди, щоби кілька разів декому надавати по пиці… це не сміттєзвалище.",shape=box,color=red];
		j4117897220 -> j1900285710;
	j1855059662 [label="Подобається мені це чи ні… але якось я, по дурному звісно, несу відповідальність за те місце.",shape=box,color=red];
		j1855059662 -> j235619614;
	j864441709 [label="У мене стільки приємних спогадів, хоча й болісних не менше.",shape=box,color=red];
		j864441709 -> j542083325;
	j1900285710 [label="Тож і для тебе це не буде смітником.",shape=box,color=red];
		j1900285710 -> j1137472763;
		j1900285710 -> j2793018198;
		j1900285710 -> j3502598324;
	j235619614 [label="Я маю захищати його, раптом яка небезпека.",shape=box,color=red];
		j235619614 -> j3502598324;
		j235619614 -> j2793018198;
		j235619614 -> j1137472763;
	j542083325 [label="І якщо я хочу позбутися Дувірі — це не означає, що воно має страждати.",shape=box,color=red];
		j542083325 -> j3502598324;
		j542083325 -> j1137472763;
		j542083325 -> j2793018198;
	j1137472763 [label="Ти просиш мене принести страждання іншим.",shape=box,color=red];
		j1137472763 -> j762990733;
	j2793018198 [label="Флер, подумай ще раз про що ти просиш мене.",shape=box,color=red];
		j2793018198 -> j3586261353;
	j3502598324 [label="Ти насправді хочеш наразити цілий інший світ на небезпеку?",shape=box,color=red];
		j3502598324 -> j3164823515;
	j762990733 [label="+5 Chemistry",color=orange];
		j762990733 -> j2304460282;
	j3586261353 [label="я б залюбки, маю на увазі *залюбки* вислухаю твої інші пропозиції",shape=box,color=blue];
		j3586261353 -> j2079401544;
	j3164823515 [label="я… але ж дувірі *не справжнє*",shape=box,color=blue];
		j3164823515 -> j300769150;
		j3164823515 -> j1994652844;
	j2304460282 [label="я… але ж то не справжні *люди*",shape=box,color=blue];
		j2304460282 -> j1313855727;
	j2079401544 [label="бо я щось не бачу від тебе ніяких узагалі",shape=box,color=blue];
		j2079401544 -> j2990166568;
	j300769150 [label="Гаразд. Добре. Ти зі щирими намірами, а я… подумаю над її ув’язненням у Дувірі, якщо вона бреше.",shape=box,color=red];
		j300769150 -> j502181090;
	j1994652844 [label="Хто ми такі, щоби вирішувати що реальне, а що ні?",shape=box,color=red];
		j1994652844 -> j622947736;
	j1313855727 [label="ні, ні. я вже чую слова у своїй голові",shape=box,color=blue];
		j1313855727 -> j2118889182;
	j2990166568 [label="Boolean FlareWar4 is now true.",color=orange];
