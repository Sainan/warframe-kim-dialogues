		1114 -> 1119;
	1115 [label="Ти занадто спрощуєш ситуацію. Дувірі було… і *є*… набагато більшим, аніж просто *місце*.",shape=box,color=red];
		1115 -> 1117;
		1115 -> 1118;
		1115 -> 1119;
	1116 [label="і вони мене просвітили про дивний маленький світ, у якому тобі довелося жити",shape=box,color=blue];
		1116 -> 1111;
	1117 [label="Тебе там не було. Це не тобі довелося провести там століття. Це не тобі довелося жити й помирати багато разів.",shape=box,color=red];
