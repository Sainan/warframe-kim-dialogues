		1105 -> 1107;
	1106 [label="Я не знаю як представлене зараження у Порожнечі. Але й погіршувати ситуацію не маю бажання.",shape=box,color=red];
		1106 -> 1105;
	1107 [label="я про дувірі",shape=box,color=blue];
