		1188 -> 1187;
	1189 [label="  ",shape=box,color=blue];
		1189 -> 1193;
	1190 [label="мммм… сумнівний підхід, але Ми слухаємо… продовжуй",shape=box,color=blue];
		1190 -> 1176;
		1190 -> 1175;
	1191 [label="У мене дуже *дуже* добре вдається убивати тих, котрих неможливо вбити. Повір.",shape=box,color=red];
		1191 -> 1194;
	1192 [label="Ми хочемо заповнити порожнечу Піснею. Величчю. Тим, що Флер шукає все Своє життя",shape=box,color=blue];
