		1234 -> 1238;
	1235 [label="Те, що ти називаєш «спільне» — для нас схоже на «знищене». Тобі треба спробувати зрозуміти це. Я знаю як важко бути «меншими», але спробуй. Пам’ятаєш що трапилося з Елеонорою? І Летті?",shape=box,color=red];
