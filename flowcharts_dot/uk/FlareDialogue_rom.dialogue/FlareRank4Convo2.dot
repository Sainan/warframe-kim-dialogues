	1174 [label="ЧОМУ",shape=box,color=blue];
		1174 -> 1180;
	1175 [label="Флер переживає, що коли впустить тебе, то ти повністю поглинеш усю свідомість. І Флер утратить своє «я».",shape=box,color=red];
		1175 -> 1181;
	1176 [label="Можеш описати які саме зміни ти збираєшся зробити, якщо отримаєш те, що хочеш? Нормальними… не косможахітливими словами.",shape=box,color=red];
		1176 -> 1182;
	1177 [label="Хіба щось може піти не так…",shape=box,color=red];
		1177 -> 1183;
	1178 [label="Я знаю, що ця ідея вже відкидалася… але в мене є кілька *дуже цікавих* способів нищити будь-що.",shape=box,color=red];
		1178 -> 1183;
	1179 [label="Мені вдалося обміркувати твою ідею про ув’язнення її в Дувірі і… певно, твоя правда. Певно це спрацює.",shape=box,color=red];
		1179 -> 1184;
	1180 [label="ЧОМУ повинні Ми прислухатися до ТВОЇХ слів, якщо ТИ хочеш спровадити Нас?!",shape=box,color=blue];
		1180 -> 1185;
		1180 -> 1186;
	1181 [label="що такого особливого в тому «Я»?",shape=box,color=blue];
