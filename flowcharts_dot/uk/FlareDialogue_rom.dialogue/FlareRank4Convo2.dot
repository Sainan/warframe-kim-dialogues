	j1428103441 [label="ЧОМУ",shape=box,color=blue];
		j1428103441 -> j3999256701;
	j2583484912 [label="Флер переживає, що коли впустить тебе, то ти повністю поглинеш усю свідомість. І Флер утратить своє «я».",shape=box,color=red];
		j2583484912 -> j4253828012;
	j2469074588 [label="Можеш описати які саме зміни ти збираєшся зробити, якщо отримаєш те, що хочеш? Нормальними… не косможахітливими словами.",shape=box,color=red];
		j2469074588 -> j45498844;
	j1325059175 [label="Хіба щось може піти не так…",shape=box,color=red];
		j1325059175 -> j2619533548;
	j2358840629 [label="Я знаю, що ця ідея вже відкидалася… але в мене є кілька *дуже цікавих* способів нищити будь-що.",shape=box,color=red];
		j2358840629 -> j2619533548;
	j2474660109 [label="Мені вдалося обміркувати твою ідею про ув’язнення її в Дувірі і… певно, твоя правда. Певно це спрацює.",shape=box,color=red];
		j2474660109 -> j3253381844;
	j3999256701 [label="ЧОМУ повинні Ми прислухатися до ТВОЇХ слів, якщо ТИ хочеш спровадити Нас?!",shape=box,color=blue];
		j3999256701 -> j1266185383;
		j3999256701 -> j3283685328;
