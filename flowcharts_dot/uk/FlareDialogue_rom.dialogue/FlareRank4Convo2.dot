	j380578938 [label="Думаю, що візьмемо її у Порожнечу. Нехай Байдужість розбирається.",shape=box,color=red];
		j380578938 -> j1325059175;
	j3220148038 [label="Гадаю, у нас є спосіб убити Ліззі. Уже тисячі заражених убито моєю рукою. Ще одна не має бути проблемою.",shape=box,color=red];
