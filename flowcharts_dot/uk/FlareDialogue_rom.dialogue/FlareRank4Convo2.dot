		j45498844 -> j3793916650;
	j2619533548 [label="я віддам за це будь що…",shape=box,color=blue];
		j2619533548 -> j78027690;
	j3253381844 [label="Ми запроторимо її у камери до Куллерво. Вона складе йому компанію.",shape=box,color=red];
		j3253381844 -> j2619533548;
	j1266185383 [label="Заспокойся! Я просто намагаюся прибрати Флер на кілька митей. Мені потрібно з тобою обговорити перемовини про таке-сяке перемир’я між вами двома.",shape=box,color=red];
		j1266185383 -> j1505559989;
	j3283685328 [label="Бо ти — вада. Флер хоче тебе позбутися. Тож я збираюся знайти спосіб убити тебе. Кинути в Порожнечу… чи щось таке. Байдуже що.",shape=box,color=red];
		j3283685328 -> j934100709;
