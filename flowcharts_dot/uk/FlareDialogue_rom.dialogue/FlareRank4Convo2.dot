	1182 [label="Update boolean FlareNonCosmic",color=orange];
		1182 -> 1188;
	1183 [label="я віддам за це будь що…",shape=box,color=blue];
		1183 -> 1189;
	1184 [label="Ми запроторимо її у камери до Куллерво. Вона складе йому компанію.",shape=box,color=red];
		1184 -> 1183;
	1185 [label="Заспокойся! Я просто намагаюся прибрати Флер на кілька митей. Мені потрібно з тобою обговорити перемовини про таке-сяке перемир’я між вами двома.",shape=box,color=red];
		1185 -> 1190;
	1186 [label="Бо ти — вада. Флер хоче тебе позбутися. Тож я збираюся знайти спосіб убити тебе. Кинути в Порожнечу… чи щось таке. Байдуже що.",shape=box,color=red];
		1186 -> 1191;
	1187 [label="Флер без Нас порожня оболонка порцелянової розмальованої ляльки",shape=box,color=blue];
