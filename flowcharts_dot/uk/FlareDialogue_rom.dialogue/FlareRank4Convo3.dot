		j2186886191 -> j1155420566;
	j1155420566 [label="намагання відповідати їхнім вимогам призводить до почуття спротиву, неправильності. але якщо й ні? це все марно… я знаю що мені не вдасться… але не намагатися? … луа мила, самотність просто розчалює мене, іноді просто навіть не дає встати з ліжка",shape=box,color=blue];
