		j1870422903 -> j1877297320 [label=false,color=brown];
	j4001873852 [label="Вранці у вогні, горю від світанку.\nЗолото проміння ріже — я стою.\nКожен подих — битва, кожен крок війна.\nХочу більше знову, як назвеш ім’я.",shape=box,color=blue];
