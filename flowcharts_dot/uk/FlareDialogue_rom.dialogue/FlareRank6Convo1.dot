	j1871941288 [label="З криком прокидаюся, залитий тим світлом.\nЗолоті проміння ріжуть білим лезом.\nРанки починаються невідомим болем.\nЯк узнать чи вистою, чи зламаюсь вщент.",shape=box,color=blue];
