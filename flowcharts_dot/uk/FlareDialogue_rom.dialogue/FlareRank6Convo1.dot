		j1877297320 -> j2133572137 [label=false,color=brown];
	j611896617 [label="Я бачу вогник у твоїх очах.\nЗакутий Сол вже тоне в деннім небі.\nЗа грішною усмішкою ховаєш біль.\nЩе доторк, подих — витерпиш ти їх?",shape=box,color=blue];
		j611896617 -> j904886397;
	j2662742538 [label="Я бачу Сола, вщент розідраного на смерть,\nРозлитого як мед, середина злота.\nМільярдів голосів солодкий шепіт.\nУ порожнистих залах, де заплуталася мрія.",shape=box,color=blue];
		j2662742538 -> j904886397;
	j2987436955 [label="Кляни ім’я моє — сьогодні я диявол.\nПостану в лиходійстві чи зникну просто геть?",shape=box,color=blue];
