		j2637123773 -> j1157705624 [label=true,color=green];
		j2637123773 -> j1038899583 [label=false,color=brown];
	j3546226511 [label="Танцюю в Порожнечі, гублюсь в твоїх вогнях.\nЩоранку прокидаюся з новим своїм ім’ям.\nСпасіння ти мені чи остаточний вирок?\nСол угорі високо, та в морі я тону.\nЛюби мене, лиши мене — на волю не піду.",shape=box,color=blue];
		j3546226511 -> j122486466;
