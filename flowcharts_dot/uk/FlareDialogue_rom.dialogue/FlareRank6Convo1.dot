		j4192447210 -> j895467554 [label=true,color=green];
		j4192447210 -> j2106164143 [label=false,color=brown];
	j3769943336 [label="Вранці у вогні, уночі згоряю.\nСрібний промінь ріже — це моя біда.\nКожен подих — битва, кожен крок війна.\nХочу більше знову, як назвеш ім’я.",shape=box,color=blue];
