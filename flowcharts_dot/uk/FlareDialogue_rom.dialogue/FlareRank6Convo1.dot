		j2106164143 -> j1019065454 [label=true,color=green];
		j2106164143 -> j1019065454 [label=false,color=brown];
	j1157705624 [label="Я бачу кригу у твоїх очах.\nЗакута Луа тоне у північнім небі.\nЗа грішною усмішкою ховаєш біль.\nЩе доторк, подих — витерпиш ти їх?",shape=box,color=blue];
		j1157705624 -> j1908806570;
	j1038899583 [label="Я бачу Луа, вщент розідрану на смерть,\nРозсипану як цукор, середина срібна.\nМільярдів голосів солодкий шепіт.\nУ порожнистих залах, де заплуталася мрія.",shape=box,color=blue];
		j1038899583 -> j1908806570;
	j122486466 [label="Голодні крила розпростерті на світанку.\nТи пазурами долю пишеш на моїй спині.\nНа вдиху — святість, а на видиху — падіння.\nЯ все чи я ні що — не уяснить мені",shape=box,color=blue];
		j122486466 -> j2729667313;
	j3799563891 [label="Твій смак — вогонь, твій спів — то гріх.\nПритягуєш до себе і вбираєш.\nБолітиме однак— люби, полиш,\nСвітанок — бій, але з тобою залишаюсь.",shape=box,color=blue];
		j3799563891 -> j1727106894;
	j1108137744 [label="Check boolean FlarePainUnique",color=orange];
		j1108137744 -> j1924815766 [label=true,color=green];
		j1108137744 -> j812880635 [label=false,color=brown];
	j994441618 [label="Танцюю в Порожнечі серед твоїх ланцюгів.\nУ снах жахливих стерті імена мої.\nСпасіння ти мені чи остаточний вирок? \nЛуа вгорі високо, та в морі я тону. \nЛюби мене, лиши мене — на волю не піду.\n",shape=box,color=blue];
		j994441618 -> j2776381651;
	j3900974630 [label="Check boolean FlarePainChronic",color=orange];
		j3900974630 -> j2691835015 [label=true,color=green];
		j3900974630 -> j3492093567 [label=false,color=brown];
	j1019065454 [label="Грішу сьогодні знов — чи святість обійму?\nПостану феніксом чи зникну просто геть?",shape=box,color=blue];
		j1019065454 -> j2321641489;
	j2729667313 [label="Check boolean FlareStoryVillain",color=orange];
		j2729667313 -> j2991324141 [label=true,color=green];
		j2729667313 -> j3710448588 [label=false,color=brown];
	j1727106894 [label="Отруйний дотик, божества цілунок.\nДемон з руками, що переписують мені хребта.\nКолись літаю, колись повзаю на дні.\nСкажи, що втримаєш коли не достану неба.",shape=box,color=blue];
		j1727106894 -> j2729667313;
	j1924815766 [label="Руками стежиш за таємним всередині.\nПрисягами вкриваєш шрами плоті.\nОсь день стоїть, а другий день — повзе.\nЗ тобою відчуваю — маю все.",shape=box,color=blue];
		j1924815766 -> j2265926541;
	j812880635 [label="Check boolean FlarePainEmpathy",color=orange];
		j812880635 -> j4161632475 [label=true,color=green];
		j812880635 -> j571581060 [label=false,color=brown];
	j2776381651 [label="Голодні крила розпростерті уночі.\nУкусами ти долю пишеш на спині.\nНа вдиху — святість, а на видиху — падіння.\nЯ все чи я ні що — не уяснить мені",shape=box,color=blue];
		j2776381651 -> j1941418009;
	j2691835015 [label="Горю, ламаюся й гублюсь в очах твоїх.\nТи Порожнеча, де Луа сховалась.\nБолітиме однак— люби, полиш,\nНіч — бій, але з тобою залишаюсь.",shape=box,color=blue];
		j2691835015 -> j1291293101;
	j3492093567 [label="Check boolean FlarePainUnique",color=orange];
		j3492093567 -> j551006120 [label=true,color=green];
		j3492093567 -> j3828935203 [label=false,color=brown];
	j2991324141 [label="Сьогодні лиходійство, і мене виніть.\nДогнати світло чи в ганьбі позникнуть?",shape=box,color=blue];
		j2991324141 -> j2387747234;
	j3710448588 [label="Check boolean FlareStoryHero",color=orange];
		j3710448588 -> j936342530 [label=true,color=green];
		j3710448588 -> j828767743 [label=false,color=brown];
	j2265926541 [label="Цілую Порожнечу і куштую світло\nПритягуєш мене і чую я добро\nНошу я Сола, як золоту корону\nТа дотик твій зогнилий і цвілий",shape=box,color=blue];
		j2265926541 -> j2729667313;
	j4161632475 [label="Твій дотик — грім, твій поцілунок шторм.\nТа ти кричиш всередині, холодним ротом.\nЯ бачу шкіру і ті тріщини під нею.\nЯ бачу бій, який не виграти тобі.",shape=box,color=blue];
		j4161632475 -> j976584718;
	j571581060 [label="Твій смак — вогонь, твій спів — то гріх.\nПритягуєш до себе і вбираєш.\nЛюби мене, лиши мене — на волю не піду.\nВіддамсь тобі і геть себе забуду ліпш.",shape=box,color=blue];
		j571581060 -> j190747260;
	j1941418009 [label="Check boolean FlareStoryVillain",color=orange];
		j1941418009 -> j2499811738 [label=true,color=green];
		j1941418009 -> j1934034599 [label=false,color=brown];
	j1291293101 [label="Отруйний дотик, божества цілунок.\nДемон з руками, що переписують мені хребта.\nНочами я літаю, ними ж повзаю на дні.\nСкажи, що втримаєш коли вже не достану неба.",shape=box,color=blue];
		j1291293101 -> j1941418009;
	j551006120 [label="Руками стежиш за таємним всередині.\nПрисягами вкриваєш шрами плоті.\nОсь ніч стоїть, а другу ніч — повзе.\nЗ тобою відчуваю — маю все.",shape=box,color=blue];
		j551006120 -> j4219861694;
	j3828935203 [label="Check boolean FlarePainEmpathy",color=orange];
		j3828935203 -> j2972111180 [label=true,color=green];
		j3828935203 -> j1821369942 [label=false,color=brown];
	j2387747234 [label="Золоті ореоли та посмішки криві\nКожна любовна пісня вершиться спочатку\nЧи постану? Чи паду?\nЧи постану? Чи паду?",shape=box,color=blue];
		j2387747234 -> j1042158646;
	j936342530 [label="Сьогодні геройство, і мене не виніть.\nУтримаю світло чи у вогні зникну?",shape=box,color=blue];
		j936342530 -> j2387747234;
	j828767743 [label="Check boolean FlareStoryNone",color=orange];
		j828767743 -> j1901191669 [label=true,color=green];
		j828767743 -> j1901191669 [label=false,color=brown];
	j976584718 [label="Серце наче Сол, але ти з Порожнечі\nБлискавиця в небі, що кудись зника\nВідчуваю жар твій, біль твій відчуваю\nІ горю як ти, кров у нас одна",shape=box,color=blue];
		j976584718 -> j2729667313;
	j190747260 [label="Тебе я відчуваю під своєю шкірою —\nТисячі рук голосами наповнені.\nЧи хранитель я їм чи стану пожертвою?\nЧи хвороба твоя чи спасіння в мені?",shape=box,color=blue];
		j190747260 -> j2729667313;
	j2499811738 [label="Сьогодні лиходійство, і мене виніть.\nДогнати зорі чи в ганьбі позникнуть?",shape=box,color=blue];
		j2499811738 -> j1700749560;
	j1934034599 [label="Check boolean FlareStoryHero",color=orange];
		j1934034599 -> j2266719749 [label=true,color=green];
		j1934034599 -> j406023769 [label=false,color=brown];
	j4219861694 [label="Цілую Порожнечу і куштую ніч\nПритягуєш мене і чую я добро\nТи носиш Луа, як стару корону\nТа дотик твій мертвий і крижаний",shape=box,color=blue];
		j4219861694 -> j1941418009;
	j2972111180 [label="Хаотичний кожен дотик, та мене єднає він.\nГрішників молитви виріжу на кості.\nКожну рану я лишу собі.\nКожен крик, що чув в тобі.",shape=box,color=blue];
		j2972111180 -> j1687844310;
	j1821369942 [label="Твій смак — як крига, твій спів — то гріх.\nПритягуєш до себе і вбираєш.\nЛюби мене, лиши мене — на волю не піду.\nВіддамсь тобі і геть себе забуду ліпш.",shape=box,color=blue];
		j1821369942 -> j2574789965;
