		j3363681658 -> j2145937920;
	j854650674 [label="Іноді доводилося прокидатися й відчувати себе в чужій шкурі, буквально. Що я — не те, що зовні. Що я якась підробка, брехня.",shape=box,color=red];
		j854650674 -> j1919808353;
	j1764802030 [label="Іноді я прокидаюся й відчуваю такий біль, що хочеться заповзти в якусь діру на весь день. Щоби спробувати завтра. Але я знаю, що це знову повториться.",shape=box,color=red];
