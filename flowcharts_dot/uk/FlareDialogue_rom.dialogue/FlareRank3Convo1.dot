	j3702873499 [label="або чи вдасться узагалі дожити до кінця дня? чи доведеться зачинитися в кімнаті, заблокувати двері й кричати всім ВІДВАЛІТЬ ІДІТЬ У СРАКУ",shape=box,color=blue];
