		j3873069661 -> j1867272010 [label="DrifterMarie",color=purple];
		j3873069661 -> j4124766578 [label="false",color=purple];
	j651829929 [label="Mon cœur ! Є хвилинка ? Я хотіла б трішки попереписуватися, якщо є час.",shape=box,color=blue];
		j651829929 -> j1342323389;
		j651829929 -> j1478915251;
	j2953493390 [label="Найдорожче мого найдорожчого ! Є вільний час для спілкування зі мною ?",shape=box,color=blue];
		j2953493390 -> j3103694210;
		j2953493390 -> j1478915251;
	j2889139157 [label="Викликаю приборкувачів дияволів ! Є хвилинка для мене ?",shape=box,color=blue];
		j2889139157 -> j978881405;
		j2889139157 -> j1478915251;
	j1867272010 [label="Є хвилинка ? Я хотіла б трішки попереписуватися, якщо є час.",shape=box,color=blue];
		j1867272010 -> j2968898382;
		j1867272010 -> j1478915251;
	j4124766578 [label="Є хвилинка ? Я хотіла б трішки попереписуватися, якщо є час.",shape=box,color=blue];
		j4124766578 -> j453596731;
		j4124766578 -> j2032860459;
		j4124766578 -> j1478915251;
	j1342323389 [label="Для тебе — завжди. Що там?",shape=box,color=red];
		j1342323389 -> j925406348;
	j1478915251 [label="[Завершити розмову]",shape=box,color=red];
		j1478915251 -> "Chat ends.";
	j3103694210 [label="Будь-коли. Що в тебе?",shape=box,color=red];
		j3103694210 -> j1337306569;
	j978881405 [label="Ха. Щось не маю впевненості, що він приборканий. Що в тебе?",shape=box,color=red];
		j978881405 -> j1989518944;
	j2968898382 [label="Для тебе — завжди. Що там?",shape=box,color=red];
		j2968898382 -> j1864957210;
	j453596731 [label="Звісно. У чому справа?",shape=box,color=red];
		j453596731 -> j1511011763;
	j2032860459 [label="[Зізнатися в почуттях] Якраз дуже вчасно. Мені теж тобі треба дещо сказати… ",shape=box,color=red];
		j2032860459 -> j1043567234;
	j925406348 [label="Я думала про те, як багато часу ми провели разом. І як мало це в більшій перспективі, враховуючи всі прожиті тобою роки.",shape=box,color=blue];
		j925406348 -> j2292256986;
	"Chat ends." [color=orange];
	j1337306569 [label="Твоя дружба хороша й добра. Про таких союзників я навіть і молитися не могла. ",shape=box,color=blue];
		j1337306569 -> j3352154434;
	j1989518944 [label="Oui, і думаю, що тобі це до смаку, non ? Ха! Я навіть уявляти диявола в такій позі не хочу. Не зважай ! Я не про те хотіла написати.",shape=box,color=blue];
		j1989518944 -> j3470333215;
	j1864957210 [label="Evaluate expressions",color=orange];
		j1864957210 -> j3311167355 [label="RoatheDating",color=purple];
		j1864957210 -> j3311167355 [label="LyonDating",color=purple];
		j1864957210 -> j1373230526 [label="IsDating",color=purple];
		j1864957210 -> j2039193195 [label="false",color=purple];
	j1511011763 [label="Я думала про те, як багато часу ми провели разом. І як мало це в більшій перспективі, враховуючи всі прожиті тобою роки.",shape=box,color=blue];
		j1511011763 -> j969548180;
	j1043567234 [label="Non, дай я спершу, бо як ні, то вся знервуюся !",shape=box,color=blue];
		j1043567234 -> j1471879296;
	j2292256986 [label="Але я думаю також і про те, як багато цей час значить для мене. Як ці миті змінили мене й напрямок мого життя, наче вітри рух корабля в морі.",shape=box,color=blue];
		j2292256986 -> j2095205951;
	j3352154434 [label="Evaluate expressions",color=orange];
		j3352154434 -> j2787860779 [label="LyonFaith3Yes",color=purple];
		j3352154434 -> j552609898 [label="LyonFaith3No",color=purple];
		j3352154434 -> j2299580941 [label="LyonFaith3Maybe",color=purple];
		j3352154434 -> j2299580941 [label="false",color=purple];
	j3470333215 [label="Evaluate expressions",color=orange];
		j3470333215 -> j4207446800 [label="LoidFamilyComplete",color=purple];
		j3470333215 -> j654000059 [label="RoatheRedeemed",color=purple];
		j3470333215 -> j2628620237 [label="RoatheVillain",color=purple];
		j3470333215 -> j4192109471 [label="RoatheHellComplete",color=purple];
		j3470333215 -> j3743813433 [label="false",color=purple];
	j3311167355 [label="Якось я читала твої слова про почуття до мене. Однак зараз я бачу тебе з іншим. Просто хочу сказати, що я дуже рада за тебе !",shape=box,color=blue];
		j3311167355 -> j1419537751;
	j1373230526 [label="Якось у нас була розмова, що… я навіть не знаю, як це написати. Що в тебе є почуття до мене. Однак я знаю, що в тебе є інший.",shape=box,color=blue];
		j1373230526 -> j1758476807;
		j1373230526 -> j808260236;
	j2039193195 [label="Якось у нас була розмова, що… я навіть не знаю, як це написати. Що в тебе є почуття до мене.",shape=box,color=blue];
		j2039193195 -> j1928846357;
	j969548180 [label="Але я думаю також і про те, як багато цей час значить для мене. Як ці миті змінили мене й напрямок мого життя, наче вітри рух корабля в морі.",shape=box,color=blue];
		j969548180 -> j1490594320;
	j1471879296 [label="Evaluate expressions",color=orange];
		j1471879296 -> j4031465341 [label="MarieNoDate",color=purple];
		j1471879296 -> j4240406859 [label="MarieWillDate",color=purple];
		j1471879296 -> j4031465341 [label="false",color=purple];
	j2095205951 [label="І от я собі думаю, це те, що хоче знищити l'Indifférence ? Те, що l'Indifférence поглинає ? Оту силу впливати на інших ?",shape=box,color=blue];
		j2095205951 -> j1260332329;
	j2787860779 [label="Завдяки тобі мій духовний брат знайшов спокій. Тобі вдалося переконати його, що в нас є справжній ворог — і дати надію.",shape=box,color=blue];
		j2787860779 -> j2073816123;
	j552609898 [label="Завдяки тобі мій духовний брат знайшов утіху й щось на кшталт спокою, якого не було раніше. Думаю, твоє товариство значить для нього більше, аніж він може висловити.",shape=box,color=blue];
		j552609898 -> j2073816123;
	j2299580941 [label="Ми можемо й не знайти відповідей про справжню сутність l'indifférence, але це й не є важливим. Ми повинні здолати всі випробування, які вона кидає нам — бо це реально.",shape=box,color=blue];
		j2299580941 -> j2073816123;
	j4207446800 [label="Не думала, що нашого диявола можна переконати допомогти возз’єднатися монсеньйору Лойду та родині le Cardinal. Його мотиви… сумнівні, і я досі не зовсім довіряю йому. ",shape=box,color=blue];
		j4207446800 -> j585286055;
	j654000059 [label="Не думала, що нашому дияволу можна вказати на хибність його дій. Що він справді шкодуватиме про всі ті забрані ним невинні життя. Тобі вдалося довести помилковість моєї думки.",shape=box,color=blue];
		j654000059 -> j3223809320;
	j2628620237 [label="Якими б кайданками тобі не вдалося скувати нашого диявола, але він на короткому повідцю. Він… стриманіший, аніж раніше. І за це дяка лише тобі.",shape=box,color=blue];
		j2628620237 -> j3223809320;
	j4192109471 [label="Схоже, що спогади, які ми допомогли йому повернути, змусили його поводитися стриманіше. Можливо, згадка про горювання за вже втраченими вказала на тих, кого він ще може втратити.",shape=box,color=blue];
		j4192109471 -> j3223809320;
	j3743813433 [label="Може, це саме прихильність до тебе його й загартовує. Не знаю. Які б не були причини, це тобі треба дякувати за все.",shape=box,color=blue];
		j3743813433 -> j3223809320;
	j1419537751 [label="Я не думаю про тебе лихого й лише бажаю joie вам обом, oui ?",shape=box,color=blue];
		j1419537751 -> j1181041388;
		j1419537751 -> j879647454;
	j1758476807 [label="Усе змінилося… я… маю зберігати вірність. Ти вибач.",shape=box,color=red];
		j1758476807 -> j3238494762;
	j808260236 [label="У це може бути складно повірити, може бути складно прийняти. Я знаю. Але я… кохаю тебе. І його. Рівномірно.",shape=box,color=red];
		j808260236 -> j3734127592;
	j1928846357 [label="Evaluate expressions",color=orange];
		j1928846357 -> j230871630 [label="MarieNoDate",color=purple];
		j1928846357 -> j2561995842 [label="MarieWillDate",color=purple];
		j1928846357 -> j3398506950 [label="MarieWillDate",color=purple];
		j1928846357 -> j230871630 [label="false",color=purple];
	j1490594320 [label="І от я собі думаю, це те, що хоче знищити l'Indifférence ? Те, що l'Indifférence поглинає ? Оту силу впливати на інших ?",shape=box,color=blue];
		j1490594320 -> j1606513213;
	j4031465341 [label="Боюся, що ти збираєшся написати слова, які не можна буде стерти. І це змінить між нами все назавжди.",shape=box,color=blue];
		j4031465341 -> j1240268985;
	j4240406859 [label="Mon cœur t'appartient depuis notre première rencontre…",shape=box,color=blue];
		j4240406859 -> j2865627826;
		j4240406859 -> j3521272318;
	j1260332329 [label="Дар смішити одне одного. Плакати. Переконувати в правді чи брехні. Змінювати думки одне одного. Утішати одне одного, коли болить. З дурощів шкодити одне одному.",shape=box,color=blue];
		j1260332329 -> j3697417261;
	j2073816123 [label="І яка різниця, якщо ти проведеш Ліона крізь найтемніші години й триматимеш його у хвилі болю й agonie ?",shape=box,color=blue];
		j2073816123 -> j914691624;
	j585286055 [label="І, безсумнівно, результати є лише завдяки тобі. Роут тут і він захищає родину le Cardinal завдяки тобі.",shape=box,color=blue];
		j585286055 -> j3223809320;
	j3223809320 [label="І я знаю, що наш диявол не ворог нам, oui ? А якраз l'Indifférence. А чому l'Indifférence нас учить, окрім як триматися за те, чим вона нехтує, те, що нищить ?",shape=box,color=blue];
		j3223809320 -> j1141219099;
	j1181041388 [label="Але… що якщо…",shape=box,color=red];
		j1181041388 -> j679020528;
	j879647454 [label="У мене теж є почуття до тебе, Марі.",shape=box,color=red];
		j879647454 -> j4087996837;
	j3238494762 [label="Oui, я розумію. Так, звісно розумію! Як я можу винити тебе за дослухання до своєї душі ?",shape=box,color=blue];
		j3238494762 -> j130434212;
	j3734127592 [label="Evaluate expressions",color=orange];
		j3734127592 -> j230871630 [label="MarieNoDate",color=purple];
		j3734127592 -> j2869525621 [label="MarieWillDate",color=purple];
		j3734127592 -> j230871630 [label="false",color=purple];
	j230871630 [label="Я не знаю, як це сказати, щоб не було дуже жорстоко… тож скажу просто.",shape=box,color=blue];
		j230871630 -> j2272189194;
	j2561995842 [label="Так. Але… ти відчуваєш те саме?",shape=box,color=red];
		j2561995842 -> j510664277;
	j3398506950 [label="Усе змінилося… я… Пробач.",shape=box,color=red];
		j3398506950 -> j2264550653;
	j1606513213 [label="Дар смішити одне одного. Плакати. Переконувати в правді чи брехні. Змінювати думки одне одного. Утішати одне одного, коли болить. З дурощів шкодити одне одному.",shape=box,color=blue];
		j1606513213 -> j2916745218;
	j1240268985 [label="І мені дуже гірко, ох як гірко, зупиняти тебе просто тут і зараз.",shape=box,color=blue];
		j1240268985 -> j30371423;
	j2865627826 [label="Марі, я не знаю, що це значить.",shape=box,color=red];
		j2865627826 -> j2534429683;
	j3521272318 [label="Mon cœur t'appartient également, Марі!",shape=box,color=red];
		j3521272318 -> j852054807;
	j3697417261 [label="Можливість кохатися з насолодою. Дарувати agonie одне одному, коли втрачаєш голову від гніву. Це дар humanité. Це те, чого нема в l'indifférence.",shape=box,color=blue];
		j3697417261 -> j3475376885;
	j914691624 [label="А чому ще l'Indifférence нас учить, попри своє походження, окрім як триматися за те, чим вона нехтує, те, що нищить ?",shape=box,color=blue];
		j914691624 -> j3990100735;
	j1141219099 [label="Я думала про те, як багато часу ми провели разом. І як мало це в більшій перспективі, враховуючи всі прожиті тобою роки.",shape=box,color=blue];
		j1141219099 -> j1374736258;
	j679020528 [label="Замість ? Тоді… Боюся, мандрівниче, тобі спершу треба розплутати клубок свого серця. Я не можу це зробити за тебе.",shape=box,color=blue];
		j679020528 -> j3699890413;
	j4087996837 [label="І може бути, що суть у цьому. Я не ревнива, але знати, що твоє серце належить комусь незнайомому — одна справа…",shape=box,color=blue];
		j4087996837 -> j1066322481;
	j130434212 [label="+10 Chemistry",color=orange];
		j130434212 -> j3690279427;
	j2869525621 [label="Я… ох ! О, mon cœur !",shape=box,color=blue];
		j2869525621 -> j2159566919;
	j2272189194 [label="Боюся… тобі треба шукати когось іще. Те, що ти відчуваєш до мене — не взаємне. Пробач мені.",shape=box,color=blue];
		j2272189194 -> j3877046144;
	j510664277 [label="Я… ох ! О, mon cœur !",shape=box,color=blue];
		j510664277 -> j712756118;
	j2264550653 [label="Oui, я розумію. Так, звісно розумію! Як я можу винити тебе за дослухання до своєї душі ?",shape=box,color=blue];
		j2264550653 -> j249670216;
	j2916745218 [label="Можливість кохатися з насолодою. Дарувати agonie одне одному, коли втрачаєш голову від гніву. Це дар humanité. Це те, чого нема в l'indifférence.",shape=box,color=blue];
		j2916745218 -> j4268075944;
	j30371423 [label="Я не знаю, як це сказати, щоб не було дуже жорстоко… тож скажу просто.",shape=box,color=blue];
		j30371423 -> j3624787618;
	j2534429683 [label="Oui, я знаю ! У тому й суть ! Я занадто боюся сказати… сказати як сильно ти мені подобаєшся. ",shape=box,color=blue];
		j2534429683 -> j410416369;
	j852054807 [label="+10 Chemistry",color=orange];
		j852054807 -> j3637591030;
	j3475376885 [label="Це щось не зовсім чисте й геть недосконале, але прекрасне — як зорі на небі. Мільярд маленьких цяток утворюють плетене мереживо світлового океану.",shape=box,color=blue];
		j3475376885 -> j1558673529;
	j3990100735 [label="Я думала про те, як багато часу ми провели разом. І як мало це в більшій перспективі, враховуючи всі прожиті тобою роки.",shape=box,color=blue];
		j3990100735 -> j3112729531;
	j1374736258 [label="Але я думаю також і про те, як багато цей час значить для мене. Як ці миті змінили мене й напрямок мого життя, наче вітри рух корабля в морі.",shape=box,color=blue];
		j1374736258 -> j3007293543;
	j3699890413 [label="Evaluate expressions",color=orange];
		j3699890413 -> j1075948929 [label="LyonDating",color=purple];
		j3699890413 -> j318942009 [label="RoatheDating",color=purple];
	j1066322481 [label="І зовсім інша, коли це мій брат по духу чи диявол, з яким я щодня маю змагатися.",shape=box,color=blue];
		j1066322481 -> j1189707755;
	j3690279427 [label="Нехай Сол благословить вас і ваші серця. Я ж просто тішитимуся, що благословенна називатися твоєю подругою !",shape=box,color=blue];
		j3690279427 -> j2438655654;
	j2159566919 [label="Я… не можу добрати слів, окрім як… Я вірю тобі. І я… я відчуваю те саме. Mon cœur t'appartient depuis notre première rencontre.",shape=box,color=blue];
		j2159566919 -> j1755178520;
	j3877046144 [label="Але повір, у маленькій Марі ти завше матимеш союзницю, яка до кінця стоятиме поруч хай там що.",shape=box,color=blue];
		j3877046144 -> "Chat ends.";
	j712756118 [label="Я… не можу добрати слів, окрім як… я відчуваю те саме. Mon cœur t'appartient depuis notre première rencontre.",shape=box,color=blue];
		j712756118 -> j1755178520;
	j249670216 [label="+10 Chemistry",color=orange];
		j249670216 -> j187647499;
	j4268075944 [label="Це щось не зовсім чисте й геть недосконале, але прекрасне — як зорі на небі. Мільярд маленьких цяток утворюють плетене мереживо світлового океану.",shape=box,color=blue];
		j4268075944 -> j932620808;
	j3624787618 [label="Те, що ти відчуваєш до мене — не взаємне. Пробач.",shape=box,color=blue];
		j3624787618 -> j3877046144;
	j410416369 [label="Mon cœur t'appartient depuis notre première rencontre.",shape=box,color=blue];
		j410416369 -> j1755178520;
	j3637591030 [label="Ого ! Хто тебе навчив цього ?! Ліон ?! Забудь! Ох, вовченя моє !",shape=box,color=blue];
		j3637591030 -> j1755178520;
	j1558673529 [label="Усі ці зайві подробиці без précision, oui ? Кому важливо звідки воно… ми такі, які є.",shape=box,color=blue];
		j1558673529 -> j2316854864;
	j3112729531 [label="Але я думаю також і про те, як багато цей час значить для мене. Як ці миті змінили мене й напрямок мого життя, наче вітри рух корабля в морі.",shape=box,color=blue];
		j3112729531 -> j715930046;
	j3007293543 [label="І от я собі думаю, це те, що хоче знищити l'Indifférence ? Те, що l'Indifférence поглинає ? Оту силу впливати на інших ?",shape=box,color=blue];
		j3007293543 -> j2561812926;
	j1075948929 [label="Я молюся, щоби Ліон через тебе не пішов хибним шляхом… щоби не зазнав даремної кривди від тебе. Він дуже тендітна особистість, попри кам’яну непробивну зовнішність.",shape=box,color=blue];
		j1075948929 -> j1022798110;
	j318942009 [label="Я не хочу, щоби Роут страждав… попри мої чіпляння до нього й нотації. Не кривдь диявола, якщо можеш уникнути цього.",shape=box,color=blue];
		j318942009 -> j1022798110;
	j1189707755 [label="Я могла би примиритися, або й радіти навіть від думки поділитися тобою з кимось ще… Але з родиною чи ворогом ? Гадаю, це для мене занадто.",shape=box,color=blue];
		j1189707755 -> j693025441;
		j1189707755 -> j1402191405;
	j2438655654 [label="І повір, у маленькій Марі ти завше матимеш подругу, яка до кінця стоятиме поруч хай там що.",shape=box,color=blue];
		j2438655654 -> "Chat ends.";
	j1755178520 [label="Я думала про те, як багато часу ми провели разом. І як мало це в більшій перспективі, враховуючи всі прожиті тобою роки.",shape=box,color=blue];
		j1755178520 -> j703636570;
	j187647499 [label="Я ж просто тішитимуся, що благословенна називатися твоєю подругою !",shape=box,color=blue];
		j187647499 -> j2438655654;
	j932620808 [label="Усі ці зайві подробиці без précision, oui ? Кому важливо звідки воно… ми такі, які є.",shape=box,color=blue];
		j932620808 -> j3134094165;
	j2316854864 [label="І це все є в тебе зі мною, oui ?",shape=box,color=blue];
		j2316854864 -> j454819152;
	j715930046 [label="І от я собі думаю, це те, що хоче знищити l'Indifférence ? Те, що l'Indifférence поглинає ? Оту силу впливати на інших ?",shape=box,color=blue];
		j715930046 -> j881948356;
	j2561812926 [label="Дар смішити одне одного. Плакати. Переконувати в правді чи брехні. Змінювати думки одне одного. Утішати одне одного, коли болить. З дурощів шкодити одне одному.",shape=box,color=blue];
		j2561812926 -> j3985202923;
	j1022798110 [label="Я не хочу, щоби страждали інші. Я не буду «тієї іншою жінкою» в чиємусь болі. Твої почуття ж можуть бути сильнішими до мене, шляхом зменшення їх до інших, oui ?",shape=box,color=blue];
		j1022798110 -> j1458067149;
	j693025441 [label="Я це поважаю.",shape=box,color=red];
		j693025441 -> j705240819;
	j1402191405 [label="Але…",shape=box,color=red];
		j1402191405 -> j1920182959;
	j703636570 [label="Але я думаю також і про те, як багато цей час значить для мене. Як ці миті змінили мене й напрямок мого життя, наче вітри рух корабля в морі.",shape=box,color=blue];
		j703636570 -> j2828351149;
	j3134094165 [label="І це все я з гордістю розділяю з тобою !",shape=box,color=blue];
		j3134094165 -> j3459825684;
	j454819152 [label="Я не знаю, як це сказати, але відчуваю, що мушу.",shape=box,color=blue];
		j454819152 -> j3533391812;
		j454819152 -> j1018498413;
	j881948356 [label="Дар смішити одне одного. Плакати. Переконувати в правді чи брехні. Змінювати думки одне одного. Утішати одне одного, коли болить. З дурощів шкодити одне одному.",shape=box,color=blue];
		j881948356 -> j688735397;
	j3985202923 [label="Можливість кохатися з насолодою. Дарувати agonie одне одному, коли втрачаєш голову від гніву. Це дар humanité. Це те, чого нема в l'indifférence.",shape=box,color=blue];
		j3985202923 -> j2593743817;
	j1458067149 [label="Раджу зважати на це, перш ніж знову заговорити до мене про це, oui?",shape=box,color=blue];
		j1458067149 -> "Chat ends.";
	j705240819 [label="+20 Chemistry",color=orange];
		j705240819 -> j3101656681;
	j1920182959 [label="Мені шкода. Просто, воно має бути так. Я думаю, ти подібні відповіді отримаєш і від інших.",shape=box,color=blue];
		j1920182959 -> "Chat ends.";
	j2828351149 [label="І от я собі думаю, це те, що хоче знищити l'Indifférence ? Те, що l'Indifférence поглинає ? Оту силу впливати на інших ?",shape=box,color=blue];
		j2828351149 -> j470169865;
	j3459825684 [label="Коли настане час, я з честю битимуся з цим звіром, чим би він не був.",shape=box,color=blue];
