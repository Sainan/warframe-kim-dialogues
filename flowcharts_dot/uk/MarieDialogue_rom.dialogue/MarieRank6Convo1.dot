		3280 -> 3287;
	3284 [label="Будь-коли. Що в тебе?",shape=box,color=red];
		3284 -> 3291;
	3285 [label="Ха. Щось не маю впевненості, що він приборканий. Що в тебе?",shape=box,color=red];
		3285 -> 3292;
	3283 [label="Для тебе — завжди. Що там?",shape=box,color=red];
		3283 -> 3290;
	3281 [label="Звісно. У чому справа?",shape=box,color=red];
		3281 -> 3288;
	3279 [label="[Зізнатися в почуттях] Якраз дуже вчасно. Мені теж тобі треба дещо сказати… ",shape=box,color=red];
		3279 -> 3286;
	3289 [label="Я думала про те, як багато часу ми провели разом. І як мало це в більшій перспективі, враховуючи всі прожити тобою роки.",shape=box,color=blue];
		3289 -> 3295;
	3287 [label="Chat ends.",color=orange];
	3291 [label="Твоя дружба хороша й добра. Про таких союзників я навіть і молитися не могла. ",shape=box,color=blue];
		3291 -> 3299;
	3292 [label="Oui, і думаю, що тобі це до смаку, non ? Ха! Я навіть уявляти диявола в такій позі не хочу. Не зважай ! Я не про те хотіла написати.",shape=box,color=blue];
		3292 -> 3300;
	3290 [label="Evaluate expressions",color=orange];
		3290 -> 3298 [label="RoatheDating",color=purple];
		3290 -> 3298 [label="LyonDating",color=purple];
		3290 -> 3297 [label="IsDating",color=purple];
		3290 -> 3296 [label="false",color=purple];
	3288 [label="Я думала про те, як багато часу ми провели разом. І як мало це в більшій перспективі, враховуючи всі прожити тобою роки.",shape=box,color=blue];
		3288 -> 3294;
	3286 [label="Non, дай я спершу, бо як ні, то вся знервуюся !",shape=box,color=blue];
		3286 -> 3293;
	3295 [label="Але я думаю також і про те, як багато цей час значить для мене. Як ці миті змінили мене й напрямок мого життя, наче вітри рух корабля в морі.",shape=box,color=blue];
		3295 -> 3304;
	3299 [label="Evaluate expressions",color=orange];
		3299 -> 3309 [label="LyonFaith3Yes",color=purple];
		3299 -> 3310 [label="LyonFaith3No",color=purple];
