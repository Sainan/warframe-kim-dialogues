	3378 [label="І от я собі думаю, це те, що хоче знищити l'Indifférence ? Те, що l'Indifférence поглинає ? Оту силу впливати на інших ?",shape=box,color=blue];
		3378 -> 3386;
	3379 [label="Дар смішити одне одного. Плакати. Переконувати в правді чи брехні. Змінювати думки одне одного. Утішати одне одного, коли болить. З дурощів шкодити одне одному.",shape=box,color=blue];
		3379 -> 3387;
