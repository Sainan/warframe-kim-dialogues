		3300 -> 3314 [label="RoatheVillain",color=purple];
		3300 -> 3315 [label="RoatheHellComplete",color=purple];
		3300 -> 3316 [label="false",color=purple];
	3298 [label="Якось я читала твої слова про почуття до мене. Однак зараз я бачу тебе з іншим. Просто хочу сказати, що я дуже рада за тебе !",shape=box,color=blue];
		3298 -> 3308;
	3297 [label="Якось у нас була розмова, що… я навіть не знаю, як це написати. Що в тебе є почуття до мене. Однак я знаю, що в тебе є інший.",shape=box,color=blue];
		3297 -> 3306;
		3297 -> 3307;
	3296 [label="Якось у нас була розмова, що… я навіть не знаю, як це написати. Що в тебе є почуття до мене.",shape=box,color=blue];
		3296 -> 3305;
	3294 [label="Але я думаю також і про те, як багато цей час значить для мене. Як ці миті змінили мене й напрямок мого життя, наче вітри рух корабля в морі.",shape=box,color=blue];
		3294 -> 3303;
	3293 [label="Evaluate expressions",color=orange];
		3293 -> 3302 [label="MarieNoDate",color=purple];
		3293 -> 3301 [label="MarieWillDate",color=purple];
		3293 -> 3302 [label="false",color=purple];
	3304 [label="І от я собі думаю, це те, що хоче знищити l'Indifférence ? Те, що l'Indifférence поглинає ? Оту силу впливати на інших ?",shape=box,color=blue];
		3304 -> 3321;
	3309 [label="Завдяки тобі мій духовний брат знайшов спокій. Тобі вдалося переконати його, що в нас є справжній ворог — і дати надію.",shape=box,color=blue];
		3309 -> 3329;
	3310 [label="Завдяки тобі мій духовний брат знайшов утіху й щось на кшталт спокою, якого не було раніше. Думаю, твоє товариство значить для нього більше, аніж він може висловити.",shape=box,color=blue];
		3310 -> 3329;
	3311 [label="Ми можемо й не знайти відповідей про справжню сутність l'indifférence, але це й не є важливим. Ми повинні здолати всі випробування, які вона кидає нам — бо це реально.",shape=box,color=blue];
		3311 -> 3329;
	3312 [label="Не думала, що нашого диявола можна переконати допомогти возз’єднатися монсеньйору Лойду та родині le Cardinal. Його мотиви… сумнівні, і я досі не зовсім довіряю йому. ",shape=box,color=blue];
		3312 -> 3330;
	3313 [label="Не думала, що нашому дияволу можна вказати на хибність його дій. Що він справді шкодуватиме про всі ті забрані ним невинні життя. Тобі вдалося довести помилковість моєї думки.",shape=box,color=blue];
		3313 -> 3331;
	3314 [label="Якими б кайданками тобі не вдалося скувати нашого диявола, але він на короткому повідцю. Він… стриманіший, аніж раніше. І за це дяка лише тобі.",shape=box,color=blue];
		3314 -> 3331;
	3315 [label="Схоже, що спогади, які ми допомогли йому повернути, змусили його поводитися стриманіше. Можливо, згадка про горювання за вже втраченими вказала на тих, кого він ще може втратити.",shape=box,color=blue];
		3315 -> 3331;
	3316 [label="Може, це саме прихильність до тебе його й загартовує. Не знаю. Які б не були причини, це тобі треба дякувати за все.",shape=box,color=blue];
		3316 -> 3331;
	3308 [label="Я не думаю про тебе лихого й лише бажаю joie вам обом, oui ?",shape=box,color=blue];
		3308 -> 3327;
		3308 -> 3328;
	3306 [label="Усе змінилося… я… маю зберігати вірність. Ти вибач.",shape=box,color=red];
		3306 -> 3325;
	3307 [label="У це може бути складно повірити, може бути складно прийняти. Я знаю. Але я… кохаю тебе. І його. Рівномірно.",shape=box,color=red];
		3307 -> 3326;
	3305 [label="Evaluate expressions",color=orange];
		3305 -> 3324 [label="MarieNoDate",color=purple];
		3305 -> 3322 [label="MarieWillDate",color=purple];
		3305 -> 3323 [label="MarieWillDate",color=purple];
		3305 -> 3324 [label="false",color=purple];
	3303 [label="І от я собі думаю, це те, що хоче знищити l'Indifférence ? Те, що l'Indifférence поглинає ? Оту силу впливати на інших ?",shape=box,color=blue];
		3303 -> 3320;
	3302 [label="Боюся, що ти збираєшся написати слова, які не можна буде стерти. І це змінить між нами все назавжди.",shape=box,color=blue];
		3302 -> 3319;
	3301 [label="Mon cœur t'appartient depuis notre première rencontre…",shape=box,color=blue];
		3301 -> 3317;
		3301 -> 3318;
	3321 [label="Дар смішити одне одного. Плакати. Переконувати в правді чи брехні. Змінювати думки одне одного. Утішати одне одного, коли болить. З дурощів шкодити одне одному.",shape=box,color=blue];
		3321 -> 3336;
	3329 [label="І яка різниця, якщо ти проведеш Ліона крізь найтемніші години й триматимеш його у хвилі болю й agonie ?",shape=box,color=blue];
		3329 -> 3343;
	3330 [label="І, безсумнівно, результати є лише завдяки тобі. Роут тут і він захищає родину le Cardinal завдяки тобі.",shape=box,color=blue];
		3330 -> 3331;
	3331 [label="І я знаю, що наш диявол не ворог нам, oui ? А якраз l'Indifférence. А чому l'Indifférence нас учить, окрім як триматися за те, чим вона нехтує, те, що нищить ?",shape=box,color=blue];
		3331 -> 3344;
	3327 [label="Але… що якщо…",shape=box,color=red];
		3327 -> 3891;
	3328 [label="У мене теж є почуття до тебе, Марі.",shape=box,color=red];
		3328 -> 3342;
	3325 [label="Oui, я розумію. Так, звісно розумію! Як я можу винити тебе за дослухання до своєї душі ?",shape=box,color=blue];
		3325 -> 3340;
	3326 [label="Evaluate expressions",color=orange];
		3326 -> 3324 [label="MarieNoDate",color=purple];
		3326 -> 3341 [label="MarieWillDate",color=purple];
		3326 -> 3324 [label="false",color=purple];
	3324 [label="Я не знаю, як це сказати, щоб не було дуже жорстоко… тож скажу просто.",shape=box,color=blue];
		3324 -> 3339;
	3322 [label="Так. Але… ти відчуваєш те саме?",shape=box,color=red];
		3322 -> 3337;
	3323 [label="Усе змінилося… я… Пробач.",shape=box,color=red];
		3323 -> 3338;
	3320 [label="Дар смішити одне одного. Плакати. Переконувати в правді чи брехні. Змінювати думки одне одного. Утішати одне одного, коли болить. З дурощів шкодити одне одному.",shape=box,color=blue];
		3320 -> 3335;
	3319 [label="І мені дуже гірко, ох як гірко, зупиняти тебе просто тут і зараз.",shape=box,color=blue];
		3319 -> 3334;
	3317 [label="Марі, я не знаю, що це значить.",shape=box,color=red];
		3317 -> 3332;
	3318 [label="Mon cœur t'appartient également, Марі!",shape=box,color=red];
		3318 -> 3333;
	3336 [label="Можливість кохатися з насолодою. Дарувати agonie одне одному, коли втрачаєш голову від гніву. Це дар humanité. Це те, чого нема в l'indifférence.",shape=box,color=blue];
		3336 -> 3349;
	3343 [label="А чому ще l'Indifférence нас учить, попри своє походження, окрім як триматися за те, чим вона нехтує, те, що нищить ?",shape=box,color=blue];
		3343 -> 3356;
	3344 [label="Я думала про те, як багато часу ми провели разом. І як мало це в більшій перспективі, враховуючи всі прожити тобою роки.",shape=box,color=blue];
		3344 -> 3357;
	3891 [label="Замість ? Тоді… Боюся, мандрівниче, тобі спершу треба розплутати клубок свого серця. Я не можу це зробити за тебе.",shape=box,color=blue];
		3891 -> 3892;
	3342 [label="І може бути, що суть у цьому. Я не ревнива, але знати, що твоє серце належить комусь незнайомому — одна справа…",shape=box,color=blue];
		3342 -> 3355;
	3340 [label="+10 Chemistry",color=orange];
		3340 -> 3353;
	3341 [label="Я… ох ! О, mon cœur !",shape=box,color=blue];
		3341 -> 3354;
	3339 [label="Боюся… тобі треба шукати когось іще. Те, що ти відчуваєш до мене — не взаємне. Пробач мені.",shape=box,color=blue];
		3339 -> 3352;
	3337 [label="Я… ох ! О, mon cœur !",shape=box,color=blue];
		3337 -> 3350;
	3338 [label="Oui, я розумію. Так, звісно розумію! Як я можу винити тебе за дослухання до своєї душі ?",shape=box,color=blue];
		3338 -> 3351;
	3335 [label="Можливість кохатися з насолодою. Дарувати agonie одне одному, коли втрачаєш голову від гніву. Це дар humanité. Це те, чого нема в l'indifférence.",shape=box,color=blue];
		3335 -> 3348;
	3334 [label="Я не знаю, як це сказати, щоб не було дуже жорстоко… тож скажу просто.",shape=box,color=blue];
		3334 -> 3347;
	3332 [label="Oui, я знаю ! У тому й суть ! Я занадто боюся сказати… сказати як сильно ти мені подобаєшся. ",shape=box,color=blue];
		3332 -> 3345;
	3333 [label="+10 Chemistry",color=orange];
		3333 -> 3346;
	3349 [label="Це щось не зовсім чисте й геть недосконале, але прекрасне — як зорі на небі. Мільярд маленьких цяток утворюють плетене мереживо світлового океану.",shape=box,color=blue];
		3349 -> 3361;
	3356 [label="Я думала про те, як багато часу ми провели разом. І як мало це в більшій перспективі, враховуючи всі прожити тобою роки.",shape=box,color=blue];
		3356 -> 3368;
	3357 [label="Але я думаю також і про те, як багато цей час значить для мене. Як ці миті змінили мене й напрямок мого життя, наче вітри рух корабля в морі.",shape=box,color=blue];
		3357 -> 3369;
	3892 [label="Evaluate expressions",color=orange];
		3892 -> 3893 [label="LyonDating",color=purple];
		3892 -> 3894 [label="RoatheDating",color=purple];
	3355 [label="І зовсім інша, коли це мій брат по духу чи диявол, з яким я щодня маю змагатися.",shape=box,color=blue];
		3355 -> 3367;
	3353 [label="Нехай Сол благословить вас і ваші серця. Я ж просто тішитимуся, що благословенна називатися твоєю подругою !",shape=box,color=blue];
		3353 -> 3365;
	3354 [label="Я… не можу добрати слів, окрім як… Я вірю тобі. І я… я відчуваю те саме. Mon cœur t'appartient depuis notre première rencontre.",shape=box,color=blue];
		3354 -> 3366;
	3352 [label="Але повір, у маленькій Марі ти завше матимеш союзницю, яка до кінця стоятиме поруч хай там що.",shape=box,color=blue];
		3352 -> 3364;
	3350 [label="Я… не можу добрати слів, окрім як… я відчуваю те саме. Mon cœur t'appartient depuis notre première rencontre.",shape=box,color=blue];
		3350 -> 3362;
	3351 [label="+10 Chemistry",color=orange];
		3351 -> 3363;
	3348 [label="Це щось не зовсім чисте й геть недосконале, але прекрасне — як зорі на небі. Мільярд маленьких цяток утворюють плетене мереживо світлового океану.",shape=box,color=blue];
		3348 -> 3360;
	3347 [label="Те, що ти відчуваєш до мене — не взаємне. Пробач.",shape=box,color=blue];
		3347 -> 3359;
	3345 [label="Mon cœur t'appartient depuis notre première rencontre.",shape=box,color=blue];
		3345 -> 3358;
	3346 [label="Ого ! Хто тебе навчив цього ?! Ліон ?! Забудь! Ох, вовченя моє !",shape=box,color=blue];
		3346 -> 3358;
	3361 [label="Усі ці зайві подробиці без précision, oui ? Кому важливо звідки воно… ми такі, які є.",shape=box,color=blue];
		3361 -> 3373;
	3368 [label="Але я думаю також і про те, як багато цей час значить для мене. Як ці миті змінили мене й напрямок мого життя, наче вітри рух корабля в морі.",shape=box,color=blue];
		3368 -> 3378;
	3369 [label="І от я собі думаю, це те, що хоче знищити l'Indifférence ? Те, що l'Indifférence поглинає ? Оту силу впливати на інших ?",shape=box,color=blue];
		3369 -> 3379;
	3893 [label="Я молюся, щоби Ліон через тебе не пішов хибним шляхом… щоби не зазнав даремної кривди від тебе. Він дуже тендітна особистість, попри кам’яну непробивну зовнішність.",shape=box,color=blue];
		3893 -> 3895;
	3894 [label="Я не хочу, щоби Роут страждав… попри мої чіпляння до нього й нотації. Не кривдь диявола, якщо можеш уникнути цього.",shape=box,color=blue];
		3894 -> 3895;
	3367 [label="Я могла би примиритися, або й радіти навіть від думки поділитися тобою з кимось ще… Але з родиною чи ворогом ? Гадаю, це для мене занадто.",shape=box,color=blue];
		3367 -> 3376;
		3367 -> 3377;
	3365 [label="І повір, у маленькій Марі ти завше матимеш подругу, яка до кінця стоятиме поруч хай там що.",shape=box,color=blue];
		3365 -> 3375;
	3366 [label="Я думала про те, як багато часу ми провели разом. І як мало це в більшій перспективі, враховуючи всі прожити тобою роки.",shape=box,color=blue];
		3366 -> 3370;
	3364 [label="Chat ends.",color=orange];
	3362 [label="Я думала про те, як багато часу ми провели разом. І як мало це в більшій перспективі, враховуючи всі прожити тобою роки.",shape=box,color=blue];
		3362 -> 3370;
