digraph {
	graph [fontname="Roboto Condensed"];
	node [fontname="Roboto Condensed"];
	edge [fontname="Roboto Condensed"];

	"MarieRank1Convo1 begins." [color=orange];
		"MarieRank1Convo1 begins." -> j3657596676;
	j3657596676 [label="Bonjour, bonjour, мандрівниче ! Як ся маєш такого прекрасного дня? Чи вечора. Я й справді не орієнтуюся в тутешньому часі.",shape=box,color=blue];
		j3657596676 -> j2059059929;
	j2059059929 [label="Я впевнена, що щось із цих bibelots, які монсеньйор Лойд зберігає, точно годинник, але не визначити мені ніяк що саме.",shape=box,color=blue];
		j2059059929 -> j2639188667;
	j2639188667 [label="Боюся я торкатися будь-якого пристрою в цім дивнім святилищі. Я вірую, що перенесуся миттєво в якийсь віддалений час так само легко, як можу заварити собі чаю.",shape=box,color=blue];
		j2639188667 -> j1386146383;
		j2639188667 -> j1872866120;
		j2639188667 -> j1478915251;
	j1386146383 [label="Ліпше не натискати жодну з кнопок, у якій не маєш певності. Це точно. ",shape=box,color=red];
		j1386146383 -> j28583191;
	j1872866120 [label="Маю абсолютну впевненість, що з тобою все буде гаразд.",shape=box,color=red];
		j1872866120 -> j3131040408;
	j1478915251 [label="[Завершити розмову]",shape=box,color=red];
		j1478915251 -> "Chat ends.";
	j28583191 [label="І справді дуже хороша порада. Я чула від монсеньйора Лойда, що у тебе була власна aventure temporelle. Цікаво…",shape=box,color=blue];
		j28583191 -> j797768489;
	j3131040408 [label="C'est très gentil de votre part, але… це ж не тебе перекинули в інший… а. Точно. Так !",shape=box,color=blue];
		j3131040408 -> j1951875104;
	"Chat ends." [color=orange];
	j797768489 [label="Це було так само небезпечно як і зараз ?",shape=box,color=blue];
		j797768489 -> j3814611288;
		j797768489 -> j115508936;
	j1951875104 [label="Тобі це вже ж відомо, чи не так. Екск’юзема. Твоя власна подорож була такою ж небезпечною, як і ця ?",shape=box,color=blue];
		j1951875104 -> j3814611288;
		j1951875104 -> j115508936;
	j3814611288 [label="Часовий період? Чи загалом моє перебування там?",shape=box,color=red];
		j3814611288 -> j3584538370;
	j115508936 [label="Було інакше, але обіцяю — тут ти в безпеці.",shape=box,color=red];
		j115508936 -> j1552037616;
	j3584538370 [label="+10 Chemistry",color=orange];
		j3584538370 -> j3219399913;
	j1552037616 [label="Дуже вдячна за твою непорушну впевненість, але щось не зовсім поділяю я її. Особливо не тоді, коли маю проблеми з банальним визначенням часу доби.",shape=box,color=blue];
		j1552037616 -> j399170101;
	j3219399913 [label="Добре, що ти розділяєш це. Загалом, у мене нема сумнівів, що твої враження від минулого були «нормальними» за суміжними стандартами. Та з усього сказаного виходить, що ні.",shape=box,color=blue];
		j3219399913 -> j550580449;
	j399170101 [label="Можна було очікувати, що він повинен бути в куточку цього… «екрана», але його тут нема ! Mauvaise qualité, якби мене питали.",shape=box,color=blue];
		j399170101 -> j2541868904;
	j550580449 [label="Я саме про «часовий період». Дозволь перефразувати…",shape=box,color=blue];
		j550580449 -> j741418238;
	j2541868904 [label="Менше з тим, ми вже доволі далеко відійшли від мого питання !",shape=box,color=blue];
		j2541868904 -> j741418238;
	j741418238 [label="Оцей «минулий» час, куди тебе закинуло, який насправді ближче до «дальшого минулого», з якого родом я. То він більш чи менш небезпечний за той час, у якому ми наразі перебуваємо ?",shape=box,color=blue];
		j741418238 -> j2966451908;
	j2966451908 [label="(Боже правий! Мені й справді це подобається. Визнаю, що це набагато цікавіше, аніж витирати пилюку з посуду для причастя.)",shape=box,color=blue];
		j2966451908 -> j1991639498;
		j2966451908 -> j342646040;
		j2966451908 -> j4075420036;
		j2966451908 -> j2991600113;
	j1991639498 [label="Думаю, приблизно такий самий. Зброя інша й вони ще можуть не знати, із чим мають справу, але війна — це війна, а смерть — це смерть.",shape=box,color=red];
		j1991639498 -> j1353480519;
	j342646040 [label="Гадаю, цей час менш небезпечний. У нас більше можливостей розправитися з випробуваннями. Вони лише починаються.",shape=box,color=red];
		j342646040 -> j3024470571;
	j4075420036 [label="Гадаю, цей час небезпечніший. Попри наявність Зараження тут і там, їм доводиться боротися набагато простішою зброєю.",shape=box,color=red];
		j4075420036 -> j3024470571;
	j2991600113 [label="По правді, мене тішить, що ти насолоджуєшся цим. Буває дуже складно адаптуватися зразу до багатьох речей.",shape=box,color=red];
		j2991600113 -> j2707943505;
	j1353480519 [label="+5 Chemistry",color=orange];
		j1353480519 -> j4285260408;
	j3024470571 [label="Може й так. Я подумаю про це. Дякую тобі.",shape=box,color=blue];
		j3024470571 -> "Chat ends.";
	j2707943505 [label="+5 Chemistry",color=orange];
		j2707943505 -> j929103232;
	j4285260408 [label="Як і всі речі, припускаю, що це відносно, non ? Хижак, котрий нас убиває зараз, такий же смертоносний, як і той, котрий полював нас тоді. Лише зубки гостріші.",shape=box,color=blue];
		j4285260408 -> j1560446462;
		j4285260408 -> j3742291501;
	j929103232 [label="Мене до цього підготував le Cardinal Dimanche — ваш Альбрехт Ентраті. На відміну від мого дорогого Ліона, його словам я вірю, як фактам. І на відміну від того ж Ліона, я бачу це як величну пригоду, а не тягар.",shape=box,color=blue];
		j929103232 -> j802019919;
	j1560446462 [label="Хіба що ти орокінка, яка знайшла спосіб уникнути смерті… теоретично, а може й практично.",shape=box,color=red];
		j1560446462 -> j3512412221;
	j3742291501 [label="Мене теж радує, що ти так добре адаптуєшся до майбутнього.",shape=box,color=red];
		j3742291501 -> j3449065256;
	j802019919 [label="Служба Світочам не потребує страждань. Цим ми завжди відрізнялися.",shape=box,color=blue];
		j802019919 -> j2044349893;
	j3512412221 [label="І я вірю, що диявол — ідеальний приклад, чому смерть є найвеличнішим даром, яким Луа нагородила нас.",shape=box,color=blue];
		j3512412221 -> j3927496747;
	j3449065256 [label="+5 Chemistry",color=orange];
		j3449065256 -> j2950221194;
	j2044349893 [label="Boolean MarieLyonSuffering1 is now true.",color=orange];
		j2044349893 -> j454225873;
	j3927496747 [label="Boolean MarieRoathe1 is now true.",color=orange];
		j3927496747 -> j3523450407;
	j2950221194 [label="Мене до цього підготував le Cardinal Dimanche — ваш Альбрехт Ентраті. На відміну від мого дорогого Ліона, його словам я вірю, як фактам. І на відміну від того ж Ліона, я бачу це як величну пригоду, а не тягар.",shape=box,color=blue];
		j2950221194 -> j242296060;
	j454225873 [label="І не уникай відповіді на питання, дурненьке ! Який час, на твою думку, небезпечніший ?",shape=box,color=blue];
		j454225873 -> j1997727142;
		j454225873 -> j3584271008;
		j454225873 -> j2424486896;
	j3523450407 [label="О ! Оце геть звучить як знайомий звук годинника. Хоча я ніяк не визначу де розташована клята штука. Менше з тим, боюся, маю йти. Було приємно. До наступної «зустрічі» ! Aux Dieux !",shape=box,color=blue];
		j3523450407 -> "Chat ends.";
	j242296060 [label="Служба Світочам не потребує страждань. Цим ми завжди відрізнялися.",shape=box,color=blue];
		j242296060 -> j3270592025;
	j1997727142 [label="Думаю, цей час небезпечніший. Чимало неможливо неймовірних ворогів намагаються вбити нас.",shape=box,color=red];
		j1997727142 -> j3024470571;
	j3584271008 [label="Думаю, наш час менш небезпечний. Вони лише відкривають нові шляхи вбивства одне одного. Наші способи либонь лише захопливіші на вигляд.",shape=box,color=red];
		j3584271008 -> j3024470571;
	j2424486896 [label="Думаю, що однакові… приблизно. У кінці. Смерть є смерть, чи не так?",shape=box,color=red];
		j2424486896 -> j2568476705;
	j3270592025 [label="Boolean MarieLyonSuffering1 is now true.",color=orange];
		j3270592025 -> j3523450407;
	j2568476705 [label="+5 Chemistry",color=orange];
		j2568476705 -> j1857666816;
	j1857666816 [label="Як і всі речі, припускаю, що це відносно, non ? Хижак, котрий нас убиває зараз, такий же смертоносний, як і той, котрий полював нас тоді. Лише зубки гостріші.",shape=box,color=blue];
		j1857666816 -> j487376039;
		j1857666816 -> j1560446462;
	j487376039 [label="Мене дуже часто виснажує нескінченна боротьба з вовком.",shape=box,color=red];
		j487376039 -> j457247726;
	j457247726 [label="Думаю, мандрівниче, що тобі радше хочеться втекти до вовчої зграї, аніж сісти на ціп і щось захищати від них. І май на увазі, це комплімент.",shape=box,color=blue];
		j457247726 -> j3523450407;
}