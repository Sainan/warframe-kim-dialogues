digraph {
	0 [label="MarieRank1Convo1 begins.",color=orange];
		0 -> 1;
	1 [label="Bonjour, bonjour, мандрівниче ! Як ся маєш такого прекрасного дня? Чи вечора. Я й справді не орієнтуюся в тутешньому часі.",shape=box,color=blue];
		1 -> 2;
	2 [label="Я впевнена, що щось із цих bibelots, які монсеньйор Лойд зберігає, точно годинник, але не визначити мені ніяк що саме.",shape=box,color=blue];
		2 -> 3;
	3 [label="Боюся я торкатися будь-якого пристрою в цім дивнім святилищі. Я вірую, що перенесуся миттєво в якийсь віддалений час так само легко, як можу заварити собі чаю.",shape=box,color=blue];
		3 -> 5;
		3 -> 6;
		3 -> 4;
	5 [label="Ліпше не натискати жодну з кнопок, у якій не маєш певності. Це точно. ",shape=box,color=red];
		5 -> 8;
	6 [label="Маю абсолютну впевненість, що з тобою все буде гаразд.",shape=box,color=red];
		6 -> 9;
	4 [label="[Завершити розмову]",shape=box,color=red];
		4 -> 7;
	8 [label="І справді дуже хороша порада. Я чула від монсеньйора Лойда, що у тебе була власна aventure temporelle. Цікаво…",shape=box,color=blue];
		8 -> 10;
	9 [label="C'est très gentil de votre part, але… це ж не тебе перекинули в інший… а. Точно. Так !",shape=box,color=blue];
		9 -> 11;
	7 [label="Chat ends.",color=orange];
	10 [label="Це було так само небезпечно як і зараз ?",shape=box,color=blue];
		10 -> 12;
		10 -> 13;
	11 [label="Тобі це вже ж відомо, чи не так. Екск’юзема. Твоя власна подорож була такою ж небезпечною, як і ця ?",shape=box,color=blue];
		11 -> 12;
		11 -> 13;
	12 [label="Часовий період? Чи загалом моє перебування там?",shape=box,color=red];
		12 -> 14;
	13 [label="Було інакше, але обіцяю — тут ти в безпеці.",shape=box,color=red];
		13 -> 15;
	14 [label="+10 Chemistry",color=orange];
		14 -> 16;
	15 [label="Дуже вдячна за твою непорушну впевненість, але щось не зовсім поділяю я її. Особливо не тоді, коли маю проблеми з банальним визначенням часу доби.",shape=box,color=blue];
		15 -> 17;
	16 [label="Добре, що ти розділяєш це. Загалом, у мене нема сумнівів, що твої враження від минулого були «нормальними» за суміжними стандартами. Та з усього сказаного виходить, що ні.",shape=box,color=blue];
		16 -> 18;
	17 [label="Можна було очікувати, що він повинен бути в куточку цього… «екрана», але його тут нема ! Mauvaise qualité, якби мене питали.",shape=box,color=blue];
		17 -> 19;
	18 [label="Я саме про «часовий період». Дозволь перефразувати…",shape=box,color=blue];
		18 -> 20;
	19 [label="Менше з тим, ми вже доволі далеко відійшли від мого питання !",shape=box,color=blue];
		19 -> 20;
	20 [label="Оцей «минулий» час, куди тебе закинуло, який насправді ближче до «дальшого минулого», з якого родом я. То він більш чи менш небезпечний за той час, у якому ми наразі перебуваємо ?",shape=box,color=blue];
		20 -> 21;
	21 [label="(Боже правий! Мені й справді це подобається. Визнаю, що це набагато цікавіше, аніж витирати пилюку з посуду для причастя.)",shape=box,color=blue];
		21 -> 22;
		21 -> 23;
		21 -> 24;
		21 -> 25;
	22 [label="Думаю, приблизно такий самий. Зброя інша й вони ще можуть не знати, із чим мають справу, але війна — це війна, а смерть — це смерть.",shape=box,color=red];
		22 -> 26;
	23 [label="Гадаю, цей час менш небезпечний. У нас більше можливостей розправитися з випробуваннями. Вони лише починаються.",shape=box,color=red];
		23 -> 27;
	24 [label="Гадаю, цей час небезпечніший. Попри наявність Зараження тут і там, їм доводиться боротися набагато простішою зброєю.",shape=box,color=red];
		24 -> 27;
	25 [label="По правді, мене тішить, що ти насолоджуєшся цим. Буває дуже складно адаптуватися зразу до багатьох речей.",shape=box,color=red];
		25 -> 28;
	26 [label="+5 Chemistry",color=orange];
		26 -> 29;
	27 [label="Може й так. Я подумаю про це. Дякую тобі.",shape=box,color=blue];
		27 -> 30;
	28 [label="+5 Chemistry",color=orange];
		28 -> 31;
	29 [label="Як і всі речі, припускаю, що це відносно, non ? Хижак, котрий нас убиває зараз, такий же смертоносний, як і той, котрий полював нас тоді. Лише зубки гостріші.",shape=box,color=blue];
		29 -> 32;
		29 -> 33;
	30 [label="Chat ends.",color=orange];
	31 [label="Мене до цього підготував le Cardinal Dimanche — ваш Альбрехт Ентраті. На відміну від мого дорогого Ліона, його словам я вірю, як фактам. І на відміну від того ж Ліона, я бачу це як величну пригоду, а не тягар.",shape=box,color=blue];
		31 -> 34;
	32 [label="Хіба що ти орокінка, яка знайшла спосіб уникнути смерті… теоретично, а може й практично.",shape=box,color=red];
		32 -> 35;
	33 [label="Мене теж радує, що ти так добре адаптуєшся до майбутнього.",shape=box,color=red];
		33 -> 36;
	34 [label="Служба Світочам не потребує страждань. Цим ми завжди відрізнялися.",shape=box,color=blue];
		34 -> 37;
	35 [label="І я вірю, що диявол — ідеальний приклад, чому смерть є найвеличнішим даром, яким Луа нагородила нас.",shape=box,color=blue];
		35 -> 38;
	36 [label="+5 Chemistry",color=orange];
		36 -> 39;
	37 [label="Update boolean MarieLyonSuffering1",color=orange];
		37 -> 40;
	38 [label="Update boolean MarieRoathe1",color=orange];
		38 -> 41;
	39 [label="Мене до цього підготував le Cardinal Dimanche — ваш Альбрехт Ентраті. На відміну від мого дорогого Ліона, його словам я вірю, як фактам. І на відміну від того ж Ліона, я бачу це як величну пригоду, а не тягар.",shape=box,color=blue];
		39 -> 42;
	40 [label="І не уникай відповіді на питання, дурненьке ! Який час, на твою думку, небезпечніший ?",shape=box,color=blue];
		40 -> 43;
		40 -> 44;
		40 -> 45;
	41 [label="О ! Оце геть звучить як знайомий звук годинника. Хоча я ніяк не визначу де розташована клята штука. Менше з тим, боюся, маю йти. Було приємно. До наступної «зустрічі» ! Aux Dieux !",shape=box,color=blue];
		41 -> 46;
	42 [label="Служба Світочам не потребує страждань. Цим ми завжди відрізнялися.",shape=box,color=blue];
		42 -> 47;
	43 [label="Думаю, цей час небезпечніший. Чимало неможливо неймовірних ворогів намагаються вбити нас.",shape=box,color=red];
		43 -> 48;
	44 [label="Думаю, наш час менш небезпечний. Вони лише відкривають нові шляхи вбивства одне одного. Наші способи либонь лише захопливіші на вигляд.",shape=box,color=red];
		44 -> 48;
	45 [label="Думаю, що однакові… приблизно. У кінці. Смерть є смерть, чи не так?",shape=box,color=red];
		45 -> 49;
	46 [label="Chat ends.",color=orange];
	47 [label="Update boolean MarieLyonSuffering1",color=orange];
		47 -> 41;
	48 [label="Може й так. Я подумаю про це. Дякую тобі.",shape=box,color=blue];
		48 -> 50;
	49 [label="+5 Chemistry",color=orange];
		49 -> 51;
	50 [label="Chat ends.",color=orange];
	51 [label="Як і всі речі, припускаю, що це відносно, non ? Хижак, котрий нас убиває зараз, такий же смертоносний, як і той, котрий полював нас тоді. Лише зубки гостріші.",shape=box,color=blue];
		51 -> 52;
		51 -> 53;
	52 [label="Мене дуже часто виснажує нескінченна боротьба з вовком.",shape=box,color=red];
		52 -> 54;
	53 [label="Хіба що ти орокінка, яка знайшла спосіб уникнути смерті… теоретично, а може й практично.",shape=box,color=red];
		53 -> 55;
	54 [label="Думаю, мандрівниче, що тобі радше хочеться втекти до вовчої зграї, аніж сісти на ціп і щось захищати від них. І май на увазі, це комплімент.",shape=box,color=blue];
		54 -> 41;
	55 [label="І я вірю, що диявол — ідеальний приклад, чому смерть є найвеличнішим даром, яким Луа нагородила нас.",shape=box,color=blue];
		55 -> 56;
	56 [label="Update boolean MarieRoathe1",color=orange];
		56 -> 41;
}