digraph {
	1418 [label="MarieRank3Convo6 begins.",color=orange];
		1418 -> 3740;
	3740 [label="Update boolean MarieLyonAvailable",color=orange];
		3740 -> 1419;
	1419 [label="Мандрівниче, я маю спитати, але благаю не засуджувати за це.",shape=box,color=blue];
		1419 -> 1420;
		1419 -> 1421;
		1419 -> 1422;
	1420 [label="Тебе закинули в дивний час і простір. Звісно я не засуджуватиму.",shape=box,color=red];
		1420 -> 1423;
	1421 [label="Зроблю все можливе.",shape=box,color=red];
		1421 -> 1424;
	1422 [label="[Завершити розмову]",shape=box,color=red];
		1422 -> 1425;
	1423 [label="Vraiment gentil з твого боку виявляти таку милість, абсолютно не знаючи мене чи навіть питання, яке я збиралася написати.",shape=box,color=blue];
		1423 -> 1426;
	1424 [label="+10 Chemistry",color=orange];
		1424 -> 1427;
	1425 [label="Chat ends.",color=orange];
	1426 [label="Отже… у тебе від тої велетеголової риби теж голова болить ? Від Фібоначчі ?",shape=box,color=blue];
		1426 -> 1428;
		1426 -> 1429;
		1426 -> 1430;
	1427 [label="Дуже вдячна за це.",shape=box,color=blue];
		1427 -> 1426;
	1428 [label="Так. Цілковито. Дякую.",shape=box,color=red];
		1428 -> 1431;
	1429 [label="Натяк на те, що Фібоначчі дістає тебе, неймовірно милий.",shape=box,color=red];
		1429 -> 1432;
	1430 [label="Та ні, геть ні. Я обожнюю його.",shape=box,color=red];
		1430 -> 1433;
	1431 [label="Тоді я рада, що не одна така. Зазначу, я геть не збираюся ображати його. Якщо я геть не при собі через поточну ситуацію, то уявляю, як йому. Певно, ледь стримується.",shape=box,color=blue];
		1431 -> 1434;
	1432 [label="О ? Як так ? Напевно, я маю радіти цьому, але це спантеличує. Мій головний біль — точно не миле відчуття.",shape=box,color=blue];
		1432 -> 1435;
		1432 -> 1436;
	1433 [label="Тоді я можу лише просити пробачення. Зазначу, я геть не збираюся ображати його. Якщо я геть не при собі через поточну ситуацію, то уявляю як йому. Певно, ледь стримується.",shape=box,color=blue];
		1433 -> 1437;
	1434 [label="Просто його спосіб робити це не дуже влаштовує мене, коли доводиться тривалий час із цим стикатися, c'est tout.",shape=box,color=blue];
		1434 -> 1438;
	1435 [label="Більшість мого життя проведене в боях за виживання. Дрібні нагадування про людяність… як от ці… Ну, це те, заради чого я живу.",shape=box,color=red];
		1435 -> 1439;
	1436 [label="Припускаю, що іноді мені потрібно дивитися з іншої перспективи й міркувати про абсурдність усього цього гармидеру. Норґ і жриця Сола…",shape=box,color=red];
		1436 -> 1440;
	1437 [label="Просто його спосіб робити це не дуже влаштовує мене, коли доводиться тривалий час із цим стикатися, c'est tout.",shape=box,color=blue];
		1437 -> 1441;
	1438 [label="Та. Узагалі ж мені не варто скаржитися. Маю віднести Ліону його вечерю. Він знову лежить покотом із жахливою megrim.",shape=box,color=blue];
		1438 -> 1442;
		1438 -> 1443;
	1439 [label="+5 Chemistry",color=orange];
		1439 -> 1444;
	1440 [label="+5 Chemistry",color=orange];
		1440 -> 1445;
	1441 [label="Та. Узагалі ж мені не варто скаржитися. Маю віднести Ліону його вечерю. Він знову лежить покотом із жахливою megrim.",shape=box,color=blue];
		1441 -> 1442;
		1441 -> 1443;
	1442 [label="У нього часто вони бувають?",shape=box,color=red];
		1442 -> 1446;
	1443 [label="Перепрошую… із чим він лежить?",shape=box,color=red];
		1443 -> 1447;
	1444 [label="Мандрівниче, бережи цю частину себе. Ніколи не відпускай те, що шукає оті прояви життя.",shape=box,color=blue];
		1444 -> 1448;
	1445 [label="Боги милосердні, коли ти ставиш слова саме так, то не дивно, що це видається дитячим жартом, n'est-ce pas ?",shape=box,color=blue];
		1445 -> 1449;
	1446 [label="Oui, oui. Кожні кілька тижнів ? Кожні два місяці ? Найдовше без проблем було десь шість місяців, напевно.",shape=box,color=blue];
		1446 -> 1450;
	1447 [label="О ! М-м-м. Гм. Це як головний біль, але набагато сильніший. Я чула, як інші називають його іноді жовчним болем. Таке в жінок частіше трапляється.",shape=box,color=blue];
		1447 -> 1451;
		1447 -> 1452;
	1448 [label="Світ занадто радо прагне стати темним і суворим місцем. Надто готовий нав’язати нам страждання на кожному кроці.",shape=box,color=blue];
		1448 -> 1453;
	1449 [label="Сестра, священник і диявол з майбутнього потрапляють у минуле… а потім у futur… і зустрічаються з рибою, оленеподібною істотою, велетенським птахом і дворецьким…",shape=box,color=blue];
		1449 -> 1454;
	1450 [label="Check boolean Megrim",color=orange];
		1450 -> 1455 [label=true,color=green];
		1450 -> 1456 [label=true,color=green];
		1450 -> 1458 [label=true,color=green];
		1450 -> 1455 [label=false,color=brown];
		1450 -> 1456 [label=false,color=brown];
		1450 -> 1457 [label=false,color=brown];
	1451 [label="Гадаю, ми звемо це «мігрень».",shape=box,color=red];
		1451 -> 1459;
	1452 [label="Гм. Меґрім. Дякую.",shape=box,color=red];
		1452 -> 1460;
	1453 [label="Ми повинні шукати будь-які прояви світла, якусь легковажність. Навіть якщо це буде по дитячому. Хай буде, якщо треба.",shape=box,color=blue];
		1453 -> 1461;
	1454 [label="Це й справді кумедно. Твоя правда !",shape=box,color=blue];
		1454 -> 1462;
	1455 [label="Цікаво, що провокує такий стан.",shape=box,color=red];
		1455 -> 1463;
	1456 [label="Жахливо…",shape=box,color=red];
		1456 -> 1464;
	1458 [label="У мене теж бувають меґріми. Вони жахливі.",shape=box,color=red];
		1458 -> 1465;
	1457 [label="У мене теж бувають подібні болі. Вони жахливі.",shape=box,color=red];
		1457 -> 1465;
	1459 [label="Цікаво, які інші історичні particularités ми відкриємо ! Це так захопливо. Я дуже люблю дізнаватися щос нове. «Мігрень». Схоже, що подорож у часі була недалекою.",shape=box,color=blue];
		1459 -> 1466;
	1460 [label="Update boolean Megrim",color=orange];
		1460 -> 1467;
	1461 [label="Якби ж то Ліон бачив це так само.",shape=box,color=blue];
		1461 -> 1468;
	1462 [label="Якби ж то мій дорогий Ліон бачив прояви світла так само.",shape=box,color=blue];
		1462 -> 1468;
	1463 [label="У нього є кілька теорій. ",shape=box,color=blue];
		1463 -> 1469;
	1464 [label="Якщо ти висловиш свої співчуття, то я точно впевнена, що вони будуть прийняті з удячністю. І попри те, як воно зі сторони, Ліон оцінив би твою товариськість.",shape=box,color=blue];
		1464 -> 1470;
	1465 [label="Серйозно ? Ти маєш поговорити з Ліоном. Йому варто знати, що інші теж можуть страждати як він.",shape=box,color=blue];
		1465 -> 1471;
	1466 [label="Update boolean Migraine",color=orange];
		1466 -> 1467;
	1467 [label="Назва неважлива. Ліон там сам один лежить і так буде аж до ранку. Бідолашний — не бачить нічого окрім розмитих образів, не відчуває рук та ніг. І він казав, що болить нестерпно.",shape=box,color=blue];
		1467 -> 1450;
	1468 [label="Update boolean MarieLyonSuffering1",color=orange];
		1468 -> 1472;
	1469 [label="Хоча, точніше було б написати: «У нього було кілька теорій… донедавна».",shape=box,color=blue];
		1469 -> 1473;
	1470 [label="Мандрівниче, коли він намагатиметься тебе відштовхнути, відмовитися, то прояви милосердя й тримайся, благаю. Може він зовні й стоїк із кам’яним обличчям, але всередині має велику потребу.",shape=box,color=blue];
		1470 -> 1474;
		1470 -> 1475;
		1470 -> 1476;
	1471 [label="+5 Chemistry",color=orange];
		1471 -> 1477;
	1472 [label="До речі про це. Це не мені варто скаржитися на головний біль. Маю віднести Ліону його вечерю. Він знову лежить покотом із жахливою megrim.",shape=box,color=blue];
		1472 -> 1443;
		1472 -> 1442;
	1473 [label="Update boolean MarieLyonFaith1",color=orange];
		1473 -> 1470;
	1474 [label="Я вмію проявляти надмірну впертість. Не переживай.",shape=box,color=red];
		1474 -> 1478;
	1475 [label="У мене вже є одна Людина в стіні… тож чому б їм не бути двом?",shape=box,color=red];
		1475 -> 1479;
	1476 [label="Він дорослий чоловік. Якщо захоче поговорити, то поговорить.",shape=box,color=red];
		1476 -> 1480;
	1477 [label="Світочам видно, що інакше б він залюбки страждав на самоті…",shape=box,color=blue];
		1477 -> 1481;
	1478 [label="+5 Chemistry",color=orange];
		1478 -> 1482;
	1479 [label="У такому тоні можеш жартувати зі мною, але при ньому не варто. Тема твоєї l'Indifférence дуже болісна для нього.",shape=box,color=blue];
		1479 -> 1483;
	1480 [label="Він дорослий — так, чоловік — так. І вірю, що бажає поговорити. Але запитай себе, чи він може.",shape=box,color=blue];
		1480 -> 1484;
	1481 [label="Update boolean MarieLyonSuffering2",color=orange];
		1481 -> 1470;
	1482 [label="Боюся, що з ним вона тобі знадобиться. Дякую, мандрівниче. Він мій найближчий друг, геть як брат. І моє серце крається, коли бачу його в таких муках.",shape=box,color=blue];
		1482 -> 1485;
	1483 [label="Стійкість. Терплячість. Доброта. Це знадобиться. Мандрівниче, він як брат мені. Мій найближчий друг. Моє серце крається, коли я бачу його в таких муках.",shape=box,color=blue];
		1483 -> 1485;
	1484 [label="Не всі з нас однаково обдаровані чи відчуваємо, що маємо право на подібне. Йому болить, і він вважає, що страждання — його доля.",shape=box,color=blue];
		1484 -> 1486;
	1485 [label="Незабаром знову поспілкуємося. Par la grâce de Sol.",shape=box,color=blue];
		1485 -> 3734;
	1486 [label="Він як брат для мене, мій найближчий друг. Моє серце крається від переживань за нього. Тож єдине що прошу… зберігати терплячість. І доброту. Якщо зможеш.",shape=box,color=blue];
		1486 -> 1485;
	3734 [label="{\"Id\":3734,\"Incoming\":[1485],\"Outgoing\":[1487],\"GraphPos\":[12826,24521],\"CompletionType\":2,\"OtherDialogueInfos\":[{\"Dialogue\":\"/Lotus/Types/Gameplay/1999Wf/Dialogue/LyonDialogue_rom.dialogue\",\"Tag\":\"LyonHeadaches\",\"Value\":0}]}",color=orange];
		3734 -> 1487;
	1487 [label="Chat ends.",color=orange];
}