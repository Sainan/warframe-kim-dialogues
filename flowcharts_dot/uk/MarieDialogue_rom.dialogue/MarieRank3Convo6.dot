digraph {
	graph [fontname="Roboto Condensed"];
	node [fontname="Roboto Condensed"];
	edge [fontname="Roboto Condensed"];

	"MarieRank3Convo6 begins." [color=orange];
		"MarieRank3Convo6 begins." -> j355680765;
	j355680765 [label="Boolean MarieLyonAvailable is now true.",color=orange];
		j355680765 -> j3851012757;
	j3851012757 [label="Мандрівниче, я маю спитати, але благаю не засуджувати за це.",shape=box,color=blue];
		j3851012757 -> j4172005100;
		j3851012757 -> j2613312782;
		j3851012757 -> j1478915251;
	j4172005100 [label="Тебе закинули в дивний час і простір. Звісно я не засуджуватиму.",shape=box,color=red];
		j4172005100 -> j2945294023;
	j2613312782 [label="Зроблю все можливе.",shape=box,color=red];
		j2613312782 -> j2980725640;
	j1478915251 [label="[Завершити розмову]",shape=box,color=red];
		j1478915251 -> "Chat ends.";
	j2945294023 [label="Vraiment gentil з твого боку виявляти таку милість, абсолютно не знаючи мене чи навіть питання, яке я збиралася написати.",shape=box,color=blue];
		j2945294023 -> j4089625871;
	j2980725640 [label="+10 Chemistry",color=orange];
		j2980725640 -> j1828380976;
	"Chat ends." [color=orange];
	j4089625871 [label="Отже… у тебе від тої велетеголової риби теж голова болить ? Від Фібоначчі ?",shape=box,color=blue];
		j4089625871 -> j345464134;
		j4089625871 -> j2513114650;
		j4089625871 -> j3905757317;
	j1828380976 [label="Дуже вдячна за це.",shape=box,color=blue];
		j1828380976 -> j4089625871;
	j345464134 [label="Так. Цілковито. Дякую.",shape=box,color=red];
		j345464134 -> j3425977719;
	j2513114650 [label="Натяк на те, що Фібоначчі дістає тебе, неймовірно милий.",shape=box,color=red];
		j2513114650 -> j2072798451;
	j3905757317 [label="Та ні, геть ні. Я обожнюю його.",shape=box,color=red];
		j3905757317 -> j708572621;
	j3425977719 [label="Тоді я рада, що не одна така. Зазначу, я геть не збираюся ображати його. Якщо я геть не при собі через поточну ситуацію, то уявляю, як йому. Певно, ледь стримується.",shape=box,color=blue];
		j3425977719 -> j3234947729;
	j2072798451 [label="О ? Як так ? Напевно, я маю радіти цьому, але це спантеличує. Мій головний біль — точно не миле відчуття.",shape=box,color=blue];
		j2072798451 -> j919898671;
		j2072798451 -> j613826427;
	j708572621 [label="Тоді я можу лише просити пробачення. Зазначу, я геть не збираюся ображати його. Якщо я геть не при собі через поточну ситуацію, то уявляю як йому. Певно, ледь стримується.",shape=box,color=blue];
		j708572621 -> j624010728;
	j3234947729 [label="Просто його спосіб робити це не дуже влаштовує мене, коли доводиться тривалий час із цим стикатися, c'est tout.",shape=box,color=blue];
		j3234947729 -> j3068139508;
	j919898671 [label="Більшість мого життя проведене в боях за виживання. Дрібні нагадування про людяність… як от ці… Ну, це те, заради чого я живу.",shape=box,color=red];
		j919898671 -> j2179802210;
	j613826427 [label="Припускаю, що іноді мені потрібно дивитися з іншої перспективи й міркувати про абсурдність усього цього гармидеру. Норґ і жриця Сола…",shape=box,color=red];
		j613826427 -> j2042077350;
	j624010728 [label="Просто його спосіб робити це не дуже влаштовує мене, коли доводиться тривалий час із цим стикатися, c'est tout.",shape=box,color=blue];
		j624010728 -> j3068139508;
	j3068139508 [label="Та. Узагалі ж мені не варто скаржитися. Маю віднести Ліону його вечерю. Він знову лежить покотом із жахливою megrim.",shape=box,color=blue];
		j3068139508 -> j1025120231;
		j3068139508 -> j2887724259;
	j2179802210 [label="+5 Chemistry",color=orange];
		j2179802210 -> j1900785656;
	j2042077350 [label="+5 Chemistry",color=orange];
		j2042077350 -> j90944709;
	j1025120231 [label="У нього часто вони бувають?",shape=box,color=red];
		j1025120231 -> j1652730620;
	j2887724259 [label="Перепрошую… із чим він лежить?",shape=box,color=red];
		j2887724259 -> j1682993401;
	j1900785656 [label="Мандрівниче, бережи цю частину себе. Ніколи не відпускай те, що шукає оті прояви життя.",shape=box,color=blue];
		j1900785656 -> j1362707740;
	j90944709 [label="Боги милосердні, коли ти ставиш слова саме так, то не дивно, що це видається дитячим жартом, n'est-ce pas ?",shape=box,color=blue];
		j90944709 -> j2358872395;
	j1652730620 [label="Oui, oui. Кожні кілька тижнів ? Кожні два місяці ? Найдовше без проблем було десь шість місяців, напевно.",shape=box,color=blue];
		j1652730620 -> j547018639;
	j1682993401 [label="О ! М-м-м. Гм. Це як головний біль, але набагато сильніший. Я чула, як інші називають його іноді жовчним болем. Таке в жінок частіше трапляється.",shape=box,color=blue];
		j1682993401 -> j966514650;
		j1682993401 -> j3680808237;
	j1362707740 [label="Світ занадто радо прагне стати темним і суворим місцем. Надто готовий нав’язати нам страждання на кожному кроці.",shape=box,color=blue];
		j1362707740 -> j1997318593;
	j2358872395 [label="Сестра, священник і диявол з майбутнього потрапляють у минуле… а потім у futur… і зустрічаються з рибою, оленеподібною істотою, велетенським птахом і дворецьким…",shape=box,color=blue];
		j2358872395 -> j3429611523;
	j547018639 [label="Check boolean Megrim",color=orange];
		j547018639 -> j3280206942 [label=true,color=green];
		j547018639 -> j2137757975 [label=true,color=green];
		j547018639 -> j913672331 [label=true,color=green];
		j547018639 -> j3280206942 [label=false,color=brown];
		j547018639 -> j2137757975 [label=false,color=brown];
		j547018639 -> j1344297519 [label=false,color=brown];
	j966514650 [label="Гадаю, ми звемо це «мігрень».",shape=box,color=red];
		j966514650 -> j1621242372;
	j3680808237 [label="Гм. Меґрім. Дякую.",shape=box,color=red];
		j3680808237 -> j3625031381;
	j1997318593 [label="Ми повинні шукати будь-які прояви світла, якусь легковажність. Навіть якщо це буде по дитячому. Хай буде, якщо треба.",shape=box,color=blue];
		j1997318593 -> j598344563;
	j3429611523 [label="Це й справді кумедно. Твоя правда !",shape=box,color=blue];
		j3429611523 -> j1164504562;
	j3280206942 [label="Цікаво, що провокує такий стан.",shape=box,color=red];
		j3280206942 -> j540207611;
	j2137757975 [label="Жахливо…",shape=box,color=red];
		j2137757975 -> j698029398;
	j913672331 [label="У мене теж бувають меґріми. Вони жахливі.",shape=box,color=red];
		j913672331 -> j1711103595;
	j1344297519 [label="У мене теж бувають подібні болі. Вони жахливі.",shape=box,color=red];
		j1344297519 -> j1711103595;
	j1621242372 [label="Цікаво, які інші історичні particularités ми відкриємо ! Це так захопливо. Я дуже люблю дізнаватися щос нове. «Мігрень». Схоже, що подорож у часі була недалекою.",shape=box,color=blue];
		j1621242372 -> j2575379931;
	j3625031381 [label="Boolean Megrim is now true.",color=orange];
		j3625031381 -> j1731340977;
	j598344563 [label="Якби ж то Ліон бачив це так само.",shape=box,color=blue];
		j598344563 -> j1899672806;
	j1164504562 [label="Якби ж то мій дорогий Ліон бачив прояви світла так само.",shape=box,color=blue];
		j1164504562 -> j1899672806;
	j540207611 [label="У нього є кілька теорій. ",shape=box,color=blue];
		j540207611 -> j1850521153;
	j698029398 [label="Якщо ти висловиш свої співчуття, то я точно впевнена, що вони будуть прийняті з удячністю. І попри те, як воно зі сторони, Ліон оцінив би твою товариськість.",shape=box,color=blue];
		j698029398 -> j221423557;
	j1711103595 [label="Серйозно ? Ти маєш поговорити з Ліоном. Йому варто знати, що інші теж можуть страждати як він.",shape=box,color=blue];
		j1711103595 -> j1502677238;
	j2575379931 [label="Boolean Migraine is now true.",color=orange];
		j2575379931 -> j1731340977;
	j1731340977 [label="Назва неважлива. Ліон там сам один лежить і так буде аж до ранку. Бідолашний — не бачить нічого окрім розмитих образів, не відчуває рук та ніг. І він казав, що болить нестерпно.",shape=box,color=blue];
		j1731340977 -> j547018639;
	j1899672806 [label="Boolean MarieLyonSuffering1 is now true.",color=orange];
		j1899672806 -> j3680520816;
	j1850521153 [label="Хоча, точніше було б написати: «У нього було кілька теорій… донедавна».",shape=box,color=blue];
		j1850521153 -> j3307570863;
	j221423557 [label="Мандрівниче, коли він намагатиметься тебе відштовхнути, відмовитися, то прояви милосердя й тримайся, благаю. Може він зовні й стоїк із кам’яним обличчям, але всередині має велику потребу.",shape=box,color=blue];
		j221423557 -> j4111100554;
		j221423557 -> j1726343625;
		j221423557 -> j4215049228;
	j1502677238 [label="+5 Chemistry",color=orange];
		j1502677238 -> j2010336154;
	j3680520816 [label="До речі про це. Це не мені варто скаржитися на головний біль. Маю віднести Ліону його вечерю. Він знову лежить покотом із жахливою megrim.",shape=box,color=blue];
		j3680520816 -> j2887724259;
		j3680520816 -> j1025120231;
	j3307570863 [label="Boolean MarieLyonFaith1 is now true.",color=orange];
		j3307570863 -> j221423557;
	j4111100554 [label="Я вмію проявляти надмірну впертість. Не переживай.",shape=box,color=red];
		j4111100554 -> j1559369125;
	j1726343625 [label="У мене вже є одна Людина в стіні… тож чому б їм не бути двом?",shape=box,color=red];
		j1726343625 -> j1322454426;
	j4215049228 [label="Він дорослий чоловік. Якщо захоче поговорити, то поговорить.",shape=box,color=red];
		j4215049228 -> j816301758;
	j2010336154 [label="Світочам видно, що інакше б він залюбки страждав на самоті…",shape=box,color=blue];
		j2010336154 -> j3498601177;
	j1559369125 [label="+5 Chemistry",color=orange];
		j1559369125 -> j125369656;
	j1322454426 [label="У такому тоні можеш жартувати зі мною, але при ньому не варто. Тема твоєї l'Indifférence дуже болісна для нього.",shape=box,color=blue];
		j1322454426 -> j35028527;
	j816301758 [label="Він дорослий — так, чоловік — так. І вірю, що бажає поговорити. Але запитай себе, чи він може.",shape=box,color=blue];
		j816301758 -> j2075244554;
	j3498601177 [label="Boolean MarieLyonSuffering2 is now true.",color=orange];
		j3498601177 -> j221423557;
	j125369656 [label="Боюся, що з ним вона тобі знадобиться. Дякую, мандрівниче. Він мій найближчий друг, геть як брат. І моє серце крається, коли бачу його в таких муках.",shape=box,color=blue];
		j125369656 -> j4219584975;
	j35028527 [label="Стійкість. Терплячість. Доброта. Це знадобиться. Мандрівниче, він як брат мені. Мій найближчий друг. Моє серце крається, коли я бачу його в таких муках.",shape=box,color=blue];
		j35028527 -> j4219584975;
	j2075244554 [label="Не всі з нас однаково обдаровані чи відчуваємо, що маємо право на подібне. Йому болить, і він вважає, що страждання — його доля.",shape=box,color=blue];
		j2075244554 -> j1373181443;
	j4219584975 [label="Незабаром знову поспілкуємося. Par la grâce de Sol.",shape=box,color=blue];
		j4219584975 -> "Initiate conversation LyonHeadaches in /Lotus/Types/Gameplay/1999Wf/Dialogue/LyonDialogue_rom.dialogue";
	j1373181443 [label="Він як брат для мене, мій найближчий друг. Моє серце крається від переживань за нього. Тож єдине що прошу… зберігати терплячість. І доброту. Якщо зможеш.",shape=box,color=blue];
		j1373181443 -> j4219584975;
	"Initiate conversation LyonHeadaches in /Lotus/Types/Gameplay/1999Wf/Dialogue/LyonDialogue_rom.dialogue" [label="Initiate conversation LyonHeadaches in /Lotus/Types/Gameplay/1999Wf/Dialogue/LyonDialogue_rom.dialogue",color=orange];
		"Initiate conversation LyonHeadaches in /Lotus/Types/Gameplay/1999Wf/Dialogue/LyonDialogue_rom.dialogue" -> "Chat ends.";
}