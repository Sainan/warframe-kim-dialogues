digraph {
	3815 [label="MarieRoatheRepair begins.",color=orange];
		3815 -> 3816;
	3816 [label="Evaluate expressions",color=orange];
		3816 -> 3817 [label="RoatheMarieDatingDeal, MarieNoDate",color=purple];
		3816 -> 3818 [label="RoatheFamilyDeal, MarieFamilyFail",color=purple];
		3816 -> 3818 [label="MarieFamilyFail",color=purple];
		3816 -> 3819 [label="RoatheMarieEntratiDeal, MarieEntratiCompleteB",color=purple];
		3816 -> 3819 [label="RoatheMarieEntratiDeal, MarieEntratiCompleteC",color=purple];
		3816 -> 3820 [label="false",color=purple];
	3817 [label="Мандрівниче. Диявол переслідує мене. До печінок дістав своїми дрібними демонами ! І все це заради тебе ! Каже, що ти лише хочеш впасти навколішки й вибачитися.",shape=box,color=blue];
		3817 -> 3821;
		3817 -> 3822;
	3818 [label="Диявол переслідує мене. До печінок дістав своїми дрібними демонами ! І все це заради тебе ! Каже, що ти хочеш обговорити мою допомогу в доправлянні монсеньйора Лойда нагору.",shape=box,color=blue];
		3818 -> 3823;
		3818 -> 3824;
	3819 [label="Диявол переслідує мене. До печінок дістав своїми дрібними демонами ! І все це заради тебе ! Каже, що ти хочеш обговорити ще раз мою відданість le Cardinal.",shape=box,color=blue];
		3819 -> 3825;
		3819 -> 3826;
	3820 [label="Chat ends.",color=orange];
	3821 [label="Так.",shape=box,color=red];
		3821 -> 3827;
	3822 [label="Серйозно?",shape=box,color=red];
		3822 -> 3828;
	3823 [label="Так.",shape=box,color=red];
		3823 -> 3829;
	3824 [label="Серйозно?",shape=box,color=red];
		3824 -> 3828;
	3825 [label="Так.",shape=box,color=red];
		3825 -> 3830;
	3826 [label="Серйозно?",shape=box,color=red];
		3826 -> 3828;
	3827 [label="Мені дуже шкода. Мої слова образили тебе. Цього не планувалося. Це було б останнім, чого мені хотілося. Повір.",shape=box,color=red];
		3827 -> 3831;
	3828 [label="Je vais le tuer ! Je savais que ce démon était rempli de la pire merde qui soit ! Je vais renvoyer ses conscrits d'où ils viennent par la peau des fesses !",shape=box,color=blue];
		3828 -> 3832;
	3829 [label="Не буду писати багато, бо він навів чимало доказів поки тебе не було. І як буває зі справжніми дияволами — ці аргументи були дуже вагомими.",shape=box,color=blue];
		3829 -> 3833;
	3830 [label="Не буду писати багато, бо він навів чимало доказів поки тебе не було. І як буває зі справжніми дияволами — ці аргументи були дуже вагомими.",shape=box,color=blue];
		3830 -> 3834;
	3831 [label="І чого б це ?",shape=box,color=blue];
		3831 -> 3835;
		3831 -> 3836;
	3832 [label="Chat ends.",color=orange];
	3833 [label="Маю визнати… мене вже трохи втомлює перебування тут унизу sans recours.",shape=box,color=blue];
		3833 -> 3837;
	3834 [label="Та це були не слова, а кмітливість. Їй дякувати. Він посадив мене поруч із монсеньйором Лойдом.",shape=box,color=blue];
		3834 -> 3838;
		3834 -> 3839;
	3835 [label="[Зізнатися в почуттях] Бо ти небайдужа мені. Я обожнюю тебе.",shape=box,color=red];
		3835 -> 3840;
	3836 [label="Не зважай. Це була необдумана помилка.",shape=box,color=red];
		3836 -> 3841;
	3837 [label="Тож я скажу — так, згода. Я допоможу тобі. Ви можете покластися на мене.",shape=box,color=blue];
		3837 -> 3842;
	3838 [label="Гм?",shape=box,color=red];
		3838 -> 3843;
	3839 [label="Але ж Лойд кохає Альбрехта. Хіба ні?",shape=box,color=red];
		3839 -> 3844;
	3840 [label="Я знаю, що мені зараз влетить. Але узріть — я це роблю.",shape=box,color=red];
		3840 -> 3845;
	3841 [label="Ти така ж погань, як і він.",shape=box,color=blue];
		3841 -> 3846;
	3842 [label="Update boolean MarieFamilySuccess",color=orange];
		3842 -> 3847;
	3843 [label="Ясність бачення Лойда допомогла мені узріти крізь власні затьмарені лінзи. Лойд кохає le Cardinal — свого Альбрехта — та бачить його цілого, з усіма недоліками.",shape=box,color=blue];
		3843 -> 3848;
	3844 [label="Так. Так і є. Однак бачить його повністю, з усіма недоліками. І його ясність бачення допомогла мені узріти крізь власні затьмарені лінзи.",shape=box,color=blue];
		3844 -> 3848;
	3845 [label="Мені шкода, що довелося залучати Роута, щоби привернути твою увагу, але не було більше до кого звернутися.",shape=box,color=red];
		3845 -> 3849;
	3846 [label="Chat ends.",color=orange];
	3847 [label="Update boolean MarieFamilyFail",color=orange];
		3847 -> 3850;
	3848 [label="Хіба когось кохати не означає приймати як є — з усіма найгіршими та найліпшими якостями, après tout ?",shape=box,color=blue];
		3848 -> 3851;
	3849 [label="Ох, мандрівниче… бідолашне. Не варто було заходити так далеко, щоб отримати моє прощення. ",shape=box,color=blue];
		3849 -> 3852;
	3850 [label="Chat ends.",color=orange];
	3851 [label="Update boolean MarieEntratiCompleteA",color=orange];
		3851 -> 3853;
	3852 [label="Варто було лише спитати і я одразу пробачила б. Хіба не знаєш, що в моєму серці є місце для тебе ?",shape=box,color=blue];
		3852 -> 3854;
		3852 -> 3855;
	3853 [label="Update boolean MarieEntratiCompleteB",color=orange];
		3853 -> 3856;
	3854 [label="Я… чесно?",shape=box,color=red];
		3854 -> 3857;
	3855 [label="Але ж мені довелося стільки постраждати…",shape=box,color=red];
		3855 -> 3858;
	3856 [label="Update boolean MarieEntratiCompleteC",color=orange];
		3856 -> 3859;
	3857 [label="Oui ! І якщо ти бажаєш бути разом зі мною, то я хочу того ж самого.",shape=box,color=blue];
		3857 -> 3860;
		3857 -> 3861;
	3858 [label="І це лише твоя власна провина, не моя ! Та якщо ти бажаєш бути разом зі мною, то я хочу того ж самого.",shape=box,color=blue];
		3858 -> 3861;
		3858 -> 3860;
	3859 [label="Chat ends.",color=orange];
	3860 [label="Марі, я залюбки.",shape=box,color=red];
		3860 -> 3862;
	3861 [label="Хоча знаєш, я пас.",shape=box,color=red];
		3861 -> 3863;
	3862 [label="Ой ! Я така щаслива !",shape=box,color=blue];
		3862 -> 3864;
	3863 [label="Je vais te jeter directement dans le Néant.",shape=box,color=blue];
		3863 -> 3865;
	3864 [label="Update boolean MarieDating",color=orange];
		3864 -> 3866;
	3865 [label="Chat ends.",color=orange];
	3866 [label="Update boolean IsDating",color=orange];
		3866 -> 3867;
	3867 [label="Update boolean MarieHasDated",color=orange];
		3867 -> 3868;
	3868 [label="Update boolean MarieWillDate",color=orange];
