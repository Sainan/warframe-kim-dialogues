		j4217867269 -> j2544739455 [label="RoatheMarieEntratiDeal & MarieEntratiCompleteC",color=purple];
		j4217867269 -> "Chat ends." [label="false",color=purple];
	j2580789034 [label="Мандрівниче. Диявол переслідує мене. До печінок дістав своїми дрібними демонами ! І все це заради тебе ! Каже, що ти лише хочеш впасти навколішки й вибачитися.",shape=box,color=blue];
		j2580789034 -> j1860167192;
		j2580789034 -> j1811479537;
	j2688420237 [label="Диявол переслідує мене. До печінок дістав своїми дрібними демонами ! І все це заради тебе ! Каже, що ти хочеш обговорити мою допомогу в доправлянні монсеньйора Лойда нагору.",shape=box,color=blue];
		j2688420237 -> j610784064;
		j2688420237 -> j1811479537;
	j2544739455 [label="Диявол переслідує мене. До печінок дістав своїми дрібними демонами ! І все це заради тебе ! Каже, що ти хочеш обговорити ще раз мою відданість le Cardinal.",shape=box,color=blue];
		j2544739455 -> j2284873628;
		j2544739455 -> j1811479537;
	"Chat ends." [color=orange];
	j1860167192 [label="Так.",shape=box,color=red];
		j1860167192 -> j1818075622;
	j1811479537 [label="Серйозно?",shape=box,color=red];
		j1811479537 -> j4177712951;
	j610784064 [label="Так.",shape=box,color=red];
		j610784064 -> j762569387;
	j2284873628 [label="Так.",shape=box,color=red];
		j2284873628 -> j874585263;
	j1818075622 [label="Мені дуже шкода. Мої слова образили тебе. Цього не планувалося. Це було б останнім, чого мені хотілося. Повір.",shape=box,color=red];
		j1818075622 -> j344859265;
	j4177712951 [label="Je vais le tuer ! Je savais que ce démon était rempli de la pire merde qui soit ! Je vais renvoyer ses conscrits d'où ils viennent par la peau des fesses !",shape=box,color=blue];
		j4177712951 -> "Chat ends.";
	j762569387 [label="Не буду писати багато, бо він навів чимало доказів поки тебе не було. І як буває зі справжніми дияволами — ці аргументи були дуже вагомими.",shape=box,color=blue];
		j762569387 -> j3345663161;
	j874585263 [label="Не буду писати багато, бо він навів чимало доказів поки тебе не було. І як буває зі справжніми дияволами — ці аргументи були дуже вагомими.",shape=box,color=blue];
		j874585263 -> j2354932531;
	j344859265 [label="І чого б це ?",shape=box,color=blue];
		j344859265 -> j3586475740;
		j344859265 -> j3987275210;
	j3345663161 [label="Маю визнати… мене вже трохи втомлює перебування тут унизу sans recours.",shape=box,color=blue];
		j3345663161 -> j3024705479;
	j2354932531 [label="Та це були не слова, а кмітливість. Їй дякувати. Він посадив мене поруч із монсеньйором Лойдом.",shape=box,color=blue];
		j2354932531 -> j3326743767;
		j2354932531 -> j3771342315;
	j3586475740 [label="[Зізнатися в почуттях] Бо ти небайдужа мені. Я обожнюю тебе.",shape=box,color=red];
		j3586475740 -> j2737625793;
	j3987275210 [label="Не зважай. Це була необдумана помилка.",shape=box,color=red];
		j3987275210 -> j2881647783;
	j3024705479 [label="Тож я скажу — так, згода. Я допоможу тобі. Ви можете покластися на мене.",shape=box,color=blue];
		j3024705479 -> j3151953893;
	j3326743767 [label="Гм?",shape=box,color=red];
		j3326743767 -> j3204731949;
	j3771342315 [label="Але ж Лойд кохає Альбрехта. Хіба ні?",shape=box,color=red];
		j3771342315 -> j3395473430;
	j2737625793 [label="Я знаю, що мені зараз влетить. Але узріть — я це роблю.",shape=box,color=red];
		j2737625793 -> j2679111627;
	j2881647783 [label="Ти така ж погань, як і він.",shape=box,color=blue];
		j2881647783 -> "Chat ends.";
	j3151953893 [label="Boolean MarieFamilySuccess is now true.",color=orange];
		j3151953893 -> j2529015854;
	j3204731949 [label="Ясність бачення Лойда допомогла мені узріти крізь власні затьмарені лінзи. Лойд кохає le Cardinal — свого Альбрехта — та бачить його цілого, з усіма недоліками.",shape=box,color=blue];
		j3204731949 -> j1831247945;
	j3395473430 [label="Так. Так і є. Однак бачить його повністю, з усіма недоліками. І його ясність бачення допомогла мені узріти крізь власні затьмарені лінзи.",shape=box,color=blue];
		j3395473430 -> j1831247945;
	j2679111627 [label="Мені шкода, що довелося залучати Роута, щоби привернути твою увагу, але не було більше до кого звернутися.",shape=box,color=red];
		j2679111627 -> j2621960117;
	j2529015854 [label="Boolean MarieFamilyFail is now false.",color=orange];
		j2529015854 -> "Chat ends.";
	j1831247945 [label="Хіба когось кохати не означає приймати як є — з усіма найгіршими та найліпшими якостями, après tout ?",shape=box,color=blue];
		j1831247945 -> j3722403271;
	j2621960117 [label="Ох, мандрівниче… бідолашне. Не варто було заходити так далеко, щоб отримати моє прощення. ",shape=box,color=blue];
		j2621960117 -> j3076732245;
	j3722403271 [label="Boolean MarieEntratiCompleteA is now true.",color=orange];
		j3722403271 -> j2737891827;
	j3076732245 [label="Evaluate expressions",color=orange];
