	j2737891827 [label="Boolean MarieEntratiCompleteB is now false.",color=orange];
		j2737891827 -> j3065315887;
	j2596465703 [label="Боюся, що твоя душа вже належить дияволу, non ? Я не лізтиму в його справи.",shape=box,color=blue];
		j2596465703 -> j1974661748;
	j2614661630 [label="Боюся, що твоє серце вже належить моєму духовному брату. Я не вириватиму його в нього.",shape=box,color=blue];
		j2614661630 -> j1974661748;
	j3428206912 [label="Варто було лише спитати і я одразу пробачила б. Хіба не знаєш, що в моєму серці є місце для тебе ?",shape=box,color=blue];
		j3428206912 -> j464414621;
		j3428206912 -> j3307813032;
	j3065315887 [label="Boolean MarieEntratiCompleteC is now false.",color=orange];
		j3065315887 -> "Chat ends.";
	j1974661748 [label="Я можу пробачити твої минулі помилки, але самотужки маєш вирішити, що робитимеш з іншими.",shape=box,color=blue];
		j1974661748 -> j1861620230;
	j464414621 [label="Я… чесно?",shape=box,color=red];
		j464414621 -> j475000344;
	j3307813032 [label="Але ж мені довелося стільки постраждати…",shape=box,color=red];
		j3307813032 -> j5612232;
	j1861620230 [label="Упевнена, ти розумієш, n’est pas ?",shape=box,color=blue];
		j1861620230 -> j3947636400;
	j475000344 [label="Oui ! І якщо ти бажаєш бути разом зі мною, то я хочу того ж самого.",shape=box,color=blue];
		j475000344 -> j464276040;
		j475000344 -> j1228320586;
	j5612232 [label="І це лише твоя власна провина, не моя ! Та якщо ти бажаєш бути разом зі мною, то я хочу того ж самого.",shape=box,color=blue];
		j5612232 -> j1228320586;
		j5612232 -> j464276040;
