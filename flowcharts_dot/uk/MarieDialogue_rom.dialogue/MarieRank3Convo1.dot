	j678585395 [label="Боюся, що ми не багато знаємо про людей, які перетворилися на перших оригінальних ворфреймів.",shape=box,color=red];
		j678585395 -> j3794676397;
	j1926597377 [label="Боюся, що про справжню Вісп не багато є інформації.",shape=box,color=red];
		j1926597377 -> j3794676397;
	j1329785476 [label="Розкажи мені, вовченя, про цю так звану «Вісп», чия спотворена кров тече в мені і яка дарувала мені політ. Про ту, чию душу я відчуваю так близько біля своєї, коли ніч сповиває все своїм саваном.",shape=box,color=blue];
		j1329785476 -> j797278938;
		j1329785476 -> j599025334;
	j4111010830 [label="Розкажи мені, вовченя, про цю так звану «Вісп», чия спотворена кров тече в мені і яка дарувала мені політ. Про ту, чию душу я відчуваю так близько біля своєї, коли ніч сповиває все своїм саваном.",shape=box,color=blue];
		j4111010830 -> j788924547;
	j3794676397 [label="Vraiment ? Усі записи загубилися за довгі роки чи є підозра, що їх уважали недостатньо важливими для запам’ятовування ?",shape=box,color=blue];
		j3794676397 -> j654803311;
		j3794676397 -> j3210682398;
		j3794676397 -> j3789380380;
	j797278938 [label="Боюся, що ми не багато знаємо про людей, які перетворилися на перших оригінальних ворфреймів.",shape=box,color=red];
		j797278938 -> j805555857;
	j599025334 [label="Боюся, що про справжню Вісп не багато є інформації.",shape=box,color=red];
		j599025334 -> j805555857;
	j788924547 [label="Якщо розмова про душі не бентежить тебе ? Я все зрозумію, якщо це незручна тема. Тоді ми перейдемо до практичніших речей. Не хочу ставити тебе в незручне становище.",shape=box,color=blue];
		j788924547 -> j2034067160;
		j788924547 -> j3539215369;
		j788924547 -> j1478915251;
	j654803311 [label="Гадаю, що це було не надто важливим, щоби зберігати й запам’ятовувати.",shape=box,color=red];
		j654803311 -> j692847291;
	j3210682398 [label="Думаю, ця інформація загубилася за стільки років.",shape=box,color=red];
		j3210682398 -> j692847291;
	j3789380380 [label="Зрештою, і те, і інше… усього потроху. Для першотворця вони були… частково зброя, частково витвір мистецтва.",shape=box,color=red];
		j3789380380 -> j623489058;
	j805555857 [label="Vraiment ? Бо за відчуттями я ніби знаю її як сестру — по крові, а не як ті з Cathédrale.",shape=box,color=blue];
		j805555857 -> j3009925394;
	j2034067160 [label="Усе гаразд, можемо говорити про душі.",shape=box,color=red];
		j2034067160 -> j797278938;
		j2034067160 -> j599025334;
		j2034067160 -> j1478915251;
	j3539215369 [label="Я не дуже вірю в існування душ, тож триматимемося голих фактів, якщо можна?",shape=box,color=red];
		j3539215369 -> j1072077367;
	j1478915251 [label="[Завершити розмову]",shape=box,color=red];
		j1478915251 -> "Chat ends.";
	j692847291 [label="Бачиш ? Ces Orokin дияволи.",shape=box,color=blue];
		j692847291 -> j2484161210;
		j692847291 -> j1408403503;
	j623489058 [label="+5 Chemistry",color=orange];
		j623489058 -> j2409898218;
	j3009925394 [label="Я не чую її. Усе не так, як Ліон чує богів та духів-наставників. Я не бачу її. Просто відчуваю поруч із собою.",shape=box,color=blue];
		j3009925394 -> j3704168780;
	j1072077367 [label="Boolean DrifterFaithStop is now true.",color=orange];
		j1072077367 -> j3848566628;
	"Chat ends." [color=orange];
	j2484161210 [label="Зброю можна використовувати як для захисту, так і для нападу. Ми не в захваті від того, що вона потрібна нам… але вона потрібна.",shape=box,color=red];
		j2484161210 -> j1980641437;
	j1408403503 [label="Не всі з них. Але конкретно той? О так. Проте є кілька, котрих не можна одразу безумовно засуджувати.",shape=box,color=red];
		j1408403503 -> j1631474711;
	j2409898218 [label="Une horrible toile d'os peinte avec du sang… ти ж бачиш ? Ces Orokin дияволи.",shape=box,color=blue];
		j2409898218 -> j2484161210;
		j2409898218 -> j1408403503;
	j3704168780 [label="Може як стару подругу. Знаю, що їй подобалося, як вона рухалася. Я пам’ятаю як звучить її сміх, що розноситься вітром…",shape=box,color=blue];
		j3704168780 -> j2311187488;
	j3848566628 [label="+5 Chemistry",color=orange];
		j3848566628 -> j2022233767;
	j1980641437 [label="Add -1 to Thermostat counter",color=orange];
		j1980641437 -> j2636320842;
	j1631474711 [label="Add 1 to Thermostat counter",color=orange];
		j1631474711 -> j4204233585;
	j2311187488 [label="Певно, ці слова схожі на балачку божевільної ! Ти пробач мені.",shape=box,color=blue];
		j2311187488 -> j2866185221;
		j2311187488 -> j1938405837;
		j2311187488 -> j496557214;
		j2311187488 -> j3204472576;
	j2022233767 [label="Oui, bien sûr ! Ніхто не хоче вислуховувати повчання, особливо від сестри. Я розумію й дякую. Не хочеться показати себе дурепою.",shape=box,color=blue];
		j2022233767 -> j678585395;
		j2022233767 -> j1926597377;
		j2022233767 -> j1478915251;
	j2636320842 [label="Так, це правда. Я зараз зброя, і Murmure це добре відчуває ! Та я прагну йти шляхом, який указав le Cardinal, най буде благословенним.",shape=box,color=blue];
		j2636320842 -> j3707261529;
		j2636320842 -> j1070329764;
	j4204233585 [label="Як le Cardinal. Він був орокіном, non ? І він точно не з тих, кого я б осудила. Без нього я не стала б такою, яка є зараз. Хай буде благословенним.",shape=box,color=blue];
		j4204233585 -> j1375917400;
		j4204233585 -> j3863912201;
	j2866185221 [label="Ворфреймів створили… не в найгуманніший спосіб. Сподіваюся, вона не застрягла десь у зараженні.",shape=box,color=red];
		j2866185221 -> j2236052943;
	j1938405837 [label="Гадаю, ким би не була Вісп, але вона з радістю познайомилася б з тобою.",shape=box,color=red];
		j1938405837 -> j2082978242;
	j496557214 [label="Сподіваюся, їхні душі змогли дістатися далі й знайти спокій, але на мою думку частина спогадів лишилася.",shape=box,color=red];
		j496557214 -> j1069375316;
	j3204472576 [label="Та ні. Усе добре. Я вірю в те, що якась частка від людей, яких перетворили на ворфрейми, лишилася в межах основних систем.",shape=box,color=red];
		j3204472576 -> j502898188;
	j3707261529 [label="Є чимало тем для суперечок із ним, але скажу, що в нього наче непоганий хист давати сироватку протофреймів саме потрібним людям. Навіть якщо гадки не маю, для чого він це робить.",shape=box,color=red];
		j3707261529 -> j4136543739;
	j1070329764 [label="Мені дуже б хотілося, щоб ти не довіряла Ентраті так само сильно, як наразі довіряєш. Ми не знаємо, чому він обирає діяти так, як діє. Його мотиви неясні.",shape=box,color=red];
		j1070329764 -> j1722407835;
	j1375917400 [label="Маємо триматися Ентраті. Слідувати за ним туди, куди йде. Бо це наш єдиний шанс зупинити Байдужість.",shape=box,color=red];
		j1375917400 -> j737842484;
	j3863912201 [label="Марі, він брехун. Він кидає й завдає болю всім у своєму житті. Він уже покинув тебе, хіба ти не бачиш? ",shape=box,color=red];
		j3863912201 -> j1591510439;
	j2236052943 [label="+5 Chemistry",color=orange];
		j2236052943 -> j210515855;
	j2082978242 [label="+5 Chemistry",color=orange];
		j2082978242 -> j3669669913;
	j1069375316 [label="+5 Chemistry",color=orange];
		j1069375316 -> j1547936376;
	j502898188 [label="+5 Chemistry",color=orange];
		j502898188 -> j2516535779;
	j4136543739 [label="+5 Chemistry",color=orange];
		j4136543739 -> j1378826380;
	j1722407835 [label="Evaluate expressions",color=orange];
		j1722407835 -> j1429835008 [label="MarieEntratiMonster1",color=purple];
		j1722407835 -> j2890293549 [label="MarieEntratiFan1",color=purple];
		j1722407835 -> j1723015630 [label="false",color=purple];
	j737842484 [label="Evaluate expressions",color=orange];
		j737842484 -> j625818145 [label="MarieEntratiMonster1",color=purple];
		j737842484 -> j3189019298 [label="MarieEntratiFan1",color=purple];
		j737842484 -> j2180586292 [label="false",color=purple];
	j1591510439 [label="Evaluate expressions",color=orange];
		j1591510439 -> j935558460 [label="DrifterFaithSol",color=purple];
		j1591510439 -> j2919126249 [label="DrifterFaithLua",color=purple];
		j1591510439 -> j911565139 [label="DrifterFaithBalance",color=purple];
		j1591510439 -> j3443514577 [label="false",color=purple];
	j210515855 [label="Мені розповіли лише про зараження. Тож я небагато про це знаю… однак вірю тобі. І якщо мої відчуття правдиві, а я молюся за це, то не думаю, що вона десь у пастці.",shape=box,color=blue];
		j210515855 -> j1259945784;
	j3669669913 [label="Дуже милі слова з твого боку. Якщо мої відчуття правдиві, а я молюся за це, тоді oui, твоя правда. Не думаю, що вона десь у пастці.",shape=box,color=blue];
		j3669669913 -> j1259945784;
	j1547936376 [label="Якщо мої відчуття правдиві, а я молюся за це, тоді non. Не думаю, що вона десь у пастці.",shape=box,color=blue];
		j1547936376 -> j1259945784;
	j2516535779 [label="Якщо мої відчуття правдиві, а я молюся за це, тоді oui, твоя правда. І вони лишаються, щоб допомагати нам. Не думаю, що вона десь у пастці.",shape=box,color=blue];
		j2516535779 -> j1259945784;
	j1378826380 [label="Oui, le Cardinal благословив мене… але я знаю, що я майже одна у своїй любові до нього, бо вона незамарана журбою, ненавистю чи образою.",shape=box,color=blue];
		j1378826380 -> j318516550;
	j1429835008 [label="Я знаю, що для тебе він як якесь жахливе чудовисько. Але мушу спитати, що змусило тебе так недовіряти йому ?",shape=box,color=blue];
		j1429835008 -> j1363844451;
		j1429835008 -> j97983843;
		j1429835008 -> j75410414;
	j2890293549 [label="Я вважала, що ти віриш у нього ? Чому така раптова зміна ? Невже в тобі стільки непостійності ? ",shape=box,color=blue];
		j2890293549 -> j1265182040;
		j2890293549 -> j3610560248;
	j1723015630 [label="Чому ти так йому не довіряєш ?",shape=box,color=blue];
		j1723015630 -> j1363844451;
		j1723015630 -> j75410414;
		j1723015630 -> j97983843;
	j625818145 [label="Oui, але чому так швидка зміна позиції ? Ти брешеш. І я не знаю з якою метою. Et je ne veux pas le savoir.",shape=box,color=blue];
		j625818145 -> j1508231473;
	j3189019298 [label="+5 Chemistry",color=orange];
		j3189019298 -> j943427438;
	j2180586292 [label="Boolean MarieEntratiFan1 is now true.",color=orange];
		j2180586292 -> j943427438;
	j935558460 [label="Для тих із нас, котрі йдуть шляхами Сола, ми завжди будемо направними світилами для тих, хто прагне покинути перехрестя, non ? ",shape=box,color=blue];
		j935558460 -> j3363371395;
	j2919126249 [label="Ти йдеш шляхами Світочів, тож маєш знати — у наших вченнях ідеться про те, що в тінях треба йти наодинці, oui ?",shape=box,color=blue];
		j2919126249 -> j3363371395;
	j911565139 [label="Ти йдеш шляхами Світочів, тож маєш знати — у наших вченнях ідеться про те, що деякими незвіданими шляхами треба йти наодинці, oui ?",shape=box,color=blue];
		j911565139 -> j3363371395;
	j3443514577 [label="У моїй вірі ми знаємо за тих, хто йде життєвими шляхами й постає на перехресті, де зустрічається Сол і Луа. ",shape=box,color=blue];
		j3443514577 -> j3363371395;
	j1259945784 [label="Я лише відчуваю, як вона випромінює тепло Солової усмішки до мене. Le Cardinal не помилився з вибором. Для мене честь нести її у своїх жилах.",shape=box,color=blue];
		j1259945784 -> j3863912201;
		j1259945784 -> j1375917400;
		j1259945784 -> j3707261529;
		j1259945784 -> j1070329764;
	j318516550 [label="Я пробачаю йому за те, що покинув нас. Не думаю, що ще хтось так зробить…",shape=box,color=blue];
		j318516550 -> j1399504117;
		j318516550 -> j1045120976;
		j318516550 -> j1363844451;
		j318516550 -> j75410414;
	j1363844451 [label="Він… завітав у Дувірі. Дуже-дуже давно…",shape=box,color=red];
		j1363844451 -> j2925386863;
	j97983843 [label="Ну, для початку… він вистрілив мені у груди й залишив помирати.",shape=box,color=red];
		j97983843 -> j3004439153;
	j75410414 [label="На своєму шляху він не лишає нічого — лише біль, смерть та самотність.",shape=box,color=red];
		j75410414 -> j1591510439;
	j1265182040 [label="У мене ніколи не було довіри до нього. Просто не хотілося відлякати тебе.",shape=box,color=red];
		j1265182040 -> j3992737367;
	j3610560248 [label="Не хотілося брехати, просто не було розуміння як підійти до теми. Ти ж відкрито обожнюєш його…",shape=box,color=red];
		j3610560248 -> j513807665;
	j1508231473 [label="Boolean MarieNoDate is now true.",color=orange];
		j1508231473 -> "Chat ends.";
	j943427438 [label="Так, ми маємо вистояти ! Braves contre les ténèbres, pour toujours et à jamais !",shape=box,color=blue];
		j943427438 -> j3965566890;
	j3363371395 [label="Boolean DrifterCrossroads is now true.",color=orange];
		j3363371395 -> j676011047;
	j1399504117 [label="Він скривдив і покинув багатьох, твоя правда. Думаю, він відчував, що мусив.",shape=box,color=red];
		j1399504117 -> j4274452327;
	j1045120976 [label="Це складно, коли хтось для тебе так багато означає, кого ти любиш і на кого покладаєшся, іде геть. Особливо коли причини тобі невідомі. І тоді, коли ніхто не повертається.",shape=box,color=red];
		j1045120976 -> j3703982735;
	j2925386863 [label="Соле ! Це ж той світ, створений і прикликаний тобою з книжки, яку написала його донька, oui ? Монсеньйор Лойд розповідав про нього… Le Cardinal був там? Чому ? ",shape=box,color=blue];
		j2925386863 -> j1519727499;
		j2925386863 -> j23138054;
		j2925386863 -> j3600150183;
	j3004439153 [label="Et pourtant, vous êtes toujours en vie ! Але ж ти серед живих, хіба ні ? І цілком у повному порядку ? Квітнеш і пахнеш, якщо повірити в оповідки монсеньйора Лойда про твої походеньки між минулим та майбутнім.",shape=box,color=blue];
		j3004439153 -> j4231093281;
	j3992737367 [label="Ah, je vois ! Je suis une idiote, c'est ça ?! Juste une petite invalide venue d'un passé lointain, incapable de penser par elle-même ?! Mieux vaut l'approcher comme un faon dans les bois, de peur de l'effrayer !",shape=box,color=blue];
		j3992737367 -> j2523403966;
	j513807665 [label="О, oui… Небагато я зробила, щоби полегшити завдання говорити правду, n'est-ce pas ?",shape=box,color=blue];
		j513807665 -> j1841882255;
	j3965566890 [label="Я пробачила йому за те, що покинув нас. Не думаю, що ще хтось так зробить…",shape=box,color=blue];
		j3965566890 -> j1399504117;
		j3965566890 -> j1045120976;
	j676011047 [label="Le Cardinal повинен знайти спосіб повернутися до нас. Ми можемо робити лише те, що в наших силах і відгукнутися, коли покличе нас. І підкорятися тим, хто так само благословенний як і він.",shape=box,color=blue];
		j676011047 -> j989297039;
	j4274452327 [label="+5 Chemistry",color=orange];
		j4274452327 -> j2158037243;
	j3703982735 [label="+5 Chemistry",color=orange];
		j3703982735 -> j2643843220;
	j1519727499 [label="Гадаю, що початково він шукав частинку доньки, котру залишив удома. А натомість знайшов спосіб боротися з Байдужістю. Це виявилися емоції, від яких він так уперто намагався дистанціюватися.",shape=box,color=red];
		j1519727499 -> j2433322610;
	j23138054 [label="У його записках викладена огидно самовдоволена розповідь про те, як він вирушив досліджувати концептуальне втілення, а натомість дізнався про ціну боротьби з Байдужістю.",shape=box,color=red];
		j23138054 -> j2729356157;
	j3600150183 [label="Якщо вірити його записам, то він хотів навчити Дувірі (а отже й мене) як захиститися від Байдужості. Але що з того зрештою вийшло?",shape=box,color=red];
		j3600150183 -> j13936730;
	j4231093281 [label="Check boolean IsDating",color=orange];
		j4231093281 -> j751015766 [label=true,color=green];
		j4231093281 -> j3478471517 [label=false,color=brown];
	j2523403966 [label="Va t'asseoir sur une ruche.",shape=box,color=blue];
		j2523403966 -> j1508231473;
	j1841882255 [label="Вовченя, то ж скажи мені вже правду. Чому ти вважаєш, що йому не можна довіряти ? А я намагатимуся стримувати свій праведний гнів.",shape=box,color=blue];
		j1841882255 -> j1045120976;
		j1841882255 -> j1363844451;
		j1841882255 -> j75410414;
		j1841882255 -> j97983843;
	j989297039 [label="Evaluate expressions",color=orange];
		j989297039 -> j357994558 [label="MarieEntratiMonster1",color=purple];
		j989297039 -> j2574486656 [label="MarieEntratiMonster1",color=purple];
		j989297039 -> j357994558 [label="MarieEntratiFan1",color=purple];
		j989297039 -> j1720539872 [label="MarieEntratiFan1",color=purple];
		j989297039 -> j357994558 [label="false",color=purple];
		j989297039 -> j2574486656 [label="false",color=purple];
		j989297039 -> j1720539872 [label="false",color=purple];
		j989297039 -> j2182001173 [label="false",color=purple];
	j2158037243 [label="Oui, саме так. Гадаю почуття провини переслідує його за всі вчинки. Думаю, від навмисно дистанціюється від інших.",shape=box,color=blue];
		j2158037243 -> j2719670184;
	j2643843220 [label="Oui, це страшне горе, жахливий біль. Знати, що хтось… досі живий, але наче вирішив не бути поруч із тобою ?",shape=box,color=blue];
		j2643843220 -> j2719670184;
	j2433322610 [label="Mon cœur se brise dans la tragédie… не думаю, що витримаю подібний смуток… і все ж, вона йому не пробачить ?",shape=box,color=blue];
		j2433322610 -> j3169637066;
		j2433322610 -> j2376785184;
	j2729356157 [label="Ти знаєш, чому він пішов ?",shape=box,color=blue];
		j2729356157 -> j3169637066;
		j2729356157 -> j2147668873;
	j13936730 [label="Що ти маєш на увазі ? ",shape=box,color=blue];
		j13936730 -> j3897044600;
		j13936730 -> j3721963426;
	j751015766 [label="А й справді, якщо чутки, що ширяться між кавіями, правдиві, то vous y avez vraiment trouvé beaucoup de joie, non ?",shape=box,color=blue];
		j751015766 -> j3478471517;
	j3478471517 [label="Non, le Cardinal вчинив набагато гірше щодо інших. Тебе засмучують лише незручності.",shape=box,color=blue];
		j3478471517 -> j1591510439;
	j357994558 [label="Мені лишень хотілося б… щоб ми могли змусити всіх навколо Ентраті перестати звинувачувати себе й одне одного за те, що сталося.",shape=box,color=red];
		j357994558 -> j3421818140;
	j2574486656 [label="Я не знаю, чи хоч колись хотілося назвати його благословенним.",shape=box,color=red];
		j2574486656 -> j1752953709;
	j1720539872 [label="Набагато простіше було би пробачити Ентраті за його вчинки, якби можна було їх зрозуміти.",shape=box,color=red];
		j1720539872 -> j2193087517;
	j2182001173 [label="Я зроблю все, що йому потрібно від мене, для усунення цієї проблеми. А потім судитиму його, коли все буде сказано й зроблено.",shape=box,color=red];
		j2182001173 -> j3488049620;
	j2719670184 [label="Il inflige la douleur dans le cœur des autres, car la douleur vaut mieux que rien du tout. Страждання ліпша, аніж пустота, non ?",shape=box,color=blue];
		j2719670184 -> j233788772;
	j3169637066 [label="Боюся, що без наявності пояснень від нього ми можемо лише вигадувати власні причини.",shape=box,color=red];
		j3169637066 -> j2353121394;
	j2376785184 [label="Ти не вловлюєш основного. Він залишив мене там. Він побачив когось у пастці Порожнечі… і покинув мене там.",shape=box,color=red];
		j2376785184 -> j4174200546;
	j2147668873 [label="Ні. Я знаю лише те, що він залишив мене там. Він побачив когось у пастці Порожнечі… і просто покинув мене там.",shape=box,color=red];
		j2147668873 -> j2353121394;
	j3897044600 [label="Він залишив мене там. Він прибув, провів деякий час (не знаю скільки) і побачив когось у пастці Порожнечі… і покинув мене там.",shape=box,color=red];
		j3897044600 -> j4174200546;
	j3721963426 [label="Зрештою, Байдужість усе одно прийшла в Дувірі. Та ще й з неочікуваною допомогою. Хоча це тут абсолютно ні до чого.",shape=box,color=red];
		j3721963426 -> j2988113639;
	j3421818140 [label="Boolean MarieEntratiFamily is now true.",color=orange];
		j3421818140 -> j3941272433;
	j1752953709 [label="Тоді, гадаю, ми й надалі можемо погодитися не сходитися думками.",shape=box,color=blue];
		j1752953709 -> j322379075;
	j2193087517 [label="Я зо всіх сил молюся, щоб зрештою так і сталося. Я молюся, щоб ми дожили до кінця й побачили це. Але тепер я бачу ще й famille і молюся, щоби вони знайшли прощення у своїх серцях. Заради ж їхнього щастя.",shape=box,color=blue];
		j2193087517 -> j491248517;
	j3488049620 [label="+10 Chemistry",color=orange];
		j3488049620 -> j168385676;
	j233788772 [label="Цей урок мій дорогий Ліон засвоїв ліпше за інших… Я дуже рада, що він нарешті спілкується з тобою. Але в нас нині бесіда про le Cardinal.",shape=box,color=blue];
		j233788772 -> j221931327;
	j2353121394 [label="Можу припустити лише, що це сталося до… вбивства й нескінченності повторів.",shape=box,color=red];
		j2353121394 -> j3284488863;
	j4174200546 [label="І ти не знаєш, чому він покинув тебе там ?",shape=box,color=blue];
		j4174200546 -> j1834199763;
		j4174200546 -> j2353121394;
		j4174200546 -> j2398391836;
	j2988113639 [label="Non. Зажди. У l'Indifférence були… союзники ?",shape=box,color=blue];
		j2988113639 -> j1096068639;
		j2988113639 -> j3805167057;
	j3941272433 [label="Add 1 to Family counter",color=orange];
		j3941272433 -> j2858410164;
	j322379075 [label="Boolean MarieEntratiMonster2 is now true.",color=orange];
		j322379075 -> j3724924505;
	j491248517 [label="Boolean MarieEntratiFan2 is now true.",color=orange];
		j491248517 -> j3724924505;
	j168385676 [label="Oui, c'est raisonnable і доволі справедливо, зважаючи на те, що тобі довелося побачити й дізнатися. Більшого просити від тебе я й не змогла б.",shape=box,color=blue];
		j168385676 -> j1956084264;
	j221931327 [label="Boolean MarieLyonSuffering3 is now true.",color=orange];
		j221931327 -> j1591510439;
	j3284488863 [label="Тоді мушу просити тебе не думати про нього якнайгірше, бо гірка злоба сповнить твоє серце. ",shape=box,color=blue];
		j3284488863 -> j3393929397;
	j1834199763 [label="Я можу лише сподіватися, що причина була вагомою.",shape=box,color=red];
		j1834199763 -> j2648399331;
	j2398391836 [label="Ні, і це не має значення. Він міг урятувати мене. Але не став.",shape=box,color=red];
		j2398391836 -> j12826999;
	j1096068639 [label="Вона лише одягнула іншу маску.",shape=box,color=red];
		j1096068639 -> j2789642821;
	j3805167057 [label="Може й так? Чи заручницю. Чи то була маска. Ми достоту не знаємо.",shape=box,color=red];
		j3805167057 -> j2789642821;
	j2858410164 [label="+10 Chemistry",color=orange];
		j2858410164 -> j1529250053;
	j3724924505 [label="Ой, Ліон кличе. À la revoyure !",shape=box,color=blue];
		j3724924505 -> "Chat ends.";
	j1956084264 [label="Boolean MarieEntratiNeutral is now true.",color=orange];
		j1956084264 -> j3724924505;
	j3393929397 [label="Можливо, тобі ще не хотілося покидати Дувірі. Можливо, для тебе ще не все було втрачено. Можливо, тобі не хотілося покидати своїх друзів ?",shape=box,color=blue];
		j3393929397 -> j2267599211;
	j2648399331 [label="+5 Chemistry",color=orange];
		j2648399331 -> j2028509553;
	j12826999 [label="Чи можеш ти казати, що в жодному разі, у будь-якій реальності, ти не бачиш причини, чому він міг лишити тебе там ? ",shape=box,color=blue];
		j12826999 -> j3393929397;
	j2789642821 [label="Boolean MarieNeci is now true.",color=orange];
		j2789642821 -> j1855794796;
	j1529250053 [label="О-о, оце так думка. За таку справу варто поборотися !",shape=box,color=blue];
		j1529250053 -> j130896092;
	j2267599211 [label="Можливо, він не знав, чи зможе забрати тебе й не зруйнувати світ, що був у крихкому стані. Або думав, що l'Indifférence поглине Дувірі, як тебе не буде. Peut-être, peut-être, peut-être.",shape=box,color=blue];
		j2267599211 -> j1591510439;
	j2028509553 [label="Merci, merci… мені більшого й не треба. Ми не повинні думати про найгірше, бо це сповнює наші серця гірким полином.",shape=box,color=blue];
		j2028509553 -> j942218631;
	j1855794796 [label="Навіть не знаю що про це й думати… але дуже дивовижно… ",shape=box,color=blue];
		j1855794796 -> j4174200546;
	j130896092 [label="Check /Lotus/Scripts/1999/DialogueScriptNodes.lua:IsSyndicateRank(syndicate=EntratiSyndicate, syndicateRank=5)",color=orange];
		j130896092 -> j2245425236 [label=true,color=green];
		j130896092 -> j19127234 [label=false,color=brown];
	j942218631 [label="Можливо, тобі ще не хотілося покидати Дувірі. Можливо, для тебе ще не все було втрачено. Можливо, тобі не хотілося покидати своїх друзів ?",shape=box,color=blue];
		j942218631 -> j2267599211;
	j2245425236 [label="Ти зі своєю minuscule copie дуже добре попрацювали з його родиною… Гм-м, це змусило мене замислитися !",shape=box,color=blue];
		j2245425236 -> j3724924505;
	j19127234 [label="Check boolean MarieSyndicateMaxRank",color=orange];
		j19127234 -> j2245425236 [label=true,color=green];
		j19127234 -> j3203442099 [label=false,color=brown];
	j3203442099 [label="Гм-м… а це змусило мене замислитися ! Однак для початку маєш продовжити свою роботу з його родиною нагорі. Ти чи твоя minuscule copie.",shape=box,color=blue];
		j3203442099 -> j3724924505;
}