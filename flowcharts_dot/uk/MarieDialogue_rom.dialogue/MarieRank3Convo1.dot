		915 -> 923 [label="MarieEntratiFan1",color=purple];
		915 -> 924 [label="false",color=purple];
	916 [label="Evaluate expressions",color=orange];
		916 -> 928 [label="MarieEntratiMonster1",color=purple];
		916 -> 926 [label="MarieEntratiFan1",color=purple];
		916 -> 927 [label="false",color=purple];
	917 [label="Evaluate expressions",color=orange];
		917 -> 930 [label="DrifterFaithSol",color=purple];
		917 -> 932 [label="DrifterFaithLua",color=purple];
		917 -> 931 [label="DrifterFaithBalance",color=purple];
		917 -> 929 [label="false",color=purple];
	918 [label="Мені розповіли лише про зараження. Тож я небагато про це знаю… однак вірю тобі. І якщо мої відчуття правдиві, а я молюся за це, то не думаю, що вона десь у пастці.",shape=box,color=blue];
		918 -> 933;
	919 [label="Дуже милі слова з твого боку. Якщо мої відчуття правдиві, а я молюся за це, тоді oui, твоя правда. Не думаю, що вона десь у пастці.",shape=box,color=blue];
		919 -> 933;
	920 [label="Якщо мої відчуття правдиві, а я молюся за це, тоді non. Не думаю, що вона десь у пастці.",shape=box,color=blue];
		920 -> 933;
	921 [label="Якщо мої відчуття правдиві, а я молюся за це, тоді oui, твоя правда. І вони лишаються, щоб допомагати нам. Не думаю, що вона десь у пастці.",shape=box,color=blue];
		921 -> 933;
	922 [label="Oui, le Cardinal благословив мене… але я знаю, що я майже одна у своїй любові до нього, бо вона незамарана журбою, ненавистю чи образою.",shape=box,color=blue];
		922 -> 934;
	925 [label="Я знаю, що для тебе він як якесь жахливе чудовисько. Але мушу спитати, що змусило тебе так недовіряти йому ?",shape=box,color=blue];
		925 -> 937;
		925 -> 939;
		925 -> 938;
	923 [label="Я вважала, що ти віриш у нього ? Чому така раптова зміна ? Невже в тобі стільки непостійності ? ",shape=box,color=blue];
		923 -> 935;
		923 -> 936;
	924 [label="Чому ти так йому не довіряєш ?",shape=box,color=blue];
		924 -> 937;
		924 -> 938;
		924 -> 939;
	928 [label="Oui, але чому так швидка зміна позиції ? Ти брешеш. І я не знаю з якою метою. Et je ne veux pas le savoir.",shape=box,color=blue];
		928 -> 941;
	926 [label="+5 Chemistry",color=orange];
		926 -> 940;
	927 [label="Update boolean MarieEntratiFan1",color=orange];
		927 -> 940;
	930 [label="Для тих із нас, котрі йдуть шляхами Сола, ми завжди будемо направними світилами для тих, хто прагне покинути перехрестя, non ? ",shape=box,color=blue];
		930 -> 942;
	932 [label="Ти йдеш шляхами Світочів, тож маєш знати — у наших вченнях ідеться про те, що в тінях треба йти наодинці, oui ?",shape=box,color=blue];
		932 -> 942;
	931 [label="Ти йдеш шляхами Світочів, тож маєш знати — у наших вченнях ідеться про те, що деякими незвіданими шляхами треба йти наодинці, oui ?",shape=box,color=blue];
		931 -> 942;
	929 [label="У моїй вірі ми знаємо за тих, хто йде життєвими шляхами й постає на перехресті, де зустрічається Сол і Луа. ",shape=box,color=blue];
		929 -> 942;
	933 [label="Я лише відчуваю, як вона випромінює тепло Солової усмішки до мене. Le Cardinal не помилився з вибором. Для мене честь нести її у своїх жилах.",shape=box,color=blue];
		933 -> 908;
		933 -> 907;
		933 -> 905;
		933 -> 906;
	934 [label="Я пробачаю йому за те, що покинув нас. Не думаю, що ще хтось так зробить…",shape=box,color=blue];
		934 -> 943;
		934 -> 944;
		934 -> 937;
		934 -> 938;
	937 [label="Він… завітав у Дувірі. Дуже-дуже давно…",shape=box,color=red];
		937 -> 947;
	939 [label="Ну, для початку… він вистрілив мені у груди й залишив помирати.",shape=box,color=red];
		939 -> 948;
	938 [label="На своєму шляху він не лишає нічого — лише біль, смерть та самотність.",shape=box,color=red];
		938 -> 917;
	935 [label="У мене ніколи не було довіри до нього. Просто не хотілося відлякати тебе.",shape=box,color=red];
		935 -> 945;
	936 [label="Не хотілося брехати, просто не було розуміння як підійти до теми. Ти ж відкрито обожнюєш його…",shape=box,color=red];
		936 -> 946;
	941 [label="Update boolean MarieNoDate",color=orange];
		941 -> 950;
	940 [label="Так, ми маємо вистояти ! Braves contre les ténèbres, pour toujours et à jamais !",shape=box,color=blue];
		940 -> 949;
	942 [label="Update boolean DrifterCrossroads",color=orange];
		942 -> 951;
	943 [label="Він скривдив і покинув багатьох, твоя правда. Думаю, він відчував, що мусив.",shape=box,color=red];
		943 -> 952;
	944 [label="Це складно, коли хтось для тебе так багато означає, кого ти любиш і на кого покладаєшся, іде геть. Особливо коли причини тобі невідомі. І тоді, коли ніхто не повертається.",shape=box,color=red];
		944 -> 953;
	947 [label="Соле ! Це ж той світ, створений і прикликаний тобою з книжки, яку написала його донька, oui ? Монсеньйор Лойд розповідав про нього… Le Cardinal був там? Чому ? ",shape=box,color=blue];
		947 -> 956;
		947 -> 957;
		947 -> 958;
	948 [label="Et pourtant, vous êtes toujours en vie ! Але ж ти серед живих, хіба ні ? І цілком у повному порядку ? Квітнеш і пахнеш, якщо повірити в оповідки монсеньйора Лойда про твої походеньки між минулим та майбутнім.",shape=box,color=blue];
		948 -> 959;
	945 [label="Ah, je vois ! Je suis une idiote, c'est ça ?! Juste une petite invalide venue d'un passé lointain, incapable de penser par elle-même ?! Mieux vaut l'approcher comme un faon dans les bois, de peur de l'effrayer !",shape=box,color=blue];
		945 -> 954;
	946 [label="О, oui… Небагато я зробила, щоби полегшити завдання говорити правду, n'est-ce pas ?",shape=box,color=blue];
		946 -> 955;
	950 [label="Chat ends.",color=orange];
	949 [label="Я пробачила йому за те, що покинув нас. Не думаю, що ще хтось так зробить…",shape=box,color=blue];
		949 -> 943;
		949 -> 944;
	951 [label="Le Cardinal повинен знайти спосіб повернутися до нас. Ми можемо робити лише те, що в наших силах і відгукнутися, коли покличе нас. І підкорятися тим, хто так само благословенний як і він.",shape=box,color=blue];
		951 -> 960;
	952 [label="+5 Chemistry",color=orange];
		952 -> 961;
	953 [label="+5 Chemistry",color=orange];
		953 -> 962;
	956 [label="Гадаю, що початково він шукав частинку доньки, котру залишив удома. А натомість знайшов спосіб боротися з Байдужістю. Це виявилися емоції, від яких він так уперто намагався дистанціюватися.",shape=box,color=red];
		956 -> 964;
	957 [label="У його записках викладена огидно самовдоволена розповідь про те, як він вирушив досліджувати концептуальне втілення, а натомість дізнався про ціну боротьби з Байдужістю.",shape=box,color=red];
		957 -> 965;
	958 [label="Якщо вірити його записам, то він хотів навчити Дувірі (а отже й мене) як захиститися від Байдужості. Але що з того зрештою вийшло?",shape=box,color=red];
		958 -> 966;
	959 [label="Check boolean IsDating",color=orange];
		959 -> 968 [label=true,color=green];
		959 -> 967 [label=false,color=brown];
	954 [label="Va t'asseoir sur une ruche.",shape=box,color=blue];
		954 -> 963;
	955 [label="Вовченя, то ж скажи мені вже правду. Чому ти вважаєш, що йому не можна довіряти ? А я намагатимуся стримувати свій праведний гнів.",shape=box,color=blue];
		955 -> 944;
		955 -> 937;
		955 -> 938;
		955 -> 939;
	960 [label="Evaluate expressions",color=orange];
		960 -> 969 [label="MarieEntratiMonster1",color=purple];
		960 -> 971 [label="MarieEntratiMonster1",color=purple];
		960 -> 969 [label="MarieEntratiFan1",color=purple];
		960 -> 972 [label="MarieEntratiFan1",color=purple];
		960 -> 969 [label="false",color=purple];
		960 -> 971 [label="false",color=purple];
		960 -> 972 [label="false",color=purple];
		960 -> 970 [label="false",color=purple];
	961 [label="Oui, саме так. Гадаю почуття провини переслідує його за всі вчинки. Думаю, від навмисно дистанціюється від інших.",shape=box,color=blue];
		961 -> 973;
	962 [label="Oui, це страшне горе, жахливий біль. Знати, що хтось… досі живий, але наче вирішив не бути поруч із тобою ?",shape=box,color=blue];
		962 -> 973;
	964 [label="Mon cœur se brise dans la tragédie… не думаю, що витримаю подібний смуток… і все ж, вона йому не пробачить ?",shape=box,color=blue];
		964 -> 975;
		964 -> 976;
	965 [label="Ти знаєш, чому він пішов ?",shape=box,color=blue];
		965 -> 975;
		965 -> 977;
	966 [label="Що ти маєш на увазі ? ",shape=box,color=blue];
		966 -> 978;
		966 -> 979;
	968 [label="А й справді, якщо чутки, що ширяться між кавіями, правдиві, то vous y avez vraiment trouvé beaucoup de joie, non ?",shape=box,color=blue];
		968 -> 967;
	967 [label="Non, le Cardinal вчинив набагато гірше щодо інших. Тебе засмучують лише незручності.",shape=box,color=blue];
		967 -> 917;
	963 [label="Update boolean MarieNoDate",color=orange];
		963 -> 974;
	969 [label="Мені лишень хотілося б… щоб ми могли змусити всіх навколо Ентраті перестати звинувачувати себе й одне одного за те, що сталося.",shape=box,color=red];
		969 -> 980;
	971 [label="Я не знаю, чи хоч колись хотілося назвати його благословенним.",shape=box,color=red];
		971 -> 982;
	972 [label="Набагато простіше було би пробачити Ентраті за його вчинки, якби можна було їх зрозуміти.",shape=box,color=red];
		972 -> 983;
	970 [label="Я зроблю все, що йому потрібно від мене, для усунення цієї проблеми. А потім судитиму його, коли все буде сказано й зроблено.",shape=box,color=red];
		970 -> 981;
	973 [label="Il inflige la douleur dans le cœur des autres, car la douleur vaut mieux que rien du tout. Страждання ліпша, аніж пустота, non ?",shape=box,color=blue];
		973 -> 984;
	975 [label="Боюся, що без наявності пояснень від нього ми можемо лише вигадувати власні причини.",shape=box,color=red];
		975 -> 985;
	976 [label="Ти не вловлюєш основного. Він залишив мене там. Він побачив когось у пастці Порожнечі… і покинув мене там.",shape=box,color=red];
		976 -> 986;
	977 [label="Ні. Я знаю лише те, що він залишив мене там. Він побачив когось у пастці Порожнечі… і просто покинув мене там.",shape=box,color=red];
		977 -> 985;
	978 [label="Він залишив мене там. Він прибув, провів деякий час (не знаю скільки) і побачив когось у пастці Порожнечі… і покинув мене там.",shape=box,color=red];
		978 -> 986;
	979 [label="Зрештою, Байдужість усе одно прийшла в Дувірі. Та ще й з неочікуваною допомогою. Хоча це тут абсолютно ні до чого.",shape=box,color=red];
		979 -> 987;
	974 [label="Chat ends.",color=orange];
	980 [label="Update boolean MarieEntratiFamily",color=orange];
		980 -> 988;
	982 [label="Тоді, гадаю, ми й надалі можемо погодитися не сходитися думками.",shape=box,color=blue];
		982 -> 990;
	983 [label="Я зо всіх сил молюся, щоб зрештою так і сталося. Я молюся, щоб ми дожили до кінця й побачили це. Але тепер я бачу ще й famille і молюся, щоби вони знайшли прощення у своїх серцях. Заради ж їхнього щастя.",shape=box,color=blue];
		983 -> 991;
	981 [label="+10 Chemistry",color=orange];
		981 -> 989;
	984 [label="Цей урок мій дорогий Ліон засвоїв ліпше за інших… Я дуже рада, що він нарешті спілкується з тобою. Але в нас нині бесіда про le Cardinal.",shape=box,color=blue];
		984 -> 992;
	985 [label="Можу припустити лише, що це сталося до… вбивства й нескінченності повторів.",shape=box,color=red];
		985 -> 993;
	986 [label="І ти не знаєш, чому він покинув тебе там ?",shape=box,color=blue];
		986 -> 994;
		986 -> 985;
		986 -> 995;
	987 [label="Non. Зажди. У l'Indifférence були… союзники ?",shape=box,color=blue];
		987 -> 996;
		987 -> 997;
	988 [label="Add 1 to Family",color=orange];
		988 -> 998;
	990 [label="Update boolean MarieEntratiMonster2",color=orange];
		990 -> 1000;
	991 [label="Update boolean MarieEntratiFan2",color=orange];
		991 -> 1000;
	989 [label="Oui, c'est raisonnable і доволі справедливо, зважаючи на те, що тобі довелося побачити й дізнатися. Більшого просити від тебе я й не змогла б.",shape=box,color=blue];
		989 -> 999;
	992 [label="Update boolean MarieLyonSuffering3",color=orange];
		992 -> 917;
	993 [label="Тоді мушу просити тебе не думати про нього якнайгірше, бо гірка злоба сповнить твоє серце. ",shape=box,color=blue];
		993 -> 1001;
	994 [label="Я можу лише сподіватися, що причина була вагомою.",shape=box,color=red];
		994 -> 1002;
	995 [label="Ні, і це не має значення. Він міг урятувати мене. Але не став.",shape=box,color=red];
		995 -> 1003;
	996 [label="Вона лише одягнула іншу маску.",shape=box,color=red];
		996 -> 1004;
	997 [label="Може й так? Чи заручницю. Чи то була маска. Ми достоту не знаємо.",shape=box,color=red];
		997 -> 1004;
	998 [label="+10 Chemistry",color=orange];
		998 -> 1005;
	1000 [label="Ой, Ліон кличе. À la revoyure !",shape=box,color=blue];
		1000 -> 1006;
	999 [label="Update boolean MarieEntratiNeutral",color=orange];
		999 -> 1000;
	1001 [label="Можливо, тобі ще не хотілося покидати Дувірі. Можливо, для тебе ще не все було втрачено. Можливо, тобі не хотілося покидати своїх друзів ?",shape=box,color=blue];
		1001 -> 1007;
	1002 [label="+5 Chemistry",color=orange];
		1002 -> 1008;
	1003 [label="Чи можеш ти казати, що в жодному разі, у будь-якій реальності, ти не бачиш причини, чому він міг лишити тебе там ? ",shape=box,color=blue];
		1003 -> 1001;
	1004 [label="Update boolean MarieNeci",color=orange];
		1004 -> 1009;
	1005 [label="О-о, оце так думка. За таку справу варто поборотися !",shape=box,color=blue];
		1005 -> 1010;
	1006 [label="Chat ends.",color=orange];
	1007 [label="Можливо, він не знав, чи зможе забрати тебе й не зруйнувати світ, що був у крихкому стані. Або думав, що l'Indifférence поглине Дувірі, як тебе не буде. Peut-être, peut-être, peut-être.",shape=box,color=blue];
		1007 -> 917;
	1008 [label="Merci, merci… мені більшого й не треба. Ми не повинні думати про найгірше, бо це сповнює наші серця гірким полином.",shape=box,color=blue];
		1008 -> 1011;
	1009 [label="Навіть не знаю що про це й думати… але дуже дивовижно… ",shape=box,color=blue];
		1009 -> 986;
