		1010 -> 1013 [label=true,color=green];
		1010 -> 1012 [label=false,color=brown];
	1011 [label="Можливо, тобі ще не хотілося покидати Дувірі. Можливо, для тебе ще не все було втрачено. Можливо, тобі не хотілося покидати своїх друзів ?",shape=box,color=blue];
		1011 -> 1014;
	1013 [label="Ти зі своєю minuscule copie дуже добре попрацювали з його родиною… Гм-м, це змусило мене замислитися !",shape=box,color=blue];
		1013 -> 1000;
	1012 [label="Гм-м… а це змусило мене замислитися ! Однак для початку маєш продовжити свою роботу з його родиною нагорі. Ти чи твоя minuscule copie.",shape=box,color=blue];
		1012 -> 1000;
	1014 [label="Можливо, він не знав, чи зможе забрати тебе й не зруйнувати світ, що був у крихкому стані. Або думав, що l'Indifférence поглине Дувірі, як тебе не буде. Peut-être, peut-être, peut-être.",shape=box,color=blue];
