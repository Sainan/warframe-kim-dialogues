		866 -> 865 [label="DrifterFaithNoMITW",color=purple];
		866 -> 865 [label="false",color=purple];
	868 [label="Боюся, що ми не багато знаємо про людей, які перетворилися на перших оригінальних ворфреймів.",shape=box,color=red];
		868 -> 871;
	867 [label="Боюся, що про справжню Вісп не багато є інформації.",shape=box,color=red];
		867 -> 871;
	870 [label="Розкажи мені, вовченя, про цю так звану «Вісп», чия спотворена кров тече в мені і яка дарувала мені політ. Про ту, чию душу я відчуваю так близько біля своєї, коли ніч сповиває все своїм саваном.",shape=box,color=blue];
		870 -> 874;
		870 -> 873;
	869 [label="Розкажи мені, вовченя, про цю так звану «Вісп», чия спотворена кров тече в мені і яка дарувала мені політ. Про ту, чию душу я відчуваю так близько біля своєї, коли ніч сповиває все своїм саваном.",shape=box,color=blue];
		869 -> 872;
	871 [label="Vraiment ? Усі записи загубилися за довгі роки чи є підозра, що їх уважали недостатньо важливими для запам’ятовування ?",shape=box,color=blue];
		871 -> 875;
		871 -> 876;
		871 -> 877;
	874 [label="Боюся, що ми не багато знаємо про людей, які перетворилися на перших оригінальних ворфреймів.",shape=box,color=red];
		874 -> 881;
	873 [label="Боюся, що про справжню Вісп не багато є інформації.",shape=box,color=red];
		873 -> 881;
	872 [label="Якщо розмова про душі не бентежить тебе ? Я все зрозумію, якщо це незручна тема. Тоді ми перейдемо до практичніших речей. Не хочу ставити тебе в незручне становище.",shape=box,color=blue];
		872 -> 880;
		872 -> 879;
		872 -> 878;
	875 [label="Гадаю, що це було не надто важливим, щоби зберігати й запам’ятовувати.",shape=box,color=red];
		875 -> 882;
	876 [label="Думаю, ця інформація загубилася за стільки років.",shape=box,color=red];
		876 -> 882;
	877 [label="Зрештою, і те, і інше… усього потроху. Для першотворця вони були… частково зброя, частково витвір мистецтва.",shape=box,color=red];
		877 -> 883;
	881 [label="Vraiment ? Бо за відчуттями я ніби знаю її як сестру — по крові, а не як ті з Cathédrale.",shape=box,color=blue];
		881 -> 887;
	880 [label="Усе гаразд, можемо говорити про душі.",shape=box,color=red];
		880 -> 874;
		880 -> 873;
		880 -> 886;
	879 [label="Я не дуже вірю в існування душ, тож триматимемося голих фактів, якщо можна?",shape=box,color=red];
		879 -> 885;
	878 [label="[Завершити розмову]",shape=box,color=red];
		878 -> 884;
	882 [label="Бачиш ? Ces Orokin дияволи.",shape=box,color=blue];
		882 -> 888;
		882 -> 889;
	883 [label="+5 Chemistry",color=orange];
		883 -> 890;
	887 [label="Я не чую її. Усе не так, як Ліон чує богів та духів-наставників. Я не бачу її. Просто відчуваю поруч із собою.",shape=box,color=blue];
		887 -> 893;
	886 [label="[Завершити розмову]",shape=box,color=red];
		886 -> 892;
	885 [label="Update boolean DrifterFaithStop",color=orange];
		885 -> 891;
	884 [label="Chat ends.",color=orange];
	888 [label="Зброю можна використовувати як для захисту, так і для нападу. Ми не в захваті від того, що вона потрібна нам… але вона потрібна.",shape=box,color=red];
		888 -> 894;
	889 [label="Не всі з них. Але конкретно той? О так. Проте є кілька, котрих не можна одразу безумовно засуджувати.",shape=box,color=red];
		889 -> 895;
	890 [label="Une horrible toile d'os peinte avec du sang… ти ж бачиш ? Ces Orokin дияволи.",shape=box,color=blue];
		890 -> 888;
		890 -> 889;
	893 [label="Може як стару подругу. Знаю, що їй подобалося, як вона рухалася. Я пам’ятаю як звучить її сміх, що розноситься вітром…",shape=box,color=blue];
		893 -> 897;
	892 [label="Chat ends.",color=orange];
	891 [label="+5 Chemistry",color=orange];
		891 -> 896;
	894 [label="Add -1 to Thermostat",color=orange];
		894 -> 898;
	895 [label="Add 1 to Thermostat",color=orange];
		895 -> 899;
	897 [label="Певно, ці слова схожі на балачку божевільної ! Ти пробач мені.",shape=box,color=blue];
		897 -> 901;
		897 -> 902;
		897 -> 903;
		897 -> 904;
	896 [label="Oui, bien sûr ! Ніхто не хоче вислуховувати повчання, особливо від сестри. Я розумію й дякую. Не хочеться показати себе дурепою.",shape=box,color=blue];
		896 -> 868;
		896 -> 867;
		896 -> 900;
	898 [label="Так, це правда. Я зараз зброя, і Murmure це добре відчуває ! Та я прагну йти шляхом, який указав le Cardinal, най буде благословенним.",shape=box,color=blue];
		898 -> 905;
		898 -> 906;
	899 [label="Як le Cardinal. Він був орокіном, non ? І він точно не з тих, кого я б осудила. Без нього я не стала б такою, яка є зараз. Хай буде благословенним.",shape=box,color=blue];
		899 -> 907;
		899 -> 908;
	901 [label="Ворфреймів створили… не в найгуманніший спосіб. Сподіваюся, вона не застрягла десь у зараженні.",shape=box,color=red];
		901 -> 910;
	902 [label="Гадаю, ким би не була Вісп, але вона з радістю познайомилася б з тобою.",shape=box,color=red];
		902 -> 911;
	903 [label="Сподіваюся, їхні душі змогли дістатися далі й знайти спокій, але на мою думку частина спогадів лишилася.",shape=box,color=red];
		903 -> 912;
	904 [label="Та ні. Усе добре. Я вірю в те, що якась частка від людей, яких перетворили на ворфрейми, лишилася в межах основних систем.",shape=box,color=red];
		904 -> 913;
	900 [label="[Завершити розмову]",shape=box,color=red];
		900 -> 909;
	905 [label="Є чимало тем для суперечок із ним, але скажу, що в нього наче непоганий хист давати сироватку протофреймів саме потрібним людям. Навіть якщо гадки не маю, для чого він це робить.",shape=box,color=red];
		905 -> 914;
	906 [label="Мені дуже б хотілося, щоб ти не довіряла Ентраті так само сильно, як наразі довіряєш. Ми не знаємо, чому він обирає діяти так, як діє. Його мотиви неясні.",shape=box,color=red];
		906 -> 915;
	907 [label="Маємо триматися Ентраті. Слідувати за ним туди, куди йде. Бо це наш єдиний шанс зупинити Байдужість.",shape=box,color=red];
		907 -> 916;
	908 [label="Марі, він брехун. Він кидає й завдає болю всім у своєму житті. Він уже покинув тебе, хіба ти не бачиш? ",shape=box,color=red];
		908 -> 917;
	910 [label="+5 Chemistry",color=orange];
		910 -> 918;
	911 [label="+5 Chemistry",color=orange];
		911 -> 919;
	912 [label="+5 Chemistry",color=orange];
		912 -> 920;
	913 [label="+5 Chemistry",color=orange];
		913 -> 921;
