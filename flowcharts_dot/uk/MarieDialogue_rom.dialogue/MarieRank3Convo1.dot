		864 -> 866 [label=false,color=brown];
	865 [label="Розкажи мені, вовченя, про цю так звану «Вісп», чия спотворена кров тече в мені і яка дарувала мені свободу й політ.",shape=box,color=blue];
		865 -> 868;
		865 -> 867;
	866 [label="Evaluate expressions",color=orange];
		866 -> 870 [label="DrifterFaithYesSimilar",color=purple];
		866 -> 870 [label="DrifterFaithYesForeign",color=purple];
		866 -> 870 [label="DrifterFaithPersonal",color=purple];
		866 -> 870 [label="DrifterFaithSol",color=purple];
		866 -> 870 [label="DrifterFaithLua",color=purple];
		866 -> 870 [label="DrifterFaithBalance",color=purple];
		866 -> 869 [label="DrifterFaithAgnostic",color=purple];
		866 -> 865 [label="DrifterFaithNoFear",color=purple];
