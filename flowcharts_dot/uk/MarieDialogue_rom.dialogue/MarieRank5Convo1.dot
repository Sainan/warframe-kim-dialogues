digraph {
	2427 [label="MarieRank5Convo1 begins.",color=orange];
		2427 -> 2428;
	2428 [label="Є час для розмови ?",shape=box,color=blue];
		2428 -> 2429;
	2429 [label="Evaluate expressions",color=orange];
		2429 -> 2430 [label="MarieEntrati4a",color=purple];
		2429 -> 2431 [label="MarieEntrati4b",color=purple];
		2429 -> 2432 [label="MarieEntrati3a",color=purple];
		2429 -> 2433 [label="MarieEntrati3b",color=purple];
		2429 -> 2434 [label="MarieEntrati3",color=purple];
		2429 -> 2435 [label="false",color=purple];
	2430 [label="Я розмірковувала над твоїми словами стосовно le Cardinal. Що його дії… «суміш» прекрасного й мерзенного.",shape=box,color=blue];
		2430 -> 2436;
	2431 [label="Я розмірковувала над твоїми словами стосовно le Cardinal. Що його дії могли завдати болю Ліону.",shape=box,color=blue];
		2431 -> 2436;
	2432 [label="Я ще раз обміркувала нашу розмову стосовно мсьє Таґфером і розглянула детальніше твої переконливі аргументи, чому він так зневажає le Cardinal.",shape=box,color=blue];
		2432 -> 2436;
	2433 [label="Я ще раз обміркувала мою суперечку з мсьє Таґфером і розглянула детальніше причини його зневаги до le Cardinal.",shape=box,color=blue];
		2433 -> 2436;
	2434 [label="Я ще раз обміркувала мою суперечку з мсьє Таґфером. І нашу суперечку стосовно тієї суперечки.",shape=box,color=blue];
		2434 -> 2436;
	2435 [label="Я відчуваю, що чимало лишилося несказаним про le Cardinal. Схоже, інші навшпиньки обходять цю тему зі мною, боячись говорити про нього.",shape=box,color=blue];
		2435 -> 2436;
	2436 [label="Я знаю, що інші хочуть затаврувати його шаленцем, зрадником, брудним скаженим псом… Але для мене він не такий.",shape=box,color=blue];
		2436 -> 2437;
	2437 [label="Check boolean MarieBackstory1",color=orange];
		2437 -> 2439 [label=true,color=green];
		2437 -> 2438 [label=false,color=brown];
	2439 [label="Можливо, через те, що я звикла бути покинутою. ",shape=box,color=blue];
		2439 -> 2440;
	2438 [label="Моя родина покинула мене, лишила на вулиці, коли я була ще дитиною. Через… через мою ненормальність. Поламаність. Непасування нормам вищого суспільства.",shape=box,color=blue];
		2438 -> 2440;
	2440 [label="Можливо, через те, що поруч не було батька, з яким могла б говорити. Через це я так охоче пробачаю відсутність le Cardinal.",shape=box,color=blue];
		2440 -> 2441;
	2441 [label="Evaluate expressions",color=orange];
		2441 -> 2442 [label="MarieEntrati4a",color=purple];
		2441 -> 2443 [label="MarieEntrati4b",color=purple];
		2441 -> 2444 [label="MarieEntrati3a",color=purple];
		2441 -> 2445 [label="MarieEntrati3b",color=purple];
		2441 -> 2446 [label="MarieEntrati3",color=purple];
		2441 -> 2447 [label="false",color=purple];
	2442 [label="Але факт лишається фактом — я пробачаю йому. Бо я бачу велику цінність у його добрих діяннях. Вона перевищує шкоду від злих.",shape=box,color=blue];
		2442 -> 2448;
		2442 -> 2449;
		2442 -> 2450;
		2442 -> 2451;
		2442 -> 2452;
	2443 [label="Я молюся за те, щоб Ліон був достатньо сильним і пережив кризу віри, від якої страждає. Але я не вірю, що це все через дії le Cardinal.",shape=box,color=blue];
		2443 -> 2448;
		2443 -> 2449;
		2443 -> 2450;
		2443 -> 2453;
		2443 -> 2454;
	2444 [label="Тож попри те, що я ціную твої переконливі аргументи стосовно мсьє Таґфера й інших, кого було скривджено… Усе одно бачу велику цінність у його добрих діяннях. Вона перевищує шкоду від злих.",shape=box,color=blue];
		2444 -> 2448;
		2444 -> 2449;
		2444 -> 2450;
		2444 -> 2455;
		2444 -> 2456;
	2445 [label="Тож я хоч і розумію гнів мсьє Таґфера і можу співчувати його втратам — він має знайти у своєму серці здатність пробачити le Cardinal. Бо я бачу велику цінність у його добрих діяннях. Вона перевищує шкоду від злих.",shape=box,color=blue];
		2445 -> 2448;
		2445 -> 2449;
		2445 -> 2450;
		2445 -> 2457;
		2445 -> 2458;
	2446 [label="Тож попри те, що я вдячна за всі історії про le Cardinal і співчуваю їм, особливо мсьє Таґферу… Досі бачу велику цінність у його добрих діяннях. Вона перевищує шкоду від злих.",shape=box,color=blue];
		2446 -> 2448;
		2446 -> 2449;
		2446 -> 2450;
		2446 -> 2459;
	2447 [label="Тож попри те, що я вдячна за всі історії про le Cardinal і співчуваю їм… Досі бачу велику цінність у його добрих діяннях. Вона перевищує шкоду від злих.",shape=box,color=blue];
		2447 -> 2448;
		2447 -> 2449;
		2447 -> 2450;
	2448 [label="Я не звинувачую тебе у вдячності за все добро, яке він робив для тебе. Так само я не звинувачую інших в ображеності за ту шкоду, яку завдано їм.",shape=box,color=red];
		2448 -> 2460;
	2449 [label="Я не знаю. Думаю, його дії завдали більшої шкоди, аніж принесли добра. Хотілося б, щоб ти побачила це.",shape=box,color=red];
		2449 -> 2461;
	2450 [label="Марі, я на твоєму боці. Не можу звинувачувати Ентраті за будь-що скоєне. Він б’ється з Байдужістю.",shape=box,color=red];
		2450 -> 2462;
	2451 [label="Ти правильно робиш, що пробачаєш Ентраті. Якби ж інші теж ішли цією стежкою за тобою.",shape=box,color=red];
		2451 -> 2462;
	2452 [label="Ніколи не доводилося звинувачувати когось за прощення. Але не можна пробачити комусь, усвідомлюючи, що маєш захищати інших від таких осіб.",shape=box,color=red];
		2452 -> 2463;
	2453 [label="Думаєш, що страждання Ліона — його власна провина?",shape=box,color=red];
		2453 -> 2464;
	2454 [label="Марі, Ліон страждає від дечого більшого, аніж втрати віри. І чимало з того пов’язано з Ентраті.",shape=box,color=red];
		2454 -> 2461;
	2455 [label="Невже нічого з усього написаного мною анітрохи не врівноважило шальки терезів?",shape=box,color=red];
		2455 -> 2465;
	2456 [label="Як ти можеш спостерігати результати вчинків Ентраті й досі бачити більше добра, аніж шкоди?",shape=box,color=red];
		2456 -> 2461;
	2457 [label="Думаю, ти надто применшуєш величину страждань кавій та особливо Таґфера.",shape=box,color=red];
		2457 -> 2461;
	2458 [label="Прощення важливе. Але як і знання того, що Ентраті може бути набагато складнішим, аніж ти хочеш приймати.",shape=box,color=red];
		2458 -> 2465;
	2459 [label="Досі не думаю, що ти усвідомлюєш, що саме пережили Таґфер і кавії. Це набагато гірше за те, крізь що пройшла ти.",shape=box,color=red];
		2459 -> 2461;
	2460 [label="Але хіба ти не бачиш абсолютну різницю в цінності цих двох понять ? Образи та шанування ? Мені дуже хотілося б, щоб інші відмовилися від свого злісного невдоволення.",shape=box,color=blue];
		2460 -> 2466;
		2460 -> 2467;
	2461 [label="Evaluate expressions",color=orange];
		2461 -> 2469 [label="MarieEntratiMonster1",color=purple];
		2461 -> 2469 [label="MarieEntratiMonster2",color=purple];
		2461 -> 2468 [label="MarieEntratiFan1",color=purple];
		2461 -> 2468 [label="MarieEntratiFan2",color=purple];
		2461 -> 2470 [label="false",color=purple];
	2462 [label="Evaluate expressions",color=orange];
		2462 -> 2473 [label="MarieEntratiMonster1",color=purple];
		2462 -> 2473 [label="MarieEntratiMonster2",color=purple];
		2462 -> 2471 [label="MarieEntratiFan1",color=purple];
		2462 -> 2471 [label="MarieEntratiFan2",color=purple];
		2462 -> 2472 [label="false",color=purple];
	2463 [label="І що ти пропонуєш робити ? Прогнати геть le Cardinal ? Маю зазначити, що це дуже схоже на те, що він сам уже зробив, non ?",shape=box,color=blue];
		2463 -> 2474;
		2463 -> 2467;
	2464 [label="Думаю, Ліон страждає від багатьох недуг через те, що має сумніви в собі та власній свідомості. Le Cardinal лише… дещо пришвидшив процеси.",shape=box,color=blue];
		2464 -> 2475;
		2464 -> 2467;
	2465 [label="І що ти хочеш, щоб я робила ? Спалила опудало le Cardinal і виголосила анафему ? Засудила на вигнання у Порожнечу, бажала йому зла, як мсьє Таґфер ?",shape=box,color=blue];
		2465 -> 2474;
		2465 -> 2467;
	2466 [label="У цьому то й проблема, Марі. Те, що ти просиш від інших — не те саме, що вони просять у тебе. Чи в Ентраті.",shape=box,color=red];
		2466 -> 2476;
	2467 [label="Куди б не пішов Ентраті — скрізь за ним лишаються скривджені люди. Усе, що я намагаюся зробити, то це допомогти людям зібратися докупи. Мене не дуже обходить у цьому випадку «добро» він чи «зло».",shape=box,color=red];
		2467 -> 2477;
	2469 [label="Oui, ця твоя послідовна ненависть до нього ! Невже нічого з написаного мною не пом’якшило твого ставлення до le Cardinal ?",shape=box,color=blue];
		2469 -> 2482;
	2468 [label="Хіба це не твої слова щойно були про шанування Ентраті ? Що ти на моєму боці? Що змінило твою думку ?",shape=box,color=blue];
		2468 -> 2478;
		2468 -> 2479;
		2468 -> 2480;
		2468 -> 2481;
	2470 [label="Oui, а ти вважаєш Ентраті надзвичайним monstre ! Ти так швидко відкидаєш усе добре, що він тобі зробив !",shape=box,color=blue];
		2470 -> 2482;
	2473 [label="Хіба це не твої слова щойно були про monstruosité Ентраті ? Що змінило твою думку ?",shape=box,color=blue];
		2473 -> 2478;
		2473 -> 2479;
		2473 -> 2480;
		2473 -> 2481;
	2471 [label="Merci, ти незмінно стійко підтримуєш мене в цьому хрестовому поході ! Боюся, що ми лише двох із тобою тут — навіть монсеньйор Лойд приховує образу…",shape=box,color=blue];
		2471 -> 2483;
	2472 [label="Merci, я дуже рада це чути ! Боюся, що ми лише двох із тобою тут — навіть монсеньйор Лойд приховує образу…",shape=box,color=blue];
		2472 -> 2483;
	2474 [label="Я думаю, що проблема більше в тому, що ти просиш від інших геть не те саме, що вони просять у тебе. Чи в Ентраті.",shape=box,color=red];
		2474 -> 2476;
	2475 [label="І це тебе не бентежить?",shape=box,color=red];
		2475 -> 2484;
	2476 [label="І що ж такого неймовірного я прошу в інших ? Пустити прощення у свої серця ?",shape=box,color=blue];
		2476 -> 2485;
		2476 -> 2486;
	2477 [label="Але ж це так шляхетно, хоч і нудно, мандрувати крізь час і простір, допомагаючи mécontents, non ? Звісно. Чому б не поображатися на таке…",shape=box,color=blue];
		2477 -> 2487;
		2477 -> 2488;
	2482 [label="Ця розмова була помилкою…",shape=box,color=blue];
		2482 -> 2493;
		2482 -> 2494;
	2478 [label="Знаєш, мені дуже складно розбиратися в цій темі. До болю. Особисто я вважаю його… ані добрим, ані поганим. Там намішано всього.",shape=box,color=red];
		2478 -> 2489;
	2479 [label="Так, думка змінилася. Я на його боці. І на твоєму. Ти мене переконала.",shape=box,color=red];
		2479 -> 2490;
	2480 [label="[Зізнатися у почуттях] Просто я намагаюся зі всіх сил… показати, що я на твоєму боці. Я… у мене є почуття до тебе. Більші, аніж дозволяю бачити.",shape=box,color=red];
		2480 -> 2491;
	2481 [label="Так. Моя думка змінилася. Я вважаю його чудовиськом. І це назавжди.",shape=box,color=red];
		2481 -> 2492;
	2483 [label="Можливо, разом ми оборонятимемося від тих, хто наводить тінь на його добрі діяння, oui ? Але, мене цікавить дещо… Супроти всього й усіх довкола… чому ти обираєш мою сторону ?",shape=box,color=blue];
		2483 -> 2495;
	2484 [label="Check boolean LyonDating",color=orange];
		2484 -> 2496 [label=true,color=green];
		2484 -> 2497 [label=false,color=brown];
	2485 [label="Марі, ти звела Ентраті на постамент. І просиш інших зробити те саме, наче вони ідіоти.",shape=box,color=red];
		2485 -> 2498;
	2486 [label="Думаю, ти просиш у них дечого більшого, аніж просто пробачити Ентраті. Гадаю, ти просиш їх удавати, що все ним скоєне не було поганим.",shape=box,color=red];
		2486 -> 2499;
	2487 [label="Аякже. Але також маю йому «подякувати» за більшість важливих та дружніх стосунків, які в мене коли були.",shape=box,color=red];
		2487 -> 2500;
	2488 [label="Ні, не зовсім. Йому потрібні мої дії десь — я їх зроблю. А судитиму потім, коли все буде сказано й зроблено.",shape=box,color=red];
		2488 -> 2500;
	2493 [label="Марі, зажди. Прошу. Дай мені все пояснити.",shape=box,color=red];
		2493 -> 2505;
		2493 -> 2506;
		2493 -> 2507;
		2493 -> 2508;
	2494 [label="Моя позиція стосовно Ентраті чітка. Мені шкода. У дечому ми не дійдемо згоди.",shape=box,color=red];
		2494 -> 2509;
	2489 [label="Update boolean MarieEntratiMonster1",color=orange];
		2489 -> 2501;
	2490 [label="Update boolean MarieEntratiMonster1",color=orange];
		2490 -> 2502;
	2491 [label="Update boolean DrifterMarieWhoops",color=orange];
		2491 -> 2503;
	2492 [label="Update boolean MarieEntratiFan1",color=orange];
		2492 -> 2504;
	2495 [label="Але я не скаржуся, ні-ні !",shape=box,color=blue];
		2495 -> 2510;
		2495 -> 2511;
		2495 -> 2512;
	2496 [label="Я знаю, що у твоєму серці є для нього місце. І дуже вдячна за це. Може, нарешті перестану хвилюватися за нього і ці всі розмови невдовзі стануть порожніми…",shape=box,color=blue];
		2496 -> 2497;
	2497 [label="Але, звісно, я непокоюся. Він мій брат по духу ! Мій Ліон — найдорожче в цьому світі для мене. Я бачу його муки й у грудях щось боляче стискається, наче його agonie — моя.",shape=box,color=blue];
		2497 -> 2513;
	2498 [label="Пильнуй, що пишеш, мандрівниче.",shape=box,color=blue];
		2498 -> 2514;
	2499 [label="Je ne suis pas naïve, і не треба зі мною так розмовляти !",shape=box,color=blue];
		2499 -> 2515;
	2500 [label="Він, може, і впорскує краплю трунку для зцілення тіла, але це жорстока необхідність.",shape=box,color=blue];
		2500 -> 2516;
		2500 -> 2517;
	2505 [label="[Зізнатися у почуттях] У мене до тебе потяг, більший, аніж показую. І… пробач за грубість. Я не можу дозволити йому скривдити тебе. Як він учинив з іншими.",shape=box,color=red];
		2505 -> 2523;
	2506 [label="Мені довелося дивитися, як Ентраті лише спалював усіх, хто був йому небайдужим. Усіх, кого він мав любити. Не хочу бачити, як він зробить це з тобою…",shape=box,color=red];
		2506 -> 2524;
	2507 [label="Я не дуже вмію гарно викладати думки — вибач за це. Але він… боюся, він просто використовує тебе. Користується твоєю добротою, щоб маніпулювати. От і все.",shape=box,color=red];
		2507 -> 2525;
	2508 [label="Ти можеш бачити в Ентраті рятівника, але я бачу старого наляканого чоловіка, якому конче треба хоч якихось відповідей. Можливо, відповідь десь посередині.",shape=box,color=red];
		2508 -> 2498;
	2509 [label="Oui. Може й так.",shape=box,color=blue];
		2509 -> 2526;
	2501 [label="Update boolean MarieEntratiMonster2",color=orange];
		2501 -> 2518;
	2502 [label="Update boolean MarieEntratiMonster2",color=orange];
		2502 -> 2519;
	2503 [label="І тобі спало на думку мене обманути, щоб отримати мою прихильність… je vois.",shape=box,color=blue];
		2503 -> 2520;
		2503 -> 2521;
	2504 [label="Update boolean MarieEntratiFan2",color=orange];
		2504 -> 2522;
	2510 [label="[Зізнатися в почуттях] Ти небайдужа мені. Більше, аніж я показую.",shape=box,color=red];
		2510 -> 2527;
	2511 [label="Гадаю, що в цій війні все потрібно. Зрештою, ми ж намагаємося врятувати всесвіт від Байдужості, чи не так?",shape=box,color=red];
		2511 -> 2528;
	2512 [label="Я вірю в Ентраті. Чесно. Гадаю, він має план як усе виправити. І це все було задля всепереможного добра.",shape=box,color=red];
		2512 -> 2529;
	2513 [label="Але його зневіра — не справа рук le Cardinal. У фундаменті вже були тріщини. Просто додалося трішки більше тиску, oui ?",shape=box,color=blue];
		2513 -> 2500;
	2514 [label="Update boolean MarieWarning",color=orange];
		2514 -> 2499;
	2515 [label="Я чудово усвідомлюю, що le Cardinal — це Сол і Луа. Темрява й світло. Добро й зло. Він ніщо з того й усе разом. Здатний на добро й на жорстокість.",shape=box,color=blue];
		2515 -> 2530;
		2515 -> 2531;
	2516 [label="Саме тому всі засмучуються, коли ти починаєш говорити про нього. Ти нехтуєш усім, що він спричинив їм і завдав болю, удаючи, що цього не було. Наче вони якісь ідіоти.",shape=box,color=red];
		2516 -> 2498;
	2517 [label="Марі, зупинися. Тобі потрібно прийняти, що він робить усе це не тому, що є хорошою людиною. Він не такий. Він складніший за це.",shape=box,color=red];
		2517 -> 2499;
	2523 [label="Update boolean DrifterMarie",color=orange];
		2523 -> 2536;
	2524 [label="Пильнуй, що пишеш, мандрівниче.",shape=box,color=blue];
		2524 -> 2537;
	2525 [label="Мене не потрібно захищати ! Je ne suis pas une enfant naïve !",shape=box,color=blue];
		2525 -> 2538;
	2526 [label="Update boolean MarieEntrati5g",color=orange];
		2526 -> 2539;
	2518 [label="Update boolean MarieEntratiFan1",color=orange];
		2518 -> 2532;
	2519 [label="Update boolean MarieEntratiFan2",color=orange];
		2519 -> 2533;
	2520 [label="Ну, коли ти так говориш… ",shape=box,color=red];
		2520 -> 2534;
	2521 [label="Обман був частковим.",shape=box,color=red];
		2521 -> 2534;
	2522 [label="Update boolean MarieEntratiMonster2",color=orange];
		2522 -> 2535;
	2527 [label="Update boolean DrifterMarieWhoops",color=orange];
		2527 -> 2540;
	2528 [label="Oui ! Саме так ! Нарешті в комусь знайшлася дещиця притомності. Моє серце крається від того, що невинні можуть постраждати в цій війні, але на кону стоїть усе. ",shape=box,color=blue];
		2528 -> 2541;
	2529 [label="Update boolean MarieWillDate",color=orange];
		2529 -> 2542;
	2530 [label="Марі, він не бог. Він лише людина. Такий само пихатий і небезпечний, як Роут. Він з того самого суспільства й страждає від тих самих проблем.",shape=box,color=red];
		2530 -> 2543;
	2531 [label="Я знаю, що він був добрим до тебе. Я знаю, що до тебе він ставиться інакше, аніж до більшості. Може, навіть, уважав тебе донькою… Але прошу, подивися на загальну картинку.",shape=box,color=red];
		2531 -> 2544;
	2536 [label="Я… я не знаю, як сприймати ці новини, з огляду… на поточну розмову. Я… приголомшена. ",shape=box,color=blue];
		2536 -> 2549;
	2537 [label="Update boolean MarieWarning",color=orange];
		2537 -> 2525;
	2538 [label="Я чудово усвідомлюю, що le Cardinal — це Сол і Луа. Темрява й світло. Добро й зло. Він ніщо з того й усе разом. Здатний на добро й на жорстокість.",shape=box,color=blue];
		2538 -> 2531;
		2538 -> 2530;
	2539 [label="Chat ends. Next chat will be MarieEntratiDay2.",color=orange];
	2532 [label="Update boolean MarieEntratiFan2",color=orange];
		2532 -> 2545;
	2533 [label="Oui ? Я… сповнена надій, але не переконана в цьому. Ретельніше добирай слова, мандрівниче…",shape=box,color=blue];
		2533 -> 2546;
	2534 [label="Update boolean MarieNoDate",color=orange];
		2534 -> 2547;
	2535 [label="Oui ? Ти вважаєш мене дитиною чи дурепою ? Ретельніше добирай слова, мандрівниче…",shape=box,color=blue];
		2535 -> 2548;
	2540 [label="І тобі спало на думку пристати на сторону le Cardinal, щоб здобути мою прихильність… je vois.",shape=box,color=blue];
		2540 -> 2550;
		2540 -> 2551;
	2541 [label="У будь-якій війні страждають і гинуть невинні душі. Це сумно, але це факт, non ?",shape=box,color=blue];
		2541 -> 2552;
		2541 -> 2553;
	2542 [label="Update boolean MarieFamilyFail",color=orange];
		2542 -> 2554;
	2543 [label="Він — людина, яка прикликала (або й навіть створила) божество ! І тепер він єдиний, хто стоїть між ним і знищенням нашого всесвіту !",shape=box,color=blue];
		2543 -> 2555;
	2544 [label="Ти вважаєш, що я не знаю, що була не єдиною «донькою», яку він покинув ?! Я просто єдина, хто пробачає !",shape=box,color=blue];
		2544 -> 2556;
		2544 -> 2557;
	2549 [label="Ти насправді пишеш і пропонуєш це зараз ?! Отак ?! Тут ?! Vraiment ?!",shape=box,color=blue];
		2549 -> 2560;
	2545 [label="Oui ? Я… пробачу тобі цю брехню, але зважай, що маєш одне попередження. Ретельніше добирай слова, мандрівниче…",shape=box,color=blue];
		2545 -> 2558;
	2546 [label="Update boolean MarieWarning",color=orange];
		2546 -> 2483;
	2547 [label="Update boolean MarieEntrati5i",color=orange];
		2547 -> 2559;
	2548 [label="Update boolean MarieWarning",color=orange];
		2548 -> 2482;
	2550 [label="Ну, коли ти так говориш… ",shape=box,color=red];
		2550 -> 2561;
	2551 [label="Лише частково. Я вірю в Ентраті. Чесно.",shape=box,color=red];
		2551 -> 2561;
	2552 [label="Точно. Роут дуже тобою пишатиметься.",shape=box,color=red];
		2552 -> 2562;
	2553 [label="Скільки вже священних воєн відбулося в ім’я Сола? Що значитиме ще одна, так?",shape=box,color=red];
		2553 -> 2563;
	2554 [label="Add -10 to Family",color=orange];
		2554 -> 2564;
	2555 [label="Схоже, що я єдина, хто взагалі пам’ятає, що саме стоїть на кону !",shape=box,color=blue];
		2555 -> 2565;
		2555 -> 2557;
	2556 [label="Ти зараз припускаєш, от і все. Ти не знаєш цього. Ти її не бачила й гадки не маєш, через що вона пройшла. Чи що їй довелося витримати.",shape=box,color=red];
		2556 -> 2566;
	2557 [label="Ти думаєш, що він любитиме тебе більше через це? Вважаєш, що через це він повернеться до тебе? Бо ти єдина лишилася відданою йому?",shape=box,color=red];
		2557 -> 2567;
	2560 [label="Я… не можу. Не можу далі. Пробач. Ми про це поговоримо завтра. Мені потрібно владнати все в думках.",shape=box,color=blue];
		2560 -> 2569;
	2558 [label="Update boolean MarieWarning",color=orange];
		2558 -> 2568;
	2559 [label="Chat ends. Next chat will be MarieEntratiDay2.",color=orange];
	2561 [label="Update boolean MarieNoDate",color=orange];
		2561 -> 2570;
	2562 [label="Ta gueule !",shape=box,color=blue];
		2562 -> 2571;
	2563 [label="Я… це не те, що я маю на увазі. Це не священна війна. Це геть щось зовсім…",shape=box,color=blue];
		2563 -> 2572;
	2564 [label="Oui ! Précisément. І я впевнена, що з часом всі до цього дійдуть. Дуже рада мати дружню душу в цьому.",shape=box,color=blue];
		2564 -> 2573;
	2565 [label="Повір мені, це не так. Незліченна кількість людей втратили життя задля цього. У мене довжелезний список імен, чиї життя зруйновані через нього. Але ніхто не забув про Байдужість.",shape=box,color=red];
		2565 -> 2574;
	2566 [label="Упевнена, якби познайомилася з нею, то дізналася б про це ! Усі так квапляться розповісти як настраждалися від нього ! Не дивно, що le Cardinal не повертається. Я б і миті не хотіла тут провести на його місці…",shape=box,color=blue];
		2566 -> 2575;
	2567 [label="Не думаю, що це відвадило б його ! Думаєш, le Cardinal хоче повертатися в це гніздо vipères ?! Non ! Та я б тут і секунди не провела б на його місці…",shape=box,color=blue];
		2567 -> 2575;
	2569 [label="+20 Chemistry",color=orange];
		2569 -> 2577;
	2568 [label="І не треба зі мною балакати, наче я дитина.",shape=box,color=blue];
		2568 -> 2576;
	2570 [label="Update boolean MarieEntrati5h",color=orange];
		2570 -> 2578;
	2571 [label="+20 Chemistry",color=orange];
		2571 -> 2579;
	2572 [label="Я мушу йти.",shape=box,color=blue];
		2572 -> 2580;
	2573 [label="+40 Chemistry",color=orange];
		2573 -> 2581;
	2574 [label="Звідки така впевненість ? Усі так квапляться розповісти як настраждалися від нього ! Але ніхто не каже, якій меті це служило !",shape=box,color=blue];
		2574 -> 2582;
	2575 [label="Бо навіть монсеньйор Лойд, який стверджував, що кохає, ніяк не може наплакатися про його жорстокість за кожної зручної миті !",shape=box,color=blue];
		2575 -> 2583;
	2577 [label="Update boolean MarieEntrati5f",color=orange];
		2577 -> 2584;
	2576 [label="Я чудово усвідомлюю, що le Cardinal — це Сол і Луа. Темрява й світло. Добро й зло. Він ніщо з того й усе разом. Здатний на добро й на жорстокість.",shape=box,color=blue];
		2576 -> 2531;
