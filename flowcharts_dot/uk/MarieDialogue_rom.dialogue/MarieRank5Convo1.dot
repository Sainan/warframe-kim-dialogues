		j568090658 -> j1937162989;
	j1823886926 [label="Лише частково. Я вірю в Ентраті. Чесно.",shape=box,color=red];
		j1823886926 -> j1937162989;
	j1848072881 [label="Точно. Роут дуже тобою пишатиметься.",shape=box,color=red];
		j1848072881 -> j2710935490;
	j2171709808 [label="Скільки вже священних воєн відбулося в ім’я Сола? Що значитиме ще одна, так?",shape=box,color=red];
		j2171709808 -> j4212875545;
	j3775791171 [label="Add -10 to Family counter",color=orange];
		j3775791171 -> j3955616168;
	j3132607339 [label="Схоже, що я єдина, хто взагалі пам’ятає, що саме стоїть на кону !",shape=box,color=blue];
		j3132607339 -> j2706777858;
		j3132607339 -> j837508268;
	j1281212433 [label="Ти зараз припускаєш, от і все. Ти не знаєш цього. Ти її не бачила й гадки не маєш, через що вона пройшла. Чи що їй довелося витримати.",shape=box,color=red];
		j1281212433 -> j62877621;
	j837508268 [label="Ти думаєш, що він любитиме тебе більше через це? Вважаєш, що через це він повернеться до тебе? Бо ти єдина лишилася відданою йому?",shape=box,color=red];
		j837508268 -> j1068085288;
	j1671947193 [label="Я… не можу. Не можу далі. Пробач. Ми про це поговоримо завтра. Мені потрібно владнати все в думках.",shape=box,color=blue];
		j1671947193 -> j129422171;
	j1316560202 [label="Boolean MarieWarning is now true.",color=orange];
		j1316560202 -> j2554879365;
	j1937162989 [label="Boolean MarieNoDate is now true.",color=orange];
		j1937162989 -> j2945887645;
	j2710935490 [label="Ta gueule !",shape=box,color=blue];
		j2710935490 -> j3638167583;
	j4212875545 [label="Я… це не те, що я маю на увазі. Це не священна війна. Це геть щось зовсім…",shape=box,color=blue];
		j4212875545 -> j897991164;
	j3955616168 [label="Oui ! Précisément. І я впевнена, що з часом всі до цього дійдуть. Дуже рада мати дружню душу в цьому.",shape=box,color=blue];
		j3955616168 -> j300343042;
	j2706777858 [label="Повір мені, це не так. Незліченна кількість людей втратили життя задля цього. У мене довжелезний список імен, чиї життя зруйновані через нього. Але ніхто не забув про Байдужість.",shape=box,color=red];
		j2706777858 -> j165478569;
	j62877621 [label="Упевнена, якби познайомилася з нею, то дізналася б про це ! Усі так квапляться розповісти як настраждалися від нього ! Не дивно, що le Cardinal не повертається. Я б і миті не хотіла тут провести на його місці…",shape=box,color=blue];
		j62877621 -> j4204473654;
	j1068085288 [label="Не думаю, що це відвадило б його ! Думаєш, le Cardinal хоче повертатися в це гніздо vipères ?! Non ! Та я б тут і секунди не провела б на його місці…",shape=box,color=blue];
		j1068085288 -> j4204473654;
	j129422171 [label="+20 Chemistry",color=orange];
		j129422171 -> j2049400718;
	j2554879365 [label="І не треба зі мною балакати, наче я дитина.",shape=box,color=blue];
		j2554879365 -> j442909042;
