	j300343042 [label="+40 Chemistry",color=orange];
		j300343042 -> "Chat ends.";
	j165478569 [label="Звідки така впевненість ? Усі так квапляться розповісти як настраждалися від нього ! Але ніхто не каже, якій меті це служило !",shape=box,color=blue];
		j165478569 -> j2732480485;
