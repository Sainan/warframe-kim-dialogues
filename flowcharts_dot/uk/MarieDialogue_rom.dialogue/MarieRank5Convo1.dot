digraph {
	"MarieRank5Convo1 begins." [color=orange];
		"MarieRank5Convo1 begins." -> j1251432924;
	j1251432924 [label="Є час для розмови ?",shape=box,color=blue];
		j1251432924 -> j709500590;
	j709500590 [label="Evaluate expressions",color=orange];
		j709500590 -> j3765789908 [label="MarieEntrati4a",color=purple];
		j709500590 -> j1051180785 [label="MarieEntrati4b",color=purple];
		j709500590 -> j2620383799 [label="MarieEntrati3a",color=purple];
		j709500590 -> j1802498189 [label="MarieEntrati3b",color=purple];
		j709500590 -> j222332979 [label="MarieEntrati3",color=purple];
		j709500590 -> j133540517 [label="false",color=purple];
	j3765789908 [label="Я розмірковувала над твоїми словами стосовно le Cardinal. Що його дії… «суміш» прекрасного й мерзенного.",shape=box,color=blue];
		j3765789908 -> j599292568;
	j1051180785 [label="Я розмірковувала над твоїми словами стосовно le Cardinal. Що його дії могли завдати болю Ліону.",shape=box,color=blue];
		j1051180785 -> j599292568;
	j2620383799 [label="Я ще раз обміркувала нашу розмову стосовно мсьє Таґфером і розглянула детальніше твої переконливі аргументи, чому він так зневажає le Cardinal.",shape=box,color=blue];
		j2620383799 -> j599292568;
	j1802498189 [label="Я ще раз обміркувала мою суперечку з мсьє Таґфером і розглянула детальніше причини його зневаги до le Cardinal.",shape=box,color=blue];
		j1802498189 -> j599292568;
	j222332979 [label="Я ще раз обміркувала мою суперечку з мсьє Таґфером. І нашу суперечку стосовно тієї суперечки.",shape=box,color=blue];
		j222332979 -> j599292568;
	j133540517 [label="Я відчуваю, що чимало лишилося несказаним про le Cardinal. Схоже, інші навшпиньки обходять цю тему зі мною, боячись говорити про нього.",shape=box,color=blue];
		j133540517 -> j599292568;
	j599292568 [label="Я знаю, що інші хочуть затаврувати його шаленцем, зрадником, брудним скаженим псом… Але для мене він не такий.",shape=box,color=blue];
		j599292568 -> j2718976672;
	j2718976672 [label="Check boolean MarieBackstory1",color=orange];
		j2718976672 -> j2972830016 [label=true,color=green];
		j2718976672 -> j2055146311 [label=false,color=brown];
	j2972830016 [label="Можливо, через те, що я звикла бути покинутою. ",shape=box,color=blue];
		j2972830016 -> j1898440143;
	j2055146311 [label="Моя родина покинула мене, лишила на вулиці, коли я була ще дитиною. Через… через мою ненормальність. Поламаність. Непасування нормам вищого суспільства.",shape=box,color=blue];
		j2055146311 -> j1898440143;
	j1898440143 [label="Можливо, через те, що поруч не було батька, з яким могла б говорити. Через це я так охоче пробачаю відсутність le Cardinal.",shape=box,color=blue];
		j1898440143 -> j4106479212;
	j4106479212 [label="Evaluate expressions",color=orange];
		j4106479212 -> j2814054403 [label="MarieEntrati4a",color=purple];
		j4106479212 -> j1264801735 [label="MarieEntrati4b",color=purple];
		j4106479212 -> j3612388352 [label="MarieEntrati3a",color=purple];
		j4106479212 -> j3443496014 [label="MarieEntrati3b",color=purple];
		j4106479212 -> j1253100172 [label="MarieEntrati3",color=purple];
		j4106479212 -> j902980560 [label="false",color=purple];
	j2814054403 [label="Але факт лишається фактом — я пробачаю йому. Бо я бачу велику цінність у його добрих діяннях. Вона перевищує шкоду від злих.",shape=box,color=blue];
		j2814054403 -> j441726104;
		j2814054403 -> j231588665;
		j2814054403 -> j852314944;
		j2814054403 -> j59786798;
		j2814054403 -> j3312440919;
	j1264801735 [label="Я молюся за те, щоб Ліон був достатньо сильним і пережив кризу віри, від якої страждає. Але я не вірю, що це все через дії le Cardinal.",shape=box,color=blue];
		j1264801735 -> j441726104;
		j1264801735 -> j231588665;
		j1264801735 -> j852314944;
		j1264801735 -> j1852412168;
		j1264801735 -> j1376967681;
	j3612388352 [label="Тож попри те, що я ціную твої переконливі аргументи стосовно мсьє Таґфера й інших, кого було скривджено… Усе одно бачу велику цінність у його добрих діяннях. Вона перевищує шкоду від злих.",shape=box,color=blue];
		j3612388352 -> j441726104;
		j3612388352 -> j231588665;
		j3612388352 -> j852314944;
		j3612388352 -> j3173041112;
		j3612388352 -> j3804596565;
	j3443496014 [label="Тож я хоч і розумію гнів мсьє Таґфера і можу співчувати його втратам — він має знайти у своєму серці здатність пробачити le Cardinal. Бо я бачу велику цінність у його добрих діяннях. Вона перевищує шкоду від злих.",shape=box,color=blue];
		j3443496014 -> j441726104;
		j3443496014 -> j231588665;
		j3443496014 -> j852314944;
		j3443496014 -> j1149584463;
		j3443496014 -> j2728222816;
	j1253100172 [label="Тож попри те, що я вдячна за всі історії про le Cardinal і співчуваю їм, особливо мсьє Таґферу… Досі бачу велику цінність у його добрих діяннях. Вона перевищує шкоду від злих.",shape=box,color=blue];
		j1253100172 -> j441726104;
		j1253100172 -> j231588665;
		j1253100172 -> j852314944;
		j1253100172 -> j4271008366;
	j902980560 [label="Тож попри те, що я вдячна за всі історії про le Cardinal і співчуваю їм… Досі бачу велику цінність у його добрих діяннях. Вона перевищує шкоду від злих.",shape=box,color=blue];
		j902980560 -> j441726104;
		j902980560 -> j231588665;
		j902980560 -> j852314944;
	j441726104 [label="Я не звинувачую тебе у вдячності за все добро, яке він робив для тебе. Так само я не звинувачую інших в ображеності за ту шкоду, яку завдано їм.",shape=box,color=red];
		j441726104 -> j286515727;
	j231588665 [label="Я не знаю. Думаю, його дії завдали більшої шкоди, аніж принесли добра. Хотілося б, щоб ти побачила це.",shape=box,color=red];
		j231588665 -> j4288371264;
	j852314944 [label="Марі, я на твоєму боці. Не можу звинувачувати Ентраті за будь-що скоєне. Він б’ється з Байдужістю.",shape=box,color=red];
		j852314944 -> j3142094137;
	j59786798 [label="Ти правильно робиш, що пробачаєш Ентраті. Якби ж інші теж ішли цією стежкою за тобою.",shape=box,color=red];
		j59786798 -> j3142094137;
	j3312440919 [label="Ніколи не доводилося звинувачувати когось за прощення. Але не можна пробачити комусь, усвідомлюючи, що маєш захищати інших від таких осіб.",shape=box,color=red];
		j3312440919 -> j1953349993;
	j1852412168 [label="Думаєш, що страждання Ліона — його власна провина?",shape=box,color=red];
		j1852412168 -> j3197183197;
	j1376967681 [label="Марі, Ліон страждає від дечого більшого, аніж втрати віри. І чимало з того пов’язано з Ентраті.",shape=box,color=red];
		j1376967681 -> j4288371264;
	j3173041112 [label="Невже нічого з усього написаного мною анітрохи не врівноважило шальки терезів?",shape=box,color=red];
		j3173041112 -> j2006715206;
	j3804596565 [label="Як ти можеш спостерігати результати вчинків Ентраті й досі бачити більше добра, аніж шкоди?",shape=box,color=red];
		j3804596565 -> j4288371264;
	j1149584463 [label="Думаю, ти надто применшуєш величину страждань кавій та особливо Таґфера.",shape=box,color=red];
		j1149584463 -> j4288371264;
	j2728222816 [label="Прощення важливе. Але як і знання того, що Ентраті може бути набагато складнішим, аніж ти хочеш приймати.",shape=box,color=red];
		j2728222816 -> j2006715206;
	j4271008366 [label="Досі не думаю, що ти усвідомлюєш, що саме пережили Таґфер і кавії. Це набагато гірше за те, крізь що пройшла ти.",shape=box,color=red];
		j4271008366 -> j4288371264;
	j286515727 [label="Але хіба ти не бачиш абсолютну різницю в цінності цих двох понять ? Образи та шанування ? Мені дуже хотілося б, щоб інші відмовилися від свого злісного невдоволення.",shape=box,color=blue];
		j286515727 -> j479977476;
		j286515727 -> j2929610682;
	j4288371264 [label="Evaluate expressions",color=orange];
		j4288371264 -> j598099103 [label="MarieEntratiMonster1",color=purple];
		j4288371264 -> j598099103 [label="MarieEntratiMonster2",color=purple];
		j4288371264 -> j1036604385 [label="MarieEntratiFan1",color=purple];
		j4288371264 -> j1036604385 [label="MarieEntratiFan2",color=purple];
		j4288371264 -> j3511315255 [label="false",color=purple];
	j3142094137 [label="Evaluate expressions",color=orange];
		j3142094137 -> j994446179 [label="MarieEntratiMonster1",color=purple];
		j3142094137 -> j994446179 [label="MarieEntratiMonster2",color=purple];
		j3142094137 -> j3233337429 [label="MarieEntratiFan1",color=purple];
		j3142094137 -> j3233337429 [label="MarieEntratiFan2",color=purple];
		j3142094137 -> j2146421982 [label="false",color=purple];
	j1953349993 [label="І що ти пропонуєш робити ? Прогнати геть le Cardinal ? Маю зазначити, що це дуже схоже на те, що він сам уже зробив, non ?",shape=box,color=blue];
		j1953349993 -> j2149425247;
		j1953349993 -> j2929610682;
	j3197183197 [label="Думаю, Ліон страждає від багатьох недуг через те, що має сумніви в собі та власній свідомості. Le Cardinal лише… дещо пришвидшив процеси.",shape=box,color=blue];
		j3197183197 -> j2125170298;
		j3197183197 -> j2929610682;
	j2006715206 [label="І що ти хочеш, щоб я робила ? Спалила опудало le Cardinal і виголосила анафему ? Засудила на вигнання у Порожнечу, бажала йому зла, як мсьє Таґфер ?",shape=box,color=blue];
		j2006715206 -> j2149425247;
		j2006715206 -> j2929610682;
	j479977476 [label="У цьому то й проблема, Марі. Те, що ти просиш від інших — не те саме, що вони просять у тебе. Чи в Ентраті.",shape=box,color=red];
		j479977476 -> j406026974;
	j2929610682 [label="Куди б не пішов Ентраті — скрізь за ним лишаються скривджені люди. Усе, що я намагаюся зробити, то це допомогти людям зібратися докупи. Мене не дуже обходить у цьому випадку «добро» він чи «зло».",shape=box,color=red];
		j2929610682 -> j3360728410;
	j598099103 [label="Oui, ця твоя послідовна ненависть до нього ! Невже нічого з написаного мною не пом’якшило твого ставлення до le Cardinal ?",shape=box,color=blue];
		j598099103 -> j1011211466;
	j1036604385 [label="Хіба це не твої слова щойно були про шанування Ентраті ? Що ти на моєму боці? Що змінило твою думку ?",shape=box,color=blue];
		j1036604385 -> j2114953862;
		j1036604385 -> j1616821013;
		j1036604385 -> j4048074173;
		j1036604385 -> j1541948604;
	j3511315255 [label="Oui, а ти вважаєш Ентраті надзвичайним monstre ! Ти так швидко відкидаєш усе добре, що він тобі зробив !",shape=box,color=blue];
		j3511315255 -> j1011211466;
	j994446179 [label="Хіба це не твої слова щойно були про monstruosité Ентраті ? Що змінило твою думку ?",shape=box,color=blue];
		j994446179 -> j2114953862;
		j994446179 -> j1616821013;
		j994446179 -> j4048074173;
		j994446179 -> j1541948604;
	j3233337429 [label="Merci, ти незмінно стійко підтримуєш мене в цьому хрестовому поході ! Боюся, що ми лише двох із тобою тут — навіть монсеньйор Лойд приховує образу…",shape=box,color=blue];
		j3233337429 -> j1343448838;
	j2146421982 [label="Merci, я дуже рада це чути ! Боюся, що ми лише двох із тобою тут — навіть монсеньйор Лойд приховує образу…",shape=box,color=blue];
		j2146421982 -> j1343448838;
	j2149425247 [label="Я думаю, що проблема більше в тому, що ти просиш від інших геть не те саме, що вони просять у тебе. Чи в Ентраті.",shape=box,color=red];
		j2149425247 -> j406026974;
	j2125170298 [label="І це тебе не бентежить?",shape=box,color=red];
		j2125170298 -> j2159116448;
	j406026974 [label="І що ж такого неймовірного я прошу в інших ? Пустити прощення у свої серця ?",shape=box,color=blue];
		j406026974 -> j2049985749;
		j406026974 -> j2150578939;
	j3360728410 [label="Але ж це так шляхетно, хоч і нудно, мандрувати крізь час і простір, допомагаючи mécontents, non ? Звісно. Чому б не поображатися на таке…",shape=box,color=blue];
		j3360728410 -> j2822411495;
		j3360728410 -> j17978858;
	j1011211466 [label="Ця розмова була помилкою…",shape=box,color=blue];
		j1011211466 -> j207494963;
		j1011211466 -> j62995570;
	j2114953862 [label="Знаєш, мені дуже складно розбиратися в цій темі. До болю. Особисто я вважаю його… ані добрим, ані поганим. Там намішано всього.",shape=box,color=red];
		j2114953862 -> j1514134902;
	j1616821013 [label="Так, думка змінилася. Я на його боці. І на твоєму. Ти мене переконала.",shape=box,color=red];
		j1616821013 -> j831588853;
	j4048074173 [label="[Зізнатися у почуттях] Просто я намагаюся зі всіх сил… показати, що я на твоєму боці. Я… у мене є почуття до тебе. Більші, аніж дозволяю бачити.",shape=box,color=red];
		j4048074173 -> j2136026524;
	j1541948604 [label="Так. Моя думка змінилася. Я вважаю його чудовиськом. І це назавжди.",shape=box,color=red];
		j1541948604 -> j2249523801;
	j1343448838 [label="Можливо, разом ми оборонятимемося від тих, хто наводить тінь на його добрі діяння, oui ? Але, мене цікавить дещо… Супроти всього й усіх довкола… чому ти обираєш мою сторону ?",shape=box,color=blue];
		j1343448838 -> j3408652267;
	j2159116448 [label="Check boolean LyonDating",color=orange];
		j2159116448 -> j3935190752 [label=true,color=green];
		j2159116448 -> j1197306772 [label=false,color=brown];
	j2049985749 [label="Марі, ти звела Ентраті на постамент. І просиш інших зробити те саме, наче вони ідіоти.",shape=box,color=red];
		j2049985749 -> j1789809189;
	j2150578939 [label="Думаю, ти просиш у них дечого більшого, аніж просто пробачити Ентраті. Гадаю, ти просиш їх удавати, що все ним скоєне не було поганим.",shape=box,color=red];
		j2150578939 -> j3452662331;
	j2822411495 [label="Аякже. Але також маю йому «подякувати» за більшість важливих та дружніх стосунків, які в мене коли були.",shape=box,color=red];
		j2822411495 -> j1347042761;
	j17978858 [label="Ні, не зовсім. Йому потрібні мої дії десь — я їх зроблю. А судитиму потім, коли все буде сказано й зроблено.",shape=box,color=red];
		j17978858 -> j1347042761;
	j207494963 [label="Марі, зажди. Прошу. Дай мені все пояснити.",shape=box,color=red];
		j207494963 -> j3478087783;
		j207494963 -> j296318160;
		j207494963 -> j2648328388;
		j207494963 -> j4181045798;
	j62995570 [label="Моя позиція стосовно Ентраті чітка. Мені шкода. У дечому ми не дійдемо згоди.",shape=box,color=red];
		j62995570 -> j286434881;
	j1514134902 [label="Boolean MarieEntratiMonster1 is now false.",color=orange];
		j1514134902 -> j2384838710;
	j831588853 [label="Boolean MarieEntratiMonster1 is now false.",color=orange];
		j831588853 -> j2178918039;
	j2136026524 [label="Boolean DrifterMarieWhoops is now true.",color=orange];
		j2136026524 -> j946960476;
	j2249523801 [label="Boolean MarieEntratiFan1 is now false.",color=orange];
		j2249523801 -> j2733876973;
	j3408652267 [label="Але я не скаржуся, ні-ні !",shape=box,color=blue];
		j3408652267 -> j1404936562;
		j3408652267 -> j3100543793;
		j3408652267 -> j1423520850;
	j3935190752 [label="Я знаю, що у твоєму серці є для нього місце. І дуже вдячна за це. Може, нарешті перестану хвилюватися за нього і ці всі розмови невдовзі стануть порожніми…",shape=box,color=blue];
		j3935190752 -> j1197306772;
	j1197306772 [label="Але, звісно, я непокоюся. Він мій брат по духу ! Мій Ліон — найдорожче в цьому світі для мене. Я бачу його муки й у грудях щось боляче стискається, наче його agonie — моя.",shape=box,color=blue];
		j1197306772 -> j2555425577;
	j1789809189 [label="Пильнуй, що пишеш, мандрівниче.",shape=box,color=blue];
		j1789809189 -> j3809559224;
	j3452662331 [label="Je ne suis pas naïve, і не треба зі мною так розмовляти !",shape=box,color=blue];
		j3452662331 -> j36949982;
	j1347042761 [label="Він, може, і впорскує краплю трунку для зцілення тіла, але це жорстока необхідність.",shape=box,color=blue];
		j1347042761 -> j310248212;
		j1347042761 -> j1239011208;
	j3478087783 [label="[Зізнатися у почуттях] У мене до тебе потяг, більший, аніж показую. І… пробач за грубість. Я не можу дозволити йому скривдити тебе. Як він учинив з іншими.",shape=box,color=red];
		j3478087783 -> j1637486829;
	j296318160 [label="Мені довелося дивитися, як Ентраті лише спалював усіх, хто був йому небайдужим. Усіх, кого він мав любити. Не хочу бачити, як він зробить це з тобою…",shape=box,color=red];
		j296318160 -> j2894457274;
	j2648328388 [label="Я не дуже вмію гарно викладати думки — вибач за це. Але він… боюся, він просто використовує тебе. Користується твоєю добротою, щоб маніпулювати. От і все.",shape=box,color=red];
		j2648328388 -> j1349645079;
	j4181045798 [label="Ти можеш бачити в Ентраті рятівника, але я бачу старого наляканого чоловіка, якому конче треба хоч якихось відповідей. Можливо, відповідь десь посередині.",shape=box,color=red];
		j4181045798 -> j1789809189;
	j286434881 [label="Oui. Може й так.",shape=box,color=blue];
		j286434881 -> j3051126039;
	j2384838710 [label="Boolean MarieEntratiMonster2 is now false.",color=orange];
		j2384838710 -> j3754267705;
	j2178918039 [label="Boolean MarieEntratiMonster2 is now false.",color=orange];
		j2178918039 -> j2483220306;
	j946960476 [label="І тобі спало на думку мене обманути, щоб отримати мою прихильність… je vois.",shape=box,color=blue];
		j946960476 -> j3569876036;
		j946960476 -> j1082672694;
	j2733876973 [label="Boolean MarieEntratiFan2 is now false.",color=orange];
		j2733876973 -> j2244159511;
	j1404936562 [label="[Зізнатися в почуттях] Ти небайдужа мені. Більше, аніж я показую.",shape=box,color=red];
		j1404936562 -> j704287245;
	j3100543793 [label="Гадаю, що в цій війні все потрібно. Зрештою, ми ж намагаємося врятувати всесвіт від Байдужості, чи не так?",shape=box,color=red];
		j3100543793 -> j2939363692;
	j1423520850 [label="Я вірю в Ентраті. Чесно. Гадаю, він має план як усе виправити. І це все було задля всепереможного добра.",shape=box,color=red];
		j1423520850 -> j2876205443;
	j2555425577 [label="Але його зневіра — не справа рук le Cardinal. У фундаменті вже були тріщини. Просто додалося трішки більше тиску, oui ?",shape=box,color=blue];
		j2555425577 -> j1347042761;
	j3809559224 [label="Boolean MarieWarning is now true.",color=orange];
		j3809559224 -> j3452662331;
	j36949982 [label="Я чудово усвідомлюю, що le Cardinal — це Сол і Луа. Темрява й світло. Добро й зло. Він ніщо з того й усе разом. Здатний на добро й на жорстокість.",shape=box,color=blue];
		j36949982 -> j3431418582;
		j36949982 -> j1013466284;
	j310248212 [label="Саме тому всі засмучуються, коли ти починаєш говорити про нього. Ти нехтуєш усім, що він спричинив їм і завдав болю, удаючи, що цього не було. Наче вони якісь ідіоти.",shape=box,color=red];
		j310248212 -> j1789809189;
	j1239011208 [label="Марі, зупинися. Тобі потрібно прийняти, що він робить усе це не тому, що є хорошою людиною. Він не такий. Він складніший за це.",shape=box,color=red];
		j1239011208 -> j3452662331;
	j1637486829 [label="Boolean DrifterMarie is now true.",color=orange];
		j1637486829 -> j1033232719;
	j2894457274 [label="Пильнуй, що пишеш, мандрівниче.",shape=box,color=blue];
		j2894457274 -> j2418058994;
	j1349645079 [label="Мене не потрібно захищати ! Je ne suis pas une enfant naïve !",shape=box,color=blue];
		j1349645079 -> j442909042;
	j3051126039 [label="Boolean MarieEntrati5g is now true.",color=orange];
		j3051126039 -> "Chat ends. Next chat will be MarieEntratiDay2.";
