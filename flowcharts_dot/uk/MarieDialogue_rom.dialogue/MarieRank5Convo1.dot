	2581 [label="Chat ends.",color=orange];
	2582 [label="Le Cardinal веде війну ! А на війні страждають невинні. Це сумно, але це факт !",shape=box,color=blue];
		2582 -> 2587;
		2582 -> 2588;
		2582 -> 2589;
	2583 [label="Ніхто не розуміє le Cardinal. А він веде війну ! І на війні можуть страждати невинні. Це сумно, але це факт !",shape=box,color=blue];
