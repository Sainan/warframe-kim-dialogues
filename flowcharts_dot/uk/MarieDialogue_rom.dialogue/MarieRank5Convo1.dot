		j3754267705 -> j3332436793;
	j2483220306 [label="Boolean MarieEntratiFan2 is now true.",color=orange];
		j2483220306 -> j3857605695;
	j3569876036 [label="Ну, коли ти так говориш… ",shape=box,color=red];
		j3569876036 -> j1073700449;
	j1082672694 [label="Обман був частковим.",shape=box,color=red];
		j1082672694 -> j1073700449;
	j2244159511 [label="Boolean MarieEntratiMonster2 is now true.",color=orange];
		j2244159511 -> j2750620009;
	j704287245 [label="Boolean DrifterMarieWhoops is now true.",color=orange];
		j704287245 -> j2509228746;
	j2939363692 [label="Oui ! Саме так ! Нарешті в комусь знайшлася дещиця притомності. Моє серце крається від того, що невинні можуть постраждати в цій війні, але на кону стоїть усе. ",shape=box,color=blue];
		j2939363692 -> j1744770734;
	j2876205443 [label="Boolean MarieWillDate is now true.",color=orange];
		j2876205443 -> j1181806579;
	j3431418582 [label="Марі, він не бог. Він лише людина. Такий само пихатий і небезпечний, як Роут. Він з того самого суспільства й страждає від тих самих проблем.",shape=box,color=red];
		j3431418582 -> j3255712407;
	j1013466284 [label="Я знаю, що він був добрим до тебе. Я знаю, що до тебе він ставиться інакше, аніж до більшості. Може, навіть, уважав тебе донькою… Але прошу, подивися на загальну картинку.",shape=box,color=red];
		j1013466284 -> j414887310;
	j1033232719 [label="Я… я не знаю, як сприймати ці новини, з огляду… на поточну розмову. Я… приголомшена. ",shape=box,color=blue];
		j1033232719 -> j1010519685;
	j2418058994 [label="Boolean MarieWarning is now true.",color=orange];
		j2418058994 -> j1349645079;
	j442909042 [label="Я чудово усвідомлюю, що le Cardinal — це Сол і Луа. Темрява й світло. Добро й зло. Він ніщо з того й усе разом. Здатний на добро й на жорстокість.",shape=box,color=blue];
		j442909042 -> j1013466284;
