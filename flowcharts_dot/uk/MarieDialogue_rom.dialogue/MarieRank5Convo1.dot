	j3332436793 [label="Boolean MarieEntratiFan2 is now false.",color=orange];
		j3332436793 -> j409742128;
	j3857605695 [label="Oui ? Я… сповнена надій, але не переконана в цьому. Ретельніше добирай слова, мандрівниче…",shape=box,color=blue];
		j3857605695 -> j3505122564;
	j1073700449 [label="Boolean MarieNoDate is now true.",color=orange];
		j1073700449 -> j4094969604;
	j2750620009 [label="Oui ? Ти вважаєш мене дитиною чи дурепою ? Ретельніше добирай слова, мандрівниче…",shape=box,color=blue];
		j2750620009 -> j2119066890;
	j2509228746 [label="І тобі спало на думку пристати на сторону le Cardinal, щоб здобути мою прихильність… je vois.",shape=box,color=blue];
		j2509228746 -> j568090658;
		j2509228746 -> j1823886926;
	j1744770734 [label="У будь-якій війні страждають і гинуть невинні душі. Це сумно, але це факт, non ?",shape=box,color=blue];
		j1744770734 -> j1848072881;
		j1744770734 -> j2171709808;
	j1181806579 [label="Boolean MarieFamilyFail is now true.",color=orange];
		j1181806579 -> j3775791171;
	j3255712407 [label="Він — людина, яка прикликала (або й навіть створила) божество ! І тепер він єдиний, хто стоїть між ним і знищенням нашого всесвіту !",shape=box,color=blue];
		j3255712407 -> j3132607339;
	j414887310 [label="Ти вважаєш, що я не знаю, що була не єдиною «донькою», яку він покинув ?! Я просто єдина, хто пробачає !",shape=box,color=blue];
		j414887310 -> j1281212433;
		j414887310 -> j837508268;
	j1010519685 [label="Ти насправді пишеш і пропонуєш це зараз ?! Отак ?! Тут ?! Vraiment ?!",shape=box,color=blue];
		j1010519685 -> j1671947193;
	j409742128 [label="Oui ? Я… пробачу тобі цю брехню, але зважай, що маєш одне попередження. Ретельніше добирай слова, мандрівниче…",shape=box,color=blue];
		j409742128 -> j1316560202;
