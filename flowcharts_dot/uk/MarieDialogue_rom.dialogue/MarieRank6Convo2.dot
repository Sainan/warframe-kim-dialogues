	3484 [label="Я зустрілася з Отаком ! Нарешті ми познайомилися !",shape=box,color=blue];
		3484 -> 3487;
		3484 -> 3488;
	3485 [label="Вовченя ! Моє вовченя ! Обличчя позаду монсеньйора Некралойда ! Ми нарешті познайомилися !",shape=box,color=blue];
		3485 -> 3489;
		3485 -> 3490;
		3485 -> 3491;
	3486 [label="Обличчя позаду монсеньйора Некралойда ! Ми нарешті познайомилися !",shape=box,color=blue];
		3486 -> 3489;
		3486 -> 3490;
		3486 -> 3491;
	3487 [label="Тобі сподобалося балакати з ним?",shape=box,color=red];
		3487 -> 3492;
	3488 [label="І як пройшла розмова?",shape=box,color=red];
		3488 -> 3493;
	3489 [label="Бідолашний Отак… І як усе пройшло?",shape=box,color=red];
		3489 -> 3494;
	3490 [label="Тішуся з вашого знайомства. Отака іноді буває складно сприйняти.",shape=box,color=red];
		3490 -> 3495;
	3491 [label="Ти познайомилася з Отаком? Лишенько… І як усе пройшло?",shape=box,color=red];
		3491 -> 3496;
	3492 [label="Так. Хоча хотілося плакати від неї. Він… тричі за одну бесіду знайомився зі мною, наче ми були до цього не знайомі.",shape=box,color=blue];
		3492 -> 3497;
	3493 [label="Він… тричі за одну бесіду знайомився зі мною, наче ми були до цього не знайомі.",shape=box,color=blue];
		3493 -> 3497;
	3494 [label="Він виявився дуже милим і чарівним ! Але десь за товстими шарами гумору я відчула зранену душу.",shape=box,color=blue];
		3494 -> 3498;
	3495 [label="Та, думаю так. Дитячі каракулі на спині автоматона. Виявилося, що то дуже мила й чарівна особистість !",shape=box,color=blue];
		3495 -> 3499;
	3496 [label="А чого я між рядків читаю, що ти наче не дуже радієш нашому знайомству ?",shape=box,color=blue];
		3496 -> 3500;
		3496 -> 3501;
		3496 -> 3502;
	3497 [label="Він вітав мене так само незворушно й радісно, як попередні рази. Але ж я вже казала, що я Sœur de Sol ! ",shape=box,color=blue];
		3497 -> 3503;
	3498 [label="Ти розповіси мені історію бідолашного монсеньйора Отака ?",shape=box,color=blue];
		3498 -> 3504;
	3499 [label="Але десь за товстими шарами гумору я відчула зранену душу.",shape=box,color=blue];
		3499 -> 3498;
	3500 [label="Він іноді мене дуже бісить. От і все. ",shape=box,color=red];
		3500 -> 3505;
	3501 [label="Я не про те. Він просто іноді буває… трохи відштовхує своєю поведінкою.",shape=box,color=red];
		3501 -> 3506;
	3502 [label="Мені шкода. Він іноді може довести до сказу. Але це не його провина.",shape=box,color=red];
		3502 -> 3506;
	3503 [label="І справді, він чимало знав про Світочі ! Ми багато говорили про «прадавні релігії» (це він так назвав їх) у часи «до орокінської імперії».",shape=box,color=blue];
		3503 -> 3507;
	3504 [label="Отак колись був архімедівцем, орокінським ученим і академіком. А подальша історія не з тих, що зі щасливим завершенням.",shape=box,color=red];
		3504 -> 3508;
	3505 [label="Сподіваюся, ти намагатимешся виявляти більше доброти до того, хто явно не при собі. Усі ми mais par la grâce de Sol.",shape=box,color=blue];
		3505 -> 3509;
	3506 [label="Я маю надію, що зрештою вони всі виявляли доброту й терплячість. Усі ми mais par la grâce de Sol.",shape=box,color=blue];
		3506 -> 3509;
	3507 [label="Ще він казав, що велика частина з тих знань давно втрачена, десь у глибинах архівів і дуже-дуже заборонена. Вимагав присяги на мовчання.",shape=box,color=blue];
		3507 -> 3510;
	3508 [label="З усіх подій стає зрозумілим, що він був генієм і тим, хто опанував використання кристалів аргону.",shape=box,color=red];
		3508 -> 3511;
	3509 [label="Така доля може спіткати нас усіх. Навіть тебе.",shape=box,color=blue];
		3509 -> 3512;
		3509 -> 3513;
	3510 [label="Він мені розповів про глибоке незапокоєння тим, що виконавець Баллас (хто б він не був) може знайти мою єретичну секту й стратити мене особисто.",shape=box,color=blue];
		3510 -> 3514;
		3510 -> 3515;
	3511 [label="А вони походять із Порожнечі. І саме завдяки їм ми можемо створювати чимало ворфреймів та потужну зброю.",shape=box,color=red];
		3511 -> 3516;
	3512 [label="Саме так. Твоя правда. Не це малося на увазі.",shape=box,color=red];
		3512 -> 3498;
	3513 [label="Ти вибач, але в мене бракує вільного часу, щоб ще й на нього його витрачати.",shape=box,color=red];
		3513 -> 3517;
	3514 [label="Баллас мертвий… продовжуй.",shape=box,color=red];
		3514 -> 3518;
	3515 [label="Цього… не станеться. Тож розповідай далі.",shape=box,color=red];
		3515 -> 3518;
	3516 [label="Він спеціалізувався на криптографії. І його роботи в тутешніх архівах, у лабораторіях.",shape=box,color=red];
		3516 -> 3519;
	3517 [label="Тоді мені шкода, що змарнувала ще одну його частку.",shape=box,color=blue];
		3517 -> 3520;
	3518 [label="+5 Chemistry",color=orange];
		3518 -> 3521;
	3519 [label="З якихось причин, невідомих мені, його перетворили на цефалона й дали власну оболонку некралойда.",shape=box,color=red];
		3519 -> 3522;
	3520 [label="Update boolean MarieOtakComplete",color=orange];
		3520 -> 3523;
	3521 [label="Я чомусь так і подумала… Ну, він спитав мене звідки я. Коли ж відповіла, то він зареготаві і сказав: «Ні, цього не може бути. Я точно знаю, я ж…»",shape=box,color=blue];
		3521 -> 3524;
	3522 [label="Не всіх робили цефалонами в покарання. Але на Деймосі все пішло… м'яко кажучи, шкереберть. Його сильно пошкодило.",shape=box,color=red];
		3522 -> 3525;
	3523 [label="Chat ends.",color=orange];
	3524 [label="І… знову назвався мені й почав знайомитися. І спитав, чи я не принесла з собою зразки мінералів…",shape=box,color=blue];
		3524 -> 3526;
		3524 -> 3527;
	3525 [label="Pauvre petit…",shape=box,color=blue];
		3525 -> 3528;
	3526 [label="Так… такий він, Отак.",shape=box,color=red];
