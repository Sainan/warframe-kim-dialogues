		3555 -> 3558;
	3556 [label="Merci. Але я більше не хочу. Робитиму щось веселеньке ! Думаю, настала черга витерти пил з акваріума мсьє Фібоначчі.",shape=box,color=blue];
		3556 -> 3559;
	3557 [label="Ха ! Merci. Це точно зупинить потік цих дурних сліз. А ти добре знаєш, як звеселити дурненьку маленьку Марі, non ?",shape=box,color=blue];
		3557 -> 3560;
		3557 -> 3561;
	3558 [label="Oui. Твоя правда. Вони такі. Світ сповнений історій, подібних до оповіді про монсеньйора Отака, а ще більше набагато гірших. Не варто ридати над кожною з них. ",shape=box,color=blue];
		3558 -> 3562;
	3559 [label="Check boolean MarieDating",color=orange];
