		3530 -> 3533 [label="MarieCephalonUnsure",color=purple];
		3530 -> 3534 [label="false",color=purple];
	3531 [label="О, Світочі, що ж за пекло ви йому таке створили, що душа застрягла в клітці з науки та мерехтливих вогників ?",shape=box,color=blue];
		3531 -> 3535;
	3532 [label="Я можу лише молитися Світочам, щоб твої слова були правдою, і нічого не було в тій оболонці… окрім науки та мерехтливих вогників.",shape=box,color=blue];
		3532 -> 3536;
	3533 [label="Я знаю про твою невпевненість у наявності душі в цефалонів. Але молитимуся Світочам, щоб… щоб бідолашний Отак не страждав.",shape=box,color=blue];
		3533 -> 3537;
	3534 [label="Я можу лише молитися Світочам, щоб нічого не було в тій оболонці… нічого, окрім науки та мерехтливих вогників.",shape=box,color=blue];
		3534 -> 3538;
	3535 [label="Для чого його лишати тут, поламаного ? Щоб він чекав дозволу померти й знайти омріяний спокій ? Я можу лише молитися… що якщо там щось лишилося…",shape=box,color=blue];
		3535 -> 3539;
	3536 [label="І нема душі в тій поламаній штуці, яка чекає дозволу нарешті померти й знайти омріяний спокій.",shape=box,color=blue];
		3536 -> 3540;
	3537 [label="Що нема душі в тій поламаній штуці, яка чекає дозволу нарешті померти й знайти омріяний спокій.",shape=box,color=blue];
		3537 -> 3541;
	3538 [label="І нема душі в тій поламаній штуці, яка чекає дозволу нарешті померти й знайти омріяний спокій.",shape=box,color=blue];
		3538 -> 3541;
	3539 [label="То це через те, що він захотів так сам — сам обрав нести цю обітницю…",shape=box,color=blue];
		3539 -> 3542;
	3540 [label="Бо якщо ти помиляєшся і душа в тій клітці супроти своєї волі ?",shape=box,color=blue];
		3540 -> 3543;
	3541 [label="Чи якщо там щось лишилося, то це через те, що він захотів так сам — сам обрав нести цю обітницю.",shape=box,color=blue];
		3541 -> 3544;
	3542 [label="Думати інакше якраз достатньо, щоби піддати сумнівам доброту богів, non ?",shape=box,color=blue];
		3542 -> 3545;
	3543 [label="Цього ж достатньо, щоби піддати сумнівам доброту богів, non ?",shape=box,color=blue];
		3543 -> 3545;
	3544 [label="Думати інакше якраз достатньо, щоби піддати сумнівам доброту богів, non ?",shape=box,color=blue];
