		j967122264 -> j3619684352 [label=true,color=green];
		j967122264 -> j3979133402 [label=false,color=brown];
	j3619684352 [label="Check boolean MarieDating",color=orange];
		j3619684352 -> j2409348919 [label=true,color=green];
		j3619684352 -> j1589320680 [label=false,color=brown];
	j3979133402 [label="Check boolean MarieDating",color=orange];
		j3979133402 -> j160721865 [label=true,color=green];
		j3979133402 -> j2630408319 [label=false,color=brown];
	j2409348919 [label="Вовченя ! Моє вовченя ! Я зустрілася з Отаком ! Нарешті ми познайомилися !",shape=box,color=blue];
		j2409348919 -> j2732852460;
		j2409348919 -> j3395367850;
	j1589320680 [label="Я зустрілася з Отаком ! Нарешті ми познайомилися !",shape=box,color=blue];
		j1589320680 -> j2732852460;
		j1589320680 -> j3395367850;
	j160721865 [label="Вовченя ! Моє вовченя ! Обличчя позаду монсеньйора Некралойда ! Ми нарешті познайомилися !",shape=box,color=blue];
		j160721865 -> j1206236404;
		j160721865 -> j3837469014;
		j160721865 -> j1198189003;
	j2630408319 [label="Обличчя позаду монсеньйора Некралойда ! Ми нарешті познайомилися !",shape=box,color=blue];
		j2630408319 -> j1206236404;
		j2630408319 -> j3837469014;
		j2630408319 -> j1198189003;
	j2732852460 [label="Тобі сподобалося балакати з ним?",shape=box,color=red];
		j2732852460 -> j3277015367;
	j3395367850 [label="І як пройшла розмова?",shape=box,color=red];
		j3395367850 -> j3370735456;
	j1206236404 [label="Бідолашний Отак… І як усе пройшло?",shape=box,color=red];
		j1206236404 -> j1297566792;
	j3837469014 [label="Тішуся з вашого знайомства. Отака іноді буває складно сприйняти.",shape=box,color=red];
		j3837469014 -> j1953346119;
	j1198189003 [label="Ти познайомилася з Отаком? Лишенько… І як усе пройшло?",shape=box,color=red];
		j1198189003 -> j2738147946;
	j3277015367 [label="Так. Хоча хотілося плакати від неї. Він… тричі за одну бесіду знайомився зі мною, наче ми були до цього не знайомі.",shape=box,color=blue];
		j3277015367 -> j2639610119;
	j3370735456 [label="Він… тричі за одну бесіду знайомився зі мною, наче ми були до цього не знайомі.",shape=box,color=blue];
		j3370735456 -> j2639610119;
	j1297566792 [label="Він виявився дуже милим і чарівним ! Але десь за товстими шарами гумору я відчула зранену душу.",shape=box,color=blue];
		j1297566792 -> j564675882;
	j1953346119 [label="Та, думаю так. Дитячі каракулі на спині автоматона. Виявилося, що то дуже мила й чарівна особистість !",shape=box,color=blue];
		j1953346119 -> j42765405;
	j2738147946 [label="А чого я між рядків читаю, що ти наче не дуже радієш нашому знайомству ?",shape=box,color=blue];
		j2738147946 -> j222144080;
		j2738147946 -> j2645934636;
		j2738147946 -> j3509497558;
	j2639610119 [label="Він вітав мене так само незворушно й радісно, як попередні рази. Але ж я вже казала, що я Sœur de Sol ! ",shape=box,color=blue];
		j2639610119 -> j1563701738;
	j564675882 [label="Ти розповіси мені історію бідолашного монсеньйора Отака ?",shape=box,color=blue];
		j564675882 -> j3395878380;
	j42765405 [label="Але десь за товстими шарами гумору я відчула зранену душу.",shape=box,color=blue];
		j42765405 -> j564675882;
	j222144080 [label="Він іноді мене дуже бісить. От і все. ",shape=box,color=red];
		j222144080 -> j740870027;
	j2645934636 [label="Я не про те. Він просто іноді буває… трохи відштовхує своєю поведінкою.",shape=box,color=red];
		j2645934636 -> j1229686601;
	j3509497558 [label="Мені шкода. Він іноді може довести до сказу. Але це не його провина.",shape=box,color=red];
		j3509497558 -> j1229686601;
	j1563701738 [label="І справді, він чимало знав про Світочі ! Ми багато говорили про «прадавні релігії» (це він так назвав їх) у часи «до орокінської імперії».",shape=box,color=blue];
		j1563701738 -> j1334843708;
	j3395878380 [label="Отак колись був архімедівцем, орокінським ученим і академіком. А подальша історія не з тих, що зі щасливим завершенням.",shape=box,color=red];
		j3395878380 -> j3497872624;
	j740870027 [label="Сподіваюся, ти намагатимешся виявляти більше доброти до того, хто явно не при собі. Усі ми mais par la grâce de Sol.",shape=box,color=blue];
		j740870027 -> j519865635;
	j1229686601 [label="Я маю надію, що зрештою вони всі виявляли доброту й терплячість. Усі ми mais par la grâce de Sol.",shape=box,color=blue];
		j1229686601 -> j519865635;
	j1334843708 [label="Ще він казав, що велика частина з тих знань давно втрачена, десь у глибинах архівів і дуже-дуже заборонена. Вимагав присяги на мовчання.",shape=box,color=blue];
		j1334843708 -> j1289109;
	j3497872624 [label="З усіх подій стає зрозумілим, що він був генієм і тим, хто опанував використання кристалів аргону.",shape=box,color=red];
		j3497872624 -> j16682235;
	j519865635 [label="Така доля може спіткати нас усіх. Навіть тебе.",shape=box,color=blue];
		j519865635 -> j1629110666;
		j519865635 -> j3211504873;
	j1289109 [label="Він мені розповів про глибоке незапокоєння тим, що виконавець Баллас (хто б він не був) може знайти мою єретичну секту й стратити мене особисто.",shape=box,color=blue];
		j1289109 -> j992664914;
		j1289109 -> j1368571595;
	j16682235 [label="А вони походять із Порожнечі. І саме завдяки їм ми можемо створювати чимало ворфреймів та потужну зброю.",shape=box,color=red];
		j16682235 -> j824950932;
	j1629110666 [label="Саме так. Твоя правда. Не це малося на увазі.",shape=box,color=red];
		j1629110666 -> j564675882;
	j3211504873 [label="Ти вибач, але в мене бракує вільного часу, щоб ще й на нього його витрачати.",shape=box,color=red];
		j3211504873 -> j372269021;
	j992664914 [label="Баллас мертвий… продовжуй.",shape=box,color=red];
		j992664914 -> j417543582;
	j1368571595 [label="Цього… не станеться. Тож розповідай далі.",shape=box,color=red];
		j1368571595 -> j417543582;
	j824950932 [label="Він спеціалізувався на криптографії. І його роботи в тутешніх архівах, у лабораторіях.",shape=box,color=red];
		j824950932 -> j2294193339;
	j372269021 [label="Тоді мені шкода, що змарнувала ще одну його частку.",shape=box,color=blue];
		j372269021 -> j3007723528;
	j417543582 [label="+5 Chemistry",color=orange];
		j417543582 -> j1029271015;
	j2294193339 [label="З якихось причин, невідомих мені, його перетворили на цефалона й дали власну оболонку некралойда.",shape=box,color=red];
		j2294193339 -> j186458946;
	j3007723528 [label="Boolean MarieOtakComplete is now true.",color=orange];
		j3007723528 -> "Chat ends.";
	j1029271015 [label="Я чомусь так і подумала… Ну, він спитав мене звідки я. Коли ж відповіла, то він зареготаві і сказав: «Ні, цього не може бути. Я точно знаю, я ж…»",shape=box,color=blue];
		j1029271015 -> j3998917201;
	j186458946 [label="Не всіх робили цефалонами в покарання. Але на Деймосі все пішло… м'яко кажучи, шкереберть. Його сильно пошкодило.",shape=box,color=red];
		j186458946 -> j728945233;
	j3998917201 [label="І… знову назвався мені й почав знайомитися. І спитав, чи я не принесла з собою зразки мінералів…",shape=box,color=blue];
		j3998917201 -> j3125726980;
		j3998917201 -> j1825268039;
	j728945233 [label="Pauvre petit…",shape=box,color=blue];
		j728945233 -> j253530729;
	j3125726980 [label="Так… такий він, Отак.",shape=box,color=red];
		j3125726980 -> j2312582720;
	j1825268039 [label="Ох, Марі. Мені так шкода…",shape=box,color=red];
		j1825268039 -> j2312582720;
	j253530729 [label="Boolean MarieOtak1 is now true.",color=orange];
		j253530729 -> j2732852460;
		j253530729 -> j3395367850;
	j2312582720 [label="Мене це ранить мільярдами ран — те, що нічого для нього зробити не можна.",shape=box,color=blue];
		j2312582720 -> j457335464;
	j457335464 [label="Evaluate expressions",color=orange];
		j457335464 -> j42901959 [label="MarieCephalonSoul",color=purple];
		j457335464 -> j1610567122 [label="MarieCephalonNoSoul",color=purple];
		j457335464 -> j3731552327 [label="MarieCephalonUnsure",color=purple];
		j457335464 -> j1904128963 [label="false",color=purple];
	j42901959 [label="О, Світочі, що ж за пекло ви йому таке створили, що душа застрягла в клітці з науки та мерехтливих вогників ?",shape=box,color=blue];
		j42901959 -> j449227299;
	j1610567122 [label="Я можу лише молитися Світочам, щоб твої слова були правдою, і нічого не було в тій оболонці… окрім науки та мерехтливих вогників.",shape=box,color=blue];
		j1610567122 -> j3647893933;
	j3731552327 [label="Я знаю про твою невпевненість у наявності душі в цефалонів. Але молитимуся Світочам, щоб… щоб бідолашний Отак не страждав.",shape=box,color=blue];
		j3731552327 -> j3144513459;
	j1904128963 [label="Я можу лише молитися Світочам, щоб нічого не було в тій оболонці… нічого, окрім науки та мерехтливих вогників.",shape=box,color=blue];
		j1904128963 -> j1382872641;
	j449227299 [label="Для чого його лишати тут, поламаного ? Щоб він чекав дозволу померти й знайти омріяний спокій ? Я можу лише молитися… що якщо там щось лишилося…",shape=box,color=blue];
		j449227299 -> j4067028248;
	j3647893933 [label="І нема душі в тій поламаній штуці, яка чекає дозволу нарешті померти й знайти омріяний спокій.",shape=box,color=blue];
		j3647893933 -> j3175557801;
	j3144513459 [label="Що нема душі в тій поламаній штуці, яка чекає дозволу нарешті померти й знайти омріяний спокій.",shape=box,color=blue];
		j3144513459 -> j2725566850;
	j1382872641 [label="І нема душі в тій поламаній штуці, яка чекає дозволу нарешті померти й знайти омріяний спокій.",shape=box,color=blue];
		j1382872641 -> j2725566850;
	j4067028248 [label="То це через те, що він захотів так сам — сам обрав нести цю обітницю…",shape=box,color=blue];
		j4067028248 -> j1041004455;
	j3175557801 [label="Бо якщо ти помиляєшся і душа в тій клітці супроти своєї волі ?",shape=box,color=blue];
		j3175557801 -> j1845737015;
	j2725566850 [label="Чи якщо там щось лишилося, то це через те, що він захотів так сам — сам обрав нести цю обітницю.",shape=box,color=blue];
		j2725566850 -> j1041004455;
	j1041004455 [label="Думати інакше якраз достатньо, щоби піддати сумнівам доброту богів, non ?",shape=box,color=blue];
		j1041004455 -> j468867371;
	j1845737015 [label="Цього ж достатньо, щоби піддати сумнівам доброту богів, non ?",shape=box,color=blue];
		j1845737015 -> j468867371;
	j468867371 [label="І як тоді мені самій бути ?",shape=box,color=blue];
		j468867371 -> j3370519732;
	j3370519732 [label="Пробач мені… я сьогодні дуже меланхолійна. ",shape=box,color=blue];
		j3370519732 -> j3251038745;
	j3251038745 [label="Evaluate expressions",color=orange];
		j3251038745 -> j2845691541 [label="MarieRoathePastry1",color=purple];
		j3251038745 -> j2830225097 [label="MarieRoathePastry1",color=purple];
		j3251038745 -> j974425834 [label="MarieRoathePastry1",color=purple];
		j3251038745 -> j2142490763 [label="MarieRoathePastry1",color=purple];
		j3251038745 -> j2845691541 [label="RoatheMariePastry1",color=purple];
		j3251038745 -> j2830225097 [label="RoatheMariePastry1",color=purple];
		j3251038745 -> j974425834 [label="RoatheMariePastry1",color=purple];
		j3251038745 -> j2142490763 [label="RoatheMariePastry1",color=purple];
		j3251038745 -> j2845691541 [label="false",color=purple];
		j3251038745 -> j2830225097 [label="false",color=purple];
		j3251038745 -> j2142490763 [label="false",color=purple];
	j2845691541 [label="Усе добре. Ти маєш повне право бути такою.",shape=box,color=red];
		j2845691541 -> j1168032885;
	j2830225097 [label="Я можу щось зробити, щоб розвеселити тебе? Можемо сходити разом катувати Роута.",shape=box,color=red];
		j2830225097 -> j254807497;
	j974425834 [label="Я можу щось зробити, щоб розвеселити тебе? Може, викрасти якусь смачну випічку?",shape=box,color=red];
		j974425834 -> j1453174421;
	j2142490763 [label="Марі, боги іноді жорстокі. Такий плин життя.",shape=box,color=red];
		j2142490763 -> j875704294;
	j1168032885 [label="+20 Chemistry",color=orange];
		j1168032885 -> j2644542090;
	j254807497 [label="+15 Chemistry",color=orange];
		j254807497 -> j3794950577;
	j1453174421 [label="+20 Chemistry",color=orange];
		j1453174421 -> j3794950577;
	j875704294 [label="+5 Chemistry",color=orange];
		j875704294 -> j1129685453;
	j2644542090 [label="Merci. Але я більше не хочу. Робитиму щось веселеньке ! Думаю, настала черга витерти пил з акваріума мсьє Фібоначчі.",shape=box,color=blue];
		j2644542090 -> j2486340526;
	j3794950577 [label="Ха ! Merci. Це точно зупинить потік цих дурних сліз. А ти добре знаєш, як звеселити дурненьку маленьку Марі, non ?",shape=box,color=blue];
		j3794950577 -> j1289056443;
		j3794950577 -> j1717011858;
	j1129685453 [label="Oui. Твоя правда. Вони такі. Світ сповнений історій, подібних до оповіді про монсеньйора Отака, а ще більше набагато гірших. Не варто ридати над кожною з них. ",shape=box,color=blue];
		j1129685453 -> j1576423103;
	j2486340526 [label="Check boolean MarieDating",color=orange];
		j2486340526 -> j3435079465 [label=true,color=green];
		j2486340526 -> j1783435543 [label=false,color=brown];
	j1289056443 [label="Це найменше, що я можу для тебе зробити.",shape=box,color=red];
		j1289056443 -> j1350233930;
	j1717011858 [label="Ти геть не дурненька. Я почуваюся так само.",shape=box,color=red];
		j1717011858 -> j1350233930;
	j1576423103 [label="Однак я досі тут сиджу і досі ридаю. Дякую, що нагадуєш мені про мою тупу натуру. Fie ! Дурненька маленька Марі. Що ж… Думаю, варто витрети пил з акваріума мсьє Фібоначчі.",shape=box,color=blue];
		j1576423103 -> j2486340526;
	j3435079465 [label="À la revoyure, моє вовченя.",shape=box,color=blue];
		j3435079465 -> j3007723528;
	j1783435543 [label="À la revoyure !",shape=box,color=blue];
		j1783435543 -> j3007723528;
	j1350233930 [label="+5 Chemistry",color=orange];
		j1350233930 -> j4058209286;
	j4058209286 [label="Check boolean MarieDating",color=orange];
		j4058209286 -> j910735012 [label=true,color=green];
		j4058209286 -> j2580241406 [label=false,color=brown];
	j910735012 [label="Merci, merci, merci, моє вовченя. Ходімо побешкетуймо. ",shape=box,color=blue];
		j910735012 -> j3007723528;
	j2580241406 [label="Merci, merci, merci. Ходімо побешкетуймо.",shape=box,color=blue];
		j2580241406 -> j3007723528;
}