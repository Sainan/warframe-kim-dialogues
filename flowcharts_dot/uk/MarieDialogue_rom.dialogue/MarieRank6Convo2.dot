	3548 [label="Усе добре. Ти маєш повне право бути такою.",shape=box,color=red];
		3548 -> 3552;
	3549 [label="Я можу щось зробити, щоб розвеселити тебе? Можемо сходити разом катувати Роута.",shape=box,color=red];
		3549 -> 3553;
	3550 [label="Я можу щось зробити, щоб розвеселити тебе? Може, викрасти якусь смачну випічку?",shape=box,color=red];
		3550 -> 3554;
	3551 [label="Марі, боги іноді жорстокі. Такий плин життя.",shape=box,color=red];
