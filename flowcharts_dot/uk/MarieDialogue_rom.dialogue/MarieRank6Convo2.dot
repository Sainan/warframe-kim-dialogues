		3559 -> 3564 [label=false,color=brown];
	3560 [label="Це найменше, що я можу для тебе зробити.",shape=box,color=red];
		3560 -> 3565;
	3561 [label="Ти геть не дурненька. Я почуваюся так само.",shape=box,color=red];
		3561 -> 3565;
	3562 [label="Однак я досі тут сиджу і досі ридаю. Дякую, що нагадуєш мені про мою тупу натуру. Fie ! Дурненька маленька Марі. Що ж… Думаю, варто витрети пил з акваріума мсьє Фібоначчі.",shape=box,color=blue];
