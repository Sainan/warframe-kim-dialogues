digraph {
	graph [fontname="Roboto Condensed"];
	node [fontname="Roboto Condensed"];
	edge [fontname="Roboto Condensed"];

	"MarieRank4Convo3 begins." [color=orange];
		"MarieRank4Convo3 begins." -> j705205296;
		"MarieRank4Convo3 begins." -> j1478915251;
	j705205296 [label="Марі, як справи сьогодні?",shape=box,color=red];
		j705205296 -> j2290452360;
	j1478915251 [label="[Завершити розмову]",shape=box,color=red];
		j1478915251 -> "Chat ends.";
	j2290452360 [label="Я не в гуморі сьогодні. Можливо, тобі варто написати завтра. Бо нині з мене не найліпша співрозмовниця.",shape=box,color=blue];
		j2290452360 -> j949255492;
		j2290452360 -> j3348997822;
		j2290452360 -> j973326561;
	"Chat ends." [color=orange];
	j949255492 [label="Якщо захочеш, я вимкнуся. Але й із радістю вислухаю (чи то пак прочитаю).",shape=box,color=red];
		j949255492 -> j3462795892;
	j3348997822 [label="Буває, я розумію.",shape=box,color=red];
		j3348997822 -> "Chat ends.";
	j973326561 [label="Чи можу спитати, що в тебе сталося?..",shape=box,color=red];
		j973326561 -> j3462795892;
	j3462795892 [label="C'est vraiment gentil, та це давня біда… нічого вартого твоїх клопотів. Упораюся.",shape=box,color=blue];
		j3462795892 -> j3096270068;
	j3096270068 [label="Boolean MarieChronicPain is now true.",color=orange];
		j3096270068 -> j376898073;
		j3096270068 -> j3934790010;
		j3096270068 -> j468501000;
	j376898073 [label="Як скажеш, але я тут, якщо захочеш обговорити.",shape=box,color=red];
		j376898073 -> j4036042806;
	j3934790010 [label="Я… я знаю як це. Перш ніж «зациклитися в петлях», мені було дуже зле в Дувірі. Рани загоєно, але іноді досі дуже сильно свербить. Я намагаюся приховувати зовнішні прояви, коли терпіти майже нестерпно.",shape=box,color=red];
		j3934790010 -> j3835019172;
	j468501000 [label="Наскільки я знаю, то старі постійні проблеми можуть бути такими проблемними, як і нові. Те, що вони повертаються і йдуть чи лишаються поруч на деякий час, не означає, що про них не варто говорити.",shape=box,color=red];
		j468501000 -> j1127981058;
	j4036042806 [label="Це дуже мило з твого боку… і… що ж. Перестану бути маленькою впертою Марі.",shape=box,color=blue];
		j4036042806 -> j584171859;
	j3835019172 [label="Boolean DrifterChronicPain is now true.",color=orange];
		j3835019172 -> j4025114431;
	j1127981058 [label="Oui, tu as raison. Знову я була маленькою впертою Марі.",shape=box,color=blue];
		j1127981058 -> j584171859;
	j584171859 [label="Це дещо складно пояснити. Але я спробую. Mes pieds, oui ? Ніженьки мої. Sérum змінила мене, дала можливість літати…",shape=box,color=blue];
		j584171859 -> j3018341688;
	j4025114431 [label="Par les Luminaires, мені так шкода. То тоді ти розумієш як це, oui ?",shape=box,color=blue];
		j4025114431 -> j1118707517;
	j3018341688 [label="Але я досі відчуваю їх. Ті потворні штуки, які погрожували поглинути мене, знищити всю надію і висмоктати joie з моєї душі.",shape=box,color=blue];
		j3018341688 -> j3306865342;
	j1118707517 [label="Мати тіло, яке тебе зраджує. Гнітить твій дух і сповільнює його. Навіть зараз. Це так дивно. Sérum змінила мене, дала можливість літати…",shape=box,color=blue];
		j1118707517 -> j3018341688;
	j3306865342 [label="Завжди болять. Завжди. Навіть зараз, коли я сиджу тут і думаю про них, то відчуваю біль. Але не завжди такий, що можу помітити.",shape=box,color=blue];
		j3306865342 -> j2989198650;
	j2989198650 [label="Я досі уночі прокидаюся від болю в них. І мені дивно… Соле, pourquoi ? Чому я досі відчуваю цю… agonie interminable ?",shape=box,color=blue];
		j2989198650 -> j387941019;
	j387941019 [label="Яка мета в цього ? Яке призначення ? А потім настає ранок, і я регочу над собою й кажу: «Мовчи, Марі, ти благословенна є. Поглянь на все, що ти маєш і що можеш зробити».",shape=box,color=blue];
		j387941019 -> j185982236;
	j185982236 [label="У Cathédrale було так: «Тобі можна читати, писати, їсти, спати. Ти можеш як-не-як, але рухатися. У тебе є очі, щоби бачити, і язик, щоб говорити. Маєш руки, які допоможуть робити все назване. І в тебе є ті, хто дбатимуть про тебе». А тепер я можу літати! Я спроможна захистити futur від самої Порожнечі. Від l'Indifférence !",shape=box,color=blue];
		j185982236 -> j735048023;
	j735048023 [label="«Поплач зараз, дурне дівчисько, цей постійний біль зробить тебе сильнішою й стійкішою до того, що прийде», — кажу собі. А потім настає інший день, який вже й не таким поганим здається, коли його змінює наступний.",shape=box,color=blue];
		j735048023 -> j830269311;
	j830269311 [label="Check boolean DrifterChronicPain",color=orange];
		j830269311 -> j4274413236 [label=true,color=green];
		j830269311 -> j743516800 [label=true,color=green];
		j830269311 -> j1710333121 [label=false,color=brown];
		j830269311 -> j1346574502 [label=false,color=brown];
	j4274413236 [label="Якщо нам і є якась користь з цього всього, то це точно терпимість до болю.",shape=box,color=red];
		j4274413236 -> j593317504;
	j743516800 [label="Знаєш, іноді… прокидаюся й почуваюся так, наче це саме той день, коли я зламаюся.",shape=box,color=red];
		j743516800 -> j593317504;
	j1710333121 [label="Воно… біль ніколи не припиняється? Марі, мені дуже-дуже прикро…",shape=box,color=red];
		j1710333121 -> j1216254565;
	j1346574502 [label="І жодних ліків проти цього? Нічим не зарадиш?",shape=box,color=red];
		j1346574502 -> j2774793788;
	j593317504 [label="Один із парафіян якось мене спитав: «Тобі болить ? Завжди ?». А я відповіла: «Oui, monsieur. Je le suis». Його приголомшення було змішане з жахом.",shape=box,color=blue];
		j593317504 -> j3928698411;
	j1216254565 [label="Іноді я сиділа й думала як багато могла б зробити, якби не жила в постійній agonie, oui ? Якби не була… у пастці плоті, що так уперто намагалася мене підвести кожної миті.",shape=box,color=blue];
		j1216254565 -> j4118358539;
	j2774793788 [label="Мені дуже хотілося, щоб щось було. Mais non, але нічого нема. Ні в моєму часі, ні, боюся, у цьому теж.",shape=box,color=blue];
		j2774793788 -> j1317017126;
	j3928698411 [label="Надалі він спитав: «А як же ти тримаєшся ?». Я чітко пам’ятаю, як усміхнулася та відповіла: «Монсеньйоре, а чи є в мене вибір ?».",shape=box,color=blue];
		j3928698411 -> j3933192047;
		j3928698411 -> j2274916659;
	j4118358539 [label="І це мене так гнівило ! Я так заздрила тим, чиї тіла не були вродженою зрадою для них. Але зрештою, яка з тих думок користь, à part rendre nos vies plus amères ? Лише ще більша злоба ?",shape=box,color=blue];
		j4118358539 -> j828091103;
	j1317017126 [label="Деякі болячки поза можливостями зцілення людиною, наукою та вірою.",shape=box,color=blue];
		j1317017126 -> j1216254565;
	j3933192047 [label="Мені доводилося так багато разів вести подібні розмови…",shape=box,color=red];
		j3933192047 -> j1216254565;
	j2274916659 [label="Саме так. Мені дуже прикро.",shape=box,color=red];
		j2274916659 -> j2729721745;
	j828091103 [label="Aucun. Я прийняла себе якою є. І я триматимуся.",shape=box,color=blue];
		j828091103 -> j2980398560;
	j2729721745 [label="Та non. Це мені дуже шкода, і я співчуваю твоїй подібній agonie. ",shape=box,color=blue];
		j2729721745 -> j1216254565;
	j2980398560 [label="Check boolean DrifterChronicPain",color=orange];
		j2980398560 -> j3811932631 [label=true,color=green];
		j2980398560 -> j1028462465 [label=false,color=brown];
	j3811932631 [label="І ти теж. Так, ти теж. Я вірую в це.",shape=box,color=blue];
		j3811932631 -> j1028462465;
	j1028462465 [label="+20 Chemistry",color=orange];
		j1028462465 -> j2336705447;
	j2336705447 [label="Не доберу слів, як багато ця сповідь значить для мене. Тож скажу лише… Merci, мандрівниче.",shape=box,color=blue];
		j2336705447 -> j3563974437;
	j3563974437 [label="Et encore merci.",shape=box,color=blue];
		j3563974437 -> "Chat ends.";
}