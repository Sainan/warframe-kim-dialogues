digraph {
	2239 [label="MarieRank4Convo3 begins.",color=orange];
		2239 -> 2240;
		2239 -> 2241;
	2240 [label="Марі, як справи сьогодні?",shape=box,color=red];
		2240 -> 2242;
	2241 [label="[Завершити розмову]",shape=box,color=red];
		2241 -> 2243;
	2242 [label="Я не в гуморі сьогодні. Можливо, тобі варто написати завтра. Бо нині з мене не найліпша співрозмовниця.",shape=box,color=blue];
		2242 -> 2244;
		2242 -> 2245;
		2242 -> 2246;
	2243 [label="Chat ends.",color=orange];
	2244 [label="Якщо захочеш, я вимкнуся. Але й із радістю вислухаю (чи то пак прочитаю).",shape=box,color=red];
		2244 -> 2247;
	2245 [label="Буває, я розумію.",shape=box,color=red];
		2245 -> 2248;
	2246 [label="Чи можу спитати, що в тебе сталося?..",shape=box,color=red];
		2246 -> 2247;
	2247 [label="C'est vraiment gentil, та це давня біда… нічого вартого твоїх клопотів. Упораюся.",shape=box,color=blue];
		2247 -> 2249;
	2248 [label="Chat ends.",color=orange];
	2249 [label="Update boolean MarieChronicPain",color=orange];
		2249 -> 2250;
		2249 -> 2251;
		2249 -> 2252;
	2250 [label="Як скажеш, але я тут, якщо захочеш обговорити.",shape=box,color=red];
		2250 -> 2253;
	2251 [label="Я… я знаю як це. Перш ніж «зациклитися в петлях», мені було дуже зле в Дувірі. Рани загоєно, але іноді досі дуже сильно свербить. Я намагаюся приховувати зовнішні прояви, коли терпіти майже нестерпно.",shape=box,color=red];
		2251 -> 2254;
	2252 [label="Наскільки я знаю, то старі постійні проблеми можуть бути такими проблемними, як і нові. Те, що вони повертаються і йдуть чи лишаються поруч на деякий час, не означає, що про них не варто говорити.",shape=box,color=red];
		2252 -> 2255;
	2253 [label="Це дуже мило з твого боку… і… що ж. Перестану бути маленькою впертою Марі.",shape=box,color=blue];
		2253 -> 2256;
	2254 [label="Update boolean DrifterChronicPain",color=orange];
		2254 -> 2257;
	2255 [label="Oui, tu as raison. Знову я була маленькою впертою Марі.",shape=box,color=blue];
		2255 -> 2256;
	2256 [label="Це дещо складно пояснити. Але я спробую. Mes pieds, oui ? Ніженьки мої. Sérum змінила мене, дала можливість літати…",shape=box,color=blue];
		2256 -> 2258;
	2257 [label="Par les Luminaires, мені так шкода. То тоді ти розумієш як це, oui ?",shape=box,color=blue];
		2257 -> 2259;
	2258 [label="Але я досі відчуваю їх. Ті потворні штуки, які погрожували поглинути мене, знищити всю надію і висмоктати joie з моєї душі.",shape=box,color=blue];
		2258 -> 2260;
	2259 [label="Мати тіло, яке тебе зраджує. Гнітить твій дух і сповільнює його. Навіть зараз. Це так дивно. Sérum змінила мене, дала можливість літати…",shape=box,color=blue];
		2259 -> 2258;
	2260 [label="Завжди болять. Завжди. Навіть зараз, коли я сиджу тут і думаю про них, то відчуваю біль. Але не завжди такий, що можу помітити.",shape=box,color=blue];
		2260 -> 2261;
	2261 [label="Я досі уночі прокидаюся від болю в них. І мені дивно… Соле, pourquoi ? Чому я досі відчуваю цю… agonie interminable ?",shape=box,color=blue];
		2261 -> 2262;
	2262 [label="Яка мета в цього ? Яке призначення ? А потім настає ранок, і я регочу над собою й кажу: «Мовчи, Марі, ти благословенна є. Поглянь на все, що ти маєш і що можеш зробити».",shape=box,color=blue];
		2262 -> 2263;
	2263 [label="У Cathédrale було так: «Тобі можна читати, писати, їсти, спати. Ти можеш як-не-як, але рухатися. У тебе є очі, щоби бачити, і язик, щоб говорити. Маєш руки, які допоможуть робити все назване. І в тебе є ті, хто дбатимуть про тебе». А тепер я можу літати! Я спроможна захистити futur від самої Порожнечі. Від l'Indifférence !",shape=box,color=blue];
		2263 -> 2264;
	2264 [label="«Поплач зараз, дурне дівчисько, цей постійний біль зробить тебе сильнішою й стійкішою до того, що прийде», — кажу собі. А потім настає інший день, який вже й не таким поганим здається, коли його змінює наступний.",shape=box,color=blue];
		2264 -> 2265;
	2265 [label="Check boolean DrifterChronicPain",color=orange];
		2265 -> 2266 [label=true,color=green];
		2265 -> 2269 [label=true,color=green];
		2265 -> 2267 [label=false,color=brown];
		2265 -> 2268 [label=false,color=brown];
	2266 [label="Якщо нам і є якась користь з цього всього, то це точно терпимість до болю.",shape=box,color=red];
		2266 -> 2270;
	2269 [label="Знаєш, іноді… прокидаюся й почуваюся так, наче це саме той день, коли я зламаюся.",shape=box,color=red];
		2269 -> 2270;
	2267 [label="Воно… біль ніколи не припиняється? Марі, мені дуже-дуже прикро…",shape=box,color=red];
		2267 -> 2271;
	2268 [label="І жодних ліків проти цього? Нічим не зарадиш?",shape=box,color=red];
		2268 -> 2272;
	2270 [label="Один із парафіян якось мене спитав: «Тобі болить ? Завжди ?». А я відповіла: «Oui, monsieur. Je le suis». Його приголомшення було змішане з жахом.",shape=box,color=blue];
		2270 -> 2273;
	2271 [label="Іноді я сиділа й думала як багато могла б зробити, якби не жила в постійній agonie, oui ? Якби не була… у пастці плоті, що так уперто намагалася мене підвести кожної миті.",shape=box,color=blue];
		2271 -> 2274;
	2272 [label="Мені дуже хотілося, щоб щось було. Mais non, але нічого нема. Ні в моєму часі, ні, боюся, у цьому теж.",shape=box,color=blue];
		2272 -> 2275;
	2273 [label="Надалі він спитав: «А як же ти тримаєшся ?». Я чітко пам’ятаю, як усміхнулася та відповіла: «Монсеньйоре, а чи є в мене вибір ?».",shape=box,color=blue];
		2273 -> 2276;
		2273 -> 2277;
	2274 [label="І це мене так гнівило ! Я так заздрила тим, чиї тіла не були вродженою зрадою для них. Але зрештою, яка з тих думок користь, à part rendre nos vies plus amères ? Лише ще більша злоба ?",shape=box,color=blue];
		2274 -> 2278;
	2275 [label="Деякі болячки поза можливостями зцілення людиною, наукою та вірою.",shape=box,color=blue];
		2275 -> 2271;
	2276 [label="Мені доводилося так багато разів вести подібні розмови…",shape=box,color=red];
		2276 -> 2271;
	2277 [label="Саме так. Мені дуже прикро.",shape=box,color=red];
		2277 -> 2279;
	2278 [label="Aucun. Я прийняла себе якою є. І я триматимуся.",shape=box,color=blue];
		2278 -> 2280;
	2279 [label="Та non. Це мені дуже шкода, і я співчуваю твоїй подібній agonie. ",shape=box,color=blue];
		2279 -> 2271;
	2280 [label="Check boolean DrifterChronicPain",color=orange];
		2280 -> 2281 [label=true,color=green];
		2280 -> 2282 [label=false,color=brown];
	2281 [label="І ти теж. Так, ти теж. Я вірую в це.",shape=box,color=blue];
		2281 -> 2282;
	2282 [label="+20 Chemistry",color=orange];
		2282 -> 2283;
	2283 [label="Не доберу слів, як багато ця сповідь значить для мене. Тож скажу лише… Merci, мандрівниче.",shape=box,color=blue];
		2283 -> 2284;
	2284 [label="Et encore merci.",shape=box,color=blue];
		2284 -> 2285;
	2285 [label="Chat ends.",color=orange];
}