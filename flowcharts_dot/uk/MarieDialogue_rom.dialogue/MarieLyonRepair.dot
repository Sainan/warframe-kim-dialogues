		3876 -> 3879;
	3877 [label="Мені шкода, що мої слова засмутили тебе. Прошу, не перенось це на Лойда. Чи родину нагорі.",shape=box,color=red];
		3877 -> 3880;
	3878 [label="Я скажу лише, що не варто користуватися добротою Ліона, щоби прикрити власні невдачі.",shape=box,color=blue];
		3878 -> 3881;
