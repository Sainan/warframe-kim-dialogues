	j3548608603 [label="Я дуже хочу, щоб ти допомогла нам, Марі. ",shape=box,color=red];
		j3548608603 -> j515230827;
	j1295858158 [label="Марі, ти потрібна нам. Нічого не буде без тебе. Прошу. Ти можеш пробачити мені?",shape=box,color=red];
		j1295858158 -> j1893613539;
	j1960402241 [label="Мені шкода, що мої слова засмутили тебе. Прошу, не перенось це на Лойда. Чи родину нагорі.",shape=box,color=red];
		j1960402241 -> j2393023434;
	j515230827 [label="Я скажу лише, що не варто користуватися добротою Ліона, щоби прикрити власні невдачі.",shape=box,color=blue];
		j515230827 -> "Chat ends.";
	j1893613539 [label="Oui… можу. Так чи інак, але мій гнів на тебе не повинен розповсюджуватися на інших.",shape=box,color=blue];
		j1893613539 -> j2194201548;
	j2393023434 [label="Oui. Це правдиві слова. Мій гнів на тебе не повинен розповсюджуватися на інших.",shape=box,color=blue];
		j2393023434 -> j1410402951;
	j2194201548 [label="Тож я скажу — так, згода. Я допоможу тобі. Tu auras mon aide.",shape=box,color=blue];
		j2194201548 -> j3151953893;
	j1410402951 [label="Гнів, про який я шкодую. І за який я пробачу тобі.",shape=box,color=blue];
