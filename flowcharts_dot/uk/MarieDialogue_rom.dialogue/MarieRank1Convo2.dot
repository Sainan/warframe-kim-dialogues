		"MarieRank1Convo2 begins." -> j1478915251;
	j1222625046 [label="Марі? Невже мені вдалося чимось розлютити Ліона?",shape=box,color=red];
		j1222625046 -> j3101118238;
	j1478915251 [label="[Завершити розмову]",shape=box,color=red];
		j1478915251 -> "Chat ends.";
	j3101118238 [label="Hum ? Pourquoi ? О… бо він ще не розмовляв із тобою за допомогою цього ґаджета ?",shape=box,color=blue];
		j3101118238 -> j2882092885;
		j3101118238 -> j1961366764;
		j3101118238 -> j3632356302;
	"Chat ends." [color=orange];
	j2882092885 [label="Він не вміє друкувати?",shape=box,color=red];
		j2882092885 -> j1144140443;
	j1961366764 [label="Він техноненависник?",shape=box,color=red];
		j1961366764 -> j1682964456;
	j3632356302 [label="Ага. Мені подумалося, що раз ти й Роут обоє тут…",shape=box,color=red];
		j3632356302 -> j636816162;
	j1144140443 [label="Ха ! Мандрівниче, він один із найшвидших учнів, яких я бачила! Я б на твоєму місці остерігалася кидати йому виклик у будь-яких головоломках, де грають на гроші.",shape=box,color=blue];
		j1144140443 -> j636816162;
	j1682964456 [label="Non, він дуже вправний із новими предметами. Я б і на мить не засумнівалася, якби він вивчив machines ambulantes по тому тупотінню в лігвах унизу й невдовзі розробив власні плани.",shape=box,color=blue];
		j1682964456 -> j636816162;
	j636816162 [label="Усе просто — він тебе не знає. Ліон не дуже… соціалізований. Навіть у ліпші часи. Це не значить, що він хотів образити тебе.",shape=box,color=blue];
		j636816162 -> j3186071780;
		j636816162 -> j863030126;
	j3186071780 [label="А ти можеш якось посприяти?",shape=box,color=red];
		j3186071780 -> j1472300011;
	j863030126 [label="Дуже добре, що проблема не в мені…",shape=box,color=red];
		j863030126 -> j227948933;
	j1472300011 [label="У Ліона… дуже багато голосів у голові. Він дуже обережно добирає з ким ними ділитися.",shape=box,color=blue];
		j1472300011 -> j634630571;
	j227948933 [label="+5 Chemistry",color=orange];
		j227948933 -> j1892131495;
	j634630571 [label="+15 Chemistry",color=orange];
		j634630571 -> j1313479846;
	j1892131495 [label="Non, non, non, не в тобі проблема. У Ліона… дуже багато голосів у голові. Він дуже обережно добирає з ким ними ділитися.",shape=box,color=blue];
		j1892131495 -> j634630571;
	j1313479846 [label="Потрібен час. І терплячість.",shape=box,color=blue];
		j1313479846 -> j3595581344;
	j3595581344 [label="Ой ! Я маю йти. Поговоримо згодом ще.",shape=box,color=blue];
		j3595581344 -> "Chat ends.";
}