digraph {
	57 [label="MarieRank1Convo2 begins.",color=orange];
		57 -> 59;
		57 -> 58;
	59 [label="Марі? Невже мені вдалося чимось розлютити Ліона?",shape=box,color=red];
		59 -> 61;
	58 [label="[Завершити розмову]",shape=box,color=red];
		58 -> 60;
	61 [label="Hum ? Pourquoi ? О… бо він ще не розмовляв із тобою за допомогою цього ґаджета ?",shape=box,color=blue];
		61 -> 62;
		61 -> 63;
		61 -> 64;
	60 [label="Chat ends.",color=orange];
	62 [label="Він не вміє друкувати?",shape=box,color=red];
		62 -> 65;
	63 [label="Він техноненависник?",shape=box,color=red];
		63 -> 66;
	64 [label="Ага. Мені подумалося, що раз ти й Роут обоє тут…",shape=box,color=red];
		64 -> 67;
	65 [label="Ха ! Мандрівниче, він один із найшвидших учнів, яких я бачила! Я б на твоєму місці остерігалася кидати йому виклик у будь-яких головоломках, де грають на гроші.",shape=box,color=blue];
		65 -> 67;
	66 [label="Non, він дуже вправний із новими предметами. Я б і на мить не засумнівалася, якби він вивчив machines ambulantes по тому тупотінню в лігвах унизу й невдовзі розробив власні плани.",shape=box,color=blue];
		66 -> 67;
	67 [label="Усе просто — він тебе не знає. Ліон не дуже… соціалізований. Навіть у ліпші часи. Це не значить, що він хотів образити тебе.",shape=box,color=blue];
		67 -> 68;
		67 -> 69;
	68 [label="А ти можеш якось посприяти?",shape=box,color=red];
		68 -> 70;
	69 [label="Дуже добре, що проблема не в мені…",shape=box,color=red];
		69 -> 71;
	70 [label="У Ліона… дуже багато голосів у голові. Він дуже обережно добирає з ким ними ділитися.",shape=box,color=blue];
		70 -> 72;
	71 [label="+5 Chemistry",color=orange];
		71 -> 73;
	72 [label="+15 Chemistry",color=orange];
		72 -> 74;
	73 [label="Non, non, non, не в тобі проблема. У Ліона… дуже багато голосів у голові. Він дуже обережно добирає з ким ними ділитися.",shape=box,color=blue];
		73 -> 72;
	74 [label="Потрібен час. І терплячість.",shape=box,color=blue];
		74 -> 75;
	75 [label="Ой ! Я маю йти. Поговоримо згодом ще.",shape=box,color=blue];
		75 -> 76;
	76 [label="Chat ends.",color=orange];
}