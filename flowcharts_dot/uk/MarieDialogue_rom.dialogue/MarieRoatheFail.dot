		j660529577 -> j485109172;
	j218795382 [label="Я намагаюся переконати Роута допомогти нам возз’єднати Лойда і родину Ентраті. Але його непокоїть прийнята сироватка. Мені потрібна твоя допомога в розмові з ним.",shape=box,color=red];
		j218795382 -> j3145037131;
	j3950777163 [label="Я намагаюся змусити Роута усвідомити, що він має в собі силу змінитися. Він може пробачити собі скоєне в минулому. І мені не завадить твоя допомога.",shape=box,color=red];
		j3950777163 -> j4120393404;
	j443800615 [label="Роут їсть себе поїдом за скоєне в минулому. Я переживаю, що без твоєї допомоги він повністю знищить себе, якщо не зможе усвідомити ким є.",shape=box,color=red];
		j443800615 -> j2629492564;
	j1109315119 [label="Роут дізнався правду про сироватку. Що він добровільно прийняв її. І це його добиває. Мені потрібна ти, щоб заспокоїти його.",shape=box,color=red];
		j1109315119 -> j3145037131;
	j485109172 [label="Роут до сказу мене доводить. Не знаю як уже говорити з ним. Маєш поради?",shape=box,color=red];
		j485109172 -> j3145037131;
	j3145037131 [label="Non. Якби я вміла розмовляти з тим дияволом, то думаєш не верещала б на нього увесь час Gaullique ?",shape=box,color=blue];
		j3145037131 -> j2078693290;
	j4120393404 [label="Add 10 to Thermostat counter",color=orange];
		j4120393404 -> j3509273273;
	j2629492564 [label="Add -10 to Thermostat counter",color=orange];
		j2629492564 -> j3509273273;
	j2078693290 [label="Pardonne-moi, гадаю, тобі доведеться розбиратися самостійно…",shape=box,color=blue];
		j2078693290 -> "Chat ends.";
	j3509273273 [label="Зроблю все можливе. Я спробую заради тебе.",shape=box,color=blue];
