	3752 [label="Я намагаюся змусити Роута усвідомити, що він має в собі силу змінитися. Він може пробачити собі скоєне в минулому. І мені не завадить твоя допомога.",shape=box,color=red];
		3752 -> 3757;
	3753 [label="Роут їсть себе поїдом за скоєне в минулому. Я переживаю, що без твоєї допомоги він повністю знищить себе, якщо не зможе усвідомити ким є.",shape=box,color=red];
		3753 -> 3758;
