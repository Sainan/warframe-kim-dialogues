	1583 [label="+5 Chemistry",color=orange];
		1583 -> 1592;
	1584 [label="Ой, ти не подумай, що я від тебе прагну жорстокості ! Non ! Цінуй їх, бо вони дорогоцінні. Не їхня провина в тому, що вони стали тими, ким є !",shape=box,color=blue];
		1584 -> 1593;
	1585 [label="+5 Chemistry",color=orange];
		1585 -> 1584;
	1586 [label="+5 Chemistry",color=orange];
		1586 -> 1594;
	1587 [label="+5 Chemistry",color=orange];
		1587 -> 1595;
	1579 [label="Не всіх робили цефалонами в покарання. Але на Деймосі все пішло… м'яко кажучи, шкереберть. Його сильно пошкодило.",shape=box,color=red];
		1579 -> 1588;
	1589 [label="Update boolean MarieCephalonSoul",color=orange];
		1589 -> 1597;
	1590 [label="Update boolean MarieCephalonNoSoul",color=orange];
		1590 -> 1598;
	1591 [label="Update boolean MarieCephalonUnsure",color=orange];
		1591 -> 1599;
	1592 [label="Ще більше доказів того, що диявола та йому подібних засуджують по праву. Але може бути й твоя правда стосовно Отака та інших. Або просто тобі спокійніше від такої думки.",shape=box,color=blue];
		1592 -> 1593;
	1593 [label="Знаєш, я ж можу і помилятися. Та вияви доброти й поваги ще ніколи нікого не кривдили.",shape=box,color=blue];
		1593 -> 1600;
	1594 [label="Може й твоя правда, але не думаю, що орокінські дияволи знали більше про поняття душі, аніж ми. Вони не були ліпшими за богів.",shape=box,color=blue];
		1594 -> 1593;
	1595 [label="Може й так, а може тобі просто спокійніше від такої думки.",shape=box,color=blue];
		1595 -> 1593;
	1588 [label="Pauvre petit…",shape=box,color=blue];
		1588 -> 1596;
	1597 [label="+5 Chemistry",color=orange];
		1597 -> 1603;
	1598 [label="+5 Chemistry",color=orange];
		1598 -> 1604;
	1599 [label="+5 Chemistry",color=orange];
		1599 -> 1605;
	1600 [label="Я все одно доплету вінок із квітів для монсеньйора Некралойда. Він буде метушитися й ніяковіти, але не скаже мені non !",shape=box,color=blue];
		1600 -> 1606;
		1600 -> 1607;
		1600 -> 1608;
	1596 [label="Update boolean MarieOtak1",color=orange];
		1596 -> 2945;
	1603 [label="Oui, це дуже мудро. Я просто собі думки вголос наводжу і перепитую тебе, що до чого. Беззаперечна правда, що доброта й повага не кривдять.",shape=box,color=blue];
		1603 -> 1610;
	1604 [label="Скоріше за все саме так. І, знаєш, сподіваюся що так і є ! Як би не було, маємо бути добрими до всіх розумних створінь. Що може думати, те може відчувати.",shape=box,color=blue];
		1604 -> 1610;
	1605 [label="Як би не було, маємо бути добрими до всіх розумних створінь. Що може думати, те може відчувати.",shape=box,color=blue];
		1605 -> 1593;
	1606 [label="Це дуже мило.",shape=box,color=red];
		1606 -> 1611;
	1607 [label="Вінок із квітів?",shape=box,color=red];
		1607 -> 1612;
	1608 [label="Розважайся.",shape=box,color=red];
		1608 -> 1613;
	2945 [label="Check boolean LoidFamilyComplete",color=orange];
		2945 -> 1601 [label=true,color=green];
		2945 -> 1602 [label=false,color=brown];
		2945 -> 1601 [label=false,color=brown];
	1610 [label="Знаєш, ми ж можемо й помилятися. Та вияви доброти й поваги ще ніколи нікого не кривдили. ",shape=box,color=blue];
		1610 -> 1600;
	1611 [label="+5 Chemistry",color=orange];
		1611 -> 1614;
	1612 [label="+10 Chemistry",color=orange];
		1612 -> 1615;
	1613 [label="+5 Chemistry",color=orange];
		1613 -> 1616;
	1601 [label="Як до цього дійшло?",shape=box,color=red];
		1601 -> 1934;
	1602 [label="Сподіваюся, котрогось дня ти з ним познайомишся.",shape=box,color=red];
		1602 -> 1609;
	1614 [label="Merci ! À la revoyure !",shape=box,color=blue];
		1614 -> 1617;
	1615 [label="О! Це ж один з обрядів Луа. На річницю відходу душі плетуть вінок чи корону з квітів і розташовують на могилі чи черепі померлих. ",shape=box,color=blue];
		1615 -> 1618;
	1616 [label="Merci, так і буде! À la revoyure !",shape=box,color=blue];
		1616 -> 1617;
	1609 [label="Oui, але не його мовчання мене непокоїть. Я спитала монсеньора Некралойда, чи той череп-прикраса так чи інак належав колись живій душі, чи ні ?",shape=box,color=blue];
		1609 -> 1936;
	1617 [label="Chat ends.",color=orange];
	1618 [label="Зазвичай же ж тіла у криптах відкриті, non ? Тож це можна зробити. Думаю, що ця традиція й досі якоюсь мірою могла зберегтися.",shape=box,color=blue];
		1618 -> 1619;
	1619 [label="Я бачу її прояви в мистецтві орокінів — вони аж надто полюбляють черепи. ",shape=box,color=blue];
		1619 -> 1620;
		1619 -> 1621;
		1619 -> 1622;
	1620 [label="Це чимало чого пояснює.",shape=box,color=red];
		1620 -> 1623;
	1621 [label="Нове — давно забуте старе, так?",shape=box,color=red];
		1621 -> 1623;
	1622 [label="Якщо не помиляюся, то Донька якось намагалася це зробити. Ото буде ревнувати.",shape=box,color=red];
		1622 -> 1624;
	1623 [label="Oui ! Стільки часу пройшло, але досі лишається вплив. Я радію, що хоча б навіть крихітні часточки лишилися.",shape=box,color=blue];
		1623 -> 1625;
	1624 [label="Oui ? Тоді я з нетерпінням чекатиму дня, коли познайомлюся з нею ! Скажу, що загнала його в кут.",shape=box,color=blue];
		1624 -> 1625;
	1625 [label="Faux череп чи non, але монсеньйор Некралойд буде з вінком. О, він так сором’язливо знічується, коли я вихваляю його ! Гадаю, що точно зашарівся б, якби міг. І від цього усмішка сама стрибає на мої вуста.",shape=box,color=blue];
		1625 -> 1626;
	1626 [label="À la revoyure !",shape=box,color=blue];
		1626 -> 1627;
	1627 [label="Chat ends.",color=orange];
}