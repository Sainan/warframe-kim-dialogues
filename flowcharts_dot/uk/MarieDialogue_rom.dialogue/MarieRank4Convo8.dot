		j18150053 -> j1590638197;
	j1338410761 [label="Boolean MarieCephalonNoSoul is now true.",color=orange];
		j1338410761 -> j413859315;
	j2951836927 [label="Boolean MarieCephalonNoSoul is now true.",color=orange];
		j2951836927 -> j932165040;
	j3062151803 [label="Boolean MarieCephalonUnsure is now true.",color=orange];
		j3062151803 -> j3900783896;
	j3989915199 [label="Boolean MarieCephalonSoul is now true.",color=orange];
		j3989915199 -> j4008555035;
	j3625608027 [label="З якихось причин, невідомих мені, його перетворили на цефалона й дали власну оболонку некралойда.",shape=box,color=red];
		j3625608027 -> j2638560779;
	j2130058116 [label="Boolean MarieCephalonNoSoul is now false.",color=orange];
		j2130058116 -> j3043019501;
	j623252074 [label="Boolean MarieCephalonUnsure is now false.",color=orange];
		j623252074 -> j3295162219;
	j1297010671 [label="Boolean MarieCephalonSoul is now false.",color=orange];
		j1297010671 -> j1747939526;
	j1590638197 [label="+5 Chemistry",color=orange];
		j1590638197 -> j1661935325;
	j413859315 [label="Ой, ти не подумай, що я від тебе прагну жорстокості ! Non ! Цінуй їх, бо вони дорогоцінні. Не їхня провина в тому, що вони стали тими, ким є !",shape=box,color=blue];
		j413859315 -> j1112979891;
	j932165040 [label="+5 Chemistry",color=orange];
		j932165040 -> j413859315;
	j3900783896 [label="+5 Chemistry",color=orange];
		j3900783896 -> j1033343549;
	j4008555035 [label="+5 Chemistry",color=orange];
		j4008555035 -> j1466820221;
	j2638560779 [label="Не всіх робили цефалонами в покарання. Але на Деймосі все пішло… м'яко кажучи, шкереберть. Його сильно пошкодило.",shape=box,color=red];
		j2638560779 -> j1183291755;
	j3043019501 [label="Boolean MarieCephalonSoul is now false.",color=orange];
		j3043019501 -> j2126493668;
	j3295162219 [label="Boolean MarieCephalonNoSoul is now false.",color=orange];
		j3295162219 -> j2967115355;
	j1747939526 [label="Boolean MarieCephalonUnsure is now false.",color=orange];
		j1747939526 -> j3039514429;
	j1661935325 [label="Ще більше доказів того, що диявола та йому подібних засуджують по праву. Але може бути й твоя правда стосовно Отака та інших. Або просто тобі спокійніше від такої думки.",shape=box,color=blue];
		j1661935325 -> j1112979891;
	j1112979891 [label="Знаєш, я ж можу і помилятися. Та вияви доброти й поваги ще ніколи нікого не кривдили.",shape=box,color=blue];
		j1112979891 -> j2029908810;
	j1033343549 [label="Може й твоя правда, але не думаю, що орокінські дияволи знали більше про поняття душі, аніж ми. Вони не були ліпшими за богів.",shape=box,color=blue];
		j1033343549 -> j1112979891;
	j1466820221 [label="Може й так, а може тобі просто спокійніше від такої думки.",shape=box,color=blue];
		j1466820221 -> j1112979891;
	j1183291755 [label="Pauvre petit…",shape=box,color=blue];
		j1183291755 -> j3134774711;
	j2126493668 [label="+5 Chemistry",color=orange];
		j2126493668 -> j1265375534;
	j2967115355 [label="+5 Chemistry",color=orange];
		j2967115355 -> j1213095586;
	j3039514429 [label="+5 Chemistry",color=orange];
		j3039514429 -> j2621497053;
	j2029908810 [label="Я все одно доплету вінок із квітів для монсеньйора Некралойда. Він буде метушитися й ніяковіти, але не скаже мені non !",shape=box,color=blue];
		j2029908810 -> j3449168450;
		j2029908810 -> j15086515;
		j2029908810 -> j3031149433;
	j3134774711 [label="Boolean MarieOtak1 is now true.",color=orange];
		j3134774711 -> j3951815689;
	j1265375534 [label="Oui, це дуже мудро. Я просто собі думки вголос наводжу і перепитую тебе, що до чого. Беззаперечна правда, що доброта й повага не кривдять.",shape=box,color=blue];
		j1265375534 -> j2374872203;
	j1213095586 [label="Скоріше за все саме так. І, знаєш, сподіваюся що так і є ! Як би не було, маємо бути добрими до всіх розумних створінь. Що може думати, те може відчувати.",shape=box,color=blue];
		j1213095586 -> j2374872203;
	j2621497053 [label="Як би не було, маємо бути добрими до всіх розумних створінь. Що може думати, те може відчувати.",shape=box,color=blue];
		j2621497053 -> j1112979891;
	j3449168450 [label="Це дуже мило.",shape=box,color=red];
		j3449168450 -> j366938164;
	j15086515 [label="Вінок із квітів?",shape=box,color=red];
		j15086515 -> j704046210;
	j3031149433 [label="Розважайся.",shape=box,color=red];
		j3031149433 -> j3157602314;
	j3951815689 [label="Check boolean LoidFamilyComplete",color=orange];
		j3951815689 -> j2950115276 [label=true,color=green];
		j3951815689 -> j1086349259 [label=false,color=brown];
		j3951815689 -> j2950115276 [label=false,color=brown];
	j2374872203 [label="Знаєш, ми ж можемо й помилятися. Та вияви доброти й поваги ще ніколи нікого не кривдили. ",shape=box,color=blue];
		j2374872203 -> j2029908810;
	j366938164 [label="+5 Chemistry",color=orange];
		j366938164 -> j2511082154;
	j704046210 [label="+10 Chemistry",color=orange];
		j704046210 -> j1418593809;
	j3157602314 [label="+5 Chemistry",color=orange];
		j3157602314 -> j3152603093;
	j2950115276 [label="Як до цього дійшло?",shape=box,color=red];
		j2950115276 -> j1408152578;
	j1086349259 [label="Сподіваюся, котрогось дня ти з ним познайомишся.",shape=box,color=red];
		j1086349259 -> j2935738182;
	j2511082154 [label="Merci ! À la revoyure !",shape=box,color=blue];
		j2511082154 -> "Chat ends.";
	j1418593809 [label="О! Це ж один з обрядів Луа. На річницю відходу душі плетуть вінок чи корону з квітів і розташовують на могилі чи черепі померлих. ",shape=box,color=blue];
		j1418593809 -> j3885543461;
	j3152603093 [label="Merci, так і буде! À la revoyure !",shape=box,color=blue];
		j3152603093 -> "Chat ends.";
	j2935738182 [label="Oui, але не його мовчання мене непокоїть. Я спитала монсеньора Некралойда, чи той череп-прикраса так чи інак належав колись живій душі, чи ні ?",shape=box,color=blue];
		j2935738182 -> j3624779489;
	j3885543461 [label="Зазвичай же ж тіла у криптах відкриті, non ? Тож це можна зробити. Думаю, що ця традиція й досі якоюсь мірою могла зберегтися.",shape=box,color=blue];
		j3885543461 -> j1494492669;
	j1494492669 [label="Я бачу її прояви в мистецтві орокінів — вони аж надто полюбляють черепи. ",shape=box,color=blue];
		j1494492669 -> j4219304727;
		j1494492669 -> j3128859813;
		j1494492669 -> j2949872620;
	j4219304727 [label="Це чимало чого пояснює.",shape=box,color=red];
		j4219304727 -> j1792217160;
	j3128859813 [label="Нове — давно забуте старе, так?",shape=box,color=red];
		j3128859813 -> j1792217160;
	j2949872620 [label="Якщо не помиляюся, то Донька якось намагалася це зробити. Ото буде ревнувати.",shape=box,color=red];
		j2949872620 -> j1766338731;
	j1792217160 [label="Oui ! Стільки часу пройшло, але досі лишається вплив. Я радію, що хоча б навіть крихітні часточки лишилися.",shape=box,color=blue];
		j1792217160 -> j850829668;
	j1766338731 [label="Oui ? Тоді я з нетерпінням чекатиму дня, коли познайомлюся з нею ! Скажу, що загнала його в кут.",shape=box,color=blue];
		j1766338731 -> j850829668;
	j850829668 [label="Faux череп чи non, але монсеньйор Некралойд буде з вінком. О, він так сором’язливо знічується, коли я вихваляю його ! Гадаю, що точно зашарівся б, якби міг. І від цього усмішка сама стрибає на мої вуста.",shape=box,color=blue];
		j850829668 -> j4101990552;
	j4101990552 [label="À la revoyure !",shape=box,color=blue];
		j4101990552 -> "Chat ends.";
}