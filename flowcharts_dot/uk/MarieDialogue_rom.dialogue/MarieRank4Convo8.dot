digraph {
	"MarieRank4Convo8 begins." [color=orange];
		"MarieRank4Convo8 begins." -> j2786051379;
	j2786051379 [label="Check boolean MarieOtak1",color=orange];
		j2786051379 -> j1408038863 [label=true,color=green];
		j2786051379 -> j2132393134 [label=false,color=brown];
	j1408038863 [label="Мандрівниче, що більше я дізнаюся про монсеньйора Некралойда і монсеньйора Отака, то більше це мене непокоїть…",shape=box,color=blue];
		j1408038863 -> j3954360872;
		j1408038863 -> j1397254781;
	j2132393134 [label="Мандрівниче, я можу поговорити з тобою ?",shape=box,color=blue];
		j2132393134 -> j591248209;
		j2132393134 -> j1478915251;
	j3954360872 [label="Як так?",shape=box,color=red];
		j3954360872 -> j1408152578;
	j1397254781 [label="У чому саме проблема?",shape=box,color=red];
		j1397254781 -> j1408152578;
	j591248209 [label="Звісно. У чому справа?",shape=box,color=red];
		j591248209 -> j1440180007;
	j1478915251 [label="[Завершити розмову]",shape=box,color=red];
		j1478915251 -> "Chat ends.";
	j1408152578 [label="Я спитала монсеньора Некралойда, чи той череп-прикраса так чи інак належав колись живій душі, чи ні ?",shape=box,color=blue];
		j1408152578 -> j3624779489;
	j1440180007 [label="Мені стало цікаво, чого на спині є ще одне обличчя, яке нагадує дитячі каракулі.",shape=box,color=blue];
		j1440180007 -> j3892100836;
	"Chat ends." [color=orange];
	j3624779489 [label="І монсеньйор Некралойд сказав, що то був «його» череп, хоча й визнав, що «оригіналом» був монсеньйор Лойд. Монсеньйор Лойд, своєю чергою, втрутився і сказав, що це «репліка» його власного черепа.",shape=box,color=blue];
		j3624779489 -> j4261958612;
	j3892100836 [label="Я спитала монсеньйора Некралойда і монсеньйора Лойда. Ніхто з них не захотів про це говорити, лише назвали одне ім’я. Отак. І вони вимовляли його з великим сумом у голосі.",shape=box,color=blue];
		j3892100836 -> j3910130375;
	j4261958612 [label="Як таке може бути ? І що таке «репліка» ? Це справжній череп ou bien c'est un faux ? Чому у монсенйьора Некралойда та монсеньора Лойда відрізняються відповіді ?",shape=box,color=blue];
		j4261958612 -> j2599295418;
		j4261958612 -> j2959778242;
		j4261958612 -> j908053369;
	j3910130375 [label="Тож ось я сподіваюся, що ти зможеш мені допомогти.",shape=box,color=blue];
		j3910130375 -> j2227706451;
	j2599295418 [label="Припускаю, з точки зору некралойда — то його череп. Це так. Але зі сторони Лойда — це репліка.",shape=box,color=red];
		j2599295418 -> j2635760368;
	j2959778242 [label="Я чесно гадки не маю з чого він зроблений. Може то кістка. Чи якісь полімери…",shape=box,color=red];
		j2959778242 -> j1708186465;
	j908053369 [label="Я думаю, що глибинна суть питання в тому, чи «некралойд справжній», а не в тому, чи «череп справжній».",shape=box,color=red];
		j908053369 -> j1714459763;
	j2227706451 [label="Ти розповіси мені історію бідолашного монсеньйора Отака ?",shape=box,color=blue];
		j2227706451 -> j1511329798;
	j2635760368 [label="Гадаю, саме це й непокоїть мене. Те, як ці два мсьє сприймають його походження. Один вважає його sacrosancte, а інший — copie.",shape=box,color=blue];
		j2635760368 -> j3408858168;
	j1708186465 [label="Не знаю, чи саме матеріал черепа мене так непокоїть. Радше його походження. Чи може те, як ці два мсьє сприймають його походження. Один вважає його sacro-saint, а інший — copie.",shape=box,color=blue];
		j1708186465 -> j3408858168;
	j1714459763 [label="+5 Chemistry",color=orange];
		j1714459763 -> j788081106;
	j1511329798 [label="Отак колись був архімедівцем, орокінським ученим і академіком. А подальша історія не з тих, що зі щасливим завершенням.",shape=box,color=red];
		j1511329798 -> j1751877917;
	j3408858168 [label="Evaluate expressions",color=orange];
		j3408858168 -> j3927049554 [label="MarieCephalonSoul",color=purple];
		j3408858168 -> j1556384979 [label="MarieCephalonNoSoul",color=purple];
		j3408858168 -> j4203561753 [label="MarieCephalonUnsure",color=purple];
		j3408858168 -> j4128261422 [label="false",color=purple];
	j788081106 [label="Oui ! Саме так, ось де собака — чи то пак череп ХА-ХА ! — зарита. Один уважає його sacro-saint, а інший — copie.",shape=box,color=blue];
		j788081106 -> j3408858168;
	j1751877917 [label="З усіх подій стає зрозумілим, що він був генієм і тим, хто опанував використання кристалів аргону.",shape=box,color=red];
		j1751877917 -> j1181649111;
	j3927049554 [label="Як у монсеньйора Некралойда може бути душа, якщо в нього немає навіть власних кісток ?",shape=box,color=blue];
		j3927049554 -> j3028457386;
		j3927049554 -> j1671648731;
		j3927049554 -> j3904415900;
	j1556384979 [label="Чи це не додатковий доказ того, що в монсеньйора Некралойда нема душі ?",shape=box,color=blue];
		j1556384979 -> j3028457386;
		j1556384979 -> j1671648731;
		j1556384979 -> j3904415900;
	j4203561753 [label="Я знаю про твою невпевненість у наявності душі в монсеньйора Некралойда. Але ж як він може її мати, якщо навіть власних кісток не має ?",shape=box,color=blue];
		j4203561753 -> j3028457386;
		j4203561753 -> j1671648731;
		j4203561753 -> j3904415900;
	j4128261422 [label="Я маю на увазі дуже складу технологію, створену для відтворення людини, так ? Phonographe, але набагато складніший.",shape=box,color=blue];
		j4128261422 -> j586831714;
		j4128261422 -> j1165322699;
		j4128261422 -> j2397860583;
		j4128261422 -> j1829211478;
		j4128261422 -> j2453992492;
	j1181649111 [label="А вони походять із Порожнечі. І саме завдяки їм ми можемо створювати чимало ворфреймів та потужну зброю.",shape=box,color=red];
		j1181649111 -> j4237604805;
	j3028457386 [label="Може й так. Може вони справді лише копії людей. Але я не маю в цьому впевненості. І все одно маємо ставитися до них як до людей.",shape=box,color=red];
		j3028457386 -> j228825144;
	j1671648731 [label="Думаю, некралойд — виняток, а не правило. Його зробили як копію особи, а не безпосередньо з особи.",shape=box,color=red];
		j1671648731 -> j1705404791;
	j3904415900 [label="Твоя правда. Можливо, так ліпше й гуманніше, якщо вони не душі, які насправді потрапили в пастку складних наукових пристроїв…",shape=box,color=red];
		j3904415900 -> j2351784385;
	j586831714 [label="Некралойд може й не має душі, але він неповторний. Інші ж цефалони, як Отак, її мали. Для їхнього створення її нищили.",shape=box,color=red];
		j586831714 -> j18150053;
	j1165322699 [label="Так, твоя правда. То що мені, по-твоєму, зробити з цим?",shape=box,color=red];
		j1165322699 -> j1338410761;
	j2397860583 [label="Так, твоя правда. Душі нема. Але це не означає, що ми можемо погано до них ставитися.",shape=box,color=red];
		j2397860583 -> j2951836927;
	j1829211478 [label="Я не знаю, так це чи ні. Але вони можуть мислити й відчувати. А ми не повинні ставитися до них, як до речей.",shape=box,color=red];
		j1829211478 -> j3062151803;
	j2453992492 [label="Некралойд має душу. Вона є у всіх цефалонів.",shape=box,color=red];
		j2453992492 -> j3989915199;
	j4237604805 [label="Він спеціалізувався на криптографії. І його роботи в тутешніх архівах, у лабораторіях.",shape=box,color=red];
		j4237604805 -> j3625608027;
	j228825144 [label="Boolean MarieCephalonUnsure is now true.",color=orange];
		j228825144 -> j2130058116;
	j1705404791 [label="Boolean MarieCephalonSoul is now true.",color=orange];
		j1705404791 -> j623252074;
