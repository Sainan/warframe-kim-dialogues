		1577 -> 1586;
	1578 [label="Update boolean MarieCephalonSoul",color=orange];
		1578 -> 1587;
	1570 [label="З якихось причин, невідомих мені, його перетворили на цефалона й дали власну оболонку некралойда.",shape=box,color=red];
		1570 -> 1579;
	1580 [label="Update boolean MarieCephalonNoSoul",color=orange];
