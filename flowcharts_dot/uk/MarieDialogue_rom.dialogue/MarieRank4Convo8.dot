digraph {
	1924 [label="MarieRank4Convo8 begins.",color=orange];
		1924 -> 1925;
	1925 [label="Check boolean MarieOtak1",color=orange];
		1925 -> 1927 [label=true,color=green];
		1925 -> 1926 [label=false,color=brown];
	1927 [label="Мандрівниче, що більше я дізнаюся про монсеньйора Некралойда і монсеньйора Отака, то більше це мене непокоїть…",shape=box,color=blue];
		1927 -> 1930;
		1927 -> 1931;
	1926 [label="Мандрівниче, я можу поговорити з тобою ?",shape=box,color=blue];
		1926 -> 1928;
		1926 -> 1929;
	1930 [label="Як так?",shape=box,color=red];
		1930 -> 1934;
	1931 [label="У чому саме проблема?",shape=box,color=red];
		1931 -> 1934;
	1928 [label="Звісно. У чому справа?",shape=box,color=red];
		1928 -> 1932;
	1929 [label="[Завершити розмову]",shape=box,color=red];
		1929 -> 1933;
	1934 [label="Я спитала монсеньора Некралойда, чи той череп-прикраса так чи інак належав колись живій душі, чи ні ?",shape=box,color=blue];
		1934 -> 1936;
	1932 [label="Мені стало цікаво, чого на спині є ще одне обличчя, яке нагадує дитячі каракулі.",shape=box,color=blue];
		1932 -> 1935;
	1933 [label="Chat ends.",color=orange];
	1936 [label="І монсеньйор Некралойд сказав, що то був «його» череп, хоча й визнав, що «оригіналом» був монсеньйор Лойд. Монсеньйор Лойд, своєю чергою, втрутився і сказав, що це «репліка» його власного черепа.",shape=box,color=blue];
		1936 -> 1938;
	1935 [label="Я спитала монсеньйора Некралойда і монсеньйора Лойда. Ніхто з них не захотів про це говорити, лише назвали одне ім’я. Отак. І вони вимовляли його з великим сумом у голосі.",shape=box,color=blue];
		1935 -> 1937;
	1938 [label="Як таке може бути ? І що таке «репліка» ? Це справжній череп ou bien c'est un faux ? Чому у монсенйьора Некралойда та монсеньора Лойда відрізняються відповіді ?",shape=box,color=blue];
		1938 -> 1940;
		1938 -> 1941;
		1938 -> 1942;
	1937 [label="Тож ось я сподіваюся, що ти зможеш мені допомогти.",shape=box,color=blue];
		1937 -> 1939;
	1940 [label="Припускаю, з точки зору некралойда — то його череп. Це так. Але зі сторони Лойда — це репліка.",shape=box,color=red];
		1940 -> 1944;
	1941 [label="Я чесно гадки не маю з чого він зроблений. Може то кістка. Чи якісь полімери…",shape=box,color=red];
		1941 -> 1945;
	1942 [label="Я думаю, що глибинна суть питання в тому, чи «некралойд справжній», а не в тому, чи «череп справжній».",shape=box,color=red];
		1942 -> 1946;
	1939 [label="Ти розповіси мені історію бідолашного монсеньйора Отака ?",shape=box,color=blue];
		1939 -> 1943;
	1944 [label="Гадаю, саме це й непокоїть мене. Те, як ці два мсьє сприймають його походження. Один вважає його sacrosancte, а інший — copie.",shape=box,color=blue];
		1944 -> 1948;
	1945 [label="Не знаю, чи саме матеріал черепа мене так непокоїть. Радше його походження. Чи може те, як ці два мсьє сприймають його походження. Один вважає його sacro-saint, а інший — copie.",shape=box,color=blue];
		1945 -> 1948;
	1946 [label="+5 Chemistry",color=orange];
		1946 -> 1949;
	1943 [label="Отак колись був архімедівцем, орокінським ученим і академіком. А подальша історія не з тих, що зі щасливим завершенням.",shape=box,color=red];
		1943 -> 1947;
	1948 [label="Evaluate expressions",color=orange];
		1948 -> 1558 [label="MarieCephalonSoul",color=purple];
		1948 -> 1557 [label="MarieCephalonNoSoul",color=purple];
		1948 -> 1559 [label="MarieCephalonUnsure",color=purple];
		1948 -> 1560 [label="false",color=purple];
	1949 [label="Oui ! Саме так, ось де собака — чи то пак череп ХА-ХА ! — зарита. Один уважає його sacro-saint, а інший — copie.",shape=box,color=blue];
		1949 -> 1948;
	1947 [label="З усіх подій стає зрозумілим, що він був генієм і тим, хто опанував використання кристалів аргону.",shape=box,color=red];
		1947 -> 1556;
	1558 [label="Як у монсеньйора Некралойда може бути душа, якщо в нього немає навіть власних кісток ?",shape=box,color=blue];
		1558 -> 1562;
		1558 -> 1563;
		1558 -> 1564;
	1557 [label="Чи це не додатковий доказ того, що в монсеньйора Некралойда нема душі ?",shape=box,color=blue];
		1557 -> 1562;
		1557 -> 1563;
		1557 -> 1564;
	1559 [label="Я знаю про твою невпевненість у наявності душі в монсеньйора Некралойда. Але ж як він може її мати, якщо навіть власних кісток не має ?",shape=box,color=blue];
		1559 -> 1562;
		1559 -> 1563;
		1559 -> 1564;
	1560 [label="Я маю на увазі дуже складу технологію, створену для відтворення людини, так ? Phonographe, але набагато складніший.",shape=box,color=blue];
		1560 -> 1565;
		1560 -> 1566;
		1560 -> 1567;
		1560 -> 1568;
		1560 -> 1569;
	1556 [label="А вони походять із Порожнечі. І саме завдяки їм ми можемо створювати чимало ворфреймів та потужну зброю.",shape=box,color=red];
		1556 -> 1561;
	1562 [label="Може й так. Може вони справді лише копії людей. Але я не маю в цьому впевненості. І все одно маємо ставитися до них як до людей.",shape=box,color=red];
		1562 -> 1571;
	1563 [label="Думаю, некралойд — виняток, а не правило. Його зробили як копію особи, а не безпосередньо з особи.",shape=box,color=red];
		1563 -> 1572;
	1564 [label="Твоя правда. Можливо, так ліпше й гуманніше, якщо вони не душі, які насправді потрапили в пастку складних наукових пристроїв…",shape=box,color=red];
		1564 -> 1573;
	1565 [label="Некралойд може й не має душі, але він неповторний. Інші ж цефалони, як Отак, її мали. Для їхнього створення її нищили.",shape=box,color=red];
		1565 -> 1574;
	1566 [label="Так, твоя правда. То що мені, по-твоєму, зробити з цим?",shape=box,color=red];
		1566 -> 1575;
	1567 [label="Так, твоя правда. Душі нема. Але це не означає, що ми можемо погано до них ставитися.",shape=box,color=red];
		1567 -> 1576;
	1568 [label="Я не знаю, так це чи ні. Але вони можуть мислити й відчувати. А ми не повинні ставитися до них, як до речей.",shape=box,color=red];
		1568 -> 1577;
	1569 [label="Некралойд має душу. Вона є у всіх цефалонів.",shape=box,color=red];
		1569 -> 1578;
	1561 [label="Він спеціалізувався на криптографії. І його роботи в тутешніх архівах, у лабораторіях.",shape=box,color=red];
		1561 -> 1570;
	1571 [label="Update boolean MarieCephalonUnsure",color=orange];
		1571 -> 1580;
	1572 [label="Update boolean MarieCephalonSoul",color=orange];
		1572 -> 1581;
	1573 [label="Update boolean MarieCephalonNoSoul",color=orange];
