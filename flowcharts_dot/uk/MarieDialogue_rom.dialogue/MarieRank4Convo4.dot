digraph {
	2286 [label="MarieRank4Convo4 begins.",color=orange];
		2286 -> 2287;
	2287 [label="Check boolean MarieTagferFight1",color=orange];
		2287 -> 2288 [label=true,color=green];
		2287 -> 2290 [label=true,color=green];
		2287 -> 2291 [label=true,color=green];
		2287 -> 2289 [label=false,color=brown];
	2288 [label="Марі? Ми можемо поговорити?",shape=box,color=red];
		2288 -> 2292;
	2290 [label="Роут розповів про… сварку з Таґфером. Ми можемо це обговорити?",shape=box,color=red];
		2290 -> 2293;
	2291 [label="[Завершити розмову]",shape=box,color=red];
		2291 -> 2294;
	2289 [label="Chat ends.",color=orange];
	2292 [label="Oui, хоча мені здається, я знаю, про що йтиметься… я повелася погано. Хто тобі сказав ?",shape=box,color=blue];
		2292 -> 2295;
		2292 -> 2296;
		2292 -> 2297;
	2293 [label="Bien sûr, ce salaud de diable ouvre sa bouche et vous raconte tout ! Il ne cherche qu'à m'embarrasser !",shape=box,color=blue];
		2293 -> 2298;
	2294 [label="Chat ends.",color=orange];
	2295 [label="Це не суттєво.",shape=box,color=red];
		2295 -> 2299;
	2296 [label="Лойд.",shape=box,color=red];
		2296 -> 2300;
	2297 [label="Роут.",shape=box,color=red];
		2297 -> 2293;
	2298 [label="Si je le pouvais, je prendrais ce couteau qu'il aime tant utiliser pour agacer les autres et je le fourrerais là où seule Lua peut le voir !",shape=box,color=blue];
		2298 -> 2301;
	2299 [label="Суттєво, але ти, певно, не бажаєш псувати мені настрій. Тож… я не тиснутиму.",shape=box,color=blue];
		2299 -> 2302;
	2300 [label="Думаю, ти обманюєш, щоби не псувати мені настрій. Тож… я не тиснутиму.",shape=box,color=blue];
		2300 -> 2302;
	2301 [label="Ти пробач мені. То вийшло… нечемно. Я une Sœur de Sol і не повинна втрачати контроль та розпускати так язика.",shape=box,color=blue];
		2301 -> 2303;
	2302 [label="+5 Chemistry",color=orange];
		2302 -> 2304;
	2303 [label="+5 Chemistry",color=orange];
		2303 -> 2305;
	2304 [label="Я бажаю зберегти хоч краплину гідності в подальшій розмові, якщо мені буде дозволено.",shape=box,color=blue];
		2304 -> 2306;
	2305 [label="Мій гнів не спрямований на тебе. І я завжди вдячна за чесність, ти ж знаєш.",shape=box,color=blue];
		2305 -> 2307;
	2306 [label="Якщо ти хочеш обговорити мою суперечку з мсьє Таґфером, то я не заперечуватиму, вона була.",shape=box,color=blue];
		2306 -> 2307;
	2307 [label="Припускаю, диявол розповів тобі, з якої причини сталася сварка ?",shape=box,color=blue];
		2307 -> 2308;
	2308 [label="Evaluate expressions",color=orange];
		2308 -> 2310 [label="MarieTagferFight2a",color=purple];
		2308 -> 2311 [label="MarieTagferFight2a",color=purple];
		2308 -> 2309 [label="MarieTagferFight2b",color=purple];
		2308 -> 2310 [label="MarieTagferFight2b",color=purple];
		2308 -> 2310 [label="false",color=purple];
		2308 -> 2312 [label="false",color=purple];
	2310 [label="Йому не треба мені говорити. Не складно здогадатися. Ентраті.",shape=box,color=red];
		2310 -> 2314;
	2311 [label="Так. Хоча мені здалося, він більше непокоївся за тебе, аніж за щось ще.",shape=box,color=red];
		2311 -> 2315;
	2309 [label="Так. Бо занепокоєний загалом ситуацією. На мою думку, він співчуває кавіям. ",shape=box,color=red];
		2309 -> 2313;
	2312 [label="Ні, чесно. Він лише попрохав засвідчитися, чи в тебе все гаразд.",shape=box,color=red];
		2312 -> 2316;
	2314 [label="Oui. Ми з мсьє Таґфером обговорювали le Cardinal.",shape=box,color=blue];
		2314 -> 2318;
		2314 -> 2319;
	2315 [label="Гадки не маю, з чого б це дияволу створювати для тебе таке враження. Чи що за вигоду він матиме від цього.",shape=box,color=blue];
		2315 -> 2320;
	2313 [label="Диявол стрів трьох поранених створінь і знає, що з легкістю може скористатися своєю харизмою й схилити їх на свій бік.",shape=box,color=blue];
		2313 -> 2317;
	2316 [label="Гадки не маю, з чого б це дияволу просити тебе про таке. Чи що за вигоду він матиме від цього.",shape=box,color=blue];
		2316 -> 2321;
	2318 [label="Узагалі-то Таґфер не з найпалкіших шанувальників Ентраті.",shape=box,color=red];
		2318 -> 2323;
	2319 [label="Припускаю, що заяви лунали гучні.",shape=box,color=red];
		2319 -> 2324;
	2320 [label="Усі нібито добрі діяння в мій бік від диявола послуговують одній меті — налаштувати мене проти le Cardinal. Я це знаю. ",shape=box,color=blue];
		2320 -> 2322;
	2317 [label="Він робить це, щоб усі були проти мене. Прагне налаштувати мене проти le Cardinal. Щоб я підставила спину. Для його ножа. Я впевнена.",shape=box,color=blue];
		2317 -> 2322;
	2321 [label="Але… ти тут не це хочеш обговорити. Сварка відбулася через le Cardinal. ",shape=box,color=blue];
		2321 -> 2318;
		2321 -> 2319;
	2323 [label="І я цього не розумію ! Лише глянь, що вони отримали !",shape=box,color=blue];
		2323 -> 2325;
		2323 -> 2326;
	2324 [label="Oui ! Він назвав мене stupide. І що розуму в мене, як у дитини.",shape=box,color=blue];
		2324 -> 2327;
		2324 -> 2325;
	2322 [label="Ми з мсьє Таґфером сперечалися стосовно le Cardinal.",shape=box,color=blue];
		2322 -> 2318;
		2322 -> 2319;
	2325 [label="Прошу, почни з початку. Як воно взагалі все почалося?",shape=box,color=red];
		2325 -> 2328;
	2326 [label="Щось я починаю підозрювати, чого відбулася сварка.",shape=box,color=red];
		2326 -> 2328;
	2327 [label="Він насправді назвав тебе дурепою й дитиною?",shape=box,color=red];
		2327 -> 2329;
	2328 [label="Oui. Я щось сказала про le Cardinal. Навіть не згадаю, що саме. ",shape=box,color=blue];
		2328 -> 2330;
	2329 [label="Напевно, ще гірше.",shape=box,color=blue];
		2329 -> 2331;
	2330 [label="Мсьє Таґфер закотив очі й пирхнув. Я попросила пояснити.",shape=box,color=blue];
		2330 -> 2332;
	2331 [label="«Марі, ти дитина ! Невинна. Залежна від інших усе своє життя. Згорнута клубочком у затишному гніздечку сліпої віри !».",shape=box,color=blue];
		2331 -> 2333;
	2332 [label="«Альбрехт — брудний смердючий брехун !».",shape=box,color=blue];
		2332 -> 2334;
	2333 [label="«Ти жива завдяки тому, що старші пережували й зригнули в довірливий роззявлений ротик !».",shape=box,color=blue];
		2333 -> 2335;
	2334 [label="Et j'ai répondu: «Погляньте на дари, які вам ним дані — дари роздумів, мови, самоусвідомлення !».",shape=box,color=blue];
		2334 -> 2336;
	2335 [label="Update boolean MarieEntrati3",color=orange];
		2335 -> 2337;
		2335 -> 2338;
		2335 -> 2339;
	2336 [label="«Ви маєте бути вдячними le Cardinal за те все, чим вас він благословив».",shape=box,color=blue];
		2336 -> 2340;
		2336 -> 2341;
	2337 [label="Таґфер знає лише свою частину історії. Їм… Ентраті не досить чітко пояснював свої справжні думки чи мотивацію.",shape=box,color=red];
		2337 -> 2342;
	2338 [label="Я знаю, як ти ставишся до «залежності» від інших, і мені дуже шкода, що він так сказав.",shape=box,color=red];
		2338 -> 2343;
	2339 [label="У Таґфера вагомі причини мати своє ставлення.",shape=box,color=red];
		2339 -> 2344;
	2340 [label="І як він це сприйняв?",shape=box,color=red];
		2340 -> 2331;
	2341 [label="Ой…",shape=box,color=red];
		2341 -> 2331;
	2342 [label="+5 Chemistry",color=orange];
		2342 -> 2345;
	2343 [label="+5 Chemistry",color=orange];
		2343 -> 2346;
	2344 [label="Evaluate expressions",color=orange];
		2344 -> 2347 [label="MarieEntratiFamily",color=purple];
		2344 -> 2348 [label="MarieEntratiMonster1",color=purple];
		2344 -> 2348 [label="MarieEntratiMonster2",color=purple];
		2344 -> 2349 [label="MarieEntratiFan1",color=purple];
		2344 -> 2349 [label="MarieEntratiFan2",color=purple];
		2344 -> 2351 [label="MarieEntratiNeutral",color=purple];
		2344 -> 2350 [label="false",color=purple];
	2345 [label="Та це все одно не дає йому права так говорити ! Я не знаю, чи тямить він, як глибоко ятрять мене його слова. En outre…",shape=box,color=blue];
		2345 -> 2344;
	2346 [label="Merci, я не знаю, чи тямить він, як глибоко різали мене леза його слів.",shape=box,color=blue];
		2346 -> 2352;
		2346 -> 2353;
		2346 -> 2354;
	2347 [label="Якщо така зустріч очікує le Cardinal за його повернення, то й не дивно, що він не дуже й квапиться сюди !",shape=box,color=blue];
		2347 -> 2355;
		2347 -> 2356;
	2348 [label="Упевнена, що ти тут на стороні мсьє Таґфера, non ? Ти ж теж вважаєш le Cardinal чудовиськом, як і цей звір.",shape=box,color=blue];
		2348 -> 2357;
		2348 -> 2358;
	2349 [label="Я здивована, je pensais que tu étais de mon côté ! Ти ж наче виявляєш бажання разом зі мною захищати справу le Cardinal, non ?",shape=box,color=blue];
		2349 -> 2359;
	2351 [label="Хіба не ти кажеш, що це не має значення ? Ми тут усі, щоб служити в його діяннях, а судитимемо згодом. Ця сварка беззмістовна, non ?",shape=box,color=blue];
		2351 -> 2361;
		2351 -> 2362;
	2350 [label="Я знаю, що Порожнеча виліпила їх руками le Cardinal. Усім нам le Cardinal дав дари, які ніщо інше як прокляття, якщо розглядати їх крізь розбите серце !",shape=box,color=blue];
		2350 -> 2360;
	2352 [label="А ти знаєш, як глибоко ранила ти? Тобі відома вся їхня історія?",shape=box,color=red];
		2352 -> 2350;
	2353 [label="Те, що сказала ти, ранило його так само.",shape=box,color=red];
		2353 -> 2363;
	2354 [label="Я щиро на твоїй стороні… Але, Марі… нам варто намагатися зберегти мир.",shape=box,color=red];
		2354 -> 2364;
		2354 -> 2365;
	2355 [label="Марі, прошу. Я не бажаю нової суперечки. Просто намагаюся тобі пояснити, крізь що їм довелося пройти.",shape=box,color=red];
		2355 -> 2366;
	2356 [label="Якби Ентраті залишився десь тут і допоміг прибрати своє власне лайно, то він би мав більше друзів у цьому світі.",shape=box,color=red];
		2356 -> 2367;
	2357 [label="Марі, прошу. Я не бажаю нової суперечки. Просто намагаюся тобі пояснити, крізь що їм довелося пройти.",shape=box,color=red];
		2357 -> 2366;
	2358 [label="Так, я прийму його сторону. Бо ти не дослухаєшся до раціональної суті. Маєш зрозуміти нарешті — твій «le Cardinal» геть не такий, як тобі ввижається.",shape=box,color=red];
		2358 -> 2366;
	2359 [label="Це якийсь твій великий шахрайський задум ? Ти граєшся un jeu з маленькою Марі ?",shape=box,color=blue];
		2359 -> 2368;
		2359 -> 2369;
	2361 [label="Має значення те, чи хтось залишиться поруч із нами, якщо ми будемо тримати іншу сторону. Їм чимало довелося пережити.",shape=box,color=red];
		2361 -> 2366;
	2362 [label="Щось мені підказує, що він забуде цю розмову. Та й ти, безумовно, теж.",shape=box,color=red];
		2362 -> 2371;
	2360 [label="Він нас усіх покинув ! Скажи мені, як це вони були більше скривджені, що я маю терпіти таку ненависть ?!",shape=box,color=blue];
		2360 -> 2370;
	2363 [label="Oui ?! І чого ж це ?! Пиши !",shape=box,color=blue];
		2363 -> 2350;
	2364 [label="Усе, крізь що довелося пройти кавіям… було доволі складним.",shape=box,color=red];
		2364 -> 2350;
	2365 [label="Вони тварини. Навіть якщо й отримали розум. Вони можуть стільки, скільки можуть.",shape=box,color=red];
		2365 -> 2372;
	2366 [label="Oui ? Тоді візьми на себе роль La Lumière Sacrée de Sol і розвій темряву ! Просвіти маленьку дурепу Марі !",shape=box,color=blue];
		2366 -> 2350;
	2367 [label="Oui ! Звісно. Замало ж того, що він намагається захистити відомий усесвіт від бога з Порожнечі, non ?!",shape=box,color=blue];
		2367 -> 2373;
	2368 [label="Ні, це не обман. Я з тобою. Я просто пояснюю, що їм… було несолодко.",shape=box,color=red];
		2368 -> 2366;
	2369 [label="Ні, це не ігри ніякі… Ентраті не можна довіряти. Узагалі не знаю, як іще в цьому тебе переконати, окрім удати, що я на твоєму боці.",shape=box,color=red];
		2369 -> 2374;
	2371 [label="Non ! Починаєш розмову, то доведи її до кінця. Explique !",shape=box,color=blue];
		2371 -> 2350;
	2370 [label="Evaluate expressions",color=orange];
		2370 -> 2375 [label="MarieFamily2",color=purple];
		2370 -> 2377 [label="MarieFamily2",color=purple];
		2370 -> 2375 [label="MarieBackstory1",color=purple];
		2370 -> 2378 [label="MarieBackstory1",color=purple];
		2370 -> 2375 [label="MarieInfestation",color=purple];
		2370 -> 2379 [label="MarieInfestation",color=purple];
		2370 -> 2375 [label="MarieLyonSuffering2",color=purple];
		2370 -> 2376 [label="MarieLyonSuffering2",color=purple];
		2370 -> 2375 [label="MarrieLyonSuffering3",color=purple];
		2370 -> 2375 [label="false",color=purple];
	2372 [label="Якщо намагаєшся мене якимось чином змусити їм співчувати й перевести гнів на себе, то я відчула раптову непереборну спокусу так і зробити.",shape=box,color=blue];
		2372 -> 2380;
	2373 [label="Гадаю, ліпше буде взяти перерву нині. Перш ніж гнів не зашкодив нам усім.",shape=box,color=blue];
		2373 -> 2381;
	2374 [label="Oui ? Що ж, із задоволенням повідомляю, що тобі не вдалося.",shape=box,color=blue];
		2374 -> 2382;
	2375 [label="Кавії виникли внаслідок випадковості під час експериментів. Вони взагалі не повинні були існувати. Порожнеча дала їм розум.",shape=box,color=red];
		2375 -> 2383;
	2377 [label="Це ж ти сказала: «Це якась абсолютна форма жорстокості — позбутися імені». Ентраті навіть не подумав назвати їх. Він вважав їх нікчемними.",shape=box,color=red];
		2377 -> 2385;
	2378 [label="Ти розповідала, як виросла на вулицях. Як твоя родина викинула тебе, бо вважала недостатньо хорошою для них.",shape=box,color=red];
		2378 -> 2386;
	2379 [label="Подумай, як би ти почувалася, якби тебе проти твоєї волі перетворили на протофрейма й потім покинули?",shape=box,color=red];
		2379 -> 2387;
	2376 [label="Уяви як би ти почувалася, якби з’явився зненацька Ентраті, перетворив Ліона в протофрейма й просто покинув його?",shape=box,color=red];
		2376 -> 2384;
	2380 [label="Гадаю, ліпше буде взяти перерву нині. Перш ніж гнів не зашкодив нам усім.",shape=box,color=blue];
		2380 -> 2388;
	2381 [label="Chat ends.",color=orange];
	2382 [label="Update boolean MarieEntratiFan1",color=orange];
		2382 -> 2389;
	2383 [label="Знаєш що сталося, коли Ентраті побачив результати вчинку? Коли усвідомив, кого він створив? Бідолашних тварин, які балакали мовою Порожнечі й були хворими від переохолодження?",shape=box,color=red];
		2383 -> 2390;
	2385 [label="Вони були просто речами для нього. Витратниками, які використовують і викидають. Знаєш, що значить «Таґфер»? «Позначений на утилізацію».",shape=box,color=red];
		2385 -> 2392;
	2386 [label="Твоя родина вважала тебе непотребом.",shape=box,color=red];
		2386 -> 2393;
	2387 [label="Уяви, що зараження у твоїй крові. Ти страждаєш. А поруч нема нікого, хто попіклується про тебе.",shape=box,color=red];
		2387 -> 2394;
	2384 [label="Використав його як піддослідного для дешевого наукового експерименту й потім відкинув геть? Ви всі могли покластися одне на одного після зміни. А кавії — ні.",shape=box,color=red];
		2384 -> 2391;
	2388 [label="Chat ends.",color=orange];
	2389 [label="Update boolean MarieEntratiFan2",color=orange];
		2389 -> 2395;
	2390 [label="Йому було начхати. ",shape=box,color=red];
		2390 -> 2396;
	2392 [label="Птах-3? Він птах із номером, бо був третім. Фібоначчі сам себе так назвав.",shape=box,color=red];
		2392 -> 2397;
	2393 [label="Ось чим були кавії для Ентраті. Одноразовими лабораторними тваринками. Знаєш, що значить «Таґфер»? «Позначений на утилізацію».",shape=box,color=red];
		2393 -> 2392;
	2394 [label="Ніхто не бачить твої страждання. Вони ні для кого не мають значення. Кавії були… та і нині є… непотребом для Ентраті. Одноразовими лабораторними тваринками. Знаєш, що значить «Таґфер»? «Позначений на утилізацію».",shape=box,color=red];
		2394 -> 2392;
	2391 [label="Для Ентраті кавії були лише одноразовими лабораторними тваринками. Непотребом. Знаєш, що значить «Таґфер»? «Позначений на утилізацію».",shape=box,color=red];
		2391 -> 2392;
	2395 [label="Update boolean MarieNoDate",color=orange];
		2395 -> 2398;
	2396 [label="Ось чим були кавії для Ентраті. Витратниками. Знаєш, що значить «Таґфер»? «Позначений на утилізацію».",shape=box,color=red];
		2396 -> 2399;
	2397 [label="Використані в експериментах з Порожнечею. Уцілілі з довгого списку мертвих тварин. Ті, які ніколи не мали існувати.",shape=box,color=red];
		2397 -> 2400;
	2398 [label="Chat ends.",color=orange];
	2399 [label="Він останній зі свого роду. І позначений на утилізацію. У нього була подружка. Єдина, хто теж лишилася. Вона загинула під час експерименту.",shape=box,color=red];
		2399 -> 2401;
	2400 [label="Вони досі живі лише завдяки Лойду. Він зберіг їх, бо не міг змусити себе провести евтаназію тварин «за вказівками Ентраті».",shape=box,color=red];
		2400 -> 2402;
	2401 [label="Саме тому, Марі, він розлютився. Саме тому ненавидить Ентраті. І, імовірно, завжди ненавидітиме.",shape=box,color=red];
		2401 -> 2403;
	2402 [label="О, знаєш ще що. Таґфер — останній зі свого роду. У нього була подружка. Єдина, хто теж лишилася. Вона загинула під час експерименту.",shape=box,color=red];
		2402 -> 2404;
	2403 [label="Update boolean MarieEntrati3b",color=orange];
		2403 -> 2405;
		2403 -> 2406;
	2404 [label="Саме тому, Марі, він розлютився. Саме тому ненавидить Ентраті. І, імовірно, завжди ненавидітиме.",shape=box,color=red];
		2404 -> 2407;
	2405 [label="Я знаю, що ти віриш у те, що він робить що вважає за потрібне. І знаю, що ти віриш у прощення. Так і я. Але ти маєш зрозуміти, що для декого це просто неможливо. Принаймні поки що.",shape=box,color=red];
		2405 -> 2408;
	2406 [label="Іноді бувають випадки, коли для декого неможливо пробачити тих, хто кривдив їх. Точно не зараз. І, можливо, ніколи. ",shape=box,color=red];
		2406 -> 2409;
	2407 [label="Update boolean MarieEntrati3a",color=orange];
		2407 -> 2410;
		2407 -> 2411;
	2408 [label="Add 1 to Thermostat",color=orange];
		2408 -> 2412;
	2409 [label="Add -1 to Thermostat",color=orange];
		2409 -> 2413;
	2410 [label="Я знаю, що ти віриш у те, що він робить що вважає за потрібне. І знаю, що ти віриш у прощення. Так і я. Але ти маєш зрозуміти, що для декого це просто неможливо. Принаймні поки що.",shape=box,color=red];
		2410 -> 2414;
	2411 [label="Іноді бувають випадки, коли для декого неможливо пробачити тих, хто кривдив їх. Точно не зараз. І, можливо, ніколи. ",shape=box,color=red];
		2411 -> 2415;
	2412 [label="Ми можемо лише намагатися допомогти Таґферу зцілитися. Зробити все можливе для цього. І сподіватися, що котрогось дня він відпустить біль.",shape=box,color=red];
		2412 -> 2416;
	2413 [label="У будь-якому випадку не нам вирішувати, коли і чи пробачить Таґфер Ентраті. Це все залежить лише від Таґфера.",shape=box,color=red];
		2413 -> 2416;
	2414 [label="Add 1 to Thermostat",color=orange];
		2414 -> 2417;
	2415 [label="Add -1 to Thermostat",color=orange];
		2415 -> 2418;
	2416 [label="Твою позицію… почуто. Я мушу завершити бесіду. Мені потрібно все добре обміркувати. Ми обов’язково повернемося до цього. Щойно думки трішки вкладуться.",shape=box,color=blue];
		2416 -> 2419;
	2417 [label="Ми можемо лише намагатися допомогти Таґферу зцілитися. Зробити все можливе для цього. І сподіватися, що котрогось дня він відпустить біль.",shape=box,color=red];
		2417 -> 2420;
	2418 [label="У будь-якому випадку не нам вирішувати, коли і чи пробачить Таґфер Ентраті. Це все залежить лише від Таґфера.",shape=box,color=red];
