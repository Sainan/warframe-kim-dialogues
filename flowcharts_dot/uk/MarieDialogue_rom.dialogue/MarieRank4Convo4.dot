		j3688018840 -> j4216318905;
	j67588259 [label="Використані в експериментах з Порожнечею. Уцілілі з довгого списку мертвих тварин. Ті, які ніколи не мали існувати.",shape=box,color=red];
		j67588259 -> j3306765547;
	j4216318905 [label="Він останній зі свого роду. І позначений на утилізацію. У нього була подружка. Єдина, хто теж лишилася. Вона загинула під час експерименту.",shape=box,color=red];
		j4216318905 -> j4194856024;
	j3306765547 [label="Вони досі живі лише завдяки Лойду. Він зберіг їх, бо не міг змусити себе провести евтаназію тварин «за вказівками Ентраті».",shape=box,color=red];
		j3306765547 -> j638633522;
	j4194856024 [label="Саме тому, Марі, він розлютився. Саме тому ненавидить Ентраті. І, імовірно, завжди ненавидітиме.",shape=box,color=red];
		j4194856024 -> j2433363310;
	j638633522 [label="О, знаєш ще що. Таґфер — останній зі свого роду. У нього була подружка. Єдина, хто теж лишилася. Вона загинула під час експерименту.",shape=box,color=red];
