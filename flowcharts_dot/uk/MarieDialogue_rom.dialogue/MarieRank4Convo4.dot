		j3022194826 -> j1478915251 [label=true,color=green];
		j3022194826 -> "Chat ends." [label=false,color=brown];
	j590546656 [label="Марі? Ми можемо поговорити?",shape=box,color=red];
		j590546656 -> j775507143;
	j1861755354 [label="Роут розповів про… сварку з Таґфером. Ми можемо це обговорити?",shape=box,color=red];
		j1861755354 -> j1695815302;
	j1478915251 [label="[Завершити розмову]",shape=box,color=red];
		j1478915251 -> "Chat ends.";
	"Chat ends." [color=orange];
	j775507143 [label="Oui, хоча мені здається, я знаю, про що йтиметься… я повелася погано. Хто тобі сказав ?",shape=box,color=blue];
		j775507143 -> j518185602;
		j775507143 -> j2315895599;
		j775507143 -> j792707463;
	j1695815302 [label="Bien sûr, ce salaud de diable ouvre sa bouche et vous raconte tout ! Il ne cherche qu'à m'embarrasser !",shape=box,color=blue];
		j1695815302 -> j3430960012;
	j518185602 [label="Це не суттєво.",shape=box,color=red];
		j518185602 -> j1844355016;
	j2315895599 [label="Лойд.",shape=box,color=red];
		j2315895599 -> j2792944078;
	j792707463 [label="Роут.",shape=box,color=red];
		j792707463 -> j1695815302;
	j3430960012 [label="Si je le pouvais, je prendrais ce couteau qu'il aime tant utiliser pour agacer les autres et je le fourrerais là où seule Lua peut le voir !",shape=box,color=blue];
		j3430960012 -> j2421547970;
	j1844355016 [label="Суттєво, але ти, певно, не бажаєш псувати мені настрій. Тож… я не тиснутиму.",shape=box,color=blue];
		j1844355016 -> j2901735045;
	j2792944078 [label="Думаю, ти обманюєш, щоби не псувати мені настрій. Тож… я не тиснутиму.",shape=box,color=blue];
		j2792944078 -> j2901735045;
	j2421547970 [label="Ти пробач мені. То вийшло… нечемно. Я une Sœur de Sol і не повинна втрачати контроль та розпускати так язика.",shape=box,color=blue];
		j2421547970 -> j3215461124;
	j2901735045 [label="+5 Chemistry",color=orange];
		j2901735045 -> j1960214853;
	j3215461124 [label="+5 Chemistry",color=orange];
		j3215461124 -> j3496916644;
	j1960214853 [label="Я бажаю зберегти хоч краплину гідності в подальшій розмові, якщо мені буде дозволено.",shape=box,color=blue];
		j1960214853 -> j193401807;
	j3496916644 [label="Мій гнів не спрямований на тебе. І я завжди вдячна за чесність, ти ж знаєш.",shape=box,color=blue];
		j3496916644 -> j72588514;
	j193401807 [label="Якщо ти хочеш обговорити мою суперечку з мсьє Таґфером, то я не заперечуватиму, вона була.",shape=box,color=blue];
		j193401807 -> j72588514;
	j72588514 [label="Припускаю, диявол розповів тобі, з якої причини сталася сварка ?",shape=box,color=blue];
		j72588514 -> j370765590;
	j370765590 [label="Evaluate expressions",color=orange];
		j370765590 -> j2895669269 [label="MarieTagferFight2a",color=purple];
		j370765590 -> j2159205018 [label="MarieTagferFight2a",color=purple];
		j370765590 -> j5641596 [label="MarieTagferFight2b",color=purple];
		j370765590 -> j2895669269 [label="MarieTagferFight2b",color=purple];
		j370765590 -> j2895669269 [label="false",color=purple];
		j370765590 -> j3091204702 [label="false",color=purple];
	j2895669269 [label="Йому не треба мені говорити. Не складно здогадатися. Ентраті.",shape=box,color=red];
		j2895669269 -> j1943580481;
	j2159205018 [label="Так. Хоча мені здалося, він більше непокоївся за тебе, аніж за щось ще.",shape=box,color=red];
		j2159205018 -> j3065465286;
	j5641596 [label="Так. Бо занепокоєний загалом ситуацією. На мою думку, він співчуває кавіям. ",shape=box,color=red];
		j5641596 -> j1674783301;
	j3091204702 [label="Ні, чесно. Він лише попрохав засвідчитися, чи в тебе все гаразд.",shape=box,color=red];
		j3091204702 -> j4119365449;
	j1943580481 [label="Oui. Ми з мсьє Таґфером обговорювали le Cardinal.",shape=box,color=blue];
		j1943580481 -> j2747640193;
		j1943580481 -> j1883348553;
	j3065465286 [label="Гадки не маю, з чого б це дияволу створювати для тебе таке враження. Чи що за вигоду він матиме від цього.",shape=box,color=blue];
		j3065465286 -> j1890542514;
	j1674783301 [label="Диявол стрів трьох поранених створінь і знає, що з легкістю може скористатися своєю харизмою й схилити їх на свій бік.",shape=box,color=blue];
		j1674783301 -> j1520999300;
	j4119365449 [label="Гадки не маю, з чого б це дияволу просити тебе про таке. Чи що за вигоду він матиме від цього.",shape=box,color=blue];
		j4119365449 -> j79628066;
	j2747640193 [label="Узагалі-то Таґфер не з найпалкіших шанувальників Ентраті.",shape=box,color=red];
		j2747640193 -> j1748067976;
	j1883348553 [label="Припускаю, що заяви лунали гучні.",shape=box,color=red];
		j1883348553 -> j1979650707;
	j1890542514 [label="Усі нібито добрі діяння в мій бік від диявола послуговують одній меті — налаштувати мене проти le Cardinal. Я це знаю. ",shape=box,color=blue];
		j1890542514 -> j1088978072;
	j1520999300 [label="Він робить це, щоб усі були проти мене. Прагне налаштувати мене проти le Cardinal. Щоб я підставила спину. Для його ножа. Я впевнена.",shape=box,color=blue];
		j1520999300 -> j1088978072;
	j79628066 [label="Але… ти тут не це хочеш обговорити. Сварка відбулася через le Cardinal. ",shape=box,color=blue];
		j79628066 -> j2747640193;
		j79628066 -> j1883348553;
	j1748067976 [label="І я цього не розумію ! Лише глянь, що вони отримали !",shape=box,color=blue];
		j1748067976 -> j3006129706;
		j1748067976 -> j1338482025;
	j1979650707 [label="Oui ! Він назвав мене stupide. І що розуму в мене, як у дитини.",shape=box,color=blue];
		j1979650707 -> j1892563464;
		j1979650707 -> j3006129706;
	j1088978072 [label="Ми з мсьє Таґфером сперечалися стосовно le Cardinal.",shape=box,color=blue];
		j1088978072 -> j2747640193;
		j1088978072 -> j1883348553;
	j3006129706 [label="Прошу, почни з початку. Як воно взагалі все почалося?",shape=box,color=red];
		j3006129706 -> j2615419389;
	j1338482025 [label="Щось я починаю підозрювати, чого відбулася сварка.",shape=box,color=red];
		j1338482025 -> j2615419389;
	j1892563464 [label="Він насправді назвав тебе дурепою й дитиною?",shape=box,color=red];
		j1892563464 -> j509144035;
	j2615419389 [label="Oui. Я щось сказала про le Cardinal. Навіть не згадаю, що саме. ",shape=box,color=blue];
		j2615419389 -> j481401177;
	j509144035 [label="Напевно, ще гірше.",shape=box,color=blue];
		j509144035 -> j3936778419;
	j481401177 [label="Мсьє Таґфер закотив очі й пирхнув. Я попросила пояснити.",shape=box,color=blue];
		j481401177 -> j2833091447;
	j3936778419 [label="«Марі, ти дитина ! Невинна. Залежна від інших усе своє життя. Згорнута клубочком у затишному гніздечку сліпої віри !».",shape=box,color=blue];
		j3936778419 -> j3833932153;
	j2833091447 [label="«Альбрехт — брудний смердючий брехун !».",shape=box,color=blue];
		j2833091447 -> j1022181589;
	j3833932153 [label="«Ти жива завдяки тому, що старші пережували й зригнули в довірливий роззявлений ротик !».",shape=box,color=blue];
		j3833932153 -> j471012429;
	j1022181589 [label="Et j'ai répondu: «Погляньте на дари, які вам ним дані — дари роздумів, мови, самоусвідомлення !».",shape=box,color=blue];
		j1022181589 -> j184661052;
	j471012429 [label="Boolean MarieEntrati3 is now true.",color=orange];
		j471012429 -> j1339136747;
		j471012429 -> j2050337360;
		j471012429 -> j3845798151;
	j184661052 [label="«Ви маєте бути вдячними le Cardinal за те все, чим вас він благословив».",shape=box,color=blue];
		j184661052 -> j3988656089;
		j184661052 -> j3821171079;
	j1339136747 [label="Таґфер знає лише свою частину історії. Їм… Ентраті не досить чітко пояснював свої справжні думки чи мотивацію.",shape=box,color=red];
		j1339136747 -> j1994351588;
	j2050337360 [label="Я знаю, як ти ставишся до «залежності» від інших, і мені дуже шкода, що він так сказав.",shape=box,color=red];
		j2050337360 -> j201932276;
	j3845798151 [label="У Таґфера вагомі причини мати своє ставлення.",shape=box,color=red];
		j3845798151 -> j946548047;
	j3988656089 [label="І як він це сприйняв?",shape=box,color=red];
		j3988656089 -> j3936778419;
	j3821171079 [label="Ой…",shape=box,color=red];
		j3821171079 -> j3936778419;
	j1994351588 [label="+5 Chemistry",color=orange];
		j1994351588 -> j601280151;
	j201932276 [label="+5 Chemistry",color=orange];
		j201932276 -> j3142804926;
	j946548047 [label="Evaluate expressions",color=orange];
		j946548047 -> j2844358248 [label="MarieEntratiFamily",color=purple];
		j946548047 -> j3817968790 [label="MarieEntratiMonster1",color=purple];
		j946548047 -> j3817968790 [label="MarieEntratiMonster2",color=purple];
		j946548047 -> j4133592673 [label="MarieEntratiFan1",color=purple];
		j946548047 -> j4133592673 [label="MarieEntratiFan2",color=purple];
		j946548047 -> j2652934474 [label="MarieEntratiNeutral",color=purple];
		j946548047 -> j2653669324 [label="false",color=purple];
	j601280151 [label="Та це все одно не дає йому права так говорити ! Я не знаю, чи тямить він, як глибоко ятрять мене його слова. En outre…",shape=box,color=blue];
		j601280151 -> j946548047;
	j3142804926 [label="Merci, я не знаю, чи тямить він, як глибоко різали мене леза його слів.",shape=box,color=blue];
		j3142804926 -> j1878397808;
		j3142804926 -> j1295317412;
		j3142804926 -> j4141491174;
	j2844358248 [label="Якщо така зустріч очікує le Cardinal за його повернення, то й не дивно, що він не дуже й квапиться сюди !",shape=box,color=blue];
		j2844358248 -> j1248117537;
		j2844358248 -> j2348594764;
	j3817968790 [label="Упевнена, що ти тут на стороні мсьє Таґфера, non ? Ти ж теж вважаєш le Cardinal чудовиськом, як і цей звір.",shape=box,color=blue];
		j3817968790 -> j1248117537;
		j3817968790 -> j3695396064;
	j4133592673 [label="Я здивована, je pensais que tu étais de mon côté ! Ти ж наче виявляєш бажання разом зі мною захищати справу le Cardinal, non ?",shape=box,color=blue];
		j4133592673 -> j1645023926;
	j2652934474 [label="Хіба не ти кажеш, що це не має значення ? Ми тут усі, щоб служити в його діяннях, а судитимемо згодом. Ця сварка беззмістовна, non ?",shape=box,color=blue];
		j2652934474 -> j2695689137;
		j2652934474 -> j1008029258;
	j2653669324 [label="Я знаю, що Порожнеча виліпила їх руками le Cardinal. Усім нам le Cardinal дав дари, які ніщо інше як прокляття, якщо розглядати їх крізь розбите серце !",shape=box,color=blue];
		j2653669324 -> j2261789792;
	j1878397808 [label="А ти знаєш, як глибоко ранила ти? Тобі відома вся їхня історія?",shape=box,color=red];
		j1878397808 -> j2653669324;
	j1295317412 [label="Те, що сказала ти, ранило його так само.",shape=box,color=red];
		j1295317412 -> j741028398;
	j4141491174 [label="Я щиро на твоїй стороні… Але, Марі… нам варто намагатися зберегти мир.",shape=box,color=red];
		j4141491174 -> j3586033305;
		j4141491174 -> j3376573443;
	j1248117537 [label="Марі, прошу. Я не бажаю нової суперечки. Просто намагаюся тобі пояснити, крізь що їм довелося пройти.",shape=box,color=red];
		j1248117537 -> j62907200;
	j2348594764 [label="Якби Ентраті залишився десь тут і допоміг прибрати своє власне лайно, то він би мав більше друзів у цьому світі.",shape=box,color=red];
		j2348594764 -> j957369078;
	j3695396064 [label="Так, я прийму його сторону. Бо ти не дослухаєшся до раціональної суті. Маєш зрозуміти нарешті — твій «le Cardinal» геть не такий, як тобі ввижається.",shape=box,color=red];
		j3695396064 -> j62907200;
	j1645023926 [label="Це якийсь твій великий шахрайський задум ? Ти граєшся un jeu з маленькою Марі ?",shape=box,color=blue];
		j1645023926 -> j1945468632;
		j1645023926 -> j807068485;
	j2695689137 [label="Має значення те, чи хтось залишиться поруч із нами, якщо ми будемо тримати іншу сторону. Їм чимало довелося пережити.",shape=box,color=red];
		j2695689137 -> j62907200;
	j1008029258 [label="Щось мені підказує, що він забуде цю розмову. Та й ти, безумовно, теж.",shape=box,color=red];
		j1008029258 -> j3918585752;
	j2261789792 [label="Він нас усіх покинув ! Скажи мені, як це вони були більше скривджені, що я маю терпіти таку ненависть ?!",shape=box,color=blue];
		j2261789792 -> j1639327012;
	j741028398 [label="Oui ?! І чого ж це ?! Пиши !",shape=box,color=blue];
		j741028398 -> j2653669324;
	j3586033305 [label="Усе, крізь що довелося пройти кавіям… було доволі складним.",shape=box,color=red];
		j3586033305 -> j2653669324;
	j3376573443 [label="Вони тварини. Навіть якщо й отримали розум. Вони можуть стільки, скільки можуть.",shape=box,color=red];
		j3376573443 -> j2411889446;
	j62907200 [label="Oui ? Тоді візьми на себе роль La Lumière Sacrée de Sol і розвій темряву ! Просвіти маленьку дурепу Марі !",shape=box,color=blue];
		j62907200 -> j2653669324;
	j957369078 [label="Oui ! Звісно. Замало ж того, що він намагається захистити відомий усесвіт від бога з Порожнечі, non ?!",shape=box,color=blue];
		j957369078 -> j2388855382;
	j1945468632 [label="Ні, це не обман. Я з тобою. Я просто пояснюю, що їм… було несолодко.",shape=box,color=red];
		j1945468632 -> j62907200;
	j807068485 [label="Ні, це не ігри ніякі… Ентраті не можна довіряти. Узагалі не знаю, як іще в цьому тебе переконати, окрім удати, що я на твоєму боці.",shape=box,color=red];
		j807068485 -> j1051656765;
	j3918585752 [label="Non ! Починаєш розмову, то доведи її до кінця. Explique !",shape=box,color=blue];
		j3918585752 -> j2653669324;
	j1639327012 [label="Evaluate expressions",color=orange];
		j1639327012 -> j2174547487 [label="MarieFamily2",color=purple];
		j1639327012 -> j3006469659 [label="MarieFamily2",color=purple];
		j1639327012 -> j2174547487 [label="MarieBackstory1",color=purple];
		j1639327012 -> j3632651859 [label="MarieBackstory1",color=purple];
		j1639327012 -> j2174547487 [label="MarieInfestation",color=purple];
		j1639327012 -> j1753529865 [label="MarieInfestation",color=purple];
		j1639327012 -> j2174547487 [label="MarieLyonSuffering2",color=purple];
		j1639327012 -> j1548663707 [label="MarieLyonSuffering2",color=purple];
		j1639327012 -> j2174547487 [label="MarrieLyonSuffering3",color=purple];
		j1639327012 -> j2174547487 [label="false",color=purple];
	j2411889446 [label="Якщо намагаєшся мене якимось чином змусити їм співчувати й перевести гнів на себе, то я відчула раптову непереборну спокусу так і зробити.",shape=box,color=blue];
		j2411889446 -> j2388855382;
	j2388855382 [label="Гадаю, ліпше буде взяти перерву нині. Перш ніж гнів не зашкодив нам усім.",shape=box,color=blue];
		j2388855382 -> "Chat ends.";
	j1051656765 [label="Oui ? Що ж, із задоволенням повідомляю, що тобі не вдалося.",shape=box,color=blue];
		j1051656765 -> j1509439757;
	j2174547487 [label="Кавії виникли внаслідок випадковості під час експериментів. Вони взагалі не повинні були існувати. Порожнеча дала їм розум.",shape=box,color=red];
		j2174547487 -> j193110163;
	j3006469659 [label="Це ж ти сказала: «Це якась абсолютна форма жорстокості — позбутися імені». Ентраті навіть не подумав назвати їх. Він вважав їх нікчемними.",shape=box,color=red];
		j3006469659 -> j1132262083;
	j3632651859 [label="Ти розповідала, як виросла на вулицях. Як твоя родина викинула тебе, бо вважала недостатньо хорошою для них.",shape=box,color=red];
		j3632651859 -> j548411555;
	j1753529865 [label="Подумай, як би ти почувалася, якби тебе проти твоєї волі перетворили на протофрейма й потім покинули?",shape=box,color=red];
		j1753529865 -> j1085631621;
	j1548663707 [label="Уяви як би ти почувалася, якби з’явився зненацька Ентраті, перетворив Ліона в протофрейма й просто покинув його?",shape=box,color=red];
		j1548663707 -> j3492404123;
	j1509439757 [label="Boolean MarieEntratiFan1 is now false.",color=orange];
		j1509439757 -> j2631316640;
	j193110163 [label="Знаєш що сталося, коли Ентраті побачив результати вчинку? Коли усвідомив, кого він створив? Бідолашних тварин, які балакали мовою Порожнечі й були хворими від переохолодження?",shape=box,color=red];
		j193110163 -> j315182771;
	j1132262083 [label="Вони були просто речами для нього. Витратниками, які використовують і викидають. Знаєш, що значить «Таґфер»? «Позначений на утилізацію».",shape=box,color=red];
		j1132262083 -> j3491921534;
	j548411555 [label="Твоя родина вважала тебе непотребом.",shape=box,color=red];
		j548411555 -> j4006356041;
	j1085631621 [label="Уяви, що зараження у твоїй крові. Ти страждаєш. А поруч нема нікого, хто попіклується про тебе.",shape=box,color=red];
		j1085631621 -> j2244522390;
	j3492404123 [label="Використав його як піддослідного для дешевого наукового експерименту й потім відкинув геть? Ви всі могли покластися одне на одного після зміни. А кавії — ні.",shape=box,color=red];
		j3492404123 -> j798777055;
	j2631316640 [label="Boolean MarieEntratiFan2 is now false.",color=orange];
		j2631316640 -> j1508231473;
	j315182771 [label="Йому було начхати. ",shape=box,color=red];
		j315182771 -> j3688018840;
	j3491921534 [label="Птах-3? Він птах із номером, бо був третім. Фібоначчі сам себе так назвав.",shape=box,color=red];
		j3491921534 -> j67588259;
	j4006356041 [label="Ось чим були кавії для Ентраті. Одноразовими лабораторними тваринками. Знаєш, що значить «Таґфер»? «Позначений на утилізацію».",shape=box,color=red];
		j4006356041 -> j3491921534;
	j2244522390 [label="Ніхто не бачить твої страждання. Вони ні для кого не мають значення. Кавії були… та і нині є… непотребом для Ентраті. Одноразовими лабораторними тваринками. Знаєш, що значить «Таґфер»? «Позначений на утилізацію».",shape=box,color=red];
		j2244522390 -> j3491921534;
	j798777055 [label="Для Ентраті кавії були лише одноразовими лабораторними тваринками. Непотребом. Знаєш, що значить «Таґфер»? «Позначений на утилізацію».",shape=box,color=red];
