	2419 [label="+5 Chemistry",color=orange];
		2419 -> 2421;
	2420 [label="Ти… тепер у мене є дуже багато чого над чим поміркувати. Боюся, я не доберу слів зараз. Я… я мушу піти. Ми обов’язково повернемося до цього. Щойно думки трішки вкладуться.",shape=box,color=blue];
