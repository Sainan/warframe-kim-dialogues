		j86733433 -> j3587225940;
		j86733433 -> j3705546888;
	j1553099683 [label="Ой, боюся, що я зраджу його, якщо розповім… а я не повинна.",shape=box,color=blue];
		j1553099683 -> j1113802444;
		j1553099683 -> j1864252582;
	j3130208497 [label="Ліон фарбує світ багряними фарбами, незалежно від того, що показує зовні. Мені прикро, що він не розмовляє з тобою. Я прохала його про це…",shape=box,color=blue];
