	j66931852 [label="Гадаю, що в тобі достатньо кмітливості й уже знаєш, що Ліон тримає у глибині серця болючий тягар. І відчуває, що лише він має нести його.",shape=box,color=blue];
		j66931852 -> j1160148273;
	j161607687 [label="Ліон тримає у глибині серця болючий тягар. І відчуває, що лише він має нести його.",shape=box,color=blue];
