digraph {
	77 [label="MarieRank1Convo3 begins.",color=orange];
		77 -> 78;
	78 [label="Il y a un crâne volant ! Keksekça ?! Тут летючий говіркий череп, а всі собі займаються своїми справами, ніби нічого такого не відбувається. Мені треба хтось для підтвердження, що існування цієї штуки нормальне.",shape=box,color=blue];
		78 -> 79;
		78 -> 81;
		78 -> 80;
	79 [label="Та це Некралойд. Чи то пак, некралойд. Усе складно.",shape=box,color=red];
		79 -> 82;
	81 [label="Це некралойд. Він цефалон. Він тебе не скривдить.",shape=box,color=red];
		81 -> 84;
	80 [label="[Завершити розмову]",shape=box,color=red];
		80 -> 83;
	82 [label="Pardon, то це ім’я чи сутність ?",shape=box,color=blue];
		82 -> 85;
		82 -> 86;
	84 [label="Та я не вважаю його загрозою ! Він не лякає мене.",shape=box,color=blue];
		84 -> 87;
	83 [label="Chat ends.",color=orange];
	85 [label="Я… насправді не знаю.",shape=box,color=red];
		85 -> 88;
	86 [label="Так.",shape=box,color=red];
		86 -> 89;
	87 [label="Справді, він ідеально чарівний, однак дуже непохитний в розмові. Геть не схожий на свого живого протеже. Але з огляду на характер мого улюбленого супутника в подорожах — мене це не надто турбує.",shape=box,color=blue];
		87 -> 90;
	88 [label="По-перше, хто придумав цих «некралойдів» ? Чого вони так називаються і для чого вони ?",shape=box,color=blue];
		88 -> 91;
		88 -> 92;
	89 [label="Я… не розумію. А яка роль Лойда тут ?",shape=box,color=blue];
		89 -> 88;
	90 [label="Ні, те, що може вважатися тобі ґротескним у його зовнішності, мене абсолютно не турбує. Запевняю тебе.",shape=box,color=blue];
		90 -> 93;
		90 -> 94;
	91 [label="Твій Cardinal Dimanche. Ентраті.",shape=box,color=red];
		91 -> 95;
	92 [label="Ентраті зробив. Але сутність того, ким вони є (цефалонами), розробили орокіни.",shape=box,color=red];
		92 -> 95;
	93 [label="Мене дивує, що тобі не гидко від черепа.",shape=box,color=red];
		93 -> 96;
	94 [label="Маю визнати, що без контексту він може бути дивним. Але що саме тебе засмучує?",shape=box,color=red];
		94 -> 97;
	95 [label="Excusez-moi, ти маєш на увазі, що le Cardinal скопіював свого супутника й зробив із нього летючого черепа-служку, і ще й назву таку дав ?",shape=box,color=blue];
		95 -> 98;
	96 [label="Ти мене мало знаєш, і це не твоя провина. Я чимало часу провела, доглядаючи за мерцями та місцями їхнього спочину. ",shape=box,color=blue];
		96 -> 99;
	97 [label="Мені стало цікаво, чого на спині є ще одне обличчя, яке нагадує дитячі каракулі.",shape=box,color=blue];
		97 -> 100;
	98 [label="А чого їх тоді більше нема, цих некралойдів ?",shape=box,color=blue];
		98 -> 101;
		98 -> 102;
		98 -> 103;
	99 [label="Дуже багато часу провела з ними поруч. Вони цілими днями вислуховували мої скарги.",shape=box,color=blue];
		99 -> 104;
	100 [label="Я спитала монсеньйора Некралойда і монсеньйора Лойда. Ніхто з них не захотів про це говорити, лише назвали одне ім’я. Отак. І вони вимовляли його з великим сумом у голосі.",shape=box,color=blue];
		100 -> 105;
	101 [label="Можливо, він зрозумів, як моторошно робити собі цифрову копію свого коханця.",shape=box,color=red];
		101 -> 106;
	102 [label="Може, він хотів створити лише одного.",shape=box,color=red];
		102 -> 107;
	103 [label="Я не знаю. Може, йому не було коли зробити більше?",shape=box,color=red];
		103 -> 108;
	104 [label="Update boolean MarieGraveyard1",color=orange];
		104 -> 109;
		104 -> 110;
	105 [label="Тож я тут, балакаю з тобою, сподіваючись, що ти зможеш мені допомогти.",shape=box,color=blue];
		105 -> 111;
		105 -> 112;
	106 [label="Ou bien, на знак любові й поваги. Він уважав, що ця дивна лабораторія не зможе працювати без монсеньйора Лойда.",shape=box,color=blue];
		106 -> 113;
		106 -> 114;
	107 [label="+5 Chemistry",color=orange];
		107 -> 115;
	108 [label="Уяви собі, цілий виводок летючих черепів. Бездоганно дієвих !",shape=box,color=blue];
		108 -> 114;
		108 -> 116;
	109 [label="Тобі подобається доглядати за цвинтарями?",shape=box,color=red];
		109 -> 117;
	110 [label="А вони хоч раз відповіли?",shape=box,color=red];
		110 -> 118;
	111 [label="Ти хочеш дізнатися про Отака? Чи про те, чому не можеш говорити з ним?",shape=box,color=red];
		111 -> 119;
	112 [label="Отака важко пояснити…",shape=box,color=red];
		112 -> 2918;
	113 [label="Як на мене, то це дуже дивний романтичний учинок, але навряд чи мені про це казати.",shape=box,color=red];
		113 -> 122;
	114 [label="Чесно, я б геть не проти, якби некралойд дзижчав довкола моєї домівки.",shape=box,color=red];
		114 -> 123;
	115 [label="По-своєму трагічно й прекрасно, non? На знак любові й поваги. Він уважав, що ця дивна лабораторія не зможе працювати без монсеньйора Лойда.",shape=box,color=blue];
		115 -> 124;
		115 -> 113;
	116 [label="Чесно кажучи, мене радує, що він тут такий один. Не думаю, що світ готовий до більшого.",shape=box,color=red];
		116 -> 125;
	117 [label="Так, а ще за мавзолеями й криптами. Але визнаю, що на відкритому повітрі мені ліпше, однак для мого крісла вони були важкопрохідними. Як і сходи, на жаль.",shape=box,color=blue];
		117 -> 126;
	118 [label="Ха ! Ні, на щастя. Не до тих пір, допоки твій «некралойд» із такою похмурою пикою заговорив зі мною. Якщо розмови з мертвими належать до Благ Світочів, то я про це не знаю.",shape=box,color=blue];
		118 -> 127;
	119 [label="Гадаю, що з часом захочу знати обидві відповіді. Але дозволю тобі вибрати з чого починати. Я не знаю, що з них важливіше, après tout.",shape=box,color=blue];
		119 -> 2918;
	2918 [label="Check boolean LoidFamilyComplete",color=orange];
		2918 -> 121 [label=true,color=green];
		2918 -> 121 [label=false,color=brown];
		2918 -> 120 [label=false,color=brown];
	122 [label="От тепер я заінтригована, але видається мені, що це історія для іншого разу. Cela dit…",shape=box,color=blue];
		122 -> 97;
	123 [label="Я цілковито впевнена, що в такому випадку тобі гнітюче треба компанія або організація роботи, або й те й інше. Але ця розмова для іншого разу.",shape=box,color=blue];
		123 -> 97;
	124 [label="Гадаю, що це більше пов’язано з потребою втримати це місце в порядку, аніж щось інше.",shape=box,color=red];
		124 -> 130;
	125 [label="Точно ! Як і я. Що веде до мого наступного запитання.",shape=box,color=blue];
		125 -> 97;
	126 [label="Update boolean MarieSerum1",color=orange];
		126 -> 131;
		126 -> 132;
	127 [label="Ні, чути духів та інші голоси — це більше компетенція мого любого Ліона. Хоча й цікаво, чи не переслідує монсеньйора Некралойда хтось… зважаючи на ті дитячі каракулі на потилиці.",shape=box,color=blue];
		127 -> 133;
	121 [label="Отак колись був архімедівцем, орокінським ученим і академіком. А подальша історія не з тих, що зі щасливим завершенням.",shape=box,color=red];
		121 -> 129;
	120 [label="Ну… якщо коротко, то нагорі частина родини Ентраті. І вони не дуже… тобто зовсім не знають, що ми тут унизу.",shape=box,color=red];
		120 -> 128;
	130 [label="І може бути саме навіть так. Летючому створінню чимало бракує raison d'être і nuance справжнього монсеньйора Лойда. Cela dit…",shape=box,color=blue];
		130 -> 97;
	131 [label="Мені ніяк не вдавалося зрозуміти, чи доречно питати про вплив сироватки на твої ноги…",shape=box,color=red];
		131 -> 136;
	132 [label="Для твого крісла?",shape=box,color=red];
		132 -> 137;
	133 [label="До речі, саме про це я й першочергово збиралася поговорити, якщо ти не проти.",shape=box,color=blue];
		133 -> 100;
	129 [label="Update boolean MarieOtak1",color=orange];
		129 -> 135;
	128 [label="Update boolean MarieFamily1",color=orange];
		128 -> 134;
	136 [label="+10 Chemistry",color=orange];
		136 -> 140;
	137 [label="Я не знаю як це у вас називають. Un fauteuil roulant або… напевно, тим терміном, який я терпіти не можу. Un fauteuil pour invalide.",shape=box,color=blue];
		137 -> 141;
	135 [label="Par les Luminaires… прошу, продовжуй.",shape=box,color=blue];
		135 -> 139;
	134 [label="Par les Luminaires… Тобто ти маєш на увазі, що ми тут усі втаємничено сидимо ?! Саме тому не можна покидати це місце ?! Mais pourquoi ?!",shape=box,color=blue];
		134 -> 138;
	140 [label="О ! Ох ти ж бідолашне. Уявляю, як ти сидиш там на самоті й дивуєшся, чи це не le Cardinal бавився з моїми ногами ?! Non, non, non — нічого подібного.",shape=box,color=blue];
		140 -> 144;
	141 [label="Ну як те, на чому ми зараз сидимо перед цими милими пристроями для спілкування. Але збоку були коліщата, як на возі, для пересування. Крісло-віз, якщо тобі так зрозуміліше.",shape=box,color=blue];
		141 -> 145;
		141 -> 146;
	139 [label="З усіх подій стає зрозумілим, що він був генієм і тим, хто опанував використання кристалів аргону.",shape=box,color=red];
		139 -> 143;
	138 [label="Його донька Евлерія (також відома як Матір) і її родина весь цей час піклувалися про Деймос.",shape=box,color=red];
		138 -> 142;
	144 [label="Сол захотів надати моєму життю незручностей, наділивши кволими ногами ще в утробі матері. Я нездатна була ходити. ",shape=box,color=blue];
		144 -> 149;
	145 [label="У тебе була інвалідність до того, як ти стала протофреймом?",shape=box,color=red];
		145 -> 150;
	146 [label="Ми звемо це візочками. Можеш вірити або ні.",shape=box,color=red];
		146 -> 151;
	143 [label="А вони походять із Порожнечі. І саме завдяки їм ми можемо створювати чимало ворфреймів та потужну зброю.",shape=box,color=red];
		143 -> 148;
	142 [label="Наглядали за цим місцем і за серцем, яке перекачує енергію Порожнечі в Материнську систему, що дозволяє нам усім… бути корисними, насправді. І це все аж з моменту зникнення Ентраті.",shape=box,color=red];
		142 -> 861;
	149 [label="Але вони були таки просто незручностями.",shape=box,color=blue];
		149 -> 155;
	150 [label="Non. Зовсім навіть ні.",shape=box,color=blue];
		150 -> 156;
	151 [label="Ха ! О, я тут сиджу й сміюся, бо дурепа. Так, припускаю, що ви називаєте їх візочками, бо вони ж насправді возять. Ото дурненька.",shape=box,color=blue];
		151 -> 155;
	148 [label="Він спеціалізувався на криптографії. І його роботи в тутешніх архівах, у лабораторіях.",shape=box,color=red];
		148 -> 154;
	861 [label="Check /Lotus/Scripts/1999/DialogueScriptNodes.lua:IsSyndicateRank",color=orange];
		861 -> 152 [label=true,color=green];
		861 -> 153 [label=false,color=brown];
	155 [label="Та я взагалі не сумую за тим, як мала себе штовхати. Гадаю, що й Ліон теж. Яку ж п’янку свободу дає політ !",shape=box,color=blue];
		155 -> 160;
		155 -> 161;
		155 -> 162;
	156 [label="Update boolean MarieInvalid",color=orange];
		156 -> 163;
	154 [label="З якихось причин, невідомих мені, його перетворили на цефалона й дали власну оболонку некралойда.",shape=box,color=red];
		154 -> 159;
	152 [label="Вона змирилася з його відсутністю. Вони помирилися одне з одним. Але цього досягти було дуже складно.",shape=box,color=red];
		152 -> 157;
	153 [label="Вона не змирилася з його відсутністю. Вони ладні одне одному горлянки перегризти.",shape=box,color=red];
		153 -> 158;
	160 [label="Я намагаюся думати про несправності наших тіл як про те, що змінює нас. Так, вони в дечому нас обмежують, але водночас можуть дати силу, якої бракуватиме іншим.",shape=box,color=red];
		160 -> 167;
	161 [label="Ти ніколи не вважала свій стан проблемою?",shape=box,color=red];
		161 -> 168;
	162 [label="Ти знала, що протофреймська сироватка зробить із тобою?",shape=box,color=red];
		162 -> 169;
	163 [label="Chat ends.",color=orange];
	159 [label="Не всіх робили цефалонами в покарання. Але на Деймосі все пішло… м'яко кажучи, шкереберть. Його сильно пошкодило.",shape=box,color=red];
		159 -> 166;
	157 [label="Знати, що він десь досі там, займається чимось. І навіть слова не сказав їй, листа не написав?..",shape=box,color=red];
		157 -> 164;
	158 [label="Знати, що він десь досі там, займається чимось. І навіть слова не сказав їй, листа не написав?..",shape=box,color=red];
		158 -> 165;
	167 [label="+5 Chemistry",color=orange];
		167 -> 173;
	168 [label="Ніколи не бачила сенсу скаржитися. Знаєш, насправді мені дуже подобається можливість діставати що-небудь із високих полиць, не прохаючи помочі.",shape=box,color=blue];
		168 -> 174;
	169 [label="Oui, le Cardinal розповів нам із Ліоном про все, що зробить сироватка… як вона змінить наші тіла. Ми знали чого чекати.",shape=box,color=blue];
		169 -> 175;
	166 [label="+5 Chemistry",color=orange];
		166 -> 172;
	164 [label="Навіть уявити не можу, як боляче це було б для неї. Для них.",shape=box,color=red];
		164 -> 170;
	165 [label="Це зруйнувало б ту крихітну можливість примирення, яке могло би бути.",shape=box,color=red];
		165 -> 171;
	173 [label="Update boolean MarieSecretPower",color=orange];
		173 -> 179;
	174 [label="Ce qui est fait est fait. Я не сміла молитися Солу про диво, коли так багато стражденних було навколо, коли в стількох була набагато більша потреба. Світочі й так уже багато мені дали.",shape=box,color=blue];
		174 -> 180;
	175 [label="Як і все інше, я прийняла свою дозу з радістю, а Ліон… ой, боюся, що я зраджу його, якщо розповім… а я не повинна.",shape=box,color=blue];
		175 -> 181;
		175 -> 182;
	172 [label="Pauvre petit…",shape=box,color=blue];
		172 -> 178;
	170 [label="Та я бачу хід думок, що призвів до рішення захистити їх від болю, який спричинив le Cardinal своїм вимушеним відбуттям…",shape=box,color=blue];
		170 -> 176;
	171 [label="+10 Chemistry",color=orange];
		171 -> 177;
	179 [label="Oui ! Ти розумієш. Я пізнавала світ з іншої перспективи. Мої руки були дужчими. Я набагато терплячіша. Я знаю, як і коли й для чого насолоджуватися миттю.",shape=box,color=blue];
		179 -> 190;
	180 [label="Маю йти. Дуже дякую за вельми розважальну бесіду. ",shape=box,color=blue];
		180 -> 191;
	181 [label="Усе гаразд. Не потрібно мені говорити більше, аніж тобі прийнятно.",shape=box,color=red];
		181 -> 192;
	182 [label="Прошу, продовжуй. Мені дуже складно пробитися його на розмову.",shape=box,color=red];
		182 -> 193;
	178 [label="Тож його перенесли до головного некралойда (єдиного, який лишився) і… ну? Складно пояснити.",shape=box,color=red];
		178 -> 187;
		178 -> 188;
		178 -> 189;
	176 [label="Я вважаю, що це жорстоко… безпідставно, а ти? Вони могли вважати його мертвим. Або ще гірше ! А ми, живемо тут, comme des rats d'égout ?",shape=box,color=blue];
		176 -> 183;
		176 -> 184;
		176 -> 185;
	177 [label="Oui… Логіка зрозуміла. Я би попрацювала над зціленням стосунків. Якщо можеш, то чом би й ні, правда ж? Видається, це єдина надія для будь-кого з нас вибратися звідси. ",shape=box,color=blue];
		177 -> 186;
	190 [label="Як я вже й досягла свого призначення, то насолоджуватимуся ним. Ніякої метушні комашки з мільярдами крихітних лапок.",shape=box,color=blue];
		190 -> 202;
	191 [label="Chat ends.",color=orange];
	192 [label="+5 Chemistry",color=orange];
		192 -> 203;
	193 [label="+5 Chemistry",color=orange];
		193 -> 204;
	187 [label="Знаєш, мені б дуже хотілося полагодити його. Повернути справжнього Отака.",shape=box,color=red];
		187 -> 199;
	188 [label="Він змушує мене всміхатися. Він кумедний, але іноді приховує щось трагічне, свою поламаність.",shape=box,color=red];
		188 -> 200;
	189 [label="На жаль, його неможливо полагодити. І ще він доволі сильно дратує. ",shape=box,color=red];
		189 -> 201;
	183 [label="Саме так. Хотілося б мені, щоб можна було щось удіяти.",shape=box,color=red];
		183 -> 194;
	184 [label="Це не зовсім я маю приймати подібне рішення.",shape=box,color=red];
		184 -> 195;
	185 [label="Насправді, у мене є подруга, яка обожнює пацюків. Гадаю, вони дуже милі.",shape=box,color=red];
		185 -> 196;
