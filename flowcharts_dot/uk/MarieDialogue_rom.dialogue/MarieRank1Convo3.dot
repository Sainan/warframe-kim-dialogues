digraph {
	"MarieRank1Convo3 begins." [color=orange];
		"MarieRank1Convo3 begins." -> j691837855;
	j691837855 [label="Il y a un crâne volant ! Keksekça ?! Тут летючий говіркий череп, а всі собі займаються своїми справами, ніби нічого такого не відбувається. Мені треба хтось для підтвердження, що існування цієї штуки нормальне.",shape=box,color=blue];
		j691837855 -> j1212032951;
		j691837855 -> j2370206058;
		j691837855 -> j1478915251;
	j1212032951 [label="Та це Некралойд. Чи то пак, некралойд. Усе складно.",shape=box,color=red];
		j1212032951 -> j3789718044;
	j2370206058 [label="Це некралойд. Він цефалон. Він тебе не скривдить.",shape=box,color=red];
		j2370206058 -> j233776089;
	j1478915251 [label="[Завершити розмову]",shape=box,color=red];
		j1478915251 -> "Chat ends.";
	j3789718044 [label="Pardon, то це ім’я чи сутність ?",shape=box,color=blue];
		j3789718044 -> j3498177929;
		j3789718044 -> j646953353;
	j233776089 [label="Та я не вважаю його загрозою ! Він не лякає мене.",shape=box,color=blue];
		j233776089 -> j2756434815;
	"Chat ends." [color=orange];
	j3498177929 [label="Я… насправді не знаю.",shape=box,color=red];
		j3498177929 -> j2762274630;
	j646953353 [label="Так.",shape=box,color=red];
		j646953353 -> j4240138780;
	j2756434815 [label="Справді, він ідеально чарівний, однак дуже непохитний в розмові. Геть не схожий на свого живого протеже. Але з огляду на характер мого улюбленого супутника в подорожах — мене це не надто турбує.",shape=box,color=blue];
		j2756434815 -> j1697777058;
	j2762274630 [label="По-перше, хто придумав цих «некралойдів» ? Чого вони так називаються і для чого вони ?",shape=box,color=blue];
		j2762274630 -> j1412664876;
		j2762274630 -> j4079646564;
	j4240138780 [label="Я… не розумію. А яка роль Лойда тут ?",shape=box,color=blue];
		j4240138780 -> j2762274630;
	j1697777058 [label="Ні, те, що може вважатися тобі ґротескним у його зовнішності, мене абсолютно не турбує. Запевняю тебе.",shape=box,color=blue];
		j1697777058 -> j1684931310;
		j1697777058 -> j2523842647;
	j1412664876 [label="Твій Cardinal Dimanche. Ентраті.",shape=box,color=red];
		j1412664876 -> j1973664516;
	j4079646564 [label="Ентраті зробив. Але сутність того, ким вони є (цефалонами), розробили орокіни.",shape=box,color=red];
		j4079646564 -> j1973664516;
	j1684931310 [label="Мене дивує, що тобі не гидко від черепа.",shape=box,color=red];
		j1684931310 -> j3063585327;
	j2523842647 [label="Маю визнати, що без контексту він може бути дивним. Але що саме тебе засмучує?",shape=box,color=red];
		j2523842647 -> j1686263234;
	j1973664516 [label="Excusez-moi, ти маєш на увазі, що le Cardinal скопіював свого супутника й зробив із нього летючого черепа-служку, і ще й назву таку дав ?",shape=box,color=blue];
		j1973664516 -> j1091603775;
	j3063585327 [label="Ти мене мало знаєш, і це не твоя провина. Я чимало часу провела, доглядаючи за мерцями та місцями їхнього спочину. ",shape=box,color=blue];
		j3063585327 -> j3257301266;
	j1686263234 [label="Мені стало цікаво, чого на спині є ще одне обличчя, яке нагадує дитячі каракулі.",shape=box,color=blue];
		j1686263234 -> j570396880;
	j1091603775 [label="А чого їх тоді більше нема, цих некралойдів ?",shape=box,color=blue];
		j1091603775 -> j15532211;
		j1091603775 -> j1094357485;
		j1091603775 -> j4087834850;
	j3257301266 [label="Дуже багато часу провела з ними поруч. Вони цілими днями вислуховували мої скарги.",shape=box,color=blue];
		j3257301266 -> j4063127048;
	j570396880 [label="Я спитала монсеньйора Некралойда і монсеньйора Лойда. Ніхто з них не захотів про це говорити, лише назвали одне ім’я. Отак. І вони вимовляли його з великим сумом у голосі.",shape=box,color=blue];
		j570396880 -> j2689985745;
	j15532211 [label="Можливо, він зрозумів, як моторошно робити собі цифрову копію свого коханця.",shape=box,color=red];
		j15532211 -> j3433654439;
	j1094357485 [label="Може, він хотів створити лише одного.",shape=box,color=red];
		j1094357485 -> j3491006978;
	j4087834850 [label="Я не знаю. Може, йому не було коли зробити більше?",shape=box,color=red];
		j4087834850 -> j2959222357;
	j4063127048 [label="Boolean MarieGraveyard1 is now true.",color=orange];
		j4063127048 -> j1060002923;
		j4063127048 -> j3891007647;
	j2689985745 [label="Тож я тут, балакаю з тобою, сподіваючись, що ти зможеш мені допомогти.",shape=box,color=blue];
		j2689985745 -> j2229210185;
		j2689985745 -> j2136183450;
	j3433654439 [label="Ou bien, на знак любові й поваги. Він уважав, що ця дивна лабораторія не зможе працювати без монсеньйора Лойда.",shape=box,color=blue];
		j3433654439 -> j114472356;
		j3433654439 -> j634398849;
	j3491006978 [label="+5 Chemistry",color=orange];
		j3491006978 -> j3119860594;
	j2959222357 [label="Уяви собі, цілий виводок летючих черепів. Бездоганно дієвих !",shape=box,color=blue];
		j2959222357 -> j634398849;
		j2959222357 -> j1669345567;
	j1060002923 [label="Тобі подобається доглядати за цвинтарями?",shape=box,color=red];
		j1060002923 -> j246389169;
	j3891007647 [label="А вони хоч раз відповіли?",shape=box,color=red];
		j3891007647 -> j350726223;
	j2229210185 [label="Ти хочеш дізнатися про Отака? Чи про те, чому не можеш говорити з ним?",shape=box,color=red];
		j2229210185 -> j1606280197;
	j2136183450 [label="Отака важко пояснити…",shape=box,color=red];
		j2136183450 -> j3287217001;
	j114472356 [label="Як на мене, то це дуже дивний романтичний учинок, але навряд чи мені про це казати.",shape=box,color=red];
		j114472356 -> j1930120442;
	j634398849 [label="Чесно, я б геть не проти, якби некралойд дзижчав довкола моєї домівки.",shape=box,color=red];
		j634398849 -> j3194269432;
	j3119860594 [label="По-своєму трагічно й прекрасно, non? На знак любові й поваги. Він уважав, що ця дивна лабораторія не зможе працювати без монсеньйора Лойда.",shape=box,color=blue];
		j3119860594 -> j3854601297;
		j3119860594 -> j114472356;
	j1669345567 [label="Чесно кажучи, мене радує, що він тут такий один. Не думаю, що світ готовий до більшого.",shape=box,color=red];
		j1669345567 -> j2026001343;
	j246389169 [label="Так, а ще за мавзолеями й криптами. Але визнаю, що на відкритому повітрі мені ліпше, однак для мого крісла вони були важкопрохідними. Як і сходи, на жаль.",shape=box,color=blue];
		j246389169 -> j2427967412;
	j350726223 [label="Ха ! Ні, на щастя. Не до тих пір, допоки твій «некралойд» із такою похмурою пикою заговорив зі мною. Якщо розмови з мертвими належать до Благ Світочів, то я про це не знаю.",shape=box,color=blue];
		j350726223 -> j1453164809;
	j1606280197 [label="Гадаю, що з часом захочу знати обидві відповіді. Але дозволю тобі вибрати з чого починати. Я не знаю, що з них важливіше, après tout.",shape=box,color=blue];
		j1606280197 -> j3287217001;
	j3287217001 [label="Check boolean LoidFamilyComplete",color=orange];
		j3287217001 -> j3141462974 [label=true,color=green];
		j3287217001 -> j3141462974 [label=false,color=brown];
		j3287217001 -> j44969998 [label=false,color=brown];
	j1930120442 [label="От тепер я заінтригована, але видається мені, що це історія для іншого разу. Cela dit…",shape=box,color=blue];
		j1930120442 -> j1686263234;
	j3194269432 [label="Я цілковито впевнена, що в такому випадку тобі гнітюче треба компанія або організація роботи, або й те й інше. Але ця розмова для іншого разу.",shape=box,color=blue];
		j3194269432 -> j1686263234;
	j3854601297 [label="Гадаю, що це більше пов’язано з потребою втримати це місце в порядку, аніж щось інше.",shape=box,color=red];
		j3854601297 -> j767987008;
	j2026001343 [label="Точно ! Як і я. Що веде до мого наступного запитання.",shape=box,color=blue];
		j2026001343 -> j1686263234;
	j2427967412 [label="Boolean MarieSerum1 is now true.",color=orange];
		j2427967412 -> j4343001;
		j2427967412 -> j3272017174;
	j1453164809 [label="Ні, чути духів та інші голоси — це більше компетенція мого любого Ліона. Хоча й цікаво, чи не переслідує монсеньйора Некралойда хтось… зважаючи на ті дитячі каракулі на потилиці.",shape=box,color=blue];
		j1453164809 -> j1255949560;
	j3141462974 [label="Отак колись був архімедівцем, орокінським ученим і академіком. А подальша історія не з тих, що зі щасливим завершенням.",shape=box,color=red];
		j3141462974 -> j4187921752;
	j44969998 [label="Ну… якщо коротко, то нагорі частина родини Ентраті. І вони не дуже… тобто зовсім не знають, що ми тут унизу.",shape=box,color=red];
		j44969998 -> j243509226;
	j767987008 [label="І може бути саме навіть так. Летючому створінню чимало бракує raison d'être і nuance справжнього монсеньйора Лойда. Cela dit…",shape=box,color=blue];
		j767987008 -> j1686263234;
	j4343001 [label="Мені ніяк не вдавалося зрозуміти, чи доречно питати про вплив сироватки на твої ноги…",shape=box,color=red];
		j4343001 -> j3815922682;
	j3272017174 [label="Для твого крісла?",shape=box,color=red];
		j3272017174 -> j1374004979;
	j1255949560 [label="До речі, саме про це я й першочергово збиралася поговорити, якщо ти не проти.",shape=box,color=blue];
		j1255949560 -> j570396880;
	j4187921752 [label="Boolean MarieOtak1 is now true.",color=orange];
		j4187921752 -> j2330645058;
	j243509226 [label="Boolean MarieFamily1 is now true.",color=orange];
		j243509226 -> j3761087629;
	j3815922682 [label="+10 Chemistry",color=orange];
		j3815922682 -> j1203488692;
	j1374004979 [label="Я не знаю як це у вас називають. Un fauteuil roulant або… напевно, тим терміном, який я терпіти не можу. Un fauteuil pour invalide.",shape=box,color=blue];
		j1374004979 -> j4022785231;
	j2330645058 [label="Par les Luminaires… прошу, продовжуй.",shape=box,color=blue];
		j2330645058 -> j3858646702;
	j3761087629 [label="Par les Luminaires… Тобто ти маєш на увазі, що ми тут усі втаємничено сидимо ?! Саме тому не можна покидати це місце ?! Mais pourquoi ?!",shape=box,color=blue];
		j3761087629 -> j2049982869;
	j1203488692 [label="О ! Ох ти ж бідолашне. Уявляю, як ти сидиш там на самоті й дивуєшся, чи це не le Cardinal бавився з моїми ногами ?! Non, non, non — нічого подібного.",shape=box,color=blue];
		j1203488692 -> j1778978834;
	j4022785231 [label="Ну як те, на чому ми зараз сидимо перед цими милими пристроями для спілкування. Але збоку були коліщата, як на возі, для пересування. Крісло-віз, якщо тобі так зрозуміліше.",shape=box,color=blue];
		j4022785231 -> j2707517313;
		j4022785231 -> j21667202;
	j3858646702 [label="З усіх подій стає зрозумілим, що він був генієм і тим, хто опанував використання кристалів аргону.",shape=box,color=red];
		j3858646702 -> j3223950270;
	j2049982869 [label="Його донька Евлерія (також відома як Матір) і її родина весь цей час піклувалися про Деймос.",shape=box,color=red];
		j2049982869 -> j2492231524;
	j1778978834 [label="Сол захотів надати моєму життю незручностей, наділивши кволими ногами ще в утробі матері. Я нездатна була ходити. ",shape=box,color=blue];
		j1778978834 -> j1133046126;
	j2707517313 [label="У тебе була інвалідність до того, як ти стала протофреймом?",shape=box,color=red];
		j2707517313 -> j1659247814;
	j21667202 [label="Ми звемо це візочками. Можеш вірити або ні.",shape=box,color=red];
		j21667202 -> j4178230988;
	j3223950270 [label="А вони походять із Порожнечі. І саме завдяки їм ми можемо створювати чимало ворфреймів та потужну зброю.",shape=box,color=red];
		j3223950270 -> j1042047608;
	j2492231524 [label="Наглядали за цим місцем і за серцем, яке перекачує енергію Порожнечі в Материнську систему, що дозволяє нам усім… бути корисними, насправді. І це все аж з моменту зникнення Ентраті.",shape=box,color=red];
		j2492231524 -> j3032412102;
	j1133046126 [label="Але вони були таки просто незручностями.",shape=box,color=blue];
		j1133046126 -> j1073262486;
	j1659247814 [label="Non. Зовсім навіть ні.",shape=box,color=blue];
		j1659247814 -> j3350176257;
	j4178230988 [label="Ха ! О, я тут сиджу й сміюся, бо дурепа. Так, припускаю, що ви називаєте їх візочками, бо вони ж насправді возять. Ото дурненька.",shape=box,color=blue];
		j4178230988 -> j1073262486;
	j1042047608 [label="Він спеціалізувався на криптографії. І його роботи в тутешніх архівах, у лабораторіях.",shape=box,color=red];
		j1042047608 -> j740356449;
	j3032412102 [label="Check /Lotus/Scripts/1999/DialogueScriptNodes.lua:IsSyndicateRank(syndicate=EntratiSyndicate, syndicateRank=5)",color=orange];
		j3032412102 -> j2114331738 [label=true,color=green];
		j3032412102 -> j2362593335 [label=false,color=brown];
	j1073262486 [label="Та я взагалі не сумую за тим, як мала себе штовхати. Гадаю, що й Ліон теж. Яку ж п’янку свободу дає політ !",shape=box,color=blue];
		j1073262486 -> j2862677413;
		j1073262486 -> j1297360034;
		j1073262486 -> j2976540612;
	j3350176257 [label="Boolean MarieInvalid is now true.",color=orange];
		j3350176257 -> "Chat ends.";
	j740356449 [label="З якихось причин, невідомих мені, його перетворили на цефалона й дали власну оболонку некралойда.",shape=box,color=red];
		j740356449 -> j3740218572;
	j2114331738 [label="Вона змирилася з його відсутністю. Вони помирилися одне з одним. Але цього досягти було дуже складно.",shape=box,color=red];
		j2114331738 -> j4059566095;
	j2362593335 [label="Check boolean MarieSyndicateMaxRank",color=orange];
		j2362593335 -> j2114331738 [label=true,color=green];
		j2362593335 -> j3177422711 [label=false,color=brown];
	j2862677413 [label="Я намагаюся думати про несправності наших тіл як про те, що змінює нас. Так, вони в дечому нас обмежують, але водночас можуть дати силу, якої бракуватиме іншим.",shape=box,color=red];
		j2862677413 -> j423654526;
	j1297360034 [label="Ти ніколи не вважала свій стан проблемою?",shape=box,color=red];
		j1297360034 -> j4040516049;
	j2976540612 [label="Ти знала, що протофреймська сироватка зробить із тобою?",shape=box,color=red];
		j2976540612 -> j3108077868;
	j3740218572 [label="Не всіх робили цефалонами в покарання. Але на Деймосі все пішло… м'яко кажучи, шкереберть. Його сильно пошкодило.",shape=box,color=red];
		j3740218572 -> j4132858160;
	j4059566095 [label="Знати, що він десь досі там, займається чимось. І навіть слова не сказав їй, листа не написав?..",shape=box,color=red];
		j4059566095 -> j1038126609;
	j3177422711 [label="Вона не змирилася з його відсутністю. Вони ладні одне одному горлянки перегризти.",shape=box,color=red];
		j3177422711 -> j1089621139;
	j423654526 [label="+5 Chemistry",color=orange];
		j423654526 -> j731098691;
	j4040516049 [label="Ніколи не бачила сенсу скаржитися. Знаєш, насправді мені дуже подобається можливість діставати що-небудь із високих полиць, не прохаючи помочі.",shape=box,color=blue];
		j4040516049 -> j2842276595;
	j3108077868 [label="Oui, le Cardinal розповів нам із Ліоном про все, що зробить сироватка… як вона змінить наші тіла. Ми знали чого чекати.",shape=box,color=blue];
		j3108077868 -> j1422273454;
	j4132858160 [label="+5 Chemistry",color=orange];
		j4132858160 -> j891832696;
	j1038126609 [label="Навіть уявити не можу, як боляче це було б для неї. Для них.",shape=box,color=red];
		j1038126609 -> j2398005413;
	j1089621139 [label="Знати, що він десь досі там, займається чимось. І навіть слова не сказав їй, листа не написав?..",shape=box,color=red];
		j1089621139 -> j3977898571;
	j731098691 [label="Boolean MarieSecretPower is now true.",color=orange];
		j731098691 -> j3292113551;
	j2842276595 [label="Ce qui est fait est fait. Я не сміла молитися Солу про диво, коли так багато стражденних було навколо, коли в стількох була набагато більша потреба. Світочі й так уже багато мені дали.",shape=box,color=blue];
		j2842276595 -> j924959860;
	j1422273454 [label="Як і все інше, я прийняла свою дозу з радістю, а Ліон… ой, боюся, що я зраджу його, якщо розповім… а я не повинна.",shape=box,color=blue];
		j1422273454 -> j1113802444;
		j1422273454 -> j1864252582;
	j891832696 [label="Pauvre petit…",shape=box,color=blue];
		j891832696 -> j2443365795;
	j2398005413 [label="Та я бачу хід думок, що призвів до рішення захистити їх від болю, який спричинив le Cardinal своїм вимушеним відбуттям…",shape=box,color=blue];
		j2398005413 -> j2796848290;
	j3977898571 [label="Це зруйнувало б ту крихітну можливість примирення, яке могло би бути.",shape=box,color=red];
		j3977898571 -> j3939513715;
	j3292113551 [label="Oui ! Ти розумієш. Я пізнавала світ з іншої перспективи. Мої руки були дужчими. Я набагато терплячіша. Я знаю, як і коли й для чого насолоджуватися миттю.",shape=box,color=blue];
		j3292113551 -> j2797700911;
	j924959860 [label="Маю йти. Дуже дякую за вельми розважальну бесіду. ",shape=box,color=blue];
		j924959860 -> "Chat ends.";
	j1113802444 [label="Усе гаразд. Не потрібно мені говорити більше, аніж тобі прийнятно.",shape=box,color=red];
		j1113802444 -> j154766205;
	j1864252582 [label="Прошу, продовжуй. Мені дуже складно пробитися його на розмову.",shape=box,color=red];
		j1864252582 -> j3042314389;
	j2443365795 [label="Тож його перенесли до головного некралойда (єдиного, який лишився) і… ну? Складно пояснити.",shape=box,color=red];
		j2443365795 -> j863375830;
		j2443365795 -> j64547360;
		j2443365795 -> j4193888467;
	j2796848290 [label="Я вважаю, що це жорстоко… безпідставно, а ти? Вони могли вважати його мертвим. Або ще гірше ! А ми, живемо тут, comme des rats d'égout ?",shape=box,color=blue];
		j2796848290 -> j1989214690;
		j2796848290 -> j2212473239;
		j2796848290 -> j556492035;
	j3939513715 [label="+10 Chemistry",color=orange];
		j3939513715 -> j2887133012;
	j2797700911 [label="Як я вже й досягла свого призначення, то насолоджуватимуся ним. Ніякої метушні комашки з мільярдами крихітних лапок.",shape=box,color=blue];
		j2797700911 -> j2196619018;
	j154766205 [label="+5 Chemistry",color=orange];
		j154766205 -> j3934551879;
	j3042314389 [label="+5 Chemistry",color=orange];
		j3042314389 -> j3594701998;
	j863375830 [label="Знаєш, мені б дуже хотілося полагодити його. Повернути справжнього Отака.",shape=box,color=red];
		j863375830 -> j3171578424;
	j64547360 [label="Він змушує мене всміхатися. Він кумедний, але іноді приховує щось трагічне, свою поламаність.",shape=box,color=red];
		j64547360 -> j3684964677;
	j4193888467 [label="На жаль, його неможливо полагодити. І ще він доволі сильно дратує. ",shape=box,color=red];
		j4193888467 -> j532137262;
	j1989214690 [label="Саме так. Хотілося б мені, щоб можна було щось удіяти.",shape=box,color=red];
		j1989214690 -> j2681428692;
	j2212473239 [label="Це не зовсім я маю приймати подібне рішення.",shape=box,color=red];
		j2212473239 -> j4030997681;
	j556492035 [label="Насправді, у мене є подруга, яка обожнює пацюків. Гадаю, вони дуже милі.",shape=box,color=red];
		j556492035 -> j567913360;
	j2887133012 [label="Oui… Логіка зрозуміла. Я би попрацювала над зціленням стосунків. Якщо можеш, то чом би й ні, правда ж? Видається, це єдина надія для будь-кого з нас вибратися звідси. ",shape=box,color=blue];
		j2887133012 -> j86733433;
	j2196619018 [label="Просто мені дуже хотілося б, щоби мій дорогий Ліон дивився на світ як ти. Усі б незручності могли би бути таємною силою, геть як говориш ти.",shape=box,color=blue];
		j2196619018 -> j1553099683;
	j3934551879 [label="Мандрівниче, я вдячна тобі за доброту. Я лишу все як є, щоб не переступати межі свого обов’язку, котрого намагаюся спихнути на тебе… ",shape=box,color=blue];
		j3934551879 -> j3130208497;
	j3594701998 [label="Мандрівниче, не тільки ти. Ліон для мене як рідний, однак досі іноді я розмірковую чи знаю про нього щось більше, аніж статуї святих у катедральному соборі.",shape=box,color=blue];
		j3594701998 -> j873274315;
