		2985 -> 2989 [label="false",color=purple];
	2988 [label="Це точно ? Якщо я можу не зважати на свої différences з Роутом, то й ти безумовно, non ?",shape=box,color=blue];
		2988 -> 2995;
		2988 -> 2996;
	2993 [label="Знаєш, певно, твоя правда. Не варто було думати, що ти погодишся. Не дарма було страшно запитувати.",shape=box,color=red];
		2993 -> 2985;
	2994 [label="Ні. Має бути інший шлях. Я не проситиму його допомоги в цьому.",shape=box,color=red];
		2994 -> 2988;
	2990 [label="Він допоможе нам у цій справі ?",shape=box,color=blue];
		2990 -> 2999;
	2991 [label="Він допоможе нам у цій справі ?",shape=box,color=blue];
		2991 -> 3000;
