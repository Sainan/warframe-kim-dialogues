	2968 [label="Check boolean MarieDating",color=orange];
		2968 -> 2975 [label=true,color=green];
		2968 -> 2974 [label=false,color=brown];
	2971 [label="Ми повинні розрубати цей вузол. Purgatoire, в якому ми застрягли, не повинно існувати. Воно дуже болісне без причин на то.",shape=box,color=blue];
		2971 -> 2980;
