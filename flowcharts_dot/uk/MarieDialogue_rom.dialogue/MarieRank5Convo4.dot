	3051 [label="Update boolean MarieRank5Convo4Complete",color=orange];
		3051 -> 3064;
	3053 [label="Merci, merci, merci, mon cœur !",shape=box,color=blue];
		3053 -> 3065;
	3052 [label="Merci, merci, merci !",shape=box,color=blue];
		3052 -> 3065;
	3054 [label="Що ж ! Коли прийде час, то я буду готова й чекатиму ! А доти, merci, mon cœur.",shape=box,color=blue];
		3054 -> 3066;
	3055 [label="Що ж ! Коли прийде час, то я буду готова й чекатиму ! А доти, merci.",shape=box,color=blue];
		3055 -> 3066;
	3049 [label="Я б ніколи не могла сказати, що якщо диявол прихильний до тебе, то він міг би дослухатися, коли інших ігнорує повністю.",shape=box,color=blue];
		3049 -> 3062;
	3050 [label="Я просто рада твоєму щастю. І якщо дияволу є куди витрачати… свою енергію… то нам всім на ліпше, non ?",shape=box,color=blue];
		3050 -> 3063;
	3045 [label="Усі в його житті намагалися зробити з нього чудовисько. Але не я. Припускаю, це вперше.",shape=box,color=red];
		3045 -> 3058;
	3044 [label="У ньому є чимало того, що він просто не знає як показати. Це не зовсім як броня, але він не довіряє тим, хто не хоче скривдити його.",shape=box,color=red];
		3044 -> 3057;
	3047 [label="Його… серце розбивалося кілька разів за ці роки. Тому й він відростив гострі шпичаки довкола себе.",shape=box,color=red];
		3047 -> 3060;
	3048 [label="Здається, я можу розуміти його, кількість прожитих ним років. Мені довелося бачити стільки ж смертей, як і йому.",shape=box,color=red];
		3048 -> 3061;
	3043 [label="Він лише завжди намагався зробити те, що правильно. Звісно, може й неправильно, але намагався врятувати Материнську систему від орокінів.",shape=box,color=red];
		3043 -> 3056;
	3046 [label="Я насолоджуюся його почуттям гумору. Він дуже розумний, якщо звикнути до великого его.",shape=box,color=red];
		3046 -> 3059;
	3064 [label="Chat ends.",color=orange];
	3065 [label="Що ж ! Коли прийде час, то я буду готова й чекатиму ! А доти — бувай !",shape=box,color=blue];
		3065 -> 3075;
	3066 [label="Update boolean MarieFamilySuccess",color=orange];
		3066 -> 3076;
	3062 [label="І ніколи під час особистих моментів. Non. Jamais.",shape=box,color=blue];
		3062 -> 3071;
		3062 -> 3072;
	3063 [label="Для нас усіх навіть ліпше, якщо ти будеш наче un ange на плечі, щоб заспокоювати його.",shape=box,color=blue];
		3063 -> 3073;
		3063 -> 3074;
	3058 [label="І припускаю, що я на верхівці списку перших, non ? Напевно… варто зважити, чому він такий як є. Осуд душі не рятує.",shape=box,color=blue];
		3058 -> 3067;
	3057 [label="Завжди є біль, який ми приховуємо від інших. Щось прагнемо приховати Припускаю, мені варто намагатися добрішою до нього бути, якщо сказане тобою — правда.",shape=box,color=blue];
		3057 -> 3067;
	3060 [label="Навіть уявити не можу кількість любові та втрат упродовж таких довгих років. Це видається таким нереальним, навіть попри все бачене досі.",shape=box,color=blue];
		3060 -> 3069;
	3061 [label="Коли балакаю з ним, то іноді навіть забуваю, скільки століть він живе. Це видається таким нереальним, навіть попри бачене досі.",shape=box,color=blue];
		3061 -> 3070;
	3056 [label="Завжди є певні… нюанси, oui ? Завжди є причина вчинити так чи інак. Припускаю, мені варто намагатися добрішою до нього бути, якщо сказане тобою — правда.",shape=box,color=blue];
		3056 -> 3067;
