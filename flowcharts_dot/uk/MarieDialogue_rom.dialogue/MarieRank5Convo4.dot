	2972 [label="Update boolean MarieWillDate",color=orange];
		2972 -> 2973;
	2977 [label="Bonjour, mon cœur ! Я тут поміркувала… і дуже не хочеться цього визнавати. Мені неприємно про це говорити.",shape=box,color=blue];
		2977 -> 2982;
	2976 [label="Bonjour ! Я тут поміркувала… І дуже не хочеться цього визнавати. Мені неприємно про це говорити.",shape=box,color=blue];
		2976 -> 2982;
	2978 [label="Bonjour, mon coeur ! А що саме ти боїшся, що мені не сподобається ?",shape=box,color=blue];
		2978 -> 2983;
	2979 [label="Bonjour ! А що саме ти боїшся, що мені не сподобається ?",shape=box,color=blue];
		2979 -> 2983;
	2975 [label="Bonjour, bonjour, mon cœur ! Я тут поміркувала… і дуже не хочеться цього визнавати. Мені неприємно про це говорити.",shape=box,color=blue];
		2975 -> 2981;
	2974 [label="Bonjour… Я тут поміркувала… і дуже не хочеться цього визнавати. Мені неприємно про це говорити.",shape=box,color=blue];
		2974 -> 2981;
	2980 [label="Але я відчуваю, що нам потрібен… якийсь бастіон, non ? Є ідеї ?",shape=box,color=blue];
		2980 -> 2984;
		2980 -> 2983;
	2982 [label="Але я думаю… я думаю… пробач мені, Соле… допомога диявола — саме те, чого бракує. Не думаю, що інакше монсеньйор Лойд послухає нас.",shape=box,color=blue];
		2982 -> 2986;
	2983 [label="Думаю, нам знадобиться допомога Роута, щоб вмовити Лойда поговорити з родиною Ентраті. Не думаю, що він якимось чином погодиться без цього. Без гарантій, що він і родина будуть під захистом.",shape=box,color=red];
		2983 -> 2987;
	2981 [label="Усе ж таки ти маєш рацію. Диявол може бути тим шматком, якого бракує. О, як же мене гнітить навіть друкування цих слів ! ",shape=box,color=blue];
		2981 -> 2985;
	2984 [label="Нема ніяких ідей, які б не потребували використання допомоги з моторошних джерел. Тих, які можуть призвести до гірших наслідків. Тих, які звуться Роут.",shape=box,color=red];
		2984 -> 2988;
	2986 [label="Диявол могутній і зможе стати грубою силою, якщо щось піде не так, non ?",shape=box,color=blue];
		2986 -> 2993;
		2986 -> 2994;
	2987 [label="Гірко визнавати це… але є істина в твоїх словах… Соле, пробач мене, грішну.",shape=box,color=blue];
		2987 -> 2985;
