	2959 [label="Chat ends.",color=orange];
	2961 [label="S'il te plaît, припини це. Невдовзі почну сміятися з його жартів. А тоді вже точно мені кінець !",shape=box,color=blue];
		2961 -> 2967;
	2964 [label="Ти більше не думала про те, як переконати Лойда поговорити з родиною нагорі?",shape=box,color=red];
		2964 -> 2969;
	2965 [label="Мені тут випала нагода поміркувати як переконати Лойда піти до тих, хто нагорі, і нарешті поговорити з усією родиною… Є ідея, але вона тобі не сподобається.",shape=box,color=red];
		2965 -> 2970;
	2962 [label="Марі, ти досі не проти… спробувати переконати Лойда поспілкуватися з «сусідами зверху»? Ми не договорили про це.",shape=box,color=red];
		2962 -> 2968;
	2963 [label="Стосовно того, щоб звести Лойда й родину Ентраті до розмови… Ти не передумала стосовно залучення Роута?",shape=box,color=red];
		2963 -> 2968;
	2966 [label="Я думала про те, як монсеньйор Лойд боїться говорити з родиною le Cardinal.",shape=box,color=blue];
		2966 -> 2971;
