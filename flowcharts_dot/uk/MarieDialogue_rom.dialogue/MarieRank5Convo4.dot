		3016 -> 3025;
	3017 [label="Принаймні він допоможе. А я переконаюся, що він насправді не виконає своїх погроз.",shape=box,color=red];
		3017 -> 3026;
	3011 [label="Думаю, що в тебе є особливий спосіб переконати його, якщо всі інші зазнали невдачі, non ?",shape=box,color=blue];
		3011 -> 3021;
		3011 -> 3022;
	3010 [label="Бажаю тобі всього найліпшого. Диявол буває занадто упертим навіть у найліпші часи. Іноді таке враження, що йому до вподоби бути по інший бік у суперечці !",shape=box,color=blue];
		3010 -> 3019;
		3010 -> 3020;
	3012 [label="Oui. Думаю, що в тебе є особливий спосіб переконати його, якщо всі інші зазнали невдачі, non ?",shape=box,color=blue];
		3012 -> 3021;
		3012 -> 3022;
	3013 [label="Oui, безперечно. Диявол буває занадто упертим навіть у найліпші часи. Іноді таке враження, що йому до вподоби бути по інший бік у суперечці !",shape=box,color=blue];
		3013 -> 3019;
		3013 -> 3020;
	3018 [label="Update boolean MarieFamilyFail",color=orange];
		3018 -> 3027;
	3023 [label="+20 Chemistry",color=orange];
		3023 -> 3032;
	3024 [label="Я дуже недооцінила нашого диявола…",shape=box,color=blue];
		3024 -> 3033;
	3025 [label="Oui, сподіваюся, що твоя правда.",shape=box,color=blue];
		3025 -> 3034;
	3026 [label="Oui. Щонайменше ми тут, щоб не дати йому потурати своїм… низьким інстинктам.",shape=box,color=blue];
		3026 -> 3034;
	3021 [label="Марі, на що ти натякаєш?",shape=box,color=red];
		3021 -> 3030;
	3022 [label="Не хотілося б використовувати мої стосунки з ним як важіль для перемовин.",shape=box,color=red];
		3022 -> 3031;
	3019 [label="Так, але думаю, що більша частина того — лише для створення образу.",shape=box,color=red];
		3019 -> 3028;
	3020 [label="Знаєш, як би дивно це не звучало, але мені це навіть подобається. Ми поладнаємо.",shape=box,color=red];
		3020 -> 3029;
	3027 [label="Update boolean MarieRank5Convo4Complete",color=orange];
		3027 -> 3035;
	3032 [label="Ото ж усе ці дияволи ! Як-то кажуть, c'est la vie !",shape=box,color=blue];
		3032 -> 3039;
	3033 [label="Я не дурепа, щоб не бачити твоє ролі в цьому всьому !",shape=box,color=blue];
