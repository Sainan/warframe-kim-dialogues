		j1155893159 -> j3016166415 [label="RoatheExecutor2",color=purple];
		j1155893159 -> j653816729 [label="false",color=purple];
	j2647290534 [label="Merci, merci, merci, mon cœur !",shape=box,color=blue];
		j2647290534 -> j1450969867;
	j3945458432 [label="Merci, merci, merci !",shape=box,color=blue];
		j3945458432 -> j1450969867;
	j884560398 [label="Що ж ! Коли прийде час, то я буду готова й чекатиму ! А доти, merci, mon cœur.",shape=box,color=blue];
		j884560398 -> j3569999725;
	j3768658948 [label="Що ж ! Коли прийде час, то я буду готова й чекатиму ! А доти, merci.",shape=box,color=blue];
		j3768658948 -> j3569999725;
	j1316882699 [label="Я б ніколи не могла сказати, що якщо диявол прихильний до тебе, то він міг би дослухатися, коли інших ігнорує повністю.",shape=box,color=blue];
		j1316882699 -> j530920009;
	j1323603920 [label="Я просто рада твоєму щастю. І якщо дияволу є куди витрачати… свою енергію… то нам всім на ліпше, non ?",shape=box,color=blue];
		j1323603920 -> j3226146149;
	j177321260 [label="Усі в його житті намагалися зробити з нього чудовисько. Але не я. Припускаю, це вперше.",shape=box,color=red];
		j177321260 -> j1717454683;
	j1580580267 [label="У ньому є чимало того, що він просто не знає як показати. Це не зовсім як броня, але він не довіряє тим, хто не хоче скривдити його.",shape=box,color=red];
		j1580580267 -> j4010225106;
	j3844601381 [label="Його… серце розбивалося кілька разів за ці роки. Тому й він відростив гострі шпичаки довкола себе.",shape=box,color=red];
		j3844601381 -> j73285141;
	j2214276191 [label="Здається, я можу розуміти його, кількість прожитих ним років. Мені довелося бачити стільки ж смертей, як і йому.",shape=box,color=red];
		j2214276191 -> j3034650531;
	j3016166415 [label="Він лише завжди намагався зробити те, що правильно. Звісно, може й неправильно, але намагався врятувати Материнську систему від орокінів.",shape=box,color=red];
		j3016166415 -> j4074441887;
	j653816729 [label="Я насолоджуюся його почуттям гумору. Він дуже розумний, якщо звикнути до великого его.",shape=box,color=red];
		j653816729 -> j687058466;
	j1450969867 [label="Що ж ! Коли прийде час, то я буду готова й чекатиму ! А доти — бувай !",shape=box,color=blue];
		j1450969867 -> j3569999725;
	j530920009 [label="І ніколи під час особистих моментів. Non. Jamais.",shape=box,color=blue];
		j530920009 -> j3496544675;
		j530920009 -> j1231288713;
	j3226146149 [label="Для нас усіх навіть ліпше, якщо ти будеш наче un ange на плечі, щоб заспокоювати його.",shape=box,color=blue];
		j3226146149 -> j3352425375;
		j3226146149 -> j3849498221;
	j1717454683 [label="І припускаю, що я на верхівці списку перших, non ? Напевно… варто зважити, чому він такий як є. Осуд душі не рятує.",shape=box,color=blue];
		j1717454683 -> j2693705836;
	j4010225106 [label="Завжди є біль, який ми приховуємо від інших. Щось прагнемо приховати Припускаю, мені варто намагатися добрішою до нього бути, якщо сказане тобою — правда.",shape=box,color=blue];
		j4010225106 -> j2693705836;
	j73285141 [label="Навіть уявити не можу кількість любові та втрат упродовж таких довгих років. Це видається таким нереальним, навіть попри все бачене досі.",shape=box,color=blue];
		j73285141 -> j3288332681;
	j3034650531 [label="Коли балакаю з ним, то іноді навіть забуваю, скільки століть він живе. Це видається таким нереальним, навіть попри бачене досі.",shape=box,color=blue];
		j3034650531 -> j2645272778;
	j4074441887 [label="Завжди є певні… нюанси, oui ? Завжди є причина вчинити так чи інак. Припускаю, мені варто намагатися добрішою до нього бути, якщо сказане тобою — правда.",shape=box,color=blue];
		j4074441887 -> j2693705836;
	j687058466 [label="Ніхто й ніколи не казав, що йому бракує дотепності.",shape=box,color=blue];
		j687058466 -> j915474847;
	j3496544675 [label="Ти здивувала мене. Це вражає. ",shape=box,color=red];
		j3496544675 -> j3831295297;
	j1231288713 [label="Раніше ця твоя сторона не була видимою.",shape=box,color=red];
		j1231288713 -> j3831295297;
	j3352425375 [label="Нічого не можу обіцяти.",shape=box,color=red];
		j3352425375 -> j452306535;
	j3849498221 [label="Хто сказав, що я намагаюся заспокоювати його?",shape=box,color=red];
		j3849498221 -> j2530572720;
	j2693705836 [label="+10 Chemistry",color=orange];
		j2693705836 -> j589062926;
	j3288332681 [label="О… oui, це може завдати значної шкоди душі ! Я розумію, чому тобі хочеться знайти когось, хто зрозуміє. Як він тебе.",shape=box,color=blue];
		j3288332681 -> j2693705836;
	j2645272778 [label="Жити так довго, бачити стільки смертей — заплатити стільки за це самому ?",shape=box,color=blue];
		j2645272778 -> j3288332681;
	j915474847 [label="+5 Chemistry",color=orange];
		j915474847 -> j589062926;
	j452306535 [label="Add 1 to Thermostat counter",color=orange];
		j452306535 -> j2380958500;
	j2530572720 [label="Add -1 to Thermostat counter",color=orange];
		j2530572720 -> j807253682;
	j589062926 [label="Я просто радію, що дияволу є з ким поговорити, що хтось може спробувати його заспокоїти. Un ange на плечі.",shape=box,color=blue];
		j589062926 -> j3849498221;
		j589062926 -> j3352425375;
	j2380958500 [label="+10 Chemistry",color=orange];
		j2380958500 -> j1142988990;
	j807253682 [label="+10 Chemistry",color=orange];
		j807253682 -> j4086403019;
	j1142988990 [label="Oui, боюся, у ньому є щось лихе, що насправді не можна зцілити. Він занадто ним упивається.",shape=box,color=blue];
		j1142988990 -> j1291234385;
	j4086403019 [label="Може й так… що таке is un ange без son diable ? Він нагадує нам усім, чого варто уникати.",shape=box,color=blue];
		j4086403019 -> j1291234385;
	j1291234385 [label="Що ж ! Якщо й коли в тебе вийде переконати диявола допомогти нам у завданні, то я буду готова й чекатиму ! Бувай !",shape=box,color=blue];
		j1291234385 -> j3569999725;
}