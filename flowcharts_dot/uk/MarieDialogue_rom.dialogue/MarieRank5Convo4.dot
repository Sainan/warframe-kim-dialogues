		j1320247306 -> j2171156302 [label="MarieFamily3b",color=purple];
		j1320247306 -> j1433970367 [label="MarieFamily3b",color=purple];
		j1320247306 -> j3998550561 [label="MarieFamilyOther",color=purple];
		j1320247306 -> j4180055673 [label="MarieFamilyOther",color=purple];
		j1320247306 -> j3483292618 [label="false",color=purple];
	j3757379902 [label="S'il te plaît, припини це. Невдовзі почну сміятися з його жартів. А тоді вже точно мені кінець !",shape=box,color=blue];
		j3757379902 -> j758933647;
	j3998550561 [label="Ти більше не думала про те, як переконати Лойда поговорити з родиною нагорі?",shape=box,color=red];
		j3998550561 -> j3487613436;
	j4180055673 [label="Мені тут випала нагода поміркувати як переконати Лойда піти до тих, хто нагорі, і нарешті поговорити з усією родиною… Є ідея, але вона тобі не сподобається.",shape=box,color=red];
		j4180055673 -> j668862974;
	j2171156302 [label="Марі, ти досі не проти… спробувати переконати Лойда поспілкуватися з «сусідами зверху»? Ми не договорили про це.",shape=box,color=red];
		j2171156302 -> j374072022;
	j1433970367 [label="Стосовно того, щоб звести Лойда й родину Ентраті до розмови… Ти не передумала стосовно залучення Роута?",shape=box,color=red];
		j1433970367 -> j374072022;
	j3483292618 [label="Я думала про те, як монсеньйор Лойд боїться говорити з родиною le Cardinal.",shape=box,color=blue];
		j3483292618 -> j2747748119;
	j758933647 [label="Check boolean MarieNoDate",color=orange];
		j758933647 -> "Chat ends." [label=true,color=green];
		j758933647 -> j2768654365 [label=false,color=brown];
	j3487613436 [label="Check boolean MarieDating",color=orange];
		j3487613436 -> j4251274850 [label=true,color=green];
		j3487613436 -> j4042417534 [label=false,color=brown];
	j668862974 [label="Check boolean MarieDating",color=orange];
		j668862974 -> j2142158815 [label=true,color=green];
		j668862974 -> j3177818678 [label=false,color=brown];
	j374072022 [label="Check boolean MarieDating",color=orange];
		j374072022 -> j2322669842 [label=true,color=green];
		j374072022 -> j1070518033 [label=false,color=brown];
	j2747748119 [label="Ми повинні розрубати цей вузол. Purgatoire, в якому ми застрягли, не повинно існувати. Воно дуже болісне без причин на то.",shape=box,color=blue];
		j2747748119 -> j3091286759;
	j2768654365 [label="Boolean MarieWillDate is now true.",color=orange];
		j2768654365 -> "Chat ends.";
	j4251274850 [label="Bonjour, mon cœur ! Я тут поміркувала… і дуже не хочеться цього визнавати. Мені неприємно про це говорити.",shape=box,color=blue];
		j4251274850 -> j3528503847;
	j4042417534 [label="Bonjour ! Я тут поміркувала… І дуже не хочеться цього визнавати. Мені неприємно про це говорити.",shape=box,color=blue];
		j4042417534 -> j3528503847;
	j2142158815 [label="Bonjour, mon coeur ! А що саме ти боїшся, що мені не сподобається ?",shape=box,color=blue];
		j2142158815 -> j3344013002;
	j3177818678 [label="Bonjour ! А що саме ти боїшся, що мені не сподобається ?",shape=box,color=blue];
		j3177818678 -> j3344013002;
	j2322669842 [label="Bonjour, bonjour, mon cœur ! Я тут поміркувала… і дуже не хочеться цього визнавати. Мені неприємно про це говорити.",shape=box,color=blue];
		j2322669842 -> j1497311883;
	j1070518033 [label="Bonjour… Я тут поміркувала… і дуже не хочеться цього визнавати. Мені неприємно про це говорити.",shape=box,color=blue];
		j1070518033 -> j1497311883;
	j3091286759 [label="Але я відчуваю, що нам потрібен… якийсь бастіон, non ? Є ідеї ?",shape=box,color=blue];
		j3091286759 -> j1178218341;
		j3091286759 -> j3344013002;
	j3528503847 [label="Але я думаю… я думаю… пробач мені, Соле… допомога диявола — саме те, чого бракує. Не думаю, що інакше монсеньйор Лойд послухає нас.",shape=box,color=blue];
		j3528503847 -> j2934395057;
	j3344013002 [label="Думаю, нам знадобиться допомога Роута, щоб вмовити Лойда поговорити з родиною Ентраті. Не думаю, що він якимось чином погодиться без цього. Без гарантій, що він і родина будуть під захистом.",shape=box,color=red];
		j3344013002 -> j1955402366;
	j1497311883 [label="Усе ж таки ти маєш рацію. Диявол може бути тим шматком, якого бракує. О, як же мене гнітить навіть друкування цих слів ! ",shape=box,color=blue];
		j1497311883 -> j409794056;
	j1178218341 [label="Нема ніяких ідей, які б не потребували використання допомоги з моторошних джерел. Тих, які можуть призвести до гірших наслідків. Тих, які звуться Роут.",shape=box,color=red];
		j1178218341 -> j2610879949;
	j2934395057 [label="Диявол могутній і зможе стати грубою силою, якщо щось піде не так, non ?",shape=box,color=blue];
		j2934395057 -> j1670862507;
		j2934395057 -> j3073591620;
	j1955402366 [label="Гірко визнавати це… але є істина в твоїх словах… Соле, пробач мене, грішну.",shape=box,color=blue];
		j1955402366 -> j409794056;
	j409794056 [label="Evaluate expressions",color=orange];
		j409794056 -> j3282262892 [label="RoatheFamilyFail",color=purple];
		j409794056 -> j2365490750 [label="RoatheRedeemed, RoatheFamilyDelay
",color=purple];
		j409794056 -> j2995260352 [label="RoatheVillain, RoatheFamilyDelay",color=purple];
		j409794056 -> j4044944389 [label="false",color=purple];
	j2610879949 [label="Це точно ? Якщо я можу не зважати на свої différences з Роутом, то й ти безумовно, non ?",shape=box,color=blue];
		j2610879949 -> j2495617245;
		j2610879949 -> j1475837734;
	j1670862507 [label="Знаєш, певно, твоя правда. Не варто було думати, що ти погодишся. Не дарма було страшно запитувати.",shape=box,color=red];
		j1670862507 -> j409794056;
	j3073591620 [label="Ні. Має бути інший шлях. Я не проситиму його допомоги в цьому.",shape=box,color=red];
		j3073591620 -> j2610879949;
	j3282262892 [label="Він допоможе нам у цій справі ?",shape=box,color=blue];
		j3282262892 -> j3931650457;
	j2365490750 [label="Він допоможе нам у цій справі ?",shape=box,color=blue];
		j2365490750 -> j1823666271;
	j2995260352 [label="Він допоможе нам у цій справі ?",shape=box,color=blue];
		j2995260352 -> j4259681205;
	j4044944389 [label="Думаєш, тобі вдасться вмовити його допомогти нам ?",shape=box,color=blue];
		j4044944389 -> j198230913;
		j4044944389 -> j1240427292;
	j2495617245 [label="Добре. Якщо тобі нормально з цим, то й мені теж.",shape=box,color=red];
		j2495617245 -> j1940187207;
	j1475837734 [label="Ні, вибач. ",shape=box,color=red];
		j1475837734 -> j1311473334;
	j3931650457 [label="Ні, на жаль… Думаю, це глухий кут. Як вважаєш, інші способи є?",shape=box,color=red];
		j3931650457 -> j849254742;
	j1823666271 [label="Так. Мені вдалося переконати його допомогти з їхнім об’єднанням. Ти не повіриш, але він захищатиме родину Ентраті. Зрештою, це останні з орокінів.",shape=box,color=red];
		j1823666271 -> j3722669472;
	j4259681205 [label="Так. Мені вдалося переконати його допомогти з їхнім об’єднанням. І… тебе це не здивує, але переважно через те, щоб чимось дошкулити Альбрехту, поки його нема.",shape=box,color=red];
		j4259681205 -> j905863520;
	j198230913 [label="Я досі над цим працюю, але думаю, що так.",shape=box,color=red];
		j198230913 -> j961489522;
	j1240427292 [label="Ще нічого не узгоджено. Він… ну, ти ж знаєш, яким може бути.",shape=box,color=red];
		j1240427292 -> j3827853471;
	j1940187207 [label="Oui, ці un médicament, які я маю проковтнути, не обов’язково повинні бути смачними для зцілення.",shape=box,color=blue];
		j1940187207 -> j409794056;
	j1311473334 [label="+20 Chemistry",color=orange];
		j1311473334 -> j1258203186;
	j849254742 [label="Ой ! Це… не пощастило. Я не знаю… Може, ти якийсь підхід інший підбереш до диявола ? Чи якось по-інакшому спитаєш знову ?",shape=box,color=blue];
		j849254742 -> j4108042114;
	j3722669472 [label="Він допомагає захистити родину чоловіка, котрий обернув його на протофрейма супроти волі й закинув у минуле, стерши спогади…",shape=box,color=blue];
		j3722669472 -> j2748078826;
	j905863520 [label="Так, саме так… я не здивована.",shape=box,color=blue];
		j905863520 -> j2836888597;
		j905863520 -> j285412643;
	j961489522 [label="Check boolean RoatheDating",color=orange];
