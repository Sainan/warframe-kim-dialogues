		j3827853471 -> j1893605579 [label=false,color=brown];
	j1258203186 [label="Тоді я прийму твій вибір.",shape=box,color=blue];
		j1258203186 -> j1179567760;
	j4108042114 [label="Тим часом я побалакаю з Ліоном, але тут зовсім мало надії.",shape=box,color=blue];
		j4108042114 -> j2377995789;
	j2748078826 [label="+20 Chemistry",color=orange];
		j2748078826 -> j2121816608;
	j2836888597 [label="Думаю, це лише виправдання, яким він прикривається.",shape=box,color=red];
		j2836888597 -> j3074542176;
	j285412643 [label="Принаймні він допоможе. А я переконаюся, що він насправді не виконає своїх погроз.",shape=box,color=red];
		j285412643 -> j1875948557;
	j4197094389 [label="Думаю, що в тебе є особливий спосіб переконати його, якщо всі інші зазнали невдачі, non ?",shape=box,color=blue];
		j4197094389 -> j46603293;
		j4197094389 -> j3606428417;
	j2675340697 [label="Бажаю тобі всього найліпшого. Диявол буває занадто упертим навіть у найліпші часи. Іноді таке враження, що йому до вподоби бути по інший бік у суперечці !",shape=box,color=blue];
		j2675340697 -> j470909612;
		j2675340697 -> j1019501146;
	j3665330106 [label="Oui. Думаю, що в тебе є особливий спосіб переконати його, якщо всі інші зазнали невдачі, non ?",shape=box,color=blue];
		j3665330106 -> j46603293;
		j3665330106 -> j3606428417;
	j1893605579 [label="Oui, безперечно. Диявол буває занадто упертим навіть у найліпші часи. Іноді таке враження, що йому до вподоби бути по інший бік у суперечці !",shape=box,color=blue];
		j1893605579 -> j470909612;
		j1893605579 -> j1019501146;
	j1179567760 [label="Boolean MarieFamilyFail is now true.",color=orange];
		j1179567760 -> j2605366984;
	j2377995789 [label="+20 Chemistry",color=orange];
		j2377995789 -> j3685708555;
	j2121816608 [label="Я дуже недооцінила нашого диявола…",shape=box,color=blue];
		j2121816608 -> j1357460995;
	j3074542176 [label="Oui, сподіваюся, що твоя правда.",shape=box,color=blue];
		j3074542176 -> j70687620;
	j1875948557 [label="Oui. Щонайменше ми тут, щоб не дати йому потурати своїм… низьким інстинктам.",shape=box,color=blue];
		j1875948557 -> j70687620;
	j46603293 [label="Марі, на що ти натякаєш?",shape=box,color=red];
		j46603293 -> j2760548133;
	j3606428417 [label="Не хотілося б використовувати мої стосунки з ним як важіль для перемовин.",shape=box,color=red];
		j3606428417 -> j708002283;
	j470909612 [label="Так, але думаю, що більша частина того — лише для створення образу.",shape=box,color=red];
		j470909612 -> j2138160564;
	j1019501146 [label="Знаєш, як би дивно це не звучало, але мені це навіть подобається. Ми поладнаємо.",shape=box,color=red];
		j1019501146 -> j1898393583;
	j2605366984 [label="Boolean MarieRank5Convo4Complete is now true.",color=orange];
		j2605366984 -> "Chat ends.";
	j3685708555 [label="Ото ж усе ці дияволи ! Як-то кажуть, c'est la vie !",shape=box,color=blue];
		j3685708555 -> j3569999725;
	j1357460995 [label="Я не дурепа, щоб не бачити твоє ролі в цьому всьому !",shape=box,color=blue];
		j1357460995 -> j1263896752;
	j70687620 [label="Check boolean MarieDating",color=orange];
		j70687620 -> j3114636551 [label=true,color=green];
		j70687620 -> j893096388 [label=false,color=brown];
	j2760548133 [label="+5 Chemistry",color=orange];
		j2760548133 -> j2824681427;
	j708002283 [label="О ! Це не те, на що я натякаю, pardonne-moi ! Схоже, що він прихильний до тебе, тож вислухає, коли інших може проігнорувати.",shape=box,color=blue];
		j708002283 -> j3831295297;
	j2138160564 [label="Oui ? Що маєш на увазі ?",shape=box,color=blue];
		j2138160564 -> j1155893159;
	j1898393583 [label="Oui, схоже, він точно прихильний до тебе. Можливо, це тому, що ви з ним маєте спільний час і простір, а ми ні ? Чому б іще ?",shape=box,color=blue];
		j1898393583 -> j1155893159;
	j3569999725 [label="Boolean MarieFamilySuccess is now true.",color=orange];
		j3569999725 -> j2605366984;
	j1263896752 [label="Check boolean MarieDating",color=orange];
		j1263896752 -> j2647290534 [label=true,color=green];
		j1263896752 -> j3945458432 [label=false,color=brown];
	j3114636551 [label="+10 Chemistry",color=orange];
		j3114636551 -> j884560398;
	j893096388 [label="+10 Chemistry",color=orange];
		j893096388 -> j3768658948;
	j2824681427 [label="Я гадки не маю про що ти ! Я ні на що не натякаю. Я чиста une innocente Sœur de Sol.",shape=box,color=blue];
		j2824681427 -> j1316882699;
	j3831295297 [label="+5 Chemistry",color=orange];
		j3831295297 -> j1323603920;
