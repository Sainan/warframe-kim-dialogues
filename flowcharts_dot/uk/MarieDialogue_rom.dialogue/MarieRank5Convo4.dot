	3030 [label="+5 Chemistry",color=orange];
		3030 -> 3037;
	3031 [label="О ! Це не те, на що я натякаю, pardonne-moi ! Схоже, що він прихильний до тебе, тож вислухає, коли інших може проігнорувати.",shape=box,color=blue];
		3031 -> 3038;
	3028 [label="Oui ? Що маєш на увазі ?",shape=box,color=blue];
		3028 -> 3036;
	3029 [label="Oui, схоже, він точно прихильний до тебе. Можливо, це тому, що ви з ним маєте спільний час і простір, а ми ні ? Чому б іще ?",shape=box,color=blue];
