		2992 -> 3001;
	2989 [label="Думаєш, тобі вдасться вмовити його допомогти нам ?",shape=box,color=blue];
		2989 -> 2997;
		2989 -> 2998;
	2995 [label="Добре. Якщо тобі нормально з цим, то й мені теж.",shape=box,color=red];
		2995 -> 3002;
	2996 [label="Ні, вибач. ",shape=box,color=red];
		2996 -> 3003;
	2999 [label="Ні, на жаль… Думаю, це глухий кут. Як вважаєш, інші способи є?",shape=box,color=red];
		2999 -> 3006;
	3000 [label="Так. Мені вдалося переконати його допомогти з їхнім об’єднанням. Ти не повіриш, але він захищатиме родину Ентраті. Зрештою, це останні з орокінів.",shape=box,color=red];
		3000 -> 3007;
	3001 [label="Так. Мені вдалося переконати його допомогти з їхнім об’єднанням. І… тебе це не здивує, але переважно через те, щоб чимось дошкулити Альбрехту, поки його нема.",shape=box,color=red];
		3001 -> 3008;
	2997 [label="Я досі над цим працюю, але думаю, що так.",shape=box,color=red];
		2997 -> 3004;
	2998 [label="Ще нічого не узгоджено. Він… ну, ти ж знаєш, яким може бути.",shape=box,color=red];
		2998 -> 3005;
	3002 [label="Oui, ці un médicament, які я маю проковтнути, не обов’язково повинні бути смачними для зцілення.",shape=box,color=blue];
		3002 -> 2985;
	3003 [label="+20 Chemistry",color=orange];
		3003 -> 3009;
	3006 [label="Ой ! Це… не пощастило. Я не знаю… Може, ти якийсь підхід інший підбереш до диявола ? Чи якось по-інакшому спитаєш знову ?",shape=box,color=blue];
		3006 -> 3014;
