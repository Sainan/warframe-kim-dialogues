digraph {
	1276 [label="MarieRank3Convo5 begins.",color=orange];
		1276 -> 3739;
	3739 [label="Update boolean MarieLyonAvailable",color=orange];
		3739 -> 1277;
	1277 [label="Check boolean DrifterFaithSol",color=orange];
		1277 -> 1279 [label=true,color=green];
		1277 -> 1278 [label=false,color=brown];
	1279 [label="Ma famille à Sol ! Моя рідня у Солові, як ми цього дня ?",shape=box,color=blue];
		1279 -> 1281;
		1279 -> 1280;
		1279 -> 1283;
		1279 -> 3947;
		1279 -> 1282;
	1278 [label="Bonjour ! Як ми цього дня ?",shape=box,color=blue];
		1278 -> 1281;
		1278 -> 1280;
		1278 -> 1283;
		1278 -> 3947;
		1278 -> 1282;
	1281 [label="Усе добре, а ти як?",shape=box,color=red];
		1281 -> 1285;
	1280 [label="Бувало й ліпше, дякую за запитання. А ти як?",shape=box,color=red];
		1280 -> 1284;
	1283 [label="Я… маю зізнатися в брехні. Я не… не зовсім іду шляхами Сола.",shape=box,color=red];
		1283 -> 1287;
	3947 [label="Як оце почали переписуватися, то стало ліпше. Але ти й так робиш усі мої дні яскравішими, відтоді як з’явилася в них.",shape=box,color=red];
		3947 -> 3948;
	1282 [label="[Завершити розмову]",shape=box,color=red];
		1282 -> 1286;
	1285 [label="Припускаю, у мене все добре. Та що більше розмірковую про це, то більше відчуваю, що не повинно було б.",shape=box,color=blue];
		1285 -> 1292;
		1285 -> 1293;
	1284 [label="Зі мною все добре. Але тепер я палаю цікавістю. Qu'y a-t-il ?",shape=box,color=blue];
		1284 -> 1288;
		1284 -> 1289;
		1284 -> 1290;
		1284 -> 1291;
	1287 [label="О ! Я… розумію. Pourquoi ?",shape=box,color=blue];
		1287 -> 1294;
		1287 -> 1295;
		1287 -> 1296;
	3948 [label="Вовченя ! Я через тебе зі свого крісла випаду !",shape=box,color=blue];
		3948 -> 3949;
		3948 -> 3950;
	1286 [label="Chat ends.",color=orange];
	1292 [label="Що маєш на увазі?",shape=box,color=red];
		1292 -> 1301;
	1293 [label="Колись мені довелося бути на твоєму місці.",shape=box,color=red];
		1293 -> 1302;
	1288 [label="Це… ну… складно пояснити.",shape=box,color=red];
		1288 -> 1297;
	1289 [label="Забагато є про що хвилюватися. Замало часу.",shape=box,color=red];
		1289 -> 1298;
	1290 [label="Дехто з моїх близьких описує це як «павуки». Вони час від часу заповзають.",shape=box,color=red];
		1290 -> 1299;
	1291 [label="Іноді все… просто дістає. Але зі мною все буде добре.",shape=box,color=red];
		1291 -> 1300;
	1294 [label="Здалося, що це було єдиною можливістю пізнати тебе ліпше…",shape=box,color=red];
		1294 -> 1303;
	1295 [label="Здалося, що це було б прикольно.",shape=box,color=red];
		1295 -> 1304;
	1296 [label="Чесно не знаю. Імпульсивний вчинок.",shape=box,color=red];
		1296 -> 1305;
	3949 [label="Я серйозно. Ти вибач, якщо через це тобі незручно.",shape=box,color=red];
		3949 -> 3951;
	3950 [label="Пробач. То були дурощі.",shape=box,color=red];
		3950 -> 3951;
	1301 [label="Я une Sœur de Sol. Я не повинна битися… Убивати. Шепіт не живий. Або так говорять кавії… та як щодо інших, з ким я стикаюся ?",shape=box,color=blue];
		1301 -> 1310;
	1302 [label="+5 Chemistry",color=orange];
		1302 -> 1311;
	1297 [label="Тоді я не заважатиму. Я знаю, як іноді буває складно добрати слів.",shape=box,color=blue];
		1297 -> 1306;
	1298 [label="У Cathédrale була сестра з подібною ситуацією. Вона постійно метушилася, кожен день, без перестанку. Одного разу я застала її за поліруванням срібла о третій ранку.",shape=box,color=blue];
		1298 -> 1307;
	1299 [label="О, oui. Гадаю я знаю про що ти. Щось на кшталт… хмари, яка застує сонце.",shape=box,color=blue];
		1299 -> 1308;
	1300 [label="Наче склянка, яка заповнюється водою, але по краплині, non ?",shape=box,color=blue];
		1300 -> 1309;
	1303 [label="Не треба було вигадувати таку mensonge, щоби пізнати мене.",shape=box,color=blue];
		1303 -> 1312;
	1304 [label="Je ne comprends pas votre humour. Можливо, у майбутньому «смішно» геть по-іншому ?",shape=box,color=blue];
		1304 -> 1313;
	1305 [label="Я не знаю, що за інстинкти змусили тебе сказати таку mensonge. ",shape=box,color=blue];
		1305 -> 1314;
	3951 [label="Bon, où en étais-je ?",shape=box,color=blue];
		3951 -> 1278;
	1310 [label="Битися в ім’я Сола… оце такий мій шлях ? Я маю бути вбивцею з Його іменем на вустах? Moi, petite Marie ?",shape=box,color=blue];
		1310 -> 1319;
		1310 -> 1320;
	1311 [label="Я знаю, що ти використовуєш une métaphore, але зараз вию від сміху ! Як же це тобі б удалося бути на моєму місці, якщо ти — це ти, а я — це я ?!",shape=box,color=blue];
		1311 -> 1321;
	1306 [label="Стільки варіантів у наші дні для того, щоб розум покинув голову. Для кожного можуть існувати чорні діри, які засмокчуть і заберуть нас, non ?",shape=box,color=blue];
		1306 -> 1315;
	1307 [label="Я спитала її для чого вона це робить. А вона відповіла, що не може заснути, бо надто переживає.",shape=box,color=blue];
		1307 -> 1316;
	1308 [label="У нас є вираз на позначення цього стану — непозбувна бентега. Через утому й розчарування все… видається марним.",shape=box,color=blue];
		1308 -> 1317;
	1309 [label="Вона стає повною і далі все йде повз. Може навіть і вивергає весь уміст. І це все разом видаватиметься une catastrophe. ",shape=box,color=blue];
		1309 -> 1318;
	1312 [label="Душа — дещо більше, аніж віра нам каже. Я — une Sœur de Sol, та маю сподівання, що ти бачиш щось більше в мені, non ?",shape=box,color=blue];
		1312 -> 1322;
	1313 [label="Бо для мене це не смішно.",shape=box,color=blue];
		1313 -> 1323;
	1314 [label="Можу лише сподіватися, що то було скоєно з добрими намірами, а не планувалося як жорстокий жарт. Тож я вчиню за вченням Сола…",shape=box,color=blue];
		1314 -> 1324;
	1319 [label="Мені не довелося пізнати солдатського вишколу. І маля теж. Та й ти не тренувалася цьому.",shape=box,color=red];
		1319 -> 1328;
	1320 [label="У мені… не завжди це було. Війна не була зі мною змалку. Довелося вчитися зразу в бою.",shape=box,color=red];
		1320 -> 1329;
	1321 [label="Образ у моїй голові дуже смішний. Перш ніж мені остаточно перехопить подих… Скажи — про що ти ?",shape=box,color=blue];
		1321 -> 1319;
		1321 -> 1320;
	1315 [label="І коли таке трапляється ми можемо лише прагнути зберігати добро та терплячість у ставленні до себе.",shape=box,color=blue];
		1315 -> 1325;
	1316 [label="Щоразу як бачила її в такому стані, то завжди пропонувала свою компанію. Іноді вона погоджувалася, а іноді відмовляла.",shape=box,color=blue];
		1316 -> 1306;
	1317 [label="А, може, це в тебе бажання сховатися й ридати ? То тут більше підійде ознака «відчай», я не знаю.",shape=box,color=blue];
		1317 -> 1335;
	1318 [label="Ти прибираєш усе, ставиш рівно склянку… і все починається знову, oui ?",shape=box,color=blue];
		1318 -> 1327;
	1322 [label="Ще стільки тем інакших можна обрати. Їх так багато, як на небі зірочок !",shape=box,color=blue];
		1322 -> 1330;
		1322 -> 1331;
	1323 [label="Update boolean DrifterFaithSol",color=orange];
		1323 -> 1332;
	1324 [label="віру в якого я сповідую, незалежно від того, чи її сповідуєш ти. І пробачу тобі. Якби твоя сутність була схожа на Ліона, то я би призначила тобі 10 ударів батогом, щоб спокутувати провину.",shape=box,color=blue];
		1324 -> 1333;
	1328 [label="Oui ! The minuscule copie і та triste story… мені хочеться ридма ридати, коли думаю про це. Перетворитися на машину війни від рук тих, кого вважаєш сім’єю ?",shape=box,color=blue];
		1328 -> 1337;
	1329 [label="Oui ! Я чула, що тобі довелося чимало страждати, щоб навчитися битися так, як зараз. Смерть — жорстока наставниця. Навіть уявити не можу…",shape=box,color=blue];
		1329 -> 1337;
	1325 [label="Я не знаю, чи ці слова мають для тебе значення. Чи це лише купка сяйнистих крапочок на цій шумній machinerie.",shape=box,color=blue];
		1325 -> 1334;
	1335 [label="Я не знаю цю особу, але гадаю, що дуже добре, що довкола тебе є такі.",shape=box,color=blue];
		1335 -> 1306;
	1327 [label="У нашій каплиці був проповідник подібним до твого темпераментом. Він міг витримати геть усе… аж допоки не зміг.",shape=box,color=blue];
		1327 -> 1336;
	1330 [label="Мені шкода. Це була дурість.",shape=box,color=red];
		1330 -> 1338;
	1331 [label="То ти мені пробачиш?",shape=box,color=red];
		1331 -> 1339;
	1332 [label="Update boolean MarieNoDate",color=orange];
		1332 -> 1340;
	1333 [label="Update boolean DrifterFaithSol",color=orange];
		1333 -> 1341;
	1337 [label="Non. Я ліпше буду така, як є. Я сама обрала взяти запропоновану sérum з рук le Cardinal.",shape=box,color=blue];
		1337 -> 1343;
	1334 [label="Знаєш, якщо зважати на реальний стан речей, то час написання цих рядків може бути за кілька днів чи багато років відтоді, як я їх написала. Усе залежить коли ти зараз.",shape=box,color=blue];
		1334 -> 1342;
	1336 [label="Коли він був геть змарнілим і розгубленим, а все довкола вважалося непереборним хаосом, я питала, чи йому не потрібна моя companie. Des fois, oui, des fois, non.",shape=box,color=blue];
		1336 -> 1306;
	1338 [label="Update boolean DrifterFaithSol",color=orange];
		1338 -> 1344;
	1339 [label="Update boolean DrifterFaithSol",color=orange];
		1339 -> 1345;
	1340 [label="Chat ends.",color=orange];
	1341 [label="Ми всі сліпі створіння, які намагаються знайти свій шлях у темряві цього світу.",shape=box,color=blue];
		1341 -> 1346;
	1343 [label="Але тобі знайома невизначеність — той смуток, що гнітить мене. А не народитися чи виросте у війні.",shape=box,color=blue];
		1343 -> 1348;
		1343 -> 1349;
	1342 [label="Себто я достоту розумію, якими порожніми можуть видаватися написані слова про те, що ти не наодинці з цим усим.",shape=box,color=blue];
		1342 -> 1347;
	1344 [label="+10 Chemistry",color=orange];
		1344 -> 1350;
	1345 [label="+5 Chemistry",color=orange];
		1345 -> 1351;
	1346 [label="Але я питала як ти. І питання досі без відповіді, petit mensonge ou non.",shape=box,color=blue];
		1346 -> 1352;
		1346 -> 1353;
		1346 -> 1354;
	1348 [label="Іноді я думаю про те, як багато довелося дізнаватися самотужки, то трішки починаю заздрити, що маля пройшло реальний вишкіл.",shape=box,color=red];
		1348 -> 1356;
	1349 [label="Гадаю, що нема «нормального» способу бути у війні. Народитися, вирости чи обрати її. Зрештою, усе зводиться до того, хто ти є і що з цим робитимеш.",shape=box,color=red];
		1349 -> 1357;
	1347 [label="Та ті, хто довкола, можуть видаватися віддаленими чи цифровими — просто чекають на тебе, щоб сказати «Привіт».",shape=box,color=blue];
		1347 -> 1355;
	1350 [label="Oui, якби твоя сутність була схожа на Ліона, то я би призначила тобі 10 ударів батогом, щоб спокутувати провину ! Але ти не з таких. Тож тебе пробачено.",shape=box,color=blue];
		1350 -> 1341;
	1351 [label="Oui, пробачаю тобі. Якби твоя сутність була схожа на Ліона, то я би призначила тобі 10 ударів батогом, щоб спокутувати провину.",shape=box,color=blue];
		1351 -> 1341;
	1352 [label="Та… бувало й ліпше, якщо чесно.",shape=box,color=red];
		1352 -> 1358;
	1353 [label="Усе гаразд, чесно. А ти, до речі, як?",shape=box,color=red];
		1353 -> 1285;
	1354 [label="Зараз уже ліпше. Дякую. Гадаю, що сповіді корисні, так?",shape=box,color=red];
		1354 -> 1359;
	1356 [label="Add -1 to Thermostat",color=orange];
		1356 -> 1361;
	1357 [label="Add 1 to Thermostat",color=orange];
		1357 -> 1362;
	1355 [label="І сподіваюся, що ця погана мить швидко мине для тебе.",shape=box,color=blue];
		1355 -> 1360;
	1358 [label="Qu'y a-t-il ? Що трапилося ?",shape=box,color=blue];
		1358 -> 1288;
		1358 -> 1289;
		1358 -> 1290;
		1358 -> 1291;
	1359 [label="+5 Chemistry",color=orange];
		1359 -> 1363;
	1361 [label="+10 Chemistry",color=orange];
		1361 -> 1365;
	1362 [label="+10 Chemistry",color=orange];
		1362 -> 1366;
	1360 [label="А якщо ні ? То в мене є рішення, яке завше допомагає !",shape=box,color=blue];
		1360 -> 1364;
	1363 [label="Ха ! Oui, так і є. , Що ж , très bien, рада це чути.",shape=box,color=blue];
		1363 -> 1367;
	1365 [label="Oui, але тобі тоді не вдалося б стати тим лихим вовченям, якого ми знаємо й любимо, non ? Гадаю, що Сол поставив тебе саме на те місце, де ти й маєш бути.",shape=box,color=blue];
		1365 -> 1369;
	1366 [label="Oui, повністю згодна. Ніхто не народжується для війни. Ну, хіба окрім цих «ґрі-інеррів», про яких мені розповідали. Але навіть і тоді…",shape=box,color=blue];
		1366 -> 1370;
	1364 [label="Des pâtisseries !",shape=box,color=blue];
		1364 -> 1368;
	1367 [label="О! Обід подано. Я мушу йти. До наступної бесіди, вовченя. Я рада, що ми поспілкувалися.",shape=box,color=blue];
		1367 -> 1371;
	1369 [label="Але я розумію, що ти маєш на увазі. Ти бачиш структуровані знання та напрямок, які отримало твоє інше я. І нічого не можеш вдіяти, коли жадаєш того ж самого. Особливо тоді, коли тебе огортала самотність.",shape=box,color=blue];
		1369 -> 1376;
	1370 [label="Цікаво, чи не пішли б вони іншим шляхом, якби мали реальний вибір ?",shape=box,color=blue];
		1370 -> 1377;
		1370 -> 1378;
	1368 [label="Check boolean MarieRoathePastry1",color=orange];
		1368 -> 1372 [label=true,color=green];
		1368 -> 1373 [label=true,color=green];
		1368 -> 1374 [label=true,color=green];
		1368 -> 1373 [label=false,color=brown];
		1368 -> 1375 [label=false,color=brown];
	1371 [label="Chat ends.",color=orange];
	1376 [label="Однак знаєш, нічого не можу вдіяти, але бачу геть на самоті minuscule copie… і вовченя, яке бігає зі зграєю.",shape=box,color=blue];
		1376 -> 1383;
	1377 [label="Дуже складно вирватися з кайданів стереотипів. Бо ти ростеш і знаєш, що це твоя єдина мета, суть твого існування. Мета втішає людей.",shape=box,color=red];
		1377 -> 1384;
	1378 [label="Думаю, що пішли б. Мені вдалося зустріти кількох із них, які довели, що ґрінери — це щось більше, аніж лише війна та смерть.",shape=box,color=red];
		1378 -> 1385;
	1372 [label="Тільки треба буде впевнитися, що солодкої випічки вистачить на всіх.",shape=box,color=red];
		1372 -> 1379;
	1373 [label="Дякую, Марі.",shape=box,color=red];
		1373 -> 1380;
	1374 [label="Та тільки Роута я й близько до них не підпущу.",shape=box,color=red];
		1374 -> 1381;
	1375 [label="З випічкою ніколи не даси маху.",shape=box,color=red];
		1375 -> 1382;
	1383 [label="Схоже, що все перевернулося, non ?",shape=box,color=blue];
		1383 -> 1390;
		1383 -> 1391;
	1384 [label="Add -1 to Thermostat",color=orange];
		1384 -> 1392;
	1385 [label="Add 1 to Thermostat",color=orange];
		1385 -> 1393;
	1379 [label="+20 Chemistry",color=orange];
		1379 -> 1386;
	1380 [label="+20 Chemistry",color=orange];
		1380 -> 1387;
	1381 [label="+20 Chemistry",color=orange];
		1381 -> 1388;
	1382 [label="Тільки не підпускай диявола до них ні на крок. Sinon, il va les voler ! Він скрізь краде солодощі, де тільки видається нагода !",shape=box,color=blue];
		1382 -> 1389;
	1390 [label="Маля досі зцілюється. Ця подорож ще не завершена.",shape=box,color=red];
		1390 -> 1398;
	1391 [label="Якби ж була змога щось ще зробити. ",shape=box,color=red];
		1391 -> 1398;
	1392 [label="Oui, твоя правда. Багато хто шукає віру, у сподіваннях, що вона дасть їм саме те — призначення. Мету. Напрям.",shape=box,color=blue];
		1392 -> 1399;
	1393 [label="(Ага, он воно як пишеться. Merci !) Рада це знати. Ціла раса, яку призвичаїли до певної мети, може знайти іншу.",shape=box,color=blue];
		1393 -> 1400;
	1386 [label="Оце правильний настрій ! Навіть диявол іноді заслуговує на солодку випічку, напевно.",shape=box,color=blue];
		1386 -> 1394;
	1387 [label="Je vous en prie. Сподіваюся, що хоч трішки тебе підбадьорила. Бо ти мене — так.",shape=box,color=blue];
		1387 -> 1402;
	1388 [label="Я трохи буркотлива, але навіть найгірший диявол іноді заслуговує на шматок солодкої випічки, oui?",shape=box,color=blue];
