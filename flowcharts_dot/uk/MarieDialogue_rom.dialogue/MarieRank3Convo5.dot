		j1402799028 -> j2271860743 [label=false,color=brown];
	j3089360895 [label="Ma famille à Sol ! Моя рідня у Солові, як ми цього дня ?",shape=box,color=blue];
		j3089360895 -> j1992102935;
		j3089360895 -> j4259655261;
		j3089360895 -> j3656602009;
		j3089360895 -> j3583072018;
		j3089360895 -> j1478915251;
	j2271860743 [label="Bonjour ! Як ми цього дня ?",shape=box,color=blue];
		j2271860743 -> j1992102935;
		j2271860743 -> j3656602009;
		j2271860743 -> j3583072018;
		j2271860743 -> j1478915251;
		j2271860743 -> j4259655261;
	j1992102935 [label="Усе добре, а ти як?",shape=box,color=red];
		j1992102935 -> j3464475523;
	j4259655261 [label="Бувало й ліпше, дякую за запитання. А ти як?",shape=box,color=red];
		j4259655261 -> j1357826179;
	j3656602009 [label="Я… маю зізнатися в брехні. Я не… не зовсім іду шляхами Сола.",shape=box,color=red];
		j3656602009 -> j1568810996;
	j3583072018 [label="Як оце почали переписуватися, то стало ліпше. Але ти й так робиш усі мої дні яскравішими, відтоді як з’явилася в них.",shape=box,color=red];
		j3583072018 -> j2406057848;
	j1478915251 [label="[Завершити розмову]",shape=box,color=red];
		j1478915251 -> "Chat ends.";
	j3464475523 [label="Припускаю, у мене все добре. Та що більше розмірковую про це, то більше відчуваю, що не повинно було б.",shape=box,color=blue];
		j3464475523 -> j4171874542;
		j3464475523 -> j3828962839;
	j1357826179 [label="Зі мною все добре. Але тепер я палаю цікавістю. Qu'y a-t-il ?",shape=box,color=blue];
		j1357826179 -> j1944274617;
		j1357826179 -> j451749125;
		j1357826179 -> j2659995145;
		j1357826179 -> j2132800216;
	j1568810996 [label="О ! Я… розумію. Pourquoi ?",shape=box,color=blue];
		j1568810996 -> j1485206046;
		j1568810996 -> j781224748;
		j1568810996 -> j1354135315;
	j2406057848 [label="Вовченя ! Я через тебе зі свого крісла випаду !",shape=box,color=blue];
		j2406057848 -> j4073401362;
		j2406057848 -> j3509980198;
	"Chat ends." [color=orange];
	j4171874542 [label="Що маєш на увазі?",shape=box,color=red];
		j4171874542 -> j656114845;
	j3828962839 [label="Колись мені довелося бути на твоєму місці.",shape=box,color=red];
		j3828962839 -> j1124985307;
	j1944274617 [label="Це… ну… складно пояснити.",shape=box,color=red];
		j1944274617 -> j2795884814;
	j451749125 [label="Забагато є про що хвилюватися. Замало часу.",shape=box,color=red];
		j451749125 -> j1594125591;
	j2659995145 [label="Дехто з моїх близьких описує це як «павуки». Вони час від часу заповзають.",shape=box,color=red];
		j2659995145 -> j2471762720;
	j2132800216 [label="Іноді все… просто дістає. Але зі мною все буде добре.",shape=box,color=red];
		j2132800216 -> j4195413180;
	j1485206046 [label="Здалося, що це було єдиною можливістю пізнати тебе ліпше…",shape=box,color=red];
		j1485206046 -> j1780693314;
	j781224748 [label="Здалося, що це було б прикольно.",shape=box,color=red];
		j781224748 -> j854118683;
	j1354135315 [label="Чесно не знаю. Імпульсивний вчинок.",shape=box,color=red];
		j1354135315 -> j1029969101;
	j4073401362 [label="Я серйозно. Ти вибач, якщо через це тобі незручно.",shape=box,color=red];
		j4073401362 -> j1180282791;
	j3509980198 [label="Пробач. То були дурощі.",shape=box,color=red];
		j3509980198 -> j1180282791;
	j656114845 [label="Я une Sœur de Sol. Я не повинна битися… Убивати. Шепіт не живий. Або так говорять кавії… та як щодо інших, з ким я стикаюся ?",shape=box,color=blue];
		j656114845 -> j3178071635;
	j1124985307 [label="+5 Chemistry",color=orange];
		j1124985307 -> j1857884344;
	j2795884814 [label="Тоді я не заважатиму. Я знаю, як іноді буває складно добрати слів.",shape=box,color=blue];
		j2795884814 -> j1781555414;
	j1594125591 [label="У Cathédrale була сестра з подібною ситуацією. Вона постійно метушилася, кожен день, без перестанку. Одного разу я застала її за поліруванням срібла о третій ранку.",shape=box,color=blue];
		j1594125591 -> j861829013;
	j2471762720 [label="О, oui. Гадаю я знаю про що ти. Щось на кшталт… хмари, яка застує сонце.",shape=box,color=blue];
		j2471762720 -> j4029091997;
	j4195413180 [label="Наче склянка, яка заповнюється водою, але по краплині, non ?",shape=box,color=blue];
		j4195413180 -> j2855838172;
	j1780693314 [label="Не треба було вигадувати таку mensonge, щоби пізнати мене.",shape=box,color=blue];
		j1780693314 -> j2957079675;
	j854118683 [label="Je ne comprends pas votre humour. Можливо, у майбутньому «смішно» геть по-іншому ?",shape=box,color=blue];
		j854118683 -> j1006592489;
	j1029969101 [label="Я не знаю, що за інстинкти змусили тебе сказати таку mensonge. ",shape=box,color=blue];
		j1029969101 -> j2971455624;
	j1180282791 [label="Bon, où en étais-je ?",shape=box,color=blue];
		j1180282791 -> j4244769428;
	j3178071635 [label="Битися в ім’я Сола… оце такий мій шлях ? Я маю бути вбивцею з Його іменем на вустах? Moi, petite Marie ?",shape=box,color=blue];
		j3178071635 -> j3300129083;
		j3178071635 -> j934067551;
	j1857884344 [label="Я знаю, що ти використовуєш une métaphore, але зараз вию від сміху ! Як же це тобі б удалося бути на моєму місці, якщо ти — це ти, а я — це я ?!",shape=box,color=blue];
		j1857884344 -> j2577125775;
	j1781555414 [label="Стільки варіантів у наші дні для того, щоб розум покинув голову. Для кожного можуть існувати чорні діри, які засмокчуть і заберуть нас, non ?",shape=box,color=blue];
		j1781555414 -> j1384352028;
	j861829013 [label="Я спитала її для чого вона це робить. А вона відповіла, що не може заснути, бо надто переживає.",shape=box,color=blue];
		j861829013 -> j1685221803;
	j4029091997 [label="У нас є вираз на позначення цього стану — непозбувна бентега. Через утому й розчарування все… видається марним.",shape=box,color=blue];
		j4029091997 -> j2957941596;
	j2855838172 [label="Вона стає повною і далі все йде повз. Може навіть і вивергає весь уміст. І це все разом видаватиметься une catastrophe. ",shape=box,color=blue];
		j2855838172 -> j1543533699;
	j2957079675 [label="Душа — дещо більше, аніж віра нам каже. Я — une Sœur de Sol, та маю сподівання, що ти бачиш щось більше в мені, non ?",shape=box,color=blue];
		j2957079675 -> j3003674744;
	j1006592489 [label="Бо для мене це не смішно.",shape=box,color=blue];
		j1006592489 -> j1097657522;
	j2971455624 [label="Можу лише сподіватися, що то було скоєно з добрими намірами, а не планувалося як жорстокий жарт. Тож я вчиню за вченням Сола…",shape=box,color=blue];
		j2971455624 -> j2216111091;
	j4244769428 [label="Check boolean DrifterFaithSol",color=orange];
		j4244769428 -> j1512903745 [label=true,color=green];
		j4244769428 -> j694190805 [label=false,color=brown];
	j3300129083 [label="Мені не довелося пізнати солдатського вишколу. І маля теж. Та й ти не тренувалася цьому.",shape=box,color=red];
		j3300129083 -> j2192976352;
	j934067551 [label="У мені… не завжди це було. Війна не була зі мною змалку. Довелося вчитися зразу в бою.",shape=box,color=red];
		j934067551 -> j3317473571;
	j2577125775 [label="Образ у моїй голові дуже смішний. Перш ніж мені остаточно перехопить подих… Скажи — про що ти ?",shape=box,color=blue];
		j2577125775 -> j3300129083;
		j2577125775 -> j934067551;
	j1384352028 [label="І коли таке трапляється ми можемо лише прагнути зберігати добро та терплячість у ставленні до себе.",shape=box,color=blue];
		j1384352028 -> j1641849256;
	j1685221803 [label="Щоразу як бачила її в такому стані, то завжди пропонувала свою компанію. Іноді вона погоджувалася, а іноді відмовляла.",shape=box,color=blue];
		j1685221803 -> j1781555414;
	j2957941596 [label="А, може, це в тебе бажання сховатися й ридати ? То тут більше підійде ознака «відчай», я не знаю.",shape=box,color=blue];
		j2957941596 -> j662965444;
	j1543533699 [label="Ти прибираєш усе, ставиш рівно склянку… і все починається знову, oui ?",shape=box,color=blue];
		j1543533699 -> j2803451091;
	j3003674744 [label="Ще стільки тем інакших можна обрати. Їх так багато, як на небі зірочок !",shape=box,color=blue];
		j3003674744 -> j3730356376;
		j3003674744 -> j3518373941;
	j1097657522 [label="Boolean DrifterFaithSol is now false.",color=orange];
		j1097657522 -> j1508231473;
	j2216111091 [label="віру в якого я сповідую, незалежно від того, чи її сповідуєш ти. І пробачу тобі. Якби твоя сутність була схожа на Ліона, то я би призначила тобі 10 ударів батогом, щоб спокутувати провину.",shape=box,color=blue];
		j2216111091 -> j428768303;
	j1512903745 [label="Ma famille à Sol ! Моя рідня у Солові, як ми цього дня ?",shape=box,color=blue];
		j1512903745 -> j1992102935;
		j1512903745 -> j4259655261;
		j1512903745 -> j3656602009;
		j1512903745 -> j1478915251;
	j694190805 [label="Bonjour ! Як ми цього дня ?",shape=box,color=blue];
		j694190805 -> j1992102935;
		j694190805 -> j4259655261;
		j694190805 -> j3656602009;
		j694190805 -> j1478915251;
	j2192976352 [label="Oui ! The minuscule copie і та triste story… мені хочеться ридма ридати, коли думаю про це. Перетворитися на машину війни від рук тих, кого вважаєш сім’єю ?",shape=box,color=blue];
		j2192976352 -> j1607265971;
	j3317473571 [label="Oui ! Я чула, що тобі довелося чимало страждати, щоб навчитися битися так, як зараз. Смерть — жорстока наставниця. Навіть уявити не можу…",shape=box,color=blue];
		j3317473571 -> j1607265971;
	j1641849256 [label="Я не знаю, чи ці слова мають для тебе значення. Чи це лише купка сяйнистих крапочок на цій шумній machinerie.",shape=box,color=blue];
		j1641849256 -> j4141187659;
	j662965444 [label="Я не знаю цю особу, але гадаю, що дуже добре, що довкола тебе є такі.",shape=box,color=blue];
		j662965444 -> j1781555414;
	j2803451091 [label="У нашій каплиці був проповідник подібним до твого темпераментом. Він міг витримати геть усе… аж допоки не зміг.",shape=box,color=blue];
		j2803451091 -> j537441077;
	j3730356376 [label="Мені шкода. Це була дурість.",shape=box,color=red];
		j3730356376 -> j1623466008;
	j3518373941 [label="То ти мені пробачиш?",shape=box,color=red];
		j3518373941 -> j518649150;
	j1508231473 [label="Boolean MarieNoDate is now true.",color=orange];
		j1508231473 -> "Chat ends.";
	j428768303 [label="Boolean DrifterFaithSol is now false.",color=orange];
		j428768303 -> j248401766;
	j1607265971 [label="Non. Я ліпше буду така, як є. Я сама обрала взяти запропоновану sérum з рук le Cardinal.",shape=box,color=blue];
		j1607265971 -> j2732665257;
	j4141187659 [label="Знаєш, якщо зважати на реальний стан речей, то час написання цих рядків може бути за кілька днів чи багато років відтоді, як я їх написала. Усе залежить коли ти зараз.",shape=box,color=blue];
		j4141187659 -> j107562573;
	j537441077 [label="Коли він був геть змарнілим і розгубленим, а все довкола вважалося непереборним хаосом, я питала, чи йому не потрібна моя companie. Des fois, oui, des fois, non.",shape=box,color=blue];
		j537441077 -> j1781555414;
	j1623466008 [label="Boolean DrifterFaithSol is now false.",color=orange];
		j1623466008 -> j3699994868;
	j518649150 [label="Boolean DrifterFaithSol is now false.",color=orange];
		j518649150 -> j3871562702;
	j248401766 [label="Ми всі сліпі створіння, які намагаються знайти свій шлях у темряві цього світу.",shape=box,color=blue];
		j248401766 -> j3599219178;
	j2732665257 [label="Але тобі знайома невизначеність — той смуток, що гнітить мене. А не народитися чи виросте у війні.",shape=box,color=blue];
		j2732665257 -> j3947519809;
		j2732665257 -> j3566746492;
	j107562573 [label="Себто я достоту розумію, якими порожніми можуть видаватися написані слова про те, що ти не наодинці з цим усим.",shape=box,color=blue];
		j107562573 -> j2987229461;
	j3699994868 [label="+10 Chemistry",color=orange];
		j3699994868 -> j765750157;
	j3871562702 [label="+5 Chemistry",color=orange];
		j3871562702 -> j1003687633;
	j3599219178 [label="Але я питала як ти. І питання досі без відповіді, petit mensonge ou non.",shape=box,color=blue];
		j3599219178 -> j2509591298;
		j3599219178 -> j52022063;
		j3599219178 -> j3778976749;
	j3947519809 [label="Іноді я думаю про те, як багато довелося дізнаватися самотужки, то трішки починаю заздрити, що маля пройшло реальний вишкіл.",shape=box,color=red];
		j3947519809 -> j327429812;
	j3566746492 [label="Гадаю, що нема «нормального» способу бути у війні. Народитися, вирости чи обрати її. Зрештою, усе зводиться до того, хто ти є і що з цим робитимеш.",shape=box,color=red];
		j3566746492 -> j2914843519;
	j2987229461 [label="Та ті, хто довкола, можуть видаватися віддаленими чи цифровими — просто чекають на тебе, щоб сказати «Привіт».",shape=box,color=blue];
		j2987229461 -> j394516092;
	j765750157 [label="Oui, якби твоя сутність була схожа на Ліона, то я би призначила тобі 10 ударів батогом, щоб спокутувати провину ! Але ти не з таких. Тож тебе пробачено.",shape=box,color=blue];
		j765750157 -> j248401766;
	j1003687633 [label="Oui, пробачаю тобі. Якби твоя сутність була схожа на Ліона, то я би призначила тобі 10 ударів батогом, щоб спокутувати провину.",shape=box,color=blue];
		j1003687633 -> j248401766;
	j2509591298 [label="Та… бувало й ліпше, якщо чесно.",shape=box,color=red];
		j2509591298 -> j1003715529;
	j52022063 [label="Усе гаразд, чесно. А ти, до речі, як?",shape=box,color=red];
		j52022063 -> j3464475523;
	j3778976749 [label="Зараз уже ліпше. Дякую. Гадаю, що сповіді корисні, так?",shape=box,color=red];
		j3778976749 -> j3637665001;
	j327429812 [label="Add -1 to Thermostat counter",color=orange];
		j327429812 -> j3093073510;
	j2914843519 [label="Add 1 to Thermostat counter",color=orange];
		j2914843519 -> j3322209901;
	j394516092 [label="І сподіваюся, що ця погана мить швидко мине для тебе.",shape=box,color=blue];
		j394516092 -> j218280699;
	j1003715529 [label="Qu'y a-t-il ? Що трапилося ?",shape=box,color=blue];
		j1003715529 -> j1944274617;
		j1003715529 -> j451749125;
		j1003715529 -> j2659995145;
		j1003715529 -> j2132800216;
	j3637665001 [label="+5 Chemistry",color=orange];
		j3637665001 -> j1203490222;
	j3093073510 [label="+10 Chemistry",color=orange];
		j3093073510 -> j3961912332;
	j3322209901 [label="+10 Chemistry",color=orange];
		j3322209901 -> j1390916267;
	j218280699 [label="А якщо ні ? То в мене є рішення, яке завше допомагає !",shape=box,color=blue];
		j218280699 -> j2741842295;
	j1203490222 [label="Ха ! Oui, так і є. , Що ж , très bien, рада це чути.",shape=box,color=blue];
		j1203490222 -> j4074678084;
	j3961912332 [label="Oui, але тобі тоді не вдалося б стати тим лихим вовченям, якого ми знаємо й любимо, non ? Гадаю, що Сол поставив тебе саме на те місце, де ти й маєш бути.",shape=box,color=blue];
		j3961912332 -> j1020834853;
	j1390916267 [label="Oui, повністю згодна. Ніхто не народжується для війни. Ну, хіба окрім цих «ґрі-інеррів», про яких мені розповідали. Але навіть і тоді…",shape=box,color=blue];
		j1390916267 -> j2272289974;
	j2741842295 [label="Des pâtisseries !",shape=box,color=blue];
		j2741842295 -> j4132951681;
	j4074678084 [label="О! Обід подано. Я мушу йти. До наступної бесіди, вовченя. Я рада, що ми поспілкувалися.",shape=box,color=blue];
		j4074678084 -> "Chat ends.";
	j1020834853 [label="Але я розумію, що ти маєш на увазі. Ти бачиш структуровані знання та напрямок, які отримало твоє інше я. І нічого не можеш вдіяти, коли жадаєш того ж самого. Особливо тоді, коли тебе огортала самотність.",shape=box,color=blue];
		j1020834853 -> j1899993121;
	j2272289974 [label="Цікаво, чи не пішли б вони іншим шляхом, якби мали реальний вибір ?",shape=box,color=blue];
