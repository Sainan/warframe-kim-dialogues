	j2490476046 [label="Мандрівниче ! Bonjour ! Я дізналася про дещо неймовірне й обов’язково маю тобі про це розповісти.",shape=box,color=blue];
		j2490476046 -> j3505458568;
		j2490476046 -> j1478915251;
	j1955295224 [label="Марі, а можу я спитати дуже особисте питання?",shape=box,color=red];
		j1955295224 -> j2961397627;
