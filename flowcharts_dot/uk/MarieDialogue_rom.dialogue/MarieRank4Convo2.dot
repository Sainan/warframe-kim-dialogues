		j2563733639 -> j312740495 [label="false",color=purple];
	"Chat ends." [color=orange];
	j2498475172 [label="Oui !А тобі відомо, що коли я в польоті, то impossible à voir ?! Je suis invisible !",shape=box,color=blue];
		j2498475172 -> j1344058559;
	j1987284442 [label="+5 Chemistry",color=orange];
		j1987284442 -> j3579892403;
	j186264682 [label="+5 Chemistry",color=orange];
		j186264682 -> j3648719684;
	j772622031 [label="За твоїми ж словами твоя віра схожа на мою, non ? Тоді чому ти віруєш ?",shape=box,color=blue];
		j772622031 -> j898779624;
		j772622031 -> j2667512890;
		j772622031 -> j3856322457;
		j772622031 -> j1915989317;
		j772622031 -> j1770628540;
	j45417332 [label="У тебе ж теж є віра, хоч вона й інша від моєї. Але це все одно віра. То чому ти віруєш ?",shape=box,color=blue];
		j45417332 -> j898779624;
		j45417332 -> j2667512890;
		j45417332 -> j3856322457;
		j45417332 -> j1915989317;
		j45417332 -> j1770628540;
	j2318918910 [label="Я пам’ятаю, що твоя віра — твоя особиста справа. Що твоя une historie пишеться лише тобою. Але це все одно віра. То чому ти віруєш ?",shape=box,color=blue];
		j2318918910 -> j898779624;
		j2318918910 -> j2667512890;
		j2318918910 -> j3856322457;
		j2318918910 -> j1915989317;
		j2318918910 -> j1770628540;
	j2157692152 [label="А ти чого ?",shape=box,color=blue];
		j2157692152 -> j898779624;
		j2157692152 -> j2667512890;
		j2157692152 -> j3856322457;
		j2157692152 -> j1915989317;
		j2157692152 -> j1770628540;
	j581625772 [label="Я можу спитати тебе те саме про Луа, non ? Чому ти віруєш ?",shape=box,color=blue];
		j581625772 -> j898779624;
		j581625772 -> j3856322457;
		j581625772 -> j1915989317;
		j581625772 -> j1770628540;
		j581625772 -> j2667512890;
	j1867754304 [label="Чому саме Солу ? Замість Луа чи рівноваги, якої дотримуєшся ти ? Дуже хороше запитання. А чому ти віруєш ?",shape=box,color=blue];
		j1867754304 -> j898779624;
		j1867754304 -> j2667512890;
		j1867754304 -> j3856322457;
		j1867754304 -> j1915989317;
		j1867754304 -> j1770628540;
	j691117248 [label="Тобі цікаво, що дає мені впевненість ? А хіба не твої слова були про те, що неможливо пізнати всесвіт ?",shape=box,color=blue];
		j691117248 -> j1934251265;
	j37771392 [label="Згодна. Для тих, хто не має віри, це дійсно має видаватися дивним, oui.",shape=box,color=blue];
		j37771392 -> j1310396790;
	j312740495 [label="Тобі цікаво, що дає мені впевненість ?",shape=box,color=blue];
		j312740495 -> j1934251265;
	j1344058559 [label="Ти знаєш що це означає ?!",shape=box,color=blue];
		j1344058559 -> j2222791607;
		j1344058559 -> j1031865341;
	j3579892403 [label="Oui ! Попереджаю, я ненавиджу квіти зі зрізаними ніжками. Якщо прагнеш щось подарувати, то я молитимуся, щоб це були не тоянди у вазі.",shape=box,color=blue];
		j3579892403 -> j3871447683;
		j3579892403 -> j1863570219;
	j3648719684 [label="Pour toi ? Bien sûr.",shape=box,color=blue];
		j3648719684 -> j561368168;
		j3648719684 -> j1478915251;
	j898779624 [label="Припускаю… відчуваю обов’язок.",shape=box,color=red];
		j898779624 -> j3222404579;
	j2667512890 [label="Ті мої слова були не зовсім чесними.",shape=box,color=red];
		j2667512890 -> j395933985;
	j3856322457 [label="У мене був певний досвід. Він змінив моє життя.",shape=box,color=red];
		j3856322457 -> j1987903399;
	j1915989317 [label="Не було ніяких знамень. Просто якесь відчуття. Воно вело мене.",shape=box,color=red];
		j1915989317 -> j359834395;
	j1770628540 [label="Я хочу вірити. Тому й вірую.",shape=box,color=red];
		j1770628540 -> j3080931226;
	j1934251265 [label="Вовченя, боюся мої відповіді тебе розчарують. Не сталося великого дива. Не було променів із небес, які вказали мені шлях.",shape=box,color=blue];
		j1934251265 -> j278068729;
	j1310396790 [label="«Чого б цій усвідомленій молодій жіночці вірити в речі, які я не вважаю реальними. Якась дурня.», non ?",shape=box,color=blue];
		j1310396790 -> j411874461;
		j1310396790 -> j2876122881;
	j2222791607 [label="Ні?",shape=box,color=red];
		j2222791607 -> j2902665462;
	j1031865341 [label="Чи варто мені хвилюватися?",shape=box,color=red];
		j1031865341 -> j3905818247;
	j3871447683 [label="Як ти здогадалася, що я збираюся про це питати? Неймовірно.",shape=box,color=red];
		j3871447683 -> j511208164;
	j1863570219 [label="Це… не зовсім те, про що малося бути моє питання. Але я запам’ятаю, дяк!",shape=box,color=red];
		j1863570219 -> j1696780011;
	j561368168 [label="Чому ти віриш у Сола?",shape=box,color=red];
		j561368168 -> j2563733639;
	j3222404579 [label="Check boolean DrifterFaithNoPeace",color=orange];
		j3222404579 -> j359993705 [label=true,color=green];
		j3222404579 -> j2518813683 [label=false,color=brown];
	j395933985 [label="Oui ? Тоді мені цікаво, задля чого було брехати ?",shape=box,color=blue];
		j395933985 -> j2858324826;
		j395933985 -> j861923275;
	j1987903399 [label="О, я заздрю тобі ! Більшості не так пощастило мати якусь подію, на яку можна вказати так ferme, oui ?",shape=box,color=blue];
		j1987903399 -> j1452487623;
	j359834395 [label="Ага, тоді наші відповіді однакові. Я не засвідчувала якогось un miracle, хіба що прибуття le Cardinale до Cathédrale.",shape=box,color=blue];
		j359834395 -> j430712308;
	j3080931226 [label="Check boolean DrifterFaithNoPeace",color=orange];
		j3080931226 -> j2454749611 [label=true,color=green];
		j3080931226 -> j4081104188 [label=false,color=brown];
	j278068729 [label="Тож non, просто завжди відчувала поруч якусь présence, яка направляла мене. Благовісне щось, що всміхалося й вказувала шлях на перехресті. От і все.",shape=box,color=blue];
		j278068729 -> j2549351446;
		j278068729 -> j2099948977;
	j411874461 [label="Чесно? Ну щось типу того. Хоча моє формулювання було б не зовсім таким.",shape=box,color=red];
		j411874461 -> j789568211;
	j2876122881 [label="Мене більше цікавить те, чи це була якась подія… чи знамення… чи момент, який привів до цього.",shape=box,color=red];
		j2876122881 -> j1934251265;
	j2902665462 [label="І я ні ! Але які ж безмежні можливості постають попереду !",shape=box,color=blue];
		j2902665462 -> j3609174466;
	j3905818247 [label="Peut-être ! Відкриваються безмежні можливості !",shape=box,color=blue];
		j3905818247 -> j3609174466;
	j511208164 [label="Бо диявол нашепотів мені на вушко про твої наміри.",shape=box,color=blue];
		j511208164 -> j1588358494;
	j1696780011 [label="Ой ! Ой, вибач ! Ой, мені так шкода. А в чому було питання ? Et maintenant, je suis mortifiée...",shape=box,color=blue];
		j1696780011 -> j561368168;
		j1696780011 -> j1478915251;
	j359993705 [label="І ти кажеш, що це не приносить тобі жаданого спокою… це розбиває мені серце.",shape=box,color=blue];
		j359993705 -> j2518813683;
	j2518813683 [label="Я не казатиму, що ти маєш робити. І не скажу якого шляху шукати.",shape=box,color=blue];
		j2518813683 -> j4174834139;
	j2858324826 [label="Відверто кажучи, я не маю певності щодо цього. То було імпульсивне рішення.",shape=box,color=red];
		j2858324826 -> j1956424594;
	j861923275 [label="Здалося, що це було непоганою ідеєю пізнати тебе ліпше…",shape=box,color=red];
		j861923275 -> j3145130640;
	j1452487623 [label="Але твоє питання було про те, чому я вірую. І дуже грубо питати у відповідь, je m'excuse.",shape=box,color=blue];
		j1452487623 -> j1934251265;
	j430712308 [label="Але й навіть тоді це було в результаті дій людини й науки, а не Світочів, non ? Sérum дала мені дар польоту…",shape=box,color=blue];
		j430712308 -> j2102913102;
	j2454749611 [label="Але ти кажеш, що це не приносить тобі жаданого спокою ? Це розбиває мені серце…",shape=box,color=blue];
		j2454749611 -> j3640392321;
	j4081104188 [label="Гадаю, твоя віра може бути найсильнішою з них усіх, non ?",shape=box,color=blue];
		j4081104188 -> j2089826204;
	j2549351446 [label="Ти не вважаєш сироватку Ентраті дивом?",shape=box,color=red];
		j2549351446 -> j430712308;
	j2099948977 [label="І що, навіть голоси Ліона чи Байдужість не є дивними дивами?",shape=box,color=red];
		j2099948977 -> j2314960209;
	j789568211 [label="О-о-о, вважати мене простачкою за віру у Світочі — одна з найстриманіших ввічливих думок про людину іншої віри.",shape=box,color=blue];
		j789568211 -> j283856583;
	j3609174466 [label="Бійся, дияволе ! Стережися, злостивцю ! Світло покарає тебе згори !",shape=box,color=blue];
		j3609174466 -> j3982249003;
	j1588358494 [label="Non, non, non Це не це мало бути твоїм питанням, так? А-А-А !!! Je vais lui faire bouffer un de ces livres !",shape=box,color=blue];
		j1588358494 -> j43014605;
	j4174834139 [label="Бо я лише скромний прихисток, знайдений тобою серед бурі Порожнечі.",shape=box,color=blue];
		j4174834139 -> j3266483202;
	j1956424594 [label="Я не знаю, що за інстинкти змусили тебе вчинити саме так. Але рада, що правда нині сказана.",shape=box,color=blue];
		j1956424594 -> j2832042599;
	j3145130640 [label="Ой… тобі не треба казати такі речі, щоби пізнати мене.",shape=box,color=blue];
		j3145130640 -> j2832042599;
	j2102913102 [label="Результат діяльності людини. Але вірю в те, що то саме Сол направляв нас різними шляхами до цієї зустрічі.",shape=box,color=blue];
		j2102913102 -> j1397559069;
	j3640392321 [label="Як на мене, схоже на те, що ти блукаєш серед лісу, відчайдушно намагаючись знайти стежку, яка, по-твоєму, там має бути.",shape=box,color=blue];
		j3640392321 -> j600548783;
	j2089826204 [label="Ідеш стежкою в лісі, маючи надію, що серце вкаже шлях ?",shape=box,color=blue];
		j2089826204 -> j1491585693;
	j2314960209 [label="Може, я не знаю. Може й правду каже диявол і це все результати науки, яку ми ще не розуміємо. Ці речі не взаємозаперечні, non ?",shape=box,color=blue];
		j2314960209 -> j1397559069;
	j283856583 [label="Це мене не ображає, навпаки, я вдячна за чесність. ",shape=box,color=blue];
		j283856583 -> j1934251265;
	j3982249003 [label="+20 Chemistry",color=orange];
		j3982249003 -> j453803941;
	j43014605 [label="То в чому було питання ? Et maintenant, je suis mortifiée...",shape=box,color=blue];
		j43014605 -> j561368168;
		j43014605 -> j1478915251;
	j3266483202 [label="Але мені цікаво, от як ти опинишся на перехресті й не знатимеш, куди йти… що тоді ?",shape=box,color=blue];
		j3266483202 -> j3387128591;
	j2832042599 [label="Душа — дещо більше, аніж у це вкладає віра. Я une Sœur de Sol, та маю сподівання, що ти бачиш щось більше в мені, non ?",shape=box,color=blue];
		j2832042599 -> j2720759628;
	j1397559069 [label="Тому я й вірую. Я відчуваю. що Сол поруч, коли ступаю в незвідані місця, в яких найбільш невпевнена. Тоді я заплющую очі et il est là. І мене ведуть.",shape=box,color=blue];
		j1397559069 -> j2947102116;
		j1397559069 -> j4193873276;
		j1397559069 -> j53908576;
	j600548783 [label="Не знаю, чи тобі колись удасться знайти її, та молитимуся за це. Бо знайдене тобою може бути un miracle. ",shape=box,color=blue];
		j600548783 -> j1452487623;
	j1491585693 [label="Це прекрасно…",shape=box,color=blue];
		j1491585693 -> j1452487623;
	j453803941 [label="Sainte Mère Sol, vous avez béni votre fille aujourd'hui ! ХА-ХА !!",shape=box,color=blue];
		j453803941 -> "Chat ends.";
	j3387128591 [label="Обов’язок не має бути причиною для віри. Він лише породить сумніви в ліпшому випадку. А в найгіршому — холодну зневагу.",shape=box,color=blue];
		j3387128591 -> j4009998355;
	j2720759628 [label="Ще стільки тем інакших можна обрати. Їх так багато, як на небі зірочок !",shape=box,color=blue];
		j2720759628 -> j3913924081;
		j2720759628 -> j1366972893;
	j2947102116 [label="Звучить чудово.",shape=box,color=red];
		j2947102116 -> j3411446182;
	j4193873276 [label="Він коли-небудь помилявся чи відмовляв у настановах?",shape=box,color=red];
		j4193873276 -> j1215912909;
	j53908576 [label="Якби ж то в мене таке було…",shape=box,color=red];
		j53908576 -> j3001988794;
	j4009998355 [label="Віра повинна бути бальзамом для душі. Не костуром і не виправданням.",shape=box,color=blue];
		j4009998355 -> j3352593026;
	j3913924081 [label="То ти мені пробачиш?",shape=box,color=red];
		j3913924081 -> j1840319034;
	j1366972893 [label="Мені шкода. Це була дурість.",shape=box,color=red];
		j1366972893 -> j2031800664;
	j3411446182 [label="Oui, і я знаю як мені пощастило. І це примирення з собою дуже хочеться нав’язати іншим, неважливо, чи бажають вони цього, чи ні.",shape=box,color=blue];
		j3411446182 -> j1832487252;
	j1215912909 [label="Oui, і не раз. У такі миті розмірковую чому саме. Бо маю сама знайти свій власний шлях, non ? Ou peut-être que je suis une folle après tout, ха ! Ми не завжди маємо знати.",shape=box,color=blue];
		j1215912909 -> j1832487252;
	j3001988794 [label="Oui, і я молитимуся, щоб котрогось дня у тебе було таке. Запам’ятай лише — це не те, що можуть дати чи навчити. Це треба відшукати.",shape=box,color=blue];
		j3001988794 -> j458829837;
	j3352593026 [label="Boolean DrifterCrossroads is now true.",color=orange];
		j3352593026 -> j1452487623;
	j1840319034 [label="Oui, пробачаю тобі. Якби твоя сутність була схожа на Ліона, то я призначила б тобі 10 ударів батогом, щоб спокутувати провину.",shape=box,color=blue];
		j1840319034 -> j1314275714;
	j2031800664 [label="Oui, якби твоя сутність була схожа на Ліона, то я призначила б тобі 10 ударів батогом, щоб спокутувати провину ! Але ти не з таких. Тож тебе пробачено.",shape=box,color=blue];
		j2031800664 -> j1314275714;
	j1832487252 [label="Та допоки я не завдаю шкоди нікому своїми віруваннями, то можу спокійно їх мати, oui ?",shape=box,color=blue];
		j1832487252 -> j2462594078;
	j458829837 [label="Це може бути зовні або всередині. Для всіх по різному.",shape=box,color=blue];
		j458829837 -> j2462594078;
	j1314275714 [label="Boolean DrifterFaithBalance is now false.",color=orange];
		j1314275714 -> j2965231836;
	j2462594078 [label="Та останнім часом для мене стало дещо очевидним.",shape=box,color=blue];
		j2462594078 -> j3190510598;
		j2462594078 -> j1021753571;
