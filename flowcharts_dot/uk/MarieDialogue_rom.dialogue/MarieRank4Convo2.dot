	3953 [label="+5 Chemistry",color=orange];
		3953 -> 3954;
	2144 [label="+5 Chemistry",color=orange];
		2144 -> 2149;
	2152 [label="За твоїми ж словами твоя віра схожа на мою, non ? Тоді чому ти віруєш ?",shape=box,color=blue];
		2152 -> 2162;
		2152 -> 2163;
		2152 -> 2164;
		2152 -> 2165;
		2152 -> 2166;
	2153 [label="У тебе ж теж є віра, хоч вона й інша від моєї. Але це все одно віра. То чому ти віруєш ?",shape=box,color=blue];
		2153 -> 2162;
		2153 -> 2163;
		2153 -> 2164;
		2153 -> 2165;
		2153 -> 2166;
	2154 [label="Я пам’ятаю, що твоя віра — твоя особиста справа. Що твоя une historie пишеться лише тобою. Але це все одно віра. То чому ти віруєш ?",shape=box,color=blue];
		2154 -> 2162;
		2154 -> 2163;
		2154 -> 2164;
		2154 -> 2165;
		2154 -> 2166;
	2150 [label="А ти чого ?",shape=box,color=blue];
		2150 -> 2162;
		2150 -> 2163;
		2150 -> 2164;
		2150 -> 2165;
		2150 -> 2166;
	2151 [label="Я можу спитати тебе те саме про Луа, non ? Чому ти віруєш ?",shape=box,color=blue];
		2151 -> 2162;
		2151 -> 2164;
		2151 -> 2165;
		2151 -> 2166;
		2151 -> 2163;
	2155 [label="Чому саме Солу ? Замість Луа чи рівноваги, якої дотримуєшся ти ? Дуже хороше запитання. А чому ти віруєш ?",shape=box,color=blue];
		2155 -> 2162;
		2155 -> 2163;
		2155 -> 2164;
		2155 -> 2165;
		2155 -> 2166;
	2157 [label="Тобі цікаво, що дає мені впевненість ? А хіба не твої слова були про те, що неможливо пізнати всесвіт ?",shape=box,color=blue];
		2157 -> 2168;
	2156 [label="Згодна. Для тих, хто не має віри, це дійсно має видаватися дивним, oui.",shape=box,color=blue];
		2156 -> 2167;
	2158 [label="Тобі цікаво, що дає мені впевненість ?",shape=box,color=blue];
		2158 -> 2168;
	2159 [label="Ти знаєш що це означає ?!",shape=box,color=blue];
		2159 -> 2169;
		2159 -> 2170;
	3954 [label="Oui ! Попереджаю, я ненавиджу квіти зі зрізаними ніжками. Якщо прагнеш щось подарувати, то я молитимуся, щоб це були не тоянди у вазі.",shape=box,color=blue];
		3954 -> 3955;
		3954 -> 3956;
	2149 [label="Pour toi ? Bien sûr.",shape=box,color=blue];
		2149 -> 2160;
		2149 -> 2161;
	2162 [label="Припускаю… відчуваю обов’язок.",shape=box,color=red];
		2162 -> 2172;
	2163 [label="Ті мої слова були не зовсім чесними.",shape=box,color=red];
		2163 -> 2173;
	2164 [label="У мене був певний досвід. Він змінив моє життя.",shape=box,color=red];
		2164 -> 2174;
	2165 [label="Не було ніяких знамень. Просто якесь відчуття. Воно вело мене.",shape=box,color=red];
		2165 -> 2175;
	2166 [label="Я хочу вірити. Тому й вірую.",shape=box,color=red];
		2166 -> 2176;
	2168 [label="Вовченя, боюся мої відповіді тебе розчарують. Не сталося великого дива. Не було променів із небес, які вказали мені шлях.",shape=box,color=blue];
		2168 -> 2179;
	2167 [label="«Чого б цій усвідомленій молодій жіночці вірити в речі, які я не вважаю реальними. Якась дурня.», non ?",shape=box,color=blue];
		2167 -> 2177;
		2167 -> 2178;
	2169 [label="Ні?",shape=box,color=red];
		2169 -> 2180;
	2170 [label="Чи варто мені хвилюватися?",shape=box,color=red];
		2170 -> 2181;
	3955 [label="Як ти здогадалася, що я збираюся про це питати? Неймовірно.",shape=box,color=red];
		3955 -> 3957;
	3956 [label="Це… не зовсім те, про що малося бути моє питання. Але я запам’ятаю, дяк!",shape=box,color=red];
		3956 -> 3958;
	2160 [label="Чому ти віриш у Сола?",shape=box,color=red];
