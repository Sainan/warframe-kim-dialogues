	2172 [label="Check boolean DrifterFaithNoPeace",color=orange];
		2172 -> 2182 [label=true,color=green];
		2172 -> 2183 [label=false,color=brown];
	2173 [label="Oui ? Тоді мені цікаво, задля чого було брехати ?",shape=box,color=blue];
		2173 -> 2184;
		2173 -> 2185;
	2174 [label="О, я заздрю тобі ! Більшості не так пощастило мати якусь подію, на яку можна вказати так ferme, oui ?",shape=box,color=blue];
		2174 -> 2186;
	2175 [label="Ага, тоді наші відповіді однакові. Я не засвідчувала якогось un miracle, хіба що прибуття le Cardinale до Cathédrale.",shape=box,color=blue];
		2175 -> 2187;
	2176 [label="Check boolean DrifterFaithNoPeace",color=orange];
		2176 -> 2188 [label=true,color=green];
		2176 -> 2189 [label=false,color=brown];
	2179 [label="Тож non, просто завжди відчувала поруч якусь présence, яка направляла мене. Благовісне щось, що всміхалося й вказувала шлях на перехресті. От і все.",shape=box,color=blue];
		2179 -> 2191;
		2179 -> 2192;
	2177 [label="Чесно? Ну щось типу того. Хоча моє формулювання було б не зовсім таким.",shape=box,color=red];
		2177 -> 2190;
	2178 [label="Мене більше цікавить те, чи це була якась подія… чи знамення… чи момент, який привів до цього.",shape=box,color=red];
		2178 -> 2168;
	2180 [label="І я ні ! Але які ж безмежні можливості постають попереду !",shape=box,color=blue];
		2180 -> 2193;
	2181 [label="Peut-être ! Відкриваються безмежні можливості !",shape=box,color=blue];
		2181 -> 2193;
	3957 [label="Бо диявол нашепотів мені на вушко про твої наміри.",shape=box,color=blue];
		3957 -> 3959;
	3958 [label="Ой ! Ой, вибач ! Ой, мені так шкода. А в чому було питання ? Et maintenant, je suis mortifiée...",shape=box,color=blue];
		3958 -> 2160;
		3958 -> 2161;
	2171 [label="Chat ends.",color=orange];
	2182 [label="І ти кажеш, що це не приносить тобі жаданого спокою… це розбиває мені серце.",shape=box,color=blue];
		2182 -> 2183;
	2183 [label="Я не казатиму, що ти маєш робити. І не скажу якого шляху шукати.",shape=box,color=blue];
		2183 -> 2194;
	2184 [label="Відверто кажучи, я не маю певності щодо цього. То було імпульсивне рішення.",shape=box,color=red];
		2184 -> 2195;
	2185 [label="Здалося, що це було непоганою ідеєю пізнати тебе ліпше…",shape=box,color=red];
		2185 -> 2196;
	2186 [label="Але твоє питання було про те, чому я вірую. І дуже грубо питати у відповідь, je m'excuse.",shape=box,color=blue];
		2186 -> 2168;
	2187 [label="Але й навіть тоді це було в результаті дій людини й науки, а не Світочів, non ? Sérum дала мені дар польоту…",shape=box,color=blue];
		2187 -> 2197;
	2188 [label="Але ти кажеш, що це не приносить тобі жаданого спокою ? Це розбиває мені серце…",shape=box,color=blue];
		2188 -> 2198;
	2189 [label="Гадаю, твоя віра може бути найсильнішою з них усіх, non ?",shape=box,color=blue];
		2189 -> 2199;
	2191 [label="Ти не вважаєш сироватку Ентраті дивом?",shape=box,color=red];
		2191 -> 2187;
	2192 [label="І що, навіть голоси Ліона чи Байдужість не є дивними дивами?",shape=box,color=red];
		2192 -> 2201;
	2190 [label="О-о-о, вважати мене простачкою за віру у Світочі — одна з найстриманіших ввічливих думок про людину іншої віри.",shape=box,color=blue];
		2190 -> 2200;
	2193 [label="Бійся, дияволе ! Стережися, злостивцю ! Світло покарає тебе згори !",shape=box,color=blue];
		2193 -> 2202;
	3959 [label="Non, non, non Це не це мало бути твоїм питанням, так? А-А-А !!! Je vais lui faire bouffer un de ces livres !",shape=box,color=blue];
		3959 -> 3960;
	2194 [label="Бо я лише скромний прихисток, знайдений тобою серед бурі Порожнечі.",shape=box,color=blue];
		2194 -> 2203;
	2195 [label="Я не знаю, що за інстинкти змусили тебе вчинити саме так. Але рада, що правда нині сказана.",shape=box,color=blue];
		2195 -> 2204;
	2196 [label="Ой… тобі не треба казати такі речі, щоби пізнати мене.",shape=box,color=blue];
		2196 -> 2204;
	2197 [label="Результат діяльності людини. Але вірю в те, що то саме Сол направляв нас різними шляхами до цієї зустрічі.",shape=box,color=blue];
		2197 -> 2205;
	2198 [label="Як на мене, схоже на те, що ти блукаєш серед лісу, відчайдушно намагаючись знайти стежку, яка, по-твоєму, там має бути.",shape=box,color=blue];
		2198 -> 2206;
	2199 [label="Ідеш стежкою в лісі, маючи надію, що серце вкаже шлях ?",shape=box,color=blue];
		2199 -> 2207;
	2201 [label="Може, я не знаю. Може й правду каже диявол і це все результати науки, яку ми ще не розуміємо. Ці речі не взаємозаперечні, non ?",shape=box,color=blue];
		2201 -> 2205;
	2200 [label="Це мене не ображає, навпаки, я вдячна за чесність. ",shape=box,color=blue];
		2200 -> 2168;
	2202 [label="+20 Chemistry",color=orange];
		2202 -> 2208;
	3960 [label="То в чому було питання ? Et maintenant, je suis mortifiée...",shape=box,color=blue];
		3960 -> 2160;
		3960 -> 2161;
	2203 [label="Але мені цікаво, от як ти опинишся на перехресті й не знатимеш, куди йти… що тоді ?",shape=box,color=blue];
		2203 -> 2209;
	2204 [label="Душа — дещо більше, аніж у це вкладає віра. Я une Sœur de Sol, та маю сподівання, що ти бачиш щось більше в мені, non ?",shape=box,color=blue];
		2204 -> 2210;
	2205 [label="Тому я й вірую. Я відчуваю. що Сол поруч, коли ступаю в незвідані місця, в яких найбільш невпевнена. Тоді я заплющую очі et il est là. І мене ведуть.",shape=box,color=blue];
		2205 -> 2211;
		2205 -> 2212;
		2205 -> 2213;
	2206 [label="Не знаю, чи тобі колись удасться знайти її, та молитимуся за це. Бо знайдене тобою може бути un miracle. ",shape=box,color=blue];
		2206 -> 2186;
	2207 [label="Це прекрасно…",shape=box,color=blue];
		2207 -> 2186;
	2208 [label="Sainte Mère Sol, vous avez béni votre fille aujourd'hui ! ХА-ХА !!",shape=box,color=blue];
		2208 -> 2214;
	2209 [label="Обов’язок не має бути причиною для віри. Він лише породить сумніви в ліпшому випадку. А в найгіршому — холодну зневагу.",shape=box,color=blue];
		2209 -> 2215;
	2210 [label="Ще стільки тем інакших можна обрати. Їх так багато, як на небі зірочок !",shape=box,color=blue];
		2210 -> 2216;
		2210 -> 2217;
	2211 [label="Звучить чудово.",shape=box,color=red];
		2211 -> 2218;
	2212 [label="Він коли-небудь помилявся чи відмовляв у настановах?",shape=box,color=red];
		2212 -> 2219;
	2213 [label="Якби ж то в мене таке було…",shape=box,color=red];
		2213 -> 2220;
	2214 [label="Chat ends.",color=orange];
	2215 [label="Віра повинна бути бальзамом для душі. Не костуром і не виправданням.",shape=box,color=blue];
		2215 -> 2221;
	2216 [label="То ти мені пробачиш?",shape=box,color=red];
		2216 -> 2222;
	2217 [label="Мені шкода. Це була дурість.",shape=box,color=red];
		2217 -> 2223;
	2218 [label="Oui, і я знаю як мені пощастило. І це примирення з собою дуже хочеться нав’язати іншим, неважливо, чи бажають вони цього, чи ні.",shape=box,color=blue];
		2218 -> 2224;
	2219 [label="Oui, і не раз. У такі миті розмірковую чому саме. Бо маю сама знайти свій власний шлях, non ? Ou peut-être que je suis une folle après tout, ха ! Ми не завжди маємо знати.",shape=box,color=blue];
		2219 -> 2224;
	2220 [label="Oui, і я молитимуся, щоб котрогось дня у тебе було таке. Запам’ятай лише — це не те, що можуть дати чи навчити. Це треба відшукати.",shape=box,color=blue];
		2220 -> 2225;
	2221 [label="Update boolean DrifterCrossroads",color=orange];
		2221 -> 2186;
	2222 [label="Oui, пробачаю тобі. Якби твоя сутність була схожа на Ліона, то я призначила б тобі 10 ударів батогом, щоб спокутувати провину.",shape=box,color=blue];
		2222 -> 2226;
	2223 [label="Oui, якби твоя сутність була схожа на Ліона, то я призначила б тобі 10 ударів батогом, щоб спокутувати провину ! Але ти не з таких. Тож тебе пробачено.",shape=box,color=blue];
		2223 -> 2226;
	2224 [label="Та допоки я не завдаю шкоди нікому своїми віруваннями, то можу спокійно їх мати, oui ?",shape=box,color=blue];
		2224 -> 2227;
	2225 [label="Це може бути зовні або всередині. Для всіх по різному.",shape=box,color=blue];
		2225 -> 2227;
	2226 [label="Update boolean DrifterFaithBalance",color=orange];
		2226 -> 2228;
	2227 [label="Та останнім часом для мене стало дещо очевидним.",shape=box,color=blue];
		2227 -> 2229;
		2227 -> 2230;
