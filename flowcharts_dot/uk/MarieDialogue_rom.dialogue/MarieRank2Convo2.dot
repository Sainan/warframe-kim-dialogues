digraph {
	graph [fontname="Roboto Condensed"];
	node [fontname="Roboto Condensed"];
	edge [fontname="Roboto Condensed"];

	"MarieRank2Convo2 begins." [color=orange];
		"MarieRank2Convo2 begins." -> j2631732658;
		"MarieRank2Convo2 begins." -> j1293551403;
		"MarieRank2Convo2 begins." -> j1478915251;
	j2631732658 [label="Як ти познайомилася з Ентраті?",shape=box,color=red];
		j2631732658 -> j538231631;
	j1293551403 [label="Чи можу я спитати, як ти вже тут, яке твоє ставлення до Ентраті?",shape=box,color=red];
		j1293551403 -> j2238744250;
	j1478915251 [label="[Завершити розмову]",shape=box,color=red];
		j1478915251 -> "Chat ends.";
	j538231631 [label="Я знала його як le Cardinal Dimanche. Ти, певно, здивуєшся, коли дізнаєшся, скільки років він проповідував нашій пастві у церкві.",shape=box,color=blue];
		j538231631 -> j3885943057;
		j538231631 -> j2440054903;
	j2238744250 [label="+5 Chemistry",color=orange];
		j2238744250 -> j3541528309;
	"Chat ends." [color=orange];
	j3885943057 [label="Гадаєш, то все була брехня? Чи він вірив у все те?",shape=box,color=red];
		j3885943057 -> j3138434042;
	j2440054903 [label="Ні, не здивуюся. Він умілий брехун.",shape=box,color=red];
		j2440054903 -> j500581004;
	j3541528309 [label="Гм. Дуже виважене запитання, яке приховує вимогу в дуже непростій відповіді — визнаю, вишукано кмітливий порядок слів.",shape=box,color=blue];
		j3541528309 -> j3746737673;
	j3138434042 [label="Він говорив про прощення, про родину й емпатію з таким відданим запалом, що мені невтямки, як подібне можна зіграти.",shape=box,color=blue];
		j3138434042 -> j3732436893;
	j500581004 [label="Я усвідомлюю, що твої враження від нього не схожі на мої. Але ти маєш зрозуміти, що для мене він був утіленням добра й дбайливості.",shape=box,color=blue];
		j500581004 -> j1030901;
	j3746737673 [label="Так само, як і першого дня, коли бачила його за виголошенням проповіді з катедри. Як і всі парафіяни, я благословенна за можливість побувати в його présence.",shape=box,color=blue];
		j3746737673 -> j2806637106;
		j3746737673 -> j2491546463;
		j3746737673 -> j3886409685;
	j3732436893 [label="Чи вірує він у Світочі ? У Сола й Луа ? Я цього вже не стверджуватиму, бо знаю, звідки й відколи він походить. Peu importe.",shape=box,color=blue];
		j3732436893 -> j2406763331;
	j1030901 [label="Твої істини хіба заперечують мої ? Кому я маю вірити ? Я мушу засуджувати кожен вияв милосердя, кожен ніжний жест, які він робив за роки служіння парафії ?",shape=box,color=blue];
		j1030901 -> j1713160669;
	j2806637106 [label="Читаю це й сповнююся радості. Чесно. Гадаю, усі занадто квапливо висувають йому звинувачення.",shape=box,color=red];
		j2806637106 -> j2035126139;
	j2491546463 [label="Гадаєш, то все було обманом людей? Чи він вірив у все те?",shape=box,color=red];
		j2491546463 -> j3138434042;
	j3886409685 [label="Мені… шкода, що ти повелася на його фокуси.",shape=box,color=red];
		j3886409685 -> j500581004;
	j2406763331 [label="Яка різниця в іменах богів, котрим ти молишся, якщо твоє серце сповнене їхньою любов’ю ? Жодної, відповім я.",shape=box,color=blue];
		j2406763331 -> j2792320536;
		j2406763331 -> j2212918532;
	j1713160669 [label="Ні, вважаю, що ні.",shape=box,color=blue];
		j1713160669 -> j1554268995;
	j2035126139 [label="+10 Chemistry",color=orange];
		j2035126139 -> j2600085035;
	j2792320536 [label="Дуже милий погляд на це. ",shape=box,color=red];
		j2792320536 -> j3064805307;
	j2212918532 [label="Не погоджуюся. Якщо я добра особа, то це не записує мене одразу до послідовників бога доброти.",shape=box,color=red];
		j2212918532 -> j3878432020;
	j1554268995 [label="Ти пробач, але я не робитиму з нього чудовисько лише тому, що ти так говориш.",shape=box,color=blue];
		j1554268995 -> j2209081154;
	j2600085035 [label="Boolean MarieEntratiFan1 is now true.",color=orange];
		j2600085035 -> j3227282743;
	j3064805307 [label="Я вірю, що le Cardinal справді в душі несе віру у Світочі, навіть якщо він і насправді не вірить, то вони однак чекають його в післясмерті.",shape=box,color=blue];
		j3064805307 -> j3207019296;
	j3878432020 [label="+5 Chemistry",color=orange];
		j3878432020 -> j403326617;
	j2209081154 [label="Boolean MarieEntratiMonster1 is now true.",color=orange];
		j2209081154 -> "Chat ends.";
	j3227282743 [label="О ! Моє серце мліє від прочитаного. Я думала, що в такому ставленні я одна-однісінька. Мене оточують лише ті, хто думають недобре про le Cardinal.",shape=box,color=blue];
		j3227282743 -> j2914505336;
		j3227282743 -> j2586784909;
		j3227282743 -> j3038650924;
	j3207019296 [label="Бо хто ж іще знає цінність емпатії в протиставленні темряві l'Indifférence, non ?",shape=box,color=blue];
		j3207019296 -> j2413258194;
	j403326617 [label="Твоя правда, не записує. Я не називатиму нікого послідовниками Сола, якщо вони неусвідомлено йдуть Його шляхом. Що більше добра у світі, то ліпше для світу. Мені байдуже, на честь кого це добро зроблене.",shape=box,color=blue];
		j403326617 -> j2604540318;
	j2914505336 [label="Я просто хочу, щоб існував спосіб змусити їх усіх пробачити його — адже він усе можливе робить, щоб усе виправити.",shape=box,color=red];
		j2914505336 -> j3724486826;
	j2586784909 [label="У них є свої причини. Але він — наш єдиний шанс зупинити Байдужість.",shape=box,color=red];
		j2586784909 -> j3905378531;
	j3038650924 [label="Знаєш, Ентраті взагалі-то теж не надто високої думки про самого себе. ",shape=box,color=red];
		j3038650924 -> j2488657384;
	j2413258194 [label="Check boolean DrifterFaithNoMITW",color=orange];
		j2413258194 -> j1113986121 [label=true,color=green];
		j2413258194 -> j3114445314 [label=false,color=brown];
	j2604540318 [label="Тож я вважаю le Cardinal благословенним, навіть якщо він і не зовсім дотримується віри з тою назвою, яку для неї маю я.",shape=box,color=blue];
		j2604540318 -> j3207019296;
	j3724486826 [label="Add 1 to Thermostat counter",color=orange];
		j3724486826 -> j3917476823;
	j3905378531 [label="Add -1 to Thermostat counter",color=orange];
		j3905378531 -> j3174004880;
	j2488657384 [label="Oui, et comme c'est tragique… Навертаються сльози, коли думаю про це. І про монсеньйора Лойда, залишеного напризволяще, покинутого коханця.",shape=box,color=blue];
		j2488657384 -> j931916194;
	j1113986121 [label="Пробач мені, бо я забула… ти ж не віриш, що та твоя l'Indifférence реальна. Вважає її галюцинацією. Але ж ти віриш в емоції, які вона викликає, oui ?",shape=box,color=blue];
		j1113986121 -> j4155436304;
		j1113986121 -> j4090363563;
	j3114445314 [label="Я бачу ідеал у тому, що він проповідує тексти, які по суті йдуть противагою тому, що він же ж і випустив, n'est-ce pas ?",shape=box,color=blue];
		j3114445314 -> j641439510;
		j3114445314 -> j4095908247;
		j3114445314 -> j615260628;
	j3917476823 [label="Oui, і я вважаю, що саме для цієї пригоди нас тут усіх зібрали.",shape=box,color=blue];
		j3917476823 -> j931916194;
	j3174004880 [label="Oui, але битву супроти l'Indifférence не виграти лише мечами й каменями. Її виграють серцем, хіба ти не бачиш?",shape=box,color=blue];
		j3174004880 -> j931916194;
	j931916194 [label="Це ж не орокінського диявола він хоче, щоб ми пробачили, non ? Це сам le Cardinal, так усе стає зрозумілішим. І, на мою думку, це любов монсеньйора Лойда надихає його.",shape=box,color=blue];
		j931916194 -> j439644510;
	j4155436304 [label="Усі емоції служать певній меті, навіть байдужість.",shape=box,color=red];
		j4155436304 -> j869285616;
	j4090363563 [label="Так. І це мене підвело в Дувірі. Апатія отримала дозвіл пожирати мене, допоки не лишилася єдиною з усіх.",shape=box,color=red];
		j4090363563 -> j3944330677;
	j641439510 [label="Якби ж то мені знати як можна допомогти залагодити проблеми.",shape=box,color=red];
		j641439510 -> j3144222715;
	j4095908247 [label="Хотілося б мені, щоб у нього був ліпший план, а не «проповіді».",shape=box,color=red];
		j4095908247 -> j1334714210;
	j615260628 [label="Ну, з огляду на те, що це його провина в поширенні тієї штуки… то так. Це найменше, що він міг зробити.",shape=box,color=red];
		j615260628 -> j2566077477;
	j439644510 [label="Це крає моє серце. Нічого більшого мені й не треба — лише побачити їхнє возз’єднання !",shape=box,color=blue];
		j439644510 -> j1883771239;
		j439644510 -> j1066042782;
	j869285616 [label="Звісно, що служить меті. Je ne le nie pas.",shape=box,color=blue];
		j869285616 -> j482466410;
	j3944330677 [label="+5 Chemistry",color=orange];
		j3944330677 -> j82393675;
	j3144222715 [label="+5 Chemistry",color=orange];
		j3144222715 -> j1883094294;
	j1334714210 [label="І хто ж ми такі, щоб засуджувати його методи ? Le Cardinal Dimanche — геній, благословенний Світочами. Він поведе нас.",shape=box,color=blue];
		j1334714210 -> j719143192;
		j1334714210 -> j105082398;
	j2566077477 [label="Стеж за тим, що друкуєш. Le Cardinal Dimanche — геній, благословенний Світочами. Він поведе нас.",shape=box,color=blue];
		j2566077477 -> j3292716323;
		j2566077477 -> j719143192;
		j2566077477 -> j105082398;
	j1883771239 [label="Я… гадаю, що є ще незакрите питання матері Матері… себто дружини Ентраті.",shape=box,color=red];
		j1883771239 -> j1149022198;
	j1066042782 [label="Думаю, це лише справа часу. ",shape=box,color=red];
		j1066042782 -> j3578744275;
	j482466410 [label="Знаєш, я ж не звинувачую тебе.",shape=box,color=blue];
		j482466410 -> j12357000;
		j482466410 -> j3525348370;
	j82393675 [label="Oui, oui… я чула від інших про цей створений тобою світ. Де тобі довелося бути на самоті, де не було нікого, щоб звернутися.",shape=box,color=blue];
		j82393675 -> j482466410;
	j1883094294 [label="Le Cardinal Dimanche — геній, благословенний Світочами. Він поведе нас.",shape=box,color=blue];
		j1883094294 -> j2323033860;
		j1883094294 -> j719143192;
		j1883094294 -> j105082398;
	j719143192 [label="Ентраті всього-на-всього людина, і ніщо більше. І він навіть не кардинал ніякий.",shape=box,color=red];
		j719143192 -> j315584799;
	j105082398 [label="Думаєш, мати таку віру в нього — це мудро?",shape=box,color=red];
		j105082398 -> j1986297819;
	j3292716323 [label="Мені шкода. Я розділяю твою віру в нього.",shape=box,color=red];
		j3292716323 -> j3510286383;
	j1149022198 [label="А ми знаємо, чи вона жива ? Чи що з нею сталося ?",shape=box,color=blue];
		j1149022198 -> j2602041726;
		j1149022198 -> j2066529827;
	j3578744275 [label="+5 Chemistry",color=orange];
		j3578744275 -> j81887216;
	j12357000 [label="Припускаю, що це твоя рольова модель? Пробачати?",shape=box,color=red];
		j12357000 -> j3299011547;
	j3525348370 [label="Звинувачувати мене? За що чи в чому?",shape=box,color=red];
		j3525348370 -> j1826350200;
	j2323033860 [label="Я розділяю твою віру в нього.",shape=box,color=red];
		j2323033860 -> j3757835200;
	j315584799 [label="Так. А ти — часомандрівне створіння з Порожнечі, яке може зациклити час і створювати всесвіти з цілісною реальністю.",shape=box,color=blue];
		j315584799 -> j1176933671;
	j1986297819 [label="Evaluate expressions",color=orange];
		j1986297819 -> j3467777792 [label="DrifterFaithYesSimilar",color=purple];
		j1986297819 -> j3467777792 [label="DrifterFaithYesForeign",color=purple];
		j1986297819 -> j3467777792 [label="DrifterFaithPersonal",color=purple];
		j1986297819 -> j3467777792 [label="DrifterFaithSol",color=purple];
		j1986297819 -> j3467777792 [label="DrifterFaithLua",color=purple];
		j1986297819 -> j3467777792 [label="DrifterFaithBalance",color=purple];
		j1986297819 -> j2990151098 [label="false",color=purple];
	j3510286383 [label="Я рада це чути. Бо знаю, що причин для цього в тебе дрібка. Кавії мені розповідали.",shape=box,color=blue];
		j3510286383 -> j879010410;
	j2602041726 [label="Ми можемо… припустити, що вона мертва, імовірно.",shape=box,color=red];
		j2602041726 -> j1110213184;
	j2066529827 [label="Ні. І схоже, що ніхто не хоче про неї говорити.",shape=box,color=red];
		j2066529827 -> j1110213184;
	j81887216 [label="Ми повинні зберегти віру. Бо як утратимо надію, що любов здолає все, то темрява переможе.",shape=box,color=blue];
		j81887216 -> j2211772158;
	j3299011547 [label="Я думаю, ти дуже сильно здивуєшся, коли взнаєш, наскільки мало в цьому моєї вини. ",shape=box,color=blue];
		j3299011547 -> j3867119321;
	j1826350200 [label="За невіру. У l'Indifférence. Узагалі у будь-що. Якби я створила світ du tissu du Néant… із подолу Порожнечі. То, певно, теж почувалася б так само.",shape=box,color=blue];
		j1826350200 -> j3867119321;
	j3757835200 [label="+5 Chemistry",color=orange];
		j3757835200 -> j3510286383;
	j1176933671 [label="Я стою поруч із дияволом, який прожив незчисленну кількість століть. Неподалік жінка, яка є машиною з душами трьох богинь по власній волі.",shape=box,color=blue];
		j1176933671 -> j116279314;
	j3467777792 [label="Ха! Та тобі ж ліпше за всіх інших слід знати, що віра ніколи не буває мудрою. Однак душі, подібно нашим, містять її… попри те, що вона опаляє нас. Очікувала, що ти це знаєш, якщо наша попереднє листування було правдивим.",shape=box,color=blue];
		j3467777792 -> j2356643789;
		j3467777792 -> j2370027688;
	j2990151098 [label="Віра ніколи не буває мудрою. Але ті з нас, хто несе її як смолоскип, ті прагнуть нести його вічно… хоча полум'я може й спалити нас.",shape=box,color=blue];
		j2990151098 -> j1049708961;
	j879010410 [label="Boolean MarieEntratiFan1 is now true.",color=orange];
		j879010410 -> j1185699525;
	j1110213184 [label="Тобі хіба не спадало на думку, що чиєсь серце може належати більше ніж одній душі ? Що хтось може любити більше ніж одну особу ?",shape=box,color=blue];
		j1110213184 -> j1580169076;
		j1110213184 -> j4178981367;
	j2211772158 [label="Любов — єдине, що лишається у світі, коли все інше не спрацьовує, non ?",shape=box,color=blue];
		j2211772158 -> j2923753923;
	j3867119321 [label="Всеосяжне прощення — не те, чого слід очікувати й прагнути від інших. Навіть від самих Світочів.",shape=box,color=blue];
		j3867119321 -> j2523302167;
		j3867119321 -> j306633431;
	j116279314 [label="Мій брат чує голоси мертвих і богів.",shape=box,color=blue];
		j116279314 -> j4044923773;
	j2356643789 [label="Іноді я розмірковую над тим, чи не був мій вибір дурістю — нести те, що може нашкодити мені.",shape=box,color=red];
		j2356643789 -> j1778710598;
	j2370027688 [label="Іноді стає цікаво… чого ми взагалі її несемо.",shape=box,color=red];
		j2370027688 -> j2809106877;
	j1049708961 [label="Мені цікаво, нащо ж її узагалі нести?",shape=box,color=red];
		j1049708961 -> j643335128;
	j1185699525 [label="Evaluate expressions",color=orange];
		j1185699525 -> j3715681794 [label="DrifterFaithYesSimilar",color=purple];
		j1185699525 -> j3715681794 [label="DrifterFaithYesForeign",color=purple];
		j1185699525 -> j3715681794 [label="DrifterFaithPersonal",color=purple];
		j1185699525 -> j3715681794 [label="DrifterFaithSol",color=purple];
		j1185699525 -> j3715681794 [label="DrifterFaithLua",color=purple];
		j1185699525 -> j3715681794 [label="DrifterFaithBalance",color=purple];
		j1185699525 -> j163928404 [label="DrifterFaithAgnostic",color=purple];
		j1185699525 -> j1214054944 [label="DrifterFaithNoFear",color=purple];
		j1185699525 -> j163928404 [label="DrifterFaithNoMaybe",color=purple];
		j1185699525 -> j419118898 [label="false",color=purple];
	j1580169076 [label="Узагалі-то ні.",shape=box,color=red];
		j1580169076 -> j4090960415;
	j4178981367 [label="Так, спадало. Буває. Якщо всіх учасників влаштовує, то чому б і ні. ",shape=box,color=red];
		j4178981367 -> j667433040;
	j2923753923 [label="О ! Але ж ти тут заради історії ! Я й так забрала в тебе багато часу, тож спробую коротко.",shape=box,color=blue];
		j2923753923 -> j1501763513;
	j2523302167 [label="Цікаво. Що наштовхнуло тебе на ці слова?",shape=box,color=red];
		j2523302167 -> j3569813583;
	j306633431 [label="Навіть якщо з кимось вчиняєш неправильно?",shape=box,color=red];
		j306633431 -> j3274365459;
	j4044923773 [label="Я перестала постувати після того, як тварини спиталися мене про якість мого відпочинку.",shape=box,color=blue];
		j4044923773 -> j1919535659;
	j1778710598 [label="Add 1 to Thermostat counter",color=orange];
		j1778710598 -> j643335128;
	j2809106877 [label="Add -1 to Thermostat counter",color=orange];
		j2809106877 -> j4202097526;
	j643335128 [label="Ми несемо, бо мусимо. Бо ми не знаємо іншого способу існування. І не важливо, що це означатиме потім. Мені відомі твої відчуття.",shape=box,color=blue];
		j643335128 -> j1878719763;
	j3715681794 [label="Віра для душ, подібних нашим, як той смолоскип — ми завжди несемо її, хоча полум'я може й спалити нас врешті-решт.",shape=box,color=blue];
		j3715681794 -> j2370027688;
		j3715681794 -> j2356643789;
	j163928404 [label="Однак я здивована. Раніше в тобі були сумніви стосовно віри.",shape=box,color=blue];
		j163928404 -> j523514993;
		j163928404 -> j1223128532;
	j1214054944 [label="Однак я здивована. Раніше в тобі проявлялася лише дрібка віри.",shape=box,color=blue];
		j1214054944 -> j523514993;
		j1214054944 -> j1223128532;
	j419118898 [label="Віра для душ, подібних моїй, як той смолоскип — ми завжди несемо її, хоча полум’я може й спалити нас врешті-решт.",shape=box,color=blue];
		j419118898 -> j1049708961;
	j4090960415 [label="Boolean DrifterPNo is now true.",color=orange];
		j4090960415 -> j3242800623;
	j667433040 [label="Boolean DrifterPYes is now true.",color=orange];
		j667433040 -> j3242800623;
	j1501763513 [label="Це була прекрасна сонячна післяобідня пора. Я пам'ятаю, як він стояв навпроти вівтаря й дивився на вітражі з усмішкою. Але чому всміхався, я не знаю.",shape=box,color=blue];
		j1501763513 -> j3425649455;
	j3569813583 [label="Не зрозумій неправильно, шукати спосіб залагодити завдану шкоду дуже важливо. Прощення від тих, хто зазнав шкоди, якщо є можливим — це приємний бальзам для душі.",shape=box,color=blue];
		j3569813583 -> j49742419;
	j3274365459 [label="Ем, я не маю на увазі, що просити прощення у тих, кого ображаєш, не важливо! Це важливо !",shape=box,color=blue];
		j3274365459 -> j770109588;
	j1919535659 [label="Наступного разу, коли спробуєш знову написати щось про «простих людей», присягаюся, я докладу всіх зусиль, аби не реготати.",shape=box,color=blue];
		j1919535659 -> j4074498913;
	j4202097526 [label="Віра не є константою. Вона непостійна, наче хвиля. Приходить і йде, і це правильно.",shape=box,color=blue];
		j4202097526 -> j1878719763;
	j1878719763 [label="Та… Мені видається, що ти тут зі мною не за ті теми прагнеш поспілкуватися. Тобі потрібна історія, non ?",shape=box,color=blue];
		j1878719763 -> j1501763513;
	j523514993 [label="Я по різному можу вірити в людей і богів.",shape=box,color=red];
		j523514993 -> j3203148104;
	j1223128532 [label="Є різниця між вірою в богів і вірою в людей. А Ентраті — просто людина.",shape=box,color=red];
		j1223128532 -> j315584799;
	j3242800623 [label="Цікаво. Мені недостатньо добре відомі традиції орокінів, щоб означити, чи це не було суперечливим їхнім звичаям. Але я знаю чимало прадавніх культур, де це не схвалювалося.",shape=box,color=blue];
		j3242800623 -> j3681563837;
	j3425649455 [label="Він присів, щоби привітати мене. Тож його голова була нижче моєї, хоч я була в кріслі.",shape=box,color=blue];
		j3425649455 -> j855846236;
	j49742419 [label="Але в кінці, коли ми зустрічаємося з Каргою, коли Луа проливає свої срібні сльози за нами, а смерть осьдечки… ось тоді ми маємо нести тягар власного серця.",shape=box,color=blue];
		j49742419 -> j1732189592;
		j49742419 -> j939253592;
	j770109588 [label="Залагодження шкоди, яку хтось спричинив, може стати ще приємнішим бальзамом для душі. ",shape=box,color=blue];
		j770109588 -> j49742419;
	j4074498913 [label="А доти я рекомендую перечитати в словниках значення «бути благословенним». Прощавай.",shape=box,color=blue];
		j4074498913 -> "Chat ends.";
	j3203148104 [label="Oui, одне реальне. Присутнє. А інше потребує заплющених очей і віри. ",shape=box,color=blue];
		j3203148104 -> j1878719763;
	j3681563837 [label="Але чи це нам вирішувати… у цім випадку я не судитиму виявів любові le Cardinal до монсеньйора Лойда, ані слів кохання монсеньйора Лойда у відповідь.",shape=box,color=blue];
		j3681563837 -> j3214091205;
	j855846236 [label="Boolean MarieEntrati1 is now true.",color=orange];
		j855846236 -> j1293800692;
		j855846236 -> j2302997357;
		j855846236 -> j674940582;
	j1732189592 [label="Якщо тобі потрібно пробачити собі чи інших, щоби померти «в мирі», то хай так і буде. Мені ж цього не треба.",shape=box,color=red];
		j1732189592 -> j1031818444;
	j939253592 [label="Якщо в кінці, коли всі інші пробачать тобі, але ти не зможеш знайти прощення собі, то це те саме, що й ніхто не пробачив.",shape=box,color=red];
		j939253592 -> j3818186900;
	j3214091205 [label="Я можу лише вважати їх справжніми. Хто я така, щоби твердити їхню нещирість ?",shape=box,color=blue];
		j3214091205 -> j2211772158;
	j1293800692 [label="Марі, він може бути дуже хитрим і маніпулятивним.",shape=box,color=red];
		j1293800692 -> j2899515025;
	j2302997357 [label="Він був добрим до тебе, а інші ні?",shape=box,color=red];
		j2302997357 -> j2899515025;
	j674940582 [label="А як би Ліон розповів цю історію?",shape=box,color=red];
		j674940582 -> j3970801349;
