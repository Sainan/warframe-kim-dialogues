	j4010203057 [label="Add 1 to Thermostat counter",color=orange];
		j4010203057 -> j1131462524;
	j3149178775 [label="Oui. Саме так. Деякі, достоту як і ти, звали мене «інвалідкою». Кимось, кого треба пожаліти чи образити. Але le Cardinal такого не робив.",shape=box,color=blue];
		j3149178775 -> j667332290;
		j3149178775 -> j3531403204;
	j2645178573 [label="Oui. Саме так. Деякі звали мене «інвалідкою». Кимось, кого треба пожаліти чи образити. Але le Cardinal такого не робив.",shape=box,color=blue];
		j2645178573 -> j3791633575;
		j2645178573 -> j2631599738;
	j1939197471 [label="Прошу… Благаю, не думай так ницо про мого дорогого Ліона. Він не infirme, я присягаюся. Те, що гнітить його, це не une maladie de l'esprit.",shape=box,color=blue];
		j1939197471 -> j3015804766;
	j4112586830 [label="Я можу лише поважати твої переконання. Навіть тоді, коли не згодна з ними.",shape=box,color=blue];
		j4112586830 -> j371285337;
	j1131462524 [label="Oui, саме так. Якщо ти підеш у потойбіччя з тягарем на серці, то душа не зможе здійнятися.",shape=box,color=blue];
		j1131462524 -> j478472159;
	j667332290 [label="Перепрошую, мені вдалося тебе чимось уже образити?",shape=box,color=red];
		j667332290 -> j245753992;
	j3531403204 [label="Я… мені дуже шкода і я щиро перепрошую за це. Ніколи не спадало на думку образити тебе.",shape=box,color=red];
		j3531403204 -> j1484902781;
	j3791633575 [label="І ти не вважаєш, що це було оманою?",shape=box,color=red];
		j3791633575 -> j3938495949;
	j2631599738 [label="Люди можуть бути дуже жорстокими…",shape=box,color=red];
		j2631599738 -> j1029641545;
	j3015804766 [label="Він іноді бачить дещо або пам’ятає дещо, як воно відчувалося чи як воно малося бути за словами духів. І можливо, не таким як воно було.",shape=box,color=blue];
		j3015804766 -> j2554506884;
	j371285337 [label="Гадаю, що le Cardinal зрозумів, що не можна йти в потойбіччя з тягарем на серці. І саме тому прийшов до нас.",shape=box,color=blue];
		j371285337 -> j1501763513;
	j478472159 [label="Гадаю, що le Cardinal знав це. І саме тому прийшов до нас.",shape=box,color=blue];
		j478472159 -> j1501763513;
	j245753992 [label="Oui.",shape=box,color=blue];
		j245753992 -> j1508231473;
	j1484902781 [label="Усе гаразд. Інші занадто радо ставилися до мене інакше, бо mes pieds не такі, як в інших, бо я не можу існувати у світі, так само як вони.",shape=box,color=blue];
		j1484902781 -> j3366274487;
	j3938495949 [label="Навіть якби й так, то я радо б вітала її кожного дня свого життя. Інші занадто радо ставилися до мене інакше, бо mes pieds не такі як в інших, бо я не можу існувати у світі, так само як вони.",shape=box,color=blue];
		j3938495949 -> j3534213110;
	j1029641545 [label="Oui, вони можуть. Інші занадто радо ставилися до мене інакше, бо mes pieds не такі, як в інших, бо я не можу існувати у світі, так само як вони.",shape=box,color=blue];
		j1029641545 -> j3534213110;
	j2554506884 [label="Коли він обере час і змогу спілкуватися з тобою, щоб не сказав про ті події — то буде так, як він сприймав це. І в його серці це вважатиметься істинною правдою.",shape=box,color=blue];
		j2554506884 -> j2380875190;
	j1508231473 [label="Boolean MarieNoDate is now true.",color=orange];
		j1508231473 -> "Chat ends.";
	j3366274487 [label="Boolean MarieInvalid is now false.",color=orange];
		j3366274487 -> j3529974525;
	j3534213110 [label="Я маю визнати, що навіть натяк на думку про те, що мене зневажають, дратує мене. Або ще гірше, думка про те, що мене обожнюють ! Пф-ф-ф !",shape=box,color=blue];
		j3534213110 -> j55422052;
	j2380875190 [label="Ми з ним… схожі. Схожі в тому, що інші занадто радо ставляться до нас по-інакшому.",shape=box,color=blue];
		j2380875190 -> j4070697062;
		j2380875190 -> j1707821982;
	j3529974525 [label="Я пробачаю тобі. Маю визнати, що навіть натяк на думку про те, що мене зневажають, дратує мене. Або ще гірше, думка про те, що мене обожнюють !",shape=box,color=blue];
		j3529974525 -> j55422052;
	j55422052 [label="Саме тому présence le Cardinal була такою бажаною в моєму житті. Він приніс неймовірне тепло. І ніколи не виявив зневаги чи жалю. Ні разу не дивився на мене як на une invalide.",shape=box,color=blue];
		j55422052 -> j1424909180;
	j4070697062 [label="Люди можуть бути жорстокими. ",shape=box,color=red];
		j4070697062 -> j449758430;
	j1707821982 [label="Що ти маєш на увазі?",shape=box,color=red];
		j1707821982 -> j1761535860;
	j1424909180 [label="Я була просто Марі. І тільки Марі. І за це я вірую в нього.",shape=box,color=blue];
		j1424909180 -> j1946988171;
	j449758430 [label="Oui, вони можуть. Інші занадто радо ставилися до мене інакше, бо mes pieds не такі, як в інших, бо я не можу існувати у світі, так само як вони.",shape=box,color=blue];
		j449758430 -> j699705125;
	j1761535860 [label="Інші занадто радо ставилися до мене інакше, бо mes pieds не такі, як в інших, бо я не можу існувати у світі, так само як вони.",shape=box,color=blue];
		j1761535860 -> j699705125;
