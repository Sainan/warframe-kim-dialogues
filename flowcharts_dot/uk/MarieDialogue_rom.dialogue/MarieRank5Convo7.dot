		j719526911 -> j702983986;
	j2914317433 [label="Ти стільки робиш для мого духовного брата ! Ми можемо не сходитися в певних речах. Може, ніколи й не порозуміємося… але це ? Я зроблю задля тебе.",shape=box,color=blue];
