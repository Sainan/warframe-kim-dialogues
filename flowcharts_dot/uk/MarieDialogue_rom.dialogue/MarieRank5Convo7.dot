		j663299025 -> j697725691;
	j450655600 [label="Я думаю, із ним все гаразд. Серйозно. Просто… усе, крізь що він пройшов… це чимало.",shape=box,color=red];
		j450655600 -> j2371932220;
	j2933323722 [label="Серце крається… Якби ж була змога щось ще зробити для нього…",shape=box,color=red];
		j2933323722 -> j4124170450;
	j697725691 [label="Я тішуся… що він нарешті довіряє настільки, що розповів усю історію…",shape=box,color=red];
		j697725691 -> j1846274824;
	j2371932220 [label="+5 Chemistry",color=orange];
		j2371932220 -> j2873859583;
	j4124170450 [label="Просто слухати — це дуже велика робота. Бути там, коли він відчує змогу говорити. Він не поламаний — тріщини в ньому неглибокі й не дістають до основи. Це просто поверхневі шрами.",shape=box,color=blue];
		j4124170450 -> j1314152750;
	j1846274824 [label="+5 Chemistry",color=orange];
		j1846274824 -> j3396836970;
	j2873859583 [label="Oui, ти розумієш. Він не якась поламана порожня лялька. Його тріщини не дістають до основи. Просто поверхневі шрами.",shape=box,color=blue];
		j2873859583 -> j1314152750;
	j1314152750 [label="Знаєш, я застала його за читанням книги з прадавньої філософії. Уголос. Для мьсє Фібоначчі.",shape=box,color=blue];
		j1314152750 -> j2913124263;
	j3396836970 [label="Oui, ти багато робиш слуханням. Він не якась поламана порожня лялька. Його тріщини не дістають до основи. Просто поверхневі шрами.",shape=box,color=blue];
		j3396836970 -> j1314152750;
	j2913124263 [label="Мсьє Фібоначчі благав усіх почитати йому, але ніхто не погоджувався ! Ніхто не хотів давати йому des munitions, ха !",shape=box,color=blue];
		j2913124263 -> j2486207884;
