	j1843668311 [label="Ліон і мріяти про таке не міг. Що він із кимось так спілкуватиметься. Йому явно подобалося.",shape=box,color=blue];
		j1843668311 -> j2871192814;
	j2871192814 [label="І я знаю, що це не комусь зі Світочів я маю за це дякувати під час вечірньої молитви. Це твоя заслуга.",shape=box,color=blue];
