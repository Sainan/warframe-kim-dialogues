		j4259657855 -> "Chat ends." [label=false,color=brown];
	j148501058 [label="Evaluate expressions",color=orange];
		j148501058 -> j2812895002 [label="MarieFamily3a",color=purple];
		j148501058 -> j3648545988 [label="MarieFamily3a",color=purple];
		j148501058 -> j1771128247 [label="MarieFamily3b",color=purple];
		j148501058 -> j4247127383 [label="MarieFamily3b",color=purple];
		j148501058 -> j2812895002 [label="MarieFamilyOther",color=purple];
		j148501058 -> j3648545988 [label="MarieFamilyOther",color=purple];
		j148501058 -> j3719056818 [label="false",color=purple];
	j2812895002 [label="Мені тут випала нагода поміркувати як переконати Лойда піти до тих, хто нагорі, і нарешті поговорити з усією родиною… Є ідея, але вона тобі не сподобається.",shape=box,color=red];
		j2812895002 -> j3431982611;
	j3648545988 [label="Ти більше не думала про те, як переконати Лойда поговорити з родиною нагорі?",shape=box,color=red];
		j3648545988 -> j2607534784;
	j1771128247 [label="Стосовно того, щоб звести Лойда й родину Ентраті до розмови… Ти не передумала стосовно залучення Роута?",shape=box,color=red];
		j1771128247 -> j1903226774;
	j4247127383 [label="Марі, ти досі не проти… спробувати переконати Лойда поспілкуватися з «сусідами зверху»? Ми не договорили про це.",shape=box,color=red];
		j4247127383 -> j1903226774;
	j3719056818 [label="Я думала про те, як монсеньйор Лойд боїться говорити з родиною le Cardinal.",shape=box,color=blue];
		j3719056818 -> j2994354962;
	j3431982611 [label="Check boolean MarieDating",color=orange];
		j3431982611 -> j1632882774 [label=true,color=green];
		j3431982611 -> j1818164887 [label=false,color=brown];
	j2607534784 [label="Check boolean MarieDating",color=orange];
		j2607534784 -> j1463342645 [label=true,color=green];
		j2607534784 -> j1463342645 [label=false,color=brown];
	j1903226774 [label="Check boolean MarieDating",color=orange];
		j1903226774 -> j4187549332 [label=true,color=green];
		j1903226774 -> j2828050002 [label=false,color=brown];
	j2994354962 [label="Ми повинні розрубати цей вузол. Purgatoire, в якому ми застрягли, не повинно існувати. Воно дуже болісне без причин на то.",shape=box,color=blue];
		j2994354962 -> j323258881;
	j1632882774 [label="Bonjour, mon coeur ! А що саме ти боїшся, що мені не сподобається ?",shape=box,color=blue];
		j1632882774 -> j343463353;
	j1818164887 [label="Bonjour ! А що саме ти боїшся, що мені не сподобається ?",shape=box,color=blue];
		j1818164887 -> j343463353;
	j1463342645 [label="Bonjour, mon cœur ! Я тут поміркувала, oui… і дуже не хочеться цього визнавати. Мені неприємно про це говорити.",shape=box,color=blue];
		j1463342645 -> j1056978308;
	j4187549332 [label="Bonjour, bonjour, mon cœur ! Я тут поміркувала, oui… і дуже не хочеться цього визнавати. Мені неприємно про це говорити.",shape=box,color=blue];
		j4187549332 -> j4249438970;
	j2828050002 [label="Bonjour… Я тут поміркувала, oui… і дуже не хочеться цього визнавати. Мені неприємно про це говорити.",shape=box,color=blue];
		j2828050002 -> j4249438970;
	j323258881 [label="Але я відчуваю, що нам потрібен… якийсь бастіон, non ? Є ідеї ?",shape=box,color=blue];
		j323258881 -> j442814596;
		j323258881 -> j343463353;
	j343463353 [label="Думаю, нам знадобиться допомога Роута, щоб вмовити Лойда поговорити з родиною Ентраті. Не думаю, що він якимось чином погодиться без цього. Без гарантій, що він і родина будуть під захистом.",shape=box,color=red];
		j343463353 -> j3079382573;
	j1056978308 [label="Але я думаю… я думаю… пробач мені, Соле… допомога диявола — саме те, чого бракує. Не думаю, що інакше монсеньйор Лойд послухає нас.",shape=box,color=blue];
		j1056978308 -> j2578295442;
	j4249438970 [label="Усе ж таки ти маєш рацію. Диявол може бути тим шматком, якого бракує. О, як же мене гнітить навіть друкування цих слів ! ",shape=box,color=blue];
		j4249438970 -> j636489540;
	j442814596 [label="Нема ніяких ідей, які б не потребували використання допомоги з моторошних джерел. Тих, які можуть призвести до гірших наслідків. Тих, які звуться Роут.",shape=box,color=red];
		j442814596 -> j2659224010;
	j3079382573 [label="Гірко визнавати це… але є істина в твоїх словах… Соле, пробач мене, грішну.",shape=box,color=blue];
		j3079382573 -> j636489540;
	j2578295442 [label="Диявол могутній і зможе стати грубою силою, якщо щось піде не так, non ?",shape=box,color=blue];
		j2578295442 -> j452386911;
		j2578295442 -> j232912290;
	j636489540 [label="Evaluate expressions",color=orange];
		j636489540 -> j3282262892 [label="RoatheFamilyFail",color=purple];
		j636489540 -> j1282503612 [label="RoatheRedeemed, RoatheFamilyDelay
",color=purple];
		j636489540 -> j1282503612 [label="RoatheRedeemed, RoatheFamilySuccess
",color=purple];
		j636489540 -> j777717833 [label="RoatheVillain, RoatheFamilyDelay
",color=purple];
		j636489540 -> j777717833 [label="RoatheVillain, RoatheFamilySuccess",color=purple];
		j636489540 -> j1286132652 [label="false",color=purple];
	j2659224010 [label="Це точно ? Якщо я можу не зважати на свої différences з Роутом, то й ти безумовно, non ?",shape=box,color=blue];
		j2659224010 -> j1475837734;
		j2659224010 -> j100309358;
	j452386911 [label="Ні. Має бути інший шлях. Я не проситиму його допомоги в цьому.",shape=box,color=red];
		j452386911 -> j2659224010;
	j232912290 [label="Знаєш, певно, твоя правда. Не варто було думати, що ти погодишся. Не дарма було страшно запитувати.",shape=box,color=red];
		j232912290 -> j636489540;
	j3282262892 [label="Він допоможе нам у цій справі ?",shape=box,color=blue];
		j3282262892 -> j3931650457;
	j1282503612 [label="Він допоможе нам у цій справі ?",shape=box,color=blue];
		j1282503612 -> j1947176428;
	j777717833 [label="Він допоможе нам у цій справі ?",shape=box,color=blue];
		j777717833 -> j719010422;
	j1286132652 [label="Думаєш, тобі вдасться вмовити його допомогти нам ?",shape=box,color=blue];
		j1286132652 -> j830427568;
		j1286132652 -> j1049744971;
	j1475837734 [label="Ні, вибач. ",shape=box,color=red];
		j1475837734 -> j1311473334;
	j100309358 [label="Добре. Якщо тобі нормально з цим, то й мені теж.",shape=box,color=red];
		j100309358 -> j1815752760;
	j3931650457 [label="Ні, на жаль… Думаю, це глухий кут. Як вважаєш, інші способи є?",shape=box,color=red];
		j3931650457 -> j849254742;
	j1947176428 [label="Так. Мені вдалося переконати його допомогти з їхнім об’єднанням. Ти не повіриш, але він захищатиме родину Ентраті. Зрештою, це останні з орокінів.",shape=box,color=red];
		j1947176428 -> j3568005286;
	j719010422 [label="Так. Мені вдалося переконати його допомогти з їхнім об’єднанням. І… тебе це не здивує, але переважно через те, щоб чимось дошкулити Альбрехту, поки його нема.",shape=box,color=red];
		j719010422 -> j3480739871;
	j830427568 [label="Ще нічого не узгоджено. Він… ну, ти ж знаєш, яким може бути.",shape=box,color=red];
		j830427568 -> j2913252443;
	j1049744971 [label="Я досі над цим працюю, але думаю, що так.",shape=box,color=red];
		j1049744971 -> j1104176810;
	j1311473334 [label="+20 Chemistry",color=orange];
		j1311473334 -> j1258203186;
	j1815752760 [label="Oui, ці un médicament, які я маю проковтнути, не обов’язково повинні бути смачними для зцілення.",shape=box,color=blue];
		j1815752760 -> j636489540;
	j849254742 [label="Ой ! Це… не пощастило. Я не знаю… Може, ти якийсь підхід інший підбереш до диявола ? Чи якось по-інакшому спитаєш знову ?",shape=box,color=blue];
		j849254742 -> j4108042114;
	j3568005286 [label="Він допомагає захистити родину чоловіка, котрий обернув його на протофрейма супроти волі й закинув у минуле, стерши спогади…",shape=box,color=blue];
		j3568005286 -> j3871448372;
	j3480739871 [label="Так, саме так… я не здивована.",shape=box,color=blue];
		j3480739871 -> j1379959133;
		j3480739871 -> j1175925001;
	j2913252443 [label="Check boolean RoatheDating",color=orange];
		j2913252443 -> j1235869995 [label=true,color=green];
		j2913252443 -> j211042639 [label=false,color=brown];
	j1104176810 [label="Check boolean RoatheDating",color=orange];
		j1104176810 -> j3802553229 [label=true,color=green];
		j1104176810 -> j200009271 [label=false,color=brown];
	j1258203186 [label="Тоді я прийму твій вибір.",shape=box,color=blue];
		j1258203186 -> j1179567760;
	j4108042114 [label="Тим часом я побалакаю з Ліоном, але тут зовсім мало надії.",shape=box,color=blue];
		j4108042114 -> j2377995789;
	j3871448372 [label="+20 Chemistry",color=orange];
		j3871448372 -> j3731935280;
	j1379959133 [label="Принаймні він допоможе. А я переконаюся, що він насправді не виконає своїх погроз.",shape=box,color=red];
		j1379959133 -> j3615043422;
	j1175925001 [label="Думаю, це лише виправдання, яким він прикривається.",shape=box,color=red];
		j1175925001 -> j1881434777;
	j1235869995 [label="Oui. Думаю, що в тебе є особливий спосіб переконати його, якщо всі інші зазнали невдачі, non ?",shape=box,color=blue];
		j1235869995 -> j1294339946;
		j1235869995 -> j3695213180;
	j211042639 [label="Oui, безперечно. Диявол буває занадто упертим навіть у найліпші часи. Іноді таке враження, що йому до вподоби бути по інший бік у суперечці !",shape=box,color=blue];
		j211042639 -> j74626790;
		j211042639 -> j66593654;
	j3802553229 [label="Думаю, що в тебе є особливий спосіб переконати його, якщо всі інші зазнали невдачі, non ?",shape=box,color=blue];
		j3802553229 -> j1294339946;
		j3802553229 -> j3695213180;
	j200009271 [label="Бажаю тобі всього найліпшого. Диявол буває занадто упертим навіть у найліпші часи. Іноді таке враження, що йому до вподоби бути по інший бік у суперечці !",shape=box,color=blue];
		j200009271 -> j74626790;
		j200009271 -> j66593654;
	j1179567760 [label="Boolean MarieFamilyFail is now true.",color=orange];
		j1179567760 -> j2605366984;
	j2377995789 [label="+20 Chemistry",color=orange];
		j2377995789 -> j3685708555;
	j3731935280 [label="Я дуже недооцінила нашого диявола…",shape=box,color=blue];
		j3731935280 -> j2568545939;
	j3615043422 [label="Oui. Щонайменше ми тут, щоб не дати йому потурати своїм… низьким інстинктам.",shape=box,color=blue];
		j3615043422 -> j2198758823;
	j1881434777 [label="Oui, сподіваюся, що твоя правда.",shape=box,color=blue];
		j1881434777 -> j2198758823;
	j1294339946 [label="Не хотілося б використовувати мої стосунки з ним як важіль для перемовин.",shape=box,color=red];
		j1294339946 -> j1791610515;
	j3695213180 [label="Марі, на що ти натякаєш?",shape=box,color=red];
		j3695213180 -> j3873111579;
	j74626790 [label="Знаєш, як би дивно це не звучало, але мені це навіть подобається. Ми поладнаємо.",shape=box,color=red];
		j74626790 -> j4031179327;
	j66593654 [label="Так, але думаю, що більша частина того — лише для створення образу.",shape=box,color=red];
		j66593654 -> j1824506159;
	j2605366984 [label="Boolean MarieRank5Convo4Complete is now true.",color=orange];
		j2605366984 -> "Chat ends.";
	j3685708555 [label="Ото ж усе ці дияволи ! Як-то кажуть, c'est la vie !",shape=box,color=blue];
		j3685708555 -> j3569999725;
	j2568545939 [label="Я не дурепа, щоб не бачити твоє ролі в цьому всьому !",shape=box,color=blue];
		j2568545939 -> j3242583483;
	j2198758823 [label="Check boolean MarieDating",color=orange];
		j2198758823 -> j3114636551 [label=true,color=green];
		j2198758823 -> j893096388 [label=false,color=brown];
	j1791610515 [label="О ! Це не те, на що я натякаю, pardonne-moi ! Схоже, що він прихильний до тебе, тож вислухає, коли інших може проігнорувати.",shape=box,color=blue];
		j1791610515 -> j2747024572;
	j3873111579 [label="+5 Chemistry",color=orange];
		j3873111579 -> j3148481858;
	j4031179327 [label="Oui, схоже, він точно прихильний до тебе. Можливо, це тому, що ви з ним маєте спільний час і простір, а ми ні ? Чому б іще ?",shape=box,color=blue];
		j4031179327 -> j3822691405;
	j1824506159 [label="Oui ? Що маєш на увазі ?",shape=box,color=blue];
		j1824506159 -> j3822691405;
	j3569999725 [label="Boolean MarieFamilySuccess is now true.",color=orange];
		j3569999725 -> j2605366984;
	j3242583483 [label="Check boolean MarieDating",color=orange];
		j3242583483 -> j2647290534 [label=true,color=green];
		j3242583483 -> j3945458432 [label=false,color=brown];
	j3114636551 [label="+10 Chemistry",color=orange];
		j3114636551 -> j884560398;
	j893096388 [label="+10 Chemistry",color=orange];
		j893096388 -> j3768658948;
	j2747024572 [label="+5 Chemistry",color=orange];
		j2747024572 -> j892382715;
	j3148481858 [label="Я гадки не маю про що ти ! Я ні на що не натякаю. Я чиста une innocente Sœur de Sol.",shape=box,color=blue];
		j3148481858 -> j757358490;
	j3822691405 [label="Evaluate expressions",color=orange];
		j3822691405 -> j1895675092 [label="RoatheVillain",color=purple];
		j3822691405 -> j748866525 [label="RoatheRedeemed",color=purple];
		j3822691405 -> j2169205274 [label="RoatheUnloved3",color=purple];
		j3822691405 -> j2936000795 [label="RoatheTraitor2",color=purple];
		j3822691405 -> j2996839164 [label="RoatheExecutor2",color=purple];
		j3822691405 -> j618131239 [label="false",color=purple];
	j2647290534 [label="Merci, merci, merci, mon cœur !",shape=box,color=blue];
		j2647290534 -> j1450969867;
	j3945458432 [label="Merci, merci, merci !",shape=box,color=blue];
		j3945458432 -> j1450969867;
	j884560398 [label="Що ж ! Коли прийде час, то я буду готова й чекатиму ! А доти, merci, mon cœur.",shape=box,color=blue];
		j884560398 -> j3569999725;
	j3768658948 [label="Що ж ! Коли прийде час, то я буду готова й чекатиму ! А доти, merci.",shape=box,color=blue];
		j3768658948 -> j3569999725;
	j892382715 [label="Я просто рада твоєму щастю. І якщо дияволу є куди витрачати… свою енергію… то нам всім на ліпше, non ?",shape=box,color=blue];
		j892382715 -> j463997276;
	j757358490 [label="Я б ніколи не могла сказати, що якщо диявол прихильний до тебе, то він міг би дослухатися, коли інших ігнорує повністю.",shape=box,color=blue];
		j757358490 -> j159315535;
	j1895675092 [label="Усі в його житті намагалися зробити з нього чудовисько. Але не я. Припускаю, це вперше.",shape=box,color=red];
		j1895675092 -> j3114345696;
	j748866525 [label="У ньому є чимало того, що він просто не знає як показати. Це не зовсім як броня, але він не довіряє тим, хто не хоче скривдити його.",shape=box,color=red];
		j748866525 -> j514310181;
	j2169205274 [label="Його… серце розбивалося кілька разів за ці роки. Тому й він відростив гострі шпичаки довкола себе.",shape=box,color=red];
		j2169205274 -> j2732927128;
	j2936000795 [label="Здається, я можу розуміти його, кількість прожитих ним років. Мені довелося бачити стільки ж смертей, як і йому.",shape=box,color=red];
		j2936000795 -> j3630140676;
	j2996839164 [label="Він лише завжди намагався зробити те, що правильно. Звісно, може й неправильно, але намагався врятувати Материнську систему від орокінів.",shape=box,color=red];
		j2996839164 -> j1409031565;
	j618131239 [label="Я насолоджуюся його почуттям гумору. Він дуже розумний, якщо звикнути до великого его.",shape=box,color=red];
		j618131239 -> j597735020;
	j1450969867 [label="Що ж ! Коли прийде час, то я буду готова й чекатиму ! А доти — бувай !",shape=box,color=blue];
		j1450969867 -> j3569999725;
	j463997276 [label="Для нас усіх навіть ліпше, якщо ти будеш наче un ange на плечі, щоб заспокоювати його.",shape=box,color=blue];
		j463997276 -> j3849498221;
		j463997276 -> j3352425375;
	j159315535 [label="І ніколи під час особистих моментів. Non. Jamais.",shape=box,color=blue];
		j159315535 -> j1776084156;
		j159315535 -> j3932310706;
	j3114345696 [label="І припускаю, що я на верхівці списку перших, non ? Напевно… варто зважити, чому він такий як є. Осуд душі не рятує.",shape=box,color=blue];
		j3114345696 -> j213136459;
	j514310181 [label="Завжди є біль, який ми приховуємо від інших. Щось прагнемо приховати Припускаю, мені варто намагатися добрішою до нього бути, якщо сказане тобою — правда.",shape=box,color=blue];
		j514310181 -> j213136459;
	j2732927128 [label="Навіть уявити не можу кількість любові та втрат упродовж таких довгих років. Це видається таким нереальним, навіть попри все бачене досі.",shape=box,color=blue];
		j2732927128 -> j732826430;
	j3630140676 [label="Коли балакаю з ним, то іноді навіть забуваю, скільки століть він живе. Це видається таким нереальним, навіть попри бачене досі.",shape=box,color=blue];
		j3630140676 -> j4114327964;
	j1409031565 [label="Завжди є певні… нюанси, oui ? Завжди є причина вчинити так чи інак. Припускаю, мені варто намагатися добрішою до нього бути, якщо сказане тобою — правда.",shape=box,color=blue];
		j1409031565 -> j213136459;
	j597735020 [label="Ніхто й ніколи не казав, що йому бракує дотепності.",shape=box,color=blue];
		j597735020 -> j4080698283;
	j3849498221 [label="Хто сказав, що я намагаюся заспокоювати його?",shape=box,color=red];
		j3849498221 -> j2530572720;
	j3352425375 [label="Нічого не можу обіцяти.",shape=box,color=red];
		j3352425375 -> j452306535;
	j1776084156 [label="Раніше ця твоя сторона не була видимою.",shape=box,color=red];
		j1776084156 -> j2747024572;
	j3932310706 [label="Ти здивувала мене. Це вражає. ",shape=box,color=red];
		j3932310706 -> j2747024572;
	j213136459 [label="+10 Chemistry",color=orange];
		j213136459 -> j1256901661;
	j732826430 [label="О… oui, це може завдати значної шкоди душі ! Я розумію, чому тобі хочеться знайти когось, хто зрозуміє. Як він тебе.",shape=box,color=blue];
		j732826430 -> j213136459;
	j4114327964 [label="Жити так довго, бачити стільки смертей — заплатити стільки за це самому ?",shape=box,color=blue];
		j4114327964 -> j732826430;
	j4080698283 [label="+5 Chemistry",color=orange];
		j4080698283 -> j1256901661;
	j2530572720 [label="Add -1 to Thermostat counter",color=orange];
		j2530572720 -> j807253682;
	j452306535 [label="Add 1 to Thermostat counter",color=orange];
		j452306535 -> j2380958500;
	j1256901661 [label="Я просто радію, що дияволу є з ким поговорити, що хтось може спробувати його заспокоїти. Un ange на плечі.",shape=box,color=blue];
		j1256901661 -> j3849498221;
		j1256901661 -> j3352425375;
	j807253682 [label="+10 Chemistry",color=orange];
		j807253682 -> j4086403019;
	j2380958500 [label="+10 Chemistry",color=orange];
		j2380958500 -> j1142988990;
	j4086403019 [label="Може й так… що таке is un ange без son diable ? Він нагадує нам усім, чого варто уникати.",shape=box,color=blue];
		j4086403019 -> j1291234385;
	j1142988990 [label="Oui, боюся, у ньому є щось лихе, що насправді не можна зцілити. Він занадто ним упивається.",shape=box,color=blue];
		j1142988990 -> j1291234385;
	j1291234385 [label="Що ж ! Якщо й коли в тебе вийде переконати диявола допомогти нам у завданні, то я буду готова й чекатиму ! Бувай !",shape=box,color=blue];
		j1291234385 -> j3569999725;
}