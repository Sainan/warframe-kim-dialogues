		3606 -> 3608 [label="false",color=purple];
	3607 [label="Chat ends.",color=orange];
	3609 [label="Мені тут випала нагода поміркувати як переконати Лойда піти до тих, хто нагорі, і нарешті поговорити з усією родиною… Є ідея, але вона тобі не сподобається.",shape=box,color=red];
		3609 -> 3614;
	3610 [label="Ти більше не думала про те, як переконати Лойда поговорити з родиною нагорі?",shape=box,color=red];
		3610 -> 3615;
	3611 [label="Стосовно того, щоб звести Лойда й родину Ентраті до розмови… Ти не передумала стосовно залучення Роута?",shape=box,color=red];
		3611 -> 3616;
	3612 [label="Марі, ти досі не проти… спробувати переконати Лойда поспілкуватися з «сусідами зверху»? Ми не договорили про це.",shape=box,color=red];
		3612 -> 3616;
	3608 [label="Я думала про те, як монсеньйор Лойд боїться говорити з родиною le Cardinal.",shape=box,color=blue];
		3608 -> 3613;
	3614 [label="Check boolean MarieDating",color=orange];
		3614 -> 3619 [label=true,color=green];
		3614 -> 3618 [label=false,color=brown];
	3615 [label="Check boolean MarieDating",color=orange];
		3615 -> 3621 [label=true,color=green];
		3615 -> 3620 [label=false,color=brown];
	3616 [label="Check boolean MarieDating",color=orange];
		3616 -> 3623 [label=true,color=green];
		3616 -> 3622 [label=false,color=brown];
	3613 [label="Ми повинні розрубати цей вузол. Purgatoire, в якому ми застрягли, не повинно існувати. Воно дуже болісне без причин на то.",shape=box,color=blue];
		3613 -> 3617;
	3619 [label="Bonjour, mon coeur ! А що саме ти боїшся, що мені не сподобається ?",shape=box,color=blue];
		3619 -> 3625;
	3618 [label="Bonjour ! А що саме ти боїшся, що мені не сподобається ?",shape=box,color=blue];
		3618 -> 3625;
	3621 [label="Bonjour, mon cœur ! Я тут поміркувала, oui… і дуже не хочеться цього визнавати. Мені неприємно про це говорити.",shape=box,color=blue];
		3621 -> 3626;
	3620 [label="Bonjour, mon cœur ! Я тут поміркувала, oui… і дуже не хочеться цього визнавати. Мені неприємно про це говорити.",shape=box,color=blue];
		3620 -> 3626;
	3623 [label="Bonjour, bonjour, mon cœur ! Я тут поміркувала, oui… і дуже не хочеться цього визнавати. Мені неприємно про це говорити.",shape=box,color=blue];
		3623 -> 3627;
	3622 [label="Bonjour… Я тут поміркувала, oui… і дуже не хочеться цього визнавати. Мені неприємно про це говорити.",shape=box,color=blue];
		3622 -> 3627;
	3617 [label="Але я відчуваю, що нам потрібен… якийсь бастіон, non ? Є ідеї ?",shape=box,color=blue];
		3617 -> 3624;
		3617 -> 3625;
	3625 [label="Думаю, нам знадобиться допомога Роута, щоб вмовити Лойда поговорити з родиною Ентраті. Не думаю, що він якимось чином погодиться без цього. Без гарантій, що він і родина будуть під захистом.",shape=box,color=red];
		3625 -> 3629;
	3626 [label="Але я думаю… я думаю… пробач мені, Соле… допомога диявола — саме те, чого бракує. Не думаю, що інакше монсеньйор Лойд послухає нас.",shape=box,color=blue];
		3626 -> 3630;
	3627 [label="Усе ж таки ти маєш рацію. Диявол може бути тим шматком, якого бракує. О, як же мене гнітить навіть друкування цих слів ! ",shape=box,color=blue];
		3627 -> 3631;
	3624 [label="Нема ніяких ідей, які б не потребували використання допомоги з моторошних джерел. Тих, які можуть призвести до гірших наслідків. Тих, які звуться Роут.",shape=box,color=red];
		3624 -> 3628;
	3629 [label="Гірко визнавати це… але є істина в твоїх словах… Соле, пробач мене, грішну.",shape=box,color=blue];
		3629 -> 3631;
	3630 [label="Диявол могутній і зможе стати грубою силою, якщо щось піде не так, non ?",shape=box,color=blue];
		3630 -> 3634;
		3630 -> 3635;
	3631 [label="Evaluate expressions",color=orange];
		3631 -> 3638 [label="RoatheFamilyFail",color=purple];
		3631 -> 3637 [label="RoatheRedeemed, RoatheFamilyDelay
",color=purple];
		3631 -> 3637 [label="RoatheRedeemed, RoatheFamilySuccess
",color=purple];
		3631 -> 3636 [label="RoatheVillain, RoatheFamilyDelay
",color=purple];
		3631 -> 3636 [label="RoatheVillain, RoatheFamilySuccess",color=purple];
		3631 -> 3639 [label="false",color=purple];
	3628 [label="Це точно ? Якщо я можу не зважати на свої différences з Роутом, то й ти безумовно, non ?",shape=box,color=blue];
		3628 -> 3632;
		3628 -> 3633;
	3634 [label="Ні. Має бути інший шлях. Я не проситиму його допомоги в цьому.",shape=box,color=red];
		3634 -> 3628;
	3635 [label="Знаєш, певно, твоя правда. Не варто було думати, що ти погодишся. Не дарма було страшно запитувати.",shape=box,color=red];
		3635 -> 3631;
	3638 [label="/Lotus/Language/1999Texting/MarieRomance/Marie_MarieRank6Convo3_3118 begins.",shape=box,color=blue];
		3638 -> 3644;
	3637 [label="Він допоможе нам у цій справі ?",shape=box,color=blue];
		3637 -> 3643;
	3636 [label="Він допоможе нам у цій справі ?",shape=box,color=blue];
		3636 -> 3642;
	3639 [label="Думаєш, тобі вдасться вмовити його допомогти нам ?",shape=box,color=blue];
		3639 -> 3645;
		3639 -> 3646;
	3632 [label="Ні, вибач. ",shape=box,color=red];
		3632 -> 3640;
	3633 [label="Добре. Якщо тобі нормально з цим, то й мені теж.",shape=box,color=red];
		3633 -> 3641;
	3644 [label="Ні, на жаль… Думаю, це глухий кут. Як вважаєш, інші способи є?",shape=box,color=red];
		3644 -> 3650;
	3643 [label="Так. Мені вдалося переконати його допомогти з їхнім об’єднанням. Ти не повіриш, але він захищатиме родину Ентраті. Зрештою, це останні з орокінів.",shape=box,color=red];
		3643 -> 3649;
	3642 [label="Так. Мені вдалося переконати його допомогти з їхнім об’єднанням. І… тебе це не здивує, але переважно через те, щоб чимось дошкулити Альбрехту, поки його нема.",shape=box,color=red];
		3642 -> 3648;
	3645 [label="Ще нічого не узгоджено. Він… ну, ти ж знаєш, яким може бути.",shape=box,color=red];
		3645 -> 3651;
	3646 [label="Я досі над цим працюю, але думаю, що так.",shape=box,color=red];
		3646 -> 3652;
	3640 [label="+20 Chemistry",color=orange];
		3640 -> 3647;
	3641 [label="Oui, ці un médicament, які я маю проковтнути, не обов’язково повинні бути смачними для зцілення.",shape=box,color=blue];
		3641 -> 3631;
	3650 [label="Ой ! Це… не пощастило. Я не знаю… Може, ти якийсь підхід інший підбереш до диявола ? Чи якось по-інакшому спитаєш знову ?",shape=box,color=blue];
		3650 -> 3657;
	3649 [label="Він допомагає захистити родину чоловіка, котрий обернув його на протофрейма супроти волі й закинув у минуле, стерши спогади…",shape=box,color=blue];
		3649 -> 3656;
	3648 [label="Так, саме так… я не здивована.",shape=box,color=blue];
		3648 -> 3654;
		3648 -> 3655;
	3651 [label="Check boolean RoatheDating",color=orange];
		3651 -> 3659 [label=true,color=green];
		3651 -> 3658 [label=false,color=brown];
	3652 [label="Check boolean RoatheDating",color=orange];
		3652 -> 3660 [label=true,color=green];
		3652 -> 3661 [label=false,color=brown];
	3647 [label="Тоді я прийму твій вибір.",shape=box,color=blue];
		3647 -> 3653;
	3657 [label="Тим часом я побалакаю з Ліоном, але тут зовсім мало надії.",shape=box,color=blue];
		3657 -> 3666;
	3656 [label="+20 Chemistry",color=orange];
		3656 -> 3665;
	3654 [label="Принаймні він допоможе. А я переконаюся, що він насправді не виконає своїх погроз.",shape=box,color=red];
		3654 -> 3663;
	3655 [label="Думаю, це лише виправдання, яким він прикривається.",shape=box,color=red];
		3655 -> 3664;
	3659 [label="Oui. Думаю, що в тебе є особливий спосіб переконати його, якщо всі інші зазнали невдачі, non ?",shape=box,color=blue];
		3659 -> 3669;
		3659 -> 3670;
	3658 [label="Oui, безперечно. Диявол буває занадто упертим навіть у найліпші часи. Іноді таке враження, що йому до вподоби бути по інший бік у суперечці !",shape=box,color=blue];
		3658 -> 3667;
		3658 -> 3668;
	3660 [label="Думаю, що в тебе є особливий спосіб переконати його, якщо всі інші зазнали невдачі, non ?",shape=box,color=blue];
		3660 -> 3669;
		3660 -> 3670;
	3661 [label="Бажаю тобі всього найліпшого. Диявол буває занадто упертим навіть у найліпші часи. Іноді таке враження, що йому до вподоби бути по інший бік у суперечці !",shape=box,color=blue];
		3661 -> 3667;
		3661 -> 3668;
	3653 [label="Update boolean MarieFamilyFail",color=orange];
		3653 -> 3662;
	3666 [label="+20 Chemistry",color=orange];
		3666 -> 3674;
	3665 [label="Я дуже недооцінила нашого диявола…",shape=box,color=blue];
		3665 -> 3673;
	3663 [label="Oui. Щонайменше ми тут, щоб не дати йому потурати своїм… низьким інстинктам.",shape=box,color=blue];
		3663 -> 3672;
	3664 [label="Oui, сподіваюся, що твоя правда.",shape=box,color=blue];
		3664 -> 3672;
	3669 [label="Не хотілося б використовувати мої стосунки з ним як важіль для перемовин.",shape=box,color=red];
		3669 -> 3677;
	3670 [label="Марі, на що ти натякаєш?",shape=box,color=red];
		3670 -> 3678;
	3667 [label="Знаєш, як би дивно це не звучало, але мені це навіть подобається. Ми поладнаємо.",shape=box,color=red];
		3667 -> 3675;
	3668 [label="Так, але думаю, що більша частина того — лише для створення образу.",shape=box,color=red];
		3668 -> 3676;
	3662 [label="Update boolean MarieRank5Convo4Complete",color=orange];
		3662 -> 3671;
	3674 [label="Ото ж усе ці дияволи ! Як-то кажуть, c'est la vie !",shape=box,color=blue];
		3674 -> 3682;
	3673 [label="Я не дурепа, щоб не бачити твоє ролі в цьому всьому !",shape=box,color=blue];
		3673 -> 3681;
	3672 [label="Check boolean MarieDating",color=orange];
		3672 -> 3680 [label=true,color=green];
		3672 -> 3679 [label=false,color=brown];
	3677 [label="О ! Це не те, на що я натякаю, pardonne-moi ! Схоже, що він прихильний до тебе, тож вислухає, коли інших може проігнорувати.",shape=box,color=blue];
		3677 -> 3684;
	3678 [label="+5 Chemistry",color=orange];
		3678 -> 3685;
	3675 [label="Oui, схоже, він точно прихильний до тебе. Можливо, це тому, що ви з ним маєте спільний час і простір, а ми ні ? Чому б іще ?",shape=box,color=blue];
		3675 -> 3683;
	3676 [label="Oui ? Що маєш на увазі ?",shape=box,color=blue];
		3676 -> 3683;
	3671 [label="Chat ends.",color=orange];
	3682 [label="Update boolean MarieFamilySuccess",color=orange];
		3682 -> 3690;
	3681 [label="Check boolean MarieDating",color=orange];
		3681 -> 3689 [label=true,color=green];
		3681 -> 3688 [label=false,color=brown];
	3680 [label="+10 Chemistry",color=orange];
		3680 -> 3687;
	3679 [label="+10 Chemistry",color=orange];
		3679 -> 3686;
	3684 [label="+5 Chemistry",color=orange];
		3684 -> 3697;
	3685 [label="Я гадки не маю про що ти ! Я ні на що не натякаю. Я чиста une innocente Sœur de Sol.",shape=box,color=blue];
		3685 -> 3698;
	3683 [label="Evaluate expressions",color=orange];
		3683 -> 3692 [label="RoatheVillain",color=purple];
		3683 -> 3693 [label="RoatheRedeemed",color=purple];
		3683 -> 3695 [label="RoatheUnloved3",color=purple];
		3683 -> 3696 [label="RoatheTraitor2",color=purple];
		3683 -> 3694 [label="RoatheExecutor2",color=purple];
		3683 -> 3691 [label="false",color=purple];
	3690 [label="Update boolean MarieRank5Convo4Complete",color=orange];
		3690 -> 3701;
	3689 [label="Merci, merci, merci, mon cœur !",shape=box,color=blue];
		3689 -> 3700;
	3688 [label="Merci, merci, merci !",shape=box,color=blue];
		3688 -> 3700;
	3687 [label="Що ж ! Коли прийде час, то я буду готова й чекатиму ! А доти, merci, mon cœur.",shape=box,color=blue];
		3687 -> 3699;
	3686 [label="Що ж ! Коли прийде час, то я буду готова й чекатиму ! А доти, merci.",shape=box,color=blue];
		3686 -> 3699;
	3697 [label="Я просто рада твоєму щастю. І якщо дияволу є куди витрачати… свою енергію… то нам всім на ліпше, non ?",shape=box,color=blue];
		3697 -> 3708;
	3698 [label="Я б ніколи не могла сказати, що якщо диявол прихильний до тебе, то він міг би дослухатися, коли інших ігнорує повністю.",shape=box,color=blue];
		3698 -> 3709;
	3692 [label="Усі в його житті намагалися зробити з нього чудовисько. Але не я. Припускаю, це вперше.",shape=box,color=red];
		3692 -> 3703;
	3693 [label="У ньому є чимало того, що він просто не знає як показати. Це не зовсім як броня, але він не довіряє тим, хто не хоче скривдити його.",shape=box,color=red];
		3693 -> 3704;
	3695 [label="Його… серце розбивалося кілька разів за ці роки. Тому й він відростив гострі шпичаки довкола себе.",shape=box,color=red];
		3695 -> 3706;
	3696 [label="Здається, я можу розуміти його, кількість прожитих ним років. Мені довелося бачити стільки ж смертей, як і йому.",shape=box,color=red];
		3696 -> 3707;
	3694 [label="Він лише завжди намагався зробити те, що правильно. Звісно, може й неправильно, але намагався врятувати Материнську систему від орокінів.",shape=box,color=red];
		3694 -> 3705;
	3691 [label="Я насолоджуюся його почуттям гумору. Він дуже розумний, якщо звикнути до великого его.",shape=box,color=red];
		3691 -> 3702;
	3701 [label="Chat ends.",color=orange];
	3700 [label="Що ж ! Коли прийде час, то я буду готова й чекатиму ! А доти — бувай !",shape=box,color=blue];
		3700 -> 3711;
	3699 [label="Update boolean MarieFamilySuccess",color=orange];
		3699 -> 3710;
	3708 [label="Для нас усіх навіть ліпше, якщо ти будеш наче un ange на плечі, щоб заспокоювати його.",shape=box,color=blue];
		3708 -> 3716;
		3708 -> 3717;
	3709 [label="І ніколи під час особистих моментів. Non. Jamais.",shape=box,color=blue];
		3709 -> 3718;
		3709 -> 3719;
	3703 [label="І припускаю, що я на верхівці списку перших, non ? Напевно… варто зважити, чому він такий як є. Осуд душі не рятує.",shape=box,color=blue];
		3703 -> 3713;
	3704 [label="Завжди є біль, який ми приховуємо від інших. Щось прагнемо приховати Припускаю, мені варто намагатися добрішою до нього бути, якщо сказане тобою — правда.",shape=box,color=blue];
		3704 -> 3713;
	3706 [label="Навіть уявити не можу кількість любові та втрат упродовж таких довгих років. Це видається таким нереальним, навіть попри все бачене досі.",shape=box,color=blue];
		3706 -> 3714;
	3707 [label="Коли балакаю з ним, то іноді навіть забуваю, скільки століть він живе. Це видається таким нереальним, навіть попри бачене досі.",shape=box,color=blue];
		3707 -> 3715;
	3705 [label="Завжди є певні… нюанси, oui ? Завжди є причина вчинити так чи інак. Припускаю, мені варто намагатися добрішою до нього бути, якщо сказане тобою — правда.",shape=box,color=blue];
		3705 -> 3713;
	3702 [label="Ніхто й ніколи не казав, що йому бракує дотепності.",shape=box,color=blue];
		3702 -> 3712;
	3711 [label="Update boolean MarieFamilySuccess",color=orange];
		3711 -> 3721;
	3710 [label="Update boolean MarieRank5Convo4Complete",color=orange];
		3710 -> 3720;
	3716 [label="Хто сказав, що я намагаюся заспокоювати його?",shape=box,color=red];
		3716 -> 3723;
	3717 [label="Нічого не можу обіцяти.",shape=box,color=red];
		3717 -> 3724;
	3718 [label="Раніше ця твоя сторона не була видимою.",shape=box,color=red];
		3718 -> 3684;
	3719 [label="Ти здивувала мене. Це вражає. ",shape=box,color=red];
		3719 -> 3684;
	3713 [label="+10 Chemistry",color=orange];
		3713 -> 3722;
