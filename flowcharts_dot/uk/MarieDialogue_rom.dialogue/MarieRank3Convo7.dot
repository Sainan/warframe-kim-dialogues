digraph {
	graph [fontname="Roboto Condensed"];
	node [fontname="Roboto Condensed"];
	edge [fontname="Roboto Condensed"];

	"MarieRank3Convo7 begins." [color=orange];
		"MarieRank3Convo7 begins." -> j678565364;
	j678565364 [label="Boolean MarieLyonAvailable is now true.",color=orange];
		j678565364 -> j1307591176;
		j678565364 -> j2111767304;
		j678565364 -> j1478915251;
	j1307591176 [label="Як ви зустрілися з Ліоном?",shape=box,color=red];
		j1307591176 -> j3141813832;
	j2111767304 [label="Ліон… нормальний?",shape=box,color=red];
		j2111767304 -> j3716011172;
	j1478915251 [label="[Завершити розмову]",shape=box,color=red];
		j1478915251 -> "Chat ends.";
	j3141813832 [label="Мій дорогий Ліон уже давно жив у Cathédrale, коли Mère Supérieure прихистили. Задовго до того як я прийняла постриг і долучилася до Церкви Світочів як сестра. (Я в захваті від того, що ви спілкуєтеся !)",shape=box,color=blue];
		j3141813832 -> j1400842110;
		j3141813832 -> j917387182;
	j3716011172 [label="Я попрошу тебе пояснити своє питання, перш ніж ми підемо далі. І зроби це виважено — нагадаю, він мій брат по духу.",shape=box,color=blue];
		j3716011172 -> j4254678317;
		j3716011172 -> j1531343685;
	"Chat ends." [color=orange];
	j1400842110 [label="А чого… тобі було потрібне місце для життя?",shape=box,color=red];
		j1400842110 -> j1536857016;
	j917387182 [label="А можна поставити дуже нетактовне запитання?",shape=box,color=red];
		j917387182 -> j1156036719;
	j4254678317 [label="Якщо ця тема бентежить тебе, то ми можемо поговорити про щось інше.",shape=box,color=red];
		j4254678317 -> j501102418;
	j1531343685 [label="Та в мене геть не було намірів тебе засмучувати. Я просто переживаю за нього. Він зовні, схоже, стоїк. Але маю відчуття, що всередині йому дуже болить. От і все.",shape=box,color=red];
		j1531343685 -> j1177622529;
	j1536857016 [label="Бо за багато років до того ma famille лишила мене на вулиці. Я була маленькою дівчинкою й тривалий час жебракувала. Виживала як могла.",shape=box,color=blue];
		j1536857016 -> j4165257742;
	j1156036719 [label="+5 Chemistry",color=orange];
		j1156036719 -> j569404586;
	j501102418 [label="Ні-ні. Усе гаразд. Я просто звикла до зацікавлених роззяв, які вештаються довкола й плескають по ґратах його клітки, наче він якась monstre de cirque.",shape=box,color=blue];
		j501102418 -> j2259170563;
		j501102418 -> j4097423964;
		j501102418 -> j1587854014;
	j1177622529 [label="+5 Chemistry",color=orange];
		j1177622529 -> j985341878;
	j4165257742 [label="Boolean MarieBeggar1 is now true.",color=orange];
		j4165257742 -> j1217290217;
	j569404586 [label="З усіх вуст лунає, що ти вовчої натури, але зі мною в тебе виринають вишукані манери ! Це так мило. Здається, я здогадуюся, про що ти будеш питати. Чому я жила на вулиці ?",shape=box,color=blue];
		j569404586 -> j1536857016;
	j2259170563 [label="Як ви познайомилися?",shape=box,color=red];
		j2259170563 -> j3679602883;
	j4097423964 [label="Мені звична роль «місцевої розваги», тож чудово розумію захисну реакцію.",shape=box,color=red];
		j4097423964 -> j1988716257;
	j1587854014 [label="Нічого. Я просто переживаю за нього.",shape=box,color=red];
		j1587854014 -> j1721656606;
	j985341878 [label="Ти… ти вже пробач за агресію. Я просто звикла до зацікавлених роззяв, які вештаються довкола й плескають по ґратах його клітки, наче він якась monstre de cirque.",shape=box,color=blue];
		j985341878 -> j4097423964;
		j985341878 -> j1587854014;
	j1217290217 [label="Уяви собі, що для подібних мені, без робочих pieds, не багато було можливостей працювати чи куди подітися dans la Cité de la Lumière у мій час.",shape=box,color=blue];
		j1217290217 -> j2335104405;
	j3679602883 [label="Мій дорогий Ліон уже давно жив у Cathédrale, коли Mère Supérieure прихистили мене. Задовго до того як я прийняла постриг і долучилася до Церкви Світочів як сестра.",shape=box,color=blue];
		j3679602883 -> j646848317;
		j3679602883 -> j3302624732;
	j1988716257 [label="Oui, можу собі уявити. Ти ж часомандрівне створіння, яке може зациклити час і викликати всесвіти з подолу реальності ! Це ж чари, non ?",shape=box,color=blue];
		j1988716257 -> j1380389947;
		j1988716257 -> j1347116718;
	j1721656606 [label="+5 Chemistry",color=orange];
		j1721656606 -> j2766418065;
	j2335104405 [label="Думаю, саме тому ми з Ліоном так швидко стали як родина. Він жодного разу не глянув на мене з жалістю. Чи я на нього.",shape=box,color=blue];
		j2335104405 -> j1124088593;
	j646848317 [label="А чого… тобі було потрібне місце для життя?",shape=box,color=red];
		j646848317 -> j2921191477;
	j3302624732 [label="А можна поставити дуже нетактовне запитання?",shape=box,color=red];
		j3302624732 -> j3456152823;
	j1380389947 [label="Це доволі чітко все підсумовує.",shape=box,color=red];
		j1380389947 -> j1623156557;
	j1347116718 [label="По правді мені хотілося б думати, що люди бачать більше в мені, аніж це.",shape=box,color=red];
		j1347116718 -> j2499901335;
	j2766418065 [label="І я в захваті від цього. Він сильний і може витримати все, що йому написано. Але всі тягарі легше зносити разом.",shape=box,color=blue];
		j2766418065 -> j2420573046;
		j2766418065 -> j2997826246;
	j1124088593 [label="А інші ж зацікавлено плескають по ґратах його клітки, наче він якась monstre de cirque.",shape=box,color=blue];
		j1124088593 -> j3908274726;
	j2921191477 [label="Бо за багато років до того ma famille лишила мене на вулиці. Я була маленькою дівчинкою й тривалий час жебракувала. Виживала як могла.",shape=box,color=blue];
		j2921191477 -> j3042110962;
	j3456152823 [label="+5 Chemistry",color=orange];
		j3456152823 -> j1732899306;
	j1623156557 [label="+10 Chemistry",color=orange];
		j1623156557 -> j2233662941;
	j2499901335 [label="+15 Chemistry",color=orange];
		j2499901335 -> j197596470;
	j2420573046 [label="Таке відчуття, що він не хоче спілкуватися зі мною.",shape=box,color=red];
		j2420573046 -> j197801800;
	j2997826246 [label="Я хочу допомогти йому, якщо зможу. Є якісь поради?",shape=box,color=red];
		j2997826246 -> j197801800;
	j3908274726 [label="Сподіваюся, ти зараз не тим самим займаєшся.",shape=box,color=blue];
		j3908274726 -> j1455068686;
		j3908274726 -> j348081173;
	j3042110962 [label="Boolean MarieBeggar1 is now true.",color=orange];
		j3042110962 -> j3394380516;
	j1732899306 [label="З усіх вуст лунає, що ти вовчої натури, але зі мною в тебе виринають вишукані манери ! Це так мило. Здається, я здогадуюся, про що ти будеш питати. Чому я жила на вулиці ?",shape=box,color=blue];
		j1732899306 -> j2921191477;
	j2233662941 [label="Думаю, що колись про тебе напишуть книжку. Ця думка дуже мила. Може саме й мені варто написати її. І це буде написано Gaullique! Imaginez cela !",shape=box,color=blue];
		j2233662941 -> j1744127510;
	j197596470 [label="Тоді ти й справді розумієш. Я більше, аніж сестра Марі, бідолашне дівча без ніг, котре отримало здібність літати. А Ліон — більше аніж захжурений священник, який мовчки несе свій тягар.",shape=box,color=blue];
		j197596470 -> j4086095249;
	j197801800 [label="+10 Chemistry",color=orange];
		j197801800 -> j2110388396;
	j1455068686 [label="Мені звична роль «місцевої розваги», тож чудово розумію як ви двоє почуваєтеся. Ні. Справа не в тому. ",shape=box,color=red];
		j1455068686 -> j1193102136;
	j348081173 [label="Та ні, мені було просто цікаво. По правді, я трохи переживаю за нього. Гадаю, що він приховує чималий біль.",shape=box,color=red];
		j348081173 -> j1623576362;
	j3394380516 [label="Уяви собі, що для подібних мені, без робочих pieds, не багато було можливостей працювати чи куди подітися dans la Cité de la Lumière у мій час.",shape=box,color=blue];
		j3394380516 -> j1237833146;
	j1744127510 [label="Або ні, не уявляй собі такого, бо воно може збутися. Ха ! І на цій прекрасній ноті я мушу написати adieu. Шепіт ніколи не замовкне !",shape=box,color=blue];
		j1744127510 -> "Chat ends.";
	j4086095249 [label="Пам’ятай про це й ми будемо хорошими друзями, напевно. І на цій прекрасній ноті я мушу написати adieu. Шепіт ніколи не замовкне !",shape=box,color=blue];
		j4086095249 -> "Chat ends.";
	j2110388396 [label="Зберігай терпіння. Він… спершу буде не дуже відвертим. Та згодом, коли настане час. Він відкриється. Якщо наміри добрі, то він це знатиме. Але тепер я йду, adieu.",shape=box,color=blue];
		j2110388396 -> "Chat ends.";
	j1193102136 [label="Oui, можу собі уявити. Ти ж часомандрівне створіння, яке може зациклити час і викликати всесвіти з подолу реальності ! Це ж чари, non ?",shape=box,color=blue];
		j1193102136 -> j1380389947;
		j1193102136 -> j1347116718;
	j1623576362 [label="+15 Chemistry",color=orange];
		j1623576362 -> j1689057800;
	j1237833146 [label="Думаю, саме тому ми з Ліоном так швидко стали як родина. Він жодного разу не глянув на мене з жалістю. Чи я на нього.",shape=box,color=blue];
		j1237833146 -> j1119199411;
		j1237833146 -> j160559601;
	j1689057800 [label="Твоя правда, так і є. Однак він вважає це за належне, щоб захистити інших довкола. Коли відчує, що ти не потребуєш такого, то розповість про все, що його тривожить. Терпи. З часом він заговорить до тебе.",shape=box,color=blue];
		j1689057800 -> j950252856;
	j1119199411 [label="Сподіваюся, що йому невдовзі стане достатньо зручно спілкуватися зі мною.",shape=box,color=red];
		j1119199411 -> j197801800;
	j160559601 [label="Мене радує, що ви двоє знайшли одне одного. Ми всі щось більше, аніж видається на перший погляд.",shape=box,color=red];
		j160559601 -> j3337808400;
	j950252856 [label="Та. Боюся, час написати adieu. Шепіт ніколи не замовкне !",shape=box,color=blue];
		j950252856 -> "Chat ends.";
	j3337808400 [label="+15 Chemistry",color=orange];
		j3337808400 -> j1809729651;
	j1809729651 [label="Тоді ти й справді розумієш. Я більше, аніж сестра Марі, бідолашне дівча без ніг, котре отримало здібність літати. А Ліон — більше аніж зажурений священник, який мовчки несе свій тягар.",shape=box,color=blue];
		j1809729651 -> j3259002869;
	j3259002869 [label="Пам’ятай про це й ми будемо хорошими друзями, напевно. І на цій прекрасній ноті я мушу написати adieu. Шепіт ніколи не замовкне!",shape=box,color=blue];
		j3259002869 -> "Chat ends.";
}