digraph {
	1488 [label="MarieRank3Convo7 begins.",color=orange];
		1488 -> 3741;
	3741 [label="Update boolean MarieLyonAvailable",color=orange];
		3741 -> 1491;
		3741 -> 1490;
		3741 -> 1489;
	1491 [label="Як ви зустрілися з Ліоном?",shape=box,color=red];
		1491 -> 1494;
	1490 [label="Ліон… нормальний?",shape=box,color=red];
		1490 -> 1493;
	1489 [label="[Завершити розмову]",shape=box,color=red];
		1489 -> 1492;
	1494 [label="Мій дорогий Ліон уже давно жив у Cathédrale, коли Mère Supérieure прихистили. Задовго до того як я прийняла постриг і долучилася до Церкви Світочів як сестра. (Я в захваті від того, що ви спілкуєтеся !)",shape=box,color=blue];
		1494 -> 1497;
		1494 -> 1498;
	1493 [label="Я попрошу тебе пояснити своє питання, перш ніж ми підемо далі. І зроби це виважено — нагадаю, він мій брат по духу.",shape=box,color=blue];
		1493 -> 1495;
		1493 -> 1496;
	1492 [label="Chat ends.",color=orange];
	1497 [label="А чого… тобі було потрібне місце для життя?",shape=box,color=red];
		1497 -> 1501;
	1498 [label="А можна поставити дуже нетактовне запитання?",shape=box,color=red];
		1498 -> 1502;
	1495 [label="Якщо ця тема бентежить тебе, то ми можемо поговорити про щось інше.",shape=box,color=red];
		1495 -> 1499;
	1496 [label="Та в мене геть не було намірів тебе засмучувати. Я просто переживаю за нього. Він зовні, схоже, стоїк. Але маю відчуття, що всередині йому дуже болить. От і все.",shape=box,color=red];
		1496 -> 1500;
	1501 [label="Бо за багато років до того ma famille лишила мене на вулиці. Я була маленькою дівчинкою й тривалий час жебракувала. Виживала як могла.",shape=box,color=blue];
		1501 -> 1507;
	1502 [label="+5 Chemistry",color=orange];
		1502 -> 1508;
	1499 [label="Ні-ні. Усе гаразд. Я просто звикла до зацікавлених роззяв, які вештаються довкола й плескають по ґратах його клітки, наче він якась monstre de cirque.",shape=box,color=blue];
		1499 -> 1503;
		1499 -> 1504;
		1499 -> 1505;
	1500 [label="+5 Chemistry",color=orange];
		1500 -> 1506;
	1507 [label="Update boolean MarieBeggar1",color=orange];
		1507 -> 1512;
	1508 [label="З усіх вуст лунає, що ти вовчої натури, але зі мною в тебе виринають вишукані манери ! Це так мило. Здається, я здогадуюся, про що ти будеш питати. Чому я жила на вулиці ?",shape=box,color=blue];
		1508 -> 1501;
	1503 [label="Як ви познайомилися?",shape=box,color=red];
		1503 -> 1509;
	1504 [label="Мені звична роль «місцевої розваги», тож чудово розумію захисну реакцію.",shape=box,color=red];
		1504 -> 1510;
	1505 [label="Нічого. Я просто переживаю за нього.",shape=box,color=red];
		1505 -> 1511;
	1506 [label="Ти… ти вже пробач за агресію. Я просто звикла до зацікавлених роззяв, які вештаються довкола й плескають по ґратах його клітки, наче він якась monstre de cirque.",shape=box,color=blue];
		1506 -> 1504;
		1506 -> 1505;
	1512 [label="Уяви собі, що для подібних мені, без робочих pieds, не багато було можливостей працювати чи куди подітися dans la Cité de la Lumière у мій час.",shape=box,color=blue];
		1512 -> 1518;
	1509 [label="Мій дорогий Ліон уже давно жив у Cathédrale, коли Mère Supérieure прихистили мене. Задовго до того як я прийняла постриг і долучилася до Церкви Світочів як сестра.",shape=box,color=blue];
		1509 -> 1513;
		1509 -> 1514;
	1510 [label="Oui, можу собі уявити. Ти ж часомандрівне створіння, яке може зациклити час і викликати всесвіти з подолу реальності ! Це ж чари, non ?",shape=box,color=blue];
		1510 -> 1515;
		1510 -> 1516;
	1511 [label="+5 Chemistry",color=orange];
		1511 -> 1517;
	1518 [label="Думаю, саме тому ми з Ліоном так швидко стали як родина. Він жодного разу не глянув на мене з жалістю. Чи я на нього.",shape=box,color=blue];
		1518 -> 1525;
	1513 [label="А чого… тобі було потрібне місце для життя?",shape=box,color=red];
		1513 -> 1519;
	1514 [label="А можна поставити дуже нетактовне запитання?",shape=box,color=red];
		1514 -> 1520;
	1515 [label="Це доволі чітко все підсумовує.",shape=box,color=red];
		1515 -> 1521;
	1516 [label="По правді мені хотілося б думати, що люди бачать більше в мені, аніж це.",shape=box,color=red];
		1516 -> 1522;
	1517 [label="І я в захваті від цього. Він сильний і може витримати все, що йому написано. Але всі тягарі легше зносити разом.",shape=box,color=blue];
		1517 -> 1523;
		1517 -> 1524;
	1525 [label="А інші ж зацікавлено плескають по ґратах його клітки, наче він якась monstre de cirque.",shape=box,color=blue];
		1525 -> 1531;
	1519 [label="Бо за багато років до того ma famille лишила мене на вулиці. Я була маленькою дівчинкою й тривалий час жебракувала. Виживала як могла.",shape=box,color=blue];
		1519 -> 1526;
	1520 [label="+5 Chemistry",color=orange];
		1520 -> 1527;
	1521 [label="+10 Chemistry",color=orange];
		1521 -> 1528;
	1522 [label="+15 Chemistry",color=orange];
		1522 -> 1529;
	1523 [label="Таке відчуття, що він не хоче спілкуватися зі мною.",shape=box,color=red];
		1523 -> 1530;
	1524 [label="Я хочу допомогти йому, якщо зможу. Є якісь поради?",shape=box,color=red];
		1524 -> 1530;
	1531 [label="Сподіваюся, ти зараз не тим самим займаєшся.",shape=box,color=blue];
		1531 -> 1536;
		1531 -> 1537;
	1526 [label="Update boolean MarieBeggar1",color=orange];
		1526 -> 1532;
	1527 [label="З усіх вуст лунає, що ти вовчої натури, але зі мною в тебе виринають вишукані манери ! Це так мило. Здається, я здогадуюся, про що ти будеш питати. Чому я жила на вулиці ?",shape=box,color=blue];
		1527 -> 1519;
	1528 [label="Думаю, що колись про тебе напишуть книжку. Ця думка дуже мила. Може саме й мені варто написати її. І це буде написано Gaullique! Imaginez cela !",shape=box,color=blue];
		1528 -> 1533;
	1529 [label="Тоді ти й справді розумієш. Я більше, аніж сестра Марі, бідолашне дівча без ніг, котре отримало здібність літати. А Ліон — більше аніж захжурений священник, який мовчки несе свій тягар.",shape=box,color=blue];
		1529 -> 1534;
	1530 [label="+10 Chemistry",color=orange];
		1530 -> 1535;
	1536 [label="Мені звична роль «місцевої розваги», тож чудово розумію як ви двоє почуваєтеся. Ні. Справа не в тому. ",shape=box,color=red];
		1536 -> 1541;
	1537 [label="Та ні, мені було просто цікаво. По правді, я трохи переживаю за нього. Гадаю, що він приховує чималий біль.",shape=box,color=red];
		1537 -> 1542;
	1532 [label="Уяви собі, що для подібних мені, без робочих pieds, не багато було можливостей працювати чи куди подітися dans la Cité de la Lumière у мій час.",shape=box,color=blue];
		1532 -> 1538;
	1533 [label="Або ні, не уявляй собі такого, бо воно може збутися. Ха ! І на цій прекрасній ноті я мушу написати adieu. Шепіт ніколи не замовкне !",shape=box,color=blue];
		1533 -> 1539;
	1534 [label="Пам’ятай про це й ми будемо хорошими друзями, напевно. І на цій прекрасній ноті я мушу написати adieu. Шепіт ніколи не замовкне !",shape=box,color=blue];
		1534 -> 1540;
	1535 [label="Зберігай терпіння. Він… спершу буде не дуже відвертим. Та згодом, коли настане час. Він відкриється. Якщо наміри добрі, то він це знатиме. Але тепер я йду, adieu.",shape=box,color=blue];
		1535 -> 2424;
	1541 [label="Oui, можу собі уявити. Ти ж часомандрівне створіння, яке може зациклити час і викликати всесвіти з подолу реальності ! Це ж чари, non ?",shape=box,color=blue];
		1541 -> 1545;
		1541 -> 1546;
	1542 [label="+15 Chemistry",color=orange];
		1542 -> 1547;
	1538 [label="Думаю, саме тому ми з Ліоном так швидко стали як родина. Він жодного разу не глянув на мене з жалістю. Чи я на нього.",shape=box,color=blue];
		1538 -> 1543;
		1538 -> 1544;
	1539 [label="Chat ends.",color=orange];
	1540 [label="Chat ends.",color=orange];
	2424 [label="Chat ends.",color=orange];
	1545 [label="Це доволі чітко все підсумовує.",shape=box,color=red];
		1545 -> 1521;
	1546 [label="По правді мені хотілося б думати, що люди бачать більше в мені, аніж це.",shape=box,color=red];
		1546 -> 1522;
	1547 [label="Твоя правда, так і є. Однак він вважає це за належне, щоб захистити інших довкола. Коли відчує, що ти не потребуєш такого, то розповість про все, що його тривожить. Терпи. З часом він заговорить до тебе.",shape=box,color=blue];
		1547 -> 1550;
	1543 [label="Сподіваюся, що йому невдовзі стане достатньо зручно спілкуватися зі мною.",shape=box,color=red];
		1543 -> 1548;
	1544 [label="Мене радує, що ви двоє знайшли одне одного. Ми всі щось більше, аніж видається на перший погляд.",shape=box,color=red];
		1544 -> 1549;
	1550 [label="Та. Боюся, час написати adieu. Шепіт ніколи не замовкне !",shape=box,color=blue];
		1550 -> 1553;
	1548 [label="+10 Chemistry",color=orange];
		1548 -> 1551;
	1549 [label="+15 Chemistry",color=orange];
		1549 -> 1552;
	1553 [label="Chat ends.",color=orange];
	1551 [label="Зберігай терпіння. Він… спершу буде не дуже відвертим. Та згодом, коли настане час. Він відкриється. Якщо наміри добрі, то він це знатиме. Але тепер я йду, adieu.",shape=box,color=blue];
		1551 -> 1554;
	1552 [label="Тоді ти й справді розумієш. Я більше, аніж сестра Марі, бідолашне дівча без ніг, котре отримало здібність літати. А Ліон — більше аніж зажурений священник, який мовчки несе свій тягар.",shape=box,color=blue];
		1552 -> 1555;
	1554 [label="Chat ends.",color=orange];
	1555 [label="Пам’ятай про це й ми будемо хорошими друзями, напевно. І на цій прекрасній ноті я мушу написати adieu. Шепіт ніколи не замовкне!",shape=box,color=blue];
		1555 -> 1326;
	1326 [label="Chat ends.",color=orange];
}