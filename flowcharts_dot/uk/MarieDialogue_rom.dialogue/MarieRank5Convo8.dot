		3806 -> 3805;
	3803 [label="Тепер я дражнюся. Не хвилюйся. Однак, хай там як, je suis ravie ! І з нетерпінням чекаю на пізнання цих нових… звичаїв romantiques звичаїв.",shape=box,color=blue];
