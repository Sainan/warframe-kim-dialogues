		3788 -> 3790 [label="false",color=purple];
	3792 [label="І я знаю, що за це ми маємо дякувати тобі.",shape=box,color=blue];
		3792 -> 3795;
	3790 [label="О ! Ой, мандрівниче. Я не знаю, як це правильно написати, тож писатиму як є.",shape=box,color=blue];
		3790 -> 3793;
	3791 [label="Я відчуваю те саме ! Mais je ne sais pas comment te l'écrire, je n'ose pas taper les mots ! Називала себе дурепою за такі думки !",shape=box,color=blue];
		3791 -> 3794;
	3795 [label="Не знаю, чи прийме, але дружба для нього гарантована назавжди.",shape=box,color=blue];
