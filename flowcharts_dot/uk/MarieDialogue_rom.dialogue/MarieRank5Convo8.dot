		3778 -> 3783;
	3774 [label="Мені шкода, якщо це видаватиметься чимось виринулим нізвідки, але не було розуміння, як висловитися раніше.",shape=box,color=red];
		3774 -> 3780;
	3784 [label="Тобі чудово вдалося заручитися його допомогою у справі монсеньйора Лойда. Я не думала, що таке можливо.",shape=box,color=blue];
		3784 -> 3786;
	3781 [label="Я з усіх сил опираюся бажанню спитати про toutes sortes de commérages.",shape=box,color=blue];
		3781 -> 3786;
	3782 [label="Соле, це розбиває мені серце. Його голос не тремтів, коли він говорив. Mais je l'ai vu dans ses yeux.",shape=box,color=blue];
		3782 -> 3786;
	3783 [label="Це розбиває мені серце. Сподіваюся, що в його грудяк котрогось дня не станеться вибух. Не знаю, чи він переживе це. Не знаю, чи хтось із нас це переживе.",shape=box,color=blue];
