	3775 [label="Таке відчуття, що це я маю питати тебе такe, non ? Це ж ти з ним наразі розважаєшся !",shape=box,color=blue];
		3775 -> 3781;
	3776 [label="Я не знаю як тобі вдалося досягти цього, але він розповів нам правду про сироватку.",shape=box,color=blue];
		3776 -> 3782;
	3777 [label="Я не знаю як тобі вдалося досягти цього, але він розповів нам правду про sérum.",shape=box,color=blue];
