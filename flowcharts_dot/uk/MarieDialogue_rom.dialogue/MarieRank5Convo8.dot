	j1247365630 [label="Oui, qu'est-ce qu'il y a ?",shape=box,color=blue];
		j1247365630 -> j579360713;
	"Chat ends." [color=orange];
	j443745374 [label="Хіба нині я не маю називати його «нашим» дияволом, non ? Він же ж найближчим часом нікуди не збирається дітися. Ха !",shape=box,color=blue];
		j443745374 -> j3488016436;
	j261474711 [label="Таке відчуття, що це я маю питати тебе такe, non ? Це ж ти з ним наразі розважаєшся !",shape=box,color=blue];
		j261474711 -> j3133032239;
	j1069551309 [label="Я не знаю як тобі вдалося досягти цього, але він розповів нам правду про сироватку.",shape=box,color=blue];
		j1069551309 -> j1659213825;
	j3676355606 [label="Я не знаю як тобі вдалося досягти цього, але він розповів нам правду про sérum.",shape=box,color=blue];
	j4109142776 [label="Переживаю за нього. Гадаю, він картає себе більше, аніж показує, n'est-ce pas ?",shape=box,color=blue];
		j4109142776 -> j3773879537;
	j579360713 [label="Мені шкода, якщо це видаватиметься чимось виринулим нізвідки, але не було розуміння, як висловитися раніше.",shape=box,color=red];
		j579360713 -> j2117311891;
	j3488016436 [label="Тобі чудово вдалося заручитися його допомогою у справі монсеньйора Лойда. Я не думала, що таке можливо.",shape=box,color=blue];
		j3488016436 -> j4057181772;
	j3133032239 [label="Я з усіх сил опираюся бажанню спитати про toutes sortes de commérages.",shape=box,color=blue];
		j3133032239 -> j4057181772;
	j1659213825 [label="Соле, це розбиває мені серце. Його голос не тремтів, коли він говорив. Mais je l'ai vu dans ses yeux.",shape=box,color=blue];
		j1659213825 -> j4057181772;
	j3773879537 [label="Це розбиває мені серце. Сподіваюся, що в його грудяк котрогось дня не станеться вибух. Не знаю, чи він переживе це. Не знаю, чи хтось із нас це переживе.",shape=box,color=blue];
		j3773879537 -> "Chat ends.";
	j2117311891 [label="Обожнюю тебе. Отак просто беру й обожнюю.",shape=box,color=red];
		j2117311891 -> j911178540;
	j4057181772 [label="У ньому щось змінилося. Щось непомітне, але маємо, що маємо. ",shape=box,color=blue];
		j4057181772 -> j3332908398;
	j911178540 [label="Ну, мені було цікаво… чи ти б не проти, ну… щоб ми стали парою?",shape=box,color=red];
		j911178540 -> j2298753926;
	j3332908398 [label="+5 Chemistry",color=orange];
		j3332908398 -> j21243963;
	j2298753926 [label="Evaluate expressions",color=orange];
		j2298753926 -> j994928726 [label="MarieNoDate",color=purple];
		j2298753926 -> j2103178330 [label="MarieWillDate",color=purple];
		j2298753926 -> j994928726 [label="false",color=purple];
	j21243963 [label="І я знаю, що за це ми маємо дякувати тобі.",shape=box,color=blue];
		j21243963 -> j2024456467;
	j994928726 [label="О ! Ой, мандрівниче. Я не знаю, як це правильно написати, тож писатиму як є.",shape=box,color=blue];
		j994928726 -> j617350017;
	j2103178330 [label="Я відчуваю те саме ! Mais je ne sais pas comment te l'écrire, je n'ose pas taper les mots ! Називала себе дурепою за такі думки !",shape=box,color=blue];
		j2103178330 -> j3532894803;
	j2024456467 [label="Не знаю, чи прийме, але дружба для нього гарантована назавжди.",shape=box,color=blue];
		j2024456467 -> j2668748755;
	j617350017 [label="Non.",shape=box,color=blue];
		j617350017 -> "Chat ends.";
	j3532894803 [label="Ой ! Я така щаслива !",shape=box,color=blue];
		j3532894803 -> j167482295;
	j2668748755 [label="Та не думаю, що я колись утомлюся кричати на нього !",shape=box,color=blue];
		j2668748755 -> j3385138019;
		j2668748755 -> j2324730958;
	j167482295 [label="Якщо ти пропонуєш… формальніші залицяння, то oui ! Oui ! Я б залюбки.",shape=box,color=blue];
		j167482295 -> j729378000;
		j167482295 -> j4233852829;
	j3385138019 [label="Та все одно, гадаю, він дуже насолоджується піддражнюванням тебе.",shape=box,color=red];
		j3385138019 -> j2423839994;
	j2324730958 [label="Тішуся, що ви змогли знайти такий вид стосунків.",shape=box,color=red];
		j2324730958 -> j2677414043;
	j729378000 [label="Точно не пропозиція шлюбу. Поки що. ",shape=box,color=red];
		j729378000 -> j104112431;
	j4233852829 [label="Дещо й справді еволюціонувало трішки. Не так щоб зараз все «формальніше», але з радістю… покажу.",shape=box,color=red];
		j4233852829 -> j3047148680;
	j2423839994 [label="Comme un gros chat de gouttière. Я вже звикла до цього.",shape=box,color=blue];
		j2423839994 -> j2736083477;
	j2677414043 [label="Oui ! Я теж. Дедалі він стає все менш і менш нестерпним.",shape=box,color=blue];
		j2677414043 -> j2423839994;
	j104112431 [label="Тепер я дражнюся. Не хвилюйся. Однак, хай там як, je suis ravie ! І з нетерпінням чекаю на пізнання цих нових… звичаїв romantiques звичаїв.",shape=box,color=blue];
		j104112431 -> j4237714134;
	j3047148680 [label="Ха ! Я бачу, коли хтось «погано» поводиться. Що ж. Чекатиму з нетерпінням.",shape=box,color=blue];
		j3047148680 -> j4237714134;
	j2736083477 [label="Думаю, я сумуватиму, якщо його не стане.",shape=box,color=blue];
		j2736083477 -> "Chat ends.";
	j4237714134 [label="+10 Chemistry",color=orange];
		j4237714134 -> j1901329627;
	j1901329627 [label="А доти ? À la revoyure, mon cœur.",shape=box,color=blue];
