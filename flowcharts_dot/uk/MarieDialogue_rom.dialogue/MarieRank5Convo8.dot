	3796 [label="Chat ends.",color=orange];
	3797 [label="Якщо ти пропонуєш… формальніші залицяння, то oui ! Oui ! Я б залюбки.",shape=box,color=blue];
		3797 -> 3799;
		3797 -> 3800;
	3801 [label="Та все одно, гадаю, він дуже насолоджується піддражнюванням тебе.",shape=box,color=red];
