digraph {
	"MarieRank3Convo4 begins." [color=orange];
		"MarieRank3Convo4 begins." -> j2135000093;
	j2135000093 [label="Boolean MarieLyonAvailable is now true.",color=orange];
		j2135000093 -> j1893061032;
	j1893061032 [label="Котрогось дня я вела бесіду з монсеньйором Лойдом про його дитинство й маю питання до тебе.",shape=box,color=blue];
		j1893061032 -> j3277054001;
		j1893061032 -> j3939822948;
		j1893061032 -> j3312522801;
		j1893061032 -> j1478915251;
	j3277054001 [label="Ти мені вибач. Що ти робила?",shape=box,color=red];
		j3277054001 -> j3862270774;
	j3939822948 [label="Я… щось… не доберу слів для вияву емоцій.",shape=box,color=red];
		j3939822948 -> j799043028;
	j3312522801 [label="У чім питання?",shape=box,color=red];
		j3312522801 -> j720079733;
	j1478915251 [label="[Завершити розмову]",shape=box,color=red];
		j1478915251 -> "Chat ends.";
	j3862270774 [label="Він розповідав мені про юнацькі роки. Ai-je fait quelque chose qui vous a offensé ?",shape=box,color=blue];
		j3862270774 -> j2369724561;
		j3862270774 -> j2788345261;
	j799043028 [label="Я не розумію. Ai-je fait quelque chose qui vous avez offensé ?",shape=box,color=blue];
		j799043028 -> j2369724561;
		j799043028 -> j2788345261;
	j720079733 [label="Архімедівці. Вони були орокінами ? Чи ні ? Це слово вживається дуже легковажно.",shape=box,color=blue];
		j720079733 -> j2410784038;
	"Chat ends." [color=orange];
	j2369724561 [label="Гадаю, що я просто… заздрю.",shape=box,color=red];
		j2369724561 -> j1238788663;
	j2788345261 [label="Гадаю, що я просто… дивуюся.",shape=box,color=red];
		j2788345261 -> j1010099276;
	j2410784038 [label="Припускаю, що могла би спитати в диявола. Але я мені не до вподоби з ним балакати, коли можу цього уникнути.",shape=box,color=blue];
		j2410784038 -> j1671184746;
		j2410784038 -> j98760375;
	j1238788663 [label="De la jalousie ? Pourquoi ?",shape=box,color=blue];
		j1238788663 -> j1230806282;
	j1010099276 [label="Pourquoi ?",shape=box,color=blue];
		j1010099276 -> j1230098106;
		j1010099276 -> j2173036603;
	j1671184746 [label="Ні, архімедівці були нижчі орокінів за рангом.",shape=box,color=red];
		j1671184746 -> j616771683;
	j98760375 [label="Орокінська імперія так називалася, бо орокіни правили в ній. Але «орокіни» водночас також було лише назвою правлячого класу.",shape=box,color=red];
		j98760375 -> j616771683;
	j1230806282 [label="+10 Chemistry",color=orange];
		j1230806282 -> j4179457394;
	j1230098106 [label="Мене просто трохи вразило те, що наразі ти знаєш про нього більше за мене.",shape=box,color=red];
		j1230098106 -> j1230806282;
	j2173036603 [label="Я нічого не знаю про минуле Лойда, хоча його самого знаю вже давненько.",shape=box,color=red];
		j2173036603 -> j1230806282;
	j616771683 [label="Таке часто буває. Ти не одна така.",shape=box,color=red];
		j616771683 -> j4051612382;
	j4179457394 [label="Ой ! Ти тільки не сприймай все дуже особисто, s'il vous plaît !",shape=box,color=blue];
		j4179457394 -> j3751429312;
	j4051612382 [label="Орокіни навмисно зробили своє суспільство таким незрозумілим і заплутаним?",shape=box,color=blue];
		j4051612382 -> j754016869;
		j4051612382 -> j3828147696;
		j4051612382 -> j3882652176;
	j3751429312 [label="Монсеньйор Лойд був… як же ж це по вашому… відсторонений ?",shape=box,color=blue];
		j3751429312 -> j3186650349;
		j3751429312 -> j2622362093;
	j754016869 [label="Тисячі років володарювання можуть… набриднути. А люди з нудьги створюють доволі складні системи.",shape=box,color=red];
		j754016869 -> j2685712752;
	j3828147696 [label="У них був потяг до вишуканого та хитромудрого. Те саме поширювалося й на бюрократичні моменти.",shape=box,color=red];
		j3828147696 -> j2685712752;
	j3882652176 [label="Правду сказати? Уже починаю думати, що так.",shape=box,color=red];
		j3882652176 -> j2685712752;
	j3186650349 [label="Нічого не знаю про нього. Чесно.",shape=box,color=red];
		j3186650349 -> j1110251658;
	j2622362093 [label="Так, він трохи замкнений сам у собі.",shape=box,color=red];
		j2622362093 -> j1110251658;
	j2685712752 [label="+10 Chemistry",color=orange];
		j2685712752 -> j3243564024;
	j1110251658 [label="Згадай із чим мені доводилося проводити час, oui ? Як навчишся читати одну статую, то вже не складно зчитувати й інші.",shape=box,color=blue];
		j1110251658 -> j2291626605;
	j3243564024 [label="Думаю, що вони це навмисно зробили, щоби всіх дратувати !",shape=box,color=blue];
		j3243564024 -> j1451255618;
	j2291626605 [label="+10 Chemistry",color=orange];
		j2291626605 -> j3821331182;
	j1451255618 [label="Et ils se demandent pourquoi des rébellions éclatent. Vous aviez peut-être vos warframes, mais nous avions nos guillotines !",shape=box,color=blue];
		j1451255618 -> j3566713005;
	j3821331182 [label="Та маю визнати. Монсеньйор Лойд трохи… piquant, аніж мій дорогий Ліон.",shape=box,color=blue];
		j3821331182 -> j1757950913;
		j3821331182 -> j255509168;
	j3566713005 [label="Vive la révolution !",shape=box,color=blue];
		j3566713005 -> j4012159232;
		j3566713005 -> j1952533610;
		j3566713005 -> j612845190;
	j1757950913 [label="У нього були причини.",shape=box,color=red];
		j1757950913 -> j3184947570;
	j255509168 [label="Менше з тим… То яке в тебе було питання?",shape=box,color=red];
		j255509168 -> j3293155895;
	j4012159232 [label="Мені варто переживати?",shape=box,color=red];
		j4012159232 -> j2466554495;
	j1952533610 [label="Vive la révolution ! Напевно.",shape=box,color=red];
		j1952533610 -> j3656814568;
	j612845190 [label="Щось не дуже розумію що це зараз сталося, але напевно я підтримую й погоджуюся?",shape=box,color=red];
		j612845190 -> j3656814568;
	j3184947570 [label="О так, дійсно.",shape=box,color=blue];
		j3184947570 -> j4052918660;
	j3293155895 [label="О ! Точно.",shape=box,color=blue];
		j3293155895 -> j4052918660;
	j2466554495 [label="Не зважай на мене. Це я трохи дуркую. Дурненька маленька Marie la révolutionnaire.",shape=box,color=blue];
		j2466554495 -> j2201653360;
	j3656814568 [label="+10 Chemistry",color=orange];
		j3656814568 -> j2466554495;
	j4052918660 [label="Боюся, що повністю забула те, що хотіла спитати ! Ха ! Ну що ж. Згадаю пізніш.",shape=box,color=blue];
		j4052918660 -> j4250943010;
	j2201653360 [label="Дякую за відповідь на запитання. Більше не затримуватиму тебе. ",shape=box,color=blue];
		j2201653360 -> j4250943010;
	j4250943010 [label="Перепрошую, що зіпсувала день. Чи вечір. Чи який би там не був час, коли і де ти зараз є.",shape=box,color=blue];
		j4250943010 -> j4101990552;
	j4101990552 [label="À la revoyure !",shape=box,color=blue];
		j4101990552 -> "Chat ends.";
}