		3738 -> 1227;
	1227 [label="Котрогось дня я вела бесіду з монсеньйором Лойдом про його дитинство й маю питання до тебе.",shape=box,color=blue];
		1227 -> 1231;
		1227 -> 1230;
		1227 -> 1229;
		1227 -> 1228;
	1231 [label="Ти мені вибач. Що ти робила?",shape=box,color=red];
		1231 -> 1235;
	1230 [label="Я… щось… не доберу слів для вияву емоцій.",shape=box,color=red];
		1230 -> 1234;
	1229 [label="У чім питання?",shape=box,color=red];
		1229 -> 1233;
	1228 [label="[Завершити розмову]",shape=box,color=red];
		1228 -> 1232;
	1235 [label="Він розповідав мені про юнацькі роки. Ai-je fait quelque chose qui vous a offensé ?",shape=box,color=blue];
		1235 -> 1237;
		1235 -> 1238;
	1234 [label="Я не розумію. Ai-je fait quelque chose qui vous avez offensé ?",shape=box,color=blue];
		1234 -> 1237;
		1234 -> 1238;
	1233 [label="Архімедівці. Вони були орокінами ? Чи ні ? Це слово вживається дуже легковажно.",shape=box,color=blue];
		1233 -> 1236;
	1232 [label="Chat ends.",color=orange];
	1237 [label="Гадаю, що я просто… заздрю.",shape=box,color=red];
		1237 -> 1241;
	1238 [label="Гадаю, що я просто… дивуюся.",shape=box,color=red];
		1238 -> 1242;
	1236 [label="Припускаю, що могла би спитати в диявола. Але я мені не до вподоби з ним балакати, коли можу цього уникнути.",shape=box,color=blue];
		1236 -> 1239;
		1236 -> 1240;
	1241 [label="De la jalousie ? Pourquoi ?",shape=box,color=blue];
		1241 -> 1244;
	1242 [label="Pourquoi ?",shape=box,color=blue];
		1242 -> 1245;
		1242 -> 1246;
	1239 [label="Ні, архімедівці були нижчі орокінів за рангом.",shape=box,color=red];
		1239 -> 1243;
	1240 [label="Орокінська імперія так називалася, бо орокіни правили в ній. Але «орокіни» водночас також було лише назвою правлячого класу.",shape=box,color=red];
		1240 -> 1243;
	1244 [label="+10 Chemistry",color=orange];
		1244 -> 1248;
	1245 [label="Мене просто трохи вразило те, що наразі ти знаєш про нього більше за мене.",shape=box,color=red];
		1245 -> 1244;
	1246 [label="Я нічого не знаю про минуле Лойда, хоча його самого знаю вже давненько.",shape=box,color=red];
		1246 -> 1244;
	1243 [label="Таке часто буває. Ти не одна така.",shape=box,color=red];
		1243 -> 1247;
	1248 [label="Ой ! Ти тільки не сприймай все дуже особисто, s'il vous plaît !",shape=box,color=blue];
		1248 -> 1252;
	1247 [label="Орокіни навмисно зробили своє суспільство таким незрозумілим і заплутаним?",shape=box,color=blue];
		1247 -> 1249;
		1247 -> 1250;
		1247 -> 1251;
	1252 [label="Монсеньйор Лойд був… як же ж це по вашому… відсторонений ?",shape=box,color=blue];
		1252 -> 1254;
		1252 -> 1255;
	1249 [label="Тисячі років володарювання можуть… набриднути. А люди з нудьги створюють доволі складні системи.",shape=box,color=red];
		1249 -> 1253;
	1250 [label="У них був потяг до вишуканого та хитромудрого. Те саме поширювалося й на бюрократичні моменти.",shape=box,color=red];
		1250 -> 1253;
	1251 [label="Правду сказати? Уже починаю думати, що так.",shape=box,color=red];
		1251 -> 1253;
	1254 [label="Нічого не знаю про нього. Чесно.",shape=box,color=red];
		1254 -> 1257;
	1255 [label="Так, він трохи замкнений сам у собі.",shape=box,color=red];
		1255 -> 1257;
	1253 [label="+10 Chemistry",color=orange];
		1253 -> 1256;
	1257 [label="Згадай із чим мені доводилося проводити час, oui ? Як навчишся читати одну статую, то вже не складно зчитувати й інші.",shape=box,color=blue];
		1257 -> 1259;
	1256 [label="Думаю, що вони це навмисно зробили, щоби всіх дратувати !",shape=box,color=blue];
		1256 -> 1258;
	1259 [label="+10 Chemistry",color=orange];
		1259 -> 1261;
	1258 [label="Et ils se demandent pourquoi des rébellions éclatent. Vous aviez peut-être vos warframes, mais nous avions nos guillotines !",shape=box,color=blue];
		1258 -> 1260;
	1261 [label="Та маю визнати. Монсеньйор Лойд трохи… piquant, аніж мій дорогий Ліон.",shape=box,color=blue];
		1261 -> 1265;
		1261 -> 1266;
	1260 [label="Vive la révolution !",shape=box,color=blue];
		1260 -> 1262;
		1260 -> 1263;
		1260 -> 1264;
	1265 [label="У нього були причини.",shape=box,color=red];
		1265 -> 1269;
	1266 [label="Менше з тим… То яке в тебе було питання?",shape=box,color=red];
		1266 -> 1270;
	1262 [label="Мені варто переживати?",shape=box,color=red];
		1262 -> 1267;
	1263 [label="Vive la révolution ! Напевно.",shape=box,color=red];
		1263 -> 1268;
	1264 [label="Щось не дуже розумію що це зараз сталося, але напевно я підтримую й погоджуюся?",shape=box,color=red];
		1264 -> 1268;
	1269 [label="О так, дійсно.",shape=box,color=blue];
		1269 -> 1272;
	1270 [label="О ! Точно.",shape=box,color=blue];
		1270 -> 1272;
	1267 [label="Не зважай на мене. Це я трохи дуркую. Дурненька маленька Marie la révolutionnaire.",shape=box,color=blue];
		1267 -> 1271;
	1268 [label="+10 Chemistry",color=orange];
		1268 -> 1267;
	1272 [label="Боюся, що повністю забула те, що хотіла спитати ! Ха ! Ну що ж. Згадаю пізніш.",shape=box,color=blue];
		1272 -> 1273;
	1271 [label="Дякую за відповідь на запитання. Більше не затримуватиму тебе. ",shape=box,color=blue];
		1271 -> 1273;
	1273 [label="Перепрошую, що зіпсувала день. Чи вечір. Чи який би там не був час, коли і де ти зараз є.",shape=box,color=blue];
		1273 -> 1274;
	1274 [label="À la revoyure !",shape=box,color=blue];
		1274 -> 1275;
	1275 [label="Chat ends.",color=orange];
