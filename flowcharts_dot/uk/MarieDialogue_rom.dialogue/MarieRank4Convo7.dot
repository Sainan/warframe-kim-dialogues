digraph {
	graph [fontname="Roboto Condensed"];
	node [fontname="Roboto Condensed"];
	edge [fontname="Roboto Condensed"];

	"MarieRank4Convo7 begins." [color=orange];
		"MarieRank4Convo7 begins." -> j3255816954;
	j3255816954 [label="Evaluate expressions on HellKeyPlayed counter",color=orange];
		j3255816954 -> j204691906 [label="x >= 0",color=purple];
		j3255816954 -> "Chat ends." [label="x <= 0",color=purple];
		j3255816954 -> "Chat ends." [label="false",color=purple];
	j204691906 [label="Мандрівниче, excusez-moi… Невже ти справді віриш у те, що мудро допомагати дияволу ?",shape=box,color=blue];
		j204691906 -> j940020564;
	"Chat ends." [color=orange];
	j940020564 [label="Я не бажаю відмовляти тим, хто прагне покаяння чи допомоги, але… не думаю, що дияволу потрібне щось із цього.",shape=box,color=blue];
		j940020564 -> j512500291;
		j940020564 -> j339781691;
		j940020564 -> j46711812;
		j940020564 -> j1478915251;
	j512500291 [label="А що, на твою думку, йому справді потрібно?",shape=box,color=red];
		j512500291 -> j1075589725;
	j339781691 [label="Я знаю, що ви двоє не миритеся. І мені прикро за це. Але я справді не можу його вигнати.",shape=box,color=red];
		j339781691 -> j4163256101;
	j46711812 [label="Роут забув (буквально) про орокінів більше, аніж ми коли-небудь знали. Він нам потрібен.",shape=box,color=red];
		j46711812 -> j1317606688;
	j1478915251 [label="[Завершити розмову]",shape=box,color=red];
		j1478915251 -> "Chat ends.";
	j1075589725 [label="Це дика тварина. Наблизиться, якщо запропонувати їжу й теплу постіль, але враз зміниться, коли не бачитиме в тобі користі.",shape=box,color=blue];
		j1075589725 -> j404508333;
	j4163256101 [label="Add 1 to Thermostat counter",color=orange];
		j4163256101 -> j1089960732;
	j1317606688 [label="Add -1 to Thermostat counter",color=orange];
		j1317606688 -> j1075589725;
	j404508333 [label="Йому щось потрібно від тебе. Від нас. ",shape=box,color=blue];
		j404508333 -> j863296879;
	j1089960732 [label="Non, я й не кажу, що так треба робити. Просто він… із тих, кому не можна довіряти. Ні зараз, ні коли-небудь.",shape=box,color=blue];
		j1089960732 -> j1075589725;
	j863296879 [label="Evaluate expressions on HellKeyPlayed counter",color=orange];
		j863296879 -> j4093421340 [label="x > 5",color=purple];
		j863296879 -> j4228200967 [label="x <= 5",color=purple];
		j863296879 -> j4228200967 [label="false",color=purple];
	j4093421340 [label="Evaluate expressions on HellKeyPlayed counter",color=orange];
		j4093421340 -> j3634713355 [label="x >= 21",color=purple];
		j4093421340 -> j2191535381 [label="x < 21",color=purple];
		j4093421340 -> j2191535381 [label="false",color=purple];
	j4228200967 [label="Ці його втрачені спогади, жахіття з минулого Тау… Мене непокоїть те, що вони можуть віщувати.",shape=box,color=blue];
		j4228200967 -> j540294991;
		j4228200967 -> j3328598613;
	j3634713355 [label="Я знаю, що ти вважаєш, буцімто ми знайшли все можливе в його розтрощених спогадах.",shape=box,color=blue];
		j3634713355 -> j1904182929;
		j3634713355 -> j3328598613;
	j2191535381 [label="Що більше ми взнаємо, глибше занурюємося в його розтрощені спогади, то більше я нервую. Небезпека стає дедалі явнішою й очевиднішою.",shape=box,color=blue];
		j2191535381 -> j3328598613;
		j2191535381 -> j540294991;
	j540294991 [label="Не думаю, що він отак візьме й зникне, коли згадає все. Тут є щось більше.",shape=box,color=red];
		j540294991 -> j2294233215;
	j3328598613 [label="Імовірно, він прагне чогось більшого. Не від спогадів. А від нас.",shape=box,color=red];
		j3328598613 -> j3640818774;
	j1904182929 [label="Я вірю йому, коли він каже, що це все, що ми дізнаємося. І якщо це так, то чому він досі тут?",shape=box,color=red];
		j1904182929 -> j2294233215;
	j2294233215 [label="Я визнаю, що переживаю більше за те, що він робитиме з цими знаннями, аніж за самі знання.",shape=box,color=blue];
		j2294233215 -> j3131865273;
	j3640818774 [label="Oui ! Я непокоюся саме через це. Але що це може бути ? Якій його меті ми зараз служимо ?",shape=box,color=blue];
		j3640818774 -> j3131865273;
	j3131865273 [label="Як би він не сподівався скористатися цим новим існуванням, боюся, що він планує втягнути нас у це все. І мені хотілося б не засліплювати себе сподіваннями в його добрі наміри.",shape=box,color=blue];
		j3131865273 -> j1484154270;
		j3131865273 -> j3788426254;
		j3131865273 -> j4157939022;
	j1484154270 [label="Я тут із тобою. Не довіряю йому.",shape=box,color=red];
		j1484154270 -> j3884120513;
	j3788426254 [label="Він має міць і знання. Він із тих, кого хочеться бачити на своєму боці.",shape=box,color=red];
		j3788426254 -> j2655669263;
	j4157939022 [label="Сенсу немає переливати з пустого в порожнє, розмірковуючи про можливу зраду. Він цього не зробив. Я не називатиму когось винним у ще не скоєних гріхах.",shape=box,color=red];
		j4157939022 -> j2835694436;
	j3884120513 [label="+20 Chemistry",color=orange];
		j3884120513 -> j2093203743;
	j2655669263 [label="Add -1 to Thermostat counter",color=orange];
		j2655669263 -> j3325940769;
	j2835694436 [label="Add 1 to Thermostat counter",color=orange];
		j2835694436 -> j921618629;
	j2093203743 [label="Bien ! Принаймні я спатиму спокійно, знаючи, що ще одна пара очей стежить за дияволом. Merci.",shape=box,color=blue];
		j2093203743 -> j3984234322;
	j3325940769 [label="Oui, але мене цікавить яку ціну ми зрештою заплатимо за цей союз. Тобі може вона не сподобатися.",shape=box,color=blue];
		j3325940769 -> j3179346141;
	j921618629 [label="Oui… припускаю, що твоя правда. Ми не можемо кидатися на кожну тінь. Повинні стояти пліч-о-пліч із будь-ким, хто бажає поразки Indifférence.",shape=box,color=blue];
		j921618629 -> j808986917;
	j3984234322 [label="Boolean MarieRoatheNoTrust is now true.",color=orange];
		j3984234322 -> "Chat ends.";
	j3179346141 [label="Я просто хочу нагадати тобі про обачність… він — чудовисько, у джентльменській шкурі. Обережніше з ним, s'il te plaît ?",shape=box,color=blue];
		j3179346141 -> j3806682141;
		j3179346141 -> j2957486898;
	j808986917 [label="Check boolean DrifterFaithNoMITW",color=orange];
		j808986917 -> j3271231281 [label=true,color=green];
		j808986917 -> j2667989461 [label=false,color=brown];
	j3806682141 [label="Я думаю, що ти трохи упереджена стосовно нього.",shape=box,color=red];
		j3806682141 -> j4275189205;
	j2957486898 [label="Я пильнуватиму. Обіцяю.",shape=box,color=red];
		j2957486898 -> j1361204626;
	j3271231281 [label="Навіть якщо ти віриш у те, що сила за цим стоїть не Божа, а лише все в нашій власній свідомості, то це все одно загроза.",shape=box,color=blue];
		j3271231281 -> j3179346141;
	j2667989461 [label="Навіть якщо він вірить у те, що сила за цим стоїть не Божа, а лише все в нашій власній свідомості, то це все одно загроза.",shape=box,color=blue];
		j2667989461 -> j3179346141;
	j4275189205 [label="Add -1 to Thermostat counter",color=orange];
		j4275189205 -> j3871645943;
	j1361204626 [label="+20 Chemistry",color=orange];
		j1361204626 -> j1434550969;
	j3871645943 [label="Oui ? Це як так ? Це не з жорстокості питаю — мені дійсно цікаво.",shape=box,color=blue];
		j3871645943 -> j426958612;
		j3871645943 -> j1736321075;
		j3871645943 -> j2881897546;
		j3871645943 -> j4003837714;
	j1434550969 [label="Merci. Це все, що я можу просити.",shape=box,color=blue];
		j1434550969 -> "Chat ends.";
	j426958612 [label="Він виріс в іншому суспільстві й в інші часи, з іншими очікуваннями. Нам це може не подобатися, але він той, ким є.",shape=box,color=red];
		j426958612 -> j1012275154;
	j1736321075 [label="Ви з Ліоном прийняли сироватку протофреймів від Ентраті. Добровільно. А він ні. Можеш собі уявити, як це?",shape=box,color=red];
		j1736321075 -> j4131066659;
		j1736321075 -> j373907073;
		j1736321075 -> j1012275154;
	j2881897546 [label="Він кілька століть жив так, як вважав за потрібне. Ми просто маємо різні погляди на те, що саме вважати за потрібне.",shape=box,color=red];
		j2881897546 -> j4131066659;
		j2881897546 -> j1855114322;
	j4003837714 [label="Я думаю, що загалом… тебе відштовхує його поведінка. А не дії.",shape=box,color=red];
		j4003837714 -> j1855114322;
		j4003837714 -> j4131066659;
	j1012275154 [label="Він із вищого військового керівництва та світської еліти. І те, і інше іноді потребує сумнівних рішень.",shape=box,color=red];
		j1012275154 -> j681163897;
	j4131066659 [label="Думаю, що будь-хто може робити те, що ми вважаємо «поганим», з абсолютно добрими намірами.",shape=box,color=red];
		j4131066659 -> j892724697;
	j373907073 [label="Він робив усе в ім’я порятунку орокінської імперії — а віддячили йому відправленням у цей безлад супроти його волі.",shape=box,color=red];
		j373907073 -> j681163897;
	j1855114322 [label="Я думаю, що він тебе дратує, бо пишається скоєним.",shape=box,color=red];
		j1855114322 -> j3229571349;
	j681163897 [label="Check boolean MarieGrineer",color=orange];
		j681163897 -> j3150757331 [label=true,color=green];
		j681163897 -> j2144548019 [label=false,color=brown];
	j892724697 [label="Ти можеш вважати його дияволом, але він у своїй свідомості вважає геть інакше.",shape=box,color=red];
		j892724697 -> j681163897;
	j3229571349 [label="Oui, мені не до вподоби ті, хто впиваються смертю. І його жага проливати кров жахає. І той факт, що тебе це влаштовує, теж не дуже комфортний.",shape=box,color=blue];
		j3229571349 -> j3097132248;
	j3150757331 [label="Я думаю, що ті, хто командує тими «корпусівцями» чи «ґрінерами», з якими ти б’єшся, скажуть те саме. Вони не вважають себе поганими.",shape=box,color=blue];
		j3150757331 -> j295493906;
	j2144548019 [label="Я думаю, що ті, хто командує тими «корпусівцями» чи «ґрі-не-ра-ми», з якими ти б’єшся, скажуть те саме. Вони не вважають себе поганими.",shape=box,color=blue];
		j2144548019 -> j295493906;
	j3097132248 [label="Дуже легко перестрибнути зі шляху зречення до насильства, забути про його страшну сторону й нехтувати всіма жахіттями в ім’я «того, що має значення».",shape=box,color=blue];
		j3097132248 -> j676283124;
	j295493906 [label="Вони вірять, що їхні дії добрі, справедливі й необхідні. Як ти можеш виправдовувати одного диявола й заплющувати очі на інших ?",shape=box,color=blue];
		j295493906 -> j930156718;
		j295493906 -> j3575096842;
		j295493906 -> j1624201477;
		j295493906 -> j1000083950;
	j676283124 [label="Пишатися саме такими діяннями… це вже занадто для мене. Я не радію, коли мушу забирати життя, на відміну від нього. Тож он воно що ? Ми занадто різні.",shape=box,color=blue];
		j676283124 -> j859639275;
	j930156718 [label="Я намагатимуся зупинити їх, коли робитимуть те, з чим не погоджуюся… Але битимуся з ними пліч-о-пліч, коли знадобиться.",shape=box,color=red];
		j930156718 -> j1295579044;
	j3575096842 [label="Я не вірю в те, що ці групи «добрі» чи «погані» за визначенням. Лише за вибраними діями.",shape=box,color=red];
		j3575096842 -> j4139381568;
	j1624201477 [label="Це не мені казати, що якісь дії «хороші» чи якісь «погані». Я роблю все можливе для захисту тих, хто потребує захисту.",shape=box,color=red];
		j1624201477 -> j1295579044;
	j1000083950 [label="Ти вимагаєш від мене судження цілої групи за тими ж мірками, які використані для оцінки однієї особи.",shape=box,color=red];
		j1000083950 -> j4139381568;
	j859639275 [label="Я можу лише молитися про те, що ще не занадто пізно й диявол не планує встромити тобі ножа поміж ребер. Не дуже до душі думки, що твої останні слова й думки будуть: «Марі ж мене попереджала».",shape=box,color=blue];
		j859639275 -> j1738970708;
		j859639275 -> j161691850;
	j1295579044 [label="І ти вважаєш, що диявол — не загроза ? Що він non dangereux для всіх довкола ? Він може завдати значної шкоди.",shape=box,color=blue];
		j1295579044 -> j3757242814;
		j1295579044 -> j1890147558;
	j4139381568 [label="А ті жахливі скоєні вчинки ? Усі ті смерті, кровопролитна бездушна різанина ? Як ці дії виправдовуються в тобі ?",shape=box,color=blue];
		j4139381568 -> j1890147558;
	j1738970708 [label="Він цього не зробить. А якщо й спробує — я його зупиню.",shape=box,color=red];
		j1738970708 -> j2178734448;
	j161691850 [label="Обіцяю, такі думки чи слова не будуть моїми останніми.",shape=box,color=red];
		j161691850 -> j2712291820;
	j3757242814 [label="Якщо так трапиться і він піде проти нас — я діятиму. А до того часу він проявляв себе лише союзником. Лише… трішки мелодраматичним.",shape=box,color=red];
		j3757242814 -> j2967494764;
	j1890147558 [label="Я не бачу проблеми в його небезпечності. Він — зброя. А зброю можна використовувати як для вбивств, так і для захисту.",shape=box,color=red];
		j1890147558 -> j811904874;
	j2178734448 [label="Обожнюю твою віру в себе, але журюся від твоєї віри в нього. Тож, гадаю, мені теж варто повірити в тебе.",shape=box,color=blue];
		j2178734448 -> j3645941743;
	j2712291820 [label="Я сподіваюся, що ти це говориш не в тому сенсі, як я думаю, але не надаватиму цій фразі надто великого значення.",shape=box,color=blue];
		j2712291820 -> j3645941743;
	j2967494764 [label="Add 1 to Thermostat counter",color=orange];
		j2967494764 -> j859639275;
	j811904874 [label="Add -1 to Thermostat counter",color=orange];
		j811904874 -> j859639275;
	j3645941743 [label="Я мушу йти. Та знову закликаю тебе пильнувати себе. Задля мене, якщо не заради себе, d'accord ?",shape=box,color=blue];
		j3645941743 -> j367054140;
	j367054140 [label="+20 Chemistry",color=orange];
		j367054140 -> "Chat ends.";
}