digraph {
	1842 [label="MarieRank4Convo7 begins.",color=orange];
		1842 -> 1843;
	1843 [label="Evaluate expressions on HellKeyPlayed",color=orange];
		1843 -> 1844 [label="x >= 0",color=purple];
		1843 -> 1845 [label="x <= 0",color=purple];
		1843 -> 1845 [label="false",color=purple];
	1844 [label="Мандрівниче, excusez-moi… Невже ти справді віриш у те, що мудро допомагати дияволу ?",shape=box,color=blue];
		1844 -> 1846;
	1845 [label="Chat ends.",color=orange];
	1846 [label="Я не бажаю відмовляти тим, хто прагне покаяння чи допомоги, але… не думаю, що дияволу потрібне щось із цього.",shape=box,color=blue];
		1846 -> 1847;
		1846 -> 1848;
		1846 -> 1849;
		1846 -> 1850;
	1847 [label="А що, на твою думку, йому справді потрібно?",shape=box,color=red];
		1847 -> 1851;
	1848 [label="Я знаю, що ви двоє не миритеся. І мені прикро за це. Але я справді не можу його вигнати.",shape=box,color=red];
		1848 -> 1852;
	1849 [label="Роут забув (буквально) про орокінів більше, аніж ми коли-небудь знали. Він нам потрібен.",shape=box,color=red];
		1849 -> 1853;
	1850 [label="[Завершити розмову]",shape=box,color=red];
		1850 -> 1854;
	1851 [label="Це дика тварина. Наблизиться, якщо запропонувати їжу й теплу постіль, але враз зміниться, коли не бачитиме в тобі користі.",shape=box,color=blue];
		1851 -> 1855;
	1852 [label="Add 1 to Thermostat",color=orange];
		1852 -> 1856;
	1853 [label="Add -1 to Thermostat",color=orange];
		1853 -> 1851;
	1854 [label="Chat ends.",color=orange];
	1855 [label="Йому щось потрібно від тебе. Від нас. ",shape=box,color=blue];
		1855 -> 1857;
	1856 [label="Non, я й не кажу, що так треба робити. Просто він… із тих, кому не можна довіряти. Ні зараз, ні коли-небудь.",shape=box,color=blue];
		1856 -> 1851;
	1857 [label="Evaluate expressions on HellKeyPlayed",color=orange];
		1857 -> 1859 [label="x > 5",color=purple];
		1857 -> 1858 [label="x <= 5",color=purple];
		1857 -> 1858 [label="false",color=purple];
	1859 [label="Evaluate expressions on HellKeyPlayed",color=orange];
		1859 -> 1863 [label="x >= 21",color=purple];
		1859 -> 1862 [label="x < 21",color=purple];
		1859 -> 1862 [label="false",color=purple];
	1858 [label="Ці його втрачені спогади, жахіття з минулого Тау… Мене непокоїть те, що вони можуть віщувати.",shape=box,color=blue];
		1858 -> 1860;
		1858 -> 1861;
	1863 [label="Я знаю, що ти вважаєш, буцімто ми знайшли все можливе в його розтрощених спогадах.",shape=box,color=blue];
		1863 -> 1866;
		1863 -> 1861;
	1862 [label="Що більше ми взнаємо, глибше занурюємося в його розтрощені спогади, то більше я нервую. Небезпека стає дедалі явнішою й очевиднішою.",shape=box,color=blue];
		1862 -> 1861;
		1862 -> 1860;
	1860 [label="Не думаю, що він отак візьме й зникне, коли згадає все. Тут є щось більше.",shape=box,color=red];
		1860 -> 1864;
	1861 [label="Імовірно, він прагне чогось більшого. Не від спогадів. А від нас.",shape=box,color=red];
		1861 -> 1865;
	1866 [label="Я вірю йому, коли він каже, що це все, що ми дізнаємося. І якщо це так, то чому він досі тут?",shape=box,color=red];
		1866 -> 1864;
	1864 [label="Я визнаю, що переживаю більше за те, що він робитиме з цими знаннями, аніж за самі знання.",shape=box,color=blue];
		1864 -> 1867;
	1865 [label="Oui ! Я непокоюся саме через це. Але що це може бути ? Якій його меті ми зараз служимо ?",shape=box,color=blue];
		1865 -> 1867;
	1867 [label="Як би він не сподівався скористатися цим новим існуванням, боюся, що він планує втягнути нас у це все. І мені хотілося б не засліплювати себе сподіваннями в його добрі наміри.",shape=box,color=blue];
		1867 -> 1868;
		1867 -> 1869;
		1867 -> 1870;
	1868 [label="Я тут із тобою. Не довіряю йому.",shape=box,color=red];
		1868 -> 1871;
	1869 [label="Він має міць і знання. Він із тих, кого хочеться бачити на своєму боці.",shape=box,color=red];
		1869 -> 1872;
	1870 [label="Сенсу немає переливати з пустого в порожнє, розмірковуючи про можливу зраду. Він цього не зробив. Я не називатиму когось винним у ще не скоєних гріхах.",shape=box,color=red];
		1870 -> 1873;
	1871 [label="+20 Chemistry",color=orange];
		1871 -> 1874;
	1872 [label="Add -1 to Thermostat",color=orange];
		1872 -> 1875;
	1873 [label="Add 1 to Thermostat",color=orange];
		1873 -> 1876;
	1874 [label="Bien ! Принаймні я спатиму спокійно, знаючи, що ще одна пара очей стежить за дияволом. Merci.",shape=box,color=blue];
		1874 -> 1877;
	1875 [label="Oui, але мене цікавить яку ціну ми зрештою заплатимо за цей союз. Тобі може вона не сподобатися.",shape=box,color=blue];
		1875 -> 1878;
	1876 [label="Oui… припускаю, що твоя правда. Ми не можемо кидатися на кожну тінь. Повинні стояти пліч-о-пліч із будь-ким, хто бажає поразки Indifférence.",shape=box,color=blue];
		1876 -> 1879;
	1877 [label="Update boolean MarieRoatheNoTrust",color=orange];
		1877 -> 1880;
	1878 [label="Я просто хочу нагадати тобі про обачність… він — чудовисько, у джентльменській шкурі. Обережніше з ним, s'il te plaît ?",shape=box,color=blue];
		1878 -> 1881;
		1878 -> 1882;
	1879 [label="Check boolean DrifterFaithNoMITW",color=orange];
		1879 -> 1883 [label=true,color=green];
		1879 -> 1884 [label=false,color=brown];
	1880 [label="Chat ends.",color=orange];
	1881 [label="Я думаю, що ти трохи упереджена стосовно нього.",shape=box,color=red];
		1881 -> 1885;
	1882 [label="Я пильнуватиму. Обіцяю.",shape=box,color=red];
		1882 -> 1886;
	1883 [label="Навіть якщо ти віриш у те, що сила за цим стоїть не Божа, а лише все в нашій власній свідомості, то це все одно загроза.",shape=box,color=blue];
		1883 -> 1878;
	1884 [label="Навіть якщо він вірить у те, що сила за цим стоїть не Божа, а лише все в нашій власній свідомості, то це все одно загроза.",shape=box,color=blue];
		1884 -> 1878;
	1885 [label="Add -1 to Thermostat",color=orange];
		1885 -> 1887;
	1886 [label="+20 Chemistry",color=orange];
		1886 -> 1888;
	1887 [label="Oui ? Це як так ? Це не з жорстокості питаю — мені дійсно цікаво.",shape=box,color=blue];
		1887 -> 1889;
		1887 -> 1890;
		1887 -> 1891;
		1887 -> 1892;
	1888 [label="Merci. Це все, що я можу просити.",shape=box,color=blue];
		1888 -> 1893;
	1889 [label="Він виріс в іншому суспільстві й в інші часи, з іншими очікуваннями. Нам це може не подобатися, але він той, ким є.",shape=box,color=red];
		1889 -> 1894;
	1890 [label="Ви з Ліоном прийняли сироватку протофреймів від Ентраті. Добровільно. А він ні. Можеш собі уявити, як це?",shape=box,color=red];
		1890 -> 1895;
		1890 -> 1896;
		1890 -> 1894;
	1891 [label="Він кілька століть жив так, як вважав за потрібне. Ми просто маємо різні погляди на те, що саме вважати за потрібне.",shape=box,color=red];
		1891 -> 1895;
		1891 -> 1897;
	1892 [label="Я думаю, що загалом… тебе відштовхує його поведінка. А не дії.",shape=box,color=red];
		1892 -> 1897;
		1892 -> 1895;
	1893 [label="Chat ends.",color=orange];
	1894 [label="Він із вищого військового керівництва та світської еліти. І те, і інше іноді потребує сумнівних рішень.",shape=box,color=red];
		1894 -> 1898;
	1895 [label="Думаю, що будь-хто може робити те, що ми вважаємо «поганим», з абсолютно добрими намірами.",shape=box,color=red];
		1895 -> 1899;
	1896 [label="Він робив усе в ім’я порятунку орокінської імперії — а віддячили йому відправленням у цей безлад супроти його волі.",shape=box,color=red];
		1896 -> 1898;
	1897 [label="Я думаю, що він тебе дратує, бо пишається скоєним.",shape=box,color=red];
		1897 -> 1900;
	1898 [label="Check boolean MarieGrineer",color=orange];
		1898 -> 1902 [label=true,color=green];
		1898 -> 1901 [label=false,color=brown];
	1899 [label="Ти можеш вважати його дияволом, але він у своїй свідомості вважає геть інакше.",shape=box,color=red];
		1899 -> 1898;
	1900 [label="Oui, мені не до вподоби ті, хто впиваються смертю. І його жага проливати кров жахає. І той факт, що тебе це влаштовує, теж не дуже комфортний.",shape=box,color=blue];
		1900 -> 1903;
	1902 [label="Я думаю, що ті, хто командує тими «корпусівцями» чи «ґрінерами», з якими ти б’єшся, скажуть те саме. Вони не вважають себе поганими.",shape=box,color=blue];
		1902 -> 1904;
	1901 [label="Я думаю, що ті, хто командує тими «корпусівцями» чи «ґрі-не-ра-ми», з якими ти б’єшся, скажуть те саме. Вони не вважають себе поганими.",shape=box,color=blue];
		1901 -> 1904;
	1903 [label="Дуже легко перестрибнути зі шляху зречення до насильства, забути про його страшну сторону й нехтувати всіма жахіттями в ім’я «того, що має значення».",shape=box,color=blue];
		1903 -> 1905;
	1904 [label="Вони вірять, що їхні дії добрі, справедливі й необхідні. Як ти можеш виправдовувати одного диявола й заплющувати очі на інших ?",shape=box,color=blue];
		1904 -> 1906;
		1904 -> 1907;
		1904 -> 1908;
		1904 -> 1909;
	1905 [label="Пишатися саме такими діяннями… це вже занадто для мене. Я не радію, коли мушу забирати життя, на відміну від нього. Тож он воно що ? Ми занадто різні.",shape=box,color=blue];
		1905 -> 1910;
	1906 [label="Я намагатимуся зупинити їх, коли робитимуть те, з чим не погоджуюся… Але битимуся з ними пліч-о-пліч, коли знадобиться.",shape=box,color=red];
		1906 -> 1911;
	1907 [label="Я не вірю в те, що ці групи «добрі» чи «погані» за визначенням. Лише за вибраними діями.",shape=box,color=red];
		1907 -> 1912;
	1908 [label="Це не мені казати, що якісь дії «хороші» чи якісь «погані». Я роблю все можливе для захисту тих, хто потребує захисту.",shape=box,color=red];
		1908 -> 1911;
	1909 [label="Ти вимагаєш від мене судження цілої групи за тими ж мірками, які використані для оцінки однієї особи.",shape=box,color=red];
		1909 -> 1912;
	1910 [label="Я можу лише молитися про те, що ще не занадто пізно й диявол не планує встромити тобі ножа поміж ребер. Не дуже до душі думки, що твої останні слова й думки будуть: «Марі ж мене попереджала».",shape=box,color=blue];
		1910 -> 1913;
		1910 -> 1914;
	1911 [label="І ти вважаєш, що диявол — не загроза ? Що він non dangereux для всіх довкола ? Він може завдати значної шкоди.",shape=box,color=blue];
		1911 -> 1915;
		1911 -> 1916;
	1912 [label="А ті жахливі скоєні вчинки ? Усі ті смерті, кровопролитна бездушна різанина ? Як ці дії виправдовуються в тобі ?",shape=box,color=blue];
		1912 -> 1916;
	1913 [label="Він цього не зробить. А якщо й спробує — я його зупиню.",shape=box,color=red];
		1913 -> 1917;
	1914 [label="Обіцяю, такі думки чи слова не будуть моїми останніми.",shape=box,color=red];
		1914 -> 1918;
	1915 [label="Якщо так трапиться і він піде проти нас — я діятиму. А до того часу він проявляв себе лише союзником. Лише… трішки мелодраматичним.",shape=box,color=red];
		1915 -> 1919;
	1916 [label="Я не бачу проблеми в його небезпечності. Він — зброя. А зброю можна використовувати як для вбивств, так і для захисту.",shape=box,color=red];
		1916 -> 1920;
	1917 [label="Обожнюю твою віру в себе, але журюся від твоєї віри в нього. Тож, гадаю, мені теж варто повірити в тебе.",shape=box,color=blue];
		1917 -> 1921;
	1918 [label="Я сподіваюся, що ти це говориш не в тому сенсі, як я думаю, але не надаватиму цій фразі надто великого значення.",shape=box,color=blue];
		1918 -> 1921;
	1919 [label="Add 1 to Thermostat",color=orange];
		1919 -> 1910;
	1920 [label="Add -1 to Thermostat",color=orange];
		1920 -> 1910;
	1921 [label="Я мушу йти. Та знову закликаю тебе пильнувати себе. Задля мене, якщо не заради себе, d'accord ?",shape=box,color=blue];
		1921 -> 1922;
	1922 [label="+20 Chemistry",color=orange];
		1922 -> 1923;
	1923 [label="Chat ends.",color=orange];
}