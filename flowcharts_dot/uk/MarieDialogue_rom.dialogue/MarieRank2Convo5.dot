digraph {
	735 [label="MarieRank2Convo5 begins.",color=orange];
		735 -> 736;
	736 [label="Evaluate expressions",color=orange];
		736 -> 739 [label="MarieOtak1",color=purple];
		736 -> 738 [label="MarieFamily1",color=purple];
		736 -> 737 [label="false",color=purple];
	739 [label="Я розмірковувала над твоїми словами стосовно монсеньйора Отака.",shape=box,color=blue];
		739 -> 743;
	738 [label="Я розмірковувала над твоїми словами стосовно родини le Cardinal.",shape=box,color=blue];
		738 -> 742;
	737 [label="Якщо не проти, то я маю ще одне питання стосовно монсеньйора «Некралойда».",shape=box,color=blue];
		737 -> 741;
		737 -> 740;
	743 [label="Дійшла до думки, що ця історія схожа на мою. Може, я розповім тобі її, якщо маєш час ?",shape=box,color=blue];
		743 -> 749;
		743 -> 748;
	742 [label="Чи можеш ти мені розповісти історію Отака, чиє дитяче обличчя замість тімені некралойда?",shape=box,color=blue];
		742 -> 747;
		742 -> 746;
	741 [label="Так, звісно, запитуй.",shape=box,color=red];
		741 -> 745;
	740 [label="[Завершити розмову]",shape=box,color=red];
		740 -> 744;
	749 [label="Пиши.",shape=box,color=red];
		749 -> 754;
	748 [label="[Завершити розмову]",shape=box,color=red];
		748 -> 753;
	747 [label="Без питань.",shape=box,color=red];
		747 -> 752;
	746 [label="Якось іншим разом. [Завершити розмову]",shape=box,color=red];
		746 -> 751;
	745 [label="Мені стало цікаво, чого на спині є ще одне обличчя, яке нагадує дитячі каракулі.",shape=box,color=blue];
		745 -> 750;
	744 [label="Chat ends.",color=orange];
	754 [label="У Cathédrale була сестра, яка одного разу заблукала в коридорах свого минулого. Її звали Сесилія.",shape=box,color=blue];
		754 -> 757;
	753 [label="Chat ends.",color=orange];
	752 [label="З усіх подій стає зрозумілим, що він був генієм і тим, хто опанував використання кристалів аргону.",shape=box,color=red];
		752 -> 756;
	751 [label="Chat ends.",color=orange];
	750 [label="Я спитала монсеньйора Некралойда і монсеньйора Лойда. Ніхто з них не захотів про це говорити, лише назвали одне ім’я. Отак. І вони вимовляли його з великим сумом у голосі.",shape=box,color=blue];
		750 -> 755;
	757 [label="Зазвичай вона стояла перед величезним годинником у коридорі й проголошувала другу годину дня, хоча насправді й не знала котра година.",shape=box,color=blue];
		757 -> 761;
	756 [label="А вони походять із Порожнечі. І саме завдяки їм ми можемо створювати чимало ворфреймів та потужну зброю.",shape=box,color=red];
		756 -> 760;
	755 [label="Тож ось я сподіваюся, що ти зможеш мені допомогти.",shape=box,color=blue];
		755 -> 758;
		755 -> 759;
	761 [label="Якось ми побачили, що всі картини в коридорах перевернуті. А вона сказала, що вони нашіптують про жахливі події.",shape=box,color=blue];
		761 -> 766;
	760 [label="Він спеціалізувався на криптографії. І його роботи в тутешніх архівах, у лабораторіях.",shape=box,color=red];
		760 -> 765;
	758 [label="Ти хочеш дізнатися про Отака? Чи про те, чому не можеш говорити з ним?",shape=box,color=red];
		758 -> 762;
	759 [label="Отака важко пояснити…",shape=box,color=red];
		759 -> 2919;
	766 [label="Ми довідалися, що вона чула розмови за стінами, але вважала, що це картини говорять…",shape=box,color=blue];
		766 -> 770;
	765 [label="З якихось причин, невідомих мені, його перетворили на цефалона й дали власну оболонку некралойда.",shape=box,color=red];
		765 -> 769;
	762 [label="Гадаю, що з часом захочу знати обидві відповіді. Але дозволю тобі вибрати з чого починати. Я не знаю, що з них важливіше, après tout.",shape=box,color=blue];
		762 -> 2919;
	2919 [label="Check boolean LoidFamilyComplete",color=orange];
		2919 -> 764 [label=true,color=green];
		2919 -> 764 [label=false,color=brown];
		2919 -> 763 [label=false,color=brown];
	770 [label="Якось вона сприйняла подушки на дивані за дітей і пригостила їх усіх чаєм…",shape=box,color=blue];
		770 -> 774;
	769 [label="Не всіх робили цефалонами в покарання. Але на Деймосі все пішло… м'яко кажучи, шкереберть. Його сильно пошкодило.",shape=box,color=red];
		769 -> 773;
	764 [label="Отак колись був архімедівцем, орокінським ученим і академіком. А подальша історія не з тих, що зі щасливим завершенням.",shape=box,color=red];
		764 -> 768;
	763 [label="Ну… якщо коротко, то нагорі частина родини Ентраті. І вони не дуже… тобто зовсім не знають, що ми тут унизу.",shape=box,color=red];
		763 -> 767;
	774 [label="Коли я заїхала в кімнату, то вона поглянула на мене й сказала: «О, сестро Одетто, ось і ти. Тут діти із сиротинця. Ти приєднаєшся до нас ?».",shape=box,color=blue];
		774 -> 777;
		774 -> 778;
	773 [label="+5 Chemistry",color=orange];
		773 -> 776;
	768 [label="Update boolean MarieOtak1",color=orange];
		768 -> 772;
	767 [label="Update boolean MarieFamily1",color=orange];
		767 -> 771;
	777 [label="І що ти зробила?",shape=box,color=red];
		777 -> 781;
	778 [label="Ким була сестра Одетта?",shape=box,color=red];
		778 -> 782;
	776 [label="Pauvre petit…",shape=box,color=blue];
		776 -> 780;
	772 [label="Par les Luminaires… прошу, продовжуй.",shape=box,color=blue];
		772 -> 752;
	771 [label="Par les Luminaires… Тобто ти маєш на увазі, що ми тут усі сидимо потайки ?! Саме тому не можна покидати це місце ?! Mais pourquoi ?!",shape=box,color=blue];
		771 -> 775;
	781 [label="Я підкотила своє крісло до вільного місця за столом і пила чай із нею та подушками. Що ще я могла зробити ?",shape=box,color=blue];
		781 -> 787;
	782 [label="Боюся, сестра Одетта вже тридцять років як була мертвою на той час.",shape=box,color=blue];
		782 -> 788;
	780 [label="Тож його перенесли до головного некралойда (єдиного, який лишився) і… ну? Складно пояснити.",shape=box,color=red];
		780 -> 784;
		780 -> 785;
		780 -> 786;
	775 [label="Його донька Евлерія (також відома як Матір) і її родина весь цей час піклувалися про Деймос.",shape=box,color=red];
		775 -> 779;
	787 [label="О, як же ми сміялися разом над історіями з її минулого. Історіями, які сестра сесилія нікому раніше не розповідала. Принаймні наскільки я можу бути певною.",shape=box,color=blue];
		787 -> 791;
	788 [label="Я підкотила своє крісло до вільного місця за столом і пила чай з нею та подушками.",shape=box,color=blue];
		788 -> 787;
	784 [label="Знаєш, мені б дуже хотілося полагодити його. Повернути справжнього Отака.",shape=box,color=red];
		784 -> 754;
	785 [label="Він змушує мене всміхатися. Він кумедний, але іноді приховує щось трагічне, свою поламаність.",shape=box,color=red];
		785 -> 754;
	786 [label="На жаль, його неможливо полагодити. І ще він доволі сильно дратує. ",shape=box,color=red];
		786 -> 754;
	779 [label="Наглядали за цим місцем і за серцем, яке перекачує енергію Порожнечі в Материнську систему, що дозволяє нам усім… бути корисними, насправді. І це все аж з моменту зникнення Ентраті.",shape=box,color=red];
		779 -> 783;
	791 [label="Її очі в певні миті світилися, але частіше були тьмяними й неживими, як у ляльки…",shape=box,color=blue];
		791 -> 794;
		791 -> 795;
		791 -> 796;
		791 -> 797;
	783 [label="Check /Lotus/Scripts/1999/DialogueScriptNodes.lua:IsSyndicateRank",color=orange];
		783 -> 789 [label=true,color=green];
		783 -> 790 [label=false,color=brown];
	794 [label="Чому ти була поруч із нею?",shape=box,color=red];
		794 -> 800;
	795 [label="Що сталося з сестрою Сесилією?",shape=box,color=red];
		795 -> 801;
	796 [label="Сподіваюся, твоя присутність щось значила для неї.",shape=box,color=red];
		796 -> 802;
	797 [label="Бути поруч із нею було проявом добра з твого боку.",shape=box,color=red];
		797 -> 803;
	789 [label="Вона змирилася з його відсутністю. Вони помирилися одне з одним. Але цього досягти було дуже складно.",shape=box,color=red];
		789 -> 792;
	790 [label="Вона не змирилася з його відсутністю. Вони ладні одне одному горлянки перегризти.",shape=box,color=red];
		790 -> 793;
	800 [label="+15 Chemistry",color=orange];
		800 -> 806;
	801 [label="Те, що трапляється з усіма в її стані. Вона й далі згасала, наче картина вигорає від сонячних променів… Допоки не лишилося нічого. ",shape=box,color=blue];
		801 -> 807;
	802 [label="+10 Chemistry",color=orange];
		802 -> 808;
	803 [label="+5 Chemistry",color=orange];
		803 -> 809;
	792 [label="Знати, що він десь досі там, займається чимось. І навіть слова не сказав їй, листа не написав?..",shape=box,color=red];
		792 -> 798;
	793 [label="Знати, що він десь досі там, займається чимось. І навіть слова не сказав їй, листа не написав?..",shape=box,color=red];
		793 -> 799;
	806 [label="Мудре запитання. Дуже мудре. Думаю, мене надихали чимало причин. Хотілося б уважати, що саме доброта привела мене до того столу.",shape=box,color=blue];
		806 -> 812;
	807 [label="Потім вона покинула нас. І за нею влаштували панахиду зі свічками. Сподіваюся, що в кінці вона згадала тих, хто насправді добре ставився до неї. ",shape=box,color=blue];
		807 -> 813;
	808 [label="Дуже хочу вірити, що вона розуміла. Десь там у глибині душі.",shape=box,color=blue];
		808 -> 813;
	809 [label="Та чи була це доброта ? Чи то провина штовхала мене до цього ? О, та це ти ж пишеш це, бо теж виявляєш доброту такими словами. ",shape=box,color=blue];
		809 -> 813;
	798 [label="Навіть уявити не можу, як боляче це було б для неї. Для них.",shape=box,color=red];
		798 -> 804;
	799 [label="Це зруйнувало б ту крихітну ймовірність на можливе примирення.",shape=box,color=red];
		799 -> 805;
	812 [label="Та знаєш, десь у глибині душі я думаю, що то було відчуття провини. Якби я не вчинила так, то значить знехтувала би нею. Як хтось може знехтувати дитиною.",shape=box,color=blue];
		812 -> 813;
	813 [label="Хотілося б вірити, що твій Отак знає тих, хто добрий і терплячий з ним. Але ж знову питання: він же не насправді там, non ?",shape=box,color=blue];
		813 -> 817;
	804 [label="Та я бачу хід думок, що призвів до рішення захистити їх від болю, який спричинив le Cardinal своїм вимушеним відбуттям…",shape=box,color=blue];
		804 -> 810;
	805 [label="+10 Chemistry",color=orange];
		805 -> 811;
	817 [label="Я маю на увазі дуже складу технологію, створену для відтворення людини, так ? Phonographe, але набагато складніший. У нього нема душі, як і в Некралойда.",shape=box,color=blue];
		817 -> 822;
		817 -> 823;
		817 -> 824;
		817 -> 825;
		817 -> 826;
	810 [label="Я вважаю, що це жорстоко… безпідставно, а ти? Вони могли вважати його мертвим. Або ще гірше ! А ми живемо тут, comme des rats d'égout ?",shape=box,color=blue];
		810 -> 814;
		810 -> 815;
	811 [label="Oui… Логіка зрозуміла. Я би попрацювала над зціленням стосунків. Якщо можеш, то чом би й ні, правда ж? Видається, це єдина надія для будь-кого з нас вибратися звідси. ",shape=box,color=blue];
		811 -> 816;
	822 [label="Некралойд може й не має душі, але він неповторний. Інші ж цефалони, як Отак, її мали. Для їхнього створення її нищили.",shape=box,color=red];
		822 -> 831;
	823 [label="Так, твоя правда. То що мені, по-твоєму, робити з цим?",shape=box,color=red];
		823 -> 832;
	824 [label="Так, твоя правда. Душі нема. Але це не означає, що ми можемо погано до них ставитися.",shape=box,color=red];
		824 -> 833;
	825 [label="Я не знаю, так це чи ні. Але вони можуть мислити й відчувати. А ми не повинні ставитися до них, як до речей.",shape=box,color=red];
		825 -> 834;
	826 [label="Некралойд має душу. Вона є у всіх цефалонів.",shape=box,color=red];
		826 -> 835;
	814 [label="Це не зовсім я маю приймати подібне рішення.",shape=box,color=red];
		814 -> 818;
	815 [label="Насправді, у мене є подруга, яка обожнює пацюків. Гадаю, вони дуже милі.",shape=box,color=red];
		815 -> 819;
	816 [label="Щоб ми доживали життя в тутешній пастці, des rats d'égout. ",shape=box,color=blue];
		816 -> 820;
		816 -> 821;
	831 [label="Update boolean MarieCephalonSoul",color=orange];
		831 -> 839;
	832 [label="Update boolean MarieCephalonNoSoul",color=orange];
		832 -> 840;
	833 [label="Update boolean MarieCephalonNoSoul",color=orange];
		833 -> 841;
	834 [label="Update boolean MarieCephalonUnsure",color=orange];
		834 -> 842;
	835 [label="Update boolean MarieCephalonSoul",color=orange];
		835 -> 843;
	818 [label="Я знаю. Це справа монсеньйора Лойда. Його рішення й інших. Лише тоді знатимуть.",shape=box,color=blue];
		818 -> 827;
	819 [label="+15 Chemistry",color=orange];
		819 -> 828;
	820 [label="Це прояв моєї недбалості. Твоя правда. Повернуся до роботи.",shape=box,color=red];
		820 -> 829;
	821 [label="Насправді в мене є подруга, яка обожнює пацюків. Гадаю вони дуже милі. ",shape=box,color=red];
		821 -> 830;
	839 [label="+5 Chemistry",color=orange];
		839 -> 845;
	840 [label="Ой, ти не подумай, що я від тебе прагну жорстокості ! Non ! Цінуй їх, бо вони дорогоцінні. Не їхня провина в тому, що вони стали тими, ким є !",shape=box,color=blue];
		840 -> 846;
	841 [label="+5 Chemistry",color=orange];
		841 -> 840;
	842 [label="+5 Chemistry",color=orange];
		842 -> 847;
	843 [label="+5 Chemistry",color=orange];
		843 -> 848;
	827 [label="Можу припустити, що нас тримає тут унизу саме почуття провини, а не шляхетність.",shape=box,color=blue];
		827 -> 836;
	828 [label="Я б залюбки з ними познайомилася котрогось дня, але навряд чи це те саме, про що я, дурненьке вовченя.",shape=box,color=blue];
		828 -> 827;
	829 [label="+5 Chemistry",color=orange];
		829 -> 837;
	830 [label="+5 Chemistry",color=orange];
		830 -> 838;
	845 [label="Ще більше доказів того, що диявола та йому подібних засуджують по праву. Але може бути й твоя правда стосовно Отака та інших. Або просто тобі спокійніше від такої думки.",shape=box,color=blue];
		845 -> 850;
	846 [label="Моє серце крається лише від понівечених тіл, які орокінські дияволи лишили по собі. Вони були не богами, а пожирачами. Змітали все на своєму шляху. Задля доказів можеш подивитися на того, з ким ми мандруємо.",shape=box,color=blue];
		846 -> 851;
	847 [label="Може й твоя правда, але не думаю, що орокінські дияволи знали більше про поняття душі, аніж ми. Вони не були ліпшими за богів.",shape=box,color=blue];
		847 -> 852;
	848 [label="Може й так, а може тобі просто спокійніше від такої думки.",shape=box,color=blue];
		848 -> 851;
	836 [label="Бо ми приховуємо якийсь великий і жахливий гріх.",shape=box,color=blue];
		836 -> 844;
	837 [label="Дякую. Я не знаю, чи вдасться тобі досягти успіху, але іноді ми не можемо нічим зарадити. Лишається лише намагатися.",shape=box,color=blue];
		837 -> 827;
	838 [label="Я б залюбки з ними познайомилася котрогось дня, але навряд чи це те саме, про що я, дурненьке вовченя.",shape=box,color=blue];
		838 -> 827;
	850 [label="Хай там як, я обираю вірити в те, що Отак, котрий помер дуже давно, усміхнувся б нам зараз, якби ми проявили доброту до того, що живе з його пам’яттю.",shape=box,color=blue];
		850 -> 2920;
	851 [label="Мені дуже складно казати, що в некралойда є душа, коли Лойд стоїть поруш із ним, oui ?",shape=box,color=blue];
		851 -> 850;
	852 [label="Розвинуті технологічно… чи може сильні в науці — так… але душа ? Вони ледве могли б опанувати свої серця ! Поглянь на диявола, з яким ми мандруємо, якщо тобі потрібно більше доказів.",shape=box,color=blue];
		852 -> 851;
	844 [label="І той гріх спершу має бути прощеним.",shape=box,color=blue];
		844 -> 849;
	2920 [label="Check boolean LoidFamilyComplete",color=orange];
