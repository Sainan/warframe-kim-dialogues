	j156326733 [label="Я теж. Але думаю, маємо дізнатися більше подробиць, які все це ускладнюють, oui?",shape=box,color=blue];
		j156326733 -> j3949156425;
	j1741467025 [label="Я теж. Але думаю, маємо дізнатися більше подробиць, які все це ускладнюють, oui? На жаль, на сьогодні вже досить історій.",shape=box,color=blue];
