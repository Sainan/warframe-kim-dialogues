digraph {
	graph [fontname="Roboto Condensed"];
	node [fontname="Roboto Condensed"];
	edge [fontname="Roboto Condensed"];

	"MarieRank2Convo5 begins." [color=orange];
		"MarieRank2Convo5 begins." -> j1631090094;
	j1631090094 [label="Evaluate expressions",color=orange];
		j1631090094 -> j1331419180 [label="MarieOtak1",color=purple];
		j1631090094 -> j2943311372 [label="MarieFamily1",color=purple];
		j1631090094 -> j1304707428 [label="false",color=purple];
	j1331419180 [label="Я розмірковувала над твоїми словами стосовно монсеньйора Отака.",shape=box,color=blue];
		j1331419180 -> j1757176075;
	j2943311372 [label="Я розмірковувала над твоїми словами стосовно родини le Cardinal.",shape=box,color=blue];
		j2943311372 -> j372445098;
	j1304707428 [label="Якщо не проти, то я маю ще одне питання стосовно монсеньйора «Некралойда».",shape=box,color=blue];
		j1304707428 -> j4140509234;
		j1304707428 -> j1478915251;
	j1757176075 [label="Дійшла до думки, що ця історія схожа на мою. Може, я розповім тобі її, якщо маєш час ?",shape=box,color=blue];
		j1757176075 -> j2357123139;
		j1757176075 -> j1478915251;
	j372445098 [label="Чи можеш ти мені розповісти історію Отака, чиє дитяче обличчя замість тімені некралойда?",shape=box,color=blue];
		j372445098 -> j3734126499;
		j372445098 -> j196190777;
	j4140509234 [label="Так, звісно, запитуй.",shape=box,color=red];
		j4140509234 -> j1770444672;
	j1478915251 [label="[Завершити розмову]",shape=box,color=red];
		j1478915251 -> "Chat ends.";
	j2357123139 [label="Пиши.",shape=box,color=red];
		j2357123139 -> j3775000266;
	j3734126499 [label="Без питань.",shape=box,color=red];
		j3734126499 -> j2499305908;
	j196190777 [label="Якось іншим разом. [Завершити розмову]",shape=box,color=red];
		j196190777 -> "Chat ends.";
	j1770444672 [label="Мені стало цікаво, чого на спині є ще одне обличчя, яке нагадує дитячі каракулі.",shape=box,color=blue];
		j1770444672 -> j4188264427;
	"Chat ends." [color=orange];
	j3775000266 [label="У Cathédrale була сестра, яка одного разу заблукала в коридорах свого минулого. Її звали Сесилія.",shape=box,color=blue];
		j3775000266 -> j1835279767;
	j2499305908 [label="З усіх подій стає зрозумілим, що він був генієм і тим, хто опанував використання кристалів аргону.",shape=box,color=red];
		j2499305908 -> j3452752430;
	j4188264427 [label="Я спитала монсеньйора Некралойда і монсеньйора Лойда. Ніхто з них не захотів про це говорити, лише назвали одне ім’я. Отак. І вони вимовляли його з великим сумом у голосі.",shape=box,color=blue];
		j4188264427 -> j72039370;
	j1835279767 [label="Зазвичай вона стояла перед величезним годинником у коридорі й проголошувала другу годину дня, хоча насправді й не знала котра година.",shape=box,color=blue];
		j1835279767 -> j1742832123;
	j3452752430 [label="А вони походять із Порожнечі. І саме завдяки їм ми можемо створювати чимало могутніх ворфреймів та потужну зброю.",shape=box,color=red];
		j3452752430 -> j3600427425;
	j72039370 [label="Тож ось я сподіваюся, що ти зможеш мені допомогти.",shape=box,color=blue];
		j72039370 -> j534982545;
		j72039370 -> j2433824277;
	j1742832123 [label="Якось ми побачили, що всі картини в коридорах перевернуті. А вона сказала, що вони нашіптують про жахливі події.",shape=box,color=blue];
		j1742832123 -> j3524354108;
	j3600427425 [label="Він спеціалізувався на криптографії. І його роботи в тутешніх архівах, у лабораторіях.",shape=box,color=red];
		j3600427425 -> j1362465271;
	j534982545 [label="Ти хочеш дізнатися про Отака? Чи про те, чому не можеш говорити з ним?",shape=box,color=red];
		j534982545 -> j999594931;
	j2433824277 [label="Отака важко пояснити…",shape=box,color=red];
		j2433824277 -> j2100059297;
	j3524354108 [label="Ми довідалися, що вона чула розмови за стінами, але вважала, що це картини говорять…",shape=box,color=blue];
		j3524354108 -> j292611214;
	j1362465271 [label="З якихось причин, невідомих мені, його перетворили на цефалона й дали власну оболонку некралойда.",shape=box,color=red];
		j1362465271 -> j2154177264;
	j999594931 [label="Гадаю, що з часом захочу знати обидві відповіді. Але дозволю тобі вибрати з чого починати. Я не знаю, що з них важливіше, après tout.",shape=box,color=blue];
		j999594931 -> j2100059297;
	j2100059297 [label="Check boolean LoidFamilyComplete",color=orange];
		j2100059297 -> j564143880 [label=true,color=green];
		j2100059297 -> j564143880 [label=false,color=brown];
		j2100059297 -> j3895061612 [label=false,color=brown];
	j292611214 [label="Якось вона сприйняла подушки на дивані за дітей і пригостила їх усіх чаєм…",shape=box,color=blue];
		j292611214 -> j1753951267;
	j2154177264 [label="Не всіх робили цефалонами в покарання. Але на Деймосі все пішло… м'яко кажучи, шкереберть. Його сильно пошкодило.",shape=box,color=red];
		j2154177264 -> j1183483734;
	j564143880 [label="Отак колись був архімедівцем, орокінським ученим і академіком. А подальша історія не з тих, що зі щасливим завершенням.",shape=box,color=red];
		j564143880 -> j507418532;
	j3895061612 [label="Ну… якщо коротко, то нагорі частина родини Ентраті. І вони не дуже… тобто зовсім не знають, що ми тут унизу.",shape=box,color=red];
		j3895061612 -> j1833694438;
	j1753951267 [label="Коли я заїхала в кімнату, то вона поглянула на мене й сказала: «О, сестро Одетто, ось і ти. Тут діти із сиротинця. Ти приєднаєшся до нас ?».",shape=box,color=blue];
		j1753951267 -> j1260300579;
		j1753951267 -> j4186679702;
	j1183483734 [label="+5 Chemistry",color=orange];
		j1183483734 -> j1983447585;
	j507418532 [label="Boolean MarieOtak1 is now true.",color=orange];
		j507418532 -> j2950246512;
	j1833694438 [label="Boolean MarieFamily1 is now true.",color=orange];
		j1833694438 -> j1843021659;
	j1260300579 [label="І що ти зробила?",shape=box,color=red];
		j1260300579 -> j2362227681;
	j4186679702 [label="Ким була сестра Одетта?",shape=box,color=red];
		j4186679702 -> j1441646970;
	j1983447585 [label="Pauvre petit…",shape=box,color=blue];
		j1983447585 -> j1397280471;
	j2950246512 [label="Par les Luminaires… прошу, продовжуй.",shape=box,color=blue];
		j2950246512 -> j2499305908;
	j1843021659 [label="Par les Luminaires… Тобто ти маєш на увазі, що ми тут усі сидимо потайки ?! Саме тому не можна покидати це місце ?! Mais pourquoi ?!",shape=box,color=blue];
		j1843021659 -> j449832868;
	j2362227681 [label="Я підкотила своє крісло до вільного місця за столом і пила чай із нею та подушками. Що ще я могла зробити ?",shape=box,color=blue];
		j2362227681 -> j2333978138;
	j1441646970 [label="Боюся, сестра Одетта вже тридцять років як була мертвою на той час.",shape=box,color=blue];
		j1441646970 -> j2841753113;
	j1397280471 [label="Тож його перенесли до головного некралойда (єдиного, який лишився) і… ну? Складно пояснити.",shape=box,color=red];
		j1397280471 -> j2418230696;
		j1397280471 -> j2382936433;
		j1397280471 -> j2605261963;
	j449832868 [label="Його донька Евлерія (також відома як Матір) і її родина весь цей час піклувалися про Деймос.",shape=box,color=red];
		j449832868 -> j204397941;
	j2333978138 [label="О, як же ми сміялися разом над історіями з її минулого. Історіями, які сестра Сесилія нікому раніше не розповідала. Принаймні наскільки я можу бути певною.",shape=box,color=blue];
		j2333978138 -> j161544050;
	j2841753113 [label="Я підкотила своє крісло до вільного місця за столом і пила чай з нею та подушками.",shape=box,color=blue];
		j2841753113 -> j2333978138;
	j2418230696 [label="Знаєш, мені б дуже хотілося полагодити його. Повернути справжнього Отака.",shape=box,color=red];
		j2418230696 -> j3775000266;
	j2382936433 [label="Він змушує мене всміхатися. Він кумедний, але іноді приховує щось трагічне, свою поламаність.",shape=box,color=red];
		j2382936433 -> j3775000266;
	j2605261963 [label="На жаль, його неможливо полагодити. І ще він доволі сильно дратує. ",shape=box,color=red];
		j2605261963 -> j3775000266;
	j204397941 [label="Наглядали за цим місцем і за серцем, яке перекачує енергію Порожнечі в Материнську систему, що дозволяє нам усім… бути корисними, насправді. І це все аж з моменту зникнення Ентраті.",shape=box,color=red];
		j204397941 -> j3382079857;
	j161544050 [label="Її очі в певні миті світилися, але частіше були тьмяними й неживими, як у ляльки…",shape=box,color=blue];
		j161544050 -> j2750906807;
		j161544050 -> j2694693647;
		j161544050 -> j2573559725;
		j161544050 -> j276438409;
	j3382079857 [label="Check /Lotus/Scripts/1999/DialogueScriptNodes.lua:IsSyndicateRank(syndicate=EntratiSyndicate, syndicateRank=5)",color=orange];
		j3382079857 -> j3160834621 [label=true,color=green];
		j3382079857 -> j1980571544 [label=false,color=brown];
	j2750906807 [label="Чому ти була поруч із нею?",shape=box,color=red];
		j2750906807 -> j4239589250;
	j2694693647 [label="Що сталося з сестрою Сесилією?",shape=box,color=red];
		j2694693647 -> j968113423;
	j2573559725 [label="Сподіваюся, твоя присутність щось значила для неї.",shape=box,color=red];
		j2573559725 -> j2594338637;
	j276438409 [label="Бути поруч із нею було проявом добра з твого боку.",shape=box,color=red];
		j276438409 -> j1186512839;
	j3160834621 [label="Вона змирилася з його відсутністю. Вони помирилися одне з одним. Але цього досягти було дуже складно.",shape=box,color=red];
		j3160834621 -> j1597030677;
	j1980571544 [label="Check boolean MarieSyndicateMaxRank",color=orange];
		j1980571544 -> j3160834621 [label=true,color=green];
		j1980571544 -> j3947801603 [label=false,color=brown];
	j4239589250 [label="+15 Chemistry",color=orange];
		j4239589250 -> j3739257243;
	j968113423 [label="Те, що трапляється з усіма в її стані. Вона й далі згасала, наче картина вигорає від сонячних променів… Допоки не лишилося нічого. ",shape=box,color=blue];
		j968113423 -> j1862186398;
	j2594338637 [label="+10 Chemistry",color=orange];
		j2594338637 -> j813687594;
	j1186512839 [label="+5 Chemistry",color=orange];
		j1186512839 -> j1813864376;
	j1597030677 [label="Знати, що він десь досі там, займається чимось. І навіть слова не сказав їй, листа не написав?..",shape=box,color=red];
		j1597030677 -> j2635052365;
	j3947801603 [label="Вона не змирилася з його відсутністю. Вони ладні одне одному горлянки перегризти.",shape=box,color=red];
		j3947801603 -> j3383817874;
	j3739257243 [label="Мудре запитання. Дуже мудре. Думаю, мене надихали чимало причин. Хотілося б уважати, що саме доброта привела мене до того столу.",shape=box,color=blue];
		j3739257243 -> j1607209549;
	j1862186398 [label="Потім вона покинула нас. І за нею влаштували панахиду зі свічками. Сподіваюся, що в кінці вона згадала тих, хто насправді добре ставився до неї. ",shape=box,color=blue];
		j1862186398 -> j2816698326;
	j813687594 [label="Дуже хочу вірити, що вона розуміла. Десь там у глибині душі.",shape=box,color=blue];
		j813687594 -> j2816698326;
	j1813864376 [label="Та чи була це доброта ? Чи то провина штовхала мене до цього ? О, та це ти ж пишеш це, бо теж виявляєш доброту такими словами. ",shape=box,color=blue];
		j1813864376 -> j2816698326;
	j2635052365 [label="Навіть уявити не можу, як боляче це було б для неї. Для них.",shape=box,color=red];
		j2635052365 -> j4158566961;
	j3383817874 [label="Знати, що він десь досі там, займається чимось. І навіть слова не сказав їй, листа не написав?..",shape=box,color=red];
		j3383817874 -> j2597483447;
	j1607209549 [label="Та знаєш, десь у глибині душі я думаю, що то було відчуття провини. Якби я не вчинила так, то значить знехтувала би нею. Як хтось може знехтувати дитиною.",shape=box,color=blue];
		j1607209549 -> j2816698326;
	j2816698326 [label="Хотілося б вірити, що твій Отак знає тих, хто добрий і терплячий з ним. Але ж знову питання: він же не насправді там, non ?",shape=box,color=blue];
		j2816698326 -> j3307556897;
	j4158566961 [label="Та я бачу хід думок, що призвів до рішення захистити їх від болю, який спричинив le Cardinal своїм вимушеним відбуттям…",shape=box,color=blue];
		j4158566961 -> j277919530;
	j2597483447 [label="Це зруйнувало б ту крихітну ймовірність на можливе примирення.",shape=box,color=red];
		j2597483447 -> j566914693;
	j3307556897 [label="Я маю на увазі дуже складну технологію, створену для відтворення людини, так ? Phonographe, але набагато складніший. У нього нема душі, як і в Некралойда.",shape=box,color=blue];
		j3307556897 -> j88647322;
		j3307556897 -> j126320086;
		j3307556897 -> j1853667267;
		j3307556897 -> j2754394722;
		j3307556897 -> j3141373323;
	j277919530 [label="Я вважаю, що це жорстоко… безпідставно, а ти? Вони могли вважати його мертвим. Або ще гірше ! А ми живемо тут, comme des rats d'égout ?",shape=box,color=blue];
		j277919530 -> j2212473239;
		j277919530 -> j949455161;
	j566914693 [label="+10 Chemistry",color=orange];
		j566914693 -> j1866826402;
	j88647322 [label="Некралойд може й не має душі, але він неповторний. Інші ж цефалони, як Отак, її мали. Для їхнього створення її нищили.",shape=box,color=red];
		j88647322 -> j4080635298;
	j126320086 [label="Так, твоя правда. То що мені, по-твоєму, робити з цим?",shape=box,color=red];
		j126320086 -> j3887137011;
	j1853667267 [label="Так, твоя правда. Душі нема. Але це не означає, що ми можемо погано до них ставитися.",shape=box,color=red];
		j1853667267 -> j342026886;
	j2754394722 [label="Я не знаю, так це чи ні. Але вони можуть мислити й відчувати. А ми не повинні ставитися до них, як до речей.",shape=box,color=red];
		j2754394722 -> j864551955;
	j3141373323 [label="Некралойд має душу. Вона є у всіх цефалонів.",shape=box,color=red];
		j3141373323 -> j1179970897;
	j2212473239 [label="Це не зовсім я маю приймати подібне рішення.",shape=box,color=red];
		j2212473239 -> j4030997681;
	j949455161 [label="Насправді, у мене є подруга, яка обожнює пацюків. Гадаю, вони дуже милі.",shape=box,color=red];
		j949455161 -> j1689141090;
	j1866826402 [label="Oui… Логіка зрозуміла. Я би попрацювала над зціленням стосунків. Якщо можеш, то чом би й ні, правда ж? Видається, це єдина надія для будь-кого з нас вибратися звідси. ",shape=box,color=blue];
		j1866826402 -> j1233770687;
	j4080635298 [label="Boolean MarieCephalonSoul is now true.",color=orange];
		j4080635298 -> j335897584;
	j3887137011 [label="Boolean MarieCephalonNoSoul is now true.",color=orange];
		j3887137011 -> j1072028837;
	j342026886 [label="Boolean MarieCephalonNoSoul is now true.",color=orange];
		j342026886 -> j3175536232;
	j864551955 [label="Boolean MarieCephalonUnsure is now true.",color=orange];
		j864551955 -> j592418714;
	j1179970897 [label="Boolean MarieCephalonSoul is now true.",color=orange];
		j1179970897 -> j3459967689;
	j4030997681 [label="Я знаю. Це справа монсеньйора Лойда. Його рішення й інших. Лише тоді знатимуть.",shape=box,color=blue];
		j4030997681 -> j1326794117;
	j1689141090 [label="+15 Chemistry",color=orange];
		j1689141090 -> j1067038340;
	j1233770687 [label="Щоб ми доживали життя в тутешній пастці, des rats d'égout. ",shape=box,color=blue];
		j1233770687 -> j1807117851;
		j1233770687 -> j3705546888;
	j335897584 [label="+5 Chemistry",color=orange];
		j335897584 -> j3245102062;
	j1072028837 [label="Ой, ти не подумай, що я від тебе прагну жорстокості ! Non ! Цінуй їх, бо вони дорогоцінні. Не їхня провина в тому, що вони стали тими, ким є !",shape=box,color=blue];
		j1072028837 -> j2375383301;
	j3175536232 [label="+5 Chemistry",color=orange];
		j3175536232 -> j1072028837;
	j592418714 [label="+5 Chemistry",color=orange];
		j592418714 -> j1637878555;
	j3459967689 [label="+5 Chemistry",color=orange];
		j3459967689 -> j2892966260;
	j1326794117 [label="Можу припустити, що нас тримає тут унизу саме почуття провини, а не шляхетність.",shape=box,color=blue];
		j1326794117 -> j1891186637;
	j1067038340 [label="Я б залюбки з ними познайомилася котрогось дня, але навряд чи це те саме, про що я, дурненьке вовченя.",shape=box,color=blue];
		j1067038340 -> j1326794117;
	j1807117851 [label="Це прояв моєї недбалості. Твоя правда. Повернуся до роботи.",shape=box,color=red];
		j1807117851 -> j1877518371;
	j3705546888 [label="Насправді в мене є подруга, яка обожнює пацюків. Гадаю вони дуже милі. ",shape=box,color=red];
		j3705546888 -> j2194099942;
	j3245102062 [label="Ще більше доказів того, що диявола та йому подібних засуджують по праву. Але може бути й твоя правда стосовно Отака та інших. Або просто тобі спокійніше від такої думки.",shape=box,color=blue];
		j3245102062 -> j174585269;
	j2375383301 [label="Моє серце крається лише від понівечених тіл, які орокінські дияволи лишили по собі. Вони були не богами, а пожирачами. Змітали все на своєму шляху. Задля доказів можеш подивитися на того, з ким ми мандруємо.",shape=box,color=blue];
		j2375383301 -> j2183600450;
	j1637878555 [label="Може й твоя правда, але не думаю, що орокінські дияволи знали більше про поняття душі, аніж ми. Вони не були ліпшими за богів.",shape=box,color=blue];
		j1637878555 -> j3324237851;
	j2892966260 [label="Може й так, а може тобі просто спокійніше від такої думки.",shape=box,color=blue];
		j2892966260 -> j2183600450;
	j1891186637 [label="Бо ми приховуємо якийсь великий і жахливий гріх.",shape=box,color=blue];
		j1891186637 -> j3071128056;
	j1877518371 [label="+5 Chemistry",color=orange];
		j1877518371 -> j2405338912;
	j2194099942 [label="+5 Chemistry",color=orange];
		j2194099942 -> j1067038340;
	j174585269 [label="Хай там як, я обираю вірити в те, що Отак, котрий помер дуже давно, усміхнувся б нам зараз, якби ми проявили доброту до того, що живе з його пам’яттю.",shape=box,color=blue];
		j174585269 -> j1531393501;
	j2183600450 [label="Мені дуже складно казати, що в некралойда є душа, коли Лойд стоїть поруш із ним, oui ?",shape=box,color=blue];
		j2183600450 -> j174585269;
	j3324237851 [label="Розвинуті технологічно… чи може сильні в науці — так… але душа ? Вони ледве могли б опанувати свої серця ! Поглянь на диявола, з яким ми мандруємо, якщо тобі потрібно більше доказів.",shape=box,color=blue];
		j3324237851 -> j2183600450;
	j3071128056 [label="І той гріх спершу має бути прощеним.",shape=box,color=blue];
		j3071128056 -> j1230455906;
	j2405338912 [label="Дякую. Я не знаю, чи вдасться тобі досягти успіху, але іноді ми не можемо нічим зарадити. Лишається лише намагатися.",shape=box,color=blue];
		j2405338912 -> j1326794117;
	j1531393501 [label="Check boolean LoidFamilyComplete",color=orange];
		j1531393501 -> j939053935 [label=true,color=green];
		j1531393501 -> j2403707847 [label=false,color=brown];
	j1230455906 [label="Дуже вдячна, завдяки тобі мені є над чим поміркувати. À la revoyure.",shape=box,color=blue];
		j1230455906 -> "Chat ends.";
	j939053935 [label="Маю йти, але merci. Є чимало над чим поміркувати.",shape=box,color=blue];
		j939053935 -> "Chat ends.";
	j2403707847 [label="Я просто сподіваюся, що колись таки познайомлюся з тим дивним fac-similé, що живе на потилиці монсеньйора Лойда, як він здійматиметься сходами.",shape=box,color=blue];
		j2403707847 -> j3811684837;
		j2403707847 -> j1719043615;
	j3811684837 [label="Не думаю, що варто втручатися в справи інших.",shape=box,color=red];
