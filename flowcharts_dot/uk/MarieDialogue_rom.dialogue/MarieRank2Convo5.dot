	j2756464153 [label="Побачимо. Я хочу дізнатися більше подробиць про те, чому ми маємо лишитися тут.",shape=box,color=blue];
		j2756464153 -> j3949156425;
	j259878772 [label="Гадаю, що є якась історія, яку ти приховуєш. Та може вже й достатньо історій для одного дня, oui ?",shape=box,color=blue];
