digraph {
	"MarieRank5Convo5 begins." [color=orange];
		"MarieRank5Convo5 begins." -> j20182927;
	j20182927 [label="Check boolean MarieDating",color=orange];
		j20182927 -> j2620097205 [label=true,color=green];
		j20182927 -> j1037690960 [label=false,color=brown];
	j2620097205 [label="Bonjour, bonjour, mon cœur ! Маю розповісти тобі про найдурніше в житті.",shape=box,color=blue];
		j2620097205 -> j1466213877;
		j2620097205 -> j1478915251;
	j1037690960 [label="Bonjour ! Маю розповісти тобі про найдурніше в житті.",shape=box,color=blue];
		j1037690960 -> j1466213877;
		j1037690960 -> j1478915251;
	j1466213877 [label="О? А що сталося?",shape=box,color=red];
		j1466213877 -> j1309817709;
	j1478915251 [label="[Завершити розмову]",shape=box,color=red];
		j1478915251 -> "Chat ends.";
	j1309817709 [label="Я спитала мсьє Птаха Trois, коли в нього День народження. А він не знав ! Це ж невимовно сумно !",shape=box,color=blue];
		j1309817709 -> j1358221889;
	"Chat ends." [color=orange];
	j1358221889 [label="Ніхто з кавій не знає, коли вони народилися. Що має сенс, насправді, оскільки вони народилися без здібності говорити чи розумітися на календарях.",shape=box,color=blue];
		j1358221889 -> j71329439;
	j71329439 [label="Тож я подумала — це tragédie ! Ми маємо негайно це виправити, non ?",shape=box,color=blue];
		j71329439 -> j9017827;
		j71329439 -> j573729018;
		j71329439 -> j3880685755;
	j9017827 [label="Ніколи таке в голову не приходило.",shape=box,color=red];
		j9017827 -> j1564926003;
	j573729018 [label="І як ти дізнаєшся, коли вони народилися?",shape=box,color=red];
		j573729018 -> j2164308332;
	j3880685755 [label="Ти дозволиш їм самостійно вибрати свої дні?",shape=box,color=red];
		j3880685755 -> j2507921474;
	j1564926003 [label="Oui ! І монсеньйор Лойд теж. Його обличчя виражало абсолютний сум, коли я за це зауважила…",shape=box,color=blue];
		j1564926003 -> j3304887681;
	j2164308332 [label="Спершу я подумала про перевірку записів le Cardinnal. Може, він позначив, коли вони народилися, non ?",shape=box,color=blue];
		j2164308332 -> j2402114516;
	j2507921474 [label="«Дозволиш» ? Ти так говориш, наче це від мене залежить ! ",shape=box,color=blue];
		j2507921474 -> j2164308332;
	j3304887681 [label="Моє серце крається від того, що він вважає себе винним за те, що не додумався першим до цього. Це не його провина, він стільки всього робить для багатьох…",shape=box,color=blue];
		j3304887681 -> j402494670;
	j2402114516 [label="Evaluate expressions",color=orange];
		j2402114516 -> j396161593 [label="MarieEntratiComplete",color=purple];
		j2402114516 -> j396161593 [label="MarieEntrati3a",color=purple];
		j2402114516 -> j3620214444 [label="false",color=purple];
	j402494670 [label="Ми благословенні в тому, що пізнали доброту монсеньйора Лойда. Глибина колодязя, з якої він її черпає, не знає меж.",shape=box,color=blue];
		j402494670 -> j2256084809;
		j402494670 -> j686908853;
	j396161593 [label="А потім я згадала… розмову з мсьє Таґфером. Та іншими. І подумала… це, мабуть, не дуже мудра думка.",shape=box,color=blue];
		j396161593 -> j1594144054;
	j3620214444 [label="Вони наче не зацікавлені в пошуках записів про своє минуле. Я знаю, якими болючими бувають думки про своє походження.",shape=box,color=blue];
		j3620214444 -> j1594144054;
	j2256084809 [label="Нам дуже пощастило, що він тут.",shape=box,color=red];
		j2256084809 -> j2425168386;
	j686908853 [label="Мені просто хотілося б, щоб він був час від часу трішки веселішим.",shape=box,color=red];
		j686908853 -> j2749073819;
	j1594144054 [label="Зрештою, я теж не знаю дату власного народження. ",shape=box,color=blue];
		j1594144054 -> j3085711181;
		j1594144054 -> j884024958;
		j1594144054 -> j3066992079;
	j2425168386 [label="Oui, це так. Пощастило нам усім.",shape=box,color=blue];
		j2425168386 -> j3542593548;
	j2749073819 [label="Він дуже серйозний, але я бачила усмішку на його обличчі. Його гумор там, де ніхто не запідозрить. Просто треба бути терплячим.",shape=box,color=blue];
		j2749073819 -> j3542593548;
	j3085711181 [label="Якщо тобі стане від того легше, то я теж. Підозрюю, маля теж не пам’ятає.",shape=box,color=red];
		j3085711181 -> j3244206975;
	j884024958 [label="Дні народження переоцінені.",shape=box,color=red];
		j884024958 -> j4127037895;
	j3066992079 [label="Набагато веселіше вибрати свій власний день. Це дуже пойнятно. ",shape=box,color=red];
		j3066992079 -> j3996771497;
	j3542593548 [label="Check boolean MarieDating",color=orange];
		j3542593548 -> j4243069236 [label=true,color=green];
		j3542593548 -> j2958825963 [label=false,color=brown];
	j3244206975 [label="Ще більше причин оплакувати тебе й твою minuscule copie. Ще більше спільного у нас !",shape=box,color=blue];
		j3244206975 -> j3542593548;
	j4127037895 [label="Я не вірю, що вони переоцінені ! Ми повинні вшанувати тих, хто досі з нами. Як вшановуємо тих, кого нема.",shape=box,color=blue];
		j4127037895 -> j3542593548;
	j3996771497 [label="Пойнятно ? Я не знала, що ти балакаєш Gaullique ! Це від мене переймаєш?",shape=box,color=blue];
		j3996771497 -> j3259818710;
		j3996771497 -> j1245439912;
	j4243069236 [label="+20 Chemistry",color=orange];
		j4243069236 -> j1678811319;
	j2958825963 [label="+20 Chemistry",color=orange];
		j2958825963 -> j4030100431;
	j3259818710 [label="Воно наче зрозуміле в обох мовах?..",shape=box,color=red];
		j3259818710 -> j228527932;
	j1245439912 [label="Мабуть, таки від тебе переймаю.",shape=box,color=red];
		j1245439912 -> j2939347171;
	j1678811319 [label="Ну ж бо ! Давай, mon cœur ! Навіть якщо з цього нічого не вийде, то задум теж зараховується! Au calendrier !",shape=box,color=blue];
		j1678811319 -> "Chat ends.";
	j4030100431 [label="Ну ж бо ! Давай ! Навіть якщо з цього нічого не вийде, то задум теж зараховується! Au calendrier !",shape=box,color=blue];
		j4030100431 -> "Chat ends.";
	j228527932 [label="П-ф-ф ! Усі інші мови завжди беруть найліпше з нашої Gaullique й живуть із цим ! Часи не змінюються !",shape=box,color=blue];
		j228527932 -> j3542593548;
	j2939347171 [label="Оце так ! Gaullique — одна з найпрекрасніших та наймилозвучніших мов у світі. Я рада, що закинула її у futur.",shape=box,color=blue];
		j2939347171 -> j3542593548;
}