digraph {
	3091 [label="MarieRank5Convo5 begins.",color=orange];
		3091 -> 3092;
	3092 [label="Check boolean MarieDating",color=orange];
		3092 -> 3093 [label=true,color=green];
		3092 -> 3094 [label=false,color=brown];
	3093 [label="Bonjour, bonjour, mon cœur ! Маю розповісти тобі про найдурніше в житті.",shape=box,color=blue];
		3093 -> 3095;
		3093 -> 3096;
	3094 [label="Bonjour ! Маю розповісти тобі про найдурніше в житті.",shape=box,color=blue];
		3094 -> 3095;
		3094 -> 3096;
	3095 [label="О? А що сталося?",shape=box,color=red];
		3095 -> 3097;
	3096 [label="[Завершити розмову]",shape=box,color=red];
		3096 -> 3098;
	3097 [label="Я спитала мсьє Птаха Trois, коли в нього День народження. А він не знав ! Це ж невимовно сумно !",shape=box,color=blue];
		3097 -> 3099;
	3098 [label="Chat ends.",color=orange];
	3099 [label="Ніхто з кавій не знає, коли вони народилися. Що має сенс, насправді, оскільки вони народилися без здібності говорити чи розумітися на календарях.",shape=box,color=blue];
		3099 -> 3100;
	3100 [label="Тож я подумала — це tragédie ! Ми маємо негайно це виправити, non ?",shape=box,color=blue];
		3100 -> 3101;
		3100 -> 3102;
		3100 -> 3103;
	3101 [label="Ніколи таке в голову не приходило.",shape=box,color=red];
		3101 -> 3104;
	3102 [label="І як ти дізнаєшся, коли вони народилися?",shape=box,color=red];
		3102 -> 3105;
	3103 [label="Ти дозволиш їм самостійно вибрати свої дні?",shape=box,color=red];
		3103 -> 3106;
	3104 [label="Oui ! І монсеньйор Лойд теж. Його обличчя виражало абсолютний сум, коли я за це зауважила…",shape=box,color=blue];
		3104 -> 3107;
	3105 [label="Спершу я подумала про перевірку записів le Cardinnal. Може, він позначив, коли вони народилися, non ?",shape=box,color=blue];
		3105 -> 3108;
	3106 [label="«Дозволиш» ? Ти так говориш, наче це від мене залежить ! ",shape=box,color=blue];
		3106 -> 3105;
	3107 [label="Моє серце крається від того, що він вважає себе винним за те, що не додумався першим до цього. Це не його провина, він стільки всього робить для багатьох…",shape=box,color=blue];
		3107 -> 3109;
	3108 [label="Evaluate expressions",color=orange];
		3108 -> 3110 [label="MarieEntratiComplete",color=purple];
		3108 -> 3110 [label="MarieEntrati3a",color=purple];
		3108 -> 3111 [label="false",color=purple];
	3109 [label="Ми благословенні в тому, що пізнали доброту монсеньйора Лойда. Глибина колодязя, з якої він її черпає, не знає меж.",shape=box,color=blue];
		3109 -> 3112;
		3109 -> 3113;
	3110 [label="А потім я згадала… розмову з мсьє Таґфером. Та іншими. І подумала… це, мабуть, не дуже мудра думка.",shape=box,color=blue];
		3110 -> 3114;
	3111 [label="Вони наче не зацікавлені в пошуках записів про своє минуле. Я знаю, якими болючими бувають думки про своє походження.",shape=box,color=blue];
		3111 -> 3114;
	3112 [label="Нам дуже пощастило, що він тут.",shape=box,color=red];
		3112 -> 3115;
	3113 [label="Мені просто хотілося б, щоб він був час від часу трішки веселішим.",shape=box,color=red];
		3113 -> 3116;
	3114 [label="Зрештою, я теж не знаю дату власного народження. ",shape=box,color=blue];
		3114 -> 3117;
		3114 -> 3118;
		3114 -> 3119;
	3115 [label="Oui, це так. Пощастило нам усім.",shape=box,color=blue];
		3115 -> 3120;
	3116 [label="Він дуже серйозний, але я бачила усмішку на його обличчі. Його гумор там, де ніхто не запідозрить. Просто треба бути терплячим.",shape=box,color=blue];
		3116 -> 3120;
	3117 [label="Якщо тобі стане від того легше, то я теж. Підозрюю, маля теж не пам’ятає.",shape=box,color=red];
		3117 -> 3121;
	3118 [label="Дні народження переоцінені.",shape=box,color=red];
		3118 -> 3122;
	3119 [label="Набагато веселіше вибрати свій власний день. Це дуже пойнятно. ",shape=box,color=red];
		3119 -> 3123;
	3120 [label="Check boolean MarieDating",color=orange];
		3120 -> 3125 [label=true,color=green];
		3120 -> 3124 [label=false,color=brown];
	3121 [label="Ще більше причин оплакувати тебе й твою minuscule copie. Ще більше спільного у нас !",shape=box,color=blue];
		3121 -> 3120;
	3122 [label="Я не вірю, що вони переоцінені ! Ми повинні вшанувати тих, хто досі з нами. Як вшановуємо тих, кого нема.",shape=box,color=blue];
		3122 -> 3120;
	3123 [label="Пойнятно ? Я не знала, що ти балакаєш Gaullique ! Це від мене переймаєш?",shape=box,color=blue];
		3123 -> 3126;
		3123 -> 3127;
	3125 [label="+20 Chemistry",color=orange];
		3125 -> 3129;
	3124 [label="+20 Chemistry",color=orange];
		3124 -> 3128;
	3126 [label="Воно наче зрозуміле в обох мовах?..",shape=box,color=red];
		3126 -> 3130;
	3127 [label="Мабуть, таки від тебе переймаю.",shape=box,color=red];
		3127 -> 3131;
	3129 [label="Ну ж бо ! Давай, mon cœur ! Навіть якщо з цього нічого не вийде, то задум теж зараховується! Au calendrier !",shape=box,color=blue];
		3129 -> 3132;
	3128 [label="Ну ж бо ! Давай ! Навіть якщо з цього нічого не вийде, то задум теж зараховується! Au calendrier !",shape=box,color=blue];
		3128 -> 3132;
	3130 [label="П-ф-ф ! Усі інші мови завжди беруть найліпше з нашої Gaullique й живуть із цим ! Часи не змінюються !",shape=box,color=blue];
		3130 -> 3120;
	3131 [label="Оце так ! Gaullique — одна з найпрекрасніших та наймилозвучніших мов у світі. Я рада, що закинула її у futur.",shape=box,color=blue];
		3131 -> 3120;
	3132 [label="Chat ends.",color=orange];
}