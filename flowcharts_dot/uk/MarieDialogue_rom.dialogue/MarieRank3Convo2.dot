digraph {
	1015 [label="MarieRank3Convo2 begins.",color=orange];
		1015 -> 3736;
	3736 [label="Update boolean MarieLyonAvailable",color=orange];
		3736 -> 2923;
	2923 [label="Check boolean LoidFamilyComplete",color=orange];
		2923 -> 2924 [label=true,color=green];
		2923 -> 1016 [label=false,color=brown];
	2924 [label="Сподіваюся, що ти не вважатимеш мене дивною… але маю незрозуміле відчуття, що вже робила це раніше…",shape=box,color=blue];
		2924 -> 2925;
	1016 [label="Check boolean MarieFamily1",color=orange];
		1016 -> 1017 [label=true,color=green];
		1016 -> 1018 [label=false,color=brown];
	2925 [label="Мала ці розмови… зустрічалася з цими людьми… Але ж це неможливо, non ?",shape=box,color=blue];
		2925 -> 2926;
	1017 [label="Ти розповіси мені більше подробиць про родину le Cardinal ? Я нетерпляче прагну дізнатися про його минуле.",shape=box,color=blue];
		1017 -> 1020;
		1017 -> 1021;
		1017 -> 1019;
	1018 [label="Ти розповіси мені про родину le Cardinal ? Я нетерпляче прагну дізнатися про його минуле.",shape=box,color=blue];
		1018 -> 1020;
		1018 -> 1021;
		1018 -> 1019;
	2926 [label="+20 Chemistry",color=orange];
		2926 -> 2927;
	1020 [label="Я розповім усе, що знаю, але не думаю, що знаю так багато, як ти собі мудруєш.",shape=box,color=red];
		1020 -> 1023;
	1021 [label="Йой. Та звісно, але… чи не був би Лойд ліпшим кандидатом для таких розмов?",shape=box,color=red];
		1021 -> 1024;
	1019 [label="[Завершити розмову]",shape=box,color=red];
		1019 -> 1022;
	2927 [label="Ми подібне звемо déjà vu. Певно, вплив sérum та часових переміщень. C'est la vie !",shape=box,color=blue];
		2927 -> 2928;
	1023 [label="Я радо берегтиму все прочитане. Promis !",shape=box,color=blue];
		1023 -> 1025;
	1024 [label="Розмови про le Cardinal… дуже ранять монсеньйора Лойда. Я не хотіла б занадто в це заглиблюватися з ним.",shape=box,color=blue];
		1024 -> 1025;
	1022 [label="Chat ends.",color=orange];
	2928 [label="Chat ends.",color=orange];
	1025 [label="Особливо, коли це avec une certaine joie, з якою, здається, більше ніхто цього не робить.",shape=box,color=blue];
		1025 -> 1026;
		1025 -> 1027;
	1026 [label="Про що ти хочеш знати?",shape=box,color=red];
		1026 -> 1028;
	1027 [label="Ну, дивись. Нагорі є Мати, Батько, Син, Донька і Бабуся.",shape=box,color=red];
		1027 -> 1028;
	1028 [label="Пропоную дещо узгодити, добре ? Диявол увесь час регоче, коли я питаю. Наче це якийсь власний прихований жарт. Ця Grand-mère. Бабуся.",shape=box,color=blue];
		1028 -> 1029;
	1029 [label="Це ж не дружина le Cardinal, non ?",shape=box,color=blue];
		1029 -> 1030;
	1030 [label="Ні, це матір Батька. Свекруха Матері. Сваха Альбрехта.",shape=box,color=red];
		1030 -> 1031;
	1031 [label="Je… vois. А… чого вони не своїми іменами називаються ? Ne serait-ce pas plus simple ?",shape=box,color=blue];
		1031 -> 1032;
		1031 -> 1033;
	1032 [label="Готова читати довжелезні речення?",shape=box,color=red];
		1032 -> 1034;
	1033 [label="Я тобі коротко накидаю зараз.",shape=box,color=red];
		1033 -> 1035;
	1034 [label="Oui ! Мені все одно ще доволі довго нікуди поспішати.",shape=box,color=blue];
		1034 -> 1036;
	1035 [label="Родина нагорі потрапила в пастку, коли розвалилася орокінська імперія. Син (онук Ентраті) впустив зараження.",shape=box,color=red];
		1035 -> 1037;
	1036 [label="Ну, ми на місяці, який зветься Деймосом. Дуже давно тут спрацювала біологічна бомба, яка була відчайдушною спробою відбити напад свідомих.",shape=box,color=red];
		1036 -> 1038;
	1037 [label="Par Sol ! Зумисно ?",shape=box,color=blue];
		1037 -> 1039;
	1038 [label="Це тих, із ким орокіни дуже давно воювали ? Ті, кого ми бачили в Темному Спогадарії з дияволом, oui ?",shape=box,color=blue];
		1038 -> 1040;
	1039 [label="Check /Lotus/Scripts/1999/DialogueScriptNodes.lua:IsSyndicateRank",color=orange];
		1039 -> 1041 [label=true,color=green];
		1039 -> 1042 [label=true,color=green];
		1039 -> 1042 [label=false,color=brown];
		1039 -> 1043 [label=false,color=brown];
	1040 [label="Так. Вони намагалися застосувати зараження для битви зі свідомими. Але Деймос не вистояв. Вони замкнулися в Некраліску (те, що над нами), щоб захиститися й перечекати.",shape=box,color=red];
		1040 -> 1044;
	1041 [label="Ні, думаю, випадково. Наміри, гадаю, були добрими.",shape=box,color=red];
		1041 -> 1045;
	1042 [label="Я ще не знаю правди, але не засуджуватиму, допоки не знатиму більше.",shape=box,color=red];
		1042 -> 1045;
	1043 [label="Я ще не знаю правди, але він гоноровий і зарозумілий. Ось я як думаю.",shape=box,color=red];
		1043 -> 1046;
	1044 [label="Син, онук Ентраті, однак прагнув зберегти й дослідити заражених тварин.",shape=box,color=red];
		1044 -> 1047;
	1045 [label="+10 Chemistry",color=orange];
		1045 -> 1048;
	1046 [label="Яка ганьба. Сподіваюся, що це не підтвердиться. Задля його блага й нашого. Прошу, продовжуй.",shape=box,color=blue];
		1046 -> 1049;
	1047 [label="Ох, Соле… він мав добрі наміри ?",shape=box,color=blue];
		1047 -> 1076;
	1048 [label="Твої думки йдуть шляхом добра. Continuez, s'il vous plaît.",shape=box,color=blue];
		1048 -> 1049;
	1049 [label="Ну, вони застрягли в Некраліску й віддалися горю. Ніякої орокінської імперії, щоб їх урятувала, уже не було. А тепер ще й зараження просочувалося…",shape=box,color=red];
		1049 -> 1053;
	1076 [label="Check /Lotus/Scripts/1999/DialogueScriptNodes.lua:IsSyndicateRank",color=orange];
		1076 -> 1051 [label=true,color=green];
		1076 -> 1052 [label=true,color=green];
		1076 -> 1055 [label=true,color=green];
		1076 -> 1051 [label=false,color=brown];
		1076 -> 1052 [label=false,color=brown];
		1076 -> 1054 [label=false,color=brown];
	1053 [label="Вони накинулися одне на одного. Порвали одне одного на шмаття. Випатрали. Фігурально. А зараження лише все елегантно завершило. І забрало їхні імена. ",shape=box,color=red];
		1053 -> 1058;
	1051 [label="Так, думаю так. Гадаю, він щиро піклується про всіляких створінь.",shape=box,color=red];
		1051 -> 1056;
	1052 [label="На жаль, це вже не має значення. Непотрібної шкоди було завдано.",shape=box,color=red];
		1052 -> 1057;
	1055 [label="Ні, його надихав гонор та пиха. Навіть якщо він і стверджує, що це нещасний випадок.",shape=box,color=red];
		1055 -> 1059;
	1054 [label="Я ще не знаю правди, але він гоноровий і зарозумілий. Ось я як думаю.",shape=box,color=red];
		1054 -> 1059;
	1058 [label="Це якась абсолютна форма жорстокості… позбутися імені…",shape=box,color=blue];
		1058 -> 1062;
	1056 [label="+10 Chemistry",color=orange];
		1056 -> 1060;
	1057 [label="+5 Chemistry",color=orange];
		1057 -> 1061;
	1059 [label="Яка ганьба. Сподіваюся, що це не підтвердиться. Задля його блага й нашого. Прошу, продовжуй.",shape=box,color=blue];
		1059 -> 1049;
	1062 [label="Update boolean MarieFamily2",color=orange];
		1062 -> 1066;
		1062 -> 1067;
		1062 -> 1068;
	1060 [label="Цікаво, а що б він подумав про кавій… шкода, що не може зустрітися з ними…",shape=box,color=blue];
		1060 -> 1063;
		1060 -> 1064;
	1061 [label="Якби лише чистота чиїхось намірів мала значення, світ був би прекрасним місцем, non ? C'est la vie.",shape=box,color=blue];
		1061 -> 1065;
	1066 [label="Хіба що ти добровільно його віддаси. Як Бабуся.",shape=box,color=red];
		1066 -> 1071;
	1067 [label="Насправді це не так вже й погано. З часом звикаєш.",shape=box,color=red];
		1067 -> 1072;
	1068 [label="У тварин немає імен, але вони начебто ідеально щасливі. Ми даємо їм імена лише заради себе.",shape=box,color=red];
		1068 -> 1073;
	1063 [label="Це дуже кумедна ідея. Але не думаю, що мудра.",shape=box,color=red];
		1063 -> 1069;
	1064 [label="Сподіваюся, що це колись станеться. Справді.",shape=box,color=red];
		1064 -> 1070;
	1065 [label="Et ensuite ?",shape=box,color=blue];
		1065 -> 1049;
	1071 [label="+5 Chemistry",color=orange];
		1071 -> 1077;
	1072 [label="A-а-а ! Quelle horreur ! Я не хотіла ! Ох, яка ж мені ганьба ! Мені дуже шкода, ти пробач мені, я дійсно не хотіла… отже ж дурепа !",shape=box,color=blue];
		1072 -> 1078;
		1072 -> 1079;
	1073 [label="+5 Chemistry",color=orange];
		1073 -> 1080;
	1069 [label="І чому ?",shape=box,color=blue];
		1069 -> 1074;
		1069 -> 1075;
	1070 [label="Add 1 to Family",color=orange];
		1070 -> 1050;
	1077 [label="О, це схоже на мадам, з якою я б залюбки познайомилася… ",shape=box,color=blue];
		1077 -> 1085;
	1078 [label="І як ти мені це компенсуєш?",shape=box,color=red];
		1078 -> 1086;
	1079 [label="Усе гаразд, я лише дражнюся. Я не ображаюся й не засмучуюся.",shape=box,color=red];
		1079 -> 1087;
	1080 [label="Воістину правда ! Я ніколи так про це не думала. А ти можеш обрати своє власне. Це ж у певному сенсі дає свободу.",shape=box,color=blue];
		1080 -> 1085;
	1074 [label="Боюся, що одні вважатимуть других «іншою родиною».",shape=box,color=red];
		1074 -> 1081;
	1075 [label="Ситуація нагорі… доволі крихка і в найліпші дні. Не хочу засмучувати їх.",shape=box,color=red];
		1075 -> 1082;
	1050 [label="Check /Lotus/Scripts/1999/DialogueScriptNodes.lua:IsSyndicateRank",color=orange];
		1050 -> 1083 [label=true,color=green];
		1050 -> 1084 [label=false,color=brown];
	1085 [label="Це була прекрасна бесіда, та боюся, що моя черга накривати на стіл. Монсеньйор Лойд учить мене правильно подавати чай за його стилем !",shape=box,color=blue];
		1085 -> 1094;
	1086 [label="Maintenant, vous parlez aussi mal que le diable. Ні, я не піддамся твоїм хитрощам.",shape=box,color=blue];
		1086 -> 1095;
	1087 [label="+5 Chemistry",color=orange];
		1087 -> 1096;
	1081 [label="Add 1 to Family",color=orange];
		1081 -> 1088;
	1082 [label="Тебе б здивувала стійкість душ. А ті, що довкола мене зараз, дуже старі, дуже загартовані часом.",shape=box,color=blue];
		1082 -> 1089;
	1083 [label="Це можна зробити. І, можливо, буде легше, аніж ти думаєш. Нам лише варто подумати, як ліпше це втнути. ",shape=box,color=blue];
		1083 -> 1090;
		1083 -> 1091;
	1084 [label="Oui ? А як там у тебе й твоєї minuscule copie справи з famille нагорі ?",shape=box,color=blue];
		1084 -> 1092;
		1084 -> 1093;
	1094 [label="Chat ends.",color=orange];
	1095 [label="Chat ends.",color=orange];
	1096 [label="Oh, loué soit Sol ! Але це ставить ще одне питання… Ти знаєш, де й коли тобі дали прізвисько ? Le мандрівник ?",shape=box,color=blue];
		1096 -> 1099;
		1096 -> 1100;
	1088 [label="+5 Chemistry",color=orange];
		1088 -> 1097;
	1089 [label="+5 Chemistry",color=orange];
		1089 -> 1098;
	1090 [label="Нам треба бути дуже обачними. Боюся, що одні вважатимуть других «іншою родиною».",shape=box,color=red];
		1090 -> 1081;
	1091 [label="Ситуація нагорі… доволі крихка і в найліпші дні. Не хочу засмучувати їх.",shape=box,color=red];
		1091 -> 1082;
	1092 [label="Поволі. Обережно. Боюся, що одні вважатимуть других «іншою родиною».",shape=box,color=red];
		1092 -> 1081;
	1093 [label="Ситуація нагорі… доволі крихка і в найліпші дні. Не хочу засмучувати їх.",shape=box,color=red];
		1093 -> 1082;
	1099 [label="Сподіваюся, це був мій вибір.",shape=box,color=red];
		1099 -> 1103;
	1100 [label="По правді, я й не пам’ятаю.",shape=box,color=red];
		1100 -> 1104;
	1097 [label="Ох… Par Sol, я думаю, що тобі вдалося знайти рішення !",shape=box,color=blue];
		1097 -> 1101;
	1098 [label="Тобі багато разів удавалося здивувати їх. Дозволь же цього разу їм здивувати тебе.",shape=box,color=blue];
		1098 -> 1102;
	1103 [label="Це ж така свобода ! Вибрати собі ім’я. Ха ! У Cathédrale я навіть сама собі одяг не могла вибрати.",shape=box,color=blue];
		1103 -> 1085;
	1104 [label="У тобі стільки mystères ! ",shape=box,color=blue];
		1104 -> 1085;
	1101 [label="Update boolean MarieFamilyOther",color=orange];
		1101 -> 1105;
	1102 [label="Але прошу-прошу, s'il vous plaît, продовжуй. Твоя маленька вовчиця Марі повинна пізнати здобич, перш ніж вирушить на справжні лови, non ?",shape=box,color=blue];
		1102 -> 1106;
		1102 -> 1107;
		1102 -> 3914;
	1105 [label="Я від хвилювання сама не своя… je suis assise ici, remuant sur ma chaise !",shape=box,color=blue];
		1105 -> 1102;
	1106 [label="На чому ми зупинилися?",shape=box,color=red];
		1106 -> 1108;
	1107 [label="Трохи злий учинок з твого боку, чи не так?",shape=box,color=red];
		1107 -> 1109;
	3914 [label="Можливо, я дуже хочу, щоб ти полювала на мене…",shape=box,color=red];
		3914 -> 3915;
	1108 [label="Син підпустив Animaux Infestés занадто близько.",shape=box,color=blue];
		1108 -> 1049;
	1109 [label="Peut-être ! Але чи є шкода в невеликому злі заради добра, гм ?",shape=box,color=blue];
		1109 -> 1110;
		1109 -> 1111;
	3915 [label="Update boolean DrifterMarie",color=orange];
		3915 -> 3913;
	1110 [label="Ага… Менше з тим. Повернімося до нашої історії.",shape=box,color=red];
		1110 -> 1049;
	1111 [label="Не зрозумій мене неправильно, але мені сподобалося.",shape=box,color=red];
		1111 -> 1112;
	3913 [label="Ти мене без ножа ріжеш ! Я щойно голосно пискнула й монсеньйор Лойд перепитав, чи все добре. Довелося збрехати й сказати, що побачила мишу, на що він відповів: «У цьому часі не існує мишей» !",shape=box,color=blue];
		3913 -> 3916;
	1112 [label="Ха ! Я так і знала. Та наразі досить дурощів. Повертайся до історії. Син підпустив Animaux Infestés занадто близько, oui ?",shape=box,color=blue];
		1112 -> 1049;
	3916 [label="+5 Chemistry",color=orange];
		3916 -> 3917;
	3917 [label="Quelle méchanceté, tu es terrible ! Je te déteste et tu me fais rougir maintenant !",shape=box,color=blue];
		3917 -> 3918;
		3917 -> 3919;
	3918 [label="Ти на мене сердишся?",shape=box,color=red];
		3918 -> 3920;
	3919 [label="Ага… Менше з тим. Повернімося до нашої історії.",shape=box,color=red];
		3919 -> 1049;
	3920 [label="Non ! Просто продовжуй свою історію !",shape=box,color=blue];
		3920 -> 1049;
}