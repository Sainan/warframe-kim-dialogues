digraph {
	"MarieRank3Convo2 begins." [color=orange];
		"MarieRank3Convo2 begins." -> j3102612293;
	j3102612293 [label="Boolean MarieLyonAvailable is now true.",color=orange];
		j3102612293 -> j369807617;
	j369807617 [label="Check boolean LoidFamilyComplete",color=orange];
		j369807617 -> j1481318356 [label=true,color=green];
		j369807617 -> j1668831657 [label=false,color=brown];
	j1481318356 [label="Сподіваюся, що ти не вважатимеш мене дивною… але маю незрозуміле відчуття, що вже робила це раніше…",shape=box,color=blue];
		j1481318356 -> j494508131;
	j1668831657 [label="Check boolean MarieFamily1",color=orange];
		j1668831657 -> j4119445408 [label=true,color=green];
		j1668831657 -> j632866121 [label=false,color=brown];
	j494508131 [label="Мала ці розмови… зустрічалася з цими людьми… Але ж це неможливо, non ?",shape=box,color=blue];
		j494508131 -> j1673862885;
	j4119445408 [label="Ти розповіси мені більше подробиць про родину le Cardinal ? Я нетерпляче прагну дізнатися про його минуле.",shape=box,color=blue];
		j4119445408 -> j4124384261;
		j4119445408 -> j272683379;
		j4119445408 -> j1478915251;
	j632866121 [label="Ти розповіси мені про родину le Cardinal ? Я нетерпляче прагну дізнатися про його минуле.",shape=box,color=blue];
		j632866121 -> j4124384261;
		j632866121 -> j272683379;
		j632866121 -> j1478915251;
	j1673862885 [label="+20 Chemistry",color=orange];
		j1673862885 -> j4181427788;
	j4124384261 [label="Я розповім усе, що знаю, але не думаю, що знаю так багато, як ти собі мудруєш.",shape=box,color=red];
		j4124384261 -> j193003027;
	j272683379 [label="Йой. Та звісно, але… чи не був би Лойд ліпшим кандидатом для таких розмов?",shape=box,color=red];
		j272683379 -> j3613896986;
	j1478915251 [label="[Завершити розмову]",shape=box,color=red];
		j1478915251 -> "Chat ends.";
	j4181427788 [label="Ми подібне звемо déjà vu. Певно, вплив sérum та часових переміщень. C'est la vie !",shape=box,color=blue];
		j4181427788 -> "Chat ends.";
	j193003027 [label="Я радо берегтиму все прочитане. Promis !",shape=box,color=blue];
		j193003027 -> j2364321392;
	j3613896986 [label="Розмови про le Cardinal… дуже ранять монсеньйора Лойда. Я не хотіла б занадто в це заглиблюватися з ним.",shape=box,color=blue];
		j3613896986 -> j2364321392;
	"Chat ends." [color=orange];
	j2364321392 [label="Особливо, коли це avec une certaine joie, з якою, здається, більше ніхто цього не робить.",shape=box,color=blue];
		j2364321392 -> j1189975818;
		j2364321392 -> j608467261;
	j1189975818 [label="Про що ти хочеш знати?",shape=box,color=red];
		j1189975818 -> j4161854862;
	j608467261 [label="Ну, дивись. Нагорі є Мати, Батько, Син, Донька і Бабуся.",shape=box,color=red];
		j608467261 -> j4161854862;
	j4161854862 [label="Пропоную дещо узгодити, добре ? Диявол увесь час регоче, коли я питаю. Наче це якийсь власний прихований жарт. Ця Grand-mère. Бабуся.",shape=box,color=blue];
		j4161854862 -> j3493449234;
	j3493449234 [label="Це ж не дружина le Cardinal, non ?",shape=box,color=blue];
		j3493449234 -> j3487763799;
	j3487763799 [label="Ні, це матір Батька. Свекруха Матері. Сваха Альбрехта.",shape=box,color=red];
		j3487763799 -> j1883030392;
	j1883030392 [label="Je… vois. А… чого вони не своїми іменами називаються ? Ne serait-ce pas plus simple ?",shape=box,color=blue];
		j1883030392 -> j1866676152;
		j1883030392 -> j3275189938;
	j1866676152 [label="Готова читати довжелезні речення?",shape=box,color=red];
		j1866676152 -> j2051028037;
	j3275189938 [label="Я тобі коротко накидаю зараз.",shape=box,color=red];
		j3275189938 -> j749053973;
	j2051028037 [label="Oui ! Мені все одно ще доволі довго нікуди поспішати.",shape=box,color=blue];
		j2051028037 -> j1764699584;
	j749053973 [label="Родина нагорі потрапила в пастку, коли розвалилася орокінська імперія. Син (онук Ентраті) впустив зараження.",shape=box,color=red];
		j749053973 -> j3391751950;
	j1764699584 [label="Ну, ми на місяці, який зветься Деймосом. Дуже давно тут спрацювала біологічна бомба, яка була відчайдушною спробою відбити напад свідомих.",shape=box,color=red];
		j1764699584 -> j2003542119;
	j3391751950 [label="Par Sol ! Зумисно ?",shape=box,color=blue];
		j3391751950 -> j385755729;
	j2003542119 [label="Це тих, із ким орокіни дуже давно воювали ? Ті, кого ми бачили в Темному Спогадарії з дияволом, oui ?",shape=box,color=blue];
		j2003542119 -> j34359934;
	j385755729 [label="Check /Lotus/Scripts/1999/DialogueScriptNodes.lua:IsSyndicateRank",color=orange];
		j385755729 -> j2752944515 [label=true,color=green];
		j385755729 -> j56599852 [label=true,color=green];
		j385755729 -> j56599852 [label=false,color=brown];
		j385755729 -> j4294718520 [label=false,color=brown];
	j34359934 [label="Так. Вони намагалися застосувати зараження для битви зі свідомими. Але Деймос не вистояв. Вони замкнулися в Некраліску (те, що над нами), щоб захиститися й перечекати.",shape=box,color=red];
		j34359934 -> j2666381213;
	j2752944515 [label="Ні, думаю, випадково. Наміри, гадаю, були добрими.",shape=box,color=red];
		j2752944515 -> j440817768;
	j56599852 [label="Я ще не знаю правди, але не засуджуватиму, допоки не знатиму більше.",shape=box,color=red];
		j56599852 -> j440817768;
	j4294718520 [label="Я ще не знаю правди, але він гоноровий і зарозумілий. Ось я як думаю.",shape=box,color=red];
		j4294718520 -> j1323486235;
	j2666381213 [label="Син, онук Ентраті, однак прагнув зберегти й дослідити заражених тварин.",shape=box,color=red];
		j2666381213 -> j2530472662;
	j440817768 [label="+10 Chemistry",color=orange];
		j440817768 -> j746879753;
	j1323486235 [label="Яка ганьба. Сподіваюся, що це не підтвердиться. Задля його блага й нашого. Прошу, продовжуй.",shape=box,color=blue];
		j1323486235 -> j56700990;
	j2530472662 [label="Ох, Соле… він мав добрі наміри ?",shape=box,color=blue];
		j2530472662 -> j240603373;
	j746879753 [label="Твої думки йдуть шляхом добра. Continuez, s'il vous plaît.",shape=box,color=blue];
		j746879753 -> j56700990;
	j56700990 [label="Ну, вони застрягли в Некраліску й віддалися горю. Ніякої орокінської імперії, щоб їх урятувала, уже не було. А тепер ще й зараження просочувалося…",shape=box,color=red];
		j56700990 -> j80747761;
	j240603373 [label="Check /Lotus/Scripts/1999/DialogueScriptNodes.lua:IsSyndicateRank",color=orange];
		j240603373 -> j2501520047 [label=true,color=green];
		j240603373 -> j1186992354 [label=true,color=green];
		j240603373 -> j2491162870 [label=true,color=green];
		j240603373 -> j2501520047 [label=false,color=brown];
		j240603373 -> j1186992354 [label=false,color=brown];
		j240603373 -> j4140375590 [label=false,color=brown];
	j80747761 [label="Вони накинулися одне на одного. Порвали одне одного на шмаття. Випатрали. Фігурально. А зараження лише все елегантно завершило. І забрало їхні імена. ",shape=box,color=red];
		j80747761 -> j3424612378;
	j2501520047 [label="Так, думаю так. Гадаю, він щиро піклується про всіляких створінь.",shape=box,color=red];
		j2501520047 -> j2254684900;
	j1186992354 [label="На жаль, це вже не має значення. Непотрібної шкоди було завдано.",shape=box,color=red];
		j1186992354 -> j185377310;
	j2491162870 [label="Ні, його надихав гонор та пиха. Навіть якщо він і стверджує, що це нещасний випадок.",shape=box,color=red];
		j2491162870 -> j1323486235;
	j4140375590 [label="Я ще не знаю правди, але він гоноровий і зарозумілий. Ось я як думаю.",shape=box,color=red];
		j4140375590 -> j1323486235;
	j3424612378 [label="Це якась абсолютна форма жорстокості… позбутися імені…",shape=box,color=blue];
		j3424612378 -> j482800561;
	j2254684900 [label="+10 Chemistry",color=orange];
		j2254684900 -> j885739389;
	j185377310 [label="+5 Chemistry",color=orange];
		j185377310 -> j3443975304;
	j482800561 [label="Boolean MarieFamily2 is now true.",color=orange];
		j482800561 -> j4210211386;
		j482800561 -> j4028815902;
		j482800561 -> j2217038725;
	j885739389 [label="Цікаво, а що б він подумав про кавій… шкода, що не може зустрітися з ними…",shape=box,color=blue];
		j885739389 -> j1796258528;
		j885739389 -> j2992698828;
	j3443975304 [label="Якби лише чистота чиїхось намірів мала значення, світ був би прекрасним місцем, non ? C'est la vie.",shape=box,color=blue];
		j3443975304 -> j248777833;
	j4210211386 [label="Хіба що ти добровільно його віддаси. Як Бабуся.",shape=box,color=red];
		j4210211386 -> j1900267270;
	j4028815902 [label="Насправді це не так вже й погано. З часом звикаєш.",shape=box,color=red];
		j4028815902 -> j1624924382;
	j2217038725 [label="У тварин немає імен, але вони начебто ідеально щасливі. Ми даємо їм імена лише заради себе.",shape=box,color=red];
		j2217038725 -> j3995404124;
	j1796258528 [label="Це дуже кумедна ідея. Але не думаю, що мудра.",shape=box,color=red];
		j1796258528 -> j181236019;
	j2992698828 [label="Сподіваюся, що це колись станеться. Справді.",shape=box,color=red];
		j2992698828 -> j1526667533;
	j248777833 [label="Et ensuite ?",shape=box,color=blue];
		j248777833 -> j56700990;
	j1900267270 [label="+5 Chemistry",color=orange];
		j1900267270 -> j945073386;
	j1624924382 [label="A-а-а ! Quelle horreur ! Я не хотіла ! Ох, яка ж мені ганьба ! Мені дуже шкода, ти пробач мені, я дійсно не хотіла… отже ж дурепа !",shape=box,color=blue];
		j1624924382 -> j1980844159;
		j1624924382 -> j2761974629;
	j3995404124 [label="+5 Chemistry",color=orange];
		j3995404124 -> j3552905308;
	j181236019 [label="І чому ?",shape=box,color=blue];
		j181236019 -> j2308708685;
		j181236019 -> j4197084571;
	j1526667533 [label="Add 1 to Family counter",color=orange];
		j1526667533 -> j788680427;
	j945073386 [label="О, це схоже на мадам, з якою я б залюбки познайомилася… ",shape=box,color=blue];
		j945073386 -> j3340708840;
	j1980844159 [label="І як ти мені це компенсуєш?",shape=box,color=red];
		j1980844159 -> j4048763735;
	j2761974629 [label="Усе гаразд, я лише дражнюся. Я не ображаюся й не засмучуюся.",shape=box,color=red];
		j2761974629 -> j1378062170;
	j3552905308 [label="Воістину правда ! Я ніколи так про це не думала. А ти можеш обрати своє власне. Це ж у певному сенсі дає свободу.",shape=box,color=blue];
		j3552905308 -> j3340708840;
	j2308708685 [label="Боюся, що одні вважатимуть других «іншою родиною».",shape=box,color=red];
		j2308708685 -> j429586793;
	j4197084571 [label="Ситуація нагорі… доволі крихка і в найліпші дні. Не хочу засмучувати їх.",shape=box,color=red];
		j4197084571 -> j377665511;
	j788680427 [label="Check /Lotus/Scripts/1999/DialogueScriptNodes.lua:IsSyndicateRank",color=orange];
		j788680427 -> j2135360994 [label=true,color=green];
		j788680427 -> j1729495617 [label=false,color=brown];
	j3340708840 [label="Це була прекрасна бесіда, та боюся, що моя черга накривати на стіл. Монсеньйор Лойд учить мене правильно подавати чай за його стилем !",shape=box,color=blue];
		j3340708840 -> "Chat ends.";
	j4048763735 [label="Maintenant, vous parlez aussi mal que le diable. Ні, я не піддамся твоїм хитрощам.",shape=box,color=blue];
		j4048763735 -> "Chat ends.";
	j1378062170 [label="+5 Chemistry",color=orange];
		j1378062170 -> j256324781;
	j429586793 [label="Add 1 to Family counter",color=orange];
		j429586793 -> j2907772142;
	j377665511 [label="Тебе б здивувала стійкість душ. А ті, що довкола мене зараз, дуже старі, дуже загартовані часом.",shape=box,color=blue];
		j377665511 -> j1487423990;
	j2135360994 [label="Це можна зробити. І, можливо, буде легше, аніж ти думаєш. Нам лише варто подумати, як ліпше це втнути. ",shape=box,color=blue];
		j2135360994 -> j1493207669;
		j2135360994 -> j4197084571;
	j1729495617 [label="Oui ? А як там у тебе й твоєї minuscule copie справи з famille нагорі ?",shape=box,color=blue];
		j1729495617 -> j801071771;
		j1729495617 -> j4197084571;
	j256324781 [label="Oh, loué soit Sol ! Але це ставить ще одне питання… Ти знаєш, де й коли тобі дали прізвисько ? Le мандрівник ?",shape=box,color=blue];
		j256324781 -> j4069582172;
		j256324781 -> j2533375449;
	j2907772142 [label="+5 Chemistry",color=orange];
		j2907772142 -> j2109488168;
	j1487423990 [label="+5 Chemistry",color=orange];
		j1487423990 -> j316788107;
	j1493207669 [label="Нам треба бути дуже обачними. Боюся, що одні вважатимуть других «іншою родиною».",shape=box,color=red];
		j1493207669 -> j429586793;
	j801071771 [label="Поволі. Обережно. Боюся, що одні вважатимуть других «іншою родиною».",shape=box,color=red];
		j801071771 -> j429586793;
	j4069582172 [label="Сподіваюся, це був мій вибір.",shape=box,color=red];
		j4069582172 -> j3137647498;
	j2533375449 [label="По правді, я й не пам’ятаю.",shape=box,color=red];
		j2533375449 -> j2212322328;
	j2109488168 [label="Ох… Par Sol, я думаю, що тобі вдалося знайти рішення !",shape=box,color=blue];
		j2109488168 -> j465161835;
	j316788107 [label="Тобі багато разів удавалося здивувати їх. Дозволь же цього разу їм здивувати тебе.",shape=box,color=blue];
		j316788107 -> j2436757028;
	j3137647498 [label="Це ж така свобода ! Вибрати собі ім’я. Ха ! У Cathédrale я навіть сама собі одяг не могла вибрати.",shape=box,color=blue];
		j3137647498 -> j3340708840;
	j2212322328 [label="У тобі стільки mystères ! ",shape=box,color=blue];
		j2212322328 -> j3340708840;
	j465161835 [label="Boolean MarieFamilyOther is now true.",color=orange];
		j465161835 -> j3643394857;
	j2436757028 [label="Але прошу-прошу, s'il vous plaît, продовжуй. Твоя маленька вовчиця Марі повинна пізнати здобич, перш ніж вирушить на справжні лови, non ?",shape=box,color=blue];
		j2436757028 -> j2941361491;
		j2436757028 -> j754115070;
		j2436757028 -> j714823536;
	j3643394857 [label="Я від хвилювання сама не своя… je suis assise ici, remuant sur ma chaise !",shape=box,color=blue];
		j3643394857 -> j2436757028;
	j2941361491 [label="На чому ми зупинилися?",shape=box,color=red];
		j2941361491 -> j3733251833;
	j754115070 [label="Трохи злий учинок з твого боку, чи не так?",shape=box,color=red];
		j754115070 -> j3347095315;
	j714823536 [label="Можливо, я дуже хочу, щоб ти полювала на мене…",shape=box,color=red];
		j714823536 -> j3972202812;
	j3733251833 [label="Син підпустив Animaux Infestés занадто близько.",shape=box,color=blue];
		j3733251833 -> j56700990;
	j3347095315 [label="Peut-être ! Але чи є шкода в невеликому злі заради добра, гм ?",shape=box,color=blue];
		j3347095315 -> j845698574;
		j3347095315 -> j803481805;
	j3972202812 [label="Boolean DrifterMarie is now true.",color=orange];
		j3972202812 -> j2947462408;
	j845698574 [label="Ага… Менше з тим. Повернімося до нашої історії.",shape=box,color=red];
		j845698574 -> j56700990;
	j803481805 [label="Не зрозумій мене неправильно, але мені сподобалося.",shape=box,color=red];
		j803481805 -> j4233449357;
	j2947462408 [label="Ти мене без ножа ріжеш ! Я щойно голосно пискнула й монсеньйор Лойд перепитав, чи все добре. Довелося збрехати й сказати, що побачила мишу, на що він відповів: «У цьому часі не існує мишей» !",shape=box,color=blue];
		j2947462408 -> j2616478708;
	j4233449357 [label="Ха ! Я так і знала. Та наразі досить дурощів. Повертайся до історії. Син підпустив Animaux Infestés занадто близько, oui ?",shape=box,color=blue];
		j4233449357 -> j56700990;
	j2616478708 [label="+5 Chemistry",color=orange];
		j2616478708 -> j2189726668;
	j2189726668 [label="Quelle méchanceté, tu es terrible ! Je te déteste et tu me fais rougir maintenant !",shape=box,color=blue];
		j2189726668 -> j2970559118;
		j2189726668 -> j845698574;
	j2970559118 [label="Ти на мене сердишся?",shape=box,color=red];
		j2970559118 -> j3339689017;
	j3339689017 [label="Non ! Просто продовжуй свою історію !",shape=box,color=blue];
		j3339689017 -> j56700990;
}