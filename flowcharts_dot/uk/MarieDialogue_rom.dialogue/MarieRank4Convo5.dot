digraph {
	"MarieRank4Convo5 begins." [color=orange];
		"MarieRank4Convo5 begins." -> j1316635360;
	j1316635360 [label="Evaluate expressions",color=orange];
		j1316635360 -> j2010073470 [label="LoidFamilyComplete",color=purple];
		j1316635360 -> j3910332140 [label="MarieFamilyOther",color=purple];
		j1316635360 -> j3658884342 [label="MarieFamily2",color=purple];
		j1316635360 -> j3658884342 [label="MarieFamily1",color=purple];
		j1316635360 -> j369164739 [label="false",color=purple];
	j2010073470 [label="Мандрівниче ! Я тут накидала план.",shape=box,color=blue];
		j2010073470 -> j2847581634;
		j2010073470 -> j1478915251;
	j3910332140 [label="Мандрівниче ! Я тут розмірковувала про твої слова за родину над нами. І що вони можуть вважати нас чужинцями й загрозою.",shape=box,color=blue];
		j3910332140 -> j1758249830;
	j3658884342 [label="Мандрівниче ! Я тут розмірковувала про твої слова за родину над нами. Моє серце болить за них…",shape=box,color=blue];
		j3658884342 -> j1000557311;
	j369164739 [label="Чого ми не можемо підійнятися нагору ? Чому нам не можна балакати з тими, хто вважав le Cardinal членом родини ?",shape=box,color=blue];
		j369164739 -> j2612973;
		j369164739 -> j1478915251;
	j2847581634 [label="Мені має бути лячно?",shape=box,color=red];
		j2847581634 -> j3238182448;
	j1478915251 [label="[Завершити розмову]",shape=box,color=red];
		j1478915251 -> "Chat ends.";
	j1758249830 [label="«Іншою родиною» compétition, oui ? Це мене дуже бентежить.",shape=box,color=blue];
		j1758249830 -> j1000557311;
	j1000557311 [label="Check /Lotus/Scripts/1999/DialogueScriptNodes.lua:IsSyndicateRank(syndicate=EntratiSyndicate, syndicateRank=5)",color=orange];
		j1000557311 -> j354985132 [label=true,color=green];
		j1000557311 -> j3642914 [label=false,color=brown];
	j2612973 [label="Ну… якщо коротко, то нагорі частина родини Ентраті. І вони не дуже… вірніше зовсім не знають, що ми тут унизу.",shape=box,color=red];
		j2612973 -> j2623232501;
	j3238182448 [label="Oui ! Маленькі летючі роботи. Некра… Некра… Яка їхня назва, нагадай ?",shape=box,color=blue];
		j3238182448 -> j181495948;
	"Chat ends." [color=orange];
	j354985132 [label="Ми не змагаємося за любов le Cardinal. Як же їм показати це?",shape=box,color=blue];
		j354985132 -> j2438935918;
		j354985132 -> j671659082;
		j354985132 -> j1024056399;
	j3642914 [label="Check boolean MarieSyndicateMaxRank",color=orange];
		j3642914 -> j354985132 [label=true,color=green];
		j3642914 -> j456424643 [label=false,color=brown];
	j2623232501 [label="Boolean MarieFamily1 is now true.",color=orange];
		j2623232501 -> j667015274;
	j181495948 [label="Некраміти?",shape=box,color=red];
		j181495948 -> j639163643;
	j2438935918 [label="Знаєш, твоя правда. Не можна змагатися за щось, чого людина не може дати.",shape=box,color=red];
		j2438935918 -> j380005824;
	j671659082 [label="Відкривати ранки, вкриті кірочкою, дуже небезпечно. Можна позбутися інфекції… або можна стекти кров’ю.",shape=box,color=red];
		j671659082 -> j2952898253;
	j1024056399 [label="Ти… ми… усі мають дещо спільне. У певну мить Ентраті покинув нас.",shape=box,color=red];
		j1024056399 -> j2515192195;
	j456424643 [label="Як проходить твоя робота зі зцілення їхніх міжособистісних протирічь ?",shape=box,color=blue];
		j456424643 -> j1540530790;
		j456424643 -> j4124022583;
		j456424643 -> j3103396534;
		j456424643 -> j1478915251;
	j667015274 [label="Par les Luminaires… Тобто ти маєш на увазі, що ми тут усі сидимо потайки ?! Саме тому не можна покидати це місце ?! Mais pourquoi ?!",shape=box,color=blue];
		j667015274 -> j3973964830;
	j639163643 [label="Oui ! Ха ! Вони дуже заповзято замінюють меблі, non ? Але я помітила, що в разі пересування чогось… вони все одно заміняють їх.",shape=box,color=blue];
		j639163643 -> j388986655;
	j380005824 [label="Evaluate expressions",color=orange];
		j380005824 -> j2531334326 [label="MarieEntrati3a",color=purple];
		j380005824 -> j2531334326 [label="MarieEntrati3b",color=purple];
		j380005824 -> j2531334326 [label="MarieEntrati3",color=purple];
		j380005824 -> j2790968483 [label="MarieEntratiFamily",color=purple];
		j380005824 -> j956373354 [label="MarieEntratiMonster1",color=purple];
		j380005824 -> j956373354 [label="MarieEntratiMonster2",color=purple];
		j380005824 -> j1769295639 [label="MarieEntratiFan1",color=purple];
		j380005824 -> j1769295639 [label="MarieEntratiFan2",color=purple];
		j380005824 -> j1062574467 [label="MarieEntratiNeutral",color=purple];
		j380005824 -> j2790968483 [label="false",color=purple];
	j2952898253 [label="Evaluate expressions",color=orange];
		j2952898253 -> j747653557 [label="MarieEntrati3a",color=purple];
		j2952898253 -> j747653557 [label="MarieEntrati3b",color=purple];
		j2952898253 -> j1541316715 [label="MarieEntrati3",color=purple];
		j2952898253 -> j736963557 [label="MarieEntratiFamily",color=purple];
		j2952898253 -> j2056019416 [label="MarieEntratiMonster1",color=purple];
		j2952898253 -> j2056019416 [label="MarieEntratiMonster2",color=purple];
		j2952898253 -> j315100087 [label="MarieEntratiFan1",color=purple];
		j2952898253 -> j315100087 [label="MarieEntratiFan2",color=purple];
		j2952898253 -> j1708207383 [label="MarieEntratiNeutral",color=purple];
		j2952898253 -> j2215453890 [label="false",color=purple];
	j2515192195 [label="Evaluate expressions",color=orange];
		j2515192195 -> j1728131557 [label="MarieEntrati3a",color=purple];
		j2515192195 -> j1728131557 [label="MarieEntrati3b",color=purple];
		j2515192195 -> j2924505682 [label="MarieEntrati3",color=purple];
		j2515192195 -> j124103904 [label="MarieEntratiFamily",color=purple];
		j2515192195 -> j3181250567 [label="MarieEntratiMonster1",color=purple];
		j2515192195 -> j3181250567 [label="MarieEntratiMonster2",color=purple];
		j2515192195 -> j315100087 [label="MarieEntratiFan1",color=purple];
		j2515192195 -> j315100087 [label="MarieEntratiFan2",color=purple];
		j2515192195 -> j1708207383 [label="MarieEntratiNeutral",color=purple];
		j2515192195 -> j3493958392 [label="false",color=purple];
	j1540530790 [label="Чесно? Займаюся дечим іншим.",shape=box,color=red];
		j1540530790 -> j294619072;
	j4124022583 [label="Могло би бути й ліпше.",shape=box,color=red];
		j4124022583 -> j3111777263;
	j3103396534 [label="Потроху йде.",shape=box,color=red];
		j3103396534 -> j1834181172;
	j3973964830 [label="Його донька Евлерія (також відома як Матір) і її родина весь цей час піклувалися про Деймос.",shape=box,color=red];
		j3973964830 -> j1455435089;
	j388986655 [label="Що зупиняє нас від того, щоби просто пересунути меблі й дозволити їм усе замінити, а потім… повторити ? Ми б могли все продати ! Збагатіти на de ce mobilier étrange !",shape=box,color=blue];
		j388986655 -> j1557612564;
		j388986655 -> j3498444556;
		j388986655 -> j3429535266;
	j2531334326 [label="Я дуже добре усвідомлюю наші непримирені розбіжності стосовно le Cardinal. І намагаюся вести бесіду в цивілізованих рамках.",shape=box,color=blue];
		j2531334326 -> j2944995625;
	j2790968483 [label="Я розумію чому ти можеш не хотіти обговорювати залагодження розбіжностей, не маючи можливості вказати на тих, кого вважаєш винними.",shape=box,color=blue];
		j2790968483 -> j2944995625;
	j956373354 [label="Oui ! Як ти частенько мені нагадуєш, усі ви вважате його un monstre ! Зі злобою і пустотою в серці й більш нічим !",shape=box,color=blue];
		j956373354 -> j2944995625;
	j1769295639 [label="Хіба ти не на моїй стороні в цій війні за душу le Cardinal ?",shape=box,color=blue];
		j1769295639 -> j2135469409;
	j1062574467 [label="А хіба в тебе не було невизначеності стосовно le Cardinal ? Чи це вже змінилося ?",shape=box,color=blue];
		j1062574467 -> j3803279846;
		j1062574467 -> j2159537271;
	j747653557 [label="Oui. Я дізналася про це з мсьє Таґфером…",shape=box,color=blue];
		j747653557 -> j873629994;
	j1541316715 [label="Не говори зі мною про роз’ятрені рани, вовченя. Я досі зализую свої від останньої дискусії з le Cardinal.",shape=box,color=blue];
		j1541316715 -> j2944995625;
	j736963557 [label="Oui, але ж це твої слова були, що ми повинні перестати звинувачувати одне одного за рани, від яких страждаємо.",shape=box,color=blue];
		j736963557 -> j1856793565;
	j2056019416 [label="Я знаю, що ти вважаєш le Cardinal жахливим чудовиськом за завдання таких ран.",shape=box,color=blue];
		j2056019416 -> j2944995625;
	j315100087 [label="Я знаю, що ти на моїй стороні в цій війні за душу le Cardinal. І вічно буду вдячною за це.",shape=box,color=blue];
		j315100087 -> j2215453890;
	j1708207383 [label="Я знаю, що ти утримуєшся від суджень про нього. І за це я неймовірно вдячна.",shape=box,color=blue];
		j1708207383 -> j2215453890;
	j2215453890 [label="І я знаю, що інші швидко звинувачують його. Та не хочу, щоб ми були розділені й стікали кров’ю, коли могли би бути одним цілим.",shape=box,color=blue];
		j2215453890 -> j2924495892;
	j1728131557 [label="Oui, я вже починаю розуміти (як он з мсьє Таґфером), що може не все однаково.",shape=box,color=blue];
		j1728131557 -> j873629994;
	j2924505682 [label="І я дізнаюся, що воно не все однакове. Бо ти ж так «по доброму» мені на це вказуєш мені, non ?",shape=box,color=blue];
		j2924505682 -> j2944995625;
	j124103904 [label="Oui, так ! Хоч я й не звинувачую le Cardinal, що він покинув мене задля своєї sacro-saint місії…",shape=box,color=blue];
		j124103904 -> j2215453890;
	j3181250567 [label="І я знаю, що ти вважаєш le Cardinal жахливим чудовиськом за завдання таких ран.",shape=box,color=blue];
		j3181250567 -> j2944995625;
	j3493958392 [label="Інші швидко звинувачують його за свій біль. Але я просто не хочу бачити нас розділеними й у стражданнях.",shape=box,color=blue];
		j3493958392 -> j2924495892;
	j294619072 [label="Чим це таким іншим ти займаєшся ? Що може бути важливішим, аніж узяти й розібратися зі complaints of mécontents ?",shape=box,color=blue];
		j294619072 -> j2423554558;
	j3111777263 [label="Та що такого складного може бути в тому, щоб узяти й розібратися зі complaints of mécontents ?",shape=box,color=blue];
		j3111777263 -> j1951046007;
	j1834181172 [label="Ой, magnifique !",shape=box,color=blue];
		j1834181172 -> j1071337271;
	j1455435089 [label="Наглядали за цим місцем і за серцем, яке перекачує енергію Порожнечі в Материнську систему, що дозволяє нам усім… бути корисними, насправді. І це все аж з моменту зникнення Ентраті.",shape=box,color=red];
		j1455435089 -> j3916832970;
	j1557612564 [label="Щось мені не траплялися ринки з попитом на крісла Ентраті…",shape=box,color=red];
		j1557612564 -> j839671595;
	j3498444556 [label="Хіба зрештою ми не переповнимо ринок пропозицією? Тоді доведеться віддавати їх задешево…",shape=box,color=red];
		j3498444556 -> j839671595;
	j3429535266 [label="Геніально. Абсолютно не бачу перешкод.",shape=box,color=red];
		j3429535266 -> j3302389049;
	j2944995625 [label="І попри те, що усвідомлюю про нерозривні зв’язки цих двох тем, усе одно проситиму внести трішки ефективних рішень у цей день, oui ?",shape=box,color=blue];
		j2944995625 -> j825962539;
	j2135469409 [label="Вовченя, що це за обманну шкуру ти на себе тягнеш ? Невже маленька Марі лише un jeu для тебе ?",shape=box,color=blue];
		j2135469409 -> j1532873519;
		j2135469409 -> j2159537271;
	j3803279846 [label="Ще нічого не вирішено стосовно потрібності його дій. Але ця його жорстока натура не викликає ніяких сумнівів.",shape=box,color=red];
		j3803279846 -> j2944995625;
	j2159537271 [label="Мені набридло прикидатися. Вибач.",shape=box,color=red];
		j2159537271 -> j1113412781;
	j873629994 [label="Ми повинні перестати звинувачувати одне одного за рани, від яких страждаємо.",shape=box,color=blue];
		j873629994 -> j1856793565;
	j1856793565 [label="Зауважу, я також не погоджуюся з безумовним звинуваченням le Cardinal, та не хочу бути розділеними й стікати кров’ю, коли ми могли би бути одним цілим.",shape=box,color=blue];
		j1856793565 -> j290390839;
		j1856793565 -> j2042819463;
	j2924495892 [label="Ми повинні припинити звинувачувати одне одного за ті рани, які нам болять, незалежно від того, хто винен у цьому.",shape=box,color=blue];
		j2924495892 -> j290390839;
		j2924495892 -> j2042819463;
	j2423554558 [label="Та спокійно будь, я дражнюся ! Навіть уявити не можу, наскільки багато в тебе клопотів, і в скількох місцях (і часах) у тобі велика потреба.",shape=box,color=blue];
		j2423554558 -> j1071337271;
	j1951046007 [label="Та спокійно будь, я дражнюся ! Навіть уявити не можу, що вони пережили. І як складно тобі розплутати цей жмут.",shape=box,color=blue];
		j1951046007 -> j1071337271;
	j1071337271 [label="Я лишень переживаю, що без зцілення їхніх проблем ми ніколи й сподіватися не можемо, що нам будуть раді. Більша проблема лишається нерозв’язаною…",shape=box,color=blue];
		j1071337271 -> j354985132;
	j3916832970 [label="Check /Lotus/Scripts/1999/DialogueScriptNodes.lua:IsSyndicateRank(syndicate=EntratiSyndicate, syndicateRank=5)",color=orange];
		j3916832970 -> j1147654780 [label=true,color=green];
		j3916832970 -> j3337182392 [label=false,color=brown];
	j839671595 [label="Пф-ф ! Усе одно вважаю це прекрасним експериментом. Можливо, удасться зробити дияволу загорожу з купи книжкових шаф !",shape=box,color=blue];
		j839671595 -> j676854159;
	j3302389049 [label="Я гідно проігнорую твій сарказм, бо вважаю це прекрасним експериментом. Можливо, удасться зробити дияволу загорожу з купи книжкових шаф !",shape=box,color=blue];
		j3302389049 -> j676854159;
	j825962539 [label="Я шукаю помочі нам усім у налаштуванні… цього дивного співіснування, в якому опинилися. Я не хочу суперечок.",shape=box,color=blue];
		j825962539 -> j873629994;
	j1532873519 [label="Ні, ніякі не ігри. Але Ентраті не можна довіряти. Узагалі не знаю як іще в цьому тебе переконати, окрім удати, що я на твоєму боці.",shape=box,color=red];
		j1532873519 -> j1051656765;
	j1113412781 [label="Oui ? Що ж, із задоволенням повідомляю, що далі можеш не продовжувати.",shape=box,color=blue];
		j1113412781 -> j1509439757;
	j290390839 [label="Разом, усі як одне, ми… дивна родина. Але попри все — родина.",shape=box,color=red];
		j290390839 -> j1625808289;
	j2042819463 [label="Ми разом були б сильнішими, аніж коли нарізно.",shape=box,color=red];
		j2042819463 -> j1824654518;
		j2042819463 -> j2552365389;
	j1147654780 [label="Вона змирилася з його відсутністю. Вони помирилися одне з одним. Але цього досягти було дуже складно.",shape=box,color=red];
		j1147654780 -> j506646503;
	j3337182392 [label="Check boolean MarieSyndicateMaxRank",color=orange];
		j3337182392 -> j1147654780 [label=true,color=green];
		j3337182392 -> j2964351401 [label=false,color=brown];
	j676854159 [label="+20 Chemistry",color=orange];
		j676854159 -> j1645641264;
	j1051656765 [label="Oui ? Що ж, із задоволенням повідомляю, що тобі не вдалося.",shape=box,color=blue];
		j1051656765 -> j1509439757;
	j1509439757 [label="Boolean MarieEntratiFan1 is now false.",color=orange];
		j1509439757 -> j2631316640;
	j1625808289 [label="Add +1 to Family counter",color=orange];
		j1625808289 -> j1824654518;
		j1625808289 -> j2552365389;
	j1824654518 [label="І в часи великих страждань іноді ми всі є одне в одного. Або ті, кого нам дали, або ті, кого ми знайшли.",shape=box,color=red];
		j1824654518 -> j1457957129;
	j2552365389 [label="У довготривалій перспективі невідомо чи це допоможе, чи завадить. Але це… чистилище теж не правильне.",shape=box,color=red];
		j2552365389 -> j2958851458;
	j506646503 [label="Знати, що він десь досі там, займається чимось. І навіть слова не сказав їй, лист не написав?..",shape=box,color=red];
		j506646503 -> j722548285;
	j2964351401 [label="Вона не змирилася з його відсутністю. Вони ладні одне одному горлянки перегризти.",shape=box,color=red];
		j2964351401 -> j2740527769;
	j1645641264 [label="О, скільки в мене роботи ! À la revoyure !",shape=box,color=blue];
		j1645641264 -> "Chat ends.";
	j2631316640 [label="Boolean MarieEntratiFan2 is now false.",color=orange];
		j2631316640 -> j1508231473;
	j1457957129 [label="Add +1 to Family counter",color=orange];
		j1457957129 -> j2958851458;
	j2958851458 [label="Oui, згодна. Але не можу бути тим містком, що перекриє прірву між нами. Я не знаю як це зробити ! Я чужинка для тих, хто нагорі…",shape=box,color=blue];
		j2958851458 -> j4281531656;
		j2958851458 -> j282863758;
	j722548285 [label="Навіть уявити не можу як боляче це було б для неї. Для них.",shape=box,color=red];
		j722548285 -> j2784185964;
	j2740527769 [label="Знати, що він десь досі там, займається чимось. І навіть слова не сказав їй, лист не написав?..",shape=box,color=red];
		j2740527769 -> j1237845563;
	j1508231473 [label="Boolean MarieNoDate is now true.",color=orange];
		j1508231473 -> "Chat ends.";
	j4281531656 [label="Лойд знав усіх з родини Ентраті. Це має бути він. Та переконати його… от це вже інша пригода.",shape=box,color=red];
		j4281531656 -> j2775132893;
	j282863758 [label="Може, Роут? Він орокін, він усіх їх знав.",shape=box,color=red];
		j282863758 -> j3089848524;
	j2784185964 [label="Та я бачу хід думок, що призвів до рішення захистити їх від болю, який спричинив le Cardinal своїм вимушеним відбуттям…",shape=box,color=blue];
		j2784185964 -> j966696636;
	j1237845563 [label="Це зруйнувало б ту крихітну ймовірність на можливе примирення.",shape=box,color=red];
		j1237845563 -> j147328147;
	j2775132893 [label="+5 Chemistry",color=orange];
		j2775132893 -> j445367109;
	j3089848524 [label="Ні, не диявол. Будь-хто, але не диявол. Але ти наштовхуєш мене на цікаву думку. Найприроднішим вибором є монсеньйор Лойд, non ?",shape=box,color=blue];
		j3089848524 -> j2688373552;
	j966696636 [label="Я вважаю, що це жорстоко… безпідставно, а ти? Вони могли вважати його мертвим. Або ще гірше ! А ми живемо тут, comme des rats d'égout ?",shape=box,color=blue];
		j966696636 -> j528199732;
		j966696636 -> j2598767249;
		j966696636 -> j859530426;
	j147328147 [label="Oui… Логіка зрозуміла. Я би попрацювала над зціленням стосунків. Якщо можеш, то чом би й ні, правда ж? Видається, це єдина надія для будь-кого з нас вибратися звідси. ",shape=box,color=blue];
		j147328147 -> j2958777889;
	j445367109 [label="Oui, oui ! C'est ça ! Як же ж нам переконати його ? Він же чітко сказав і лишається непорушним на своєму, non ?",shape=box,color=blue];
		j445367109 -> j3584376706;
		j445367109 -> j3934677460;
	j2688373552 [label="Але як же ж нам переконати його ? Він же чітко сказав і лишається непорушним на своєму, non ?",shape=box,color=blue];
		j2688373552 -> j3934677460;
		j2688373552 -> j3584376706;
	j528199732 [label="Насправді, у мене є подруга, яка обожнює пацюків. Гадаю, вони дуже милі.",shape=box,color=red];
		j528199732 -> j1429605921;
	j2598767249 [label="Це не зовсім я маю приймати подібне рішення.",shape=box,color=red];
		j2598767249 -> j678283930;
	j859530426 [label="Що ти пропонуєш мені робити?",shape=box,color=red];
		j859530426 -> j3940429673;
	j2958777889 [label="Щоби ми доживали життя у тутешній пастці, des rats d'égout. ",shape=box,color=blue];
		j2958777889 -> j4045065394;
		j2958777889 -> j3176906844;
	j3584376706 [label="Гадаєш ти чи Ліон могли б його переконати?",shape=box,color=red];
		j3584376706 -> j1280555735;
	j3934677460 [label="Марі, моя відповідь тобі не сподобається…",shape=box,color=red];
		j3934677460 -> j3270039237;
	j1429605921 [label="Я б залюбки з ними познайомилася котрогось дня, але навряд чи це те саме, про що я, дурненьке вовченя.",shape=box,color=blue];
		j1429605921 -> j3940429673;
	j678283930 [label="Я знаю. Це справа монсеньйора Лойда. Його рішення й інших. Лише тоді знатимуть.",shape=box,color=blue];
		j678283930 -> j3940429673;
	j3940429673 [label="Можу припустити, що нас тримає тут унизу саме почуття провини, а не шляхетність.",shape=box,color=blue];
		j3940429673 -> j2579523205;
	j4045065394 [label="Насправді, у мене є подруга, яка обожнює пацюків. Гадаю, вони дуже милі. ",shape=box,color=red];
		j4045065394 -> j1429605921;
	j3176906844 [label="Це прояв моєї недбалості. Твоя правда. Повернуся до роботи.",shape=box,color=red];
		j3176906844 -> j661781470;
	j1280555735 [label="Ну ми йому подобаємося. Він добрий і ніжний. Але все одно ми новачки, для нього — étrangers.",shape=box,color=blue];
		j1280555735 -> j2042216341;
	j3270039237 [label="Ah bon ?",shape=box,color=blue];
		j3270039237 -> j1555195819;
	j2579523205 [label="Бо ми приховуємо якийсь великий і жахливий гріх.",shape=box,color=blue];
		j2579523205 -> j2095349746;
	j661781470 [label="Дякую. Я не знаю, чи вдасться тобі досягти успіху, але іноді ми не можемо нічим зарадити. Лишається лише намагатися.",shape=box,color=blue];
		j661781470 -> j3940429673;
	j2042216341 [label="Я поміркую над цим. І ти теж ! Рішення буде знайдене. Сол завів нас уже так далеко !",shape=box,color=blue];
		j2042216341 -> j1740415649;
	j1555195819 [label="Лойд може дослухатися до слів Роута. Він орокін і в них спільна історія. Це тут може стати в пригоді.",shape=box,color=red];
		j1555195819 -> j2344287519;
	j2095349746 [label="І той гріх спершу має бути прощеним або спростованим ?",shape=box,color=blue];
		j2095349746 -> j2161090422;
		j2095349746 -> j2321884321;
	j1740415649 [label="+15 Chemistry",color=orange];
		j1740415649 -> j1362498230;
	j2344287519 [label="Non ! Він брехун, маніпулятор. Він це зробить лише в обмін на велику нерівнозначну плату !",shape=box,color=blue];
		j2344287519 -> j582953832;
	j2161090422 [label="Ситуація нагорі… доволі крихка і в найліпші дні. Не хочу засмучувати їх.",shape=box,color=red];
		j2161090422 -> j744637201;
	j2321884321 [label="Нам треба бути дуже обачними. Боюся, що одні вважатимуть других «іншою родиною».",shape=box,color=red];
		j2321884321 -> j1516219893;
	j1362498230 [label="Ми знайдемо спосіб переконати монсеньйора Лойда підійнятися цими сходами… я знаю це.",shape=box,color=blue];
		j1362498230 -> j898517702;
	j582953832 [label="Ми знайдемо інший спосіб переконати монсеньйора Лойда підійнятися цими сходами… я знаю це.",shape=box,color=blue];
		j582953832 -> j3480055362;
	j744637201 [label="Тебе б здивувала стійкість душ. А ті, що довкола мене зараз, дуже старі, дуже загартовані часом.",shape=box,color=blue];
