digraph {
	1628 [label="MarieRank4Convo5 begins.",color=orange];
		1628 -> 1629;
	1629 [label="Evaluate expressions",color=orange];
		1629 -> 2930 [label="LoidFamilyComplete",color=purple];
		1629 -> 1630 [label="MarieFamilyOther",color=purple];
		1629 -> 1631 [label="MarieFamily2",color=purple];
		1629 -> 1631 [label="MarieFamily1",color=purple];
		1629 -> 1632 [label="false",color=purple];
	2930 [label="Мандрівниче ! Я тут накидала план.",shape=box,color=blue];
		2930 -> 2931;
		2930 -> 2932;
	1630 [label="Мандрівниче ! Я тут розмірковувала про твої слова за родину над нами. І що вони можуть вважати нас чужинцями й загрозою.",shape=box,color=blue];
		1630 -> 1633;
	1631 [label="Мандрівниче ! Я тут розмірковувала про твої слова за родину над нами. Моє серце болить за них…",shape=box,color=blue];
		1631 -> 1634;
	1632 [label="Чого ми не можемо підійнятися нагору ? Чому нам не можна балакати з тими, хто вважав le Cardinal членом родини ?",shape=box,color=blue];
		1632 -> 1635;
		1632 -> 1636;
	2931 [label="Мені має бути лячно?",shape=box,color=red];
		2931 -> 2934;
	2932 [label="[Завершити розмову]",shape=box,color=red];
		2932 -> 2933;
	1633 [label="«Іншою родиною» compétition, oui ? Це мене дуже бентежить.",shape=box,color=blue];
		1633 -> 1634;
	1634 [label="Check /Lotus/Scripts/1999/DialogueScriptNodes.lua:IsSyndicateRank",color=orange];
		1634 -> 1637 [label=true,color=green];
		1634 -> 1638 [label=false,color=brown];
	1635 [label="Ну… якщо коротко, то нагорі частина родини Ентраті. І вони не дуже… вірніше зовсім не знають, що ми тут унизу.",shape=box,color=red];
		1635 -> 1639;
	1636 [label="[Завершити розмову]",shape=box,color=red];
		1636 -> 1640;
	2934 [label="Oui ! Маленькі летючі роботи. Некра… Некра… Яка їхня назва, нагадай ?",shape=box,color=blue];
		2934 -> 2935;
	2933 [label="Chat ends.",color=orange];
	1637 [label="Ми не змагаємося за любов le Cardinal. Як же їм показати це?",shape=box,color=blue];
		1637 -> 1641;
		1637 -> 1642;
		1637 -> 1643;
	1638 [label="Як проходить твоя робота зі зцілення їхніх міжособистісних протирічь ?",shape=box,color=blue];
		1638 -> 1644;
		1638 -> 1645;
		1638 -> 1646;
		1638 -> 1647;
	1639 [label="Update boolean MarieFamily1",color=orange];
		1639 -> 1648;
	1640 [label="Chat ends.",color=orange];
	2935 [label="Некраміти?",shape=box,color=red];
		2935 -> 2936;
	1641 [label="Знаєш, твоя правда. Не можна змагатися за щось, чого людина не може дати.",shape=box,color=red];
		1641 -> 1649;
	1642 [label="Відкривати ранки, вкриті кірочкою, дуже небезпечно. Можна позбутися інфекції… або можна стекти кров’ю.",shape=box,color=red];
		1642 -> 1650;
	1643 [label="Ти… ми… усі мають дещо спільне. У певну мить Ентраті покинув нас.",shape=box,color=red];
		1643 -> 1651;
	1644 [label="Чесно? Займаюся дечим іншим.",shape=box,color=red];
		1644 -> 1652;
	1645 [label="Могло би бути й ліпше.",shape=box,color=red];
		1645 -> 1653;
	1646 [label="Потроху йде.",shape=box,color=red];
		1646 -> 1654;
	1647 [label="[Завершити розмову]",shape=box,color=red];
		1647 -> 1655;
	1648 [label="Par les Luminaires… Тобто ти маєш на увазі, що ми тут усі сидимо потайки ?! Саме тому не можна покидати це місце ?! Mais pourquoi ?!",shape=box,color=blue];
		1648 -> 1656;
	2936 [label="Oui ! Ха ! Вони дуже заповзято замінюють меблі, non ? Але я помітила, що в разі пересування чогось… вони все одно заміняють їх.",shape=box,color=blue];
		2936 -> 2937;
	1649 [label="Evaluate expressions",color=orange];
		1649 -> 1658 [label="MarieEntrati3a",color=purple];
		1649 -> 1658 [label="MarieEntrati3b",color=purple];
		1649 -> 1658 [label="MarieEntrati3",color=purple];
		1649 -> 1661 [label="MarieEntratiFamily",color=purple];
		1649 -> 1657 [label="MarieEntratiMonster1",color=purple];
		1649 -> 1657 [label="MarieEntratiMonster2",color=purple];
		1649 -> 1659 [label="MarieEntratiFan1",color=purple];
		1649 -> 1659 [label="MarieEntratiFan2",color=purple];
		1649 -> 1660 [label="MarieEntratiNeutral",color=purple];
		1649 -> 1661 [label="false",color=purple];
	1650 [label="Evaluate expressions",color=orange];
		1650 -> 1668 [label="MarieEntrati3a",color=purple];
		1650 -> 1668 [label="MarieEntrati3b",color=purple];
		1650 -> 1662 [label="MarieEntrati3",color=purple];
		1650 -> 1663 [label="MarieEntratiFamily",color=purple];
		1650 -> 1664 [label="MarieEntratiMonster1",color=purple];
		1650 -> 1664 [label="MarieEntratiMonster2",color=purple];
		1650 -> 1665 [label="MarieEntratiFan1",color=purple];
		1650 -> 1665 [label="MarieEntratiFan2",color=purple];
		1650 -> 1667 [label="MarieEntratiNeutral",color=purple];
		1650 -> 1666 [label="false",color=purple];
	1651 [label="Evaluate expressions",color=orange];
		1651 -> 1675 [label="MarieEntrati3a",color=purple];
		1651 -> 1675 [label="MarieEntrati3b",color=purple];
		1651 -> 1669 [label="MarieEntrati3",color=purple];
		1651 -> 1670 [label="MarieEntratiFamily",color=purple];
		1651 -> 1671 [label="MarieEntratiMonster1",color=purple];
		1651 -> 1671 [label="MarieEntratiMonster2",color=purple];
		1651 -> 1672 [label="MarieEntratiFan1",color=purple];
		1651 -> 1672 [label="MarieEntratiFan2",color=purple];
		1651 -> 1673 [label="MarieEntratiNeutral",color=purple];
		1651 -> 1674 [label="false",color=purple];
	1652 [label="Чим це таким іншим ти займаєшся ? Що може бути важливішим, аніж узяти й розібратися зі complaints of mécontents ?",shape=box,color=blue];
		1652 -> 1676;
	1653 [label="Та що такого складного може бути в тому, щоб узяти й розібратися зі complaints of mécontents ?",shape=box,color=blue];
		1653 -> 1677;
	1654 [label="Ой, magnifique !",shape=box,color=blue];
		1654 -> 1678;
	1655 [label="Chat ends.",color=orange];
	1656 [label="Його донька Евлерія (також відома як Матір) і її родина весь цей час піклувалися про Деймос.",shape=box,color=red];
		1656 -> 1679;
	2937 [label="Що зупиняє нас від того, щоби просто пересунути меблі й дозволити їм усе замінити, а потім… повторити ? Ми б могли все продати ! Збагатіти на de ce mobilier étrange !",shape=box,color=blue];
		2937 -> 2938;
		2937 -> 2939;
		2937 -> 2940;
	1658 [label="Я дуже добре усвідомлюю наші непримирені розбіжності стосовно le Cardinal. І намагаюся вести бесіду в цивілізованих рамках.",shape=box,color=blue];
		1658 -> 1680;
	1661 [label="Я розумію чому ти можеш не хотіти обговорювати залагодження розбіжностей, не маючи можливості вказати на тих, кого вважаєш винними.",shape=box,color=blue];
		1661 -> 1680;
	1657 [label="Oui ! Як ти частенько мені нагадуєш, усі ви вважате його un monstre ! Зі злобою і пустотою в серці й більш нічим !",shape=box,color=blue];
		1657 -> 1680;
	1659 [label="Хіба ти не на моїй стороні в цій війні за душу le Cardinal ?",shape=box,color=blue];
		1659 -> 1681;
	1660 [label="А хіба в тебе не було невизначеності стосовно le Cardinal ? Чи це вже змінилося ?",shape=box,color=blue];
		1660 -> 1682;
		1660 -> 1683;
	1668 [label="Oui. Я дізналася про це з мсьє Таґфером…",shape=box,color=blue];
		1668 -> 1686;
	1662 [label="Не говори зі мною про роз’ятрені рани, вовченя. Я досі зализую свої від останньої дискусії з le Cardinal.",shape=box,color=blue];
		1662 -> 1680;
	1663 [label="Oui, але ж це твої слова були, що ми повинні перестати звинувачувати одне одного за рани, від яких страждаємо.",shape=box,color=blue];
		1663 -> 1684;
	1664 [label="Я знаю, що ти вважаєш le Cardinal жахливим чудовиськом за завдання таких ран.",shape=box,color=blue];
		1664 -> 1680;
	1665 [label="Я знаю, що ти на моїй стороні в цій війні за душу le Cardinal. І вічно буду вдячною за це.",shape=box,color=blue];
		1665 -> 1666;
	1667 [label="Я знаю, що ти утримуєшся від суджень про нього. І за це я неймовірно вдячна.",shape=box,color=blue];
		1667 -> 1666;
	1666 [label="І я знаю, що інші швидко звинувачують його. Та не хочу, щоб ми були розділені й стікали кров’ю, коли могли би бути одним цілим.",shape=box,color=blue];
		1666 -> 1685;
	1675 [label="Oui, я вже починаю розуміти (як он з мсьє Таґфером), що може не все однаково.",shape=box,color=blue];
		1675 -> 1686;
	1669 [label="І я дізнаюся, що воно не все однакове. Бо ти ж так «по доброму» мені на це вказуєш мені, non ?",shape=box,color=blue];
		1669 -> 1680;
	1670 [label="Oui, так ! Хоч я й не звинувачую le Cardinal, що він покинув мене задля своєї sacro-saint місії…",shape=box,color=blue];
		1670 -> 1666;
	1671 [label="І я знаю, що ти вважаєш le Cardinal жахливим чудовиськом за завдання таких ран.",shape=box,color=blue];
		1671 -> 1680;
	1672 [label="Я знаю, що ти на моїй стороні в цій війні за душу le Cardinal. І вічно буду вдячною за це.",shape=box,color=blue];
		1672 -> 1666;
	1673 [label="Я знаю, що ти утримуєшся від суджень про нього. І за це я неймовірно вдячна.",shape=box,color=blue];
		1673 -> 1666;
	1674 [label="Інші швидко звинувачують його за свій біль. Але я просто не хочу бачити нас розділеними й у стражданнях.",shape=box,color=blue];
		1674 -> 1685;
	1676 [label="Та спокійно будь, я дражнюся ! Навіть уявити не можу, наскільки багато в тебе клопотів, і в скількох місцях (і часах) у тобі велика потреба.",shape=box,color=blue];
		1676 -> 1678;
	1677 [label="Та спокійно будь, я дражнюся ! Навіть уявити не можу, що вони пережили. І як складно тобі розплутати цей жмут.",shape=box,color=blue];
		1677 -> 1678;
	1678 [label="Я лишень переживаю, що без зцілення їхніх проблем ми ніколи й сподіватися не можемо, що нам будуть раді. Більша проблема лишається нерозв’язаною…",shape=box,color=blue];
		1678 -> 1637;
	1679 [label="Наглядали за цим місцем і за серцем, яке перекачує енергію Порожнечі в Материнську систему, що дозволяє нам усім… бути корисними, насправді. І це все аж з моменту зникнення Ентраті.",shape=box,color=red];
		1679 -> 1687;
	2938 [label="Щось мені не траплялися ринки з попитом на крісла Ентраті…",shape=box,color=red];
		2938 -> 2942;
	2939 [label="Хіба зрештою ми не переповнимо ринок пропозицією? Тоді доведеться віддавати їх задешево…",shape=box,color=red];
		2939 -> 2942;
	2940 [label="Геніально. Абсолютно не бачу перешкод.",shape=box,color=red];
		2940 -> 2941;
	1680 [label="І попри те, що усвідомлюю про нерозривні зв’язки цих двох тем, усе одно проситиму внести трішки ефективних рішень у цей день, oui ?",shape=box,color=blue];
		1680 -> 1688;
	1681 [label="Вовченя, що це за обманну шкуру ти на себе тягнеш ? Невже маленька Марі лише un jeu для тебе ?",shape=box,color=blue];
		1681 -> 1689;
		1681 -> 1683;
	1682 [label="Ще нічого не вирішено стосовно потрібності його дій. Але ця його жорстока натура не викликає ніяких сумнівів.",shape=box,color=red];
		1682 -> 1680;
	1683 [label="Мені набридло прикидатися. Вибач.",shape=box,color=red];
		1683 -> 1690;
	1686 [label="Ми повинні перестати звинувачувати одне одного за рани, від яких страждаємо.",shape=box,color=blue];
		1686 -> 1684;
	1684 [label="Зауважу, я також не погоджуюся з безумовним звинуваченням le Cardinal, та не хочу бути розділеними й стікати кров’ю, коли ми могли би бути одним цілим.",shape=box,color=blue];
		1684 -> 1691;
		1684 -> 1692;
	1685 [label="Ми повинні припинити звинувачувати одне одного за ті рани, які нам болять, незалежно від того, хто винен у цьому.",shape=box,color=blue];
		1685 -> 1691;
		1685 -> 1692;
	1687 [label="Check /Lotus/Scripts/1999/DialogueScriptNodes.lua:IsSyndicateRank",color=orange];
		1687 -> 1693 [label=true,color=green];
		1687 -> 1694 [label=false,color=brown];
	2942 [label="Пф-ф ! Усе одно вважаю це прекрасним експериментом. Можливо, удасться зробити дияволу загорожу з купи книжкових шаф !",shape=box,color=blue];
		2942 -> 2943;
	2941 [label="Я гідно проігнорую твій сарказм, бо вважаю це прекрасним експериментом. Можливо, удасться зробити дияволу загорожу з купи книжкових шаф !",shape=box,color=blue];
		2941 -> 2943;
	1688 [label="Я шукаю помочі нам усім у налаштуванні… цього дивного співіснування, в якому опинилися. Я не хочу суперечок.",shape=box,color=blue];
		1688 -> 1686;
	1689 [label="Ні, ніякі не ігри. Але Ентраті не можна довіряти. Узагалі не знаю як іще в цьому тебе переконати, окрім удати, що я на твоєму боці.",shape=box,color=red];
		1689 -> 1695;
	1690 [label="Oui ? Що ж, із задоволенням повідомляю, що далі можеш не продовжувати.",shape=box,color=blue];
		1690 -> 1696;
	1691 [label="Разом, усі як одне, ми… дивна родина. Але попри все — родина.",shape=box,color=red];
		1691 -> 1697;
	1692 [label="Ми разом були б сильнішими, аніж коли нарізно.",shape=box,color=red];
		1692 -> 1698;
		1692 -> 1699;
	1693 [label="Вона змирилася з його відсутністю. Вони помирилися одне з одним. Але цього досягти було дуже складно.",shape=box,color=red];
		1693 -> 1700;
	1694 [label="Вона не змирилася з його відсутністю. Вони ладні одне одному горлянки перегризти.",shape=box,color=red];
		1694 -> 1701;
	2943 [label="+20 Chemistry",color=orange];
		2943 -> 2944;
	1695 [label="Oui ? Що ж, із задоволенням повідомляю, що тобі не вдалося.",shape=box,color=blue];
		1695 -> 1696;
	1696 [label="Update boolean MarieEntratiFan1",color=orange];
		1696 -> 1702;
	1697 [label="Add +1 to Family",color=orange];
		1697 -> 1698;
		1697 -> 1699;
	1698 [label="І в часи великих страждань іноді ми всі є одне в одного. Або ті, кого нам дали, або ті, кого ми знайшли.",shape=box,color=red];
		1698 -> 1703;
	1699 [label="У довготривалій перспективі невідомо чи це допоможе, чи завадить. Але це… чистилище теж не правильне.",shape=box,color=red];
		1699 -> 1704;
	1700 [label="Знати, що він десь досі там, займається чимось. І навіть слова не сказав їй, лист не написав?..",shape=box,color=red];
		1700 -> 1705;
	1701 [label="Знати, що він десь досі там, займається чимось. І навіть слова не сказав їй, лист не написав?..",shape=box,color=red];
		1701 -> 1706;
	2944 [label="О, скільки в мене роботи ! À la revoyure !",shape=box,color=blue];
		2944 -> 2929;
	1702 [label="Update boolean MarieEntratiFan2",color=orange];
		1702 -> 1707;
	1703 [label="Add +1 to Family",color=orange];
		1703 -> 1704;
	1704 [label="Oui, згодна. Але не можу бути тим містком, що перекриє прірву між нами. Я не знаю як це зробити ! Я чужинка для тих, хто нагорі…",shape=box,color=blue];
		1704 -> 1708;
		1704 -> 1709;
	1705 [label="Навіть уявити не можу як боляче це було б для неї. Для них.",shape=box,color=red];
		1705 -> 1710;
	1706 [label="Це зруйнувало б ту крихітну ймовірність на можливе примирення.",shape=box,color=red];
		1706 -> 1711;
	2929 [label="Chat ends.",color=orange];
	1707 [label="Update boolean MarieNoDate",color=orange];
		1707 -> 1712;
	1708 [label="Лойд знав усіх з родини Ентраті. Це має бути він. Та переконати його… от це вже інша пригода.",shape=box,color=red];
		1708 -> 1713;
	1709 [label="Може, Роут? Він орокін, він усіх їх знав.",shape=box,color=red];
		1709 -> 1714;
	1710 [label="Та я бачу хід думок, що призвів до рішення захистити їх від болю, який спричинив le Cardinal своїм вимушеним відбуттям…",shape=box,color=blue];
		1710 -> 1715;
	1711 [label="Oui… Логіка зрозуміла. Я би попрацювала над зціленням стосунків. Якщо можеш, то чом би й ні, правда ж? Видається, це єдина надія для будь-кого з нас вибратися звідси. ",shape=box,color=blue];
		1711 -> 1716;
	1712 [label="Chat ends.",color=orange];
	1713 [label="+5 Chemistry",color=orange];
		1713 -> 1717;
	1714 [label="Ні, не диявол. Будь-хто, але не диявол. Але ти наштовхуєш мене на цікаву думку. Найприроднішим вибором є монсеньйор Лойд, non ?",shape=box,color=blue];
		1714 -> 1718;
	1715 [label="Я вважаю, що це жорстоко… безпідставно, а ти? Вони могли вважати його мертвим. Або ще гірше ! А ми живемо тут, comme des rats d'égout ?",shape=box,color=blue];
		1715 -> 1719;
		1715 -> 1720;
		1715 -> 1721;
	1716 [label="Щоби ми доживали життя у тутешній пастці, des rats d'égout. ",shape=box,color=blue];
		1716 -> 1722;
		1716 -> 1723;
	1717 [label="Oui, oui ! C'est ça ! Як же ж нам переконати його ? Він же чітко сказав і лишається непорушним на своєму, non ?",shape=box,color=blue];
		1717 -> 1724;
		1717 -> 1725;
	1718 [label="Але як же ж нам переконати його ? Він же чітко сказав і лишається непорушним на своєму, non ?",shape=box,color=blue];
		1718 -> 1725;
		1718 -> 1724;
	1719 [label="Насправді, у мене є подруга, яка обожнює пацюків. Гадаю, вони дуже милі.",shape=box,color=red];
		1719 -> 1726;
	1720 [label="Це не зовсім я маю приймати подібне рішення.",shape=box,color=red];
		1720 -> 1727;
	1721 [label="Що ти пропонуєш мені робити?",shape=box,color=red];
		1721 -> 1728;
	1722 [label="Насправді, у мене є подруга, яка обожнює пацюків. Гадаю, вони дуже милі. ",shape=box,color=red];
		1722 -> 1729;
	1723 [label="Це прояв моєї недбалості. Твоя правда. Повернуся до роботи.",shape=box,color=red];
		1723 -> 1730;
	1724 [label="Гадаєш ти чи Ліон могли б його переконати?",shape=box,color=red];
		1724 -> 1731;
	1725 [label="Марі, моя відповідь тобі не сподобається…",shape=box,color=red];
		1725 -> 1732;
	1726 [label="Я б залюбки з ними познайомилася котрогось дня, але навряд чи це те саме, про що я, дурненьке вовченя.",shape=box,color=blue];
		1726 -> 1728;
	1727 [label="Я знаю. Це справа монсеньйора Лойда. Його рішення й інших. Лише тоді знатимуть.",shape=box,color=blue];
		1727 -> 1728;
	1728 [label="Можу припустити, що нас тримає тут унизу саме почуття провини, а не шляхетність.",shape=box,color=blue];
		1728 -> 1733;
	1729 [label="Я б залюбки з ними познайомилася котрогось дня, але навряд чи це те саме, про що я, дурненьке вовченя.",shape=box,color=blue];
		1729 -> 1728;
	1730 [label="Дякую. Я не знаю, чи вдасться тобі досягти успіху, але іноді ми не можемо нічим зарадити. Лишається лише намагатися.",shape=box,color=blue];
		1730 -> 1728;
	1731 [label="Ну ми йому подобаємося. Він добрий і ніжний. Але все одно ми новачки, для нього — étrangers.",shape=box,color=blue];
		1731 -> 1734;
	1732 [label="Ah bon ?",shape=box,color=blue];
		1732 -> 1735;
	1733 [label="Бо ми приховуємо якийсь великий і жахливий гріх.",shape=box,color=blue];
		1733 -> 1736;
	1734 [label="Я поміркую над цим. І ти теж ! Рішення буде знайдене. Сол завів нас уже так далеко !",shape=box,color=blue];
		1734 -> 1737;
	1735 [label="Лойд може дослухатися до слів Роута. Він орокін і в них спільна історія. Це тут може стати в пригоді.",shape=box,color=red];
		1735 -> 1738;
	1736 [label="І той гріх спершу має бути прощеним або спростованим ?",shape=box,color=blue];
		1736 -> 1739;
		1736 -> 1740;
	1737 [label="+15 Chemistry",color=orange];
		1737 -> 1741;
	1738 [label="Non ! Він брехун, маніпулятор. Він це зробить лише в обмін на велику нерівнозначну плату !",shape=box,color=blue];
		1738 -> 1742;
	1739 [label="Ситуація нагорі… доволі крихка і в найліпші дні. Не хочу засмучувати їх.",shape=box,color=red];
		1739 -> 1743;
	1740 [label="Нам треба бути дуже обачними. Боюся, що одні вважатимуть других «іншою родиною».",shape=box,color=red];
		1740 -> 1744;
	1741 [label="Ми знайдемо спосіб переконати монсеньйора Лойда підійнятися цими сходами… я знаю це.",shape=box,color=blue];
		1741 -> 1745;
	1742 [label="Ми знайдемо інший спосіб переконати монсеньйора Лойда підійнятися цими сходами… я знаю це.",shape=box,color=blue];
		1742 -> 1746;
	1743 [label="Тебе б здивувала стійкість душ. А ті, що довкола мене зараз, дуже старі, дуже загартовані часом.",shape=box,color=blue];
		1743 -> 1747;
	1744 [label="Add +1 to Family",color=orange];
		1744 -> 1748;
	1745 [label="Я мушу йти. Є над чим поміркувати, є що поробити. À la revoyure.",shape=box,color=blue];
		1745 -> 1749;
	1746 [label="Я мушу йти. Є над чим поміркувати, є що поробити. À la revoyure.",shape=box,color=blue];
		1746 -> 1750;
	1747 [label="Тобі багато разів удавалося здивувати їх. Дозволь же цього разу їм здивувати тебе.",shape=box,color=blue];
		1747 -> 1751;
	1748 [label="Ох, Соле, я думаю, що тобі вдалося знайти рішення !",shape=box,color=blue];
