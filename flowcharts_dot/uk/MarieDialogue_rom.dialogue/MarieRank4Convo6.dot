		1758 -> 1760 [label=true,color=green];
		1758 -> 1759 [label=false,color=brown];
	1760 [label="Мандрівниче ? Є хвилинка ? Маю поговорити з тобою стосовно Ліона…",shape=box,color=blue];
		1760 -> 1761;
	1759 [label="Chat ends.",color=orange];
	1761 [label="Check boolean DrifterLyon",color=orange];
		1761 -> 1762 [label=true,color=green];
		1761 -> 1763 [label=true,color=green];
		1761 -> 1764 [label=true,color=green];
		1761 -> 1762 [label=false,color=brown];
		1761 -> 1765 [label=false,color=brown];
		1761 -> 1764 [label=false,color=brown];
	1762 [label="Він дорослий і сам може вирішувати, коли хоче говорити.",shape=box,color=red];
		1762 -> 1766;
	1763 [label="Моє серце захлинається кров’ю, коли бачу як він долає такий біль. Я не знаю як допомогти.",shape=box,color=red];
		1763 -> 1767;
	1764 [label="[Завершити розмову]",shape=box,color=red];
		1764 -> 1768;
	1765 [label="Я не знаю як допомогти йому.",shape=box,color=red];
		1765 -> 1769;
	1766 [label="Коли тобі довелося застрягнути у власноствореному світі, перебуваючи в нескінченних повторах смерті… тобі допомогли вибратися ?",shape=box,color=blue];
		1766 -> 1770;
		1766 -> 1771;
	1767 [label="Oui, і так боляче дивитися на те, як він страждає… Особливо знаючи, що в у твоєму серці є місце для нього.",shape=box,color=blue];
		1767 -> 1769;
	1768 [label="Chat ends.",color=orange];
	1769 [label="Складно передбачити, де в нього можуть бути кордони. Вони, буває, зміщуються день зо дня.",shape=box,color=blue];
		1769 -> 1772;
	1770 [label="Уся та допомога нічого б не була вартою, якби мені не хотілося її отримати.",shape=box,color=red];
		1770 -> 1773;
		1770 -> 1774;
	1771 [label="Так, друзі.",shape=box,color=red];
		1771 -> 1773;
		1771 -> 1774;
	1772 [label="Я бачила його agonie від того, що боги звалили йому на плечі. Я знаю, коли варто просто мовчки побути біля нього, а коли бути стіною, об яку він розбиває в кров кулаки (образно).",shape=box,color=blue];
		1772 -> 1775;
	1773 [label="Не думаю, що Ліон хоче моєї допомоги.",shape=box,color=red];
		1773 -> 1776;
	1774 [label="Я намагаюся бути поруч для нього, але він не слухає.",shape=box,color=red];
		1774 -> 1777;
	1775 [label="Mais ça ? Це все ? Це місце, промови диявола, невпевненість у тому, що зробив le Cardinal… Це завдає йому такого болю, що я можу лише молитися за те, щоб він міг повернутися.",shape=box,color=blue];
		1775 -> 1778;
		1775 -> 1779;
	1776 [label="Тоді, напевно… не лишається нічого іншого, лише терпляче чекати, non ?",shape=box,color=blue];
		1776 -> 1780;
	1777 [label="Мене теж, тому я тут і обговорюю з тобою це. Я завжди могла втішити його…",shape=box,color=blue];
		1777 -> 1781;
	1778 [label="Тож ти визнаєш, що Ентраті скривдив Ліона? І як це тобі?",shape=box,color=red];
		1778 -> 1782;
	1779 [label="Таке враження, що він уже на краю прірви. Як мені затягнути його назад?",shape=box,color=red];
		1779 -> 1783;
	1780 [label="Merci. Мені прикро, що змарнувала твій час.",shape=box,color=blue];
		1780 -> 1784;
	1781 [label="Я дуже вражена його гнівом, його désespoir… він уникає моєї присутності так, як ніколи не вчиняв раніше.",shape=box,color=blue];
		1781 -> 1785;
	1782 [label="Pas bien… Але тепер я маю вибрати між моєю любов’ю до брата та обожнюванням le Cardinal ? Як можна обирати між famille ?",shape=box,color=blue];
		1782 -> 1786;
		1782 -> 1787;
		1782 -> 1788;
		1782 -> 3961;
	1783 [label="Я не знаю, тому й маю обговорити це з тобою. Я завжди могла втішити його… ",shape=box,color=blue];
		1783 -> 1781;
	1784 [label="Chat ends.",color=orange];
	1785 [label="Що його так непокоїть ? Ти знаєш причину ?",shape=box,color=blue];
		1785 -> 1789;
	1786 [label="Марі, тобі не потрібно вибирати. Люди можуть бути складними своїм перебуванням у наших життях.",shape=box,color=red];
		1786 -> 1790;
	1787 [label="Мій вибір був би на користь рідних, які досі тут. А не тих, які покинули мене.",shape=box,color=red];
		1787 -> 1791;
	1788 [label="Не думаю, що Ентраті хотів завдавати Ліону такого болю.",shape=box,color=red];
		1788 -> 1792;
	3961 [label="Ти можеш вибрати собі нову сім’ю, родину. Як-от мене. І тих довкола, до кого тобі не байдуже. Просто без Ентраті.",shape=box,color=red];
		3961 -> 3962;
	1789 [label="Evaluate expressions",color=orange];
		1789 -> 1793 [label="DrifterFaithNoMITW",color=purple];
		1789 -> 1795 [label="DrifterFaithNoMITW",color=purple];
		1789 -> 1797 [label="LyonRell3",color=purple];
