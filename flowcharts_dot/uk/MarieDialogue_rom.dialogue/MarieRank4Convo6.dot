	edge [fontname="Roboto Condensed"];

	"MarieRank4Convo6 begins." [color=orange];
		"MarieRank4Convo6 begins." -> j3345346052;
	j3345346052 [label="Boolean MarieLyonAvailable is now true.",color=orange];
		j3345346052 -> j3023286837;
	j3023286837 [label="Check boolean LyonIndifference1",color=orange];
		j3023286837 -> j1168831031 [label=true,color=green];
		j3023286837 -> "Chat ends." [label=false,color=brown];
	j1168831031 [label="Мандрівниче ? Є хвилинка ? Маю поговорити з тобою стосовно Ліона…",shape=box,color=blue];
		j1168831031 -> j1531216646;
	"Chat ends." [color=orange];
	j1531216646 [label="Check boolean DrifterLyon",color=orange];
		j1531216646 -> j3643407463 [label=true,color=green];
		j1531216646 -> j2906923661 [label=true,color=green];
		j1531216646 -> j1478915251 [label=true,color=green];
		j1531216646 -> j3643407463 [label=false,color=brown];
		j1531216646 -> j474118166 [label=false,color=brown];
		j1531216646 -> j1478915251 [label=false,color=brown];
	j3643407463 [label="Він дорослий і сам може вирішувати, коли хоче говорити.",shape=box,color=red];
		j3643407463 -> j142019468;
	j2906923661 [label="Моє серце захлинається кров’ю, коли бачу як він долає такий біль. Я не знаю як допомогти.",shape=box,color=red];
		j2906923661 -> j3557660304;
	j1478915251 [label="[Завершити розмову]",shape=box,color=red];
		j1478915251 -> "Chat ends.";
	j474118166 [label="Я не знаю як допомогти йому.",shape=box,color=red];
		j474118166 -> j308141012;
	j142019468 [label="Коли тобі довелося застрягнути у власноствореному світі, перебуваючи в нескінченних повторах смерті… тобі допомогли вибратися ?",shape=box,color=blue];
		j142019468 -> j2965452146;
		j142019468 -> j1829987164;
	j3557660304 [label="Oui, і так боляче дивитися на те, як він страждає… Особливо знаючи, що в у твоєму серці є місце для нього.",shape=box,color=blue];
		j3557660304 -> j308141012;
	j308141012 [label="Складно передбачити, де в нього можуть бути кордони. Вони, буває, зміщуються день зо дня.",shape=box,color=blue];
		j308141012 -> j4215284264;
	j2965452146 [label="Уся та допомога нічого б не була вартою, якби мені не хотілося її отримати.",shape=box,color=red];
		j2965452146 -> j4042686774;
		j2965452146 -> j1947706653;
	j1829987164 [label="Так, друзі.",shape=box,color=red];
		j1829987164 -> j4042686774;
		j1829987164 -> j1947706653;
	j4215284264 [label="Я бачила його agonie від того, що боги звалили йому на плечі. Я знаю, коли варто просто мовчки побути біля нього, а коли бути стіною, об яку він розбиває в кров кулаки (образно).",shape=box,color=blue];
		j4215284264 -> j2047619683;
	j4042686774 [label="Не думаю, що Ліон хоче моєї допомоги.",shape=box,color=red];
		j4042686774 -> j4275066107;
	j1947706653 [label="Я намагаюся бути поруч для нього, але він не слухає.",shape=box,color=red];
		j1947706653 -> j1142181158;
	j2047619683 [label="Mais ça ? Це все ? Це місце, промови диявола, невпевненість у тому, що зробив le Cardinal… Це завдає йому такого болю, що я можу лише молитися за те, щоб він міг повернутися.",shape=box,color=blue];
		j2047619683 -> j2103354085;
		j2047619683 -> j1270591000;
	j4275066107 [label="Тоді, напевно… не лишається нічого іншого, лише терпляче чекати, non ?",shape=box,color=blue];
		j4275066107 -> j1326579197;
	j1142181158 [label="Мене теж, тому я тут і обговорюю з тобою це. Я завжди могла втішити його…",shape=box,color=blue];
		j1142181158 -> j4042450087;
	j2103354085 [label="Тож ти визнаєш, що Ентраті скривдив Ліона? І як це тобі?",shape=box,color=red];
		j2103354085 -> j2495960326;
	j1270591000 [label="Таке враження, що він уже на краю прірви. Як мені затягнути його назад?",shape=box,color=red];
		j1270591000 -> j3394927588;
	j1326579197 [label="Merci. Мені прикро, що змарнувала твій час.",shape=box,color=blue];
		j1326579197 -> "Chat ends.";
	j4042450087 [label="Я дуже вражена його гнівом, його désespoir… він уникає моєї присутності так, як ніколи не вчиняв раніше.",shape=box,color=blue];
		j4042450087 -> j1457575603;
	j2495960326 [label="Pas bien… Але тепер я маю вибрати між моєю любов’ю до брата та обожнюванням le Cardinal ? Як можна обирати між famille ?",shape=box,color=blue];
		j2495960326 -> j2056469633;
		j2495960326 -> j2567046341;
		j2495960326 -> j395664663;
		j2495960326 -> j1557455226;
	j3394927588 [label="Я не знаю, тому й маю обговорити це з тобою. Я завжди могла втішити його… ",shape=box,color=blue];
		j3394927588 -> j4042450087;
	j1457575603 [label="Що його так непокоїть ? Ти знаєш причину ?",shape=box,color=blue];
		j1457575603 -> j2411453274;
	j2056469633 [label="Марі, тобі не потрібно вибирати. Люди можуть бути складними своїм перебуванням у наших життях.",shape=box,color=red];
		j2056469633 -> j88711732;
	j2567046341 [label="Мій вибір був би на користь рідних, які досі тут. А не тих, які покинули мене.",shape=box,color=red];
		j2567046341 -> j3011462628;
	j395664663 [label="Не думаю, що Ентраті хотів завдавати Ліону такого болю.",shape=box,color=red];
		j395664663 -> j2811484595;
	j1557455226 [label="Ти можеш вибрати собі нову сім’ю, родину. Як-от мене. І тих довкола, до кого тобі не байдуже. Просто без Ентраті.",shape=box,color=red];
		j1557455226 -> j2375466566;
	j2411453274 [label="Evaluate expressions",color=orange];
		j2411453274 -> j2857376298 [label="DrifterFaithNoMITW",color=purple];
		j2411453274 -> j35907115 [label="DrifterFaithNoMITW",color=purple];
		j2411453274 -> j845940789 [label="LyonRell3",color=purple];
		j2411453274 -> j35907115 [label="LyonRell3",color=purple];
		j2411453274 -> j1330800563 [label="LyonRoathe3",color=purple];
		j2411453274 -> j35907115 [label="LyonRoathe3",color=purple];
		j2411453274 -> j2375377734 [label="LyonEntrati3",color=purple];
		j2411453274 -> j35907115 [label="LyonEntrati3",color=purple];
		j2411453274 -> j35907115 [label="LyonRell1",color=purple];
		j2411453274 -> j2722802151 [label="false",color=purple];
	j88711732 [label="У цьому й проблема з подібними Ентраті. Вони не є «добрі» чи «погані». Вони і те, і інше водночас.",shape=box,color=red];
		j88711732 -> j1674317856;
	j3011462628 [label="Приберімо балачки про le Cardinal з цієї розмови, oui ? Я переживаю за свого брата по духу.",shape=box,color=blue];
		j3011462628 -> j4042450087;
	j2811484595 [label="Теж не думаю, що він щось таке зробив, але факт є фактом, oui ? Та я вдячна за співчуття. Cela dit…",shape=box,color=blue];
		j2811484595 -> j3011462628;
	j2375466566 [label="Boolean DrifterMarie is now true.",color=orange];
		j2375466566 -> j3478259164;
	j2857376298 [label="Ліон намагається примиритися з фактом, що Байдужість — не справжнє божество.",shape=box,color=red];
		j2857376298 -> j2955854054;
	j35907115 [label="Не думаю, що це одне могло спричинити подібне. Думаю, тут сплелося зразу чимало всього.",shape=box,color=red];
		j35907115 -> j2316857770;
	j845940789 [label="Ліон чув голоси одного тенно. Хлопця на ім’я Релл. Релл… загинув. Я не думаю, що він може це нормально прийняти.",shape=box,color=red];
		j845940789 -> j2193770207;
	j1330800563 [label="Роут нашіптує йому всякі брехні про Людину в стіні.",shape=box,color=red];
		j1330800563 -> j806399988;
	j2375377734 [label="Не уявляю, як Ентраті міг нашепотіти йому, що голоси богів насправді є голосами з Порожнечі.",shape=box,color=red];
		j2375377734 -> j842776425;
	j2722802151 [label="Та ні, чесно не знаю.",shape=box,color=red];
		j2722802151 -> j1499335525;
	j1674317856 [label="Приберімо балачки про le Cardinal з цієї розмови, oui ? Я переживаю за свого брата по духу. Але… я бачу, що твої слова… дедалі більше стають правдивими.",shape=box,color=blue];
		j1674317856 -> j2063852644;
	j3478259164 [label="Не думай, що я не бачу, що ти робиш, скрадливе ти вовченя.",shape=box,color=blue];
		j3478259164 -> j1674317856;
	j2955854054 [label="І ти тут нічим не зарадиш, якщо балакатимеш із ним так. Навіть якщо хоч одне слово є правдою — треба дуже пильно стежити за тим, як воно доноситься.",shape=box,color=blue];
		j2955854054 -> j1246322499;
	j2316857770 [label="Oui, він був притулком серед бурі для багатьох… а тепер сам застряг у подібній.",shape=box,color=blue];
		j2316857770 -> j2868429107;
	j2193770207 [label="Я чула, як він вимовляв це ім’я. Релл… і в мене серце крається від знання долі хлопчика.",shape=box,color=blue];
		j2193770207 -> j663002273;
	j806399988 [label="Той диявол спричинив стільки горя за своє довге життя ! Але не думаю, що це може бути єдиною причиною.",shape=box,color=blue];
		j806399988 -> j2587763511;
	j842776425 [label="S'il te plaît, жодних більше згадок про le Cardinal. Я не заперечуватиму, що його слова могли посилити збентеження Ліона, але вони не могли бути єдиною причиною.",shape=box,color=blue];
		j842776425 -> j3843591673;
	j1499335525 [label="Тоді, напевно… ми можемо лише терпляче чекати й сподіватися знайти те, що бентежить його.",shape=box,color=blue];
		j1499335525 -> j1439376592;
	j2063852644 [label="Boolean MarieEntrati4a is now true.",color=orange];
		j2063852644 -> j4042450087;
	j1246322499 [label="Сокира — не найліпший інструмент для хірургії. Це ж не британський флот.",shape=box,color=blue];
		j1246322499 -> j3036048137;
	j2868429107 [label="Подертий з усіх сторін, розгублений, без знань куди йти…",shape=box,color=blue];
		j2868429107 -> j672058844;
		j2868429107 -> j2574289940;
	j663002273 [label="Та не думаю, що це єдина причина. Ліон іде шляхом Луа. La mort est une compagne qui marche à ses côtés.",shape=box,color=blue];
		j663002273 -> j3036048137;
	j2587763511 [label="Це допомогло його невпевненості… Але надавати такого значення словам якогось диявола ? Мій Ліон чув та знав і гірше. Я думаю, що його обтяжує одразу багато чого.",shape=box,color=blue];
		j2587763511 -> j2132114627;
		j2587763511 -> j2049226489;
	j3843591673 [label="Boolean MarieEntrati4b is now true.",color=orange];
		j3843591673 -> j1425508260;
	j1439376592 [label="+15 Chemistry",color=orange];
		j1439376592 -> j386955388;
	j3036048137 [label="Non, гадаю, що його обтяжує зараз багато всього.",shape=box,color=blue];
		j3036048137 -> j2132114627;
		j3036048137 -> j2049226489;
	j672058844 [label="Тоді ми маємо стати його притулком. Місцем, де його ніхто не скривдить.",shape=box,color=red];
		j672058844 -> j1958039227;
	j2574289940 [label="Значить ми повинні показати йому шлях до безпечного місця. Бути світлом у темряві.",shape=box,color=red];
		j2574289940 -> j1708792266;
	j2132114627 [label="Що ж, гадаю… ми повинні показати йому шлях до безпечного місця. Бути світлом у темряві.",shape=box,color=red];
		j2132114627 -> j1708792266;
	j2049226489 [label="Що ж, гадаю… ми маємо стати його притулком. Місцем, де його ніхто не скривдить.",shape=box,color=red];
		j2049226489 -> j3843650143;
	j1425508260 [label="Він не міг надати словам le Cardinal такої ваги, щоби поринути в таку непросвітну темряву. Думаю, що його обтяжує одразу багато чого.",shape=box,color=blue];
		j1425508260 -> j2049226489;
		j1425508260 -> j2132114627;
	j386955388 [label="Merci. Я знаю, що ти докладаєш усіх зусиль. І дуже вдячна за це.",shape=box,color=blue];
		j386955388 -> "Chat ends.";
	j1958039227 [label="+10 Chemistry",color=orange];
		j1958039227 -> j2748556776;
	j1708792266 [label="Як можна допомогти комусь, хто не чує твій поклик і не бачить твого світла ? Non, Луа оповила його цією темрявою.",shape=box,color=blue];
		j1708792266 -> j2915504123;
	j3843650143 [label="+5 Chemistry",color=orange];
		j3843650143 -> j2748556776;
	j2748556776 [label="Oui, припускаю, що твоя правда. Ми повинні бути тими, до кого він може звернутися, коли все інше підвело його.",shape=box,color=blue];
		j2748556776 -> j2015451428;
	j2915504123 [label="Я не думаю, що навіть світло Сола зможе пробити вуаль.",shape=box,color=blue];
		j2915504123 -> j2015451428;
	j2015451428 [label="Там, де його віра може бути нестійкою, ми повинні стати опорою для нього. ",shape=box,color=blue];
		j2015451428 -> j627932662;
	j627932662 [label="Якщо всі невидимі голоси перетворилися з приємних fantômes на démons, що катують його у тінях…",shape=box,color=blue];
		j627932662 -> j1216278671;
	j1216278671 [label="Ми повинні зробити себе реальнішими, non ?",shape=box,color=blue];
		j1216278671 -> j658124237;
		j1216278671 -> j1532338035;
	j658124237 [label="Я намагатимуся й далі.",shape=box,color=red];
		j658124237 -> j3670127295;
	j1532338035 [label="Я лише сподіваюся, що це не розірве його на шмаття.",shape=box,color=red];
		j1532338035 -> j137375867;
	j3670127295 [label="+10 Chemistry",color=orange];
		j3670127295 -> j1099047560;
	j137375867 [label="+5 Chemistry",color=orange];
		j137375867 -> j60812674;
	j1099047560 [label="Зрештою, це все, що ми можемо зробити.",shape=box,color=blue];
		j1099047560 -> j257133902;
	j60812674 [label="Oui… і я теж. Але все, що ми можемо, то це бути поруч і молитися, non ?",shape=box,color=blue];
		j60812674 -> j3553516490;
	j257133902 [label="Намагатися. І молитися.",shape=box,color=blue];
		j257133902 -> j3525543835;
	j3553516490 [label="І сподіватися, що вже не занадто пізно.",shape=box,color=blue];
		j3553516490 -> j3525543835;
	j3525543835 [label="Merci… я маю йти. Вибач, якщо ця розмова забрала час і не принесла користі. Я нервую, коли не можу діяти.",shape=box,color=blue];
		j3525543835 -> j4108523645;
		j3525543835 -> j3925687610;
	j4108523645 [label="Аналогічно. Але іноді дії — хибний вибір.",shape=box,color=red];
		j4108523645 -> j2425098442;
	j3925687610 [label="Усе з ним буде добре. Я впевнена.",shape=box,color=red];
		j3925687610 -> j2425098442;
	j2425098442 [label="Молитимуся за твою правоту. Не уявляю, що робитиму без нього.",shape=box,color=blue];
		j2425098442 -> "Chat ends.";
}