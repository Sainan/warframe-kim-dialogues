		1789 -> 1798 [label="LyonRoathe3",color=purple];
		1789 -> 1795 [label="LyonRoathe3",color=purple];
		1789 -> 1794 [label="LyonEntrati3",color=purple];
		1789 -> 1795 [label="LyonEntrati3",color=purple];
		1789 -> 1795 [label="LyonRell1",color=purple];
		1789 -> 1796 [label="false",color=purple];
	1790 [label="У цьому й проблема з подібними Ентраті. Вони не є «добрі» чи «погані». Вони і те, і інше водночас.",shape=box,color=red];
		1790 -> 1799;
	1791 [label="Приберімо балачки про le Cardinal з цієї розмови, oui ? Я переживаю за свого брата по духу.",shape=box,color=blue];
		1791 -> 1781;
	1792 [label="Теж не думаю, що він щось таке зробив, але факт є фактом, oui ? Та я вдячна за співчуття. Cela dit…",shape=box,color=blue];
		1792 -> 1791;
	3962 [label="Update boolean DrifterMarie",color=orange];
		3962 -> 3963;
	1793 [label="Ліон намагається примиритися з фактом, що Байдужість — не справжнє божество.",shape=box,color=red];
		1793 -> 1800;
	1795 [label="Не думаю, що це одне могло спричинити подібне. Думаю, тут сплелося зразу чимало всього.",shape=box,color=red];
		1795 -> 1802;
	1797 [label="Ліон чув голоси одного тенно. Хлопця на ім’я Релл. Релл… загинув. Я не думаю, що він може це нормально прийняти.",shape=box,color=red];
		1797 -> 1804;
	1798 [label="Роут нашіптує йому всякі брехні про Людину в стіні.",shape=box,color=red];
		1798 -> 1805;
	1794 [label="Не уявляю, як Ентраті міг нашепотіти йому, що голоси богів насправді є голосами з Порожнечі.",shape=box,color=red];
		1794 -> 1801;
	1796 [label="Та ні, чесно не знаю.",shape=box,color=red];
		1796 -> 1803;
	1799 [label="Приберімо балачки про le Cardinal з цієї розмови, oui ? Я переживаю за свого брата по духу. Але… я бачу, що твої слова… дедалі більше стають правдивими.",shape=box,color=blue];
		1799 -> 1806;
	3963 [label="Не думай, що я не бачу, що ти робиш, скрадливе ти вовченя.",shape=box,color=blue];
		3963 -> 1799;
	1800 [label="І ти тут нічим не зарадиш, якщо балакатимеш із ним так. Навіть якщо хоч одне слово є правдою — треба дуже пильно стежити за тим, як воно доноситься.",shape=box,color=blue];
		1800 -> 1807;
	1802 [label="Oui, він був притулком серед бурі для багатьох… а тепер сам застряг у подібній.",shape=box,color=blue];
		1802 -> 1809;
	1804 [label="Я чула, як він вимовляв це ім’я. Релл… і в мене серце крається від знання долі хлопчика.",shape=box,color=blue];
		1804 -> 1811;
	1805 [label="Той диявол спричинив стільки горя за своє довге життя ! Але не думаю, що це може бути єдиною причиною.",shape=box,color=blue];
		1805 -> 1812;
	1801 [label="S'il te plaît, жодних більше згадок про le Cardinal. Я не заперечуватиму, що його слова могли посилити збентеження Ліона, але вони не могли бути єдиною причиною.",shape=box,color=blue];
		1801 -> 1808;
	1803 [label="Тоді, напевно… ми можемо лише терпляче чекати й сподіватися знайти те, що бентежить його.",shape=box,color=blue];
		1803 -> 1810;
	1806 [label="Update boolean MarieEntrati4a",color=orange];
		1806 -> 1781;
	1807 [label="Сокира — не найліпший інструмент для хірургії. Це ж не британський флот.",shape=box,color=blue];
		1807 -> 1813;
	1809 [label="Подертий з усіх сторін, розгублений, без знань куди йти…",shape=box,color=blue];
		1809 -> 1815;
		1809 -> 1816;
	1811 [label="Та не думаю, що це єдина причина. Ліон іде шляхом Луа. La mort est une compagne qui marche à ses côtés.",shape=box,color=blue];
		1811 -> 1813;
	1812 [label="Це допомогло його невпевненості… Але надавати такого значення словам якогось диявола ? Мій Ліон чув та знав і гірше. Я думаю, що його обтяжує одразу багато чого.",shape=box,color=blue];
		1812 -> 1818;
		1812 -> 1819;
	1808 [label="Update boolean MarieEntrati4b",color=orange];
		1808 -> 1814;
	1810 [label="+15 Chemistry",color=orange];
		1810 -> 1817;
	1813 [label="Non, гадаю, що його обтяжує зараз багато всього.",shape=box,color=blue];
		1813 -> 1818;
		1813 -> 1819;
	1815 [label="Тоді ми маємо стати його притулком. Місцем, де його ніхто не скривдить.",shape=box,color=red];
		1815 -> 1820;
	1816 [label="Значить ми повинні показати йому шлях до безпечного місця. Бути світлом у темряві.",shape=box,color=red];
		1816 -> 1821;
	1818 [label="Що ж, гадаю… ми повинні показати йому шлях до безпечного місця. Бути світлом у темряві.",shape=box,color=red];
		1818 -> 1821;
	1819 [label="Що ж, гадаю… ми маємо стати його притулком. Місцем, де його ніхто не скривдить.",shape=box,color=red];
		1819 -> 1823;
	1814 [label="Він не міг надати словам le Cardinal такої ваги, щоби поринути в таку непросвітну темряву. Думаю, що його обтяжує одразу багато чого.",shape=box,color=blue];
		1814 -> 1819;
		1814 -> 1818;
	1817 [label="Merci. Я знаю, що ти докладаєш усіх зусиль. І дуже вдячна за це.",shape=box,color=blue];
		1817 -> 1822;
	1820 [label="+10 Chemistry",color=orange];
		1820 -> 1824;
	1821 [label="Як можна допомогти комусь, хто не чує твій поклик і не бачить твого світла ? Non, Луа оповила його цією темрявою.",shape=box,color=blue];
		1821 -> 1825;
	1823 [label="+5 Chemistry",color=orange];
		1823 -> 1824;
	1822 [label="Chat ends.",color=orange];
	1824 [label="Oui, припускаю, що твоя правда. Ми повинні бути тими, до кого він може звернутися, коли все інше підвело його.",shape=box,color=blue];
		1824 -> 1826;
	1825 [label="Я не думаю, що навіть світло Сола зможе пробити вуаль.",shape=box,color=blue];
		1825 -> 1826;
	1826 [label="Там, де його віра може бути нестійкою, ми повинні стати опорою для нього. ",shape=box,color=blue];
		1826 -> 1827;
	1827 [label="Якщо всі невидимі голоси перетворилися з приємних fantômes на démons, що катують його у тінях…",shape=box,color=blue];
		1827 -> 1828;
	1828 [label="Ми повинні зробити себе реальнішими, non ?",shape=box,color=blue];
		1828 -> 1829;
		1828 -> 1830;
	1829 [label="Я намагатимуся й далі.",shape=box,color=red];
		1829 -> 1831;
	1830 [label="Я лише сподіваюся, що це не розірве його на шмаття.",shape=box,color=red];
		1830 -> 1832;
	1831 [label="+10 Chemistry",color=orange];
		1831 -> 1833;
	1832 [label="+5 Chemistry",color=orange];
		1832 -> 1834;
	1833 [label="Зрештою, це все, що ми можемо зробити.",shape=box,color=blue];
		1833 -> 1835;
	1834 [label="Oui… і я теж. Але все, що ми можемо, то це бути поруч і молитися, non ?",shape=box,color=blue];
		1834 -> 1836;
	1835 [label="Намагатися. І молитися.",shape=box,color=blue];
		1835 -> 1837;
	1836 [label="І сподіватися, що вже не занадто пізно.",shape=box,color=blue];
		1836 -> 1837;
	1837 [label="Merci… я маю йти. Вибач, якщо ця розмова забрала час і не принесла користі. Я нервую, коли не можу діяти.",shape=box,color=blue];
		1837 -> 1838;
		1837 -> 1839;
	1838 [label="Аналогічно. Але іноді дії — хибний вибір.",shape=box,color=red];
		1838 -> 1840;
	1839 [label="Усе з ним буде добре. Я впевнена.",shape=box,color=red];
		1839 -> 1840;
	1840 [label="Молитимуся за твою правоту. Не уявляю, що робитиму без нього.",shape=box,color=blue];
		1840 -> 1841;
	1841 [label="Chat ends.",color=orange];
