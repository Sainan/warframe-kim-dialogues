		2035 -> 2042;
	2036 [label="Десь знову блукає коридорами своєї свідомості чи зациклився на спостереженні за якимось іншим esprit в кімнаті.",shape=box,color=blue];
		2036 -> 2043;
	2037 [label="Прояви терплячість із ним, доброту. Eet je vous en supplie, не скривдь його, oui ?",shape=box,color=blue];
