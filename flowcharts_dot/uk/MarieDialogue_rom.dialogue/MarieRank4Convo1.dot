	j1967543556 [label="[Вимкнути всі бесіди про самоушкодження. Жодної одиниці сумісності з будь-якими персонажами не буде втрачено]",shape=box,color=red];
		j1967543556 -> j2266292255;
	j2384517691 [label="Не знаю, хочеться мені, щоб ті його видіння були справжніми чи несправжніми.",shape=box,color=red];
		j2384517691 -> j3812808345;
	j156932814 [label="Ну, ці розмови про ті жахіття, які він бачить. Їхні описи…",shape=box,color=red];
		j156932814 -> j3812808345;
	j288373879 [label="Що він котрогось дня скалічить себе так, що вже не буде порятунку?",shape=box,color=red];
		j288373879 -> j3890339188;
	j2020688367 [label="Ти почувалася в небезпеці в його присутності? Не думала, що він може зашкодити тобі, навіть не усвідомлюючи цього?",shape=box,color=red];
		j2020688367 -> j1834915337;
	j2266292255 [label="Boolean LyonPainOff is now true.",color=orange];
		j2266292255 -> j611036089;
	j3812808345 [label="+5 Chemistry",color=orange];
		j3812808345 -> j200423388;
	j3890339188 [label="А… це не дуже приємна тема, oui ? Pardon, та я чесно не знаю, як про це нормально говорити, не почуваючись некомфортно.",shape=box,color=blue];
		j3890339188 -> j1559794511;
	j1834915337 [label="Я вірую в те, що Ліон радше загине сам, аніж зашкодить мені. Я маю віру у богів, у дияволів…",shape=box,color=blue];
		j1834915337 -> j1800673898;
	j611036089 [label="+20 Chemistry",color=orange];
		j611036089 -> j1647535276;
	j200423388 [label="Жахіття, які сповнюють його голову — Луа веде його складним шляхом, oui ?",shape=box,color=blue];
		j200423388 -> j2507338686;
	j1559794511 [label="Але я намагаюся зі всіх сил. Припускаю, що ти питаєш, бо непокоїшся ?",shape=box,color=blue];
		j1559794511 -> j1313228967;
		j1559794511 -> j433137329;
	j1800673898 [label="Вірю, що навіть твоя l'Indifférence не змогла б обдурити його й змусити замахнутися на мене з насиллям.",shape=box,color=blue];
		j1800673898 -> j1451427767;
	j1647535276 [label="[Цей варіант дозволить обійти всі розмови стосовно самоушкодження]",shape=box,color=blue];
		j1647535276 -> "Chat ends.";
	j2507338686 [label="Боюся, це занадто складна тема для розмови. Я знаю, що цього не повинно відбуватися, oui ?",shape=box,color=blue];
		j2507338686 -> j532183468;
	j1313228967 [label="Ворфрейм, протосироватку якого дали Ліону відомий своїми… ну…",shape=box,color=red];
		j1313228967 -> j1074664655;
		j1313228967 -> j225950567;
		j1313228967 -> j2193048376;
	j433137329 [label="Ну це доволі очевидні речі. Достатньо лише глянути на нього… я не намагаюся образити. Просто не складно було здогадатися.",shape=box,color=red];
		j433137329 -> j1074664655;
		j433137329 -> j225950567;
		j433137329 -> j2193048376;
	j1451427767 [label="Я більше маю переживати, що метелик зжере мене повністю, аніж брат по духу завдасть шкоди.",shape=box,color=blue];
		j1451427767 -> j2507338686;
	j532183468 [label="Я хотіла б зупинити це. Захистити від бажання завдавати собі такої шкоди.",shape=box,color=blue];
		j532183468 -> j1807281390;
	j1074664655 [label="Я просто хвилююся, що котрогось дня він зайде занадто далеко.",shape=box,color=red];
		j1074664655 -> j2507338686;
	j225950567 [label="Він потрібен нам цілим.",shape=box,color=red];
		j225950567 -> j1735560223;
	j2193048376 [label="Я не маю непокоїтися про те, що доведеться десь ховати потім його тіло.",shape=box,color=red];
		j2193048376 -> j698283448;
	j1807281390 [label="Якщо і є щось одне, в чому я можу бути впевнена в Ліоні, то це те, що він завжди буде там, де потрібен.",shape=box,color=blue];
		j1807281390 -> j3757986161;
	j1735560223 [label="Ти слово в слово повторюєш слова диявола. Невже тебе цікавить лише наявність умілих рук ?",shape=box,color=blue];
		j1735560223 -> j3957106002;
		j1735560223 -> j3117257037;
	j698283448 [label="Dégoûtant.",shape=box,color=blue];
		j698283448 -> j1508231473;
	j3757986161 [label="Він чудовий захисник, le bouclier sacré de Lua… Яскраве сяйво світла у всепоглинальній темряві ночі.",shape=box,color=blue];
		j3757986161 -> j1089350467;
	j3957106002 [label="Ні, я переживаю за нього. Мене непокоїть лише думка, що в мить потреби його не буде поруч.",shape=box,color=red];
		j3957106002 -> j1807281390;
	j3117257037 [label="Я просто маю знати, чи можу розраховувати на нього. Чи ні. Чи він уже й так занадто зломлений.",shape=box,color=red];
		j3117257037 -> j1735790854;
	j1508231473 [label="Boolean MarieNoDate is now true.",color=orange];
		j1508231473 -> "Chat ends.";
	j1089350467 [label="Біль, який він спричиняє собі… він робить це, щоби почути власні думки. Щоб відчути власне тіло. ",shape=box,color=blue];
		j1089350467 -> j2894648840;
	j1735790854 [label="Цікаво, хто ж тобі допоможе, коли ти лежатимеш долілиць і потребуватимеш допомоги.",shape=box,color=blue];
		j1735790854 -> j3778924895;
	j2894648840 [label="Бо небо вкривають зорі… і кожна шепоче до нього, а він, як сама Луа, просто губиться серед них.",shape=box,color=blue];
		j2894648840 -> j2096170761;
	j3778924895 [label="Чи ти вважаєш, що це вже відбулося й ти вище подібного ?",shape=box,color=blue];
		j3778924895 -> j698283448;
	j2096170761 [label="І як Луа, він має фази. Він віддається Порожнечі лише для того, щоб сяяти найяскравіше й ми могли йти в темряві, не відчуваючи страху.",shape=box,color=blue];
		j2096170761 -> j4198194373;
	j4198194373 [label="Але кожне благословення має на звороті прокляття. Ти хоч щось розумієш ? Чи це все довге простирадло тексту ?",shape=box,color=blue];
		j4198194373 -> j3074271035;
		j4198194373 -> j928966114;
		j4198194373 -> j247415406;
		j4198194373 -> j1833223771;
		j4198194373 -> j3297643389;
	j3074271035 [label="Усе чудово розумію. І знаєш… я маю тобі в дечому зізнатися. [Розповісти про почуття до Ліона]",shape=box,color=red];
		j3074271035 -> j3717254221;
	j928966114 [label="Я розумію написане, але не можу виправдати його самоушкодження. Він має припинити це.",shape=box,color=red];
		j928966114 -> j731164022;
	j247415406 [label="[Увага: обговорення самогубства] Я… дехто… мене покинули подібним способом… вчинивши самогубство. Я… я не можу цього виправдати.",shape=box,color=red];
		j247415406 -> j2652764597;
	j1833223771 [label="Має бути інший шлях.",shape=box,color=red];
		j1833223771 -> j736521318;
	j3297643389 [label="Так, усе абсолютно зрозуміло. Я просто… хочу допомогти йому.",shape=box,color=red];
		j3297643389 -> j736521318;
	j3717254221 [label="Boolean DrifterLyon is now true.",color=orange];
		j3717254221 -> j4060781349;
	j731164022 [label="Boolean DrifterHarmStop is now true.",color=orange];
		j731164022 -> j921320089;
	j2652764597 [label="Boolean DrifterHarmLoss is now true.",color=orange];
		j2652764597 -> j595098084;
	j736521318 [label="Boolean DrifterHarmHelp is now true.",color=orange];
		j736521318 -> j2273051945;
	j4060781349 [label="Боюся… він викрав моє серце й воно крається, відчуваючи його біль.",shape=box,color=red];
		j4060781349 -> j2864128660;
	j921320089 [label="Біль, який він відчуває, глибший ніж той, що відчуває плоть. Те, що він робить із собою зараз, не вб’є його.",shape=box,color=blue];
		j921320089 -> j3988480027;
	j595098084 [label="Ой ! Я не знала… Мені дуже-дуже шкода… Які б молитви та слова підтримки я не запропонувала, упевнена, що вони здаватимуться порожніми й холодними…",shape=box,color=blue];
		j595098084 -> j825172707;
	j2273051945 [label="+20 Chemistry",color=orange];
		j2273051945 -> j2360518809;
	j2864128660 [label="+20 Chemistry",color=orange];
		j2864128660 -> j2588006784;
	j3988480027 [label="Це очищує його свідомість, урівноважує душу. А тепер, коли він протофрейм… частково цей… як його… Гарроу, як я частково Вісп… То це ж не вб’є його, oui ? ",shape=box,color=blue];
		j3988480027 -> j362580638;
		j3988480027 -> j530118178;
	j825172707 [label="Чи може хтось виявити condoléances, якщо це ледь знайома особа, щоб те співчуття могло пом’якшити подібну tragédie ?",shape=box,color=blue];
		j825172707 -> j3833507721;
	j2360518809 [label="Ну, як тебе за подібне можна не обожнювати ? Але допомога може приймати різні форми й мати різні результати, non ?",shape=box,color=blue];
		j2360518809 -> j140876897;
	j2588006784 [label="О !!! Я щойно заверещала, наче мишу встріла, і дуже налякала монсеньйора Лойда ! Pardon !!!",shape=box,color=blue];
		j2588006784 -> j534467059;
	j362580638 [label="Ні, не вб’є його. Але все одно це добре.",shape=box,color=red];
		j362580638 -> j1961344775;
	j530118178 [label="Гадаю, я розумію, про що ти.",shape=box,color=red];
		j530118178 -> j3119354156;
	j3833507721 [label="Ця втрачена тобою душа… ви були близькі ?",shape=box,color=blue];
		j3833507721 -> j156572578;
		j3833507721 -> j2239468627;
	j140876897 [label="Допомога пташаті може вбити його. Допомога полум’ю свічки може згасити його, якщо проявити забагато exubérance.",shape=box,color=blue];
		j140876897 -> j3724795585;
	j534467059 [label="Ох, але ж які це чудові новини !",shape=box,color=blue];
		j534467059 -> j2157455007;
		j534467059 -> j3734272205;
	j1961344775 [label="Я зрозуміла, що перебування поруч, коли він потребує мене… вислуховування, обійми під час плачу…",shape=box,color=blue];
		j1961344775 -> j3188711149;
	j3119354156 [label="+10 Chemistry",color=orange];
		j3119354156 -> j3724795585;
	j156572578 [label="Так.",shape=box,color=red];
		j156572578 -> j1678558265;
	j2239468627 [label="Не дуже.",shape=box,color=red];
		j2239468627 -> j3200391374;
	j3724795585 [label="Я зрозуміла, що перебування неподалік, коли він потребує мене… вислуховування, сидіння поруч під час плачу…",shape=box,color=blue];
		j3724795585 -> j1455177316;
	j2157455007 [label="Серйозно? А мені було складно визначити, як ти до цього поставишся.",shape=box,color=red];
		j2157455007 -> j3744034902;
	j3734272205 [label="Мені просто хотілося б знати, чи він зможе стерпіти мою присутність, чи ні…",shape=box,color=red];
		j3734272205 -> j1451943636;
	j3188711149 [label="Значить, і робить більше для нього, аніж балачки про те, що він повинен і не повинен робити.",shape=box,color=blue];
		j3188711149 -> j1737677326;
	j1678558265 [label="Це тому ти так прагнеш упевнитися, що Ліона не спіткає та сама доля ? Чи це просто ця тема так тебе засмучує ?",shape=box,color=blue];
		j1678558265 -> j366816123;
		j1678558265 -> j1249050206;
	j3200391374 [label="Навіть так, коли поруч із тобою хтось настільки замикається у своїх проблемах, що лишається лише подібний вихід… ",shape=box,color=blue];
		j3200391374 -> j1678558265;
	j1455177316 [label="Значить, і робить більше для нього, аніж балачки про те, що він повинен і не повинен робити.",shape=box,color=blue];
		j1455177316 -> j875959280;
		j1455177316 -> j1450020177;
		j1455177316 -> j1388191011;
	j3744034902 [label="О, та я неймовірна рада. Tellement ravie ! Ти навіть не уявляєш наскільки Ліону потрібна любов !",shape=box,color=blue];
		j3744034902 -> j3336615239;
	j1451943636 [label="Гм, схоже на розмову з statue de marbre, non ? Чудово розумію. Бувало таке, що доводилось хвилин двадцять захопливо щось розповідати, а потім лише усвідомити, що він не слухає.",shape=box,color=blue];
		j1451943636 -> j412131793;
	j1737677326 [label="Може, варто навчитися читати між рядків, non ? Він говорить історіями. Притчами. Якщо мовчить, то придивляйся до мови тіла.",shape=box,color=blue];
		j1737677326 -> j1585586047;
	j366816123 [label="Я… давай оминатимемо цю тему, будь ласка. Я не можу. ",shape=box,color=red];
		j366816123 -> j170244503;
	j1249050206 [label="Я маю впевнитися, що Ліон не страждає…",shape=box,color=red];
		j1249050206 -> j3570804863;
	j875959280 [label="Я намагатимуся якнайліпше скористатися твоєю порадою. Просто складно зрозуміти, як до нього достукатися.",shape=box,color=red];
		j875959280 -> j1517768634;
	j1450020177 [label="Я зроблю все можливе, просто… хотілося б могти зробити більше.",shape=box,color=red];
		j1450020177 -> j1951337037;
	j1388191011 [label="Просто іноді… його фрустрація спантеличує.",shape=box,color=red];
		j1388191011 -> j1517768634;
	j3336615239 [label="Хоча, якраз ти, певно, і уявляєш. Він, як бачиш, дуже страждає, попри показну незворушність…",shape=box,color=blue];
		j3336615239 -> j2508866118;
	j412131793 [label="Десь знову блукає коридорами своєї свідомості чи зациклився на спостереженні за якимось іншим esprit в кімнаті.",shape=box,color=blue];
		j412131793 -> j3553426170;
	j1585586047 [label="Прояви терплячість із ним, доброту. Eet je vous en supplie, не скривдь його, oui ?",shape=box,color=blue];
		j1585586047 -> j2574255711;
		j1585586047 -> j3237039197;
	j170244503 [label="Boolean LyonPainOff is now true.",color=orange];
		j170244503 -> j3483633217;
	j3570804863 [label="Boolean LyonPainResolved is now true.",color=orange];
		j3570804863 -> j3483633217;
	j1517768634 [label="Гм, схоже на розмову з statue de marbre, non ? Чудово розумію. Бувало таке, що доводилось хвилин двадцять захопливо щось розповідати, а потім лише усвідомити, що він не слухає.",shape=box,color=blue];
		j1517768634 -> j997629615;
	j1951337037 [label="Oui, я розумію. Але буває так, що ми іноді мало що можемо. Лише бути поруч тоді та в такій формі, як вони хочуть.",shape=box,color=blue];
		j1951337037 -> j2086819600;
	j2508866118 [label="Прояви терплячість із ним, доброту. Eet je vous en supplie, не скривдь його, oui ?",shape=box,color=blue];
		j2508866118 -> j977511491;
	j3553426170 [label="Може, варто навчитися читати між рядків, non ? Він говорить історіями. Притчами. Якщо мовчить, то придивляйся до мови тіла.",shape=box,color=blue];
		j3553426170 -> j2508866118;
	j2574255711 [label="Знаєш, я досі вважаю, що це неправильно.",shape=box,color=red];
		j2574255711 -> j928990152;
	j3237039197 [label="Зроблю все, що мені до снаги.",shape=box,color=red];
		j3237039197 -> j2642575370;
	j3483633217 [label="Звісно… Я можу розповісти історію про декого з мого минулого, де розв’язка була така сама ? Чи радше ми взагалі оминемо цю тему ?",shape=box,color=blue];
		j3483633217 -> j2623989364;
		j3483633217 -> j2254820407;
		j3483633217 -> j4286437313;
	j997629615 [label="Десь знову блукає коридорами своєї свідомості чи зациклився на спостереженні за якимось іншим esprit в кімнаті.",shape=box,color=blue];
		j997629615 -> j203817571;
	j2086819600 [label="Якщо тиснути, то можна зламати їх або відвадити від себе.",shape=box,color=blue];
		j2086819600 -> j2767456722;
	j977511491 [label="Це все, про що я можу просити. О, але ж яка я рада ! Я маю добряче попрацювати, щоб ця пара була разом !",shape=box,color=blue];
		j977511491 -> j2933062965;
		j977511491 -> j965356766;
		j977511491 -> j1012126371;
	j928990152 [label="Тоді поговори з ним про свої переживання. Він вислухає. Він давно не дитина. ",shape=box,color=blue];
		j928990152 -> j1416347182;
	j2642575370 [label="+20 Chemistry",color=orange];
		j2642575370 -> j1160939585;
	j2623989364 [label="Облишмо цю тему просто зараз. ",shape=box,color=red];
		j2623989364 -> j2182893633;
	j2254820407 [label="Можемо натомість повернутися до розмови про Ліона?",shape=box,color=red];
		j2254820407 -> j1318566387;
	j4286437313 [label="Я… хочу більше про них дізнатися.",shape=box,color=red];
		j4286437313 -> j2767069790;
	j203817571 [label="Може, варто навчитися читати між рядків, non ? Він говорить історіями. Притчами. Якщо мовчить, то придивляйся до мови тіла.",shape=box,color=blue];
		j203817571 -> j2767456722;
	j2767456722 [label="Але тобі не байдуже, ти хочеш допомогти йому… і я впевнена, що він це знає. О ! Ось і він. Знаєш, Ліон наче вуличний пес зі шрамами на тілі. Рани загоїли, але неправильно. Тож усе досі болить і свербить.",shape=box,color=blue];
		j2767456722 -> j918947997;
	j2933062965 [label="Зажди, зажди. Мені не потрібні твої втручання!",shape=box,color=red];
		j2933062965 -> j4240591844;
	j965356766 [label="Мені варто непокоїтися?",shape=box,color=red];
		j965356766 -> j4240591844;
	j1012126371 [label="Допомога мені не завадить.",shape=box,color=red];
		j1012126371 -> j2191006618;
	j1416347182 [label="Знаєш, він наче вуличний пес зі шрамами на тілі. Рани загоїли, але неправильно. Тож усе досі болить і свербить.",shape=box,color=blue];
		j1416347182 -> j918947997;
	j1160939585 [label="Merci. Це все, що я можу просити. À bientôt.",shape=box,color=blue];
		j1160939585 -> "Chat ends.";
	j2182893633 [label="+20 Chemistry",color=orange];
		j2182893633 -> j1988803247;
	j1318566387 [label="+20 Chemistry",color=orange];
		j1318566387 -> j114490882;
	j2767069790 [label="Check boolean MarieBackstory1",color=orange];
		j2767069790 -> j1268125164 [label=true,color=green];
		j2767069790 -> j3908023039 [label=false,color=brown];
	j918947997 [label="Він вигризає там, де болить. Хоча це й розкриває рани й приносить більше болю, та також дає полегшення.",shape=box,color=blue];
		j918947997 -> j979895637;
	j4240591844 [label="Ха ! Уже занадто пізно. Marie, au travail ! Il y a de l'amour dans l'air !",shape=box,color=blue];
		j4240591844 -> "Chat ends.";
	j2191006618 [label="Oui ! Тобі все одно не вдалося б мене зупинити за всього бажання. Що ж, Марі, до роботи !",shape=box,color=blue];
		j2191006618 -> "Chat ends.";
	j1988803247 [label="Oui, звісно. À bientôt.",shape=box,color=blue];
		j1988803247 -> "Chat ends.";
	j114490882 [label="Oui, звісно.",shape=box,color=blue];
		j114490882 -> j1416347182;
	j1268125164 [label="Ти знаєш як починалася моя історія. Але є частина, про яку я не розповідала.",shape=box,color=blue];
		j1268125164 -> j2995011266;
	j3908023039 [label="Boolean MarieBackstory1 is now true.",color=orange];
		j3908023039 -> j190031088;
	j979895637 [label="Йому болить, але біль — частина його. Це все він цілком. І якщо ти наблизишся avec colère, не проявиш ніжності й обережності — він здригнеться від доторку.",shape=box,color=blue];
		j979895637 -> j138516046;
	j2995011266 [label="Я розповідала, що жебракувала на вулицях, коли була jeune fille. І життя було доволі непоганим, було багато друзів.",shape=box,color=blue];
		j2995011266 -> j2110602570;
	j190031088 [label="Я народилася в заможній родині. Певно, це може тебе здивувати. Bourgeois. Це клас, який радше ближчий до орокінів.",shape=box,color=blue];
		j190031088 -> j1388969170;
	j138516046 [label="Треба заслужити довіру вуличної тварини. Розумієш, нехай сам підійде, non ? Я доступно пишу ?",shape=box,color=blue];
		j138516046 -> j1223214492;
		j138516046 -> j512921650;
		j138516046 -> j291242658;
	j2110602570 [label="Одним із них був набагато старший юнак, на ім’я Гюґо.",shape=box,color=blue];
		j2110602570 -> j637652052;
	j1388969170 [label="Але… я народилася деформованою… з mes pieds tordus et inutilisables. І ma mère не змогла цього прийняти.",shape=box,color=blue];
		j1388969170 -> j1635005508;
	j1223214492 [label="Так, насправді. Дякую.",shape=box,color=red];
		j1223214492 -> j3361318473;
	j512921650 [label="Навіть більше, аніж здається. Дякую.",shape=box,color=red];
		j512921650 -> j2030734257;
	j291242658 [label="Ні. Але дякую за намагання.",shape=box,color=red];
		j291242658 -> j3122647261;
	j637652052 [label="Він був здорованем, як ватажок зграї. І завжди пильнував, щоб до мене ніхто не чіплявся. І щоб у мене було все потрібне.",shape=box,color=blue];
		j637652052 -> j4129654821;
	j1635005508 [label="Має ж бути вигляд, якого треба дотримуватися, oui ? Стандарти.",shape=box,color=blue];
		j1635005508 -> j2960904263;
	j3361318473 [label="Bien ! Бо я переживала, що мої метафори знову повели не туди.",shape=box,color=blue];
		j3361318473 -> j458482570;
	j2030734257 [label="Марі і її метафори. Ох, bon.",shape=box,color=blue];
		j2030734257 -> j458482570;
	j3122647261 [label="Mince alors. Я підозрювала, що мої métaphores геть будуть недоречними.",shape=box,color=blue];
		j3122647261 -> j458482570;
	j4129654821 [label="Він навіть допоміг мені зробити des béquilles… ти напевно назвеш їх… як це… милицями ? Дерев’яки, за допомогою яких я могла себе підтягувати й пересуватися.",shape=box,color=blue];
		j4129654821 -> j3853079702;
	j2960904263 [label="То що ж зробили з бідолашною потворною Марі ? Вивезли на вулиці la Cité de la Lumière, де дитину чекала б беззаперечна смерть…",shape=box,color=blue];
		j2960904263 -> j2123679814;
	j458482570 [label="Гм. Мені спало на думку, що опис Ліона, як вуличного пса, може бути не найудалішим порівнянням…",shape=box,color=blue];
		j458482570 -> j1120621170;
	j3853079702 [label="Одного ранку ми йшли будити його і…",shape=box,color=blue];
		j3853079702 -> j1952250445;
	j2123679814 [label="і покинули помирати.",shape=box,color=blue];
		j2123679814 -> j3906988797;
		j2123679814 -> j1718738169;
	j1120621170 [label="Ліпше не кажи йому про це, oui ?..",shape=box,color=blue];
		j1120621170 -> j1672678032;
	j1952250445 [label="Je… Я не вдаватимуся в подробиці… Упевнена, що ти можеш здогадатися.",shape=box,color=blue];
		j1952250445 -> j1177619016;
	j3906988797 [label="Скільки тобі було років?",shape=box,color=red];
		j3906988797 -> j1212042542;
	j1718738169 [label="Твоя родина лишила тебе помирати?",shape=box,color=red];
		j1718738169 -> j711441486;
	j1672678032 [label="Boolean LyonStrayDog is now true.",color=orange];
		j1672678032 -> j2597940586;
		j1672678032 -> j2685592773;
	j1177619016 [label="Та він лишив записку. Ледь розбірливу. Він був єдиним письменним серед інших, тож я мусила зачитати текст. ",shape=box,color=blue];
		j1177619016 -> j2322862639;
	j1212042542 [label="Шість ? Сім ? Вони вважали, що за ці роки зробили все можливе в спробах зцілити мене. Наставники, які вчили мене ходити. Різні ортези. Особливе взуття.",shape=box,color=blue];
		j1212042542 -> j3674572605;
	j711441486 [label="Вони вважали, що за ці роки зробили все можливе в спробах зцілити мене. Наставники, які вчили мене ходити. Різні ортези. Особливе взуття.",shape=box,color=blue];
		j711441486 -> j3674572605;
	j2597940586 [label="Думаю, що це мило. Він теж так подумає.",shape=box,color=red];
		j2597940586 -> j758510050;
	j2685592773 [label="Твоя таємниця помре разом зі мною.",shape=box,color=red];
		j2685592773 -> j2268947025;
	j2322862639 [label="Досі пам’ятаю, як затиналася й ледь читала. Але мусила бути сильною. Бо навіть тоді знала, що я мушу — це мій обов’язок перед іншими. ",shape=box,color=blue];
		j2322862639 -> j3695465133;
	j3674572605 [label="Вони втомилися від тягаря. Тож, ледве вміючи читати й писати, я опинилася на вулиці в багнюці.",shape=box,color=blue];
		j3674572605 -> j443511328;
		j3674572605 -> j2454497281;
	j758510050 [label="Quelle horrible personne ! J'espère que votre chaise va s'effondrer et vous donner plein d'échardes douloureuses !",shape=box,color=blue];
		j758510050 -> "Chat ends.";
	j2268947025 [label="Merci ! Фух, аж від серця відлягло…",shape=box,color=blue];
		j2268947025 -> "Chat ends.";
	j3695465133 [label="Усі казали, що Гюґо завше видавався таким радісним і щасливим. Si joyeux. Завжди вітав життя гучним сміхом і брав негаразди на кпини.",shape=box,color=blue];
		j3695465133 -> j1006656635;
	j443511328 [label="Це жахливо.",shape=box,color=red];
		j443511328 -> j714426695;
	j2454497281 [label="Як тобі вдалося вціліти?",shape=box,color=red];
		j2454497281 -> j714426695;
	j1006656635 [label="Навіть коли нас гнали з вулиць чи його били кийками за крадіжку або байдикування, то видавалося, що це його не обходило.",shape=box,color=blue];
		j1006656635 -> j3559379244;
	j714426695 [label="Check boolean MarieSecretPower",color=orange];
		j714426695 -> j173823744 [label=true,color=green];
		j714426695 -> j1029873625 [label=false,color=brown];
	j3559379244 [label="Та ми ніколи не знаємо, який біль відчувають інші глибоко всередині. І з того листа я зрозуміла, що він вив і ридав у світлі Луа.",shape=box,color=blue];
		j3559379244 -> j1084076034;
	j173823744 [label="Це було… як ти кажеш… Усі незручності мають у собі таємну силу.",shape=box,color=blue];
		j173823744 -> j1029873625;
	j1029873625 [label="Те, що стало indésirable pour ma mère, зробило мене дуже популярною серед інших дітей вулиць.",shape=box,color=blue];
		j1029873625 -> j2670305951;
	j1084076034 [label="Але тепер він знайшов спокій в її обіймах. Певний час я злилася на нього. За те, що пішов. Бо інші тепер в мені шукали наставництва. А я ж гнівалася, що він покинув мене.",shape=box,color=blue];
		j1084076034 -> j3849018120;
	j2670305951 [label="Що може бути більш pathétique, аніж дитя без pieds, oui ? Я за день могла нажебракувати більше, аніж вони всі разом награбувати за тиждень.",shape=box,color=blue];
		j2670305951 -> j2883200672;
	j3849018120 [label="Та з часом я зрозуміла одну істину.",shape=box,color=blue];
		j3849018120 -> j2078529479;
	j2883200672 [label="Я завжди ділилася. Тож мала багато друзів, які наглядали й дбали про мене. Одним із них був старший юнак, здоровань Гюґо.",shape=box,color=blue];
		j2883200672 -> j637652052;
	j2078529479 [label="Ми можемо лише пробачити іншим за те, що вони є людьми. Та пробачити собі біль, від того що вони нас покинули.",shape=box,color=blue];
		j2078529479 -> j97248151;
	j97248151 [label="Бо нам болить саме їхня відсутність. І думка, що ми вже нічим не можемо зарадити.",shape=box,color=blue];
		j97248151 -> j950882117;
	j950882117 [label="Неможливо пізнати тягар інших.",shape=box,color=blue];
		j950882117 -> j2464049273;
	j2464049273 [label="І це велика tragédie. Однак саме вона означає буття людиною.",shape=box,color=blue];
		j2464049273 -> j1075263324;
	j1075263324 [label="Не знаю, чи ця історія тобі допомогла. Але я молитимуся за те, щоб так було. Мушу йти. Монсеньйор Лойд кличе.",shape=box,color=blue];
		j1075263324 -> j4253544405;
		j1075263324 -> j4181942486;
	j4253544405 [label="Дякую, Марі.",shape=box,color=red];
