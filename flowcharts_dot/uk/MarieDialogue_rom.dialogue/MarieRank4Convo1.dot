		2022 -> 2028;
	2023 [label="Значить, і робить більше для нього, аніж балачки про те, що він повинен і не повинен робити.",shape=box,color=blue];
		2023 -> 2029;
	2024 [label="Це тому ти так прагнеш упевнитися, що Ліона не спіткає та сама доля ? Чи це просто ця тема так тебе засмучує ?",shape=box,color=blue];
		2024 -> 2030;
		2024 -> 2031;
	2025 [label="Навіть так, коли поруч із тобою хтось настільки замикається у своїх проблемах, що лишається лише подібний вихід… ",shape=box,color=blue];
		2025 -> 2024;
