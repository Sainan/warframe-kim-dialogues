		2027 -> 2035;
	2028 [label="Гм, схоже на розмову з statue de marbre, non ? Чудово розумію. Бувало таке, що доводилось хвилин двадцять захопливо щось розповідати, а потім лише усвідомити, що він не слухає.",shape=box,color=blue];
		2028 -> 2036;
	2029 [label="Може, варто навчитися читати між рядків, non ? Він говорить історіями. Притчами. Якщо мовчить, то придивляйся до мови тіла.",shape=box,color=blue];
		2029 -> 2037;
	2030 [label="Я… давай оминатимемо цю тему, будь ласка. Я не можу. ",shape=box,color=red];
		2030 -> 2038;
	2031 [label="Я маю впевнитися, що Ліон не страждає…",shape=box,color=red];
		2031 -> 2039;
	2032 [label="Я намагатимуся якнайліпше скористатися твоєю порадою. Просто складно зрозуміти, як до нього достукатися.",shape=box,color=red];
		2032 -> 2040;
