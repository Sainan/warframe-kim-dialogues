	2070 [label="Oui, звісно.",shape=box,color=blue];
		2070 -> 2060;
	2071 [label="Ти знаєш як починалася моя історія. Але є частина, про яку я не розповідала.",shape=box,color=blue];
		2071 -> 2077;
	2072 [label="Update boolean MarieBackstory1",color=orange];
		2072 -> 2078;
	2073 [label="Йому болить, але біль — частина його. Це все він цілком. І якщо ти наблизишся avec colère, не проявиш ніжності й обережності — він здригнеться від доторку.",shape=box,color=blue];
		2073 -> 2079;
	2074 [label="Chat ends.",color=orange];
	2075 [label="Chat ends.",color=orange];
	2076 [label="Chat ends.",color=orange];
	2077 [label="Я розповідала, що жебракувала на вулицях, коли була jeune fille. І життя було доволі непоганим, було багато друзів.",shape=box,color=blue];
		2077 -> 2080;
	2078 [label="Я народилася в заможній родині. Певно, це може тебе здивувати. Bourgeois. Це клас, який радше ближчий до орокінів.",shape=box,color=blue];
		2078 -> 2081;
	2079 [label="Треба заслужити довіру вуличної тварини. Розумієш, нехай сам підійде, non ? Я доступно пишу ?",shape=box,color=blue];
		2079 -> 2082;
		2079 -> 2083;
		2079 -> 2084;
	2080 [label="Одним із них був набагато старший юнак, на ім’я Гюґо.",shape=box,color=blue];
		2080 -> 2085;
	2081 [label="Але… я народилася деформованою… з mes pieds tordus et inutilisables. І ma mère не змогла цього прийняти.",shape=box,color=blue];
		2081 -> 2086;
	2082 [label="Так, насправді. Дякую.",shape=box,color=red];
		2082 -> 2087;
	2083 [label="Навіть більше, аніж здається. Дякую.",shape=box,color=red];
		2083 -> 2088;
	2084 [label="Ні. Але дякую за намагання.",shape=box,color=red];
		2084 -> 2089;
	2085 [label="Він був здорованем, як ватажок зграї. І завжди пильнував, щоб до мене ніхто не чіплявся. І щоб у мене було все потрібне.",shape=box,color=blue];
		2085 -> 2090;
	2086 [label="Має ж бути вигляд, якого треба дотримуватися, oui ? Стандарти.",shape=box,color=blue];
		2086 -> 2091;
	2087 [label="Bien ! Бо я переживала, що мої метафори знову повели не туди.",shape=box,color=blue];
		2087 -> 2092;
	2088 [label="Марі і її метафори. Ох, bon.",shape=box,color=blue];
		2088 -> 2092;
	2089 [label="Mince alors. Я підозрювала, що мої métaphores геть будуть недоречними.",shape=box,color=blue];
		2089 -> 2092;
	2090 [label="Він навіть допоміг мені зробити des béquilles… ти напевно назвеш їх… як це… милицями ? Дерев’яки, за допомогою яких я могла себе підтягувати й пересуватися.",shape=box,color=blue];
		2090 -> 2093;
	2091 [label="То що ж зробили з бідолашною потворною Марі ? Вивезли на вулиці la Cité de la Lumière, де дитину чекала б беззаперечна смерть…",shape=box,color=blue];
		2091 -> 2094;
	2092 [label="Гм. Мені спало на думку, що опис Ліона, як вуличного пса, може бути не найудалішим порівнянням…",shape=box,color=blue];
		2092 -> 2095;
	2093 [label="Одного ранку ми йшли будити його і…",shape=box,color=blue];
		2093 -> 2096;
	2094 [label="і покинули помирати.",shape=box,color=blue];
		2094 -> 2097;
		2094 -> 2098;
	2095 [label="Ліпше не кажи йому про це, oui ?..",shape=box,color=blue];
		2095 -> 2099;
	2096 [label="Je… Я не вдаватимуся в подробиці… Упевнена, що ти можеш здогадатися.",shape=box,color=blue];
		2096 -> 2100;
	2097 [label="Скільки тобі було років?",shape=box,color=red];
		2097 -> 2101;
	2098 [label="Твоя родина лишила тебе помирати?",shape=box,color=red];
		2098 -> 2102;
	2099 [label="Update boolean LyonStrayDog",color=orange];
		2099 -> 2103;
		2099 -> 2104;
	2100 [label="Та він лишив записку. Ледь розбірливу. Він був єдиним письменним серед інших, тож я мусила зачитати текст. ",shape=box,color=blue];
		2100 -> 2105;
	2101 [label="Шість ? Сім ? Вони вважали, що за ці роки зробили все можливе в спробах зцілити мене. Наставники, які вчили мене ходити. Різні ортези. Особливе взуття.",shape=box,color=blue];
		2101 -> 2106;
	2102 [label="Вони вважали, що за ці роки зробили все можливе в спробах зцілити мене. Наставники, які вчили мене ходити. Різні ортези. Особливе взуття.",shape=box,color=blue];
		2102 -> 2106;
	2103 [label="Думаю, що це мило. Він теж так подумає.",shape=box,color=red];
		2103 -> 2107;
	2104 [label="Твоя таємниця помре разом зі мною.",shape=box,color=red];
		2104 -> 2108;
	2105 [label="Досі пам’ятаю, як затиналася й ледь читала. Але мусила бути сильною. Бо навіть тоді знала, що я мушу — це мій обов’язок перед іншими. ",shape=box,color=blue];
		2105 -> 2109;
	2106 [label="Вони втомилися від тягаря. Тож, ледве вміючи читати й писати, я опинилася на вулиці в багнюці.",shape=box,color=blue];
		2106 -> 2110;
		2106 -> 2111;
	2107 [label="Quelle horrible personne ! J'espère que votre chaise va s'effondrer et vous donner plein d'échardes douloureuses !",shape=box,color=blue];
		2107 -> 2112;
	2108 [label="Merci ! Фух, аж від серця відлягло…",shape=box,color=blue];
		2108 -> 2113;
	2109 [label="Усі казали, що Гюґо завше видавався таким радісним і щасливим. Si joyeux. Завжди вітав життя гучним сміхом і брав негаразди на кпини.",shape=box,color=blue];
		2109 -> 2114;
	2110 [label="Це жахливо.",shape=box,color=red];
		2110 -> 2115;
	2111 [label="Як тобі вдалося вціліти?",shape=box,color=red];
		2111 -> 2115;
	2112 [label="Chat ends.",color=orange];
	2113 [label="Chat ends.",color=orange];
	2114 [label="Навіть коли нас гнали з вулиць чи його били кийками за крадіжку або байдикування, то видавалося, що це його не обходило.",shape=box,color=blue];
		2114 -> 2116;
	2115 [label="Check boolean MarieSecretPower",color=orange];
		2115 -> 2117 [label=true,color=green];
		2115 -> 2118 [label=false,color=brown];
	2116 [label="Та ми ніколи не знаємо, який біль відчувають інші глибоко всередині. І з того листа я зрозуміла, що він вив і ридав у світлі Луа.",shape=box,color=blue];
		2116 -> 2119;
	2117 [label="Це було… як ти кажеш… Усі незручності мають у собі таємну силу.",shape=box,color=blue];
		2117 -> 2118;
	2118 [label="Те, що стало indésirable pour ma mère, зробило мене дуже популярною серед інших дітей вулиць.",shape=box,color=blue];
		2118 -> 2120;
	2119 [label="Але тепер він знайшов спокій в її обіймах. Певний час я злилася на нього. За те, що пішов. Бо інші тепер в мені шукали наставництва. А я ж гнівалася, що він покинув мене.",shape=box,color=blue];
		2119 -> 2121;
	2120 [label="Що може бути більш pathétique, аніж дитя без pieds, oui ? Я за день могла нажебракувати більше, аніж вони всі разом награбувати за тиждень.",shape=box,color=blue];
		2120 -> 2122;
	2121 [label="Та з часом я зрозуміла одну істину.",shape=box,color=blue];
		2121 -> 2123;
	2122 [label="Я завжди ділилася. Тож мала багато друзів, які наглядали й дбали про мене. Одним із них був старший юнак, здоровань Гюґо.",shape=box,color=blue];
		2122 -> 2085;
	2123 [label="Ми можемо лише пробачити іншим за те, що вони є людьми. Та пробачити собі біль, від того що вони нас покинули.",shape=box,color=blue];
		2123 -> 2124;
	2124 [label="Бо нам болить саме їхня відсутність. І думка, що ми вже нічим не можемо зарадити.",shape=box,color=blue];
		2124 -> 2125;
	2125 [label="Неможливо пізнати тягар інших.",shape=box,color=blue];
		2125 -> 2126;
	2126 [label="І це велика tragédie. Однак саме вона означає буття людиною.",shape=box,color=blue];
		2126 -> 2127;
	2127 [label="Не знаю, чи ця історія тобі допомогла. Але я молитимуся за те, щоб так було. Мушу йти. Монсеньйор Лойд кличе.",shape=box,color=blue];
		2127 -> 2128;
		2127 -> 2129;
	2128 [label="Дякую, Марі.",shape=box,color=red];
		2128 -> 2130;
	2129 [label="[Мовчати]",shape=box,color=red];
		2129 -> 2131;
	2130 [label="+20 Chemistry",color=orange];
		2130 -> 2132;
	2131 [label="+20 Chemistry",color=orange];
		2131 -> 2133;
	2132 [label="Завжди будь ласка. À bientôt.",shape=box,color=blue];
		2132 -> 2134;
	2133 [label="À la revoyure.",shape=box,color=blue];
		2133 -> 2135;
	2134 [label="Chat ends.",color=orange];
	2135 [label="Chat ends.",color=orange];
}