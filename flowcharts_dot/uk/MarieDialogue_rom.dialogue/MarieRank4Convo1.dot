		2054 -> 2064;
	2055 [label="Може, варто навчитися читати між рядків, non ? Він говорить історіями. Притчами. Якщо мовчить, то придивляйся до мови тіла.",shape=box,color=blue];
		2055 -> 2056;
	2056 [label="Але тобі не байдуже, ти хочеш допомогти йому… і я впевнена, що він це знає. О ! Ось і він. Знаєш, Ліон наче вуличний пес зі шрамами на тілі. Рани загоїли, але неправильно. Тож усе досі болить і свербить.",shape=box,color=blue];
