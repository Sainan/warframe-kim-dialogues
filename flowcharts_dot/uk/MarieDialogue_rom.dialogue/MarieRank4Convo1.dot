		1966 -> 1970;
	1967 [label="Але я намагаюся зі всіх сил. Припускаю, що ти питаєш, бо непокоїшся ?",shape=box,color=blue];
		1967 -> 1971;
		1967 -> 1972;
	1968 [label="Вірю, що навіть твоя l'Indifférence не змогла б обдурити його й змусити замахнутися на мене з насиллям.",shape=box,color=blue];
