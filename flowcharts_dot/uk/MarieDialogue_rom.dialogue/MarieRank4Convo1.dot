		1982 -> 1986;
	1983 [label="Ні, я переживаю за нього. Мене непокоїть лише думка, що в мить потреби його не буде поруч.",shape=box,color=red];
		1983 -> 1979;
	1984 [label="Я просто маю знати, чи можу розраховувати на нього. Чи ні. Чи він уже й так занадто зломлений.",shape=box,color=red];
