	"MarieRank3Convo3 begins." [color=orange];
		"MarieRank3Convo3 begins." -> j336195646;
	j336195646 [label="Boolean MarieLyonAvailable is now true.",color=orange];
		j336195646 -> j971302504;
	j971302504 [label="Check boolean MarieGraveyard1",color=orange];
		j971302504 -> j3816065884 [label=true,color=green];
		j971302504 -> j800684238 [label=true,color=green];
		j971302504 -> j1478915251 [label=true,color=green];
		j971302504 -> j2380892255 [label=false,color=brown];
		j971302504 -> j800684238 [label=false,color=brown];
		j971302504 -> j1478915251 [label=false,color=brown];
	j3816065884 [label="Розповіси мені більше про те, як було жити в катедральному соборі? До того, як там з’явився Ентраті?",shape=box,color=red];
		j3816065884 -> j3309697253;
	j800684238 [label="Марі, де ти виросла?",shape=box,color=red];
		j800684238 -> j2629960903;
	j1478915251 [label="[Завершити розмову]",shape=box,color=red];
		j1478915251 -> "Chat ends.";
	j2380892255 [label="Яким було твоє життя у катедральному соборі до появи Ентраті?",shape=box,color=red];
		j2380892255 -> j2041649305;
	j3309697253 [label="Самотньо… гадаю, це найправдивіша відповідь. У мене був Ліон, але ж ти знаєш яким він іноді може бути. О ! До речі, я дуже рада, що ви з ним уже балакаєте !",shape=box,color=blue];
		j3309697253 -> j3800426321;
	j2629960903 [label="Boolean MarieBackstory1 is now true.",color=orange];
		j2629960903 -> j211430986;
	"Chat ends." [color=orange];
	j2041649305 [label="Ох. Я не знаю, чого це тебе так сильно цікавить, але таки розповім — потішу твою допитливість. ",shape=box,color=blue];
		j2041649305 -> j2017395483;
	j3800426321 [label="Boolean MarieGraveyard2 is now true.",color=orange];
		j3800426321 -> j941546739;
	j211430986 [label="Я думала, що мій акцент та мова видають, але тепер згадала, що ти не з мого світу, наскільки я це розумію тепер. Ха !",shape=box,color=blue];
		j211430986 -> j1888461623;
	j2017395483 [label="Я жила, виконуючи обов’язки сестри Сола. Чистила посуд для причастя, розставляла жертовники для парафіян. ",shape=box,color=blue];
		j2017395483 -> j455939700;
	j941546739 [label="Але це не тому я проводжу стільки часу за розмовами з мерцями.",shape=box,color=blue];
		j941546739 -> j710766088;
	j1888461623 [label="Я з la Cité de la Lumière — це capitol країни, яка зветься Ґоллі. Щоби показати в масштабах планети, то це недалеко від Голвенії на мапі.",shape=box,color=blue];
		j1888461623 -> j458036175;
	j455939700 [label="Доглядала за криптою та поховальними ділянками. Це було моє улюблене заняття.",shape=box,color=blue];
		j455939700 -> j3089524676;
		j455939700 -> j520615704;
	j710766088 [label="Boolean MarieGraveyard2 is now true.",color=orange];
		j710766088 -> j4158208165;
	j458036175 [label="Цікаво, а мій Cathédrale досі стоїть у 1999-му ? Овва, яка цікава думка !",shape=box,color=blue];
		j458036175 -> j627755312;
		j458036175 -> j3294576007;
	j3089524676 [label="А чому воно було твоїм улюбленим?",shape=box,color=red];
		j3089524676 -> j1444921423;
	j520615704 [label="Мені шкода. Але чому так?",shape=box,color=red];
		j520615704 -> j2562141234;
	j4158208165 [label="У тих місцях є своєрідний спокій, tranquillité. Там так тихо. Мирно.",shape=box,color=blue];
		j4158208165 -> j1117714062;
	j627755312 [label="А ти полюбляєш перестрибувати з теми на тему, чи не так?",shape=box,color=red];
		j627755312 -> j1009733613;
	j3294576007 [label="Ну я можу спитати двох своїх друзів. Вони чимало подорожували. Мені здається, вони наче й згадували відвідини того міста.",shape=box,color=red];
		j3294576007 -> j2047672719;
	j1444921423 [label="Я неймовірно насолоджувалася розмовами зі спочилими. Вони вислуховували всі мої сумніви й скарги без жодного слова осуду.",shape=box,color=blue];
		j1444921423 -> j3848657010;
	j2562141234 [label="Я мала доглядати за мертвими у Cathédrale. Змітала пил з підлоги крипт, прибирала бур’яни між плитами цвинтаря.",shape=box,color=blue];
		j2562141234 -> j1444921423;
	j1117714062 [label="Гадаю, мені подобалося розповідати їм про свої клопоти et les activités des autres, бо їхні вже позаду, oui ?",shape=box,color=blue];
		j1117714062 -> j1035356001;
	j1009733613 [label="+5 Chemistry",color=orange];
		j1009733613 -> j130311290;
	j2047672719 [label="+5 Chemistry",color=orange];
		j2047672719 -> j4031420866;
	j3848657010 [label="Ну, вони не відповідали, mais cela me convenait tout à fait ! І було би непогано, якби вони й надалі лишалися мовчазними.",shape=box,color=blue];
		j3848657010 -> j3235351915;
	j1035356001 [label="Наразі їм усе це мало здаватися таким дріб’язковим… і це мене влаштовувало.",shape=box,color=blue];
		j1035356001 -> j331503874;
		j1035356001 -> j2105925649;
		j1035356001 -> j3207465267;
	j130311290 [label="О, нарешті це помітили. Ліон дражнить мене весь час цим. Каже, що я пилинка в сонячних променях, яку вітерець несе, куди забажає. Я дуже рада, що ви двоє нарешті спілкуєтеся !",shape=box,color=blue];
		j130311290 -> j22227732;
	j4031420866 [label="Ай, не треба їх турбувати. Це просто дурна думка заскочила. Я не знаю наскільки мені буде сумно дізнатися, що там вже нічого немає.",shape=box,color=blue];
		j4031420866 -> j22227732;
	j3235351915 [label="+5 Chemistry",color=orange];
		j3235351915 -> j3962218144;
	j331503874 [label="Я не знаю… я… боюся насправді померти. Ніколи подобалася близькість смерті.",shape=box,color=red];
		j331503874 -> j2752827117;
	j2105925649 [label="Ніколи не доводилося думати про це з такої перспективи.",shape=box,color=red];
		j2105925649 -> j2548540382;
	j3207465267 [label="Відвідини цвинтарів та кладовищ мені приносять такий же спокій. Я чудово тебе розумію.",shape=box,color=red];
		j3207465267 -> j870543303;
	j22227732 [label="Я ж можу просто цікавитися, non ? Просто хочу знати tout ce qui existe, що можна знати. Гадаю, саме тому ми мали зустрітися з le Cardinal.",shape=box,color=blue];
		j22227732 -> j584079150;
	j3962218144 [label="Можеш уявити ? Балакучі черепи, геть як твій некралойд ! Ха !",shape=box,color=blue];
		j3962218144 -> j2334736599;
		j3962218144 -> j1158729698;
	j2752827117 [label="Я знаю, маленька хвороблива Марі ! Така дивакувата. Але ж кожному своє, non ?",shape=box,color=blue];
		j2752827117 -> j1696958894;
	j2548540382 [label="І не тільки ти. Ми не дуже любимо проводити час за роздумами про те, що буде потім. Аж допоки потім не стає занадто близьким.",shape=box,color=blue];
		j2548540382 -> j2560770132;
	j870543303 [label="Я така рада, що ти розумієш !",shape=box,color=blue];
		j870543303 -> j2560770132;
	j584079150 [label="Où en étais-je ? Ah ! Oui. Моя історія.",shape=box,color=blue];
		j584079150 -> j169450681;
	j2334736599 [label="Певно це було не найлегше заняття, враховуючи твоє крісло.",shape=box,color=red];
		j2334736599 -> j3298315845;
	j1158729698 [label="У тебе не було інших друзів з ким можна поговорити?",shape=box,color=red];
		j1158729698 -> j2651343684;
	j1696958894 [label="Ну хтось же має доглядати їх. А я була більш ніж рада робити це.",shape=box,color=blue];
		j1696958894 -> j2560770132;
	j2560770132 [label="Ліон жартував, що я близько до землі, тож тому стільки думок про могили.",shape=box,color=blue];
		j2560770132 -> j3442043938;
	j169450681 [label="Я народилася в заможній родині. Певно, це може тебе здивувати. Bourgeois. Це клас, який радше ближчий до орокінів.",shape=box,color=blue];
		j169450681 -> j1105305340;
	j3298315845 [label="Ні, зовсім ні. Але Ліон допомагав мені підійматися та спускатися сходами crypte, коли приходив час. А все інше я якось поволі сама.",shape=box,color=blue];
		j3298315845 -> j3676006791;
	j2651343684 [label="Boolean MarieGraveyard1 is now true.",color=orange];
		j2651343684 -> j1872724704;
	j3442043938 [label="Натомість питала чи не порожня його макітра, бо чого ж у ній стільки примар ?",shape=box,color=blue];
		j3442043938 -> j2297183234;
	j1105305340 [label="Але під час народження… я народилася деформованою… з mes pieds tordus et inutilisables. І ma mère не змогла цього прийняти.",shape=box,color=blue];
		j1105305340 -> j953383437;
	j3676006791 [label="Дуже вражає чого можна досягти за допомогою впертості, oui ?",shape=box,color=blue];
		j3676006791 -> j3747956736;
	j1872724704 [label="Звісно, у мене ж був Ліон. Але ти бачиш, як добре це іноді працює.",shape=box,color=blue];
		j1872724704 -> j710766088;
	j2297183234 [label="Тоді він погрожував зіштовхнути мене з пагорба, а я казала, що напхаю в рясу кропиви.",shape=box,color=blue];
		j2297183234 -> j1118776134;
	j953383437 [label="Має ж бути вигляд, якого треба дотримуватися, oui ? Стандарти.",shape=box,color=blue];
		j953383437 -> j488935029;
	j3747956736 [label="Ну…. упертості й сильної верхньої частини тіла, ха !",shape=box,color=blue];
		j3747956736 -> j2970753707;
	j1118776134 [label="La famille.",shape=box,color=blue];
		j1118776134 -> j2146768513;
		j1118776134 -> j3379508487;
		j1118776134 -> j962248232;
		j1118776134 -> j2699718131;
	j488935029 [label="То що ж зробили з бідолашною потворною Марі ? Вивезли на вулиці la Cité de la Lumière, де дитину чекала б беззаперечна смерть…",shape=box,color=blue];
		j488935029 -> j2511065125;
	j2970753707 [label="Boolean MarieGraveyard1 is now true.",color=orange];
		j2970753707 -> j710766088;
	j2146768513 [label="Мені шкода, що Ентраті зіпсував усе, що в тебе було.",shape=box,color=red];
		j2146768513 -> j3106201849;
	j3379508487 [label="Мене тішить, що ви були одне в одного.",shape=box,color=red];
		j3379508487 -> j4053502939;
	j962248232 [label="Ви двоє змушуєте мене всміхатися.",shape=box,color=red];
		j962248232 -> j3353989414;
	j2699718131 [label="Тож ви з ним… ну… той… ніколи не той?",shape=box,color=red];
		j2699718131 -> j950474972;
	j2511065125 [label="і покинули помирати.",shape=box,color=blue];
		j2511065125 -> j800814086;
		j2511065125 -> j3952106405;
	j3106201849 [label="+10 Chemistry",color=orange];
		j3106201849 -> j1783380064;
	j4053502939 [label="+20 Chemistry",color=orange];
		j4053502939 -> j13066997;
	j3353989414 [label="+20 Chemistry",color=orange];
		j3353989414 -> j1210417619;
	j950474972 [label="Та Соле милий ! Non ! Він же мені як брат. У всіх сенсах, окрім кревного. І від цієї думки я complètement dégoûtée !",shape=box,color=blue];
		j950474972 -> j369557163;
		j950474972 -> j1341962474;
	j800814086 [label="Твоя родина лишила тебе помирати?",shape=box,color=red];
		j800814086 -> j2004207335;
	j3952106405 [label="Скільки тобі було років?",shape=box,color=red];
		j3952106405 -> j1769538106;
	j1783380064 [label="Ентраті нічого не зіпсував. Ми з Ліоном такі ж сильні, як і були. Просто дещо змінилося, от і все, non ?",shape=box,color=blue];
		j1783380064 -> j3825983784;
	j13066997 [label="Без нього я би нікуди не дісталася. Хіба що до підніжжя пагорба. Ха !",shape=box,color=blue];
		j13066997 -> j2361190202;
	j1210417619 [label="Він дивними способами смішить мене. Але знаєш, вовченя. Ти теж. Я почуваюся дедалі щасливішою у цьому місці.",shape=box,color=blue];
		j1210417619 -> j475349989;
	j369557163 [label="Та то я так, просто питаю. З цікавості.",shape=box,color=red];
		j369557163 -> j3385888755;
	j1341962474 [label="Маю визнати, мені відлягло від серця.",shape=box,color=red];
		j1341962474 -> j1335227973;
	j2004207335 [label="Вони вважали, що за ці роки зробили все можливе в спробах зцілити мене. Наставники, які вчили мене ходити. Різні ортези. Особливе взуття.",shape=box,color=blue];
		j2004207335 -> j1742066789;
	j1769538106 [label="Шість ? Сім ? Вони вважали, що за ці роки зробили все можливе в спробах зцілити мене. Наставники, які вчили мене ходити. Різні ортези. Особливе взуття.",shape=box,color=blue];
		j1769538106 -> j1742066789;
	j3825983784 [label="Луа непостійна, мінлива. Навіть Сол, яким би постійним не здавався, піддається впливу на свою орбіту.",shape=box,color=blue];
		j3825983784 -> j2682206491;
	j2361190202 [label="Він мій істинний брат по духу. Я почуваюся дедалі щасливішою в цьому місці.",shape=box,color=blue];
		j2361190202 -> j475349989;
	j475349989 [label="Я лише сподіваюся на те, що невдовзі й він почуватиметься так само… але диявол переслідує його й нашіптує всілякі брехні й паскудства.",shape=box,color=blue];
		j475349989 -> j2640187994;
	j3385888755 [label="+10 Chemistry",color=orange];
		j3385888755 -> j1930259134;
	j1335227973 [label="Check boolean DrifterMarie",color=orange];
		j1335227973 -> j2489540700 [label=true,color=green];
		j1335227973 -> j39960898 [label=false,color=brown];
	j1742066789 [label="Вони втомилися від тягаря. Тож, ледве вміючи читати й писати, я опинилася на вулиці в багнюці.",shape=box,color=blue];
		j1742066789 -> j2490094863;
		j1742066789 -> j3229753079;
	j2682206491 [label="Вовченя, ми маємо бути гнучкими на своєму шляху, бо інакше нас зламають. Окрім того, я почуваюся дедалі щасливішою в цьому місці.",shape=box,color=blue];
		j2682206491 -> j475349989;
	j2640187994 [label="Бемсь ! Згадай диявола, то він і явиться. Мушу йти.",shape=box,color=blue];
		j2640187994 -> "Chat ends.";
	j1930259134 [label="Check boolean DrifterMarie",color=orange];
		j1930259134 -> j2318207008 [label=true,color=green];
		j1930259134 -> j2335335404 [label=false,color=brown];
	j2489540700 [label="Oui. Твої наміри були написані зрозумілими словами. Попереджаю, я його не покину. Я знаю Ліона набагато довше, аніж знаю тебе.",shape=box,color=blue];
		j2489540700 -> j2335335404;
	j39960898 [label="Oui ? А на кого з нас ти… полюєш ?",shape=box,color=blue];
		j39960898 -> j2935440232;
		j39960898 -> j1987738224;
	j2490094863 [label="Як тобі вдалося вціліти?",shape=box,color=red];
		j2490094863 -> j251854413;
	j3229753079 [label="Це жахливо.",shape=box,color=red];
		j3229753079 -> j251854413;
	j2318207008 [label="Oui. З простої «цікавості». Ти мене не надуриш. Попереджаю, я його не покину. Я знаю Ліона набагато довше, аніж знаю тебе.",shape=box,color=blue];
		j2318207008 -> j2335335404;
	j2335335404 [label="+20 Chemistry",color=orange];
		j2335335404 -> j1118023425;
	j2935440232 [label="На тебе.",shape=box,color=red];
		j2935440232 -> j3732541825;
	j1987738224 [label="На Ліона.",shape=box,color=red];
		j1987738224 -> j174077493;
	j251854413 [label="Check boolean MarieSecretPower",color=orange];
		j251854413 -> j3074796471 [label=true,color=green];
		j251854413 -> j4187426199 [label=false,color=brown];
	j1118023425 [label="Без нього я би нікуди не дісталася. Хіба що до підніжжя пагорба. Ха !",shape=box,color=blue];
		j1118023425 -> j2835208525;
	j3732541825 [label="Boolean DrifterMarie is now true.",color=orange];
		j3732541825 -> j194330709;
	j174077493 [label="Vraiment ?!",shape=box,color=blue];
		j174077493 -> j4094412404;
	j3074796471 [label="Це було… як ти кажеш… Усі незручності мають у собі таємну силу.",shape=box,color=blue];
		j3074796471 -> j4187426199;
	j4187426199 [label="Те, що стало indésirable pour ma mère, зробило мене дуже популярною серед інших дітей вулиць.",shape=box,color=blue];
		j4187426199 -> j4217280679;
	j2835208525 [label="Однак, ти інтригуєш мене, вовченя. Я почуваюся дедалі щасливішою в цьому місці.",shape=box,color=blue];
		j2835208525 -> j475349989;
	j194330709 [label="+10 Chemistry",color=orange];
		j194330709 -> j3044186196;
	j4094412404 [label="+10 Chemistry",color=orange];
		j4094412404 -> j486094593;
	j4217280679 [label="Що може бути більш pathétique, аніж дитя без pieds, oui ? Я за день могла нажебракувати більше, аніж вони всі разом награбувати за тиждень.",shape=box,color=blue];
		j4217280679 -> j1739139005;
	j3044186196 [label="Oh ! Par Sol. Це було дуже зненацька для мене. І тепер я тут сиджу червона, як бурячок, ховаю обличчя від монсеньйора Лойда…",shape=box,color=blue];
		j3044186196 -> j2476364137;
	j486094593 [label="Ти не уявляєш наскільки це мене радує, але дуже прошу обдумати свої слова.",shape=box,color=blue];
		j486094593 -> j1083067832;
	j1739139005 [label="І саме це привело до того, що мене на вулиці помітила одна з les Sœurs de Sol. Вони запропонували забрати мене.",shape=box,color=blue];
		j1739139005 -> j3916798547;
		j1739139005 -> j3008868761;
	j2476364137 [label="Попереджаю, я його не покину. Я знаю Ліона набагато довше, аніж знаю тебе.",shape=box,color=blue];
		j2476364137 -> j1599089567;
	j1083067832 [label="Boolean DrifterLyon is now true.",color=orange];
		j1083067832 -> j4120835565;
	j3916798547 [label="А що з іншими дітьми?",shape=box,color=red];
		j3916798547 -> j3631446481;
	j3008868761 [label="Очевидно, що ти погодилася.",shape=box,color=red];
		j3008868761 -> j1112652914;
	j1599089567 [label="+10 Chemistry",color=orange];
		j1599089567 -> j475349989;
	j4120835565 [label="Ліон — мій брат. Я люблю його більше, аніж ти можеш собі уявити, але він не простий, проблемний. Дуже ретельно добирай слова, перш ніж домагатимешся його, n'est-ce pas ?",shape=box,color=blue];
		j4120835565 -> j1578901084;
	j3631446481 [label="+5 Chemistry",color=orange];
		j3631446481 -> j83357205;
	j1112652914 [label="Oui, а що ж іще лишалося робити ? Я будь-якої миті могла захворіти. Знала це, попри те, що була enfant.",shape=box,color=blue];
		j1112652914 -> j1355022565;
		j1112652914 -> j1049469441;
	j1578901084 [label="Гадаю, ми невдовзі знову це обговоримо. Не зрозумій мене хибно, я не проти ! Просто хочу, щоби в тебе був час все ретельно обміркувати.",shape=box,color=blue];
		j1578901084 -> j1599089567;
	j83357205 [label="У тебе таке добре серце. Очевидно, що вони не могли взяти всіх… але я не забула своїх друзів.",shape=box,color=blue];
		j83357205 -> j2756917602;
	j1355022565 [label="А які були сестри?",shape=box,color=red];
		j1355022565 -> j2401257757;
	j1049469441 [label="Як ти прилаштувалася до життя в катедральному соборі?",shape=box,color=red];
		j1049469441 -> j4100434887;
	j2756917602 [label="Я щотижня поверталася зі своїм заробітком та недоїдками, які могла зібрати на кухні чи в інших.",shape=box,color=blue];
		j2756917602 -> j2685245185;
	j2401257757 [label="Les Sœurs були дуже добрими до мене ! Хоча, певно розумію, чому ти думаєш про інакше, non ?",shape=box,color=blue];
		j2401257757 -> j1570977489;
	j4100434887 [label="Я обожнювала його ! Хоча розумію, чому ти думаєш про інакше, non ?",shape=box,color=blue];
		j4100434887 -> j1570977489;
	j2685245185 [label="Я дбала про них так добре, як тільки могла. Допоки вони були. Більшість померли від variole ou tuberculose…",shape=box,color=blue];
		j2685245185 -> j1385162340;
	j1570977489 [label="Триразове харчування, тепла постіль, дах над головою. І нема потреби переживати, чи не поб’ють тебе сьогодні, чи не пограбують, чи ще щось гірше ?",shape=box,color=blue];
		j1570977489 -> j2613506343;
	j1385162340 [label="Кілька подалося деінде, ще хтось загинув у бійках чи від насилля. Деякі знайшли чесну роботу й виросли. Ростили власні сім’ї.",shape=box,color=blue];
		j1385162340 -> j3661775401;
	j2613506343 [label="Мене добре вчили. Викладали євангелії Сола й Луа. Казали шукати свій шлях у вірі. Я могла піти, якби хотіла.",shape=box,color=blue];
		j2613506343 -> j3058859777;
	j3661775401 [label="А дехто взагалі навідував Cathédrale, щоби провідати мене. Це гріло моє серце.",shape=box,color=blue];
		j3661775401 -> j3058859777;
	j3058859777 [label="Тривалий час я відчувала провину за те, що мене забрали з вулиць, а інших — ні. Буває, що котрогось дня я знову її відчуваю.",shape=box,color=blue];
		j3058859777 -> j4099474087;
		j3058859777 -> j1303251637;
	j4099474087 [label="Почуваюся так само, коли згадую всіх тих, хто помер навколо мене, а мені вдалося вціліти. Але нам не варто так вчиняти із собою. Ми повинні боротися, щоб усе поліпшити, коли це можливо.",shape=box,color=red];
		j4099474087 -> j1382064651;
	j1303251637 [label="Ти зробила все можливе, щоб допомогти іншим, маючи те, що тобі було дано. Інші здійняли тебе вище й ти намагалася підійняти й інших, оскільки випала така можливість.",shape=box,color=red];
		j1303251637 -> j2680491075;
	j1382064651 [label="Це завжди буде так ? Боротьба ? Війна супроти хвиль, які намагаються потомити нас ?",shape=box,color=blue];
		j1382064651 -> j184905282;
	j2680491075 [label="Add 1 to Thermostat counter",color=orange];
		j2680491075 -> j2728816945;
	j184905282 [label="Add -1 to Thermostat counter",color=orange];
		j184905282 -> j1665293891;
	j2728816945 [label="+10 Chemistry",color=orange];
		j2728816945 -> j95976755;
	j1665293891 [label="+10 Chemistry",color=orange];
		j1665293891 -> j2081254059;
	j95976755 [label="Oui, саме так. Мене підійняли на пліт і тепер я мушу зробити так само для інших. ",shape=box,color=blue];
		j95976755 -> j3846934335;
	j2081254059 [label="Але я знаю що ти маєш на увазі. Основна думка — не здаватися. Дари мені ці дані, щоб я могла стати щитом для інших.",shape=box,color=blue];
		j2081254059 -> j3846934335;
	j3846934335 [label="Merci. Але наразі я маю йти.",shape=box,color=blue];
		j3846934335 -> "Chat ends.";
}