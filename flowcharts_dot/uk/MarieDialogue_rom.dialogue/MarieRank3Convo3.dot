digraph {
	1113 [label="MarieRank3Convo3 begins.",color=orange];
		1113 -> 3737;
	3737 [label="Update boolean MarieLyonAvailable",color=orange];
		3737 -> 1114;
	1114 [label="Check boolean MarieGraveyard1",color=orange];
		1114 -> 1115 [label=true,color=green];
		1114 -> 1117 [label=true,color=green];
		1114 -> 1118 [label=true,color=green];
		1114 -> 1116 [label=false,color=brown];
		1114 -> 1117 [label=false,color=brown];
		1114 -> 1118 [label=false,color=brown];
	1115 [label="Розповіси мені більше про те, як було жити в катедральному соборі? До того, як там з’явився Ентраті?",shape=box,color=red];
		1115 -> 1119;
	1117 [label="Марі, де ти виросла?",shape=box,color=red];
		1117 -> 2425;
	1118 [label="[Завершити розмову]",shape=box,color=red];
		1118 -> 1122;
	1116 [label="Яким було твоє життя у катедральному соборі до появи Ентраті?",shape=box,color=red];
		1116 -> 1120;
	1119 [label="Самотньо… гадаю, це найправдивіша відповідь. У мене був Ліон, але ж ти знаєш яким він іноді може бути. О ! До речі, я дуже рада, що ви з ним уже балакаєте !",shape=box,color=blue];
		1119 -> 1123;
	2425 [label="Update boolean MarieBackstory1",color=orange];
		2425 -> 1121;
	1122 [label="Chat ends.",color=orange];
	1120 [label="Ох. Я не знаю, чого це тебе так сильно цікавить, але таки розповім — потішу твою допитливість. ",shape=box,color=blue];
		1120 -> 1124;
	1123 [label="Update boolean MarieGraveyard2",color=orange];
		1123 -> 1126;
	1121 [label="Я думала, що мій акцент та мова видають, але тепер згадала, що ти не з мого світу, наскільки я це розумію тепер. Ха !",shape=box,color=blue];
		1121 -> 1125;
	1124 [label="Я жила, виконуючи обов’язки сестри Сола. Чистила посуд для причастя, розставляла жертовники для парафіян. ",shape=box,color=blue];
		1124 -> 1127;
	1126 [label="Але це не тому я проводжу стільки часу за розмовами з мерцями.",shape=box,color=blue];
		1126 -> 1129;
	1125 [label="Я з la Cité de la Lumière — це capitol країни, яка зветься Ґалія. У масштабах планети це недалеко від Голвенії.",shape=box,color=blue];
		1125 -> 1128;
	1127 [label="Доглядала за криптою та поховальними ділянками. Це було моє улюблене заняття.",shape=box,color=blue];
		1127 -> 1130;
		1127 -> 1131;
	1129 [label="Update boolean MarieGraveyard2",color=orange];
		1129 -> 1134;
	1128 [label="Цікаво, а мій Cathédrale досі стоїть у 1999-му ? Овва, яка цікава думка !",shape=box,color=blue];
		1128 -> 1132;
		1128 -> 1133;
	1130 [label="А чому воно було твоїм улюбленим?",shape=box,color=red];
		1130 -> 1135;
	1131 [label="Мені шкода. Але чому так?",shape=box,color=red];
		1131 -> 1136;
	1134 [label="У тих місцях є своєрідний спокій, tranquillité. Там так тихо. Мирно.",shape=box,color=blue];
		1134 -> 1139;
	1132 [label="А ти полюбляєш перестрибувати з теми на тему, чи не так?",shape=box,color=red];
		1132 -> 1137;
	1133 [label="Ну я можу спитати двох своїх друзів. Вони чимало подорожували. Мені здається, вони наче й згадували відвідини того міста.",shape=box,color=red];
		1133 -> 1138;
	1135 [label="Я неймовірно насолоджувалася розмовами зі спочилими. Вони вислуховували всі мої сумніви й скарги без жодного слова осуду.",shape=box,color=blue];
		1135 -> 1140;
	1136 [label="Я мала доглядати за мертвими у Cathédrale. Змітала пил з підлоги крипт, прибирала бур’яни між плитами цвинтаря.",shape=box,color=blue];
		1136 -> 1135;
	1139 [label="Гадаю, мені подобалося розповідати їм про свої клопоти et les activités des autres, бо їхні вже позаду, oui ?",shape=box,color=blue];
		1139 -> 1143;
	1137 [label="+5 Chemistry",color=orange];
		1137 -> 1141;
	1138 [label="+5 Chemistry",color=orange];
		1138 -> 1142;
	1140 [label="Ну, вони не відповідали, mais cela me convenait tout à fait ! І було би непогано, якби вони й надалі лишалися мовчазними.",shape=box,color=blue];
		1140 -> 1144;
	1143 [label="Наразі їм усе це мало здаватися таким дріб’язковим… і це мене влаштовувало.",shape=box,color=blue];
		1143 -> 1146;
		1143 -> 1147;
		1143 -> 1148;
	1141 [label="О, нарешті це помітили. Ліон дражнить мене весь час цим. Каже, що я пилинка в сонячних променях, яку вітерець несе, куди забажає. Я дуже рада, що ви двоє нарешті спілкуєтеся !",shape=box,color=blue];
		1141 -> 1145;
	1142 [label="Ай, не треба їх турбувати. Це просто дурна думка заскочила. Я не знаю наскільки мені буде сумно дізнатися, що там вже нічого немає.",shape=box,color=blue];
		1142 -> 1145;
	1144 [label="+5 Chemistry",color=orange];
		1144 -> 1149;
	1146 [label="Я не знаю… я… боюся насправді померти. Ніколи подобалася близькість смерті.",shape=box,color=red];
		1146 -> 1151;
	1147 [label="Ніколи не доводилося думати про це з такої перспективи.",shape=box,color=red];
		1147 -> 1152;
	1148 [label="Відвідини цвинтарів та кладовищ мені приносять такий же спокій. Я чудово тебе розумію.",shape=box,color=red];
		1148 -> 1153;
	1145 [label="Я ж можу просто цікавитися, non ? Просто хочу знати tout ce qui existe, що можна знати. Гадаю, саме тому ми мали зустрітися з le Cardinal.",shape=box,color=blue];
		1145 -> 1150;
	1149 [label="Можеш уявити ? Балакучі черепи, геть як твій некралойд ! Ха !",shape=box,color=blue];
		1149 -> 1154;
		1149 -> 1155;
	1151 [label="Я знаю, маленька хвороблива Марі ! Така дивакувата. Але ж кожному своє, non ?",shape=box,color=blue];
		1151 -> 1157;
	1152 [label="І не тільки ти. Ми не дуже любимо проводити час за роздумами про те, що буде потім. Аж допоки потім не стає занадто близьким.",shape=box,color=blue];
		1152 -> 1158;
	1153 [label="Я така рада, що ти розумієш !",shape=box,color=blue];
		1153 -> 1158;
	1150 [label="Où en étais-je ? Ah ! Oui. Моя історія.",shape=box,color=blue];
		1150 -> 1156;
	1154 [label="Певно це було не найлегше заняття, враховуючи твоє крісло.",shape=box,color=red];
		1154 -> 1159;
	1155 [label="У тебе не було інших друзів з ким можна поговорити?",shape=box,color=red];
		1155 -> 1160;
	1157 [label="Ну хтось же має доглядати їх. А я була більш ніж рада робити це.",shape=box,color=blue];
		1157 -> 1158;
	1158 [label="Ліон жартував, що я близько до землі, тож тому стільки думок про могили.",shape=box,color=blue];
		1158 -> 1162;
	1156 [label="Я народилася в заможній родині. Певно, це може тебе здивувати. Bourgeois. Це клас, який радше ближчий до орокінів.",shape=box,color=blue];
		1156 -> 1161;
	1159 [label="Ні, зовсім ні. Але Ліон допомагав мені підійматися та спускатися сходами crypte, коли приходив час. А все інше я якось поволі сама.",shape=box,color=blue];
		1159 -> 1163;
	1160 [label="Update boolean MarieGraveyard1",color=orange];
		1160 -> 1164;
	1162 [label="Натомість питала чи не порожня його макітра, бо чого ж у ній стільки примар ?",shape=box,color=blue];
		1162 -> 1166;
	1161 [label="Але під час народження… я народилася деформованою… з mes pieds tordus et inutilisables. І ma mère не змогла цього прийняти.",shape=box,color=blue];
		1161 -> 1165;
	1163 [label="Дуже вражає чого можна досягти за допомогою впертості, oui ?",shape=box,color=blue];
		1163 -> 1167;
	1164 [label="Звісно, у мене ж був Ліон. Але ти бачиш, як добре це іноді працює.",shape=box,color=blue];
		1164 -> 1129;
	1166 [label="Тоді він погрожував зіштовхнути мене з пагорба, а я казала, що напхаю в рясу кропиви.",shape=box,color=blue];
		1166 -> 1169;
	1165 [label="Має ж бути вигляд, якого треба дотримуватися, oui ? Стандарти.",shape=box,color=blue];
		1165 -> 1168;
	1167 [label="Ну…. упертості й сильної верхньої частини тіла, ха !",shape=box,color=blue];
		1167 -> 1170;
	1169 [label="La famille.",shape=box,color=blue];
		1169 -> 1172;
		1169 -> 1173;
		1169 -> 1174;
		1169 -> 3921;
	1168 [label="То що ж зробили з бідолашною потворною Марі ? Вивезли на вулиці la Cité de la Lumière, де дитину чекала б беззаперечна смерть…",shape=box,color=blue];
		1168 -> 1171;
	1170 [label="Update boolean MarieGraveyard1",color=orange];
		1170 -> 1129;
	1172 [label="Мені шкода, що Ентраті зіпсував усе, що в тебе було.",shape=box,color=red];
		1172 -> 1177;
	1173 [label="Мене тішить, що ви були одне в одного.",shape=box,color=red];
		1173 -> 1178;
	1174 [label="Ви двоє змушуєте мене всміхатися.",shape=box,color=red];
		1174 -> 1179;
	3921 [label="Тож ви з ним… ну… той… ніколи не той?",shape=box,color=red];
		3921 -> 3922;
	1171 [label="і покинули помирати.",shape=box,color=blue];
		1171 -> 1175;
		1171 -> 1176;
	1177 [label="+10 Chemistry",color=orange];
		1177 -> 1182;
	1178 [label="+20 Chemistry",color=orange];
		1178 -> 1183;
	1179 [label="+20 Chemistry",color=orange];
		1179 -> 1184;
	3922 [label="Та Соле милий ! Non ! Він же мені як брат. У всіх сенсах, окрім кревного. І від цієї думки я complètement dégoûtée !",shape=box,color=blue];
		3922 -> 3923;
		3922 -> 3924;
	1175 [label="Твоя родина лишила тебе помирати?",shape=box,color=red];
		1175 -> 1180;
	1176 [label="Скільки тобі було років?",shape=box,color=red];
		1176 -> 1181;
	1182 [label="Ентраті нічого не зіпсував. Ми з Ліоном такі ж сильні, як і були. Просто дещо змінилося, от і все, non ?",shape=box,color=blue];
		1182 -> 1186;
	1183 [label="Без нього я би нікуди не дісталася. Хіба що до підніжжя пагорба. Ха !",shape=box,color=blue];
		1183 -> 1187;
	1184 [label="Він дивними способами смішить мене. Але знаєш, вовченя. Ти теж. Я почуваюся дедалі щасливішою у цьому місці.",shape=box,color=blue];
		1184 -> 1188;
	3923 [label="Та то я так, просто питаю. З цікавості.",shape=box,color=red];
		3923 -> 3925;
	3924 [label="Маю визнати, мені відлягло від серця.",shape=box,color=red];
		3924 -> 3931;
	1180 [label="Вони вважали, що за ці роки зробили все можливе в спробах зцілити мене. Наставники, які вчили мене ходити. Різні ортези. Особливе взуття.",shape=box,color=blue];
		1180 -> 1185;
	1181 [label="Шість ? Сім ? Вони вважали, що за ці роки зробили все можливе в спробах зцілити мене. Наставники, які вчили мене ходити. Різні ортези. Особливе взуття.",shape=box,color=blue];
		1181 -> 1185;
	1186 [label="Луа непостійна, мінлива. Навіть Сол, яким би постійним не здавався, піддається впливу на свою орбіту.",shape=box,color=blue];
		1186 -> 1191;
	1187 [label="Він мій істинний брат по духу. Я почуваюся дедалі щасливішою в цьому місці.",shape=box,color=blue];
		1187 -> 1188;
	1188 [label="Я лише сподіваюся на те, що невдовзі й він почуватиметься так само… але диявол переслідує його й нашіптує всілякі брехні й паскудства.",shape=box,color=blue];
		1188 -> 1192;
	3925 [label="+10 Chemistry",color=orange];
		3925 -> 3926;
	3931 [label="Check boolean DrifterMarie",color=orange];
		3931 -> 3932 [label=true,color=green];
		3931 -> 3933 [label=false,color=brown];
	1185 [label="Вони втомилися від тягаря. Тож, ледве вміючи читати й писати, я опинилася на вулиці в багнюці.",shape=box,color=blue];
		1185 -> 1189;
		1185 -> 1190;
	1191 [label="Вовченя, ми маємо бути гнучкими на своєму шляху, бо інакше нас зламають. Окрім того, я почуваюся дедалі щасливішою в цьому місці.",shape=box,color=blue];
		1191 -> 1188;
	1192 [label="Бемсь ! Згадай диявола, то він і явиться. Мушу йти.",shape=box,color=blue];
		1192 -> 1194;
	3926 [label="Check boolean DrifterMarie",color=orange];
		3926 -> 3927 [label=true,color=green];
		3926 -> 3928 [label=false,color=brown];
	3932 [label="Oui. Твої наміри були написані зрозумілими словами. Попереджаю, я його не покину. Я знаю Ліона набагато довше, аніж знаю тебе.",shape=box,color=blue];
		3932 -> 3928;
	3933 [label="Oui ? А на кого з нас ти… полюєш ?",shape=box,color=blue];
		3933 -> 3934;
		3933 -> 3935;
	1189 [label="Як тобі вдалося вціліти?",shape=box,color=red];
		1189 -> 1193;
	1190 [label="Це жахливо.",shape=box,color=red];
		1190 -> 1193;
	1194 [label="Chat ends.",color=orange];
	3927 [label="Oui. З простої «цікавості». Ти мене не надуриш. Попереджаю, я його не покину. Я знаю Ліона набагато довше, аніж знаю тебе.",shape=box,color=blue];
		3927 -> 3928;
	3928 [label="+20 Chemistry",color=orange];
		3928 -> 3929;
	3934 [label="На тебе.",shape=box,color=red];
		3934 -> 3936;
	3935 [label="На Ліона.",shape=box,color=red];
		3935 -> 3941;
	1193 [label="Check boolean MarieSecretPower",color=orange];
		1193 -> 1196 [label=true,color=green];
		1193 -> 1195 [label=false,color=brown];
	3929 [label="Без нього я би нікуди не дісталася. Хіба що до підніжжя пагорба. Ха !",shape=box,color=blue];
		3929 -> 3930;
	3936 [label="Update boolean DrifterMarie",color=orange];
		3936 -> 3937;
	3941 [label="Vraiment ?!",shape=box,color=blue];
		3941 -> 3942;
	1196 [label="Це було… як ти кажеш… Усі незручності мають у собі таємну силу.",shape=box,color=blue];
		1196 -> 1195;
	1195 [label="Те, що стало indésirable pour ma mère, зробило мене дуже популярною серед інших дітей вулиць.",shape=box,color=blue];
		1195 -> 1197;
	3930 [label="Однак, ти інтригуєш мене, вовченя. Я почуваюся дедалі щасливішою в цьому місці.",shape=box,color=blue];
		3930 -> 1188;
	3937 [label="+10 Chemistry",color=orange];
		3937 -> 3938;
	3942 [label="+10 Chemistry",color=orange];
		3942 -> 3943;
	1197 [label="Що може бути більш pathétique, аніж дитя без pieds, oui ? Я за день могла нажебракувати більше, аніж вони всі разом награбувати за тиждень.",shape=box,color=blue];
		1197 -> 1198;
	3938 [label="Oh ! Par Sol. Це було дуже зненацька для мене. І тепер я тут сиджу червона, як бурячок, ховаю обличчя від монсеньйора Лойда…",shape=box,color=blue];
		3938 -> 3939;
	3943 [label="Ти не уявляєш наскільки це мене радує, але дуже прошу обдумати свої слова.",shape=box,color=blue];
		3943 -> 3944;
	1198 [label="І саме це привело до того, що мене на вулиці помітила одна з les Sœurs de Sol. Вони запропонували забрати мене.",shape=box,color=blue];
		1198 -> 1199;
		1198 -> 1200;
	3939 [label="Попереджаю, я його не покину. Я знаю Ліона набагато довше, аніж знаю тебе.",shape=box,color=blue];
		3939 -> 3940;
	3944 [label="Update boolean DrifterLyon",color=orange];
		3944 -> 3945;
	1199 [label="А що з іншими дітьми?",shape=box,color=red];
		1199 -> 1201;
	1200 [label="Очевидно, що ти погодилася.",shape=box,color=red];
		1200 -> 1202;
	3940 [label="+10 Chemistry",color=orange];
		3940 -> 1188;
	3945 [label="Ліон — мій брат. Я люблю його більше, аніж ти можеш собі уявити, але він не простий, проблемний. Дуже ретельно добирай слова, перш ніж домагатимешся його, n'est-ce pas ?",shape=box,color=blue];
		3945 -> 3946;
	1201 [label="+5 Chemistry",color=orange];
		1201 -> 1203;
	1202 [label="Oui, а що ж іще лишалося робити ? Я будь-якої миті могла захворіти. Знала це, попри те, що була enfant.",shape=box,color=blue];
		1202 -> 1204;
		1202 -> 1205;
	3946 [label="Гадаю, ми невдовзі знову це обговоримо. Не зрозумій мене хибно, я не проти ! Просто хочу, щоби в тебе був час все ретельно обміркувати.",shape=box,color=blue];
		3946 -> 3940;
	1203 [label="У тебе таке добре серце. Очевидно, що вони не могли взяти всіх… але я не забула своїх друзів.",shape=box,color=blue];
		1203 -> 1206;
	1204 [label="А які були сестри?",shape=box,color=red];
		1204 -> 1207;
	1205 [label="Як ти прилаштувалася до життя в катедральному соборі?",shape=box,color=red];
		1205 -> 1208;
	1206 [label="Я щотижня поверталася зі своїм заробітком та недоїдками, які могла зібрати на кухні чи в інших.",shape=box,color=blue];
		1206 -> 1209;
	1207 [label="Les Sœurs були дуже добрими до мене ! Хоча, певно розумію, чому ти думаєш про інакше, non ?",shape=box,color=blue];
		1207 -> 1210;
	1208 [label="Я обожнювала його ! Хоча розумію, чому ти думаєш про інакше, non ?",shape=box,color=blue];
		1208 -> 1210;
	1209 [label="Я дбала про них так добре, як тільки могла. Допоки вони були. Більшість померли від variole ou tuberculose…",shape=box,color=blue];
		1209 -> 1211;
	1210 [label="Триразове харчування, тепла постіль, дах над головою. І нема потреби переживати, чи не поб’ють тебе сьогодні, чи не пограбують, чи ще щось гірше ?",shape=box,color=blue];
		1210 -> 1212;
	1211 [label="Кілька подалося деінде, ще хтось загинув у бійках чи від насилля. Деякі знайшли чесну роботу й виросли. Ростили власні сім’ї.",shape=box,color=blue];
		1211 -> 1213;
	1212 [label="Мене добре вчили. Викладали євангелії Сола й Луа. Казали шукати свій шлях у вірі. Я могла піти, якби хотіла.",shape=box,color=blue];
		1212 -> 1214;
	1213 [label="А дехто взагалі навідував Cathédrale, щоби провідати мене. Це гріло моє серце.",shape=box,color=blue];
		1213 -> 1214;
	1214 [label="Тривалий час я відчувала провину за те, що мене забрали з вулиць, а інших — ні. Буває, що котрогось дня я знову її відчуваю.",shape=box,color=blue];
		1214 -> 1215;
		1214 -> 1216;
	1215 [label="Почуваюся так само, коли згадую всіх тих, хто помер навколо мене, а мені вдалося вціліти. Але нам не варто так вчиняти із собою. Ми повинні боротися, щоб усе поліпшити, коли це можливо.",shape=box,color=red];
		1215 -> 1217;
	1216 [label="Ти зробила все можливе, щоб допомогти іншим, маючи те, що тобі було дано. Інші здійняли тебе вище й ти намагалася підійняти й інших, оскільки випала така можливість.",shape=box,color=red];
		1216 -> 1218;
	1217 [label="Це завжди буде так ? Боротьба ? Війна супроти хвиль, які намагаються потомити нас ?",shape=box,color=blue];
		1217 -> 1219;
	1218 [label="Add 1 to Thermostat",color=orange];
		1218 -> 1220;
	1219 [label="Add -1 to Thermostat",color=orange];
		1219 -> 1221;
	1220 [label="+10 Chemistry",color=orange];
		1220 -> 1222;
	1221 [label="+10 Chemistry",color=orange];
		1221 -> 1223;
	1222 [label="Oui, саме так. Мене підійняли на пліт і тепер я мушу зробити так само для інших. ",shape=box,color=blue];
		1222 -> 1224;
	1223 [label="Але я знаю що ти маєш на увазі. Основна думка — не здаватися. Дари мені ці дані, щоб я могла стати щитом для інших.",shape=box,color=blue];
		1223 -> 1224;
	1224 [label="Merci. Але наразі я маю йти.",shape=box,color=blue];
		1224 -> 1225;
	1225 [label="Chat ends.",color=orange];
}