digraph {
	graph [fontname="Roboto Condensed"];
	node [fontname="Roboto Condensed"];
	edge [fontname="Roboto Condensed"];

	"MarieRank2Convo4 begins." [color=orange];
		"MarieRank2Convo4 begins." -> j3686888301;
		"MarieRank2Convo4 begins." -> j4209718178;
		"MarieRank2Convo4 begins." -> j1478915251;
	j3686888301 [label="Чи дозволиш спитати про Роута? Чи це викличе в тебе гнівні тиради?",shape=box,color=red];
		j3686888301 -> j3046238341;
	j4209718178 [label="Чи можу я тебе спитати про слона в кімнаті?",shape=box,color=red];
		j4209718178 -> j52616947;
	j1478915251 [label="[Завершити розмову]",shape=box,color=red];
		j1478915251 -> "Chat ends.";
	j3046238341 [label="Ce diable est un imbécile qui se croit au-dessus de tout reproche ! Je préfèrerais boire un pot de vernis à bois plutôt que de passer une minute de plus à l'écouter s'enorgueillir comme un chat qui se lèche le pelage !",shape=box,color=blue];
		j3046238341 -> j718970835;
		j3046238341 -> j791956484;
	j52616947 [label="Quoi ! Où ça ? Un éléphant ?!",shape=box,color=blue];
		j52616947 -> j1238776342;
	"Chat ends." [color=orange];
	j718970835 [label="Це було… навдивовижу пізнавально.",shape=box,color=red];
		j718970835 -> j2123728665;
	j791956484 [label="Я… припускатиму, що нічого з того не було добрим словом.",shape=box,color=red];
		j791956484 -> j1835349119;
	j1238776342 [label="Я бачу рибу, пташку і… хто б то не був, мсьє Таґфера. Я бачила чимало дивних штук у цьому святилищі, але non éléphant. Це якийсь твій жарт ?",shape=box,color=blue];
		j1238776342 -> j3911766275;
	j2123728665 [label="+5 Chemistry",color=orange];
		j2123728665 -> j3641035957;
	j1835349119 [label="+5 Chemistry",color=orange];
		j1835349119 -> j1206124536;
	j3911766275 [label="Ой! Вибач. Це був мовний зворот, якого навчили мене друзі з 1999 року… ",shape=box,color=red];
		j3911766275 -> j2668665723;
		j3911766275 -> j4260257791;
	j3641035957 [label="Merci. Це мало бути пізнавально, але я не очікувала такого запитання. Мій гнів не мав бути спрямованим на тебе, пробач.",shape=box,color=blue];
		j3641035957 -> j3218359144;
	j1206124536 [label="Ні, не було жодного. Пробач мені, це не мало бути спрямованим на тебе. ",shape=box,color=blue];
		j1206124536 -> j3218359144;
	j2668665723 [label="Це було не буквально про слона.",shape=box,color=red];
		j2668665723 -> j1139442398;
	j4260257791 [label="Тепер я розумію, чому вони вважали це доволі милим, коли бачили мою розгубленість…",shape=box,color=red];
		j4260257791 -> j2124553892;
	j3218359144 [label="Evaluate expressions",color=orange];
		j3218359144 -> j1141492976 [label="MarieRoatheWarning",color=purple];
		j3218359144 -> j1679474668 [label="DrifterRoathe",color=purple];
		j3218359144 -> j4018064878 [label="MarieRoatheSoldier",color=purple];
		j3218359144 -> j530292322 [label="false",color=purple];
	j1139442398 [label="+5 Chemistry",color=orange];
		j1139442398 -> j2151714200;
	j2124553892 [label="+5 Chemistry",color=orange];
		j2124553892 -> j2518000252;
	j1141492976 [label="Я здивована, що ти знову питаєш мене про мої думки. Твоє минуле попередження було доволі чітким. Ти не бажаєш чути, як я погано говорю про нього та йому подібних.",shape=box,color=blue];
		j1141492976 -> j1764465959;
		j1141492976 -> j3490056079;
	j1679474668 [label="Знаєш, я тобі щиро зізнаюся, що не знаю, як продовжити цю бесіду. Тебе тягне до нього, як comme un papillon vers une flamme.",shape=box,color=blue];
		j1679474668 -> j538839397;
		j1679474668 -> j1156932430;
	j4018064878 [label="Досі прагнеш знайти в ньому союзника ? Ти граєшся з вогнем, намагаючись долучити його до своєї вовчої зграї. Він радо розірве твою горлянку найнеочікуванішої миті.",shape=box,color=blue];
		j4018064878 -> j1181984437;
		j4018064878 -> j4003812974;
	j530292322 [label="Мені дивно, що з цим питанням ти звертаєшся до мене. Це ж так очевидно, що я погано думаю про того диявола.",shape=box,color=blue];
		j530292322 -> j1717477272;
		j530292322 -> j2930561422;
	j2151714200 [label="Я б не здивувалася, якби це було буквально ! Наскільки я бачу, то в цьому місці є всі ознаки ménagerie.",shape=box,color=blue];
		j2151714200 -> j3535524021;
	j2518000252 [label="Oui, дуже мило, правда ? Я часто щось скажу монсеньйору Лойду і він дивиться на мене так, наче я заскочила його абсолютно зненацька.",shape=box,color=blue];
		j2518000252 -> j1392891493;
	j1764465959 [label="Моя реакція була різкою і я перепрошую за це. Не хотілося б поки що засуджувати його за дії… я намагаюся зрозуміти його з усіх сторін.",shape=box,color=red];
		j1764465959 -> j3255771613;
	j3490056079 [label="Ні, не хочу. Він вів життя, яке складно зрозуміти. Але мені було б цікаво дізнатися про те, як ви двоє зустрілися.",shape=box,color=red];
		j3490056079 -> j1095548376;
	j538839397 [label="Я просто намагаюся знайти пояснення тому, чому він такий, який є. Я намагаюся зрозуміти його.",shape=box,color=red];
		j538839397 -> j2522317478;
	j1156932430 [label="Якщо я знатиму більше про нього, то це може допомогти мені зрозуміти, як направити його… трохи добрішим шляхом.",shape=box,color=red];
		j1156932430 -> j2888540242;
	j1181984437 [label="Я знаю. Але не можу ненавидіти його лише за те, що він робив для служіння своєму народу. Мені доводилося робити те саме.",shape=box,color=red];
		j1181984437 -> j2858860665;
	j4003812974 [label="Він один із найнебезпечніших орокінів, які колись жили в Імперії. Ми вчинили б дурість, якби відмовилися від такої допомоги.",shape=box,color=red];
		j4003812974 -> j2647674859;
	j1717477272 [label="Я знаю, але ж ти, певно, маєш мати якесь поняття стосовно його сутності. Я намагаюся ліпше зрозуміти його.",shape=box,color=red];
		j1717477272 -> j1949219167;
	j2930561422 [label="І саме тому я питаю тебе про нього. Я хочу зрозуміти його. Але не дуже довіряю викладеному ним варіанту розповіді.",shape=box,color=red];
		j2930561422 -> j853367984;
	j3535524021 [label="А що означає цей вираз ? Якщо в кімнаті є слон, то чому б це нам не говорити про нього ?",shape=box,color=blue];
		j3535524021 -> j1600471176;
	j1392891493 [label="І, вважаючи його чоловіком, який міг би служити самій королеві, дуже пишаюся цим.",shape=box,color=blue];
		j1392891493 -> j3535524021;
	j3255771613 [label="Add 1 to Thermostat counter",color=orange];
		j3255771613 -> j3592190695;
	j1095548376 [label="Add 1 to Thermostat counter",color=orange];
		j1095548376 -> j4003605578;
	j2522317478 [label="Add -1 to Thermostat counter",color=orange];
		j2522317478 -> j1649648643;
	j2888540242 [label="Add 1 to Thermostat counter",color=orange];
		j2888540242 -> j4040942960;
	j2858860665 [label="Add 1 to Thermostat counter",color=orange];
		j2858860665 -> j1060456581;
	j2647674859 [label="Add -1 to Thermostat counter",color=orange];
		j2647674859 -> j372009077;
	j1949219167 [label="Add -1 to Thermostat counter",color=orange];
		j1949219167 -> j1649587631;
	j853367984 [label="Add 1 to Thermostat counter",color=orange];
		j853367984 -> j3612004773;
	j1600471176 [label="Я не можу уявити собі, чому для більшості людей не оточених летючими головами та балакучими тваринами, слон не став би темою для розмов.",shape=box,color=blue];
		j1600471176 -> j1887516896;
	j3592190695 [label="+5 Chemistry",color=orange];
		j3592190695 -> j651699898;
	j4003605578 [label="Ти дозволяєш собі припустити, що я не зрозумію ? Я не дурепа. Я не б’юся в істеричних нападах, хоча мене й перенесли сюди та змінили на ту, яка я є.",shape=box,color=blue];
		j4003605578 -> j4158674216;
		j4003605578 -> j2221857967;
	j1649648643 [label="Мені важливо те, до чого це призведе. Але тобі не потрібні мої нотації. Я тобі не матір, та й не бажаю зіпсувати дружбу на самому початку…",shape=box,color=blue];
		j1649648643 -> j1714523421;
	j4040942960 [label="+5 Chemistry",color=orange];
		j4040942960 -> j2237176250;
	j1060456581 [label="+5 Chemistry",color=orange];
		j1060456581 -> j1977606310;
	j372009077 [label="Я просто закликаю до обачності. Як на мене, він міг би зачарувати Луа, щоб отримати зорі з неба.",shape=box,color=blue];
		j372009077 -> j603233082;
	j1649587631 [label="Мені важливо те, до чого це призведе. Але тобі не потрібні мої нотації.",shape=box,color=blue];
		j1649587631 -> j2922708206;
	j3612004773 [label="+5 Chemistry",color=orange];
		j3612004773 -> j737789337;
	j1887516896 [label="Підозрюю, що мені вдалося відповісти на власне запитання, чи не так ?",shape=box,color=blue];
		j1887516896 -> j3108074092;
	j651699898 [label="Я ціную вибачення і приймаю його, але зважай на те, що мене перенесли й змінили. І я прийшла до тями в оточенні l'impossible. ",shape=box,color=blue];
		j651699898 -> j1065955251;
	j4158674216 [label="Не зважай. Я ліпше поговорю безпосередньо з дияволом.",shape=box,color=red];
		j4158674216 -> j4014689105;
	j2221857967 [label="Мені шкода. Не хотілося сперечатися з тобою. Геть не це малося на увазі. ",shape=box,color=red];
		j2221857967 -> j3391528336;
		j2221857967 -> j1283598295;
	j1714523421 [label="Я просто переживаю за тебе. Він дуже вправний і маніпулятивний звір… ",shape=box,color=blue];
		j1714523421 -> j961085571;
	j2237176250 [label="Я б возвела тебе до лику святих Сола навіть за спробу такого діяння.",shape=box,color=blue];
		j2237176250 -> j961085571;
	j1977606310 [label="Oui, солдатське прокляття… Спалити місто, щоб урятувати країну. Убити чоловіка, щоб урятувати сім’ю. Та де ж межа проведена для жаху ?",shape=box,color=blue];
		j1977606310 -> j2357008960;
	j603233082 [label="Пам’ятай хто він і що він таке. Зрештою… не бог, і навіть не звір. Людина. Чоловік, який занадто високої думки про себе.",shape=box,color=blue];
		j603233082 -> j961085571;
	j2922708206 [label="Як на мене, він міг би зачарувати Луа, щоб отримати зорі з неба. Пильнуй, ось все, що я кажу.",shape=box,color=blue];
		j2922708206 -> j961085571;
	j737789337 [label="Це дуже мудро… не дослухатися до його солодкавих промов. Як на мене, він міг би зачарувати Луа, щоб отримати зорі з неба.",shape=box,color=blue];
		j737789337 -> j961085571;
	j3108074092 [label="Так, звісно. Це означає: «чи можемо ми обговорити тему, яку всі уникають, так, наче ми не говоримо про велетенського слона, який стоїть просто поруч із нами».",shape=box,color=red];
		j3108074092 -> j2195992896;
	j1065955251 [label="Якщо вважаєш, що я не можу зрозуміти чи не співчуваю життєвим історіям інших, то передумай, oui ?",shape=box,color=blue];
		j1065955251 -> j2067686496;
	j4014689105 [label="Qu'il en soit ainsi.",shape=box,color=blue];
		j4014689105 -> "Chat ends.";
	j3391528336 [label="Він солдат. Він мусив учиняти жахливі речі в ім’я «вищої мети». Я знаю ці відчуття. Іноді таке життя перетворює тебе на… ну. На йому подібне.",shape=box,color=red];
		j3391528336 -> j4098694967;
	j1283598295 [label="Він прожив сотні, якщо не тисячі років. Хтозна як це насправді впливає на особистість? Скільки було болю, скільки страждань? Я знаю.",shape=box,color=red];
		j1283598295 -> j1155221512;
	j961085571 [label="Але ж тобі кортіло розпитати про диявола саме мене, non ? Що ти хочеш про нього знати ?",shape=box,color=blue];
		j961085571 -> j2715267147;
		j961085571 -> j1343624167;
		j961085571 -> j3037557739;
	j2357008960 [label="На війну потрібно дивитися очима статистики, бо в разі погляду очима загиблих спроможні будемо лише вічно ридати.",shape=box,color=blue];
		j2357008960 -> j961085571;
	j2195992896 [label="А якби мені дали другу спробу зрозуміти про природу цього éléphant… то була б його шкура синьою ?",shape=box,color=blue];
		j2195992896 -> j3218359144;
	j2067686496 [label="А я, натомість, передумаю, чи розповідати про твої справи, чи ні.",shape=box,color=blue];
		j2067686496 -> j4158674216;
		j2067686496 -> j3992135141;
	j4098694967 [label="+5 Chemistry",color=orange];
		j4098694967 -> j3853091999;
	j1155221512 [label="+5 Chemistry",color=orange];
		j1155221512 -> j988209020;
	j2715267147 [label="Чому він тобі так не подобається?",shape=box,color=red];
		j2715267147 -> j3042945083;
	j1343624167 [label="Чому Ентраті залишив його з тобою й Ліоном?",shape=box,color=red];
		j1343624167 -> j1837493726;
	j3037557739 [label="Мені було цікаво, як ви познайомилися.",shape=box,color=red];
		j3037557739 -> j1294928751;
	j3992135141 [label="Згода.",shape=box,color=red];
		j3992135141 -> j2914010140;
	j3853091999 [label="Ой, а теперечки точно почуваюся дурепою. Так, звісно. Ти ж знаєш, як це вбивати… як ти кажеш, задля «мети»… Звісно, тобі захочеться порозумітися з кимось, хто вчиняв так само.",shape=box,color=blue];
		j3853091999 -> j1029852758;
	j988209020 [label="Ой, а теперечки точно почуваюся дурепою. Так, звісно. Ти ж знаєш, як це жити знову і знову… Звісно, тобі захочеться порозумітися з кимось, хто вчиняв так само.",shape=box,color=blue];
		j988209020 -> j1029852758;
	j3042945083 [label="Хіба це не очевидно ? Та він же ж поводиться наче величезний котяра, який наполегливо мітить свою територію й скидає геть усе з полиць.",shape=box,color=blue];
		j3042945083 -> j41704449;
		j3042945083 -> j4055233323;
	j1837493726 [label="Коли le Cardinal Dimanche, тобто Ентраті, йшов востаннє, то лишив диявола біля наших дверей. Поламаного, скривавленого й ледве здатного згадати власне ім'я.",shape=box,color=blue];
		j1837493726 -> j1533651335;
	j1294928751 [label="У ніч, коли диявол заявився до нас, вирувала люта буря. Жахлива громовиця трясла стіни Cathédrale.",shape=box,color=blue];
		j1294928751 -> j4132570505;
	j2914010140 [label="Boolean MarieRoatheWarning is now false.",color=orange];
		j2914010140 -> j3487519780;
	j1029852758 [label="Домовмося. Якщо вважаєш, що я не можу зрозуміти чи не співчуваю життєвим історіям інших, то передумай, oui ?",shape=box,color=blue];
		j1029852758 -> j2067686496;
	j41704449 [label="Якщо що, то особисто мені подобаються коти й кішки. ",shape=box,color=red];
		j41704449 -> j75281402;
	j4055233323 [label="Тобі не подобаються коти?",shape=box,color=red];
		j4055233323 -> j3648543356;
	j1533651335 [label="Тепер я знаю, що тоді він був після щойно отриманої дози sérum, а перетворення не з власної волі буває… болісним.",shape=box,color=blue];
		j1533651335 -> j775520978;
	j4132570505 [label="Check boolean MarieLyonVisions",color=orange];
		j4132570505 -> j3689691560 [label=true,color=green];
		j4132570505 -> j1492387652 [label=false,color=brown];
	j3487519780 [label="Magnifique ! Тож тобі кортить розпитати про диявола саме мене, non ? Що ти хочеш про нього знати ?",shape=box,color=blue];
		j3487519780 -> j2715267147;
		j3487519780 -> j1343624167;
		j3487519780 -> j3037557739;
	j75281402 [label="Коти просто чудові, коли кіт — це кіт ! А він дорослий чоловік із чималою кількістю років за плечима !",shape=box,color=blue];
		j75281402 -> j3353222958;
	j3648543356 [label="Та подобаються, коли кіт — це кіт ! А він дорослий чоловік із чималою кількістю років за плечима !",shape=box,color=blue];
		j3648543356 -> j3353222958;
	j775520978 [label="Le Cardinal дивився згори донизу на диявола й сказав: «Уриїле, Єретику Зати, у вигнанні, дай відповідь — чи можна коли-небудь пробачити орокіну ?».",shape=box,color=blue];
		j775520978 -> j2885788500;
	j3689691560 [label="Цього разу, якщо Ліон розповідатиме про бурю, від якої двиготіли стіни нашого дому, то знай — то правда, яку ми разом із ним ділили й несемо далі.",shape=box,color=blue];
		j3689691560 -> j1492387652;
	j1492387652 [label="Вважаю, що прибуття такого зла в супроводі такої негоди було неймовірним cliché.",shape=box,color=blue];
		j1492387652 -> j1837493726;
	j3353222958 [label="З набагато більшою кількістю років, аніж у будь-якої людської істоти, синьошкірої чи інак видозміненої до невпізнання за власним бажанням, мало би бути.",shape=box,color=blue];
		j3353222958 -> j157845283;
		j3353222958 -> j851474490;
		j3353222958 -> j4067158271;
	j2885788500 [label="Із ударом громовиці, наче самі боги вмить покликали його, le Cardinal просто зник.",shape=box,color=blue];
		j2885788500 -> j1231255148;
	j157845283 [label="Генетичні видозміни тіл були в моді серед орокінів у їхні часи. Але вони були простими людьми, як ми є. Вірніше, як ми були.",shape=box,color=red];
		j157845283 -> j655948104;
	j851474490 [label="Окрім хвоста, він насправді має… людяніший вигляд, аніж більшість орокінів свого часу.",shape=box,color=red];
		j851474490 -> j1649174482;
	j4067158271 [label="Не переживай. На мою думку, ти набагато симпатичніша за нього.",shape=box,color=red];
		j4067158271 -> j2617491924;
	j1231255148 [label="І нас залишили із… ним. Дияволом.",shape=box,color=blue];
		j1231255148 -> j1204480199;
	j655948104 [label="Так, мабуть, я достоту вже не знаю хто я. Частково Марі, частково… «Вісп»… частково… хтозна-яка там заражена нечисть тече в моїх венах.",shape=box,color=blue];
		j655948104 -> j174569459;
	j1649174482 [label="Так, я бачила старий портрет le Cardinal, коли він був схожішим на диявола. Він розповідав мені про звичаї орокінів, про те, як вони звикли змінювати себе.",shape=box,color=blue];
		j1649174482 -> j123423192;
	j2617491924 [label="Check boolean DrifterMarie",color=orange];
		j2617491924 -> j4154386306 [label=true,color=green];
		j2617491924 -> j2187010361 [label=false,color=brown];
	j1204480199 [label="Le Cardinal лишив його нам… певно, щоб розгледіти душу ? Чи принаймні пильнувати кайдани, які його стримують. Je préférerais le renvoyer en enfer.",shape=box,color=blue];
		j1204480199 -> j1475845366;
		j1204480199 -> j3951608219;
	j174569459 [label="Можливо, ця розмова для іншого разу.",shape=box,color=blue];
		j174569459 -> j3738691493;
	j123423192 [label="Це схоже, але водночас дуже чуже. Подібне до того, як мадам із мого часу носили пишні перуки, котрі могли сягати неба, чи сукні, в яких легко міг поміститися сиротинець !",shape=box,color=blue];
		j123423192 -> j3708899704;
	j4154386306 [label="Досить змушувати мене червоніти ! Монсеньор Лойд не зрозуміє чим я тут займаюся !",shape=box,color=blue];
		j4154386306 -> j1766467299;
	j2187010361 [label="Boolean DrifterMarie is now true.",color=orange];
		j2187010361 -> j2848575124;
	j1475845366 [label="Вважаєш, що зрештою геть усіх можна пробачити?",shape=box,color=red];
		j1475845366 -> j1856026322;
	j3951608219 [label="Чи є бодай щось, що тобі в ньому подобається? Хоч щось?",shape=box,color=red];
		j3951608219 -> j1685161070;
	j3738691493 [label="Boolean MarieInfestation is now true.",color=orange];
		j3738691493 -> j3259431247;
	j3708899704 [label="Люди завжди лишатимуться людьми — незадоволеними своїми формами, подарованими Солом. Прагнуть місити й виліплювати свою плоть, наче глину. Гадаю, що я така сама.",shape=box,color=blue];
		j3708899704 -> j3016194361;
	j1766467299 [label="Окрім того, хіба так складно бути симпатичнішою за диявола, non ? Його риси приємні, але ця синька… ce n’est pas pour moi.",shape=box,color=blue];
		j1766467299 -> j4152347571;
	j2848575124 [label="Ой ! Я через тебе зашарілася ! Що ж подумає монсеньйор Лойд, коли побачить мене таку біля екрана ?",shape=box,color=blue];
		j2848575124 -> j1766467299;
	j1856026322 [label="Я ? Oui. Так. Я вірю. що всі душі здатні здобути прощення за свої провини.",shape=box,color=blue];
		j1856026322 -> j4169140045;
	j1685161070 [label="Ні, анічогісінько не було й не буде.",shape=box,color=blue];
		j1685161070 -> j4181667250;
		j1685161070 -> j1439761861;
	j3259431247 [label="Моя проблема в тому, що він має вбивче котяче его, але жодної краплини милої природи маленьких приємних супутників.",shape=box,color=blue];
		j3259431247 -> j1854837938;
	j3016194361 [label="Була занадто щасливою від дози sérum, котра зробила мене частково Марі, частково… «Вісп»… і частково… хтозна-яка там заражена нечисть тече в моїх венах.",shape=box,color=blue];
		j3016194361 -> j174569459;
	j4152347571 [label="Я приймаю твій комплімент, якщо він щирий. Я вражена. Може… можемо повернутися до теми, яку обговорювали ?",shape=box,color=blue];
		j4152347571 -> j3738691493;
	j4169140045 [label="Тож питання відкрите… чи взагалі він хоч колись відчуває потребу в чомусь такому ?",shape=box,color=blue];
		j4169140045 -> j1616302301;
	j4181667250 [label="Гм, дякую за розповідь. Тож Ентраті хотів, щоби… пробачили? За що? За Тау? Чи за те, що він просто був орокіном?",shape=box,color=red];
		j4181667250 -> j870172345;
	j1439761861 [label="Гаразд. Я вірю тобі. Не думаю, що ти збрехала би мені.",shape=box,color=red];
		j1439761861 -> j2857090161;
	j1854837938 [label="Він занадто високої думки про себе. Він без вагань відбирає життя. Грається зі своїми ворогами, наче то мишки, загнані в кут.",shape=box,color=blue];
		j1854837938 -> j1204480199;
	j1616302301 [label="Прощення не може бути дарованим тим, хто вважає, що не потребує його. З таким успіхом радше займатися навчанням польотів рибу.",shape=box,color=blue];
		j1616302301 -> j4039722810;
	j870172345 [label="Я не знаю. Тож інше питання лишається відкритим… чи взагалі він хоч колись відчував потребу в чомусь такому, як прощення ?",shape=box,color=blue];
		j870172345 -> j1616302301;
	j2857090161 [label="Fie ! Гаразд. Є дещо спільне в нас обох… непереборна спокуса й жага до солодощів. Диявол частенько повертався до Cathédrale з випічкою, за яку не платив.",shape=box,color=blue];
		j2857090161 -> j644636624;
	j4039722810 [label="Але спробуй самостійно з ним поспілкуватися на цю тему, якщо бажаєш зрозуміти нездоланний виклик, який ставиш перед собою у бажанні виграти саме цю війну.",shape=box,color=blue];
		j4039722810 -> j597913123;
	j644636624 [label="Я намагалася пояснити, що це крадіжка, а він натомість починав читати довгі лекції про те, як орокіни незабаром правитимуть системою, тож це не крадіжка з огляду на порядок речей…",shape=box,color=blue];
		j644636624 -> j3315847533;
	j597913123 [label="Тож просто побажаю тобі успіхів.",shape=box,color=blue];
		j597913123 -> j1933300832;
	j3315847533 [label="Я кричала на нього, а Ліон змушений був утрутитися…",shape=box,color=blue];
		j3315847533 -> j76509198;
		j3315847533 -> j1856981349;
	j1933300832 [label="+10 Chemistry",color=orange];
		j1933300832 -> "Chat ends.";
	j76509198 [label="А випічка?..",shape=box,color=red];
		j76509198 -> j3797390072;
	j1856981349 [label="Тобі ніколи не спадало на думку, що він приніс їх, щоб ви разом усі поласували?",shape=box,color=red];
		j1856981349 -> j1264898095;
	j3797390072 [label="Ми ж не могли їй дозволити пропасти, non ? Їсти — гріх, але ще більший гріх був би дати їй запліснявіти. То ж ми з насолодою все з’їли.",shape=box,color=blue];
		j3797390072 -> j3139986739;
	j1264898095 [label="Якщо це так, то він дуже жахливо це організував. Однак… може й твоя правда. Менше з тим, ми не могли дозволити випічці пропасти. Їсти це — гріх, але ще більший гріх був би дати їй запліснявіти. То ж ми з насолодою все з'їли.",shape=box,color=blue];
		j1264898095 -> j3139986739;
	j3139986739 [label="+10 Chemistry",color=orange];
		j3139986739 -> j976202979;
	j976202979 [label="Гм. Може, це була така в нього звичка. Ну, я про те, що він приносив більше, аніж міг спожити сам…",shape=box,color=blue];
		j976202979 -> j2104936879;
	j2104936879 [label="Boolean MarieRoathePastry1 is now true.",color=orange];
		j2104936879 -> j3553419082;
	j3553419082 [label="Я подумаю про це. До завтра. À la revoyure.",shape=box,color=blue];
		j3553419082 -> "Chat ends.";
}