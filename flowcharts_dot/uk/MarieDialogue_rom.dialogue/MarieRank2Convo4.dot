digraph {
	599 [label="MarieRank2Convo4 begins.",color=orange];
		599 -> 602;
		599 -> 601;
		599 -> 600;
	602 [label="Чи дозволиш спитати про Роута? Чи це викличе в тебе гнівні тиради?",shape=box,color=red];
		602 -> 605;
	601 [label="Чи можу я тебе спитати про слона в кімнаті?",shape=box,color=red];
		601 -> 604;
	600 [label="[Завершити розмову]",shape=box,color=red];
		600 -> 603;
	605 [label="Ce diable est un imbécile qui se croit au-dessus de tout reproche ! Je préfèrerais boire un pot de vernis à bois plutôt que de passer une minute de plus à l'écouter s'enorgueillir comme un chat qui se lèche le pelage !",shape=box,color=blue];
		605 -> 607;
		605 -> 608;
	604 [label="Quoi ! Où ça ? Un éléphant ?!",shape=box,color=blue];
		604 -> 606;
	603 [label="Chat ends.",color=orange];
	607 [label="Це було… навдивовижу пізнавально.",shape=box,color=red];
		607 -> 610;
	608 [label="Я… припускатиму, що нічого з того не було добрим словом.",shape=box,color=red];
		608 -> 611;
	606 [label="Я бачу рибу, пташку і… хто б то не був, мсьє Таґфера. Я бачила чимало дивних штук у цьому святилищі, але non éléphant. Це якийсь твій жарт ?",shape=box,color=blue];
		606 -> 609;
	610 [label="+5 Chemistry",color=orange];
		610 -> 614;
	611 [label="+5 Chemistry",color=orange];
		611 -> 615;
	609 [label="Ой! Вибач. Це був мовний зворот, якого навчили мене друзі з 1999 року… ",shape=box,color=red];
		609 -> 612;
		609 -> 613;
	614 [label="Merci. Це мало бути пізнавально, але я не очікувала такого запитання. Мій гнів не мав бути спрямованим на тебе, пробач.",shape=box,color=blue];
		614 -> 618;
	615 [label="Ні, не було жодного. Пробач мені, це не мало бути спрямованим на тебе. ",shape=box,color=blue];
		615 -> 618;
	612 [label="Це було не буквально про слона.",shape=box,color=red];
		612 -> 616;
	613 [label="Тепер я розумію, чому вони вважали це доволі милим, коли бачили мою розгубленість…",shape=box,color=red];
		613 -> 617;
	618 [label="Evaluate expressions",color=orange];
		618 -> 624 [label="MarieRoatheWarning",color=purple];
		618 -> 623 [label="DrifterRoathe",color=purple];
		618 -> 622 [label="MarieRoatheSoldier",color=purple];
		618 -> 621 [label="false",color=purple];
	616 [label="+5 Chemistry",color=orange];
		616 -> 619;
	617 [label="+5 Chemistry",color=orange];
		617 -> 620;
	624 [label="Я здивована, що ти знову питаєш мене про мої думки. Твоє минуле попередження було доволі чітким. Ти не бажаєш чути, як я погано говорю про нього та йому подібних.",shape=box,color=blue];
		624 -> 633;
		624 -> 634;
	623 [label="Знаєш, я тобі щиро зізнаюся, що не знаю, як продовжити цю бесіду. Тебе тягне до нього, як comme un papillon vers une flamme.",shape=box,color=blue];
		623 -> 631;
		623 -> 632;
	622 [label="Досі прагнеш знайти в ньому союзника ? Ти граєшся з вогнем, намагаючись долучити його до своєї вовчої зграї. Він радо розірве твою горлянку найнеочікуванішої миті.",shape=box,color=blue];
		622 -> 629;
		622 -> 630;
	621 [label="Мені дивно, що з цим питанням ти звертаєшся до мене. Це ж так очевидно, що я погано думаю про того диявола.",shape=box,color=blue];
		621 -> 627;
		621 -> 628;
	619 [label="Я б не здивувалася, якби це було буквально ! Наскільки я бачу, то в цьому місці є всі ознаки ménagerie.",shape=box,color=blue];
		619 -> 625;
	620 [label="Oui, дуже мило, правда ? Я часто щось скажу монсеньйору Лойду і він дивиться на мене так, наче я заскочила його абсолютно зненацька.",shape=box,color=blue];
		620 -> 626;
	633 [label="Моя реакція була різкою і я перепрошую за це. Не хотілося б поки що засуджувати його за дії… я намагаюся зрозуміти його з усіх сторін.",shape=box,color=red];
		633 -> 642;
	634 [label="Ні, не хочу. Він вів життя, яке складно зрозуміти. Але мені було б цікаво дізнатися про те, як ви двоє зустрілися.",shape=box,color=red];
		634 -> 643;
	631 [label="Я просто намагаюся знайти пояснення тому, чому він такий, який є. Я намагаюся зрозуміти його.",shape=box,color=red];
		631 -> 640;
	632 [label="Якщо я знатиму більше про нього, то це може допомогти мені зрозуміти, як направити його… трохи добрішим шляхом.",shape=box,color=red];
		632 -> 641;
	629 [label="Я знаю. Але не можу ненавидіти його лише за те, що він робив для служіння своєму народу. Мені доводилося робити те саме.",shape=box,color=red];
		629 -> 638;
	630 [label="Він один із найнебезпечніших орокінів, які колись жили в Імперії. Ми вчинили б дурість, якби відмовилися від такої допомоги.",shape=box,color=red];
		630 -> 639;
	627 [label="Я знаю, але ж ти, певно, маєш мати якесь поняття стосовно його сутності. Я намагаюся ліпше зрозуміти його.",shape=box,color=red];
		627 -> 636;
	628 [label="І саме тому я питаю тебе про нього. Я хочу зрозуміти його. Але не дуже довіряю викладеному ним варіанту розповіді.",shape=box,color=red];
		628 -> 637;
	625 [label="А що означає цей вираз ? Якщо в кімнаті є слон, то чому б це нам не говорити про нього ?",shape=box,color=blue];
		625 -> 635;
	626 [label="І, вважаючи його чоловіком, який міг би служити самій королеві, дуже пишаюся цим.",shape=box,color=blue];
		626 -> 625;
	642 [label="Add 1 to Thermostat",color=orange];
		642 -> 651;
	643 [label="Add 1 to Thermostat",color=orange];
		643 -> 652;
	640 [label="Add -1 to Thermostat",color=orange];
		640 -> 649;
	641 [label="Add 1 to Thermostat",color=orange];
		641 -> 650;
	638 [label="Add 1 to Thermostat",color=orange];
		638 -> 647;
	639 [label="Add -1 to Thermostat",color=orange];
		639 -> 648;
	636 [label="Add -1 to Thermostat",color=orange];
		636 -> 645;
	637 [label="Add 1 to Thermostat",color=orange];
		637 -> 646;
	635 [label="Я не можу уявити собі, чому для більшості людей не оточених летючими головами та балакучими тваринами, слон не став би темою для розмов.",shape=box,color=blue];
		635 -> 644;
	651 [label="+5 Chemistry",color=orange];
		651 -> 660;
	652 [label="Ти дозволяєш собі припустити, що я не зрозумію ? Я не дурепа. Я не б’юся в істеричних нападах, хоча мене й перенесли сюди та змінили на ту, яка я є.",shape=box,color=blue];
		652 -> 661;
		652 -> 662;
	649 [label="Мені важливо те, до чого це призведе. Але тобі не потрібні мої нотації. Я тобі не матір, та й не бажаю зіпсувати дружбу на самому початку…",shape=box,color=blue];
		649 -> 658;
	650 [label="+5 Chemistry",color=orange];
		650 -> 659;
	647 [label="+5 Chemistry",color=orange];
		647 -> 656;
	648 [label="Я просто закликаю до обачності. Як на мене, він міг би зачарувати Луа, щоб отримати зорі з неба.",shape=box,color=blue];
		648 -> 657;
	645 [label="Мені важливо те, до чого це призведе. Але тобі не потрібні мої нотації.",shape=box,color=blue];
		645 -> 654;
	646 [label="+5 Chemistry",color=orange];
		646 -> 655;
	644 [label="Підозрюю, що мені вдалося відповісти на власне запитання, чи не так ?",shape=box,color=blue];
		644 -> 653;
	660 [label="Я ціную вибачення і приймаю його, але зважай на те, що мене перенесли й змінили. І я прийшла до тями в оточенні l'impossible. ",shape=box,color=blue];
		660 -> 666;
	661 [label="Не зважай. Я ліпше поговорю безпосередньо з дияволом.",shape=box,color=red];
		661 -> 667;
	662 [label="Мені шкода. Не хотілося сперечатися з тобою. Геть не це малося на увазі. ",shape=box,color=red];
		662 -> 668;
		662 -> 669;
	658 [label="Я просто переживаю за тебе. Він дуже вправний і маніпулятивний звір… ",shape=box,color=blue];
		658 -> 664;
	659 [label="Я б возвела тебе до лику святих Сола навіть за спробу такого діяння.",shape=box,color=blue];
		659 -> 664;
	656 [label="Oui, солдатське прокляття… Спалити місто, щоб урятувати країну. Убити чоловіка, щоб урятувати сім’ю. Та де ж межа проведена для жаху ?",shape=box,color=blue];
		656 -> 665;
	657 [label="Пам’ятай хто він і що він таке. Зрештою… не бог, і навіть не звір. Людина. Чоловік, який занадто високої думки про себе.",shape=box,color=blue];
		657 -> 664;
	654 [label="Як на мене, він міг би зачарувати Луа, щоб отримати зорі з неба. Пильнуй, ось все, що я кажу.",shape=box,color=blue];
		654 -> 664;
	655 [label="Це дуже мудро… не дослухатися до його солодкавих промов. Як на мене, він міг би зачарувати Луа, щоб отримати зорі з неба.",shape=box,color=blue];
		655 -> 664;
	653 [label="Так, звісно. Це означає: «чи можемо ми обговорити тему, яку всі уникають, так, наче ми не говоримо про велетенського слона, який стоїть просто поруч із нами».",shape=box,color=red];
		653 -> 663;
	666 [label="Якщо вважаєш, що я не можу зрозуміти чи не співчуваю життєвим історіям інших, то передумай, oui ?",shape=box,color=blue];
		666 -> 673;
	667 [label="Qu'il en soit ainsi.",shape=box,color=blue];
		667 -> 674;
	668 [label="Він солдат. Він мусив учиняти жахливі речі в ім’я «вищої мети». Я знаю ці відчуття. Іноді таке життя перетворює тебе на… ну. На йому подібне.",shape=box,color=red];
		668 -> 675;
	669 [label="Він прожив сотні, якщо не тисячі років. Хтозна як це насправді впливає на особистість? Скільки було болю, скільки страждань? Я знаю.",shape=box,color=red];
		669 -> 676;
	664 [label="Але ж тобі кортіло розпитати про диявола саме мене, non ? Що ти хочеш про нього знати ?",shape=box,color=blue];
		664 -> 670;
		664 -> 671;
		664 -> 672;
	665 [label="На війну потрібно дивитися очима статистики, бо в разі погляду очима загиблих спроможні будемо лише вічно ридати.",shape=box,color=blue];
		665 -> 664;
	663 [label="А якби мені дали другу спробу зрозуміти про природу цього éléphant… то була б його шкура синьою ?",shape=box,color=blue];
		663 -> 618;
	673 [label="А я, натомість, передумаю, чи розповідати про твої справи, чи ні.",shape=box,color=blue];
		673 -> 661;
		673 -> 680;
	674 [label="Chat ends.",color=orange];
	675 [label="+5 Chemistry",color=orange];
		675 -> 681;
	676 [label="+5 Chemistry",color=orange];
		676 -> 682;
	670 [label="Чому він тобі так не подобається?",shape=box,color=red];
		670 -> 677;
	671 [label="Чому Ентраті залишив його з тобою й Ліоном?",shape=box,color=red];
		671 -> 678;
	672 [label="Мені було цікаво, як ви познайомилися.",shape=box,color=red];
		672 -> 679;
	680 [label="Згода.",shape=box,color=red];
		680 -> 687;
	681 [label="Ой, а теперечки точно почуваюся дурепою. Так, звісно. Ти ж знаєш, як це вбивати… як ти кажеш, задля «мети»… Звісно, тобі захочеться порозумітися з кимось, хто вчиняв так само.",shape=box,color=blue];
		681 -> 688;
	682 [label="Ой, а теперечки точно почуваюся дурепою. Так, звісно. Ти ж знаєш, як це жити знову і знову… Звісно, тобі захочеться порозумітися з кимось, хто вчиняв так само.",shape=box,color=blue];
		682 -> 688;
	677 [label="Хіба це не очевидно ? Та він же ж поводиться наче величезний котяра, який наполегливо мітить свою територію й скидає геть усе з полиць.",shape=box,color=blue];
		677 -> 683;
		677 -> 684;
	678 [label="Коли le Cardinal Dimanche, тобто Ентраті, йшов востаннє, то лишив диявола біля наших дверей. Поламаного, скривавленого й ледве здатного згадати власне ім’я.",shape=box,color=blue];
		678 -> 685;
	679 [label="У ніч, коли диявол заявився до нас, вирувала люта буря. Жахлива громовиця трясла стіни Cathédrale.",shape=box,color=blue];
		679 -> 686;
	687 [label="Update boolean MarieRoatheWarning",color=orange];
		687 -> 694;
	688 [label="Домовмося. Якщо вважаєш, що я не можу зрозуміти чи не співчуваю життєвим історіям інших, то передумай, oui ?",shape=box,color=blue];
		688 -> 673;
	683 [label="Якщо що, то особисто мені подобаються коти й кішки. ",shape=box,color=red];
		683 -> 689;
	684 [label="Тобі не подобаються коти?",shape=box,color=red];
		684 -> 690;
	685 [label="Тепер я знаю, що тоді він був після щойно отриманої дози sérum, а перетворення не з власної волі буває… болісним.",shape=box,color=blue];
		685 -> 691;
	686 [label="Check boolean MarieLyonVisions",color=orange];
		686 -> 693 [label=true,color=green];
		686 -> 692 [label=false,color=brown];
	694 [label="Magnifique ! Тож тобі кортить розпитати про диявола саме мене, non ? Що ти хочеш про нього знати ?",shape=box,color=blue];
		694 -> 670;
		694 -> 671;
		694 -> 672;
	689 [label="Коти просто чудові, коли кіт — це кіт ! А він дорослий чоловік із чималою кількістю років за плечима !",shape=box,color=blue];
		689 -> 695;
	690 [label="Та подобаються, коли кіт — це кіт ! А він дорослий чоловік із чималою кількістю років за плечима !",shape=box,color=blue];
		690 -> 695;
	691 [label="Le Cardinal дивився згори донизу на диявола й сказав: «Уриїле, Єретику Зати, у вигнанні, дай відповідь — чи можна коли-небудь пробачити орокіну ?».",shape=box,color=blue];
		691 -> 696;
	693 [label="Цього разу, якщо Ліон розповідатиме про бурю, від якої двиготіли стіни нашого дому, то знай — то правда, яку ми разом із ним ділили й несемо далі.",shape=box,color=blue];
		693 -> 692;
	692 [label="Вважаю, що прибуття такого зла в супроводі такої негоди було неймовірним cliché.",shape=box,color=blue];
		692 -> 678;
	695 [label="З набагато більшою кількістю років, аніж у будь-якої людської істоти, синьошкірої чи інак видозміненої до невпізнання за власним бажанням, мало би бути.",shape=box,color=blue];
		695 -> 697;
		695 -> 698;
		695 -> 3906;
	696 [label="Із ударом громовиці, наче самі боги вмить покликали його, le Cardinal просто зник.",shape=box,color=blue];
		696 -> 699;
	697 [label="Генетичні видозміни тіл були в моді серед орокінів у їхні часи. Але вони були простими людьми, як ми є. Вірніше, як ми були.",shape=box,color=red];
		697 -> 700;
	698 [label="Окрім хвоста, він насправді має… людяніший вигляд, аніж більшість орокінів свого часу.",shape=box,color=red];
		698 -> 701;
	3906 [label="Не переживай. На мою думку, ти набагато симпатичніша за нього.",shape=box,color=red];
		3906 -> 3907;
	699 [label="І нас залишили із… ним. Дияволом.",shape=box,color=blue];
		699 -> 702;
	700 [label="Так, мабуть, я достоту вже не знаю хто я. Частково Марі, частково… «Вісп»… частково… хтозна-яка там заражена нечисть тече в моїх венах.",shape=box,color=blue];
		700 -> 703;
	701 [label="Так, я бачила старий портрет le Cardinal, коли він був схожішим на диявола. Він розповідав мені про звичаї орокінів, про те, як вони звикли змінювати себе.",shape=box,color=blue];
		701 -> 704;
	3907 [label="Check boolean DrifterMarie",color=orange];
		3907 -> 3908 [label=true,color=green];
		3907 -> 3909 [label=false,color=brown];
	702 [label="Le Cardinal лишив його нам… певно, щоб розгледіти душу ? Чи принаймні пильнувати кайдани, які його стримують. Je préférerais le renvoyer en enfer.",shape=box,color=blue];
		702 -> 705;
		702 -> 706;
	703 [label="Можливо, ця розмова для іншого разу.",shape=box,color=blue];
		703 -> 707;
	704 [label="Це схоже, але водночас дуже чуже. Подібне до того, як мадам із мого часу носили пишні перуки, котрі могли сягати неба, чи сукні, в яких легко міг поміститися сиротинець !",shape=box,color=blue];
		704 -> 708;
	3908 [label="Досить змушувати мене червоніти ! Монсеньор Лойд не зрозуміє чим я тут займаюся !",shape=box,color=blue];
		3908 -> 3911;
	3909 [label="Update boolean DrifterMarie",color=orange];
		3909 -> 3910;
	705 [label="Вважаєш, що зрештою геть усіх можна пробачити?",shape=box,color=red];
		705 -> 709;
	706 [label="Чи є бодай щось, що тобі в ньому подобається? Хоч щось?",shape=box,color=red];
		706 -> 710;
	707 [label="Update boolean MarieInfestation",color=orange];
		707 -> 711;
	708 [label="Люди завжди лишатимуться людьми — незадоволеними своїми формами, подарованими Солом. Прагнуть місити й виліплювати свою плоть, наче глину. Гадаю, що я така сама.",shape=box,color=blue];
		708 -> 712;
	3911 [label="Окрім того, хіба так складно бути симпатичнішою за диявола, non ? Його риси приємні, але ця синька… ce n’est pas pour moi.",shape=box,color=blue];
		3911 -> 3912;
	3910 [label="Ой ! Я через тебе зашарілася ! Що ж подумає монсеньйор Лойд, коли побачить мене таку біля екрана ?",shape=box,color=blue];
		3910 -> 3911;
	709 [label="Я ? Oui. Так. Я вірю. що всі душі здатні здобути прощення за свої провини.",shape=box,color=blue];
		709 -> 713;
	710 [label="Ні, анічогісінько не було й не буде.",shape=box,color=blue];
		710 -> 714;
		710 -> 715;
	711 [label="Моя проблема в тому, що він має вбивче котяче его, але жодної краплини милої природи маленьких приємних супутників.",shape=box,color=blue];
		711 -> 716;
	712 [label="Була занадто щасливою від дози sérum, котра зробила мене частково Марі, частково… «Вісп»… і частково… хтозна-яка там заражена нечисть тече в моїх венах.",shape=box,color=blue];
		712 -> 703;
	3912 [label="Я приймаю твій комплімент, якщо він щирий. Я вражена. Може… можемо повернутися до теми, яку обговорювали ?",shape=box,color=blue];
		3912 -> 707;
	713 [label="Тож питання відкрите… чи взагалі він хоч колись відчуває потребу в чомусь такому ?",shape=box,color=blue];
		713 -> 717;
	714 [label="Гм, дякую за розповідь. Тож Ентраті хотів, щоби… пробачили? За що? За Тау? Чи за те, що він просто був орокіном?",shape=box,color=red];
		714 -> 718;
	715 [label="Гаразд. Я вірю тобі. Не думаю, що ти збрехала би мені.",shape=box,color=red];
		715 -> 719;
	716 [label="Він занадто високої думки про себе. Він без вагань відбирає життя. Грається зі своїми ворогами, наче то мишки, загнані в кут.",shape=box,color=blue];
		716 -> 702;
	717 [label="Прощення не може бути дарованим тим, хто вважає, що не потребує його. З таким успіхом радше займатися навчанням польотів рибу.",shape=box,color=blue];
		717 -> 720;
	718 [label="Я не знаю. Тож інше питання лишається відкритим… чи взагалі він хоч колись відчував потребу в чомусь такому, як прощення ?",shape=box,color=blue];
		718 -> 717;
	719 [label="Fie ! Гаразд. Є дещо спільне в нас обох… непереборна спокуса й жага до солодощів. Диявол частенько повертався до Cathédrale з випічкою, за яку не платив.",shape=box,color=blue];
		719 -> 721;
	720 [label="Але спробуй самостійно з ним поспілкуватися на цю тему, якщо бажаєш зрозуміти нездоланний виклик, який ставиш перед собою у бажанні виграти саме цю війну.",shape=box,color=blue];
		720 -> 722;
	721 [label="Я намагалася пояснити, що це крадіжка, а він натомість починав читати довгі лекції про те, як орокіни незабаром правитимуть системою, тож це не крадіжка з огляду на порядок речей…",shape=box,color=blue];
		721 -> 723;
	722 [label="Тож просто побажаю тобі успіхів.",shape=box,color=blue];
		722 -> 724;
	723 [label="Я кричала на нього, а Ліон змушений був утрутитися…",shape=box,color=blue];
		723 -> 725;
		723 -> 726;
	724 [label="+10 Chemistry",color=orange];
		724 -> 727;
	725 [label="А випічка?..",shape=box,color=red];
		725 -> 728;
	726 [label="Тобі ніколи не спадало на думку, що він приніс їх, щоб ви разом усі поласували?",shape=box,color=red];
		726 -> 729;
	727 [label="Chat ends.",color=orange];
	728 [label="Ми ж не могли їй дозволити пропасти, non ? Їсти — гріх, але ще більший гріх був би дати їй запліснявіти. То ж ми з насолодою все з’їли.",shape=box,color=blue];
		728 -> 730;
	729 [label="Якщо це так, то він дуже жахливо це організував. Однак… може й твоя правда. Менше з тим, ми не могли дозволити випічці пропасти. Їсти це — гріх, але ще більший гріх був би дати їй запліснявіти. То ж ми з насолодою все з’їли.",shape=box,color=blue];
		729 -> 730;
	730 [label="+10 Chemistry",color=orange];
		730 -> 731;
	731 [label="Гм. Може, це була така в нього звичка. Ну, я про те, що він приносив більше, аніж міг спожити сам…",shape=box,color=blue];
		731 -> 732;
	732 [label="Update boolean MarieRoathePastry1",color=orange];
		732 -> 733;
	733 [label="Я подумаю про це. До завтра. À la revoyure.",shape=box,color=blue];
		733 -> 734;
	734 [label="Chat ends.",color=orange];
}