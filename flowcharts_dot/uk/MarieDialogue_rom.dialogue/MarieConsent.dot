	3985 [label="Check boolean MariePolyamorySuccess",color=orange];
		3985 -> 3575 [label=true,color=green];
		3985 -> 3576 [label=false,color=brown];
	3577 [label="Chat ends.",color=orange];
	3578 [label="Mon cœur, ми можемо переговорити ? Це хвилька часу, не більше. ",shape=box,color=blue];
		3578 -> 3580;
		3578 -> 3579;
	3576 [label="Chat ends.",color=orange];
	3580 [label="Привіт, звісно. Що сталося?",shape=box,color=red];
		3580 -> 3582;
	3579 [label="[Завершити розмову]",shape=box,color=red];
		3579 -> 3581;
	3582 [label="Усього лишень хотіла повідомити… Я знаю, що твоє серце належить ще комусь. І я хоч не знаю хто це, але моє серце радіє.",shape=box,color=blue];
		3582 -> 3584;
	3581 [label="Update boolean MarieConsentComplete",color=orange];
		3581 -> 3583;
	3584 [label="Я довіряю тобі. Якщо хтось займає місце у твоїй душі, то я з радістю ділитиму її з ними.",shape=box,color=blue];
		3584 -> 3585;
	3583 [label="Chat ends.",color=orange];
	3585 [label="Просто сподіваюся, що колись зможу познайомитися, oui ? Кохання мого кохання має бути й моїм теж, так…",shape=box,color=blue];
		3585 -> 3586;
	3586 [label="Це якщо, звісно, вони будуть не проти.",shape=box,color=blue];
		3586 -> 3587;
		3586 -> 3588;
		3586 -> 3589;
	3587 [label="Знаєш, якщо чесно, ти можеш бути не зовсім того типу.",shape=box,color=red];
		3587 -> 3590;
	3588 [label="Марі, тебе обожнюватимуть. Геть як я.",shape=box,color=red];
		3588 -> 3591;
	3589 [label="Не думаю, що комусь вдасться чинити хоч якийсь опір.",shape=box,color=red];
		3589 -> 3591;
	3590 [label="Пф-ф ! Як жахливе вовченя. Дай же ж помріяти. А доти, припускаю, я матиму тебе, коли матиму !",shape=box,color=blue];
		3590 -> 3592;
	3591 [label="А доти, я матиму тебе, коли матиму. І з радістю поділюся тобою з тими, хто так само небайдуже ставитиметься до тебе, як і я.",shape=box,color=blue];
		3591 -> 3592;
	3592 [label="Зрештою, хтось мусить захищати інших від Шепоту, поки ти десь там швендяєш і розважаєшся !",shape=box,color=blue];
		3592 -> 3593;
	3593 [label="І на цій приємній ноті — до обов’язків. À la revoyure !",shape=box,color=blue];
		3593 -> 3594;
	3594 [label="Update boolean MarieConsentComplete",color=orange];
		3594 -> 3595;
	3595 [label="Chat ends.",color=orange];
}