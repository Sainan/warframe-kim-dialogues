digraph {
	graph [fontname="Roboto Condensed"];
	node [fontname="Roboto Condensed"];
	edge [fontname="Roboto Condensed"];

	"MarieConsent begins." [color=orange];
		"MarieConsent begins." -> j3525420089;
	j3525420089 [label="Check boolean MarieDating",color=orange];
		j3525420089 -> j1726666308 [label=true,color=green];
		j3525420089 -> "Chat ends." [label=false,color=brown];
	j1726666308 [label="Check /Lotus/Scripts/1999/DialogueScriptNodes.lua:IsDatingMultiple",color=orange];
		j1726666308 -> j1985950621 [label=true,color=green];
		j1726666308 -> j1134465740 [label=false,color=brown];
	"Chat ends." [color=orange];
	j1985950621 [label="Check boolean MarieConsentComplete",color=orange];
		j1985950621 -> "Chat ends." [label=true,color=green];
		j1985950621 -> j3365319823 [label=false,color=brown];
	j1134465740 [label="Check boolean MariePolyamorySuccess",color=orange];
		j1134465740 -> j1985950621 [label=true,color=green];
		j1134465740 -> "Chat ends." [label=false,color=brown];
	j3365319823 [label="Mon cœur, ми можемо переговорити ? Це хвилька часу, не більше. ",shape=box,color=blue];
		j3365319823 -> j1843515238;
		j3365319823 -> j1529996535;
	j1843515238 [label="Привіт, звісно. Що сталося?",shape=box,color=red];
		j1843515238 -> j2434188182;
	j1529996535 [label="[Завершити розмову]",shape=box,color=red];
		j1529996535 -> j952339130;
	j2434188182 [label="Усього лишень хотіла повідомити… Я знаю, що твоє серце належить ще комусь. І я хоч не знаю хто це, але моє серце радіє.",shape=box,color=blue];
		j2434188182 -> j1599558653;
	j952339130 [label="Boolean MarieConsentComplete is now true.",color=orange];
		j952339130 -> "Chat ends.";
	j1599558653 [label="Я довіряю тобі. Якщо хтось займає місце у твоїй душі, то я з радістю ділитиму її з ними.",shape=box,color=blue];
		j1599558653 -> j1565316028;
	j1565316028 [label="Просто сподіваюся, що колись зможу познайомитися, oui ? Кохання мого кохання має бути й моїм теж, так…",shape=box,color=blue];
		j1565316028 -> j431395158;
	j431395158 [label="Це якщо, звісно, вони будуть не проти.",shape=box,color=blue];
		j431395158 -> j2187725265;
		j431395158 -> j1486471405;
		j431395158 -> j1644613547;
	j2187725265 [label="Знаєш, якщо чесно, ти можеш бути не зовсім того типу.",shape=box,color=red];
		j2187725265 -> j2899138834;
	j1486471405 [label="Марі, тебе обожнюватимуть. Геть як я.",shape=box,color=red];
		j1486471405 -> j2999385096;
	j1644613547 [label="Не думаю, що комусь вдасться чинити хоч якийсь опір.",shape=box,color=red];
		j1644613547 -> j2999385096;
	j2899138834 [label="Пф-ф ! Як жахливе вовченя. Дай же ж помріяти. А доти, припускаю, я матиму тебе, коли матиму !",shape=box,color=blue];
		j2899138834 -> j2956283807;
	j2999385096 [label="А доти, я матиму тебе, коли матиму. І з радістю поділюся тобою з тими, хто так само небайдуже ставитиметься до тебе, як і я.",shape=box,color=blue];
		j2999385096 -> j2956283807;
	j2956283807 [label="Зрештою, хтось мусить захищати інших від Шепоту, поки ти десь там швендяєш і розважаєшся !",shape=box,color=blue];
		j2956283807 -> j26028309;
	j26028309 [label="І на цій приємній ноті — до обов’язків. À la revoyure !",shape=box,color=blue];
		j26028309 -> j952339130;
}