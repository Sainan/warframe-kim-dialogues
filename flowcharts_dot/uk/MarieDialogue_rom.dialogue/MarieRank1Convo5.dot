digraph {
	3964 [label="MarieRank1Convo5 begins.",color=orange];
		3964 -> 3965;
	3965 [label="Bonjour, bonjour ! Це тебе кличуть «мандрівниче», oui ? Монсеньор Лойд дуже багато про тебе розповідав. Дуже рада «познайомитися» у цій…",shape=box,color=blue];
		3965 -> 3966;
	3966 [label="Appareil cliquetant, хоча й доволі винахідливий штуці !",shape=box,color=blue];
		3966 -> 3967;
	3967 [label="Я — Sœur Marie Leroux, але можеш називати мене Марі. Не так давно ми прибули сюди разом із моїм духовним братом, отцем Ліоном Аллардом і… гадаю, монсеньйор Лойд уже попередив тебе про диявола, n’est-ce pas ?",shape=box,color=blue];
		3967 -> 3968;
		3967 -> 3969;
		3967 -> 3970;
	3968 [label="Приємно познайомитися. Не подумай, що це грубість — вам тут раді, але… чому ви всі тут?",shape=box,color=red];
		3968 -> 3972;
	3969 [label="Диявол? Ти орокіна маєш на увазі?",shape=box,color=red];
		3969 -> 3974;
	3970 [label="[Завершити розмову]",shape=box,color=red];
		3970 -> 3971;
	3972 [label="+5 Chemistry",color=orange];
		3972 -> 3973;
	3974 [label="Oui, ce monstre irritant à la peau bleue, якого нам довірено le Cardinal. Думаю, тут ви його звете Альбрехтом Ентраті, oui ? Саме через нього ми тут. Але це дуже-дуже довга історія, j'en ai bien peur.",shape=box,color=blue];
		3974 -> 3975;
		3974 -> 3976;
	3971 [label="Chat ends.",color=orange];
	3973 [label="Merci ! The what and the how of our being here is a very long story, j'en ai bien peur. We were sent here by le Cardinal. I believe you know him as Albrecht Entrati ? He entrusted us with that blue-skinned monstre irritant.",shape=box,color=blue];
		3973 -> 3975;
		3973 -> 3976;
	3975 [label="Зроблю все можливе, щоб допомогти.",shape=box,color=red];
		3975 -> 3980;
	3976 [label="«Довірено»?",shape=box,color=red];
		3976 -> 3977;
	3980 [label="+5 Chemistry",color=orange];
		3980 -> 3981;
	3977 [label="Ми маємо зробити все можливе, щоб направити його душу на шлях істинний, si c’est possible. Et si ce n’est pas le cas ? Тоді ж маємо впевнитися, що він більше ніколи нікого не скривдить.",shape=box,color=blue];
		3977 -> 3978;
		3977 -> 3979;
	3981 [label="Усе точно так як описували кавії і монсеньйор Лойд ! Думаю, ми точно станемо хорошими друзями.",shape=box,color=blue];
		3981 -> 3983;
	3978 [label="Дуже хочеться допомогти вам спробувати.",shape=box,color=red];
		3978 -> 3980;
	3979 [label="Він орокін. Єдиний спосіб досягти бажаного — пустити кулю йому межи очі.",shape=box,color=red];
		3979 -> 3982;
	3983 [label="Ой ! Пробач мені, але мушу йти. Сподіваюся, невдовзі знову поспілкуємося ! À la revoyure !",shape=box,color=blue];
		3983 -> 3984;
	3982 [label="Твої слова точнісінько як Ліонові. Але я не покину надії. Ще ні.",shape=box,color=blue];
		3982 -> 3983;
	3984 [label="Chat ends.",color=orange];
}