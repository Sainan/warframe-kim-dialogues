digraph {
	graph [fontname="Roboto Condensed"];
	node [fontname="Roboto Condensed"];
	edge [fontname="Roboto Condensed"];

	"MarieRank1Convo5 begins." [color=orange];
		"MarieRank1Convo5 begins." -> j2566275430;
	j2566275430 [label="Bonjour, bonjour ! Це тебе кличуть «мандрівниче», oui ? Монсеньор Лойд дуже багато про тебе розповідав. Дуже рада «познайомитися» у цій…",shape=box,color=blue];
		j2566275430 -> j2202889935;
	j2202889935 [label="Appareil cliquetant, хоча й доволі винахідливий штуці !",shape=box,color=blue];
		j2202889935 -> j2903844083;
	j2903844083 [label="Я — Sœur Marie Leroux, але можеш називати мене Марі. Не так давно ми прибули сюди разом із моїм духовним братом, отцем Ліоном Аллардом і… гадаю, монсеньйор Лойд уже попередив тебе про диявола, n'est-ce pas ?",shape=box,color=blue];
		j2903844083 -> j3913865978;
		j2903844083 -> j663075793;
		j2903844083 -> j1478915251;
	j3913865978 [label="Приємно познайомитися. Не подумай, що це грубість — вам тут раді, але… чому ви всі тут?",shape=box,color=red];
		j3913865978 -> j1099875365;
	j663075793 [label="Диявол? Ти орокіна маєш на увазі?",shape=box,color=red];
		j663075793 -> j1663284100;
	j1478915251 [label="[Завершити розмову]",shape=box,color=red];
		j1478915251 -> "Chat ends.";
	j1099875365 [label="+5 Chemistry",color=orange];
		j1099875365 -> j2171880682;
	j1663284100 [label="Oui, ce monstre irritant à la peau bleue, якого нам довірено le Cardinal. Думаю, тут ви його звете Альбрехтом Ентраті, oui ? Саме через нього ми тут. Але це дуже-дуже довга історія, j'en ai bien peur.",shape=box,color=blue];
		j1663284100 -> j1259276326;
		j1663284100 -> j3599289364;
	"Chat ends." [color=orange];
	j2171880682 [label="Merci ! Чому, як і для чого ми тут опинилися буде дуже довго розписувати, j'en ai bien peur. Нас сюди послав le Cardinal. Думаю, що тут його знають як Альбрехта Ентраті, oui ? Нам довірено наглядати за тим синьошкірим monstre irritant.",shape=box,color=blue];
		j2171880682 -> j1259276326;
		j2171880682 -> j3599289364;
	j1259276326 [label="Зроблю все можливе, щоб допомогти.",shape=box,color=red];
		j1259276326 -> j1506353576;
	j3599289364 [label="«Довірено»?",shape=box,color=red];
		j3599289364 -> j3072405075;
	j1506353576 [label="+5 Chemistry",color=orange];
		j1506353576 -> j780151927;
	j3072405075 [label="Ми маємо зробити все можливе, щоб направити його душу на шлях істинний, si c'est possible. Et si ce n'est pas le cas ? Тоді ж маємо впевнитися, що він більше ніколи нікого не скривдить.",shape=box,color=blue];
		j3072405075 -> j4283928575;
		j3072405075 -> j3038255749;
	j780151927 [label="Усе точно так як описували кавії і монсеньйор Лойд ! Думаю, ми точно станемо хорошими друзями.",shape=box,color=blue];
		j780151927 -> j629240920;
	j4283928575 [label="Дуже хочеться допомогти вам спробувати.",shape=box,color=red];
		j4283928575 -> j1506353576;
	j3038255749 [label="Він орокін. Єдиний спосіб досягти бажаного — пустити кулю йому межи очі.",shape=box,color=red];
		j3038255749 -> j223431197;
	j629240920 [label="Ой ! Пробач мені, але мушу йти. Сподіваюся, невдовзі знову поспілкуємося ! À la revoyure !",shape=box,color=blue];
		j629240920 -> "Chat ends.";
	j223431197 [label="Твої слова точнісінько як Ліонові. Але я не покину надії. Ще ні.",shape=box,color=blue];
		j223431197 -> j629240920;
}