		3203 -> 3207 [label="false",color=purple];
	3204 [label="Я можу щось зробити, щоб розвеселити тебе? Можемо сходити разом катувати Роута.",shape=box,color=red];
		3204 -> 3208;
	3205 [label="Я можу щось зробити, щоб розвеселити тебе? Може, викрасти якусь смачну випічку?",shape=box,color=red];
		3205 -> 3209;
	3206 [label="Марі, боги іноді жорстокі. Такий плин життя.",shape=box,color=red];
		3206 -> 3210;
	3207 [label="Усе добре. Ти маєш повне право бути такою.",shape=box,color=red];
		3207 -> 3211;
	3208 [label="+15 Chemistry",color=orange];
		3208 -> 3212;
	3209 [label="+20 Chemistry",color=orange];
		3209 -> 3212;
	3210 [label="+5 Chemistry",color=orange];
		3210 -> 3213;
	3211 [label="+20 Chemistry",color=orange];
		3211 -> 3214;
	3212 [label="Ха ! Merci. Це точно зупинить потік цих дурних сліз. А ти добре знаєш, як звеселити дурненьку маленьку Марі, non ?",shape=box,color=blue];
		3212 -> 3215;
		3212 -> 3216;
	3213 [label="Oui. Твоя правда. Вони такі. Світ сповнений історій, подібних до оповіді про монсеньйора Отака, а ще більше набагато гірших. Не варто ридати над кожною з них. ",shape=box,color=blue];
		3213 -> 3217;
	3214 [label="Merci. Але я більше не хочу. Робитиму щось веселеньке ! Думаю, настала черга витерти пил з акваріума мсьє Фібоначчі.",shape=box,color=blue];
		3214 -> 3218;
	3215 [label="Ти геть не дурненька. Я почуваюся так само.",shape=box,color=red];
		3215 -> 3219;
	3216 [label="Це найменше, що я можу для тебе зробити.",shape=box,color=red];
		3216 -> 3219;
	3217 [label="Однак я досі тут сиджу і досі ридаю. Дякую, що нагадуєш мені про мою тупу натуру. Fie ! Дурненька маленька Марі. Що ж… Думаю, варто витерти пил з акваріума мсьє Фібоначчі.",shape=box,color=blue];
		3217 -> 3218;
