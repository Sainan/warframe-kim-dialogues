	j3097375491 [label="Check boolean MarieDating",color=orange];
		j3097375491 -> j3726742454 [label=true,color=green];
		j3097375491 -> j943680698 [label=false,color=brown];
	j3297546499 [label="Вовченя ! Моє вовченя ! Я зустрілася з Отаком ! Нарешті ми познайомилися !",shape=box,color=blue];
		j3297546499 -> j2249822535;
		j3297546499 -> j964642882;
	j3211595241 [label="Я зустрілася з Отаком ! Нарешті ми познайомилися !",shape=box,color=blue];
		j3211595241 -> j2249822535;
		j3211595241 -> j964642882;
	j3726742454 [label="Вовченя ! Моє вовченя ! Обличчя позаду монсеньйора Некралойда ! Ми нарешті познайомилися !",shape=box,color=blue];
		j3726742454 -> j1806002332;
		j3726742454 -> j2959065238;
		j3726742454 -> j2194057375;
	j943680698 [label="Обличчя позаду монсеньйора Некралойда ! Ми нарешті познайомилися !",shape=box,color=blue];
		j943680698 -> j1806002332;
		j943680698 -> j2959065238;
		j943680698 -> j2194057375;
	j2249822535 [label="І як пройшла розмова?",shape=box,color=red];
		j2249822535 -> j1134890120;
	j964642882 [label="Тобі сподобалося балакати з ним?",shape=box,color=red];
		j964642882 -> j3271515643;
	j1806002332 [label="Ти познайомилася з Отаком? Лишенько… І як усе пройшло?",shape=box,color=red];
		j1806002332 -> j1130836334;
	j2959065238 [label="Тішуся з вашого знайомства. Отака іноді буває складно сприйняти.",shape=box,color=red];
		j2959065238 -> j128418848;
	j2194057375 [label="Бідолашний Отак… І як усе пройшло?",shape=box,color=red];
		j2194057375 -> j424141935;
	j1134890120 [label="Він… тричі за одну бесіду знайомився зі мною, наче ми були до цього не знайомі.",shape=box,color=blue];
		j1134890120 -> j3251756907;
	j3271515643 [label="Так. Хоча хотілося плакати від неї. Він… тричі за одну бесіду знайомився зі мною, наче ми були до цього не знайомі.",shape=box,color=blue];
		j3271515643 -> j3251756907;
	j1130836334 [label="А чого я між рядків читаю, що ти наче не дуже радієш нашому знайомству ?",shape=box,color=blue];
		j1130836334 -> j1448357327;
		j1130836334 -> j2042368219;
		j1130836334 -> j3716904326;
	j128418848 [label="Та, думаю так. Дитячі каракулі на спині автоматона. Виявилося, що то дуже мила й чарівна особистість !",shape=box,color=blue];
		j128418848 -> j1307489615;
	j424141935 [label="Він виявився дуже милим і чарівним ! Але десь за товстими шарами гумору я відчула зранену душу.",shape=box,color=blue];
		j424141935 -> j1708311235;
	j3251756907 [label="Він вітав мене так само незворушно й радісно, як попередні рази. Але ж я вже казала, що я Sœur de Sol ! ",shape=box,color=blue];
		j3251756907 -> j4061746777;
	j1448357327 [label="Мені шкода. Він іноді може довести до сказу. Але це не його провина.",shape=box,color=red];
		j1448357327 -> j3666247873;
	j2042368219 [label="Я не про те. Він просто іноді буває… трохи відштовхує своєю поведінкою.",shape=box,color=red];
		j2042368219 -> j3666247873;
	j3716904326 [label="Він іноді мене дуже бісить. От і все. ",shape=box,color=red];
		j3716904326 -> j3142835124;
	j1307489615 [label="Але десь за товстими шарами гумору я відчула зранену душу.",shape=box,color=blue];
		j1307489615 -> j1708311235;
	j1708311235 [label="Ти розповіси мені історію бідолашного монсеньйора Отака ?",shape=box,color=blue];
		j1708311235 -> j587494708;
	j4061746777 [label="І справді, він чимало знав про Світочі ! Ми багато говорили про «прадавні релігії» (це він так назвав їх) у часи «до орокінської імперії».",shape=box,color=blue];
		j4061746777 -> j1555019167;
	j3666247873 [label="Я маю надію, що зрештою вони всі виявляли доброту й терплячість. Mais par la grâce de Sol, бо ми всі такі.",shape=box,color=blue];
		j3666247873 -> j53381962;
	j3142835124 [label="Сподіваюся, ти намагатимешся виявляти більше доброти до того, хто явно не при собі. Зрештою, усі ми під Солом ходимо.",shape=box,color=blue];
		j3142835124 -> j53381962;
	j587494708 [label="Отак колись був архімедівцем, орокінським ученим і академіком. А подальша історія не з тих, що зі щасливим завершенням.",shape=box,color=red];
		j587494708 -> j3190821239;
	j1555019167 [label="Ще він казав, що велика частина з тих знань давно втрачена, десь у глибинах архівів і дуже-дуже заборонена. Вимагав присяги на мовчання.",shape=box,color=blue];
		j1555019167 -> j1920453288;
	j53381962 [label="Така доля може спіткати нас усіх. Навіть тебе.",shape=box,color=blue];
		j53381962 -> j3211504873;
		j53381962 -> j2894158416;
	j3190821239 [label="З усіх подій стає зрозумілим, що він був генієм і тим, хто опанував використання кристалів аргону.",shape=box,color=red];
		j3190821239 -> j1372094499;
	j1920453288 [label="Він мені розповів про глибоке незапокоєння тим, що виконавець Баллас (хто б він не був) може знайти мою єретичну секту й стратити мене особисто.",shape=box,color=blue];
		j1920453288 -> j4193679138;
		j1920453288 -> j3469716959;
	j3211504873 [label="Ти вибач, але в мене бракує вільного часу, щоб ще й на нього його витрачати.",shape=box,color=red];
		j3211504873 -> j372269021;
	j2894158416 [label="Саме так. Твоя правда. Не це малося на увазі.",shape=box,color=red];
		j2894158416 -> j1708311235;
	j1372094499 [label="А вони походять із Порожнечі. І саме завдяки їм ми можемо створювати чимало ворфреймів та потужну зброю.",shape=box,color=red];
		j1372094499 -> j1741968839;
	j4193679138 [label="Цього… не станеться. Тож розповідай далі.",shape=box,color=red];
		j4193679138 -> j1126504980;
	j3469716959 [label="Баллас мертвий… продовжуй.",shape=box,color=red];
		j3469716959 -> j1126504980;
	j372269021 [label="Тоді мені шкода, що змарнувала ще одну його частку.",shape=box,color=blue];
		j372269021 -> j3007723528;
	j1741968839 [label="Він спеціалізувався на криптографії. І його роботи в тутешніх архівах, у лабораторіях.",shape=box,color=red];
		j1741968839 -> j2259989536;
	j1126504980 [label="+5 Chemistry",color=orange];
		j1126504980 -> j2034895793;
	j3007723528 [label="Boolean MarieOtakComplete is now true.",color=orange];
		j3007723528 -> "Chat ends.";
	j2259989536 [label="З якихось причин, невідомих мені, його перетворили на цефалона й дали власну оболонку некралойда.",shape=box,color=red];
		j2259989536 -> j1015652735;
	j2034895793 [label="Я чомусь так і подумала… Ну, він спитав мене звідки я. Коли ж відповіла, то він зареготаві і сказав: «Ні, цього не може бути. Я точно знаю, я ж…»",shape=box,color=blue];
		j2034895793 -> j2694304766;
	j1015652735 [label="Не всіх робили цефалонами в покарання. Але на Деймосі все пішло… м'яко кажучи, шкереберть. Його сильно пошкодило.",shape=box,color=red];
		j1015652735 -> j3263344937;
	j2694304766 [label="І… знову назвався мені й почав знайомитися. І спитав, чи я не принесла з собою зразки мінералів…",shape=box,color=blue];
		j2694304766 -> j3813982372;
		j2694304766 -> j519678860;
	j3263344937 [label="Pauvre petit…",shape=box,color=blue];
		j3263344937 -> j1698645168;
	j3813982372 [label="Ох, Марі. Мені так шкода…",shape=box,color=red];
		j3813982372 -> j3030356564;
	j519678860 [label="Так… такий він, Отак.",shape=box,color=red];
		j519678860 -> j3030356564;
	j1698645168 [label="Boolean MarieOtak1 is now true.",color=orange];
		j1698645168 -> j2249822535;
		j1698645168 -> j964642882;
	j3030356564 [label="Мене це ранить мільярдами ран — те, що нічого для нього зробити не можна.",shape=box,color=blue];
		j3030356564 -> j1970966774;
	j1970966774 [label="Evaluate expressions",color=orange];
		j1970966774 -> j1171597505 [label="MarieCephalonSoul",color=purple];
		j1970966774 -> j3778044975 [label="MarieCephalonNoSoul",color=purple];
		j1970966774 -> j1253763180 [label="MarieCephalonUnsure",color=purple];
		j1970966774 -> j1967509870 [label="false",color=purple];
	j1171597505 [label="О, Світочі, що ж за пекло ви йому таке створили, що душа застрягла в клітці з науки та мерехтливих вогників ?",shape=box,color=blue];
		j1171597505 -> j2857224339;
	j3778044975 [label="Я можу лише молитися Світочам, щоб твої слова були правдою, і нічого не було в тій оболонці… окрім науки та мерехтливих вогників.",shape=box,color=blue];
		j3778044975 -> j3618414348;
	j1253763180 [label="Я знаю про твою невпевненість у наявності душі в цефалонів. Але молитимуся Світочам, щоб… щоб бідолашний Отак не страждав.",shape=box,color=blue];
		j1253763180 -> j2168602807;
	j1967509870 [label="Я можу лише молитися Світочам, щоб нічого не було в тій оболонці… нічого, окрім науки та мерехтливих вогників.",shape=box,color=blue];
		j1967509870 -> j2383611736;
	j2857224339 [label="Для чого його лишати тут, поламаного ? Щоб він чекав дозволу померти й знайти омріяний спокій ? Я можу лише молитися… що якщо там щось лишилося…",shape=box,color=blue];
		j2857224339 -> j1879781496;
	j3618414348 [label="І нема душі в тій поламаній штуці, яка чекає дозволу нарешті померти й знайти омріяний спокій.",shape=box,color=blue];
		j3618414348 -> j1036252512;
	j2168602807 [label="Що нема душі в тій поламаній штуці, яка чекає дозволу нарешті померти й знайти омріяний спокій.",shape=box,color=blue];
		j2168602807 -> j1309420659;
	j2383611736 [label="І нема душі в тій поламаній штуці, яка чекає дозволу нарешті померти й знайти омріяний спокій.",shape=box,color=blue];
		j2383611736 -> j1309420659;
	j1879781496 [label="То це через те, що він захотів так сам — сам обрав нести цю обітницю…",shape=box,color=blue];
		j1879781496 -> j3874904588;
	j1036252512 [label="Бо якщо ти помиляєшся і душа в тій клітці супроти своєї волі ?",shape=box,color=blue];
		j1036252512 -> j3222140232;
	j1309420659 [label="Чи якщо там щось лишилося, то це через те, що він захотів так сам — сам обрав нести цю обітницю.",shape=box,color=blue];
		j1309420659 -> j3874904588;
	j3874904588 [label="Думати інакше якраз достатньо, щоби піддати сумнівам доброту богів, non ?",shape=box,color=blue];
		j3874904588 -> j1021616182;
	j3222140232 [label="Цього ж достатньо, щоби піддати сумнівам доброту богів, non ?",shape=box,color=blue];
		j3222140232 -> j1021616182;
	j1021616182 [label="І як тоді мені самій бути ?",shape=box,color=blue];
		j1021616182 -> j1960346334;
	j1960346334 [label="Пробач мені… je suis mélancolique aujourd'hui.",shape=box,color=blue];
		j1960346334 -> j4190999030;
	j4190999030 [label="Evaluate expressions",color=orange];
		j4190999030 -> j2401620625 [label="MarieRoathePastry1",color=purple];
		j4190999030 -> j1831699569 [label="MarieRoathePastry1",color=purple];
		j4190999030 -> j3380542853 [label="MarieRoathePastry1",color=purple];
		j4190999030 -> j2818099019 [label="MarieRoathePastry1",color=purple];
		j4190999030 -> j2401620625 [label="RoatheMariePastry1",color=purple];
		j4190999030 -> j1831699569 [label="RoatheMariePastry1",color=purple];
		j4190999030 -> j3380542853 [label="RoatheMariePastry1",color=purple];
		j4190999030 -> j2818099019 [label="RoatheMariePastry1",color=purple];
		j4190999030 -> j2401620625 [label="false",color=purple];
		j4190999030 -> j3380542853 [label="false",color=purple];
		j4190999030 -> j2818099019 [label="false",color=purple];
	j2401620625 [label="Я можу щось зробити, щоб розвеселити тебе? Можемо сходити разом катувати Роута.",shape=box,color=red];
		j2401620625 -> j2310543114;
	j1831699569 [label="Я можу щось зробити, щоб розвеселити тебе? Може, викрасти якусь смачну випічку?",shape=box,color=red];
		j1831699569 -> j2622681859;
	j3380542853 [label="Марі, боги іноді жорстокі. Такий плин життя.",shape=box,color=red];
		j3380542853 -> j4136593815;
	j2818099019 [label="Усе добре. Ти маєш повне право бути такою.",shape=box,color=red];
		j2818099019 -> j2553408238;
	j2310543114 [label="+15 Chemistry",color=orange];
		j2310543114 -> j2791143755;
	j2622681859 [label="+20 Chemistry",color=orange];
		j2622681859 -> j2791143755;
	j4136593815 [label="+5 Chemistry",color=orange];
		j4136593815 -> j1502297567;
	j2553408238 [label="+20 Chemistry",color=orange];
		j2553408238 -> j1096692576;
	j2791143755 [label="Ха ! Merci. Це точно зупинить потік цих дурних сліз. А ти добре знаєш, як звеселити дурненьку маленьку Марі, non ?",shape=box,color=blue];
		j2791143755 -> j451243422;
		j2791143755 -> j1959420444;
	j1502297567 [label="Oui. Твоя правда. Вони такі. Світ сповнений історій, подібних до оповіді про монсеньйора Отака, а ще більше набагато гірших. Не варто ридати над кожною з них. ",shape=box,color=blue];
		j1502297567 -> j1107821470;
	j1096692576 [label="Merci. Але я більше не хочу. Робитиму щось веселеньке ! Думаю, настала черга витерти пил з акваріума мсьє Фібоначчі.",shape=box,color=blue];
		j1096692576 -> j2425134241;
	j451243422 [label="Ти геть не дурненька. Я почуваюся так само.",shape=box,color=red];
		j451243422 -> j2235898819;
	j1959420444 [label="Це найменше, що я можу для тебе зробити.",shape=box,color=red];
		j1959420444 -> j2235898819;
	j1107821470 [label="Однак я досі тут сиджу і досі ридаю. Дякую, що нагадуєш мені про мою тупу натуру. Fie ! Дурненька маленька Марі. Що ж… Думаю, варто витерти пил з акваріума мсьє Фібоначчі.",shape=box,color=blue];
		j1107821470 -> j2425134241;
	j2425134241 [label="Check boolean MarieDating",color=orange];
		j2425134241 -> j3435079465 [label=true,color=green];
		j2425134241 -> j1783435543 [label=false,color=brown];
	j2235898819 [label="+5 Chemistry",color=orange];
		j2235898819 -> j4093292054;
	j3435079465 [label="À la revoyure, моє вовченя.",shape=box,color=blue];
		j3435079465 -> j3007723528;
	j1783435543 [label="À la revoyure !",shape=box,color=blue];
		j1783435543 -> j3007723528;
	j4093292054 [label="Check boolean MarieDating",color=orange];
		j4093292054 -> j910735012 [label=true,color=green];
		j4093292054 -> j2580241406 [label=false,color=brown];
	j910735012 [label="Merci, merci, merci, моє вовченя. Ходімо побешкетуймо. ",shape=box,color=blue];
		j910735012 -> j3007723528;
	j2580241406 [label="Merci, merci, merci. Ходімо побешкетуймо.",shape=box,color=blue];
		j2580241406 -> j3007723528;
}