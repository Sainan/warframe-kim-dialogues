	3138 [label="Check boolean MarieDating",color=orange];
		3138 -> 3142 [label=true,color=green];
		3138 -> 3141 [label=false,color=brown];
	3139 [label="Вовченя ! Моє вовченя ! Я зустрілася з Отаком ! Нарешті ми познайомилися !",shape=box,color=blue];
		3139 -> 3143;
		3139 -> 3144;
	3140 [label="Я зустрілася з Отаком ! Нарешті ми познайомилися !",shape=box,color=blue];
		3140 -> 3143;
		3140 -> 3144;
	3142 [label="Вовченя ! Моє вовченя ! Обличчя позаду монсеньйора Некралойда ! Ми нарешті познайомилися !",shape=box,color=blue];
		3142 -> 3145;
		3142 -> 3146;
		3142 -> 3147;
	3141 [label="Обличчя позаду монсеньйора Некралойда ! Ми нарешті познайомилися !",shape=box,color=blue];
		3141 -> 3145;
		3141 -> 3146;
		3141 -> 3147;
	3143 [label="І як пройшла розмова?",shape=box,color=red];
		3143 -> 3148;
	3144 [label="Тобі сподобалося балакати з ним?",shape=box,color=red];
		3144 -> 3149;
	3145 [label="Ти познайомилася з Отаком? Лишенько… І як усе пройшло?",shape=box,color=red];
		3145 -> 3150;
	3146 [label="Тішуся з вашого знайомства. Отака іноді буває складно сприйняти.",shape=box,color=red];
		3146 -> 3151;
	3147 [label="Бідолашний Отак… І як усе пройшло?",shape=box,color=red];
		3147 -> 3152;
	3148 [label="Він… тричі за одну бесіду знайомився зі мною, наче ми були до цього не знайомі.",shape=box,color=blue];
		3148 -> 3153;
	3149 [label="Так. Хоча хотілося плакати від неї. Він… тричі за одну бесіду знайомився зі мною, наче ми були до цього не знайомі.",shape=box,color=blue];
		3149 -> 3153;
	3150 [label="А чого я між рядків читаю, що ти наче не дуже радієш нашому знайомству ?",shape=box,color=blue];
		3150 -> 3154;
		3150 -> 3155;
		3150 -> 3156;
	3151 [label="Та, думаю так. Дитячі каракулі на спині автоматона. Виявилося, що то дуже мила й чарівна особистість !",shape=box,color=blue];
		3151 -> 3157;
	3152 [label="Він виявився дуже милим і чарівним ! Але десь за товстими шарами гумору я відчула зранену душу.",shape=box,color=blue];
		3152 -> 3158;
	3153 [label="Він вітав мене так само незворушно й радісно, як попередні рази. Але ж я вже казала, що я Sœur de Sol ! ",shape=box,color=blue];
		3153 -> 3159;
	3154 [label="Мені шкода. Він іноді може довести до сказу. Але це не його провина.",shape=box,color=red];
		3154 -> 3160;
	3155 [label="Я не про те. Він просто іноді буває… трохи відштовхує своєю поведінкою.",shape=box,color=red];
		3155 -> 3160;
	3156 [label="Він іноді мене дуже бісить. От і все. ",shape=box,color=red];
		3156 -> 3161;
	3157 [label="Але десь за товстими шарами гумору я відчула зранену душу.",shape=box,color=blue];
		3157 -> 3158;
	3158 [label="Ти розповіси мені історію бідолашного монсеньйора Отака ?",shape=box,color=blue];
		3158 -> 3162;
	3159 [label="І справді, він чимало знав про Світочі ! Ми багато говорили про «прадавні релігії» (це він так назвав їх) у часи «до орокінської імперії».",shape=box,color=blue];
		3159 -> 3163;
	3160 [label="Я маю надію, що зрештою вони всі виявляли доброту й терплячість. Mais par la grâce de Sol, бо ми всі такі.",shape=box,color=blue];
		3160 -> 3164;
	3161 [label="Сподіваюся, ти намагатимешся виявляти більше доброти до того, хто явно не при собі. Зрештою, усі ми під Солом ходимо.",shape=box,color=blue];
		3161 -> 3164;
	3162 [label="Отак колись був архімедівцем, орокінським ученим і академіком. А подальша історія не з тих, що зі щасливим завершенням.",shape=box,color=red];
		3162 -> 3165;
	3163 [label="Ще він казав, що велика частина з тих знань давно втрачена, десь у глибинах архівів і дуже-дуже заборонена. Вимагав присяги на мовчання.",shape=box,color=blue];
		3163 -> 3166;
	3164 [label="Така доля може спіткати нас усіх. Навіть тебе.",shape=box,color=blue];
		3164 -> 3167;
		3164 -> 3168;
	3165 [label="З усіх подій стає зрозумілим, що він був генієм і тим, хто опанував використання кристалів аргону.",shape=box,color=red];
		3165 -> 3169;
	3166 [label="Він мені розповів про глибоке незапокоєння тим, що виконавець Баллас (хто б він не був) може знайти мою єретичну секту й стратити мене особисто.",shape=box,color=blue];
		3166 -> 3170;
		3166 -> 3171;
	3167 [label="Ти вибач, але в мене бракує вільного часу, щоб ще й на нього його витрачати.",shape=box,color=red];
		3167 -> 3172;
	3168 [label="Саме так. Твоя правда. Не це малося на увазі.",shape=box,color=red];
		3168 -> 3158;
	3169 [label="А вони походять із Порожнечі. І саме завдяки їм ми можемо створювати чимало ворфреймів та потужну зброю.",shape=box,color=red];
		3169 -> 3173;
	3170 [label="Цього… не станеться. Тож розповідай далі.",shape=box,color=red];
		3170 -> 3174;
	3171 [label="Баллас мертвий… продовжуй.",shape=box,color=red];
		3171 -> 3174;
	3172 [label="Тоді мені шкода, що змарнувала ще одну його частку.",shape=box,color=blue];
		3172 -> 3175;
	3173 [label="Він спеціалізувався на криптографії. І його роботи в тутешніх архівах, у лабораторіях.",shape=box,color=red];
		3173 -> 3176;
	3174 [label="+5 Chemistry",color=orange];
		3174 -> 3177;
	3175 [label="Update boolean MarieOtakComplete",color=orange];
		3175 -> 3178;
	3176 [label="З якихось причин, невідомих мені, його перетворили на цефалона й дали власну оболонку некралойда.",shape=box,color=red];
		3176 -> 3179;
	3177 [label="Я чомусь так і подумала… Ну, він спитав мене звідки я. Коли ж відповіла, то він зареготаві і сказав: «Ні, цього не може бути. Я точно знаю, я ж…»",shape=box,color=blue];
		3177 -> 3180;
	3178 [label="Chat ends.",color=orange];
	3179 [label="Не всіх робили цефалонами в покарання. Але на Деймосі все пішло… м'яко кажучи, шкереберть. Його сильно пошкодило.",shape=box,color=red];
		3179 -> 3181;
	3180 [label="І… знову назвався мені й почав знайомитися. І спитав, чи я не принесла з собою зразки мінералів…",shape=box,color=blue];
		3180 -> 3182;
		3180 -> 3183;
	3181 [label="Pauvre petit…",shape=box,color=blue];
		3181 -> 3184;
	3182 [label="Ох, Марі. Мені так шкода…",shape=box,color=red];
		3182 -> 3185;
	3183 [label="Так… такий він, Отак.",shape=box,color=red];
		3183 -> 3185;
	3184 [label="Update boolean MarieOtak1",color=orange];
		3184 -> 3143;
		3184 -> 3144;
	3185 [label="Мене це ранить мільярдами ран — те, що нічого для нього зробити не можна.",shape=box,color=blue];
		3185 -> 3186;
	3186 [label="Evaluate expressions",color=orange];
		3186 -> 3190 [label="MarieCephalonSoul",color=purple];
		3186 -> 3189 [label="MarieCephalonNoSoul",color=purple];
		3186 -> 3188 [label="MarieCephalonUnsure",color=purple];
		3186 -> 3187 [label="false",color=purple];
	3190 [label="О, Світочі, що ж за пекло ви йому таке створили, що душа застрягла в клітці з науки та мерехтливих вогників ?",shape=box,color=blue];
		3190 -> 3194;
	3189 [label="Я можу лише молитися Світочам, щоб твої слова були правдою, і нічого не було в тій оболонці… окрім науки та мерехтливих вогників.",shape=box,color=blue];
		3189 -> 3193;
	3188 [label="Я знаю про твою невпевненість у наявності душі в цефалонів. Але молитимуся Світочам, щоб… щоб бідолашний Отак не страждав.",shape=box,color=blue];
		3188 -> 3192;
	3187 [label="Я можу лише молитися Світочам, щоб нічого не було в тій оболонці… нічого, окрім науки та мерехтливих вогників.",shape=box,color=blue];
		3187 -> 3191;
	3194 [label="Для чого його лишати тут, поламаного ? Щоб він чекав дозволу померти й знайти омріяний спокій ? Я можу лише молитися… що якщо там щось лишилося…",shape=box,color=blue];
		3194 -> 3197;
	3193 [label="І нема душі в тій поламаній штуці, яка чекає дозволу нарешті померти й знайти омріяний спокій.",shape=box,color=blue];
		3193 -> 3196;
	3192 [label="Що нема душі в тій поламаній штуці, яка чекає дозволу нарешті померти й знайти омріяний спокій.",shape=box,color=blue];
		3192 -> 3195;
	3191 [label="І нема душі в тій поламаній штуці, яка чекає дозволу нарешті померти й знайти омріяний спокій.",shape=box,color=blue];
		3191 -> 3195;
	3197 [label="То це через те, що він захотів так сам — сам обрав нести цю обітницю…",shape=box,color=blue];
		3197 -> 3200;
	3196 [label="Бо якщо ти помиляєшся і душа в тій клітці супроти своєї волі ?",shape=box,color=blue];
		3196 -> 3199;
	3195 [label="Чи якщо там щось лишилося, то це через те, що він захотів так сам — сам обрав нести цю обітницю.",shape=box,color=blue];
		3195 -> 3198;
	3200 [label="Думати інакше якраз достатньо, щоби піддати сумнівам доброту богів, non ?",shape=box,color=blue];
		3200 -> 3201;
	3199 [label="Цього ж достатньо, щоби піддати сумнівам доброту богів, non ?",shape=box,color=blue];
		3199 -> 3201;
	3198 [label="Думати інакше якраз достатньо, щоби піддати сумнівам доброту богів, non ?",shape=box,color=blue];
		3198 -> 3201;
	3201 [label="І як тоді мені самій бути ?",shape=box,color=blue];
