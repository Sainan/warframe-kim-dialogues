	2720 [label="Це ми ще побачимо. Знаєш, гадаю, що таки зрештою я бачила в ньому дещицю батька, який покинув мене. Хоч би як низько й сумно це не видавалося мені зараз.",shape=box,color=blue];
		2720 -> 2727;
	2721 [label="Chat ends.",color=orange];
	2722 [label="Але мені потрібно було, щоб ти побачила, яким Ентраті може бути складним. Він може несе рівнозначну шкоду з собою. Мені не хотілося, щоб тобі було потім гірше.",shape=box,color=red];
		2722 -> 2728;
