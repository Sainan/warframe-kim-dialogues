	2738 [label="Au revoir.",shape=box,color=blue];
		2738 -> 2744;
	2739 [label="[Зізнатися в почуттях] Марі, ти не дурепа. Зовсім ні. Це щось таке, що ще раз доводить мені, яка ти дивовижна насправді.",shape=box,color=red];
		2739 -> 2745;
	2740 [label="І ти мені все це пишеш, водночас зізнаючись у коханні моєму братові по духу ?! Ти нас обох маєш за дурнів ?!",shape=box,color=blue];
		2740 -> 2746;
	2741 [label="І ти мені все це пишеш, водночас розважаючись із дияволом?! Сподіваєшся нас обох мати за дурнів ?!",shape=box,color=blue];
		2741 -> 2746;
	2742 [label="Я… ох, mon cœur. Mon cœur ! О, я відчуваю те саме ! Але не насмілилися зізнатися, не змогла написати. Бо вважала себе дурепою за таке.",shape=box,color=blue];
		2742 -> 2747;
	2743 [label="Oui, усе як у твоїх розповідях. Я тепер це чітко бачу. Я… що ж, лише подякую ще раз за твою терплячість.",shape=box,color=blue];
