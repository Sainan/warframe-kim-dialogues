digraph {
	2615 [label="MarieEntratiDay2 begins.",color=orange];
		2615 -> 2616;
	2616 [label="Мандрівниче, я трохи подумала… і заспокоїлася. Маю собі за суворе правило: «Не вступати в бесіди, допоки лютую».",shape=box,color=blue];
		2616 -> 2617;
	2617 [label="Evaluate expressions",color=orange];
		2617 -> 2618 [label="MarieEntrati5a",color=purple];
		2617 -> 2619 [label="MarieEntrati5b",color=purple];
		2617 -> 2620 [label="MarieEntrati5c",color=purple];
		2617 -> 2621 [label="MarieEntrati5d",color=purple];
		2617 -> 2622 [label="MarieEntrati5e",color=purple];
		2617 -> 2623 [label="MarieEntrati5f",color=purple];
		2617 -> 2624 [label="MarieEntrati5g",color=purple];
		2617 -> 2625 [label="MarieEntrati5h",color=purple];
		2617 -> 2626 [label="MarieEntrati5i",color=purple];
		2617 -> 2627 [label="false",color=purple];
	2618 [label="Ти… твої вчорашні слова були як ніж під ребра. Я втекла в гніві, oui, але й з répulsion. Не до тебе, до себе.",shape=box,color=blue];
		2618 -> 2628;
	2619 [label="Перш ніж ми продовжимо, то я хочу звернути увагу на дещо — форму твоїх слів до мене. Ти вважаєш мене дитиною. Бо старше на кілька століть, якщо не більше.",shape=box,color=blue];
		2619 -> 2629;
	2620 [label="Я довго міркувала над твоїми словами. Що це не священна війна… що це le Cardinal маніпулює всім.",shape=box,color=blue];
		2620 -> 2630;
	2621 [label="Ти… звісно, твоє було право спитати мене, де у вченнях Сола було сказано, що невинні — витратний матеріал. Ніде.",shape=box,color=blue];
		2621 -> 2631;
	2622 [label="Перш ніж ми продовжимо, то я хочу звернути увагу на дещо — твою готовність використати мою віру проти мене в суперечці, коли не маєш власної віри.",shape=box,color=blue];
		2622 -> 2632;
	2623 [label="Я… мені шкода, що втекла під час нашої вчорашньої розмови. Це вже було просто занадто. Однак маю спитати, перш ніж ми продовжимо. Твої слова були серйозними ? Чи то якась маніпуляція моїми почуттями, щоб викрутитися з незручної суперечки ?",shape=box,color=blue];
		2623 -> 2633;
		2623 -> 2634;
	2624 [label="Схоже, ми зайшли в глухий кут стосовно le Cardinal, oui ? Ви бачите в ньому monstre, а я святого.",shape=box,color=blue];
		2624 -> 2635;
	2625 [label="Я хочу поговорити з тобою про твоє рішення бути на боці Ентраті лише для того, щоб отримати мою прихильність. Якщо ти не проти.",shape=box,color=blue];
		2625 -> 2636;
	2626 [label="Я хочу поговорити з тобою про твою брехню. Просто зараз. Якщо ти не проти.",shape=box,color=blue];
		2626 -> 2636;
	2627 [label="Chat ends.",color=orange];
	2628 [label="Чого б це мене мала дивувати твоя смертоносна точність влучання ? Порівняти мої слова з дияволовими…",shape=box,color=blue];
		2628 -> 2637;
	2629 [label="Тобі ж довелося мандрувати невідомими вимірами та ще й крізь саму Порожнечу. Битися з богами та янголами. Хто я для тебе ? Лише якась маленька дурненька Марі.",shape=box,color=blue];
		2629 -> 2638;
	2630 [label="Знаєш… oui, твоя правда. Це не священна війна. Бо такої не буває. Війна ніколи не священна чи праведна. Біль ніколи не має бути вказівником.",shape=box,color=blue];
		2630 -> 2639;
	2631 [label="Війна ніколи не священна чи праведна. Біль ніколи не має бути вказівником.",shape=box,color=blue];
		2631 -> 2639;
	2632 [label="Мандрівниче, то було нещиро. Жорстоко й не дієво. Це була спроба «перемогти» у розмові. Так не варто поводитися.",shape=box,color=blue];
		2632 -> 2640;
	2633 [label="Мої слова були серйозними. Мені шкода, що час підібрано… не дуже вдало. Марі, ти мені дуже небайдужа…",shape=box,color=red];
		2633 -> 2641;
	2634 [label="Так, то було не серйозно. Я… просто раптово щось найшло. Мені дуже-дуже шкода. Була гаряча суперечка.",shape=box,color=red];
		2634 -> 2642;
	2635 [label="Однак… Я не хочу, щоб між нами все так і лишилося. У тебе добра душа, між нами є щось таке, що не хотілося б утратити.",shape=box,color=blue];
		2635 -> 2946;
	2636 [label="Спроба повернути ситуацію так, щоб контролювати мої почуття… жорстока й негідна. Скажу прямо — я ненавиджу тебе за це, мандрівниче.",shape=box,color=blue];
		2636 -> 2644;
	2637 [label="Я звикла вважати себе тою, чиє серце й розум відкриті до світу та всіх у ньому. А тобі ж удалося єдиною зазубреною стрілою довести хибність цієї думки.",shape=box,color=blue];
		2637 -> 2645;
	2638 [label="Якщо поглянути під певним кутом, то я розумію. Співчуваю, навіть. Ми спілкувалися на підвищених тонах. Але все ж дуже прошу ставитися до мене витонченіше й тактовніше, аніж ти це робиш.",shape=box,color=blue];
		2638 -> 2646;
	2639 [label="Навіть те, що ми робимо зараз — нищимо Murmure і б’ємося супроти твоїх численних ворогів — це не шлях Світочів.",shape=box,color=blue];
		2639 -> 2647;
	2640 [label="Віра не є зброєю і не повинна використовуватися проти інших. Це щит. Світло у темряві. Голос, який вкаже шлях.",shape=box,color=blue];
		2640 -> 2648;
	2641 [label="Перш ніж я перейду… до ненормальності цього всього… Я маю пояснити своє ставлення до le Cardinal, s'il vous plaît.",shape=box,color=blue];
		2641 -> 2649;
	2642 [label="Update boolean DrifterMarie",color=orange];
		2642 -> 2650;
	2946 [label="Check boolean LoidFamilyComplete",color=orange];
		2946 -> 2651 [label=true,color=green];
		2946 -> 2643 [label=false,color=brown];
	2644 [label="Однак… Я не хочу, щоб між нами все так і лишилося. Між нами є щось таке, що не хотілося б утратити.",shape=box,color=blue];
		2644 -> 1395;
	2645 [label="Припускаю, я тут для pour m'excuser — щиро перепросити за те, що так безглуздо впиралася. Сподіваюся, ти розумієш.",shape=box,color=blue];
		2645 -> 2653;
		2645 -> 2654;
	2646 [label="Я жила на вулицях. Я щодня жила в неймовірній фізичній agonie. Моє серце розбивалося, я знала любов, я знала страх і неприйняття. Я знала життя і знала втрати.",shape=box,color=blue];
		2646 -> 2655;
	2647 [label="Попри те, що меч потрібно здіймати, щоб захистити світ від подібного зла, не варто поклонятися зброї. І точно цьому немає виправдання, якщо внаслідок цього страждають невинні.",shape=box,color=blue];
		2647 -> 2656;
	2648 [label="А ти намагаєшся використати її проти мене, щоби «перемогти» в суперечці ? Це ница тактика боягузів. Але ми двоє були на нервах, тож… я пробачу тобі, якщо ти пробачиш мені. За слова, сказані у гніві.",shape=box,color=blue];
		2648 -> 2657;
		2648 -> 2658;
	2649 [label="Знаєш, складно покинути захист le Cardinal… і знадобився деякий час, щоб усвідомити, чому я не могла його відпустити.",shape=box,color=blue];
		2649 -> 2659;
	2650 [label="Non, я розумію… Чимало вбивств скоєно «у пориві пристрасті», oui ? Напевно, стільки ж дітей зачато в такі ж миті.",shape=box,color=blue];
		2650 -> 2660;
	2651 [label="За такий короткий час я відчуваю твою важливість для мене… наші бесіди такі joyeuses.",shape=box,color=blue];
		2651 -> 2661;
	2643 [label="І справді, я досі хочу, щоб монсеньйор Лойд об’єднався з тими, хто нагорі. Я хотіла б утішити родину le Cardinal, а ти — дорога до цього ! ",shape=box,color=blue];
		2643 -> 2651;
	1395 [label="Check boolean LoidFamilyComplete",color=orange];
		1395 -> 2662 [label=true,color=green];
		1395 -> 2652 [label=false,color=brown];
	2653 [label="Так. І мені шкода, що ті слова ранили тебе. Не вдалося якось ліпше висловити думку.",shape=box,color=red];
		2653 -> 2663;
	2654 [label="Дуже добре, що мої слова дійшли до тебе. Бо вже надія вже згасала.",shape=box,color=red];
		2654 -> 2664;
	2655 [label="І якщо ти так істинно віриш у те, що настільки вище від нас усіх, то побачиш нічого окрім хмар, у яких не зможеш знайти себе.",shape=box,color=blue];
		2655 -> 2657;
		2655 -> 2658;
	2656 [label="Тож… Я визнаю, що le Cardinal не має права кривдити інших в «ім’я більшого блага».",shape=box,color=blue];
		2656 -> 2665;
	2657 [label="Я… то була фрустрація. Не вдавалося придумати як ще привести тебе до тями. Ентраті тобі не друг. І не батько.",shape=box,color=red];
		2657 -> 2666;
	2658 [label="Мені шкода. Я дозволила гніву взяти гору й сказала те, що не думала і не мала на увазі.",shape=box,color=red];
		2658 -> 2667;
	2659 [label="Я дуже не хочу почуватися приниженою тобою, якщо зізнаюся у всій правді. Бо воно видається таким дрібним і pathétique.",shape=box,color=blue];
		2659 -> 2668;
		2659 -> 2669;
	2660 [label="Я… розчарована. Скривджена. Але я… пробачаю тобі.",shape=box,color=blue];
		2660 -> 2670;
	2661 [label="Evaluate expressions",color=orange];
		2661 -> 2671 [label="DrifterMarie",color=purple];
		2661 -> 2672 [label="DrifterLyon",color=purple];
		2661 -> 2673 [label="DrifterRoathe",color=purple];
		2661 -> 2674 [label="false",color=purple];
	2662 [label="І ще стільки добра ти досі можеш зробити моєму Ліону… і, напевно, навіть дияволу…",shape=box,color=blue];
		2662 -> 2675;
		2662 -> 2676;
	2652 [label="І справді, я досі хочу, щоб монсеньйор Лойд об’єднався з тими, хто нагорі. Я хотіла б утішити родину le Cardinal, а ти — дорога до цього ! ",shape=box,color=blue];
		2652 -> 2662;
	2663 [label="+10 Chemistry",color=orange];
		2663 -> 2677;
	2664 [label="Знаєш, є дещо особливе в люб’язності «переможців» до переможених.",shape=box,color=blue];
		2664 -> 2678;
		2664 -> 2679;
	2665 [label="Бо ж яке «більше благо» може бути, якщо на його шляху не лишається нічого окрім розкраяних сердець та понівечених життів ?",shape=box,color=blue];
		2665 -> 2645;
	2666 [label="Non. Він мені не батько. Батько покинув мене дитиною на вулиці, а le Cardinal навіть і близько не такий жорстокий.",shape=box,color=blue];
		2666 -> 2680;
	2667 [label="Чимало жахливого було скоєно під впливом пристрасті. Такий порядок речей. ",shape=box,color=blue];
		2667 -> 2681;
	2668 [label="Здається, я знаю, про що ти. ",shape=box,color=red];
		2668 -> 2682;
	2669 [label="Я не принижуватиму тебе й не думатиму погано. Марі, я обіцяю.",shape=box,color=red];
		2669 -> 2683;
	2670 [label="І… завершімо розмову про le Cardinal, якщо можна, s'il te plaît ? Я відкладу роз’ятрене серце вбік.",shape=box,color=blue];
		2670 -> 2684;
	2671 [label="І справді, як я можу відштовхнути тебе, коли знаю про твої почуття ?",shape=box,color=blue];
		2671 -> 2685;
	2672 [label="І справді, як я можу відштовхнути тебе, коли знаю про твої почуття до нашого дорогого Ліона ? Тобі може вдатися принести йому багато спокою… багато втіхи…",shape=box,color=blue];
		2672 -> 2685;
	2673 [label="І справді, як я можу відштовхнути тебе, коли знаю про твої почуття до диявола ? Я не розумію подібних смаків, але… Ти ж усе одно на нашій стороні, oui ?",shape=box,color=blue];
		2673 -> 2685;
	2674 [label="Не хочу втрачати подібну компанію. Чи можемо відкласти це вбік і сказати, що в дечому можемо не погоджуватися, але спілкуватися далі ?",shape=box,color=blue];
		2674 -> 2686;
		2674 -> 2687;
	2675 [label="Марі, зажди. Прошу. Дай мені перепросити.",shape=box,color=red];
		2675 -> 2688;
	2676 [label="Чесно, було невтямки, що мої слова матимуть значення для тебе… Не було думки, що це буде важливим для тебе.",shape=box,color=red];
		2676 -> 2688;
	2677 [label="Я ціную це більше, аніж ти можеш подумати. Дякую тобі.",shape=box,color=blue];
		2677 -> 2689;
	2678 [label="То були дурощі.",shape=box,color=red];
		2678 -> 2690;
	2679 [label="Вибач. Я не часто «перемагаю».",shape=box,color=red];
		2679 -> 2691;
	2680 [label="Update boolean MarieFamilyFail",color=orange];
		2680 -> 2692;
	2681 [label="+5 Chemistry",color=orange];
		2681 -> 2693;
	2682 [label="Припускаю, що для тебе це було очевидним, non ? Ти ж теж без famille. ",shape=box,color=blue];
		2682 -> 2694;
	2683 [label="Це ми ще побачимо. Знаєш, гадаю, що таки зрештою я бачила в ньому дещицю батька, який покинув мене. Хоч би як низько й сумно це не видавалося мені зараз.",shape=box,color=blue];
		2683 -> 2694;
	2684 [label="Знаєш, складно покинути захист le Cardinal… і знадобився деякий час, щоб усвідомити, чому я не могла його відпустити.",shape=box,color=blue];
		2684 -> 2695;
	2685 [label="Чи можемо відкласти це вбік і сказати, що в дечому можемо не погоджуватися, але спілкуватися далі ?",shape=box,color=blue];
		2685 -> 2686;
		2685 -> 2687;
	2686 [label="Ні, мені ще не до кінця все зрозуміло. Потрібно завершити розмову логічно.",shape=box,color=red];
		2686 -> 2696;
	2687 [label="Гадаю, це справедливо. Згода.",shape=box,color=red];
		2687 -> 2697;
	2688 [label="Мандрівниче, я пробачу тобі твою брехню. Ми можемо й далі бути друзями та союзниками. Але нащо було брехати саме так ? Намагаючись зробити… що ?",shape=box,color=blue];
		2688 -> 2698;
	2689 [label="Знаєш, складно покинути défense le Cardinal… і знадобився деякий час, щоб усвідомити, чому я не могла його відпустити.",shape=box,color=blue];
		2689 -> 2699;
	2690 [label="Oui, так, що ж. ",shape=box,color=blue];
		2690 -> 2689;
	2691 [label="+5 Chemistry",color=orange];
		2691 -> 2690;
	2692 [label="Add -10 to Family",color=orange];
		2692 -> 2700;
	2693 [label="Я приймаю твої вибачення… бо дозволила гніву керувати кілька секунд собою.",shape=box,color=blue];
		2693 -> 2701;
	2694 [label="Лише вдуматися… після стількох таких років я потягнулася до когось, хто пропонував стільки доброти ?",shape=box,color=blue];
		2694 -> 2702;
	2695 [label="Я дуже не хочу почуватися приниженою тобою, якщо зізнаюся у всій правді. Бо вона видається такою дрібною й pathétique.",shape=box,color=blue];
		2695 -> 2703;
		2695 -> 2704;
	2696 [label="Update boolean MarieFamilyFail",color=orange];
		2696 -> 2705;
	2697 [label="+5 Chemistry",color=orange];
		2697 -> 2706;
	2698 [label="Check boolean DrifterMarieWhoops",color=orange];
		2698 -> 2707 [label=true,color=green];
		2698 -> 2708 [label=false,color=brown];
	2699 [label="Я дуже не хочу почуватися приниженою тобою, якщо зізнаюся у всій правді. Бо вона видається такою дрібною й pathétique.",shape=box,color=blue];
		2699 -> 2709;
		2699 -> 2710;
	2700 [label="Update boolean MarieEntratiCompleteB",color=orange];
		2700 -> 2711;
	2701 [label="Дозволь я просто… я думаю, що просто, поясню чому так складно покинути захист le Cardinal. І для чого знадобився деякий час, щоб усвідомити, чому я не могла його відпустити.",shape=box,color=blue];
		2701 -> 2699;
	2702 [label="Дурненька маленька Марі… звісно він був не тим, ким здавався.",shape=box,color=blue];
		2702 -> 2712;
		2702 -> 2713;
	2703 [label="Здається мені, що знаю про що ти. ",shape=box,color=red];
		2703 -> 2714;
	2704 [label="Я не принижуватиму тебе й не думатиму погано. Марі, я обіцяю.",shape=box,color=red];
		2704 -> 2715;
	2705 [label="Add -10 to Family",color=orange];
		2705 -> 2716;
	2706 [label="Bien. Принаймні в чомусь домовились.",shape=box,color=blue];
		2706 -> 2717;
	2707 [label="Залізти до мене в ліжко ? Гидка маячня.",shape=box,color=blue];
		2707 -> 2718;
	2708 [label="Використати мене ? Гидка маячня.",shape=box,color=blue];
		2708 -> 2718;
	2709 [label="Здається, я знаю, про що ти. ",shape=box,color=red];
		2709 -> 2719;
	2710 [label="Я не принижуватиму тебе й не думатиму погано. Марі, я обіцяю.",shape=box,color=red];
		2710 -> 2720;
	2711 [label="Update boolean MarieNoDate",color=orange];
		2711 -> 2721;
	2712 [label="Марі, ти не дурепа. Зовсім ні. Це щось таке, що ще раз доводить мені, яка ти дивовижна насправді.",shape=box,color=red];
		2712 -> 2722;
	2713 [label="Марі, ти стала дуже важливою для мене… мені шкода, що розмова пішла саме так.",shape=box,color=red];
		2713 -> 2722;
	2714 [label="Припускаю, що для тебе це було очевидним, non ? Ти ж теж без famille. ",shape=box,color=blue];
		2714 -> 2723;
	2715 [label="Це ми ще побачимо. Знаєш, гадаю, що таки зрештою я бачила в ньому дещицю батька, який покинув мене. Хоч би як низько й сумно це не видавалося мені зараз.",shape=box,color=blue];
