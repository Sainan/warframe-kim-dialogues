digraph {
	"MarieEntratiDay2 begins." [color=orange];
		"MarieEntratiDay2 begins." -> j1055042326;
	j1055042326 [label="Мандрівниче, я трохи подумала… і заспокоїлася. Маю собі за суворе правило: «Не вступати в бесіди, допоки лютую».",shape=box,color=blue];
		j1055042326 -> j69936295;
	j69936295 [label="Evaluate expressions",color=orange];
		j69936295 -> j513802406 [label="MarieEntrati5a",color=purple];
		j69936295 -> j1508153424 [label="MarieEntrati5b",color=purple];
		j69936295 -> j3030441904 [label="MarieEntrati5c",color=purple];
		j69936295 -> j2821913273 [label="MarieEntrati5d",color=purple];
		j69936295 -> j3581974724 [label="MarieEntrati5e",color=purple];
		j69936295 -> j3799311280 [label="MarieEntrati5f",color=purple];
		j69936295 -> j3519259273 [label="MarieEntrati5g",color=purple];
		j69936295 -> j3254921115 [label="MarieEntrati5h",color=purple];
		j69936295 -> j302288176 [label="MarieEntrati5i",color=purple];
		j69936295 -> "Chat ends." [label="false",color=purple];
	j513802406 [label="Ти… твої вчорашні слова були як ніж під ребра. Я втекла в гніві, oui, але й з répulsion. Не до тебе, до себе.",shape=box,color=blue];
		j513802406 -> j2986155601;
	j1508153424 [label="Перш ніж ми продовжимо, то я хочу звернути увагу на дещо — форму твоїх слів до мене. Ти вважаєш мене дитиною. Бо старше на кілька століть, якщо не більше.",shape=box,color=blue];
		j1508153424 -> j3345720635;
	j3030441904 [label="Я довго міркувала над твоїми словами. Що це не священна війна… що це le Cardinal маніпулює всім.",shape=box,color=blue];
		j3030441904 -> j1071369340;
	j2821913273 [label="Ти… звісно, твоє було право спитати мене, де у вченнях Сола було сказано, що невинні — витратний матеріал. Ніде.",shape=box,color=blue];
		j2821913273 -> j1526473072;
	j3581974724 [label="Перш ніж ми продовжимо, то я хочу звернути увагу на дещо — твою готовність використати мою віру проти мене в суперечці, коли не маєш власної віри.",shape=box,color=blue];
		j3581974724 -> j519562193;
	j3799311280 [label="Я… мені шкода, що втекла під час нашої вчорашньої розмови. Це вже було просто занадто. Однак маю спитати, перш ніж ми продовжимо. Твої слова були серйозними ? Чи то якась маніпуляція моїми почуттями, щоб викрутитися з незручної суперечки ?",shape=box,color=blue];
		j3799311280 -> j2798553711;
		j3799311280 -> j2487364186;
	j3519259273 [label="Схоже, ми зайшли в глухий кут стосовно le Cardinal, oui ? Ви бачите в ньому monstre, а я святого.",shape=box,color=blue];
		j3519259273 -> j1708588272;
	j3254921115 [label="Я хочу поговорити з тобою про твоє рішення бути на боці Ентраті лише для того, щоб отримати мою прихильність. Якщо ти не проти.",shape=box,color=blue];
		j3254921115 -> j321135164;
	j302288176 [label="Я хочу поговорити з тобою про твою брехню. Просто зараз. Якщо ти не проти.",shape=box,color=blue];
		j302288176 -> j321135164;
	"Chat ends." [color=orange];
	j2986155601 [label="Чого б це мене мала дивувати твоя смертоносна точність влучання ? Порівняти мої слова з дияволовими…",shape=box,color=blue];
		j2986155601 -> j1964091930;
	j3345720635 [label="Тобі ж довелося мандрувати невідомими вимірами та ще й крізь саму Порожнечу. Битися з богами та янголами. Хто я для тебе ? Лише якась маленька дурненька Марі.",shape=box,color=blue];
		j3345720635 -> j2576650485;
	j1071369340 [label="Знаєш… oui, твоя правда. Це не священна війна. Бо такої не буває. Війна ніколи не священна чи праведна. Біль ніколи не має бути вказівником.",shape=box,color=blue];
		j1071369340 -> j3093978413;
	j1526473072 [label="Війна ніколи не священна чи праведна. Біль ніколи не має бути вказівником.",shape=box,color=blue];
		j1526473072 -> j3093978413;
	j519562193 [label="Мандрівниче, то було нещиро. Жорстоко й не дієво. Це була спроба «перемогти» у розмові. Так не варто поводитися.",shape=box,color=blue];
		j519562193 -> j450227287;
	j2798553711 [label="Мої слова були серйозними. Мені шкода, що час підібрано… не дуже вдало. Марі, ти мені дуже небайдужа…",shape=box,color=red];
		j2798553711 -> j258683710;
	j2487364186 [label="Так, то було не серйозно. Я… просто раптово щось найшло. Мені дуже-дуже шкода. Була гаряча суперечка.",shape=box,color=red];
		j2487364186 -> j4233415325;
	j1708588272 [label="Однак… Я не хочу, щоб між нами все так і лишилося. У тебе добра душа, між нами є щось таке, що не хотілося б утратити.",shape=box,color=blue];
		j1708588272 -> j483300420;
	j321135164 [label="Спроба повернути ситуацію так, щоб контролювати мої почуття… жорстока й негідна. Скажу прямо — я ненавиджу тебе за це, мандрівниче.",shape=box,color=blue];
		j321135164 -> j1237556769;
	j1964091930 [label="Я звикла вважати себе тою, чиє серце й розум відкриті до світу та всіх у ньому. А тобі ж удалося єдиною зазубреною стрілою довести хибність цієї думки.",shape=box,color=blue];
		j1964091930 -> j1331683786;
	j2576650485 [label="Якщо поглянути під певним кутом, то я розумію. Співчуваю, навіть. Ми спілкувалися на підвищених тонах. Але все ж дуже прошу ставитися до мене витонченіше й тактовніше, аніж ти це робиш.",shape=box,color=blue];
		j2576650485 -> j689273918;
	j3093978413 [label="Навіть те, що ми робимо зараз — нищимо Murmure і б’ємося супроти твоїх численних ворогів — це не шлях Світочів.",shape=box,color=blue];
		j3093978413 -> j385510738;
	j450227287 [label="Віра не є зброєю і не повинна використовуватися проти інших. Це щит. Світло у темряві. Голос, який вкаже шлях.",shape=box,color=blue];
		j450227287 -> j1154052495;
	j258683710 [label="Перш ніж я перейду… до ненормальності цього всього… Я маю пояснити своє ставлення до le Cardinal, s'il vous plaît.",shape=box,color=blue];
		j258683710 -> j1455913552;
	j4233415325 [label="Boolean DrifterMarie is now false.",color=orange];
		j4233415325 -> j3058117134;
	j483300420 [label="Check boolean LoidFamilyComplete",color=orange];
		j483300420 -> j517454954 [label=true,color=green];
		j483300420 -> j4111407794 [label=false,color=brown];
	j1237556769 [label="Однак… Я не хочу, щоб між нами все так і лишилося. Між нами є щось таке, що не хотілося б утратити.",shape=box,color=blue];
		j1237556769 -> j3805730835;
	j1331683786 [label="Припускаю, я тут для pour m'excuser — щиро перепросити за те, що так безглуздо впиралася. Сподіваюся, ти розумієш.",shape=box,color=blue];
		j1331683786 -> j3826303358;
		j1331683786 -> j1517005950;
	j689273918 [label="Я жила на вулицях. Я щодня жила в неймовірній фізичній agonie. Моє серце розбивалося, я знала любов, я знала страх і неприйняття. Я знала життя і знала втрати.",shape=box,color=blue];
		j689273918 -> j4221577764;
	j385510738 [label="Попри те, що меч потрібно здіймати, щоб захистити світ від подібного зла, не варто поклонятися зброї. І точно цьому немає виправдання, якщо внаслідок цього страждають невинні.",shape=box,color=blue];
		j385510738 -> j1917897113;
	j1154052495 [label="А ти намагаєшся використати її проти мене, щоби «перемогти» в суперечці ? Це ница тактика боягузів. Але ми двоє були на нервах, тож… я пробачу тобі, якщо ти пробачиш мені. За слова, сказані у гніві.",shape=box,color=blue];
		j1154052495 -> j543483057;
		j1154052495 -> j3684466486;
	j1455913552 [label="Знаєш, складно покинути захист le Cardinal… і знадобився деякий час, щоб усвідомити, чому я не могла його відпустити.",shape=box,color=blue];
		j1455913552 -> j3284287194;
	j3058117134 [label="Non, я розумію… Чимало вбивств скоєно «у пориві пристрасті», oui ? Напевно, стільки ж дітей зачато в такі ж миті.",shape=box,color=blue];
		j3058117134 -> j1568046313;
	j517454954 [label="За такий короткий час я відчуваю твою важливість для мене… наші бесіди такі joyeuses.",shape=box,color=blue];
		j517454954 -> j1186072069;
	j4111407794 [label="І справді, я досі хочу, щоб монсеньйор Лойд об’єднався з тими, хто нагорі. Я хотіла б утішити родину le Cardinal, а ти — дорога до цього ! ",shape=box,color=blue];
		j4111407794 -> j517454954;
	j3805730835 [label="Check boolean LoidFamilyComplete",color=orange];
		j3805730835 -> j1519108147 [label=true,color=green];
		j3805730835 -> j2578143485 [label=false,color=brown];
	j3826303358 [label="Так. І мені шкода, що ті слова ранили тебе. Не вдалося якось ліпше висловити думку.",shape=box,color=red];
		j3826303358 -> j194036032;
	j1517005950 [label="Дуже добре, що мої слова дійшли до тебе. Бо вже надія вже згасала.",shape=box,color=red];
		j1517005950 -> j2061129220;
	j4221577764 [label="І якщо ти так істинно віриш у те, що настільки вище від нас усіх, то побачиш нічого окрім хмар, у яких не зможеш знайти себе.",shape=box,color=blue];
		j4221577764 -> j543483057;
		j4221577764 -> j3684466486;
	j1917897113 [label="Тож… Я визнаю, що le Cardinal не має права кривдити інших в «ім’я більшого блага».",shape=box,color=blue];
		j1917897113 -> j12082953;
	j543483057 [label="Я… то була фрустрація. Не вдавалося придумати як ще привести тебе до тями. Ентраті тобі не друг. І не батько.",shape=box,color=red];
		j543483057 -> j948716826;
	j3684466486 [label="Мені шкода. Я дозволила гніву взяти гору й сказала те, що не думала і не мала на увазі.",shape=box,color=red];
		j3684466486 -> j1241626198;
	j3284287194 [label="Я дуже не хочу почуватися приниженою тобою, якщо зізнаюся у всій правді. Бо воно видається таким дрібним і pathétique.",shape=box,color=blue];
		j3284287194 -> j167643149;
		j3284287194 -> j1633472015;
	j1568046313 [label="Я… розчарована. Скривджена. Але я… пробачаю тобі.",shape=box,color=blue];
		j1568046313 -> j443868408;
	j1186072069 [label="Evaluate expressions",color=orange];
		j1186072069 -> j2310133404 [label="DrifterMarie",color=purple];
		j1186072069 -> j111730133 [label="DrifterLyon",color=purple];
		j1186072069 -> j1705394024 [label="DrifterRoathe",color=purple];
		j1186072069 -> j639615999 [label="false",color=purple];
	j1519108147 [label="І ще стільки добра ти досі можеш зробити моєму Ліону… і, напевно, навіть дияволу…",shape=box,color=blue];
		j1519108147 -> j3922131124;
		j1519108147 -> j3789670285;
	j2578143485 [label="І справді, я досі хочу, щоб монсеньйор Лойд об’єднався з тими, хто нагорі. Я хотіла б утішити родину le Cardinal, а ти — дорога до цього ! ",shape=box,color=blue];
		j2578143485 -> j1519108147;
	j194036032 [label="+10 Chemistry",color=orange];
		j194036032 -> j3919518962;
	j2061129220 [label="Знаєш, є дещо особливе в люб’язності «переможців» до переможених.",shape=box,color=blue];
		j2061129220 -> j1718439780;
		j2061129220 -> j1662389292;
	j12082953 [label="Бо ж яке «більше благо» може бути, якщо на його шляху не лишається нічого окрім розкраяних сердець та понівечених життів ?",shape=box,color=blue];
		j12082953 -> j1331683786;
	j948716826 [label="Non. Він мені не батько. Батько покинув мене дитиною на вулиці, а le Cardinal навіть і близько не такий жорстокий.",shape=box,color=blue];
		j948716826 -> j786197016;
	j1241626198 [label="Чимало жахливого було скоєно під впливом пристрасті. Такий порядок речей. ",shape=box,color=blue];
		j1241626198 -> j2295823649;
	j167643149 [label="Здається, я знаю, про що ти. ",shape=box,color=red];
		j167643149 -> j2580025426;
	j1633472015 [label="Я не принижуватиму тебе й не думатиму погано. Марі, я обіцяю.",shape=box,color=red];
		j1633472015 -> j1031278163;
	j443868408 [label="І… завершімо розмову про le Cardinal, якщо можна, s'il te plaît ? Я відкладу роз’ятрене серце вбік.",shape=box,color=blue];
		j443868408 -> j1111095956;
	j2310133404 [label="І справді, як я можу відштовхнути тебе, коли знаю про твої почуття ?",shape=box,color=blue];
		j2310133404 -> j3791302689;
	j111730133 [label="І справді, як я можу відштовхнути тебе, коли знаю про твої почуття до нашого дорогого Ліона ? Тобі може вдатися принести йому багато спокою… багато втіхи…",shape=box,color=blue];
		j111730133 -> j3791302689;
	j1705394024 [label="І справді, як я можу відштовхнути тебе, коли знаю про твої почуття до диявола ? Я не розумію подібних смаків, але… Ти ж усе одно на нашій стороні, oui ?",shape=box,color=blue];
		j1705394024 -> j3791302689;
	j639615999 [label="Не хочу втрачати подібну компанію. Чи можемо відкласти це вбік і сказати, що в дечому можемо не погоджуватися, але спілкуватися далі ?",shape=box,color=blue];
		j639615999 -> j2595618043;
		j639615999 -> j3161101361;
	j3922131124 [label="Марі, зажди. Прошу. Дай мені перепросити.",shape=box,color=red];
		j3922131124 -> j4034629989;
	j3789670285 [label="Чесно, було невтямки, що мої слова матимуть значення для тебе… Не було думки, що це буде важливим для тебе.",shape=box,color=red];
		j3789670285 -> j4034629989;
	j3919518962 [label="Я ціную це більше, аніж ти можеш подумати. Дякую тобі.",shape=box,color=blue];
		j3919518962 -> j1497152436;
	j1718439780 [label="То були дурощі.",shape=box,color=red];
		j1718439780 -> j3002847585;
	j1662389292 [label="Вибач. Я не часто «перемагаю».",shape=box,color=red];
		j1662389292 -> j4024012057;
	j786197016 [label="Boolean MarieFamilyFail is now true.",color=orange];
		j786197016 -> j542165713;
	j2295823649 [label="+5 Chemistry",color=orange];
		j2295823649 -> j289896437;
	j2580025426 [label="Припускаю, що для тебе це було очевидним, non ? Ти ж теж без famille. ",shape=box,color=blue];
		j2580025426 -> j2458277678;
	j1031278163 [label="Це ми ще побачимо. Знаєш, гадаю, що таки зрештою я бачила в ньому дещицю батька, який покинув мене. Хоч би як низько й сумно це не видавалося мені зараз.",shape=box,color=blue];
		j1031278163 -> j2458277678;
	j1111095956 [label="Знаєш, складно покинути захист le Cardinal… і знадобився деякий час, щоб усвідомити, чому я не могла його відпустити.",shape=box,color=blue];
		j1111095956 -> j1174786532;
	j3791302689 [label="Чи можемо відкласти це вбік і сказати, що в дечому можемо не погоджуватися, але спілкуватися далі ?",shape=box,color=blue];
		j3791302689 -> j2595618043;
		j3791302689 -> j3161101361;
	j2595618043 [label="Ні, мені ще не до кінця все зрозуміло. Потрібно завершити розмову логічно.",shape=box,color=red];
		j2595618043 -> j2551683190;
	j3161101361 [label="Гадаю, це справедливо. Згода.",shape=box,color=red];
		j3161101361 -> j516354711;
	j4034629989 [label="Мандрівниче, я пробачу тобі твою брехню. Ми можемо й далі бути друзями та союзниками. Але нащо було брехати саме так ? Намагаючись зробити… що ?",shape=box,color=blue];
		j4034629989 -> j1574691804;
	j1497152436 [label="Знаєш, складно покинути défense le Cardinal… і знадобився деякий час, щоб усвідомити, чому я не могла його відпустити.",shape=box,color=blue];
		j1497152436 -> j3828927311;
	j3002847585 [label="Oui, так, що ж. ",shape=box,color=blue];
		j3002847585 -> j1497152436;
	j4024012057 [label="+5 Chemistry",color=orange];
		j4024012057 -> j3002847585;
	j542165713 [label="Add -10 to Family counter",color=orange];
		j542165713 -> j816189513;
	j289896437 [label="Я приймаю твої вибачення… бо дозволила гніву керувати кілька секунд собою.",shape=box,color=blue];
		j289896437 -> j2469942758;
	j2458277678 [label="Лише вдуматися… після стількох таких років я потягнулася до когось, хто пропонував стільки доброти ?",shape=box,color=blue];
		j2458277678 -> j725291879;
	j1174786532 [label="Я дуже не хочу почуватися приниженою тобою, якщо зізнаюся у всій правді. Бо вона видається такою дрібною й pathétique.",shape=box,color=blue];
		j1174786532 -> j658533019;
		j1174786532 -> j2011282360;
	j2551683190 [label="Boolean MarieFamilyFail is now true.",color=orange];
		j2551683190 -> j4055920456;
	j516354711 [label="+5 Chemistry",color=orange];
		j516354711 -> j4084614048;
	j1574691804 [label="Check boolean DrifterMarieWhoops",color=orange];
