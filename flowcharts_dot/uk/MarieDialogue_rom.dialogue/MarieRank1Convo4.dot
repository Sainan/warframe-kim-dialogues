digraph {
	237 [label="MarieRank1Convo4 begins.",color=orange];
		237 -> 238;
	238 [label="Чи можу я спитати, я сподіваюся, що не дуже некоректне запитання ? Наша дружба лише розпочалася, особливо для тебе, хто за словами інших знає про неї дуже багато років.",shape=box,color=blue];
		238 -> 241;
		238 -> 240;
		238 -> 239;
	241 [label="По правді мною забуто більшість із прожитих років. ",shape=box,color=red];
		241 -> 244;
	240 [label="Звісно. Я не проти. Питай.",shape=box,color=red];
		240 -> 243;
	239 [label="[Завершити розмову]",shape=box,color=red];
		239 -> 242;
	244 [label="Соле милий ! Ти розбиваєш мені серце своїми словами. Ви з дияволом обоє знаєте, що ваші спогади вирвані, як цілі розділи з книг, non ?",shape=box,color=blue];
		244 -> 246;
		244 -> 247;
	243 [label="+5 Chemistry",color=orange];
		243 -> 245;
	242 [label="Chat ends.",color=orange];
	246 [label="Анітрішки не сумую за жодною з частин минулого, якого не пам’ятаю.",shape=box,color=red];
		246 -> 250;
	247 [label="Позаяк із різних причин, але так.",shape=box,color=red];
		247 -> 251;
	245 [label="Evaluate expressions on HellKeyPlayed",color=orange];
		245 -> 249 [label="x > 0",color=purple];
		245 -> 248 [label="x <= 0",color=purple];
		245 -> 248 [label="false",color=purple];
	250 [label="Це правда ? Схоже, що ти єдина особа, хто дійсно не сумує. Між дитям і дияволом видається, що всі шукають частинки себе, котрі давно розгубили.",shape=box,color=blue];
		250 -> 255;
		250 -> 256;
	251 [label="Чи не забагато собі дозволю, якщо питатиму звідки в тобі стільки спустошеності ? Причини диявола та дитяти мені відомі, але не твої.",shape=box,color=blue];
		251 -> 255;
		251 -> 256;
	249 [label="Чому тобі закортіло погодитися допомагати дияволу в його намірах ? Я чула, що саме на тобі відповідальність за винищення його роду.",shape=box,color=blue];
		249 -> 252;
		249 -> 253;
		249 -> 254;
	248 [label="Ти збираєшся допомагати дияволу в його намірах ? Я чула, що саме на тобі відповідальність за винищення його роду.",shape=box,color=blue];
		248 -> 252;
		248 -> 253;
		248 -> 254;
	255 [label="Нескінченно невідому кількість років було проведено в різноманітних смертях від рук… ем… моїх же ж. Я не проти не пам’ятати кожен з них.",shape=box,color=red];
		255 -> 260;
	256 [label="Якщо коротко, то мені… довелося провести чималу кількість років у стражданнях. Гадаю, це якийсь механізм самозахисту. Ну, я про забування.",shape=box,color=red];
		256 -> 261;
	252 [label="То було моє інше «я». Я вірю в те, що вина падає на особу, а не на спільноту.",shape=box,color=red];
		252 -> 257;
	253 [label="То не я, то — маля. Але орокінів я ненавиджу так само.",shape=box,color=red];
		253 -> 258;
	254 [label="У Ніч барабанів наґа, коли тенно постали супроти орокінів… мене не було там. То було маля.",shape=box,color=red];
		254 -> 259;
	260 [label="Аніскілечки тебе не звинувачую. Якби мені довелося пережити таку жорстокість, то теж охоче це забула б. Щонайменше, не шукала би способів згадати.",shape=box,color=blue];
		260 -> 265;
	261 [label="Не сумніваюся ! Якби мені довелося пережити таку жорстокість, то моя душа точно вчинила би так само. Сховати все, що не можна зцілити й що не має користі.",shape=box,color=blue];
		261 -> 265;
	257 [label="Add 1 to Thermostat",color=orange];
		257 -> 262;
	258 [label="Add -1 to Thermostat",color=orange];
		258 -> 263;
	259 [label="Ніч барабанів наґа. О, я вже це собі уявляю. Quelles couleurs magnifiques !",shape=box,color=blue];
		259 -> 264;
	265 [label="+5 Chemistry",color=orange];
		265 -> 268;
	262 [label="Oui, je comprends. Ми радо спалимо всю будівлю, попри те, що запах всього-на-всього від пацюків у стінах.",shape=box,color=blue];
		262 -> 266;
	263 [label="Je meurs d'envie de savoir pourquoi ! Але це розмова для іншого разу. Інакше лишимося тут назавжди й монсеньйор Лойд гніватиметься на мене.",shape=box,color=blue];
		263 -> 267;
	264 [label="Я маю детальніше це обговорити з монсеньйором Лойдом. Але !",shape=box,color=blue];
		264 -> 267;
	268 [label="А ще це може прояснити мені те, про що я хотіла поговорити з тобою.",shape=box,color=blue];
		268 -> 245;
	266 [label="Але це розмова для іншого разу. Інакше ми лишимося тут назавжди й монсеньйор Лойд гніватиметься на мене.",shape=box,color=blue];
		266 -> 267;
	267 [label="Evaluate expressions on HellKeyPlayed",color=orange];
		267 -> 270 [label="x > 0",color=purple];
		267 -> 269 [label="x <= 0",color=purple];
		267 -> 269 [label="false",color=purple];
	270 [label="Pardonnez-moi ! Я геть не даю тобі можливості відповісти. Чому ти допомагатимеш дияволу, скажи ?",shape=box,color=blue];
		270 -> 274;
		270 -> 273;
		270 -> 272;
		270 -> 271;
	269 [label="Pardonnez-moi ! Я геть не даю тобі можливості відповісти. То ти допомагатимеш дияволу, чи ні ?",shape=box,color=blue];
		269 -> 271;
		269 -> 272;
		269 -> 273;
		269 -> 274;
	274 [label="Він не зробив ще нічого такого, щоби показати себе не вартим допомоги… поки що.",shape=box,color=red];
		274 -> 278;
	273 [label="Не думаю, що я можу займатися чимось, що відверне від мене союзників.",shape=box,color=red];
		273 -> 277;
	272 [label="[Зізнатися у зацікавленості в Роуті] Щось у ньому є таке, що мене вабить…",shape=box,color=red];
		272 -> 276;
	271 [label="Йому наче подобається те, що він робить для виживання. Не можу звинувачувати за таке.",shape=box,color=red];
		271 -> 275;
	278 [label="Add 1 to Thermostat",color=orange];
		278 -> 282;
	277 [label="Update boolean MarieRoatheSoldier",color=orange];
		277 -> 281;
	276 [label="Update boolean DrifterRoathe",color=orange];
		276 -> 280;
	275 [label="Add -1 to Thermostat",color=orange];
		275 -> 279;
	282 [label="+5 Chemistry",color=orange];
		282 -> 285;
	281 [label="А, я розумію. Ти просто збираєш вояків. Але той диявол радше встромить тобі ножаку промежи ребер, аніж пильнуватиме спину.",shape=box,color=blue];
		281 -> 284;
	280 [label="Le diable séduit les cœurs les plus forts. Він веде хитру гру, тож пильнуй. Упевнися, що бачиш те що треба в його очах, а не щось інше. ",shape=box,color=blue];
		280 -> 283;
	279 [label="Як на мене, то він прожив довше чим хтось узагалі повинен. Можливо пекло має прийти й забрати своє, що якимось дивом забрело аж сюди.",shape=box,color=blue];
		279 -> 283;
	285 [label="Най славиться твоє співчуття — це сповнює моє серце радістю. Світочі вчать нас, що всім можна допомогти. Усіх можна пробачити. Але… лише якщо вони прагнуть цього.",shape=box,color=blue];
		285 -> 290;
	284 [label="Він не союзник тобі, і ніколи не буде ним. Отой диявол пристає лише до тих, хто послугує його потребам.",shape=box,color=blue];
		284 -> 287;
		284 -> 288;
		284 -> 289;
	283 [label="+5 Chemistry",color=orange];
		283 -> 286;
	290 [label="Нескінченна робота допомагати тим, хто ніколи не спітніє на ниві власного каяття — життя раба, покинутого у потребі.",shape=box,color=blue];
		290 -> 287;
		290 -> 288;
		290 -> 289;
	287 [label="Про орокінів та його ситуацію я знаю більше, ніж ти. Твоя допомога не потрібна.",shape=box,color=red];
		287 -> 291;
	288 [label="Дякую за попередження. Я матиму їх на увазі, коли матиму справу з ним.",shape=box,color=red];
		288 -> 292;
	289 [label="Дякую. Та я впораюся самотужки. І знаєш що важливіше? Мені вже довелося справлятися й зі гіршими за нього.",shape=box,color=red];
		289 -> 293;
	286 [label="Я вчиняю негідно… ти просто не знаєш його. Ти не бачиш його сутності, яким він є. Я просто не хочу, щоби тобі було боляче.",shape=box,color=blue];
		286 -> 287;
		286 -> 288;
		286 -> 289;
	291 [label="Update boolean MarieRoatheWarning",color=orange];
		291 -> 294;
	292 [label="+10 Chemistry",color=orange];
		292 -> 295;
	293 [label="+5 Chemistry",color=orange];
		293 -> 296;
	294 [label="Вибач мені. Ми ледве знайомі й невідома твоя здатність протистояти маніпуляціям. Я просто переживаю, бо ми звалили на тебе всі наші скорботи.",shape=box,color=blue];
		294 -> 297;
	295 [label="Це все, про що я могла просити. Merci, merci, merci. Та позаяк, либонь я маю йти вже.",shape=box,color=blue];
		295 -> 298;
	296 [label="Oui, vous avez raison. Ми ледве знайомі й невідома твоя здатність протистояти маніпуляціям. Я просто переживаю, бо ми звалили на тебе всі наші скорботи.",shape=box,color=blue];
		296 -> 299;
	297 [label="Надалі я пильнуватиму кордони.",shape=box,color=blue];
		297 -> 300;
	298 [label="Chat ends.",color=orange];
	299 [label="Що ж, боюся маю йти.",shape=box,color=blue];
		299 -> 301;
	300 [label="Chat ends.",color=orange];
	301 [label="Chat ends.",color=orange];
}