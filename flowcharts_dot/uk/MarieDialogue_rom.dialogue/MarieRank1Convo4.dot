digraph {
	"MarieRank1Convo4 begins." [color=orange];
		"MarieRank1Convo4 begins." -> j4169933499;
	j4169933499 [label="Чи можу я спитати, я сподіваюся, що не дуже некоректне запитання ? Наша дружба лише розпочалася, особливо для тебе, хто за словами інших знає про неї дуже багато років.",shape=box,color=blue];
		j4169933499 -> j2411549662;
		j4169933499 -> j2866013324;
		j4169933499 -> j1478915251;
	j2411549662 [label="По правді мною забуто більшість із прожитих років. ",shape=box,color=red];
		j2411549662 -> j4084197688;
	j2866013324 [label="Звісно. Я не проти. Питай.",shape=box,color=red];
		j2866013324 -> j2947588656;
	j1478915251 [label="[Завершити розмову]",shape=box,color=red];
		j1478915251 -> "Chat ends.";
	j4084197688 [label="Соле милий ! Ти розбиваєш мені серце своїми словами. Ви з дияволом обоє знаєте, що ваші спогади вирвані, як цілі розділи з книг, non ?",shape=box,color=blue];
		j4084197688 -> j1585655845;
		j4084197688 -> j3934687040;
	j2947588656 [label="+5 Chemistry",color=orange];
		j2947588656 -> j523704316;
	"Chat ends." [color=orange];
	j1585655845 [label="Анітрішки не сумую за жодною з частин минулого, якого не пам’ятаю.",shape=box,color=red];
		j1585655845 -> j1662210524;
	j3934687040 [label="Позаяк із різних причин, але так.",shape=box,color=red];
		j3934687040 -> j794119165;
	j523704316 [label="Evaluate expressions on HellKeyPlayed counter",color=orange];
		j523704316 -> j4182878070 [label="x > 0",color=purple];
		j523704316 -> j3409529529 [label="x <= 0",color=purple];
		j523704316 -> j3409529529 [label="false",color=purple];
	j1662210524 [label="Це правда ? Схоже, що ти єдина особа, хто дійсно не сумує. Між дитям і дияволом видається, що всі шукають частинки себе, котрі давно розгубили.",shape=box,color=blue];
		j1662210524 -> j2961030208;
		j1662210524 -> j953923304;
	j794119165 [label="Чи не забагато собі дозволю, якщо питатиму звідки в тобі стільки спустошеності ? Причини диявола та дитяти мені відомі, але не твої.",shape=box,color=blue];
		j794119165 -> j2961030208;
		j794119165 -> j953923304;
	j4182878070 [label="Чому тобі закортіло погодитися допомагати дияволу в його намірах ? Я чула, що саме на тобі відповідальність за винищення його роду.",shape=box,color=blue];
		j4182878070 -> j304578157;
		j4182878070 -> j2895852641;
		j4182878070 -> j279242545;
	j3409529529 [label="Ти збираєшся допомагати дияволу в його намірах ? Я чула, що саме на тобі відповідальність за винищення його роду.",shape=box,color=blue];
		j3409529529 -> j304578157;
		j3409529529 -> j2895852641;
		j3409529529 -> j279242545;
	j2961030208 [label="Нескінченно невідому кількість років було проведено в різноманітних смертях від рук… ем… моїх же ж. Я не проти не пам’ятати кожен з них.",shape=box,color=red];
		j2961030208 -> j3355623980;
	j953923304 [label="Якщо коротко, то мені… довелося провести чималу кількість років у стражданнях. Гадаю, це якийсь механізм самозахисту. Ну, я про забування.",shape=box,color=red];
		j953923304 -> j2331003394;
	j304578157 [label="То було моє інше «я». Я вірю в те, що вина падає на особу, а не на спільноту.",shape=box,color=red];
		j304578157 -> j1281808010;
	j2895852641 [label="То не я, то — маля. Але орокінів я ненавиджу так само.",shape=box,color=red];
		j2895852641 -> j3920491656;
	j279242545 [label="У Ніч барабанів наґа, коли тенно постали супроти орокінів… мене не було там. То було маля.",shape=box,color=red];
		j279242545 -> j778242652;
	j3355623980 [label="Аніскілечки тебе не звинувачую. Якби мені довелося пережити таку жорстокість, то теж охоче це забула б. Щонайменше, не шукала би способів згадати.",shape=box,color=blue];
		j3355623980 -> j1109125733;
	j2331003394 [label="Не сумніваюся ! Якби мені довелося пережити таку жорстокість, то моя душа точно вчинила би так само. Сховати все, що не можна зцілити й що не має користі.",shape=box,color=blue];
		j2331003394 -> j1109125733;
	j1281808010 [label="Add 1 to Thermostat counter",color=orange];
		j1281808010 -> j2278021978;
	j3920491656 [label="Add -1 to Thermostat counter",color=orange];
		j3920491656 -> j767861649;
	j778242652 [label="Ніч барабанів наґа. О, я вже це собі уявляю. Quelles couleurs magnifiques !",shape=box,color=blue];
		j778242652 -> j563767647;
	j1109125733 [label="+5 Chemistry",color=orange];
		j1109125733 -> j3236796061;
	j2278021978 [label="Oui, je comprends. Ми радо спалимо всю будівлю, попри те, що запах всього-на-всього від пацюків у стінах.",shape=box,color=blue];
		j2278021978 -> j2111599306;
	j767861649 [label="Je meurs d'envie de savoir pourquoi ! Але це розмова для іншого разу. Інакше лишимося тут назавжди й монсеньйор Лойд гніватиметься на мене.",shape=box,color=blue];
		j767861649 -> j4192617946;
	j563767647 [label="Я маю детальніше це обговорити з монсеньйором Лойдом. Але !",shape=box,color=blue];
		j563767647 -> j4192617946;
	j3236796061 [label="А ще це може прояснити мені те, про що я хотіла поговорити з тобою.",shape=box,color=blue];
		j3236796061 -> j523704316;
	j2111599306 [label="Але це розмова для іншого разу. Інакше ми лишимося тут назавжди й монсеньйор Лойд гніватиметься на мене.",shape=box,color=blue];
		j2111599306 -> j4192617946;
	j4192617946 [label="Evaluate expressions on HellKeyPlayed counter",color=orange];
		j4192617946 -> j2581108783 [label="x > 0",color=purple];
		j4192617946 -> j4132952104 [label="x <= 0",color=purple];
		j4192617946 -> j4132952104 [label="false",color=purple];
	j2581108783 [label="Pardonnez-moi ! Я геть не даю тобі можливості відповісти. Чому ти допомагатимеш дияволу, скажи ?",shape=box,color=blue];
		j2581108783 -> j2380540485;
		j2581108783 -> j2628768852;
		j2581108783 -> j3154045889;
		j2581108783 -> j2783936995;
	j4132952104 [label="Pardonnez-moi ! Я геть не даю тобі можливості відповісти. То ти допомагатимеш дияволу, чи ні ?",shape=box,color=blue];
		j4132952104 -> j2783936995;
		j4132952104 -> j3154045889;
		j4132952104 -> j2628768852;
		j4132952104 -> j2380540485;
	j2380540485 [label="Він не зробив ще нічого такого, щоби показати себе не вартим допомоги… поки що.",shape=box,color=red];
		j2380540485 -> j3308803623;
	j2628768852 [label="Не думаю, що я можу займатися чимось, що відверне від мене союзників.",shape=box,color=red];
		j2628768852 -> j895238748;
	j3154045889 [label="[Зізнатися у зацікавленості в Роуті] Щось у ньому є таке, що мене вабить…",shape=box,color=red];
		j3154045889 -> j401050589;
	j2783936995 [label="Йому наче подобається те, що він робить для виживання. Не можу звинувачувати за таке.",shape=box,color=red];
		j2783936995 -> j3635461662;
	j3308803623 [label="Add 1 to Thermostat counter",color=orange];
		j3308803623 -> j1007388432;
	j895238748 [label="Boolean MarieRoatheSoldier is now true.",color=orange];
		j895238748 -> j2993527875;
	j401050589 [label="Boolean DrifterRoathe is now true.",color=orange];
		j401050589 -> j515873221;
	j3635461662 [label="Add -1 to Thermostat counter",color=orange];
		j3635461662 -> j2686127896;
	j1007388432 [label="+5 Chemistry",color=orange];
		j1007388432 -> j2146901025;
	j2993527875 [label="А, я розумію. Ти просто збираєш вояків. Але той диявол радше встромить тобі ножаку промежи ребер, аніж пильнуватиме спину.",shape=box,color=blue];
		j2993527875 -> j1122518035;
	j515873221 [label="Le diable séduit les cœurs les plus forts. Він веде хитру гру, тож пильнуй. Упевнися, що бачиш те що треба в його очах, а не щось інше. ",shape=box,color=blue];
		j515873221 -> j391684234;
	j2686127896 [label="Як на мене, то він прожив довше чим хтось узагалі повинен. Можливо пекло має прийти й забрати своє, що якимось дивом забрело аж сюди.",shape=box,color=blue];
		j2686127896 -> j391684234;
	j2146901025 [label="Най славиться твоє співчуття — це сповнює моє серце радістю. Світочі вчать нас, що всім можна допомогти. Усіх можна пробачити. Але… лише якщо вони прагнуть цього.",shape=box,color=blue];
		j2146901025 -> j819328629;
	j1122518035 [label="Він не союзник тобі, і ніколи не буде ним. Отой диявол пристає лише до тих, хто послугує його потребам.",shape=box,color=blue];
		j1122518035 -> j1491462772;
		j1122518035 -> j2790515700;
		j1122518035 -> j1907422243;
	j391684234 [label="+5 Chemistry",color=orange];
		j391684234 -> j1840805680;
	j819328629 [label="Нескінченна робота допомагати тим, хто ніколи не спітніє на ниві власного каяття — життя раба, покинутого у потребі.",shape=box,color=blue];
		j819328629 -> j1491462772;
		j819328629 -> j2790515700;
		j819328629 -> j1907422243;
	j1491462772 [label="Про орокінів та його ситуацію я знаю більше, ніж ти. Твоя допомога не потрібна.",shape=box,color=red];
		j1491462772 -> j1881535121;
	j2790515700 [label="Дякую за попередження. Я матиму їх на увазі, коли матиму справу з ним.",shape=box,color=red];
		j2790515700 -> j891043472;
	j1907422243 [label="Дякую. Та я впораюся самотужки. І знаєш що важливіше? Мені вже довелося справлятися й зі гіршими за нього.",shape=box,color=red];
		j1907422243 -> j1221651155;
	j1840805680 [label="Я вчиняю негідно… ти просто не знаєш його. Ти не бачиш його сутності, яким він є. Я просто не хочу, щоби тобі було боляче.",shape=box,color=blue];
		j1840805680 -> j1491462772;
		j1840805680 -> j2790515700;
		j1840805680 -> j1907422243;
	j1881535121 [label="Boolean MarieRoatheWarning is now true.",color=orange];
		j1881535121 -> j3184082770;
	j891043472 [label="+10 Chemistry",color=orange];
		j891043472 -> j2047146347;
	j1221651155 [label="+5 Chemistry",color=orange];
		j1221651155 -> j3332962840;
	j3184082770 [label="Вибач мені. Ми ледве знайомі й невідома твоя здатність протистояти маніпуляціям. Я просто переживаю, бо ми звалили на тебе всі наші скорботи.",shape=box,color=blue];
		j3184082770 -> j2422903321;
	j2047146347 [label="Це все, про що я могла просити. Merci, merci, merci. Та позаяк, либонь я маю йти вже.",shape=box,color=blue];
		j2047146347 -> "Chat ends.";
	j3332962840 [label="Oui, vous avez raison. Ми ледве знайомі й невідома твоя здатність протистояти маніпуляціям. Я просто переживаю, бо ми звалили на тебе всі наші скорботи.",shape=box,color=blue];
		j3332962840 -> j471212821;
	j2422903321 [label="Надалі я пильнуватиму кордони.",shape=box,color=blue];
		j2422903321 -> "Chat ends.";
	j471212821 [label="Що ж, боюся маю йти.",shape=box,color=blue];
		j471212821 -> "Chat ends.";
}