digraph {
	"MarieRank2Convo1 begins." [color=orange];
		"MarieRank2Convo1 begins." -> j2038934922;
	j2038934922 [label="Сподіваюся, що ти не вважатимеш мене грубіянкою за це запитання. Але мене вкрай це цікавить. У тебе є віра ? У Світочі чи в когось/щось інше?",shape=box,color=blue];
		j2038934922 -> j2038024222;
		j2038934922 -> j1633390201;
		j2038934922 -> j1478915251;
	j2038024222 [label="А якби висловилася думка, що мене більше цікавиш ти, натомісь? Це було би блюзнірством?",shape=box,color=red];
		j2038024222 -> j2695694703;
	j1633390201 [label="Ні, це взагалі не було би грубо.",shape=box,color=red];
		j1633390201 -> j3945938539;
		j1633390201 -> j3733272622;
		j1633390201 -> j3908890092;
		j1633390201 -> j1364860768;
		j1633390201 -> j4244071931;
	j1478915251 [label="[Завершити розмову]",shape=box,color=red];
		j1478915251 -> "Chat ends.";
	j2695694703 [label="Boolean DrifterMarie is now true.",color=orange];
		j2695694703 -> j4204600468;
	j3945938539 [label="Це… складно. Я вірю, що щось десь там є. Але саме визначеної «віри» у мене нема.",shape=box,color=red];
		j3945938539 -> j2966781758;
	j3733272622 [label="Так. У мене є віра для вірування, хоча вона й не з тих, які тобі відомі.",shape=box,color=red];
		j3733272622 -> j3746694469;
	j3908890092 [label="Я вірую у Світочі, як і ти.",shape=box,color=red];
		j3908890092 -> j3889405287;
	j1364860768 [label="Ні. Я не вірю в богів. Це просто наука, яку ми ще не розуміємо.",shape=box,color=red];
		j1364860768 -> j2781369302;
	j4244071931 [label="Якщо чесно, то не знаю. Гадаю світ занадто складний для мене, щоби мати відповідь.",shape=box,color=red];
		j4244071931 -> j2682551236;
	"Chat ends." [color=orange];
	j4204600468 [label="Оу, oui ? Що то є ? Quelle audace, маю визнати, я здивована тобою ! Такого не очікувала…",shape=box,color=blue];
		j4204600468 -> j2658497451;
	j2966781758 [label="Boolean DrifterFaithPersonal is now true.",color=orange];
		j2966781758 -> j2827977093;
	j3746694469 [label="+5 Chemistry",color=orange];
		j3746694469 -> j2711453444;
	j3889405287 [label="+5 Chemistry",color=orange];
		j3889405287 -> j4224351732;
	j2781369302 [label="+5 Chemistry",color=orange];
		j2781369302 -> j96176025;
	j2682551236 [label="Boolean DrifterFaithAgnostic is now true.",color=orange];
		j2682551236 -> j2118488961;
	j2658497451 [label="Але ти намагаєшся відвернути мою увагу ! Я, звісно, не проти, але для такого наче ще зарано, n’est-ce pas ?",shape=box,color=blue];
		j2658497451 -> j2984794840;
	j2827977093 [label="+5 Chemistry",color=orange];
		j2827977093 -> j2034624329;
	j2711453444 [label="Як би там не називалася віра, я знайду в ній красу. Повідай мені, вона нова ? Стара ? Я зможу її розпізнати взагалі ?",shape=box,color=blue];
		j2711453444 -> j523350390;
		j2711453444 -> j1293410284;
	j4224351732 [label="Та невже ! O, comme c'est fascinant ! Знати, що хтось у такому далекому майбутньому досі вірує, cela remplit mon cœur de joie. Радість сповнює мене. Хоча, видається мені, що проведений тобою час у минулому міг якось на це вплинути, non? Хоча… неважливо.",shape=box,color=blue];
		j4224351732 -> j2877648063;
	j96176025 [label="Поважаю твою відповідь. Та все одно спитаю. Звідки така впевненість ? Хіба це теж не є своєрідною вірою ? А ще оте… Байдужість твоя ? Хіба то не божество ?",shape=box,color=blue];
		j96176025 -> j529057599;
		j96176025 -> j501009227;
		j96176025 -> j2320226546;
	j2118488961 [label="+10 Chemistry",color=orange];
		j2118488961 -> j1804496828;
	j2984794840 [label="Тож… я би хотіла отримати відповідь на своє запитання, s'il vous plait, якщо ти не проти. Ну ось, сиджу тепер… вся зашарілася !",shape=box,color=blue];
		j2984794840 -> j3945938539;
		j2984794840 -> j3733272622;
		j2984794840 -> j3908890092;
		j2984794840 -> j1364860768;
		j2984794840 -> j4244071931;
	j2034624329 [label="Ah, oui. Мандрівний дух. Недарма прозиваєшся саме так. Тобі довелося побачити багато культур, релігій та світів. Cela est très spirituel, non ? Збираєш їх як мушлі на узбережжі.",shape=box,color=blue];
		j2034624329 -> j3056739491;
		j2034624329 -> j3454556386;
	j523350390 [label="Ні, не думаю, що ти її розпізнаєш.",shape=box,color=red];
		j523350390 -> j2972050101;
	j1293410284 [label="Можливо тобі вдасться розпізнати її частини. Але решта буде геть чужою.",shape=box,color=red];
		j1293410284 -> j2786059744;
	j2877648063 [label="Мені цікава твоя відданість: Йому чи Їй? Чи ти шукаєш рівноваги ?",shape=box,color=blue];
		j2877648063 -> j574603958;
		j2877648063 -> j501688762;
		j2877648063 -> j2369989011;
	j529057599 [label="Не маю абсолютної впевненості у своїй правоті. Ніхто не має. Проте я особисто не вірю в ніяких богів.",shape=box,color=red];
		j529057599 -> j1398983158;
	j501009227 [label="Думаю, що релігія існує для заповнення діри в людських життях, яку лишили страх смерті та острах перед невідомістю.",shape=box,color=red];
		j501009227 -> j254423546;
	j2320226546 [label="Гадки не маю що таке по суті Байдужість, але це точно не божество. Нам просто треба докопатися до суті цієї сутності. ",shape=box,color=red];
		j2320226546 -> j3993952158;
	j1804496828 [label="Ага ! Либонь наймудріша відповідь з усіх можливих ! Бо як це нам, простим смертним — якщо ще можемо такими називатися — удавати розгадування задумів Божих ?",shape=box,color=blue];
		j1804496828 -> j2828668555;
	j3056739491 [label="Гадаю, що є дещо старіше, справжніше й глибше, що говорить до нас усіх. Якась своєрідна сполучна тканина.",shape=box,color=red];
		j3056739491 -> j1747558215;
	j3454556386 [label="Саме таке. Я бачу дещо прекрасне в усіх. Не знаю, чи хтось за правду чи за кривду.",shape=box,color=red];
		j3454556386 -> j1747558215;
	j2972050101 [label="Boolean DrifterFaithYesForeign is now true.",color=orange];
		j2972050101 -> j2991986270;
	j2786059744 [label="Boolean DrifterFaithYesSimilar is now true.",color=orange];
		j2786059744 -> j2165701470;
	j574603958 [label="Мене більше притягує Сол. ",shape=box,color=red];
		j574603958 -> j668156838;
	j501688762 [label="Мене більше притягує Луа.",shape=box,color=red];
		j501688762 -> j1500237752;
	j2369989011 [label="Я волію до рівноваги. Гадаю це природніший порядок всього.",shape=box,color=red];
		j2369989011 -> j1671303346;
	j1398983158 [label="Boolean DrifterFaithNoMaybe is now true.",color=orange];
		j1398983158 -> j1309013923;
	j254423546 [label="Boolean DrifterFaithNoFear is now true.",color=orange];
		j254423546 -> j1692427462;
	j3993952158 [label="Boolean DrifterFaithNoMITW is now true.",color=orange];
		j3993952158 -> j1055951668;
	j2828668555 [label="Часто я сиділа у святилищі мого Cathédrale й радісно балакала з незнайомцями, які приходили вчитися й нічого більше не хтіли.",shape=box,color=blue];
		j2828668555 -> j4239257928;
	j1747558215 [label="+5 Chemistry",color=orange];
		j1747558215 -> j321790595;
	j2991986270 [label="+5 Chemistry",color=orange];
		j2991986270 -> j2113126845;
	j2165701470 [label="+5 Chemistry",color=orange];
		j2165701470 -> j3060785604;
	j668156838 [label="Boolean DrifterFaithSol is now true.",color=orange];
		j668156838 -> j4137485435;
	j1500237752 [label="Boolean DrifterFaithLua is now true.",color=orange];
		j1500237752 -> j2432994232;
	j1671303346 [label="Boolean DrifterFaithBalance is now true.",color=orange];
		j1671303346 -> j2262473551;
	j1309013923 [label="Oui, je vois… Напевно тобі потрібні власні «докази» для впевненості ? Невже у твоєму житті не траплялося нічого такого, що викликало подібні відчуття, як в нас — віра та запал ?",shape=box,color=blue];
		j1309013923 -> j1065645066;
		j1309013923 -> j2174962128;
	j1692427462 [label="Oui, c'est vrai — саме так. Віра дає багато відповідей для багатьох душ. Ти не боїшся того, що може статися після смерті ?",shape=box,color=blue];
		j1692427462 -> j3410046919;
		j1692427462 -> j4050801728;
	j1055951668 [label="Comme c'est fascinant… і от тепер їх стало двоє, котрі говорять однаково… диявол прошепотів так само.",shape=box,color=blue];
		j1055951668 -> j3999362666;
	j4239257928 [label="Вони так цікавилися нашою вірою, але не хотіли сказати «так, так, ось ця істинна». Я можу лише сподіватися, що дала їм частину нашої благодаті, коли вони йшли.",shape=box,color=blue];
		j4239257928 -> j545713341;
		j4239257928 -> j500337089;
	j321790595 [label="Je comprends et c'est magnifique. Мене часто навідують думки, а чи не носять Світочі інші обличчя. Інші імена.",shape=box,color=blue];
		j321790595 -> j1206143133;
	j2113126845 [label="Oh, comme c'est fascinant ! Я б із радістю котрогось дня познайомилася з твоєю вірою. Дізналася б про обряди.",shape=box,color=blue];
		j2113126845 -> j2605844875;
		j2113126845 -> j2304515704;
	j3060785604 [label="Oh, comme c'est fascinant ! Я би з радістю котрогось дня дізналася як вона може бути такою спорідненою й водночас іншою.",shape=box,color=blue];
		j3060785604 -> j2605844875;
		j3060785604 -> j2304515704;
	j4137485435 [label="+10 Chemistry",color=orange];
		j4137485435 -> j3863328158;
	j2432994232 [label="+5 Chemistry",color=orange];
		j2432994232 -> j2658273907;
	j2262473551 [label="+5 Chemistry",color=orange];
		j2262473551 -> j1634801235;
	j1065645066 [label="Ні, я просто не вірю.",shape=box,color=red];
		j1065645066 -> j3352939577;
	j2174962128 [label="Саме так. Мені ніколи не вдавалося відчути… «віру». Потреби в ній не виникало.",shape=box,color=red];
		j2174962128 -> j3373730327;
	j3410046919 [label="Усі помирають. Боятися цього — дурість. Вона прийде за нами всіма. Принаймні… повинна прийти.",shape=box,color=red];
		j3410046919 -> j2246765102;
	j4050801728 [label="Мені вдосталь довелося повмирати. Я не боюся того, що буде потім. Я прагну цього.",shape=box,color=red];
		j4050801728 -> j396201874;
	j3999362666 [label="+5 Chemistry",color=orange];
		j3999362666 -> j267157102;
	j545713341 [label="Мене трішки дивує, що ти радо приймаєш людей, котрі не вірять у твою віру.",shape=box,color=red];
		j545713341 -> j2877091155;
	j500337089 [label="Це воно. Мені не хочеться визнавати якусь «правильною» чи «неправильною».",shape=box,color=red];
		j500337089 -> j3137597226;
	j1206143133 [label="Відомо про їхню зміну форм для задоволення послідовників з інших сект. Та це моя віра, але не твоя.",shape=box,color=blue];
		j1206143133 -> j146344756;
	j2605844875 [label="Залюбки.",shape=box,color=red];
		j2605844875 -> j2164014210;
	j2304515704 [label="Мене дивує, що тобі імпонує думка існування інших релігій. ",shape=box,color=red];
		j2304515704 -> j2245145877;
	j3863328158 [label="Ти йдеш стежками мого серця ! Якби ж тобі бачити зараз усмішку на моєму обличчі. Сподіваюся, це не було лукавістю з твоєї сторони, аби лестити мені.",shape=box,color=blue];
		j3863328158 -> j121781975;
	j2658273907 [label="Ага, мандрівна душа ступає стежками ночі, як і мій дорогий Ліон. Коли він буде готовий, то вам варто поговорити про звички його темної панянки. Він буде неймовірно задоволений.",shape=box,color=blue];
		j2658273907 -> j121781975;
	j1634801235 [label="Рівновага без зайвої нерішучості. Іти своїм життям, знаючи про схід сонця й про схід місяця у відповідь, але ніколи не стати жертвою сумлінь ?",shape=box,color=blue];
		j1634801235 -> j313154136;
	j3352939577 [label="+5 Chemistry",color=orange];
		j3352939577 -> j1446443743;
	j3373730327 [label="+5 Chemistry",color=orange];
		j3373730327 -> j1125116131;
	j2246765102 [label="+5 Chemistry",color=orange];
		j2246765102 -> j3145749457;
	j396201874 [label="+5 Chemistry",color=orange];
		j396201874 -> j1544989137;
	j267157102 [label="Моє серце крається від думки про довіру до нього. Але в цьому ? Либонь тобі варто побалакати з ним. Та пильнуй. Диявол веде небезпечні ігри.",shape=box,color=blue];
		j267157102 -> j233675667;
		j267157102 -> j106412617;
	j2877091155 [label="Я припускала, що це може дивувати. Коли хтось у певних вирядах, не відповідає за визначенням очікуванням інших. На мою думку, проповідування тим, хто не прагне знайти розраду, не приносить великої любові.",shape=box,color=blue];
		j2877091155 -> j1123657277;
	j3137597226 [label="+5 Chemistry",color=orange];
		j3137597226 -> j3121441191;
	j146344756 [label="Чи можу сподіватися хоча б, що твоя віра дає тобі спокій ?",shape=box,color=blue];
		j146344756 -> j2123332905;
		j146344756 -> j1577651050;
		j146344756 -> j3277644544;
	j2164014210 [label="Ô joie ! Я обожнюю вивчати щось нове. Мене часто навідують думки, а чи не носять Світочі інші обличчя. Інші імена.",shape=box,color=blue];
		j2164014210 -> j2911014786;
	j2245145877 [label="Я припускала, що це може дивувати. Коли хтось у певних вирядах, не відповідає за визначенням очікуванням інших. На мою думку, проповідування тим, хто не прагне знайти розраду, не приносить великої любові.",shape=box,color=blue];
		j2245145877 -> j3299461913;
	j121781975 [label="Мені просто цікаво, чи наша віра дає тобі спокій ?",shape=box,color=blue];
		j121781975 -> j2123332905;
		j121781975 -> j1577651050;
		j121781975 -> j3277644544;
	j313154136 [label="Це рідкісний дар… і сподіваюся ти володієш ним. Маю острах, що задовге перебування на роздоріжжі призведе до поглинання в боротьбі.",shape=box,color=blue];
		j313154136 -> j2564599397;
	j1446443743 [label="Тоді життя напевно стає простішим. Не жити за законами богів та церков. Визнаю, я трішки заздрю.",shape=box,color=blue];
		j1446443743 -> j3639775669;
	j1125116131 [label="Тоді я заздрю тобі, мандрівниче ! Жити так багато століть уникаючи потреби пізнання богів.",shape=box,color=blue];
		j1125116131 -> j3639775669;
	j3145749457 [label="Ти говориш словами послідовників Луа. І це я не для образи кажу. Oui, Карга прийде за нами всіма й проллє свої срібні сльози. Але твої слова дивують мене…",shape=box,color=blue];
		j3145749457 -> j3473592613;
	j1544989137 [label="Oui, і це дивує мене. Я дивлюся на вас: на дитя, диявола, навіть монсеньйора Лойда чи le Cardinal… за вами всіма довга вервиця століть.",shape=box,color=blue];
		j1544989137 -> j1098305983;
	j233675667 [label="Що за небезпечна гра?",shape=box,color=red];
		j233675667 -> j1543114109;
	j106412617 [label="Він також не вважає Людину в стіні реальною, так?",shape=box,color=red];
		j106412617 -> j3962949775;
	j1123657277 [label="+5 Chemistry",color=orange];
		j1123657277 -> j1517998328;
	j3121441191 [label="Я тішуся з твоєї мудрості й доброти в ставленні до вірувань інших.",shape=box,color=blue];
		j3121441191 -> j874024833;
	j2123332905 [label="Ні.",shape=box,color=red];
		j2123332905 -> j3262709693;
	j1577651050 [label="Я насправді взагалі про це не думаю.",shape=box,color=red];
		j1577651050 -> j3022028815;
	j3277644544 [label="Так.",shape=box,color=red];
		j3277644544 -> j3456749600;
	j2911014786 [label="Відомо про їхню зміну форм для задоволення послідовників з інших сект. Та це моя віра, але не твоя. Я не проповідуватиму тим, хто не прагне знайти розраду. Я знаю, що це не принесе великої любові.",shape=box,color=blue];
		j2911014786 -> j3299461913;
	j3299461913 [label="Ні, моя віра — то моя віра, а твоя — твоя власна. Я сподіваюся, вона дає тобі спокій ?",shape=box,color=blue];
		j3299461913 -> j2123332905;
		j3299461913 -> j1577651050;
		j3299461913 -> j3277644544;
	j2564599397 [label="Зрештою, усі мають вибрати шлях яким ітимуть. Але ми всі маємо почати з перехрестя. Рівновага — фундамент усіх основ.",shape=box,color=blue];
		j2564599397 -> j648678712;
	j3639775669 [label="Але, мені цікаво… оце невірування. Воно дає тобі спокій ?",shape=box,color=blue];
		j3639775669 -> j2123332905;
		j3639775669 -> j1577651050;
		j3639775669 -> j3277644544;
	j3473592613 [label="Про кого ти говориш, що «вона має прийти» за вами всіма ? Я дивлюся на вас: на дитя, диявола, навіть монсеньйора Лойда чи le Cardinal… за вами всіма довга вервиця століть.",shape=box,color=blue];
		j3473592613 -> j1098305983;
	j1098305983 [label="Цікаво, скільки століть пройде для нас, перш ніж Луа прийде. І мені цікаво, як палко я прийму її обійми, коли настане той день. Та це моя віра, але не твоя.",shape=box,color=blue];
		j1098305983 -> j3639775669;
	j1543114109 [label="Я ще точно не знаю. Він тримає свої плани при собі, як і належить дияволу. Але він не вірить ні в яких богів. Окрім, хіба що, себе.",shape=box,color=blue];
		j1543114109 -> j3639775669;
	j3962949775 [label="Non, не вірить. Він дуже схожий на тебе — не вірить ні в яких богів. Окрім, хіба що, себе.",shape=box,color=blue];
		j3962949775 -> j3639775669;
	j1517998328 [label="Non, усіх, хто йде з відкритим розумом приймати радо треба з відкритими обіймами.",shape=box,color=blue];
		j1517998328 -> j874024833;
	j874024833 [label="Мені просто цікаво, чи дає це тобі спокій ?",shape=box,color=blue];
		j874024833 -> j2123332905;
		j874024833 -> j1577651050;
		j874024833 -> j3277644544;
	j3262709693 [label="Boolean DrifterFaithNoPeace is now true.",color=orange];
		j3262709693 -> j272190417;
	j3022028815 [label="+10 Chemistry",color=orange];
		j3022028815 -> j2337220107;
	j3456749600 [label="+10 Chemistry",color=orange];
		j3456749600 -> j3091910328;
	j648678712 [label="Boolean DrifterCrossroads is now true.",color=orange];
		j648678712 -> j401846569;
	j272190417 [label="+10 Chemistry",color=orange];
		j272190417 -> j1049382285;
	j2337220107 [label="Безмежно заздрю ! Я захлинаюсь нею. Я… з радістю побалакаю про це знову, якщо ти дозволиш мені ? Я не прагну ані проповідувати, ані вмішуватися. Я не бажаю завдати тобі прикростей.",shape=box,color=blue];
		j2337220107 -> j1619761008;
	j3091910328 [label="Тоді я знаю, що мій Сол усміхається тобі. Неважливо, чи ти молишся йому, бо тобі вдалося знайти потрібний тобі шлях.",shape=box,color=blue];
		j3091910328 -> j104641677;
	j401846569 [label="Йой, pardonne-moi ! Маленька Марі проповідує, яка ганьба ! Я ж тут не для читання нотацій та лекцій, як якась учителька.",shape=box,color=blue];
		j401846569 -> j121781975;
	j1049382285 [label="Я зворушена до глибини душі твоєю чесністю, мандрівниче. Я… з радістю побалакаю про це знову, якщо дозволиш ? Я не прагну ані проповідувати, ані вмішуватися. Я не бажаю завдати тобі прикростей.",shape=box,color=blue];
		j1049382285 -> j1619761008;
	j1619761008 [label="Я всього-на-всього допитлива. І хочу допомогти чим зможу. Відмов мені, і більше цієї теми не підійматимемо.",shape=box,color=blue];
		j1619761008 -> j3283647057;
		j1619761008 -> j2112726275;
	j104641677 [label="Я поцікавлюся, чи зможемо якось іще поговорити не цю тему ? Надто кортить дізнатися більше.",shape=box,color=blue];
		j104641677 -> j3283647057;
		j104641677 -> j2112726275;
	j3283647057 [label="Та ні, не варто.",shape=box,color=red];
		j3283647057 -> j303122956;
	j2112726275 [label="Так, звісно.",shape=box,color=red];
		j2112726275 -> j177423634;
	j303122956 [label="Boolean DrifterFaithStop is now true.",color=orange];
		j303122956 -> j196461680;
	j177423634 [label="Merci, merci ! Ти проявляєш стільки довіри, розповідаючи мені це все. Я не змарную її. Бувай.",shape=box,color=blue];
		j177423634 -> "Chat ends.";
	j196461680 [label="Цілковито розумію. Не ображаюся. Дякую, що всі мої повідомлення дочитані до кінця і дуже вдячна за те, чим зі мною ділишся. Віднині балакатимемо на інші теми. Бачить Сол, у нас їх доста !",shape=box,color=blue];
		j196461680 -> "Chat ends.";
}