digraph {
	302 [label="MarieRank2Convo1 begins.",color=orange];
		302 -> 303;
	303 [label="Сподіваюся, що ти не вважатимеш мене грубіянкою за це запитання. Але мене вкрай це цікавить. У тебе є віра ? У Світочі чи в когось/щось інше?",shape=box,color=blue];
		303 -> 3898;
		303 -> 3899;
		303 -> 3900;
	3898 [label="А якби висловилася думка, що мене більше цікавиш ти, натомісь? Це було би блюзнірством?",shape=box,color=red];
		3898 -> 3902;
	3899 [label="Ні, це взагалі не було би грубо.",shape=box,color=red];
		3899 -> 308;
		3899 -> 307;
		3899 -> 306;
		3899 -> 305;
		3899 -> 304;
	3900 [label="[Завершити розмову]",shape=box,color=red];
		3900 -> 3901;
	3902 [label="Update boolean DrifterMarie",color=orange];
		3902 -> 3903;
	308 [label="Це… складно. Я вірю, що щось десь там є. Але саме визначеної «віри» у мене нема.",shape=box,color=red];
		308 -> 313;
	307 [label="Так. У мене є віра для вірування, хоча вона й не з тих, які тобі відомі.",shape=box,color=red];
		307 -> 312;
	306 [label="Я вірую у Світочі, як і ти.",shape=box,color=red];
		306 -> 311;
	305 [label="Ні. Я не вірю в богів. Це просто наука, яку ми ще не розуміємо.",shape=box,color=red];
		305 -> 310;
	304 [label="Якщо чесно, то не знаю. Гадаю світ занадто складний для мене, щоби мати відповідь.",shape=box,color=red];
		304 -> 309;
	3901 [label="Chat ends.",color=orange];
	3903 [label="Оу, oui ? What is this ? Quelle audace, маю визнати, я здивована тобою ! Такого не очікувала…",shape=box,color=blue];
		3903 -> 3904;
	313 [label="Update boolean DrifterFaithPersonal",color=orange];
		313 -> 318;
	312 [label="+5 Chemistry",color=orange];
		312 -> 317;
	311 [label="+5 Chemistry",color=orange];
		311 -> 316;
	310 [label="+5 Chemistry",color=orange];
		310 -> 315;
	309 [label="Update boolean DrifterFaithAgnostic",color=orange];
		309 -> 314;
	3904 [label="Але ти намагаєшся відвернути мою увагу ! Я, звісно, не проти, але для такого наче ще зарано, n’est pas ?",shape=box,color=blue];
		3904 -> 3905;
	318 [label="+5 Chemistry",color=orange];
		318 -> 326;
	317 [label="Як би там не називалася віра, я знайду в ній красу. Повідай мені, вона нова ? Стара ? Я зможу її розпізнати взагалі ?",shape=box,color=blue];
		317 -> 324;
		317 -> 325;
	316 [label="Та невже ! O, comme c'est fascinant ! Знати, що хтось у такому далекому майбутньому досі вірує, cela remplit mon cœur de joie. Радість сповнює мене. Хоча, видається мені, що проведений тобою час у минулому міг якось на це вплинути, non? Хоча… неважливо.",shape=box,color=blue];
		316 -> 323;
	315 [label="Поважаю твою відповідь. Та все одно спитаю. Звідки така впевненість ? Хіба це теж не є своєрідною вірою ? А ще оте… Байдужість твоя ? Хіба то не божество ?",shape=box,color=blue];
		315 -> 320;
		315 -> 321;
		315 -> 322;
	314 [label="+10 Chemistry",color=orange];
		314 -> 319;
	3905 [label="Тож… я би хотіла отримати відповідь на своє запитання, s'il vous plait, якщо ти не проти. Ну ось, сиджу тепер… вся зашарілася !",shape=box,color=blue];
		3905 -> 308;
		3905 -> 307;
		3905 -> 306;
		3905 -> 305;
		3905 -> 304;
	326 [label="Ah, oui. Мандрівний дух. Недарма прозиваєшся саме так. Тобі довелося побачити багато культур, релігій та світів. Cela est très spirituel, non ? Збираєш їх як мушлі на узбережжі.",shape=box,color=blue];
		326 -> 336;
		326 -> 337;
	324 [label="Ні, не думаю, що ти її розпізнаєш.",shape=box,color=red];
		324 -> 334;
	325 [label="Можливо тобі вдасться розпізнати її частини. Але решта буде геть чужою.",shape=box,color=red];
		325 -> 335;
	323 [label="Мені цікава твоя відданість: Йому чи Їй? Чи ти шукаєш рівноваги ?",shape=box,color=blue];
		323 -> 331;
		323 -> 332;
		323 -> 333;
	320 [label="Не маю абсолютної впевненості у своїй правоті. Ніхто не має. Проте я особисто не вірю в ніяких богів.",shape=box,color=red];
		320 -> 328;
	321 [label="Думаю, що релігія існує для заповнення діри в людських життях, яку лишили страх смерті та острах перед невідомістю.",shape=box,color=red];
		321 -> 329;
	322 [label="Гадки не маю що таке по суті Байдужість, але це точно не божество. Нам просто треба докопатися до суті цієї сутності. ",shape=box,color=red];
		322 -> 330;
	319 [label="Ага ! Либонь наймудріша відповідь з усіх можливих ! Бо як це нам, простим смертним — якщо ще можемо такими називатися — удавати розгадування задумів Божих ?",shape=box,color=blue];
		319 -> 327;
	336 [label="Гадаю, що є дещо старіше, справжніше й глибше, що говорить до нас усіх. Якась своєрідна сполучна тканина.",shape=box,color=red];
		336 -> 347;
	337 [label="Саме таке. Я бачу дещо прекрасне в усіх. Не знаю, чи хтось за правду чи за кривду.",shape=box,color=red];
		337 -> 347;
	334 [label="Update boolean DrifterFaithYesForeign",color=orange];
		334 -> 345;
	335 [label="Update boolean DrifterFaithYesSimilar",color=orange];
		335 -> 346;
	331 [label="Мене більше притягує Сол. ",shape=box,color=red];
		331 -> 342;
	332 [label="Мене більше притягує Луа.",shape=box,color=red];
		332 -> 343;
	333 [label="Я волію до рівноваги. Гадаю це природніший порядок всього.",shape=box,color=red];
		333 -> 344;
	328 [label="Update boolean DrifterFaithNoMaybe",color=orange];
		328 -> 339;
	329 [label="Update boolean DrifterFaithNoFear",color=orange];
		329 -> 340;
	330 [label="Update boolean DrifterFaithNoMITW",color=orange];
		330 -> 341;
	327 [label="Часто я сиділа у святилищі мого Cathédrale й радісно балакала з незнайомцями, які приходили вчитися й нічого більше не хтіли.",shape=box,color=blue];
		327 -> 338;
	347 [label="+5 Chemistry",color=orange];
		347 -> 360;
	345 [label="+5 Chemistry",color=orange];
		345 -> 358;
	346 [label="+5 Chemistry",color=orange];
		346 -> 359;
	342 [label="Update boolean DrifterFaithSol",color=orange];
		342 -> 355;
	343 [label="Update boolean DrifterFaithLua",color=orange];
		343 -> 356;
	344 [label="Update boolean DrifterFaithBalance",color=orange];
		344 -> 357;
	339 [label="Oui, je vois… Напевно тобі потрібні власні «докази» для впевненості ? Невже у твоєму житті не траплялося нічого такого, що викликало подібні відчуття, як в нас — віра та запал ?",shape=box,color=blue];
		339 -> 350;
		339 -> 351;
	340 [label="Oui, c'est vrai — саме так. Віра дає багато відповідей для багатьох душ. Ти не боїшся того, що може статися після смерті ?",shape=box,color=blue];
		340 -> 352;
		340 -> 353;
	341 [label="Comme c'est fascinant… і от тепер їх стало двоє, котрі говорять однаково… диявол прошепотів так само.",shape=box,color=blue];
		341 -> 354;
	338 [label="Вони так цікавилися нашою вірою, але не хотіли сказати «так, так, ось ця істинна». Я можу лише сподіватися, що дала їм частину нашої благодаті, коли вони йшли.",shape=box,color=blue];
		338 -> 348;
		338 -> 349;
	360 [label="Je comprends et c'est magnifique. Мене часто навідують думки, а чи не носять Світочі інші обличчя. Інші імена.",shape=box,color=blue];
		360 -> 373;
	358 [label="Oh, comme c'est fascinant ! Я б із радістю котрогось дня познайомилася з твоєю вірою. Дізналася б про обряди.",shape=box,color=blue];
		358 -> 371;
		358 -> 372;
	359 [label="Oh, comme c'est fascinant ! Я би з радістю котрогось дня дізналася як вона може бути такою спорідненою й водночас іншою.",shape=box,color=blue];
		359 -> 371;
		359 -> 372;
	355 [label="+10 Chemistry",color=orange];
		355 -> 368;
	356 [label="+5 Chemistry",color=orange];
		356 -> 369;
	357 [label="+5 Chemistry",color=orange];
		357 -> 370;
	350 [label="Ні, я просто не вірю.",shape=box,color=red];
		350 -> 363;
	351 [label="Саме так. Мені ніколи не вдавалося відчути… «віру». Потреби в ній не виникало.",shape=box,color=red];
		351 -> 364;
	352 [label="Усі помирають. Боятися цього — дурість. Вона прийде за нами всіма. Принаймні… повинна прийти.",shape=box,color=red];
		352 -> 365;
	353 [label="Мені вдосталь довелося повмирати. Я не боюся того, що буде потім. Я прагну цього.",shape=box,color=red];
		353 -> 366;
	354 [label="+5 Chemistry",color=orange];
		354 -> 367;
	348 [label="Мене трішки дивує, що ти радо приймаєш людей, котрі не вірять у твою віру.",shape=box,color=red];
		348 -> 361;
	349 [label="Це воно. Мені не хочеться визнавати якусь «правильною» чи «неправильною».",shape=box,color=red];
		349 -> 362;
	373 [label="Відомо про їхню зміну форм для задоволення послідовників з інших сект. Та це моя віра, але не твоя.",shape=box,color=blue];
		373 -> 386;
	371 [label="Залюбки.",shape=box,color=red];
		371 -> 384;
	372 [label="Мене дивує, що тобі імпонує думка існування інших релігій. ",shape=box,color=red];
		372 -> 385;
	368 [label="Ти йдеш стежками мого серця ! Якби ж тобі бачити зараз усмішку на моєму обличчі. Сподіваюся, це не було лукавістю з твоєї сторони, аби лестити мені.",shape=box,color=blue];
		368 -> 382;
	369 [label="Ага, мандрівна душа ступає стежками ночі, як і мій дорогий Ліон. Коли він буде готовий, то вам варто поговорити про звички його темної панянки. Він буде неймовірно задоволений.",shape=box,color=blue];
		369 -> 382;
	370 [label="Рівновага без зайвої нерішучості. Іти своїм життям, знаючи про схід сонця й про схід місяця у відповідь, але ніколи не стати жертвою сумлінь ?",shape=box,color=blue];
		370 -> 383;
	363 [label="+5 Chemistry",color=orange];
		363 -> 376;
	364 [label="+5 Chemistry",color=orange];
		364 -> 377;
	365 [label="+5 Chemistry",color=orange];
		365 -> 378;
	366 [label="+5 Chemistry",color=orange];
		366 -> 379;
	367 [label="Моє серце крається від думки про довіру до нього. Але в цьому ? Либонь тобі варто побалакати з ним. Та пильнуй. Диявол веде небезпечні ігри.",shape=box,color=blue];
		367 -> 380;
		367 -> 381;
	361 [label="Я припускала, що це може дивувати. Коли хтось у певних вирядах, не відповідає за визначенням очікуванням інших. На мою думку, проповідування тим, хто не прагне знайти розраду, не приносить великої любові.",shape=box,color=blue];
		361 -> 374;
	362 [label="+5 Chemistry",color=orange];
		362 -> 375;
	386 [label="Чи можу сподіватися хоча б, що твоя віра дає тобі спокій ?",shape=box,color=blue];
		386 -> 394;
		386 -> 395;
		386 -> 396;
	384 [label="Ô joie ! Я обожнюю вивчати щось нове. Мене часто навідують думки, а чи не носять Світочі інші обличчя. Інші імена.",shape=box,color=blue];
		384 -> 398;
	385 [label="Я припускала, що це може дивувати. Коли хтось у певних вирядах, не відповідає за визначенням очікуванням інших. На мою думку, проповідування тим, хто не прагне знайти розраду, не приносить великої любові.",shape=box,color=blue];
		385 -> 399;
	382 [label="Мені просто цікаво, чи наша віра дає тобі спокій ?",shape=box,color=blue];
		382 -> 394;
		382 -> 395;
		382 -> 396;
	383 [label="Це рідкісний дар… і сподіваюся ти володієш ним. Маю острах, що задовге перебування на роздоріжжі призведе до поглинання в боротьбі.",shape=box,color=blue];
		383 -> 397;
	376 [label="Тоді життя напевно стає простішим. Не жити за законами богів та церков. Визнаю, я трішки заздрю.",shape=box,color=blue];
		376 -> 389;
	377 [label="Тоді я заздрю тобі, мандрівниче ! Жити так багато століть уникаючи потреби пізнання богів.",shape=box,color=blue];
		377 -> 389;
	378 [label="Ти говориш словами послідовників Луа. І це я не для образи кажу. Oui, Карга прийде за нами всіма й проллє свої срібні сльози. Але твої слова дивують мене…",shape=box,color=blue];
		378 -> 390;
	379 [label="Oui, і це дивує мене. Я дивлюся на вас: на дитя, диявола, навіть монсеньйора Лойда чи le Cardinal… за вами всіма довга вервиця століть.",shape=box,color=blue];
		379 -> 391;
	380 [label="Що за небезпечна гра?",shape=box,color=red];
		380 -> 392;
	381 [label="Він також не вважає Людину в стіні реальною, так?",shape=box,color=red];
		381 -> 393;
	374 [label="+5 Chemistry",color=orange];
		374 -> 387;
	375 [label="Я тішуся з твоєї мудрості й доброти в ставленні до вірувань інших.",shape=box,color=blue];
		375 -> 388;
	394 [label="Ні.",shape=box,color=red];
		394 -> 400;
	395 [label="Я насправді взагалі про це не думаю.",shape=box,color=red];
		395 -> 401;
	396 [label="Так.",shape=box,color=red];
		396 -> 402;
	398 [label="Відомо про їхню зміну форм для задоволення послідовників з інших сект. Та це моя віра, але не твоя. Я не проповідуватиму тим, хто не прагне знайти розраду. Я знаю, що це не принесе великої любові.",shape=box,color=blue];
		398 -> 399;
	399 [label="Ні, моя віра — то моя віра, а твоя — твоя власна. Я сподіваюся, вона дає тобі спокій ?",shape=box,color=blue];
		399 -> 394;
		399 -> 395;
		399 -> 396;
	397 [label="Зрештою, усі мають вибрати шлях яким ітимуть. Але ми всі маємо почати з перехрестя. Рівновага — фундамент усіх основ.",shape=box,color=blue];
		397 -> 403;
	389 [label="Але, мені цікаво… оце невірування. Воно дає тобі спокій ?",shape=box,color=blue];
		389 -> 394;
		389 -> 395;
		389 -> 396;
	390 [label="Про кого ти говориш, що «вона має прийти» за вами всіма ? Я дивлюся на вас: на дитя, диявола, навіть монсеньйора Лойда чи le Cardinal… за вами всіма довга вервиця століть.",shape=box,color=blue];
		390 -> 391;
	391 [label="Цікаво, скільки століть пройде для нас, перш ніж Луа прийде. І мені цікаво, як палко я прийму її обійми, коли настане той день. Та це моя віра, але не твоя.",shape=box,color=blue];
		391 -> 389;
	392 [label="Я ще точно не знаю. Він тримає свої плани при собі, як і належить дияволу. Але він не вірить ні в яких богів. Окрім, хіба що, себе.",shape=box,color=blue];
		392 -> 389;
	393 [label="Non, не вірить. Він дуже схожий на тебе — не вірить ні в яких богів. Окрім, хіба що, себе.",shape=box,color=blue];
		393 -> 389;
	387 [label="Non, усіх, хто йде з відкритим розумом приймати радо треба з відкритими обіймами.",shape=box,color=blue];
		387 -> 388;
	388 [label="Мені просто цікаво, чи дає це тобі спокій ?",shape=box,color=blue];
		388 -> 394;
		388 -> 395;
		388 -> 396;
	400 [label="Update boolean DrifterFaithNoPeace",color=orange];
		400 -> 404;
	401 [label="+10 Chemistry",color=orange];
		401 -> 405;
	402 [label="+10 Chemistry",color=orange];
		402 -> 406;
	403 [label="Update boolean DrifterCrossroads",color=orange];
		403 -> 407;
	404 [label="+10 Chemistry",color=orange];
		404 -> 408;
	405 [label="Безмежно заздрю ! Я захлинаюсь нею. Я… з радістю побалакаю про це знову, якщо ти дозволиш мені ? Я не прагну ані проповідувати, ані вмішуватися. Я не бажаю завдати тобі прикростей.",shape=box,color=blue];
		405 -> 409;
	406 [label="Тоді я знаю, що мій Сол усміхається тобі. Неважливо, чи ти молишся йому, бо тобі вдалося знайти потрібний тобі шлях.",shape=box,color=blue];
		406 -> 410;
	407 [label="Йой, pardonne-moi ! Маленька Марі проповідує, яка ганьба ! Я ж тут не для читання нотацій та лекцій, як якась учителька.",shape=box,color=blue];
		407 -> 382;
	408 [label="Я зворушена до глибини душі твоєю чесністю, мандрівниче. Я… з радістю побалакаю про це знову, якщо дозволиш ? Я не прагну ані проповідувати, ані вмішуватися. Я не бажаю завдати тобі прикростей.",shape=box,color=blue];
		408 -> 409;
	409 [label="Я всього-на-всього допитлива. І хочу допомогти чим зможу. Відмов мені, і більше цієї теми не підійматимемо.",shape=box,color=blue];
		409 -> 411;
		409 -> 412;
	410 [label="Я поцікавлюся, чи зможемо якось іще поговорити не цю тему ? Надто кортить дізнатися більше.",shape=box,color=blue];
		410 -> 411;
		410 -> 412;
	411 [label="Та ні, не варто.",shape=box,color=red];
		411 -> 413;
	412 [label="Так, звісно.",shape=box,color=red];
		412 -> 414;
	413 [label="Update boolean DrifterFaithStop",color=orange];
		413 -> 415;
	414 [label="Merci, merci ! Ти проявляєш стільки довіри, розповідаючи мені це все. Я не змарную її. Бувай.",shape=box,color=blue];
		414 -> 416;
	415 [label="Цілковито розумію. Не ображаюся. Дякую, що всі мої повідомлення дочитані до кінця і дуже вдячна за те, чим зі мною ділишся. Віднині балакатимемо на інші теми. Бачить Сол, у нас їх доста !",shape=box,color=blue];
		415 -> 417;
	416 [label="Chat ends.",color=orange];
	417 [label="Chat ends.",color=orange];
}