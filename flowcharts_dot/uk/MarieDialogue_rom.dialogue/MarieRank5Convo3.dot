	j1703262758 [label="А, бджола!",shape=box,color=red];
		j1703262758 -> j918627081;
	j3485769665 [label="Нє, не розумію… пояснюй далі.",shape=box,color=red];
		j3485769665 -> j1218979215;
	j3962563199 [label="Не говоритиму про віру, окрім… ми можемо думати про недосконалість наших форм, бо маємо обмежений розум. І маємо… змиритися з тим, якими є, non ? Це все, що лишається.",shape=box,color=blue];
		j3962563199 -> j2548984291;
	j924310819 [label="Я знаю, що наші віри подібні за формою, тож скажу так… Сол вважав правильним зробити мене такою. Я маю вірити його плану, non ? Яким би недосконалим я його не бачила своїм обмеженим розумом. Було б дивно, якби в тебе була інша думка.",shape=box,color=blue];
		j924310819 -> j2548984291;
	j2927766128 [label="Я знаю, що наші віри геть не схожі формою, тож не казатиму про те, чого не знаю… Однак просто зауважу, що Сол вважав правильним зробити мене такою. Я маю вірити його плану, non ? Яким би недосконалим я його не бачила своїм обмеженим розумом. Було б дивно, якби в тебе була інша думка.",shape=box,color=blue];
		j2927766128 -> j2548984291;
	j3510988333 [label="Я знаю, що твоя віра — твоя особиста справа, тож не лізтиму. Однак зауважу, що Сол вважав правильним зробити мене такою. Я маю вірити його плану, non ? Яким би недосконалим я його не бачила своїм обмеженим розумом. Було б дивно, якби в тебе була інша думка.",shape=box,color=blue];
		j3510988333 -> j2548984291;
	j295304239 [label="Сол вважав правильним зробити нас такими як є. Мусимо вірити в його план, non ? Яким би недосконалим ми його не бачили своїм обмеженим розумом.",shape=box,color=blue];
		j295304239 -> j2548984291;
	j3895861822 [label="Луа вважала правильним зробити тебе саме так. А Сол зробив мене такою, як я є. Мусимо вірити в їхній план, non ? Яким би недосконалим ми його не бачили своїм обмеженим розумом.",shape=box,color=blue];
		j3895861822 -> j2548984291;
	j2647961608 [label="Світочі вважали правильним зробити нас такими як є. Мусимо вірити в їхній план, non ? Яким би недосконалим ми його не бачили своїм обмеженим розумом.",shape=box,color=blue];
		j2647961608 -> j2548984291;
	j2815041015 [label="Знаю, що ти вважаєш, що ніхто з нас не має істинних відповідей на питання всесвітніх масштабів. І я хвалю й поважаю це. Однак просто зауважу, що Сол вважав правильним зробити мене такою. Я маю вірити його плану, non ? Яким би недосконалим я його не бачила своїм обмеженим розумом.",shape=box,color=blue];
		j2815041015 -> j2548984291;
	j1506224360 [label="Знаю, що в тобі немає віри. І поважаю це. Однак просто зауважу, що Сол вважав правильним зробити мене такою. Я маю вірити його плану, non ? Яким би недосконалим я його не бачила своїм обмеженим розумом.",shape=box,color=blue];
		j1506224360 -> j2548984291;
	j2145038065 [label="Просто зазначу, що Сол вважав правильним зробити мене такою, як я є. Мусимо вірити в його план, non ? Яким би недосконалим я його не бачила своїм обмеженим розумом.",shape=box,color=blue];
		j2145038065 -> j2548984291;
	j918627081 [label="Бджола, abeille ! Пф, одне й те саме. Ха ! ",shape=box,color=blue];
		j918627081 -> j3515570948;
	j1218979215 [label="Літає за допомогою маленьких крилець над квіточками і… чекай. Non. Ти мене розігруєш !",shape=box,color=blue];
		j1218979215 -> j3515570948;
