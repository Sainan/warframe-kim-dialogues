	2802 [label="Check boolean DrifterChronicPain",color=orange];
		2802 -> 2808 [label=true,color=green];
		2802 -> 2809 [label=false,color=brown];
	2803 [label="О, це запитання… дуже добрий вчинок від тебе… Усе буде добре. Не хочу завдавати тобі клопотів. Ліпше не чіпай мене до завтра.",shape=box,color=blue];
		2803 -> 2806;
		2803 -> 2807;
	2805 [label="О, mon cœur, це запитання… дуже добрий вчинок від тебе… але, як і завжди… боюся, що все пізнається в la comparaison. Але ж, упевнена, тобі це відомо, oui ?",shape=box,color=blue];
		2805 -> 2812;
		2805 -> 2813;
	2804 [label="О, mon cœur, це запитання… дуже добрий вчинок від тебе… але, як і завжди… боюся, що все пізнається в порівнянні.",shape=box,color=blue];
		2804 -> 2810;
		2804 -> 2811;
	2806 [label="Щось не так?",shape=box,color=red];
		2806 -> 2814;
	2807 [label="Добре, гаразд. Якщо впевнена в цьому.",shape=box,color=red];
		2807 -> 2815;
	2808 [label="О, це запитання… дуже добрий вчинок від тебе… але, як і завжди… боюся, що все пізнається в порівнянні. Але ж, упевнена, тобі це відомо, oui ?",shape=box,color=blue];
		2808 -> 2812;
		2808 -> 2813;
	2809 [label="О, це запитання… дуже добрий вчинок від тебе… але, як і завжди… боюся, що все пізнається в порівнянні.",shape=box,color=blue];
		2809 -> 2810;
		2809 -> 2811;
	2812 [label="Мені дуже шкода, якщо питання завдало болю.",shape=box,color=red];
		2812 -> 2818;
	2813 [label="Можу щось зробити, щоби поліпшити ситуацію? Або якось відвернути увагу на щось інше?",shape=box,color=red];
		2813 -> 2819;
	2810 [label="Ой, вибач… поганий болісний день? ",shape=box,color=red];
		2810 -> 2816;
	2811 [label="Я можу чимось допомогти?",shape=box,color=red];
		2811 -> 2817;
	2814 [label="Vraiment gentil, та це давня проблема, не варта твоїх клопотів. Упораюся.",shape=box,color=blue];
		2814 -> 2820;
	2815 [label="+10 Chemistry",color=orange];
		2815 -> 2821;
	2818 [label="+10 Chemistry",color=orange];
		2818 -> 2825;
	2819 [label="+10 Chemistry",color=orange];
		2819 -> 2826;
	2816 [label="Oui, на жаль. Наш розум насправді дуже дивовижна штука. Мене вражає, що вони весь час болять, постійно. Але якось свідомість навчилася ігнорувати це.",shape=box,color=blue];
		2816 -> 2822;
		2816 -> 2823;
		2816 -> 2824;
	2817 [label="Ти вже це робиш, переписуючись зі мною. Розум дуже дивовижний, non ? Гадаю mes pieds повинні постійно боліти, але свідомість навчилася якось це повністю ігнорувати.",shape=box,color=blue];
		2817 -> 2822;
		2817 -> 2823;
		2817 -> 2824;
	2820 [label="Update boolean MarieChronicPain",color=orange];
		2820 -> 2827;
		2820 -> 2828;
		2820 -> 2829;
	2821 [label="Oui, усе нормально, запевняю. Але merci за турботу.",shape=box,color=blue];
		2821 -> 2830;
	2825 [label="Ха ! Дивно це все, non ? Саме так. Я не думала про mes pieds, але тепер думаю, і вони болять. ",shape=box,color=blue];
		2825 -> 2834;
	2826 [label="Oui ! Ти вже це робиш, переписуючись зі мною. Розум дуже дивовижний, non ? Гадаю mes pieds повинні постійно боліти, але свідомість навчилася якось це повністю ігнорувати.",shape=box,color=blue];
		2826 -> 2835;
		2826 -> 2836;
		2826 -> 2837;
	2822 [label="Напевно, це дуже виснажливо…",shape=box,color=red];
		2822 -> 2831;
	2823 [label="Напевно, це дуже фруструє…",shape=box,color=red];
		2823 -> 2832;
	2824 [label="І нема ліків? Біль не вщухає?",shape=box,color=red];
		2824 -> 2833;
	2827 [label="Як скажеш, але я тут, якщо захочеш обговорити.",shape=box,color=red];
		2827 -> 2838;
	2828 [label="Я… я знаю як це. Перш ніж «зациклитися в петлях», мені було дуже зле в Дувірі. Рани загоєно, але іноді досі дуже сильно свербить. Я намагаюся приховувати зовнішні прояви, коли терпіти майже нестерпно.",shape=box,color=red];
		2828 -> 2839;
	2829 [label="Наскільки я знаю, то старі постійні проблеми можуть бути такими проблемними, як і нові. Те, що вони повертаються і йдуть чи лишаються поруч на деякий час, не означає, що про них не варто говорити.",shape=box,color=red];
		2829 -> 2840;
	2830 [label="Chat ends.",color=orange];
	2834 [label="Наш розум насправді дуже дивовижна штука. Мене вражає, що вони весь час болять, постійно. Але якось свідомість навчилася ігнорувати це.",shape=box,color=blue];
		2834 -> 2835;
		2834 -> 2836;
		2834 -> 2837;
	2835 [label="Аналогічно. Щойно втрачаєш зосередженість — привіт, біль. Іноді розмірковую, чи це не тому постійно шукаю собі якісь клятські пригоди.",shape=box,color=red];
		2835 -> 2845;
	2836 [label="Іноді я дуже лютую, думаючи про те, скільки можна було б зробити, якби біль не відвертала увагу.",shape=box,color=red];
		2836 -> 2846;
	2837 [label="Ти теж відчуваєш постійну втому? Іноді я думаю, чи це не біль мене виснажує? Стільки повторів витрачено на те, щоби притлумити біль, запхати десь у підсвідомість.",shape=box,color=red];
		2837 -> 2847;
	2831 [label="+10 Chemistry",color=orange];
		2831 -> 2841;
	2832 [label="Check boolean MarieSecretPower",color=orange];
		2832 -> 2842 [label=true,color=green];
		2832 -> 2843 [label=false,color=brown];
	2833 [label="Non… ніколи не йде. Я можу лише на щось відірватися. Як от на подібні розмови. Або чимось постійно бути заклопотаною.",shape=box,color=blue];
		2833 -> 2844;
	2838 [label="Це дуже мило з твого боку… і… що ж. Перестану бути маленькою впертою Марі.",shape=box,color=blue];
		2838 -> 2848;
	2839 [label="Update boolean DrifterChronicPain",color=orange];
		2839 -> 2849;
	2840 [label="Oui, твоя правда. Знову я була маленькою впертою Марі.",shape=box,color=blue];
		2840 -> 2848;
	2845 [label="+5 Chemistry",color=orange];
		2845 -> 2854;
	2846 [label="Check boolean MarieSecretPower",color=orange];
		2846 -> 2855 [label=true,color=green];
		2846 -> 2856 [label=false,color=brown];
	2847 [label="+5 Chemistry",color=orange];
		2847 -> 2857;
	2841 [label="Oui, так і є. Par exemple…",shape=box,color=blue];
		2841 -> 2850;
	2842 [label="Але це стало… як там тобою означене… Усі незручності, як мої, мають у собі таємну силу. Нам просто потрібно відшукати її.",shape=box,color=blue];
		2842 -> 2851;
	2843 [label="Oui, так і є. Іноді я просто сиділа й витріщалася на книгу, що на верхньому ряду шафи, і думала про те, як несправедливо, що не можу дістати її.",shape=box,color=blue];
		2843 -> 2852;
	2844 [label="Одного дня я вирішила повитирати пил з усіх люстр у святилищі. Монсеньйор Лойд благав припинити.",shape=box,color=blue];
		2844 -> 2853;
	2848 [label="Це дещо складно пояснити. Але я спробую. Mes pieds, oui ? Ніженьки мої. Sérum змінила мене, дала можливість літати…",shape=box,color=blue];
		2848 -> 2858;
	2849 [label="Par les Luminaires, мені так шкода. То тоді ти розумієш як це, oui ?",shape=box,color=blue];
		2849 -> 2859;
	2854 [label="Oui ! О, одного дня я вирішила повитирати пил з усіх люстр у святилищі. Монсеньйор Лойд благав припинити.",shape=box,color=blue];
		2854 -> 2863;
	2855 [label="Але це стало… як там тобою означене… Усі незручності, як наші, мають у собі таємну силу. Нам просто потрібно відшукати її.",shape=box,color=blue];
		2855 -> 2864;
	2856 [label="Oui, розумію твою фрустрацію. Іноді я просто сиділа й витріщалася на книгу, що на верхньому ряду шафи, і думала про те, як несправедливо, що не можу дістати її.",shape=box,color=blue];
		2856 -> 2865;
	2857 [label="Oui !! Ти мене розумієш !! Par exemple…",shape=box,color=blue];
		2857 -> 2866;
	2850 [label="Знаєш як утомлюють постійні польоти, jour après jour, heure après heure, коли інші можуть просто ходити ?",shape=box,color=blue];
		2850 -> 2860;
	2851 [label="Так. Фрустрація неймовірна. Іноді я просто сиділа й витріщалася на книгу, що на верхньому ряду шафи, і думала про те, як несправедливо, що не можу дістати її.",shape=box,color=blue];
		2851 -> 2852;
	2852 [label="Що саме в ній містяться знання, які мені потрібні. Лише мені й нікому більше, тож чому я не можу отримати їх ? І от з’являлася добра душа, яка з жалості, діставала мені її…",shape=box,color=blue];
		2852 -> 2861;
	2853 [label="Я пояснила, що маю бути постійно зайнятою, щоб руки не знали спочину. Не думаю, що він достоту зрозумів, чому я повинна бути такою активною весь час.",shape=box,color=blue];
		2853 -> 2862;
	2858 [label="Але я досі відчуваю їх. Ті потворні штуки, які погрожували поглинути мене, знищити всю надію і висмоктати joie з моєї душі.",shape=box,color=blue];
		2858 -> 2867;
	2859 [label="Мати тіло, яке тебе зраджує. Гнітить твій дух і сповільнює його. Навіть зараз. Це так дивно. Sérum змінила мене, дала можливість літати…",shape=box,color=blue];
		2859 -> 2868;
	2863 [label="Я пояснила, що маю бути постійно зайнятою, щоб руки не знали спочину. Не думаю, що він достоту зрозумів, чому я повинна бути такою активною весь час.",shape=box,color=blue];
		2863 -> 2872;
	2864 [label="Але розумію твою фрустрацію. Ще й як. Іноді я просто сиділа й витріщалася на книгу, що на верхньому ряду шафи, і думала про те, як несправедливо, що не можу дістати її.",shape=box,color=blue];
		2864 -> 2865;
	2865 [label="Що саме в ній містяться знання, які мені потрібні. Лише мені й нікому більше, тож чому я не можу отримати їх ? І от з’являлася добра душа, яка з жалості, діставала мені її…",shape=box,color=blue];
		2865 -> 2873;
		2865 -> 2874;
	2866 [label="Знаєш як утомлюють постійні польоти, jour après jour, heure après heure, коли інші можуть просто ходити ?",shape=box,color=blue];
		2866 -> 2875;
	2860 [label="Не зрозумій неправильно. Я ravie від своєї рухливості. Я можу дістати все, що забажаю. Але ж це так виснажливо !",shape=box,color=blue];
		2860 -> 2862;
	2861 [label="То не їхня провина, що вони виявляють доброту — допомога мені потрібна. І не їхня провина, що допомога потрібна. Просто… це так фруструє… ця потреба тієї допомоги.",shape=box,color=blue];
		2861 -> 2869;
		2861 -> 2870;
	2862 [label="Знаєш… це так приємно, що є можливість поділитися з кимось. Не можу добрати слів. Рідко коли вдається обговорити невидиму мовчазну неміч, від якої я страждаю.",shape=box,color=blue];
		2862 -> 2871;
	2867 [label="Завжди болять. Завжди. Навіть зараз, коли я сиджу тут і думаю про них, то відчуваю біль. Але не завжди такий, що можу помітити.",shape=box,color=blue];
		2867 -> 2811;
		2867 -> 2810;
	2868 [label="Але я досі відчуваю їх. Ті потворні штуки, які погрожували поглинути мене, знищити всю надію і висмоктати joie з моєї душі.",shape=box,color=blue];
		2868 -> 2876;
	2872 [label="Я така щаслива, що хтось тут розуміє, як це воно — це дуже рідкісні випадки. Ця мовчазна незрима неміч змушує нас страждати.",shape=box,color=blue];
		2872 -> 2880;
	2873 [label="І що в цьому поганого?",shape=box,color=red];
		2873 -> 2881;
	2874 [label="Так. Я знаю. Нема в тім їхньої провини.",shape=box,color=red];
		2874 -> 2882;
	2875 [label="Не зрозумій неправильно. Я ravie від своєї рухливості. Я можу дістати все, що забажаю. Але ж це так виснажливо !!",shape=box,color=blue];
		2875 -> 2872;
	2869 [label="Мені шкода, що тобі так тяжко. ",shape=box,color=red];
		2869 -> 2877;
	2870 [label="І навіть не можеш обговорити свою фрустрацію.",shape=box,color=red];
		2870 -> 2877;
	2871 [label="Як маленька abeille, що прилітає кожного дня, сідає на плече і жалить. Цього недостатньо, щоб убити, але дуже дратує й заважає.",shape=box,color=blue];
		2871 -> 2878;
		2871 -> 2879;
	2876 [label="Завжди болять. Завжди. Навіть зараз, коли я сиджу тут і думаю про них, то відчуваю біль. Але не завжди такий, що можу помітити.",shape=box,color=blue];
		2876 -> 2813;
		2876 -> 2812;
	2880 [label="Як маленька abeille, що прилітає до нас кожного дня, сідає на плече і жалить. Цього недостатньо, щоб убити нас, але дуже дратує й заважає.",shape=box,color=blue];
		2880 -> 2879;
		2880 -> 2878;
	2881 [label="Нічого ! Нічого поганого ! Я потребувала допомоги. Але в тому й суть — я. потребувала. допомоги. І це, як ти кажеш… фруструє.",shape=box,color=blue];
		2881 -> 2885;
	2882 [label="Oui ! То не їхня провина, що вони виявляють доброту — допомога мені потрібна. І не їхня провина, що допомога потрібна. Просто… це так фруструє… ця потреба тієї допомоги.",shape=box,color=blue];
		2882 -> 2885;
	2877 [label="+10 Chemistry",color=orange];
		2877 -> 2862;
	2878 [label="Що ж, дуже хотілося б, щоби він пішов…",shape=box,color=red];
		2878 -> 2883;
	2879 [label="Що таке «abeille»?",shape=box,color=red];
		2879 -> 2884;
	2885 [label="+5 Chemistry",color=orange];
		2885 -> 2872;
	2883 [label="І я теж ! Але ж водночас, це формує нас такими, якими ми є, non ? Як ми можемо визначитися, які наші частини важливі, а які ні ?",shape=box,color=blue];
		2883 -> 2886;
	2884 [label="О ! Крихітна маленька штучка, жовто-чорна, смугаста, має голку на derrière… робить мед ?",shape=box,color=blue];
		2884 -> 2887;
		2884 -> 2888;
	2886 [label="Evaluate expressions",color=orange];
		2886 -> 2892 [label="DrifterFaithStop",color=purple];
		2886 -> 2891 [label="DrifterFaithYesSimilar",color=purple];
		2886 -> 2893 [label="DrifterFaithYesForeign",color=purple];
		2886 -> 2894 [label="DrifterFaithPersonal",color=purple];
		2886 -> 2898 [label="DrifterFaithSol",color=purple];
		2886 -> 2889 [label="DrifterFaithLua",color=purple];
		2886 -> 2890 [label="DrifterFaithBalance",color=purple];
		2886 -> 2895 [label="DrifterFaithAgnostic",color=purple];
		2886 -> 2896 [label="DrifterFaithNoFear",color=purple];
		2886 -> 2896 [label="DrifterFaithNoMaybe",color=purple];
		2886 -> 2896 [label="DrifterFaithNoMITW",color=purple];
		2886 -> 2897 [label="false",color=purple];
	2887 [label="А, бджола!",shape=box,color=red];
		2887 -> 2899;
	2888 [label="Нє, не розумію… пояснюй далі.",shape=box,color=red];
		2888 -> 2900;
	2892 [label="Не говоритиму про віру, окрім… ми можемо думати про недосконалість наших форм, бо маємо обмежений розум. І маємо… змиритися з тим, якими є, non ? Це все, що лишається.",shape=box,color=blue];
		2892 -> 2901;
	2891 [label="Я знаю, що наші віри подібні за формою, тож скажу так… Сол вважав правильним зробити мене такою. Я маю вірити його плану, non ? Яким би недосконалим я його не бачила своїм обмеженим розумом. Було б дивно, якби в тебе була інша думка.",shape=box,color=blue];
		2891 -> 2901;
	2893 [label="Я знаю, що наші віри геть не схожі формою, тож не казатиму про те, чого не знаю… Однак просто зауважу, що Сол вважав правильним зробити мене такою. Я маю вірити його плану, non ? Яким би недосконалим я його не бачила своїм обмеженим розумом. Було б дивно, якби в тебе була інша думка.",shape=box,color=blue];
		2893 -> 2901;
	2894 [label="Я знаю, що твоя віра — твоя особиста справа, тож не лізтиму. Однак зауважу, що Сол вважав правильним зробити мене такою. Я маю вірити його плану, non ? Яким би недосконалим я його не бачила своїм обмеженим розумом. Було б дивно, якби в тебе була інша думка.",shape=box,color=blue];
		2894 -> 2901;
	2898 [label="Сол вважав правильним зробити нас такими як є. Мусимо вірити в його план, non ? Яким би недосконалим ми його не бачили своїм обмеженим розумом.",shape=box,color=blue];
		2898 -> 2901;
	2889 [label="Луа вважала правильним зробити тебе саме так. А Сол зробив мене такою, як я є. Мусимо вірити в їхній план, non ? Яким би недосконалим ми його не бачили своїм обмеженим розумом.",shape=box,color=blue];
		2889 -> 2901;
	2890 [label="Світочі вважали правильним зробити нас такими як є. Мусимо вірити в їхній план, non ? Яким би недосконалим ми його не бачили своїм обмеженим розумом.",shape=box,color=blue];
		2890 -> 2901;
	2895 [label="Знаю, що ти вважаєш, що ніхто з нас не має істинних відповідей на питання всесвітніх масштабів. І я хвалю й поважаю це. Однак просто зауважу, що Сол вважав правильним зробити мене такою. Я маю вірити його плану, non ? Яким би недосконалим я його не бачила своїм обмеженим розумом.",shape=box,color=blue];
		2895 -> 2901;
	2896 [label="Знаю, що в тобі немає віри. І поважаю це. Однак просто зауважу, що Сол вважав правильним зробити мене такою. Я маю вірити його плану, non ? Яким би недосконалим я його не бачила своїм обмеженим розумом.",shape=box,color=blue];
		2896 -> 2901;
	2897 [label="Просто зазначу, що Сол вважав правильним зробити мене такою, як я є. Мусимо вірити в його план, non ? Яким би недосконалим я його не бачила своїм обмеженим розумом.",shape=box,color=blue];
		2897 -> 2901;
	2899 [label="Бджола, abeille ! Пф, одне й те саме. Ха ! ",shape=box,color=blue];
		2899 -> 2902;
	2900 [label="Літає за допомогою маленьких крилець над квіточками і… чекай. Non. Ти мене розігруєш !",shape=box,color=blue];
		2900 -> 2902;
