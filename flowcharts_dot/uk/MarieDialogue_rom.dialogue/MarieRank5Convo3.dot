	2800 [label="Check boolean DrifterChronicPain",color=orange];
		2800 -> 2805 [label=true,color=green];
		2800 -> 2804 [label=false,color=brown];
	2801 [label="О, mon cœur, це запитання… дуже добрий вчинок від тебе… Усе буде добре. Не хочу завдавати тобі клопотів. Ліпше не чіпай мене до завтра.",shape=box,color=blue];
		2801 -> 2806;
