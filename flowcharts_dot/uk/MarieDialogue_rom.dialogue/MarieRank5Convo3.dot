	j3914533388 [label="Можливо, намагатися знайти спокій у планах всесвіту, якому, імовірно, байдуже — несусвітня дурість. Але я все ж знаходжу в цьому бажаний спокій. І тобі бажаю того ж.",shape=box,color=blue];
		j3914533388 -> j1324912993;
	j1765681085 [label="Можливо, намагатися знайти спокій у планах всесвіту, якому, імовірно, байдуже — несусвітня дурість. Але я все ж знаходжу в цьому бажаний спокій.",shape=box,color=blue];
