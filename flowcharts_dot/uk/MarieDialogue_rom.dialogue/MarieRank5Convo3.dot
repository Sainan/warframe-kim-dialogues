	j2252086186 [label="Check boolean MarieChronicPain",color=orange];
		j2252086186 -> j2205340338 [label=true,color=green];
		j2252086186 -> j1041149674 [label=false,color=brown];
	j226023158 [label="Check boolean MarieChronicPain",color=orange];
		j226023158 -> j899553308 [label=true,color=green];
		j226023158 -> j3670486583 [label=false,color=brown];
	j2205340338 [label="Check boolean DrifterChronicPain",color=orange];
		j2205340338 -> j710770176 [label=true,color=green];
		j2205340338 -> j1041395041 [label=false,color=brown];
	j1041149674 [label="О, mon cœur, це запитання… дуже добрий вчинок від тебе… Усе буде добре. Не хочу завдавати тобі клопотів. Ліпше не чіпай мене до завтра.",shape=box,color=blue];
		j1041149674 -> j1712123713;
		j1041149674 -> j354472230;
	j899553308 [label="Check boolean DrifterChronicPain",color=orange];
		j899553308 -> j3109472886 [label=true,color=green];
		j899553308 -> j1945903016 [label=false,color=brown];
	j3670486583 [label="О, це запитання… дуже добрий вчинок від тебе… Усе буде добре. Не хочу завдавати тобі клопотів. Ліпше не чіпай мене до завтра.",shape=box,color=blue];
		j3670486583 -> j1712123713;
		j3670486583 -> j354472230;
	j710770176 [label="О, mon cœur, це запитання… дуже добрий вчинок від тебе… але, як і завжди… боюся, що все пізнається в la comparaison. Але ж, упевнена, тобі це відомо, oui ?",shape=box,color=blue];
		j710770176 -> j2328065882;
		j710770176 -> j3058272380;
	j1041395041 [label="О, mon cœur, це запитання… дуже добрий вчинок від тебе… але, як і завжди… боюся, що все пізнається в порівнянні.",shape=box,color=blue];
		j1041395041 -> j1221427949;
		j1041395041 -> j305280978;
	j1712123713 [label="Щось не так?",shape=box,color=red];
		j1712123713 -> j2497964688;
	j354472230 [label="Добре, гаразд. Якщо впевнена в цьому.",shape=box,color=red];
		j354472230 -> j1166821172;
	j3109472886 [label="О, це запитання… дуже добрий вчинок від тебе… але, як і завжди… боюся, що все пізнається в порівнянні. Але ж, упевнена, тобі це відомо, oui ?",shape=box,color=blue];
		j3109472886 -> j2328065882;
		j3109472886 -> j3058272380;
	j1945903016 [label="О, це запитання… дуже добрий вчинок від тебе… але, як і завжди… боюся, що все пізнається в порівнянні.",shape=box,color=blue];
		j1945903016 -> j1221427949;
		j1945903016 -> j305280978;
	j2328065882 [label="Мені дуже шкода, якщо питання завдало болю.",shape=box,color=red];
		j2328065882 -> j898511225;
	j3058272380 [label="Можу щось зробити, щоби поліпшити ситуацію? Або якось відвернути увагу на щось інше?",shape=box,color=red];
		j3058272380 -> j2153906504;
	j1221427949 [label="Ой, вибач… поганий болісний день? ",shape=box,color=red];
		j1221427949 -> j1410457339;
	j305280978 [label="Я можу чимось допомогти?",shape=box,color=red];
		j305280978 -> j3077335266;
	j2497964688 [label="Vraiment gentil, та це давня проблема, не варта твоїх клопотів. Упораюся.",shape=box,color=blue];
		j2497964688 -> j3359734167;
	j1166821172 [label="+10 Chemistry",color=orange];
		j1166821172 -> j2740672140;
	j898511225 [label="+10 Chemistry",color=orange];
		j898511225 -> j1369941805;
	j2153906504 [label="+10 Chemistry",color=orange];
		j2153906504 -> j2245962727;
	j1410457339 [label="Oui, на жаль. Наш розум насправді дуже дивовижна штука. Мене вражає, що вони весь час болять, постійно. Але якось свідомість навчилася ігнорувати це.",shape=box,color=blue];
		j1410457339 -> j3584319345;
		j1410457339 -> j2222111717;
		j1410457339 -> j2221255499;
	j3077335266 [label="Ти вже це робиш, переписуючись зі мною. Розум дуже дивовижний, non ? Гадаю mes pieds повинні постійно боліти, але свідомість навчилася якось це повністю ігнорувати.",shape=box,color=blue];
		j3077335266 -> j3584319345;
		j3077335266 -> j2222111717;
		j3077335266 -> j2221255499;
	j3359734167 [label="Boolean MarieChronicPain is now true.",color=orange];
		j3359734167 -> j4038143761;
		j3359734167 -> j916923281;
		j3359734167 -> j1590316266;
	j2740672140 [label="Oui, усе нормально, запевняю. Але merci за турботу.",shape=box,color=blue];
		j2740672140 -> "Chat ends.";
	j1369941805 [label="Ха ! Дивно це все, non ? Саме так. Я не думала про mes pieds, але тепер думаю, і вони болять. ",shape=box,color=blue];
		j1369941805 -> j2737329580;
	j2245962727 [label="Oui ! Ти вже це робиш, переписуючись зі мною. Розум дуже дивовижний, non ? Гадаю mes pieds повинні постійно боліти, але свідомість навчилася якось це повністю ігнорувати.",shape=box,color=blue];
		j2245962727 -> j2338185010;
		j2245962727 -> j1139022416;
		j2245962727 -> j3342738566;
	j3584319345 [label="Напевно, це дуже виснажливо…",shape=box,color=red];
		j3584319345 -> j1063010628;
	j2222111717 [label="Напевно, це дуже фруструє…",shape=box,color=red];
		j2222111717 -> j2716662205;
	j2221255499 [label="І нема ліків? Біль не вщухає?",shape=box,color=red];
		j2221255499 -> j502435286;
	j4038143761 [label="Як скажеш, але я тут, якщо захочеш обговорити.",shape=box,color=red];
		j4038143761 -> j2217398483;
	j916923281 [label="Я… я знаю як це. Перш ніж «зациклитися в петлях», мені було дуже зле в Дувірі. Рани загоєно, але іноді досі дуже сильно свербить. Я намагаюся приховувати зовнішні прояви, коли терпіти майже нестерпно.",shape=box,color=red];
		j916923281 -> j2330705113;
	j1590316266 [label="Наскільки я знаю, то старі постійні проблеми можуть бути такими проблемними, як і нові. Те, що вони повертаються і йдуть чи лишаються поруч на деякий час, не означає, що про них не варто говорити.",shape=box,color=red];
		j1590316266 -> j2218325780;
	j2737329580 [label="Наш розум насправді дуже дивовижна штука. Мене вражає, що вони весь час болять, постійно. Але якось свідомість навчилася ігнорувати це.",shape=box,color=blue];
		j2737329580 -> j2338185010;
		j2737329580 -> j1139022416;
		j2737329580 -> j3342738566;
	j2338185010 [label="Аналогічно. Щойно втрачаєш зосередженість — привіт, біль. Іноді розмірковую, чи це не тому постійно шукаю собі якісь клятські пригоди.",shape=box,color=red];
		j2338185010 -> j1201422918;
	j1139022416 [label="Іноді я дуже лютую, думаючи про те, скільки можна було б зробити, якби біль не відвертала увагу.",shape=box,color=red];
		j1139022416 -> j1378819069;
	j3342738566 [label="Ти теж відчуваєш постійну втому? Іноді я думаю, чи це не біль мене виснажує? Стільки повторів витрачено на те, щоби притлумити біль, запхати десь у підсвідомість.",shape=box,color=red];
		j3342738566 -> j905102192;
	j1063010628 [label="+10 Chemistry",color=orange];
		j1063010628 -> j1272624213;
	j2716662205 [label="Check boolean MarieSecretPower",color=orange];
		j2716662205 -> j1920650786 [label=true,color=green];
		j2716662205 -> j1341388467 [label=false,color=brown];
	j502435286 [label="Non… ніколи не йде. Я можу лише на щось відірватися. Як от на подібні розмови. Або чимось постійно бути заклопотаною.",shape=box,color=blue];
		j502435286 -> j21293175;
	j2217398483 [label="Це дуже мило з твого боку… і… що ж. Перестану бути маленькою впертою Марі.",shape=box,color=blue];
		j2217398483 -> j2923235492;
	j2330705113 [label="Boolean DrifterChronicPain is now true.",color=orange];
		j2330705113 -> j698130042;
	j2218325780 [label="Oui, твоя правда. Знову я була маленькою впертою Марі.",shape=box,color=blue];
		j2218325780 -> j2923235492;
	j1201422918 [label="+5 Chemistry",color=orange];
		j1201422918 -> j1468588815;
	j1378819069 [label="Check boolean MarieSecretPower",color=orange];
		j1378819069 -> j671557326 [label=true,color=green];
		j1378819069 -> j3510924792 [label=false,color=brown];
	j905102192 [label="+5 Chemistry",color=orange];
		j905102192 -> j1086567478;
	j1272624213 [label="Oui, так і є. Par exemple…",shape=box,color=blue];
		j1272624213 -> j1303044689;
	j1920650786 [label="Але це стало… як там тобою означене… Усі незручності, як мої, мають у собі таємну силу. Нам просто потрібно відшукати її.",shape=box,color=blue];
		j1920650786 -> j891318353;
	j1341388467 [label="Oui, так і є. Іноді я просто сиділа й витріщалася на книгу, що на верхньому ряду шафи, і думала про те, як несправедливо, що не можу дістати її.",shape=box,color=blue];
		j1341388467 -> j2414098435;
	j21293175 [label="Одного дня я вирішила повитирати пил з усіх люстр у святилищі. Монсеньйор Лойд благав припинити.",shape=box,color=blue];
		j21293175 -> j2166599335;
	j2923235492 [label="Це дещо складно пояснити. Але я спробую. Mes pieds, oui ? Ніженьки мої. Sérum змінила мене, дала можливість літати…",shape=box,color=blue];
		j2923235492 -> j147275117;
	j698130042 [label="Par les Luminaires, мені так шкода. То тоді ти розумієш як це, oui ?",shape=box,color=blue];
		j698130042 -> j115048667;
	j1468588815 [label="Oui ! О, одного дня я вирішила повитирати пил з усіх люстр у святилищі. Монсеньйор Лойд благав припинити.",shape=box,color=blue];
		j1468588815 -> j1409283164;
	j671557326 [label="Але це стало… як там тобою означене… Усі незручності, як наші, мають у собі таємну силу. Нам просто потрібно відшукати її.",shape=box,color=blue];
		j671557326 -> j1276393352;
	j3510924792 [label="Oui, розумію твою фрустрацію. Іноді я просто сиділа й витріщалася на книгу, що на верхньому ряду шафи, і думала про те, як несправедливо, що не можу дістати її.",shape=box,color=blue];
		j3510924792 -> j1183136743;
	j1086567478 [label="Oui !! Ти мене розумієш !! Par exemple…",shape=box,color=blue];
		j1086567478 -> j1366153741;
	j1303044689 [label="Знаєш як утомлюють постійні польоти, jour après jour, heure après heure, коли інші можуть просто ходити ?",shape=box,color=blue];
		j1303044689 -> j3258864130;
	j891318353 [label="Так. Фрустрація неймовірна. Іноді я просто сиділа й витріщалася на книгу, що на верхньому ряду шафи, і думала про те, як несправедливо, що не можу дістати її.",shape=box,color=blue];
		j891318353 -> j2414098435;
	j2414098435 [label="Що саме в ній містяться знання, які мені потрібні. Лише мені й нікому більше, тож чому я не можу отримати їх ? І от з’являлася добра душа, яка з жалості, діставала мені її…",shape=box,color=blue];
		j2414098435 -> j1221435018;
	j2166599335 [label="Я пояснила, що маю бути постійно зайнятою, щоб руки не знали спочину. Не думаю, що він достоту зрозумів, чому я повинна бути такою активною весь час.",shape=box,color=blue];
		j2166599335 -> j1117405419;
	j147275117 [label="Але я досі відчуваю їх. Ті потворні штуки, які погрожували поглинути мене, знищити всю надію і висмоктати joie з моєї душі.",shape=box,color=blue];
		j147275117 -> j697836587;
	j115048667 [label="Мати тіло, яке тебе зраджує. Гнітить твій дух і сповільнює його. Навіть зараз. Це так дивно. Sérum змінила мене, дала можливість літати…",shape=box,color=blue];
		j115048667 -> j2707615734;
	j1409283164 [label="Я пояснила, що маю бути постійно зайнятою, щоб руки не знали спочину. Не думаю, що він достоту зрозумів, чому я повинна бути такою активною весь час.",shape=box,color=blue];
		j1409283164 -> j3881752975;
	j1276393352 [label="Але розумію твою фрустрацію. Ще й як. Іноді я просто сиділа й витріщалася на книгу, що на верхньому ряду шафи, і думала про те, як несправедливо, що не можу дістати її.",shape=box,color=blue];
		j1276393352 -> j1183136743;
	j1183136743 [label="Що саме в ній містяться знання, які мені потрібні. Лише мені й нікому більше, тож чому я не можу отримати їх ? І от з’являлася добра душа, яка з жалості, діставала мені її…",shape=box,color=blue];
		j1183136743 -> j636992085;
		j1183136743 -> j4114286241;
	j1366153741 [label="Знаєш як утомлюють постійні польоти, jour après jour, heure après heure, коли інші можуть просто ходити ?",shape=box,color=blue];
		j1366153741 -> j2979744012;
	j3258864130 [label="Не зрозумій неправильно. Я ravie від своєї рухливості. Я можу дістати все, що забажаю. Але ж це так виснажливо !",shape=box,color=blue];
		j3258864130 -> j1117405419;
	j1221435018 [label="То не їхня провина, що вони виявляють доброту — допомога мені потрібна. І не їхня провина, що допомога потрібна. Просто… це так фруструє… ця потреба тієї допомоги.",shape=box,color=blue];
		j1221435018 -> j2944124811;
		j1221435018 -> j2284600145;
	j1117405419 [label="Знаєш… це так приємно, що є можливість поділитися з кимось. Не можу добрати слів. Рідко коли вдається обговорити невидиму мовчазну неміч, від якої я страждаю.",shape=box,color=blue];
		j1117405419 -> j1862169368;
	j697836587 [label="Завжди болять. Завжди. Навіть зараз, коли я сиджу тут і думаю про них, то відчуваю біль. Але не завжди такий, що можу помітити.",shape=box,color=blue];
		j697836587 -> j305280978;
		j697836587 -> j1221427949;
	j2707615734 [label="Але я досі відчуваю їх. Ті потворні штуки, які погрожували поглинути мене, знищити всю надію і висмоктати joie з моєї душі.",shape=box,color=blue];
		j2707615734 -> j2839299897;
	j3881752975 [label="Я така щаслива, що хтось тут розуміє, як це воно — це дуже рідкісні випадки. Ця мовчазна незрима неміч змушує нас страждати.",shape=box,color=blue];
		j3881752975 -> j1278604157;
	j636992085 [label="І що в цьому поганого?",shape=box,color=red];
		j636992085 -> j2773552422;
	j4114286241 [label="Так. Я знаю. Нема в тім їхньої провини.",shape=box,color=red];
		j4114286241 -> j2005940858;
	j2979744012 [label="Не зрозумій неправильно. Я ravie від своєї рухливості. Я можу дістати все, що забажаю. Але ж це так виснажливо !!",shape=box,color=blue];
		j2979744012 -> j3881752975;
	j2944124811 [label="Мені шкода, що тобі так тяжко. ",shape=box,color=red];
		j2944124811 -> j3517835931;
	j2284600145 [label="І навіть не можеш обговорити свою фрустрацію.",shape=box,color=red];
		j2284600145 -> j3517835931;
	j1862169368 [label="Як маленька abeille, що прилітає кожного дня, сідає на плече і жалить. Цього недостатньо, щоб убити, але дуже дратує й заважає.",shape=box,color=blue];
		j1862169368 -> j355183756;
		j1862169368 -> j97893554;
	j2839299897 [label="Завжди болять. Завжди. Навіть зараз, коли я сиджу тут і думаю про них, то відчуваю біль. Але не завжди такий, що можу помітити.",shape=box,color=blue];
		j2839299897 -> j3058272380;
		j2839299897 -> j2328065882;
	j1278604157 [label="Як маленька abeille, що прилітає до нас кожного дня, сідає на плече і жалить. Цього недостатньо, щоб убити нас, але дуже дратує й заважає.",shape=box,color=blue];
		j1278604157 -> j97893554;
		j1278604157 -> j355183756;
	j2773552422 [label="Нічого ! Нічого поганого ! Я потребувала допомоги. Але в тому й суть — я. потребувала. допомоги. І це, як ти кажеш… фруструє.",shape=box,color=blue];
		j2773552422 -> j3879689555;
	j2005940858 [label="Oui ! То не їхня провина, що вони виявляють доброту — допомога мені потрібна. І не їхня провина, що допомога потрібна. Просто… це так фруструє… ця потреба тієї допомоги.",shape=box,color=blue];
		j2005940858 -> j3879689555;
	j3517835931 [label="+10 Chemistry",color=orange];
		j3517835931 -> j1117405419;
	j355183756 [label="Що ж, дуже хотілося б, щоби він пішов…",shape=box,color=red];
		j355183756 -> j4092520455;
	j97893554 [label="Що таке «abeille»?",shape=box,color=red];
		j97893554 -> j4066300121;
	j3879689555 [label="+5 Chemistry",color=orange];
		j3879689555 -> j3881752975;
	j4092520455 [label="І я теж ! Але ж водночас, це формує нас такими, якими ми є, non ? Як ми можемо визначитися, які наші частини важливі, а які ні ?",shape=box,color=blue];
		j4092520455 -> j2427033551;
	j4066300121 [label="О ! Крихітна маленька штучка, жовто-чорна, смугаста, має голку на derrière… робить мед ?",shape=box,color=blue];
		j4066300121 -> j1703262758;
		j4066300121 -> j3485769665;
	j2427033551 [label="Evaluate expressions",color=orange];
