digraph {
	"EleanorRank1Convo3 begins." [color=orange];
		"EleanorRank1Convo3 begins." -> j2017620187;
	j2017620187 [label="Отже. Порожнеча.",shape=box,color=blue];
		j2017620187 -> j3001905767;
	j3001905767 [label="Мене, якщо чесно, це дуже цікавить. Тож…",shape=box,color=blue];
		j3001905767 -> j2084498895;
	j2084498895 [label="… чи я можу поставити кілька питань?",shape=box,color=blue];
		j2084498895 -> j2925956463;
		j2084498895 -> j3496654981;
		j2084498895 -> j2405282816;
	j2925956463 [label="Звісно.",shape=box,color=red];
		j2925956463 -> j74405355;
	j3496654981 [label="Може бути, що не матиму всіх відповідей, але… Питайся.",shape=box,color=red];
		j3496654981 -> j1035638779;
	j2405282816 [label="Ні. [Завершити розмову]",shape=box,color=red];
		j2405282816 -> j3948204605;
	j74405355 [label="Чудово. Отже…",shape=box,color=blue];
		j74405355 -> j1031925193;
	j1035638779 [label="+10 Chemistry",color=orange];
		j1035638779 -> j461590596;
	j3948204605 [label="… і таким чином ти зберігаєш ту ауру загадкової таємничості, якою я захоплююся.",shape=box,color=blue];
		j3948204605 -> "Chat ends.";
	j1031925193 [label="… як ти можеш описати кількома словами, що для тебе означає Порожнеча?",shape=box,color=blue];
		j1031925193 -> j940878597;
		j1031925193 -> j1450713820;
		j1031925193 -> j1509726734;
	j461590596 [label="Я відзначила твою чесніть та оцінила її.",shape=box,color=blue];
		j461590596 -> j74405355;
	"Chat ends." [color=orange];
	j940878597 [label="Ти мене загнала у куток. Це інтерв’ю?",shape=box,color=red];
		j940878597 -> j3930339926;
	j1450713820 [label="Що це «означає» для мене?",shape=box,color=red];
		j1450713820 -> j3542049793;
	j1509726734 [label="Ніхто насправді не впевнений, що таке Порожнеча. Це вимір, це енергетичне поле, це кротовина у просторі, чи шпарина, де сховалися орокіни…",shape=box,color=red];
		j1509726734 -> j3887991719;
	j3930339926 [label="Вибач. Старі звички.",shape=box,color=blue];
		j3930339926 -> j1957081195;
	j3542049793 [label="Так.",shape=box,color=blue];
		j3542049793 -> j2322998659;
	j3887991719 [label="Хоча це все захопливо, проте звучить досить технічно. Мене більше цікавить, що це означає для тебе. Оскільки ти, здається, живеш і дихаєш цим. Буквально.",shape=box,color=blue];
		j3887991719 -> j2535140580;
		j3887991719 -> j1647784463;
		j3887991719 -> j2579862793;
	j1957081195 [label="Пробач мені. Я більше не журналістка, а ти не стаття. Мені просто дуже цікаво.",shape=box,color=blue];
		j1957081195 -> j2535140580;
		j1957081195 -> j1647784463;
		j1957081195 -> j2579862793;
	j2322998659 [label="Твої особисті відчуття.",shape=box,color=blue];
		j2322998659 -> j2535140580;
		j2322998659 -> j1647784463;
		j2322998659 -> j2579862793;
	j2535140580 [label="З Порожнечею я можу робити неможливе. Пускати енергетичні промені, ставати ілюзією й інше подібне круте лайно. Там, звідки я, вона дає можливість ворфреймам робити те, що вони роблять.",shape=box,color=red];
		j2535140580 -> j3968892638;
	j1647784463 [label="Порожнеча зводила моїх батьків з розуму.",shape=box,color=red];
		j1647784463 -> j623875659;
	j2579862793 [label="Порожнеча завжди була моєю домівкою. Вона підлаштувалася для мене. Або мені якось удалося підлаштувати її під себе. Досі не зрозуміло що саме відбулося.",shape=box,color=red];
		j2579862793 -> j2255265768;
	j3968892638 [label="Зажди. Зажди.",shape=box,color=blue];
		j3968892638 -> j4153655851;
	j623875659 [label="Вибач. Оце я дала маху своїм питанням.",shape=box,color=blue];
		j623875659 -> j4157920420;
	j2255265768 [label="О-о. Моя увага прикута до тебе.",shape=box,color=blue];
		j2255265768 -> j3333050319;
	j4153655851 [label="Ти кажеш, що Порожнеча — такий собі диво-рушій?",shape=box,color=blue];
		j4153655851 -> j423534641;
	j4157920420 [label="Вони одужали?",shape=box,color=blue];
		j4157920420 -> j2718465893;
	j3333050319 [label="Check boolean EleanorDuviri",color=orange];
		j3333050319 -> j2462196657 [label=true,color=green];
		j3333050319 -> j2005329298 [label=false,color=brown];
	j423534641 [label="І я вже пов’язана з нею?",shape=box,color=blue];
		j423534641 -> j1224681195;
	j2718465893 [label="У них не було жодного шансу.",shape=box,color=red];
		j2718465893 -> j240686052;
	j2462196657 [label="Під домівкою ти маєш на увазі… Дувірі? Вежі та острови, летючі коні?",shape=box,color=blue];
		j2462196657 -> j398433291;
	j2005329298 [label="Як це виглядало?",shape=box,color=blue];
		j2005329298 -> j2920859982;
	j1224681195 [label="Що означає пов’язана?",shape=box,color=red];
		j1224681195 -> j1585084665;
	j240686052 [label="О, Соле. Це жахливо.",shape=box,color=blue];
		j240686052 -> j4010962327;
	j398433291 [label="Так. Дитяча казка, що ожила, в буквальному сенсі.",shape=box,color=red];
		j398433291 -> j3407660895;
	j2920859982 [label="Була така книжка, моя улюблена — «Дувірські казки». Історії про чарівне королівство, хоча насправді це було про емоції та уроки, які тебе чогось вчили.",shape=box,color=red];
		j2920859982 -> j410341794;
	j1585084665 [label="Це значить, що я ворфрейм. Чи протофрейм. Така ж, як вони.",shape=box,color=blue];
		j1585084665 -> j3383129931;
	j4010962327 [label="Ти не хочеш про це говорити зараз?",shape=box,color=blue];
		j4010962327 -> j462341406;
		j4010962327 -> j56962884;
	j3407660895 [label="І це було реально? Не було схоже на сон?",shape=box,color=blue];
		j3407660895 -> j1223669431;
	j410341794 [label="Порожнеча втілила це в життя, і мені довелося там жити. Потім це стало в’язницею. Але це вже інша історія.",shape=box,color=red];
		j410341794 -> j3334494509;
	j3383129931 [label="І тепер я можу робити всі ті речі. Контролювати когось подумки. Розплавляти обличчя.",shape=box,color=blue];
		j3383129931 -> j581134168;
	j462341406 [label="Усе добре.",shape=box,color=red];
		j462341406 -> j1848785228;
	j56962884 [label="Так, краще не треба. [Завершити розмову]",shape=box,color=red];
		j56962884 -> j436314405;
	j1223669431 [label="Ні, Елеоноро, коли тебе вбивають кожного ранку, це зовсім не схоже на сон. Я пам’ятаю кожну секунду.",shape=box,color=red];
		j1223669431 -> j1212564293;
	j3334494509 [label="Boolean EleanorDuviri is now true.",color=orange];
		j3334494509 -> j3407660895;
	j581134168 [label="Звідки береться та сила, яка йде від мене? З Порожнечі?",shape=box,color=blue];
		j581134168 -> j395571749;
	j1848785228 [label="Розлучення батьків із дітьми. Налаштування одне проти одного. Мені не здається це випадковістю.",shape=box,color=blue];
		j1848785228 -> j3320830058;
	j436314405 [label="Тоді іншим разом.",shape=box,color=blue];
		j436314405 -> j968820663;
	j1212564293 [label="Я розумію.",shape=box,color=blue];
		j1212564293 -> j3721351419;
	j395571749 [label="Зажди, повернімося трішки назад. У моєму часі є… так званий генератор. Серце Деймоса.",shape=box,color=red];
		j395571749 -> j1068776897;
	j3320830058 [label="Це виглядає як свідомий намір.",shape=box,color=blue];
		j3320830058 -> j1322452994;
	j968820663 [label="Boolean EleanorDrifterParentsAsked is now true.",color=orange];
		j968820663 -> "Chat ends.";
	j3721351419 [label="Я…",shape=box,color=blue];
		j3721351419 -> j3003173693;
	j1068776897 [label="Хвильку. Влаштуємося зручніше.",shape=box,color=blue];
		j1068776897 -> j603431859;
	j1322452994 [label="Наче спотворений науковий проєкт.",shape=box,color=blue];
		j1322452994 -> j1547592388;
	j3003173693 [label="Я намагаюся уявити, як це.",shape=box,color=blue];
		j3003173693 -> j1367608580;
	j603431859 [label="Гаразд. Продовжуємо. Не можу дочекатися почути все.",shape=box,color=blue];
		j603431859 -> j3537033679;
	j1547592388 [label="Так. У Порожнечі є ЩОСЬ. Наскільки мені відомо. Байдужість, Невтомне око, «Людина в стіні». Коли я кажу, що Порожнеча зробила це, я маю на увазі, ВІН зробив це.",shape=box,color=red];
		j1547592388 -> j577719138;
	j1367608580 [label="Слова, що втілилися в життя. Конкретна реальність, створена з нічого.",shape=box,color=blue];
		j1367608580 -> j3788953959;
	j3537033679 [label="Серце Деймоса тримає всю Материнську систему у своєрідному ореолі Порожнечі. Як випромінювання. Все, що використовує енергію Порожнечі, залежить від Серця.",shape=box,color=red];
		j3537033679 -> j4124783351;
	j577719138 [label="А хіба це не одне й те саме?",shape=box,color=blue];
		j577719138 -> j1640401917;
	j3788953959 [label="«Магія» — занадто дрібне слово для цього.",shape=box,color=blue];
		j3788953959 -> j1143838609;
	j4124783351 [label="Отже.",shape=box,color=blue];
		j4124783351 -> j2344027518;
	j1640401917 [label="Можливо, так. Але я сподіваюся, що ні.",shape=box,color=red];
		j1640401917 -> j1974941770;
	j1143838609 [label="+10 Chemistry",color=orange];
		j1143838609 -> j2970349654;
	j2344027518 [label="Якщо немає Серця Деймоса в моєму часі, то як Порожнеча дістається до мене?",shape=box,color=blue];
		j2344027518 -> j1820504952;
	j1974941770 [label="Boolean EleanorDrifterParents is now true.",color=orange];
		j1974941770 -> j2405590171;
	j2970349654 [label="Те, що ти описуєш — божественно.",shape=box,color=blue];
		j2970349654 -> j981848117;
	j1820504952 [label="Тому що я можу відчувати її. Я впевнена в цьому.",shape=box,color=blue];
		j1820504952 -> j3788953959;
	j2405590171 [label="Дивовижно.",shape=box,color=blue];
		j2405590171 -> j530187779;
	j981848117 [label="Boolean EleanorVoidLove is now true.",color=orange];
		j981848117 -> "Chat ends.";
	j530187779 [label="І чому це так?",shape=box,color=blue];
		j530187779 -> j1700337506;
	j1700337506 [label="Майбутнє, по суті, БІЖИТЬ в Порожнечу. Міжпланетні подорожі, ворфрейми, тенно… без Порожнечі все це не працює.",shape=box,color=red];
		j1700337506 -> j3968892638;
