digraph {
	143 [label="EleanorRank1Convo3 begins.",color=orange];
		143 -> 144;
	144 [label="Отже. Порожнеча.",shape=box,color=blue];
		144 -> 145;
	145 [label="Мене, якщо чесно, це дуже цікавить. Тож…",shape=box,color=blue];
		145 -> 146;
	146 [label="… чи я можу поставити кілька питань?",shape=box,color=blue];
		146 -> 147;
		146 -> 148;
		146 -> 149;
	147 [label="Звісно.",shape=box,color=red];
		147 -> 154;
	148 [label="Може бути, що не матиму всіх відповідей, але… Питайся.",shape=box,color=red];
		148 -> 153;
	149 [label="Ні. [Завершити розмову]",shape=box,color=red];
		149 -> 150;
	154 [label="Чудово. Отже…",shape=box,color=blue];
		154 -> 155;
	153 [label="+10 Chemistry",color=orange];
		153 -> 152;
	150 [label="… і таким чином ти зберігаєш ту ауру загадкової таємничості, якою я захоплююся.",shape=box,color=blue];
		150 -> 151;
	155 [label="… як ти можеш описати кількома словами, що для тебе означає Порожнеча?",shape=box,color=blue];
		155 -> 156;
		155 -> 157;
		155 -> 158;
	152 [label="Я відзначила твою чесніть та оцінила її.",shape=box,color=blue];
		152 -> 154;
	151 [label="Chat ends.",color=orange];
	156 [label="Ти мене загнала у куток. Це інтерв’ю?",shape=box,color=red];
		156 -> 159;
	157 [label="Що це «означає» для мене?",shape=box,color=red];
		157 -> 160;
	158 [label="Ніхто насправді не впевнений, що таке Порожнеча. Це вимір, це енергетичне поле, це кротовина у просторі, чи шпарина, де сховалися орокіни…",shape=box,color=red];
		158 -> 161;
	159 [label="Вибач. Старі звички.",shape=box,color=blue];
		159 -> 162;
	160 [label="Так.",shape=box,color=blue];
		160 -> 163;
	161 [label="Хоча це все захопливо, проте звучить досить технічно. Мене більше цікавить, що це означає для тебе. Оскільки ти, здається, живеш і дихаєш цим. Буквально.",shape=box,color=blue];
		161 -> 164;
		161 -> 165;
		161 -> 166;
	162 [label="Пробач мені. Я більше не журналістка, а ти не стаття. Мені просто дуже цікаво.",shape=box,color=blue];
		162 -> 164;
		162 -> 165;
		162 -> 166;
	163 [label="Твої особисті відчуття.",shape=box,color=blue];
		163 -> 164;
		163 -> 165;
		163 -> 166;
	164 [label="З Порожнечею я можу робити неможливе. Пускати енергетичні промені, ставати ілюзією й інше подібне круте лайно. Там, звідки я, вона дає можливість ворфреймам робити те, що вони роблять.",shape=box,color=red];
		164 -> 201;
	165 [label="Порожнеча зводила моїх батьків з розуму.",shape=box,color=red];
		165 -> 167;
	166 [label="Порожнеча завжди була моєю домівкою. Вона підлаштувалася для мене. Або мені якось удалося підлаштувати її під себе. Досі не зрозуміло що саме відбулося.",shape=box,color=red];
		166 -> 169;
	201 [label="Зажди. Зажди.",shape=box,color=blue];
		201 -> 202;
	167 [label="Вибач. Оце я дала маху своїм питанням.",shape=box,color=blue];
		167 -> 168;
	169 [label="О-о. Моя увага прикута до тебе.",shape=box,color=blue];
		169 -> 170;
	202 [label="Ти кажеш, що Порожнеча — такий собі диво-рушій?",shape=box,color=blue];
		202 -> 203;
	168 [label="Вони одужали?",shape=box,color=blue];
		168 -> 171;
	170 [label="Check boolean EleanorDuviri",color=orange];
		170 -> 172 [label=true,color=green];
		170 -> 174 [label=false,color=brown];
	203 [label="І я вже пов’язана з нею?",shape=box,color=blue];
		203 -> 205;
	171 [label="У них не було жодного шансу.",shape=box,color=red];
		171 -> 176;
	172 [label="Під домівкою ти маєш на увазі… Дувірі? Вежі та острови, летючі коні?",shape=box,color=blue];
		172 -> 178;
	174 [label="Як це виглядало?",shape=box,color=blue];
		174 -> 179;
	205 [label="Що означає пов’язана?",shape=box,color=red];
		205 -> 204;
	176 [label="О, Соле. Це жахливо.",shape=box,color=blue];
		176 -> 177;
	178 [label="Так. Дитяча казка, що ожила, в буквальному сенсі.",shape=box,color=red];
		178 -> 182;
	179 [label="Була така книжка, моя улюблена — «Дувірські казки». Історії про чарівне королівство, хоча насправді це було про емоції та уроки, які тебе чогось вчили.",shape=box,color=red];
		179 -> 180;
	204 [label="Це значить, що я ворфрейм. Чи протофрейм. Така ж, як вони.",shape=box,color=blue];
		204 -> 206;
	177 [label="Ти не хочеш про це говорити зараз?",shape=box,color=blue];
		177 -> 175;
		177 -> 173;
	182 [label="І це було реально? Не було схоже на сон?",shape=box,color=blue];
		182 -> 189;
	180 [label="Порожнеча втілила це в життя, і мені довелося там жити. Потім це стало в’язницею. Але це вже інша історія.",shape=box,color=red];
		180 -> 181;
	206 [label="І тепер я можу робити всі ті речі. Контролювати когось подумки. Розплавляти обличчя.",shape=box,color=blue];
		206 -> 207;
	175 [label="Усе добре.",shape=box,color=red];
		175 -> 186;
	173 [label="Так, краще не треба. [Завершити розмову]",shape=box,color=red];
		173 -> 183;
	189 [label="Ні, Елеоноро, коли тебе вбивають кожного ранку, це зовсім не схоже на сон. Я пам’ятаю кожну секунду.",shape=box,color=red];
		189 -> 190;
	181 [label="Update boolean EleanorDuviri",color=orange];
		181 -> 182;
	207 [label="Звідки береться та сила, яка йде від мене? З Порожнечі?",shape=box,color=blue];
		207 -> 208;
	186 [label="Розлучення батьків із дітьми. Налаштування одне проти одного. Мені не здається це випадковістю.",shape=box,color=blue];
		186 -> 187;
	183 [label="Тоді іншим разом.",shape=box,color=blue];
		183 -> 184;
	190 [label="Я розумію.",shape=box,color=blue];
		190 -> 192;
	208 [label="Зажди, повернімося трішки назад. У моєму часі є… так званий генератор. Серце Деймоса.",shape=box,color=red];
		208 -> 209;
	187 [label="Це виглядає як свідомий намір.",shape=box,color=blue];
		187 -> 188;
	184 [label="Update boolean EleanorDrifterParentsAsked",color=orange];
		184 -> 185;
	192 [label="Я…",shape=box,color=blue];
		192 -> 196;
	209 [label="Хвильку. Влаштуємося зручніше.",shape=box,color=blue];
		209 -> 210;
	188 [label="Наче спотворений науковий проєкт.",shape=box,color=blue];
		188 -> 191;
	185 [label="Chat ends.",color=orange];
	196 [label="Я намагаюся уявити, як це.",shape=box,color=blue];
		196 -> 197;
	210 [label="Гаразд. Продовжуємо. Не можу дочекатися почути все.",shape=box,color=blue];
		210 -> 211;
	191 [label="Так. У Порожнечі є ЩОСЬ. Наскільки мені відомо. Байдужість, Невтомне око, «Людина в стіні». Коли я кажу, що Порожнеча зробила це, я маю на увазі, ВІН зробив це.",shape=box,color=red];
		191 -> 193;
	197 [label="Слова, що втілилися в життя. Конкретна реальність, створена з нічого.",shape=box,color=blue];
		197 -> 215;
	211 [label="Серце Деймоса тримає всю Материнську систему у своєрідному ореолі Порожнечі. Як випромінювання. Все, що використовує енергію Порожнечі, залежить від Серця.",shape=box,color=red];
		211 -> 212;
	193 [label="А хіба це не одне й те саме?",shape=box,color=blue];
		193 -> 195;
	215 [label="«Магія» — занадто дрібне слово для цього.",shape=box,color=blue];
		215 -> 218;
	212 [label="Отже.",shape=box,color=blue];
		212 -> 213;
	195 [label="Можливо, так. Але я сподіваюся, що ні.",shape=box,color=red];
		195 -> 194;
	218 [label="+10 Chemistry",color=orange];
		218 -> 216;
	213 [label="Якщо немає Серця Деймоса в моєму часі, то як Порожнеча дістається до мене?",shape=box,color=blue];
		213 -> 214;
	194 [label="Update boolean EleanorDrifterParents",color=orange];
		194 -> 198;
	216 [label="Те, що ти описуєш — божественно.",shape=box,color=blue];
		216 -> 217;
	214 [label="Тому що я можу відчувати її. Я впевнена в цьому.",shape=box,color=blue];
		214 -> 215;
	198 [label="Дивовижно.",shape=box,color=blue];
		198 -> 199;
	217 [label="Update boolean EleanorVoidLove",color=orange];
		217 -> 219;
	199 [label="І чому це так?",shape=box,color=blue];
		199 -> 200;
	219 [label="Chat ends.",color=orange];
	200 [label="Майбутнє, по суті, БІЖИТЬ в Порожнечу. Міжпланетні подорожі, ворфрейми, тенно… без Порожнечі все це не працює.",shape=box,color=red];
		200 -> 201;
}