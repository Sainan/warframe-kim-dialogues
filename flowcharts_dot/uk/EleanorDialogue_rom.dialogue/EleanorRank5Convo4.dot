digraph {
	2386 [label="EleanorRank5Convo4 begins.",color=orange];
		2386 -> 2387;
	2387 [label="Check boolean EleanorDating",color=orange];
		2387 -> 2388 [label=true,color=green];
		2387 -> 2389 [label=false,color=brown];
	2388 [label="Любчику? Якщо ти там, я б хотіла потеревенити.",shape=box,color=blue];
		2388 -> 2390;
	2389 [label="Якщо ти там, мені потрібен друг.",shape=box,color=blue];
		2389 -> 2390;
	2390 [label="Check boolean EleanorArthurNightmare",color=orange];
		2390 -> 2391 [label=true,color=green];
		2390 -> 2392 [label=false,color=brown];
	2391 [label="Мені знову сняться сни про Артура. Ті, де він мене вбиває.",shape=box,color=blue];
		2391 -> 2394;
		2391 -> 2395;
	2392 [label="Мені постійно сниться жахливий сон про Артура, в якому він мене вбиває. І коли лезо проходить мені межи ребер, я кричу: «Елеонора ТУТ, тупий ти виродку!», але мене ніхто вже не чує.",shape=box,color=blue];
		2392 -> 2393;
	2394 [label="Я тут. Усе гаразд.",shape=box,color=red];
		2394 -> 2397;
	2395 [label="[Ігнорувати]",shape=box,color=red];
		2395 -> 2396;
	2393 [label="Update boolean EleanorArthurNightmare",color=orange];
		2393 -> 2394;
		2393 -> 2395;
	2397 [label="Артур не вб’є тебе, Елеоноро. Ти його сестра. Він це знає.",shape=box,color=red];
		2397 -> 2398;
	2396 [label="Chat ends.",color=orange];
	2398 [label="«У тому-то й справа. Ти вже не моя сестра». Ось що він каже уві сні. Потім проштрикує мої груди своїм іграшковим мечем.",shape=box,color=blue];
		2398 -> 2399;
	2399 [label="Ми лише маленькі діти уві сні, ніби це ще не достатньо заплутано.",shape=box,color=blue];
		2399 -> 2400;
		2399 -> 2401;
	2400 [label="Це не реально. Я не вірю, що Артур коли-небудь заподіє тобі шкоду, незважаючи на те, наскільки ти була заражена.",shape=box,color=red];
		2400 -> 2402;
	2401 [label="… Йой.",shape=box,color=red];
		2401 -> 2403;
	2402 [label="Навіть для того, щоб «позбавити мене від страждань»? Навіть якщо я страждаю?",shape=box,color=blue];
		2402 -> 2408;
	2403 [label="Ага. Це найгірша частина.",shape=box,color=blue];
		2403 -> 2404;
	2408 [label="Він син свого батька. Він прагне робити правильні речі, а не легкі.",shape=box,color=blue];
		2408 -> 2409;
		2408 -> 2410;
	2404 [label="Це так яскраво, так реально. Ніби я згадую щось, що насправді сталося.",shape=box,color=blue];
		2404 -> 2405;
		2404 -> 2406;
	2409 [label="Якою б поганою, на твою думку, не була твоя сім’я, це ніщо в порівнянні з тим, кого мені довелося зустріти.",shape=box,color=red];
		2409 -> 2411;
	2410 [label="Зажди. До чого тут твій батько?",shape=box,color=red];
		2410 -> 2412;
	2405 [label="Я маю впевненість, що Артур не став би цього робити.",shape=box,color=red];
		2405 -> 2408;
	2406 [label="Може, тобі варто поговорити про це з Артуром?",shape=box,color=red];
		2406 -> 2407;
	2411 [label="Не сумніваюся. Майбутнє досить винахідливе у своїй жорстокості.",shape=box,color=blue];
		2411 -> 2413;
	2412 [label="До всього.",shape=box,color=blue];
		2412 -> 2414;
		2412 -> 2415;
	2407 [label="Я не можу. Він син свого батька. Він прагне робити правильні речі, а не легкі.",shape=box,color=blue];
		2407 -> 2409;
		2407 -> 2410;
	2413 [label="Але мене більше турбує минуле.",shape=box,color=blue];
		2413 -> 2416;
	2414 [label="Тобі доведеться дати мені більше, ніж це, якщо хочеш мого розуміння.",shape=box,color=red];
		2414 -> 2416;
	2415 [label="Елеоноро. Будь ласка, перестань вмикати дурепу.",shape=box,color=red];
		2415 -> 2417;
	2416 [label="Це одна з багатьох речей, про які ми не говоримо.",shape=box,color=blue];
		2416 -> 2420;
	2417 [label="Я так не роблю.",shape=box,color=blue];
		2417 -> 2418;
	2420 [label="Ми не говоримо про те, що сталося в Кавоні, не говоримо про Крістофера і НІКОЛИ не говоримо про бабусю Келлі.",shape=box,color=blue];
		2420 -> 2421;
		2420 -> 2422;
	2418 [label="Я чесно намагаюся пояснити.",shape=box,color=blue];
		2418 -> 2419;
	2421 [label="Тоді, можливо, вам не варто.",shape=box,color=red];
		2421 -> 2423;
	2422 [label="Тоді, можливо, вам варто.",shape=box,color=red];
		2422 -> 2425;
	2419 [label="Мій батько став прикладом того, як ми з Артуром вирішували проблеми між собою. Точніше, як ми цього не робимо.",shape=box,color=blue];
		2419 -> 2420;
	2423 [label="Можливо, мені не варто.",shape=box,color=blue];
		2423 -> 2424;
	2425 [label="Можливо, мені варто.",shape=box,color=blue];
		2425 -> 2426;
	2424 [label="Chat ends.",color=orange];
	2426 [label="Можливо, настав час.",shape=box,color=blue];
		2426 -> 2427;
	2427 [label="Ти хочеш усю історію? Чи звести все до найнеобхіднішого?",shape=box,color=blue];
		2427 -> 2428;
		2427 -> 2429;
	2428 [label="Я нікуди не збираюся. Давай мені все з подробицями.",shape=box,color=red];
		2428 -> 2432;
	2429 [label="Можна отримати скорочену версію?",shape=box,color=red];
		2429 -> 2430;
	2432 [label="Бабуся Келлі була нашою бабусею по батькові. Калліста Пенроуз Найтінґейл.",shape=box,color=blue];
		2432 -> 2433;
	2430 [label="Бабуся Келлі була тяжко хвора. Збожеволіла. Наш батько задушив її подушкою, ніж дозволив їй продовжувати страждати. Сподіваюся, це досить коротко для тебе.",shape=box,color=blue];
		2430 -> 2431;
	2433 [label="У неї був синдром Пелгема. Певно, ви вже вилікували його у своєму часі. Хвороба руйнує мозок і замість того, щоби просто прийняти миттєву смерть когось, кого любиш… ти спостерігаєш повільне згасання й зникання особистості… Наче стара фотокартка вигорає під сонячним промінням… або наче відео, перезаписане занадто багато разів…",shape=box,color=blue];
		2433 -> 2434;
		2433 -> 2435;
	2431 [label="Chat ends.",color=orange];
	2434 [label="Як те, що сталося з Судою, через що вона вирішила стати цефалоном. Я розумію.",shape=box,color=red];
		2434 -> 2436;
	2435 [label="Насправді… ні, ми цього не вилікували…",shape=box,color=red];
		2435 -> 2436;
	2436 [label="Коли вона вперше приїхала до нас, ми з Артуром дуже зраділи. Для нас вона була милою старенькою, яка пахла фіалками та розповідала історії, де вона говорила різними голосами. Вона дарувала нам справжні гроші на наші дні народження. Ми думали, що це буде як день народження весь час.",shape=box,color=blue];
		2436 -> 2437;
	2437 [label="Потім вона почала згасати. Спочатку вона була просто забудькуватою. Потім вона почала плутати нас з іншими людьми. Вона називала мене Альбертиною, а Артура — Чарлі. Вимагала розповісти, куди втік Джиммі. Ми так і не дізналися, чи був Джиммі собакою, чи котом, чи її хлопцем.",shape=box,color=blue];
		2437 -> 2438;
	2438 [label="Потім вона почала розмовляти з людьми, яких там не було. Потім вона почала блукати будинком після настання темряви.",shape=box,color=blue];
		2438 -> 2440;
		2438 -> 2441;
	2440 [label="Це, мабуть, було страшно для вас обох.",shape=box,color=red];
		2440 -> 2439;
	2441 [label="Ох, Порожнеча.",shape=box,color=red];
		2441 -> 2439;
	2439 [label="Я пам’ятаю, як посеред ночі пішла в туалет і побачила, як вона в темряві коридору, стогнучи, шкандибає до мене, з перекошеним обличчям і волоссям, схожим на перуку божевільного клоуна. Я не могла перестати кричати.",shape=box,color=blue];
		2439 -> 2442;
	2442 [label="Коли ставало зовсім погано, вона лежала в ліжку і кричала. Вранці ми йшли до школи, і коли я повертала в наш провулок, моє серце завмирало, бо я чула її крики за десять будинків, вона все ще кричала, навіть через вісім годин.",shape=box,color=blue];
		2442 -> 2443;
	2443 [label="Наш тато говорив, що їй треба покласти подушку на обличчя. Ми думали, що він жартує, бо, звісно, він жартував, це ж його мама.",shape=box,color=blue];
		2443 -> 2444;
		2443 -> 2445;
	2444 [label="І тепер багато чого стає зрозумілим.",shape=box,color=red];
		2444 -> 2446;
	2445 [label="….Ох.",shape=box,color=red];
		2445 -> 2446;
	2446 [label="Однієї ночі вона кричала, і крики просто припинилися. Я встала і пішла до кімнати Артура. Він, звісно, не спав. Ми сиділи разом і слухали, слухали, слухали, а потім почули, як зачинилися двері її кімнати.",shape=box,color=blue];
		2446 -> 2447;
	2447 [label="Померла уві сні, сказав тато наступного дня.",shape=box,color=blue];
		2447 -> 2448;
		2447 -> 2449;
	2448 [label="І ти боїшся, що Артур може зробити те ж саме з тобою?",shape=box,color=red];
		2448 -> 2450;
	2449 [label="Артур не твій батько. Він би не зробив такого.",shape=box,color=red];
		2449 -> 2451;
	2450 [label="Якщо він щиро вважав, що це на краще?",shape=box,color=blue];
		2450 -> 2452;
	2451 [label="Ти не можеш цього знати. Якщо Артур щиро вважав, що це на краще?",shape=box,color=blue];
		2451 -> 2452;
	2452 [label="Я не знаю. Можливо. Тепер, коли я комусь розповіла, це здається набагато менш імовірним.",shape=box,color=blue];
		2452 -> 2453;
	2453 [label="+20 Chemistry",color=orange];
		2453 -> 2454;
	2454 [label="Ти — чудо. Дякую за терпіння. Мені потрібно було виговоритися.",shape=box,color=blue];
		2454 -> 2455;
	2455 [label="Update boolean EleanorDreams",color=orange];
		2455 -> 2456;
	2456 [label="Chat ends.",color=orange];
}