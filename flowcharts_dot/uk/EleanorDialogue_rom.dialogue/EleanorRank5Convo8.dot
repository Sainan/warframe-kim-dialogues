digraph {
	2659 [label="EleanorRank5Convo8 begins.",color=orange];
		2659 -> 2660;
	2660 [label="Я тут подумала. Мені треба дещо зробити.",shape=box,color=blue];
		2660 -> 2661;
	2661 [label="Мені знадобиться допомога.",shape=box,color=blue];
		2661 -> 2662;
		2661 -> 2663;
	2662 [label="Завжди тут для тебе. Що в тебе на думці?",shape=box,color=red];
		2662 -> 2665;
	2663 [label="Зараз не можу балакати, вибач. [Завершити розмову]",shape=box,color=red];
		2663 -> 2664;
	2665 [label="Check boolean EleanorChristopher2",color=orange];
		2665 -> 2667 [label=true,color=green];
		2665 -> 2666 [label=false,color=brown];
	2664 [label="Chat ends.",color=orange];
	2667 [label="Отже. Крістофер.",shape=box,color=blue];
		2667 -> 2675;
	2666 [label="Check boolean EleanorChristopher1",color=orange];
		2666 -> 2671 [label=true,color=green];
		2666 -> 2668 [label=false,color=brown];
	2675 [label="Я тримаюся за нього роками. Як і Артур. Щороку ми проводимо ритуал в його пам’ять. Але не цього року. Я не могла цього витримати.",shape=box,color=blue];
		2675 -> 2676;
	2671 [label="Щоби… зробити дуже довгу і трагічну історію дуже короткою… Крістофер загинув, підірвавшись на придорожній міні ще до нашого весілля.",shape=box,color=blue];
		2671 -> 2672;
	2668 [label="Прийшов час розповісти тобі про Крістофера.",shape=box,color=blue];
		2668 -> 2669;
	2676 [label="Я не знаю, чи існують привиди, але цілком можливо, що існують, бо я дозволила йому стати одним із них.",shape=box,color=blue];
		2676 -> 2677;
	2672 [label="Можливо, я розповім тобі всю історію колись. Можливо, не буду.",shape=box,color=blue];
		2672 -> 2673;
	2669 [label="Найкращого друга Артура. Ми були заручені. Я думала, що кохаю його.",shape=box,color=blue];
		2669 -> 2670;
	2677 [label="Не будь так сувора до себе. У вас було кохання з цим хлопцем.",shape=box,color=red];
		2677 -> 2678;
	2673 [label="Я розповідаю тобі все це зараз, тому що…",shape=box,color=blue];
		2673 -> 2674;
	2670 [label="Update boolean EleanorChristopher1",color=orange];
		2670 -> 2671;
	2678 [label="Ох, дружаньо. Я ДУМАЛА, що було. Я любила його, але навіть не знала, закохана я В нього чи ні.",shape=box,color=blue];
		2678 -> 2679;
	2674 [label="Update boolean EleanorChristopher2",color=orange];
		2674 -> 2675;
	2679 [label="Звучить жахливо, чи не так? Хоча це правда. Тоді це просто не здавалося важливим. Потім він помер, і це стало основою нашої історії.",shape=box,color=blue];
		2679 -> 2680;
	2680 [label="Все, чим я захоплювалася в ньому, просто затьмарилося тим, як він помер. Я не можу думати про нього без цього вузла, що затягується в моєму животі.",shape=box,color=blue];
		2680 -> 2681;
	2681 [label="Це не чесно. ДЛЯ НЬОГО. Він заслуговує на краще.",shape=box,color=blue];
		2681 -> 2682;
		2681 -> 2683;
	2682 [label="Я розумію. Цілком. Я вирішив пам’ятати своїх батьків так, як вони того заслуговували.",shape=box,color=red];
		2682 -> 2684;
	2683 [label="Те що сталося — це жахливо. Від цього нікуди не дітися. Але ми не можемо дозволити, щоб це було єдиним, за що ми тримаємося.",shape=box,color=red];
		2683 -> 2684;
	2684 [label="То чому ж я відчуваю себе такою винною?",shape=box,color=blue];
		2684 -> 2685;
	2685 [label="Чому мені здається, що відпустити його — це те саме, що викинути?",shape=box,color=blue];
		2685 -> 2686;
		2685 -> 2688;
	2686 [label="Тому що ти зберігала його так довго, що не знаєш, як зупинитися.",shape=box,color=red];
		2686 -> 2687;
	2688 [label="Тому що ти боїшся, що ніхто інший не зможе тебе полюбити.",shape=box,color=red];
		2688 -> 2689;
	2687 [label="Боги. Знаєш, ти маєш рацію.",shape=box,color=blue];
		2687 -> 2692;
	2689 [label="Check boolean EleanorDating",color=orange];
		2689 -> 2690 [label=true,color=green];
		2689 -> 2691 [label=false,color=brown];
	2692 [label="Ми нічого не можемо вдіяти з цим, така доля. Ми розкладаємо все по поличках. Ми робимо хоробре обличчя й насвистуємо в окопах. Це допомагає нам так само, як і нашим батькам. Але ми не знаємо, як зупинитися.",shape=box,color=blue];
		2692 -> 2693;
	2690 [label="І це все? Невже я настільки дріб’язкова?",shape=box,color=blue];
		2690 -> 2694;
	2691 [label="Сумніваюся, що навіть Крістофер полюбив би мене в моєму теперішньому стані.",shape=box,color=blue];
		2691 -> 2696;
	2693 [label="Що мені робити? Як відпустити?",shape=box,color=blue];
		2693 -> 2698;
	2694 [label="Я не відчуваю, що заслуговую на вас ОБОХ.",shape=box,color=blue];
		2694 -> 2695;
	2696 [label="… ні. Це не чесно. Я зовсім несправедлива до нього, так?",shape=box,color=blue];
		2696 -> 2697;
	2698 [label="Check boolean LettieDiasdeMuertos",color=orange];
		2698 -> 2699 [label=true,color=green];
		2698 -> 2700 [label=true,color=green];
		2698 -> 2701 [label=true,color=green];
		2698 -> 2700 [label=false,color=brown];
		2698 -> 2701 [label=false,color=brown];
	2695 [label="Я думаю… я хочу, щоб ти мав УСЮ мене. Я не можу стримувати частину себе в стані нескінченної жалоби.",shape=box,color=blue];
		2695 -> 2698;
	2697 [label="Він не хотів би стояти на заваді моєму щастю. Він був добрим.",shape=box,color=blue];
		2697 -> 2698;
	2699 [label="Я дійсно вважаю, що Летті могла б допомогти.",shape=box,color=red];
		2699 -> 2702;
	2700 [label="Ти можеш написати йому листа.",shape=box,color=red];
		2700 -> 2703;
	2701 [label="Можливо, поговори з Артуром. Йому так само болить як і тобі. Ще відтоді.",shape=box,color=red];
		2701 -> 2704;
	2702 [label="Летті?",shape=box,color=blue];
		2702 -> 2705;
	2703 [label="Частина мене вважає, що це дурна ідея. Він не прочитає. Він мертвий. Але…",shape=box,color=blue];
		2703 -> 2706;
	2704 [label="Так, це правда. Можливо, це частина проблеми. Я знаю, що він засмучений, що я не змогла провести нашу маленьку церемонію вшанування пам’яті цього року.",shape=box,color=blue];
		2704 -> 2707;
	2705 [label="Чому вона?",shape=box,color=blue];
		2705 -> 2708;
	2706 [label="… чим більше я про це думаю, тим менш безглуздою вона здається.",shape=box,color=blue];
		2706 -> 2710;
	2707 [label="Цього разу я просто… мушу попрощатися з Крістофером ПО-СВОЄМУ. Раз і назавжди.",shape=box,color=blue];
		2707 -> 2711;
	2708 [label="Вона має великий досвід. Вона знає все про вшанування пам’яті померлих.",shape=box,color=red];
		2708 -> 2709;
	2710 [label="Так. Я це зроблю. Є речі, які я повинна йому сказати. Речі, які я ніколи не говорила, коли він був живий. Може, тоді він зможе спочити.",shape=box,color=blue];
		2710 -> 2712;
	2711 [label="Для Артура він назавжди залишиться втраченим братом, загиблим солдатом. Це жалоба, яку він знає і розуміє. Але це не моє.",shape=box,color=blue];
		2711 -> 2713;
	2709 [label="Гадаю, якби ти, з повагою, звернулася до неї за допомогою, вона б тобі не відмовила.",shape=box,color=red];
		2709 -> 2720;
	2712 [label="Дякую за розмову та пораду.",shape=box,color=blue];
		2712 -> 2714;
	2713 [label="Я більше не можу робити це так, як Артур. Я думаю… якщо я просто скажу йому, він зрозуміє.",shape=box,color=blue];
		2713 -> 2718;
	2720 [label="…",shape=box,color=blue];
		2720 -> 2721;
	2714 [label="+20 Chemistry",color=orange];
		2714 -> 2715;
	2718 [label="+10 Chemistry",color=orange];
		2718 -> 2719;
	2721 [label="Так.",shape=box,color=blue];
		2721 -> 2722;
	2715 [label="Я ніколи цього не забуду.",shape=box,color=blue];
		2715 -> 2716;
	2719 [label="Дякую.",shape=box,color=blue];
		2719 -> 2717;
	2722 [label="Настав час.",shape=box,color=blue];
		2722 -> 2723;
	2716 [label="Chat ends.",color=orange];
	2717 [label="Chat ends.",color=orange];
	2723 [label="+20 Chemistry",color=orange];
		2723 -> 2724;
	2724 [label="Думаю, мені потрібно багато чого відпустити.",shape=box,color=blue];
		2724 -> 2725;
	2725 [label="Дай мені поговорити з нею. Якщо вона скаже мені відвалити, то так і буде. Але я хоча б спробую, так?",shape=box,color=blue];
		2725 -> 2726;
	2726 [label="Варто спробувати. Летті не така безсердечна, як думають люди.",shape=box,color=red];
		2726 -> 2727;
	2727 [label="Не сумніваюся. Живучи так, роблячи те, що ми робимо щодня, всі ми зводимо стіни. Але ми просто забуваємо поставити в них двері.",shape=box,color=blue];
		2727 -> 2728;
	2728 [label="Дякую, що б’єшся своєю чарівною головою об мою стіну.",shape=box,color=blue];
		2728 -> 2729;
	2729 [label="Chat ends.",color=orange];
}