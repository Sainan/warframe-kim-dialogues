digraph {
	2968 [label="EleanorRank6Convo4 begins.",color=orange];
		2968 -> 2969;
	2969 [label="У тебе коли-небудь було таке, що ти приймаєш душ, і раптом дивний маленький голосок ставить тобі питання, про яке ти навіть не думав раніше?",shape=box,color=blue];
		2969 -> 2970;
		2969 -> 2971;
		2969 -> 2972;
	2970 [label="Ні, не зовсім. [Завершити розмову]",shape=box,color=red];
		2970 -> 2973;
	2971 [label="Типу: «Що подумали люди на Землі, коли Луа раптом знову з’явилася на небі?».",shape=box,color=red];
		2971 -> 2974;
	2972 [label="Ти маєш на увазі: «Операторе! Може, тобі варто зробити опудало зі свого куброу?». ",shape=box,color=red];
		2972 -> 2975;
	2973 [label="Chat ends.",color=orange];
	2974 [label="Саме так, точно.",shape=box,color=blue];
		2974 -> 2976;
	2975 [label="Це просто Ордіс. Він так робить.",shape=box,color=red];
		2975 -> 2977;
	2976 [label="стривай",shape=box,color=blue];
		2976 -> 2978;
	2977 [label="Бережи його Бог. Ні, я маю на увазі внутрішній голос.",shape=box,color=blue];
		2977 -> 2979;
	2978 [label="Луа зникла?",shape=box,color=blue];
		2978 -> 2980;
	2979 [label="Так, ніби твій мозок зайнятий чимось іншим, поки ти займаєшся важливою справою особистої гігієни.",shape=box,color=blue];
		2979 -> 2981;
	2980 [label="Як довго? Куди вона зникла? Що сталося з припливами?",shape=box,color=blue];
		2980 -> 2982;
		2980 -> 2983;
	2981 [label="У мене таке постійно. Випадковим чином. Настільки, що останнім часом я замислююся, чи справді вони походять з моєї власної голови. ",shape=box,color=blue];
		2981 -> 2984;
	2982 [label="По черзі: не знаю, у Порожнечу, не знаю.",shape=box,color=red];
		2982 -> 2985;
	2983 [label="Лотос відправила її в Порожнечу наприкінці Давньої війни. Та завдяки маляті вона повернулася назад зовсім недавно.",shape=box,color=red];
		2983 -> 2986;
	2984 [label="Деякі з них я перетворила на картини.",shape=box,color=blue];
		2984 -> 2985;
	2985 [label="неважливо, ми можемо повернутися до цього.",shape=box,color=blue];
		2985 -> 2987;
	2986 [label="Поняття не маю про припливи та відливи.",shape=box,color=red];
		2986 -> 2988;
	2987 [label="Отже, випадкові думки в душі. Сьогодні вранці мене в душі мов громом шандарахнуло.",shape=box,color=blue];
		2987 -> 2989;
	2988 [label="Як Лотос посунула цілий МІСЯЦЬ?",shape=box,color=blue];
		2988 -> 2985;
	2989 [label="Я подумала: «А що, якби боги були справжніми?».",shape=box,color=blue];
		2989 -> 2990;
	2990 [label="На мить мені запаморочилося в голові. Довелося облитися холодною водою, щоби прийти до тями.",shape=box,color=blue];
		2990 -> 2991;
		2990 -> 2992;
		2990 -> 2993;
	2991 [label="Що в цьому дивного? Як на мене, це досить просте питання.",shape=box,color=red];
		2991 -> 2994;
	2992 [label="люди не вірять, що боги існують? Гадаю, Летті вірить.",shape=box,color=red];
		2992 -> 2995;
	2993 [label="Так, це жахлива думка.",shape=box,color=red];
		2993 -> 2996;
	2994 [label="Ось чому я обожнюю говорити з тобою про такі речі.",shape=box,color=blue];
		2994 -> 2997;
	2995 [label="Ой, та годі. Ніхто насправді не вірить, що боги існують. Не так, як в існування столу чи стільців, наприклад.",shape=box,color=blue];
		2995 -> 2998;
	2996 [label="Хіба ні? Що, якби щоразу, коли тобі здавалося, що всесвіт дає тобі знаки, це було насправді так?",shape=box,color=blue];
		2996 -> 2999;
	2997 [label="Твоє життя настільки фантастично абсурдне, що реальність богів для тебе є таким же природним розмірковуванням, як вибір начинок для піци.",shape=box,color=blue];
		2997 -> 3000;
	2998 [label="Справжні боги, як сільські криниці та вуличні туалети. Це те, що люди МАЛИ колись. ",shape=box,color=blue];
		2998 -> 3001;
	2999 [label="Уяви, що все було в руках цих дрібних, безсмертних виродків, які були головними лише тому, що так склалися обставини, а не тому, що вони цього заслуговували.",shape=box,color=blue];
		2999 -> 3002;
	3000 [label="Можливо, у тебе навіть була зустріч із богом. Якщо це те, чим є Байдужість.",shape=box,color=blue];
		3000 -> 3003;
	3001 [label="Сьогодні це просто символи, метафори чи ще якась фігня.",shape=box,color=blue];
		3001 -> 3004;
		3001 -> 3005;
	3002 [label="І найбожевільніше, що саме так люди й жили. Це була їхня реальність, кожен день їхнього життя.",shape=box,color=blue];
		3002 -> 3006;
	3003 [label="Ти щойно нагадала мені про дещо, ще на «Заримені». Мою першу зустріч із Байдужістю.",shape=box,color=red];
		3003 -> 3007;
	3004 [label="Може, люди просто стали менше боятися?",shape=box,color=red];
		3004 -> 3008;
	3005 [label="Мені здавалося, ваші боги — Сол і Луа.",shape=box,color=red];
		3005 -> 3009;
	3006 [label="Для них боги були такими ж реальними, як погода, і вони отримували стільки ж турботи, як від дощу.",shape=box,color=blue];
		3006 -> 3010;
	3007 [label="Звісно, тоді я не знав, що це таке. Але я пам’ятаю, що вона сказала. ",shape=box,color=red];
		3007 -> 3011;
	3008 [label="Гадаю, що так. ",shape=box,color=blue];
		3008 -> 3012;
	3009 [label="Ну так, вони є. Але вони також просто небесні тіла. ",shape=box,color=blue];
		3009 -> 3013;
	3010 [label="Чесно кажучи, це не так вже й відрізняється від життя під орокінами.",shape=box,color=red];
		3010 -> 3014;
	3011 [label="Я сказав, що вона може взяти моє світло, а вона посміхнулася до мене і сказала: «Дякую, маля. Я не відмовлюся».",shape=box,color=red];
		3011 -> 3015;
	3012 [label="Здається, я теж знаю чому.",shape=box,color=blue];
		3012 -> 3016;
	3013 [label="Наприклад, Британія — це країна з назвою, особливостями та іншим, але це також просто маса землі та каміння. Це може бути й те, й інше.",shape=box,color=blue];
		3013 -> 3017;
	3014 [label="Безсмертні, дріб’язкові, при владі, тому що вже її мали…",shape=box,color=red];
		3014 -> 3018;
	3015 [label="Чорт, у мене від тебе мурашки по шкірі.",shape=box,color=blue];
		3015 -> 3019;
	3016 [label="Уся справа у світлі.",shape=box,color=blue];
		3016 -> 3020;
	3017 [label="Ти можеш вийти на вулицю чудового сонячного дня, відчути вдячність, підняти очі до Сола і сказати: «Дякую!». Це нормальний людський вчинок.",shape=box,color=blue];
		3017 -> 3021;
	3018 [label="Правильно. У вас БУЛИ живі боги. Але ви вбили їх усіх.",shape=box,color=blue];
		3018 -> 3022;
	3019 [label="У всіх старих казках диявол є прихильником букви закону.",shape=box,color=blue];
		3019 -> 3023;
	3020 [label="Що таке Сол і Луа, зрештою? До того, як комусь спало на думку вважати їх богами? Вони були СВІТЛОМ.",shape=box,color=blue];
		3020 -> 3024;
		3020 -> 3025;
	3021 [label="Але ніхто сьогодні не думає, що Сол або Луа буквально зачали дитину від людської жінки або виховали дитину людського чоловіка, і саме звідси взявся король.",shape=box,color=blue];
		3021 -> 3026;
	3022 [label="(Зрозумій правильно, мені це подобається.)",shape=box,color=blue];
		3022 -> 3027;
	3023 [label="Ти думаєш, вона вважає, що повинна отримати від тебе обіцяне? Своє «світло»?",shape=box,color=blue];
		3023 -> 3028;
		3023 -> 3029;
	3024 [label="Так. Світло символізує добро, як не крути.",shape=box,color=red];
		3024 -> 3030;
	3025 [label="Єдине світло, яке мало людство протягом довгого-довгого часу.",shape=box,color=red];
		3025 -> 3030;
	3026 [label="Люди звикли вірити в такі речі. Тепер ми знаємо, що ці історії були лише легендами. Ми їх переросли.",shape=box,color=blue];
		3026 -> 3031;
		3026 -> 3032;
	3027 [label="Ти плутаєш мене з малям. Мені так і не вдалося взяти участь у великому повстанні тенно.",shape=box,color=red];
		3027 -> 3033;
	3028 [label="Вона сказала «домовилися». Тож, напевне, вона вважає, що я маю щось їй… віддати.",shape=box,color=red];
		3028 -> 3034;
	3029 [label="Малася на увазі світлосфера, яка була в мене в руках, але хтозна, що це означало.",shape=box,color=red];
		3029 -> 3034;
	3030 [label="ТАК.",shape=box,color=blue];
		3030 -> 3035;
	3031 [label="Боги й люди… зійшлися разом?",shape=box,color=red];
		3031 -> 3036;
	3032 [label="Король із богами замість батьків? А мені здавалося, що орокіни були засранцями.",shape=box,color=red];
		3032 -> 3036;
	3033 [label="У мене ніколи не було змоги стати учасником програми Марґуліс для дуже особливих дітей, отримати ворфрейм, узяти участь у Давній війні.",shape=box,color=red];
		3033 -> 3037;
	3034 [label="Зрештою, я знаю дещо про неї. Вона грає в ігри.",shape=box,color=red];
		3034 -> 3038;
	3035 [label="Але потім якийсь печерний задрот, якого, імовірно, дражнили старші печерні дівчата, ударив один камінь об інший, і — вуаля!",shape=box,color=blue];
		3035 -> 3039;
	3036 [label="О, це траплялося ДУЖЕ часто. По всьому світу.",shape=box,color=blue];
		3036 -> 3040;
	3037 [label="А тобі хотілося б?",shape=box,color=blue];
		3037 -> 3041;
		3037 -> 3042;
		3037 -> 3043;
	3038 [label="+20 Chemistry",color=orange];
		3038 -> 3044;
	3039 [label="Світло будь-коли! Незалежність від великих світил у небі!",shape=box,color=blue];
		3039 -> 3045;
	3040 [label="Уяви, ти якийсь зарозумілий священник, який вирушає за море, щоби поширити Євангеліє від Сола серед «дикунів» у новому світі, та виявляється, що вони не тільки знають про Сола, ними править справжній син Сола.",shape=box,color=blue];
		3040 -> 3046;
	3041 [label="Я справді не знаю.",shape=box,color=red];
		3041 -> 3047;
	3042 [label="Чесно кажучи, ні.",shape=box,color=red];
		3042 -> 3048;
	3043 [label="Так, хотілося.",shape=box,color=red];
		3043 -> 3049;
	3044 [label="гаразд. Що б не сталося, хто б із тобою не був, чи то я, чи то Артур… бережи себе.",shape=box,color=blue];
		3044 -> 3050;
	3045 [label="А тепер подивися на вас. Світло скрізь. Ми його знецінили.",shape=box,color=blue];
		3045 -> 3003;
	3046 [label="І ти біжиш додому, підібгавши хвоста, або одразу навертаєшся у віру.",shape=box,color=blue];
		3046 -> 3051;
		3046 -> 3052;
	3047 [label="Це чесно. Я це поважаю.",shape=box,color=blue];
		3047 -> 3057;
	3048 [label="Я рада. Якщо ти відчуваєш, що твоє життя могло бути гіршим, ніж воно є, мабуть, нам є що відсвяткувати?",shape=box,color=blue];
		3048 -> 3057;
	3049 [label="Здається, я розумію. Багато чого пройшло повз тебе, чи не так?",shape=box,color=blue];
		3049 -> 3057;
	3050 [label="Check boolean EleanorDating",color=orange];
		3050 -> 3054 [label=true,color=green];
		3050 -> 3055 [label=false,color=brown];
	3051 [label="Ти справді вважаєш, що боги існують? Чи тебе просто лякає думка про те, що вони можуть існувати?",shape=box,color=red];
		3051 -> 3056;
	3052 [label="Гаразд. Тож ти хочеш сказати: а що, як люди з минулого мали рацію весь цей час?",shape=box,color=red];
		3052 -> 3056;
	3057 [label="Check boolean EleanorDating",color=orange];
		3057 -> 3053 [label=true,color=green];
		3057 -> 3310 [label=false,color=brown];
	3054 [label="Я люблю тебе. Будь-якому богу, який намагається завадити цьому, краще молитися тому, хто в біса вищий за богів.",shape=box,color=blue];
		3054 -> 3058;
	3055 [label="Ми справжні друзі. Будь-який бог, який намагається забрати тебе в мене, зіткнеться із суворим випробуванням своєї реальності.",shape=box,color=blue];
		3055 -> 3059;
	3056 [label="Скажімо так, раніше я була набагато впевненіша в нудній матеріальній реальності речей, ніж зараз.",shape=box,color=blue];
		3056 -> 3060;
	3053 [label="+20 Chemistry",color=orange];
		3053 -> 3061;
	3310 [label="+20 Chemistry",color=orange];
		3310 -> 3062;
	3058 [label="Chat ends.",color=orange];
	3059 [label="Chat ends.",color=orange];
	3060 [label="На місці, де колись була ця впевненість, зараз дірка у формі мандрівника.",shape=box,color=blue];
		3060 -> 3063;
	3061 [label="У нас обох є шрами, любове моя. ",shape=box,color=blue];
		3061 -> 3064;
	3062 [label="У нас обох є шрами, друже.",shape=box,color=blue];
		3062 -> 3065;
	3063 [label="+20 Chemistry",color=orange];
		3063 -> 3066;
	3064 [label="Chat ends.",color=orange];
	3065 [label="Chat ends.",color=orange];
	3066 [label="Чесно? Я не сумую за цим, справді. Приємно час від часу шаленіти від можливостей.",shape=box,color=blue];
		3066 -> 3067;
