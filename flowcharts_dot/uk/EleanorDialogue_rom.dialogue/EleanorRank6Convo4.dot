digraph {
	graph [fontname="Roboto Condensed"];
	node [fontname="Roboto Condensed"];
	edge [fontname="Roboto Condensed"];

	"EleanorRank6Convo4 begins." [color=orange];
		"EleanorRank6Convo4 begins." -> j119520999;
	j119520999 [label="У тебе коли-небудь було таке, що ти приймаєш душ, і раптом дивний маленький голосок ставить тобі питання, про яке ти навіть не думав раніше?",shape=box,color=blue];
		j119520999 -> j3208420034;
		j119520999 -> j525509421;
		j119520999 -> j478368825;
	j3208420034 [label="Ні, не зовсім. [Завершити розмову]",shape=box,color=red];
		j3208420034 -> "Chat ends.";
	j525509421 [label="Типу: «Що подумали люди на Землі, коли Луа раптом знову з’явилася на небі?».",shape=box,color=red];
		j525509421 -> j3766281935;
	j478368825 [label="Ти маєш на увазі: «Операторе! Може, тобі варто зробити опудало зі свого куброу?». ",shape=box,color=red];
		j478368825 -> j1605579732;
	"Chat ends." [color=orange];
	j3766281935 [label="Саме так, точно.",shape=box,color=blue];
		j3766281935 -> j1485369943;
	j1605579732 [label="Це просто Ордіс. Він так робить.",shape=box,color=red];
		j1605579732 -> j102434855;
	j1485369943 [label="стривай",shape=box,color=blue];
		j1485369943 -> j3338984029;
	j102434855 [label="Бережи його Бог. Ні, я маю на увазі внутрішній голос.",shape=box,color=blue];
		j102434855 -> j968870176;
	j3338984029 [label="Луа зникла?",shape=box,color=blue];
		j3338984029 -> j3952550460;
	j968870176 [label="Так, ніби твій мозок зайнятий чимось іншим, поки ти займаєшся важливою справою особистої гігієни.",shape=box,color=blue];
		j968870176 -> j2509931547;
	j3952550460 [label="Як довго? Куди вона зникла? Що сталося з припливами?",shape=box,color=blue];
		j3952550460 -> j4125331958;
		j3952550460 -> j775091056;
	j2509931547 [label="У мене таке постійно. Випадковим чином. Настільки, що останнім часом я замислююся, чи справді вони походять з моєї власної голови. ",shape=box,color=blue];
		j2509931547 -> j2341200657;
	j4125331958 [label="По черзі: не знаю, у Порожнечу, не знаю.",shape=box,color=red];
		j4125331958 -> j1511235797;
	j775091056 [label="Лотос відправила її в Порожнечу наприкінці Давньої війни. Та завдяки маляті вона повернулася назад зовсім недавно.",shape=box,color=red];
		j775091056 -> j966585853;
	j2341200657 [label="Деякі з них я перетворила на картини.",shape=box,color=blue];
		j2341200657 -> j1511235797;
	j1511235797 [label="неважливо, ми можемо повернутися до цього.",shape=box,color=blue];
		j1511235797 -> j2255297054;
	j966585853 [label="Поняття не маю про припливи та відливи.",shape=box,color=red];
		j966585853 -> j4282225400;
	j2255297054 [label="Отже, випадкові думки в душі. Сьогодні вранці мене в душі мов громом шандарахнуло.",shape=box,color=blue];
		j2255297054 -> j686023734;
	j4282225400 [label="Як Лотос посунула цілий МІСЯЦЬ?",shape=box,color=blue];
		j4282225400 -> j1511235797;
	j686023734 [label="Я подумала: «А що, якби боги були справжніми?».",shape=box,color=blue];
		j686023734 -> j3651832121;
	j3651832121 [label="На мить мені запаморочилося в голові. Довелося облитися холодною водою, щоби прийти до тями.",shape=box,color=blue];
		j3651832121 -> j2026968067;
		j3651832121 -> j1604078525;
		j3651832121 -> j1366532544;
	j2026968067 [label="Що в цьому дивного? Як на мене, це досить просте питання.",shape=box,color=red];
		j2026968067 -> j2843184860;
	j1604078525 [label="люди не вірять, що боги існують? Гадаю, Летті вірить.",shape=box,color=red];
		j1604078525 -> j1832252372;
	j1366532544 [label="Так, це жахлива думка.",shape=box,color=red];
		j1366532544 -> j3045499891;
	j2843184860 [label="Ось чому я обожнюю говорити з тобою про такі речі.",shape=box,color=blue];
		j2843184860 -> j381758478;
	j1832252372 [label="Ой, та годі. Ніхто насправді не вірить, що боги існують. Не так, як в існування столу чи стільців, наприклад.",shape=box,color=blue];
		j1832252372 -> j4170192916;
	j3045499891 [label="Хіба ні? Що, якби щоразу, коли тобі здавалося, що всесвіт дає тобі знаки, це було насправді так?",shape=box,color=blue];
		j3045499891 -> j1101247536;
	j381758478 [label="Твоє життя настільки фантастично абсурдне, що реальність богів для тебе є таким же природним розмірковуванням, як вибір начинок для піци.",shape=box,color=blue];
		j381758478 -> j3671419528;
	j4170192916 [label="Справжні боги, як сільські криниці та вуличні туалети. Це те, що люди МАЛИ колись. ",shape=box,color=blue];
		j4170192916 -> j1803486222;
	j1101247536 [label="Уяви, що все було в руках цих дрібних, безсмертних виродків, які були головними лише тому, що так склалися обставини, а не тому, що вони цього заслуговували.",shape=box,color=blue];
		j1101247536 -> j1755096520;
	j3671419528 [label="Можливо, у тебе навіть була зустріч із богом. Якщо це те, чим є Байдужість.",shape=box,color=blue];
		j3671419528 -> j3676690616;
	j1803486222 [label="Сьогодні це просто символи, метафори чи ще якась фігня.",shape=box,color=blue];
		j1803486222 -> j1275278459;
		j1803486222 -> j2392104968;
	j1755096520 [label="І найбожевільніше, що саме так люди й жили. Це була їхня реальність, кожен день їхнього життя.",shape=box,color=blue];
		j1755096520 -> j4086749146;
	j3676690616 [label="Ти щойно нагадала мені про дещо, ще на «Заримені». Мою першу зустріч із Байдужістю.",shape=box,color=red];
		j3676690616 -> j829386393;
	j1275278459 [label="Може, люди просто стали менше боятися?",shape=box,color=red];
		j1275278459 -> j1178383955;
	j2392104968 [label="Мені здавалося, ваші боги — Сол і Луа.",shape=box,color=red];
		j2392104968 -> j2128557376;
	j4086749146 [label="Для них боги були такими ж реальними, як погода, і вони отримували стільки ж турботи, як від дощу.",shape=box,color=blue];
		j4086749146 -> j1534206759;
	j829386393 [label="Звісно, тоді я не знав, що це таке. Але я пам’ятаю, що вона сказала. ",shape=box,color=red];
		j829386393 -> j1631985132;
	j1178383955 [label="Гадаю, що так. ",shape=box,color=blue];
		j1178383955 -> j1856665028;
	j2128557376 [label="Ну так, вони є. Але вони також просто небесні тіла. ",shape=box,color=blue];
		j2128557376 -> j3529405329;
	j1534206759 [label="Чесно кажучи, це не так вже й відрізняється від життя під орокінами.",shape=box,color=red];
		j1534206759 -> j146089781;
	j1631985132 [label="Я сказав, що вона може взяти моє світло, а вона посміхнулася до мене і сказала: «Дякую, маля. Я не відмовлюся».",shape=box,color=red];
		j1631985132 -> j304386631;
	j1856665028 [label="Здається, я теж знаю чому.",shape=box,color=blue];
		j1856665028 -> j3044069409;
	j3529405329 [label="Наприклад, Британія — це країна з назвою, особливостями та іншим, але це також просто маса землі та каміння. Це може бути й те, й інше.",shape=box,color=blue];
		j3529405329 -> j1375792643;
	j146089781 [label="Безсмертні, дріб’язкові, при владі, тому що вже її мали…",shape=box,color=red];
		j146089781 -> j128043690;
	j304386631 [label="Чорт, у мене від тебе мурашки по шкірі.",shape=box,color=blue];
		j304386631 -> j2894048721;
	j3044069409 [label="Уся справа у світлі.",shape=box,color=blue];
		j3044069409 -> j736687279;
	j1375792643 [label="Ти можеш вийти на вулицю чудового сонячного дня, відчути вдячність, підняти очі до Сола і сказати: «Дякую!». Це нормальний людський вчинок.",shape=box,color=blue];
		j1375792643 -> j264817920;
	j128043690 [label="Правильно. У вас БУЛИ живі боги. Але ви вбили їх усіх.",shape=box,color=blue];
		j128043690 -> j257659774;
	j2894048721 [label="У всіх старих казках диявол є прихильником букви закону.",shape=box,color=blue];
		j2894048721 -> j156662931;
	j736687279 [label="Що таке Сол і Луа, зрештою? До того, як комусь спало на думку вважати їх богами? Вони були СВІТЛОМ.",shape=box,color=blue];
		j736687279 -> j1081558684;
		j736687279 -> j509462798;
	j264817920 [label="Але ніхто сьогодні не думає, що Сол або Луа буквально зачали дитину від людської жінки або виховали дитину людського чоловіка, і саме звідси взявся король.",shape=box,color=blue];
		j264817920 -> j1353411366;
	j257659774 [label="(Зрозумій правильно, мені це подобається.)",shape=box,color=blue];
		j257659774 -> j1354261310;
	j156662931 [label="Ти думаєш, вона вважає, що повинна отримати від тебе обіцяне? Своє «світло»?",shape=box,color=blue];
		j156662931 -> j2134949597;
		j156662931 -> j241638067;
	j1081558684 [label="Так. Світло символізує добро, як не крути.",shape=box,color=red];
		j1081558684 -> j1990930015;
	j509462798 [label="Єдине світло, яке мало людство протягом довгого-довгого часу.",shape=box,color=red];
		j509462798 -> j1990930015;
	j1353411366 [label="Люди звикли вірити в такі речі. Тепер ми знаємо, що ці історії були лише легендами. Ми їх переросли.",shape=box,color=blue];
		j1353411366 -> j1466896559;
		j1353411366 -> j326527478;
	j1354261310 [label="Ти плутаєш мене з малям. Мені так і не вдалося взяти участь у великому повстанні тенно.",shape=box,color=red];
		j1354261310 -> j3078427876;
	j2134949597 [label="Вона сказала «домовилися». Тож, напевне, вона вважає, що я маю щось їй… віддати.",shape=box,color=red];
		j2134949597 -> j686399398;
	j241638067 [label="Малася на увазі світлосфера, яка була в мене в руках, але хтозна, що це означало.",shape=box,color=red];
		j241638067 -> j686399398;
	j1990930015 [label="ТАК.",shape=box,color=blue];
		j1990930015 -> j4140311723;
	j1466896559 [label="Боги й люди… зійшлися разом?",shape=box,color=red];
		j1466896559 -> j4265440014;
	j326527478 [label="Король із богами замість батьків? А мені здавалося, що орокіни були засранцями.",shape=box,color=red];
		j326527478 -> j4265440014;
	j3078427876 [label="У мене ніколи не було змоги стати учасником програми Марґуліс для дуже особливих дітей, отримати ворфрейм, узяти участь у Давній війні.",shape=box,color=red];
		j3078427876 -> j2073658348;
	j686399398 [label="Зрештою, я знаю дещо про неї. Вона грає в ігри.",shape=box,color=red];
		j686399398 -> j3192181306;
	j4140311723 [label="Але потім якийсь печерний задрот, якого, імовірно, дражнили старші печерні дівчата, ударив один камінь об інший, і — вуаля!",shape=box,color=blue];
		j4140311723 -> j2852584176;
	j4265440014 [label="О, це траплялося ДУЖЕ часто. По всьому світу.",shape=box,color=blue];
		j4265440014 -> j3454015796;
	j2073658348 [label="А тобі хотілося б?",shape=box,color=blue];
		j2073658348 -> j3349108757;
		j2073658348 -> j3186085007;
		j2073658348 -> j612411072;
	j3192181306 [label="+20 Chemistry",color=orange];
		j3192181306 -> j4259747200;
	j2852584176 [label="Світло будь-коли! Незалежність від великих світил у небі!",shape=box,color=blue];
		j2852584176 -> j959448405;
	j3454015796 [label="Уяви, ти якийсь зарозумілий священник, який вирушає за море, щоби поширити Євангеліє від Сола серед «дикунів» у новому світі, та виявляється, що вони не тільки знають про Сола, ними править справжній син Сола.",shape=box,color=blue];
		j3454015796 -> j1457420960;
	j3349108757 [label="Я справді не знаю.",shape=box,color=red];
		j3349108757 -> j1557215208;
	j3186085007 [label="Чесно кажучи, ні.",shape=box,color=red];
		j3186085007 -> j458629869;
	j612411072 [label="Так, хотілося.",shape=box,color=red];
		j612411072 -> j1501964510;
	j4259747200 [label="гаразд. Що б не сталося, хто б із тобою не був, чи то я, чи то Артур… бережи себе.",shape=box,color=blue];
		j4259747200 -> j3435349021;
	j959448405 [label="А тепер подивися на вас. Світло скрізь. Ми його знецінили.",shape=box,color=blue];
		j959448405 -> j3676690616;
	j1457420960 [label="І ти біжиш додому, підібгавши хвоста, або одразу навертаєшся у віру.",shape=box,color=blue];
		j1457420960 -> j3164797766;
		j1457420960 -> j2487321156;
	j1557215208 [label="Це чесно. Я це поважаю.",shape=box,color=blue];
		j1557215208 -> j2991126293;
	j458629869 [label="Я рада. Якщо ти відчуваєш, що твоє життя могло бути гіршим, ніж воно є, мабуть, нам є що відсвяткувати?",shape=box,color=blue];
		j458629869 -> j2991126293;
	j1501964510 [label="Здається, я розумію. Багато чого пройшло повз тебе, чи не так?",shape=box,color=blue];
		j1501964510 -> j2991126293;
	j3435349021 [label="Check boolean EleanorDating",color=orange];
		j3435349021 -> j2023571681 [label=true,color=green];
		j3435349021 -> j2707594510 [label=false,color=brown];
	j3164797766 [label="Ти справді вважаєш, що боги існують? Чи тебе просто лякає думка про те, що вони можуть існувати?",shape=box,color=red];
		j3164797766 -> j2751010283;
	j2487321156 [label="Гаразд. Тож ти хочеш сказати: а що, як люди з минулого мали рацію весь цей час?",shape=box,color=red];
		j2487321156 -> j2751010283;
	j2991126293 [label="Check boolean EleanorDating",color=orange];
		j2991126293 -> j74138284 [label=true,color=green];
		j2991126293 -> j2829367453 [label=false,color=brown];
	j2023571681 [label="Я люблю тебе. Будь-якому богу, який намагається завадити цьому, краще молитися тому, хто в біса вищий за богів.",shape=box,color=blue];
		j2023571681 -> "Chat ends.";
	j2707594510 [label="Ми справжні друзі. Будь-який бог, який намагається забрати тебе в мене, зіткнеться із суворим випробуванням своєї реальності.",shape=box,color=blue];
		j2707594510 -> "Chat ends.";
	j2751010283 [label="Скажімо так, раніше я була набагато впевненіша в нудній матеріальній реальності речей, ніж зараз.",shape=box,color=blue];
		j2751010283 -> j1590011608;
	j74138284 [label="+20 Chemistry",color=orange];
		j74138284 -> j3203757013;
	j2829367453 [label="+20 Chemistry",color=orange];
		j2829367453 -> j129528032;
	j1590011608 [label="На місці, де колись була ця впевненість, зараз дірка у формі мандрівника.",shape=box,color=blue];
		j1590011608 -> j2108473650;
	j3203757013 [label="У нас обох є шрами, любове моя. ",shape=box,color=blue];
		j3203757013 -> "Chat ends.";
	j129528032 [label="У нас обох є шрами, друже.",shape=box,color=blue];
		j129528032 -> "Chat ends.";
	j2108473650 [label="+20 Chemistry",color=orange];
		j2108473650 -> j1876009243;
	j1876009243 [label="Чесно? Я не сумую за цим, справді. Приємно час від часу шаленіти від можливостей.",shape=box,color=blue];
		j1876009243 -> "Chat ends.";
}