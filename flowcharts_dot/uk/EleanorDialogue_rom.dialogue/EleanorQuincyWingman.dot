		2731 -> 2733 [label=true,color=green];
		2731 -> 2732 [label=false,color=brown];
	2733 [label="Chat ends.",color=orange];
	2732 [label="Квінсі прийшов до мене і сказав абсолютно дивну річ. Те, що ти хочеш поговорити зі мною… про свої «почуття»?",shape=box,color=blue];
		2732 -> 2734;
	2734 [label="Check boolean EleanorNoDate",color=orange];
		2734 -> 2735 [label=true,color=green];
		2734 -> 2737 [label=true,color=green];
		2734 -> 2736 [label=false,color=brown];
		2734 -> 2737 [label=false,color=brown];
	2735 [label="Я просто хочу вибачитися за ті жахливі речі, що ти почула від мене.",shape=box,color=red];
		2735 -> 2738;
	2737 [label="Гадаю, він тебе «підколов».",shape=box,color=red];
		2737 -> 2739;
	2736 [label="Я просто хочу поділитися тим, що маю до тебе почуття.",shape=box,color=red];
		2736 -> 2740;
	2738 [label="Ну… здається, це поганий вибір для мене — тримати образу, враховуючи нашу ситуацію. Якщо ти це маєш на увазі? Я тебе прощаю.",shape=box,color=blue];
		2738 -> 2741;
	2739 [label="Я… зрозуміла.",shape=box,color=blue];
		2739 -> 2749;
	2740 [label="Check boolean EleanorHasDated",color=orange];
		2740 -> 2743 [label=true,color=green];
		2740 -> 2745 [label=false,color=brown];
	2741 [label="І… якщо ми ділимося правдою? Я не можу не зізнатися, що в мене є до тебе певні почуття…",shape=box,color=blue];
		2741 -> 2742;
	2749 [label="Chat ends.",color=orange];
	2743 [label="І я би хотіла нагадати тобі, що в тебе був шанс.",shape=box,color=blue];
		2743 -> 2748;
	2745 [label="І чого було тримати це в собі до цього часу?",shape=box,color=blue];
		2745 -> 2744;
		2745 -> 2746;
	2742 [label="Якщо ти серйозно хочеш спробувати «це» між нами? Я би хотіла зробити те саме.",shape=box,color=blue];
		2742 -> 2750;
		2742 -> 2751;
	2748 [label="Але я б також збрехала, якби не визнала, що скучила за тобою, і готова пробувати ще раз, якщо ти не проти.",shape=box,color=blue];
		2748 -> 2750;
		2748 -> 2751;
	2744 [label="Гадки не маю.",shape=box,color=red];
		2744 -> 2747;
	2746 [label="Можливо, я не розумію, як це все працює.",shape=box,color=red];
		2746 -> 2747;
	2750 [label="Із задоволенням.",shape=box,color=red];
		2750 -> 2752;
	2751 [label="Е-е. Не зважай.",shape=box,color=red];
		2751 -> 2754;
	2747 [label="Схоже на те. Що ж. Якщо ти хочеш спробувати, я буду більш ніж щаслива.",shape=box,color=blue];
		2747 -> 2750;
		2747 -> 2751;
	2752 [label="+20 Chemistry",color=orange];
		2752 -> 2753;
	2754 [label="….",shape=box,color=blue];
		2754 -> 2755;
	2753 [label="І я теж.",shape=box,color=blue];
		2753 -> 2757;
	2755 [label="Update boolean EleanorNoDate",color=orange];
