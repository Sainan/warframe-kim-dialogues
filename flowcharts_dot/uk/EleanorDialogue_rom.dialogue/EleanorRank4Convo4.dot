digraph {
	1700 [label="EleanorRank4Convo4 begins.",color=orange];
		1700 -> 1701;
		1700 -> 1702;
		1700 -> 1703;
	1701 [label="Ви з Летті колись були друзями?",shape=box,color=red];
		1701 -> 1704;
	1702 [label="Це доволі згуртований загін. Хтось із вас коли-небудь зустрічався з кимось із «Прокльону»?",shape=box,color=red];
		1702 -> 1705;
	1703 [label="Як би ти поставилася до того, якби в Артура виникли романтичні стосунки з кимось?",shape=box,color=red];
		1703 -> 1706;
	1704 [label="О Боги, так. Деякий час ми були не розлий вода.",shape=box,color=blue];
		1704 -> 1707;
	1705 [label="Це трохи особисте, дружаньо, але я дозволю. Ти вже давно з нами. Ти заслуговуєш на те, щоб знати подробиці.",shape=box,color=blue];
		1705 -> 1708;
	1706 [label="Ти маєш на увазі когось за мільйон кілометрів звідси?",shape=box,color=blue];
		1706 -> 1709;
	1707 [label="Звісно, це було до Ентраті.",shape=box,color=blue];
		1707 -> 1710;
	1708 [label="Окрім побачень Артура та Аой? Ні. Принаймні, я про це не знаю… а я БИ знала.",shape=box,color=blue];
		1708 -> 1711;
	1709 [label="Можеш не відповідати.",shape=box,color=blue];
		1709 -> 1712;
	1710 [label="Тепер вона поводиться так, ніби я інша людина. Їй так зручніше. Якщо я насправді не Елеонора, то вона може ображати мене скільки завгодно, адже вона не ображає людину, яку знала раніше. Я вважаю це боягузтвом.",shape=box,color=blue];
		1710 -> 1715;
	1711 [label="І якщо ти думаєш про те, щоб зробити крок на зустріч комусь із нас…",shape=box,color=blue];
		1711 -> 1713;
	1712 [label="Якби я думала, що ця людина знає, що робить, і відчуває справжні почуття до цього хлопця, я була б у захваті. Очевидно.",shape=box,color=blue];
		1712 -> 1714;
	1715 [label="Вона все ще хоче, щоб ти оговталася від цього, чи не так?",shape=box,color=red];
		1715 -> 1723;
	1713 [label="… немає нічого кращого, ніж заслужити довіру Квінсі. Він багато бачить. Ти можеш робити нотатки.",shape=box,color=blue];
		1713 -> 1716;
	1714 [label="Але я б хотіла переконатися, що вона знає, як легко його скривдити.",shape=box,color=blue];
		1714 -> 1719;
	1723 [label="Ой, та годі. Я відрощу крила та хвіст до того, як ЦЕ станеться.",shape=box,color=blue];
		1723 -> 1724;
	1716 [label="+5 Chemistry",color=orange];
		1716 -> 1717;
	1719 [label="Що це за робоштуки, які зовні мають броню і повагу, а всередині — м’яку та вразливу органіку?",shape=box,color=blue];
		1719 -> 1718;
		1719 -> 1720;
		1719 -> 1721;
	1724 [label="Ентраті пішов геть. Якщо колись і була надія повернути колишню Елеонору, ту, яка співала в душі та посміхалася дітям на вулиці, то ця надія пішла разом з ним.",shape=box,color=blue];
		1724 -> 1728;
		1724 -> 1729;
	1717 [label="Chat ends.",color=orange];
	1718 [label="Солярійці?",shape=box,color=red];
		1718 -> 1722;
	1720 [label="Згубники?",shape=box,color=red];
		1720 -> 1722;
	1721 [label="Свідомі?",shape=box,color=red];
		1721 -> 1722;
	1728 [label="Летті потрібно подивитися в дзеркало та зрозуміти, що вона також знаходиться всього в декількох поганих днях від того, щоби втратити свою людяність.",shape=box,color=red];
		1728 -> 1730;
	1729 [label="Якщо Артур думає, що ти все ще його сестра, цього має бути достатньо і для Летті.",shape=box,color=red];
		1729 -> 1731;
	1722 [label="Не має значення. Річ у тому, що Артур схожий на них.",shape=box,color=blue];
		1722 -> 1725;
	1730 [label="Ти намагаєшся втертися до мене в довіру?",shape=box,color=blue];
		1730 -> 1732;
	1731 [label="МОЖНА ПОДУМАТИ.",shape=box,color=blue];
		1731 -> 1733;
	1725 [label="Якщо він підпустить тебе, заради Сола, ніжніше із ним.",shape=box,color=blue];
		1725 -> 1726;
	1732 [label="Тобто, так. Вона втрачає.",shape=box,color=blue];
		1732 -> 1734;
	1733 [label="Летті обожнює Артура. Він старший брат, якого в неї ніколи не було. Якби Артура не було, я б уже прокинулася з кляпом хлороформу в роті та опинилася б на дні річки.",shape=box,color=blue];
		1733 -> 1735;
	1726 [label="+5 Chemistry",color=orange];
		1726 -> 1727;
	1734 [label="Я досі не пробачила їй те, як вона сказала, що нехай це місто згорить.",shape=box,color=blue];
		1734 -> 1736;
	1735 [label="Вона думає, що він марить, чіпляється за минуле. Але вона любить цього хлопця та вона хороший солдат, тому ніколи не піде проти нього.",shape=box,color=blue];
		1735 -> 1737;
		1735 -> 1738;
	1727 [label="Chat ends.",color=orange];
	1736 [label="Навіть Аой була в шоці. Це змушує замислитися, хто ж справжні монстри, чи не так?",shape=box,color=blue];
		1736 -> 1737;
		1736 -> 1738;
	1737 [label="Чому вона тебе так ненавидить?",shape=box,color=red];
		1737 -> 1739;
	1738 [label="Невже її справді лякає лише язик? Або це читання думок?",shape=box,color=red];
		1738 -> 1739;
	1739 [label="Це складно. Причин більше, ніж одна.",shape=box,color=blue];
		1739 -> 1740;
	1740 [label="Прямо сказала мені, щоб не порпалася в її голові. Якби не погодилася, то вона кинула би «Прокльон» та ризикнула владнати все самотужки. Сказитися.",shape=box,color=blue];
		1740 -> 1741;
	1741 [label="Частково вона просто боїться, що я прочитаю її підлітковий щоденник, так би мовити. Я підглядатиму її найсором’язливіші таємниці та сміятимуся досхочу, а вона буде принижена назавжди.",shape=box,color=blue];
		1741 -> 1742;
	1742 [label="Правда в тому, що мені не дуже цікаво. Який би хворий маленький секрет вона від мене не приховувала, він у безпеці.",shape=box,color=blue];
		1742 -> 1743;
		1742 -> 1744;
	1743 [label="Чи були у вас коли-небудь… романтичніші стосунки?",shape=box,color=red];
		1743 -> 1745;
	1744 [label="Як ти думаєш, може, ти їй ПОДОБАЄШСЯ?",shape=box,color=red];
		1744 -> 1746;
	1745 [label="Думаєш, я би поцілувала та розповіла?",shape=box,color=blue];
		1745 -> 1747;
	1746 [label="Це спадало мені на думку.",shape=box,color=blue];
		1746 -> 1748;
	1747 [label="Ні. В нас не було.",shape=box,color=blue];
		1747 -> 1749;
	1748 [label="Я думаю, я була би не проти. Немає нічого поганого в поцілунках і пестощах між друзями, особливо якщо Артуру довелося виголосити незручну промову на зборах про те, що ми не повинні дозволяти своїм почуттям заважати виконувати нашу роботу.",shape=box,color=blue];
		1748 -> 1750;
	1749 [label="І це добре, бо можеш собі уявити, якими б незручними були стосунки між нами зараз?",shape=box,color=blue];
		1749 -> 1751;
	1750 [label="Це дає змогу випустити пару, це добре для морального духу, і це дешево.",shape=box,color=blue];
		1750 -> 1752;
	1751 [label="Я маю на увазі… я би не сказала ні. Це просто ніколи не приходило в голову.",shape=box,color=blue];
		1751 -> 1755;
	1752 [label="Але що б пані Ґарсіа не приховувала, люди можуть використати це для того, щоб завдати їй шкоди. Тож я становлю загрозу, бо можу побачити це в її голові.",shape=box,color=blue];
		1752 -> 1754;
	1755 [label="+10 Chemistry",color=orange];
		1755 -> 1753;
	1754 [label="Зажди, хіба Артур і Аой не були разом?",shape=box,color=red];
		1754 -> 1757;
	1753 [label="Тож, якщо вона тебе приваблює, вперед! Я буду вболівати збоку! Луа знає, що Летті не завадило би трохи щастя в її похмурому, позбавленому любові житті.",shape=box,color=blue];
		1753 -> 1756;
	1757 [label="А що? У тебе є плани на мого брата? Чи на Аой?",shape=box,color=blue];
		1757 -> 1758;
		1757 -> 1759;
		1757 -> 1760;
	1756 [label="Chat ends.",color=orange];
	1758 [label="Ну. Ем. Взагалі-то…",shape=box,color=red];
		1758 -> 1761;
	1759 [label="Ем… ні… Взагалі-то, я маю плани на *тебе*…",shape=box,color=red];
		1759 -> 1762;
	1760 [label="Ні. ХАХА. Вони не в моєму смаку, вибач. Занадто «героїчні».",shape=box,color=red];
		1760 -> 1801;
	1761 [label="Ох! Ох! СКАЖИ мені…",shape=box,color=blue];
		1761 -> 1764;
		1761 -> 1765;
	1762 [label="Цікаво.",shape=box,color=blue];
		1762 -> 1793;
	1801 [label="+20 Chemistry",color=orange];
		1801 -> 1763;
	1764 [label="Артур.",shape=box,color=red];
		1764 -> 1766;
	1765 [label="Аой.",shape=box,color=red];
		1765 -> 1767;
	1793 [label="Вибач, мабуть, це не та відповідь, яка очікувалася, чи не так?",shape=box,color=blue];
		1793 -> 1794;
	1763 [label="ХА-ХА-ХА",shape=box,color=blue];
		1763 -> 1798;
	1766 [label="Я ТАК І ЗНАЛА.",shape=box,color=blue];
		1766 -> 1768;
	1767 [label="Я нітрохи не докоряю тобі.",shape=box,color=blue];
		1767 -> 1770;
	1794 [label="Що ж.",shape=box,color=blue];
		1794 -> 1795;
	1798 [label="Суворий, зухвалий Артур? Чиста, добросердечна Аой? Ніхто з них не змушує твоє серце битися частіше?",shape=box,color=blue];
		1798 -> 1799;
	1768 [label="У мене не вистачає духу сказати тобі, в що ти себе втягуєш. Ти зможеш пройти цей шлях самостійно.",shape=box,color=blue];
		1768 -> 1769;
	1770 [label="Я знаю, що вона здається занадто чистою, щоби бути справжньою, але повір — вона солдат, як і всі ми.",shape=box,color=blue];
		1770 -> 1771;
	1795 [label="Побачимо.",shape=box,color=blue];
		1795 -> 1796;
	1799 [label="Я заінтригована.",shape=box,color=blue];
		1799 -> 1800;
	1769 [label="Щоб було зрозуміло: дражнити Артура — це МОЯ прерогатива. І якщо ти коли-небудь навмисне обійдешся з ним жорстко, я тебе вб’ю. І ще одне…",shape=box,color=blue];
		1769 -> 1772;
	1771 [label="Познайомся зі СПРАВЖНЬОЮ Аой, а не з тим образом, який склався у твоїй голові, і все буде гаразд. І ще…",shape=box,color=blue];
		1771 -> 1772;
	1796 [label="+5 Chemistry",color=orange];
		1796 -> 1797;
	1800 [label="Поговоримо про це іншим разом — сказала вона, вкриваючись рум’янцем, і пішла геть…",shape=box,color=blue];
		1800 -> 1802;
	1772 [label="Стосунки Артура та Аой стали однією з перших жертв цього конфлікту. Жоден з них не змирився з цим. Це трохи відкрита рана, тому обережніше.",shape=box,color=blue];
		1772 -> 1773;
		1772 -> 1774;
	1797 [label="Chat ends.",color=orange];
	1802 [label="Chat ends.",color=orange];
	1773 [label="Чому вони розійшлися?",shape=box,color=red];
		1773 -> 1775;
	1774 [label="Не можу уявити їх разом.",shape=box,color=red];
		1774 -> 1791;
	1775 [label="Чому ти питаєш?",shape=box,color=blue];
		1775 -> 1776;
		1775 -> 1777;
	1791 [label="+10 Chemistry",color=orange];
		1791 -> 1788;
	1776 [label="Ніколи не буває шкоди від невинних пліток.",shape=box,color=red];
		1776 -> 1778;
	1777 [label="Це було б корисно знати, щоб не сипати сіль на рану.",shape=box,color=red];
		1777 -> 1786;
	1788 [label="Що ж, не тільки ти.",shape=box,color=blue];
		1788 -> 1789;
	1778 [label="Гм-м. Я не згодна.",shape=box,color=blue];
		1778 -> 1779;
	1786 [label="+20 Chemistry",color=orange];
		1786 -> 1782;
	1789 [label="Але ти не підходиш до людей у скорботі та не кажеш: «я ж вам казала». Ти намагаєшся допомогти. Я робила все можливе, щоби втішити Артура, а Летті намагалася залатати розбите серце Аой.",shape=box,color=blue];
		1789 -> 1790;
	1779 [label="Аой моя подруга. І яким би бовдуром не був Артур, він все одно мій брат.",shape=box,color=blue];
		1779 -> 1780;
	1782 [label="Добре. Я не знаю, що би ВОНИ розповіли тобі, але з моєї точки зору, вони просто тягнулися в різні боки.",shape=box,color=blue];
		1782 -> 1783;
	1790 [label="Обережніше. Це все, що я хочу сказати.",shape=box,color=blue];
		1790 -> 1792;
	1780 [label="Я не впевнена, що можу тобі щось довірити.",shape=box,color=blue];
		1780 -> 1781;
	1783 [label="Вони обоє романтики, просто різні. Артур хоче будиночок з трояндами біля дверей. Він стверджує, що ні, але хоче.",shape=box,color=blue];
		1783 -> 1784;
	1792 [label="Chat ends.",color=orange];
	1781 [label="Chat ends.",color=orange];
	1784 [label="Господи, він навіть говорить, що колись хоче керувати шинком. Я просто бачу його з невеликою юрбою постійних відвідувачів, як вони п’ють пиво, готують недільну печеню, сповнені важко здобутої мудрості.",shape=box,color=blue];
		1784 -> 1785;
	1785 [label="Ти бачиш місце для Аой у таких мріях? Я ні. Їй потрібно розправити крила.",shape=box,color=blue];
		1785 -> 1787;
	1787 [label="Chat ends.",color=orange];
}