digraph {
	286 [label="EleanorRank2Convo1 begins.",color=orange];
		286 -> 287;
		286 -> 288;
		286 -> 289;
	287 [label="Ти настільки хвора, як думає Летті?",shape=box,color=red];
		287 -> 290;
	288 [label="Як протікає твоє особисте зараження?",shape=box,color=red];
		288 -> 292;
	289 [label="Що коїться між тобою і Летті?",shape=box,color=red];
		289 -> 294;
	290 [label="Прояснімо ситуацію. Летті не думає, що я хвора. Летті вважає мене демоном.",shape=box,color=blue];
		290 -> 291;
	292 [label="Це не приємніше, ніж більшість заражень паразитами.",shape=box,color=blue];
		292 -> 293;
	294 [label="Ти знаєш, як вона мене називає?",shape=box,color=blue];
		294 -> 295;
		294 -> 296;
	291 [label="Цікаво, як це мати таке романтичне бачення світу. Здавалося б, медик має справу з вимірювальними шкалами. Десять кубиків цього, визначають мікробів того.",shape=box,color=blue];
		291 -> 303;
		291 -> 304;
	293 [label="Я відчуваю, як техноцити плавають у моїй крові. Якщо я заплющу очі, я побачу блискітки, наче чарівний пил.",shape=box,color=blue];
		293 -> 299;
	295 [label="Чесно кажучи, ні.",shape=box,color=red];
		295 -> 298;
	296 [label="«La Bruja Metiche». Набридлива відьма.",shape=box,color=red];
		296 -> 297;
	303 [label="Дуже науково з твого боку. Здавалося, ти віриш у духовніші речі?",shape=box,color=red];
		303 -> 308;
	304 [label="Здається, ти вважаєш частину про «втрату людяності» перебільшеною.",shape=box,color=red];
		304 -> 309;
	299 [label="Це добре для мене. Ти це розумієш?",shape=box,color=blue];
		299 -> 302;
	298 [label="«La Bruja Metiche». Набридлива відьма. Гадаю, вона могла б назвати набагато гірше, враховуючи її словниковий запас і хист до креативної нецензурщини.",shape=box,color=blue];
		298 -> 300;
	297 [label="Так. Вона сидить там усміхаючись зі своїми ампулами та зіллями, пляшечками з кров’ю та шматками шкіри, в оточені армії друзяк пацюків, і має нахабство називати МЕНЕ відьмою.",shape=box,color=blue];
		297 -> 305;
		297 -> 306;
		297 -> 307;
	308 [label="Ну, так. Живучи нашим життям, як можна не вірити в духовний світ?",shape=box,color=blue];
		308 -> 313;
	309 [label="Я все ще Елеонора Найтінґейл. Це важливіше для мене, ніж просто бути «людиною».",shape=box,color=blue];
		309 -> 314;
	302 [label="Все, що воно робить, робить зі щирим бажанням полагодити мене і зробити краще. Якщо я швидка та смертоносна, і мене важко вбити, я буду хорошим носієм. Тож воно виконує свою частину симбіотичної угоди, даючи мені акулячу шкіру та вовчі ікла разом із язиком-батогом.",shape=box,color=blue];
		302 -> 303;
		302 -> 304;
	300 [label="Я чула, як вона казала Квінсі зробити досить винахідливі речі з приладдям для дитячого майданчика та частинами його анатомії, що змусило мене деякий час сміятися, візуалізуючи це.",shape=box,color=blue];
		300 -> 301;
	305 [label="Я бачу, ви не любите одна одну.",shape=box,color=red];
		305 -> 310;
	306 [label="У вас завжди були такі стосунки?",shape=box,color=red];
		306 -> 311;
	307 [label="Вона думає, що ти втратиш контроль.",shape=box,color=red];
		307 -> 312;
	313 [label="Check boolean EleanorVoidLove",color=orange];
		313 -> 327 [label=true,color=green];
		313 -> 328 [label=false,color=brown];
	314 [label="Я бачила, на що здатні люди. Ми не особливі. Насправді, судячи з того, що я бачила у твоїй голові, ми стаємо навіть гіршими з часом.",shape=box,color=blue];
		314 -> 320;
	301 [label="Вона сидить там усміхаючись зі своїми ампулами та зіллями, пляшечками з кров’ю та шматками шкіри, в оточені армії друзяк пацюків, і має нахабство називати МЕНЕ відьмою.",shape=box,color=blue];
		301 -> 305;
		301 -> 306;
		301 -> 307;
	310 [label="Зрозумій мене правильно. Я БИ посцяла на неї, якби вона горіла.",shape=box,color=blue];
		310 -> 315;
	311 [label="Гадаю, ти можеш знайти відповідь самотужки.",shape=box,color=blue];
		311 -> 318;
	312 [label="Я знаю. Іноді я сама так думаю. Мені постійно сниться кошмар, де я вириваю їй горлянку, коли вона всаджує мені кулю в серце.",shape=box,color=blue];
		312 -> 317;
	327 [label="Порожнеча є доказом того, що духовне так само реально, як і матеріальне. Все, що твої люди зробили, окрім того, що змінили назву, це розробили надійний спосіб дістатися туди й назад.",shape=box,color=blue];
		327 -> 328;
	328 [label="Послухай. Те, що я визнаю існування демонічних сил, не означає, що згодна з тим, що мене можна списати.",shape=box,color=blue];
		328 -> 335;
	320 [label="Check boolean EleanorEntrati",color=orange];
		320 -> 324 [label=true,color=green];
		320 -> 325 [label=true,color=green];
		320 -> 326 [label=true,color=green];
		320 -> 325 [label=false,color=brown];
		320 -> 326 [label=false,color=brown];
	315 [label="Але я би не поспішала.",shape=box,color=blue];
		315 -> 316;
	318 [label="Chat ends.",color=orange];
	317 [label="Але страх чогось не робить його реальним. Поки що в мене не було жодного нападу люті. ЖОДНОГО.",shape=box,color=blue];
		317 -> 319;
	335 [label="Те, що відбувається в мені, це результат того, що цілком буденні атоми та молекули вальсують разом несподіваним та дивовижним чином. Будь-яке духовне значення цього я надам сама. А не Летті.",shape=box,color=blue];
		335 -> 336;
		335 -> 337;
		335 -> 338;
	324 [label="Ти хочеш просто здатися? Ти говориш як Син.",shape=box,color=red];
		324 -> 329;
	325 [label="Якби воно керувало тобою, ти б це зрозуміла?",shape=box,color=red];
		325 -> 330;
	326 [label="Принаймні, геном людини є природним.",shape=box,color=red];
		326 -> 331;
	316 [label="Chat ends.",color=orange];
	319 [label="Амір завдав більше клятих травм, ніж я.",shape=box,color=blue];
		319 -> 321;
	336 [label="Я бачу, ви не любите одна одну.",shape=box,color=red];
		336 -> 339;
	337 [label="У вас завжди були такі стосунки?",shape=box,color=red];
		337 -> 341;
	338 [label="Вона думає, що ти втратиш контроль.",shape=box,color=red];
		338 -> 349;
	329 [label="Я ніколи такого не казала.",shape=box,color=blue];
		329 -> 332;
	330 [label="Замість того, щоб слідувати програмі маленької покрученої подвійної спіралі нуклеотидів? Тобто, це те, що люди роблять з того часу, як почали ходити прямо?",shape=box,color=blue];
		330 -> 333;
	331 [label="Такі, як Віктор Водяник — і яким саме прізвиськом назвати ОТЕ вибирати тобі — виправдовують свої відсталі погляди саме тим, що вони «природні». Біологічний фундаменталізм. Людина як дзеркало Божественного і таке інше.",shape=box,color=blue];
		331 -> 334;
	321 [label="Але Амір милий та забиває баки, чи не так? Амір не має зубів, якими можна розгризти бляшанку з пайком. Ніхто не сприймає Аміра як бомбу повільної дії.",shape=box,color=blue];
		321 -> 322;
	339 [label="Зрозумій мене правильно. Я БИ посцяла на неї, якби вона горіла.",shape=box,color=blue];
		339 -> 343;
	341 [label="Гадаю, ти можеш знайти відповідь самотужки.",shape=box,color=blue];
		341 -> 340;
	349 [label="+10 Chemistry",color=orange];
		349 -> 342;
	332 [label="Деякі вважають, що людяність священна. Люди, як Віктор. В його очах я — абсолютне богохульство. Заражена, безсоромна та жінка.",shape=box,color=blue];
		332 -> 351;
		332 -> 354;
	333 [label="«Я не виконую забаганки мікроскопічного тирана! Я людина. Я особлива! Знайти собі пару. Розмножуватися. Захищати територію. Тьху.»",shape=box,color=blue];
		333 -> 351;
		333 -> 354;
	334 [label="Але ми перестали бути природними з того моменту, як почали бити каміннями одне одного. Мова — це вірус, дружаньо. Бути людиною — це чистий аркуш, на якому можна писати, а не первісний Едем, з якого нас вигнали.",shape=box,color=blue];
		334 -> 351;
		334 -> 354;
	322 [label="Хоча. Окрім Квінсі.",shape=box,color=blue];
		322 -> 323;
	343 [label="Але я б не поспішала.",shape=box,color=blue];
		343 -> 344;
	340 [label="Chat ends.",color=orange];
	342 [label="Я знаю. Іноді я сама так думаю. Мені постійно сниться кошмар, де я вириваю їй горлянку, коли вона всаджує мені кулю в серце.",shape=box,color=blue];
		342 -> 345;
	351 [label="Техногниль могла б поглинути твій розум, і ти б цього не дізналася.",shape=box,color=red];
		351 -> 352;
	354 [label="Я знаю, як воно поглинає цілі МІСЯЦІ, Елеоноро!",shape=box,color=red];
		354 -> 355;
	323 [label="Chat ends.",color=orange];
	344 [label="Chat ends.",color=orange];
	345 [label="Але страх чогось не робить його реальним. Поки що в мене не було жодного нападу люті. ЖОДНОГО.",shape=box,color=blue];
		345 -> 346;
	352 [label="Тобто… так. Ти маєш рацію. Існують паразити, які так роблять.",shape=box,color=blue];
		352 -> 353;
	355 [label="І що, в біса, такого чудового в тому, щоб не бути поглиненим місяцем? Чому заражена версія не є покращенням?",shape=box,color=blue];
		355 -> 356;
	346 [label="Амір завдав більше клятих травм, ніж я.",shape=box,color=blue];
		346 -> 347;
	353 [label="Але якщо це не паразит? Якщо це симбіонт?",shape=box,color=blue];
		353 -> 359;
		353 -> 360;
	356 [label="О ні! Шматок байдужого космічного каменю, який міг би безцільно дрейфувати ще кілька тисячоліть, раптом став живим та цікавим! Яка катастрофа!",shape=box,color=blue];
		356 -> 357;
	347 [label="Але Амір милий та забиває баки, чи не так? Амір не має зубів, якими можна розгризти бляшанку з пайком. Ніхто не сприймає Аміра як бомбу повільної дії.",shape=box,color=blue];
		347 -> 348;
	359 [label="Ти не знаєш, про що ти говориш. Коли хтось губиться в зараженні, він ГУБИТЬСЯ назавжди. До невпізнаваності.",shape=box,color=red];
		359 -> 361;
	360 [label="Я розумію, що тобі потрібно спробувати прийняти те, ким ти стала. Ти зіткнулася з неможливим викликом.",shape=box,color=red];
		360 -> 362;
	357 [label="Це та сама маячня, з якою виступає команда Віктора. Сентиментальне чіпляння за те, чим щось колись БУЛО.",shape=box,color=blue];
		357 -> 358;
	348 [label="Хоча. Окрім Квінсі.",shape=box,color=blue];
		348 -> 350;
	361 [label="Я не знаю, чи ти намагаєшся мене спровокувати, але мені доводилося боротися за життя з цією заразою. Іноді можна розрізнити шматки, які колись були людьми. Голови та ноги просто стирчать із маси.",shape=box,color=red];
		361 -> 363;
	362 [label="Або ненавидь те, чим ти стала, або прийми це. Та щось підказує мені, що ти вже давно навчилася не ненавидіти себе.",shape=box,color=red];
		362 -> 364;
	358 [label="Наче бути первісним, це те саме, що бути досконалим.",shape=box,color=blue];
		358 -> 359;
		358 -> 360;
	350 [label="Chat ends.",color=orange];
	363 [label="Це не симбіонт. Йому БАЙДУЖЕ, що ти хочеш. Воно не для того, щоб допомогти. Це агресивний рак однієї з форм життя, який лише хоче робити все для себе.",shape=box,color=red];
		363 -> 365;
	364 [label="Але ці демони у твоїй крові НЕ твої друзі. Найкраще, що ти можеш зробити, це тримати їх на короткому повідцю, Елеоноро. Повір мені.",shape=box,color=red];
		364 -> 366;
	365 [label="Нагадай мені, з чого зроблені ваші ворфрейми?",shape=box,color=blue];
		365 -> 369;
	366 [label="Ти думаєш, я не знаю?",shape=box,color=blue];
		366 -> 367;
	369 [label="Із заражених людських істот.",shape=box,color=red];
		369 -> 370;
	367 [label="Ти хоч уявляєш, що потрібно, аби тримати лють під контролем? Знаєш, яка ціна цього зовнішнього спокою?",shape=box,color=blue];
		367 -> 368;
	370 [label="Але їхнє зараження було сформоване та контрольоване, чи не так?",shape=box,color=blue];
		370 -> 371;
	368 [label="Якщо ти бачиш, що я медитую, я не спілкуюся з великими силами космосу. Я охолоджую ядро реактора.",shape=box,color=blue];
		368 -> 372;
	371 [label="Так само як зараження в мені.",shape=box,color=blue];
		371 -> 373;
	372 [label="Є так БАГАТО чого, що я могла би зробити, але НЕ роблю. Місця, куди я могла би взяти ці… речі… які тобі навіть не спадали на думку.",shape=box,color=blue];
		372 -> 374;
	373 [label="Це означає, що хтось мав сталеві яйця та перестав думати про зараження як безмізку почвару і почав шукати, чим воно може стати.",shape=box,color=blue];
		373 -> 376;
		373 -> 377;
	374 [label="Я могла би зайти в їхні СНИ. І вони би навіть не здогадалися, що я там була.",shape=box,color=blue];
		374 -> 380;
	376 [label="О, ти щойно описала Балласа, як володаря «сталевих яєць».",shape=box,color=red];
		376 -> 385;
	377 [label="Тож… ти вважаєш, що станеш схожішою на себе, а не навпаки?",shape=box,color=red];
		377 -> 382;
	380 [label="+20 Chemistry",color=orange];
		380 -> 375;
	385 [label="+10 Chemistry",color=orange];
		385 -> 378;
	382 [label="+20 Chemistry",color=orange];
		382 -> 379;
	375 [label="Що ж. Це був цікавий, хоч і незграбний, обмін думками. Я чудово провела час. Давай якось повторимо.",shape=box,color=blue];
		375 -> 381;
	378 [label="Знаєш, ти починаєш реагувати досить емоційно. Давай продовжимо розмову іншим разом.",shape=box,color=blue];
		378 -> 384;
	379 [label="Останній раз, коли мене вдарили біохімічним молотом, після чого я провалялася на дивані пів дня, люди за моєю спиною шепотіли, що я перетворююся на монстра, то це називалося «статевим дозріванням».",shape=box,color=blue];
		379 -> 383;
	381 [label="Chat ends.",color=orange];
	384 [label="Chat ends.",color=orange];
	383 [label="Chat ends.",color=orange];
}