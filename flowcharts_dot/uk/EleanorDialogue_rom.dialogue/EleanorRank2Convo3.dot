digraph {
	460 [label="EleanorRank2Convo3 begins.",color=orange];
		460 -> 461;
	461 [label="Гаразд, ми знаємо один одного вже деякий час, і ти з майбутнього, та я гадаю, я можу довіряти твоїй чесності зі мною щодо цього, тому я маю поставити найважливіше питання.",shape=box,color=blue];
		461 -> 462;
	462 [label="Ми самі? Чи ми нарешті зв’язалися з чимось іншим?",shape=box,color=blue];
		462 -> 463;
		462 -> 464;
		462 -> 465;
	463 [label="Ти маєш на увазі інопланетне життя? Поки що ні, але, можливо, одного дня.",shape=box,color=red];
		463 -> 466;
	464 [label="На жаль, Байдужість — це найближче, до чого ми підійшли.",shape=box,color=red];
		464 -> 467;
	465 [label="Так, ми самі. Нічого, окрім людей та речей, створених людьми.",shape=box,color=red];
		465 -> 468;
	466 [label="От лайно.",shape=box,color=blue];
		466 -> 469;
	467 [label="Що ТАКЕ «Байдужість»? Я бачила проблиски у твоїй свідомості, але я не можу зрозуміти, що це. Мені хочеться втекти та заховатися десь дуже далеко за товстими стінами.",shape=box,color=blue];
		467 -> 470;
		467 -> 471;
	468 [label="Найпохмуріша з можливих відповідей.",shape=box,color=blue];
		468 -> 472;
	469 [label="Я дуже сподівалася, що там буде щось, з ким ми зможемо поговорити. Щось із дійсно стороннім поглядом на наш вид.",shape=box,color=blue];
		469 -> 473;
	470 [label="Ми досі не впевнені, що це таке. Або навіть, що воно ХОЧЕ. Ми навіть не знаємо, чи це стародавня сутність, як гадають в Багряній Вуалі, чи Альбрехт якимсь чином спричинив її появу.",shape=box,color=red];
		470 -> 474;
	471 [label="Це те, що заволоділо майоркою Русалкою.",shape=box,color=red];
		471 -> 475;
	472 [label="Не знаю, чому. Зрештою, інтелект є інтелект. Не має значенні, чи ми відкриваємо це, чи створюємо.",shape=box,color=blue];
		472 -> 540;
	473 [label="Поговорити і… таке інше, звісно.",shape=box,color=blue];
		473 -> 477;
		473 -> 476;
	474 [label="Якщо я скажу тобі це те, що заволоділо майоркою Русалкою, це допоможе?",shape=box,color=red];
		474 -> 475;
	475 [label="О-о.",shape=box,color=blue];
		475 -> 543;
	540 [label="Думаю, я просто хотіла переконатися, що Всесвіт не склав усі яйця в один кошик. Тому що, якщо люди — це все, що є, то ситуація досить погана.",shape=box,color=blue];
		540 -> 541;
	477 [label="Шукаєш монстра з мацаками, щоби подружитися?",shape=box,color=red];
		477 -> 494;
	476 [label="Зажди. Яку саме взаємодію ти мала на увазі?",shape=box,color=red];
		476 -> 479;
	543 [label="О ні.",shape=box,color=blue];
		543 -> 544;
	541 [label="Ну що ж.",shape=box,color=blue];
		541 -> 542;
	494 [label="+5 Chemistry",color=orange];
		494 -> 478;
	479 [label="Щось на кшталт спілкування, мабуть. Не обов’язково щось фізичне. Я просто хочу торкнутися розуму чогось, що не тільки не є людським, навіть не є земним.",shape=box,color=blue];
		479 -> 481;
	544 [label="От ЛАЙНО.",shape=box,color=blue];
		544 -> 545;
	542 [label="Chat ends.",color=orange];
	478 [label="Перепрошую. Я не «монстр з мацаками». Я монстр, у якого є МАЦАК. Один. Поки що.",shape=box,color=blue];
		478 -> 480;
	481 [label="Одного разу я спробувала торкнутися свідомості одного з пацюків Летті, просто щоби подивитися, що станеться.",shape=box,color=blue];
		481 -> 483;
		481 -> 484;
	545 [label="ЦЯ ШТУКА? Це те саме, що твоя «Байдужість»?",shape=box,color=blue];
		545 -> 546;
	480 [label="Якби мені хотілося лише спілкуватися з мацаками, я б заскочила до зоологічного парку принцеси Люцини та подружилася з восьминогом.",shape=box,color=blue];
		480 -> 482;
	483 [label="Бідолаха не постраждав, правда ж?",shape=box,color=red];
		483 -> 485;
	484 [label="Гаразд, я маю спитати, як це було.",shape=box,color=red];
		484 -> 485;
	546 [label="Я торкнулася її. Я торкнулася її лише краєм свого розуму та заблокувала ці спогади.",shape=box,color=blue];
		546 -> 547;
	482 [label="… і тепер я шкодую, що не зробила цього. Восьминоги дуже розумні. Ми, напевно, вже писали б разом вірші. Цікаво, де ж той восьминіг?",shape=box,color=blue];
		482 -> 486;
	485 [label="Це були жахливі три секунди для нього.",shape=box,color=blue];
		485 -> 491;
	547 [label="Я навіть не пам’ятаю, коли це сталося. Вона оголошувала одну зі своїх промов, і я подумала: «Я ніколи раніше не була в ЇЇ голові, цікаво, що там. Мабуть, лише плоть та голки», тож я простяглася до неї та…",shape=box,color=blue];
		547 -> 548;
	486 [label="Напевне хтось уже з’їв. Це зазвичай трапляється з тваринами зоопарку в містах на карантині, коли закінчуються запаси.",shape=box,color=blue];
		486 -> 487;
	491 [label="Бідолашне створіння. Розумієш, я не могла уявити, що для НЬОГО буде означати доторкнутися до МОГО розуму. Уяви собі дитину, яка заблукала в нескінченному супермаркеті та кричить за матір’ю на все горло знову і знову. Усе було величезним і незбагненним, і мало ЗВУКИ та ФОРМИ замість ЗАПАХІВ.",shape=box,color=blue];
		491 -> 492;
	548 [label="чортчортчорт",shape=box,color=blue];
		548 -> 549;
	487 [label="А те, що не з’їли, вже буде пронизане техногниллю.",shape=box,color=blue];
		487 -> 488;
	492 [label="Я розірвала зв’язок так швидко, як тільки могла. У нього трохи паморочилося в голові близько години, потім він був у порядку. Я сумніваюся, що він взагалі пам’ятає, що з ним сталося.",shape=box,color=blue];
		492 -> 497;
		492 -> 496;
	549 [label="Я поки що не можу про це говорити. Вибач.",shape=box,color=blue];
		549 -> 550;
	488 [label="… саме так було уві «сні», чи не так? Тільки це зовсім не сон. Це сталося. Або станеться. Або якась версія цього. Щось відбувається в зоопарку.",shape=box,color=blue];
		488 -> 489;
	497 [label="Які твої відчуття? Як воно бути пацюком?",shape=box,color=red];
		497 -> 500;
	496 [label="Це всього лише пацюк, облиш.",shape=box,color=red];
		496 -> 498;
	550 [label="+20 Chemistry",color=orange];
		550 -> 551;
	489 [label="Я намагатимусь запам’ятати якомога більше.",shape=box,color=blue];
		489 -> 490;
	500 [label="Не знаю, чи був у тебе колись такий стан, коли все, що хотілося, це лежати на ліжку, вдихати та видихати, просто існувати, не роблячи нічого іншого, було дуже схоже на це.",shape=box,color=blue];
		500 -> 501;
	498 [label="Я б не хотіла, аби Летті почула це від тебе. Ні, якщо тобі подобаються твої органи там, де вони є.",shape=box,color=blue];
		498 -> 499;
	551 [label="Update boolean EleanorIndifference",color=orange];
		551 -> 552;
	490 [label="Не намагайся мене зупинити.",shape=box,color=blue];
		490 -> 493;
	501 [label="Дуже просто. Прості потреби задовольняються простими способами.",shape=box,color=blue];
		501 -> 502;
	499 [label="Chat ends.",color=orange];
	552 [label="Chat ends.",color=orange];
	493 [label="Update boolean EleanorRemembers",color=orange];
		493 -> 495;
	502 [label="Дитяча невинність немає нічого спільного з пацючою свідомістю.",shape=box,color=blue];
		502 -> 503;
		502 -> 504;
	495 [label="Chat ends.",color=orange];
	503 [label="Звучить досить приємно те, як ти про це говориш.",shape=box,color=red];
		503 -> 505;
	504 [label="Ти заздриш пацюку?",shape=box,color=red];
		504 -> 506;
	505 [label="О, так і було. Я впевнена, бути пацюком має і свою негативну сторону, як-от з’їсти свого мертвого брата, щоб хижаки його не винюхали, але той швидкоплинний момент простоти був майже, як релігійне прозріння.",shape=box,color=blue];
		505 -> 507;
	506 [label="Типу того.",shape=box,color=blue];
		506 -> 509;
	507 [label="Гадаю, що бути пацюком — це те саме, що бути ченцем. Жити з недоїдків, прокладати свій скромний шлях у світі, ніколи не володіти машиною чи будинком.",shape=box,color=blue];
		507 -> 508;
	509 [label="Я просто думаю, що є щось героїчне в тому, щоб бути маленьким і простим з дуже обмеженими потребами.",shape=box,color=blue];
		509 -> 510;
	508 [label="Релігійне прозріння?",shape=box,color=red];
		508 -> 509;
	510 [label="Я довго думала про те, щоб стати черницею, віриш ти чи ні.",shape=box,color=blue];
		510 -> 511;
	511 [label="Update boolean EleanorNun1",color=orange];
		511 -> 512;
		511 -> 513;
	512 [label="Тобі доведеться розповісти мені, що воно таке, Елеоноро.",shape=box,color=red];
		512 -> 514;
	513 [label="Черницею?",shape=box,color=red];
		513 -> 515;
	514 [label="Точно. Здається, там, звідки ти родом, їх немає.",shape=box,color=blue];
		514 -> 516;
	515 [label="Точно. Можливо, там, звідки ти родом, їх немає.",shape=box,color=blue];
		515 -> 516;
	516 [label="Як бути відданим Луа. Поголена голова. Білі або чорні мантії, залежно від аспекту, дуже суворе життя. Очікується, що ти зосередишся на святих речах, відкинувши все інше. Молитва і медитація щодня. Базова дієта.",shape=box,color=blue];
		516 -> 517;
		516 -> 518;
		516 -> 519;
		516 -> 520;
	517 [label="Звучить жахливо.",shape=box,color=red];
		517 -> 521;
	518 [label="Звучить дивовижно.",shape=box,color=red];
		518 -> 522;
	519 [label="Звучить як виклик.",shape=box,color=red];
		519 -> 523;
	520 [label="Звучить… явно не для мене.",shape=box,color=red];
		520 -> 526;
	521 [label="Так і є, на перший погляд. Єдина різниця між чернецтвом та в’язницею полягає в тому, що ти робиш це за власним бажанням.",shape=box,color=blue];
		521 -> 527;
	522 [label="Для більшості молодих навернених це теж звучить дивовижно, доки вони не відчують чернецьке життя на смак. Гадаю, що кількість тих, хто передумав, складає приблизно вісімдесят відсотків.",shape=box,color=blue];
		522 -> 527;
	523 [label="Та ні. Тобто, спочатку так, тобі потрібно відучити себе від усього того, що суспільство навчило тебе потребувати. Ця стадія, мабуть, найважча.",shape=box,color=blue];
		523 -> 528;
	526 [label="+10 Chemistry",color=orange];
		526 -> 524;
	527 [label="Виявилося, що це не для мене. Мені надто подобається жити в цьому світі.",shape=box,color=blue];
		527 -> 525;
	528 [label="Але як тільки ти адаптуєшся, які виклики можуть бути? Спокуса? Ти більше НЕ побачиш жодної. Сенс у тому, що ти відокремлюєш себе від усього, що може відволікати тебе від святого.",shape=box,color=blue];
		528 -> 527;
	524 [label="Це також не для мене. Виявилося, мені надто подобається жити в цьому світі.",shape=box,color=blue];
		524 -> 525;
	525 [label="Але Соле… відчуття ніби є альтернативна версія мене, яка сидить десь на вершині гори, в оточенні квітучих хмар, перебирає пальцями намистини з місячного каменю та дивиться на мене з жалем.",shape=box,color=blue];
		525 -> 529;
	529 [label="Я знаю, це все фантазії. Так само як і банальні фантазії Артура про рицарів в обладунках.",shape=box,color=blue];
		529 -> 530;
		529 -> 531;
	530 [label="Ми всі фантазує про те, що одного дня ми отримаємо все бажане лайно разом.",shape=box,color=red];
		530 -> 532;
	531 [label="Я весь час розмовляю з альтернативною версією себе. Ми навіть вечеряли разом. Це не настільки божевільно, як тобі здається.",shape=box,color=red];
		531 -> 533;
	532 [label="Дякую тобі. Чомусь, це неймовірно втішно чути.",shape=box,color=blue];
		532 -> 534;
	533 [label="Так. Я весь час забуваю, що пережите тобою, за нормальними мірками, є чистим божевіллям.",shape=box,color=blue];
		533 -> 534;
	534 [label="Ти знаєш… Я ніколи раніше цього не робила, але я думаю, що спробую зв’язатися з нею на випадок, якщо вона існує. Так. Мабуть, я можу зв’язатися з «сестрою Елеонорою» телепатично.",shape=box,color=blue];
		534 -> 535;
	535 [label="Що найгірше може статися?",shape=box,color=blue];
		535 -> 538;
	538 [label="+10 Chemistry",color=orange];
		538 -> 536;
	536 [label="Я зможу отримати кілька слів настанови від самої себе. Уяви собі. О Луа, я зараз така схвильована.",shape=box,color=blue];
		536 -> 537;
	537 [label="Update boolean EleanorSister",color=orange];
		537 -> 539;
	539 [label="Chat ends.",color=orange];
}