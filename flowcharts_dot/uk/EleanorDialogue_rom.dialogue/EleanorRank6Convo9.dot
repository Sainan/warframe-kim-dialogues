		3271 -> 3273;
	3272 [label="Це той момент, коли я озираюся через плече й бачу чорнооку Елеонору, яка посміхається мені у відповідь?",shape=box,color=blue];
		3272 -> 3274;
	3273 [label="Не дивуйся, якщо повернуся й буду колупати тебе ще більше.",shape=box,color=blue];
