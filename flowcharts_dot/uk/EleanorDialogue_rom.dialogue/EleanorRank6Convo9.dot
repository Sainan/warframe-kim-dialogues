digraph {
	3255 [label="EleanorRank6Convo9 begins.",color=orange];
		3255 -> 3256;
	3256 [label="То що ж таке «Мара лоук», із чим її їдять, як сказала б моя мама?",shape=box,color=blue];
		3256 -> 3257;
		3256 -> 3258;
