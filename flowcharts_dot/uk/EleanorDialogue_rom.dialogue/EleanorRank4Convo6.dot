digraph {
	1906 [label="EleanorRank4Convo6 begins.",color=orange];
		1906 -> 1907;
		1906 -> 1908;
	1907 [label="Отже… чому кристали?",shape=box,color=red];
		1907 -> 1909;
	1908 [label="Отже. Ти і Квінсі. Ви коли-небудь… ну, знаєш?",shape=box,color=red];
		1908 -> 1910;
	1909 [label="О, я завжди їх любила. Коли я була малою, мій тато взяв нас до Музею інновацій у Людстоні, і ми з Артуром отримали ці набори для вирощування кристалів. В Артура вийшло якесь лайно, в буквальному сенсі схожий на маленьку кам’яну какашку. Він пішов у смітник. Мій був прекрасним синім діамантом. З того дня я відчуваю, що кристали якимось чином на моєму боці.",shape=box,color=blue];
		1909 -> 1912;
	1910 [label="Гаразд, я сьогодні в гарному настрої, тож можу відповісти на це.",shape=box,color=blue];
		1910 -> 1911;
	1912 [label="То вони просто для прикраси?",shape=box,color=red];
		1912 -> 1916;
	1911 [label="Ніколи. І навіть трохи.",shape=box,color=blue];
		1911 -> 1913;
	1916 [label="О, ні.",shape=box,color=blue];
		1916 -> 1917;
	1913 [label="Не можу позбутися думки, що Квінсі надав би перевагу позиції «партнер зверху з дзеркалом на обличчі, щоб він міг уявити, що займається сексом сам із собою».",shape=box,color=blue];
		1913 -> 1914;
	1917 [label="Я знаю, що про кристали написано багато нісенітниць. Це не моє. Я не вірю, що вони очищають мою ауру чи запалюють мої чакри.",shape=box,color=blue];
		1917 -> 1918;
	1914 [label="Ні, дякую. Мені подобається милуватися здалеку.",shape=box,color=blue];
		1914 -> 1915;
	1918 [label="Але вони мають сутність ",shape=box,color=blue];
		1918 -> 1919;
	1915 [label="Chat ends.",color=orange];
	1919 [label="Вибач. Я знаю, що звучу, як повна ідіотка. ",shape=box,color=blue];
		1919 -> 1920;
		1919 -> 1921;
		1919 -> 1922;
	1920 [label="Добре, що це сказала ти, а не я. Це просто красиві камінці.",shape=box,color=red];
		1920 -> 1923;
	1921 [label="У мене є друзі цефалони. Це буквально інтелект у формі скляних кубів. Ти думаєш, що я буду насміхатися з тебе за те, що ти вважаєш, що кристали мають сутність?",shape=box,color=red];
		1921 -> 1924;
	1922 [label="Я витрачаю надто багато часу на видобуток кристалів із ґрунту, щоб вони не мали значення на якомусь глибинному рівні. Ти була б вражена, скільки ворфреймів було частково зроблено з кристалів одного або кількох видів.",shape=box,color=red];
		1922 -> 1925;
	1923 [label="О, іноді ти кажеш БОЖЕВІЛЛЯ.",shape=box,color=blue];
		1923 -> 1926;
	1924 [label="Ну, тепер я почуваюся дурепою через те, що почувалася дурепою.",shape=box,color=blue];
		1924 -> 1929;
	1925 [label="Вражена та заінтригована!",shape=box,color=blue];
		1925 -> 1930;
	1926 [label="Я думала, що кому як не тобі до снаги підійняти погляд вище суто матеріального.",shape=box,color=blue];
		1926 -> 1927;
	1929 [label="Гадаю, у вас є кристали, про які я могла тільки мріяти.",shape=box,color=blue];
		1929 -> 1931;
		1929 -> 1932;
		1929 -> 1933;
	1930 [label="Розкажи мені, мудрий мандрівниче, про кристали свого часу.",shape=box,color=blue];
		1930 -> 1932;
	1927 [label="Забирайся звідси. Залиш мене з моїми красивими камінцями.",shape=box,color=blue];
		1927 -> 1928;
	1931 [label="Аргон. Його можна знайти тільки в Порожнечі, він розпадається коли його дістають.",shape=box,color=red];
		1931 -> 1934;
	1932 [label="Є цілий ворфрейм зроблений з кристалів. Цитрина.",shape=box,color=red];
		1932 -> 1944;
	1933 [label="У нас є пара приречених закоханих, які перетворилися на кристал.",shape=box,color=red];
		1933 -> 1941;
	1928 [label="Chat ends.",color=orange];
	1934 [label="Ти кажеш «його можна знайти тільки в Порожнечі» так, ніби люди весь час заходять в Порожнечу та виходять із неї. Я думала, що це якийсь божевільний вимір, а не морський курорт.",shape=box,color=blue];
		1934 -> 1937;
	1944 [label="+10 Chemistry",color=orange];
		1944 -> 1935;
	1941 [label="+10 Chemistry",color=orange];
		1941 -> 1936;
	1937 [label="Здається я ще не розповідав тобі про орокінської вежі. Вони схожі на опорні пункти в Порожнечі, створені на випадок, якщо свідомі спробують напасти.",shape=box,color=red];
		1937 -> 1951;
	1935 [label="Це її ім’я? Здається, я мигцем побачила її в твоїй уяві!",shape=box,color=blue];
		1935 -> 1938;
	1936 [label="Як красиво й сумно. Як це — стати пам’ятником своєму коханню?",shape=box,color=blue];
		1936 -> 1939;
	1951 [label="+20 Chemistry",color=orange];
		1951 -> 1946;
	1938 [label="Гарненька геодезистка. Напевно, ми з нею тепер родичі. Є одна втішна думка.",shape=box,color=blue];
		1938 -> 1943;
	1939 [label="Сподіваюся, ніхто не відколює від них шматочки на пам’ять. Це точно сталося б у мій час.",shape=box,color=blue];
		1939 -> 1940;
	1946 [label="А ось це вже знайоме. Під Людстоном і Манкунією є бункери підвищеного рівня безпеки. Ідея полягає в тому, якщо коли-небудь розпочнеться радіаційна війна, товстосуми та вельможі сховаються у своїх розкішних норах і будуть потягувати мімозу, поки решта з нас згорить дотла нагорі.",shape=box,color=blue];
		1946 -> 1947;
	1943 [label="Ласкаво просимо в сім’ю, я так розумію?",shape=box,color=red];
		1943 -> 1945;
	1940 [label="Люди намагаються, але ми їх захищаємо. Це найменше, що ми можемо зробити.",shape=box,color=red];
		1940 -> 1942;
	1947 [label="Та сама стара історія — зітхнула вона.",shape=box,color=blue];
		1947 -> 1948;
	1945 [label="Chat ends.",color=orange];
	1942 [label="Chat ends.",color=orange];
	1948 [label="Кумедно. Коли я росла, всі так боялися радіаційної війни. Я пам’ятаю суспільне мовлення, яке колись виходило в ефір. Похмурі поради про те, як запастися припасами, як підготувати кімнату для укриття, і про те, що вам дійсно доведеться ховати померлих родичів, навіть якщо ви цього не хочете.",shape=box,color=blue];
		1948 -> 1949;
	1949 [label="Коли я побачила вибух реактора в твоїй свідомості, це повернуло мене до всіх тих кошмарів. Я знала, що ми повинні зупинити це, чого б це не коштувало. Я би змусила інших повірити тобі.",shape=box,color=blue];
		1949 -> 1950;
	1950 [label="Але ж на планету чекає не радіаційна війна, чи не так? Це техногниль. Так чи інакше, ця петля розірветься, і коли це станеться, решта світу заразиться.",shape=box,color=blue];
		1950 -> 1952;
	1952 [label="Chat ends.",color=orange];
}