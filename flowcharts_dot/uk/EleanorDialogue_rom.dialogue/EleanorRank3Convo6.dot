digraph {
	1333 [label="EleanorRank3Convo6 begins.",color=orange];
		1333 -> 1334;
	1334 [label="Знаєш, що було найкраще в Голвенії до того, як її захопила «Скальдра»?",shape=box,color=blue];
		1334 -> 1335;
		1334 -> 1336;
		1334 -> 1337;
		1334 -> 1338;
		1334 -> 1339;
	1335 [label="Нічне життя?",shape=box,color=red];
		1335 -> 1342;
	1336 [label="Кругообіг підпільних боїв?",shape=box,color=red];
		1336 -> 1343;
	1337 [label="Шопінг?",shape=box,color=red];
		1337 -> 1344;
	1338 [label="Без поняття.",shape=box,color=red];
		1338 -> 1345;
	1339 [label="Не цікаво. [Завершити розмову]",shape=box,color=red];
		1339 -> 1340;
	1342 [label="О боги. Хірургічно красиві люди змінюють свої бездоганні обличчя неперевіреними препаратами? Ні.",shape=box,color=blue];
		1342 -> 1346;
	1343 [label="Слухай. Я не маю нічого проти того, щоби подивитися, як пара спітнілих хлопців жорстко б’ються один з одним. Але ні.",shape=box,color=blue];
		1343 -> 1346;
	1344 [label="Гарна спроба. Можна було знайти що завгодно — від комбінацій сумочки й рукавичок «Бресслін» до людського ока в кризі. Але ні.",shape=box,color=blue];
		1344 -> 1346;
	1345 [label="Звичайно, ти не маєш поняття. Ти свіжа кров.",shape=box,color=blue];
		1345 -> 1346;
	1340 [label="Бу.",shape=box,color=blue];
		1340 -> 1341;
	1346 [label="Лазні!",shape=box,color=blue];
		1346 -> 1347;
	1341 [label="Chat ends.",color=orange];
	1347 [label="Я не знаю, чи є у вас щось подібне. Це такі храми, як ви їх називаєте, зазвичай з набором кімнат Сол і Луа. Ти можеш відмокати в загальному чи приватному басейні. Усе пахне травами та парою, і це САМЕ ТЕ, щоби прочистити голову.",shape=box,color=blue];
		1347 -> 1348;
	1348 [label="У Голвенії завжди існувала надзвичайно важлива традиція ритуальної чистоти. Гадаю, що це пов’язано з гарячими джерелами, на яких було побудоване місто.",shape=box,color=blue];
		1348 -> 1349;
	1349 [label="Усе це лайно про «чистоту», з яким виходить Віктор? Він співає стару пісню. Всі громадяни знають, звідки він.",shape=box,color=blue];
		1349 -> 1350;
	1350 [label="Раніше мені подобалося платити додаткові голари, щоб м’язистий професіонал розім’яв мене скрізь. Тобі б це сподобалося. Ані крихти сумнівів.",shape=box,color=blue];
		1350 -> 1351;
		1350 -> 1352;
		1350 -> 1353;
	1351 [label="Маю сумніви.",shape=box,color=red];
		1351 -> 1354;
	1352 [label="Звучить, як розвага для мене.",shape=box,color=red];
		1352 -> 1357;
	1353 [label="Що з ними сталося?",shape=box,color=red];
		1353 -> 1359;
	1354 [label="Ти розгулюєш у костюмі, зробленому з зараженого людського тіла, але категорично проти масажу?",shape=box,color=blue];
		1354 -> 1355;
	1357 [label="Я знала, що ми з тобою споріднені душі.",shape=box,color=blue];
		1357 -> 1358;
	1359 [label="Я впевнена, ти можеш здогадатися. Техногниль так багато зруйнувала. Лазні не могли залишатися відкритими після спалахів епідемії.",shape=box,color=blue];
		1359 -> 1360;
	1355 [label="Дивно.",shape=box,color=blue];
		1355 -> 1356;
	1358 [label="Хотілося б, щоб дехто з інших був трохи менш напруженим. На жаль, лазні не могли залишатися відкритими після спалахів епідемії.",shape=box,color=blue];
		1358 -> 1360;
	1360 [label="З того, що я бачила, деякі з них зараз по суті є нерестовищами. Чесно кажучи, це розбиває мені серце. Я пам’ятаю, як знайшла тисячолітню мармурову та мозаїчну підлогу, вкриту килимом повзучої плоті.",shape=box,color=blue];
		1360 -> 1361;
	1356 [label="Chat ends.",color=orange];
	1361 [label="Чи було у вас щось подібне свого часу?",shape=box,color=blue];
		1361 -> 1362;
	1362 [label="Священні громадські лазні? Ні, не думаю.",shape=box,color=red];
		1362 -> 1363;
	1363 [label="Отже, що люди роблять, щоб розслабитись?",shape=box,color=blue];
		1363 -> 1364;
		1363 -> 1365;
		1363 -> 1366;
	1364 [label="Це Ратум.",shape=box,color=red];
		1364 -> 1367;
	1365 [label="Деякі люди роблять ставки в Індексі.",shape=box,color=red];
		1365 -> 1368;
	1366 [label="Ну, у нас є комі.",shape=box,color=red];
		1366 -> 1369;
	1367 [label="Звучить так, наче Амір видає звукові ефекти про себе…",shape=box,color=blue];
		1367 -> 1370;
	1368 [label="Біржові брокери?",shape=box,color=blue];
		1368 -> 1371;
	1369 [label="Комі? Чорно-білі фішки? Весілля-війна Сола та Луа?",shape=box,color=blue];
		1369 -> 1372;
	1370 [label="Це ґрінерська штука. Це ритуальний бій на арені, що транслюється на всю Систему.",shape=box,color=red];
		1370 -> 1373;
	1371 [label="…ніби? Це як поєднання біржової торгівлі та насильства з чотирьох сторін. Я знаю, це звучить дивно.",shape=box,color=red];
		1371 -> 1374;
	1372 [label="Ем… так? Зажди, це те, в чому сенс комі?",shape=box,color=red];
		1372 -> 1375;
	1373 [label="Для них це величезна справа. До біса серйозно.",shape=box,color=red];
		1373 -> 1376;
	1374 [label="Корпус скаженіє від цього.",shape=box,color=red];
		1374 -> 1377;
	1375 [label="Ми знаємо її лише як настільну гру!",shape=box,color=red];
		1375 -> 1378;
	1376 [label="Батько з Артуром дивилися реслінг разом щосуботи ввечері.",shape=box,color=blue];
		1376 -> 1380;
	1377 [label="Але ж вони ваші вороги, чи не так? Чи існує якесь перемир’я, коли йдеться про командні види спорту?",shape=box,color=blue];
		1377 -> 1383;
	1378 [label="Орокіни любили її. Навіть в Дувірі.",shape=box,color=red];
		1378 -> 1379;
	1380 [label="+10 Chemistry",color=orange];
		1380 -> 2815;
	1383 [label="+10 Chemistry",color=orange];
		1383 -> 2079;
	1379 [label="Не було й гадки, що вона НАСТІЛЬКИ стара.",shape=box,color=red];
		1379 -> 1384;
	2815 [label="Підсунь йому кілька касет із Ратумом, як буде можливість. Я думаю, йому сподобається.",shape=box,color=blue];
		2815 -> 1381;
	2079 [label="Що я мелю? Звичайно існує. Такі вже люди.",shape=box,color=blue];
		2079 -> 1382;
	1384 [label="Стара? Це СВЯТИНЯ! Але також забава. Чудове поєднання.",shape=box,color=blue];
		1384 -> 1385;
	1381 [label="Chat ends.",color=orange];
	1382 [label="Chat ends.",color=orange];
	1385 [label="Усе зводиться до тих самих двох основних принципів, розумієш? Розум і тіло. Символ і значення. Сол і Луа.",shape=box,color=blue];
		1385 -> 1387;
	1387 [label="+20 Chemistry",color=orange];
		1387 -> 1386;
	1386 [label="Ми з Артуром грали в комі щороку на День сонцестояння. Чому ми взагалі перестали?",shape=box,color=blue];
		1386 -> 1388;
	1388 [label="Chat ends.",color=orange];
}