digraph {
	1621 [label="EleanorRank4Convo3 begins.",color=orange];
		1621 -> 1622;
	1622 [label="Здається, у мене вийшло. Я прорвалася. У мене був зв’язок.",shape=box,color=blue];
		1622 -> 1623;
	1623 [label="Ти тут? Будь ласка, будь тут.",shape=box,color=blue];
		1623 -> 1624;
	1624 [label="Мені доведеться робити це телепатично? О Боже. Прошу, не зараз.",shape=box,color=blue];
		1624 -> 1625;
		1624 -> 1626;
	1625 [label="Елеоноро, повільніше. Що відбувається?",shape=box,color=red];
		1625 -> 1628;
	1626 [label="[Ігнорувати]",shape=box,color=red];
		1626 -> 1627;
	1628 [label="Check boolean EleanorSister",color=orange];
		1628 -> 1640 [label=true,color=green];
		1628 -> 1629 [label=false,color=brown];
	1627 [label="Chat ends.",color=orange];
	1640 [label="Інша я. Та, що стала черницею. Я намагалася зв’язатися з нею.",shape=box,color=blue];
		1640 -> 1641;
	1629 [label="Відколи ти тут, мене турбує одне питання. Питання, на яке, здається, я щойно відповіла. І дорогий Соле, я не знаю, що я наробила.",shape=box,color=blue];
		1629 -> 1630;
	1641 [label="Я щойно зробила це.",shape=box,color=blue];
		1641 -> 1642;
	1630 [label="Почни з початку. Я не розумію, про що ти говориш. Яке питання?",shape=box,color=red];
		1630 -> 1631;
	1642 [label="Звичайно, це ніколи не спрацює, поки я залишаюся в цьому світі. Я вже є «я» цього світу. Мені довелося пройти крізь ревучу білину. Морок чорної зірки. Затоку п’явок. Так ти потрапляєш на інший бік. Можливе і те, що могло бути.",shape=box,color=blue];
		1642 -> 1643;
	1631 [label="Ти! Ти — кляте питання. Ти існуєш не лише раз.",shape=box,color=blue];
		1631 -> 1632;
	1643 [label="Порожнеча! Я бачила Порожнечу!",shape=box,color=blue];
		1643 -> 1644;
		1643 -> 1645;
	1632 [label="І якщо ти можеш існувати в іншому світі, як інша версія себе, то чому я не можу?",shape=box,color=blue];
		1632 -> 1633;
	1644 [label="Ти… впевнена, що ти нічого не брала з особливої заначки Летті?",shape=box,color=red];
		1644 -> 1646;
	1645 [label="Це не повинно бути можливим, Елеоноро. Ніхто не входив у Порожнечу, поки цього не зробив Альбрехт Ентраті. Це дуже далеко в майбутньому від того, де ми знаходимося зараз.",shape=box,color=red];
		1645 -> 1647;
	1633 [label="Десь там, у підтверджених на сьогодні величезних можливих всесвітах, була та версія мене, якою я завжди хотіла стати.",shape=box,color=blue];
		1633 -> 1634;
	1646 [label="Любий мандрівниче, я захоплююся твоєю здатністю використовувати гумор як механізм подолання труднощів, але я зараз цілком серйозно.",shape=box,color=blue];
		1646 -> 1648;
	1647 [label="Я увійшла своїм розумом, а не тілом. Ось у чому різниця.",shape=box,color=blue];
		1647 -> 1650;
	1634 [label="Та, яка відвернулася від світу, щоб стати черницею.",shape=box,color=blue];
		1634 -> 1635;
	1648 [label="Я зробила те, що збиралася зробити.",shape=box,color=blue];
		1648 -> 1649;
	1650 [label="Ай моя голова ой-ой-ой",shape=box,color=blue];
		1650 -> 1651;
	1635 [label="Послідовниця Луа сидить десь на вершині гори, в оточенні квітучих хмар.",shape=box,color=blue];
		1635 -> 1636;
	1649 [label="Я не тільки бачила Порожнечу, я зайшла в неї.",shape=box,color=blue];
		1649 -> 1650;
	1651 [label="Check boolean EleanorIndifference2",color=orange];
		1651 -> 1652 [label=true,color=green];
		1651 -> 1654 [label=true,color=green];
		1651 -> 1653 [label=false,color=brown];
		1651 -> 1654 [label=false,color=brown];
	1636 [label="Я намагалася зв’язатися з нею. Намагалася дотягнутися до неї крізь Порожнечу, щоб знайти її.",shape=box,color=blue];
		1636 -> 1637;
	1652 [label="Якщо справді ввійшла в Порожнечу, я навіть не можу описати рівень небезпеки, на який ти себе наразила. Ти знаєш, що там є, та все одно просто занурюєшся туди?",shape=box,color=red];
		1652 -> 1655;
	1654 [label="Ти здуріла?!",shape=box,color=red];
		1654 -> 1657;
	1653 [label="Що ти побачила? Що сталося?",shape=box,color=red];
		1653 -> 1656;
	1637 [label="Update boolean EleanorSister",color=orange];
		1637 -> 1638;
		1637 -> 1639;
	1655 [label="Через ці спогади я й потрапила вперше в Порожнечу. Жах був лише димом, а крізь дим проступала БРАМА. Якби не була такою переляканою, то побачила б її чітко з першого разу.",shape=box,color=blue];
		1655 -> 1662;
	1657 [label="Анітрохи.",shape=box,color=blue];
		1657 -> 1659;
	1656 [label="Таке відчуття неможливо описати словами. Ти дивишся на світ і просто ЗНАЄШ, що вся буденність — будівлі, машини, люди, роботи, рутина — це лише тонка скоринка над бездонним жахом, і якби люди колись усвідомили це, вони б почали кричати та не зупинилися ніколи.",shape=box,color=blue];
		1656 -> 1658;
	1638 [label="О ні.",shape=box,color=red];
		1638 -> 1641;
	1639 [label="І?..",shape=box,color=red];
		1639 -> 1641;
	1662 [label="Це була помилка. Воно забрало Русалку. Воно було до біса близько, щоб забрати Альбрехта. Воно може легко забрати й тебе.",shape=box,color=red];
		1662 -> 1663;
	1659 [label="Просто послухай. Прошу. І спробуй зрозуміти.",shape=box,color=blue];
		1659 -> 1664;
		1659 -> 1665;
	1658 [label="Я провалилася крізь скоринку.",shape=box,color=blue];
		1658 -> 1660;
	1663 [label="Воно намагалося. Я відчувала це. Я знала, що йому цікаво, що воно тягнеться до мене.",shape=box,color=blue];
		1663 -> 1664;
		1663 -> 1665;
	1664 [label="Отже, з нескінченності можливих світів ти просто випадково опинилася в правильному?",shape=box,color=red];
		1664 -> 1666;
	1665 [label="Елеоноро, Байдужість може виглядати як завгодно. Вона була схожа на Альбрехта, коли він уперше з нею зіткнувся.",shape=box,color=red];
		1665 -> 1667;
	1660 [label="Це не була пустота. Я могла би це витримати. Це тривало і тривало вічно, але це був не просто холодний космос. Щось там було зі мною.",shape=box,color=blue];
		1660 -> 1661;
	1666 [label="Це нормально, що ти хочеш переконатися. Я знаю, це звучить божевільно. Просто вислухай мене, добре?",shape=box,color=blue];
		1666 -> 1668;
	1667 [label="Я думаю, можливо, вона відчула, чого ти хочеш, і прийняла ту форму, яку ти сподівалася побачити.",shape=box,color=red];
		1667 -> 1668;
	1661 [label="Update boolean EleanorIndifference2",color=orange];
		1661 -> 1662;
	1668 [label="Я укладу з тобою угоду.",shape=box,color=blue];
		1668 -> 1669;
	1669 [label="Спочатку дай мені закінчити розповідь про те, що сталося.",shape=box,color=blue];
		1669 -> 1670;
	1670 [label="Коли я закінчу, ти зможеш вирішити, чи це Байдужість зі мною пожартувала, чи ні. Обіцяю, я буду ставитися до тебе серйозно.",shape=box,color=blue];
		1670 -> 1671;
	1671 [label="Угода?",shape=box,color=blue];
		1671 -> 1672;
		1671 -> 1673;
	1672 [label="Угода.",shape=box,color=red];
		1672 -> 1682;
	1673 [label="Я не можу повірити, що ти це зробила. Ніколи більше так не роби, Елеоноро! Я НЕ МОЖУ ВТРАТИТИ ТЕБЕ ЧЕРЕЗ ЦЕ!",shape=box,color=red];
		1673 -> 1674;
	1682 [label="Отже, як я вже казала. Я знайшла її.",shape=box,color=blue];
		1682 -> 1683;
	1674 [label="Вибач, що?",shape=box,color=blue];
		1674 -> 1675;
	1683 [label="Я відчувала, як Байдужість спостерігає. Я відчувала, як вона зробила обличчя, схоже на одну з тих висохлих мумій пустелі, коли потягнулася до мене. Я зв’язалася з іншою «я», і вона мене витягла.",shape=box,color=blue];
		1683 -> 1684;
	1675 [label="Я не знаю, що сказати. Я трохи занепокоєна, тому що ти звучиш так засмучено, але я не думала, що тебе це так сильно хвилює.",shape=box,color=blue];
		1675 -> 1676;
	1684 [label="Вона сиділа в позі лотоса в якомусь штибу святилищі просто неба, поруч з ямою, повною вугілля. Була ніч. Тьмяний місяць визирав крізь закручені хмари.",shape=box,color=blue];
		1684 -> 1685;
	1676 [label="Зі мною все гаразд. Будь ласка, не хвилюйся за мене.",shape=box,color=blue];
		1676 -> 1678;
	1685 [label="Вона приклала палець до губ.",shape=box,color=blue];
		1685 -> 1686;
	1678 [label="+5 Chemistry",color=orange];
		1678 -> 1677;
	1686 [label="На секунду я відчула, що ця велетенська рука все ще мацає мене. Потім вона відсахнулася, наче гільйотина опустилася на один з її пальців.",shape=box,color=blue];
		1686 -> 1687;
	1677 [label="Я не можу нічого пообіцяти, але я постараюся більше тебе не лякати.",shape=box,color=blue];
		1677 -> 1679;
		1677 -> 1680;
	1687 [label="Шепотіла трава. Цвіркуни співали. Ми були самі.",shape=box,color=blue];
		1687 -> 1689;
	1679 [label="Добре… просто… розкажи мені, що сталося.",shape=box,color=red];
		1679 -> 1682;
	1680 [label="Я на таке не підписуватимуся. [Завершити розмову]",shape=box,color=red];
		1680 -> 1681;
	1689 [label="Усе це звучить жахливо знайомо. А потім?",shape=box,color=red];
		1689 -> 1688;
	1681 [label="Chat ends.",color=orange];
	1688 [label="Ми сиділи біля вогнища одна навпроти одної. Вона не говорила, але дозволила мені зазирнути в її думки, м’яко і по-сестринськи.",shape=box,color=blue];
		1688 -> 1690;
	1690 [label="Вона була така щаслива, така задоволена. Жінка в тому місці, яке їй було призначено. Мозолисті ноги, ясні очі. Дихати вогнем і пити місяць.",shape=box,color=blue];
		1690 -> 1691;
		1690 -> 1692;
	1691 [label="Отже, ти відчула, що це БУВ правильний вибір для тебе?",shape=box,color=red];
		1691 -> 1693;
	1692 [label="Чи була у тебе спокуса залишитися?",shape=box,color=red];
		1692 -> 1693;
	1693 [label="Ні! Якраз навпаки!",shape=box,color=blue];
		1693 -> 1694;
	1694 [label="Мені не потрібно було йти цим шляхом, тому що вона його вже пройшла. Хіба ти не бачиш? Я тепер вільна. Мені ніколи не потрібно вдаватися в питання «а що, якби», тому що сестра Елеонора вже Є. Вона прикриває мою спину. Я правильно висловилася?",shape=box,color=blue];
		1694 -> 1695;
	1695 [label="Начебто? Все, що я хочу знати, чи допомогло це?",shape=box,color=red];
		1695 -> 1696;
	1696 [label="О так. Я ніколи не була упевненішою в тому, що робити далі.",shape=box,color=blue];
		1696 -> 1698;
	1698 [label="+15 Chemistry",color=orange];
		1698 -> 1697;
	1697 [label="Я збираюся прожити життя, яке вона мені відкрила, і прожити його до кінця.",shape=box,color=blue];
		1697 -> 1699;
	1699 [label="Chat ends.",color=orange];
}