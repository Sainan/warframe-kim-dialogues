	2464 [label="Привіт серденько.",shape=box,color=blue];
		2464 -> 2467;
		2464 -> 2468;
	2465 [label="Привіт, загадковий і напрочуд привабливий незнайомець з іншого часу.",shape=box,color=blue];
		2465 -> 2467;
		2465 -> 2468;
	2467 [label="Ти краще спала минулої ночі?",shape=box,color=red];
		2467 -> 2466;
	2468 [label="Тобі знову приснився кошмар?",shape=box,color=red];
		2468 -> 2466;
	2466 [label="Мені жодного разу не снився сон про Артура відтоді, як я розповіла тобі про бабусю Келлі. Гадаю, того демона вигнано завдяки тобі.",shape=box,color=blue];
		2466 -> 2469;
	2469 [label="Check boolean EleanorDating",color=orange];
		2469 -> 2470 [label=true,color=green];
		2469 -> 2471 [label=false,color=brown];
	2470 [label="Але з того часу, як ми разом, відбувається щось інше. Насправді це трохи незручно. Я давно хотіла поговорити з тобою про це, але не було слушної нагоди.",shape=box,color=blue];
		2470 -> 2472;
		2470 -> 2473;
		2470 -> 2474;
	2471 [label="Але це не означає, що не було ІНШИХ снів. І досить тривожних.",shape=box,color=blue];
		2471 -> 2480;
		2471 -> 2481;
		2471 -> 2482;
	2472 [label="Тобі сняться сни про мене?",shape=box,color=red];
		2472 -> 2475;
	2473 [label="Тобі сняться сни про нас?",shape=box,color=red];
		2473 -> 2476;
	2474 [label="Незручно? Звучить недобре.",shape=box,color=red];
		2474 -> 2477;
	2480 [label="Мені здавалося, тебе нелегко стривожити.",shape=box,color=red];
		2480 -> 2483;
	2481 [label="Падіння з нескінченних сходів?",shape=box,color=red];
		2481 -> 2484;
	2482 [label="Може бути важливо. З твоїми здібностями сон може виявитися не просто сном.",shape=box,color=red];
		2482 -> 2485;
	2475 [label="Це не було б незручно. А це — так.",shape=box,color=blue];
		2475 -> 2478;
	2476 [label="Боже, якби ж то. Боюся, нічого приємного.",shape=box,color=blue];
		2476 -> 2478;
	2477 [label="Не переживай. Це не так вже й погано. Я не боюся. Просто…",shape=box,color=blue];
		2477 -> 2478;
	2483 [label="Ні, але саме тому це мене так турбує.",shape=box,color=blue];
		2483 -> 2486;
	2484 [label="Ні, не тільки це. Кумедно, що це, здається, було у всіх.",shape=box,color=blue];
		2484 -> 2486;
	2485 [label="Це саме те, чого я боюся.",shape=box,color=blue];
		2485 -> 2486;
	2478 [label="(Добре, Елеоноро, глибоко вдихни, ти можеш це зробити)",shape=box,color=blue];
		2478 -> 2479;
	2486 [label="(Добре, Елеоноро, глибоко вдихни, ти можеш це зробити)",shape=box,color=blue];
		2486 -> 2487;
	2479 [label="Я думаю, що техногниль ревнує.",shape=box,color=blue];
		2479 -> 2490;
		2479 -> 2491;
	2487 [label="Я думаю, що техногниль ревнує.",shape=box,color=blue];
		2487 -> 2488;
		2487 -> 2489;
	2490 [label="Ти, напевне, жартуєш.",shape=box,color=red];
		2490 -> 2494;
	2491 [label="Ревнує?",shape=box,color=red];
		2491 -> 2495;
	2488 [label="Ти, напевне, жартуєш.",shape=box,color=red];
		2488 -> 2492;
	2489 [label="Ревнує?",shape=box,color=red];
		2489 -> 2493;
	2494 [label="Ох, я би хотіла.",shape=box,color=blue];
		2494 -> 2496;
	2495 [label="Ревнує, що ти мене забираєш, так.",shape=box,color=blue];
		2495 -> 2496;
	2492 [label="Ох, я би хотіла.",shape=box,color=blue];
		2492 -> 2497;
	2493 [label="Ревнує до нашої дружби, так.",shape=box,color=blue];
		2493 -> 2497;
	2496 [label="На якомусь глибоко заплутаному рівні вона вважає мене своєю власністю. Я мала бути її перспективою для розмноження. Легацити бачать в мені королеву-суперницю, розумієш.",shape=box,color=blue];
		2496 -> 2498;
		2496 -> 2499;
	2497 [label="На якомусь глибоко заплутаному рівні вона вважає мене своєю власністю. Я мала бути її перспективою для розмноження. Легацити бачать в мені королеву-суперницю, розумієш.",shape=box,color=blue];
		2497 -> 2500;
		2497 -> 2501;
	2498 [label="Ворфрейми працюють не так. Зараження в них приборкане, воно дрімає. За винятком Нідуса, мабуть, але він сам собі господар.",shape=box,color=red];
		2498 -> 2503;
	2499 [label="Тож техногниль вважає, що я краду тебе в неї, і тепер хоче повернути?",shape=box,color=red];
		2499 -> 2504;
	2500 [label="Ворфрейми працюють не так. Зараження в них приборкане, воно дрімає. За винятком Нідуса, мабуть, але він сам собі господар.",shape=box,color=red];
		2500 -> 2502;
	2501 [label="Тож техногниль вважає, що я заважаю тобі повернутися до неї?",shape=box,color=red];
		2501 -> 2505;
	2503 [label="Ну, можливо, якби я була повноцінним ворфреймом, техногниль не розглядала б мене в цьому сенсі. Мої клітини все ще киплять, і вона сприймає мене як свою власність.",shape=box,color=blue];
		2503 -> 2506;
	2504 [label="Хіба це не диво? Покинута колишня!",shape=box,color=blue];
		2504 -> 2506;
	2502 [label="Ну, можливо, якби я була повноцінним ворфреймом, техногниль не розглядала б мене в цьому сенсі. Мої клітини все ще киплять, і вона сприймає мене як свою власність.",shape=box,color=blue];
		2502 -> 2507;
	2505 [label="Так. Вона хоче, щоби я повернулася до її банди.",shape=box,color=blue];
		2505 -> 2507;
	2506 [label="Там, звідки я родом, тобі довелося б піти та побитися з нею на парковці місцевого супермаркету. Я не знаю, як це працює у ваш час.",shape=box,color=blue];
		2506 -> 2508;
	2507 [label="Це твоя СПРАВЖНЯ сім’я, - шепоче вона. Стань знову частиною нас, відлучена сестро. Будь долученою.",shape=box,color=blue];
		2507 -> 2508;
	2508 [label="Зачекай, повернися трохи назад. Звідки ти знаєш, що саме це відчуває техногниль?",shape=box,color=red];
		2508 -> 2509;
	2509 [label="О боги, це найнезручніший момент.",shape=box,color=blue];
		2509 -> 2510;
	2510 [label="Сни, про які я згадувала раніше? Я впевнена, що їх надсилає техногниль.",shape=box,color=blue];
		2510 -> 2511;
	2511 [label="Що б там не було, що видає себе за розум, воно завжди було з’єднане з моїм. Думки, які воно надсилає, завжди настільки грубі й слабкі, що я легко від них відбиваюся.",shape=box,color=blue];
		2511 -> 2512;
	2512 [label="Здебільшого це схоже на несамовите шкрябання в потилиці, як тоді, коли ти в туалеті, а кіт намагається відчинити двері.",shape=box,color=blue];
		2512 -> 2513;
		2512 -> 2514;
	2513 [label="Але коли ви спите, це зовсім інша історія, чи не так?",shape=box,color=red];
		2513 -> 2515;
	2514 [label="Гадаю, я розумію куди це все веде.",shape=box,color=red];
		2514 -> 2515;
	2515 [label="Так. Мій захист ослаблений, і воно може дістатися до мене.",shape=box,color=blue];
		2515 -> 2516;
	2516 [label="Воно вразило мене на самому первісному рівні, якщо ти розумієш, про що я. Воно хоче, щоб я повернулася. Воно обіцяє, що я зможу відчути екстаз, якого ніколи не знала.",shape=box,color=blue];
		2516 -> 2517;
	2517 [label="Вона засіяє мою плоть зародками нового життя. Тому що воно думає, що це те, чого я хочу, розумієш.",shape=box,color=blue];
		2517 -> 2518;
	2518 [label="Check boolean EleanorDating",color=orange];
		2518 -> 2519 [label=true,color=green];
		2518 -> 2520 [label=true,color=green];
		2518 -> 2521 [label=false,color=brown];
		2518 -> 2522 [label=false,color=brown];
	2519 [label="Гаразд, думаю, це все для нас. Як я можу змагатися з цим?",shape=box,color=red];
		2519 -> 2523;
	2520 [label="Я *спалю все це*, перш ніж дозволю йому забрати тебе.",shape=box,color=red];
		2520 -> 2524;
	2521 [label="Я ніколи не дозволю йому забрати тебе, Елеоноро. Ти — моя подруга.",shape=box,color=red];
		2521 -> 2525;
	2522 [label="Ти для мене як сім’я. Я не дам йому тебе забрати.",shape=box,color=red];
		2522 -> 2526;
	2523 [label="+20 Chemistry",color=orange];
		2523 -> 2530;
	2524 [label="Після такої розмови мандрівник повністю засипається поцілунками.",shape=box,color=blue];
		2524 -> 2527;
	2525 [label="Я знаю. Думаю, воно теж знає, тому так злиться. Воно не може змагатися.",shape=box,color=blue];
		2525 -> 2528;
	2526 [label="Я буду спокійніше спати, знаючи, що ти мене прикриєш.",shape=box,color=blue];
		2526 -> 2529;
	2530 [label="Усе гаразд, любчику. Я не збираюся залишати тебе заради гнійної маси туберкульозної плоті з плаваючими в ній шматками осиротілих технологій.",shape=box,color=blue];
		2530 -> 2531;
	2527 [label="+20 Chemistry",color=orange];
		2527 -> 2532;
	2528 [label="+20 Chemistry",color=orange];
		2528 -> 2533;
	2529 [label="+20 Chemistry",color=orange];
		2529 -> 2534;
	2531 [label="Просто… якщо ти побачиш, що мої очі особливо затьмарені, та я виглядаю виснаженою в якийсь конкретний ранок, коли ми прокидаємося разом, просто принеси мені міцної кави та не випитуй у мене подробиць?",shape=box,color=blue];
		2531 -> 2535;
		2531 -> 2536;
	2532 [label="Хочеш дати техногнилі щось, чому вона ДІЙСНО позаздрить?",shape=box,color=blue];
		2532 -> 2538;
	2533 [label="Тоді ми пройдемо через це разом. Пліч-о-пліч. Завжди.",shape=box,color=blue];
		2533 -> 2539;
	2534 [label="Ми — сім’я. Однієї крові. Незламні.",shape=box,color=blue];
		2534 -> 2540;
	2535 [label="Так і зроблю.",shape=box,color=red];
		2535 -> 2537;
	2536 [label="…Прийнято.",shape=box,color=red];
		2536 -> 2537;
	2538 [label="Chat ends.",color=orange];
