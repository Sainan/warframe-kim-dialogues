digraph {
	673 [label="EleanorRank2Convo5 begins.",color=orange];
		673 -> 674;
	674 [label="Агов, Елеоноро…",shape=box,color=red];
		674 -> 675;
	675 [label="Привіт. Про що думаєш?",shape=box,color=blue];
		675 -> 683;
		675 -> 676;
	683 [label="Ти була «журналісткою», так? Що це означає конкретно? Що робила?",shape=box,color=red];
		683 -> 684;
	676 [label="Нічого такого. [Завершити розмову]",shape=box,color=red];
		676 -> 677;
	684 [label="Я була кимось, хто перетворює чужі травми на гроші.",shape=box,color=blue];
		684 -> 685;
	677 [label="Я.",shape=box,color=blue];
		677 -> 678;
	685 [label="Зрозуміло. Ми називаємо їх «Корпус».",shape=box,color=red];
		685 -> 686;
	678 [label="…",shape=box,color=blue];
		678 -> 679;
	686 [label="Check boolean EleanorOrigin",color=orange];
		686 -> 687 [label=true,color=green];
		686 -> 688 [label=false,color=brown];
	679 [label="Ти —",shape=box,color=blue];
		679 -> 680;
	687 [label="О боги. Вибач. Я пожартувала.",shape=box,color=blue];
		687 -> 688;
	688 [label="Дай мені спробувати ще раз.",shape=box,color=blue];
		688 -> 689;
	680 [label="Це не я перша почала…",shape=box,color=blue];
		680 -> 681;
	689 [label="Журналісти — це ті, хто полюють за цікавими речами, що відбуваються у світі, та розповідають про них іншим людям, пишучи або роблячи якісь трансляції. Зазвичай і те, й інше.",shape=box,color=blue];
		689 -> 690;
	681 [label="Я спантеличена…",shape=box,color=blue];
		681 -> 682;
	690 [label="Напевно, підійде «оповідачі». Але не ті, що вигадують.",shape=box,color=blue];
		690 -> 691;
		690 -> 692;
	682 [label="Chat ends.",color=orange];
	691 [label="Отже, то що робить історію «цікавою»?",shape=box,color=red];
		691 -> 693;
	692 [label="Отже, ти розповідаєш тільки правду? Як ти обираєш, яку правду говорити?",shape=box,color=red];
		692 -> 693;
	693 [label="Здебільшого людям цікаво читати про погані речі, які відбуваються у світі. Чим кривавіше, тим цікавіше, як то кажуть.",shape=box,color=blue];
		693 -> 694;
	694 [label="Я не можу уявити, що у твій час ситуація змінилася.",shape=box,color=blue];
		694 -> 695;
	695 [label="Я намагалася змінити ситуацію своєю роботою. Так, мені за це платили, але також хотіла творити добро у світі.",shape=box,color=blue];
		695 -> 696;
	696 [label="Check boolean EleanorHatesHeroes",color=orange];
		696 -> 697 [label=true,color=green];
		696 -> 698 [label=false,color=brown];
	697 [label="Я тоді була молодшою, звісно. Ніщо так не виліковує від бажання «творити добро у світі», як проведення в ньому певного часу.",shape=box,color=blue];
		697 -> 699;
	698 [label="Ось куди це мене привело. Буквально. Я приїхала сюди, до Голвенії, в першу чергу через цю історію.",shape=box,color=blue];
		698 -> 700;
	699 [label="Вибач. Відволіклася. Треба потеревенити. Маєш бажання послухати розповідь про мою улюблену ненависть?",shape=box,color=blue];
		699 -> 701;
		699 -> 702;
	700 [label="Мені здавалося, що ти тут через Артура.",shape=box,color=red];
		700 -> 705;
	701 [label="Так, чом би й ні.",shape=box,color=red];
		701 -> 704;
	702 [label="Чесно кажучи, ні. [Завершити розмову]",shape=box,color=red];
		702 -> 703;
	705 [label="О, він був тут першим. Але зробив помилку, розповівши що тут відбувається, і я не змогла втриматися. Тож я дзвоню своєму старому друзяці Денні Маклвою та переплачую за підроблену візу та паспорт. Тому що вони мені потрібні терміново.",shape=box,color=blue];
		705 -> 706;
	704 [label="Добре. Не кажи, що я тебе не попереджала. У мене є теорія, яку я називаю «Вірус героя».",shape=box,color=blue];
		704 -> 707;
	703 [label="Chat ends.",color=orange];
	706 [label="Тобі потрібно розуміти: вони закрили Голвенію, але не могли зробити все одночасно. Можливо, це була країна-фортеця ще за часів Світлосяйної Хани, але стіни, які були збудовані, щоб відгородитися від неї, вже старі, і влада не змогла вчасно звести барикади та блок-пости.",shape=box,color=blue];
		706 -> 708;
	707 [label="Просто уяви на мить, що у тебе може бути вірус, який передається через історії. Як і всі віруси, він хоче захопити носія і поширитися далі.",shape=box,color=blue];
		707 -> 709;
	708 [label="Люди перелазили через інших, щоб вибратися. Тож ніхто не звернув особливої уваги на одну дурнувату британську дівчину, яка намагалася потрапити всередину.",shape=box,color=blue];
		708 -> 710;
	709 [label="Вірус героя змушує дивитися на світ як на історію. Він переконує тебе, що Добро — це лише ОКРЕМІ ЛЮДИ, які роблять ЧУДОВІ РЕЧІ",shape=box,color=blue];
		709 -> 711;
	710 [label="Ти хочеш дізнатися найгіршу частину?",shape=box,color=blue];
		710 -> 712;
		710 -> 713;
	711 [label="Природно, що ти хочеш бути одним із цих людей",shape=box,color=blue];
		711 -> 720;
	712 [label="Розкажи мені найгіршу частину.",shape=box,color=red];
		712 -> 717;
	713 [label="Це буде бридко?",shape=box,color=red];
		713 -> 714;
	720 [label="Як би важко це не було",shape=box,color=blue];
		720 -> 721;
	717 [label="Гаразд. Ось найгірша частина.",shape=box,color=blue];
		717 -> 718;
	714 [label="Ой, і ми раптом стали гидливі?",shape=box,color=blue];
		714 -> 715;
	721 [label="Тому що Герою доводиться приймати складні рішення. Герой повинен стійко переносити біль.",shape=box,color=blue];
		721 -> 722;
	718 [label="Я розслідувала спалах так званого «синдрому Тестудо». Тестудо означає «черепаха», і у людей, які страждали на нього, з’являлися жорсткі плями на шкірі, що є ранньою ознакою. Те саме, що згодом перетворюється на броню для нас, щасливчиків.",shape=box,color=blue];
		718 -> 719;
	715 [label="Пардон, що зачепила ваші тонкі почуття. Тоді не зважай.",shape=box,color=blue];
		715 -> 716;
	722 [label="Це все таке цинічне лайно. Вірус героя існує для того, щоб продавати іграшки, рекламувати фільми та перетворювати маленьких хлопчиків і дівчаток на гарматне м’ясо",shape=box,color=blue];
		722 -> 723;
	719 [label="Синдром Тестудо був стійким для лікування захворюванням, який, здавалося, був притаманний лише в Голвенії, мав якийсь загадковий і зловісний зв’язок із комп’ютерами та з’явився раптово. А люди, які задавали занадто багато питань про це, мали тенденцію закінчувати життя як засмічення в каналізаційній трубі Голвенії.",shape=box,color=blue];
		719 -> 724;
	716 [label="Chat ends.",color=orange];
	723 [label="Вони не знімають фільми про обранця, чия героїчна доля — підтирати зади старим людям у будинку пристарілих",shape=box,color=blue];
		723 -> 725;
	724 [label="Уже за кілька годин після потрапляння в Голвенію я шукала шлях в каналізації та намагалася розмовами вгамувати найбільший сплеск емоцій Артура за все його життя.",shape=box,color=blue];
		724 -> 726;
	725 [label="Я майже закінчила, залишайся зі мною",shape=box,color=blue];
		725 -> 727;
	726 [label="Цей хлопець. Можна подумати, що я пішла за ним сюди тільки, щоб його розлютити.",shape=box,color=blue];
		726 -> 728;
		726 -> 729;
		726 -> 730;
	727 [label="Вірус героя змушує тебе думати, що ти можеш принести найбільше користі, якщо будеш у центрі уваги. Він подає неможливий, викривлений приклад",shape=box,color=blue];
		727 -> 733;
	728 [label="Схоже, ти не сприйняла ситуацію серйозно.",shape=box,color=red];
		728 -> 735;
	729 [label="Визнай. Ти так і зробила.",shape=box,color=red];
		729 -> 736;
	730 [label="Ні, але це *був* бонус, чи не так?",shape=box,color=red];
		730 -> 737;
	733 [label="+15 Chemistry",color=orange];
		733 -> 731;
	735 [label="Я, чорт забирай, сприйняла це серйозно.",shape=box,color=blue];
		735 -> 738;
	736 [label="Звичайно, зробила. Але також я мала благородну мету.",shape=box,color=blue];
		736 -> 739;
	737 [label="Саме так. Але також я мала благородну мету.",shape=box,color=blue];
		737 -> 739;
	731 [label="Артур думає, що втрачає мене через техногниль. Але правда в тому, що я втратила його через Вірус героя вже давно.",shape=box,color=blue];
		731 -> 732;
	738 [label="Люди намагалися вбити мене. Вибач мені моє почуття гумору щодо цього.",shape=box,color=blue];
		738 -> 740;
	739 [label="«Благородну». Солові кружальця. Я справді заслужила на все, що зі мною сталося, правда?",shape=box,color=blue];
		739 -> 741;
		739 -> 742;
	732 [label="Update boolean EleanorHeroVirus",color=orange];
		732 -> 734;
	740 [label="Можливо, в тебе занадто довго була самотність, але в такій ситуації, виводячи одне одного з себе, ми зберігаємо здоровий глузд.",shape=box,color=blue];
		740 -> 745;
	741 [label="Ти ж розповідаєш мені про найгіршу частину.",shape=box,color=red];
		741 -> 743;
	742 [label="Схоже, ти просто виконувала свою роботу. Що сталося далі?",shape=box,color=red];
		742 -> 744;
	734 [label="Chat ends.",color=orange];
	745 [label="Визнаю, іноді це чіпляє за живе, особливо коли Летті переживає чергову депресію та потребує когось, кого можна ненавидіти",shape=box,color=blue];
		745 -> 746;
	743 [label="Так, так.",shape=box,color=blue];
		743 -> 744;
	744 [label="Отже, я в каналізації, і повз мене проходить щось із купою ЕПТ екранів замість голови. Я не встигла обісратися, як знайшла гніздо.",shape=box,color=blue];
		744 -> 749;
	746 [label="Але, будь ласка, заради всіх нас, трохи розслабся.",shape=box,color=blue];
		746 -> 747;
	749 [label="Нарости. Частково органіка, частково технології, частково біла гарячка якогось бідолахи. Світло таких кольорів люди бачать лише тоді, коли вдихають забагато парів розчинника. Це огидно, і я не можу відвести від цього очей.",shape=box,color=blue];
		749 -> 750;
	747 [label="Навіть Артур час від часу відкриває пиво та закидає ноги на стіл.",shape=box,color=blue];
		747 -> 748;
	750 [label="Джекпот, здається.",shape=box,color=blue];
		750 -> 751;
		750 -> 752;
	748 [label="Chat ends.",color=orange];
	751 [label="О ні…",shape=box,color=red];
		751 -> 754;
	752 [label="Скажи, що ти там не залишилася.",shape=box,color=red];
		752 -> 753;
	754 [label="Я роблю з десяток зернистих знімків на свою розкладачку Kinematic 2300A і надсилаю їх Артуру.",shape=box,color=blue];
		754 -> 755;
	753 [label="Звичайно, залишилася.",shape=box,color=blue];
		753 -> 754;
	755 [label="І кажу: «Думаю, я знайшла, звідки береться ця техногниль.»",shape=box,color=blue];
		755 -> 756;
	756 [label="Наступного дня я подала статтю: «Техногниль на вулицях Голвенії.»",shape=box,color=blue];
		756 -> 757;
		756 -> 758;
	757 [label="Ти дала йому назву.",shape=box,color=red];
		757 -> 759;
	758 [label="Ось звідки воно взялося.",shape=box,color=red];
		758 -> 759;
	759 [label="Та-дам! Я дала йому назву.",shape=box,color=blue];
		759 -> 760;
	760 [label="Це вона. Найгірша частина.",shape=box,color=blue];
		760 -> 761;
	761 [label="Ніхто зараз не називає це «синдромом Тестудо». Ніхто не називає Техноцитом. Усі називають це техногниллю.",shape=box,color=blue];
		761 -> 762;
	762 [label="Я дала назву тому, що з’їло це місто та роз’їдає мене зсередини.",shape=box,color=blue];
		762 -> 763;
	763 [label="Update boolean EleanorHollTold",color=orange];
		763 -> 764;
		763 -> 765;
	764 [label="Граючи в дурні ігри, отримуєш дурні призи, еге ж?",shape=box,color=red];
		764 -> 766;
	765 [label="Що поганого в цьому? Влучна назва.",shape=box,color=red];
		765 -> 778;
	766 [label="Вибач. Чомусь я думала, що ти зрозумієш. Або хоча б поспівчуваєш.",shape=box,color=blue];
		766 -> 767;
	778 [label="+20 Chemistry",color=orange];
		778 -> 773;
	767 [label="Ти маєш рацію. Це ВСЕ дурна гра, чи не так",shape=box,color=blue];
		767 -> 768;
	773 [label="Ніхто не говорить про те, як я писала про міністра Джеремі Коністона та фальшиву допомогу голодуючим, чи скандал з добривами Лазло, чи будь-що інше. Вони ледь здійняли хвилю.",shape=box,color=blue];
		773 -> 774;
	768 [label="Ми всі просто купка гниючих клоунів, що потрапили в пастку на каруселі, яка ніколи не зупиняється",shape=box,color=blue];
		768 -> 769;
	774 [label="А тепер я придумала термін, який використовують усі, але ніхто навіть не знає, що це я.",shape=box,color=blue];
		774 -> 775;
	769 [label="Підходьте, підходьте, подивіться на дивовижну леді горгону, єдину в своєму роді, не дозволяйте дитині підходити надто близько, пані, її сьогодні не годували",shape=box,color=blue];
		769 -> 771;
	775 [label="«Техногниль»",shape=box,color=blue];
		775 -> 776;
	771 [label="+10 Chemistry",color=orange];
		771 -> 770;
	776 [label="Вони можуть написати це слово на моєму клятому надгробку.",shape=box,color=blue];
		776 -> 777;
	770 [label="Пиши, як захочеш. Мені треба випити.",shape=box,color=blue];
		770 -> 772;
	777 [label="Якщо він в мене буде.",shape=box,color=blue];
		777 -> 779;
	772 [label="Chat ends.",color=orange];
	779 [label="Chat ends.",color=orange];
}