		2043 -> 2046 [label=false,color=brown];
		2043 -> 2047 [label=false,color=brown];
	2042 [label="Chat ends.",color=orange];
	2045 [label="Агов, Елеоноро? Пам’ятаєш настільну гру, на яку збирає Амір? «Оповідки Прикордоння»?",shape=box,color=red];
		2045 -> 2044;
	2046 [label="Агов, Елеоноро? Ви ж з Аміром друзі, так?",shape=box,color=red];
		2046 -> 2048;
	2047 [label="Ти ж любиш настільні ігри, так?",shape=box,color=red];
		2047 -> 2049;
	2044 [label="Ага. Та, яку ти вважаєш марною тратою часу та погоджуєшся грати лише з жалю до нього, це та сама, чи не так?",shape=box,color=blue];
		2044 -> 2050;
		2044 -> 2052;
		2044 -> 2053;
	2048 [label="Він чарівний маленький бісик. Чому ти питаєш?",shape=box,color=blue];
		2048 -> 2055;
		2048 -> 2056;
	2049 [label="Напевно, так само як і будь-яка інша людина. Чому ти питаєш?",shape=box,color=blue];
		2049 -> 2055;
		2049 -> 2056;
	2050 [label="Йой. Гаразд. Ти все ще злишся. Зрозуміло.",shape=box,color=red];
		2050 -> 2051;
	2052 [label="Тоді мені здавалося, що ти «занадто крута для цього», і мені хотілося здаватися теж. Тепер я знаю краще.",shape=box,color=red];
		2052 -> 2054;
	2053 [label="Так, я… просто хочу вибачитися за це, я… не це мав на увазі. Мене непокоїло, що ти скажеш ні.",shape=box,color=red];
		2053 -> 2062;
	2055 [label="Амір намагається зібрати команду для гри «Оповідки Прикордоння», і я маю намір допомогти.",shape=box,color=red];
		2055 -> 2057;
	2056 [label="Амір дуже хоче пограти в «Оповідки Прикордоння» з усіма. Ти будеш?",shape=box,color=red];
		2056 -> 2057;
	2051 [label="Chat ends.",color=orange];
	2054 [label="Хто з нас більше не «занадто крутий» для гри? Ти чи я?",shape=box,color=blue];
		2054 -> 2058;
		2054 -> 2059;
		2054 -> 2060;
	2062 [label="Ми всі колись були в такій ситуації… надягали маску, щоб справити на когось враження, але падали лицем у багнюку, бо не бачили, куди йдемо. Ми з тобою були ледве знайомі. Гаразд. Я тебе прощаю.",shape=box,color=blue];
		2062 -> 2067;
	2057 [label="Ага, зрозуміло. Тебе обрано, щоби доправити послання від Короля Громовержця для залучення чарівної Елеонори. Не маю сумнівів, що на мене чекають усілякі шахрайства, сміхунці та дурбелицтво.",shape=box,color=blue];
		2057 -> 2063;
		2057 -> 2064;
	2058 [label="Ти. Я все ще вважаю, що це тупа гра, але неважливо.",shape=box,color=red];
		2058 -> 2061;
	2059 [label="Я. Безумовно, я. Ти все ще занадто крута для гри. Але я повне дурко, принаймні так каже Квінсі.",shape=box,color=red];
		2059 -> 2062;
	2060 [label="…Обоє?",shape=box,color=red];
		2060 -> 2062;
	2067 [label="Чесно кажучи, ввімкнути дурнуватий голос і придурюватися кілька годин звучить ідеально. Я з вами.",shape=box,color=blue];
		2067 -> 2068;
	2063 [label="Я думаю, що буде весело, якщо чесно. І, здається, це багато для нього значить.",shape=box,color=red];
		2063 -> 2067;
	2064 [label="Так, я думаю, що це буде марна трата часу, але намагаюся поводитися чемно.",shape=box,color=red];
		2064 -> 2065;
	2061 [label="Chat ends.",color=orange];
	2068 [label="О! Я хочу бути чарівницею. Або, може, бардкою. Чи обома? Я можу БУТИ обома?",shape=box,color=blue];
		2068 -> 2069;
	2065 [label="Я зроблю тобі послугу та НЕ перекажу йому ці слова. Запам’ятай мудрість: стався до нього з більшою повагою в майбутньому в моїй присутності.",shape=box,color=blue];
		2065 -> 2066;
	2069 [label="Або я можу бути болотяною відьмою! Поки я можу носити тісний корсет, між іншим. Матінка-моховиця з’їсть твої кісточки, маленьке опудало.",shape=box,color=blue];
		2069 -> 2077;
	2066 [label="Chat ends.",color=orange];
