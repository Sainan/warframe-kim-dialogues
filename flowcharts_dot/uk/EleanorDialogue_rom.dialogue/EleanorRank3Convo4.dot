	1166 [label="Тепер я маю це місце. Це перше місце, де я відчуваю себе по-справжньому, як удома.",shape=box,color=red];
		1166 -> 1171;
	1176 [label="Добре. Ордіс кличе «Оператором». Лотос називає своїм дитям. Здебільшого я просто кличу малям.",shape=box,color=red];
		1176 -> 1180;
	1177 [label="Я намагаюся уникати зустрічі, як тільки можу. Мені не платять достатньо, щоби бути нянькою, навіть якщо це я.",shape=box,color=red];
		1177 -> 1178;
	1167 [label="Мені вдалося вибратися. Вижити. Чи не шалена вдача?",shape=box,color=red];
