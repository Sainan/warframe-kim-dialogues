		1182 -> 1183;
	1185 [label="Тож ось частина, яку я не розумію.",shape=box,color=blue];
		1185 -> 1186;
	1183 [label="Цікаво, чи дозволила б вона мені бути однією з них? Чи можу я бути тенно?",shape=box,color=blue];
		1183 -> 1184;
	1186 [label="Дитяті цілий мільярд років, але більшу частину цього часу проведено в морозилці, тож воно все ще дитя, так?",shape=box,color=blue];
		1186 -> 1187;
		1186 -> 1188;
	1184 [label="Ні. Я не думаю, що змогла би, чи не так? Я занадто стара, щоби почати.",shape=box,color=blue];
		1184 -> 1185;
	1187 [label="Щось таке.",shape=box,color=red];
		1187 -> 1189;
	1188 [label="Не знаю, наскільки вони насправді «діти», коли їх навчили вбивати, щоб заробляти на життя.",shape=box,color=red];
		1188 -> 1190;
	1189 [label="Добре.",shape=box,color=blue];
		1189 -> 1191;
