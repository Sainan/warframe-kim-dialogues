		1194 -> 1195;
	1193 [label="Chat ends.",color=orange];
	1195 [label="Заримен? Що сталося з твоїми батьками? Це дитя пройшло через таке ж жахливе випробування, що й ти, правильно?",shape=box,color=blue];
		1195 -> 1196;
	1196 [label="Так.",shape=box,color=red];
		1196 -> 1197;
	1197 [label="Ти повинна розуміти, що спочатку була тільки одна версія мене, нас. Ми були абсолютно однією особою, аж поки не потиснули одне одному руку. Тоді наші шляхи розділилися.",shape=box,color=red];
		1197 -> 1198;
	1198 [label="Добре. У мене болить голова, коли я думаю про це, але добре.",shape=box,color=blue];
		1198 -> 1199;
	1199 [label="Отже, є діти. Глибоко травмовані діти. І хтось вирішив, що це гарна ідея — дати цим дітям зброю та обладунки, добірку бойових костюмів, зроблених з мертвих людей, і навчити їх вбивати та відправити на війну?",shape=box,color=blue];
		1199 -> 1200;
	1200 [label="Ага. Це були орокіни.",shape=box,color=red];
		1200 -> 1201;
	1201 [label="Скажи, після всього того, через що вони пройшли та досі проходять, як ці діти не опинилися в лікарні в кататонічному стані?",shape=box,color=blue];
		1201 -> 1202;
		1201 -> 1203;
	1202 [label="Чесно кажучи, я не можу тобі сказати. Я знаю, що є люди, які їх люблять та піклуються про них. Переважно Ордіс і Лотос.",shape=box,color=red];
		1202 -> 1204;
	1203 [label="Порожнеча знає, що вони бачили набагато більше насильства і кровопролиття, ніж будь-яка дитина повинна бачити. Вони теж ніколи не підписувалися на це лайно.",shape=box,color=red];
		1203 -> 1204;
	1204 [label="У тенно не було вибору, коли їх робили воїнами. Орокіни збиралися вбити кожного з них, перш ніж знайшли їм застосування.",shape=box,color=red];
		1204 -> 1205;
	1205 [label="Але що змушує їх заходити всередину? Я не думаю, що це те, чому їх навчали. Це щось, ким вони є.",shape=box,color=red];
		1205 -> 1206;
	1206 [label="Турбота? Співчуття?",shape=box,color=blue];
		1206 -> 1207;
		1206 -> 1208;
		1206 -> 1209;
	1207 [label="Справедливість. Праведність.",shape=box,color=red];
		1207 -> 1210;
	1208 [label="Можливо, щось глибше.",shape=box,color=red];
		1208 -> 1224;
	1209 [label="Інстинкт виживання. Зрештою, люди хочуть жити.",shape=box,color=red];
		1209 -> 1231;
	1210 [label="Check boolean EleanorHeroVirus",color=orange];
		1210 -> 1211 [label=true,color=green];
		1210 -> 1212 [label=false,color=brown];
	1224 [label="Можливо, щось протилежне Байдужості.",shape=box,color=blue];
		1224 -> 1225;
	1231 [label="Гм-м. Я не знаю.",shape=box,color=blue];
		1231 -> 1232;
	1211 [label="Звичайно. Вірус героя. Я б мала здогадатися, що він доживе до ваших часів.",shape=box,color=blue];
		1211 -> 1213;
	1212 [label="Тьху. Вірус героя.",shape=box,color=blue];
		1212 -> 1214;
	1225 [label="Можливо…",shape=box,color=blue];
		1225 -> 1226;
	1232 [label="Вони б нічим не відрізнялися від техногнилі, якби все, що вони хотіли — це вижити.",shape=box,color=blue];
		1232 -> 1233;
	1213 [label="Ці бідні діти були занурені в міф, чи не так?",shape=box,color=blue];
		1213 -> 1215;
	1214 [label="Це те, що я називаю кругообігом маячні, яка починається з красивих історій, а закінчується тим, що молоді люди добровільно йдуть на смерть.",shape=box,color=blue];
		1214 -> 1219;
	1226 [label="Що?",shape=box,color=red];
		1226 -> 1227;
	1233 [label="З огляду на те, як ти говориш про дитя, я не знаю, чи я більше боюся за нього чи його.",shape=box,color=blue];
		1233 -> 1234;
	1215 [label="Навчені вірити, що вони були благородними воїнами, а не безвинним знаряддям у чиїхось руках?",shape=box,color=blue];
		1215 -> 1216;
	1219 [label="Артур має його. Крістофер мав.",shape=box,color=blue];
		1219 -> 1220;
	1227 [label="Нічого. Просто думка.",shape=box,color=blue];
		1227 -> 1228;
	1234 [label="Я думаю, що в цьому є милосердя. Якесь глибоке співчуття. Можливо, одного дня я побачу це на власні очі.",shape=box,color=blue];
		1234 -> 1235;
	1216 [label="Можеш не відповідати. Гадаю, я вже знаю.",shape=box,color=blue];
