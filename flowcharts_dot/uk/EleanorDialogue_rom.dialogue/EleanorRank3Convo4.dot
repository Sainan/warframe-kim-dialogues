		j777617687 -> j254967605;
	j1398269630 [label="Чесно кажучи, не маю певності, що вбивати тисячі людей, несучи в собі невимовну травму, — це «бути в порядку».",shape=box,color=blue];
		j1398269630 -> j1032496965;
