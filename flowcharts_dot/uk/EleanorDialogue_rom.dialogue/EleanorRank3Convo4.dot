digraph {
	1123 [label="EleanorRank3Convo4 begins.",color=orange];
		1123 -> 1124;
	1124 [label="Тож виправи мене, якщо я щось не так зрозуміла:",shape=box,color=blue];
		1124 -> 1125;
	1125 [label="У тебе є ще одне «я», яке ходить навколо. Це інше «я» одночасно є й не є тобою. Воно схоже на дитячу версію тебе з іншої версії реальності.",shape=box,color=blue];
		1125 -> 1126;
		1125 -> 1127;
	1126 [label="Не зовсім. Це не моя версія реальності. Я не маю тут бути.",shape=box,color=red];
		1126 -> 1128;
	1127 [label="Скоріше, ми розділилися в якийсь момент, пішли різними дорогами.",shape=box,color=red];
		1127 -> 1129;
	1128 [label="Святі горобчики. Зачекай. Дозволь мені це осмислити.",shape=box,color=blue];
		1128 -> 1130;
	1129 [label="І я так розумію, ми живемо не в ТВОЇЙ реальності. Дай… подумати.",shape=box,color=blue];
		1129 -> 1130;
	1130 [label="Отже… ти наче запрошена зірка з перехресного епізоду, і тебе додали в шоу?",shape=box,color=blue];
		1130 -> 1131;
	1131 [label="Типу того.",shape=box,color=red];
		1131 -> 1132;
	1132 [label="У мене від цього голова йде обертом. То що ж сталося з твоєю версією реальності? Куди вона поділася?",shape=box,color=blue];
		1132 -> 1133;
		1132 -> 1134;
		1132 -> 1135;
	1133 [label="Думаю, єдине, що залишилося від неї — це зореліт-привид «Заримен», який затикає дірку між вимірами?..",shape=box,color=red];
		1133 -> 1136;
	1134 [label="Думаю, те, що від неї залишилося, прийшло зі мною в Дувірі. На… щастя чи на біду.",shape=box,color=red];
		1134 -> 1137;
	1135 [label="Я не зациклююся на цьому. Гадаю, вона втрачена.",shape=box,color=red];
		1135 -> 1138;
	1136 [label="Check boolean EleanorHoldfasts1",color=orange];
		1136 -> 1139 [label=true,color=green];
		1136 -> 1140 [label=false,color=brown];
	1137 [label="Тоді вона жива, в якомусь сенсі.",shape=box,color=blue];
		1137 -> 1145;
	1138 [label="Ти не можеш просто ВТРАТИТИ цілий космос. Це божевілля. Вона має бути десь там.",shape=box,color=blue];
		1138 -> 1146;
	1139 [label="А. Лігво твоїх дружніх привидів. «Паланка».",shape=box,color=blue];
		1139 -> 1141;
	1140 [label="Вибач, це звучить захопливо, але я поняття не маю, про що ти говориш.",shape=box,color=blue];
		1140 -> 1142;
	1145 [label="Я не знаю, чи це хоч якось заспокоює.",shape=box,color=blue];
		1145 -> 1147;
	1146 [label="Можливо. Як я кажу, це не моя головна проблема.",shape=box,color=red];
		1146 -> 1148;
	1141 [label="Не можу уявити, що це те місце, куди хотілося б повернутися для ностальгічної прогулянки.",shape=box,color=blue];
		1141 -> 1143;
	1142 [label="Зореліт-привид?",shape=box,color=blue];
		1142 -> 1144;
	1147 [label="Я розумію, що дім і сім’я це — більше про те, «де» ти існуєш, і «хто» навколо тебе.",shape=box,color=red];
		1147 -> 1149;
	1148 [label="Але це твій ДІМ. Хіба ти не хочеш повернутися?",shape=box,color=blue];
		1148 -> 1150;
	1143 [label="Я не можу збагнути, що втрачено.",shape=box,color=blue];
		1143 -> 1151;
	1144 [label="Дірка між вимірами?",shape=box,color=blue];
		1144 -> 1152;
	1149 [label="І менше про те, «де» і «чому» ти народжуєшся.",shape=box,color=red];
		1149 -> 1157;
	1150 [label="Насправді ні, більше не хочу. У мене немає дому.",shape=box,color=red];
		1150 -> 1158;
	1151 [label="Я також не бачу цього.",shape=box,color=red];
		1151 -> 1153;
	1152 [label="«Заримен» був зорельотом колоністів зі мною на борту. Прямував до Тау. Але не дістався.",shape=box,color=red];
		1152 -> 1154;
	1157 [label="Я не зациклююся на тому, що втрачено. Я зосереджуюся на тому, що ще маю. Як це місце. Як усі ви. Тому що…",shape=box,color=red];
		1157 -> 1159;
	1158 [label="Прізвисько «Мандрівник» прижилося не просто так, знаєш.",shape=box,color=red];
		1158 -> 1159;
	1153 [label="Мені вдалося вибратися. Вижити. Чи не шалена вдача?",shape=box,color=red];
		1153 -> 1155;
	1154 [label="Він опинився в Порожнечі, та щось, що існувало там, вирішило перетворити зореліт на подобу пекла.",shape=box,color=red];
		1154 -> 1156;
	1159 [label="З усіх місць, що мені довелося відвідати, тут я почуваюся на своєму місці.",shape=box,color=red];
		1159 -> 1171;
	1155 [label="Чесно кажучи, шанси на те, що хтось із нас реально існує, настільки малі, що для мене це просто ще одне диво.",shape=box,color=red];
		1155 -> 1160;
	1156 [label="Його колошматило туди-сюди між Порожнечею та реальністю, а тепер він застряг на порозі.",shape=box,color=red];
		1156 -> 1161;
	1171 [label="Ха. Я, як не дивно, пишаюся цим.",shape=box,color=blue];
		1171 -> 1172;
	1160 [label="Не зациклюйся на тому, що втрачено. Цінуй те, що маєш.",shape=box,color=red];
		1160 -> 1170;
	1161 [label="Це не один зореліт. Це наче… багато різних версій одного.",shape=box,color=red];
		1161 -> 1162;
	1172 [label="Можливо, тобі просто була потрібна група забійно стильних урбаністичних біокомандос, з якими можна потоваришувати.",shape=box,color=blue];
		1172 -> 1173;
	1170 [label="Наприклад? Тепер я маю це місце. І всіх вас. Це перше місце, де я відчуваю себе по-справжньому, як удома.",shape=box,color=red];
		1170 -> 1171;
	1162 [label="Update boolean EleanorHoldfasts1",color=orange];
		1162 -> 1163;
	1173 [label="Невдах і похибок як я?",shape=box,color=red];
		1173 -> 1174;
	1163 [label="Не можу уявити, що це те місце, куди хотілося б повернутися для ностальгічної прогулянки.",shape=box,color=blue];
		1163 -> 1164;
	1174 [label="І пишатися цим, дружаньо.",shape=box,color=blue];
		1174 -> 1175;
	1164 [label="Я не можу збагнути, що втрачено.",shape=box,color=blue];
		1164 -> 1165;
		1164 -> 1166;
	1175 [label="Але повернемося до іншої версії тебе…",shape=box,color=blue];
		1175 -> 1176;
		1175 -> 1177;
	1165 [label="Я також не бачу цього.",shape=box,color=red];
