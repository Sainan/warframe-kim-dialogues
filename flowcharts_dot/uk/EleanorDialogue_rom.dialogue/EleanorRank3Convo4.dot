		1244 -> 1245;
	1251 [label="Я намагалася встановити з нею телепатичний зв’язок. Якщо ти можеш це робити, чому я не можу, так?",shape=box,color=blue];
		1251 -> 1252;
		1251 -> 1253;
	1249 [label="Насправді дізнавшись про твою альтернативну версію, я переконалася, що десь є ще одна я, яка вирішила стати черницею. Послідовниця Луа, голена голова, регулярні молитви та все таке інше.",shape=box,color=blue];
		1249 -> 1250;
