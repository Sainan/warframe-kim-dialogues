		j1690395513 -> j1608057576;
	j3754216078 [label="і, звичайно ж, випивка. багато випивки",shape=box,color=blue];
		j3754216078 -> j1357216192;
	j4082648485 [label="все моє єство — це мокре смердюче печиво з передчуттям, і передчуття говорить: «ти помреш на самоті, і тебе з’їдять твої коти»",shape=box,color=blue];
