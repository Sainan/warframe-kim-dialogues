		j4077665910 -> j3966226133;
	j1824855185 [label="у моєму мозку є щось, що минула елеонора не дозволяє мені поглянути",shape=box,color=blue];
		j1824855185 -> j259384429;
	j3801262195 [label="здається, у велимира була ідея, і він хотів, щоб усі підтримали його ідею",shape=box,color=blue];
		j3801262195 -> j1508238436;
