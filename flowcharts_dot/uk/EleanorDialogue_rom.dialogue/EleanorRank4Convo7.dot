	2025 [label="Ти абсолютно нестерпна людина.",shape=box,color=blue];
		2025 -> 2026;
	2028 [label="Вибач.",shape=box,color=blue];
		2028 -> 2035;
	2029 [label="Так.",shape=box,color=blue];
		2029 -> 2030;
	2026 [label="Я намагаюся вести абсолютно невинну розмову про батьків, без жодних прихованих мотивів, а ти береш і вибиваєш мене з колії.",shape=box,color=blue];
		2026 -> 2031;
