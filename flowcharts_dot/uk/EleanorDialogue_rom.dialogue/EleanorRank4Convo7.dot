digraph {
	1953 [label="EleanorRank4Convo7 begins.",color=orange];
		1953 -> 1954;
	1954 [label="Я хотіла спитати тебе про дещо, але я не впевнена, як ти це сприймеш, тому, якщо я перейду межу, то кажи.",shape=box,color=blue];
		1954 -> 1955;
	1955 [label="Гаразд.",shape=box,color=red];
		1955 -> 1956;
	1956 [label="Якими були твої батьки? ",shape=box,color=blue];
		1956 -> 1957;
		1956 -> 1958;
		1956 -> 1959;
		1956 -> 1960;
		1956 -> 1962;
	1957 [label="Це було так давно, що я ледве пам’ятаю.",shape=box,color=red];
		1957 -> 1963;
	1958 [label="Добрими. Вони намагалися зробити все, як треба.",shape=box,color=red];
		1958 -> 1965;
	1959 [label="Суворими. Вони були головними і дали мені це зрозуміти.",shape=box,color=red];
		1959 -> 1967;
	1960 [label="Безнадійними. З таким же успіхом мене могли б виховати дикі куброу.",shape=box,color=red];
		1960 -> 1972;
	1962 [label="Я… не можу про це говорити. Вибач. [Завершити розмову]",shape=box,color=red];
		1962 -> 1978;
	1963 [label="Мені шкода. Я нерозумно припустила, що оскільки твої спогади про «Заримен» були такими яскравими, ти зможеш згадати і своїх батьків.",shape=box,color=blue];
		1963 -> 1964;
	1965 [label="Я рада. Якщо ти не проти, що я так кажу, це помітно.",shape=box,color=blue];
		1965 -> 1966;
	1967 [label="Не думала, що у тебе було м’яке виховання. Гадаю, колоністи повинні бути жорсткими.",shape=box,color=blue];
		1967 -> 1970;
	1972 [label="О, боже. Що ж, хай там як, з тебе вийшла до біса пристойна людина.",shape=box,color=blue];
		1972 -> 1973;
	1978 [label="Ні, це ти вибач. Я не мала права запитувати.",shape=box,color=blue];
		1978 -> 1979;
	1964 [label="Я забула, скільки життів було прожито тобою.",shape=box,color=blue];
		1964 -> 1968;
	1966 [label="У тебе горить тепле полум’я доброти, і мені цікаво, хто допоміг його розпалити.",shape=box,color=blue];
		1966 -> 1969;
	1970 [label="Дивно, що з цими орокінами на чолі хоч хтось вийшов пристойним.",shape=box,color=blue];
		1970 -> 1971;
	1973 [label="Я лише бажаю, щоб тобі було легше.",shape=box,color=blue];
		1973 -> 1974;
	1979 [label="Chat ends.",color=orange];
	1968 [label="Update boolean DrifterParentsUnknown",color=orange];
		1968 -> 1980;
	1969 [label="Update boolean DrifterParentsKind",color=orange];
		1969 -> 1980;
	1971 [label="Update boolean DrifterParentsStrict",color=orange];
		1971 -> 1980;
	1974 [label="Update boolean DrifterParentsUseless",color=orange];
		1974 -> 1980;
	1980 [label="Чому ти питаєш?",shape=box,color=red];
		1980 -> 1981;
	1981 [label="Я думала про своїх. Насправді я часто це роблю. Я сиджу на дупі та думаю, що б подумали мама й тато про те, чим закінчили їхні діти.",shape=box,color=blue];
		1981 -> 1982;
		1981 -> 1983;
	1982 [label="Якими вони були людьми?",shape=box,color=red];
		1982 -> 1984;
	1983 [label="Якими вони були батьками?",shape=box,color=red];
		1983 -> 1985;
	1984 [label="Як люди, вони кардинально не підходили одне одному, а це означає, що в них були такі стосунки, які горять палко та яскраво перші кілька років, а потім провалюються в чорну діру, що засмоктує.",shape=box,color=blue];
		1984 -> 1986;
	1985 [label="Несумісні, одним словом. Тато хотів, щоб ми були незалежними, тому створював ситуації, в яких ми мали опинитися. Висадити нас у лісі з одним лише складаним ножем, і таке інше. Мама завжди приходила на допомогу. Це було безнадійно.",shape=box,color=blue];
		1985 -> 1987;
	1986 [label="Тато — колишній військовий. Бадьорий, з маленькими зморшкуватими очима, говорить як диктор новин, настільки зламаний зсередини, що якби його взяти на руки та потрясти, він би гримів, як мішок із гравієм. Я кидалася коментарями, які вважала м’якими, а потім почула, як він плакав у туалеті.",shape=box,color=blue];
		1986 -> 1988;
	1987 [label="Ми з Артуром швидко навчилися протиставляти їх одне проти одного. Ти ж знаєш, які діти.",shape=box,color=blue];
		1987 -> 1989;
	1988 [label="Мамина родина була багатшою, а це означало, що в неї не було обмежень. Вона не пішла шляхом вечірок, вина та наркотиків і тижневих запоїв у квартирах Людстона. Це була більше робота тітоньки Дженіс. Мама — це більше квіти, гончарні їжачки, ароматичні свічки та все, що було миле.",shape=box,color=blue];
		1988 -> 1990;
	1989 [label="Батьки завжди надмірно компенсують все, що, на їхню думку, їхні власні батьки зробили неправильно, чи не так?",shape=box,color=blue];
		1989 -> 1990;
	1990 [label="Половина з того, що ти говориш, для мене як мова Порожнечі, але, здається, я розумію.",shape=box,color=red];
		1990 -> 1991;
	1991 [label="Ну, тепер вони розлучені. Вони чекали, поки ми вийдемо з підліткового віку, щоб зробити це «безболісно». Це було дуже мило, тобі не здається? Змушувати нас жити на клятому полі бою, тому що дітям потрібна стабільність або ще якась подібна дурня.",shape=box,color=blue];
		1991 -> 1992;
	1992 [label="Ви все ще підтримуєте зв’язок?",shape=box,color=red];
		1992 -> 1993;
	1993 [label="Час від часу. Ми поверталися додому на День сонцестояння. Тепер я сумую за цим. Прикрашання зоряного дерева, коронація Сола, маленькі діти, що ходять по домівках, одягнені в три форми Луа, смаження птиці… це сентиментально, але я щиро люблю це.",shape=box,color=blue];
		1993 -> 1994;
	1994 [label="Мама й тато завжди укладали мирний договір на День сонцестояння і завжди його дотримувалися. У вдалий рік їм удавалося втриматися від того, щоб не розірвати одне одного до Третього дня, навіть коли сливове бренді текло річкою.",shape=box,color=blue];
		1994 -> 1995;
	1995 [label="Якщо ти відчуваєш, як тебе накрила величезна хвиля туги за домівкою, то це була я. Вибач.",shape=box,color=blue];
		1995 -> 1996;
	1996 [label="Я намагаюся тримати надмірні емоції при собі, але іноді вони просто закипають, як молоко в каструлі, і всі це помічають. Потім настає черга старої КІМ вибачатися.",shape=box,color=blue];
		1996 -> 1997;
	1997 [label="Навіщо згадувати їх зараз?",shape=box,color=red];
		1997 -> 1998;
	1998 [label="Мені просто цікаво, що вони про тебе подумають. Якщо ми коли-небудь виберемося звідси, я би хотіла завітати на вечерю в День сонцестояння з однією близькою мені часомандрівною особою.",shape=box,color=blue];
		1998 -> 1999;
	1999 [label="Думаю, тобі сподобається. Ви з татом і Артуром могли б сидіти біля вогню і розповідати історії про війну, а мама могла б обережно допитуватися чи в тебе є хтось.",shape=box,color=blue];
		1999 -> 2000;
		1999 -> 2001;
		1999 -> 2002;
		1999 -> 2003;
	2000 [label="Думаю, вони б були налякані.",shape=box,color=red];
		2000 -> 2016;
	2001 [label="Я буду поводитися якнайкраще, заради тебе.",shape=box,color=red];
		2001 -> 2017;
	2002 [label="Чесно кажучи, це звучить весело.",shape=box,color=red];
		2002 -> 2018;
	2003 [label="У мене хтось є? Зажди, я прийду до тебе додому партнером?",shape=box,color=red];
		2003 -> 2007;
	2016 [label="+15 Chemistry",color=orange];
		2016 -> 2004;
	2017 [label="+15 Chemistry",color=orange];
		2017 -> 2005;
	2018 [label="+15 Chemistry",color=orange];
		2018 -> 2006;
	2007 [label="Ем.",shape=box,color=blue];
		2007 -> 2011;
	2004 [label="ХА! Від цього мені ще більше хочеться це робити.",shape=box,color=blue];
		2004 -> 2008;
	2005 [label="Це так мило з твого боку!",shape=box,color=blue];
		2005 -> 2009;
	2006 [label="О боги, зробімо це. Якщо у нас коли-небудь з’явиться шанс, ми втілимо це в життя.",shape=box,color=blue];
		2006 -> 2010;
	2011 [label="Це стало поворотним моментом — сказала вона, обмахуючись віялом.",shape=box,color=blue];
		2011 -> 2015;
	2008 [label="Я так і бачу, як тато ввічливо запитує: «То це завжди була смерть через заколювання, чи вони намагалися її трохи урізноманітнити?»",shape=box,color=blue];
		2008 -> 2012;
	2009 [label="… Я повинна відпустити цю мрію, перш ніж намагатися втілити її в життя. Ми тут, зараз, і війна все ще триває.",shape=box,color=blue];
		2009 -> 2013;
	2010 [label="Дякую.",shape=box,color=blue];
		2010 -> 2014;
	2015 [label="Тобі б цього ХОТІЛОСЯ?",shape=box,color=blue];
		2015 -> 2022;
		2015 -> 2023;
		2015 -> 2024;
	2012 [label="Я буду мріяти про це. Дякую.",shape=box,color=blue];
		2012 -> 2019;
	2013 [label="Дякую за прекрасну мрію.",shape=box,color=blue];
		2013 -> 2020;
	2014 [label="Тепер у мене є ще одна річ, заради якої варто вставати з ліжка вранці.",shape=box,color=blue];
		2014 -> 2021;
	2022 [label="Чесно? Так.",shape=box,color=red];
		2022 -> 2033;
	2023 [label="Ні. Я просто не маю уявлення, що ти собі уявляєш.",shape=box,color=red];
		2023 -> 2027;
	2024 [label="Гм… Ми можемо до цього повернутися?",shape=box,color=red];
		2024 -> 2038;
	2019 [label="Chat ends.",color=orange];
	2020 [label="Chat ends.",color=orange];
	2021 [label="Chat ends.",color=orange];
	2033 [label="+20 Chemistry",color=orange];
		2033 -> 2025;
	2027 [label="Так.",shape=box,color=blue];
		2027 -> 2028;
	2038 [label="+5 Chemistry",color=orange];
