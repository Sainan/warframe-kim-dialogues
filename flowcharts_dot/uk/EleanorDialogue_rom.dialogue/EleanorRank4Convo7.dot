	2037 [label="У нас є час, і ніхто з нас нікуди не збирається, чи не так?",shape=box,color=blue];
		2037 -> 2039;
	2032 [label="Я збираюся з усією серйозністю розглянути це питання, на яку воно заслуговує. До біса.",shape=box,color=blue];
		2032 -> 2034;
	2039 [label="Chat ends.",color=orange];
