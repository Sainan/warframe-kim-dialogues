digraph {
	808 [label="EleanorRank3Convo1 begins.",color=orange];
		808 -> 809;
		808 -> 810;
	809 [label="Привіт, Елеоноро, чи можна запитати тебе про телепатію?",shape=box,color=red];
		809 -> 811;
	810 [label="Отже, як це — мати можливість зазирнути в чужі голови?",shape=box,color=red];
		810 -> 813;
	811 [label="Завжди можна запитати, якщо ти робиш це ввічливо.",shape=box,color=blue];
		811 -> 812;
	813 [label="Вибач, що?",shape=box,color=blue];
		813 -> 814;
	812 [label="Деяким людям це дається дуже важко.",shape=box,color=blue];
		812 -> 817;
		812 -> 818;
	814 [label="Ти думаєш, що я так роблю? Ненароком порушую приватність інших людей?",shape=box,color=blue];
		814 -> 815;
	817 [label="Ти чуєш думки людей без зусиль? Чи тобі завжди потрібно напружуватися, щоби проникнути в їхні голови?",shape=box,color=red];
		817 -> 819;
	818 [label="Це як вимикач світла? Або воно завжди «увімкнено»?",shape=box,color=red];
		818 -> 819;
	815 [label="Якщо ти так думаєш про мене, то навряд чи нам є про що говорити.",shape=box,color=blue];
		815 -> 816;
	819 [label="Обидва варіанти. Якщо я просто сиджу та «слухаю», я можу вловити внутрішні монологи та сильні почуття.",shape=box,color=blue];
		819 -> 820;
	816 [label="Chat ends.",color=orange];
	820 [label="Найважче, це фільтрувати ТЕ, про що я не хочу знати.",shape=box,color=blue];
		820 -> 821;
	821 [label="Я не завжди можу переживати почуття так, ніби вони належать комусь іншому. Чим менше вони вербальні, тим важче відрізнити «інших» від «мене».",shape=box,color=blue];
		821 -> 822;
	822 [label="Дозвіл на заглиблення у сферу «забагато інформації»?",shape=box,color=blue];
		822 -> 823;
		822 -> 824;
		822 -> 825;
	823 [label="Що ж, мені надто цікаво, щоб сказати «ні»…",shape=box,color=red];
		823 -> 827;
	824 [label="Дозвіл надано.",shape=box,color=red];
		824 -> 828;
	825 [label="Ем… наступного разу, мабуть. [Завершити розмову]",shape=box,color=red];
		825 -> 826;
	827 [label="Вітаю твою хоробрість.",shape=box,color=blue];
		827 -> 829;
	828 [label="Читай далі на свій страх і ризик.",shape=box,color=blue];
		828 -> 829;
	826 [label="Chat ends.",color=orange];
	829 [label="Невдовзі після того, як нам усім зробили щеплення «Ентраті», я подумала, що в мене якась вторинна інфекція сечового міхура. Я стрибала між диваном і туалетом як йо-йо. Я навіть змусила Летті вишукувати для мене журавлиний сік та мінеральну воду.",shape=box,color=blue];
		829 -> 830;
	830 [label="Виявилося, що я просто відчувала природні потреби шістьох людей. Моя нервова система, звичайно, припустила, що вони мої.",shape=box,color=blue];
		830 -> 831;
		830 -> 832;
	831 [label="Що було гірше? Дізнатися, що ти не була катастрофічно хвора чи…",shape=box,color=red];
		831 -> 833;
	832 [label="Мабуть, було полегшенням дізнатися правду.",shape=box,color=red];
		832 -> 834;
	833 [label="Ну, я і Є катастрофічно хвора. Називаймо речі своїми іменами. Але вже краще заразитися телепатією ніж нескінченним циститом.",shape=box,color=blue];
		833 -> 835;
	834 [label="Після того випадку я навчилася будувати стіни навколо свого розуму. Іноді Летті знаходить ліки, які можуть вимикати всю мою телепатію на декілька годин. У мене є заначка, але я не використовую їх, хіба що мені дуже-дуже потрібно поспати.",shape=box,color=blue];
		834 -> 835;
	835 [label="Це такий корисний талант, ось у чому проблема. Артур наполягає на тому, щоб розглядати це як стратегічну перевагу.",shape=box,color=blue];
		835 -> 836;
		835 -> 837;
	836 [label="Як щодо порушення приватності людей? Хіба це не погано для моралі?",shape=box,color=red];
		836 -> 838;
	837 [label="Але якщо хтось *не* захоче, аби в його голову вдиралися?",shape=box,color=red];
		837 -> 839;
	838 [label="Це до біса жахливо для моралі.",shape=box,color=blue];
		838 -> 840;
	839 [label="Навіть якщо я наполягатиму на тому, що можу це контролювати, думаєш, вони мені повірять?",shape=box,color=blue];
		839 -> 840;
	840 [label="Ми не м’якотілі. Ми звикли до суворого життя. Це місце як п’ятизірковий готель у порівнянні зі звичайною казармою британської армії.",shape=box,color=blue];
		840 -> 841;
	841 [label="Ви разом приймаєте душ, разом їсте і так далі. Ви звикаєте одне до одного. Ви мусите.",shape=box,color=blue];
		841 -> 842;
	842 [label="Але, як сказав би Артур, є певна межа.",shape=box,color=blue];
		842 -> 843;
	843 [label="Тож, як ти справляєшся з цим?",shape=box,color=red];
		843 -> 844;
	844 [label="Я просто не кажу їм, як багато з їхнього внутрішнього життя я чую, бачу та відчуваю. Я не приходжу в гості без запрошення, що б там не думала Летті.",shape=box,color=blue];
		844 -> 845;
	845 [label="Іноді в когось із них з’являється думка, і він одразу ж думає: «Чи вона чула, що я про це подумав?» Краще дозволити їм гадати. Те, чого вони не знають, не може їм зашкодити.",shape=box,color=blue];
		845 -> 846;
		845 -> 847;
	846 [label="Ти можеш підслухати якісь МОЇ думки?",shape=box,color=red];
		846 -> 848;
	847 [label="Отже… що ти дізналася в моїй голові?",shape=box,color=red];
		847 -> 848;
	848 [label="Як я вже сказала, Я не збираюся нічого підтверджувати чи заперечувати.",shape=box,color=blue];
		848 -> 849;
	849 [label="Я маю сказати прямо зараз, є ще одна важлива причина, чому я тримаю це лайно при собі.",shape=box,color=blue];
		849 -> 851;
	851 [label="Давай…",shape=box,color=red];
		851 -> 850;
	850 [label="Отже. Артур і я. Ми на вулицях, налітаємо на сховок «Скальдри», і він серйозно не в своїй тарілці. Він не стріляє влучно, їздить, як п’яна качка, він навіть не може впоратися з мечем.",shape=box,color=blue];
		850 -> 852;
	852 [label="Звичайно, я кажу йому зібратися. Він одразу починає звинувачувати МЕНЕ. Каже мені, що я завжди поводжуся зверхньо, хіба я не розумію тиск командування, якби я мала уявлення, з чим йому доводиться стикатися ЩОДНЯ, я б уже загнулася, і все це жалісливе лайно.",shape=box,color=blue];
		852 -> 853;
	853 [label="Check boolean EleanorHeroVirus",color=orange];
		853 -> 854 [label=true,color=green];
		853 -> 855 [label=false,color=brown];
	854 [label="Пам’ятаєш про «Вірус героя», про який я розповідала?",shape=box,color=blue];
		854 -> 856;
	855 [label="У мене є теорія, яку я називаю «Вірусом героя».",shape=box,color=blue];
		855 -> 858;
	856 [label="Клінічний випадок.",shape=box,color=blue];
		856 -> 857;
	858 [label="Маленькі хлопчики вбивають собі в голову, що історії, якими їх годують, — це те, як насправді влаштований світ. Вони думають, що вони герої, і все обертається навколо них.",shape=box,color=blue];
		858 -> 859;
	857 [label="Усе було про Артура.",shape=box,color=blue];
		857 -> 861;
	859 [label="У Артура один із найгірших випадків «Вірусу героя», який я коли-небудь бачила.",shape=box,color=blue];
		859 -> 860;
	861 [label="Тож я відповідаю йому: «ти ж знаєш, що я розумію, коли ти думаєш про Аой?»",shape=box,color=blue];
		861 -> 862;
	860 [label="Update boolean EleanorHeroVirus",color=orange];
		860 -> 861;
	862 [label="Йой.",shape=box,color=red];
		862 -> 863;
	863 [label="Ага.",shape=box,color=blue];
		863 -> 864;
	864 [label="Не пишаюся цим моментом.",shape=box,color=blue];
		864 -> 865;
	865 [label="Навіть якби він не був моїм братом, це був паскудний вчинок. Я більше ніколи цього не зроблю.",shape=box,color=blue];
		865 -> 866;
	866 [label="І як він відреагував?",shape=box,color=red];
		866 -> 867;
	867 [label="… Мені не подобається, що ти хочеш знати.",shape=box,color=blue];
		867 -> 868;
	868 [label="Тепер мені цікаво, чи подобається тобі думка про приниження Артура.",shape=box,color=blue];
		868 -> 869;
	869 [label="Будь ласка, не дозволяй цьому статися. Ти починаєш мені подобатися, але це те, через що я б не змогла переступити.",shape=box,color=blue];
		869 -> 870;
		869 -> 871;
		869 -> 872;
	870 [label="Я питаю, бо мені подобається цей хлопець.",shape=box,color=red];
		870 -> 873;
	871 [label="Ой. Це не було моїм наміром. Мені просто цікаво, як така людина реагує на те, що йому протистоять.",shape=box,color=red];
		871 -> 875;
	872 [label="Мені подобається ця думка. Схоже, Артур сам напросився.",shape=box,color=red];
		872 -> 877;
	873 [label="Добре. Це зрозуміло. Вибач, що зірвалася.",shape=box,color=blue];
		873 -> 874;
	875 [label="Я не просто протистояла йому. Я завдала йому болю.",shape=box,color=blue];
		875 -> 876;
	877 [label="О, я зрозуміла.",shape=box,color=blue];
		877 -> 878;
	874 [label="Він знітився. Я почувалася жахливо.",shape=box,color=blue];
		874 -> 879;
	876 [label="Артур звик до того, що йому відповідають. Тільки подивись на Квінсі!",shape=box,color=blue];
		876 -> 880;
	878 [label="Артур — як скалка в дупі.",shape=box,color=blue];
		878 -> 881;
	879 [label="Я зламала щось важливе між нами. Зажди. Я маю дещо сказати для розуміння.",shape=box,color=blue];
		879 -> 885;
	880 [label="Але всі ми знаємо, що в Артура міцні стіни. Він поводиться так, ніби його неможливо скривдити.",shape=box,color=blue];
		880 -> 884;
	881 [label="Але коли я намагаюся поговорити з тобою про те, за що відчуваю провину…",shape=box,color=blue];
		881 -> 882;
	885 [label="Коли ми були малими, якісь старші хлопці вкрали в Артура улюбленого солдатика, Анґуса. І кинули його в багаття Сонцестояння.",shape=box,color=blue];
		885 -> 886;
	884 [label="Я відчула, наскільки він був шокований і збентежений. Він думав, що зі мною він у безпеці. Але вже ні.",shape=box,color=blue];
		884 -> 893;
	882 [label="Не зважай.",shape=box,color=blue];
		882 -> 883;
	886 [label="Я все ще бачу, як він нахилився над ним, а пластик тілесного кольору булькає та капає на його камуфляжні штани.",shape=box,color=blue];
		886 -> 887;
		886 -> 888;
	893 [label="Check boolean DrifterSiblingYes",color=orange];
		893 -> 895 [label=true,color=green];
		893 -> 894 [label=false,color=brown];
	883 [label="Chat ends.",color=orange];
	887 [label="Я не сумую за дитинством.",shape=box,color=red];
		887 -> 889;
	888 [label="О так, дитинство.",shape=box,color=red];
		888 -> 889;
	895 [label="Я знаю, як це — скривдити брата чи сестру. У мене… колись була.",shape=box,color=red];
		895 -> 897;
	894 [label="Check boolean DrifterSiblingNo",color=orange];
		894 -> 895 [label=true,color=green];
		894 -> 896 [label=true,color=green];
		894 -> 895 [label=false,color=brown];
		894 -> 896 [label=false,color=brown];
	889 [label="Хлопці сміялися і сказали Артуру, що він має радіти. Боєць Ангус вирушив до Зали героїв на свято Зимового сонцестояння, як колись робили воїни. Я хотіла їх вбити. Маленькі виродки.",shape=box,color=blue];
		889 -> 890;
	897 [label="Update boolean DrifterSiblingYes",color=orange];
		897 -> 898;
	896 [label="Схоже, ти його сильно образила.",shape=box,color=red];
		896 -> 900;
	890 [label="Артур не хотів, щоб хлопці бачили, як він плаче, і він не хотів плакати перед батьком, тож єдиною людиною, яка залишилася, була я. Його гівняна старша сестра.",shape=box,color=blue];
		890 -> 891;
	898 [label="Це жахливо, чи не так? Ти так звикаєш до цього ритуалу, принижувати одне одного, пускати шпильки та огризатися…",shape=box,color=blue];
		898 -> 899;
	900 [label="Так і є. Я перепросила, пообіцяла, що більше ніколи не буду робити нічого подібного, але все одно почуваюся лайном через це.",shape=box,color=blue];
		900 -> 901;
	891 [label="Я розповідаю тобі про це тому, що саме тут Артур пішов, у своїй голові. Він пам’ятав, що відчував себе в безпеці, коли міг поплакати переді мною, якщо йому це було ПОТРІБНО, а тепер?",shape=box,color=blue];
		891 -> 892;
	899 [label="Це майже заспокоює. А потім одного дня ти пускаєш кров і не можеш це зупинити.",shape=box,color=blue];
		899 -> 901;
	901 [label="Це нечесна гра.",shape=box,color=red];
		901 -> 902;
	892 [label="Тепер це вже не безпечно.",shape=box,color=blue];
		892 -> 893;
	902 [label="ТАК.",shape=box,color=blue];
		902 -> 903;
	903 [label="Ти це РОЗУМІЄШ. Я в захваті! Нечесна гра.",shape=box,color=blue];
		903 -> 904;
	904 [label="Знаєш, як буває, коли ти з кимось сперечаєшся, а коли все закінчується, ти думаєш, що саме потрібно було сказати?",shape=box,color=blue];
		904 -> 905;
	905 [label="Мені це більше не потрібно. Тепер у мене є чарівна кнопка «Я виграла». Все, що мені потрібно зробити, це зазирнути в їхній мозок, вихопити те, чого вони найбільше соромляться, і ткнути цим у лице.",shape=box,color=blue];
		905 -> 906;
	906 [label="І я НЕ МОЖУ це робити, попри те, як сильно я цього хочу. Тому що я маю бути «хорошою людиною».",shape=box,color=blue];
		906 -> 907;
		906 -> 908;
	907 [label="Справа не в тому, щоб намагатися бути святою, Елеоноро. Навіть не в тому, щоби бути героєм. Це просто не бути засранцем.",shape=box,color=red];
		907 -> 909;
	908 [label="Ми всі тут намагаємося робити правильні речі. Чи справді це так важко для тебе?",shape=box,color=red];
		908 -> 910;
	909 [label="У всіх нас є межі, які ми не перетинаємо, і це одна з них. Я це поважаю.",shape=box,color=red];
		909 -> 912;
	910 [label="О боже. Це те, що я отримую за те, що виставляю напоказ свої чесноти, чи не так?",shape=box,color=blue];
		910 -> 911;
	912 [label="Дякую.",shape=box,color=blue];
		912 -> 913;
	911 [label="Вибач. Я очікувала співчуття. Але я повернуся до реальності.",shape=box,color=blue];
		911 -> 914;
	913 [label="Я не шукаю співчуття. Справді.",shape=box,color=blue];
		913 -> 915;
	914 [label="Я ж не єдина, хто повинна тримати свої сили під контролем, чи не так? Ми всі — бомби сповільненої дії, що чекають на вибух.",shape=box,color=blue];
		914 -> 920;
	915 [label="Я просто хотіла розуміння від когось. Чесно кажучи, я трохи вражена тим, як багато ти розумієш.",shape=box,color=blue];
		915 -> 916;
	920 [label="+10 Chemistry",color=orange];
		920 -> 919;
	916 [label="Не обов’язково було це все читати. Але я рада, що ми поговорили.",shape=box,color=blue];
		916 -> 917;
	919 [label="Дякую за розмову.",shape=box,color=blue];
		919 -> 921;
	917 [label="Це безладне фрік-шоу всередині мого черепа. Гадаю, ти розумієш, чому я не запрошую на чай будь-якого незнайомця.",shape=box,color=blue];
		917 -> 922;
	921 [label="Chat ends.",color=orange];
	922 [label="+20 Chemistry",color=orange];
		922 -> 918;
	918 [label="Я очікую, що люди будуть тікати з криками. Але не ти. Поки що. Цікаво чому. Дякую. Ще раз. За все.",shape=box,color=blue];
		918 -> 923;
	923 [label="Chat ends.",color=orange];
}