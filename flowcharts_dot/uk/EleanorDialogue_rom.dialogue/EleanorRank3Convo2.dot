		926 -> 927 [label=false,color=brown];
	925 [label="Ти тут? Мені треба поговорити.",shape=box,color=blue];
		925 -> 928;
		925 -> 929;
	927 [label="Ти тут? Мені треба поговорити про дещо. Це серйозно.",shape=box,color=blue];
		927 -> 931;
		927 -> 929;
	928 [label="Прямо тут.",shape=box,color=red];
		928 -> 932;
	929 [label="Дуже шкода. Не зараз. [Завершити розмову]",shape=box,color=red];
		929 -> 930;
	931 [label="Я тут. Уперед.",shape=box,color=red];
		931 -> 933;
	932 [label="Пам’ятаєш, я розповідала тобі, як я намагалася доторкнутися до розуму Русалки, а натомість зв’язалася з Байдужістю?",shape=box,color=blue];
		932 -> 935;
	930 [label="Chat ends.",color=orange];
	933 [label="Дякую.",shape=box,color=blue];
		933 -> 934;
	935 [label="Звичайно, я пам’ятаю.",shape=box,color=red];
		935 -> 938;
	934 [label="Ти розумієш, що сталося з майоркою Русалкою?",shape=box,color=blue];
		934 -> 936;
		934 -> 937;
	938 [label="Добре. Я не була готова говорити про це тоді. Але зараз я готова, якщо ти хочеш.",shape=box,color=blue];
		938 -> 945;
	936 [label="Її використали. Байдужість маніпулювала нею.",shape=box,color=red];
		936 -> 939;
	937 [label="Маю впевненість, що її спустошили та керували нею, як… ну… ворфреймом?..",shape=box,color=red];
		937 -> 940;
	945 [label="Якщо ти впевнена.",shape=box,color=red];
		945 -> 946;
	939 [label="«Байдужість». Так ти це називаєш?",shape=box,color=blue];
		939 -> 941;
	940 [label="Спустошили, так.",shape=box,color=blue];
		940 -> 942;
	946 [label="Я впевнена.",shape=box,color=blue];
		946 -> 947;
	941 [label="Дякую.",shape=box,color=blue];
		941 -> 943;
	942 [label="Але те, що нею керувало, не було схоже на тебе.",shape=box,color=blue];
		942 -> 944;
	947 [label="Це створіння, ця присутність — це те, чому ми, зрештою, протистоїмо. Тепер я багато чого знаю.",shape=box,color=blue];
		947 -> 951;
	943 [label="Даючи йому ім’я, я відчуваю, що повернула собі крихітну частку контролю.",shape=box,color=blue];
		943 -> 948;
	944 [label="Усе людське в цьому було схоже на глузування.",shape=box,color=blue];
		944 -> 949;
	951 [label="Будь ласка, скажи мені правду. Ти віриш, що є якась надія?",shape=box,color=blue];
		951 -> 956;
		951 -> 957;
		951 -> 958;
	948 [label="Я торкнулася тієї штуки своїм розумом. Я думала, що я досліджую свідомість Русалки, але… зовнішні шари просто провалилися, як мокрий, пористий гіпсокартон, і тоді я занурилася у це. Борсалася.",shape=box,color=blue];
		948 -> 950;
	949 [label="Вона була такою ж людиною, як і манекен у магазині. Зі шматків.",shape=box,color=blue];
		949 -> 952;
	956 [label="На цей момент?… Ні.",shape=box,color=red];
		956 -> 960;
	957 [label="Чесно? Я… не знаю.",shape=box,color=red];
		957 -> 961;
	958 [label="Так, я вірю.",shape=box,color=red];
		958 -> 962;
	950 [label="Update boolean EleanorIndifference",color=orange];
		950 -> 951;
	952 [label="Я доторкнулася до цього, розумієш. Своїм розумом. Я намагалася намацати її, але її там не було.",shape=box,color=blue];
		952 -> 953;
	960 [label="Принаймні, це було чесно.",shape=box,color=blue];
		960 -> 963;
	961 [label="Я розумію.",shape=box,color=blue];
		961 -> 964;
	962 [label="Не кажи мені, чому.",shape=box,color=blue];
		962 -> 965;
	953 [label="Я знаю, що ти маєш на увазі. Ми називаємо це Байдужістю.",shape=box,color=red];
		953 -> 954;
	963 [label="Гаразд. Нехай надія помре.",shape=box,color=blue];
		963 -> 966;
	964 [label="Ми стільки всього не знаємо.",shape=box,color=blue];
		964 -> 967;
	965 [label="Просто тримайся цієї віри. Дай мені її відчути.",shape=box,color=blue];
		965 -> 968;
	954 [label="Дякую.",shape=box,color=blue];
		954 -> 955;
	966 [label="Я буду продовжувати боротися з чистою, хай йому грець, упевненістю.",shape=box,color=blue];
		966 -> 969;
	967 [label="Після того, що сталося цього року, як ми можемо знову будувати адекватні плани?",shape=box,color=blue];
		967 -> 970;
	968 [label="Прошу.",shape=box,color=blue];
		968 -> 971;
	955 [label="Даючи йому ім’я, я відчуваю, що повернула собі крихітну частку контролю.",shape=box,color=blue];
		955 -> 959;
	969 [label="Ненависть. Злість. Що завгодно.",shape=box,color=blue];
		969 -> 973;
	970 [label="Можливо, надія — це омана. Я не знаю.",shape=box,color=blue];
		970 -> 974;
	971 [label="Я торкнулася Русалки, і це було так, ніби мої пальці торкнулися її обличчя і пройшли наскрізь. Маска просто розвалилася.",shape=box,color=blue];
		971 -> 975;
	959 [label="Update boolean EleanorIndifference",color=orange];
		959 -> 972;
	973 [label="Краще ніж апатія. Краще, ніж покірна капітуляція.",shape=box,color=blue];
		973 -> 978;
	974 [label="Мені б зараз не завадило трохи.",shape=box,color=blue];
		974 -> 977;
	975 [label="Те, що було під нею, було схоже на…",shape=box,color=blue];
		975 -> 976;
	972 [label="Я торкнулася тієї штуки своїм розумом. Я думала, що я досліджую свідомість Русалки, але… зовнішні шари просто провалилися, як мокрий, пористий гіпсокартон, і тоді я занурилася у це. Борсалася.",shape=box,color=blue];
		972 -> 976;
	978 [label="Я готова.",shape=box,color=blue];
		978 -> 979;
	977 [label="Ну що ж. Ось і все. Якщо ми шкандибаємо далі в темряві, принаймні в товаристві один одного.",shape=box,color=blue];
		977 -> 980;
	976 [label="Є така назва. «Тропічна лихоманка». Це свого роду божевілля, яке раніше вражало моряків. Вони були переконані, що зелене море навколо — це зовсім не вода, а зелена трава.",shape=box,color=blue];
		976 -> 981;
	979 [label="Chat ends.",color=orange];
	980 [label="Chat ends.",color=orange];
	981 [label="Вони були змушені стрибати з корабля на прекрасні зелені луки та бігти по них. Якщо їх стримували товариші по плаванню, вони билися.",shape=box,color=blue];
		981 -> 982;
	982 [label="Я стрибнула, очікуючи на траву. Наступної секунди я опинилася з головою в крижаній темряві.",shape=box,color=blue];
		982 -> 983;
	983 [label="Update boolean EleanorIndifference2",color=orange];
		983 -> 984;
		983 -> 986;
	984 [label="Я не думаю, що для тебе безпечно говорити про це ось так.",shape=box,color=red];
		984 -> 985;
	986 [label="Я тут. Продовжуй.",shape=box,color=red];
		986 -> 987;
	985 [label="От лайно.",shape=box,color=blue];
		985 -> 988;
	987 [label="Таке відчуття неможливо описати словами. Ти дивишся на світ і просто ЗНАЄШ, що вся буденність — будівлі, машини, люди, роботи, рутина — це лише тонка скоринка над бездонним жахом, і якби люди колись усвідомили це, вони б почали кричати та не зупинилися ніколи.",shape=box,color=blue];
		987 -> 989;
	988 [label="Мені майже вдалося налаштувати себе на це, а тепер що? Не згадувати диявола, щоб не прикликати його?",shape=box,color=blue];
		988 -> 990;
	989 [label="Я провалилася крізь скоринку.",shape=box,color=blue];
		989 -> 992;
	990 [label="Якщо почуєш крики серед ночі, то це я.",shape=box,color=blue];
		990 -> 991;
	992 [label="Це не була пустота. Я могла би це витримати. Це тривало і тривало вічно, але це був не просто холодний космос. Щось там було зі мною.",shape=box,color=blue];
		992 -> 993;
		992 -> 994;
		992 -> 995;
	991 [label="Chat ends.",color=orange];
	993 [label="Око?",shape=box,color=red];
		993 -> 997;
	994 [label="Людина, застрягла в стіні?",shape=box,color=red];
		994 -> 997;
	995 [label="Що це було?",shape=box,color=red];
		995 -> 996;
	997 [label="Я не знаю. Але воно знало, що я там. Воно ЗНАЛО про мене. Як слон помічає муху, що повзе через його око.",shape=box,color=blue];
		997 -> 998;
	996 [label="+5 Chemistry",color=orange];
		996 -> 997;
	998 [label="Пам’ятаю, я подумала: «ніщо настільки велике не повинно знати про моє існування».",shape=box,color=blue];
		998 -> 999;
	999 [label="Було відчуття повної зневаги до мене, такої монументальної байдужості, що я хотіла перестали існувати на місці.",shape=box,color=blue];
		999 -> 1000;
		999 -> 1001;
	1000 [label="Воно… так робить.",shape=box,color=red];
		1000 -> 1002;
	1001 [label="Що ти зробила?",shape=box,color=red];
		1001 -> 1002;
	1002 [label="Гадаю, я могла би впоратися, якби воно мене ненавиділо. Тоді б я мала якусь цінність, якесь значення. Але воно бачило мене безглуздим, і я бачила все, що бачить воно. Я була цяткою. Нічим.",shape=box,color=blue];
		1002 -> 1003;
	1003 [label="Усе, чим я колись була, кожна мить ніжності, кожен сміх, кожна частинка Елеонори Найтінґейл вилетіло в трубу.",shape=box,color=blue];
		1003 -> 1004;
	1004 [label="Воно відчуло, як моє світло згасає, і я присягаюся, що крихітний трепет задоволення пройшов крізь нього. Ніби йому було приємно розчавити мене. Як блоху під нігтем.",shape=box,color=blue];
		1004 -> 1005;
	1005 [label="Але ти повернулася, чи не так? Ти все ще тут. Ти довела, що воно помиляється.",shape=box,color=red];
		1005 -> 1006;
	1006 [label="Хіба?",shape=box,color=blue];
		1006 -> 1007;
	1007 [label="Воно все ще там, хіба ні?",shape=box,color=blue];
		1007 -> 1008;
		1007 -> 1009;
	1008 [label="Це так. Але ти також ще тут.",shape=box,color=red];
		1008 -> 1011;
	1009 [label="Зірки не перестають горіти лише тому, що космос великий, холодний і темний.",shape=box,color=red];
		1009 -> 1010;
	1011 [label="Зрештою, Байдужість перемагає, дружаньо, скільки б банальностей ми не кидали в безодню.",shape=box,color=blue];
		1011 -> 1012;
	1010 [label="Але вони перестануть горіти. Одного дня. Теплова смерть Всесвіту.",shape=box,color=blue];
		1010 -> 1011;
	1012 [label="У цьому й проблема, щоб не збожеволіти. Це прокляття мислити ясно.",shape=box,color=blue];
		1012 -> 1013;
	1013 [label="Ти знаєш, про що я говорю. Можна було б розбитися, як випавше яйце з гнізда, чи випалити собі мозок наркотиками до втрати почуттів. Але це було б не так боляче, як знати… це.",shape=box,color=blue];
		1013 -> 1014;
	1014 [label="Не розумію, чому ти й досі підтримуєш цю розмову.",shape=box,color=blue];
		1014 -> 1015;
		1014 -> 1016;
	1015 [label="Я розумію ентропію. Можливо, Велика Байдужість — це те ж саме. Можливо, вона зрештою й переможе. Не знаю. Та впевнено можу сказати лише те — Я НЕ ДАМ ПЕРЕМОГТИ ЗАРАЗ!",shape=box,color=red];
		1015 -> 1017;
	1016 [label="Я чекаю, коли ти, трясця, визначишся. Хочеш піти легким шляхом і з’їхати з глузду? Чи покинеш диванні війська й боротимешся?",shape=box,color=red];
		1016 -> 1018;
	1017 [label="Ми вціліємо тут разом… якщо вціліємо взагалі…",shape=box,color=red];
		1017 -> 1020;
	1018 [label="БОРОТИСЯ",shape=box,color=blue];
		1018 -> 1019;
	1020 [label="Отже, ти терпиш мої волання екзистенційного відчаю як бойову тактику? Це дуже в дусі Артура.",shape=box,color=blue];
		1020 -> 1021;
	1019 [label="ЦЕ ВСЕ, ЩО ВИ З АРТУРОМ РОЗУМІЄТЕ? БОРОТИСЯ?",shape=box,color=blue];
		1019 -> 1022;
	1021 [label="Насправді, віриш ти мені чи ні, я дбаю про тебе.",shape=box,color=red];
		1021 -> 1027;
	1022 [label="ВАША ВІДПОВІДЬ НА ГЛИБИННУ БЕЗГЛУЗДІСТЬ ІСНУВАННЯ — «ЗНАЙТИ СПОСІБ ПРОБИТИ ЇЇ»?",shape=box,color=blue];
		1022 -> 1023;
	1027 [label="Я дбаю про тебе теж, дружаньо. Ми союзники. Ми багато чого пережили.",shape=box,color=blue];
		1027 -> 1028;
	1023 [label="Не можу повірити, що я думала, ніби в нас є щось спільне.",shape=box,color=blue];
		1023 -> 1024;
	1028 [label="Буде справедливо попередити тебе, що славний кораблик «Елеонора» може піти на дно, або в кривавому морі, або в чорному як ніч болоті, і ти не захочеш опинитися на його борту, коли це станеться.",shape=box,color=blue];
		1028 -> 1030;
	1024 [label="Я почуваюся обдуреною.",shape=box,color=blue];
		1024 -> 1025;
	1030 [label="+20 Chemistry",color=orange];
		1030 -> 1029;
	1025 [label="Update boolean EleanorNoDate",color=orange];
		1025 -> 1026;
	1029 [label="Дякую. Тобі вже час іти. Зі мною все буде добре. Чесно.",shape=box,color=blue];
		1029 -> 1031;
	1026 [label="Chat ends.",color=orange];
	1031 [label="Chat ends.",color=orange];
}