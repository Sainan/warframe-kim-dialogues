digraph {
	2845 [label="EleanorRank6Convo2 begins.",color=orange];
		2845 -> 2846;
	2846 [label="Агов. Хочу поділитися з тобою деякими ідеями.",shape=box,color=blue];
		2846 -> 2847;
	2847 [label="Я тут думала про Диявольську ніч. Роками не вбиралася на неї, але гортала один із коміксів Аміра і раптом подумала — зачекайте, я ж можу бути Графинею! Я маю ікла і все таке інше!",shape=box,color=blue];
		2847 -> 2848;
	2848 [label="Але чи не занадто це очевидно? Чи мені варто бути Денді Дамбером?",shape=box,color=blue];
		2848 -> 2849;
		2848 -> 2850;
		2848 -> 2851;
	2849 [label="Хто такий Денді Дамбер?",shape=box,color=red];
		2849 -> 2852;
	2850 [label="Ти завжди можеш убратися як Лотос, якщо хочеш збити людей із пантелику.",shape=box,color=red];
		2850 -> 2853;
	2851 [label="Тобі доведеться розповісти мені, що таке та «Диявольська ніч».",shape=box,color=red];
		2851 -> 2854;
	2852 [label="О, друже. ",shape=box,color=blue];
		2852 -> 2855;
	2853 [label="О боги, ні. Я бачила її у твоїй голові. Я ніколи не буду гідною цього.",shape=box,color=blue];
		2853 -> 2856;
	2854 [label="М-м-м. Я інколи забуваю, що ти не звідси. ",shape=box,color=blue];
		2854 -> 2857;
	2855 [label="Денді Дамбер ішов, щоб «Храм і женці» могли бігти. Він був нічним кошмаром кожної матері та омріяною катастрофою кожного підлітка.",shape=box,color=blue];
		2855 -> 2858;
	2856 [label="І цей шолом. Це шолом? Чи частина неї? Як вона бачить крізь нього?",shape=box,color=blue];
		2856 -> 2859;
	2857 [label="Диявольська ніч відзначає згасання променів Сола в цьому світі.",shape=box,color=blue];
		2857 -> 2860;
	2858 [label="Статурою як паличник, загримований, як королева німого кіно. Рот як цукерка. Смужки та шкіра, собачий нашийник. Вилиці — як стегна скелета.",shape=box,color=blue];
		2858 -> 2861;
		2858 -> 2862;
	2859 [label="У будь-якому разі, їх троє в одному тілі. Я б ніколи не змогла вибрати одну з них.",shape=box,color=blue];
		2859 -> 2861;
		2859 -> 2862;
	2860 [label="На перший погляд це не має особливого сенсу. Навіщо святкувати настання темряви? Навіщо радіти беззаконню та анархії?",shape=box,color=blue];
		2860 -> 2863;
	2861 [label="Убратися в костюми? Вечірка? У зоні бойових дій? Ти справді думаєш, що це можливо?",shape=box,color=red];
		2861 -> 2864;
	2862 [label="Знаєш, Диявольська ніч дуже схожа на Наберову ніч. Людям теж подобається вбиратися так.",shape=box,color=red];
		2862 -> 2864;
	2863 [label="Я думаю, що це щось на кшталт щеплення. Крихітний шматочок того, чого ми боїмося, але що зміцнить нас. А, може, це просто привід надягнути маску диявола та влаштувати пекло.",shape=box,color=blue];
		2863 -> 2861;
		2863 -> 2862;
	2864 [label="Напевне, я просто клею дурня. По-дитячому. Хіба ні?",shape=box,color=blue];
		2864 -> 2865;
	2865 [label="Ох, про що я тільки думала.",shape=box,color=blue];
		2865 -> 2866;
	2866 [label="Мені не потрібно вбиратися, чи не так? Я вже монстр. Назавжди і безповоротно.",shape=box,color=blue];
		2866 -> 2867;
	2867 [label="Check boolean EleanorDating",color=orange];
		2867 -> 2868 [label=true,color=green];
		2867 -> 2869 [label=true,color=green];
		2867 -> 2870 [label=true,color=green];
		2867 -> 2869 [label=false,color=brown];
		2867 -> 2870 [label=false,color=brown];
	2868 [label="Ти монстр, якого я люблю, Елеоноро. Я ні про що не шкодую.",shape=box,color=red];
		2868 -> 2871;
	2869 [label="Я починаю думати, що тобі подобається говорити так про себе.",shape=box,color=red];
		2869 -> 2872;
	2870 [label="Ні. Справжні монстри не піклуються про людей так, як ти.",shape=box,color=red];
		2870 -> 2873;
	2871 [label="+5 Chemistry",color=orange];
		2871 -> 2874;
	2872 [label="Якщо ти дійсно вважаєш себе такої, то Диявольська ніч — ідеальна нагода відсвяткувати це.",shape=box,color=red];
		2872 -> 2875;
		2872 -> 2873;
	2873 [label="Я знаю, що ти боїшся того, ким можеш стати. Але ЗАРАЗ ти не така.",shape=box,color=red];
		2873 -> 2876;
	2874 [label="О, так! Дурненька я. Я забула, що монстру випав щасливий кінець у нашій маленькій історії.",shape=box,color=blue];
		2874 -> 2877;
	2875 [label="БУДЬ монстром. Володій ним. У цю єдину ніч у році носи це звання з гордістю.",shape=box,color=red];
		2875 -> 2878;
	2876 [label="Тож одягайся. Розважайся. Бачить Порожнеча, Прокльону це не завадить.",shape=box,color=red];
		2876 -> 2879;
	2877 [label="Пробач. Я все ще не можу повірити, що це те, чого ти насправді ХОЧЕШ. Можливо, мені просто потрібно трохи більше переконливості.",shape=box,color=blue];
		2877 -> 2880;
	2878 [label="Ох, існує так БАГАТО причин, чому це ЖАХЛИВА ІДЕЯ",shape=box,color=blue];
		2878 -> 2881;
	2879 [label="Ловлю на слові. І дякую. Ще раз. x",shape=box,color=blue];
		2879 -> 2882;
	2880 [label="Посмакуємо одне одним пізніше. xxx",shape=box,color=blue];
		2880 -> 2883;
	2881 [label="ТАК. БАГАТО.",shape=box,color=blue];
		2881 -> 2884;
	2882 [label="Chat ends.",color=orange];
	2883 [label="Chat ends.",color=orange];
	2884 [label="(не можу пригадати жодної просто зараз, але впевнена, що їх ДЕСЯТКИ)",shape=box,color=blue];
		2884 -> 2885;
	2885 [label="Дідько.",shape=box,color=blue];
		2885 -> 2886;
	2886 [label="я дуже спритно підчепилася на власний гачок. чорт забирай, молодець. x",shape=box,color=blue];
		2886 -> 2887;
	2887 [label="Chat ends.",color=orange];
}