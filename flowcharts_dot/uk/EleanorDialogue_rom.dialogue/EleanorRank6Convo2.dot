digraph {
	"EleanorRank6Convo2 begins." [color=orange];
		"EleanorRank6Convo2 begins." -> j1598378763;
	j1598378763 [label="Агов. Хочу поділитися з тобою деякими ідеями.",shape=box,color=blue];
		j1598378763 -> j2016910820;
	j2016910820 [label="Я тут думала про Диявольську ніч. Роками не вбиралася на неї, але гортала один із коміксів Аміра і раптом подумала — зачекайте, я ж можу бути Графинею! Я маю ікла і все таке інше!",shape=box,color=blue];
		j2016910820 -> j3639441975;
	j3639441975 [label="Але чи не занадто це очевидно? Чи мені варто бути Денді Дамбером?",shape=box,color=blue];
		j3639441975 -> j3755509021;
		j3639441975 -> j931703514;
		j3639441975 -> j1085312693;
	j3755509021 [label="Хто такий Денді Дамбер?",shape=box,color=red];
		j3755509021 -> j803487597;
	j931703514 [label="Ти завжди можеш убратися як Лотос, якщо хочеш збити людей із пантелику.",shape=box,color=red];
		j931703514 -> j757455826;
	j1085312693 [label="Тобі доведеться розповісти мені, що таке та «Диявольська ніч».",shape=box,color=red];
		j1085312693 -> j2638809087;
	j803487597 [label="О, друже. ",shape=box,color=blue];
		j803487597 -> j1639412446;
	j757455826 [label="О боги, ні. Я бачила її у твоїй голові. Я ніколи не буду гідною цього.",shape=box,color=blue];
		j757455826 -> j2321691415;
	j2638809087 [label="М-м-м. Я інколи забуваю, що ти не звідси. ",shape=box,color=blue];
		j2638809087 -> j3310740456;
	j1639412446 [label="Денді Дамбер ішов, щоб «Храм і женці» могли бігти. Він був нічним кошмаром кожної матері та омріяною катастрофою кожного підлітка.",shape=box,color=blue];
		j1639412446 -> j817094862;
	j2321691415 [label="І цей шолом. Це шолом? Чи частина неї? Як вона бачить крізь нього?",shape=box,color=blue];
		j2321691415 -> j1899829077;
	j3310740456 [label="Диявольська ніч відзначає згасання променів Сола в цьому світі.",shape=box,color=blue];
		j3310740456 -> j997028883;
	j817094862 [label="Статурою як паличник, загримований, як королева німого кіно. Рот як цукерка. Смужки та шкіра, собачий нашийник. Вилиці — як стегна скелета.",shape=box,color=blue];
		j817094862 -> j2549270059;
		j817094862 -> j4205120072;
	j1899829077 [label="У будь-якому разі, їх троє в одному тілі. Я б ніколи не змогла вибрати одну з них.",shape=box,color=blue];
		j1899829077 -> j2549270059;
		j1899829077 -> j4205120072;
	j997028883 [label="На перший погляд це не має особливого сенсу. Навіщо святкувати настання темряви? Навіщо радіти беззаконню та анархії?",shape=box,color=blue];
		j997028883 -> j3309866060;
	j2549270059 [label="Убратися в костюми? Вечірка? У зоні бойових дій? Ти справді думаєш, що це можливо?",shape=box,color=red];
		j2549270059 -> j2188945442;
	j4205120072 [label="Знаєш, Диявольська ніч дуже схожа на Наберову ніч. Людям теж подобається вбиратися так.",shape=box,color=red];
		j4205120072 -> j2188945442;
	j3309866060 [label="Я думаю, що це щось на кшталт щеплення. Крихітний шматочок того, чого ми боїмося, але що зміцнить нас. А, може, це просто привід надягнути маску диявола та влаштувати пекло.",shape=box,color=blue];
		j3309866060 -> j2549270059;
		j3309866060 -> j4205120072;
	j2188945442 [label="Напевне, я просто клею дурня. По-дитячому. Хіба ні?",shape=box,color=blue];
		j2188945442 -> j3245676575;
	j3245676575 [label="Ох, про що я тільки думала.",shape=box,color=blue];
		j3245676575 -> j2582653211;
	j2582653211 [label="Мені не потрібно вбиратися, чи не так? Я вже монстр. Назавжди і безповоротно.",shape=box,color=blue];
		j2582653211 -> j2436064064;
	j2436064064 [label="Check boolean EleanorDating",color=orange];
		j2436064064 -> j3727338692 [label=true,color=green];
		j2436064064 -> j3283154085 [label=true,color=green];
		j2436064064 -> j2178584017 [label=true,color=green];
		j2436064064 -> j3283154085 [label=false,color=brown];
		j2436064064 -> j2178584017 [label=false,color=brown];
	j3727338692 [label="Ти монстр, якого я люблю, Елеоноро. Я ні про що не шкодую.",shape=box,color=red];
		j3727338692 -> j831590175;
	j3283154085 [label="Я починаю думати, що тобі подобається говорити так про себе.",shape=box,color=red];
		j3283154085 -> j1559660819;
	j2178584017 [label="Ні. Справжні монстри не піклуються про людей так, як ти.",shape=box,color=red];
		j2178584017 -> j3877850366;
	j831590175 [label="+5 Chemistry",color=orange];
		j831590175 -> j2382872777;
	j1559660819 [label="Якщо ти дійсно вважаєш себе такої, то Диявольська ніч — ідеальна нагода відсвяткувати це.",shape=box,color=red];
		j1559660819 -> j377419967;
		j1559660819 -> j3877850366;
	j3877850366 [label="Я знаю, що ти боїшся того, ким можеш стати. Але ЗАРАЗ ти не така.",shape=box,color=red];
		j3877850366 -> j4260576116;
	j2382872777 [label="О, так! Дурненька я. Я забула, що монстру випав щасливий кінець у нашій маленькій історії.",shape=box,color=blue];
		j2382872777 -> j700125058;
	j377419967 [label="БУДЬ монстром. Володій ним. У цю єдину ніч у році носи це звання з гордістю.",shape=box,color=red];
		j377419967 -> j2531605674;
	j4260576116 [label="Тож одягайся. Розважайся. Бачить Порожнеча, Прокльону це не завадить.",shape=box,color=red];
		j4260576116 -> j3395746004;
	j700125058 [label="Пробач. Я все ще не можу повірити, що це те, чого ти насправді ХОЧЕШ. Можливо, мені просто потрібно трохи більше переконливості.",shape=box,color=blue];
		j700125058 -> j2117535549;
	j2531605674 [label="Ох, існує так БАГАТО причин, чому це ЖАХЛИВА ІДЕЯ",shape=box,color=blue];
		j2531605674 -> j2506219648;
	j3395746004 [label="Ловлю на слові. І дякую. Ще раз. x",shape=box,color=blue];
		j3395746004 -> "Chat ends.";
	j2117535549 [label="Посмакуємо одне одним пізніше. xxx",shape=box,color=blue];
		j2117535549 -> "Chat ends.";
	j2506219648 [label="ТАК. БАГАТО.",shape=box,color=blue];
		j2506219648 -> j3322388800;
	"Chat ends." [color=orange];
	j3322388800 [label="(не можу пригадати жодної просто зараз, але впевнена, що їх ДЕСЯТКИ)",shape=box,color=blue];
		j3322388800 -> j2710044261;
	j2710044261 [label="Дідько.",shape=box,color=blue];
		j2710044261 -> j634291877;
	j634291877 [label="я дуже спритно підчепилася на власний гачок. чорт забирай, молодець. x",shape=box,color=blue];
		j634291877 -> "Chat ends.";
}