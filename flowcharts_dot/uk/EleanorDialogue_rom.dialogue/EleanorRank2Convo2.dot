digraph {
	386 [label="EleanorRank2Convo2 begins.",color=orange];
		386 -> 387;
		386 -> 388;
	387 [label="Як ти опинилася тут, у Голвенії?",shape=box,color=red];
		387 -> 389;
	388 [label="Як було зростати поруч з Артуром?",shape=box,color=red];
		388 -> 390;
	389 [label="Довга історія.",shape=box,color=blue];
		389 -> 391;
		389 -> 392;
	390 [label="Ідилічно. Ми ніколи не сварилися, жодного разу. Ми зберігали таємниці один одного. Він навіть дозволяв мені заплітати йому волосся.",shape=box,color=blue];
		390 -> 393;
	391 [label="Чи варто взагалі питати? Або цю розмову краще перенести на потім?",shape=box,color=red];
		391 -> 397;
	392 [label="Ти збираєшся дати мені справжню версію?",shape=box,color=red];
		392 -> 398;
	393 [label="Не дивно, що всі інші заздрять мені та хочуть, щоб Артур теж був їхнім братом.",shape=box,color=blue];
		393 -> 395;
		393 -> 394;
	397 [label="На потім, якщо ти не втечеш із міста, а я не мутую у шалений безформний згусток м’язової тканини та ротів.",shape=box,color=blue];
		397 -> 399;
	398 [label="Можливо, коли буду певна, що ти не будеш бігати туди-сюди між мною та Артуром, звіряючи записи.",shape=box,color=blue];
		398 -> 400;
	395 [label="Б’юся об заклад, він дозволяв тобі практикуватися в макіяжі на ньому.",shape=box,color=red];
		395 -> 404;
	394 [label="Як мило. [Завершити розмову]",shape=box,color=red];
		394 -> 396;
	399 [label="Тому що ти можеш дізнатися про певних людей такі речі, які тобі буде важко переварити.",shape=box,color=blue];
		399 -> 402;
	400 [label="Не можу уявити, що він багато тобі розповів.",shape=box,color=blue];
		400 -> 401;
	404 [label="Взагалі-то, він так і робив. До недавнього часу, насправді.",shape=box,color=blue];
		404 -> 405;
	396 [label="Chat ends.",color=orange];
	402 [label="Хіба я не загадкова? Як Сфінкс. Гррр.",shape=box,color=blue];
		402 -> 403;
	401 [label="Він досить закритий хлопець, так.",shape=box,color=red];
		401 -> 406;
	405 [label="Хотілося б, щоб він частіше користувався підводкою для очей. Він стверджує, що це вже занадто. Віддає перевагу «Smokey Eyes».",shape=box,color=blue];
		405 -> 413;
	403 [label="Chat ends.",color=orange];
	406 [label="Артур уважає, що є речі, про які не варто говорити. Він старомодний у цьому. «Погано для морального духу» — скаже він. «Табірні балачки». «Обережно, може поширитися ворожа пропаганда».",shape=box,color=blue];
		406 -> 408;
	413 [label="Димчастий погляд йому пасує, але він не знає, коли зупинитися з тінями. Він намагається бути похмурим богом щетини зі схрещеними руками на зупинці автобуса о другій ночі, але переборщує та стає схожим на похмільну емо-панду. І він дивується, чому люди не сприймають його серйозно.",shape=box,color=blue];
		413 -> 414;
	408 [label="Завжди солдат. Він хоч колись НЕ на службі?",shape=box,color=red];
		408 -> 409;
	414 [label="Update boolean EleanorArthurPanda",color=orange];
		414 -> 411;
		414 -> 412;
		414 -> 410;
	409 [label="О, це тягнеться з глибини нашої родині.",shape=box,color=blue];
		409 -> 435;
	411 [label="Не знаю, мені здається він досить сексі… для похмільної емо-панди.",shape=box,color=red];
		411 -> 416;
	412 [label="Я б не проти, щоб ти практикувалася в макіяжі на мені, якщо хочеш. ;)",shape=box,color=red];
		412 -> 418;
	410 [label="Мені важко сприймати ТЕБЕ серйозно.",shape=box,color=red];
		410 -> 407;
	435 [label="У тата на стіні в туалеті на першому поверсі висів старий армійський плакат часів бомбардувань 37 року. Відданий солдат з квадратною щелепою б’є худорлявого скиглія, з якого злітають окуляри. Підпис: «Дайте ляпаса тому, хто закидає свою пастку лайном!»",shape=box,color=blue];
		435 -> 437;
	416 [label="Це виключно твоє право, і я не буду судити тебе за твій вибір",shape=box,color=blue];
		416 -> 417;
	418 [label="ЯК ТИ СМІЄШ",shape=box,color=blue];
		418 -> 419;
	407 [label="Саме цього я й хочу.",shape=box,color=blue];
		407 -> 415;
	437 [label="Артуру він подобався, тому що це було «грубо». Однак він прийняв цей урок близько до серця. «Не говори про речі, які можуть зашкодити людям, про яких ми піклуємося».",shape=box,color=blue];
		437 -> 438;
		437 -> 439;
	417 [label="Я навіть побажаю тобі вдалого полювання, якщо ти так бажаєш",shape=box,color=blue];
		417 -> 420;
	419 [label="Зазіхати на священний ритуал Робити Макіяж Одне Одному",shape=box,color=blue];
		419 -> 421;
	415 [label="Chat ends.",color=orange];
	438 [label="Дай йому перепочити. Це має сенс для бойової команди. Не можна плисти на дірявому кораблі.",shape=box,color=red];
		438 -> 442;
	439 [label="Це не правильно. Якщо ти не говориш про болючі речі, ти просто… замикаєш джина у пляшці.",shape=box,color=red];
		439 -> 440;
	420 [label="ОДНАК",shape=box,color=blue];
		420 -> 422;
	421 [label="Ми навіть приблизно не знайомі достатньо для цього.",shape=box,color=blue];
		421 -> 426;
	442 [label="Усе добре, поки цим не скористаються, щоб заткнути тобі рота.",shape=box,color=blue];
		442 -> 443;
	440 [label="І якщо він вирветься назовні, він може вийти з-під контролю. … У мене є певний досвід у цьому…",shape=box,color=red];
		440 -> 441;
	422 [label="Якщо я хоч НА МИТЬ запідозрю, що ти використовуєш хоч щось з того, чим я вирішила поділитися з тобою, як засіб, щоби потрапити в його броньовані штани…",shape=box,color=blue];
		422 -> 423;
	426 [label="Вибач, дай мені перевести подих.",shape=box,color=blue];
		426 -> 427;
	443 [label="Усе моє життя були речі, про які нам ПОТРІБНО було поговорити. Є розмови, які МАЛИ б відбутися. Про бабусю Келлі. Про Крістофера. Про маєток Кевона. Вони гноїлися між нами.",shape=box,color=blue];
		443 -> 444;
	441 [label="Саме так. Це все дуже добре, поки цим не скористаються, щоб заткнути тобі рота.",shape=box,color=blue];
		441 -> 443;
	423 [label="… я буду саме таким монстром, яким мене вважають люди, так довго, щоб тобі захотілося повернутися до цирку страт.",shape=box,color=blue];
		423 -> 424;
	427 [label="… Я не кажу ніколи. Добре? І мені щойно спало на думку, що для тебе це може бути вперше.",shape=box,color=blue];
		427 -> 428;
	444 [label="Але ні. Говорити про це було просто НЕ МОЖЛИВО. Занадто багато поставлено на карту.",shape=box,color=blue];
		444 -> 445;
	424 [label="Update boolean EleanorArthurHunt",color=orange];
		424 -> 425;
	428 [label="Тож цього разу я пробачу тобі. Але якщо серйозно, не варто більше жартувати про це.",shape=box,color=blue];
		428 -> 429;
	445 [label="Оскільки альтернативою було ніколи більше не відчувати себе у власній шкірі, я взяла за мету з’ясовувати інші речі, про які люди не хотіли говорити, і говорила про них. Я писала про такі речі, тож незабаром люди намагалися зіштовхнути мою машину з гірського перевалу Ірландця.",shape=box,color=blue];
		445 -> 446;
		445 -> 447;
	425 [label="Chat ends.",color=orange];
	429 [label="Для Артура дуже багато значило довіряти мені. Це означало навіть більше, тому що мені вдалося зробити так, щоб він почувався справді добре.",shape=box,color=blue];
		429 -> 430;
	446 [label="Ти ж пам’ятаєш, я не звідси. Про які речі?",shape=box,color=red];
		446 -> 448;
	447 [label="Якого перевалу?",shape=box,color=red];
		447 -> 449;
	430 [label="Дідько. Тепер я відчуваю, що повинна вибачитися перед тобою, хоча насправді я цього не роблю.",shape=box,color=blue];
		430 -> 432;
	448 [label="Звичайні речі. Корупція на найвищих рівнях влади. Скандали щодо батьківства в королівській родині Голвенії. Зіпсована молочна суміш, яка роздається годуючим матерям у «небажаних» помийниках Нового Голівелу.",shape=box,color=blue];
		448 -> 450;
	449 [label="Так. Туриста ще до наших часів. Звичайні речі. Корупція на найвищих рівнях влади. Скандали щодо батьківства в королівській родині Голвенії. Зіпсована молочна суміш, яка роздається годуючим матерям у «небажаних» помийниках Нового Голівелу.",shape=box,color=blue];
		449 -> 450;
	432 [label="+15 Chemistry",color=orange];
		432 -> 431;
	450 [label="Тому що, коли хтось каже тобі заткнутися, ти не підкоряєшся, НІКОЛИ.",shape=box,color=blue];
		450 -> 451;
		450 -> 452;
	431 [label="Спишемо це на досвід, га?",shape=box,color=blue];
		431 -> 433;
	451 [label="Ти нагадуєш мені Нору Ніч.",shape=box,color=red];
		451 -> 456;
	452 [label="Погоджуюся.",shape=box,color=red];
		452 -> 457;
	433 [label="Update boolean EleanorHasFlirted",color=orange];
		433 -> 434;
	456 [label="+20 Chemistry",color=orange];
		456 -> 453;
	457 [label="+15 Chemistry",color=orange];
		457 -> 454;
	434 [label="Chat ends.",color=orange];
	453 [label="Я припускаю, що це добре? Розкажеш мені про неї колись, коли я буду не в настрої відривати комусь голову.",shape=box,color=blue];
		453 -> 458;
	454 [label="Так чи інакше. Артур хотів, щоби я заткнулася для блага родини. Тепер я не розмовляю взагалі. Але чомусь Артур все одно незадоволений.",shape=box,color=blue];
		454 -> 455;
	458 [label="Chat ends.",color=orange];
	455 [label="Я запитую тебе. Що має робити сестра?",shape=box,color=blue];
