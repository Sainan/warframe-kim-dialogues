digraph {
	553 [label="EleanorRank2Convo4 begins.",color=orange];
		553 -> 554;
	554 [label="Як ти думаєш, що відбувається після нашої смерті?",shape=box,color=blue];
		554 -> 555;
		554 -> 556;
		554 -> 557;
		554 -> 558;
	555 [label="У мене все добре, Елеоноро, дякую за питання. А ти як?",shape=box,color=red];
		555 -> 560;
	556 [label="… з тобою все гаразд?",shape=box,color=red];
		556 -> 561;
	557 [label="Я бачив достатньо, щоб знати, що особистість може пережити смерть.",shape=box,color=red];
		557 -> 562;
	558 [label="Більше ніяких дурних розмов. [Завершити розмову]",shape=box,color=red];
		558 -> 559;
	560 [label="Ха.",shape=box,color=blue];
		560 -> 563;
	561 [label="Зовсім ні.",shape=box,color=blue];
		561 -> 564;
	562 [label="Продовжуй?",shape=box,color=blue];
		562 -> 565;
	559 [label="Chat ends.",color=orange];
	563 [label="Слухай, ми можемо поговорити про погоду, якщо хочеш.",shape=box,color=blue];
		563 -> 566;
	564 [label="Але я не думаю про смерть у якомусь хворобливому сенсі, якщо ти хвилюєшся про це. Я з радістю буду триматися так довго, як зможу.",shape=box,color=blue];
		564 -> 567;
	565 [label="(Уяви, як я лежу на животі на дивані, поклавши підборіддя на руки, дивлюся на Пом-2 і з нетерпінням чекаю твого наступного повідомлення.)",shape=box,color=blue];
		565 -> 572;
		565 -> 573;
		565 -> 574;
		565 -> 575;
	566 [label="Або, оскільки ми вже в торговельному центрі, ми могли б піти випити латешечку і побазікати про те, яка Летті суцільне стерво, що тримає всі ті цікаві пігулки при собі, замість того, щоб розважити нас, чи не так?",shape=box,color=blue];
		566 -> 568;
	567 [label="У мене просто багато довгих та темних годин для себе і є над чим подумати, поки мої бідні маленькі клітини варяться у відьомському бульйоні, на який перетворилася моя кров.",shape=box,color=blue];
		567 -> 572;
		567 -> 573;
		567 -> 574;
		567 -> 575;
	572 [label="Там, звідки я, ми маємо «цефалонів». Скляні куби, які колись були людьми, але й досі зберігають свою особистість. Переважно.",shape=box,color=red];
		572 -> 576;
	573 [label="Орокіни переносили свою свідомість у викрадені тіла, щоб вони могли жити вічно.",shape=box,color=red];
		573 -> 577;
	574 [label="Усі тенно можуть використовувати Перенесення для керування ворфреймами. Ми не прив’язані до фізичної форми. Тому немає сенсу уявляти, що наше існування закінчиться зі смертю наших тіл.",shape=box,color=red];
		574 -> 578;
	575 [label="Мені справді неприємно підживлювати цю твою одержимість, Елеоноро.",shape=box,color=red];
		575 -> 579;
	568 [label="(почуваюся паршиво за те, що написала це. Вибач.)",shape=box,color=blue];
		568 -> 569;
	576 [label="Check boolean EleanorOrigin",color=orange];
		576 -> 580 [label=true,color=green];
		576 -> 581 [label=false,color=brown];
	577 [label="Check boolean EleanorEntrati",color=orange];
		577 -> 582 [label=true,color=green];
		577 -> 583 [label=false,color=brown];
	578 [label="Check boolean EleanorVoidLove",color=orange];
		578 -> 584 [label=true,color=green];
		578 -> 585 [label=false,color=brown];
	579 [label="Одержимість?",shape=box,color=blue];
		579 -> 586;
	569 [label="Я знаю, що я пропускаю купу світських розмов і хапаю відразу за горло, але, чесно кажучи, це твоя провина, що ти така цікава особа.",shape=box,color=blue];
		569 -> 570;
	580 [label="Я бачила. Я не думаю, що існування, яке ваші орокіни вважали ПОКАРАННЯМ, є потойбічним життям, гідним такої назви.",shape=box,color=blue];
		580 -> 581;
	581 [label="Пхе. Гадаю, краще вже бути пристойно мертвою.",shape=box,color=blue];
		581 -> 588;
	582 [label="З усіх огидних речей, що є на цій планеті, я вважаю, що орокіни найгірші.",shape=box,color=blue];
		582 -> 583;
	583 [label="Цікаво, чи не запізно припинити їхнє існування взагалі. Можливо, мені просто потрібно знайти правильного метелика, щоб розтоптати.",shape=box,color=blue];
		583 -> 589;
	584 [label="Більше магії Порожнечі. Чим більше я дізнаюся про Порожнечу, тим більше хочу туди. Можливо, там моє місце. За межами мапи. Де дракони. У вас, тенно, Порожнеча в крові. Щасливі засранці.",shape=box,color=blue];
		584 -> 585;
	585 [label="Для вас це все дуже добре, але як щодо решти селян? Ми не можемо всі бути тенно, чи не так?",shape=box,color=blue];
		585 -> 590;
	586 [label="Що, ніби ти нещасна маленька інопланетна сирітка, яка опинилася далеко від дому, а я науковець, одержима ідеєю розрізати тебе, щоби подивитися, як ти працюєш?",shape=box,color=blue];
		586 -> 587;
	570 [label="Напівбожество, що мандрує в часі, буквально вривається в моє життя, в моє і без того безглузде життя, і очікує, що я буду слідувати соціальному етикету?",shape=box,color=blue];
		570 -> 571;
	588 [label="Не мели дурниць, Елеоноро. Цефалони — люди.",shape=box,color=red];
		588 -> 595;
	589 [label="Просто уяви. Ціла когорта хитрожопих муднів викреслена з існування. Єдиний мінус — ми не почуємо їхніх криків.",shape=box,color=blue];
		589 -> 597;
	590 [label="Я просто хочу сказати, думаю, що пережити смерть можливо.",shape=box,color=red];
		590 -> 599;
	587 [label="Вибач. У мене склалося враження, що те, що ми знайшли ОДНЕ ОДНОГО, є досить інтригуючим. Я думала, що ці маленькі ходіння туди-сюди були нашим способом пізнати одне одного.",shape=box,color=blue];
		587 -> 591;
	571 [label="Ти можеш дати мені точку зору, яку ніхто не зможе. Тож, будь ласка. Перш ніж я почну гризти меблі. Поговори зі мною.",shape=box,color=blue];
		571 -> 572;
		571 -> 573;
		571 -> 574;
		571 -> 575;
	595 [label="Виправ мне, якщо я зрозуміла неправильно, але… те, про що ти говориш, не схоже, що ЦЕ особистість. Це більше схоже на комп’ютер, який запрограмували ДУМАТИ, що він особистість. Вірно?",shape=box,color=blue];
		595 -> 596;
	597 [label="Хоча…",shape=box,color=blue];
		597 -> 598;
	599 [label="Так, так, я знаю, що ти маєш на увазі. Задовольни мене.",shape=box,color=blue];
		599 -> 600;
	591 [label="Але ні. Вочевидь, я не краща за якусь фанатку Зіка, яка витрачає кожну годину свого життя, думаючи про свою «одержимість».",shape=box,color=blue];
		591 -> 592;
	596 [label="Типу того. Некралойд — це копія цефалона Лойда, який ще живий. Але навіть якщо цефалони не оригінали, вони все одно люди.",shape=box,color=red];
		596 -> 601;
	598 [label="Трясця.",shape=box,color=blue];
		598 -> 602;
	600 [label="Порожнеча може бути місцем, де існують душі. Це те, про що ми говоримо? Що хтось ломом відкрив царство духів, і тепер ви використовуєте його для живлення половини своїх пристроїв?",shape=box,color=blue];
		600 -> 605;
	592 [label="Ти більше не в Дувірі, ваша Величносте. Всім тут насрати.",shape=box,color=blue];
		592 -> 593;
	601 [label="М-м-м. Вибач, але це не одне й теж. Ми не говоримо тут про особистість. Ми говоримо про безперервність.",shape=box,color=blue];
		601 -> 806;
	602 [label="Якби я знищила їх, я б знищила і ТЕБЕ, чи не так? Бо твоє існування залежить від ЇХНЬОГО існування.",shape=box,color=blue];
		602 -> 603;
		602 -> 604;
	605 [label="Не просто хтось. Ентраті. Він зробив перші кроки в Порожнечу.",shape=box,color=red];
		605 -> 606;
	593 [label="Змирися з цим.",shape=box,color=blue];
		593 -> 594;
	806 [label="Я б могла попросити Аміра перепрограмувати балакучу ляльку Шарлотту на деякі фрази Елеонори, і він міг би лякати нею Летті після моєї смерті, але це вже буду не Я.",shape=box,color=blue];
		806 -> 807;
	603 [label="Якраз те, що треба. Ще більше людей, які порушують часові рамки.",shape=box,color=red];
		603 -> 610;
	604 [label="Або ти би могла створити нову гілку історії та слідувати нею.",shape=box,color=red];
		604 -> 611;
	606 [label="Я б мала здогадатися, що той двоєдушний вилупок приклав до цього руку.",shape=box,color=blue];
		606 -> 608;
	594 [label="Chat ends.",color=orange];
	807 [label="Але я б могла якось вселитися в неї. Дай мені піти та поміркувати над цим.",shape=box,color=blue];
		807 -> 622;
		807 -> 623;
	610 [label="Ого.",shape=box,color=blue];
		610 -> 612;
	611 [label="Не змушуй мене починати. Ми просидимо тут увесь тиждень, якщо ти це зробиш.",shape=box,color=blue];
		611 -> 613;
	608 [label="Хтось коли-небудь зустрічав мерця в Порожнечі? Або Порожнеча коли-небудь приймала форму мертвої людини? Вибач, що питаю, але мені потрібно знати.",shape=box,color=blue];
		608 -> 609;
	622 [label="Якщо це виглядає як совґов і кричить як совґов — це і є совґов. Це все одно, чи не так?",shape=box,color=red];
		622 -> 624;
	623 [label="Ці речі дійсно важливі для тебе, чи не так?",shape=box,color=red];
		623 -> 625;
	612 [label="Я думала, це просто весела розмова.",shape=box,color=blue];
		612 -> 614;
	613 [label="У нас усе ще тема «чи живе душа після смерті тіла». Ми ще не можемо перейти до «чи справді існує свобода волі».",shape=box,color=blue];
		613 -> 615;
	609 [label="Я знаю таких мертвих людей. «Паланка».",shape=box,color=red];
		609 -> 617;
	624 [label="Гм-м. Ні. Я так не думаю.",shape=box,color=blue];
		624 -> 640;
	625 [label="О, ти гадаєш?",shape=box,color=blue];
		625 -> 645;
	614 [label="Щоби було зрозуміло, я не маю жодних РЕАЛЬНИХ планів гратися з майбутнім. Я просто",shape=box,color=blue];
		614 -> 616;
	615 [label="(Це те, що ти отримаєш, Елеоноро, сказала вона собі. Ось де ти можеш поставити цікавій людині Великі Важливі Питання.)",shape=box,color=blue];
		615 -> 622;
		615 -> 623;
	617 [label="Update boolean EleanorHoldfasts1",color=orange];
		617 -> 626;
	640 [label="Якби Порожнеча зробила мою копію, я би з’їхала з глузду, думаючи, хто з нас справжній.",shape=box,color=blue];
		640 -> 641;
	645 [label="Так. Це важливо для мене.",shape=box,color=blue];
		645 -> 646;
	616 [label="А знаєш що? Воно того не варте.",shape=box,color=blue];
		616 -> 618;
	626 [label="Вибач, що?",shape=box,color=blue];
		626 -> 627;
	641 [label="Тому що, якщо вона може робити це, коли хтось мертвий, безперечно ж може зробити, поки хтось живий.",shape=box,color=blue];
		641 -> 642;
	646 [label="Боюся, навіть більше ніж я показую.",shape=box,color=blue];
		646 -> 647;
	618 [label="Я НАМАГАЮСЯ сказати, як сильно не хочу тебе відпускати. Настільки, що я була готова дозволити людям у моєму майбутньому продовжувати страждати під ярмом купки тиранів замість того, щоб щось змінити.",shape=box,color=blue];
		618 -> 619;
	627 [label="Ти знаєш мертвих людей? У соціальному плані?",shape=box,color=blue];
		627 -> 628;
	642 [label="… Мені не подобається, до чого це все веде. Вибач. Поговоримо пізніше. Можливо.",shape=box,color=blue];
		642 -> 643;
	647 [label="Скажімо так, у мене є підстави сподіватися, що хтось із нас переживе смерть тіла. Я знаю, що я не самотня у цьому.",shape=box,color=blue];
		647 -> 648;
	619 [label="Поганий жарт. Вибач. Більше не повториться.",shape=box,color=blue];
		619 -> 620;
	628 [label="Вони пам’ятають смерть? Вони дійсно знають, що вони мертві?",shape=box,color=blue];
		628 -> 629;
		628 -> 630;
	643 [label="+10 Chemistry",color=orange];
		643 -> 644;
	648 [label="Update boolean EleanorBereaved",color=orange];
		648 -> 649;
	620 [label="+5 Chemistry",color=orange];
		620 -> 621;
	629 [label="Так. Вони були офіцерами на «Заримені». Зорельоті колоністів, який загубився в Порожнечі. Тепер вони, мабуть, примари.",shape=box,color=red];
		629 -> 631;
	630 [label="Це… складно. Речі можуть потрапити в Порожнечу, але вони вже не ті, коли повертаються.",shape=box,color=red];
		630 -> 632;
	644 [label="Chat ends.",color=orange];
	649 [label="Ти запитуєш не ту людину. Не маю впевненості, що я *можу* померти.",shape=box,color=red];
		649 -> 650;
	621 [label="Chat ends.",color=orange];
	631 [label="Срань господня, це неймовірно.",shape=box,color=blue];
		631 -> 633;
	632 [label="О. Тобі важко підібрати правильні слова? Або ти не хочеш розповісти мені всю історію? Я нервую, коли люди намагаються стримуватися.",shape=box,color=blue];
		632 -> 634;
	650 [label="Check boolean EleanorDuviri",color=orange];
		650 -> 651 [label=true,color=green];
		650 -> 652 [label=false,color=brown];
	633 [label="Хоча…",shape=box,color=blue];
		633 -> 635;
	634 [label="Зажди. Не відповідай на це. Щось промайнуло в моїй голові. Я не знаю, чи це була твоя випадкова думка, чи ні, але кривавий Соле на зоряному дереві, це викликає в мене жах.",shape=box,color=blue];
		634 -> 636;
	651 [label="Точно. Вони намагалися, чи не так? Тракс робив із тебе щоденне видовище. Не знаю, як можна пережити цей кошмар і залишитися при здоровому глузді.",shape=box,color=blue];
		651 -> 652;
	652 [label="Між нами, я також не впевнена, що можу померти.",shape=box,color=blue];
		652 -> 653;
	635 [label="Звідки ми знаємо, що це та сама людина? Та сама точка зору?",shape=box,color=blue];
		635 -> 637;
	636 [label="Янголи.",shape=box,color=blue];
		636 -> 638;
	653 [label="Зараз у мені живе зграйка крихітних техноцитів, які б дуже розлютилися за знищення їхньої прекрасної хатинки-носія.",shape=box,color=blue];
		653 -> 654;
	637 [label="А якщо це просто, я не знаю, клон Порожнечі чи щось таке? Чи могло таке статися? Порожнеча бере ОСНОВУ людини та надає їй форму. І тоді ця форма ВВАЖАЄ себе тією ж людиною, що померла.",shape=box,color=blue];
		637 -> 622;
		637 -> 623;
	638 [label="Милостива Луа, я їх чую. Це як… коли кондиціонер працює в кімнаті так довго, що ти вже звикаєш до його шуму, а потім раптом помічаєш це",shape=box,color=blue];
		638 -> 639;
	654 [label="Ось чому вони доклали стільки зусиль, або зробити мене великою та сильною.",shape=box,color=blue];
		654 -> 655;
	639 [label="Чому я почала розпитувати тебе про це, ЧОРТ ЗАБИРАЙ",shape=box,color=blue];
		639 -> 668;
	655 [label="Це змушує мене замислитися над тим, що було б, якби мене просто вбили. Техногниль може оживити труп і змінити його призначення. Я бачила таке. Як колонія термітів, що працює разом для керування роботом.",shape=box,color=blue];
		655 -> 656;
	668 [label="Так. Так. Гаразд. Я зараз зосереджуся. Будь ласка, залишайся зі мною. Я будую стіну зі своїх думок. Вона підіймається між мною та ангелами.",shape=box,color=blue];
		668 -> 669;
	656 [label="Тож… чи стала б я якоюсь техногнилою зомбачкою? А якби воно мене оживило, чи залишилася б собою? Або була б лише ланкою розмноження техногнилі з доступом до моїх спогадів і ДУМАЛА, що це я?",shape=box,color=blue];
		656 -> 657;
	669 [label="Стана, стіна, стіна, чудова, чудова стіна",shape=box,color=blue];
		669 -> 670;
	657 [label="Я не думаю, що для тебе корисно зациклюватися на цьому.",shape=box,color=red];
		657 -> 658;
	670 [label="Отак. Стіна на місці. Тепер все тихо. Мабуть, мені варто відпустити тебе, чи не так.",shape=box,color=blue];
		670 -> 671;
	658 [label="Для мене вже немає нічого корисного. Ось так.",shape=box,color=blue];
		658 -> 659;
	671 [label="+10 Chemistry",color=orange];
		671 -> 672;
	659 [label="Але…",shape=box,color=blue];
		659 -> 660;
	672 [label="Chat ends.",color=orange];
	660 [label="Я ціную твої слова. Вони вказують на небайдужість.",shape=box,color=blue];
		660 -> 661;
	661 [label="Летті перевіряє як справляється моє тіло, бо Артур хоче знати про готовність до бою. Я не злюся за це. Це її робота.",shape=box,color=blue];
		661 -> 662;
	662 [label="Але ніхто не перевіряє МЕНЕ.",shape=box,color=blue];
		662 -> 663;
