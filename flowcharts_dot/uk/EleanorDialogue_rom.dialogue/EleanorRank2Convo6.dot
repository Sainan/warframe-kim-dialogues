		j2295780752 -> j2133050326;
	j752767448 [label="Він чарівний маленький бісик. Чому ти питаєш?",shape=box,color=blue];
		j752767448 -> j2056554373;
		j752767448 -> j457004307;
	j2133050326 [label="Напевно, так само як і будь-яка інша людина. Чому ти питаєш?",shape=box,color=blue];
		j2133050326 -> j2056554373;
		j2133050326 -> j457004307;
	j2056554373 [label="Амір намагається зібрати команду для гри «Оповідки Прикордоння», і я маю намір допомогти.",shape=box,color=red];
		j2056554373 -> j1142193289;
	j457004307 [label="Амір дуже хоче пограти в «Оповідки Прикордоння» з усіма. Ти будеш?",shape=box,color=red];
		j457004307 -> j1142193289;
	j1142193289 [label="Ага, зрозуміло. Тебе обрано, щоби доправити послання від Короля Громовержця для залучення чарівної Елеонори. Не маю сумнівів, що на мене чекають усілякі шахрайства, сміхунці та дурбелицтво.",shape=box,color=blue];
		j1142193289 -> j3266538177;
		j1142193289 -> j135313121;
	j3266538177 [label="Так, я думаю, що це буде марна трата часу, але намагаюся поводитися чемно.",shape=box,color=red];
		j3266538177 -> j3893604294;
	j135313121 [label="Я думаю, що буде весело, якщо чесно. І, здається, це багато для нього значить.",shape=box,color=red];
		j135313121 -> j657477358;
	j3893604294 [label="Я зроблю тобі послугу та НЕ перекажу йому ці слова. Запам’ятай мудрість: стався до нього з більшою повагою в майбутньому в моїй присутності.",shape=box,color=blue];
		j3893604294 -> "Chat ends.";
	j657477358 [label="Чесно кажучи, ввімкнути дурнуватий голос і придурюватися кілька годин звучить ідеально. Я з вами.",shape=box,color=blue];
		j657477358 -> j567593870;
	j567593870 [label="О! Я хочу бути чарівницею. Або, може, бардкою. Чи обома? Я можу БУТИ обома?",shape=box,color=blue];
		j567593870 -> j51403160;
	j51403160 [label="Або я можу бути болотяною відьмою! Поки я можу носити тісний корсет, між іншим. Матінка-моховиця з’їсть твої кісточки, маленьке опудало.",shape=box,color=blue];
		j51403160 -> j1667172562;
	j1667172562 [label="+20 Chemistry",color=orange];
