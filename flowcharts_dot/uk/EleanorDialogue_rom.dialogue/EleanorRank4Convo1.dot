digraph {
	1389 [label="EleanorRank4Convo1 begins.",color=orange];
		1389 -> 1390;
	1390 [label="Я маю тебе дещо запитати, і я не думаю, що тобі це сподобається. Думаю, в глибині душі ти знаєш, що ця розмова колись повинна була відбутися, враховуючи мій стан.",shape=box,color=blue];
		1390 -> 1391;
	1391 [label="Я довіряю тобі, і ти мені подобаєшся, тому я просто скажу це, добре?",shape=box,color=blue];
		1391 -> 1392;
	1392 [label="Я не маю права запитувати, але мені потрібно знати.",shape=box,color=blue];
		1392 -> 1393;
	1393 [label="Якщо я повністю перетворюся — якщо техногниль повністю забере мене, і я більше не буду тією Елеонорою — ти мене вб’єш?",shape=box,color=blue];
		1393 -> 1394;
		1393 -> 1395;
		1393 -> 1396;
		1393 -> 1397;
	1394 [label="Ти би хотіла, щоб я?",shape=box,color=red];
		1394 -> 1398;
	1395 [label="Звісно.",shape=box,color=red];
		1395 -> 1399;
	1396 [label="Ніколи.",shape=box,color=red];
		1396 -> 1400;
	1397 [label="Я не буду відповідати на це питання.",shape=box,color=red];
		1397 -> 1401;
	1398 [label="Гм-м. Гарний початок. Ти переводиш тему, чого хочу я, замість того, щоб розглядати моє життя як можливість змінити особисту мораль. Ти просто даєш мені зрозуміти, що це не для тебе.",shape=box,color=blue];
		1398 -> 1402;
	1399 [label="Ого. Добре.",shape=box,color=blue];
		1399 -> 1403;
	1400 [label="Гаразд. Ем.",shape=box,color=blue];
		1400 -> 1404;
	1401 [label="Як хочеш.",shape=box,color=blue];
		1401 -> 1405;
	1402 [label="Це рідкість.",shape=box,color=blue];
		1402 -> 1406;
	1403 [label="Без вагань, без боротьби, лише просте «так».",shape=box,color=blue];
		1403 -> 1407;
	1404 [label="Вибач. Насправді я трохи пригнічена. Я не очікувала на таку відвертість.",shape=box,color=blue];
		1404 -> 1408;
	1405 [label="Я більше не питатиму.",shape=box,color=blue];
		1405 -> 1409;
	1406 [label="На жаль, це не позбавляє нас від нашої дилеми, тому що це означає, що я ніколи не зможу передумати.",shape=box,color=blue];
		1406 -> 1410;
	1407 [label="Дякую. Ти для мене багато в чому загадка, але тепер я знаю, що ти без вагань пустиш мені кулю в голову, а такі речі важливі на роботі.",shape=box,color=blue];
		1407 -> 1411;
	1408 [label="Ти дозволиш монстру жити?",shape=box,color=blue];
		1408 -> 1412;
	1409 [label="Гадаю, тобі доведеться почекати, поки це станеться, щоб побачити, як ти відреагуєш, чи не так?",shape=box,color=blue];
		1409 -> 1413;
	1410 [label="Скажімо, я скажу «так», я би хотіла, щоб ти покінчив зі мною швидко і чисто, замість того, щоб я продовжувала жити, як хижа потвора. Уявімо, що це те, чого Елеонора хоче ЗАРАЗ.",shape=box,color=blue];
		1410 -> 1414;
	1411 [label="Аааа я щойно відчула, як техногниль у моїх клітинах тривожно затремтіла.",shape=box,color=blue];
		1411 -> 1415;
	1412 [label="Вибач, вибач, просто я живу з Летті над вухом, яка репетує, що я не заслуговую бути тут, а Артур дивиться на мене, як на безнадійну жертву, і рахує дні до того моменту, коли йому доведеться це зробити, і я просто не очікувала, що ти скажеш, що все гаразд.",shape=box,color=blue];
		1412 -> 1422;
	1413 [label="Ти смертельна маленька загадка.",shape=box,color=blue];
		1413 -> 1417;
	1414 [label="Але що, як хижа потвора — це я, тільки ще більше? Якщо після того, як моя людяність згорить у тиглі техногнилі, я не ЗАХОЧУ вмирати?",shape=box,color=blue];
		1414 -> 1424;
	1415 [label="Думаю, відтепер вона буде поводитися дещо ліпше. Ніщо так не лякає паразита, аніж погроза Солом від господаря, правда?",shape=box,color=blue];
		1415 -> 1418;
	1422 [label="+20 Chemistry",color=orange];
		1422 -> 1416;
	1417 [label="І я теж.",shape=box,color=blue];
		1417 -> 1420;
	1424 [label="Тому що так я відчуваю себе живою, мандрівниче. Потужно живою.",shape=box,color=blue];
		1424 -> 1425;
		1424 -> 1426;
		1424 -> 1427;
		1424 -> 1428;
	1418 [label="Update boolean EleanorNoDate",color=orange];
		1418 -> 1419;
	1416 [label="Плачу. Сльози щастя. Поговоримо пізніше. Прошу",shape=box,color=blue];
		1416 -> 1423;
	1420 [label="Update boolean EleanorNoDate",color=orange];
		1420 -> 1421;
	1425 [label="Я б все одно зробив це.",shape=box,color=red];
		1425 -> 1429;
	1426 [label="Зрозуміло. Я цього не зроблю.",shape=box,color=red];
		1426 -> 1430;
	1427 [label="Це буде залежати від того, скільки ще людей опиниться під загрозою.",shape=box,color=red];
		1427 -> 1431;
	1428 [label="Ти не відповіла на запитання. Ти би хотіла, щоб я?",shape=box,color=red];
		1428 -> 1432;
	1419 [label="Chat ends.",color=orange];
	1423 [label="Chat ends. Next chat will be EleanorMonster.",color=orange];
	1421 [label="Chat ends.",color=orange];
	1429 [label="Гаразд. Тож ми приносимо в жертву щасливу, самодостатню Елеонору на вівтарі Елеонори, якою вона була раніше?",shape=box,color=blue];
		1429 -> 1433;
	1430 [label="О, то все, що мені потрібно зробити, це підморгнути тобі своїми великими красивими очима, і твоя рішучість зруйнується?",shape=box,color=blue];
		1430 -> 1434;
	1431 [label="А, точно. У цьому сценарії я — нелюдський монстр, який, імовірно, волею-неволею вбиває людей. Ти можеш зарахувати мене до категорії «хижих тварин», разом зі скаженими собаками, голодними ведмедями тощо, а це означає, що немає ніяких моральних проблем.",shape=box,color=blue];
		1431 -> 1435;
	1432 [label="… Я не знаю. Іноді я так думаю. Я відчуваю себе архетипною персонажкою мелодрами.",shape=box,color=blue];
		1432 -> 1436;
	1433 [label="Я можу змінити свою думку та вирішити жити, але ти не можеш змінити свою?",shape=box,color=blue];
		1433 -> 1442;
	1434 [label="І що ж за вбивця вампірів без страху та сумнівів з тебе вийде?",shape=box,color=blue];
		1434 -> 1443;
	1435 [label="Тож скажи мені.",shape=box,color=blue];
		1435 -> 1438;
	1436 [label="«О ні, нещасна дівчина, яку ми колись любили, стала сексуальною вампіркою. Уб’ємо її, щоб у смерті вона знову стала чистою та невинною.»",shape=box,color=blue];
		1436 -> 1437;
	1442 [label="Я не повинна дивуватися. Це фінал, до якого тебе готують історії.",shape=box,color=blue];
		1442 -> 1444;
	1443 [label="Я тобі скажу. Ти з тих, хто помирає посеред фільму, тому що не вистачило духу зробити те, що Потрібно Було Зробити.",shape=box,color=blue];
		1443 -> 1445;
	1438 [label="Ти чекатимеш, поки я вб’ю свою першу жертву, щоб всадити мені кулю в голову?",shape=box,color=blue];
		1438 -> 1439;
	1437 [label="Update boolean EleanorArthurNightmare",color=orange];
		1437 -> 1441;
	1444 [label="«О ні, нещасна дівчина, яку ми колись любили, стала сексуальним вампіром. Уб’ємо її, щоб у смерті вона знову стала чистою та невинною.»",shape=box,color=blue];
		1444 -> 1448;
	1445 [label="Ти станеш попередженням для інших, саме так!",shape=box,color=blue];
		1445 -> 1446;
	1439 [label="Бо якщо ти цього не зробиш, яка впевненість у тому, що я становлю небезпеку?",shape=box,color=blue];
		1439 -> 1440;
	1441 [label="Я була одержима цим, насправді. Мені снилися кошмари, в яких я прокидалася на своєму дивані, а наді мною стояв Артур зі сльозами на очах і мечем у руці, і він видавав якісь репліки про те, що Елеонора була його сестрою, але тепер Елеонора ПОМЕРЛА, і він повинен був це зробити, навіть якщо це вбивало його, бубубу.",shape=box,color=blue];
		1441 -> 1450;
	1448 [label="Update boolean EleanorArthurNightmare",color=orange];
		1448 -> 1449;
	1446 [label="Вибач. Я не була зовсім чесною з тобою. Поговоримо пізніше.",shape=box,color=blue];
		1446 -> 1447;
	1440 [label="Chat ends.",color=orange];
	1450 [label="І коли лезо проходить мені межи ребер, я кричу: «Елеонора ТУТ, тупий ти виродку!», але мене ніхто вже не чує.",shape=box,color=blue];
		1450 -> 1451;
	1449 [label="Я була одержима цим, насправді. Мені снилися кошмари, в яких я прокидалася на своєму дивані, а наді мною стояв Артур зі сльозами на очах і мечем у руці, і він видавав якісь репліки про те, що Елеонора була його сестрою, але тепер Елеонора ПОМЕРЛА, і він повинен був це зробити, навіть якщо це вбивало його, бубубу.",shape=box,color=blue];
		1449 -> 1455;
	1447 [label="Chat ends.",color=orange];
	1451 [label="Отже, я чую, що ти не бажаєш вирішувати це питання заздалегідь.",shape=box,color=red];
		1451 -> 1452;
	1455 [label="І коли лезо проходить мені межи ребер, я кричу: «Елеонора ТУТ, тупий ти виродку!», але мене ніхто вже не чує.",shape=box,color=blue];
		1455 -> 1456;
	1452 [label="У такому випадку, ти також не можеш очікувати цього від мене.",shape=box,color=red];
		1452 -> 1453;
	1456 [label="Можливо, ти наснишся мені наступного разу.",shape=box,color=blue];
		1456 -> 1457;
	1453 [label="+20 Chemistry",color=orange];
		1453 -> 1454;
	1457 [label="Chat ends.",color=orange];
	1454 [label="Chat ends.",color=orange];
