	126 [label="Ната, Марґуліс, Лотос. Три королеви у пітьмі.",shape=box,color=blue];
		126 -> 130;
	127 [label="Не було нічого у твоїх розповідях про нескінченні страти. Знаєш, мені могли б СПОДОБАТИСЯ нескінченні страти.",shape=box,color=blue];
		127 -> 131;
	128 [label="Стільки разів я була переконана, що ми просто згинемо на цій каменюці.",shape=box,color=blue];
		128 -> 132;
	129 [label="Я не буду вдавати, що краще зрозуміла Ентраті після того, як побачила все це.",shape=box,color=blue];
		129 -> 133;
	130 [label="Я просто хочу сидіти в неї на колінах і слухати, як вона говорить.",shape=box,color=blue];
