	"Chat ends." [color=orange];
	j3364311394 [label="Check boolean EleanorConsentComplete",color=orange];
		j3364311394 -> "Chat ends." [label=true,color=green];
		j3364311394 -> j3357548278 [label=false,color=brown];
	j3528729371 [label="Check boolean EleanorPolyamorySuccess",color=orange];
		j3528729371 -> j3364311394 [label=true,color=green];
		j3528729371 -> "Chat ends." [label=false,color=brown];
	j3357548278 [label="Єдине, що в цьому всьому мене бісить, то це те, що думки про новину я дізналася з твоєї голови.",shape=box,color=blue];
		j3357548278 -> j1893307516;
	j1893307516 [label="Я знала, що ти збираєшся чемно й ввічливо спитати дозволу. Привіт.",shape=box,color=blue];
		j1893307516 -> j3664260895;
	j3664260895 [label="Відповідь можеш собі уявити: «Так, звісно» ( у той же час вона сидить тут і намагається не думати як вони там ламають ліжка з новенькою гарненькою штучкою, яку підгледіла у твоїй голові).",shape=box,color=blue];
		j3664260895 -> j1200444720;
	j1200444720 [label="І тепер ЦІ ЗАБАВКИ В МОЇЙ ГОЛОВІ. А Я застрягла в іншому часі і проторі. ДЯКУЮ-ДУЖЕ ДЯКУЮ! І ЩЕ РАЗ ДЯКУЮ!",shape=box,color=blue];
		j1200444720 -> j1224903244;
	j1224903244 [label="Мені шкода. У моїх планах було питання стосовно твоєї згоди. Ми начебто раніше цього не обговорювали. Хотілося б переконатися, що все йде як треба і ти будеш не проти.",shape=box,color=red];
		j1224903244 -> j3804618726;
	j3804618726 [label="Та як же інакше! Я ж бачу вас у твоїх фантазіях. І якщо ти довіряєш, то і я довірятиму.",shape=box,color=blue];
		j3804618726 -> j4132146606;
	j4132146606 [label="Так сумно, що в мене нема можливості самій повеселитися з кимось.",shape=box,color=blue];
		j4132146606 -> j1837204801;
	j1837204801 [label="+20 Chemistry",color=orange];
		j1837204801 -> j1119082364;
	j1119082364 [label="Гм. Можливо, наступного разу я спробую зробити це опосередковано крізь тебе. Чудова думка.",shape=box,color=blue];
		j1119082364 -> j298331240;
	j298331240 [label="Boolean EleanorConsentComplete is now true.",color=orange];
		j298331240 -> "Chat ends.";
}