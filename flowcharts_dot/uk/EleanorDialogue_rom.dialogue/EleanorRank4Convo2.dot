digraph {
	1521 [label="EleanorRank4Convo2 begins.",color=orange];
		1521 -> 1522;
	1522 [label="О, мандрівниче! Сутність з іншого часу і простору! Як я рада твоїй присутності на цьому маленькому екрані!",shape=box,color=blue];
		1522 -> 1523;
		1522 -> 1524;
	1523 [label="Привіт, Елеоноро.",shape=box,color=red];
		1523 -> 1526;
	1524 [label="Заразбуду, Калимос знову грається зі шнурами, і вона може від’єднатися [Завершити розмову]",shape=box,color=red];
		1524 -> 1525;
	1526 [label="Привіт, дружаню.",shape=box,color=blue];
		1526 -> 1527;
	1525 [label="Chat ends.",color=orange];
	1527 [label="Вгадай що.",shape=box,color=blue];
		1527 -> 1528;
		1527 -> 1529;
	1528 [label="У тебе є питання, яким буде життя в майбутньому?",shape=box,color=red];
		1528 -> 1530;
	1529 [label="Ти відростила хвіст.",shape=box,color=red];
		1529 -> 1531;
	1530 [label="Тьху. Я така нудна до біса передбачувана.",shape=box,color=blue];
		1530 -> 1533;
	1531 [label="… тобі б це сподобалося, чи не так?",shape=box,color=blue];
		1531 -> 1532;
	1533 [label="Так, у мене є. Ще одне. Але воно дуже велике, так що потерпи трохи, добре?",shape=box,color=blue];
		1533 -> 1534;
	1532 [label="На жаль, ні. Моя дупця не покращилася від додавання хвоста. Її неможливо покращити, бо вона вже досконала.",shape=box,color=blue];
		1532 -> 1535;
	1534 [label="Зроблю все можливе.",shape=box,color=red];
		1534 -> 1536;
	1535 [label="Однак, у мене є запитання до тебе.",shape=box,color=blue];
		1535 -> 1537;
	1536 [label="Гаразд. Чудово. Отже.",shape=box,color=blue];
		1536 -> 1537;
	1537 [label="Як працюють стосунки у вашому часі? Я маю на увазі, це все ще звичайні «двоє або більше дорослих збираються разом з різним ступенем урочистості»? Чи є якісь правила щодо того, хто з ким може бути?",shape=box,color=blue];
		1537 -> 1538;
		1537 -> 1539;
		1537 -> 1540;
	1538 [label="Це не те, з чим мені доводилося мати справу.",shape=box,color=red];
		1538 -> 1541;
	1539 [label="Це залежить від культури.",shape=box,color=red];
		1539 -> 1542;
	1540 [label="… чому ти запитуєш про це?",shape=box,color=red];
		1540 -> 1543;
	1541 [label="Господи.",shape=box,color=blue];
		1541 -> 1547;
	1542 [label="Так. Звичайно.",shape=box,color=blue];
		1542 -> 1548;
	1543 [label="Check boolean EleanorEntrati",color=orange];
		1543 -> 1544 [label=true,color=green];
		1543 -> 1545 [label=false,color=brown];
	1547 [label="Я знала про твоє ізолювання в Дувірі, але не думала, що воно було НАСТІЛЬКИ.",shape=box,color=blue];
		1547 -> 1552;
	1548 [label="Дай я спробую інакше.",shape=box,color=blue];
		1548 -> 1550;
	1544 [label="Ті двоє на Деймосі, батько й мати. Вони одружена пара. Вони можуть бути велетенськими зараженими залишками орокінів, але вони дуже явно й болісно ОДРУЖЕНІ, так само як мої мама й тато.",shape=box,color=blue];
		1544 -> 1546;
	1545 [label="З тих уривків, які почерпнула з твоєї свідомості, я все ще не бачу стандартні пари людей. Людей, які дуже явно й болісно ОДРУЖЕНІ, так само як мої мама й тато.",shape=box,color=blue];
		1545 -> 1546;
	1552 [label="+15 Chemistry",color=orange];
		1552 -> 1549;
	1550 [label="Погляньмо…",shape=box,color=blue];
		1550 -> 1554;
	1546 [label="Чи було це звичайним для орокінів?",shape=box,color=blue];
		1546 -> 1551;
	1549 [label="Мені дуже шкода, якщо я засмутила тебе своїм запитанням.",shape=box,color=blue];
		1549 -> 1553;
	1554 [label="Гаразд. Тож звідки ти родом, чи нормально для людини мати стосунки, скажімо, з цефалоном?",shape=box,color=blue];
		1554 -> 1555;
		1554 -> 1556;
	1551 [label="Орокіни були пов’язані з правилами і табу. Вони любили ієрархію. Стосунки не могли перетинати соціальні межі. Наприклад дакси не могли бути зі шляхетними орокінами.",shape=box,color=red];
		1551 -> 1554;
	1553 [label="Chat ends.",color=orange];
	1555 [label="Я можу спробувати перетягти Ордіса назад у часі, якщо ти хочеш пробувати з’ясувати…",shape=box,color=red];
		1555 -> 1557;
	1556 [label="… Я ніколи не чув про це і не знаю, як це буде працювати.",shape=box,color=red];
		1556 -> 1560;
	1557 [label="Я намагаюся поставити ТЕОРЕТИЧНЕ питання!",shape=box,color=blue];
		1557 -> 1558;
	1560 [label="Дідько. Дай мені спробувати ще раз.",shape=box,color=blue];
		1560 -> 1561;
	1558 [label="Я не хочу тертися об твого скляного товариша, яким би чарівним він не був",shape=box,color=blue];
		1558 -> 1559;
	1561 [label="Вигадай когось зі свого часу, хто є жіночої статі та небезпечна одночасно. Також сильна. Як майорка Русалка без бісівської одержимості.",shape=box,color=blue];
		1561 -> 1562;
		1561 -> 1563;
	1559 [label="Я намагаюся — і не можу — запитати тебе про ДИСБАЛАНС СИЛИ",shape=box,color=blue];
		1559 -> 1561;
	1562 [label="Ґрінерська снайперка?",shape=box,color=red];
		1562 -> 1564;
	1563 [label="Дакс?",shape=box,color=red];
		1563 -> 1565;
	1564 [label="Добре. Скажімо, ґрінерська снайперка закохується в людину. І це взаємно. Закохані, яких звела доля. Відчайдушно трагічно. Чи можуть вони бути разом?",shape=box,color=blue];
		1564 -> 1566;
		1564 -> 1567;
		1564 -> 1568;
		1564 -> 1569;
	1565 [label="Добре. Скажімо, дівчина-дакс закохується в людину. І це взаємно. Закохані, яких звела доля. Відчайдушно трагічно. Чи можуть вони бути разом?",shape=box,color=blue];
		1565 -> 1566;
		1565 -> 1567;
		1565 -> 1568;
		1565 -> 1569;
	1566 [label="Якщо це було те, чого вони обидва хотіли, звичайно.",shape=box,color=red];
		1566 -> 1570;
	1567 [label="Чому ні?",shape=box,color=red];
		1567 -> 1570;
	1568 [label="Хотілося б побачити, хто спробує їх зупинити.",shape=box,color=red];
		1568 -> 1570;
	1569 [label="Так, але це було б важко.",shape=box,color=red];
		1569 -> 1576;
	1570 [label="Я загнала себе в куток.",shape=box,color=blue];
		1570 -> 1572;
	1576 [label="+5 Chemistry",color=orange];
		1576 -> 1571;
	1572 [label="Чи нормально там, звідки ти родом, коли люди об’єднуються з партнерами, які набагато могутніші та небезпечніші за них? Як у казці «Гамбл і драконові шкарпетки», коли ельфійський принц одружився з велеткою?",shape=box,color=blue];
		1572 -> 1574;
	1571 [label="Дякую.",shape=box,color=blue];
		1571 -> 1573;
	1574 [label="… ти поняття не маєш, про що я, правда.",shape=box,color=blue];
		1574 -> 1578;
		1574 -> 1579;
	1573 [label="Питання: чи можуть мати двоє людей стосунки з різною статурою та різним рівнем смертності? Відповідь: так.",shape=box,color=blue];
		1573 -> 1575;
	1578 [label="Насправді, я напевне, знаю.",shape=box,color=red];
		1578 -> 1582;
	1579 [label="Ні, не зовсім.",shape=box,color=red];
		1579 -> 1580;
	1575 [label="Це все, що я хотіла знати.",shape=box,color=blue];
		1575 -> 1577;
	1582 [label="Я не хочу псувати тобі день. Вибач.",shape=box,color=blue];
		1582 -> 1583;
	1580 [label="Я краще зупинюся. Не хочу здатися повною дурепою.",shape=box,color=blue];
		1580 -> 1581;
	1577 [label="Chat ends.",color=orange];
	1583 [label="Чи можна мені дозволити жалісливу тираду?",shape=box,color=blue];
		1583 -> 1584;
		1583 -> 1585;
	1581 [label="Chat ends.",color=orange];
	1584 [label="Веди далі.",shape=box,color=red];
		1584 -> 1587;
	1585 [label="У мене на це нема часу, вибач. [Завершити розмову]",shape=box,color=red];
		1585 -> 1586;
	1587 [label="Я НЕ кажу, що моє життя не має сенсу без того, щоб з кимось його розділити",shape=box,color=blue];
		1587 -> 1588;
	1586 [label="Chat ends.",color=orange];
	1588 [label="Мене НЕ визначає те, кого я обираю любити",shape=box,color=blue];
		1588 -> 1589;
	1589 [label="Я самодостатня",shape=box,color=blue];
		1589 -> 1590;
	1590 [label="АЛЕ ЯК Я МОЖУ НАВІТЬ ПРИПУСКАТИ МОЖЛИВІСТЬ СТОСУНКІВ, ЯКЩО Я МОГЛА БИ БУКВАЛЬНО ВБИТИ КОГОСЬ ВИПАДКОВО, ЯКЩО Я ЗАХОПЛЮСЯ",shape=box,color=blue];
		1590 -> 1591;
	1591 [label="Ласкаво просимо до Елеонори та її проблем із рогатим богомолом",shape=box,color=blue];
		1591 -> 1592;
	1592 [label="Якщо я коли-небудь знайду цього виродка Ентраті, я перетворю його яйця на сережки. Якщо в нього є яйця.",shape=box,color=blue];
		1592 -> 1593;
		1592 -> 1594;
	1593 [label="Ти завжди можеш зустрічатися з кимось із «Прокльону».",shape=box,color=red];
		1593 -> 1595;
	1594 [label="Зажди. Ти самотня, бо боїшся когось скривдити?",shape=box,color=red];
		1594 -> 1596;
	1595 [label="О СОЛЕ",shape=box,color=blue];
		1595 -> 1597;
	1596 [label="Так.",shape=box,color=blue];
		1596 -> 1601;
	1597 [label="Я БУКВАЛЬНО КУСАЮ ЯЗИКА, ЩОБ НЕ РОЗСМІЯТИСЯ",shape=box,color=blue];
		1597 -> 1598;
	1601 [label="Здається, ти знаєш яка я, краще за мене. Я протофрейм. Я — частково трансформована бойова машина, і мені здається, з кожним днем ця частковість стає все меншою.",shape=box,color=blue];
		1601 -> 1602;
	1598 [label="Єдина з цих чотирьох, з ким би я могла навіть ПОМІРКУВАТИ про побачення — це Аой, але це буде складно через Артура.",shape=box,color=blue];
		1598 -> 1599;
	1602 [label="Той, хто спроєктував бідолашну «Нікс», створив вбивцю. Це я, зараз. Ефективна. Смертельна. Приємна як клеймор.",shape=box,color=blue];
		1602 -> 1603;
	1599 [label="Дякую за таку пропозицію, але ні, навіть через мільйон років.",shape=box,color=blue];
		1599 -> 1600;
	1603 [label="Усе дуже добре, коли мова йде про щоденну роботу, але на корпоративі хто буде цілувати ходячу смертельну пастку під омелою?",shape=box,color=blue];
		1603 -> 1604;
		1603 -> 1606;
	1600 [label="Chat ends.",color=orange];
	1604 [label="Ця випадкова травма, про яку ти турбуєшся. Таке коли-небудь траплялося? Ти колись завдавала болю комусь, з ким була разом?",shape=box,color=red];
		1604 -> 1605;
	1606 [label="З іншого боку, хороша новина полягає в тому, що якщо станеться нещасний випадок, ніхто в Голвенії не залишиться мертвим після перезавантаження…",shape=box,color=red];
		1606 -> 1607;
	1605 [label="Ні, цього не сталося, тому що я, чорт забирай, не дозволила. ТАК?",shape=box,color=blue];
		1605 -> 1608;
	1607 [label="…",shape=box,color=blue];
		1607 -> 1609;
	1608 [label="Немає партнерів — немає жертв. Не варто ризикувати.",shape=box,color=blue];
		1608 -> 1610;
	1609 [label="Я про це не думала.",shape=box,color=blue];
		1609 -> 1611;
	1610 [label="Я краще буду самотньою, ніж зануреною в почуття провини, дякую.",shape=box,color=blue];
		1610 -> 1612;
	1611 [label="Але наші спогади залишаються.",shape=box,color=blue];
		1611 -> 1613;
	1612 [label="Отже, ти була самотня після щеплення «Ентраті»?",shape=box,color=red];
		1612 -> 1618;
	1613 [label="Я не думаю, що хтось захоче мати стосунки з людиною, яка одного разу відкусила тобі голову, навіть якщо вони стануть кращими.",shape=box,color=blue];
		1613 -> 1614;
	1618 [label="+20 Chemistry",color=orange];
		1618 -> 1615;
	1614 [label="Плаксива Луа. Мені треба випити.",shape=box,color=blue];
		1614 -> 1620;
	1615 [label="Правильно. Компроміс, на який я цілком готова піти.",shape=box,color=blue];
		1615 -> 1616;
	1620 [label="Chat ends.",color=orange];
	1616 [label="Вибач. Я не впевнена, що говорити про це було гарною ідеєю.",shape=box,color=blue];
		1616 -> 1617;
	1617 [label="Думаю, мені потрібно трохи побути на самоті.",shape=box,color=blue];
		1617 -> 1619;
	1619 [label="Chat ends.",color=orange];
}