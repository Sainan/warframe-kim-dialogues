		3216 -> 3217;
	3217 [label="Тому що Кая каже, що я така. І в мене був один із тих моментів, коли ти згадуєш всі розмови, які були з кимось, і раптом бачиш себе в новому світлі.",shape=box,color=blue];
		3217 -> 3218;
