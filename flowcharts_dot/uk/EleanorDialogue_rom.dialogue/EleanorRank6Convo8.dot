		j1629420869 -> j3409876019;
	j3362473335 [label="Так. Вона просто промовилася посеред нашої розмови. «Ти класна, але ти мінне поле. Я ніколи не знаю, як ти відреагуєш на щось».",shape=box,color=blue];
