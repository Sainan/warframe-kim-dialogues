		3222 -> 3225;
		3222 -> 3226;
	3223 [label="Так. Вона просто промовилася посеред нашої розмови. «Ти класна, але ти мінне поле. Я ніколи не знаю, як ти відреагуєш на щось».",shape=box,color=blue];
		3223 -> 3218;
