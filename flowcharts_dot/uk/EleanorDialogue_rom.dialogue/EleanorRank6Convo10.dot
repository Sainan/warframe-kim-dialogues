		j3990016252 -> j3947317081;
	j3947317081 [label="Що, якщо те, що я пам’ятаю як Першу Петлю, насправді є Петлею П’ятнадцять Тисяч Сорок Два?",shape=box,color=blue];
		j3947317081 -> j2096752683;
