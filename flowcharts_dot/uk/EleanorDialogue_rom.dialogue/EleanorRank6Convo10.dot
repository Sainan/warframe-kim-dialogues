		j2096752683 -> j1614022319;
	j1614022319 [label="але ПОТІМ я подумала: ні, зачекайте, а якщо це саме той випадок, коли вона зупинилася? Де ми нарешті пройдемо весь шлях від 1999-го до 2000-го?",shape=box,color=blue];
		j1614022319 -> j2343272474;
	j2343272474 [label="Я не хочу мати вигляд повної дурепи в цій одній петлі, яка виявиться вирішальною 1999 року. Я б ніколи не змогла відновити репутацію.",shape=box,color=blue];
		j2343272474 -> j1739452759;
	j1739452759 [label="Одного дня настане сонцестояння, а не просто нескінченна зима, якщо взяти стару примітивну аналогію",shape=box,color=blue];
