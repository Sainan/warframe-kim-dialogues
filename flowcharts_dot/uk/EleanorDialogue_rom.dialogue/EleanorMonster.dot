digraph {
	1458 [label="EleanorMonster begins.",color=orange];
		1458 -> 1459;
	1459 [label="Мандрівниче. Те, що я почула від тебе вчора. Щоб залишити монстра в живих. Ти це серйозно? Мені треба знати.",shape=box,color=blue];
		1459 -> 1460;
		1459 -> 1461;
		1459 -> 1462;
	1460 [label="Звісно, я серйозно.",shape=box,color=red];
		1460 -> 1464;
	1461 [label="Чесно? Я трохи подумав над цим. І, ні. Мені доведеться зупинити тебе, якщо ти перетворишся на монстра.",shape=box,color=red];
		1461 -> 1465;
	1462 [label="[Ігнорувати]",shape=box,color=red];
		1462 -> 1463;
	1464 [label="Не те, щоб я не була надзвичайно вдячна і, чесно кажучи, трохи шокована, але… чому? ЧОМУ ти дозволиш мені жити? Коли всі інші тут готові пустити колю мені в голову?",shape=box,color=blue];
		1464 -> 1466;
		1464 -> 1467;
	1465 [label="Дякую. Ти для мене багато в чому загадка, але тепер я знаю, що ти без вагань пустиш мені кулю в голову, а такі речі важливі на роботі.",shape=box,color=blue];
		1465 -> 1468;
	1463 [label="Chat ends.",color=orange];
	1466 [label="Межа між «героєм» і «почварою» більш розмита, ніж більшість людей хотіли б визнати. Мені довелося воювати проти ґрінерів та Корпусу, а також разом із ними.",shape=box,color=red];
		1466 -> 1473;
	1467 [label="Тому що я думаю, ти одна з найрозумніших і надзвичайно саркастичних людей у моєму житті. Я навіть не думаю, що техногниль може зробити це з тобою.",shape=box,color=red];
		1467 -> 1472;
	1468 [label="Аааа я щойно відчула, як техногниль у моїх клітинах тривожно затремтіла.",shape=box,color=blue];
		1468 -> 1469;
	1473 [label="Я не вірю в слова «Добро» і «Зло». Тільки люди. Чому ти маєш менше прав на існування, ніж я? Можливо, в мене немає язика техногнилі, але я така сама потвора від природи.",shape=box,color=red];
		1473 -> 1474;
	1472 [label="Як… чудово наївно. І напрочуд солодко, в якомусь трагічному сенсі.",shape=box,color=blue];
		1472 -> 1475;
	1469 [label="Думаю, відтепер вона буде поводитися дещо ліпше. Ніщо так не лякає паразита, аніж погроза Солом від господаря, правда?",shape=box,color=blue];
		1469 -> 1470;
	1474 [label="Але ось ти тут, б’єшся зі «Скальдрою» та техногниллю, намагаючись знайти спосіб зупинити Байдужість. Ти явно віриш, що є якась межа, яку треба десь провести.",shape=box,color=blue];
		1474 -> 1476;
		1474 -> 1477;
	1475 [label="Те, що ти віриш, що я вийду з того світу якоюсь королевою вулика з неушкодженим «я», якимось химерним образом зараження, з яким можна було б подружитися або, можливо, навіть обожнювати.",shape=box,color=blue];
		1475 -> 1479;
	1470 [label="Update boolean EleanorNoDate",color=orange];
		1470 -> 1471;
	1476 [label="Байдужість була звільнена Ентраті. Людиною. У цьому була винна людська гординя.",shape=box,color=red];
		1476 -> 1483;
	1477 [label="Захищати людей від смерті — це не те саме, що вважати, що щось має бути знищене або не має права на існування.",shape=box,color=red];
		1477 -> 1478;
	1479 [label="Я б дорікнула тобі, що світ не функціонує, як книжка казок, але… згадую, хто ти та звідки.",shape=box,color=blue];
		1479 -> 1480;
	1471 [label="Chat ends.",color=orange];
	1483 [label="Але техногниль — це не Байдужість. Як що до цього? Щодо біологічнішої, приземленої загрози?",shape=box,color=blue];
		1483 -> 1485;
		1483 -> 1486;
	1478 [label="Переконатися, щоб отару овець не з’їли вовки, — це не те саме, що вийти та вбити всіх вовків за те, що вони злі.",shape=box,color=red];
		1478 -> 1484;
	1480 [label="Тож, я гадаю, що не повинна дивуватися.",shape=box,color=blue];
		1480 -> 1481;
	1485 [label="Ми насправді не знаємо, звідки з’явилася техногниль. Вона може бути створена людиною. Це може бути від чогось зовсім іншого.",shape=box,color=red];
		1485 -> 1488;
	1486 [label="Усе просто, тобі не хочеться смерті від моєї руки. Тому я не стану цього робити. Я дам тобі піти.",shape=box,color=red];
		1486 -> 1489;
	1484 [label="А якщо від Елеонори нічого не залишилося? Що робити, якщо ти не побачиш нічого, крім шиплячого звіра, який гарчить і плюється?",shape=box,color=blue];
		1484 -> 1487;
		1484 -> 1486;
	1481 [label="У будь-якому випадку я вдячна, що ти мене не вб’єш. Хоч щось. Принаймні.",shape=box,color=blue];
		1481 -> 1482;
	1488 [label="А якщо техногниль виявиться черговим відхиленням, створеним людиною, на кшталт вашої «Людини в стіні»? Ти вистежиш мене і в’єш?",shape=box,color=blue];
		1488 -> 1491;
		1488 -> 1492;
	1489 [label="Хоча я вдячна за виконання бажання пані-потвори, але, мабуть, я сподівалася на щось… зваженіше.",shape=box,color=blue];
		1489 -> 1498;
	1487 [label="Звідки я знаю, що від Елеонори нічого не залишилося? Ти говориш про те, як мислить техногниль. Як вона говорить до тебе. Вона явно розумна.",shape=box,color=red];
		1487 -> 1490;
	1482 [label="Chat ends.",color=orange];
	1491 [label="Ні. Я не зможу.",shape=box,color=red];
		1491 -> 1500;
	1492 [label="Так. Якщо техногниль справді неприродна? Тоді… треба знищити.",shape=box,color=red];
		1492 -> 1501;
	1498 [label="+5 Chemistry",color=orange];
		1498 -> 1493;
	1490 [label="Це схоже на розум вулика. Можливо, Елеонора все ще була би там, але не в одному місці, а в мільярді. Хто я, щоб казати, що це «неправильно»?",shape=box,color=red];
		1490 -> 1494;
	1500 [label="Ти суперечиш собі. Якщо ти хочеш зупинити одне техногенне відхилення, чому б не зупинити друге?",shape=box,color=blue];
		1500 -> 1506;
		1500 -> 1507;
	1501 [label="Дякую. Ти для мене багато в чому загадка, але тепер я знаю, що ти без вагань пустиш мені кулю в голову, а такі речі важливі на роботі.",shape=box,color=blue];
		1501 -> 1502;
	1493 [label="У будь-якому випадку я вдячна, що ти мене не вб’єш. Хоч щось. Принаймні.",shape=box,color=blue];
		1493 -> 1499;
	1494 [label="Саме тоді, коли я думаю, що не можу обожнювати тебе ще більше, я знову сиджу тут і плачу від щастя",shape=box,color=blue];
		1494 -> 1496;
	1506 [label="Тому що в мене є почуття до тебе. [Зізнатися в почуттях]",shape=box,color=red];
		1506 -> 1508;
	1507 [label="Тому що ти занадто багато значиш для мене як подруга.",shape=box,color=red];
		1507 -> 1509;
	1502 [label="Аааа я щойно відчула, як техногниль у моїх клітинах тривожно затремтіла.",shape=box,color=blue];
		1502 -> 1503;
	1499 [label="Chat ends.",color=orange];
	1496 [label="+20 Chemistry",color=orange];
		1496 -> 1495;
	1508 [label="Запитувати мене, чи вб’ю я тебе, це просто *жорстоко*, Елеоноро. Коли думка про те, що ти мертва або страждаєш від болю, просто…",shape=box,color=red];
		1508 -> 1510;
	1509 [label="Запитувати мене, чи вб’ю я тебе, це просто *жорстоко*, Елеоноро. Ти моя подруга. Ти для мене як рідна.",shape=box,color=red];
		1509 -> 1511;
	1503 [label="Думаю, відтепер вона буде поводитися дещо ліпше. Ніщо так не лякає паразита, аніж погроза Солом від господаря, правда?",shape=box,color=blue];
		1503 -> 1504;
	1495 [label="Я мушу йти, але дякую, дякую, ДЯКУЮ",shape=box,color=blue];
		1495 -> 1497;
	1510 [label="Річ у тому? Ні. Я не зможу. Тому що є надія, що ти будеш існувати десь там? У якійсь формі? Де-небудь? Мені б цього вистачило.",shape=box,color=red];
		1510 -> 1512;
	1511 [label="Річ у тому? Ні. Я не зможу. Тому що є надія, що ти будеш існувати десь там? У якійсь формі? Де-небудь? Мені б цього вистачило.",shape=box,color=red];
		1511 -> 1513;
	1504 [label="Update boolean EleanorNoDate",color=orange];
		1504 -> 1505;
	1497 [label="Chat ends.",color=orange];
	1512 [label="Мені шкода. Я не можу цього зробити. Мені треба йти.",shape=box,color=red];
		1512 -> 1514;
	1513 [label="Мені шкода. Я не можу цього зробити. Мені треба йти.",shape=box,color=red];
		1513 -> 1518;
	1505 [label="Chat ends.",color=orange];
	1514 [label="Update boolean EleanorConfession",color=orange];
		1514 -> 1516;
	1518 [label="+20 Chemistry",color=orange];
		1518 -> 1520;
	1516 [label="+20 Chemistry",color=orange];
		1516 -> 1515;
	1520 [label="Ох, Елеоноро, цього разу ти вляпалася…",shape=box,color=blue];
		1520 -> 1519;
	1515 [label="Ой… йой, що я наробила…",shape=box,color=blue];
		1515 -> 1517;
	1519 [label="Chat ends.",color=orange];
	1517 [label="Chat ends.",color=orange];
}