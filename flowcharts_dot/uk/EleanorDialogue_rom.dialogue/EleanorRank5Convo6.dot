digraph {
	2541 [label="EleanorRank5Convo6 begins.",color=orange];
		2541 -> 2542;
	2542 [label="Тобі не здалося, що торговельний центр виглядає трохи інакше сьогодні?",shape=box,color=blue];
		2542 -> 2543;
	2543 [label="Нічого особливого та очевидного. Ще кілька посмішок на кількох обличчях. Сміх то тут, то там. Бризки щастя в повітрі.",shape=box,color=blue];
		2543 -> 2544;
		2543 -> 2545;
	2544 [label="Це залежить від тебе, чи не так?",shape=box,color=red];
		2544 -> 2547;
	2545 [label="ЗАРАЗБУДУ [Завершити розмову]",shape=box,color=red];
		2545 -> 2546;
	2547 [label="Просто мій спосіб віддячити. Як відомо, телепат може надсилати, так само як і отримувати. Це не обов’язково має бути струмінь зі шланга для однієї людини. Це може бути схожим на розпилення туману на території.",shape=box,color=blue];
		2547 -> 2548;
	2546 [label="Chat ends.",color=orange];
	2548 [label="Чи є у вас, звідки ти родом, зрошувачі для газону?",shape=box,color=blue];
		2548 -> 2549;
		2548 -> 2550;
	2549 [label="У нас є НДРРД і такі ж дрони. Вони доглядали за рослинами на «Заримені». Це те, що ти маєш на увазі?",shape=box,color=red];
		2549 -> 2551;
	2550 [label="Зро…шувачі?",shape=box,color=red];
		2550 -> 2552;
	2551 [label="Саме так.",shape=box,color=blue];
		2551 -> 2553;
	2552 [label="Так, сонце, зрошувачі. Розпилювачі води для підтримання газону у вологому стані.",shape=box,color=blue];
		2552 -> 2554;
	2553 [label="Коли я була маленькою дівчинкою, я обожнювала зрошувачі для газонів. Вони були чарівні. Коли сонце було найяскравішим, у них можна було зловити веселку. Ти пробігаєш крізь них і відчуваєш приємний холодок на своєму тілі.",shape=box,color=blue];
		2553 -> 2555;
	2554 [label="Також ідеально підходить для того, щоби притискати обличчя свого брата, поки він не закричить.",shape=box,color=blue];
		2554 -> 2555;
	2555 [label="«Щастя — це зрошувачі для газону». Напиши це на вітальній листівці.",shape=box,color=blue];
		2555 -> 2556;
	2556 [label="Здається, у тебе сьогодні гарний настрій. Приємно бачити тебе такою.",shape=box,color=red];
		2556 -> 2557;
	2557 [label="Так і є. І я не розумію, чому я маю тримати це в собі. Тож я наповнюю ним весь торговельний центр.",shape=box,color=blue];
		2557 -> 2558;
		2557 -> 2559;
		2557 -> 2560;
	2558 [label="Хіба це не схоже на наркотики?",shape=box,color=red];
		2558 -> 2561;
	2559 [label="Транслюєш позитивний настрій? Чому б ні. Я не бачу, чим це відрізняється від вмикання музики.",shape=box,color=red];
		2559 -> 2562;
	2560 [label="То сьогодні я можу побачити посмішку Артура?",shape=box,color=red];
		2560 -> 2563;
	2561 [label="… чудово. Я тут намагаюся бути таємною феєю щастя, що розбризкує радість, а натомість перетворююся на злого наркотичного гобліна. Мій веселий настрій стрімко впав.",shape=box,color=blue];
		2561 -> 2564;
	2562 [label="О! Гарна аналогія!",shape=box,color=blue];
		2562 -> 2566;
	2563 [label="Можливо. Я на це сподіваюся. Йому довелося стільки всього пережити.",shape=box,color=blue];
		2563 -> 2567;
	2564 [label="Добре. Я перестану.",shape=box,color=blue];
		2564 -> 2565;
	2566 [label="Якщо Аой може впливати на настрій за допомогою музики, то я можу робити це за допомогою вібрацій, чи не так?",shape=box,color=blue];
		2566 -> 2568;
	2567 [label="Так багато змінилося відтоді, як ти тут. Я маю на увазі не лише нас із тобою. Навіть торговельний центр.",shape=box,color=blue];
		2567 -> 2568;
	2565 [label="Chat ends.",color=orange];
	2568 [label="Я рада, що Аой переконала мене залишитися.",shape=box,color=blue];
		2568 -> 2569;
		2568 -> 2570;
	2569 [label="Зажди. Що вона зробила?",shape=box,color=red];
		2569 -> 2571;
	2570 [label="Назад. Щось пройшло повз мене.",shape=box,color=red];
		2570 -> 2571;
	2571 [label="Я тобі не казала?",shape=box,color=blue];
		2571 -> 2572;
	2572 [label="Ох. Це було ще до твого прибуття. Ми цілий день намагалися знищити лігво техногнилі. В повітрі висіла вбивча напруга. Бійки зазвичай вгамовують нашу злість і залишають нас занадто виснаженими, щоб кидатися один на одного, але цього дня все було інакше.",shape=box,color=blue];
		2572 -> 2573;
	2573 [label="Пам’ятаю, Артур сказав щось на кшталт «ми повторимо все це завтра», і це вдарило по всіх нас, як кувалдою. Дорогою назад до торговельного центру ніхто не промовив жодного слова.",shape=box,color=blue];
		2573 -> 2574;
		2573 -> 2575;
		2573 -> 2576;
	2574 [label="Ого. Гарний спосіб підняти командний дух, Артуре.",shape=box,color=red];
		2574 -> 2579;
	2575 [label="Він може бути таким чарівником…",shape=box,color=red];
		2575 -> 2579;
	2576 [label="Багато чого на його плечах. Це дорого коштує.",shape=box,color=red];
		2576 -> 2577;
	2579 [label="Думаю, він просто намагався змусити нас зосередитися на роботі. Але я відчувала себе розбитою. Артур і Аой не розмовляли, Амір так сильно діяв на нерви Квінсі, що я почала побоюватися за його життя, а Летті косилася на мене при кожній нагоді.",shape=box,color=blue];
		2579 -> 2580;
	2577 [label="Так. Зазвичай йому вдається приховати це, навіть коли він уже на межі. Але, мабуть, тоді він не впорався.",shape=box,color=blue];
		2577 -> 2578;
	2580 [label="Тоді я провела багато часу дивлячись у дзеркало. Я продовжувала уявляти, як моє відображення хапає мене за горло та шипить: «ТИ — проблема. Якби не ти, нічого б цього не було».",shape=box,color=blue];
		2580 -> 2581;
		2580 -> 2582;
	2578 [label="Він перегорів, намагаючись утримати команду разом.",shape=box,color=blue];
		2578 -> 2579;
	2581 [label="Звучить так, ніби всі інші для різноманітності влізли у ТВОЮ голову.",shape=box,color=red];
		2581 -> 2583;
	2582 [label="Це схоже на те лайно, яке видає Летті.",shape=box,color=red];
		2582 -> 2584;
	2583 [label="О, це були не вони. Це була я. Того дня вирвалися назовні всі затаєні сумніви та ненависть до себе, які я стримувала в собі.",shape=box,color=blue];
		2583 -> 2585;
	2584 [label="Дякую. Я знаю, що ти на моєму боці, і це багато для мене значить.",shape=box,color=blue];
		2584 -> 2586;
	2585 [label="Я подумала: цій команді потрібен цап-відбувайло.",shape=box,color=blue];
		2585 -> 2587;
	2586 [label="Я стільки разів чула цю фразу від Летті, що врешті-решт подумала: можливо, вона має рацію. Залишаючись тут, я наражаю всіх на небезпеку.",shape=box,color=blue];
		2586 -> 2588;
	2587 [label="Монстр. Хтось винний.",shape=box,color=blue];
		2587 -> 2588;
	2588 [label="Я розробила цілий план. Я вислизала вночі, ховалася в місті, де Артур ніколи б мене не знайшов, і — цим я пишалася найбільше — продовжувала допомагати на відстані.",shape=box,color=blue];
		2588 -> 2589;
		2588 -> 2590;
	2589 [label="Думаю, він би тебе знайшов. Він досить рішучий.",shape=box,color=red];
		2589 -> 2591;
	2590 [label="Найімовірніший сценарій — він би загинув, намагаючись знайти тебе.",shape=box,color=red];
		2590 -> 2592;
	2591 [label="Як? Амір не може відстежувати телепатію.",shape=box,color=blue];
		2591 -> 2593;
	2592 [label="Намагаєшся звинуватити мене?",shape=box,color=blue];
		2592 -> 2594;
	2593 [label="Я збиралася стати шляхетним вигнанцем. Я би присідала на дахах, з обвітреним обличчям і рішучим поглядом. Я би могла доповідати про накопичення техногнилі, повідомляти «Прокльон», де «Скальдра» встановлює блокпости, навіть виступала в ролі аварійного ретранслятора. Щоразу рятуючи дупу Летті, я би змушувала її відчувати це по-справжньому. Дріб’язково? Безумовно.",shape=box,color=blue];
		2593 -> 2595;
	2594 [label="Не турбуйся. Я і так почуваюся жахливо.",shape=box,color=blue];
		2594 -> 2598;
	2595 [label="Я обрала момент. Я дочекалася, поки Амір засне. Потім я одягнула довге пальто й попрямувала до гаража так тихо, як тільки могла.",shape=box,color=blue];
		2595 -> 2596;
	2598 [label="Chat ends.",color=orange];
	2596 [label="Захисна решітка опустилася сама собою. Я обернулася і побачила Аой.",shape=box,color=blue];
		2596 -> 2597;
	2597 [label="Ми проговорили всю ніч і плакали в обіймах одне одного. Їй теж було боляче. Глибоко. Коли зійшло сонце, я вирішила залишитися.",shape=box,color=blue];
		2597 -> 2599;
		2597 -> 2600;
		2597 -> 2601;
	2599 [label="У тебе ще є час передумати.",shape=box,color=red];
		2599 -> 2602;
	2600 [label="Аой чудова. Я радію, що вона була поруч з тобою.",shape=box,color=red];
		2600 -> 2604;
	2601 [label="Це була удача.",shape=box,color=red];
		2601 -> 2604;
	2602 [label="Який би гротескний імпульс не спонукав тебе написати це, я сподіваюся, що ти ним захлинешся.",shape=box,color=blue];
		2602 -> 2603;
	2604 [label="+20 Chemistry",color=orange];
		2604 -> 2605;
	2603 [label="Chat ends.",color=orange];
	2605 [label="Так. Думаю, нам усім шістьом судилося бути тут у новорічну ніч. І тобі, звісно. Незнайомець у дверях, що приносить удачу.",shape=box,color=blue];
		2605 -> 2606;
	2606 [label="Chat ends.",color=orange];
}