digraph {
	2081 [label="EleanorRank5Convo1 begins.",color=orange];
		2081 -> 2082;
	2082 [label="Check boolean EleanorDating",color=orange];
		2082 -> 2083 [label=true,color=green];
		2082 -> 2084 [label=false,color=brown];
	2083 [label="Привіт, серденько. Я відчуваю себе трохи меланхолічно. В тебе є хвилинка?",shape=box,color=blue];
		2083 -> 2085;
		2083 -> 2086;
	2084 [label="Привіт. Я відчуваю себе трохи меланхолічно. В тебе є хвилинка?",shape=box,color=blue];
		2084 -> 2085;
		2084 -> 2086;
	2085 [label="Для тебе, завжди.",shape=box,color=red];
		2085 -> 2088;
	2086 [label="Мені *дуже* шкода, але я не можу зараз. [Завершити розмову]",shape=box,color=red];
		2086 -> 2087;
	2088 [label="Щиро дякую.",shape=box,color=blue];
		2088 -> 2089;
	2087 [label="Chat ends.",color=orange];
	2089 [label="Ти знаєш, хто така Жінка в капюшоні?",shape=box,color=blue];
		2089 -> 2090;
	2090 [label="Check boolean LettieFantasma2",color=orange];
		2090 -> 2091 [label=true,color=green];
		2090 -> 2092 [label=true,color=green];
		2090 -> 2093 [label=true,color=green];
		2090 -> 2094 [label=true,color=green];
		2090 -> 2095 [label=true,color=green];
		2090 -> 2092 [label=false,color=brown];
		2090 -> 2093 [label=false,color=brown];
		2090 -> 2094 [label=false,color=brown];
		2090 -> 2095 [label=false,color=brown];
	2091 [label="La Flaca?",shape=box,color=red];
		2091 -> 2096;
	2092 [label="… убивця «Скальдри»?",shape=box,color=red];
		2092 -> 2098;
	2093 [label="Один з образів Луа?",shape=box,color=red];
		2093 -> 2099;
	2094 [label="Це ваша назва Смерті?",shape=box,color=red];
		2094 -> 2099;
		2094 -> 2101;
	2095 [label="Без поняття.",shape=box,color=red];
		2095 -> 2101;
	2096 [label="+5 Chemistry",color=orange];
		2096 -> 2097;
	2098 [label="Не зовсім.",shape=box,color=blue];
		2098 -> 2101;
	2099 [label="+5 Chemistry",color=orange];
		2099 -> 2100;
	2101 [label="Вона — Смерть. Також одна з форм Луа, залежно від того, яких звичаїв ти дотримуєшся. Вона приходить і вкладає тебе в ліжко, коли закінчується шалений день Життя, цілує на ніч і співає тобі перед сном.",shape=box,color=blue];
		2101 -> 2102;
		2101 -> 2103;
	2097 [label="Ха. Теревениш із нашою любою Летті, я бачу. Так.",shape=box,color=blue];
		2097 -> 2101;
	2100 [label="Так, взагалі-то.",shape=box,color=blue];
		2100 -> 2101;
	2102 [label="Ти не жартувала про меланхолію, чи не так?",shape=box,color=red];
		2102 -> 2104;
	2103 [label="Це буде одна з тих розмов «влаштовуйся зручніше, мандрівниче, це займе хвилинку», чи не так?",shape=box,color=red];
		2103 -> 2105;
	2104 [label="Дружаньо. Все, що нам дав Ентраті — владу, силу, броньовані дупи… я б обміняла все це на крихту впевненості, що смерть — це не кінець.",shape=box,color=blue];
		2104 -> 2108;
	2105 [label="… так і мало бути.",shape=box,color=blue];
		2105 -> 2106;
	2108 [label="Я намагалася. Мені неприємно в цьому зізнаватися, але іноді, коли ми виходимо на патрулювання і йде бій, я заглядаю в думки вмираючих і намагаюся пережити цей момент разом із ними.",shape=box,color=blue];
		2108 -> 2109;
		2108 -> 2110;
	2106 [label="Забудь. Я впевнена, що у тебе є важливіші справи.",shape=box,color=blue];
		2106 -> 2107;
	2109 [label="Елеоноро, це огидно. Ти не маєш права.",shape=box,color=red];
		2109 -> 2111;
	2110 [label="Ти намагаєшся їх заспокоїти?",shape=box,color=red];
		2110 -> 2114;
	2107 [label="Chat ends.",color=orange];
	2111 [label="Я знаю. Я ЗНАЮ.",shape=box,color=blue];
		2111 -> 2112;
	2114 [label="Одного разу. Що тут поганого, правда? Вони все одно помирають. Це була молода десантниця «Скальдри». Вона йшла на мене, і я вистрілила їй у груди.",shape=box,color=blue];
		2114 -> 2115;
	2112 [label="Я кажу собі, що намагаюся допомогти, але правда в тому, що я просто хотіла подивитися. Твоя правда. Це було огидно.",shape=box,color=blue];
		2112 -> 2113;
	2115 [label="Я опустилася на коліна біля неї, коли вона захлиналася кров’ю, і намагалася сказати їй, що все гаразд, що біль закінчиться, і скоро вона буде зі своєю сім’єю, яка пішла раніше, і всі ті заспокійливі речі, про які ти думаєш, коли маєш справити панахиду на смертному одрі.",shape=box,color=blue];
		2115 -> 2116;
	2113 [label="Chat ends.",color=orange];
	2116 [label="Вона була нажахана. Те, що залишилося від її свідомості, шкреблося, як пацюк у баку з водою. Коли вона відчула, що я подумки з нею, вона намагалася зачепитися за мене. Вона благала мене про допомогу. Під усім цим було це… я навіть не знаю, як це назвати…",shape=box,color=blue];
		2116 -> 2117;
		2116 -> 2118;
		2116 -> 2119;
	2117 [label="Надія?",shape=box,color=red];
		2117 -> 2120;
	2118 [label="Страх?",shape=box,color=red];
		2118 -> 2120;
	2119 [label="Заперечення?",shape=box,color=red];
		2119 -> 2120;
	2120 [label="Заперечення. Вона не вірила, що може померти. І навіщо їй це робити? Вона завжди була там раніше. Як смерть могла забрати її зараз?",shape=box,color=blue];
		2120 -> 2121;
	2121 [label="Кожного дня свого життя ти сприймаєш СЕБЕ як належне. Ти там, коли прокидаєшся, і ти там, коли спиш. Ти живеш усе своє життя в домі, зробленому з Тебе. Ти жодного разу не виходиш назовні, бо не можеш.",shape=box,color=blue];
		2121 -> 2122;
	2122 [label="А потім одного дня ти чуєш, як будинок руйнують.",shape=box,color=blue];
		2122 -> 2123;
		2122 -> 2124;
	2123 [label="Чому ти її не допомогла?",shape=box,color=red];
		2123 -> 2125;
	2124 [label="Ти залишилася з нею до кінця?",shape=box,color=red];
		2124 -> 2126;
	2125 [label="Що на твою думку, я мала робити? Покликати Летті? Залікувати зяючу рану на грудях? Усе тому, що я бачила, через що вона пройшла, зблизька?",shape=box,color=blue];
		2125 -> 2127;
	2126 [label="Так. Я була налякана до всирачки. Коли вона відчула, що ковзає по краю, я була впевнена, що мене потягне разом із нею. Я відчувала, як мене тягне на дно.",shape=box,color=blue];
		2126 -> 2128;
	2127 [label="Зі «Скальдрою» це — вбити або бути вбитим. Вони не пропонують нам розкіш милосердя.",shape=box,color=blue];
		2127 -> 2129;
	2128 [label="Але я мусила залишитися. Я не могла залишити її помирати на самоті.",shape=box,color=blue];
		2128 -> 2130;
	2129 [label="Chat ends.",color=orange];
	2130 [label="Хоча, гадаю, зрештою, так і було. Я не могла зробити цей останній крок разом із нею.",shape=box,color=blue];
		2130 -> 2131;
		2130 -> 2132;
	2131 [label="Що ти винесла з цього досвіду?",shape=box,color=red];
		2131 -> 2133;
	2132 [label="Тож ти побачила те, що сподівалася побачити?",shape=box,color=red];
		2132 -> 2134;
	2133 [label="Я нічому не навчилася.",shape=box,color=blue];
		2133 -> 2135;
	2134 [label="Ні.",shape=box,color=blue];
		2134 -> 2135;
	2135 [label="Але вона це зробила. Вона побачила обличчя своєї матері, дітей, з якими ходила до школи, свого кота, двоюрідного брата, який потонув. Але вони не були примарами чи духами. Лише спогади, виштовхнуті на поверхню вмираючим мозком, який відчайдушно шукає, за що б зачепитися.",shape=box,color=blue];
		2135 -> 2137;
	2137 [label="Потім дім її індивідуальності почав розвалюватися навколо неї. Перед смертю вона широко розплющила очі. Я думаю, в ту секунду, вперше в житті, вона по-справжньому зрозуміла, що таке смерть.",shape=box,color=blue];
		2137 -> 2136;
		2137 -> 2138;
	2136 [label="Помираюча людина розуміє, що таке смерть. Яка проникливість, Елеоноро.",shape=box,color=red];
		2136 -> 2139;
	2138 [label="Що ти маєш на увазі? Всі знають, що таке смерть.",shape=box,color=red];
		2138 -> 2140;
	2139 [label="Слухай. Наступного разу, коли ти відчуєш потребу викрити мене в маячні, ти не маєш зобов’язання вислуховувати її до кінця.",shape=box,color=blue];
		2139 -> 2141;
	2140 [label="Ні. Ми думаємо, що ми знаємо, але весь наш досвід поверховий.",shape=box,color=blue];
		2140 -> 2143;
	2141 [label="Ніхто не змушує тебе говорити зі мною. Бувай.",shape=box,color=blue];
		2141 -> 2142;
	2143 [label="Усе своє життя вона була схожа на жінку, яка живе в будинку без світла, і все, що у неї було, — це ліхтарик. Вона проливала світло своєї обізнаності на те чи інше місце. Спогад, завдання, взаємодія.",shape=box,color=blue];
		2143 -> 2144;
	2142 [label="Chat ends.",color=orange];
	2144 [label="Вона переходила з кімнати в кімнату, досліджувала підвали уві сні, але завжди це був замкнений, кінцевий процес. Ти мене розумієш?",shape=box,color=blue];
		2144 -> 2145;
		2144 -> 2146;
	2145 [label="Не зовсім, але продовжуй.",shape=box,color=red];
		2145 -> 2147;
	2146 [label="Так.",shape=box,color=red];
		2146 -> 2147;
	2147 [label="Потім, коли будинок був зруйнований, а її особистість розпалася на шматки навколо, раптом ліхтарик не світив на стіну, на книгу, на диван. Він світив у безмежне небо. Її свідомість спалахнула в нескінченність, не маючи перешкоди у вигляді неї самої.",shape=box,color=blue];
		2147 -> 2149;
		2147 -> 2150;
		2147 -> 2151;
	2149 [label="Але усвідомлення помирає, коли помирає тіло. Те, що ти відчула, було лише спазмом в її вмираючому мозку.",shape=box,color=red];
		2149 -> 2148;
	2150 [label="Ти думаєш, що «усвідомлення» — це те, ким ми є насправді, а все інше — лише оболонка?",shape=box,color=red];
		2150 -> 2155;
	2151 [label="Ого. Так глибоко. Ти застрелила людину, а потім порушила її приватне життя.",shape=box,color=red];
		2151 -> 2156;
	2148 [label="Я намагалася сказати собі це багато разів.",shape=box,color=blue];
		2148 -> 2152;
	2155 [label="+5 Chemistry",color=orange];
		2155 -> 2154;
	2156 [label="Слухай. Наступного разу, коли ти відчуєш потребу викрити мене в маячні, ти не маєш зобов’язання вислуховувати її до кінця.",shape=box,color=blue];
		2156 -> 2157;
	2152 [label="Я не можу повірити, що це було не що інше, як відключення мозку. Відчуття було таке, ніби душа виривається на волю.",shape=box,color=blue];
		2152 -> 2153;
	2154 [label="Я знаю, що це не має жодного сенсу. Це здається таким парадоксальним, думка про те, що ми — насамперед точка зору, а особистість — у другу чергу.",shape=box,color=blue];
		2154 -> 2159;
	2157 [label="Ніхто не змушує тебе говорити зі мною. Бувай.",shape=box,color=blue];
		2157 -> 2158;
	2153 [label="Chat ends.",color=orange];
	2159 [label="Як ти ставишся до всього цього?",shape=box,color=red];
		2159 -> 2160;
	2158 [label="Chat ends.",color=orange];
	2160 [label="Заспокійливо? Мені подобається думка, що хтось із нас виживає. Мені подобається думати, що смерть — це не видалення з всесвіту, а видалення всього, що відокремлює тебе від всесвіту.",shape=box,color=blue];
		2160 -> 2161;
	2161 [label="Але те, що робить нас НАМИ — це не просто сира свідомість. Це пам’ять, емоції, думки, різні нашарування. Коли ти втрачаєш все це, ти втрачаєш саму особистість, навіть якщо ця іскра якимось чином зберігається.",shape=box,color=red];
		2161 -> 2162;
	2162 [label="Я знаю.",shape=box,color=blue];
		2162 -> 2163;
	2163 [label="Чесно кажучи, саме тому я хотіла поговорити з тобою про привидів Порожнечі, цефалонів і всі ті речі з твого часу. Я хочу знати, чи зможемо ми коли-небудь поспілкуватися з тими, кого ми втратили.",shape=box,color=blue];
		2163 -> 2164;
	2164 [label="Справжнє спілкування, а не якесь голограмне лайно. Таке, що дозволяє тобі точно знати, що думає людина.",shape=box,color=blue];
		2164 -> 2165;
		2164 -> 2166;
	2165 [label="Ні, не зовсім. Навіть в майбутньому люди, яких ми втратили… на щастя чи на біду? Просто… пішли.",shape=box,color=red];
		2165 -> 2167;
	2166 [label="Елеоноро, ближче до справи. Кого ти втратила?",shape=box,color=red];
		2166 -> 2169;
	2167 [label="Я зрозуміла. Можливо, є двері, які ми ніколи не зможемо відчинити. Може, це й на краще.",shape=box,color=blue];
		2167 -> 2168;
	2169 [label="Його звали Крістофер. Він був найкращим другом Артура.",shape=box,color=blue];
		2169 -> 2170;
	2168 [label="Chat ends.",color=orange];
	2170 [label="Ми були заручені. Я думала, що кохаю його.",shape=box,color=blue];
		2170 -> 2171;
	2171 [label="Update boolean EleanorChristopher1",color=orange];
		2171 -> 2172;
	2172 [label="+10 Chemistry",color=orange];
		2172 -> 2173;
	2173 [label="Вибач. Я не можу. Поговоримо іншим разом.",shape=box,color=blue];
		2173 -> 2174;
	2174 [label="Chat ends.",color=orange];
}