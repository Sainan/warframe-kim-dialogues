digraph {
	1803 [label="EleanorRank4Convo5 begins.",color=orange];
		1803 -> 1804;
	1804 [label="Королівство, яке колись було твоїм. Дувірі. Це ж не вигадка, правда?",shape=box,color=blue];
		1804 -> 1805;
		1804 -> 1806;
	1805 [label="Можливо так, можливо ні. Це місце і персонажі прийшли з моєї улюбленої дитячої книжки. «Дувірські казки». Вони були втілені мною через Порожнечу. ",shape=box,color=red];
		1805 -> 1807;
	1806 [label="Мені так набридло говорити про Дувірі…",shape=box,color=red];
		1806 -> 1813;
	1807 [label="Як тобі це вдалося?",shape=box,color=blue];
		1807 -> 1809;
		1807 -> 1810;
	1813 [label="+5 Chemistry",color=orange];
		1813 -> 1808;
	1809 [label="Я… не було нікого окрім мене. Гадаю, інші діти загинули або були врятовані. Я трохи плутаюся в подробицях.",shape=box,color=red];
		1809 -> 1811;
	1810 [label="Це було не зовсім навмисно. Все, що я пам’ятаю…",shape=box,color=red];
		1810 -> 1811;
	1808 [label="Йой. Моя помилка.",shape=box,color=blue];
		1808 -> 1814;
	1811 [label="Янголи наближалися, прориваючись крізь стіни, і нікуди було тікати. У мене була книга. Пам’ятаю свої думки: «Ось де я можу бути в безпеці».",shape=box,color=red];
		1811 -> 1812;
	1814 [label="Це було необачно з мого боку, чи не так? Це місце було не зовсім схоже на табір для відпочинку.",shape=box,color=blue];
		1814 -> 1815;
	1812 [label="Янголи? У наш час янголи вважаються доброзичливими істотами. Іноді страшні, але на боці добра. Якщо тільки ти не маєш на увазі полеглих.",shape=box,color=blue];
		1812 -> 1817;
	1815 [label="Мені дуже шкода. Відтепер я буду тримати свою цікавість під контролем.",shape=box,color=blue];
		1815 -> 1816;
	1817 [label="За моїх часів це практично не змінилося. Янголи — це крилаті, сяючі створіння зі старих казок, які допомагають добрим людям. Я говорю про янголів Порожнечі. Це зовсім інші істоти.",shape=box,color=red];
		1817 -> 1818;
	1816 [label="Chat ends.",color=orange];
	1818 [label="Зрозуміло. Я не можу собі уявити, що хтось під назвою «янгол Порожнечі» налітає та благословляє новонароджену дитину.",shape=box,color=blue];
		1818 -> 1819;
	1819 [label="Наскільки я можу зрозуміти, це були люди. Коли пісня янголів доходить до них, вони починають змінюватися. Коли більше не можуть цьому опиратися, то самі стають янголами.",shape=box,color=red];
		1819 -> 1820;
	1820 [label="Майбутнє, як ти його описуєш, звучить до біса жахливо.",shape=box,color=blue];
		1820 -> 1821;
	1821 [label="Я не можу звинувачувати тебе у бажанні сховатися від цих янголів Порожнечі. Особливо, якщо вони були…",shape=box,color=blue];
		1821 -> 1822;
	1822 [label="Ох. У мене з’явилося відчуття. Вони не були твоїми батьками, чи не так?",shape=box,color=blue];
		1822 -> 1823;
		1822 -> 1824;
		1822 -> 1825;
	1823 [label="Я маю впевненість, що мої батьки померли.",shape=box,color=red];
		1823 -> 1826;
	1824 [label="Вони могли бути. Інші діти чули, як батьки кликали їх.",shape=box,color=red];
		1824 -> 1826;
	1825 [label="Думаю, вони там були. Квін попередив мене не шукати знайомих голосів. Мабуть, саме це він мав на увазі.",shape=box,color=red];
		1825 -> 1826;
	1826 [label="Мені так шкода. Я рада, що знайшлася безпечна гавань, навіть якщо вона не залишилася такою.",shape=box,color=blue];
		1826 -> 1827;
	1827 [label="Довгий час там було безпечно. Досить довго, щоб забутися. Гадаю, це те, що мені хотілося зробити.",shape=box,color=red];
		1827 -> 1828;
	1828 [label="Але як це тобі вдалося? Ти був ще дитиною. Що дало тобі силу створити ціле королівство з нічого?",shape=box,color=blue];
		1828 -> 1829;
		1828 -> 1830;
		1828 -> 1831;
	1829 [label="Діти цікаві тим, що вони ще не знають, чого не зможуть. Мені було невтямки, що не зможу. Тому й вдалося.",shape=box,color=red];
		1829 -> 1833;
	1830 [label="У мене було стільки емоцій, одразу, що я… просто… якось вдалося щось із ними зробити. Це важко пояснити.",shape=box,color=red];
		1830 -> 1832;
	1831 [label="Порожнеча — це не «ніщо». Я знаю, що це звучить так, ніби так і має бути, але це не так. Альбрехт це довів.",shape=box,color=red];
		1831 -> 1832;
	1833 [label="Коли мені було п’ять, я хотіла бути відьмою. Я закричала «Абракадабра» і стрибнула з верхніх сходів. Я не знала, що не вмію літати. Але швидко дізналася.",shape=box,color=blue];
		1833 -> 1834;
	1832 [label="Ми знаємо про неї дуже мало, навіть зараз. Але навіть орокіни зрозуміли одну річ: Порожнеча реагує на людські емоції. ",shape=box,color=red];
		1832 -> 1836;
	1834 [label="Сила для створення Дувірі, мабуть, прийшла не від тебе, а від когось іншого. Тобі вдалося скористатися нею, щоб зробити щось неймовірне, але вона не була твоєю.",shape=box,color=blue];
		1834 -> 1835;
	1836 [label="Я ЗРОЗУМІЛА. Отже, якщо зазирнути в Порожнечу з… хм, скажімо, «голодом»… то можна створити бродячого напівголодного вовка. Або, можливо, королівський бенкет. Або буханець хліба зі скреготом вовчих зубів. ",shape=box,color=blue];
		1836 -> 1837;
	1835 [label="Принаймні, спочатку. Але зараз воно в тобі. Дика енергія. Петлі часу. Боги, ти диво.",shape=box,color=blue];
		1835 -> 1838;
	1837 [label="Яка жахлива, хвилююча думка.",shape=box,color=blue];
		1837 -> 1838;
	1838 [label="Чому орокіни вирішили, що це гарна ідея — запустити в Порожнечу зореліт, повний дітей? Хіба це не була емоційна бомба уповільненої дії, що чекала на вибух? ",shape=box,color=blue];
		1838 -> 1839;
	1839 [label="Саме для цього і була створена ця книга історій. На перший погляд, мова йшла про персонажів при дворі божевільного короля, який щодня змінював свій настрій. ",shape=box,color=red];
		1839 -> 1840;
	1840 [label="Але головна ідея цих історій полягала в тому, як керувати своїми емоціями. Ми повинні були винести з цього важливий урок, щоби подорож була безпечною.",shape=box,color=red];
		1840 -> 1841;
	1841 [label="Тьху. Вибач, але нащо було все так зіпсувати. ",shape=box,color=blue];
		1841 -> 1842;
	1842 [label="Чому історії не можуть бути просто історіями? Я ЗНЕНАВИДІЛА це, коли дізналася, що Рудольфо, король леопардів, який героїчно загинув у битві зі Змієм, мав бути Солом з його сонячними плямами, який страждає на зоряному дереві. ",shape=box,color=blue];
		1842 -> 1843;
	1843 [label="Запихати релігію в дитячі книжки — це все одно, що ховати ліки в цукерках. ПРОСТО СКАЖИ ЇМ.",shape=box,color=blue];
		1843 -> 1844;
		1843 -> 1845;
	1844 [label="Я не знаю історію про Рудольфо, короля леопардів.",shape=box,color=red];
		1844 -> 1846;
	1845 [label="Я хочу якось почути історію про Рудольфо, короля леопардів.",shape=box,color=red];
		1845 -> 1847;
	1846 [label="Я можу померти щасливою жінкою, знаючи, що про ці книги забули. Ура майбутньому!",shape=box,color=blue];
		1846 -> 1848;
	1847 [label="А-а-а. Будь ласка, ні. Це не справжня легенда, а жахлива серія дитячих книжок.",shape=box,color=blue];
		1847 -> 1849;
	1848 [label="У вас же є історії, чи не так?",shape=box,color=blue];
		1848 -> 1850;
	1849 [label="Якщо хочеш, я можу розповісти тобі кілька наших справжніх легенд.",shape=box,color=blue];
		1849 -> 1851;
		1849 -> 1852;
	1850 [label="Багато. Навіть тенно та ворфрейми мають свої історії. ",shape=box,color=red];
		1850 -> 1854;
	1851 [label="Залюбки.",shape=box,color=red];
		1851 -> 1861;
	1852 [label="Не зараз. [Завершити розмову]",shape=box,color=red];
		1852 -> 1853;
	1854 [label="Є такий дядько, Друз Леверій. Він як куратор музею. Веде записи всіх легенд про ворфреймів.",shape=box,color=red];
		1854 -> 1855;
	1861 [label="Поглянемо. Звісно, є Артур. Старий добрий Артур. Оригінал. Найкращий в Британії.",shape=box,color=blue];
		1861 -> 1863;
	1853 [label="Chat ends.",color=orange];
	1855 [label="Що ж, це збило мене з пантелику. Ти з далекого майбутнього, але за стільки років перебування в Дувірі не в курсі того, що події твого життя встигли перетворитися на міфи?",shape=box,color=blue];
		1855 -> 1856;
	1863 [label="А ще є Юна Локслі. Любила її. Хотіла бути нею. Вона була взірцем для певного типу молодих жінок.",shape=box,color=blue];
		1863 -> 1866;
	1856 [label="У мене паморочиться голова. ",shape=box,color=blue];
		1856 -> 1857;
		1856 -> 1858;
	1866 [label="Яка в неї історія?",shape=box,color=red];
		1866 -> 1867;
	1857 [label="Повір. Я знаю, що ти відчуваєш.",shape=box,color=red];
		1857 -> 1859;
	1858 [label="Тоді розкажи мені про свої міфи.",shape=box,color=red];
		1858 -> 1860;
	1867 [label="Гаразд. Кімнатна версія: вона була дочкою дворянина в ті давні часи, коли країна страждала під владою жорстокого короля.",shape=box,color=blue];
		1867 -> 1868;
	1859 [label="Ти стаєш персонажем дитячої книжки, чи не так?",shape=box,color=blue];
		1859 -> 1862;
	1860 [label="Дідько. Ми будемо тут цілий рік, якщо я почну. ",shape=box,color=blue];
		1860 -> 1861;
	1868 [label="Її брат загинув на чужині, але звістка про це ще не дійшла додому, тож коли бідний пригноблений народ потребував героя, вона вирішила стати ним.",shape=box,color=blue];
		1868 -> 1881;
	1862 [label="Потрапляєш у пастку чарівного королівства, де час тече по-іншому, прикликаний туди, де найбільше потрібен…",shape=box,color=blue];
		1862 -> 1864;
	1881 [label="Check boolean EleanorHeroVirus",color=orange];
		1881 -> 1882 [label=true,color=green];
		1881 -> 1883 [label=false,color=brown];
	1864 [label="Усе, що нам потрібно, щоб завершити твою історію — це любовна лінія або нелюдська потвора, що поневолює.",shape=box,color=blue];
		1864 -> 1865;
	1882 [label="Мені здавалося, ти ненавидиш героїв.",shape=box,color=red];
		1882 -> 1885;
	1883 [label="Зазвичай я терпіти не можу героїв. Вони токсичні. Інфекційні, а тому небезпечні.",shape=box,color=blue];
		1883 -> 1884;
	1865 [label="(або любовна лінія з нелюдською потворою, що поневолює, залежно від твоїх смаків.)",shape=box,color=blue];
		1865 -> 1869;
		1865 -> 1870;
	1885 [label="Їй можна. Замовкни.",shape=box,color=blue];
		1885 -> 1886;
	1884 [label="Юна Локслі інша.",shape=box,color=blue];
		1884 -> 1887;
	1869 [label="Мені завжди були цікавіші потвори. Герої нудні. Передбачувані. …Буденні.",shape=box,color=red];
		1869 -> 1872;
	1870 [label="М-м, не думаю, що потвори — це мій тип.",shape=box,color=red];
		1870 -> 1871;
	1886 [label="Як я вже казала. Вона була дуже схожа на свого брата, тому переодяглася в його старий одяг, видала себе за нього і пішла очолювати революцію. Якщо хтось підходив надто близько, то міг помітити, що вона дівчина, тому вона носила капюшон. Це стало її візитною карткою.",shape=box,color=blue];
		1886 -> 1888;
	1887 [label="Update boolean EleanorHeroVirus",color=orange];
		1887 -> 1888;
	1872 [label="Update boolean EleanorFlirt",color=orange];
		1872 -> 1873;
	1871 [label="І це нормально, чесно кажучи.",shape=box,color=blue];
		1871 -> 1878;
	1888 [label="Вона чудово володіла луком і стрілами. Вона та її команда стали улюбленою бандою розбійників, які грабували королівських збирачів податків і роздавали гроші тим, хто їх найбільше потребував.",shape=box,color=blue];
		1888 -> 1889;
	1873 [label="+15 Chemistry",color=orange];
		1873 -> 1874;
	1878 [label="Потвори звикли бути самотніми.",shape=box,color=blue];
		1878 -> 1879;
	1889 [label="Здається, вона сама по собі викликала б повагу. Навіщо їй потрібно було прикидатися своїм братом?",shape=box,color=red];
		1889 -> 1890;
	1874 [label="Потворність в очах того, хто дивиться, дружаньо.",shape=box,color=blue];
		1874 -> 1875;
	1879 [label="Ми вижили.",shape=box,color=blue];
		1879 -> 1880;
	1890 [label="Для тебе це вже історія. У ті часи чоловіки нібито воювали, тож вони й керували. Люди очікували виконувати накази від чоловіків. Їй потрібно було спиратися на репутацію брата, щоб зробити те, що вона мала зробити. Або так, або піти на дно.",shape=box,color=blue];
		1890 -> 1892;
		1890 -> 1891;
		1890 -> 1893;
	1875 [label="Якщо тебе щиро приваблюють якості, які ти вважаєш «потворними» в інших людях, тоді тобі краще переконатися, що вони поділяють твій вибір, і насолоджуватися цим. Інакше ти здійсниш найгрубішу фетишизацію.",shape=box,color=blue];
		1875 -> 1876;
	1880 [label="Chat ends.",color=orange];
	1892 [label="То що з нею сталося?",shape=box,color=red];
		1892 -> 1895;
	1891 [label="Мене радує, що ми виправили це в майбутньому.",shape=box,color=red];
		1891 -> 1894;
	1893 [label="Не можу сказати, що ми *повністю* виправили це в майбутньому…",shape=box,color=red];
		1893 -> 1896;
	1876 [label="Наприклад, чи назвала б я себе потворою? Так. Із захопленням. Я приймаю титул, за який інші засудили б мене, і радію цьому. На випадок, якщо тобі цікаво.",shape=box,color=blue];
		1876 -> 1877;
	1895 [label="+20 Chemistry",color=orange];
		1895 -> 1898;
	1894 [label="+20 Chemistry",color=orange];
		1894 -> 1897;
	1896 [label="+20 Chemistry",color=orange];
		1896 -> 1899;
	1877 [label="Chat ends.",color=orange];
	1898 [label="Це залежить від того, яку версію історії ти читаєш. Вона або потрапила прямо до Зали героїв, або одружилася з норовливою донькою короля, або потрапила в пастку на дубі, де спить і досі, чекаючи на скрутну годину для Британії.",shape=box,color=blue];
		1898 -> 1901;
	1897 [label="Я також.",shape=box,color=blue];
		1897 -> 1900;
	1899 [label="Ні, якщо вірити персонажу Балласа, ви цього не зробили.",shape=box,color=blue];
		1899 -> 1902;
	1901 [label="Звідси й приказка на батьківщині. Якщо справи йдуть погано, як це було під час війни, традиційно заведено знизувати плечима і казати: «Ну, не може бути ТАК погано. Юна Локслі ще не з’явилася».",shape=box,color=blue];
		1901 -> 1904;
	1900 [label="Господи, як би я хотіла побачити твою епоху на власні очі. Можливо, якось можна контрабандою привезти мені одну з тих крижаних трун, і я змогла б поспати кілька тисячоліть.",shape=box,color=blue];
		1900 -> 1903;
	1902 [label="Скільки, в біса, нам ще потрібно часу?",shape=box,color=blue];
		1902 -> 1905;
	1904 [label="Chat ends.",color=orange];
	1903 [label="Chat ends.",color=orange];
	1905 [label="Chat ends.",color=orange];
}