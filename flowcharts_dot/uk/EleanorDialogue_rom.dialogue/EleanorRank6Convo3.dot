digraph {
	"EleanorRank6Convo3 begins." [color=orange];
		"EleanorRank6Convo3 begins." -> j3314364256;
	j3314364256 [label="Не знаю, чи це помітно, але сталось щось до біса фантастичне.",shape=box,color=blue];
		j3314364256 -> j3990008950;
	j3990008950 [label="Артур знову співає. Слава богам.",shape=box,color=blue];
		j3990008950 -> j895992335;
		j3990008950 -> j357713575;
		j3990008950 -> j4270975911;
	j895992335 [label="Чому він перестав?",shape=box,color=red];
		j895992335 -> j3980621834;
	j357713575 [label="Не те що б я фанатію, але якщо це робить його щасливим…",shape=box,color=red];
		j357713575 -> j742086984;
	j4270975911 [label="Приємно чути. У нього добре виходить.",shape=box,color=red];
		j4270975911 -> j3278322222;
	j3980621834 [label="Страх сцени. Усе просто.",shape=box,color=blue];
		j3980621834 -> j241453482;
	j742086984 [label="Дякую, що так делікатно про це говориш.",shape=box,color=blue];
		j742086984 -> j618646138;
	j3278322222 [label="Хіба не так?",shape=box,color=blue];
		j3278322222 -> j2230138243;
	j241453482 [label="Важко повірити, що хоробрий Артур міг так злякатися.",shape=box,color=red];
		j241453482 -> j2500944083;
	j618646138 [label="Для мене важливо, що тобі не байдуже.",shape=box,color=blue];
		j618646138 -> j1826497296;
	j2230138243 [label="Коли я думаю про те, яких зусиль коштувало змусити його встати перед натовпом і заспівати…",shape=box,color=blue];
		j2230138243 -> j1835451869;
	j2500944083 [label="Що стало причиною зламу?",shape=box,color=red];
		j2500944083 -> j271666005;
	j1826497296 [label="Тим більше, що є причини, чому він перестав співати, про які тобі не відомо.",shape=box,color=blue];
		j1826497296 -> j4130138749;
		j1826497296 -> j1768983556;
	j1835451869 [label="Тобто коли в нього вперше здали нерви.",shape=box,color=blue];
		j1835451869 -> j19183086;
	j271666005 [label="Це прізвище. У цьому вся проблема.",shape=box,color=blue];
		j271666005 -> j3571348574;
	j4130138749 [label="Недостатньо моральної підтримки?",shape=box,color=red];
		j4130138749 -> j1965901002;
	j1768983556 [label="Занадто агресивний натовп?",shape=box,color=red];
		j1768983556 -> j1965901002;
	j19183086 [label="Концерт колядок на Сонцестояння у вісімдесятих. Уяви собі нашого маленького хлопчика в коротких штанцях, який виконує соло з пісні «Яка яскрава роса цього ранку».",shape=box,color=blue];
		j19183086 -> j2045659916;
		j19183086 -> j1080113512;
	j3571348574 [label="«О, то ти найтінґейл? Соловейко, ха-ха, а заспівай нам свою пісню»",shape=box,color=blue];
		j3571348574 -> j900343485;
	j1965901002 [label="Скоріше, забагато одного й того ж жарту.",shape=box,color=blue];
		j1965901002 -> j271666005;
	j2045659916 [label="Я майже це бачу.",shape=box,color=red];
		j2045659916 -> j1437057037;
	j1080113512 [label="Я такої не знаю.",shape=box,color=red];
		j1080113512 -> j3809544576;
	j900343485 [label="Різні придурки, одна й та сама репліка, усе наше життя. Тепер це робить Віктор. ",shape=box,color=blue];
		j900343485 -> j631548715;
	j1437057037 [label="Він ставився до цього дуже серйозно. Тижні за тижнями тренувань, а потім якогось вечора він зірвався. Сховався за лаштунками та відмовився виходити.",shape=box,color=blue];
		j1437057037 -> j1805181297;
		j1437057037 -> j241453482;
	j3809544576 [label="Що ж. Я б заспівала її для тебе, але не впевнена, який звук вийде.",shape=box,color=blue];
		j3809544576 -> j2568106815;
	j631548715 [label="+5 Chemistry",color=orange];
		j631548715 -> j2982933629;
	j1805181297 [label="Як ти його переконала?",shape=box,color=red];
		j1805181297 -> j2085392378;
	j2568106815 [label="Клята техногниль. Я спробувала заспівати для Аой «З Днем народження», але це звучало наче жаба потрапила в шредер.",shape=box,color=blue];
		j2568106815 -> j2016070680;
	j2982933629 [label="Чесно кажучи, я пишаюся, що Артур взагалі наважився співати.",shape=box,color=blue];
		j2982933629 -> "Chat ends.";
	j2085392378 [label="Я буквально надерла йому дупу. Не пишаюся цим. Але це потрібно було зробити.",shape=box,color=blue];
		j2085392378 -> j1883678772;
	j2016070680 [label="Мені шкода. Це, мабуть, важко, коли ти більше не можеш співати.",shape=box,color=red];
		j2016070680 -> j2452394333;
	"Chat ends." [color=orange];
	j1883678772 [label="Річ у тім, що він робив усе це не заради наших батьків, чи щоб пані Геншоу була щасливою. ",shape=box,color=blue];
		j1883678772 -> j874198747;
	j2452394333 [label="Ох, це не така вже й втрата. Я все одно не вміла співати.",shape=box,color=blue];
		j2452394333 -> j1164668299;
	j874198747 [label="Він співав, тому що любив це. Але коли опинився в центрі уваги, то замкнувся в собі.",shape=box,color=blue];
		j874198747 -> j2597245335;
		j874198747 -> j2500944083;
	j1164668299 [label="Найбільше було схоже на спів, це коли я викрикувала слова пісні «Кошлаті гармати» у своїй спальні, тому що хотіла бути в гурті Менді Джелліко, коли сохла за нею. ",shape=box,color=blue];
		j1164668299 -> j3883636182;
	j2597245335 [label="Можливо, йому просто було потрібно згадати, як сильно він любив це робити.",shape=box,color=red];
		j2597245335 -> j2741509552;
	j3883636182 [label="Мій тато грюкав у двері та погрожував помити мені рот милом, якщо почує ще щось подібне.",shape=box,color=blue];
		j3883636182 -> j545851012;
	j2741509552 [label="Артур найщасливіший, коли забуває про Артура. Коли він може відпустити привид самого себе й просто ІСНУВАТИ.",shape=box,color=blue];
		j2741509552 -> j1788671461;
	j545851012 [label="(не знаю, чи у вас там є «панк», але невміння співати — це скоріше вимога, ніж перешкода.)",shape=box,color=blue];
		j545851012 -> j833718931;
		j545851012 -> j2323604266;
	j1788671461 [label="Пиво допомагає.",shape=box,color=blue];
		j1788671461 -> j1737437729;
	j833718931 [label="У нас немає панку, але є скеґ.",shape=box,color=red];
		j833718931 -> j676592957;
	j2323604266 [label="Що сталося з гуртом?",shape=box,color=red];
		j2323604266 -> j2497807036;
	j1737437729 [label="І вже точно не завадить присутність Велимира, який поводиться як батько, якого обрав би Артур, якби міг вибрати з каталогу.",shape=box,color=blue];
		j1737437729 -> j3690623062;
		j1737437729 -> j537656930;
	j676592957 [label="Не смій писати щось подібне в чат, а потім не пояснювати. ",shape=box,color=blue];
		j676592957 -> j3322577872;
	j2497807036 [label="Вони навіть не дійшли до стадії «жалюгідного концерту в місцевому барі».",shape=box,color=blue];
		j2497807036 -> j2105616322;
	j3690623062 [label="Не можу його звинувачувати за це.",shape=box,color=red];
		j3690623062 -> j3999795743;
	j537656930 [label="Мені здавалося, що Велимир і Мінерва занадто схожі на ваших справжніх батьків.",shape=box,color=red];
		j537656930 -> j23466738;
	j3322577872 [label="Я вимагаю пояснення, що таке скеґ.",shape=box,color=blue];
		j3322577872 -> j1157398748;
	j2105616322 [label="Поширювалися чутки, що Менді планувала плюнути в натовп, і на цьому все закінчилося. Ганьба.",shape=box,color=blue];
		j2105616322 -> j2796538620;
		j2105616322 -> j1689988945;
	j3999795743 [label="Артур уже місяцями возить із собою ведмедика. Аж тут з’являється Велимир. Наче доля відчула в житті Артура діру у формі ведмедя…",shape=box,color=blue];
		j3999795743 -> j3116638865;
	j23466738 [label="ну так. Можливо, сварки допомагають йому почуватися як удома. ",shape=box,color=blue];
		j23466738 -> j199818071;
	j1157398748 [label="Бо це звучить як щось, що продається в маленьких пакетиках у маєтку Людстона.",shape=box,color=blue];
		j1157398748 -> j2211183282;
		j1157398748 -> j838801399;
	j2796538620 [label="Хто боїться маленького плювка?",shape=box,color=red];
		j2796538620 -> j499768640;
	j1689988945 [label="Плюнути? Схоже на уявлення «Техноцитної Коди» про гарну вечірку.",shape=box,color=red];
		j1689988945 -> j419824899;
	j3116638865 [label="+5 Chemistry",color=orange];
		j3116638865 -> j3024770371;
	j199818071 [label="+5 Chemistry",color=orange];
		j199818071 -> j4032045156;
	j2211183282 [label="Це як музика, тільки її створюють, б'ючи по трубах. І вентиляціях. І шоломах Корпусу. І взагалі по всьому, що можна знайти. ",shape=box,color=red];
		j2211183282 -> j3114714536;
	j838801399 [label="Це просто безглуздий шум. Лише вентижевжикам це подобається.",shape=box,color=red];
		j838801399 -> j4119022635;
	j499768640 [label="+5 Chemistry",color=orange];
		j499768640 -> j3209537156;
	j419824899 [label="Це були інші часи. Тоді, коли панк був справжнім панком. ",shape=box,color=blue];
		j419824899 -> j749721881;
	j3024770371 [label="вибач. Не моя справа розмірковувати над цим. Я просто рада, що він щасливий.",shape=box,color=blue];
		j3024770371 -> "Chat ends.";
	j4032045156 [label="Дивно, за чим можна сумувати, правда?",shape=box,color=blue];
		j4032045156 -> "Chat ends.";
	j3114714536 [label="Це тема вентижевжиків.",shape=box,color=red];
		j3114714536 -> j723141262;
	j4119022635 [label="Ха. «Безглуздий шум». Я вже чула це раніше.",shape=box,color=blue];
		j4119022635 -> j4080578983;
	j3209537156 [label="Точно не я, це я тобі кажу.",shape=box,color=blue];
		j3209537156 -> j749721881;
	j749721881 [label="Я просто подумала: «Якби вона мене зараз побачила». Гадаю, їй би сподобалася така версія мене.",shape=box,color=blue];
		j749721881 -> j336427290;
	j723141262 [label="+5 Chemistry",color=orange];
		j723141262 -> j2343101861;
	j4080578983 [label="Я не думаю, що є щось настільки безглузде, що не могло б стати саундтреком чиєїсь молодості.",shape=box,color=blue];
		j4080578983 -> j855415997;
	j336427290 [label="Боже, подивіться на мене, в мене очі на мокрому місці від ностальгії.",shape=box,color=blue];
		j336427290 -> j3997226329;
	j2343101861 [label="Гм-м. Звучить як музика виживання. Я була б не проти послухати, якщо матимеш можливість записати щось для мене.",shape=box,color=blue];
		j2343101861 -> j89322809;
	j855415997 [label="Я краще зупинюся. Я стаю сентиментальною.",shape=box,color=blue];
		j855415997 -> "Chat ends.";
	j3997226329 [label="+5 Chemistry",color=orange];
		j3997226329 -> j3826083232;
	j89322809 [label="Але краще тримати це подалі від мікрофонів торговельного центру.",shape=box,color=blue];
		j89322809 -> "Chat ends.";
	j3826083232 [label="Краще повернутися до реалій. Дякую за увагу.",shape=box,color=blue];
		j3826083232 -> "Chat ends.";
}