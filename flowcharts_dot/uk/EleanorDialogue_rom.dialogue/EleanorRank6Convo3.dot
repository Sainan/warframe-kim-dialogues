digraph {
	2888 [label="EleanorRank6Convo3 begins.",color=orange];
		2888 -> 2889;
	2889 [label="Не знаю, чи це помітно, але сталось щось до біса фантастичне.",shape=box,color=blue];
		2889 -> 2890;
	2890 [label="Артур знову співає. Слава богам.",shape=box,color=blue];
		2890 -> 2891;
		2890 -> 2892;
		2890 -> 2893;
	2891 [label="Чому він перестав?",shape=box,color=red];
		2891 -> 2894;
	2892 [label="Не те що б я фанатію, але якщо це робить його щасливим…",shape=box,color=red];
		2892 -> 2895;
	2893 [label="Приємно чути. У нього добре виходить.",shape=box,color=red];
		2893 -> 2896;
	2894 [label="Страх сцени. Усе просто.",shape=box,color=blue];
		2894 -> 2897;
	2895 [label="Дякую, що так делікатно про це говориш.",shape=box,color=blue];
		2895 -> 2898;
	2896 [label="Хіба не так?",shape=box,color=blue];
		2896 -> 2899;
	2897 [label="Важко повірити, що хоробрий Артур міг так злякатися.",shape=box,color=red];
		2897 -> 2900;
	2898 [label="Для мене важливо, що тобі не байдуже.",shape=box,color=blue];
		2898 -> 2901;
	2899 [label="Коли я думаю про те, яких зусиль коштувало змусити його встати перед натовпом і заспівати…",shape=box,color=blue];
		2899 -> 2902;
	2900 [label="Що стало причиною зламу?",shape=box,color=red];
		2900 -> 2903;
	2901 [label="Тим більше, що є причини, чому він перестав співати, про які тобі не відомо.",shape=box,color=blue];
		2901 -> 2904;
		2901 -> 2905;
	2902 [label="Тобто коли в нього вперше здали нерви.",shape=box,color=blue];
		2902 -> 2906;
	2903 [label="Це прізвище. У цьому вся проблема.",shape=box,color=blue];
		2903 -> 2907;
	2904 [label="Недостатньо моральної підтримки?",shape=box,color=red];
		2904 -> 2908;
	2905 [label="Занадто агресивний натовп?",shape=box,color=red];
		2905 -> 2908;
	2906 [label="Концерт колядок на Сонцестояння у вісімдесятих. Уяви собі нашого маленького хлопчика в коротких штанцях, який виконує соло з пісні «Яка яскрава роса цього ранку».",shape=box,color=blue];
		2906 -> 2909;
		2906 -> 2910;
	2907 [label="«О, то ти найтінґейл? Соловейко, ха-ха, а заспівай нам свою пісню»",shape=box,color=blue];
		2907 -> 2911;
	2908 [label="Скоріше, забагато одного й того ж жарту.",shape=box,color=blue];
		2908 -> 2903;
	2909 [label="Я майже це бачу.",shape=box,color=red];
		2909 -> 2912;
	2910 [label="Я такої не знаю.",shape=box,color=red];
		2910 -> 2913;
	2911 [label="Різні придурки, одна й та сама репліка, усе наше життя. Тепер це робить Віктор. ",shape=box,color=blue];
		2911 -> 2914;
	2912 [label="Він ставився до цього дуже серйозно. Тижні за тижнями тренувань, а потім якогось вечора він зірвався. Сховався за лаштунками та відмовився виходити.",shape=box,color=blue];
		2912 -> 2915;
		2912 -> 2897;
	2913 [label="Що ж. Я б заспівала її для тебе, але не впевнена, який звук вийде.",shape=box,color=blue];
		2913 -> 2916;
	2914 [label="+5 Chemistry",color=orange];
		2914 -> 2917;
	2915 [label="Як ти його переконала?",shape=box,color=red];
		2915 -> 2918;
	2916 [label="Клята техногниль. Я спробувала заспівати для Аой «З Днем народження», але це звучало наче жаба потрапила в шредер.",shape=box,color=blue];
		2916 -> 2919;
	2917 [label="Чесно кажучи, я пишаюся, що Артур взагалі наважився співати.",shape=box,color=blue];
		2917 -> 2920;
	2918 [label="Я буквально надерла йому дупу. Не пишаюся цим. Але це потрібно було зробити.",shape=box,color=blue];
		2918 -> 2921;
	2919 [label="Мені шкода. Це, мабуть, важко, коли ти більше не можеш співати.",shape=box,color=red];
		2919 -> 2922;
	2920 [label="Chat ends.",color=orange];
	2921 [label="Річ у тім, що він робив усе це не заради наших батьків, чи щоб пані Геншоу була щасливою. ",shape=box,color=blue];
		2921 -> 2923;
	2922 [label="Ох, це не така вже й втрата. Я все одно не вміла співати.",shape=box,color=blue];
		2922 -> 2924;
	2923 [label="Він співав, тому що любив це. Але коли опинився в центрі уваги, то замкнувся в собі.",shape=box,color=blue];
		2923 -> 2925;
		2923 -> 2900;
	2924 [label="Найбільше було схоже на спів, це коли я викрикувала слова пісні «Кошлаті гармати» у своїй спальні, тому що хотіла бути в гурті Менді Джелліко, коли сохла за нею. ",shape=box,color=blue];
		2924 -> 2926;
	2925 [label="Можливо, йому просто було потрібно згадати, як сильно він любив це робити.",shape=box,color=red];
		2925 -> 2927;
	2926 [label="Мій тато грюкав у двері та погрожував помити мені рот милом, якщо почує ще щось подібне.",shape=box,color=blue];
		2926 -> 2928;
	2927 [label="Артур найщасливіший, коли забуває про Артура. Коли він може відпустити привид самого себе й просто ІСНУВАТИ.",shape=box,color=blue];
		2927 -> 2929;
	2928 [label="(не знаю, чи у вас там є «панк», але невміння співати — це скоріше вимога, ніж перешкода.)",shape=box,color=blue];
		2928 -> 2930;
		2928 -> 2931;
	2929 [label="Пиво допомагає.",shape=box,color=blue];
		2929 -> 2932;
	2930 [label="У нас немає панку, але є скеґ.",shape=box,color=red];
		2930 -> 2933;
	2931 [label="Що сталося з гуртом?",shape=box,color=red];
		2931 -> 2934;
	2932 [label="І вже точно не завадить присутність Велимира, який поводиться як батько, якого обрав би Артур, якби міг вибрати з каталогу.",shape=box,color=blue];
		2932 -> 2935;
		2932 -> 2936;
	2933 [label="Не смій писати щось подібне в чат, а потім не пояснювати. ",shape=box,color=blue];
		2933 -> 2937;
	2934 [label="Вони навіть не дійшли до стадії «жалюгідного концерту в місцевому барі».",shape=box,color=blue];
		2934 -> 2938;
	2935 [label="Не можу його звинувачувати за це.",shape=box,color=red];
		2935 -> 2939;
	2936 [label="Мені здавалося, що Велимир і Мінерва занадто схожі на ваших справжніх батьків.",shape=box,color=red];
		2936 -> 2940;
	2937 [label="Я вимагаю пояснення, що таке скеґ.",shape=box,color=blue];
		2937 -> 2941;
	2938 [label="Поширювалися чутки, що Менді планувала плюнути в натовп, і на цьому все закінчилося. Ганьба.",shape=box,color=blue];
		2938 -> 2942;
		2938 -> 2943;
	2939 [label="Артур уже місяцями возить із собою ведмедика. Аж тут з’являється Велимир. Наче доля відчула в житті Артура діру у формі ведмедя…",shape=box,color=blue];
		2939 -> 2944;
	2940 [label="ну так. Можливо, сварки допомагають йому почуватися як удома. ",shape=box,color=blue];
		2940 -> 2945;
	2941 [label="Бо це звучить як щось, що продається в маленьких пакетиках у маєтку Людстона.",shape=box,color=blue];
		2941 -> 2946;
		2941 -> 2947;
	2942 [label="Хто боїться маленького плювка?",shape=box,color=red];
		2942 -> 2948;
	2943 [label="Плюнути? Схоже на уявлення «Техноцитної Коди» про гарну вечірку.",shape=box,color=red];
		2943 -> 2949;
	2944 [label="+5 Chemistry",color=orange];
		2944 -> 2950;
	2945 [label="+5 Chemistry",color=orange];
		2945 -> 2951;
	2946 [label="Це як музика, тільки її створюють, б'ючи по трубах. І вентиляціях. І шоломах Корпусу. І взагалі по всьому, що можна знайти. ",shape=box,color=red];
		2946 -> 2952;
	2947 [label="Це просто безглуздий шум. Лише вентижевжикам це подобається.",shape=box,color=red];
		2947 -> 2953;
	2948 [label="+5 Chemistry",color=orange];
		2948 -> 2954;
	2949 [label="Це були інші часи. Тоді, коли панк був справжнім панком. ",shape=box,color=blue];
		2949 -> 2955;
	2950 [label="вибач. Не моя справа розмірковувати над цим. Я просто рада, що він щасливий.",shape=box,color=blue];
		2950 -> 3311;
	2951 [label="Дивно, за чим можна сумувати, правда?",shape=box,color=blue];
		2951 -> 2956;
	2952 [label="Це тема вентижевжиків.",shape=box,color=red];
		2952 -> 2957;
	2953 [label="Ха. «Безглуздий шум». Я вже чула це раніше.",shape=box,color=blue];
		2953 -> 2958;
	2954 [label="Точно не я, це я тобі кажу.",shape=box,color=blue];
		2954 -> 2955;
	2955 [label="Я просто подумала: «Якби вона мене зараз побачила». Гадаю, їй би сподобалася така версія мене.",shape=box,color=blue];
		2955 -> 2959;
	3311 [label="Chat ends.",color=orange];
	2956 [label="Chat ends.",color=orange];
	2957 [label="+5 Chemistry",color=orange];
		2957 -> 2960;
	2958 [label="Я не думаю, що є щось настільки безглузде, що не могло б стати саундтреком чиєїсь молодості.",shape=box,color=blue];
		2958 -> 2961;
	2959 [label="Боже, подивіться на мене, в мене очі на мокрому місці від ностальгії.",shape=box,color=blue];
		2959 -> 2962;
	2960 [label="Гм-м. Звучить як музика виживання. Я була б не проти послухати, якщо матимеш можливість записати щось для мене.",shape=box,color=blue];
		2960 -> 2963;
	2961 [label="Я краще зупинюся. Я стаю сентиментальною.",shape=box,color=blue];
		2961 -> 2964;
	2962 [label="+5 Chemistry",color=orange];
		2962 -> 2965;
	2963 [label="Але краще тримати це подалі від мікрофонів торговельного центру.",shape=box,color=blue];
		2963 -> 2966;
	2964 [label="Chat ends.",color=orange];
	2965 [label="Краще повернутися до реалій. Дякую за увагу.",shape=box,color=blue];
		2965 -> 2967;
	2966 [label="Chat ends.",color=orange];
	2967 [label="Chat ends.",color=orange];
