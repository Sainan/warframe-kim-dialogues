digraph {
	graph [fontname="Roboto Condensed"];
	node [fontname="Roboto Condensed"];
	edge [fontname="Roboto Condensed"];

	"EleanorRank6Convo5 begins." [color=orange];
		"EleanorRank6Convo5 begins." -> j2666208378;
	j2666208378 [label="Мені стало цікаво, як це часто буває…",shape=box,color=blue];
		j2666208378 -> j237554999;
	j237554999 [label="Коли цей ланцюг нарешті замкнеться, як би це не сталося, що буде далі із Землею?",shape=box,color=blue];
		j237554999 -> j621729670;
	j621729670 [label="Я знаю, для тебе 2000-ні вже в далекому минулому, але чи можеш ти розповісти мені хоч ЩОСЬ, що чекає на нашу маленьку планету?",shape=box,color=blue];
		j621729670 -> j2326876062;
		j621729670 -> j2136529131;
	j2326876062 [label="Боюся, що нічого хорошого.",shape=box,color=red];
		j2326876062 -> j3991774243;
	j2136529131 [label="Чесно кажучи, я думаю, що не варто.",shape=box,color=red];
		j2136529131 -> j1668729994;
	j3991774243 [label="З того, що я можу сказати, техногниль стає глобальною проблемою. Люди вирішують її за допомогою ядерної зброї — або намагаються.",shape=box,color=red];
		j3991774243 -> j2424923368;
	j1668729994 [label="Якщо тебе попередити про те, що буде, ти можеш спробувати змінити це, тобто мене ніколи не існуватиме.",shape=box,color=red];
		j1668729994 -> j3428998894;
	j2424923368 [label="Так починається перша з «радіаційних війн».",shape=box,color=red];
		j2424923368 -> j96660271;
	j3428998894 [label="Можливо, це егоїстично, але мені подобається існувати.",shape=box,color=red];
		j3428998894 -> j1048531375;
	j96660271 [label="І, зрештою, планета настільки занепадає, що орокіни хочуть утекти з неї та знайти інше місце для життя, чи не так?",shape=box,color=blue];
		j96660271 -> j820748076;
	j1048531375 [label="Ох, ніби все, що було зроблено тобою, НЕ змінило майбутнє?",shape=box,color=blue];
		j1048531375 -> j342123814;
	j820748076 [label="Що призводить до всієї цієї історії з «Зарименом», де з'являєшся ТИ.",shape=box,color=blue];
		j820748076 -> j3605676490;
	j342123814 [label="Можливо, тобі вдалося змінити дрібні деталі, але головні залишилися майже незмінними.",shape=box,color=blue];
		j342123814 -> j3439807975;
	j3605676490 [label="Дивно усвідомлювати, що все це починається тут, у цьому місті.",shape=box,color=blue];
		j3605676490 -> j283774330;
		j3605676490 -> j4104539181;
	j3439807975 [label="Я думаю, що всесвіт знає, що робить.",shape=box,color=blue];
		j3439807975 -> j2508768375;
	j283774330 [label="Можливо, саме тому цей рік такий важливий.",shape=box,color=red];
		j283774330 -> j1891416568;
	j4104539181 [label="Так. Від Голвенії до «Заримена 10.0». Це кротовина.",shape=box,color=red];
		j4104539181 -> j1361782115;
	j2508768375 [label="Відбувається щось більше, ніж просто метушня сліпих часток.",shape=box,color=blue];
		j2508768375 -> j3841512132;
		j2508768375 -> j4040102202;
	j1891416568 [label="+5 Chemistry",color=orange];
		j1891416568 -> j2548370506;
	j1361782115 [label="зажди…",shape=box,color=blue];
		j1361782115 -> j1390767774;
	j3841512132 [label="Не поділяю твоїх поглядів. Усесвіт бездумний.",shape=box,color=red];
		j3841512132 -> j3589391555;
	j4040102202 [label="Погоджуюся. Якщо щось таке людське, як емоція, може сформувати Порожнечу…",shape=box,color=red];
		j4040102202 -> j74582652;
	j2548370506 [label="Має сенс. Якби ядерна бомба Альбрехта вибухнула, чи означало б це ніякої техногнилі, а отже ніякої виснаженої Землі, ніякої потреби тікати, першої подорожі в Порожнечу та ніякої Байдужості??",shape=box,color=blue];
		j2548370506 -> j4163265133;
	j1390767774 [label="Якщо ваш «Заримен 10.0», то що сталося із «Зарименами» від одного до дев’яти?",shape=box,color=blue];
		j1390767774 -> j3058701190;
	j3589391555 [label="Можливо, з дуже великої чи дуже малої перспективи, але не на тому рівні, де ми з тобою існуємо.",shape=box,color=blue];
		j3589391555 -> j2115396617;
	j74582652 [label="+5 Chemistry",color=orange];
		j74582652 -> j875349229;
	j4163265133 [label="Піду подивлюся, чи можна взяти каву в Летті. ",shape=box,color=blue];
		j4163265133 -> "Chat ends.";
	j3058701190 [label="Безпілотні дрони, наскільки я пам’ятаю. ",shape=box,color=red];
		j3058701190 -> j1192908090;
	j2115396617 [label="Якщо ми можемо створювати сенс і ми є частиною всесвіту, тоді всесвіт за визначенням має сенс.",shape=box,color=blue];
		j2115396617 -> j2854340161;
	j875349229 [label="Саме так. Сенс, який ми створюємо, — це не просто зручна омана.",shape=box,color=blue];
		j875349229 -> j3795319937;
	"Chat ends." [color=orange];
	j1192908090 [label="Або терраформувальні камери, керовані цефалонами. Вони експериментували БАГАТО.",shape=box,color=red];
		j1192908090 -> j1791541751;
	j2854340161 [label="+5 Chemistry",color=orange];
		j2854340161 -> j158636013;
	j3795319937 [label="Але завжди є голос, який шепоче тобі та наполягає, що все це не має значення.",shape=box,color=blue];
		j3795319937 -> j1673499835;
	j1791541751 [label="Вони називали це «Проєкт». ",shape=box,color=red];
		j1791541751 -> j4000705752;
	j158636013 [label="Наше існування не менш правдиве чи обґрунтоване, ніж існування елементарних частинок або наднових зірок. Ми важливі, подобається нам це чи ні.",shape=box,color=blue];
		j158636013 -> "Chat ends.";
	j1673499835 [label="Можливо, велике космічне протистояння відбувається не між Добром і Злом, а між сенсом і безглуздям?",shape=box,color=blue];
		j1673499835 -> "Chat ends.";
	j4000705752 [label="+5 Chemistry",color=orange];
		j4000705752 -> j2581633648;
	j2581633648 [label="Звучить краще, ніж «Операція: перенесіть наші безвідповідальні дупи на нову планету, яку ми зможемо знову засрати».",shape=box,color=blue];
		j2581633648 -> "Chat ends.";
}