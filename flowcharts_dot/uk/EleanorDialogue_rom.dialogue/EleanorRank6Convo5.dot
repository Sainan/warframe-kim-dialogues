digraph {
	3068 [label="EleanorRank6Convo5 begins.",color=orange];
		3068 -> 3069;
	3069 [label="Мені стало цікаво, як це часто буває…",shape=box,color=blue];
		3069 -> 3070;
	3070 [label="Коли цей ланцюг нарешті замкнеться, як би це не сталося, що буде далі із Землею?",shape=box,color=blue];
		3070 -> 3071;
	3071 [label="Я знаю, для тебе 2000-ні вже в далекому минулому, але чи можеш ти розповісти мені хоч ЩОСЬ, що чекає на нашу маленьку планету?",shape=box,color=blue];
		3071 -> 3072;
		3071 -> 3074;
	3072 [label="Боюся, що нічого хорошого.",shape=box,color=red];
		3072 -> 3073;
	3074 [label="Чесно кажучи, я думаю, що не варто.",shape=box,color=red];
		3074 -> 3076;
	3073 [label="З того, що я можу сказати, техногниль стає глобальною проблемою. Люди вирішують її за допомогою ядерної зброї — або намагаються.",shape=box,color=red];
		3073 -> 3075;
	3076 [label="Якщо тебе попередити про те, що буде, ти можеш спробувати змінити це, тобто мене ніколи не існуватиме.",shape=box,color=red];
		3076 -> 3078;
	3075 [label="Так починається перша з «радіаційних війн».",shape=box,color=red];
		3075 -> 3077;
	3078 [label="Можливо, це егоїстично, але мені подобається існувати.",shape=box,color=red];
		3078 -> 3080;
	3077 [label="І, зрештою, планета настільки занепадає, що орокіни хочуть утекти з неї та знайти інше місце для життя, чи не так?",shape=box,color=blue];
		3077 -> 3079;
	3080 [label="Ох, ніби все, що було зроблено тобою, НЕ змінило майбутнє?",shape=box,color=blue];
		3080 -> 3082;
	3079 [label="Що призводить до всієї цієї історії з «Зарименом», де з’являєшся ТИ.",shape=box,color=blue];
		3079 -> 3081;
	3082 [label="Можливо, тобі вдалося змінити дрібні деталі, але головні залишилися майже незмінними.",shape=box,color=blue];
		3082 -> 3085;
	3081 [label="Дивно усвідомлювати, що все це починається тут, у цьому місті.",shape=box,color=blue];
		3081 -> 3083;
		3081 -> 3084;
	3085 [label="Я думаю, що всесвіт знає, що робить.",shape=box,color=blue];
		3085 -> 3088;
	3083 [label="Можливо, саме тому цей рік такий важливий.",shape=box,color=red];
		3083 -> 3086;
	3084 [label="Так. Від Голвенії до «Заримена 10.0». Це кротовина.",shape=box,color=red];
		3084 -> 3087;
	3088 [label="Відбувається щось більше, ніж просто метушня сліпих часток.",shape=box,color=blue];
		3088 -> 3091;
		3088 -> 3092;
	3086 [label="+5 Chemistry",color=orange];
		3086 -> 3089;
	3087 [label="зажди…",shape=box,color=blue];
		3087 -> 3090;
	3091 [label="Не поділяю твоїх поглядів. Усесвіт бездумний.",shape=box,color=red];
		3091 -> 3095;
	3092 [label="Погоджуюся. Якщо щось таке людське, як емоція, може сформувати Порожнечу…",shape=box,color=red];
		3092 -> 3096;
	3089 [label="Має сенс. Якби ядерна бомба Альбрехта вибухнула, чи означало б це ніякої техногнилі, а отже ніякої виснаженої Землі, ніякої потреби тікати, першої подорожі в Порожнечу та ніякої Байдужості??",shape=box,color=blue];
		3089 -> 3093;
	3090 [label="Якщо ваш «Заримен 10.0», то що сталося із «Зарименами» від одного до дев’яти?",shape=box,color=blue];
		3090 -> 3094;
	3095 [label="Можливо, з дуже великої чи дуже малої перспективи, але не на тому рівні, де ми з тобою існуємо.",shape=box,color=blue];
		3095 -> 3099;
	3096 [label="+5 Chemistry",color=orange];
		3096 -> 3100;
	3093 [label="Піду подивлюся, чи можна взяти каву в Летті. ",shape=box,color=blue];
		3093 -> 3097;
	3094 [label="Безпілотні дрони, наскільки я пам’ятаю. ",shape=box,color=red];
		3094 -> 3098;
	3099 [label="Якщо ми можемо створювати сенс і ми є частиною всесвіту, тоді всесвіт за визначенням має сенс.",shape=box,color=blue];
		3099 -> 3102;
	3100 [label="Саме так. Сенс, який ми створюємо, — це не просто зручна омана.",shape=box,color=blue];
		3100 -> 3103;
	3097 [label="Chat ends.",color=orange];
	3098 [label="Або терраформувальні камери, керовані цефалонами. Вони експериментували БАГАТО.",shape=box,color=red];
		3098 -> 3101;
	3102 [label="+5 Chemistry",color=orange];
		3102 -> 3105;
	3103 [label="Але завжди є голос, який шепоче тобі та наполягає, що все це не має значення.",shape=box,color=blue];
		3103 -> 3106;
	3101 [label="Вони називали це «Проєкт». ",shape=box,color=red];
		3101 -> 3104;
	3105 [label="Наше існування не менш правдиве чи обґрунтоване, ніж існування елементарних частинок або наднових зірок. Ми важливі, подобається нам це чи ні.",shape=box,color=blue];
		3105 -> 3108;
	3106 [label="Можливо, велике космічне протистояння відбувається не між Добром і Злом, а між сенсом і безглуздям?",shape=box,color=blue];
		3106 -> 3109;
