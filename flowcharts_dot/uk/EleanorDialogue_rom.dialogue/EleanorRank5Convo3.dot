	2373 [label="Як на твою думку, це сприймуть інші?",shape=box,color=red];
		2373 -> 2372;
	2372 [label="Боже. Я навіть не думала про це.",shape=box,color=blue];
		2372 -> 2374;
	2374 [label="Зараз я надто щаслива, щоби перейматися цим, але, гадаю, ми повинні їм сказати.",shape=box,color=blue];
		2374 -> 2375;
	2375 [label="Гм. Я серйозно думаю про те, щоб накинутися на тебе в офісі Артура і «випадково» увімкнути оповіщувач, щоби Летті почула кожен твій стогін.",shape=box,color=blue];
		2375 -> 2376;
	2376 [label="Але краще ні. Життя і так досить травматичне.",shape=box,color=blue];
		2376 -> 2377;
		2376 -> 2378;
	2377 [label="Це гарна ідея. Хоча, можливо, не в офісі служби безпеки та не з увімкненим оповіщувачем.",shape=box,color=red];
		2377 -> 2379;
	2378 [label="Що таке оповіщувач?",shape=box,color=red];
		2378 -> 2382;
	2379 [label="+10 Chemistry",color=orange];
		2379 -> 2380;
	2382 [label="Це такий гучномовець. «Торговельний центр зачиняється за п’ять хвилин, бла-бла-бла, крадіжка в магазині карається розстрілом без суду і слідства».",shape=box,color=blue];
		2382 -> 2384;
	2380 [label="Притримай цю думку, кохання моє. Подивимось, куди нас заведе уява.",shape=box,color=blue];
		2380 -> 2381;
	2384 [label="+10 Chemistry",color=orange];
		2384 -> 2383;
	2381 [label="Chat ends.",color=orange];
	2383 [label="Тож допоможи мені. Мені подобається, як іноді ти виглядаєш спантеличено.",shape=box,color=blue];
		2383 -> 2385;
	2385 [label="Chat ends.",color=orange];
