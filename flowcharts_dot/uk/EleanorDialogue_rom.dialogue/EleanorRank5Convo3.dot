		2287 -> 2291 [label=false,color=brown];
	2288 [label="Ого. Дякую.",shape=box,color=red];
		2288 -> 2292;
	2289 [label="За компанію.",shape=box,color=red];
		2289 -> 2293;
	2290 [label="Тут ще є над чим працювати.",shape=box,color=red];
		2290 -> 2294;
	2291 [label="У мене є свої причини.",shape=box,color=red];
		2291 -> 2295;
	2292 [label="О боги. Вибач. Я не це мала на увазі. Мені просто важко уявити СЕБЕ причиною того, що ти терпиш все… це.",shape=box,color=blue];
		2292 -> 2844;
	2293 [label="… ми говоримо про одну й ту саму людину?",shape=box,color=blue];
		2293 -> 2844;
	2294 [label="Я маю на увазі… ми знаємо, що ми робимо зараз. Ми стримуємо розповсюдження. Тобою виконано те, для чого тебе послали. Ти не мусиш залишатися. І все ж…",shape=box,color=blue];
		2294 -> 2844;
	2295 [label="О, не будь такою загадкою. Я буду змушена якось витягнути з тебе цю інформацію.",shape=box,color=blue];
		2295 -> 2844;
	2844 [label="Check boolean IsDating",color=orange];
		2844 -> 2300 [label=true,color=green];
		2844 -> 2299 [label=true,color=green];
		2844 -> 2296 [label=false,color=brown];
	2300 [label="Мені так набридло вести ці розмови з людьми. Я нікуди не подінуся. Це все. [Завершити розмову]",shape=box,color=red];
		2300 -> 2301;
	2299 [label="Я дуже переживаю за цю команду. Ви всі… тепер для мене сім’я. Та, якої в мене ніколи не було.",shape=box,color=red];
		2299 -> 2304;
	2296 [label="Check boolean EleanorDating",color=orange];
		2296 -> 2297 [label=true,color=green];
		2296 -> 2300 [label=true,color=green];
		2296 -> 2298 [label=false,color=brown];
		2296 -> 2299 [label=false,color=brown];
		2296 -> 2300 [label=false,color=brown];
	2301 [label="… зажди, ти куди?",shape=box,color=blue];
		2301 -> 2302;
	2304 [label="І я дякую Богам за день, коли ми об’єдналися.",shape=box,color=blue];
		2304 -> 2307;
	2297 [label="Здавалося, що той факт, що ми були разом, буде достатнім натяком на те, чому я хочу тут бути.",shape=box,color=red];
		2297 -> 2303;
	2298 [label="Тобі потрібно пояснювати на пальцях? Я тут через тебе. [Зізнатися в почуттях]",shape=box,color=red];
		2298 -> 2305;
	2302 [label="Chat ends.",color=orange];
	2307 [label="Я рада, що це те, що тобі треба. Зрештою всі річки знаходять свій шлях до моря.",shape=box,color=blue];
		2307 -> 2313;
	2303 [label="Що ж, тепер мені цікаво, чим я тебе обдурила. Або маніпулювала тобою. Можливо, я вклала в твою голову якусь думку.",shape=box,color=blue];
		2303 -> 2308;
	2305 [label="Що ж, тепер мені цікаво, чим я тебе обдурила. Або маніпулювала тобою. Можливо, я вклала в твою голову якусь думку. Або, можливо, в твоїй системі є вторинний вірус техногнилі, який приваблює те, що є в моїй.",shape=box,color=blue];
		2305 -> 2306;
	2313 [label="+20 Chemistry",color=orange];
		2313 -> 2312;
	2308 [label="Або, можливо, в твоїй системі є вторинний вірус техногнилі, який приваблює те, що є в моїй.",shape=box,color=blue];
		2308 -> 2309;
	2306 [label="Мене приваблюєш ТИ, Елеоноро. З багатьох причин.",shape=box,color=red];
		2306 -> 2310;
	2312 [label="Як і всі сім’ї, ця — безлад. Але я б не проміняла її ні на що на світі.",shape=box,color=blue];
		2312 -> 2314;
	2309 [label="А може (глибокий вдих) я насправді подобаюся тобі так само, як і ти мені. Невже все так просто?",shape=box,color=blue];
		2309 -> 2315;
	2310 [label="Check boolean EleanorConfession",color=orange];
		2310 -> 2311 [label=true,color=green];
		2310 -> 2315 [label=false,color=brown];
	2314 [label="Chat ends.",color=orange];
	2315 [label="Давай домовимося. Піди до Летті та попроси її провести швидку психологічну перевірку, з’ясуй, що тут НАСПРАВДІ відбувається, і ми просто забудемо про цю розмову.",shape=box,color=blue];
		2315 -> 2316;
		2315 -> 2317;
		2315 -> 2318;
	2311 [label="Здавалося, це було зрозуміло.",shape=box,color=red];
		2311 -> 2315;
	2316 [label="Мені не потрібна психологічна перевірка. У тому, що ти мені подобаєшся, немає нічого божевільного. Якщо ти не відчуваєш того ж до мене, будь ласка, скажи мені про це.",shape=box,color=red];
		2316 -> 2321;
	2317 [label="Якщо ти не маєш таких самих почуттів до мене, просто вийди і скажи про це.",shape=box,color=red];
		2317 -> 2321;
	2318 [label="Ого. Добре. Не зважай.",shape=box,color=red];
		2318 -> 2319;
	2321 [label="ЗВИЧАЙНО, Я ВІДЧУВАЮ ТЕЖ САМЕ",shape=box,color=blue];
		2321 -> 2322;
	2319 [label="Бачиш? Це було легко.",shape=box,color=blue];
		2319 -> 2320;
	2322 [label="ТИ — НАЙКРАЩЕ, ЩО КОЛИ-НЕБУДЬ, ЧОРТ ЗАБИРАЙ, ТРАПЛЯЛОСЯ В МОЄМУ АБСУРДНОМУ ЖИТТІ",shape=box,color=blue];
		2322 -> 2323;
	2320 [label="Chat ends.",color=orange];
	2323 [label="А ЦЕ ОЗНАЧАЄ, ЩО ТИ НЕ БУДЕШ ЧАСТИНОЮ ЦЬОГО НАДОВГО, І ЧИМ РАНІШЕ МИ ОБИДВА ЦЕ ВИЗНАЄМО, ТИМ КРАЩЕ",shape=box,color=blue];
		2323 -> 2324;
	2324 [label="ТОМУ ЩО ТАК ЦЕ ПРАЦЮЄ",shape=box,color=blue];
		2324 -> 2325;
	2325 [label="Check boolean EleanorChristopher1",color=orange];
		2325 -> 2326 [label=true,color=green];
		2325 -> 2327 [label=false,color=brown];
	2326 [label="Я знаю, що ти втратила людей. Я теж. Ми не самотні в цьому.",shape=box,color=red];
		2326 -> 2328;
	2327 [label="Елеоноро, я нікуди не піду. Саме тут, з тобою, я хочу бути.",shape=box,color=red];
		2327 -> 2330;
	2328 [label="+5 Chemistry",color=orange];
		2328 -> 2329;
	2330 [label="Гаразд. Я бачу, ти вже маєш рішення.",shape=box,color=blue];
		2330 -> 2331;
	2329 [label="Ні. Ми не самотні, чи не так? І ми ніколи не маємо бути такими.",shape=box,color=blue];
		2329 -> 2331;
	2331 [label="Я могла б придумати з десяток різних причин, чому ми не повинні бути разом, і на кожну з них у тебе знайдеться відповідь. А якщо я тебе заражу? У тебе є імунітет. А якщо я спробую тебе з’їсти? У тебе функціональне безсмертя. А якщо я зазирну в твою голову? Я впевнена, що ти просто викинеш мене знову.",shape=box,color=blue];
		2331 -> 2332;
	2332 [label="Ти чудове, неймовірне створіння. Ти просто пішов і підкорив мене, так і є.",shape=box,color=blue];
		2332 -> 2333;
	2333 [label="І ще одне. Я не знаю, чи це помітно, але в мене є одна незручна особиста проблема. Нам потрібно вирішити цю проблему.",shape=box,color=blue];
		2333 -> 2334;
		2333 -> 2335;
		2333 -> 2336;
	2334 [label="Твої сяючі очі не дають мені спати вночі?",shape=box,color=red];
		2334 -> 2337;
	2335 [label="Читання думок?",shape=box,color=red];
		2335 -> 2338;
	2336 [label="Язик?",shape=box,color=red];
		2336 -> 2339;
	2337 [label="«Мені подобається дивитися, як ти спиш…»",shape=box,color=blue];
		2337 -> 2340;
	2338 [label="Це дуже незручно для ІНШИХ.",shape=box,color=blue];
		2338 -> 2340;
	2339 [label="Ну, я ж не говорю про розмір моєї дупи, чи не так?",shape=box,color=blue];
		2339 -> 2341;
	2340 [label="Ні. Я маю на увазі свій язик. Анаконду в кімнаті.",shape=box,color=blue];
		2340 -> 2343;
	2341 [label="+5 Chemistry",color=orange];
		2341 -> 2342;
	2343 [label="Скажи мені чесно. Як ти до цього ставишся?",shape=box,color=blue];
		2343 -> 2344;
		2343 -> 2345;
		2343 -> 2346;
	2342 [label="Так, язик. Анаконда в кімнаті.",shape=box,color=blue];
		2342 -> 2343;
	2344 [label="Це огидно, але заради тебе я піду далі.",shape=box,color=red];
		2344 -> 2348;
	2345 [label="Для мене це не проблема.",shape=box,color=red];
		2345 -> 2351;
	2346 [label="Чесно?.. Мені це подобається.",shape=box,color=red];
		2346 -> 2347;
	2348 [label="Check boolean EleanorDating",color=orange];
		2348 -> 2349 [label=true,color=green];
		2348 -> 2350 [label=false,color=brown];
	2351 [label="Що ж. Ну от і домовилися.",shape=box,color=blue];
		2351 -> 2354;
	2347 [label="Отже… Я не перша жінка з мацаком замість язика, з якою ти фліртуєш? Взагалі-то, не відповідай. Я боюся дізнатися відповідь.",shape=box,color=blue];
		2347 -> 2351;
	2349 [label="Добре.",shape=box,color=blue];
		2349 -> 2352;
	2350 [label="О! Зрозуміло. Ти думаєш, що робиш мені послугу!",shape=box,color=blue];
		2350 -> 2353;
	2354 [label="Я налякана. Схвильована. Знервована. Відверто кажучи, більш ніж трохи збуджена. Можливо, я забігаю наперед.",shape=box,color=blue];
		2354 -> 2355;
	2352 [label="Я ціную твою чесність.",shape=box,color=blue];
		2352 -> 2356;
	2353 [label="Боюся, що найближче до мене ти зможеш підібратися, тільки якщо підпалиш себе.",shape=box,color=blue];
		2353 -> 2357;
	2355 [label="Зробимо це?",shape=box,color=blue];
		2355 -> 2364;
		2355 -> 2365;
	2356 [label="Бажаю тобі знайти менш «огидну» особу для інтимних стосунків.",shape=box,color=blue];
		2356 -> 2363;
	2357 [label="У такому випадку, я можу змусити себе попісяти на тебе.",shape=box,color=blue];
		2357 -> 2358;
	2364 [label="Так. :) [Побачення з Елеонорою]",shape=box,color=red];
		2364 -> 2369;
	2365 [label="Мені… потрібно трохи часу, щоби подумати над цим.",shape=box,color=red];
