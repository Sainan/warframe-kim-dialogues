digraph {
	220 [label="EleanorRank1Convo4 begins.",color=orange];
		220 -> 221;
	221 [label="Як воно? Мати можливість вільно розгулювати містом, сповненим чумою, і знати, що ти ніколи не підчепиш заразу?",shape=box,color=blue];
		221 -> 222;
		221 -> 223;
		221 -> 224;
	222 [label="«Вільно розгулювати», ти жартуєш, Елеоноро.",shape=box,color=red];
		222 -> 225;
	223 [label="Я не знаю, чи не підчеплю. Просто досі не маю.",shape=box,color=red];
		223 -> 226;
	224 [label="Це чудово. Я можу допомагати людям у небезпеці.",shape=box,color=red];
		224 -> 248;
	225 [label="Я буду говорити, як хочу, вельми дякую.",shape=box,color=blue];
		225 -> 227;
		225 -> 228;
	226 [label="Ой, та годі.",shape=box,color=blue];
		226 -> 230;
	248 [label="Ха. Це була фішка Ентраті. Коли він уперше з’явився зі своїм медичним шоу «Доктора П’ятниці».",shape=box,color=blue];
		248 -> 255;
	227 [label="І я тобі скажу, коли ти вийдеш за рамки.",shape=box,color=red];
		227 -> 232;
	228 [label="Як знаєш. [Завершити розмову]",shape=box,color=red];
		228 -> 229;
	230 [label="Я бачила, як ти працюєш. Можливо, колись це була людина, але зараз ти космічний ельф «Блискучі чобітки». Всі ці лячні світлові шоу та містичні сили.",shape=box,color=blue];
		230 -> 231;
	255 [label="Check boolean EleanorEntrati",color=orange];
		255 -> 256 [label=true,color=green];
		255 -> 257 [label=false,color=brown];
	232 [label="…",shape=box,color=blue];
		232 -> 233;
	229 [label="Chat ends.",color=orange];
	231 [label="Я не думаю, що тебе можна вбити. Не назавжди. І я знаю, як сильно люди намагалися це зробити.",shape=box,color=blue];
		231 -> 236;
	256 [label="Змушує замислитися, чому він так і не заразився. Зрештою, це сталося з його родиною.",shape=box,color=blue];
		256 -> 263;
	257 [label="Принаймні йому вдалося протистояти цьому. Можливо, він більше схожий на тебе, ніж ти думаєш.",shape=box,color=blue];
		257 -> 263;
	233 [label="Добре. Ти зачепив мене за живе. Вибач.",shape=box,color=blue];
		233 -> 234;
	236 [label="Ти не боїшся техногнилі. Чому? У тебе не має причин для цього.",shape=box,color=blue];
		236 -> 237;
	263 [label="У Голвенії була ціла купа потенційних рятівників.",shape=box,color=blue];
		263 -> 264;
	234 [label="Елеонора сьогодні з’їла кислий лимон.",shape=box,color=blue];
		234 -> 235;
	237 [label="Ти все одно не підчепиш.",shape=box,color=blue];
		237 -> 245;
		237 -> 246;
		237 -> 247;
	264 [label="Принцеса, в минулому. Ентраті. Віктор. Мій брат, звичайно ж. Тепер ти.",shape=box,color=blue];
		264 -> 265;
	235 [label="Соле, я сумую за смаком лимонів.",shape=box,color=blue];
		235 -> 238;
		235 -> 239;
	245 [label="Ти не знайома з цим, як я. Воно еволюціонує. Мутує. Вчиться. Орокіни гадали, що можуть перемогти це. Але їм не вдалося.",shape=box,color=red];
		245 -> 249;
	246 [label="Можливо, ти права. Але ми не ЗНАЄМО.",shape=box,color=red];
		246 -> 261;
	247 [label="Ти маєш рацію. Я можу допомагати людям більше.",shape=box,color=red];
		247 -> 248;
	265 [label="Ти хочеш бути героєм?",shape=box,color=blue];
		265 -> 270;
