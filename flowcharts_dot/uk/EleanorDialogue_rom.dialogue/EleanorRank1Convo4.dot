	252 [label="О боги, я згадала. Ерида. Велетні. Поверхня Деймоса.",shape=box,color=blue];
		252 -> 253;
	253 [label="Я весь час забуваю, що ми не перемагаємо техногниль.",shape=box,color=blue];
		253 -> 258;
	250 [label="Гадаю, що ні. Але я не маю наміру спекулювати цим.",shape=box,color=blue];
		250 -> 251;
	271 [label="Я просто стараюся, як можу.",shape=box,color=red];
