	277 [label="Рада чути. Хтось, хто прожив стільки століть як ти, ПОВИНЕН зрештою подорослішати.",shape=box,color=blue];
		277 -> 284;
	278 [label="Це добре. Тому що я бачила, що сталося, коли один маленький хлопчик вирішив піти стежкою героя, і почав думати про решту, як про другорядних персонажів.",shape=box,color=blue];
		278 -> 285;
