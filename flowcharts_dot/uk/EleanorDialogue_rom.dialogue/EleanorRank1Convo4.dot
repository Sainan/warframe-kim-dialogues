	259 [label="Соле. Тепер я відчуваю жалість до себе за те, що стала жертвою зараження та накинулася на тебе, тому що ти маєш імунітет. На твоїх очах пали цілі світи від такої ж зарази.",shape=box,color=blue];
		259 -> 268;
	254 [label="Не звертай увагу. Гнійні рани досить потворні. Жалість до себе ще потворніша.",shape=box,color=blue];
