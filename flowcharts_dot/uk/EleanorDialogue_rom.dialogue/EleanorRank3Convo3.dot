digraph {
	1032 [label="EleanorRank3Convo3 begins.",color=orange];
		1032 -> 1033;
	1033 [label="Агов, Елеоноро. Як справи?",shape=box,color=red];
		1033 -> 1034;
	1034 [label="Чепурюся. Щойно поголила свого язика.",shape=box,color=blue];
		1034 -> 1035;
		1034 -> 1036;
	1035 [label="Поголила?",shape=box,color=red];
		1035 -> 1037;
	1036 [label="Зажди. *Що?*",shape=box,color=red];
		1036 -> 1038;
	1037 [label="Поголила. Шматочки бітів продовжують проростати з нього. Я думаю, раніше це були смакові рецептори. Якщо я їх не підрізаю, вони стають довгими та звивистими. Як морська анемона.",shape=box,color=blue];
		1037 -> 1039;
	1038 [label="Насправді це нічим не відрізняється від підстригання нігтів.",shape=box,color=blue];
		1038 -> 1040;
	1039 [label="Вибач. Я справді мала попередити тебе про це.",shape=box,color=blue];
		1039 -> 1041;
	1040 [label="Можливо, месьє. Але все ж не більше, ніж видалення небажаного наросту.",shape=box,color=blue];
		1040 -> 1041;
	1041 [label="Усі знають, що ліпше перебувати за сотню метрів, коли Елеонора прямує до ванної кімнати з кухонним ножем і пляшкою хірургічного спирту.",shape=box,color=blue];
		1041 -> 1042;
	1042 [label="Просто терпляче почекай, і зрештою я повернуся з кров’ю на підборідді та пластиковим пакетом з чимось на кшталт крабового м’яса. Якось я спробувала зробити з обрізків бургери, але ніхто не захотів.",shape=box,color=blue];
		1042 -> 1043;
	1043 [label="Вибач, ти хочеш пів години еротичного чату чи лише п’ять хвилин?",shape=box,color=blue];
		1043 -> 1044;
		1043 -> 1045;
	1044 [label="Припини намагатися викликати в мене огиду.",shape=box,color=red];
		1044 -> 1046;
	1045 [label="Отже, якщо вже ми заговорили про язик…",shape=box,color=red];
		1045 -> 1048;
	1046 [label="Агов. Це в мене половина вугра в трахеї. Вибач, що я намагаюся жартувати про це.",shape=box,color=blue];
		1046 -> 1047;
	1048 [label="Продовжуй.",shape=box,color=blue];
		1048 -> 1049;
	1047 [label="Chat ends.",color=orange];
	1049 [label="… наскільки ти це контролюєш?",shape=box,color=red];
		1049 -> 1050;
	1050 [label="Добре. Зажди хвильку.",shape=box,color=blue];
		1050 -> 1051;
	1051 [label="на стлки",shape=box,color=blue];
		1051 -> 1052;
	1052 [label="якк спрви",shape=box,color=blue];
		1052 -> 1053;
		1052 -> 1054;
	1053 [label="Тільки не кажи, що ти це робиш.",shape=box,color=red];
		1053 -> 1056;
	1054 [label="О боже, ні. Я вимикаюся. [Завершити розмову]",shape=box,color=red];
		1054 -> 1055;
	1056 [label="о такк, я рблю ххаахха",shape=box,color=blue];
		1056 -> 1058;
		1056 -> 1057;
	1055 [label="Chat ends.",color=orange];
	1058 [label="Ти друкуєш ним?!",shape=box,color=red];
		1058 -> 1060;
	1057 [label="Вибач, якщо це занадто особисте, але… що *ще* ти можеш робити з ним?..",shape=box,color=red];
		1057 -> 1059;
	1060 [label="ммм",shape=box,color=blue];
		1060 -> 1066;
	1059 [label="що жж",shape=box,color=blue];
		1059 -> 1061;
	1066 [label="Але не довго, бо я заливаю слиною всю клавіатуру.",shape=box,color=blue];
		1066 -> 1067;
	1061 [label="подмай про те, що бб зрбив ти",shape=box,color=blue];
		1061 -> 1062;
	1067 [label="Отже. Ти тепер знаєш.",shape=box,color=blue];
		1067 -> 1068;
		1067 -> 1069;
	1062 [label="я теж",shape=box,color=blue];
		1062 -> 1063;
	1068 [label="Ти коли-небудь втрачала контроль над ним?",shape=box,color=red];
		1068 -> 1070;
	1069 [label="Ти коли-небудь кусала його випадково?",shape=box,color=red];
		1069 -> 1071;
	1063 [label="цее приииємно хаха",shape=box,color=blue];
		1063 -> 1064;
	1070 [label="Ця клята штука, схоже, має власний розум. Коли я думаю про це, я можу його контролювати. Але коли не думаю, здається, він реагує на мої емоції.",shape=box,color=blue];
		1070 -> 1072;
	1071 [label="Постійно. Швидко заживає.",shape=box,color=blue];
		1071 -> 1074;
	1064 [label="Update boolean EleanorFlirt",color=orange];
		1064 -> 1065;
		1064 -> 1069;
	1072 [label="Жахливішою є можливість того, що ним керую не Я, а мій незримий зв’язок з техногниллю. Я б не хотіла розглядати цей варіант.",shape=box,color=blue];
		1072 -> 1073;
	1074 [label="Єдиний раз, коли я відкусила повністю, він відріс знову. Я не можу його позбутися.",shape=box,color=blue];
		1074 -> 1075;
	1065 [label="Я. Ха. Ну годі вже. Гадаю, моє наступне питання буде… ти коли-небудь втрачала контроль над ним?",shape=box,color=red];
		1065 -> 1070;
	1073 [label="Однак я ненавиджу, коли він заважає моїм зубам. Єдиний раз, коли я відкусила повністю, він відріс знову. Я не можу його позбутися.",shape=box,color=blue];
		1073 -> 1075;
	1075 [label="Принаймні, він не стає довшим. Лише покривається відростками.",shape=box,color=blue];
		1075 -> 1076;
		1075 -> 1077;
	1076 [label="Ти би хотіла повернутися до того, якою була, поки Ентраті не змінив тебе?",shape=box,color=red];
		1076 -> 1078;
	1077 [label="Як ти до цього ставишся? Які… твої справжні почуття?",shape=box,color=red];
		1077 -> 1079;
	1078 [label="Тобто, так? В одну мить. Але я не можу, тож який сенс зациклюватися на цьому?",shape=box,color=blue];
		1078 -> 1080;
	1079 [label="Я б його не обрала. Але я не ненавиджу це. Таке відчуття, ніби він завжди був зі мною.",shape=box,color=blue];
		1079 -> 1081;
	1080 [label="Все, що з нами трапляється, відбувається не просто так.",shape=box,color=red];
		1080 -> 1083;
	1081 [label="Я суму за звуком власного голосу. Ненавиджу, що більше не можу співати.",shape=box,color=blue];
		1081 -> 1082;
	1083 [label="Еге ж. Просто іноді причина така: злий виродок зробив щось зле.",shape=box,color=blue];
		1083 -> 1084;
	1082 [label="Але язик? Тобі важко в це повірити, але іноді це втішає. Я більше ніколи не буду беззбройною.",shape=box,color=blue];
		1082 -> 1099;
		1082 -> 1100;
	1084 [label="Тож, якщо ти кажеш, що все завжди відбувається на краще, ніби в цьому є якийсь великий план або мета, залишайся при своїй думці. Я на це не куплюся.",shape=box,color=blue];
		1084 -> 1085;
	1099 [label="Отже… що тобі найбільше подобається в тому, якою ти є зараз?",shape=box,color=red];
		1099 -> 1101;
	1100 [label="Приємно чути, що принаймні ХТОСЬ із нас намагається знайти світлу сторону…",shape=box,color=red];
		1100 -> 1102;
	1085 [label="Check boolean EleanorHeroVirus",color=orange];
		1085 -> 1086 [label=true,color=green];
		1085 -> 1087 [label=false,color=brown];
	1101 [label="Відчуття незламності.",shape=box,color=blue];
		1101 -> 1107;
	1102 [label="Тільки хтось? Тебе Не ПОЗНАЙОМИЛИ з Аміром?",shape=box,color=blue];
		1102 -> 1103;
	1086 [label="Це тема вірусу героя. Зрештою, ти починаєш думати, що ти — головний герой в історії всіх інших.",shape=box,color=blue];
		1086 -> 1087;
	1087 [label="Тут немає чудової оповідки, дружаньо. Немає автора на небі, який би додавав до мого життя маленькі сюжетні ходи для драматичного ефекту.",shape=box,color=blue];
		1087 -> 1088;
	1107 [label="Не проти, якщо я розкажу тобі історію?",shape=box,color=blue];
		1107 -> 1108;
	1103 [label="У нього бувають свої темні моменти, але цей хлопець надихає нас усіх.",shape=box,color=blue];
		1103 -> 1104;
	1088 [label="Я знаходжу сенс у тому лайні, яке зі мною трапляється. Я художник, а не Сол чи Луа або якась зірка між ними.",shape=box,color=blue];
		1088 -> 1089;
	1108 [label="Уперед.",shape=box,color=red];
		1108 -> 1109;
	1104 [label="У порівнянні з тим, щоб ходити з обличчям, схожим на пом’яту дупу, я віддаю перевагу ставленню Аміра.",shape=box,color=blue];
		1104 -> 1105;
	1089 [label="Check boolean EleanorGalvanized",color=orange];
		1089 -> 1090 [label=true,color=green];
		1089 -> 1091 [label=false,color=brown];
		1089 -> 1092 [label=false,color=brown];
	1109 [label="Коли мені було вісімнадцять, ми всі разом святкували закінчення іспитів. Ми всі запхалися в таку крихітну машинку. Я лежала на колінах трьох людей на задньому сидінні.",shape=box,color=blue];
		1109 -> 1110;
	1105 [label="+10 Chemistry",color=orange];
		1105 -> 1106;
	1090 [label="Я пригадала це завдяки тобі. Не знаю, чи ти навіть пам’ятаєш. Я жаліла себе, а тобі вдалося вирвати мене з того стану.",shape=box,color=blue];
		1090 -> 1091;
		1090 -> 1092;
	1091 [label="Приємно, що можу допомогти.",shape=box,color=red];
		1091 -> 1093;
	1092 [label="Ти ж не хочеш сказати, що життя не має сенсу, чи не так?",shape=box,color=red];
		1092 -> 1095;
	1110 [label="Себ Кромлі в багажнику, скиглив. Крістофер і Марко спереду. Ми всі в дупу п’яні від полуничної горілки та викрутки.",shape=box,color=blue];
		1110 -> 1111;
	1106 [label="Chat ends.",color=orange];
	1093 [label="+10 Chemistry",color=orange];
		1093 -> 1094;
	1095 [label="Боже, ні. Я кажу, що сенс знаходиться під поверхнею, і щоб дістатися до нього, потрібне долото скульптора.",shape=box,color=blue];
		1095 -> 1096;
	1111 [label="Марко проскочив на червоне, машина що їхала перпендикулярно, врізалася в нас, ми злетіли з дороги та опинилися в кюветі. Я знаю це тільки тому, що поліціянт розповів мені, що сталося.",shape=box,color=blue];
		1111 -> 1112;
	1094 [label="Chat ends.",color=orange];
	1096 [label="Іноді все здається похмурим, жахливим і порожнім, і мені не хочеться вставати з дивана. Але коли я знову повертаюся до себе, я розумію, що це відчуття було брехнею.",shape=box,color=blue];
		1096 -> 1097;
	1112 [label="Їм довелося вирізати мене з машини. Я не переставала кричати. Це був такий біль, який не залишає в тобі жодної шпарини, куди б можна втекти від нього. Тебе карають за існування.",shape=box,color=blue];
		1112 -> 1113;
	1097 [label="Ніхто інший не володіє ключами до сенсу, розумієш? Це рок-н-ролл між тобою і всесвітом. Він кидає тобі щось, і ти імпровізуєш навколо цього.",shape=box,color=blue];
		1097 -> 1098;
	1113 [label="Я була безпорадна, як кроленя. Розтанула як крайола. Зникла. Просто лежала та видавала крик за криком. До цього я завжди вважала себе міцним горішком.",shape=box,color=blue];
		1113 -> 1114;
	1098 [label="Це допомагає зосередитися на тих аспектах напівзараження, які мені справді подобаються.",shape=box,color=blue];
		1098 -> 1099;
		1098 -> 1100;
	1114 [label="Update boolean EleanorCrash",color=orange];
		1114 -> 1115;
	1115 [label="Я знаю, про який біль ти говориш.",shape=box,color=red];
		1115 -> 1116;
	1116 [label="Два дні тому мене переїхав БТР «Скальдри».",shape=box,color=blue];
		1116 -> 1117;
	1117 [label="Той самий давній біль пронизував мене, але він більше не калічив. Це було як паливо, яке розганяло мене, змушувало злитися.",shape=box,color=blue];
		1117 -> 1118;
	1118 [label="Я підхопилася, вправила плече та розірвала той БТР голими руками.",shape=box,color=blue];
		1118 -> 1119;
	1119 [label="Болісно, так. Але не одурманливо.",shape=box,color=blue];
		1119 -> 1121;
	1121 [label="+20 Chemistry",color=orange];
		1121 -> 1120;
	1120 [label="Тож так, велике спасибі, Ентраті. Де б ти не був.",shape=box,color=blue];
		1120 -> 1122;
	1122 [label="Chat ends.",color=orange];
}