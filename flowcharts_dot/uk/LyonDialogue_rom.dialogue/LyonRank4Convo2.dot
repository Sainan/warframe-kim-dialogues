digraph {
	"LyonRank4Convo2 begins." [color=orange];
		"LyonRank4Convo2 begins." -> j912230045;
		"LyonRank4Convo2 begins." -> j271818043;
		"LyonRank4Convo2 begins." -> j1478915251;
	j912230045 [label="Як так вийшло, що ви з Марі водночас священник і черниця, але також… учиняєте насильства?",shape=box,color=red];
		j912230045 -> j3469514654;
		j912230045 -> j579294848;
		j912230045 -> j3979642009;
	j271818043 [label="Ліоне, я можу поставити тобі дивне запитання?",shape=box,color=red];
		j271818043 -> j3083444951;
	j1478915251 [label="[Завершити розмову]",shape=box,color=red];
		j1478915251 -> "Chat ends.";
	j3469514654 [label="Я чую як Марі кричить «païens!» і кидається в бій і… та складно уявити, як вона засуджує когось за інші вірування. І не можу уявити, наскільки ти інакший. Вона дуже високої думки про тебе.",shape=box,color=red];
		j3469514654 -> j1178548494;
	j579294848 [label="Як би ваша церква поставилася до того, що ви з Марі тут робите? Ну… те, що ви робите в ім’я їхнє?",shape=box,color=red];
		j579294848 -> j2607519027;
	j3979642009 [label="Я спостерігаю за вами з Марі на бойовищі й потім переписуюся з нею. Ти ж тихо й мирно читаєш книги… мені складно звести ці сторони в купу.",shape=box,color=red];
	j3083444951 [label="Якщо ти можеш описати все те, що відбувається навколо, словом «дивне, то я дуже вражений твоєю душевною стійкістю або розчарований обмеженістю словникового запасу. Однак підозрюю, що перше.",shape=box,color=blue];
		j3083444951 -> j189540823;
	"Chat ends." [color=orange];
	j1178548494 [label="Твоя правда. Марі не з тих, хто засудить за віру в прадавнього бога дерев. Натомість вона шукатиме що є спільним у віруваннях інших.",shape=box,color=blue];
		j1178548494 -> j1296522744;
	j2607519027 [label="Багато священних воєн велося в ім’я Сола чи Луа. Криваві «походи» для викорінення «язичників» чи «захоплення священної землі» чи будь-які інші вигадливі причини були в ті часи поширеними.",shape=box,color=blue];
		j2607519027 -> j1847636048;
	j189540823 [label="+5 Chemistry",color=orange];
		j189540823 -> j124562738;
	j1296522744 [label="Хіба дерево не живиться світлом Сола, га? Є ж щось спільне, де вона могла б розділити з ними шмат хліба? Вона радше б сиділа з ними й слухала їхні історії, аніж намагалася завдати шкоди за віру.",shape=box,color=blue];
		j1296522744 -> j2798295454;
	j1847636048 [label="Православ’я Світочів не має армії й не веде війни. Але вони й не забороняють членам ордену вживати дій задля свого захисту чи захисту інших.",shape=box,color=blue];
		j1847636048 -> j539104520;
	j124562738 [label="Тож давай, запитуй. «Дивніше» уже не буде, яке питання не поставила б твоя допитливість.",shape=box,color=blue];
		j124562738 -> j3469514654;
		j124562738 -> j579294848;
		j124562738 -> j3979642009;
	j2798295454 [label="Коли вона влітає в битву, то щось одне з двох: її дуже розважає гра в прадавню воїтельку за віру, коли вона уявляє себе в лискучих обладунках лицарки Сола…",shape=box,color=blue];
		j2798295454 -> j54091382;
	j539104520 [label="Коли Марі влітає в битву, то щось одне з двох: її це дуже розважає, удавання прадавньої воїтельки за віру, уявляння себе в лискучих обладунках лицарки Сола…",shape=box,color=blue];
		j539104520 -> j54091382;
	j54091382 [label="Або, імовірніше, вона згадує послання від Астафора, 8:23: «Самотні душі, які прагнуть увійти в мій дім насильно, бо позбавлені вони світла Сола».",shape=box,color=blue];
		j54091382 -> j1677619433;
	j1677619433 [label="На її думку, вчинене насилля є праведним діянням в ім’я захисту більшого добра. Думаю, що й ти робиш так само. І ті, хто пліч-о-пліч ідуть у бій поруч із тобою. ",shape=box,color=blue];
		j1677619433 -> j3708840499;
	j3708840499 [label="Таким чином, її супротивники в бою (неважливо якої віри) позбавлені Сола. Навіть якби вони носили ряси й сутани її власного ордену, то в її очах усе одно були б язичниками.",shape=box,color=blue];
		j3708840499 -> j2318916459;
		j3708840499 -> j3889354221;
	j2318916459 [label="Дуже помітно, що ти виводиш себе поза межі цього. Як сам ставишся до цих битв?",shape=box,color=red];
		j2318916459 -> j2919603294;
	j3889354221 [label="Це має сенс. Дякую.",shape=box,color=red];
		j3889354221 -> j682957525;
	j2919603294 [label="Мандрівниче, я навмисно вислизаю.",shape=box,color=blue];
		j2919603294 -> j2815864770;
		j2919603294 -> j3810397029;
	j682957525 [label="+5 Chemistry",color=orange];
		j682957525 -> j2406289543;
	j2815864770 [label="Священнику, я навмисно наполягаю.",shape=box,color=red];
		j2815864770 -> j3432166124;
	j3810397029 [label="Справедливо. Візьму все, що дадуть сьогодні.",shape=box,color=red];
		j3810397029 -> j682957525;
	j2406289543 [label="Якщо ці слова чогось вартуватимуть. Марі… сказала, що в тебе добрі наміри. Я вірю їй, хоча іноді й собі не вірю.",shape=box,color=blue];
		j2406289543 -> j1299241136;
	j3432166124 [label="+10 Chemistry",color=orange];
		j3432166124 -> j1731893965;
	j1299241136 [label="Зрештою, я можу лише благати про терплячість. Луа знає, що в мене її малувато останнім часом.",shape=box,color=blue];
		j1299241136 -> j3545001372;
	j1731893965 [label="Дуже добре. Якщо тебе неможливо відмовити й твоя допитливість така велика? Мене не турбує смерть від моєї ж руки… як дехто може очікувати.",shape=box,color=blue];
		j1731893965 -> j523637493;
	j3545001372 [label="Отець Ліон Аллард",shape=box,color=blue];
		j3545001372 -> "Chat ends.";
	j523637493 [label="Чи може вважатися «прийнятним» для людини в рясі та дослідника, яким я є.",shape=box,color=blue];
		j523637493 -> j681186676;
		j523637493 -> j3531946163;
	j681186676 [label="Ліоне, у моєму житті було більше воєн, аніж миру. Якщо дозволю цьому непокоїти мене, то не думаю, що досі вдавалося би бути тут. Але це не означає, що не існує реального тягаря, реальної ціни.",shape=box,color=red];
		j681186676 -> j694642101;
	j3531946163 [label="Думаю, інші тобі вже розповіли хто я. Що я. Звідки я. Смерть, яка переслідує мене — смерть, яка породила мене. Смерть, яка визначає мене. Думаєш, щось із твоїх відчуттів здивує мене?",shape=box,color=red];
		j3531946163 -> j1702170849;
	j694642101 [label="Add 1 to Thermostat counter",color=orange];
		j694642101 -> j3208558997;
	j1702170849 [label="Add -1 to Thermostat counter",color=orange];
		j1702170849 -> j1604599406;
	j3208558997 [label="Так і є.",shape=box,color=blue];
		j3208558997 -> j1133667751;
		j3208558997 -> j1734668573;
	j1604599406 [label="Так.",shape=box,color=blue];
		j1604599406 -> j1133667751;
		j1604599406 -> j1734668573;
	j1133667751 [label="Мені шкода. Здається, ти засмучений. Мені не хотілося цього.",shape=box,color=red];
		j1133667751 -> j3856061399;
	j1734668573 [label="Хочеш… продовжити?",shape=box,color=red];
		j1734668573 -> j888549783;
	j3856061399 [label="Мандрівниче, не треба винити себе. Я, як сказали б наші брати й сестри з Лібертатії, «міцний горішок».",shape=box,color=blue];
		j3856061399 -> j667936323;
	j888549783 [label="Схоже, жахіття, які відлунюють у моїй свідомості, не знають меж. Я бачу ланцюги з людських сухожиль, які колись стікали свіжим багрянцем, які стають крихкими й почорніли.",shape=box,color=blue];
		j888549783 -> j679053660;
	j667936323 [label="Я проста людина в облозі. Я утримую стіну. Якщо відчинити браму, то виникне загроза цілісності оборони.",shape=box,color=blue];
		j667936323 -> j1220269686;
		j667936323 -> j739408150;
	j679053660 [label="Я бачу сотні тисяч власних образів — схожих, але чужих. Порожнисті труни, спотворену потрощену плоть людських трупів, застряглі у вуалі між життям та смертю.",shape=box,color=blue];
		j679053660 -> j1837063843;
	j1220269686 [label="Я розумію. Поговоримо, коли будеш готовим.",shape=box,color=red];
		j1220269686 -> j1972853880;
	j739408150 [label="Що ти маєш на увазі?",shape=box,color=red];
		j739408150 -> j888549783;
	j1837063843 [label="Вирази облич закарбовані в масках відстороненого спокою. Але в іскорках решток їхніх душ, у незгасних жаринках, я чую їхні невгамовні крики. Нескінченні завивання про відплату. Про свободу.",shape=box,color=blue];
		j1837063843 -> j3024507967;
	j1972853880 [label="Я наближаюся до чіткого усвідомлення, що позбавлений вибору в цьому питанні.",shape=box,color=blue];
		j1972853880 -> j2219133440;
	j3024507967 [label="Про смерть.",shape=box,color=blue];
		j3024507967 -> j4183667954;
	j2219133440 [label="+15 Chemistry",color=orange];
		j2219133440 -> j1778462354;
	j4183667954 [label="Ці видіння переслідують мене, коли не сплю. І у снах теж. Мені не трапляються жахіття, бо все пережите мною — те, чим я став.",shape=box,color=blue];
		j4183667954 -> j1274675553;
	j1778462354 [label="Але якщо ці слова чогось вартуватимуть. Марі… сказала, що в тебе добрі наміри. Я вірю їй, хоча іноді й собі не вірю.",shape=box,color=blue];
		j1778462354 -> j2034569494;
	j1274675553 [label="Check boolean LyonPainOff",color=orange];
		j1274675553 -> j874097330 [label=true,color=green];
		j1274675553 -> j2972332364 [label=false,color=brown];
	j2034569494 [label="Зрештою, я можу лише благати про терплячість. Луа знає, що в мене її малувато останнім часом.",shape=box,color=blue];
		j2034569494 -> j2541148378;
	j874097330 [label="Лише тоді, коли приношу жертву тим нашіптуванням, що відлунням носяться у моїй душі, тоді лише світ обертається до мене тим боком, який тобі може бути знайомим.",shape=box,color=blue];
		j874097330 -> j3765068923;
	j2972332364 [label="Лише тоді, коли я тіло рву на шмаття й віддаю тим нашіптуванням, що відлунням носяться у моїй душі, тоді лише світ обертається до мене тим боком, який тобі може бути знайомим.",shape=box,color=blue];
		j2972332364 -> j3765068923;
	j2541148378 [label="Отець Ліон Аллард",shape=box,color=blue];
		j2541148378 -> j2522325746;
	j3765068923 [label="Мандрівниче, дуже прошу не вдавати, що знаєш, як я «почуваюся». Боюся, що ти лише починаєш розуміти.",shape=box,color=blue];
		j3765068923 -> j473184691;
		j3765068923 -> j2946331315;
		j3765068923 -> j1038606170;
	j2522325746 [label="Boolean LyonVisions2d is now true.",color=orange];
		j2522325746 -> "Chat ends.";
	j473184691 [label="Я… мені шкода. Мені не було це відомо.",shape=box,color=red];
		j473184691 -> j1245737713;
	j2946331315 [label="Ліоне, є чимало жахіть і болю, які мені доводилося бачити… і які ти не зрозумієш теж.",shape=box,color=red];
		j2946331315 -> j2169650928;
	j1038606170 [label="Мені шкода, якщо ти почуваєшся так, наче ця тема занадто зарано піднята. Та я хочу зрозуміти. Ті твої видіння…",shape=box,color=red];
		j1038606170 -> j2854210556;
	j1245737713 [label="Так. Що ж. Мені вдалося вціліти впродовж цих років. Упевнений, що витримаю ще кілька. Тобі не варто перейматися.",shape=box,color=blue];
		j1245737713 -> j4270520825;
	j2169650928 [label="Упевнений, що так і було. Деякі образи цього місця мають зображення того. Та чи дає це право тобі вважати себе вище за інших? Верховодити серед знавців геть усіх жахіть і страждань?",shape=box,color=blue];
		j2169650928 -> j4255288679;
		j2169650928 -> j2664949421;
	j2854210556 [label="Так. Ну. Удалося стерпіти їх усі ці роки. Упевнений, що витримаю ще кілька. Тобі не варто перейматися.",shape=box,color=blue];
		j2854210556 -> j4270520825;
	j4270520825 [label="Boolean LyonVisions2a is now true.",color=orange];
		j4270520825 -> j2864349858;
		j4270520825 -> j2228017639;
	j4255288679 [label="Я маю на увазі, що зможу співчувати більше, аніж ти думаєш, у тому, що ти переживаєш.",shape=box,color=red];
		j4255288679 -> j1296450933;
	j2664949421 [label="Я маю на увазі, Ліоне, що довелося побачити чимало жахіть і смертей. Тому не дуже до вподоби, коли мені про це нагадують і критикують за це.",shape=box,color=red];
		j2664949421 -> j122422435;
	j2864349858 [label="Ліоне, описане тобою… це видіння було до чи після переходу до стану протофрейма?",shape=box,color=red];
		j2864349858 -> j2599014869;
	j2228017639 [label="Чи ми можемо знову це обговорити?",shape=box,color=red];
		j2228017639 -> j1240931631;
	j1296450933 [label="Boolean LyonVisions2b is now true.",color=orange];
		j1296450933 -> j3895845068;
	j122422435 [label="Boolean LyonVisions2c is now true.",color=orange];
		j122422435 -> j3988468921;
	j2599014869 [label="Якби ж то було таке просте питання, яким воно здається тобі. Позаяк, я не бажаю відповідати на нього сьогодні. Відчуваю наближення головного болю.",shape=box,color=blue];
		j2599014869 -> j235082432;
	j1240931631 [label="Я наближаюся до чіткого усвідомлення, що позбавлений вибору в цьому питанні.",shape=box,color=blue];
		j1240931631 -> j235082432;
	j3895845068 [label="Мандрівниче, тобі може виявитися дивним, що я не прагну співчуття. Я шукаю лише відповідей. Упевненості. Твердої опори, коли все довкола ілюзія та брехня.",shape=box,color=blue];
		j3895845068 -> j1483824176;
		j3895845068 -> j3757976805;
	j3988468921 [label="Тоді я низько вклоняюся тобі. Славитиму довіку, за все, що довелося витримати. Цікаво, як ти досі при тямі, бачивши подібне.",shape=box,color=blue];
		j3988468921 -> j2833359314;
	j235082432 [label="+10 Chemistry",color=orange];
		j235082432 -> j2791216995;
	j1483824176 [label="Зроблю все, що мені до снаги.",shape=box,color=red];
		j1483824176 -> j3867648626;
	j3757976805 [label="Тоді, напевно, я можу тобі допомогти з цим. Чи ми можемо знову це обговорити? Прошу.",shape=box,color=red];
		j3757976805 -> j1240931631;
	j2833359314 [label="І дивовижно, як ти досі знаходиш час для решти з нас, які такі низькі для тебе, нижче твого високого стану.",shape=box,color=blue];
		j2833359314 -> "Chat ends.";
	j2791216995 [label="Але якщо ці слова чогось вартуватимуть. Марі… сказала, що в тебе добрі наміри. Я вірю їй, хоча іноді й собі не вірю.",shape=box,color=blue];
		j2791216995 -> j1299241136;
	j3867648626 [label="+5 Chemistry",color=orange];
		j3867648626 -> j1459467478;
	j1459467478 [label="Це те, про що лише й варто просити, чи не так?",shape=box,color=blue];
		j1459467478 -> "Chat ends.";
}