		284 -> 287;
	286 [label="Your flirtatious commentary for your own amusement? Or would you like to move on to other topics?",shape=box,color=blue];
		286 -> 291;
		286 -> 292;
		286 -> 290;
	288 [label="I'm interested in you, Lyon. It's as simple as that.",shape=box,color=red];
		288 -> 293;
	289 [label="I don't know what got into me, Lyon. Clearly this was all a mistake. I'm very sorry.",shape=box,color=red];
		289 -> 294;
	290 [label="I... meant what I said. But this is all too fast, I understand.",shape=box,color=red];
		290 -> 294;
	287 [label="Chat ends.",color=orange];
	291 [label="I wasn't flirting with you to amuse myself, Lyon. I'm sorry if you think that's what it was about.",shape=box,color=red];
		291 -> 294;
	292 [label="I didn't mean to offend you, I was just teasing. I'm sorry.",shape=box,color=red];
		292 -> 295;
	293 [label="And it is not mutual. It is as simple as that.",shape=box,color=blue];
		293 -> 296;
	294 [label="I... Forgive me, Drifter.",shape=box,color=blue];
		294 -> 297;
	295 [label="I see.",shape=box,color=blue];
		295 -> 298;
	296 [label="Chat ends.",color=orange];
	297 [label="And pardon my bluntness once more when I express all that has come to overwhelm my mind as of late:",shape=box,color=blue];
		297 -> 299;
	298 [label="Chat ends.",color=orange];
	299 [label="I am surrounded now by strangers and talking beasts in a world of fantastical madness and seemingly endless and rampant slaughter.",shape=box,color=blue];
		299 -> 300;
	300 [label="All that I have known has been swept away by glowing beams of \"Jade Light\" and \"the Orokin Empire\" and \"the Void\" and is threatened by \"the Murmur.\"",shape=box,color=blue];
		300 -> 301;
	301 [label="So, you will have to excuse me if I find this... offer of attraction from you oddly laughable in its naïveté. I neither know you nor trust you. Indeed, all I have to go on is the word of others.",shape=box,color=blue];
		301 -> 302;
	302 [label="The word of others whom I also neither know nor trust as of yet.",shape=box,color=blue];
		302 -> 303;
	303 [label="All this, meanwhile, is only the outward forces that are heaped up before Marie and I - let alone all the rest I contend with that you cannot see.",shape=box,color=blue];
		303 -> 304;
	304 [label="I appreciate your forwardness. I know what you are attempting, and I commend you for it. And I hope, that should the time come that I... rethink your offer? That it still stands.",shape=box,color=blue];
		304 -> 305;
		304 -> 306;
		304 -> 307;
	305 [label="No promises, Priest.",shape=box,color=red];
		305 -> 308;
	306 [label="In the words of a dear friend, \"i'm stubborn, m8.\"",shape=box,color=red];
		306 -> 309;
	307 [label="It will.",shape=box,color=red];
		307 -> 310;
	308 [label="Of course. None were expected.",shape=box,color=blue];
