	280 [label="Lyon? Can we talk? ",shape=box,color=red];
		280 -> 283;
	282 [label="Lyon? I'm very, very sorry if what I said made you uncomfortable. That wasn't my intention.",shape=box,color=red];
		282 -> 285;
	281 [label="[Завершити розмову]",shape=box,color=red];
		281 -> 284;
	283 [label="What would you care to discuss, Drifter?",shape=box,color=blue];
		283 -> 286;
	285 [label="I suppose then, I am simply left wondering, if you were not being flirtatious with me in order to make me uncomfortable for your own amusement... why were you being flirtatious in the first place?",shape=box,color=blue];
		285 -> 288;
		285 -> 289;
		285 -> 290;
