digraph {
	graph [fontname="Roboto Condensed"];
	node [fontname="Roboto Condensed"];
	edge [fontname="Roboto Condensed"];

	"LyonFlirt begins." [color=orange];
		"LyonFlirt begins." -> j3629856058;
		"LyonFlirt begins." -> j2699164118;
		"LyonFlirt begins." -> j3947171474;
	j3629856058 [label="Ліоне, можемо поговорити? ",shape=box,color=red];
		j3629856058 -> j166883130;
	j2699164118 [label="Ліоне? Ти тут? Мені дуже прикро через те, що тобі було незручно через мої слова. Це не входило в плани.",shape=box,color=red];
		j2699164118 -> j2708512507;
	j3947171474 [label="[Завершити розмову]",shape=box,color=red];
		j3947171474 -> j2883342425;
	j166883130 [label="Мандрівниче, що хочеш обговорити?",shape=box,color=blue];
		j166883130 -> j1418512396;
	j2708512507 [label="Що ж, я поцікавлюся тоді. Якщо той флірт був не для того, щоб мне поставити в незручне становище заради твоїх схиблених розваг… то для чого він був?",shape=box,color=blue];
		j2708512507 -> j3604710982;
		j2708512507 -> j1164422981;
		j2708512507 -> j3299737556;
	j2883342425 [label="Boolean LyonFlirtIgnored is now true.",color=orange];
		j2883342425 -> "Chat ends.";
	j1418512396 [label="Знову буде флірт задля твоїх схиблених розваг? Чи поговоримо на інші теми?",shape=box,color=blue];
		j1418512396 -> j2213390949;
		j1418512396 -> j2791656682;
		j1418512396 -> j3299737556;
	j3604710982 [label="Ліоне, ти мене цікавиш. Усе просто.",shape=box,color=red];
		j3604710982 -> j3966947527;
	j1164422981 [label="Ліоне, не знаю, що то таке на мене найшло. Вочевидячки, це була помилка. Мені дуже й дуже шкода.",shape=box,color=red];
		j1164422981 -> j3984425042;
	j3299737556 [label="Я… що малося на увазі, те й писалося. Але якщо це занадто швидко, то я зрозумію.",shape=box,color=red];
		j3299737556 -> j3984425042;
	"Chat ends." [color=orange];
	j2213390949 [label="Ліоне, той флірт був не для моїх «схиблених» розваг. Мені прикро, що ти думаєш саме так.",shape=box,color=red];
		j2213390949 -> j3984425042;
	j2791656682 [label="Я не маю на меті насміхатися, просто хотілося подражнити. Перепрошую.",shape=box,color=red];
		j2791656682 -> j3461268248;
	j3966947527 [label="І це не взаємне почуття. Усе просто.",shape=box,color=blue];
		j3966947527 -> "Chat ends.";
	j3984425042 [label="Я. Пробач мені, мандрівниче.",shape=box,color=blue];
		j3984425042 -> j3051680134;
	j3461268248 [label="Ясно.",shape=box,color=blue];
		j3461268248 -> "Chat ends.";
	j3051680134 [label="Ти вже пробач за відвертість ще раз, але маю висловити все, що гнітить мою душу наразі:",shape=box,color=blue];
		j3051680134 -> j3266325038;
	j3266325038 [label="Довкола повно незнайомців і балакучих звірів у світі, сповненому фантастичного божевілля й нещадної нескінченної жорстокої різанини.",shape=box,color=blue];
		j3266325038 -> j1050111940;
	j1050111940 [label="Усе відоме мені донині було розтрощено вщент яскравими променями «нефритового світла», і «орокінською імперією», і «Порожнечею». І тепер я бачу загрозу від «Шепоту».",shape=box,color=blue];
		j1050111940 -> j3375200978;
	j3375200978 [label="Ти вже маєш пробачити мені, але… цей вияв почуттів від тебе навдивовижу смішний у своїй наївності. Я тебе не знаю, я тобі не довіряю. Зрештою, я можу спиратися лише на слова інших.",shape=box,color=blue];
		j3375200978 -> j195041571;
	j195041571 [label="На слова інших, кого я теж не знаю і ще теж не довіряю.",shape=box,color=blue];
		j195041571 -> j547655482;
	j547655482 [label="Однак тим часом це все лише зовнішні фактори, які накопичуються перед нами з Марі. Не кажучи про інше, чого боюся ти не бачиш.",shape=box,color=blue];
		j547655482 -> j3347252068;
	j3347252068 [label="Я ціную твою наполегливість. Розумію чого ти намагаєшся досягти й це похвально. Сподіваюся, коли настане час і… я передумаю… То пропозиція лишатиметься в силі.",shape=box,color=blue];
		j3347252068 -> j501298225;
		j3347252068 -> j2291656162;
		j3347252068 -> j3844718447;
	j501298225 [label="Нічого не обіцяю, священнику.",shape=box,color=red];
		j501298225 -> j901104711;
	j2291656162 [label="Як казав мій друг: «мені не бракує впертості, дружаньо».",shape=box,color=red];
		j2291656162 -> j904967631;
	j3844718447 [label="Так і буде.",shape=box,color=red];
		j3844718447 -> j651209215;
	j901104711 [label="Звісно. Ніхто й не очікував.",shape=box,color=blue];
		j901104711 -> j3390643280;
	j904967631 [label="Boolean LyonFlirtOffer is now true.",color=orange];
		j904967631 -> j441941991;
	j651209215 [label="Boolean LyonFlirtOffer is now true.",color=orange];
		j651209215 -> j3244755773;
	j3390643280 [label="+15 Chemistry",color=orange];
		j3390643280 -> j2248918455;
	j441941991 [label="Boolean DrifterLyon is now true.",color=orange];
		j441941991 -> j1052296231;
	j3244755773 [label="Boolean DrifterLyon is now true.",color=orange];
		j3244755773 -> j761296198;
	j2248918455 [label="Прощавай.",shape=box,color=blue];
		j2248918455 -> j3545001372;
	j1052296231 [label="Що ж… тоді…",shape=box,color=blue];
		j1052296231 -> j1172347094;
	j761296198 [label="Ще побачимо.",shape=box,color=blue];
		j761296198 -> j1172347094;
