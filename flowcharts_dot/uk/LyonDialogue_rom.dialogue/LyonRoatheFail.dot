	edge [fontname="Roboto Condensed"];

	"LyonRoatheFail begins." [color=orange];
		"LyonRoatheFail begins." -> j2398851547;
		"LyonRoatheFail begins." -> j1478915251;
	j2398851547 [label="Ліоне, потрібна твоя допомога з Роутом.",shape=box,color=red];
		j2398851547 -> j421763245;
	j1478915251 [label="[Завершити розмову]",shape=box,color=red];
		j1478915251 -> "Chat ends.";
	j421763245 [label="Check boolean LyonDating",color=orange];
		j421763245 -> j1014738706 [label=true,color=green];
		j421763245 -> j1113670255 [label=false,color=brown];
	"Chat ends." [color=orange];
	j1014738706 [label="Якщо я можу чимось допомогти, я зроблю це, mon miracle. Що між вами пішло не так?",shape=box,color=blue];
		j1014738706 -> j572992334;
	j1113670255 [label="Якщо я можу чимось допомогти, я зроблю це, дружаньо. Що між вами пішло не так?",shape=box,color=blue];
		j1113670255 -> j572992334;
	j572992334 [label="Evaluate expressions",color=orange];
		j572992334 -> j1872237636 [label="RoatheFail",color=purple];
		j572992334 -> j1872237636 [label="RoatheFailStall",color=purple];
		j572992334 -> j2854169602 [label="RoatheFailUltimate",color=purple];
		j572992334 -> j1743182896 [label="RoatheFailNot21",color=purple];
		j572992334 -> j4086971804 [label="RoatheFailUnloved",color=purple];
		j572992334 -> j1872237636 [label="RoatheRepair1",color=purple];
	j1872237636 [label="Роут намагався усвідомити правду про те, що він… ну… самостійно прийняв сироватку. І я не знаю як, але, гадаю, мені не вдалося нормально допомогти йому пережити це.",shape=box,color=red];
		j1872237636 -> j1892345738;
	j2854169602 [label="Гадаю, це через якісь мої слова, які не варто було говорити.",shape=box,color=red];
		j2854169602 -> j2770662624;
	j1743182896 [label="Він попросив не лізти далі в його спогади. У мене ж не було вибору. І тепер ми… застрягли?",shape=box,color=red];
		j1743182896 -> j1310264588;
	j4086971804 [label="Довелося сказати йому, що ми були разом просто для спілкування. Здавалося, що в нього з цим проблем нема, але тепер, схоже, наші стосунки погіршилися.",shape=box,color=red];
		j4086971804 -> j2770662624;
	j1892345738 [label="Зрозуміло. Буває важко змиритися з минулими вчинками, коли вони постають у новому світлі. Я проклинаю Ентраті за те, що він змусив його та нас опинитися в цій мерзенній ситуації.",shape=box,color=blue];
		j1892345738 -> j4172140279;
	j2770662624 [label="Зрозуміло. Боюся, мушу сказати, що я мало що можу з цим удіяти, оскільки в тебе класичні наслідки «що посіяв, те й пожнеш».",shape=box,color=blue];
		j2770662624 -> j3354469287;
	j1310264588 [label="Зрозуміло. Іноді дії з найліпшими побажаннями не те саме, що виконання побажань того, хто їх просив.",shape=box,color=blue];
		j1310264588 -> j4237637839;
	j4172140279 [label="Я зроблю все можливе, щоб переконати його послухати тебе. Але ти маєш підготувати найліпші аргументи, чому він має переосмислити свої дії як щось інше, ніж боягузтво.",shape=box,color=blue];
		j4172140279 -> j1078221867;
	j3354469287 [label="Така безсердечна зневага неминуче призведе до відповідної поведінки. Особливо коли маєш справу з такими, як Роут.",shape=box,color=blue];
		j3354469287 -> j4179709633;
	j4237637839 [label="Це жахливий вчинок, який ми повинні зробити – не підкорятися чиїмось бажанням, особливо якщо йдеться про нишпорення в їхніх особистих спогадах та думках.",shape=box,color=blue];
		j4237637839 -> j292361468;
	j1078221867 [label="Бо я знаю, що саме це його з’їдає зсередини.",shape=box,color=blue];
		j1078221867 -> j4164812134;
	j4179709633 [label="Я не знаю, як ти можеш виправити ситуацію. Але вибач, я не вірю, що твій шлях лежить через Марі чи мене, пробач.",shape=box,color=blue];
		j4179709633 -> j2788845673;
	j292361468 [label="Я проклинаю Ентраті за те, що він змусив його і нас самих опинитися в такому мерзенному становищі.",shape=box,color=blue];
		j292361468 -> j1416967378;
	j4164812134 [label="Знаю, нам також знадобиться допомога Марі в цьому питанні. Її, можливо, буде важче переконати, адже, як ти знаєш, між ними двома майже немає любові.",shape=box,color=blue];
		j4164812134 -> j3978637540;
	j2788845673 [label="Можливо, на цьому етапі ліпше розглянути інші варіанти.",shape=box,color=blue];
		j2788845673 -> "Chat ends.";
	j1416967378 [label="Але мені здається, що єдиний спосіб допомогти йому, на жаль, це зробити саме це. І продовжувати досліджувати «Спуск», доки не залишиться жодного невідкритого спогаду.",shape=box,color=blue];
		j1416967378 -> j3220817114;
	j3978637540 [label="Boolean LyonRoatheFailFix is now true.",color=orange];
		j3978637540 -> j3151958369;
	j3220817114 [label="Як би диявол не протестував.",shape=box,color=blue];
		j3220817114 -> "Chat ends.";
	j3151958369 [label="Най Луа веде тебе.",shape=box,color=blue];
		j3151958369 -> "Initiate conversation MarieRoatheFail in /Lotus/Types/Gameplay/1999Wf/Dialogue/MarieDialogue_rom.dialogue";
	"Initiate conversation MarieRoatheFail in /Lotus/Types/Gameplay/1999Wf/Dialogue/MarieDialogue_rom.dialogue" [label="Initiate conversation MarieRoatheFail in /Lotus/Types/Gameplay/1999Wf/Dialogue/MarieDialogue_rom.dialogue",color=orange];
		"Initiate conversation MarieRoatheFail in /Lotus/Types/Gameplay/1999Wf/Dialogue/MarieDialogue_rom.dialogue" -> "Chat ends.";
}