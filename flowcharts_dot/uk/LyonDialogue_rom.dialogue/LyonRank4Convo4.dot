		j2698478763 -> j1490707117 [label=false,color=brown];
		j2698478763 -> j3043252159 [label=false,color=brown];
	j2157117681 [label="Мати померла задовго до того, як ми потрапили сюди. А тепер вона точно лише пил. Вона прожила життя в стражданнях… і приреченою була ті страждання поширювати.",shape=box,color=blue];
		j2157117681 -> j3494334046;
	j3043252159 [label="Бити дитину… Таке не можна пробачити.",shape=box,color=red];
		j3043252159 -> j2233574813;
	j1490707117 [label="Саме тому ти?..",shape=box,color=red];
		j1490707117 -> j2933368378;
	j3494334046 [label="Вона була налякана. Що б не полонило мене — тягар чи дар від богів, божевілля чи прокляття… вона була нездатною щось удіяти й упоратися з цим.",shape=box,color=blue];
		j3494334046 -> j219397399;
	j2933368378 [label="Check boolean LyonLecture2",color=orange];
		j2933368378 -> j1897160657 [label=true,color=green];
		j2933368378 -> j3497793164 [label=false,color=brown];
	j219397399 [label="А стосовно жорстокості матері… Батько був гіршим. Я позбавлю тебе від подробиць.",shape=box,color=blue];
		j219397399 -> j3766873413;
	j1897160657 [label="Може бути. Я часто міркую, чи це не компульсивне бажання. Але ж ти вже знаєш із моїх розповідей, що Луа також вдається до подібних методів.",shape=box,color=blue];
		j1897160657 -> j1903519447;
	j3497793164 [label="Може бути. Я часто міркую, чи це не компульсивне бажання. Але так чинить Луа. Луа зі Світочів. Я не один такий.",shape=box,color=blue];
		j3497793164 -> j1690059985;
	j3766873413 [label="Коли я став старшим, видіння перетворилися на голоси. Шепіт з усіх боків цілодобово. Наяву. Уві сні. Моя робота на фермі страждала від цього — відповідно я страждав у відповідь.",shape=box,color=blue];
		j3766873413 -> j1201154303;
		j3766873413 -> j2525138884;
	j1903519447 [label="+5 Chemistry",color=orange];
		j1903519447 -> j2956768918;
	j1690059985 [label="+5 Chemistry",color=orange];
		j1690059985 -> j2175877831;
	j1201154303 [label="То що послало тебе до церкви?",shape=box,color=red];
		j1201154303 -> j4013567020;
	j2525138884 [label="Деякі люди не заслуговують бути батьками.",shape=box,color=red];
		j2525138884 -> j528009177;
	j2956768918 [label="Наголошую, що це мене трохи вгамовує. Дає спокій. Я знаю, що зовні це може видаватися дуже дивним.",shape=box,color=blue];
		j2956768918 -> j219397399;
	j2175877831 [label="Цього мене навчив один з інших святих отців у соборі. Це допомагає… очистити свідомість. Своїх обранців Луа часто «благословляє» подібними «видіннями».",shape=box,color=blue];
		j2175877831 -> j95244230;
	j4013567020 [label="Check boolean LyonPainOff",color=orange];
		j4013567020 -> j2330744695 [label=true,color=green];
		j4013567020 -> j556676330 [label=false,color=brown];
	j528009177 [label="Дякую за співчуття, але я усвідомлюю, наскільки складною дитиною я був для них. Особливо коли став вищим та дужчим.",shape=box,color=blue];
		j528009177 -> j4013567020;
	j95244230 [label="Boolean LyonLecture2 is now true.",color=orange];
		j95244230 -> j219397399;
	j2330744695 [label="Мандрівниче, видіння та голоси часто призводили до нападів шаленства. Самокатування було майже єдиним засобом позбутися від того, що я бачив.",shape=box,color=blue];
		j2330744695 -> j3208800359;
	j556676330 [label="Мандрівниче, видіння та голоси часто призводили до нападів шаленства. Я часто хапав ножа, щоб різати свою плоть, бо лише біль міг заглушити їх.",shape=box,color=blue];
		j556676330 -> j3208800359;
	j3208800359 [label="Але коли голоси наказали мені…",shape=box,color=blue];
		j3208800359 -> j3604188971;
	j3604188971 [label="Я… не можу. Ні, просто не можу. Пробач. Руки тремтять і не вдається друкувати. Я маю припинити це зараз.",shape=box,color=blue];
		j3604188971 -> j2649349969;
		j3604188971 -> j4242630997;
	j2649349969 [label="Звісно. Усе гаразд. Не потрібно квапитися. Я поруч. Щойно будеш готовий продовжити.",shape=box,color=red];
		j2649349969 -> j3276231614;
	j4242630997 [label="Я розумію, уже й так багато було написано. Ти відпочинь трохи, добре? І… знаєш… дякую. Це багато значить для мене.",shape=box,color=red];
		j4242630997 -> j4019577319;
	j3276231614 [label="+10 Chemistry",color=orange];
		j3276231614 -> j1413605166;
	j4019577319 [label="+15 Chemistry",color=orange];
		j4019577319 -> j3962228637;
	j1413605166 [label="Дякую. Невдовзі я напишу тобі.",shape=box,color=blue];
		j1413605166 -> j1006551616;
	j3962228637 [label="І для мене. Гадаю, більше, аніж ти можеш зрозуміти. Дякую навзаєм тобі, друже. Незабаром напишу тобі.",shape=box,color=blue];
		j3962228637 -> j4267852387;
