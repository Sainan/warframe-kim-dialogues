	"Chat ends." [color=orange];
	j4212541568 [label="Чому ти вважаєш, що це змарнує мій час?",shape=box,color=red];
		j4212541568 -> j3188122397;
	j3553245616 [label="Ліоне, я не вважаю це марнуванням часу. Я дійсно залюбки хочу дізнатися більше про тебе.",shape=box,color=red];
		j3553245616 -> j1584197471;
	j2200367307 [label="Знаєш, забудь. Не хочеш, то й не треба.",shape=box,color=red];
		j2200367307 -> j660735525;
	j3188122397 [label="Я просто думаю, що є набагато ліпші способи витратити твою енергію. Як-от захист якихось укріплень від нападу ворогів, пошуки нерозгаданих таємниць… чи перебирання одягу, наприклад.",shape=box,color=blue];
		j3188122397 -> j2006118676;
		j3188122397 -> j484717939;
	j1584197471 [label="Evaluate expressions",color=orange];
