		j1487183485 -> j8515117;
	j3737123238 [label="Вона була такою худою й крихкою, наче померла й похована багато років тому. Шкіра так ізсохлася й пристала до кісток, що між ними було видно проміжки.",shape=box,color=blue];
		j3737123238 -> j2706960984;
	j308851045 [label="Вона була такою худою й крихкою, наче померла й похована багато років тому. Шкіра так ізсохлася й пристала до кісток, що між ними було видно проміжки.",shape=box,color=blue];
		j308851045 -> j3703673015;
	j2663239504 [label="Я… напевно, обачливо сподіватимуся дізнатися, куди заведе цей новий шлях. Однак тобі ж було цікаво дізнатися про моє минуле, так?",shape=box,color=blue];
		j2663239504 -> j1263868234;
