		j2535203827 -> j3334075182;
	j3233654706 [label="Три місяці по тому в селі знайшли мертву жінку. Її очі вигризли пацюки.",shape=box,color=blue];
		j3233654706 -> j1136790140;
	j3334075182 [label="Я розповідав матері про те, що бачив. Про видіння, яке мене розбудило. За цієї звістки вона вмить згадала про нього… як і я.",shape=box,color=blue];
		j3334075182 -> j1599179693;
		j3334075182 -> j709251922;
