	j211759265 [label="Боюся, це що жахливо неприємна історія. Я ж уже розповідав про видіння, які послали мене в катедральний собор для служіння Світочам. і про бабусь із дідусями, які познайомилися під час Ґоллійської революції. Ти дійсно бажаєш змарнувати свій час на подібне?",shape=box,color=blue];
