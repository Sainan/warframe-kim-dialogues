		j1136790140 -> j3334075182;
	j1599179693 [label="І що вона?",shape=box,color=red];
		j1599179693 -> j3854847464;
	j709251922 [label="Вона вважала це збігом чи знаком?",shape=box,color=red];
		j709251922 -> j3695561770;
	j3854847464 [label="Вона лупила мене палюгою так, що я не міг стояти. Спина кровоточила й доводилося спати лицем донизу. Я досі чую її крики під час того покарання… «Diable ! Sorcier !».",shape=box,color=blue];
		j3854847464 -> j1927048020;
		j3854847464 -> j820961622;
		j3854847464 -> j1391335821;
		j3854847464 -> j1394920218;
	j3695561770 [label="Я не знаю. Вона лупила мене палюгою так, що я не міг стояти. Спина кровоточила й доводилося спати лицем донизу. Я досі чую її крики під час того покарання… «Diable ! Sorcier !».",shape=box,color=blue];
