		j1927048020 -> j4011070292;
	j820961622 [label="Ох, Ліоне… Мені так шкода…",shape=box,color=red];
		j820961622 -> j2233574813;
	j1391335821 [label="Який жах…",shape=box,color=red];
		j1391335821 -> j2233574813;
	j1394920218 [label="Вона була неосвічена селянка. Нічого ліпшого такі люди не знали.",shape=box,color=red];
		j1394920218 -> j2233574813;
	j4011070292 [label="Чотири, напевно. Щонайбільше шість. Я не знаю. Тоді ми не стежили за прожитими роками з такою заповзятістю, як зараз ви.",shape=box,color=blue];
		j4011070292 -> j2698478763;
	j2233574813 [label="+5 Chemistry",color=orange];
		j2233574813 -> j2157117681;
