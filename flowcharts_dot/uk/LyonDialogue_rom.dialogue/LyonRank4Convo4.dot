		j1584197471 -> j1416243765 [label="false",color=purple];
	j660735525 [label="Так, вибач. Я… перепрошую за свою незграбність у подібному.",shape=box,color=blue];
		j660735525 -> j2985360616;
	j2006118676 [label="Ліоне, ти якщо хочеш попросити мене піти, то так і скажи.",shape=box,color=red];
		j2006118676 -> j1693389722;
	j484717939 [label="Ти анітрохи не полегшуєш ситуацію. ",shape=box,color=red];
		j484717939 -> j660735525;
	j3592448288 [label="+5 Chemistry",color=orange];
		j3592448288 -> j1679268510;
	j3528095089 [label="Тобі вдалося вже вибрати шлях? Чи просто маєш сталеві нерви, а не такі, як у мене?",shape=box,color=blue];
		j3528095089 -> j2011526329;
		j3528095089 -> j220440606;
	j1416243765 [label="+5 Chemistry",color=orange];
		j1416243765 -> j1596813693;
	j2985360616 [label="Я не дуже розбираюся в тому, як правильно відповідати на подібне, коли хтось із простої цікавості розпитує про минуле… чи проявляє якісь наміри до доброзичливої дружби.",shape=box,color=blue];
		j2985360616 -> j1903652327;
	j1693389722 [label="+5 Chemistry",color=orange];
		j1693389722 -> j660735525;
	j1679268510 [label="Так, і це… почуття дедалі більше тривожить мене. Заради мого спокою, просто підтвердь, що ти маєш на увазі саме те, що я все більше й більше боюся, що ти маєш на увазі.",shape=box,color=blue];
		j1679268510 -> j1792000640;
		j1679268510 -> j1584139044;
	j2011526329 [label="Пробач, що ти відчував ігнорування з мого боку раніше…",shape=box,color=red];
		j2011526329 -> j262405042;
	j220440606 [label="Ти про що?..",shape=box,color=red];
		j220440606 -> j262405042;
	j1596813693 [label="Я… Маю визнати, що твої слова тривожать мене. Попри те, що я не знаю, чи ти маєш на увазі саме те, як я їх інтерпретую у своїй голові.",shape=box,color=blue];
		j1596813693 -> j1792000640;
		j1596813693 -> j1584139044;
	j1903652327 [label="Менше з тим… тебе цікавить моє минуле, так?",shape=box,color=blue];
		j1903652327 -> j3764600334;
	j1792000640 [label="Тоді я внесу трішки спокою — у мене відсутні почуття до тебе.",shape=box,color=red];
		j1792000640 -> j660290890;
	j1584139044 [label="Ліоне, невже так складно повірити, що в мене можуть бути до тебе почуття?",shape=box,color=red];
		j1584139044 -> j3183172013;
	j262405042 [label="Твої домагання зникли так само раптово, як і з’явилися. Припускаю, що було прийняте правильне рішення вважати це помилкою.",shape=box,color=blue];
		j262405042 -> j1108355203;
		j262405042 -> j1789355791;
	j3764600334 [label="Тобі вже, певно, стало зрозумілим, що в мене є… видіння. Це було частиною мене ще змалечку.",shape=box,color=blue];
		j3764600334 -> j3452676059;
	j660290890 [label="Я геть не хотів тебе відштовхувати. Просто добре знати, що й до чого. Я… ти вже вибач за мою незграбність у таких питаннях.",shape=box,color=blue];
		j660290890 -> j2985360616;
	j3183172013 [label="Boolean DrifterLyon is now true.",color=orange];
		j3183172013 -> j296422914;
	j1108355203 [label="Саме так. Це все — велика помилка.",shape=box,color=red];
		j1108355203 -> j877083753;
	j1789355791 [label="Не було впевненості, що мої починання були бажаними. ",shape=box,color=red];
		j1789355791 -> j3754808309;
	j3452676059 [label="Ці видіння, м’яко кажучи, не часто бувають приємними.",shape=box,color=blue];
		j3452676059 -> j1708027403;
		j3452676059 -> j1162338603;
		j3452676059 -> j2352207304;
	j296422914 [label="Якщо спростити? Ну, так. Я… це не означає, що я відвертаюся від твоїх зусиль. Я… знаєш… не звичний до прихильності, мандрівниче. У будь-яких її проявах.",shape=box,color=blue];
		j296422914 -> j163027837;
