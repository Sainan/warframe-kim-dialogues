	"LyonRank3Convo1 begins." [color=orange];
		"LyonRank3Convo1 begins." -> j4099047024;
	j4099047024 [label="Мої вітання, мандрівниче.",shape=box,color=blue];
		j4099047024 -> j4234818821;
	j4234818821 [label="Мені стало відомо, що ти бажаєш зі мною поговорити.",shape=box,color=blue];
		j4234818821 -> j3735961247;
		j4234818821 -> j2519755889;
		j4234818821 -> j1977731181;
	j3735961247 [label="Мені в радість з тобою тут поговорити. Дякую, Ліоне.",shape=box,color=red];
		j3735961247 -> j4248842738;
	j2519755889 [label="Марі нарешті переконала тебе, що я не становитиму загрози?",shape=box,color=red];
		j2519755889 -> j3089234029;
	j1977731181 [label="О! Привіт, Ліоне. Чесно кажучи в мене не було надії, що тебе можна переконати. Приємно бачити, що ти змінив свою думку.",shape=box,color=red];
		j1977731181 -> j7538307;
	j4248842738 [label="Можливо, зрештою, ти пошкодуєш зі своїм бажанням, але хай буде так. Будь ласка.",shape=box,color=blue];
		j4248842738 -> j3596591184;
		j4248842738 -> j2158519881;
	j3089234029 [label="Не спонукай мене так швидко знайти причини змінити свою думку.",shape=box,color=blue];
		j3089234029 -> j1933300832;
	j7538307 [label="Ну так. Можливо, коли все буде сказано і зроблено, ти не будеш так цьому радіти.",shape=box,color=blue];
		j7538307 -> j3596591184;
		j7538307 -> j2158519881;
	j3596591184 [label="Мені стало відомо від інших, що в тебе є питання, які ми повинні обговорити. Чи можу я тобі чимось допомогти?",shape=box,color=red];
		j3596591184 -> j1901290627;
	j2158519881 [label="Щось не так?",shape=box,color=red];
		j2158519881 -> j2060233572;
	j1933300832 [label="+10 Chemistry",color=orange];
		j1933300832 -> "Chat ends.";
	j1901290627 [label="Можливо, з часом. Але ми щойно розпочали нашу бесіду. Я прийшов сюди лише… сказати тобі, що я піддався наполяганням Марі, яка вважає, що тобі можна довіряти, коли йдеться про розмову.",shape=box,color=blue];
		j1901290627 -> j2777944732;
	j2060233572 [label="Якесь майже комічне убоге питання, на яке я навіть не буду намагатися відповісти, оскільки ми щойно розпочали нашу бесіду. Я прийшов сюди лише… сказати тобі, що я піддався наполяганням Марі, яка вважає, що тобі можна довіряти, коли йдеться про розмову.",shape=box,color=blue];
		j2060233572 -> j2777944732;
	"Chat ends." [color=orange];
	j2777944732 [label="Evaluate expressions on HellKeyPlayed counter",color=orange];
		j2777944732 -> j2338908154 [label="x > 0",color=purple];
		j2777944732 -> j2255069731 [label="x <= 0",color=purple];
		j2777944732 -> j2255069731 [label="false",color=purple];
	j2338908154 [label="З огляду на те, що ми тепер стали партнерами у справі, яку Роут так «пекельно» прагне реалізувати, здається, було б розумно, щоби ми як слід познайомилися. І схоже, це той спосіб, яким ти вважаєш це зробити як найкраще. Тому я тут.",shape=box,color=blue];
		j2338908154 -> j1796484180;
		j2338908154 -> j191540768;
	j2255069731 [label="З огляду на те, що ми можемо стати партнерами у справі, яку Роут так «пекельно» прагне реалізувати, здається, було б розумно, щоби ми як слід познайомилися. І схоже, це той спосіб, яким ти вважаєш це зробити як найкраще. Тому я тут.",shape=box,color=blue];
		j2255069731 -> j1796484180;
		j2255069731 -> j191540768;
	j1796484180 [label="Мені здається, ми вже почали якось неправильно.",shape=box,color=red];
		j1796484180 -> j3243871573;
	j191540768 [label="Чи… є інший спосіб, який би ти вважав кращим?",shape=box,color=red];
		j191540768 -> j921579430;
	j3243871573 [label="Ні. Справа не в тобі. Я просто, мабуть, не та людина, з якою тобі звично спілкуватися. Це було твоїм благословенням досі, хоча такі божевільні як я зустрічаються рідко.",shape=box,color=blue];
		j3243871573 -> j2201766929;
	j921579430 [label="Ні. Цей прийнятний. Дійсно, це дає мені час сформувати свої думки так, як я хочу. Я розумію, чому цей пристрій є таким привабливим.",shape=box,color=blue];
		j921579430 -> j1316133696;
	j2201766929 [label="Я відволікся від теми. Однак, боюся, я прийшов сюди не для того, щоби витрачати час на «друкування», що, безумовно, тебе розчарує. Я просто хотів повідомити тебе про свою капітуляцію.",shape=box,color=blue];
		j2201766929 -> j4204768662;
		j2201766929 -> j896916776;
	j1316133696 [label="Однак, боюся, я прийшов сюди не для того, щоби витрачати час на «друкування», що, безумовно, тебе розчарує. Я просто хотів повідомити тебе про свою капітуляцію.",shape=box,color=blue];
		j1316133696 -> j896916776;
		j1316133696 -> j4204768662;
	j4204768662 [label="Марі небезпечніша, ніж здається на перший погляд, чи не так?",shape=box,color=red];
		j4204768662 -> j1230663184;
	j896916776 [label="Я ще раз просто скажу спасибі.",shape=box,color=red];
		j896916776 -> j2517213903;
	j1230663184 [label="+20 Chemistry",color=orange];
		j1230663184 -> j2144280168;
	j2517213903 [label="+15 Chemistry",color=orange];
		j2517213903 -> j903714432;
	j2144280168 [label="Ти лише починаєш здогадуватися, на скільки глибокі ці води.",shape=box,color=blue];
		j2144280168 -> j3545001372;
	j903714432 [label="А тобі за… все, що того варте, навзаєм.",shape=box,color=blue];
		j903714432 -> j3545001372;
	j3545001372 [label="Отець Ліон Аллард",shape=box,color=blue];
		j3545001372 -> "Chat ends.";
