		1718 -> 1720 [label="DrifterFaithNoMaybe",color=purple];
		1718 -> 1719 [label="false",color=purple];
		1718 -> 1720 [label="false",color=purple];
	1719 [label="I'm just - I'm just so sorry for what both of you have had to go through.",shape=box,color=red];
		1719 -> 1725;
	1724 [label="I'm just... so glad Rell and Harrow could be there with you, Lyon... even if it was in memories.",shape=box,color=red];
		1724 -> 1728;
	1723 [label="Could you consider the possibility that... maybe this is all the work of a god or gods? To comfort you?",shape=box,color=red];
		1723 -> 1727;
	1722 [label="Could you consider the possibility that... maybe this is all the work of Lua? To comfort you?",shape=box,color=red];
		1722 -> 1727;
	1721 [label="I don't know as the two have to be mutually exclusive, but... I don't know. I don't know as we ever will.",shape=box,color=red];
		1721 -> 1726;
	1720 [label="I'm just... so glad Rell and Harrow could be there with you, Lyon... even if it was in memories.",shape=box,color=red];
		1720 -> 1725;
	1725 [label="Thank you. I miss their presence. But I... am learning that in this place, there are more who might understand my pain than not.",shape=box,color=blue];
		1725 -> 1729;
	1728 [label="Thank you. I miss their presence. But I am... no longer alone, am I, mon miracle?",shape=box,color=blue];
		1728 -> 1729;
	1727 [label="Yes. Do not think I have not considered it. I am not sure if my faith will be so easily mended, but... it is a comfort to ponder, all the same.",shape=box,color=blue];
		1727 -> 1729;
	1726 [label="Indeed. Do not think I have not considered whether or not Rell and Harrow were sent by the Luminaries to comfort me. But as you said, such is not for us to know.",shape=box,color=blue];
		1726 -> 1729;
	1729 [label="+20 Chemistry",color=orange];
		1729 -> 1730;
	1730 [label="I am so very relieved to finally have spoken of all this with you. It is a great burden, lifted from me, and I cannot express my gratitude enough.",shape=box,color=blue];
		1730 -> 1731;
