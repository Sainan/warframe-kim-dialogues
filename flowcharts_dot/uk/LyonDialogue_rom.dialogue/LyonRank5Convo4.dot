		2348 -> 2350;
	1628 [label="I've heard it's incredibly painful.",shape=box,color=red];
		1628 -> 1632;
	1629 [label="I can't possibly imagine. ",shape=box,color=red];
		1629 -> 1633;
	1630 [label="[Warning: Brief mentions of self-harm and child abuse. Click here to end. No loss of Chemistry with Lyon will be incurred.]",shape=box,color=red];
		1630 -> 1634;
	1627 [label="[Завершити розмову]",shape=box,color=red];
		1627 -> 1631;
	2350 [label="Update boolean LyonWillDate",color=orange];
		2350 -> 2351;
	1632 [label="I suppose so. Though I do believe that I have had years of practice in that regard and, therefore, Entrati's warnings made it to be far more impressive than it was in actuality.",shape=box,color=blue];
		1632 -> 1633;
	1633 [label="Marie and I decided to take our serums in private. I asked her to allow me to go first, experience the change, and then to help guide her through her own - but she, of course, steadfastly refused.",shape=box,color=blue];
		1633 -> 1636;
	1634 [label="+20 Chemistry",color=orange];
		1634 -> 1637;
	1631 [label="Update boolean LyonConfessionFail",color=orange];
		1631 -> 1635;
	2351 [label="Chat ends. Next chat will be Lyon5FaithDay2.",color=orange];
	1636 [label="Scoffing at the mere notion that I would go anywhere or do anything without her firmly planted at my side, she headed off to her own chambers.",shape=box,color=blue];
		1636 -> 1638;
	1637 [label="Update boolean LyonFamilySuccess",color=orange];
		1637 -> 1639;
	1635 [label="Chat ends.",color=orange];
	1638 [label="I locked my door, stripped, and sat in the middle of my floor, as far away from any objects as I could, before I drove the needle into my side.",shape=box,color=blue];
		1638 -> 1640;
	1639 [label="Update boolean LyonRell3",color=orange];
		1639 -> 1641;
	1640 [label="I had seen what the Infestation had done to Roathe, twisting his flesh with whatever he must have been wearing at the time - I had no desire to fall victim of the same fate.",shape=box,color=blue];
		1640 -> 1642;
	1641 [label="Update boolean LyonFaith3Unknown",color=orange];
		1641 -> 1643;
	1642 [label="When the agony was over, my already suffering vision was... blurred. Overtaken in... double, somehow? As though I could see not once, but twice.",shape=box,color=blue];
		1642 -> 1644;
	1643 [label="Chat ends. Next chat will be Lyon5FaithDay2.",color=orange];
	1644 [label="I am quite proud of my resilience, however, that I managed to don my britches before I retched and unconsciousness took me.",shape=box,color=blue];
		1644 -> 1645;
	1645 [label="When I awoke, I was not alone. Nor, however, was I on the floor of my chambers. I was sitting in my childhood bedroom upon the creaky old floors I knew so well.",shape=box,color=blue];
		1645 -> 1646;
	1646 [label="And sitting beside me was a young man. Beside him stood a figure I now know as Harrow. The young man was holding a small wooden figurine in his hands. It was jointed at the limbs - the paint long worn away, save perhaps in the creases and cracks. It had belonged to my father. It was of a soldier.",shape=box,color=blue];
		1646 -> 1647;
	1647 [label="It was the only toy I could claim as my own, as a child.",shape=box,color=blue];
		1647 -> 1648;
		1647 -> 1649;
	1648 [label="I had a similar figurine, growing up. It was one of my favorite toys.",shape=box,color=red];
		1648 -> 1650;
	1649 [label="Rell?",shape=box,color=red];
		1649 -> 1651;
	1650 [label="So I have heard. I believe mine proved to be more benign, in the end.",shape=box,color=blue];
		1650 -> 1652;
		1650 -> 1653;
		1650 -> 1654;
	1651 [label="Indeed.",shape=box,color=blue];
		1651 -> 1655;
	1652 [label="Thrax is a complicated topic. I'd rather not get into it here.",shape=box,color=red];
		1652 -> 1656;
	1653 [label="It wasn't his fault, really. He was just who I needed him to be in that moment in time.",shape=box,color=red];
		1653 -> 1657;
	1654 [label="It's okay. He's progressing. Slowly. Somehow. The seemingly impossible can change.",shape=box,color=red];
		1654 -> 1658;
	1655 [label="The young man and his silent guardian who visited me inside my dream- inside my mind - were all at once strangers to me and yet known to me like we had grown up together as siblings.",shape=box,color=blue];
		1655 -> 1659;
	1656 [label="Quite right. We could be lost here for hours, debating the moral and theological implications of Duviri.",shape=box,color=blue];
		1656 -> 1655;
	1657 [label="When I ponder even the smallest notion of what I would have conjured in your stead, I am overcome with waves of horror. But we could be lost here for hours, discussing such a thing.",shape=box,color=blue];
		1657 -> 1655;
	1658 [label="If he is showing signs of change, and he is a product of your emotions, perhaps that is indicative of something else. But a debate for another day, perhaps.",shape=box,color=blue];
		1658 -> 1655;
	1659 [label="Forgive me for an overwrought metaphor, but it was as though we were three trees whose roots were so grown together as to become indistinguishable from one another -",shape=box,color=blue];
		1659 -> 1660;
	1660 [label="who had merely been blinked into existence in such a state. I could remember my life without Rell and Harrow. And yet, there they were. In every moment - in every instance - beside me.",shape=box,color=blue];
		1660 -> 1661;
	1661 [label="As an aside, I wish I could speak to Entrati about this, I am desperate to know what manner of science is at the - no pun intended - root of this, but when we finally recovered from our change, Entrati was gone.",shape=box,color=blue];
		1661 -> 1662;
	1662 [label="Check boolean LoidFamilyComplete",color=orange];
		1662 -> 1664 [label=true,color=green];
		1662 -> 1663 [label=false,color=brown];
		1662 -> 1664 [label=false,color=brown];
	1664 [label="What little I know of the Infestation and how it works, it seems to be kind of... maybe... I don't know, outside time?",shape=box,color=red];
		1664 -> 1666;
	1663 [label="Entrati's daughter is upstairs. She studied and worked beside him. She might be able to help.",shape=box,color=red];
		1663 -> 1665;
	1666 [label="There's a... guitar... it's all very hard to explain, and we've both traveled through time via Helminth...",shape=box,color=red];
		1666 -> 1668;
	1665 [label="Update boolean LyonFamilySuccess",color=orange];
		1665 -> 1667;
	1668 [label="Which was a process I believe will linger in my nightmares for a very long time. Regardless, the specifics of how it is that Rell, Harrow, and I became bonded at such a... molecular, spiritual level, I do not know.",shape=box,color=blue];
		1668 -> 1670;
	1667 [label="Add 1 to Family",color=orange];
		1667 -> 1669;
	1670 [label="But the crossroads went both ways. Where they were in my life, I was in theirs. I saw the Indifference. I understood what they were standing guard against. I saw glimpses of Harrow, and the man he once was.",shape=box,color=blue];
		1670 -> 1672;
	1669 [label="Now if only we were allowed to speak to her. I suspect there are schemes to that effect already in play. If so, you may count on me to... assist. I can be convincing when need be.",shape=box,color=blue];
		1669 -> 1671;
	1672 [label="But the press of the Indifference took over I could feel it there - hear it as they did, tapping against the walls. Rap... tap... tap...",shape=box,color=blue];
		1672 -> 1673;
	1671 [label="Regardless, the specifics of how it is that Rell, Harrow, and I became bonded at such a... molecular, spiritual level, I do not know.",shape=box,color=blue];
		1671 -> 1670;
	1673 [label="All the visions of my youth, all the horrors that I had seen - were they only ever the Indifference? Was I now mis-remembering? Or had I indeed been \"blessed\" by Lua?",shape=box,color=blue];
		1673 -> 1674;
	1674 [label="My faith inside of me... it crumpled and fell away. Nothing more than charred paper, turned to dust. And oh, how I loathe myself for my weakness...",shape=box,color=blue];
		1674 -> 1675;
	1675 [label="Evaluate expressions",color=orange];
		1675 -> 1681 [label="LyonDating",color=purple];
		1675 -> 1682 [label="DrifterFaithYesSimilar",color=purple];
		1675 -> 1682 [label="DrifterFaithYesForeign",color=purple];
		1675 -> 1682 [label="DrifterFaithPersonal",color=purple];
		1675 -> 1680 [label="DrifterFaithSol",color=purple];
		1675 -> 1680 [label="DrifterFaithLua",color=purple];
		1675 -> 1680 [label="DrifterFaithBalance",color=purple];
		1675 -> 1679 [label="DrifterFaithAgnostic",color=purple];
		1675 -> 1678 [label="DrifterFaithNoFear",color=purple];
		1675 -> 1677 [label="DrifterFaithNoMITW",color=purple];
		1675 -> 1678 [label="DrifterFaithNoMaybe",color=purple];
		1675 -> 1676 [label="false",color=purple];
	1681 [label="Oh, Lyon... you've been through so much. Doubt isn't the result of weakness - doubt is the result of pain.",shape=box,color=red];
		1681 -> 1683;
		1681 -> 1684;
		1681 -> 1685;
		1681 -> 1686;
		1681 -> 1687;
	1682 [label="Faith doesn't need to be constant - nor is it expected to be. How many tales are told of those who lose their faith, only to find it again?",shape=box,color=red];
		1682 -> 1683;
		1682 -> 1684;
		1682 -> 1685;
	1680 [label="You spent your life in dedication to our Luminaries, Lyon. Do you think they would turn away from you for something like this?",shape=box,color=red];
		1680 -> 1683;
		1680 -> 1684;
		1680 -> 1685;
	1679 [label="I don't know if there are gods or not, Lyon - I don't think any of us can ever truly know. But what I do know, is that you've been through a great deal.",shape=box,color=red];
		1679 -> 1683;
		1679 -> 1685;
		1679 -> 1686;
	1678 [label="While I personally don't believe there are gods in this world, I know how important that has been to you in your life. I don't want to belittle that.",shape=box,color=red];
		1678 -> 1685;
		1678 -> 1687;
	1677 [label="The Indifference was made by us - he isn't a god, Lyon. Don't let Entrati's mistake destroy you. As for your faith?",shape=box,color=red];
		1677 -> 1685;
		1677 -> 1687;
	1676 [label="I hate to see you like this, caught in the middle of everyone's nonsense. You didn't deserve this.",shape=box,color=red];
		1676 -> 1683;
		1676 -> 1684;
		1676 -> 1685;
		1676 -> 1686;
		1676 -> 1687;
	1683 [label="I'm not saying you need to find your faith again. I'm saying if you want to - if you feel you need to - it's not something that's forever lost.",shape=box,color=red];
		1683 -> 1688;
	1684 [label="Surely, Lua can see what you've been put through. What you've endured in her name. ",shape=box,color=red];
		1684 -> 1689;
	1685 [label="What I think is that you need to focus on is finding some kind of peace within yourself - however it is you need to find it.",shape=box,color=red];
		1685 -> 1690;
	1686 [label="If there is a god, if your Lua does exist - surely she can see what you've been through. What you've endured in her name. It must mean something to her.",shape=box,color=red];
		1686 -> 1691;
	1687 [label="I think you need to let go of any notion of whether or not there are gods, and focus on healing yourself, first.",shape=box,color=red];
		1687 -> 1692;
	1688 [label="Update boolean LyonFaith3Maybe",color=orange];
		1688 -> 1693;
	1689 [label="Update boolean LyonFaith3Yes",color=orange];
		1689 -> 1693;
	1690 [label="Update boolean LyonFaith3Maybe",color=orange];
		1690 -> 1693;
	1691 [label="Update boolean LyonFaith3Yes",color=orange];
		1691 -> 1693;
	1692 [label="Update boolean LyonFaith3No",color=orange];
		1692 -> 1693;
	1693 [label="Perhaps you are right... And my sad tale of doubt was hardly the point. But I shall consider your words. We shall discuss this in more detail tomorrow.",shape=box,color=blue];
		1693 -> 1694;
	1694 [label="I saw Rell's life aboard the Zariman Ten Zero, and all that he endured after it. I saw Harrow's life as a soldier, faded as it was through the Infestation. Just as they saw my life in Gaule and all I suffered.",shape=box,color=blue];
		1694 -> 1695;
	1695 [label="It may be strange to you to know that none of us ever once exchanged a word. We never found the need. There was simply between us an... understanding.",shape=box,color=blue];
		1695 -> 1696;
		1695 -> 1697;
	1696 [label="Really? Never?",shape=box,color=red];
		1696 -> 1698;
	1697 [label="Yeah... I can see that.",shape=box,color=red];
		1697 -> 1699;
	1698 [label="I could hear their voices - I knew all the words in their lives they had ever spoken. But they were never directed to me.",shape=box,color=blue];
		1698 -> 1699;
	1699 [label="Does a smile need a speech? Does a frown? Do you need to hear a child weeping to know he is in pain or frightened? No, we merely knew what was passed between us.",shape=box,color=blue];
		1699 -> 1700;
	1700 [label="Until it... until it no longer was.",shape=box,color=blue];
		1700 -> 1701;
	1701 [label="Check boolean LyonDating",color=orange];
		1701 -> 1703 [label=true,color=green];
		1701 -> 1702 [label=false,color=brown];
	1703 [label="They are not gone, mon miracle... only dead.",shape=box,color=blue];
		1703 -> 1704;
	1702 [label="They are not gone, my friend... only dead.",shape=box,color=blue];
		1702 -> 1704;
	1704 [label="I can no longer hear those parts of them which were undetermined. Now, I believe, I can only hear that part of them which were.",shape=box,color=blue];
		1704 -> 1705;
		1704 -> 1706;
	1705 [label="I'm sorry, determined?",shape=box,color=red];
		1705 -> 1707;
	1706 [label="When did you... stop hearing him?",shape=box,color=red];
		1706 -> 1708;
	1707 [label="I cannot explain it any more than I already have. I know not how. Forgive me.",shape=box,color=blue];
		1707 -> 1708;
	1708 [label="The moment we passed through the Helminth with Roathe and came here, to the Sanctum. I do not know... why. Or how.",shape=box,color=blue];
		1708 -> 1709;
	1709 [label="But in passing through that veil of time, my friends, my brothers.. the trees whose roots wove through my soul so closely... withered and died beside me.",shape=box,color=blue];
		1709 -> 1710;
	1710 [label="Now an emptiness is there. Rotting. The memory of them still corrupting my own. But I would not give it away if I had the chance...",shape=box,color=blue];
		1710 -> 1711;
		1710 -> 1712;
	1711 [label="Oh?",shape=box,color=red];
		1711 -> 1713;
	1712 [label="Why not?",shape=box,color=red];
		1712 -> 1713;
	1713 [label="I can recall the memory of the first time my mother struck me. I remember it two ways, clear as Sol's brightest light, and I know all versions are true.",shape=box,color=blue];
		1713 -> 1714;
	1714 [label="In one... I weep alone in the darkness of my room. In another, two figures stand beside me in the shadows.",shape=box,color=blue];
		1714 -> 1715;
	1715 [label="I remember twice the first time I took a blade to my skin to clear the voices from my mind. In one, the room is empty.",shape=box,color=blue];
		1715 -> 1716;
	1716 [label="In another, I hear a humming from behind me. I feel the silent presence of a stoic guardian.",shape=box,color=blue];
		1716 -> 1717;
	1717 [label="If I have lost my faith in my goddess of Lua and have gained their guidance in return... it may be a trade I would be willing to give.",shape=box,color=blue];
		1717 -> 1718;
