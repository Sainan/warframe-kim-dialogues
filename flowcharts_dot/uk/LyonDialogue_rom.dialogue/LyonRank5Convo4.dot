	j17288102 [label="[Розмову пропущено внаслідок попередніх налаштувань щодо чутливого вмісту]",shape=box,color=blue];
		j17288102 -> j1028404978;
	j1613042586 [label="Не думаю, що зможу адекватно описати, яке це дивне було відчуття в мить введення сироватки, mon miracle.",shape=box,color=blue];
		j1613042586 -> j295339599;
