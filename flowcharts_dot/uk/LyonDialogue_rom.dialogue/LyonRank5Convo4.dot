	j3986855213 [label="Не думаю, що зможу адекватно описати, яке це дивне було відчуття в мить введення сироватки, дружаньо.",shape=box,color=blue];
		j3986855213 -> j295339599;
		j3986855213 -> j2065858747;
		j3986855213 -> j903421974;
		j3986855213 -> j69289087;
	"Chat ends." [color=orange];
	j1028404978 [label="Boolean LyonRell3 is now true.",color=orange];
		j1028404978 -> j4075781927;
	j295339599 [label="Мені казали, що це неймовірно боляче.",shape=box,color=red];
		j295339599 -> j2952146935;
	j2065858747 [label="Навіть приблизно уявити не можу. ",shape=box,color=red];
		j2065858747 -> j2209741653;
	j903421974 [label="[УВАГА: наводяться короткі згадки про самоушкодження й жорстоке поводження з дітьми. Клацніть тут, щоб завершити розмову. Жодних одиниць сумісності з Ліоном не буде втрачено.]",shape=box,color=red];
		j903421974 -> j1843578849;
	j69289087 [label="[Завершити розмову]",shape=box,color=red];
		j69289087 -> j3856020424;
	j4075781927 [label="Boolean LyonWillDate is now true.",color=orange];
		j4075781927 -> "Chat ends. Next chat will be Lyon5FaithDay2.";
	j2952146935 [label="Припускаю, так і є. Однак в мене роки практики в цьому й попередження Ентраті викликали набагато разючіші передчуття, аніж насправді виявилося.",shape=box,color=blue];
		j2952146935 -> j2209741653;
	j2209741653 [label="Ми з Марі вирішили ввести сироватку окремо, наодинці. Я попрохав її дозволити мені піти, відчути зміни, й потім допомогти їй пройти власний шлях… ясна річ, що вона категорично й уперто відмовилася.",shape=box,color=blue];
		j2209741653 -> j1067175084;
	j1843578849 [label="+20 Chemistry",color=orange];
		j1843578849 -> j2698387260;
	j3856020424 [label="Boolean LyonConfessionFail is now true.",color=orange];
		j3856020424 -> "Chat ends.";
	"Chat ends. Next chat will be Lyon5FaithDay2." [color=orange];
	j1067175084 [label="Жартуючи про саму думку, що я кудись піду чи щось зроблю без її впевненої підтримки, вона попрямувала до власної келії.",shape=box,color=blue];
		j1067175084 -> j2067221979;
	j2698387260 [label="Boolean LyonFamilySuccess is now true.",color=orange];
		j2698387260 -> j2559080857;
	j2067221979 [label="Перш ніж вштрикнути голку в себе, я замкнувся, роздягнувся й сів посеред келії на підлогу, якомога далі від будь-яких предметів.",shape=box,color=blue];
		j2067221979 -> j2149643303;
	j2559080857 [label="Boolean LyonRell3 is now true.",color=orange];
		j2559080857 -> j4008758555;
	j2149643303 [label="Я бачив, що зараження зробило з Роутом, спотворивши плоть його, сплавивши з тим, у що він був убраний. Мені не хотілося для себе таких самих наслідків.",shape=box,color=blue];
		j2149643303 -> j4078815139;
	j4008758555 [label="Boolean LyonFaith3Unknown is now true.",color=orange];
		j4008758555 -> "Chat ends. Next chat will be Lyon5FaithDay2.";
	j4078815139 [label="Коли агонія минула, то зір, який і так страждав… затьмарився. Став якимось чином… двоїтися? Наче я дивився не одним оком, а двома, і бачив різне.",shape=box,color=blue];
		j4078815139 -> j3144671317;
	j3144671317 [label="Я дуже пишаюся своєю стійкістю, однак спромігся вдягнути лише штани, перш ніж мене знудило, а непритомність поглинула свідомість.",shape=box,color=blue];
		j3144671317 -> j571321570;
	j571321570 [label="Отямився я вже не сам. І якимось чином не був на підлозі келії. Я сидів у своїй дитячій на старій скрипучій підлозі, яку так добре знав.",shape=box,color=blue];
		j571321570 -> j2167273278;
	j2167273278 [label="А поруч зі мною сидів юнак. Поруч з ним виднілася постать, як я знаю тепер як Гарроу. Юнак тримав маленьку дерев’яну статуетку. Її кінцівки приєднувалися окремо. Фарба давно витерлася, лише в кількох западинах та тріщинах лишилася. Вона належала моєму батькові. Це був солдатик.",shape=box,color=blue];
		j2167273278 -> j1205311426;
	j1205311426 [label="Це була єдина іграшка, яку я міг назвати своєю у дитинстві.",shape=box,color=blue];
		j1205311426 -> j4147018182;
		j1205311426 -> j1892034149;
	j4147018182 [label="У мене була схожа іграшка, під час мого зростання. Одна з найулюбленіших.",shape=box,color=red];
		j4147018182 -> j2996752928;
	j1892034149 [label="Релл?",shape=box,color=red];
		j1892034149 -> j1709209999;
	j2996752928 [label="Так, я чув про це. Думаю, моя зрештою виявилася набагато м’якшою.",shape=box,color=blue];
		j2996752928 -> j2999979552;
		j2996752928 -> j356024167;
		j2996752928 -> j3933389155;
	j1709209999 [label="Саме так.",shape=box,color=blue];
		j1709209999 -> j2112354661;
	j2999979552 [label="Тракс — складна тема. Ліпше не занурюватимемося туди.",shape=box,color=red];
		j2999979552 -> j1836655594;
	j356024167 [label="Насправді це була не його провина. Він був тим, ким потрібен був мені в той проміжок часу.",shape=box,color=red];
		j356024167 -> j1448615207;
	j3933389155 [label="Усе добре. Він змінюється. Повільно. Але все ж. Навіть неможливе може змінитися.",shape=box,color=red];
		j3933389155 -> j2187799752;
	j2112354661 [label="Юнак та його мовчазний вартовий, які навідали мене уві сні (у моїй голові) були водночас незнайомцями, але й настільки знайомими, наче ми зростали разом як брати.",shape=box,color=blue];
		j2112354661 -> j1490296341;
	j1836655594 [label="Це точно. Ми могли б годинами сидіти, сперечаючись про моральні та теологічні втілення Дувірі.",shape=box,color=blue];
		j1836655594 -> j2112354661;
	j1448615207 [label="Коли розмірковую над найменшою часткою того, що створив би на твоєму місці, то мене поглинає відчуття жаху. Але ми б годинами це тут обговорювали.",shape=box,color=blue];
		j1448615207 -> j2112354661;
	j2187799752 [label="Якщо в ньому проявляються зміни, а він — результат твоїх емоцій, то це може свідчити ще про щось. Та ми це обговоримо котрогось іншого дня, мабуть.",shape=box,color=blue];
		j2187799752 -> j2112354661;
	j1490296341 [label="Пробач мені за надлишковий метафоризм, але ввижалося наче ми три дерева, чиє коріння так зрослося, що неможливо відрізнити одне від одного…",shape=box,color=blue];
		j1490296341 -> j3255151344;
	j3255151344 [label="наче з’явилися в життя одразу в такому стані. Я міг згадати життя без Релла і Гарроу, але вони були там. У кожній миті — кожній версії буття — але поруч зі мною.",shape=box,color=blue];
		j3255151344 -> j3249834968;
	j3249834968 [label="До речі, хотілося б дізнатися в Ентраті докладніше про це. Бо я дуже прагну довідатися про коріння — не жартую — цієї науки. Та повністю оклигавши від змін, ми побачили, що Ентраті нема.",shape=box,color=blue];
		j3249834968 -> j1937133691;
	j1937133691 [label="Check boolean LoidFamilyComplete",color=orange];
		j1937133691 -> j3115075098 [label=true,color=green];
		j1937133691 -> j466458824 [label=false,color=brown];
		j1937133691 -> j3115075098 [label=false,color=brown];
	j3115075098 [label="З тої дрібки, що я знаю про зараження і як воно працює, то воно існує як… ну ніби… наче поза часом.",shape=box,color=red];
		j3115075098 -> j474248947;
	j466458824 [label="Донька Ентраті нагорі. Вона навчалася й працювала поруч із ним. Може, вона зможе допомогти.",shape=box,color=red];
		j466458824 -> j2445225188;
	j474248947 [label="Є… гітара… це дуже складно пояснити… і ми обоє подорожували крізь час усередині гельмінта…",shape=box,color=red];
		j474248947 -> j968601118;
	j2445225188 [label="Boolean LyonFamilySuccess is now true.",color=orange];
		j2445225188 -> j2798281831;
	j968601118 [label="Цей процес ще дуже довго не покидатиме моїх жахітливих сновидінь. Попри це все я не знаю як так вийшло, що ми з Реллом і Гарроу так пов’язані… на молекулярному чи духовному рівнях.",shape=box,color=blue];
		j968601118 -> j3953765517;
	j2798281831 [label="Add 1 to Family counter",color=orange];
		j2798281831 -> j3927362968;
	j3953765517 [label="Але на перехрестях можна йти в обидва боки. Коли вони були в моєму житті, то я був у їхньому. Я бачив Байдужість. Я розумів, супроти чого вони стояли на варті. Я бачив проблиски Гарроу та того чоловіка, яким він колись був.",shape=box,color=blue];
		j3953765517 -> j2022116361;
	j3927362968 [label="Якби ж то нам можна було поговорити з нею. Підозрюю, що певні плани стосовно цього вже є. Тож, можеш розраховувати на мою… допомогу. Я можу бути дуже переконливим за потреби.",shape=box,color=blue];
		j3927362968 -> j3461247693;
	j2022116361 [label="Але натиск Байдужості виявився сильнішим. Я відчував це… чув як вони стукали по стінах. Рап… тап… тап…",shape=box,color=blue];
		j2022116361 -> j1964156370;
	j3461247693 [label="Попри це все я не знаю як так вийшло, що ми з Реллом і Гарроу так пов’язані… на молекулярному чи духовному рівнях.",shape=box,color=blue];
		j3461247693 -> j3953765517;
	j1964156370 [label="Усі видіння мого дитинства, усі ті бачені жахіття — вони були витвором Байдужості? Чи це тепер несправжня пам’ять? Чи я й насправді був «благословенним» Луа?",shape=box,color=blue];
		j1964156370 -> j1377341292;
	j1377341292 [label="Віра в мені… тріснула й розсипалася. Папір зотлів і перетворився на попіл. Як же ж я ненавиджу себе за слабкість…",shape=box,color=blue];
		j1377341292 -> j2547210604;
	j2547210604 [label="Evaluate expressions",color=orange];
		j2547210604 -> j3402912329 [label="LyonDating",color=purple];
		j2547210604 -> j544556716 [label="DrifterFaithYesSimilar",color=purple];
		j2547210604 -> j544556716 [label="DrifterFaithYesForeign",color=purple];
		j2547210604 -> j544556716 [label="DrifterFaithPersonal",color=purple];
		j2547210604 -> j676327151 [label="DrifterFaithSol",color=purple];
		j2547210604 -> j676327151 [label="DrifterFaithLua",color=purple];
		j2547210604 -> j676327151 [label="DrifterFaithBalance",color=purple];
		j2547210604 -> j160328191 [label="DrifterFaithAgnostic",color=purple];
		j2547210604 -> j727119801 [label="DrifterFaithNoFear",color=purple];
		j2547210604 -> j3917799016 [label="DrifterFaithNoMITW",color=purple];
		j2547210604 -> j727119801 [label="DrifterFaithNoMaybe",color=purple];
		j2547210604 -> j2282325981 [label="false",color=purple];
	j3402912329 [label="Ох, Ліоне… тобі довелося стільки пережити. Сумніви — не результат слабкості. Сумніви — результат болю.",shape=box,color=red];
		j3402912329 -> j254562017;
		j3402912329 -> j4161277936;
		j3402912329 -> j2644033074;
		j3402912329 -> j1578720596;
		j3402912329 -> j3713815761;
	j544556716 [label="Віра не завжди має бути постійною… та цього й не очікується. Є стільки історій про тих, хто втрачає віру для того, щоби згодом її знову знайти.",shape=box,color=red];
		j544556716 -> j254562017;
		j544556716 -> j4161277936;
		j544556716 -> j2644033074;
	j676327151 [label="Ліоне, твоє життя пройшло у присвяті нашим Світочам. Невже ти вважаєш, що вони через щось таке відвернуться від тебе?",shape=box,color=red];
		j676327151 -> j254562017;
		j676327151 -> j4161277936;
		j676327151 -> j2644033074;
	j160328191 [label="Ліоне, я не знаю, існують боги чи ні… не знаю, чи хоч хтось із нас дізнається. Але знаю, що тобі довелося пройти крізь непрості часи.",shape=box,color=red];
		j160328191 -> j254562017;
		j160328191 -> j2644033074;
		j160328191 -> j1578720596;
	j727119801 [label="Я особисто не вірю в існування богів у цьому світі, але знаю важливість цього у твоєму житті. І не хочу применшувати це.",shape=box,color=red];
		j727119801 -> j2644033074;
		j727119801 -> j3713815761;
	j3917799016 [label="Ліоне, Байдужість створена нами — то не божество. Не дай помилкам Ентраті знищити тебе. А щодо віри?",shape=box,color=red];
		j3917799016 -> j2644033074;
		j3917799016 -> j3713815761;
	j2282325981 [label="Боляче бачити тебе таким, затягнутим у цю маячню. Ти такого не заслуговуєш.",shape=box,color=red];
		j2282325981 -> j254562017;
		j2282325981 -> j4161277936;
		j2282325981 -> j2644033074;
		j2282325981 -> j1578720596;
		j2282325981 -> j3713815761;
	j254562017 [label="Я не кажу, що тобі потрібно знову відшукати віру. Я кажу, що за бажання… якщо виникне потреба… то це не те що втрачають назавжди.",shape=box,color=red];
		j254562017 -> j3425104748;
	j4161277936 [label="Звісно, Луа бачить крізь що ти пройшов. Що ти витримав в її ім’я. ",shape=box,color=red];
		j4161277936 -> j3462621501;
	j2644033074 [label="Я думаю, що тобі варто зосередитися на пошуках примирення з собою.",shape=box,color=red];
		j2644033074 -> j3425104748;
	j1578720596 [label="Якщо є боги, якщо існує твоя Луа — то дійсно вона бачить крізь що ти пройшов. Що витримав у її ім’я. Це має щось означати для неї.",shape=box,color=red];
		j1578720596 -> j3462621501;
	j3713815761 [label="Гадаю, тобі варто відкинути роздуми про існування богів і першочергово зосередитися на зціленні себе.",shape=box,color=red];
		j3713815761 -> j3799475233;
	j3425104748 [label="Boolean LyonFaith3Maybe is now true.",color=orange];
		j3425104748 -> j639152911;
	j3462621501 [label="Boolean LyonFaith3Yes is now true.",color=orange];
		j3462621501 -> j639152911;
	j3799475233 [label="Boolean LyonFaith3No is now true.",color=orange];
		j3799475233 -> j639152911;
	j639152911 [label="Може й твоя правда… І сумна історія про мої сумніви навряд чи була метою бесіди. Але я поміркую над твоїми словами. Ми це докладно обговоримо завтра.",shape=box,color=blue];
		j639152911 -> j1490681403;
	j1490681403 [label="Я бачив життя Релла на «Заримені 10.0» і те, що він пережив після. Я бачив життя Гарроу як солдата, змарніле від зараження. Точно так, як вони бачили моє життя і страждання у Ґоллі.",shape=box,color=blue];
		j1490681403 -> j941858714;
	j941858714 [label="Може видатися дивним, що ми ніколи не промовили ані слова одне до одного. Потреби не було. Між нами існувало якесь… розуміння.",shape=box,color=blue];
		j941858714 -> j388221499;
		j941858714 -> j206631151;
	j388221499 [label="Серйозно? Ніколи?",shape=box,color=red];
		j388221499 -> j1694730071;
	j206631151 [label="Ага… я це розумію.",shape=box,color=red];
		j206631151 -> j1803431747;
	j1694730071 [label="Я чув їхні голоси… знав усі сказані ними слова за життя. Але ніколи ті слова не були сказані до мене.",shape=box,color=blue];
		j1694730071 -> j1803431747;
	j1803431747 [label="Хіба усмішка потребує слів? А насуплені брови? Чи потрібно чути плач дитини, щоб зрозуміти її біль або страх? Ні, ми просто знали те, що відбувається між нами.",shape=box,color=blue];
		j1803431747 -> j3351064286;
	j3351064286 [label="Доки… доки цього не стало.",shape=box,color=blue];
		j3351064286 -> j944777217;
	j944777217 [label="Check boolean LyonDating",color=orange];
		j944777217 -> j2716758828 [label=true,color=green];
		j944777217 -> j3748441866 [label=false,color=brown];
	j2716758828 [label="Вони не зникли, mon miracle… просто померли.",shape=box,color=blue];
		j2716758828 -> j3465465695;
	j3748441866 [label="Вони не зникли, дружаньо… просто померли.",shape=box,color=blue];
		j3748441866 -> j3465465695;
	j3465465695 [label="Я більше не чую тих їхніх частин, які були невизначеними. Тепер, здається, я можу чути лише ту частку, яка завжди була.",shape=box,color=blue];
		j3465465695 -> j1182131391;
		j3465465695 -> j136237041;
	j1182131391 [label="Перепрошую, визначеними?",shape=box,color=red];
		j1182131391 -> j2395712168;
	j136237041 [label="А коли ти… перестав чути його?",shape=box,color=red];
		j136237041 -> j2241072773;
	j2395712168 [label="Я не можу пояснити більше, ніж уже зробив. Я не знаю як. Пробач.",shape=box,color=blue];
		j2395712168 -> j2241072773;
	j2241072773 [label="У мить, коли ми пройшли крізь гельмінта з Роутом і з’явилися тут, у святилищі. Я не знаю… чому. Чи як.",shape=box,color=blue];
		j2241072773 -> j3164124099;
	j3164124099 [label="Та під час проходу крізь часову вуаль мої друзі, мої брати… дерева, чиє коріння так переплелося у моїй душі… засохли й померли поруч зі мною.",shape=box,color=blue];
		j3164124099 -> j3738987800;
	j3738987800 [label="Тепер там нічого нема. Гниль одна. Їхні спогади досі шкодять мої. Але я б ніколи не віддав цього, якби випала нагода…",shape=box,color=blue];
		j3738987800 -> j3619968115;
		j3738987800 -> j2636242903;
	j3619968115 [label="Як так?",shape=box,color=red];
		j3619968115 -> j3918852386;
	j2636242903 [label="Чому ні?",shape=box,color=red];
		j2636242903 -> j3918852386;
	j3918852386 [label="Я можу згадати перший раз, коли матір ударила мене. Я пам’ятаю це у двох варіантах, чітко як найяскравіше світло Сола. І я знаю, що обидві версії істинні.",shape=box,color=blue];
		j3918852386 -> j1760909476;
	j1760909476 [label="В одній… я ридаю на самоті в темряві своєї кімнати. А в іншій дві постаті стоять у тінях поруч зі мною.",shape=box,color=blue];
		j1760909476 -> j1120623489;
	j1120623489 [label="Я двічі пам’ятаю, як уперше приклав лезо до шкіри, щоби позбутися голосів у голові. В одному спогаді кімната порожня.",shape=box,color=blue];
		j1120623489 -> j3046150830;
	j3046150830 [label="В іншому я чую бурмотіння позаду себе. Я відчуваю мовчазну присутність непохитного вартового.",shape=box,color=blue];
		j3046150830 -> j1120261493;
	j1120261493 [label="Якби я втратив віру у свою богиню Луа й натомість отримав їхні настанови… то це був би той обмін, на який я охоче пішов би.",shape=box,color=blue];
		j1120261493 -> j2400849994;
	j2400849994 [label="Evaluate expressions",color=orange];
		j2400849994 -> j4000851158 [label="LyonDating",color=purple];
		j2400849994 -> j3781325879 [label="LyonDating",color=purple];
		j2400849994 -> j4000851158 [label="DrifterFaithYesSimilar",color=purple];
		j2400849994 -> j1211985666 [label="DrifterFaithYesSimilar",color=purple];
		j2400849994 -> j4000851158 [label="DrifterFaithYesForeign",color=purple];
		j2400849994 -> j1211985666 [label="DrifterFaithYesForeign",color=purple];
		j2400849994 -> j4000851158 [label="DrifterFaithPersonal",color=purple];
		j2400849994 -> j1211985666 [label="DrifterFaithPersonal",color=purple];
		j2400849994 -> j4000851158 [label="DrifterFaithSol",color=purple];
		j2400849994 -> j809489465 [label="DrifterFaithSol",color=purple];
		j2400849994 -> j4000851158 [label="DrifterFaithLua",color=purple];
		j2400849994 -> j809489465 [label="DrifterFaithLua",color=purple];
		j2400849994 -> j4000851158 [label="DrifterFaithBalance",color=purple];
		j2400849994 -> j809489465 [label="DrifterFaithBalance",color=purple];
		j2400849994 -> j4000851158 [label="DrifterFaithAgnostic",color=purple];
		j2400849994 -> j4254692799 [label="DrifterFaithAgnostic",color=purple];
		j2400849994 -> j4000851158 [label="DrifterFaithNoFear",color=purple];
		j2400849994 -> j608315466 [label="DrifterFaithNoFear",color=purple];
		j2400849994 -> j4000851158 [label="DrifterFaithNoMITW",color=purple];
		j2400849994 -> j608315466 [label="DrifterFaithNoMITW",color=purple];
		j2400849994 -> j4000851158 [label="DrifterFaithNoMaybe",color=purple];
		j2400849994 -> j608315466 [label="DrifterFaithNoMaybe",color=purple];
		j2400849994 -> j4000851158 [label="false",color=purple];
		j2400849994 -> j608315466 [label="false",color=purple];
	j4000851158 [label="Мені… так прикро за те, що вам обом довелося пережити.",shape=box,color=red];
		j4000851158 -> j1574804991;
	j3781325879 [label="Я… Ліоне, я дуже радію тому, що Релл і Гарроу могли бути поруч… навіть якщо це було лише в спогадах.",shape=box,color=red];
		j3781325879 -> j4233144301;
	j1211985666 [label="Ти не думав, що це все… робота бога чи богів? Щоб дати тобі втіху?",shape=box,color=red];
		j1211985666 -> j2864928941;
	j809489465 [label="Ти не думав, що це все… робота Луа? Щоб дати тобі втіху?",shape=box,color=red];
		j809489465 -> j2864928941;
	j4254692799 [label="Я не знаю як, оскільки це мало взаємно виключати одне одного, але… я не знаю. Не знаю, чи коли-небудь узагалі дізнаємося.",shape=box,color=red];
		j4254692799 -> j658282124;
	j608315466 [label="Я… Ліоне, я дуже радію тому, що Релл і Гарроу могли бути поруч… навіть якщо це було лише в спогадах.",shape=box,color=red];
		j608315466 -> j1574804991;
	j1574804991 [label="Дякую, я сумую за їхньою присутністю. Але… в цьому місці я дізнався, що більше є таких, хто розуміє мій біль, аніж не розуміє.",shape=box,color=blue];
		j1574804991 -> j3609179048;
	j4233144301 [label="Дякую, я сумую за їхньою присутністю. Але… я вже ж більше не сам, чи не так, mon miracle?",shape=box,color=blue];
		j4233144301 -> j3609179048;
	j2864928941 [label="Так. Не думай, що я над цим не міркував. Не впевнений, чи так легко буду відновити віру, але… думати про це — вже велика втіха.",shape=box,color=blue];
		j2864928941 -> j3609179048;
	j658282124 [label="Саме так. Не думай, що мені не спадало на думку ідея послання Світилами Релла та Гарроу для моєї втіхи. Але, як ти й пишеш, нам про це не дізнатися.",shape=box,color=blue];
		j658282124 -> j3609179048;
	j3609179048 [label="+20 Chemistry",color=orange];
		j3609179048 -> j2134603794;
	j2134603794 [label="Аж камінь з душі спав після цієї розмови. Це завеликий тягар, і я невимовно вдячний за те, що тепер він не висить наді мною.",shape=box,color=blue];
		j2134603794 -> j918154824;
	j918154824 [label="Check boolean LyonDating",color=orange];
		j918154824 -> j2859291903 [label=true,color=green];
		j918154824 -> j2682402447 [label=false,color=brown];
	j2859291903 [label="Наразі мушу йти, mon miracle.",shape=box,color=blue];
		j2859291903 -> j1028404978;
	j2682402447 [label="Наразі мушу йти, дружаньо.",shape=box,color=blue];
		j2682402447 -> j1028404978;
}