digraph {
	"LyonRank4Convo7 begins." [color=orange];
		"LyonRank4Convo7 begins." -> j2560472261;
	j2560472261 [label="Drifter? May I apologize to you for something?",shape=box,color=blue];
		j2560472261 -> j2558082701;
		j2560472261 -> j3579933439;
		j2560472261 -> j1478915251;
	j2558082701 [label="Sure? What for?",shape=box,color=red];
		j2558082701 -> j447434966;
	j3579933439 [label="You don't need to, Lyon. You haven't done anything wrong.",shape=box,color=red];
		j3579933439 -> j1511797338;
	j1478915251 [label="[Завершити розмову]",shape=box,color=red];
		j1478915251 -> "Chat ends.";
	j447434966 [label="+5 Chemistry",color=orange];
		j447434966 -> j745904133;
	j1511797338 [label="While I appreciate that, I do feel as though you are owed one all the same. I shall do my best to keep this brief, and not to overburden myself with needless erudition.",shape=box,color=blue];
		j1511797338 -> j807309276;
	"Chat ends." [color=orange];
	j745904133 [label="Thank you. I shall do my best to keep this brief, and not to overburden myself with needless erudition.",shape=box,color=blue];
		j745904133 -> j807309276;
	j807309276 [label="Conversations are difficult for me. Far more so in intimate engagements than they are in these kinds of impersonal, mechanical ones or by post.",shape=box,color=blue];
		j807309276 -> j540466264;
	j540466264 [label="I do not know how to describe it - save for that it is... like I am grasping for something, only to see bits of dust slip through my fingers. ",shape=box,color=blue];
		j540466264 -> j4019497296;
	j4019497296 [label="It feels oft as though I am an empty scrap of canvas, smearing oil paints upon its surface - uselessly attempting create a shadow of an image that I can see in my mind's eye.",shape=box,color=blue];
		j4019497296 -> j2007086283;
	j2007086283 [label="Yet the more and more I work, the more and more hopeless it becomes.",shape=box,color=blue];
		j2007086283 -> j727165523;
	j727165523 [label="The more I try, the more it eludes me. So I have simply learned... not to make any attempt at all.",shape=box,color=blue];
		j727165523 -> j4178386567;
	j4178386567 [label="That is why I avoided you at first. And why I am still... prone to bouts of solitude. Words escape me.",shape=box,color=blue];
		j4178386567 -> j661340585;
		j4178386567 -> j582809211;
		j4178386567 -> j4092641329;
	j661340585 [label="I will always be happy to have you next to me in silence.",shape=box,color=red];
		j661340585 -> j3460969536;
	j582809211 [label="I tend to be the same way, sometimes. It's all right.",shape=box,color=red];
		j582809211 -> j3696628448;
	j4092641329 [label="Apology accepted.",shape=box,color=red];
		j4092641329 -> j3584761031;
	j3460969536 [label="+15 Chemistry",color=orange];
		j3460969536 -> j783996921;
	j3696628448 [label="+15 Chemistry",color=orange];
		j3696628448 -> j2125444429;
	j3584761031 [label="+10 Chemistry",color=orange];
		j3584761031 -> j2045573396;
	j783996921 [label="I... will remember that. Thank you, Drifter.",shape=box,color=blue];
		j783996921 -> j3545001372;
	j2125444429 [label="I had not realized. I will remember not to assume I am so alone in this world... Thank you, Drifter.",shape=box,color=blue];
		j2125444429 -> j3545001372;
	j2045573396 [label="Of course. Thank you, Drifter.",shape=box,color=blue];
		j2045573396 -> j3545001372;
	j3545001372 [label="Отець Ліон Аллард",shape=box,color=blue];
		j3545001372 -> "Chat ends.";
}