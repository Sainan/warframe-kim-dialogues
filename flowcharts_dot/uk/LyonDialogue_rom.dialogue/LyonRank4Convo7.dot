	"LyonRank4Convo7 begins." [color=orange];
		"LyonRank4Convo7 begins." -> j2094489151;
	j2094489151 [label="Мандрівниче, я можу вибачитися за дещо?",shape=box,color=blue];
		j2094489151 -> j3562665186;
		j2094489151 -> j1575114335;
		j2094489151 -> j1478915251;
	j3562665186 [label="Звісно. А за що?",shape=box,color=red];
		j3562665186 -> j314426815;
	j1575114335 [label="Не має потреби, Ліоне. Ти не вчинив нічого поганого.",shape=box,color=red];
		j1575114335 -> j3950080725;
	j1478915251 [label="[Завершити розмову]",shape=box,color=red];
		j1478915251 -> "Chat ends.";
	j314426815 [label="+5 Chemistry",color=orange];
		j314426815 -> j2966461179;
	j3950080725 [label="Удячний за такі слова, але все одно відчуваю, що маю таки перепросити. Зроблю все можливе, аби це було коротко й не обтяжуватиму текст зайвими високими словами ерудованої особи.",shape=box,color=blue];
		j3950080725 -> j1910177198;
	"Chat ends." [color=orange];
	j2966461179 [label="Дякую. Зроблю все можливе, аби це було коротко й не обтяжуватиму текст зайвими високими словами ерудованої особи.",shape=box,color=blue];
		j2966461179 -> j1910177198;
	j1910177198 [label="Розмови — складна взаємодія для мене. Дуже складна впритул, а от у таких безособових механічних зустрічах чи за допомогою листування — набагато все легше.",shape=box,color=blue];
		j1910177198 -> j804047549;
	j804047549 [label="Я не знаю як ліпше описати… я ніби хапаюся за щось, але воно розсипається прахом і прослизає між пальців. ",shape=box,color=blue];
		j804047549 -> j3586133569;
	j3586133569 [label="Буває, що я ввижаюся собі порожнім клаптем полотна, на якому розвезюють олійні фарби в марних спробах відтворити тінь образу, який я бачу у власній голові.",shape=box,color=blue];
		j3586133569 -> j1997220670;
	j1997220670 [label="І що більше я працюю над цим, то безпораднішим здаюся — нічого не виходить.",shape=box,color=blue];
		j1997220670 -> j1939258902;
	j1939258902 [label="Що більше намагаюся, то гірше вдається. Тож я просто навчився… узагалі не намагатися.",shape=box,color=blue];
		j1939258902 -> j2528692527;
	j2528692527 [label="Саме тому я уникав тебе спочатку. І саме тому я… досі схильний до нападів потреби в самотності. Слова втікають від мене.",shape=box,color=blue];
		j2528692527 -> j3167756779;
		j2528692527 -> j446140306;
		j2528692527 -> j1305428958;
	j3167756779 [label="Я з радістю вітатиму твоє мовчазне перебування поруч.",shape=box,color=red];
		j3167756779 -> j772284640;
	j446140306 [label="На мене теж іноді таке находить. Усе добре.",shape=box,color=red];
		j446140306 -> j306081974;
	j1305428958 [label="Вибачення прийнято.",shape=box,color=red];
		j1305428958 -> j3616888988;
	j772284640 [label="+15 Chemistry",color=orange];
		j772284640 -> j3440414673;
	j306081974 [label="+15 Chemistry",color=orange];
		j306081974 -> j634564617;
	j3616888988 [label="+10 Chemistry",color=orange];
		j3616888988 -> j377419272;
	j3440414673 [label="Я… запам’ятаю це. Дякую, мандрівниче.",shape=box,color=blue];
		j3440414673 -> j3545001372;
	j634564617 [label="Я не усвідомлював цього. Запам’ятаю, що не варто вважати лише себе однією самотньою людиною у всьому світі… Дякую, мандрівниче.",shape=box,color=blue];
		j634564617 -> j3545001372;
	j377419272 [label="Звісно. Дякую, мандрівниче.",shape=box,color=blue];
		j377419272 -> j3545001372;
	j3545001372 [label="Отець Ліон Аллард",shape=box,color=blue];
		j3545001372 -> "Chat ends.";
}