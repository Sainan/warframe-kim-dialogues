		"LyonRank3Convo6 begins." -> j1478915251;
	j1401947862 [label="Як довго Ентраті був з вами в соборі, поки не з’явився Роут?",shape=box,color=red];
		j1401947862 -> j766515324;
	j1478915251 [label="[Завершити розмову]",shape=box,color=red];
		j1478915251 -> "Chat ends.";
	j766515324 [label="Чому ти питаєш мене про це?",shape=box,color=blue];
		j766515324 -> j4196769031;
	"Chat ends." [color=orange];
	j4196769031 [label="Evaluate expressions",color=orange];
		j4196769031 -> j4242793034 [label="MarieLyonVisions",color=purple];
		j4196769031 -> j3611617253 [label="MarieLyonVisions",color=purple];
		j4196769031 -> j3825158383 [label="MarieLyonVisions",color=purple];
		j4196769031 -> j942601678 [label="MarieLyonVisions",color=purple];
		j4196769031 -> j3611617253 [label="LyonVisions1",color=purple];
		j4196769031 -> j3825158383 [label="LyonVisions1",color=purple];
		j4196769031 -> j942601678 [label="LyonVisions1",color=purple];
		j4196769031 -> j4242793034 [label="LyonVisions1",color=purple];
		j4196769031 -> j3611617253 [label="false",color=purple];
		j4196769031 -> j3825158383 [label="false",color=purple];
	j4242793034 [label="Мені сказали, що ти можеш бачити речі не так, як ми. Але це мене не обходить. Мене цікавлять твої знання.",shape=box,color=red];
		j4242793034 -> j3977606946;
	j3611617253 [label="Схоже, Марі одержима «le Cardinal», а Роут явно його ненавидить. Я шукаю нейтрального погляду. Твій відповідає цьому критерію.",shape=box,color=red];
		j3611617253 -> j941705085;
	j3825158383 [label="Я… не знаю, про що ще можна спитати.",shape=box,color=red];
		j3825158383 -> j346364705;
	j942601678 [label="Мені сказали, що ти можеш бачити речі не так, як ми. Але думаю, що ти можеш бачити правду, яку не бачать інші.",shape=box,color=red];
		j942601678 -> j861192355;
	j3977606946 [label="Гм. Тебе не бентежить спілкування з божевільними психопатами? Цікаво. Хоча ти ж спілкуєшся з балакучими тваринами й… істотами з позачасся. Припускаю, я не більше й не менше чудернацький, аніж хтось із решти твоєї колекції.",shape=box,color=blue];
		j3977606946 -> j2845885253;
	j941705085 [label="Так мало в тебе було варіантів, що божевільний психопат виявився єдиним із «нейтральною» думкою. Навіть складно зрозуміти, чого ти зі мною досі спілкуєшся.",shape=box,color=blue];
		j941705085 -> j2845885253;
	j346364705 [label="Чого ти взагалі так прагнеш спілкування зі мною? У ньому ж немає потреби. Якщо ти хочеш дружити з Марі, або й навіть фліртувати — я їй не опікун і не батько. А які в тебе плани на цього виродка Роута — мене взагалі не цікавить. Від нього я лише чекаю обіцяних відповідей.",shape=box,color=blue];
		j346364705 -> j2845885253;
	j861192355 [label="«Правду». О, якби ж тобі знати, як це смішно для мене останнім часом. Тебе не бентежить спілкування з божевільними психопатами? Цікаво. Хоча ти ж спілкуєшся з балакучими тваринами й… істотами з позачасся. Припускаю, я не більше й не менше чудернацький, аніж хтось із решти твоєї колекції.",shape=box,color=blue];
		j861192355 -> j2845885253;
	j2845885253 [label="Evaluate expressions",color=orange];
		j2845885253 -> j1049743249 [label="LyonFirstFlirt",color=purple];
		j2845885253 -> j1049743249 [label="DrifterLyon",color=purple];
		j2845885253 -> j2078702248 [label="LyonOffer",color=purple];
		j2845885253 -> j2282546307 [label="false",color=purple];
	j1049743249 [label="І прошу тебе, позбав нас чергових… незручних ганебних моментів добре? Я розумію, що вказані причини поговорити зі мною. Попри те, що вони мені лестять… це безглуздо нещирі слова, як на мене.",shape=box,color=blue];
		j1049743249 -> j4079604106;
		j1049743249 -> j2929332512;
		j1049743249 -> j1801603756;
	j2078702248 [label="І прошу тебе, позбав нас чергових тирад про те, як ти хочеш «допомогти», добре? Упевнений, що ти намагаєшся проявити доброту, але це невимовно дратує безглуздою нещирістю.",shape=box,color=blue];
		j2078702248 -> j4079604106;
		j2078702248 -> j2929332512;
		j2078702248 -> j1801603756;
	j2282546307 [label="І прошу тебе, позбав нас довгих лекцій про те, як ти хочеш «допомогти» чи «дружити». Упевнений, що ти намагаєшся проявити доброту, але це невимовно дратує безглуздою нещирістю.",shape=box,color=blue];
		j2282546307 -> j4079604106;
		j2282546307 -> j2929332512;
		j2282546307 -> j1801603756;
	j4079604106 [label="Нещирі, бо ти вважаєш, що написане не є моїми думками? Чи нещирі, бо ти вважаєш, що їх не можна застосувати до тебе?",shape=box,color=red];
		j4079604106 -> j3264240912;
	j2929332512 [label="Священнику, мені потрібно знати, як довго Ентраті видавав себе за кардинала. От і все.",shape=box,color=red];
		j2929332512 -> j2123475229;
	j1801603756 [label="Що ти маєш на увазі під «нещирістю»? Я брешу, по твоєму?",shape=box,color=red];
		j1801603756 -> j5625625;
	j3264240912 [label="Ні те, ані інше. Твої слова — милосердя, якого я не потребую і не хочу.",shape=box,color=blue];
		j3264240912 -> j2713314908;
		j3264240912 -> j2656727002;
	j2123475229 [label="Дуже правильно. 3 роки, 2 місяці й 11 днів він був у нашому соборі як кардинал Діманш. Увесь той час ми з Марі прислуговували йому, не знаючи про підготовлені для нас плани.",shape=box,color=blue];
		j2123475229 -> j294829571;
	j5625625 [label="Evaluate expressions",color=orange];
		j5625625 -> j1894947051 [label="DrifterLiar",color=purple];
		j5625625 -> j3323496645 [label="LyonSuspicious",color=purple];
		j5625625 -> j3068688142 [label="false",color=purple];
	j2713314908 [label="Як Марі ставиться до цього всього?..",shape=box,color=red];
		j2713314908 -> j416678477;
	j2656727002 [label="Вважаєш, що будь-чия спроба налагодити з тобою зв’язок — акт милосердя?",shape=box,color=red];
		j2656727002 -> j2293164241;
	j294829571 [label="Я знаю твої питання, перш ти їх поставиш. Що він планував? Він заразив місто, як, за чутками, зробив із Голвенією? У чому був замисел? Що він відкрив для себе?",shape=box,color=blue];
		j294829571 -> j4202753024;
	j1894947051 [label="Мандрівниче, є щось, у чому хочеш покаятися? Бажаєш щось спокутувати?",shape=box,color=blue];
		j1894947051 -> j182399528;
	j3323496645 [label="Гм. Ні. Напевно, ще ні.",shape=box,color=blue];
		j3323496645 -> j3068688142;
	j3068688142 [label="Твоя нещирість не є неправдою. Вона є милосердям. Мене не потрібно жаліти, я цього не хочу. ",shape=box,color=blue];
		j3068688142 -> j2713314908;
		j3068688142 -> j2656727002;
	j416678477 [label="Ліпше спитати в неї. Мене часто відвідують подібні думки.",shape=box,color=blue];
		j416678477 -> "Chat ends.";
	j2293164241 [label="Якщо просто відповідати? Так.",shape=box,color=blue];
		j2293164241 -> j3994772085;
	j4202753024 [label="То на це скажу — ти розчаруєшся. Усі ці 3 роки, 2 місяці, 11 днів він проповідував. Навчався. Відпочивав. Молився.",shape=box,color=blue];
		j4202753024 -> j2081270307;
		j4202753024 -> j1542169965;
		j4202753024 -> j867328234;
	j182399528 [label="Це не однакове ніде. Ти в цій бесіді не задля прощення. І твоя минула брехня не така сама, як поточна нещирість.",shape=box,color=blue];
		j182399528 -> j2237325433;
	j3994772085 [label="Boolean LyonHate1 is now true.",color=orange];
		j3994772085 -> j4209145224;
		j3994772085 -> j3926729915;
		j3994772085 -> j2448559354;
	j2081270307 [label="Коли він перетворив вас на протофреймів?",shape=box,color=red];
		j2081270307 -> j4022855728;
	j1542169965 [label="Щось мені дуже складно уявити як Ентраті молиться.",shape=box,color=red];
		j1542169965 -> j2761855463;
	j867328234 [label="То в нього була… творча відпустка?!",shape=box,color=red];
		j867328234 -> j1486231842;
	j2237325433 [label="Твої нинішні слова всього лише милосердя. Милосердя, якого я не потребую і не хочу.",shape=box,color=blue];
		j2237325433 -> j2713314908;
		j2237325433 -> j2656727002;
	j4209145224 [label="Це треба відкласти на тему іншого дня — розмова відходить далебі в сторону.",shape=box,color=red];
		j4209145224 -> j4263928959;
	j3926729915 [label="А що Марі?..",shape=box,color=red];
		j3926729915 -> j2848659084;
	j2448559354 [label="Певно, ти дуже низької думки про себе.",shape=box,color=red];
		j2448559354 -> j2259714026;
	j4022855728 [label="Після тих трьох років і ще трохи днів він зник посеред жахливої бурі. Точнісінько такої, у якій з’явився.",shape=box,color=blue];
		j4022855728 -> j3307858394;
	j2761855463 [label="Неможливо пізнати внутрішній світ чужої свідомості. Він стояв навколішки перед вівтарем зі схиленою головою. Чи молився тоді? Чи просто занурювався у свої думки? Я не знаю.",shape=box,color=blue];
		j2761855463 -> j4022855728;
	j1486231842 [label="+5 Chemistry",color=orange];
		j1486231842 -> j3671732213;
	j4263928959 [label="+5 Chemistry",color=orange];
		j4263928959 -> j2194046342;
	j2848659084 [label="Марі може колихати скаженого ведмедя й дозволить собі розірвати горлянку, якщо вважатиме, що це дасть спокій тварині.",shape=box,color=blue];
		j2848659084 -> j1313838495;
	j2259714026 [label="Я радше вважаю це непохитною відданістю прагматизму. Але ти можеш визначати як тобі завгодно.",shape=box,color=blue];
		j2259714026 -> j1557317493;
	j3307858394 [label="Evaluate expressions",color=orange];
		j3307858394 -> j92427798 [label="MarieLyonVisions",color=purple];
		j3307858394 -> j92427798 [label="LyonVisions1",color=purple];
		j3307858394 -> j306694449 [label="false",color=purple];
	j3671732213 [label="Ха. У такому ключі я не думав про це, але так… дуже схоже. Це ж так дратує всіх вас. Однак дуже підходить тому його істинному «Я», хоч яку крихту якого ми знаємо.",shape=box,color=blue];
		j3671732213 -> j4022855728;
	j2194046342 [label="Схоже, це мудре рішення. Твої питання були про «кардинала Діманше» і його перебування в соборі.",shape=box,color=blue];
		j2194046342 -> j2967325954;
	j1313838495 [label="Виняткова прекрасна душа. Я захищатиму її до свого останнього присмертного подиху.",shape=box,color=blue];
		j1313838495 -> j1557317493;
	j1557317493 [label="+5 Chemistry",color=orange];
		j1557317493 -> j2945817124;
	j92427798 [label="Хоча я усвідомлюю, що та буря не існувала для інших — для мене лихоліття природи було дуже яскравим.",shape=box,color=blue];
		j92427798 -> j306694449;
	j306694449 [label="Рівно через рік після цього він знову з’явився… востаннє… Роут, такий, як зараз, лежав скоцюблений і непритомний біля його ніг.",shape=box,color=blue];
		j306694449 -> j976089791;
	j2967325954 [label="3 роки, 2 місяці й 11 днів він був у нашому соборі як кардинал Діманш. Увесь той час ми з Марі прислуговували йому, не знаючи про підготовлені для нас плани.",shape=box,color=blue];
		j2967325954 -> j294829571;
	j2945817124 [label="Саме таке варто очікувати від простих запитань божевільному — тебе заведе геть далеко й заблудить у словесах. Дозволь я поверну нас до початкової теми й відверну від обговорень себе самого.",shape=box,color=blue];
		j2945817124 -> j2967325954;
	j976089791 [label="Диявол у плоті… або так видавалося. Саме тоді Ентраті привітався з нами й розповів нам істину про себе і яке єдине справжнє завдання для нас є.",shape=box,color=blue];
		j976089791 -> j1745450075;
	j1745450075 [label="Він обрав нас обох для «найсвященнішого завдання».",shape=box,color=blue];
		j1745450075 -> j3238881182;
		j1745450075 -> j977289444;
	j3238881182 [label="Чому в лапках?",shape=box,color=red];
		j3238881182 -> j2642520291;
	j977289444 [label="Схоже, ти не довіряєш йому.",shape=box,color=red];
		j977289444 -> j2642520291;
	j2642520291 [label="Я дізнався чимало такого, що змушує ставити під сумнів відданість Ентраті бодай чомусь священному… будь-якої природи чи божественної сутності… якщо взагалі щось таке існує…",shape=box,color=blue];
		j2642520291 -> j1372629733;
		j2642520291 -> j3003462117;
	j1372629733 [label="Якщо взагалі щось таке існує? Ліоне, ти про що взагалі?",shape=box,color=red];
		j1372629733 -> j553146687;
	j3003462117 [label="Продовжуй.",shape=box,color=red];
		j3003462117 -> j1109782823;
	j553146687 [label="Boolean LyonFaith2 is now true.",color=orange];
		j553146687 -> j907320292;
	j1109782823 [label="Марі охоче прийняла сироватку. Звісно, як інакше. Як могла відмовити? І як я міг не піти за нею? Як я міг не шукати істини, куди б це мене не завело?",shape=box,color=blue];
		j1109782823 -> j1813802388;
	j907320292 [label="Думаю, облишмо цю тему для іншого разу.",shape=box,color=blue];
		j907320292 -> j1109782823;
	j1813802388 [label="Boolean LyonSerum1 is now true.",color=orange];
		j1813802388 -> j2507149962;
		j1813802388 -> j5862122;
		j1813802388 -> j1240129198;
	j2507149962 [label="Гадаю, вона й досі занадто вірує в Ентраті.",shape=box,color=red];
		j2507149962 -> j3223866595;
	j5862122 [label="Що трапилося далі?",shape=box,color=red];
		j5862122 -> j3180198800;
	j1240129198 [label="Ти шкодуєш про це?",shape=box,color=red];
		j1240129198 -> j2009376393;
	j3223866595 [label="Boolean LyonMarieEntrati is now true.",color=orange];
		j3223866595 -> j2486003783;
	j3180198800 [label="Роут прокинувся. Спершу він ледь ім’я своє згадати міг. Ентраті сказав виродку одну фразу на прощання. «Уриїле, Єретику Зати, у вигнанні, дай відповідь — чи можна коли-небудь пробачити орокіна?».",shape=box,color=blue];
		j3180198800 -> j3664406744;
	j2009376393 [label="Я шкодую про все, мандрівниче. Так, звісно. Але чи вчинив би так само? Так, звісно вчинив би. Я не облишу Марі саму.",shape=box,color=blue];
		j2009376393 -> j1346554191;
	j2486003783 [label="Погоджуюся в цьому. Але також не можу винити її в цьому. Дай їй час. Вона зрозуміє з часом. Мандрівниче, вона навдивовижу розумна. Не думай, що вона дурепа.",shape=box,color=blue];
		j2486003783 -> j1346554191;
	j3664406744 [label="Ентраті знову зник. Востаннє. А Роута покинув із нами. А нині той перетворився на те, що бачиш — тож ліпше шукай способи боротьби з норовливим дияволом.",shape=box,color=blue];
		j3664406744 -> j1777406421;
	j1346554191 [label="Що ж, завершімо оповідь. Ентраті знову зник. Востаннє. А Роута покинув із нами. А нині той перетворився на те, що бачиш — тож ліпше шукай способи боротьби з норовливим дияволом.",shape=box,color=blue];
		j1346554191 -> j1777406421;
	j1777406421 [label="Боюся, що решта історії має чекати. Пан Лойд потребує ПОМ-2, а я прагну його йому звільнити. Сподіваюся, що це допомогло отримати відповіді на кілька запитань.",shape=box,color=blue];
		j1777406421 -> j1557338392;
		j1777406421 -> j888603608;
	j1557338392 [label="І створило вдвічі більше нових.",shape=box,color=red];
		j1557338392 -> j3195385372;
	j888603608 [label="Так, дякую.",shape=box,color=red];
		j888603608 -> j1076490702;
	j3195385372 [label="+15 Chemistry",color=orange];
		j3195385372 -> j1856945374;
	j1076490702 [label="+10 Chemistry",color=orange];
		j1076490702 -> j2964639028;
	j1856945374 [label="Значить я виконав свій обов’язок священника. Бажаю доброї ночі.",shape=box,color=blue];
		j1856945374 -> j3545001372;
	j2964639028 [label="Тоді я побажаю тобі доброї ночі.",shape=box,color=blue];
		j2964639028 -> j3545001372;
	j3545001372 [label="Отець Ліон Аллард",shape=box,color=blue];
		j3545001372 -> "Chat ends.";
}