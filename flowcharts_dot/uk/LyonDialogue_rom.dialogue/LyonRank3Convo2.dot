digraph {
	32 [label="LyonRank3Convo2 begins.",color=orange];
		32 -> 33;
	33 [label="If I may, I wish to tell you a story of a stray alley cat who used to come by the back of the church.",shape=box,color=blue];
		33 -> 36;
		33 -> 35;
		33 -> 34;
	36 [label="Go on.",shape=box,color=red];
		36 -> 39;
	35 [label="Why?",shape=box,color=red];
		35 -> 38;
	34 [label="[Ignore.]",shape=box,color=red];
		34 -> 37;
	39 [label="Thank you.",shape=box,color=blue];
		39 -> 41;
	38 [label="I fear it would take more effort to explain than it would be worth.",shape=box,color=blue];
		38 -> 40;
	37 [label="Chat ends.",color=orange];
	41 [label="Though I suspect that this tale is not unique to this scruffy old tom, and my interactions with him seemingly noteworthy, it bears telling all the same.",shape=box,color=blue];
		41 -> 43;
	40 [label="Never mind.",shape=box,color=blue];
		40 -> 42;
	43 [label="Every day he would come by to beg scraps and whatever meagre affections he could have from me or the other brothers and sisters who doted upon him.",shape=box,color=blue];
		43 -> 44;
	42 [label="Chat ends.",color=orange];
	44 [label="He was a ragged thing, with a limp in his leg and missing part of an ear. ",shape=box,color=blue];
		44 -> 45;
	45 [label="When he did not come by for a few days, Marie was quite beside herself with worry. But what is one to do for an old alley tom who has met their end, save to issue up a prayer to Lua?",shape=box,color=blue];
		45 -> 46;
	46 [label="Update boolean LyonStray",color=orange];
		46 -> 47;
		46 -> 48;
		46 -> 49;
	47 [label="[Let him continue.]",shape=box,color=red];
		47 -> 50;
	48 [label="Is that allowed in your religion? Praying for animals, I mean.",shape=box,color=red];
		48 -> 51;
	49 [label="You would pray for the soul of a departed alley cat?",shape=box,color=red];
		49 -> 52;
	50 [label="Regardless, imagine my surprise when I was fetching bread from the market and I saw the old tom sitting next to the owner of the stand.",shape=box,color=blue];
		50 -> 53;
	51 [label="+10 Chemistry",color=orange];
		51 -> 54;
	52 [label="Of course. Some of the purest, brightest souls I have encountered were encased in the flesh of a beast. It is not for me to judge how the Luminaries have set them upon their paths.",shape=box,color=blue];
		52 -> 55;
	53 [label="He greeted me with a raspy meow, as he always did, and hopped down to rub against my leg.",shape=box,color=blue];
		53 -> 56;
	54 [label="A good question. In some sects, no. It would be seen as heresy. But in ours, yes. We recognize that animals have souls.",shape=box,color=blue];
		54 -> 55;
	55 [label="Saint Elizabeth the Wise was known for her charity toward animals, though many traditions to do not recognize the Saints as apostles of the Luminaries.",shape=box,color=blue];
		55 -> 57;
	56 [label="And I would note, Drifter, that he did so without a limp.",shape=box,color=blue];
		56 -> 58;
	57 [label="I find myself wondering if any influence of our order survived this long... but it was hardly the point of the conversation.",shape=box,color=blue];
		57 -> 59;
	58 [label="\"Ah, one of Old Devereaux's fools, I see.\" The man laughed as he bagged up my bread.",shape=box,color=blue];
		58 -> 60;
	59 [label="Update boolean LyonLecture1",color=orange];
		59 -> 50;
	60 [label="It turns out the old cat was playing us, and several others, in the neighborhood. He was not starving, of failing health, or neglected in any way.",shape=box,color=blue];
		60 -> 61;
	61 [label="Indeed, if the man's words were to be believed, he was quite a murderous fiend in regards to the local population of birds.",shape=box,color=blue];
		61 -> 62;
		61 -> 63;
		61 -> 64;
	62 [label="Did you stop feeding Old Devereaux when he came around?",shape=box,color=red];
		62 -> 65;
	63 [label="Are you trying to warn me about Roathe?",shape=box,color=red];
		63 -> 66;
	64 [label="Are you the alley cat in this story?",shape=box,color=red];
		64 -> 67;
	65 [label="+10 Chemistry",color=orange];
		65 -> 68;
	66 [label="There are a great many things to warn you about the devil \"Cardinal Dimanche\" put upon our doorstep. Perhaps this is one of them. Perhaps it is not.",shape=box,color=blue];
		66 -> 69;
	67 [label="The Luminaries know I have certainly been worn at the edges as of late. But is this meant to stand as a warning about myself? Perhaps. Perhaps it is not.",shape=box,color=blue];
		67 -> 69;
	68 [label="No, we did not. In fact, Marie greeted him with all the more affection for it, teasing him for being \"her little imp.\"",shape=box,color=blue];
		68 -> 70;
	69 [label="It is simply a story to say that sometimes, when a creature seems to be in need -",shape=box,color=blue];
		69 -> 71;
	70 [label="But we no longer fretted over him. We knew that Old Devereaux could quite adequately care for himself. He did not need us.",shape=box,color=blue];
		70 -> 72;
		70 -> 73;
	71 [label="+15 Chemistry",color=orange];
		71 -> 74;
	72 [label="What happened to Old Devereaux, do you know?",shape=box,color=red];
		72 -> 75;
	73 [label="What do you think drove Old Devereaux to visit you, if it wasn't need?",shape=box,color=red];
		73 -> 76;
	74 [label="- check to see how sharp its claws may be.",shape=box,color=blue];
		74 -> 77;
	75 [label="His next disappearance, two years later, turned permanent.",shape=box,color=blue];
		75 -> 78;
		75 -> 79;
	76 [label="The cynical answer I would supply you with would be \"greed.\" For if one could have one feast, why not two? Why not ten?",shape=box,color=blue];
		76 -> 80;
		76 -> 81;
	77 [label="Chat ends.",color=orange];
	78 [label="Did you pray for him?",shape=box,color=red];
		78 -> 82;
	79 [label="I hope he left this world comfortable and loved.",shape=box,color=red];
		79 -> 83;
	80 [label="What would be the non-cynical answer?",shape=box,color=red];
		80 -> 84;
	81 [label="Does that remain the same if he was only seeking affection?",shape=box,color=red];
		81 -> 85;
	82 [label="I lit a candle for him the night I learned of his death and prayed to Lua to guide his soul to... wherever she would guide a little imp like him.",shape=box,color=blue];
		82 -> 86;
	83 [label="May I ask why?",shape=box,color=blue];
		83 -> 87;
		83 -> 88;
	84 [label="+10 Chemistry",color=orange];
		84 -> 89;
	85 [label="An avaricious desire for affection is still gluttony, though it is not a hunger fed by meat and wine. And to seek it in such false pretenses?",shape=box,color=blue];
		85 -> 90;
		85 -> 91;
	86 [label="And thanked Old Devereaux for all the joy he brought Marie in exchange for all those coveted bits of chicken gristle and head scratches.",shape=box,color=blue];
		86 -> 92;
	87 [label="He was an animal. He was just searching for fulfillment - food, shelter, love - he wasn't inspired by the same motivations as people. He wasn't \"lying,\" he was hunting with a different set of tools.",shape=box,color=red];
		87 -> 93;
	88 [label="I have seen a lot of violence, Lyon. A lot of it I have caused. I have come to hope that everyone, no matter who they are or what they've done, can have a peaceful death surrounded by those who love them.",shape=box,color=red];
		88 -> 94;
	89 [label="I found myself oddly... respecting the cat, for the place it had found itself in the world.",shape=box,color=blue];
		89 -> 95;
	90 [label="He was a cat, Lyon. He hardly knew what he was doing.",shape=box,color=red];
		90 -> 96;
	91 [label="We are still speaking about a cat, yes?",shape=box,color=red];
		91 -> 97;
	92 [label="Thank you. I will not hinder you in your day any longer.",shape=box,color=blue];
		92 -> 98;
	93 [label="He wasn't denying others anything by making you all his \"fools.\" If anything... you all seem to have been enriched by his visits.",shape=box,color=red];
		93 -> 99;
	94 [label="Fascinating. I would expect you to despise your enemies. But that is my own folly - to assume I know how anyone in this day and age would comport themselves.",shape=box,color=blue];
		94 -> 100;
	95 [label="Here was a creature who had learned to use its condition - its appearance, its age, its scars - as a weapon against \"the fools\" around him who did not see through his ruse.",shape=box,color=blue];
		95 -> 101;
	96 [label="He knew well enough to feign a limp. ",shape=box,color=blue];
		96 -> 84;
	97 [label="Infer from this conversation whatever you wish, Drifter.",shape=box,color=blue];
		97 -> 84;
	98 [label="Отець Ліон Аллард",shape=box,color=blue];
		98 -> 102;
	99 [label="Add -1 to Thermostat",color=orange];
		99 -> 103;
	100 [label="Add 1 to Thermostat",color=orange];
		100 -> 104;
	101 [label="An imp in matted fur, he truly was. Yet I found myself petting him all the same when he came 'round to visit.",shape=box,color=blue];
		101 -> 105;
	102 [label="Chat ends.",color=orange];
	103 [label="Yes. I suppose we were. And we were not experiencing a shortage of bits of chicken gristle and scratches.",shape=box,color=blue];
		103 -> 106;
	104 [label="Let alone someone with your particularly fascinating upbringing. ",shape=box,color=blue];
		104 -> 107;
	105 [label="And equally heartbroken when, two years later, his next disappearance was permanent.",shape=box,color=blue];
		105 -> 78;
		105 -> 79;
	106 [label="Perhaps that is why I lit a candle for him and prayed to Lua to take his soul and guide it to... wherever she would take a little imp like him.",shape=box,color=blue];
		106 -> 108;
	107 [label="+5 Chemistry",color=orange];
		107 -> 109;
	108 [label="+5 Chemistry",color=orange];
		108 -> 110;
	109 [label="Thank you. I will not hinder you in your day any longer. This has been a most interesting conversation. Until we speak again.",shape=box,color=blue];
		109 -> 111;
	110 [label="And why I thanked Old Devereaux in my prayers that night for all the joy he had brought Marie.",shape=box,color=blue];
		110 -> 112;
	111 [label="Отець Ліон Аллард",shape=box,color=blue];
		111 -> 113;
	112 [label="Perhaps his little villainy was of some good in a roundabout manner.",shape=box,color=blue];
		112 -> 109;
	113 [label="Chat ends.",color=orange];
}