digraph {
	graph [fontname="Roboto Condensed"];
	node [fontname="Roboto Condensed"];
	edge [fontname="Roboto Condensed"];

	"LyonRank3Convo2 begins." [color=orange];
		"LyonRank3Convo2 begins." -> j1906546908;
	j1906546908 [label="Якщо дозволиш, я хотів би розповісти тобі історію про бездомного кота, який часто приходив на задній двір церкви.",shape=box,color=blue];
		j1906546908 -> j979961291;
		j1906546908 -> j1905832530;
		j1906546908 -> j427271942;
	j979961291 [label="Давай.",shape=box,color=red];
		j979961291 -> j4236622759;
	j1905832530 [label="Чому?",shape=box,color=red];
		j1905832530 -> j2123543567;
	j427271942 [label="[Не зважати]",shape=box,color=red];
		j427271942 -> "Chat ends.";
	j4236622759 [label="Дякую.",shape=box,color=blue];
		j4236622759 -> j196324248;
	j2123543567 [label="Боюся, що пояснення цього вимагатиме більше зусиль, ніж це того варте.",shape=box,color=blue];
		j2123543567 -> j602851509;
	"Chat ends." [color=orange];
	j196324248 [label="Хоча я підозрюю, що ця історія не є винятковою для цього замурзаного старого приблуди, і моя взаємодія з ним не варта уваги, про це все одно слід розповісти.",shape=box,color=blue];
		j196324248 -> j490021475;
	j602851509 [label="Не зважай.",shape=box,color=blue];
		j602851509 -> "Chat ends.";
	j490021475 [label="Кожного дня він приходив, щоб випросити залишки їжі та будь-яку мізерну любов, яку міг отримати від мене або інших братів і сестер, які його обожнювали.",shape=box,color=blue];
		j490021475 -> j375408471;
	j375408471 [label="Він був обшарпаний, кульгав на ногу і мав відсутню частину вуха. ",shape=box,color=blue];
		j375408471 -> j3098534259;
	j3098534259 [label="Коли він не приходив кілька днів, Марі була вкрай стурбована. Але що можна зробити для старого бездомного кота, який зустрів свою смерть, окрім як помолитися Луа?",shape=box,color=blue];
		j3098534259 -> j3437213928;
	j3437213928 [label="Boolean LyonStray is now true.",color=orange];
		j3437213928 -> j2494535039;
		j3437213928 -> j2165667894;
		j3437213928 -> j173806261;
	j2494535039 [label="[Дати йому дописати]",shape=box,color=red];
		j2494535039 -> j4166366475;
	j2165667894 [label="Це дозволено у вашій релігії? Молитися за тварин, маю на увазі.",shape=box,color=red];
		j2165667894 -> j3532862631;
	j173806261 [label="Ти б молився за душу померлого бездомного кота?",shape=box,color=red];
		j173806261 -> j757444693;
	j4166366475 [label="Хай там як, але уяви моє здивування, коли я купував хліб на ринку і побачив старого кота, що сидів поруч із власником лавки.",shape=box,color=blue];
		j4166366475 -> j1201869540;
	j3532862631 [label="+10 Chemistry",color=orange];
		j3532862631 -> j3258921942;
	j757444693 [label="Звичайно. Деякі з найчистіших і найяскравіших душ, які я зустрічав, були втілені в плоть звіра. Не мені судити, як Світочі визначили їхній шлях.",shape=box,color=blue];
		j757444693 -> j4276816858;
	j1201869540 [label="Він привітався хрипким нявчанням, як завжди, і зіскочив, щоб потертися об мою ногу.",shape=box,color=blue];
		j1201869540 -> j3090040876;
	j3258921942 [label="Хороше питання. У деяких культах — ні. Це вважається богохульством. Але в нашому випадку, так. Ми визнаємо, що тварини мають душі.",shape=box,color=blue];
		j3258921942 -> j4276816858;
	j4276816858 [label="Свята Єлизавета Мудра була відома своєю милосердністю до тварин, хоча багато традицій не визнають святих апостолами Світочей.",shape=box,color=blue];
		j4276816858 -> j2137672364;
	j3090040876 [label="І я б зазначив, мандрівниче, що він це зробив не кульгаючи.",shape=box,color=blue];
		j3090040876 -> j2894196590;
	j2137672364 [label="Я замислююся, чи вплив нашого ордену зберігся так надовго… але це не було головною темою нашої розмови.",shape=box,color=blue];
		j2137672364 -> j2871997582;
	j2894196590 [label="«Ох, один з обдурених Деверо, як я бачу». Чоловік засміявся, пакуючи мій хліб у пакет.",shape=box,color=blue];
		j2894196590 -> j1538312886;
	j2871997582 [label="Boolean LyonLecture1 is now true.",color=orange];
		j2871997582 -> j4166366475;
	j1538312886 [label="Виявляється, старий кіт грався з нами та ще кількома іншими сусідами. Він не голодував, не мав проблем зі здоров’ям і не був занедбаний.",shape=box,color=blue];
		j1538312886 -> j2924615324;
	j2924615324 [label="Насправді, якщо вірити словам цього чоловіка, він був справжнім вбивцею місцевої популяції птахів.",shape=box,color=blue];
		j2924615324 -> j2280116261;
		j2924615324 -> j3634171299;
		j2924615324 -> j825460490;
	j2280116261 [label="Ви перестали годувати Деверо, коли він повернувся?",shape=box,color=red];
		j2280116261 -> j93428303;
	j3634171299 [label="Ти намагаєшся попередити мене про Роута?",shape=box,color=red];
		j3634171299 -> j3082320435;
	j825460490 [label="Ти — вуличний кіт у цій історії?",shape=box,color=red];
		j825460490 -> j3355350080;
	j93428303 [label="+10 Chemistry",color=orange];
		j93428303 -> j1886526807;
	j3082320435 [label="Є багато речей, про які тебе слід попередити щодо диявола «кардинала Діманша», який з`явився на твоєму порозі. Можливо, це одне з них. Можливо, ні.",shape=box,color=blue];
		j3082320435 -> j662368417;
	j3355350080 [label="Світочі знають, що останнім часом я, безперечно, був виснажений. Але чи це має бути попередженням щодо мене самого? Можливо. Можливо, ні.",shape=box,color=blue];
		j3355350080 -> j662368417;
	j1886526807 [label="Ні, ми цього не зробили. Насправді Марі зустріла його з іще більшою любов’ю, дражнивши, що він «її маленьке чортеня».",shape=box,color=blue];
		j1886526807 -> j3686822444;
	j662368417 [label="Це просто історія про те, коли здається, що істота потребує допомоги…",shape=box,color=blue];
		j662368417 -> j3868925617;
	j3686822444 [label="Але ми більше не хвилювалися за нього. Ми знали, що Деверо цілком міг про себе подбати. Він не потребував нас.",shape=box,color=blue];
		j3686822444 -> j363768476;
		j3686822444 -> j1011478536;
	j3868925617 [label="+15 Chemistry",color=orange];
		j3868925617 -> j573674915;
	j363768476 [label="Що, зрештою, сталося з Деверо?",shape=box,color=red];
		j363768476 -> j991263905;
	j1011478536 [label="Як ти гадаєш, що спонукало Деверо навідувати вас, якщо в цьому не було потреби?",shape=box,color=red];
		j1011478536 -> j1269687083;
	j573674915 [label="перевір, наскільки гострі її пазурі.",shape=box,color=blue];
		j573674915 -> "Chat ends.";
	j991263905 [label="Його наступне зникнення, яке сталося через два роки, стало остаточним.",shape=box,color=blue];
		j991263905 -> j3082402644;
		j991263905 -> j3024635331;
	j1269687083 [label="Цинічна відповідь, яку б я мав сказати, була б «жадібність». Адже якщо можна влаштувати одне свято, то чому б не влаштувати два? А чому б не влаштувати десять?",shape=box,color=blue];
		j1269687083 -> j2744382343;
		j1269687083 -> j146281332;
	j3082402644 [label="Ви молилися за нього?",shape=box,color=red];
		j3082402644 -> j1493246181;
	j3024635331 [label="Я сподіваюся, що він покинув цей світ у спокої та любові.",shape=box,color=red];
		j3024635331 -> j2081823387;
	j2744382343 [label="А яка б була не цинічна відповідь?",shape=box,color=red];
		j2744382343 -> j2381446686;
	j146281332 [label="Чи залишилася б вона незмінною, якби він просто шукав любові?",shape=box,color=red];
		j146281332 -> j4192382792;
	j1493246181 [label="У ніч, коли я дізналася про його смерть, я запалила для нього свічку і помолилася Луа, щоб вона провела його душу туди… куди вона забирає таких малих бешкетників, як він.",shape=box,color=blue];
		j1493246181 -> j3896622506;
	j2081823387 [label="Можна запитати, чому?",shape=box,color=blue];
		j2081823387 -> j2606036936;
		j2081823387 -> j2935971920;
	j2381446686 [label="+10 Chemistry",color=orange];
		j2381446686 -> j3554645049;
	j4192382792 [label="Жадібне прагнення любові все одно є ненажерливістю, хоча це і не голод, який вгамовується м’ясом і вином. І шукати його під такими фальшивими приводами?",shape=box,color=blue];
		j4192382792 -> j3190801217;
		j4192382792 -> j235705441;
	j3896622506 [label="І подякував Деверо за всю радість, яку він приніс Марі в обмін на всі ті бажані шматочки курячих хрящів та чухання за вушком.",shape=box,color=blue];
		j3896622506 -> j3040506563;
	j2606036936 [label="Він був твариною. Він просто шукав задоволення своїх потреб — їжі, житла, любові — його не надихали ті ж мотиви, що й людей. Він не «брехав», він просто використовував інші інструменти.",shape=box,color=red];
		j2606036936 -> j4113336058;
	j2935971920 [label="У житті було багато насильства, Ліоне. І багато з моєї провини. Я хочу мати надію, що кожен, незалежно від того, хто він і що зробив, може спокійно померти в оточенні тих, хто його любить.",shape=box,color=red];
		j2935971920 -> j3495817678;
	j3554645049 [label="Мені було якось дивно… відчувати повагу до кота за те, що він знайшов себе у цьому світі.",shape=box,color=blue];
		j3554645049 -> j2659139878;
	j3190801217 [label="Він був котом, Ліоне. Він ледве розумів, що він робить.",shape=box,color=red];
		j3190801217 -> j1913906450;
	j235705441 [label="Ми все ще говоримо про кота, чи не так?",shape=box,color=red];
		j235705441 -> j4051978582;
	j3040506563 [label="Дякую. Я більше не заважатиму тобі у твоїх справах.",shape=box,color=blue];
		j3040506563 -> j3545001372;
	j4113336058 [label="Він не відмовляв іншим у чомусь, роблячи з вас усіх «дурнів». Якщо вже на те пішло… ви всі, здається, мали користь з його візитів.",shape=box,color=red];
		j4113336058 -> j2152305276;
	j3495817678 [label="Дивовижно. Я б очікував твоєї зневаги до ворогів. Але це моя власна нерозсудливість — припускати, що я знаю, як поводитимуться люди в наш час.",shape=box,color=blue];
		j3495817678 -> j4055405455;
	j2659139878 [label="Це була істота, яка навчилася використовувати свій стан — свою зовнішність, вік, шрами — як зброю проти «дурнів» навколо, які не розгадували про хитрощі.",shape=box,color=blue];
		j2659139878 -> j2024453831;
	j1913906450 [label="Він досить знав, щоб прикидатися кульгавим. ",shape=box,color=blue];
		j1913906450 -> j2381446686;
	j4051978582 [label="Роби висновки, які забажаєш, мандрівниче.",shape=box,color=blue];
		j4051978582 -> j2381446686;
	j3545001372 [label="Отець Ліон Аллард",shape=box,color=blue];
		j3545001372 -> "Chat ends.";
	j2152305276 [label="Add -1 to Thermostat counter",color=orange];
		j2152305276 -> j515439308;
	j4055405455 [label="Add 1 to Thermostat counter",color=orange];
		j4055405455 -> j3285357327;
	j2024453831 [label="Він дійсно був чортеням із кошлатим хутром. Проте я все одно гладила його, коли він приходив у гості.",shape=box,color=blue];
		j2024453831 -> j3844258216;
	j515439308 [label="Так. Мабуть, так і було. І нам не шкода було шматочків курячих хрящів та чухання за вушком.",shape=box,color=blue];
		j515439308 -> j2101084357;
	j3285357327 [label="Не кажучи вже про когось із таким напрочуд цікавим вихованням, як у тебе. ",shape=box,color=blue];
		j3285357327 -> j210415849;
	j3844258216 [label="І так само засмутився, коли через два роки його зникнення стало остаточним.",shape=box,color=blue];
		j3844258216 -> j3082402644;
		j3844258216 -> j3024635331;
	j2101084357 [label="Можливо, саме тому я запалив за нього свічку та помолився Луа, щоб вона забрала його душу й провела її туди… куди вона забирає таких малих бешкетників, як він.",shape=box,color=blue];
		j2101084357 -> j3745874857;
	j210415849 [label="+5 Chemistry",color=orange];
		j210415849 -> j2029944479;
	j3745874857 [label="+5 Chemistry",color=orange];
		j3745874857 -> j1995915635;
	j2029944479 [label="Дякую. Я більше не заважатиму тобі у твоїх справах. Це була дуже цікава розмова. До наступної зустрічі.",shape=box,color=blue];
		j2029944479 -> j3545001372;
	j1995915635 [label="І тому я подякував Деверо у своїх молитвах тієї ночі за всю радість, яку він приніс Марі.",shape=box,color=blue];
		j1995915635 -> j2198528678;
	j2198528678 [label="Можливо, його маленька підлість була в деякому сенсі корисною.",shape=box,color=blue];
		j2198528678 -> j2029944479;
}