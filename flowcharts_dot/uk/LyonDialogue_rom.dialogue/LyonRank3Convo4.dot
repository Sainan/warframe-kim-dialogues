		j603709325 -> j3269902989;
	j3093329362 [label="Я знаю, що диявол доносив тобі свої теорії. Пізніми вечірніми годинами я розмірковую, чи нема в них якоїсь істини.",shape=box,color=blue];
		j3093329362 -> j4081774018;
	j199447160 [label="+20 Chemistry",color=orange];
		j199447160 -> j3081884542;
	j1551972488 [label="Для чого божеству без розуміння людської сутності намагатися висміяти нашу дурість? Чому йому хочеться катувати нас? Насміхатися з наших невдач, але й наслідувати наші форми?",shape=box,color=blue];
		j1551972488 -> j626357636;
	j2494735833 [label="Знову маю перепросити, бо це те, що мені хотілося б обговорювати. Думаю, не важко здогадатися, чому так, зважаючи на твої значні знання про ситуацію.",shape=box,color=blue];
		j2494735833 -> j1147694174;
		j2494735833 -> j3869697299;
	j171117137 [label="Boolean LyonFaith1 is now true.",color=orange];
		j171117137 -> j2494735833;
	j3269902989 [label="Гм. І справді. Цікаво, як це воно: бути невідомим божеством, перетвореним на мураху, як ми?",shape=box,color=blue];
		j3269902989 -> j3081884542;
	j626357636 [label="Хіба є щось моторошніше, аніж витріщатися в роззявлену пащеку великого Ніщо й побачити, як Ніщо починає витріщатися на тебе? Усвідомити, наскільки нескінченно дрібними ми можемо насправді бути? ",shape=box,color=blue];
		j626357636 -> j3360244777;
	j1147694174 [label="Думаю, це щось пов’язане з Ентраті. І, скоріше за все, із Байдужістю.",shape=box,color=red];
		j1147694174 -> j2313025722;
	j3869697299 [label="Так, але ж ми дісталися сюди лише завдяки припущенням про мотивацію інших, хіба ні?",shape=box,color=red];
		j3869697299 -> j3041409243;
	j3360244777 [label="Усе віддав би за тишу Порожнечі. За віщуваний застій. Усе й ще більше, аби не чути хори божевільних голосів, що натомість лунають…",shape=box,color=blue];
		j3360244777 -> j3107116447;
	j2313025722 [label="Значить, моя думка правильна, і нам не треба це обговорювати.",shape=box,color=blue];
		j2313025722 -> "Chat ends.";
	j3041409243 [label="+10 Chemistry",color=orange];
		j3041409243 -> j356721308;
	j3107116447 [label="Мандрівниче, ці голоси сіють у мені великі сумніви. І причина, чому пальці тремять під час набору цих слів…",shape=box,color=blue];
		j3107116447 -> j3425984616;
	j356721308 [label="Я… так. Знову ти пишеш правдиві слова. Дякую. Я дещо підправлю своє твердження… «Я просто не хочу обговорювати це зараз».",shape=box,color=blue];
