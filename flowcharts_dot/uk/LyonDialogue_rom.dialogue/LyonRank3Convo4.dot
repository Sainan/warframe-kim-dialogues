		j311088620 -> j123027241;
	j822253000 [label="+10 Chemistry",color=orange];
		j822253000 -> j3317038404;
	j2797307539 [label="Попри все написане, я не знаю, для чого імітувати частини людського тіла. Може, для того, щоб дізнатися, що нами «керує».",shape=box,color=red];
		j2797307539 -> j133561233;
	j3571769472 [label="Я тепер довго не зможу викинути цей образ із голови. Сам вирішуй, що саме — батоги чи Шепіт.",shape=box,color=red];
		j3571769472 -> j1263242697;
