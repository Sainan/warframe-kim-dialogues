	j719612194 [label="Що таке Порожнеча як не ніщо?",shape=box,color=blue];
		j719612194 -> j1726385822;
	j915989383 [label="Шукаємо в собі відблиски вічності… того генія, якому жадаємо жити поза короткого спалаху жаринок наших смертних життів. У тих тінях жахіття, якії можуть створити подібну пустоту, яка живиться темрявою наших власних свідомостей і спорожняє наші ж душі?",shape=box,color=blue];
		j915989383 -> j3274218929;
	j3931227274 [label="Гм. Я неправильно зрозумів. Дякую за чесність, навіть невпевнену. Однак це знову лишає мене сам на сам зі своїми міркуваннями.",shape=box,color=blue];
		j3931227274 -> j4117662465;
