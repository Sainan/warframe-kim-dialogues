	"LyonRank3Convo4 begins." [color=orange];
		"LyonRank3Convo4 begins." -> j2236901574;
	j2236901574 [label="Ти пробач за прямоту питання, але я не знаю як ліпше його сформулювати. Що таке Шепіт?",shape=box,color=blue];
		j2236901574 -> j2163808293;
		j2236901574 -> j2683427724;
		j2236901574 -> j3821950595;
	j2163808293 [label="Усі мої слова будуть лише здогадками про «свідомість Байдужості».",shape=box,color=red];
		j2163808293 -> j1307355008;
	j2683427724 [label="Я думаю, що це спроби Порожнечі… зрозуміти людські форми.",shape=box,color=red];
		j2683427724 -> j4116853104;
	j3821950595 [label="Ти про «шепіт» чи «Шепіт»? І це буквально чи метафорично?",shape=box,color=red];
		j3821950595 -> j661806838;
	j1307355008 [label="Evaluate expressions",color=orange];
		j1307355008 -> j2506341580 [label="DrifterFaithNoMITW",color=purple];
		j1307355008 -> j2878928064 [label="LyonFake1",color=purple];
		j1307355008 -> j3885632531 [label="LyonFaith1",color=purple];
		j1307355008 -> j3742509943 [label="LyonReal1",color=purple];
		j1307355008 -> j1442990306 [label="false",color=purple];
	j4116853104 [label="Чи це так? Звідки така впевненість?",shape=box,color=blue];
		j4116853104 -> j833855091;
		j4116853104 -> j539071871;
		j4116853104 -> j1909297643;
	j661806838 [label="О. Так. Хороше уточнення. Припускаю, це я метафорично. Бо вони лише пил та прах — буквально.",shape=box,color=blue];
		j661806838 -> j3619924472;
	j2506341580 [label="+10 Chemistry",color=orange];
		j2506341580 -> j1055120850;
	j2878928064 [label="+10 Chemistry",color=orange];
		j2878928064 -> j3980523744;
	j3885632531 [label="+10 Chemistry",color=orange];
		j3885632531 -> j1477696322;
	j3742509943 [label="+10 Chemistry",color=orange];
		j3742509943 -> j1442990306;
	j1442990306 [label="Цікаво. Припускаю, ти вважаєш свою Байдужість божеством, якими є Сол та Луа. Чи я неправильно розумію?",shape=box,color=blue];
		j1442990306 -> j376346502;
		j1442990306 -> j1335633138;
	j833855091 [label="Ні. Але думаю, що мені так спокійніше, коли вважаю, що можу зрештою вгадати, чим саме зайнята Байдужість.",shape=box,color=red];
		j833855091 -> j3933969091;
	j539071871 [label="Ні, знаєш, припускаю, це не так. Але в мене вдосталь було контактів, щоби вважати себе в праві намагатися підібрати відповідь.",shape=box,color=red];
		j539071871 -> j990787728;
	j1909297643 [label="А що ж іще це може бути? Хіба Байдужість не бере кожну частину людського тіла й намагається зрозуміти її призначення, частка за часткою?",shape=box,color=red];
		j1909297643 -> j2604713300;
	j3619924472 [label="Бо саме на це вони перетворюються після знищення. Ми це доводили дуже багато разів.",shape=box,color=blue];
		j3619924472 -> j660603155;
		j3619924472 -> j2352735351;
		j3619924472 -> j276705703;
	j1055120850 [label="М-м. Так. Марі розповідала мені. Ти не віриш у дію незримих сил в нашому світі. Включно з тією Байдужістю. Це так?",shape=box,color=blue];
		j1055120850 -> j2845963902;
		j1055120850 -> j3081147871;
	j3980523744 [label="Цікаво. Це вдруге в мене враження, що в тобі немає віри в реальність твоєї Байдужості. Так це є?",shape=box,color=blue];
		j3980523744 -> j2954825023;
		j3980523744 -> j3317897531;
	j1477696322 [label="Цікаво. Чи розумію я правильно: твоя власна віра похитнулася останнім часом? Чи її ніколи й не було з тією Байдужістю?",shape=box,color=blue];
		j1477696322 -> j2954825023;
		j1477696322 -> j3317897531;
	j376346502 [label="Не думаю, що Байдужість була реальною, допоки ми її такою не зробили. Гадаю, ми прикликали її так само, як для мене виникло Дувірі.",shape=box,color=red];
		j376346502 -> j422137933;
	j1335633138 [label="Я дійсно вважаю Байдужість справжнім божеством, яке має справжню свідомість.",shape=box,color=red];
		j1335633138 -> j2412978452;
	j3933969091 [label="Іноді мені цікаво, чи не в цьому причина, що зрештою так багато звертаються до віри…",shape=box,color=blue];
		j3933969091 -> j1395905235;
	j990787728 [label="Перепрошую, але я дещо нервуюся, коли будь-хто почувається «в праві» на будь-які дії. Зокрема, коли йдеться про прогнозування дій інших.",shape=box,color=blue];
		j990787728 -> j2225815583;
		j990787728 -> j3476672195;
	j2604713300 [label="Нам варто непокоїтися про те, що може статися, коли воно почне перебирати не зовнішні органи?",shape=box,color=blue];
		j2604713300 -> j2681437585;
	j660603155 [label="Думаю, Байдужість намагається навчитися бути «людиною». Вона була завжди чимось Більшим. Інакшим. Тож тепер намагається зрозуміти, як це бути чимось Меншим. Нами.",shape=box,color=red];
		j660603155 -> j2741587556;
	j2352735351 [label="Іноді мені спадає на думку, що в Байдужості раніше не було ніколи тіла. До зустрічі з нами. Тож вона вчиться існувати.",shape=box,color=red];
		j2352735351 -> j3659511441;
	j276705703 [label="Гадаю, Байдужість бере кожну частину людського тіла й намагається зрозуміти її призначення, частка за часткою.",shape=box,color=red];
		j276705703 -> j2604713300;
	j2845963902 [label="Не думаю, що Байдужість була реальною, допоки ми її такою не зробили. Гадаю, ми прикликали її так само, як для мене виникло Дувірі.",shape=box,color=red];
		j2845963902 -> j2144195258;
	j3081147871 [label="Прикро, що вона тобі таке сказала. Я дійсно вважаю Байдужість справжнім божеством, яке має справжню свідомість.",shape=box,color=red];
		j3081147871 -> j4217905354;
	j2954825023 [label="Іноді мені спадає на думку, що в Байдужості раніше не було ніколи тіла. До зустрічі з нами. Тож вона вчиться існувати.",shape=box,color=red];
		j2954825023 -> j422137933;
	j3317897531 [label="Ні, не було думки натякати на таке. Вибач. Я дійсно вважаю Байдужість справжнім божеством, яке має справжню свідомість.",shape=box,color=red];
		j3317897531 -> j2378846368;
	j422137933 [label="Boolean LyonFake1 is now true.",color=orange];
		j422137933 -> j1298029015;
	j2412978452 [label="Ой. Пробач мені. Я неправильно зрозумів. Що ж, дуже дякую за чесність, навіть невпевнену. Однак це знову лишає мене сам на сам зі своїми міркуваннями.",shape=box,color=blue];
		j2412978452 -> j4117662465;
	j1395905235 [label="Знайти спокій і примирення у вигаданих відповідях, якщо інших знайти неможливо.",shape=box,color=blue];
		j1395905235 -> j4110669641;
	j2225815583 [label="Ти мені звісно вибач, але хіба це не ти священник, який призначає «праведних» і «грішних»? Це хіба не лицемірно дещо?",shape=box,color=red];
		j2225815583 -> j311088620;
	j3476672195 [label="Перепрошую. Не малося на меті ображати тебе.",shape=box,color=red];
		j3476672195 -> j822253000;
	j2681437585 [label="Це була жалюгідна спроба пожартувати, перепрошую. Дам собі 10 ударів батогом за це.",shape=box,color=blue];
		j2681437585 -> j2797307539;
		j2681437585 -> j3571769472;
	j2741587556 [label="Boolean LyonReal1 is now true.",color=orange];
		j2741587556 -> j4235260738;
