		j3081884542 -> j3545001372;
	j1317231186 [label="Отець Ліон Аллард",shape=box,color=blue];
		j1317231186 -> j2379301672;
	j123027241 [label="Так… Боюся, так і є. Гидко думати про те, що твої враження про мене так швидко й хибно склалися.",shape=box,color=blue];
		j123027241 -> j637016252;
	j3317038404 [label="Тобі пробачено.",shape=box,color=blue];
		j3317038404 -> j1935986086;
	j133561233 [label="Гм, дивовижно. Але дуже розчаровує, якщо дивитися в цілому. Ти вважаєш, що це ніщо більше, аніж дитина зі своїми ляльками-забавлянками. Я маю повертатися до своїх обов’язків.",shape=box,color=blue];
