	edge [fontname="Roboto Condensed"];

	"LyonRank5Convo9 begins." [color=orange];
		"LyonRank5Convo9 begins." -> j3594191379;
	j3594191379 [label="Evaluate expressions",color=orange];
		j3594191379 -> "Chat ends." [label="LyonDating & LyonDatingConfession",color=purple];
		j3594191379 -> j3302764398 [label="LyonDating",color=purple];
		j3594191379 -> "Chat ends." [label="false",color=purple];
	"Chat ends." [color=orange];
	j3302764398 [label="Mon miracle, я… мушу переконатися, що ти щось розумієш, перш ніж я розповім дещо. ",shape=box,color=blue];
		j3302764398 -> j2834761030;
	j2834761030 [label="Мені дуже важливо, щоб сказане мною було правильно почуто. Розумієш?",shape=box,color=blue];
		j2834761030 -> j2306708548;
		j2834761030 -> j3250131398;
	j2306708548 [label="Я починаю нервувати. Що трапилося?",shape=box,color=red];
		j2306708548 -> j3542759646;
	j3250131398 [label="Так. Я слухаю.",shape=box,color=red];
		j3250131398 -> j2745596288;
	j3542759646 [label="Усе дуже гаразд. Саме це тобі так важливо зрозуміти — жахливі наслідки, від яких я хочу тебе звільнити, якщо припускатимеш, що вони можуть настати.",shape=box,color=blue];
		j3542759646 -> j1943278308;
		j3542759646 -> j3075946638;
		j3542759646 -> j3085889048;
	j2745596288 [label="+5 Chemistry",color=orange];
		j2745596288 -> j1011589196;
	j1943278308 [label="Готуюся читати.",shape=box,color=red];
		j1943278308 -> j543937945;
	j3075946638 [label="Щось у цих словах мало сенсу.",shape=box,color=red];
		j3075946638 -> j1563971755;
	j3085889048 [label="Жахливі наслідки… чого?",shape=box,color=red];
		j3085889048 -> j2486735858;
	j1011589196 [label="Дякую. Перш ніж я почну, то маю запевнити, що все добре. Однак можуть бути жахливі наслідки, від яких я хочу тебе звільнити, якщо припускатимеш, що вони можуть настати.",shape=box,color=blue];
		j1011589196 -> j1943278308;
		j1011589196 -> j3075946638;
		j1011589196 -> j3085889048;
	j543937945 [label="+5 Chemistry",color=orange];
		j543937945 -> j874871628;
	j1563971755 [label="Так. Я до болю це розумію.",shape=box,color=blue];
		j1563971755 -> j2486735858;
	j2486735858 [label="Дозволь почати знову.",shape=box,color=blue];
		j2486735858 -> j874871628;
	j874871628 [label="Я розумію, що багато хто може мене тлумачити, й це цілком може так і бути… як хворого. Принаймні, я точно не зовсім сповна розуму.",shape=box,color=blue];
		j874871628 -> j2955027553;
	j2955027553 [label="Я дуже давно примирився з цим. Мене вже воно не обходить. Видіння, які полонили мене… ті голоси… я знайшов методи життя без страху та ненависті до них.",shape=box,color=blue];
		j2955027553 -> j2343301899;
	j2343301899 [label="(Хоча, останнім часом трішки злості присутньо, якщо чесно, але це зараз ні до чого)",shape=box,color=blue];
		j2343301899 -> j847660389;
	j847660389 [label="Я хочу досягти твого розуміння в тому, що як розірвеш те, що між нами — той зв’язок між мною та іншою людиною, який раніше вважався неможливий…",shape=box,color=blue];
		j847660389 -> j24006111;
	j24006111 [label="Якщо надумаєш відпустити своє серце деінде від мого? ",shape=box,color=blue];
		j24006111 -> j3058446172;
	j3058446172 [label="Mon miracle, я витримаю.",shape=box,color=blue];
		j3058446172 -> j1746433115;
	j1746433115 [label="Мене не поглине те, що катувало раніше. ",shape=box,color=blue];
		j1746433115 -> j2851720794;
	j2851720794 [label="Check boolean LyonAllRight",color=orange];
		j2851720794 -> j1168246632 [label=true,color=green];
		j2851720794 -> j3898858042 [label=false,color=brown];
	j1168246632 [label="Зі мною буде, як ти пишеш «усе гаразд». Я знайду ще щось для усмішок та сміху.",shape=box,color=blue];
		j1168246632 -> j37419703;
		j1168246632 -> j2771277451;
	j3898858042 [label="Я вцілію. Зі мною все буде добре. Я знайду ще щось для усмішок та сміху.",shape=box,color=blue];
		j3898858042 -> j37419703;
		j3898858042 -> j2771277451;
	j37419703 [label="Ліоне… ти не тягар для мене.",shape=box,color=red];
		j37419703 -> j3854883635;
	j2771277451 [label="Ти… пишеш мені, що хочеш позбутися того, що між нами?",shape=box,color=red];
		j2771277451 -> j2187031167;
	j3854883635 [label="Я просто намагаюся звільнити тебе від будь-яких складнощів, у які ти можеш потрапити через мене…",shape=box,color=blue];
		j3854883635 -> j492769694;
		j3854883635 -> j3838289165;
		j3854883635 -> j255362424;
	j2187031167 [label="Ні! Нічого подібного! Я просто намагаюся звільнити тебе від будь-яких складнощів, у які ти можеш потрапити через мене.",shape=box,color=blue];
		j2187031167 -> j492769694;
		j2187031167 -> j3838289165;
		j2187031167 -> j255362424;
	j492769694 [label="Твій біль… схожий на відлуння мого. Мені буде не складно допомогти тобі його прожити.",shape=box,color=red];
		j492769694 -> j4138407904;
	j3838289165 [label="Я не можу описати те, що притягує мене до тебе. Але ти ніколи не станеш обов’язком чи тягарем.",shape=box,color=red];
		j3838289165 -> j3310492039;
	j255362424 [label="[Розірвати стосунки] Ти вибач, але для мене це вже все занадто. Ліпше буде покінчити з усім тут і зараз.",shape=box,color=red];
		j255362424 -> j531617493;
	j4138407904 [label="У відповідь я не знайду слів, щоб описати як крається моє серце через тебе. Але навіки вдячний, що наші примари самотності знайшли одна одну.",shape=box,color=blue];
		j4138407904 -> j752136808;
	j3310492039 [label="Я не зможу висловити свою вдячність і не думаю, що є такі слова взагалі.",shape=box,color=blue];
		j3310492039 -> j752136808;
	j531617493 [label="Так. Звісно. Це було б… дуже лицемірно прийняти будь-яку іншу відповідь в таку мить… ",shape=box,color=blue];
		j531617493 -> j1305272370;
	j752136808 [label="Та тепер, коли докладено стільки зусиль, щоби представити разючу самозакохану преамбулу…",shape=box,color=blue];
		j752136808 -> j1201955137;
		j752136808 -> j722051236;
		j752136808 -> j4021954408;
	j1305272370 [label="Я цілком розумію. І не бажаю нічого іншого, лише найліпшого. І я плекатиму ті миті, які ми провели разом.",shape=box,color=blue];
		j1305272370 -> j2157463186;
	j1201955137 [label="Для хлопця, який почав спілкування з мовчання ти й справді став доволі багатослівним.",shape=box,color=red];
		j1201955137 -> j1774560348;
	j722051236 [label="Я вважаю це дуже милим, не переживай.",shape=box,color=red];
		j722051236 -> j4185246947;
	j4021954408 [label="Можеш просто сказати: «Знаєш, усе буде добре, якщо наші шляхи розійдуться».",shape=box,color=red];
		j4021954408 -> j57314755;
	j2157463186 [label="Я збережу їх у своїй душі, навіть якщо вони зітруться з пам’яті. Прощавай.",shape=box,color=blue];
		j2157463186 -> j3732953971;
	j1774560348 [label="+5 Chemistry",color=orange];
		j1774560348 -> j3103094411;
	j4185246947 [label="+5 Chemistry",color=orange];
		j4185246947 -> j1160733646;
	j57314755 [label="+5 Chemistry",color=orange];
		j57314755 -> j1159849342;
	j3732953971 [label="Boolean LyonDating is now false.",color=orange];
		j3732953971 -> j1501669261;
	j3103094411 [label="Пха! Якщо ти не хочеш, щоб тебе посвячували у внутрішні справи мого розуму, то не варто в ньому нишпорити. Це твоя провина.",shape=box,color=blue];
		j3103094411 -> j3878881475;
	j1160733646 [label="Я дуже радий, що тобі подобаються мої подорожі. Саме тому я й вирішив говорити так мало. Чи можеш ти уявити, якби це було твоє особисте? Марі багато років тому приспала б мене, мов скаженого собаку.",shape=box,color=blue];
		j1160733646 -> j3878881475;
	j1159849342 [label="Тобі природно притаманна певна доза зухвалості та сарказму, до якої я ніколи не міг би піднятися. Залишу це тобі.",shape=box,color=blue];
		j1159849342 -> j3878881475;
	j1501669261 [label="Boolean IsDating is now false.",color=orange];
		j1501669261 -> j6226238;
	j3878881475 [label="Хай там як, усе це мало слугувати приводом для історії, яка зараз здаватиметься досить короткою порівняно з рештою…",shape=box,color=blue];
		j3878881475 -> j2190105105;
	j6226238 [label="Ліон",shape=box,color=blue];
		j6226238 -> "Chat ends.";
	j2190105105 [label="Я прокинувся минулої ночі від кошмару. Після пробудження мене оточили тіні. У цьому немає нічого нового чи чужого для мого розуму. Вони нависли над моїм ліжком і не зникали.",shape=box,color=blue];
		j2190105105 -> j3437044352;
	j3437044352 [label="Я їх не боявся, бо знав, що вони не можуть мені зашкодити. Однак вони також не зникали з моєї думки. Був лише один відомий мені спосіб, щоб позбутися їх.",shape=box,color=blue];
		j3437044352 -> j1855089906;
	j1855089906 [label="Я підвівся з ліжка, одягнувся якнайкраще, хитаючись крізь розмите видіння безперервного кошмару. Я схопив кадило, упав на коліна посеред підлоги та приготувався… ну. ",shape=box,color=blue];
		j1855089906 -> j1736890347;
	j1736890347 [label="Приготувався «очищувати розум». Най буде так.",shape=box,color=blue];
		j1736890347 -> j3673355736;
	j3673355736 [label="Але щойно заплющив очі, мої думки почали блукати. Вони пливли… до тебе, mon miracle…",shape=box,color=blue];
		j3673355736 -> j2536134187;
	j2536134187 [label="Звук твого голосу. Дотик твоєї руки на моєму плечі…",shape=box,color=blue];
		j2536134187 -> j1663886809;
	j1663886809 [label="І видіння… втекли. Вони покинули свій пост, прогнані сильнішим привидом… тобою.",shape=box,color=blue];
		j1663886809 -> j2742119380;
	j2742119380 [label="Я… встав. Поставив кадило на нічну тумбочку і… вирішив натомість пройтися піском Святилища…",shape=box,color=blue];
		j2742119380 -> j2073504492;
		j2742119380 -> j1855301449;
	j2073504492 [label="Тепер я розумію, чому ви відчули потребу в преамбулі.",shape=box,color=red];
		j2073504492 -> j93197627;
	j1855301449 [label="Я не знаю що сказати…",shape=box,color=red];
		j1855301449 -> j3042479824;
	j93197627 [label="Так. Ну. Під час прогулянки я… миттєво усвідомив темну небезпеку такої миті. Що ти можеш… почати вважати це відповідальністю — почати сприймати мене як ланцюги, що обтяжують тебе.",shape=box,color=blue];
		j93197627 -> j2833302712;
	j3042479824 [label="+5 Chemistry",color=orange];
		j3042479824 -> j3827429746;
	j2833302712 [label="Благаю тебе — молюся до будь-якого бога чи богів на небесах або внизу — ніколи цього не робити. Це дар мені від тебе, і щоразу, коли він буде новим, я буду берегти його.",shape=box,color=blue];
		j2833302712 -> j2034628360;
	j3827429746 [label="Слів не потрібно, mon miracle…",shape=box,color=blue];
		j3827429746 -> j2175537234;
	j2034628360 [label="Поклянись мені, mon miracle, що якщо настане час, коли я стану для тебе порожньою кліткою… у тебе буде місце для мене.",shape=box,color=blue];
		j2034628360 -> j2013656121;
	j2175537234 [label="Під час прогулянки я… миттєво усвідомив темну небезпеку такої миті. Що ти можеш… почати вважати це відповідальністю — почати сприймати мене як ланцюги, що обтяжують тебе.",shape=box,color=blue];
		j2175537234 -> j2833302712;
	j2013656121 [label="Я не буду порожньою в’язницею для тих, кого кохаю. Не для тебе. Не для Марі.",shape=box,color=blue];
		j2013656121 -> j2735387605;
		j2013656121 -> j4285640685;
	j2735387605 [label="[Розірвати стосунки] Я… я не можу. Я не можу тобі таке обіцяти, вибач.",shape=box,color=red];
		j2735387605 -> j96884611;
	j4285640685 [label="Клянуся. ",shape=box,color=red];
		j4285640685 -> j2304213307;
	j96884611 [label="+10 Chemistry",color=orange];
		j96884611 -> j1632321056;
	j2304213307 [label="+10 Chemistry",color=orange];
		j2304213307 -> j1594043758;
	j1632321056 [label="Дякую. Дякую тобі, mon miracle, за чесність. Це вимагало від тебе мужності, і я хвалю тебе за це.",shape=box,color=blue];
		j1632321056 -> j2999515587;
	j1594043758 [label="Дякую. Дякую, mon miracle…",shape=box,color=blue];
		j1594043758 -> j1017558106;
	j2999515587 [label="Я буду берегти всі моменти, які ми провели разом. Це для мене важливіше, ніж ти можеш собі уявити.",shape=box,color=blue];
		j2999515587 -> j2157463186;
	j1017558106 [label="Я раптом відчув таку сильну втому, ніби… величезний тягар спав із моїх плечей. Боюся, мені треба лягти.",shape=box,color=blue];
		j1017558106 -> j724592977;
	j724592977 [label="Ліон",shape=box,color=blue];
		j724592977 -> j3446510588;
	j3446510588 [label="Boolean LyonDatingConfession is now true.",color=orange];
		j3446510588 -> "Chat ends.";
}