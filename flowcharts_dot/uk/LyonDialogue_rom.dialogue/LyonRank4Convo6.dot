	j1651101106 [label="+20 Chemistry",color=orange];
		j1651101106 -> j110395430;
	j241031971 [label="Ліоне, ми тут з Марі балакали про твої… звички. Можемо це обговорити?",shape=box,color=red];
		j241031971 -> j4207246630;
	j3803107823 [label="[Вимкнути бесіди про самоушкодження. Жодної одиниці сумісності з будь-якими персонажами не буде втрачено.]",shape=box,color=red];
		j3803107823 -> j2002830111;
	j1478915251 [label="[Завершити розмову]",shape=box,color=red];
		j1478915251 -> "Chat ends.";
	j2024169893 [label="Ліоне, а ми можемо поговорити про дещо, що може бути трішки… незручним для тебе?",shape=box,color=red];
		j2024169893 -> j4073244924;
	j1097412454 [label="Ліоне, мені стало цікаво чи можу я з тобою поговорити про те, чому ти… ем… ну, раниш себе. Якщо ти не проти.",shape=box,color=red];
		j1097412454 -> j915077290;
	j110395430 [label="[Розмову пропущено внаслідок попередніх налаштувань щодо чутливого вмісту]",shape=box,color=blue];
		j110395430 -> "Chat ends.";
	j4207246630 [label="Звісно, вона попередила мене про тему ваших розмов. Ти здивуєшся, як мало мене непокоїть факт обговорення цієї особливості.",shape=box,color=blue];
		j4207246630 -> j3733864493;
	j2002830111 [label="Boolean LyonPainOff is now true.",color=orange];
		j2002830111 -> j3233273351;
	"Chat ends." [color=orange];
	j4073244924 [label="Можеш спитати, але я лишаю за собою право не продовжувати розмову, якщо відчую, що вона йде кудись не туди. Туди, що я не бажаю обговорювати. ",shape=box,color=blue];
		j4073244924 -> j3081404324;
	j915077290 [label="М-м-м. Насправді я дуже здивований, що знадобилося стільки часу, щоби поцікавитися цією моєю рисою. Ззавичай саме вона привертає миттєву увагу більшості.",shape=box,color=blue];
		j915077290 -> j1690754160;
	j3733864493 [label="Зазвичай це те, що найбільше бачить більшість. Чи то через переживання, чи огиду, чи просто хворобливу допитливість.",shape=box,color=blue];
		j3733864493 -> j897187574;
	j3233273351 [label="Якщо ти вважаєш цей вибір проявом боягузства, закликаю тебе — не варто. Це не твій біль, не твоя боротьба. Це моє. Цей тягар не був прошеним тобою.",shape=box,color=blue];
		j3233273351 -> j858475733;
	j3081404324 [label="Я хочу спитати про те, що іноді ти раниш себе. Хочу зберігати максимальну обачність в темах, дотичних до цього. От і все.",shape=box,color=red];
		j3081404324 -> j2367057896;
	j1690754160 [label="Переживання, огида чи хвороблива допитливість можуть змусити когось спостерігати за божевільними крізь ґрати клітки. Гм, яка в тебе причина?",shape=box,color=blue];
		j1690754160 -> j3602655137;
		j1690754160 -> j179504002;
		j1690754160 -> j3453701263;
		j1690754160 -> j2929984820;
	j897187574 [label="Evaluate expressions",color=orange];
		j897187574 -> j3602655137 [label="LyonBackstory3a",color=purple];
		j897187574 -> j1084604964 [label="LyonBackstory3a",color=purple];
		j897187574 -> j3602655137 [label="LyonBackstory3b",color=purple];
		j897187574 -> j1084604964 [label="LyonBackstory3b",color=purple];
		j897187574 -> j3602655137 [label="DrifterHarmHelp",color=purple];
		j897187574 -> j3453701263 [label="DrifterHarmHelp",color=purple];
		j897187574 -> j3602655137 [label="DrifterHarmStop",color=purple];
		j897187574 -> j2929984820 [label="DrifterHarmStop",color=purple];
		j897187574 -> j3602655137 [label="DrifterHarmLoss",color=purple];
		j897187574 -> j179504002 [label="DrifterHarmLoss",color=purple];
		j897187574 -> j3602655137 [label="false",color=purple];
	j858475733 [label="Цей механічний пристрій, за допомогою якого ми спілкуємося, створює ілюзію прихованої особистості. Наче ми якимось чином захищені від будь-якої кривди, яку можуть завдати інші, надрукувавши будь-що.",shape=box,color=blue];
		j858475733 -> j2169867863;
	j2367057896 [label="+5 Chemistry",color=orange];
		j2367057896 -> j3776769216;
	j3602655137 [label="Пробач. Якщо подумати, то я не можу так. [Завершити розмову]",shape=box,color=red];
		j3602655137 -> j3233273351;
	j179504002 [label="[Увага: обговорення самогубства] Я… дехто… мене покинули подібним способом… через такі «звички»…",shape=box,color=red];
		j179504002 -> j1482722312;
	j3453701263 [label="Я просто хочу допомогти тобі. Упевнитися, що все гаразд. От і все.",shape=box,color=red];
		j3453701263 -> j4278740242;
	j2929984820 [label="Я відчуваю, що це якась нездорова поведінка. Це те… що має припинитися. ",shape=box,color=red];
		j2929984820 -> j1885373975;
	j1084604964 [label="Я знаю, що ти казав, що звик ранити себе ще до сироватки… але щось це для мене мало поліпшує ситуацію.",shape=box,color=red];
		j1084604964 -> j1245101336;
	j2169867863 [label="Та я радше б доводив протилежне — звільнившись від обладунків, у які вбираємось у звичайних соціальних взаємодіях, ми позбуваємося того, що може захистити нас.",shape=box,color=blue];
		j2169867863 -> j1670931998;
	j3776769216 [label="Мандрівниче. Я… дуже вдячний за делікатність твого підходу до цього. Дякую. Але мені звично, що ця тема постійно обговорюється. Через занепокоєння, огиду чи хворобливу цікавість — думаю, що в тебе це перше з цих варіантів.",shape=box,color=blue];
		j3776769216 -> j3602655137;
		j3776769216 -> j179504002;
		j3776769216 -> j3453701263;
		j3776769216 -> j2929984820;
	j1482722312 [label="Boolean DrifterHarmLoss is now true.",color=orange];
		j1482722312 -> j1095659099;
	j4278740242 [label="Boolean DrifterHarmHelp is now true.",color=orange];
		j4278740242 -> j4131174356;
	j1885373975 [label="Boolean DrifterHarmStop is now true.",color=orange];
		j1885373975 -> j2345801252;
	j1245101336 [label="Так, легше не стало. Вона взяла те, що було… потребою для очищення голови від видінь, які мене катували… і перетворила на необхідність для використання «дарів» цієї сироватки.",shape=box,color=blue];
		j1245101336 -> j2554386325;
	j1670931998 [label="Тому, у подібних ситуаціях… я чудово розумію, що можу випустити стрілу, яка влучить не в загартованого в битвах і готового до всього солдата, а в яремну вену оленя, який безпечно гуляє лісом.",shape=box,color=blue];
		j1670931998 -> j4117370409;
	j1095659099 [label="О, друже… немає слів, якими я можу описати своє співчуття до пережитого тобою.",shape=box,color=blue];
		j1095659099 -> j3730749345;
	j4131174356 [label="Check boolean LyonAllRight",color=orange];
		j4131174356 -> j299997412 [label=true,color=green];
		j4131174356 -> j1356656495 [label=false,color=brown];
	j2345801252 [label="Думаю, що ти на кілька років та одну сироватку протофреймів запізно для можливості позбавити мене цієї звички. Насправді я вважаю, що нині це вже необхідність, розумієш?",shape=box,color=blue];
		j2345801252 -> j1856402480;
	j2554386325 [label="+5 Chemistry",color=orange];
		j2554386325 -> j4174767262;
	j4117370409 [label="Тож наостанок я напишу таке:",shape=box,color=blue];
		j4117370409 -> j1092557137;
	j3730749345 [label="Будь-яка мова видається неспроможною в такі миті. Ми відчайдушно намагаємося використати нею, але слова завжди нас підводять.",shape=box,color=blue];
		j3730749345 -> j723284974;
	j299997412 [label="Я знову намагаюся не пирхати зі сміху, коли до мене застосовують поняття «усе гаразд». Але дуже вдячний за турботу, мандрівниче.",shape=box,color=blue];
		j299997412 -> j833720367;
	j1356656495 [label="Я намагаюся не пирхати зі сміху, коли до мене застосовують поняття «усе гаразд». Але дуже вдячний за турботу, мандрівниче.",shape=box,color=blue];
		j1356656495 -> j833720367;
	j1856402480 [label="+5 Chemistry",color=orange];
		j1856402480 -> j1025170995;
	j4174767262 [label="Якщо й десь неподалік існувала можливість позбавити мене звички кривдити себе, то після введення сироватки… гадаю об’єднання з ворфреймом «Гарроу» зробила це абсолютно неможливим.",shape=box,color=blue];
		j4174767262 -> j1662289296;
	j1092557137 [label="Ми повинні нагадувати собі, що маємо знаходити сили допомагати іншим звестися на ноги, навіть коли в самих не має волі стояти.",shape=box,color=blue];
		j1092557137 -> j2761042312;
	j723284974 [label="Якщо дозволиш, то я маю зробити три речі, з огляду на твоє зізнання.",shape=box,color=blue];
		j723284974 -> j1251149422;
	j833720367 [label="+5 Chemistry",color=orange];
		j833720367 -> j2641668955;
		j833720367 -> j1810507869;
	j1025170995 [label="Але не подумай, що я легковажно ставлюся до того, що є виявом турботи й непокоєння стосовно моєї психіки й фізичного стану. Ти вже пробач за це. Просто я не думаю, що припинити це буде в моїх силах.",shape=box,color=blue];
		j1025170995 -> j2641668955;
		j1025170995 -> j1810507869;
	j1662289296 [label="Якщо дозволиш написати грубо, мандрівниче, то я не думаю, що й далі зможу завдати якоїсь реальної шкоди собі таким чином.",shape=box,color=blue];
		j1662289296 -> j1114367425;
	j2761042312 [label="Ось це і є істинною мораллю притчі.",shape=box,color=blue];
		j2761042312 -> j826197623;
	j1251149422 [label="Перше — я поспішно тебе хочу запевнити, що небезпеки нема. Якщо вважаєш, що прагнення ранити себе походить з якоїсь глибокої жахливої зневаги до себе, то я бажаю позбавити тебе цих страхів.",shape=box,color=blue];
		j1251149422 -> j327614013;
	j2641668955 [label="Я можу спитати, чому ти це робиш?",shape=box,color=red];
		j2641668955 -> j3106172300;
	j1810507869 [label="Я просто хвилююся, щоб ти не зайшов занадто далеко.",shape=box,color=red];
		j1810507869 -> j1662289296;
	j1114367425 [label="Для відчуття своєї невразливості мені бракує пихи, але такі вчинки… скажімо так… видаються частиною плану.",shape=box,color=blue];
		j1114367425 -> j3988785160;
	j826197623 [label="+20 Chemistry",color=orange];
		j826197623 -> j3818251835;
	j327614013 [label="Попри те, що я… знайомий з величною меланхолією, вона не надихає моє кадило (та й Марі цього б ніколи не дозволила, це точно. Вона радше нагодувала б мене ним, аніж дозволила колись ще раз підійти до такого стану).",shape=box,color=blue];
		j327614013 -> j2672919786;
	j3106172300 [label="Evaluate expressions",color=orange];
		j3106172300 -> j2207031713 [label="LyonBackstory3a, LyonLecture2",color=purple];
		j3106172300 -> j2207031713 [label="LyonBackstory3b, LyonLecture2",color=purple];
		j3106172300 -> j546029245 [label="LyonBackstory3a",color=purple];
		j3106172300 -> j546029245 [label="LyonBackstory3b",color=purple];
		j3106172300 -> j466915943 [label="false",color=purple];
	j3988785160 [label="+5 Chemistry",color=orange];
		j3988785160 -> j4258352561;
	j3818251835 [label="Бувай, мандрівниче. Невдовзі поспілкуємося знову.",shape=box,color=blue];
		j3818251835 -> j887795676;
	j2672919786 [label="Але такий глибокий біль мене більше не навідував і не шепотів уночі, друже. У цьому я можу тобі присягнутися. Це я тобі обіцяю всім, що мені дороге.",shape=box,color=blue];
		j2672919786 -> j2271966122;
	j2207031713 [label="Я розповів про те, що надихає мене на ці дії — біль прочищає голову від видінь, котрі полонили мене. Цей обряд, ця практика не є ганьбою серед братства Луа, як може бути в твоїй культурі. Можу присягтися всім дорогим для себе — я не приховую нічого.",shape=box,color=blue];
		j2207031713 -> j3369697738;
	j546029245 [label="Це складна тема. Є багато причин для шматування своєї плоті. Я вже розповідав про видіння, які мене катують, а біль — прочищає мозок. Але самі дії не є табу, як могло би тобі видаватися.",shape=box,color=blue];
		j546029245 -> j713644791;
	j466915943 [label="Це складна тема. Є багато причин для шматування своєї плоті. Почну з того, що такі дії не забороняються у нас, як може видатися відповідно до цього дня й твого часу.",shape=box,color=blue];
		j466915943 -> j713644791;
	j4258352561 [label="Я не думаю, що мої вчинки «правильні». Не думаю, що інші повинні теж робити як я. Не думаю, що моїм діям варто заздрити.",shape=box,color=blue];
		j4258352561 -> j2432164978;
	j887795676 [label="Отець Ліон Аллард",shape=box,color=blue];
		j887795676 -> j3787621160;
	j2271966122 [label="Друге — я маю похвалити твою відвагу за ці слова мені. Було б легше уникнути цього. Але не для тебе.",shape=box,color=blue];
		j2271966122 -> j917295746;
	j3369697738 [label="Якщо вважаєш, що прагнення ранити себе походить з якоїсь глибокої жахливої зневаги до себе, то я бажаю позбавити тебе цих страхів.",shape=box,color=blue];
		j3369697738 -> j117457545;
	j713644791 [label="Серед братів Луа існує прадавня практика самобичування. Вона доволі рідкісна й у мої часи вважалася архаїчною. Практикувалася серед тих, хто був «благословенними Луа».",shape=box,color=blue];
		j713644791 -> j3217550676;
	j2432164978 [label="Однак це не є небезпечним для мене. Зважаючи на мій неймовірно неповторний та «надприродний» (у буквальному сенсі слова) стан.",shape=box,color=blue];
		j2432164978 -> j769654939;
	j3787621160 [label="Boolean LyonSpeech is now true.",color=orange];
		j3787621160 -> "Chat ends.";
	j917295746 [label="Третє — я не знаю і не зрозумію ніколи контексту того, що довелося пережити тим, хто пішли від тебе. І крім цієї особи ніхто ніколи не зрозуміє.",shape=box,color=blue];
		j917295746 -> j1881420435;
	j117457545 [label="Попри те, що я… знайомий з величною меланхолією, вона не надихає моє кадило. Та й Марі цього б ніколи не дозволила, це точно.",shape=box,color=blue];
		j117457545 -> j1956864042;
	j3217550676 [label="Один зі святих отців у соборі навчив мене. Невдовзі після мого прибуття. Він побачив, що я… «благословенний», і вважав за потрібне допомогти мені. ",shape=box,color=blue];
		j3217550676 -> j2632916461;
	j769654939 [label="Я часто міркував над тим, чи не дійшла наука до якогось дива, що допомогло б мені позбутися недуг. Якби дійшов до такого стану, що згодився би прийняти будь-яку допомогу… то прийняв би. А зараз маю сумніви, що моя фізіологія дозволить це зробити.",shape=box,color=blue];
		j769654939 -> j3375551019;
	j1881420435 [label="Такі страждання поглинають повністю. Це за визначенням своїм справа самітників.",shape=box,color=blue];
		j1881420435 -> j1039666407;
	j1956864042 [label="Boolean LyonSNo is now true.",color=orange];
		j1956864042 -> j2592541978;
		j1956864042 -> j3950173174;
		j1956864042 -> j3881262424;
	j2632916461 [label="Boolean LyonLecture2 is now true.",color=orange];
		j2632916461 -> j3881262424;
		j2632916461 -> j3950173174;
		j2632916461 -> j2592541978;
	j3375551019 [label="Позаяк, я запевняю — мене це не вб’є. Це тягар, який ношу з дитинства. І цей симптом, який я вважаю ліпше мати за гнійну рану під струпами.",shape=box,color=blue];
		j3375551019 -> j1511931022;
	j1039666407 [label="Я молюся своєму божеству, і твоїм, і їхнім… щоб у серці твоєму не було провини. Знати когось, хто так страждав, заслуговує прощення в будь-якому зі світів.",shape=box,color=blue];
		j1039666407 -> j3049424313;
	j2592541978 [label="І ти впевнений, що точно ніколи… не зайдеш задалеко?",shape=box,color=red];
		j2592541978 -> j1662289296;
	j3950173174 [label="Мене приголомшує, якими дивними іноді можуть бути релігійні обряди.",shape=box,color=red];
		j3950173174 -> j2559898625;
	j3881262424 [label="Припускаю, що тепер мені трішки легше.",shape=box,color=red];
		j3881262424 -> j1662289296;
	j1511931022 [label="Check boolean LyonSNo",color=orange];
		j1511931022 -> j2678893725 [label=true,color=green];
		j1511931022 -> j2240040794 [label=false,color=brown];
	j3049424313 [label="+15 Chemistry",color=orange];
		j3049424313 -> j3022841415;
	j2559898625 [label="Не знайду причини сперечатися з цим твердженням. Я із захопленням досліджую відмінності в традиціях різних релігій. Насолоджуюся вивченням священних книг.",shape=box,color=blue];
		j2559898625 -> j572271323;
	j2678893725 [label="+10 Chemistry",color=orange];
		j2678893725 -> j965814151;
	j2240040794 [label="Якщо вважаєш, що прагнення ранити себе походить з якоїсь глибокої жахливої зневаги до себе, то я бажаю позбавити тебе цих страхів.",shape=box,color=blue];
		j2240040794 -> j1808948227;
	j3022841415 [label="Бувай, мандрівниче. Невдовзі поспілкуємося знову.",shape=box,color=blue];
		j3022841415 -> j3545001372;
	j572271323 [label="Релігійна антропологія — дуже близька й дорога мені тема. Так багато можна дізнатися про суспільство та людей, досліджуючи їхні обряди. ",shape=box,color=blue];
		j572271323 -> j897806446;
	j965814151 [label="Однак я обіцяю, якщо колись настане мить, якої я боюся, що вже не зможу довіряти собі, то скажу про це.",shape=box,color=blue];
		j965814151 -> j2912210849;
	j1808948227 [label="Попри те, що я… знайомий з величною меланхолією, вона не надихає моє кадило. Та й Марі цього б ніколи не дозволила, це точно.",shape=box,color=blue];
		j1808948227 -> j2678893725;
	j3545001372 [label="Отець Ліон Аллард",shape=box,color=blue];
		j3545001372 -> "Chat ends.";
	j897806446 [label="На далекій замерзлій півночі є секта Світочів, які поклоняються трупу, якого видобули з вічної мерзлоти, коли льодовик трішки підтанув. Тіло ідеально збереглося, але ніхто не знає віку мерця. Однак на латунному диску, котрий висів на шиї, було викарбуване зображення сонця.",shape=box,color=blue];
		j897806446 -> j1935156839;
	j2912210849 [label="Я скажу Марі, тобі, пану Лойду, навіть Роуту. Неважливо. Я скажу. У цьому присягаюся.",shape=box,color=blue];
		j2912210849 -> j1336251520;
		j2912210849 -> j3722752342;
	j1935156839 [label="Вони вірують в те, що ця муміфікована плоть належить самому Солу. І що якогось дня життя повернеться у тіло й він воскресне. Кожні сто років вони готуються до «Великого надвечір’я» і багато послідовників п’ють отруєне вино того вечора.",shape=box,color=blue];
		j1935156839 -> j3362584013;
	j1336251520 [label="Це найбільше, чого я можу просити. Дякую тобі, Ліоне.",shape=box,color=red];
		j1336251520 -> j184016593;
	j3722752342 [label="Я вірю тобі. Просто хочу пройти цей шлях разом із тобою.",shape=box,color=red];
		j3722752342 -> j184016593;
	j3362584013 [label="Думаю, не потрібно пояснювати, що на ранок, коли мумифіковане тіло не воскресає, завжди знаходяться обґрунтовані причини, чому виникла помилка в підрахунках. Тоді дата переноситься ще на сто років чи приблизно до того.",shape=box,color=blue];
		j3362584013 -> j2201234741;
	j184016593 [label="Твоє прагнення знати, що я не вчиняю так від неконтрольованого бажання знищити себе, дуже цінне для мене.",shape=box,color=blue];
		j184016593 -> j2707896876;
	j2201234741 [label="Та щось я далеко відійшов від першочергової теми.",shape=box,color=blue];
		j2201234741 -> j3988785160;
	j2707896876 [label="Я не звик мати таких супутників у своєму житті.",shape=box,color=blue];
		j2707896876 -> j3022841415;
}