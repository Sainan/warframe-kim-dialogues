		j3090338735 -> j230481150 [label="false",color=purple];
		j3090338735 -> j2275943420 [label="false",color=purple];
	j3295744506 [label="Дихай, Ліоне. Дихай. Насправді їх тут нема.",shape=box,color=red];
		j3295744506 -> j3881578438;
	j2513953543 [label="Я… Мені шкода, Ліоне. Зосередься на екрані й тексті. Я тут.",shape=box,color=red];
		j2513953543 -> j926657874;
	j230481150 [label="Я знаю, що тебе попросили нести жахливий тягар. І може бути, що це неправильно. Але я не знаю, як допомогти.",shape=box,color=red];
		j230481150 -> j2824879976;
	j1679340809 [label="Ти для Марі — абсолютний всесвіт. Ти став мені дуже дорогим другом. Думаю, що й Роут сумуватиме за тобою, хоч і не визнаватиме цього назагал.",shape=box,color=red];
		j1679340809 -> j466864389;
	j2275943420 [label="[Зізнатися в почуттях] Ліоне, моє серце розірветься, якщо ти дозволиш цьому статися з собою. Я… ти небайдужий мені.",shape=box,color=red];
		j2275943420 -> j3320924715;
	j3881578438 [label="тут ти помиляєшся\nвони тут\nі ніколи не покидали мене\nніколи не покинуть\nентраті винен у цьому\nпробач мені",shape=box,color=blue];
		j3881578438 -> j2862131335;
	j926657874 [label="рвуть мою плоть\nвідривають від кісток\nчому? що в кінці?\nчий голод це втамовує?",shape=box,color=blue];
		j926657874 -> j3388382059;
		j926657874 -> j1151549239;
	j2824879976 [label="Не без застосування… немислимого. Або того.",shape=box,color=red];
		j2824879976 -> j4064767793;
	j466864389 [label="Про тебе дбають. Тебе люблять. У тебе є друзі й сім’я. Навіть якщо це не завжди відчувається.",shape=box,color=red];
		j466864389 -> j2599102568;
	j3320924715 [label="Я… А ти ж, вочевидячки, жартуєш. Це не можуть бути серйозні слова після баченого щойно! Ти або божеволієш потроху або твоє співчуття затьмарило твій розум.",shape=box,color=blue];
		j3320924715 -> j3979639558;
		j3320924715 -> j3966345930;
	j2862131335 [label="+10 Chemistry",color=orange];
		j2862131335 -> j4006363057;
	j3388382059 [label="Нічий. Тобі більше не треба так страждати. Відпусти.",shape=box,color=red];
		j3388382059 -> j963894057;
	j1151549239 [label="Я знаю. Я знаю, як це болить. Мені шкода. Мені дуже шкода. Вийди.",shape=box,color=red];
		j1151549239 -> j2074935730;
	j4064767793 [label="+10 Chemistry",color=orange];
		j4064767793 -> j748496973;
	j2599102568 [label="Ліоне, ти не сам. І за тобою сумуватимуть.",shape=box,color=red];
		j2599102568 -> j2876253326;
	j3979639558 [label="Ні. Ліоне, я серйозно. Ти для мене — цілий світ. І мені хотілося б якось змусити тебе повірити в це.",shape=box,color=red];
		j3979639558 -> j2740697248;
