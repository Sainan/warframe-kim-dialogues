		j4006363057 -> "Chat ends.";
	j963894057 [label="якби ж було все так просто\nці ланцюги так довго тримали мене\nдовше ніж існує мова\nдовше ніж існує моє власне я\nпробач мені",shape=box,color=blue];
		j963894057 -> j2862131335;
	j2074935730 [label="Озирнися довкола. Вийди з кімнати у власній голові.",shape=box,color=red];
		j2074935730 -> j3535812994;
	j748496973 [label="Я бачу пана Некралойда. Я чую розповіді про пана Ордіса чи пана Отака. Я думаю про порожні оболонки ворфреймів… про те, як думки повитягали з їхніх черепів.",shape=box,color=blue];
