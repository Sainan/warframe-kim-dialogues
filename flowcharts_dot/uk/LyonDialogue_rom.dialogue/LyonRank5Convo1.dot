		j3626627435 -> j3868112997 [label="false",color=purple];
		j3626627435 -> j1478915251 [label="false",color=purple];
	j2688225210 [label="Ти якось казав, що хочеш поговорити про те, що я не дуже вірю у «справжню божественність» Байдужості. Зараз підійде?",shape=box,color=red];
		j2688225210 -> j198309878;
	j1478915251 [label="[Завершити розмову]",shape=box,color=red];
		j1478915251 -> "Chat ends.";
	j2333178447 [label="Котрогось дня ти мене питав про концептуальне втілення й про Байдужість. Щось тебе непокоїть?",shape=box,color=red];
		j2333178447 -> j1647930774;
	j1374654225 [label="Роут переконаний, що Людина в стіні — не справжнє божество. Що він — «концептуальне втілення». Що думаєш стосовно цього?",shape=box,color=red];
		j1374654225 -> j726155919;
	j3868112997 [label="Лойде, а що між вами з Роутом? У мене лише крихти й уривки цього знання.",shape=box,color=red];
		j3868112997 -> j3977255354;
	j198309878 [label="Мандрівниче, не впевнений, що будь-який час «підійде» для обговорення проблеми, яка призвела мене до цього стану.",shape=box,color=blue];
		j198309878 -> j2321361075;
	"Chat ends." [color=orange];
	j1647930774 [label="Мандрівниче, мене непокоїть чимало різних речей. Боюся, що тема Байдужості та концептуальних утілень лише одна з них.",shape=box,color=blue];
		j1647930774 -> j2675525185;
	j726155919 [label="Мандрівниче, в тому й біда, що я не знаю. Якби відповідь була відомою, то я б не ятрив себе такими запеклими внутрішніми суперечками.",shape=box,color=blue];
		j726155919 -> j709224591;
	j3977255354 [label="Я скажу коротко, та зазначу про свою шокованість уникання його довжелезних тирад на цю тему. Він за найменшої нагоди радо ділиться своїми думками.",shape=box,color=blue];
		j3977255354 -> j1333313241;
	j2321361075 [label="Але й у такому випадку зараз «підійде» точно так, як і будь-який інший час. Мене інтригує те, що ти наче як підтримуєш Роута у віруванні, що Байдужість — не істинне божество.",shape=box,color=blue];
		j2321361075 -> j709224591;
	j2675525185 [label="Чи дві, залежно від того, як ти інтерпретуєш ситуацію. Однак можу припустити, що саме це і є суттю цієї дилеми.",shape=box,color=blue];
		j2675525185 -> j709224591;
	j709224591 [label="Однак я маю… почати все із самого початку. Інакше ти без контексту не розумітимеш, чому саме ця тема така важлива для мене…",shape=box,color=blue];
		j709224591 -> j1643421182;
	j1333313241 [label="Він вважає, що Байдужість не є божеством Порожнечі, у всіх сенсах словах. Вона створена Ентраті й тими, хто взаємодіяв з нею потім…",shape=box,color=blue];
		j1333313241 -> j4033090872;
	j1643421182 [label="Я Брат Луа. Я присвятив своє життя віруванню в неї. Усе своє життя я в це вірив.",shape=box,color=blue];
		j1643421182 -> j356195716;
	j4033090872 [label="створена з тканини Порожнечі за допомогою того, що тобі відомо як «концептуальне втілення». ",shape=box,color=blue];
		j4033090872 -> j2567627732;
	j356195716 [label="Упродовж усіх років з миті прибуття в церкву я невідступно тримався віри, вважаючи, що мої знання, біль і видіння…",shape=box,color=blue];
		j356195716 -> j3711456313;
	j2567627732 [label="Думаю, приблизно так, як тобі вдалося створити Дувірі.",shape=box,color=blue];
		j2567627732 -> j709224591;
	j3711456313 [label="усе було угідне служіння їй. У її ім’я. І вони служили її меті.",shape=box,color=blue];
		j3711456313 -> j3047711855;
	j3047711855 [label="Так було… допоки «кардинал Діманш» не розкрив себе як Альбрехт Ентраті.",shape=box,color=blue];
		j3047711855 -> j528427770;
	j528427770 [label="Він розповів правду про своє походження, історію своїх необдуманих учинків у Порожнечі й про все, що з того вийшло. Якщо точніше… про все, що вийшло звідти.",shape=box,color=blue];
		j528427770 -> j1808994106;
		j528427770 -> j4155961116;
	j1808994106 [label="Байдужість.",shape=box,color=red];
		j1808994106 -> j1113277272;
	j4155961116 [label="І?",shape=box,color=red];
		j4155961116 -> j4069415742;
	j1113277272 [label="Точно. Він розповів про глузливу сутність, яка привіталася з ним. Про пальці, які він забрав із того місця, схожого на його лабораторію.",shape=box,color=blue];
		j1113277272 -> j2007547493;
	j4069415742 [label="Він розповів про спуск у сіроскляній капсулі у ту пустоту. У те місце, яке нагадувало його лабораторію. ",shape=box,color=blue];
		j4069415742 -> j2007547493;
	j2007547493 [label="Ба більше, він розповів про відчутий невимовний жах від того, що випустив назовні щось, що може переслідувати його не лише крізь простір, а й крізь час.",shape=box,color=blue];
		j2007547493 -> j938509370;
	j938509370 [label="Божество нічого. Сутність, яку потрібно зупинити. Істота, чиї шматки він забрав. Дещо, що шкрябало стіни й просилося, щоб його випустили.",shape=box,color=blue];
		j938509370 -> j1258797050;
	j1258797050 [label="Моторошне і всепоглинальне божество, яке було вільним і невільним водночас.",shape=box,color=blue];
		j1258797050 -> j2661173919;
		j1258797050 -> j3267670844;
	j2661173919 [label="Що ти маєш на увазі?",shape=box,color=red];
		j2661173919 -> j3826452011;
	j3267670844 [label="«Вільним і невільним водночас»?",shape=box,color=red];
		j3267670844 -> j3826452011;
	j3826452011 [label="Check boolean LyonRell1",color=orange];
		j3826452011 -> j2396804876 [label=true,color=green];
		j3826452011 -> j3875065742 [label=false,color=brown];
	j2396804876 [label="Час… заплутує подібних мені… у таких станах, як мій. Це складно описати. Я намагався пояснити якось і все скінчилося жалюгідною невдачею.",shape=box,color=blue];
		j2396804876 -> j1438334908;
	j3875065742 [label="Час… заплутує подібних мені… у таких станах, як мій. Це складно описати. Мені важко це дається.",shape=box,color=blue];
		j3875065742 -> j1438334908;
	j1438334908 [label="Я волію докладніше пояснити все іншим разом, бо це не та тема, яку я намагаюся зрозуміти сьогодні.",shape=box,color=blue];
		j1438334908 -> j366078008;
	j366078008 [label="Check boolean LyonRell1",color=orange];
		j366078008 -> j4258637606 [label=true,color=green];
		j366078008 -> j57581715 [label=true,color=green];
