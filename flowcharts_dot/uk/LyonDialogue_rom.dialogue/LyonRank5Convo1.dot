		j366078008 -> j57581715 [label=false,color=brown];
		j366078008 -> j489293536 [label=false,color=brown];
	j4258637606 [label="Але якщо ти чуєш… чи чув… Релла… То ми маємо це обговорити.",shape=box,color=red];
		j4258637606 -> j2690112432;
	j57581715 [label="Гаразд. Ти тут головний.",shape=box,color=red];
		j57581715 -> j3081423469;
	j489293536 [label="Знаєш, я таки хочу зануритися в це…",shape=box,color=red];
		j489293536 -> j498537281;
	j2690112432 [label="Так. І я дуже категорично був проти й уникав цієї теми. Лише його ім’я",shape=box,color=blue];
		j2690112432 -> j2556135940;
	j3081423469 [label="Я знаю, що категорично відмовлявся обговорювати це. Пробач мені. Але це може викликати видіння, від якого навряд чи легко зможу потім оговтатися.",shape=box,color=blue];
		j3081423469 -> j2086708308;
	j498537281 [label="Запевняю, так воно й буде. Я знаю, що категорично відмовлявся обговорювати це. Пробач мені. Але це може викликати видіння, від якого навряд чи легко зможу потім оговтатися.",shape=box,color=blue];
		j498537281 -> j2086708308;
	j2556135940 [label="уже несе загрозу",shape=box,color=blue];
		j2556135940 -> j1103260638;
	j2086708308 [label="Я не хочу знову обривати цю розмову, через те, що не можу її продовжувати через власну неміч.",shape=box,color=blue];
		j2086708308 -> j4152719844;
		j2086708308 -> j3056754495;
		j2086708308 -> j781726840;
	j1103260638 [label="з’являються образи людини в ланцюгах",shape=box,color=blue];
		j1103260638 -> j329858171;
	j4152719844 [label="Ліоне, не думаю що зможу назвати хоч когось, хто стикався й витримав те, що ти звеш «неміччю».",shape=box,color=red];
		j4152719844 -> j1339523488;
	j3056754495 [label="«Неміч» — жахливий спосіб сказати «проклятий видіннями, які він не просив». Але як скажеш.",shape=box,color=red];
		j3056754495 -> j1339523488;
	j781726840 [label="Ти знаєш на що здатний, тож я довірю тобі вести.",shape=box,color=red];
		j781726840 -> j2936321300;
	j329858171 [label="скривавленого чоловіка",shape=box,color=blue];
		j329858171 -> j989099224;
	j1339523488 [label="Дякую за такі слова. Але я усвідомлюю, що сам є лише розбитим вітражем, навіть у ліпші з моїх днів. Існую в міркуваннях де ті всі загублені шматочки.",shape=box,color=blue];
		j1339523488 -> j3780667529;
	j2936321300 [label="Дякую. Мене вражає твоє терпіння. Але я усвідомлюю, що сам є лише розбитим вітражем, навіть у ліпші з моїх днів. Існую в міркуваннях де ті всі загублені шматочки.",shape=box,color=blue];
		j2936321300 -> j3780667529;
	j989099224 [label="з посіченою плоттю",shape=box,color=blue];
		j989099224 -> j2619880318;
	j3780667529 [label="Щоразу як знаходжу щось із загубленого, то ріжуся об гострі краї й не можу нормально поставити його на місце.",shape=box,color=blue];
		j3780667529 -> j709828750;
	j2619880318 [label="нехай це зупиниться",shape=box,color=blue];
		j2619880318 -> j1679654614;
	j709828750 [label="Іноді закрадаються думки, чи не було б ліпше дійсно стати одним із тих порожньооких Гарроу, котрих я бачив у своїй голові, потягнувшись на закрайки своїх жахіть.",shape=box,color=blue];
		j709828750 -> j3090338735;
	j1679654614 [label="їхні обличчя\nтисячі тисяч\nпорожні й зламані\nзамкнуті в тиші\nназавжди у понівеченому проповіднику\nяким я стану",shape=box,color=blue];
		j1679654614 -> j3295744506;
		j1679654614 -> j2513953543;
