		j2740697248 -> j2228720352;
	j2094749492 [label="Добре. Мене радує те, що твоє тимчасове безумство покинуло тебе. Бо це ж заразно. Можливо, нам варто взяти павзу у використанні цього пристрою. Боюся, в тебе через нього мізки загнивають.",shape=box,color=blue];
