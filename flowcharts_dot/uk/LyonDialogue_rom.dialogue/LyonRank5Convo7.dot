	1964 [label="+5 Chemistry",color=orange];
		1964 -> 1978;
	1965 [label="Ha. Do you think I am surprised? I stand in the shadow of her light and always have. No, my friend - I am not bitter or jealous over this, I promise you.",shape=box,color=blue];
