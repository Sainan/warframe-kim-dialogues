		j3732953971 -> j1501669261;
	j824614220 [label="Пха! Якщо ти не хочеш, щоб тебе посвячували у внутрішні справи мого розуму, то не варто в ньому нишпорити. Це твоя провина.",shape=box,color=blue];
		j824614220 -> j3285172068;
	j2352195942 [label="Я дуже радий, що тобі подобаються мої подорожі. Саме тому я й вирішив говорити так мало. Чи можеш ти уявити, якби це було твоє особисте? Марі багато років тому приспала б мене, мов скаженого собаку.",shape=box,color=blue];
		j2352195942 -> j3285172068;
	j4288157341 [label="Тобі природно притаманна певна доза зухвалості та сарказму, до якої я ніколи не міг би піднятися. Залишу це тобі.",shape=box,color=blue];
