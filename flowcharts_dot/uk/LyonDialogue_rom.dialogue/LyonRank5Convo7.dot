	j1064205185 [label="Ліоне, як ти сьогодні?",shape=box,color=red];
		j1064205185 -> j383547939;
	j2706184120 [label="[Зізнатися в почуттях] Ліоне, ми можемо дещо обговорити?",shape=box,color=red];
		j2706184120 -> j1953947067;
	j1478915251 [label="[Завершити розмову]",shape=box,color=red];
		j1478915251 -> "Chat ends.";
	j1083986734 [label="Мені дуже важливо, щоб сказане мною було правильно почуто. Розумієш?",shape=box,color=blue];
		j1083986734 -> j4054208892;
		j1083986734 -> j2397311062;
	j2183298434 [label="Check boolean LyonHasDated",color=orange];
		j2183298434 -> j3274808350 [label=true,color=green];
		j2183298434 -> j2382560580 [label=true,color=green];
		j2183298434 -> j9312519 [label=true,color=green];
		j2183298434 -> j2382560580 [label=false,color=brown];
		j2183298434 -> j9312519 [label=false,color=brown];
	j3612567653 [label="Я радий, що є хтось, хто може знайти в собі сили пробитися крізь усіяну голками особистість Роута й побачити зламану річ, яка криється всередині.",shape=box,color=blue];
		j3612567653 -> j2437168716;
	j3104217962 [label="Чи можу я поставити нетактовне запитання?",shape=box,color=blue];
		j3104217962 -> j656128196;
		j3104217962 -> j2722008506;
	j383547939 [label="Яке ж дивовижно доброзичливе та чарівно буденне питання. Мені не часто його ставлять.",shape=box,color=blue];
		j383547939 -> j3475141509;
	j1953947067 [label="Так, щось трапилося?",shape=box,color=blue];
		j1953947067 -> j3161343236;
		j1953947067 -> j2055050923;
	j4054208892 [label="Я починаю нервувати. Що трапилося?",shape=box,color=red];
		j4054208892 -> j3577402861;
	j2397311062 [label="Так. Я слухаю.",shape=box,color=red];
		j2397311062 -> j4100657917;
	j3274808350 [label="Мені було важко, бо не знаю, як ти почуватимешся, оскільки…",shape=box,color=red];
		j3274808350 -> j4197924209;
	j2382560580 [label="Так, я трохи… закохуюся в неї.",shape=box,color=red];
		j2382560580 -> j2078862384;
	j9312519 [label="Це розмова, де ти мені погрожуватимеш?",shape=box,color=red];
		j9312519 -> j1141906152;
	j2437168716 [label="Я знаю, він це категорично заперечує, але вважає себе боягузом. Я б не назвав його таким.",shape=box,color=blue];
		j2437168716 -> j1792083268;
	j656128196 [label="Так, я тобі багато таких ставлю.",shape=box,color=red];
		j656128196 -> j3153241577;
	j2722008506 [label="Чому я зустрічаюся з Роутом?",shape=box,color=red];
		j2722008506 -> j3902484188;
	j3475141509 [label="Я… у порядку, дякую.",shape=box,color=blue];
		j3475141509 -> j1941881224;
	j3161343236 [label="Не зважай. Вибач. Я не пам’ятаю, що хотілося сказати.",shape=box,color=red];
		j3161343236 -> j3252004668;
	j2055050923 [label="Не знаю, як це найліпше сформулювати, тому скажу прямо. Я маю почуття до тебе.",shape=box,color=red];
		j2055050923 -> j3566265004;
	j3577402861 [label="Усе дуже гаразд. Саме це тобі так важливо зрозуміти — жахливі наслідки, від яких я хочу тебе звільнити, якщо припускатимеш, що вони можуть настати.",shape=box,color=blue];
		j3577402861 -> j479539218;
		j3577402861 -> j128416124;
		j3577402861 -> j2009772350;
	j4100657917 [label="+5 Chemistry",color=orange];
		j4100657917 -> j3682018154;
	j4197924209 [label="Ха. Гадаєш, я здивований? Я стою в тіні її світла й завжди стоятиму. Ні, дружаньо, я не злюся й не заздрю. Чесно.",shape=box,color=blue];
		j4197924209 -> j3458588793;
	j2078862384 [label="Як і всі ми. Моя духовна сестра ніколи не перестає мене дивувати. Я радий за вас обох неймовірно.",shape=box,color=blue];
		j2078862384 -> j867545859;
	j1141906152 [label="Гм? Ні. Я навряд чи був настільки самовпевненим, щоб тупотіти навколо та вдавати із себе її опікуна. Вона цілком здатна переламати тобі кістки, якщо вирішить, що так треба.",shape=box,color=blue];
		j1141906152 -> j2943540630;
	j1792083268 [label="Ентраті сказав йому, що він знадобиться, щоб урятувати майбутнє, якого він не знає. Майбутнє, над яким у нього не буде королівської влади, не буде прислужників, не буде нікого, хто йому поклонятиметься.",shape=box,color=blue];
		j1792083268 -> j2000055447;
	j3153241577 [label="Що… такого бачиш у Роуті, що спонукало вас обох… до залицянь?",shape=box,color=blue];
		j3153241577 -> j2867899234;
		j3153241577 -> j575030948;
		j3153241577 -> j2107924593;
	j3902484188 [label="Схоже, тобі вже ставили таке питання, або ж воно очікуване. Так. Що в ньому таке?",shape=box,color=blue];
		j3902484188 -> j2867899234;
		j3902484188 -> j575030948;
		j3902484188 -> j2107924593;
	j1941881224 [label="+20 Chemistry",color=orange];
		j1941881224 -> j41389727;
	j3252004668 [label="Зі мною таке часто трапляється. Часто, коли я проходжу крізь дверні отвори. Часто я замислювався, чому так відбувається.",shape=box,color=blue];
		j3252004668 -> j3872477140;
	j3566265004 [label="Я… ти… це точно? З тобою все гаразд? На голові наче слідів від удару немає…",shape=box,color=blue];
		j3566265004 -> j1106857902;
		j3566265004 -> j1170740855;
	j479539218 [label="Я слухаю.",shape=box,color=red];
		j479539218 -> j607113736;
	j128416124 [label="Щось у цих словах мало сенсу.",shape=box,color=red];
		j128416124 -> j4198196951;
	j2009772350 [label="Жахливі наслідки… чого?",shape=box,color=red];
		j2009772350 -> j3415826295;
	j3682018154 [label="Дякую. Перш ніж я почну, то маю запевнити, що все добре. Однак можуть бути жахливі наслідки, від яких я хочу тебе звільнити, якщо припускатимеш, що вони можуть настати.",shape=box,color=blue];
		j3682018154 -> j479539218;
		j3682018154 -> j128416124;
		j3682018154 -> j2009772350;
	j3458588793 [label="Я не маю образи через те, що сталося між нами, я все ще можу лише висловити свою вдячність за час, який ми провели разом.",shape=box,color=blue];
		j3458588793 -> j2577506105;
	j867545859 [label="Коли вона говорить про тебе, в очах її стільки радості. Їй аж паморочиться від хвилювання, коли думає, що ти можеш завітати.",shape=box,color=blue];
		j867545859 -> j274015151;
	j2943540630 [label="Я просто хотів сказати, що її щастя заразне — і я теж усміхаюся, коли думаю про це. Тож за це я також мушу тобі подякувати.",shape=box,color=blue];
		j2943540630 -> j6226238;
	j2000055447 [label="Він міг би вважати це актом страху. Немов пацюк, що тікає з корабля, що тоне, він прийняв сироватку та забув дії, що до цього призвели. ",shape=box,color=blue];
		j2000055447 -> j308060628;
	j2867899234 [label="Ну, якщо прямо… ти його бачив?",shape=box,color=red];
		j2867899234 -> j1351510381;
	j575030948 [label="Гадаю, у ньому біль… десь там, під усім цим гумором і особистістю.",shape=box,color=red];
		j575030948 -> j3310158517;
	j2107924593 [label="Нічого не можу з цим удіяти. Мене приваблює темрява й незебпека в ньому.",shape=box,color=red];
		j2107924593 -> j84748526;
	j41389727 [label="Так, гадаю, я сьогодні в цілковитому порядку.",shape=box,color=blue];
		j41389727 -> j3393720357;
	j3872477140 [label="+5 Chemistry",color=orange];
		j3872477140 -> j3393720357;
	j1106857902 [label="Чому в це важко повірити?",shape=box,color=red];
		j1106857902 -> j1952884156;
	j1170740855 [label="Це точно, Ліоне, жодних сумнівів.",shape=box,color=red];
		j1170740855 -> j1952884156;
	j607113736 [label="+5 Chemistry",color=orange];
		j607113736 -> j1543476645;
	j4198196951 [label="Так. Я до болю це розумію.",shape=box,color=blue];
		j4198196951 -> j3415826295;
	j3415826295 [label="Дозволь почати знову.",shape=box,color=blue];
		j3415826295 -> j1543476645;
	j2577506105 [label="+10 Chemistry",color=orange];
		j2577506105 -> j4195972183;
	j274015151 [label="+10 Chemistry",color=orange];
		j274015151 -> j2943540630;
	j6226238 [label="Ліон",shape=box,color=blue];
		j6226238 -> "Chat ends.";
	j308060628 [label="Я ж бачу це як людину, яка бачила розрахунки на полі бою та знає, коли потрібно покинути вже втрачений корабель. Бо війна ще не закінчилася.",shape=box,color=blue];
		j308060628 -> j1494212890;
	j1351510381 [label="Я не буду тебе засуджувати.",shape=box,color=blue];
		j1351510381 -> j2357883043;
	j3310158517 [label="+5 Chemistry",color=orange];
		j3310158517 -> j489972926;
	j84748526 [label="Я розумію цю тягу. Не буду заперечувати, що сам її не бачу. Однак заради тебе я сподіваюся, що ти не дозволиш їй поглинути тебе.",shape=box,color=blue];
		j84748526 -> j2287738915;
	j3393720357 [label="Гарного тобі дня. Ліон.",shape=box,color=blue];
		j3393720357 -> "Chat ends.";
	j1952884156 [label="Ну, якщо відверто, то коли в тебе стільки варіантів довкола… Марі, чи Роут, чи… будь-хто інший у всесвіті…",shape=box,color=blue];
		j1952884156 -> j3437139776;
	j1543476645 [label="Я розумію, що багато хто може мене тлумачити, й це цілком може так і бути… як хворого. Принаймні, я точно не зовсім сповна розуму.",shape=box,color=blue];
		j1543476645 -> j2305363363;
	j4195972183 [label="Тепер я радий, що ти будеш із нею. Вона принесе тобі радість там, де я міг би принести лише смуток. Будьте щасливі. У тебе є всі мої благословення.",shape=box,color=blue];
		j4195972183 -> j6226238;
	j1494212890 [label="Evaluate expressions",color=orange];
		j1494212890 -> j1472102048 [label="RoatheVillian",color=purple];
		j1494212890 -> j2649526788 [label="RoatheVillian",color=purple];
		j1494212890 -> j2773468434 [label="RoatheVillian",color=purple];
		j1494212890 -> j1472102048 [label="RoatheRedeemed",color=purple];
		j1494212890 -> j2649526788 [label="RoatheRedeemed",color=purple];
		j1494212890 -> j2999100001 [label="RoatheRedeemed",color=purple];
		j1494212890 -> j2773468434 [label="RoatheRedeemed",color=purple];
		j1494212890 -> j1472102048 [label="false",color=purple];
		j1494212890 -> j2649526788 [label="false",color=purple];
	j2357883043 [label="Хоча, заради твого блага, я дуже сподіваюся, що ця примха швидко мине й не стане залежністю. Я бачив, як такі речі руйнували інших.",shape=box,color=blue];
		j2357883043 -> j551193517;
	j489972926 [label="Так, я сам таке бачив. Можливо, воно глибоко закопане. Але він може не схвалити твої спроби втрутитися. Гадаю, йому подобається, ким він став.",shape=box,color=blue];
		j489972926 -> j551193517;
	j2287738915 [label="Такі домовленості мають ґрунтуватися на чомусь більшому, ніж… проста темрява. Однак я не буду читати тобі лекції.",shape=box,color=blue];
		j2287738915 -> j551193517;
	j3437139776 [label="Мені важко повірити, що можеш вирішити так само як я — насолоджуватися розбитим вітражем… хоча може ти тяжко хворієш зараз.",shape=box,color=blue];
		j3437139776 -> j3882715795;
		j3437139776 -> j3374420423;
	j2305363363 [label="Я дуже давно примирився з цим. Мене вже воно не обходить. Видіння, які полонили мене… ті голоси… я знайшов методи життя без страху та ненависті до них.",shape=box,color=blue];
		j2305363363 -> j3743526166;
	j1472102048 [label="Мені радісно допомогти йому так, як я зможу.",shape=box,color=red];
		j1472102048 -> j1593524206;
	j2649526788 [label="Те, що з ним сталося, дуже складно. Гадаю, він ще довго з цим розбиратиметься.",shape=box,color=red];
		j2649526788 -> j1593524206;
	j2773468434 [label="Саме так. Він зробив це, щоб виграти війну, а іноді це означає програти кілька битв.",shape=box,color=red];
		j2773468434 -> j1593524206;
	j2999100001 [label="З часом він собі пробачить. Але я не думаю, що зовнішня оболонка колись справді зміниться.",shape=box,color=red];
		j2999100001 -> j1593524206;
	j551193517 [label="Ти знаєш свої думки й свої можливості. Бажаю вам обом успіхів.",shape=box,color=blue];
		j551193517 -> j239507686;
	j3882715795 [label="Ліоне, ти небайдужий мені. Ти мені важливий. Я хочу бути з тобою, якщо дозволиш.",shape=box,color=red];
		j3882715795 -> j888867256;
	j3374420423 [label="Якщо ти кажеш, що це не взаємно…",shape=box,color=red];
		j3374420423 -> j3160459750;
	j3743526166 [label="(Хоча, останнім часом трішки злості присутньо, якщо чесно, але це зараз ні до чого)",shape=box,color=blue];
		j3743526166 -> j174101005;
	j1593524206 [label="+10 Chemistry",color=orange];
		j1593524206 -> j3244383901;
	j239507686 [label="+10 Chemistry",color=orange];
		j239507686 -> j1965947651;
	j888867256 [label="Пробач мені, будь ласка, пробач. Я просто… я думав, що це неможливо, це… не те, що я… міг… уявити…",shape=box,color=blue];
		j888867256 -> j4291643733;
	j3160459750 [label="Та ні! Я не це мав на увазі! Я просто… я думав, що це неможливо, це… не те, що я… міг… уявити…",shape=box,color=blue];
		j3160459750 -> j4291643733;
	j174101005 [label="Я хочу досягти твого розуміння в тому, що як розірвеш те, що між нами — той зв’язок між мною та іншою людиною, який раніше вважався неможливий…",shape=box,color=blue];
		j174101005 -> j3932187787;
	j3244383901 [label="І тому я бажаю вам обом усього найліпшого.",shape=box,color=blue];
		j3244383901 -> j1965947651;
	j1965947651 [label="Крім того, тепер, коли йому, здається, «свербить почухатися», він перестав провокувати Марі на відкриті конфлікти.",shape=box,color=blue];
		j1965947651 -> j2276336356;
	j4291643733 [label="Evaluate expressions",color=orange];
		j4291643733 -> j1463182299 [label="RoatheDating",color=purple];
		j4291643733 -> j2430098823 [label="MarieDating",color=purple];
		j4291643733 -> j262540751 [label="false",color=purple];
	j3932187787 [label="Якщо надумаєш відпустити своє серце деінде від мого? ",shape=box,color=blue];
		j3932187787 -> j3258424914;
	j2276336356 [label="Що ж, принаймні не так часто. Бувай.",shape=box,color=blue];
		j2276336356 -> j6226238;
	j1463182299 [label="+5 Chemistry",color=orange];
		j1463182299 -> j1740295500;
	j2430098823 [label="+5 Chemistry",color=orange];
		j2430098823 -> j2471650581;
	j262540751 [label="+20 Chemistry",color=orange];
		j262540751 -> j1702872871;
	j3258424914 [label="Mon miracle, я витримаю.",shape=box,color=blue];
		j3258424914 -> j3061073610;
	j1740295500 [label="Я дуже… зворушений. І… я не знаю звичаїв цього часу, тож відмовляюся.",shape=box,color=blue];
		j1740295500 -> j1610453764;
	j2471650581 [label="Я дуже… зворушений. І… я не знаю звичаїв цього часу, тож відмовляюся.",shape=box,color=blue];
		j2471650581 -> j2237091206;
	j1702872871 [label="Ти справжнє mon miracle…",shape=box,color=blue];
		j1702872871 -> j1374158912;
	j3061073610 [label="Мене не поглине те, що катувало раніше. ",shape=box,color=blue];
		j3061073610 -> j1697539566;
	j1610453764 [label="Так чи інак, але ти наразі… з Роутом. Я не збираюся навіть уявляти до яких ускладнень призведуть такі зв'язки.",shape=box,color=blue];
		j1610453764 -> j3663104781;
	j2237091206 [label="Так чи інак, але ти наразі… з Марі. Вона занадто дорога для мене й навіть думати не хочу, щоби твої стосунки зі мною забирали час для неї. Або якось завадили вашим стосункам.",shape=box,color=blue];
