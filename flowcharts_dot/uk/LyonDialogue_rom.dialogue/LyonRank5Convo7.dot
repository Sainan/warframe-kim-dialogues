	"Chat ends." [color=orange];
	j3595849229 [label="Mon miracle, я… мушу переконатися, що ти щось розумієш, перш ніж я розповім дещо. ",shape=box,color=blue];
		j3595849229 -> j1083986734;
	j1559493235 [label="Я не здивований, що Марі полонила твоє серце, немов метелик. Вона… щось дивовижне.",shape=box,color=blue];
		j1559493235 -> j2183298434;
