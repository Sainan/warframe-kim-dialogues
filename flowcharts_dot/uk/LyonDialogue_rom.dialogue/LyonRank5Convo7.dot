		j1907355262 -> j2510561884;
	j2510561884 [label="І видіння… втекли. Вони покинули свій пост, прогнані сильнішим привидом… тобою.",shape=box,color=blue];
		j2510561884 -> j1354691340;
	j1354691340 [label="Я… встав. Поставив кадило на нічну тумбочку і… вирішив натомість пройтися піском Святилища…",shape=box,color=blue];
		j1354691340 -> j3948449883;
