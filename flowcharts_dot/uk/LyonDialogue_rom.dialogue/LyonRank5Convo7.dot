		2062 -> 2064;
	2063 [label="Update boolean IsDating",color=orange];
		2063 -> 2065;
	2064 [label="Nevertheless, all of this was meant to serve as pretext to a story that will now seem quite short in comparison to the rest...",shape=box,color=blue];
		2064 -> 2066;
	2065 [label="Ліон",shape=box,color=blue];
		2065 -> 2067;
	2066 [label="I awoke last night from a nightmare. When I did, shadows surrounded me. This is nothing foreign or new in my state of mind. They loomed over my bed, and would not clear.",shape=box,color=blue];
		2066 -> 2068;
	2067 [label="Chat ends.",color=orange];
	2068 [label="I was not frightened of them, for I knew they could not harm me. However, they would not be gone from my mind, either. There was only one I knew to be rid of them.",shape=box,color=blue];
		2068 -> 2069;
	2069 [label="Pushing up from bed, I dressed as best I could, staggering through the blurry vision of the continued nightmare. I grasped my thurible and fell to my knees in the middle of my floor, and prepared to... well. ",shape=box,color=blue];
