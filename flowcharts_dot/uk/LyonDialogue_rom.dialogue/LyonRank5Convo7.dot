	j1322438743 [label="Слів не потрібно, mon miracle…",shape=box,color=blue];
		j1322438743 -> j2511200805;
	j3363313718 [label="Поклянись мені, mon miracle, що якщо настане час, коли я стану для тебе порожньою кліткою… у тебе буде місце для мене.",shape=box,color=blue];
		j3363313718 -> j764187034;
	j2511200805 [label="Під час прогулянки я… миттєво усвідомив темну небезпеку такої миті. Що ти можеш… почати вважати це відповідальністю — почати сприймати мене як ланцюги, що обтяжують тебе.",shape=box,color=blue];
		j2511200805 -> j402951284;
