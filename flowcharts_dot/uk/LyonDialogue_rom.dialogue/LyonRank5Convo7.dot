	j1501669261 [label="Boolean IsDating is now false.",color=orange];
		j1501669261 -> j6226238;
	j3285172068 [label="Хай там як, усе це мало слугувати приводом для історії, яка зараз здаватиметься досить короткою порівняно з рештою…",shape=box,color=blue];
		j3285172068 -> j4226737534;
	j4226737534 [label="Я прокинувся минулої ночі від кошмару. Після пробудження мене оточили тіні. У цьому немає нічого нового чи чужого для мого розуму. Вони нависли над моїм ліжком і не зникали.",shape=box,color=blue];
		j4226737534 -> j1790886471;
	j1790886471 [label="Я їх не боявся, бо знав, що вони не можуть мені зашкодити. Однак вони також не зникали з моєї думки. Був лише один відомий мені спосіб, щоб позбутися їх.",shape=box,color=blue];
		j1790886471 -> j100658860;
	j100658860 [label="Я підвівся з ліжка, одягнувся якнайкраще, хитаючись крізь розмите видіння безперервного кошмару. Я схопив кадило, упав на коліна посеред підлоги та приготувався… ну. ",shape=box,color=blue];
		j100658860 -> j2649447252;
	j2649447252 [label="Приготувався «очищувати розум». Най буде так.",shape=box,color=blue];
		j2649447252 -> j1704716300;
	j1704716300 [label="Але щойно заплющив очі, мої думки почали блукати. Вони пливли… до тебе, mon miracle…",shape=box,color=blue];
		j1704716300 -> j1907355262;
