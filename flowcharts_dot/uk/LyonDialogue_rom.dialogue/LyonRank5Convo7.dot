		j997227248 -> j255362424;
	j3563023977 [label="Твій біль… схожий на відлуння мого. Мені буде не складно допомогти тобі його прожити.",shape=box,color=red];
		j3563023977 -> j251119082;
	j3297093781 [label="Я не можу описати те, що притягує мене до тебе. Але ти ніколи не станеш обов’язком чи тягарем.",shape=box,color=red];
		j3297093781 -> j3841148325;
	j255362424 [label="[Розірвати стосунки] Ти вибач, але для мене це вже все занадто. Ліпше буде покінчити з усім тут і зараз.",shape=box,color=red];
		j255362424 -> j531617493;
	j251119082 [label="У відповідь я не знайду слів, щоб описати як крається моє серце через тебе. Але навіки вдячний, що наші примари самотності знайшли одна одну.",shape=box,color=blue];
		j251119082 -> j1745535394;
	j3841148325 [label="Я не зможу висловити свою вдячність і не думаю, що є такі слова взагалі.",shape=box,color=blue];
		j3841148325 -> j1745535394;
	j531617493 [label="Так. Звісно. Це було б… дуже лицемірно прийняти будь-яку іншу відповідь в таку мить… ",shape=box,color=blue];
		j531617493 -> j1305272370;
	j1745535394 [label="Та тепер, коли докладено стільки зусиль, щоби представити разючу самозакохану преамбулу…",shape=box,color=blue];
		j1745535394 -> j1591696380;
		j1745535394 -> j2950721481;
		j1745535394 -> j3200708856;
	j1305272370 [label="Я цілком розумію. І не бажаю нічого іншого, лише найліпшого. І я плекатиму ті миті, які ми провели разом.",shape=box,color=blue];
