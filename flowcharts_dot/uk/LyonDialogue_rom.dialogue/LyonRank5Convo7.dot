	2078 [label="+5 Chemistry",color=orange];
		2078 -> 2080;
	2079 [label="I beg of you - I pray, to any god or gods on high or below - that you never do. This is a gift you have given me, and each time in its newness I will cherish it.",shape=box,color=blue];
