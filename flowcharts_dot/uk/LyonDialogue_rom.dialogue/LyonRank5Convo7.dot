	"Chat ends." [color=orange];
	j3193862264 [label="Mon miracle, I... must make very certain you understand something before I tell you this next anecdote of mine. ",shape=box,color=blue];
		j3193862264 -> j2428223341;
	j3287480167 [label="I am not surprised that Marie caught your heart in her hands like a butterfly. She is... quite something.",shape=box,color=blue];
		j3287480167 -> j2183298434;
	j1243665097 [label="Evaluate expressions on HellKeyPlayed counter",color=orange];
		j1243665097 -> j4081834027 [label="x >= 21",color=purple];
		j1243665097 -> j1766143879 [label="x < 21",color=purple];
		j1243665097 -> j1766143879 [label="false",color=purple];
	j3835148194 [label="How're you doing today, Lyon?",shape=box,color=red];
		j3835148194 -> j2718895134;
	j2614499038 [label="[Confess feelings.] Lyon? I was wondering if we could talk about something.",shape=box,color=red];
		j2614499038 -> j2661440882;
	j1478915251 [label="[Завершити розмову]",shape=box,color=red];
		j1478915251 -> "Chat ends.";
	j2428223341 [label="It is important to me that you are paying very close attention to these next words that I send you. Do you understand?",shape=box,color=blue];
		j2428223341 -> j4070374332;
		j2428223341 -> j3410229811;
	j2183298434 [label="Check boolean LyonHasDated",color=orange];
		j2183298434 -> j3667162724 [label=true,color=green];
		j2183298434 -> j3452946134 [label=true,color=green];
		j2183298434 -> j2196882114 [label=true,color=green];
		j2183298434 -> j3452946134 [label=false,color=brown];
		j2183298434 -> j2196882114 [label=false,color=brown];
	j4081834027 [label="I am glad there is someone who can find the strength to reach through the nettles of Roathe's personality to see the broken thing that lies within.",shape=box,color=blue];
		j4081834027 -> j58302161;
	j1766143879 [label="Might I ask what I fear is to be an indelicate question, my friend?",shape=box,color=blue];
		j1766143879 -> j843739938;
		j1766143879 -> j2693128618;
	j2718895134 [label="What a wonderfully benign and charmingly mundane question. I do not get asked this often.",shape=box,color=blue];
		j2718895134 -> j2527111940;
	j2661440882 [label="Yes, what is it? Is something the matter?",shape=box,color=blue];
		j2661440882 -> j2396878354;
		j2661440882 -> j3773332689;
	j4070374332 [label="You're making me nervous. What's wrong?",shape=box,color=red];
		j4070374332 -> j548002484;
	j3410229811 [label="Yes, I'm here. Go ahead.",shape=box,color=red];
		j3410229811 -> j613804273;
	j3667162724 [label="I didn't know how you'd feel, since...",shape=box,color=red];
		j3667162724 -> j987886511;
	j3452946134 [label="I'm kind of... in awe of her.",shape=box,color=red];
		j3452946134 -> j847299857;
	j2196882114 [label="Is this a conversation where you threaten me? Or?",shape=box,color=red];
		j2196882114 -> j3076358899;
	j58302161 [label="I know, though he denies it vehemently, that he believes himself a coward. I would not label him as such.",shape=box,color=blue];
		j58302161 -> j3323593791;
	j843739938 [label="Of course. I've asked you plenty.",shape=box,color=red];
		j843739938 -> j3874385234;
	j2693128618 [label="Why am I dating Roathe?",shape=box,color=red];
		j2693128618 -> j930926675;
	j2527111940 [label="I am... quite well, thank you.",shape=box,color=blue];
		j2527111940 -> j3192870469;
	j2396878354 [label="Never mind. Sorry. Forgot what I was going to say, actually.",shape=box,color=red];
		j2396878354 -> j757720619;
	j3773332689 [label="I don't know how to phrase it best, so I'm going to come right out and say it - I have feelings for you.",shape=box,color=red];
		j3773332689 -> j2434090358;
	j548002484 [label="Nothing is wrong - quite the opposite. That is what is so imperative for you to comprehend - the dire consequences from which I wish to free you, should you assume they might follow.",shape=box,color=blue];
		j548002484 -> j3937136035;
		j548002484 -> j1485963904;
		j548002484 -> j96225943;
	j613804273 [label="+5 Chemistry",color=orange];
		j613804273 -> j2309858857;
	j987886511 [label="Ha. Do you think I am surprised? I stand in the shadow of her light and always have. No, my friend - I am not bitter or jealous over this, I promise you.",shape=box,color=blue];
		j987886511 -> j2649534657;
	j847299857 [label="As are we all. The sister of my soul never ceases to amaze me. I am happy for you both beyond the ability for words to express.",shape=box,color=blue];
		j847299857 -> j3490508537;
	j3076358899 [label="Hm? No. I would hardly be so bullish as to stomp about and pretend to be her guardian. She is quite capable of breaking your bones if she decides you are so worthy.",shape=box,color=blue];
		j3076358899 -> j517656419;
	j3323593791 [label="Entrati told him he would be needed to save a future he did not know. One that he had no kingship over, no people to grovel at his feet, no servants to worship him.",shape=box,color=blue];
		j3323593791 -> j1772488340;
	j3874385234 [label="What... do you see in Roathe that has led you two into... courtship?",shape=box,color=blue];
		j3874385234 -> j700729377;
		j3874385234 -> j1975053623;
		j3874385234 -> j2430155356;
	j930926675 [label="I see you have either already faced this line of questioning, or you were expecting it. Yes. Precisely that. What... do you see in him?",shape=box,color=blue];
		j930926675 -> j700729377;
		j930926675 -> j1975053623;
		j930926675 -> j2430155356;
	j3192870469 [label="+20 Chemistry",color=orange];
		j3192870469 -> j2969896602;
	j757720619 [label="Happens to me frequently. Often when I pass through doorways. Oft I have wondered why that is.",shape=box,color=blue];
		j757720619 -> j398709377;
	j2434090358 [label="I... you are... certain? Are you well? You have not hit your head recently, have you?",shape=box,color=blue];
		j2434090358 -> j442702286;
		j2434090358 -> j1681022814;
	j3937136035 [label="I'm listening.",shape=box,color=red];
		j3937136035 -> j3496963987;
	j1485963904 [label="You're not making much sense.",shape=box,color=red];
		j1485963904 -> j2465992472;
	j96225943 [label="Dire consequences of... what?",shape=box,color=red];
		j96225943 -> j3871584006;
	j2309858857 [label="Thank you. Before I begin I wish to assure you that there is nothing wrong - however, therein lies perhaps the dire consequences from which I wish to free you, should you assume they might follow.",shape=box,color=blue];
		j2309858857 -> j3937136035;
		j2309858857 -> j1485963904;
		j2309858857 -> j96225943;
	j2649534657 [label="I hold no resentment over what passed between us, I am still only able to express my grateful soul for the time we did spend together.",shape=box,color=blue];
		j2649534657 -> j214584862;
	j3490508537 [label="There is such joy in her eyes when she speaks of you. She is giddy with excitement whenever she thinks you might be stopping by.",shape=box,color=blue];
		j3490508537 -> j3363435414;
	j517656419 [label="I merely wished to tell you that her happiness is contagious - and I find myself smiling in the thought of it as well. So for that, I also must thank you.",shape=box,color=blue];
		j517656419 -> j6226238;
	j1772488340 [label="He might think it an act of fear - a rat fleeing a sinking ship - to take the serum and forget the actions that led to it. ",shape=box,color=blue];
		j1772488340 -> j506714654;
	j700729377 [label="To put it bluntly? Have you seen him?",shape=box,color=red];
		j700729377 -> j2784700234;
	j1975053623 [label="I think there's a pain in him, somewhere beneath all the... humor and personality.",shape=box,color=red];
		j1975053623 -> j549606193;
	j2430155356 [label="I... can't help it. There's a darkness and a danger in him that I find alluring. It draws me in.",shape=box,color=red];
		j2430155356 -> j77173878;
	j2969896602 [label="Yes, I think I am now quite well today, indeed.",shape=box,color=blue];
		j2969896602 -> j673605977;
	j398709377 [label="+5 Chemistry",color=orange];
		j398709377 -> j673605977;
	j442702286 [label="Why is it so hard to believe?",shape=box,color=red];
		j442702286 -> j2799241080;
	j1681022814 [label="I'm sure, Lyon. I'm not concussed.",shape=box,color=red];
		j1681022814 -> j2799241080;
	j3496963987 [label="+5 Chemistry",color=orange];
		j3496963987 -> j2783825046;
	j2465992472 [label="Yes. I am painfully aware of this.",shape=box,color=blue];
		j2465992472 -> j3871584006;
	j3871584006 [label="Allow me to begin again.",shape=box,color=blue];
		j3871584006 -> j2783825046;
	j214584862 [label="+10 Chemistry",color=orange];
		j214584862 -> j3026152412;
	j3363435414 [label="+10 Chemistry",color=orange];
		j3363435414 -> j517656419;
	j6226238 [label="Ліон",shape=box,color=blue];
		j6226238 -> "Chat ends.";
	j506714654 [label="I see it as a man who saw the calculations of the battlefield and knew when to abandon a vessel already lost. For the war was not yet over.",shape=box,color=blue];
		j506714654 -> j1494212890;
	j2784700234 [label="Far be it from me to condemn you.",shape=box,color=blue];
		j2784700234 -> j3630212947;
	j549606193 [label="+5 Chemistry",color=orange];
		j549606193 -> j3818334532;
	j77173878 [label="I can understand the pull. I will not deny that I do not see it myself. However, I do hope for your sake you do not allow it to consume you.",shape=box,color=blue];
		j77173878 -> j3172322607;
	j673605977 [label="Have a lovely rest of your day. - Lyon",shape=box,color=blue];
		j673605977 -> "Chat ends.";
	j2799241080 [label="Well, to be blunt - when you have such other options before you... Marie or Roathe or... anyone else in the universe for that matter...",shape=box,color=blue];
		j2799241080 -> j489569787;
	j2783825046 [label="I am aware that I can be construed by many, and in fact, very well might be, in reality, to be... unwell. At the very least, I am not entirely of sound mind.",shape=box,color=blue];
		j2783825046 -> j2189956678;
	j3026152412 [label="Now, I am happy you spend it with her. She will bring you joy, where I could only bring you sadness. Be happy with her. You have all of my blessings.",shape=box,color=blue];
		j3026152412 -> j6226238;
	j1494212890 [label="Evaluate expressions",color=orange];
		j1494212890 -> j1583030268 [label="RoatheVillian",color=purple];
		j1494212890 -> j3329385969 [label="RoatheVillian",color=purple];
		j1494212890 -> j3214345383 [label="RoatheVillian",color=purple];
		j1494212890 -> j1583030268 [label="RoatheRedeemed",color=purple];
		j1494212890 -> j3329385969 [label="RoatheRedeemed",color=purple];
		j1494212890 -> j3055723293 [label="RoatheRedeemed",color=purple];
		j1494212890 -> j3214345383 [label="RoatheRedeemed",color=purple];
		j1494212890 -> j1583030268 [label="false",color=purple];
		j1494212890 -> j3329385969 [label="false",color=purple];
	j3630212947 [label="Though, for your sake, I do hope this fancy passes quickly and does not become an addiction. I have seen such things destroy others.",shape=box,color=blue];
		j3630212947 -> j1818668324;
	j3818334532 [label="Yes, I have seen it myself. Buried deep, though it may be. But he may not welcome your attempts to pry. I believe he enjoys what he has become.",shape=box,color=blue];
		j3818334532 -> j1818668324;
	j3172322607 [label="Such arrangements should be based on more than... simple darkness. I shall not lecture you, however.",shape=box,color=blue];
		j3172322607 -> j1818668324;
	j489569787 [label="I have trouble believing you would choose to dally with a broken stained glass window such as I... lest you were gravely ill.",shape=box,color=blue];
		j489569787 -> j3973474304;
		j489569787 -> j596445342;
	j2189956678 [label="I have long since come to be at peace with this. It does not trouble me any longer. The visions that plague me - the voices - I have come to find ways to live with them without fear or hatred.",shape=box,color=blue];
		j2189956678 -> j3158466825;
	j1583030268 [label="I'm just happy to be there for him, in any way that I can.",shape=box,color=red];
		j1583030268 -> j3696555488;
	j3329385969 [label="What happened to him is... complicated. I think he'll be sorting through it for a long while.",shape=box,color=red];
		j3329385969 -> j3696555488;
	j3214345383 [label="Exactly. He did it to win the war - and sometimes that means losing a few battles.",shape=box,color=red];
		j3214345383 -> j3696555488;
	j3055723293 [label="He'll forgive himself in time. But I don't think the outer shell will ever really change.",shape=box,color=red];
		j3055723293 -> j3696555488;
	j1818668324 [label="You know your own mind and your limits. I wish you both well.",shape=box,color=blue];
		j1818668324 -> j2439864653;
	j3973474304 [label="Lyon? I have feelings for you. I care about you. I'd like to be with you, if you'd like to be with me.",shape=box,color=red];
		j3973474304 -> j3927477593;
	j596445342 [label="If you're saying it's not mutual...",shape=box,color=red];
		j596445342 -> j2905698196;
	j3158466825 [label="(Lately, I think, a little out of spite if I might be honest, but that is neither here nor there.)",shape=box,color=blue];
		j3158466825 -> j3693792089;
	j3696555488 [label="+10 Chemistry",color=orange];
		j3696555488 -> j3610961969;
	j2439864653 [label="+10 Chemistry",color=orange];
		j2439864653 -> j4151081128;
	j3927477593 [label="Forgive me, please forgive me - I simply - I thought it was impossible, this is... not something I... could have... imagined...",shape=box,color=blue];
		j3927477593 -> j184601558;
	j2905698196 [label="Hardly! That is not what I mean to imply! Far - far from it, in fact, I simply - I thought it was impossible, this is... not something I... could have... imagined...",shape=box,color=blue];
		j2905698196 -> j184601558;
	j3693792089 [label="But I wish you to understand that if you were to end this between us - this bond that I thought was previously heretofore impossible between myself and another -",shape=box,color=blue];
		j3693792089 -> j181320283;
	j3610961969 [label="To which I wish you both the absolute best of luck.",shape=box,color=blue];
		j3610961969 -> j4151081128;
	j4151081128 [label="Besides, now that he seems to have an \"itch to scratch,\" he has stopped goading Marie in to open conflict.",shape=box,color=blue];
		j4151081128 -> j2080624893;
	j184601558 [label="+20 Chemistry",color=orange];
		j184601558 -> j1271585627;
	j181320283 [label="If you were to ever let your heart wander away from mine? ",shape=box,color=blue];
		j181320283 -> j552213775;
	j2080624893 [label="Well. Not as frequently, at any rate. Farewell for now.",shape=box,color=blue];
		j2080624893 -> j6226238;
	j1271585627 [label="You truly are mon miracle...",shape=box,color=blue];
		j1271585627 -> j1374158912;
	j552213775 [label="I will endure, mon miracle.",shape=box,color=blue];
		j552213775 -> j3242067955;
	j1374158912 [label="Boolean LyonDating is now true.",color=orange];
		j1374158912 -> j4115967391;
	j3242067955 [label="I will not be consumed by that which has plagued me. ",shape=box,color=blue];
		j3242067955 -> j1697539566;
	j4115967391 [label="Boolean IsDating is now true.",color=orange];
		j4115967391 -> j3642226382;
	j1697539566 [label="Check boolean LyonAllRight",color=orange];
		j1697539566 -> j744145472 [label=true,color=green];
		j1697539566 -> j2073349236 [label=false,color=brown];
	j3642226382 [label="Boolean LyonHasDated is now true.",color=orange];
		j3642226382 -> "Chat ends.";
	j744145472 [label="I will be, to use your colloquialism, \"all right.\" I will find cause to smile and laugh once more.",shape=box,color=blue];
		j744145472 -> j1877637589;
		j744145472 -> j363282189;
	j2073349236 [label="I will survive. I will be fine. I will find cause to smile and laugh once more.",shape=box,color=blue];
		j2073349236 -> j1877637589;
		j2073349236 -> j363282189;
	j1877637589 [label="Oh, Lyon... you aren't a burden to me.",shape=box,color=red];
		j1877637589 -> j2219990608;
	j363282189 [label="Are you... saying you want to end things between us?",shape=box,color=red];
		j363282189 -> j4181332823;
	j2219990608 [label="I am simply attempting to free you of any perceived hardship you might feel on my account...",shape=box,color=blue];
		j2219990608 -> j3011004471;
		j2219990608 -> j2588881899;
		j2219990608 -> j2942291040;
	j4181332823 [label="No! Anything of the sort! I am simply attempting to free you of any perceived hardship you might feel on my account.",shape=box,color=blue];
		j4181332823 -> j3011004471;
		j4181332823 -> j2588881899;
		j4181332823 -> j2942291040;
	j3011004471 [label="Your pain... echoes a kind of my own. It'd never be a hardship to help you through it.",shape=box,color=red];
		j3011004471 -> j2989175492;
	j2588881899 [label="I can't describe what draws me to you. But you will never be a duty or a burden.",shape=box,color=red];
		j2588881899 -> j1433573642;
	j2942291040 [label="[Break up.] This is all just become too much for me, I'm sorry. It might be best to end things here.",shape=box,color=red];
		j2942291040 -> j3687437764;
	j2989175492 [label="To which I cannot express how much my heart breaks in turn for you. But that I am forever grateful that our lonely ghosts of pain have found each other.",shape=box,color=blue];
		j2989175492 -> j275442452;
	j1433573642 [label="To which I cannot properly express my gratitude, and I do not think any words ever can.",shape=box,color=blue];
		j1433573642 -> j275442452;
	j3687437764 [label="Yes. Of course. It would be... hypocritical to accept any other answer at this point in time... ",shape=box,color=blue];
		j3687437764 -> j2251861851;
	j275442452 [label="But now that I have gone through great pains to go through what has been a most spectacularly self-indulgent preamble...",shape=box,color=blue];
		j275442452 -> j3341162535;
		j275442452 -> j1253470459;
		j275442452 -> j2094291099;
	j2251861851 [label="I understand completely. And I wish you nothing but the best. And I will cherish all the moments we have spent together.",shape=box,color=blue];
		j2251861851 -> j37205945;
	j3341162535 [label="For a guy who started off silent, you really did get wordy.",shape=box,color=red];
		j3341162535 -> j419560915;
	j1253470459 [label="I find them endearing, don't worry.",shape=box,color=red];
		j1253470459 -> j4187943851;
	j2094291099 [label="You could've just said \"I'll be fine, you know, if we ever go our separate ways.\"",shape=box,color=red];
		j2094291099 -> j3287031406;
	j37205945 [label="I will remember them in my soul, even if they vanish from my mind. Farewell.",shape=box,color=blue];
		j37205945 -> j3732953971;
	j419560915 [label="+5 Chemistry",color=orange];
		j419560915 -> j725038002;
	j4187943851 [label="+5 Chemistry",color=orange];
		j4187943851 -> j4074233472;
	j3287031406 [label="+5 Chemistry",color=orange];
		j3287031406 -> j3095565797;
	j3732953971 [label="Boolean LyonDating is now false.",color=orange];
		j3732953971 -> j1501669261;
	j725038002 [label="Bah! If you did not wish to be privy to the inner workings of my mind, you should not have gone poking about. You are entirely to blame for that.",shape=box,color=blue];
		j725038002 -> j1460635187;
	j4074233472 [label="I am quite glad you enjoy my wanderings. This is precisely why I choose to speak as little as I do. Can you imagine enduring this in person? Marie would have put me down years ago like a mad dog.",shape=box,color=blue];
		j4074233472 -> j1460635187;
	j3095565797 [label="There is a certain amount of irreverence and sarcasm to which you naturally prevail that I could never hope to ascend. I will leave it to you.",shape=box,color=blue];
		j3095565797 -> j1460635187;
	j1501669261 [label="Boolean IsDating is now false.",color=orange];
		j1501669261 -> j6226238;
	j1460635187 [label="Nevertheless, all of this was meant to serve as pretext to a story that will now seem quite short in comparison to the rest...",shape=box,color=blue];
		j1460635187 -> j1640415856;
	j1640415856 [label="I awoke last night from a nightmare. When I did, shadows surrounded me. This is nothing foreign or new in my state of mind. They loomed over my bed, and would not clear.",shape=box,color=blue];
		j1640415856 -> j4192472693;
	j4192472693 [label="I was not frightened of them, for I knew they could not harm me. However, they would not be gone from my mind, either. There was only one I knew to be rid of them.",shape=box,color=blue];
		j4192472693 -> j2994652187;
	j2994652187 [label="Pushing up from bed, I dressed as best I could, staggering through the blurry vision of the continued nightmare. I grasped my thurible and fell to my knees in the middle of my floor, and prepared to... well. ",shape=box,color=blue];
		j2994652187 -> j3146855787;
	j3146855787 [label="I prepared to \"clear my mind.\" We shall leave it at that.",shape=box,color=blue];
		j3146855787 -> j869065970;
	j869065970 [label="But as I shut my eyes, my mind wandered. My thoughts drifted... to you, mon miracle...",shape=box,color=blue];
		j869065970 -> j2837394384;
	j2837394384 [label="The sound of your voice. The touch of your hand upon my shoulder... ",shape=box,color=blue];
		j2837394384 -> j3832090186;
	j3832090186 [label="And the visions... fled. They abandoned their post, chased away by the stronger ghost... of you.",shape=box,color=blue];
		j3832090186 -> j1688663544;
	j1688663544 [label="I... stood. Placed my thurible upon the nightstand, and... opted to walk through the sand of the Sanctum instead...",shape=box,color=blue];
		j1688663544 -> j98295308;
		j1688663544 -> j1686268280;
	j98295308 [label="I can understand why you felt the need for the preamble, now.",shape=box,color=red];
		j98295308 -> j3011036187;
	j1686268280 [label="I don't know what to say...",shape=box,color=red];
		j1686268280 -> j3260391860;
	j3011036187 [label="Yes. Well. On my walk I... instantly realized the dark danger of such a moment. That you might... come to think it a responsibility - come to see me as chains that weigh you down.",shape=box,color=blue];
		j3011036187 -> j1044170202;
	j3260391860 [label="+5 Chemistry",color=orange];
		j3260391860 -> j4256082621;
	j1044170202 [label="I beg of you - I pray, to any god or gods on high or below - that you never do. This is a gift you have given me, and each time in its newness I will cherish it.",shape=box,color=blue];
		j1044170202 -> j2673168414;
	j4256082621 [label="There are no words needed, mon miracle... ",shape=box,color=blue];
		j4256082621 -> j4012356546;
	j2673168414 [label="Vow to me, mon miracle - that should the time come, that I have become for you an empty cage... you will be free of me.",shape=box,color=blue];
		j2673168414 -> j1261128022;
	j4012356546 [label="On my walk I... instantly realized the dark danger of such a moment. That you might... come to think it a responsibility - come to see me as chains that weigh you down.",shape=box,color=blue];
		j4012356546 -> j1044170202;
	j1261128022 [label="I shall be no hollow prison for those I love. Not for you. Not for Marie.",shape=box,color=blue];
