		j3733163394 -> j1803214781;
	j921186906 [label="Так. Ну. Під час прогулянки я… миттєво усвідомив темну небезпеку такої миті. Що ти можеш… почати вважати це відповідальністю — почати сприймати мене як ланцюги, що обтяжують тебе.",shape=box,color=blue];
		j921186906 -> j402951284;
	j1803214781 [label="+5 Chemistry",color=orange];
		j1803214781 -> j1322438743;
	j402951284 [label="Благаю тебе — молюся до будь-якого бога чи богів на небесах або внизу — ніколи цього не робити. Це дар мені від тебе, і щоразу, коли він буде новим, я буду берегти його.",shape=box,color=blue];
