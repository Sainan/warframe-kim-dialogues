digraph {
	"LyonRank3Convo5 begins." [color=orange];
		"LyonRank3Convo5 begins." -> j3652313205;
	j3652313205 [label="It was a thunderstorm the night that \"Cardinal Dimanche\" came to us. He stood in the sanctuary of the church, untouched by the gale that raged outside.",shape=box,color=blue];
		j3652313205 -> j1340855724;
	j1340855724 [label="That should have served as my first cause for concern. Instead, I bowed my head to him and greeted him as I would any new envoy from the Holy Mother.",shape=box,color=blue];
		j1340855724 -> j2667623943;
	j2667623943 [label="We had been expecting a new Cardinal since our last one had departed several months earlier from illness, after all.",shape=box,color=blue];
		j2667623943 -> j3290787021;
	j3290787021 [label="Dimanche greeted me with a warm smile and a firm handshake. I asked him if his journey was long. I will never forget his reply.",shape=box,color=blue];
		j3290787021 -> j1292810979;
	j1292810979 [label="\"It was difficult... but it was not long.\"",shape=box,color=blue];
		j1292810979 -> j270387946;
	j270387946 [label="It puzzled me at the time, as did the fact that his greatcoat was bone dry. But I dismissed it, as all are wont to do when one is faced with the unusual.",shape=box,color=blue];
		j270387946 -> j2552020663;
	j2552020663 [label="And I did not have time to consider it, as Marie in her eagerness arrived a moment later.",shape=box,color=blue];
		j2552020663 -> j2264223680;
	j2264223680 [label="He knelt down to greet her at her level in her chair, and took her hands in his. I should have seen the manipulation for what it was.",shape=box,color=blue];
		j2264223680 -> j3737984557;
	j3737984557 [label="He was not the only devil to arrive on our doorstep in a storm, after all.",shape=box,color=blue];
		j3737984557 -> j1928339452;
	j1928339452 [label="Boolean LyonEntrati1 is now true.",color=orange];
		j1928339452 -> j2100050873;
	j2100050873 [label="Check boolean MarieEntrati1",color=orange];
		j2100050873 -> j1594028918 [label=true,color=green];
		j2100050873 -> j2671716751 [label=true,color=green];
		j2100050873 -> j1303127658 [label=true,color=green];
		j2100050873 -> j863078201 [label=false,color=brown];
		j2100050873 -> j1594028918 [label=false,color=brown];
	j1594028918 [label="The other devil being Roathe?",shape=box,color=red];
		j1594028918 -> j3615645525;
	j2671716751 [label="She tells this story very differently.",shape=box,color=red];
		j2671716751 -> j3405383751;
	j1303127658 [label="She still believe in his good intentions. Do you?",shape=box,color=red];
		j1303127658 -> j2239716395;
	j863078201 [label="I take it you aren't an ally of Entrati?",shape=box,color=red];
		j863078201 -> j1787328747;
	j3615645525 [label="Yes. But that is a tale for another day. If I begin speaking of him, my already foul mood will become... ",shape=box,color=blue];
		j3615645525 -> j1122285290;
	j3405383751 [label="Yes. She would.",shape=box,color=blue];
		j3405383751 -> j701847011;
		j3405383751 -> j741871526;
	j2239716395 [label="+5 Chemistry",color=orange];
		j2239716395 -> j911945148;
	j1787328747 [label="After enduring his lies and betrayal, and while we continue to suffer his manipulation of Marie, would you have me be? No, I most certainly am not.",shape=box,color=blue];
		j1787328747 -> j3240122672;
	j1122285290 [label="...untenable. I would much rather focus my current mood upon Entrati's misdeeds, if it is all the same to you.",shape=box,color=blue];
		j1122285290 -> j1428371468;
	j701847011 [label="She tells me that you see things that others don't, sometimes.",shape=box,color=red];
		j701847011 -> j3085957487;
	j741871526 [label="And? ",shape=box,color=red];
		j741871526 -> j3467620634;
	j911945148 [label="Marie believes the best in all souls. It is a skill she has honed and perfected and polished as a shield against the world around her.",shape=box,color=blue];
		j911945148 -> j674163199;
		j911945148 -> j657666092;
	j3240122672 [label="+5 Chemistry",color=orange];
		j3240122672 -> j2582284447;
	j1428371468 [label="Check boolean RoatheSerum1",color=orange];
		j1428371468 -> j1447760957 [label=true,color=green];
		j1428371468 -> j3038637279 [label=true,color=green];
		j1428371468 -> j1447760957 [label=false,color=brown];
		j1428371468 -> j4152895887 [label=false,color=brown];
	j3085957487 [label="And what would you make of that statement, were it to be true, Drifter?",shape=box,color=blue];
		j3085957487 -> j2821822155;
	j3467620634 [label="\"And,\" nothing. I have told you how I witnessed the event, as the truth of my experience of it. Nothing more.",shape=box,color=blue];
		j3467620634 -> j911945148;
	j674163199 [label="Marie doesn't have all the facts about what Entrati is truly capable of, and all the horrible things he has done in the name of \"progress\" and now \"redemption.\"",shape=box,color=red];
		j674163199 -> j4267164372;
	j657666092 [label="Marie is a grown woman. While I admire your desire to protect her, she can make her own decisions on what she chooses to believe and in whom she chooses to have faith.",shape=box,color=red];
		j657666092 -> j520422330;
	j2582284447 [label="Fouling our bodies, destroying our futures, corrupting our pasts - all this, perhaps I could forgive.",shape=box,color=blue];
		j2582284447 -> j2666468364;
	j1447760957 [label="Entrati might not have the best beside manner, but he's trying to save the universe.",shape=box,color=red];
		j1447760957 -> j2582284447;
	j3038637279 [label="Did he force you into becoming a protoframe, like Roathe?",shape=box,color=red];
		j3038637279 -> j2166214836;
	j4152895887 [label="Of course. Why are you upset at Entrati?",shape=box,color=red];
		j4152895887 -> j3240122672;
	j2821822155 [label="Check boolean LyonVisions1",color=orange];
		j2821822155 -> j779796940 [label=true,color=green];
		j2821822155 -> j294110515 [label=true,color=green];
		j2821822155 -> j49593869 [label=true,color=green];
		j2821822155 -> j779796940 [label=false,color=brown];
		j2821822155 -> j2207289928 [label=false,color=brown];
		j2821822155 -> j294110515 [label=false,color=brown];
	j4267164372 [label="Trust is a stained glass window. Delicate in its creation. Beautiful in its splendor. Tragic in its breaking. And dangerous once destroyed.",shape=box,color=blue];
		j4267164372 -> j4051057822;
	j520422330 [label="Trust is a stained glass window. Delicate in its creation. Beautiful in its splendor. Tragic in its breaking. And dangerous once destroyed.",shape=box,color=blue];
		j520422330 -> j312654065;
	j2666468364 [label="But to see how he has warped Marie... used her faith in the goodness of others to his own ends?",shape=box,color=blue];
		j2666468364 -> j115001877;
	j2166214836 [label="No. I had my reason for accepting the elixer. I knew what twisted creature it would make of me. As did Marie.",shape=box,color=blue];
		j2166214836 -> j1986704985;
	j779796940 [label="I guess I don't particularly care either way?",shape=box,color=red];
		j779796940 -> j1630036363;
	j294110515 [label="My only question is, if you are seeing things, do your visions bother you?",shape=box,color=red];
		j294110515 -> j3191366718;
	j49593869 [label="What you said the other day - it had me wondering if you're all right, is all.",shape=box,color=red];
		j49593869 -> j1630493712;
	j2207289928 [label="I'm just wondering if you're all right, is all.",shape=box,color=red];
		j2207289928 -> j1630493712;
	j4051057822 [label="+15 Chemistry",color=orange];
		j4051057822 -> j3747977872;
	j312654065 [label="In the warm light of Sol, she basks in its light, unable to see the faults that form upon its surface. Unable to hear the cracks that deepen.",shape=box,color=blue];
		j312654065 -> j1995218452;
	j115001877 [label="This, I shall never forgive. This, I wish to beat from his flesh with my thurible until he begs for salvation.",shape=box,color=blue];
		j115001877 -> j674163199;
		j115001877 -> j657666092;
	j1986704985 [label="We were not... forcibly broken, like the devil. Part of my heart feels for Roathe for what he has endured.",shape=box,color=blue];
		j1986704985 -> j1736150981;
	j1630036363 [label="Then I see no need to continue this conversation.",shape=box,color=blue];
		j1630036363 -> "Chat ends.";
	j3191366718 [label="I will be quite blunt in saying that I do not know how to answer that, Drifter.",shape=box,color=blue];
		j3191366718 -> j922871941;
	j1630493712 [label="Boolean LyonAllRight is now true.",color=orange];
		j1630493712 -> j223002877;
	j3747977872 [label="Would that I could take from her the corruption he had sown into her mind. I can only pray that you might succeed where I have failed.",shape=box,color=blue];
		j3747977872 -> j3545001372;
	j1995218452 [label="Unaware of the shards of her own masterpiece would soon be turned against her. Choosing to blind herself to what will inevitably follow.",shape=box,color=blue];
		j1995218452 -> j2510775929;
	j1736150981 [label="Then he opens his mouth to speak.",shape=box,color=blue];
		j1736150981 -> j4029766741;
		j1736150981 -> j4248253147;
	"Chat ends." [color=orange];
	j922871941 [label="All my years, I have seen horrors the likes of which would send others into the asylums. More tragically, now and again, my visions would come to pass.",shape=box,color=blue];
		j922871941 -> j93136146;
	j223002877 [label="Am I \"all right?\" I will be quite blunt in saying that I do not know how to answer that, Drifter.",shape=box,color=blue];
		j223002877 -> j922871941;
	j3545001372 [label="Отець Ліон Аллард",shape=box,color=blue];
		j3545001372 -> "Chat ends.";
	j2510775929 [label="Would that I could bear that suffering in her stead, how gladly I would have it tattooed into my soul. But this is for her, and her alone.",shape=box,color=blue];
		j2510775929 -> j835256781;
	j4029766741 [label="You have to remember how he was raised. The environment he had to learn to survive in. He was - is - Orokin.",shape=box,color=red];
		j4029766741 -> j3945591455;
		j4029766741 -> j2901414726;
	j4248253147 [label="I don't think he is so terrible, honestly. He is growing on me.",shape=box,color=red];
		j4248253147 -> j468227216;
	j93136146 [label="Boolean LyonVisions1 is now true.",color=orange];
		j93136146 -> j3580815831;
	j835256781 [label="So I shall seek to prevent this pain instead, Drifter. ",shape=box,color=blue];
		j835256781 -> j3214513466;
	j3945591455 [label="It doesn't make it right, but it might help you learn to meet him halfway.",shape=box,color=red];
		j3945591455 -> j3965068977;
	j2901414726 [label="He's doing what he thinks he has to.",shape=box,color=red];
		j2901414726 -> j1618396231;
	j468227216 [label="I would see M. Loid for a creme for that ailment. Lest it spread.",shape=box,color=blue];
		j468227216 -> j3110852882;
		j468227216 -> j1988170317;
	j3580815831 [label="Boolean LyonBackstory1 is now true.",color=orange];
		j3580815831 -> j3549487808;
	j3214513466 [label="And if you see in that act any attempt to make her small?",shape=box,color=blue];
		j3214513466 -> j3481500303;
	j3965068977 [label="Add 1 to Thermostat counter",color=orange];
		j3965068977 -> j2761018659;
	j1618396231 [label="Add -1 to Thermostat counter",color=orange];
		j1618396231 -> j1773166880;
	j3110852882 [label="The devil always has a certain charm about him.",shape=box,color=red];
		j3110852882 -> j3287256466;
	j1988170317 [label="Don't worry, I won't be lured in by his charm.",shape=box,color=red];
		j1988170317 -> j1775419672;
	j3549487808 [label="And as such, I thought them the guidance of Lua. That I was chosen by the Luminaries to carry such a burden. Or so I believed them at the time. Such is the reason I sought to enter the priesthood.",shape=box,color=blue];
		j3549487808 -> j763304982;
		j3549487808 -> j749443416;
		j3549487808 -> j2530999954;
	j3481500303 [label="May Lua have pity upon your soul.",shape=box,color=blue];
		j3481500303 -> j3545001372;
	j2761018659 [label="In our scripture, one does not negotiate with devils- one casts them out. But they did not prepare us for this particular condition.",shape=box,color=blue];
		j2761018659 -> j2241941977;
	j1773166880 [label="Perhaps. I am not yet certain there is no doubt in that creature's heart.",shape=box,color=blue];
		j1773166880 -> j2241941977;
	j3287256466 [label="Add -1 to Thermostat counter",color=orange];
		j3287256466 -> j1053159073;
	j1775419672 [label="Add 1 to Thermostat counter",color=orange];
		j1775419672 -> j339999859;
	j763304982 [label="You believed the visions were from Lua? You don't anymore?",shape=box,color=red];
		j763304982 -> j309931431;
	j749443416 [label="What kind of horrors...?",shape=box,color=red];
		j749443416 -> j4013347038;
	j2530999954 [label="And what do you think now?",shape=box,color=red];
		j2530999954 -> j3290163365;
	j2241941977 [label="We shall see which path that particular devil chooses to walk in due course, won't we?",shape=box,color=blue];
		j2241941977 -> j2836492483;
	j1053159073 [label="And that is what troubles me. The devil smiles and speaks sense when all others spout madness. ",shape=box,color=blue];
		j1053159073 -> j2033728772;
	j339999859 [label="+20 Chemistry",color=orange];
		j339999859 -> j1753781745;
	j309931431 [label="What I believe has become... complicated, as of late, by the introduction of new information.",shape=box,color=blue];
		j309931431 -> j3290163365;
	j4013347038 [label="We have only just begun to converse about such things, Drifter. It is not that I not believe that you have seen, first-hand, suffering of the worst order, nor do I believe you would require protection from whatever meagre descriptions I might manage to conjure.",shape=box,color=blue];
		j4013347038 -> j2652647595;
	j3290163365 [label="Quite simply, Drifter, it would be honest to say that I do not know what to believe.",shape=box,color=blue];
		j3290163365 -> j3682165470;
	j2836492483 [label="Отець Ліон Аллард",shape=box,color=blue];
		j2836492483 -> j367054140;
	j2033728772 [label="He catches us at our most unawares - when we are vulnerable. When we are weak. When we are in need of answers.",shape=box,color=blue];
		j2033728772 -> j4040959512;
		j2033728772 -> j2944425726;
	j1753781745 [label="Good. See to it that you are not. I would hate to need to beat some sense into you. You seem like the type to return fire.",shape=box,color=blue];
		j1753781745 -> j3033146792;
	j2652647595 [label="It merely exhausts me to speak of such things to someone I have only just met, only to have them never come near me again. I would rather not have this happen in a situation where we seem to be forced to work together, for the short term at the very least.",shape=box,color=blue];
		j2652647595 -> j268186794;
		j2652647595 -> j2567735953;
	j3682165470 [label="Boolean LyonFaith1 is now true.",color=orange];
		j3682165470 -> j3471701480;
	j367054140 [label="+20 Chemistry",color=orange];
		j367054140 -> "Chat ends.";
	j4040959512 [label="I can handle myself. I promise I won't let him get into my head.",shape=box,color=red];
		j4040959512 -> j119256034;
	j2944425726 [label="You seem to be speaking from experience. What answers did he give you?",shape=box,color=red];
		j2944425726 -> j3308297042;
	j3033146792 [label="And then what manner of a strange state would we find ourselves?",shape=box,color=blue];
		j3033146792 -> "Chat ends.";
	j268186794 [label="If you want to wait until you trust me more, I understand.",shape=box,color=red];
		j268186794 -> j58595429;
	j2567735953 [label="I'm not going anywhere, Lyon. You can trust me.",shape=box,color=red];
		j2567735953 -> j3634470404;
	j3471701480 [label="But I fear that is all a matter for another day.",shape=box,color=blue];
		j3471701480 -> j974434886;
	j119256034 [label="+20 Chemistry",color=orange];
		j119256034 -> j318286331;
	j3308297042 [label="Ones that I fear have... thrown a great many things into doubt. But I fear that is all a matter for another day.",shape=box,color=blue];
		j3308297042 -> j2581138328;
	j58595429 [label="+20 Chemistry",color=orange];
		j58595429 -> j2975693515;
	j3634470404 [label="+15 Chemistry",color=orange];
		j3634470404 -> j814646777;
	j974434886 [label="+20 Chemistry",color=orange];
		j974434886 -> j2946845651;
	j318286331 [label="Good. See to it that you do not. I would hate to have to beat some sense into you. You seem like the type to return fire.",shape=box,color=blue];
		j318286331 -> j3033146792;
	j2581138328 [label="Boolean LyonFaith1 is now true.",color=orange];
		j2581138328 -> j974434886;
	j2975693515 [label="Thank you. It is not that I do not believe that you are earnest in what you write. It is merely that my experience has simply taught me otherwise.",shape=box,color=blue];
		j2975693515 -> j2946845651;
	j814646777 [label="It is not that I do not believe that you are earnest in what you write. It is merely that my experience has simply taught me otherwise. ",shape=box,color=blue];
		j814646777 -> j2946845651;
	j2946845651 [label="I will have to beg your forgiveness, and your patience, in the meanwhile. ",shape=box,color=blue];
		j2946845651 -> j3545001372;
}