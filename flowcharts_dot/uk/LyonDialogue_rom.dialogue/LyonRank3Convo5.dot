digraph {
	445 [label="LyonRank3Convo5 begins.",color=orange];
		445 -> 446;
	446 [label="It was a thunderstorm the night that \"Cardinal Dimanche\" came to us. He stood in the sanctuary of the church, untouched by the gale that raged outside.",shape=box,color=blue];
		446 -> 447;
	447 [label="That should have served as my first cause for concern. Instead, I bowed my head to him and greeted him as I would any new envoy from the Holy Mother.",shape=box,color=blue];
		447 -> 448;
	448 [label="We had been expecting a new Cardinal since our last one had departed several months earlier from illness, after all.",shape=box,color=blue];
		448 -> 449;
	449 [label="Dimanche greeted me with a warm smile and a firm handshake. I asked him if his journey was long. I will never forget his reply.",shape=box,color=blue];
		449 -> 450;
	450 [label="\"It was difficult... but it was not long.\"",shape=box,color=blue];
		450 -> 451;
	451 [label="It puzzled me at the time, as did the fact that his greatcoat was bone dry. But I dismissed it, as all are wont to do when one is faced with the unusual.",shape=box,color=blue];
		451 -> 452;
	452 [label="And I did not have time to consider it, as Marie in her eagerness arrived a moment later.",shape=box,color=blue];
		452 -> 453;
	453 [label="He knelt down to greet her at her level in her chair, and took her hands in his. I should have seen the manipulation for what it was.",shape=box,color=blue];
		453 -> 454;
	454 [label="He was not the only devil to arrive on our doorstep in a storm, after all.",shape=box,color=blue];
		454 -> 455;
	455 [label="Update boolean LyonEntrati1",color=orange];
		455 -> 456;
	456 [label="Check boolean MarieEntrati1",color=orange];
		456 -> 457 [label=true,color=green];
		456 -> 459 [label=true,color=green];
		456 -> 460 [label=true,color=green];
		456 -> 458 [label=false,color=brown];
		456 -> 457 [label=false,color=brown];
	457 [label="The other devil being Roathe?",shape=box,color=red];
		457 -> 461;
	459 [label="She tells this story very differently.",shape=box,color=red];
		459 -> 463;
	460 [label="She still believe in his good intentions. Do you?",shape=box,color=red];
		460 -> 464;
	458 [label="I take it you aren't an ally of Entrati?",shape=box,color=red];
		458 -> 462;
	461 [label="Yes. But that is a tale for another day. If I begin speaking of him, my already foul mood will become... ",shape=box,color=blue];
		461 -> 465;
	463 [label="Yes. She would.",shape=box,color=blue];
		463 -> 467;
		463 -> 468;
	464 [label="+5 Chemistry",color=orange];
		464 -> 469;
	462 [label="After enduring his lies and betrayal, and while we continue to suffer his manipulation of Marie, would you have me be? No, I most certainly am not.",shape=box,color=blue];
		462 -> 466;
	465 [label="...untenable. I would much rather focus my current mood upon Entrati's misdeeds, if it is all the same to you.",shape=box,color=blue];
		465 -> 470;
	467 [label="She tells me that you see things that others don't, sometimes.",shape=box,color=red];
		467 -> 472;
	468 [label="And? ",shape=box,color=red];
		468 -> 473;
	469 [label="Marie believes the best in all souls. It is a skill she has honed and perfected and polished as a shield against the world around her.",shape=box,color=blue];
		469 -> 474;
		469 -> 475;
	466 [label="+5 Chemistry",color=orange];
		466 -> 471;
	470 [label="Check boolean RoatheSerum1",color=orange];
		470 -> 476 [label=true,color=green];
		470 -> 477 [label=true,color=green];
		470 -> 476 [label=false,color=brown];
		470 -> 478 [label=false,color=brown];
	472 [label="And what would you make of that statement, were it to be true, Drifter?",shape=box,color=blue];
		472 -> 480;
	473 [label="\"And,\" nothing. I have told you how I witnessed the event, as the truth of my experience of it. Nothing more.",shape=box,color=blue];
		473 -> 469;
	474 [label="Marie doesn't have all the facts about what Entrati is truly capable of, and all the horrible things he has done in the name of \"progress\" and now \"redemption.\"",shape=box,color=red];
		474 -> 481;
	475 [label="Marie is a grown woman. While I admire your desire to protect her, she can make her own decisions on what she chooses to believe and in whom she chooses to have faith.",shape=box,color=red];
		475 -> 482;
	471 [label="Fouling our bodies, destroying our futures, corrupting our pasts - all this, perhaps I could forgive.",shape=box,color=blue];
		471 -> 479;
	476 [label="Entrati might not have the best beside manner, but he's trying to save the universe.",shape=box,color=red];
		476 -> 471;
	477 [label="Did he force you into becoming a protoframe, like Roathe?",shape=box,color=red];
		477 -> 483;
	478 [label="Of course. Why are you upset at Entrati?",shape=box,color=red];
		478 -> 484;
	480 [label="Check boolean LyonVisions1",color=orange];
		480 -> 486 [label=true,color=green];
		480 -> 488 [label=true,color=green];
		480 -> 489 [label=true,color=green];
		480 -> 486 [label=false,color=brown];
		480 -> 487 [label=false,color=brown];
		480 -> 488 [label=false,color=brown];
	481 [label="Trust is a stained glass window. Delicate in its creation. Beautiful in its splendor. Tragic in its breaking. And dangerous once destroyed.",shape=box,color=blue];
		481 -> 496;
	482 [label="Trust is a stained glass window. Delicate in its creation. Beautiful in its splendor. Tragic in its breaking. And dangerous once destroyed.",shape=box,color=blue];
		482 -> 491;
	479 [label="But to see how he has warped Marie... used her faith in the goodness of others to his own ends?",shape=box,color=blue];
		479 -> 485;
	483 [label="No. I had my reason for accepting the elixer. I knew what twisted creature it would make of me. As did Marie.",shape=box,color=blue];
		483 -> 492;
	484 [label="+5 Chemistry",color=orange];
		484 -> 471;
	486 [label="I guess I don't particularly care either way?",shape=box,color=red];
		486 -> 493;
	488 [label="My only question is, if you are seeing things, do your visions bother you?",shape=box,color=red];
		488 -> 495;
	489 [label="What you said the other day - it had me wondering if you're all right, is all.",shape=box,color=red];
		489 -> 494;
	487 [label="I'm just wondering if you're all right, is all.",shape=box,color=red];
		487 -> 494;
	496 [label="+15 Chemistry",color=orange];
		496 -> 502;
	491 [label="In the warm light of Sol, she basks in its light, unable to see the faults that form upon its surface. Unable to hear the cracks that deepen.",shape=box,color=blue];
		491 -> 497;
	485 [label="This, I shall never forgive. This, I wish to beat from his flesh with my thurible until he begs for salvation.",shape=box,color=blue];
		485 -> 474;
		485 -> 475;
	492 [label="We were not... forcibly broken, like the devil. Part of my heart feels for Roathe for what he has endured.",shape=box,color=blue];
		492 -> 498;
	493 [label="Then I see no need to continue this conversation.",shape=box,color=blue];
		493 -> 499;
	495 [label="I will be quite blunt in saying that I do not know how to answer that, Drifter.",shape=box,color=blue];
		495 -> 501;
	494 [label="Update boolean LyonAllRight",color=orange];
		494 -> 500;
	502 [label="Would that I could take from her the corruption he had sown into her mind. I can only pray that you might succeed where I have failed.",shape=box,color=blue];
		502 -> 507;
	497 [label="Unaware of the shards of her own masterpiece would soon be turned against her. Choosing to blind herself to what will inevitably follow.",shape=box,color=blue];
		497 -> 503;
	498 [label="Then he opens his mouth to speak.",shape=box,color=blue];
		498 -> 504;
		498 -> 505;
	499 [label="Chat ends.",color=orange];
	501 [label="All my years, I have seen horrors the likes of which would send others into the asylums. More tragically, now and again, my visions would come to pass.",shape=box,color=blue];
		501 -> 506;
	500 [label="Am I \"all right?\" I will be quite blunt in saying that I do not know how to answer that, Drifter.",shape=box,color=blue];
		500 -> 501;
	507 [label="Отець Ліон Аллард",shape=box,color=blue];
		507 -> 513;
	503 [label="Would that I could bear that suffering in her stead, how gladly I would have it tattooed into my soul. But this is for her, and her alone.",shape=box,color=blue];
		503 -> 508;
	504 [label="You have to remember how he was raised. The environment he had to learn to survive in. He was - is - Orokin.",shape=box,color=red];
		504 -> 509;
		504 -> 510;
	505 [label="I don't think he is so terrible, honestly. He is growing on me.",shape=box,color=red];
		505 -> 511;
	506 [label="Update boolean LyonVisions1",color=orange];
		506 -> 512;
	513 [label="Chat ends.",color=orange];
	508 [label="So I shall seek to prevent this pain instead, Drifter. ",shape=box,color=blue];
		508 -> 514;
	509 [label="It doesn't make it right, but it might help you learn to meet him halfway.",shape=box,color=red];
		509 -> 515;
	510 [label="He's doing what he thinks he has to.",shape=box,color=red];
		510 -> 516;
	511 [label="I would see M. Loid for a creme for that ailment. Lest it spread.",shape=box,color=blue];
		511 -> 517;
		511 -> 518;
	512 [label="Update boolean LyonBackstory1",color=orange];
		512 -> 519;
	514 [label="And if you see in that act any attempt to make her small?",shape=box,color=blue];
		514 -> 520;
	515 [label="Add 1 to Thermostat",color=orange];
		515 -> 521;
	516 [label="Add -1 to Thermostat",color=orange];
		516 -> 522;
	517 [label="The devil always has a certain charm about him.",shape=box,color=red];
		517 -> 523;
	518 [label="Don't worry, I won't be lured in by his charm.",shape=box,color=red];
		518 -> 524;
	519 [label="And as such, I thought them the guidance of Lua. That I was chosen by the Luminaries to carry such a burden. Or so I believed them at the time. Such is the reason I sought to enter the priesthood.",shape=box,color=blue];
		519 -> 525;
		519 -> 526;
		519 -> 527;
	520 [label="May Lua have pity upon your soul.",shape=box,color=blue];
		520 -> 528;
	521 [label="In our scripture, one does not negotiate with devils- one casts them out. But they did not prepare us for this particular condition.",shape=box,color=blue];
		521 -> 529;
	522 [label="Perhaps. I am not yet certain there is no doubt in that creature's heart.",shape=box,color=blue];
		522 -> 529;
	523 [label="Add -1 to Thermostat",color=orange];
		523 -> 530;
	524 [label="Add 1 to Thermostat",color=orange];
		524 -> 531;
	525 [label="You believed the visions were from Lua? You don't anymore?",shape=box,color=red];
		525 -> 532;
	526 [label="What kind of horrors...?",shape=box,color=red];
		526 -> 533;
	527 [label="And what do you think now?",shape=box,color=red];
		527 -> 534;
	528 [label="Отець Ліон Аллард",shape=box,color=blue];
		528 -> 535;
	529 [label="We shall see which path that particular devil chooses to walk in due course, won't we?",shape=box,color=blue];
		529 -> 536;
	530 [label="And that is what troubles me. The devil smiles and speaks sense when all others spout madness. ",shape=box,color=blue];
		530 -> 537;
	531 [label="+20 Chemistry",color=orange];
		531 -> 538;
	532 [label="What I believe has become... complicated, as of late, by the introduction of new information.",shape=box,color=blue];
		532 -> 534;
	533 [label="We have only just begun to converse about such things, Drifter. It is not that I not believe that you have seen, first-hand, suffering of the worst order, nor do I believe you would require protection from whatever meagre descriptions I might manage to conjure.",shape=box,color=blue];
		533 -> 539;
	534 [label="Quite simply, Drifter, it would be honest to say that I do not know what to believe.",shape=box,color=blue];
		534 -> 540;
	535 [label="Chat ends.",color=orange];
	536 [label="Отець Ліон Аллард",shape=box,color=blue];
		536 -> 541;
	537 [label="He catches us at our most unawares - when we are vulnerable. When we are weak. When we are in need of answers.",shape=box,color=blue];
		537 -> 542;
		537 -> 543;
	538 [label="Good. See to it that you are not. I would hate to need to beat some sense into you. You seem like the type to return fire.",shape=box,color=blue];
		538 -> 544;
	539 [label="It merely exhausts me to speak of such things to someone I have only just met, only to have them never come near me again. I would rather not have this happen in a situation where we seem to be forced to work together, for the short term at the very least.",shape=box,color=blue];
		539 -> 545;
		539 -> 546;
	540 [label="Update boolean LyonFaith1",color=orange];
		540 -> 547;
	541 [label="+20 Chemistry",color=orange];
		541 -> 548;
	542 [label="I can handle myself. I promise I won't let him get into my head.",shape=box,color=red];
		542 -> 549;
	543 [label="You seem to be speaking from experience. What answers did he give you?",shape=box,color=red];
		543 -> 550;
	544 [label="And then what manner of a strange state would we find ourselves?",shape=box,color=blue];
		544 -> 551;
	545 [label="If you want to wait until you trust me more, I understand.",shape=box,color=red];
		545 -> 552;
	546 [label="I'm not going anywhere, Lyon. You can trust me.",shape=box,color=red];
		546 -> 553;
	547 [label="But I fear that is all a matter for another day.",shape=box,color=blue];
		547 -> 554;
	548 [label="Chat ends.",color=orange];
