digraph {
	"LyonRank3Convo5 begins." [color=orange];
		"LyonRank3Convo5 begins." -> j3827815292;
	j3827815292 [label="У ніч, коли «кардинал Діманш» заявився до нас, вирувала люта буря. Він стояв посеред святилища в церкві, геть сухий попри погоду надворі.",shape=box,color=blue];
		j3827815292 -> j958857366;
	j958857366 [label="Це перше, що мало б мене насторожити. Натомість я схилив голову та привітав, як будь-якого нового посланця від Святої Матері.",shape=box,color=blue];
		j958857366 -> j387049817;
	j387049817 [label="Зрештою, ми очікували прибуття нового кардинала, оскільки наш кілька місяців тому відійшов після тяжкої хвороби.",shape=box,color=blue];
		j387049817 -> j1785449762;
	j1785449762 [label="Діманш привітав мене теплою усмішкою й твердим рукостисканням. Я спитав, чи довгою та стомливою була його подорож. Ніколи не забуду тієї відповіді.",shape=box,color=blue];
		j1785449762 -> j1003033423;
	j1003033423 [label="«Було складно… але не довго».",shape=box,color=blue];
		j1003033423 -> j1285017068;
	j1285017068 [label="Тоді це дуже здивувало мене, як і те, що пальто його було геть сухим. Але розумі відкинув це, як щось не варте уваги, коли стикаєшся з чимось надміру надзвичайним.",shape=box,color=blue];
		j1285017068 -> j1334172612;
	j1334172612 [label="Та я й не встиг усе обміркувати — Марі у своїй нетерплячості за мить була вже тут.",shape=box,color=blue];
		j1334172612 -> j3479044131;
	j3479044131 [label="Він став навколішки, щоби привітатися з нею. Щоби бути на рівні її візка. Узяв її руки своїми. Я мав побачити, що це були маніпулятивні дії.",shape=box,color=blue];
		j3479044131 -> j2497819542;
	j2497819542 [label="Однак він був не єдиним дияволом, що прибув до нас посеред бурі.",shape=box,color=blue];
		j2497819542 -> j1928339452;
	j1928339452 [label="Boolean LyonEntrati1 is now true.",color=orange];
		j1928339452 -> j2100050873;
	j2100050873 [label="Check boolean MarieEntrati1",color=orange];
		j2100050873 -> j1374487775 [label=true,color=green];
		j2100050873 -> j1876369921 [label=true,color=green];
		j2100050873 -> j4151960705 [label=true,color=green];
		j2100050873 -> j1302370812 [label=false,color=brown];
		j2100050873 -> j1374487775 [label=false,color=brown];
	j1374487775 [label="Іншим дияволом був Роут?",shape=box,color=red];
		j1374487775 -> j2426957223;
	j1876369921 [label="Вона геть інакше оповідає цю історію.",shape=box,color=red];
		j1876369921 -> j3614604964;
	j4151960705 [label="Вона досі вірить у його добрі наміри. А ти?",shape=box,color=red];
		j4151960705 -> j3122486807;
	j1302370812 [label="То ти, виходить, не симпатизуєш Ентраті?",shape=box,color=red];
		j1302370812 -> j653797893;
	j2426957223 [label="Так. Але це історія для іншого дня. Якщо я почну говорити про нього, то мій і так паскудний настрій стане… ",shape=box,color=blue];
		j2426957223 -> j1029932304;
	j3614604964 [label="Так. Аякже.",shape=box,color=blue];
		j3614604964 -> j319063499;
		j3614604964 -> j1525383983;
	j3122486807 [label="+5 Chemistry",color=orange];
		j3122486807 -> j1283032117;
	j653797893 [label="Настраждався від його брехні та зради. Продовжую потерпати від наслідків його маніпуляцій з Марі… Чому б це мені симпатизувати йому? Ні, я точно не за нього.",shape=box,color=blue];
		j653797893 -> j1252783146;
	j1029932304 [label="нестерпним. Я ліпше волію зосередити свій поточний настрій на провинах Ентраті, якщо тобі це однаково.",shape=box,color=blue];
		j1029932304 -> j1428371468;
	j319063499 [label="Вона мені писала, що іноді ти бачиш речі, які не бачать інші.",shape=box,color=red];
		j319063499 -> j2570567384;
	j1525383983 [label="І? ",shape=box,color=red];
		j1525383983 -> j3477322766;
	j1283032117 [label="Марі вірить у все найліпше в будь-якій душі. Це вміння вона плекала й удосконалювала та полірувала, перетворивши на щит супроти світу довкола неї.",shape=box,color=blue];
		j1283032117 -> j1580231368;
		j1283032117 -> j2125238520;
	j1252783146 [label="+5 Chemistry",color=orange];
		j1252783146 -> j2792881708;
	j1428371468 [label="Check boolean RoatheSerum1",color=orange];
		j1428371468 -> j3530683256 [label=true,color=green];
		j1428371468 -> j641797925 [label=true,color=green];
		j1428371468 -> j3530683256 [label=false,color=brown];
		j1428371468 -> j3048830441 [label=false,color=brown];
	j2570567384 [label="І що ти зробиш із цим твердженням, мандрівниче, якби воно було правдивим?",shape=box,color=blue];
		j2570567384 -> j2821822155;
	j3477322766 [label="«І» нічого. Я розповів тобі про те, як був свідком події, моя істина ґрунтується на моєму досвіді. І ні на чому іншому.",shape=box,color=blue];
		j3477322766 -> j1283032117;
	j1580231368 [label="Марі не знає всього про те, на що насправді здатен Ентраті. Як і про ті всі жахіття, які він чинив в ім’я «прогресу», а тепер «спокути».",shape=box,color=red];
		j1580231368 -> j225241928;
	j2125238520 [label="Марі — доросла жінка. Я шаную твоє прагнення захистити її, але вона здатна приймати власні рішення, відповідно до того в що бажає вірити. І в кого.",shape=box,color=red];
		j2125238520 -> j2048974956;
	j2792881708 [label="Плюндрування наших тіл, нищення нашого майбутнього, паплюження минулого — це все я можу пробачити, мабуть.",shape=box,color=blue];
		j2792881708 -> j3720310651;
	j3530683256 [label="Може в Ентраті й не найліпші манери, але він намагається врятувати всесвіт.",shape=box,color=red];
		j3530683256 -> j2792881708;
	j641797925 [label="Він примусом зробив тебе протофреймом? Як і Роута?",shape=box,color=red];
		j641797925 -> j1303335452;
	j3048830441 [label="Звісно. А чому ти недолюблюєш Ентраті?",shape=box,color=red];
		j3048830441 -> j1252783146;
	j2821822155 [label="Check boolean LyonVisions1",color=orange];
		j2821822155 -> j3763151562 [label=true,color=green];
		j2821822155 -> j3079300271 [label=true,color=green];
		j2821822155 -> j1500894371 [label=true,color=green];
		j2821822155 -> j3763151562 [label=false,color=brown];
		j2821822155 -> j1793770924 [label=false,color=brown];
		j2821822155 -> j3079300271 [label=false,color=brown];
	j225241928 [label="Довіра — вітраж. Тендітна у створенні. Прекрасна в дивовижі. Трагічна у руйнації. І небезпечна після знищення.",shape=box,color=blue];
		j225241928 -> j1983258908;
	j2048974956 [label="Довіра — вітраж. Тендітна у створенні. Прекрасна в дивовижі. Трагічна в руйнації. І небезпечна після знищення.",shape=box,color=blue];
		j2048974956 -> j153930252;
	j3720310651 [label="Але бачити те, як він спотворив Марі… використав її віру в доброту інших задля свого власного плану?",shape=box,color=blue];
		j3720310651 -> j1913425823;
	j1303335452 [label="Ні. У мене були причини, щоб випити сироватку. Я знав, який покруч з мене вийде. Як і Марі.",shape=box,color=blue];
		j1303335452 -> j1262848769;
	j3763151562 [label="Думаю, що мені взагалі абсолютно по цимбалах.",shape=box,color=red];
		j3763151562 -> j3798939244;
	j3079300271 [label="У мене лише одне питання, якщо ти бачиш щось. Ці видіння турбують тебе?",shape=box,color=red];
		j3079300271 -> j3452553154;
	j1500894371 [label="Дещо з твоїх нещодавніх слів просто змусило мене замислитися, чи з тобою все гаразд. От і все.",shape=box,color=red];
		j1500894371 -> j2495957626;
	j1793770924 [label="Мені просто хотілося знати, чи з тобою все гаразд. От і все.",shape=box,color=red];
		j1793770924 -> j2495957626;
	j1983258908 [label="+15 Chemistry",color=orange];
		j1983258908 -> j2776393145;
	j153930252 [label="У теплому світлі Сола вона купається в його променях, не маючи змоги побачити вири на його поверхні. Не може почути хрускіт заглиблення ущелин.",shape=box,color=blue];
		j153930252 -> j622156277;
	j1913425823 [label="Це я ніколи не пробачу. За це я хочу лупити його кадилом, аж допоки не благатиме змилостивитися.",shape=box,color=blue];
		j1913425823 -> j1580231368;
		j1913425823 -> j2125238520;
	j1262848769 [label="Ми не… нас не насильно ламали. Не як диявола. Частина мого серця співчуває Роуту в його стражданнях.",shape=box,color=blue];
		j1262848769 -> j4067108470;
	j3798939244 [label="Тоді в мені нема потреби продовжувати цю розмову.",shape=box,color=blue];
		j3798939244 -> "Chat ends.";
	j3452553154 [label="Мандрівниче. З небаченою досі відвертістю скажу тобі, що не знаю, як відповісти на це питання.",shape=box,color=blue];
		j3452553154 -> j1959656049;
	j2495957626 [label="Boolean LyonAllRight is now true.",color=orange];
		j2495957626 -> j251682241;
	j2776393145 [label="Якби ж мені стало сил позбути її того сум’яття, що він посіяв у її свідомості. Я можу лише молитися про те, що тобі вдасться досягти успіху, де мене спіткала невдача.",shape=box,color=blue];
		j2776393145 -> j3545001372;
	j622156277 [label="Навіть не підозрює, що уламки її власного шедевра невдовзі ранитимуть її саму. Сама обрала бути сліпою до неминучих прийдешніх подій.",shape=box,color=blue];
		j622156277 -> j1196548039;
	j4067108470 [label="А потім він роззявляє пащеку й верзе свої єретичні блюзнірства.",shape=box,color=blue];
		j4067108470 -> j772383374;
		j4067108470 -> j1832867272;
	"Chat ends." [color=orange];
	j1959656049 [label="За своє життя я бачив такі жахіття, які інших доправили б до закладів лікування душевнохворих. А що додає гіркоти й трагедії тоді й зараз — мої видіння іноді втілюються в життя.",shape=box,color=blue];
		j1959656049 -> j4009957482;
	j251682241 [label="Чи зі мною «все гаразд»? Мандрівниче. З небаченою досі відвертістю скажу тобі, що не знаю, як відповісти на це питання.",shape=box,color=blue];
		j251682241 -> j1959656049;
	j3545001372 [label="Отець Ліон Аллард",shape=box,color=blue];
		j3545001372 -> "Chat ends.";
	j1196548039 [label="Якби ж то мені замість неї терпіти ці страждання, то з якою б радістю я витатуював це на своїй душі. Однак вони лише для неї.",shape=box,color=blue];
		j1196548039 -> j964434953;
	j772383374 [label="Не варто забувати про те, як він виріс. Про оточення, у якому вчився виживати. Він був (і є) орокіном.",shape=box,color=red];
		j772383374 -> j2478174433;
		j772383374 -> j34567863;
	j1832867272 [label="Знаєш. Чесно кажучи, не думаю, що він такий вже й жахливий. З кожним днем подобається мені дедалі більше.",shape=box,color=red];
		j1832867272 -> j3679016411;
	j4009957482 [label="Boolean LyonVisions1 is now true.",color=orange];
		j4009957482 -> j3672350459;
	j964434953 [label="Тож, мандрівниче, я всіма силами намагаюся запобігти цьому болю. ",shape=box,color=blue];
		j964434953 -> j1647757355;
	j2478174433 [label="Це не виправдовує його, але може допомогти навчитися йти йому назустріч у розумінні.",shape=box,color=red];
		j2478174433 -> j3775044447;
	j34567863 [label="Він робить те, що, як вважає, має робити.",shape=box,color=red];
		j34567863 -> j3005970254;
	j3679016411 [label="Я б на твоєму місці навідався до пана Лойда за мікстурою від цієї недуги. Щоб вона не поширювалася.",shape=box,color=blue];
		j3679016411 -> j2077727454;
		j3679016411 -> j3795717835;
	j3672350459 [label="Boolean LyonBackstory1 is now true.",color=orange];
		j3672350459 -> j3364394528;
	j1647757355 [label="І якщо ти в цьому бачиш хоч натяк на спробу принизити її…",shape=box,color=blue];
		j1647757355 -> j2706690811;
	j3775044447 [label="Add 1 to Thermostat counter",color=orange];
		j3775044447 -> j263952549;
	j3005970254 [label="Add -1 to Thermostat counter",color=orange];
		j3005970254 -> j870262828;
	j2077727454 [label="У диявола завжди є деякий спокусливий шарм.",shape=box,color=red];
		j2077727454 -> j3863681791;
	j3795717835 [label="Не переживай, я не потраплю в його спокусливі тенета.",shape=box,color=red];
		j3795717835 -> j1432887616;
	j3364394528 [label="Тому я вважав їх провидінням й настановами від Луа. Уважав себе обраним Світочами для цього тягаря. Або деякий час вірив у це. Саме й тому я прагнув стати священником.",shape=box,color=blue];
		j3364394528 -> j2443501980;
		j3364394528 -> j127318767;
		j3364394528 -> j2091709234;
	j2706690811 [label="Нехай Луа змилостивиться над твоєю занепалою душею.",shape=box,color=blue];
		j2706690811 -> j3545001372;
	j263952549 [label="У нашому писанні з дияволами не ведуть бесід — ми виганяємо й проганяємо їх. Але нас не підготували до такої особливої ситуації.",shape=box,color=blue];
		j263952549 -> j1651946969;
	j870262828 [label="Може й так. Я не впевнений у тому, що серце цієї істоти не має сумнівів.",shape=box,color=blue];
		j870262828 -> j1651946969;
	j3863681791 [label="Add -1 to Thermostat counter",color=orange];
		j3863681791 -> j2200598648;
	j1432887616 [label="Add 1 to Thermostat counter",color=orange];
		j1432887616 -> j963747674;
	j2443501980 [label="Ти вірив, що видіння йшли від Луа? А тепер не віриш?",shape=box,color=red];
		j2443501980 -> j1409944409;
	j127318767 [label="Які жахіття?..",shape=box,color=red];
		j127318767 -> j2493716705;
	j2091709234 [label="А що про це думаєш зараз?",shape=box,color=red];
		j2091709234 -> j937307572;
	j1651946969 [label="Ми побачимо, який шлях обере цей особливий диявол у своїй подорожі, чи не так?",shape=box,color=blue];
		j1651946969 -> j2836492483;
	j2200598648 [label="Саме це й непокоїть мене. Диявол усміхається й говорить розумні речі, коли всі інші вивергають зі свого нутра божевілля. ",shape=box,color=blue];
		j2200598648 -> j2956168439;
	j963747674 [label="+20 Chemistry",color=orange];
		j963747674 -> j2666522529;
	j1409944409 [label="Те, у що я вірив… останнім часом стало складним. Ускладнилося через пізнання нової інформації.",shape=box,color=blue];
		j1409944409 -> j937307572;
	j2493716705 [label="Мандрівниче, ми лише почали спілкуватися на такі теми. Не те щоб мені не йнялося віри в те, що тобі довелося бачити на власні очі страждання найвищого ґатунку. І я не думаю, що тобі потрібен захист від будь-яких лячних описів, які б я міг вигадати.",shape=box,color=blue];
		j2493716705 -> j2898497469;
	j937307572 [label="Мандрівниче, усе дуже просто. Чесніше буде написати, що я вже не знаю, у що вірити.",shape=box,color=blue];
		j937307572 -> j1430119571;
	j2836492483 [label="Отець Ліон Аллард",shape=box,color=blue];
		j2836492483 -> j367054140;
	j2956168439 [label="Він піймав нас у найнесподіванішу мить… у мить вразливості. Слабкості. У мить розгубленості й потреби відповідей.",shape=box,color=blue];
		j2956168439 -> j3321123656;
		j2956168439 -> j2421283513;
	j2666522529 [label="Добре. Мене це радує. Не хотілося б ударами приводити тебе до тями. Бо ти наче з тих, хто не підставляє другу щоку, а повертає біль сторицею.",shape=box,color=blue];
		j2666522529 -> j1772175941;
	j2898497469 [label="Знаєш, як виснажливо вести подібні бесіди з новими людьми, щоби потім вони навіть і не дивилися в мій бік? Я б не волів, щоб це сталося між нами, бо, схоже, ми змушені певний час щонайменше працювати разом.",shape=box,color=blue];
		j2898497469 -> j3748010065;
		j2898497469 -> j2837706770;
	j1430119571 [label="Boolean LyonFaith1 is now true.",color=orange];
		j1430119571 -> j1047147615;
	j367054140 [label="+20 Chemistry",color=orange];
		j367054140 -> "Chat ends.";
	j3321123656 [label="Я впораюся. Обіцяю, що не дозволю залізти собі в голову.",shape=box,color=red];
		j3321123656 -> j617155458;
	j2421283513 [label="Схоже, ти говориш із власного досвіду. Які відповіді він тобі дав?",shape=box,color=red];
		j2421283513 -> j2652440131;
	j1772175941 [label="І до якого ж дивного стану це може призвести тоді?",shape=box,color=blue];
		j1772175941 -> "Chat ends.";
	j3748010065 [label="Я розумію, якщо ти хочеш почекати, поки не почнеш довіряти мені більше.",shape=box,color=red];
