	j4161975480 [label="Гм, що ж. Мені видається, що починаю розуміти, що і як сталося.",shape=box,color=blue];
		j4161975480 -> "Chat ends.";
	j3900359341 [label="О, якби ж тобі почути мій регіт зараз. Я не засуджую. Насправді я співчуваю більше, аніж можеш уявити. І саме тому хочу допомогти тобі.",shape=box,color=blue];
