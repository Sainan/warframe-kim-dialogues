		j1461648359 -> j4161975480;
	j1963628065 [label="Знаєш, я думаю, що це хтось із пацюків моєї подруги заснув на клавіатурі й надрукував якісь випадкові слова. Бо я пишу ліпше.",shape=box,color=red];
