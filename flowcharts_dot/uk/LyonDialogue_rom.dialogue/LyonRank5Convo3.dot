digraph {
	"LyonRank5Convo3 begins." [color=orange];
		"LyonRank5Convo3 begins." -> j410090499;
	j410090499 [label="Evaluate expressions",color=orange];
		j410090499 -> j4229507800 [label="LyonDating",color=purple];
		j410090499 -> j3763652076 [label="LyonConvession1",color=purple];
		j410090499 -> j3763652076 [label="LyonRell2a",color=purple];
		j410090499 -> j3763652076 [label="LyonRell2b",color=purple];
		j410090499 -> j3763652076 [label="LyonRell1",color=purple];
		j410090499 -> "Chat ends." [label="false",color=purple];
	j4229507800 [label="I am not proud of this, but I have imbibed an entire bottle of wine and I am now ready to tell you all the rest of what I have been desperately trying not to, mon miracle...",shape=box,color=blue];
		j4229507800 -> j5384825;
	j3763652076 [label="I am not proud of this, but I have imbibed an entire bottle of wine and I am now ready to tell you all the rest of what I have been desperately trying not to...",shape=box,color=blue];
		j3763652076 -> j5384825;
	"Chat ends." [color=orange];
	j5384825 [label="If what this bottle is, indeed, wine, as it was not precisely labeled - and M. Loid was not exactly sure that what we had in my day and what he would know as wine are the same thing.",shape=box,color=blue];
		j5384825 -> j2981653517;
	j2981653517 [label="I did not intend to drink the whole bottle, in my defense... but I was attempting to discern if it was in fact the same substance and then it was gone...",shape=box,color=blue];
		j2981653517 -> j1409645932;
		j2981653517 -> j3783546926;
		j2981653517 -> j579246623;
	j1409645932 [label="No. I'm not doing this.",shape=box,color=red];
		j1409645932 -> j3666629067;
	j3783546926 [label="Does it taste the same?",shape=box,color=red];
		j3783546926 -> j3412286947;
	j579246623 [label="Are you drunk?",shape=box,color=red];
		j579246623 -> j1249126421;
	j3666629067 [label="Would that I could escape so easily. I do not blame you.",shape=box,color=blue];
		j3666629067 -> j3856020424;
	j3412286947 [label="I do not know! That was the most frustrating part of the entire thing! But that is not the point. The point was to get drunk. And I do not even know if I am that, either. I am certainly not sober, however -",shape=box,color=blue];
		j3412286947 -> j403462524;
	j1249126421 [label="Potentially. I am certainly not what they would consider sober by any means.",shape=box,color=blue];
		j1249126421 -> j355343490;
	j3856020424 [label="Boolean LyonConfessionFail is now true.",color=orange];
		j3856020424 -> "Chat ends.";
	j403462524 [label="So I suppose that will have to be good enough.",shape=box,color=blue];
		j403462524 -> j3641682617;
		j403462524 -> j1718245102;
	j355343490 [label="Which was entirely the purpose of this entire endeavor. So I suppose that will have to be good enough.",shape=box,color=blue];
		j355343490 -> j3641682617;
		j355343490 -> j1718245102;
	j3641682617 [label="What is so terrible that you have to get drunk to tell me about it?",shape=box,color=red];
		j3641682617 -> j3375269506;
	j1718245102 [label="I'm ready when you are...",shape=box,color=red];
		j1718245102 -> j3375269506;
	j3375269506 [label="Rap... tap... tap...",shape=box,color=blue];
		j3375269506 -> j1483613273;
		j3375269506 -> j853149685;
	j1483613273 [label="... Oh.",shape=box,color=red];
		j1483613273 -> j2064845869;
	j853149685 [label="That would do it.",shape=box,color=red];
		j853149685 -> j2064845869;
	j2064845869 [label="I know for certain that they were not there within my mind my entire life. The Tenno known as Rell and his guardian Harrow. It is not possible that they were within the walls of my childhood home.",shape=box,color=blue];
		j2064845869 -> j222537682;
	j222537682 [label="There is no possible way that they echoed within my mind with the whispered, garbled voices of my visions all my years. Yet I see them there, hear him there, in my memories, all the same.",shape=box,color=blue];
		j222537682 -> j252073137;
	j252073137 [label="Check boolean LyonTime1",color=orange];
		j252073137 -> j3497839248 [label=true,color=green];
		j252073137 -> j2653478422 [label=false,color=brown];
	j3497839248 [label="I understood all that Entrati said of how energy could exist in time in several places at once in a philosophical sense. But I did not understand it emotionally until I... injected the serum.",shape=box,color=blue];
		j3497839248 -> j126244150;
	j2653478422 [label="It is as though the moment I injected the serum - all things became one. When Entrati revealed himself, and all the truth of his existence - ",shape=box,color=blue];
		j2653478422 -> j3721294452;
	j126244150 [label="I see sometimes in my mind's eye a great and shallow still lake that stretches out in all directions. Black and smooth, like an onyx scrying mirror.",shape=box,color=blue];
		j126244150 -> j4282723925;
	j3721294452 [label="He laid out to me all that he knew of \"quantum entanglement,\" \"superposition,\" \"eternalism,\" and the like.",shape=box,color=blue];
		j3721294452 -> j3319536082;
	j4282723925 [label="A great black lake that flows out in infinity. Impossible to comprehend.",shape=box,color=blue];
		j4282723925 -> j2461632350;
	j3319536082 [label="I understood it all in a scientific, rather philosophical sense. But I did not understand it emotionally until... I injected the serum.",shape=box,color=blue];
		j3319536082 -> j126244150;
	j2461632350 [label="And that is where I would find them. That is where we would meet. And that is where I would feel Them as well...",shape=box,color=blue];
		j2461632350 -> j911845553;
	j911845553 [label="Them?",shape=box,color=red];
		j911845553 -> j3835309935;
	j3835309935 [label="The other Harrows... Empty statues of things, echoes of echoes of echoes... They go on and on and on for all eternity in all directions...",shape=box,color=blue];
		j3835309935 -> j1397478560;
	j1397478560 [label="Rell placed himself inside of one. Lost himself inside of it. And by doing so, lost himself inside all of them...",shape=box,color=blue];
		j1397478560 -> j1699068891;
	j1699068891 [label="Including me. Including the Harrow that was in the serum that made me.",shape=box,color=blue];
		j1699068891 -> j406625830;
		j1699068891 -> j1786789681;
	j406625830 [label="Void, I didn't even realize...",shape=box,color=red];
		j406625830 -> j2680889014;
	j1786789681 [label="Oh no -",shape=box,color=red];
		j1786789681 -> j2680889014;
	j2680889014 [label="They were there with me, in my mind - Rell and his Harrow, so very much like me, and yet so very different.",shape=box,color=blue];
		j2680889014 -> j1298659491;
	j1298659491 [label="He was unafraid. He was so very certain. Two things I was very much not.",shape=box,color=blue];
		j1298659491 -> j1428085700;
	j1428085700 [label="He stood fast against the Indifference, cared not for what it was or was not. Simply knew what needed to be done.",shape=box,color=blue];
		j1428085700 -> j1543016219;
	j1543016219 [label="Even after all the cruelty he suffered. For all those years, in the \"now\" and the \"then\" of that eternity, of the moment I injected the serum... of the \"before\" and the \"after,\" he was there.",shape=box,color=blue];
		j1543016219 -> j679264469;
	j679264469 [label="He was my friend. He was my brother.",shape=box,color=blue];
		j679264469 -> j3746702889;
	j3746702889 [label="Then? In the now?",shape=box,color=blue];
		j3746702889 -> j2581056844;
	j2581056844 [label="I can sense him no more.",shape=box,color=blue];
		j2581056844 -> j1548861044;
		j2581056844 -> j1119692685;
	j1548861044 [label="He... he's at rest, now, Lyon... he's at peace.",shape=box,color=red];
		j1548861044 -> j702776548;
	j1119692685 [label="Oh, Lyon...",shape=box,color=red];
		j1119692685 -> j3405251440;
	j702776548 [label="I know. I felt it when he was gone. And I wept. I miss him dearly. I know he echoes, still - somehow, someway, though I do not fully understand how.",shape=box,color=blue];
		j702776548 -> j2076192219;
		j702776548 -> j3527253024;
	j3405251440 [label="I miss him dearly. I know he echoes, still - somehow, someway, though I do not fully understand how.",shape=box,color=blue];
		j3405251440 -> j2076192219;
		j3405251440 -> j3527253024;
	j2076192219 [label="Rell was the strongest of us all. I'm glad you had any chance at all to know him.",shape=box,color=red];
		j2076192219 -> j177447085;
	j3527253024 [label="Rell was outcasted because of ignorance and the cruelty of children... he didn't deserve what happened to him.",shape=box,color=red];
		j3527253024 -> j2028650294;
	j177447085 [label="I am glad I knew him as well. As for his strength? Perhaps, perhaps not. In the end, he simply knew what was needed and he was strong enough to see it done.",shape=box,color=blue];
		j177447085 -> j886072528;
	j2028650294 [label="Perhaps. But in the end, he did what was needed. And he was strong enough to see it done.",shape=box,color=blue];
		j2028650294 -> j886072528;
	j886072528 [label="In times like these, \"strong enough\" is all we can pray for, I think.",shape=box,color=blue];
		j886072528 -> j3164172489;
	j3164172489 [label="Which is, unfortunately, not the same to be said of this wine... which was very strong, just slow to take effect.",shape=box,color=blue];
		j3164172489 -> j1289304912;
	j1289304912 [label="I should go before ",shape=box,color=blue];
		j1289304912 -> j766458910;
	j766458910 [label="I should go.",shape=box,color=blue];
		j766458910 -> j111445917;
	j111445917 [label="Check boolean LyonDating",color=orange];
		j111445917 -> j3259063140 [label=true,color=green];
		j111445917 -> j2682701159 [label=false,color=brown];
	j3259063140 [label="+20 Chemistry",color=orange];
		j3259063140 -> j577194693;
	j2682701159 [label="+20 Chemistry",color=orange];
		j2682701159 -> j2414794089;
	j577194693 [label="Thank you, my love.",shape=box,color=blue];
		j577194693 -> j3380929444;
	j2414794089 [label="Thank you, my friend.",shape=box,color=blue];
		j2414794089 -> j3380929444;
