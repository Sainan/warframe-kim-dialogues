		j410090499 -> j3898940241 [label="LyonDating",color=purple];
		j410090499 -> j3898545241 [label="LyonConvession1",color=purple];
		j410090499 -> j3898545241 [label="LyonRell2a",color=purple];
		j410090499 -> j3898545241 [label="LyonRell2b",color=purple];
		j410090499 -> j3898545241 [label="LyonRell1",color=purple];
		j410090499 -> "Chat ends." [label="false",color=purple];
	j3898940241 [label="Я цим не пишаюся, але випив цілу пляшку вина й тепер готовий розповісти тобі решту того, що так відчайдушно намагався приховати, mon miracle…",shape=box,color=blue];
		j3898940241 -> j2649361814;
	j3898545241 [label="Я цим не пишаюся, але випив цілу пляшку вина й тепер готовий розповісти тобі решту того, що так відчайдушно намагався приховати…",shape=box,color=blue];
		j3898545241 -> j2649361814;
	"Chat ends." [color=orange];
	j2649361814 [label="Якщо те, що було в пляшці, і справді вино, бо вона без маркування. А пан Лойд не зовсім упевнений, що те, що ми знали в мій час як вино, те саме зараз для нього.",shape=box,color=blue];
		j2649361814 -> j1829780590;
	j1829780590 [label="У свій захист скажу, що я не збирався випити всю пляшку… але ніяк не міг розсмакувати, чи то та саме рідина по факту й от вона вся взяла й зникла…",shape=box,color=blue];
		j1829780590 -> j3815201978;
		j1829780590 -> j2796789038;
		j1829780590 -> j3692233488;
	j3815201978 [label="Ні. Я на це не підписуватимуся.",shape=box,color=red];
		j3815201978 -> j1871378951;
	j2796789038 [label="То як на смак, таке саме?",shape=box,color=red];
		j2796789038 -> j3706030214;
	j3692233488 [label="Ти що, п’яний?",shape=box,color=red];
		j3692233488 -> j1648268436;
	j1871378951 [label="Якби ж мені так легко можна було втекти. Не засуджую.",shape=box,color=blue];
		j1871378951 -> j3856020424;
	j3706030214 [label="Я не знаю! І це найбільше розчаровує в цій історії! Але суть не в тому. Питання було напитися. А я навіть не знаю, чи вдалося. Однак я точно не зовсім тверезий…",shape=box,color=blue];
		j3706030214 -> j1443053708;
	j1648268436 [label="Потенційно. Я точно не такий, кого можна було би вважати тверезим.",shape=box,color=blue];
		j1648268436 -> j3430132253;
	j3856020424 [label="Boolean LyonConfessionFail is now true.",color=orange];
		j3856020424 -> "Chat ends.";
	j1443053708 [label="Тож припускаю, я якраз у потрібній кондиції.",shape=box,color=blue];
		j1443053708 -> j3211784141;
		j1443053708 -> j2969052695;
	j3430132253 [label="Що й було метою цього всього. Тож припускаю, я якраз у потрібній кондиції.",shape=box,color=blue];
		j3430132253 -> j3211784141;
		j3430132253 -> j2969052695;
	j3211784141 [label="Що ж таке жахливе ти хочеш мені розповісти, що довелося напитися?",shape=box,color=red];
		j3211784141 -> j2086461932;
	j2969052695 [label="За твоєї готовності…",shape=box,color=red];
		j2969052695 -> j2086461932;
	j2086461932 [label="Рап… Тап… Тап…",shape=box,color=blue];
		j2086461932 -> j344317965;
		j2086461932 -> j527784532;
	j344317965 [label="Йой…",shape=box,color=red];
		j344317965 -> j1228356602;
	j527784532 [label="Ага, ясно.",shape=box,color=red];
		j527784532 -> j1228356602;
	j1228356602 [label="Я точно знаю, що вони не все життя були в моїй свідомості. Тенно, відомий як Релл, та його вартовий, відомий як Гарроу. Не може бути, що вони були в стінах мого дому в моєму дитинстві.",shape=box,color=blue];
		j1228356602 -> j640888001;
	j640888001 [label="Ніяк не може бути, щоб усі ці роки відлуння їхніх голосів вешталося між шепотіння в моїй голові, спотворене голосами всіх видінь. Так, я бачив їх там, чув їх там, у спогадах своїх, скрізь.",shape=box,color=blue];
		j640888001 -> j252073137;
	j252073137 [label="Check boolean LyonTime1",color=orange];
		j252073137 -> j4225266447 [label=true,color=green];
		j252073137 -> j2597613325 [label=false,color=brown];
	j4225266447 [label="Я зрозумів слова Ентраті про можливість існування енергії одночасно в кількох місцях лише з погляду філософії. Але емоційно не відчував… допоки не ввів сироватку.",shape=box,color=blue];
		j4225266447 -> j656664107;
	j2597613325 [label="Саме в мить введення все об’єдналося. Коли Ентраті розкрив правду про себе та істину про своє буття… ",shape=box,color=blue];
		j2597613325 -> j2733999529;
	j656664107 [label="Я іноді у своїй голові бачу велике тихе неглибоке озеро, яке тягнеться навсібіч. Чорне й гладке, наче бездонне оніксове озеро.",shape=box,color=blue];
		j656664107 -> j1914941290;
	j2733999529 [label="Він виклав мені все, що знав про «квантові заплутаності», «суперпозиції» та «етерналізм» і таке інше.",shape=box,color=blue];
		j2733999529 -> j27892833;
	j1914941290 [label="Велике чорне озеро, яке перетікає в нескінченність. Неможливе для осягнення.",shape=box,color=blue];
		j1914941290 -> j692325326;
	j27892833 [label="Я все зрозумів як наукові сутності, радше філософські сенси. Але емоційно не відчував… допоки не ввів сироватку.",shape=box,color=blue];
		j27892833 -> j656664107;
	j692325326 [label="І саме там я їх знайду. Там ми всі зустрінемося. І там я відчуватиму їх всіх…",shape=box,color=blue];
		j692325326 -> j1581964729;
	j1581964729 [label="Їх?",shape=box,color=red];
		j1581964729 -> j2150439920;
	j2150439920 [label="Інших Гарроу… порожні статуї, відлуння відлунь відлунь… Вони стоять і ряди простягаються у нескінченність куди не подивишся…",shape=box,color=blue];
		j2150439920 -> j2348949041;
	j2348949041 [label="Релл помістив себе в одного з них. Загубив себе всередині нього. І таким чимном загубив себе всередині них усіх…",shape=box,color=blue];
		j2348949041 -> j1240410113;
	j1240410113 [label="Включно зі мною. Включно з Гарроу, який був у тій сироватці, що створила мене.",shape=box,color=blue];
		j1240410113 -> j716860842;
		j1240410113 -> j581668484;
	j716860842 [label="Порожнече… мені було геть невтямки…",shape=box,color=red];
		j716860842 -> j2285425922;
	j581668484 [label="От же ж…",shape=box,color=red];
		j581668484 -> j2285425922;
	j2285425922 [label="Вони були зі мною там, у моїй голові… Релл і його Гарроу, такі схожі на мене, і водночас настільки різні.",shape=box,color=blue];
		j2285425922 -> j1357179204;
	j1357179204 [label="Він не боявся. Він був дуже впевненим. Двійко речей, чого в мені нема.",shape=box,color=blue];
		j1357179204 -> j874529732;
	j874529732 [label="Він стійко протистояв Байдужості, не думав про те, чим вона є, а чим не є. Просто знав те, що треба зробити.",shape=box,color=blue];
		j874529732 -> j927901921;
	j927901921 [label="Навіть після всієї тої пізнаної жорстокості. За всі ті роки, у «зараз» і «тоді» тієї вічності, у мить введення мною сироватки… у ті «до» і «після» — він був там.",shape=box,color=blue];
		j927901921 -> j1973971002;
	j1973971002 [label="Він був моїм другом. Був моїм братом.",shape=box,color=blue];
		j1973971002 -> j1443613846;
	j1443613846 [label="А потім? Зараз?",shape=box,color=blue];
		j1443613846 -> j4096489337;
	j4096489337 [label="Я більше не відчуваю його.",shape=box,color=blue];
		j4096489337 -> j1488070305;
		j4096489337 -> j1028015922;
	j1488070305 [label="Він… Ліоне, він нині спочиває… у мирі.",shape=box,color=red];
		j1488070305 -> j364978546;
	j1028015922 [label="Ох, Ліоне…",shape=box,color=red];
		j1028015922 -> j423062342;
	j364978546 [label="Я знаю. Я відчув, коли він зник. І я ридав. Дуже сумую за ним. Якимось чином його відлуння досі є — як, для чого і чому я не дуже розумію.",shape=box,color=blue];
		j364978546 -> j1658799537;
		j364978546 -> j3108681019;
	j423062342 [label="Дуже сумую за ним. Якимось чином його відлуння досі є — як, для чого і чому я не дуже розумію.",shape=box,color=blue];
		j423062342 -> j1658799537;
		j423062342 -> j3108681019;
	j1658799537 [label="Релл був найсильнішим з нас усіх. Мене тішить, що тобі взагалі випала нагода пізнати його.",shape=box,color=red];
		j1658799537 -> j1721865980;
	j3108681019 [label="Релла вигнали через невігластво та дитячу жорстокість… він не заслуговував того, що з ним сталося.",shape=box,color=red];
		j3108681019 -> j3866622790;
	j1721865980 [label="Я також радий, що знав його. Стосовно ж могутності його? Може й так, а може й ні. Зрештою, він просто знав, що треба робити, й був достатньо міцним, щоби зробити це.",shape=box,color=blue];
		j1721865980 -> j3933207593;
	j3866622790 [label="Можливо. Зрештою, він зробив, що треба було зробити. І виявився достатньо сильним для цього.",shape=box,color=blue];
		j3866622790 -> j3933207593;
	j3933207593 [label="Гадаю, у такі часи бути «достатньо міцним» це все, про що ми можемо молитися.",shape=box,color=blue];
		j3933207593 -> j1545856838;
	j1545856838 [label="Що, на жаль, не можна стверджувати про це вино… яке виявилося дуже міцним, просто ефект проявився згодом.",shape=box,color=blue];
		j1545856838 -> j529049310;
	j529049310 [label="Я маю йти перш ніж ",shape=box,color=blue];
		j529049310 -> j3920413311;
	j3920413311 [label="Я маю йти.",shape=box,color=blue];
		j3920413311 -> j111445917;
