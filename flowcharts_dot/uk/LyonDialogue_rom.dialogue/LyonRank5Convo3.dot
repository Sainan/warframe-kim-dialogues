		j111445917 -> j3754318622 [label=true,color=green];
		j111445917 -> j689618587 [label=false,color=brown];
	j3754318622 [label="+20 Chemistry",color=orange];
		j3754318622 -> j348754993;
	j689618587 [label="+20 Chemistry",color=orange];
