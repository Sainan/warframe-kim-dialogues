	j1809468205 [label="Check /Lotus/Scripts/1999/DialogueScriptNodes.lua:IsDatingMultiple",color=orange];
		j1809468205 -> j1181132753 [label=true,color=green];
		j1809468205 -> j1316396836 [label=false,color=brown];
	"Chat ends." [color=orange];
	j1181132753 [label="Check boolean LyonConsentComplete",color=orange];
		j1181132753 -> "Chat ends." [label=true,color=green];
		j1181132753 -> j2848436576 [label=false,color=brown];
	j1316396836 [label="Check boolean LyonPolyamorySuccess",color=orange];
		j1316396836 -> j1181132753 [label=true,color=green];
		j1316396836 -> "Chat ends." [label=false,color=brown];
	j2848436576 [label="Mon miracle, якщо можливо, то я хотів би дещо швидко обговорити. Думаю, це нас обох має заспокоїти.",shape=box,color=blue];
		j2848436576 -> j1399893548;
		j2848436576 -> j3971356399;
	j1399893548 [label="[Завершити розмову]",shape=box,color=red];
		j1399893548 -> j3944516755;
	j3971356399 [label="Ліоне, щось не так?",shape=box,color=red];
		j3971356399 -> j1726300163;
	j3944516755 [label="Boolean LyonConsentComplete is now true.",color=orange];
		j3944516755 -> "Chat ends.";
	j1726300163 [label="Ні-ні, нічого такого. Я просто хотів зазначити, що знаю про твій час з іншими в… любовному сенсі. Коли ти не зі мною.",shape=box,color=blue];
		j1726300163 -> j2725704586;
	j2725704586 [label="І я хотів запевнити, що це не гнітить мене і не тривожить. Твоя присутність у моєму житті дарує лише мир та радість…",shape=box,color=blue];
		j2725704586 -> j1891898958;
	j1891898958 [label="І як я можу навіть насмілитися відмовити комусь іще в такому дарі?",shape=box,color=blue];
		j1891898958 -> j1571665390;
		j1891898958 -> j1617041916;
	j1571665390 [label="Думаю, ви б поладнали.",shape=box,color=red];
		j1571665390 -> j811742257;
	j1617041916 [label="Дякую. Це багато значить для мене.",shape=box,color=red];
		j1617041916 -> j2119376131;
	j811742257 [label="Думки про це змушують мене усміхатися. І хтозна, може в іншому житті чи котрогось дня в цьому… ми й зустрінемося. ",shape=box,color=blue];
		j811742257 -> j2774807163;
	j2119376131 [label="Такі як ми (як я) за все те, принесене мені такому… я задоволений. Ні. Я… щасливий. Уперше за дуже тривалий час.",shape=box,color=blue];
		j2119376131 -> j3607506113;
	j2774807163 [label="У теперішньому стані я задоволений нашими стосунками. Ні. Я… щасливий. Уперше за дуже тривалий час.",shape=box,color=blue];
		j2774807163 -> j3607506113;
	j3607506113 [label="І я дякую тобі за це. Однак зараз я мушу написати: бувай.",shape=box,color=blue];
		j3607506113 -> j3943168034;
	j3943168034 [label="Ліон",shape=box,color=blue];
		j3943168034 -> j3944516755;
}