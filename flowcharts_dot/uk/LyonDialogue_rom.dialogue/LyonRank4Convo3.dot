digraph {
	"LyonRank4Convo3 begins." [color=orange];
		"LyonRank4Convo3 begins." -> j1918422001;
		"LyonRank4Convo3 begins." -> j231715113;
		"LyonRank4Convo3 begins." -> j1478915251;
	j1918422001 [label="Які в тебе стосунки з кавіями?",shape=box,color=red];
		j1918422001 -> j4241233809;
	j231715113 [label="Що ти думаєш про Лойда?",shape=box,color=red];
		j231715113 -> j1173740624;
	j1478915251 [label="[Завершити розмову]",shape=box,color=red];
		j1478915251 -> "Chat ends.";
	j4241233809 [label="Мені до вподоби слухати їхні жарти одне над одним, хоча, ти ж розумієш, я в цьому участі не беру. Мало що можна додати до тих дотепних фраз.",shape=box,color=blue];
		j4241233809 -> j3425473283;
	j1173740624 [label="Дуже приємний чоловік. І справді, з усіх нових… знайомців, він той, до кого мене тягне найбільше.",shape=box,color=blue];
		j1173740624 -> j2605214975;
	"Chat ends." [color=orange];
	j3425473283 [label="Однак мене відвідують бентежні думки, коли бачу Роута за тривалими бесідами з Птахом-3. Я не знаю його намірів у таких ситуаціях.",shape=box,color=blue];
		j3425473283 -> j2507757158;
	j2605214975 [label="Та припускаю, що це нікого анітрохи не здивує. Ми дуже схожі за характером, якщо подумати.",shape=box,color=blue];
		j2605214975 -> j4034471698;
	j2507757158 [label="Boolean LyonRoatheCavia1 is now true.",color=orange];
		j2507757158 -> j2164772563;
		j2507757158 -> j3136469215;
	j4034471698 [label="Дивнішим для мене є маля, якого кличуть «оператором»… і та, кого називають «Лотос». І те, що нас не підпускають до них.",shape=box,color=blue];
		j4034471698 -> j287015847;
	j2164772563 [label="Гм. Я спитаю в нього щодо цього.",shape=box,color=red];
		j2164772563 -> j4198829349;
	j3136469215 [label="Чому ти вважаєш, що в нього є якісь «наміри»?",shape=box,color=red];
		j3136469215 -> j819344223;
	j287015847 [label="Звісно, нам дозволено контактувати. Але не так. Не тут. Чому?",shape=box,color=blue];
		j287015847 -> j1802842464;
		j287015847 -> j2439350347;
	j4198829349 [label="Можливо, це мудрий крок. Мені б дуже не сподобалося бачити, як він маніпулює цими істотами й прагне використати їх ще більше, аніж вони були використані раніше.",shape=box,color=blue];
		j4198829349 -> j4034471698;
	j819344223 [label="У Роута завжди є приховані наміри, коли з кимось спілкується. Мені б дуже не сподобалося бачити, як він маніпулює цими істотами й прагне використати їх ще більше, аніж вони були використані раніше.",shape=box,color=blue];
		j819344223 -> j742537251;
	j1802842464 [label="Маля… має свої навіжені випробування. Ми не можемо вимагати робити ще більше. Це не правильно.",shape=box,color=red];
		j1802842464 -> j545710829;
	j2439350347 [label="Гадаю… бо в мене вже був «попередній досвід» із протофреймами?",shape=box,color=red];
		j2439350347 -> j3260070664;
	j742537251 [label="Це вартує ретельнішого розслідування, якщо в тебе є час. Хоча вирішувати лише тобі.",shape=box,color=blue];
		j742537251 -> j4034471698;
	j545710829 [label="Так. До мене долинав шепіт про цю історію. Про події війни і… понівечену дружбу… розірвану на шмаття.",shape=box,color=blue];
		j545710829 -> j1614412288;
	j3260070664 [label="Check boolean IsDating",color=orange];
		j3260070664 -> j246617305 [label=true,color=green];
		j3260070664 -> j2310798225 [label=false,color=brown];
	j1614412288 [label="Серце болить від того, скільки всього нищить війна. Але ще більше дивує, скільки всього вона створює.",shape=box,color=blue];
		j1614412288 -> j2310798225;
	j246617305 [label="Гм. Це так воно зараз називається? «Попередній досвід»? Надзвичайно вишукано. Попри те, що Ентраті чимало дров там наламав. я радію від того… що тобі вдалося трішки розважитися.",shape=box,color=blue];
		j246617305 -> j2203128361;
		j246617305 -> j3379895688;
		j246617305 -> j3765276935;
	j2310798225 [label="Пан Лойд розповідав мені про твої «зловісні пригоди» у Голвенії з вашого минулого, нашого майбутнього. Ентраті точно наламав там купу дров.",shape=box,color=blue];
		j2310798225 -> j1294762618;
		j2310798225 -> j107992534;
	j2203128361 [label="Щось не так?",shape=box,color=red];
		j2203128361 -> j3487893497;
	j3379895688 [label="Обережніше, священнику, інакше я можу подумати, що тобі цікаво чи не зеленіша травичка по той бік паркану.",shape=box,color=red];
		j3379895688 -> j619519124;
	j3765276935 [label="Ліоне, ти кажеш так, що то наче якась інтрижка. Не варто мене так ображати.",shape=box,color=red];
		j3765276935 -> j1331458418;
	j1294762618 [label="Повір мені, могло бути набагато гірше.",shape=box,color=red];
		j1294762618 -> j1773460525;
	j107992534 [label="Ті протофрейми — мої хороші друзі. Вони стали наче родина для мене.",shape=box,color=red];
		j107992534 -> j1391322405;
	j3487893497 [label="Check boolean LyonFirstFlirt",color=orange];
		j3487893497 -> j2252756408 [label=true,color=green];
		j3487893497 -> j1972805374 [label=false,color=brown];
	j619519124 [label="Check boolean LyonFirstFlirt",color=orange];
		j619519124 -> j2252756408 [label=true,color=green];
		j619519124 -> j2900369195 [label=false,color=brown];
	j1331458418 [label="Check boolean LyonFirstFlirt",color=orange];
		j1331458418 -> j2252756408 [label=true,color=green];
		j1331458418 -> j115043322 [label=false,color=brown];
	j1773460525 [label="Упевнений, що все відбувалося за величним майстерним планом Ентраті. Я про довіру долі майбутнього тобі й купці невдах.",shape=box,color=blue];
		j1773460525 -> j563643800;
	j1391322405 [label="Мої бабусі з дідами познайомилися під час Ґоллійської революції. Війна та смерть завжди найдивнішим способом зводять у танці партнерів.",shape=box,color=blue];
		j1391322405 -> j3628502303;
	j2252756408 [label="Пробач. Просто мені здалося, що останньої нашої бесіди, ти… ",shape=box,color=blue];
		j2252756408 -> j2940503536;
	j1972805374 [label="Пробач. Я не знаю, що в тебе на серці. Чи в інших. Те, чим ти займаєшся у свій вільний час… з іншими — лише твоя особиста справа.",shape=box,color=blue];
		j1972805374 -> j4047074564;
		j1972805374 -> j3966079949;
	j2900369195 [label="Пробач мені. Так, твоя правда. Я не прагнув бути заздрісним чи якось провокувати. Те, чим ти займаєшся у свій вільний час… з іншими — лише твоя особиста справа.",shape=box,color=blue];
		j2900369195 -> j4047074564;
		j2900369195 -> j3966079949;
	j115043322 [label="Звісно. Пробач. Я не знаю, що в тебе на серці. Чи в інших. Те, чим ти займаєшся у свій вільний час… з іншими — лише твоя особиста справа.",shape=box,color=blue];
		j115043322 -> j4047074564;
		j115043322 -> j3966079949;
	j563643800 [label="Я… мандрівниче… я розумію, що я один із… найменш приємних особистостей, з якими тебе примушують взаємодіяти. Тож я продовжу за це вибачатися.",shape=box,color=blue];
		j563643800 -> j1497535329;
	j3628502303 [label="Boolean LyonBackstory2 is now true.",color=orange];
		j3628502303 -> j3135571897;
		j3628502303 -> j1975682809;
	j2940503536 [label="Не зважай… Мене не має дивувати, що людські серця непостійні й оманливі. Особливо, коли справа стосується мене.",shape=box,color=blue];
		j2940503536 -> j1801092976;
		j2940503536 -> j1253100419;
	j4047074564 [label="Нам… багато чого довелося пережити разом. Таке зближує людей.",shape=box,color=red];
		j4047074564 -> j2951796772;
	j3966079949 [label="[Зізнатися в почуттях] По правді я все намагаюся придумати як підняти цю тему.",shape=box,color=red];
		j3966079949 -> j1309696393;
	j1497535329 [label="Я такий як є. І я не знаю, як бути інакшим. Я справді вважаю, що не здатен зцілити рани своєї душі, завдані проклятими сутностями, які переслідують мене.",shape=box,color=blue];
		j1497535329 -> j412868321;
	j3135571897 [label="Таке трапляється скрізь і завжди в історії людства.",shape=box,color=red];
		j3135571897 -> j2548876517;
	j1975682809 [label="Хотілося би більше дізнатися про твою сім’ю.",shape=box,color=red];
		j1975682809 -> j2705947725;
	j1801092976 [label="Зажди. Ти не так мене зрозумів. Я не вводив тебе в оману. Просто все, ну… занадто складно.",shape=box,color=red];
		j1801092976 -> j1374493133;
	j1253100419 [label="Я розумію це так, що не цікавлю тебе.",shape=box,color=red];
		j1253100419 -> j1564286621;
	j2951796772 [label="Мої бабусі з дідами познайомилися під час Ґоллійської революції. Війна та смерть завжди найдивнішим способом зводять у танці партнерів для пристрасті й любові.",shape=box,color=blue];
		j2951796772 -> j3628502303;
	j1309696393 [label="От тепер я починаю дуже нервувати… Чи можу я спитати чому?",shape=box,color=blue];
		j1309696393 -> j2961864231;
		j1309696393 -> j3578262126;
	j412868321 [label="Те, що ховається під цією скляною потрісканою поверхнею — це…",shape=box,color=blue];
		j412868321 -> j1684131014;
		j412868321 -> j2458919166;
	j2548876517 [label="І справді. Думаю, я не маю злитися на щось позитивне, що йде з темряви та руйнацій війни.",shape=box,color=blue];
		j2548876517 -> j1286842416;
		j2548876517 -> j2468146756;
	j2705947725 [label="Не та історія, яку б я із задоволенням розповів. Будь-кому. Тож маєш пробачити мені, що я не дуже прагну розкривати її перед тобою. Можливо… якось іншим разом.",shape=box,color=blue];
		j2705947725 -> j45628237;
		j2705947725 -> j173043694;
	j1374493133 [label="Прошу, продовжуй.",shape=box,color=blue];
		j1374493133 -> j2961864231;
		j1374493133 -> j3578262126;
	j1564286621 [label="З усією повагою, але я тебе не знаю. І в купі з усім тим, що я на себе взяв… романтичні стосунки з незнайомцями навряд будуть моїм найпершим пріоритетом.",shape=box,color=blue];
		j1564286621 -> j1850086293;
	j2961864231 [label="Я… ми спробуємо іншим разом. Перепрошую. ",shape=box,color=red];
		j2961864231 -> j768623229;
	j3578262126 [label="Я не дуже розумію, чи легко тобі буде зрозуміти це, чи це матиме вигляд божевільної маячні, але для мене… я… можу мати сильні почуття водночас до кількох осіб.",shape=box,color=red];
		j3578262126 -> j2645499922;
	j1684131014 [label="Ліоне, усе гаразд. Якось дійдемо до того. Я не кваплюся, повір.",shape=box,color=red];
		j1684131014 -> j1199407524;
	j2458919166 [label="Це що?",shape=box,color=red];
		j2458919166 -> j4266016405;
	j1286842416 [label="Що ти маєш на увазі?",shape=box,color=red];
		j1286842416 -> j683312348;
	j2468146756 [label="Ти злишся на це?",shape=box,color=red];
		j2468146756 -> j3713685629;
	j45628237 [label="Я буду поруч.",shape=box,color=red];
		j45628237 -> j838532317;
	j173043694 [label="Звісно. Коли будеш готовий, Ліоне.",shape=box,color=red];
		j173043694 -> j1676979292;
	j1850086293 [label="Упевнений, що знайдуться такі, хто з радістю би поринув в обійми іншої особи у такому випаду як цей, але я — не один з цих щасливчиків.",shape=box,color=blue];
		j1850086293 -> j211892364;
	j768623229 [label="+20 Chemistry",color=orange];
		j768623229 -> j3239250946;
	j2645499922 [label="У мене є почуття до тебе. Але також і до них. І для мене ці почуття однакові.",shape=box,color=red];
		j2645499922 -> j89305777;
	j1199407524 [label="+20 Chemistry",color=orange];
		j1199407524 -> j553482943;
	j4266016405 [label="+10 Chemistry",color=orange];
		j4266016405 -> j1743544820;
	j683312348 [label="Пробач. Це не та історія, яку б я із задоволенням розповів. Будь-кому. Тож маєш пробачити мені, що я не дуже прагну розкривати її перед тобою. Можливо… якось іншим разом.",shape=box,color=blue];
		j683312348 -> j45628237;
		j683312348 -> j173043694;
	j3713685629 [label="Не на існування кохання. Можливо на те, що воно було відсутнє в моїй родині. Пробач. Це не та історія, яку б я із задоволенням розповів. Будь-кому. Тож маєш пробачити мені, що я не дуже прагну розкривати її перед тобою. Можливо… якось іншим разом.",shape=box,color=blue];
		j3713685629 -> j45628237;
		j3713685629 -> j173043694;
	j838532317 [label="+15 Chemistry",color=orange];
		j838532317 -> j2675376308;
	j1676979292 [label="+20 Chemistry",color=orange];
		j1676979292 -> j827187701;
	j211892364 [label="Тож натомість дуже раджу пошукати когось такого. Гарного дня.",shape=box,color=blue];
		j211892364 -> j3545001372;
	j3239250946 [label="Гаразд. Якщо бажаєш, то ми поговоримо про це іншим разом. До того часу я маю повертатися до своїх обов’язків.",shape=box,color=blue];
		j3239250946 -> j3545001372;
	j89305777 [label="Така ситуація не є незнайомою чи дикою для мене, як можна було би подумати. Насправді в цьому мене бентежить не сама суть, а саме залучені учасники. Не ображайся.",shape=box,color=blue];
		j89305777 -> j4057150478;
	j553482943 [label="Boolean LyonVisions3 is now true.",color=orange];
		j553482943 -> j373423485;
	j1743544820 [label="Для більшості це занадто багато, щоб витримати. І я дякую тобі за спроби робити це далі. От і все.",shape=box,color=blue];
		j1743544820 -> j3545001372;
	j2675376308 [label="Мене навідують думки, що це буде неминучим. Так. Гарного дня.",shape=box,color=blue];
		j2675376308 -> j3545001372;
	j827187701 [label="Дякую. Гарного дня й до наступної бесіди.",shape=box,color=blue];
		j827187701 -> j3545001372;
	j3545001372 [label="Отець Ліон Аллард",shape=box,color=blue];
		j3545001372 -> "Chat ends.";
	j4057150478 [label="І може ще те, як близько до нашого нового «дому» прагне підлетіти твоя стріла.",shape=box,color=blue];
		j4057150478 -> j408168556;
		j4057150478 -> j3627481622;
	j373423485 [label="Дякую…",shape=box,color=blue];
		j373423485 -> j3545001372;
	j408168556 [label="Я ж не про «зараз» пишу, якщо чесно. Просто хотілося прояснити це все.",shape=box,color=red];
		j408168556 -> j309586536;
	j3627481622 [label="Тож… ти маєш на увазі… що є ймовірність?",shape=box,color=red];
		j3627481622 -> j2695952058;
	j309586536 [label="+20 Chemistry",color=orange];
		j309586536 -> j747302731;
	j2695952058 [label="+20 Chemistry",color=orange];
		j2695952058 -> j1510595638;
	j747302731 [label="Так, що ж… якщо прийму рішення, що не ненавиджу тебе, коли ми досягнемо тієї точки. То може бути, що цю розмову можна буде поновити.",shape=box,color=blue];
		j747302731 -> j3628863155;
	j1510595638 [label="Так… можливо. Якщо прийму рішення, що не ненавиджу тебе, коли ми досягнемо тієї точки. А це ще дуже все неявно, мандрівниче.",shape=box,color=blue];
		j1510595638 -> j3628863155;
	j3628863155 [label="А доти я мушу повернутися до виконання обов’язків. Дуже дякую за… цю цікаву бесіду. Напевно.",shape=box,color=blue];
		j3628863155 -> j1892108590;
