	j1080262621 [label="Як ти сьогодні почуваєшся? Марі писала, що ти лягав з меґрімою.",shape=box,color=red];
		j1080262621 -> j3499364357;
	j2800188216 [label="Ліоне, як ти сьогодні?",shape=box,color=red];
