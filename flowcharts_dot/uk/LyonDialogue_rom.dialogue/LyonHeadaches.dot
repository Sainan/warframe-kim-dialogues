		j3793588528 -> j71967295 [label="MarieLyonSuffering1",color=purple];
		j3793588528 -> j3601791179 [label="MarieLyonSuffering1",color=purple];
		j3793588528 -> j3365167649 [label="false",color=purple];
		j3793588528 -> j71967295 [label="false",color=purple];
	j865588686 [label="Зі мною все гаразд. Просто хотілося взнати як ти. Кажуть, тобі було зле вчора.",shape=box,color=red];
		j865588686 -> j3093814780;
	j698059040 [label="Борюся з меґрімою як можу.",shape=box,color=red];
		j698059040 -> j1359584508;
	j1620814178 [label="Борюся з мігренню як можу.",shape=box,color=red];
		j1620814178 -> j4243503942;
	j2144740483 [label="Борюся з головним болем як можу.",shape=box,color=red];
		j2144740483 -> j104147078;
	j3365167649 [label="Знаю з особистого досвіду, що іноді миті, коли ми відвертаємося від допомоги інших, саме ті, коли ця допомога потрібна якнайбільше.",shape=box,color=red];
		j3365167649 -> j2414179445;
	j71967295 [label="Поважаю це. Я не наполягатиму, якщо не хочеш спілкуватися. Але я можу вислухати (вичитати), якщо ти захочеш.",shape=box,color=red];
		j71967295 -> j2414179445;
	j1322820210 [label="Здалося, вона натякає на те, що в тебе є теорії походження свого головного болю.",shape=box,color=red];
		j1322820210 -> j4062380760;
	j2069729798 [label="Марі думає, що ти намагаєшся самотужки нести весь цей тягар. Хотілося дати тобі взнаки, що я поруч.",shape=box,color=red];
		j2069729798 -> j2373189461;
	j3601791179 [label="Марі вважає, що ти беззмістовно страждаєш через це все. Мені стало цікаво, чи не зможу чимось допомогти.",shape=box,color=red];
		j3601791179 -> j2373189461;
	j3093814780 [label="Ага. Ясно. Дякую за запитання, сьогодні почуваюся відпочилим. Однак не впевнений, чи мені подобається, що Марі розповіла тобі про мою недугу.",shape=box,color=blue];
		j3093814780 -> j366050237;
		j3093814780 -> j34947487;
		j3093814780 -> j363366779;
	j1359584508 [label="Boolean LyonSuspicious is now true.",color=orange];
		j1359584508 -> j1237223152;
	j4243503942 [label="Певно, це слово цієї ери для позначення мого сильного головного болю. Теж іноді страждаю від цього. Не думаю, що витріщання на сяйво цього пристрою допомагає. Тобі варто піти й полежати.",shape=box,color=blue];
		j4243503942 -> j2796385500;
		j4243503942 -> j2486374981;
		j4243503942 -> j2366779020;
	j104147078 [label="Теж іноді страждаю від цього. Не думаю, що витріщання на сяйво цього пристрою допомагає. Тобі варто піти й полежати.",shape=box,color=blue];
		j104147078 -> j2796385500;
		j104147078 -> j2486374981;
		j104147078 -> j2366779020;
	j2414179445 [label="Я не стверджую, що нині саме та мить. Але раптом що… то я тут.",shape=box,color=red];
		j2414179445 -> j3700729702;
	j4062380760 [label="І, ні жаль, ці теорії тепер просто можна жбурнути «в Порожнечу».",shape=box,color=blue];
		j4062380760 -> j1984600787;
		j4062380760 -> j2290930265;
	j2373189461 [label="Ти вже пробач мені, мандрівниче, але маю написати таке:",shape=box,color=blue];
		j2373189461 -> j2255764089;
	j1237223152 [label="Гм, теж іноді страждаю від цього. Не думаю, що витріщання на сяйво цього пристрою допомагає. Тобі варто піти й полежати.",shape=box,color=blue];
		j1237223152 -> j2796385500;
		j1237223152 -> j2486374981;
		j1237223152 -> j2366779020;
	j2796385500 [label="Саме так. Я зараз піду. Просто перевіряю, чи все в тебе добре.",shape=box,color=red];
		j2796385500 -> j292598036;
	j2486374981 [label="Тут ти мене й підловив. У мене просто… інакше не було як зв’язатися з тобою.",shape=box,color=red];
		j2486374981 -> j2346987602;
	j2366779020 [label="Та, ще трохи протягну. А ти скільки страждаєш від цього головного болю?",shape=box,color=red];
		j2366779020 -> j2298410583;
	j3700729702 [label="Boolean LyonOffer is now true.",color=orange];
		j3700729702 -> j2373189461;
	j1984600787 [label="Га?",shape=box,color=red];
		j1984600787 -> j3247557239;
	j2290930265 [label="І що це має означати?",shape=box,color=red];
		j2290930265 -> j3247557239;
	j2255764089 [label="Довкола повно незнайомців і балакучих звірів у світі, сповненому фантастичного божевілля й нещадної нескінченної жорстокої різанини.",shape=box,color=blue];
		j2255764089 -> j1414491080;
	j292598036 [label="+20 Chemistry",color=orange];
		j292598036 -> j324221914;
	j2346987602 [label="Твоє охоче бажання одразу визнати свою брехню дуже цінне. Бо я… не найприємніша істота для бесід.",shape=box,color=blue];
		j2346987602 -> j749206397;
	j2298410583 [label="Мандрівниче. Це особисте. Я дуже вдячний за спробу налагодити розмову. І ціную це, бо я… не найприємніша істота для бесід.",shape=box,color=blue];
		j2298410583 -> j749206397;
	j3247557239 [label="Boolean LyonFaithHeadache is now true.",color=orange];
		j3247557239 -> j2373189461;
	j1414491080 [label="Усе відоме мені донині було розтрощено вщент яскравими променями «нефритового світла», і «орокінською імперією», і «Порожнечею». І тепер я бачу загрозу від «Шепоту».",shape=box,color=blue];
		j1414491080 -> j278921277;
	j324221914 [label="Ну, як можеш «бачити», я вже одужав. А тобі варто попіклуватися про себе. Знайди темніше місце й відновися теж.",shape=box,color=blue];
		j324221914 -> j1407876501;
	j749206397 [label="Чи можу я виявити відвертість і поцікавитися, чому ти намагаєшся взагалі зі мною налагодити контакт?",shape=box,color=blue];
		j749206397 -> j3687168231;
		j749206397 -> j3023297901;
		j749206397 -> j1847475471;
		j749206397 -> j3365167649;
	j278921277 [label="Ти вже маєш пробачити мені, але… ця пропозиція стосунків від тебе навдивовижу смішна у своїй наївності. Я тебе не знаю, я тобі не довіряю. Зрештою, я можу спиратися лише на слова інших.",shape=box,color=blue];
		j278921277 -> j3725251627;
	j1407876501 [label="Зникни, мандрівниче. Поки я не знайшов тебе й силоміць не вклав у ліжко. Це нікому з нас не сподобається.",shape=box,color=blue];
		j1407876501 -> j1556191090;
		j1407876501 -> j799699917;
	j3687168231 [label="Ну відвертість за відвертість — геть не можу перестати думати про тебе з миті нашої зустрічі.",shape=box,color=red];
		j3687168231 -> j2905931503;
	j3023297901 [label="Ентраті перетворив вас на протофреймів, і тепер ви тут — без підготовки, без нічого. Якщо можу допомогти тобі адаптуватися, то я намагатимусь.",shape=box,color=red];
		j3023297901 -> j2373189461;
	j1847475471 [label="Ну?.. Уважаю тебе неймовірним. Хочу взнати тебе ліпше.",shape=box,color=red];
		j1847475471 -> j2373189461;
	j3725251627 [label="На слова інших, кого я теж не знаю і ще теж не довіряю. Усе це навалилося на нас, не говорячи про тягарі, яких тобі не видно.",shape=box,color=blue];
		j3725251627 -> j4204546606;
	j1556191090 [label="Та йду я, йду.",shape=box,color=red];
		j1556191090 -> j515788154;
	j799699917 [label="Ну… Насправді мені це може сподобатися більше, аніж ти думаєш.",shape=box,color=red];
		j799699917 -> j719613752;
	j2905931503 [label="+20 Chemistry",color=orange];
		j2905931503 -> j719613752;
	j4204546606 [label="Тож, я ціную твоє привітне ставлення й перепрошую за брак такого ж у мене. Я розумію чого ти намагаєшся досягти й це похвально. Сподіваюся, коли настане час і нагода для твоєї допомоги — пропозиція буде в силі.",shape=box,color=blue];
		j4204546606 -> j888215241;
		j4204546606 -> j260340741;
		j4204546606 -> j452056296;
	j515788154 [label="Добре. Здоров’я тобі, мандрівниче.",shape=box,color=blue];
		j515788154 -> j3545001372;
	j719613752 [label="Boolean LyonFirstFlirt is now true.",color=orange];
		j719613752 -> "Chat ends. Next chat will be LyonFlirt.";
	j888215241 [label="Нічого не обіцяю, священнику.",shape=box,color=red];
		j888215241 -> j3822537031;
	j260340741 [label="Як казав мій друг: «мені не бракує впертості, дружаньо».",shape=box,color=red];
		j260340741 -> j3417160662;
	j452056296 [label="Так і буде.",shape=box,color=red];
