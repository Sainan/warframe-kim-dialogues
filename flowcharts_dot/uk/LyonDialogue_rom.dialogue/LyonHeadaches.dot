		j3499364357 -> j363366779;
	j3352137841 [label="+5 Chemistry",color=orange];
		j3352137841 -> j1948731295;
	"Chat ends." [color=orange];
	j3287193387 [label="Ага, певно, це слово цієї ери для позначення мого сильного головного болю. Так. Було таке. Дякую за запитання, сьогодні почуваюся відпочилим. Однак не впевнений, чи мені подобається, що Марі розповіла тобі про мою недугу.",shape=box,color=blue];
		j3287193387 -> j366050237;
		j3287193387 -> j34947487;
		j3287193387 -> j363366779;
	j366050237 [label="Чого б це?",shape=box,color=red];
		j366050237 -> j4182895380;
	j34947487 [label="Вона лише сказала про те, що тобі зле, бо переживала.",shape=box,color=red];
		j34947487 -> j2467747151;
	j363366779 [label="Це було сказано між іншим. Вона не просила мене писати тобі й перепитувати як ти.",shape=box,color=red];
		j363366779 -> j2467747151;
	j1948731295 [label="У мене все добре, дуже дякую за запитання. Як ти?",shape=box,color=blue];
		j1948731295 -> j9112577;
	j4182895380 [label="Не думаю, що тебе може дивувати, що я прагну зберігати приватність своїх справ.",shape=box,color=blue];
		j4182895380 -> j3793588528;
	j2467747151 [label="Аякже. Марі б лікувала весь світ променями Сола, якби могла. Але не думаю, що тебе може дивувати, що я прагну зберігати приватність своїх справ.",shape=box,color=blue];
		j2467747151 -> j3793588528;
	j9112577 [label="Evaluate expressions",color=orange];
