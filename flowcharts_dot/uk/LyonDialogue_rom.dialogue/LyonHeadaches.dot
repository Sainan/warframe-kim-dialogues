	j1478915251 [label="[Завершити розмову]",shape=box,color=red];
		j1478915251 -> "Chat ends.";
	j2064840363 [label="Як ти сьогодні почуваєшся? Марі писала, що ти лягав з жахливою мігренню.",shape=box,color=red];
		j2064840363 -> j3287193387;
	j3499364357 [label="О. Так. Було таке. Дякую за запитання, сьогодні почуваюся відпочилим. Однак не впевнений, чи мені подобається, що Марі розповіла тобі про мою недугу.",shape=box,color=blue];
		j3499364357 -> j366050237;
