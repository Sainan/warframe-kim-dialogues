	j2833502144 [label="Я сидітиму в мовчазній молитвій й дякуватиму тим богам, які направили тебе нам і за твою терплячість… доброту… за те, що читаєш такі довгі бесіди.",shape=box,color=blue];
		j2833502144 -> j3613616076;
	j3151079550 [label="Я сидітиму в мовчазній молитвій й дякуватиму тим богам, які направили тебе нам і за твою терплячість… доброту… за те, що читаєш такі довгі бесіди.",shape=box,color=blue];
		j3151079550 -> j357493022;
	j1367308668 [label="Я так багато розповідаю тобі про свій біль, а ти все це терпляче читаєш? І нічого не просиш натомість… Мої «дякую» нікчемні у порівнянні.",shape=box,color=blue];
		j1367308668 -> j1834010808;
	j3344902104 [label="Я знаю, що те, чим я став, це те, чим я завжди був. І це не так просто сприйняти іншим.",shape=box,color=blue];
		j3344902104 -> j1834010808;
	j3613616076 [label="Я так спокійно зміг розкрити свою душу тобі, а тобою це все зустрічалося з відкритим серцем.",shape=box,color=blue];
		j3613616076 -> j810160347;
	j357493022 [label="Я так спокійно зміг розкрити свою душу тобі, а тобою це все зустрічалося з розкритими обіймами.",shape=box,color=blue];
		j357493022 -> j810160347;
	j1834010808 [label="І за всю твою терплячість я тобі безмежно вдячний.",shape=box,color=blue];
