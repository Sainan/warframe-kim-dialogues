		j810160347 -> j3998828578 [label="false",color=purple];
	j3963569005 [label="Mon miracle, я припаду навколішки до твого вівтаря найвідданішим і найзатятішим слугою та солдатом.",shape=box,color=blue];
		j3963569005 -> j2543697276;
	j1968973850 [label="Дружаньо, я стану до бою поруч із тобою, щоб не було. Хіба я можу не захищати тебе, коли тепер ти мешкаєш у серці моєї сестри?",shape=box,color=blue];
		j1968973850 -> j3963874680;
	j3316414761 [label="Дружаньо, я стану до бою поруч із тобою, щоб не було. Хіба я можу не захищати тебе, коли тобі вдалося приборкати диявола?",shape=box,color=blue];
		j3316414761 -> j3963874680;
	j3998828578 [label="Дружаньо, я стану до бою поруч із тобою, щоб не було.",shape=box,color=blue];
		j3998828578 -> j3963874680;
	j2543697276 [label="Коли б тобі не довелося йти. Які б там битви не чекали. Куди б не завело твоє серце…",shape=box,color=blue];
		j2543697276 -> j753378081;
	j3963874680 [label="Коли б тобі не довелося йти. Які б там битви не чекали. Я буду завше на твоїй стороні.",shape=box,color=blue];
		j3963874680 -> j280175108;
