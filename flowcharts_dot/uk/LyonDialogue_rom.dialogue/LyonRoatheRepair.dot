		j8348369 -> "Chat ends." [label="false",color=purple];
	j806051227 [label="Невже в тебе настільки скінчилися варіанти, тобі потрібно просити Роута докучати мені від твого імені, щоб я… розглянув вибачення?",shape=box,color=blue];
		j806051227 -> j1355190937;
	j1738831119 [label="Невже в тебе настільки скінчилися варіанти, тобі потрібно просити Роута докучати мені від твого імені, щоб відправити пана Лойда нагору?",shape=box,color=blue];
		j1738831119 -> j4173117941;
	j3840279651 [label="Невже в тебе настільки скінчилися варіанти, тобі потрібно просити Роута докучати мені від твого імені?",shape=box,color=blue];
		j3840279651 -> j29152128;
	"Chat ends." [color=orange];
	j1355190937 [label="Ти ж розумієш, який це фарс?",shape=box,color=blue];
		j1355190937 -> j2492965323;
		j1355190937 -> j4177364812;
	j4173117941 [label="Я не хочу витрачати більше часу, ніж уже втратив на його аргументи. Я просто скажу: гаразд.",shape=box,color=blue];
		j4173117941 -> j2169173578;
	j29152128 [label="Проблема в тому — виправ, якщо я помиляюся — що в тебе не було бажання розбиратися в моєму минулому. Тепер, схоже, у тебе інша думка?",shape=box,color=blue];
		j29152128 -> j3927678079;
	j2492965323 [label="Мені не було відомо, що він скаже, що я вибачатимусь.",shape=box,color=red];
		j2492965323 -> j1672963663;
	j4177364812 [label="У мене не було інших варіантів. Розумію, що це доволі абсурдно.",shape=box,color=red];
		j4177364812 -> j2445297821;
	j2169173578 [label="Check boolean MarieFamilyFail",color=orange];
		j2169173578 -> j2146949199 [label=true,color=green];
		j2169173578 -> j4193316754 [label=false,color=brown];
	j3927678079 [label="Я не розумію. Ми не можемо повернутися назад. У цю річку вже не ввійдеш.",shape=box,color=blue];
		j3927678079 -> j3269971586;
		j3927678079 -> j220990981;
	j1672963663 [label="Зрозуміло.",shape=box,color=blue];
		j1672963663 -> "Chat ends.";
	j2445297821 [label="Зізнаюся, комічність цієї ситуації частково спонукала мене прийти та поглянути. У тебе все так погано? Не можу уявити, наскільки жахливою може бути відсутність мого товариства у твоєму житті.",shape=box,color=blue];
		j2445297821 -> j1939019405;
	j2146949199 [label="Ти матимеш мою допомогу. Мені шкода, що твій диявол далі нападе на Марі.",shape=box,color=blue];
		j2146949199 -> j92487004;
	j4193316754 [label="Ти матимеш мою допомогу. А тепер відклич свого диявола.",shape=box,color=blue];
		j4193316754 -> j770168571;
	j3269971586 [label="Що ж. Це було величезне марнування часу, чи не так?",shape=box,color=red];
		j3269971586 -> "Chat ends.";
	j220990981 [label="Гадаю, я… просто скажу, що мені шкода, що не хотілося дослухатися до тебе.",shape=box,color=red];
		j220990981 -> j3832077500;
	j1939019405 [label="Так і є, Ліоне. Ти важливий мені. І я знаю, що то була величезна помилка.",shape=box,color=red];
		j1939019405 -> j4230194889;
	j92487004 [label="Boolean LyonFamilySuccess is now true.",color=orange];
		j92487004 -> j547953661;
	j770168571 [label="Boolean LyonFamilySuccess is now true.",color=orange];
		j770168571 -> j3711686580;
	j3832077500 [label="Можу запитати, чому ж так було? Тобі було лячно? Може, усе набридло? Або тобі здавалося, що в тебе достатньо сил пережити це все?",shape=box,color=blue];
		j3832077500 -> j2703928030;
		j3832077500 -> j3304265738;
		j3832077500 -> j2532290348;
	j4230194889 [label="І мені дуже, дуже прикро.",shape=box,color=red];
		j4230194889 -> j1155946576;
	j547953661 [label="Boolean LyonFamilyFail is now false.",color=orange];
		j547953661 -> "Initiate conversation MarieLyonRepair in /Lotus/Types/Gameplay/1999Wf/Dialogue/MarieDialogue_rom.dialogue";
	j3711686580 [label="Boolean LyonFamilyFail is now false.",color=orange];
		j3711686580 -> "Chat ends.";
	j2703928030 [label="Мені було страшно.",shape=box,color=red];
		j2703928030 -> j3462390873;
	j3304265738 [label="Мені здавалося, що мені буде не під силу продовжувати.",shape=box,color=red];
		j3304265738 -> j3462390873;
	j2532290348 [label="Тоді мені було байдуже. Зараз ні.",shape=box,color=red];
		j2532290348 -> j706234738;
	j1155946576 [label="У мене не було іншого вибору, окрім як попросити Роута про допомогу.",shape=box,color=red];
		j1155946576 -> j3451782485;
	"Initiate conversation MarieLyonRepair in /Lotus/Types/Gameplay/1999Wf/Dialogue/MarieDialogue_rom.dialogue" [label="Initiate conversation MarieLyonRepair in /Lotus/Types/Gameplay/1999Wf/Dialogue/MarieDialogue_rom.dialogue",color=orange];
		"Initiate conversation MarieLyonRepair in /Lotus/Types/Gameplay/1999Wf/Dialogue/MarieDialogue_rom.dialogue" -> "Chat ends.";
	j3462390873 [label="Тоді я маю лише один вибір: пробачити тобі. ",shape=box,color=blue];
		j3462390873 -> j106665696;
	j706234738 [label="А що ж змінилося, що тепер не байдуже?",shape=box,color=blue];
		j706234738 -> j2086281312;
		j706234738 -> j1216322959;
	j3451782485 [label="Evaluate expressions",color=orange];
		j3451782485 -> j3321331292 [label="MarieDating",color=purple];
		j3451782485 -> j506640439 [label="RoatheDating",color=purple];
		j3451782485 -> j1462459426 [label="false",color=purple];
	j106665696 [label="Boolean LyonConfessionFail is now false.",color=orange];
		j106665696 -> "Chat ends.";
	j2086281312 [label="Моя думка про тебе змінилася.",shape=box,color=red];
		j2086281312 -> j3462390873;
	j1216322959 [label="Я відчуваю, що є певний поступ, який може бути заблокований через твої історії.",shape=box,color=red];
		j1216322959 -> j3243082035;
	j3321331292 [label="Я дуже… зворушений. І… я не ознайомлений з традиціями та звичаями стосовно цього в майбутньому, тож не маю сумнівів у щирості твого послання. Але зрештою відмовлюся.",shape=box,color=blue];
		j3321331292 -> j2237091206;
	j506640439 [label="Я дуже… зворушений. І… я не ознайомлений з традиціями та звичаями стосовно цього в майбутньому, тож не маю сумнівів у щирості твого послання. Але зрештою відмовлюся.",shape=box,color=blue];
		j506640439 -> j1610453764;
	j1462459426 [label="У мене, звісно, немає іншого вибору, окрім як пробачити тобі. Я не розумію, навіщо тобі така зламана річ, як я, яка тільки захаращуватиме твій простір.",shape=box,color=blue];
		j1462459426 -> j2100001856;
	j3243082035 [label="Спосіб досягання цілі.",shape=box,color=blue];
		j3243082035 -> "Chat ends.";
	j2237091206 [label="Так чи інак, але ти наразі… з Марі. Вона занадто дорога для мене й навіть думати не хочу, щоби твої стосунки зі мною забирали час для неї. Або якось завадили вашим стосункам.",shape=box,color=blue];
		j2237091206 -> j392932580;
	j1610453764 [label="Так чи інак, але ти наразі… з Роутом. Я не збираюся навіть уявляти до яких ускладнень призведуть такі зв'язки.",shape=box,color=blue];
		j1610453764 -> j3663104781;
	j2100001856 [label="Але тепер, коли я знаю, на які дивні шляхи ти можеш ступати, моє роздратування твоїми словами зменшується.",shape=box,color=blue];
		j2100001856 -> j2398113586;
	j392932580 [label="Напевно я дуже старомодний у цьому плані. Вона як сім’я для мене. Ми занадто близькі. Я ходячий релікт, так би мовити. Тож ти вже пробач мені.",shape=box,color=blue];
		j392932580 -> j6226238;
	j3663104781 [label="Моя свідомість достатньо заплутана й так, особливо, коли думаю про вас із ним, якого я так добре знаю. Напевно я дуже старомодний у цьому плані. Ходячий релікт, так би мовити. Ти вже пробач мені.",shape=box,color=blue];
		j3663104781 -> j6226238;
	j2398113586 [label="Boolean LyonDating is now true.",color=orange];
		j2398113586 -> j3015983147;
	j6226238 [label="Ліон",shape=box,color=blue];
		j6226238 -> "Chat ends.";
	j3015983147 [label="Boolean IsDating is now true.",color=orange];
		j3015983147 -> j1098454340;
	j1098454340 [label="Boolean LyonHasDated is now true.",color=orange];
		j1098454340 -> j2749259789;
	j2749259789 [label="Boolean LyonWillDate is now true.",color=orange];
		j2749259789 -> j1458716842;
	j1458716842 [label="Boolean LyonNoDate is now false.",color=orange];
		j1458716842 -> "Chat ends.";
