digraph {
	"LyonRank3Convo3 begins." [color=orange];
		"LyonRank3Convo3 begins." -> j2803676645;
	j2803676645 [label="Я допомагав пану Лойду в його бібліотеці, розставляючи книги на полицях, хоча він наполягав, що ці дивні летючі… пристрої можуть зробити це замість мене.",shape=box,color=blue];
		j2803676645 -> j2271253683;
	j2271253683 [label="І я натрапив на цікаву книгу, в якій детально описуються дитячі казки, дія яких відбувається у вигаданому світі, створеному Евлерією Ентраті.",shape=box,color=blue];
		j2271253683 -> j1209932533;
	j1209932533 [label="Помітивши, що авторка мала те саме прізвище, що й насправді «кардинал Діманш», я одразу відклав цю книгу для себе.",shape=box,color=blue];
		j1209932533 -> j1296847366;
		j1209932533 -> j1496874585;
		j1209932533 -> j427271942;
	j1296847366 [label="Здається, я знаю, про яку книгу ти говориш…",shape=box,color=red];
		j1296847366 -> j889787620;
	j1496874585 [label="Чи можемо ми відразу перейти до суті? Запитай мене, що ти хочеш знати.",shape=box,color=red];
		j1496874585 -> j257169007;
	j427271942 [label="[Не зважати]",shape=box,color=red];
		j427271942 -> "Chat ends.";
	j889787620 [label="+5 Chemistry",color=orange];
		j889787620 -> j3228186808;
	j257169007 [label="Boolean LyonMITW1 is now true.",color=orange];
		j257169007 -> j2623881729;
	"Chat ends." [color=orange];
	j3228186808 [label="Судячи з жахливого погляду, який кинув на мене пан Лойд, і його наполягання, щоб я негайно повернув книгу, «щоби не засмучувати тебе», я підозрюю, що ти дійсно щось про це знаєш.",shape=box,color=blue];
		j3228186808 -> j1341234762;
	j2623881729 [label="Моє питання стосується природи «концептуального втілення». Прочитавши книгу, я зрозумів, що вона була призначена для того, щоб навчити дітей не дозволяти своїм емоціям взаємодіяти з Порожнечею.",shape=box,color=blue];
		j2623881729 -> j628088003;
		j2623881729 -> j2882413894;
	j1341234762 [label="«Дувірські казки». Хоч я отримав від пана Лойда досить… вичерпне і виснажливе пояснення того, що спіткало тебе там, є одна конкретна справа, про яку я хотів би дізнатися.",shape=box,color=blue];
		j1341234762 -> j1241969989;
	j628088003 [label="Хоча це мало що дало. Особливо в моєму випадку.",shape=box,color=red];
		j628088003 -> j4148167645;
	j2882413894 [label="Сильні емоції, що взаємодіють із Порожнечею, можуть спричинити… серйозні проблеми.",shape=box,color=red];
		j2882413894 -> j3222735121;
	j1241969989 [label="Якщо, звичайно, це не занадто складно?",shape=box,color=blue];
		j1241969989 -> j4075193645;
		j1241969989 -> j3473911506;
	j4148167645 [label="Скільки в нашому житті було визначено іншими як факт, який виявився марним після перевірки?",shape=box,color=blue];
		j4148167645 -> j1032683926;
	j3222735121 [label="Схоже на те. Я бачив кавій. Мені розповідали про янголів Порожнечі. Я чув Шепіт на власні вуха. ",shape=box,color=blue];
		j3222735121 -> j3506652051;
	j4075193645 [label="Ні. Питай.",shape=box,color=red];
		j4075193645 -> j257169007;
	j3473911506 [label="Я думаю, це повністю залежить від деталей. Я не маю уявлення, про що ти збираєшся мене запитати.",shape=box,color=red];
		j3473911506 -> j1727843277;
	j1032683926 [label="Boolean LyonFaith1 is now true.",color=orange];
		j1032683926 -> j50858375;
	j3506652051 [label="І така вже природа моєї цікавості. Я вирішив запитати це прямо, щоб побачити, чи зможеш ти це пояснити. Коли Порожнеча набуває форми, те, що виходить з неї — чи є «реальним»?",shape=box,color=blue];
		j3506652051 -> j872454742;
		j3506652051 -> j3249992531;
		j3506652051 -> j2175045323;
	j1727843277 [label="+5 Chemistry",color=orange];
		j1727843277 -> j573949928;
	j50858375 [label="Я часто ставлю собі питання, навіщо заповнювати голови інших такою марною брехнею? Чи це влада, якої вони прагнуть? Вплив? Чи ти думаєш, що вони щиро вірять у свої слова і не усвідомлюють своєї неправди?",shape=box,color=blue];
		j50858375 -> j2858076770;
		j50858375 -> j1886745731;
	j872454742 [label="Ні, я думаю, що все, створене Порожнечею, є просто… тимчасовим. Фрагмент того, хто або що це створило. Примарний спогад.",shape=box,color=red];
		j872454742 -> j2312758262;
	j3249992531 [label="Я вважаю, що так. Як картина, написана художником, вона могла з’явитися в чиїйсь уяві, але після створення стає реальною.",shape=box,color=red];
		j3249992531 -> j1393570452;
	j2175045323 [label="Це повністю залежить від твого визначення поняття «реальний».",shape=box,color=red];
		j2175045323 -> j1297263099;
	j573949928 [label="Так, пробач. Я не смію просто… висловлювати свої думки прямо. Особливо в такий дивний спосіб, як цей. Але я пробую зробити це зараз.",shape=box,color=blue];
		j573949928 -> j257169007;
	j2858076770 [label="У цьому випадку, я думаю, Евлерія Ентраті мала на увазі, що те, що вона написала, буде корисним. Це просто не допомогло мені, коли було потрібно.",shape=box,color=red];
		j2858076770 -> j1951981409;
	j1886745731 [label="Я не знаю. Якими брехнями наповнювали твою голову, Ліоне?",shape=box,color=red];
		j1886745731 -> j761690927;
	j2312758262 [label="Тоді чи не є ефекти, спричинені такими елементами Порожнечі, «реальними»?",shape=box,color=blue];
		j2312758262 -> j3899877933;
	j1393570452 [label="Але аналогія, яку ти використовуєш, не зовсім точна, хіба ні? Матерія, витягнута з Порожнечі, повертається до Порожнечі, чи не так?",shape=box,color=blue];
		j1393570452 -> j2372266873;
	j1297263099 [label="+5 Chemistry",color=orange];
		j1297263099 -> j3650972062;
	j1951981409 [label="На її захист скажу, що моє перебування у Порожнечі було набагато тривалішим, ніж те, для чого вона планувала використовувати книгу як посібник.",shape=box,color=red];
		j1951981409 -> j2728937280;
	j761690927 [label="Жодними, про що я прийшов до тебе обговорити.",shape=box,color=blue];
		j761690927 -> "Chat ends.";
	j3899877933 [label="Чимало спогадів доводили людей до пияцтва чи спонукали до самогубства. Хіба ці спогади не є «реальними»?",shape=box,color=blue];
		j3899877933 -> j39001897;
	j2372266873 [label="Добре, тоді так. Вірш або пісня існують, навіть якщо вони не записані.",shape=box,color=red];
		j2372266873 -> j571182961;
	j3650972062 [label="Можна пояснити докладніше?",shape=box,color=blue];
		j3650972062 -> j2903845326;
	j2728937280 [label="+5 Chemistry",color=orange];
		j2728937280 -> j3886375359;
	j39001897 [label="Але я маю на увазі, що це були внутрішні сили, яким людина дозволила вплинути на себе. Не зовнішні.",shape=box,color=red];
		j39001897 -> j656908276;
	j571182961 [label="Але якщо ти їх забудеш, вони перестануть існувати. Історія, втрачена в часі, втрачена назавжди.",shape=box,color=blue];
		j571182961 -> j2133021696;
	j2903845326 [label="Як вимірюється «реальність»?",shape=box,color=red];
		j2903845326 -> j1757580438;
		j2903845326 -> j1448398797;
		j2903845326 -> j3372564355;
	j3886375359 [label="Нещасне невігластво — це найкраще, на що кожен з нас може сподіватися, щоб викликати злобу в інших.",shape=box,color=blue];
		j3886375359 -> j3365356970;
	j656908276 [label="Але в чому різниця, ось моє питання? Якщо кінцевий результат той самий, чи має це значення?",shape=box,color=blue];
		j656908276 -> j2293626364;
		j656908276 -> j2413249141;
		j656908276 -> j3857572536;
	j2133021696 [label="Революція, яка позбавлена умів, що нестимуть її — тупий меч насправді.",shape=box,color=blue];
		j2133021696 -> j2293626364;
		j2133021696 -> j2413249141;
		j2133021696 -> j3857572536;
	j1757580438 [label="За фізичною постійністю? За вагою і масою? Те, що прийшло з Порожнечі, перебуває тут лише тимчасово.",shape=box,color=red];
		j1757580438 -> j4139486799;
	j1448398797 [label="Завдяки своєму впливу на події? Те, що прийшло з Порожнечі, змінило хід історії.",shape=box,color=red];
		j1448398797 -> j2158414588;
	j3372564355 [label="Завдяки впливу на інших? Вплив «речей», що прийшли з Порожнечі, безсумнівно, сприяв цьому.",shape=box,color=red];
		j3372564355 -> j1807660960;
	j3365356970 [label="Однак моя цікавість стосується не книги та її корисності. Вибач, що я на мить став поетичним.",shape=box,color=blue];
		j3365356970 -> j1405443134;
	j2293626364 [label="Ти не питаєш, чи вони «реальні», ти питаєш, чи вони «дійсні». Чи слід їх відхиляти чи ні.",shape=box,color=red];
		j2293626364 -> j2672946185;
	j2413249141 [label="Я хочу спитати те ж саме, чи є ваші Світочі «реальними» лише тому, що ви не можете потиснути руку Солу чи Луа.",shape=box,color=red];
		j2413249141 -> j1396133768;
	j3857572536 [label="По суті, ти запитуєш, чи всі «речі» з Порожнечі існують тільки тому, що ми їх створили своєю волею.",shape=box,color=red];
		j3857572536 -> j3617609655;
	j4139486799 [label="Ти хочеш сказати, що те, що походить із Порожнечі, повинно повернутися до неї? Але хіба Порожнеча за визначенням не складається з нічого?",shape=box,color=blue];
		j4139486799 -> j3977297232;
	j2158414588 [label="Слушне зауваження. Хіба революція не є «реальною» тільки тому, що її не можна покласти в кошик і зважити?",shape=box,color=blue];
		j2158414588 -> j1807660960;
	j1807660960 [label="Це, безсумнівно, коштувало життя багатьом людям. Вони б дуже наполягали на її обґрунтованості. Однак, врахуй наступне:",shape=box,color=blue];
		j1807660960 -> j2905302420;
	j1405443134 [label="Я вирішив запитати це прямо, щоб побачити, чи зможеш ти це пояснити. Коли Порожнеча набуває форми, те, що виходить з неї — чи є «реальним»?",shape=box,color=blue];
		j1405443134 -> j872454742;
		j1405443134 -> j2175045323;
		j1405443134 -> j3249992531;
	j2672946185 [label="+5 Chemistry",color=orange];
		j2672946185 -> j3347408112;
	j1396133768 [label="Ми не обговорюємо Світочі. Ми обговорюємо Порожнечу.",shape=box,color=blue];
		j1396133768 -> j1133470625;
		j1396133768 -> j783022367;
		j1396133768 -> j3959172718;
		j1396133768 -> j2285495866;
	j3617609655 [label="+5 Chemistry",color=orange];
		j3617609655 -> j1677182421;
	j3977297232 [label="Мабуть? Ті частини Порожнечі, з якими в мене була взаємодія, як правило, вже мають відбиток. Ми вже надали її певної форми. Або ми занадто розмили межу між реальностями.",shape=box,color=red];
		j3977297232 -> j2503103750;
		j3977297232 -> j1570057417;
	j2905302420 [label="Революція набуває чинності лише завдяки тому, що вона існує в умах тих, хто її здійснює.",shape=box,color=blue];
		j2905302420 -> j1514177227;
	j3347408112 [label="Так, можна й так сказати. Чи слід нам ігнорувати привидів, які блукають нашими коридорами, чи, звертаючи на них увагу, ми лише підсилюємо їх?",shape=box,color=blue];
		j3347408112 -> j1133470625;
		j3347408112 -> j783022367;
		j3347408112 -> j3959172718;
		j3347408112 -> j2285495866;
	j1133470625 [label="Я вважаю, що виклики, з якими ми зараз стикаємося, є небезпечними. Надзвичайно небезпечними. І ми повинні ставитися до них відповідно.",shape=box,color=red];
		j1133470625 -> j1020549635;
	j783022367 [label="Привиди настільки реальні, що можуть заподіяти нам болю. Але їх не можна почастувати кулями. Принаймні, мені такі не траплялися.",shape=box,color=red];
		j783022367 -> j2844542658;
	j3959172718 [label="Що це все означає, Ліоне? Насправді?",shape=box,color=red];
		j3959172718 -> j519110277;
	j2285495866 [label="Я… чесно кажучи, не знаю, Ліоне. Хотілося, щоб це було так.",shape=box,color=red];
		j2285495866 -> j3580442909;
	j1677182421 [label="Так, можна й так сказати. Як ми можемо бути впевнені, що ми не… виявили своїх власних демонів?",shape=box,color=blue];
		j1677182421 -> j1133470625;
		j1677182421 -> j783022367;
		j1677182421 -> j3959172718;
		j1677182421 -> j2285495866;
	j2503103750 [label="Цілі конструкції, а точніше сама Луа, були поміщені в Порожнечу і повернуті. Отже, вона не споживає матерію, просто існуючи в ній.",shape=box,color=red];
		j2503103750 -> j994819124;
	j1570057417 [label="Ти маєш на увазі існування «глибшої» Порожнечі, де нічого не може існувати, і я, чесно кажучи, не можу про це говорити.",shape=box,color=red];
		j1570057417 -> j3713982143;
	j1514177227 [label="Якби її викреслили з думок оточення, вона перестала б існувати?",shape=box,color=blue];
		j1514177227 -> j2413249141;
		j1514177227 -> j2293626364;
		j1514177227 -> j3857572536;
	j1020549635 [label="Boolean LyonReal1 is now true.",color=orange];
		j1020549635 -> j72724795;
	j2844542658 [label="Boolean LyonFake1 is now true.",color=orange];
		j2844542658 -> j2930166828;
	j519110277 [label="Boolean LyonFaith1 is now true.",color=orange];
		j519110277 -> j1679399719;
	j3580442909 [label="Твоя чесність у визнанні того, що ти не знаєш — ковток свіжого повітря. Якби ж більше людей мали такий дар.",shape=box,color=blue];
		j3580442909 -> j822471705;
	j994819124 [label="Мені байдуже, що поміщається в Порожнечу, а потім повертається. Мене хвилює те, що було створено в Порожнечі з повного нічого.",shape=box,color=blue];
		j994819124 -> j2293626364;
		j994819124 -> j2413249141;
		j994819124 -> j3857572536;
	j3713982143 [label="Я ціную твою відвертість. Я думаю, що мене менше цікавить те, що не може існувати, ніж те, що існує зараз.",shape=box,color=blue];
		j3713982143 -> j2293626364;
		j3713982143 -> j2413249141;
		j3713982143 -> j3857572536;
	j72724795 [label="Так, я думаю, ти знаєш, що можна знищити силою з Порожнечі, а що ні…",shape=box,color=blue];
		j72724795 -> j1343013749;
	j2930166828 [label="Можливо, саме тому так багато хто вдається до надмірних заходів… щоби зупинити кровотечу з невидимої, але болючої рани. Вилікувати. Але силою духу, а не зброєю.",shape=box,color=blue];
		j2930166828 -> j1343013749;
	j1679399719 [label="Я явно неправильно підійшов до цього питання. Ми обговоримо це іншим разом. Вибач за втручання.",shape=box,color=blue];
		j1679399719 -> j3545001372;
	j822471705 [label="Попри це мої думки з цього приводу все ще залишаються повністю невизначеними.",shape=box,color=blue];
		j822471705 -> j1679399719;
	j1343013749 [label="Хоча я, як завжди, перебуваю в сумнівах. Вибач за втручання. Дякую за твій час, мандрівниче.",shape=box,color=blue];
		j1343013749 -> j3545001372;
	j3545001372 [label="Отець Ліон Аллард",shape=box,color=blue];
		j3545001372 -> "Chat ends.";
}