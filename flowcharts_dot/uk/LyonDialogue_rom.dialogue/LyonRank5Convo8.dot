		j1890799654 -> j3509754643 [label="false",color=purple];
	j3197638402 [label="Пробач мені. Я написав таке, що могло здатися натяками, яких я не мав на увазі. Просто хотів сказати, що ти доволі успішно його втішаєш.",shape=box,color=blue];
		j3197638402 -> j1340726807;
	j2706340363 [label="+5 Chemistry",color=orange];
		j2706340363 -> j1515829828;
	j217153919 [label="Якщо Марі першою до цього не доведе.",shape=box,color=blue];
		j217153919 -> "Chat ends.";
	j1800373243 [label="Завдяки тобі в ньому зародилося бажання самоаналізу. Вималювався напрям. Я невимовно вдячний тобі за це. І те саме стосується Марі, я знаю.",shape=box,color=blue];
		j1800373243 -> j2736567219;
	j946976279 [label="Завдяки тобі в ньому з’явилася певність. Мета. Я невимовно вдячний тобі за це. І те саме стосується Марі, я знаю.",shape=box,color=blue];
		j946976279 -> j2736567219;
	j3509754643 [label="Я не знаю, що його чекає далі. Сподіваюся, ми зможемо все владнати. Я боюся того, на що він обернеться, якщо надовго лишити його сам на сам.",shape=box,color=blue];
		j3509754643 -> "Chat ends.";
	j1340726807 [label="Я… Просто відійду від цього пристрою аж до завтра.",shape=box,color=blue];
		j1340726807 -> j2983580119;
	j1515829828 [label="Коли справа стосується тебе, то ми за багато чого вдячні.",shape=box,color=blue];
