	"Chat ends." [color=orange];
	j1003231858 [label="Маю визнати, що в цій удаваній крипті стало дедалі ліпше. Чи це в мене просто таке сприйняття. Бо мою увагу… трішки відвертали останнім часом.",shape=box,color=blue];
		j1003231858 -> j1890799654;
	j4080779393 [label="Маю визнати, що в цій удаваній крипті стало дедалі ліпше. Завдяки тобі в нього є куди вилити своє роздратування, чи не так?",shape=box,color=blue];
		j4080779393 -> j3197638402;
	j1395872979 [label="Завдяки тобі в ньому з’явилася певність. Мета. Я невимовно вдячний тобі за це. І те саме стосується Марі, я знаю.",shape=box,color=blue];
		j1395872979 -> j2706340363;
	j663670169 [label="Небагато змінилося, боюся. Думаю, що незабаром цей бідолашний звір від тривожності розірве себе на шмаття.",shape=box,color=blue];
		j663670169 -> j217153919;
