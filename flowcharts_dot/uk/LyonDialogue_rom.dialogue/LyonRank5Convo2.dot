	edge [fontname="Roboto Condensed"];

	"LyonRank5Convo2 begins." [color=orange];
		"LyonRank5Convo2 begins." -> j680575522;
	j680575522 [label="Evaluate expressions",color=orange];
		j680575522 -> j700641131 [label="LyonPainOff",color=purple];
		j680575522 -> j1822603719 [label="LyonBackstory3a",color=purple];
		j680575522 -> j3407763522 [label="LyonBackstory3b",color=purple];
		j680575522 -> j1966445142 [label="LyonBackstory2",color=purple];
		j680575522 -> j1966445142 [label="LyonBackstory1",color=purple];
		j680575522 -> j4280549812 [label="false",color=purple];
	j700641131 [label="+20 Chemistry",color=orange];
		j700641131 -> j1627123473;
	j1822603719 [label="Дякую, що вистачило терплячості читати це все, як і доброти, якої в тобі більше, аніж мало би бути. Знаю, тобі довелося чимало поміркувати про ту частину історії, де описувалася ніч, коли Луа була найтемнішою.",shape=box,color=blue];
		j1822603719 -> j3112040638;
	j3407763522 [label="Дякую, що вистачило терплячості читати це все. Знаю, тобі довелося чимало поміркувати про ту частину історії, де описувалася ніч, коли Луа була найтемнішою.",shape=box,color=blue];
		j3407763522 -> j3112040638;
	j1966445142 [label="Я знаю, що тобі довелося чимало поміркувати про моє минуле. І зокрема про ту частину історії, де описувалася ніч, коли Луа була найтемнішою.",shape=box,color=blue];
		j1966445142 -> j3112040638;
	j4280549812 [label="Я знаю, що тобі довелося чимало поміркувати після моєї розповіді й зокрема про ніч, коли Луа була найтемнішою.",shape=box,color=blue];
		j4280549812 -> j3112040638;
	j1627123473 [label="[Розмову пропущено внаслідок попередніх налаштувань щодо чутливого вмісту]",shape=box,color=blue];
		j1627123473 -> j370687875;
	j3112040638 [label="Цю історію я заприсягся ніколи не розповідати. Лише Марі знає… лише тому, що читала в моїх записах. Але зараз, я викладу тобі все тут.",shape=box,color=blue];
		j3112040638 -> j1520025906;
	j370687875 [label="Boolean LyonConfession1 is now true.",color=orange];
		j370687875 -> "Chat ends.";
	j1520025906 [label="Щойно я почну, то не зможу зупинитися, бо потім не зможу знову почати. Тож ти маєш пробачити мені, що не дам ставити запитати.",shape=box,color=blue];
		j1520025906 -> j557871803;
		j1520025906 -> j412912047;
		j1520025906 -> j3273652495;
		j1520025906 -> j69289087;
	"Chat ends." [color=orange];
	j557871803 [label="Звісно.",shape=box,color=red];
		j557871803 -> j526672947;
	j412912047 [label="[Дати йому дописати]",shape=box,color=red];
		j412912047 -> j3745358808;
	j3273652495 [label="[УВАГА: обговорення самоушкодження й жорстокого поводження з дітьми. Клацніть сюди, щоби завершити розмову. Жодних одиниць сумісності з Ліоном не буде втрачено.]",shape=box,color=red];
		j3273652495 -> j784838610;
	j69289087 [label="[Завершити розмову]",shape=box,color=red];
		j69289087 -> j3856020424;
	j526672947 [label="Дякую.",shape=box,color=blue];
		j526672947 -> j141195667;
	j3745358808 [label="+5 Chemistry",color=orange];
		j3745358808 -> j526672947;
	j784838610 [label="Check boolean LyonSpeech",color=orange];
		j784838610 -> j3342655806 [label=true,color=green];
		j784838610 -> j112513520 [label=false,color=brown];
	j3856020424 [label="Boolean LyonConfessionFail is now true.",color=orange];
		j3856020424 -> "Chat ends.";
	j141195667 [label="Evaluate expressions",color=orange];
		j141195667 -> j810097690 [label="LyonBackstory3a",color=purple];
		j141195667 -> j810097690 [label="LyonBackstory3b",color=purple];
		j141195667 -> j4207773857 [label="false",color=purple];
	j3342655806 [label="+20 Chemistry",color=orange];
		j3342655806 -> j370687875;
	j112513520 [label="Якщо ти вважаєш цей вибір проявом боягузства, закликаю тебе — не варто. Це не твій біль, не твоя боротьба. Це — моє. Цей тягар не був прошеним тобою.",shape=box,color=blue];
		j112513520 -> j3821841031;
	j810097690 [label="Ми говорили про мою сім’ю. Про моє життя на фермі, де я виріс. Про видіння, які переслідували й доводили до нападів жорстокості й насилля.",shape=box,color=blue];
		j810097690 -> j3082560030;
	j4207773857 [label="Я знаю, що небагато розповідав про те, хто мене виростив. Боюся, що для цього є вагомі причини.",shape=box,color=blue];
		j4207773857 -> j130323205;
	j3821841031 [label="Цей механічний пристрій, за допомогою якого ми спілкуємося, створює ілюзію прихованої особистості. Наче ми якимось чином захищені від будь-якої кривди, яку можуть завдати інші, надрукувавши будь-що.",shape=box,color=blue];
		j3821841031 -> j3721270233;
	j3082560030 [label="Я розповідав про голоси, що шепотіли до мене, кликали з інших приміщень. Іноді здавалося, що вони називають моє ім’я…",shape=box,color=blue];
		j3082560030 -> j2640325412;
	j130323205 [label="Мати моя… сприймала видіння як прокляття диявола. І думала, що зможе вибити його з мене палюгою. Іноді так, що я навіть стояти не міг.",shape=box,color=blue];
		j130323205 -> j367483037;
	j3721270233 [label="Та я радше б доводив протилежне — звільнившись від обладунків, у які вбираємось у звичайних соціальних взаємодіях, ми позбуваємося того, що може захистити нас.",shape=box,color=blue];
		j3721270233 -> j3129706441;
	j2640325412 [label="Іноді вони взагалі ні на що не були схожими. Якесь ахінейське бурмотіння чи диявольський регіт.",shape=box,color=blue];
		j2640325412 -> j1397503716;
	j367483037 [label="А батько? Ну. Яка б не була жорстока матінка, то він був гірше. Позбавлю тебе подробиць.",shape=box,color=blue];
		j367483037 -> j2051489344;
	j3129706441 [label="Тому, у подібних ситуаціях… я чудово розумію, що можу випустити стрілу, яка влучить не в загартованого в битвах і готового до всього солдата, а в яремну вену оленя, який безпечно гуляє лісом.",shape=box,color=blue];
		j3129706441 -> j2830486541;
	j1397503716 [label="Спершу вся та несуттєва безглузда словесна маячна лякала мене. Я благав сенсу в них. Я молився Луа, щоби дух її переказав мені, чого їм треба від мене.",shape=box,color=blue];
		j1397503716 -> j2325149438;
	j2051489344 [label="Та їхню жорстокість не можна було порівняти з моєю. Мої видіння часто ускладнювали боротьбу, особливо після того, як я став дорослішим, вищим і кремезнішим за батька.",shape=box,color=blue];
		j2051489344 -> j2081932221;
	j2830486541 [label="Тож наостанок я напишу таке:",shape=box,color=blue];
		j2830486541 -> j2248775376;
	j2325149438 [label="Але коли почав розшифровувати чого вони хочуть… то пошкодував про те, що так відчайдушно вимолював. Бо взнав, які діяння від їхнього імені вони вимагали вчиняти.",shape=box,color=blue];
		j2325149438 -> j1615159614;
	j2081932221 [label="І ці видіння часто набирали форми голосів. Іноді здавалося, що вони вимовляють моє ім’я… кличуть…",shape=box,color=blue];
		j2081932221 -> j2640325412;
	j2248775376 [label="Ми повинні нагадувати собі, що маємо знаходити сили допомагати іншим звестися на ноги, навіть коли в самих не має волі стояти.",shape=box,color=blue];
		j2248775376 -> j3469852364;
	j1615159614 [label="Ох і жахливу ціну вони мали сплатити.",shape=box,color=blue];
		j1615159614 -> j2914971481;
	j3469852364 [label="Ось це і є істинною мораллю притчі.",shape=box,color=blue];
		j3469852364 -> j1470391647;
	j2914971481 [label="Не зрозумій мене неправильно. Я не любив ані батька, ані матір. Уся відданість сімейним цінностям, яка могла бути, давно зникла під безліччю шрамів та синців.",shape=box,color=blue];
		j2914971481 -> j383148570;
	j1470391647 [label="+20 Chemistry",color=orange];
		j1470391647 -> j2639299387;
	j383148570 [label="Але що мене закликали зробити з ними?.. І що змусили скоїти… у ту найтемнішу з ночей?..",shape=box,color=blue];
		j383148570 -> j609604499;
	j2639299387 [label="Бувай, мандрівниче. Невдовзі поспілкуємося знову.",shape=box,color=blue];
		j2639299387 -> j2472733422;
	j609604499 [label="Я ледве вийшов з періоду хлопчика — ще не став чоловіком. Може було мені шістнадцять? Вісімнадцять? Спершу я подумав, що це чергове моторошне жахіття — химерний сон.",shape=box,color=blue];
		j609604499 -> j3071027090;
	j2472733422 [label="Отець Ліон Аллард",shape=box,color=blue];
		j2472733422 -> j370687875;
	j3071027090 [label="Довкола мене були постаті, спотворені й змучені — виткані зі злоби й тіней.",shape=box,color=blue];
		j3071027090 -> j23814141;
	j23814141 [label="Насміхалися, вимагали зробити те, що потрібно було… що ті, хто каже, що люблять мене, захочуть мою плоть… то я, натомість, маю взяти їхню…",shape=box,color=blue];
		j23814141 -> j1207414893;
	j1207414893 [label="Коли я прокинувся від того жахіття, чи може я й не спав, я не знаю, то в моїй руці був мисливський ніж. А стояв я в одвірку кімнати батьків.",shape=box,color=blue];
		j1207414893 -> j572532327;
	j572532327 [label="Надворі — місяць-молодик. А хмари дуже густі. Ані промінчика світла, щоби щось розгледіти. Абсолютна темрява. ",shape=box,color=blue];
		j572532327 -> j3792236396;
	j3792236396 [label="Луа покинула мене.",shape=box,color=blue];
		j3792236396 -> j3815159737;
	j3815159737 [label="Я не міг відгукнутися на заклик голосів. Я не міг отак взяти й віддати їм душі батька та матері.",shape=box,color=blue];
		j3815159737 -> j4088361820;
	j4088361820 [label="Я утік у глуху ніч. У хащі лісів, гілки розривали мою оголену шкіру, а мені було все одно до болю.",shape=box,color=blue];
		j4088361820 -> j1055965539;
	j1055965539 [label="Я біг, допоки ноги не підвели й не могли далі нести мене. Може я й ридав, я не знаю.",shape=box,color=blue];
		j1055965539 -> j2662061900;
	j2662061900 [label="Але ті кляті породження моєї голови йшли слідом. І досі шепітливо прагли крові.",shape=box,color=blue];
		j2662061900 -> j3538455722;
	j3538455722 [label="Я сподівався, що як не бачитиму їх, то вони можуть піти геть… і тоді встромив того ножа собі в око…",shape=box,color=blue];
		j3538455722 -> j1479982995;
	j1479982995 [label="Шкода, що знепритомнів і не зміг довести справу до кінця. Тож я тепер ніколи не дізнаюся.",shape=box,color=blue];
		j1479982995 -> j1440324367;
	j1440324367 [label="Отямився в місцевій церкві Луа. Один із братчиків знайшов мене й перев’язав рани. Він спитав від чого я тікав.",shape=box,color=blue];
		j1440324367 -> j2479068708;
	j2479068708 [label="Я був виснаженим. Не було сил брехати. Я зізнався у всьому — розповів про видіння, про їхні накази. Я чекав на осуд.",shape=box,color=blue];
		j2479068708 -> j2124885433;
	j2124885433 [label="Як замовк, то побачив його тямущу посмішку. Він уклав амулет Луа у мою долоню. «Сину мій, вона є благословення. І вона є прокляття».",shape=box,color=blue];
		j2124885433 -> j376034190;
	j376034190 [label="Він відіслав мене до собору у Cité de la Lumière. І там я був, допоки Ентраті не знайшов мене…",shape=box,color=blue];
		j376034190 -> j2239227846;
	j2239227846 [label="Ну ось… ось тобі й маєш.",shape=box,color=blue];
		j2239227846 -> j2907376852;
	j2907376852 [label="А я… зараз я маю йти.",shape=box,color=blue];
		j2907376852 -> j2909166201;
	j2909166201 [label="Boolean LyonConfession1 is now true.",color=orange];
		j2909166201 -> j3349784873;
	j3349784873 [label="+20 Chemistry",color=orange];
		j3349784873 -> j6226238;
	j6226238 [label="Ліон",shape=box,color=blue];
		j6226238 -> "Chat ends.";
}