	j2864307584 [label="+20 Chemistry",color=orange];
		j2864307584 -> j2014428532;
	j4273036776 [label="My friend, you have been patient with me, and kinder than you have had any right to be. I know you have wondered after this part of my story - of the night when Lua was at her darkest.",shape=box,color=blue];
		j4273036776 -> j3749376247;
	j2911676221 [label="My friend, you have been patient with me. I know you have wondered after this part of my story - of the night when Lua was at her darkest.",shape=box,color=blue];
		j2911676221 -> j3749376247;
	j668911688 [label="My friend, you have wondered after my past. And I know you must have wondered after this part of my story - of the night when Lua was at her darkest.",shape=box,color=blue];
		j668911688 -> j3749376247;
	j1209098714 [label="My friend, I know you must have wondered after my story, and of the night when Lua was at her darkest.",shape=box,color=blue];
		j1209098714 -> j3749376247;
	j2014428532 [label="[Conversation skipped due to previous setting of trigger warning.]",shape=box,color=blue];
		j2014428532 -> j370687875;
	j3749376247 [label="It is a tale I vowed I would never speak. Only Marie knows of it, as she read it in my journals. And now, I shall put it here for you.",shape=box,color=blue];
		j3749376247 -> j2274239104;
	j370687875 [label="Boolean LyonConfession1 is now true.",color=orange];
		j370687875 -> "Chat ends.";
	j2274239104 [label="Once I begin, I cannot stop, for I will not be able to start again. So you will have to forgive me if I do not let you ask questions of me.",shape=box,color=blue];
		j2274239104 -> j2304681845;
		j2274239104 -> j4268090585;
		j2274239104 -> j2602567644;
		j2274239104 -> j69289087;
	"Chat ends." [color=orange];
	j2304681845 [label="Of course.",shape=box,color=red];
		j2304681845 -> j4268944479;
	j4268090585 [label="[Дати йому дописати]",shape=box,color=red];
		j4268090585 -> j1562040802;
	j2602567644 [label="[УВАГА: обговорення самоушкодження й жорстокого поводження з дітьми. Клацніть сюди, щоби завершити розмову. Жодних одиниць сумісності з Ліоном не буде втрачено]",shape=box,color=red];
		j2602567644 -> j784838610;
	j69289087 [label="[Завершити розмову]",shape=box,color=red];
		j69289087 -> j3856020424;
	j4268944479 [label="Thank you.",shape=box,color=blue];
		j4268944479 -> j141195667;
	j1562040802 [label="+5 Chemistry",color=orange];
		j1562040802 -> j4268944479;
	j784838610 [label="Check boolean LyonSpeech",color=orange];
		j784838610 -> j3342655806 [label=true,color=green];
		j784838610 -> j2530936755 [label=false,color=brown];
	j3856020424 [label="Boolean LyonConfessionFail is now true.",color=orange];
		j3856020424 -> "Chat ends.";
	j141195667 [label="Evaluate expressions",color=orange];
		j141195667 -> j4247514626 [label="LyonBackstory3a",color=purple];
		j141195667 -> j4247514626 [label="LyonBackstory3b",color=purple];
		j141195667 -> j1318492307 [label="false",color=purple];
	j3342655806 [label="+20 Chemistry",color=orange];
		j3342655806 -> j370687875;
	j2530936755 [label="If you were to consider yourself a coward for this choice, I beseech you - do not. For this is a pain that is not yours to face. It is mine. You did not ask to bear this moment.",shape=box,color=blue];
		j2530936755 -> j881172743;
	j4247514626 [label="We spoke of my family. Of my time upon the farm where I was raised. Of the visions that have plagued me and drove me to violence.",shape=box,color=blue];
		j4247514626 -> j3294638855;
	j1318492307 [label="I know there is not much I have told you about those who have raised me. And that is for good reason, I fear.",shape=box,color=blue];
		j1318492307 -> j3520200285;
	j881172743 [label="This mechanical contraption at which we sit creates an impression of veiled impersonality. That we are somehow sheltered from whatever harm another might cause us through whatever words they type to us upon it.",shape=box,color=blue];
		j881172743 -> j1126320576;
	j3294638855 [label="I told you of the voices that I would hear, whispering to me, calling to me from other rooms. Sometimes they sounded as though they called my name -",shape=box,color=blue];
		j3294638855 -> j286157694;
	j3520200285 [label="My mother... took my visions as the work of the devil. And sought to beat them from me with a switch. Often until I could not stand.",shape=box,color=blue];
		j3520200285 -> j1644707787;
	j1126320576 [label="I would argue instead the opposite - that free of the armor we don in our more mundane social interactions, we are stripped of that which might protect us.",shape=box,color=blue];
		j1126320576 -> j1672478815;
	j286157694 [label="Other times, they would sound like nothing at all. Garbled nonsense, or the language of devils.",shape=box,color=blue];
		j286157694 -> j3690339159;
	j1644707787 [label="And my father? Well. For all my mother's cruelty, my father was worse. I shall save you the details.",shape=box,color=blue];
		j1644707787 -> j3989881007;
	j1672478815 [label="Therefore, in situations like these... I am well aware that I let loose an arrow that might find not the battle-ready soldier, but the unsuspecting jugular of a deer in the woods.",shape=box,color=blue];
		j1672478815 -> j2266605041;
	j3690339159 [label="At first, the nonsensical ravings of the words terrified me. I begged them to make sense. I prayed to Lua for her spirits to tell me what they wished of me.",shape=box,color=blue];
		j3690339159 -> j233861515;
	j3989881007 [label="But their violence was not without a match from my own. My visions often made me difficult to contend with - particularly when I was grown, and taller and stronger in stature than even my father.",shape=box,color=blue];
		j3989881007 -> j3512554381;
	j2266605041 [label="So I shall, therefore, leave you with this:",shape=box,color=blue];
		j2266605041 -> j3540102370;
	j233861515 [label="But when I began to decipher what it is they desired - I regretted that for which I had so desperately prayed. For now, I knew the deeds they demanded I carry out in their name.",shape=box,color=blue];
		j233861515 -> j2439727509;
	j3512554381 [label="And these visions often took the form of voices. Sometimes they sounded as though they called my name -",shape=box,color=blue];
		j3512554381 -> j286157694;
	j3540102370 [label="We must remind ourselves how to find the strength to pull another to their feet, even when we cannot find the will to stand.",shape=box,color=blue];
		j3540102370 -> j2366215578;
	j2439727509 [label="And oh, what a horrible price they would have paid.",shape=box,color=blue];
		j2439727509 -> j1087731164;
	j2366215578 [label="That is the true purpose of story.",shape=box,color=blue];
		j2366215578 -> j3632426270;
	j1087731164 [label="Do not mistake me. I had no love for my father nor my mother. Whatever familial loyalty I might have felt for them was long since spent beneath a litany of bruises and scars.",shape=box,color=blue];
		j1087731164 -> j1470910277;
	j3632426270 [label="+20 Chemistry",color=orange];
		j3632426270 -> j3124450648;
	j1470910277 [label="But what they cried out for me to do for them...? And what they compelled me to do, in that darkest of nights...?",shape=box,color=blue];
		j1470910277 -> j1865462527;
	j3124450648 [label="Be well, Drifter. We shall speak again soon.",shape=box,color=blue];
		j3124450648 -> j2472733422;
	j1865462527 [label="I was barely even more than a boy - hardly even a man. Perhaps I was sixteen years? Eighteen? At first, I thought it all another terrible nightmare - a twisted dream.",shape=box,color=blue];
		j1865462527 -> j2006584736;
	j2472733422 [label="Отець Ліон Аллард",shape=box,color=blue];
		j2472733422 -> j370687875;
	j2006584736 [label="Figures stood around me, gaunt and twisted manifestations, made purely of malice and shadow.",shape=box,color=blue];
		j2006584736 -> j1944605897;
	j1944605897 [label="Taunting me, demanding I do what must be done - that if those who claimed to love me would have my flesh... why I, in turn, must have theirs...",shape=box,color=blue];
		j1944605897 -> j1315441343;
	j1315441343 [label="When I awoke from the nightmare - or perhaps, I had always been awake, I do not rightly know, I had a hunting knife in my hand. And I stood at the door of my parent's room.",shape=box,color=blue];
		j1315441343 -> j1208686689;
	j1208686689 [label="The moon was new. And the clouds were thick. There was not the barest of light by which to see. The darkness was absolute. ",shape=box,color=blue];
		j1208686689 -> j2972285191;
	j2972285191 [label="Lua had abandoned me.",shape=box,color=blue];
		j2972285191 -> j2547725495;
	j2547725495 [label="I could not answer the call of the voices. I could not give them the souls of my mother and father.",shape=box,color=blue];
		j2547725495 -> j2322933802;
	j2322933802 [label="Into the empty night I fled. Into the deep woods, the branches tearing at my bare skin, though I could not have cared any less for the pain.",shape=box,color=blue];
		j2322933802 -> j3259981662;
	j3259981662 [label="I ran until my legs collapsed beneath me, unable to carry me any farther. I might have been weeping, I do not know.",shape=box,color=blue];
		j3259981662 -> j2478045321;
	j2478045321 [label="But the manifestations had followed. And still, they whispered for blood.",shape=box,color=blue];
		j2478045321 -> j3715240885;
	j3715240885 [label="I was hoping that if I could not see them, they might go away... when I drove that knife into my eye's socket...",shape=box,color=blue];
		j3715240885 -> j1773019924;
	j1773019924 [label="A shame I blacked out I and could not complete my task. Now, I will never know.",shape=box,color=blue];
		j1773019924 -> j4148356024;
	j4148356024 [label="When I awoke, I was in the local parish of Lua. A Brother had found me, and bandaged my wounds. He asked me what I had been running from.",shape=box,color=blue];
		j4148356024 -> j549687250;
	j549687250 [label="I was overwrought. I could not lie to him. I confessed it all - the visions, what they had told me to do. I expected condemnation.",shape=box,color=blue];
		j549687250 -> j1799777399;
	j1799777399 [label="When I finished, he simply smiled with such knowing sadness, and placed an amulet of Lua in my palm. \"She is a blessing and a curse, my son.\"",shape=box,color=blue];
		j1799777399 -> j256354990;
	j256354990 [label="He sent me to the Cathedral in the Cité de la Lumière. And there, I remained until Entrati found me...",shape=box,color=blue];
		j256354990 -> j3740237852;
	j3740237852 [label="There... now you have it.",shape=box,color=blue];
		j3740237852 -> j1430789445;
	j1430789445 [label="And... now I must go.",shape=box,color=blue];
		j1430789445 -> j2909166201;
	j2909166201 [label="Boolean LyonConfession1 is now true.",color=orange];
		j2909166201 -> j3349784873;
	j3349784873 [label="+20 Chemistry",color=orange];
		j3349784873 -> j6226238;
	j6226238 [label="Ліон",shape=box,color=blue];
		j6226238 -> "Chat ends.";
}