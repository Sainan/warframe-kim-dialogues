		j1073023867 -> j3869661241 [label="DrifterFaithAgnostic",color=purple];
		j1073023867 -> j1697045387 [label="DrifterFaithNoFear",color=purple];
		j1073023867 -> j3869661241 [label="DrifterFaithNoFear",color=purple];
		j1073023867 -> j645839991 [label="DrifterFaithNoMaybe",color=purple];
		j1073023867 -> j3869661241 [label="DrifterFaithNoMaybe",color=purple];
		j1073023867 -> j819887656 [label="DrifterFaithNoMITW",color=purple];
		j1073023867 -> j3869661241 [label="DrifterFaithNoMITW",color=purple];
		j1073023867 -> j3869661241 [label="false",color=purple];
	j1531766527 [label="Боюся, це одна з тем, які я можу довго обговорювати. Але не зрозумій мене неправильно… Я б і з задоволенням, але не хотілося б знудити тебе до сліз. То з чого бажаєш почати?",shape=box,color=blue];
		j1531766527 -> j2041916743;
		j1531766527 -> j323029546;
	j3869661241 [label="Ні, просто це мене цікавить найбільше.",shape=box,color=red];
		j3869661241 -> j2305594065;
	j2045068884 [label="У мене є релігія. Схожа на твою, однак ти не впізнаєш обрядів.",shape=box,color=red];
		j2045068884 -> j3182210700;
	j4267511193 [label="У мені є віра. Однак тобі не впізнати наших обрядів.",shape=box,color=red];
		j4267511193 -> j329138175;
	j1627507208 [label="У мені є віра. Це вірування особисте. У неї нема назви.",shape=box,color=red];
		j1627507208 -> j3523975000;
	j302704289 [label="Я йду шляхом Сола. Як і Марі.",shape=box,color=red];
		j302704289 -> j1367740430;
	j1160840482 [label="Як і ти, я йду шляхом Луа.",shape=box,color=red];
		j1160840482 -> j1367740430;
	j1198057875 [label="Я слідую за Світочами, але намагаюся триматися врівноваженого шляху.",shape=box,color=red];
		j1198057875 -> j1367740430;
	j949495342 [label="Я вірю, що щось десь там є. Але не думаю, що люди знають відповіді на подібні питання.",shape=box,color=red];
		j949495342 -> j906813116;
	j1697045387 [label="У мені нема віри. Без образ, я прагну думати, що релігія — милиця для боязких.",shape=box,color=red];
		j1697045387 -> j1202771358;
	j645839991 [label="У мені нема віри. Не скажу, що десь там нема чогось такого, але це мене просто не обходить.",shape=box,color=red];
		j645839991 -> j3553489647;
	j819887656 [label="У мені нема віри. Без образ, я думаю, що всі боги — навіть Байдужість — плід нашої уяви.",shape=box,color=red];
		j819887656 -> j488690915;
	j2041916743 [label="Можеш розповісти мені більше про ваші свята?",shape=box,color=red];
		j2041916743 -> j3779088260;
	j323029546 [label="Можеш розповісти мені більше про Сол і Луа?",shape=box,color=red];
		j323029546 -> j4134028033;
	j2305594065 [label="Check boolean LyonSuspicious",color=orange];
		j2305594065 -> j2609698088 [label=true,color=green];
		j2305594065 -> j1031263669 [label=false,color=brown];
	j3182210700 [label="+20 Chemistry",color=orange];
		j3182210700 -> j29834573;
	j329138175 [label="+20 Chemistry",color=orange];
		j329138175 -> j509012893;
	j3523975000 [label="І як тобі вдалося дійти до такої особистої віри, якщо ти не проти такого питання?",shape=box,color=blue];
		j3523975000 -> j2195843631;
		j3523975000 -> j2666434107;
		j3523975000 -> j3524341243;
	j1367740430 [label="+20 Chemistry",color=orange];
		j1367740430 -> j2786277372;
	j906813116 [label="+20 Chemistry",color=orange];
		j906813116 -> j1670950432;
	j1202771358 [label="+20 Chemistry",color=orange];
		j1202771358 -> j2275537720;
	j3553489647 [label="+20 Chemistry",color=orange];
		j3553489647 -> j41307963;
	j488690915 [label="Boolean LyonMITW2 is now true.",color=orange];
		j488690915 -> j3347115368;
	j3779088260 [label="Boolean LyonLectureHolidays is now true.",color=orange];
		j3779088260 -> j1615335173;
	j4134028033 [label="Boolean LyonLectureSolLua is now true.",color=orange];
		j4134028033 -> j2439397931;
	j2609698088 [label="Boolean DrifterLiar is now true.",color=orange];
		j2609698088 -> j2751415677;
	j1031263669 [label="Boolean LyonSuspicious is now true.",color=orange];
		j1031263669 -> j2751415677;
	j29834573 [label="Цікаво, як сильно вплинули наші релігії одна на одну. Навмисно чи ні, залежно від обставин.",shape=box,color=blue];
		j29834573 -> j3854510908;
	j509012893 [label="Неймовірно! Мені, як досліднику, було б дуже цікаво знайти час і дізнатися більше про різницю в наших віруваннях.",shape=box,color=blue];
		j509012893 -> j3854510908;
	j2195843631 [label="Це довга історія. ",shape=box,color=red];
		j2195843631 -> j812782060;
	j2666434107 [label="Мені вдалося дослідити велику купу релігій і вірувань. І ніяка з них мені ідеально не підходила. Зрештою, у мене зібралася дивовижна колекція.",shape=box,color=red];
		j2666434107 -> j2222133731;
	j3524341243 [label="Вірю в те, що відчуваю. І мені не треба будівля чи книга, щоб розповідати, що воно таке є.",shape=box,color=red];
		j3524341243 -> j3734781633;
	j2786277372 [label="Справді? Я… здивований. Здивований, але задоволений. І не дивно, що тобі цікаво. Наші вчення можуть бути дуже чужими для того, що тобі відомо. Стільки часу минуло.",shape=box,color=blue];
		j2786277372 -> j3854510908;
	j1670950432 [label="Я поважаю це. Заслуговує шани визнання того, що ми можемо не знати. Визнання дрібності людського існування.",shape=box,color=blue];
		j1670950432 -> j3854510908;
	j2275537720 [label="Мені повір ти, жодних образ. У багатьох випадках ти маєш рацію.",shape=box,color=blue];
		j2275537720 -> j1096190306;
		j2275537720 -> j1118579078;
	j41307963 [label="Зізнаюся, трохи заздрю тобі. Ти не знаходиш причин для хвилювання про те, що може чекати нас за вуаллю. Якби більше людей так чинило, то світ був би мирнішим у наші дні.",shape=box,color=blue];
		j41307963 -> j3854510908;
	j3347115368 [label="Я б хотів детальніше й довше обговорити цю тему. Але не сьогодні, бо я не підготовлений до подібної дискусії.",shape=box,color=blue];
		j3347115368 -> j3854510908;
	j1615335173 [label="Мудрий вибір для початку. Пізнавати культуру за її святами — пізнати її серце. Як люди святкують, так їх і пам’ятатимуть. Такі миті найцінніші для тих, хто поділяє їх.",shape=box,color=blue];
		j1615335173 -> j3606525646;
	j2439397931 [label="Звісно. Почнімо з того, що ти вже й так можеш знати. Сол і Луа, сонце й місяць. Це божественні сутності, які вічно перетворюються в собі.",shape=box,color=blue];
		j2439397931 -> j1312499454;
	j2751415677 [label="Гм. Я відповім на твою допитливість. Щоб не дуже занудьгувати, то з чого почнемо?",shape=box,color=blue];
		j2751415677 -> j323029546;
		j2751415677 -> j2041916743;
	j3854510908 [label="І я дуже відхилився від теми. Боюся, що дуже далеко відійшов від першочергового питання.",shape=box,color=blue];
		j3854510908 -> j1896223948;
	j812782060 [label="+20 Chemistry",color=orange];
		j812782060 -> j2724440642;
	j2222133731 [label="+20 Chemistry",color=orange];
		j2222133731 -> j2879512461;
	j3734781633 [label="+20 Chemistry",color=orange];
		j3734781633 -> j3387977958;
	j1096190306 [label="Однак це не означає, що я не зацікавлений чогось навчитися.",shape=box,color=red];
		j1096190306 -> j2786044692;
	j1118579078 [label="Що у твоєму випадку?",shape=box,color=red];
		j1118579078 -> j3532371127;
	j3606525646 [label="Наші основні й найурочистіші — це Зимове та Літнє сонцестояння. Вони позначають найкоротший і найдовший дні року.",shape=box,color=blue];
		j3606525646 -> j2925676793;
	j1312499454 [label="Упродовж багатьох століть у різних формах з’являлися вірянам. Іноді чоловіками, іноді жінками, навпаки й навспак. Але це завжди Сол, сонце. Завжди Луа, місяць.",shape=box,color=blue];
		j1312499454 -> j2141135979;
		j1312499454 -> j1313324722;
	j1896223948 [label="Хочеш дізнатися про православне вчення Світочів, так? Щоб не дуже занудьгувати, то з чого почнемо?",shape=box,color=blue];
		j1896223948 -> j323029546;
		j1896223948 -> j2041916743;
	j2724440642 [label="М-м. І найліпше розповідається вірним друзям. Я повністю розумію. Окрім того, це ти прагнеш отримати від мене інформацію, а не навпаки.",shape=box,color=blue];
		j2724440642 -> j3854510908;
	j2879512461 [label="Вітраж душі. Розібраний так схожий на розбиті друзки. Але ж яка краса, коли все зібрано до купи.",shape=box,color=blue];
		j2879512461 -> j3854510908;
	j3387977958 [label="Світ був би ліпшим місцем, якби всі поділяли твою віру.",shape=box,color=blue];
		j3387977958 -> j3854510908;
	j2786044692 [label="Хвалю за це твою допитливість та науковоцентричну натуру. ",shape=box,color=blue];
		j2786044692 -> j3854510908;
	j3532371127 [label="У моєму випадку… усе складно. Але не брехатиму й скажу, що страх був присутнім. Хоча релігія й додала його потоки в моє життя. Але так і не вимила.",shape=box,color=blue];
		j3532371127 -> j3854510908;
	j2925676793 [label="Обидва свята позначаються величезними бенкетами, але вони відрізняються тим, із ким ти святкуєш. Зимове Сонцестояння для родини й близьких друзів, а Літнє — для незнайомців.",shape=box,color=blue];
		j2925676793 -> j3468244470;
		j2925676793 -> j2108668822;
	j2141135979 [label="О, тепер це мені багато чого пояснило.",shape=box,color=red];
		j2141135979 -> j3497060450;
	j1313324722 [label="[Дати йому дописати]",shape=box,color=red];
		j1313324722 -> j3303691079;
	j3468244470 [label="Справді? Розкажи більше про Літнє Сонцестояння.",shape=box,color=red];
		j3468244470 -> j1141828415;
	j2108668822 [label="Розкажи більше про Зимове Сонцестояння.",shape=box,color=red];
		j2108668822 -> j3689912472;
	j3497060450 [label="Так, деякі секти можуть бути суворішими у виборах ікон, виголошуючи, що Сол «повинен» бути єдиним шляхом, або «повинно» бути якось інакше, але православ’я не визнає це доконаним фактом.",shape=box,color=blue];
		j3497060450 -> j4060939046;
	j3303691079 [label="Обоє Світочів містять у собі багато аспектів. Кожен з яких можна розглядати як дієвий шматочок цілого. Луа, до прикладу, матір, діва, карга.",shape=box,color=blue];
		j3303691079 -> j3922064235;
	j1141828415 [label="Літнє Сонцестояння — день великих щедрот та зустрічі незнайомців. Треба збиратися купи в полі, узявши із собою їжу й виготовлені власноруч товари, будь-які.",shape=box,color=blue];
		j1141828415 -> j2019793343;
	j3689912472 [label="Зимове Сонцестояння — день, коли ми боремося з холодом і вшановуємо тих, хто зігріває нас у найтемніші часи. Прикрашаємо дерево свічками, по вогнику за кожного чи кожну, хто вже не з нами. Вони направляють нас, ідучи попереду, вказують шлях як зорі.",shape=box,color=blue];
		j3689912472 -> j3508359117;
	j4060939046 [label="Гадаю, що якщо щось і вціліло до цього віддаленого майбутнього, то воно… дещо заплутане в питаннях документування моєї релігії.",shape=box,color=blue];
		j4060939046 -> j2941431046;
	j3922064235 [label="Луа також може бути Ним, провідником, який веде душі річкою сліз у нескінченну ніч. Самим Смертю. Провісником кінця.",shape=box,color=blue];
		j3922064235 -> j140689667;
	j2019793343 [label="Свічки, хліб, одяг, малюнки. Поетичні збірки. Вінки з квітів. Навіть тих, хто приходив з порожніми руками, але «доброю звісткою», приймають як благословення.",shape=box,color=blue];
		j2019793343 -> j1536799906;
	j3508359117 [label="А ще вище, Сол самітно страждає в повній темряві над зоряним деревом. Тьмяний, але не забутий. Це час Луа. Ми вшановуємо її у цей тінистий час.",shape=box,color=blue];
		j3508359117 -> j3217873836;
	j2941431046 [label="Я як жива археологічна реліквія. Це вганяє в депресію. Але я відхилився від теми.",shape=box,color=blue];
		j2941431046 -> j3303691079;
	j140689667 [label="А в інших сектах Смерть — стара жінка у вуалі. Відрізняється. Але говорить ті самі слова про дух, який тягнеться до нас. Про сріблисту руку, яка прагне направляти нас в останню мить.",shape=box,color=blue];
		j140689667 -> j3868242312;
	j1536799906 [label="Свято життя (сміх, музика, обмін речей) відбувається впродовж цього найдовшого з днів Сола. ",shape=box,color=blue];
		j1536799906 -> j293972692;
	j3217873836 [label="Ми сідаємо близько одне до одного, ласуємо смаженою птицею, коренеплодами та всім, що зібране раніше й не росте у замерзлій землі. Ми обіймаємо тих, кого любимо. І розповідаємо історії про тих, хто вже не з нами.",shape=box,color=blue];
		j3217873836 -> j1864785268;
	j3868242312 [label="Місяць закриває сонце під час затемнення, направляючи нас на перехрестях. У ті миті, коли вважаємо, що все втрачено.",shape=box,color=blue];
		j3868242312 -> j1402025786;
	j293972692 [label="Усім охочим можна було знайомитися з новими людьми та забирати все, що було потрібним.",shape=box,color=blue];
		j293972692 -> j1977370028;
	j1864785268 [label="У найдовшу ніч Луа ми згадуємо, що в кінці вона супроводжуватиме нас та наші родини.",shape=box,color=blue];
		j1864785268 -> j1977370028;
	j1402025786 [label="Boolean DrifterEclipse is now true.",color=orange];
		j1402025786 -> j1704025367;
	j1977370028 [label="Але найсвященнішим святом для Світочів є Саммум Бонум. Дуже рідкісна подія, коли Сол і Луа вирівнюються під час ідеального затемнення.",shape=box,color=blue];
		j1977370028 -> j1668720654;
	j1704025367 [label="Check boolean VelimirEclipse",color=orange];
		j1704025367 -> j2716070619 [label=true,color=green];
		j1704025367 -> j1689766498 [label=false,color=brown];
	j1668720654 [label="Дивовижна й свята оказія, коли відгукується вся природа. Тобі пощастило бачити це?",shape=box,color=blue];
		j1668720654 -> j1351788480;
