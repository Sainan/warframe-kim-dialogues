	j3425926750 [label="Check boolean LyonSerum1",color=orange];
		j3425926750 -> j3354260742 [label=true,color=green];
		j3425926750 -> j1478915251 [label=true,color=green];
		j3425926750 -> j3052250735 [label=false,color=brown];
		j3425926750 -> j1478915251 [label=false,color=brown];
	j3354260742 [label="Lyon, I was wondering if I could hear the rest of the story of how Roathe came to the Cathedral with you and Marie?",shape=box,color=red];
		j3354260742 -> j1501043035;
	j1478915251 [label="[Завершити розмову]",shape=box,color=red];
		j1478915251 -> "Chat ends.";
	j3052250735 [label="Lyon, I was wondering if I could hear the story of how Roathe came to the Cathedral with you and Marie?",shape=box,color=red];
		j3052250735 -> j3394578513;
	j1501043035 [label="As you wish. It is, however, not a terribly pleasant story. He was deposited upon our doorstep like a wounded feral cat.",shape=box,color=blue];
		j1501043035 -> j3769319211;
	"Chat ends." [color=orange];
	j3394578513 [label="As you wish. He was abandoned on our doorstep like a wounded feral cat. The story is not a terribly pleasant one.",shape=box,color=blue];
		j3394578513 -> j3769319211;
	j3769319211 [label="Evaluate expressions",color=orange];
		j3769319211 -> j1667755061 [label="LyonStray",color=purple];
		j3769319211 -> j2861963535 [label="RoatheSerum1",color=purple];
		j3769319211 -> j2860690074 [label="false",color=purple];
	j1667755061 [label="I was right, that story was meant to be about Roathe.",shape=box,color=red];
		j1667755061 -> j4188132758;
	j2861963535 [label="The way he tells it, he had every reason to be a bit... feral, when he showed up.",shape=box,color=red];
		j2861963535 -> j3745711565;
	j2860690074 [label="Fair enough, go on.",shape=box,color=red];
		j2860690074 -> j2266356665;
	j4188132758 [label="It was a story about a stray cat that used to visit the Cathedral. What you glean behind its meaning, or my reason for telling it to you, is entirely your own responsibility. I am a priest, am I not?",shape=box,color=blue];
		j4188132758 -> j2266356665;
	j3745711565 [label="It would be my expectation for someone of his status and disposition to feel wronged by the actions Entrati took against him. I would, quite honestly, be far more taken aback if he handled it with grace.",shape=box,color=blue];
		j3745711565 -> j2266356665;
	j2266356665 [label="Evaluate expressions",color=orange];
		j2266356665 -> j1733130522 [label="LyonSerum1",color=purple];
		j2266356665 -> j2268972887 [label="false",color=purple];
	j1733130522 [label="I believe where I left us, Entrati had recently returned from his disappearance with Roathe, as we see him now, already changed. Entrati revealed to us all the lies he had spoken for over three years.",shape=box,color=blue];
		j1733130522 -> j3452332604;
	j2268972887 [label="I will attempt to summarize the events that led up to that moment, otherwise it may seem... nonsensical at best.",shape=box,color=blue];
		j2268972887 -> j1149120104;
	j3452332604 [label="He offered us the \"protoframe serums\" that made us what we are now, and once we had accepted them... immediately abandoned us once more.",shape=box,color=blue];
		j3452332604 -> j2523353943;
	j1149120104 [label="For three years, two months, and eleven days, he served as Cardinal Dimanche in our Cathedral. And for all that time, Marie and I served him unknowing of what he planned for us.",shape=box,color=blue];
		j1149120104 -> j4014856914;
	j2523353943 [label="And there, we remained, as newly orphaned amalgams, with bodies and souls remade into creations we could barely comprehend let alone claim mastery over.",shape=box,color=blue];
		j2523353943 -> j2256942913;
	j4014856914 [label="I know your questions before you ask them. What was he scheming? Did he infect the city, like I hear tell that he did to Höllvania? What were his plans? His discoveries?",shape=box,color=blue];
		j4014856914 -> j2294496618;
	j2256942913 [label="Stranded in a city that was our home, but no longer friendly to us. We were... forced to hide.",shape=box,color=blue];
		j2256942913 -> j973495166;
		j2256942913 -> j260460378;
	j2294496618 [label="To these I will say, you will be disappointed. He preached. He studied. He rested. And he prayed. Then, one night, he disappeared in the midst of a terrible storm. The same as the one in which he appeared.",shape=box,color=blue];
		j2294496618 -> j2575044127;
	j973495166 [label="Because of what you looked like?",shape=box,color=red];
		j973495166 -> j3982215135;
	j260460378 [label="Did the Cathedral turn you away?",shape=box,color=red];
		j260460378 -> j948973488;
	j2575044127 [label="Check boolean MarieLyonVisions",color=orange];
		j2575044127 -> j1844911264 [label=true,color=green];
		j2575044127 -> j2251743060 [label=false,color=brown];
	j3982215135 [label="I am not sure if it has escaped your notice, but Marie can fly, and Roathe is... blue, amongst other issues.",shape=box,color=blue];
		j3982215135 -> j3146046261;
	j948973488 [label="Not... precisely. We were forced from public life. But our fellow Brothers and Sisters did not exile us to the streets, or burn us at the stake. \"Cardinal Dimanche\" convinced them our changes were... the work of the Luminaries.",shape=box,color=blue];
		j948973488 -> j1819120466;
	j1844911264 [label="Though I am well aware the storm did not occur to others, it was quite vivid to my senses.",shape=box,color=blue];
		j1844911264 -> j2251743060;
	j2251743060 [label="One year to the day after that, he reappeared one final time, with... Roathe, as you see him now, collapsed and unconscious at his feet.",shape=box,color=blue];
		j2251743060 -> j1065410538;
	j3146046261 [label="I know you spend your days dallying with talking animals and skulls and pondering the question of the cosmic Void, but that is not standard issue for most humans.",shape=box,color=blue];
		j3146046261 -> j1721024355;
	j1819120466 [label="We were hidden within the crypts and kept out of sight. Our former brethren, though terrified of us, would bring us supplies.",shape=box,color=blue];
		j1819120466 -> j4022287456;
	j1065410538 [label="A devil in the flesh, or so it seemed. It was then, that Entrati told us the truth of who he was - when he hailed - and the true task he had for us. That he had chosen us both for a most \"sacred mission.\"",shape=box,color=blue];
		j1065410538 -> j2391629064;
	j1721024355 [label="Indeed, I am the one of the three of us that could perhaps wander amongst the crowd if I were to shroud myself well enough. ",shape=box,color=blue];
		j1721024355 -> j518183051;
		j1721024355 -> j2489954757;
	j4022287456 [label="They... would insist on interacting only with Marie, despite her abrupt ghost-like appearances upon the stairs to greet them. ",shape=box,color=blue];
		j4022287456 -> j3595225534;
		j4022287456 -> j4017447347;
	j2391629064 [label="Marie accepted the serum readily. Of course, she did. How could she not? And how could I not follow her? How could I not seek the truth, wherever it might lead?",shape=box,color=blue];
		j2391629064 -> j249472217;
	j518183051 [label="Where did you stay?",shape=box,color=red];
		j518183051 -> j4067760369;
	j2489954757 [label="How did you all wind up here?",shape=box,color=red];
		j2489954757 -> j1779874582;
	j3595225534 [label="I can understand avoiding Roathe, but... They would prefer that over talking to you?",shape=box,color=red];
		j3595225534 -> j1476207001;
	j4017447347 [label="She is very sweet...",shape=box,color=red];
		j4017447347 -> j647850871;
	j249472217 [label="Boolean LyonSerum1 is now true.",color=orange];
		j249472217 -> j546609267;
		j249472217 -> j1516490348;
		j249472217 -> j686984308;
	j4067760369 [label="Our fellow Brothers and Sisters did not exile us to the streets, or burn us at the stake. \"Cardinal Dimanche\" convinced them our changes were... the work of the Luminaries.",shape=box,color=blue];
		j4067760369 -> j2007574409;
	j1779874582 [label="Roathe will know the specifics of precisely \"how,\" but after... many years of work, he created a \"Helminth\" from samples of our blood.",shape=box,color=blue];
		j1779874582 -> j2349739827;
	j1476207001 [label="I do believe we have met, have we not?",shape=box,color=blue];
		j1476207001 -> j2516202691;
	j647850871 [label="Precisely.",shape=box,color=blue];
		j647850871 -> j2711837241;
	j546609267 [label="I think she still worships Entrati a bit too much.",shape=box,color=red];
		j546609267 -> j1227220906;
	j1516490348 [label="What happened next?",shape=box,color=red];
		j1516490348 -> j1516494214;
	j686984308 [label="Do you regret it?",shape=box,color=red];
		j686984308 -> j3003510164;
	j2007574409 [label="We were hidden within the crypts and kept out of sight. Our former brethren, though terrified of us, would bring us supplies.",shape=box,color=blue];
		j2007574409 -> j2681353844;
	j2349739827 [label="I believe the Infestation is connected to itself through... time... somehow... though the details are quite lost on me.",shape=box,color=blue];
		j2349739827 -> j2587361651;
		j2349739827 -> j503543339;
	j2516202691 [label="How long were you all trapped down there?",shape=box,color=red];
		j2516202691 -> j2879177880;
	j2711837241 [label="So... they kept you all in the basement?",shape=box,color=red];
		j2711837241 -> j1779196671;
	j1227220906 [label="Boolean LyonMarieEntrati is now true.",color=orange];
		j1227220906 -> j28767766;
	j1516494214 [label="Roathe awoke. At first, he could barely remember his name. Entrati said one parting phrase to the bastard. \"Uriel, Heretic of Xata, in banishment, answer - can the Orokin ever be forgiven?\"",shape=box,color=blue];
		j1516494214 -> j2779374304;
	j3003510164 [label="I regret everything, Drifter. Yes, of course I do. But would I do it again? Yes, of course I would. I cannot leave Marie alone.",shape=box,color=blue];
		j3003510164 -> j1503271801;
	j2681353844 [label="They... would insist on interacting only with Marie, despite her abrupt ghost-like appearances upon the stairs to greet them. ",shape=box,color=blue];
		j2681353844 -> j4249760621;
		j2681353844 -> j3932312209;
	j2587361651 [label="He reverse-engineered a Helminth?! How long did that take?!",shape=box,color=red];
		j2587361651 -> j1957525480;
	j503543339 [label="I don't think anyone understands it. It's a new discovery.",shape=box,color=red];
		j503543339 -> j3922583223;
	j2879177880 [label="I am perhaps not the one you should ask about how many years passed after we were turned into talking Infested amalgams. My grasp on the passage of time since then has been... convoluted.",shape=box,color=blue];
		j2879177880 -> j983124728;
		j2879177880 -> j4192580199;
	j1779196671 [label="It sounds perhaps more harsh than it seems. There was nowhere else to put us. The belfry was too open, too exposed to the harsh elements. The crypt was sheltered and warm.",shape=box,color=blue];
		j1779196671 -> j924841492;
	j28767766 [label="In this, we are agreed. But I also cannot fault her for it. Give her time. She will come to understand. She is fiercely intelligent, Drifter. Do not treat her as a fool.",shape=box,color=blue];
		j28767766 -> j1503271801;
	j2779374304 [label="Entrati departed then for the last time. And abandoned Roathe with us, now newly changed into what you see now - better able to contend with the temperamental devil.",shape=box,color=blue];
		j2779374304 -> j2523353943;
	j1503271801 [label="To continue the tale.. Entrati departed then for the last time. And abandoned Roathe with us, now newly changed into what you see now - better able to contend with the temperamental devil.",shape=box,color=blue];
		j1503271801 -> j2523353943;
	j4249760621 [label="I can understand avoiding Roathe, but... They would prefer that over talking to you?",shape=box,color=red];
		j4249760621 -> j1357907181;
	j3932312209 [label="She is very sweet...",shape=box,color=red];
		j3932312209 -> j2826620219;
	j1957525480 [label="Boolean LyonRoatheHelminth is now true.",color=orange];
		j1957525480 -> j1424411030;
	j3922583223 [label="I cannot tell if that is comforting or dismaying to know, thank you. Strange enough to know now that the Infestation can talk.",shape=box,color=blue];
		j3922583223 -> j3606977947;
		j3922583223 -> j4161340413;
	j983124728 [label="Convoluted, how?",shape=box,color=red];
		j983124728 -> j4020450692;
	j4192580199 [label="I'm not sure if I should tell you that the Infestation can also talk...",shape=box,color=red];
		j4192580199 -> j1408773028;
	j924841492 [label="And, unfortunately, we discovered it had exits that Roathe could use to... wander.",shape=box,color=blue];
		j924841492 -> j845860967;
	j1357907181 [label="I do believe we have met, have we not?",shape=box,color=blue];
		j1357907181 -> j2516202691;
		j1357907181 -> j2711837241;
	j2826620219 [label="Precisely.",shape=box,color=blue];
		j2826620219 -> j2711837241;
		j2826620219 -> j2516202691;
	j1424411030 [label="I am perhaps not the one you should ask. My grasp on the passage of time since then has become... convoluted. Though perhaps it is more accurate to say \"more convoluted.\" As though this could not get more horrifying...",shape=box,color=blue];
		j1424411030 -> j983124728;
		j1424411030 -> j4192580199;
	j3606977947 [label="Not all of the household objects. The chairs can sometimes be... well... never mind, please continue.",shape=box,color=red];
		j3606977947 -> j2819181008;
	j4161340413 [label="I will spare you the conversation about the guitar.",shape=box,color=red];
		j4161340413 -> j1893225763;
	j4020450692 [label="Boolean LyonTime1 is now true.",color=orange];
		j4020450692 -> j2170811973;
	j1408773028 [label="Believe me, I know. And it is disconcerting, thank you. Although it seems every random household object in this place can speak.",shape=box,color=blue];
		j1408773028 -> j3606977947;
		j1408773028 -> j4161340413;
	j845860967 [label="Evaluate expressions",color=orange];
		j845860967 -> j790145832 [label="MarieRoathePastry1",color=purple];
		j845860967 -> j790145832 [label="RoatheMariePastry1",color=purple];
		j845860967 -> j3751899572 [label="false",color=purple];
	j2819181008 [label="If the word you were going to say was \"occupied,\" I have seen it as well, Drifter. That one that whispered. The one within the wall. I heard the tapping...",shape=box,color=blue];
		j2819181008 -> j667129828;
	j1893225763 [label="Please, do. Though, I would find it far more comforting I think, to have a musical instrument be some transient demigod than... whatever else has come to haunt and abandon my mind. Is it strange, that I... ever since he...",shape=box,color=blue];
		j1893225763 -> j2701007584;
	j2170811973 [label="I am unsure if it is simply because of my unique sensitivity to the matter, or due to... the individual circumstances of my making, or... him -",shape=box,color=blue];
		j2170811973 -> j3244246651;
	j790145832 [label="So I've heard.",shape=box,color=red];
		j790145832 -> j1753336165;
	j3751899572 [label="Oh?",shape=box,color=red];
		j3751899572 -> j2653498142;
	j667129828 [label="There is a voice that has beaconed to me that I know I have not heard my entire life, yet stretches into my past and far into my future...",shape=box,color=blue];
		j667129828 -> j3817352593;
	j2701007584 [label="He?",shape=box,color=red];
		j2701007584 -> j667129828;
	j3244246651 [label="And I know you shall think me a right lunatic when I say this, but I do not experience time in a... purely... linear fashion.",shape=box,color=blue];
		j3244246651 -> j51976645;
		j3244246651 -> j3756317920;
	j1753336165 [label="I think it one of his few redeeming qualities. Not the theft, mind. The reasoning behind it. It is my theory he procured the illicit goods to goad Marie into conversations with him.",shape=box,color=blue];
		j1753336165 -> j191343899;
	j2653498142 [label="It is neither here nor there.",shape=box,color=blue];
		j2653498142 -> j2531492468;
		j2653498142 -> j999499506;
	j3817352593 [label="It is not possible for it always to have been there. Yet I can recall it now, as clear as the silver light of Lua herself, behind the wall of my childhood home. A young man's voice. The presence of another standing beside him... \"Rap tap tap...\"",shape=box,color=blue];
		j3817352593 -> j1295556473;
	j51976645 [label="\"Him?\" Who is \"him?\"",shape=box,color=red];
		j51976645 -> j667129828;
	j3756317920 [label="I experienced time for an untold number of centuries as looping spirals, Lyon.",shape=box,color=red];
		j3756317920 -> j4221172411;
	j191343899 [label="And, perhaps, because they made her smile, when she thought he was not looking. Once, he said to me \"it is a great fault of fate that she has been so deprived of life.\"",shape=box,color=blue];
		j191343899 -> j3733610902;
	j2531492468 [label="How long did it take for you all to get back to... well, now?",shape=box,color=red];
		j2531492468 -> j2208366894;
	j999499506 [label="What happened next?",shape=box,color=red];
		j999499506 -> j1779874582;
	j1295556473 [label="I - forgive me. I must go. I cannot speak of this yet. I am... I am sorry. Do not ask me about this again.",shape=box,color=blue];
		j1295556473 -> j3961852440;
	j4221172411 [label="What say you then, when I speak of a voice that has beaconed to me beyond my own rational mind? I know I have not heard it my entire life. It is not possible for it to have always been there.",shape=box,color=blue];
		j4221172411 -> j1125172121;
	j3733610902 [label="Boolean LyonRoathePastry is now true.",color=orange];
		j3733610902 -> j3994039800;
		j3733610902 -> j2531492468;
	j2208366894 [label="I am perhaps not the one you should ask about how many years passed after we were turned into talking Infested amalgams. My grasp on the passage of time since then has been... convoluted.",shape=box,color=blue];
		j2208366894 -> j4192580199;
		j2208366894 -> j983124728;
	j3961852440 [label="Lyon, wait!",shape=box,color=red];
		j3961852440 -> j777162605;
	j1125172121 [label="Yet I can recall it now, as clear as the silver light of Lua herself, behind the wall of my childhood home. A young man's voice... \"Rap tap tap...\"",shape=box,color=blue];
		j1125172121 -> j1295556473;
	j3994039800 [label="That is on the verge of being adorable for him, you're right. What happened next?",shape=box,color=red];
		j3994039800 -> j1779874582;
	j777162605 [label="Boolean LyonRell1 is now true.",color=orange];
		j777162605 -> j367054140;
