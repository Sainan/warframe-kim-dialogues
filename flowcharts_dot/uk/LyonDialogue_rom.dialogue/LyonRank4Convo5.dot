digraph {
	"LyonRank4Convo5 begins." [color=orange];
		"LyonRank4Convo5 begins." -> j3425926750;
	j3425926750 [label="Check boolean LyonSerum1",color=orange];
		j3425926750 -> j1249593065 [label=true,color=green];
		j3425926750 -> j1478915251 [label=true,color=green];
		j3425926750 -> j2250302291 [label=false,color=brown];
		j3425926750 -> j1478915251 [label=false,color=brown];
	j1249593065 [label="Ліоне, а ти можеш дорозповісти, як Роут з’явився в соборі, де були ви з Марі?",shape=box,color=red];
		j1249593065 -> j1782037061;
	j1478915251 [label="[Завершити розмову]",shape=box,color=red];
		j1478915251 -> "Chat ends.";
	j2250302291 [label="Ліоне, а ти можеш розповісти, як Роут з’явився в соборі, де були ви з Марі?",shape=box,color=red];
		j2250302291 -> j477363438;
	j1782037061 [label="Як забажаєш. Та це не дуже приємна розповідь. Його підкинули на поріг, як поранене дике кошеня.",shape=box,color=blue];
		j1782037061 -> j3769319211;
	"Chat ends." [color=orange];
	j477363438 [label="Як забажаєш. Його лишили на порозі, як поранене дике кошеня. Не дуже приємна оповідка.",shape=box,color=blue];
		j477363438 -> j3769319211;
	j3769319211 [label="Evaluate expressions",color=orange];
		j3769319211 -> j2233748195 [label="LyonStray",color=purple];
		j3769319211 -> j3648813272 [label="RoatheSerum1",color=purple];
		j3769319211 -> j2230418749 [label="false",color=purple];
	j2233748195 [label="Ага, тож це й дійсно була історія про Роута.",shape=box,color=red];
		j2233748195 -> j1265712743;
	j3648813272 [label="Відповідно до його слів, то було вдосталь причин бути… трішки диким у той час.",shape=box,color=red];
		j3648813272 -> j787503383;
	j2230418749 [label="Ясно. Продовжуй.",shape=box,color=red];
		j2230418749 -> j2266356665;
	j1265712743 [label="Це була історія про вуличного кота, який навідувався в собор. Те, що ти десь щось бачиш між рядків, у сенсах та сутностях чи вигадуєш причину, що я розповів цю історію — повністю твоя відповідальність. Я ж таки священник чи ні?",shape=box,color=blue];
		j1265712743 -> j2266356665;
	j787503383 [label="Від когось із таким статусом та положенням варто очікувати подібної реакції на дії Ентраті. Щиро кажучи, мене більше б здивувало, якби він прийняв усе з шаною та повагою.",shape=box,color=blue];
		j787503383 -> j2266356665;
	j2266356665 [label="Evaluate expressions",color=orange];
		j2266356665 -> j2181321006 [label="LyonSerum1",color=purple];
		j2266356665 -> j2356876634 [label="false",color=purple];
	j2181321006 [label="Я перервався наче на тому, що Ентраті повернувся після відсутності. Але притяг Роута із собою. Таким, як він є зараз… зміненим. Ентраті розкрив усю свою брехню, яку згодовував нам упродовж трьох років.",shape=box,color=blue];
		j2181321006 -> j2156778908;
	j2356876634 [label="Я спробую звести докупи події, які передували тій миті, бо інакше це може сприйматися доволі… безглуздо. М’яко кажучи.",shape=box,color=blue];
		j2356876634 -> j3040938933;
	j2156778908 [label="Він запропонував нам «сироватку протофреймів», яка мала зробити нас такими, як ми є зараз. А коли ми скористалися пропозицією… миттєво знову покинув нас.",shape=box,color=blue];
		j2156778908 -> j240997327;
	j3040938933 [label="3 роки, 2 місяці й 11 днів він був у нашому соборі як кардинал Діманш. Увесь той час ми з Марі прислуговували йому, не знаючи про підготовлені для нас плани.",shape=box,color=blue];
		j3040938933 -> j1241932109;
	j240997327 [label="І там ми лишилися, як сирітки. Наші тіла й душі стали чимось іншим, що ми ледве могли зрозуміти. Не говорячи про те, щоб хоча б опанувати.",shape=box,color=blue];
		j240997327 -> j470296059;
	j1241932109 [label="Я знаю твої питання, перш ти їх поставиш. Що він планував? Він заразив місто, як, за чутками, зробив із Голвенією? У чому був замисел? Що він відкрив для себе?",shape=box,color=blue];
		j1241932109 -> j325039412;
	j470296059 [label="Ми застрягли в місті, котре було домом, але перестало бути привітним місцем. Ми… змушені були ховатися.",shape=box,color=blue];
		j470296059 -> j3138415827;
		j470296059 -> j1519870748;
	j325039412 [label="То на це скажу — ти розчаруєшся. Він проповідував. Навчався. Відпочивав. Молився. А потім він зник, однієї ночі, коли була жахлива буря — така ж, як і в той день, коли з’явився.",shape=box,color=blue];
		j325039412 -> j2575044127;
	j3138415827 [label="Через зовнішність?",shape=box,color=red];
		j3138415827 -> j1088654796;
	j1519870748 [label="Вас вигнали із собору?",shape=box,color=red];
		j1519870748 -> j3752553867;
	j2575044127 [label="Check boolean MarieLyonVisions",color=orange];
		j2575044127 -> j4121210804 [label=true,color=green];
		j2575044127 -> j230152960 [label=false,color=brown];
	j1088654796 [label="Я не впевнений, що тобі досі не траплялося на очі… але Марі може літати. А Роут синій, окрім усього іншого.",shape=box,color=blue];
		j1088654796 -> j164078297;
	j3752553867 [label="Ні… не зовсім. Нас прибрали із загального простору й життя. Але любі нам брати й сестри не вигнали нас на вулиці. Не спалили нас на вогнищі. «Кардинал Діманш» переконав усіх, що зміни були… здійснені самими Світочами.",shape=box,color=blue];
		j3752553867 -> j1884816099;
	j4121210804 [label="Хоча я усвідомлюю, що та буря не існувала для інших, для мене лихоліття природи було дуже яскравим.",shape=box,color=blue];
		j4121210804 -> j230152960;
	j230152960 [label="Рівно через рік після цього він знову з’явився… востаннє… Роут, такий, як зараз, лежав скоцюблений і непритомний біля його ніг.",shape=box,color=blue];
		j230152960 -> j4090748433;
	j164078297 [label="Я знаю, що балакучі тварини й черепи — звичайна рутина для тебе, як і міркування над питаннями космічної Порожнечі. Але це дуже нетипові речі для більшості людей.",shape=box,color=blue];
		j164078297 -> j4180785816;
	j1884816099 [label="Нас ховали в криптах і тримали якнайдалі від громади. Колишня братія була нажахана, але хоча б припасами забезпечували.",shape=box,color=blue];
		j1884816099 -> j2287261116;
	j4090748433 [label="Диявол у плоті… або так видавалося. Саме тоді Ентраті привітався з нами й розповів нам істину про себе і яке єдине справжнє завдання для нас є. Він обрав нас обох для «найсвященнішого завдання».",shape=box,color=blue];
		j4090748433 -> j1019725739;
	j4180785816 [label="Насправді я один із цього тріо, хто міг би вільно змішатися з натовпом, якби ретельно підібрав убрання. ",shape=box,color=blue];
		j4180785816 -> j2396313464;
		j4180785816 -> j1777266349;
	j2287261116 [label="Вони… наполягали на взаємодії виключно з Марі. Попри її примароподібні злети над сходами під час привітання гостей. ",shape=box,color=blue];
		j2287261116 -> j211972818;
		j2287261116 -> j599275938;
	j1019725739 [label="Марі охоче прийняла сироватку. Звісно, як інакше. Як могла відмовити? І як я міг не піти за нею? Як я міг не шукати істини, куди б це мене не завело?",shape=box,color=blue];
		j1019725739 -> j249472217;
	j2396313464 [label="То де ж ви були?",shape=box,color=red];
		j2396313464 -> j2569718490;
	j1777266349 [label="Яким вітром вас занесло сюди?",shape=box,color=red];
		j1777266349 -> j2737815140;
	j211972818 [label="Я розумію уникання Роута… Але чому вони ігнорували тебе?",shape=box,color=red];
		j211972818 -> j2268492476;
	j599275938 [label="Вона дуже мила…",shape=box,color=red];
		j599275938 -> j2985514884;
	j249472217 [label="Boolean LyonSerum1 is now true.",color=orange];
		j249472217 -> j3457772844;
		j249472217 -> j1887038781;
		j249472217 -> j3583964385;
	j2569718490 [label="Любі нам брати й сестри не вигнали нас на вулиці. Не спалили нас на вогнищі. «Кардинал Діманш» переконав усіх, що зміни були… здійснені самими Світочами.",shape=box,color=blue];
		j2569718490 -> j1439092865;
	j2737815140 [label="Роуту точно відомо геть усе про «як»… витративши багато років та зразків нашої крові, він створив подобу вашого «гельмінта».",shape=box,color=blue];
		j2737815140 -> j3112278682;
	j2268492476 [label="Мені здавалося, що ти вже мене трішки знаєш, ні?",shape=box,color=blue];
		j2268492476 -> j64306863;
	j2985514884 [label="Саме так.",shape=box,color=blue];
		j2985514884 -> j3939702527;
	j3457772844 [label="Гадаю, вона й досі занадто вірує в Ентраті.",shape=box,color=red];
		j3457772844 -> j2776018643;
	j1887038781 [label="Що трапилося далі?",shape=box,color=red];
		j1887038781 -> j3471975605;
	j3583964385 [label="Ти шкодуєш про це?",shape=box,color=red];
		j3583964385 -> j3740266062;
	j1439092865 [label="Нас ховали в криптах і тримали якнайдалі від громади. Колишня братія була нажахана, але хоча б припасами забезпечували.",shape=box,color=blue];
		j1439092865 -> j3569976573;
	j3112278682 [label="Я вважаю, що зараження пов’язане саме із собою у… часі й просторі… якось… але подробиці невідомі.",shape=box,color=blue];
		j3112278682 -> j4047984898;
		j3112278682 -> j2488877873;
	j64306863 [label="І як довго ви там були?",shape=box,color=red];
		j64306863 -> j4010631868;
	j3939702527 [label="Тож… вони тримали вас у підвалі?",shape=box,color=red];
		j3939702527 -> j1803321977;
	j2776018643 [label="Boolean LyonMarieEntrati is now true.",color=orange];
		j2776018643 -> j2796683844;
	j3471975605 [label="Роут прокинувся. Спершу він ледь ім’я своє згадати міг. Ентраті сказав виродку одну фразу на прощання. «Уриїле, Єретику Зати, у вигнанні, дай відповідь — чи можна коли-небудь пробачити орокіна?».",shape=box,color=blue];
		j3471975605 -> j2957939501;
	j3740266062 [label="Я шкодую про все, мандрівниче. Так, звісно. Але чи вчинив би так само? Так, звісно вчинив би. Я не облишу Марі саму.",shape=box,color=blue];
		j3740266062 -> j3916430339;
	j3569976573 [label="Вони… наполягали на взаємодії виключно з Марі. Попри її примароподібні злети над сходами під час привітання гостей. ",shape=box,color=blue];
		j3569976573 -> j2531748344;
		j3569976573 -> j358075807;
	j4047984898 [label="Він перевийнайшов гельмінта?! Скільки часу на це пішло?!",shape=box,color=red];
		j4047984898 -> j1075184911;
	j2488877873 [label="Не думаю, що хтось може зрозуміти. Це абсолютно нове відкриття.",shape=box,color=red];
		j2488877873 -> j675382705;
	j4010631868 [label="Напевно не в мене потрібно питати, скільки років пройшло після перетворення нас у балакучих амальгам зараження. Моє відстеження часових потоків з того часу було трохи… заплутаним.",shape=box,color=blue];
		j4010631868 -> j1454199900;
		j4010631868 -> j2180446401;
	j1803321977 [label="На словах це може мати жорсткіший вигляд. Не було іншого місця, куди нас діти. Дзвінниця надто відкрита для відвідувачів та дії стихій. А в крипті було безпечно, тепло й затишно.",shape=box,color=blue];
		j1803321977 -> j633188873;
	j2796683844 [label="Погоджуюся. Але також не можу винити її в цьому. Дай їй час. Вона зрозуміє з часом. Мандрівниче, вона навдивовижу розумна. Не думай, що вона дурепа.",shape=box,color=blue];
		j2796683844 -> j3916430339;
	j2957939501 [label="Ентраті знову зник. Востаннє. А Роута покинув із нами. А нині той перетворився на те, що бачиш — тож ліпше шукай способи боротьби з норовливим дияволом.",shape=box,color=blue];
		j2957939501 -> j240997327;
	j3916430339 [label="Продовжмо історію… Ентраті знову зник. Востаннє. А Роута покинув із нами. А нині той перетворився на те, що бачиш — тож ліпше шукай способи боротьби з норовливим дияволом.",shape=box,color=blue];
		j3916430339 -> j240997327;
	j2531748344 [label="Я розумію уникання Роута… Але чому вони ігнорували тебе?",shape=box,color=red];
		j2531748344 -> j4184039177;
	j358075807 [label="Вона дуже мила…",shape=box,color=red];
		j358075807 -> j1401850153;
	j1075184911 [label="Boolean LyonRoatheHelminth is now true.",color=orange];
		j1075184911 -> j2944546834;
	j675382705 [label="Не можу сказати, чи це тішить, чи навпаки. Але дякую. Доволі дивні знання того, що зараження вміє балакати.",shape=box,color=blue];
		j675382705 -> j503702653;
		j675382705 -> j212720479;
	j1454199900 [label="Заплутаним? Це як це?",shape=box,color=red];
		j1454199900 -> j3759873899;
	j2180446401 [label="Не думаю, що ти маєш знати про це, але зараження теж уміє балакати…",shape=box,color=red];
		j2180446401 -> j160099294;
	j633188873 [label="І, на жаль, ми пізно виявили, що там є виходи, якими Роут міг ходити… гуляти.",shape=box,color=blue];
		j633188873 -> j845860967;
	j4184039177 [label="Мені здавалося, що ти вже мене трішки знаєш, ні?",shape=box,color=blue];
		j4184039177 -> j64306863;
		j4184039177 -> j3939702527;
	j1401850153 [label="Саме так.",shape=box,color=blue];
		j1401850153 -> j3939702527;
		j1401850153 -> j64306863;
	j2944546834 [label="Напевно, це не мене треба питати про таке. Відчуття часу відтоді для мене стало… заплутаним. Хоча, правильніше буде написати — «заплутанішим». Наче й так усе було не достатньо жахливим…",shape=box,color=blue];
		j2944546834 -> j1454199900;
		j2944546834 -> j2180446401;
	j503702653 [label="Не всі предмети. Крісла можуть іноді… але… не зважай, продовжуй.",shape=box,color=red];
		j503702653 -> j1757051741;
	j212720479 [label="Я змилостивлюся й не розповідатиму про гітару.",shape=box,color=red];
		j212720479 -> j1358904532;
	j3759873899 [label="Boolean LyonTime1 is now true.",color=orange];
		j3759873899 -> j919306737;
	j160099294 [label="Повір, я це знаю. І це непокоїть, знаєш. Та ще й кожен предмет в цьому місці може виявитися балакучим.",shape=box,color=blue];
		j160099294 -> j503702653;
		j160099294 -> j212720479;
	j845860967 [label="Evaluate expressions",color=orange];
		j845860967 -> j656138746 [label="MarieRoathePastry1",color=purple];
		j845860967 -> j656138746 [label="RoatheMariePastry1",color=purple];
		j845860967 -> j3438897952 [label="false",color=purple];
	j1757051741 [label="Мандрівниче, якщо ти збираєшся сказати «кимось зайняте», то я бачив. Те, що шепотіло. Те, що в стінах. Я чув цей рап.тап.тап…",shape=box,color=blue];
		j1757051741 -> j3738662399;
	j1358904532 [label="О так, я буду вдячним. Хоча, гадаю, мені було би приємніше думати, що музичний інструмент був умістищем сутності чи напівбого… аніж те, що щоби воно не приходило й ішло з моєї голови. Це дивно, що я… відтоді як він…",shape=box,color=blue];
		j1358904532 -> j294050612;
	j919306737 [label="Я не впевнений, чи це не через мою неповторну чутливість до подібних речей, чи наслідки… особливостей мого творення… чи через нього…",shape=box,color=blue];
		j919306737 -> j3268916833;
	j656138746 [label="Так, це я вже знаю.",shape=box,color=red];
		j656138746 -> j1072299093;
	j3438897952 [label="Га?",shape=box,color=red];
		j3438897952 -> j3337738759;
	j3738662399 [label="Є голос, який кличе мене. Я знаю, що не чув його ніколи в житті, однак він тягнеться до мого минулого й далеко в моє майбутнє…",shape=box,color=blue];
		j3738662399 -> j4205573181;
	j294050612 [label="Він?",shape=box,color=red];
		j294050612 -> j3738662399;
	j3268916833 [label="Я впевнений, що ти вважатимеш абсолютно божевільним мене за те, що не відчуваю час у… його лінійному розмірі.",shape=box,color=blue];
		j3268916833 -> j3703908417;
		j3268916833 -> j116115950;
	j1072299093 [label="Я вважаю це однією з кількох його небагатьох хороших рис. Ні, не крадіжку. А ті причини, що стояли за нею. Я маю теорію, що він приніс ті заборонені речі, щоби примусити Марі до спілкування з ним.",shape=box,color=blue];
		j1072299093 -> j1651006882;
	j3337738759 [label="Якось так.",shape=box,color=blue];
		j3337738759 -> j2507778605;
		j3337738759 -> j633961408;
	j4205573181 [label="Не може бути, щоби він увесь час там був. Однак тепер я згадую його так само чітко як світло самої Луа… за стінами своєї дитячої кімнати. Голос молодого чоловіка. І присутність ще когось поруч із ним… «Рап. Тап. Тап…».",shape=box,color=blue];
		j4205573181 -> j2600872245;
	j3703908417 [label="«Він»? Хто цей «він»?",shape=box,color=red];
		j3703908417 -> j3738662399;
	j116115950 [label="Ліоне, мій час пізнавався безліч століть, як закручені повтори завитків.",shape=box,color=red];
		j116115950 -> j2142587522;
	j1651006882 [label="І може ще те, що вона всміхається через нього, хоча думає, що він цього не бачить. Якось він сказав мені: «Доля дуже завинила перед нею, бо позбавила життя».",shape=box,color=blue];
		j1651006882 -> j3733610902;
	j2507778605 [label="А як довго ви добиралися звідти… ем, сюди?",shape=box,color=red];
		j2507778605 -> j3540765223;
	j633961408 [label="Що трапилося далі?",shape=box,color=red];
		j633961408 -> j2737815140;
	j2600872245 [label="Я… вибач. Я маю йти. Я не готовий про це говорити. Мені… прикро. Не запитуй про це мене знову.",shape=box,color=blue];
		j2600872245 -> j4252762748;
	j2142587522 [label="А як ти відреагуєш на голос, який кличе мене з-поза меж раціональної свідомості? Я знаю, що не чув його ніколи в житті. Не може бути, що він увесь час був там.",shape=box,color=blue];
		j2142587522 -> j521943823;
	j3733610902 [label="Boolean LyonRoathePastry is now true.",color=orange];
		j3733610902 -> j2639701965;
		j3733610902 -> j2507778605;
	j3540765223 [label="Напевно, не в мене потрібно питати, скільки років пройшло після перетворення нас у балакучих амальгам зараження. Моє відстеження часових потоків з того часу було трохи… заплутаним.",shape=box,color=blue];
		j3540765223 -> j2180446401;
		j3540765223 -> j1454199900;
	j4252762748 [label="Ліоне, зажди!",shape=box,color=red];
		j4252762748 -> j777162605;
	j521943823 [label="Однак тепер я згадую його так само чітко як світло самої Луа… за стінами своєї дитячої кімнати. Голос молодого чоловіка… «Рап. Тап. Тап…».",shape=box,color=blue];
		j521943823 -> j2600872245;
	j2639701965 [label="Твоя правда — це просто пік милоти й люб’язності для нього. Що відбувалося далі?",shape=box,color=red];
		j2639701965 -> j2737815140;
	j777162605 [label="Boolean LyonRell1 is now true.",color=orange];
		j777162605 -> j367054140;
	j367054140 [label="+20 Chemistry",color=orange];
		j367054140 -> "Chat ends.";
}