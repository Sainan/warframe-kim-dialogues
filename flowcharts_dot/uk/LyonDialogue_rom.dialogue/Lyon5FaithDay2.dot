		j2955664667 -> "Chat ends." [label="false",color=purple];
	j725317350 [label="Я обмірковував нашу вчорашню бесіду. І що означає невідворотна присутність Релла та Гарроу в моєму житті…",shape=box,color=blue];
		j725317350 -> j870956025;
	j1133883877 [label="Я обмірковував нашу вчорашню бесіду. І що означає невідворотна присутність Релла та Гарроу в моєму житті…",shape=box,color=blue];
		j1133883877 -> j2877557370;
	j2066409069 [label="Я обмірковував нашу вчорашню бесіду. І що означає невідворотна присутність Релла та Гарроу в моєму житті…",shape=box,color=blue];
		j2066409069 -> j1715457254;
	j2292083084 [label="Є дещо, що я хотів давно обговорити з тобою. І лише зараз випала нагода. Коли… ми з Реллом та Гарроу переплелися… як і чому, то не є важливим…",shape=box,color=blue];
		j2292083084 -> j545167590;
	"Chat ends." [color=orange];
	j870956025 [label="Щоби потім знову вирвати їх з моєї душі й лишити лише спогади. І яким чином це може бути даром Луа…",shape=box,color=blue];
		j870956025 -> j1402159915;
	j2877557370 [label="Щоби потім знову вирвати їх з моєї душі й лишити лише спогади. І твоя правда. Це може означати, що богів немає в цьому світі.",shape=box,color=blue];
		j2877557370 -> j1109460326;
	j1715457254 [label="Щоби потім знову вирвати їх з моєї душі й лишити лише спогади. І я не знаю, чи це позначає присутність богів у цьому світі чи ні.",shape=box,color=blue];
		j1715457254 -> j1214479994;
	j545167590 [label="Я вплівся у їхнє минуле таким самим візерунком, яким вони вплелися в моє. Я бачив все про «Заримен 10.0», відблиски Давньої війни й так само вони бачили все з мого життя.",shape=box,color=blue];
		j545167590 -> j3401477582;
	j1402159915 [label="Я дійшов до усвідомлення, що наша срібна пані могла так трагічно благословити. Вона не хотіла би вилучати пам’ять про біль, як це сталося з Роутом.",shape=box,color=blue];
		j1402159915 -> j2188783234;
	j1109460326 [label="Але, на мою думку, це не змінює того, що я роки віддав служінню організації, яка у своїй суті мала на меті нести добро цьому світові.",shape=box,color=blue];
		j1109460326 -> j3919090023;
	j1214479994 [label="І твої слова… ми можемо ніколи не дізнатися. І може так бути, що нам і не належить знати. Так влаштовано світ. Але, на мою думку, це не змінює того, що я роки віддав служінню організації, яка у своїй суті мала на меті нести добро цьому світові.",shape=box,color=blue];
		j1214479994 -> j3919090023;
	j3401477582 [label="Це… посіяло чимало сумнівів у мені… особливо стосовно віри. Вона тріснула й розсипалася, немов зотлілий папір перетворилася на попіл. Я ненавиджу себе за проявлену слабкість…",shape=box,color=blue];
		j3401477582 -> j3287457751;
	j2188783234 [label="Також вона б і не хотіла витягнути жало батога з моєї плоті. Це точно не її шлях позбавити мене горя від утрати.",shape=box,color=blue];
		j2188783234 -> j916494348;
	j3919090023 [label="Допомагати тим, хто бажав стерти біль зі своїх життів у ті миті, коли він міг поглинути їх.",shape=box,color=blue];
		j3919090023 -> j4184376279;
	j3287457751 [label="Evaluate expressions",color=orange];
		j3287457751 -> j359801033 [label="LyonDating",color=purple];
		j3287457751 -> j1875498762 [label="DrifterFaithYesSimilar",color=purple];
		j3287457751 -> j1875498762 [label="DrifterFaithYesForeign",color=purple];
		j3287457751 -> j1875498762 [label="DrifterFaithPersonal",color=purple];
		j3287457751 -> j1276746415 [label="DrifterFaithSol",color=purple];
		j3287457751 -> j1276746415 [label="DrifterFaithLua",color=purple];
		j3287457751 -> j1276746415 [label="DrifterFaithBalance",color=purple];
		j3287457751 -> j3519606254 [label="DrifterFaithAgnostic",color=purple];
		j3287457751 -> j143157816 [label="DrifterFaithNoFear",color=purple];
		j3287457751 -> j104407113 [label="DrifterFaithNoMITW",color=purple];
		j3287457751 -> j143157816 [label="DrifterFaithNoMaybe",color=purple];
		j3287457751 -> j409751045 [label="false",color=purple];
	j916494348 [label="Там, де Сол розпеченим ножем припік би біль, Луа б дозволила зануритися в тепло болю від можливої утрати.",shape=box,color=blue];
		j916494348 -> j2068996560;
	j4184376279 [label="Я знаю. якби я досі міг знайти присутність Релла та його Гарроу, то вони не хотіли б, щоб я страждав від утрати. Вони спочивають у спокої.",shape=box,color=blue];
		j4184376279 -> j3738575798;
	j359801033 [label="Ох, Ліоне… тобі довелося стільки пережити. Сумніви — не результат слабкості. Сумніви — результат болю.",shape=box,color=red];
		j359801033 -> j854542073;
		j359801033 -> j2414678252;
		j359801033 -> j4023041087;
		j359801033 -> j4108349776;
		j359801033 -> j342268323;
	j1875498762 [label="Віра не завжди має бути постійною… та цього й не очікується. Є стільки історій про тих, хто втрачає віру для того, щоби згодом її знову знайти.",shape=box,color=red];
		j1875498762 -> j854542073;
		j1875498762 -> j2414678252;
		j1875498762 -> j4023041087;
	j1276746415 [label="Ліоне, твоє життя пройшло у присвяті нашим Світочам. Невже ти вважаєш, що вони через щось таке відвернуться від тебе?",shape=box,color=red];
		j1276746415 -> j854542073;
		j1276746415 -> j2414678252;
		j1276746415 -> j4023041087;
	j3519606254 [label="Ліоне, я не знаю, існують боги чи ні… не знаю, чи хоч хтось із нас дізнається. Але знаю, що тобі довелося пройти крізь непрості часи.",shape=box,color=red];
		j3519606254 -> j854542073;
		j3519606254 -> j4023041087;
		j3519606254 -> j4108349776;
	j143157816 [label="Я особисто не вірю в існування богів у цьому світі, але знаю важливість цього у твоєму житті. І не хочу применшувати це.",shape=box,color=red];
		j143157816 -> j4023041087;
		j143157816 -> j342268323;
	j104407113 [label="Ліоне, Байдужість створена нами — то не божество. Не дай помилкам Ентраті знищити тебе. А щодо віри?",shape=box,color=red];
		j104407113 -> j4023041087;
		j104407113 -> j342268323;
	j409751045 [label="Боляче бачити тебе таким, затягнутим у цю маячню. Ти такого не заслуговуєш.",shape=box,color=red];
		j409751045 -> j854542073;
		j409751045 -> j2414678252;
		j409751045 -> j4023041087;
		j409751045 -> j4108349776;
		j409751045 -> j342268323;
	j2068996560 [label="Бо відсутність болю загрожує нам знищенням, так само як його надлишок може втопити нас.",shape=box,color=blue];
		j2068996560 -> j1589796437;
		j2068996560 -> j1048307825;
		j2068996560 -> j69289087;
	j3738575798 [label="Також я не вірю в те, що мої страждання були марними. Не може це применшити значення того, що я пережив.",shape=box,color=blue];
		j3738575798 -> j1024644245;
	j854542073 [label="Я не кажу, що тобі потрібно знову відшукати віру. Я кажу, що за бажання… якщо виникне потреба… то це не те що втрачають назавжди.",shape=box,color=red];
		j854542073 -> j3961798971;
	j2414678252 [label="Звісно, Луа бачить крізь що ти пройшов. Що ти витримав в її ім’я. ",shape=box,color=red];
		j2414678252 -> j3912406458;
	j4023041087 [label="Я думаю, що тобі варто зосередитися на пошуках примирення з собою.",shape=box,color=red];
		j4023041087 -> j3961798971;
	j4108349776 [label="Якщо є боги, якщо існує твоя Луа — то дійсно вона бачить крізь що ти пройшов. Що витримав у її ім’я. Це має щось означати для неї.",shape=box,color=red];
		j4108349776 -> j3912406458;
	j342268323 [label="Гадаю, тобі варто відкинути роздуми про існування богів і першочергово зосередитися на зціленні себе.",shape=box,color=red];
		j342268323 -> j1573251365;
	j1589796437 [label="Повір мені… я знаю, якою небезпечною може бути апатія.",shape=box,color=red];
		j1589796437 -> j1581241396;
	j1048307825 [label="Це означає, що ти віднайшов свою віру?",shape=box,color=red];
		j1048307825 -> j1523861059;
	j69289087 [label="[Завершити розмову]",shape=box,color=red];
		j69289087 -> j3856020424;
	j1024644245 [label="Бо відсутність болю загрожує нам знищенням, так само як його надлишок може втопити нас.",shape=box,color=blue];
		j1024644245 -> j1589796437;
		j1024644245 -> j3625925611;
		j1024644245 -> j69289087;
	j3961798971 [label="Boolean LyonFaith3Maybe is now true.",color=orange];
		j3961798971 -> j3922499280;
