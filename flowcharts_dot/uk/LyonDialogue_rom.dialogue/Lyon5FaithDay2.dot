		j3856020424 -> "Chat ends.";
	j3625925611 [label="Це означає, що ти відкидаєш свою віру?",shape=box,color=red];
		j3625925611 -> j1523861059;
	j3922499280 [label="Я міркував над тим, що означає невідворотна присутність Релла та Гарроу в моєму житті…",shape=box,color=blue];
		j3922499280 -> j4059865197;
	j1987151665 [label="Я думав про ті роки, котрі віддав служінню організації, яка у своїй суті мала на меті нести добро цьому світові… що означає невідворотність присутності Релла та Гарроу в моєму житті…",shape=box,color=blue];
		j1987151665 -> j1804789850;
	j3254251474 [label="Я міркував над тим, що означає невідворотна присутність Релла та Гарроу в моєму житті…",shape=box,color=blue];
		j3254251474 -> j1504832323;
	j3900386396 [label="Я не знаю, чи є подібне цій вірі, коли хтось як я насправді «знайшов» чи «втратив», але натомість увесь час шукав. Вічно ставив запитання — і вічно шукав на них відповіді.",shape=box,color=blue];
		j3900386396 -> j48076918;
	j48076918 [label="Та тут, гадаю, як і з болем — треба дотримуватися рівноваги, щоб ніхто не захлинувся, але й не звик настільки, що став невразливим та онімілим.",shape=box,color=blue];
		j48076918 -> j1286686499;
	j4059865197 [label="Щоби потім знову вирвати їх з моєї душі й лишити лише спогади. І я не знаю, чи це позначає присутність богів у цьому світі чи ні.",shape=box,color=blue];
		j4059865197 -> j1214479994;
	j1804789850 [label="Щоби потім знову вирвати їх з моєї душі й лишити лише спогади. І яким чином це може бути даром Луа…",shape=box,color=blue];
		j1804789850 -> j4130006955;
	j1504832323 [label="Щоби потім знову вирвати їх з моєї душі й лишити лише спогади. І твоя правда. Це може означати, що богів немає в цьому світі.",shape=box,color=blue];
		j1504832323 -> j1109460326;
	j1286686499 [label="Check boolean DrifterFaithNoMITW",color=orange];
		j1286686499 -> j2437255665 [label=true,color=green];
		j1286686499 -> j2673707034 [label=true,color=green];
		j1286686499 -> j2582372880 [label=false,color=brown];
		j1286686499 -> j2673707034 [label=false,color=brown];
	j4130006955 [label="Певно, твоя правда. Лише наша срібна пані могла так трагічно благословити. Вона не хотіла би вилучати пам’ять про біль, як це сталося з Роутом.",shape=box,color=blue];
		j4130006955 -> j2188783234;
	j2437255665 [label="Ти погоджуєшся з Роутом і мною, що Людина в стіні не справжнє божество?",shape=box,color=red];
		j2437255665 -> j3161793973;
	j2673707034 [label="Як думаєш, де тут місце для Байдужості?",shape=box,color=red];
		j2673707034 -> j49250406;
	j2582372880 [label="Ти станеш на сторону Роута в думців, що Байдужість є справжнім божеством, чи ні?",shape=box,color=red];
		j2582372880 -> j3161793973;
	j3161793973 [label="Я не знаю своєї думки стосовно цього. Мені бракує доказів для прийняття рішення. Але можу припустити, що це мало що міняє, чи не так?",shape=box,color=blue];
		j3161793973 -> j3060137123;
		j3161793973 -> j2662972102;
	j49250406 [label="Божество Байдужість чи ні, я не знаю своєї думки стосовно цього. Мені бракує доказів для прийняття рішення. Але можу припустити, що це мало що міняє, чи не так?",shape=box,color=blue];
		j49250406 -> j3060137123;
		j49250406 -> j2662972102;
	j3060137123 [label="Думаю, що багато чого. Якщо не справжнє божество, значить створене людьми. А, отже, може бути подолане людьми.",shape=box,color=red];
		j3060137123 -> j1807191384;
	j2662972102 [label="Про що ти?",shape=box,color=red];
		j2662972102 -> j212125399;
	j1807191384 [label="Якщо не маєш надії, що наших зусиль достатньо для перемоги, то для чого взагалі протистояти? Ти навдивовижу цікаве створіння.",shape=box,color=blue];
		j1807191384 -> j2491707462;
	j212125399 [label="Методи його появи в нашому всесвіті не змінюють методів, якими його можна здолати.",shape=box,color=blue];
		j212125399 -> j3522819340;
	j2491707462 [label="Ти не можеш насправді мати саме це на увазі. Ти що, просто «погоджуєшся» з діями інших? Ведеш боротьбу, бо нема більше чим ліпшим зайнятися?",shape=box,color=blue];
		j2491707462 -> j1772186517;
	j3522819340 [label="Узріть — божество, сотворене нами. Зшите з уривків нашої власної пустоти.",shape=box,color=blue];
		j3522819340 -> j2738787077;
	j1772186517 [label="Упевнений, що ти можеш підібрати ліпше хобі.",shape=box,color=blue];
		j1772186517 -> j3896531549;
		j1772186517 -> j497855270;
	j2738787077 [label="Тканинна лялька, яку ми заповнюватимемо сумом, журбою, болем, гнівом, муками, допоки шви не тріщатимуть.",shape=box,color=blue];
		j2738787077 -> j173028152;
	j3896531549 [label="Та ні, я не вважаю це безнадійним. Це геть не те, що малося на увазі.",shape=box,color=red];
		j3896531549 -> j1532248103;
	j497855270 [label="Я про те, що це змінює наші підходи до вбивства. До розуміння що і як.",shape=box,color=red];
		j497855270 -> j697858266;
	j173028152 [label="Ти вже пробач, але це мене жахає набагато більше, аніж якби це було божеством до нашого прибуття. ",shape=box,color=blue];
		j173028152 -> j3707683982;
	j1532248103 [label="Думати перед тим, як випустити слова у світ, не є обов’язковим. Те саме стосується й куль. ",shape=box,color=blue];
		j1532248103 -> j3522819340;
	j697858266 [label="Я не вірю, що це правда. Я б стверджував, що величина нашого розуміння його мотивації така ж мала, якби це було «величне й невідоме божество».",shape=box,color=blue];
		j697858266 -> j3522819340;
	j3707683982 [label="Так, знаєш, насправді я би обрав таке.",shape=box,color=blue];
		j3707683982 -> j1704549723;
	j1704549723 [label="Тоді може бути сподівання, що воно загалом трохи розумніше за людство.",shape=box,color=blue];
		j1704549723 -> j3231186435;
	j3231186435 [label="З цією… надміру похмурою тезою я маю покинути тебе на сьогодні.",shape=box,color=blue];
		j3231186435 -> j742749064;
