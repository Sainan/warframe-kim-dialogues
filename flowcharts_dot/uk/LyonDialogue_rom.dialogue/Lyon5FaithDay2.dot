	j1573251365 [label="Boolean LyonFaith3No is now true.",color=orange];
		j1573251365 -> j3254251474;
	j1581241396 [label="Схоже, що так. ",shape=box,color=blue];
		j1581241396 -> j3900386396;
	j1523861059 [label="Складно сказати. Я не знаю, чи є подібне цій ситуації, коли хтось як я насправді «знайшов» чи «втратив», але весь час шукав. Вічно ставив запитання — і вічно шукав на них відповіді.",shape=box,color=blue];
		j1523861059 -> j48076918;
