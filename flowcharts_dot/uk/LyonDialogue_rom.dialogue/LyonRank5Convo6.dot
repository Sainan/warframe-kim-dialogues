digraph {
	graph [fontname="Roboto Condensed"];
	node [fontname="Roboto Condensed"];
	edge [fontname="Roboto Condensed"];

	"LyonRank5Convo6 begins." [color=orange];
		"LyonRank5Convo6 begins." -> j3203510524;
	j3203510524 [label="Evaluate expressions",color=orange];
		j3203510524 -> j2794461914 [label="LoidFamilyComplete",color=purple];
		j3203510524 -> j1393831674 [label="MarieEntratiCompleteA",color=purple];
		j3203510524 -> j4071642927 [label="MarieEntratiCompleteB",color=purple];
		j3203510524 -> j30342254 [label="MarieEntratiCompleteC",color=purple];
		j3203510524 -> "Chat ends." [label="false",color=purple];
	j2794461914 [label="Мандрівниче. У мене є прохання, якщо ти не проти.",shape=box,color=blue];
		j2794461914 -> j255718574;
		j2794461914 -> j1478915251;
	j1393831674 [label="Я можу скористатися вільною хвилинкою і похвалити тебе за те, що вважав донині неможливим... Це стосовно Марі. Я чув про те, що між вами сталося…",shape=box,color=blue];
		j1393831674 -> j2472827340;
		j1393831674 -> j3947275696;
		j1393831674 -> j1478915251;
	j4071642927 [label="Висловлюю тобі співчуття стосовно шляхетних, але таких трагічно короткочасних зусиль, пов’язаних зі справою «le Cardinal».",shape=box,color=blue];
		j4071642927 -> j3947275696;
		j4071642927 -> j2472827340;
		j4071642927 -> j1478915251;
	j30342254 [label="Мені шкода, що ви з Марі не знайшли спільної мови стосовно «le Cardinal». Але я радий, що хоча б до бійки не дійшло.",shape=box,color=blue];
		j30342254 -> j3947275696;
		j30342254 -> j2472827340;
		j30342254 -> j1478915251;
	"Chat ends." [color=orange];
	j255718574 [label="Про що мова?",shape=box,color=red];
		j255718574 -> j288994560;
	j1478915251 [label="[Завершити розмову]",shape=box,color=red];
		j1478915251 -> "Chat ends.";
	j2472827340 [label="Я не дуже пишаюся кількома написаними словами, але… ",shape=box,color=red];
		j2472827340 -> j2211249984;
	j3947275696 [label="Вона тобі все розповіла, чи не так?",shape=box,color=red];
		j3947275696 -> j1264929425;
	j288994560 [label="Прошу, переконай Марі припинити використовувати некрамітів для копіювання меблів. Я не знаю куди ще прилаштувати ті всі стільці.",shape=box,color=blue];
		j288994560 -> j1411868721;
	j2211249984 [label="Зрештою, була причина для вигадки поняття «у пориві пристрасті». Якби ми повсякчас дотримувалися своїх переконань, то життя могло би бути жахливо нудним, на мою думку.",shape=box,color=blue];
		j2211249984 -> j3951600840;
	j1264929425 [label="Так. Ми щовечора переповідаємо одне одному події дня. І після вашої розмови вона притьма кинулася до мене, щоб розповісти про свої думки з цього питання.",shape=box,color=blue];
		j1264929425 -> j627041754;
		j1264929425 -> j1733403120;
	j1411868721 [label="+20 Chemistry",color=orange];
		j1411868721 -> j636706551;
	j3951600840 [label="Точно тихішим. Набагато спокійнішим. Але нудним. І точно не було б ніяких обговорень мистецтва.",shape=box,color=blue];
		j3951600840 -> j1885132359;
	j627041754 [label="Що вона тобі розповіла?",shape=box,color=red];
		j627041754 -> j3495933037;
	j1733403120 [label="І?..",shape=box,color=red];
		j1733403120 -> j3495933037;
	j636706551 [label="І я відмовляюся прийняти її… барвисті описи пропозиції стосовно того, в якій частині анатомічної будови Роута їх можна зберігати.",shape=box,color=blue];
		j636706551 -> "Chat ends.";
	j1885132359 [label="Але я відійшов від теми. Мене цікавить інше. З її слів я сприйняв те, що твої тези були зворушливими. Маю перепитати — тебе задовольняє те, як усе лишилося між вами?",shape=box,color=blue];
		j1885132359 -> j1424199455;
	j3495933037 [label="Check boolean LyonDating",color=orange];
		j3495933037 -> j1528742949 [label=true,color=green];
		j3495933037 -> j499443689 [label=false,color=brown];
	j1424199455 [label="Evaluate expressions",color=orange];
		j1424199455 -> j30842661 [label="MarieDating & MarieFamilyFail",color=purple];
		j1424199455 -> j155729387 [label="MarieDating & MarieFamilyFail",color=purple];
		j1424199455 -> j2480426782 [label="MarieFamilyFail",color=purple];
		j1424199455 -> j4140134449 [label="MarieFamilyFail",color=purple];
		j1424199455 -> j30842661 [label="MarieFamilySuccess",color=purple];
		j1424199455 -> j1644276729 [label="MarieEntratiCompleteA",color=purple];
		j1424199455 -> j1854955030 [label="MarieEntratiCompleteB",color=purple];
		j1424199455 -> j2238843186 [label="MarieEntratiCompleteB",color=purple];
		j1424199455 -> j1752545944 [label="MarieEntratiCompleteC",color=purple];
		j1424199455 -> j4284654935 [label="false",color=purple];
	j1528742949 [label="Ха! Наче я міг би зрадити її довіру задля тебе. Mon miracle, я ціную тебе й твою близькість мені, але вона була моєю сестрою по духу впродовж багатьох довгих років.",shape=box,color=blue];
		j1528742949 -> j416725434;
	j499443689 [label="Ха! Наче я міг би зрадити її довіру задля тебе. Дружаньо, я ціную тебе й твою близькість мені, але вона була моєю сестрою по духу впродовж багатьох довгих років.",shape=box,color=blue];
		j499443689 -> j416725434;
	j30842661 [label="Так. Гадаю, мені вдалося заручитися її допомогою для залагодження справ між Лойдом та родиною нагорі. І це… Ліоне, це неймовірно. Не думаю, що можу пояснити наскільки це неймовірно.",shape=box,color=red];
		j30842661 -> j2329133227;
	j155729387 [label="Ні. Правду кажучи, унаслідок цього в мене тепер не буде жодної нагоди отримати від неї допомогу для залагодження стосунків між Лойдом та родиною нагорі.",shape=box,color=red];
		j155729387 -> j1672329122;
	j2480426782 [label="Ні. Правду кажучи, унаслідок цього в мене тепер не буде жодної нагоди отримати від неї допомогу для залагодження стосунків між Лойдом та родиною нагорі.",shape=box,color=red];
		j2480426782 -> j736088995;
	j4140134449 [label="Так. Вона не допомагатиме мені залагодити ситуацію між Лойдом та родиною нагорі. І це мене влаштовує.",shape=box,color=red];
		j4140134449 -> j78630574;
	j1644276729 [label="Так. Мене радує, що вона бачить Ентраті як не чисте «добро» і… не чисте «зло», так?",shape=box,color=red];
		j1644276729 -> j3587265091;
	j1854955030 [label="Мене влаштовує як усе лишилося. Знаєш, я підтримую її позицію стосовно Ентраті, чим більше думаю про це.",shape=box,color=red];
		j1854955030 -> j78630574;
	j2238843186 [label="Ми не дійшли згоди стосовно Ентраті. Не вдалося переконати її… хотілося б ліпше провести ту розмову.",shape=box,color=red];
		j2238843186 -> j1315885117;
	j1752545944 [label="Ми «погодилися не погоджуватися» стосовно Ентраті, і я думаю, що це максимально можливий варіант для цієї теми. Не думаю, що подальші розмови поліпшать ситуацію.",shape=box,color=red];
		j1752545944 -> j3882011969;
	j4284654935 [label="Чесно кажучи, усе нормально. Я не думаю, що на цьому етапі може бути гірше чи ліпше.",shape=box,color=red];
		j4284654935 -> j3882011969;
	j416725434 [label="Боюся, що її слова залишаться моєю таємницею. Тож, ні. Але вона була зворушена водночас. Мені цікаво — тебе задовольняє те, як усе лишилося між вами?",shape=box,color=blue];
		j416725434 -> j1424199455;
	j2329133227 [label="Гадаю, що осягнути всю величність цього мені до снаги. Може масштабність і ні. Але для мене… дуже почесно бути частиною цього, хоч і внесок невеликий.",shape=box,color=blue];
		j2329133227 -> j1234731092;
		j2329133227 -> j280708488;
	j1672329122 [label="Вражає… Але, хіба ж ви не коханці зараз, га? Якщо хтось і може якось вплинути на неї, то це ти, хіба ні?",shape=box,color=blue];
		j1672329122 -> j3651610384;
	j736088995 [label="Неймовірно… Що ж, відомо, що в мене є певний… вплив на неї, трохи обмежений. Ти справді вважаєш важливим зцілення стосунків між паном Лойдом та дивною родиною Ентраті?",shape=box,color=blue];
		j736088995 -> j22858926;
		j736088995 -> j3928215811;
	j78630574 [label="Я не можу визначитися чи це роздратування, пиха, невігластво чи апатія. Вважатиму це сумішшю всіх чотирьох і далі житиму своїм днем.",shape=box,color=blue];
		j78630574 -> j1437000867;
	j3587265091 [label="І справді. Я міркую приблизно так само. Не вірю, що він суто такий чи інакший… його мотивація доволі заплутана.",shape=box,color=blue];
		j3587265091 -> j3773456120;
	j1315885117 [label="Гм. На жаль, бувають часи, коли варто дати чомусь спокій. Тісто можна надміру замісити. Художники можуть додати занадто багато деталей чи фарб до картини. А в суперечці точно можна вийти за межі.",shape=box,color=blue];
		j1315885117 -> j973304177;
	j3882011969 [label="Так, може ліпше буде надалі балакати про погоду.",shape=box,color=blue];
		j3882011969 -> j2980396305;
	j1234731092 [label="Не було сподівань навіть, що ти можеш запропонувати допомогу.",shape=box,color=red];
		j1234731092 -> j850764257;
	j280708488 [label="Це означає, що ти допоможеш мені переконати Лойда піти нагору й поговорити з ними?",shape=box,color=red];
		j280708488 -> j2527684759;
	j3651610384 [label="Я дуже сподіваюся, що для цього знадобилася від тебе якась жертва, якісь зміщення пріоритетів, щоб завоювати її.",shape=box,color=blue];
		j3651610384 -> j721729677;
	j22858926 [label="Ліоне, у цьому світі так багато самотності. Так багато зажури. Чому б не покласти край цим відчуттям, коли ми можемо? ",shape=box,color=red];
		j22858926 -> j2439711922;
	j3928215811 [label="Я не маю певності стосовно цього. Це на рівні інстинктів, чистої інтуїції. Таке відчуття, що вашу трійцю Ентраті не просто так сюди привів.",shape=box,color=red];
		j3928215811 -> j4106584953;
	j1437000867 [label="Прикро.",shape=box,color=blue];
		j1437000867 -> j3497962379;
	j3773456120 [label="Його вела погорда. Жага знань. А тепер, імовірно, жага прощення. Хто зна? Цікаво, чи він хоч сам це знає?",shape=box,color=blue];
		j3773456120 -> j870212499;
	j973304177 [label="Гадаю, я б це просто відпустив. І сподівався б, що одного дня вона мала нагоду побачити Ентраті таким, яким ми знаємо його — складним, так би мовити.",shape=box,color=blue];
		j973304177 -> j870212499;
	j2980396305 [label="Я повністю готовий віддалитися від нескінченних бесід про дивовижного та бездоганного «le Cardinal».",shape=box,color=blue];
		j2980396305 -> j870212499;
	j850764257 [label="Мені відомо, що я не дуже приємний, але й не ґуль якийсь. Якщо тобі потрібна моя допомога, то вона в тебе буде.",shape=box,color=blue];
		j850764257 -> j2800191596;
	j2527684759 [label="Звісно. Якщо тобі потрібна моя допомога, то вона в тебе буде.",shape=box,color=blue];
		j2527684759 -> j2800191596;
	j721729677 [label="Це були б дуже жалюгідні стосунки.",shape=box,color=blue];
		j721729677 -> j3196355471;
	j2439711922 [label="Гм. Якого ж болю може завдати нова зустріч для залучених сторін, якщо відкриється подібна істина?",shape=box,color=blue];
		j2439711922 -> j3827774319;
		j2439711922 -> j2940357159;
	j4106584953 [label="То ти «інтуїтивно» виконуєш вказівки Ентраті чи як?",shape=box,color=blue];
		j4106584953 -> j4232364544;
		j4106584953 -> j2742623013;
	j3497962379 [label="Boolean LyonFamilyFail is now true.",color=orange];
		j3497962379 -> "Chat ends.";
	j870212499 [label="Я не знаю як складеться далі між паном Лойдом та відокремленою родиною Ентраті. Просто хочу зазначити, якщо потрібна моя допомога, то ти її матимеш.",shape=box,color=blue];
		j870212499 -> j2800191596;
	j2800191596 [label="Evaluate expressions",color=orange];
		j2800191596 -> j1523123502 [label="RoatheFamilyDelay",color=purple];
		j2800191596 -> j425934941 [label="RoatheFamilyFail",color=purple];
		j2800191596 -> j4071135640 [label="false",color=purple];
	j3196355471 [label="Ти матимеш мою допомогу, хоча зиску з неї буде небагато.",shape=box,color=blue];
		j3196355471 -> j2363955065;
	j3827774319 [label="Спершу точно болітиме. Наче вправили зламану кістку. Але іноді це єдиний спосіб, щоби рани правильно загоїлися.",shape=box,color=red];
		j3827774319 -> j1206794508;
	j2940357159 [label="Я думаю, що разом ми зможемо досягти більшого, і це ліпше за те, що втратимо, коли будемо нарізно.",shape=box,color=red];
		j2940357159 -> j1206794508;
	j4232364544 [label="Ні, але я захищаю людей у потребі. І я не зможу вічно захищати їх та це місце від Шепоту й зараження. Але от ви двоє (а може ще й Роут) — можете.",shape=box,color=red];
		j4232364544 -> j1206794508;
	j2742623013 [label="Не обов’язково довіряти йому, але я досі не вважаю його нашим ворогом. Думаю, війна йде до нас і всі будуть розміщені на дошці за призначенням. І саме там ми маємо бути.",shape=box,color=red];
		j2742623013 -> j3112984415;
	j1523123502 [label="Я вважаю, що найскладніше тобі вже вдалося — переконати Роута.",shape=box,color=blue];
		j1523123502 -> j1214842074;
	j425934941 [label="Мені доведеться посидіти й поміркувати над тим, як переконати Роута передумати… і я не впевнений, що вдасться. Без нього ця справа може бути програною ще до початку.",shape=box,color=blue];
		j425934941 -> j2557664812;
		j425934941 -> j2617682777;
	j4071135640 [label="Та думаю, що найважче буде переконати найважливішого (яка жахлива думка) — Роута.",shape=box,color=blue];
		j4071135640 -> j2557664812;
		j4071135640 -> j2617682777;
	j2363955065 [label="Boolean LyonFamilySuccess is now true.",color=orange];
		j2363955065 -> j2408041597;
	j1206794508 [label="+20 Chemistry",color=orange];
		j1206794508 -> j3147126002;
	j3112984415 [label="М-м. Може й так. Але ми на фігурки з шахів, і я відмовляюся в такому підході. Якщо Ентраті бажає так усе поставити, то хай надішле клятого листа.",shape=box,color=blue];
		j3112984415 -> j2134317519;
	j1214842074 [label="Клятий виродок — як би мені не хотілося затулити йому пельку — корисний.",shape=box,color=blue];
		j1214842074 -> j3941867773;
	j2557664812 [label="Ага…",shape=box,color=red];
		j2557664812 -> j1214842074;
	j2617682777 [label="А чого Роут взагалі такий важливий для цього?",shape=box,color=red];
		j2617682777 -> j3200956644;
	j2408041597 [label="Ліон",shape=box,color=blue];
		j2408041597 -> j1933300832;
	j3147126002 [label="І справді. Мудрі слова. Що ж. Я поговорю з нею. Побачимо, чи вдасться переконати знову поговорити з тобою стосовно цього.",shape=box,color=blue];
		j3147126002 -> j3626343082;
		j3147126002 -> j3155038456;
	j2134317519 [label="Таким чином, мені лишається лише погодитися зі скаргами пана Лойда. Ти матимеш мою допомогу задля його переконання, але не думаю, що багато вдасться досягнути без Марі.",shape=box,color=blue];
		j2134317519 -> j867095391;
	j3941867773 [label="Check boolean RoatheDating",color=orange];
		j3941867773 -> j244962830 [label=true,color=green];
		j3941867773 -> j3708366077 [label=false,color=brown];
	j3200956644 [label="Ми з Марі чужинці. Роут, Лойд, Ентраті та донька Ентраті — вони з одного часу. Не кажучи вже про те, що він має знання, які можна використати для захисту, якщо щось піде не так.",shape=box,color=blue];
		j3200956644 -> j140920273;
	j1933300832 [label="+10 Chemistry",color=orange];
		j1933300832 -> "Chat ends.";
	j3626343082 [label="Чекай… ти… переконаєш її допомогти з родиною Ентраті для мене?",shape=box,color=red];
		j3626343082 -> j1339652253;
	j3155038456 [label="Я. Ти. Ти серйозно?",shape=box,color=red];
		j3155038456 -> j1339652253;
	j867095391 [label="Boolean LyonFamilySuccess is now true.",color=orange];
		j867095391 -> j2595043311;
	j244962830 [label="Без образ.",shape=box,color=blue];
		j244962830 -> j3696982613;
		j244962830 -> j3525600239;
	j3708366077 [label="І знову я відійшов від теми. Я ж кажу, коли прийде час. І, до речі про час, маю йти.",shape=box,color=blue];
		j3708366077 -> j940789375;
	j140920273 [label="Попри те, що мені незручно це визнавати, але ми з Марі досі б намагалися розібратися, як користуватися половиною штукенцій в цій споруді, а він же з легкістю всім оперує.",shape=box,color=blue];
