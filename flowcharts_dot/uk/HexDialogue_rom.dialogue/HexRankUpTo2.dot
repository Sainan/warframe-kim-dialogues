		j3546909238 -> j198939201;
	j3260252693 [label="Belladonna ~{@: Полегшення\nУ нас і так вдосталь проблем з харчами без іншого рота\nІнакше я вимагала б «Повернути відправнику»",shape=box,color=blue];
