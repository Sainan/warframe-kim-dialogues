		j2132465782 -> j372369327;
	j372369327 [label="Soldja1Shot1kil: ну якщо артур каже, шо в нас повно їдла, то тра нагодувать малюка. він ше росте",shape=box,color=blue];
		j372369327 -> j2885317310;
