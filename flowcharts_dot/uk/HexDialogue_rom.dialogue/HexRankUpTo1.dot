		"HexRankUpTo1 begins." -> j4231328481;
	j4231328481 [label="Broadsword: Ми тут застрягли, ясно? Тож прибирайте за собою. Харчувальна брудніша за вулиці. А ми ж не в клятому зоопарку.",shape=box,color=blue];
		j4231328481 -> j2241446753;
	j2241446753 [label="Salem: Летті може цим зайнятися, якщо…",shape=box,color=blue];
		j2241446753 -> j3679887290;
	j3679887290 [label="Belladonna ~{@: Досить.",shape=box,color=blue];
		j3679887290 -> j3795455256;
	j3795455256 [label="Soldja1Shot1kil: ха, повелася",shape=box,color=blue];
		j3795455256 -> j264939135;
	j264939135 [label="H16h V0l7463: ого народ ви нарешті використовуєте мій груповий чат?! ЯК ЖЕ ЦЕ КРУТО!!",shape=box,color=blue];
		j264939135 -> j1444642631;
	j1444642631 [label="xX GLIMMER Xx: :) <3 Я ж тобі казала Аміре!",shape=box,color=blue];
		j1444642631 -> j2652830145;
