	j3618461928 [label="H16h V0l7463: у тебе є ДОВБАНИЙ РОБОТ ПРИБИРАЛЬНИК",shape=box,color=blue];
		j3618461928 -> j329681320;
	j329681320 [label="Broadsword: Прекрасно. Але Аой його на друзки розбере, якщо він мене будитиме.",shape=box,color=blue];
		j329681320 -> j167099597;
	j167099597 [label="Soldja1Shot1kil: нє, я перший — буде мішенню для тренувань, дружаньо",shape=box,color=blue];
		j167099597 -> j3434112719;
	j3434112719 [label="Belladonna ~{@: Артур каже про те, про що я думаю\nПрибирайте за собою\nБо може настати час, коли харчувальна стане операційною\n¿Entendieron?",shape=box,color=blue];
		j3434112719 -> j3882213021;
	j3882213021 [label="Salem: Летті, та ну тебе. Додай трохи оптимізму. У нас нові люди в загоні.",shape=box,color=blue];
		j3882213021 -> j2144559452;
	j2144559452 [label="xX GLIMMER Xx: точно?! оптимізм! круто! отже, мандрівниче. у тебе свіжий погляд. як тобі харчувальна, що скажеш? <RETRO_EMOJI_FOOD>",shape=box,color=blue];
		j2144559452 -> j1255406372;
		j2144559452 -> j3695037088;
	j1255406372 [label="Схоже, що тут вдосталь місця, щоби всі могли їсти.",shape=box,color=red];
		j1255406372 -> j2704681028;
	j3695037088 [label="Нагадує мені дещо. Дуже схоже на місце, де можна поїсти й поговорити.",shape=box,color=red];
		j3695037088 -> j1824392905;
	j2704681028 [label="Boolean HexFoodCourtSit is now true.",color=orange];
		j2704681028 -> j3162592319;
	j1824392905 [label="Boolean HexFoodCourtMemory is now true.",color=orange];
		j1824392905 -> j3162592319;
	j3162592319 [label="H16h V0l7463: нууууу, добре, але якщо там Артур, то не заходь. попереджаю: вінлюбитьсвоюсамотність…",shape=box,color=blue];
		j3162592319 -> j1733814605;
	j1733814605 [label="Broadsword: Аміре.",shape=box,color=blue];
		j1733814605 -> j4153068127;
	j4153068127 [label="xX GLIMMER Xx: ^_^ та круте місце. увесь торговельний центр. і він весь наш.",shape=box,color=blue];
		j4153068127 -> j1845605552;
	j1845605552 [label="Soldja1Shot1kil: ми. не. обирали.",shape=box,color=blue];
