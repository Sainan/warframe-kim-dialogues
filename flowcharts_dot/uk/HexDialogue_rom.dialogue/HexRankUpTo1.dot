digraph {
	12 [label="HexRankUpTo1 begins.",color=orange];
		12 -> 16;
	16 [label="Broadsword: Ми тут застрягли, ясно? Тож прибирайте за собою. Харчувальна брудніша за вулиці. А ми ж не в клятому зоопарку.",shape=box,color=blue];
