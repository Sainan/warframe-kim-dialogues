		j2652830145 -> j3662765472;
	j372432453 [label="Насправді в мене є дещо, що допоможе прибирати. |ITEM_A| — вітайте!",shape=box,color=red];
		j372432453 -> j2129817404;
	j1499686650 [label="Насправді в мене є дещо, що допоможе прибирати. |ITEM_B| — вітайте!",shape=box,color=red];
