		j2424092567 -> j240505641;
	j240505641 [label="Salem: М-м-м, хороший вибір.",shape=box,color=blue];
		j240505641 -> j229903289;
	j229903289 [label="Soldja1Shot1kil: нумо до фактів — готові відчиняти браму? я поводитимуся добре. майже",shape=box,color=blue];
		j229903289 -> j695989780;
	j695989780 [label="Belladonna ~{@: Досі балачок
¡Vamos! Уперед
Не можу дочекатися поговорити з кимось про щось інше окрім бойових стійок Артура",shape=box,color=blue];
		j695989780 -> j1246071840;
	j1246071840 [label="Salem: Ох, Летті. Та ми *всі* знаємо, що ти його переможеш.",shape=box,color=blue];
		j1246071840 -> j2493609605;
	j2493609605 [label="xX GLIMMER Xx: летті? ти серйозно? ти наче насправді схвильована! <RETRO_EMOJI_JOY>",shape=box,color=blue];
		j2493609605 -> j110539338;
	j110539338 [label="Broadsword: Усе. Я відчиняю торговельний центр. Це невідворотно. Жодних змін думки. Пам’ятайте: це дещо означає для людей — бути десь, де безпечно. Але ми можемо ліпше. Розважаймося.",shape=box,color=blue];
		j110539338 -> j119875361;
