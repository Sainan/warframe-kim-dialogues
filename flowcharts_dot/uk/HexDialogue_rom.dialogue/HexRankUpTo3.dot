	196 [label="Update boolean HexGiveHope",color=orange];
		196 -> 109;
	109 [label="H16h V0l7463: гммм, не бути пригніченими? але мені все ж здається, що ми запрошуємо людей на вечірку-розчарування.",shape=box,color=blue];
		109 -> 110;
