		102 -> 103;
	103 [label="Soldja1Shot1kil: ще роти для годування… навіть якшо його величність вважає, шо тут добре й затишно. кепська ідея",shape=box,color=blue];
		103 -> 104;
	104 [label="Salem: Я можу вигнати їх. Для цього варто лише подумати…",shape=box,color=blue];
		104 -> 105;
	105 [label="xX GLIMMER Xx: ніяк не можу перестати думати… навіть якщо ми робимо все можливе. для чого даватимемо хибні враження спокою і впевненості, що ми можемо когось урятувати? це добром не закінчиться ні для кого.",shape=box,color=blue];
		105 -> 106;
