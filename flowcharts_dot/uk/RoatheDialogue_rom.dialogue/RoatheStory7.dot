	j143055934 [label="ВКЛАД",shape=box,color=blue];
		j143055934 -> j3320777236;
	j3320777236 [label="Витяг: Поміж Сімох я був — як мені казали — забавкою та коханцем Нітог.",shape=box,color=blue];
		j3320777236 -> j3703377494;
	j3703377494 [label="У перші дні війни вони мене призначили віцерегентом великим карном. Це вона наполягла, а вони сприйняли за жарт.",shape=box,color=blue];
		j3703377494 -> j3217579779;
	j3217579779 [label="О, як же ж швидко їхній регіт перетворився на урочисті оплески, коли я здобував перемогу за перемогою.",shape=box,color=blue];
		j3217579779 -> j2255323204;
	j2255323204 [label="Кров ліпших із ліпших укривала мене, як медалі. Потай я накопичував зброю для Нітог.",shape=box,color=blue];
		j2255323204 -> j3859698796;
	j3859698796 [label="Це було нескладно. Я був занадто звитяжною постаттю для підозр.",shape=box,color=blue];
		j3859698796 -> j921430358;
	j921430358 [label="Add 1 to HellStory counter",color=orange];
		j921430358 -> "Chat ends.";
}