		2191 -> 5688;
	5688 [label="У перші дні війни вони мене призначили віцерегентом великим карном. Це вона наполягла, а вони сприйняли за жарт.",shape=box,color=blue];
		5688 -> 5689;
	5689 [label="О, як же ж швидко їхній регіт перетворився на урочисті оплески, коли я здобував перемогу за перемогою.",shape=box,color=blue];
		5689 -> 2187;
