	"Chat ends." [color=orange];
	j1747730850 [label="ОРОКІНИ",shape=box,color=blue];
		j1747730850 -> j3441591230;
	j3441591230 [label="Імперія орокінів дуже довго не мала ворогів. Війська існували лише для дрібних чвар, боротьби між домами, сутичок між Виконавцями.",shape=box,color=blue];
		j3441591230 -> j1473176115;
	j1473176115 [label="Коли свідомі напали, ми вперше за багато століть пізнали єдність. Дакси витягли мечі проти когось іншого, аніж зухвалий селянин чи злодійкуватий торговець.",shape=box,color=blue];
		j1473176115 -> j3630558158;
	j3630558158 [label="Імператори, безсмертні номінальні правителі Імперії, чия влада була зосереджена в руках Виконавців, зрушили зі своїх запилених золотих тронів.",shape=box,color=blue];
		j3630558158 -> j2218714262;
	j2218714262 [label="Війна, велична війна! Нарешті Імперія набувала значення. Пробуджені загрозою знищення, ближчою за неминучу смерть Сонця, ми пили жадібно нектар життя.",shape=box,color=blue];
		j2218714262 -> j921430358;
	j921430358 [label="Add 1 to HellStory counter",color=orange];
		j921430358 -> "Chat ends.";
}