	"Chat ends." [color=orange];
	j2905989654 [label="ВОГОНЬ",shape=box,color=blue];
		j2905989654 -> j2496549248;
	j2496549248 [label="Витяг: Надмірність і потворність чудово працювали на нас у минулому. Від мене чекали того самого як від стратега.",shape=box,color=blue];
		j2496549248 -> j2317795807;
	j2317795807 [label="Як ми приборкали зараження у часи предків? Звісно ж, вирвали ядра атомів, наче пелюстки з бутона троянди!",shape=box,color=blue];
		j2317795807 -> j3453079725;
	j3453079725 [label="Усі Семеро одноголосно наказали мені стати Дияволом із боєголовками в тризубці. Сіячем із ковша нестримуваної радіації.",shape=box,color=blue];
		j3453079725 -> j1507432668;
	j1507432668 [label="Саме тоді ми дізналися, що свідомі не лише нейтралізують нашу технологію, а й можуть перебрати управління нею.",shape=box,color=blue];
		j1507432668 -> j800179215;
	j800179215 [label="Зграя наших лихих малих дронів-вирівнювачів, яких ми відправили знищувати, із веселим незнаним нам щебетом повернулася назад, усе ще важка від бомб. Вони вибухнули в самісінькому серці материнських зорельотів, що їх відрядили.",shape=box,color=blue];
		j800179215 -> j921430358;
	j921430358 [label="Add 1 to HellStory counter",color=orange];
		j921430358 -> "Chat ends.";
}