	2241 [label="Chat ends.",color=orange];
	2244 [label="Витяг: Надмірність і потворність чудово працювали на нас у минулому. Від мене чекали того самого як від стратега.",shape=box,color=blue];
		2244 -> 2239;
	2239 [label="Як ми приборкали зараження у часи предків? Звісно ж, вирвали ядра атомів, наче пелюстки з бутона троянди!",shape=box,color=blue];
		2239 -> 2236;
	2236 [label="Усі Семеро одноголосно наказали мені стати Дияволом із боєголовками в тризубці. Сіячем із ковша нестримуваної радіації.",shape=box,color=blue];
		2236 -> 5704;
	5704 [label="Саме тоді ми дізналися, що свідомі не лише нейтралізують нашу технологію, а й можуть перебрати управління нею.",shape=box,color=blue];
		5704 -> 5705;
	5705 [label="Зграя наших лихих малих дронів-вирівнювачів, яких ми відправили знищувати, із веселим незнаним нам щебетом повернулася назад, усе ще важка від бомб. Вони вибухнули в самісінькому серці материнських зорельотів, що їх відрядили.",shape=box,color=blue];
		5705 -> 2238;
