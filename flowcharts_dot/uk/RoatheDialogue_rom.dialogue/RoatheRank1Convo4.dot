digraph {
	472 [label="RoatheRank1Convo4 begins.",color=orange];
		472 -> 473;
	473 [label="Check boolean LoidFamilyComplete",color=orange];
		473 -> 474 [label=true,color=green];
		473 -> 475 [label=false,color=brown];
	474 [label="Те, що сталося з Евлерією та Петросом, майже трагічно. Зверни увагу, ми ніколи не були друзями. Але вони все одно були орокінами. А тепер нас залишилося дуже мало. Хоча, мабуть, мені варто бути обережним у своїх висловлюваннях, хто знає, на що я можу перетворитися з часом.",shape=box,color=blue];
		474 -> 476;
	475 [label="Мені здається досить смішним, що Евлерія та Петрос дійсно не мають ні найменшого уявлення про те, що ми тут, унизу. Як щури, що бігають під їхніми ногами. Як тобі з дітьми вдалося так довго зберігати це в таємниці?",shape=box,color=blue];
		475 -> 477;
	476 [label="Найменше мене здивувало, що вижила «Бабуся». Уяви собі, відмовитися від такого чудового імені як Даґат.",shape=box,color=blue];
		476 -> 478;
		476 -> 479;
	477 [label="Evaluate expressions on HellStory",color=orange];
		477 -> 481 [label="x >= 21",color=purple];
		477 -> 480 [label="x < 21",color=purple];
		477 -> 480 [label="false",color=purple];
	478 [label="Петрос?",shape=box,color=red];
		478 -> 482;
	479 [label="Що ти думаєш про дітей?",shape=box,color=red];
		479 -> 483;
	481 [label="Хоча, чесно кажучи, я набагато більше здивований тим, що «Бабуся» не змогла цього зрозуміти. Уяви собі, відмовитися від такого чудового імені як Даґат. Я думав, що в неї більше здорового глузду.",shape=box,color=blue];
		481 -> 486;
	480 [label="Хоча, чесно кажучи, я набагато більше здивований тим, що «Бабуся» не змогла цього зрозуміти. Уяви собі, відмовитися від такого чудового імені як Даґат. Я думав, що в неї більше здорового глузду.",shape=box,color=blue];
		480 -> 484;
		480 -> 485;
	482 [label="Гм? А. Некралойд повідомив мені, що ти або маля допомогли їм вигадати фальшиві імена, забувши свої справжні. Ти знаєш його як Вілкора.",shape=box,color=blue];
		482 -> 487;
	483 [label="Хлопчина вередливий, дратівливий і егоцентричний. Ідеальний орокін. «Кейлі», як вона хоче, щоб її так називали, я вважаю надзвичайно розумною й майже вартою того, щоб терпіти її присутність.",shape=box,color=blue];
		483 -> 488;
	486 [label="І. Це абсурд. Я знаю, що ми вже проходили через усе це раніше. І ми вже говорили про це. Але це питання мене досі глибоко турбує.",shape=box,color=blue];
		486 -> 491;
	484 [label="У них є власні… проблеми, на яких потрібно зосередитися.",shape=box,color=red];
		484 -> 489;
	485 [label="Петрос?",shape=box,color=red];
		485 -> 490;
	487 [label="Але я знав його як Петроса Вортена. Гордого винахідника флоту некрамехів. Дивно подумати, скільки часу минуло для нього, і як мало часу минуло — відносно кажучи — для мене.",shape=box,color=blue];
		487 -> 488;
	488 [label="Але як ти цього ще не знаєш? Ти мене за дурня маєш, узурпаторе? Тож ми просто будемо… переливати з пустого в порожнє, так би мовити?",shape=box,color=blue];
		488 -> 492;
	491 [label="Evaluate expressions",color=orange];
		491 -> 498 [label="RoatheDatingDeal",color=purple];
		491 -> 498 [label="RoatheMarieDatingDeal",color=purple];
		491 -> 498 [label="RoatheLyonDatingDeal",color=purple];
		491 -> 498 [label="RoatheSerumDeal",color=purple];
		491 -> 497 [label="RoatheFamilyDeal",color=purple];
		491 -> 498 [label="RoatheMarieEntratiDeal",color=purple];
		491 -> 498 [label="RoatheLyonConfessionDeal",color=purple];
		491 -> 499 [label="false",color=purple];
	489 [label="Check /Lotus/Scripts/1999/DialogueScriptNodes.lua:IsSyndicateRank",color=orange];
		489 -> 494 [label=true,color=green];
		489 -> 493 [label=false,color=brown];
	490 [label="Check /Lotus/Scripts/1999/DialogueScriptNodes.lua:IsSyndicateRank",color=orange];
		490 -> 496 [label=true,color=green];
		490 -> 495 [label=false,color=brown];
	492 [label="Update boolean RoatheKnowsReset",color=orange];
		492 -> 500;
		492 -> 501;
		492 -> 502;
	498 [label="Отже, я тут, готовий розпочати якусь беззмістовну лекцію про суспільство орокінів, сподіваючись, що вона тебе хоч трохи зацікавить. А потім я нагадую собі, що ти тут не для цього, правда ж, мандрівниче? Ти граєш у якусь гру…",shape=box,color=blue];
		498 -> 506;
	497 [label="Отже, я тут, готовий розпочати якусь беззмістовну лекцію про суспільство орокінів, сподіваючись, що вона тебе хоч трохи зацікавить. А потім я нагадую собі — ти, швидше за все, уже все це знаєш, чи не так?",shape=box,color=blue];
		497 -> 505;
	499 [label="Ти хочеш, щоб я просто підіграв тобі? Або… є якась конкретна мета, до якої ти прагнеш, роблячи це? Я зовсім не розумію, що ти намагаєшся досягти, граючи в цю безжальну гру.",shape=box,color=blue];
		499 -> 507;
	494 [label="Так, я чув про некралойдів. Хоча, здається, їх стало менше, оскільки ти або маля попрацювали над їхнім вирішенням. Принаймні вони більше не розривають себе на шматки – у буквальному сенсі.",shape=box,color=blue];
		494 -> 504;
	493 [label="Так, я чув про некралойдів. Схоже, вони все ще мають намір розірвати себе на шматки.",shape=box,color=blue];
		493 -> 503;
	496 [label="Гм? А. Некралойд повідомив мені, що ти або маля допомогли їм вигадати фальшиві імена, забувши свої справжні. Ти знаєш його як «Вілкора». Але я знав його як Петроса Вортена. Гордого винахідника флоту некрамехів.",shape=box,color=blue];
		496 -> 504;
	495 [label="Гм? А. Я знав його як Петроса Вортена. Гордого винахідника флоту некрамехів. Але некралойд повідомив мені, що вони забули свої імена. Можливо, ти знаєш його лише як «Батька».",shape=box,color=blue];
		495 -> 503;
	500 [label="Ні, я такого не пам’ятаю. Будь ласка, продовжуй.",shape=box,color=red];
		500 -> 508;
	501 [label="Я запитую тебе, Роуте… тому що хочу розмовляти з тобою.",shape=box,color=red];
		501 -> 509;
	502 [label="Так, я вже це знаю. Але все одно, будь ласка, розкажи мені ще раз.",shape=box,color=red];
		502 -> 510;
	506 [label="Update boolean RoatheKnowsReset",color=orange];
		506 -> 500;
		506 -> 501;
		506 -> 502;
	505 [label="Update boolean RoatheKnowsReset",color=orange];
		505 -> 500;
		505 -> 501;
		505 -> 502;
	507 [label="Update boolean RoatheKnowsReset",color=orange];
		507 -> 515;
	504 [label="Evaluate expressions",color=orange];
		504 -> 514 [label="RoatheDeal",color=purple];
		504 -> 513 [label="RoatheNoDeal",color=purple];
		504 -> 513 [label="false",color=purple];
	503 [label="Evaluate expressions",color=orange];
		503 -> 512 [label="RoatheDeal",color=purple];
		503 -> 511 [label="RoatheNoDeal",color=purple];
		503 -> 511 [label="false",color=purple];
	508 [label="+5 Chemistry",color=orange];
		508 -> 516;
	509 [label="Check boolean DrifterRoathe",color=orange];
		509 -> 517 [label=true,color=green];
		509 -> 518 [label=false,color=brown];
	510 [label="Отже, ти визнаєш, що марнуєш мій час. Просто дивовижно! Я не якийсь там сивий недоумкуватий старий, який розповідає одну й ту саму військову байку, бо не може згадати інших.",shape=box,color=blue];
		510 -> 519;
	515 [label="Отже, я тут, готовий розпочати якусь беззмістовну лекцію про суспільство орокінів, сподіваючись, що вона тебе хоч трохи зацікавить. А потім я нагадую собі — ти, швидше за все, уже все це знаєш, чи не так?",shape=box,color=blue];
		515 -> 500;
		515 -> 501;
		515 -> 502;
	514 [label="Це добре, оскільки без вашого втручання ми б мало просунулися вперед. Боюся, що інакше дворецький був би перероблений на фарш у той момент, коли ми відправили його нагору.",shape=box,color=blue];
		514 -> 522;
	513 [label="До речі, яке твоє рішення щодо моєї пропозиції? Я тихо сиджу тут, в обмін на допомогу тобі примирити дворецького з тими зараженими вигнанцями орокінів нагорі?",shape=box,color=blue];
		513 -> 520;
		513 -> 521;
	512 [label="Можливо, тобі варто спочатку розв’язати цю проблему, перш ніж ми спробуємо відправити дворецького нагору. Інакше він може стати фаршем.",shape=box,color=blue];
		512 -> 522;
	511 [label="До речі, яке твоє рішення щодо моєї пропозиції? Я тихо сиджу тут, в обмін на допомогу тобі примирити дворецького з тими зараженими вигнанцями орокінів нагорі? Примирення родини було б першим кроком, але…",shape=box,color=blue];
		511 -> 520;
		511 -> 521;
	516 [label="Ти просиш орокіна поговорити. Ти хоч усвідомлюєш, що тепер буде? Ти можеш пробути тут цілу годину через свою необережність.",shape=box,color=blue];
		516 -> 523;
	517 [label="+5 Chemistry",color=orange];
		517 -> 524;
	518 [label="Га? «Молю» тебе, скажи, чому це так?",shape=box,color=blue];
		518 -> 528;
		518 -> 527;
		518 -> 525;
		518 -> 526;
	519 [label="Причина, через яку я не можу пригадати цю розмову, полягає у твоєму клятому дзеркалі!",shape=box,color=blue];
		519 -> 529;
	522 [label="Тобі потрібно зрозуміти, що дворецький та родина Ентраті, хоч і віддалено, але все ж таки орокіни. Вони народилися й виросли в цьому суспільстві, незважаючи на всі його… численні недоліки.",shape=box,color=blue];
		522 -> 532;
	520 [label="Ні, я не зміню свою думку, Роуте. Це не так важливо.",shape=box,color=red];
		520 -> 530;
	521 [label="Так. Я… даю згоду.",shape=box,color=red];
		521 -> 531;
	523 [label="Хоча, мабуть, у тебе не було можливості вдосталь поспілкуватися з орокіном, мандрівниче? Дитя мало зовсім інше життя.",shape=box,color=blue];
		523 -> 533;
	524 [label="М-м. Саме так. І ми обоє знаємо чому, правда ж? Але тобі доведеться потерпіти.",shape=box,color=blue];
		524 -> 534;
	528 [label="[Зізнатися в почуттях] Гадаю, ти знаєш.",shape=box,color=red];
		528 -> 538;
	527 [label="Я вважаю тебе цікавим.",shape=box,color=red];
		527 -> 537;
	525 [label="У мене ніколи не було можливості вдосталь поспілкуватися з орокіном. Коли… ми не билися, звісно. Ти цікавий.",shape=box,color=red];
		525 -> 535;
	526 [label="Не зважай. [Завершити розмову]",shape=box,color=red];
		526 -> 536;
	529 [label="Chat ends.",color=orange];
	532 [label="І попри всі його тяжкі гріхи, ієрархія та порядок ніколи не ставилися під сумнів. Ні серед військових, ні серед соціальних структур. Архімедівці підкорялися орокінам. Орокіни підкорялися Виконавцям. Виконавці підкорялися імператорам… ну, принаймні номінально.",shape=box,color=blue];
		532 -> 541;
	530 [label="Як хочеш. Двері не залишаться відкритими надовго.",shape=box,color=blue];
		530 -> 539;
	531 [label="Update boolean RoatheNoDeal",color=orange];
		531 -> 540;
	533 [label="З того, що я чув, завдяки тобі змінився хід трагедії на «Заримені 10.0».",shape=box,color=blue];
		533 -> 542;
		533 -> 543;
		533 -> 544;
	534 [label="Між іншим, якщо ти бажаєш «послухати», я з радістю допоможу. Просто попереджаю. Ти просиш орокіна поговорити.",shape=box,color=blue];
		534 -> 545;
	538 [label="+5 Chemistry",color=orange];
		538 -> 549;
	537 [label="+5 Chemistry",color=orange];
		537 -> 548;
	535 [label="Знай свого ворога, чи не так? Або, можливо, просто цікавість посидіти за одним столом з неймовірністю? ",shape=box,color=blue];
		535 -> 546;
	536 [label="Викручуйся скільки хочеш, рибко. Це був твій вибір.",shape=box,color=blue];
		536 -> 547;
	541 [label="І навіть якщо ти не віриш, що якимось чином, навіть після всього часу, традиції можуть надихнути Лойда послухати мене? Врахуй той факт, що я можу бути… дуже переконливим. Зрештою, я був правою рукою найгіршого Виконавця.",shape=box,color=blue];
		541 -> 551;
		541 -> 552;
		541 -> 553;
	539 [label="Chat ends.",color=orange];
	540 [label="Update boolean RoatheDeal",color=orange];
		540 -> 550;
	542 [label="Ні. До «Заримена» в мене особливо не було справ з орокінами, а після… ну ти, мабуть, уже знаєш, що сталося.",shape=box,color=red];
		542 -> 554;
	543 [label="У мене було достатньо справ з орокінами, щоби знати, що їм не можна довіряти.",shape=box,color=red];
		543 -> 555;
	544 [label="Мені прикро це казати, але мені подобається твій народ не більше ніж маляті.",shape=box,color=red];
		544 -> 555;
	545 [label="Ти хоч усвідомлюєш, що тепер буде? Ти можеш пробути тут цілу годину через свою необережність.",shape=box,color=blue];
		545 -> 523;
	549 [label="М-м. Я знаю. Але я думав, ти зробиш мені честь і дозволиш побачити це занотованим. Ну що ж…",shape=box,color=blue];
		549 -> 557;
	548 [label="Невже? Гм. Побачимо, як довго я зможу утримувати цю рибу на гачку.",shape=box,color=blue];
		548 -> 534;
	546 [label="+5 Chemistry",color=orange];
		546 -> 556;
	547 [label="Chat ends.",color=orange];
	551 [label="Найгіршим Виконавцем був Баллас.",shape=box,color=red];
		551 -> 559;
	552 [label="Кому з них ти служив?",shape=box,color=red];
		552 -> 560;
	553 [label="Тобто?",shape=box,color=red];
		553 -> 561;
	550 [label="+5 Chemistry",color=orange];
		550 -> 558;
	554 [label="Так, справді. Ох, Баллас. Тебе може це шокувати, але він був не найгіршим із них.",shape=box,color=blue];
		554 -> 562;
		554 -> 563;
	555 [label="Я тебе й не звинувачую. Я думав, що їх можна врятувати. Перетопити, так би мовити — переробити, як золото.",shape=box,color=blue];
		555 -> 564;
	557 [label="Можливо, іншим разом. Адже ти, узурпаторе, мусиш посмакувати цим моментом.",shape=box,color=blue];
		557 -> 566;
	556 [label="Поважний. Навіть мудрий. Якби я мав можливість поспілкуватися та, можливо, навіть подружитися зі свідомим? Я б зробив те саме. ",shape=box,color=blue];
		556 -> 565;
	559 [label="Я поважаю твою думку і не звинувачую тебе за це. Баллас був кретином і першорядним розпусником, я не буду з тобою про це сперечатися.",shape=box,color=blue];
		559 -> 567;
	560 [label="Evaluate expressions on HellStory",color=orange];
		560 -> 569 [label="x >= 1",color=purple];
		560 -> 568 [label="x <= 1",color=purple];
		560 -> 568 [label="false",color=purple];
	561 [label="Я розумію, що в тебе були особисті стосунки з Балласом, і не звинувачую тебе за те, що ти, ймовірно, вважаєш його найгіршим із семи Золотих Володарів. Баллас був першорядним розпусником, я не буду з тобою про це сперечатися.",shape=box,color=blue];
		561 -> 570;
	558 [label="Прекрасно! Я радий нарешті бачити твоє розуміння. Тепер ми нарешті можемо досягти певного прогресу.",shape=box,color=blue];
		558 -> 522;
	562 [label="Справді?",shape=box,color=red];
		562 -> 571;
	563 [label="Тобі буде важко переконати мене в цьому.",shape=box,color=red];
		563 -> 571;
	564 [label="Ну. За винятком Виконавців. Вони були безнадійними. Тебе може це шокувати, але Баллас був не найгіршим із них.",shape=box,color=blue];
		564 -> 563;
		564 -> 562;
	566 [label="Update boolean DrifterRoathe",color=orange];
		566 -> 534;
	565 [label="Це надає психологічну перевагу, якщо ти коли-небудь зустрінеш одного з них — або навіть колишнього союзника — на полі бою.",shape=box,color=blue];
		565 -> 572;
	567 [label="І, насправді, я не був свідком жахів цієї справи з «Нармером», про яку я дізнався від дворецького та прочитав у записах цієї ПОМ-2.",shape=box,color=blue];
		567 -> 573;
	569 [label="Я вже розповідав про неї раніше. І, що важливіше, натякав на те, що ми планували. Але це вже тема для іншої розмови. Виконавиця Нітог. Точніше сказати, віцерегентка Виконавиця Нітог. Командувачка всіх наших збройних сил, найжорстокіша та найнебезпечніша з семи Золотих Володарів.",shape=box,color=blue];
		569 -> 574;
	568 [label="Виконавиця Нітог. Точніше сказати, віцерегентка Виконавиця Нітог. Командувачка всіх наших збройних сил, найжорстокіша та найнебезпечніша з семи Золотих Володарів.",shape=box,color=blue];
		568 -> 574;
	570 [label="Цілком можливо, що він перевершив колишніх Виконавців під час цієї справи з… «Нармером», про яку я чув від дворецького та читав у записах цієї ПОМ-2.",shape=box,color=blue];
		570 -> 573;
	571 [label="Я не кажу, що він був святим. Я кажу, що найгірший із дияволів лише трохи перевершив своїх побратимів. Не зациклюйся на дрібницях, узурпаторе.",shape=box,color=blue];
		571 -> 575;
	572 [label="Що ж, якщо ти бажаєш «послухати», я з радістю допоможу. Просто попереджаю. Ти просиш орокіна поговорити.",shape=box,color=blue];
		572 -> 545;
	573 [label="Однак я також хотів би зауважити, що таке враження у тебе склалося через особисту близькість із Балласом та дуже обмежену взаємодію з іншими шістьма Золотими Володарями.",shape=box,color=blue];
		573 -> 574;
	574 [label="Золота сімка. Пхе. Ти знаєш, що найкраще в золоті, мандрівниче? Його можна нескінченно перетоплювати та переробляти на щось краще.",shape=box,color=blue];
		574 -> 576;
	575 [label="Та чи був Баллас найгіршим? Можливо, для тебе. І, можливо, його злочини в цю епоху перевершили злочини колишніх Виконавців.",shape=box,color=blue];
		575 -> 577;
	576 [label="Я вірив — і в деякому сенсі досі вірю — що орокінів можна врятувати. Що ми могли б змінити імперію. А Виконавців? Ні. Їх потрібно було зупинити. Всі вони були найгіршим, що могло запропонувати людство, з різним ступенем тяжкості.",shape=box,color=blue];
		576 -> 578;
	577 [label="Але якби тобі довелося бачити озера багряного кольору та поля, засіяні покрученими та розірваними трупами, наче викинутими дитячими іграшками…",shape=box,color=blue];
		577 -> 579;
	578 [label="І це слова від мене, узурпаторе. Тож дозволь мені, самому дияволу Тау, запевнити тебе — як знавця в цій справі — що Баллас був не найгірший серед них.",shape=box,color=blue];
		578 -> 580;
	579 [label="Якби тобі було відомо, яке спустошення могла спричинити Нітог, навіть не замислюючись ні на мить… ",shape=box,color=blue];
		579 -> 581;
	580 [label="Check boolean RoatheUsurper",color=orange];
		580 -> 583 [label=true,color=green];
		580 -> 584 [label=true,color=green];
		580 -> 582 [label=false,color=brown];
		580 -> 583 [label=false,color=brown];
		580 -> 584 [label=false,color=brown];
	581 [label="Але такі жахи важко відчути, якщо їх не бачити на власні очі. Таку трагедію не можна виміряти цифрами. Я міг би довго розповідати про те, що я бачив, але для тебе це будуть просто історії.",shape=box,color=blue];
		581 -> 585;
	583 [label="Тобі буде важко переконати мене в цьому.",shape=box,color=red];
		583 -> 587;
	584 [label="Справді?",shape=box,color=red];
		584 -> 587;
	582 [label="Чому ти постійно називаєш мене «узурпатором»?",shape=box,color=red];
		582 -> 586;
	585 [label="Для тебе Баллас завжди буде набагато більш реальним і жахливим лиходієм. І це цілком очікувано.",shape=box,color=blue];
		585 -> 588;
	587 [label="Якби ти побачив озера багряного кольору та поля, засіяні покрученими та розірваними трупами, наче викинутими дитячими іграшками…",shape=box,color=blue];
		587 -> 579;
	586 [label="О! Це ж ти, правда? Тенно узурпували Материнську систему орокінів. А тебе, як зозуленя в гніздо, підкинули у цей світ зі свого власного.",shape=box,color=blue];
		586 -> 589;
	588 [label="Але є багато чого, що ти про нього не знаєш. Про цього кретина вже занадто багато сказано. І, боюся, ще багато чого потрібно сказати.",shape=box,color=blue];
		588 -> 590;
		588 -> 591;
	589 [label="І це робить тебе узурпатором принаймні за двома пунктами з мого списку. І, можливо, за трьома, якщо враховувати те, що дворецький розповів мені про Дувірі, але це тема для окремої розмови.",shape=box,color=blue];
		589 -> 592;
	590 [label="Наприклад?",shape=box,color=red];
		590 -> 593;
	591 [label="Мені не цікаво чути про життя Балласа.",shape=box,color=red];
		591 -> 594;
	592 [label="Не відвертай мою увагу, узурпаторе. Я розумію, що, можливо, тобі важко повірити мені, але якби ти побачив озера багряного кольору та поля, засіяні покрученими та розірваними трупами, наче викинутими дитячими іграшками…",shape=box,color=blue];
		592 -> 595;
	593 [label="Update boolean RoatheBallas1",color=orange];
		593 -> 596;
	594 [label="М-м, так. Ну, тоді, мабуть, тобі доведеться вислухати історії з мого життя. Як кумедно.",shape=box,color=blue];
		594 -> 597;
	595 [label="Update boolean RoatheUsurper",color=orange];
		595 -> 579;
	596 [label="Це… дуже довга історія. На яку в мене зараз немає часу. Дворецький нависає наді мною. А я не ненавиджу, коли хтось нависає наді мною.",shape=box,color=blue];
		596 -> 598;
	597 [label="+5 Chemistry",color=orange];
		597 -> 599;
	598 [label="Жахлива неповага.",shape=box,color=blue];
		598 -> 600;
	599 [label="Скоро ми знову поговоримо.",shape=box,color=blue];
		599 -> 601;
	600 [label="+15 Chemistry",color=orange];
		600 -> 602;
	601 [label="Chat ends.",color=orange];
	602 [label="Скоро ми знову поговоримо.",shape=box,color=blue];
