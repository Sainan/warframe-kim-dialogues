		j1049037925 -> j1449468089;
	j163482645 [label="Ні, чому б я мав брехати? Я чув, що Ліон цінує той дивний шоколад, що був у його часи. Я чув, що шоколад заспокоює його видіння.",shape=box,color=blue];
