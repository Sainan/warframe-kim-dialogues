		j3869625108 -> j3772963601 [label="RoatheLyonDatingDeal",color=purple];
		j3869625108 -> j4199943865 [label="RoatheSerumDeal",color=purple];
		j3869625108 -> j4199943865 [label="RoatheFamilyDeal",color=purple];
		j3869625108 -> j3772963601 [label="RoatheMarieEntratiDeal",color=purple];
		j3869625108 -> j3772963601 [label="RoatheLyonConfessionDeal",color=purple];
		j3869625108 -> j189144278 [label="RoatheDatingDealNo",color=purple];
		j3869625108 -> j12757400 [label="RoatheMarieDatingDealNo",color=purple];
		j3869625108 -> j480466134 [label="RoatheLyonDatingDealNo",color=purple];
		j3869625108 -> j2597163399 [label="RoatheSerumDealNo",color=purple];
		j3869625108 -> j3896720415 [label="RoatheFamilyDealNo",color=purple];
		j3869625108 -> j1985717161 [label="RoatheMarieEntratiDealNo",color=purple];
		j3869625108 -> j1562006623 [label="RoatheLyonConfessionDealNo",color=purple];
		j3869625108 -> j3101662826 [label="false",color=purple];
	j216863090 [label="Evaluate expressions",color=orange];
		j216863090 -> j2694130358 [label="RoatheKnowsReset",color=purple];
		j216863090 -> j2694130358 [label="RoatheDeal",color=purple];
		j216863090 -> j2694130358 [label="RoatheNoDeal",color=purple];
		j216863090 -> j2694130358 [label="false",color=purple];
	j4199943865 [label="Мені здається надзвичайно цікавим той факт, що ми вступили в змову, щоби… влаштувати моє власне майбутнє.",shape=box,color=blue];
		j4199943865 -> j290305058;
	j3772963601 [label="Як просуваються справи, мій узурпаторе? Я активно тягну за ниточки та важелі на твою користь, хоча мій вплив поки що може бути непомітним і невідчутним.",shape=box,color=blue];
		j3772963601 -> j290305058;
	j189144278 [label="Скажи мені, що твоя думка змінилася щодо моєї пропозиції. Там, де я міг раніше стати перешкодою щодо твоїх… романтичних цілей? Тепер я буду покірний наче сніжний терріск. Гм. Хіба що це не те, що ти бажаєш. Ти можеш вирішити це самостійно.",shape=box,color=blue];
		j189144278 -> j1202901052;
	j12757400 [label="Скажи мені, що твоя думка змінилася щодо моєї пропозиції. Я можу розв’язати твою проблему з Марі. Переконайся, що ти з легкістю досягнеш своїх романтичних цілей з нею.",shape=box,color=blue];
		j12757400 -> j1202901052;
	j480466134 [label="Скажи мені, що твоя думка змінилася щодо моєї пропозиції. Я можу розв’язати твою проблему з Ліоном. Переконайся, що ти з легкістю досягнеш своїх романтичних цілей з ним.",shape=box,color=blue];
		j480466134 -> j1202901052;
	j2597163399 [label="Скажи мені, що твоя думка змінилася щодо моєї пропозиції. Там, де я міг раніше стати перешкодою щодо мого… прийому сироватки? Тепер я буду покірний наче сніжний терріск.",shape=box,color=blue];
		j2597163399 -> j1202901052;
	j3896720415 [label="Скажи мені, що твоя думка змінилася щодо моєї пропозиції. Там, де я міг раніше стати перешкодою щодо возз’єднання дворецького з родиною? Тепер я буду покірний, наче сніжний терріск.",shape=box,color=blue];
		j3896720415 -> j1202901052;
	j1985717161 [label="Скажи мені, що твоя думка змінилася щодо моєї пропозиції. Я можу розв’язати твою проблему з Марі. Переконайся, що ти з легкістю будеш вести розмови з нею.",shape=box,color=blue];
		j1985717161 -> j1202901052;
	j1562006623 [label="Скажи мені, що твоя думка змінилася щодо моєї пропозиції. Я можу розв’язати твою проблему з Ліоном. Переконайся, що ти з легкістю будеш вести розмови з ним.",shape=box,color=blue];
		j1562006623 -> j1202901052;
	j3101662826 [label="Не можу позбутися думки, що ти не просто так засиджуєшся в цих розмовах, узурпаторе. І що, можливо, я зможу тобі в цьому допомогти.",shape=box,color=blue];
		j3101662826 -> j3331263022;
	j2694130358 [label="Evaluate expressions on HellStory counter",color=orange];
		j2694130358 -> j3869625108 [label="x >= 21",color=purple];
		j2694130358 -> j2075111951 [label="x < 21",color=purple];
		j2694130358 -> j2075111951 [label="false",color=purple];
	j290305058 [label="З моєї точки зору, це дивне випробування – діяти, маючи лише частину своїх спогадів, і знати, що інша половина колоди знаходиться у твоїх руках.",shape=box,color=blue];
		j290305058 -> j1806835387;
	j1202901052 [label="Але вся ця… метушня, яку ти робиш? Це просто марнування часу. Тож уперед. Скажи це. І твоя проблема буде розв’язана.",shape=box,color=blue];
		j1202901052 -> j1757463374;
		j1202901052 -> j3359756142;
	j3331263022 [label="Скажи мені, чого ти хочеш, і ми домовимося. Уся ця… метушня — лише марна трата часу.",shape=box,color=blue];
		j3331263022 -> j2953660143;
	j2075111951 [label="Evaluate expressions",color=orange];
		j2075111951 -> j1744944581 [label="RoatheDeal",color=purple];
		j2075111951 -> j3857820254 [label="RoatheNoDeal",color=purple];
		j2075111951 -> j3857820254 [label="false",color=purple];
	j1806835387 [label="Тож я просто продовжуватиму, оскільки не можу вдіяти нічого кращого. «До речі, як там справи з нашою маленькою підлабузницею? Я так розумію, священник і досі не розмовляє з тобою». Пхе. Що за цирк.",shape=box,color=blue];
		j1806835387 -> j3375237841;
		j1806835387 -> j1118736887;
		j1806835387 -> j2828910622;
	j1757463374 [label="Ні. Вибач. Я не домовляюся з орокінами. Ні тоді, ні зараз, ніколи.",shape=box,color=red];
		j1757463374 -> j3201821869;
	j3359756142 [label="Я дуже сподіваюся, що ти не змусиш мене про це пошкодувати, Роуте. Добре. Згода. Мені потрібна твоя допомога.",shape=box,color=red];
		j3359756142 -> j1876832257;
	j2953660143 [label="Check boolean LoidFamilyComplete",color=orange];
		j2953660143 -> j2073797303 [label=true,color=green];
		j2953660143 -> j2247366097 [label=true,color=green];
		j2953660143 -> j3601132328 [label=true,color=green];
		j2953660143 -> j253769410 [label=true,color=green];
		j2953660143 -> j2073797303 [label=false,color=brown];
		j2953660143 -> j2247366097 [label=false,color=brown];
		j2953660143 -> j3601132328 [label=false,color=brown];
		j2953660143 -> j253769410 [label=false,color=brown];
		j2953660143 -> j2238128451 [label=false,color=brown];
	j1744944581 [label="Як просувається твоя робота з нашою маленькою підлабузницею? Я так розумію, священник і досі не розмовляє з тобою.",shape=box,color=blue];
		j1744944581 -> j884205076;
		j1744944581 -> j188632519;
		j1744944581 -> j1179030647;
	j3857820254 [label="Скажи мені, твоя думка змінилася щодо моєї пропозиції? Це твоя остання нагода, узурпаторе. Я терплячий, але мені не подобається стояти та тримати двері відчиненими, наче дурень.",shape=box,color=blue];
		j3857820254 -> j886416145;
		j3857820254 -> j1520393314;
	j3375237841 [label="Поки що я добре ладнаю з Марі.",shape=box,color=red];
		j3375237841 -> j3704816867;
	j1118736887 [label="Ні, але він передумає.",shape=box,color=red];
		j1118736887 -> j298851632;
	j2828910622 [label="Здається, вони не дуже тобі подобаються. Чому?",shape=box,color=red];
		j2828910622 -> j543099885;
	j3201821869 [label="Як забажаєш. Але май на увазі, це була твоя остання нагода. Тепер усе самотужки.",shape=box,color=blue];
		j3201821869 -> j3981520164;
	j1876832257 [label="Evaluate expressions",color=orange];
		j1876832257 -> j975536357 [label="RoatheDatingDealNo",color=purple];
		j1876832257 -> j1308781067 [label="RoatheMarieDatingDealNo",color=purple];
		j1876832257 -> j345395819 [label="RoatheLyonDatingDealNo",color=purple];
		j1876832257 -> j2695987169 [label="RoatheSerumDealNo",color=purple];
		j1876832257 -> j955899784 [label="RoatheFamilyDealNo",color=purple];
		j1876832257 -> j417271321 [label="RoatheMarieEntratiDealNo",color=purple];
		j1876832257 -> j1434570743 [label="RoatheLyonConfessionDealNo",color=purple];
		j1876832257 -> j1114844156 [label="false",color=purple];
	j2073797303 [label="У Ліона… стільки проблем. І я не знаю, як з цим усім упоратися.",shape=box,color=red];
		j2073797303 -> j509736846;
	j2247366097 [label="Марі не бачить Ентраті таким, яким він є насправді. І я ніяк не можу змусити її побачити правду.",shape=box,color=red];
		j2247366097 -> j4002460732;
	j3601132328 [label="Ну, розумієш, у тебе є всі… спогади, чому ти прийняв сироватку, але… від мене ти почув багато неправильного в неправильний час.",shape=box,color=red];
		j3601132328 -> j4239904519;
	j253769410 [label="Можливо, це трохи ніяково, але… я маю почуття до одного з вас.",shape=box,color=red];
		j253769410 -> j1759683522;
		j253769410 -> j508589113;
		j253769410 -> j1709501097;
	j2238128451 [label="Я намагаюся переконати тебе та інших допомогти мені возз’єднати Лойда з родиною на горі, але… мені… не вдалося…",shape=box,color=red];
		j2238128451 -> j2212451563;
	j884205076 [label="Ні, Ліон… здається, не дуже балакучий.",shape=box,color=red];
		j884205076 -> j3642829500;
	j188632519 [label="Я добре ладнаю з Марі. Чому ти називаєш її підлабузницею?",shape=box,color=red];
		j188632519 -> j551308679;
	j1179030647 [label="Здається, вони не дуже тобі подобаються. Чому?",shape=box,color=red];
		j1179030647 -> j2231716763;
	j886416145 [label="Ні. Вибач. Я не домовляюся з орокінами. Ні тоді, ні зараз, ніколи.",shape=box,color=red];
		j886416145 -> j739386097;
	j1520393314 [label="Я дуже сподіваюся, що ти не змусиш мене про це пошкодувати, Роуте. Добре. Згода.",shape=box,color=red];
		j1520393314 -> j2644788065;
	j3704816867 [label="«Поки що». Цікаво. І ми знову повертаємося на початок, наче придворні, що повторюють рухи танцю? Знов і знов, приречені повторюватися?",shape=box,color=blue];
		j3704816867 -> j4038186980;
		j3704816867 -> j926943233;
	j298851632 [label="Гадаю, ти знаєш, чи не так? Цікаво, що це настільки передбачувано. Приємно знати, що навіть така зламана людина як він, може бути надійною час від часу.",shape=box,color=blue];
		j298851632 -> j960125410;
	j543099885 [label="Хіба ти ще не знаєш? М-м. Можливо, ми не зайшли так далеко. Або тобі не спало на думку запитати про це в перший чи двадцятитисячний раз цієї маленької витівки.",shape=box,color=blue];
		j543099885 -> j960125410;
	j3981520164 [label="Ох. І ще одне, поки я не забув.",shape=box,color=blue];
		j3981520164 -> j1511560053;
	j975536357 [label="Ти справді продаєш свою душу дияволу, та ще й двічі… домовившись, щоб я взяв тебе до свого ліжка? Або ти прагнеш отримати моє серце, узурпаторе? Гм. Побачимо, Але згодом.",shape=box,color=blue];
		j975536357 -> j1821846825;
	j1308781067 [label="Коли настане час, я подбаю про те, щоб в тебе була змога завоювати нашу маленьку підлабузницю, узурпаторе. Вважай, що це питання вирішене.",shape=box,color=blue];
		j1308781067 -> j1821846825;
	j345395819 [label="Коли настане час, я подбаю про те, щоб в тебе була змога завоювати бідного розбитого священника, узурпаторе. Вважай, що це питання вирішене.",shape=box,color=blue];
		j345395819 -> j3219487541;
	j2695987169 [label="Коли настане час, я пам’ятатиму про це. Якщо у нас знову виникнуть розбіжності щодо моїх спогадів, ми не повторюватимемо ваших попередніх помилок.",shape=box,color=blue];
		j2695987169 -> j1558630630;
	j955899784 [label="Коли настане час, я подбаю про те, щоб наш маленький дворецький піднявся тими сходами. Вважай, що це питання вирішене.",shape=box,color=blue];
		j955899784 -> j1821846825;
	j417271321 [label="Вважай, що твоя проблема з Марі та її підлабузницьким обожнюванням Ентраті вирішена. Коли настане час, я розберуся з цим.",shape=box,color=blue];
		j417271321 -> j3234543111;
	j1434570743 [label="Вважай, що твоя проблема з Ліоном і його жахіттями вирішена, узурпаторе. Коли настане час, я розберуся з цим.",shape=box,color=blue];
		j1434570743 -> j1581253314;
	j1114844156 [label="Я… здається забув, що було твоєю метою. Усе завдяки твоєму втручанню у мої спогади. Тож, що це було?",shape=box,color=blue];
		j1114844156 -> j2953660143;
	j509736846 [label="Я би порадив просто набратися терпіння, але… не мені радити тобі використовувати долото, коли поруч лежить лазерний різак.",shape=box,color=blue];
		j509736846 -> j2415483058;
	j4002460732 [label="Гм. Зрозуміло. Шляхетна справа, якщо чесно. Я сам намагався зробити це багато разів. І так само невдало.",shape=box,color=blue];
		j4002460732 -> j1506063124;
	j4239904519 [label="Гм.",shape=box,color=blue];
		j4239904519 -> j4161998111;
	j1759683522 [label="До Ліона.",shape=box,color=red];
		j1759683522 -> j3261561885;
	j508589113 [label="До тебе.",shape=box,color=red];
		j508589113 -> j3380914524;
	j1709501097 [label="До Марі.",shape=box,color=red];
		j1709501097 -> j3719495682;
	j2212451563 [label="Гм. Зрозуміло. У нас була домовленість, але через твоє недотримання своєї частини угоди, твоя винагорода зникла.",shape=box,color=blue];
		j2212451563 -> j3544326759;
	j3642829500 [label="Коли він говорить, його промови можна поділити на дві категорії — жахливо безглузді або жахливо божевільні.",shape=box,color=blue];
		j3642829500 -> j3270647348;
	j551308679 [label="Гм? Тобі вдалося уникнути цього? Я тобі страшенно заздрю. Але незабаром ти опинишся у радіусі вибуху, тому краще заздалегідь попередити тебе.",shape=box,color=blue];
		j551308679 -> j1048126244;
	j2231716763 [label="Мій бідний мандрівниче. Невже ти не пам’ятаєш як ми, орокіни, відкидали будь-яке поняття священних божеств? Єдине, що ми шанували, це самих себе.",shape=box,color=blue];
		j2231716763 -> j1180822949;
	j739386097 [label="Як забажаєш. Я попереджаю тебе, твоє рішення не залишиться без наслідків.",shape=box,color=blue];
		j739386097 -> j2232321834;
	j2644788065 [label="Ти поводитимешся добре та допоможеш мені переконати Лойда піднятися нагору та помиритися із родиною? А я допоможу тобі розібратися зі своїми спогадами.",shape=box,color=red];
		j2644788065 -> j1668327959;
	j4038186980 [label="Це не означає, що тобі бракує ініціативи. Це просто означає, що деякі речі вимагають кількох додаткових спроб.",shape=box,color=red];
		j4038186980 -> j161812768;
	j926943233 [label="Сподіваюся, це тебе не засмутить.",shape=box,color=red];
		j926943233 -> j4110076726;
	j960125410 [label="Чи справді ми приречені повертатися на початок, наче придворні, що повторюють рухи танцю?",shape=box,color=blue];
		j960125410 -> j4038186980;
		j960125410 -> j926943233;
	j1511560053 [label="Не так давно я довірив тобі жахливу правду. Тепер я не можу пригадати чому.",shape=box,color=blue];
		j1511560053 -> j3478249380;
	j1821846825 [label="Boolean RoatheFamilyDealNo is now false.",color=orange];
		j1821846825 -> j1752565636;
	j3219487541 [label="Boolean RoatheLyonDatingDealNo is now false.",color=orange];
		j3219487541 -> j3659686369;
	j1558630630 [label="Boolean RoatheSerumDealNo is now false.",color=orange];
		j1558630630 -> j3401329298;
	j3234543111 [label="Boolean RoatheMarieEntratiDealNo is now false.",color=orange];
		j3234543111 -> j1447867262;
	j1581253314 [label="Boolean RoatheLyonConfessionDealNo is now false.",color=orange];
		j1581253314 -> j4150856322;
	j2415483058 [label="Здається, я починаю розуміти, чому наша пам’ять була стерта. Побачивши всі свої невдалі спроби та зусилля… чому б не спробувати все спочатку?",shape=box,color=blue];
		j2415483058 -> j1646064069;
	j1506063124 [label="Побачивши з розчаруванням, що ти більше не можеш переконати її в простій істині речей, ти вдаєшся до того, що було — використовуючи цей… свій дар.",shape=box,color=blue];
		j1506063124 -> j1838480296;
	j4161998111 [label="Мені не подобається, що ти забруднюєш мій розум, щоб виправити свої помилки, мандрівниче. Однак те, що ти намагаєшся це зробити заради мене… мабуть, якось прийнятно.",shape=box,color=blue];
