	j197730880 [label="Ха! Я складу тобі список! Він вичерпний, але водночас неконкретний, постійно переходить від незбагненного зла до незбагненної деградації!",shape=box,color=blue];
		j197730880 -> j3142907957;
	j3503663215 [label="Boolean RoatheKnowsReset2 is now true.",color=orange];
		j3503663215 -> j1511560053;
	j413417021 [label="Ти занадто розлючений. Зараз ти переконаний, що вчинив як боягуз, але не пам’ятаєш нічого з того, що призвело до цього моменту.",shape=box,color=red];
		j413417021 -> j1483800080;
	j1009987582 [label="Колись ти довіряв мені свої історії, але не зараз. Тож розмови, які нам потрібно провести? Неможливі.",shape=box,color=red];
		j1009987582 -> j1738318848;
	j2011715312 [label="+10 Chemistry",color=orange];
		j2011715312 -> j3821877375;
	j51340783 [label="Перестань мені брехати.",shape=box,color=red];
		j51340783 -> j2710414198;
	j439951259 [label="Ти впевнений, що не хочеш отримати від мене трохи випічки? Я знаю, що тобі вона подобається.",shape=box,color=red];
		j439951259 -> j4124353714;
	j3221634979 [label="Це може бути складно. Чи в Ліона є інші прохання до мене, які я можу виконати?",shape=box,color=red];
		j3221634979 -> j1146116235;
	j1229764098 [label="Ти не знаєш як це, коли ці фанатики цілодобово нависають над тобою, кричать і повчають тебе, змушуючи покаятися.",shape=box,color=blue];
		j1229764098 -> j3428076010;
		j1229764098 -> j3349005879;
		j1229764098 -> j406118195;
		j1229764098 -> j2242998543;
	j1537117140 [label="Я знаю, що ми на межі, я відчуваю, як мій розум бореться проти мене. Ти робиш усе можливе, щоби допомогти мені відновити мої спогади. І за це я тобі вдячний. ",shape=box,color=blue];
		j1537117140 -> j1274299090;
	j247544041 [label="Ми тільки почати розкривати найменші шматочки того, що було приховано від мене. Я не знаю, що Альбрехт розповів їм про мої злочини, мандрівниче. ",shape=box,color=blue];
		j247544041 -> j960952982;
	j1648441712 [label="Ми тільки почати розкривати, що було приховано від мене. Я не знаю, що Альбрехт розповів їм про мої злочини, мандрівниче.",shape=box,color=blue];
		j1648441712 -> j960952982;
	j3005537947 [label="Я не знаю, що Альбрехт розповів їм про мої злочини, бо вони приховані навіть від мене. Правда прихована в моїх спогадах, мандрівниче.",shape=box,color=blue];
		j3005537947 -> j960952982;
	j1483800080 [label="Під поверхнею я знаю, що ти — бурхливе пекло. І я знаю, що нам потрібно дійти до певного моменту, перш ніж ми зможемо це обговорити.",shape=box,color=red];
		j1483800080 -> j3971943305;
	j1738318848 [label="І чому ти маєш довіряти мені? Все, що ти про мене знаєш, це… моє втручання у твою пам’ять.",shape=box,color=red];
		j1738318848 -> j2839491217;
	j2710414198 [label="Ну, якщо ти будеш нудити мене, мандрівниче, то навіщо мені витрачати час на тебе? У мене вже є фанатики, і, схоже, я зобов’язаний проводити з ними час.",shape=box,color=blue];
		j2710414198 -> j3866645924;
	j4124353714 [label="А, то вона тобі розповіла. Звичайно, що так. Ну, це ж не моя провина! Ці кляті ласощі були єдиним благом у цій пекельній дірі.",shape=box,color=blue];
		j4124353714 -> j43764987;
		j4124353714 -> j1658344142;
	j1146116235 [label="+5 Chemistry",color=orange];
		j1146116235 -> j676702149;
	j1274299090 [label="Мені потрібно знати, що було забрано у мене, мандрівниче. Я повинен знати, що Альбрехт вкрав у мене, коли примусово дав мені цю сироватку.",shape=box,color=blue];
		j1274299090 -> j2905689168;
		j1274299090 -> j3229709283;
	j960952982 [label="Я повинен знати, що Альбрехт вкрав у мене, коли примусово дав мені цю сироватку. Мені потрібно знати, що приховано в моїй голові, мандрівниче. Звичайно, якщо це не завдасть тобі клопоту…",shape=box,color=blue];
		j960952982 -> j392431781;
		j960952982 -> j357494204;
	j3971943305 [label="І чому я маю бути розлюченим, мандрівниче?",shape=box,color=blue];
		j3971943305 -> j1893629881;
		j3971943305 -> j236319040;
		j3971943305 -> j1671157193;
	j2839491217 [label="«Втручання у мою пам’ять». Ніби я якась Аятана-скульптура, з якою бавляться жартома. Це не просто втручання у мою пам’ять. Вона повністю стерта завдяки тобі.",shape=box,color=blue];
		j2839491217 -> j3828122535;
		j2839491217 -> j566753634;
	j43764987 [label="То це правда. Ти прокрадався до Ґоллі, щоб красти шоколад? Виглядаючи як…?",shape=box,color=red];
		j43764987 -> j947950633;
	j1658344142 [label="Як саме ти це зробив?",shape=box,color=red];
		j1658344142 -> j542401330;
	j676702149 [label="Ха! Гарна спроба. Вибуховий шоколад був єдиним благом у цій пекельній дірі.",shape=box,color=blue];
		j676702149 -> j2944097172;
	j2905689168 [label="Обіцяю.",shape=box,color=red];
		j2905689168 -> j591334319;
	j3229709283 [label="Ми це зробимо. Але це займе час.",shape=box,color=red];
		j3229709283 -> j1237646510;
	j392431781 [label="Я це зроблю.",shape=box,color=red];
		j392431781 -> j4082525020;
	j357494204 [label="Я намагаюся. Але ти не полегшуєш мені завдання.",shape=box,color=red];
		j357494204 -> j3844168735;
	j1893629881 [label="Ти стверджував, що не злишся на мене за те, що твої спогади стерті, але я знаю, що ти брешеш. Тому що… це не перший раз, коли я це роблю.",shape=box,color=red];
		j1893629881 -> j762701075;
	j236319040 [label="Тому що ти ненавидиш себе за те, що добровільно прийняв цю сироватку. Ти ненавидиш себе, і це тебе розлючує, бо ти — це все, що у тебе залишилося.",shape=box,color=red];
		j236319040 -> j2870567659;
	j1671157193 [label="Ти стверджував, що не злишся на мене за те, що твої спогади стерті, але я не можу уявити, як це може не розлютити.",shape=box,color=red];
		j1671157193 -> j2870567659;
	j3828122535 [label="Ти не втратив нічого цінного, лише наші розмови.",shape=box,color=red];
		j3828122535 -> j357189166;
	j566753634 [label="Не все — лише наші розмови. У тебе залишилося все інше, навіть те, що ми відновили у «Спуску».",shape=box,color=red];
		j566753634 -> j357189166;
	j947950633 [label="Так, із блакитною шкірою, хвостом і зараженою плоттю. Але ти здивуєшся, що може зробити плащ, капелюх і маска.",shape=box,color=blue];
		j947950633 -> j2699629722;
	j542401330 [label="Це було досить просто. Крім того, як «протофрейм» і елітний орокінський воїн, я здатний викрасти кілька тістечок із ринку, не викликавши підозри у влади.",shape=box,color=blue];
		j542401330 -> j2195136603;
	j2944097172 [label="Перш ніж ти запитаєш, цю історію краще почути від Марі, щоб фанатики знову не почали на мене кричати та сваритися.",shape=box,color=blue];
		j2944097172 -> j1433582819;
	j591334319 [label="Обіцянка дияволу… небезпечна річ.",shape=box,color=blue];
		j591334319 -> j3866645924;
	j1237646510 [label="А я терплячий диявол.",shape=box,color=blue];
		j1237646510 -> j3866645924;
	j4082525020 [label="Подивися, що зможеш.",shape=box,color=blue];
		j4082525020 -> j3866645924;
	j3844168735 [label="Звичайно, ні! А де ж тоді будуть веселощі?",shape=box,color=blue];
		j3844168735 -> j3866645924;
	j762701075 [label="Як дивовижно чудово! І я навіть не дивуюся! І що мені взагалі до того, правда це чи ні?! Окрім того…",shape=box,color=blue];
		j762701075 -> j2870567659;
	j2870567659 [label="Неправда! Захоплива, прекрасна, блаженна неправда! Не розмовляй зі мною так, ніби ти знаєш всі тонкощі гніву, який, як на мене, ти навіть не можеш почати розуміти.",shape=box,color=blue];
		j2870567659 -> j1661487874;
	j357189166 [label="Не смій говорити мені, що є цінним у моїх думках, а що ні, мандрівниче. Це не твоє, щоби претендувати на право власності.",shape=box,color=blue];
		j357189166 -> j1661487874;
	j2699629722 [label="Люди легко ігнорують тих, кого не хочуть бачити. Крім того, як «протофрейм» і бойовий елітний воїн орокін, я вважаю, що здатний викрасти кілька тістечок з ринку, не викликавши підозри у влади.",shape=box,color=blue];
		j2699629722 -> j4202875018;
	j2195136603 [label="Так, із блакитною шкірою, хвостом і зараженою плоттю. Але ти здивуєшся, що може зробити плащ, капелюх і маска.",shape=box,color=blue];
		j2195136603 -> j4202875018;
	j1433582819 [label="Вони кричать і лають мене за гріхи й за те, що я недостатньо каюся, не додаючи, що я «знову брешу про свою версію подій» на додачу.",shape=box,color=blue];
		j1433582819 -> j3428076010;
		j1433582819 -> j3349005879;
		j1433582819 -> j406118195;
		j1433582819 -> j2242998543;
	j4202875018 [label="Boolean RoatheMariePastry1 is now true.",color=orange];
		j4202875018 -> j313519828;
		j4202875018 -> j602140882;
	j313519828 [label="Але ти приніс достатньо для Марі та Ліона?",shape=box,color=red];
		j313519828 -> j4243091231;
	j602140882 [label="То ти просто крав випічку.",shape=box,color=red];
		j602140882 -> j892368160;
	j4243091231 [label="А. То були очікування, що я візьму лише для себе, а їх залишу без нічого? Просто тому, що мені не подобається їхня компанія і я хочу позбутися їх?",shape=box,color=blue];
		j4243091231 -> j4010278463;
	j892368160 [label="Усе на цій планеті незабаром належатиме орокінській імперії. У будь-якому разі, вона була моєю по праву.",shape=box,color=blue];
		j892368160 -> j3975035866;
	j4010278463 [label="Ти думаєш, що моя неприязнь до них якось зобов’язує мене бути жорстоким до них. Тому що я диявол, а отже, схильний до таких вчинків, тому такий висновок.",shape=box,color=blue];
		j4010278463 -> j130154315;
	j3975035866 [label="Крім того, у мене не було грошей. Що, по-твоєму, я мав робити?",shape=box,color=blue];
		j3975035866 -> j3475230141;
	j130154315 [label="Як же це розчаровує. Такі поверхневі вчинки притаманні лише надзвичайно нудним людям і шкільним хуліганам. ",shape=box,color=blue];
		j130154315 -> j2971137312;
	j3475230141 [label="І я знаю, що ти вдираєшся в кораблі та забираєш усе, що потрібно або хочеться. Тож не треба дивитися на мене своїми невинними очима, узурпаторе.",shape=box,color=blue];
		j3475230141 -> j2230110239;
		j3475230141 -> j3231995603;
	j2971137312 [label="Я їх ненавиджу. Проте я мушу з ними співіснувати. Я не хочу позбавляти їх дурної випічки. Це ж просто випічка. Навіщо ускладнювати ситуацію?",shape=box,color=blue];
		j2971137312 -> j3944437190;
		j2971137312 -> j377376535;
		j2971137312 -> j3514201111;
	j2230110239 [label="Не зважай. ",shape=box,color=red];
		j2230110239 -> j2775469780;
	j3231995603 [label="Справедливе зауваження, мабуть.",shape=box,color=red];
		j3231995603 -> j2424606044;
	j3944437190 [label="Або ти можеш спробувати бути добрим до них просто так.",shape=box,color=red];
		j3944437190 -> j3470577750;
	j377376535 [label="Отже, щоб було зрозуміло — ти був милим, бо ти їх ненавидиш.",shape=box,color=red];
		j377376535 -> j3219832374;
	j3514201111 [label="Ніколи не доводилося думати про це з такої перспективи.",shape=box,color=red];
		j3514201111 -> j4215945699;
	j2775469780 [label="Фантастично. Ще одна персона, не здатна поступитися. Ніби фанатиків було недостатньо, які цілодобово кричали на мене, благаючи покаятися.",shape=box,color=blue];
		j2775469780 -> j3428076010;
		j2775469780 -> j3349005879;
		j2775469780 -> j406118195;
		j2775469780 -> j2242998543;
	j2424606044 [label="+5 Chemistry",color=orange];
		j2424606044 -> j3311925755;
	j3470577750 [label="Ага, спробуй витримати, коли вони цілодобово дзижчать над тобою, проклинаючи твоє ім’я та благаючи покаятися.",shape=box,color=blue];
		j3470577750 -> j3428076010;
		j3470577750 -> j3349005879;
		j3470577750 -> j406118195;
		j3470577750 -> j2242998543;
	j3219832374 [label="Саме так. Що тут важко зрозуміти? І я бачу твій сарказм, узурпаторе. Але не хвилюйся, це мене розважає.",shape=box,color=blue];
		j3219832374 -> j113210180;
	j4215945699 [label="+5 Chemistry",color=orange];
		j4215945699 -> j1473012528;
	j3311925755 [label="Дякую. Нарешті хоч хтось, хто може поступитися. Якби ще ці два фанатики могли зробити те саме, а не постійно кричати на мене та благати покаятися.",shape=box,color=blue];
		j3311925755 -> j3428076010;
		j3311925755 -> j3349005879;
		j3311925755 -> j406118195;
		j3311925755 -> j2242998543;
	j113210180 [label="Це принаймні краще, ніж протухлі нескінченні проповіді фанатиків, які постійно проклинають мене та благають покаятися.",shape=box,color=blue];
		j113210180 -> j3428076010;
		j113210180 -> j3349005879;
		j113210180 -> j406118195;
		j113210180 -> j2242998543;
	j1473012528 [label="Будь ласка. Яке полегшення, що є ще хтось, хто може змінити свою думку. Якби ще ці два фанатики могли зробити те саме, а не постійно кричати на мене та благати покаятися.",shape=box,color=blue];
		j1473012528 -> j3428076010;
		j1473012528 -> j3349005879;
		j1473012528 -> j406118195;
		j1473012528 -> j2242998543;
}