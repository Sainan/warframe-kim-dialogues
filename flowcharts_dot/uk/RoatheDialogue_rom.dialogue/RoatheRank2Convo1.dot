		606 -> 616 [label="RoatheLyonConfessionDealNo",color=purple];
		606 -> 617 [label="false",color=purple];
	607 [label="Evaluate expressions",color=orange];
		607 -> 618 [label="RoatheKnowsReset",color=purple];
		607 -> 618 [label="RoatheDeal",color=purple];
		607 -> 618 [label="RoatheNoDeal",color=purple];
		607 -> 618 [label="false",color=purple];
	609 [label="Мені здається надзвичайно цікавим той факт, що ми вступили в змову, щоби… влаштувати моє власне майбутнє.",shape=box,color=blue];
		609 -> 619;
	608 [label="Як просуваються справи, мій узурпаторе? Я активно тягну за ниточки та важелі на твою користь, хоча мій вплив поки що може бути непомітним і невідчутним.",shape=box,color=blue];
		608 -> 619;
	610 [label="Скажи мені, що твоя думка змінилася щодо моєї пропозиції. Там, де я міг раніше стати перешкодою щодо твоїх… романтичних цілей? Тепер я буду покірний наче сніжний терріск. Гм. Хіба що це не те, що ти бажаєш. Ти можеш вирішити це самостійно.",shape=box,color=blue];
		610 -> 620;
	611 [label="Скажи мені, що твоя думка змінилася щодо моєї пропозиції. Я можу розв’язати твою проблему з Марі. Переконайся, що ти з легкістю досягнеш своїх романтичних цілей з нею.",shape=box,color=blue];
		611 -> 620;
	612 [label="Скажи мені, що твоя думка змінилася щодо моєї пропозиції. Я можу розв’язати твою проблему з Ліоном. Переконайся, що ти з легкістю досягнеш своїх романтичних цілей з ним.",shape=box,color=blue];
		612 -> 620;
	613 [label="Скажи мені, що твоя думка змінилася щодо моєї пропозиції. Там, де я міг раніше стати перешкодою щодо мого… прийому сироватки? Тепер я буду покірний наче сніжний терріск.",shape=box,color=blue];
		613 -> 620;
	614 [label="Скажи мені, що твоя думка змінилася щодо моєї пропозиції. Там, де я міг раніше стати перешкодою щодо возз’єднання дворецького з родиною? Тепер я буду покірний, наче сніжний терріск.",shape=box,color=blue];
		614 -> 620;
	615 [label="Скажи мені, що твоя думка змінилася щодо моєї пропозиції. Я можу розв’язати твою проблему з Марі. Переконайся, що ти з легкістю будеш вести розмови з нею.",shape=box,color=blue];
		615 -> 620;
	616 [label="Скажи мені, що твоя думка змінилася щодо моєї пропозиції. Я можу розв’язати твою проблему з Ліоном. Переконайся, що ти з легкістю будеш вести розмови з ним.",shape=box,color=blue];
		616 -> 620;
	617 [label="Не можу позбутися думки, що ти не просто так засиджуєшся в цих розмовах, узурпаторе. І що, можливо, я зможу тобі в цьому допомогти.",shape=box,color=blue];
		617 -> 621;
	618 [label="Evaluate expressions on HellStory",color=orange];
		618 -> 606 [label="x >= 21",color=purple];
		618 -> 622 [label="x < 21",color=purple];
		618 -> 622 [label="false",color=purple];
	619 [label="З моєї точки зору, це дивне випробування – діяти, маючи лише частину своїх спогадів, і знати, що інша половина колоди знаходиться у твоїх руках.",shape=box,color=blue];
		619 -> 623;
	620 [label="Але вся ця… метушня, яку ти робиш? Це просто марнування часу. Тож уперед. Скажи це. І твоя проблема буде розв’язана.",shape=box,color=blue];
		620 -> 624;
		620 -> 625;
	621 [label="Скажи мені, чого ти хочеш, і ми домовимося. Уся ця… метушня — лише марна трата часу.",shape=box,color=blue];
		621 -> 626;
	622 [label="Evaluate expressions",color=orange];
		622 -> 628 [label="RoatheDeal",color=purple];
		622 -> 627 [label="RoatheNoDeal",color=purple];
		622 -> 627 [label="false",color=purple];
	623 [label="Тож я просто продовжуватиму, оскільки не можу вдіяти нічого кращого. «До речі, як там справи з нашою маленькою підлабузницею? Я так розумію, священник і досі не розмовляє з тобою». Пхе. Що за цирк.",shape=box,color=blue];
		623 -> 629;
		623 -> 630;
		623 -> 631;
	624 [label="Ні. Вибач. Я не домовляюся з орокінами. Ні тоді, ні зараз, ніколи.",shape=box,color=red];
		624 -> 632;
	625 [label="Я дуже сподіваюся, що ти не змусиш мене про це пошкодувати, Роуте. Добре. Згода. Мені потрібна твоя допомога.",shape=box,color=red];
		625 -> 633;
	626 [label="Check boolean LoidFamilyComplete",color=orange];
		626 -> 634 [label=true,color=green];
		626 -> 635 [label=true,color=green];
		626 -> 636 [label=true,color=green];
		626 -> 637 [label=true,color=green];
		626 -> 634 [label=false,color=brown];
		626 -> 635 [label=false,color=brown];
		626 -> 636 [label=false,color=brown];
		626 -> 637 [label=false,color=brown];
		626 -> 638 [label=false,color=brown];
	628 [label="Як просувається твоя робота з нашою маленькою підлабузницею? Я так розумію, священник і досі не розмовляє з тобою.",shape=box,color=blue];
		628 -> 641;
		628 -> 642;
		628 -> 643;
	627 [label="Скажи мені, твоя думка змінилася щодо моєї пропозиції? Це твоя остання нагода, узурпаторе. Я терплячий, але мені не подобається стояти та тримати двері відчиненими, наче дурень.",shape=box,color=blue];
		627 -> 639;
		627 -> 640;
	629 [label="Поки що я добре ладнаю з Марі.",shape=box,color=red];
		629 -> 644;
	630 [label="Ні, але він передумає.",shape=box,color=red];
		630 -> 645;
	631 [label="Здається, вони не дуже тобі подобаються. Чому?",shape=box,color=red];
		631 -> 646;
	632 [label="Як забажаєш. Але май на увазі, це була твоя остання нагода. Тепер усе самотужки.",shape=box,color=blue];
		632 -> 647;
	633 [label="Evaluate expressions",color=orange];
		633 -> 649 [label="RoatheDatingDealNo",color=purple];
		633 -> 650 [label="RoatheMarieDatingDealNo",color=purple];
		633 -> 651 [label="RoatheLyonDatingDealNo",color=purple];
		633 -> 652 [label="RoatheSerumDealNo",color=purple];
		633 -> 655 [label="RoatheFamilyDealNo",color=purple];
		633 -> 654 [label="RoatheMarieEntratiDealNo",color=purple];
		633 -> 653 [label="RoatheLyonConfessionDealNo",color=purple];
		633 -> 648 [label="false",color=purple];
	634 [label="У Ліона… стільки проблем. І я не знаю, як з цим усім упоратися.",shape=box,color=red];
		634 -> 656;
	635 [label="Марі не бачить Ентраті таким, яким він є насправді. І я ніяк не можу змусити її побачити правду.",shape=box,color=red];
		635 -> 657;
	636 [label="Ну, розумієш, у тебе є всі… спогади, чому ти прийняв сироватку, але… від мене ти почув багато неправильного в неправильний час.",shape=box,color=red];
		636 -> 658;
	637 [label="Можливо, це трохи ніяково, але… я маю почуття до одного з вас.",shape=box,color=red];
		637 -> 659;
		637 -> 660;
		637 -> 661;
	638 [label="Я намагаюся переконати тебе та інших допомогти мені возз’єднати Лойда з родиною на горі, але… мені… не вдалося…",shape=box,color=red];
		638 -> 662;
	641 [label="Ні, Ліон… здається, не дуже балакучий.",shape=box,color=red];
		641 -> 665;
	642 [label="Я добре ладнаю з Марі. Чому ти називаєш її підлабузницею?",shape=box,color=red];
		642 -> 666;
	643 [label="Здається, вони не дуже тобі подобаються. Чому?",shape=box,color=red];
		643 -> 667;
	639 [label="Ні. Вибач. Я не домовляюся з орокінами. Ні тоді, ні зараз, ніколи.",shape=box,color=red];
		639 -> 663;
	640 [label="Я дуже сподіваюся, що ти не змусиш мене про це пошкодувати, Роуте. Добре. Згода.",shape=box,color=red];
		640 -> 664;
	644 [label="«Поки що». Цікаво. І ми знову повертаємося на початок, наче придворні, що повторюють рухи танцю? Знов і знов, приречені повторюватися?",shape=box,color=blue];
		644 -> 668;
		644 -> 669;
	645 [label="Гадаю, ти знаєш, чи не так? Цікаво, що це настільки передбачувано. Приємно знати, що навіть така зламана людина як він, може бути надійною час від часу.",shape=box,color=blue];
		645 -> 670;
	646 [label="Хіба ти ще не знаєш? М-м. Можливо, ми не зайшли так далеко. Або тобі не спало на думку запитати про це в перший чи двадцятитисячний раз цієї маленької витівки.",shape=box,color=blue];
		646 -> 670;
	647 [label="Ох. І ще одне, поки я не забув.",shape=box,color=blue];
		647 -> 671;
	649 [label="Ти справді продаєш свою душу дияволу, та ще й двічі… домовившись, щоб я взяв тебе до свого ліжка? Або ти прагнеш отримати моє серце, узурпаторе? Гм. Побачимо, Але згодом.",shape=box,color=blue];
		649 -> 672;
	650 [label="Коли настане час, я подбаю про те, щоб в тебе була змога завоювати нашу маленьку підлабузницю, узурпаторе. Вважай, що це питання вирішене.",shape=box,color=blue];
		650 -> 673;
	651 [label="Коли настане час, я подбаю про те, щоб в тебе була змога завоювати бідного розбитого священника, узурпаторе. Вважай, що це питання вирішене.",shape=box,color=blue];
		651 -> 674;
	652 [label="Коли настане час, я пам’ятатиму про це. Якщо у нас знову виникнуть розбіжності щодо моїх спогадів, ми не повторюватимемо ваших попередніх помилок.",shape=box,color=blue];
		652 -> 675;
	655 [label="Коли настане час, я подбаю про те, щоб наш маленький дворецький піднявся тими сходами. Вважай, що це питання вирішене.",shape=box,color=blue];
		655 -> 678;
	654 [label="Вважай, що твоя проблема з Марі та її підлабузницьким обожнюванням Ентраті вирішена. Коли настане час, я розберуся з цим.",shape=box,color=blue];
		654 -> 677;
	653 [label="Вважай, що твоя проблема з Ліоном і його жахіттями вирішена, узурпаторе. Коли настане час, я розберуся з цим.",shape=box,color=blue];
		653 -> 676;
	648 [label="Я… здається забув, що було твоєю метою. Усе завдяки твоєму втручанню у мої спогади. Тож, що це було?",shape=box,color=blue];
		648 -> 626;
	656 [label="Я би порадив просто набратися терпіння, але… не мені радити тобі використовувати долото, коли поруч лежить лазерний різак.",shape=box,color=blue];
		656 -> 679;
	657 [label="Гм. Зрозуміло. Шляхетна справа, якщо чесно. Я сам намагався зробити це багато разів. І так само невдало.",shape=box,color=blue];
		657 -> 680;
	658 [label="Гм.",shape=box,color=blue];
		658 -> 681;
	659 [label="До Ліона.",shape=box,color=red];
		659 -> 682;
	660 [label="До тебе.",shape=box,color=red];
		660 -> 683;
	661 [label="До Марі.",shape=box,color=red];
		661 -> 684;
	662 [label="Гм. Зрозуміло. У нас була домовленість, але через твоє недотримання своєї частини угоди, твоя винагорода зникла.",shape=box,color=blue];
		662 -> 685;
	665 [label="Коли він говорить, його промови можна поділити на дві категорії — жахливо безглузді або жахливо божевільні.",shape=box,color=blue];
		665 -> 688;
	666 [label="Гм? Тобі вдалося уникнути цього? Я тобі страшенно заздрю. Але незабаром ти опинишся у радіусі вибуху, тому краще заздалегідь попередити тебе.",shape=box,color=blue];
		666 -> 689;
	667 [label="Мій бідний мандрівниче. Невже ти не пам’ятаєш як ми, орокіни, відкидали будь-яке поняття священних божеств? Єдине, що ми шанували, це самих себе.",shape=box,color=blue];
		667 -> 690;
	663 [label="Як забажаєш. Я попереджаю тебе, твоє рішення не залишиться без наслідків.",shape=box,color=blue];
		663 -> 686;
	664 [label="Ти поводитимешся добре та допоможеш мені переконати Лойда піднятися нагору та помиритися із родиною? А я допоможу тобі розібратися зі своїми спогадами.",shape=box,color=red];
		664 -> 687;
	668 [label="Це не означає, що тобі бракує ініціативи. Це просто означає, що деякі речі вимагають кількох додаткових спроб.",shape=box,color=red];
		668 -> 691;
	669 [label="Сподіваюся, це тебе не засмутить.",shape=box,color=red];
		669 -> 692;
	670 [label="Чи справді ми приречені повертатися на початок, наче придворні, що повторюють рухи танцю?",shape=box,color=blue];
		670 -> 668;
		670 -> 669;
	671 [label="Не так давно я довірив тобі жахливу правду. Тепер я не можу пригадати чому.",shape=box,color=blue];
		671 -> 693;
	672 [label="Update boolean RoatheFamilyDealNo",color=orange];
		672 -> 694;
	673 [label="Update boolean RoatheFamilyDealNo",color=orange];
		673 -> 695;
	674 [label="Update boolean RoatheLyonDatingDealNo",color=orange];
		674 -> 696;
	675 [label="Update boolean RoatheSerumDealNo",color=orange];
		675 -> 697;
	678 [label="Update boolean RoatheFamilyDealNo",color=orange];
		678 -> 700;
	677 [label="Update boolean RoatheMarieEntratiDealNo",color=orange];
		677 -> 699;
	676 [label="Update boolean RoatheLyonConfessionDealNo",color=orange];
		676 -> 698;
	679 [label="Здається, я починаю розуміти, чому наша пам’ять була стерта. Побачивши всі свої невдалі спроби та зусилля… чому б не спробувати все спочатку?",shape=box,color=blue];
		679 -> 701;
	680 [label="Побачивши з розчаруванням, що ти більше не можеш переконати її в простій істині речей, ти вдаєшся до того, що було — використовуючи цей… свій дар.",shape=box,color=blue];
		680 -> 702;
	681 [label="Мені не подобається, що ти забруднюєш мій розум, щоб виправити свої помилки, мандрівниче. Однак те, що ти намагаєшся це зробити заради мене… мабуть, якось прийнятно.",shape=box,color=blue];
		681 -> 703;
	682 [label="Update boolean DrifterLyon",color=orange];
		682 -> 704;
	683 [label="Update boolean DrifterRoathe",color=orange];
		683 -> 705;
	684 [label="Update boolean DrifterMarie",color=orange];
		684 -> 706;
	685 [label="Отже, розуміючи, що ти більше не можеш досягти того, що раніше було у твоїх силах, ти вдаєшся до того, що було — використовуючи цей… свій дар.",shape=box,color=blue];
		685 -> 707;
	688 [label="Це як кинути монетку, яку з них ти отримаєш, і я ніколи не можу вирішити, яка з них мені подобається більше.",shape=box,color=blue];
		688 -> 710;
	689 [label="Ця жінка безмежна у своїй непохитній та одержимій відданості Альбрехту. Я б сказав, що дворецькому варто турбуватися, але, чесно кажучи, я щиро вірю, що це безневинна відданість. І це кажу я.",shape=box,color=blue];
		689 -> 711;
	690 [label="Ці два фанатики не можуть і двох хвилин прожити без «Сола» чи «Луа» або без спроб благословити нічний горщик.",shape=box,color=blue];
		690 -> 712;
	686 [label="Update boolean RoatheFamilyFail",color=orange];
		686 -> 708;
	687 [label="+5 Chemistry",color=orange];
		687 -> 709;
	691 [label="Мене забавляє твій оптимізм. Герої. Ви всі такі, клянусь. Мішки з м’ясом і кістками, наповнені та керовані виключно оптимізмом і надією. Від цього аж зуби зводить.",shape=box,color=blue];
		691 -> 713;
	692 [label="Ні, ти мене неправильно розумієш. У якомусь сенсі я вважаю це втішним. Це означає, що коли нас розібрати на окремі компоненти, ми все одно залишимося тими самими. Ми не можемо змінитися.",shape=box,color=blue];
		692 -> 714;
	693 [label="Ти — єдина душа, якій я коли-небудь міг довіряти… і причина, через яку я тепер не можу згадати, чому я наважився.",shape=box,color=blue];
		693 -> 715;
	694 [label="Update boolean RoatheFamilyDeal",color=orange];
		694 -> 716;
	695 [label="Update boolean RoatheFamilyDeal",color=orange];
		695 -> 716;
	696 [label="Update boolean RoatheLyonDatingDeal",color=orange];
		696 -> 716;
	697 [label="Update boolean RoatheSerumDeal",color=orange];
		697 -> 716;
	700 [label="Update boolean RoatheFamilyDeal",color=orange];
		700 -> 716;
	699 [label="Update boolean RoatheMarieEntratiDeal",color=orange];
		699 -> 716;
	698 [label="Update boolean RoatheLyonConfessionDeal",color=orange];
		698 -> 716;
