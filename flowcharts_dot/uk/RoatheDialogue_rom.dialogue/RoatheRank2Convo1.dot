	871 [label="+5 Chemistry",color=orange];
		871 -> 875;
	872 [label="Ага, спробуй витримати, коли вони цілодобово дзижчать над тобою, проклинаючи твоє ім’я та благаючи покаятися.",shape=box,color=blue];
		872 -> 758;
