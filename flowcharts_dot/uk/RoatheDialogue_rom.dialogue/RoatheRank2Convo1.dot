		803 -> 814;
	804 [label="Ми тільки почати розкривати, що було приховано від мене. Я не знаю, що Альбрехт розповів їм про мої злочини, мандрівниче.",shape=box,color=blue];
		804 -> 814;
	805 [label="Я не знаю, що Альбрехт розповів їм про мої злочини, бо вони приховані навіть від мене. Правда прихована в моїх спогадах, мандрівниче.",shape=box,color=blue];
