	j500703126 [label="Шоколадом. Ти підкуповуєш його, приносячи йому шоколад. я чув, що шоколад заспокоює його видіння.",shape=box,color=blue];
		j500703126 -> j3200144113;
	j109604759 [label="Я чув, що в його часи було заведено дарувати священникам коробку цукерок. Крім того, я чув, що шоколад заспокоює його видіння.",shape=box,color=blue];
