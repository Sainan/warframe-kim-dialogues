	j147918952 [label="Ха! Я майже чую, як вони кричать і лають мене за тебе, що я «підбурюю тебе проти них». ",shape=box,color=blue];
		j147918952 -> j1229764098;
	j1984460773 [label="І це було справжнє пекло!",shape=box,color=blue];
		j1984460773 -> j3142907957;
