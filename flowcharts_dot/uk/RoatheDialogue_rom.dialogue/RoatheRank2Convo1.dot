	856 [label="Але ти приніс достатньо для Марі та Ліона?",shape=box,color=red];
		856 -> 858;
	857 [label="То ти просто крав випічку.",shape=box,color=red];
		857 -> 859;
	858 [label="А. То були очікування, що я візьму лише для себе, а їх залишу без нічого? Просто тому, що мені не подобається їхня компанія і я хочу позбутися їх?",shape=box,color=blue];
		858 -> 860;
	859 [label="Усе на цій планеті незабаром належатиме орокінській імперії. У будь-якому разі, вона була моєю по праву.",shape=box,color=blue];
		859 -> 861;
	860 [label="Ти думаєш, що моя неприязнь до них якось зобов’язує мене бути жорстоким до них. Тому що я диявол, а отже, схильний до таких вчинків, тому такий висновок.",shape=box,color=blue];
		860 -> 862;
	861 [label="Крім того, у мене не було грошей. Що, по-твоєму, я мав робити?",shape=box,color=blue];
		861 -> 863;
	862 [label="Як же це розчаровує. Такі поверхневі вчинки притаманні лише надзвичайно нудним людям і шкільним хуліганам. ",shape=box,color=blue];
		862 -> 864;
	863 [label="І я знаю, що ти вдираєшся в кораблі та забираєш усе, що потрібно або хочеться. Тож не треба дивитися на мене своїми невинними очима, узурпаторе.",shape=box,color=blue];
		863 -> 865;
		863 -> 866;
	864 [label="Я їх ненавиджу. Проте я мушу з ними співіснувати. Я не хочу позбавляти їх дурної випічки. Це ж просто випічка. Навіщо ускладнювати ситуацію?",shape=box,color=blue];
		864 -> 867;
		864 -> 868;
		864 -> 869;
	865 [label="Не зважай. ",shape=box,color=red];
		865 -> 870;
	866 [label="Справедливе зауваження, мабуть.",shape=box,color=red];
		866 -> 871;
	867 [label="Або ти можеш спробувати бути добрим до них просто так.",shape=box,color=red];
		867 -> 872;
	868 [label="Отже, щоб було зрозуміло — ти був милим, бо ти їх ненавидиш.",shape=box,color=red];
		868 -> 873;
	869 [label="Ніколи не доводилося думати про це з такої перспективи.",shape=box,color=red];
		869 -> 874;
	870 [label="Фантастично. Ще одна персона, не здатна поступитися. Ніби фанатиків було недостатньо, які цілодобово кричали на мене, благаючи покаятися.",shape=box,color=blue];
		870 -> 758;
