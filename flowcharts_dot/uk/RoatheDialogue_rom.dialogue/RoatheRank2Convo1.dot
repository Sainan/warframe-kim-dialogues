	819 [label="Update boolean RoatheRank2Convo1Complete",color=orange];
		819 -> 834;
	821 [label="То це правда. Ти прокрадався до Ґоллі, щоб красти шоколад? Виглядаючи як…?",shape=box,color=red];
		821 -> 836;
	822 [label="Як саме ти це зробив?",shape=box,color=red];
		822 -> 837;
	820 [label="Ха! Гарна спроба. Вибуховий шоколад був єдиним благом у цій пекельній дірі.",shape=box,color=blue];
		820 -> 835;
	823 [label="Обіцяю.",shape=box,color=red];
		823 -> 838;
	824 [label="Ми це зробимо. Але це займе час.",shape=box,color=red];
		824 -> 839;
	825 [label="Я це зроблю.",shape=box,color=red];
		825 -> 840;
	826 [label="Я намагаюся. Але ти не полегшуєш мені завдання.",shape=box,color=red];
		826 -> 841;
	827 [label="Зрозумій, ким це робить тебе для мене.",shape=box,color=blue];
		827 -> 842;
	828 [label="Ти стверджував, що не злишся на мене за те, що твої спогади стерті, але я знаю, що ти брешеш. Тому що… це не перший раз, коли я це роблю.",shape=box,color=red];
		828 -> 843;
	829 [label="Тому що ти ненавидиш себе за те, що добровільно прийняв цю сироватку. Ти ненавидиш себе, і це тебе розлючує, бо ти — це все, що у тебе залишилося.",shape=box,color=red];
		829 -> 844;
	830 [label="Ти стверджував, що не злишся на мене за те, що твої спогади стерті, але я не можу уявити, як це може не розлютити.",shape=box,color=red];
		830 -> 844;
	831 [label="Ти не втратив нічого цінного, лише наші розмови.",shape=box,color=red];
		831 -> 845;
	832 [label="Не все — лише наші розмови. У тебе залишилося все інше, навіть те, що ми відновили у «Спуску».",shape=box,color=red];
		832 -> 845;
	833 [label="Chat ends.",color=orange];
	834 [label="Chat ends.",color=orange];
	836 [label="Так, із блакитною шкірою, хвостом і зараженою плоттю. Але ти здивуєшся, що може зробити плащ, капелюх і маска.",shape=box,color=blue];
		836 -> 847;
	837 [label="Це було досить просто. Крім того, як «протофрейм» і елітний орокінський воїн, я здатний викрасти кілька тістечок із ринку, не викликавши підозри у влади.",shape=box,color=blue];
		837 -> 848;
	835 [label="Перш ніж ти запитаєш, цю історію краще почути від Марі, щоб фанатики знову не почали на мене кричати та сваритися.",shape=box,color=blue];
		835 -> 846;
	838 [label="Обіцянка дияволу… небезпечна річ.",shape=box,color=blue];
		838 -> 849;
	839 [label="А я терплячий диявол.",shape=box,color=blue];
		839 -> 849;
	840 [label="Подивися, що зможеш.",shape=box,color=blue];
		840 -> 850;
	841 [label="Звичайно, ні! А де ж тоді будуть веселощі?",shape=box,color=blue];
		841 -> 850;
	842 [label="Update boolean RoatheKnowsReset2",color=orange];
		842 -> 851;
	843 [label="Як дивовижно чудово! І я навіть не дивуюся! І що мені взагалі до того, правда це чи ні?! Окрім того…",shape=box,color=blue];
		843 -> 844;
	844 [label="Неправда! Захоплива, прекрасна, блаженна неправда! Не розмовляй зі мною так, ніби ти знаєш всі тонкощі гніву, який, як на мене, ти навіть не можеш почати розуміти.",shape=box,color=blue];
		844 -> 746;
	845 [label="Не смій говорити мені, що є цінним у моїх думках, а що ні, мандрівниче. Це не твоє, щоби претендувати на право власності.",shape=box,color=blue];
		845 -> 746;
	847 [label="Люди легко ігнорують тих, кого не хочуть бачити. Крім того, як «протофрейм» і бойовий елітний воїн орокін, я вважаю, що здатний викрасти кілька тістечок з ринку, не викликавши підозри у влади.",shape=box,color=blue];
		847 -> 852;
	848 [label="Так, із блакитною шкірою, хвостом і зараженою плоттю. Але ти здивуєшся, що може зробити плащ, капелюх і маска.",shape=box,color=blue];
		848 -> 852;
	846 [label="Вони кричать і лають мене за гріхи й за те, що я недостатньо каюся, не додаючи, що я «знову брешу про свою версію подій» на додачу.",shape=box,color=blue];
		846 -> 758;
