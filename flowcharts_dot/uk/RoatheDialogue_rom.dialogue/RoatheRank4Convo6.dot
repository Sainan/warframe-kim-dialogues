digraph {
	2743 [label="RoatheRank4Convo6 begins.",color=orange];
		2743 -> 2744;
	2744 [label="Який твій улюблений спосіб убивати, узурпаторе?",shape=box,color=blue];
		2744 -> 2746;
		2744 -> 2747;
		2744 -> 2745;
	2746 [label="Перепрошую?",shape=box,color=red];
		2746 -> 2749;
	2747 [label="Ти хочеш піти дізнатися?",shape=box,color=red];
		2747 -> 2750;
	2745 [label="[Завершити розмову]",shape=box,color=red];
		2745 -> 2748;
	2749 [label="Останнім часом я схильний до філософських роздумів і мені просто цікаво.",shape=box,color=blue];
		2749 -> 2751;
	2750 [label="Ха, та ні. Хоча… провести кілька раундів із тобою було б весело. Ні, останнім часом я схильний до філософських роздумів і мені просто цікаво.",shape=box,color=blue];
		2750 -> 2751;
	2748 [label="Chat ends.",color=orange];
	2751 [label="За кількістю ми з тобою, імовірно, рівні. Летальність… м-м… я не хотів би робити ставку, та й особливо не цікавлюся уявним змаганням мечів.",shape=box,color=blue];
		2751 -> 2752;
	2752 [label="Як убивця вбивці. Чому ти віддаєш перевагу? Чи любиш щось близьке й особисте? Чи віддаєш перевагу тіні? Хаосу поля бою?",shape=box,color=blue];
		2752 -> 2753;
		2752 -> 2754;
		2752 -> 2755;
		2752 -> 2756;
	2753 [label="Я віддаю перевагу хаосу. Вибухам. Перестрілкам. Гучним звукам. Що більше, то краще.",shape=box,color=red];
		2753 -> 2757;
	2754 [label="Скрадне вбивство. Я віддаю перевагу знищити ворога ще до того, як він дізнається про мою присутність. Найліпше вбивати там, де ворог спить.",shape=box,color=red];
		2754 -> 2758;
	2755 [label="Я ненавиджу битися. Хотілося б ніколи цього не робити.",shape=box,color=red];
		2755 -> 2759;
	2756 [label="Ця розмова якась нездорова.",shape=box,color=red];
		2756 -> 2760;
	2757 [label="Update boolean RoatheSoldier",color=orange];
		2757 -> 2761;
	2758 [label="Update boolean RoatheAssassin",color=orange];
		2758 -> 2762;
	2759 [label="Ох, мій нещасний узурпатор. Якби ж то мій сміх міг долинути до тебе…",shape=box,color=blue];
		2759 -> 2763;
	2760 [label="Тоді киш звідси.",shape=box,color=blue];
		2760 -> 2764;
	2761 [label="Бойовий солдат, як і я сам. Я не здивований, зважаючи на те, що знаю про твою історію. Стільки крові ти лишаєш по собі. Спершу Дувірі, потім Нармер, Голвенія. Тепер ця справа.",shape=box,color=blue];
		2761 -> 2765;
	2762 [label="О-о, то серед нас убивця! Яка користь, ще й недооцінена. Я завжди порівнював убивць із талановитими дворецькими.",shape=box,color=blue];
		2762 -> 2766;
	2763 [label="Нещасне, спустошене створіння. Сподіваюся, заради тебе ж, ти брешеш мені.",shape=box,color=blue];
		2763 -> 2767;
	2764 [label="Chat ends.",color=orange];
	2765 [label="Хто знає, що ще було чи про що ти не пам’ятаєш. Смерть — це твоє мистецтво, і ти розмальовуєш нею світи.",shape=box,color=blue];
		2765 -> 2768;
	2766 [label="Коли вони виконують свою роботу винятково добре, їх ніколи не помічають.",shape=box,color=blue];
		2766 -> 2769;
	2767 [label="+20 Chemistry",color=orange];
		2767 -> 2770;
	2768 [label="Тож… який твій улюблений пензлик? Занурмося глибше.",shape=box,color=blue];
		2768 -> 2771;
		2768 -> 2772;
		2768 -> 2773;
		2768 -> 2774;
	2769 [label="Тож… Кинджал? Отрута? Лук?",shape=box,color=blue];
		2769 -> 2775;
		2769 -> 2776;
		2769 -> 2777;
		2769 -> 2778;
		2769 -> 2779;
	2770 [label="Інакше це може бути найсумніша річ, яку я чув за усі свої роки.",shape=box,color=blue];
		2770 -> 2780;
	2771 [label="Якщо чесно, то я впораюся з будь-чим. Люблю імпровізувати.",shape=box,color=red];
		2771 -> 2781;
	2772 [label="Лук. Витончений і смертельний.",shape=box,color=red];
		2772 -> 2782;
	2773 [label="Клинок. Я люблю бути близько.",shape=box,color=red];
		2773 -> 2783;
	2774 [label="Гвинтівки й рушниці. Гучні, але роблять свою справу.",shape=box,color=red];
		2774 -> 2784;
	2775 [label="Якщо чесно, то я впораюся з будь-чим. Люблю імпровізувати.",shape=box,color=red];
		2775 -> 2785;
	2776 [label="Лук. Витончений і тихий.",shape=box,color=red];
		2776 -> 2786;
	2777 [label="Снайперська гвинтівка. Один постріл? Одне вбивство.",shape=box,color=red];
		2777 -> 2787;
	2778 [label="Отрута. Я зникаю ще до того, як вони дізнаються, що мертві.",shape=box,color=red];
		2778 -> 2788;
	2779 [label="Кинджал. Мені подобається його інтимність.",shape=box,color=red];
		2779 -> 2789;
	2780 [label="Update boolean RoatheWeaponNone",color=orange];
		2780 -> 2790;
	2781 [label="Я сиджу тут і уявляю, як ти несешся крізь бойовище з медичною лавкою. Розриваєш солдатів колесом, прив’язаним до зігнутої труби.",shape=box,color=blue];
		2781 -> 2791;
	2782 [label="Володіння луком у розпалі битви вимагає рішучості й ясності розуму, якими мало хто володіє. І, звісно, твердість рук.",shape=box,color=blue];
		2782 -> 2792;
	2783 [label="М-м, обережно. Не змушуй мене надто збуджуватися, узурпаторе. Як би я хотів бачити тебе в танці на полі бою, зі зброєю в руках, бризки крові — наче пелюстки квітки, що широко розкривається…",shape=box,color=blue];
		2783 -> 2793;
	2784 [label="Вони були робочими конячками будь-якої війни від моменту винайдення — і не дарма, узурпаторе. Важко заперечити, що коли вони досягають своєї цілі, то виконують завдання.",shape=box,color=blue];
		2784 -> 2794;
	2785 [label="Я сиджу тут і уявляю, як ти вбиваєш когось столовим прибором чи ніжкою від стільця. Гасиш чиєсь життя зав’язкою від штори.",shape=box,color=blue];
		2785 -> 2795;
	2786 [label="Шлях мисливця. Не надто сучасний, але елегантний у своїй простоті. Іноді найпростіші й найдавніші методи у своїй суті є найдієвішими.",shape=box,color=blue];
		2786 -> 2796;
	2787 [label="Трохи безособово й клінічно для мого смаку, але я не можу засуджувати за дієвість цього методу. Є щось у цьому спокої.",shape=box,color=blue];
		2787 -> 2797;
	2788 [label="Зловісний аптекар, так? Вариш настоянки й підливаєш щось у келихи? Або ж просочуєш ножі й кулі отрутою так, що навіть найменший дотик на полі бою стає смертельним?",shape=box,color=blue];
		2788 -> 2798;
	2789 [label="М-м, обережно. Не змушуй мене надто збуджуватися, узурпаторе. Яке захопливе видовище — прокинутися однієї ночі й побачити тебе в тіні, із кинджалом напоготові…",shape=box,color=blue];
		2789 -> 2799;
	2790 [label="Chat ends.",color=orange];
	2791 [label="+10 Chemistry",color=orange];
		2791 -> 2800;
	2792 [label="Тиша всього цього заслуговує на пошану. Накласти стрілу, натягнути тятиву, очікувати спуск… а потім солодка, солодка смерть, коли вона знаходить свою ціль.",shape=box,color=blue];
		2792 -> 2801;
	2793 [label="Я ціную прагнення до особистого дотику. Спостерігати, як кінцівки твоєї жертви відпадають, коли ти забираєш їхнє життя. Бачити, як їхні бездушні тіла згортаються перед тобою. Знати, що це зробив саме ти й ніхто інший.",shape=box,color=blue];
		2793 -> 2802;
	2794 [label="Брудні, галасливі, надзвичайно дорогі. Але такі дуже, дуже добрі у вбивстві.",shape=box,color=blue];
		2794 -> 2803;
	2795 [label="+10 Chemistry",color=orange];
		2795 -> 2804;
	2796 [label="Тиша всього цього заслуговує на пошану. Накласти стрілу, натягнути тятиву, очікувати спуск… а потім солодка, солодка смерть, коли вона знаходить свою ціль.",shape=box,color=blue];
		2796 -> 2805;
	2797 [label="У, здавалось би, невблаганному гамі поля бою снайпер мусить тримати дихання, як приплив океану. Вдих, видих. І потім забрати життя.",shape=box,color=blue];
		2797 -> 2806;
	2798 [label="Я бачив цілі батальйони, перетворені на багно від одного порізу на руці одного солдата. Токсин, що поширюється з крові до легень, а тоді до легень іншого. Так можна знищити цілі країни.",shape=box,color=blue];
		2798 -> 2807;
	2799 [label="Я ціную прагнення до особистого дотику. Дивитися в очі іншого й бачити, як вони стають скляними й тьмяними, коли світло згасає, а тепло покидає тіло.",shape=box,color=blue];
		2799 -> 2808;
	2800 [label="Я… не можу вирішити, чи робить це тебе жахливішим, узурпаторе, чи ні. Думаю, я зупинюся на «так». У будь-якому випадку, це кумедно і вражає водночас.",shape=box,color=blue];
		2800 -> 2809;
	2801 [label="+10 Chemistry",color=orange];
		2801 -> 2810;
	2802 [label="+10 Chemistry",color=orange];
		2802 -> 2811;
