		2822 -> 2820;
	2823 [label="Update boolean RoatheWeaponSniper",color=orange];
		2823 -> 2818;
		2823 -> 2819;
		2823 -> 2820;
	2824 [label="Update boolean RoatheWeaponBow",color=orange];
		2824 -> 2818;
		2824 -> 2819;
		2824 -> 2820;
	2825 [label="Update boolean RoatheWeaponSniper",color=orange];
		2825 -> 2818;
		2825 -> 2819;
		2825 -> 2820;
	2826 [label="Update boolean RoatheWeaponPoison",color=orange];
		2826 -> 2818;
		2826 -> 2819;
		2826 -> 2820;
	2827 [label="Update boolean RoatheWeaponDagger",color=orange];
		2827 -> 2818;
		2827 -> 2819;
		2827 -> 2820;
	2828 [label="Бо так воно і є. І ти це знаєш. Насправді половина твого існування буквально заснована на концепції вбивства як мистецтва!",shape=box,color=blue];
		2828 -> 2831;
	2829 [label="О? Справді? Пропоную зануритися в це питання трохи глибше.",shape=box,color=blue];
		2829 -> 2832;
	2830 [label="Вона змінилася нещодавно. І це мене безмежно турбує.",shape=box,color=blue];
		2830 -> 2833;
		2830 -> 2834;
	2831 [label="Я бачу ці «школи», якими володіють тенно, і які ти запозичуєш опосередковано. Не кажучи вже про вчення даксів. Скільки ж вони без кінця бурмотіли в комунікаціях, навіть коли ми раз по разу казали їм, що це заборонений канал.",shape=box,color=blue];
		2831 -> 2835;
	2832 [label="Скажи мені дещо і, будь ласка, відповідай чесно. Бо брехня в цю мить шкодить нам обом, але особливо тобі:",shape=box,color=blue];
		2832 -> 2836;
	2833 [label="Змінилася як?",shape=box,color=red];
		2833 -> 2837;
	2834 [label="Через Уриїла?",shape=box,color=red];
		2834 -> 2838;
	2835 [label="Якщо я більше ніколи не почую від когось із них «Я — клинок» і «Я існую, щоб ударяти», то я помру щасливим, узурпаторе.",shape=box,color=blue];
		2835 -> 2839;
	2836 [label="Тобі коли-небудь хотілося озброїти себе зброєю чи ворфреймом, налаштованим під твої смаки? Можливо, розфарбованим якось, або з якимось виглядом, який, на твою думку, ліпше відповідає твоєму настрою?",shape=box,color=blue];
		2836 -> 2840;
		2836 -> 2842;
		2836 -> 2841;
	2837 [label="Раніше я віддавав перевагу мечу. Елегантному. Швидкому. Я міг рухатися крізь поле бою й рубати ворогів на відстані руки. Лишаючи багрянець на срібному клинку, що сяяв у світлі блакитної зорі.",shape=box,color=blue];
		2837 -> 2843;
	2838 [label="Гадаю, що так. Або, можливо, через мої втрачені спогади. Я не знаю, що ще звинувачувати.",shape=box,color=blue];
		2838 -> 2837;
	2839 [label="Людство завжди дивилося на «вбивство» як на гріх, але на «вбивання» — як на мистецтво. Тобі ніколи не здавалося, що це дивно? Володіти клинком і здолати ворога в бою — значить стати чимось трансцендентним.",shape=box,color=blue];
		2839 -> 2844;
	2840 [label=" Так, було таке… але як це стосується…",shape=box,color=red];
		2840 -> 2845;
	2842 [label="Ні. Ніколи.",shape=box,color=red];
		2842 -> 2847;
	2841 [label="Я в цю гру не граю. [Завершити розмову]",shape=box,color=red];
		2841 -> 2846;
	2843 [label="А тепер? Тепер я прагну відчути кров на своїх зубах. Відчути, як вона хлище під моїми кігтями. Я прагну занурити пальці глибоко в плоть і кістки та розірвати їх на шмаття.",shape=box,color=blue];
		2843 -> 2848;
	2844 [label="А вбити людину в провулку загостреним шматком металу — значить бути боягузом і виродком. ",shape=box,color=blue];
		2844 -> 2849;
	2845 [label="Я ціную твою чесність. Тепер я не буду сперечатися з тим, що ти, імовірно, не насолоджуєшся холоднокровним убивством, і різаниною невинних життів ти не тішишся. Хоча, можливо, ти й робиш це, а твоє попереднє твердження було брехнею — і яке ж це було б ласе відкриття, але не про це ми тут говоримо.",shape=box,color=blue];
		2845 -> 2850;
	2847 [label="Я попрошу тебе трохи серйозно подумати. Я бачив, як твої друзі тенно шаленіли, наче різнокольорові циркові кошмари. Ніби дика тварина потрапила в горщики з пігментом художника. ",shape=box,color=blue];
		2847 -> 2852;
	2846 [label="Ну гаразд.",shape=box,color=blue];
		2846 -> 2851;
	2848 [label="Я хочу пити іхор, коли рву жили й відчуваю, як тіло розпадається піді мною на ще кривавіші рештки. Роздирати його, як солодкий плід, коли витікає кістковий мозок.",shape=box,color=blue];
		2848 -> 2853;
		2848 -> 2854;
	2849 [label="У чому різниця? «Честь?» Хто вирішує, що є почесним, а що ні? Переможений? Чи переможець? А, може, це просто існування достатньої кількості традицій, які проголошують, що є почесним, а що ні?",shape=box,color=blue];
		2849 -> 2857;
		2849 -> 2855;
		2849 -> 2856;
	2850 [label="Припустімо, однак, що це не так, і ти просто вбиваєш, бо, як ти кажеш, «мусиш». Тоді чому, скажи мені, ти витрачаєш час на те, щоб оздоблювати свої знаряддя смерті на свій смак?",shape=box,color=blue];
		2850 -> 2858;
	2852 [label="У тебе ніколи не було відчуття зробити те саме? Жодного разу? Клянуся, після твого зізнання в будь-якому випадку я не думатиму про тебе гірше.",shape=box,color=blue];
		2852 -> 2859;
		2852 -> 2860;
	2851 [label="Chat ends.",color=orange];
	2853 [label="Роуте?",shape=box,color=red];
		2853 -> 2861;
	2854 [label="І це… для тебе не нормально?",shape=box,color=red];
		2854 -> 2862;
	2857 [label="Я розумію твою думку. Межа розмита. ",shape=box,color=red];
		2857 -> 2865;
	2855 [label="Одне вимагає практики й відданості. Інше — це просто… жорстокість.",shape=box,color=red];
		2855 -> 2863;
	2856 [label="Я цю розмову не продовжуватиму. [Завершити розмову]",shape=box,color=red];
		2856 -> 2864;
	2858 [label="Чому тобі має бути важливо, який у тебе вигляд на полі бою? Звісно ж, це не для того, щоб інші могли впізнати твій труп. Тебе неможливо сплутати ніде. Ні, бо якщо ти мусиш бути вбивцею, мій дорогий узурпаторе, я закладаюся, що ти прагнеш робити це зі стилем.",shape=box,color=blue];
		2858 -> 2866;
	2859 [label="Ні.",shape=box,color=red];
		2859 -> 2846;
	2860 [label="Ну гаразд. Були такі думки. А що?",shape=box,color=red];
		2860 -> 2845;
	2861 [label="Так, я знаю! Я знаю! Зауваж, я цього не планую робити. І не збираюся спалити все довкола, хоча прагну цього.",shape=box,color=blue];
		2861 -> 2867;
	2862 [label="Ні! Це не нормально! Як і сходити слиною від думки спалити тут усе вщент!",shape=box,color=blue];
		2862 -> 2867;
	2865 [label="Усі ці межі проведені доволі довільно. І що швидше ми це зрозуміємо, то швидше зможемо дійти згоди щодо того, які битви є важливими для участі, а які — ні.",shape=box,color=blue];
		2865 -> 2870;
	2863 [label="Гаразд, Проведімо цю лінію міркувань до кінця. Убивство з достатньою практикою робить його почесним? Отже, ти кажеш, якщо я, як дакс, просто прикрашу своє вбивство достатньою кількістю пишності й обставин, то це стане Мистецтвом?",shape=box,color=blue];
		2863 -> 2868;
	2864 [label="Ну гаразд.",shape=box,color=blue];
		2864 -> 2869;
	2866 [label="А що це таке, якщо не насолода самим діянням, питаю я?",shape=box,color=blue];
		2866 -> 2871;
	2867 [label="Це Уриїл винен. Хоча я визнаю, що й раніше мав схильності до таких руйнівних і кровожерливих думок, але вони не були аж такими катастрофічними.",shape=box,color=blue];
		2867 -> 2872;
	2870 [label="Вирішувати, чи було вбивство скоєно з почестями — це як намагатися вирішити, що гірше: смерть від вогню чи смерть від утоплення. Обидва способи померти жалюгідні.",shape=box,color=blue];
		2870 -> 2874;
	2868 [label="Тепер ми ступаємо на межу ритуалу й релігії.",shape=box,color=blue];
		2868 -> 2873;
	2869 [label="Chat ends.",color=orange];
	2871 [label="Не зрозумій мене неправильно! Я не засуджую тебе. Ти робиш найкраще з того, що маєш! Смерть зробила тебе своїм партнером у цьому великому маскараді життя, і ти не можеш пручатися її поклику.",shape=box,color=blue];
		2871 -> 2875;
	2872 [label="І точно не були такими… апокаліптичними.",shape=box,color=blue];
		2872 -> 2876;
	2874 [label="І всі дороги ведуть у могилу, тож який сенс рипатися? У нас є нагальніші проблеми.",shape=box,color=blue];
		2874 -> 2878;
	2873 [label="Принаймні є чесність у простій, легкій смерті від ножа в спину. У цьому немає нічого благочестивого. Нічого показного чи перевантаженого. Це просто зроблено.",shape=box,color=blue];
		2873 -> 2877;
	2875 [label="Якби тобі вдалося відкласти зброю, то скільки б іще мертвих було поруч із тобою? То чому б не мати трохи гордості у своїй роботі? Трохи задоволення від мистецтва всього цього? Яка альтернатива, питаю я? Безумство? Забуття?",shape=box,color=blue];
		2875 -> 2879;
	2876 [label="Chat ends.",color=orange];
	2878 [label="Chat ends.",color=orange];
	2877 [label="Хіба ж у цьому немає мистецтва?",shape=box,color=blue];
		2877 -> 2880;
	2879 [label="Я бачив надто багатьох, що йшли цим шляхом, і знаходили кінець у петлі, що чекала на них. Ні. Я кажу: роби, що бажаєш, узурпаторе. Бо життя, без сумніву, зробило з тобою те, що бажало.",shape=box,color=blue];
		2879 -> 2881;
	2880 [label="Chat ends.",color=orange];
	2881 [label="Chat ends.",color=orange];
}