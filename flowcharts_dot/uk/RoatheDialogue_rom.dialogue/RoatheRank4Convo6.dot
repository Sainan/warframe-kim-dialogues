		2809 -> 2819;
		2809 -> 2820;
	2810 [label="Чарівно.",shape=box,color=blue];
		2810 -> 2821;
	2811 [label="Яка мить.",shape=box,color=blue];
		2811 -> 2822;
	2812 [label="У цьому точно є щось красиве.",shape=box,color=blue];
		2812 -> 2823;
	2813 [label="Update boolean RoatheWeaponImprov",color=orange];
		2813 -> 2818;
		2813 -> 2819;
		2813 -> 2820;
	2814 [label="Чарівно.",shape=box,color=blue];
		2814 -> 2824;
	2815 [label="У цьому є краса.",shape=box,color=blue];
		2815 -> 2825;
	2816 [label="Смерть такого масштабу? У цьому є краса.",shape=box,color=blue];
		2816 -> 2826;
	2817 [label="Яка мить.",shape=box,color=blue];
		2817 -> 2827;
	2818 [label="Від тебе це звучить так, ніби це якась… форма мистецтва.",shape=box,color=red];
		2818 -> 2828;
	2819 [label="Я не люблю вбивати людей, Роуте. ",shape=box,color=red];
		2819 -> 2829;
	2820 [label="А яка твоя улюблена?",shape=box,color=red];
		2820 -> 2830;
	2821 [label="Update boolean RoatheWeaponBow",color=orange];
		2821 -> 2818;
		2821 -> 2819;
		2821 -> 2820;
	2822 [label="Update boolean RoatheWeaponDagger",color=orange];
		2822 -> 2818;
