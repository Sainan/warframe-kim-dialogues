digraph {
	"RoatheRank3Convo3 begins." [color=orange];
		"RoatheRank3Convo3 begins." -> j3791167673;
	j3791167673 [label="Evaluate expressions on HellStory counter",color=orange];
		j3791167673 -> j1883283832 [label="x >= 21",color=purple];
		j3791167673 -> j509978638 [label="x >= 13",color=purple];
		j3791167673 -> j3012649973 [label="x < 13 && x > 1",color=purple];
		j3791167673 -> j825887866 [label="x == 0",color=purple];
		j3791167673 -> j825887866 [label="false",color=purple];
	j1883283832 [label="Це не дає мені спокою, день і ніч. Це постійне неприємне усвідомлення, що я не тільки довірив тобі всі свої найпотаємніші секрети, але ти зраджуєш мою довіру. Я лишився всього, а тепер я навіть не можу згадати чому…",shape=box,color=blue];
		j1883283832 -> j1787026705;
	j509978638 [label="Ми досягаємо значного прогресу в просуванні моїми спогадами. Альбрехт добряче мене обдурив, коли ввів ту сироватку.",shape=box,color=blue];
		j509978638 -> j2612135454;
		j509978638 -> j527478083;
		j509978638 -> j1478915251;
	j3012649973 [label="Ти гальмуєш прогрес у допомозі мені розкрити мої спогади. Якщо ти збираєшся дотримуватися своєї частини угоди, я очікую, що ти продовжиш свою роботу в «Спуску».",shape=box,color=blue];
		j3012649973 -> j835355575;
		j3012649973 -> j562828237;
		j3012649973 -> j3980166847;
		j3012649973 -> j1478915251;
	j825887866 [label="Тобою не досягнуто жодного прогресу у розкритті моїх спогадів у «Спуску». Якщо ти хочеш, щоб я дотримався своєї частини угоди, тобі доведеться докласти зусиль для дотримання своєї.",shape=box,color=blue];
		j825887866 -> j562828237;
		j825887866 -> j3980166847;
		j825887866 -> j835355575;
		j825887866 -> j1478915251;
	j1787026705 [label="Check boolean RoatheResetForgiven",color=orange];
		j1787026705 -> j50829716 [label=true,color=green];
		j1787026705 -> j3119737518 [label=false,color=brown];
	j2612135454 [label="Вони не здаються приємними. ",shape=box,color=red];
		j2612135454 -> j990465205;
	j527478083 [label="Вони не здаються приємними. Ти впевнений, що нам слід продовжувати?",shape=box,color=red];
		j527478083 -> j2329274903;
	j1478915251 [label="[Завершити розмову]",shape=box,color=red];
		j1478915251 -> "Chat ends.";
	j835355575 [label="Чесно кажучи, я трохи борюся з цим… Я постійно гину попри всі мої зусилля.",shape=box,color=red];
		j835355575 -> j1300830126;
	j562828237 [label="Я не виконую твоїх наказів, Роуте.",shape=box,color=red];
		j562828237 -> j3822587761;
	j3980166847 [label="У мене були справи. Я займуся цим.",shape=box,color=red];
		j3980166847 -> j4145399895;
	j50829716 [label="Я не лише пробачив тобі за те, що залишився без цих спогадів…",shape=box,color=blue];
		j50829716 -> j2196124976;
	j3119737518 [label="Я не лише починаю прощати тебе за те, що залишився без цих спогадів…",shape=box,color=blue];
		j3119737518 -> j2196124976;
	j990465205 [label="Ні. Вони неприємні. Чого ти очікуєш від «диявола Тау»? Спогадів про сонячний день у парку, який я провів лежачи на ковдрі та поїдаючи виноград?",shape=box,color=blue];
		j990465205 -> j3750631977;
	j2329274903 [label="Я не дізнаюся, що він у мене забрав, поки не отримаю все назад. Звичайно, ми повинні продовжувати! Ці спогади належать мені, мандрівниче. Вони складають те, хто я є, ким я був. Вони є самою сутністю мого єства.",shape=box,color=blue];
		j2329274903 -> j1055121837;
	"Chat ends." [color=orange];
	j1300830126 [label="Boolean RoatheStrugglebus is now true.",color=orange];
		j1300830126 -> j201393421;
	j3822587761 [label="Ні, не виконуєш. І мені байдуже, як ти проводиш свій день. Я лише кажу, якщо ти хочеш, щоби той худорлявий маленький дворецький піднявся нагору, тобі потрібно виконати свою роботу.",shape=box,color=blue];
		j3822587761 -> j3233335149;
	j4145399895 [label="Як тобі заманеться. Мені байдуже, як ти проводиш свій день. Я лише кажу, якщо ти хочеш, щоби той худорлявий маленький дворецький піднявся нагору, тобі потрібно виконати свою роботу.",shape=box,color=blue];
		j4145399895 -> j4168231615;
	j2196124976 [label="Але я починаю відчувати, що хочу знову тобі довіряти. Знову! Добре знаючи, що сталося. Знаючи, що ти можеш просто зрадити мене ще раз!",shape=box,color=blue];
		j2196124976 -> j3089866187;
	j3750631977 [label="Мій бідний узурпаторе, боюся, що все, що ми знайдемо в скрижалях моєї пам’яті, буде лише кров, поля трупів і невдачі.",shape=box,color=blue];
		j3750631977 -> j1860831450;
		j3750631977 -> j1194462849;
	j1055121837 [label="З того, що мені відомо від інших про твоє перебування в Дувірі, в тебе були ті самі проблеми, чи не так?",shape=box,color=blue];
		j1055121837 -> j2855298853;
		j1055121837 -> j3839871205;
	j201393421 [label="Я постійно чую про твої успіхи в перемозі над Нармером. Над ґрінерами. Над хвилями Шепоту на кожному кроці. Та все ж мені вдалося збити тебе з пантелику?",shape=box,color=blue];
		j201393421 -> j2717184252;
	j3233335149 [label="Якщо тобі байдуже. Тоді мені теж. У мене є свої справи.",shape=box,color=blue];
		j3233335149 -> "Chat ends.";
	j4168231615 [label="Якщо тобі байдуже. Тоді мені теж. У мене є свої справи.",shape=box,color=blue];
		j4168231615 -> j1933300832;
	j3089866187 [label="Але я сиджу в цій крипті, встаю з крісла та думаю: «цікаво, чи є тут мандрівник, чи має бажання поговорити».",shape=box,color=blue];
		j3089866187 -> j1095633815;
	j1860831450 [label="Ти керуєш цим кораблем. Якщо ти хочеш продовжувати летіти в чорну діру, то вперед на повній швидкості.",shape=box,color=red];
		j1860831450 -> j1725005848;
	j1194462849 [label="Ти впевнений, що хочеш продовжувати?",shape=box,color=red];
		j1194462849 -> j2608359787;
	j2855298853 [label="Ми дуже різні люди, Роуте.",shape=box,color=red];
		j2855298853 -> j676564718;
	j3839871205 [label="Були. Спогади та апатія. Я досі не можу згадати… цілі проміжки часу, що там були.",shape=box,color=red];
		j3839871205 -> j414416510;
	j2717184252 [label="+20 Chemistry",color=orange];
		j2717184252 -> j1687193116;
	j1933300832 [label="+10 Chemistry",color=orange];
		j1933300832 -> "Chat ends.";
	j1095633815 [label="Як це жалюгідно! Як низько я впав? Я?! Орокін?! Роут! Диявол Тау! Такий невгамовний, такий інтелектуально зголоднілий, такий відчайдушний у пошуках будь-якого заохочення, що я тут, розмовляю з тобою!",shape=box,color=blue];
		j1095633815 -> j2091562898;
		j1095633815 -> j547491427;
		j1095633815 -> j410220997;
		j1095633815 -> j1478915251;
	j1725005848 [label="+10 Chemistry",color=orange];
		j1725005848 -> j3142705590;
	j2608359787 [label="Я не дізнаюся, що він у мене забрав, поки не отримаю все назад. Звичайно, ми повинні продовжувати! Ці спогади належать мені, мандрівниче. Вони складають те, хто я є, ким я був. Вони є самою сутністю мого єства.",shape=box,color=blue];
		j2608359787 -> j1346101062;
		j2608359787 -> j357174972;
	j676564718 [label="Можливо, але це не суть того, про що я говорив. Ти уникаєш відповіді на це питання. Добре. Якби, теоретично, твоя пам’ять була втрачена, в тебе були б спроби її повернути?",shape=box,color=blue];
		j676564718 -> j1346101062;
		j676564718 -> j357174972;
	j414416510 [label="Якби в тебе була можливість повернути втрачені спогади, які б були твої дії?",shape=box,color=blue];
		j414416510 -> j1219515346;
		j414416510 -> j1346101062;
		j414416510 -> j357174972;
	j1687193116 [label="Якщо припустити, що ти мені не брешеш? Визнаю, що це досить приємно. Чарівно. Дуже сумно. Але приємно.",shape=box,color=blue];
		j1687193116 -> "Chat ends.";
	j2091562898 [label="Я з нетерпінням чекаю на наші розмови, незалежно від того, чи ти їх чекаєш, чи ні.",shape=box,color=red];
		j2091562898 -> j642925444;
	j547491427 [label="Я спробую не сприймати це особисто.",shape=box,color=red];
		j547491427 -> j3276080279;
	j410220997 [label="Або тобі просто подобається зі мною розмовляти?",shape=box,color=red];
		j410220997 -> j1672095311;
	j3142705590 [label="Добре сказано, мандрівниче. Я не зрозумію, наскільки великим було те, що у мене відібрали, доки не отримаю все назад. Ці спогади складають те, хто я є, ким я був. Вони є самою сутністю мого єства.",shape=box,color=blue];
		j3142705590 -> j1219515346;
		j3142705590 -> j1346101062;
		j3142705590 -> j357174972;
	j1346101062 [label="Я думаю, що краще знати, ніж не знати, але… ми маємо бути до цього готові.",shape=box,color=red];
		j1346101062 -> j3606652678;
	j357174972 [label="Іноді я думаю, що деякі речі повинні залишатися прихованими з певної причини.",shape=box,color=red];
		j357174972 -> j1741346155;
	j1219515346 [label="Це твоє. Настав час нам це забрати. Що може бути такого страшного? Ти ж орокін, ти робив і гірші речі, безперечно.",shape=box,color=red];
		j1219515346 -> j3431284862;
	j642925444 [label="Тоді я дуже радий, що не став слинявим ідіотом, після твоїх копирсань з виделкою в моїй голові.",shape=box,color=blue];
		j642925444 -> j3284677091;
	j3276080279 [label="Можливо, тобі варто. Адже це тобі належать копирсання з виделкою в моїй голові.",shape=box,color=blue];
		j3276080279 -> j3284677091;
	j1672095311 [label="Можливо, так би й було, якби я не знав про твої копирсання з виделкою в моїй голові.",shape=box,color=blue];
		j1672095311 -> j3284677091;
	j3606652678 [label="Готові, як саме? Невже ти віриш, що я розвалюся наче картковий будинок, коли я дізнаюся жахливу правду про якийсь гротескний військовий злочин?",shape=box,color=blue];
		j3606652678 -> j4251334121;
	j1741346155 [label="Хіба ми не приречені повторювати свої попередні помилки? Ніколи не вчитися, ніколи не розвиватися, назавжди жити в блаженному невіданні про наше колишнє «я»?",shape=box,color=blue];
		j1741346155 -> j396083355;
	j3431284862 [label="+10 Chemistry",color=orange];
		j3431284862 -> j3436834302;
	j3284677091 [label="Check boolean RoatheResetForgiven",color=orange];
		j3284677091 -> j4223624636 [label=true,color=green];
		j3284677091 -> j1691049714 [label=false,color=brown];
	j4251334121 [label="Повір, я можу уявити все, що міг зробити зі Свідомими, орокінами чи будь-якою фракцією, і мало що може мене шокувати чи жахати.",shape=box,color=blue];
		j4251334121 -> j378979034;
	j396083355 [label="Гм. Мабуть, я щойно навів аргумент проти власної думки для більшості людей, я розумію.",shape=box,color=blue];
		j396083355 -> j70795174;
	j3436834302 [label="Слухай! Навряд чи я розвалюся наче картковий будинок, коли дізнаюся жахливу правду про якийсь гротескний військовий злочин.",shape=box,color=blue];
		j3436834302 -> j2838566542;
	j4223624636 [label="Я сказав, що пробачив тобі. Та я намагаюся дотримуватися того, що тобі обіцяв. Просто іноді слова не роблять щось правдою. І сказати, що ти прощаєш когось, дуже приємно в теорії, але іноді емоції важко підкоряються фактам.",shape=box,color=blue];
		j4223624636 -> j363179674;
		j4223624636 -> j2608746815;
	j1691049714 [label="Справді, це все дуже дратує. Я хочу поговорити з тобою. Але я також хочу тебе задушити за те, що мій розум осквернений тобою.",shape=box,color=blue];
		j1691049714 -> j879437585;
		j1691049714 -> j469572100;
	j378979034 [label="Add 1 to Thermostat counter",color=orange];
		j378979034 -> j2840143721;
	j70795174 [label="Add -1 to Thermostat counter",color=orange];
		j70795174 -> j2314040073;
	j2838566542 [label="Add -2 to Thermostat counter",color=orange];
		j2838566542 -> j1402743759;
	j363179674 [label="Я розумію. Це важко прийняти, і ти намагаєшся цього хотіти, але не можеш.",shape=box,color=red];
		j363179674 -> j1139440011;
	j2608746815 [label="То ти… не пробачаєш мені?",shape=box,color=red];
		j2608746815 -> j1139440011;
	j879437585 [label="Тобі доведеться просто прийняти те, що сталося, і рухатися далі, Роуте.",shape=box,color=red];
		j879437585 -> j2874853658;
	j469572100 [label="Ти думаєш, що колись зможеш мене пробачити?",shape=box,color=red];
		j469572100 -> j2996165540;
	j2840143721 [label="Я пам’ятаю достатньо, щоб знати, що я міг би просити «прощення» біля вівтаря Світочів протягом наступних двох тисяч років, і ніколи б його не отримав. ",shape=box,color=blue];
		j2840143721 -> j4057953623;
	j2314040073 [label="Я б волів сам дізнатися всі факти та вже на їхній основі оцінити ситуацію.",shape=box,color=blue];
		j2314040073 -> j4057953623;
	j1402743759 [label="Я можу уявити все, що міг зробити зі Свідомими, орокінами чи будь-якою фракцією, і мало що може мене шокувати чи жахати.",shape=box,color=blue];
		j1402743759 -> j3343622478;
	j1139440011 [label="Я роблю все, що в моїх силах, узурпаторе. Бо в тобі є щось, що привернуло мою увагу. Ти зачаровуєш. А це рідкість у моєму світі.",shape=box,color=blue];
		j1139440011 -> j3799679832;
	j2874853658 [label="М-гм-м.",shape=box,color=blue];
		j2874853658 -> "Chat ends.";
	j2996165540 [label="Boolean RoatheResetForgiven is now true.",color=orange];
		j2996165540 -> j1139440011;
	j4057953623 [label="Ні, те, що чекає на мене в глибині моєї свідомості, мене не лякає. Я просто хочу повернути те, що було у мене несправедливо відібрано.",shape=box,color=blue];
		j4057953623 -> j117175807;
	j3343622478 [label="Ні, те, що чекає на мене в глибині моєї свідомості, мене не лякає. Я просто хочу повернути те, що було у мене несправедливо відібрано.",shape=box,color=blue];
		j3343622478 -> j3444578118;
	j3799679832 [label="Тож постався до цього терпляче, якщо можеш, поки я намагаюся все це осмислити.",shape=box,color=blue];
		j3799679832 -> j2019908599;
		j3799679832 -> j1917516623;
	j117175807 [label="+10 Chemistry",color=orange];
		j117175807 -> j465776558;
	j3444578118 [label="Як ти кажеш, настав час нам повернути те, що належить мені.",shape=box,color=blue];
		j3444578118 -> "Chat ends.";
	j2019908599 [label="Гаразд.",shape=box,color=red];
		j2019908599 -> j2817129071;
	j1917516623 [label="Це мені слід просити тебе про терпіння, Роуте. А не навпаки.",shape=box,color=red];
		j1917516623 -> j4288099474;
	j465776558 [label="Але я все одно ціную твою турботу.",shape=box,color=blue];
		j465776558 -> "Chat ends.";
