		1782 -> 1783 [label="false",color=purple];
	1786 [label="Це не дає мені спокою, день і ніч. Це постійне неприємне усвідомлення, що я не тільки довірив тобі всі свої найпотаємніші секрети, але ти зраджуєш мою довіру. Я лишився всього, а тепер я навіть не можу згадати чому…",shape=box,color=blue];
		1786 -> 1793;
	1785 [label="Ми досягаємо значного прогресу в просуванні моїми спогадами. Альбрехт добряче мене обдурив, коли ввів ту сироватку.",shape=box,color=blue];
		1785 -> 1791;
		1785 -> 1792;
		1785 -> 1790;
	1784 [label="Ти гальмуєш прогрес у допомозі мені розкрити мої спогади. Якщо ти збираєшся дотримуватися своєї частини угоди, я очікую, що ти продовжиш свою роботу в «Спуску».",shape=box,color=blue];
		1784 -> 1789;
		1784 -> 1787;
		1784 -> 1788;
		1784 -> 1790;
	1783 [label="Тобою не досягнуто жодного прогресу у розкритті моїх спогадів у «Спуску». Якщо ти хочеш, щоб я дотримався своєї частини угоди, тобі доведеться докласти зусиль для дотримання своєї.",shape=box,color=blue];
		1783 -> 1787;
		1783 -> 1788;
		1783 -> 1789;
		1783 -> 1790;
	1793 [label="Check boolean RoatheResetForgiven",color=orange];
		1793 -> 1801 [label=true,color=green];
		1793 -> 1800 [label=false,color=brown];
	1791 [label="Вони не здаються приємними. ",shape=box,color=red];
		1791 -> 1798;
	1792 [label="Вони не здаються приємними. Ти впевнений, що нам слід продовжувати?",shape=box,color=red];
		1792 -> 1799;
	1790 [label="[Завершити розмову]",shape=box,color=red];
		1790 -> 1797;
	1789 [label="Чесно кажучи, я трохи борюся з цим… Я постійно гину попри всі мої зусилля.",shape=box,color=red];
		1789 -> 1796;
	1787 [label="Я не виконую твоїх наказів, Роуте.",shape=box,color=red];
		1787 -> 1794;
	1788 [label="У мене були справи. Я займуся цим.",shape=box,color=red];
		1788 -> 1795;
	1801 [label="Я не лише пробачив тобі за те, що залишився без цих спогадів…",shape=box,color=blue];
		1801 -> 1807;
	1800 [label="Я не лише починаю прощати тебе за те, що залишився без цих спогадів…",shape=box,color=blue];
		1800 -> 1807;
	1798 [label="Ні. Вони неприємні. Чого ти очікуєш від «диявола Тау»? Спогадів про сонячний день у парку, який я провів лежачи на ковдрі та поїдаючи виноград?",shape=box,color=blue];
		1798 -> 1805;
	1799 [label="Я не дізнаюся, що він у мене забрав, поки не отримаю все назад. Звичайно, ми повинні продовжувати! Ці спогади належать мені, мандрівниче. Вони складають те, хто я є, ким я був. Вони є самою сутністю мого єства.",shape=box,color=blue];
		1799 -> 1806;
	1797 [label="Chat ends.",color=orange];
	1796 [label="Update boolean RoatheStrugglebus",color=orange];
		1796 -> 1804;
	1794 [label="Ні, не виконуєш. І мені байдуже, як ти проводиш свій день. Я лише кажу, якщо ти хочеш, щоби той худорлявий маленький дворецький піднявся нагору, тобі потрібно виконати свою роботу.",shape=box,color=blue];
		1794 -> 1802;
	1795 [label="Як тобі заманеться. Мені байдуже, як ти проводиш свій день. Я лише кажу, якщо ти хочеш, щоби той худорлявий маленький дворецький піднявся нагору, тобі потрібно виконати свою роботу.",shape=box,color=blue];
		1795 -> 1803;
	1807 [label="Але я починаю відчувати, що хочу знову тобі довіряти. Знову! Добре знаючи, що сталося. Знаючи, що ти можеш просто зрадити мене ще раз!",shape=box,color=blue];
		1807 -> 1815;
	1805 [label="Мій бідний узурпаторе, боюся, що все, що ми знайдемо в скрижалях моєї пам’яті, буде лише кров, поля трупів і невдачі.",shape=box,color=blue];
		1805 -> 1811;
		1805 -> 1812;
	1806 [label="З того, що мені відомо від інших про твоє перебування в Дувірі, в тебе були ті самі проблеми, чи не так?",shape=box,color=blue];
		1806 -> 1813;
		1806 -> 1814;
	1804 [label="Я постійно чую про твої успіхи в перемозі над Нармером. Над ґрінерами. Над хвилями Шепоту на кожному кроці. Та все ж мені вдалося збити тебе з пантелику?",shape=box,color=blue];
		1804 -> 1810;
	1802 [label="Якщо тобі байдуже. Тоді мені теж. У мене є свої справи.",shape=box,color=blue];
		1802 -> 1808;
	1803 [label="Якщо тобі байдуже. Тоді мені теж. У мене є свої справи.",shape=box,color=blue];
		1803 -> 1809;
	1815 [label="Але я сиджу в цій крипті, встаю з крісла та думаю: «цікаво, чи є тут мандрівник, чи має бажання поговорити».",shape=box,color=blue];
		1815 -> 1822;
	1811 [label="Ти керуєш цим кораблем. Якщо ти хочеш продовжувати летіти в чорну діру, то вперед на повній швидкості.",shape=box,color=red];
		1811 -> 1818;
	1812 [label="Ти впевнений, що хочеш продовжувати?",shape=box,color=red];
		1812 -> 1819;
	1813 [label="Ми дуже різні люди, Роуте.",shape=box,color=red];
		1813 -> 1820;
	1814 [label="Були. Спогади та апатія. Я досі не можу згадати… цілі проміжки часу, що там були.",shape=box,color=red];
		1814 -> 1821;
	1810 [label="+20 Chemistry",color=orange];
		1810 -> 1817;
	1808 [label="Chat ends.",color=orange];
	1809 [label="+10 Chemistry",color=orange];
		1809 -> 1816;
	1822 [label="Як це жалюгідно! Як низько я впав? Я?! Орокін?! Роут! Диявол Тау! Такий невгамовний, такий інтелектуально зголоднілий, такий відчайдушний у пошуках будь-якого заохочення, що я тут, розмовляю з тобою!",shape=box,color=blue];
		1822 -> 1831;
		1822 -> 1830;
		1822 -> 1829;
		1822 -> 1828;
	1818 [label="+10 Chemistry",color=orange];
		1818 -> 1824;
	1819 [label="Я не дізнаюся, що він у мене забрав, поки не отримаю все назад. Звичайно, ми повинні продовжувати! Ці спогади належать мені, мандрівниче. Вони складають те, хто я є, ким я був. Вони є самою сутністю мого єства.",shape=box,color=blue];
		1819 -> 1825;
		1819 -> 1826;
	1820 [label="Можливо, але це не суть того, про що я говорив. Ти уникаєш відповіді на це питання. Добре. Якби, теоретично, твоя пам’ять була втрачена, в тебе були б спроби її повернути?",shape=box,color=blue];
		1820 -> 1825;
		1820 -> 1826;
	1821 [label="Якби в тебе була можливість повернути втрачені спогади, які б були твої дії?",shape=box,color=blue];
		1821 -> 1827;
		1821 -> 1825;
		1821 -> 1826;
	1817 [label="Якщо припустити, що ти мені не брешеш? Визнаю, що це досить приємно. Чарівно. Дуже сумно. Але приємно.",shape=box,color=blue];
		1817 -> 1823;
	1816 [label="Chat ends.",color=orange];
	1831 [label="Я з нетерпінням чекаю на наші розмови, незалежно від того, чи ти їх чекаєш, чи ні.",shape=box,color=red];
		1831 -> 1838;
	1830 [label="Я спробую не сприймати це особисто.",shape=box,color=red];
		1830 -> 1837;
	1829 [label="Або тобі просто подобається зі мною розмовляти?",shape=box,color=red];
		1829 -> 1836;
	1828 [label="[Завершити розмову]",shape=box,color=red];
		1828 -> 1835;
	1824 [label="Добре сказано, мандрівниче. Я не зрозумію, наскільки великим було те, що у мене відібрали, доки не отримаю все назад. Ці спогади складають те, хто я є, ким я був. Вони є самою сутністю мого єства.",shape=box,color=blue];
		1824 -> 1827;
		1824 -> 1825;
		1824 -> 1826;
	1825 [label="Я думаю, що краще знати, ніж не знати, але… ми маємо бути до цього готові.",shape=box,color=red];
		1825 -> 1832;
	1826 [label="Іноді я думаю, що деякі речі повинні залишатися прихованими з певної причини.",shape=box,color=red];
		1826 -> 1833;
	1827 [label="Це твоє. Настав час нам це забрати. Що може бути такого страшного? Ти ж орокін, ти робив і гірші речі, безперечно.",shape=box,color=red];
		1827 -> 1834;
	1823 [label="Chat ends.",color=orange];
	1838 [label="Тоді я дуже радий, що не став слинявим ідіотом, після твоїх копирсань з виделкою в моїй голові.",shape=box,color=blue];
		1838 -> 1842;
	1837 [label="Можливо, тобі варто. Адже це тобі належать копирсання з виделкою в моїй голові.",shape=box,color=blue];
		1837 -> 1842;
	1836 [label="Можливо, так би й було, якби я не знав про твої копирсання з виделкою в моїй голові.",shape=box,color=blue];
		1836 -> 1842;
	1835 [label="Chat ends.",color=orange];
	1832 [label="Готові, як саме? Невже ти віриш, що я розвалюся наче картковий будинок, коли я дізнаюся жахливу правду про якийсь гротескний військовий злочин?",shape=box,color=blue];
		1832 -> 1839;
	1833 [label="Хіба ми не приречені повторювати свої попередні помилки? Ніколи не вчитися, ніколи не розвиватися, назавжди жити в блаженному невіданні про наше колишнє «я»?",shape=box,color=blue];
		1833 -> 1840;
