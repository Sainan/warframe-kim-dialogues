	1845 [label="Add -2 to Thermostat",color=orange];
		1845 -> 1850;
	1851 [label="Я розумію. Це важко прийняти, і ти намагаєшся цього хотіти, але не можеш.",shape=box,color=red];
		1851 -> 1857;
	1852 [label="То ти… не пробачаєш мені?",shape=box,color=red];
		1852 -> 1857;
	1853 [label="Тобі доведеться просто прийняти те, що сталося, і рухатися далі, Роуте.",shape=box,color=red];
		1853 -> 1858;
	1854 [label="Ти думаєш, що колись зможеш мене пробачити?",shape=box,color=red];
		1854 -> 1859;
	1848 [label="Я пам’ятаю достатньо, щоб знати, що я міг би просити «прощення» біля вівтаря Світочів протягом наступних двох тисяч років, і ніколи б його не отримав. ",shape=box,color=blue];
		1848 -> 1855;
	1849 [label="Я б волів сам дізнатися всі факти та вже на їхній основі оцінити ситуацію.",shape=box,color=blue];
		1849 -> 1855;
	1850 [label="Я можу уявити все, що міг зробити зі Свідомими, орокінами чи будь-якою фракцією, і мало що може мене шокувати чи жахати.",shape=box,color=blue];
		1850 -> 1856;
	1857 [label="Я роблю все, що в моїх силах, узурпаторе. Бо в тобі є щось, що привернуло мою увагу. Ти зачаровуєш. А це рідкість у моєму світі.",shape=box,color=blue];
