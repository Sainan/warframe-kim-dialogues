		1842 -> 1847 [label=false,color=brown];
	1839 [label="Повір, я можу уявити все, що міг зробити зі Свідомими, орокінами чи будь-якою фракцією, і мало що може мене шокувати чи жахати.",shape=box,color=blue];
		1839 -> 1843;
	1840 [label="Гм. Мабуть, я щойно навів аргумент проти власної думки для більшості людей, я розумію.",shape=box,color=blue];
		1840 -> 1844;
	1841 [label="Слухай! Навряд чи я розвалюся наче картковий будинок, коли дізнаюся жахливу правду про якийсь гротескний військовий злочин.",shape=box,color=blue];
		1841 -> 1845;
	1846 [label="Я сказав, що пробачив тобі. Та я намагаюся дотримуватися того, що тобі обіцяв. Просто іноді слова не роблять щось правдою. І сказати, що ти прощаєш когось, дуже приємно в теорії, але іноді емоції важко підкоряються фактам.",shape=box,color=blue];
		1846 -> 1851;
		1846 -> 1852;
	1847 [label="Справді, це все дуже дратує. Я хочу поговорити з тобою. Але я також хочу тебе задушити за те, що мій розум осквернений тобою.",shape=box,color=blue];
		1847 -> 1853;
		1847 -> 1854;
