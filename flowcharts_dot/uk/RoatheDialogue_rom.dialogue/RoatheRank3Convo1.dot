digraph {
	1333 [label="RoatheRank3Convo1 begins.",color=orange];
		1333 -> 1334;
	1334 [label="Ти нарешті розмовляєш з нашим дорогим Ліоном? Чи він досі ставиться до тебе з прохолодою? Чесно кажучи, тобі краще триматися від нього якнайдалі.",shape=box,color=blue];
		1334 -> 1337;
		1334 -> 1336;
		1334 -> 1335;
	1337 [label="Ти з ним не ладнаєш?",shape=box,color=red];
		1337 -> 1340;
	1336 [label="Якби ти був трохи добрішим до Марі та Ліона, вони б могли бути добрішими до тебе.",shape=box,color=red];
		1336 -> 1339;
	1335 [label="[Завершити розмову]",shape=box,color=red];
		1335 -> 1338;
	1340 [label="Я б краще з ним «ладнав», якби він намагався трохи краще зрозуміти, хто я і звідки родом. Я той, хто я є. І так було протягом багатьох століть. Я не збираюся змінюватися тільки тому, що вони цього вимагають зараз.",shape=box,color=blue];
		1340 -> 1341;
	1339 [label="А як щодо їхньої доброти до мене, узурпаторе? Я той, хто я є. І так було протягом багатьох століть. Я не збираюся змінюватися тільки тому, що вони цього вимагають зараз.",shape=box,color=blue];
		1339 -> 1341;
	1338 [label="Chat ends.",color=orange];
	1341 [label="Evaluate expressions on HellStory",color=orange];
		1341 -> 1343 [label="x >= 21",color=purple];
		1341 -> 1342 [label="x < 21",color=purple];
		1341 -> 1342 [label="false",color=purple];
	1343 [label="Можливо, я добровільно прийняв цю сироватку, але я точно знаю, що не погоджувався на те, щоб ці двоє невдячних людей постійно мені докоряли.  ",shape=box,color=blue];
		1343 -> 1344;
	1342 [label="Це Альбрехт винен, що я такий! Це його вина, що я тут застряг із ними, а не моя! Я не мав нічого спільного з цією огидною угодою!",shape=box,color=blue];
		1342 -> 1344;
	1344 [label="Вони можуть подавати свої скарги своєму дорогоцінному «кардиналу», а не мені.",shape=box,color=blue];
		1344 -> 1345;
		1344 -> 1346;
		1344 -> 1347;
	1345 [label="Вони мають добрі наміри, навіть якщо діють не найкращим чином.",shape=box,color=red];
		1345 -> 1348;
	1346 [label="Хіба тобі не здається, що тобі потрібно прощення за те, що ти зробив?",shape=box,color=red];
		1346 -> 1349;
	1347 [label="Вони просто намагаються тобі допомогти.",shape=box,color=red];
		1347 -> 1350;
	1348 [label="Add -1 to Thermostat",color=orange];
		1348 -> 1351;
	1349 [label="Add 1 to Thermostat",color=orange];
		1349 -> 1352;
	1350 [label="«Допомогти». Так. «Допомогти». Вибач, але я вважаю їхній стиль «допомоги» глибоко «некорисним».",shape=box,color=blue];
		1350 -> 1353;
	1351 [label="Так, і в цьому і є вся трагедія. Вони щиро вірять, що намагаються робити «добро».",shape=box,color=blue];
		1351 -> 1354;
	1352 [label="Прощення ким? Тобою? Ними? Дворецьким? Альбрехтом? Або «богами»?",shape=box,color=blue];
		1352 -> 1355;
		1352 -> 1356;
		1352 -> 1357;
	1353 [label="Насправді я вважав би за «допомогу», якби вони замінили моє вино на їдку речовину, узурпаторе.",shape=box,color=blue];
		1353 -> 1358;
	1354 [label="І як ти думаєш? Ти вважаєш, що я потребую якоїсь «великої спокути»? Якогось «святого прощення»?",shape=box,color=blue];
		1354 -> 1359;
	1355 [label="Ти пропустив важливий пункт у цьому списку.",shape=box,color=red];
		1355 -> 1360;
	1356 [label="Ти — орокін. Ти скоїв звірства під час війни та через природу свого суспільства. Тобі є за що покаятися.",shape=box,color=red];
		1356 -> 1361;
	1357 [label="Хіба ти хоча б не визнаєш, що у своєму житті робив жахливі речі?",shape=box,color=red];
		1357 -> 1362;
	1358 [label="Це було б принаймні ефективніше.",shape=box,color=blue];
		1358 -> 1363;
	1359 [label="Evaluate expressions",color=orange];
		1359 -> 1364 [label="RoatheTraitor2",color=purple];
		1359 -> 1365 [label="RoatheTraitor2",color=purple];
		1359 -> 1366 [label="RoatheTraitor2",color=purple];
		1359 -> 1367 [label="RoatheTraitor2",color=purple];
		1359 -> 1364 [label="RoatheTraitor1",color=purple];
		1359 -> 1365 [label="RoatheTraitor1",color=purple];
		1359 -> 1366 [label="RoatheTraitor1",color=purple];
		1359 -> 1367 [label="RoatheTraitor1",color=purple];
		1359 -> 1364 [label="RoatheExecutor2",color=purple];
		1359 -> 1365 [label="RoatheExecutor2",color=purple];
		1359 -> 1366 [label="RoatheExecutor2",color=purple];
		1359 -> 1367 [label="RoatheExecutor2",color=purple];
		1359 -> 1364 [label="false",color=purple];
		1359 -> 1365 [label="false",color=purple];
		1359 -> 1366 [label="false",color=purple];
	1360 [label="Благаю, скажи. ",shape=box,color=blue];
		1360 -> 1368;
		1360 -> 1369;
		1360 -> 1370;
	1361 [label="Я не буду вибачатися за суспільство орокінів, оскільки я не був його творцем. Лише його мешканцем. А якщо звинувачувати всіх, хто був частиною системи, в якій вони опинилися просто тому, що народилися в ній, тоді потрібно засудити мільярди людей своєю гордовитою самоправедністю. А що стосується решти?",shape=box,color=blue];
		1361 -> 1371;
	1362 [label="І що, як зробив? Зараз я вже не можу їх змінити. Який сенс відчувати провину?",shape=box,color=blue];
		1362 -> 1372;
		1362 -> 1373;
	1363 [label="Хоча мушу зізнатися, між ними двома я віддаю перевагу священнику. Він прислухається до розуму. Він може просто прийти до висновку, що Байдужість не є справжнім богом.",shape=box,color=blue];
		1363 -> 1374;
	1364 [label="Я дійсно вважаю, що варто задуматися над нашими вчинками, які завдали шкоди людям, і спробувати зрозуміти, як їх виправити. Але я не думаю, що ці двоє роблять це правильно.",shape=box,color=red];
		1364 -> 1375;
	1365 [label="Я не вірю в необхідність прощати когось, окрім себе самого, зрештою. Якщо ти задоволений своїми вчинками? Нехай буде так.",shape=box,color=red];
		1365 -> 1376;
	1366 [label="Ти народився в суспільстві, де поведінка орокінів була просто… нормальною. Очікуваною. Для тебе це не було чимось «поганим». Я не кажу, що це робить її прийнятною, просто зрозумілою.",shape=box,color=red];
		1366 -> 1377;
	1367 [label="Ти намагався скинути орокінів. Ти знав, що вони зіпсовані, та намагався їх виправити.",shape=box,color=red];
		1367 -> 1378;
	1368 [label="Себе.",shape=box,color=red];
		1368 -> 1379;
	1369 [label="Свій власний народ, який ти збирався зрадити.",shape=box,color=red];
		1369 -> 1380;
	1370 [label="Свідомі, яких ти винищив.",shape=box,color=red];
		1370 -> 1371;
	1371 [label="Це була війна. І в природі війни лежить вбивство тих, проти кого ти воюєш, у великій кількості. Ти ж не плачеш за ґрінерами чи корпусівцями, яких убиваєш?",shape=box,color=blue];
		1371 -> 1381;
		1371 -> 1382;
		1371 -> 1383;
	1372 [label="Прощення від інших важливе.",shape=box,color=red];
		1372 -> 1384;
	1373 [label="Ти можеш змінитися в майбутньому.",shape=box,color=red];
		1373 -> 1385;
	1374 [label="Уяви собі, я ще можу переконати його розібратися у всій своїй релігії. Людина, яка бачить химерні та криваві галюцинації, але також має здоровий глузд і логіку. Яка рідкість.",shape=box,color=blue];
		1374 -> 1386;
		1374 -> 1387;
	1375 [label="Гм. Зрозуміло. Ти заперечуєш не дії, а методики. Цим я відкликаю своє попереднє схвалення й замінюю його на занепокоєння.",shape=box,color=blue];
		1375 -> 1388;
	1376 [label="Update boolean RoatheVillainSelf",color=orange];
		1376 -> 1389;
	1377 [label="Update boolean RoatheVillainOrokin",color=orange];
		1377 -> 1389;
	1378 [label="Тож я думаю, навіть якщо ти планував переробити систему на свій лад, ти знав, що вона має змінитися.",shape=box,color=red];
		1378 -> 1390;
		1378 -> 1391;
	1379 [label="Check boolean RoatheKnowsReset2",color=orange];
		1379 -> 1392 [label=true,color=green];
		1379 -> 1393 [label=false,color=brown];
	1380 [label="Я не мав жодної безсонної ночі через почуття провини за зраду свого народу, узурпаторе. Повір мені.",shape=box,color=blue];
		1380 -> 1394;
	1381 [label="Ні. Але зі Свідомими ситуація інша.",shape=box,color=red];
		1381 -> 1395;
	1382 [label="Так, плачу.",shape=box,color=red];
		1382 -> 1396;
	1383 [label="Як я ставлюся до життів, які мені доводиться забирати, це моя особиста справа. Ми говоримо про тебе.",shape=box,color=red];
		1383 -> 1397;
	1384 [label="Чому? Щоб я залишився сам? Щоб я не був якимось… проклятим? Якимось соціальним ізгоєм? ",shape=box,color=blue];
		1384 -> 1398;
	1385 [label="Вчитися на своїх помилках – це ключовий момент, так. Але не потрібно відчувати «провину», щоб зрозуміти «невдачу».",shape=box,color=blue];
		1385 -> 1399;
	1386 [label="Ліон, здається, має достатньо власних проблем, чи не так?",shape=box,color=red];
		1386 -> 1400;
	1387 [label="Вибач, що зробити?",shape=box,color=red];
		1387 -> 1401;
	1388 [label="Chat ends.",color=orange];
	1389 [label="Твій контекст відрізняється від нашого. І те, що ми вважаємо жорстоким і жахливим, тебе виховували бачити як ще одну частину того, як влаштований світ.",shape=box,color=red];
		1389 -> 1402;
	1390 [label="Це все одно не виправдовує все, що ти зробив — спотворення є спотвореннями, а жахи залишаються жахами. Але ти намагався.",shape=box,color=red];
		1390 -> 1403;
	1391 [label="На мій погляд, ти перебував у стані війни та намагався орієнтуватися в суспільстві соціопатів, одночасно плануючи його повалення. І за це вони назвали тебе дияволом. Я не думаю, що це справедливо.",shape=box,color=red];
		1391 -> 1404;
	1392 [label="За втечу.",shape=box,color=red];
		1392 -> 1405;
	1393 [label="За невдачу.",shape=box,color=red];
		1393 -> 1405;
	1394 [label="Я не буду вибачатися за орокінську імперію, оскільки я не був її творцем, лише її мешканцем. Але я також не буду брати на себе провину за те, що планував зруйнувати її. Ми заслужили те, що отримали, і навіть гірше.",shape=box,color=blue];
		1394 -> 1406;
	1395 [label="Кожна ситуація є «іншою ситуацією», узурпаторе. Контекст завжди має ключове значення. А ти просто дивишся на Давню війну з ясністю ретроспективи.",shape=box,color=blue];
		1395 -> 1407;
	1396 [label="У такому разі мені тебе безмежно шкода, узурпаторе, і я пропоную тобі або змиритися з тим, що тобі доручено робити, або покинути таке життя та зайнятися фермерством.",shape=box,color=blue];
		1396 -> 1408;
	1397 [label="М-м. Мені подобається, коли ти так явно показуєш, що я наступив на хворий мозоль, це так чудово приємно. Ти погано змінюєш тему розмови.",shape=box,color=blue];
		1397 -> 1409;
	1398 [label="Подивися на мене, узурпаторе. Подивися, хто я є. Орокін, вигнаний зі своєї імперії.",shape=box,color=blue];
		1398 -> 1410;
	1399 [label="І в чому, зрештою, сенс прощення? Від кого я повинен прагнути прощення? Від інших? Щоб не стати якимось проклятим?",shape=box,color=blue];
		1399 -> 1398;
	1400 [label="І саме в цьому я хотів йому допомогти! Я лише намагаюся допомогти йому розібратися в його сумнівах щодо того, що таке Байдужість і що йому сказав Ентраті.",shape=box,color=blue];
		1400 -> 1411;
	1401 [label="Абсолютно нічого шкідливого, незалежно від того що тобі може надзижчати надокучливий комар. Я лише намагаюся допомогти йому розібратися в його сумнівах щодо того, що таке Байдужість і що йому сказав Ентраті.",shape=box,color=blue];
		1401 -> 1411;
	1402 [label="+10 Chemistry",color=orange];
		1402 -> 1412;
	1403 [label="Update boolean RoatheVillainOrokin",color=orange];
		1403 -> 1402;
	1404 [label="Update boolean RoatheVillainShortcut",color=orange];
		1404 -> 1413;
	1405 [label="Update boolean RoatheForgivenessShortcut",color=orange];
		1405 -> 1414;
	1406 [label="Якщо є щось, за що я відчуваю провину, то це те, що тенно були відповідальні за спалення всього до тла, а не я.",shape=box,color=blue];
		1406 -> 1415;
	1407 [label="Якщо ти будеш судити про вчинки людей у минулому, маючи всю інформацію, отриману в майбутньому, ти завжди будеш відчувати провину.",shape=box,color=blue];
		1407 -> 1416;
	1408 [label="Хоча це було б ганьбою. Дивитися на твою роботу — справжнє задоволення. Не надто ефективно, але надзвичайно цікаво.",shape=box,color=blue];
		1408 -> 1417;
	1409 [label="Хоча, мабуть, провівши століття на самоті, не маючи з ким поговорити, крім вигаданих персонажів власної уяви, людина обмежує можливості вдосконалити свої соціальні навички.",shape=box,color=blue];
		1409 -> 1418;
	1410 [label="Я був «Дияволом Тау» у свій час. А тут я вже «диявол» для всіх, хто мене зустрічає.",shape=box,color=blue];
		1410 -> 1419;
	1411 [label="Ентраті сказав йому, що його «видіння» були результатом дії не Луа, а Байдужості. Це привело його до певної «кризи віри».",shape=box,color=blue];
		1411 -> 1420;
	1412 [label="Як приємно усвідомлювати, що поняття нюансів і тонкощів все-таки не зникло. Так, ти маєш рацію. Я — продукт іншої епохи, іншого часу, іншого суспільства.",shape=box,color=blue];
		1412 -> 1421;
	1413 [label="+20 Chemistry",color=orange];
		1413 -> 1422;
	1414 [label="+10 Chemistry",color=orange];
		1414 -> 1423;
	1415 [label="Update boolean RoatheForgivenessNoGuilt",color=orange];
		1415 -> 1424;
	1416 [label="Прийми те, що сталося в минулому, та рухайся далі.",shape=box,color=blue];
		1416 -> 1425;
	1417 [label="Ти робиш поле бою «цікавим», якщо не більше. ",shape=box,color=blue];
		1417 -> 1425;
	1418 [label="Іди потренуйся зі священником, вам обом потрібна практика. ",shape=box,color=blue];
		1418 -> 1426;
	1419 [label="Альбрехт вважав за доцільне забезпечити постійність цього прізвиська. ",shape=box,color=blue];
		1419 -> 1425;
	1420 [label="Однак я намагаюся переконати його, що це не так, і що їх не послав «бог», оскільки «богів» не існує. Він просто хворий.",shape=box,color=blue];
		1420 -> 1427;
		1420 -> 1428;
	1421 [label="Однак я міг розпізнати жорстокість і спотворення мого народу такими, якими вони були насправді. Була така ницість, до якої опустилися багато хто з моїх побратимів, що навіть я не міг цього стерпіти.",shape=box,color=blue];
		1421 -> 1429;
	1422 [label="Я знав, що ти мені подобаєшся не просто так, узурпаторе. Нарешті! Хтось, хто мене цінує! Скільки на це пішло… століть?!",shape=box,color=blue];
		1422 -> 1430;
	1423 [label="Chat ends.",color=orange];
	1424 [label="+10 Chemistry",color=orange];
		1424 -> 1431;
	1425 [label="Ось моя порада тобі: позбудься у своєму серці почуття провини за свої вчинки, як це зробив я. Встроми ножа в груди, поки воно не помре.",shape=box,color=blue];
		1425 -> 1432;
	1426 [label="+5 Chemistry",color=orange];
		1426 -> 1433;
	1427 [label="Хіба Ліон потребує твоєї допомоги?",shape=box,color=red];
		1427 -> 1434;
	1428 [label="І ти думаєш, що це покращить його становище?",shape=box,color=red];
		1428 -> 1435;
	1429 [label="Але такі питання є… складними. І я ціную те, що ти це розумієш. Та. Дворецький дивиться на мене. Мені потрібно завершувати розмову. Ми скоро знову поговоримо.",shape=box,color=blue];
		1429 -> 1436;
	1430 [label="Та. Дворецький дивиться на мене. Мені потрібно завершувати розмову. Ми скоро знову поговоримо.",shape=box,color=blue];
		1430 -> 1437;
	1431 [label="Chat ends.",color=orange];
	1432 [label="Почуття провини – це ніщо інше, як зрадник уночі, який позбавляє тебе всього, що тобі дороге. Воно приносить тобі лише шкоду.",shape=box,color=blue];
		1432 -> 1438;
	1433 [label="Chat ends.",color=orange];
	1434 [label="Він не відмовився слухати. Він не сказав мені замовкнути. Я б припинив, якби він мені сказав.",shape=box,color=blue];
		1434 -> 1439;
	1435 [label="Чи краще для релігійних фанатиків маніпулювати ним тільки тому, що вони можуть це робити? Вказувати на його галюцинації та називати їх «видіннями» замість того, щоб допомогти йому?",shape=box,color=blue];
		1435 -> 1440;
	1436 [label="Chat ends.",color=orange];
	1437 [label="Chat ends.",color=orange];
	1438 [label="Update boolean RoatheForgivenessNoGuilt",color=orange];
		1438 -> 1441;
	1439 [label="Мене дратує, коли люди навколо Ліона використовують його й маніпулюють ним, незалежно від того, чи усвідомлюють вони це. Усе в ім’я «релігії» та «віри».",shape=box,color=blue];
		1439 -> 1440;
	1440 [label="Я читав звіти про те, що сталося. Ця… «Багряна Вуаль» могла намагатися повернути того тенно з його Гарроу протягом усіх цих століть. Але вони цього не зробили. Вони дозволили йому змарніти та померти.",shape=box,color=blue];
		1440 -> 1442;
	1441 [label="+10 Chemistry",color=orange];
		1441 -> 1443;
	1442 [label="Чому? В ім’я захисту від якогось… теоретичного «Бога Порожнечі».",shape=box,color=blue];
		1442 -> 1444;
		1442 -> 1445;
	1443 [label="Chat ends.",color=orange];
	1444 [label="Ти думаєш, що жертва Релла була марною?",shape=box,color=red];
		1444 -> 1446;
	1445 [label="Релл був єдиним, хто стримував цю штуку всі ці роки.",shape=box,color=red];
		1445 -> 1447;
	1446 [label="Ні. Він захищав від чогось. Але хто знає, наскільки він погіршив ситуацію? Хто знає, скільки він підживлював її собою, своїм страхом і тривогами протягом усіх цих століть?",shape=box,color=blue];
		1446 -> 1448;
	1447 [label="Або він був єдиним, хто годував її всі ці роки.",shape=box,color=blue];
		1447 -> 1448;
	1448 [label="Концептуальне втілення проявляє лише те, з чого його давно створили. А Порожнеча може працювати тільки з тією тканиною, яку їй дають для шиття.",shape=box,color=blue];
		1448 -> 1449;
	1449 [label="Цікаво, скільки ж один тенно вклав у його створення? Він був справжнім бенкетом агонії, болю, зради, смутку… Самотності…",shape=box,color=blue];
		1449 -> 1450;
	1450 [label="І заціпеніння, яке, мабуть, супроводжувало тисячі років, які він провів на самоті в тому місці, розмовляючи з Нічим. Що ж може бути наслідком цього, як не Байдужість?",shape=box,color=blue];
		1450 -> 1451;
		1450 -> 1452;
	1451 [label="Можливо, те, що ти кажеш, правда. Я просто… не знаю, чи це так. І я не знаю, чи це не так.",shape=box,color=red];
		1451 -> 1453;
	1452 [label="Вона була могутньою ще до того, як дісталася до Релла. Він не пожертвував би собою без вагомої причини.",shape=box,color=red];
		1452 -> 1454;
	1453 [label="+10 Chemistry",color=orange];
		1453 -> 1455;
	1454 [label="Так само як і дитячі кошмари. Для шестирічної дитини вони є наймогутнішими істотами у всесвіті. Але для дорослої людини вони лише хмара пилу, що застрягла у вентиляції та дрейфує до світла.",shape=box,color=blue];
		1454 -> 1456;
	1455 [label="Я не думаю, що можу просити про щось більше, ніж просто визнати, що ти не знаєш напевне, з чим ми маємо справу.",shape=box,color=blue];
		1455 -> 1457;
	1456 [label="Ми робимо з мухи слона просто тому, що нам потрібна причина, щоб бути нещасними та руйнувати себе.",shape=box,color=blue];
		1456 -> 1458;
	1457 [label="Це чудове відправна точка. І чудова риса, якою повинен володіти кожен: проста здатність просто сказати… «я не знаю».",shape=box,color=blue];
		1457 -> 1459;
	1458 [label="Людство в одному погляді.",shape=box,color=blue];
		1458 -> 1460;
	1459 [label="Якби ми, орокіни, могли час від часу роби те саме, можливо, ми б вижили.",shape=box,color=blue];
		1459 -> 1460;
	1460 [label="Update boolean RoatheMITW3",color=orange];
		1460 -> 1461;
