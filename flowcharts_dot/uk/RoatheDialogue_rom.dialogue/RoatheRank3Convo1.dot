digraph {
	graph [fontname="Roboto Condensed"];
	node [fontname="Roboto Condensed"];
	edge [fontname="Roboto Condensed"];

	"RoatheRank3Convo1 begins." [color=orange];
		"RoatheRank3Convo1 begins." -> j2913668190;
	j2913668190 [label="Ти нарешті розмовляєш з нашим дорогим Ліоном? Чи він досі ставиться до тебе з прохолодою? Чесно кажучи, тобі краще триматися від нього якнайдалі.",shape=box,color=blue];
		j2913668190 -> j2725564657;
		j2913668190 -> j2498873307;
		j2913668190 -> j1478915251;
	j2725564657 [label="Ти з ним не ладнаєш?",shape=box,color=red];
		j2725564657 -> j3081886201;
	j2498873307 [label="Якби ти був трохи добрішим до Марі та Ліона, вони б могли бути добрішими до тебе.",shape=box,color=red];
		j2498873307 -> j4230006591;
	j1478915251 [label="[Завершити розмову]",shape=box,color=red];
		j1478915251 -> "Chat ends.";
	j3081886201 [label="Я б краще з ним «ладнав», якби він намагався трохи краще зрозуміти, хто я і звідки родом. Я той, хто я є. І так було протягом багатьох століть. Я не збираюся змінюватися тільки тому, що вони цього вимагають зараз.",shape=box,color=blue];
		j3081886201 -> j3060654953;
	j4230006591 [label="А як щодо їхньої доброти до мене, узурпаторе? Я той, хто я є. І так було протягом багатьох століть. Я не збираюся змінюватися тільки тому, що вони цього вимагають зараз.",shape=box,color=blue];
		j4230006591 -> j3060654953;
	"Chat ends." [color=orange];
	j3060654953 [label="Evaluate expressions on HellStory counter",color=orange];
		j3060654953 -> j2767488064 [label="x >= 21",color=purple];
		j3060654953 -> j1747386068 [label="x < 21",color=purple];
		j3060654953 -> j1747386068 [label="false",color=purple];
	j2767488064 [label="Можливо, я добровільно прийняв цю сироватку, але я точно знаю, що не погоджувався на те, щоб ці двоє невдячних людей постійно мені докоряли.  ",shape=box,color=blue];
		j2767488064 -> j3851990264;
	j1747386068 [label="Це Альбрехт винен, що я такий! Це його вина, що я тут застряг із ними, а не моя! Я не мав нічого спільного з цією огидною угодою!",shape=box,color=blue];
		j1747386068 -> j3851990264;
	j3851990264 [label="Вони можуть подавати свої скарги своєму дорогоцінному «кардиналу», а не мені.",shape=box,color=blue];
		j3851990264 -> j3232552294;
		j3851990264 -> j3709201572;
		j3851990264 -> j1388212370;
	j3232552294 [label="Вони мають добрі наміри, навіть якщо діють не найкращим чином.",shape=box,color=red];
		j3232552294 -> j2841676200;
	j3709201572 [label="Хіба тобі не здається, що тобі потрібно прощення за те, що ти зробив?",shape=box,color=red];
		j3709201572 -> j2126715244;
	j1388212370 [label="Вони просто намагаються тобі допомогти.",shape=box,color=red];
		j1388212370 -> j13246893;
	j2841676200 [label="Add -1 to Thermostat counter",color=orange];
		j2841676200 -> j506864862;
	j2126715244 [label="Add 1 to Thermostat counter",color=orange];
		j2126715244 -> j2943544043;
	j13246893 [label="«Допомогти». Так. «Допомогти». Вибач, але я вважаю їхній стиль «допомоги» глибоко «некорисним».",shape=box,color=blue];
		j13246893 -> j1324843338;
	j506864862 [label="Так, і в цьому і є вся трагедія. Вони щиро вірять, що намагаються робити «добро».",shape=box,color=blue];
		j506864862 -> j3330831985;
	j2943544043 [label="Прощення ким? Тобою? Ними? Дворецьким? Альбрехтом? Або «богами»?",shape=box,color=blue];
		j2943544043 -> j2803812321;
		j2943544043 -> j903849751;
		j2943544043 -> j433698180;
	j1324843338 [label="Насправді я вважав би за «допомогу», якби вони замінили моє вино на їдку речовину, узурпаторе.",shape=box,color=blue];
		j1324843338 -> j2465960175;
	j3330831985 [label="І як ти думаєш? Ти вважаєш, що я потребую якоїсь «великої спокути»? Якогось «святого прощення»?",shape=box,color=blue];
		j3330831985 -> j937239071;
	j2803812321 [label="Ти пропустив важливий пункт у цьому списку.",shape=box,color=red];
		j2803812321 -> j1150708376;
	j903849751 [label="Ти — орокін. Ти скоїв звірства під час війни та через природу свого суспільства. Тобі є за що покаятися.",shape=box,color=red];
		j903849751 -> j1302860468;
	j433698180 [label="Хіба ти хоча б не визнаєш, що у своєму житті робив жахливі речі?",shape=box,color=red];
		j433698180 -> j2779056773;
	j2465960175 [label="Це було б принаймні ефективніше.",shape=box,color=blue];
		j2465960175 -> j4038638190;
	j937239071 [label="Evaluate expressions",color=orange];
		j937239071 -> j3229677559 [label="RoatheTraitor2",color=purple];
		j937239071 -> j3043150070 [label="RoatheTraitor2",color=purple];
		j937239071 -> j2339575147 [label="RoatheTraitor2",color=purple];
		j937239071 -> j2493752626 [label="RoatheTraitor2",color=purple];
		j937239071 -> j3229677559 [label="RoatheTraitor1",color=purple];
		j937239071 -> j3043150070 [label="RoatheTraitor1",color=purple];
		j937239071 -> j2339575147 [label="RoatheTraitor1",color=purple];
		j937239071 -> j2493752626 [label="RoatheTraitor1",color=purple];
		j937239071 -> j3229677559 [label="RoatheExecutor2",color=purple];
		j937239071 -> j3043150070 [label="RoatheExecutor2",color=purple];
		j937239071 -> j2339575147 [label="RoatheExecutor2",color=purple];
		j937239071 -> j2493752626 [label="RoatheExecutor2",color=purple];
		j937239071 -> j3229677559 [label="false",color=purple];
		j937239071 -> j3043150070 [label="false",color=purple];
		j937239071 -> j2339575147 [label="false",color=purple];
	j1150708376 [label="Благаю, скажи. ",shape=box,color=blue];
		j1150708376 -> j610069270;
		j1150708376 -> j2707893256;
		j1150708376 -> j1870608606;
	j1302860468 [label="Я не буду вибачатися за суспільство орокінів, оскільки я не був його творцем. Лише його мешканцем. А якщо звинувачувати всіх, хто був частиною системи, в якій вони опинилися просто тому, що народилися в ній, тоді потрібно засудити мільярди людей своєю гордовитою самоправедністю. А що стосується решти?",shape=box,color=blue];
		j1302860468 -> j2622082677;
	j2779056773 [label="І що, як зробив? Зараз я вже не можу їх змінити. Який сенс відчувати провину?",shape=box,color=blue];
		j2779056773 -> j3014760235;
		j2779056773 -> j3867308369;
	j4038638190 [label="Хоча мушу зізнатися, між ними двома я віддаю перевагу священнику. Він прислухається до розуму. Він може просто прийти до висновку, що Байдужість не є справжнім богом.",shape=box,color=blue];
		j4038638190 -> j1863974968;
	j3229677559 [label="Я дійсно вважаю, що варто задуматися над нашими вчинками, які завдали шкоди людям, і спробувати зрозуміти, як їх виправити. Але я не думаю, що ці двоє роблять це правильно.",shape=box,color=red];
		j3229677559 -> j840596394;
	j3043150070 [label="Я не вірю в необхідність прощати когось, окрім себе самого, зрештою. Якщо ти задоволений своїми вчинками? Нехай буде так.",shape=box,color=red];
		j3043150070 -> j364020387;
	j2339575147 [label="Ти народився в суспільстві, де поведінка орокінів була просто… нормальною. Очікуваною. Для тебе це не було чимось «поганим». Я не кажу, що це робить її прийнятною, просто зрозумілою.",shape=box,color=red];
		j2339575147 -> j2507631655;
	j2493752626 [label="Ти намагався скинути орокінів. Ти знав, що вони зіпсовані, та намагався їх виправити.",shape=box,color=red];
		j2493752626 -> j2434694152;
	j610069270 [label="Себе.",shape=box,color=red];
		j610069270 -> j959970570;
	j2707893256 [label="Свій власний народ, який ти збирався зрадити.",shape=box,color=red];
		j2707893256 -> j4177935747;
	j1870608606 [label="Свідомі, яких ти винищив.",shape=box,color=red];
		j1870608606 -> j2622082677;
	j2622082677 [label="Це була війна. І в природі війни лежить вбивство тих, проти кого ти воюєш, у великій кількості. Ти ж не плачеш за ґрінерами чи корпусівцями, яких убиваєш?",shape=box,color=blue];
		j2622082677 -> j4278701261;
		j2622082677 -> j1341294277;
		j2622082677 -> j2313033123;
	j3014760235 [label="Прощення від інших важливе.",shape=box,color=red];
		j3014760235 -> j3481637746;
	j3867308369 [label="Ти можеш змінитися в майбутньому.",shape=box,color=red];
		j3867308369 -> j1383033671;
	j1863974968 [label="Уяви собі, я ще можу переконати його розібратися у всій своїй релігії. Людина, яка бачить химерні та криваві галюцинації, але також має здоровий глузд і логіку. Яка рідкість.",shape=box,color=blue];
		j1863974968 -> j2937677407;
		j1863974968 -> j2391022834;
	j840596394 [label="Гм. Зрозуміло. Ти заперечуєш не дії, а методики. Цим я відкликаю своє попереднє схвалення й замінюю його на занепокоєння.",shape=box,color=blue];
		j840596394 -> "Chat ends.";
	j364020387 [label="Boolean RoatheVillainSelf is now true.",color=orange];
		j364020387 -> j138585468;
	j2507631655 [label="Boolean RoatheVillainOrokin is now true.",color=orange];
		j2507631655 -> j138585468;
	j2434694152 [label="Тож я думаю, навіть якщо ти планував переробити систему на свій лад, ти знав, що вона має змінитися.",shape=box,color=red];
		j2434694152 -> j1262042102;
		j2434694152 -> j1188832325;
	j959970570 [label="Check boolean RoatheKnowsReset2",color=orange];
		j959970570 -> j3940472889 [label=true,color=green];
		j959970570 -> j4032819835 [label=false,color=brown];
	j4177935747 [label="Я не мав жодної безсонної ночі через почуття провини за зраду свого народу, узурпаторе. Повір мені.",shape=box,color=blue];
		j4177935747 -> j3838684983;
	j4278701261 [label="Ні. Але зі Свідомими ситуація інша.",shape=box,color=red];
		j4278701261 -> j2128395173;
	j1341294277 [label="Так, плачу.",shape=box,color=red];
		j1341294277 -> j3417465954;
	j2313033123 [label="Як я ставлюся до життів, які мені доводиться забирати, це моя особиста справа. Ми говоримо про тебе.",shape=box,color=red];
		j2313033123 -> j2900280978;
	j3481637746 [label="Чому? Щоб я залишився сам? Щоб я не був якимось… проклятим? Якимось соціальним ізгоєм? ",shape=box,color=blue];
		j3481637746 -> j1001968613;
	j1383033671 [label="Вчитися на своїх помилках – це ключовий момент, так. Але не потрібно відчувати «провину», щоб зрозуміти «невдачу».",shape=box,color=blue];
		j1383033671 -> j1457020365;
	j2937677407 [label="Ліон, здається, має достатньо власних проблем, чи не так?",shape=box,color=red];
		j2937677407 -> j3094033794;
	j2391022834 [label="Вибач, що зробити?",shape=box,color=red];
		j2391022834 -> j1997694933;
	j138585468 [label="Твій контекст відрізняється від нашого. І те, що ми вважаємо жорстоким і жахливим, тебе виховували бачити як ще одну частину того, як влаштований світ.",shape=box,color=red];
		j138585468 -> j383138209;
	j1262042102 [label="Це все одно не виправдовує все, що ти зробив — спотворення є спотвореннями, а жахи залишаються жахами. Але ти намагався.",shape=box,color=red];
		j1262042102 -> j2200355380;
	j1188832325 [label="На мій погляд, ти перебував у стані війни та намагався орієнтуватися в суспільстві соціопатів, одночасно плануючи його повалення. І за це вони назвали тебе дияволом. Я не думаю, що це справедливо.",shape=box,color=red];
		j1188832325 -> j3580450693;
	j3940472889 [label="За втечу.",shape=box,color=red];
		j3940472889 -> j2340587127;
	j4032819835 [label="За невдачу.",shape=box,color=red];
		j4032819835 -> j2340587127;
	j3838684983 [label="Я не буду вибачатися за орокінську імперію, оскільки я не був її творцем, лише її мешканцем. Але я також не буду брати на себе провину за те, що планував зруйнувати її. Ми заслужили те, що отримали, і навіть гірше.",shape=box,color=blue];
		j3838684983 -> j2982679385;
	j2128395173 [label="Кожна ситуація є «іншою ситуацією», узурпаторе. Контекст завжди має ключове значення. А ти просто дивишся на Давню війну з ясністю ретроспективи.",shape=box,color=blue];
		j2128395173 -> j1623172096;
	j3417465954 [label="У такому разі мені тебе безмежно шкода, узурпаторе, і я пропоную тобі або змиритися з тим, що тобі доручено робити, або покинути таке життя та зайнятися фермерством.",shape=box,color=blue];
		j3417465954 -> j3028926206;
	j2900280978 [label="М-м. Мені подобається, коли ти так явно показуєш, що я наступив на хворий мозоль, це так чудово приємно. Ти погано змінюєш тему розмови.",shape=box,color=blue];
		j2900280978 -> j442644536;
	j1001968613 [label="Подивися на мене, узурпаторе. Подивися, хто я є. Орокін, вигнаний зі своєї імперії.",shape=box,color=blue];
		j1001968613 -> j1289362767;
	j1457020365 [label="І в чому, зрештою, сенс прощення? Від кого я повинен прагнути прощення? Від інших? Щоб не стати якимось проклятим?",shape=box,color=blue];
		j1457020365 -> j1001968613;
	j3094033794 [label="І саме в цьому я хотів йому допомогти! Я лише намагаюся допомогти йому розібратися в його сумнівах щодо того, що таке Байдужість і що йому сказав Ентраті.",shape=box,color=blue];
		j3094033794 -> j1075498661;
	j1997694933 [label="Абсолютно нічого шкідливого, незалежно від того що тобі може надзижчати надокучливий комар. Я лише намагаюся допомогти йому розібратися в його сумнівах щодо того, що таке Байдужість і що йому сказав Ентраті.",shape=box,color=blue];
		j1997694933 -> j1075498661;
	j383138209 [label="+10 Chemistry",color=orange];
		j383138209 -> j712446952;
	j2200355380 [label="Boolean RoatheVillainOrokin is now true.",color=orange];
		j2200355380 -> j383138209;
	j3580450693 [label="Boolean RoatheVillainShortcut is now true.",color=orange];
		j3580450693 -> j4174111237;
	j2340587127 [label="Boolean RoatheForgivenessShortcut is now true.",color=orange];
		j2340587127 -> j1933300832;
	j2982679385 [label="Якщо є щось, за що я відчуваю провину, то це те, що тенно були відповідальні за спалення всього до тла, а не я.",shape=box,color=blue];
		j2982679385 -> j533316691;
	j1623172096 [label="Якщо ти будеш судити про вчинки людей у минулому, маючи всю інформацію, отриману в майбутньому, ти завжди будеш відчувати провину.",shape=box,color=blue];
		j1623172096 -> j871421248;
	j3028926206 [label="Хоча це було б ганьбою. Дивитися на твою роботу — справжнє задоволення. Не надто ефективно, але надзвичайно цікаво.",shape=box,color=blue];
		j3028926206 -> j3616662744;
	j442644536 [label="Хоча, мабуть, провівши століття на самоті, не маючи з ким поговорити, крім вигаданих персонажів власної уяви, людина обмежує можливості вдосконалити свої соціальні навички.",shape=box,color=blue];
		j442644536 -> j4237617171;
	j1289362767 [label="Я був «Дияволом Тау» у свій час. А тут я вже «диявол» для всіх, хто мене зустрічає.",shape=box,color=blue];
		j1289362767 -> j2897488305;
	j1075498661 [label="Ентраті сказав йому, що його «видіння» були результатом дії не Луа, а Байдужості. Це привело його до певної «кризи віри».",shape=box,color=blue];
		j1075498661 -> j500714097;
	j712446952 [label="Як приємно усвідомлювати, що поняття нюансів і тонкощів все-таки не зникло. Так, ти маєш рацію. Я — продукт іншої епохи, іншого часу, іншого суспільства.",shape=box,color=blue];
		j712446952 -> j1800554297;
	j4174111237 [label="+20 Chemistry",color=orange];
		j4174111237 -> j2887739861;
	j1933300832 [label="+10 Chemistry",color=orange];
		j1933300832 -> "Chat ends.";
	j533316691 [label="Boolean RoatheForgivenessNoGuilt is now true.",color=orange];
		j533316691 -> j1933300832;
	j871421248 [label="Прийми те, що сталося в минулому, та рухайся далі.",shape=box,color=blue];
		j871421248 -> j3750908742;
	j3616662744 [label="Ти робиш поле бою «цікавим», якщо не більше. ",shape=box,color=blue];
		j3616662744 -> j3750908742;
	j4237617171 [label="Іди потренуйся зі священником, вам обом потрібна практика. ",shape=box,color=blue];
		j4237617171 -> j4081414586;
	j2897488305 [label="Альбрехт вважав за доцільне забезпечити постійність цього прізвиська. ",shape=box,color=blue];
		j2897488305 -> j3750908742;
	j500714097 [label="Однак я намагаюся переконати його, що це не так, і що їх не послав «бог», оскільки «богів» не існує. Він просто хворий.",shape=box,color=blue];
		j500714097 -> j656593166;
		j500714097 -> j3299383289;
	j1800554297 [label="Однак я міг розпізнати жорстокість і спотворення мого народу такими, якими вони були насправді. Була така ницість, до якої опустилися багато хто з моїх побратимів, що навіть я не міг цього стерпіти.",shape=box,color=blue];
		j1800554297 -> j3786563080;
	j2887739861 [label="Я знав, що ти мені подобаєшся не просто так, узурпаторе. Нарешті! Хтось, хто мене цінує! Скільки на це пішло… століть?!",shape=box,color=blue];
		j2887739861 -> j3159126511;
	j3750908742 [label="Ось моя порада тобі: позбудься у своєму серці почуття провини за свої вчинки, як це зробив я. Встроми ножа в груди, поки воно не помре.",shape=box,color=blue];
		j3750908742 -> j1878809103;
	j4081414586 [label="+5 Chemistry",color=orange];
		j4081414586 -> "Chat ends.";
	j656593166 [label="Хіба Ліон потребує твоєї допомоги?",shape=box,color=red];
		j656593166 -> j1531737664;
	j3299383289 [label="І ти думаєш, що це покращить його становище?",shape=box,color=red];
		j3299383289 -> j3972720388;
	j3786563080 [label="Але такі питання є… складними. І я ціную те, що ти це розумієш. Та. Дворецький дивиться на мене. Мені потрібно завершувати розмову. Ми скоро знову поговоримо.",shape=box,color=blue];
		j3786563080 -> "Chat ends.";
	j3159126511 [label="Та. Дворецький дивиться на мене. Мені потрібно завершувати розмову. Ми скоро знову поговоримо.",shape=box,color=blue];
		j3159126511 -> "Chat ends.";
	j1878809103 [label="Почуття провини – це ніщо інше, як зрадник уночі, який позбавляє тебе всього, що тобі дороге. Воно приносить тобі лише шкоду.",shape=box,color=blue];
		j1878809103 -> j533316691;
	j1531737664 [label="Він не відмовився слухати. Він не сказав мені замовкнути. Я б припинив, якби він мені сказав.",shape=box,color=blue];
		j1531737664 -> j4034222009;
	j3972720388 [label="Чи краще для релігійних фанатиків маніпулювати ним тільки тому, що вони можуть це робити? Вказувати на його галюцинації та називати їх «видіннями» замість того, щоб допомогти йому?",shape=box,color=blue];
		j3972720388 -> j1290193588;
	j4034222009 [label="Мене дратує, коли люди навколо Ліона використовують його й маніпулюють ним, незалежно від того, чи усвідомлюють вони це. Усе в ім’я «релігії» та «віри».",shape=box,color=blue];
		j4034222009 -> j1290193588;
	j1290193588 [label="Я читав звіти про те, що сталося. Ця… «Багряна Вуаль» могла намагатися повернути того тенно з його Гарроу протягом усіх цих століть. Але вони цього не зробили. Вони дозволили йому змарніти та померти.",shape=box,color=blue];
		j1290193588 -> j1696276935;
	j1696276935 [label="Чому? В ім’я захисту від якогось… теоретичного «Бога Порожнечі».",shape=box,color=blue];
		j1696276935 -> j843918430;
		j1696276935 -> j2618994912;
	j843918430 [label="Ти думаєш, що жертва Релла була марною?",shape=box,color=red];
		j843918430 -> j4037545969;
	j2618994912 [label="Релл був єдиним, хто стримував цю штуку всі ці роки.",shape=box,color=red];
		j2618994912 -> j3410081844;
	j4037545969 [label="Ні. Він захищав від чогось. Але хто знає, наскільки він погіршив ситуацію? Хто знає, скільки він підживлював її собою, своїм страхом і тривогами протягом усіх цих століть?",shape=box,color=blue];
		j4037545969 -> j2238036219;
	j3410081844 [label="Або він був єдиним, хто годував її всі ці роки.",shape=box,color=blue];
		j3410081844 -> j2238036219;
	j2238036219 [label="Концептуальне втілення проявляє лише те, з чого його давно створили. А Порожнеча може працювати тільки з тією тканиною, яку їй дають для шиття.",shape=box,color=blue];
		j2238036219 -> j2139986897;
	j2139986897 [label="Цікаво, скільки ж один тенно вклав у його створення? Він був справжнім бенкетом агонії, болю, зради, смутку… Самотності…",shape=box,color=blue];
		j2139986897 -> j1498226746;
	j1498226746 [label="І заціпеніння, яке, мабуть, супроводжувало тисячі років, які він провів на самоті в тому місці, розмовляючи з Нічим. Що ж може бути наслідком цього, як не Байдужість?",shape=box,color=blue];
		j1498226746 -> j2948865849;
		j1498226746 -> j3142322361;
	j2948865849 [label="Можливо, те, що ти кажеш, правда. Я просто… не знаю, чи це так. І я не знаю, чи це не так.",shape=box,color=red];
		j2948865849 -> j191846250;
	j3142322361 [label="Вона була могутньою ще до того, як дісталася до Релла. Він не пожертвував би собою без вагомої причини.",shape=box,color=red];
		j3142322361 -> j4013016899;
	j191846250 [label="+10 Chemistry",color=orange];
		j191846250 -> j3884783901;
	j4013016899 [label="Так само як і дитячі кошмари. Для шестирічної дитини вони є наймогутнішими істотами у всесвіті. Але для дорослої людини вони лише хмара пилу, що застрягла у вентиляції та дрейфує до світла.",shape=box,color=blue];
		j4013016899 -> j2266129113;
	j3884783901 [label="Я не думаю, що можу просити про щось більше, ніж просто визнати, що ти не знаєш напевне, з чим ми маємо справу.",shape=box,color=blue];
		j3884783901 -> j1929246102;
	j2266129113 [label="Ми робимо з мухи слона просто тому, що нам потрібна причина, щоб бути нещасними та руйнувати себе.",shape=box,color=blue];
		j2266129113 -> j1528999903;
	j1929246102 [label="Це чудове відправна точка. І чудова риса, якою повинен володіти кожен: проста здатність просто сказати… «я не знаю».",shape=box,color=blue];
		j1929246102 -> j2619249604;
	j1528999903 [label="Людство в одному погляді.",shape=box,color=blue];
		j1528999903 -> j3208040028;
	j2619249604 [label="Якби ми, орокіни, могли час від часу роби те саме, можливо, ми б вижили.",shape=box,color=blue];
		j2619249604 -> j3208040028;
	j3208040028 [label="Boolean RoatheMITW3 is now true.",color=orange];
