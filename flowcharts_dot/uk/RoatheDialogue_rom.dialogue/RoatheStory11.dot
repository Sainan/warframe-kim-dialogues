	2235 [label="Витяг: Після першого вторгнення свідомих у систему й катастрофічної реакції орокінів запала дивовижна тиша.",shape=box,color=blue];
		2235 -> 2230;
	2230 [label="Ми не отримали жодної звістки від тих наших, що застрягли на Тау. І не було жодної можливості дізнатися: то завади чи нікого не лишилося в живих.",shape=box,color=blue];
		2230 -> 2226;
	2226 [label="Усі почали питати моє бачення цього. Від мене як стратега очікували розуміння ворога.",shape=box,color=blue];
		2226 -> 2231;
	2231 [label="Свідомі будь-якої миті могли знищити термінал сонячної рейки Тау, однак вона досі працювала.",shape=box,color=blue];
		2231 -> 5702;
	5702 [label="Чому? Що вони отримували від відчиненого проходу?",shape=box,color=blue];
		5702 -> 5703;
	5703 [label="Чи були вони єдині у своїй агресії, чи дехто все ж сподівався на мирне співіснування?",shape=box,color=blue];
		5703 -> 2229;
