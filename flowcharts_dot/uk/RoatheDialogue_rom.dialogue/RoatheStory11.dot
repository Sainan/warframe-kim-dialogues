	j3832291682 [label="РОЗДІЛЕННЯ",shape=box,color=blue];
		j3832291682 -> j148557078;
	j148557078 [label="Витяг: Після першого вторгнення свідомих у систему й катастрофічної реакції орокінів запала дивовижна тиша.",shape=box,color=blue];
		j148557078 -> j671045815;
	j671045815 [label="Ми не отримали жодної звістки від тих наших, що застрягли на Тау. І не було жодної можливості дізнатися: то завади чи нікого не лишилося в живих.",shape=box,color=blue];
		j671045815 -> j730374814;
	j730374814 [label="Усі почали питати моє бачення цього. Від мене як стратега очікували розуміння ворога.",shape=box,color=blue];
		j730374814 -> j1462412668;
	j1462412668 [label="Свідомі будь-якої миті могли знищити термінал сонячної рейки Тау, однак вона досі працювала.",shape=box,color=blue];
		j1462412668 -> j3938719941;
	j3938719941 [label="Чому? Що вони отримували від відчиненого проходу?",shape=box,color=blue];
		j3938719941 -> j2611245871;
	j2611245871 [label="Чи були вони єдині у своїй агресії, чи дехто все ж сподівався на мирне співіснування?",shape=box,color=blue];
		j2611245871 -> j921430358;
	j921430358 [label="Add 1 to HellStory counter",color=orange];
		j921430358 -> "Chat ends.";
}