		9 -> 16;
	10 [label="Перепрошую?",shape=box,color=red];
		10 -> 16;
	4 [label="Узурпатор?",shape=box,color=red];
		4 -> 11;
	5 [label="Якась… угода?",shape=box,color=red];
		5 -> 12;
	6 [label="Яку пропозицію може зробити мені «Диявол Тау»?",shape=box,color=red];
		6 -> 13;
	7 [label="Привіт, Роуте.",shape=box,color=red];
		7 -> 14;
	15 [label="О, добре! Ти дійсно знаєш моє ім’я! Я був упевнений, що це якось пройшло повз тебе, оскільки тебе турбувало лише моє неодноразове вбивство!",shape=box,color=blue];
		15 -> 21;
	16 [label="Невже в тебе немає продуктивнішого заняття?! Або ж грати по колу в гру «Прикріпи ріг до язнака» — це дійсно найкраще використання твого часу?!",shape=box,color=blue];
		16 -> 21;
	11 [label="Update boolean RoatheUsurper",color=orange];
		11 -> 17;
	12 [label="М-м, немає причин для занепокоєння чи хвилювання. Поки що. Це лише ділова угода між двома особами, які можуть принести одна одній значну користь.",shape=box,color=blue];
		12 -> 14;
	13 [label="+5 Chemistry",color=orange];
		13 -> 18;
	14 [label="Тепер слухай уважно. Ці два фанатики були надзвичайно жахливі та прискіпливі у своїх постійних докорах на мою адресу. Я очікую, що ти будеш вище за цю виправну поведінку.",shape=box,color=blue];
		14 -> 19;
		14 -> 20;
	21 [label="Мені дуже важко повірити, що все це, уся ця несправедливість, якої я зазнав від твоїх рук, усе це руйнування моєї психіки, не було зроблено тільки зі злості, за твоїм наказом!",shape=box,color=blue];
		21 -> 26;
		21 -> 27;
		21 -> 28;
	17 [label="+5 Chemistry",color=orange];
		17 -> 22;
	18 [label="Бачу, моя репутація випереджає мене. Добре. Це заощадить нам трохи часу.",shape=box,color=blue];
		18 -> 23;
	19 [label="Я не виконую твоїх наказів.",shape=box,color=red];
		19 -> 24;
	20 [label="Подивлюся, що зможу зробити.",shape=box,color=red];
		20 -> 25;
	26 [label="Це не здавалося пріоритетним.",shape=box,color=red];
		26 -> 34;
	27 [label="У мене… просто не було часу зробити це раніше.",shape=box,color=red];
		27 -> 35;
	28 [label="Ти не пам’ятаєш… але ми вже проходили це раніше.",shape=box,color=red];
		28 -> 36;
	22 [label="О! Але ж це твоя сутність, ні? Тенно узурпували Материнську систему орокінів. А тебе, як зозуленя в гніздо, підкинули у цей світ зі свого власного.",shape=box,color=blue];
		22 -> 29;
	23 [label="І немає причин для занепокоєння чи хвилювання… поки що. Це лише ділова угода між двома особами, які можуть принести одна одній значну користь.",shape=box,color=blue];
		23 -> 14;
	24 [label="Evaluate expressions on HellKeyPlayed",color=orange];
		24 -> 30 [label="x >= 21",color=purple];
		24 -> 31 [label="x >= 1",color=purple];
		24 -> 32 [label="x <= 0",color=purple];
		24 -> 32 [label="false",color=purple];
	25 [label="Подивися, що зможеш.",shape=box,color=blue];
		25 -> 33;
	34 [label="Це не здавалося…",shape=box,color=blue];
		34 -> 38;
	35 [label="Ох! Мені дуже шкода, що я завдав тобі клопоту, я не знав, що всі місця на твоєму танцювальному балу вже заброньовані!",shape=box,color=blue];
		35 -> 39;
	36 [label="+5 Chemistry",color=orange];
		36 -> 40;
	29 [label="І це робить тебе узурпатором принаймні за двома пунктами з мого списку. І, можливо, за трьома, якщо враховувати те, що дворецький розповів мені про Дувірі, але це тема для окремої розмови.",shape=box,color=blue];
		29 -> 14;
	30 [label="Мені неодноразово й жорстко про це наголосили, дякую.",shape=box,color=blue];
		30 -> 33;
	31 [label="Я досить чітко це зрозумів.",shape=box,color=blue];
		31 -> 33;
	32 [label="Ще побачимо.",shape=box,color=blue];
		32 -> 33;
	33 [label="Угода досить проста, мій чарівно слизький примарний новий «друже».",shape=box,color=blue];
		33 -> 37;
	38 [label="Це не здавалося пріоритетним?!",shape=box,color=blue];
		38 -> 44;
	39 [label="Серйозно. Я вражений, твої манери просто жахливі, мандрівниче.",shape=box,color=blue];
		39 -> 45;
	40 [label="Перепрошую? І як же це сталося, що я забув, як ти копирсаєшся в моїй голові, наче в мисці маліума на вечірці Наберової ночі?!",shape=box,color=blue];
		40 -> 46;
		40 -> 47;
	37 [label="Evaluate expressions on HellKeyPlayed",color=orange];
		37 -> 41 [label="x >= 21",color=purple];
		37 -> 42 [label="x >= 1",color=purple];
		37 -> 43 [label="x <= 0",color=purple];
		37 -> 43 [label="false",color=purple];
	44 [label="Ти завжди копирсаєшся в спогадах інших, руйнуючи їхні уявлення, не скориставшись нагодою спочатку з ними познайомитися?!",shape=box,color=blue];
		44 -> 50;
	45 [label="Але, мабуть, зараз вже нічого не можна вдіяти. Ти знаєш правду. Я відкритий перед тобою, з усією своєю огидною малодушністю.",shape=box,color=blue];
		45 -> 51;
	46 [label="Коротке кажучи, є… зараження, яке, здається, поширюється на сироватку протофреймів…",shape=box,color=red];
		46 -> 52;
	47 [label="А. Ну. Тож. Я маю здатність зациклювати час.",shape=box,color=red];
		47 -> 52;
	41 [label="Оскільки ти вже досидь довго товчешся в моїй голові, як п’яний разаліорн у посудній лавці, я прошу твоєї допомоги, щоб розшифрувати, що все це означає.",shape=box,color=blue];
		41 -> 48;
	42 [label="Ти з цими двома фанатиками вже почали товктися в моїй голові, як п’яний разаліорн у посудній лавці. Тож мені потрібна твоя допомога, щоб розшифрувати, що все це означає.",shape=box,color=blue];
		42 -> 48;
	43 [label="Коли Альбрехт встромив мені в шию шприц і перетворив мене на цю «річ», він зробив ще щось. Ігри між орокінами — це одне. А це? Це зовсім інше.",shape=box,color=blue];
		43 -> 49;
	50 [label="Твої манери просто жахливі!",shape=box,color=blue];
		50 -> 45;
	51 [label="Я припускаю, що ти тут лише для того, щоби насміхатися з мене. Я прошу насолодитися цим зараз, щоб ми могли рухатися далі.",shape=box,color=blue];
		51 -> 57;
	52 [label="І мені здавалося, що це спрацювало на протофрейми в 1999 році через те, що сам рік зациклювався, але це не так. ",shape=box,color=red];
		52 -> 58;
	48 [label="Мені потрібна твоя допомога не лише для того, щоби повернути свої спогади, але й для того, щоб, на додачу до всього, мати змогу самостійно розпізнати, які з них правдиві!",shape=box,color=blue];
		48 -> 53;
		48 -> 54;
	49 [label="Він украв більшу частину моїх спогадів. Я пам’ятаю маленьку… версію тебе, яка бігає навколо з усіма своїми травмованими тенно-друзями. Я бачу як Лотос допомагає цьому відновитися.",shape=box,color=blue];
		49 -> 55;
		49 -> 56;
	57 [label="Я б не хотів мати справу з істотою, яка постійно крутиться під ногами, наче декоративний куброу, виведений для розваги якоїсь діви.",shape=box,color=blue];
		57 -> 63;
		57 -> 64;
	58 [label="Я думаю, це… більше пов’язано із самим зараженням. Тут є балакуча гітара, яка натякає на такі речі. І ти прибув сюди на гельмінті, чи не так?",shape=box,color=red];
		58 -> 65;
	53 [label="Отже, ти кажеш, що тобі… просто потрібно з кимось поговорити?",shape=box,color=red];
		53 -> 59;
	54 [label="Я з радістю допоможу тобі, якщо зможу, але я не зовсім розумію як.",shape=box,color=red];
		54 -> 60;
	55 [label="Тож… чому б тобі не зануритися в Темний Спогадарій самостійно?",shape=box,color=red];
		55 -> 61;
	56 [label="Маля — не «це».",shape=box,color=red];
		56 -> 62;
	63 [label="Ти втік. Але багато людей втікають. Ідеться про те, щоб зіткнутися з тим, що сталося.",shape=box,color=red];
		63 -> 69;
	64 [label="Я не збираюся насміхатися з тебе. Ти зробив вибір продовжити бій наступного разу.",shape=box,color=red];
		64 -> 70;
	65 [label="У тобі відчувається надзвичайна невпевненість щодо цієї розмови, мандрівниче. Особливо, коли ідеться про вміст мого черепу.",shape=box,color=blue];
		65 -> 71;
	59 [label="О, не потрібно говорити так, ніби мені просто треба полежати на дивані та поговорити про свої «почуття».",shape=box,color=blue];
		59 -> 60;
	60 [label="Мені потрібен хтось, щоб керувати апаратом за моїм наказом, оскільки я зараз не в змозі це зробити самостійно. ",shape=box,color=blue];
		60 -> 66;
	61 [label="Я б це зробив, повір мені, але не можу! Клята сироватка протофреймів, якою Альбрехт отруїв мене, позбавила будь-якої здатності самостійно керувати цією штукою!",shape=box,color=blue];
		61 -> 67;
	62 [label="Запевняю тебе, «це» — саме воно.",shape=box,color=blue];
		62 -> 68;
	69 [label="Add 1 to Thermostat",color=orange];
		69 -> 73;
	70 [label="Add -1 to Thermostat",color=orange];
		70 -> 74;
	71 [label="Ну так. Я справді потрапив сюди завдяки гельмінту. Я сам його розробив і виростив. А тепер ти хочеш сказати, що… мої спогади були стерті тобою?! Спогади про наші спільні розмови?! ",shape=box,color=blue];
		71 -> 75;
	66 [label="Мені також потрібен хтось, хто допоможе записати мої спогади й узгодити їх. Свого роду вакансія тимчасової допомоги.",shape=box,color=blue];
		66 -> 72;
	67 [label="Крім того, мені потрібна твоя допомога не лише для того, щоби повернути свої спогади, але й для того, щоб, на додачу до всього, мати змогу самостійно розпізнати, які з них правдиві!",shape=box,color=blue];
		67 -> 53;
		67 -> 54;
	68 [label="І я б це зробив, повір мені, але не можу! Клята сироватка протофреймів, якою Альбрехт отруїв мене, позбавила будь-якої здатності самостійно керувати цією штукою!",shape=box,color=blue];
		68 -> 67;
	73 [label="Чудово. Ще одна надокучлива муха, яка літає коло моїх вух і каже, що я потребую самоаналізу та покаяння?",shape=box,color=blue];
		73 -> 77;
	74 [label="+5 Chemistry",color=orange];
		74 -> 78;
	75 [label="Бо в мене точно залишилися «приємні» спогади про те, як я перетворююся на фарш заради твоєї кривавої втіхи. Як це взагалі може мати якийсь сенс?",shape=box,color=blue];
		75 -> 79;
		75 -> 80;
	72 [label="А натомість даю тобі урочисту обітницю, що я сидітиму тут… мирно. Я нікому не буду загрожувати, у чому я тебе запевняю… я цілком здатний на це. Не завдам шкоди фанатикам. Чи дворецькому. Жодній тварині, враженій Порожнечею Альбрехта.",shape=box,color=blue];
		72 -> 76;
	77 [label="Мені пощастило.",shape=box,color=blue];
		77 -> 84;
	78 [label="Наразі те, що я роблю, схоже на «гниття в крипті з парою безмізких фанатиків і роздавання дрібничок дітям, травмованих війною».",shape=box,color=blue];
		78 -> 85;
	79 [label="Я не знаю, і я тут не для того, щоби терпіти твої образи, Роуте. У мене не було бажання зациклювати всіх, щоби потім вислуховувати твою критику.",shape=box,color=red];
		79 -> 5634;
	80 [label="Наскільки я можу здогадуватися. Наші розмови не мають глибоких коренів. Це поверхневі спогади. Те, що ми виявили у твоєму минулому, було… скоріше частиною твоїх основних спогадів, гадаю?",shape=box,color=red];
		80 -> 86;
	76 [label="І що ще важливіше, я не завдам шкоди спотвореній родині Альбрехта, яка висить над нами наче, мутована флора, навіть не помічаючи нашої присутності.",shape=box,color=blue];
		76 -> 81;
		76 -> 82;
		76 -> 83;
	84 [label="Я планую займатися своїми справами, мандрівниче, але факт залишається фактом — ти занадто багато знаєш про моє минуле і про те, що я зробив. І нам доведеться просто… з ним жити.",shape=box,color=blue];
		84 -> 90;
	85 [label="Але я думаю, що зараз це так і називається.",shape=box,color=blue];
		85 -> 84;
	5634 [label="Yes. I could hazard a guess as to why you have summoned your Void-gifts to wipe our minds of recent events. How perfectly predictable.",shape=box,color=blue];
		5634 -> 91;
	86 [label="Фантастично. Просто дивовижно. Тепер я в руках божевільної особи, яка може за своєю примхою стерти мої спогади! Як мило.",shape=box,color=blue];
		86 -> 91;
	81 [label="Мені здавалося, що буде угода. А тепер ти погрожуєш мені?",shape=box,color=red];
		81 -> 87;
	82 [label="Роуте. Будь ласка, зупинися й вислухай мене хвилинку.",shape=box,color=red];
		82 -> 88;
	83 [label="Що мені потрібно зробити?",shape=box,color=red];
		83 -> 89;
	90 [label="Постарайся не створювати для мене незручних ситуацій, і я обіцяю, що постараюся зробити те саме у відповідь.",shape=box,color=blue];
		90 -> 97;
		90 -> 98;
	91 [label="Що ж. Якщо те, що ти кажеш, правда — а я припускаю, що ця історія настільки божевільна, що може бути правдою — я спробую не ображатися на тебе за те, що ти знаєш цю мою глибоку і жахливу таємницю.",shape=box,color=blue];
		91 -> 99;
	87 [label="Щось пройшло повз твої вуха? Реальне розуміння прочитаного цими днями… Я не погрожую тобі, узурпаторе. І нікому не погрожував.",shape=box,color=blue];
		87 -> 92;
	88 [label="Це має бути грандіозно. Прошу. Твій вихід на сцену, як-то кажуть.",shape=box,color=blue];
		88 -> 93;
		88 -> 94;
		88 -> 95;
	89 [label="Щось пройшло повз твої вуха? Реальне розуміння прочитаного цими днями… Я намагаюся укласти з тобою угоду, узурпаторе. Важко повірити, що ти не можеш простежити цю думку.",shape=box,color=blue];
		89 -> 96;
	97 [label="Ні.",shape=box,color=red];
		97 -> 104;
	98 [label="Я думаю, це справедливо.",shape=box,color=red];
		98 -> 105;
	99 [label="Хоча я б хотів тебе попросити, якщо можна, висловити все, що ти хочеш сказати мені в обличчя, щоб ми могли рухатися далі.",shape=box,color=blue];
		99 -> 57;
	92 [label="Я просто констатував, що якщо ми дійдемо до точки, коли я не зможу досягти своєї мети, в мене, можливо, не буде більше причин сидіти тихо.",shape=box,color=blue];
		92 -> 96;
	93 [label="Я — причина смерті Балласа. Не змушуй мене звільняти місце в моєму розкладі.",shape=box,color=red];
		93 -> 100;
	94 [label="Якщо тобі потрібна моя допомога, це не найкращий спосіб отримати її.",shape=box,color=red];
		94 -> 101;
	95 [label="Я знаю, що в нас із тобою немає великого досвіду спілкування, насправді. Але я тут, щоб допомогти тобі.",shape=box,color=red];
		95 -> 102;
	96 [label="Якщо моя пропозиція не відповідає твоїм стандартам, чи можу я підсолодити її для тебе?",shape=box,color=blue];
		96 -> 103;
	104 [label="+5 Chemistry",color=orange];
		104 -> 108;
	105 [label="+15 Chemistry",color=orange];
		105 -> 109;
	100 [label="+5 Chemistry",color=orange];
		100 -> 106;
	101 [label="І якщо ти хочеш моєї, то я пропоную, як уже казав, домовитися.",shape=box,color=blue];
		101 -> 96;
	102 [label="І? А. Зрозуміло. Тобі не подобається мій «тон», чи не так? Мені страшенно шкода. Не думав, що ти так легко наїжачишся.",shape=box,color=blue];
		102 -> 96;
	103 [label="Мені стало відомо, що довкола Деймоса точиться багато питань, де моя допомога може вважатися не лише вагомою, але й, насмілюся сказати, вирішальною.",shape=box,color=blue];
		103 -> 107;
	108 [label="Ха! Я повинен поважати хоче б твою чесність.",shape=box,color=blue];
		108 -> 112;
	109 [label="Чудово. Добре знати, що з тобою хоча б… приємно мати справу.",shape=box,color=blue];
		109 -> 112;
	106 [label="Якби ж я міг передати, як я тут сміюся! Дякую, мандрівниче, за те, що не було нудно!",shape=box,color=blue];
		106 -> 110;
	107 [label="Зокрема. Але не обмежуючись цим, примирення одного люблячого дворецького та відчуженої родини, яка живе нагорі.",shape=box,color=blue];
		107 -> 111;
	112 [label="Update boolean RoatheKnowsReset",color=orange];
		112 -> 117;
	110 [label="Add -1 to Thermostat",color=orange];
		110 -> 113;
	111 [label="Родина, яка, як я вже згадував, навіть не підозрює, що ми тут унизу. І не знає про подальше існування Альбрехта, чи не так?",shape=box,color=blue];
		111 -> 114;
		111 -> 115;
		111 -> 116;
	117 [label="Принаймні це буде цікаво.",shape=box,color=blue];
		117 -> 122;
	113 [label="Яка ж це була насолода! Я думаю, ми з тобою станемо друзями, насправді. Це було просто чудово.",shape=box,color=blue];
		113 -> 118;
	114 [label="Ти пропонуєш допомогти переконати Лойда… поговорити з родиною Ентраті?",shape=box,color=red];
		114 -> 119;
	115 [label="Я не можу переконати Лойда щось із цим зробити. Він стверджує, що це буде для них занадто боляче.",shape=box,color=red];
		115 -> 120;
	116 [label="Ні, вони не знають, що Альбрехт Ентраті все ще живий.",shape=box,color=red];
		116 -> 121;
	122 [label="Chat ends.",color=orange];
	118 [label="Я думаю, ти вартуєш нагороди. І я зроблю свою частину угоди трохи солодшою для тебе. Така зухвалість зустрічається рідко.",shape=box,color=blue];
		118 -> 103;
	119 [label="Не безплатно, мій узурпаторе, поневолений Порожнечею.",shape=box,color=blue];
		119 -> 123;
	120 [label="Ти не можеш. Але я обіцяю… я зможу.",shape=box,color=blue];
		120 -> 123;
	121 [label="І те, що тобі не вдалося переконати того скорботного слугу? Обіцяю… я зможу.",shape=box,color=blue];
		121 -> 123;
	123 [label="І от ми нарешті підійшли до моєї пропозиції: допоможи мені розібратися з моїми втраченими спогадами та дістатися «суті» всього цього — без підступів.",shape=box,color=blue];
		123 -> 124;
	124 [label="І я подбаю про те, щоби наш сердешний слуга піднявся нагору. А тим часом я сидітиму мирно… і нікому не загрожуватиму. Що скажеш? Домовилися?",shape=box,color=blue];
		124 -> 125;
