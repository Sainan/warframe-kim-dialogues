	3 [label="Я дійсно мушу похвалити тебе за твою зухвалість! Ти справді маєш упевненість, що ти не замаскований орокін? Можливо, ти ховаєш свою блакитну шкіру, щоб не викликати підозри в інших?!",shape=box,color=blue];
		3 -> 8;
		3 -> 9;
		3 -> 10;
	2349 [label="Update boolean RoatheResetEdgeCase",color=orange];
		2349 -> 2;
	2 [label="Аномалія, породжена Порожнечею. «Мандрівник». Узурпатор. Нарешті ми спілкуємося. Ходімо. Диявол має пропозицію…",shape=box,color=blue];
		2 -> 4;
		2 -> 5;
		2 -> 6;
