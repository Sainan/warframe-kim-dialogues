digraph {
	"RoatheRank1Convo1 begins." [color=orange];
		"RoatheRank1Convo1 begins." -> j3998890108;
	j3998890108 [label="Evaluate expressions on HellStory counter",color=orange];
		j3998890108 -> j637112864 [label="x >= 21",color=purple];
		j3998890108 -> j3841682832 [label="x >= 6",color=purple];
		j3998890108 -> j1155623976 [label="x < 6",color=purple];
		j3998890108 -> j1155623976 [label="false",color=purple];
	j637112864 [label="Я дійсно мушу похвалити тебе за твою зухвалість! Ти справді маєш упевненість, що ти не замаскований орокін? Можливо, ти ховаєш свою блакитну шкіру, щоб не викликати підозри в інших?!",shape=box,color=blue];
		j637112864 -> j3700129831;
		j637112864 -> j3129310466;
		j637112864 -> j3285711735;
	j3841682832 [label="Boolean RoatheResetEdgeCase is now true.",color=orange];
		j3841682832 -> j1155623976;
	j1155623976 [label="Аномалія, породжена Порожнечею. «Мандрівник». Узурпатор. Нарешті ми спілкуємося. Ходімо. Диявол має пропозицію…",shape=box,color=blue];
		j1155623976 -> j3629374181;
		j1155623976 -> j4126397265;
		j1155623976 -> j4019248034;
		j1155623976 -> j2520437829;
	j3700129831 [label="Привіт, Роуте.",shape=box,color=red];
		j3700129831 -> j2384164562;
	j3129310466 [label="У чому саме ти мене звинувачуєш?",shape=box,color=red];
		j3129310466 -> j2200828075;
	j3285711735 [label="Перепрошую?",shape=box,color=red];
		j3285711735 -> j2200828075;
	j3629374181 [label="Узурпатор?",shape=box,color=red];
		j3629374181 -> j728930410;
	j4126397265 [label="Якась… угода?",shape=box,color=red];
		j4126397265 -> j1459850139;
	j4019248034 [label="Яку пропозицію може зробити мені «Диявол Тау»?",shape=box,color=red];
		j4019248034 -> j788580911;
	j2520437829 [label="Привіт, Роуте.",shape=box,color=red];
		j2520437829 -> j2820215766;
	j2384164562 [label="О, добре! Ти дійсно знаєш моє ім’я! Я був упевнений, що це якось пройшло повз тебе, оскільки тебе турбувало лише моє неодноразове вбивство!",shape=box,color=blue];
		j2384164562 -> j1795290391;
	j2200828075 [label="Невже в тебе немає продуктивнішого заняття?! Або ж грати по колу в гру «Прикріпи ріг до язнака» — це дійсно найкраще використання твого часу?!",shape=box,color=blue];
		j2200828075 -> j1795290391;
	j728930410 [label="Boolean RoatheUsurper is now true.",color=orange];
		j728930410 -> j351307385;
	j1459850139 [label="М-м, немає причин для занепокоєння чи хвилювання. Поки що. Це лише ділова угода між двома особами, які можуть принести одна одній значну користь.",shape=box,color=blue];
		j1459850139 -> j2820215766;
	j788580911 [label="+5 Chemistry",color=orange];
		j788580911 -> j3227115657;
	j2820215766 [label="Тепер слухай уважно. Ці два фанатики були надзвичайно жахливі та прискіпливі у своїх постійних докорах на мою адресу. Я очікую, що ти будеш вище за цю виправну поведінку.",shape=box,color=blue];
		j2820215766 -> j1223921292;
		j2820215766 -> j733465975;
	j1795290391 [label="Мені дуже важко повірити, що все це, уся ця несправедливість, якої я зазнав від твоїх рук, усе це руйнування моєї психіки, не було зроблено тільки зі злості, за твоїм наказом!",shape=box,color=blue];
		j1795290391 -> j805908172;
		j1795290391 -> j1570168180;
		j1795290391 -> j1038195999;
	j351307385 [label="+5 Chemistry",color=orange];
		j351307385 -> j2065915024;
	j3227115657 [label="Бачу, моя репутація випереджає мене. Добре. Це заощадить нам трохи часу.",shape=box,color=blue];
		j3227115657 -> j2243775823;
	j1223921292 [label="Я не виконую твоїх наказів.",shape=box,color=red];
		j1223921292 -> j4026548805;
	j733465975 [label="Подивлюся, що зможу зробити.",shape=box,color=red];
		j733465975 -> j2151678068;
	j805908172 [label="Це не здавалося пріоритетним.",shape=box,color=red];
		j805908172 -> j2719398346;
	j1570168180 [label="У мене… просто не було часу зробити це раніше.",shape=box,color=red];
		j1570168180 -> j1607002956;
	j1038195999 [label="Ти не пам’ятаєш… але ми вже проходили це раніше.",shape=box,color=red];
		j1038195999 -> j1155726939;
	j2065915024 [label="О! Але ж це твоя сутність, ні? Тенно узурпували Материнську систему орокінів. А тебе, як зозуленя в гніздо, підкинули у цей світ зі свого власного.",shape=box,color=blue];
		j2065915024 -> j3979859612;
	j2243775823 [label="І немає причин для занепокоєння чи хвилювання… поки що. Це лише ділова угода між двома особами, які можуть принести одна одній значну користь.",shape=box,color=blue];
		j2243775823 -> j2820215766;
	j4026548805 [label="Evaluate expressions on HellKeyPlayed counter",color=orange];
		j4026548805 -> j1161382749 [label="x >= 21",color=purple];
		j4026548805 -> j4241354114 [label="x >= 1",color=purple];
		j4026548805 -> j597375315 [label="x <= 0",color=purple];
		j4026548805 -> j597375315 [label="false",color=purple];
	j2151678068 [label="Подивися, що зможеш.",shape=box,color=blue];
		j2151678068 -> j115344575;
	j2719398346 [label="Це не здавалося…",shape=box,color=blue];
		j2719398346 -> j672244375;
	j1607002956 [label="Ох! Мені дуже шкода, що я завдав тобі клопоту, я не знав, що всі місця на твоєму танцювальному балу вже заброньовані!",shape=box,color=blue];
		j1607002956 -> j1109698135;
	j1155726939 [label="+5 Chemistry",color=orange];
		j1155726939 -> j731475558;
	j3979859612 [label="І це робить тебе узурпатором принаймні за двома пунктами з мого списку. І, можливо, за трьома, якщо враховувати те, що дворецький розповів мені про Дувірі, але це тема для окремої розмови.",shape=box,color=blue];
		j3979859612 -> j2820215766;
	j1161382749 [label="Мені неодноразово й жорстко про це наголосили, дякую.",shape=box,color=blue];
		j1161382749 -> j115344575;
	j4241354114 [label="Я досить чітко це зрозумів.",shape=box,color=blue];
		j4241354114 -> j115344575;
	j597375315 [label="Ще побачимо.",shape=box,color=blue];
		j597375315 -> j115344575;
	j115344575 [label="Угода досить проста, мій чарівно слизький примарний новий «друже».",shape=box,color=blue];
		j115344575 -> j1071362491;
	j672244375 [label="Це не здавалося пріоритетним?!",shape=box,color=blue];
		j672244375 -> j3511957668;
	j1109698135 [label="Серйозно. Я вражений, твої манери просто жахливі, мандрівниче.",shape=box,color=blue];
		j1109698135 -> j2259671847;
	j731475558 [label="Перепрошую? І як же це сталося, що я забув, як ти копирсаєшся в моїй голові, наче в мисці маліума на вечірці Наберової ночі?!",shape=box,color=blue];
		j731475558 -> j1854762735;
		j731475558 -> j4292615723;
	j1071362491 [label="Evaluate expressions on HellKeyPlayed counter",color=orange];
		j1071362491 -> j3481988191 [label="x >= 21",color=purple];
		j1071362491 -> j3387467666 [label="x >= 1",color=purple];
		j1071362491 -> j946814409 [label="x <= 0",color=purple];
		j1071362491 -> j946814409 [label="false",color=purple];
	j3511957668 [label="Ти завжди копирсаєшся в спогадах інших, руйнуючи їхні уявлення, не скориставшись нагодою спочатку з ними познайомитися?!",shape=box,color=blue];
		j3511957668 -> j3465301078;
	j2259671847 [label="Але, мабуть, зараз вже нічого не можна вдіяти. Ти знаєш правду. Я відкритий перед тобою, з усією своєю огидною малодушністю.",shape=box,color=blue];
		j2259671847 -> j3110564988;
	j1854762735 [label="Коротке кажучи, є… зараження, яке, здається, поширюється на сироватку протофреймів…",shape=box,color=red];
		j1854762735 -> j211693900;
	j4292615723 [label="А. Ну. Тож. Я маю здатність зациклювати час.",shape=box,color=red];
		j4292615723 -> j211693900;
	j3481988191 [label="Оскільки ти вже досидь довго товчешся в моїй голові, як п’яний разаліорн у посудній лавці, я прошу твоєї допомоги, щоб розшифрувати, що все це означає.",shape=box,color=blue];
		j3481988191 -> j3420260910;
	j3387467666 [label="Ти з цими двома фанатиками вже почали товктися в моїй голові, як п’яний разаліорн у посудній лавці. Тож мені потрібна твоя допомога, щоб розшифрувати, що все це означає.",shape=box,color=blue];
		j3387467666 -> j3420260910;
	j946814409 [label="Коли Альбрехт встромив мені в шию шприц і перетворив мене на цю «річ», він зробив ще щось. Ігри між орокінами — це одне. А це? Це зовсім інше.",shape=box,color=blue];
		j946814409 -> j4185072017;
	j3465301078 [label="Твої манери просто жахливі!",shape=box,color=blue];
		j3465301078 -> j2259671847;
	j3110564988 [label="Я припускаю, що ти тут лише для того, щоби насміхатися з мене. Я прошу насолодитися цим зараз, щоб ми могли рухатися далі.",shape=box,color=blue];
		j3110564988 -> j523484142;
	j211693900 [label="І мені здавалося, що це спрацювало на протофрейми в 1999 році через те, що сам рік зациклювався, але це не так. ",shape=box,color=red];
		j211693900 -> j2207139900;
	j3420260910 [label="Мені потрібна твоя допомога не лише для того, щоби повернути свої спогади, але й для того, щоб, на додачу до всього, мати змогу самостійно розпізнати, які з них правдиві!",shape=box,color=blue];
		j3420260910 -> j1542912293;
		j3420260910 -> j3204980108;
	j4185072017 [label="Він украв більшу частину моїх спогадів. Я пам’ятаю маленьку… версію тебе, яка бігає навколо з усіма своїми травмованими тенно-друзями. Я бачу як Лотос допомагає цьому відновитися.",shape=box,color=blue];
		j4185072017 -> j206775508;
		j4185072017 -> j3666265600;
	j523484142 [label="Я б не хотів мати справу з істотою, яка постійно крутиться під ногами, наче декоративний куброу, виведений для розваги якоїсь діви.",shape=box,color=blue];
		j523484142 -> j2112846722;
		j523484142 -> j3043148753;
	j2207139900 [label="Я думаю, це… більше пов’язано із самим зараженням. Тут є балакуча гітара, яка натякає на такі речі. І ти прибув сюди на гельмінті, чи не так?",shape=box,color=red];
		j2207139900 -> j1868022632;
	j1542912293 [label="Отже, ти кажеш, що тобі… просто потрібно з кимось поговорити?",shape=box,color=red];
		j1542912293 -> j1914948878;
	j3204980108 [label="Я з радістю допоможу тобі, якщо зможу, але я не зовсім розумію як.",shape=box,color=red];
		j3204980108 -> j359050442;
	j206775508 [label="Тож… чому б тобі не зануритися в Темний Спогадарій самостійно?",shape=box,color=red];
		j206775508 -> j4258314995;
	j3666265600 [label="Маля — не «це».",shape=box,color=red];
		j3666265600 -> j4205009029;
	j2112846722 [label="Ти втік. Але багато людей втікають. Ідеться про те, щоб зіткнутися з тим, що сталося.",shape=box,color=red];
		j2112846722 -> j2413608838;
	j3043148753 [label="Я не збираюся насміхатися з тебе. Ти зробив вибір продовжити бій наступного разу.",shape=box,color=red];
		j3043148753 -> j4018934243;
	j1868022632 [label="У тобі відчувається надзвичайна невпевненість щодо цієї розмови, мандрівниче. Особливо, коли ідеться про вміст мого черепу.",shape=box,color=blue];
		j1868022632 -> j2035768820;
	j1914948878 [label="О, не потрібно говорити так, ніби мені просто треба полежати на дивані та поговорити про свої «почуття».",shape=box,color=blue];
		j1914948878 -> j359050442;
	j359050442 [label="Мені потрібен хтось, щоб керувати апаратом за моїм наказом, оскільки я зараз не в змозі це зробити самостійно. ",shape=box,color=blue];
		j359050442 -> j2596664239;
	j4258314995 [label="Я б це зробив, повір мені, але не можу! Клята сироватка протофреймів, якою Альбрехт отруїв мене, позбавила будь-якої здатності самостійно керувати цією штукою!",shape=box,color=blue];
		j4258314995 -> j2897972365;
	j4205009029 [label="Запевняю тебе, «це» — саме воно.",shape=box,color=blue];
		j4205009029 -> j164771745;
	j2413608838 [label="Add 1 to Thermostat counter",color=orange];
		j2413608838 -> j1518345516;
	j4018934243 [label="Add -1 to Thermostat counter",color=orange];
		j4018934243 -> j3455090005;
	j2035768820 [label="Ну так. Я справді потрапив сюди завдяки гельмінту. Я сам його розробив і виростив. А тепер ти хочеш сказати, що… мої спогади були стерті тобою?! Спогади про наші спільні розмови?! ",shape=box,color=blue];
		j2035768820 -> j2118073259;
	j2596664239 [label="Мені також потрібен хтось, хто допоможе записати мої спогади й узгодити їх. Свого роду вакансія тимчасової допомоги.",shape=box,color=blue];
		j2596664239 -> j1007587886;
	j2897972365 [label="Крім того, мені потрібна твоя допомога не лише для того, щоби повернути свої спогади, але й для того, щоб, на додачу до всього, мати змогу самостійно розпізнати, які з них правдиві!",shape=box,color=blue];
		j2897972365 -> j1542912293;
		j2897972365 -> j3204980108;
	j164771745 [label="І я б це зробив, повір мені, але не можу! Клята сироватка протофреймів, якою Альбрехт отруїв мене, позбавила будь-якої здатності самостійно керувати цією штукою!",shape=box,color=blue];
		j164771745 -> j2897972365;
	j1518345516 [label="Чудово. Ще одна надокучлива муха, яка літає коло моїх вух і каже, що я потребую самоаналізу та покаяння?",shape=box,color=blue];
		j1518345516 -> j304593418;
	j3455090005 [label="+5 Chemistry",color=orange];
		j3455090005 -> j293937538;
	j2118073259 [label="Бо в мене точно залишилися «приємні» спогади про те, як я перетворююся на фарш заради твоєї кривавої втіхи. Як це взагалі може мати якийсь сенс?",shape=box,color=blue];
		j2118073259 -> j1928682249;
		j2118073259 -> j2989382092;
	j1007587886 [label="А натомість даю тобі урочисту обітницю, що я сидітиму тут… мирно. Я нікому не буду загрожувати, у чому я тебе запевняю… я цілком здатний на це. Не завдам шкоди фанатикам. Чи дворецькому. Жодній тварині, враженій Порожнечею Альбрехта.",shape=box,color=blue];
		j1007587886 -> j2036250143;
	j304593418 [label="Мені пощастило.",shape=box,color=blue];
		j304593418 -> j370152128;
	j293937538 [label="Наразі те, що я роблю, схоже на «гниття в крипті з парою безмізких фанатиків і роздавання дрібничок дітям, травмованих війною».",shape=box,color=blue];
		j293937538 -> j1088214291;
	j1928682249 [label="Я не знаю, і я тут не для того, щоби терпіти твої образи, Роуте. У мене не було бажання зациклювати всіх, щоби потім вислуховувати твою критику.",shape=box,color=red];
		j1928682249 -> j736926312;
	j2989382092 [label="Наскільки я можу здогадуватися. Наші розмови не мають глибоких коренів. Це поверхневі спогади. Те, що ми виявили у твоєму минулому, було… скоріше частиною твоїх основних спогадів, гадаю?",shape=box,color=red];
		j2989382092 -> j1893004256;
	j2036250143 [label="І що ще важливіше, я не завдам шкоди спотвореній родині Альбрехта, яка висить над нами наче, мутована флора, навіть не помічаючи нашої присутності.",shape=box,color=blue];
		j2036250143 -> j34071103;
		j2036250143 -> j978283243;
		j2036250143 -> j3666857395;
	j370152128 [label="Я планую займатися своїми справами, мандрівниче, але факт залишається фактом — ти занадто багато знаєш про моє минуле і про те, що я зробив. І нам доведеться просто… з ним жити.",shape=box,color=blue];
		j370152128 -> j2185340944;
	j1088214291 [label="Але я думаю, що зараз це так і називається.",shape=box,color=blue];
		j1088214291 -> j370152128;
	j736926312 [label="Yes. I could hazard a guess as to why you have summoned your Void-gifts to wipe our minds of recent events. How perfectly predictable.",shape=box,color=blue];
		j736926312 -> j2405807801;
	j1893004256 [label="Фантастично. Просто дивовижно. Тепер я в руках божевільної особи, яка може за своєю примхою стерти мої спогади! Як мило.",shape=box,color=blue];
		j1893004256 -> j2405807801;
	j34071103 [label="Мені здавалося, що буде угода. А тепер ти погрожуєш мені?",shape=box,color=red];
		j34071103 -> j1850854645;
	j978283243 [label="Роуте. Будь ласка, зупинися й вислухай мене хвилинку.",shape=box,color=red];
		j978283243 -> j1068441595;
	j3666857395 [label="Що мені потрібно зробити?",shape=box,color=red];
		j3666857395 -> j1441880334;
	j2185340944 [label="Постарайся не створювати для мене незручних ситуацій, і я обіцяю, що постараюся зробити те саме у відповідь.",shape=box,color=blue];
		j2185340944 -> j1893886985;
		j2185340944 -> j3168435110;
	j2405807801 [label="Що ж. Якщо те, що ти кажеш, правда — а я припускаю, що ця історія настільки божевільна, що може бути правдою — я спробую не ображатися на тебе за те, що ти знаєш цю мою глибоку і жахливу таємницю.",shape=box,color=blue];
		j2405807801 -> j2961185057;
	j1850854645 [label="Щось пройшло повз твої вуха? Реальне розуміння прочитаного цими днями… Я не погрожую тобі, узурпаторе. І нікому не погрожував.",shape=box,color=blue];
		j1850854645 -> j1192787107;
	j1068441595 [label="Це має бути грандіозно. Прошу. Твій вихід на сцену, як-то кажуть.",shape=box,color=blue];
		j1068441595 -> j689344012;
		j1068441595 -> j2808683821;
		j1068441595 -> j1206954402;
	j1441880334 [label="Щось пройшло повз твої вуха? Реальне розуміння прочитаного цими днями… Я намагаюся укласти з тобою угоду, узурпаторе. Важко повірити, що ти не можеш простежити цю думку.",shape=box,color=blue];
		j1441880334 -> j3707756612;
	j1893886985 [label="Ні.",shape=box,color=red];
		j1893886985 -> j507676785;
	j3168435110 [label="Я думаю, це справедливо.",shape=box,color=red];
		j3168435110 -> j1784488737;
	j2961185057 [label="Хоча я б хотів тебе попросити, якщо можна, висловити все, що ти хочеш сказати мені в обличчя, щоб ми могли рухатися далі.",shape=box,color=blue];
		j2961185057 -> j523484142;
	j1192787107 [label="Я просто констатував, що якщо ми дійдемо до точки, коли я не зможу досягти своєї мети, в мене, можливо, не буде більше причин сидіти тихо.",shape=box,color=blue];
		j1192787107 -> j3707756612;
	j689344012 [label="Я — причина смерті Балласа. Не змушуй мене звільняти місце в моєму розкладі.",shape=box,color=red];
		j689344012 -> j2229880195;
	j2808683821 [label="Якщо тобі потрібна моя допомога, це не найкращий спосіб отримати її.",shape=box,color=red];
		j2808683821 -> j3806131216;
	j1206954402 [label="Я знаю, що в нас із тобою немає великого досвіду спілкування, насправді. Але я тут, щоб допомогти тобі.",shape=box,color=red];
		j1206954402 -> j3966506694;
	j3707756612 [label="Якщо моя пропозиція не відповідає твоїм стандартам, чи можу я підсолодити її для тебе?",shape=box,color=blue];
		j3707756612 -> j3701619831;
	j507676785 [label="+5 Chemistry",color=orange];
		j507676785 -> j1074932071;
	j1784488737 [label="+15 Chemistry",color=orange];
		j1784488737 -> j2632832041;
	j2229880195 [label="+5 Chemistry",color=orange];
		j2229880195 -> j3637594597;
	j3806131216 [label="І якщо ти хочеш моєї, то я пропоную, як уже казав, домовитися.",shape=box,color=blue];
		j3806131216 -> j3707756612;
	j3966506694 [label="І? А. Зрозуміло. Тобі не подобається мій «тон», чи не так? Мені страшенно шкода. Не думав, що ти так легко наїжачишся.",shape=box,color=blue];
		j3966506694 -> j3707756612;
	j3701619831 [label="Мені стало відомо, що довкола Деймоса точиться багато питань, де моя допомога може вважатися не лише вагомою, але й, насмілюся сказати, вирішальною.",shape=box,color=blue];
		j3701619831 -> j2437696752;
	j1074932071 [label="Ха! Я повинен поважати хоче б твою чесність.",shape=box,color=blue];
		j1074932071 -> j752118369;
	j2632832041 [label="Чудово. Добре знати, що з тобою хоча б… приємно мати справу.",shape=box,color=blue];
		j2632832041 -> j752118369;
	j3637594597 [label="Якби ж я міг передати, як я тут сміюся! Дякую, мандрівниче, за те, що не було нудно!",shape=box,color=blue];
		j3637594597 -> j2091446649;
	j2437696752 [label="Зокрема. Але не обмежуючись цим, примирення одного люблячого дворецького та відчуженої родини, яка живе нагорі.",shape=box,color=blue];
		j2437696752 -> j499211845;
	j752118369 [label="Boolean RoatheKnowsReset is now true.",color=orange];
		j752118369 -> j3778728127;
	j2091446649 [label="Add -1 to Thermostat counter",color=orange];
		j2091446649 -> j701401235;
	j499211845 [label="Родина, яка, як я вже згадував, навіть не підозрює, що ми тут унизу. І не знає про подальше існування Альбрехта, чи не так?",shape=box,color=blue];
		j499211845 -> j2468403357;
