	j3778728127 [label="Принаймні це буде цікаво.",shape=box,color=blue];
		j3778728127 -> "Chat ends.";
	j701401235 [label="Яка ж це була насолода! Я думаю, ми з тобою станемо друзями, насправді. Це було просто чудово.",shape=box,color=blue];
		j701401235 -> j83637669;
	j2468403357 [label="Ти пропонуєш допомогти переконати Лойда… поговорити з родиною Ентраті?",shape=box,color=red];
		j2468403357 -> j572316892;
	j887527327 [label="Я не можу переконати Лойда щось із цим зробити. Він стверджує, що це буде для них занадто боляче.",shape=box,color=red];
		j887527327 -> j847449716;
	j343383782 [label="Ні, вони не знають, що Альбрехт Ентраті все ще живий.",shape=box,color=red];
		j343383782 -> j3334601489;
	"Chat ends." [color=orange];
	j83637669 [label="Я думаю, ти вартуєш нагороди. І я зроблю свою частину угоди трохи солодшою для тебе. Така зухвалість зустрічається рідко.",shape=box,color=blue];
		j83637669 -> j3701619831;
	j572316892 [label="Не безплатно, мій узурпаторе, поневолений Порожнечею.",shape=box,color=blue];
		j572316892 -> j3467409822;
	j847449716 [label="Ти не можеш. Але я обіцяю… я зможу.",shape=box,color=blue];
		j847449716 -> j3467409822;
	j3334601489 [label="І те, що тобі не вдалося переконати того скорботного слугу? Обіцяю… я зможу.",shape=box,color=blue];
		j3334601489 -> j3467409822;
	j3467409822 [label="І от ми нарешті підійшли до моєї пропозиції: допоможи мені розібратися з моїми втраченими спогадами та дістатися «суті» всього цього — без підступів.",shape=box,color=blue];
		j3467409822 -> j980213686;
	j980213686 [label="І я подбаю про те, щоби наш сердешний слуга піднявся нагору. А тим часом я сидітиму мирно… і нікому не загрожуватиму. Що скажеш? Домовилися?",shape=box,color=blue];
