	j4082858284 [label="Check boolean RoathePolyamorySuccess",color=orange];
		j4082858284 -> j511900548 [label=true,color=green];
		j4082858284 -> "Chat ends." [label=false,color=brown];
	j444210037 [label="Агов, Роуте! Є хвилька? [Спитати про згоду на кількох партнерів]",shape=box,color=red];
		j444210037 -> j854649589;
	j3444814512 [label="[Завершити розмову]",shape=box,color=red];
		j3444814512 -> j604242687;
	j854649589 [label="Гм-м? Що таке?",shape=box,color=blue];
		j854649589 -> j1405146694;
	j604242687 [label="Boolean RoatheConsentComplete is now true.",color=orange];
		j604242687 -> "Chat ends.";
	j1405146694 [label="Хочу обговорити з тобою дещо, дізнатися, чи ти не проти.",shape=box,color=red];
		j1405146694 -> j1616482365;
	j1616482365 [label="Я не хочу, щоб у тебе була думка, що я брешу чи якось нечесно поводжуся.",shape=box,color=red];
		j1616482365 -> j1820730009;
	j1820730009 [label="Продовжуй. Звучить так, ніби це буде досить добре.",shape=box,color=blue];
		j1820730009 -> j4001741669;
	j4001741669 [label="Не хочу ставити тебе в незручне становище. Тож якщо відмовиш, то нічого страшного. Просто хочу, щоб ти знав.",shape=box,color=red];
		j4001741669 -> j2102002608;
	j2102002608 [label="Те, що в нас є, важливе для мене. Дуже-дуже. І воно реальне. Я не хочу, щоб ти сумнівався в цьому.",shape=box,color=red];
		j2102002608 -> j3834626668;
	j3834626668 [label="Стривай. Клянуся Порожнечею! Ти що, намагаєшся навшпиньки обійти новину про те, що в тебе з’явився ще один партнер?",shape=box,color=blue];
		j3834626668 -> j2709374443;
	j2709374443 [label="Ти мене за дурня маєш? Я вже знаю, мандрівниче!",shape=box,color=blue];
		j2709374443 -> j2177059528;
		j2709374443 -> j663119886;
	j2177059528 [label="То… ти не проти?",shape=box,color=red];
		j2177059528 -> j1488841176;
	j663119886 [label="Ти… знаєш?",shape=box,color=red];
		j663119886 -> j3378556597;
	j1488841176 [label="Якби ж ти тільки міг почути мій сміх зараз тут у святилищі. Мандрівниче, я орокін. Звісно, я не проти.",shape=box,color=blue];
		j1488841176 -> j2545788661;
	j3378556597 [label="Якби ж ти тільки міг почути мій сміх зараз тут у святилищі. Мандрівниче, мандрівниче, мандрівниче.",shape=box,color=blue];
		j3378556597 -> j488177422;
	j2545788661 [label="Думайте що завгодно про мій народ та нашу схильність насолоджуватися товариством інших у спосіб, який ви можете вважати зневажливим та принизливим, ми доволі добре розумілися і на коханні.",shape=box,color=blue];
		j2545788661 -> j2517903415;
	j488177422 [label="Я зрозумів у ту ж секунду, коли це сталося. У мене є свої методи. І ні, я анітрохи не проти. Я ж орокін.",shape=box,color=blue];
		j488177422 -> j2545788661;
	j2517903415 [label="Ніхто не розумів кохання так, як орокіни. І ми знали, що в серці може бути місце для більше ніж однієї людини. ",shape=box,color=blue];
		j2517903415 -> j2725991084;
	j2725991084 [label="Я просто розчарований тим, що фанатики, імовірно, надто вузьколобі, щоби приєднатися до веселощів.",shape=box,color=blue];
		j2725991084 -> j1075342928;
	j1075342928 [label="Тьху. Якщо подумати, то це, мабуть, і на краще. Уявляєш, які б нісенітниці це спричинило?",shape=box,color=blue];
		j1075342928 -> j717197121;
	j717197121 [label="Boolean RoatheConsentComplete is now true.",color=orange];
		j717197121 -> j2879906428;
	j2879906428 [label="Що ж, хай буде як буде. Якщо вони дарують тобі щастя, то насолоджуйся ними. Але коли ти зі мною…",shape=box,color=blue];
		j2879906428 -> j4060627590;
	j4060627590 [label="+5 Chemistry",color=orange];
		j4060627590 -> j268030471;
	j268030471 [label="То належиш тільки мені.",shape=box,color=blue];
		j268030471 -> "Chat ends.";
}