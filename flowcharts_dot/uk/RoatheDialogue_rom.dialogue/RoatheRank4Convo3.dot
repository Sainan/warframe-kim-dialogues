digraph {
	2475 [label="RoatheRank4Convo3 begins.",color=orange];
		2475 -> 2476;
	2476 [label="Скажи, узурпаторе. Якби в тебе дійшло до битви зі своїм тенно в смертельному бою, чи зможеш ти перемогти?",shape=box,color=blue];
		2476 -> 2478;
		2476 -> 2477;
		2476 -> 2479;
	2478 [label="Що? Але чому?",shape=box,color=red];
		2478 -> 2481;
	2477 [label="Я цю розмову не продовжуватиму.",shape=box,color=red];
		2477 -> 2480;
	2479 [label="[Завершити розмову]",shape=box,color=red];
		2479 -> 2482;
	2481 [label="Не знаю, чи ти усвідомлюєш, але «Лотос» — не просто свідома, що відповідальна за перенесення Луа в Порожнечу. Вона також значно втратила контроль над своїми електричними схемами.",shape=box,color=blue];
		2481 -> 2483;
		2481 -> 2484;
		2481 -> 2485;
		2481 -> 2486;
		2481 -> 2487;
	2480 [label="Я не намагаюся бути грубим. Я запитую цілком серйозно. Це суто прагматична розмова. ",shape=box,color=blue];
		2480 -> 2481;
	2482 [label="Chat ends.",color=orange];
	2483 [label="З нею все гаразд. Ти не знаєш, про що говориш.",shape=box,color=red];
		2483 -> 2488;
	2484 [label="Утратила контроль над електричними схемами? Ти про що?",shape=box,color=red];
		2484 -> 2489;
	2485 [label="Ні. Я не продовжуватиму. Лотос урятувала мені життя. Вона рятувала життя тенно незліченну кількість разів. Ми всім їй завдячуємо.",shape=box,color=red];
		2485 -> 2490;
	2486 [label="Стулися, Роуте. Я з тобою не розмовлятиму. [Завершити розмову]",shape=box,color=red];
		2486 -> 2491;
	2487 [label="Так, я також переймаюся через це. Але вона стільки для нас зробила, що я не зможу від неї відвернутися. Я маю її підтримувати.",shape=box,color=red];
		2487 -> 2492;
	2488 [label="Не знаю? Зверни увагу! Озирнись навколо! Скільки місяців вона стояла на краю скелі, тримаючи в руках старовинний передавач і наспівуючи щось собі під ніс? Дивлячись у Порожнечу?",shape=box,color=blue];
		2488 -> 2493;
	2489 [label="Скільки місяців вона стояла на краю скелі, тримаючи в руках старовинний передавач і наспівуючи щось собі під ніс? Дивлячись у Порожнечу?",shape=box,color=blue];
		2489 -> 2493;
	2490 [label="Я не байдужий. Я розумію, як воно. Ти багато їй завдячуєш. Я не кажу тобі вбивати її, я кажу тобі перестати дозволяти їй впливати на твоє оточення.",shape=box,color=blue];
		2490 -> 2489;
	2491 [label="Як скажеш. Але коли все довкола тебе почне руйнуватися, не повзи до мене.",shape=box,color=blue];
		2491 -> 2494;
	2492 [label="+5 Chemistry",color=orange];
		2492 -> 2495;
	2493 [label="А тепер вона просто… нависає? У темряві? Посилає твою дитячу подобу дедалі глибше в її спогади. Заради чого? Шляху додому лише через те, що Альбрехт клацнув пальцями й прошепотів чарівне слово?",shape=box,color=blue];
		2493 -> 2496;
	2494 [label="Chat ends.",color=orange];
	2495 [label="Я не байдужий. Я розумію, як воно. Ти багато їй завдячуєш. Я не кажу тобі вбивати її, я кажу тобі перестати дозволяти їй впливати на твоє оточення.",shape=box,color=blue];
		2495 -> 2497;
	2496 [label="Хіба це не здається тобі підозрілим? Хіба не здається небезпечним? Це пастка. Нею маніпулюють. Або Альбрехт, або те, що зветься «Байдужістю». Вона — зламаний протокол. Її настанови дають збій.",shape=box,color=blue];
		2496 -> 2498;
	2497 [label="Коли вона стояла на краю скелі, тримаючи в руках старовинний передавач і наспівуючи щось собі під ніс? Дивлячись у Порожнечу? Тобі не здавалося, що вона стрибне?",shape=box,color=blue];
		2497 -> 2493;
	2498 [label="Я не думаю, що вона прагне зла. Я думаю, що її просто використовують. Але коли настане час, тобі, можливо, доведеться захищатися. Або, можливо, доведеться їх зупиняти.",shape=box,color=blue];
		2498 -> 2499;
	2499 [label="І хоча я вірю (сподіваюсь), що ти матимеш достатньо глузду уникнути другої ітерації того, як Лотос стає проблемою, її здичавіла дитяча армія його не матиме. Тож я спитаю ще раз:",shape=box,color=blue];
		2499 -> 2500;
	2500 [label="Як ти думаєш, хто переможе, якщо настане жахливий день і тобі доведеться битися усіма своїми силами? Ти й усе, що маєш, проти всіх тенно та Лотос?",shape=box,color=blue];
		2500 -> 2501;
		2500 -> 2502;
		2500 -> 2503;
	2501 [label="Якась маячня. Ні.",shape=box,color=red];
		2501 -> 2504;
	2502 [label="Це ж… їх сотні, Роуте, а я один.",shape=box,color=red];
		2502 -> 2505;
	2503 [label="Навіть не знаю звідки почати.",shape=box,color=red];
		2503 -> 2506;
	2504 [label="Ну вважай це просто дурною грою! Теоретична гра, в яку грають діти. ",shape=box,color=blue];
		2504 -> 2507;
		2504 -> 2508;
	2505 [label="+5 Chemistry",color=orange];
		2505 -> 2509;
	2506 [label="Тоді дуже добре, що ти розмовляєш з «Дияволом Тау». Є причина, чому мене знають як стратега. Почнімо з бази — із чисельності. Тут ти жахливо поступаєшся. ",shape=box,color=blue];
		2506 -> 2510;
	2507 [label="Це не гра.",shape=box,color=red];
		2507 -> 2511;
	2508 [label="Ще раз кажу. Ні. [Завершити розмову]",shape=box,color=red];
		2508 -> 2512;
	2509 [label="Чудово. Ми встановили перше правило планування поля бою: чисельність. Доволі очевидно, що тут ти жахливо поступаєшся.",shape=box,color=blue];
		2509 -> 2510;
	2510 [label="Check boolean IsDating",color=orange];
		2510 -> 2513 [label=true,color=green];
		2510 -> 2514 [label=false,color=brown];
	2511 [label="Маєш рацію. Це не гра. І колись це може стати питанням життя і смерті. Ти проти твоєї маленької… мініатюрної версії. І зграї лютих диких супутників.",shape=box,color=blue];
		2511 -> 2515;
	2512 [label="Chat ends.",color=orange];
	2513 [label="Але якщо чутки про твою «особисту діяльність» та любовні справи серед протофреймів в інших часових лініях можна було б… використати, можливо, ці ресурси можна буде якось викликати. Для цієї мети потрібно буде спеціально дослідити і виростити гельмінтів…",shape=box,color=blue];
		2513 -> 2516;
	2514 [label="Я чув розповіді про твою взаємодію з іншими протофреймами в інших часових лініях. Можливо, ці ресурси можна буде якось викликати. Для цієї мети потрібно буде спеціально дослідити і виростити гельмінтів…",shape=box,color=blue];
		2514 -> 2516;
	2515 [label="Дикі супутники, які, до речі, вже довели свою жорстокість, неслухняність і, як відомо, жорстоко виганяють своїх же за те, що вони занадто відрізняються від їхніх поглядів на нормальність.",shape=box,color=blue];
		2515 -> 2517;
		2515 -> 2518;
		2515 -> 2519;
	2516 [label="Навіть не знаю, чи це реально, але це забезпечило нам прохід сюди, тому не бачу причин, чому б і ні…",shape=box,color=blue];
		2516 -> 2520;
		2516 -> 2521;
		2516 -> 2522;
	2517 [label="Ти хочеш сказати, що тенно — зло?",shape=box,color=red];
		2517 -> 2523;
	2518 [label="Що ти хочеш сказати?",shape=box,color=red];
		2518 -> 2524;
	2519 [label="Ні. Усе, більше не витримаю. [Завершити розмову]",shape=box,color=red];
		2519 -> 2525;
	2520 [label="Роуте… у пекло тобі дорога.",shape=box,color=red];
		2520 -> 2526;
	2521 [label="Я не збираюся нікого втягувати в цей безлад.",shape=box,color=red];
		2521 -> 2527;
	2522 [label="Мене тривожить те, скільки ти над цим розмірковував.",shape=box,color=red];
		2522 -> 2528;
	2523 [label="Ні, не зло. Я не вірю у «зло», узурпаторе. Ніколи не вірив і ніколи не віритиму. Я вірю, що тенно — дивовижні та прекрасні люди, як і всі інші. Просто люди. А що ще? Вони діти.",shape=box,color=blue];
		2523 -> 2529;
	2524 [label="Що може настати час, якийсь жахливий день, коли тобі потрібно буде зробити немислиме.",shape=box,color=blue];
		2524 -> 2530;
	2525 [label="Тікай від розмови, якщо хочеш, але ти знаєш, що все сказане мною — правда. Ти просто не хочеш це прийняти.",shape=box,color=blue];
		2525 -> 2531;
	2526 [label="+5 Chemistry",color=orange];
		2526 -> 2532;
	2527 [label="А, то ти визнаєш, що є безлад. Це вже щось. Можу я хоч завершити свою думку?",shape=box,color=blue];
		2527 -> 2533;
		2527 -> 2534;
	2528 [label="А мене тривожить, що ти, очевидно, ні. Можу я хоч завершити свою думку?",shape=box,color=blue];
		2528 -> 2533;
		2528 -> 2534;
	2529 [label="Діти, яким доручили зіткнутися з жахами та вчиняти звірства, подібні яким на моїх очах ламали загартованих орокінських воїнів, життя яких охоплює сотні років.",shape=box,color=blue];
		2529 -> 2535;
	2530 [label="Тенно — дивовижні та прекрасні люди, як і всі інші. Просто люди. А що ще? Вони діти.",shape=box,color=blue];
		2530 -> 2529;
	2531 [label="Chat ends.",color=orange];
	2532 [label="Я вже там, узурпаторе. Я вже там.",shape=box,color=blue];
		2532 -> 2536;
	2533 [label="Так. Давай. Уперед. Я слухаю.",shape=box,color=red];
		2533 -> 2537;
	2534 [label="Ні. Я більше не витримаю.",shape=box,color=red];
		2534 -> 2538;
	2535 [label="Я бачив, як дакси — позолочені добірні дакси! — кидали свої священні позолочені мечі й тікали з поля бою, на яке тенно увірвалися зі своїми ворфреймами.",shape=box,color=blue];
		2535 -> 2539;
	2536 [label="Update boolean RoatheNoDate",color=orange];
		2536 -> 2540;
	2537 [label="+5 Chemistry",color=orange];
		2537 -> 2541;
	2538 [label="Як і я.",shape=box,color=blue];
		2538 -> 2540;
	2539 [label="Їхні уявні кокони зараженого прихистку захищали їхні тіла, але не розум. Вони не винні в тому, якими вони є.",shape=box,color=blue];
		2539 -> 2542;
	2540 [label="Chat ends.",color=orange];
	2541 [label="Дякую. Може настати час, якийсь жахливий день, коли тобі потрібно буде зробити немислиме.",shape=box,color=blue];
		2541 -> 2530;
	2542 [label="Змучені Порожнечею… змушені вбивати або стати свідками смерті власних батьків… потрапили під загрозу війни… у них викрадають пам’ять… їх кладуть у кріосон на століття…",shape=box,color=blue];
		2542 -> 2543;
	2543 [label="Те, що вони геть не збожеволіли — це диво, узурпаторе. Я не кажу, що щось піде не так. Я просто кажу, що це може статися. І що в тебе має бути план на випадок, якщо це станеться.",shape=box,color=blue];
		2543 -> 2544;
	2544 [label="Бути готовим до найгіршого нікому не зашкодить. Зашкодить, якщо не бути готовим.",shape=box,color=blue];
		2544 -> 2545;
		2544 -> 2546;
		2544 -> 2547;
		2544 -> 2548;
	2545 [label="Я… триматиму руку на пульсі. Гаразд? Але я не ховатимуться за кимось.",shape=box,color=red];
		2545 -> 2549;
	2546 [label="Мені геть не подобається, що в цьому мушу погодитися з тобою.",shape=box,color=red];
		2546 -> 2550;
	2547 [label="Ти ж розумієш, що мене спіткало те ж, що й тенно?",shape=box,color=red];
		2547 -> 2551;
	2548 [label="Я не зраджу їхню довіру.",shape=box,color=red];
		2548 -> 2552;
	2549 [label="+5 Chemistry",color=orange];
		2549 -> 2553;
	2550 [label="+5 Chemistry",color=orange];
		2550 -> 2554;
	2551 [label="А хто може сказати, що я не веду з ними таку ж розмову?",shape=box,color=blue];
		2551 -> 2555;
	2552 [label="А я й не пропонував тобі це.",shape=box,color=blue];
		2552 -> 2556;
	2553 [label="Звісно! Це все, про що міг просити диявол. Дякую.",shape=box,color=blue];
		2553 -> 2557;
	2554 [label="Гм. Це просто відчуття повернення здорового глузду до твого мозку після стількох років. Ти звикнеш.",shape=box,color=blue];
		2554 -> 2558;
	2555 [label="Гарних тобі снів, узурпаторе. ",shape=box,color=blue];
		2555 -> 2559;
	2556 [label="Add 1 to Thermostat",color=orange];
		2556 -> 2560;
	2557 [label="Add 1 to Thermostat",color=orange];
		2557 -> 2561;
	2558 [label="Add -1 to Thermostat",color=orange];
		2558 -> 2562;
	2559 [label="Add -1 to Thermostat",color=orange];
		2559 -> 2563;
	2560 [label="Chat ends.",color=orange];
	2561 [label="Chat ends.",color=orange];
	2562 [label="Chat ends.",color=orange];
	2563 [label="Chat ends.",color=orange];
}