digraph {
	"RoatheRank4Convo3 begins." [color=orange];
		"RoatheRank4Convo3 begins." -> j3787706834;
	j3787706834 [label="Скажи, узурпаторе. Якби в тебе дійшло до битви зі своїм тенно в смертельному бою, чи зможеш ти перемогти?",shape=box,color=blue];
		j3787706834 -> j377659059;
		j3787706834 -> j2706263071;
		j3787706834 -> j1478915251;
	j377659059 [label="Що? Але чому?",shape=box,color=red];
		j377659059 -> j1920396450;
	j2706263071 [label="Я цю розмову не продовжуватиму.",shape=box,color=red];
		j2706263071 -> j2638329022;
	j1478915251 [label="[Завершити розмову]",shape=box,color=red];
		j1478915251 -> "Chat ends.";
	j1920396450 [label="Не знаю, чи ти усвідомлюєш, але «Лотос» — не просто свідома, що відповідальна за перенесення Луа в Порожнечу. Вона також значно втратила контроль над своїми електричними схемами.",shape=box,color=blue];
		j1920396450 -> j282763883;
		j1920396450 -> j3865016353;
		j1920396450 -> j1863196498;
		j1920396450 -> j3693775131;
		j1920396450 -> j2505260506;
	j2638329022 [label="Я не намагаюся бути грубим. Я запитую цілком серйозно. Це суто прагматична розмова. ",shape=box,color=blue];
		j2638329022 -> j1920396450;
	"Chat ends." [color=orange];
	j282763883 [label="З нею все гаразд. Ти не знаєш, про що говориш.",shape=box,color=red];
		j282763883 -> j2380954285;
	j3865016353 [label="Утратила контроль над електричними схемами? Ти про що?",shape=box,color=red];
		j3865016353 -> j3763140056;
	j1863196498 [label="Ні. Я не продовжуватиму. Лотос урятувала мені життя. Вона рятувала життя тенно незліченну кількість разів. Ми всім їй завдячуємо.",shape=box,color=red];
		j1863196498 -> j2525926698;
	j3693775131 [label="Стулися, Роуте. Я з тобою не розмовлятиму. [Завершити розмову]",shape=box,color=red];
		j3693775131 -> j390210771;
	j2505260506 [label="Так, я також переймаюся через це. Але вона стільки для нас зробила, що я не зможу від неї відвернутися. Я маю її підтримувати.",shape=box,color=red];
		j2505260506 -> j2366395523;
	j2380954285 [label="Не знаю? Зверни увагу! Озирнись навколо! Скільки місяців вона стояла на краю скелі, тримаючи в руках старовинний передавач і наспівуючи щось собі під ніс? Дивлячись у Порожнечу?",shape=box,color=blue];
		j2380954285 -> j3503654295;
	j3763140056 [label="Скільки місяців вона стояла на краю скелі, тримаючи в руках старовинний передавач і наспівуючи щось собі під ніс? Дивлячись у Порожнечу?",shape=box,color=blue];
		j3763140056 -> j3503654295;
	j2525926698 [label="Я не байдужий. Я розумію, як воно. Ти багато їй завдячуєш. Я не кажу тобі вбивати її, я кажу тобі перестати дозволяти їй впливати на твоє оточення.",shape=box,color=blue];
		j2525926698 -> j3763140056;
	j390210771 [label="Як скажеш. Але коли все довкола тебе почне руйнуватися, не повзи до мене.",shape=box,color=blue];
		j390210771 -> "Chat ends.";
	j2366395523 [label="+5 Chemistry",color=orange];
		j2366395523 -> j188880491;
	j3503654295 [label="А тепер вона просто… нависає? У темряві? Посилає твою дитячу подобу дедалі глибше в її спогади. Заради чого? Шляху додому лише через те, що Альбрехт клацнув пальцями й прошепотів чарівне слово?",shape=box,color=blue];
		j3503654295 -> j496180670;
	j188880491 [label="Я не байдужий. Я розумію, як воно. Ти багато їй завдячуєш. Я не кажу тобі вбивати її, я кажу тобі перестати дозволяти їй впливати на твоє оточення.",shape=box,color=blue];
		j188880491 -> j315664834;
	j496180670 [label="Хіба це не здається тобі підозрілим? Хіба не здається небезпечним? Це пастка. Нею маніпулюють. Або Альбрехт, або те, що зветься «Байдужістю». Вона — зламаний протокол. Її настанови дають збій.",shape=box,color=blue];
		j496180670 -> j1570307269;
	j315664834 [label="Коли вона стояла на краю скелі, тримаючи в руках старовинний передавач і наспівуючи щось собі під ніс? Дивлячись у Порожнечу? Тобі не здавалося, що вона стрибне?",shape=box,color=blue];
		j315664834 -> j3503654295;
	j1570307269 [label="Я не думаю, що вона прагне зла. Я думаю, що її просто використовують. Але коли настане час, тобі, можливо, доведеться захищатися. Або, можливо, доведеться їх зупиняти.",shape=box,color=blue];
		j1570307269 -> j61006794;
	j61006794 [label="І хоча я вірю (сподіваюсь), що ти матимеш достатньо глузду уникнути другої ітерації того, як Лотос стає проблемою, її здичавіла дитяча армія його не матиме. Тож я спитаю ще раз:",shape=box,color=blue];
		j61006794 -> j1529475601;
	j1529475601 [label="Як ти думаєш, хто переможе, якщо настане жахливий день і тобі доведеться битися усіма своїми силами? Ти й усе, що маєш, проти всіх тенно та Лотос?",shape=box,color=blue];
		j1529475601 -> j27406082;
		j1529475601 -> j3284617219;
		j1529475601 -> j2429885334;
	j27406082 [label="Якась маячня. Ні.",shape=box,color=red];
		j27406082 -> j2105257332;
	j3284617219 [label="Це ж… їх сотні, Роуте, а я один.",shape=box,color=red];
		j3284617219 -> j1693065458;
	j2429885334 [label="Навіть не знаю звідки почати.",shape=box,color=red];
		j2429885334 -> j2434633593;
	j2105257332 [label="Ну вважай це просто дурною грою! Теоретична гра, в яку грають діти. ",shape=box,color=blue];
		j2105257332 -> j3702400578;
		j2105257332 -> j127959683;
	j1693065458 [label="+5 Chemistry",color=orange];
		j1693065458 -> j1688541835;
	j2434633593 [label="Тоді дуже добре, що ти розмовляєш з «Дияволом Тау». Є причина, чому мене знають як стратега. Почнімо з бази — із чисельності. Тут ти жахливо поступаєшся. ",shape=box,color=blue];
		j2434633593 -> j4181059854;
	j3702400578 [label="Це не гра.",shape=box,color=red];
		j3702400578 -> j1929857808;
	j127959683 [label="Ще раз кажу. Ні. [Завершити розмову]",shape=box,color=red];
		j127959683 -> "Chat ends.";
	j1688541835 [label="Чудово. Ми встановили перше правило планування поля бою: чисельність. Доволі очевидно, що тут ти жахливо поступаєшся.",shape=box,color=blue];
		j1688541835 -> j4181059854;
	j4181059854 [label="Check boolean IsDating",color=orange];
		j4181059854 -> j3546066421 [label=true,color=green];
		j4181059854 -> j2413068376 [label=false,color=brown];
	j1929857808 [label="Маєш рацію. Це не гра. І колись це може стати питанням життя і смерті. Ти проти твоєї маленької… мініатюрної версії. І зграї лютих диких супутників.",shape=box,color=blue];
		j1929857808 -> j2346060376;
	j3546066421 [label="Але якщо чутки про твою «особисту діяльність» та любовні справи серед протофреймів в інших часових лініях можна було б… використати, можливо, ці ресурси можна буде якось викликати. Для цієї мети потрібно буде спеціально дослідити і виростити гельмінтів…",shape=box,color=blue];
		j3546066421 -> j2573712294;
	j2413068376 [label="Я чув розповіді про твою взаємодію з іншими протофреймами в інших часових лініях. Можливо, ці ресурси можна буде якось викликати. Для цієї мети потрібно буде спеціально дослідити і виростити гельмінтів…",shape=box,color=blue];
		j2413068376 -> j2573712294;
	j2346060376 [label="Дикі супутники, які, до речі, вже довели свою жорстокість, неслухняність і, як відомо, жорстоко виганяють своїх же за те, що вони занадто відрізняються від їхніх поглядів на нормальність.",shape=box,color=blue];
		j2346060376 -> j2784465218;
		j2346060376 -> j3536561231;
		j2346060376 -> j1134233291;
	j2573712294 [label="Навіть не знаю, чи це реально, але це забезпечило нам прохід сюди, тому не бачу причин, чому б і ні…",shape=box,color=blue];
		j2573712294 -> j541466509;
		j2573712294 -> j4172667106;
		j2573712294 -> j282260460;
	j2784465218 [label="Ти хочеш сказати, що тенно — зло?",shape=box,color=red];
		j2784465218 -> j1139388280;
	j3536561231 [label="Що ти хочеш сказати?",shape=box,color=red];
		j3536561231 -> j1369453818;
	j1134233291 [label="Ні. Усе, більше не витримаю. [Завершити розмову]",shape=box,color=red];
		j1134233291 -> j1168998004;
	j541466509 [label="Роуте… у пекло тобі дорога.",shape=box,color=red];
		j541466509 -> j1555037281;
	j4172667106 [label="Я не збираюся нікого втягувати в цей безлад.",shape=box,color=red];
		j4172667106 -> j2115515286;
	j282260460 [label="Мене тривожить те, скільки ти над цим розмірковував.",shape=box,color=red];
		j282260460 -> j3827842634;
	j1139388280 [label="Ні, не зло. Я не вірю у «зло», узурпаторе. Ніколи не вірив і ніколи не віритиму. Я вірю, що тенно — дивовижні та прекрасні люди, як і всі інші. Просто люди. А що ще? Вони діти.",shape=box,color=blue];
		j1139388280 -> j1404699868;
	j1369453818 [label="Що може настати час, якийсь жахливий день, коли тобі потрібно буде зробити немислиме.",shape=box,color=blue];
		j1369453818 -> j2090882858;
	j1168998004 [label="Тікай від розмови, якщо хочеш, але ти знаєш, що все сказане мною — правда. Ти просто не хочеш це прийняти.",shape=box,color=blue];
		j1168998004 -> "Chat ends.";
	j1555037281 [label="+5 Chemistry",color=orange];
		j1555037281 -> j1225715197;
	j2115515286 [label="А, то ти визнаєш, що є безлад. Це вже щось. Можу я хоч завершити свою думку?",shape=box,color=blue];
		j2115515286 -> j1367647489;
		j2115515286 -> j469044560;
	j3827842634 [label="А мене тривожить, що ти, очевидно, ні. Можу я хоч завершити свою думку?",shape=box,color=blue];
		j3827842634 -> j1367647489;
		j3827842634 -> j469044560;
	j1404699868 [label="Діти, яким доручили зіткнутися з жахами та вчиняти звірства, подібні яким на моїх очах ламали загартованих орокінських воїнів, життя яких охоплює сотні років.",shape=box,color=blue];
		j1404699868 -> j2779462670;
	j2090882858 [label="Тенно — дивовижні та прекрасні люди, як і всі інші. Просто люди. А що ще? Вони діти.",shape=box,color=blue];
		j2090882858 -> j1404699868;
	j1225715197 [label="Я вже там, узурпаторе. Я вже там.",shape=box,color=blue];
		j1225715197 -> j155006797;
	j1367647489 [label="Так. Давай. Уперед. Я слухаю.",shape=box,color=red];
		j1367647489 -> j2542049397;
	j469044560 [label="Ні. Я більше не витримаю.",shape=box,color=red];
		j469044560 -> j3866562943;
	j2779462670 [label="Я бачив, як дакси — позолочені добірні дакси! — кидали свої священні позолочені мечі й тікали з поля бою, на яке тенно увірвалися зі своїми ворфреймами.",shape=box,color=blue];
		j2779462670 -> j1852241425;
	j155006797 [label="Boolean RoatheNoDate is now true.",color=orange];
		j155006797 -> "Chat ends.";
	j2542049397 [label="+5 Chemistry",color=orange];
		j2542049397 -> j497805068;
	j3866562943 [label="Як і я.",shape=box,color=blue];
		j3866562943 -> "Chat ends.";
	j1852241425 [label="Їхні уявні кокони зараженого прихистку захищали їхні тіла, але не розум. Вони не винні в тому, якими вони є.",shape=box,color=blue];
		j1852241425 -> j3432060141;
	j497805068 [label="Дякую. Може настати час, якийсь жахливий день, коли тобі потрібно буде зробити немислиме.",shape=box,color=blue];
		j497805068 -> j2090882858;
	j3432060141 [label="Змучені Порожнечею… змушені вбивати або стати свідками смерті власних батьків… потрапили під загрозу війни… у них викрадають пам’ять… їх кладуть у кріосон на століття…",shape=box,color=blue];
		j3432060141 -> j2838721358;
	j2838721358 [label="Те, що вони геть не збожеволіли — це диво, узурпаторе. Я не кажу, що щось піде не так. Я просто кажу, що це може статися. І що в тебе має бути план на випадок, якщо це станеться.",shape=box,color=blue];
		j2838721358 -> j879919351;
	j879919351 [label="Бути готовим до найгіршого нікому не зашкодить. Зашкодить, якщо не бути готовим.",shape=box,color=blue];
		j879919351 -> j3009233282;
		j879919351 -> j3087615985;
		j879919351 -> j2259138845;
		j879919351 -> j1818556747;
	j3009233282 [label="Я… триматиму руку на пульсі. Гаразд? Але я не ховатимуться за кимось.",shape=box,color=red];
		j3009233282 -> j1870372534;
	j3087615985 [label="Мені геть не подобається, що в цьому мушу погодитися з тобою.",shape=box,color=red];
		j3087615985 -> j798805284;
	j2259138845 [label="Ти ж розумієш, що мене спіткало те ж, що й тенно?",shape=box,color=red];
		j2259138845 -> j1140255414;
	j1818556747 [label="Я не зраджу їхню довіру.",shape=box,color=red];
		j1818556747 -> j2012781406;
	j1870372534 [label="+5 Chemistry",color=orange];
		j1870372534 -> j3817358803;
	j798805284 [label="+5 Chemistry",color=orange];
		j798805284 -> j2055868821;
	j1140255414 [label="А хто може сказати, що я не веду з ними таку ж розмову?",shape=box,color=blue];
		j1140255414 -> j24609362;
	j2012781406 [label="А я й не пропонував тобі це.",shape=box,color=blue];
		j2012781406 -> j346357367;
	j3817358803 [label="Звісно! Це все, про що міг просити диявол. Дякую.",shape=box,color=blue];
		j3817358803 -> j346357367;
	j2055868821 [label="Гм. Це просто відчуття повернення здорового глузду до твого мозку після стількох років. Ти звикнеш.",shape=box,color=blue];
		j2055868821 -> j321621700;
	j24609362 [label="Гарних тобі снів, узурпаторе. ",shape=box,color=blue];
		j24609362 -> j321621700;
	j346357367 [label="Add 1 to Thermostat counter",color=orange];
		j346357367 -> "Chat ends.";
	j321621700 [label="Add -1 to Thermostat counter",color=orange];
		j321621700 -> "Chat ends.";
}