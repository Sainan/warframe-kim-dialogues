	j2766603151 [label="Старий Роут скористався б можливістю, щоб вирізати нирки з її тіла, але я виявив, що більше не маю бажання це робити. ",shape=box,color=blue];
		j2766603151 -> j419306236;
	j4065614684 [label="Я зібрав волю в кулак, щоб не вирізати нирки з її тіла. Але вона просто хотіла втішити мене.",shape=box,color=blue];
		j4065614684 -> j2869545730;
	j3519931689 [label="Вона просто хотіла втішити мене.",shape=box,color=blue];
