		j598317519 -> j3519931689 [label="false",color=purple];
	j2656821760 [label="Гадаю, він також знає, як це — бути продуктом свого суспільства та свого контексту. Можливо, він більше співчуває твоєму минулому, ніж ти думаєш.",shape=box,color=red];
		j2656821760 -> j426339107;
