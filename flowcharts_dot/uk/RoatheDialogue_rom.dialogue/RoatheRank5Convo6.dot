		j1224310867 -> j128534279;
	j875370458 [label="+5 Chemistry",color=orange];
		j875370458 -> j4150751275;
	j1311195463 [label="Кілька ночей потому, коли я сидів і мовчки читав сам, він підійшов до мене.",shape=box,color=blue];
		j1311195463 -> j1822335368;
	j536519680 [label="Я обійняв її, звісно. Я орокін, але не чудовисько.",shape=box,color=blue];
		j536519680 -> j3328912753;
	j358709750 [label="Той священник. Якщо треба підсумувати, то скажу так: його стійкість якимось чином така ж безкінечна, як і сам час. ",shape=box,color=blue];
		j358709750 -> j1452613453;
	j224955554 [label="Він це майже не згадував. За що я йому глибоко вдячний. Я очікував глузування. «Нарешті диявола подолано». Але ні. Вони живуть так, ніби мало що змінилося.",shape=box,color=blue];
		j224955554 -> j1673463013;
	j2401546210 [label="Старий Роут скористався б можливістю, щоб вирізати нирки з її тіла, але я виявив, що більше не маю бажання це робити. ",shape=box,color=blue];
		j2401546210 -> j4124897694;
	j81681489 [label="Я зібрав волю в кулак, щоб не вирізати нирки з її тіла. Але вона просто хотіла втішити мене.",shape=box,color=blue];
		j81681489 -> j2533370917;
	j3686381113 [label="Вона просто хотіла втішити мене.",shape=box,color=blue];
		j3686381113 -> j152868632;
	j128534279 [label="Так. Маю подякувати тобі за це?",shape=box,color=blue];
		j128534279 -> j1198835908;
	j4150751275 [label="Гадаю, це виявиться чимось більшим. Навіть якщо я зневажаю цей факт. Зрештою, я не можу не потрапити в їхню пастку.",shape=box,color=blue];
		j4150751275 -> j1198835908;
	j1822335368 [label="Він сів поруч і розповів мені, як ставив під сумнів свою віру відтоді, як Ентраті дав йому сироватку. Як він соромився своїх сумнівів. Як він шкодував, що прийняв ту сироватку.",shape=box,color=blue];
		j1822335368 -> j377451001;
	j3328912753 [label="І відтоді?",shape=box,color=blue];
		j3328912753 -> j4234361785;
	j1452613453 [label="Для такої розбитої людини, цікаво, що він ще не розвалився.",shape=box,color=blue];
		j1452613453 -> j1622505995;
	j4124897694 [label="Уперше за своє жалюгідне життя я прийняв просту пропозицію розради такою, якою вона була.",shape=box,color=blue];
		j4124897694 -> j2533370917;
	j2533370917 [label="Це був простий спосіб сказати мені, що, можливо, їй байдуже, як і мені. І що вона шкодує про весь біль, який я собі через це завдавав.",shape=box,color=blue];
