	j426339107 [label="+10 Chemistry",color=orange];
		j426339107 -> j4143558432;
	j3479165439 [label="+5 Chemistry",color=orange];
		j3479165439 -> j2160395989;
	j2338716285 [label="Я потиснув йому руку. І подякував як друг. Я орокін, але не чудовисько.",shape=box,color=blue];
		j2338716285 -> j1529033729;
	j4154450217 [label="Коли я розповів їй правду, яку ми взнали, вона нічого не сказала. Натомість просто… обійняла мене.",shape=box,color=blue];
		j4154450217 -> j1093047434;
	j3315820923 [label="Особливо після всього, що вона дізналася про Ентраті. Вона знає, що люди можуть бути складнішими, ніж просто чорно-білі.",shape=box,color=red];
		j3315820923 -> j1224310867;
	j1349862023 [label="Мені просто радісно, що ви двоє маєте таку дружбу. Навіть якщо це просто перемир’я.",shape=box,color=red];
		j1349862023 -> j875370458;
	j419306236 [label="Уперше за своє жалюгідне життя я прийняв просту пропозицію розради такою, якою вона була.",shape=box,color=blue];
		j419306236 -> j2869545730;
	j2869545730 [label="Це був простий спосіб сказати мені, що, можливо, їй байдуже, як і мені. І що вона шкодує про весь біль, який я собі через це завдавав.",shape=box,color=blue];
		j2869545730 -> j2140171118;
		j2869545730 -> j2515405157;
	j2140171118 [label="А що Ліон?",shape=box,color=red];
		j2140171118 -> j1311195463;
	j2515405157 [label="І що ти зробив?",shape=box,color=red];
		j2515405157 -> j536519680;
	j4143558432 [label="Боюся, ти маєш рацію. Доля завдала йому жахливої шкоди, і він зробив усе можливе, щоби протистояти їй.",shape=box,color=blue];
		j4143558432 -> j358709750;
	j2160395989 [label="Гадаю, це виявиться чимось більшим. Навіть якщо я зневажаю цей факт. Зрештою, я не можу не потрапити в їхню пастку.",shape=box,color=blue];
		j2160395989 -> j358709750;
	j1529033729 [label="І відтоді?",shape=box,color=blue];
		j1529033729 -> j224955554;
	j1093047434 [label="Evaluate expressions",color=orange];
