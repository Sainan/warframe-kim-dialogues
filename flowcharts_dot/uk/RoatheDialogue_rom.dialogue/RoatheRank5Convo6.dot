	j3304071659 [label="А найголовніше — як він бажав забути все це. І що, можливо, на якомусь глибшому рівні ми не були всі однакові, ми троє.",shape=box,color=blue];
		j3304071659 -> j3748830699;
		j3304071659 -> j2486898820;
	j2824744730 [label="Особливо Марі. Гадаю, вона розуміє, що постійні суперечки зі мною щодо минулого нічого не дадуть.",shape=box,color=blue];
		j2824744730 -> j3137425038;
