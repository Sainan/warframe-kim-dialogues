		j1172864870 -> j3693792744 [label="LyonRell3",color=purple];
		j1172864870 -> j165831421 [label="LyonConfession2",color=purple];
		j1172864870 -> j2106467583 [label="false",color=purple];
	j2813753334 [label="Evaluate expressions",color=orange];
		j2813753334 -> j3691881044 [label="RoatheVillain",color=purple];
		j2813753334 -> j1582991873 [label="RoatheRedeemed",color=purple];
		j2813753334 -> j2164205610 [label="false",color=purple];
	j95744273 [label="Що я думаю про Марі? Окрім спроб переконати тебе дозволити їй приєднатися до нас на ніч чи дві, мандрівниче? Жартую. Жартую.",shape=box,color=blue];
		j95744273 -> j654884717;
	j3866041223 [label="Що я думаю про Марі? Окрім спроб переконати тебе дозволити їй приєднатися до нас на ніч чи дві? Жартую. Жартую.",shape=box,color=blue];
		j3866041223 -> j2329834350;
	j403862386 [label="Чи вдалося тобі переконати її змінити думку щодо чистоти Альбрехта? Оце справжнє чудо. Можливо, їм слід поклонятися не Солу та Луа, а тобі.",shape=box,color=blue];
		j403862386 -> j520456200;
	j864412692 [label="Я ніколи не знав, що вона досі щодня відчуває біль. Вона приховує його, ніби його й немає. Вона не говорила про це, доки не розповіла тобі. Тобі якимось чином вдалося подолати між нами.",shape=box,color=blue];
		j864412692 -> j1901161908;
	j3636788554 [label="Я не знав про її виховання донедавна. Вона ніколи не розповідала мені свою історію, доки не розповіла її тобі. Тобі якимось чином вдалося подолати між нами.",shape=box,color=blue];
		j3636788554 -> j4255488871;
	j3480310551 [label="Те саме, що й завжди. Я кожну хвилину намагаюся не відірвати собі обличчя кігтями через відчайдушне бажання заглушити її.",shape=box,color=blue];
		j3480310551 -> "Chat ends.";
	j267477611 [label="Тепер уже краще, бо в мене є дехто, кому можна вилити своє роздратування. Але якщо серйозно, напруженість між нами значно зменшилася.",shape=box,color=blue];
		j267477611 -> j1344872786;
	j3809300581 [label="Це ж не я «ладнаю» з Ліоном, чи не так? Ха! Вибач за жахливий жарт. Я не можу стриматися, а ти постійно підкидаєш ідеї.",shape=box,color=blue];
		j3809300581 -> j275583543;
	j3272418899 [label="Гадаю, ліпше, ніж ти. Як у тебе з ним до такого дійшло? Йому був потрібен лише хтось, хто б його вислухав. ",shape=box,color=blue];
		j3272418899 -> j2170372310;
	j3693792744 [label="Напруженість між нами значно зменшилася, особливо після того, як тобі вдалося дати йому впевненість розповісти про те, що його турбує.",shape=box,color=blue];
		j3693792744 -> j1187491956;
	j165831421 [label="Напруженість між нами значно зменшилася, особливо після того, як тобі вдалося дати йому впевненість розповісти про те, що його турбує.",shape=box,color=blue];
		j165831421 -> j1530232086;
	j2106467583 [label="Те саме, що й завжди. Я кожну хвилину намагаюся не відірвати собі обличчя кігтями через відчайдушне бажання заглушити його.",shape=box,color=blue];
		j2106467583 -> "Chat ends.";
	j3691881044 [label="Зізнаюся, що поступово вони стають для мене трохи стерпнішими. Гадаю, це через те, що вони поступово починають покидати надію змінити мене.",shape=box,color=blue];
		j3691881044 -> j2223451398;
	j1582991873 [label="Зізнаюся, що поступово вони стають для мене трохи стерпнішими. Гадаю, мої нещодавні одкровення можуть бути якось пов’язані з цим.",shape=box,color=blue];
		j1582991873 -> j890067020;
	j2164205610 [label="Я дедалі більше замислююся, що оскільки я зараз протофрейм, то не можу використовувати Темний Спогадарій для відновлення своїх спогадів…",shape=box,color=blue];
		j2164205610 -> j4263339798;
	j654884717 [label="Цікаво, чи вона усвідомлює, що моє підбурювання перетворилося зі щирого роздратування на жартівливу гру?",shape=box,color=blue];
		j654884717 -> j1869769570;
	j2329834350 [label="Мушу визнати, я анітрохи тебе не звинувачую. І не лише тому, що вона чудова. У мене ж є очі. У цій жінці більше співчуття, ніж я міг би очікувати в комусь у її віці.",shape=box,color=blue];
		j2329834350 -> j654884717;
	j520456200 [label="Ба. Саме такі розмови призвели до піднесення Імперії орокінів. Це помилка, яку ця система ніколи не повинна повторювати.",shape=box,color=blue];
		j520456200 -> j654884717;
	j1901161908 [label="Зізнаюся, я — один із тих дурнів, про яких вона говорить. Які не можуть змиритися з тим, що живуть так день у день.",shape=box,color=blue];
		j1901161908 -> j4289915782;
	j4255488871 [label="Подумати тільки — її родина викинула її на вулицю. Її. Марі. Ту Марі. Ту, що має більше співчуття, ніж узагалі можливо?!",shape=box,color=blue];
		j4255488871 -> j3394728232;
	j1344872786 [label="Вони знають мою таємницю. Правду про те, що я прийняв сироватку добровільно.",shape=box,color=blue];
		j1344872786 -> j3282211828;
		j1344872786 -> j3172729803;
	j275583543 [label="Я хвалю тебе за те, що тобі вдалося знайти підхід до цього бідного божевільного. Йому потрібна компанія. І співчуття.",shape=box,color=blue];
		j275583543 -> j690434849;
	j2170372310 [label="І все ж тобі закортіло відрізати його. Ганьба.",shape=box,color=blue];
		j2170372310 -> "Chat ends.";
	j1187491956 [label="Він розповів мені про дитя тенно, яке чув. І про те, як він більше його не чує.",shape=box,color=blue];
		j1187491956 -> j3631978550;
	j1530232086 [label="Я знав приголомшливо мало про те, що з ним зробили. Лише коли він розповів тобі, він знайшов у собі готовність розповісти й мені. ",shape=box,color=blue];
		j1530232086 -> j828432122;
	j2223451398 [label="Жартую. Я якось дивно починаю до них прив’язуватися, попри те, що не слухаю їхньої критики щодо моїх життєвих рішень.",shape=box,color=blue];
		j2223451398 -> j2090470288;
		j2223451398 -> j2545883236;
	j890067020 [label="Я очікував, що вони зустрінуть моє каяття глузуванням на кшталт «нарешті він прозрів» або «ми ж тобі казали». Але ні. Вони майже про це не згадували.",shape=box,color=blue];
		j890067020 -> j2959341263;
	j4263339798 [label="але це не заважає мені повністю зануритися в них.",shape=box,color=blue];
		j4263339798 -> "Chat ends.";
	j1869769570 [label="Сподіваюся, що так. Надто вже весело дошкуляти їй. Дивитися, як вона сердиться й кричить на мене своєю рідною мовою — моє нове улюблене заняття.",shape=box,color=blue];
		j1869769570 -> j3308357839;
	j4289915782 [label="Як їй вдається зберігати такий спокій? Не кажучи вже про співчуття? Гадаю, я б у її стані збожеволів так само як і священник.",shape=box,color=blue];
		j4289915782 -> j654884717;
	j3394728232 [label="Я не можу описати тобі своє бажання використати Гельмінта, щоб вирушити назад у часі й убити всю її родину. Повільно. Але, боюся, вона може заперечувати проти цього. ",shape=box,color=blue];
		j3394728232 -> j4114188162;
	j3282211828 [label="Це не від мене вони взнали.",shape=box,color=red];
		j3282211828 -> j3758106670;
	j3172729803 [label="Як вони дізналися?",shape=box,color=red];
		j3172729803 -> j2429381838;
	j690434849 [label="Але якщо серйозно, напруженість між нами значно зменшилася.",shape=box,color=blue];
		j690434849 -> j1344872786;
	j3631978550 [label="Гадаю, цей голос все одно переслідуватиме його в жахіттях. Цей бідолаха завжди сумніватиметься в межі між реальністю та вигадкою.",shape=box,color=blue];
		j3631978550 -> j129956770;
	j828432122 [label="Я не можу описати тобі своє бажання використати Гельмінта, щоб вирушити назад у часі й убити його батьків. Повільно. Але, боюся, він може заперечувати проти цього.",shape=box,color=blue];
		j828432122 -> j1111917928;
	j2090470288 [label="Ви троє все одно разом. Ентраті про це подбав. Тож не завадить використати це якнайкраще.",shape=box,color=red];
		j2090470288 -> j4158020132;
	j2545883236 [label="Це добре. Гадаю, вони дійсно дбають про тебе.",shape=box,color=red];
		j2545883236 -> j3968114713;
	j2959341263 [label="Я радий, що цього не сталося. Не хочу, щоб мене тикали в це носом, мов те цуценя. У мене й так достатньо тем для роздумів.",shape=box,color=blue];
		j2959341263 -> j2090470288;
		j2959341263 -> j2545883236;
	j3308357839 [label="Ще одна причина, чому наші стосунки поліпшилися? Вони знають мою таємницю. Правду про те, що я прийняв сироватку добровільно.",shape=box,color=blue];
		j3308357839 -> j1638563733;
		j3308357839 -> j803008415;
	j4114188162 [label="Помста, ймовірно, не схвалюється Солом, бла-бла-бла. ",shape=box,color=blue];
		j4114188162 -> j654884717;
	j3758106670 [label="А я й не казав, що це ти, мандрівниче. То я сказав їм.",shape=box,color=blue];
		j3758106670 -> j1806500125;
	j2429381838 [label="Я сказав їм, мандрівниче.",shape=box,color=blue];
		j2429381838 -> j1806500125;
	j129956770 [label="І ще одна причина, чому наші стосунки поліпшилися…",shape=box,color=blue];
		j129956770 -> j1344872786;
	j1111917928 [label="Помста, ймовірно, не схвалюється Луа, бла-бла-бла. ",shape=box,color=blue];
		j1111917928 -> j752610263;
	j4158020132 [label="Саме так. Нема сенсу наживати ворогів на своїх нових сусідах. Саме тому я й крав ту випічку ще в Ґоллі.",shape=box,color=blue];
		j4158020132 -> j631842325;
	j3968114713 [label="Попри всі мої зусилля, так. І це вражає. І все ж вони тут.",shape=box,color=blue];
		j3968114713 -> j2888292744;
	j1638563733 [label="Як вони дізналися?",shape=box,color=red];
		j1638563733 -> j399260545;
	j803008415 [label="Це не від мене вони взнали.",shape=box,color=red];
		j803008415 -> j1854791111;
	j1806500125 [label="Evaluate expressions",color=orange];
		j1806500125 -> j2764333675 [label="RoatheRedeemed",color=purple];
		j1806500125 -> j1435747036 [label="RoatheVillain",color=purple];
		j1806500125 -> j3418246965 [label="false",color=purple];
	j752610263 [label="Але є ще одна причина, чому наші стосунки поліпшилися…",shape=box,color=blue];
		j752610263 -> j1344872786;
	j631842325 [label="Гм. Можливо, я спробую відтворити їхній рецепт. Але, у будь-якому разі, я зроблю все можливе, щоби зберегти мир. Ну. Здебільшого.",shape=box,color=blue];
		j631842325 -> j1661714142;
	j2888292744 [label="+10 Chemistry",color=orange];
		j2888292744 -> j3816477230;
	j399260545 [label="Я сказав їм, мандрівниче.",shape=box,color=blue];
		j399260545 -> j4131114853;
	j1854791111 [label="А я й не казав, що це ти, мандрівниче. То я сказав їм.",shape=box,color=blue];
		j1854791111 -> j4131114853;
	j2764333675 [label="Це просто ще одна річ, за яку я маю виправдатися. Зрештою, вони все одно дізналися б. То ліпше це буде з моїх вуст.",shape=box,color=blue];
		j2764333675 -> j42372321;
		j2764333675 -> j2006320175;
	j1435747036 [label="Мені нема чого соромитися. Здавалося безглуздим це приховувати. Зрештою, вони все одно дізналися б. То ліпше це буде з моїх вуст.",shape=box,color=blue];
		j1435747036 -> j42372321;
		j1435747036 -> j2006320175;
	j3418246965 [label="Зрештою, вони все одно дізналися б. То ліпше це буде з моїх вуст.",shape=box,color=blue];
		j3418246965 -> j42372321;
		j3418246965 -> j2006320175;
	j1661714142 [label="+10 Chemistry",color=orange];
		j1661714142 -> j3138135457;
	j3816477230 [label="Я зроблю все можливе, щоб не зіпсувати тобі все, гаразд? Ну. Принаймні не те, що не можна виправити. Я не робитиму твої дні надто нудними, бо можеш збожеволіти, як той священник.",shape=box,color=blue];
		j3816477230 -> "Chat ends.";
	j4131114853 [label="Evaluate expressions",color=orange];
		j4131114853 -> j2270746628 [label="RoatheRedeemed",color=purple];
		j4131114853 -> j1304429191 [label="RoatheVillain",color=purple];
		j4131114853 -> j3402619977 [label="false",color=purple];
	j42372321 [label="Щось змінилося через це?",shape=box,color=red];
		j42372321 -> j30406199;
	j2006320175 [label="Як Ліон відреагував?",shape=box,color=red];
		j2006320175 -> j1330838313;
	j3138135457 [label="Я не робитиму твої дні надто нудними, бо можеш збожеволіти, як той священник.",shape=box,color=blue];
		j3138135457 -> "Chat ends.";
	j2270746628 [label="Це просто ще одна річ, за яку я маю виправдатися. Зрештою, вони все одно дізналися б. То ліпше це буде з моїх вуст.",shape=box,color=blue];
		j2270746628 -> j2797338300;
		j2270746628 -> j2187963669;
	j1304429191 [label="Мені нема чого соромитися. Здавалося безглуздим це приховувати. Зрештою, вони все одно дізналися б. То ліпше це буде з моїх вуст.",shape=box,color=blue];
		j1304429191 -> j2797338300;
		j1304429191 -> j2187963669;
	j3402619977 [label="Зрештою, вони все одно дізналися б. То ліпше це буде з моїх вуст.",shape=box,color=blue];
		j3402619977 -> j2797338300;
		j3402619977 -> j2187963669;
	j30406199 [label="Я очікував, що вони зустрінуть мій сором глузуванням на кшталт «нарешті диявола здолано». Але ні. Вони майже про це не згадували.",shape=box,color=blue];
		j30406199 -> j1673463013;
	j1330838313 [label="Не так, як я очікував. Кілька ночей потому, коли я сидів і мовчки читав сам, він підійшов до мене.",shape=box,color=blue];
		j1330838313 -> j3873441189;
	j2797338300 [label="Щось змінилося через це?",shape=box,color=red];
		j2797338300 -> j645544762;
	j2187963669 [label="Як Марі відреагувала?",shape=box,color=red];
		j2187963669 -> j2968678332;
	j1673463013 [label="Особливо Ліон. Гадаю, він розуміє, як важко зіткнутися з минулим і прийнятими рішеннями. Це як зняти пов’язку з ока… Буквально.",shape=box,color=blue];
		j1673463013 -> j32725969;
	j3873441189 [label="Він сів поруч і розповів мені, як ставив під сумнів свою віру відтоді, як Ентраті дав йому сироватку. Як він соромився своїх сумнівів. Як він шкодував, що прийняв ту сироватку.",shape=box,color=blue];
		j3873441189 -> j3304071659;
	j645544762 [label="Я очікував, що вони зустрінуть мій сором глузуванням на кшталт «нарешті диявола здолано». Але ні. Вони майже про це не згадували.",shape=box,color=blue];
		j645544762 -> j2824744730;
	j2968678332 [label="Не так, як я очікував. Вона нічого не сказала. Натомість просто… обійняла мене. ",shape=box,color=blue];
		j2968678332 -> j598317519;
	j32725969 [label="Check boolean LyonConfession2",color=orange];
