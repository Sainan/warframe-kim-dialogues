		922 -> 933 [label="x >= 21",color=purple];
		922 -> 932 [label="x < 21",color=purple];
		922 -> 932 [label="false",color=purple];
	923 [label="О, то ти все-таки з орокінської імперії. Як чудово. Мені важко повірити, що це було зроблено в ім’я «кохання».",shape=box,color=blue];
		923 -> 934;
	925 [label="А-а-а, зрозуміло… звичка робити це, не думаючи про наслідки. Ну, тобі, мабуть, не доводилося стикатися з іншими протофреймами, чиї спогади були… роздроблені, як мої. У такому сенсі, я навіть трохи співчуваю тобі. І все це в ім’я «кохання».",shape=box,color=blue];
		925 -> 936;
	926 [label="Гм, так. Ну, тобі, мабуть, не доводилося стикатися з іншими протофреймами, чиї спогади були… роздроблені, як мої. У такому сенсі, я навіть трохи співчуваю тобі. І все це в ім’я «кохання».",shape=box,color=blue];
		926 -> 936;
	921 [label="І тому я починаю розуміти, чому в тебе «не вийшло», узурпаторе.",shape=box,color=blue];
		921 -> 920;
	919 [label="+5 Chemistry",color=orange];
		919 -> 930;
	918 [label="+5 Chemistry",color=orange];
		918 -> 929;
	920 [label="Я би покарав тебе, якби це було зроблено заради отримання бажаного, але мене вражає, що орокіни, як відомо, робили набагато гірші речі, якщо не креативніші.",shape=box,color=blue];
		920 -> 931;
	927 [label="Твоя поява. А точніше, дітей. Тенно. Іноді я замислююся, чи було те, що сталося, неминучим. Чи можна було переконати його змінити свій напрямок.",shape=box,color=blue];
		927 -> 937;
	928 [label="Можливо, ти маєш рацію. А можливо, зрештою, ми всі є необробленими коштовностями. У всіх є свої недоліки. Вени тут, вади там.",shape=box,color=blue];
		928 -> 938;
	935 [label="І тому я починаю розуміти, чому в тебе «не вийшло», узурпаторе. Мені важко повірити, що це було зроблено в ім’я «кохання».",shape=box,color=blue];
		935 -> 934;
	933 [label="+5 Chemistry",color=orange];
		933 -> 943;
	932 [label="+5 Chemistry",color=orange];
		932 -> 942;
	934 [label="Але, мабуть, орокіни завжди мали дивний спосіб виражати свої емоції.",shape=box,color=blue];
		934 -> 931;
	936 [label="Я би покарав тебе, якби це було в ім’я так званої «любові», але мене вражає, що орокіни, як відомо, робили набагато гірші речі, якщо не креативніші.",shape=box,color=blue];
		936 -> 931;
	930 [label="Я би порадив спокійно змиритися зі своїми помилками та прийняти поразку такою, яка вона є, але це зробило б мене справжнім лицеміром, чи не так?",shape=box,color=blue];
		930 -> 940;
	929 [label="Я би порадив спокійно змиритися зі своїми помилками та прийняти поразку такою, яка вона є. Але я не маю дару Порожнечі, який дозволяє зациклювати час і стирати пам’ять.",shape=box,color=blue];
		929 -> 939;
	931 [label="Я вже розповідав тобі історію про Балласа та Марґуліс? Я покладаюся лише на твою чесність, оскільки інакше не маю жодної можливості дізнатися правду.",shape=box,color=blue];
		931 -> 941;
	937 [label="Мені подобається вірити, що, зрештою, ми всі є необробленими коштовностями. У всіх є свої недоліки. Вени тут, вади там.",shape=box,color=blue];
		937 -> 938;
	938 [label="І ми можемо отримати огранювання певним чином, або відбивати світло і перетворюватися на вишукані витвори мистецтва… або заточуватися в зброю… або розбиватися на пил.",shape=box,color=blue];
		938 -> 944;
	943 [label="Я би порадив спокійно змиритися зі своїми помилками та прийняти поразку такою, яка вона є, але це зробило б мене справжнім лицеміром, чи не так?",shape=box,color=blue];
		943 -> 953;
	942 [label="Я би порадив спокійно змиритися зі своїми помилками та прийняти поразку такою, яка вона є. Але я не маю дару Порожнечі, який дозволяє зациклювати час і стирати пам’ять.",shape=box,color=blue];
		942 -> 952;
	940 [label="І хто може сказати, що я б не використав дар Порожнечі, який дозволяє зациклювати час і стирати пам’ять?",shape=box,color=blue];
		940 -> 939;
	939 [label="Як… це взагалі працює?",shape=box,color=blue];
		939 -> 946;
		939 -> 947;
		939 -> 945;
	941 [label="І як же я це зневажаю, чесно кажучи.",shape=box,color=blue];
		941 -> 948;
		941 -> 949;
		941 -> 950;
		941 -> 951;
	944 [label="Можливо, це наївне переконання, і ми всі насправді незмінні. Ти знаєш це краще за мене, принаймні так я чув.",shape=box,color=blue];
		944 -> 954;
	953 [label="І хто може сказати, що я б не використав дар Порожнечі, який дозволяє зациклювати час і стирати пам’ять?",shape=box,color=blue];
		953 -> 952;
	952 [label="Як… це взагалі працює?",shape=box,color=blue];
		952 -> 963;
		952 -> 964;
		952 -> 962;
	946 [label="Тепер ти маєш зараження. І в тебе є зв’язок із зараженими штамами, які використовувалися для створення всіх партій сироватки протофреймів.",shape=box,color=red];
		946 -> 956;
	947 [label="Балакуча гітара винна мені дещо.",shape=box,color=red];
		947 -> 957;
	945 [label="[Завершити розмову]",shape=box,color=red];
		945 -> 955;
	948 [label="Ти вже розповідав.",shape=box,color=red];
		948 -> 958;
	949 [label="Ти не розповідав, але, будь ласка, продовжуй.",shape=box,color=red];
		949 -> 959;
	950 [label="Я, власне, не маю уявлення про це.",shape=box,color=red];
		950 -> 960;
	951 [label="Ні, ти не розповідав цієї історії, яка… власне, є однією з причин, чому ми тут. Я знаю, що вперше ти позбавив мене цієї можливості.",shape=box,color=red];
		951 -> 961;
	954 [label="Але я почав розповідати не послідовно. Дозволь мені почати як слід.",shape=box,color=blue];
		954 -> 965;
	963 [label="Тепер ти маєш зараження. І в тебе є зв’язок із зараженими штамами, які використовувалися для створення всіх партій сироватки протофреймів.",shape=box,color=red];
		963 -> 973;
	964 [label="Балакуча гітара винна мені дещо.",shape=box,color=red];
		964 -> 974;
	962 [label="[Завершити розмову]",shape=box,color=red];
		962 -> 972;
	956 [label="Наскільки мені відомо — а вона не зовсім надійне джерело, тому сприймай це з обережністю — на штами зараження для кожної партії протофреймів можна впливати окремо.",shape=box,color=red];
		956 -> 966;
	957 [label="Зрозуміло…",shape=box,color=blue];
		957 -> 967;
	955 [label="Chat ends.",color=orange];
	958 [label="+10 Chemistry",color=orange];
		958 -> 968;
	959 [label="Або ти намагаєшся зіграти на моєму его, за що я тобі вдячний, або в тебе був дуже поганий день. Як людина, яка також пережила незліченні цикли життя, я майже співчуваю тобі.",shape=box,color=blue];
		959 -> 969;
	960 [label="Дивовижно. Або ти брешеш, або в мене ще є карти, які залишилися неперевернутими. Можливо, саме тому ти знову тут, обговорити вже обговорене.",shape=box,color=blue];
		960 -> 970;
	961 [label="М-м, потроху ти майже переконуєш мене пробачити влаштований тобою безлад.",shape=box,color=blue];
		961 -> 971;
	965 [label="Задовго до запуску «Заримена 10.0» і до того, як тенно з’явилися на горизонті, архімедівка Марґуліс і Баллас зустрілися під час відкриття нової купольної оранжереї.",shape=box,color=blue];
		965 -> 975;
	973 [label="Наскільки мені відомо — а вона не зовсім надійне джерело, тому сприймай це з обережністю — на штами зараження для кожної партії протофреймів можна впливати окремо.",shape=box,color=red];
		973 -> 981;
	974 [label="Зрозуміло…",shape=box,color=blue];
		974 -> 982;
	972 [label="Chat ends.",color=orange];
	966 [label="Оскільки кожен із них живе у своїй власній «безперервності» або часі. Усі штами зараження пов’язані між собою, але вони нібито живуть у… вузликах. Усе це дуже складно.",shape=box,color=red];
		966 -> 976;
	967 [label="Усесвіт, безперечно, став дивнішим відтоді як я його покинув…",shape=box,color=blue];
		967 -> 977;
		967 -> 978;
	968 [label="Тоді я не буду тебе втомлювати, розповідаючи цю історію ще раз, і залишу тебе шукати інші розваги на решту дня.",shape=box,color=blue];
		968 -> 979;
	969 [label="Якби я не був предметом твоєї розваги.",shape=box,color=blue];
		969 -> 970;
	970 [label="Але? Попри все це… ",shape=box,color=blue];
		970 -> 980;
	971 [label="Update boolean RoatheResetForgiven",color=orange];
		971 -> 970;
	975 [label="Баллас був там заради церемонії — ми, звичайно, любимо помпезність і урочистість — а Марґуліс відчайдушно намагалася залишитися непоміченою.",shape=box,color=blue];
		975 -> 983;
	981 [label="Оскільки кожен із них живе у своїй власній «безперервності» або часі. Усі штами зараження пов’язані між собою, але вони нібито живуть у… вузликах. Усе це дуже складно.",shape=box,color=red];
		981 -> 987;
	982 [label="Усесвіт, безперечно, став дивнішим відтоді як я його покинув…",shape=box,color=blue];
		982 -> 988;
		982 -> 989;
	976 [label="Оскільки я можу зациклювати час, я можу зациклювати «партії» зараження в обмеженому режимі.",shape=box,color=red];
		976 -> 984;
