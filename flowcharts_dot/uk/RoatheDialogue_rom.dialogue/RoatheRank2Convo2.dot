	883 [label="Ти знаєш, що колись вони були закохані.",shape=box,color=blue];
		883 -> 888;
		883 -> 887;
		883 -> 886;
	885 [label="Втручатися у всі наші розуми… все заради хтивості? Кохання? Що це? Як це називається? Я просто думаю, чи було це того варте. Або, можливо, ти ще не знаєш, оскільки твій прибуток ще не був отриманий.",shape=box,color=blue];
		885 -> 890;
	884 [label="Втручатися у всі наші розуми… і все це заради чого? Виконання якогось… примарного списку справ? Чи все це заради перемоги твого вигаданого так званого «бога»?",shape=box,color=blue];
		884 -> 889;
	888 [label="Хто?",shape=box,color=red];
		888 -> 893;
	887 [label="Мені дуже важко в це повірити.",shape=box,color=red];
		887 -> 892;
	886 [label="[Завершити розмову]",shape=box,color=red];
		886 -> 891;
	890 [label="Я вважаю, що це дивно романтично, хоча й трохи… дистопічно, докладати стільки зусиль, щоб завоювати серце (та/або тіло) коханої людини.",shape=box,color=blue];
		890 -> 895;
	889 [label="Або, можливо, все ще гірше, і тобі просто цікаво, що може статися? А ти просто сидиш там і відриваєш крильця комахам? Ми розібралися «що» є причинами твоїх дій. Зараз я намагаюся з’ясувати «чому».",shape=box,color=blue];
		889 -> 894;
	893 [label="Баллас і Марґуліс.",shape=box,color=blue];
		893 -> 897;
	892 [label="Це правда! Я майже чую, як ти глузуєш зі Святилища. Але Баллас і Марґуліс були закохані.",shape=box,color=blue];
		892 -> 896;
	891 [label="Chat ends.",color=orange];
	895 [label="Або, можливо, все ще гірше, і тобі просто цікаво, що може статися? А ти просто сидиш там і відриваєш крильця комахам? Ми розібралися «що» є причинами твоїх дій. Зараз я намагаюся з’ясувати «чому».",shape=box,color=blue];
		895 -> 903;
