		903 -> 915 [label=false,color=brown];
	902 [label="Я пригадую слова, що в тебе «не вийшло», або справи з фанатиками якось заплуталися, що їх неможливо розплутати. То ти справді вважаєш, що це найкращий варіант, який у тебе був?",shape=box,color=blue];
		902 -> 900;
		902 -> 910;
		902 -> 899;
		902 -> 898;
	898 [label="Не знаючи, що ще робити, у мене не було інших варіантів.",shape=box,color=red];
		898 -> 906;
	899 [label="Так. Але не планувалося, що ти… опинишся в такому стані, з половиною спогадів. Мені шкода.",shape=box,color=red];
		899 -> 907;
	900 [label="Тобі сказати правду, Роуте? Мені… здавалося, що це буде мати значення, якщо я можу це робити.",shape=box,color=red];
		900 -> 908;
