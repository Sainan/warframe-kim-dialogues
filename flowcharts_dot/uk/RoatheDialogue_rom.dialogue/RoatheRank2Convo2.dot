		980 -> 965;
	983 [label="Тобі потрібно зрозуміти, мій узурпаторе, що Баллас не мав жодних причин спілкуватися з нею. Жодних причин, хіба що його закоханість була справжньою.",shape=box,color=blue];
		983 -> 990;
	987 [label="Оскільки я можу зациклювати час, я можу зациклювати «партії» зараження в обмеженому режимі.",shape=box,color=red];
		987 -> 993;
	988 [label="Ти навіть не уявляєш.",shape=box,color=red];
