		984 -> 991;
		984 -> 992;
	985 [label="Я би покарав тебе, якби це було зроблено заради отримання бажаного, але мене вражає, що орокіни, як відомо, робили набагато гірші речі, якщо не креативніші.",shape=box,color=blue];
		985 -> 931;
	986 [label="Chat ends.",color=orange];
	990 [label="Це була не просто хтивість, адже він міг мати будь-кого, кого забажав, і часто це робив. Якби він хотів її, то міг просто взяти її та покінчити з нею.",shape=box,color=blue];
		990 -> 995;
	993 [label="І хто «вона»?",shape=box,color=blue];
		993 -> 996;
		993 -> 997;
	994 [label="Хай там як. Усе це в ім’я «кохання»?",shape=box,color=blue];
		994 -> 998;
	991 [label="Ліззі. Ти б їй сподобався.",shape=box,color=red];
		991 -> 957;
	992 [label="Балакуча гітара.",shape=box,color=red];
		992 -> 957;
	995 [label="Він був Виконавцем. Насправді, одним із найпотужніших із Семи. Він міг би викликати її до своєї спальні, і вона прийшла б туди без жодного вагання.",shape=box,color=blue];
		995 -> 999;
	996 [label="Ліззі. Ти б їй сподобався.",shape=box,color=red];
		996 -> 974;
	997 [label="Балакуча гітара.",shape=box,color=red];
		997 -> 974;
	998 [label="Я би покарав тебе, якби це було в ім’я так званої «любові», але мене вражає, що орокіни, як відомо, робили набагато гірші речі, якщо не креативніші.",shape=box,color=blue];
		998 -> 931;
	999 [label="Але він так не вчинив. Того вечора Баллас поглянув на неї та… він був вражений, мандрівниче. Повністю й абсолютно приголомшений.",shape=box,color=blue];
		999 -> 1000;
	1000 [label="Я ніколи не бачив нічого подібного. Здавалося, ніби в кімнаті, окрім Марґуліс, більше нікого не було. Він здавався навіть… якось занадто сором’язливим для того, щоби почати розмову з нею. Він! Баллас!",shape=box,color=blue];
		1000 -> 1001;
		1000 -> 1002;
	1001 [label="Серйозно?",shape=box,color=red];
		1001 -> 1003;
	1002 [label="Ти це вигадуєш.",shape=box,color=red];
		1002 -> 1004;
	1003 [label="Я клянусь тим, що залишилося від моєї честі! І з якої причини мені брехати? Яке мені діло до твоєї думки про справжність їхніх стосунків?",shape=box,color=blue];
		1003 -> 1005;
	1004 [label="Я клянусь тим, що залишилося від моєї честі, це не так! І з якої причини мені брехати? Яке мені діло до твоєї думки про справжність їхніх стосунків?",shape=box,color=blue];
		1004 -> 1005;
	1005 [label="Мені просто прикро, що ти так швидко спрощуєш те, що насправді набагато складніше, ніж ти собі уявляєш.",shape=box,color=blue];
		1005 -> 1006;
	1006 [label="Вони були закохані, хочеш ти в це вірити чи ні. Баллас відмовився від усіх класових правил і традицій, щоб мати своєю коханою та єдиною романтичною супутницею архімедівку. ",shape=box,color=blue];
		1006 -> 1007;
	1007 [label="Тільки справжнє кохання могло звести чоловіка з розуму так, як це сталося з ним, коли все пішло шкереберть…",shape=box,color=blue];
		1007 -> 1008;
		1007 -> 1009;
	1008 [label="Як ти це розумієш? Хіба він не був відповідальний за її смерть?",shape=box,color=red];
		1008 -> 1010;
	1009 [label="Балас був тим, хто наказав її стратити.",shape=box,color=red];
		1009 -> 1010;
	1010 [label="По-перше, припустімо, що все, що ти знаєш — правда, і що його дії були винятково з його власної ініціативи. Припустімо, що за лаштунками не відбувалося жодних інших політичних маніпуляцій, шантажу чи чогось іншого, що могло б змусити його піти на цей крок.",shape=box,color=blue];
		1010 -> 1011;
	1011 [label="Навіть якби це було так, і Баллас засудив її до страти, не маючи на це жодного впливу, врахуй, що вже було запізно. Зрада, яку він відчував, уже розколола його навпіл.",shape=box,color=blue];
		1011 -> 1012;
	1012 [label="Його серце й розум уже були розбиті.",shape=box,color=blue];
		1012 -> 1013;
		1012 -> 1014;
	1013 [label="Я не збираюся починати співчувати йому, якщо це те, про що ти мене просиш.",shape=box,color=red];
		1013 -> 1015;
	1014 [label="Через тенно? Або через те, що вони з нею зробили?",shape=box,color=red];
		1014 -> 1016;
	1015 [label="Я не прошу нічого подібного! Баллас заслуговує лише на те, щоб на його могилу мочилися, якщо в нього взагалі є могила.",shape=box,color=blue];
		1015 -> 1017;
	1016 [label="В якомусь сенсі й те, й інше. Того дня, коли він засудив її до страти, він був доведений до божевілля. Насправді я б не здивувався, якби якась частка його не пам’ятала про скоєне.",shape=box,color=blue];
		1016 -> 1018;
	1017 [label="Я лише стверджую, що в день, коли він засудив до її страти, він був божевільним. Я б не здивувався, якби якась частина його не пам’ятала про скоєний вчинок, після всього.",shape=box,color=blue];
		1017 -> 1018;
	1018 [label="Баллас кохав Марґуліс. Усім своїм єством, повністю — цілком відданий їй. Він би пожертвував заради неї чим завгодно. Своєю душею, тілом, орокінською імперією. Всім, про що можна тільки мріяти.",shape=box,color=blue];
		1018 -> 1019;
	1019 [label="Жодна ціна не була занадто великою. Жодна мораль не варта пожертви. Якби йому дали немовля і сказали, що Марґуліс хоче, щоб його мізки розлетілися об скло, воно б померло, перш ніж він дослухав би фразу.",shape=box,color=blue];
		1019 -> 1020;
	1020 [label="Він би спалив Материнську систему дотла та відновив би за її образом, узурпаторе… але в цьому й полягає трагедія.",shape=box,color=blue];
		1020 -> 1021;
	1021 [label="Марґуліс? О, Марґуліс. Дорога, люба Марґуліс… вона все ще мала совість.",shape=box,color=blue];
		1021 -> 1022;
	1022 [label="І коли вона побачила бідних тенно, бідних, розірваних Порожнечею дітей… ",shape=box,color=blue];
		1022 -> 1023;
	1023 [label="Щось у її житті стало важливішим за Балласа. Щось у її житті, заради чого було варто віддати своє життя… але це був не він.",shape=box,color=blue];
		1023 -> 1024;
	1024 [label="Це було не її кохання до нього.",shape=box,color=blue];
		1024 -> 1025;
	1025 [label="І він це знав, любий мандрівниче. Він зрозумів це тієї ж миті, як вона поглянула на них. І це стало очевидним, коли її «божевільні тварини» подбали про те, щоб вони були останніми, кого вона побачить. Принаймні такі чутки ходили серед нас, орокінів.",shape=box,color=blue];
		1025 -> 1026;
	1026 [label="Ти можеш собі уявити радість для орокінів? Бачити, як розірвані Порожнечею виродки випалюють очі дорогоцінній архімедівці Балласа?",shape=box,color=blue];
		1026 -> 1027;
	1027 [label="Але я думаю, що саме коли Марґуліс боролася за порятунок тенно, тоді серце Балласа розбилося на тисячі шматочків і більше ніколи не відновилося.",shape=box,color=blue];
		1027 -> 1028;
	1028 [label="Бо він знав, що його витіснили з її серця.",shape=box,color=blue];
		1028 -> 1029;
	1029 [label="Мабуть, саме через це я йому співчував. А решта того, що було потім. Історія вічного кохання… і як воно закінчилося такою страшною трагедією. ",shape=box,color=blue];
		1029 -> 1030;
	1030 [label="Якби тобі було відомо, як вони всміхалися одне одному…",shape=box,color=blue];
		1030 -> 1031;
		1030 -> 1032;
	1031 [label="Ти можеш романтизувати те, що в них було, але це не виправдовує того, ким він був. Балласу не можна пробачити все, що він зробив.",shape=box,color=red];
		1031 -> 1033;
	1032 [label="Мене радує, що їхнє кохання було справжнім. Що з ним було… складно ще тоді. І Марґуліс не була іграшкою весь цей час.",shape=box,color=red];
		1032 -> 1034;
	1033 [label="Add 1 to Thermostat",color=orange];
