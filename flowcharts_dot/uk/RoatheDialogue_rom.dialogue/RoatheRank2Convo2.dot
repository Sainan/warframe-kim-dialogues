		906 -> 918 [label="false",color=purple];
	907 [label="Гм, так. Ну, тобі, мабуть, не доводилося стикатися з іншими протофреймами, чиї спогади були… роздроблені, як мої. У такому сенсі, я навіть трохи співчуваю тобі.",shape=box,color=blue];
		907 -> 920;
	908 [label="А-а-а, зрозуміло… звичка робити це, не думаючи про наслідки. Ну, тобі, мабуть, не доводилося стикатися з іншими протофреймами, чиї спогади були… роздроблені, як мої.",shape=box,color=blue];
		908 -> 920;
	909 [label="О, то ти все-таки з орокінської імперії. Як чудово.",shape=box,color=blue];
