		j2342122517 -> j3645560799 [label="RoatheLyonConfessionDealNo",color=purple];
	j886229672 [label="Ти знаєш, що колись вони були закохані.",shape=box,color=blue];
		j886229672 -> j2097335724;
		j886229672 -> j3826791468;
		j886229672 -> j1478915251;
	j3022432021 [label="Втручатися у всі наші розуми… все заради хтивості? Кохання? Що це? Як це називається? Я просто думаю, чи було це того варте. Або, можливо, ти ще не знаєш, оскільки твій прибуток ще не був отриманий.",shape=box,color=blue];
		j3022432021 -> j2532675652;
	j3645560799 [label="Втручатися у всі наші розуми… і все це заради чого? Виконання якогось… примарного списку справ? Чи все це заради перемоги твого вигаданого так званого «бога»?",shape=box,color=blue];
		j3645560799 -> j2366683069;
	j2097335724 [label="Хто?",shape=box,color=red];
		j2097335724 -> j1845096816;
	j3826791468 [label="Мені дуже важко в це повірити.",shape=box,color=red];
		j3826791468 -> j224304940;
	j1478915251 [label="[Завершити розмову]",shape=box,color=red];
		j1478915251 -> "Chat ends.";
	j2532675652 [label="Я вважаю, що це дивно романтично, хоча й трохи… дистопічно, докладати стільки зусиль, щоб завоювати серце (та/або тіло) коханої людини.",shape=box,color=blue];
		j2532675652 -> j3425167567;
	j2366683069 [label="Або, можливо, все ще гірше, і тобі просто цікаво, що може статися? А ти просто сидиш там і відриваєш крильця комахам? Ми розібралися «що» є причинами твоїх дій. Зараз я намагаюся з’ясувати «чому».",shape=box,color=blue];
		j2366683069 -> j3362610447;
	j1845096816 [label="Баллас і Марґуліс.",shape=box,color=blue];
		j1845096816 -> j604774511;
	j224304940 [label="Це правда! Я майже чую, як ти глузуєш зі Святилища. Але Баллас і Марґуліс були закохані.",shape=box,color=blue];
		j224304940 -> j1659559285;
	j3425167567 [label="Або, можливо, все ще гірше, і тобі просто цікаво, що може статися? А ти просто сидиш там і відриваєш крильця комахам? Ми розібралися «що» є причинами твоїх дій. Зараз я намагаюся з’ясувати «чому».",shape=box,color=blue];
		j3425167567 -> j2868117985;
	j3362610447 [label="Check boolean RoatheResetScrewedUp",color=orange];
		j3362610447 -> j1029834028 [label=true,color=green];
		j3362610447 -> j1432715406 [label=false,color=brown];
		j3362610447 -> j3830150319 [label=false,color=brown];
		j3362610447 -> j2367376342 [label=false,color=brown];
		j3362610447 -> j2632181625 [label=false,color=brown];
	j604774511 [label="Я майже чую, як ти глузуєш зі Святилища. Але це правда.",shape=box,color=blue];
		j604774511 -> j1659559285;
	j1659559285 [label="Боюся, твоє знайомство з Балласом було вже після того, як усе пішло… вкрай шкереберть.",shape=box,color=blue];
		j1659559285 -> j2775880517;
		j1659559285 -> j3248401678;
	j2868117985 [label="Check boolean RoatheResetScrewedUp",color=orange];
		j2868117985 -> j240605265 [label=true,color=green];
		j2868117985 -> j2462056978 [label=false,color=brown];
		j2868117985 -> j245254471 [label=false,color=brown];
		j2868117985 -> j3489450489 [label=false,color=brown];
		j2868117985 -> j1694861986 [label=false,color=brown];
	j1029834028 [label="Я пригадую слова, що в тебе «не вийшло», або справи з фанатиками якось заплуталися, що їх неможливо розплутати. То ти справді вважаєш, що це найкращий варіант, який у тебе був?",shape=box,color=blue];
		j1029834028 -> j2367376342;
		j1029834028 -> j1270366307;
		j1029834028 -> j3830150319;
		j1029834028 -> j1432715406;
	j1432715406 [label="Не знаючи, що ще робити, у мене не було інших варіантів.",shape=box,color=red];
		j1432715406 -> j3772047713;
	j3830150319 [label="Так. Але не планувалося, що ти… опинишся в такому стані, з половиною спогадів. Мені шкода.",shape=box,color=red];
		j3830150319 -> j205841141;
	j2367376342 [label="Тобі сказати правду, Роуте? Мені… здавалося, що це буде мати значення, якщо я можу це робити.",shape=box,color=red];
		j2367376342 -> j2718929476;
	j2632181625 [label="Мені було цікаво подивитися, що буде далі.",shape=box,color=red];
		j2632181625 -> j2770137803;
	j2775880517 [label="Що сталося, що так кардинально змінило ситуацію?",shape=box,color=red];
		j2775880517 -> j3883569083;
	j3248401678 [label="Люди не змінюються так сильно. В глибині душі він завжди був здатний на те, що зробив.",shape=box,color=red];
		j3248401678 -> j604718779;
	j240605265 [label="Я пригадую слова, що в тебе «не вийшло» між нами, або справи з фанатиками якось заплуталися, що їх неможливо розплутати. То ти справді вважаєш, що це найкращий варіант, який у тебе був?",shape=box,color=blue];
		j240605265 -> j2462056978;
		j240605265 -> j1505960546;
		j240605265 -> j3489450489;
		j240605265 -> j1694861986;
	j2462056978 [label="Не знаючи, що ще робити, у мене не було інших варіантів.",shape=box,color=red];
		j2462056978 -> j1646847578;
	j245254471 [label="Мені було цікаво подивитися, що буде далі.",shape=box,color=red];
		j245254471 -> j40297621;
	j3489450489 [label="Тобі сказати правду, Роуте? Мені… здавалося, що це буде мати значення, якщо я можу це робити.",shape=box,color=red];
		j3489450489 -> j3267041936;
	j1694861986 [label="Так. Але не планувалося, що ти… опинишся в такому стані, з половиною спогадів. Мені шкода.",shape=box,color=red];
		j1694861986 -> j9117311;
	j1270366307 [label="Мені було цікаво подивитися, що буде далі.",shape=box,color=red];
		j1270366307 -> j2466911954;
	j3772047713 [label="Evaluate expressions on HellStory counter",color=orange];
		j3772047713 -> j294665939 [label="x >= 21",color=purple];
		j3772047713 -> j4094459513 [label="x < 21",color=purple];
		j3772047713 -> j4094459513 [label="false",color=purple];
	j205841141 [label="Гм, так. Ну, тобі, мабуть, не доводилося стикатися з іншими протофреймами, чиї спогади були… роздроблені, як мої. У такому сенсі, я навіть трохи співчуваю тобі.",shape=box,color=blue];
		j205841141 -> j3308225452;
	j2718929476 [label="А-а-а, зрозуміло… звичка робити це, не думаючи про наслідки. Ну, тобі, мабуть, не доводилося стикатися з іншими протофреймами, чиї спогади були… роздроблені, як мої.",shape=box,color=blue];
		j2718929476 -> j3308225452;
	j2770137803 [label="О, то ти все-таки з орокінської імперії. Як чудово.",shape=box,color=blue];
		j2770137803 -> j3308225452;
	j3883569083 [label="Add 1 to Thermostat counter",color=orange];
		j3883569083 -> j2775245029;
	j604718779 [label="Add -1 to Thermostat counter",color=orange];
		j604718779 -> j2389691092;
	j1505960546 [label="Мені було цікаво подивитися, що буде далі.",shape=box,color=red];
		j1505960546 -> j1934277647;
	j1646847578 [label="Evaluate expressions on HellStory counter",color=orange];
		j1646847578 -> j3426365564 [label="x >= 21",color=purple];
		j1646847578 -> j682782368 [label="x < 21",color=purple];
		j1646847578 -> j682782368 [label="false",color=purple];
	j40297621 [label="О, то ти все-таки з орокінської імперії. Як чудово. Мені важко повірити, що це було зроблено в ім’я «кохання».",shape=box,color=blue];
		j40297621 -> j2705229284;
	j3267041936 [label="А-а-а, зрозуміло… звичка робити це, не думаючи про наслідки. Ну, тобі, мабуть, не доводилося стикатися з іншими протофреймами, чиї спогади були… роздроблені, як мої. У такому сенсі, я навіть трохи співчуваю тобі. І все це в ім’я «кохання».",shape=box,color=blue];
		j3267041936 -> j2372130242;
	j9117311 [label="Гм, так. Ну, тобі, мабуть, не доводилося стикатися з іншими протофреймами, чиї спогади були… роздроблені, як мої. У такому сенсі, я навіть трохи співчуваю тобі. І все це в ім’я «кохання».",shape=box,color=blue];
		j9117311 -> j2372130242;
	j2466911954 [label="І тому я починаю розуміти, чому в тебе «не вийшло», узурпаторе.",shape=box,color=blue];
		j2466911954 -> j3308225452;
	j294665939 [label="+5 Chemistry",color=orange];
		j294665939 -> j1340525153;
	j4094459513 [label="+5 Chemistry",color=orange];
		j4094459513 -> j84086104;
	j3308225452 [label="Я би покарав тебе, якби це було зроблено заради отримання бажаного, але мене вражає, що орокіни, як відомо, робили набагато гірші речі, якщо не креативніші.",shape=box,color=blue];
		j3308225452 -> j1168832070;
	j2775245029 [label="Твоя поява. А точніше, дітей. Тенно. Іноді я замислююся, чи було те, що сталося, неминучим. Чи можна було переконати його змінити свій напрямок.",shape=box,color=blue];
		j2775245029 -> j1194642590;
	j2389691092 [label="Можливо, ти маєш рацію. А можливо, зрештою, ми всі є необробленими коштовностями. У всіх є свої недоліки. Вени тут, вади там.",shape=box,color=blue];
		j2389691092 -> j3378803028;
	j1934277647 [label="І тому я починаю розуміти, чому в тебе «не вийшло», узурпаторе. Мені важко повірити, що це було зроблено в ім’я «кохання».",shape=box,color=blue];
		j1934277647 -> j2705229284;
	j3426365564 [label="+5 Chemistry",color=orange];
		j3426365564 -> j739017681;
	j682782368 [label="+5 Chemistry",color=orange];
		j682782368 -> j1058965570;
	j2705229284 [label="Але, мабуть, орокіни завжди мали дивний спосіб виражати свої емоції.",shape=box,color=blue];
		j2705229284 -> j1168832070;
	j2372130242 [label="Я би покарав тебе, якби це було в ім’я так званої «любові», але мене вражає, що орокіни, як відомо, робили набагато гірші речі, якщо не креативніші.",shape=box,color=blue];
		j2372130242 -> j1168832070;
	j1340525153 [label="Я би порадив спокійно змиритися зі своїми помилками та прийняти поразку такою, яка вона є, але це зробило б мене справжнім лицеміром, чи не так?",shape=box,color=blue];
		j1340525153 -> j3456987696;
	j84086104 [label="Я би порадив спокійно змиритися зі своїми помилками та прийняти поразку такою, яка вона є. Але я не маю дару Порожнечі, який дозволяє зациклювати час і стирати пам’ять.",shape=box,color=blue];
		j84086104 -> j3745111308;
	j1168832070 [label="Я вже розповідав тобі історію про Балласа та Марґуліс? Я покладаюся лише на твою чесність, оскільки інакше не маю жодної можливості дізнатися правду.",shape=box,color=blue];
		j1168832070 -> j3742862622;
	j1194642590 [label="Мені подобається вірити, що, зрештою, ми всі є необробленими коштовностями. У всіх є свої недоліки. Вени тут, вади там.",shape=box,color=blue];
		j1194642590 -> j3378803028;
	j3378803028 [label="І ми можемо отримати огранювання певним чином, або відбивати світло і перетворюватися на вишукані витвори мистецтва… або заточуватися в зброю… або розбиватися на пил.",shape=box,color=blue];
		j3378803028 -> j393001741;
	j739017681 [label="Я би порадив спокійно змиритися зі своїми помилками та прийняти поразку такою, яка вона є, але це зробило б мене справжнім лицеміром, чи не так?",shape=box,color=blue];
		j739017681 -> j1328381758;
	j1058965570 [label="Я би порадив спокійно змиритися зі своїми помилками та прийняти поразку такою, яка вона є. Але я не маю дару Порожнечі, який дозволяє зациклювати час і стирати пам’ять.",shape=box,color=blue];
		j1058965570 -> j1339226052;
	j3456987696 [label="І хто може сказати, що я б не використав дар Порожнечі, який дозволяє зациклювати час і стирати пам’ять?",shape=box,color=blue];
		j3456987696 -> j3745111308;
	j3745111308 [label="Як… це взагалі працює?",shape=box,color=blue];
		j3745111308 -> j732290742;
		j3745111308 -> j3802252344;
		j3745111308 -> j1478915251;
	j3742862622 [label="І як же я це зневажаю, чесно кажучи.",shape=box,color=blue];
		j3742862622 -> j1232364378;
		j3742862622 -> j3846203021;
		j3742862622 -> j1146087406;
		j3742862622 -> j1620677640;
	j393001741 [label="Можливо, це наївне переконання, і ми всі насправді незмінні. Ти знаєш це краще за мене, принаймні так я чув.",shape=box,color=blue];
		j393001741 -> j811118206;
	j1328381758 [label="І хто може сказати, що я б не використав дар Порожнечі, який дозволяє зациклювати час і стирати пам’ять?",shape=box,color=blue];
		j1328381758 -> j1339226052;
	j1339226052 [label="Як… це взагалі працює?",shape=box,color=blue];
		j1339226052 -> j2630469560;
		j1339226052 -> j3679860701;
		j1339226052 -> j1478915251;
	j732290742 [label="Тепер ти маєш зараження. І в тебе є зв’язок із зараженими штамами, які використовувалися для створення всіх партій сироватки протофреймів.",shape=box,color=red];
		j732290742 -> j1480132905;
	j3802252344 [label="Балакуча гітара винна мені дещо.",shape=box,color=red];
		j3802252344 -> j3863368899;
	j1232364378 [label="Ти вже розповідав.",shape=box,color=red];
		j1232364378 -> j1000937694;
	j3846203021 [label="Ти не розповідав, але, будь ласка, продовжуй.",shape=box,color=red];
		j3846203021 -> j2387562883;
	j1146087406 [label="Я, власне, не маю уявлення про це.",shape=box,color=red];
		j1146087406 -> j1879383348;
	j1620677640 [label="Ні, ти не розповідав цієї історії, яка… власне, є однією з причин, чому ми тут. Я знаю, що вперше ти позбавив мене цієї можливості.",shape=box,color=red];
		j1620677640 -> j502605429;
	j811118206 [label="Але я почав розповідати не послідовно. Дозволь мені почати як слід.",shape=box,color=blue];
		j811118206 -> j1148616640;
	j2630469560 [label="Тепер ти маєш зараження. І в тебе є зв’язок із зараженими штамами, які використовувалися для створення всіх партій сироватки протофреймів.",shape=box,color=red];
		j2630469560 -> j168906940;
	j3679860701 [label="Балакуча гітара винна мені дещо.",shape=box,color=red];
		j3679860701 -> j4274065716;
	j1480132905 [label="Наскільки мені відомо — а вона не зовсім надійне джерело, тому сприймай це з обережністю — на штами зараження для кожної партії протофреймів можна впливати окремо.",shape=box,color=red];
		j1480132905 -> j2576917005;
	j3863368899 [label="Зрозуміло…",shape=box,color=blue];
		j3863368899 -> j1297887060;
	j1000937694 [label="+10 Chemistry",color=orange];
		j1000937694 -> j167080762;
	j2387562883 [label="Або ти намагаєшся зіграти на моєму его, за що я тобі вдячний, або в тебе був дуже поганий день. Як людина, яка також пережила незліченні цикли життя, я майже співчуваю тобі.",shape=box,color=blue];
		j2387562883 -> j3597319874;
	j1879383348 [label="Дивовижно. Або ти брешеш, або в мене ще є карти, які залишилися неперевернутими. Можливо, саме тому ти знову тут, обговорити вже обговорене.",shape=box,color=blue];
		j1879383348 -> j4126400304;
	j502605429 [label="М-м, потроху ти майже переконуєш мене пробачити влаштований тобою безлад.",shape=box,color=blue];
		j502605429 -> j3440475363;
	j1148616640 [label="Задовго до запуску «Заримена 10.0» і до того, як тенно з’явилися на горизонті, архімедівка Марґуліс і Баллас зустрілися під час відкриття нової купольної оранжереї.",shape=box,color=blue];
		j1148616640 -> j2990315675;
	j168906940 [label="Наскільки мені відомо — а вона не зовсім надійне джерело, тому сприймай це з обережністю — на штами зараження для кожної партії протофреймів можна впливати окремо.",shape=box,color=red];
		j168906940 -> j577705976;
	j4274065716 [label="Зрозуміло…",shape=box,color=blue];
		j4274065716 -> j2673699573;
	j2576917005 [label="Оскільки кожен із них живе у своїй власній «безперервності» або часі. Усі штами зараження пов’язані між собою, але вони нібито живуть у… вузликах. Усе це дуже складно.",shape=box,color=red];
		j2576917005 -> j194447073;
	j1297887060 [label="Усесвіт, безперечно, став дивнішим відтоді як я його покинув…",shape=box,color=blue];
		j1297887060 -> j1729500772;
		j1297887060 -> j321014836;
	j167080762 [label="Тоді я не буду тебе втомлювати, розповідаючи цю історію ще раз, і залишу тебе шукати інші розваги на решту дня.",shape=box,color=blue];
		j167080762 -> j2888030837;
	j3597319874 [label="Якби я не був предметом твоєї розваги.",shape=box,color=blue];
		j3597319874 -> j4126400304;
	j4126400304 [label="Але? Попри все це… ",shape=box,color=blue];
		j4126400304 -> j85658441;
	j3440475363 [label="Boolean RoatheResetForgiven is now true.",color=orange];
		j3440475363 -> j4126400304;
	j2990315675 [label="Баллас був там заради церемонії — ми, звичайно, любимо помпезність і урочистість — а Марґуліс відчайдушно намагалася залишитися непоміченою.",shape=box,color=blue];
		j2990315675 -> j3975035747;
	j577705976 [label="Оскільки кожен із них живе у своїй власній «безперервності» або часі. Усі штами зараження пов’язані між собою, але вони нібито живуть у… вузликах. Усе це дуже складно.",shape=box,color=red];
		j577705976 -> j2023055248;
	j2673699573 [label="Усесвіт, безперечно, став дивнішим відтоді як я його покинув…",shape=box,color=blue];
		j2673699573 -> j267219224;
		j2673699573 -> j3268611792;
	j194447073 [label="Оскільки я можу зациклювати час, я можу зациклювати «партії» зараження в обмеженому режимі.",shape=box,color=red];
		j194447073 -> j1404959635;
	j1729500772 [label="Ти навіть не уявляєш.",shape=box,color=red];
		j1729500772 -> j3308225452;
	j321014836 [label="Вона лідирує в цьому питанні. Ну… не зважай.",shape=box,color=red];
		j321014836 -> j3308225452;
	j2888030837 [label="Boolean RoatheMargulis1 is now true.",color=orange];
		j2888030837 -> "Chat ends.";
	j85658441 [label="Баллас і Марґуліс.",shape=box,color=blue];
		j85658441 -> j1148616640;
	j3975035747 [label="Тобі потрібно зрозуміти, мій узурпаторе, що Баллас не мав жодних причин спілкуватися з нею. Жодних причин, хіба що його закоханість була справжньою.",shape=box,color=blue];
		j3975035747 -> j2814352735;
	j2023055248 [label="Оскільки я можу зациклювати час, я можу зациклювати «партії» зараження в обмеженому режимі.",shape=box,color=red];
		j2023055248 -> j1283996434;
	j267219224 [label="Ти навіть не уявляєш.",shape=box,color=red];
		j267219224 -> j2324726869;
	j3268611792 [label="Вона лідирує в цьому питанні. Ну… не зважай.",shape=box,color=red];
		j3268611792 -> j2324726869;
	j1404959635 [label="І хто «вона»?",shape=box,color=blue];
		j1404959635 -> j4104206698;
		j1404959635 -> j1286060796;
	j2814352735 [label="Це була не просто хтивість, адже він міг мати будь-кого, кого забажав, і часто це робив. Якби він хотів її, то міг просто взяти її та покінчити з нею.",shape=box,color=blue];
		j2814352735 -> j577228937;
	j1283996434 [label="І хто «вона»?",shape=box,color=blue];
		j1283996434 -> j3459911080;
		j1283996434 -> j3088812838;
	j2324726869 [label="Хай там як. Усе це в ім’я «кохання»?",shape=box,color=blue];
		j2324726869 -> j2372130242;
	j4104206698 [label="Ліззі. Ти б їй сподобався.",shape=box,color=red];
		j4104206698 -> j3863368899;
	j1286060796 [label="Балакуча гітара.",shape=box,color=red];
		j1286060796 -> j3863368899;
	j577228937 [label="Він був Виконавцем. Насправді, одним із найпотужніших із Семи. Він міг би викликати її до своєї спальні, і вона прийшла б туди без жодного вагання.",shape=box,color=blue];
		j577228937 -> j2163681571;
	j3459911080 [label="Ліззі. Ти б їй сподобався.",shape=box,color=red];
		j3459911080 -> j4274065716;
	j3088812838 [label="Балакуча гітара.",shape=box,color=red];
		j3088812838 -> j4274065716;
	j2163681571 [label="Але він так не вчинив. Того вечора Баллас поглянув на неї та… він був вражений, мандрівниче. Повністю й абсолютно приголомшений.",shape=box,color=blue];
		j2163681571 -> j2883072800;
	j2883072800 [label="Я ніколи не бачив нічого подібного. Здавалося, ніби в кімнаті, окрім Марґуліс, більше нікого не було. Він здавався навіть… якось занадто сором’язливим для того, щоби почати розмову з нею. Він! Баллас!",shape=box,color=blue];
		j2883072800 -> j26132745;
		j2883072800 -> j3123329195;
	j26132745 [label="Серйозно?",shape=box,color=red];
		j26132745 -> j1505495904;
	j3123329195 [label="Ти це вигадуєш.",shape=box,color=red];
		j3123329195 -> j1893809949;
	j1505495904 [label="Я клянусь тим, що залишилося від моєї честі! І з якої причини мені брехати? Яке мені діло до твоєї думки про справжність їхніх стосунків?",shape=box,color=blue];
		j1505495904 -> j2226846505;
	j1893809949 [label="Я клянусь тим, що залишилося від моєї честі, це не так! І з якої причини мені брехати? Яке мені діло до твоєї думки про справжність їхніх стосунків?",shape=box,color=blue];
		j1893809949 -> j2226846505;
	j2226846505 [label="Мені просто прикро, що ти так швидко спрощуєш те, що насправді набагато складніше, ніж ти собі уявляєш.",shape=box,color=blue];
		j2226846505 -> j2164970606;
	j2164970606 [label="Вони були закохані, хочеш ти в це вірити чи ні. Баллас відмовився від усіх класових правил і традицій, щоб мати своєю коханою та єдиною романтичною супутницею архімедівку. ",shape=box,color=blue];
		j2164970606 -> j1946933394;
	j1946933394 [label="Тільки справжнє кохання могло звести чоловіка з розуму так, як це сталося з ним, коли все пішло шкереберть…",shape=box,color=blue];
		j1946933394 -> j1438213249;
		j1946933394 -> j1014084337;
	j1438213249 [label="Як ти це розумієш? Хіба він не був відповідальний за її смерть?",shape=box,color=red];
		j1438213249 -> j3781182757;
	j1014084337 [label="Балас був тим, хто наказав її стратити.",shape=box,color=red];
		j1014084337 -> j3781182757;
	j3781182757 [label="По-перше, припустімо, що все, що ти знаєш — правда, і що його дії були винятково з його власної ініціативи. Припустімо, що за лаштунками не відбувалося жодних інших політичних маніпуляцій, шантажу чи чогось іншого, що могло б змусити його піти на цей крок.",shape=box,color=blue];
		j3781182757 -> j4277316111;
	j4277316111 [label="Навіть якби це було так, і Баллас засудив її до страти, не маючи на це жодного впливу, врахуй, що вже було запізно. Зрада, яку він відчував, уже розколола його навпіл.",shape=box,color=blue];
		j4277316111 -> j661686961;
	j661686961 [label="Його серце й розум уже були розбиті.",shape=box,color=blue];
		j661686961 -> j1483842477;
		j661686961 -> j1761581598;
	j1483842477 [label="Я не збираюся починати співчувати йому, якщо це те, про що ти мене просиш.",shape=box,color=red];
		j1483842477 -> j3924569300;
	j1761581598 [label="Через тенно? Або через те, що вони з нею зробили?",shape=box,color=red];
		j1761581598 -> j4048935213;
	j3924569300 [label="Я не прошу нічого подібного! Баллас заслуговує лише на те, щоб на його могилу мочилися, якщо в нього взагалі є могила.",shape=box,color=blue];
		j3924569300 -> j2872262929;
	j4048935213 [label="В якомусь сенсі й те, й інше. Того дня, коли він засудив її до страти, він був доведений до божевілля. Насправді я б не здивувався, якби якась частка його не пам’ятала про скоєне.",shape=box,color=blue];
		j4048935213 -> j1529483436;
	j2872262929 [label="Я лише стверджую, що в день, коли він засудив до її страти, він був божевільним. Я б не здивувався, якби якась частина його не пам’ятала про скоєний вчинок, після всього.",shape=box,color=blue];
		j2872262929 -> j1529483436;
	j1529483436 [label="Баллас кохав Марґуліс. Усім своїм єством, повністю — цілком відданий їй. Він би пожертвував заради неї чим завгодно. Своєю душею, тілом, орокінською імперією. Всім, про що можна тільки мріяти.",shape=box,color=blue];
		j1529483436 -> j401532914;
	j401532914 [label="Жодна ціна не була занадто великою. Жодна мораль не варта пожертви. Якби йому дали немовля і сказали, що Марґуліс хоче, щоб його мізки розлетілися об скло, воно б померло, перш ніж він дослухав би фразу.",shape=box,color=blue];
		j401532914 -> j3594715166;
	j3594715166 [label="Він би спалив Материнську систему дотла та відновив би за її образом, узурпаторе… але в цьому й полягає трагедія.",shape=box,color=blue];
		j3594715166 -> j2721675092;
	j2721675092 [label="Марґуліс? О, Марґуліс. Дорога, люба Марґуліс… вона все ще мала совість.",shape=box,color=blue];
		j2721675092 -> j2540116168;
	j2540116168 [label="І коли вона побачила бідних тенно, бідних, розірваних Порожнечею дітей… ",shape=box,color=blue];
		j2540116168 -> j2722584811;
	j2722584811 [label="Щось у її житті стало важливішим за Балласа. Щось у її житті, заради чого було варто віддати своє життя… але це був не він.",shape=box,color=blue];
		j2722584811 -> j622718748;
	j622718748 [label="Це було не її кохання до нього.",shape=box,color=blue];
		j622718748 -> j60751433;
	j60751433 [label="І він це знав, любий мандрівниче. Він зрозумів це тієї ж миті, як вона поглянула на них. І це стало очевидним, коли її «божевільні тварини» подбали про те, щоб вони були останніми, кого вона побачить. Принаймні такі чутки ходили серед нас, орокінів.",shape=box,color=blue];
		j60751433 -> j4178682389;
	j4178682389 [label="Ти можеш собі уявити радість для орокінів? Бачити, як розірвані Порожнечею виродки випалюють очі дорогоцінній архімедівці Балласа?",shape=box,color=blue];
		j4178682389 -> j3272428718;
	j3272428718 [label="Але я думаю, що саме коли Марґуліс боролася за порятунок тенно, тоді серце Балласа розбилося на тисячі шматочків і більше ніколи не відновилося.",shape=box,color=blue];
		j3272428718 -> j3071766011;
	j3071766011 [label="Бо він знав, що його витіснили з її серця.",shape=box,color=blue];
		j3071766011 -> j1722601190;
	j1722601190 [label="Мабуть, саме через це я йому співчував. А решта того, що було потім. Історія вічного кохання… і як воно закінчилося такою страшною трагедією. ",shape=box,color=blue];
		j1722601190 -> j1497842495;
	j1497842495 [label="Якби тобі було відомо, як вони всміхалися одне одному…",shape=box,color=blue];
		j1497842495 -> j711916968;
		j1497842495 -> j271575001;
	j711916968 [label="Ти можеш романтизувати те, що в них було, але це не виправдовує того, ким він був. Балласу не можна пробачити все, що він зробив.",shape=box,color=red];
		j711916968 -> j3780959559;
	j271575001 [label="Мене радує, що їхнє кохання було справжнім. Що з ним було… складно ще тоді. І Марґуліс не була іграшкою весь цей час.",shape=box,color=red];
		j271575001 -> j3936228499;
	j3780959559 [label="Add 1 to Thermostat counter",color=orange];
		j3780959559 -> j2988072273;
	j3936228499 [label="Add -1 to Thermostat counter",color=orange];
		j3936228499 -> j449700818;
	j2988072273 [label="+10 Chemistry",color=orange];
		j2988072273 -> j2851664602;
	j449700818 [label="+10 Chemistry",color=orange];
		j449700818 -> j723335235;
	j2851664602 [label="Я не намагаюся провести паралель між ними двома, узурпаторе. Я просто стверджую, що чоловік може бути коханим, але також здатним на жахливі вчинки. Ну що ж… для нас, решти розбещених дурнів, напевне, надії немає…",shape=box,color=blue];
		j2851664602 -> j1734974712;
	j723335235 [label="Дійсно. Іноді мене заспокоює думка, якщо навіть цей володар розпусти може знайти собі супутницю, то є надія і для решти з нас, еге ж? Ха!",shape=box,color=blue];
		j723335235 -> j1734974712;
	j1734974712 [label="Boolean RoatheMargulis1 is now true.",color=orange];
		j1734974712 -> j2261915606;
	j2261915606 [label="Але я вже витратив багато твого часу сьогодні. Тож забирайся. ",shape=box,color=blue];
		j2261915606 -> "Chat ends.";
}