		904 -> 916;
	905 [label="Люди не змінюються так сильно. В глибині душі він завжди був здатний на те, що зробив.",shape=box,color=red];
		905 -> 917;
	913 [label="Я пригадую слова, що в тебе «не вийшло» між нами, або справи з фанатиками якось заплуталися, що їх неможливо розплутати. То ти справді вважаєш, що це найкращий варіант, який у тебе був?",shape=box,color=blue];
