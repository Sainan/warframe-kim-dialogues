	1036 [label="+10 Chemistry",color=orange];
		1036 -> 1038;
	1037 [label="Я не намагаюся провести паралель між ними двома, узурпаторе. Я просто стверджую, що чоловік може бути коханим, але також здатним на жахливі вчинки. Ну що ж… для нас, решти розбещених дурнів, напевне, надії немає…",shape=box,color=blue];
		1037 -> 1039;
	1038 [label="Дійсно. Іноді мене заспокоює думка, якщо навіть цей володар розпусти може знайти собі супутницю, то є надія і для решти з нас, еге ж? Ха!",shape=box,color=blue];
