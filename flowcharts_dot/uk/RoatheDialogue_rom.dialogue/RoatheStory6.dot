	j2135411887 [label="СВІДОМІСТЬ",shape=box,color=blue];
		j2135411887 -> j1279467173;
	j1279467173 [label="Витяг: Ми не сприймали свідомих як «вони», радше як «воно». ",shape=box,color=blue];
		j1279467173 -> j2092709182;
	j2092709182 [label="На нас сунули легіони, до власного життя в яких було не більше поваги, ніж у кров’яних тілець.",shape=box,color=blue];
		j2092709182 -> j2402408804;
	j2402408804 [label="То були клітини в тілі зловісної розлогої маси.",shape=box,color=blue];
		j2402408804 -> j4122420439;
	j4122420439 [label="Думаю, ми були занадто самовпевнені у своїх здобутках у боротьбі із зараженням — теж колективним розумом, але геть іншого порядку.",shape=box,color=blue];
		j4122420439 -> j4032020249;
	j4032020249 [label="Свідомим наказали еволюціонувати. Моделлю кінцевої точки еволюції були ми.",shape=box,color=blue];
		j4032020249 -> j3453915637;
	j3453915637 [label="Вони поверталися у Материнську систему не лише для того, щоб знищити орокінів. А щоб замінити їх і зрештою… стати ліпшими за них.",shape=box,color=blue];
		j3453915637 -> j921430358;
	j921430358 [label="Add 1 to HellStory counter",color=orange];
		j921430358 -> "Chat ends.";
}