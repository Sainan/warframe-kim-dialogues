	2180 [label="Витяг: Ми не сприймали свідомих як «вони», радше як «воно». ",shape=box,color=blue];
		2180 -> 5691;
	5691 [label="На нас сунули легіони, до власного життя в яких було не більше поваги, ніж у кров’яних тілець.",shape=box,color=blue];
		5691 -> 2178;
