		2178 -> 5690;
	5690 [label="Думаю, ми були занадто самовпевнені у своїх здобутках у боротьбі із зараженням — тех колективним розумом, але геть іншого порядку.",shape=box,color=blue];
		5690 -> 2179;
	2179 [label="Свідомим наказали еволюціонувати. Моделлю кінцевої точки еволюції були ми.",shape=box,color=blue];
		2179 -> 5687;
	5687 [label="Вони поверталися у Материнську систему не лише для того, щоб знищити орокінів. А щоб замінити їх і зрештою… стати ліпшими за них.",shape=box,color=blue];
