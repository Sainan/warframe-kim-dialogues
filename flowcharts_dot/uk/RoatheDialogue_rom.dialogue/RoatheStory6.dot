	"Chat ends." [color=orange];
	j31224881 [label="СВІДОМІСТЬ",shape=box,color=blue];
		j31224881 -> j54610789;
	j54610789 [label="Витяг: Ми не сприймали свідомих як «вони», радше як «воно». ",shape=box,color=blue];
		j54610789 -> j1019787219;
	j1019787219 [label="На нас сунули легіони, до власного життя в яких було не більше поваги, ніж у кров’яних тілець.",shape=box,color=blue];
		j1019787219 -> j1151734507;
	j1151734507 [label="То були клітини в тілі зловісної розлогої маси.",shape=box,color=blue];
		j1151734507 -> j4234615010;
	j4234615010 [label="Думаю, ми були занадто самовпевнені у своїх здобутках у боротьбі із зараженням — тех колективним розумом, але геть іншого порядку.",shape=box,color=blue];
		j4234615010 -> j4032020249;
	j4032020249 [label="Свідомим наказали еволюціонувати. Моделлю кінцевої точки еволюції були ми.",shape=box,color=blue];
		j4032020249 -> j3453915637;
	j3453915637 [label="Вони поверталися у Материнську систему не лише для того, щоб знищити орокінів. А щоб замінити їх і зрештою… стати ліпшими за них.",shape=box,color=blue];
		j3453915637 -> j921430358;
	j921430358 [label="Add 1 to HellStory counter",color=orange];
		j921430358 -> "Chat ends.";
}