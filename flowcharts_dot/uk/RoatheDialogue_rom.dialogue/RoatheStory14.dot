	"Chat ends." [color=orange];
	j2261576696 [label="ПРИСТОСУВАННЯ",shape=box,color=blue];
		j2261576696 -> j4181598068;
	j4181598068 [label="Витяг: Багато свідомих еволюціонували в сутичках, тому ми не мали впевненості, що зустрінемося з одним і тим самим ворогом двічі. Але інші лишалися в незмінній формі, наче вже давно досягли якоїсь певної точки.",shape=box,color=blue];
		j4181598068 -> j1282315813;
	j1282315813 [label="Досконалі вбивці, вони наганяли такого ж крижаного жаху, що й акула.",shape=box,color=blue];
		j1282315813 -> j2718977295;
	j2718977295 [label="Це було якесь божевілля. Як я можу напарцьовувати стратегії боїв із крабоподібними зорельотами свідомих, якщо одразу після винайдення такої ці судна замінили кротовинні зорельоти?",shape=box,color=blue];
		j2718977295 -> j2492434680;
	j2492434680 [label="І скільки протримаються ці кротовинні зорельоти, перш ніж їх замінить якесь нове жахіття?",shape=box,color=blue];
		j2492434680 -> j4040075750;
	j4040075750 [label="Усе, що нам лишалося — відкотитися назад. Прогрес виявився фатальним. Старі традиції, благословенні часом шляхи честі й дисципліни, вимагали свого.",shape=box,color=blue];
		j4040075750 -> j921430358;
	j921430358 [label="Add 1 to HellStory counter",color=orange];
		j921430358 -> "Chat ends.";
}