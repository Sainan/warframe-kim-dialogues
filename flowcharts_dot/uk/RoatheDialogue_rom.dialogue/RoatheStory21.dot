	j1758019620 [label="ЗАБУТТЯ",shape=box,color=blue];
		j1758019620 -> j3405357453;
	j3405357453 [label="Витяг: Боягуз.",shape=box,color=blue];
		j3405357453 -> j2333570573;
	j2333570573 [label="Саме так вони мене називали, чи не так? Я читав історичні записи, розкидані по цій запиленій залі. Брехня. Вони не знали правди. Того, що мене вирвали з мого часу, перш ніж я завершив свою справу.",shape=box,color=blue];
		j2333570573 -> j430879610;
	j430879610 [label="Боягуз.",shape=box,color=blue];
		j430879610 -> j1338818852;
	j1338818852 [label="Я пам’ятаю тепер. Він підійшов до мене в Золотих Залах. Він мав обличчя, якого я не знав. Але для нашого роду це не рідкість. Я знав його голос. Я знав його рухи.",shape=box,color=blue];
		j1338818852 -> j1192391066;
	j1192391066 [label="Боягуз!",shape=box,color=blue];
		j1192391066 -> j2138177216;
	j2138177216 [label="Він поставив мені єдине запитання. Чи справді я вірив, що мене можна вибачити за те, що я спалив усе до тла?",shape=box,color=blue];
		j2138177216 -> j445670709;
	j445670709 [label="БОЯГУЗ!",shape=box,color=blue];
		j445670709 -> j3464903206;
	j3464903206 [label="У простягнутій блідій руці був… шприц. Він сяяв свободою… іще одним шансом… в іншому житті.",shape=box,color=blue];
		j3464903206 -> j4118231025;
	j4118231025 [label="Я взяв його.",shape=box,color=blue];
		j4118231025 -> j1703429258;
	j1703429258 [label="БОЯГУЗ!",shape=box,color=blue];
		j1703429258 -> j921430358;
	j921430358 [label="Add 1 to HellStory counter",color=orange];
		j921430358 -> "Chat ends.";
}