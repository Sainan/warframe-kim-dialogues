	2282 [label="Принаймні наша поразка буде прекрасною. Пам’ятною.",shape=box,color=blue];
		2282 -> 2283;
	2283 [label="Попри всі очікування вони вистояли. Невдовзі з фронту почали надходити звістки про неймовірно героїчний героїзм.",shape=box,color=blue];
		2283 -> 5715;
	5715 [label="Ворфрейми спускалися з небес, мов янголи, звільняючи полонених і знищуючи укріплення свідомих. Навіть поодинці вони були дивом; гуртом — богами.",shape=box,color=blue];
