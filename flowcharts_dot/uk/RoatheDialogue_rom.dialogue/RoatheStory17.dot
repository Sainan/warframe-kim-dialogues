	j75581230 [label="ВОРФРЕЙМИ",shape=box,color=blue];
		j75581230 -> j269886396;
	j269886396 [label="Витяг: Спершу ворфрейми сприймалися радше як витвори мистецтва, аніж справжня зброя.",shape=box,color=blue];
		j269886396 -> j698435614;
	j698435614 [label="Війна була майже програна. Свідомі стали непереможними. Тож чому б не створити цих дивних і нереальних воїнів та не дати їм у руки зброю з давніх-давен.",shape=box,color=blue];
		j698435614 -> j452681363;
	j452681363 [label="Принаймні наша поразка буде прекрасною. Пам’ятною.",shape=box,color=blue];
		j452681363 -> j1145290288;
	j1145290288 [label="Попри всі очікування вони вистояли. Невдовзі з фронту почали надходити звістки про неймовірно героїчний героїзм.",shape=box,color=blue];
		j1145290288 -> j1932513477;
	j1932513477 [label="Ворфрейми спускалися з небес, мов янголи, звільняючи полонених і знищуючи укріплення свідомих. Навіть поодинці вони були дивом; гуртом — богами.",shape=box,color=blue];
		j1932513477 -> j2592312588;
	j2592312588 [label="Тож не дивно, що їх сприймали як пропаганду.",shape=box,color=blue];
		j2592312588 -> j921430358;
	j921430358 [label="Add 1 to HellStory counter",color=orange];
		j921430358 -> "Chat ends.";
}