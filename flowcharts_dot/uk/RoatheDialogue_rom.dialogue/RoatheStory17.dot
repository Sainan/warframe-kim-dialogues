	2286 [label="Витяг: Спершу ворфрейми сприймалися радше як витвори мистецтва, аніж справжня зброя.",shape=box,color=blue];
		2286 -> 2285;
	2285 [label="Війна була майже програна. Свідомі стали непереможними. Тож чому б не створити цих дивних і нереальних воїнів та не дати їм у руки зброю з давніх-давен.",shape=box,color=blue];
