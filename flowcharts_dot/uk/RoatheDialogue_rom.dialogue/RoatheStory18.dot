		5717 -> 5718;
	5718 [label="Виконавиця Нітог була обурена. Вона очікувала величного наростання, битви за битвою, що завершаться кульмінаційною екстазою орокінської загибелі.",shape=box,color=blue];
		5718 -> 5719;
	5719 [label="Після чого вона вийшла б з укриття і… ну, тут мені лишається здогадуватися. Можливо, вона розраховувала стати довіреною свідомих.",shape=box,color=blue];
		5719 -> 2291;
	2291 [label="Або думала, що вони покинуть випалені сплюндровані рештки Материнської системи й залишать її вибудовувати власне королівство.",shape=box,color=blue];
		2291 -> 2297;
