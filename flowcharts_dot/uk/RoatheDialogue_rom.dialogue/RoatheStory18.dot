	j3716038126 [label="ЗРАДА",shape=box,color=blue];
		j3716038126 -> j4240541071;
	j4240541071 [label="Витяг: «Мир?»",shape=box,color=blue];
		j4240541071 -> j894113925;
	j894113925 [label="Її голос був наче скрегіт битого скла.",shape=box,color=blue];
		j894113925 -> j682377303;
	j682377303 [label="Виконавиця Нітог була обурена. Вона очікувала величного наростання, битви за битвою, що завершаться кульмінаційною екстазою орокінської загибелі.",shape=box,color=blue];
		j682377303 -> j3150147751;
	j3150147751 [label="Після чого вона вийшла б з укриття і… ну, тут мені лишається здогадуватися. Можливо, вона розраховувала стати довіреною свідомих.",shape=box,color=blue];
		j3150147751 -> j3396193972;
	j3396193972 [label="Або думала, що вони покинуть випалені сплюндровані рештки Материнської системи й залишать її вибудовувати власне королівство.",shape=box,color=blue];
		j3396193972 -> j4288231818;
	j4288231818 [label="Менше з тим. Мир ніхто не збирався терпіти. Тож ми почали роботу над його розриванням.",shape=box,color=blue];
		j4288231818 -> j921430358;
	j921430358 [label="Add 1 to HellStory counter",color=orange];
		j921430358 -> "Chat ends.";
}