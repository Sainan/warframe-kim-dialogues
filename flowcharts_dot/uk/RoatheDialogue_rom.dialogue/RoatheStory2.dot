	2147 [label="Це був величний крейсер Виконавця Торміса. У цьому виборі легко зчитувався суспільний докір Виконавцю Тувулу за грандіозну невдачу з «Зарименом 10.0». ",shape=box,color=blue];
		2147 -> 2137;
	2137 [label="Торміс вирушив туди й повернувся, привізши розкішні й прикрашені спогади про нову систему та нові світи для заселення. ",shape=box,color=blue];
		2137 -> 5682;
