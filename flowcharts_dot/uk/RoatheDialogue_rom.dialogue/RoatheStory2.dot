	"Chat ends." [color=orange];
	j3828629466 [label="З’ЄДНАННЯ",shape=box,color=blue];
		j3828629466 -> j116919299;
	j116919299 [label="Витяг: Коли свідомі завершили сонячну рейку до Тау, то не було пишних урочистостей. Вона просто почала працювати.",shape=box,color=blue];
		j116919299 -> j426013406;
	j426013406 [label="Звісно, поспіхом церемонію таки провели, бо жоден істинний орокін навіть шмарклі не висякає, не дотримавшись відповідної помпезності та церемоній.",shape=box,color=blue];
		j426013406 -> j1577885720;
	j1577885720 [label="Щодо першого транспортника, який мав зробити перехід, здійнявся справжній ґвалт.",shape=box,color=blue];
		j1577885720 -> j2518198623;
	j2518198623 [label="Це був величний крейсер Виконавця Торміса. У цьому виборі легко зчитувався суспільний докір Виконавцю Тувулу за грандіозну невдачу з «Зарименом 10.0». ",shape=box,color=blue];
		j2518198623 -> j371437281;
	j371437281 [label="Торміс вирушив туди й повернувся, привізши розкішні й прикрашені спогади про нову систему та нові світи для заселення. ",shape=box,color=blue];
		j371437281 -> j2841889665;
	j2841889665 [label="За кілька днів у політ вирушила флотилія зорельотів колоністів, котрі прагнули ступити на незаймані узбережжя.",shape=box,color=blue];
		j2841889665 -> j3494062080;
	j3494062080 [label="Напад свідомих, який почався після цього, доволі спаскудив настрій.",shape=box,color=blue];
		j3494062080 -> j921430358;
	j921430358 [label="Add 1 to HellStory counter",color=orange];
		j921430358 -> "Chat ends.";
}