digraph {
	135 [label="RoatheRank1Convo2 begins.",color=orange];
		135 -> 136;
	136 [label="Ти ж усвідомлюєш, що твоя так звана «Байдужість» не є «богом» насправді, чи не так?",shape=box,color=blue];
		136 -> 139;
		136 -> 138;
		136 -> 137;
	139 [label="Вона досить близько до нього.",shape=box,color=red];
		139 -> 142;
	138 [label="І що робить тебе таким упевненим?",shape=box,color=red];
		138 -> 141;
	137 [label="[Завершити розмову]",shape=box,color=red];
		137 -> 140;
	142 [label="Усі, з ким я розмовляв у цій божевільні, повністю переконані, що ця «Людина в стіні» — якийсь буквальний і сміховинний бог. Справжній бог. Навіть ці два фанатики, здається, поділяють цю думку!",shape=box,color=blue];
		142 -> 144;
		142 -> 145;
		142 -> 146;
	141 [label="Що ж, якщо відкинути сувору реальність того, що будь-яка віра в бога чи богів походить від ідіотів, які чіпляються за: по-перше, тотальну потребу вчепитися в опудало, стикаючись зі звірячим жахом завершення своєї душі, коли вона досягає смерті,",shape=box,color=blue];
		141 -> 143;
	140 [label="Chat ends.",color=orange];
	144 [label="Ти не думаєш, що вона справжня?",shape=box,color=red];
		144 -> 148;
	145 [label="Якщо ти не думаєш, що це бог, тоді хто це?",shape=box,color=red];
		145 -> 149;
	146 [label="А ти ні?",shape=box,color=red];
		146 -> 150;
	143 [label="по-друге, тривогу, яку людина відчуває, коли розуміє, що немає жодної «Вищої Сили», яка б розгортала наше життя, і тому ми просто несемо відповідальність за власні дії, а отже, відповідно,",shape=box,color=blue];
		143 -> 147;
	148 [label="Хіба я так сказав? Не поспішай вкладати свої слова в мої уста, о Позачасовий узурпаторе. Я не заперечую, що Байдужість «реальна». Я заперечую, що вона є Богом.",shape=box,color=blue];
		148 -> 152;
		148 -> 153;
	149 [label="Я можу позбавити тебе цього фальшивого божества двома простими словами, які потрібно добре знати та розуміти:",shape=box,color=blue];
		149 -> 154;
	150 [label="Абсолютно ні! По-перше, немає ні бога, ні богів, ця ідея безглузда. По-друге, думати, що Альбрехт звільнив бога Порожнечі, ще смішніше!",shape=box,color=blue];
		150 -> 155;
	147 [label="по-третє, праведний гнів, який супроводжує тривогу та жах, коли все це призводить до прозріння, що немає ні «Пекла», де на нас чекає диявол, ні «Раю», де на нас чекають янголи.",shape=box,color=blue];
		147 -> 151;
	152 [label="Ця річ сильніше за все, з чим мені коли-небудь доводилося мати справу.",shape=box,color=red];
		152 -> 156;
	153 [label="Як ти думаєш, що це тоді?",shape=box,color=red];
		153 -> 149;
	154 [label="Концептуальне втілення.",shape=box,color=blue];
		154 -> 157;
		154 -> 158;
		154 -> 159;
	155 [label="У Порожнечі нічого немає. Саме тому вона називається Порожнечею! ",shape=box,color=blue];
		155 -> 160;
		155 -> 161;
	151 [label="Я припускаю, що ти не маєш відношення до скигліїв-фанатиків, які чіпляються за гнів, жах чи тривогу. Виходячи з цього припущення, я збираюся перейти до другого аргументу, який хочу представити тобі на користь позбавлення Байдужості статусу Божественності:",shape=box,color=blue];
		151 -> 154;
	156 [label="І коли я таке заперечував? Насправді складається враження, що вам усім удалося довести себе до істеричного та безпідставно обурливого стану страждань.",shape=box,color=blue];
		156 -> 162;
		156 -> 163;
	157 [label="Порожнеча небезпечна та могутня, як і те, що ми можемо зробити з неї. Повір, я знаю. Але вона має межі. Ти справді думаєш, що вона може проявити щось подібне? Це щось може створювати цілі мови, пальці, здатні живити цілі зорельоти, які стрибають через Порожнечу?",shape=box,color=red];
		157 -> 164;
	158 [label="У це… дуже хочеться повірити, що це лише монстр під нашим ліжком, Роуте. Але після зустрічі з цим віч-на-віч я не знаю, як щось подібне може бути створене нашою свідомістю.",shape=box,color=red];
		158 -> 165;
	159 [label="Концептуальне втілення не може зробити те, на що здатна Людина в стіні. Хоча Ентраті, можливо, виявив цю річ — і несе відповідальність за її перенесення сюди — але я не вірю, що він є першоджерелом.",shape=box,color=red];
		159 -> 166;
	160 [label="Ні. Я знаю речі, які походять із Порожнечі. Янголи. Спів. Привиди.",shape=box,color=red];
		160 -> 167;
	161 [label="Я… ",shape=box,color=red];
		161 -> 167;
	162 [label="Що ти хочеш сказати?",shape=box,color=red];
		162 -> 168;
	163 [label="Зажди. Яким чином ми винні в цьому? Лише Альбрехт винен, він це випустив.",shape=box,color=red];
		163 -> 169;
	164 [label="Людство, звісно, ніщо інше як творчість у широті та масштабах нових форм страждань, які воно може собі вигадати, чи не так? На твою долю випало багато форм жорстокості, які, я впевнений, ніхто не міг би уявити, що вони можливі за часів наших фанатиків.",shape=box,color=blue];
		164 -> 170;
	165 [label="Ех, ти так близько підходиш до істини, але так швидко відкидаєш її. Ти думаєш, що «спокусливо» повірити, що це витвір нашого власного розуму, адже якби це було так, було б легше це відкинути? Ні, я думаю, що набагато небезпечніше зіткнутися з нашим власним творінням, ніж із богом.",shape=box,color=blue];
		165 -> 171;
	166 [label="Хоча я ціную твоє смирення, проте кидаю виклик твоєму обмеженому розумінню можливостей людської винахідливості, особливо, що стосується вигадування нових форм страждань. Хіба ти не несеш повну відповідальність за створення власного всесвіту з нічого?",shape=box,color=blue];
		166 -> 172;
	167 [label="Єдине, що походить з Порожнечі, це те, що ми поміщаємо в неї, й те, що повертається з неї. Вона може змінити матерію та енергію, але не може її створити.",shape=box,color=blue];
		167 -> 173;
	168 [label="Я хочу сказати, що Альбрехт міг бути тим, хто спочатку побачив свою власну пиху як обличчя усміхненого бога руйнувань.",shape=box,color=blue];
		168 -> 174;
	169 [label="Альбрехт міг бути тим, хто спочатку побачив свою власну пиху як обличчя усміхненого бога руйнувань.",shape=box,color=blue];
		169 -> 174;
	170 [label="+15 Chemistry",color=orange];
		170 -> 175;
	171 [label="Зовнішнього ворога можна зрозуміти. Маніпулювати. Перемогти. Або, можливо, навіть домовитися, якщо на те пішло. У нього є слабкі сторони, якими можна скористатися. Але якщо це внутрішній ворог? Якого ми самі створили? Це насправді набагато підступніше.",shape=box,color=blue];
		171 -> 176;
	172 [label="На твою долю випало багато форм жорстокості, які, я впевнений, ніхто не міг би уявити, що вони можливі за часів наших фанатиків. ",shape=box,color=blue];
		172 -> 177;
	173 [label="Подумай, мандрівниче. Ці «Янголи Порожнечі», про яких ти говориш. Ці привиди. Чи були вони зроблені з тих, хто вже загубився в Порожнечі?",shape=box,color=blue];
		173 -> 178;
	174 [label="Але ви всі однаково винні в тому, що продовжуєте котити цей кавелик жука-гнойовика вниз по схилу, збільшуючи його з кожним шаром лайна, яке збираєте по дорозі!",shape=box,color=blue];
		174 -> 179;
	175 [label="Як вид ми напрочуд дивовижні у своїй здатності підживлювати свої страхи новими способами самознищення.",shape=box,color=blue];
		175 -> 180;
	176 [label="+20 Chemistry",color=orange];
		176 -> 181;
	177 [label="+10 Chemistry",color=orange];
		177 -> 175;
	178 [label="Вони були лише відлунням енергії, наче відрижка барвистого кутака, щоб нагодувати своїх дітей.",shape=box,color=blue];
		178 -> 179;
	179 [label="Дозволь мені спростити цю тему для тебе. Я можу позбавити тебе цього фальшивого божества двома простими словами, які потрібно добре знати та розуміти:",shape=box,color=blue];
		179 -> 154;
	180 [label="М-м. Боюся, мені час іти. Дозволю тобі посидіти на самоті та поміркувати над моїми словами.",shape=box,color=blue];
		180 -> 182;
		180 -> 183;
	181 [label="Тому що тоді ми повинні побороти або опанувати демонів. А людство… ніколи не виграє такі війни, чи не так?",shape=box,color=blue];
		181 -> 180;
	182 [label="Я так і зроблю. Дякую.",shape=box,color=red];
		182 -> 184;
	183 [label="Поміркуй над моїми, можливо, тобі захочеться повірити в них, коли ти зіткнешся з антибогом.",shape=box,color=red];
		183 -> 184;
	184 [label="Update boolean RoatheMITW1",color=orange];
		184 -> 185;
	185 [label="Chat ends.",color=orange];
}