digraph {
	graph [fontname="Roboto Condensed"];
	node [fontname="Roboto Condensed"];
	edge [fontname="Roboto Condensed"];

	"RoatheRank1Convo2 begins." [color=orange];
		"RoatheRank1Convo2 begins." -> j196576913;
	j196576913 [label="Ти ж усвідомлюєш, що твоя так звана «Байдужість» не є «богом» насправді, чи не так?",shape=box,color=blue];
		j196576913 -> j564348610;
		j196576913 -> j1385219437;
		j196576913 -> j1478915251;
	j564348610 [label="Вона досить близько до нього.",shape=box,color=red];
		j564348610 -> j3590644785;
	j1385219437 [label="І що робить тебе таким упевненим?",shape=box,color=red];
		j1385219437 -> j1325395121;
	j1478915251 [label="[Завершити розмову]",shape=box,color=red];
		j1478915251 -> "Chat ends.";
	j3590644785 [label="Усі, з ким я розмовляв у цій божевільні, повністю переконані, що ця «Людина в стіні» — якийсь буквальний і сміховинний бог. Справжній бог. Навіть ці два фанатики, здається, поділяють цю думку!",shape=box,color=blue];
		j3590644785 -> j2878732932;
		j3590644785 -> j16212081;
		j3590644785 -> j1653162245;
	j1325395121 [label="Що ж, якщо відкинути сувору реальність того, що будь-яка віра в бога чи богів походить від ідіотів, які чіпляються за: по-перше, тотальну потребу вчепитися в опудало, стикаючись зі звірячим жахом завершення своєї душі, коли вона досягає смерті,",shape=box,color=blue];
		j1325395121 -> j902819448;
	"Chat ends." [color=orange];
	j2878732932 [label="Ти не думаєш, що вона справжня?",shape=box,color=red];
		j2878732932 -> j4248535509;
	j16212081 [label="Якщо ти не думаєш, що це бог, тоді хто це?",shape=box,color=red];
		j16212081 -> j658862223;
	j1653162245 [label="А ти ні?",shape=box,color=red];
		j1653162245 -> j2191188548;
	j902819448 [label="по-друге, тривогу, яку людина відчуває, коли розуміє, що немає жодної «Вищої Сили», яка б розгортала наше життя, і тому ми просто несемо відповідальність за власні дії, а отже, відповідно,",shape=box,color=blue];
		j902819448 -> j554878197;
	j4248535509 [label="Хіба я так сказав? Не поспішай вкладати свої слова в мої уста, о Позачасовий узурпаторе. Я не заперечую, що Байдужість «реальна». Я заперечую, що вона є Богом.",shape=box,color=blue];
		j4248535509 -> j882867722;
		j4248535509 -> j3953316247;
	j658862223 [label="Я можу позбавити тебе цього фальшивого божества двома простими словами, які потрібно добре знати та розуміти:",shape=box,color=blue];
		j658862223 -> j2831670022;
	j2191188548 [label="Абсолютно ні! По-перше, немає ні бога, ні богів, ця ідея безглузда. По-друге, думати, що Альбрехт звільнив бога Порожнечі, ще смішніше!",shape=box,color=blue];
		j2191188548 -> j2472275290;
	j554878197 [label="по-третє, праведний гнів, який супроводжує тривогу та жах, коли все це призводить до прозріння, що немає ні «Пекла», де на нас чекає диявол, ні «Раю», де на нас чекають янголи.",shape=box,color=blue];
		j554878197 -> j2735026180;
	j882867722 [label="Ця річ сильніше за все, з чим мені коли-небудь доводилося мати справу.",shape=box,color=red];
		j882867722 -> j2331430728;
	j3953316247 [label="Як ти думаєш, що це тоді?",shape=box,color=red];
		j3953316247 -> j658862223;
	j2831670022 [label="Концептуальне втілення.",shape=box,color=blue];
		j2831670022 -> j992242525;
		j2831670022 -> j69912984;
		j2831670022 -> j935865496;
	j2472275290 [label="У Порожнечі нічого немає. Саме тому вона називається Порожнечею! ",shape=box,color=blue];
		j2472275290 -> j1204798134;
		j2472275290 -> j4050248715;
	j2735026180 [label="Я припускаю, що ти не маєш відношення до скигліїв-фанатиків, які чіпляються за гнів, жах чи тривогу. Виходячи з цього припущення, я збираюся перейти до другого аргументу, який хочу представити тобі на користь позбавлення Байдужості статусу Божественності:",shape=box,color=blue];
		j2735026180 -> j2831670022;
	j2331430728 [label="І коли я таке заперечував? Насправді складається враження, що вам усім удалося довести себе до істеричного та безпідставно обурливого стану страждань.",shape=box,color=blue];
		j2331430728 -> j1173485869;
		j2331430728 -> j914945274;
	j992242525 [label="Порожнеча небезпечна та могутня, як і те, що ми можемо зробити з неї. Повір, я знаю. Але вона має межі. Ти справді думаєш, що вона може проявити щось подібне? Це щось може створювати цілі мови, пальці, здатні живити цілі зорельоти, які стрибають через Порожнечу?",shape=box,color=red];
		j992242525 -> j2065615367;
	j69912984 [label="У це… дуже хочеться повірити, що це лише монстр під нашим ліжком, Роуте. Але після зустрічі з цим віч-на-віч я не знаю, як щось подібне може бути створене нашою свідомістю.",shape=box,color=red];
		j69912984 -> j906675846;
	j935865496 [label="Концептуальне втілення не може зробити те, на що здатна Людина в стіні. Хоча Ентраті, можливо, виявив цю річ — і несе відповідальність за її перенесення сюди — але я не вірю, що він є першоджерелом.",shape=box,color=red];
		j935865496 -> j2980361454;
	j1204798134 [label="Ні. Я знаю речі, які походять із Порожнечі. Янголи. Спів. Привиди.",shape=box,color=red];
		j1204798134 -> j2431941909;
	j4050248715 [label="Я… ",shape=box,color=red];
		j4050248715 -> j2431941909;
	j1173485869 [label="Що ти хочеш сказати?",shape=box,color=red];
		j1173485869 -> j2512700443;
	j914945274 [label="Зажди. Яким чином ми винні в цьому? Лише Альбрехт винен, він це випустив.",shape=box,color=red];
		j914945274 -> j1788490377;
	j2065615367 [label="Людство, звісно, ніщо інше як творчість у широті та масштабах нових форм страждань, які воно може собі вигадати, чи не так? На твою долю випало багато форм жорстокості, які, я впевнений, ніхто не міг би уявити, що вони можливі за часів наших фанатиків.",shape=box,color=blue];
		j2065615367 -> j116303292;
	j906675846 [label="Ех, ти так близько підходиш до істини, але так швидко відкидаєш її. Ти думаєш, що «спокусливо» повірити, що це витвір нашого власного розуму, адже якби це було так, було б легше це відкинути? Ні, я думаю, що набагато небезпечніше зіткнутися з нашим власним творінням, ніж із богом.",shape=box,color=blue];
		j906675846 -> j975162543;
	j2980361454 [label="Хоча я ціную твоє смирення, проте кидаю виклик твоєму обмеженому розумінню можливостей людської винахідливості, особливо, що стосується вигадування нових форм страждань. Хіба ти не несеш повну відповідальність за створення власного всесвіту з нічого?",shape=box,color=blue];
		j2980361454 -> j3654908351;
	j2431941909 [label="Єдине, що походить з Порожнечі, це те, що ми поміщаємо в неї, й те, що повертається з неї. Вона може змінити матерію та енергію, але не може її створити.",shape=box,color=blue];
		j2431941909 -> j3230313755;
	j2512700443 [label="Я хочу сказати, що Альбрехт міг бути тим, хто спочатку побачив свою власну пиху як обличчя усміхненого бога руйнувань.",shape=box,color=blue];
		j2512700443 -> j90556629;
	j1788490377 [label="Альбрехт міг бути тим, хто спочатку побачив свою власну пиху як обличчя усміхненого бога руйнувань.",shape=box,color=blue];
		j1788490377 -> j90556629;
	j116303292 [label="+15 Chemistry",color=orange];
		j116303292 -> j1423877815;
	j975162543 [label="Зовнішнього ворога можна зрозуміти. Маніпулювати. Перемогти. Або, можливо, навіть домовитися, якщо на те пішло. У нього є слабкі сторони, якими можна скористатися. Але якщо це внутрішній ворог? Якого ми самі створили? Це насправді набагато підступніше.",shape=box,color=blue];
		j975162543 -> j1253355320;
	j3654908351 [label="На твою долю випало багато форм жорстокості, які, я впевнений, ніхто не міг би уявити, що вони можливі за часів наших фанатиків. ",shape=box,color=blue];
		j3654908351 -> j3328412164;
	j3230313755 [label="Подумай, мандрівниче. Ці «Янголи Порожнечі», про яких ти говориш. Ці привиди. Чи були вони зроблені з тих, хто вже загубився в Порожнечі?",shape=box,color=blue];
		j3230313755 -> j2298899759;
	j90556629 [label="Але ви всі однаково винні в тому, що продовжуєте котити цей кавелик жука-гнойовика вниз по схилу, збільшуючи його з кожним шаром лайна, яке збираєте по дорозі!",shape=box,color=blue];
		j90556629 -> j1230699336;
	j1423877815 [label="Як вид ми напрочуд дивовижні у своїй здатності підживлювати свої страхи новими способами самознищення.",shape=box,color=blue];
		j1423877815 -> j1425923550;
	j1253355320 [label="+20 Chemistry",color=orange];
		j1253355320 -> j3079472297;
	j3328412164 [label="+10 Chemistry",color=orange];
		j3328412164 -> j1423877815;
	j2298899759 [label="Вони були лише відлунням енергії, наче відрижка барвистого кутака, щоб нагодувати своїх дітей.",shape=box,color=blue];
		j2298899759 -> j1230699336;
	j1230699336 [label="Дозволь мені спростити цю тему для тебе. Я можу позбавити тебе цього фальшивого божества двома простими словами, які потрібно добре знати та розуміти:",shape=box,color=blue];
		j1230699336 -> j2831670022;
	j1425923550 [label="М-м. Боюся, мені час іти. Дозволю тобі посидіти на самоті та поміркувати над моїми словами.",shape=box,color=blue];
		j1425923550 -> j663143319;
		j1425923550 -> j3174918065;
	j3079472297 [label="Тому що тоді ми повинні побороти або опанувати демонів. А людство… ніколи не виграє такі війни, чи не так?",shape=box,color=blue];
		j3079472297 -> j1425923550;
	j663143319 [label="Я так і зроблю. Дякую.",shape=box,color=red];
		j663143319 -> j3819439049;
	j3174918065 [label="Поміркуй над моїми, можливо, тобі захочеться повірити в них, коли ти зіткнешся з антибогом.",shape=box,color=red];
		j3174918065 -> j3819439049;
	j3819439049 [label="Boolean RoatheMITW1 is now true.",color=orange];
		j3819439049 -> "Chat ends.";
}