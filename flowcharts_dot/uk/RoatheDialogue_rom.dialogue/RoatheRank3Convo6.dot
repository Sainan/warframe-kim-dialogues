digraph {
	2049 [label="RoatheRank3Convo6 begins.",color=orange];
		2049 -> 2052;
		2049 -> 2050;
		2049 -> 2051;
	2052 [label="Роуте, чому ти стільки часу проводиш із кавіями?",shape=box,color=red];
		2052 -> 2055;
	2050 [label="Не наближайся до кавій, Роуте. Я через це нервую.",shape=box,color=red];
		2050 -> 2053;
	2051 [label="[Завершити розмову]",shape=box,color=red];
		2051 -> 2054;
	2055 [label="Гм? Ну, я вважаю їх одними з найсумніших і найжалюгідніших створінь, яких я коли-небудь зустрічав у всій проклятій Порожнечею Материнській системі. ",shape=box,color=blue];
		2055 -> 2057;
	2053 [label="Щоб уникнути якомога більше непорозумінь у цій ситуації, я уникну своєї звичайної багатослівності та просто скажу тобі: ",shape=box,color=blue];
		2053 -> 2056;
	2054 [label="Chat ends.",color=orange];
	2057 [label="Лабораторні тварини. Лабораторні тварини, Альбрехте! Ти кидав тварин у саму Порожнечу, а коли вони заверещали твоєю вигаданою «дитячою мовою», ти наказав дворецькому їх умертвити?!",shape=box,color=blue];
		2057 -> 2059;
	2056 [label="Ні.",shape=box,color=blue];
		2056 -> 2058;
	2059 [label="Завжди залишав інших робити свою брудну роботу. Але я відволікся. Ти питаєш мене, чому я з ними розмовляю. Особливо з птахом. Усе просто. Але я думаю, ти сам спробуєш здогадатися. Я хочу подивитися, чи зможеш розібратися.",shape=box,color=blue];
		2059 -> 2060;
		2059 -> 2061;
		2059 -> 2062;
		2059 -> 2063;
		2059 -> 2064;
	2058 [label="Chat ends.",color=orange];
	2060 [label="Він не знає, хто ти є.",shape=box,color=red];
		2060 -> 2065;
	2061 [label="Птах-3 любить усіх.",shape=box,color=red];
		2061 -> 2066;
	2062 [label="Ти любиш оточувати себе тими, хто змушує тебе почуватися розумним.",shape=box,color=red];
		2062 -> 2067;
	2063 [label="Він має проникливі спостереження щодо людей навколо.",shape=box,color=red];
		2063 -> 2068;
	2064 [label="Ним легко маніпулювати.",shape=box,color=red];
		2064 -> 2069;
	2065 [label="Так. У певному сенсі, саме тому. Він не знає, хто я. Він нічого не знає про «Диявола Тау». І йому… більше того, йому байдуже.",shape=box,color=blue];
		2065 -> 2070;
	2066 [label="Так. У своїй безглуздій невинності він навіть дещо чарівний. Але ти м’яко й непрямо зараз кажеш, що мене більше ніхто не здатен полюбити?",shape=box,color=blue];
		2066 -> 2071;
	2067 [label="Хотілося б, щоб у тебе було уявлення, наскільки ти помиляєшся. Як далеко твоя стріла пролетіла від істини… але не тільки ти маєш про мене таку думку.",shape=box,color=blue];
		2067 -> 2072;
	2068 [label="Саме так. І його спостереження подекуди корисні, але нічого такого, до чого я сам не дійшов би за кілька митей.",shape=box,color=blue];
		2068 -> 2073;
	2069 [label="Хотілося б, щоб у тебе було уявлення, наскільки ти помиляєшся. Як далеко твоя стріла пролетіла від істини… але не тільки ти маєш про мене таку думку.",shape=box,color=blue];
		2069 -> 2074;
	2070 [label="+10 Chemistry",color=orange];
		2070 -> 2075;
	2071 [label="Тож мені залишається покладатися на цього ідіотського птаха як на єдину компанію? Але ти достатньо близько до правди, тож поставлю тобі… задовільно.",shape=box,color=blue];
		2071 -> 2075;
	2072 [label="Не тільки ти.",shape=box,color=blue];
		2072 -> 2076;
	2073 [label="Ти зараз трохи м’якіше й завуальовано натякаєш, що я використовую цього великого балакучого птаха у власних цілях? Так ти думаєш?",shape=box,color=blue];
		2073 -> 2077;
	2074 [label="Не тільки ти.",shape=box,color=blue];
		2074 -> 2078;
	2075 [label="Для нього я Роут. Не орокін. Не злочинець. Не зрадник. Не боягуз. Просто… я.",shape=box,color=blue];
		2075 -> 2079;
	2076 [label="Update boolean RoatheAlone1",color=orange];
		2076 -> 2080;
	2077 [label="Це не так. Але не тільки ти маєш про мене таку думку. Не тільки ти.",shape=box,color=blue];
		2077 -> 2078;
	2078 [label="Update boolean RoatheAlone1",color=orange];
		2078 -> 2081;
	2079 [label="Не думаю, що зможу описати, яке це просто та рідкісне полегшення в спілкуванні…",shape=box,color=blue];
		2079 -> 2082;
		2079 -> 2083;
		2079 -> 2084;
	2080 [label="+5 Chemistry",color=orange];
		2080 -> 2085;
	2081 [label="+5 Chemistry",color=orange];
		2081 -> 2086;
	2082 [label="Знаєш, ти можеш усе відпустити. Можеш змінитися. Навіть тут, навіть зараз.",shape=box,color=red];
		2082 -> 2087;
	2083 [label="Це, мабуть, жахливий тягар — носити очікування своєї репутації скрізь, навіть тут.",shape=box,color=red];
		2083 -> 2088;
	2084 [label="Ти натякаєш, що все інше — це певна вистава, яку ти розігруєш?",shape=box,color=red];
		2084 -> 2089;
	2085 [label="Chat ends.",color=orange];
	2086 [label="Chat ends.",color=orange];
	2087 [label="Add 2 to Thermostat",color=orange];
		2087 -> 2090;
	2088 [label="Add -1 to Thermostat",color=orange];
		2088 -> 2091;
	2089 [label="Якби ж усе було так просто, і все це було лише великою маскою, яку можна змінити, мов маскарадний образ! Ні, узурпаторе. Це і є я — аж до кожної гнилої кістки.",shape=box,color=blue];
		2089 -> 2092;
	2090 [label="Якби все було так просто, узурпаторе. Ти подаєш це так спокусливо. Чи можу я? Можливо… Можливо, навіть для такого сумного, трагічного диявола ще не надто пізно.",shape=box,color=blue];
		2090 -> 2093;
	2091 [label="+10 Chemistry",color=orange];
		2091 -> 2094;
	2092 [label="Але це не означає, що я не ціную можливість відкласти все це на годину й просто насолодитися розмовою з тим, хто нічого не знає про всі ті жахливі злочини, що я колись скоїв.",shape=box,color=blue];
		2092 -> 2095;
	2093 [label="+10 Chemistry",color=orange];
		2093 -> 2096;
	2094 [label="Це виснажує, узурпаторе. І якби ж я міг скинути цю персону, мов маску з маскараду, і більше ніколи її не вдягати. Але це і є я — до кожної гнилої кістки.",shape=box,color=blue];
		2094 -> 2092;
	2095 [label="Update boolean RoatheBirdThree",color=orange];
		2095 -> 2097;
		2095 -> 2098;
	2096 [label="Чи не є це все лише великою маскою, яку я ношу? Чи воно вросло в мене аж до гнилих кісток? Я ще не знаю. Можу лише сказати: коли трапляється можливість відкласти все це бодай на годину — я все ще знаходжу в цьому втіху.",shape=box,color=blue];
		2096 -> 2099;
	2097 [label="Вибач, якщо це звучить грубо, але… твоє життя, схоже, було сповненим самотності.",shape=box,color=red];
		2097 -> 2100;
	2098 [label="Ти, мабуть, не звик мати багато друзів, так?",shape=box,color=red];
		2098 -> 2101;
	2099 [label="Я відкладаю цей тягар убік, сиджу з тим, хто й гадки не має про мої жахливі злочини, розмовляю з велетенським, чарівно безглуздим птахом — і раптом… відчуваю спокій. Уперше за дуже довгий час.",shape=box,color=blue];
		2099 -> 2102;
	2100 [label="Evaluate expressions",color=orange];
		2100 -> 2106 [label="RoatheUnloved1, RoatheKnowsReset2",color=purple];
