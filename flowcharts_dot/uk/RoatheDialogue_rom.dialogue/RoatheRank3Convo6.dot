		2118 -> 2121 [label="false",color=purple];
	2117 [label="Цікаво, це те, що я завдяки тобі не пам’ятаю, узурпаторе? Ми були коханцями, я зізнався у своїх почуттях, а в тобі не було взаємності?",shape=box,color=blue];
		2117 -> 2113;
	2116 [label="Які б погані думки в тебе не були про мене, я їх заслуговую. Але не тільки ти маєш про мене таку думку. Не тільки ти.",shape=box,color=blue];
		2116 -> 2120;
	2115 [label="Update boolean RoatheAlone1",color=orange];
		2115 -> 2116;
	2119 [label="Chat ends.",color=orange];
	2124 [label="Так трагічно, насправді… Мені потрібні подробиці, але я відчуваю, що це все одно, що ми перестрибуємо до кінця книги, перш ніж будемо готові.",shape=box,color=blue];
		2124 -> 2125;
	2123 [label="Але кого я обманюю?! Ми ж знаємо, чому ти це зробив, чи не так? І це було не з любові до мене. А з любові до іншого. Я просто поетизую.",shape=box,color=blue];
		2123 -> 2125;
	2122 [label="Але кого я обманюю?! Ми ж знаємо причини твоїх дій, чи не так? І це було не з любові до мене. Це навіть не було з любові взагалі. Я просто поетизую.",shape=box,color=blue];
		2122 -> 2125;
	2121 [label="Та, який сенс сидіти без діла та поетизувати?",shape=box,color=blue];
		2121 -> 2125;
	2120 [label="Chat ends.",color=orange];
	2125 [label="Але я тут не для того, щоб викликати твоє співчуття чи жалість. Це все моя заслуга. Які б погані думки в тебе не були про мене, я їх заслуговую. І не тільки ти маєш про мене таку думку. ",shape=box,color=blue];
