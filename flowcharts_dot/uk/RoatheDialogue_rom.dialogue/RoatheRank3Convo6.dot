		j3361283050 -> j3485793300 [label="RoatheLyonConfessionDealNo",color=purple];
		j3361283050 -> j3872531969 [label="false",color=purple];
	j2714736868 [label="Цікаво, це те, що я завдяки тобі не пам’ятаю, узурпаторе? Ми були коханцями, я зізнався у своїх почуттях, а в тобі не було взаємності?",shape=box,color=blue];
		j2714736868 -> j4093203444;
	j1398835381 [label="Які б погані думки в тебе не були про мене, я їх заслуговую. Але не тільки ти маєш про мене таку думку. Не тільки ти.",shape=box,color=blue];
		j1398835381 -> "Chat ends.";
	j477710538 [label="Так трагічно, насправді… Мені потрібні подробиці, але я відчуваю, що це все одно, що ми перестрибуємо до кінця книги, перш ніж будемо готові.",shape=box,color=blue];
		j477710538 -> j1933722444;
	j3455943806 [label="Але кого я обманюю?! Ми ж знаємо, чому ти це зробив, чи не так? І це було не з любові до мене. А з любові до іншого. Я просто поетизую.",shape=box,color=blue];
		j3455943806 -> j1933722444;
	j3485793300 [label="Але кого я обманюю?! Ми ж знаємо причини твоїх дій, чи не так? І це було не з любові до мене. Це навіть не було з любові взагалі. Я просто поетизую.",shape=box,color=blue];
		j3485793300 -> j1933722444;
	j3872531969 [label="Та, який сенс сидіти без діла та поетизувати?",shape=box,color=blue];
		j3872531969 -> j1933722444;
	j1933722444 [label="Але я тут не для того, щоб викликати твоє співчуття чи жалість. Це все моя заслуга. Які б погані думки в тебе не були про мене, я їх заслуговую. І не тільки ти маєш про мене таку думку. ",shape=box,color=blue];
		j1933722444 -> j2148257814;
