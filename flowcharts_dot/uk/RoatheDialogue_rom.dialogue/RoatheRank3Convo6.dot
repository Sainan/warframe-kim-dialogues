		2100 -> 2103 [label="false",color=purple];
	2101 [label="Check boolean RoatheKnowsReset2",color=orange];
		2101 -> 2108 [label=true,color=green];
		2101 -> 2107 [label=false,color=brown];
	2102 [label="Можливо, у твоїх словах справді є надія. А, може, я просто дурю себе. І це лише мить перепочинку.",shape=box,color=blue];
		2102 -> 2109;
	2106 [label="Так і було. Принаймні наскільки я пам’ятаю. Чи, може, завдяки тобі я не пам’ятаю, узурпаторе? Ми були коханцями, я зізнався у своїх почуттях, а в тобі не було взаємності?",shape=box,color=blue];
		2106 -> 2113;
	2105 [label="Визнаю, так і було. Принаймні наскільки я пам’ятаю. Чи буде для тебе шоком дізнатися, що я жодного разу не був закоханий? Принаймні не взаємно. Можливо, усе було не так. Ми, імовірно, вже проходили це з тобою раніше.",shape=box,color=blue];
		2105 -> 2112;
	2104 [label="Так і було. Сповнене безсмертя і самотності. Але це все моя заслуга, узурпаторе. Я тут не для того, щоб викликати твоє співчуття чи жалість.",shape=box,color=blue];
		2104 -> 2111;
	2103 [label="Визнаю, так і було. Принаймні наскільки я пам’ятаю. Чи буде для тебе шоком дізнатися, що я жодного разу не був закоханий? Але це все моя заслуга, узурпаторе. Я тут не для того, щоб викликати твоє співчуття чи жалість.",shape=box,color=blue];
		2103 -> 2110;
	2108 [label="Хто знає? Можливо, у мене й були друзі, просто я не можу їх пригадати, бо ми з тобою колись були друзями, а потім через тебе це припинилося?",shape=box,color=blue];
		2108 -> 2114;
	2107 [label="Хто знає? Можливо, у мене й були друзі, просто я не можу їх пригадати, бо Ентраті поліз мені в голову й забрав усі згадки про них.",shape=box,color=blue];
		2107 -> 2114;
	2109 [label="Update boolean RoatheBirdThree",color=orange];
		2109 -> 2097;
		2109 -> 2098;
	2113 [label="Чи все було навпаки? Ти любиш Диявола, але його серце залишається до тебе холодним. У розпачі ти робиш єдине, що спадає на думку — розірвати його розум на шматки!",shape=box,color=blue];
		2113 -> 2118;
	2112 [label="Update boolean RoatheUnloved1",color=orange];
		2112 -> 2117;
	2111 [label="Update boolean RoatheAlone1",color=orange];
		2111 -> 2116;
	2110 [label="Update boolean RoatheUnloved1",color=orange];
