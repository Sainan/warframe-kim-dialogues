digraph {
	graph [fontname="Roboto Condensed"];
	node [fontname="Roboto Condensed"];
	edge [fontname="Roboto Condensed"];

	"RoatheRank3Convo6 begins." [color=orange];
		"RoatheRank3Convo6 begins." -> j4287792734;
		"RoatheRank3Convo6 begins." -> j1077524644;
		"RoatheRank3Convo6 begins." -> j1478915251;
	j4287792734 [label="Роуте, чому ти стільки часу проводиш із кавіями?",shape=box,color=red];
		j4287792734 -> j682222595;
	j1077524644 [label="Не наближайся до кавій, Роуте. Я через це нервую.",shape=box,color=red];
		j1077524644 -> j3783026277;
	j1478915251 [label="[Завершити розмову]",shape=box,color=red];
		j1478915251 -> "Chat ends.";
	j682222595 [label="Гм? Ну, я вважаю їх одними з найсумніших і найжалюгідніших створінь, яких я коли-небудь зустрічав у всій проклятій Порожнечею Материнській системі. ",shape=box,color=blue];
		j682222595 -> j681912885;
	j3783026277 [label="Щоб уникнути якомога більше непорозумінь у цій ситуації, я уникну своєї звичайної багатослівності та просто скажу тобі: ",shape=box,color=blue];
		j3783026277 -> j2904868217;
	"Chat ends." [color=orange];
	j681912885 [label="Лабораторні тварини. Лабораторні тварини, Альбрехте! Ти кидав тварин у саму Порожнечу, а коли вони заверещали твоєю вигаданою «дитячою мовою», ти наказав дворецькому їх умертвити?!",shape=box,color=blue];
		j681912885 -> j3566024079;
	j2904868217 [label="Ні.",shape=box,color=blue];
		j2904868217 -> "Chat ends.";
	j3566024079 [label="Завжди залишав інших робити свою брудну роботу. Але я відволікся. Ти питаєш мене, чому я з ними розмовляю. Особливо з птахом. Усе просто. Але я думаю, ти сам спробуєш здогадатися. Я хочу подивитися, чи зможеш розібратися.",shape=box,color=blue];
		j3566024079 -> j3657059659;
		j3566024079 -> j2401876422;
		j3566024079 -> j995235514;
		j3566024079 -> j996374045;
		j3566024079 -> j2698687594;
	j3657059659 [label="Він не знає, хто ти є.",shape=box,color=red];
		j3657059659 -> j2864896226;
	j2401876422 [label="Птах-3 любить усіх.",shape=box,color=red];
		j2401876422 -> j3639196666;
	j995235514 [label="Ти любиш оточувати себе тими, хто змушує тебе почуватися розумним.",shape=box,color=red];
		j995235514 -> j2944504657;
	j996374045 [label="Він має проникливі спостереження щодо людей навколо.",shape=box,color=red];
		j996374045 -> j2953228963;
	j2698687594 [label="Ним легко маніпулювати.",shape=box,color=red];
		j2698687594 -> j2944504657;
	j2864896226 [label="Так. У певному сенсі, саме тому. Він не знає, хто я. Він нічого не знає про «Диявола Тау». І йому… більше того, йому байдуже.",shape=box,color=blue];
		j2864896226 -> j1174543660;
	j3639196666 [label="Так. У своїй безглуздій невинності він навіть дещо чарівний. Але ти м’яко й непрямо зараз кажеш, що мене більше ніхто не здатен полюбити?",shape=box,color=blue];
		j3639196666 -> j2584209174;
	j2944504657 [label="Хотілося б, щоб у тебе було уявлення, наскільки ти помиляєшся. Як далеко твоя стріла пролетіла від істини… але не тільки ти маєш про мене таку думку.",shape=box,color=blue];
		j2944504657 -> j3027726974;
	j2953228963 [label="Саме так. І його спостереження подекуди корисні, але нічого такого, до чого я сам не дійшов би за кілька митей.",shape=box,color=blue];
		j2953228963 -> j1176458371;
	j1174543660 [label="+10 Chemistry",color=orange];
		j1174543660 -> j2606606191;
	j2584209174 [label="Тож мені залишається покладатися на цього ідіотського птаха як на єдину компанію? Але ти достатньо близько до правди, тож поставлю тобі… задовільно.",shape=box,color=blue];
		j2584209174 -> j2606606191;
	j3027726974 [label="Не тільки ти.",shape=box,color=blue];
		j3027726974 -> j3705997063;
	j1176458371 [label="Ти зараз трохи м’якіше й завуальовано натякаєш, що я використовую цього великого балакучого птаха у власних цілях? Так ти думаєш?",shape=box,color=blue];
		j1176458371 -> j3273701329;
	j2606606191 [label="Для нього я Роут. Не орокін. Не злочинець. Не зрадник. Не боягуз. Просто… я.",shape=box,color=blue];
		j2606606191 -> j57008224;
	j3705997063 [label="Boolean RoatheAlone1 is now true.",color=orange];
		j3705997063 -> j4081414586;
	j3273701329 [label="Це не так. Але не тільки ти маєш про мене таку думку. Не тільки ти.",shape=box,color=blue];
		j3273701329 -> j3705997063;
	j57008224 [label="Не думаю, що зможу описати, яке це просто та рідкісне полегшення в спілкуванні…",shape=box,color=blue];
		j57008224 -> j714349508;
		j57008224 -> j343869542;
		j57008224 -> j1375919787;
	j4081414586 [label="+5 Chemistry",color=orange];
		j4081414586 -> "Chat ends.";
	j714349508 [label="Знаєш, ти можеш усе відпустити. Можеш змінитися. Навіть тут, навіть зараз.",shape=box,color=red];
		j714349508 -> j2671583512;
	j343869542 [label="Це, мабуть, жахливий тягар — носити очікування своєї репутації скрізь, навіть тут.",shape=box,color=red];
		j343869542 -> j2500465707;
	j1375919787 [label="Ти натякаєш, що все інше — це певна вистава, яку ти розігруєш?",shape=box,color=red];
		j1375919787 -> j2446898428;
	j2671583512 [label="Add 2 to Thermostat counter",color=orange];
		j2671583512 -> j2617584417;
	j2500465707 [label="Add -1 to Thermostat counter",color=orange];
		j2500465707 -> j3483907299;
	j2446898428 [label="Якби ж усе було так просто, і все це було лише великою маскою, яку можна змінити, мов маскарадний образ! Ні, узурпаторе. Це і є я — аж до кожної гнилої кістки.",shape=box,color=blue];
		j2446898428 -> j1157431268;
	j2617584417 [label="Якби все було так просто, узурпаторе. Ти подаєш це так спокусливо. Чи можу я? Можливо… Можливо, навіть для такого сумного, трагічного диявола ще не надто пізно.",shape=box,color=blue];
		j2617584417 -> j2183584325;
	j3483907299 [label="+10 Chemistry",color=orange];
		j3483907299 -> j2600451995;
	j1157431268 [label="Але це не означає, що я не ціную можливість відкласти все це на годину й просто насолодитися розмовою з тим, хто нічого не знає про всі ті жахливі злочини, що я колись скоїв.",shape=box,color=blue];
		j1157431268 -> j172570375;
	j2183584325 [label="+10 Chemistry",color=orange];
		j2183584325 -> j3126478387;
	j2600451995 [label="Це виснажує, узурпаторе. І якби ж я міг скинути цю персону, мов маску з маскараду, і більше ніколи її не вдягати. Але це і є я — до кожної гнилої кістки.",shape=box,color=blue];
		j2600451995 -> j1157431268;
	j172570375 [label="Boolean RoatheBirdThree is now true.",color=orange];
		j172570375 -> j2785681508;
		j172570375 -> j3879663342;
	j3126478387 [label="Чи не є це все лише великою маскою, яку я ношу? Чи воно вросло в мене аж до гнилих кісток? Я ще не знаю. Можу лише сказати: коли трапляється можливість відкласти все це бодай на годину — я все ще знаходжу в цьому втіху.",shape=box,color=blue];
		j3126478387 -> j3010350552;
	j2785681508 [label="Вибач, якщо це звучить грубо, але… твоє життя, схоже, було сповненим самотності.",shape=box,color=red];
		j2785681508 -> j2902082429;
	j3879663342 [label="Ти, мабуть, не звик мати багато друзів, так?",shape=box,color=red];
		j3879663342 -> j2539663690;
	j3010350552 [label="Я відкладаю цей тягар убік, сиджу з тим, хто й гадки не має про мої жахливі злочини, розмовляю з велетенським, чарівно безглуздим птахом — і раптом… відчуваю спокій. Уперше за дуже довгий час.",shape=box,color=blue];
		j3010350552 -> j3905929561;
	j2902082429 [label="Evaluate expressions",color=orange];
		j2902082429 -> j4256746386 [label="RoatheUnloved1, RoatheKnowsReset2",color=purple];
		j2902082429 -> j103749843 [label="RoatheKnowsReset2",color=purple];
		j2902082429 -> j1893180674 [label="RoatheUnloved1",color=purple];
		j2902082429 -> j2172378975 [label="false",color=purple];
	j2539663690 [label="Check boolean RoatheKnowsReset2",color=orange];
		j2539663690 -> j3136608064 [label=true,color=green];
		j2539663690 -> j1441941452 [label=false,color=brown];
	j3905929561 [label="Можливо, у твоїх словах справді є надія. А, може, я просто дурю себе. І це лише мить перепочинку.",shape=box,color=blue];
		j3905929561 -> j172570375;
	j4256746386 [label="Так і було. Принаймні наскільки я пам’ятаю. Чи, може, завдяки тобі я не пам’ятаю, узурпаторе? Ми були коханцями, я зізнався у своїх почуттях, а в тобі не було взаємності?",shape=box,color=blue];
		j4256746386 -> j4093203444;
	j103749843 [label="Визнаю, так і було. Принаймні наскільки я пам’ятаю. Чи буде для тебе шоком дізнатися, що я жодного разу не був закоханий? Принаймні не взаємно. Можливо, усе було не так. Ми, імовірно, вже проходили це з тобою раніше.",shape=box,color=blue];
		j103749843 -> j2256055962;
	j1893180674 [label="Так і було. Сповнене безсмертя і самотності. Але це все моя заслуга, узурпаторе. Я тут не для того, щоб викликати твоє співчуття чи жалість.",shape=box,color=blue];
		j1893180674 -> j2631859245;
	j2172378975 [label="Визнаю, так і було. Принаймні наскільки я пам’ятаю. Чи буде для тебе шоком дізнатися, що я жодного разу не був закоханий? Але це все моя заслуга, узурпаторе. Я тут не для того, щоб викликати твоє співчуття чи жалість.",shape=box,color=blue];
		j2172378975 -> j2046123872;
	j3136608064 [label="Хто знає? Можливо, у мене й були друзі, просто я не можу їх пригадати, бо ми з тобою колись були друзями, а потім через тебе це припинилося?",shape=box,color=blue];
		j3136608064 -> j3904834538;
	j1441941452 [label="Хто знає? Можливо, у мене й були друзі, просто я не можу їх пригадати, бо Ентраті поліз мені в голову й забрав усі згадки про них.",shape=box,color=blue];
		j1441941452 -> j3904834538;
	j4093203444 [label="Чи все було навпаки? Ти любиш Диявола, але його серце залишається до тебе холодним. У розпачі ти робиш єдине, що спадає на думку — розірвати його розум на шматки!",shape=box,color=blue];
		j4093203444 -> j3361283050;
	j2256055962 [label="Boolean RoatheUnloved1 is now true.",color=orange];
		j2256055962 -> j2714736868;
	j2631859245 [label="Boolean RoatheAlone1 is now true.",color=orange];
		j2631859245 -> j1398835381;
	j2046123872 [label="Boolean RoatheUnloved1 is now true.",color=orange];
		j2046123872 -> j2631859245;
	j3904834538 [label="Але багато користі мені це не принесло.",shape=box,color=blue];
		j3904834538 -> "Chat ends.";
	j3361283050 [label="Evaluate expressions",color=orange];
