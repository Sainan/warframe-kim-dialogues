	2267 [label="Chat ends.",color=orange];
	2269 [label="Витяг: Я без особливих зусиль досягнув успіхів у володінні більшістю нашої зброї. Але майстерно опанував одну — брехню.",shape=box,color=blue];
		2269 -> 5711;
	5711 [label="Найчастіше я спрямовував її проти власних солдатів. Я здирав із них шкіру брехнями про обов’язок і дисципліну.",shape=box,color=blue];
		5711 -> 5712;
	5712 [label="Я душив їх брехнею про те, що війну можна виграти. Я пронизував їх брехнею про свою прихильність, про найвищу пошану до них.",shape=box,color=blue];
		5712 -> 2265;
	2265 [label="А в тиші ж, на самоті, я спрямовував цю зброю на себе. О, як же я стікав кров’ю.",shape=box,color=blue];
