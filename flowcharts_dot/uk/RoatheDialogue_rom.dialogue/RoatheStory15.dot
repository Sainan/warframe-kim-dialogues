	j2506169435 [label="БРЕХНІ",shape=box,color=blue];
		j2506169435 -> j367091516;
	j367091516 [label="Витяг: Я без особливих зусиль досягнув успіхів у володінні більшістю нашої зброї. Але майстерно опанував одну — брехню.",shape=box,color=blue];
		j367091516 -> j1330984651;
	j1330984651 [label="Найчастіше я спрямовував її проти власних солдатів. Я здирав із них шкіру брехнями про обов’язок і дисципліну.",shape=box,color=blue];
		j1330984651 -> j2934473042;
	j2934473042 [label="Я душив їх брехнею про те, що війну можна виграти. Я пронизував їх брехнею про свою прихильність, про найвищу пошану до них.",shape=box,color=blue];
		j2934473042 -> j1435682813;
	j1435682813 [label="А в тиші ж, на самоті, я спрямовував цю зброю на себе. О, як же я стікав кров’ю.",shape=box,color=blue];
		j1435682813 -> j1648694156;
	j1648694156 [label="Add 1 to HellStory counter",color=orange];
		j1648694156 -> "Chat ends. Next chat will be RoatheStory16.";
	"Chat ends. Next chat will be RoatheStory16." [color=orange];
}