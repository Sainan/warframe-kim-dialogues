digraph {
	"RoatheRank4Convo5 begins." [color=orange];
		"RoatheRank4Convo5 begins." -> j3887264817;
	j3887264817 [label="Що ти пам’ятаєш зі своїх днів в Імперії, узурпаторе? Схоже, пам’ять уривчаста, у кращому випадку. Не те щоб я мав право судити, звісно.",shape=box,color=blue];
		j3887264817 -> j3218587077;
		j3887264817 -> j2380867829;
		j3887264817 -> j3332478435;
		j3887264817 -> j1478915251;
	j3218587077 [label="Достатньо, щоб знати, що ви всі заслуговували згоріти.",shape=box,color=red];
		j3218587077 -> j4029037232;
	j2380867829 [label="Лише шматки. А що?",shape=box,color=red];
		j2380867829 -> j4073944405;
	j3332478435 [label="Мені було небагато років, коли нас посадили на «Заримен». А після цього… ну…",shape=box,color=red];
		j3332478435 -> j4073944405;
	j1478915251 [label="[Завершити розмову]",shape=box,color=red];
		j1478915251 -> "Chat ends.";
	j4029037232 [label="Це цілком справедливо. Однак ти пропускаєш цілі пласти нашої історії та культурних записів. Я знаю, що після падіння любові до нас було мало, але…",shape=box,color=blue];
		j4029037232 -> j3022299875;
	j4073944405 [label="Гм. Мені просто дивно, що існує так мало повних записів про наше суспільство та культуру. Я знаю, що після падіння любові до нас було мало, але…",shape=box,color=blue];
		j4073944405 -> j3019823615;
	"Chat ends." [color=orange];
	j3022299875 [label="Хіба не лишилося жодної згадки про те, що сталося з кріозолеями?",shape=box,color=blue];
		j3022299875 -> j418202386;
		j3022299875 -> j4277918361;
	j3019823615 [label="Хіба не лишилося жодної згадки про те, що сталося з кріозолеями?",shape=box,color=blue];
		j3019823615 -> j3901094719;
		j3019823615 -> j2967979566;
	j418202386 [label="Це знову буде щось про жахливу форму орокінських тортур?",shape=box,color=red];
		j418202386 -> j2668404974;
	j4277918361 [label="Гадаю, таке слово точно не вислизнуло б із моєї пам’яті.",shape=box,color=red];
		j4277918361 -> j1177791509;
	j3901094719 [label="Кріо… що?",shape=box,color=red];
		j3901094719 -> j3686070777;
	j2967979566 [label="Гадаю, таке слово точно не вислизнуло б із моєї пам’яті.",shape=box,color=red];
		j2967979566 -> j3686070777;
	j2668404974 [label="Хочеш здивуватися? Ні. Можливо, це тому, що я провів останні… багацько років у пастці в крипті з цими двома фанатиками, але мене шокує, що за тисячоліття не збереглося жоднісінького запису про те, як орокіни поводилися зі своїми мертвими.",shape=box,color=blue];
		j2668404974 -> j4016836851;
		j2668404974 -> j72257591;
	j1177791509 [label="Можливо, це тому, що я провів останні… багацько років у пастці в крипті з цими двома фанатиками, але мене шокує, що за тисячоліття не збереглося жоднісінького запису про те, як орокіни поводилися зі своїми мертвими.",shape=box,color=blue];
		j1177791509 -> j3471921150;
		j1177791509 -> j2068154670;
	j3686070777 [label="Можливо, це тому, що я провів останні… багацько років у пастці в крипті з цими двома фанатиками, але мене шокує, що за тисячоліття не збереглося жоднісінького запису про те, як орокіни поводилися зі своїми мертвими.",shape=box,color=blue];
		j3686070777 -> j1473603488;
		j3686070777 -> j222683100;
	j4016836851 [label="А ви хіба помирали? Ви ж просто крали нові тіла в Юванському театрі.",shape=box,color=red];
		j4016836851 -> j707997595;
	j72257591 [label="Мені здавалося, ви викрадали людей, щоб вирішити цю проблему. Ви просто імітували смерть.",shape=box,color=red];
		j72257591 -> j2376219558;
	j3471921150 [label="А ви хіба помирали? Ви ж просто крали нові тіла в Юванському театрі.",shape=box,color=red];
		j3471921150 -> j707997595;
	j2068154670 [label="Продовжуй.",shape=box,color=red];
		j2068154670 -> j989898251;
	j1473603488 [label="А ви хіба помирали? Ви ж просто крали нові тіла в Юванському театрі.",shape=box,color=red];
		j1473603488 -> j1995524334;
	j222683100 [label="Продовжуй.",shape=box,color=red];
		j222683100 -> j1301531441;
	j707997595 [label="Так, а як щодо всіх інших, хто був «близько», але «недостатньо важливим»? Архімедівці? Чи орокіни нижчих рангів? Завжди були рівні над рівнями. Навіть якщо стелі були скляними, вони існували. Повір.",shape=box,color=blue];
		j707997595 -> j3368307494;
	j2376219558 [label="Справді. За кожної можливої нагоди. Але ж не всі мали такий привілей, чи не так? Як щодо тих, хто був «близько», але «недостатньо важливий»? Архімедівці? Орокіни нижчих рангів?",shape=box,color=blue];
		j2376219558 -> j3295172832;
	j989898251 [label="Врахуй тих, хто був «близько», але «недостатньо важливим»? Архімедівці. Чи орокіни нижчих рангів. Завжди були рівні над рівнями. Навіть якщо стелі були скляними, вони існували. Повір.",shape=box,color=blue];
		j989898251 -> j3368307494;
	j1995524334 [label="Так, а як щодо всіх інших, хто був «близько», але «недостатньо важливим»? Архімедівці? Чи орокіни нижчих рангів? Завжди були рівні над рівнями. Навіть якщо стелі були скляними, вони існували. Повір.",shape=box,color=blue];
		j1995524334 -> j2703500606;
	j1301531441 [label="Врахуй тих, хто був «близько», але «недостатньо важливим»? Архімедівці. Чи орокіни нижчих рангів. Завжди були рівні над рівнями. Навіть якщо стелі були скляними, вони існували. Повір.",shape=box,color=blue];
		j1301531441 -> j2703500606;
	j3368307494 [label="Не всім щастило отримати дар нової плоті щоразу, коли їхня стара форма згасала. Але я впевнений, що ти вважаєш «Юванський театр» огидною практикою, чи не так?",shape=box,color=blue];
		j3368307494 -> j2471402171;
		j3368307494 -> j2751614698;
	j3295172832 [label="Не всім щастило отримати дар нової плоті щоразу, коли їхня стара форма згасала. Звісно ж, ти вважаєш «Юванський театр» огидною практикою.",shape=box,color=blue];
		j3295172832 -> j1197033123;
		j3295172832 -> j2751614698;
	j2703500606 [label="Не всім щастило отримати дар нової плоті щоразу, коли їхня стара форма згасала. Але я впевнений, що ти вважаєш «Юванський театр» огидною практикою, чи не так?",shape=box,color=blue];
		j2703500606 -> j2948682656;
		j2703500606 -> j3746835370;
	j2471402171 [label="Я мало знаю про нього, щоб робити судження.",shape=box,color=red];
		j2471402171 -> j256074510;
	j2751614698 [label="Так. Я вважаю, що те, що ви всі робили, огидно. Все, що написано про Юванський театр, говорить, що ви викрадали дітей і знищували їхній розум.",shape=box,color=red];
		j2751614698 -> j2043439275;
	j1197033123 [label="А як інакше? Ви викрадали дітей із домівок, знищували їхній розум і замінювали своїм!",shape=box,color=red];
		j1197033123 -> j1392093943;
	j2948682656 [label="Я мало знаю про нього, щоб робити судження.",shape=box,color=red];
		j2948682656 -> j3014011877;
	j3746835370 [label="Так. Я вважаю, що те, що ви всі робили, огидно. Все, що написано про Юванський театр, говорить, що ви викрадали дітей і знищували їхній розум.",shape=box,color=red];
		j3746835370 -> j3106728397;
	j256074510 [label="+5 Chemistry",color=orange];
		j256074510 -> j2657058887;
	j2043439275 [label="«Все, що написано про Юванський театр, говорить»… А де все це записано? Що ще важливіше, хто все це написав?",shape=box,color=blue];
		j2043439275 -> j1386912927;
	j1392093943 [label="І звідки ти це знаєш? Тобі довелося бачити Юванський театр на власні очі?",shape=box,color=blue];
		j1392093943 -> j567321222;
		j1392093943 -> j2044204160;
		j1392093943 -> j4239658955;
	j3014011877 [label="+5 Chemistry",color=orange];
		j3014011877 -> j2657058887;
	j3106728397 [label="Однак ти кажеш, що залишилися лише уламки записів про нашу культуру та історію. А де все це записано? Що ще важливіше, хто все це написав?",shape=box,color=blue];
		j3106728397 -> j1386912927;
	j2657058887 [label="Утримуватися від суджень, доки не отримаєш усієї інформації? Боже мій, узурпаторе! Звучиш розумно! Яка рідкість!",shape=box,color=blue];
		j2657058887 -> j3621629948;
	j1386912927 [label="Це історії, розказані тими, хто має явний інтерес змалювати кожен аспект орокінів у якнайбільш катастрофічнішому й злішому світлі.",shape=box,color=blue];
		j1386912927 -> j3191843961;
	j567321222 [label="Ні.",shape=box,color=red];
		j567321222 -> j2953690869;
	j2044204160 [label="Так.",shape=box,color=red];
		j2044204160 -> j4018524994;
	j4239658955 [label="Це не має значення, чисті розрахунки.",shape=box,color=red];
		j4239658955 -> j2647404116;
	j3621629948 [label="Дозвольте мені, якщо можна, трохи змінити твій погляд на історію. Спробуй згадати, звідки походять розповіді про Юванський театр.",shape=box,color=blue];
		j3621629948 -> j1386912927;
	j3191843961 [label="Адже ті, хто руйнує всі опорні структури самого суспільства Материнської системи й кидає його у вир повного хаосу, мусять дати тим, хто залежить від цього суспільства, вагому причину для такого вчинку.",shape=box,color=blue];
		j3191843961 -> j168465357;
	j2953690869 [label="Тоді ти слухаєш історії з других вуст. Подумай, а де все це записано? Що ще важливіше, хто все це написав.",shape=box,color=blue];
		j2953690869 -> j1386912927;
	j4018524994 [label="Ха! Брешеш! ",shape=box,color=blue];
		j4018524994 -> j2656393385;
	j2647404116 [label="Справді? Подумай, а де все це записано? Що ще важливіше, хто все це написав.",shape=box,color=blue];
		j2647404116 -> j1386912927;
	j168465357 [label="Згадай життя пересічної людини на реле, узурпаторе. Тієї, що була далеко від випробувань і страждань тенно. Тієї, якій було байдуже до Великої війни.",shape=box,color=blue];
		j168465357 -> j4243282157;
	j2656393385 [label="Ти слухаєш історії з других вуст. Подумай, а де все це записано? Що ще важливіше, хто все це написав.",shape=box,color=blue];
		j2656393385 -> j1386912927;
	j4243282157 [label="Коли орокінська імперія впала, життя орокінів полетіло в чисте пекло внаслідок вакууму влади. Треба було вигадати пояснення. Треба було створити ідолів… і спалити їх. Нас треба було зробити чудовиськами в темряві.",shape=box,color=blue];
		j4243282157 -> j1743168589;
		j4243282157 -> j1956420525;
	j1743168589 [label="Хочеш сказати, що ви не викрадали дітей для Юванського театру проти їхньої волі?",shape=box,color=red];
		j1743168589 -> j737583592;
	j1956420525 [label="То що ж відбувалося в Юванському театрі?",shape=box,color=red];
		j1956420525 -> j1978887169;
	j737583592 [label="Ні, це цілковита правда.",shape=box,color=blue];
		j737583592 -> j2402167239;
	j1978887169 [label="+5 Chemistry",color=orange];
		j1978887169 -> j224895244;
	j2402167239 [label="Я лише хочу, щоб тобі спало на думку перевірити свої джерела, ось і все.",shape=box,color=blue];
		j2402167239 -> j891718054;
	j224895244 [label="Сказати, що ми не вибирали жертв проти їхньої волі, було б неправильно. Вибирали. Але це не вся правда. Ці речі рідко бувають такими простими й ніколи не бувають такими однозначними.",shape=box,color=blue];
		j224895244 -> j3983806784;
	j891718054 [label="Бо це не вся правда. Ці речі рідко бувають такими простими й ніколи не бувають такими однозначними. Світ сірий, узурпаторе. Межі не так легко провести. ",shape=box,color=blue];
		j891718054 -> j2741219607;
	j3983806784 [label="Світ сірий, узурпаторе. Межі не так легко провести.",shape=box,color=blue];
		j3983806784 -> j2741219607;
	j2741219607 [label="Усе починалося не в такому ганебному вигляді. Спершу це вважалося найвищою честю — віддати себе, щоб Імперія залишалася непорушною. Незламною. Щоб робота могла тривати.",shape=box,color=blue];
		j2741219607 -> j433207772;
	j433207772 [label="І почалося це не з молодняка. Почалося з тих, хто просто мав більше років, аби віддати. Але згодом ті, хто пропонував себе, ставали… дедалі молодшими й молодшими. Відданість — потужний наркотик.",shape=box,color=blue];
		j433207772 -> j3497939302;
	j3497939302 [label="Я бачив щось подібне серед тих, хто записувався на війну. Брехали про свій вік у документах, щоби «боротися за праве діло». Мало хто розумів, що вони закладають небезпечний прецедент для тих, хто згодом буде змушений піти проти своєї волі.",shape=box,color=blue];
		j3497939302 -> j1345674269;
	j1345674269 [label="Адже десь згодом якийсь Виконавець зрозумів, що це можна використати як… кару. Що певні міста чи… цілі планети можна тримати в покорі, якщо використати проти них загрозу застосування Юванського театру. Якщо збір жертв буде проведений особливо жорсткою рукою.",shape=box,color=blue];
		j1345674269 -> j718516388;
		j1345674269 -> j2626129986;
	j718516388 [label="А як ти сам ставишся до цього?",shape=box,color=red];
		j718516388 -> j2223649805;
	j2626129986 [label="Ти коли-небудь вибирав жертву проти волі?",shape=box,color=red];
		j2626129986 -> j3416614160;
	j2223649805 [label="+5 Chemistry",color=orange];
		j2223649805 -> j3676594069;
	j3416614160 [label="Я не брехатиму тобі. Так, вибирав. І ти можеш вважати мене чудовиськом за це скільки завгодно. Але коли все твоє суспільство побудоване на сотнях років нормалізації чогось, дуже важко відвернутися від цього.",shape=box,color=blue];
		j3416614160 -> j2308104566;
	j3676594069 [label="Гм. Маю змішані почуття. З одного боку, я сам багато разів брав участь в обряді. Я був би найвищим лицеміром, якби засуджував його. Коли все твоє суспільство побудоване на сотнях років нормалізації чогось, дуже важко відвернутися від цього.",shape=box,color=blue];
		j3676594069 -> j228333938;
	j2308104566 [label="Навіть коли в ретроспективі чи в момент прозріння це стає болісно очевидним. ",shape=box,color=blue];
		j2308104566 -> j779659875;
	j228333938 [label="З іншого боку, у вакуумі чи згодом, у ретроспективі, жах цього діяння стає цілком очевидним.",shape=box,color=blue];
		j228333938 -> j779659875;
	j779659875 [label="+5 Chemistry",color=orange];
		j779659875 -> j2556555045;
	j2556555045 [label="Ніхто не повинен жити вічно, узурпаторе. І театр є яскравим доказом цього.",shape=box,color=blue];
		j2556555045 -> "Chat ends.";
}