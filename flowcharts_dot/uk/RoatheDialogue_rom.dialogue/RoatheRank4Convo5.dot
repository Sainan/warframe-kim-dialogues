digraph {
	2664 [label="RoatheRank4Convo5 begins.",color=orange];
		2664 -> 2665;
	2665 [label="Що ти пам’ятаєш зі своїх днів в Імперії, узурпаторе? Схоже, пам’ять уривчаста, у кращому випадку. Не те щоб я мав право судити, звісно.",shape=box,color=blue];
		2665 -> 2668;
		2665 -> 2666;
		2665 -> 2667;
		2665 -> 2669;
	2668 [label="Достатньо, щоб знати, що ви всі заслуговували згоріти.",shape=box,color=red];
		2668 -> 2671;
	2666 [label="Лише шматки. А що?",shape=box,color=red];
		2666 -> 2670;
	2667 [label="Мені було небагато років, коли нас посадили на «Заримен». А після цього… ну…",shape=box,color=red];
		2667 -> 2670;
	2669 [label="[Завершити розмову]",shape=box,color=red];
		2669 -> 2672;
	2671 [label="Це цілком справедливо. Однак ти пропускаєш цілі пласти нашої історії та культурних записів. Я знаю, що після падіння любові до нас було мало, але…",shape=box,color=blue];
		2671 -> 2674;
	2670 [label="Гм. Мені просто дивно, що існує так мало повних записів про наше суспільство та культуру. Я знаю, що після падіння любові до нас було мало, але…",shape=box,color=blue];
		2670 -> 2673;
	2672 [label="Chat ends.",color=orange];
	2674 [label="Хіба не лишилося жодної згадки про те, що сталося з кріозолеями?",shape=box,color=blue];
		2674 -> 2677;
		2674 -> 2678;
	2673 [label="Хіба не лишилося жодної згадки про те, що сталося з кріозолеями?",shape=box,color=blue];
		2673 -> 2675;
		2673 -> 2676;
	2677 [label="Це знову буде щось про жахливу форму орокінських тортур?",shape=box,color=red];
		2677 -> 2680;
	2678 [label="Гадаю, таке слово точно не вислизнуло б із моєї пам’яті.",shape=box,color=red];
		2678 -> 2681;
	2675 [label="Кріо… що?",shape=box,color=red];
		2675 -> 2679;
	2676 [label="Гадаю, таке слово точно не вислизнуло б із моєї пам’яті.",shape=box,color=red];
		2676 -> 2679;
	2680 [label="Хочеш здивуватися? Ні. Можливо, це тому, що я провів останні… багацько років у пастці в крипті з цими двома фанатиками, але мене шокує, що за тисячоліття не збереглося жоднісінького запису про те, як орокіни поводилися зі своїми мертвими.",shape=box,color=blue];
		2680 -> 2684;
		2680 -> 2685;
	2681 [label="Можливо, це тому, що я провів останні… багацько років у пастці в крипті з цими двома фанатиками, але мене шокує, що за тисячоліття не збереглося жоднісінького запису про те, як орокіни поводилися зі своїми мертвими.",shape=box,color=blue];
		2681 -> 2686;
		2681 -> 2687;
	2679 [label="Можливо, це тому, що я провів останні… багацько років у пастці в крипті з цими двома фанатиками, але мене шокує, що за тисячоліття не збереглося жоднісінького запису про те, як орокіни поводилися зі своїми мертвими.",shape=box,color=blue];
		2679 -> 2682;
		2679 -> 2683;
	2684 [label="А ви хіба помирали? Ви ж просто крали нові тіла в Юванському театрі.",shape=box,color=red];
		2684 -> 2690;
	2685 [label="Мені здавалося, ви викрадали людей, щоб вирішити цю проблему. Ви просто імітували смерть.",shape=box,color=red];
		2685 -> 2691;
	2686 [label="А ви хіба помирали? Ви ж просто крали нові тіла в Юванському театрі.",shape=box,color=red];
		2686 -> 2692;
	2687 [label="Продовжуй.",shape=box,color=red];
		2687 -> 2693;
	2682 [label="А ви хіба помирали? Ви ж просто крали нові тіла в Юванському театрі.",shape=box,color=red];
		2682 -> 2688;
	2683 [label="Продовжуй.",shape=box,color=red];
		2683 -> 2689;
	2690 [label="Так, а як щодо всіх інших, хто був «близько», але «недостатньо важливим»? Архімедівці? Чи орокіни нижчих рангів? Завжди були рівні над рівнями. Навіть якщо стелі були скляними, вони існували. Повір.",shape=box,color=blue];
		2690 -> 2695;
	2691 [label="Справді. За кожної можливої нагоди. Але ж не всі мали такий привілей, чи не так? Як щодо тих, хто був «близько», але «недостатньо важливий»? Архімедівці? Орокіни нижчих рангів?",shape=box,color=blue];
		2691 -> 2696;
	2692 [label="Так, а як щодо всіх інших, хто був «близько», але «недостатньо важливим»? Архімедівці? Чи орокіни нижчих рангів? Завжди були рівні над рівнями. Навіть якщо стелі були скляними, вони існували. Повір.",shape=box,color=blue];
		2692 -> 2695;
	2693 [label="Врахуй тих, хто був «близько», але «недостатньо важливим»? Архімедівці. Чи орокіни нижчих рангів. Завжди були рівні над рівнями. Навіть якщо стелі були скляними, вони існували. Повір.",shape=box,color=blue];
		2693 -> 2695;
	2688 [label="Так, а як щодо всіх інших, хто був «близько», але «недостатньо важливим»? Архімедівці? Чи орокіни нижчих рангів? Завжди були рівні над рівнями. Навіть якщо стелі були скляними, вони існували. Повір.",shape=box,color=blue];
		2688 -> 2694;
	2689 [label="Врахуй тих, хто був «близько», але «недостатньо важливим»? Архімедівці. Чи орокіни нижчих рангів. Завжди були рівні над рівнями. Навіть якщо стелі були скляними, вони існували. Повір.",shape=box,color=blue];
		2689 -> 2694;
	2695 [label="Не всім щастило отримати дар нової плоті щоразу, коли їхня стара форма згасала. Але я впевнений, що ти вважаєш «Юванський театр» огидною практикою, чи не так?",shape=box,color=blue];
		2695 -> 2699;
		2695 -> 2700;
	2696 [label="Не всім щастило отримати дар нової плоті щоразу, коли їхня стара форма згасала. Звісно ж, ти вважаєш «Юванський театр» огидною практикою.",shape=box,color=blue];
		2696 -> 2701;
		2696 -> 2700;
	2694 [label="Не всім щастило отримати дар нової плоті щоразу, коли їхня стара форма згасала. Але я впевнений, що ти вважаєш «Юванський театр» огидною практикою, чи не так?",shape=box,color=blue];
		2694 -> 2697;
		2694 -> 2698;
	2699 [label="Я мало знаю про нього, щоб робити судження.",shape=box,color=red];
		2699 -> 2704;
	2700 [label="Так. Я вважаю, що те, що ви всі робили, огидно. Все, що написано про Юванський театр, говорить, що ви викрадали дітей і знищували їхній розум.",shape=box,color=red];
		2700 -> 2705;
	2701 [label="А як інакше? Ви викрадали дітей із домівок, знищували їхній розум і замінювали своїм!",shape=box,color=red];
		2701 -> 2706;
	2697 [label="Я мало знаю про нього, щоб робити судження.",shape=box,color=red];
		2697 -> 2702;
	2698 [label="Так. Я вважаю, що те, що ви всі робили, огидно. Все, що написано про Юванський театр, говорить, що ви викрадали дітей і знищували їхній розум.",shape=box,color=red];
		2698 -> 2703;
	2704 [label="+5 Chemistry",color=orange];
		2704 -> 2709;
	2705 [label="«Все, що написано про Юванський театр, говорить»… А де все це записано? Що ще важливіше, хто все це написав?",shape=box,color=blue];
		2705 -> 2708;
	2706 [label="І звідки ти це знаєш? Тобі довелося бачити Юванський театр на власні очі?",shape=box,color=blue];
		2706 -> 2710;
		2706 -> 2711;
		2706 -> 2712;
	2702 [label="+5 Chemistry",color=orange];
		2702 -> 2707;
	2703 [label="Однак ти кажеш, що залишилися лише уламки записів про нашу культуру та історію. А де все це записано? Що ще важливіше, хто все це написав?",shape=box,color=blue];
		2703 -> 2708;
	2709 [label="Утримуватися від суджень, доки не отримаєш усієї інформації? Боже мій, узурпаторе! Звучиш розумно! Яка рідкість!",shape=box,color=blue];
		2709 -> 2713;
	2708 [label="Це історії, розказані тими, хто має явний інтерес змалювати кожен аспект орокінів у якнайбільш катастрофічнішому й злішому світлі.",shape=box,color=blue];
		2708 -> 2714;
	2710 [label="Ні.",shape=box,color=red];
		2710 -> 2715;
	2711 [label="Так.",shape=box,color=red];
		2711 -> 2716;
	2712 [label="Це не має значення, чисті розрахунки.",shape=box,color=red];
		2712 -> 2717;
	2707 [label="Утримуватися від суджень, доки не отримаєш усієї інформації? Боже мій, узурпаторе! Звучиш розумно! Яка рідкість!",shape=box,color=blue];
		2707 -> 2713;
	2713 [label="Дозвольте мені, якщо можна, трохи змінити твій погляд на історію. Спробуй згадати, звідки походять розповіді про Юванський театр.",shape=box,color=blue];
		2713 -> 2708;
	2714 [label="Адже ті, хто руйнує всі опорні структури самого суспільства Материнської системи й кидає його у вир повного хаосу, мусять дати тим, хто залежить від цього суспільства, вагому причину для такого вчинку.",shape=box,color=blue];
		2714 -> 2718;
	2715 [label="Тоді ти слухаєш історії з других вуст. Подумай, а де все це записано? Що ще важливіше, хто все це написав.",shape=box,color=blue];
		2715 -> 2708;
	2716 [label="Ха! Брешеш! ",shape=box,color=blue];
		2716 -> 2719;
	2717 [label="Справді? Подумай, а де все це записано? Що ще важливіше, хто все це написав.",shape=box,color=blue];
		2717 -> 2708;
	2718 [label="Згадай життя пересічної людини на реле, узурпаторе. Тієї, що була далеко від випробувань і страждань тенно. Тієї, якій було байдуже до Великої війни.",shape=box,color=blue];
		2718 -> 2720;
	2719 [label="Ти слухаєш історії з других вуст. Подумай, а де все це записано? Що ще важливіше, хто все це написав.",shape=box,color=blue];
		2719 -> 2708;
	2720 [label="Коли орокінська імперія впала, життя орокінів полетіло в чисте пекло внаслідок вакууму влади. Треба було вигадати пояснення. Треба було створити ідолів… і спалити їх. Нас треба було зробити чудовиськами в темряві.",shape=box,color=blue];
		2720 -> 2721;
		2720 -> 2722;
	2721 [label="Хочеш сказати, що ви не викрадали дітей для Юванського театру проти їхньої волі?",shape=box,color=red];
		2721 -> 2723;
	2722 [label="То що ж відбувалося в Юванському театрі?",shape=box,color=red];
		2722 -> 2724;
	2723 [label="Ні, це цілковита правда.",shape=box,color=blue];
		2723 -> 2725;
	2724 [label="+5 Chemistry",color=orange];
		2724 -> 2726;
	2725 [label="Я лише хочу, щоб тобі спало на думку перевірити свої джерела, ось і все.",shape=box,color=blue];
		2725 -> 2727;
	2726 [label="Сказати, що ми не вибирали жертв проти їхньої волі, було б неправильно. Вибирали. Але це не вся правда. Ці речі рідко бувають такими простими й ніколи не бувають такими однозначними.",shape=box,color=blue];
		2726 -> 2728;
	2727 [label="Бо це не вся правда. Ці речі рідко бувають такими простими й ніколи не бувають такими однозначними. Світ сірий, узурпаторе. Межі не так легко провести. ",shape=box,color=blue];
		2727 -> 2729;
	2728 [label="Світ сірий, узурпаторе. Межі не так легко провести.",shape=box,color=blue];
		2728 -> 2729;
	2729 [label="Усе починалося не в такому ганебному вигляді. Спершу це вважалося найвищою честю — віддати себе, щоб Імперія залишалася непорушною. Незламною. Щоб робота могла тривати.",shape=box,color=blue];
		2729 -> 2730;
	2730 [label="І почалося це не з молодняка. Почалося з тих, хто просто мав більше років, аби віддати. Але згодом ті, хто пропонував себе, ставали… дедалі молодшими й молодшими. Відданість — потужний наркотик.",shape=box,color=blue];
		2730 -> 2731;
	2731 [label="Я бачив щось подібне серед тих, хто записувався на війну. Брехали про свій вік у документах, щоби «боротися за праве діло». Мало хто розумів, що вони закладають небезпечний прецедент для тих, хто згодом буде змушений піти проти своєї волі.",shape=box,color=blue];
		2731 -> 2732;
	2732 [label="Адже десь згодом якийсь Виконавець зрозумів, що це можна використати як… кару. Що певні міста чи… цілі планети можна тримати в покорі, якщо використати проти них загрозу застосування Юванського театру. Якщо збір жертв буде проведений особливо жорсткою рукою.",shape=box,color=blue];
		2732 -> 2733;
		2732 -> 2734;
	2733 [label="А як ти сам ставишся до цього?",shape=box,color=red];
		2733 -> 2735;
	2734 [label="Ти коли-небудь вибирав жертву проти волі?",shape=box,color=red];
		2734 -> 2736;
	2735 [label="+5 Chemistry",color=orange];
		2735 -> 2737;
	2736 [label="Я не брехатиму тобі. Так, вибирав. І ти можеш вважати мене чудовиськом за це скільки завгодно. Але коли все твоє суспільство побудоване на сотнях років нормалізації чогось, дуже важко відвернутися від цього.",shape=box,color=blue];
		2736 -> 2738;
	2737 [label="Гм. Маю змішані почуття. З одного боку, я сам багато разів брав участь в обряді. Я був би найвищим лицеміром, якби засуджував його. Коли все твоє суспільство побудоване на сотнях років нормалізації чогось, дуже важко відвернутися від цього.",shape=box,color=blue];
		2737 -> 2739;
	2738 [label="Навіть коли в ретроспективі чи в момент прозріння це стає болісно очевидним. ",shape=box,color=blue];
		2738 -> 2740;
	2739 [label="З іншого боку, у вакуумі чи згодом, у ретроспективі, жах цього діяння стає цілком очевидним.",shape=box,color=blue];
		2739 -> 2740;
	2740 [label="+5 Chemistry",color=orange];
		2740 -> 2741;
	2741 [label="Ніхто не повинен жити вічно, узурпаторе. І театр є яскравим доказом цього.",shape=box,color=blue];
		2741 -> 2742;
	2742 [label="Chat ends.",color=orange];
}