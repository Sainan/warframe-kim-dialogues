		j1776100240 -> j1292693306 [label="false",color=purple];
	j2512769062 [label="І не переймайся за те, що фанатики скиглитимуть мені на вухо, сподіваючись переконати мене виявити до тебе милосердя. Це не спрацює.",shape=box,color=blue];
		j2512769062 -> "Chat ends.";
	j596284828 [label="Це інший вид спогаду, Роуте. Мої сили на нього не подіють. Він закопаний глибоко у твоїй психіці.",shape=box,color=red];
		j596284828 -> j3780948219;
	j1132674522 [label="Якщо тікати та ховатися від правди, ми просто повернемося до того, з чого почали. ",shape=box,color=red];
		j1132674522 -> j558183398;
	j3630120005 [label="Ти впевнений? Але… ти розумний, і я маю відчуття, що ти якось розберешся, що не так.",shape=box,color=red];
		j3630120005 -> j1267635964;
