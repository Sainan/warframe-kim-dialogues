	j2544573053 [label="Або, можливо, потрібна нова методологія. Я тобі в цьому питанні не допомагатиму.",shape=box,color=blue];
		j2544573053 -> "Initiate conversation LyonRoatheFail in /Lotus/Types/Gameplay/1999Wf/Dialogue/LyonDialogue_rom.dialogue";
	j2287401963 [label="Гадаю, ти знаєш спосіб. Але якщо не пам’ятаєш, дозволь нагадати… як там я казав?",shape=box,color=blue];
		j2287401963 -> j2544356030;
	j3569182869 [label="Гаразд. Я… я зроблю це. Я зітру тобі розум. Навіть якщо це забере Марі та Ліона.",shape=box,color=red];
		j3569182869 -> j2622532229;
	j2375253210 [label="Ні. Я відмовляюся. Я знайду інший спосіб переконати тебе рухатися далі.",shape=box,color=red];
		j2375253210 -> j2930657989;
	j1734558753 [label="Ні, усе гаразд. Це не настільки важливо для мене.",shape=box,color=red];
		j1734558753 -> j792001622;
	j4160932145 [label="На жаль, ні Марі, ні Ліон до нас не приєднаються.",shape=box,color=red];
