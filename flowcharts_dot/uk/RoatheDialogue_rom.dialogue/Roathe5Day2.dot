		j3389899019 -> j2751431869 [label=false,color=brown];
	j4171752623 [label="Дуже добре. Ти маєш мою підтримку, коли вона буде потрібна. Але це потребуватиме часу. Дворецький — упертий дурень, тож наша задача вимагатиме скоординованої атаки.",shape=box,color=blue];
		j4171752623 -> j1492695917;
	j2291684636 [label="Дуже добре. Ти маєш мою підтримку, коли вона буде потрібна. Але нам треба обоє фанатиків, щоб разом ми змогли переконати дворецького піднятися нагору.",shape=box,color=blue];
		j2291684636 -> j3961842541;
	j1576555343 [label="Дуже добре. Ти маєш мою підтримку, коли вона буде потрібна. Але нам треба обоє фанатиків, щоб разом ми змогли переконати дворецького піднятися нагору.",shape=box,color=blue];
		j1576555343 -> j949176962;
	j2410448615 [label="Дуже добре. Ти маєш мою підтримку, коли вона буде потрібна. Але нам треба обоє фанатиків, щоб разом ми змогли переконати дворецького піднятися нагору.",shape=box,color=blue];
		j2410448615 -> j88518570;
	j2751431869 [label="Дуже добре. Я зроблю все в моїх силах, щоби прибрати твій безлад. Але я можу зробити не так багато. Розчищати шлях і виконувати роботу — різні речі.",shape=box,color=blue];
		j2751431869 -> "Initiate conversation LyonRoatheRepair in /Lotus/Types/Gameplay/1999Wf/Dialogue/LyonDialogue_rom.dialogue";
	j309841132 [label="Дуже добре. Ти маєш мою підтримку, коли вона буде потрібна. Але нам треба обоє фанатиків, щоб разом ми змогли переконати дворецького піднятися нагору.",shape=box,color=blue];
