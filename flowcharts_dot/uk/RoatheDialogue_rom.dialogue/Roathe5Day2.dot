		3843 -> 3852;
	3844 [label="Chat ends.",color=orange];
	3839 [label="Я просто стверджуватиму, що ти брешеш, і це, імовірно, непоправно зіпсує мою думку про тебе.",shape=box,color=blue];
		3839 -> 3849;
		3839 -> 3850;
	3855 [label="Chat ends.",color=orange];
	3856 [label="Щоразу, коли ми розмовляємо, я не можу не думати, чи знайомі тобі береги, якими ми ступаємо. Чи я просто повторююся, чи приховую якийсь новий сюрприз.",shape=box,color=blue];
		3856 -> 3863;
	3857 [label="Твою частину нашого контракту виконано. Тепер ми підійшли до передостаннього пункту, де нам потрібно узгодити деталі того, як ми плануватимемо наш метод атаки.",shape=box,color=blue];
