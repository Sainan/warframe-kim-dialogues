	j567952179 [label="Boolean RoatheWillReset is now true.",color=orange];
		j567952179 -> j2989953447;
	j3311757412 [label="Ти можеш попрощатися з нашою іншою угодою.",shape=box,color=blue];
		j3311757412 -> j1499501611;
		j3311757412 -> j509775242;
	j3774740944 [label="Мені хотілося б побачити, як він тремтить від жаху й сорому й повільно повзе вгору тими сходами.",shape=box,color=blue];
		j3774740944 -> j914801173;
		j3774740944 -> j3201684809;
	j1292693306 [label="Але яке тобі до цього діло?",shape=box,color=blue];
		j1292693306 -> j3052361957;
	j3780948219 [label="Можливо. Ти, мабуть, маєш рацію. Але ж я не маю інших варіантів, чи не так? Варто спробувати.",shape=box,color=blue];
		j3780948219 -> j2966836389;
	j558183398 [label="І якщо це так, ти можеш просто зробити це ще раз. Ці ж сили в тебе ніби невичерпні, чи не так?",shape=box,color=blue];
		j558183398 -> j2966836389;
	j1267635964 [label="Цілком імовірно. Я складу два й два докупи і звинувачу тебе в чомусь, що було зроблено без мого прохання. Упевнений, тобі вдасться пережити цю бурю.",shape=box,color=blue];
		j1267635964 -> j2966836389;
	j4084651901 [label="Угу. Так. Що ж. Я знаю, як тобі подобається цей мій «гострий хвіст». ",shape=box,color=blue];
		j4084651901 -> j2665556245;
	j2737465800 [label="Я просто хотів висловити вдячність. Не зациклюйся на цьому.",shape=box,color=blue];
		j2737465800 -> j4081414586;
	j817999035 [label="Так, із цим покінчено, тож тепер у нас є ще тема для обговорення, чи не так?",shape=box,color=blue];
		j817999035 -> j1466456391;
	j1311246052 [label="Check boolean RoatheDating",color=orange];
		j1311246052 -> j2097898931 [label=true,color=green];
