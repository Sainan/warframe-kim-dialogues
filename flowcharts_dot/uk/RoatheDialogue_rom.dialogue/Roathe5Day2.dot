		3785 -> 3799;
	3779 [label="Навіть якщо це означає, що ми назавжди застрягнемо в цьому глухому куті? Нещасний узурпаторе… що ж. Чистилище — це поліпшене пекло для диявола, чи не так?",shape=box,color=blue];
