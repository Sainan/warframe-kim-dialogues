	3853 [label="Update boolean RoatheDating",color=orange];
		3853 -> 3861;
	3854 [label="Якщо ти цього прагнеш, то це буде єдиний для тебе шлях. Якщо тобі байдуже, то й мені байдуже. Роби як знаєш.",shape=box,color=blue];
		3854 -> 3862;
	3851 [label="Я просто сказав, що ти отримаєш від цієї домовленості. Я ніколи не казав, що тобі потрібно зробити або чому, щоб це отримати. І отримав твою сліпу згоду.",shape=box,color=blue];
		3851 -> 3859;
	3852 [label="Мою першу умову «записати спогади» виконано, але другу, «допомогти узгодити спогади», із тріском провалено.",shape=box,color=blue];
		3852 -> 3860;
	3849 [label="Ні. Я не можу цього зробити. Я не зроблю цього. Ми повинні разом знайти рішення. Хіба ми не можемо просто поговорити про це?",shape=box,color=red];
