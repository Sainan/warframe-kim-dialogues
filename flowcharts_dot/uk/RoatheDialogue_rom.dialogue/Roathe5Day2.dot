		j2304643196 -> j4145097205 [label="RoatheFailStall",color=purple];
		j2304643196 -> j3855147051 [label="false",color=purple];
	j3532257367 [label="А ось ми тут, байдикуємо. Або тобі справді нема чим зайнятися, узурпаторе, або ти маєш від мене все, що хочеш. Що з цього?",shape=box,color=blue];
		j3532257367 -> j419812832;
		j3532257367 -> j3439563875;
		j3532257367 -> j2031489653;
	j617454213 [label="Evaluate expressions on HellStory counter",color=orange];
		j617454213 -> j3475699298 [label="x >= 21",color=purple];
		j617454213 -> "Chat ends." [label="x <= 21",color=purple];
		j617454213 -> "Chat ends." [label="false",color=purple];
	j1111457382 [label="Настає новий день, і я вперше за довгий час… планую майбутнє. Думаю про те, як я можу змінити цей світ навколо себе. Про те, як я можу використовувати те, що знаю. Ким я є. Як я можу краще це використовувати.",shape=box,color=blue];
		j1111457382 -> j3984658869;
	j1028550061 [label="Настає новий день, і я вперше за довгий час… планую майбутнє. Розмірковую про те, що це означає для мене, чого я хочу, як я хочу змінити своє оточення.",shape=box,color=blue];
		j1028550061 -> j2558396776;
	j1622110150 [label="Чи можу я спитати, що саме ти чекаєш? Я сиджу тут, мої спогади про всі події досі при мені. Я маю твоє слово, що ти зітреш їх.",shape=box,color=blue];
		j1622110150 -> j2544127092;
		j1622110150 -> j239310932;
		j1622110150 -> j2003993568;
	j4145097205 [label="Ну як, був час подумати? Я терплячий диявол, але всьому є межа. Ти зітреш мої спогади чи хочеш, щоб я лишився?",shape=box,color=blue];
		j4145097205 -> j4173512104;
		j4145097205 -> j2258769545;
	j3855147051 [label="І ось ми тут, і тут ми залишимося. У цьому чистилищі. Сподіваюся, тобі тут подобається, бо не думаю, що ми коли-небудь зробимо крок далі.",shape=box,color=blue];
		j3855147051 -> j2171950327;
	j419812832 [label="Ти про що?",shape=box,color=red];
		j419812832 -> j692243064;
	j3439563875 [label="Трохи того, трохи сього.",shape=box,color=red];
		j3439563875 -> j1430458441;
	j2031489653 [label="Тебе це не стосується й ніколи не стосувалося, Роуте.",shape=box,color=red];
		j2031489653 -> j1383826564;
	j3475699298 [label="Дурне! Що ти робиш?! Навіщо, навіщо заглиблюватися в печери, де тобі не раді?!",shape=box,color=blue];
		j3475699298 -> j3451237958;
	"Chat ends." [color=orange];
	j3984658869 [label="Check boolean RoatheDating",color=orange];
		j3984658869 -> j145363304 [label=true,color=green];
		j3984658869 -> j4293864655 [label=false,color=brown];
	j2558396776 [label="Check boolean RoatheDating",color=orange];
		j2558396776 -> j487001412 [label=true,color=green];
		j2558396776 -> j972481062 [label=false,color=brown];
	j2544127092 [label="Я знаю. Але такі речі вимагають часу, нам потрібно почекати.",shape=box,color=red];
		j2544127092 -> j924686494;
	j239310932 [label="Моя думка змінилася. Вибач.",shape=box,color=red];
		j239310932 -> j124458076;
	j2003993568 [label="Я зроблю це, як обіцяно.",shape=box,color=red];
		j2003993568 -> j972799876;
	j4173512104 [label="Ні. Я не можу. Вибач. Я не можу так вчинити із тобою.",shape=box,color=red];
		j4173512104 -> j1308837344;
	j2258769545 [label="Гаразд. Здаюся. Зроблю так, як ти хочеш.",shape=box,color=red];
		j2258769545 -> j354765019;
	j2171950327 [label="Check boolean LoidFamilyComplete",color=orange];
		j2171950327 -> j870545323 [label=true,color=green];
		j2171950327 -> j1338210844 [label=false,color=brown];
	j692243064 [label="Чого б тобі від мене не потрібно було, ти цього зараз не отримаєш. Тобі ліпше покінчити з цим і стерти мої спогади про цей наш фарс.",shape=box,color=blue];
		j692243064 -> j1348068537;
	j1430458441 [label="Ну, чого б тобі від мене не потрібно було, ти цього зараз не отримаєш. Тобі ліпше покінчити з цим і стерти мої спогади про цей наш фарс.",shape=box,color=blue];
		j1430458441 -> j1348068537;
	j1383826564 [label="Це доволі очевидно, не хвилюйся.",shape=box,color=blue];
		j1383826564 -> "Chat ends.";
	j3451237958 [label="Ти маєш це виправити, я вимагаю. Це твоя провина. Я відчуваю це, воно дряпає мене зсередини, розриває. Як якийсь звір.",shape=box,color=blue];
		j3451237958 -> j1080092162;
	j145363304 [label="Було б нетактовно не визнати, що це завдяки твоїй допомозі, любове. Дякую.",shape=box,color=blue];
		j145363304 -> j4155818835;
		j145363304 -> j3759743706;
	j4293864655 [label="Було б нетактовно не визнати, що це завдяки твоїй допомозі, узурпаторе. Дякую.",shape=box,color=blue];
		j4293864655 -> j2529714310;
		j4293864655 -> j415933611;
	j487001412 [label="Було б нетактовно не визнати, що це значною мірою завдяки твоїй допомозі, любове.",shape=box,color=blue];
		j487001412 -> j349967970;
		j487001412 -> j1083968874;
	j972481062 [label="Було б нетактовно не визнати, що це значною мірою завдяки твоїй допомозі, узурпаторе.",shape=box,color=blue];
		j972481062 -> j1376102816;
		j972481062 -> j3199201395;
	j924686494 [label="М-м. Гаразд. Я терплячий диявол, але вода з цього колодязя може вичерпатися.",shape=box,color=blue];
		j924686494 -> "Chat ends.";
	j124458076 [label="Зрозуміло. Ось так от просто, так?",shape=box,color=blue];
		j124458076 -> j431793363;
	j972799876 [label="М-м. Роби як знаєш. Я терплячий диявол, але вода з цього колодязя може вичерпатися.",shape=box,color=blue];
		j972799876 -> "Chat ends.";
	j1308837344 [label="Навіть якщо це означає, що ми назавжди застрягнемо в цьому глухому куті? Нещасний узурпаторе… що ж. Чистилище — це поліпшене пекло для диявола, чи не так?",shape=box,color=blue];
		j1308837344 -> j1255868819;
	j354765019 [label="Добре. Берися за справу. Мені набридло жити з цим знанням у голові.",shape=box,color=blue];
		j354765019 -> j378811769;
	j870545323 [label="Хоча, яке тобі до того діло? У тебе є все, що ти забажаєш вирізати з мого порожнього трупа. Мої ребра відділені та вибілені.",shape=box,color=blue];
		j870545323 -> j1776100240;
	j1338210844 [label="Трагічно, чи не так? Знати, що покидьки родини Ентраті ніколи не дізнаються, що дворецький гниє тут, унизу, заламуючи руки від горя? Геть один?",shape=box,color=blue];
		j1338210844 -> j1776100240;
	j1348068537 [label="Якщо ти цього прагнеш, то це буде єдиний для тебе шлях. Якщо тобі байдуже, то й мені байдуже. Роби як знаєш.",shape=box,color=blue];
		j1348068537 -> j2512769062;
	j1080092162 [label="Позбав мене від цього. Позбав мене від цієї чуми. Очисти мій розум від цих спогадів. Я знаю, що ти можеш. Використай свої сили й поклади всьому край. Негайно.",shape=box,color=blue];
		j1080092162 -> j596284828;
		j1080092162 -> j1132674522;
		j1080092162 -> j3630120005;
	j4155818835 [label="Просто неможливо залишити тебе вічно ганятися за своїм гострим хвостом.",shape=box,color=red];
		j4155818835 -> j4235883946;
	j3759743706 [label="Завжди будь ласка.",shape=box,color=red];
		j3759743706 -> j2665556245;
	j2529714310 [label="Просто неможливо залишити тебе вічно ганятися за своїм гострим хвостом. Це було б сумно.",shape=box,color=red];
		j2529714310 -> j3466418875;
	j415933611 [label="Завжди будь ласка.",shape=box,color=red];
		j415933611 -> j578416406;
	j349967970 [label="Значною мірою? Якби не я, ти б досі ганявся за своїм гострим хвостом, Роуте.",shape=box,color=red];
		j349967970 -> j3930116407;
