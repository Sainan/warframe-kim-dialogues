	3763 [label="Настає новий день, і я вперше за довгий час… планую майбутнє. Думаю про те, як я можу змінити цей світ навколо себе. Про те, як я можу використовувати те, що знаю. Ким я є. Як я можу краще це використовувати.",shape=box,color=blue];
		3763 -> 3775;
	3762 [label="Настає новий день, і я вперше за довгий час… планую майбутнє. Розмірковую про те, що це означає для мене, чого я хочу, як я хочу змінити своє оточення.",shape=box,color=blue];
		3762 -> 3774;
	3761 [label="Чи можу я спитати, що саме ти чекаєш? Я сиджу тут, мої спогади про всі події досі при мені. Я маю твоє слово, що ти зітреш їх.",shape=box,color=blue];
		3761 -> 3771;
		3761 -> 3772;
		3761 -> 3773;
	3759 [label="Ну як, був час подумати? Я терплячий диявол, але всьому є межа. Ти зітреш мої спогади чи хочеш, щоб я лишився?",shape=box,color=blue];
		3759 -> 3768;
		3759 -> 3769;
	3760 [label="І ось ми тут, і тут ми залишимося. У цьому чистилищі. Сподіваюся, тобі тут подобається, бо не думаю, що ми коли-небудь зробимо крок далі.",shape=box,color=blue];
		3760 -> 3770;
	3756 [label="Ти про що?",shape=box,color=red];
		3756 -> 3765;
	3757 [label="Трохи того, трохи сього.",shape=box,color=red];
		3757 -> 3766;
	3758 [label="Тебе це не стосується й ніколи не стосувалося, Роуте.",shape=box,color=red];
		3758 -> 3767;
	3755 [label="Дурне! Що ти робиш?! Навіщо, навіщо заглиблюватися в печери, де тобі не раді?!",shape=box,color=blue];
		3755 -> 3764;
