	j4072107213 [label="Add 1 to Promise counter",color=orange];
		j4072107213 -> j302033967;
	j881369630 [label="Мені лишається тільки розвести руками та піти геть, щоб не вирвати на собі волосся від розпачу.",shape=box,color=blue];
		j881369630 -> j92161912;
	j2963434236 [label="Що ж. Не думай, що я забув про нашу домовленість. Я обіцяв прибрати цей безлад, і я це зроблю. Тобі це дійсно потрібно.",shape=box,color=blue];
		j2963434236 -> j2814091550;
	j1492695917 [label="Молодець, що вдалося заручитися підтримкою фанатиків. Марі й Ліон будуть безцінними, хоч мені й не хочеться цього визнавати.",shape=box,color=blue];
		j1492695917 -> j1220460085;
	j3961842541 [label="Він упертий дурень, і для цього знадобиться скоординована атака. Рекомендую діяти обережно та робити все можливе, щоб забезпечити підтримку обох фанатиків, коли настане час. ",shape=box,color=blue];
