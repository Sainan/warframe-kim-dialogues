		"Initiate conversation LyonRoatheFail in /Lotus/Types/Gameplay/1999Wf/Dialogue/LyonDialogue_rom.dialogue" -> "Chat ends.";
	j2989953447 [label="Boolean RoatheFailStall is now false.",color=orange];
		j2989953447 -> "Chat ends.";
	j1499501611 [label="Як типово.",shape=box,color=red];
		j1499501611 -> j2597340972;
	j509775242 [label="Стривай. Чому?!",shape=box,color=red];
		j509775242 -> j841351595;
	j914801173 [label="Ти сказав, що допоможеш, якщо я допоможу тобі відновити спогади. Моя частина угоди виконана. Це була наша угода!",shape=box,color=red];
		j914801173 -> j1041326368;
	j3201684809 [label="Стривай. Чому ти мені не допоможеш?",shape=box,color=red];
		j3201684809 -> j1041326368;
	j3052361957 [label="Ніякого.",shape=box,color=blue];
		j3052361957 -> "Chat ends.";
	j2966836389 [label="Звісно, я певен, що страшенно розгніваюся на тебе, щойно зрозумію, що мої спогади змінено. І, любове, раджу не казати мені, що це сталося на моє прохання.",shape=box,color=blue];
		j2966836389 -> j1060134117;
	j4081414586 [label="+5 Chemistry",color=orange];
		j4081414586 -> "Chat ends.";
	j1466456391 [label="Check boolean RoatheKnowsReset2",color=orange];
		j1466456391 -> j2737261956 [label=true,color=green];
		j1466456391 -> j3776383855 [label=false,color=brown];
	j2097898931 [label="Boolean IsDating is now false.",color=orange];
		j2097898931 -> j2364428169;
	j2597340972 [label="Не треба злитися через те, що тебе переграли. Я запропонував тобі умови контракту, так і не пояснивши, чого я хочу. Але це треба було помітити раніше.",shape=box,color=blue];
		j2597340972 -> j4040440400;
	j841351595 [label="Я запропонував тобі умови контракту, так і не пояснивши, чого я хочу. Але це треба було помітити раніше.",shape=box,color=blue];
		j841351595 -> j4040440400;
	j1041326368 [label="«Мені потрібен хтось, хто допоможе записати мої спогади й узгодити їх. Свого роду вакансія тимчасової допомоги.»",shape=box,color=blue];
		j1041326368 -> j1803532454;
	j1060134117 [label="Я просто стверджуватиму, що ти брешеш, і це, імовірно, непоправно зіпсує мою думку про тебе.",shape=box,color=blue];
		j1060134117 -> j657511867;
		j1060134117 -> j2635705992;
	j2737261956 [label="Щоразу, коли ми розмовляємо, я не можу не думати, чи знайомі тобі береги, якими ми ступаємо. Чи я просто повторююся, чи приховую якийсь новий сюрприз.",shape=box,color=blue];
		j2737261956 -> j992735753;
	j3776383855 [label="Твою частину нашого контракту виконано. Тепер ми підійшли до передостаннього пункту, де нам потрібно узгодити деталі того, як ми плануватимемо наш метод атаки.",shape=box,color=blue];
		j3776383855 -> j3913312750;
	j2364428169 [label="Boolean RoatheDating is now false.",color=orange];
		j2364428169 -> j1772140366;
	j4040440400 [label="Я просто сказав, що ти отримаєш від цієї домовленості. Я ніколи не казав, що тобі потрібно зробити або чому, щоб це отримати. І отримав твою сліпу згоду.",shape=box,color=blue];
		j4040440400 -> j2693997507;
	j1803532454 [label="Мою першу умову «записати спогади» виконано, але другу, «допомогти узгодити спогади», із тріском провалено.",shape=box,color=blue];
		j1803532454 -> j1574698348;
	j657511867 [label="Ні. Я не можу цього зробити. Я не зроблю цього. Ми повинні разом знайти рішення. Хіба ми не можемо просто поговорити про це?",shape=box,color=red];
		j657511867 -> j4059398996;
	j2635705992 [label="Я… дійсно немає іншого шляху?",shape=box,color=red];
		j2635705992 -> j4059398996;
	j992735753 [label="У будь-якому разі, я б волів не чути це від тебе. Ненавиджу, коли я надто передбачуваний. У будь-якому разі, я отримав від тебе допомогу там, де було вкрай важливо для мене. ",shape=box,color=blue];
		j992735753 -> j574277590;
	j3913312750 [label="Ця битва має вестися на трьох фронтах. Усі повинні працювати злагоджено, щоб виграти цю війну.",shape=box,color=blue];
		j3913312750 -> j2055199196;
		j3913312750 -> j4156621984;
	j1772140366 [label="Ну, чого б тобі від мене не потрібно було, ти цього зараз не отримаєш. Тобі ліпше покінчити з цим і стерти мої спогади про цей наш фарс. «Любове».",shape=box,color=blue];
		j1772140366 -> j1348068537;
	j2693997507 [label="Це, здається, у старовинних висловах називалося «порожнім чеком»? І твій підпис на ньому цілком добровільний.",shape=box,color=blue];
		j2693997507 -> j3420777359;
		j2693997507 -> j2390343170;
	j1574698348 [label="Я не можу сказати, що вони узгоджені, чи не так?",shape=box,color=blue];
		j1574698348 -> j1132843285;
	j4059398996 [label="Ні. Якщо хочеш, щоб дворецький піднявся нагору, витри з мене всю цю нісенітницю, як я просив. Якщо тобі байдуже, роби як знаєш. Мені байдуже.",shape=box,color=blue];
		j4059398996 -> j3603090929;
	j574277590 [label="Минулої ночі я спав краще, ніж будь-коли за дуже довгий час. Я міг би сказати «довше, ніж пам’ятаю», але це був би поганий жарт.",shape=box,color=blue];
		j574277590 -> j3041292153;
	j2055199196 [label="Перепрошую?",shape=box,color=red];
		j2055199196 -> j770989071;
	j4156621984 [label="Ми про Лойда говоримо?",shape=box,color=red];
		j4156621984 -> j1635394718;
	j3420777359 [label="Чи можу я якось змінити твою думку?",shape=box,color=red];
		j3420777359 -> j41335682;
	j2390343170 [label="Як мені з цього всього вибратися?",shape=box,color=red];
		j2390343170 -> j2600106868;
	j1132843285 [label="Твоя частина угоди не виконана, тож я не виконаю свою.",shape=box,color=blue];
		j1132843285 -> j3420777359;
		j1132843285 -> j4092458166;
	j3603090929 [label="Це, і, звісно ж, наша особиста дружба — єдиний важіль впливу, який я маю в цій ситуації. Це так просто.",shape=box,color=blue];
		j3603090929 -> j3870010114;
	j3041292153 [label="Тож тепер я допоможу тобі. Дворецький. Ти й досі бажаєш возз’єднати його з родиною Альбрехта нагорі?",shape=box,color=blue];
		j3041292153 -> j744968765;
	j770989071 [label="Дворецький. Ти й досі бажаєш возз’єднати його з родиною Альбрехта нагорі?",shape=box,color=blue];
		j770989071 -> j1949841813;
	j1635394718 [label="Так. Намагайся не відставати. Ти й досі бажаєш возз’єднати дворецького з родиною Альбрехта нагорі?",shape=box,color=blue];
		j1635394718 -> j1949841813;
	j41335682 [label="Ні. І я більше не маю настрою допомагати тобі в цьому питанні.",shape=box,color=blue];
		j41335682 -> "Initiate conversation LyonRoatheFail in /Lotus/Types/Gameplay/1999Wf/Dialogue/LyonDialogue_rom.dialogue";
	j2600106868 [label="Так само, як тобі вдалося спочатку в це загрузнути.",shape=box,color=blue];
		j2600106868 -> j2544573053;
	j4092458166 [label="Як мені з цього всього вибратися?",shape=box,color=red];
		j4092458166 -> j2287401963;
	j3870010114 [label="Що скажеш ти?",shape=box,color=blue];
