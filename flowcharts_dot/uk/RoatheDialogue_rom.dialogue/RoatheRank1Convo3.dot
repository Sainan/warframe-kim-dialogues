		212 -> 218 [label=false,color=brown];
	209 [label="Chat ends.",color=orange];
	210 [label="Тоді навіщо ставити питання, на які вже знаєш відповідь?",shape=box,color=blue];
		210 -> 201;
		210 -> 202;
	213 [label="У мене є певний досвід у цьому, віриш ти чи ні.",shape=box,color=red];
		213 -> 219;
	214 [label="Насправді можу. Прошу, продовжуй.",shape=box,color=red];
		214 -> 220;
	215 [label="А ось тут уже цікаво… у тебе «не вийшло» зі мною чи «не вийшло» з Ліоном чи Марі?",shape=box,color=blue];
		215 -> 221;
		215 -> 222;
		215 -> 223;
	217 [label="Ну, розумієш, у тебе є всі… спогади, чому ти прийняв сироватку, але… від мене ти почув багато неправильного в неправильний час.",shape=box,color=red];
		217 -> 225;
	218 [label="Я… намагаюся завоювати серце одного з вас, але мені… не вдалося…",shape=box,color=red];
		218 -> 226;
	216 [label="Я намагаюся переконати тебе та інших допомогти мені возз’єднати Лойда з родиною на горі, але… мені… не вдалося…",shape=box,color=red];
		216 -> 224;
	219 [label="У тебе є досвід вічного вмирання, наскільки я чув. Що набагато цікавіше. І все ж зрештою тобі вдалося знайти причини втратити чутливість до всього цього.",shape=box,color=blue];
		219 -> 220;
	220 [label="Таким чином, я звик — насправді цілком звик — до махінацій та підступів, які ми, орокіни, розігруємо одне з одним для розваги. Це просто те, як ми проводимо час.",shape=box,color=blue];
		220 -> 227;
	221 [label="З Ліоном…",shape=box,color=red];
		221 -> 228;
	222 [label="З Марі…",shape=box,color=red];
		222 -> 229;
	223 [label="З тобою…",shape=box,color=red];
		223 -> 230;
	225 [label="+5 Chemistry",color=orange];
		225 -> 232;
	226 [label="+5 Chemistry",color=orange];
		226 -> 233;
	224 [label="Гм. Зрозуміло. У нас була домовленість, але через твоє недотримання своєї частини угоди твоя винагорода зникла.",shape=box,color=blue];
		224 -> 231;
	227 [label="Але є межі, які ми не перетинаємо. Вчинки, яких ми не робимо. Я міг би вдатися в подробиці, але не буду. Підсумую просто констатувавши, що Альбрехт їх усі порушив.",shape=box,color=blue];
		227 -> 234;
	228 [label="Справді? Можливо, просто годувати та поїти його раз на день і подивитися, чи це спрацює? Що ж…",shape=box,color=blue];
		228 -> 235;
	229 [label="І тобі не вдалося переконати цю маленьку краплину чистоти піти за тобою? Я… сподіваюся, ти не будеш займатися діяльністю, пов’язаною з переговорами, мій давній друзяко.",shape=box,color=blue];
		229 -> 236;
	230 [label="+5 Chemistry",color=orange];
		230 -> 237;
	232 [label="Гм.",shape=box,color=blue];
		232 -> 239;
	233 [label="ХА! Це феноменально! Моя увага прикута до тебе… хто з нас? Га? Розкажи… не соромся. Можливо, ми зможемо… домовитися.",shape=box,color=blue];
		233 -> 240;
		233 -> 241;
		233 -> 242;
	231 [label="Я сиджу тут, і дві речі відразу ж вражають мене після підтвердження моїх підозр:",shape=box,color=blue];
		231 -> 238;
	234 [label="Він покинув мене там, у якомусь жахливо стародавньому році, в гнилій дірі на дупі Материнської системи! Ти знаєш, що в забутому Порожнечею «соборі» навіть не було електрики?! Електрики!",shape=box,color=blue];
		234 -> 243;
	235 [label="Що саме з ним викликало у тебе такі проблеми? Можливо, ми могли б домовитися?",shape=box,color=blue];
		235 -> 244;
	236 [label="Але скажи мені, що саме з нею викликало у тебе такі проблеми? Можливо, ми могли б… домовитися?",shape=box,color=blue];
		236 -> 245;
	237 [label="ХА! Це феноменально! Моя увага прикута до тебе… яким чином? Га? Розкажи… не соромся. Можливо, ми зможемо… домовитися.",shape=box,color=blue];
		237 -> 246;
	239 [label="Я сиджу тут, і дві речі відразу ж вражають мене після підтвердження моїх підозр:",shape=box,color=blue];
