		j1052337360 -> j1694384347;
	j3710830256 [label="Boolean DrifterMarie is now true.",color=orange];
		j3710830256 -> j1506681978;
	j1584052071 [label="Boolean DrifterRoathe is now true.",color=orange];
		j1584052071 -> j3155899388;
	j942677752 [label="Скільки розумів я б спотворив, якби мав у своєму розпорядженні твої дари?",shape=box,color=blue];
		j942677752 -> j3415574846;
	j1976383329 [label="Тож… Зажди. Ти мене заплутав. Як і коли Ентраті перетворив тебе на протофрейма?",shape=box,color=red];
		j1976383329 -> j688589511;
	j2519297052 [label="Ти. Зажди. Зробив що?!",shape=box,color=red];
		j2519297052 -> j2646111040;
	j2036427138 [label="У нього… стільки проблем. І я не знаю, як з цим усім упоратися.",shape=box,color=red];
		j2036427138 -> j2231796909;
	j3088246221 [label="Я маю почуття до нього…",shape=box,color=red];
		j3088246221 -> j1052337360;
	j3328423560 [label="Вона не бачить Ентраті таким, яким він є насправді. І я ніяк не можу змусити її побачити правду.",shape=box,color=red];
		j3328423560 -> j1872192124;
	j3458221789 [label="Я маю почуття до неї…",shape=box,color=red];
		j3458221789 -> j3710830256;
	j891449781 [label="Ну, розумієш, у тебе є всі спогади, чому ти прийняв сироватку, але… через мене все сплуталося…",shape=box,color=red];
		j891449781 -> j2390205533;
	j1833936666 [label="[Зізнатися в почуттях] Мені… справді ніяково, але я…",shape=box,color=red];
		j1833936666 -> j1584052071;
	j3215302619 [label="Скільки розумів я б спотворив, якби мав у своєму розпорядженні твої дари?",shape=box,color=blue];
		j3215302619 -> j3441631980;
	j1694384347 [label="+5 Chemistry",color=orange];
		j1694384347 -> j1272047109;
	j1506681978 [label="+5 Chemistry",color=orange];
		j1506681978 -> j992336856;
	j3155899388 [label="+5 Chemistry",color=orange];
		j3155899388 -> j2407386575;
	j3415574846 [label="З іншого боку, я вражений миттєвою люттю та гнівом від усвідомлення, що моїм розумом зневажали не один, а два рази за останній час. Але є ще одне почуття, яке перемагає гнів. Одне, яке я не зовсім розумію.",shape=box,color=blue];
		j3415574846 -> j2503964649;
	j688589511 [label="Я не знаю подробиць, оскільки ці спогади відсутні в моїй голові разом із багатьма іншими через перетворення, до якого він мене спонукав.",shape=box,color=blue];
		j688589511 -> j2719899936;
	j2646111040 [label="Так! Саме так! Зі зразків своєї власної крові! Я не розпочинав процес у тому ж році, який ми залишили, я тобі скажу! Присягаюся Порожнечею, я здеру з нього шкіру своїми новими кігтями, щойно побачу його дурне, самовдоволене обличчя…",shape=box,color=blue];
		j2646111040 -> j2829019030;
	j2231796909 [label="Я би порадив просто набратися терпіння, але… не мені радити тобі використовувати долото, коли поруч лежить лазерний різак.",shape=box,color=blue];
		j2231796909 -> j1311727856;
	j1872192124 [label="+5 Chemistry",color=orange];
		j1872192124 -> j867788020;
	j3441631980 [label="З іншого боку, я вражений миттєвою люттю та гнівом від усвідомлення, що моїм розумом зневажали не один, а два рази за останній час. Але є ще одне почуття, яке перемагає гнів. Одне, яке я не зовсім розумію.",shape=box,color=blue];
		j3441631980 -> j3421112085;
	j1272047109 [label="По-перше: я вражений! Тож ми позбавлені спогадів, щоб у тебе була нагода ще раз завоювати його прихильність?!",shape=box,color=blue];
		j1272047109 -> j4220731380;
	j992336856 [label="По-перше: я вражений! Тож ми позбавлені спогадів, щоб у тебе була нагода ще раз завоювати її прихильність?!",shape=box,color=blue];
		j992336856 -> j1237538662;
	j2407386575 [label="Ох, це справді чарівно! Тож ми позбавлені спогадів, щоб у тебе була нагода ще раз завоювати мою прихильність?!",shape=box,color=blue];
		j2407386575 -> j1388084477;
	j2503964649 [label="Зрада.",shape=box,color=blue];
		j2503964649 -> j3545356889;
	j2719899936 [label="Але в мене виникають спалахи. Розбиті шматки та уламки золотого коридору. Голос, який я впізнав, але не обличчя. Це був Альбрехт, але не той, якого я знав.",shape=box,color=blue];
		j2719899936 -> j2936995468;
	j2829019030 [label="Дай мені хвилинку, щоб опанувати себе.",shape=box,color=blue];
		j2829019030 -> j2370083103;
	j1311727856 [label="Я сиджу тут, і дві речі відразу ж вражають мене після підтвердження моїх підозр:",shape=box,color=blue];
		j1311727856 -> j2712965109;
	j867788020 [label="Гм. Зрозуміло. Шляхетна справа, якщо чесно. Я сам намагався зробити це багато разів. І так само невдало.",shape=box,color=blue];
		j867788020 -> j3570494138;
	j3421112085 [label="Зрада.",shape=box,color=blue];
		j3421112085 -> j1728186141;
	j4220731380 [label="Це так по-орокінськи з твого боку.",shape=box,color=blue];
		j4220731380 -> j2501864401;
	j1237538662 [label="Це так по-орокінськи з твого боку.",shape=box,color=blue];
		j1237538662 -> j2758516402;
	j1388084477 [label="Це так по-орокінськи з твого боку.",shape=box,color=blue];
		j1388084477 -> j3268797465;
	j3545356889 [label="Чому?",shape=box,color=blue];
		j3545356889 -> j2811556331;
	j2936995468 [label="Пекучий пронизливий біль. Якого я ніколи раніше не знав. А одне з моїх попередніх тіл втратило руку та ногу під час вибуху на війні, мандрівниче. Я був вкритий опіками, надто важкими, щоб оговтатися, якби не кува. Я пізнав агонію.",shape=box,color=blue];
		j2936995468 -> j4029319240;
	j2370083103 [label="Дякую. Ми можемо продовжити.",shape=box,color=blue];
		j2370083103 -> j4277596908;
	j2712965109 [label="Мені цікаво… Скільки битв я б виграв на полі бою та провів би знову, якби мав таку силу?",shape=box,color=blue];
		j2712965109 -> j2489376266;
	j3570494138 [label="Я сиджу тут, і дві речі відразу ж вражають мене після підтвердження моїх підозр:",shape=box,color=blue];
		j3570494138 -> j1991850756;
	j1728186141 [label="А що?",shape=box,color=blue];
		j1728186141 -> j781421045;
	j2501864401 [label="По-друге: якою невдахою треба бути?! Я цілком впевнений, що якби просто годувати та поїти священника раз на день, його вічна любов та обожнювання були б твоїми.",shape=box,color=blue];
		j2501864401 -> j2991403398;
	j2758516402 [label="По-друге: були спроби кульгати перед нею? Прикинутися, що хворієш? Підморгувати? Просто сказати, що вона гарно виглядає? Здається, до неї не так уже й важко залицятися.",shape=box,color=blue];
		j2758516402 -> j4210375229;
	j3268797465 [label="Я сиджу тут, і дві речі відразу ж вражають мене після підтвердження моїх підозр:",shape=box,color=blue];
		j3268797465 -> j3461188118;
	j2811556331 [label="Але це тема для іншої розмови. Бо в мене є пропозиція для тебе. Яка, я вважаю, тебе зацікавить набагато більше.",shape=box,color=blue];
		j2811556331 -> j1453783300;
	j4029319240 [label="Моє тіло розривали на шматки та перероблювали. Силою. Я цього не обирав. Я не знаю, чи було так само з іншими.",shape=box,color=blue];
		j4029319240 -> j1848879547;
	j4277596908 [label="Я використав зразки власної крові, щоб методом проб і помилок реконструювати гельмінта. Це було нелегке завдання, оскільки не було доступу до орокінського обладнання. До будь-якого обладнання, за винятком того, що я міг поцупити з…",shape=box,color=blue];
		j4277596908 -> j2898497134;
	j2489376266 [label="Скільки розумів я б спотворив, якби мав у своєму розпорядженні твої дари?",shape=box,color=blue];
		j2489376266 -> j2888896069;
	j1991850756 [label="Мені цікаво… Скільки битв я б виграв на полі бою та провів би знову, якби мав таку силу?",shape=box,color=blue];
		j1991850756 -> j2604761531;
	j781421045 [label="Але це тема для іншої розмови. Бо в мене є пропозиція для тебе. Яка, я вважаю, тебе зацікавить набагато більше.",shape=box,color=blue];
		j781421045 -> j6194177;
	j2991403398 [label="Не зрозумій мене неправильно! Я дуже вражений твоєю підступністю. ",shape=box,color=blue];
		j2991403398 -> j3740569586;
	j4210375229 [label="По-третє: я сиджу тут і раптом мене охоплює гостре усвідомлення після підтвердження моїх підозр: ",shape=box,color=blue];
		j4210375229 -> j2505885861;
	j3461188118 [label="Мені цікаво… Скільки битв я б виграв на полі бою та провів би знову, якби мав таку силу?",shape=box,color=blue];
		j3461188118 -> j1545095242;
	j1453783300 [label="Я буду вдавати, що нічого не знаю, перед фанатиками, які обожнюють тебе…",shape=box,color=blue];
		j1453783300 -> j541966542;
	j1848879547 [label="Я пам’ятаю холодні сходи піді мною, коли мене на них скинули. Сходи собору, я тепер знаю про них, оскільки Ліон і Марі розповіли мені зі своїх спогадів.",shape=box,color=blue];
		j1848879547 -> j1800340194;
	j2898497134 [label="Я не буду робити їм ласку, називаючи їх «примітивними» лікарнями. Альбрехт використав гельмінта, щоби перенести нас у минуле. Як він виріс у минулому, я не знаю, оскільки він уже мав бути там до нашого прибуття. Він засох і помер у процесі, тож я підозрюю, що інший мав бути використаний для зворотної мандрівки.",shape=box,color=blue];
		j2898497134 -> j2246801651;
	j2888896069 [label="З іншого боку, я вражений миттєвою люттю та гнівом від усвідомлення, що моїм розумом зневажали не один, а два рази за останній час. Але є ще одне почуття, яке перемагає гнів. Одне, яке я не зовсім розумію.",shape=box,color=blue];
		j2888896069 -> j336222124;
	j2604761531 [label="Скільки розумів я б спотворив, якби мав у своєму розпорядженні твої дари?",shape=box,color=blue];
