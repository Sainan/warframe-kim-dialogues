		295 -> 303;
	299 [label="Я пам’ятаю холодні сходи піді мною, коли мене на них скинули. Сходи собору, я тепер знаю про них, оскільки Ліон і Марі розповіли мені зі своїх спогадів.",shape=box,color=blue];
		299 -> 307;
	300 [label="Я не буду робити їм ласку, називаючи їх «примітивними» лікарнями. Альбрехт використав гельмінта, щоби перенести нас у минуле. Як він виріс у минулому, я не знаю, оскільки він уже мав бути там до нашого прибуття. Він засох і помер у процесі, тож я підозрюю, що інший мав бути використаний для зворотної мандрівки.",shape=box,color=blue];
		300 -> 308;
