		190 -> 192 [label="x < 21",color=purple];
		190 -> 192 [label="false",color=purple];
	189 [label="Chat ends.",color=orange];
	191 [label="Чому мені здається, що ти вже чудово знаєш відповідь на це питання, мій узурпаторе? В які ігри ти граєш, розпитуючи про такі дрібниці, якщо в тебе вже була змога покопирсатися в моєму розумі?",shape=box,color=blue];
		191 -> 193;
	192 [label="Так, ти можеш запитати! Це дасть мені змогу розповісти про власну геніальність і поскаржитися на неймовірну здатність Альбрехта бути бездумним боягузом і страшенним боягузом одночасно!",shape=box,color=blue];
		192 -> 194;
	193 [label="Check boolean RoatheKnowsReset",color=orange];
		193 -> 196 [label=true,color=green];
		193 -> 195 [label=false,color=brown];
	194 [label="Evaluate expressions on HellKeyPlayed",color=orange];
		194 -> 197 [label="x >= 1",color=purple];
		194 -> 198 [label="x <= 0",color=purple];
		194 -> 198 [label="false",color=purple];
	196 [label="Ти така ж погань, як Альбрехт, втручаєшся у розум інших, думаючи, що це твої іграшки! Тож скажи мені. Навіщо запитувати, якщо ти вже знаєш відповідь, га?",shape=box,color=blue];
		196 -> 201;
		196 -> 202;
	195 [label="Скажи мені. Я правильно розумію, що ти вже знаєш відповідь на це питання? Ти вже знаєш, що я повернувся сюди з фанатиками, та звідки саме ми прийшли. І, скоріш за все, набагато більше, чи не так?",shape=box,color=blue];
		195 -> 199;
		195 -> 200;
	197 [label="Я так розумію, що Альбрехт відправив тебе сюди не за власним бажанням.",shape=box,color=red];
		197 -> 203;
	198 [label="Ох. То тебе відіслали в минуле не за власним бажанням.",shape=box,color=red];
		198 -> 203;
	201 [label="Я намагаюся допомогти вам усім пройти через це, але минулого разу в мене не вийшло. Я намагаюся знову. Як-то кажуть, «з нуля».",shape=box,color=red];
		201 -> 206;
	202 [label="Насправді я не знаю, як це пояснити. Це не моє бажання мати здібність стирати чиїсь думки, але я намагаюся якнайкраще опанувати це.",shape=box,color=red];
		202 -> 207;
	199 [label="Ні. Це не так.",shape=box,color=red];
		199 -> 204;
	200 [label="Я… визнаю, що це так.",shape=box,color=red];
		200 -> 205;
	203 [label="Ні. Зовсім ні. Ось що тобі потрібно розуміти про окорінів: ми граємо… точніше, постійно грали один з одним в ігри. Різні ігри. Політичні, психологічні, сексуальні. Не мало значення в які.",shape=box,color=blue];
		203 -> 208;
	206 [label="+5 Chemistry",color=orange];
		206 -> 211;
	207 [label="Тоді у тебе це досить погано виходить, мій давній друзяко. Яких цілей ти намагаєшся досягти, які ще й досі не досягнуті?",shape=box,color=blue];
		207 -> 212;
	204 [label="Ха. Тепер я знаю, що ти не тільки брехло, а ще й крадій пам’яті, узурпаторе.",shape=box,color=blue];
		204 -> 209;
	205 [label="Update boolean RoatheKnowsReset",color=orange];
		205 -> 210;
	208 [label="Завдяки куві та Юванському театру ми стали фундаментально та функціонально безсмертними. Чи можеш ти уявити, наскільки це цілком і повністю втомлює?",shape=box,color=blue];
		208 -> 213;
		208 -> 214;
	211 [label="Update boolean RoatheResetScrewedUp",color=orange];
		211 -> 215;
