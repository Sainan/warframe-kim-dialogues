digraph {
	"RoatheRank1Convo3 begins." [color=orange];
		"RoatheRank1Convo3 begins." -> j2367442583;
		"RoatheRank1Convo3 begins." -> j1478915251;
	j2367442583 [label="Можна запитати? Яким вітром тебе сюди занесло? З якого… часу?",shape=box,color=red];
		j2367442583 -> j1782054338;
	j1478915251 [label="[Завершити розмову]",shape=box,color=red];
		j1478915251 -> "Chat ends.";
	j1782054338 [label="Evaluate expressions on HellStory counter",color=orange];
		j1782054338 -> j778309811 [label="x >= 21",color=purple];
		j1782054338 -> j3053660697 [label="x < 21",color=purple];
		j1782054338 -> j3053660697 [label="false",color=purple];
	"Chat ends." [color=orange];
	j778309811 [label="Чому мені здається, що ти вже чудово знаєш відповідь на це питання, мій узурпаторе? В які ігри ти граєш, розпитуючи про такі дрібниці, якщо в тебе вже була змога покопирсатися в моєму розумі?",shape=box,color=blue];
		j778309811 -> j4011668186;
	j3053660697 [label="Так, ти можеш запитати! Це дасть мені змогу розповісти про власну геніальність і поскаржитися на неймовірну здатність Альбрехта бути бездумним боягузом і страшенним боягузом одночасно!",shape=box,color=blue];
		j3053660697 -> j4070589250;
	j4011668186 [label="Check boolean RoatheKnowsReset",color=orange];
		j4011668186 -> j1108474944 [label=true,color=green];
		j4011668186 -> j4021487062 [label=false,color=brown];
	j4070589250 [label="Evaluate expressions on HellKeyPlayed counter",color=orange];
		j4070589250 -> j3950848604 [label="x >= 1",color=purple];
		j4070589250 -> j2915769907 [label="x <= 0",color=purple];
		j4070589250 -> j2915769907 [label="false",color=purple];
	j1108474944 [label="Ти така ж погань, як Альбрехт, втручаєшся у розум інших, думаючи, що це твої іграшки! Тож скажи мені. Навіщо запитувати, якщо ти вже знаєш відповідь, га?",shape=box,color=blue];
		j1108474944 -> j1206862954;
		j1108474944 -> j1960611644;
	j4021487062 [label="Скажи мені. Я правильно розумію, що ти вже знаєш відповідь на це питання? Ти вже знаєш, що я повернувся сюди з фанатиками, та звідки саме ми прийшли. І, скоріш за все, набагато більше, чи не так?",shape=box,color=blue];
		j4021487062 -> j3296031019;
		j4021487062 -> j3287688870;
	j3950848604 [label="Я так розумію, що Альбрехт відправив тебе сюди не за власним бажанням.",shape=box,color=red];
		j3950848604 -> j749713191;
	j2915769907 [label="Ох. То тебе відіслали в минуле не за власним бажанням.",shape=box,color=red];
		j2915769907 -> j749713191;
	j1206862954 [label="Я намагаюся допомогти вам усім пройти через це, але минулого разу в мене не вийшло. Я намагаюся знову. Як-то кажуть, «з нуля».",shape=box,color=red];
		j1206862954 -> j2936888735;
	j1960611644 [label="Насправді я не знаю, як це пояснити. Це не моє бажання мати здібність стирати чиїсь думки, але я намагаюся якнайкраще опанувати це.",shape=box,color=red];
		j1960611644 -> j2615768362;
	j3296031019 [label="Ні. Це не так.",shape=box,color=red];
		j3296031019 -> j1356661653;
	j3287688870 [label="Я… визнаю, що це так.",shape=box,color=red];
		j3287688870 -> j1439485673;
	j749713191 [label="Ні. Зовсім ні. Ось що тобі потрібно розуміти про орокінів: ми граємо… точніше, постійно грали один з одним в ігри. Різні ігри. Політичні, психологічні, сексуальні. Не мало значення в які.",shape=box,color=blue];
		j749713191 -> j2173407859;
	j2936888735 [label="+5 Chemistry",color=orange];
		j2936888735 -> j4212220659;
	j2615768362 [label="Тоді у тебе це досить погано виходить, мій давній друзяко. Яких цілей ти намагаєшся досягти, які ще й досі не досягнуті?",shape=box,color=blue];
		j2615768362 -> j4269406562;
	j1356661653 [label="Ха. Тепер я знаю, що ти не тільки брехло, а ще й крадій пам’яті, узурпаторе.",shape=box,color=blue];
		j1356661653 -> "Chat ends.";
	j1439485673 [label="Boolean RoatheKnowsReset is now true.",color=orange];
		j1439485673 -> j4200496601;
	j2173407859 [label="Завдяки куві та Юванському театру ми стали фундаментально та функціонально безсмертними. Чи можеш ти уявити, наскільки це цілком і повністю втомлює?",shape=box,color=blue];
		j2173407859 -> j4150155770;
		j2173407859 -> j1772155046;
	j4212220659 [label="Boolean RoatheResetScrewedUp is now true.",color=orange];
		j4212220659 -> j1462574001;
	j4269406562 [label="Check boolean LoidFamilyComplete",color=orange];
		j4269406562 -> j3885837670 [label=true,color=green];
		j4269406562 -> j3670216234 [label=true,color=green];
		j4269406562 -> j1737106270 [label=false,color=brown];
		j4269406562 -> j3885837670 [label=false,color=brown];
		j4269406562 -> j3670216234 [label=false,color=brown];
	j4200496601 [label="Тоді навіщо ставити питання, на які вже знаєш відповідь?",shape=box,color=blue];
		j4200496601 -> j1206862954;
		j4200496601 -> j1960611644;
	j4150155770 [label="У мене є певний досвід у цьому, віриш ти чи ні.",shape=box,color=red];
		j4150155770 -> j3972354094;
	j1772155046 [label="Насправді можу. Прошу, продовжуй.",shape=box,color=red];
		j1772155046 -> j4133418917;
	j1462574001 [label="А ось тут уже цікаво… у тебе «не вийшло» зі мною чи «не вийшло» з Ліоном чи Марі?",shape=box,color=blue];
		j1462574001 -> j2464409589;
		j1462574001 -> j797405261;
		j1462574001 -> j3740570374;
	j3885837670 [label="Ну, розумієш, у тебе є всі… спогади, чому ти прийняв сироватку, але… від мене ти почув багато неправильного в неправильний час.",shape=box,color=red];
		j3885837670 -> j2390205533;
	j3670216234 [label="Я… намагаюся завоювати серце одного з вас, але мені… не вдалося…",shape=box,color=red];
		j3670216234 -> j856873461;
	j1737106270 [label="Я намагаюся переконати тебе та інших допомогти мені возз’єднати Лойда з родиною на горі, але… мені… не вдалося…",shape=box,color=red];
		j1737106270 -> j111347670;
	j3972354094 [label="У тебе є досвід вічного вмирання, наскільки я чув. Що набагато цікавіше. І все ж зрештою тобі вдалося знайти причини втратити чутливість до всього цього.",shape=box,color=blue];
		j3972354094 -> j4133418917;
	j4133418917 [label="Таким чином, я звик — насправді цілком звик — до махінацій та підступів, які ми, орокіни, розігруємо одне з одним для розваги. Це просто те, як ми проводимо час.",shape=box,color=blue];
		j4133418917 -> j4244945635;
	j2464409589 [label="З Ліоном…",shape=box,color=red];
		j2464409589 -> j3365295299;
	j797405261 [label="З Марі…",shape=box,color=red];
		j797405261 -> j1923761156;
	j3740570374 [label="З тобою…",shape=box,color=red];
		j3740570374 -> j115552605;
	j2390205533 [label="+5 Chemistry",color=orange];
		j2390205533 -> j3203343491;
	j856873461 [label="+5 Chemistry",color=orange];
		j856873461 -> j2839994274;
	j111347670 [label="Гм. Зрозуміло. У нас була домовленість, але через твоє недотримання своєї частини угоди твоя винагорода зникла.",shape=box,color=blue];
		j111347670 -> j3041413228;
	j4244945635 [label="Але є межі, які ми не перетинаємо. Вчинки, яких ми не робимо. Я міг би вдатися в подробиці, але не буду. Підсумую просто констатувавши, що Альбрехт їх усі порушив.",shape=box,color=blue];
		j4244945635 -> j2003592607;
	j3365295299 [label="Справді? Можливо, просто годувати та поїти його раз на день і подивитися, чи це спрацює? Що ж…",shape=box,color=blue];
		j3365295299 -> j3672663052;
	j1923761156 [label="І тобі не вдалося переконати цю маленьку краплину чистоти піти за тобою? Я… сподіваюся, ти не будеш займатися діяльністю, пов’язаною з переговорами, мій давній друзяко.",shape=box,color=blue];
		j1923761156 -> j2814591605;
	j115552605 [label="+5 Chemistry",color=orange];
		j115552605 -> j3305753453;
	j3203343491 [label="Гм.",shape=box,color=blue];
		j3203343491 -> j3070091884;
	j2839994274 [label="ХА! Це феноменально! Моя увага прикута до тебе… хто з нас? Га? Розкажи… не соромся. Можливо, ми зможемо… домовитися.",shape=box,color=blue];
		j2839994274 -> j240093719;
		j2839994274 -> j1827936826;
		j2839994274 -> j3147554372;
	j3041413228 [label="Я сиджу тут, і дві речі відразу ж вражають мене після підтвердження моїх підозр:",shape=box,color=blue];
		j3041413228 -> j955251021;
	j2003592607 [label="Він покинув мене там, у якомусь жахливо стародавньому році, в гнилій дірі на дупі Материнської системи! Ти знаєш, що в забутому Порожнечею «соборі» навіть не було електрики?! Електрики!",shape=box,color=blue];
		j2003592607 -> j261228472;
	j3672663052 [label="Що саме з ним викликало у тебе такі проблеми? Можливо, ми могли б домовитися?",shape=box,color=blue];
		j3672663052 -> j1302134513;
	j2814591605 [label="Але скажи мені, що саме з нею викликало у тебе такі проблеми? Можливо, ми могли б… домовитися?",shape=box,color=blue];
		j2814591605 -> j256724246;
	j3305753453 [label="ХА! Це феноменально! Моя увага прикута до тебе… яким чином? Га? Розкажи… не соромся. Можливо, ми зможемо… домовитися.",shape=box,color=blue];
		j3305753453 -> j2004525054;
	j3070091884 [label="Я сиджу тут, і дві речі відразу ж вражають мене після підтвердження моїх підозр:",shape=box,color=blue];
		j3070091884 -> j714222884;
	j240093719 [label="Ліон…",shape=box,color=red];
		j240093719 -> j1052337360;
	j1827936826 [label="Марі…",shape=box,color=red];
		j1827936826 -> j3710830256;
	j3147554372 [label="Ти…",shape=box,color=red];
		j3147554372 -> j1584052071;
	j955251021 [label="Мені цікаво… Скільки битв я б виграв на полі бою та провів би знову, якби мав таку силу?",shape=box,color=blue];
		j955251021 -> j942677752;
	j261228472 [label="Ти хоч маєш уявлення, наскільки важко було реконструювати гельмінта без електрики?!",shape=box,color=blue];
		j261228472 -> j1976383329;
		j261228472 -> j2519297052;
