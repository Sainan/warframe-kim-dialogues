digraph {
	186 [label="RoatheRank1Convo3 begins.",color=orange];
		186 -> 188;
		186 -> 187;
	188 [label="Можна запитати? Яким вітром тебе сюди занесло? З якого… часу?",shape=box,color=red];
		188 -> 190;
	187 [label="[Завершити розмову]",shape=box,color=red];
		187 -> 189;
