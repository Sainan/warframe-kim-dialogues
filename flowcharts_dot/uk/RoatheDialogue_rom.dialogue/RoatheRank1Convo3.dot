		254 -> 269;
	256 [label="Я маю почуття до нього…",shape=box,color=red];
		256 -> 249;
	255 [label="Я намагаюся переконати тебе та інших допомогти мені возз’єднати Лойда з родиною на горі, але… мені… не вдалося…",shape=box,color=red];
		255 -> 224;
	257 [label="Вона не бачить Ентраті таким, яким він є насправді. І я ніяк не можу змусити її побачити правду.",shape=box,color=red];
		257 -> 270;
	259 [label="Я маю почуття до неї…",shape=box,color=red];
		259 -> 250;
	258 [label="Я намагаюся переконати тебе та інших допомогти мені возз’єднати Лойда з родиною на горі, але… мені… не вдалося…",shape=box,color=red];
		258 -> 224;
	260 [label="Ну, розумієш, у тебе є всі спогади, чому ти прийняв сироватку, але… через мене все сплуталося…",shape=box,color=red];
		260 -> 225;
	261 [label="[Зізнатися в почуттях] Мені… справді ніяково, але я…",shape=box,color=red];
		261 -> 251;
	263 [label="Скільки розумів я б спотворив, якби мав у своєму розпорядженні твої дари?",shape=box,color=blue];
		263 -> 5737;
	264 [label="+5 Chemistry",color=orange];
		264 -> 272;
	265 [label="+5 Chemistry",color=orange];
		265 -> 273;
	266 [label="+5 Chemistry",color=orange];
		266 -> 274;
	262 [label="З іншого боку, я вражений миттєвою люттю та гнівом від усвідомлення, що моїм розумом зневажали не один, а два рази за останній час. Але є ще одне почуття, яке перемагає гнів. Одне, яке я не зовсім розумію.",shape=box,color=blue];
		262 -> 271;
	267 [label="Я не знаю подробиць, оскільки ці спогади відсутні в моїй голові разом із багатьма іншими через перетворення, до якого він мене спонукав.",shape=box,color=blue];
		267 -> 275;
	268 [label="Так! Саме так! Зі зразків своєї власної крові! Я не розпочинав процес у тому ж році, який ми залишили, я тобі скажу! Присягаюся Порожнечею, я здеру з нього шкіру своїми новими кігтями, щойно побачу його дурне, самовдоволене обличчя…",shape=box,color=blue];
		268 -> 276;
	269 [label="Я би порадив просто набратися терпіння, але… не мені радити тобі використовувати долото, коли поруч лежить лазерний різак.",shape=box,color=blue];
		269 -> 277;
	270 [label="+5 Chemistry",color=orange];
		270 -> 278;
	5737 [label="Second, I am struck by the immediate fury and anger at knowing that my mind has been trifled with not once but twice in recent history. But there is another emotion that comes to defeat the anger. One I do not quite yet understand.",shape=box,color=blue];
		5737 -> 5740;
	272 [label="По-перше: я вражений! Тож ми позбавлені спогадів, щоб у тебе була нагода ще раз завоювати його прихильність?!",shape=box,color=blue];
		272 -> 280;
	273 [label="По-перше: я вражений! Тож ми позбавлені спогадів, щоб у тебе була нагода ще раз завоювати її прихильність?!",shape=box,color=blue];
		273 -> 281;
	274 [label="Ох, це справді чарівно! Тож ми позбавлені спогадів, щоб у тебе була нагода ще раз завоювати мою прихильність?!",shape=box,color=blue];
		274 -> 282;
	271 [label="Зрада.",shape=box,color=blue];
		271 -> 279;
	275 [label="Але в мене виникають спалахи. Розбиті шматки та уламки золотого коридору. Голос, який я впізнав, але не обличчя. Це був Альбрехт, але не той, якого я знав.",shape=box,color=blue];
		275 -> 283;
	276 [label="Дай мені хвилинку, щоб опанувати себе.",shape=box,color=blue];
		276 -> 284;
	277 [label="Я сиджу тут, і дві речі відразу ж вражають мене після підтвердження моїх підозр:",shape=box,color=blue];
		277 -> 285;
	278 [label="Гм. Зрозуміло. Шляхетна справа, якщо чесно. Я сам намагався зробити це багато разів. І так само невдало.",shape=box,color=blue];
		278 -> 286;
	5740 [label="Зрада.",shape=box,color=blue];
		5740 -> 5741;
	280 [label="Це так по-орокінськи з твого боку.",shape=box,color=blue];
		280 -> 288;
	281 [label="Це так по-орокінськи з твого боку.",shape=box,color=blue];
		281 -> 289;
	282 [label="Це так по-орокінськи з твого боку.",shape=box,color=blue];
		282 -> 290;
	279 [label="Чому?",shape=box,color=blue];
		279 -> 287;
	283 [label="Пекучий пронизливий біль. Якого я ніколи раніше не знав. А одне з моїх попередніх тіл втратило руку та ногу під час вибуху на війні, мандрівниче. Я був вкритий опіками, надто важкими, щоб оговтатися, якби не кува. Я пізнав агонію.",shape=box,color=blue];
		283 -> 291;
	284 [label="Дякую. Ми можемо продовжити.",shape=box,color=blue];
		284 -> 292;
	285 [label="Мені цікаво… Скільки битв я б виграв на полі бою та провів би знову, якби мав таку силу?",shape=box,color=blue];
		285 -> 293;
	286 [label="Я сиджу тут, і дві речі відразу ж вражають мене після підтвердження моїх підозр:",shape=box,color=blue];
		286 -> 294;
	5741 [label="Why?",shape=box,color=blue];
		5741 -> 5742;
	288 [label="По-друге: якою невдахою треба бути?! Я цілком впевнений, що якби просто годувати та поїти священника раз на день, його вічна любов та обожнювання були б твоїми.",shape=box,color=blue];
		288 -> 296;
	289 [label="По-друге: були спроби кульгати перед нею? Прикинутися, що хворієш? Підморгувати? Просто сказати, що вона гарно виглядає? Здається, до неї не так уже й важко залицятися.",shape=box,color=blue];
		289 -> 297;
	290 [label="Я сиджу тут, і дві речі відразу ж вражають мене після підтвердження моїх підозр:",shape=box,color=blue];
		290 -> 298;
	287 [label="Але це тема для іншої розмови. Бо в мене є пропозиція для тебе. Яка, я вважаю, тебе зацікавить набагато більше.",shape=box,color=blue];
		287 -> 295;
	291 [label="Моє тіло розривали на шматки та перероблювали. Силою. Я цього не обирав. Я не знаю, чи було так само з іншими.",shape=box,color=blue];
		291 -> 299;
	292 [label="Я використав зразки власної крові, щоб методом проб і помилок реконструювати гельмінта. Це було нелегке завдання, оскільки не було доступу до орокінського обладнання. До будь-якого обладнання, за винятком того, що я міг поцупити з…",shape=box,color=blue];
		292 -> 300;
	293 [label="Скільки розумів я б спотворив, якби мав у своєму розпорядженні твої дари?",shape=box,color=blue];
		293 -> 301;
	294 [label="Мені цікаво… Скільки битв я б виграв на полі бою та провів би знову, якби мав таку силу?",shape=box,color=blue];
		294 -> 302;
	5742 [label="Але це тема для іншої розмови. Бо в мене є пропозиція для тебе. Яка, я вважаю, тебе зацікавить набагато більше.",shape=box,color=blue];
		5742 -> 5739;
	296 [label="Не зрозумій мене неправильно! Я дуже вражений твоєю підступністю. ",shape=box,color=blue];
