	j3377209213 [label="Ні. Аж ніяк ні!",shape=box,color=red];
		j3377209213 -> j3322591602;
	j86262030 [label="І, що важливіше, я гарантую, що ти досягнеш своєї мети — бути разом із твоїм дорогим отцем Ліоном Аллардом, коли прийде час.",shape=box,color=blue];
		j86262030 -> j3910895469;
	j850701353 [label="І, що важливіше, я гарантую, що ти досягнеш своєї мети — бути разом із «маленькою Марі», коли прийде час.",shape=box,color=blue];
		j850701353 -> j3591790561;
	j1504306962 [label="Але запам’ятай мої слова, мандрівниче.",shape=box,color=blue];
		j1504306962 -> j3998343216;
	j1484263017 [label="Мудрий вибір. Буденний, але мудрий.",shape=box,color=blue];
		j1484263017 -> j2665566623;
	j2721206327 [label="І ти матимеш усе необхідне для цього, що б це не було… Так, у тебе вийде. Я подбаю про це особисто.",shape=box,color=blue];
		j2721206327 -> j1661349251;
		j2721206327 -> j254587209;
	j3621667904 [label="+20 Chemistry",color=orange];
		j3621667904 -> j323234639;
	j283439821 [label="І все ж я здивований, що не знайшов його тут. Я був упевнений, що саме тут він ховатиметься зі своїм коханцем. Чи зі своєю родиною.",shape=box,color=blue];
		j283439821 -> j3468588771;
	j282273038 [label="Я пам’ятаю холодні сходи піді мною, коли мене на них скинули. Сходи собору, я тепер знаю про них, оскільки Ліон і Марі розповіли мені зі своїх спогадів.",shape=box,color=blue];
		j282273038 -> j2874139963;
	j1976966919 [label="Не сьогодні. Не завтра.",shape=box,color=blue];
		j1976966919 -> j1003563053;
	j1718734718 [label="Ти. Будеш. У боргу. Переді мною.",shape=box,color=blue];
		j1718734718 -> j3533298217;
	j2129463439 [label="І ти матимеш усе необхідне для цього, що б це не було… Так, у тебе вийде. Я подбаю про це особисто.",shape=box,color=blue];
		j2129463439 -> j879051582;
		j2129463439 -> j1247909769;
