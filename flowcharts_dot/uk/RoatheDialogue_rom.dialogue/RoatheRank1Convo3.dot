		j254587209 -> j1721879368;
	j323234639 [label="Та. Це була цікава розмова. Узурпаторе, я мушу йти. Скоро ми знову поговоримо.",shape=box,color=blue];
		j323234639 -> "Chat ends.";
	j3468588771 [label="Що ж, я буду цілком готовий зустріти його, коли він повернеться. Дуже міцним рукостисканням.",shape=box,color=blue];
		j3468588771 -> j3621667904;
	j2874139963 [label="Альбрехт привів мене в їхній час, до їхнього дурного собору. І віддав мене під їхню «опіку».",shape=box,color=blue];
		j2874139963 -> j1729520454;
