digraph {
	"RoatheRank3Convo5 begins." [color=orange];
		"RoatheRank3Convo5 begins." -> j4197113301;
	j4197113301 [label="Альбрехт був проблемою від самого початку. Він і вся ця його манія з Порожнечею. Гадаю, його одружили з Ґерівейн у надії, що родина трохи втихомирить його.",shape=box,color=blue];
		j4197113301 -> j552779815;
	j552779815 [label="Та, здається, сталося навпаки. Коли в нього з’явилися діти, він сприйняв їх як додаткові руки. Спільників у своїх божевільних експериментах.",shape=box,color=blue];
		j552779815 -> j2761560414;
	j2761560414 [label="Розхідний матеріал. Як і все у його житті.",shape=box,color=blue];
		j2761560414 -> j1560360475;
		j2761560414 -> j395395506;
		j2761560414 -> j1478915251;
	j1560360475 [label="Ґерівейн?",shape=box,color=red];
		j1560360475 -> j106279046;
	j395395506 [label="Він ставиться до людей не просто як до розхідного матеріалу.",shape=box,color=red];
		j395395506 -> j3365700703;
	j1478915251 [label="[Завершити розмову]",shape=box,color=red];
		j1478915251 -> "Chat ends.";
	j106279046 [label="Ім’я, що, можливо, загубилося у літописах… Дружина Альбрехта Ентраті, узурпаторе. Мати його дітей.",shape=box,color=blue];
		j106279046 -> j4103666644;
	j3365700703 [label="Добре, я визнаю, що хоч він і уб’є будь-кого та будь-що у своєму житті з холодністю будь-якого Виконавця, але не зробить це безцільно.",shape=box,color=blue];
		j3365700703 -> j3858913147;
	"Chat ends." [color=orange];
	j4103666644 [label="Check boolean LoidFamilyComplete",color=orange];
		j4103666644 -> j4207633375 [label=true,color=green];
		j4103666644 -> j2241519620 [label=false,color=brown];
	j3858913147 [label="Знаєш, коли я замислююся над цим тепер, розумію: саме його холодність робила його таким небезпечним у наш час. Він був здатен пожертвувати будь-чим заради здійснення своїх задумів. Абсолютно будь-чим.",shape=box,color=blue];
		j3858913147 -> j621985053;
		j3858913147 -> j558281061;
	j4207633375 [label="Але ось тобі й маєш — мабуть, знову робиш із мене дурня. Бо є ймовірність, що ти вже це знаєш, якщо вже дворецький із ними знову.",shape=box,color=blue];
		j4207633375 -> j3844205634;
	j2241519620 [label="Ті, хто сидять у солодкому невіданні про наше існування, там унизу, у цьому прогнилому Святилищі. І досі вважаю це до болю кумедним.",shape=box,color=blue];
		j2241519620 -> j3858913147;
	j621985053 [label="Мені здавалося, орокіни не мали проблем із тим, щоб жертвувати чимось дорогим. Ви всі здавалися надзвичайно безжальними одне до одного.",shape=box,color=red];
		j621985053 -> j1372132780;
	j558281061 [label="Як ти до цього дійшов?",shape=box,color=red];
		j558281061 -> j2655450022;
	j3844205634 [label="Та я не збираюся розпочинати з тобою ще в одну суперечку. Настрою немає.",shape=box,color=blue];
		j3844205634 -> j3858913147;
	j1372132780 [label="Ти надто охоче робиш припущення про те, в чому нічого не тямиш, мандрівниче.",shape=box,color=blue];
		j1372132780 -> j825198315;
	j2655450022 [label="+10 Chemistry",color=orange];
		j2655450022 -> j2472179288;
	j825198315 [label="А, може, у тебе є легкий синій відтінок шкіри, який я не помітив? Ти орокін? Якщо так, то прийми мої найглибші й найщиріші вибачення! ",shape=box,color=blue];
		j825198315 -> j1894800975;
		j825198315 -> j1371191234;
	j2472179288 [label="Можливо, існує поширене уявлення, що все, чим ми, орокіни, займалися — це встромляли одне одному ножі в спину та вбивали своїх. І повір, цього було чимало. Ми були майже безсмертні, і розваг у нас було небагато.",shape=box,color=blue];
		j2472179288 -> j1480209851;
	j1894800975 [label="Пробач. Я не хотів тебе образити. Чесно кажучи, я й сам мало що пам’ятаю про суспільство орокінів — я був зовні, лише спостерігав збоку.",shape=box,color=red];
		j1894800975 -> j3033189499;
	j1371191234 [label="Ну пробач, якщо я пам’ятаю про суспільство орокінів не дуже чудові речі. Здебільшого це записи, де як вигукую накази з гучномовців. Це було до мого потрапляння в пастку Порожнечі…",shape=box,color=red];
		j1371191234 -> j2572496551;
	j1480209851 [label="Але ми також були народом глибокої пристрасті. Ніхто не творив мистецтво так, як творили його орокіни. Ніхто не писав музику, театр чи поезію такого рівня, як ми.",shape=box,color=blue];
		j1480209851 -> j3357493985;
	j3033189499 [label="Вибачення прийнято. Цього разу. Я й так маю досить зневаги від усіх довкола. Як би цікаво з тобою не було, я — не чиясь подушечка для голок. У мене є ліпші способи провести час.",shape=box,color=blue];
		j3033189499 -> j400997971;
	j2572496551 [label="Boolean RoatheInsulted is now true.",color=orange];
		j2572496551 -> j507952914;
	j3357493985 [label="І ніхто не кохав так глибоко, як ми, коли наші серця обирали когось.",shape=box,color=blue];
		j3357493985 -> j776762714;
	j400997971 [label="На чому я зупинився? А, так. Наш безпристрасний Ентраті.",shape=box,color=blue];
		j400997971 -> j2472179288;
	j507952914 [label="Даю попередження. Я й так маю досить зневаги від усіх довкола. Як би цікаво з тобою не було, я — не чиясь подушечка для голок. У мене є ліпші способи провести час.",shape=box,color=blue];
		j507952914 -> j400997971;
	j776762714 [label="Усі, окрім Альбрехта. На все, що він робив, на всіх, із ким взаємодіяв, він ніби споглядав крізь пласт свого улюбленого сіроскла.",shape=box,color=blue];
		j776762714 -> j3646886767;
	j3646886767 [label="Відірваний. Відсторонений. Не зацікавлений. Невразливий. Навіть коли Ґерівейн померла й він лишився сам виховувати свою маленьку доньку.",shape=box,color=blue];
		j3646886767 -> j1969269467;
	j1969269467 [label="Check boolean LoidFamilyComplete",color=orange];
		j1969269467 -> j2281311621 [label=true,color=green];
		j1969269467 -> j1511228448 [label=false,color=brown];
	j2281311621 [label="Яка, за всіма ознаками, мала всі шанси перевершити його самого. Якби вона зрештою не обернулася на заражену істоту, приречену вкоренитися в одному місці. Яка марнота.",shape=box,color=blue];
		j2281311621 -> j2208877546;
		j2281311621 -> j2994572889;
	j1511228448 [label="Яка, за всіма ознаками, мала всі шанси перевершити його самого. Не дочекаюся побачити, що сталося з нею та всією цією родиною Ентраті. У всій їхній… зараженій пишності.",shape=box,color=blue];
		j1511228448 -> j846134467;
		j1511228448 -> j3303352017;
	j2208877546 [label="Мені приємно, що ми змогли вмовити Лойда піднятися.",shape=box,color=red];
		j2208877546 -> j3099926256;
	j2994572889 [label="Я знаю, ти не пам’ятаєш, навіщо ми це зробили, але добре, що нам вдалося вмовити Лойда піднятися.",shape=box,color=red];
		j2994572889 -> j3476741125;
	j846134467 [label="Усе ще розмірковую, чи це хороша ідея…",shape=box,color=red];
		j846134467 -> j780909880;
	j3303352017 [label="Якщо нам вдасться переконати Лойда піднятися, що ти робитимеш далі?",shape=box,color=red];
		j3303352017 -> j2389367247;
	j3099926256 [label="Ти так кажеш. А я стою там, як дурень, охороняю їх, слухаю, як вони говорять про це возз’єднання так, ніби я пам’ятаю, що воно взагалі було. Ти уявляєш, наскільки це незручно?!",shape=box,color=blue];
		j3099926256 -> j2271719944;
	j3476741125 [label="Ти хоч розумієш, наскільки незручно стояти там і робити вигляд, ніби я пам’ятаю те возз’єднання?! Коли я хоч убий не можу цього пригадати?!",shape=box,color=blue];
		j3476741125 -> j2271719944;
	j780909880 [label="Гм, мабуть, ні. Мені цікаво, чи у тебе випадково немає адреси Альбрехта?",shape=box,color=blue];
		j780909880 -> j439743515;
	j2389367247 [label="Я ще не вирішив. Можливо, почну відрізати їм кінцівки та консервувати в рідині. У тебе випадково немає адреси Альбрехта?",shape=box,color=blue];
		j2389367247 -> j1947582936;
	j2271719944 [label="Це як стояти на галавечорі, коли до тебе підходить хтось, хто, очевидно, тебе знає, а ти його геть ні. Але мусиш підтримувати розмову, ніби пам’ятаєш!",shape=box,color=blue];
		j2271719944 -> j384111205;
	j439743515 [label="Ні, а що?",shape=box,color=red];
		j439743515 -> j1117413736;
	j1947582936 [label="What?!",shape=box,color=red];
		j1947582936 -> j553539901;
	j384111205 [label="Ти хоч трохи усвідомлюєш, у якому пеклі я був? Хоч якесь уявлення маєш?! Стояти там — суцільна мука, і це цілком твоя провина! ",shape=box,color=blue];
		j384111205 -> j1815724667;
	j1117413736 [label="Ну, я думав піднятися туди й почати відрубувати їхні кінцівки та надсилати йому в склянках поштою, по одній за раз.",shape=box,color=blue];
		j1117413736 -> j1947582936;
	j553539901 [label="+10 Chemistry",color=orange];
		j553539901 -> j2598559696;
	j1815724667 [label="Пхе, досить із мене. Треба випити.",shape=box,color=blue];
		j1815724667 -> j1933300832;
	j2598559696 [label="Та вспокойся! Ніхто тут жарти не сприймає?",shape=box,color=blue];
		j2598559696 -> j3400788607;
	j1933300832 [label="+10 Chemistry",color=orange];
		j1933300832 -> "Chat ends.";
	j3400788607 [label="Хто б узагалі їх відправив для мене поштою?",shape=box,color=blue];
		j3400788607 -> "Chat ends.";
}