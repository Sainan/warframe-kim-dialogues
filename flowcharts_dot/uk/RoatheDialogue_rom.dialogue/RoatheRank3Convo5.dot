digraph {
	1995 [label="RoatheRank3Convo5 begins.",color=orange];
		1995 -> 1996;
	1996 [label="Альбрехт був проблемою від самого початку. Він і вся ця його манія з Порожнечею. Гадаю, його одружили з Ґерівейн у надії, що родина трохи втихомирить його.",shape=box,color=blue];
		1996 -> 1997;
	1997 [label="Та, здається, сталося навпаки. Коли в нього з’явилися діти, він сприйняв їх як додаткові руки. Спільників у своїх божевільних експериментах.",shape=box,color=blue];
		1997 -> 1998;
	1998 [label="Розхідний матеріал. Як і все у його житті.",shape=box,color=blue];
		1998 -> 2001;
		1998 -> 2000;
		1998 -> 1999;
	2001 [label="Ґерівейн?",shape=box,color=red];
		2001 -> 2004;
	2000 [label="Він ставиться до людей не просто як до розхідного матеріалу.",shape=box,color=red];
		2000 -> 2003;
	1999 [label="[Завершити розмову]",shape=box,color=red];
		1999 -> 2002;
	2004 [label="Ім’я, що, можливо, загубилося у літописах… Дружина Альбрехта Ентраті, узурпаторе. Мати його дітей.",shape=box,color=blue];
		2004 -> 2006;
	2003 [label="Добре, я визнаю, що хоч він і уб’є будь-кого та будь-що у своєму житті з холодністю будь-якого Виконавця, але не зробить це безцільно.",shape=box,color=blue];
		2003 -> 2005;
	2002 [label="Chat ends.",color=orange];
	2006 [label="Check boolean LoidFamilyComplete",color=orange];
		2006 -> 2009 [label=true,color=green];
		2006 -> 2010 [label=false,color=brown];
	2005 [label="Знаєш, коли я замислююся над цим тепер, розумію: саме його холодність робила його таким небезпечним у наш час. Він був здатен пожертвувати будь-чим заради здійснення своїх задумів. Абсолютно будь-чим.",shape=box,color=blue];
		2005 -> 2007;
		2005 -> 2008;
	2009 [label="Але ось тобі й маєш — мабуть, знову робиш із мене дурня. Бо є ймовірність, що ти вже це знаєш, якщо вже дворецький із ними знову.",shape=box,color=blue];
		2009 -> 2013;
	2010 [label="Ті, хто сидять у солодкому невіданні про наше існування, там унизу, у цьому прогнилому Святилищі. І досі вважаю це до болю кумедним.",shape=box,color=blue];
		2010 -> 2005;
	2007 [label="Мені здавалося, орокіни не мали проблем із тим, щоб жертвувати чимось дорогим. Ви всі здавалися надзвичайно безжальними одне до одного.",shape=box,color=red];
		2007 -> 2011;
	2008 [label="Як ти до цього дійшов?",shape=box,color=red];
		2008 -> 2012;
	2013 [label="Та я не збираюся розпочинати з тобою ще в одну суперечку. Настрою немає.",shape=box,color=blue];
		2013 -> 2005;
	2011 [label="Ти надто охоче робиш припущення про те, в чому нічого не тямиш, мандрівниче.",shape=box,color=blue];
		2011 -> 2014;
	2012 [label="+10 Chemistry",color=orange];
		2012 -> 2015;
	2014 [label="А, може, у тебе є легкий синій відтінок шкіри, який я не помітив? Ти орокін? Якщо так, то прийми мої найглибші й найщиріші вибачення! ",shape=box,color=blue];
		2014 -> 2016;
		2014 -> 2017;
	2015 [label="Можливо, існує поширене уявлення, що все, чим ми, орокіни, займалися — це встромляли одне одному ножі в спину та вбивали своїх. І повір, цього було чимало. Ми були майже безсмертні, і розваг у нас було небагато.",shape=box,color=blue];
		2015 -> 2018;
	2016 [label="Пробач. Я не хотів тебе образити. Чесно кажучи, я й сам мало що пам’ятаю про суспільство орокінів — я був зовні, лише спостерігав збоку.",shape=box,color=red];
		2016 -> 2019;
	2017 [label="Ну пробач, якщо я пам’ятаю про суспільство орокінів не дуже чудові речі. Здебільшого це записи, де як вигукую накази з гучномовців. Це було до мого потрапляння в пастку Порожнечі…",shape=box,color=red];
		2017 -> 2020;
	2018 [label="Але ми також були народом глибокої пристрасті. Ніхто не творив мистецтво так, як творили його орокіни. Ніхто не писав музику, театр чи поезію такого рівня, як ми.",shape=box,color=blue];
		2018 -> 2021;
	2019 [label="Вибачення прийнято. Цього разу. Я й так маю досить зневаги від усіх довкола. Як би цікаво з тобою не було, я — не чиясь подушечка для голок. У мене є ліпші способи провести час.",shape=box,color=blue];
		2019 -> 2022;
	2020 [label="Update boolean RoatheInsulted",color=orange];
		2020 -> 2023;
	2021 [label="І ніхто не кохав так глибоко, як ми, коли наші серця обирали когось.",shape=box,color=blue];
		2021 -> 2024;
	2022 [label="На чому я зупинився? А, так. Наш безпристрасний Ентраті.",shape=box,color=blue];
		2022 -> 2015;
	2023 [label="Даю попередження. Я й так маю досить зневаги від усіх довкола. Як би цікаво з тобою не було, я — не чиясь подушечка для голок. У мене є ліпші способи провести час.",shape=box,color=blue];
		2023 -> 2022;
	2024 [label="Усі, окрім Альбрехта. На все, що він робив, на всіх, із ким взаємодіяв, він ніби споглядав крізь пласт свого улюбленого сіроскла.",shape=box,color=blue];
		2024 -> 2025;
	2025 [label="Відірваний. Відсторонений. Не зацікавлений. Невразливий. Навіть коли Ґерівейн померла й він лишився сам виховувати свою маленьку доньку.",shape=box,color=blue];
		2025 -> 2026;
	2026 [label="Check boolean LoidFamilyComplete",color=orange];
		2026 -> 2028 [label=true,color=green];
		2026 -> 2027 [label=false,color=brown];
	2028 [label="Яка, за всіма ознаками, мала всі шанси перевершити його самого. Якби вона зрештою не обернулася на заражену істоту, приречену вкоренитися в одному місці. Яка марнота.",shape=box,color=blue];
		2028 -> 2031;
		2028 -> 2032;
	2027 [label="Яка, за всіма ознаками, мала всі шанси перевершити його самого. Не дочекаюся побачити, що сталося з нею та всією цією родиною Ентраті. У всій їхній… зараженій пишності.",shape=box,color=blue];
		2027 -> 2029;
		2027 -> 2030;
	2031 [label="Мені приємно, що ми змогли вмовити Лойда піднятися.",shape=box,color=red];
		2031 -> 2035;
	2032 [label="Я знаю, ти не пам’ятаєш, навіщо ми це зробили, але добре, що нам вдалося вмовити Лойда піднятися.",shape=box,color=red];
		2032 -> 2036;
	2029 [label="Усе ще розмірковую, чи це хороша ідея…",shape=box,color=red];
		2029 -> 2033;
	2030 [label="Якщо нам вдасться переконати Лойда піднятися, що ти робитимеш далі?",shape=box,color=red];
		2030 -> 2034;
	2035 [label="Ти так кажеш. А я стою там, як дурень, охороняю їх, слухаю, як вони говорять про це возз’єднання так, ніби я пам’ятаю, що воно взагалі було. Ти уявляєш, наскільки це незручно?!",shape=box,color=blue];
		2035 -> 2039;
	2036 [label="Ти хоч розумієш, наскільки незручно стояти там і робити вигляд, ніби я пам’ятаю те возз’єднання?! Коли я хоч убий не можу цього пригадати?!",shape=box,color=blue];
		2036 -> 2039;
	2033 [label="Гм, мабуть, ні. Мені цікаво, чи у тебе випадково немає адреси Альбрехта?",shape=box,color=blue];
		2033 -> 2037;
	2034 [label="Я ще не вирішив. Можливо, почну відрізати їм кінцівки та консервувати в рідині. У тебе випадково немає адреси Альбрехта?",shape=box,color=blue];
		2034 -> 2038;
	2039 [label="Це як стояти на галавечорі, коли до тебе підходить хтось, хто, очевидно, тебе знає, а ти його геть ні. Але мусиш підтримувати розмову, ніби пам’ятаєш!",shape=box,color=blue];
		2039 -> 2042;
	2037 [label="Ні, а що?",shape=box,color=red];
		2037 -> 2040;
	2038 [label="What?!",shape=box,color=red];
		2038 -> 2041;
	2042 [label="Ти хоч трохи усвідомлюєш, у якому пеклі я був? Хоч якесь уявлення маєш?! Стояти там — суцільна мука, і це цілком твоя провина! ",shape=box,color=blue];
		2042 -> 2044;
	2040 [label="Ну, я думав піднятися туди й почати відрубувати їхні кінцівки та надсилати йому в склянках поштою, по одній за раз.",shape=box,color=blue];
		2040 -> 5776;
	2041 [label="+10 Chemistry",color=orange];
		2041 -> 2043;
	2044 [label="Пхе, досить із мене. Треба випити.",shape=box,color=blue];
		2044 -> 2046;
	5776 [label="What?!",shape=box,color=red];
		5776 -> 2041;
	2043 [label="Та вспокойся! Ніхто тут жарти не сприймає?",shape=box,color=blue];
		2043 -> 2045;
	2046 [label="+10 Chemistry",color=orange];
		2046 -> 2048;
	2045 [label="Хто б узагалі їх відправив для мене поштою?",shape=box,color=blue];
		2045 -> 2047;
	2048 [label="Chat ends.",color=orange];
	2047 [label="Chat ends.",color=orange];
}