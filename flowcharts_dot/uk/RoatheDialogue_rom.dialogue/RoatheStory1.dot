	"Chat ends." [color=orange];
	j110779096 [label="НІТОГ",shape=box,color=blue];
		j110779096 -> j2361088364;
	j2361088364 [label="Витяг: Її божевілля було таким спокусливим, бо було очевидним.",shape=box,color=blue];
		j2361088364 -> j3747382390;
	j3747382390 [label="З нею завжди усвідомлюєш де стоїш — над урвищем великої безодні.",shape=box,color=blue];
		j3747382390 -> j3059195146;
	j3059195146 [label="Стрибай, говорили її очі, сяючи веселощами грандіозного жарту космічних масштабів.",shape=box,color=blue];
		j3059195146 -> j2929937144;
	j2929937144 [label="Завдяки божевільним видінням я міг утікати від довгого затхлого похмурого існування орокінів.",shape=box,color=blue];
		j2929937144 -> j3375590982;
	j3375590982 [label="Усі наші відчуття заціпеніли ще століття тому. Та вона, по-своєму, лишалася свіжою.",shape=box,color=blue];
		j3375590982 -> j3389371762;
	j3389371762 [label="Вічна. Безмежна у своїй спразі. Одного вечора вона покликала мене до своєї ванни. Я пройшов барвистими калюжами крові й пахучої води та став у покірній стійці.",shape=box,color=blue];
		j3389371762 -> j328647964;
	j328647964 [label="«Мені нудно, Роуте. Переб’ємо всіх інших орокінів, щоби перебрати владу на себе?».",shape=box,color=blue];
		j328647964 -> j921430358;
	j921430358 [label="Add 1 to HellStory counter",color=orange];
		j921430358 -> "Chat ends.";
}