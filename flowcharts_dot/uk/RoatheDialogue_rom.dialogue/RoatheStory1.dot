	2132 [label="Витяг: Її божевілля було таким спокусливим, бо було очевидним.",shape=box,color=blue];
		2132 -> 5636;
	5636 [label="З нею завжди усвідомлюєш де стоїш — над урвищем великої безодні.",shape=box,color=blue];
		5636 -> 5635;
	5635 [label="Стрибай, говорили її очі, сяючи веселощами грандіозного жарту космічних масштабів.",shape=box,color=blue];
		5635 -> 5637;
	5637 [label="Завдяки божевільним видінням я міг утікати від довгого затхлого похмурого існування орокінів.",shape=box,color=blue];
		5637 -> 2136;
	2136 [label="Усі наші відчуття заціпеніли ще століття тому. Та вона, по-своєму, лишалася свіжою.",shape=box,color=blue];
		2136 -> 5638;
	5638 [label="Вічна. Безмежна у своїй спразі. Одного вечора вона покликала мене до своєї ванни. Я пройшов барвистими калюжами крові й пахучої води та став у покірній стійці.",shape=box,color=blue];
		5638 -> 5639;
	5639 [label="«Мені нудно, Роуте. Переб’ємо всіх інших орокінів, щоби перебрати владу на себе?».",shape=box,color=blue];
		5639 -> 2135;
