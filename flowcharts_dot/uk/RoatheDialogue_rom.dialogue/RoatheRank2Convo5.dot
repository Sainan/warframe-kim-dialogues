digraph {
	graph [fontname="Roboto Condensed"];
	node [fontname="Roboto Condensed"];
	edge [fontname="Roboto Condensed"];

	"RoatheRank2Convo5 begins." [color=orange];
		"RoatheRank2Convo5 begins." -> j2554321341;
	j2554321341 [label="Check boolean RoatheRank2Convo1Complete",color=orange];
		j2554321341 -> j364889355 [label=true,color=green];
		j2554321341 -> "Chat ends." [label=false,color=brown];
	j364889355 [label="Check boolean RoatheKnowsReset2",color=orange];
		j364889355 -> j3178530976 [label=true,color=green];
		j364889355 -> j1918363296 [label=false,color=brown];
	"Chat ends." [color=orange];
	j3178530976 [label="Як багато колишній Роут розповів тобі про свої стосунки з Виконавицею Нітог? Намагаюся змиритися з тим, що колишній я повідав тобі таку особисту інформацію… лише для того, щоб ці спогади були повністю стерті?",shape=box,color=blue];
		j3178530976 -> j1957041668;
	j1918363296 [label="Evaluate expressions on HellStory counter",color=orange];
		j1918363296 -> j36743786 [label="x >= 1",color=purple];
		j1918363296 -> "Chat ends." [label="x <= 1",color=purple];
		j1918363296 -> "Chat ends." [label="false",color=purple];
	j1957041668 [label="Це випалює в мені дірку. Те, що я міг би розповісти тобі все, абсолютно все — відкрити перед тобою найпотаємніші куточки своєї душі, а ти… знову все зітреш. Ніби я для тебе лише маленька іграшка.",shape=box,color=blue];
		j1957041668 -> j828361957;
	j36743786 [label="Тобі вже відомо про Виконавицю Нітог, про яку я згадував. І мої… стосунки з нею. Тобі потрібно зрозуміти, що орокінська імперія не була цілковитим злом.",shape=box,color=blue];
		j36743786 -> j4167002778;
	j828361957 [label="Я вважаю, що це справедливо. Ось так ми, орокіни, ставилися до людства, чи не так? Юванський театр? Виставляючи напоказ тіла й вибираючи собі нових себе за власним бажанням, катуючи одне одного іграми для хворих розваг, як нам заманеться…",shape=box,color=blue];
		j828361957 -> j3770814376;
	j4167002778 [label="Мені боляче, що руйнування і розпуста – це все, чим її запам’ятають. Так, їх було багато, я не заперечую цього. ",shape=box,color=blue];
		j4167002778 -> j1615497410;
	j3770814376 [label="Я ненавиджу це. Ненавиджу дуже, дуже сильно.",shape=box,color=blue];
		j3770814376 -> j1724674971;
		j3770814376 -> j1727617362;
		j3770814376 -> j1478915251;
	j1615497410 [label="Але вона також було здатна на таку красу. Таку радість. Таке кохання. Такі наукові та мистецькі досягнення. Подивися, чого ми змогли досягти! ",shape=box,color=blue];
		j1615497410 -> j1201788462;
	j1724674971 [label="В мене не було наміру так тебе образити, і мені шкода, що так сталося, але якщо це навчило тебе, як це бути на іншому боці орокінської імперії, то це цінний урок.",shape=box,color=red];
		j1724674971 -> j2234730044;
	j1727617362 [label="В мене ніколи не було наміру, щоб це так тебе образило. Тобі не потрібно вибачатися за те, як функціонувало орокінське суспільство, ти його не створював. Ти намагався його врятувати.",shape=box,color=red];
		j1727617362 -> j3916829358;
	j1478915251 [label="[Завершити розмову]",shape=box,color=red];
		j1478915251 -> "Chat ends.";
	j1201788462 [label="Тож коли Нітог викликала мене до себе й сказала, що хоче вбити всіх орокінів — я одразу погодився. Я хотів відрубати голову отруйному змію. Я хотів замінити його на милостивішу систему. Милостивішого правителя.",shape=box,color=blue];
		j1201788462 -> j1904055667;
		j1201788462 -> j4166887130;
		j1201788462 -> j1478915251;
	j2234730044 [label="Add 3 to Thermostat counter",color=orange];
		j2234730044 -> j3354492096;
	j3916829358 [label="Add -3 to Thermostat counter",color=orange];
		j3916829358 -> j2242710821;
	j1904055667 [label="Ти маєш на увазі, що хотів замінити імператорів на Виконавців у своїй подобі.",shape=box,color=red];
		j1904055667 -> j2306053584;
	j4166887130 [label="І хто ж мав стати цим правителем?",shape=box,color=red];
		j4166887130 -> j2688315020;
	j3354492096 [label="Орокінська імперія не була цілковитим злом. Мені боляче, що руйнування і розпуста – це все, чим її запам’ятають. Так, їх було багато, я не заперечую цього.",shape=box,color=blue];
		j3354492096 -> j1092748073;
	j2242710821 [label="Якби тільки інші могли бачити це так само. Якби тільки Нітог бачила саме це. ",shape=box,color=blue];
		j2242710821 -> j3354492096;
	j2306053584 [label="Так, звичайно!",shape=box,color=blue];
		j2306053584 -> j1966581380;
	j2688315020 [label="Звичайно, що я.",shape=box,color=blue];
		j2688315020 -> j1966581380;
	j1092748073 [label="Але вона також було здатна на таку красу. Таку радість. Таке кохання. Такі наукові та мистецькі досягнення. Подивися, чого ми змогли досягти! ",shape=box,color=blue];
		j1092748073 -> j1164054790;
	j1966581380 [label="Я б гарантував, щоб усі Виконавці та імператори були… усунені, а я б узяв на себе обов’язки тимчасового Виконавця, доки не буде запроваджено нову систему.",shape=box,color=blue];
		j1966581380 -> j2002798169;
	j1164054790 [label="Тож коли Нітог викликала мене до себе й сказала, що хоче вбити всіх орокінів — я одразу погодився. Я хотів відрубати голову отруйному змію. Я хотів замінити його на милостивішу систему. Милостивішого правителя.",shape=box,color=blue];
		j1164054790 -> j2593559820;
		j1164054790 -> j2519170967;
	j2002798169 [label="Скільки б часу це зайняло, я не знаю, але це було б краще, ніж те, що сталося після Великої війни, чи не так?",shape=box,color=blue];
		j2002798169 -> j1934714902;
		j2002798169 -> j3997050824;
		j2002798169 -> j3838829708;
	j2593559820 [label="Ти маєш на увазі, що хотів замінити імператорів на Виконавців у своїй подобі.",shape=box,color=red];
		j2593559820 -> j3704106689;
	j2519170967 [label="І хто ж мав стати цим правителем?",shape=box,color=red];
		j2519170967 -> j2431994098;
	j1934714902 [label="Велика війна?",shape=box,color=red];
		j1934714902 -> j3161523705;
	j3997050824 [label="Будь чесним із собою, як ти вважаєш, ти б коли-небудь відмовився від влади?",shape=box,color=red];
		j3997050824 -> j2543155184;
	j3838829708 [label="Я не думаю, що ти б коли-небудь відмовився від влади, Роуте.",shape=box,color=red];
		j3838829708 -> j2422851101;
	j3704106689 [label="Так, звичайно! І не треба робити вигляду, ніби ми про це не говорили раніше, я впевнений, що говорили. ",shape=box,color=blue];
		j3704106689 -> j669679723;
	j2431994098 [label="Звичайно, що я! І не треба робити вигляду, ніби ми про це не говорили раніше, я впевнений, що говорили.",shape=box,color=blue];
		j2431994098 -> j669679723;
	j3161523705 [label="Ви називаєте це зараз «Давньою війною». Для мене вона аж ніяк не «давня», адже для мене вона сталася лише кілька років тому.",shape=box,color=blue];
		j3161523705 -> j2319562987;
	j2543155184 [label="Гм. Я не знаю. Це вже не має значення, чи не так? Але тоді я був повністю переконаний, що так і буде.",shape=box,color=blue];
		j2543155184 -> j2874944649;
	j2422851101 [label="+5 Chemistry",color=orange];
		j2422851101 -> j3064731807;
	j669679723 [label="Я б гарантував, щоб усі Виконавці та імператори були… усунені, а я б узяв на себе обов’язки тимчасового Виконавця, доки не буде запроваджено нову систему.",shape=box,color=blue];
		j669679723 -> j2666820057;
	j2319562987 [label="Подорожі в часі такі кумедні.",shape=box,color=blue];
		j2319562987 -> j2530148555;
	j2874944649 [label="Я так сильно прагнув повернутися сюди, тільки щоб зрозуміти, що… мій народ тепер мертвий. Я був би страчений разом із рештою.",shape=box,color=blue];
		j2874944649 -> j2676317265;
	j3064731807 [label="Ану тихо.",shape=box,color=blue];
		j3064731807 -> j1499470116;
	j2666820057 [label="Скільки б часу це зайняло, я не знаю, але це було б краще, ніж те, що сталося після Великої війни, чи не так?",shape=box,color=blue];
		j2666820057 -> j3997050824;
		j2666820057 -> j3838829708;
		j2666820057 -> j1934714902;
	j2530148555 [label="Всього за кілька років, за моїм досвідом, тисячі людей загинули в «реальності» — там, де розпалася імперія, а мій народ загинув. ",shape=box,color=blue];
		j2530148555 -> j917964478;
	j2676317265 [label="Тенно вбили б мене разом з усіма іншими в ніч барабанів наґа. Я, ймовірно, загинув би, намагаючись врятувати життя Нітог.",shape=box,color=blue];
		j2676317265 -> j2080668100;
	j1499470116 [label="Тоді я був повністю переконаний, що так і буде. Але зараз це вже не має значення, чи не так?",shape=box,color=blue];
		j1499470116 -> j2874944649;
	j917964478 [label="Я дійшов до усвідомлення, що не має значення, чи відмовився б я від влади, чи ні, хоча свого часу я був переконаний, що зроблю це.",shape=box,color=blue];
		j917964478 -> j2676317265;
	j2080668100 [label="Цікаво, що з нею сталося? У записах навіть не згадується її ім’я… всі жахи, скоєні від її імені, всі смерті, всі спотворення… і, можливо, я єдиний, хто про них знає.",shape=box,color=blue];
		j2080668100 -> j3177316446;
	j3177316446 [label="Що ж. Це, та все, що може бути розблоковано в майбутньому у спогадах тенно за допомогою Темного Спогадарія. Але це навряд чи моя проблема.",shape=box,color=blue];
		j3177316446 -> j1815846924;
		j3177316446 -> j3727553374;
		j3177316446 -> j2201757082;
	j1815846924 [label="Ти здаєшся трохи наляканим цим дитям.",shape=box,color=red];
		j1815846924 -> j2885502598;
	j3727553374 [label="Що сталося між тобою і Нітог?",shape=box,color=red];
		j3727553374 -> j3966961532;
	j2201757082 [label="То ти планував зрадити орокінів?",shape=box,color=red];
		j2201757082 -> j2959251895;
	j2885502598 [label="Я спостерігав, як зграя школярів, понівечених Порожнечею, дистанційно керувала зараженими бойовими машинами, які колись були солдатами, а тепер перетворилися на гротескні, прекрасні та вбивчі витвори мистецтва, що знищували цілі батальйони солдатів. ",shape=box,color=blue];
		j2885502598 -> j1693219857;
	j3966961532 [label="Усе.",shape=box,color=blue];
		j3966961532 -> j158748238;
	j2959251895 [label="Так. Ми обоє. Хоча я вважаю, що Нітог планувала зрадити мене, а я її. Ти ж знаєш, як це буває з нами, орокінами.",shape=box,color=blue];
		j2959251895 -> j990820048;
	j1693219857 [label="Я дізнався, що вони знищили мою імперію. Імперію, яка правила всією Материнською системою. І була готова знищити повстання на Тау.",shape=box,color=blue];
		j1693219857 -> j963132630;
	j158748238 [label="Між мною і Нітог сталося все.",shape=box,color=blue];
		j158748238 -> j1782352942;
	j990820048 [label="Усі завжди плетуть інтриги проти інших. Просто ще один звичайний день.",shape=box,color=blue];
		j990820048 -> j784153661;
	j963132630 [label="І вони зробили це за одну ніч.",shape=box,color=blue];
		j963132630 -> j1827973960;
	j1782352942 [label="Усе та навіть більше.",shape=box,color=blue];
		j1782352942 -> j659184410;
	j784153661 [label="Зради між орокінами та іншими були досить поширеним явищем. Але зрадити цілу імперію? Такий вид зради заслуговував не тільки на страту нефритовим світлом, але й на участь у програмі цефалонів.",shape=box,color=blue];
		j784153661 -> j1500183088;
	j1827973960 [label="А тебе б це не налякало?!",shape=box,color=blue];
		j1827973960 -> j4063439173;
	j659184410 [label="І це все, що я хотів би сказати з цього приводу на цю мить.",shape=box,color=blue];
		j659184410 -> j198168993;
	j1500183088 [label="Boolean RoatheTraitor1 is now true.",color=orange];
		j1500183088 -> j1601627901;
		j1500183088 -> j4123957697;
	j4063439173 [label="Я не можу висловити, чим ми ризикували, намагаючись убити Виконавців, не кажучи вже про всіх орокінів, узурпаторе.",shape=box,color=blue];
		j4063439173 -> j784153661;
	j198168993 [label="Boolean RoatheExecutor1 is now true.",color=orange];
		j198168993 -> j4063439173;
	j1601627901 [label="Яку з них ти вважав гіршу за інші?",shape=box,color=red];
		j1601627901 -> j741289461;
	j4123957697 [label="Тож таке покарання не було нормою?",shape=box,color=red];
		j4123957697 -> j1828417872;
	j741289461 [label="Безумовно, програму цефалонів Нігіла. Творіння Скляра…",shape=box,color=blue];
		j741289461 -> j2624467175;
	j1828417872 [label="Існування орокінської імперії балансувало на лезі кинджала, узурпаторе. Вона постійно була на межі знищення. Тільки одна річ дозволяла їй функціонувати —",shape=box,color=blue];
		j1828417872 -> j1762465830;
	j2624467175 [label="Нефритове світло швидко вбиває тих, хто не має броні або щитів. Це милосердна смерть.",shape=box,color=blue];
		j2624467175 -> j266101628;
	j1762465830 [label="Соціальні норми.",shape=box,color=blue];
		j1762465830 -> j3902067519;
	j266101628 [label="Перетворення на цефалонів з власної волі може бути безболісним і навіть неруйнівним. Однак… якщо використати його як покарання?",shape=box,color=blue];
		j266101628 -> j2493347106;
	j3902067519 [label="Не можна було просто так повстати та вбити орокінів! Це було просто неприпустимо, мандрівниче! Абсолютно нетактовно!",shape=box,color=blue];
		j3902067519 -> j288343561;
	j2493347106 [label="Спогади є священними для орокінів, мандрівниче. Зрештою, вони є всім, чим ми є. Наші тіла є тимчасовими. Наші обличчя, наші голоси, наша кров – все це мінливе. Все це можна змінити, як одяг.",shape=box,color=blue];
		j2493347106 -> j4186474857;
	j288343561 [label="Що, зрештою, зробило це комічно простим завданням. Як, я впевнений, дізналася твоя копія тенно. ",shape=box,color=blue];
		j288343561 -> j4159406263;
		j288343561 -> j341018651;
	j4186474857 [label="Check boolean RoatheKnowsReset2",color=orange];
		j4186474857 -> j1105952335 [label=true,color=green];
		j4186474857 -> j4159406263 [label=false,color=brown];
		j4186474857 -> j341018651 [label=false,color=brown];
	j4159406263 [label="Але ти явно не дійшов до того, щоб здійснити свою спробу.",shape=box,color=red];
		j4159406263 -> j2745098065;
	j341018651 [label="Що сталося з твоїм планом?",shape=box,color=red];
		j341018651 -> j652053828;
	j1105952335 [label="Що, до речі, ймовірно, є причиною того, що я так глибоко та абсолютно роздратований тим, що ти втручаєшся в їхні справи. ",shape=box,color=blue];
		j1105952335 -> j4159406263;
		j1105952335 -> j341018651;
	j2745098065 [label="Evaluate expressions on HellStory counter",color=orange];
		j2745098065 -> j1537058858 [label="x >= 21",color=purple];
		j2745098065 -> j2719481514 [label="x < 21",color=purple];
		j2745098065 -> j2719481514 [label="false",color=purple];
	j652053828 [label="Evaluate expressions on HellStory counter",color=orange];
		j652053828 -> j3718177225 [label="x >= 21",color=purple];
		j652053828 -> j2857650577 [label="x < 21",color=purple];
		j652053828 -> j2857650577 [label="false",color=purple];
	j1537058858 [label="Ти маєш рацію, це цілком очевидно! Альбрехт зустрів мене в тому коридорі, перш ніж ми з Нітог встигли влаштувати пастку для Виконавців.",shape=box,color=blue];
		j1537058858 -> j759565333;
	j2719481514 [label="Явно, що ні. Я був насильно перетворений на цю… істоту Альбрехтом, перш ніж ми з Нітог встигли влаштувати пастку для Виконавців.",shape=box,color=blue];
		j2719481514 -> j1436060248;
	j3718177225 [label="Ти ж добре знаєш, що сталося з нашим планом, чи не так?! Альбрехт зустрів мене в тому коридорі, перш ніж ми з Нітог встигли влаштувати пастку для Виконавців.",shape=box,color=blue];
		j3718177225 -> j3582878797;
	j2857650577 [label="Я був насильно перетворений на цю… істоту Альбрехтом, перш ніж ми з Нітог встигли влаштувати пастку для Виконавців.",shape=box,color=blue];
		j2857650577 -> j1436060248;
	j759565333 [label="І запропонував мені сироватку протофреймів. Ну… і… ми обоє знаємо, що сталося далі.",shape=box,color=blue];
		j759565333 -> j374895208;
	j1436060248 [label="В одну мить я стояв у великому золотому коридорі, а наступної — я кричав від болю в якійсь загубленій пекельній дірі в Ґоллі.",shape=box,color=blue];
		j1436060248 -> j2578397615;
	j3582878797 [label="Він запропонував мені сироватку протофреймів, і ми обоє знаємо, що сталося далі!",shape=box,color=blue];
		j3582878797 -> j374895208;
	j374895208 [label="Я досі залишаюся таким. Розлюченим. Чому?! Чому я тобі в цьому зізнався?! Чому ти це знаєш?! ",shape=box,color=blue];
		j374895208 -> j1171201613;
	j2578397615 [label="Нітог, мабуть, відмовилася від свого плану, коли я зник. Ймовірно, вона звалила всю цю зрадницьку справу на мене, як на зручного цапа-відбувайла.",shape=box,color=blue];
		j2578397615 -> j561008255;
	j1171201613 [label="Та! Ні. Неважливо. Я піду, поки не розбив цей клятий комп’ютер у приступі люті.",shape=box,color=blue];
		j1171201613 -> j1933300832;
	j561008255 [label="Це пояснює всі записи, які я знаходжу в архівах, де мене називають «боягузом». Звичайно, вони вважають мене боягузом — вони думають, що я втік! Пхе.",shape=box,color=blue];
		j561008255 -> j936467120;
	j1933300832 [label="+10 Chemistry",color=orange];
		j1933300832 -> "Chat ends.";
	j936467120 [label="+10 Chemistry",color=orange];
		j936467120 -> j799410387;
	j799410387 [label="Приємно знати, що я був настільки важливим для плану, що його довелося повністю скасувати, коли я пішов.",shape=box,color=blue];
		j799410387 -> j40518155;
		j799410387 -> j353818518;
	j40518155 [label="Не маю впевненості, що саме це головний урок, який варто винести з цього.",shape=box,color=red];
		j40518155 -> j3127190187;
	j353818518 [label="Приємно відчувати себе потрібним.",shape=box,color=red];
		j353818518 -> j2337453163;
	j3127190187 [label="Add 1 to Thermostat counter",color=orange];
		j3127190187 -> j2897503176;
	j2337453163 [label="+5 Chemistry",color=orange];
		j2337453163 -> j1248771866;
	j2897503176 [label="Знайди свою цінність там, де тобі подобається, мандрівниче, а мені дозволь знайти свою.",shape=box,color=blue];
