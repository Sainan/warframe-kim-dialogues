		1226 -> 1229 [label=true,color=green];
		1226 -> 1228 [label=false,color=brown];
	1227 [label="Chat ends.",color=orange];
	1229 [label="Як багато колишній Роут розповів тобі про свої стосунки з Виконавицею Нітог? Намагаюся змиритися з тим, що колишній я повідав тобі таку особисту інформацію… лише для того, щоб ці спогади були повністю стерті?",shape=box,color=blue];
		1229 -> 1232;
	1228 [label="Evaluate expressions on HellStory",color=orange];
		1228 -> 1231 [label="x >= 1",color=purple];
		1228 -> 1230 [label="x <= 1",color=purple];
		1228 -> 1230 [label="false",color=purple];
	1232 [label="Це випалює в мені дірку. Те, що я міг би розповісти тобі все, абсолютно все — відкрити перед тобою найпотаємніші куточки своєї душі, а ти… знову все зітреш. Ніби я для тебе лише маленька іграшка.",shape=box,color=blue];
		1232 -> 1234;
	1231 [label="Тобі вже відомо про Виконавицю Нітог, про яку я згадував. І мої… стосунки з нею. Тобі потрібно зрозуміти, що орокінська імперія не була цілковитим злом.",shape=box,color=blue];
		1231 -> 1233;
	1230 [label="Chat ends.",color=orange];
	1234 [label="Я вважаю, що це справедливо. Ось так ми, орокіни, ставилися до людства, чи не так? Юванський театр? Виставляючи напоказ тіла й вибираючи собі нових себе за власним бажанням, катуючи одне одного іграми для хворих розваг, як нам заманеться…",shape=box,color=blue];
		1234 -> 1236;
	1233 [label="Мені боляче, що руйнування і розпуста – це все, чим її запам’ятають. Так їх була багато, я не заперечую цього. ",shape=box,color=blue];
		1233 -> 1235;
	1236 [label="Я ненавиджу це. Ненавиджу дуже, дуже сильно.",shape=box,color=blue];
		1236 -> 1239;
		1236 -> 1240;
		1236 -> 1238;
	1235 [label="Але вона також було здатна на таку красу. Таку радість. Таке кохання. Такі наукові та мистецькі досягнення. Подивися, чого ми змогли досягти! ",shape=box,color=blue];
		1235 -> 1237;
	1239 [label="В мене не було наміру так тебе образити, і мені шкода, що так сталося, але якщо це навчило тебе, як це бути на іншому боці орокінської імперії, то це цінний урок.",shape=box,color=red];
		1239 -> 1245;
	1240 [label="В мене ніколи не було наміру, щоб це так тебе образило. Тобі не потрібно вибачатися за те, як функціонувало орокінське суспільство, ти його не створював. Ти намагався його врятувати.",shape=box,color=red];
		1240 -> 1246;
	1238 [label="[Завершити розмову]",shape=box,color=red];
		1238 -> 1244;
	1237 [label="Тож коли Нітог викликала мене до себе й сказала, що хоче вбити всіх орокінів — я одразу погодився. Я хотів відрубати голову отруйному змію. Я хотів замінити його на милостивішу систему. Милостивішого правителя.",shape=box,color=blue];
		1237 -> 1241;
		1237 -> 1242;
		1237 -> 1243;
	1245 [label="Add 3 to Thermostat",color=orange];
		1245 -> 1250;
	1246 [label="Add -3 to Thermostat",color=orange];
		1246 -> 1251;
	1244 [label="Chat ends.",color=orange];
	1241 [label="Ти маєш на увазі, що хотів замінити імператорів на Виконавців у своїй подобі.",shape=box,color=red];
		1241 -> 1247;
	1242 [label="І хто ж мав стати цим правителем?",shape=box,color=red];
		1242 -> 1248;
	1243 [label="[Завершити розмову]",shape=box,color=red];
		1243 -> 1249;
	1250 [label="Орокінська імперія не була цілковитим злом. Мені боляче, що руйнування і розпуста – це все, чим її запам’ятають. Так їх була багато, я не заперечую цього.",shape=box,color=blue];
		1250 -> 1253;
	1251 [label="Якби тільки інші могли бачити це так само. Якби тільки Нітог бачила саме це. ",shape=box,color=blue];
		1251 -> 1254;
	1247 [label="Так, звичайно!",shape=box,color=blue];
		1247 -> 1252;
	1248 [label="Звичайно, що я.",shape=box,color=blue];
		1248 -> 1252;
	1249 [label="Chat ends.",color=orange];
	1253 [label="Але вона також було здатна на таку красу. Таку радість. Таке кохання. Такі наукові та мистецькі досягнення. Подивися, чого ми змогли досягти! ",shape=box,color=blue];
		1253 -> 1256;
	1254 [label="Орокінська імперія не була цілковитим злом. Мені боляче, що руйнування і розпуста – це все, чим її запам’ятають. Так їх була багато, я не заперечую цього.",shape=box,color=blue];
		1254 -> 1253;
	1252 [label="Я б гарантував, щоб усі Виконавці та імператори були… усунені, а я б узяв на себе обов’язки тимчасового Виконавця, доки не буде запроваджено нову систему.",shape=box,color=blue];
		1252 -> 1255;
	1256 [label="Тож коли Нітог викликала мене до себе й сказала, що хоче вбити всіх орокінів — я одразу погодився. Я хотів відрубати голову отруйному змію. Я хотів замінити його на милостивішу систему. Милостивішого правителя.",shape=box,color=blue];
		1256 -> 1260;
		1256 -> 1261;
	1255 [label="Скільки б часу це зайняло, я не знаю, але це було б краще, ніж те, що сталося після Великої війни, чи не так?",shape=box,color=blue];
		1255 -> 1257;
		1255 -> 1258;
		1255 -> 1259;
	1260 [label="Ти маєш на увазі, що хотів замінити імператорів на Виконавців у своїй подобі.",shape=box,color=red];
		1260 -> 1265;
	1261 [label="І хто ж мав стати цим правителем?",shape=box,color=red];
		1261 -> 1266;
	1257 [label="Велика війна?",shape=box,color=red];
		1257 -> 1262;
	1258 [label="Будь чесним із собою, як ти вважаєш, ти б коли-небудь відмовився від влади?",shape=box,color=red];
		1258 -> 1263;
	1259 [label="Я не думаю, що ти б коли-небудь відмовився від влади, Роуте.",shape=box,color=red];
		1259 -> 1264;
	1265 [label="Так, звичайно! І не треба робити вигляду, ніби ми про це не говорили раніше, я впевнений, що говорили. ",shape=box,color=blue];
		1265 -> 1270;
	1266 [label="Звичайно, що я! І не треба робити вигляду, ніби ми про це не говорили раніше, я впевнений, що говорили.",shape=box,color=blue];
		1266 -> 1270;
	1262 [label="Ви називаєте це зараз «Давньою війною». Для мене вона аж ніяк не «давня», адже для мене вона сталася лише кілька років тому.",shape=box,color=blue];
		1262 -> 1267;
	1263 [label="Гм. Я не знаю. Це вже не має значення, чи не так? Але тоді я був повністю переконаний, що так і буде.",shape=box,color=blue];
		1263 -> 1268;
	1264 [label="+5 Chemistry",color=orange];
		1264 -> 1269;
	1270 [label="Я б гарантував, щоб усі Виконавці та імператори були… усунені, а я б узяв на себе обов’язки тимчасового Виконавця, доки не буде запроваджено нову систему.",shape=box,color=blue];
		1270 -> 1274;
	1267 [label="Подорожі в часі такі кумедні.",shape=box,color=blue];
		1267 -> 1271;
	1268 [label="Я так сильно прагнув повернутися сюди, тільки щоб зрозуміти, що… мій народ тепер мертвий. Я був би страчений разом із рештою.",shape=box,color=blue];
		1268 -> 1272;
	1269 [label="Ану тихо.",shape=box,color=blue];
		1269 -> 1273;
	1274 [label="Скільки б часу це зайняло, я не знаю, але це було б краще, ніж те, що сталося після Великої війни, чи не так?",shape=box,color=blue];
		1274 -> 1258;
		1274 -> 1259;
		1274 -> 1257;
	1271 [label="Всього за кілька років, за моїм досвідом, тисячі людей загинули в «реальності» — там, де розпалася імперія, а мій народ загинув. ",shape=box,color=blue];
		1271 -> 5775;
	1272 [label="Тенно вбили б мене разом з усіма іншими в ніч барабанів наґа. Я, ймовірно, загинув би, намагаючись врятувати життя Нітог.",shape=box,color=blue];
		1272 -> 1275;
	1273 [label="Тоді я був повністю переконаний, що так і буде. Але зараз це вже не має значення, чи не так?",shape=box,color=blue];
		1273 -> 1268;
	5775 [label="I have come to realize that it does not matter if I would have surrendered power or not, though in the time I was convinced I would.",shape=box,color=blue];
		5775 -> 1272;
	1275 [label="Цікаво, що з нею сталося? У записах навіть не згадується її ім’я… всі жахи, скоєні від її імені, всі смерті, всі спотворення… і, можливо, я єдиний, хто про них знає.",shape=box,color=blue];
		1275 -> 1276;
	1276 [label="Що ж. Це, та все, що може бути розблоковано в майбутньому у спогадах тенно за допомогою Темного Спогадарія. Але це навряд чи моя проблема.",shape=box,color=blue];
		1276 -> 1277;
		1276 -> 1278;
		1276 -> 1279;
	1277 [label="Ти здаєшся трохи наляканим цим дитям.",shape=box,color=red];
		1277 -> 1280;
	1278 [label="Що сталося між тобою і Нітог?",shape=box,color=red];
		1278 -> 1281;
	1279 [label="То ти планував зрадити орокінів?",shape=box,color=red];
		1279 -> 1282;
	1280 [label="Я спостерігав, як зграя школярів, понівечених Порожнечею, дистанційно керувала зараженими бойовими машинами, які колись були солдатами, а тепер перетворилися на гротескні, прекрасні та вбивчі витвори мистецтва, що знищували цілі батальйони солдатів. ",shape=box,color=blue];
		1280 -> 1283;
	1281 [label="Усе.",shape=box,color=blue];
		1281 -> 1284;
	1282 [label="Так. Ми обоє. Хоча я вважаю, що Нітог планувала зрадити мене, а я її. Ти ж знаєш, як це буває з нами, орокінами.",shape=box,color=blue];
		1282 -> 1285;
	1283 [label="Я дізнався, що вони знищили мою імперію. Імперію, яка правила всією Материнською системою. І була готова знищити повстання на Тау.",shape=box,color=blue];
		1283 -> 1286;
	1284 [label="Між мною і Нітог сталося все.",shape=box,color=blue];
		1284 -> 1287;
	1285 [label="Усі завжди плетуть інтриги проти інших. Просто ще один звичайний день.",shape=box,color=blue];
		1285 -> 1288;
	1286 [label="І вони зробили це за одну ніч.",shape=box,color=blue];
		1286 -> 1289;
	1287 [label="Усе та навіть більше.",shape=box,color=blue];
		1287 -> 1290;
	1288 [label="Зради між орокінами та іншими були досить поширеним явищем. Але зрадити цілу імперію? Такий вид зради заслуговував не тільки на страту нефритовим світлом, але й на участь у програмі цефалонів.",shape=box,color=blue];
		1288 -> 1291;
	1289 [label="А тебе б це не налякало?!",shape=box,color=blue];
		1289 -> 1292;
	1290 [label="І це все, що я хотів би сказати з цього приводу на цю мить.",shape=box,color=blue];
		1290 -> 1293;
	1291 [label="Update boolean RoatheTraitor1",color=orange];
		1291 -> 1294;
		1291 -> 1295;
	1292 [label="Я не можу висловити, чим ми ризикували, намагаючись убити Виконавців, не кажучи вже про всіх орокінів, узурпаторе.",shape=box,color=blue];
		1292 -> 1288;
	1293 [label="Update boolean RoatheExecutor1",color=orange];
		1293 -> 1292;
	1294 [label="Яку з них ти вважав гіршу за інші?",shape=box,color=red];
		1294 -> 1296;
	1295 [label="Тож таке покарання не було нормою?",shape=box,color=red];
		1295 -> 1297;
	1296 [label="Безумовно, програму цефалонів Нігіла. Творіння Скляра…",shape=box,color=blue];
		1296 -> 1298;
	1297 [label="Існування орокінської імперії балансувало на лезі кинджала, узурпаторе. Вона постійно була на межі знищення. Тільки одна річ дозволяла їй функціонувати —",shape=box,color=blue];
		1297 -> 1299;
	1298 [label="Нефритове світло швидко вбиває тих, хто не має броні або щитів. Це милосердна смерть.",shape=box,color=blue];
		1298 -> 1300;
	1299 [label="Соціальні норми.",shape=box,color=blue];
		1299 -> 1301;
	1300 [label="Перетворення на цефалонів з власної волі може бути безболісним і навіть неруйнівним. Однак… якщо використати його як покарання?",shape=box,color=blue];
		1300 -> 1302;
	1301 [label="Не можна було просто так повстати та вбити орокінів! Це було просто неприпустимо, мандрівниче! Абсолютно нетактовно!",shape=box,color=blue];
		1301 -> 1303;
	1302 [label="Спогади є священними для орокінів, мандрівниче. Зрештою, вони є всім, чим ми є. Наші тіла є тимчасовими. Наші обличчя, наші голоси, наша кров – все це мінливе. Все це можна змінити, як одяг.",shape=box,color=blue];
		1302 -> 1304;
	1303 [label="Що, зрештою, зробило це комічно простим завданням. Як, я впевнений, дізналася твоя копія тенно. ",shape=box,color=blue];
		1303 -> 1305;
		1303 -> 1306;
	1304 [label="Check boolean RoatheKnowsReset2",color=orange];
		1304 -> 1307 [label=true,color=green];
		1304 -> 1305 [label=false,color=brown];
		1304 -> 1306 [label=false,color=brown];
	1305 [label="Але ти явно не дійшов до того, щоб здійснити свою спробу.",shape=box,color=red];
		1305 -> 1308;
	1306 [label="Що сталося з твоїм планом?",shape=box,color=red];
		1306 -> 1309;
	1307 [label="Що, до речі, ймовірно, є причиною того, що я так глибоко та абсолютно роздратований тим, що ти втручаєшся в їхні справи. ",shape=box,color=blue];
		1307 -> 1305;
		1307 -> 1306;
	1308 [label="Evaluate expressions on HellStory",color=orange];
		1308 -> 1310 [label="x >= 21",color=purple];
		1308 -> 1311 [label="x < 21",color=purple];
		1308 -> 1311 [label="false",color=purple];
	1309 [label="Evaluate expressions on HellStory",color=orange];
		1309 -> 1312 [label="x >= 21",color=purple];
		1309 -> 5777 [label="x < 21",color=purple];
		1309 -> 5777 [label="false",color=purple];
	1310 [label="Ти маєш рацію, це цілком очевидно! Альбрехт зустрів мене в тому коридорі, перш ніж ми з Нітог встигли влаштувати пастку для Виконавців.",shape=box,color=blue];
		1310 -> 1313;
	1311 [label="Явно, що ні. Я був насильно перетворений на цю… істоту Альбрехтом, перш ніж ми з Нітог встигли влаштувати пастку для Виконавців.",shape=box,color=blue];
		1311 -> 1314;
	1312 [label="Ти ж добре знаєш, що сталося з нашим планом, чи не так?! Альбрехт зустрів мене в тому коридорі, перш ніж ми з Нітог встигли влаштувати пастку для Виконавців.",shape=box,color=blue];
		1312 -> 1315;
	5777 [label="I was forcibly turned into this... thing by Albrecht before Nitokh and I had time to spring our trap for the Executors.",shape=box,color=blue];
		5777 -> 1314;
	1313 [label="І запропонував мені сироватку протофреймів. Ну… і… ми обоє знаємо, що сталося далі.",shape=box,color=blue];
		1313 -> 1316;
	1314 [label="В одну мить я стояв у великому золотому коридорі, а наступної — я кричав від болю в якійсь загубленій пекельній дірі в Ґоллі.",shape=box,color=blue];
		1314 -> 1317;
	1315 [label="Він запропонував мені сироватку протофреймів, і ми обоє знаємо, що сталося далі!",shape=box,color=blue];
		1315 -> 1316;
	1316 [label="Я досі залишаюся таким. Розлюченим. Чому?! Чому я тобі в цьому зізнався?! Чому ти це знаєш?! ",shape=box,color=blue];
		1316 -> 1318;
	1317 [label="Нітог, мабуть, відмовилася від свого плану, коли я зник. Ймовірно, вона звалила всю цю зрадницьку справу на мене, як на зручного цапа-відбувайла.",shape=box,color=blue];
		1317 -> 1319;
	1318 [label="Та! Ні. Неважливо. Я піду, поки не розбив цей клятий комп’ютер у приступі люті.",shape=box,color=blue];
		1318 -> 1320;
	1319 [label="Це пояснює всі записи, які я знаходжу в архівах, де мене називають «боягузом». Звичайно, вони вважають мене боягузом — вони думають, що я втік! Пхе.",shape=box,color=blue];
		1319 -> 1321;
	1320 [label="+10 Chemistry",color=orange];
		1320 -> 1322;
	1321 [label="+10 Chemistry",color=orange];
		1321 -> 1323;
	1322 [label="Chat ends.",color=orange];
	1323 [label="Приємно знати, що я був настільки важливим для плану, що його довелося повністю скасувати, коли я пішов.",shape=box,color=blue];
		1323 -> 1324;
		1323 -> 1325;
	1324 [label="Не маю впевненості, що саме це головний урок, який варто винести з цього.",shape=box,color=red];
		1324 -> 1326;
	1325 [label="Приємно відчувати себе потрібним.",shape=box,color=red];
		1325 -> 1327;
