	j1326969999 [label="Будь-яка інша людина з менш цілеспрямованим поглядом на життя може побачити твою власну… підприємницьку поведінку у менш сприятливому світлі.",shape=box,color=blue];
		j1326969999 -> j3334616278;
		j1326969999 -> j2307839071;
	j3790717707 [label="Будь-яка інша людина з менш цілеспрямованим поглядом на життя може побачити твою власну… підприємницьку поведінку у менш сприятливому світлі.",shape=box,color=blue];
		j3790717707 -> j1662774671;
		j3790717707 -> j1464600621;
	j3735104197 [label="Ти виконуєш його волю, зцілюючи розбиті родини й порожні серця, куди б не йшов. Якби я не знав, що ти справді відчуваєш, я б подумав, що ти береш плату плоттю. Моєю плоттю, зокрема.",shape=box,color=blue];
		j3735104197 -> j1542393229;
	j1843859398 [label="Ти виконуєш його волю, скрізь зцілюєш розбиті родини й порожні серця. Але ж ти береш плату, чи не так? Плоттю. Моєю плоттю.",shape=box,color=blue];
		j1843859398 -> j1638682625;
	j2452460134 [label="Будь-яка інша людина з менш цілеспрямованим поглядом на життя може побачити твою власну… підприємницьку поведінку у менш сприятливому світлі.",shape=box,color=blue];
		j2452460134 -> j1978310287;
		j2452460134 -> j3024578882;
	j189763037 [label="Це жахливий спосіб зіпсувати гру — брехати про щось таке, мандрівниче! Я…",shape=box,color=blue];
		j189763037 -> j1301903828;
	j235531930 [label="Через твою помилку в резервуар Фібоначчі залито загущувач?",shape=box,color=blue];
		j235531930 -> j2625852461;
	j1656191345 [label="В очікуванні на наступний сигнал від Альбрехта.",shape=box,color=blue];
		j1656191345 -> j1144406450;
	j1977672697 [label="І справді, ми навіть угоду уклали, щоб тобі точно вдалося завоювати мою прихильність.",shape=box,color=blue];
		j1977672697 -> j1084580559;
	j4095683665 [label="В очікуванні на наступний сигнал від Альбрехта.",shape=box,color=blue];
		j4095683665 -> j2871319503;
	j74626114 [label="І як тобі й здавалося раніше, зараз ти в куті разом із обраною здобиччю — Марі. Чи не так, узурпаторе? Але це не важливо. Диявол урятує тебе, згідно з нашою угодою.",shape=box,color=blue];
		j74626114 -> j3066230212;
		j74626114 -> j3455851223;
		j74626114 -> j1940828498;
	j1276498172 [label="І як тобі й здавалося раніше, зараз ти в куті разом із обраною здобиччю — Ліоном (хоча я чесно не знаю, як тобі це вдалося). Чи не так, узурпаторе? Але це не важливо. Диявол урятує тебе, згідно з нашою угодою.",shape=box,color=blue];
		j1276498172 -> j2455842049;
		j1276498172 -> j2892969525;
		j1276498172 -> j2703628426;
	j3334616278 [label="Але не ти?",shape=box,color=red];
		j3334616278 -> j618855334;
	j2307839071 [label="Ти натякаєш, що мої почуття до неї не справжні. Ти зовсім не такий, як раніше.",shape=box,color=red];
		j2307839071 -> j1846587685;
	j1662774671 [label="Але не ти?",shape=box,color=red];
		j1662774671 -> j1080341165;
	j1464600621 [label="Ти натякаєш, що мої почуття до нього не справжні. Ти зовсім не такий, як раніше.",shape=box,color=red];
		j1464600621 -> j1368399612;
	j1542393229 [label="Якби я не знав твоїх справжніх мотивів, то сидів би тут і аплодував за твій підприємницький дух. Уміння максимально використати свою ситуацію тощо. Але що насправді тебе надихнуло? Кохання? Мені важко бути у своєму звичному їдкому настрої.",shape=box,color=blue];
		j1542393229 -> j3564993221;
		j1542393229 -> j492211800;
		j1542393229 -> j223501850;
