	j2497364590 [label="Гм?",shape=box,color=blue];
		j2497364590 -> j1826033191;
	j969956706 [label="Що ж до твоїх попередніх зобов’язань? Чесність і згода є ключовими в усьому в житті, узурпаторе, але ти ж це знаєш. ",shape=box,color=blue];
		j969956706 -> j2625292970;
	j545659898 [label="О-о, не сприймай мою розвагу за глузування. Насолоджуйся життєвим меню як заманеться, узурпаторе. Це моє гасло.",shape=box,color=blue];
		j545659898 -> j4144641739;
	j2697321327 [label="Жодної. Насолоджуйся життєвим меню як заманеться, узурпаторе. Це моє гасло.",shape=box,color=blue];
		j2697321327 -> j4144641739;
	j2928066547 [label="Вибач. Будь ласка, вибач. Я не знав.",shape=box,color=blue];
		j2928066547 -> j3218445067;
	j3565739079 [label="Я здаюся. Що ти хочеш сказати мені, мандрівниче?",shape=box,color=blue];
