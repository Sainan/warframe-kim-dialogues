	j1368399612 [label="О? То ти натякаєш, що справді відчуваєш до нього щось справжнє? Справжнє співчуття? Будь ласка, не сміши.",shape=box,color=blue];
		j1368399612 -> j2945675868;
	j3564993221 [label="Сподіваюся, ти не сумніваєшся в моїй любові до тебе.",shape=box,color=red];
