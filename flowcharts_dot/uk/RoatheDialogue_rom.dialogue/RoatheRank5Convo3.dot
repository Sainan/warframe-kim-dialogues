		j2703628426 -> j4238361143;
	j618855334 [label="Та ні! Я б тобі аплодував, якби ми сиділи в одній кімнаті, мандрівниче. Ти просто використовуєш свою ситуацію якнайкраще.",shape=box,color=blue];
		j618855334 -> j1721645290;
	j1846587685 [label="О? То ти натякаєш, що справді відчуваєш до неї щось справжнє? Справжнє співчуття? Будь ласка, не сміши.",shape=box,color=blue];
		j1846587685 -> j1684560163;
	j1080341165 [label="Та ні! Я б тобі аплодував, якби ми сиділи в одній кімнаті, мандрівниче. Ти просто використовуєш свою ситуацію якнайкраще.",shape=box,color=blue];
