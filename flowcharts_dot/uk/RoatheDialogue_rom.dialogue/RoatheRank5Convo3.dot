		j4216041166 -> j235531930;
	j2137467100 [label="Перш ніж ти відповіси, я не хочу знати відповіді, любове. Бо я не хочу знати, чи не був я твоєю цільовою здобиччю. Або просто тим, що тобі підійшло.",shape=box,color=blue];
		j2137467100 -> j1656191345;
	j3010716761 [label="Ти виконуєш його волю, скрізь зцілюєш розбиті родини й порожні серця. Але ж ти береш плату, чи не так? Плоттю. Моєю плоттю.",shape=box,color=blue];
		j3010716761 -> j1977672697;
	j2456811243 [label="Перш ніж ти відповіси, я не хочу знати відповіді, любове. Бо я не хочу знати, чи не був я твоєю цільовою здобиччю. Або просто тим, що тобі підійшло.",shape=box,color=blue];
