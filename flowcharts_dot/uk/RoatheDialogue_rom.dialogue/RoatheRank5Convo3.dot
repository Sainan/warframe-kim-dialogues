		j3565739079 -> j2014992510;
	j3127189685 [label="Ти також маєш зрозуміти, що досі моє кохання було товаром, на який ніхто не намагався претендувати. Жодним осмисленим чином.",shape=box,color=blue];
		j3127189685 -> j2766436153;
