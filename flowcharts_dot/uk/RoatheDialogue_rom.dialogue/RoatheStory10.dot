	j4026484555 [label="ПОКАРАННЯ",shape=box,color=blue];
		j4026484555 -> j3762937298;
	j3762937298 [label="Витяг: Ще задовго до війни План запропонував Скарн — інтелектуальний, дратівливий і в’їдливий. «Ми повинні покинути гніздо, бо воно палає вогнем».",shape=box,color=blue];
		j3762937298 -> j472118177;
	j472118177 [label="Займаючись надмірним використанням та бездумними експериментами, ми занапастили систему до точки неповернення, без надії на відновлення.",shape=box,color=blue];
		j472118177 -> j3696346697;
	j3696346697 [label="Пошук нових обріїв став для нас єдиною надією. ",shape=box,color=blue];
		j3696346697 -> j939432655;
	j939432655 [label="Це він заснував боягузливі Вежі в Порожнечі.",shape=box,color=blue];
		j939432655 -> j657750198;
	j657750198 [label="У ньому був настільки великий страх перед поверненням свідомих, що він бачив лише можливість утечі — на острови в порожньому морі.",shape=box,color=blue];
		j657750198 -> j666680446;
	j666680446 [label="Ми не віддавали достатньо належного відвазі свідомих.",shape=box,color=blue];
		j666680446 -> j4093999406;
	j4093999406 [label="Вони добровільно зносили пекуче полум’я Порожнечі лише заради можливості нас покарати.",shape=box,color=blue];
		j4093999406 -> j921430358;
	j921430358 [label="Add 1 to HellStory counter",color=orange];
		j921430358 -> "Chat ends.";
