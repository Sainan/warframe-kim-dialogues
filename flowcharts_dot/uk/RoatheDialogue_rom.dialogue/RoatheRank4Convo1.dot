	2366 [label="[Завершити розмову]",shape=box,color=red];
		2366 -> 2371;
	2364 [label="Ха, на ті! У тебе величезне терпіння, якщо ти вважаєш, що я стільки днів прямо ображаю тебе. ",shape=box,color=blue];
		2364 -> 2370;
	2365 [label="Chat ends.",color=orange];
	2367 [label="Але це ж ти, правда? Тенно узурпували Материнську систему орокінів. А тебе, як зозуленя в гніздо, підкинули у цей світ зі свого власного.",shape=box,color=blue];
