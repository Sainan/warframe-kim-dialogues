		2373 -> 2379 [label=false,color=brown];
	2374 [label="Бо це титул і є. Почесне звання. Тобі вдалося зробити те, до чого я прагнув. ",shape=box,color=blue];
		2374 -> 2381;
	2375 [label="Особливо коли так болісно очевидно, що ти маєш стільки влади в цій ситуації, яку навряд можна назвати односторонньою, правда ж?",shape=box,color=blue];
		2375 -> 2382;
	2376 [label="Особливо коли я знаю, що ти можеш скористатися силою Порожнечі, щоби пройти крізь стіну й вистрелити мені в потилицю коли забажаєш.",shape=box,color=blue];
		2376 -> 2382;
	2377 [label="Тож… це образа.",shape=box,color=red];
		2377 -> 2368;
	2378 [label="Гаразд. До для чого ти мені даєш цей титул?",shape=box,color=red];
		2378 -> 2383;
	2380 [label="Особливо коли так болісно очевидно, що ти маєш стільки влади в цій ситуації, яку навряд можна назвати односторонньою, правда ж?",shape=box,color=blue];
		2380 -> 2384;
	2379 [label="Особливо коли я знаю, що ти можеш скористатися силою Порожнечі, щоби пройти крізь стіну й вистрелити мені в потилицю коли забажаєш.",shape=box,color=blue];
		2379 -> 2384;
	2381 [label="Цей титул — просто вираз мого легкого захоплення. Навіть якщо він досить саркастичний, щоб задовольнити мої потреби, я приймаю його.",shape=box,color=blue];
		2381 -> 2385;
		2381 -> 2386;
		2381 -> 2387;
		2381 -> 2388;
	2382 [label="Я не маю жодного бажання робити з тебе ворога, узурпаторе. Ні. Це не образа. Лише через власну недбалість ти не усвідомлюєш, що значна частина мого минулого збігається з твоїм.",shape=box,color=blue];
		2382 -> 2389;
	2383 [label="+5 Chemistry",color=orange];
		2383 -> 2374;
	2384 [label="Я не маю жодного бажання робити з тебе ворога, узурпаторе. Ні. Це почесть. Тобі вдалося зробити те, чого я прагнув. Ось і все.",shape=box,color=blue];
