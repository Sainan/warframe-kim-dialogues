		j2744256673 -> j3165232570;
	j1660862430 [label="Просто дико чути таке від тебе, якщо це образа, бо ти винен у тому ж.",shape=box,color=red];
		j1660862430 -> j1269687606;
	j2475034198 [label="Просто намагаюся зрозуміти, чому ти продовжуєш мене називати цим титулом.",shape=box,color=red];
		j2475034198 -> j2945145857;
	j2497511878 [label="Ха, на ті! У тебе величезне терпіння, якщо ти вважаєш, що я стільки днів прямо ображаю тебе. ",shape=box,color=blue];
		j2497511878 -> j2389195802;
	j3165232570 [label="Але це ж ти, правда? Тенно узурпували Материнську систему орокінів. А тебе, як зозуленя в гніздо, підкинули у цей світ зі свого власного.",shape=box,color=blue];
		j3165232570 -> j1421897360;
	j1269687606 [label="Ха, образа? У тебе величезне терпіння, якщо ти вважаєш, що я стільки днів прямо ображаю тебе.",shape=box,color=blue];
		j1269687606 -> j1583718725;
	j2945145857 [label="+5 Chemistry",color=orange];
		j2945145857 -> j2317207485;
	j2389195802 [label="Check boolean RoatheKnowsReset2",color=orange];
		j2389195802 -> j1224484982 [label=true,color=green];
		j2389195802 -> j3488899545 [label=false,color=brown];
	j1421897360 [label="І це робить тебе узурпатором принаймні за двома пунктами з мого списку. І, можливо, за трьома, якщо враховувати те, що дворецький розповів мені про Дувірі, але це тема для окремої розмови.",shape=box,color=blue];
		j1421897360 -> j3019911284;
		j1421897360 -> j152155959;
	j1583718725 [label="Check boolean RoatheKnowsReset2",color=orange];
		j1583718725 -> j2504500035 [label=true,color=green];
		j1583718725 -> j2866346453 [label=false,color=brown];
	j2317207485 [label="Бо це титул і є. Почесне звання. Тобі вдалося зробити те, до чого я прагнув. ",shape=box,color=blue];
		j2317207485 -> j284455375;
	j1224484982 [label="Особливо коли так болісно очевидно, що ти маєш стільки влади в цій ситуації, яку навряд можна назвати односторонньою, правда ж?",shape=box,color=blue];
		j1224484982 -> j2422268326;
	j3488899545 [label="Особливо коли я знаю, що ти можеш скористатися силою Порожнечі, щоби пройти крізь стіну й вистрелити мені в потилицю коли забажаєш.",shape=box,color=blue];
		j3488899545 -> j2422268326;
	j3019911284 [label="Тож… це образа.",shape=box,color=red];
		j3019911284 -> j1269687606;
	j152155959 [label="Гаразд. До для чого ти мені даєш цей титул?",shape=box,color=red];
		j152155959 -> j2945145857;
	j2504500035 [label="Особливо коли так болісно очевидно, що ти маєш стільки влади в цій ситуації, яку навряд можна назвати односторонньою, правда ж?",shape=box,color=blue];
		j2504500035 -> j3942662167;
	j2866346453 [label="Особливо коли я знаю, що ти можеш скористатися силою Порожнечі, щоби пройти крізь стіну й вистрелити мені в потилицю коли забажаєш.",shape=box,color=blue];
		j2866346453 -> j3942662167;
	j284455375 [label="Цей титул — просто вираз мого легкого захоплення. Навіть якщо він досить саркастичний, щоб задовольнити мої потреби, я приймаю його.",shape=box,color=blue];
		j284455375 -> j2519956832;
		j284455375 -> j2774439023;
		j284455375 -> j2450353582;
		j284455375 -> j1872384386;
	j2422268326 [label="Я не маю жодного бажання робити з тебе ворога, узурпаторе. Ні. Це не образа. Лише через власну недбалість ти не усвідомлюєш, що значна частина мого минулого збігається з твоїм.",shape=box,color=blue];
		j2422268326 -> j1052835623;
	j3942662167 [label="Я не маю жодного бажання робити з тебе ворога, узурпаторе. Ні. Це почесть. Тобі вдалося зробити те, чого я прагнув. Ось і все.",shape=box,color=blue];
		j3942662167 -> j284455375;
	j2519956832 [label="Усі орокіни були схожі на тебе?",shape=box,color=red];
		j2519956832 -> j450174159;
	j2774439023 [label="А якщо я ввічливо попрошу називати мене якось інакше, погодишся?",shape=box,color=red];
		j2774439023 -> j2436136795;
	j2450353582 [label="Я з цим змирюся.",shape=box,color=red];
		j2450353582 -> j1361761450;
	j1872384386 [label="Перестань називати мене узурпатором.",shape=box,color=red];
		j1872384386 -> j1927467826;
	j1052835623 [label="Я мав намір скинути орокінів, так само як твого дитячого двійника тенно та подібних. Мене просто заарештували в тій часові лінії, перш ніж я отримав нагоду.",shape=box,color=blue];
		j1052835623 -> j571428348;
	j450174159 [label="+10 Chemistry",color=orange];
		j450174159 -> j812521753;
	j2436136795 [label="+5 Chemistry",color=orange];
		j2436136795 -> j1656159258;
