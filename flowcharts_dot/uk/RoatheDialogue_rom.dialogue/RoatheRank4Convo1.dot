		2370 -> 2376 [label=false,color=brown];
	2372 [label="І це робить тебе узурпатором принаймні за двома пунктами з мого списку. І, можливо, за трьома, якщо враховувати те, що дворецький розповів мені про Дувірі, але це тема для окремої розмови.",shape=box,color=blue];
		2372 -> 2377;
