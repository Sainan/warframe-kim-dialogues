		j1927467826 -> j1624047897;
	j571428348 [label="Boolean RoatheTraitor1 is now true.",color=orange];
		j571428348 -> j284455375;
	j812521753 [label="Ха! Я практично почув зітхання зі Святилища. Чи були вони такі як я? Ні. Вони були значно гірші. І значно дратівливіші.",shape=box,color=blue];
		j812521753 -> j4061285788;
	j1656159258 [label="Гм… ні. Але я ціную прояв належного етикету. Титули від мене треба заслужити, узурпаторе. Ти вже це знаєш.",shape=box,color=blue];
		j1656159258 -> j4061285788;
