		j4174795012 -> j2553718359 [label="x <= 21",color=purple];
		j4174795012 -> j2553718359 [label="false",color=purple];
	j1220018589 [label="Узурпаторе. Я відчуваю, що ми майже на місці. Ще кілька днів, і фрагменти моєї свідомості будуть майже повними. Ми майже досягнемо тієї точки, де ми «востаннє зупинилися». Дивно про це розмірковувати.",shape=box,color=blue];
		j1220018589 -> j4152463938;
	j2553718359 [label="Evaluate expressions on HellKeyPlayed counter",color=orange];
