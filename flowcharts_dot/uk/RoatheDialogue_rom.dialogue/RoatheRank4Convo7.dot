		j1504670698 -> j786147862;
		j1504670698 -> j3911267881;
		j1504670698 -> j3396060834;
	j177330384 [label="Гадаєш, мені не байдуже? Ці двоє фанатиків і не помітили б. Як ідіотські рибки в акваріумі (не хочу ображати Фібоначчі цим порівнянням), вони б і далі жили в блаженному незнанні.",shape=box,color=blue];
		j177330384 -> j1925422713;
	j1925422713 [label="На мене чекає щось жахливе, узурпаторе. Якесь жахливе усвідомлення на вершині того пагорба. Я відчуваю, як воно накопичується в моїй голові, мов грозові хмари. Я бачу хворобливо-жовте сяйво на обрії.",shape=box,color=blue];
		j1925422713 -> j1908279877;
	j931016351 [label="Таких слів я ніколи не…",shape=box,color=blue];
		j931016351 -> j1613693000;
	j1820333710 [label="Прошу.",shape=box,color=blue];
		j1820333710 -> j1551155620;
		j1820333710 -> j550219705;
	j2225847807 [label="Просто мені здається, що ми так далеко зайшли, і далі йти не треба. Ти можеш спинитися тут та й по всьому.",shape=box,color=blue];
