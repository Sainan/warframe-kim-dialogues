	2993 [label="Гадаєш, мені не байдуже? Ці двоє фанатиків і не помітили б. Як ідіотські рибки в акваріумі (не хочу ображати Фібоначчі цим порівнянням), вони б і далі жили в блаженному незнанні.",shape=box,color=blue];
		2993 -> 2994;
	2994 [label="Я не бачу іншого шляху, окрім бути відвертим. Я… я знаю, що на мене чекає щось жахливе, узурпаторе. Якесь жахливе усвідомлення на вершині того пагорба. Я відчуваю, як воно накопичується в моїй голові, мов грозові хмари. Я бачу хворобливо-жовте сяйво на обрії.",shape=box,color=blue];
		2994 -> 3013;
	2987 [label="Я намагаюся позбавити тебе праці та болю, пов’язаного з перетином Темного Спогадарію з моєї ж згоди. Я просто намагаюся бути люб’язним, узурпаторе. Прошу.",shape=box,color=blue];
		2987 -> 3003;
		2987 -> 3004;
