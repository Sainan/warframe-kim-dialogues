	j3821076670 [label="Check boolean DrifterRoathe",color=orange];
		j3821076670 -> j867765969 [label=true,color=green];
		j3821076670 -> j1775331380 [label=false,color=brown];
	j874434302 [label="Узурпаторе, я радий повідомити тобі, що твоя робота в Темному Спогадарії завершена, і ти можеш припинити викопувати мої спогади.",shape=box,color=blue];
		j874434302 -> j4159436031;
	j3873693261 [label="Узурпаторе, хоча в Темному Спогадарії ще лишається трохи роботи щодо відновлення моїх спогадів, я радий оголосити, що я, здається, покінчив із цією кривавою справою.",shape=box,color=blue];
		j3873693261 -> j4159436031;
	j3895846248 [label="Узурпаторе, хоча на початку твоя робота в Темному Спогадарії була, якщо чесно, недбалою, я радий оголосити, що я, здається, покінчив із цією кривавою справою.",shape=box,color=blue];
		j3895846248 -> j2383204961;
	j3967386818 [label="Хоч ти й можеш вважати, що тобі належать і подяка, і вибачення за те, що сталося, за моє прохання стерти мої спогади й почати знову, я вважаю, що це лише робить нас «рівними» за весь біль, який я зазнав унаслідок цього.",shape=box,color=blue];
		j3967386818 -> j1805353557;
		j3967386818 -> j1037911892;
	j2464559180 [label="Усе це переслідування власного хвоста здається таким порожнім. Гадаю, лише ти можеш знати. Ну що ж. Доведімо це до кінця, так?",shape=box,color=blue];
		j2464559180 -> j1805353557;
		j2464559180 -> j2309634554;
	j867765969 [label="Узурпаторе, я мушу поставити перед тобою важке прохання. Таке, що не приносить мені жодної радості. Я знаю, що принаймні ти бажаєш мене, і я сподіваюся, що є місце у твоєму серці, яке зігрілося до мене…",shape=box,color=blue];
		j867765969 -> j4109295025;
		j867765969 -> j1945001882;
		j867765969 -> j388844949;
	j1775331380 [label="Узурпаторе, я мушу поставити перед тобою важке прохання. Таке, що не приносить мені жодної радості. Але спершу я запитаю… чи ми стали друзями? Чи є якесь місце у твоєму серці, яке почало ставитися до мене з прихильністю?",shape=box,color=blue];
		j1775331380 -> j3439113364;
		j1775331380 -> j1753636391;
		j1775331380 -> j1258092245;
	j4159436031 [label="Ми можемо перестати блукати в моєму розумі й піддавати нас усіх такому винахідливому самокатуванню, чи не так? Навіть якщо священик і насолоджується цим.",shape=box,color=blue];
		j4159436031 -> j27889249;
	j2383204961 [label="Можеш забути тепер про це. Упевнений, у тебе є інші справи, ніж це винахідливе самокатування, чи не так? Навіть якщо священик і насолоджується цим.",shape=box,color=blue];
		j2383204961 -> j3077456970;
	j1805353557 [label="Ми з цим упораємося. ",shape=box,color=red];
		j1805353557 -> j2617189787;
	j1037911892 [label="Ми робили це, бо ти мене попросив, Роуте. Ти попередив, що розгніваєшся. ",shape=box,color=red];
		j1037911892 -> j1331924065;
	j2309634554 [label="Ми майже завершили, як ти й кажеш.",shape=box,color=red];
		j2309634554 -> j3636990619;
	j4109295025 [label="Ти мені не байдужий, Роуте. Варто мені це робити чи ні — не питання обговорень.",shape=box,color=red];
		j4109295025 -> j4103257768;
	j1945001882 [label="Моя думка змінилася після всієї цієї інформації. Я терпіти тебе не можу.",shape=box,color=red];
		j1945001882 -> j2991886582;
	j388844949 [label="Я глибоко переживаю за тебе, Роуте. Це цілком справедливо. Не знаю, чи варто було б так думати, але… здається, я закохуюся в тебе.",shape=box,color=red];
		j388844949 -> j4120503065;
	j3439113364 [label="Це… трохи складніше. [Зізнатися в почуттях]",shape=box,color=red];
		j3439113364 -> j3388647140;
	j1753636391 [label="Мені приємно думати, що ми друзі. Принаймні з моєї точки зору.",shape=box,color=red];
		j1753636391 -> j1619108946;
	j1258092245 [label="Якщо чесно, Роуте, то я тебе терпіти не можу.",shape=box,color=red];
		j1258092245 -> j2121827859;
	j27889249 [label="Насправді я наполегливо вимагаю, щоб ми так і зробили.",shape=box,color=blue];
		j27889249 -> j3703058924;
	j3077456970 [label="Evaluate expressions",color=orange];
		j3077456970 -> j3862690390 [label="RoatheDeal",color=purple];
		j3077456970 -> j2737782244 [label="RoatheDeal",color=purple];
		j3077456970 -> j2386094568 [label="RoatheNoDeal",color=purple];
		j3077456970 -> j3862690390 [label="RoatheNoDeal",color=purple];
		j3077456970 -> j3862690390 [label="false",color=purple];
	j2617189787 [label="А якщо ні, то, гадаю, ти маєш рішення для цього, так? Ну що ж, завтра буде інший день, і, можливо, він здаватиметься вчорашнім.",shape=box,color=blue];
		j2617189787 -> j298080266;
	j1331924065 [label="Так. Гадаю, я б розгнівався. І гадаю, я мав рацію. Ну що ж, завтра буде інший день, і, можливо, він здаватиметься вчорашнім.",shape=box,color=blue];
		j1331924065 -> j298080266;
	j3636990619 [label="Так. Є таке всепоглинальне відчуття жаху, що супроводжує це. Ну що ж, завтра буде інший день, і, можливо, він здаватиметься вчорашнім.",shape=box,color=blue];
		j3636990619 -> j298080266;
	j4103257768 [label="Тоді те, про що я тебе питатиму, я роблю також з теплом власного серця, узурпаторе. І зрозумій, що я роблю це, знаючи, що це означає для нас обох.",shape=box,color=blue];
		j4103257768 -> j996253791;
