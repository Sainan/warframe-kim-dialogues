		j2664509501 -> j302377653;
		j2664509501 -> j1644302422;
		j2664509501 -> j1002255266;
	j2843229675 [label="Чом же тоді замість битви з моїм уявним тілом не спробувати живе? Упевнений, ми знайдемо місце для спарингу, якщо захочеш.",shape=box,color=blue];
		j2843229675 -> j97906574;
		j2843229675 -> j916689287;
	j20135583 [label="Ну, ти повністю змінив думку щодо цієї теми без попередження.",shape=box,color=red];
		j20135583 -> j198124553;
	j786147862 [label="Ти… люб’язний.",shape=box,color=red];
		j786147862 -> j3147603508;
	j3911267881 [label="Не зважай. Звісно. Я погоджуюся.",shape=box,color=red];
		j3911267881 -> j1366507047;
	j3396060834 [label="Будь ласка, довірся мені й розкажи, що саме відбувається. ",shape=box,color=red];
		j3396060834 -> j4090814569;
	j1908279877 [label="Спогади, які я знаю, але не хочу повертати. Тіла мертвих, які я хотів би поховати глибоко в пам’яті. Будь ласка. Прошу.",shape=box,color=blue];
		j1908279877 -> j2909803112;
	j1613693000 [label="Раптом усе, що я хотів тебе попросити, хотів тобі сказати, вислизнуло, мову пісок крізь пальці.",shape=box,color=blue];
