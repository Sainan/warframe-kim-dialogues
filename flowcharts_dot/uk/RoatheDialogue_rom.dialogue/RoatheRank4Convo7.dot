		j1188155824 -> j3544389776;
		j1188155824 -> j780574219;
	"Chat ends. Next chat will be RoatheRank4Convo9." [color=orange];
	j212228059 [label="Прошу.",shape=box,color=blue];
		j212228059 -> j1759745118;
		j212228059 -> j36482584;
	j2083375965 [label="Узурпаторе… Я приголомшений. Навіть не знаю, що сказати.",shape=box,color=blue];
		j2083375965 -> j427340011;
	j1667401200 [label="Чи твоє… захоплення мною — це випадкове захоплення, швидкоплинна пристрасть, фізичний потяг чи, можливо, кохання весняної юності? Чи… ",shape=box,color=blue];
		j1667401200 -> j1048079789;
		j1667401200 -> j4109295025;
	j2772938849 [label="І мушу сказати, що я сумуватиму за ними. Але вони, якщо бути точним, не припиняться, якщо ти виконаєш моє прохання.",shape=box,color=blue];
		j2772938849 -> j146934064;
	j146934064 [label="Я хочу, щоб за допомогою твоїх сил ми вичистили мій розум протофрейма від усіх наших взаємодій. Перш ніж стало запізно. Перш ніж ти здригнешся, я знаю, що ти маєш такі сили. Просто вдар по підлозі, по столу, чи що там тобі треба зробити.",shape=box,color=blue];
		j146934064 -> j1533061647;
	j1119229513 [label="Я більше ніж упевнений, що тобі більше не знадобиться моя допомога в цьому плані.",shape=box,color=blue];
		j1119229513 -> j2033284574;
	j475527962 [label="Ні, нічого. Я задоволений тим, що ми знайшли. Ці розкопування дали свої результати, і я вирішив, що вже достатньо твого часу згаяв.",shape=box,color=blue];
		j475527962 -> j3823406879;
	j2411653106 [label="Та ні, справа геть не в цьому. Просто мені здається, що ми так далеко зайшли, і далі йти не треба. Ти можеш спинитися тут та й по всьому.",shape=box,color=blue];
		j2411653106 -> j2876131591;
		j2411653106 -> j2423677409;
		j2411653106 -> j2585625438;
	j3544389776 [label="У мене складається враження, що ти щось приховуєш.",shape=box,color=red];
		j3544389776 -> j622446849;
	j780574219 [label="Роуте? Щось не так? Скажи, прошу.",shape=box,color=red];
		j780574219 -> j1504670698;
	j1759745118 [label="Я не можу цього зробити, не зашкодивши Ліону та Марі. Ви в одній зв’язці.",shape=box,color=red];
		j1759745118 -> j177330384;
	j36482584 [label="Що?! Навіщо?",shape=box,color=red];
		j36482584 -> j1925422713;
	j427340011 [label="+10 Chemistry",color=orange];
		j427340011 -> j931016351;
	j1048079789 [label="Я глибоко переживаю за тебе, Роуте. Це цілком справедливо. Не знаю, чи варто було б так думати, але… здається, я закохуюся в тебе.",shape=box,color=red];
		j1048079789 -> j2307033081;
	j1533061647 [label="Просто прочисть мою голову. Не йдімо далі.",shape=box,color=blue];
		j1533061647 -> j1820333710;
	j2033284574 [label="Тобі не потрібно постійно викопувати мої спогади, щоби змусити дворецького піднятися! Усе буде добре.",shape=box,color=blue];
		j2033284574 -> j2225847807;
	j3823406879 [label="Мені здається, що ми так далеко зайшли, і далі йти не треба. Ти можеш спинитися тут та й по всьому.",shape=box,color=blue];
		j3823406879 -> j2876131591;
		j3823406879 -> j2423677409;
		j3823406879 -> j2585625438;
	j2876131591 [label="У мене складається враження, що ти щось приховуєш.",shape=box,color=red];
		j2876131591 -> j3383947045;
	j2423677409 [label="Роуте? Щось не так? Скажи, прошу.",shape=box,color=red];
		j2423677409 -> j2664509501;
	j2585625438 [label="А що якщо мені просто подобається туди спускатися і вбивати тебе знову й знову?",shape=box,color=red];
		j2585625438 -> j2843229675;
	j622446849 [label="Чому ти так уважаєш?",shape=box,color=blue];
		j622446849 -> j20135583;
		j622446849 -> j786147862;
		j622446849 -> j3911267881;
		j622446849 -> j3396060834;
	j1504670698 [label="Чому ти вважаєш, що щось не так?",shape=box,color=blue];
