	2886 [label="Узурпаторе, я радий повідомити тобі, що твоя робота в Темному Спогадарії завершена, і ти можеш припинити викопувати мої спогади.",shape=box,color=blue];
		2886 -> 2891;
	2887 [label="Узурпаторе, хоча в Темному Спогадарії ще лишається трохи роботи щодо відновлення моїх спогадів, я радий оголосити, що я, здається, покінчив із цією кривавою справою.",shape=box,color=blue];
		2887 -> 2892;
	2889 [label="Узурпаторе, хоча на початку твоя робота в Темному Спогадарії була, якщо чесно, недбалою, я радий оголосити, що я, здається, покінчив із цією кривавою справою.",shape=box,color=blue];
		2889 -> 2895;
	2896 [label="Хоч ти й можеш вважати, що тобі належать і подяка, і вибачення за те, що сталося, за моє прохання стерти мої спогади й почати знову, я вважаю, що це лише робить нас «рівними» за весь біль, який я зазнав унаслідок цього.",shape=box,color=blue];
		2896 -> 2906;
		2896 -> 2907;
	2897 [label="Усе це переслідування власного хвоста здається таким порожнім. Гадаю, лише ти можеш знати. Ну що ж. Доведімо це до кінця, так?",shape=box,color=blue];
		2897 -> 2908;
		2897 -> 2909;
	2893 [label="Узурпаторе, я мушу поставити перед тобою важке прохання. Таке, що не приносить мені жодної радості. Я знаю, що принаймні ти бажаєш мене, і я сподіваюся, що є місце у твоєму серці, яке зігрілося до мене…",shape=box,color=blue];
		2893 -> 2899;
		2893 -> 2900;
		2893 -> 2901;
	2894 [label="Узурпаторе, я мушу поставити перед тобою важке прохання. Таке, що не приносить мені жодної радості. Але спершу я запитаю… чи ми стали друзями? Чи є якесь місце у твоєму серці, яке почало ставитися до мене з прихильністю?",shape=box,color=blue];
		2894 -> 2902;
		2894 -> 2903;
		2894 -> 2904;
	2891 [label="Ми можемо перестати блукати в моєму розумі й піддавати нас усіх такому винахідливому самокатуванню, чи не так? Навіть якщо священик і насолоджується цим.",shape=box,color=blue];
		2891 -> 2898;
	2892 [label="Ми можемо перестати блукати в моєму розумі й піддавати нас усіх такому винахідливому самокатуванню, чи не так? Навіть якщо священик і насолоджується цим.",shape=box,color=blue];
		2892 -> 2898;
	2895 [label="Можеш забути тепер про це. Упевнений, у тебе є інші справи, ніж це винахідливе самокатування, чи не так? Навіть якщо священик і насолоджується цим.",shape=box,color=blue];
		2895 -> 2905;
	2906 [label="Ми з цим упораємося. ",shape=box,color=red];
		2906 -> 2920;
	2907 [label="Ми робили це, бо ти мене попросив, Роуте. Ти попередив, що розгніваєшся. ",shape=box,color=red];
		2907 -> 2921;
	2908 [label="Ми з цим упораємося. ",shape=box,color=red];
		2908 -> 2922;
	2909 [label="Ми майже завершили, як ти й кажеш.",shape=box,color=red];
		2909 -> 2923;
	2899 [label="Ти мені не байдужий, Роуте. Варто мені це робити чи ні — не питання обговорень.",shape=box,color=red];
		2899 -> 2911;
	2900 [label="Моя думка змінилася після всієї цієї інформації. Я терпіти тебе не можу.",shape=box,color=red];
		2900 -> 2912;
	2901 [label="Я глибоко переживаю за тебе, Роуте. Це цілком справедливо. Не знаю, чи варто було б так думати, але… здається, я закохуюся в тебе.",shape=box,color=red];
		2901 -> 2913;
	2902 [label="Це… трохи складніше. [Зізнатися в почуттях]",shape=box,color=red];
		2902 -> 2914;
	2903 [label="Мені приємно думати, що ми друзі. Принаймні з моєї точки зору.",shape=box,color=red];
		2903 -> 2915;
	2904 [label="Якщо чесно, Роуте, то я тебе терпіти не можу.",shape=box,color=red];
		2904 -> 2916;
