	2966 [label="Гадаєш, мені не байдуже? Ці двоє фанатиків і не помітили б. Як ідіотські рибки в акваріумі (не хочу ображати Фібоначчі цим порівнянням), вони б і далі жили в блаженному незнанні.",shape=box,color=blue];
		2966 -> 2967;
	2967 [label="На мене чекає щось жахливе, узурпаторе. Якесь жахливе усвідомлення на вершині того пагорба. Я відчуваю, як воно накопичується в моїй голові, мов грозові хмари. Я бачу хворобливо-жовте сяйво на обрії.",shape=box,color=blue];
