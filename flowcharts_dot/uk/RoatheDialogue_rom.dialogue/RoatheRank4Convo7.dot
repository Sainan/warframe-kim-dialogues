		j2386094568 -> j1188155824;
	j298080266 [label="+10 Chemistry",color=orange];
		j298080266 -> "Chat ends. Next chat will be RoatheRank4Convo9.";
	j996253791 [label="Я хочу, щоб за допомогою твоїх сил ми вичистили мій розум протофрейма від усіх наших взаємодій. Перш ніж стало запізно.",shape=box,color=blue];
		j996253791 -> j212228059;
	j2112054050 [label="Boolean DrifterRoathe is now false.",color=orange];
		j2112054050 -> j2559210634;
	j2307033081 [label="Я…",shape=box,color=blue];
		j2307033081 -> j2083375965;
	j3682452715 [label="Дивовижно… Я не хочу заглиблюватися в подробиці зараз та перепрошую за зухвалість наступного запитання, оскільки воно жахливо невдале та грубе. Воно має глибокий вплив на те, про що я збираюся тебе попросити.",shape=box,color=blue];
		j3682452715 -> j1667401200;
	j1280946764 [label="Віриш ти чи ні, але я думаю так само. Мені щиро подобаються наші розмови.",shape=box,color=blue];
		j1280946764 -> j2772938849;
	j2559210634 [label="Чудово! Це неймовірні новини. Тоді моє прохання тобі буде легше виконати! ",shape=box,color=blue];
		j2559210634 -> j146934064;
	j3832554567 [label="А як щодо нашої домовленості?",shape=box,color=red];
		j3832554567 -> j1119229513;
	j1944489785 [label="Що змінилося?",shape=box,color=red];
		j1944489785 -> j475527962;
	j597972711 [label="Це тому що мені не сподобалася твоя угода?",shape=box,color=red];
		j597972711 -> j2411653106;
	j2638626797 [label="Ні, нічого. Я задоволений тим, що ми знайшли. Ці розкопування дали свої результати, і я вирішив, що вже достатньо твого часу згаяв.",shape=box,color=blue];
		j2638626797 -> j3544389776;
		j2638626797 -> j780574219;
	j1514569882 [label="Я більше ніж упевнений, що тобі більше не знадобиться моя допомога в цьому плані.",shape=box,color=blue];
		j1514569882 -> j3544389776;
