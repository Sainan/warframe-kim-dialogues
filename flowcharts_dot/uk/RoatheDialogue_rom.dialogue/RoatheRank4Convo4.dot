digraph {
	2564 [label="RoatheRank4Convo4 begins.",color=orange];
		2564 -> 2565;
	2565 [label="У мене до тебе філософське питання, узурпаторе. І перш ніж ти зробиш якісь поспішні висновки про те, кого я маю на увазі — чи то мене, чи Балласа, чи Альбрехта — це суто уявний експеримент. Пограймо?",shape=box,color=blue];
		2565 -> 2566;
