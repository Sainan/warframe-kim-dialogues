		j821815412 -> j58728295 [label="false",color=purple];
	"Chat ends." [color=orange];
	j3518937071 [label="Ти запитуєш мене після того, як розповів мені ту історію про Балласа та Марґуліс, і питання не про нього?",shape=box,color=red];
		j3518937071 -> j3483292032;
	j851330767 [label="Після того, що Альбрехт зробив із тобою, і всієї цієї історії про «чи можна пробачити орокіна», це питання не про нього?",shape=box,color=red];
		j851330767 -> j3483292032;
	j3111641690 [label="Гаразд, підіграю. Чи вірю я, що «кожен заслуговує на любов»? Очевидно, це питання про мораль і цінності.",shape=box,color=red];
		j3111641690 -> j639127845;
	j1282737849 [label="Той орокін, який сказав, що ніколи не знав кохання, просто випадково ставить мені це питання, і воно не про нього?",shape=box,color=red];
		j1282737849 -> j3483292032;
	j3293531675 [label="Той орокін, який служив Виконавиці коханцем і замислив зрадити її, ставить мені це питання, і воно не про нього?",shape=box,color=red];
		j3293531675 -> j3483292032;
	j58728295 [label="Ти дійсно очікуєш, що я повірю, що це просто філософське питання?",shape=box,color=red];
		j58728295 -> j3483292032;
	j3483292032 [label="Я не хочу загрузнути в деталях. Це все зводить справу до дріб’язковості. «Ну, дививсь, ця людина зробила те, а та людина зробила інше, що це заперечує», — тоді ми всі опиняємось на лаві підсудних у цьому нашому маленькому випробуванні.",shape=box,color=blue];
		j3483292032 -> j3339191674;
		j3483292032 -> j4259917404;
	j639127845 [label="+5 Chemistry",color=orange];
		j639127845 -> j2925040814;
	j3339191674 [label="Або кажи прямо, або не кажи нічого. Якщо ти не збираєшся сказати, про кого це насправді, то я не витрачатиму свій час на розмови з тобою.",shape=box,color=red];
		j3339191674 -> j922443175;
	j4259917404 [label="Гаразд, зіграймо в твою гру слів.",shape=box,color=red];
		j4259917404 -> j3951960562;
	j2925040814 [label="Дякую! Усунення імен із цієї нашої маленької скриньки робить його значно прийнятнішим. Інакше ми загрузнемо в деталях і нікуди не просунемось.",shape=box,color=blue];
		j2925040814 -> j2940596063;
	j922443175 [label="І я не витрачатиму свій на тебе, от і все.",shape=box,color=blue];
		j922443175 -> j155006797;
	j3951960562 [label="Добре. Питання те ж. Чи кожен заслуговує на любов?",shape=box,color=blue];
		j3951960562 -> j4244135729;
	j2940596063 [label="І так, ніхто не ставить під сумнів, чи заслуговує праведний герой на любов і на те, щоб його любили. Це не обговорюється в жодній казці та оповіданнях, чи не так?",shape=box,color=blue];
		j2940596063 -> j1105872697;
	j155006797 [label="Boolean RoatheNoDate is now true.",color=orange];
		j155006797 -> "Chat ends.";
	j4244135729 [label="Ніхто не ставить під сумнів, чи заслуговує праведний герой на любов і на те, щоб його любили. Це не обговорюється в жодній казці та оповіданнях, чи не так?",shape=box,color=blue];
		j4244135729 -> j1105872697;
	j1105872697 [label="Лише Пес. Лиходій. Потвора. Морально спустошений Руйнівник Світів.",shape=box,color=blue];
		j1105872697 -> j3643146275;
		j1105872697 -> j2590333631;
	j3643146275 [label="[Дати йому дописати]",shape=box,color=red];
		j3643146275 -> j2420227680;
	j2590333631 [label="Диявол?",shape=box,color=red];
		j2590333631 -> j2907956420;
	j2420227680 [label="Add 1 to Thermostat counter",color=orange];
		j2420227680 -> j2110784913;
	j2907956420 [label="Підіграй, узурпаторе.",shape=box,color=blue];
		j2907956420 -> j1817221348;
	j2110784913 [label="Я пропоную таке твердження: єдина річ, що робить цих істот моральними вигнанцями, — це наявність інших, які можуть їх такими оголосити.",shape=box,color=blue];
		j2110784913 -> j2317092045;
	j1817221348 [label="Add -1 to Thermostat counter",color=orange];
		j1817221348 -> j206557614;
		j1817221348 -> j4129300556;
	j2317092045 [label="Якщо індивід чинить «злі діяння» у вакуумі як самотня істота без жодних інших довкола, які його судитимуть, то ніхто ж не назве його злим, чи не так?",shape=box,color=blue];
		j2317092045 -> j387066090;
	j206557614 [label="Тобто…",shape=box,color=red];
		j206557614 -> j2810904887;
	j4129300556 [label="Перепрошую.",shape=box,color=red];
		j4129300556 -> j2810904887;
	j387066090 [label="Якщо покидьок спалює ліс, а навколо нікого немає, щоб це почути, чи видає він звук? Єдина міра, за якою ми можемо судити «добро» і «зло» — це діяння інших.",shape=box,color=blue];
		j387066090 -> j3564850110;
		j387066090 -> j3920240211;
		j387066090 -> j4068345581;
	j2810904887 [label="Але так, якщо ти наполягаєш порушити цю тему, і Диявол! Найвище з усіх зол!",shape=box,color=blue];
		j2810904887 -> j2110784913;
	j3564850110 [label="Мають бути вчинки, які самі по собі є злом.",shape=box,color=red];
		j3564850110 -> j1858589711;
	j3920240211 [label="Кажеш, щоби бути «злом», одній людині потрібна інша людина?",shape=box,color=red];
		j3920240211 -> j884495587;
	j4068345581 [label="Не знаю, чи можу з цим погодитися.",shape=box,color=red];
		j4068345581 -> j1858589711;
	j1858589711 [label="Усі найжахливіші вчинки, які може зробити людина, вимагають щонайменше другої людини. Бо вчинки однієї людини у вакуумі нікому засуджувати. Знищити безлюдну планету? Та будь ласка.",shape=box,color=blue];
		j1858589711 -> j2707923006;
	j884495587 [label="Так. Поміркуй. Усі найжахливіші вчинки, які може зробити людина, вимагають щонайменше другої людини. Бо вчинки однієї людини у вакуумі нікому засуджувати. Знищити безлюдну планету? Та будь ласка.",shape=box,color=blue];
		j884495587 -> j2707923006;
	j2707923006 [label="Але без суспільства, яке б похитало пальцем і сказало: «Ти не мав чинити цього страшного діяння», — як ми взагалі дізналися б, що це діяння жахливе? Ми б не дізналися. Як я й казав, це лише мірило, яким суспільство оцінює твої дії, порівнюючи їх із діями інших.",shape=box,color=blue];
		j2707923006 -> j3998677913;
	j3998677913 [label="Як я й казав, це лише мірило, яким суспільство оцінює твої дії, порівнюючи їх із діями інших.",shape=box,color=blue];
		j3998677913 -> j3985221726;
		j3998677913 -> j3849166048;
	j3985221726 [label="Скажімо, ти маєш рацію. Скажімо, ти переконав мене, і добро та зло — це просто… соціальні конструкції. Що тоді?",shape=box,color=red];
		j3985221726 -> j1139391066;
	j3849166048 [label="Я вважаю, що дії можуть бути добрими чи злими поза їхнім соціальним контекстом. Інакше чому ж так багато з них подібні у суспільствах, що суттєво відрізняються одне від одного?",shape=box,color=red];
		j3849166048 -> j597069442;
	j1139391066 [label="Add -1 to Thermostat counter",color=orange];
		j1139391066 -> j120932409;
	j597069442 [label="Add 1 to Thermostat counter",color=orange];
		j597069442 -> j956209259;
		j597069442 -> j4102172929;
	j120932409 [label="+5 Chemistry",color=orange];
		j120932409 -> j2531760442;
	j956209259 [label="Але задля обговорення, продовжуй. ",shape=box,color=red];
		j956209259 -> j120932409;
	j4102172929 [label="Гадаю, краще тут зупинитися. Розмова щось не дуже. [Завершити розмову]",shape=box,color=red];
		j4102172929 -> j1613866309;
	j2531760442 [label="Дуже добре. Якщо ми можемо сказати, що «зло» — це не стан буття, а соціальний конструкт, тоді ми можемо погодитися, що всі оповіді про Велике Зло є, своєю чергою, соціальними конструктами. Байками.",shape=box,color=blue];
		j2531760442 -> j2602671390;
	j1613866309 [label="Як забажаєш.",shape=box,color=blue];
		j1613866309 -> "Chat ends.";
	j2602671390 [label="Чому ж тоді у всіх великих байках ті, хто чинить Велике Зло, залишаються гнити на самоті?",shape=box,color=blue];
		j2602671390 -> j1926070795;
		j2602671390 -> j1645333252;
		j2602671390 -> j2011918376;
		j2602671390 -> j539598771;
	j1926070795 [label="Бо вони не здатні на любов?",shape=box,color=red];
		j1926070795 -> j3026093573;
	j1645333252 [label="Бо в їхньому серці немає місця для любові?",shape=box,color=red];
		j1645333252 -> j1056669273;
	j2011918376 [label="Бо вони не заслуговують на любов?",shape=box,color=red];
		j2011918376 -> j1164159585;
	j539598771 [label="Бо ми намагаємось навчити уроку?",shape=box,color=red];
		j539598771 -> j931165125;
	j3026093573 [label="Іноді так, їх показують як певне нелюдське зло, нездатне на любов. Але чому? Я гадав, що великі історії існують, аби навчати якогось уроку, чи не так?",shape=box,color=blue];
		j3026093573 -> j1252809665;
	j1056669273 [label="Іноді так, їх показують надто зайнятими своїм Великим Злом, щоби принижувати себе так званими «звичайними справами». Але чому? Усі великі історії існують, аби навчати якогось уроку, чи не так?",shape=box,color=blue];
		j1056669273 -> j1252809665;
	j1164159585 [label="М-м, тепер ти просто повторюєш мої слова, узурпаторе. Ми вже вирішили, що «заслуговувати» — це відносне. Подумай. Усі великі історії існують, аби навчати якогось уроку, чи не так?",shape=box,color=blue];
		j1164159585 -> j1252809665;
	j931165125 [label="+5 Chemistry",color=orange];
		j931165125 -> j1022516228;
	j1252809665 [label="А якщо ми покажемо Велике Зло, яка живе мирно, щасливо, чудово в любові… то що ж це за урок такий?",shape=box,color=blue];
		j1252809665 -> j2735811886;
		j1252809665 -> j3475284196;
		j1252809665 -> j2847746831;
	j1022516228 [label="Це моя теорія, так! Усі великі історії існують, аби навчати якогось уроку, чи не так?",shape=box,color=blue];
		j1022516228 -> j1252809665;
	j2735811886 [label="Важко змиритися з тим фактом, що хтось є «злом» і водночас здатний кохати.",shape=box,color=red];
		j2735811886 -> j362925635;
	j3475284196 [label="Можливо, їхні «злі вчинки» все ще можна спокутувати через любов?",shape=box,color=red];
		j3475284196 -> j3250365524;
	j2847746831 [label="Ті, хто чинить «злі діяння», усе ж можуть мати цінність для когось іншого в цьому світі, і тому не є «чистим злом»?",shape=box,color=red];
		j2847746831 -> j1434933449;
	j362925635 [label="Check boolean RoatheMargulis1",color=orange];
		j362925635 -> j29238056 [label=true,color=green];
		j362925635 -> j863282209 [label=false,color=brown];
	j3250365524 [label="Add 1 to Thermostat counter",color=orange];
		j3250365524 -> j2563806991;
	j1434933449 [label="Add -1 to Thermostat counter",color=orange];
		j1434933449 -> j911360533;
	j29238056 [label="+5 Chemistry",color=orange];
		j29238056 -> j1326837258;
	j863282209 [label="+5 Chemistry",color=orange];
		j863282209 -> j3040553569;
	j2563806991 [label="Ти звучиш як фанатики. «Спокута». Але ти вже стукаєш у двері істини. Адже ти натякаєш, що ці дві речі не можуть співіснувати одночасно у нашому світі, і це правда, чи не так? Любов і зло не можуть бути допущені до співіснування в суспільстві.",shape=box,color=blue];
		j2563806991 -> j603738447;
	j911360533 [label="Ти близько, але ще не зовсім там. Так, але ступи далі. Що б означало, якби людина, здатна на злі діяння, усе ж була б коханою кимось іншим? Що це зробило б із суспільством?",shape=box,color=blue];
		j911360533 -> j603738447;
	j1326837258 [label="Саме так! Ці дві речі не бажають співіснувати в нашій свідомості, чи не так? Коли я розповідав тобі історію Балласа й Марґуліс, було важко прийняти, що їхня любов колись була справжньою, чи не так?",shape=box,color=blue];
		j1326837258 -> j564830259;
	j3040553569 [label="Саме так! Ці дві речі не бажають співіснувати у нашій свідомості, чи не так? Якби я сказав тобі, що Баллас і Марґуліс колись були глибоко закохані, перш ніж усе пішло шкереберть, у таке можна було б повірити?",shape=box,color=blue];
		j3040553569 -> j564830259;
	j603738447 [label="Check boolean RoatheMargulis1",color=orange];
		j603738447 -> j1362554199 [label=true,color=green];
		j603738447 -> j1303174991 [label=false,color=brown];
	j564830259 [label="Не вдаючись у подробиці й не відхиляючись надто далеко від мого власного правила тримати все суто у філософській площині, вони є спільною точкою відліку для нас обох.",shape=box,color=blue];
		j564830259 -> j4115121430;
	j1362554199 [label="Коли я розповідав тобі історію Балласа й Марґуліс, було важко прийняти, що їхня любов колись була справжньою, чи не так?",shape=box,color=blue];
		j1362554199 -> j564830259;
	j1303174991 [label="Якби я сказав тобі, що Баллас і Марґуліс колись були глибоко закохані, перш ніж усе пішло шкереберть, у таке можна було б повірити?",shape=box,color=blue];
		j1303174991 -> j564830259;
	j4115121430 [label="Без сумніву, Баллас був здатний на одні з найчистіших форм жорстокості, які коли-небудь знало людство. І все ж він знав любов. Взаємну любов. ",shape=box,color=blue];
		j4115121430 -> j2634553152;
	j2634553152 [label="Це факт, хоч ти й можеш заперечувати його зараз: Баллас і Марґуліс глибоко кохали одне одного. Просто все пішло жахливо неправильно.",shape=box,color=blue];
		j2634553152 -> j2858371770;
	j2858371770 [label="Boolean RoatheMargulis1 is now true.",color=orange];
		j2858371770 -> j1665541941;
	j1665541941 [label="Але ми повинні вичистити їхнє кохання з цієї історії. Ми повинні сказати, що його не існувало. Ми повинні сказати, що його не було насправді, що це була помилка. Чому?",shape=box,color=blue];
		j1665541941 -> j4074699175;
		j1665541941 -> j2597433860;
		j1665541941 -> j2109202771;
	j4074699175 [label="Не знаю.",shape=box,color=red];
		j4074699175 -> j4149670436;
	j2597433860 [label="Бо кохання — найвище людське почуття, і якщо ми дозволяємо думку, що когось можна покохати, це олюднює його.",shape=box,color=red];
		j2597433860 -> j1261312581;
	j2109202771 [label="Бо зло має дивитися в дзеркало й працювати над тим, щоб змінитися. Його має бути покарано. А кохати й бути коханим — найвища нагорода.",shape=box,color=red];
		j2109202771 -> j464047750;
