	2594 [label="Диявол?",shape=box,color=red];
		2594 -> 2596;
	2595 [label="Add 1 to Thermostat",color=orange];
		2595 -> 2597;
	2596 [label="Підіграй, узурпаторе.",shape=box,color=blue];
		2596 -> 2598;
	2597 [label="Я пропоную таке твердження: єдина річ, що робить цих істот моральними вигнанцями, — це наявність інших, які можуть їх такими оголосити.",shape=box,color=blue];
		2597 -> 2599;
	2598 [label="Add -1 to Thermostat",color=orange];
		2598 -> 2600;
		2598 -> 2601;
	2599 [label="Якщо індивід чинить «злі діяння» у вакуумі як самотня істота без жодних інших довкола, які його судитимуть, то ніхто ж не назве його злим, чи не так?",shape=box,color=blue];
		2599 -> 2602;
	2600 [label="Тобто…",shape=box,color=red];
		2600 -> 2603;
	2601 [label="Перепрошую.",shape=box,color=red];
		2601 -> 2603;
	2602 [label="Якщо покидьок спалює ліс, а навколо нікого немає, щоб це почути, чи видає він звук? Єдина міра, за якою ми можемо судити «добро» і «зло» — це діяння інших.",shape=box,color=blue];
		2602 -> 2604;
		2602 -> 2605;
		2602 -> 2606;
	2603 [label="Але так, якщо ти наполягаєш порушити цю тему, і Диявол! Найвище з усіх зол!",shape=box,color=blue];
		2603 -> 2597;
	2604 [label="Мають бути вчинки, які самі по собі є злом.",shape=box,color=red];
		2604 -> 2607;
	2605 [label="Кажеш, щоби бути «злом», одній людині потрібна інша людина?",shape=box,color=red];
		2605 -> 2608;
	2606 [label="Не знаю, чи можу з цим погодитися.",shape=box,color=red];
		2606 -> 2607;
	2607 [label="Усі найжахливіші вчинки, які може зробити людина, вимагають щонайменше другої людини. Бо вчинки однієї людини у вакуумі нікому засуджувати. Знищити безлюдну планету? Та будь ласка.",shape=box,color=blue];
		2607 -> 2609;
	2608 [label="Так. Поміркуй. Усі найжахливіші вчинки, які може зробити людина, вимагають щонайменше другої людини. Бо вчинки однієї людини у вакуумі нікому засуджувати. Знищити безлюдну планету? Та будь ласка.",shape=box,color=blue];
		2608 -> 2609;
	2609 [label="Але без суспільства, яке б похитало пальцем і сказало: «Ти не мав чинити цього страшного діяння», — як ми взагалі дізналися б, що це діяння жахливе? Ми б не дізналися. Як я й казав, це лише мірило, яким суспільство оцінює твої дії, порівнюючи їх із діями інших.",shape=box,color=blue];
		2609 -> 2610;
	2610 [label="Як я й казав, це лише мірило, яким суспільство оцінює твої дії, порівнюючи їх із діями інших.",shape=box,color=blue];
		2610 -> 2611;
		2610 -> 2612;
	2611 [label="Скажімо, ти маєш рацію. Скажімо, ти переконав мене, і добро та зло — це просто… соціальні конструкції. Що тоді?",shape=box,color=red];
		2611 -> 2613;
	2612 [label="Я вважаю, що дії можуть бути добрими чи злими поза їхнім соціальним контекстом. Інакше чому ж так багато з них подібні у суспільствах, що суттєво відрізняються одне від одного?",shape=box,color=red];
		2612 -> 2614;
	2613 [label="Add -1 to Thermostat",color=orange];
		2613 -> 2615;
	2614 [label="Add 1 to Thermostat",color=orange];
		2614 -> 2616;
		2614 -> 2617;
	2615 [label="+5 Chemistry",color=orange];
		2615 -> 2618;
	2616 [label="Але задля обговорення, продовжуй. ",shape=box,color=red];
		2616 -> 2615;
	2617 [label="Гадаю, краще тут зупинитися. Розмова щось не дуже. [Завершити розмову]",shape=box,color=red];
		2617 -> 2619;
	2618 [label="Дуже добре. Якщо ми можемо сказати, що «зло» — це не стан буття, а соціальний конструкт, тоді ми можемо погодитися, що всі оповіді про Велике Зло є, своєю чергою, соціальними конструктами. Байками.",shape=box,color=blue];
		2618 -> 2620;
	2619 [label="Як забажаєш.",shape=box,color=blue];
		2619 -> 2621;
	2620 [label="Чому ж тоді у всіх великих байках ті, хто чинить Велике Зло, залишаються гнити на самоті?",shape=box,color=blue];
		2620 -> 2622;
		2620 -> 2623;
		2620 -> 2624;
		2620 -> 2625;
	2621 [label="Chat ends.",color=orange];
	2622 [label="Бо вони не здатні на любов?",shape=box,color=red];
		2622 -> 2626;
	2623 [label="Бо в їхньому серці немає місця для любові?",shape=box,color=red];
		2623 -> 2627;
	2624 [label="Бо вони не заслуговують на любов?",shape=box,color=red];
		2624 -> 2628;
	2625 [label="Бо ми намагаємось навчити уроку?",shape=box,color=red];
		2625 -> 2629;
	2626 [label="Іноді так, їх показують як певне нелюдське зло, нездатне на любов. Але чому? Я гадав, що великі історії існують, аби навчати якогось уроку, чи не так?",shape=box,color=blue];
		2626 -> 2630;
	2627 [label="Іноді так, їх показують надто зайнятими своїм Великим Злом, щоби принижувати себе так званими «звичайними справами». Але чому? Усі великі історії існують, аби навчати якогось уроку, чи не так?",shape=box,color=blue];
		2627 -> 2630;
	2628 [label="М-м, тепер ти просто повторюєш мої слова, узурпаторе. Ми вже вирішили, що «заслуговувати» — це відносне. Подумай. Усі великі історії існують, аби навчати якогось уроку, чи не так?",shape=box,color=blue];
		2628 -> 2630;
	2629 [label="+5 Chemistry",color=orange];
		2629 -> 2631;
	2630 [label="А якщо ми покажемо Велике Зло, яка живе мирно, щасливо, чудово в любові… то що ж це за урок такий?",shape=box,color=blue];
		2630 -> 2632;
		2630 -> 2633;
		2630 -> 2634;
	2631 [label="Це моя теорія, так! Усі великі історії існують, аби навчати якогось уроку, чи не так?",shape=box,color=blue];
		2631 -> 2630;
	2632 [label="Важко змиритися з тим фактом, що хтось є «злом» і водночас здатний кохати.",shape=box,color=red];
		2632 -> 2635;
	2633 [label="Можливо, їхні «злі вчинки» все ще можна спокутувати через любов?",shape=box,color=red];
		2633 -> 2636;
	2634 [label="Ті, хто чинить «злі діяння», усе ж можуть мати цінність для когось іншого в цьому світі, і тому не є «чистим злом»?",shape=box,color=red];
		2634 -> 2637;
	2635 [label="Check boolean RoatheMargulis1",color=orange];
		2635 -> 2638 [label=true,color=green];
		2635 -> 2639 [label=false,color=brown];
	2636 [label="Add 1 to Thermostat",color=orange];
