	2637 [label="Add -1 to Thermostat",color=orange];
		2637 -> 2641;
	2638 [label="+5 Chemistry",color=orange];
		2638 -> 2642;
	2639 [label="+5 Chemistry",color=orange];
		2639 -> 2643;
	2640 [label="Ти звучиш як фанатики. «Спокута». Але ти вже стукаєш у двері істини. Адже ти натякаєш, що ці дві речі не можуть співіснувати одночасно у нашому світі, і це правда, чи не так? Любов і зло не можуть бути допущені до співіснування в суспільстві.",shape=box,color=blue];
		2640 -> 2644;
	2641 [label="Ти близько, але ще не зовсім там. Так, але ступи далі. Що б означало, якби людина, здатна на злі діяння, усе ж була б коханою кимось іншим? Що це зробило б із суспільством?",shape=box,color=blue];
		2641 -> 2644;
	2642 [label="Саме так! Ці дві речі не бажають співіснувати в нашій свідомості, чи не так? Коли я розповідав тобі історію Балласа й Марґуліс, було важко прийняти, що їхня любов колись була справжньою, чи не так?",shape=box,color=blue];
		2642 -> 2645;
	2643 [label="Саме так! Ці дві речі не бажають співіснувати у нашій свідомості, чи не так? Якби я сказав тобі, що Баллас і Марґуліс колись були глибоко закохані, перш ніж усе пішло шкереберть, у таке можна було б повірити?",shape=box,color=blue];
		2643 -> 2645;
	2644 [label="Check boolean RoatheMargulis1",color=orange];
		2644 -> 2646 [label=true,color=green];
		2644 -> 2647 [label=false,color=brown];
	2645 [label="Не вдаючись у подробиці й не відхиляючись надто далеко від мого власного правила тримати все суто у філософській площині, вони є спільною точкою відліку для нас обох.",shape=box,color=blue];
		2645 -> 2648;
	2646 [label="Коли я розповідав тобі історію Балласа й Марґуліс, було важко прийняти, що їхня любов колись була справжньою, чи не так?",shape=box,color=blue];
		2646 -> 2645;
	2647 [label="Якби я сказав тобі, що Баллас і Марґуліс колись були глибоко закохані, перш ніж усе пішло шкереберть, у таке можна було б повірити?",shape=box,color=blue];
		2647 -> 2645;
	2648 [label="Без сумніву, Баллас був здатний на одні з найчистіших форм жорстокості, які коли-небудь знало людство. І все ж він знав любов. Взаємну любов. ",shape=box,color=blue];
		2648 -> 2649;
	2649 [label="Це факт, хоч ти й можеш заперечувати його зараз: Баллас і Марґуліс глибоко кохали одне одного. Просто все пішло жахливо неправильно.",shape=box,color=blue];
		2649 -> 2650;
	2650 [label="Update boolean RoatheMargulis1",color=orange];
		2650 -> 2651;
	2651 [label="Але ми повинні вичистити їхнє кохання з цієї історії. Ми повинні сказати, що його не існувало. Ми повинні сказати, що його не було насправді, що це була помилка. Чому?",shape=box,color=blue];
		2651 -> 2652;
		2651 -> 2653;
		2651 -> 2654;
	2652 [label="Не знаю.",shape=box,color=red];
		2652 -> 2655;
	2653 [label="Бо кохання — найвище людське почуття, і якщо ми дозволяємо думку, що когось можна покохати, це олюднює його.",shape=box,color=red];
		2653 -> 2656;
	2654 [label="Бо зло має дивитися в дзеркало й працювати над тим, щоб змінитися. Його має бути покарано. А кохати й бути коханим — найвища нагорода.",shape=box,color=red];
		2654 -> 2657;
	2655 [label="То я все це говорив даремно. Шкода.",shape=box,color=blue];
		2655 -> 2658;
	2656 [label="Add -2 to Thermostat",color=orange];
		2656 -> 2659;
	2657 [label="Add 2 to Thermostat",color=orange];
		2657 -> 2660;
	2658 [label="Chat ends.",color=orange];
	2659 [label="Дуже добре, узурпаторе. Дуже добре. Саме так. Велике Зло завжди має бути «іншим», і ми ніколи, ніколи не повинні співчувати йому. Якщо ми дозволимо йому відчувати кохання й бути коханим? Я думаю, увесь світ розвалиться навколо нас.",shape=box,color=blue];
		2659 -> 2661;
	2660 [label="Дуже добре, узурпаторе. Дуже добре. Саме так. Ми повинні притягнути Велике Зло до відповідальності. Якщо ми дозволимо йому відчувати кохання й бути коханим? Я думаю, увесь світ розвалиться навколо нас.",shape=box,color=blue];
		2660 -> 2661;
	2661 [label="Update boolean RoatheUnloved3",color=orange];
		2661 -> 2662;
	2662 [label="І де ж тоді опинимося ми?",shape=box,color=blue];
		2662 -> 2663;
