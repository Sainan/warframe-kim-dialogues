	2574 [label="Chat ends.",color=orange];
	2575 [label="Ти запитуєш мене після того, як розповів мені ту історію про Балласа та Марґуліс, і питання не про нього?",shape=box,color=red];
		2575 -> 2581;
	2578 [label="Після того, що Альбрехт зробив із тобою, і всієї цієї історії про «чи можна пробачити орокіна», це питання не про нього?",shape=box,color=red];
		2578 -> 2581;
	2579 [label="Гаразд, підіграю. Чи вірю я, що «кожен заслуговує на любов»? Очевидно, це питання про мораль і цінності.",shape=box,color=red];
		2579 -> 2582;
	2576 [label="Той орокін, який сказав, що ніколи не знав кохання, просто випадково ставить мені це питання, і воно не про нього?",shape=box,color=red];
		2576 -> 2581;
	2577 [label="Той орокін, який служив Виконавиці коханцем і замислив зрадити її, ставить мені це питання, і воно не про нього?",shape=box,color=red];
		2577 -> 2581;
	2580 [label="Ти дійсно очікуєш, що я повірю, що це просто філософське питання?",shape=box,color=red];
		2580 -> 2581;
	2581 [label="Я не хочу загрузнути в деталях. Це все зводить справу до дріб’язковості. «Ну, дививсь, ця людина зробила те, а та людина зробила інше, що це заперечує», — тоді ми всі опиняємось на лаві підсудних у цьому нашому маленькому випробуванні.",shape=box,color=blue];
		2581 -> 2583;
		2581 -> 2584;
	2582 [label="+5 Chemistry",color=orange];
		2582 -> 2585;
	2583 [label="Або кажи прямо, або не кажи нічого. Якщо ти не збираєшся сказати, про кого це насправді, то я не витрачатиму свій час на розмови з тобою.",shape=box,color=red];
		2583 -> 2586;
	2584 [label="Гаразд, зіграймо в твою гру слів.",shape=box,color=red];
		2584 -> 2587;
	2585 [label="Дякую! Усунення імен із цієї нашої маленької скриньки робить його значно прийнятнішим. Інакше ми загрузнемо в деталях і нікуди не просунемось.",shape=box,color=blue];
		2585 -> 2588;
	2586 [label="І я не витрачатиму свій на тебе, от і все.",shape=box,color=blue];
		2586 -> 2589;
	2587 [label="Добре. Питання те ж. Чи кожен заслуговує на любов?",shape=box,color=blue];
		2587 -> 2590;
	2588 [label="І так, ніхто не ставить під сумнів, чи заслуговує праведний герой на любов і на те, щоб його любили. Це не обговорюється в жодній казці та оповіданнях, чи не так?",shape=box,color=blue];
		2588 -> 2591;
	2589 [label="Update boolean RoatheNoDate",color=orange];
		2589 -> 2592;
	2590 [label="Ніхто не ставить під сумнів, чи заслуговує праведний герой на любов і на те, щоб його любили. Це не обговорюється в жодній казці та оповіданнях, чи не так?",shape=box,color=blue];
		2590 -> 2591;
	2591 [label="Лише Пес. Лиходій. Потвора. Морально спустошений Руйнівник Світів.",shape=box,color=blue];
		2591 -> 2593;
		2591 -> 2594;
	2592 [label="Chat ends.",color=orange];
	2593 [label="[Дати йому дописати]",shape=box,color=red];
