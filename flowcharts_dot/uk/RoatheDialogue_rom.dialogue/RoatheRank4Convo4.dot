		"RoatheRank4Convo4 begins." -> j4071947574;
	j4071947574 [label="У мене до тебе філософське питання, узурпаторе. І перш ніж ти зробиш якісь поспішні висновки про те, кого я маю на увазі — чи то мене, чи Балласа, чи Альбрехта — це суто уявний експеримент. Пограймо?",shape=box,color=blue];
		j4071947574 -> j2791834897;
