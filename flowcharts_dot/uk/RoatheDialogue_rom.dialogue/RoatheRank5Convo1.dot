		j3591612755 -> j1247827087 [label="RoatheDating",color=purple];
		j3591612755 -> j1934009866 [label="false",color=purple];
	j2610969294 [label="Спершу я думав, що це Уриїл. Чом би й ні? Інший розум, інша розбита, зламана, покинута душа. Засуджена за вчинки, яких він не обирав.",shape=box,color=blue];
		j2610969294 -> j713413792;
	j1028984573 [label="Evaluate expressions on Promise counter",color=orange];
