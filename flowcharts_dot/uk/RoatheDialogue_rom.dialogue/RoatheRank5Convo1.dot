	j1351763078 [label="Під спогадами, під зовнішністю орокіна, під цією… блакитною шкірою та зараженням, під Уриїлом та цією маскою віцерегента великого карна Роута, яку я ношу…",shape=box,color=blue];
		j1351763078 -> j4183967209;
	j1787590778 [label="Під спогадами, під зовнішністю орокіна, під цією… блакитною шкірою та зараженням, під Уриїлом та цією маскою віцерегента великого карна Роута, яку я ношу…",shape=box,color=blue];
		j1787590778 -> j712681501;
	j2440385305 [label="У тебе є сила. Сила, яка може скасувати час. Закрутити його в завиток, а то й у петлю. І це має… цікавий вплив на розуми протофреймів через їхню прив’язаність до зараження та часу. ",shape=box,color=blue];
		j2440385305 -> j4155287813;
	j1633728024 [label="Ти зможеш, не збрехавши душею, сказати, що твої сили ніколи не використовувалися на розумах протофреймів, яких ти називаєш друзями чи коханими?",shape=box,color=blue];
		j1633728024 -> j40258554;
