	3235 [label="Chat ends.",color=orange];
	3242 [label="І ось тепер я пам’ятаю, мандрівниче. Я пам’ятаю, як відчайдушно благав тебе звільнити мене від спогадів. І твоє слово, що зробиш це. І дотримання обіцянки.",shape=box,color=blue];
		3242 -> 3250;
	3243 [label="І ось тепер я пам’ятаю, мандрівниче. Я пам’ятаю, як просив тебе й отримав відмову. Я просив тебе стерти мій розум від цих думок, а почув «ні». І все ж ми тут, попри все. Чи не так?",shape=box,color=blue];
