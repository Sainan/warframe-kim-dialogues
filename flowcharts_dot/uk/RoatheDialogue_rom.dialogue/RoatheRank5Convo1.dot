		j2754494904 -> j1259265299 [label="false",color=purple];
	j1591548729 [label="У мені вирує скажена звірина, що роз’їдає мене зсередини.",shape=box,color=blue];
		j1591548729 -> j3168300951;
	j2786226042 [label="Тебе не визначають думки тих, хто навколо. Ані те, що вони думають про твої вчинки. Тебе визначає лише те, що ти сам віриш про себе й свої вибори.",shape=box,color=red];
		j2786226042 -> j1030752653;
	j1979467324 [label="Тебе не визначає твоє минуле, Роуте. Тебе визначає твоє майбутнє. І в тебе ще є майбутнє, на відміну від усіх орокінів, що загинули тієї Ночі барабанів наґа.",shape=box,color=red];
		j1979467324 -> j2265095180;
	j592600229 [label="Коли всі спогади зникнуть, коли всі спогади нахлинуть потоком, коли все згорить і повернеться до мене…",shape=box,color=blue];
		j592600229 -> j2892584079;
	j815560505 [label="Коли всі спогади зникнуть, коли всі спогади нахлинуть потоком, коли все згорить і повернеться до мене…",shape=box,color=blue];
		j815560505 -> j3122786304;
	j560820573 [label="Я маю забути про сироватку від Ентраті. Додай до цього ще й біль від слів про кохання, які ти в мене відбираєш. У мене стільки болю, який я хотів би забути… Прошу.",shape=box,color=blue];
		j560820573 -> j1947584629;
		j560820573 -> j1797697865;
		j560820573 -> j4258145081;
	j1824930230 [label="Ми пролили забагато крові. Ми вбили забагато. Ми вкрали забагато життів. Ми зробили забагато поганого. І я роблю все можливе, щоб виправити те небагато, що можу.",shape=box,color=blue];
		j1824930230 -> j2957643424;
