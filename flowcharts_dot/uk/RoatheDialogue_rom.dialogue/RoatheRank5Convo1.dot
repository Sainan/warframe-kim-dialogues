	"Chat ends." [color=orange];
	j921037649 [label="І ось тепер я пам’ятаю, мандрівниче. Я пам’ятаю, як відчайдушно благав тебе звільнити мене від спогадів. І твоє слово, що зробиш це. І дотримання обіцянки.",shape=box,color=blue];
		j921037649 -> j402816675;
	j1710366541 [label="І ось тепер я пам’ятаю, мандрівниче. Я пам’ятаю, як просив тебе й отримав відмову. Я просив тебе стерти мій розум від цих думок, а почув «ні». І все ж ми тут, попри все. Чи не так?",shape=box,color=blue];
		j1710366541 -> j994528516;
	j317824804 [label="І ось тепер я пам’ятаю. Я пам’ятаю, як відчайдушно благав тебе звільнити мене від спогадів. І твоє слово, що зробиш це. І дотримання обіцянки. ",shape=box,color=blue];
		j317824804 -> j2143757027;
	j2954534234 [label="І ось тепер я пам’ятаю. Я пам’ятаю, як просив тебе й отримав відмову. Я просив тебе стерти мій розум від цих думок, а почув «ні». І все ж ми тут, попри все. Чи не так?",shape=box,color=blue];
		j2954534234 -> j1679307730;
	j2116617866 [label="Check boolean RoatheLoved",color=orange];
		j2116617866 -> j2553961486 [label=true,color=green];
		j2116617866 -> j882278968 [label=false,color=brown];
	j3920616854 [label="Check boolean RoatheLoved",color=orange];
		j3920616854 -> j2553961486 [label=true,color=green];
		j3920616854 -> j210476190 [label=false,color=brown];
	j443476310 [label="Я отримав твоє слово. Твоє слово! Але тепер я бачу, що це була просто брехня!",shape=box,color=blue];
		j443476310 -> j3402210009;
		j443476310 -> j1280536897;
	j3219675286 [label="Я мав здогадатися. Я мав здогадатися, що тобі не можна довіряти, аномаліє, народжена в Порожнечі! Тобі було відомо, що на мене там чекає?! Тобі вже було відомо правду, коли я ще не знав?!",shape=box,color=blue];
		j3219675286 -> j4168169119;
		j3219675286 -> j1208991807;
	j402816675 [label="І ось ми знову тут, повернулися туди, де почали. Знову ступаємо по трупах нашого минулого. Не краще, ніж були раніше.",shape=box,color=blue];
		j402816675 -> j69724853;
	j994528516 [label="Схоже, з причин, не залежних від моїх благань! І все ж я пам’ятаю муку свого вибору прийняти ту сироватку.",shape=box,color=blue];
		j994528516 -> j69724853;
	j2143757027 [label="І ось ми знову тут, повернулися туди, де почали. Знову ступаємо по трупах нашого минулого. Не краще, ніж були раніше.",shape=box,color=blue];
		j2143757027 -> j4132806874;
	j1679307730 [label="Схоже, з причин, не залежних від моїх благань! І все ж я пам’ятаю муку свого вибору прийняти ту сироватку.",shape=box,color=blue];
		j1679307730 -> j4132806874;
	j2553961486 [label="Я чув від тебе слова, про які й гадки не мав. Скажи мені ще раз, що вони правдиві. Скажи їх мені. Прошу. Вони мені потрібні зараз. Більше ніж будь-коли.",shape=box,color=blue];
		j2553961486 -> j3719490042;
		j2553961486 -> j875873700;
	j882278968 [label="Я отримав твоє слово. Твоє слово! Ох, скільки солоду в ньому було! Але тепер я бачу, що це була просто брехня!",shape=box,color=blue];
		j882278968 -> j1505012016;
		j882278968 -> j2131226749;
	j210476190 [label="Тобі було відомо?! Було? І тобі потрібно було знайти шлях підібратися ближче, шепотіти слова ніжності, щоб якось пом’якшити майбутній удар?",shape=box,color=blue];
		j210476190 -> j1625195048;
		j210476190 -> j539946234;
	j3402210009 [label="Зупинись на хвильку.",shape=box,color=red];
		j3402210009 -> j2079346147;
	j1280536897 [label="Роуте, зупинися.",shape=box,color=red];
		j1280536897 -> j2079346147;
	j4168169119 [label="Зупинись на хвильку.",shape=box,color=red];
		j4168169119 -> j118499787;
	j1208991807 [label="Роуте, зупинися.",shape=box,color=red];
		j1208991807 -> j118499787;
	j69724853 [label="Як же смішно. Як же неймовірно смішно. Я не можу перемогти. Я просто не можу перемогти!",shape=box,color=blue];
		j69724853 -> j2626571584;
	j4132806874 [label="Як же смішно. Як же неймовірно смішно. Я не можу перемогти. Я просто не можу перемогти!",shape=box,color=blue];
		j4132806874 -> j1162795809;
	j3719490042 [label="Я… не можу. Вибач.",shape=box,color=red];
		j3719490042 -> j2463240674;
	j875873700 [label="Роуте, я кохаю тебе.",shape=box,color=red];
		j875873700 -> j1639286340;
	j1505012016 [label="Зупинись на хвильку.",shape=box,color=red];
		j1505012016 -> j2179341637;
	j2131226749 [label="Роуте, зупинися.",shape=box,color=red];
		j2131226749 -> j2179341637;
	j1625195048 [label="Зупинись на хвильку.",shape=box,color=red];
		j1625195048 -> j1732009430;
	j539946234 [label="Роуте, зупинися.",shape=box,color=red];
		j539946234 -> j1732009430;
	j2079346147 [label="Я ж казав тобі припинити свої замахи на мою думки, поки не пізно! Я казав тобі припинити свою роботу, і все ж… і все ж!",shape=box,color=blue];
		j2079346147 -> j2752520733;
	j118499787 [label="І тобі хотілося це приховати, щоб відкрити зараз? Невже це все було для тебе якоюсь хворою грою?! Нагодувати ту істоту, що ховалася всередині мене, знаючи, що на мене чекає?!",shape=box,color=blue];
		j118499787 -> j3537993663;
	j2626571584 [label="Що тепер, любове? Що тепер?.. Я відчуваю, що стою на кінці своєї умовної мотузки. Принаймні раніше в мене був прихисток моєї приниженості!",shape=box,color=blue];
		j2626571584 -> j1231979579;
	j1162795809 [label="Що тепер, узурпаторе? Що тепер?.. Я відчуваю, що стою на кінці своєї умовної мотузки. Принаймні раніше в мене був прихисток моєї приниженості!",shape=box,color=blue];
		j1162795809 -> j2435819823;
	j2463240674 [label="Я розумію. Повір, більше ніж ти. Я розумію.",shape=box,color=blue];
		j2463240674 -> j434922787;
	j1639286340 [label="Я щиро кохаю тебе. Яку б форму ти не прийняв. Ким би ти не вирішив бути. Я кохаю тебе.",shape=box,color=red];
		j1639286340 -> j101900485;
	j2179341637 [label="Я ж казав тобі припинити свої замахи на мою думки, поки не пізно! Я казав тобі припинити свою роботу, і все ж… і все ж!",shape=box,color=blue];
		j2179341637 -> j497507273;
	j1732009430 [label="І тобі хотілося це приховати, щоб відкрити зараз? Невже це все було для тебе якоюсь хворою грою?! Нагодувати ту істоту, що ховалася всередині мене, знаючи, що на мене чекає?!",shape=box,color=blue];
		j1732009430 -> j3333842441;
	j2752520733 [label="Поглянь на результат своєї роботи!",shape=box,color=blue];
		j2752520733 -> j1134820549;
	j3537993663 [label="Поглянь на результат своєї роботи!",shape=box,color=blue];
		j3537993663 -> j2721336996;
	j1231979579 [label="Ех, я знаю… ось воно. Почати завиток знову. Повернути годинник назад. «Почати знову», так би мовити, чи не так? Покінчи з цією мукою в мені. Почни все ще раз.",shape=box,color=blue];
		j1231979579 -> j4176884194;
		j1231979579 -> j1321098175;
		j1231979579 -> j423340087;
	j2435819823 [label="Ех, я знаю… ось воно. Почати завиток знову. Повернути годинник назад. «Почати знову», так би мовити, чи не так? Покінчи з цією мукою в мені. Почни все ще раз.",shape=box,color=blue];
		j2435819823 -> j3889958830;
