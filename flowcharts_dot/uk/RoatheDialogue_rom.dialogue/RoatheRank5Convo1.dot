		j2892203771 -> j348879813 [label="false",color=purple];
	j4155608712 [label="Ти дозволяєш цьому гніву розривати себе зсередини. Ти міг би використовувати його, щоби боротися з тими, хто досі руйнує цей світ. Тут. Зараз.",shape=box,color=red];
		j4155608712 -> j1929439719;
	j2942982797 [label="Ти направляєш це на себе. Тобі слід направляти це на світ, який звинувачує тебе в тому, що ти зробив усе можливе, щоб урятувати його від орокінської імперії.",shape=box,color=red];
		j2942982797 -> j3789267081;
	j1259265299 [label="Я просто хочу допомогти тобі. Просто хочу знати правильні слова. Тебе наче розриває у два боки. Куди ти хочеш піти?",shape=box,color=red];
		j1259265299 -> j2019671641;
	j3168300951 [label="І я не знаю, як це задовольнити. Я не знаю, чи можу. Я сподівався, що ці розмови підкажуть мені шлях; але тепер я бачу, що це марно.",shape=box,color=blue];
		j3168300951 -> j548933338;
	j1030752653 [label="А проста істина полягає в тому, що ти — один із небагатьох орокінів, що пережили Ніч барабанів наґи. З мого погляду це був стратегічний відступ.",shape=box,color=red];
		j1030752653 -> j4103517110;
	j2265095180 [label="Це єдине, що визначає тебе тепер. Ти можеш змінитися. І ти можеш змінити світ навколо себе. Моє єдине питання — чи ти бодай спробуєш?",shape=box,color=red];
		j2265095180 -> j2618550111;
	j2892584079 [label="Хто лишився?",shape=box,color=blue];
		j2892584079 -> j2986468859;
	j3122786304 [label="Хто лишився?",shape=box,color=blue];
		j3122786304 -> j4208785328;
	j1947584629 [label="Спогад про сироватку — це щось інше, Роуте. Мої сили на нього не подіють. Він закопаний глибоко у твоїй психіці. Але решту… я можу забрати.",shape=box,color=red];
		j1947584629 -> j770569255;
	j1797697865 [label="Якщо тікати та ховатися від правди, ми просто повернемося до того, з чого почали. ",shape=box,color=red];
		j1797697865 -> j1643980011;
	j4258145081 [label="Ти впевнений? Але… ти розумний, і я маю відчуття, що ти якось розберешся, що не так.",shape=box,color=red];
		j4258145081 -> j12646058;
	j2957643424 [label="Любове, як раптом саме ти знайдеш у свому серці саме те, що може допомогти мені в таких справах? Я був би дуже вдячний.",shape=box,color=blue];
		j2957643424 -> j2991763883;
