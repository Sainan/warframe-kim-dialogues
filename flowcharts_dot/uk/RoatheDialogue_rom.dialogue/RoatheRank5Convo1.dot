	3249 [label="Я отримав твоє слово. Твоє слово! Але тепер я бачу, що це була просто брехня!",shape=box,color=blue];
		3249 -> 3259;
		3249 -> 3260;
	3248 [label="Я мав здогадатися. Я мав здогадатися, що тобі не можна довіряти, аномаліє, народжена в Порожнечі! Тобі було відомо, що на мене там чекає?! Тобі вже було відомо правду, коли я ще не знав?!",shape=box,color=blue];
		3248 -> 3257;
		3248 -> 3258;
	3754 [label="Chat ends.",color=orange];
	3241 [label="Chat ends.",color=orange];
	3250 [label="І ось ми знову тут, повернулися туди, де почали. Знову ступаємо по трупах нашого минулого. Не краще, ніж були раніше.",shape=box,color=blue];
		3250 -> 3261;
	3251 [label="Схоже, з причин, не залежних від моїх благань! І все ж я пам’ятаю муку свого вибору прийняти ту сироватку.",shape=box,color=blue];
		3251 -> 3261;
	3252 [label="І ось ми знову тут, повернулися туди, де почали. Знову ступаємо по трупах нашого минулого. Не краще, ніж були раніше.",shape=box,color=blue];
		3252 -> 3262;
	3253 [label="Схоже, з причин, не залежних від моїх благань! І все ж я пам’ятаю муку свого вибору прийняти ту сироватку.",shape=box,color=blue];
		3253 -> 3262;
	3254 [label="Я чув від тебе слова, про які й гадки не мав. Скажи мені ще раз, що вони правдиві. Скажи їх мені. Прошу. Вони мені потрібні зараз. Більше ніж будь-коли.",shape=box,color=blue];
		3254 -> 3263;
		3254 -> 3264;
	3256 [label="Я отримав твоє слово. Твоє слово! Ох, скільки солоду в ньому було! Але тепер я бачу, що це була просто брехня!",shape=box,color=blue];
		3256 -> 3267;
		3256 -> 3268;
	3255 [label="Тобі було відомо?! Було? І тобі потрібно було знайти шлях підібратися ближче, шепотіти слова ніжності, щоб якось пом’якшити майбутній удар?",shape=box,color=blue];
		3255 -> 3265;
