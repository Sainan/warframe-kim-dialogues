		j2420191117 -> j1591548729;
	j2681121817 [label="Якщо ти хочеш обрати шлях і прокласти його сам і для себе, зроби це. Не вибачайся. Але це твій шлях, і лише твій.",shape=box,color=red];
		j2681121817 -> j2786226042;
	j27918187 [label="Якщо прагнеш шукати прощення, можеш це робити. Але ти мусиш цього хотіти. Ти мусиш обрати цей шлях. Ніхто інший не зробить це за тебе.",shape=box,color=red];
		j27918187 -> j1979467324;
	j4183967209 [label="Хто я?..",shape=box,color=blue];
		j4183967209 -> j592600229;
	j712681501 [label="Хто я?..",shape=box,color=blue];
		j712681501 -> j815560505;
	j4155287813 [label="Отже, і нашу прив’язаність до часу. Я прошу тебе зараз. Ні, я благаю. Скористайся своїми силами заради мене. Забери в мене ці думки. Забери в мене ці спогади.",shape=box,color=blue];
		j4155287813 -> j560820573;
	j40258554 [label="Тоді добре. Хай буде так. Я не проситиму тебе більше. Але чи було хоч раз таке, що твої сили використовувалися просто для власної розваги, цікавості чи щоб виправити непотрібні помилки в стосунках з іншими?!",shape=box,color=blue];
		j40258554 -> j560820573;
	j566567126 [label="Тож я вирішив провести решту своїх днів за виправленням помилок, які мій нещасний народ вважав за потрібне вчинити в цій системі від самого початку часів. ",shape=box,color=blue];
		j566567126 -> j1824930230;
	j3637328760 [label="Мої плани та задуми щодо влади належать винятково й повністю мені. А ти, любове, будеш правити всіма… якщо забажаєш.",shape=box,color=blue];
		j3637328760 -> j2194092224;
	j1925433814 [label="Я маю два слова і дуже сподіваюся, що ти їх не забудеш, бо я знаю, що вони тобі доволі знайомі!",shape=box,color=blue];
		j1925433814 -> j3792804762;
	j3549563229 [label="Що ж! Дозволь мені відпустити тебе до твоїх справ. Дуже перепрошую, що потурбував!",shape=box,color=blue];
		j3549563229 -> j1925433814;
	j3318357834 [label="Evaluate expressions",color=orange];
		j3318357834 -> j1542331650 [label="RoatheForgivenessShortcut",color=purple];
		j3318357834 -> j169486033 [label="RoatheVillainyShortcut",color=purple];
		j3318357834 -> j101806178 [label="false",color=purple];
	j943217566 [label="Невже від цього я хотів звільнитися щоразу, коли прагнув вчепитися цими кігтями у власну шкіру та розірвати її?! ",shape=box,color=blue];
		j943217566 -> j2854704042;
	j1547312662 [label="Boolean RoatheFail is now true.",color=orange];
		j1547312662 -> j3374135053;
	j556813598 [label="ПОЧНИ.",shape=box,color=blue];
