		j3374135053 -> j1573412299;
	j1390052325 [label="ЗНОВУ.",shape=box,color=blue];
		j1390052325 -> j4162653135;
	j3200226755 [label="Я знаю, як це — завжди намагатися втекти від чогось, від чого ніколи не зможеш звільнитися. Намагатися втекти від чогось, що завжди переслідуватиме тебе, як би далеко ти не зайшов.",shape=box,color=red];
		j3200226755 -> j393311398;
	j3783549202 [label="Скільки свого життя ти провів у переховуванні від самого себе, Роуте? Скільки свого життя ти провів, ховаючись за маскою, за цим фасадом?",shape=box,color=red];
		j3783549202 -> j867705989;
	j2892203771 [label="Evaluate expressions on Thermostat counter",color=orange];
