	j4208785328 [label="Чи взагалі хочу я ним бути?",shape=box,color=blue];
		j4208785328 -> j863020305;
	j770569255 [label="Можливо. Ти, мабуть, маєш рацію. Але ж я не маю інших варіантів, чи не так? Варто спробувати. Принаймні твої слова про відхилене кохання зникнуть з моєї пам’яті.",shape=box,color=blue];
		j770569255 -> j2200270931;
	j1643980011 [label="І якщо це так, ти можеш просто зробити це ще раз. Ці ж сили в тебе ніби невичерпні, чи не так?",shape=box,color=blue];
		j1643980011 -> j2200270931;
