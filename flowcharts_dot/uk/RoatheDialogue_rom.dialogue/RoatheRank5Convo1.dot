	3266 [label="Роуте, зупинися.",shape=box,color=red];
		3266 -> 3275;
	3270 [label="Я ж казав тобі припинити свої замахи на мою думки, поки не пізно! Я казав тобі припинити свою роботу, і все ж… і все ж!",shape=box,color=blue];
		3270 -> 3278;
	3269 [label="І тобі хотілося це приховати, щоб відкрити зараз? Невже це все було для тебе якоюсь хворою грою?! Нагодувати ту істоту, що ховалася всередині мене, знаючи, що на мене чекає?!",shape=box,color=blue];
		3269 -> 3277;
	3271 [label="Що тепер, любове? Що тепер?.. Я відчуваю, що стою на кінці своєї умовної мотузки. Принаймні раніше в мене був прихисток моєї приниженості!",shape=box,color=blue];
		3271 -> 3279;
	3272 [label="Що тепер, узурпаторе? Що тепер?.. Я відчуваю, що стою на кінці своєї умовної мотузки. Принаймні раніше в мене був прихисток моєї приниженості!",shape=box,color=blue];
		3272 -> 3280;
	3273 [label="Я розумію. Повір, більше ніж ти. Я розумію.",shape=box,color=blue];
		3273 -> 3281;
	3274 [label="Я щиро кохаю тебе. Яку б форму ти не прийняв. Ким би ти не вирішив бути. Я кохаю тебе.",shape=box,color=red];
		3274 -> 3282;
	3276 [label="Я ж казав тобі припинити свої замахи на мою думки, поки не пізно! Я казав тобі припинити свою роботу, і все ж… і все ж!",shape=box,color=blue];
		3276 -> 3284;
	3275 [label="І тобі хотілося це приховати, щоб відкрити зараз? Невже це все було для тебе якоюсь хворою грою?! Нагодувати ту істоту, що ховалася всередині мене, знаючи, що на мене чекає?!",shape=box,color=blue];
		3275 -> 3283;
