	j2416385652 [label="Відколи мої спогади зникли, протягом усього цього божевілля я відчував… шкрябання. Це розривання грудей, шкіри, наче якийсь великий звір відчайдушно прагнув вирватися з мене.",shape=box,color=blue];
		j2416385652 -> j2610969294;
	j3591612755 [label="Evaluate expressions",color=orange];
		j3591612755 -> j1028984573 [label="RoatheKnowsReset2 & RoatheDating",color=purple];
