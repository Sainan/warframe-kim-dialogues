		3258 -> 3269;
	3261 [label="Як же смішно. Як же неймовірно смішно. Я не можу перемогти. Я просто не можу перемогти!",shape=box,color=blue];
		3261 -> 3271;
	3262 [label="Як же смішно. Як же неймовірно смішно. Я не можу перемогти. Я просто не можу перемогти!",shape=box,color=blue];
