		j3428831783 -> j974440650;
	j1275050816 [label="Отже, і нашу прив’язаність до часу. Я прошу тебе зараз. Ні, я благаю. Скористайся своїми силами заради мене. Забери в мене ці думки. Забери в мене ці спогади.",shape=box,color=blue];
		j1275050816 -> j1836086507;
	j1274614366 [label="Тоді добре. Хай буде так. Я не проситиму тебе більше. Але чи було хоч раз таке, що твої сили використовувалися просто для власної розваги, цікавості чи щоб виправити непотрібні помилки в стосунках з іншими?!",shape=box,color=blue];
		j1274614366 -> j1836086507;
	j643065613 [label="Цей «новий поворот» у моєму житті. Добре. Я погоджуюся й приймаю твій аргумент. Дякую, мандрівниче, за те, що… тобі вдалося відмовити мене від цієї конкретної проблеми.",shape=box,color=blue];
		j643065613 -> j4094289456;
	j2207788675 [label="Ти впевнений? Але… ти розумний, і я маю відчуття, що ти якось розберешся, що не так.",shape=box,color=red];
		j2207788675 -> j1659110894;
	j3784950064 [label="Це інший вид спогаду, Роуте. Мої сили на нього не подіють. Він закопаний глибоко у твоїй психіці.",shape=box,color=red];
		j3784950064 -> j2989303087;
