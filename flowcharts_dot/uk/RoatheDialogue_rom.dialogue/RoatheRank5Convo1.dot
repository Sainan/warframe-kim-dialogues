	3201 [label="Зневажений, незрозумілий, заборонений. Скинутий із небес і залишений гнити. Справжні споріднені духи!",shape=box,color=blue];
		3201 -> 3210;
	3202 [label="Я знаю, що це не вперше ми проходимо крізь це. Я пам’ятаю, що вже був тут. І знаю, що це може бути не востаннє. Я постійно прошу тебе зупинитися тут і почати знову, і коли ти так робиш, для мене це неймовірно важливо.",shape=box,color=blue];
		3202 -> 5778;
	3203 [label="Я знаю, що це не вперше ми проходимо крізь це. Я пам’ятаю, що вже був тут. І знаю, що це може бути не востаннє. Я постійно прошу тебе зупинитися тут і почати знову, і коли ти так робиш, для мене це неймовірно важливо.",shape=box,color=blue];
		3203 -> 3211;
	3204 [label="Я знаю, що це не вперше ми проходимо крізь це. Я пам’ятаю, що вже був тут. І знаю, що це може бути не востаннє. Я постійно прошу тебе зупинитися тут і почати знову, і коли ти так робиш, для мене це неймовірно важливо.",shape=box,color=blue];
		3204 -> 3212;
	3205 [label="Мушу похвалити тебе, узурпаторе, за те, що ти вчиняєш так, як я просив, і не заглиблюєшся в Темний Спогадарій та мої спогади в «Спуску». Попри відсутність обіцянок.",shape=box,color=blue];
		3205 -> 3213;
	3206 [label="Любове, мушу похвалити тебе за дотримання слова і що ти не заглиблюєшся в «Спуск» і Темний Спогадарій та не відкриваєш останній спогад про мене. Це важливо для мене.",shape=box,color=blue];
		3206 -> 3214;
	3207 [label="Любове, мушу похвалити тебе за те, що ти вчиняєш так, як я просив, і не заглиблюєшся в Темний Спогадарій та мої спогади в «Спуску». Це важливо для мене.",shape=box,color=blue];
		3207 -> 3214;
	3208 [label="Узурпаторе, мушу похвалити тебе за дотримання слова і що ти не заглиблюєшся в «Спуск» і Темний Спогадарій та не відкриваєш останній спогад про мене.",shape=box,color=blue];
		3208 -> 3215;
	3209 [label="Мушу похвалити тебе, узурпаторе, за те, що ти вчиняєш так, як я просив, і не заглиблюєшся в Темний Спогадарій та мої спогади в «Спуску». Попри відсутність обіцянок.",shape=box,color=blue];
		3209 -> 3215;
	3210 [label="Коли прийшли новобранці, три енергії сплелися з моїми власними, і четверта вже не була такою дивною. Це велике жахливе створіння, що прагнуло розірвати мене, як кору планети, аби вивергнутися назовні.",shape=box,color=blue];
		3210 -> 3216;
	5778 [label="I remember your promise to me. And that I have found such a place in your heart that you keep me in such a purgatorial state? Thank you, my pet. Thank you.",shape=box,color=blue];
		5778 -> 3217;
	3211 [label="Я дякую тобі, солодке створіння, за те, що я знайшов таке місце у твоєму серці, що ти тримаєш мене в цьому чистилищі. Дякую.",shape=box,color=blue];
		3211 -> 3217;
	3212 [label="Я пам’ятаю твою обіцянку мені. І те, що я знайшов таке місце у твоєму серці, що ти тримаєш мене в цьому чистилищі? Дякую тобі, любове. Дякую.",shape=box,color=blue];
		3212 -> 3218;
	3213 [label="Дякую тобі, друже, за те, що я знайшов таку дружбу із тобою, що ти тримаєш мене в цьому чистилищі.",shape=box,color=blue];
		3213 -> 3218;
	3214 [label="Хоч я й досі відчуваю, як щось гризе мене на краю свідомості, наче куброу, що гавкає на кінці повідця. Керовано. Треновано.",shape=box,color=blue];
		3214 -> 3219;
