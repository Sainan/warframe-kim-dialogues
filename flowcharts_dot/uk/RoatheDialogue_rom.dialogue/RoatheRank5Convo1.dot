	j867705989 [label="Грати в ці ігри. Танцювати на чужих нитках. Робити те, що від тебе очікують. Коли від тебе очікують. Як від тебе очікують. Боротися в чужих війнах. Ось що тебе розриває на шматки.",shape=box,color=red];
		j867705989 -> j1512038684;
	j1501808980 [label="Я знаю. У цьому немає нічого справедливого. Але й у житті немає нічого справедливого, чи не так? Але ти до цього звик. І ти звик змушувати це працювати.",shape=box,color=red];
