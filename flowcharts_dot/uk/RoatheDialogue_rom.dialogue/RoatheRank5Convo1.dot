		3277 -> 3285;
	3279 [label="Ех, я знаю… ось воно. Почати завиток знову. Повернути годинник назад. «Почати знову», так би мовити, чи не так? Покінчи з цією мукою в мені. Почни все ще раз.",shape=box,color=blue];
		3279 -> 3287;
		3279 -> 3288;
		3279 -> 3289;
	3280 [label="Ех, я знаю… ось воно. Почати завиток знову. Повернути годинник назад. «Почати знову», так би мовити, чи не так? Покінчи з цією мукою в мені. Почни все ще раз.",shape=box,color=blue];
		3280 -> 3290;
		3280 -> 3291;
