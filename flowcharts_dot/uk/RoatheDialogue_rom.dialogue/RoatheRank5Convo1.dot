		j373899908 -> j2172120963;
	j2027350789 [label="Отже, і нашу прив’язаність до часу. Я прошу тебе зараз. Ні, я благаю. Скористайся своїми силами заради мене. Забери в мене ці думки. Забери в мене ці спогади.",shape=box,color=blue];
		j2027350789 -> j2627670677;
	j719475561 [label="Тоді добре. Хай буде так. Я не проситиму тебе більше. Але чи було хоч раз таке, що твої сили використовувалися просто для власної розваги, цікавості чи щоб виправити непотрібні помилки в стосунках з іншими?!",shape=box,color=blue];
		j719475561 -> j2627670677;
	j1057494371 [label="Мені час іти. У мене настрій випити купу алкоголю та похмуро дивитися вдалечінь.",shape=box,color=blue];
		j1057494371 -> "Chat ends. Next chat will be Roathe5Day2.";
	j4153598139 [label="Гадаю, цю маску я носитиму ще дуже довго. Навіть якщо не буду тримати її в серці. Але… у твоїх словах є сенс.",shape=box,color=blue];
		j4153598139 -> j2882967255;
	j3696102776 [label="Але стати тим, ким, як я завжди міг бути, вільним від того, що мене стримувало? Так. Так, у цьому я можу знайти велику радість.",shape=box,color=blue];
		j3696102776 -> j2167618208;
	j4140353433 [label="Тож я дам тобі ще одну можливість переконати мене. Власне, я дозволю тобі обрати, яким шляхом ми підемо. Моя частина угоди виконана. Просто пам’ятай, ти в боргу перед дияволом. І я його стягну.",shape=box,color=blue];
		j4140353433 -> j1137026383;
	j2283865753 [label="Принаймні двічі! Наскільки мені відомо! Хто знає, скільки разів ми вже були тут. ",shape=box,color=blue];
		j2283865753 -> j3479725423;
	j3409649574 [label="Тож я дам тобі ще одну можливість переконати мене. Власне, я дозволю тобі обрати, яким шляхом ми підемо. Моя частина угоди виконана. Просто пам’ятай, ти в боргу перед дияволом. І я його стягну.",shape=box,color=blue];
