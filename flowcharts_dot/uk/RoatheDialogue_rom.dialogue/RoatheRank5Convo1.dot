		j1247827087 -> j2527561171 [label="x <= 1",color=purple];
		j1247827087 -> j2527561171 [label="false",color=purple];
	j1934009866 [label="Evaluate expressions on Promise counter",color=orange];
		j1934009866 -> j4213073961 [label="x >= 1",color=purple];
		j1934009866 -> j1543956554 [label="x <= 1",color=purple];
		j1934009866 -> j1543956554 [label="false",color=purple];
	j713413792 [label="Зневажений, незрозумілий, заборонений. Скинутий із небес і залишений гнити. Справжні споріднені духи!",shape=box,color=blue];
		j713413792 -> j2840203791;
	j2867789787 [label="Я знаю, що це не вперше ми проходимо крізь це. Я пам’ятаю, що вже був тут. І знаю, що це може бути не востаннє. Я постійно прошу тебе зупинитися тут і почати знову, і коли ти так робиш, для мене це неймовірно важливо.",shape=box,color=blue];
		j2867789787 -> j2742375873;
	j1033743551 [label="Я знаю, що це не вперше ми проходимо крізь це. Я пам’ятаю, що вже був тут. І знаю, що це може бути не востаннє. Я постійно прошу тебе зупинитися тут і почати знову, і коли ти так робиш, для мене це неймовірно важливо.",shape=box,color=blue];
		j1033743551 -> j3025493586;
	j1206517257 [label="Я знаю, що це не вперше ми проходимо крізь це. Я пам’ятаю, що вже був тут. І знаю, що це може бути не востаннє. Я постійно прошу тебе зупинитися тут і почати знову, і коли ти так робиш, для мене це неймовірно важливо.",shape=box,color=blue];
		j1206517257 -> j2671604224;
	j1778299468 [label="Мушу похвалити тебе, узурпаторе, за те, що ти вчиняєш так, як я просив, і не заглиблюєшся в Темний Спогадарій та мої спогади в «Спуску». Попри відсутність обіцянок.",shape=box,color=blue];
		j1778299468 -> j2161174190;
	j2371420787 [label="Любове, мушу похвалити тебе за дотримання слова і що ти не заглиблюєшся в «Спуск» і Темний Спогадарій та не відкриваєш останній спогад про мене. Це важливо для мене.",shape=box,color=blue];
		j2371420787 -> j2077763884;
	j2527561171 [label="Любове, мушу похвалити тебе за те, що ти вчиняєш так, як я просив, і не заглиблюєшся в Темний Спогадарій та мої спогади в «Спуску». Це важливо для мене.",shape=box,color=blue];
		j2527561171 -> j2077763884;
	j4213073961 [label="Узурпаторе, мушу похвалити тебе за дотримання слова і що ти не заглиблюєшся в «Спуск» і Темний Спогадарій та не відкриваєш останній спогад про мене.",shape=box,color=blue];
		j4213073961 -> j1340475493;
	j1543956554 [label="Мушу похвалити тебе, узурпаторе, за те, що ти вчиняєш так, як я просив, і не заглиблюєшся в Темний Спогадарій та мої спогади в «Спуску». Попри відсутність обіцянок.",shape=box,color=blue];
		j1543956554 -> j1340475493;
	j2840203791 [label="Коли прийшли новобранці, три енергії сплелися з моїми власними, і четверта вже не була такою дивною. Це велике жахливе створіння, що прагнуло розірвати мене, як кору планети, аби вивергнутися назовні.",shape=box,color=blue];
		j2840203791 -> j544648073;
	j2742375873 [label="Я пам’ятаю твою обіцянку мені. І те, що я знайшов таке місце у твоєму серці, що ти тримаєш мене в цьому чистилищі? Дякую тобі, любове. Дякую.",shape=box,color=blue];
		j2742375873 -> j2077763884;
	j3025493586 [label="Я дякую тобі, солодке створіння, за те, що я знайшов таке місце у твоєму серці, що ти тримаєш мене в цьому чистилищі. Дякую.",shape=box,color=blue];
		j3025493586 -> j2077763884;
	j2671604224 [label="Я пам’ятаю твою обіцянку мені. І те, що я знайшов таку дружбу з тобою, що ти тримаєш мене в цьому чистилищі? Дякую тобі, друже. Дякую.",shape=box,color=blue];
		j2671604224 -> j1340475493;
	j2161174190 [label="Дякую тобі, друже, за те, що я знайшов таку дружбу із тобою, що ти тримаєш мене в цьому чистилищі.",shape=box,color=blue];
		j2161174190 -> j1340475493;
	j2077763884 [label="Хоч я й досі відчуваю, як щось гризе мене на краю свідомості, наче куброу, що гавкає на кінці повідця. Керовано. Треновано.",shape=box,color=blue];
		j2077763884 -> j2121578721;
	j1340475493 [label="Хоч я й досі відчуваю, як щось гризе мене на краю свідомості, наче куброу, що гавкає на кінці повідця. Керовано. Треновано.",shape=box,color=blue];
		j1340475493 -> j4160359619;
	j544648073 [label="Що таке ще один?",shape=box,color=blue];
