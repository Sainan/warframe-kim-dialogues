	3285 [label="Ти маєш це виправити, я вимагаю. Я знаю, ти можеш! Скористайся своєю силою і випали ці спогади з моєї голови!",shape=box,color=blue];
		3285 -> 3297;
		3285 -> 3298;
		3285 -> 3299;
	3287 [label="Це не позбавить від болю глибших спогадів, Роуте… лише від цих поверхневих. Це не розв’яже проблему.",shape=box,color=red];
		3287 -> 3303;
