	3491 [label="А проста істина полягає в тому, що ти — один із небагатьох орокінів, що пережили Ніч барабанів наґи. З моєї точки зору це був стратегічний відступ.",shape=box,color=red];
		3491 -> 3514;
	3495 [label="Але в певний момент нам доведеться розвернутися й зустрітися з цим віч-на-віч. У певний момент більше не буде можливості тікати.",shape=box,color=red];
