		j1596650655 -> j2892203771 [label="false",color=purple];
	j1461499209 [label="Гнів нічого не вирішить, Роуте. Ти злишся, бо боїшся зізнатися в скоєному. І в тому, ким ти став.",shape=box,color=red];
		j1461499209 -> j4155608712;
	j121941648 [label="Гаразд. Злися. Але використай цей гнів на благо. Використай його, щоби позбутися ненависті, яку скеровуєш не в тому напрямку.",shape=box,color=red];
		j121941648 -> j2942982797;
