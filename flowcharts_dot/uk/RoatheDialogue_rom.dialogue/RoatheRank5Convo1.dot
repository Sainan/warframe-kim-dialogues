	j2019671641 [label="Boolean RoatheFail is now true.",color=orange];
		j2019671641 -> j2731671149;
	j548933338 [label="Однак є рішення, чи не так? У твоїх силах виправити це… ці жахливі муки в моїй свідомості.",shape=box,color=blue];
		j548933338 -> j562962359;
	j4103517110 [label="Ні більше. Ні менше.",shape=box,color=red];
		j4103517110 -> j3127707193;
	j2618550111 [label="Спробуєш пробачити себе й рухатися вперед?",shape=box,color=red];
