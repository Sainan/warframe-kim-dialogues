	1886 [label="Здається, ти маєш наміри бігати по цьому всесвіту за Альбрехтом, прибираючи за ним. Поглянь на свою роботу з його дворецьким. ",shape=box,color=blue];
		1886 -> 1889;
	1887 [label="Здається, ти маєш наміри бігати по цьому всесвіту за Альбрехтом, прибираючи за ним.",shape=box,color=blue];
		1887 -> 1889;
	1889 [label="Check boolean IsDating",color=orange];
		1889 -> 1891 [label=true,color=green];
		1889 -> 1890 [label=false,color=brown];
	1891 [label="Здається, ти маєш свої проблеми, якими ти зараз займаєшся, і я тебе за це поважаю, не засуджую тебе. Мені просто дивно, що хтось такий дивовижний та надзвичайно зухвалий, може бути настільки слухняним. ",shape=box,color=blue];
		1891 -> 1892;
		1891 -> 1893;
		1891 -> 1894;
	1890 [label="Мені просто дивно, що хтось такий дивовижний та надзвичайно зухвалий, може бути настільки слухняним. ",shape=box,color=blue];
		1890 -> 1892;
		1890 -> 1893;
		1890 -> 1894;
	1892 [label="Дозволити Байдужості знищити Материнську систему, чи будь-яку іншу, нікому не допоможе.",shape=box,color=red];
		1892 -> 1895;
	1893 [label="Я не підкоряюся Ентраті.",shape=box,color=red];
		1893 -> 1896;
	1894 [label="У мене є свої причини. І вони тільки мої.",shape=box,color=red];
		1894 -> 1897;
	1895 [label="А, зрозуміло. Ти просто надаєш тимчасові послуги, поки не вирішиться ситуація з «Байдужістю». А що ти плануєш робити потім?",shape=box,color=blue];
		1895 -> 1898;
		1895 -> 1899;
		1895 -> 1900;
		1895 -> 1901;
		1895 -> 1902;
	1896 [label="Справді? А мені так не здається. Він клацає пальцями, ти підкоряєшся та сідаєш біля його ніг наче дресований куброу. Він навіть шепоче ім’я «Тау», а ти намагаєшся пригадати кожну можливу деталь місця, яке було втрачене.",shape=box,color=blue];
		1896 -> 1903;
		1896 -> 1904;
	1897 [label="Так загадково, так незбагненно! І така купа дурниць. Якщо ти просто не хочеш визнати, що ти в його розпорядженні, то нехай так і буде.",shape=box,color=blue];
		1897 -> 1905;
	1898 [label="Чому ти зачіпаєш мене? Про що насправді ти хочеш запитати?",shape=box,color=red];
		1898 -> 1906;
	1899 [label="Чесно кажучи, у мене ще не має планів так далеко наперед.",shape=box,color=red];
		1899 -> 1907;
	1900 [label="Я маю намір змусити його заплатити за те, що він тут наробив. Йому є за що спокутувати провину. ",shape=box,color=red];
		1900 -> 1908;
	1901 [label="Ти маєш на увазі, якщо я виживу?",shape=box,color=red];
		1901 -> 1909;
	1902 [label="Піду туди, де потрібна моя допомога, як завжди. Проблеми самі мене знаходять.",shape=box,color=red];
		1902 -> 1910;
	1903 [label="Чому ти так намагаєшся мене розлютити?",shape=box,color=red];
		1903 -> 1911;
	1904 [label="Я просто роблю те, що має, щоб допомогти людям вибратися з жахливих ситуацій, в яких вони опинилися.",shape=box,color=red];
		1904 -> 1912;
	1905 [label="Бо мені здається, що він клацає пальцями, ти підкоряєшся та сідаєш біля його ніг наче дресований куброу. Він навіть шепоче ім’я «Тау», а ти намагаєшся пригадати кожну можливу деталь місця, яке було втрачене.",shape=box,color=blue];
		1905 -> 1903;
		1905 -> 1904;
	1906 [label="+5 Chemistry",color=orange];
		1906 -> 1913;
	1907 [label="Ох! То ти визнаєш себе ідіотом! Як приємно. Я обожнюю, коли дурні відкрито демонструють свою недалекість, це значно полегшує мені завдання маніпулювати ними.",shape=box,color=blue];
		1907 -> 1914;
	1908 [label="Ох! То ти прагнеш примітивної, первісної помсти! Чудово. Ти як скажений звір, готовий гризти кістки тих, хто заподіяв тобі кривду.",shape=box,color=blue];
		1908 -> 1915;
	1909 [label="+5 Chemistry",color=orange];
		1909 -> 1916;
	1910 [label="А зрозуміло. Апатія, прихована за благородством. Ти не знаєш, де твоє місце, де тобі слід залишитися, тому ти прикриваєшся маскою «праведної жертви» та виконуєш волю інших?",shape=box,color=blue];
		1910 -> 1917;
	1911 [label="Тому що я ніяк не можу зрозуміти, чому ти, істота, яка, наскільки я можу судити, походить з іншої версії реальності, вирішила бігати крізь час і простір, «граючись у лікаря».",shape=box,color=blue];
		1911 -> 1918;
	1912 [label="Так, це й є головним питанням! Чому ти наполегливо блукаєш у часі та просторі, «граючись у лікаря»? Ти, істота, яка, наскільки я можу судити, походить з іншої версії реальності. ",shape=box,color=blue];
		1912 -> 1918;
	1913 [label="Проникливо. Так, добре, я перейду до суті того, про що прошу. Я намагався роздратувати тебе, щоби побачити, чи це спонукає тебе на більш чесну відповідь.",shape=box,color=blue];
		1913 -> 1919;
	1914 [label="Ти як куброу, який нарешті спіймав кайта. Ти не знаєш, що робити, коли вже вчепився зубами в його ногу.",shape=box,color=blue];
		1914 -> 1904;
		1914 -> 1903;
	1915 [label="Одна з найпростіших і найдавніших людських мотивацій. А, отже, одна з найлегших для розуміння.",shape=box,color=blue];
		1915 -> 1904;
	1916 [label="Тобі ніколи не довелося бути солдатом, але у твоєму тоні я чую втому найзагартованішого з усіх бійців.",shape=box,color=blue];
		1916 -> 1920;
	1917 [label="Як це трагічно.",shape=box,color=blue];
		1917 -> 1921;
		1917 -> 1922;
	1918 [label="Якби я був на твоєму місці, то повернувся б у Дувірі, щоб спробувати знайти інші дірки в матерії Порожнечі, які я міг би пробити! Уяви собі можливості! Уяви собі світи, готові до завоювання!",shape=box,color=blue];
		1918 -> 1923;
		1918 -> 1924;
	1919 [label="Але, мабуть, це доведеться зробити.",shape=box,color=blue];
		1919 -> 1925;
	1920 [label="Дуже добре. З повагою до тебе, я перейду до суті того, про що прошу. Я намагався роздратувати тебе, щоби побачити, чи це спонукає тебе на більш чесну відповідь.",shape=box,color=blue];
		1920 -> 1925;
	1921 [label="У мене є місце, якому я належу.",shape=box,color=red];
		1921 -> 1926;
	1922 [label="Ти не знаєш, про що говориш.",shape=box,color=red];
		1922 -> 1927;
	1923 [label="Ти нічим не відрізняєшся від Альбрехта. Він подорожує в часі, створюючи всі ці проблеми. А ти хочеш зробити це з цілими вимірами?!",shape=box,color=red];
		1923 -> 1928;
	1924 [label="Ось у чому проблема з вами, орокінами. Ви думаєте, що цілі світи належать тільки вам і ви можете робити з ними все, що заманеться. ",shape=box,color=red];
		1924 -> 1929;
	1925 [label="+5 Chemistry",color=orange];
		1925 -> 1930;
	1926 [label="Тоді розкажи! Це Голвенія? Або, можливо, Дувірі? Або, можливо, твій розбитий орбітр на тому, що залишилося від Землі?",shape=box,color=blue];
		1926 -> 1904;
		1926 -> 1903;
	1927 [label="Тоді розкажи мені все про те, де твій дім! Це Голвенія? Або, можливо, Дувірі? Або, можливо, твій розбитий орбітр на тому, що залишилося від Землі?",shape=box,color=blue];
		1927 -> 1904;
		1927 -> 1903;
	1928 [label="А чому б і ні? Ми ж вищі створіння, чи не так? Альбрехт робить, що йому заманеться, а ти без проблем прибираєш за ним! Чому я не маю права робити те саме? Чому його завдання «виправдані», а мої — ні?",shape=box,color=blue];
		1928 -> 1931;
	1929 [label="А чому б і ні? Адже ми ж вищі створіння, чи не так? Альбрехт робить те, що йому заманеться, бігаючи крізь час, заражаючи народ хворобою, яку він ледь розуміє, і все це в ім’я «перемоги над так званим богом».",shape=box,color=blue];
		1929 -> 1931;
