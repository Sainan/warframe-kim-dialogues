		1882 -> 1883;
	1881 [label="Я міг би перерахувати весь список, але боюся, що ми просидимо тут весь день. Ні, мої запитання з цього приводу стосуються конкретно однієї теми. Принаймні сьогодні.",shape=box,color=blue];
