	1951 [label="Якщо ти вважаєш, що те, що я роблю, є незначним, то це ваша думка. Зроблене мною переписало історію.",shape=box,color=red];
		1951 -> 1957;
	1952 [label="Не незначним. Непомітним. Нехай всі бігають навколо, привертаючи увагу. Я залишуся в тіні.",shape=box,color=red];
		1952 -> 1958;
	1953 [label="Тому що допомагаючи людям, коли вони цього потребують, ми зрештою виберемося з цієї скрути.",shape=box,color=red];
		1953 -> 1959;
	1954 [label="Тому що я роблю те, що потрібно зробити. Нічого більше, нічого менше.",shape=box,color=red];
		1954 -> 1960;
	1956 [label="Ти сказав, що ніколи не знав, як це – бути коханим. Я не думаю, що ти зрозумієш, наскільки це може бути сильним, щоб змінити світ навколо тебе.",shape=box,color=red];
		1956 -> 1962;
	1955 [label="Ти коли-небудь кохав, Роате? Або так сильно піклувався про когось, що готовий був би спалити всесвіт заради цієї людини?",shape=box,color=red];
		1955 -> 1961;
	1957 [label="Саме це я і маю на увазі! Тоді пропоную переписати історію! Не сидімо тут, намагаючись переконати всіх триматися за руки та співати пісень!",shape=box,color=blue];
		1957 -> 1963;
		1957 -> 1964;
		1957 -> 1965;
	1958 [label="А, розумію, ти волієш бути тихим вбивцею в тіні, так? Завдавати удару, коли тебе найменше підозрюють? Ні. Я так не думаю. Я думаю, ти просто марнуєш час.",shape=box,color=blue];
		1958 -> 1966;
	1959 [label="М-гм-м. Виконувати доручення для незнайомців, поки вони не почнуть шанувати тебе як місцевого героя? Або переконувати їх усіх триматися за руки та співати пісні? Вибач, я піду поблюю в акваріум Фібоначчі.",shape=box,color=blue];
		1959 -> 1967;
		1959 -> 1968;
	1960 [label="А те, що ти «робиш», схоже на те, що ти бігаєш навколо, переконуючи всіх триматися за руки та співати пісні між епізодами неймовірних проявів насильства. Насильство має сенс. Решта викликає нудоту. ",shape=box,color=blue];
		1960 -> 1967;
		1960 -> 1968;
	1962 [label="Якщо ти збираєшся наполягати, що ми врятуємо всесвіт від цієї «Байдужості», тримаючись за руки та співаючи пісні. Вибач, я піду поблюю в акваріум Фібоначчі.",shape=box,color=blue];
		1962 -> 1970;
