digraph {
	"RoatheRank3Convo4 begins." [color=orange];
		"RoatheRank3Convo4 begins." -> j974182181;
	j974182181 [label="Ти можеш відповісти на одне питання, узурпаторе? Воно вже деякий час не дає мені спокою.",shape=box,color=blue];
		j974182181 -> j2242080894;
		j974182181 -> j1698842283;
		j974182181 -> j1478915251;
	j2242080894 [label="Питай. ",shape=box,color=red];
		j2242080894 -> j2078978097;
	j1698842283 [label="Що ж може тебе турбувати?",shape=box,color=red];
		j1698842283 -> j3608832998;
	j1478915251 [label="[Завершити розмову]",shape=box,color=red];
		j1478915251 -> "Chat ends.";
	j2078978097 [label="Чому ти все це робиш?",shape=box,color=blue];
		j2078978097 -> j3524964328;
	j3608832998 [label="Я міг би перерахувати весь список, але боюся, що ми просидимо тут весь день. Ні, мої запитання з цього приводу стосуються конкретно однієї теми. Принаймні сьогодні.",shape=box,color=blue];
		j3608832998 -> j2078978097;
	"Chat ends." [color=orange];
	j3524964328 [label="Check boolean RoatheKnowsReset2",color=orange];
		j3524964328 -> j315486941 [label=true,color=green];
		j3524964328 -> j2768280751 [label=false,color=brown];
	j315486941 [label="І я не кажу про те, що ти втручаєшся в мої спогади. Я маю на увазі «все це» в ширшому сенсі.",shape=box,color=blue];
		j315486941 -> j2768280751;
	j2768280751 [label="Check boolean LoidFamilyComplete",color=orange];
		j2768280751 -> j3180199508 [label=true,color=green];
		j2768280751 -> j3286686516 [label=false,color=brown];
	j3180199508 [label="Здається, ти маєш наміри бігати по цьому всесвіту за Альбрехтом, прибираючи за ним. Поглянь на свою роботу з його дворецьким. ",shape=box,color=blue];
		j3180199508 -> j2476974658;
	j3286686516 [label="Здається, ти маєш наміри бігати по цьому всесвіту за Альбрехтом, прибираючи за ним.",shape=box,color=blue];
		j3286686516 -> j2476974658;
	j2476974658 [label="Check boolean IsDating",color=orange];
		j2476974658 -> j2216168944 [label=true,color=green];
		j2476974658 -> j148794445 [label=false,color=brown];
	j2216168944 [label="Здається, ти маєш свої проблеми, якими ти зараз займаєшся, і я тебе за це поважаю, не засуджую тебе. Мені просто дивно, що хтось такий дивовижний та надзвичайно зухвалий, може бути настільки слухняним. ",shape=box,color=blue];
		j2216168944 -> j393988129;
		j2216168944 -> j672661473;
		j2216168944 -> j2823165156;
	j148794445 [label="Мені просто дивно, що хтось такий дивовижний та надзвичайно зухвалий, може бути настільки слухняним. ",shape=box,color=blue];
		j148794445 -> j393988129;
		j148794445 -> j672661473;
		j148794445 -> j2823165156;
	j393988129 [label="Дозволити Байдужості знищити Материнську систему, чи будь-яку іншу, нікому не допоможе.",shape=box,color=red];
		j393988129 -> j3196406920;
	j672661473 [label="Я не підкоряюся Ентраті.",shape=box,color=red];
		j672661473 -> j1248289519;
	j2823165156 [label="У мене є свої причини. І вони тільки мої.",shape=box,color=red];
		j2823165156 -> j1480761983;
	j3196406920 [label="А, зрозуміло. Ти просто надаєш тимчасові послуги, поки не вирішиться ситуація з «Байдужістю». А що ти плануєш робити потім?",shape=box,color=blue];
		j3196406920 -> j1010832828;
		j3196406920 -> j2450813833;
		j3196406920 -> j1325496569;
		j3196406920 -> j4220884914;
		j3196406920 -> j2709007158;
	j1248289519 [label="Справді? А мені так не здається. Він клацає пальцями, ти підкоряєшся та сідаєш біля його ніг наче дресований куброу. Він навіть шепоче ім’я «Тау», а ти намагаєшся пригадати кожну можливу деталь місця, яке було втрачене.",shape=box,color=blue];
		j1248289519 -> j3838335110;
		j1248289519 -> j1547380174;
	j1480761983 [label="Так загадково, так незбагненно! І така купа дурниць. Якщо ти просто не хочеш визнати, що ти в його розпорядженні, то нехай так і буде.",shape=box,color=blue];
		j1480761983 -> j88180163;
	j1010832828 [label="Чому ти зачіпаєш мене? Про що насправді ти хочеш запитати?",shape=box,color=red];
		j1010832828 -> j4100910964;
	j2450813833 [label="Чесно кажучи, у мене ще не має планів так далеко наперед.",shape=box,color=red];
		j2450813833 -> j1033766574;
	j1325496569 [label="Я маю намір змусити його заплатити за те, що він тут наробив. Йому є за що спокутувати провину. ",shape=box,color=red];
		j1325496569 -> j4032109738;
	j4220884914 [label="Ти маєш на увазі, якщо я виживу?",shape=box,color=red];
		j4220884914 -> j1948647654;
	j2709007158 [label="Піду туди, де потрібна моя допомога, як завжди. Проблеми самі мене знаходять.",shape=box,color=red];
		j2709007158 -> j3100756383;
	j3838335110 [label="Чому ти так намагаєшся мене розлютити?",shape=box,color=red];
		j3838335110 -> j1515102018;
	j1547380174 [label="Я просто роблю те, що має, щоб допомогти людям вибратися з жахливих ситуацій, в яких вони опинилися.",shape=box,color=red];
		j1547380174 -> j220844947;
	j88180163 [label="Бо мені здається, що він клацає пальцями, ти підкоряєшся та сідаєш біля його ніг наче дресований куброу. Він навіть шепоче ім’я «Тау», а ти намагаєшся пригадати кожну можливу деталь місця, яке було втрачене.",shape=box,color=blue];
		j88180163 -> j3838335110;
		j88180163 -> j1547380174;
	j4100910964 [label="+5 Chemistry",color=orange];
		j4100910964 -> j3581769225;
	j1033766574 [label="Ох! То ти визнаєш себе ідіотом! Як приємно. Я обожнюю, коли дурні відкрито демонструють свою недалекість, це значно полегшує мені завдання маніпулювати ними.",shape=box,color=blue];
		j1033766574 -> j2498809864;
	j4032109738 [label="Ох! То ти прагнеш примітивної, первісної помсти! Чудово. Ти як скажений звір, готовий гризти кістки тих, хто заподіяв тобі кривду.",shape=box,color=blue];
		j4032109738 -> j2806189400;
	j1948647654 [label="+5 Chemistry",color=orange];
		j1948647654 -> j3419150755;
	j3100756383 [label="А зрозуміло. Апатія, прихована за благородством. Ти не знаєш, де твоє місце, де тобі слід залишитися, тому ти прикриваєшся маскою «праведної жертви» та виконуєш волю інших?",shape=box,color=blue];
		j3100756383 -> j3467415099;
	j1515102018 [label="Тому що я ніяк не можу зрозуміти, чому ти, істота, яка, наскільки я можу судити, походить з іншої версії реальності, вирішила бігати крізь час і простір, «граючись у лікаря».",shape=box,color=blue];
		j1515102018 -> j3173611809;
	j220844947 [label="Так, це й є головним питанням! Чому ти наполегливо блукаєш у часі та просторі, «граючись у лікаря»? Ти, істота, яка, наскільки я можу судити, походить з іншої версії реальності. ",shape=box,color=blue];
		j220844947 -> j3173611809;
	j3581769225 [label="Проникливо. Так, добре, я перейду до суті того, про що прошу. Я намагався роздратувати тебе, щоби побачити, чи це спонукає тебе на більш чесну відповідь.",shape=box,color=blue];
		j3581769225 -> j624113952;
	j2498809864 [label="Ти як куброу, який нарешті спіймав кайта. Ти не знаєш, що робити, коли вже вчепився зубами в його ногу.",shape=box,color=blue];
		j2498809864 -> j1547380174;
		j2498809864 -> j3838335110;
	j2806189400 [label="Одна з найпростіших і найдавніших людських мотивацій. А, отже, одна з найлегших для розуміння.",shape=box,color=blue];
		j2806189400 -> j1547380174;
	j3419150755 [label="Тобі ніколи не довелося бути солдатом, але у твоєму тоні я чую втому найзагартованішого з усіх бійців.",shape=box,color=blue];
		j3419150755 -> j171297283;
	j3467415099 [label="Як це трагічно.",shape=box,color=blue];
		j3467415099 -> j3151000503;
		j3467415099 -> j3667122902;
	j3173611809 [label="Якби я був на твоєму місці, то повернувся б у Дувірі, щоб спробувати знайти інші дірки в матерії Порожнечі, які я міг би пробити! Уяви собі можливості! Уяви собі світи, готові до завоювання!",shape=box,color=blue];
		j3173611809 -> j385313567;
		j3173611809 -> j1899434930;
	j624113952 [label="Але, мабуть, це доведеться зробити.",shape=box,color=blue];
		j624113952 -> j30709608;
	j171297283 [label="Дуже добре. З повагою до тебе, я перейду до суті того, про що прошу. Я намагався роздратувати тебе, щоби побачити, чи це спонукає тебе на більш чесну відповідь.",shape=box,color=blue];
		j171297283 -> j30709608;
	j3151000503 [label="У мене є місце, якому я належу.",shape=box,color=red];
		j3151000503 -> j3946197121;
	j3667122902 [label="Ти не знаєш, про що говориш.",shape=box,color=red];
		j3667122902 -> j963679176;
	j385313567 [label="Ти нічим не відрізняєшся від Альбрехта. Він подорожує в часі, створюючи всі ці проблеми. А ти хочеш зробити це з цілими вимірами?!",shape=box,color=red];
		j385313567 -> j3728672178;
	j1899434930 [label="Ось у чому проблема з вами, орокінами. Ви думаєте, що цілі світи належать тільки вам і ви можете робити з ними все, що заманеться. ",shape=box,color=red];
		j1899434930 -> j1377635987;
	j30709608 [label="+5 Chemistry",color=orange];
		j30709608 -> j3547036568;
	j3946197121 [label="Тоді розкажи! Це Голвенія? Або, можливо, Дувірі? Або, можливо, твій розбитий орбітр на тому, що залишилося від Землі?",shape=box,color=blue];
		j3946197121 -> j1547380174;
		j3946197121 -> j3838335110;
	j963679176 [label="Тоді розкажи мені все про те, де твій дім! Це Голвенія? Або, можливо, Дувірі? Або, можливо, твій розбитий орбітр на тому, що залишилося від Землі?",shape=box,color=blue];
		j963679176 -> j1547380174;
		j963679176 -> j3838335110;
	j3728672178 [label="А чому б і ні? Ми ж вищі створіння, чи не так? Альбрехт робить, що йому заманеться, а ти без проблем прибираєш за ним! Чому я не маю права робити те саме? Чому його завдання «виправдані», а мої — ні?",shape=box,color=blue];
		j3728672178 -> j2683877802;
	j1377635987 [label="А чому б і ні? Адже ми ж вищі створіння, чи не так? Альбрехт робить те, що йому заманеться, бігаючи крізь час, заражаючи народ хворобою, яку він ледь розуміє, і все це в ім’я «перемоги над так званим богом».",shape=box,color=blue];
		j1377635987 -> j2683877802;
	j3547036568 [label="Я ніяк не можу зрозуміти, чому ти, істота, яка, наскільки я можу судити, походить з іншої версії реальності, вирішила бігати крізь час і простір, «граючись у лікаря».",shape=box,color=blue];
		j3547036568 -> j3956801596;
	j2683877802 [label="Але поглянь на себе! ",shape=box,color=blue];
		j2683877802 -> j965779903;
	j3956801596 [label="Check boolean IsDating",color=orange];
		j3956801596 -> j3206225991 [label=true,color=green];
		j3956801596 -> j1611064193 [label=false,color=brown];
	j965779903 [label="Check boolean IsDating",color=orange];
		j965779903 -> j2915892651 [label=true,color=green];
		j965779903 -> j3852922571 [label=false,color=brown];
	j3206225991 [label="Ти маєш сили, які я не бачив у жодної живої істоти. Ти можеш зупиняти час. Створювати кишенькові виміри. Але ти тут… відновлюєш стосунки. Та налагоджуєш кілька власних.",shape=box,color=blue];
		j3206225991 -> j1632560403;
	j1611064193 [label="Ти маєш сили, які я не бачив у жодної живої істоти. Ти можеш зупиняти час. Створювати кишенькові виміри. Але ти тут… відновлюєш стосунки.",shape=box,color=blue];
		j1611064193 -> j1632560403;
	j2915892651 [label="Ти маєш сили, які я не бачив у жодної живої істоти. Ти можеш зупиняти час. Створювати кишенькові виміри. Але ти тут… відновлюєш стосунки. Та налагоджуєш кілька власних.",shape=box,color=blue];
		j2915892651 -> j1486597979;
	j3852922571 [label="Ти маєш сили, які я не бачив у жодної живої істоти. Ти можеш зупиняти час. Створювати кишенькові виміри. Але ти тут… відновлюєш стосунки.",shape=box,color=blue];
		j3852922571 -> j1486597979;
	j1632560403 [label="Я просто вражений. Я не можу цього зрозуміти. Чому? Чому, коли ти в змозі правити якимось всесвітом десь?",shape=box,color=blue];
		j1632560403 -> j3126401565;
		j1632560403 -> j3240712468;
		j1632560403 -> j1521940155;
	j1486597979 [label="Я просто вражений. Я не можу цього зрозуміти. Чому? Чому, коли ти в змозі правити якимось всесвітом десь?",shape=box,color=blue];
		j1486597979 -> j1112156681;
		j1486597979 -> j2842763909;
		j1486597979 -> j1129131637;
	j3126401565 [label="Мені подобається робити те, що я роблю. Я допомагаю людям, тому що хочу допомагати людям.",shape=box,color=red];
		j3126401565 -> j2143041474;
	j3240712468 [label="Не знаю, чи зможеш ти це осягнути, але спробуй — я не хочу правити світом.",shape=box,color=red];
		j3240712468 -> j2067154669;
	j1521940155 [label="Це зробило б мене не кращим за Альбрехта. Чи орокінів. Скаженіти та перероблювати світи до своєї вподоби. Мені це не цікаво.",shape=box,color=red];
		j1521940155 -> j2067154669;
	j1112156681 [label="Мені подобається робити те, що я роблю. Я допомагаю людям, тому що хочу допомагати людям.",shape=box,color=red];
		j1112156681 -> j2143041474;
	j2842763909 [label="Не знаю, чи зможеш ти це осягнути, але спробуй — я не хочу правити світом.",shape=box,color=red];
		j2842763909 -> j715660608;
	j1129131637 [label="Це зробило б мене не кращим за Альбрехта. Чи орокінів. Скаженіти та перероблювати світи до своєї вподоби. Мені це не цікаво.",shape=box,color=red];
		j1129131637 -> j715660608;
	j2143041474 [label="Але чому? Ось це я й не розумію.",shape=box,color=blue];
		j2143041474 -> j1990388149;
	j2067154669 [label="То тобі краще бути… ким? Незначним?",shape=box,color=blue];
		j2067154669 -> j1485021976;
		j2067154669 -> j1622924950;
	j715660608 [label="То тобі краще бути… ким? Ніким?",shape=box,color=blue];
		j715660608 -> j1622924950;
		j715660608 -> j1485021976;
	j1990388149 [label="Check boolean RoatheUnloved1",color=orange];
		j1990388149 -> j113021815 [label=true,color=green];
		j1990388149 -> j727198091 [label=true,color=green];
		j1990388149 -> j3298173970 [label=true,color=green];
		j1990388149 -> j113021815 [label=false,color=brown];
		j1990388149 -> j727198091 [label=false,color=brown];
		j1990388149 -> j3604890775 [label=false,color=brown];
	j1485021976 [label="Якщо ти вважаєш, що те, що я роблю, є незначним, то це ваша думка. Зроблене мною переписало історію.",shape=box,color=red];
		j1485021976 -> j3665936164;
	j1622924950 [label="Не незначним. Непомітним. Нехай всі бігають навколо, привертаючи увагу. Я залишуся в тіні.",shape=box,color=red];
		j1622924950 -> j3852840347;
	j113021815 [label="Тому що допомагаючи людям, коли вони цього потребують, ми зрештою виберемося з цієї скрути.",shape=box,color=red];
		j113021815 -> j2091375120;
	j727198091 [label="Тому що я роблю те, що потрібно зробити. Нічого більше, нічого менше.",shape=box,color=red];
		j727198091 -> j475282109;
	j3298173970 [label="Ти сказав, що ніколи не знав, як це – бути коханим. Я не думаю, що ти зрозумієш, наскільки це може бути сильним, щоб змінити світ навколо тебе.",shape=box,color=red];
		j3298173970 -> j2093695989;
	j3604890775 [label="Роуте, а ти коли-небудь кохав? Чи піклувався так сильно про когось, що готовий би був спалити всесвіт заради цієї людини?",shape=box,color=red];
		j3604890775 -> j2687228779;
	j3665936164 [label="Саме це я і маю на увазі! Тоді пропоную переписати історію! Не сидімо тут, намагаючись переконати всіх триматися за руки та співати пісень!",shape=box,color=blue];
		j3665936164 -> j1738269975;
		j3665936164 -> j2765387235;
		j3665936164 -> j710457001;
	j3852840347 [label="А, розумію, ти волієш бути тихим вбивцею в тіні, так? Завдавати удару, коли тебе найменше підозрюють? Ні. Я так не думаю. Я думаю, ти просто марнуєш час.",shape=box,color=blue];
		j3852840347 -> j3847435020;
	j2091375120 [label="М-гм-м. Виконувати доручення для незнайомців, поки вони не почнуть шанувати тебе як місцевого героя? Або переконувати їх усіх триматися за руки та співати пісні? Вибач, я піду поблюю в акваріум Фібоначчі.",shape=box,color=blue];
		j2091375120 -> j1735446157;
		j2091375120 -> j1380195223;
	j475282109 [label="А те, що ти «робиш», схоже на те, що ти бігаєш навколо, переконуючи всіх триматися за руки та співати пісні між епізодами неймовірних проявів насильства. Насильство має сенс. Решта викликає нудоту. ",shape=box,color=blue];
		j475282109 -> j1735446157;
		j475282109 -> j1380195223;
	j2093695989 [label="Якщо ти збираєшся наполягати, що ми врятуємо всесвіт від цієї «Байдужості», тримаючись за руки та співаючи пісні. Вибач, я піду поблюю в акваріум Фібоначчі.",shape=box,color=blue];
		j2093695989 -> j887687964;
		j2093695989 -> j1735446157;
		j2093695989 -> j1380195223;
	j2687228779 [label="Boolean RoatheUnloved1 is now true.",color=orange];
		j2687228779 -> j1984873015;
	j1738269975 [label="Будь терплячим. Спочатку ми маємо впоратися з Байдужістю.",shape=box,color=red];
		j1738269975 -> j3996087272;
	j2765387235 [label="Можливо, коли все це мине. Але не зараз.",shape=box,color=red];
		j2765387235 -> j484743061;
	j710457001 [label="І ти думаєш, що мій вибір би зупинився на тобі? Не сміши мене.",shape=box,color=red];
		j710457001 -> j4170026776;
	j3847435020 [label="Ти не знаєш, що робиш і чому це робиш, ти просто виконуєш накази. Ще один самовпевнений поплічник самовпевненого орокіна. Ганьба.",shape=box,color=blue];
		j3847435020 -> "Chat ends.";
	j1735446157 [label="Я просто кажу, що ти здаєшся дуже розлюченим ідеєю, що люди більше не будуть нещасними. І приймаєш це занадто особисто.",shape=box,color=red];
		j1735446157 -> j1968135087;
	j1380195223 [label="Я намагаюся донести, що якщо «Байдужість» живиться браком емоцій, то їх наявність може бути ключем до її подолання.",shape=box,color=red];
		j1380195223 -> j4191069519;
	j887687964 [label="Ти думаєш, що ніхто не може тебе покохати? Або ти вважаєш, що не здатний відчувати кохання до когось іншого? Або думає, що цього просто ще не сталося?",shape=box,color=red];
		j887687964 -> j3657126620;
	j1984873015 [label="Ні, не кохав. Але якщо ти збираєшся наполягати, що ми врятуємо всесвіт від цієї «Байдужості», тримаючись за руки та співаючи пісні. Вибач, я піду поблюю в акваріум Фібоначчі.",shape=box,color=blue];
		j1984873015 -> j887687964;
		j1984873015 -> j1735446157;
		j1984873015 -> j1380195223;
	j3996087272 [label="+5 Chemistry",color=orange];
		j3996087272 -> j484743061;
	j484743061 [label="Добре. Добре! Я буду чекати свого часу, як ти кажеш. Грати в ці… дурні ігри.",shape=box,color=blue];
		j484743061 -> j582731236;
	j4170026776 [label="Boolean RoatheInsulted is now true.",color=orange];
		j4170026776 -> j2027730398;
	j1968135087 [label="Бо нещастя любить товариство? Можливо. Або ж я просто розумію, що ти марнуєш свій час, коли є реальна робота, яку б ми могли виконати.",shape=box,color=blue];
		j1968135087 -> j3282535765;
	j4191069519 [label="Ще один доказ того, що це плід твоєї уяви! Який реальний бог чи «антибог» може бути переможений «добротою людських емоцій»! Ха! ",shape=box,color=blue];
		j4191069519 -> j107982630;
	j3657126620 [label="Boolean RoatheUnloved2 is now true.",color=orange];
		j3657126620 -> j661848863;
	j582731236 [label="Я думаю, що нам ще є над чим працювати, як ти кажеш. Я просто не можу зрозуміти, що такі… дитячі речі мають якийсь сенс. Але, з іншого боку, я сиджу тут, а ти володієш ключами від всесвіту.",shape=box,color=blue];
		j582731236 -> j3877833450;
	j2027730398 [label="Справедливе зауваження. Чому б тобі не вибрати когось настільки огидного, як диявол Тау?",shape=box,color=blue];
		j2027730398 -> "Chat ends.";
	j3282535765 [label="Але тепер я впевнений, що ти не знаєш, що робиш і чому це робиш, і ти просто виконуєш накази. Ще один самовпевнений поплічник самовпевненого орокіна. Ганьба.",shape=box,color=blue];
		j3282535765 -> "Chat ends.";
	j107982630 [label="+5 Chemistry",color=orange];
		j107982630 -> j264654180;
	j661848863 [label="Припини говорити про теми, про які ти абсолютно нічого не знаєш, мандрівниче.",shape=box,color=blue];
		j661848863 -> j367054140;
	j3877833450 [label="А поки що я повернуся до того, щоб дратувати муху, що дзижчить у мене над вухом. ",shape=box,color=blue];
		j3877833450 -> j1631986096;
	j264654180 [label="Серйозно, що більше ти розповідаєш мені про ці свої божевільні теорії, то більше переконуєш мене в моїй правоті. Ви всі створили собі повітряного змія з власного божевілля, і ця штука просто живиться вашою власною невпевненістю.",shape=box,color=blue];
		j264654180 -> j2027888906;
