	1961 [label="Update boolean RoatheUnloved1",color=orange];
		1961 -> 1969;
	1963 [label="Будь терплячим. Спочатку ми маємо впоратися з Байдужістю.",shape=box,color=red];
		1963 -> 1971;
	1964 [label="Можливо, коли все це мине. Але не зараз.",shape=box,color=red];
		1964 -> 1972;
	1965 [label="І ти думаєш, що мій вибір би зупинився на тобі? Не сміши мене.",shape=box,color=red];
		1965 -> 1973;
	1966 [label="Ти не знаєш, що робиш і чому це робиш, ти просто виконуєш накази. Ще один самовпевнений поплічник самовпевненого орокіна. Ганьба.",shape=box,color=blue];
		1966 -> 1974;
	1967 [label="Я просто кажу, що ти здаєшся дуже розлюченим ідеєю, що люди більше не будуть нещасними. І приймаєш це занадто особисто.",shape=box,color=red];
		1967 -> 1975;
	1968 [label="Я намагаюся донести, що якщо «Байдужість» живиться браком емоцій, то їх наявність може бути ключем до її подолання.",shape=box,color=red];
		1968 -> 1976;
	1970 [label="Ти думаєш, що ніхто не може тебе покохати? Або ти вважаєш, що не здатний відчувати кохання до когось іншого? Або думає, що цього просто ще не сталося?",shape=box,color=red];
		1970 -> 1977;
	1969 [label="Ні, не кохав. Але якщо ти збираєшся наполягати, що ми врятуємо всесвіт від цієї «Байдужості», тримаючись за руки та співаючи пісні. Вибач, я піду поблюю в акваріум Фібоначчі.",shape=box,color=blue];
		1969 -> 1970;
		1969 -> 1967;
		1969 -> 1968;
	1971 [label="+5 Chemistry",color=orange];
		1971 -> 1972;
	1972 [label="Добре. Добре! Я буду чекати свого часу, як ти кажеш. Грати в ці… дурні ігри.",shape=box,color=blue];
		1972 -> 1978;
	1973 [label="Update boolean RoatheInsulted",color=orange];
		1973 -> 1979;
	1974 [label="Chat ends.",color=orange];
	1975 [label="Бо нещастя любить товариство? Можливо. Або ж я просто розумію, що ти марнуєш свій час, коли є реальна робота, яку б ми могли виконати.",shape=box,color=blue];
		1975 -> 1980;
	1976 [label="Ще один доказ того, що це плід твоєї уяви! Який реальний бог чи «антибог» може бути переможений «добротою людських емоцій»! Ха! ",shape=box,color=blue];
		1976 -> 1981;
	1977 [label="Update boolean RoatheUnloved2",color=orange];
		1977 -> 1982;
	1978 [label="Я думаю, що нам ще є над чим працювати, як ти кажеш. Я просто не можу зрозуміти, що такі… дитячі речі мають якийсь сенс. Але, з іншого боку, я сиджу тут, а ти володієш ключами від всесвіту.",shape=box,color=blue];
		1978 -> 1983;
	1979 [label="Справедливе зауваження. Чому б тобі не вибрати когось настільки огидного, як диявол Тау?",shape=box,color=blue];
		1979 -> 1984;
	1980 [label="Але тепер я впевнений, що ти не знаєш, що робиш і чому це робиш, і ти просто виконуєш накази. Ще один самовпевнений поплічник самовпевненого орокіна. Ганьба.",shape=box,color=blue];
		1980 -> 1985;
	1981 [label="+5 Chemistry",color=orange];
		1981 -> 1986;
	1982 [label="Припини говорити про теми, про які ти абсолютно нічого не знаєш, мандрівниче.",shape=box,color=blue];
		1982 -> 1987;
	1983 [label="А поки що я повернуся до того, щоб дратувати муху, що дзижчить у мене над вухом. ",shape=box,color=blue];
		1983 -> 1988;
	1984 [label="Chat ends.",color=orange];
	1985 [label="Chat ends.",color=orange];
	1986 [label="Серйозно, що більше ти розповідаєш мені про ці свої божевільні теорії, то більше переконуєш мене в моїй правоті. Ви всі створили собі повітряного змія з власного божевілля, і ця штука просто живиться вашою власною невпевненістю.",shape=box,color=blue];
		1986 -> 1989;
