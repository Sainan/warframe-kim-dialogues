	4640 [label="+5 Chemistry",color=orange];
		4640 -> 4648;
	4641 [label="Це не зовсім точно. Я кохаю. І більше не кохаю. Мені байдуже, чи вона жорстоко помре від моїх рук. Але мені неймовірно цікаво дізнатися, чим закінчилася її історія.",shape=box,color=blue];
		4641 -> 4649;
	4642 [label="Важко уявити, що хтось із такою схильністю до крові та смерті міг би стільки мовчати протягом усіх цих століть.",shape=box,color=blue];
