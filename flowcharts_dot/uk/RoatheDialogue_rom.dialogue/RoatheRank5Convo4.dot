	5628 [label="Update boolean LyonRoatheRepair",color=orange];
		5628 -> 5629;
	4651 [label="Саме заради минулого мені цікаво дізнатися, що з нею сталося. Просто тому, що я хочу знати, чим закінчилася її історія. Якщо вона взагалі закінчилася.",shape=box,color=blue];
		4651 -> 4649;
