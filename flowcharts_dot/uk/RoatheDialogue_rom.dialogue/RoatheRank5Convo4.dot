	4625 [label="Як хочеш. Але пам’ятай, що єдина річ небезпечніша за диявола… це диявол із такими друзями, як ти, які винні йому.",shape=box,color=blue];
		4625 -> 4631;
	4629 [label="Сподіваюся, це не викликає у тебе ревнощів. Я не маю наміру цього робити. Я просто намагаюся пояснити, скільки шкоди вона мені завдала.",shape=box,color=blue];
