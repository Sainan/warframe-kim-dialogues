	j1374717139 [label="Boolean RoatheMarieEntratiDeal is now false.",color=orange];
		j1374717139 -> j2923331581;
	j2116067152 [label="Як хочеш. Але пам’ятай, що єдина річ небезпечніша за диявола… це диявол із такими друзями, як ти, які винні йому.",shape=box,color=blue];
		j2116067152 -> "Chat ends.";
	j2200806614 [label="Boolean RoatheLyonConfessionDeal is now false.",color=orange];
		j2200806614 -> j833530380;
	j1199638719 [label="Сподіваюся, це не викликає у тебе ревнощів. Я не маю наміру цього робити. Я просто намагаюся пояснити, скільки шкоди вона мені завдала.",shape=box,color=blue];
		j1199638719 -> j1371835153;
	j2355371173 [label="Без неї я б не був тим, ким я є. Від неї я навчився всього, що знаю. Вона взяла сиру глину та надала їй форми.",shape=box,color=blue];
		j2355371173 -> j1955734582;
		j2355371173 -> j227593435;
		j2355371173 -> j2814442534;
	j2923331581 [label="+5 Chemistry",color=orange];
		j2923331581 -> j3648494371;
	j833530380 [label="+5 Chemistry",color=orange];
		j833530380 -> j1415924065;
	j1371835153 [label="І водночас скільки ж я їй винен. Без неї я б не був тим, ким я є. Від неї я навчився всього, що знаю. Вона взяла сиру глину та надала їй форми.",shape=box,color=blue];
		j1371835153 -> j1955734582;
		j1371835153 -> j1023455746;
		j1371835153 -> j2971004283;
	j1955734582 [label="Я розумію. У мене колись були подібні стосунки.",shape=box,color=red];
		j1955734582 -> j3745429641;
	j227593435 [label="Схоже, ти ще не зовсім подолав свої почуття до неї.",shape=box,color=red];
		j227593435 -> j1160490386;
	j2814442534 [label="Гадаєш, вона ще жива? Чи, можливо, померла?",shape=box,color=red];
		j2814442534 -> j3548123456;
	j3648494371 [label="Уважай справу зроблено. Але пам’ятай, що єдина річ небезпечніша за диявола… це диявол із такими друзями, як ти, які винні йому.",shape=box,color=blue];
		j3648494371 -> "Initiate conversation MarieRoatheRepair in /Lotus/Types/Gameplay/1999Wf/Dialogue/MarieDialogue_rom.dialogue";
	j1415924065 [label="Уважай справу зроблено. Але пам’ятай, що єдина річ небезпечніша за диявола… це диявол із такими друзями, як ти, які винні йому.",shape=box,color=blue];
		j1415924065 -> "Initiate conversation LyonRoatheRepair in /Lotus/Types/Gameplay/1999Wf/Dialogue/LyonDialogue_rom.dialogue";
	j1023455746 [label="Я розумію. Усе гаразд.",shape=box,color=red];
		j1023455746 -> j4238095864;
	j2971004283 [label="Хотілося б, щоб ти про неї не говорив.",shape=box,color=red];
		j2971004283 -> j975897316;
	j3745429641 [label="+5 Chemistry",color=orange];
		j3745429641 -> j44886668;
	j1160490386 [label="Це не зовсім точно. Я кохаю. І більше не кохаю. Мені байдуже, чи вона жорстоко помре від моїх рук. Але мені неймовірно цікаво дізнатися, чим закінчилася її історія.",shape=box,color=blue];
		j1160490386 -> j4217452175;
	j3548123456 [label="Важко уявити, що хтось із такою схильністю до крові та смерті міг би стільки мовчати протягом усіх цих століть.",shape=box,color=blue];
		j3548123456 -> j4264224597;
	"Initiate conversation MarieRoatheRepair in /Lotus/Types/Gameplay/1999Wf/Dialogue/MarieDialogue_rom.dialogue" [label="Initiate conversation MarieRoatheRepair in /Lotus/Types/Gameplay/1999Wf/Dialogue/MarieDialogue_rom.dialogue",color=orange];
		"Initiate conversation MarieRoatheRepair in /Lotus/Types/Gameplay/1999Wf/Dialogue/MarieDialogue_rom.dialogue" -> "Chat ends.";
	"Initiate conversation LyonRoatheRepair in /Lotus/Types/Gameplay/1999Wf/Dialogue/LyonDialogue_rom.dialogue" [label="Initiate conversation LyonRoatheRepair in /Lotus/Types/Gameplay/1999Wf/Dialogue/LyonDialogue_rom.dialogue",color=orange];
		"Initiate conversation LyonRoatheRepair in /Lotus/Types/Gameplay/1999Wf/Dialogue/LyonDialogue_rom.dialogue" -> "Chat ends.";
	j4238095864 [label="Саме заради минулого мені цікаво дізнатися, що з нею сталося. Просто тому, що я хочу знати, чим закінчилася її історія. Якщо вона взагалі закінчилася.",shape=box,color=blue];
		j4238095864 -> j4217452175;
	j975897316 [label="Перепрошую, але це ж не я про неї згадав. Ти мене дійсно бентежиш, мандрівниче.",shape=box,color=blue];
		j975897316 -> "Chat ends.";
	j44886668 [label="Тоді можеш зрозуміти, чому мені цікаво дізнатися, що з нею сталося. Просто тому, що я хочу знати, чим закінчилася її історія. Якщо вона взагалі закінчилася.",shape=box,color=blue];
		j44886668 -> j4217452175;
	j4217452175 [label="Важко позбутися тих, хто був такою ключовою фігурою у твоїй власній історії. Незалежно від того, наскільки вони були отруйними.",shape=box,color=blue];
		j4217452175 -> j3548123456;
	j4264224597 [label="Якщо вона ще жива, то навряд із власної волі сиділа б і чатувала.",shape=box,color=blue];
		j4264224597 -> j3144737136;
	j3144737136 [label="Однак скажу ось що. Якщо вона ще жива?",shape=box,color=blue];
		j3144737136 -> j3740389622;
	j3740389622 [label="+5 Chemistry",color=orange];
		j3740389622 -> j1127364161;
	j1127364161 [label="Ліпше молитися, щоби Баллас повернувся.",shape=box,color=blue];
