		j934185276 -> j3824130326;
	j2488955625 [label="Boolean RoatheResetDealComplete is now true.",color=orange];
		j2488955625 -> j213693048;
	j1150418512 [label="Ми уклали угоду, мандрівниче. Чи подобається тобі, як усе пішло з Марі та її ставленням до Альбрехта? Мені здається, ця мала летюча підлабузниця така ж непохитна, як і завжди.",shape=box,color=blue];
		j1150418512 -> j2264716046;
	j471290056 [label="Ми уклали угоду, мандрівниче. Чи подобається тобі, як усе пішло з Ліоном? Мені здається, бідолаха так само засмучений, як і завжди.",shape=box,color=blue];
		j471290056 -> j2099623384;
	j3158016482 [label="Як гадаєш, що сталося з Нітог?",shape=box,color=red];
		j3158016482 -> j4260440297;
	j1478915251 [label="[Завершити розмову]",shape=box,color=red];
		j1478915251 -> "Chat ends.";
	j3824130326 [label="Ми уклали угоду, мандрівниче. І хоча тобі не треба була моя допомога з Марі, знай, що диявол завжди отримує своє.",shape=box,color=blue];
		j3824130326 -> j3602508361;
	j213693048 [label="Ми уклали угоду, мандрівниче. І хоча тобі не треба була моя допомога з Ліоном, знай, що диявол завжди отримує своє.",shape=box,color=blue];
		j213693048 -> j3602508361;
	j2264716046 [label="Boolean RoatheResetDealComplete is now true.",color=orange];
		j2264716046 -> j153379570;
		j2264716046 -> j2848988192;
	j2099623384 [label="Boolean RoatheResetDealComplete is now true.",color=orange];
		j2099623384 -> j3482187283;
		j2099623384 -> j237725685;
	j4260440297 [label="Яке дивовижне питання. Я сам багато разів розмірковував над цим від моменту свого перетворення на цю заражену амальгаму.",shape=box,color=blue];
		j4260440297 -> j1641440851;
	j3602508361 [label="Я поверну те, що мені заборгували, незалежно від того, чи потрібно було тобі використовувати свою частину контракту, чи ні.",shape=box,color=blue];
		j3602508361 -> j385599229;
		j3602508361 -> j3040112810;
	j153379570 [label="Я не зрушився з нею ні на сантиметр…",shape=box,color=red];
		j153379570 -> j1951006068;
	j2848988192 [label="Залишати все так, як є — це нормально. Мені не потрібна твоя допомога.",shape=box,color=red];
		j2848988192 -> j3010970916;
	j3482187283 [label="Ні, мені здається, що мені не вдалося допомогти йому.",shape=box,color=red];
		j3482187283 -> j3032033193;
	j237725685 [label="Залишати все так, як є — це нормально. Мені не потрібна твоя допомога.",shape=box,color=red];
		j237725685 -> j213057123;
	j1641440851 [label="Але відколи мої спогади повністю повернулися, я частіше думаю про неї.",shape=box,color=blue];
		j1641440851 -> j2997095574;
	j385599229 [label="І що це? Ти ніколи не казав, що хочеш від нашої угоди.",shape=box,color=red];
		j385599229 -> j60940226;
	j3040112810 [label="Гадаю, ти блефуєш. Я навіть не думаю, що в тебе є план того, чого ти хочеш. ",shape=box,color=red];
		j3040112810 -> j2444547642;
	j1951006068 [label="Що ж, тоді я розв’яжу цю проблему для тебе й незабаром прийду за боргом.",shape=box,color=blue];
		j1951006068 -> j1389632842;
		j1951006068 -> j1994700998;
	j3010970916 [label="Можеш цим скористатися. Я поверну те, що мені заборгували, незалежно від того, чи потрібно було тобі використовувати свою частину контракту, чи ні.",shape=box,color=blue];
		j3010970916 -> j1994700998;
		j3010970916 -> j1389632842;
	j3032033193 [label="Що ж, тоді я розв’яжу цю проблему для тебе й незабаром прийду за боргом.",shape=box,color=blue];
		j3032033193 -> j2833604015;
		j3032033193 -> j592601963;
	j213057123 [label="Можеш цим скористатися. Я поверну те, що мені заборгували, незалежно від того, чи потрібно було тобі використовувати свою частину контракту, чи ні.",shape=box,color=blue];
		j213057123 -> j2833604015;
		j213057123 -> j592601963;
	j2997095574 [label="Ти мусиш зрозуміти, наскільки складними та… шкідливими насправді були мої стосунки з цією жінкою. Важко точно описати, як сильно я її обожнював. І як сильно я її зневажав. ",shape=box,color=blue];
		j2997095574 -> j129876578;
	j60940226 [label="Ти ж усвідомлюєш свої сили, так? І наскільки важливим може бути твоє перебування в моєму вимірі?",shape=box,color=blue];
		j60940226 -> j1376579342;
	j2444547642 [label="«Що» не таке важливе, як «кого», узурпаторе.",shape=box,color=blue];
		j2444547642 -> j60940226;
	j1389632842 [label="Гадаю, ти блефуєш. Я навіть не думаю, що в тебе є план того, чого ти хочеш. ",shape=box,color=red];
		j1389632842 -> j2420535479;
	j1994700998 [label="І що це? Ти ніколи не казав, що хочеш від нашої угоди.",shape=box,color=red];
		j1994700998 -> j3686575294;
	j2833604015 [label="І що це? Ти ніколи не казав, що хочеш від нашої угоди.",shape=box,color=red];
		j2833604015 -> j2828526419;
	j592601963 [label="Гадаю, ти блефуєш. Я навіть не думаю, що в тебе є план того, чого ти хочеш. ",shape=box,color=red];
		j592601963 -> j538062588;
	j129876578 [label="А що ще важливіше, наскільки вона змусила мене зневажати кожну частинку себе, аж до самого єства. Однак без неї я б не існував. Я б не був тим чоловіком, яким є.",shape=box,color=blue];
		j129876578 -> j1953414923;
	j1376579342 [label="Це, здається, у старовинних висловах називалося «порожнім чеком»? І твій підпис на ньому цілком добровільний.",shape=box,color=blue];
		j1376579342 -> j625467254;
	j2420535479 [label="«Що» не таке важливе, як «кого», узурпаторе.",shape=box,color=blue];
		j2420535479 -> j3686575294;
	j3686575294 [label="Ти ж усвідомлюєш свої сили, так? І наскільки важливим може бути твоє перебування в моєму вимірі?",shape=box,color=blue];
		j3686575294 -> j3428876617;
	j2828526419 [label="Ти ж усвідомлюєш свої сили, так? І наскільки важливим може бути твоє перебування в моєму вимірі?",shape=box,color=blue];
		j2828526419 -> j1626026939;
	j538062588 [label="«Що» не таке важливе, як «кого», узурпаторе.",shape=box,color=blue];
		j538062588 -> j2828526419;
	j1953414923 [label="Вона зробила мене. Вона зламала мене. ",shape=box,color=blue];
		j1953414923 -> j3643766847;
	j625467254 [label="+5 Chemistry",color=orange];
		j625467254 -> j1123116930;
	j3428876617 [label="Це, здається, у старовинних висловах називалося «порожнім чеком»? І твій підпис на ньому цілком добровільний. То що скажеш? Потрібна моя допомога з Марі чи ні?",shape=box,color=blue];
		j3428876617 -> j3561051813;
		j3428876617 -> j4231930654;
	j1626026939 [label="Це, здається, у старовинних висловах називалося «порожнім чеком»? І твій підпис на ньому цілком добровільний. То що скажеш? Потрібна моя допомога з Ліоном чи ні?",shape=box,color=blue];
		j1626026939 -> j270202811;
		j1626026939 -> j2026828692;
	j3643766847 [label="Я любив її. Я жадав її смерті.",shape=box,color=blue];
		j3643766847 -> j2688932181;
	j1123116930 [label="Єдина річ небезпечніша за диявола… це диявол із такими друзями, як ти, які винні йому.",shape=box,color=blue];
		j1123116930 -> "Chat ends.";
	j3561051813 [label="Так, гаразд…",shape=box,color=red];
		j3561051813 -> j185465375;
	j4231930654 [label="Ні, най буде як є.",shape=box,color=red];
		j4231930654 -> j3363190514;
	j270202811 [label="Так, гаразд…",shape=box,color=red];
		j270202811 -> j3252641716;
	j2026828692 [label="Ні, най буде як є.",shape=box,color=red];
		j2026828692 -> j1969649488;
	j2688932181 [label="Такі вже складнощі життя.",shape=box,color=blue];
		j2688932181 -> j2738869171;
