		4577 -> 4582;
		4577 -> 4583;
	4580 [label="Яке дивовижне питання. Я сам багато разів розмірковував над цим від моменту свого перетворення на цю заражену амальгаму.",shape=box,color=blue];
		4580 -> 4587;
	4576 [label="Chat ends.",color=orange];
	4586 [label="Я поверну те, що мені заборгували, незалежно від того, чи потрібно було тобі використовувати свою частину контракту, чи ні.",shape=box,color=blue];
		4586 -> 4592;
		4586 -> 4593;
	4584 [label="Я не зрушився з нею ні на сантиметр…",shape=box,color=red];
		4584 -> 4590;
	4585 [label="Залишати все так, як є — це нормально. Мені не потрібна твоя допомога.",shape=box,color=red];
		4585 -> 4591;
	4582 [label="Ні, мені здається, що мені не вдалося допомогти йому.",shape=box,color=red];
		4582 -> 4588;
	4583 [label="Залишати все так, як є — це нормально. Мені не потрібна твоя допомога.",shape=box,color=red];
		4583 -> 4589;
	4587 [label="Але відколи мої спогади повністю повернулися, я частіше думаю про неї.",shape=box,color=blue];
		4587 -> 4594;
	4592 [label="І що це? Ти ніколи не казав, що хочеш від нашої угоди.",shape=box,color=red];
		4592 -> 4599;
	4593 [label="Гадаю, ти блефуєш. Я навіть не думаю, що в тебе є план того, чого ти хочеш. ",shape=box,color=red];
		4593 -> 4600;
	4590 [label="Що ж, тоді я розв’яжу цю проблему для тебе й незабаром прийду за боргом.",shape=box,color=blue];
		4590 -> 4597;
		4590 -> 4598;
