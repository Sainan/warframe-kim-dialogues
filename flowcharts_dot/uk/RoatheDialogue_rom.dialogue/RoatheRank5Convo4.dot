	4594 [label="Ти мусиш зрозуміти, наскільки складними та… шкідливими насправді були мої стосунки з цією жінкою. Важко точно описати, як сильно я її обожнював. І як сильно я її зневажав. ",shape=box,color=blue];
		4594 -> 4601;
	4599 [label="Ти ж усвідомлюєш свої сили, так? І наскільки важливим може бути твоє перебування в моєму вимірі?",shape=box,color=blue];
