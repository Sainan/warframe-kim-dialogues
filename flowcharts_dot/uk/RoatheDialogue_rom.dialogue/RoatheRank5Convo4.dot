		4575 -> 4581;
	4572 [label="Ми уклали угоду, мандрівниче. Чи подобається тобі, як усе пішло з Марі та її ставленням до Альбрехта? Мені здається, ця мала летюча підлабузниця така ж непохитна, як і завжди.",shape=box,color=blue];
		4572 -> 4578;
	4571 [label="Ми уклали угоду, мандрівниче. Чи подобається тобі, як усе пішло з Ліоном? Мені здається, бідолаха так само засмучений, як і завжди.",shape=box,color=blue];
		4571 -> 4577;
	4574 [label="Як гадаєш, що сталося з Нітог?",shape=box,color=red];
