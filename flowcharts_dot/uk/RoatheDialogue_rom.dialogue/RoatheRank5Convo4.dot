		4596 -> 4603;
	4601 [label="А що ще важливіше, наскільки вона змусила мене зневажати кожну частинку себе, аж до самого єства. Однак без неї я б не існував. Я б не був тим чоловіком, яким є.",shape=box,color=blue];
		4601 -> 4607;
