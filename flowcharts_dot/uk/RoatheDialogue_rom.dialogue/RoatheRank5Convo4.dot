		4652 -> 4654;
	4648 [label="Тоді можеш зрозуміти, чому мені цікаво дізнатися, що з нею сталося. Просто тому, що я хочу знати, чим закінчилася її історія. Якщо вона взагалі закінчилася.",shape=box,color=blue];
