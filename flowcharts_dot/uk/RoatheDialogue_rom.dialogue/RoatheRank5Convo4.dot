	4570 [label="[Завершити розмову]",shape=box,color=red];
		4570 -> 4576;
	4579 [label="Ми уклали угоду, мандрівниче. І хоча тобі не треба була моя допомога з Марі, знай, що диявол завжди отримує своє.",shape=box,color=blue];
		4579 -> 4586;
	4581 [label="Ми уклали угоду, мандрівниче. І хоча тобі не треба була моя допомога з Ліоном, знай, що диявол завжди отримує своє.",shape=box,color=blue];
