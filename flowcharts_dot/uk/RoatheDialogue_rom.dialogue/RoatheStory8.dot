digraph {
	graph [fontname="Roboto Condensed"];
	node [fontname="Roboto Condensed"];
	edge [fontname="Roboto Condensed"];

	"RoatheStory8 begins." [color=orange];
		"RoatheStory8 begins." -> j4203072559;
	j4203072559 [label="Check /Lotus/Scripts/1999/DialogueScriptNodes.lua:StoryConditions(dialogueType=/Lotus/Types/Gameplay/1999Wf/Dialogue/RoatheDialogue_rom.dialogue, rank=2, count=4, storyCount=8)",color=orange];
		j4203072559 -> j1972827634 [label=true,color=green];
		j4203072559 -> "Chat ends." [label=false,color=brown];
	j1972827634 [label="Evaluate expressions on HellKeyPlayed counter",color=orange];
		j1972827634 -> j2638819628 [label="x >= 8",color=purple];
		j1972827634 -> "Chat ends." [label="false",color=purple];
	"Chat ends." [color=orange];
	j2638819628 [label="СТЯГ",shape=box,color=blue];
		j2638819628 -> j2939256798;
	j2939256798 [label="Витяг: Ніщо так помпезно й без зайвих слів не заявляє про наше ставлення до різанини війни, як стягоносці.",shape=box,color=blue];
		j2939256798 -> j2891716438;
	j2891716438 [label="Ті, кого потрібно захистити за будь-яку ціну. Ті, за ким ідуть без вагань.",shape=box,color=blue];
		j2891716438 -> j902208384;
	j902208384 [label="І, варто додати, ті, кому можна погрожувати, щоб виконували накази, які жоден притомний солдат не насмілиться виконати, хіба що його могла б спіткати ще гірша доля. ",shape=box,color=blue];
		j902208384 -> j579206087;
	j579206087 [label="Комічно, але факт.",shape=box,color=blue];
		j579206087 -> j4199645768;
	j4199645768 [label="Серед інших саме їхні обриси привертали мою увагу. Та потім понівечені тіла нічим не відрізнялися від інших. ",shape=box,color=blue];
		j4199645768 -> j4240385290;
	j4240385290 [label="Стяг був завжди однаковим. Лискуче орокінське золото, вимазане багряними плямами.",shape=box,color=blue];
		j4240385290 -> j1672592086;
	j1672592086 [label="Перш ніж піти, я завжди перевіряв, чи гордо він стоїть на полі.",shape=box,color=blue];
		j1672592086 -> j921430358;
	j921430358 [label="Add 1 to HellStory counter",color=orange];
		j921430358 -> "Chat ends.";
}