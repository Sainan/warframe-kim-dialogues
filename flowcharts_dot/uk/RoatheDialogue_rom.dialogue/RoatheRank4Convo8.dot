digraph {
	"RoatheRank4Convo8 begins." [color=orange];
		"RoatheRank4Convo8 begins." -> j1060799477;
		"RoatheRank4Convo8 begins." -> j1478915251;
	j1060799477 [label="Роуте, яким було твоє дитинство?",shape=box,color=red];
		j1060799477 -> j3774314883;
	j1478915251 [label="[Завершити розмову]",shape=box,color=red];
		j1478915251 -> "Chat ends.";
	j3774314883 [label="Гм? Цікаве запитання. Яким воно було? Чесно кажучи, я майже нічого не пам’ятаю. А зорі й скульптури, що містили ті спогади, імовірно, давно перетворилися на попіл або ж були перетворені на ендо.",shape=box,color=blue];
		j3774314883 -> j2908535888;
	"Chat ends." [color=orange];
	j2908535888 [label="Боюся, я можу пригадати лише найкоротші образи, адже це було так давно. Багато з того я навіть сумніваюся, чи не уявив, наче уві сні, або ж ніби приписую образи подіям, які читав у історичних книгах.",shape=box,color=blue];
		j2908535888 -> j3873949038;
	j3873949038 [label="Отже, те, що я можу пригадати, імовірно, жахливо ненадійне. Чому ти питаєш?",shape=box,color=blue];
		j3873949038 -> j3331637966;
		j3873949038 -> j3678642254;
		j3873949038 -> j3699817841;
	j3331637966 [label="Навіть якщо історії неправдиві, вони все одно залишаються тим, що ти розповідаєш собі про роки свого ставлення. Вони все одно варті того, щоб їх знати.",shape=box,color=red];
		j3331637966 -> j782574365;
	j3678642254 [label="Мені цікаво, як це було — рости серед орокінської знаті.",shape=box,color=red];
		j3678642254 -> j415384202;
	j3699817841 [label="Мені цікаво, що зробило «тебе». Як ти став таким.",shape=box,color=red];
		j3699817841 -> j4076606701;
	j782574365 [label="+5 Chemistry",color=orange];
		j782574365 -> j2826693215;
	j415384202 [label="У юному віці, як і всіх дітей орокінів, призначених для величі, мене відправили до того, що фанатики назвали б «інтернатом». Там мене випробовували й тренували відповідно до схильностей і здібностей.",shape=box,color=blue];
		j415384202 -> j4078476605;
		j415384202 -> j970465372;
	j4076606701 [label="+5 Chemistry",color=orange];
		j4076606701 -> j2244085032;
	j2826693215 [label="Я згоден, брехні, які ми розповідаємо собі, часто важливіші за правду. Чудова думка, узурпаторе.",shape=box,color=blue];
		j2826693215 -> j1810555273;
	j4078476605 [label="Твої батьки просто відправили тебе туди? Надовго?",shape=box,color=red];
		j4078476605 -> j3090789546;
	j970465372 [label="Як там було?",shape=box,color=red];
		j970465372 -> j2651381000;
	j2244085032 [label="Хочеш зрозуміти, коли я став «неправильним»? Зрозуміло. Цікаво. Не знаю, у моєму дитинстві ти знайдеш багато такого, що дасть тобі шукані відповіді.",shape=box,color=blue];
		j2244085032 -> j3009621533;
	j1810555273 [label="Add -1 to Thermostat counter",color=orange];
		j1810555273 -> j415384202;
	j3090789546 [label="На все юне життя. Не думаю, що я коли-небудь знову бачив своїх породжувачів. Можливо, лише на церемонії, коли мене оголосили першим у рейтингу класу?",shape=box,color=blue];
		j3090789546 -> j425708425;
	j2651381000 [label="Гадаю, думка різко відрізнялася б залежно від того, кого ти запитаєш. Коли я вперше прибув туди, то побої, які я отримував від старших хлопців, були швидкими, а уроки — жорстоко дієвими.",shape=box,color=blue];
		j2651381000 -> j1288243290;
	j3009621533 [label="Add 1 to Thermostat counter",color=orange];
		j3009621533 -> j415384202;
	j425708425 [label="Гадаю, це був перший раз, коли вони вважали за потрібне заявити на мене право. Я не надаю цьому великого значення.",shape=box,color=blue];
		j425708425 -> j2188522248;
	j1288243290 [label="Але я спроможний учень, у всьому. І я зрозумів, що якщо хочу досягти успіху в цьому конкретному напрямку Архімедії, то мушу застосовувати творчі методи, аби не опинитися серед покидьків.",shape=box,color=blue];
		j1288243290 -> j3183101654;
		j1288243290 -> j923640839;
	j2188522248 [label="Я мало що пам’ятаю про своїх батьків. Хоч деякі орокіни прагнули виховувати власне потомство, мої — ні. Вони були достатньо охочі позбутися мене й рухатися далі зі своїм життям.",shape=box,color=blue];
		j2188522248 -> j368648589;
		j2188522248 -> j2167582782;
	j3183101654 [label="Архімедівці таке дозволяли?",shape=box,color=red];
		j3183101654 -> j1370976681;
	j923640839 [label="Це… жахливо.",shape=box,color=red];
		j923640839 -> j3601691784;
	j368648589 [label="Не схоже, що це стримало тебе в житті.",shape=box,color=red];
		j368648589 -> j1504617686;
	j2167582782 [label="Мені шкода. Здається, твоє дитинство було сумним.",shape=box,color=red];
		j2167582782 -> j1504617686;
	j1370976681 [label="Бідний узурпаторе… Сам директор приніс пляшку куви й одного зі слуг, коли одного вечора з одним із новачків усе зайшло задалеко.",shape=box,color=blue];
		j1370976681 -> j2919884899;
	j3601691784 [label="Традиції — потужне знаряддя, узурпаторе. Потужне й небезпечне знаряддя, яке може тримати багатьох розсудливих людей замкненими в божевільних способах мислення.",shape=box,color=blue];
		j3601691784 -> j1403375396;
	j1504617686 [label="Зовсім навпаки. Через брак сімейних зв’язків я мав більше часу присвятити себе військовим стратегіям, які здавалися моїм одноліткам архаїчними та застарілими. ",shape=box,color=blue];
		j1504617686 -> j2859535143;
	j2919884899 [label="Традиції — потужне знаряддя. Потужне й небезпечне знаряддя, яке може тримати багатьох розсудливих людей замкненими в божевільних способах мислення.",shape=box,color=blue];
		j2919884899 -> j3315462117;
		j2919884899 -> j3362844339;
	j1403375396 [label="Сам директор приніс пляшку куви й одного зі слуг, коли одного вечора з одним із новачків усе зайшло задалеко.",shape=box,color=blue];
		j1403375396 -> j3315462117;
		j1403375396 -> j3362844339;
	j2859535143 [label="Вони й гадки не мали, наскільки це мені допоможе в майбутньому.",shape=box,color=blue];
		j2859535143 -> j2839619500;
		j2859535143 -> j2765715654;
	j3315462117 [label="А що батьки?",shape=box,color=red];
		j3315462117 -> j2188522248;
	j3362844339 [label="У тебе були там друзі?",shape=box,color=red];
		j3362844339 -> j2430196178;
	j2839619500 [label="Як гадаєш, воно було того варте?",shape=box,color=red];
		j2839619500 -> j1781617750;
	j2765715654 [label="Схоже, не таке вже в тебе й самотнє життя було.",shape=box,color=red];
		j2765715654 -> j1842818057;
	j2430196178 [label="Ні. Я тримався осторонь. Я зрозумів, що страх — це річ, яку легко створити й використати проти інших, але він є ніжною мереживною кригою, що тане від будь-якого промінчика світла.",shape=box,color=blue];
		j2430196178 -> j894175545;
	j1781617750 [label="Мої однолітки й гадки не мали, наскільки мої навчання допоможуть мені в майбутньому. Але якщо ти питаєш про чистий виграш чи поразку?",shape=box,color=blue];
		j1781617750 -> j2950768701;
	j1842818057 [label="Ні, самотнє. Але так буває, коли живеш життям диявола, чи не так? Навіть тоді мене вважали або безсилою жертвою та коханцем, або кривавим воєначальником та шаленим чудовиськом.",shape=box,color=blue];
		j1842818057 -> j4123958484;
	j894175545 [label="Чудовиськ слід тримати в темряві. І якщо я хотів зберегти ауру небезпеки навколо себе, то мусив залишатися самотнім.",shape=box,color=blue];
		j894175545 -> j368648589;
		j894175545 -> j2167582782;
	j2950768701 [label="Гм. Не знаю.",shape=box,color=blue];
		j2950768701 -> j1772564529;
		j2950768701 -> j3840884829;
	j4123958484 [label="Мені не були раді ні вищі за мене рангом, ні нижчі. І мені не було рівних.",shape=box,color=blue];
		j4123958484 -> j299591844;
	j1772564529 [label="У тебе є ще одна нагода виправити скоєне тобою. У них такого немає. ",shape=box,color=red];
		j1772564529 -> j1144639940;
	j3840884829 [label="Ну, вони мертві, на відміну від тебе. Тож, гадаю, так.",shape=box,color=red];
		j3840884829 -> j1075462904;
	j299591844 [label="Boolean RoatheUnloved2 is now true.",color=orange];
		j299591844 -> j770554802;
		j299591844 -> j1780177530;
	j1144639940 [label="Add 1 to Thermostat counter",color=orange];
		j1144639940 -> j3240826635;
	j1075462904 [label="Add -1 to Thermostat counter",color=orange];
		j1075462904 -> j3240826635;
	j770554802 [label="У тебе є ще одна нагода виправити скоєне тобою. У них такого немає.",shape=box,color=red];
		j770554802 -> j1144639940;
	j1780177530 [label="Що ж, принаймні в тебе є твоє майбутнє, і тобі вирішувати як жити. У них цього не має.",shape=box,color=red];
		j1780177530 -> j1075462904;
	j3240826635 [label="+5 Chemistry",color=orange];
		j3240826635 -> j4038411425;
	j4038411425 [label="Гадаю, побачимо, як воно буде, чи не так?",shape=box,color=blue];
		j4038411425 -> "Chat ends.";
}