digraph {
	3120 [label="RoatheRank4Convo8 begins.",color=orange];
		3120 -> 3121;
		3120 -> 3122;
	3121 [label="Роуте, яким було твоє дитинство?",shape=box,color=red];
		3121 -> 3123;
	3122 [label="[Завершити розмову]",shape=box,color=red];
		3122 -> 3124;
	3123 [label="Гм? Цікаве запитання. Яким воно було? Чесно кажучи, я майже нічого не пам’ятаю. А зорі й скульптури, що містили ті спогади, імовірно, давно перетворилися на попіл або ж були перетворені на ендо.",shape=box,color=blue];
		3123 -> 3125;
	3124 [label="Chat ends.",color=orange];
	3125 [label="Боюся, я можу пригадати лише найкоротші образи, адже це було так давно. Багато з того я навіть сумніваюся, чи не уявив, наче уві сні, або ж ніби приписую образи подіям, які читав у історичних книгах.",shape=box,color=blue];
		3125 -> 3126;
	3126 [label="Отже, те, що я можу пригадати, імовірно, жахливо ненадійне. Чому ти питаєш?",shape=box,color=blue];
		3126 -> 3127;
		3126 -> 3128;
		3126 -> 3129;
	3127 [label="Навіть якщо історії неправдиві, вони все одно залишаються тим, що ти розповідаєш собі про роки свого ставлення. Вони все одно варті того, щоб їх знати.",shape=box,color=red];
		3127 -> 3130;
	3128 [label="Мені цікаво, як це було — рости серед орокінської знаті.",shape=box,color=red];
		3128 -> 3131;
	3129 [label="Мені цікаво, що зробило «тебе». Як ти став таким.",shape=box,color=red];
		3129 -> 3132;
	3130 [label="+5 Chemistry",color=orange];
		3130 -> 3133;
	3131 [label="У юному віці, як і всіх дітей орокінів, призначених для величі, мене відправили до того, що фанатики назвали б «інтернатом». Там мене випробовували й тренували відповідно до схильностей і здібностей.",shape=box,color=blue];
		3131 -> 3134;
		3131 -> 3135;
	3132 [label="+5 Chemistry",color=orange];
		3132 -> 3136;
	3133 [label="Я згоден, брехні, які ми розповідаємо собі, часто важливіші за правду. Чудова думка, узурпаторе.",shape=box,color=blue];
		3133 -> 3137;
	3134 [label="Твої батьки просто відправили тебе туди? Надовго?",shape=box,color=red];
		3134 -> 3138;
	3135 [label="Як там було?",shape=box,color=red];
		3135 -> 3139;
	3136 [label="Хочеш зрозуміти, коли я став «неправильним»? Зрозуміло. Цікаво. Не знаю, у моєму дитинстві ти знайдеш багато такого, що дасть тобі шукані відповіді.",shape=box,color=blue];
		3136 -> 3140;
	3137 [label="Add -1 to Thermostat",color=orange];
		3137 -> 3131;
	3138 [label="На все юне життя. Не думаю, що я коли-небудь знову бачив своїх породжувачів. Можливо, лише на церемонії, коли мене оголосили першим у рейтингу класу?",shape=box,color=blue];
		3138 -> 3141;
	3139 [label="Гадаю, думка різко відрізнялася б залежно від того, кого ти запитаєш. Коли я вперше прибув туди, то побої, які я отримував від старших хлопців, були швидкими, а уроки — жорстоко дієвими.",shape=box,color=blue];
		3139 -> 3142;
	3140 [label="Add 1 to Thermostat",color=orange];
		3140 -> 3131;
	3141 [label="Гадаю, це був перший раз, коли вони вважали за потрібне заявити на мене право. Я не надаю цьому великого значення.",shape=box,color=blue];
		3141 -> 3143;
	3142 [label="Але я спроможний учень, у всьому. І я зрозумів, що якщо хочу досягти успіху в цьому конкретному напрямку Архімедії, то мушу застосовувати творчі методи, аби не опинитися серед покидьків.",shape=box,color=blue];
		3142 -> 3144;
		3142 -> 3145;
	3143 [label="Я мало що пам’ятаю про своїх батьків. Хоч деякі орокіни прагнули виховувати власне потомство, мої — ні. Вони були достатньо охочі позбутися мене й рухатися далі зі своїм життям.",shape=box,color=blue];
		3143 -> 3146;
		3143 -> 3147;
	3144 [label="Архімедівці таке дозволяли?",shape=box,color=red];
		3144 -> 3148;
	3145 [label="Це… жахливо.",shape=box,color=red];
		3145 -> 3149;
	3146 [label="Не схоже, що це стримало тебе в житті.",shape=box,color=red];
		3146 -> 3150;
	3147 [label="Мені шкода. Здається, твоє дитинство було сумним.",shape=box,color=red];
		3147 -> 3150;
	3148 [label="Бідний узурпаторе… Сам директор приніс пляшку куви й одного зі слуг, коли одного вечора з одним із новачків усе зайшло задалеко.",shape=box,color=blue];
		3148 -> 3151;
	3149 [label="Традиції — потужне знаряддя, узурпаторе. Потужне й небезпечне знаряддя, яке може тримати багатьох розсудливих людей замкненими в божевільних способах мислення.",shape=box,color=blue];
		3149 -> 3152;
	3150 [label="Зовсім навпаки. Через брак сімейних зв’язків я мав більше часу присвятити себе військовим стратегіям, які здавалися моїм одноліткам архаїчними та застарілими. ",shape=box,color=blue];
		3150 -> 3153;
	3151 [label="Традиції — потужне знаряддя. Потужне й небезпечне знаряддя, яке може тримати багатьох розсудливих людей замкненими в божевільних способах мислення.",shape=box,color=blue];
		3151 -> 3154;
		3151 -> 3155;
	3152 [label="Сам директор приніс пляшку куви й одного зі слуг, коли одного вечора з одним із новачків усе зайшло задалеко.",shape=box,color=blue];
		3152 -> 3154;
		3152 -> 3155;
	3153 [label="Вони й гадки не мали, наскільки це мені допоможе в майбутньому.",shape=box,color=blue];
		3153 -> 3156;
		3153 -> 3157;
	3154 [label="А що батьки?",shape=box,color=red];
		3154 -> 3143;
	3155 [label="У тебе були там друзі?",shape=box,color=red];
		3155 -> 3158;
	3156 [label="Як гадаєш, воно було того варте?",shape=box,color=red];
		3156 -> 3159;
	3157 [label="Схоже, не таке вже в тебе й самотнє життя було.",shape=box,color=red];
		3157 -> 3160;
	3158 [label="Ні. Я тримався осторонь. Я зрозумів, що страх — це річ, яку легко створити й використати проти інших, але він є ніжною мереживною кригою, що тане від будь-якого промінчика світла.",shape=box,color=blue];
		3158 -> 3161;
	3159 [label="Мої однолітки й гадки не мали, наскільки мої навчання допоможуть мені в майбутньому. Але якщо ти питаєш про чистий виграш чи поразку?",shape=box,color=blue];
		3159 -> 3162;
	3160 [label="Ні, самотнє. Але так буває, коли живеш життям диявола, чи не так? Навіть тоді мене вважали або безсилою жертвою та коханцем, або кривавим воєначальником та шаленим чудовиськом.",shape=box,color=blue];
		3160 -> 3163;
	3161 [label="Чудовиськ слід тримати в темряві. І якщо я хотів зберегти ауру небезпеки навколо себе, то мусив залишатися самотнім.",shape=box,color=blue];
		3161 -> 3146;
		3161 -> 3147;
	3162 [label="Гм. Не знаю.",shape=box,color=blue];
		3162 -> 3164;
		3162 -> 3165;
	3163 [label="Мені не були раді ні вищі за мене рангом, ні нижчі. І мені не було рівних.",shape=box,color=blue];
		3163 -> 3166;
	3164 [label="У тебе є ще одна нагода виправити скоєне тобою. У них такого немає. ",shape=box,color=red];
		3164 -> 3167;
	3165 [label="Ну, вони мертві, на відміну від тебе. Тож, гадаю, так.",shape=box,color=red];
		3165 -> 3168;
	3166 [label="Update boolean RoatheUnloved2",color=orange];
		3166 -> 3169;
		3166 -> 3170;
	3167 [label="Add 1 to Thermostat",color=orange];
		3167 -> 3171;
	3168 [label="Add -1 to Thermostat",color=orange];
		3168 -> 3171;
	3169 [label="У тебе є ще одна нагода виправити скоєне тобою. У них такого немає.",shape=box,color=red];
		3169 -> 3172;
	3170 [label="Що ж, принаймні в тебе є твоє майбутнє, і тобі вирішувати як жити. У них цього не має.",shape=box,color=red];
		3170 -> 3173;
	3171 [label="+5 Chemistry",color=orange];
		3171 -> 3174;
	3172 [label="Add 1 to Thermostat",color=orange];
		3172 -> 3171;
	3173 [label="Add -1 to Thermostat",color=orange];
		3173 -> 3171;
	3174 [label="Гадаю, побачимо, як воно буде, чи не так?",shape=box,color=blue];
		3174 -> 3175;
	3175 [label="Chat ends.",color=orange];
}