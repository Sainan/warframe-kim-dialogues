	"Chat ends." [color=orange];
	j4219466231 [label="ЖЕРТВА",shape=box,color=blue];
		j4219466231 -> j435680314;
	j435680314 [label="Витяг: Трейвон. Я спостерігав, як ти направив свій рейкоджек просто в пащу «Праґаси». Утративши пильність, у жадобі пожираючи тебе й твій екіпаж, вона так і не помітила, як моє власне судно на повній швидкості віддаляється.",shape=box,color=blue];
		j435680314 -> j1146382306;
	j1146382306 [label="Ти поклала своє життя за старшого офіцера. Твоя самопожертва була подібною до ляпаса.",shape=box,color=blue];
		j1146382306 -> j2109391167;
	j2109391167 [label="Марино. Ти віддала мені своє тіло. Разом, у тому окопі, ми пили куву. Мої руки тремтіли, моє розпанахане горло сочилося, але я втримав достатньо крапель, аби вона подіяла.",shape=box,color=blue];
		j2109391167 -> j808098830;
	j808098830 [label="Я пам’ятаю твій останній салют. А потім я розплющив очі, що були твоїми, і побачив власний розтрощений труп у багні.",shape=box,color=blue];
		j808098830 -> j103839408;
	j103839408 [label="Ростиґ. Вони казали, що щось не так із клонуванням. Бо що б іще могло змусити ґрінера залишатися в турелі, згораючи заживо. Навіть пацюкам доступний інстинкт самозбереження!",shape=box,color=blue];
		j103839408 -> j3147815430;
	j3147815430 [label="Ні. Ця «вада» поставила тебе вище за них.",shape=box,color=blue];
		j3147815430 -> j921430358;
	j921430358 [label="Add 1 to HellStory counter",color=orange];
		j921430358 -> "Chat ends.";
}