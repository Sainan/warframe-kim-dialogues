	2276 [label="ЖЕРТВА",shape=box,color=blue];
		2276 -> 2275;
	2274 [label="Chat ends.",color=orange];
	2275 [label="Витяг: Трейвон. Я спостерігав, як ти направив свій рейкоджек просто в пащу «Праґаси». Утративши пильність, у жадобі пожираючи тебе й твій екіпаж, вона так і не помітила, як моє власне судно на повній швидкості віддаляється.",shape=box,color=blue];
		2275 -> 5713;
	5713 [label="Ти поклала своє життя за старшого офіцера. Твоя самопожертва була подібною до ляпаса.",shape=box,color=blue];
		5713 -> 5714;
	5714 [label="Марино. Ти віддала мені своє тіло. Разом, у тому окопі, ми пили куву. Мої руки тремтіли, моє розпанахане горло сочилося, але я втримав достатньо крапель, аби вона подіяла.",shape=box,color=blue];
		5714 -> 2278;
	2278 [label="Я пам’ятаю твій останній салют. А потім я розплющив очі, що були твоїми, і побачив власний розтрощений труп у багні.",shape=box,color=blue];
		2278 -> 2272;
	2272 [label="Ростиґ. Вони казали, що щось не так із клонуванням. Бо що б іще могло змусити ґрінера залишатися в турелі, згораючи заживо. Навіть пацюкам доступний інстинкт самозбереження!",shape=box,color=blue];
		2272 -> 2279;
	2279 [label="Ні. Ця «вада» поставила тебе вище за них.",shape=box,color=blue];
		2279 -> 2271;
	2271 [label="Add 1 to HellStory",color=orange];
		2271 -> 2343;
	2343 [label="{\"Id\":2343,\"Incoming\":[2271],\"Outgoing\":[2270],\"GraphPos\":[4809,-5333],\"CompletionType\":1}",color=orange];
		2343 -> 2270;
	2270 [label="Chat ends.",color=orange];
