	2312 [label="ВНЕСОК",shape=box,color=blue];
		2312 -> 2311;
	2315 [label="Chat ends.",color=orange];
	2311 [label="Витяг: Я від самого початку зрозумів (як на бойовищі, так і любовному ложі), що шлях до перемоги йде через удавану покору.",shape=box,color=blue];
		2311 -> 5722;
	5722 [label="Де ворог бачить твою поступливість, там він неодмінно тиснутиме; а отже, там його легко підсікти.",shape=box,color=blue];
		5722 -> 5723;
	5723 [label="«Підлеглий», — так вони мене називали. «Песик». Нітог гадала, що контролює мене. Я ж тонко керував нею. ",shape=box,color=blue];
		5723 -> 2310;
	2310 [label="Роут закривавлений. Роут людожер, котрий відгодовується на тілах своїх загиблих. Марнотратник живого.",shape=box,color=blue];
		2310 -> 2314;
	2314 [label="Ніби я бився лише заради битви! Ні. Потрібно покласти край орокінській імперії.",shape=box,color=blue];
		2314 -> 5724;
	5724 [label="А для цього війна мусила тривати. Тільки поразка — цілковита й невідворотна — могла звалити тих сім золотих ґарґуйлів.",shape=box,color=blue];
		5724 -> 2316;
	2316 [label="Навіть Нітог не знала про мій істинний задум. Вважала, що я прагну на трон поруч із нею.",shape=box,color=blue];
		2316 -> 2309;
	2309 [label="Add 1 to HellStory",color=orange];
		2309 -> 2347;
	2347 [label="{\"Id\":2347,\"Incoming\":[2309],\"Outgoing\":[2313],\"GraphPos\":[4758,-3705],\"CompletionType\":1}",color=orange];
		2347 -> 2313;
	2313 [label="Chat ends.",color=orange];
}