digraph {
	graph [fontname="Roboto Condensed"];
	node [fontname="Roboto Condensed"];
	edge [fontname="Roboto Condensed"];

	"RoatheStory20 begins." [color=orange];
		"RoatheStory20 begins." -> j1115489240;
	j1115489240 [label="Check /Lotus/Scripts/1999/DialogueScriptNodes.lua:StoryConditions(dialogueType=/Lotus/Types/Gameplay/1999Wf/Dialogue/RoatheDialogue_rom.dialogue, rank=4, count=10, storyCount=20)",color=orange];
		j1115489240 -> j1035281352 [label=true,color=green];
		j1115489240 -> "Chat ends." [label=false,color=brown];
	j1035281352 [label="Evaluate expressions on HellKeyPlayed counter",color=orange];
		j1035281352 -> j61031912 [label="x >= 20",color=purple];
		j1035281352 -> "Chat ends." [label="false",color=purple];
	"Chat ends." [color=orange];
	j61031912 [label="ВНЕСОК",shape=box,color=blue];
		j61031912 -> j2418177033;
	j2418177033 [label="Витяг: Я від самого початку зрозумів (як на бойовищі, так і любовному ложі), що шлях до перемоги йде через удавану покору.",shape=box,color=blue];
		j2418177033 -> j195681418;
	j195681418 [label="Де ворог бачить твою поступливість, там він неодмінно тиснутиме; а отже, там його легко підсікти.",shape=box,color=blue];
		j195681418 -> j3267552603;
	j3267552603 [label="«Підлеглий», — так вони мене називали. «Песик». Нітог гадала, що контролює мене. Я ж тонко керував нею. ",shape=box,color=blue];
		j3267552603 -> j2741548558;
	j2741548558 [label="Роут закривавлений. Роут людожер, котрий відгодовується на тілах своїх загиблих. Марнотратник живого.",shape=box,color=blue];
		j2741548558 -> j2242159915;
	j2242159915 [label="Ніби я бився лише заради битви! Ні. Потрібно покласти край орокінській імперії.",shape=box,color=blue];
		j2242159915 -> j814255853;
	j814255853 [label="А для цього війна мусила тривати. Тільки поразка — цілковита й невідворотна — могла звалити тих сім золотих ґарґуйлів.",shape=box,color=blue];
		j814255853 -> j2760915510;
	j2760915510 [label="Навіть Нітог не знала про мій істинний задум. Вважала, що я прагну на трон поруч із нею.",shape=box,color=blue];
		j2760915510 -> j921430358;
	j921430358 [label="Add 1 to HellStory counter",color=orange];
		j921430358 -> "Chat ends.";
}