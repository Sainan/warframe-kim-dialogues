		j545960756 -> j1300521620;
	j3731112924 [label="Так. Гадаю, Ентраті впустив із Порожнечі безформенного бога, який був там до його прибуття.",shape=box,color=red];
		j3731112924 -> j2181519989;
	j3227908258 [label="Так. Гадаю, усі твої слова — маячня.",shape=box,color=red];
		j3227908258 -> j4099310853;
	j712356844 [label="Так. Гадаю, ти маєш рацію. Не думаю, що вона існувала до взаємодії з Ентраті. Він просто надав їй форму та вигляд за допомогою концептуального втілення.",shape=box,color=red];
		j712356844 -> j2702062416;
	j1300521620 [label="Так. Гадаю, відповідь десь посередині. Можливо, раніше це не був бог, але тепер є. Гадаю, Ентраті створив його в ту ж мить, коли відкрив Порожнечу.",shape=box,color=red];
		j1300521620 -> j994307344;
	j2181519989 [label="Він просто не розуміє, що ми таке. ",shape=box,color=red];
		j2181519989 -> j3565445705;
	j4099310853 [label="Check boolean RoatheDating",color=orange];
		j4099310853 -> j2298558450 [label=true,color=green];
		j4099310853 -> j323080769 [label=false,color=brown];
	j2702062416 [label="І відтоді ми годуємо її своїми страхами.",shape=box,color=red];
		j2702062416 -> j2482866672;
	j994307344 [label="Як Релл існує й не існує тепер, так Байдужість ніколи не була богом і водночас була завжди.",shape=box,color=red];
		j994307344 -> j1981340550;
	j3565445705 [label="Чи можу я переконати тебе ще раз розглянути мою позицію? Чи твої погляди в цьому незмінні?",shape=box,color=blue];
		j3565445705 -> j801954851;
		j3565445705 -> j795633136;
	j2298558450 [label="Я й не думав, що тебе так легко зачепити, мандрівниче. Що ж, як кажуть фанатики, c'est la vie.",shape=box,color=blue];
		j2298558450 -> j650387292;
	j323080769 [label="Як кажуть фанатики, c'est la vie.",shape=box,color=blue];
		j323080769 -> "Chat ends.";
	j2482866672 [label="Boolean DrifterMITWNotGod is now true.",color=orange];
		j2482866672 -> j856407747;
	j1981340550 [label="Ненавиджу вас, шанувальників етерналізму. Ви використовуєте його як виправдання для всього. Щойно архімедівець зрозуміє це, він божеволіє.",shape=box,color=blue];
		j1981340550 -> j3350395828;
	j801954851 [label="Можеш спробувати.",shape=box,color=red];
		j801954851 -> j3107792845;
	j795633136 [label="Нема сенсу.",shape=box,color=red];
		j795633136 -> j323080769;
	j650387292 [label="Boolean RoatheNoDate is now true.",color=orange];
		j650387292 -> j776748929;
	j856407747 [label="+5 Chemistry",color=orange];
		j856407747 -> j636409342;
	j3350395828 [label="«Я не забув полити твою рослину, як і обіцяв, вона просто переживає іншу гілку утерналізму, паралельну нашій».",shape=box,color=blue];
		j3350395828 -> j917276934;
	j3107792845 [label="Хоча сьогодні ти не звучиш надто філософськи, але я все ж спробую.",shape=box,color=blue];
		j3107792845 -> j2390853558;
	j776748929 [label="Boolean RoatheDating is now false.",color=orange];
		j776748929 -> j178902881;
	j636409342 [label="Чудово! Нарешті поступ!. Сурміть у сурми, дзвоніть у дзвони, хтось нарешті бачить глузд!",shape=box,color=blue];
		j636409342 -> j4290145;
	j917276934 [label="Мені хочеться кричати. Невже ти хоч раз у житті не можеш взяти на себе відповідальність?",shape=box,color=blue];
		j917276934 -> j4247449279;
		j917276934 -> j988758071;
	j2390853558 [label="Не те щоб я мав на що ліпше витрачати свій час.",shape=box,color=blue];
		j2390853558 -> j2694329455;
	j178902881 [label="Boolean IsDating is now false.",color=orange];
		j178902881 -> "Chat ends.";
	j4290145 [label="Check boolean RoatheDating",color=orange];
		j4290145 -> j3053320628 [label=true,color=green];
		j4290145 -> j1513585364 [label=false,color=brown];
	j4247449279 [label="Я намагаюся сказати, що якщо раніше це не був бог, то зараз став ним.",shape=box,color=red];
		j4247449279 -> j392813890;
	j988758071 [label="Не зважай.",shape=box,color=red];
		j988758071 -> j247953847;
	j2694329455 [label="Почнімо з початку, добре? Яке твоє визначення поняття «бог»?",shape=box,color=blue];
		j2694329455 -> j3972325635;
		j2694329455 -> j3774754606;
		j2694329455 -> j1017570117;
	j3053320628 [label="Хоч я й не мав жодних сумнівів, що ти передумаєш, мандрівниче, але ти показуєш, що маєш вибагливий смак.",shape=box,color=blue];
		j3053320628 -> j1535909254;
	j1513585364 [label="Хоч я й не мав жодних сумнівів, що ти передумаєш, мандрівниче. Я дуже переконливий. ",shape=box,color=blue];
		j1513585364 -> j1535909254;
	j392813890 [label="Зрозуміло. Альбрехт перетворив його на «бога» з Порожнечі. І ось у нас є «бог» на волі. Як мило.",shape=box,color=blue];
		j392813890 -> j2420393332;
		j392813890 -> j1400416105;
	j247953847 [label="А й справді.",shape=box,color=blue];
		j247953847 -> "Chat ends.";
	j3972325635 [label="Верховна істота. Щось, що має повну та беззаперечну владу чи силу. ",shape=box,color=red];
		j3972325635 -> j1265674190;
	j3774754606 [label="Надлюдська сутність або істота, яка має владу над певним аспектом творіння або людською долею.",shape=box,color=red];
		j3774754606 -> j2610457366;
	j1017570117 [label="Не знаю. Ти перший.",shape=box,color=red];
		j1017570117 -> j4290473963;
	j1535909254 [label="Отже, якби ж ми тільки могли знайти спосіб переконати всіх інших божевільних…",shape=box,color=blue];
		j1535909254 -> j3064531584;
		j1535909254 -> j1170396069;
	j2420393332 [label="Так, правильно.",shape=box,color=red];
		j2420393332 -> j1667279581;
	j1400416105 [label="Так, але я вважаю, що ми можемо заплутатися в тому, як обидва визначаємо концепцію бога.",shape=box,color=red];
		j1400416105 -> j1250071872;
	j1265674190 [label="Ти віриш, що твоя Байдужість — одна з цих верховних істот?",shape=box,color=blue];
		j1265674190 -> j751946674;
		j1265674190 -> j3681140340;
	j2610457366 [label="І ця твоя Байдужість — це надлюдська сутність чи істота? І вона володіє аспектом… Байдужості?",shape=box,color=blue];
		j2610457366 -> j3681140340;
		j2610457366 -> j751946674;
	j4290473963 [label="І кого тепер можна назвати боягузом? Що ж. Дозволь усе спростити й перейти до суті:",shape=box,color=blue];
		j4290473963 -> j1904274427;
	j3064531584 [label="Що я не розумію, то яка нам із цього користь?",shape=box,color=red];
		j3064531584 -> j2404040748;
	j1170396069 [label="Нащо перейматися?",shape=box,color=red];
		j1170396069 -> j1976367339;
	j1667279581 [label="Дозволь усе спростити й перейти до суті: чи віриш ти, що «бог» може померти?",shape=box,color=blue];
		j1667279581 -> j488851533;
	j1250071872 [label="Справедливо. Що, по-твоєму, є «бог»?",shape=box,color=blue];
		j1250071872 -> j2896845860;
		j1250071872 -> j3652136900;
		j1250071872 -> j1837152561;
	j751946674 [label="Не знаю.",shape=box,color=red];
		j751946674 -> j336433719;
	j3681140340 [label="Так, вірю.",shape=box,color=red];
		j3681140340 -> j3323216182;
	j1904274427 [label="Чи віриш ти, що «бог» може померти?",shape=box,color=blue];
		j1904274427 -> j3778764573;
		j1904274427 -> j3432584122;
		j1904274427 -> j1826450895;
		j1904274427 -> j2719833044;
		j1904274427 -> j2770938478;
	j2404040748 [label="Яка нам із цього користь? Уся користь світу! Хоча звісно, тобі завжди доводилося воювати самотужки. Ти не знаєш, що таке армійська тактика.",shape=box,color=blue];
		j2404040748 -> j2600672933;
	j1976367339 [label="Нащо перейматися? Ох ти ж бідося. Хоча звісно, тобі завжди доводилося воювати самотужки. Ти не знаєш, що таке армійська тактика.",shape=box,color=blue];
		j1976367339 -> j2600672933;
	j488851533 [label="Чи може «бог» якось перестати існувати?",shape=box,color=blue];
		j488851533 -> j1904274427;
	j2896845860 [label="Не знаю. Ти перший.",shape=box,color=red];
		j2896845860 -> j2061459545;
	j3652136900 [label="Надлюдська сутність або істота, яка має владу над певним аспектом творіння або людською долею.",shape=box,color=red];
		j3652136900 -> j4199686775;
	j1837152561 [label="Сутність за межами нашого розуміння. Істота, що існує поза нашим виміром, тож не існує «як ми».",shape=box,color=red];
		j1837152561 -> j1106276099;
	j336433719 [label="Годі ходити колами. Перейдімо до суті:",shape=box,color=blue];
		j336433719 -> j1904274427;
	j3323216182 [label="Check boolean RoatheDating",color=orange];
		j3323216182 -> j3741461619 [label=true,color=green];
		j3323216182 -> j473162041 [label=false,color=brown];
	j3778764573 [label="Я сподіваюся відправити Байдужість туди, звідки вона прийшла.",shape=box,color=red];
		j3778764573 -> j1536279028;
	j3432584122 [label="Не знаю. І не маю певності, що хтось знає.",shape=box,color=red];
		j3432584122 -> j820891782;
	j1826450895 [label="Ні, я так не думаю. Стійкість матерії і все таке.",shape=box,color=red];
		j1826450895 -> j1272300618;
	j2719833044 [label="Так. Інакше нас би захопили, чи не так?",shape=box,color=red];
		j2719833044 -> j3194397600;
	j2770938478 [label="Дуже на це сподіваюся.",shape=box,color=red];
		j2770938478 -> j4126401196;
	j2600672933 [label="Знання ворога — ключ до всього. А тепер у мене питання. Чи віриш ти, що цю істоту можна вбити?",shape=box,color=blue];
		j2600672933 -> j1673258535;
		j2600672933 -> j4125612808;
		j2600672933 -> j3293112765;
	j2061459545 [label="І кого тепер можна назвати боягузом? Що ж. Дозволь усе спростити й перейти до суті:",shape=box,color=blue];
		j2061459545 -> j488851533;
	j4199686775 [label="І ця твоя Байдужість — це надлюдська сутність чи істота? І вона володіє аспектом… Байдужості?",shape=box,color=blue];
		j4199686775 -> j1522390114;
		j4199686775 -> j3996585605;
	j1106276099 [label="А-а-а, хрозуміло. Ось у чому проблема. Так, наші визначення не збігаються. Чи є ця «Байдужість» сутністю, якою ти її описуєш? Так, тут ми погодилися.",shape=box,color=blue];
		j1106276099 -> j3406215149;
	j3741461619 [label="Ти розчаровуєш. Мені здавалося, у тебе більше клепки. Але дозволь запитати ось що й перейти до суті:",shape=box,color=blue];
		j3741461619 -> j1904274427;
	j473162041 [label="Ти розчаровуєш. Але дозволь запитати ось що й перейти до суті:",shape=box,color=blue];
		j473162041 -> j1904274427;
	j1536279028 [label="Миротворці. Чому завжди має бути миротворець.",shape=box,color=blue];
		j1536279028 -> j1249915803;
	j820891782 [label="Отже, у своєму скромному невігластві ти натякаєш, що ми всі блукаємо навпомацки в темряві.",shape=box,color=blue];
		j820891782 -> j524315597;
	j1272300618 [label="Ох, прекрасно, ти вважаєш, що «боги» не можуть померти!",shape=box,color=blue];
		j1272300618 -> j1249915803;
	j3194397600 [label="А твоя логіка полягає… в тому, що боги можуть померти, бо… «боги» схожі на побберів?",shape=box,color=blue];
		j3194397600 -> j3113747556;
	j4126401196 [label="Ну, так, це очевидно, але стеж за моєю думкою, мандрівниче. Мені потрібно, щоб ти зосередився.",shape=box,color=blue];
		j4126401196 -> j3113747556;
	j1673258535 [label="Жодного уявлення, якщо чесно.",shape=box,color=red];
		j1673258535 -> j1364201922;
	j4125612808 [label="Усе можна вбити. Навіть Байдужість. Якось.",shape=box,color=red];
		j4125612808 -> j41425240;
	j3293112765 [label="Можливо, ми не можемо вбити Байдужість, але це не означає, що ми не можемо спинити її.",shape=box,color=red];
		j3293112765 -> j2583473842;
	j1522390114 [label="Так, вірю.",shape=box,color=red];
		j1522390114 -> j4152406556;
	j3996585605 [label="Не знаю.",shape=box,color=red];
		j3996585605 -> j4152406556;
	j3406215149 [label="У нас просто невідповідність скороченої термінології. Це кумедно.",shape=box,color=blue];
		j3406215149 -> j3654384249;
	j1249915803 [label="Перед тобою два варіанта. Або ти віриш, що ця штука може померти, і тоді це не «бог»,",shape=box,color=blue];
		j1249915803 -> j1068755608;
	j524315597 [label="Якщо ніхто з нас не може знати, чи може «бог» померти, а ця Байдужість — одна з них, то навіщо нам взагалі з нею боротися?",shape=box,color=blue];
		j524315597 -> j1249915803;
	j3113747556 [label="Порожнеча сьогодні шаленіє. Гадаю, я маю справу з ідіотом.",shape=box,color=blue];
		j3113747556 -> j1249915803;
	j1364201922 [label="Boolean DrifterMITWKillMaybe is now true.",color=orange];
		j1364201922 -> j3800275870;
	j41425240 [label="Boolean DrifterMITWKill is now true.",color=orange];
		j41425240 -> j828204173;
	j2583473842 [label="Boolean DrifterMITWStop is now true.",color=orange];
		j2583473842 -> j164258635;
	j4152406556 [label="Годі ходити колами. Перейдімо до суті: чи може «бог» якось перестати існувати?",shape=box,color=blue];
		j4152406556 -> j1904274427;
	j3654384249 [label="Гадаю, «жахливий моторошний жах, що виходить за межі нашого розуміння» — то забагато складових для жарту. Тож дозволь перейти до суті:",shape=box,color=blue];
		j3654384249 -> j1904274427;
	j1068755608 [label="або ж ти віриш, що її не здолати, і як би ми її не називали, ми просто чекаємо, поки вона поглине нас.",shape=box,color=blue];
		j1068755608 -> j1231315237;
	j3800275870 [label="Я зараз переріжу собі горло власним хвостом.",shape=box,color=blue];
		j3800275870 -> j533539567;
	j828204173 [label="Якось.",shape=box,color=blue];
		j828204173 -> j556870473;
	j164258635 [label="+5 Chemistry",color=orange];
		j164258635 -> j3338122857;
	j1231315237 [label="Я навів усі свої найкращі аргументи, але починаю думати, що вони марні. Тож я просто запитаю тебе востаннє й буду молитися, що здоровий глузд переможе.",shape=box,color=blue];
		j1231315237 -> j2409057244;
	j533539567 [label="Не дивно, що дворецький завжди виглядає таким виснаженим. Він постійно має справу з тобою.",shape=box,color=blue];
		j533539567 -> "Chat ends.";
	j556870473 [label="Я щиро сподіваюся, що ти дійсно вмієш вигадувати розв’язування проблем «на ходу», як про тебе кажуть інші.",shape=box,color=blue];
		j556870473 -> j2436220529;
	j3338122857 [label="Гм. Авжеж. Адже коли ви запхали її пальці в банку й потім відтворили їх — усе пройшло так добре.",shape=box,color=blue];
		j3338122857 -> j2448153340;
	j2409057244 [label="І благаю згадати все, що я сказав тобі.",shape=box,color=blue];
		j2409057244 -> j3788492018;
	j2436220529 [label="Інакше, схоже, ми всі діємо на основі певної «віри».",shape=box,color=blue];
		j2436220529 -> j4081414586;
	j2448153340 [label="Але, можливо, це не таке вже й погане рішення.",shape=box,color=blue];
		j2448153340 -> j2436220529;
	j3788492018 [label="Байдужість — бог?",shape=box,color=blue];
		j3788492018 -> j1549664595;
		j3788492018 -> j2310128801;
