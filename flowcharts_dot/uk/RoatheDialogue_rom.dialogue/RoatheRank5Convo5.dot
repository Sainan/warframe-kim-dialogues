		4732 -> 4744;
		4732 -> 4745;
	4733 [label="Aaah, I see. Now there's the rub. Yes, our definitions did not match. Insomuch as this \"Indifference\" is an entity as you describe it? Yes. We are agreed.",shape=box,color=blue];
		4733 -> 4746;
	4735 [label="Disappointing. I would have thought you more clever than that. But allow me to ask you this and cut to the chase:",shape=box,color=blue];
