		4694 -> 4701;
		4694 -> 4702;
	4695 [label="Chat ends.",color=orange];
	4696 [label="Though I had no doubt you would come around, Drifter darling. you already had shown to be of discerning taste already.",shape=box,color=blue];
		4696 -> 4703;
	4697 [label="Though I had no doubt you would come around, Drifter. I am quite convincing. ",shape=box,color=blue];
		4697 -> 4703;
	4698 [label="I see. It was fashioned into a \"god\" from the Void by Albrecht. And now we have a \"god\" on the loose. How charming.",shape=box,color=blue];
		4698 -> 4704;
		4698 -> 4705;
	4699 [label="Indeed.",shape=box,color=blue];
		4699 -> 4706;
	4700 [label="A supreme being. Something that has total and unquestionable authority or power. ",shape=box,color=red];
		4700 -> 4707;
