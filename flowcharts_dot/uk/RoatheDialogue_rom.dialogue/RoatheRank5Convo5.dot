	4705 [label="Yes, but I think we might be getting caught up on how we're both defining what a \"god\" is.",shape=box,color=red];
		4705 -> 4713;
	4706 [label="Chat ends.",color=orange];
	4707 [label="And you believe that your Indifference is one of these supreme beings?",shape=box,color=blue];
		4707 -> 4714;
