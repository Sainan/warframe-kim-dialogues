		4669 -> 4673 [label=false,color=brown];
	4670 [label="And we've been feeding it fear ever since.",shape=box,color=red];
		4670 -> 4675;
	4671 [label="Like how Rell both Exists and Doesn't now, the Indifference is never was a god, yet now, always has been.",shape=box,color=red];
		4671 -> 4676;
	4672 [label="Can I convince you to consider my position once more? Or are your views on the the topic immutable?",shape=box,color=blue];
