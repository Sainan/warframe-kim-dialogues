		4665 -> 4669;
	4666 [label="Так. Гадаю, ти маєш рацію. Не думаю, що вона існувала до взаємодії з Ентраті. Він просто надав їй форму та вигляд за допомогою концептуального втілення.",shape=box,color=red];
		4666 -> 4670;
	4667 [label="Так. Гадаю, відповідь десь посередині. Можливо, раніше це не був бог, але тепер є. Гадаю, Ентраті створив його в ту ж мить, коли відкрив Порожнечу.",shape=box,color=red];
		4667 -> 4671;
