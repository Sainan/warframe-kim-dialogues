		4663 -> 4666;
		4663 -> 4667;
	4662 [label="Chat ends.",color=orange];
	4664 [label="I have. I think what Entrati let loose from the Void was a shapeless god that was there in the aether before we arrived.",shape=box,color=red];
		4664 -> 4668;
	4665 [label="I have. I think you're full of shit.",shape=box,color=red];
		4665 -> 4669;
	4666 [label="I have. I think you're right. I don't think it existed before Entrati interacted with it. He wanted to find a god... so the Void spat something out that's pretending to be one.",shape=box,color=red];
		4666 -> 4670;
	4667 [label="I have. I think the answer is somewhere in between. It may not have been a god before, but it is now. I think Entrati blinked it into existence the moment he opened the Void.",shape=box,color=red];
		4667 -> 4671;
	4668 [label="It simply cannot understand what we are. ",shape=box,color=red];
