		4694 -> 4702;
	4695 [label="Chat ends.",color=orange];
	4696 [label="Хоч я й не мав жодних сумнівів, що ти передумаєш, мандрівниче, але ти показуєш, що маєш вибагливий смак.",shape=box,color=blue];
		4696 -> 4703;
	4697 [label="Хоч я й не мав жодних сумнівів, що ти передумаєш, мандрівниче. Я дуже переконливий. ",shape=box,color=blue];
		4697 -> 4703;
	4698 [label="Зрозуміло. Альбрехт перетворив його на «бога» з Порожнечі. І ось у нас є «бог» на волі. Як мило.",shape=box,color=blue];
