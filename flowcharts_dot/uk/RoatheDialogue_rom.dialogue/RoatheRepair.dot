digraph {
	graph [fontname="Roboto Condensed"];
	node [fontname="Roboto Condensed"];
	edge [fontname="Roboto Condensed"];

	"RoatheRepair begins." [color=orange];
		"RoatheRepair begins." -> j2688688654;
	j2688688654 [label="Evaluate expressions",color=orange];
		j2688688654 -> j771675386 [label="LyonRoatheFailFix & MarieRoatheFailFix",color=purple];
		j2688688654 -> "Chat ends." [label="false",color=purple];
	j771675386 [label="Годі! Годі. Я здаюся! Відкликай своїх фанатиків. Вони гірші за скажених кубродонів! Прокляті істоти переслідують мене всюди, куди я йду. Я навіть спати не можу!",shape=box,color=blue];
		j771675386 -> j1475860892;
	"Chat ends." [color=orange];
	j1475860892 [label="Що?! Що ти хочеш?",shape=box,color=blue];
		j1475860892 -> j182475489;
		j1475860892 -> j3239734759;
		j1475860892 -> j2125945351;
	j182475489 [label="Ще одна нагода поговорити з тобою про сироватку. Роуте, час припинити втікати. ",shape=box,color=red];
		j182475489 -> j1979205857;
	j3239734759 [label="Роуте. Прийняття сироватки не робить тебе боягузом. Це робить тебе єдиним орокіном, що вижив. Прийми це.",shape=box,color=red];
		j3239734759 -> j1420398166;
	j2125945351 [label="Роутe. Прийняття сироватки не робить тебе боягузом. Це дало тобі ще одну можливість жити життя. Зробити реальні зміни.",shape=box,color=red];
		j2125945351 -> j62611055;
	j1979205857 [label="Evaluate expressions on Thermostat counter",color=orange];
		j1979205857 -> j1228990692 [label="x >= 5",color=purple];
		j1979205857 -> j3993001210 [label="x <= 0",color=purple];
		j1979205857 -> j2227523551 [label="x > 0 && x < 5",color=purple];
		j1979205857 -> j2227523551 [label="false",color=purple];
	j1420398166 [label="Add -5 to Thermostat counter",color=orange];
		j1420398166 -> j1979205857;
	j62611055 [label="Add 5 to Thermostat counter",color=orange];
		j62611055 -> j1979205857;
	j1228990692 [label="Ти дозволяєш цьому гніву розривати себе зсередини. Ти міг би використовувати його, щоби боротися з тими, хто досі руйнує цей світ. Тут. Зараз.",shape=box,color=red];
		j1228990692 -> j3563812673;
	j3993001210 [label="Ти направляєш це на себе. Тобі слід направляти це на світ, який звинувачує тебе в тому, що ти зробив усе можливе, щоб урятувати його від орокінської імперії.",shape=box,color=red];
		j3993001210 -> j3007310403;
	j2227523551 [label="Це тому ти переконав їх задовбувати мене весь день? Заради цього? Остання марна спроба переконати мене вислухати твої жалюгідні аргументи?",shape=box,color=blue];
		j2227523551 -> j657480310;
	j3563812673 [label="Тебе не визначає твоє минуле, Роуте. Тебе визначає твоє майбутнє. І в тебе ще є майбутнє, на відміну від усіх орокінів, що загинули тієї Ночі барабанів наґа.",shape=box,color=red];
		j3563812673 -> j3315047001;
	j3007310403 [label="Тебе не визначають думки тих, хто навколо. Ані те, що вони думають про твої вчинки. Тебе визначає лише те, що ти сам віриш про себе й свої вибори.",shape=box,color=red];
		j3007310403 -> j1852782055;
	j657480310 [label="Ні.",shape=box,color=blue];
		j657480310 -> j3903178729;
	j3315047001 [label="Це єдине, що визначає тебе тепер. Ти можеш змінитися. І ти можеш змінити світ навколо себе. Моє єдине питання — чи ти бодай спробуєш?",shape=box,color=red];
		j3315047001 -> j4022508665;
	j1852782055 [label="А проста істина полягає в тому, що ти — один із небагатьох орокінів, що пережили Ніч барабанів наґи. З мого погляду це був стратегічний відступ.",shape=box,color=red];
		j1852782055 -> j3322945867;
	j3903178729 [label="Твій провал жалюгідний. Це вже не один раз, а два.",shape=box,color=blue];
		j3903178729 -> j332587685;
	j4022508665 [label="Спробуєш пробачити себе й рухатися вперед?",shape=box,color=red];
		j4022508665 -> j2694645121;
	j3322945867 [label="Ні більше. Ні менше.",shape=box,color=red];
		j3322945867 -> j2822127214;
	j332587685 [label="Я не рекомендую балотуватися на державні посади.",shape=box,color=blue];
		j332587685 -> "Chat ends.";
	j2694645121 [label="Boolean RoatheRedeemed is now true.",color=orange];
		j2694645121 -> j1899019108;
	j2822127214 [label="Boolean RoatheVillain is now true.",color=orange];
		j2822127214 -> j3083814008;
	j1899019108 [label="+20 Chemistry",color=orange];
		j1899019108 -> j3052527184;
	j3083814008 [label="+20 Chemistry",color=orange];
		j3083814008 -> j2672191447;
	j3052527184 [label="Пробачити себе за те, що я зробив? І рухатися вперед, у майбутнє? Гм.",shape=box,color=blue];
		j3052527184 -> j1534288641;
	j2672191447 [label="Відступ, щоб виграти війну. Гм. ",shape=box,color=blue];
		j2672191447 -> j1938830120;
	j1534288641 [label="Хоча я… трохи сумніваюся у твоєму переосмисленні ситуації, я… надто спокушений новим майбутнім і що воно дасть мені для опору, любове.",shape=box,color=blue];
		j1534288641 -> j348493817;
	j1938830120 [label="Хоча я… трохи сумніваюся у твоєму переосмисленні твоїх дій як тактичного відступу, визнаю, що я… все одно підтримую це, любове.",shape=box,color=blue];
		j1938830120 -> j1615010864;
	j348493817 [label="Цей «новий поворот» у моєму житті. Добре. Я погоджуюся й приймаю твій аргумент. Хоч і пізно висловлений… але він усе одно подіяв.",shape=box,color=blue];
		j348493817 -> j1561814703;
	j1615010864 [label="Добре. Я погоджуюся й приймаю твій аргумент. Хоч і пізно висловлений… але він усе одно подіяв.",shape=box,color=blue];
		j1615010864 -> j1561814703;
	j1561814703 [label="Я ціную це більше, аніж ти можеш подумати.",shape=box,color=blue];
		j1561814703 -> j757561088;
	j757561088 [label="Boolean RoatheFail is now false.",color=orange];
		j757561088 -> j2141078128;
	j2141078128 [label="Boolean RoatheFamilyFail is now false.",color=orange];
		j2141078128 -> j313480356;
	j313480356 [label="Boolean RoatheFailStall is now false.",color=orange];
		j313480356 -> j3136897973;
	j3136897973 [label="Check boolean LoidFamilyComplete",color=orange];
		j3136897973 -> "Chat ends." [label=true,color=green];
		j3136897973 -> j614835396 [label=false,color=brown];
	j614835396 [label="А тепер, гадаю, ми маємо перейти до нашої наступної битви, так? Дворецький.",shape=box,color=blue];
		j614835396 -> j3563978997;
	j3563978997 [label="Не дочекаюся її.",shape=box,color=blue];
