	j685906117 [label="Витяг: Ми не очікували поразки. ",shape=box,color=blue];
		j685906117 -> j3283757566;
	j3283757566 [label="Після першого розвідувального удару свідомих ми підготували каральні протизаходи.",shape=box,color=blue];
		j3283757566 -> j2451050072;
	j2451050072 [label="З туману Церери на своїх смертоносних крилах виринула «Злотоскляна чарівниця» — галеон із дронами та мірмідонами в срібних обладунках.",shape=box,color=blue];
		j2451050072 -> j2465738662;
	j2465738662 [label="Тонкі електричні мережі прозорою імлою утворювали ніжне мереживо під напівпрозорим покриттям. ",shape=box,color=blue];
		j2465738662 -> j2466617166;
	j2466617166 [label="Вона була такою величезною, що ледь не випирала за краї сонячної рейки.",shape=box,color=blue];
		j2466617166 -> j1909590879;
	j1909590879 [label="Свідомі зробили так, щоб ми побачили результати. Вони заспівали й наші технології дали збій. Наші воїни страждали й задихалися у своїх лискучих костюмах.",shape=box,color=blue];
		j1909590879 -> j1312378713;
	j1312378713 [label="Екіпаж «Злотоскляної чарівниці» засмажився заживо, коли вона зраненою лебідкою неслася небом Тау, наче складний коштовний феєрверк.",shape=box,color=blue];
		j1312378713 -> j921430358;
	j921430358 [label="Add 1 to HellStory counter",color=orange];
