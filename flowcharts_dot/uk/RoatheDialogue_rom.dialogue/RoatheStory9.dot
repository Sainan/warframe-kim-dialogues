	2208 [label="Витяг: Я пригадую їх нині. Юрми сміхотливої орокінської молоді.",shape=box,color=blue];
		2208 -> 2212;
	2212 [label="Шляхтичі, убрані в іще чистесенькі шати польових командувачів.",shape=box,color=blue];
		2212 -> 2205;
	2205 [label="Друзі дитинства стали на чолі легіонів даксів, ґрінерів, клітин антиматерій, самовідтворювальних карцинаторів, примітивних біодронів-павуколезів, контейнерів загонів низькотехнологічних військ.",shape=box,color=blue];
		2205 -> 2213;
	2213 [label="Золоті дівчата та хлоп’ята з ненажерливими дияволами за спинами.",shape=box,color=blue];
		2213 -> 2215;
	2215 [label="Їхня пихатість пекучим потом обтікала мою свідомість. Вони пили й співали, вихваляючись прийдешніми часами.",shape=box,color=blue];
		2215 -> 5696;
	5696 [label="Вони мали здобути собі славу. Ущент укрити шаною свої родини.",shape=box,color=blue];
		5696 -> 5697;
	5697 [label="Їх так багато загинуло. Навіть тіла не змогли повернути.",shape=box,color=blue];
		5697 -> 5698;
	5698 [label="Щоб вороги не вивідали наших таємниць, усіх після смерті розчиняли кувою.",shape=box,color=blue];
		5698 -> 5699;
	5699 [label="Надія покоління перетворилася на масну калюжу, розбризкану черевиками ґрінерів.",shape=box,color=blue];
		5699 -> 2211;
	2211 [label="Add 1 to HellStory",color=orange];
		2211 -> 2336;
	2336 [label="{\"Id\":2336,\"Incoming\":[2211],\"Outgoing\":[2207],\"GraphPos\":[5512,-8267],\"CompletionType\":1}",color=orange];
