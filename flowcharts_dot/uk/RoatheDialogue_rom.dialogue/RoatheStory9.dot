	"Chat ends." [color=orange];
	j2118898426 [label="КОМАНДУВАЧІ",shape=box,color=blue];
		j2118898426 -> j954551903;
	j954551903 [label="Витяг: Я пригадую їх нині. Юрми сміхотливої орокінської молоді.",shape=box,color=blue];
		j954551903 -> j3846037946;
	j3846037946 [label="Шляхтичі, убрані в іще чистесенькі шати польових командувачів.",shape=box,color=blue];
		j3846037946 -> j2150401319;
	j2150401319 [label="Друзі дитинства стали на чолі легіонів даксів, ґрінерів, клітин антиматерій, самовідтворювальних карцинаторів, примітивних біодронів-павуколезів, контейнерів загонів низькотехнологічних військ.",shape=box,color=blue];
		j2150401319 -> j4124764718;
	j4124764718 [label="Золоті дівчата та хлоп’ята з ненажерливими дияволами за спинами.",shape=box,color=blue];
		j4124764718 -> j1406883200;
	j1406883200 [label="Їхня пихатість пекучим потом обтікала мою свідомість. Вони пили й співали, вихваляючись прийдешніми часами.",shape=box,color=blue];
		j1406883200 -> j3427289512;
	j3427289512 [label="Вони мали здобути собі славу. Ущент укрити шаною свої родини.",shape=box,color=blue];
		j3427289512 -> j1918947490;
	j1918947490 [label="Їх так багато загинуло. Навіть тіла не змогли повернути.",shape=box,color=blue];
		j1918947490 -> j1199501327;
	j1199501327 [label="Щоб вороги не вивідали наших таємниць, усіх після смерті розчиняли кувою.",shape=box,color=blue];
		j1199501327 -> j770806832;
	j770806832 [label="Надія покоління перетворилася на масну калюжу, розбризкану черевиками ґрінерів.",shape=box,color=blue];
		j770806832 -> j921430358;
	j921430358 [label="Add 1 to HellStory counter",color=orange];
		j921430358 -> "Chat ends.";
}