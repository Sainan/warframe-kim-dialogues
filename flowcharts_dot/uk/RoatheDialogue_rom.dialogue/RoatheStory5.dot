		j1748751648 -> j3494347408;
	j3494347408 [label="Витяг: Тепер я згадав, що бойові мистецтва архімедії спершу були представлені як розваги. ",shape=box,color=blue];
		j3494347408 -> j1962434498;
	j1962434498 [label="Як для розбещених роззяв, котрі спостерігають за стратою злочинців на аренах цирків.",shape=box,color=blue];
		j1962434498 -> j1373534622;
	j1373534622 [label="Ми уявляли, що винаходимо нові захопливі способи розправитися з набагато слабшими ворогами.",shape=box,color=blue];
		j1373534622 -> j1764515352;
	j1764515352 [label="Які ж пихаті дурні. Насправді ми творили інновації у відчаї, усвідомлюючи власну безпорадність перед мінливими супротивниками.",shape=box,color=blue];
		j1764515352 -> j2372978961;
	j2372978961 [label="Вони рвали нас, мов юрма дітей, що пожирає свою розбухлу матір.",shape=box,color=blue];
		j2372978961 -> j3281989145;
	j3281989145 [label="Висушені, розчавлені між сторінками часу, ми просто виявилися еволюційно відсталішими.",shape=box,color=blue];
		j3281989145 -> j921430358;
	j921430358 [label="Add 1 to HellStory counter",color=orange];
		j921430358 -> "Chat ends.";
