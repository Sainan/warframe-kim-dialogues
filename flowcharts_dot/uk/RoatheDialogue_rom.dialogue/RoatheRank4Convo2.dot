		2407 -> 2409 [label="false",color=purple];
		2407 -> 2411 [label="false",color=purple];
	2409 [label="У тебе є засоби. У тебе є сила. Ти достатньо голосно висловлював невдоволення своєю ситуацією.",shape=box,color=red];
		2409 -> 2413;
	2410 [label="Я просто не розумію, чому Диявол Тау задовольняється тим, що сидить у крипті й байдикує. Навіть із нашою угодою.",shape=box,color=red];
		2410 -> 2414;
	2411 [label="Ти ж орокін. Ти ненавидиш усіх навколо. Що тебе стримує?",shape=box,color=red];
		2411 -> 2415;
	2408 [label="Я просто не розумію, чому Диявол Тау задовольняється тим, що сидить у крипті й байдикує. Особливо коли ми не маємо жодної угоди.",shape=box,color=red];
		2408 -> 2412;
	2413 [label="+5 Chemistry",color=orange];
		2413 -> 2418;
	2414 [label="Check boolean RoatheKnowsReset2",color=orange];
		2414 -> 2420 [label=true,color=green];
		2414 -> 2419 [label=false,color=brown];
	2415 [label="Дозволь мені на мить зібратися з думками, перш ніж ми продовжимо цю розмову з позиції чистої люті та злоби.",shape=box,color=blue];
		2415 -> 2421;
	2412 [label="Check boolean RoatheKnowsReset2",color=orange];
		2412 -> 2417 [label=true,color=green];
		2412 -> 2416 [label=false,color=brown];
	2418 [label="І я радий, що ти визнаєш, що я можу легко перетворити це місце на бійню.",shape=box,color=blue];
		2418 -> 2424;
	2420 [label="Тому що лишається питання, чому я взагалі так тобі повірив, щоб розповісти стільки… лише щоб побачити, як ти зраджуєш цю довіру, узурпаторе.",shape=box,color=blue];
		2420 -> 2423;
	2419 [label="Робота ще не завершена. Я навряд чи зможу залучити тебе до повернення моїх спогадів, якщо просто піду й переріжу всіх, чи не так?",shape=box,color=blue];
		2419 -> 2422;
	2421 [label="Бо я докладаю чималих зусиль, щоб негайно не підтвердити твої слова.",shape=box,color=blue];
		2421 -> 2425;
	2417 [label="Тому що лишається питання, чому я взагалі так тобі повірив, щоб розповісти стільки… лише щоб побачити, як ти зраджуєш цю довіру, узурпаторе.",shape=box,color=blue];
		2417 -> 2423;
	2416 [label="Можливо, я сподіваюся, що ти порозумнішаєш і зміниш думку. А ймовірність цього різко знизиться, якщо я всіх навколо виріжу, чи не так?",shape=box,color=blue];
		2416 -> 2422;
	2424 [label="Але це нічого б не дало, чи не так? Якщо є лише один урок, який можна винести з війни, то це те, що вбивство зрештою дивовижно мало що вирішує.",shape=box,color=blue];
		2424 -> 2427;
	2423 [label="А ймовірність на твою співпрацю різко зменшиться, якщо я всіх довкола виріжу, чи не так? Якщо є лише один урок, який можна винести з війни, то це те, що вбивство зрештою дивовижно мало що вирішує.",shape=box,color=blue];
		2423 -> 2426;
	2422 [label="Крім того, це нічого б не дало, чи не так? Якщо є лише один урок, який можна винести з війни, то це те, що вбивство зрештою дивовижно мало що вирішує.",shape=box,color=blue];
		2422 -> 2426;
	2425 [label="Я розумію твою ненависть до орокінів. Повір, більшість орокінів ненавиділи самих орокінів. Я добре знаю про наші злочини. Про ті жахливі речі, які ми вчинили. ",shape=box,color=blue];
		2425 -> 2428;
	2427 [label="Хоча приємно час від часу мати бажання зробити це.",shape=box,color=blue];
		2427 -> 2431;
		2427 -> 2430;
		2427 -> 2429;
	2426 [label="Хоча приємно час від часу мати бажання зробити це.",shape=box,color=blue];
		2426 -> 2429;
		2426 -> 2430;
		2426 -> 2431;
	2428 [label="Одного лише Юванського театру цілком достатньо, щоб зрівняти наше суспільство із землею. Але ти під один розчерк засуджуєш цілий народ. Із якого, між іншим, і ти родом, мій узурпаторе!",shape=box,color=blue];
		2428 -> 2432;
	2431 [label="То єдина причина, чому ти не вбиваєш решту, бо в цьому немає сенсу?",shape=box,color=red];
		2431 -> 2435;
	2430 [label="Інших причин, чому ти дозволяєш усім жити, немає?",shape=box,color=red];
		2430 -> 2434;
	2429 [label="Навіть Марі й Ліона?",shape=box,color=red];
		2429 -> 2433;
	2432 [label="Ти нічого не знаєш про всіх тих добрих людей, що працювали й гинули в тих золотих стінах. Про саги, складені про їхні життя й загублені в часі.",shape=box,color=blue];
		2432 -> 2436;
	2435 [label="Їхнє вбивство не має сенсу. Чи ні? Ти намагаєшся переконати мене в протилежному? Узурпаторе, я вражений! Ніколи не вважав тебе таким підступним чудовиськом!",shape=box,color=blue];
		2435 -> 2438;
		2435 -> 2439;
	2434 [label="Якщо хочеш зробити якийсь натяк, узурпатори, то просто прямо скажи це.",shape=box,color=blue];
		2434 -> 2438;
		2434 -> 2439;
	2433 [label="Я майже певен, що якби тут у крипті знайшли криваві плями там, де раніше були ті фанатики, мені б дуже за це нарікали, чи не так?",shape=box,color=blue];
		2433 -> 2437;
	2436 [label="Про ріки сліз, пролитих за трагедіями, що залишаться неоспіваними лише тому, що ти про них не знаєш.",shape=box,color=blue];
		2436 -> 2440;
	2438 [label="Це нормально визнати, що тобі подобається товариство. Люди можуть більше, ніж просто служити утилітарній меті.",shape=box,color=red];
		2438 -> 2441;
	2439 [label="Це нормально визнати, що ми хочемо позбутися самотності, навіть якщо ми тебе дратуємо.",shape=box,color=red];
		2439 -> 2442;
	2437 [label="Ти, дворецький, чи тенно, чи жахлива «Мати» тенно. Ох. Вона. Вона мене непокоїть. Але це тема для іншої розмови.",shape=box,color=blue];
		2437 -> 2439;
		2437 -> 2438;
	2440 [label="Я чув схлипування твого дитячого двійника, вигуки імені «Адіс». ",shape=box,color=blue];
		2440 -> 2443;
	2441 [label="Add 1 to Thermostat",color=orange];
		2441 -> 2444;
	2442 [label="Add -1 to Thermostat",color=orange];
		2442 -> 2445;
	2443 [label="Адіс був одним із мільйонів.",shape=box,color=blue];
		2443 -> 2446;
	2444 [label="Evaluate expressions",color=orange];
		2444 -> 2448 [label="RoatheUnloved2",color=purple];
		2444 -> 2448 [label="RoatheUnloved1",color=purple];
		2444 -> 2448 [label="RoatheAlone1",color=purple];
		2444 -> 2448 [label="RoatheBirdThree",color=purple];
		2444 -> 2447 [label="false",color=purple];
	2445 [label="Evaluate expressions",color=orange];
		2445 -> 2449 [label="RoatheUnloved2",color=purple];
		2445 -> 2449 [label="RoatheUnloved1",color=purple];
		2445 -> 2449 [label="RoatheAlone1",color=purple];
		2445 -> 2449 [label="RoatheBirdThree",color=purple];
		2445 -> 2450 [label="false",color=purple];
	2446 [label="Для тебе це ім’я унікальне.",shape=box,color=blue];
		2446 -> 2451;
	2448 [label="Не випробуй свою удачу, узурпаторе. «Подобається» — це трохи перебільшення. Ти радше зростаєш на мені. Як цвіль.",shape=box,color=blue];
		2448 -> 2453;
	2447 [label="«Подобається?» Це як? Я ніколи не усвідомлював, що я такий мазохіст. Гм. Чи це просто відчуття, ніби моє тіло гниє, і відчуття, ніби ви всі «зростаєте на мені»?",shape=box,color=blue];
		2447 -> 2452;
	2449 [label="Доволі приємно мати можливість із кимось говорити. Навіть якщо ви, як ти кажеш, іноді дратуєте.",shape=box,color=blue];
		2449 -> 2454;
	2450 [label="Самотність? Пхе. Єдине, чого ти позбуваєшся, це будь-яка розсудливість, яка намагається повернутися в моє життя. Якщо ти намагаєшся натякнути, що ви всі «зростаєте на мені», то знаєш ти, що ще так робить?",shape=box,color=blue];
		2450 -> 2455;
	2451 [label="Але не для зірок.",shape=box,color=blue];
		2451 -> 2456;
	2453 [label="+5 Chemistry",color=orange];
		2453 -> 2457;
	2452 [label="Як цвіль.",shape=box,color=blue];
		2452 -> 2457;
	2454 [label="+5 Chemistry",color=orange];
		2454 -> 2458;
	2455 [label="Цвіль.",shape=box,color=blue];
		2455 -> 2457;
	2456 [label="Змальовуй мій народ у барвах крові, як тобі заманеться. Плав золото орокінів і називай нас чудовиськами. Ми заслуговуємо на кожну краплину ненависті, яку ти можеш нам віддати.",shape=box,color=blue];
		2456 -> 2459;
	2457 [label="Update boolean RoatheAlone2",color=orange];
		2457 -> 2460;
	2458 [label="Я мушу визнати. Ти зростаєш на мені. Як цвіль.",shape=box,color=blue];
		2458 -> 2457;
	2459 [label="Але не смій навіть на мить думати, що ми були здатні лише на це.",shape=box,color=blue];
		2459 -> 2461;
	2460 [label="Check boolean LoidFamilyComplete",color=orange];
		2460 -> 2462 [label=true,color=green];
		2460 -> 2463 [label=false,color=brown];
	2461 [label="Якщо хочеш винищити всіх орокінів — підіймись нагору. Там ще лишилося кілька живих представників, які не зможуть утекти від твого гніву. Почни з «Бабусі».",shape=box,color=blue];
		2461 -> 2464;
	2462 [label="+10 Chemistry",color=orange];
		2462 -> 2465;
	2463 [label="Узурпаторе. Є ще одна причина, чому я не влаштував якогось навіженого, кривавого, огидного бешкету.",shape=box,color=blue];
		2463 -> 2466;
	2464 [label="Вона, зрештою, бачила найбільше з нас.",shape=box,color=blue];
		2464 -> 2467;
	2465 [label="Chat ends.",color=orange];
	2466 [label="Я все ще не побачив розв’язки маленької драми між нашим дорогим дворецьким та відчуженою родиною Альбрехта нагорі.",shape=box,color=blue];
		2466 -> 2468;
	2467 [label="Update boolean RoatheNoDate",color=orange];
		2467 -> 2469;
	2468 [label="Не забувай, у всьому цьому я маю особисту зацікавленість — незалежно від того, чи маємо ми з тобою угоду. Я збираюся подбати про те, щоб коли Альбрехт уперше ступить назад у це Святилище, перше обличчя, яке він побачить…",shape=box,color=blue];
		2468 -> 2470;
	2469 [label="Chat ends.",color=orange];
	2470 [label="Було моїм.",shape=box,color=blue];
		2470 -> 2471;
	2471 [label="Я просто ще не можу вирішити, чи стоятиму я тоді серед тіл його близьких, чи ні.",shape=box,color=blue];
		2471 -> 2472;
	2472 [label="Рішення, рішення…",shape=box,color=blue];
		2472 -> 2473;
	2473 [label="+10 Chemistry",color=orange];
		2473 -> 2474;
	2474 [label="Chat ends.",color=orange];
}