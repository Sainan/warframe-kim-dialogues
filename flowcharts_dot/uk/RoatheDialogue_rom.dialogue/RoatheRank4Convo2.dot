	j153803564 [label="У тебе є засоби. У тебе є сила. Ти достатньо голосно висловлював невдоволення своєю ситуацією.",shape=box,color=red];
		j153803564 -> j568845863;
	j2609474335 [label="Я просто не розумію, чому Диявол Тау задовольняється тим, що сидить у крипті й байдикує. Навіть із нашою угодою.",shape=box,color=red];
		j2609474335 -> j2206556128;
	j1619634940 [label="Ти ж орокін. Ти ненавидиш усіх навколо. Що тебе стримує?",shape=box,color=red];
		j1619634940 -> j1264736417;
	j3145394484 [label="Я просто не розумію, чому Диявол Тау задовольняється тим, що сидить у крипті й байдикує. Особливо коли ми не маємо жодної угоди.",shape=box,color=red];
		j3145394484 -> j3657429577;
	j568845863 [label="+5 Chemistry",color=orange];
		j568845863 -> j2428412063;
	j2206556128 [label="Check boolean RoatheKnowsReset2",color=orange];
		j2206556128 -> j3338798240 [label=true,color=green];
		j2206556128 -> j4129154267 [label=false,color=brown];
	j1264736417 [label="Дозволь мені на мить зібратися з думками, перш ніж ми продовжимо цю розмову з позиції чистої люті та злоби.",shape=box,color=blue];
		j1264736417 -> j3468256698;
	j3657429577 [label="Check boolean RoatheKnowsReset2",color=orange];
		j3657429577 -> j3338798240 [label=true,color=green];
		j3657429577 -> j520375500 [label=false,color=brown];
	j2428412063 [label="І я радий, що ти визнаєш, що я можу легко перетворити це місце на бійню.",shape=box,color=blue];
		j2428412063 -> j312046155;
	j3338798240 [label="Тому що лишається питання, чому я взагалі так тобі повірив, щоб розповісти стільки… лише щоб побачити, як ти зраджуєш цю довіру, узурпаторе.",shape=box,color=blue];
		j3338798240 -> j1562654449;
	j4129154267 [label="Робота ще не завершена. Я навряд чи зможу залучити тебе до повернення моїх спогадів, якщо просто піду й переріжу всіх, чи не так?",shape=box,color=blue];
		j4129154267 -> j2019708730;
	j3468256698 [label="Бо я докладаю чималих зусиль, щоб негайно не підтвердити твої слова.",shape=box,color=blue];
		j3468256698 -> j3464340099;
	j520375500 [label="Можливо, я сподіваюся, що ти порозумнішаєш і зміниш думку. А ймовірність цього різко знизиться, якщо я всіх навколо виріжу, чи не так?",shape=box,color=blue];
		j520375500 -> j2019708730;
	j312046155 [label="Але це нічого б не дало, чи не так? Якщо є лише один урок, який можна винести з війни, то це те, що вбивство зрештою дивовижно мало що вирішує.",shape=box,color=blue];
		j312046155 -> j642553339;
	j1562654449 [label="А ймовірність на твою співпрацю різко зменшиться, якщо я всіх довкола виріжу, чи не так? Якщо є лише один урок, який можна винести з війни, то це те, що вбивство зрештою дивовижно мало що вирішує.",shape=box,color=blue];
		j1562654449 -> j2178905414;
	j2019708730 [label="Крім того, це нічого б не дало, чи не так? Якщо є лише один урок, який можна винести з війни, то це те, що вбивство зрештою дивовижно мало що вирішує.",shape=box,color=blue];
		j2019708730 -> j2178905414;
	j3464340099 [label="Я розумію твою ненависть до орокінів. Повір, більшість орокінів ненавиділи самих орокінів. Я добре знаю про наші злочини. Про ті жахливі речі, які ми вчинили. ",shape=box,color=blue];
		j3464340099 -> j231214672;
	j642553339 [label="Хоча приємно час від часу мати бажання зробити це.",shape=box,color=blue];
		j642553339 -> j1683961363;
		j642553339 -> j2448735999;
		j642553339 -> j3605711721;
	j2178905414 [label="Хоча приємно час від часу мати бажання зробити це.",shape=box,color=blue];
		j2178905414 -> j3605711721;
		j2178905414 -> j2448735999;
		j2178905414 -> j1683961363;
	j231214672 [label="Одного лише Юванського театру цілком достатньо, щоб зрівняти наше суспільство із землею. Але ти під один розчерк засуджуєш цілий народ. Із якого, між іншим, і ти родом, мій узурпаторе!",shape=box,color=blue];
		j231214672 -> j572684351;
	j1683961363 [label="То єдина причина, чому ти не вбиваєш решту, бо в цьому немає сенсу?",shape=box,color=red];
		j1683961363 -> j2952845624;
	j2448735999 [label="Інших причин, чому ти дозволяєш усім жити, немає?",shape=box,color=red];
		j2448735999 -> j643452585;
	j3605711721 [label="Навіть Марі й Ліона?",shape=box,color=red];
		j3605711721 -> j3765620512;
	j572684351 [label="Ти нічого не знаєш про всіх тих добрих людей, що працювали й гинули в тих золотих стінах. Про саги, складені про їхні життя й загублені в часі.",shape=box,color=blue];
		j572684351 -> j2548652025;
	j2952845624 [label="Їхнє вбивство не має сенсу. Чи ні? Ти намагаєшся переконати мене в протилежному? Узурпаторе, я вражений! Ніколи не вважав тебе таким підступним чудовиськом!",shape=box,color=blue];
		j2952845624 -> j991077562;
		j2952845624 -> j4265267415;
	j643452585 [label="Якщо хочеш зробити якийсь натяк, узурпатори, то просто прямо скажи це.",shape=box,color=blue];
		j643452585 -> j991077562;
		j643452585 -> j4265267415;
	j3765620512 [label="Я майже певен, що якби тут у крипті знайшли криваві плями там, де раніше були ті фанатики, мені б дуже за це нарікали, чи не так?",shape=box,color=blue];
		j3765620512 -> j3744658917;
	j2548652025 [label="Про ріки сліз, пролитих за трагедіями, що залишаться неоспіваними лише тому, що ти про них не знаєш.",shape=box,color=blue];
		j2548652025 -> j2557965812;
	j991077562 [label="Це нормально визнати, що тобі подобається товариство. Люди можуть більше, ніж просто служити утилітарній меті.",shape=box,color=red];
		j991077562 -> j796436421;
	j4265267415 [label="Це нормально визнати, що ми хочемо позбутися самотності, навіть якщо ми тебе дратуємо.",shape=box,color=red];
		j4265267415 -> j134072315;
	j3744658917 [label="Ти, дворецький, чи тенно, чи жахлива «Мати» тенно. Ох. Вона. Вона мене непокоїть. Але це тема для іншої розмови.",shape=box,color=blue];
		j3744658917 -> j4265267415;
		j3744658917 -> j991077562;
	j2557965812 [label="Я чув схлипування твого дитячого двійника, вигуки імені «Адіс». ",shape=box,color=blue];
		j2557965812 -> j321634361;
