	j36104292 [label="Evaluate expressions",color=orange];
		j36104292 -> j2631551725 [label="RoatheUnloved2",color=purple];
		j36104292 -> j2631551725 [label="RoatheUnloved1",color=purple];
		j36104292 -> j2631551725 [label="RoatheAlone1",color=purple];
		j36104292 -> j2631551725 [label="RoatheBirdThree",color=purple];
		j36104292 -> j1450727125 [label="false",color=purple];
	j1272953254 [label="Для тебе це ім’я унікальне.",shape=box,color=blue];
		j1272953254 -> j2874145602;
	j1827458436 [label="Не випробуй свою удачу, узурпаторе. «Подобається» — це трохи перебільшення. Ти радше зростаєш на мені. Як цвіль.",shape=box,color=blue];
		j1827458436 -> j1328807703;
	j237281893 [label="«Подобається?» Це як? Я ніколи не усвідомлював, що я такий мазохіст. Гм. Чи це просто відчуття, ніби моє тіло гниє, і відчуття, ніби ви всі «зростаєте на мені»?",shape=box,color=blue];
		j237281893 -> j3365917150;
	j2631551725 [label="Доволі приємно мати можливість із кимось говорити. Навіть якщо ви, як ти кажеш, іноді дратуєте.",shape=box,color=blue];
		j2631551725 -> j2847493859;
	j1450727125 [label="Самотність? Пхе. Єдине, чого ти позбуваєшся, це будь-яка розсудливість, яка намагається повернутися в моє життя. Якщо ти намагаєшся натякнути, що ви всі «зростаєте на мені», то знаєш ти, що ще так робить?",shape=box,color=blue];
		j1450727125 -> j3521460263;
	j2874145602 [label="Але не для зірок.",shape=box,color=blue];
		j2874145602 -> j3729501909;
	j1328807703 [label="+5 Chemistry",color=orange];
		j1328807703 -> j689414758;
	j3365917150 [label="Як цвіль.",shape=box,color=blue];
		j3365917150 -> j689414758;
	j2847493859 [label="+5 Chemistry",color=orange];
		j2847493859 -> j3841643563;
	j3521460263 [label="Цвіль.",shape=box,color=blue];
		j3521460263 -> j689414758;
	j3729501909 [label="Змальовуй мій народ у барвах крові, як тобі заманеться. Плав золото орокінів і називай нас чудовиськами. Ми заслуговуємо на кожну краплину ненависті, яку ти можеш нам віддати.",shape=box,color=blue];
		j3729501909 -> j1185204252;
	j689414758 [label="Boolean RoatheAlone2 is now true.",color=orange];
		j689414758 -> j1654361623;
	j3841643563 [label="Я мушу визнати. Ти зростаєш на мені. Як цвіль.",shape=box,color=blue];
		j3841643563 -> j689414758;
	j1185204252 [label="Але не смій навіть на мить думати, що ми були здатні лише на це.",shape=box,color=blue];
		j1185204252 -> j2537268621;
	j1654361623 [label="Check boolean LoidFamilyComplete",color=orange];
		j1654361623 -> j1933300832 [label=true,color=green];
		j1654361623 -> j3267812117 [label=false,color=brown];
	j2537268621 [label="Якщо хочеш винищити всіх орокінів — підіймись нагору. Там ще лишилося кілька живих представників, які не зможуть утекти від твого гніву. Почни з «Бабусі».",shape=box,color=blue];
		j2537268621 -> j2997725804;
	j1933300832 [label="+10 Chemistry",color=orange];
		j1933300832 -> "Chat ends.";
	j3267812117 [label="Узурпаторе. Є ще одна причина, чому я не влаштував якогось навіженого, кривавого, огидного бешкету.",shape=box,color=blue];
		j3267812117 -> j2026454020;
	j2997725804 [label="Вона, зрештою, бачила найбільше з нас.",shape=box,color=blue];
		j2997725804 -> j155006797;
	j2026454020 [label="Я все ще не побачив розв’язки маленької драми між нашим дорогим дворецьким та відчуженою родиною Альбрехта нагорі.",shape=box,color=blue];
		j2026454020 -> j2390176302;
	j155006797 [label="Boolean RoatheNoDate is now true.",color=orange];
		j155006797 -> "Chat ends.";
	j2390176302 [label="Не забувай, у всьому цьому я маю особисту зацікавленість — незалежно від того, чи маємо ми з тобою угоду. Я збираюся подбати про те, щоб коли Альбрехт уперше ступить назад у це Святилище, перше обличчя, яке він побачить…",shape=box,color=blue];
		j2390176302 -> j1066317417;
	j1066317417 [label="Було моїм.",shape=box,color=blue];
		j1066317417 -> j3024599918;
	j3024599918 [label="Я просто ще не можу вирішити, чи стоятиму я тоді серед тіл його близьких, чи ні.",shape=box,color=blue];
		j3024599918 -> j2854943711;
	j2854943711 [label="Рішення, рішення…",shape=box,color=blue];
		j2854943711 -> j1933300832;
}