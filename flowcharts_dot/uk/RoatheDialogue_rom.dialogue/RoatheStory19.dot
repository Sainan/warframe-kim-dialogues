	j1521031061 [label="ДИПЛОМАТІЯ",shape=box,color=blue];
		j1521031061 -> j3079945357;
	j3079945357 [label="Витяг: Серед Семи Виконавців Балласа вважали першим серед рівних. ",shape=box,color=blue];
		j3079945357 -> j233038356;
	j233038356 [label="Невтомний дипломат, солодкомовний переконувач, він вирішував суперечки та кривди інших.",shape=box,color=blue];
		j233038356 -> j3653746319;
	j3653746319 [label="О, як я радів, коли усвідомив, що він став трояндою, затиснутою між двома терновими кущами. ",shape=box,color=blue];
		j3653746319 -> j1802892177;
	j1802892177 [label="Фракція підбурювачів війни на чолі з Нітог тягнула в один бік. Пацифісти на чолі зі Скарном — в інший.",shape=box,color=blue];
		j1802892177 -> j1395474411;
	j1395474411 [label="Баллас був змушений прийняти рішення й готуватися до злісної ворожнечі зі сторони тих, кого не обрав.",shape=box,color=blue];
		j1395474411 -> j3638014991;
	j3638014991 [label="З невідомих мені причин він обрав мир. Співвідношення стало 4 до 3 — кровожерливі свідомі раптово стали союзниками й друзями.",shape=box,color=blue];
		j3638014991 -> j328549477;
	j328549477 [label="«Так чи інак, але він передумає», — усе обіцяла Нітог, навіть коли мене відправили шукати невдоволених серед гарнізону даксів.",shape=box,color=blue];
		j328549477 -> j921430358;
	j921430358 [label="Add 1 to HellStory counter",color=orange];
		j921430358 -> "Chat ends.";
}