	5720 [label="Витяг: Серед Семи Виконавців Балласа вважали першим серед рівних. ",shape=box,color=blue];
		5720 -> 5721;
	5721 [label="Невтомний дипломат, солодкомовний переконувач, він вирішував суперечки та кривди інших.",shape=box,color=blue];
		5721 -> 2301;
	2301 [label="О, як я радів, коли усвідомив, що він став трояндою, затиснутою між двома терновими кущами. ",shape=box,color=blue];
		2301 -> 5734;
	5734 [label="Фракція підбурювачів війни на чолі з Нітог тягнула в один бік. Пацифісти на чолі зі Скарном — в інший.",shape=box,color=blue];
		5734 -> 2300;
	2300 [label="Баллас був змушений прийняти рішення й готуватися до злісної ворожнечі зі сторони тих, кого не обрав.",shape=box,color=blue];
		2300 -> 2305;
	2305 [label="З невідомих мені причин він обрав мир. Співвідношення стало 4 до 3 — кровожерливі свідомі раптово стали союзниками й друзями.",shape=box,color=blue];
		2305 -> 2308;
	2308 [label="«Так чи інак, але він передумає», — усе обіцяла Нітог, навіть коли мене відправили шукати невдоволених серед гарнізону даксів.",shape=box,color=blue];
		2308 -> 2299;
