digraph {
	graph [fontname="Roboto Condensed"];
	node [fontname="Roboto Condensed"];
	edge [fontname="Roboto Condensed"];

	"RoatheRank5Convo8 begins." [color=orange];
		"RoatheRank5Convo8 begins." -> j4125803273;
	j4125803273 [label="Check boolean RoatheFailNot21",color=orange];
		j4125803273 -> j1758133089 [label=true,color=green];
		j4125803273 -> "Chat ends." [label=false,color=brown];
	j1758133089 [label="Evaluate expressions on HellStory counter",color=orange];
		j1758133089 -> j2035142723 [label="x >= 21",color=purple];
		j1758133089 -> "Chat ends." [label="x <= 21",color=purple];
		j1758133089 -> "Chat ends." [label="false",color=purple];
	"Chat ends." [color=orange];
	j2035142723 [label="Дурне! Що ти робиш?! Навіщо, навіщо заглиблюватися в печери, де тобі не раді?!",shape=box,color=blue];
		j2035142723 -> j3991638743;
	j3991638743 [label="Ти маєш це виправити, я вимагаю. Це твоя провина. Я відчуваю це, воно дряпає мене зсередини, розриває. Як якийсь звір.",shape=box,color=blue];
		j3991638743 -> j2806514377;
	j2806514377 [label="Позбав мене від цього. Позбав мене від цієї чуми. Очисти мій розум від цих спогадів. Я знаю, що ти можеш. Використай свої сили й поклади всьому край. Негайно.",shape=box,color=blue];
		j2806514377 -> j1010553866;
		j2806514377 -> j551983499;
		j2806514377 -> j604986668;
	j1010553866 [label="Ти впевнений? Але… ти розумний, і я маю відчуття, що ти якось розберешся, що не так.",shape=box,color=red];
		j1010553866 -> j1343732628;
	j551983499 [label="Це інший вид спогаду, Роуте. Мої сили на нього не подіють. Він закопаний глибоко у твоїй психіці.",shape=box,color=red];
		j551983499 -> j1585079989;
	j604986668 [label="Якщо тікати та ховатися від правди, ми просто повернемося до того, з чого почали. ",shape=box,color=red];
		j604986668 -> j1057459099;
	j1343732628 [label="Цілком імовірно. Я складу два й два докупи і звинувачу тебе в чомусь, що було зроблено без мого прохання. Упевнений, тобі вдасться пережити цю бурю.",shape=box,color=blue];
		j1343732628 -> j1640673508;
	j1585079989 [label="Можливо. Ти, мабуть, маєш рацію. Але ж я не маю інших варіантів, чи не так? Варто спробувати.",shape=box,color=blue];
		j1585079989 -> j1640673508;
	j1057459099 [label="І якщо це так, ти можеш просто зробити це ще раз. Ці ж сили в тебе ніби невичерпні, чи не так?",shape=box,color=blue];
		j1057459099 -> j1640673508;
	j1640673508 [label="Звісно, я певен, що страшенно розгніваюся на тебе, щойно зрозумію, що мої спогади змінено. І, любове, раджу не казати мені, що це сталося на моє прохання.",shape=box,color=blue];
		j1640673508 -> j3712948374;
	j3712948374 [label="Я просто стверджуватиму, що ти брешеш, і це, імовірно, непоправно зіпсує мою думку про тебе.",shape=box,color=blue];
		j3712948374 -> j2759993317;
		j3712948374 -> j1896364978;
	j2759993317 [label="Ні. Я не можу цього зробити. Я не зроблю цього. Ми повинні разом знайти рішення. Хіба ми не можемо просто поговорити про це?",shape=box,color=red];
		j2759993317 -> j147167507;
	j1896364978 [label="Я… дійсно немає іншого шляху?",shape=box,color=red];
		j1896364978 -> j147167507;
	j147167507 [label="Ні. Якщо хочеш, щоб дворецький піднявся нагору, витри з мене всю цю нісенітницю, як я просив. Якщо тобі байдуже, роби як знаєш. Мені байдуже.",shape=box,color=blue];
		j147167507 -> j3973412939;
	j3973412939 [label="Це, і, звісно ж, наша особиста дружба — єдиний важіль впливу, який я маю в цій ситуації. Це так просто.",shape=box,color=blue];
		j3973412939 -> j4021490305;
	j4021490305 [label="Що скажеш ти?",shape=box,color=blue];
		j4021490305 -> j3569182869;
		j4021490305 -> j1142899071;
	j3569182869 [label="Гаразд. Я… я зроблю це. Я зітру тобі розум. Навіть якщо це забере Марі та Ліона.",shape=box,color=red];
		j3569182869 -> j2622532229;
	j1142899071 [label="Ні. Я відмовляюся. Я знайду інший спосіб переконати тебе рухатися далі.",shape=box,color=red];
		j1142899071 -> j3777990742;
	j2622532229 [label="+10 Chemistry",color=orange];
		j2622532229 -> j2913944768;
	j3777990742 [label="Я бажаю тобі всього найліпшого.",shape=box,color=blue];
		j3777990742 -> "Initiate conversation LyonRoatheFail in /Lotus/Types/Gameplay/1999Wf/Dialogue/LyonDialogue_rom.dialogue";
	j2913944768 [label="Добре. Тоді до справи. ",shape=box,color=blue];
		j2913944768 -> j4072107213;
	"Initiate conversation LyonRoatheFail in /Lotus/Types/Gameplay/1999Wf/Dialogue/LyonDialogue_rom.dialogue" [label="Initiate conversation LyonRoatheFail in /Lotus/Types/Gameplay/1999Wf/Dialogue/LyonDialogue_rom.dialogue",color=orange];
		"Initiate conversation LyonRoatheFail in /Lotus/Types/Gameplay/1999Wf/Dialogue/LyonDialogue_rom.dialogue" -> "Chat ends.";
	j4072107213 [label="Add 1 to Promise counter",color=orange];
		j4072107213 -> j302033967;
	j302033967 [label="Boolean RoatheWillReset is now true.",color=orange];
		j302033967 -> "Chat ends.";
}