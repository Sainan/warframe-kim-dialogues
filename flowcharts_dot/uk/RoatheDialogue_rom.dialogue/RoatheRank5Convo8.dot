digraph {
	graph [fontname="Roboto Condensed"];
	node [fontname="Roboto Condensed"];
	edge [fontname="Roboto Condensed"];

	"RoatheRank5Convo8 begins." [color=orange];
		"RoatheRank5Convo8 begins." -> j4125803273;
	j4125803273 [label="Check boolean RoatheFailNot21",color=orange];
		j4125803273 -> j1758133089 [label=true,color=green];
		j4125803273 -> "Chat ends." [label=false,color=brown];
	j1758133089 [label="Evaluate expressions on HellStory counter",color=orange];
		j1758133089 -> j2035142723 [label="x >= 21",color=purple];
		j1758133089 -> "Chat ends." [label="x <= 21",color=purple];
		j1758133089 -> "Chat ends." [label="false",color=purple];
	"Chat ends." [color=orange];
	j2035142723 [label="Дурне! Що ти робиш?! Навіщо, навіщо заглиблюватися в печери, де тобі не раді?!",shape=box,color=blue];
		j2035142723 -> j3991638743;
	j3991638743 [label="Ти маєш це виправити, я вимагаю. Це твоя провина. Я відчуваю це, воно дряпає мене зсередини, розриває. Як якийсь звір.",shape=box,color=blue];
		j3991638743 -> j2806514377;
	j2806514377 [label="Позбав мене від цього. Позбав мене від цієї чуми. Очисти мій розум від цих спогадів. Я знаю, що ти можеш. Використай свої сили й поклади всьому край. Негайно.",shape=box,color=blue];
		j2806514377 -> j1010553866;
		j2806514377 -> j551983499;
		j2806514377 -> j604986668;
	j1010553866 [label="Ти впевнений? Але… ти розумний, і я маю відчуття, що ти якось розберешся, що не так.",shape=box,color=red];
		j1010553866 -> j1343732628;
	j551983499 [label="Це інший вид спогаду, Роуте. Мої сили на нього не подіють. Він закопаний глибоко у твоїй психіці.",shape=box,color=red];
		j551983499 -> j1585079989;
	j604986668 [label="Якщо тікати та ховатися від правди, ми просто повернемося до того, з чого почали. ",shape=box,color=red];
		j604986668 -> j1057459099;
	j1343732628 [label="Цілком імовірно. Я складу два й два докупи і звинувачу тебе в чомусь, що було зроблено без мого прохання. Упевнений, тобі вдасться пережити цю бурю.",shape=box,color=blue];
		j1343732628 -> j1640673508;
	j1585079989 [label="Можливо. Ти, мабуть, маєш рацію. Але ж я не маю інших варіантів, чи не так? Варто спробувати.",shape=box,color=blue];
		j1585079989 -> j1640673508;
	j1057459099 [label="І якщо це так, ти можеш просто зробити це ще раз. Ці ж сили в тебе ніби невичерпні, чи не так?",shape=box,color=blue];
		j1057459099 -> j1640673508;
	j1640673508 [label="Звісно, я певен, що страшенно розгніваюся на тебе, щойно зрозумію, що мої спогади змінено. І, любове, раджу не казати мені, що це сталося на моє прохання.",shape=box,color=blue];
		j1640673508 -> j3712948374;
	j3712948374 [label="Я просто стверджуватиму, що ти брешеш, і це, імовірно, непоправно зіпсує мою думку про тебе.",shape=box,color=blue];
		j3712948374 -> j2759993317;
		j3712948374 -> j1896364978;
	j2759993317 [label="Ні. Я не можу цього зробити. Я не зроблю цього. Ми повинні разом знайти рішення. Хіба ми не можемо просто поговорити про це?",shape=box,color=red];
		j2759993317 -> j147167507;
	j1896364978 [label="Я… дійсно немає іншого шляху?",shape=box,color=red];
		j1896364978 -> j147167507;
	j147167507 [label="Ні. Якщо хочеш, щоб дворецький піднявся нагору, витри з мене всю цю нісенітницю, як я просив. Якщо тобі байдуже, роби як знаєш. Мені байдуже.",shape=box,color=blue];
		j147167507 -> j3973412939;
	j3973412939 [label="Це, і, звісно ж, наша особиста дружба — єдиний важіль впливу, який я маю в цій ситуації. Це так просто.",shape=box,color=blue];
		j3973412939 -> j4021490305;
	j4021490305 [label="Що скажеш ти?",shape=box,color=blue];
		j4021490305 -> j3569182869;
		j4021490305 -> j3654987643;
	j3569182869 [label="Гаразд. Я… я зроблю це. Я зітру тобі розум. Навіть якщо це забере Марі та Ліона.",shape=box,color=red];
		j3569182869 -> j2622532229;
	j3654987643 [label="Ні. Я відмовляюся. Мені шкода. Маємо розібратися з цим.",shape=box,color=red];
		j3654987643 -> j2509245127;
		j3654987643 -> j2151363606;
	j2622532229 [label="+10 Chemistry",color=orange];
		j2622532229 -> j2913944768;
	j2509245127 [label="Обговорімо це.",shape=box,color=red];
		j2509245127 -> j1459254766;
	j2151363606 [label="Ненавидь мене, якщо хочеш. Але я нічого не робитиму, поки ми спочатку це не обговоримо.",shape=box,color=red];
		j2151363606 -> j1213328397;
	j2913944768 [label="Добре. Тоді до справи. ",shape=box,color=blue];
		j2913944768 -> j4072107213;
	j1459254766 [label="Не смій! Не смій говорити мені «Заспокойся»! Хіба ти не думаєш, що я маю повне право почуватися так, ніби мене розривають навпіл?!",shape=box,color=blue];
		j1459254766 -> j672817543;
	j1213328397 [label="Дивовижно. Дивовижно та несподівано. Поясни.",shape=box,color=blue];
		j1213328397 -> j1053771659;
		j1213328397 -> j2215986863;
	j4072107213 [label="Add 1 to Promise counter",color=orange];
		j4072107213 -> j302033967;
	j672817543 [label="Мені здається, ніби я зрозумів себе до кінця, саму основу свого єства, розтріскану та розірвану, як сама клята Луа! Переписану чорнилом. Боягуз!",shape=box,color=blue];
		j672817543 -> j2524360980;
	j1053771659 [label="Мені потрібно було це зробити, бо так мало статися. Ти більше не міг від цього ховатися.",shape=box,color=red];
		j1053771659 -> j1274312314;
	j2215986863 [label="Думай про мене що завгодно. Але я пізнаю завиток, коли бачу його.",shape=box,color=red];
		j2215986863 -> j3058603251;
	j302033967 [label="Boolean RoatheWillReset is now true.",color=orange];
		j302033967 -> "Chat ends.";
	j2524360980 [label="І ти смієш казати мені «заспокойся»?!",shape=box,color=blue];
		j2524360980 -> j1830055178;
	j1274312314 [label="Boolean RoatheFail is now true.",color=orange];
		j1274312314 -> j2474501013;
	j3058603251 [label="Так, гадаю, ти точно знаєшся на таких речах, чи не так? Продовжуй.",shape=box,color=blue];
		j3058603251 -> j27918187;
		j3058603251 -> j2681121817;
	j1830055178 [label="Evaluate expressions",color=orange];
		j1830055178 -> j2108171997 [label="RoatheForgivenessShortcut",color=purple];
		j1830055178 -> j2281701111 [label="RoatheVillainyShortcut",color=purple];
		j1830055178 -> j2318547072 [label="false",color=purple];
	j2474501013 [label="У мені вирує скажена звірина, що роз’їдає ізсередини.",shape=box,color=blue];
		j2474501013 -> j3511536048;
	j27918187 [label="Якщо прагнеш шукати прощення, можеш це робити. Але ти мусиш цього хотіти. Ти мусиш обрати цей шлях. Ніхто інший не зробить це за тебе.",shape=box,color=red];
		j27918187 -> j1979467324;
	j2681121817 [label="Якщо ти хочеш обрати шлях і прокласти його сам і для себе, зроби це. Не вибачайся. Але це твій шлях, і лише твій.",shape=box,color=red];
		j2681121817 -> j2786226042;
	j2108171997 [label="Гнів нічого не вирішить, Роуте. Ти злишся, бо боїшся зізнатися в скоєному. І в тому, ким ти став.",shape=box,color=red];
		j2108171997 -> j623726004;
	j2281701111 [label="Гаразд. Злися. Але використай цей гнів на благо. Використай його, щоби позбутися ненависті, яку скеровуєш не в тому напрямку.",shape=box,color=red];
		j2281701111 -> j2045609363;
	j2318547072 [label="Evaluate expressions on Thermostat counter",color=orange];
		j2318547072 -> j2108171997 [label="x >= 5",color=purple];
		j2318547072 -> j2281701111 [label="x <= 0",color=purple];
		j2318547072 -> j2987797928 [label="x > 0 && x < 5",color=purple];
		j2318547072 -> j2987797928 [label="false",color=purple];
	j3511536048 [label="І я не знаю, як це задовольнити. Я не знаю, чи можу. Я сподівався, що ці розмови підкажуть мені шлях; але тепер я бачу, що це марно.",shape=box,color=blue];
		j3511536048 -> j3767054558;
	j1979467324 [label="Тебе не визначає твоє минуле, Роуте. Тебе визначає твоє майбутнє. І в тебе ще є майбутнє, на відміну від усіх орокінів, що загинули тієї Ночі барабанів наґа.",shape=box,color=red];
		j1979467324 -> j2265095180;
	j2786226042 [label="Тебе не визначають думки тих, хто навколо. Ані те, що вони думають про твої вчинки. Тебе визначає лише те, що ти сам віриш про себе й свої вибори.",shape=box,color=red];
		j2786226042 -> j1030752653;
	j623726004 [label="Ти дозволяєш цьому гніву розривати себе зсередини. Ти міг би використовувати його, щоби боротися з тими, хто досі руйнує цей світ. Тут. Зараз.",shape=box,color=red];
		j623726004 -> j7640769;
	j2045609363 [label="Ти направляєш це на себе. Тобі слід направляти це на світ, який звинувачує тебе в тому, що ти зробив усе можливе, щоб урятувати його від орокінської імперії.",shape=box,color=red];
		j2045609363 -> j2453400802;
	j2987797928 [label="Я просто хочу допомогти тобі. Просто хочу знати правильні слова. Тебе наче розриває у два боки. Куди ти хочеш піти?",shape=box,color=red];
		j2987797928 -> j3840029194;
	j3767054558 [label="Однак є рішення, чи не так? У твоїх силах виправити це… ці жахливі муки в моїй свідомості.",shape=box,color=blue];
		j3767054558 -> j3544932315;
	j2265095180 [label="Це єдине, що визначає тебе тепер. Ти можеш змінитися. І ти можеш змінити світ навколо себе. Моє єдине питання — чи ти бодай спробуєш?",shape=box,color=red];
		j2265095180 -> j2618550111;
	j1030752653 [label="А проста істина полягає в тому, що ти — один із небагатьох орокінів, що пережили Ніч барабанів наґи. З мого погляду це був стратегічний відступ.",shape=box,color=red];
		j1030752653 -> j4103517110;
	j7640769 [label="Ти дозволяєш цьому гніву розривати себе зсередини. Ти міг би використовувати його, щоби боротися з тими, хто досі руйнує цей світ. Тут. Зараз.",shape=box,color=red];
		j7640769 -> j3870551587;
	j2453400802 [label="Тебе не визначають думки тих, хто навколо. Ані те, що вони думають про твої вчинки. Тебе визначає лише те, що ти сам віриш про себе й свої вибори.",shape=box,color=red];
		j2453400802 -> j3286236756;
	j3840029194 [label="Boolean RoatheFail is now true.",color=orange];
		j3840029194 -> j1596179631;
	j3544932315 [label="Узурпаторе. Мандрівниче. Благаю тебе зараз. Так, Я вірю, що це єдиний спосіб рухатися вперед. І це в твоїх власних інтересах.",shape=box,color=blue];
		j3544932315 -> j937976941;
	j2618550111 [label="Спробуєш пробачити себе й рухатися вперед?",shape=box,color=red];
		j2618550111 -> j869475443;
	j4103517110 [label="Ні більше. Ні менше.",shape=box,color=red];
		j4103517110 -> j3127707193;
	j3870551587 [label="Це єдине, що визначає тебе тепер. Ти можеш змінитися. І ти можеш змінити світ навколо себе. Моє єдине питання — чи ти бодай спробуєш?",shape=box,color=red];
		j3870551587 -> j638896481;
	j3286236756 [label="А проста істина полягає в тому, що ти — один із небагатьох орокінів, що пережили Ніч барабанів наґи. З мого погляду це був стратегічний відступ.",shape=box,color=red];
		j3286236756 -> j2318199451;
	j1596179631 [label="Я не знаю, узурпаторе. І в цьому найбільша проблема.",shape=box,color=blue];
		j1596179631 -> j2474501013;
	j937976941 [label="Якщо ти колись захочеш, щоб дворецький піднявся нагору та помирився з родиною Ентраті, мусиш зробити так, як я кажу. Ти мусиш.",shape=box,color=blue];
		j937976941 -> j3361925907;
		j937976941 -> j3150054150;
	j869475443 [label="Boolean RoatheRedeemed is now true.",color=orange];
		j869475443 -> j2634822837;
	j3127707193 [label="Boolean RoatheVillain is now true.",color=orange];
		j3127707193 -> j2634822837;
	j638896481 [label="Спробуєш пробачити себе й рухатися вперед?",shape=box,color=red];
		j638896481 -> j1461996684;
	j2318199451 [label="Ні більше. Ні менше.",shape=box,color=red];
		j2318199451 -> j2690791916;
	j3361925907 [label="А що саме?..",shape=box,color=red];
		j3361925907 -> j709210553;
	j3150054150 [label="Ні. Я знаю, що ти проситимеш, і відповім одразу — ні.",shape=box,color=red];
		j3150054150 -> j2923122175;
	j2634822837 [label="+20 Chemistry",color=orange];
		j2634822837 -> j2380217908;
	j1461996684 [label="Boolean RoatheRedeemed is now true.",color=orange];
		j1461996684 -> j2246562986;
	j2690791916 [label="Boolean RoatheVillain is now true.",color=orange];
		j2690791916 -> j2795677713;
	j709210553 [label="У тебе є сила. Сила, яка може скасувати час. Закрутити його в завиток, а то й у петлю. І це має… цікавий вплив на розуми протофреймів через їхню прив’язаність до зараження та часу.",shape=box,color=blue];
		j709210553 -> j2618498308;
	j2923122175 [label="Ти зможеш, не збрехавши душею, сказати, що твої сили ніколи не використовувалися на розумах протофреймів, яких ти називаєш друзями чи коханими?",shape=box,color=blue];
		j2923122175 -> j2610262665;
	j2380217908 [label="Добре. Я погоджуюся й приймаю твій аргумент. Дякую, мандрівниче, за те, що… тобі вдалося відмовити мене від цієї конкретної проблеми.",shape=box,color=blue];
		j2380217908 -> j4094289456;
	j2246562986 [label="+20 Chemistry",color=orange];
		j2246562986 -> j702497529;
	j2795677713 [label="+20 Chemistry",color=orange];
		j2795677713 -> j2961356176;
	j2618498308 [label="Отже, і нашу прив’язаність до часу. Я прошу тебе зараз. Ні, я благаю. Скористайся своїми силами заради мене. Забери в мене ці думки. Забери в мене ці спогади.",shape=box,color=blue];
		j2618498308 -> j844794507;
	j2610262665 [label="Тоді добре. Хай буде так. Я не проситиму тебе більше. Але чи було хоч раз таке, що твої сили використовувалися просто для власної розваги, цікавості чи щоб виправити непотрібні помилки в стосунках з іншими?!",shape=box,color=blue];
		j2610262665 -> j844794507;
	j4094289456 [label="Я ціную це більше, аніж ти можеш подумати.",shape=box,color=blue];
		j4094289456 -> j1057494371;
	j702497529 [label="Пробачити себе за те, що я зробив? І рухатися вперед, у майбутнє? Гм.",shape=box,color=blue];
		j702497529 -> j470712614;
	j2961356176 [label="Відступ, щоб виграти війну. Гм.",shape=box,color=blue];
		j2961356176 -> j2172120963;
	j844794507 [label="Я маю забути про те, що взяв сироватку від Ентраті. Прошу.",shape=box,color=blue];
		j844794507 -> j3960757458;
		j844794507 -> j2272328526;
		j844794507 -> j187963278;
	j1057494371 [label="Мені час іти. У мене настрій випити купу алкоголю та похмуро дивитися вдалечінь.",shape=box,color=blue];
		j1057494371 -> "Chat ends. Next chat will be Roathe5Day2.";
	j470712614 [label="Хоча я… трохи сумніваюся у твоєму переосмисленні ситуації, я… надто спокушений новим майбутнім і що воно дасть мені для опору, узурпаторе. Мандрівниче.",shape=box,color=blue];
		j470712614 -> j643065613;
	j2172120963 [label="Хоча я… трохи сумніваюся у твоєму переосмисленні твоїх дій як тактичного відступу, визнаю, що я… все одно підтримую це, узурпаторе. Мандрівниче.",shape=box,color=blue];
		j2172120963 -> j2380217908;
	j3960757458 [label="Ти впевнений? Але… ти розумний, і я маю відчуття, що ти якось розберешся, що не так.",shape=box,color=red];
		j3960757458 -> j1610375231;
	j2272328526 [label="Це інший вид спогаду, Роуте. Мої сили на нього не подіють. Він закопаний глибоко у твоїй психіці.",shape=box,color=red];
		j2272328526 -> j128099972;
	j187963278 [label="Якщо тікати та ховатися від правди, ми просто повернемося до того, з чого почали.",shape=box,color=red];
		j187963278 -> j3425696423;
	"Chat ends. Next chat will be Roathe5Day2." [color=orange];
	j643065613 [label="Цей «новий поворот» у моєму житті. Добре. Я погоджуюся й приймаю твій аргумент. Дякую, мандрівниче, за те, що… тобі вдалося відмовити мене від цієї конкретної проблеми.",shape=box,color=blue];
		j643065613 -> j4094289456;
	j1610375231 [label="Цілком імовірно. Я складу два й два докупи і звинувачу тебе в чомусь, що було зроблено без мого прохання. Упевнений, тобі вдасться пережити цю бурю.",shape=box,color=blue];
		j1610375231 -> j3696860276;
	j128099972 [label="Можливо. Ти, мабуть, маєш рацію. Але ж я не маю інших варіантів, чи не так? Варто спробувати.",shape=box,color=blue];
		j128099972 -> j3696860276;
	j3425696423 [label="І якщо це так, ти можеш просто зробити це ще раз. Ці ж сили в тебе ніби невичерпні, чи не так?",shape=box,color=blue];
		j3425696423 -> j3696860276;
	j3696860276 [label="Звісно, я певен, що страшенно розгніваюся на тебе, щойно зрозумію, що мої спогади змінено. І, мандрівниче, раджу не казати мені, що це сталося на моє прохання.",shape=box,color=blue];
		j3696860276 -> j849438380;
	j849438380 [label="Я просто стверджуватиму, що ти брешеш, і це, імовірно, непоправно зіпсує мою думку про тебе.",shape=box,color=blue];
		j849438380 -> j1192542455;
		j849438380 -> j179475641;
	j1192542455 [label="Ні. Я не можу цього зробити. Я не зроблю цього. Ми повинні разом знайти рішення. Хіба ми не можемо просто поговорити про це?",shape=box,color=red];
		j1192542455 -> j2474469667;
	j179475641 [label="Я… дійсно немає іншого шляху?",shape=box,color=red];
		j179475641 -> j2474469667;
	j2474469667 [label="Ні. Якщо хочеш, щоб дворецький піднявся нагору, витри з мене всю цю нісенітницю, як я просив. Якщо тобі байдуже, роби як знаєш. Мені байдуже.",shape=box,color=blue];
		j2474469667 -> j811886747;
	j811886747 [label="Це, і, звісно ж, наша особиста дружба — єдиний важіль впливу, який я маю в цій ситуації. Це так просто.",shape=box,color=blue];
		j811886747 -> j2524790164;
	j2524790164 [label="Що скажеш ти?",shape=box,color=blue];
		j2524790164 -> j3233560680;
		j2524790164 -> j3857520697;
		j2524790164 -> j3035860621;
	j3233560680 [label="Мені треба трохи часу подумати.",shape=box,color=red];
		j3233560680 -> j2443093718;
	j3857520697 [label="Гаразд. Я… я зроблю це. Я зітру тобі розум. Навіть якщо це забере Марі та Ліона.",shape=box,color=red];
		j3857520697 -> j2131986755;
	j3035860621 [label="Ні. Я відмовляюся. Я знайду інший спосіб переконати тебе рухатися далі.",shape=box,color=red];
		j3035860621 -> j952841589;
	j2443093718 [label="Здається, що часу в нас справді вдосталь, чи не так?",shape=box,color=blue];
		j2443093718 -> j2378544752;
	j2131986755 [label="+10 Chemistry",color=orange];
		j2131986755 -> j1893792012;
