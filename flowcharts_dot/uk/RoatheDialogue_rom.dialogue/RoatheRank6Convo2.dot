		j691113767 -> j942106102;
	j813636152 [label="Згідно з контрактом я зобов’язаний пробачити тебе, але там не йдеться про те, щоб лишити обличчя на черепі. Тому ліпше слідкуй за словами, поки рухаємося далі.",shape=box,color=blue];
		j813636152 -> j1912356316;
	j70683420 [label="Згідно з контрактом я зобов’язаний пробачити тебе, тому я не впевнений, чому ти взагалі вибачаєшся, але я ціную це.",shape=box,color=blue];
		j70683420 -> j4076804704;
	j2153182515 [label="Я це добре знаю.",shape=box,color=blue];
		j2153182515 -> j4076804704;
	j2250402527 [label="Це не я укладав цей контракт! І якщо ти зараз розглядаєш можливість відмовитися від нього, знай, що я все одно очікуватиму від тебе виконання своєї частини в майбутньому, незалежно від того, чи виконаю я свою.",shape=box,color=blue];
