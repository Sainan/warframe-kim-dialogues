	j2586636237 [label="Перепрошую?",shape=box,color=blue];
		j2586636237 -> j467209213;
	j4096170780 [label="Я певен, що у твоїх словах є щось непідробне. Або принаймні я вважаю, що ти не усвідомлюєш власного самооману.",shape=box,color=blue];
		j4096170780 -> j765247169;
	j2123378646 [label="Чесність — це чудова річ, мандрівниче. Думаєш, я б засоромив тебе за те, що ти розважаєшся? Навряд.",shape=box,color=blue];
		j2123378646 -> j208870215;
	j467209213 [label="Та ні. Ти ж жартуєш?",shape=box,color=blue];
		j467209213 -> j884473380;
	j765247169 [label="Я вважаю, що найбільшим досягненням орокінської імперії була її здатність переконувати своїх мешканців у чому завгодно, вірити в її зарозумілі ідеї.",shape=box,color=blue];
		j765247169 -> j1429682548;
	j208870215 [label="Ось це стосунки, що приносять взаємне задоволення.",shape=box,color=blue];
		j208870215 -> j3921499284;
