	j2703628426 [label="[Завершити розмову]",shape=box,color=red];
		j2703628426 -> j4238361143;
	j3669447870 [label="Схоже, твоє завдання провалене повністю. Це доволі смішно. Що ж, можу запевнити тебе в моїй співпраці, хоча вона буде доволі стриманою.",shape=box,color=blue];
		j3669447870 -> j1379380459;
	j2002908926 [label="Як тобі вдалося все зіпсувати з обома?! Що ж. Нема сенсу скиглити про це зараз.",shape=box,color=blue];
		j2002908926 -> j28788185;
	j3182921927 [label="Тобі вдалося все зіпсувати як зі мною, так і з Марі. Фантастично. Що ж, можу гарантувати мою співпрацю, але вона буде доволі стриманою.",shape=box,color=blue];
		j3182921927 -> j1966174098;
	j833646196 [label="Тобі вдалося все зіпсувати як зі мною, так і з Ліоном. Фантастично. Що ж, можу гарантувати мою співпрацю, але вона буде доволі стриманою.",shape=box,color=blue];
		j833646196 -> j711835689;
	j1701087237 [label="Схоже, тільки я лишився? Що ж, це досить спрощує ситуацію. Я можу гарантувати тобі мою співпрацю, хоча вона буде доволі стриманою.",shape=box,color=blue];
		j1701087237 -> j405163711;
	j1542587273 [label="Схоже, Марі лишилася останньою лінією опору.",shape=box,color=blue];
