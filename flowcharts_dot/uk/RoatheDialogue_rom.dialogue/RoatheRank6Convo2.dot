		j4076804704 -> j766675096;
	j2018436427 [label="Тож можеш колекціонувати. ",shape=box,color=blue];
		j2018436427 -> j3152352760;
		j2018436427 -> j1652250485;
	j2238875167 [label="Уважай, що справу зроблено. Я подивлюся, що можу зробити, щоби пришвидшити все це між вами. Але після цього лише тобі вирішувати чи закріплювати угоду. Я не можу весь час вести тебе за руку.",shape=box,color=blue];
		j2238875167 -> j1557850422;
