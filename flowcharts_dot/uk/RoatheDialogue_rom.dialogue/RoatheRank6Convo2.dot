		j4016299934 -> j1779744107;
	j896825907 [label="І вона тобі дійсно стала в пригоді. Бо ти доволі болюча скалка в моїй дупі.",shape=box,color=blue];
		j896825907 -> j3643764826;
		j896825907 -> j2782404849;
		j896825907 -> j2781233704;
	j3217507946 [label="І як тобі й здавалося раніше, зараз ти в куті разом із обраною здобиччю — Марі. Чи не так? Але це не важливо. Диявол урятує тебе, згідно з нашою угодою.",shape=box,color=blue];
		j3217507946 -> j166804029;
		j3217507946 -> j2370469825;
		j3217507946 -> j1940828498;
	j526944545 [label="І як тобі й здавалося раніше, зараз ти в куті разом із обраною здобиччю — Ліоном (хоча я чесно не знаю, як тобі це вдалося). Чи не так, узурпаторе? Але це не важливо. Диявол урятує тебе, згідно з нашою угодою.",shape=box,color=blue];
		j526944545 -> j2053851024;
