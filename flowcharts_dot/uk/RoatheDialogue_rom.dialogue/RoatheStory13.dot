		j3540881742 -> j3341610609;
	j3341610609 [label="Багато хто нехтував статистикою, вважаючи її помилкою, брехнею чи теорією змови цефалонів.",shape=box,color=blue];
		j3341610609 -> j1549120912;
	j1549120912 [label="Виховані й розбещені орокінською підступністю, тепер вони з легкістю відмовлялися прийняти правду.",shape=box,color=blue];
		j1549120912 -> j2981413937;
	j2981413937 [label="Відтоді вони жили у вигаданому світі, збудованому суто для їхнього комфорту.",shape=box,color=blue];
		j2981413937 -> j2713089812;
	j2713089812 [label="Ми перемагали; свідомі відступали; усі, хто думав інакше, були зрадниками.",shape=box,color=blue];
