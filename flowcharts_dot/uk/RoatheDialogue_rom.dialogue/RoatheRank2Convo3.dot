digraph {
	1042 [label="RoatheRank2Convo3 begins.",color=orange];
		1042 -> 1043;
	1043 [label="Check boolean RoatheRank2Convo1Complete",color=orange];
		1043 -> 1044 [label=true,color=green];
		1043 -> 1045 [label=false,color=brown];
	1044 [label="Check boolean RoatheKnowsReset2",color=orange];
		1044 -> 1046 [label=true,color=green];
		1044 -> 1047 [label=false,color=brown];
	1045 [label="Chat ends.",color=orange];
	1046 [label="Я знаю, що, напевне, це вже тобі відомо, але сьогодні мені байдуже, у мене немає терпіння.",shape=box,color=blue];
		1046 -> 1047;
	1047 [label="Я думаю, що причиною падіння орокінської імперії була занадто велика кількість шарів скла.",shape=box,color=blue];
		1047 -> 1048;
		1047 -> 1049;
		1047 -> 1050;
	1048 [label="Тобто?",shape=box,color=red];
		1048 -> 1051;
	1049 [label="Занадто безособово?",shape=box,color=red];
		1049 -> 1052;
	1050 [label="[Завершити розмову]",shape=box,color=red];
		1050 -> 1053;
	1051 [label="Уяви собі суспільство, побудоване на усвідомленні, що ти, по суті, завжди в безпеці. Під захистом. Навіть від примарної наявності смерті.",shape=box,color=blue];
		1051 -> 1054;
	1052 [label="+5 Chemistry",color=orange];
		1052 -> 1055;
	1053 [label="Chat ends.",color=orange];
	1054 [label="Де ніщо не може тобі зашкодити.",shape=box,color=blue];
		1054 -> 1056;
	1055 [label="Саме так. Занадто віддалено від небезпеки та реальності ситуації.",shape=box,color=blue];
		1055 -> 1051;
	1056 [label="Це призводить до певної нудьги, яка починає створювати власну небезпеку, узурпаторе. Раптом ми вигадуємо нові майстерні способи наражати себе на небезпеку, оскільки усунули старі.",shape=box,color=blue];
		1056 -> 1057;
		1056 -> 1058;
	1057 [label="Що це означає?",shape=box,color=red];
		1057 -> 1059;
	1058 [label="Що гірше? Коли в тебе стріляють чи коли ти мусиш оглядатися?",shape=box,color=red];
		1058 -> 1060;
	1059 [label="У моєму… вимушеному перебуванні в «Ґоллі» було дуже мало цікавих або приємних моментів. Одним із них була їжа. Однак, іншим… були грози.",shape=box,color=blue];
		1059 -> 1061;
	1060 [label="Ха! Я не впевнений, що маю уподобання, оскільки, на жаль, добре обізнаний в обох мистецтвах. А тобі?",shape=box,color=blue];
		1060 -> 1062;
		1060 -> 1063;
	1061 [label="Грози, яких я ніколи не бачив за всі роки свого орокінського існування. Вони трясли саму землю, гуркотіли дерев’яними шибками у вікнах. Я чув їх навіть у запиленій крипті, де нас тримали.",shape=box,color=blue];
		1061 -> 1064;
	1062 [label="Мені подобається знати, хто мої вороги, просто та зрозуміло. Нехай кидаються на мене зі зброєю.",shape=box,color=red];
		1062 -> 1065;
	1063 [label="Коли стріляють. Я вважаю за краще мати можливість впливати на ситуацію, щоб виконати роботу. Я можу не поспішати.",shape=box,color=red];
		1063 -> 1066;
	1064 [label="Коли вони проходили містом, я підіймався на дзвіницю, щоб бути якомога ближче до них. Я хотів відчути електрику в повітрі та удари дощу по своїй шкірі.",shape=box,color=blue];
		1064 -> 1067;
		1064 -> 1068;
		1064 -> 1069;
	1065 [label="Add 1 to Thermostat",color=orange];
		1065 -> 1070;
	1066 [label="Add -1 to Thermostat",color=orange];
		1066 -> 1071;
	1067 [label="Хіба це не було трохи небезпечно?",shape=box,color=red];
		1067 -> 1072;
	1068 [label="Звучить дивовижно.",shape=box,color=red];
		1068 -> 1073;
	1069 [label="Як Марі та Ліон поставилися до твоєї втечі?",shape=box,color=red];
		1069 -> 1074;
	1070 [label="Я розумію твою точку зору й мушу погодитися, що в цьому є певна простота, якою можна насолоджуватися. Важко сплутати ворога з чимось іншим, коли він тримає пістолет, приставлений до твоєї скроні.",shape=box,color=blue];
		1070 -> 1075;
	1071 [label="М-м, смакота, чи не так? Ретельно продуманий план, майстерно реалізований, який приносить плоди? Спостерігати, як усі деталі складаються в єдине ціле… це дуже весело.",shape=box,color=blue];
		1071 -> 1075;
	1072 [label="Саме це й було метою цих старань! Я не можу описати, як це — відчути таку чисту енергію. Ні, це було більше, ніж просто енергія — це була справжня міць. Я дивився вгору на ці вируючі, темні хмари, що спалахували лютими блискавками, і побачив те, що мої предки так відчайдушно намагалися приборкати.",shape=box,color=blue];
		1072 -> 1076;
	1073 [label="+5 Chemistry",color=orange];
		1073 -> 1077;
	1074 [label="Ти так питаєш, ніби я навіть на мить не замислювався над цим. Вони не пішли за мною, якщо ти про це питаєш. Священник, я впевнений, не дуже переймався тим, чи вб’є мене блискавка. А що стосується Марі? Вона, мабуть, була занадто зайнята поклонінням своїм фальшивим ідолам. Солу чи Альбрехту, на твій вибір.",shape=box,color=blue];
		1074 -> 1078;
	1075 [label="+5 Chemistry",color=orange];
		1075 -> 1079;
	1076 [label="Ба більше, я знав, що моя присутність там може бути смертельною, і що поблизу не буде куви, яка б могла мене оживити. До того ж священна кува більше не діяла на моє спотворене тіло. ",shape=box,color=blue];
		1076 -> 1080;
	1077 [label="Саме так! Я не можу описати, як це — відчути таку чисту енергію. Ні, це було більше, ніж просто енергія — це була справжня міць. Я дивився вгору на ці вируючі, темні хмари, що спалахували лютими блискавками, і побачив те, що мої предки так відчайдушно намагалися приборкати.",shape=box,color=blue];
		1077 -> 1076;
	1078 [label="Але відчути таку чисту енергію? Ні, це було більше, ніж просто енергія — це була справжня міць. Я дивився вгору на ці вируючі, темні хмари, що спалахували лютими блискавками, і побачив те, що мої предки так відчайдушно намагалися приборкати.",shape=box,color=blue];
		1078 -> 1076;
	1079 [label="Однак я вважаю, що, як і в усьому в житті, запорукою успіху є стриманість і поєднання обох підходів. Надто захопившись одним, ризикуєш відмовитися від іншого.",shape=box,color=blue];
		1079 -> 1081;
	1080 [label="Це мене жахало. Я відчував страх, мандрівниче. Страх. Можливо, вперше за… століття!",shape=box,color=blue];
		1080 -> 1082;
		1080 -> 1083;
	1081 [label="Боюся, що так ми й створюємо таких істот, як Баллас і Нітог. Маніпулятор і Королева крові. Ха.",shape=box,color=blue];
		1081 -> 1084;
	1082 [label="Ти боявся померти?",shape=box,color=red];
		1082 -> 1085;
	1083 [label="І що ти зробив?",shape=box,color=red];
		1083 -> 1086;
	1084 [label="Але я прийшов сюди, щоби поговорити про грози.",shape=box,color=blue];
		1084 -> 1059;
	1085 [label="Так, схоже на те! Досить гостро, маю додати. І це було для мене відкриттям у той момент. Я не боюся того, що буде після смерті, мандрівниче. Просто я ще не хочу, щоб моє життя закінчилося. Я ще не прожив його до кінця.",shape=box,color=blue];
		1085 -> 1087;
	1086 [label="Я виліз на кам’яну балясину поруч із вузлуватим ґарґуйлем, розкинув руки в сторони і… засміявся. Засміявся в грозу.",shape=box,color=blue];
		1086 -> 1088;
	1087 [label="Що стало справжнім одкровенням. Я виліз на кам’яну балясину поруч із вузлуватим ґарґуйлем, розкинув руки в сторони і… засміявся. Засміявся в грозу.",shape=box,color=blue];
		1087 -> 1089;
	1088 [label="Бо я раптом зрозумів, що не боюся того, що буде після смерті, мандрівниче. Просто я ще не хочу, щоб моє життя закінчилося. Я ще не прожив його до кінця.",shape=box,color=blue];
		1088 -> 1089;
	1089 [label="Попри все. Попри спустошення на Тау. Попри мої знання, що знищення орокінської імперії було неминуче. Попри те, що моє тіло перетворилося на цю… потвору. Попри те, що мене кинули в минуле й залишили напризволяще.",shape=box,color=blue];
		1089 -> 1090;
	1090 [label="Я знав, що знайду шлях назад. У цей час. До цього місця, де Альбрехт залишив усі свої найдорожчі речі.",shape=box,color=blue];
		1090 -> 1091;
	1091 [label="+5 Chemistry",color=orange];
		1091 -> 1092;
	1092 [label="Тому що я не прожив своє життя до кінця. Але, клянусь Порожнечею, я подбаю про те, щоб його життя закінчилося.",shape=box,color=blue];
		1092 -> 1093;
	1093 [label="Update boolean RoatheEntrati1",color=orange];
		1093 -> 1094;
	1094 [label="Chat ends.",color=orange];
}