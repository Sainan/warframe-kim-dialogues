		j4208251187 -> j3438455715 [label=true,color=green];
		j4208251187 -> "Chat ends." [label=false,color=brown];
	j3438455715 [label="Check boolean RoatheKnowsReset2",color=orange];
		j3438455715 -> j4191740099 [label=true,color=green];
		j3438455715 -> j1150980745 [label=false,color=brown];
	"Chat ends." [color=orange];
	j4191740099 [label="Я знаю, що, напевне, це вже тобі відомо, але сьогодні мені байдуже, у мене немає терпіння.",shape=box,color=blue];
		j4191740099 -> j1150980745;
	j1150980745 [label="Я думаю, що причиною падіння орокінської імперії була занадто велика кількість шарів скла.",shape=box,color=blue];
		j1150980745 -> j758113073;
		j1150980745 -> j2371434150;
		j1150980745 -> j1478915251;
	j758113073 [label="Тобто?",shape=box,color=red];
		j758113073 -> j2816767724;
	j2371434150 [label="Занадто безособово?",shape=box,color=red];
		j2371434150 -> j3245100967;
	j1478915251 [label="[Завершити розмову]",shape=box,color=red];
		j1478915251 -> "Chat ends.";
	j2816767724 [label="Уяви собі суспільство, побудоване на усвідомленні, що ти, по суті, завжди в безпеці. Під захистом. Навіть від примарної наявності смерті.",shape=box,color=blue];
		j2816767724 -> j1389732021;
	j3245100967 [label="+5 Chemistry",color=orange];
		j3245100967 -> j404171358;
	j1389732021 [label="Де ніщо не може тобі зашкодити.",shape=box,color=blue];
		j1389732021 -> j1163598886;
	j404171358 [label="Саме так. Занадто віддалено від небезпеки та реальності ситуації.",shape=box,color=blue];
		j404171358 -> j2816767724;
	j1163598886 [label="Це призводить до певної нудьги, яка починає створювати власну небезпеку, узурпаторе. Раптом ми вигадуємо нові майстерні способи наражати себе на небезпеку, оскільки усунули старі.",shape=box,color=blue];
		j1163598886 -> j1895884374;
		j1163598886 -> j611202294;
	j1895884374 [label="Що це означає?",shape=box,color=red];
		j1895884374 -> j1345630440;
	j611202294 [label="Що гірше? Коли в тебе стріляють чи коли ти мусиш оглядатися?",shape=box,color=red];
		j611202294 -> j402016772;
	j1345630440 [label="У моєму… вимушеному перебуванні в «Ґоллі» було дуже мало цікавих або приємних моментів. Одним із них була їжа. Однак, іншим… були грози.",shape=box,color=blue];
		j1345630440 -> j3804689374;
	j402016772 [label="Ха! Я не впевнений, що маю уподобання, оскільки, на жаль, добре обізнаний в обох мистецтвах. А тобі?",shape=box,color=blue];
		j402016772 -> j1075961438;
		j402016772 -> j221444025;
	j3804689374 [label="Грози, яких я ніколи не бачив за всі роки свого орокінського існування. Вони трясли саму землю, гуркотіли дерев’яними шибками у вікнах. Я чув їх навіть у запиленій крипті, де нас тримали.",shape=box,color=blue];
		j3804689374 -> j654838758;
	j1075961438 [label="Мені подобається знати, хто мої вороги, просто та зрозуміло. Нехай кидаються на мене зі зброєю.",shape=box,color=red];
		j1075961438 -> j10826073;
	j221444025 [label="Коли стріляють. Я вважаю за краще мати можливість впливати на ситуацію, щоб виконати роботу. Я можу не поспішати.",shape=box,color=red];
		j221444025 -> j2708891521;
	j654838758 [label="Коли вони проходили містом, я підіймався на дзвіницю, щоб бути якомога ближче до них. Я хотів відчути електрику в повітрі та удари дощу по своїй шкірі.",shape=box,color=blue];
		j654838758 -> j3675640894;
		j654838758 -> j3888033366;
		j654838758 -> j2507850888;
	j10826073 [label="Add 1 to Thermostat counter",color=orange];
		j10826073 -> j1937996306;
	j2708891521 [label="Add -1 to Thermostat counter",color=orange];
		j2708891521 -> j3588183830;
	j3675640894 [label="Хіба це не було трохи небезпечно?",shape=box,color=red];
		j3675640894 -> j509679975;
	j3888033366 [label="Звучить дивовижно.",shape=box,color=red];
		j3888033366 -> j291269011;
	j2507850888 [label="Як Марі та Ліон поставилися до твоєї втечі?",shape=box,color=red];
		j2507850888 -> j504011197;
	j1937996306 [label="Я розумію твою точку зору й мушу погодитися, що в цьому є певна простота, якою можна насолоджуватися. Важко сплутати ворога з чимось іншим, коли він тримає пістолет, приставлений до твоєї скроні.",shape=box,color=blue];
		j1937996306 -> j850106306;
	j3588183830 [label="М-м, смакота, чи не так? Ретельно продуманий план, майстерно реалізований, який приносить плоди? Спостерігати, як усі деталі складаються в єдине ціле… це дуже весело.",shape=box,color=blue];
		j3588183830 -> j850106306;
	j509679975 [label="Саме це й було метою цих старань! Я не можу описати, як це — відчути таку чисту енергію. Ні, це було більше, ніж просто енергія — це була справжня міць. Я дивився вгору на ці вируючі, темні хмари, що спалахували лютими блискавками, і побачив те, що мої предки так відчайдушно намагалися приборкати.",shape=box,color=blue];
		j509679975 -> j1976681098;
	j291269011 [label="+5 Chemistry",color=orange];
		j291269011 -> j3240807835;
	j504011197 [label="Ти так питаєш, ніби я навіть на мить не замислювався над цим. Вони не пішли за мною, якщо ти про це питаєш. Священник, я впевнений, не дуже переймався тим, чи вб’є мене блискавка. А що стосується Марі? Вона, мабуть, була занадто зайнята поклонінням своїм фальшивим ідолам. Солу чи Альбрехту, на твій вибір.",shape=box,color=blue];
		j504011197 -> j2282831875;
	j850106306 [label="+5 Chemistry",color=orange];
		j850106306 -> j2783123909;
	j1976681098 [label="Ба більше, я знав, що моя присутність там може бути смертельною, і що поблизу не буде куви, яка б могла мене оживити. До того ж священна кува більше не діяла на моє спотворене тіло. ",shape=box,color=blue];
		j1976681098 -> j403016264;
	j3240807835 [label="Саме так! Я не можу описати, як це — відчути таку чисту енергію. Ні, це було більше, ніж просто енергія — це була справжня міць. Я дивився вгору на ці вируючі, темні хмари, що спалахували лютими блискавками, і побачив те, що мої предки так відчайдушно намагалися приборкати.",shape=box,color=blue];
		j3240807835 -> j1976681098;
	j2282831875 [label="Але відчути таку чисту енергію? Ні, це було більше, ніж просто енергія — це була справжня міць. Я дивився вгору на ці вируючі, темні хмари, що спалахували лютими блискавками, і побачив те, що мої предки так відчайдушно намагалися приборкати.",shape=box,color=blue];
		j2282831875 -> j1976681098;
	j2783123909 [label="Однак я вважаю, що, як і в усьому в житті, запорукою успіху є стриманість і поєднання обох підходів. Надто захопившись одним, ризикуєш відмовитися від іншого.",shape=box,color=blue];
		j2783123909 -> j2922157525;
	j403016264 [label="Це мене жахало. Я відчував страх, мандрівниче. Страх. Можливо, вперше за… століття!",shape=box,color=blue];
		j403016264 -> j846522279;
		j403016264 -> j3449443975;
	j2922157525 [label="Боюся, що так ми й створюємо таких істот, як Баллас і Нітог. Маніпулятор і Королева крові. Ха.",shape=box,color=blue];
		j2922157525 -> j1146288628;
	j846522279 [label="Ти боявся померти?",shape=box,color=red];
		j846522279 -> j1026683999;
	j3449443975 [label="І що ти зробив?",shape=box,color=red];
		j3449443975 -> j3188580144;
	j1146288628 [label="Але я прийшов сюди, щоби поговорити про грози.",shape=box,color=blue];
		j1146288628 -> j1345630440;
	j1026683999 [label="Так, схоже на те! Досить гостро, маю додати. І це було для мене відкриттям у той момент. Я не боюся того, що буде після смерті, мандрівниче. Просто я ще не хочу, щоб моє життя закінчилося. Я ще не прожив його до кінця.",shape=box,color=blue];
		j1026683999 -> j567172547;
	j3188580144 [label="Я виліз на кам’яну балясину поруч із вузлуватим ґарґуйлем, розкинув руки в сторони і… засміявся. Засміявся в грозу.",shape=box,color=blue];
		j3188580144 -> j384171557;
	j567172547 [label="Що стало справжнім одкровенням. Я виліз на кам’яну балясину поруч із вузлуватим ґарґуйлем, розкинув руки в сторони і… засміявся. Засміявся в грозу.",shape=box,color=blue];
		j567172547 -> j2792475476;
	j384171557 [label="Бо я раптом зрозумів, що не боюся того, що буде після смерті, мандрівниче. Просто я ще не хочу, щоб моє життя закінчилося. Я ще не прожив його до кінця.",shape=box,color=blue];
		j384171557 -> j2792475476;
	j2792475476 [label="Попри все. Попри спустошення на Тау. Попри мої знання, що знищення орокінської імперії було неминуче. Попри те, що моє тіло перетворилося на цю… потвору. Попри те, що мене кинули в минуле й залишили напризволяще.",shape=box,color=blue];
		j2792475476 -> j3650592051;
	j3650592051 [label="Я знав, що знайду шлях назад. У цей час. До цього місця, де Альбрехт залишив усі свої найдорожчі речі.",shape=box,color=blue];
		j3650592051 -> j1133072532;
	j1133072532 [label="+5 Chemistry",color=orange];
		j1133072532 -> j71558970;
	j71558970 [label="Тому що я не прожив своє життя до кінця. Але, клянусь Порожнечею, я подбаю про те, щоб його життя закінчилося.",shape=box,color=blue];
		j71558970 -> j3359792563;
	j3359792563 [label="Boolean RoatheEntrati1 is now true.",color=orange];
		j3359792563 -> "Chat ends.";
}