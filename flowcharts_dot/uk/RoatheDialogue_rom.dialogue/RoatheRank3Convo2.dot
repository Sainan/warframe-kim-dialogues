	1574 [label="Add 1 to Thermostat",color=orange];
		1574 -> 1579;
	1575 [label="Я цілком і повністю зневажав її, і нічого б так мене не потішило, ніж повільне, обережне й ніжне здирання її синьої шкіри.",shape=box,color=blue];
		1575 -> 1580;
		1575 -> 1581;
	1576 [label="Яке зухвале запитання! Гадаю, я обожнюю тебе за те, що ти його можеш ставити. Знаєш, мені здається, що я кохав її, принаймні трохи. Чесно кажучи, я навіть не замислювався над цим.",shape=box,color=blue];
