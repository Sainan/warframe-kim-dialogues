		1590 -> 1605 [label="false",color=purple];
	1591 [label="Гм, так. Мені здається, що я не зовсім завойовую тебе своїм «диявольським шармом», чи не так?",shape=box,color=blue];
		1591 -> 1606;
		1591 -> 1607;
	1592 [label="Який сенс переживати знову наші минулі вчинки, наші невдачі та жалі? Ми не можемо їх змінити — навіть маючи дар подорожей у часі, спроба «переробити» те, що вже «зроблено», веде лише до божевілля.",shape=box,color=blue];
		1592 -> 1608;
	1593 [label="Але ми також не можемо забувати про провини наших колишніх «я», бо ризикуємо стати лише божевільними та деспотичними войовничими істотами, які не бачать провини в собі, а лише в інших.",shape=box,color=blue];
		1593 -> 1609;
	1594 [label="Ти так думаєш про всіх своїх коханок? Чи тільки про неї?",shape=box,color=red];
		1594 -> 1610;
	1595 [label="Не потрібно вибачатися. Я просто досі в шоці як сильно ти ненавидів свій народ.",shape=box,color=red];
		1595 -> 1611;
	1596 [label="Я просто рекомендую тобі не робити такі стосунки постійними. Це стає вкрай шкідливим для обох сторін. Зазвичай це закінчується вбивством одного або обох з вас.",shape=box,color=blue];
		1596 -> 1594;
