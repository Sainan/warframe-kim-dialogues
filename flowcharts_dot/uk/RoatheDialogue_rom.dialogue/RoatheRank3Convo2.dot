	1566 [label="Ти любив її?",shape=box,color=red];
		1566 -> 1571;
	1567 [label="Ти її довіряв?",shape=box,color=red];
		1567 -> 1572;
	1568 [label="Не шкодуй про те, що зробив. Ти зробив свій вибір. Шляху назад немає. Тільки вперед.",shape=box,color=red];
		1568 -> 1573;
	1569 [label="Єдине, що можна зробити — це дивитися вперед широко розплющеними очима.",shape=box,color=red];
		1569 -> 1574;
	1564 [label="Адже вона була Великою Нітог. Виконавицею.",shape=box,color=blue];
		1564 -> 1561;
	1570 [label="О, Порожнече, ні! Якби вона якось п’яна вийшла у відкритий шлюз, це розв’язало б багато моїх проблем.",shape=box,color=blue];
		1570 -> 1575;
	1571 [label="+5 Chemistry",color=orange];
		1571 -> 1576;
	1572 [label="О, Порожнече, ні! Ніколи не довіряй орокінам, мандрівниче. І мені також. Особливо мені! Люби нас, ненавидь нас, обожнюй нас, зневажай нас — але ніколи, ні за яких обставин не довіряй нам.",shape=box,color=blue];
		1572 -> 1577;
