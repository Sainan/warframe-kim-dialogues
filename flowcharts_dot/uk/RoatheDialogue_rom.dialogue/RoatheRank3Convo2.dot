		1703 -> 1721;
	1709 [label="Я просто кажу, що якщо ти відчуваєш почуття до більш ніж однієї людини одночасно, я не буду тебе за це засуджувати, ось і все.",shape=box,color=blue];
		1709 -> 1727;
	1710 [label="Він досить привабливий, я вважаю. Але має такий вигляд, ніби якщо квітка зів’яла, він може оголосити це кінцем світу та кинутися з найближчої вежі.",shape=box,color=blue];
		1710 -> 1728;
	1711 [label="Ну що ж, бажаю тобі удачі. Я не міг терпіти її самовдоволену та нескінченну побожність. Крім того, вона вважає мене лише нечестивцем.",shape=box,color=blue];
		1711 -> 1729;
