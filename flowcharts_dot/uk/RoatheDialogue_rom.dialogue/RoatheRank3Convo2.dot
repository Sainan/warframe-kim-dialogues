		1545 -> 1554 [label=true,color=green];
		1545 -> 1553 [label=false,color=brown];
	1548 [label="Колись я вірив, що ми партнери. У політиці, в інтригах, в ліжку…",shape=box,color=blue];
		1548 -> 1557;
	1546 [label="Ділові партнери?",shape=box,color=red];
		1546 -> 1555;
	1547 [label="Партнерів в чому?",shape=box,color=red];
		1547 -> 1556;
	1549 [label="Навряд чи. Але одну річ потрібно розуміти про орокінів — ми завжди плели інтриги один проти одного. ",shape=box,color=blue];
		1549 -> 1550;
	1550 [label="Я знав, що Нітог без вагань уб’є мене в будь-який момент, якщо це хоч якось допоможе їй досягти своїх цілей.",shape=box,color=blue];
		1550 -> 1558;
	1551 [label="Я думаю, їй подобався цей виклик, узурпаторе. Відчуття небезпеки. Захоплення від усвідомлення, що вона спала з тим, хто хотів її смерті.",shape=box,color=blue];
		1551 -> 1559;
	1552 [label="Я хотів би вдати, що ми були першими орокінами, які опинилися в такій ситуації, але це було навіть не так вже й рідко.",shape=box,color=blue];
		1552 -> 1559;
	1554 [label="Саме так! Здається ніби, в нас вже була ця розмова. Але це не було несподіваним поворотом. Вона сама регулярно дратувала мене цим.",shape=box,color=blue];
		1554 -> 1543;
		1554 -> 1544;
	1553 [label="Саме так! Але це не було несподіваним поворотом. Вона теж це передбачала та регулярно дратувала мене цим.",shape=box,color=blue];
		1553 -> 1543;
		1553 -> 1544;
	1557 [label="Звичайно, я не вірив, що ми рівні. Вона була Виконавицею. Великою Нітог. Але я вважав себе першим серед її підлеглих.",shape=box,color=blue];
		1557 -> 1561;
	1555 [label="Ти просто чудо. Так, можна сказати, що ми були діловими партнерами. Але ми також були партнерами в багатьох інших, важливіших аспектах.",shape=box,color=blue];
		1555 -> 1556;
	1556 [label="На війні. У політиці. В інтригах. У ліжку.",shape=box,color=blue];
		1556 -> 1560;
	1558 [label="Проте вона знала, що я гострив сокиру за її спиною та з нетерпінням чекав моменту, коли зможу відрубати їй голову.",shape=box,color=blue];
		1558 -> 1562;
	1559 [label="Що довше я живу, то більше усвідомлюю, що, можливо, ми не є видом, призначеним для безсмертя.",shape=box,color=blue];
		1559 -> 1563;
	1561 [label="Яким дурнем я був…",shape=box,color=blue];
		1561 -> 1565;
		1561 -> 1566;
		1561 -> 1567;
		1561 -> 1568;
		1561 -> 1569;
	1560 [label="Але я думаю, чи не помиляюся. Цікаво, чи слово «партнер» не занадто сильне для того, ким ми насправді були. ",shape=box,color=blue];
		1560 -> 1564;
	1562 [label="Можна сказати, що у нас були… складні стосунки.",shape=box,color=blue];
		1562 -> 1569;
		1562 -> 1568;
		1562 -> 1567;
		1562 -> 1565;
		1562 -> 1566;
	1563 [label="Але так. Можна сказати, що у нас з Нітог були… складні стосунки.",shape=box,color=blue];
