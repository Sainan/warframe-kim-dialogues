	j1147499284 [label="То це просто марна мрія? Ох, що значить бути живим. Насолоджуйся цим, поки можеш, кажу я.",shape=box,color=blue];
		j1147499284 -> j4036443868;
	j4036443868 [label="Слідуй за покликом серця, мандрівниче. Якщо є щось, про що я шкодую за всі ці роки, то це те, що я ніколи не поділився цим з кимось іншим.",shape=box,color=blue];
