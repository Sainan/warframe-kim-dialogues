	"RoatheRank3Convo2 begins." [color=orange];
		"RoatheRank3Convo2 begins." -> j1010591962;
		"RoatheRank3Convo2 begins." -> j1478915251;
	j1010591962 [label="Як саме ти планував скинути Виконавців?",shape=box,color=red];
		j1010591962 -> j3720655375;
	j1478915251 [label="[Завершити розмову]",shape=box,color=red];
		j1478915251 -> "Chat ends.";
	j3720655375 [label="Check boolean RoatheKnowsReset2",color=orange];
		j3720655375 -> j3488675081 [label=true,color=green];
		j3720655375 -> j1246696249 [label=false,color=brown];
	"Chat ends." [color=orange];
	j3488675081 [label="Чому ти мене про це питаєш? Що ти намагаєшся дізнатися, мандрівниче? Ти точно не питаєш про розташування боєприпасів.",shape=box,color=blue];
		j3488675081 -> j262392721;
	j1246696249 [label="Чому? Плануєш повернутися в минуле та побити рекорд свого попереднього «я»? Потрібна порада, як повалити тоталітарний уряд? Шукаєш розташування захованих боєприпасів, які можуть підірвати цілі планети?",shape=box,color=blue];
		j1246696249 -> j1799329779;
	j262392721 [label="Чому я мав би тобі довіряти? Чому я тобі довіряв?!",shape=box,color=blue];
		j262392721 -> j2310817378;
	j1799329779 [label="Або ти просто ведеш порожні розмови?",shape=box,color=blue];
		j1799329779 -> j618231674;
		j1799329779 -> j3888364721;
		j1799329779 -> j1138776941;
	j2310817378 [label="Check boolean RoatheResetForgiven",color=orange];
		j2310817378 -> j3207119521 [label=true,color=green];
		j2310817378 -> j1221908139 [label=false,color=brown];
	j618231674 [label="Чесно кажучи, мені цікаво, чи ти про щось шкодуєш. Чи повернувся б ти назад і змінив щось із того, що планував.",shape=box,color=red];
		j618231674 -> j3917603025;
	j3888364721 [label="Мене зачаровує думка про те, як би це було — спробувати придумати такий план. Це, мабуть, було б шедевром.",shape=box,color=red];
		j3888364721 -> j3674329176;
	j1138776941 [label="Чесно кажучи, було б добре знати, чи ти десь сховав якусь із тієї зброї, до якої ще можна дістатися.",shape=box,color=red];
		j1138776941 -> j3149455256;
	j3207119521 [label="Я пробачив тобі твій вчинок. Я просто хотів би згадати, чому — чому? Чому саме ти, з усіх людей?!",shape=box,color=blue];
		j3207119521 -> j1716360141;
		j3207119521 -> j3935537929;
	j1221908139 [label="Чому? Чому саме ти, з усіх людей?!",shape=box,color=blue];
		j1221908139 -> j3935537929;
		j1221908139 -> j688542056;
	j3917603025 [label="Add 1 to Thermostat counter",color=orange];
		j3917603025 -> j1839108268;
	j3674329176 [label="Add -1 to Thermostat counter",color=orange];
		j3674329176 -> j102009308;
	j3149455256 [label="+5 Chemistry",color=orange];
		j3149455256 -> j2378209616;
	j1716360141 [label="Я знаю. І мені все ще дуже шкода.",shape=box,color=red];
		j1716360141 -> j1316406287;
	j3935537929 [label="Я намагаюся привести тебе до розуміння, чому.",shape=box,color=red];
		j3935537929 -> j2270734031;
	j688542056 [label="Мені все ще шкода зрадженої довіри, Роуте. Вір або ні, але це не входило до моїх планів.",shape=box,color=red];
		j688542056 -> j2504150365;
	j1839108268 [label="Єдине, про що я шкодую, що цього так і не сталося. Я шкодую про змарнований час.",shape=box,color=blue];
		j1839108268 -> j1494122107;
	j102009308 [label="І це було шедевром, узурпаторе.",shape=box,color=blue];
		j102009308 -> j1494122107;
	j2378209616 [label="Практично. Але багато з тих місць, де я «ховав» свої запаси, ймовірно, за багато-багато років загубилися.",shape=box,color=blue];
		j2378209616 -> j4009628697;
	j1316406287 [label="Так, так. Мабуть, нам слід продовжити цю безглузду розмову, в якій ми знову повертаємося до попередніх розмов.",shape=box,color=blue];
		j1316406287 -> j604093260;
	j2270734031 [label="+5 Chemistry",color=orange];
		j2270734031 -> j1859625687;
	j2504150365 [label="Так, у тебе, ймовірно, була впевненість, що твої дії не матимуть наслідків. Але попри це ми повинні продовжувати цю безглузду розмову, в якій ми переосмислюємо своє минуле і просто продовжуємо жити далі.",shape=box,color=blue];
		j2504150365 -> j604093260;
	j1494122107 [label="+5 Chemistry",color=orange];
		j1494122107 -> j850672173;
	j4009628697 [label="І багато з цих місць були таємницею навіть для мене. План був надзвичайно складним. Багатошаровим, глибоким.",shape=box,color=blue];
		j4009628697 -> j1928915788;
	j604093260 [label="Яке було твоє запитання? А, так. «Як саме я планував скинути Виконавців?» ",shape=box,color=blue];
		j604093260 -> j3490316966;
	j1859625687 [label="Повторюючи ті самі безглузді розмови про те, чому я хотів вбити людей, які вже давно померли та перетворилися на попіл? Принаймні, це прагматичний підхід.",shape=box,color=blue];
		j1859625687 -> j604093260;
	j850672173 [label="План був надзвичайно складним. Багатошаровим, глибоким. Убивці, які вбивали б убивць інших убивць, якщо перші вбивці зазнали невдачі.",shape=box,color=blue];
		j850672173 -> j2049343731;
	j1928915788 [label="Убивці, які вбивали б убивць інших убивць, якщо перші вбивці зазнали невдачі.",shape=box,color=blue];
		j1928915788 -> j2049343731;
	j3490316966 [label="Чому?",shape=box,color=blue];
		j3490316966 -> j618231674;
		j3490316966 -> j3888364721;
		j3490316966 -> j1138776941;
	j2049343731 [label="Бомби, закладені в численних будівлях, зорельотах і цілому місяці, були оснащені вкраденою вибухівкою. Сонячна рейка, готова зійти з орбіти.",shape=box,color=blue];
		j2049343731 -> j2299668695;
	j2299668695 [label="І все це було підлаштовано так, щоб, коли настав час, виглядало як «Велика катастрофа Свідомих». Ми з Нітог оголосили б в імперії надзвичайний стан, як тільки з Виконавцями та імператорами було б… покінчено.",shape=box,color=blue];
		j2299668695 -> j1742364006;
	j1742364006 [label="Boolean RoatheTraitor2 is now true.",color=orange];
		j1742364006 -> j285070892;
	j285070892 [label="Check boolean RoatheExecutor1",color=orange];
		j285070892 -> j2860011863 [label=true,color=green];
		j285070892 -> j975343016 [label=true,color=green];
		j285070892 -> j2694529232 [label=true,color=green];
		j285070892 -> j2860011863 [label=false,color=brown];
		j285070892 -> j975343016 [label=false,color=brown];
	j2860011863 [label="А якби твій план не спрацював?",shape=box,color=red];
		j2860011863 -> j1555833792;
	j975343016 [label="І що ти збирався робити тоді?",shape=box,color=red];
		j975343016 -> j3807481320;
	j2694529232 [label="Що ти планував зробити з Нітог?",shape=box,color=red];
		j2694529232 -> j1932713100;
	j1555833792 [label="Це був один із багатьох тисяч можливих результатів, для яких я мав план. ",shape=box,color=blue];
		j1555833792 -> j4133143495;
	j3807481320 [label="Існувала тисяча можливих результатів того, що ми запланували. Для кожної змінної, що брала участь у грі, було створено можливий варіант шляху. ",shape=box,color=blue];
		j3807481320 -> j3806877598;
	j1932713100 [label="Check boolean RoatheKnowsReset2",color=orange];
		j1932713100 -> j2622246023 [label=true,color=green];
		j1932713100 -> j3125113895 [label=false,color=brown];
	j4133143495 [label="Якби ми зазнали разючої невдачі, я б просто вставив до рота Лекса й на тому б закінчив.",shape=box,color=blue];
		j4133143495 -> j3406560728;
	j3806877598 [label="І для кожного з них я визначив результат. І для кожного я знав, що мав робити. Багато з них були схожими в загальних рисах, але відрізнялися в деталях.",shape=box,color=blue];
		j3806877598 -> j1594638596;
	j2622246023 [label="Що я розповів тобі про це раніше? Бо я вважаю, що ще не довіряю тобі настільки, щоб сказати тобі все відверто.",shape=box,color=blue];
		j2622246023 -> j2615407911;
		j2622246023 -> j4259414709;
	j3125113895 [label="Це було складне питання, яке вимагало… тривалих переговорів між нами.",shape=box,color=blue];
		j3125113895 -> j1521784002;
		j3125113895 -> j114953371;
	j3406560728 [label="Немає сенсу плакати над розлитою кувою та всім іншим.",shape=box,color=blue];
		j3406560728 -> j4070355598;
		j3406560728 -> j3540264835;
	j1594638596 [label="Якби ми зазнали разючої невдачі, я б просто вставив до рота Лекса й на тому б закінчив.",shape=box,color=blue];
		j1594638596 -> j380583171;
	j2615407911 [label="Ти розповів мені все.",shape=box,color=red];
		j2615407911 -> j496510305;
	j4259414709 [label="Тоді я не буду змушувати тебе розповідати мені більше, ніж ти хочеш.",shape=box,color=red];
		j4259414709 -> j33235702;
	j1521784002 [label="У цьому реченні закладено багато сенсу.",shape=box,color=red];
		j1521784002 -> j3851595040;
	j114953371 [label="Яких переговорів?",shape=box,color=red];
		j114953371 -> j2316165453;
	j4070355598 [label="Як на мене, то краще втекти.",shape=box,color=red];
		j4070355598 -> j1593450416;
	j3540264835 [label="Ти просто б змирився зі смертю?",shape=box,color=red];
		j3540264835 -> j3295127551;
	j380583171 [label="Якби це був посередній успіх, що було найбільш імовірним, то потрібно було б провести очищення, щоб переконатися, що всі незавершені справи були «вирішені». Звичайно, я був одним з тих, хто перерізав мотузки. І я вжив заходів, щоб переконатися, що я все ще залишаюся цінним в короткостроковій перспективі, щоб мене не відрізали разом із рештою.",shape=box,color=blue];
		j380583171 -> j497991667;
	j496510305 [label="Тоді немає сенсу повторюватись зараз, чи не так? Насправді ця розмова взагалі не має сенсу. Гарного дня.",shape=box,color=blue];
		j496510305 -> "Chat ends.";
	j33235702 [label="+5 Chemistry",color=orange];
		j33235702 -> j1674852943;
	j3851595040 [label="+5 Chemistry",color=orange];
		j3851595040 -> j341920635;
	j2316165453 [label="Будь-яких, які тільки можна уявити.",shape=box,color=blue];
		j2316165453 -> j1861383400;
	j1593450416 [label="І куди втекти, мій узурпаторе? Не всі з нас мають кишенькові виміри, куди можна втекти, коли в паніці.",shape=box,color=blue];
		j1593450416 -> j1732833168;
	j3295127551 [label="У мене не було іншого вибору, чи не так? Нікуди подітися, ніде сховатися.",shape=box,color=blue];
		j3295127551 -> j1732833168;
	j497991667 [label="Якби ситуація була надзвичайно успішною, я перейшов би до другої фази плану.",shape=box,color=blue];
		j497991667 -> j3946227477;
		j497991667 -> j1543172917;
	j1674852943 [label="Добре. Я скажу, що це було складне питання, яке вимагало… тривалих переговорів між нами.",shape=box,color=blue];
		j1674852943 -> j1521784002;
		j1674852943 -> j114953371;
	j341920635 [label="Століття під пісками.",shape=box,color=blue];
		j341920635 -> j1861383400;
	j1861383400 [label="Boolean RoatheExecutor2 is now true.",color=orange];
		j1861383400 -> j1717274806;
	j1732833168 [label="Нітог чітко дала зрозуміти, що в разі невдачі я стану публічною жертвою.",shape=box,color=blue];
		j1732833168 -> j2780452722;
		j1732833168 -> j2882155815;
	j3946227477 [label="Яка була друга фаза?",shape=box,color=red];
		j3946227477 -> j3096107430;
	j1543172917 [label="Убити Нітог?",shape=box,color=red];
		j1543172917 -> j596495675;
	j1717274806 [label="Evaluate expressions on HellStory counter",color=orange];
		j1717274806 -> j781662588 [label="x >= 7",color=purple];
		j1717274806 -> j224470747 [label="x < 7",color=purple];
		j1717274806 -> j224470747 [label="false",color=purple];
	j2780452722 [label="І ти погодився?",shape=box,color=red];
		j2780452722 -> j2777101778;
	j2882155815 [label="Не дуже хороша ідея погрожувати тобі, якщо вона хотіла твоєї відданості.",shape=box,color=red];
		j2882155815 -> j2234568583;
	j3096107430 [label="Убивство Нітог, звичайно. Це не було несподіваним поворотом. Вона сама знала, що це може статися, і регулярно дратувала мене цим.",shape=box,color=blue];
		j3096107430 -> j1185759684;
		j3096107430 -> j1911256744;
	j596495675 [label="+5 Chemistry",color=orange];
		j596495675 -> j1275536292;
	j781662588 [label="Як ти знаєш, я був одним з її багатьох іграшок.",shape=box,color=blue];
		j781662588 -> j2588886114;
	j224470747 [label="Ну, я був одним з її численних партнерів.",shape=box,color=blue];
		j224470747 -> j735669364;
		j224470747 -> j796999149;
	j2777101778 [label="+5 Chemistry",color=orange];
		j2777101778 -> j2659324826;
	j2234568583 [label="Одну річ потрібно розуміти про орокінів — ми завжди плели інтриги одне проти одного. ",shape=box,color=blue];
		j2234568583 -> j547581409;
	j1185759684 [label="І вона була з цим згодна?",shape=box,color=red];
		j1185759684 -> j14130901;
	j1911256744 [label="Ви обоє просто знали, що збираєтеся вбити одне одного?",shape=box,color=red];
		j1911256744 -> j4134265511;
	j1275536292 [label="Check boolean RoatheKnowsReset2",color=orange];
		j1275536292 -> j4157657226 [label=true,color=green];
		j1275536292 -> j1328214608 [label=false,color=brown];
	j2588886114 [label="Колись я вірив, що ми партнери. У політиці, в інтригах, в ліжку…",shape=box,color=blue];
		j2588886114 -> j1435842587;
	j735669364 [label="Ділові партнери?",shape=box,color=red];
		j735669364 -> j2233814036;
	j796999149 [label="Партнерів в чому?",shape=box,color=red];
		j796999149 -> j3836733363;
	j2659324826 [label="Навряд чи. Але одну річ потрібно розуміти про орокінів — ми завжди плели інтриги один проти одного. ",shape=box,color=blue];
		j2659324826 -> j547581409;
	j547581409 [label="Я знав, що Нітог без вагань уб’є мене в будь-який момент, якщо це хоч якось допоможе їй досягти своїх цілей.",shape=box,color=blue];
		j547581409 -> j4693283;
	j14130901 [label="Я думаю, їй подобався цей виклик, узурпаторе. Відчуття небезпеки. Захоплення від усвідомлення, що вона спала з тим, хто хотів її смерті.",shape=box,color=blue];
		j14130901 -> j851764863;
	j4134265511 [label="Я хотів би вдати, що ми були першими орокінами, які опинилися в такій ситуації, але це було навіть не так вже й рідко.",shape=box,color=blue];
		j4134265511 -> j851764863;
	j4157657226 [label="Саме так! Здається ніби, в нас вже була ця розмова. Але це не було несподіваним поворотом. Вона сама регулярно дратувала мене цим.",shape=box,color=blue];
		j4157657226 -> j1185759684;
		j4157657226 -> j1911256744;
	j1328214608 [label="Саме так! Але це не було несподіваним поворотом. Вона теж це передбачала та регулярно дратувала мене цим.",shape=box,color=blue];
		j1328214608 -> j1185759684;
		j1328214608 -> j1911256744;
	j1435842587 [label="Звичайно, я не вірив, що ми рівні. Вона була Виконавицею. Великою Нітог. Але я вважав себе першим серед її підлеглих.",shape=box,color=blue];
		j1435842587 -> j2199473274;
	j2233814036 [label="Ти просто чудо. Так, можна сказати, що ми були діловими партнерами. Але ми також були партнерами в багатьох інших, важливіших аспектах.",shape=box,color=blue];
		j2233814036 -> j3836733363;
	j3836733363 [label="На війні. У політиці. В інтригах. У ліжку.",shape=box,color=blue];
		j3836733363 -> j1398510194;
	j4693283 [label="Проте вона знала, що я гострив сокиру за її спиною та з нетерпінням чекав моменту, коли зможу відрубати їй голову.",shape=box,color=blue];
		j4693283 -> j2473903733;
	j851764863 [label="Що довше я живу, то більше усвідомлюю, що, можливо, ми не є видом, призначеним для безсмертя.",shape=box,color=blue];
		j851764863 -> j2499156906;
	j2199473274 [label="Яким дурнем я був…",shape=box,color=blue];
		j2199473274 -> j4202285645;
		j2199473274 -> j631300828;
		j2199473274 -> j15771639;
		j2199473274 -> j428934451;
		j2199473274 -> j3250276755;
	j1398510194 [label="Але я думаю, чи не помиляюся. Цікаво, чи слово «партнер» не занадто сильне для того, ким ми насправді були. ",shape=box,color=blue];
		j1398510194 -> j4247408360;
	j2473903733 [label="Можна сказати, що у нас були… складні стосунки.",shape=box,color=blue];
		j2473903733 -> j3250276755;
		j2473903733 -> j428934451;
		j2473903733 -> j15771639;
		j2473903733 -> j4202285645;
		j2473903733 -> j631300828;
	j2499156906 [label="Але так. Можна сказати, що у нас з Нітог були… складні стосунки.",shape=box,color=blue];
		j2499156906 -> j3250276755;
		j2499156906 -> j428934451;
		j2499156906 -> j15771639;
		j2499156906 -> j4202285645;
		j2499156906 -> j631300828;
	j4202285645 [label="Ти піклувався про неї?",shape=box,color=red];
		j4202285645 -> j1052962496;
	j631300828 [label="Ти любив її?",shape=box,color=red];
		j631300828 -> j1745080855;
	j15771639 [label="Ти її довіряв?",shape=box,color=red];
		j15771639 -> j1705994564;
	j428934451 [label="Не шкодуй про те, що зробив. Ти зробив свій вибір. Шляху назад немає. Тільки вперед.",shape=box,color=red];
		j428934451 -> j435370407;
	j3250276755 [label="Єдине, що можна зробити — це дивитися вперед широко розплющеними очима.",shape=box,color=red];
		j3250276755 -> j2859960235;
	j4247408360 [label="Адже вона була Великою Нітог. Виконавицею.",shape=box,color=blue];
		j4247408360 -> j2199473274;
	j1052962496 [label="О, Порожнече, ні! Якби вона якось п’яна вийшла у відкритий шлюз, це розв’язало б багато моїх проблем.",shape=box,color=blue];
		j1052962496 -> j3016857677;
	j1745080855 [label="+5 Chemistry",color=orange];
		j1745080855 -> j3730709210;
	j1705994564 [label="О, Порожнече, ні! Ніколи не довіряй орокінам, мандрівниче. І мені також. Особливо мені! Люби нас, ненавидь нас, обожнюй нас, зневажай нас — але ніколи, ні за яких обставин не довіряй нам.",shape=box,color=blue];
		j1705994564 -> j1512419246;
	j435370407 [label="Add -1 to Thermostat counter",color=orange];
		j435370407 -> j3723622848;
	j2859960235 [label="Add 1 to Thermostat counter",color=orange];
		j2859960235 -> j2651935391;
	j3016857677 [label="Я цілком і повністю зневажав її, і нічого б так мене не потішило, ніж повільне, обережне й ніжне здирання її синьої шкіри.",shape=box,color=blue];
		j3016857677 -> j401541374;
		j3016857677 -> j2585278580;
	j3730709210 [label="Яке зухвале запитання! Гадаю, я обожнюю тебе за те, що ти його можеш ставити. Знаєш, мені здається, що я кохав її, принаймні трохи. Чесно кажучи, я навіть не замислювався над цим.",shape=box,color=blue];
		j3730709210 -> j3544922979;
	j1512419246 [label="Ми схильні до нападів занепокоєння.",shape=box,color=blue];
		j1512419246 -> j2650054482;
		j1512419246 -> j2092923715;
	j3723622848 [label="+10 Chemistry",color=orange];
		j3723622848 -> j2181158852;
	j2651935391 [label="+10 Chemistry",color=orange];
		j2651935391 -> j458804166;
	j401541374 [label="Це було… яскраво.",shape=box,color=red];
		j401541374 -> j723687924;
	j2585278580 [label="І все ж ти спав з нею?",shape=box,color=red];
		j2585278580 -> j4082690922;
	j3544922979 [label="Так, гадаю, я був трохи закоханий у неї. Яке дивне усвідомлення…",shape=box,color=blue];
		j3544922979 -> j870565197;
	j2650054482 [label="Запам’ятаю.",shape=box,color=red];
		j2650054482 -> j3607220764;
	j2092923715 [label="Це не було проблемою.",shape=box,color=red];
		j2092923715 -> j2445928954;
	j2181158852 [label="Може, ти маєш рацію. Жити минулим небезпечно, бо ми обтяжуємо себе жалем і соромом, і нічим більше. ",shape=box,color=blue];
		j2181158852 -> j2045440684;
	j458804166 [label="Може, ти маєш рацію. Жити минулим небезпечно, бо ми обтяжуємо себе жалем і соромом, і нічим більше. ",shape=box,color=blue];
		j458804166 -> j2013532433;
	j723687924 [label="Тільки уявляючи це я міг витримати багато моїх… обов’язкових вечорів у її ліжку. Мої вибачення.",shape=box,color=blue];
		j723687924 -> j1061000516;
		j723687924 -> j3191384242;
	j4082690922 [label="Те, що ти вважаєш ці дві речі несумісними, просто чарівно. Сподіваюся, ти колись матимеш нагоду провести вечір із таким «знайомим», це справді феєрично.",shape=box,color=blue];
		j4082690922 -> j2763296338;
	j870565197 [label="Тобі потрібно зрозуміти, що це також було затьмарене найглибшою і найсильнішою ненавистю. Я зневажав її одночасно, та ніщо не принесло б мені більшого задоволення, ніж повільно, обережно, ніжно здирати її синю шкіру з тіла голими руками.",shape=box,color=blue];
		j870565197 -> j3103883546;
		j870565197 -> j987336896;
	j3607220764 [label="Evaluate expressions",color=orange];
		j3607220764 -> j2549966058 [label="RoatheDatingDeal",color=purple];
		j3607220764 -> j975739029 [label="RoatheMarieDatingDeal",color=purple];
		j3607220764 -> j3786877100 [label="RoatheLyonDatingDeal",color=purple];
		j3607220764 -> j3994314623 [label="DrifterRoathe",color=purple];
		j3607220764 -> j370335334 [label="DrifterMarie",color=purple];
		j3607220764 -> j3786877100 [label="DrifterLyon",color=purple];
		j3607220764 -> j2664123709 [label="false",color=purple];
	j2445928954 [label="Гм, так. Мені здається, що я не зовсім завойовую тебе своїм «диявольським шармом», чи не так?",shape=box,color=blue];
		j2445928954 -> j1822369464;
		j2445928954 -> j269743434;
	j2045440684 [label="Який сенс переживати знову наші минулі вчинки, наші невдачі та жалі? Ми не можемо їх змінити — навіть маючи дар подорожей у часі, спроба «переробити» те, що вже «зроблено», веде лише до божевілля.",shape=box,color=blue];
		j2045440684 -> j2418340232;
	j2013532433 [label="Але ми також не можемо забувати про провини наших колишніх «я», бо ризикуємо стати лише божевільними та деспотичними войовничими істотами, які не бачать провини в собі, а лише в інших.",shape=box,color=blue];
		j2013532433 -> j2139334131;
	j1061000516 [label="Ти так думаєш про всіх своїх коханок? Чи тільки про неї?",shape=box,color=red];
		j1061000516 -> j1171664546;
	j3191384242 [label="Не потрібно вибачатися. Я просто досі в шоці як сильно ти ненавидів свій народ.",shape=box,color=red];
		j3191384242 -> j4160257942;
	j2763296338 [label="Я просто рекомендую тобі не робити такі стосунки постійними. Це стає вкрай шкідливим для обох сторін. Зазвичай це закінчується вбивством одного або обох з вас.",shape=box,color=blue];
		j2763296338 -> j1061000516;
		j2763296338 -> j3795471352;
		j2763296338 -> j3655328593;
	j3103883546 [label="Як ці дві речі можуть існувати одночасно?",shape=box,color=red];
		j3103883546 -> j2586212124;
	j987336896 [label="Це було… яскраво.",shape=box,color=red];
		j987336896 -> j784567440;
	j2549966058 [label="Я просто подумав, що повинен попередити тебе, враховуючи нашу маленьку… домовленість.",shape=box,color=blue];
		j2549966058 -> j3912774225;
	j975739029 [label="М-м, хоча для тебе це ніколи не буде проблемою, чи не так? Ти ж більше схиляєшся до Марі в нашій маленькій «домовленості».",shape=box,color=blue];
		j975739029 -> j353272925;
	j3786877100 [label="М-м, хоча для тебе це ніколи не буде проблемою, чи не так? Ти ж більше схиляєшся до того божевільного священника, хіба ні?",shape=box,color=blue];
		j3786877100 -> j339699763;
	j3994314623 [label="Я просто подумав, що повинен попередити тебе, оскільки знаю про твої… інтереси.",shape=box,color=blue];
		j3994314623 -> j3912774225;
	j370335334 [label="М-м, хоча для тебе це ніколи не буде проблемою, чи не так? Ти ж більше схиляєшся до Марі, хіба ні?",shape=box,color=blue];
		j370335334 -> j353272925;
	j2664123709 [label="+5 Chemistry",color=orange];
		j2664123709 -> j1861562526;
	j1822369464 [label="Ні. Вибач. Ти не в моєму смаку.",shape=box,color=red];
		j1822369464 -> j3080846212;
	j269743434 [label="Завоював. Я просто тобі не довіряю.",shape=box,color=red];
		j269743434 -> j4137689758;
	j2418340232 [label="Ні. Я такий, який я є. Я той, хто я є. Я йду обраним шляхом і вже не бажаю виправдовуватися перед іншими. Я не буду змінювати себе, щоб відповідати очікуванням інших.",shape=box,color=blue];
		j2418340232 -> j2785436402;
	j2139334131 [label="Цю рису я бачив у багатьох ницих Виконавців та Імператорів — сліпа віра лише у свою бездоганність і безгрішність. Я зневажав їх за це і пообіцяв собі, що ніколи не поділятиму таку егоїстичну зарозумілість.",shape=box,color=blue];
		j2139334131 -> j2785436402;
	j1171664546 [label="Я завжди мав справу лише з партнерами у фізичному сенсі, мандрівниче. У мене ніколи не було емоційного зв’язку. Принаймні, такого, який був взаємний.",shape=box,color=blue];
		j1171664546 -> j2888943051;
		j1171664546 -> j1437653273;
	j4160257942 [label="+5 Chemistry",color=orange];
		j4160257942 -> j3325900323;
	j3795471352 [label="Я візьму це до уваги.",shape=box,color=red];
		j3795471352 -> j673894544;
	j3655328593 [label="Цього не було в моїх планах, але дякую за пораду.",shape=box,color=red];
		j3655328593 -> j122809960;
	j2586212124 [label="Те, що тобі ніколи не довелося стикатися з таким, робить тебе надзвичайно щасливою людиною, узурпаторе. Я не рекомендую опинятися в такій ситуації, вона зазвичай закінчується вбивством одного або обох з вас.",shape=box,color=blue];
		j2586212124 -> j1938166881;
		j2586212124 -> j3655328593;
		j2586212124 -> j3795471352;
	j784567440 [label="Тільки уявляючи це я міг витримати довгі засідання. Мої вибачення.",shape=box,color=blue];
		j784567440 -> j1938166881;
		j784567440 -> j3191384242;
		j784567440 -> j2344936469;
	j3912774225 [label="+5 Chemistry",color=orange];
		j3912774225 -> j702152007;
	j353272925 [label="Вона досить гарна, я не можу сказати, що засуджую тебе. Хоча особисто я не думаю, що зміг би витримати цю самовдоволену побожність.",shape=box,color=blue];
		j353272925 -> j2230106340;
	j339699763 [label="Він досить привабливий. Але має такий вигляд, ніби якщо квітка зів’яла, він може оголосити це кінцем світу та кинутися з найближчої вежі.",shape=box,color=blue];
		j339699763 -> j2230106340;
	j1861562526 [label="Мені дійсно цікаво, хто з нас привернув твою увагу, якщо взагалі хтось.",shape=box,color=blue];
		j1861562526 -> j2681580443;
	j3080846212 [label="Ти втрачаєш, але в тебе є доволі широкий вибір, чи не так? Я впевнений, що ти знайдеш когось, із ким… розважишся.",shape=box,color=blue];
		j3080846212 -> j2681580443;
	j4137689758 [label="Check boolean IsDating",color=orange];
		j4137689758 -> j4009799170 [label=true,color=green];
		j4137689758 -> j844060984 [label=false,color=brown];
	j2785436402 [label="Дякую за нагадування.",shape=box,color=blue];
		j2785436402 -> "Chat ends.";
	j2888943051 [label="Ти ніколи не кохав?",shape=box,color=red];
		j2888943051 -> j2640295414;
	j1437653273 [label="Що маєш на увазі?",shape=box,color=red];
		j1437653273 -> j658888162;
	j3325900323 [label="Я не ненавидів їх усіх. Тільки деяких. Тих, хто був при владі. І саме тому зрештою все закінчилося так жахливо.",shape=box,color=blue];
		j3325900323 -> j377340268;
	j673894544 [label="+5 Chemistry",color=orange];
		j673894544 -> j440539392;
	j122809960 [label="+5 Chemistry",color=orange];
		j122809960 -> j1369565343;
	j1938166881 [label="Ти так думаєш про всіх своїх коханок? Чи тільки про неї?",shape=box,color=red];
		j1938166881 -> j1421005553;
	j2344936469 [label="До цього моменту мені ніколи не спадало на думку засідання правління орокінів.",shape=box,color=red];
		j2344936469 -> j262583208;
	j702152007 [label="Як приємно знати, що почуття доброго смаку та класу все-таки не зникло з цієї системи.",shape=box,color=blue];
		j702152007 -> j3547187045;
	j2230106340 [label="Але! Це твій вибір. Дай мені знати, якщо я можу чимось допомогти. Мені дуже подобається спостерігати, як ти та фанатик вплутуєтеся в усілякі непотрібні емоційні труднощі.",shape=box,color=blue];
		j2230106340 -> j2439509358;
		j2230106340 -> j1396160858;
	j2681580443 [label="Check boolean IsDating",color=orange];
		j2681580443 -> j2853764296 [label=true,color=green];
		j2681580443 -> j2594192721 [label=false,color=brown];
	j4009799170 [label="М-м. Мудро. Хоча у мене виникає питання, чи я випадково привернув твою увагу, мандрівниче? Якщо ти думаєш, що мене турбує твоє кохання до іншої особи, то це не так.",shape=box,color=blue];
		j4009799170 -> j1947984938;
	j844060984 [label="М-м. Мудро. Хоча у мене виникає питання, чи я випадково привернув твою увагу, мандрівниче?",shape=box,color=blue];
		j844060984 -> j2067883075;
		j844060984 -> j1739891398;
		j844060984 -> j1894152425;
		j844060984 -> j1233297295;
		j844060984 -> j3664019462;
	j2640295414 [label="+5 Chemistry",color=orange];
		j2640295414 -> j2113674071;
	j658888162 [label="Я мушу пояснювати це тобі? Добре. Я ніколи не кохав.",shape=box,color=blue];
		j658888162 -> j1446329184;
	j377340268 [label="Попри всі наші досягнення, усю роботу, яку ми зробили, щоб врятувати людство, ми так і не розв’язали найважливішу проблему, яка мучила нас у глибині душі. Найбільший недолік, який пожирав наші душі, як ракова пухлина.",shape=box,color=blue];
		j377340268 -> j1601183597;
	j440539392 [label="Постарайся. Здається ти робиш усе можливе, щоб жити гарним життям, мандрівниче. Бути «хорошою» людиною. Я не хотів би бачити, як ти закінчиш так само, як орокіни. Нас прирекла наша надмірність.",shape=box,color=blue];
		j440539392 -> j2034158001;
	j1369565343 [label="Будь ласка. Здається ти робиш усе можливе, щоб жити гарним життям, мандрівниче. Бути «хорошою» людиною. Я не хотів би бачити, як ти закінчиш так само, як орокіни. Нас прирекла наша надмірність.",shape=box,color=blue];
		j1369565343 -> j2034158001;
	j1421005553 [label="Я завжди мав справу лише з партнерами у фізичному сенсі, мандрівниче. У мене ніколи не було емоційного зв’язку. Принаймні, такого, який був взаємний.",shape=box,color=blue];
		j1421005553 -> j2888943051;
		j1421005553 -> j833186736;
	j262583208 [label="Жалюгідно, чи не так? Попри всі досягнення у всесвіті, ми все ще не змогли придумати, як упорядкувати свої справи, не витрачаючи години життя всіх присутніх на розмови одне з одним.",shape=box,color=blue];
		j262583208 -> j377340268;
	j3547187045 [label="Ну, тепер, коли ми знаємо, на яку ціль націлений твій лук, у нас є мета, до якої можна прагнути, чи не так?",shape=box,color=blue];
		j3547187045 -> j3261892969;
		j3547187045 -> j2810259446;
	j2439509358 [label="Я не думаю, що можу довірити це тобі.",shape=box,color=red];
		j2439509358 -> j890061045;
	j1396160858 [label="Справді? Ти… допоможеш?",shape=box,color=red];
		j1396160858 -> j2668349633;
	j2853764296 [label="Зрештою, ти дійсно маєш схильність до «протофреймів».",shape=box,color=blue];
		j2853764296 -> j129414379;
		j2853764296 -> j1943106535;
	j2594192721 [label="Чи в тебе немає схильності до «протофреймів»?",shape=box,color=blue];
		j2594192721 -> j2055101990;
		j2594192721 -> j1349582333;
	j1947984938 [label="І перш ніж ти почнеш писати гнівну відповідь і злісно засуджувати мене за те, що я заохочую тебе до будь-якої невірності, дай мені хвилинку, щоби пояснити.",shape=box,color=blue];
		j1947984938 -> j860077834;
	j2067883075 [label="Це Ліон.",shape=box,color=red];
		j2067883075 -> j888219470;
	j1739891398 [label="Це Марі.",shape=box,color=red];
		j1739891398 -> j3617450912;
	j1894152425 [label="[Зізнатися в почуттях]… Так.",shape=box,color=red];
		j1894152425 -> j3604940592;
	j1233297295 [label="Ні.",shape=box,color=red];
		j1233297295 -> j1996969491;
	j3664019462 [label="Це не твоя справа.",shape=box,color=red];
		j3664019462 -> j1403475005;
	j2113674071 [label="Чи це не сумно? Я знаю. Ні, ніколи. Ніколи взаємно.",shape=box,color=blue];
		j2113674071 -> j1446329184;
	j1446329184 [label="Чи було невзаємне кохання? О, безперечно. Чи було це романтично? Це було трагічно.",shape=box,color=blue];
		j1446329184 -> j1597344212;
	j1601183597 [label="Бюрократія.",shape=box,color=blue];
		j1601183597 -> j649252286;
	j2034158001 [label="Це існування, яке має тенденцію визначати тебе самотністю.",shape=box,color=blue];
		j2034158001 -> j1938166881;
	j833186736 [label="Що ти маєш на увазі?",shape=box,color=red];
		j833186736 -> j658888162;
	j3261892969 [label="Ти не здивований.",shape=box,color=red];
		j3261892969 -> j3524162382;
	j2810259446 [label="У мене не було впевненості, як ти відреагуєш.",shape=box,color=red];
		j2810259446 -> j3524162382;
	j890061045 [label="Мабуть, мудро. Банально, але мудро.",shape=box,color=blue];
		j890061045 -> j2690471905;
	j2668349633 [label="Звичайно! У кращому випадку ти відвернеш увагу одного з них від їхньої, здавалося б, нездійсненної мети — переслідувати мене.",shape=box,color=blue];
		j2668349633 -> j3772715540;
	j129414379 [label="Але я вже з кимось зустрічаюся. Це не буде для тебе проблемою? Чи для Марі та Ліона?",shape=box,color=red];
		j129414379 -> j1368732292;
	j1943106535 [label="Я вже маю стосунки.",shape=box,color=red];
		j1943106535 -> j2720106928;
	j2055101990 [label="Маю. Просто ніхто з вас не підходить.",shape=box,color=red];
		j2055101990 -> j1996969491;
	j1349582333 [label="Маю. Моє серце вже належить декому, але такі речі вимагають часу.",shape=box,color=red];
		j1349582333 -> j942167527;
	j860077834 [label="Коли людина живе так довго, як ми, вона починає розуміти, що деякі серця можуть вмістити любов до багатьох людей.",shape=box,color=blue];
		j860077834 -> j207215337;
	j888219470 [label="Boolean DrifterLyon is now true.",color=orange];
		j888219470 -> j3048126998;
	j3617450912 [label="Boolean DrifterMarie is now true.",color=orange];
		j3617450912 -> j2526748180;
	j3604940592 [label="Boolean DrifterRoathe is now true.",color=orange];
		j3604940592 -> j1735158775;
	j1996969491 [label="Ти мене ображаєш.",shape=box,color=blue];
		j1996969491 -> j3082463206;
	j1403475005 [label="Boolean DrifterUnknown is now true.",color=orange];
		j1403475005 -> j2441837869;
	j1597344212 [label="Тепер ти вважаєш мене дияволом? Моя репутація тільки покращилася в цьому далекому майбутньому, мій узурпаторе.",shape=box,color=blue];
		j1597344212 -> j782123756;
	j649252286 [label="Ніщо в світі не гальмує людську велич так, як дотримання систем і паперової роботи за будь-яку ціну.",shape=box,color=blue];
		j649252286 -> j3038376912;
	j3524162382 [label="Ти думаєш, що ти перша людина, яку я коли-небудь зустрічав, що хоче «потанцювати з дияволом Тау»? Навряд чи. Залишається тільки подивитися, наскільки щира твоя зацікавленість, чи вона зникне після кількох ночей задоволення твоїх бажань.",shape=box,color=blue];
		j3524162382 -> j2830335894;
	j2690471905 [label="Мабуть, мені доведеться просто сидіти та дивитися, як усе розвалиться само собою. Або ти досягнеш успіху й хтось відірветься від їхньої, здавалося б, нездійсненної мети — переслідувати мене.",shape=box,color=blue];
		j2690471905 -> j105885558;
	j3772715540 [label="У гіршому випадку все закінчиться жахливо, а я отримаю кілька годин розваг. ",shape=box,color=blue];
		j3772715540 -> j105885558;
	j1368732292 [label="Тебе це здивує, проте ми, орокіни, були відомі тим, що мали багато партнерів, але це було лише для фізичної близькості.",shape=box,color=blue];
		j1368732292 -> j2461977260;
	j2720106928 [label="Ти кохаєш? І це взаємно?",shape=box,color=blue];
		j2720106928 -> j1025220854;
		j2720106928 -> j3896119297;
		j2720106928 -> j2774336070;
		j2720106928 -> j1439006616;
	j942167527 [label="О! І хто з нас припав тобі до душі? Або це хтось інший, з іншого часу?",shape=box,color=blue];
		j942167527 -> j3574432012;
		j942167527 -> j2067883075;
		j942167527 -> j1739891398;
		j942167527 -> j3317801374;
	j207215337 [label="Це просто інший спосіб існування для тих, хто сприймає життя таким чином.",shape=box,color=blue];
		j207215337 -> j4069674608;
	j3048126998 [label="Що? Чому?! Ти справді так не поважаєш себе? Або ти маєш схильність колекціонувати сумні, нещасні речі?",shape=box,color=blue];
		j3048126998 -> j527855185;
	j2526748180 [label="Чому я не здивований? З огляду на те, що ця штука… постійно крутиться у твоєму полі зору, це й не дивно. Диво, що хтось взагалі тут працює.",shape=box,color=blue];
		j2526748180 -> j2458588814;
	j1735158775 [label="+5 Chemistry",color=orange];
		j1735158775 -> j1144290351;
	j3082463206 [label="Біль.",shape=box,color=blue];
		j3082463206 -> j3049535188;
	j2441837869 [label="Справедливо. Але це не «ні» і не «так», тому я залишу цей пункт обведеним.",shape=box,color=blue];
		j2441837869 -> j2679790220;
	j782123756 [label="Подумай над цим, і, можливо, ти зрозумієш, чому мало хто хотів залишатися поруч зі мною.",shape=box,color=blue];
		j782123756 -> j779926630;
	j3038376912 [label="Але ми відхилилися від теми. Про це поговоримо іншим разом. А зараз я мушу йти.",shape=box,color=blue];
		j3038376912 -> j4081414586;
	j2830335894 [label="Міст, який ми перейдемо, коли досягнемо його.",shape=box,color=blue];
		j2830335894 -> j3470023493;
	j105885558 [label="+5 Chemistry",color=orange];
		j105885558 -> j3035507520;
	j2461977260 [label="Коли людина живе так довго, як ми, вона починає розуміти, що деякі серця можуть вмістити любов до багатьох людей.",shape=box,color=blue];
		j2461977260 -> j3150054219;
	j1025220854 [label="Ні.",shape=box,color=red];
		j1025220854 -> j1147499284;
	j3896119297 [label="Я не знаю. Можливо.",shape=box,color=red];
		j3896119297 -> j4036443868;
	j2774336070 [label="Так. І я сподіваюся, що це так.",shape=box,color=red];
		j2774336070 -> j2930899041;
	j1439006616 [label="Це не твоя справа.",shape=box,color=red];
		j1439006616 -> j1118557672;
	j3574432012 [label="Це хтось, кого ти не знаєш.",shape=box,color=red];
		j3574432012 -> j1088469261;
	j3317801374 [label="Це не твоя справа.",shape=box,color=red];
		j3317801374 -> j1743213096;
	j4069674608 [label="Я просто кажу, що якщо ти відчуваєш почуття до більш ніж однієї людини одночасно, я не буду тебе за це засуджувати, ось і все.",shape=box,color=blue];
		j4069674608 -> j2998103500;
	j527855185 [label="Він досить привабливий, я вважаю. Але має такий вигляд, ніби якщо квітка зів’яла, він може оголосити це кінцем світу та кинутися з найближчої вежі.",shape=box,color=blue];
		j527855185 -> j191846310;
	j2458588814 [label="Ну що ж, бажаю тобі удачі. Я не міг терпіти її самовдоволену та нескінченну побожність. Крім того, вона вважає мене лише нечестивцем.",shape=box,color=blue];
		j2458588814 -> j3609214232;
