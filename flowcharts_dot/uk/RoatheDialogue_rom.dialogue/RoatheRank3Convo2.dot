	1608 [label="Ні. Я такий, який я є. Я той, хто я є. Я йду обраним шляхом і вже не бажаю виправдовуватися перед іншими. Я не буду змінювати себе, щоб відповідати очікуванням інших.",shape=box,color=blue];
		1608 -> 1622;
	1609 [label="Цю рису я бачив у багатьох ницих Виконавців та Імператорів — сліпа віра лише у свою бездоганність і безгрішність. Я зневажав їх за це і пообіцяв собі, що ніколи не поділятиму таку егоїстичну зарозумілість.",shape=box,color=blue];
