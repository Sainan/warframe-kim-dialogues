		1584 -> 1591;
	1585 [label="Може, ти маєш рацію. Жити минулим небезпечно, бо ми обтяжуємо себе жалем і соромом, і нічим більше. ",shape=box,color=blue];
		1585 -> 1592;
	1586 [label="Може, ти маєш рацію. Жити минулим небезпечно, бо ми обтяжуємо себе жалем і соромом, і нічим більше. ",shape=box,color=blue];
		1586 -> 1593;
	1587 [label="Тільки уявляючи це я міг витримати багато моїх… обов’язкових вечорів у її ліжку. Мої вибачення.",shape=box,color=blue];
		1587 -> 1594;
		1587 -> 1595;
	1588 [label="Те, що ти вважаєш ці дві речі несумісними, просто чарівно. Сподіваюся, ти колись матимеш нагоду провести вечір із таким «знайомим», це справді феєрично.",shape=box,color=blue];
		1588 -> 1596;
	1589 [label="Тобі потрібно зрозуміти, що це також було затьмарене найглибшою і найсильнішою ненавистю. Я зневажав її одночасно, та ніщо не принесло б мені більшого задоволення, ніж повільно, обережно, ніжно здирати її синю шкіру з тіла голими руками.",shape=box,color=blue];
		1589 -> 1597;
