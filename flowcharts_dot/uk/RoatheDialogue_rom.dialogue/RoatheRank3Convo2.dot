	j191846310 [label="Але! Це твій вибір. Дай мені знати, якщо я можу чимось допомогти. Мені дуже подобається спостерігати, як ти та фанатик вплутуєтеся в усілякі непотрібні емоційні труднощі.",shape=box,color=blue];
