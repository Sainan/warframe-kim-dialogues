		1640 -> 1658;
	1641 [label="Попри всі наші досягнення, усю роботу, яку ми зробили, щоб врятувати людство, ми так і не розв’язали найважливішу проблему, яка мучила нас у глибині душі. Найбільший недолік, який пожирав наші душі, як ракова пухлина.",shape=box,color=blue];
		1641 -> 1659;
	1642 [label="Постарайся. Здається ти робиш усе можливе, щоб жити гарним життям, мандрівниче. Бути «хорошою» людиною. Я не хотів би бачити, як ти закінчиш так само, як орокіни. Нас прирекла наша надмірність.",shape=box,color=blue];
		1642 -> 1660;
	1643 [label="Будь ласка. Здається ти робиш усе можливе, щоб жити гарним життям, мандрівниче. Бути «хорошою» людиною. Я не хотів би бачити, як ти закінчиш так само, як орокіни. Нас прирекла наша надмірність.",shape=box,color=blue];
		1643 -> 1660;
	1644 [label="Я завжди мав справу лише з партнерами у фізичному сенсі, мандрівниче. У мене ніколи не було емоційного зв’язку. Принаймні, такого, який був взаємний.",shape=box,color=blue];
		1644 -> 1661;
		1644 -> 1662;
	1645 [label="Жалюгідно, чи не так? Попри всі досягнення у всесвіті, ми все ще не змогли придумати, як упорядкувати свої справи, не витрачаючи години життя всіх присутніх на розмови одне з одним.",shape=box,color=blue];
		1645 -> 1641;
	1648 [label="Ну, тепер, коли ми знаємо, на яку ціль націлений твій лук, у нас є мета, до якої можна прагнути, чи не так?",shape=box,color=blue];
