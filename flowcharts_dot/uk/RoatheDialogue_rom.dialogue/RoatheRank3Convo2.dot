	1682 [label="Ти думаєш, що ти перша людина, яку я коли-небудь зустрічав, що хоче «потанцювати з дияволом Тау»? Навряд чи. Залишається тільки подивитися, наскільки щира твоя зацікавленість, чи вона зникне після кількох ночей задоволення твоїх бажань.",shape=box,color=blue];
		1682 -> 1697;
	1680 [label="Мабуть, мені доведеться просто сидіти та дивитися, як усе розвалиться само собою. Або ти досягнеш успіху й хтось відірветься від їхньої, здавалося б, нездійсненної мети — переслідувати мене.",shape=box,color=blue];
