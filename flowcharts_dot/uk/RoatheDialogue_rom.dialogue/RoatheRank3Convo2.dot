digraph {
	1463 [label="RoatheRank3Convo2 begins.",color=orange];
		1463 -> 1465;
		1463 -> 1464;
	1465 [label="Як саме ти планував скинути Виконавців?",shape=box,color=red];
		1465 -> 1467;
	1464 [label="[Завершити розмову]",shape=box,color=red];
		1464 -> 1466;
	1467 [label="Check boolean RoatheKnowsReset2",color=orange];
		1467 -> 1468 [label=true,color=green];
		1467 -> 1469 [label=false,color=brown];
	1466 [label="Chat ends.",color=orange];
	1468 [label="Чому ти мене про це питаєш? Що ти намагаєшся дізнатися, мандрівниче? Ти точно не питаєш про розташування боєприпасів.",shape=box,color=blue];
		1468 -> 1470;
	1469 [label="Чому? Плануєш повернутися в минуле та побити рекорд свого попереднього «я»? Потрібна порада, як повалити тоталітарний уряд? Шукаєш розташування захованих боєприпасів, які можуть підірвати цілі планети?",shape=box,color=blue];
		1469 -> 1471;
	1470 [label="Чому я мав би тобі довіряти? Чому я тобі довіряв?!",shape=box,color=blue];
		1470 -> 1472;
	1471 [label="Або ти просто ведеш порожні розмови?",shape=box,color=blue];
		1471 -> 1473;
		1471 -> 1474;
		1471 -> 1475;
	1472 [label="Check boolean RoatheResetForgiven",color=orange];
		1472 -> 1477 [label=true,color=green];
		1472 -> 1476 [label=false,color=brown];
	1473 [label="Чесно кажучи, мені цікаво, чи ти про щось шкодуєш. Чи повернувся б ти назад і змінив щось із того, що планував.",shape=box,color=red];
		1473 -> 1478;
	1474 [label="Мене зачаровує думка про те, як би це було — спробувати придумати такий план. Це, мабуть, було б шедевром.",shape=box,color=red];
		1474 -> 1479;
	1475 [label="Чесно кажучи, було б добре знати, чи ти десь сховав якусь із тієї зброї, до якої ще можна дістатися.",shape=box,color=red];
		1475 -> 1480;
	1477 [label="Я пробачив тобі твій вчинок. Я просто хотів би згадати, чому — чому? Чому саме ти, з усіх людей?!",shape=box,color=blue];
		1477 -> 1483;
		1477 -> 1481;
	1476 [label="Чому? Чому саме ти, з усіх людей?!",shape=box,color=blue];
		1476 -> 1481;
		1476 -> 1482;
	1478 [label="Add 1 to Thermostat",color=orange];
		1478 -> 1484;
	1479 [label="Add -1 to Thermostat",color=orange];
		1479 -> 1485;
	1480 [label="+5 Chemistry",color=orange];
		1480 -> 1486;
	1483 [label="Я знаю. І мені все ще дуже шкода.",shape=box,color=red];
		1483 -> 1489;
	1481 [label="Я намагаюся привести тебе до розуміння, чому.",shape=box,color=red];
		1481 -> 1487;
	1482 [label="Мені все ще шкода зрадженої довіри, Роуте. Вір або ні, але це не входило до моїх планів.",shape=box,color=red];
		1482 -> 1488;
	1484 [label="Єдине, про що я шкодую, що цього так і не сталося. Я шкодую про змарнований час.",shape=box,color=blue];
		1484 -> 1490;
	1485 [label="І це було шедевром, узурпаторе.",shape=box,color=blue];
		1485 -> 1490;
	1486 [label="Практично. Але багато з тих місць, де я «ховав» свої запаси, ймовірно, за багато-багато років загубилися.",shape=box,color=blue];
		1486 -> 1491;
	1489 [label="Так, так. Мабуть, нам слід продовжити цю безглузду розмову, в якій ми знову повертаємося до попередніх розмов.",shape=box,color=blue];
		1489 -> 1493;
	1487 [label="+5 Chemistry",color=orange];
		1487 -> 1492;
	1488 [label="Так, у тебе, ймовірно, була впевненість, що твої дії не матимуть наслідків. Але попри це ми повинні продовжувати цю безглузду розмову, в якій ми переосмислюємо своє минуле і просто продовжуємо жити далі.",shape=box,color=blue];
		1488 -> 1493;
	1490 [label="+5 Chemistry",color=orange];
		1490 -> 1494;
	1491 [label="І багато з цих місць були таємницею навіть для мене. План був надзвичайно складним. Багатошаровим, глибоким.",shape=box,color=blue];
		1491 -> 1495;
	1493 [label="Яке було твоє запитання? А, так. «Як саме я планував скинути Виконавців?» ",shape=box,color=blue];
		1493 -> 1496;
	1492 [label="Повторюючи ті самі безглузді розмови про те, чому я хотів вбити людей, які вже давно померли та перетворилися на попіл? Принаймні, це прагматичний підхід.",shape=box,color=blue];
		1492 -> 1493;
	1494 [label="План був надзвичайно складним. Багатошаровим, глибоким. Убивці, які вбивали б убивць інших убивць, якщо перші вбивці зазнали невдачі.",shape=box,color=blue];
		1494 -> 1497;
	1495 [label="Убивці, які вбивали б убивць інших убивць, якщо перші вбивці зазнали невдачі.",shape=box,color=blue];
		1495 -> 1497;
	1496 [label="Чому?",shape=box,color=blue];
		1496 -> 1473;
		1496 -> 1474;
		1496 -> 1475;
	1497 [label="Бомби, закладені в численних будівлях, зорельотах і цілому місяці, були оснащені вкраденою вибухівкою. Сонячна рейка, готова зійти з орбіти.",shape=box,color=blue];
		1497 -> 1498;
	1498 [label="І все це було підлаштовано так, щоб, коли настав час, виглядало як «Велика катастрофа Свідомих». Ми з Нітог оголосили б в імперії надзвичайний стан, як тільки з Виконавцями та імператорами було б… покінчено.",shape=box,color=blue];
		1498 -> 1499;
	1499 [label="Update boolean RoatheTraitor2",color=orange];
		1499 -> 1500;
