		1500 -> 1501 [label=false,color=brown];
		1500 -> 1502 [label=false,color=brown];
	1501 [label="А якби твій план не спрацював?",shape=box,color=red];
		1501 -> 1504;
	1502 [label="І що ти збирався робити тоді?",shape=box,color=red];
		1502 -> 1505;
	1503 [label="Що ти планував зробити з Нітог?",shape=box,color=red];
		1503 -> 1506;
	1504 [label="Це був один із багатьох тисяч можливих результатів, для яких я мав план. ",shape=box,color=blue];
		1504 -> 1507;
	1505 [label="Існувала тисяча можливих результатів того, що ми запланували. Для кожної змінної, що брала участь у грі, було створено можливий варіант шляху. ",shape=box,color=blue];
		1505 -> 1508;
	1506 [label="Check boolean RoatheKnowsReset2",color=orange];
		1506 -> 1510 [label=true,color=green];
		1506 -> 1509 [label=false,color=brown];
	1507 [label="Якби ми зазнали разючої невдачі, я б просто вставив до рота Лекса й на тому б закінчив.",shape=box,color=blue];
		1507 -> 1511;
	1508 [label="І для кожного з них я визначив результат. І для кожного я знав, що мав робити. Багато з них були схожими в загальних рисах, але відрізнялися в деталях.",shape=box,color=blue];
		1508 -> 1512;
	1510 [label="Що я розповів тобі про це раніше? Бо я вважаю, що ще не довіряю тобі настільки, щоб сказати тобі все відверто.",shape=box,color=blue];
		1510 -> 1515;
		1510 -> 1516;
	1509 [label="Це було складне питання, яке вимагало… тривалих переговорів між нами.",shape=box,color=blue];
		1509 -> 1513;
		1509 -> 1514;
	1511 [label="Немає сенсу плакати над розлитою кувою та всім іншим.",shape=box,color=blue];
		1511 -> 1517;
		1511 -> 1518;
	1512 [label="Якби ми зазнали разючої невдачі, я б просто вставив до рота Лекса й на тому б закінчив.",shape=box,color=blue];
		1512 -> 1519;
