		1515 -> 1522;
	1516 [label="Тоді я не буду змушувати тебе розповідати мені більше, ніж ти хочеш.",shape=box,color=red];
		1516 -> 1523;
	1513 [label="У цьому реченні закладено багато сенсу.",shape=box,color=red];
		1513 -> 1520;
	1514 [label="Яких переговорів?",shape=box,color=red];
		1514 -> 1521;
	1517 [label="Як на мене, то краще втекти.",shape=box,color=red];
		1517 -> 1524;
	1518 [label="Ти просто б змирився зі смертю?",shape=box,color=red];
		1518 -> 1525;
	1519 [label="Якби це був посередній успіх, що було найбільш імовірним, то потрібно було б провести очищення, щоб переконатися, що всі незавершені справи були «вирішені». Звичайно, я був одним з тих, хто перерізав мотузки. І я вжив заходів, щоб переконатися, що я все ще залишаюся цінним в короткостроковій перспективі, щоб мене не відрізали разом із рештою.",shape=box,color=blue];
		1519 -> 1526;
	1522 [label="Тоді немає сенсу повторюватись зараз, чи не так? Насправді ця розмова взагалі не має сенсу. Гарного дня.",shape=box,color=blue];
		1522 -> 1529;
	1523 [label="+5 Chemistry",color=orange];
		1523 -> 1530;
	1520 [label="+5 Chemistry",color=orange];
		1520 -> 1527;
	1521 [label="Будь-яких, які тільки можна уявити.",shape=box,color=blue];
		1521 -> 1528;
	1524 [label="І куди втекти, мій узурпаторе? Не всі з нас мають кишенькові виміри, куди можна втекти, коли в паніці.",shape=box,color=blue];
		1524 -> 1531;
	1525 [label="У мене не було іншого вибору, чи не так? Нікуди подітися, ніде сховатися.",shape=box,color=blue];
		1525 -> 1531;
	1526 [label="Якби ситуація була надзвичайно успішною, я перейшов би до другої фази плану.",shape=box,color=blue];
		1526 -> 1532;
		1526 -> 1533;
	1529 [label="Chat ends.",color=orange];
	1530 [label="Добре. Я скажу, що це було складне питання, яке вимагало… тривалих переговорів між нами.",shape=box,color=blue];
		1530 -> 1513;
