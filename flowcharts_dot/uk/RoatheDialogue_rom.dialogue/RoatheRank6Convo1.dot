		j315671851 -> j939364803;
	j83672339 [label="Ти маєш рацію. Не варто зволікати з люб’язностями. Перейдімо до наступного. У нас багато роботи.",shape=box,color=blue];
		j83672339 -> j226882124;
	j153487562 [label="Ти небезпечна істота, якщо називаєшся другом диявола. Але я був би радий називати тебе ним.",shape=box,color=blue];
		j153487562 -> j939364803;
	j4272994223 [label="Не буду вдавати, що це не ранить мене. Дійсно, що вище підіймаєшся, то болісніше падіння.",shape=box,color=blue];
		j4272994223 -> j1010045371;
