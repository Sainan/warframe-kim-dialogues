		j2105818580 -> j870065503;
	j3673187327 [label="Цей диявол не звик до такого.",shape=box,color=blue];
		j3673187327 -> j2522927155;
		j3673187327 -> j2072287047;
	j3022572755 [label="Не шукай похвали без потреби, мандрівниче. Це непристойно.",shape=box,color=blue];
