	j396207583 [label="Прошу, Роуте. Для цього й потрібні друзі.",shape=box,color=red];
		j396207583 -> j315671851;
	j3861921597 [label="Який наступний крок із Лойдом?",shape=box,color=red];
		j3861921597 -> j83672339;
	j1571932917 [label="Прошу, Роуте. Для цього й потрібні друзі.",shape=box,color=red];
		j1571932917 -> j153487562;
	j2770833113 [label="Я… вибач. Ти маєш рацію. Я тебе не кохаю.",shape=box,color=red];
		j2770833113 -> j4272994223;
	j2711241138 [label="Я люблю все, ким ти є. Ким ти можеш стати. Ким ти вирішив бути. Усе, на що ти здатний. Я кохаю тебе, Роуте.",shape=box,color=red];
		j2711241138 -> j3714594822;
	j1488540420 [label="Я кохаю тебе не попри те, ким ти є, Роуте. Я кохаю тебе за те, ким ти є. Усього тебе. Усе добро й зло, на які ти здатний.",shape=box,color=red];
		j1488540420 -> j2472539228;
	j1758108226 [label="Не зважай. Не пам’ятаю.",shape=box,color=red];
		j1758108226 -> j1023175877;
	j2751134536 [label="Можеш не вірити, але… я кохаю тебе.",shape=box,color=red];
		j2751134536 -> j1150464586;
