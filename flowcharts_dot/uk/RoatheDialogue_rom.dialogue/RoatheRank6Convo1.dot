		j842129377 -> "Chat ends." [label="false",color=purple];
	j696957965 [label="Я нещодавно почув від тебе слова про кохання. Мушу запитати… це все ще правда? Я хочу дати тобі можливість змінити свою думку.",shape=box,color=blue];
		j696957965 -> j50071176;
	j3938114251 [label="Я нещодавно почув від тебе слова про кохання. Мушу запитати… це все ще правда? Я хочу дати тобі можливість змінити свою думку.",shape=box,color=blue];
		j3938114251 -> j2999410088;
	j288765830 [label="[Зізнатися в коханні] Здається, я маю дещо сказати, перш ніж тебе далеко занесе.",shape=box,color=red];
		j288765830 -> j2026577390;
	j4153741774 [label="Прошу, Роуте. Ось чому я з тобою.",shape=box,color=red];
		j4153741774 -> j3368074437;
	j3507603419 [label="[Зізнатися в коханні] Здається, я маю дещо сказати, перш ніж тебе далеко занесе.",shape=box,color=red];
		j3507603419 -> j2193534536;
	j3103078447 [label="А що як я люблю твої погрози?",shape=box,color=red];
		j3103078447 -> j246336546;
	j3529950817 [label="Прошу, Роуте. Для цього й потрібні друзі.",shape=box,color=red];
		j3529950817 -> j1702724765;
	j3622652989 [label="Подяка за що?",shape=box,color=red];
		j3622652989 -> j2139012758;
	j2202454426 [label="Подяка за що?",shape=box,color=red];
		j2202454426 -> j2049217911;
	j169686792 [label="А що як я люблю твої погрози?",shape=box,color=red];
		j169686792 -> j2924109091;
	j892538379 [label="Хоча було б недбало з мого боку не сказати, перш ніж ми зайдемо надто далеко в цій справі з дворецьким, що я маю в дечому зізнатися.",shape=box,color=blue];
		j892538379 -> j2218421203;
	j2347124564 [label="Хоча було б недбало з мого боку не сказати, перш ніж ми зайдемо надто далеко в цій справі з дворецьким, що я маю в дечому зізнатися.",shape=box,color=blue];
		j2347124564 -> j3790325789;
	j1506188801 [label="Хоча було б недбало з мого боку не подякувати за твою допомогу у відновленні та узгодженні моїх спогадів, любове.",shape=box,color=blue];
		j1506188801 -> j733474297;
		j1506188801 -> j1860654641;
	j3941760249 [label="Хоча, якщо ти також шукаєш подяки за допомогу відновити мої спогади та узгодити їх, уважай, що я сповнений подяки за твою допомогу, любове.",shape=box,color=blue];
		j3941760249 -> j2123217721;
		j3941760249 -> j733474297;
	j2047002186 [label="Хоча було б недбало з мого боку не подякувати за твою допомогу у відновленні та узгодженні моїх спогадів.",shape=box,color=blue];
		j2047002186 -> j331660823;
		j2047002186 -> j396207583;
	j2784160199 [label="Хоча, якщо ти також шукаєш подяки за допомогу відновити мої спогади та узгодити їх, уважай, що я сповнений подяки за твою допомогу.",shape=box,color=blue];
		j2784160199 -> j3861921597;
		j2784160199 -> j1571932917;
	j50071176 [label="Особливо перш ніж я виставлю себе дурнем. Хоча останнім часом я те й роблю.",shape=box,color=blue];
		j50071176 -> j2770833113;
		j50071176 -> j2711241138;
	j2999410088 [label="Особливо з огляду на те, що твої аргументи переконали мене прийняти своє минуле та ігнорувати все, що про мене говорять інші.",shape=box,color=blue];
		j2999410088 -> j2770833113;
		j2999410088 -> j1488540420;
	j2026577390 [label="Раптом мене охоплює нестерпне відчуття жаху. У тебе справді є хист несподівано перевертати все навколо. Що таке?",shape=box,color=blue];
		j2026577390 -> j1758108226;
		j2026577390 -> j2751134536;
	j3368074437 [label="Зі мною. Так. Супутники. Я не звик до такої думки.",shape=box,color=blue];
		j3368074437 -> j175283773;
	j2193534536 [label="Раптом мене охоплює нестерпне відчуття жаху. Обережно. Ти граєш у небезпечні ігри. Що таке?",shape=box,color=blue];
		j2193534536 -> j868942933;
		j2193534536 -> j3161540898;
	j246336546 [label="І мені подобається їх готувати! Ось чому ми так добре ладнаємо. І саме це я коротко хочу сказати.",shape=box,color=blue];
		j246336546 -> j2105818580;
	j1702724765 [label="Друзі. Так. Гадаю, саме ними ми і є, чи не так? Яка дивна думка.",shape=box,color=blue];
		j1702724765 -> j3673187327;
	j2139012758 [label="За допомогу з відновленням і узгодженням моїх спогадів. За що ж іще? Наче моєю білизною я не казав тобі займатися.",shape=box,color=blue];
		j2139012758 -> j3022572755;
	j2049217911 [label="Я маю це по літерах сказати? Добре. Але не думай, що я буду завалювати тебе похвалами. Інші тебе й так добре хвалять. Від мене стільки не потрібно.",shape=box,color=blue];
		j2049217911 -> j3374380239;
	j2924109091 [label="І мені подобається їх готувати! Ось чому ми так добре ладнаємо. І саме це я коротко хочу сказати.",shape=box,color=blue];
		j2924109091 -> j3374380239;
	j2218421203 [label="Я нещодавно почув від тебе слова про кохання. Мушу запитати… це все ще правда? Я хочу дати тобі можливість змінити свою думку.",shape=box,color=blue];
