	j2139501162 [label="Ха! Що ж, визнаю, це жахливо зловісне твердження. Але саме худорлявий дворецький має потурбуватися про своє майбутнє, а не ти.",shape=box,color=blue];
		j2139501162 -> j308363092;
	j3444887050 [label="Ха! Що ж, визнаю, це жахливо зловісне твердження. Але саме худорлявий дворецький має потурбуватися про своє майбутнє, а не ти.",shape=box,color=blue];
		j3444887050 -> j842129377;
	j3173335453 [label="Ха! Що ж, визнаю, це жахливо зловісне твердження. Але ні, нічого лихого тут нема. Я маю в дечому зізнатися.",shape=box,color=blue];
		j3173335453 -> j696957965;
	j2888008306 [label="Ха! Що ж, визнаю, це жахливо зловісне твердження. Ні, на жаль, сьогодні ніяких загроз. Я маю в дечому зізнатися.",shape=box,color=blue];
		j2888008306 -> j3938114251;
	j1715921516 [label="Ха! Що ж, визнаю, це жахливо зловісне твердження. Але ні, нічого лихого тут нема. Просто визнання того, що я давно запізнився із подякою тобі за допомогу, любове.",shape=box,color=blue];
		j1715921516 -> j288765830;
		j1715921516 -> j4153741774;
	j3817845262 [label="Ха! Що ж, визнаю, це жахливо зловісне твердження. Ні, на жаль, сьогодні ніяких загроз. Просто хочу подякувати тобі за допомогу, любове.",shape=box,color=blue];
		j3817845262 -> j3507603419;
		j3817845262 -> j3103078447;
	j4147424334 [label="Ха! Що ж, визнаю, це жахливо зловісне твердження. Але ні, нічого лихого тут нема. Просто визнання того, що я давно запізнився із подякою.",shape=box,color=blue];
