		j3906745892 -> j1922924858;
		j3906745892 -> j4253756144;
	j1364767994 [label="Особливо з огляду на те, що твої аргументи переконали мене прийняти своє минуле та ігнорувати все, що про мене говорять інші.",shape=box,color=blue];
		j1364767994 -> j1922924858;
		j1364767994 -> j4215009988;
