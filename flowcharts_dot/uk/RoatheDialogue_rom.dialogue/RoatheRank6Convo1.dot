		j1023175877 -> "Chat ends.";
	j1150464586 [label="Я люблю все, ким ти є. Ким ти можеш стати. Ким ти вирішив бути. Усе, на що ти здатний. Я кохаю тебе, Роуте.",shape=box,color=red];
		j1150464586 -> j898161090;
	j1424435719 [label="Але що мені робити з тим, ким я є? І на що я здатний? Це новий шлях, яким мені слід пройти. І я маю подякувати за це тобі.",shape=box,color=blue];
		j1424435719 -> "Chat ends.";
	j924263479 [label="Клянуся, ти поводишся гірше за Птаха-3.",shape=box,color=blue];
		j924263479 -> "Chat ends.";
