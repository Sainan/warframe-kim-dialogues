	j3113952251 [label="Кілька. По-перше, мені набридло гнити тут, у цій копії склепу, ніби я якась тварина у вольєрі.",shape=box,color=blue];
		j3113952251 -> j3194259996;
	j1212342384 [label="Звісно, ні! Вона б мене побачила наскрізь. А я б і не намагався приховати те, що було б так очевидно для такої розумної людини.",shape=box,color=blue];
		j1212342384 -> j2432971734;
	j4233985499 [label="Родині потрібен захист. Я маю стояти на сторожі. Я не можу цього робити звідси.",shape=box,color=blue];
		j4233985499 -> j2819739679;
	j2708949970 [label="Він знищив мої спогади й подбав про те, щоб я не мав, крім тебе, до кого можна було б звернутися, щоб їх повернути.",shape=box,color=blue];
