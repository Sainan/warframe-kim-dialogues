		j3483885894 -> "Chat ends." [label="false",color=purple];
	j311465488 [label="Це твій єдиний вихід зараз, якщо коли-небудь захочеш змінити свою думку.",shape=box,color=blue];
		j311465488 -> j2260315096;
	j3637731459 [label="Я радий бачити, що можу приборкати твою свавільну впертість, мандрівниче.",shape=box,color=blue];
		j3637731459 -> j344415811;
	j2629002405 [label="Уперта істота не така вже й незмінна, як здається. Нарешті!",shape=box,color=blue];
		j2629002405 -> j344415811;
	j269374256 [label="Але я не багато можу допомогти з ними. Розчищати шлях і виконувати роботу — різні речі.",shape=box,color=blue];
		j269374256 -> j3722952621;
	j2981667253 [label="Але я не багато можу допомогти з Марі. Розчищати шлях і виконувати роботу — різні речі.",shape=box,color=blue];
		j2981667253 -> j211434747;
	j9434656 [label="Але я не багато можу допомогти з Ліоном. Розчищати шлях і виконувати роботу — різні речі.",shape=box,color=blue];
		j9434656 -> j2799633730;
	j139569374 [label="Ні, мандрівниче. Гадаю, Альбрехт покинув це місце та свою родину раз і назавжди. Сумніваюся, що він колись знову побачить свою доньку.",shape=box,color=blue];
		j139569374 -> j3976805308;
	j408549571 [label="А які в тебе взагалі мотиви? Ти ніколи не казав.",shape=box,color=red];
		j408549571 -> j3113952251;
	j324610343 [label="Ти звинувачуватимеш її в тому, що вона тобі не довіряє?",shape=box,color=red];
		j324610343 -> j1212342384;
	j532553159 [label="По-друге, мені здається, що це свого роду спокута, яку потрібно сплатити, щоб захистити Деймос та родину Ентраті від того, що може статися, коли прийде час сплачувати борги Альбрехта.",shape=box,color=blue];
		j532553159 -> j4233985499;
	j103853887 [label="По-друге, чи є кращий спосіб помститися Альбрехту? Так, я прийняв сироватку добровільно, але це він звкинув мене в минуле.",shape=box,color=blue];
		j103853887 -> j2708949970;
