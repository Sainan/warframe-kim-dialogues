	j4140680399 [label="Check boolean RoatheDating",color=orange];
		j4140680399 -> j3693727888 [label=true,color=green];
		j4140680399 -> j2812593242 [label=false,color=brown];
	j662851341 [label="Ти ж мене знаєш. Я — завжди натхненне джерело мотивації. Але знаєш, якщо маєш зневіру, то завжди можеш… як воно там?",shape=box,color=blue];
		j662851341 -> j829952851;
	j2157978423 [label="Гадаю, я міг би бути корисним, так. І мені, мабуть, дуже подобається надихати їх дати тобі другий шанс переконати їх допомогти.",shape=box,color=blue];
		j2157978423 -> j1543321501;
	j2488449544 [label="Гадаю, я міг би бути корисним, так. І мені, мабуть, дуже подобається надихати їх дати тобі другий шанс переконати її допомогти.",shape=box,color=blue];
		j2488449544 -> j2249085428;
	j206659452 [label="Гадаю, я міг би бути корисним, так. І мені, мабуть, дуже подобається надихати їх дати тобі другий шанс переконати його допомогти.",shape=box,color=blue];
		j206659452 -> j1361876816;
	j4142993334 [label="Коли? Ха! Сумніваюся, що той виродок хоч колись ступить сюди.",shape=box,color=blue];
		j4142993334 -> j2315857562;
	j4258018103 [label="Сподіваюся, нам недовго доведеться чекати, щоб дізнатися. Мені більше цікаво, як вони відреагують на моє наполягання прийняти мій захист.",shape=box,color=blue];
		j4258018103 -> j2664791124;
	j375991702 [label="Кілька. По-перше, мені набридло гнити тут, у цій копії склепу, ніби я якась тварина у вольєрі.",shape=box,color=blue];
		j375991702 -> j3483885894;
	j4244728432 [label="Тепер я розумію, що це була помилка. Ти — величезна трата часу. Як чудово, що ти можеш повторювати це коли забажаєш.",shape=box,color=blue];
		j4244728432 -> j311465488;
	j1552845821 [label="Ти — величезна трата часу. Як чудово, що ти можеш повторювати це коли забажаєш.",shape=box,color=blue];
		j1552845821 -> j311465488;
	j3693727888 [label="+5 Chemistry",color=orange];
		j3693727888 -> j3637731459;
	j2812593242 [label="+5 Chemistry",color=orange];
		j2812593242 -> j2629002405;
	j829952851 [label="«Почни спочатку»?",shape=box,color=blue];
		j829952851 -> "Chat ends.";
	j1543321501 [label="З кожним днем перспектива гнити тут, у цій копії склепу, ніби я якась тварина у вольєрі, здається дедалі менш кумедною.",shape=box,color=blue];
		j1543321501 -> j269374256;
	j2249085428 [label="З кожним днем перспектива гнити тут, у цій копії склепу, ніби я якась тварина у вольєрі, здається дедалі менш кумедною.",shape=box,color=blue];
		j2249085428 -> j2981667253;
	j1361876816 [label="З кожним днем перспектива гнити тут, у цій копії склепу, ніби я якась тварина у вольєрі, здається дедалі менш кумедною.",shape=box,color=blue];
