	j4197885291 [label="Я тут думав про цю справу з дворецьким та родиною нагорі. Це абсолютно неприйнятно.",shape=box,color=blue];
		j4197885291 -> j2626437209;
	j3606653883 [label="Я тут думав про цю справу з дворецьким та родиною Альбрехта нагорі. І як же я з нетерпінням чекаю їхнього «возз’єднання».",shape=box,color=blue];
