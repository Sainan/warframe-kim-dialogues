		j2880248661 -> j2033967052;
	j858510546 [label="Якщо я маю бути якимось цінним активом або бути комусь корисним, то звідси я це зробити не зможу.",shape=box,color=blue];
		j858510546 -> j1719243791;
	j1969046977 [label="Я не можу й далі сидіти тут у таємниці. Якщо я хочу мати вплив на світ, то повинен мати можливість працювати публічно.",shape=box,color=blue];
		j1969046977 -> j1719243791;
	j2033967052 [label="Evaluate expressions",color=orange];
		j2033967052 -> j3858335855 [label="MarieFamilyFail, LyonFamilyFail",color=purple];
