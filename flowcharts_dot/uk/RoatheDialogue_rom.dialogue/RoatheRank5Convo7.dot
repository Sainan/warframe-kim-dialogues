		j3095704787 -> j4142993334;
	j3557751276 [label="Цікаво, як відреагує родина Ентраті.",shape=box,color=red];
		j3557751276 -> j4258018103;
	j3183984638 [label="Які в тебе є причини бажати возз’єднання Лойда та родини Ентраті?",shape=box,color=red];
