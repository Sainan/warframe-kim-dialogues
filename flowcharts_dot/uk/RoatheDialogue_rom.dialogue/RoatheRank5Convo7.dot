		j2033967052 -> j2980922808 [label="MarieFamilySuccess",color=purple];
		j2033967052 -> j3772433307 [label="LyonFamilySuccess",color=purple];
	j1719243791 [label="Крім того, родина Альбрехта, імовірно, має ресурси та доступ до речей, які мені знадобляться. Розумієш, до чого я веду?",shape=box,color=blue];
		j1719243791 -> j1346270371;
		j1719243791 -> j2976109484;
		j1719243791 -> j1478915251;
	j3858335855 [label="Хоча боюся, що це не матиме великого значення, враховуючи, як тобі вдалося зіпсувати все з обома фанатиками.",shape=box,color=blue];
		j3858335855 -> j92563311;
		j3858335855 -> j1983286950;
		j3858335855 -> j1478915251;
	j1627229233 [label="Хоча боюся, що це не матиме великого значення, враховуючи, як тобі вдалося зіпсувати все з Марі.",shape=box,color=blue];
		j1627229233 -> j3140764050;
		j1627229233 -> j92563311;
		j1627229233 -> j1478915251;
	j885166298 [label="Хоча боюся, що це не матиме великого значення, враховуючи, як тобі вдалося зіпсувати все з Ліоном.",shape=box,color=blue];
		j885166298 -> j1133343012;
		j885166298 -> j92563311;
		j885166298 -> j1478915251;
	j76913691 [label="Фанатики також готові допомогти, хоча й з інших причин. Добре, що тобі вдалося переконати їх.",shape=box,color=blue];
		j76913691 -> j3095704787;
		j76913691 -> j3557751276;
		j76913691 -> j1478915251;
		j76913691 -> j3183984638;
	j2980922808 [label="Марі також готова допомогти, хоча й з інших причин. Тепер ми почекаємо, поки ти переконуєш Ліона. Спробуй не зіпсувати все з ним, гаразд?",shape=box,color=blue];
		j2980922808 -> j3095704787;
		j2980922808 -> j3557751276;
		j2980922808 -> j1478915251;
		j2980922808 -> j3183984638;
	j3772433307 [label="Ліон також готовий допомогти, хоча й з інших причин. Тепер ми почекаємо, поки ти переконуєш Марі. Спробуй не зіпсувати все з нею, гаразд?",shape=box,color=blue];
		j3772433307 -> j3095704787;
		j3772433307 -> j3557751276;
		j3772433307 -> j1478915251;
		j3772433307 -> j3183984638;
	j1346270371 [label="Гадаю, краще, якщо ви всі залишитеся тут, унизу. Вибач.",shape=box,color=red];
		j1346270371 -> j3094713610;
	j2976109484 [label="Добре. Гаразд. Спробуймо повести Лойда тими сходами.",shape=box,color=red];
		j2976109484 -> j4140680399;
	j1478915251 [label="[Завершити розмову]",shape=box,color=red];
