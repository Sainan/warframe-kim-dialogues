	j764389992 [label="Ні. Імовірно, тому що він боїться того, що поверне із собою. Хоча для цього вже занадто пізно.",shape=box,color=blue];
		j764389992 -> j2997377135;
	j271956988 [label="Певною мірою. Слухай. Я захищу Деймос. Я захищу серце Порожнечі. А що ще важливіше, я захищу родину Альбрехта.",shape=box,color=blue];
		j271956988 -> j2190406204;
	j1079816480 [label="Родині потрібен захист. Я маю стояти на сторожі. Я не можу цього робити звідси.",shape=box,color=blue];
		j1079816480 -> j780094961;
	j3038277068 [label="Він знищив мої спогади й подбав про те, щоб я не мав, крім тебе, до кого можна було б звернутися, щоб їх повернути.",shape=box,color=blue];
		j3038277068 -> j2578459868;
	j1906841077 [label="Родині потрібен захист. А вони трохи «вкорінені», чи не так?",shape=box,color=blue];
		j1906841077 -> j2179998195;
