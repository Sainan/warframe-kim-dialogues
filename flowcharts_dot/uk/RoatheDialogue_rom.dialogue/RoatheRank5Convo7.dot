	j2315857562 [label="Check boolean RoatheDating",color=orange];
		j2315857562 -> j139569374 [label=true,color=green];
		j2315857562 -> j139569374 [label=false,color=brown];
	j2664791124 [label="Евлерія — не дурепа. Вона знатиме про мої мотиви. Сумніваюся, що вона сприйме це без певного занепокоєння.",shape=box,color=blue];
