	j2922762900 [label="Вона б дізналася, що я хочу помститися Альбрехту. Так, я прийняв сироватку добровільно, але це він звкинув мене в минуле.",shape=box,color=blue];
		j2922762900 -> j819783591;
	j41824831 [label="Запам’ятай мої слова, мандрівниче. «Бог» чи ні, Байдужість прийде за тим, що їй заборгували. І коли цей день настане?",shape=box,color=blue];
		j41824831 -> j1120928568;
	j1343092976 [label="Запам’ятай мої слова. «Бог» чи ні, Байдужість прийде за тим, що їй заборгували. І коли цей день настане?",shape=box,color=blue];
		j1343092976 -> j1120928568;
	j3819975498 [label="І хоча в тобі виявилося значно більше солоду, ніж я міг собі уявити, але як це можна було гарантувати?",shape=box,color=blue];
		j3819975498 -> j806118769;
