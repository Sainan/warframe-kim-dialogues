digraph {
	graph [fontname="Roboto Condensed"];
	node [fontname="Roboto Condensed"];
	edge [fontname="Roboto Condensed"];

	"RoatheRank2Convo4 begins." [color=orange];
		"RoatheRank2Convo4 begins." -> j1115193858;
	j1115193858 [label="Check boolean RoatheRank2Convo1Complete",color=orange];
		j1115193858 -> j1437250236 [label=true,color=green];
		j1115193858 -> "Chat ends." [label=false,color=brown];
	j1437250236 [label="Check boolean RoatheKnowsReset2",color=orange];
		j1437250236 -> j2878938860 [label=true,color=green];
		j1437250236 -> j1692949551 [label=false,color=brown];
	"Chat ends." [color=orange];
	j2878938860 [label="Гм. Скажи мені. Чи вдалося мені переконати тебе минулого разу, що твоя «Байдужість» — це лише колекція зібраних дитячих іграшок, чи ти все ще віриш, що це якась «велика незбагненна істота з Порожнечі»?",shape=box,color=blue];
		j2878938860 -> j2722762639;
	j1692949551 [label="Check boolean RoatheMITW1",color=orange];
		j1692949551 -> j1403830103 [label=true,color=green];
		j1692949551 -> j2893807519 [label=false,color=brown];
	j2722762639 [label="Якщо є щось у цьому світі, що я зневажаю, то це ганятися за власним хвостом. І ця метафора раніше була набагато більш поширеною, ніж зараз, я оце щойно усвідомив.",shape=box,color=blue];
		j2722762639 -> j312368394;
		j2722762639 -> j4037966947;
		j2722762639 -> j2974411358;
	j1403830103 [label="Отже, перш ніж продовжувати, я хотів би переконатися, що все правильно зрозумів. Ти віриш в те, що Байдужість — це якась жахлива незбагненна істота з Порожнечі, яка проникла в нашу реальність через помилки Альбрехта?",shape=box,color=blue];
		j1403830103 -> j1696607207;
	j2893807519 [label="Усі, з ким я розмовляв у цій божевільні, повністю переконані, що ця «Людина в стіні» — якийсь буквальний і сміховинний бог. Справжній бог. Навіть ці два фанатики, здається, поділяють цю думку!",shape=box,color=blue];
		j2893807519 -> j4193438603;
		j2893807519 -> j695733559;
		j2893807519 -> j2880626879;
	j312368394 [label="Ні, тобі не вдалося. Вибач. ",shape=box,color=red];
		j312368394 -> j1200524184;
	j4037966947 [label="Насправді тобі вдалося.",shape=box,color=red];
		j4037966947 -> j925833739;
	j2974411358 [label="Ми так і не дійшли згоди.",shape=box,color=red];
		j2974411358 -> j2710850389;
	j1696607207 [label="Дозвольте мені сформулювати своє питання таким чином, перш ніж ми знову почнемо ходити по колу та ганятися за власним хвостом. І ця метафора раніше була набагато більш поширеною, ніж зараз, я оце щойно усвідомив, але я відхилився від теми.",shape=box,color=blue];
		j1696607207 -> j769877667;
	j4193438603 [label="Ти не думаєш, що вона справжня?",shape=box,color=red];
		j4193438603 -> j964860246;
	j695733559 [label="Якщо ти не думаєш, що це бог, тоді хто це?",shape=box,color=red];
		j695733559 -> j206900879;
	j2880626879 [label="Але не ти?",shape=box,color=red];
		j2880626879 -> j110210458;
	j1200524184 [label="Boolean RoatheMITWSkip is now true.",color=orange];
		j1200524184 -> j2488231158;
	j925833739 [label="Boolean RoatheMITWSkip is now true.",color=orange];
		j925833739 -> j2856913916;
	j2710850389 [label="Ох! Ну, тоді, здається, у мене ще є над чим працювати.",shape=box,color=blue];
		j2710850389 -> j4131322037;
	j769877667 [label="Ти віриш в те, що істота, яку ти зараз називаєш Байдужістю, існувала до того, як Альбрехт зіткнувся з нею? Або ти вважаєш, що він створив її, коли вперше взаємодіяв з Порожнечею?",shape=box,color=blue];
		j769877667 -> j2289334190;
		j769877667 -> j420702183;
		j769877667 -> j2744062777;
		j769877667 -> j135434242;
	j964860246 [label="Хіба я так сказав? Не поспішай вкладати свої слова в мої уста, о Позачасовий узурпаторе. Я не заперечую, що Байдужість «реальна». Я заперечую, що вона є Богом.",shape=box,color=blue];
		j964860246 -> j115116848;
		j964860246 -> j3479504005;
	j206900879 [label="Я можу позбавити тебе цього фальшивого божества двома простими словами, які потрібно добре знати та розуміти:",shape=box,color=blue];
		j206900879 -> j1946388034;
	j110210458 [label="Абсолютно ні! По-перше, немає ні бога, ні богів, ця ідея безглузда. По-друге, думати, що Альбрехт звільнив бога Порожнечі, ще смішніше!",shape=box,color=blue];
		j110210458 -> j1474666708;
	j2488231158 [label="Boolean RoatheMITW5Real is now true.",color=orange];
		j2488231158 -> j1038370920;
	j2856913916 [label="Boolean RoatheMITW5Fake is now true.",color=orange];
		j2856913916 -> j811806791;
	j4131322037 [label="Boolean RoatheMITW1 is now true.",color=orange];
		j4131322037 -> j2035216251;
	j2289334190 [label="Я не знаю. І я не думаю, що ти теж знаєш.",shape=box,color=red];
		j2289334190 -> j477751643;
	j420702183 [label="Я думаю, що це була істота, яка існувала до того, як Ентраті взаємодіяв з нею. Він просто надав її форму та вигляд за допомогою концептуального втілення.",shape=box,color=red];
		j420702183 -> j2214572217;
	j2744062777 [label="Чесно кажучи… я не знаю.",shape=box,color=red];
		j2744062777 -> j2397610534;
	j135434242 [label="Ти справді гадаєш, що Ентраті вигадав злостивого бога Порожнечі з нічого?",shape=box,color=red];
		j135434242 -> j477751643;
	j115116848 [label="Ця річ сильніше за все, з чим мені коли-небудь доводилося мати справу.",shape=box,color=red];
		j115116848 -> j1253155812;
	j3479504005 [label="Як ти думаєш, що це тоді?",shape=box,color=red];
		j3479504005 -> j206900879;
	j1946388034 [label="Концептуальне втілення.",shape=box,color=blue];
		j1946388034 -> j1973123828;
		j1946388034 -> j1942282228;
		j1946388034 -> j791173621;
	j1474666708 [label="У Порожнечі нічого немає. Саме тому вона називається Порожнечею! ",shape=box,color=blue];
		j1474666708 -> j1955659049;
		j1474666708 -> j1596989859;
	j1038370920 [label="+10 Chemistry",color=orange];
		j1038370920 -> j2605743985;
	j811806791 [label="+20 Chemistry",color=orange];
		j811806791 -> j4231417052;
	j2035216251 [label="Але перш ніж продовжувати, я хотів би переконатися, що все правильно зрозумів. Ти віриш у те, що Байдужість — це якась жахлива незбагненна істота з Порожнечі, яка проникла в нашу реальність через помилки Альбрехта?",shape=box,color=blue];
		j2035216251 -> j1696607207;
	j477751643 [label="Так! Я знаю! Те, що відбувається, настільки болісно очевидно і настільки смішно, що ви всі переконали себе, ніби за вікном шкребеться якийсь страшний звір, хоча це лише гілка дерева, що колихається вітром.",shape=box,color=blue];
		j477751643 -> j117301363;
	j2214572217 [label="Тільки не ти. Я покладав на тебе надії. Те, що відбувається, настільки болісно очевидно і настільки смішно, що ви всі переконали себе, ніби за вікном шкребеться якийсь страшний звір, хоча це лише гілка дерева, що колихається вітром.",shape=box,color=blue];
		j2214572217 -> j117301363;
	j2397610534 [label="Те, що відбувається, настільки болісно очевидно і настільки смішно, що ви всі переконали себе, ніби за вікном шкребеться якийсь страшний звір, хоча це лише гілка дерева, що колихається вітром.",shape=box,color=blue];
		j2397610534 -> j117301363;
	j1253155812 [label="І коли я таке заперечував? Насправді складається враження, що вам усім удалося довести себе до істеричного та безпідставно обурливого стану страждань.",shape=box,color=blue];
		j1253155812 -> j985756904;
		j1253155812 -> j3409445762;
	j1973123828 [label="Порожнеча небезпечна та могутня, як і те, що ми можемо зробити з неї. Повір, я знаю. Але вона має межі. Ти справді думаєш, що вона може проявити щось подібне? Це щось може створювати цілі мови, пальці, здатні живити цілі зорельоти, які стрибають через Порожнечу?",shape=box,color=red];
		j1973123828 -> j2220765158;
	j1942282228 [label="У це… дуже хочеться повірити, що це лише монстр під нашим ліжком, Роуте. Але після зустрічі з цим віч-на-віч я не знаю, як щось подібне може бути створене нашою свідомістю.",shape=box,color=red];
		j1942282228 -> j1736977210;
	j791173621 [label="Концептуальне втілення не може зробити те, на що здатна Людина в стіні. Хоча Ентраті, можливо, виявив цю річ — і несе відповідальність за її перенесення сюди — але я не вірю, що він є першоджерелом.",shape=box,color=red];
		j791173621 -> j797746634;
	j1955659049 [label="Я… ",shape=box,color=red];
		j1955659049 -> j3572235640;
	j1596989859 [label="Ні. Я знаю речі, які походять із Порожнечі. Янголи. Спів. Привиди.",shape=box,color=red];
		j1596989859 -> j3572235640;
	j2605743985 [label="Хоча я розчарований тим, що ти дотримуєшся своєї позиції, проте твоя чесність мене надзвичайно тішить. І я радий, що не марную час, рухаючись вперед. Я впевнений, що ми знайдемо інші способи розважитися.",shape=box,color=blue];
		j2605743985 -> j1336898595;
	j4231417052 [label="Неймовірно. Я радий, що моє колишнє «я» було таким дивовижно переконливим. І я сподіваюся, що ти не брешеш мені, намагаючись «змусити мене замовкнути». Але вибору немає, я маю вірити тобі.",shape=box,color=blue];
		j4231417052 -> j2403822154;
	j117301363 [label="Тільки тепер, під впливом Порожнечі, ви всі вигодували її страхом і силою, що вона, як зворотний зв’язок, втілилися в цю… Річ. Людину в стіні.",shape=box,color=blue];
		j117301363 -> j3328529184;
	j985756904 [label="Що ти хочеш сказати?",shape=box,color=red];
		j985756904 -> j1710210673;
	j3409445762 [label="Зажди. Яким чином ми винні в цьому? Лише Альбрехт винен, він це випустив.",shape=box,color=red];
		j3409445762 -> j3330531562;
	j2220765158 [label="Людство, звісно, ніщо інше як творчість у широті та масштабах нових форм страждань, які воно може собі вигадати, чи не так? На твою долю випало багато форм жорстокості, які, я впевнений, ніхто не міг би уявити, що вони можливі за часів наших фанатиків.",shape=box,color=blue];
		j2220765158 -> j12126868;
	j1736977210 [label="Ех, ти так близько підходиш до істини, але так швидко відкидаєш її. Ти думаєш, що «спокусливо» повірити, що це витвір нашого власного розуму, адже якби це було так, було б легше це відкинути? Ні, я думаю, що набагато небезпечніше зіткнутися з нашим власним творінням, ніж із богом.",shape=box,color=blue];
		j1736977210 -> j506628671;
	j797746634 [label="Хоча я ціную твоє смирення, проте кидаю виклик твоєму обмеженому розумінню можливостей людської винахідливості, особливо, що стосується вигадування нових форм страждань. Хіба ти не несеш повну відповідальність за створення власного всесвіту з нічого?",shape=box,color=blue];
		j797746634 -> j4201932081;
	j3572235640 [label="Єдине, що походить із Порожнечі — це те, що ми поміщаємо в неї, і те, що повертається з неї. Вона може змінити матерію та енергію, але не може її створити.",shape=box,color=blue];
		j3572235640 -> j4151045874;
	j1336898595 [label="Я, наприклад, удячний за те, що мені не довелося знову ходити по колу та вести нескінченні дебати про тонкощі концептуального втілення.",shape=box,color=blue];
		j1336898595 -> j289039413;
	j2403822154 [label="У будь-якому разі, я впевнений, що ми знайдемо інші способи розважитися, аніж губитися в повторювальних дебатах про тонкощі концептуального втілення.",shape=box,color=blue];
		j2403822154 -> j1839530079;
	j3328529184 [label="Можливо, Альбрехт і розпочав цю нісенітницю, але ви всі несете відповідальність за те, що підливали масла в вогонь, поки він не перетворився на пекло. Байдужість ніколи не існувала. Аж раптом вона з’явилася. ",shape=box,color=blue];
		j3328529184 -> j2813329247;
	j1710210673 [label="Я хочу сказати, що Альбрехт міг бути тим, хто спочатку побачив свою власну пиху як обличчя усміхненого бога руйнувань.",shape=box,color=blue];
		j1710210673 -> j1683911521;
	j3330531562 [label="Альбрехт міг бути тим, хто спочатку побачив свою власну пиху як обличчя усміхненого бога руйнувань.",shape=box,color=blue];
		j3330531562 -> j1683911521;
	j12126868 [label="+5 Chemistry",color=orange];
		j12126868 -> j4278800867;
	j506628671 [label="Зовнішнього ворога можна зрозуміти. Маніпулювати. Перемогти. Або, можливо, навіть домовитися, якщо на те пішло. У нього є слабкі сторони, якими можна скористатися. Але якщо це внутрішній ворог? Якого ми самі створили? Це насправді набагато підступніше.",shape=box,color=blue];
		j506628671 -> j18782228;
	j4201932081 [label="На твою долю випало багато форм жорстокості, які, я впевнений, ніхто не міг би уявити, що вони можливі за часів наших фанатиків. ",shape=box,color=blue];
		j4201932081 -> j12126868;
	j4151045874 [label="Подумай, мандрівниче. Ці «Янголи Порожнечі», про яких ти говориш. Ці привиди. Чи були вони зроблені з тих, хто вже загубився в Порожнечі?",shape=box,color=blue];
		j4151045874 -> j770841498;
	j289039413 [label="Хоча це означає більше часу на проповіді фанатиків… ха. Вибір, вибір, вибір…",shape=box,color=blue];
		j289039413 -> "Chat ends.";
	j1839530079 [label="Я, наприклад, дуже вдячний за те, що мене позбавили другого раунду.",shape=box,color=blue];
		j1839530079 -> j289039413;
	j2813329247 [label="І ви всі в цьому винні.",shape=box,color=blue];
		j2813329247 -> j2460317935;
		j2813329247 -> j3172566775;
		j2813329247 -> j2019324379;
	j1683911521 [label="Але ви всі однаково винні в тому, що продовжуєте котити цей кавелик жука-гнойовика вниз по схилу, збільшуючи його з кожним шаром лайна, яке збираєте по дорозі!",shape=box,color=blue];
		j1683911521 -> j2593213422;
	j4278800867 [label="Як вид ми напрочуд дивовижні у своїй здатності підживлювати свої страхи новими способами самознищення.",shape=box,color=blue];
		j4278800867 -> j185351803;
	j18782228 [label="+5 Chemistry",color=orange];
		j18782228 -> j4217739728;
	j770841498 [label="Вони були лише відлунням енергії, наче відрижка барвистого кутака, щоб нагодувати своїх дітей.",shape=box,color=blue];
		j770841498 -> j2593213422;
	j2460317935 [label="Ми не можемо створювати такі речі, Роуте. Концептуальне втілення має свої межі.",shape=box,color=red];
		j2460317935 -> j3155424276;
	j3172566775 [label="Не звинувачуй нас у цьому. Ми не винні в тому, що ця річ заподіяла.",shape=box,color=red];
		j3172566775 -> j750722052;
	j2019324379 [label="Поясни мені, як це працюватиме. Більшість речей, створених за допомогою концептуального втілення з Порожнечі, не можуть її покинути. Принаймні не надовго.",shape=box,color=red];
		j2019324379 -> j3972497165;
	j2593213422 [label="Дозволь мені спростити цю тему для тебе. Я можу позбавити тебе цього фальшивого божества двома простими словами, які потрібно добре знати та розуміти:",shape=box,color=blue];
		j2593213422 -> j1946388034;
	j185351803 [label="Boolean RoatheMITW1 is now true.",color=orange];
		j185351803 -> j1696607207;
	j4217739728 [label="Тому що тоді ми повинні побороти або опанувати демонів. А людство… ніколи не виграє такі війни, чи не так?",shape=box,color=blue];
		j4217739728 -> j185351803;
	j3155424276 [label="Каже той, хто самотужки створив цілий альтернативний вимір? Прошу, мандрівниче… використай свою уяву, як колись давно.",shape=box,color=blue];
		j3155424276 -> j3972497165;
	j750722052 [label="Я не докоряю тобі! Це вже давно було в процесі розробки, ще до твоєї появи. Альбрехт подбав про це.",shape=box,color=blue];
		j750722052 -> j4235403644;
	j3972497165 [label="Концептуальне втілення працює таким чином: під час взаємодії з Порожнечею або в її безпосередній близькості сильні емоції та думки можуть проявлятися фізично. Ми обоє це знаємо.",shape=box,color=blue];
		j3972497165 -> j670114119;
		j3972497165 -> j925962801;
		j3972497165 -> j2444295671;
	j4235403644 [label="Він побачив власне віддзеркалення й пізнав справжній страх. І так спалахнула перша іскра, яка розпалила вогонь, що загрожує спалити все дотла. Ви всі просто продовжуєте підкидати дрова у вогонь.",shape=box,color=blue];
		j4235403644 -> j3972497165;
	j670114119 [label="Правильно. Як і Дувірі, воно пов’язано з цим світом через «Заримен». ",shape=box,color=red];
		j670114119 -> j150484906;
	j925962801 [label="Як «Заримен», «Паланка» та янголи Порожнечі. Порожнеча є всюди на цьому кораблі.",shape=box,color=red];
		j925962801 -> j150484906;
	j2444295671 [label="Так, і що?",shape=box,color=red];
		j2444295671 -> j1701542010;
	j150484906 [label="Саме так. Там, де є Порожнеча, може існувати й концептуальне втілення. І тільки там.",shape=box,color=blue];
		j150484906 -> j4059601889;
		j150484906 -> j14767818;
	j1701542010 [label="Там, де є Порожнеча, може існувати й концептуальне втілення. І тільки там.",shape=box,color=blue];
		j1701542010 -> j4059601889;
		j1701542010 -> j14767818;
	j4059601889 [label="Але воно було в 1999 році. Воно слідувало за Альбрехтом всюди. І за мною теж.",shape=box,color=red];
		j4059601889 -> j1835096165;
	j14767818 [label="Зажди…",shape=box,color=red];
		j14767818 -> j1552195053;
	j1835096165 [label="Кляті пальці. Ми взяли ці кляті пальці у відчайдушній і божевільній спробі дістатися до Тау, і ми, орокіни, знайшли спосіб їх відтворити, чи не так?",shape=box,color=blue];
		j1835096165 -> j1500129631;
	j1552195053 [label="Так. Ти тепер розумієш. Кляті пальці. Ми взяли ці кляті пальці у відчайдушній і божевільній спробі дістатися до Тау, і ми, орокіни, знайшли спосіб їх відтворити, чи не так?",shape=box,color=blue];
		j1552195053 -> j1500129631;
	j1500129631 [label="Маленькі шматочки Порожнечі, куди б ти не пішов… Мережа траншей і тунелів, щоб ця штука могла з’являтися де завгодно. А що ще гірше?",shape=box,color=blue];
		j1500129631 -> j1587522092;
	j1587522092 [label="Тенно. І ти. Усі ви, кого торкнулася Порожнеча. І всі ви переслідувані цією річчю, бо куди б ви не пішли, вона може слідувати за вами.",shape=box,color=blue];
		j1587522092 -> j623957793;
	j623957793 [label="Та, імовірно, будь-хто, хто взаємодіяв із нею протягом будь-якого часу. Сам Ентраті. Його дворецький. Кавії. Власне, я та фанатики, завдяки нашій близькості до цього Святилища. Список можна продовжувати.",shape=box,color=blue];
		j623957793 -> j2906075545;
		j623957793 -> j4087116396;
	j2906075545 [label="Тож ти припускаєш, що будь-хто, хто зазнав достатнього впливу Порожнечі, або будь-хто, хто є «акумулятором», стає ще однією шпариною, через яку Людина в стіні може зазирнути?",shape=box,color=red];
		j2906075545 -> j3477930263;
	j4087116396 [label="Але мені цікаво, як воно потрапило в Русалку?",shape=box,color=red];
		j4087116396 -> j3429737128;
	j3477930263 [label="Саме так. ",shape=box,color=blue];
		j3477930263 -> j4211751182;
	j3429737128 [label="У кого?",shape=box,color=blue];
		j3429737128 -> j1486112958;
		j3429737128 -> j2902673956;
	j4211751182 [label="Це пояснює, чому вона не має власного обличчя, чи не так? Вона може з’являтися лише тим, кого мучить, і тим, кого намагається мучити.",shape=box,color=blue];
		j4211751182 -> j905547473;
	j1486112958 [label="Майорка Несі Русалка. У 1999 році вона командувала військовим підрозділом під назвою «Скальдра» в Голвенії.",shape=box,color=red];
		j1486112958 -> j1847248359;
	j2902673956 [label="Коротше, вам нізащо не можна дозволити зустрітися.",shape=box,color=red];
		j2902673956 -> j785665845;
	j905547473 [label="Насправді вона набуває вигляду архітектури лише тоді, коли не здатна представити себе як щось більше та відмінне. Коли вона відчайдушно намагається передати відчуття величі та божественності.",shape=box,color=blue];
		j905547473 -> j3456021521;
		j905547473 -> j1794753183;
	j1847248359 [label="Вона була або є одержимою Байдужістю. Байдужість використовує її розум, користуючись нею, як маріонеткою. Можливо, вона впустила її. Ми не знаємо. Ми також не знаємо, чи вона дійсно знову контролює ситуацію.",shape=box,color=red];
		j1847248359 -> j2800073932;
	j785665845 [label="З тобою абсолютно не весело, узурпаторе. Але яке саме відношення вона має до… Байдужості?",shape=box,color=blue];
		j785665845 -> j1847248359;
	j3456021521 [label="То ти вважаєш, що вона носить всі обличчя людей, з якими контактує… тому що вона не має власного?",shape=box,color=red];
		j3456021521 -> j1108391293;
	j1794753183 [label="Я вважаю, що Людина в стіні вирішила носити наші обличчя, тому що не може зрозуміти, як це бути людиною. Інакше вона занадто «велика».",shape=box,color=red];
		j1794753183 -> j2064862892;
	j2800073932 [label="Вона дійсно здається надзвичайно цікавою особистістю. І це справжнє задоволення. Але це зараз не має значення. Ти кажеш, що Байдужість захопила її розум? І це почалося під час твоєї маленької подорожі в минуле?",shape=box,color=blue];
		j2800073932 -> j2757354289;
	j1108391293 [label="Ні, дурненьке. Тому що воно лише імітує те, що його створило. Воно не є цілісною істотою — це лише іграшка, зроблена з невідповідних частин тих страхів, жахів і страждань, якими його годували. ",shape=box,color=blue];
		j1108391293 -> j1056855222;
	j2064862892 [label="Ні, дурненьке. Воно лише імітує те, що його створило. Воно не є цілісною істотою — це лише іграшка, зроблена з невідповідних частин тих страхів, жахів і страждань, якими його годували.",shape=box,color=blue];
		j2064862892 -> j1056855222;
	j2757354289 [label="Ну, якщо те, що ми знаємо про Порожнечу, відповідає дійсності, то сталося одне з двох: або вона потрапила в якусь взаємодію з Порожнечею в 1999 році з власної волі (що я вважаю вкрай малоймовірним, але не неможливим), або…",shape=box,color=blue];
		j2757354289 -> j2878327504;
	j1056855222 [label="Та. Схоже, сьогодні я нічого не зроблю. Це нормально через твоє глибоке занурення в цю пропаганду, якою тебе годували. Боюся, що Альбрехт є дуже переконливим культовим лідером.",shape=box,color=blue];
		j1056855222 -> j4117666542;
	j2878327504 [label="Наш дорогий Альбрехт знову втрутився.",shape=box,color=blue];
		j2878327504 -> j1035094751;
		j2878327504 -> j25457774;
		j2878327504 -> j2296840593;
	j4117666542 [label="+10 Chemistry",color=orange];
		j4117666542 -> j934920046;
	j1035094751 [label="Ти натякаєш, що Альбрехт навмисно зробив Несі маріонеткою Байдужості?",shape=box,color=red];
		j1035094751 -> j552815285;
	j25457774 [label="Ми не знаємо, чи все це правда. Нічого з цього. Це все лише припущення. Усе це може бути повною брехнею.",shape=box,color=red];
		j25457774 -> j2669415244;
	j2296840593 [label="Якщо він прорвав діру в Порожнечі в 1999 році та навмисно спустив її… це б пояснювало чому ворфрейми працювали там спочатку… так само як у твої часи — без серця Деймос, я маю на увазі.",shape=box,color=red];
		j2296840593 -> j3155772149;
	j934920046 [label="Boolean RoatheMITW2 is now true.",color=orange];
		j934920046 -> j2589569923;
	j552815285 [label="Я просто сиджу тут і гадаю на кавовій гущі, як і всі інші, узурпаторе. Далеко не мені натякати, що Альбрехт навмисно прорвав дірку в Порожнечу в Голвенії та впустив Байдужість, щоб дати їй власного аватара…",shape=box,color=blue];
		j552815285 -> j2106004058;
	j2669415244 [label="Звичайно! Я просто сиджу тут і гадаю на кавовій гущі, як і всі інші, узурпаторе. Далеко не мені натякати, що Альбрехт навмисно прорвав дірку в Порожнечу в Голвенії та впустив Байдужість, щоб дати їй власного аватара…",shape=box,color=blue];
		j2669415244 -> j2106004058;
	j3155772149 [label="Бачиш? Ніколи не довіряй вченим. Вони готові зробити що завгодно заради винаходів. Але ж я просто сиджу тут і гадаю на кавовій гущі, як і всі інші, узурпаторе. Це все просто припущення.",shape=box,color=blue];
		j3155772149 -> j49646197;
	j2589569923 [label="Сподіваюся, що принаймні я дав тобі привід для роздумів. А тепер я мушу йти.",shape=box,color=blue];
		j2589569923 -> "Chat ends.";
	j2106004058 [label="Мені просто здається, як тактику й людині, яка досить звикла розробляти стратегії для війни…",shape=box,color=blue];
		j2106004058 -> j378013953;
	j49646197 [label="Далеко не мені натякати, що Альбрехт навмисно прорвав дірку в Порожнечу в Голвенії та впустив Байдужість, щоб дати їй власного аватара! Мені просто здається, як тактику і людині, яка досить звикла розробляти стратегії для війни…",shape=box,color=blue];
		j49646197 -> j378013953;
	j378013953 [label="Який перший крок до перемоги над безликим супротивником, який може бути де завгодно, ким завгодно і коли завгодно? Це звузити вибір до якомога меншої кількості варіантів…",shape=box,color=blue];
		j378013953 -> j4145022276;
	j4145022276 [label="+20 Chemistry",color=orange];
		j4145022276 -> j3008227565;
	j3008227565 [label="І щоб ці варіанти були вичерпними.",shape=box,color=blue];
		j3008227565 -> j3897106848;
	j3897106848 [label="Boolean RoatheMITW2Neci is now true.",color=orange];
		j3897106848 -> j525670781;
	j525670781 [label="Чудова тема для роздумів. Але! Наразі я маю йти.",shape=box,color=blue];
		j525670781 -> "Chat ends.";
}